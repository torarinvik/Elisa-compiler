# Probe: parse stdin and walk every statement body (including match-arm bodies), so a
# dangling side-table buffer traps here instead of deep inside the backend.
include "../src/parser/parser.elisa"

using Ast

extern read(fd: int, buf: void&, count: usize) -> isize can[Console]
extern printf(fmt: cstr, ...) -> int can[Console]


def read_all() -> darray[u8] can[Console, Memory.Allocate, Abort.Panic]:
    buf: mutable darray[u8] = []
    chunk: mutable darray[u8] = [0 for _ in 0..<8192]
    while true |buf|:
        n: isize = read(0, (&chunk[0]).cast[void&], 8192) can Console
        break if n <= 0
        for index in 0..<n.usize() |buf|:
            buf.push(chunk[index])
    buf.push(0)
    return buf


def walk_statements(statements: darray[Ast::Stmt], seen: mutable i64&) -> void can[Abort.Panic, Memory.Allocate]:
    for statement in statements |seen|:
        seen <- seen + 1
        if statement is Stmt.If(condition, then_body, else_body, if_line):
            walk_statements(then_body, seen)
            walk_statements(else_body, seen)
        if statement is Stmt.While(while_condition, while_body, while_line):
            walk_statements(while_body, seen)
        if statement is Stmt.For(bind, variables, iterable, for_body, for_line):
            walk_statements(for_body, seen)
        if statement is Stmt.Block(kind, clause, binding, block_body, block_line):
            walk_statements(block_body, seen)
        if statement is Stmt.Match(scrutinee, arms, match_line):
            for arm in arms |seen|:
                walk_statements(arm.body, seen)


def walk_declarations(declarations: darray[Ast::Decl], seen: mutable i64&) -> void can[Abort.Panic, Memory.Allocate]:
    for declaration in declarations |seen|:
        if declaration is Decl.Func(name, params, return_type, body, effects, decorators, line):
            walk_statements(body, seen)
        if declaration is Decl.Module(module_name, module_body, module_line):
            walk_declarations(module_body, seen)
        if declaration is Decl.Scoped(scoped_body, scoped_line):
            walk_declarations(scoped_body, seen)


def main() -> i64 can[Console, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    src: darray[u8] = read_all()
    1 return if src.count <= 1
    source_length: usize = src.count - 1
    tokens: darray[Lexer::Token] = frontend_tokenize_with_length(&src[0], &src[0], source_length)
    file: Ast::File = frontend_parser_parse_file(&src[0], tokens)
    seen: mutable i64 = 0
    walk_declarations(file.top_decls, seen)
    _ = printf("OK statements=%lld errors=%lld\n", seen, file.errors.count.i64()) can Console
    return 0
