# Shared predicate for the portion of a numeric exponent after its `e`/`E` marker.
module LexerNumberExponent:
    public:
        def follows(first: char, second: char) -> bool:
            ensure result == (first in '0'..='9' or ((first == '+' or first == '-') and second in '0'..='9'))
            return when first:
                '+' | '-' -> second in '0'..='9'
                _ -> first in '0'..='9'
