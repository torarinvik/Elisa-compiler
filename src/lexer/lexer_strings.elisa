extend Lexer:
    public:
        # Scanner mode for `read_fstring` — the automaton that was previously encoded
        # as `depth == 0` checks and a nested skip-loop, made explicit and typed.
        const enum FStringMode of u8:
            Text            # raw f-string text, outside any `{...}`
            Expr            # inside `{...}` interpolation (depth tracks nesting)
            InnerString     # inside a `"..."` literal embedded in the interpolation

extend Lexer:
    private:
        @inline(always)
        def char_at(source: u8&, source_length: usize, index: usize) -> char:
            if index >= source_length:
                return NULL_CHAR
            return source[index].char()

        @inline(always)
        def current_char(lexer: Lexer&) -> char:
            return char_at(lexer.source, lexer.source_length, lexer.position)

        @inline(always)
        def match_char(lexer: lmut Lexer, expected: char) -> bool:
            if lexer.current_char() == expected:
                lexer <- lexer.advance_char()
                return true
            return false

        def read_string(lexer: lmut Lexer) -> Token:
            position: LexerPosition = lexer.cursor_position()
            lexer <- lexer.advance_char()
            start: usize = lexer.position

            while not lexer.is_end_of_source() and lexer.current_char() != '"' and lexer.current_char() != '\n' |lexer|:
                if lexer.current_char() == '\\':
                    lexer <- lexer.advance_char()
                    if lexer.is_end_of_source():
                        return Token(TokenKind.StringLit, position, start, lexer.position)
                    if lexer.current_char() == '\n':
                        return Token(TokenKind.StringLit, position, start, lexer.position)
                lexer <- lexer.advance_char()

            text_end: usize = lexer.position
            if not lexer.is_end_of_source() and lexer.current_char() == '"':
                lexer <- lexer.advance_char()

            return Token(TokenKind.StringLit, position, start, text_end)

        # f-string literal `f"...{EXPR}..."` -> ONE FString token spanning the RAW
        # interior. Brace- and string-aware: a `"` inside `{...}` belongs to an
        # embedded string literal and does not terminate the f-string; `\\x` escapes
        # are skipped undecoded. Single-line (mirrors stage0's readFString).
        def read_fstring(lexer: lmut Lexer) -> Token:
            position: LexerPosition = lexer.cursor_position()
            lexer <- lexer.advance_char()               # f
            lexer <- lexer.advance_char()               # opening quote
            start: usize = lexer.position

            while not lexer.is_end_of_source() |lexer, mode: FStringMode = FStringMode.Text, depth: usize = 0|:
                character: char = lexer.current_char()
                match mode:
                    FStringMode.Text:
                        match character:
                            '"':
                                text_end: usize = lexer.position
                                lexer <- lexer.advance_char()   # closing quote
                                return Token(TokenKind.FString, position, start, text_end)
                            '\n':
                                # Unterminated: end the raw span at the newline.
                                return Token(TokenKind.FString, position, start, lexer.position)
                            '\\':
                                lexer <- lexer.advance_char()
                                if lexer.is_end_of_source() or lexer.current_char() == '\n':
                                    return Token(TokenKind.FString, position, start, lexer.position)
                                lexer <- lexer.advance_char()
                            '{':
                                if lexer.peek(1) == '{':        # `{{` is a literal brace
                                    lexer <- lexer.advance_chars(2)
                                else:
                                    mode <- FStringMode.Expr
                                    depth <- 1
                                    lexer <- lexer.advance_char()
                            '}':
                                if lexer.peek(1) == '}':        # `}}` is a literal brace
                                    lexer <- lexer.advance_chars(2)
                                else:
                                    lexer <- lexer.advance_char()
                            _:
                                lexer <- lexer.advance_char()

                    FStringMode.Expr:
                        match character:
                            '\n':
                                return Token(TokenKind.FString, position, start, lexer.position)
                            '{':
                                depth <- depth + 1
                                lexer <- lexer.advance_char()
                            '}':
                                depth <- depth - 1
                                if depth == 0:
                                    mode <- FStringMode.Text
                                lexer <- lexer.advance_char()
                            '"':
                                mode <- FStringMode.InnerString
                                lexer <- lexer.advance_char()
                            _:
                                lexer <- lexer.advance_char()

                    FStringMode.InnerString:
                        match character:
                            '"':
                                mode <- FStringMode.Expr
                                lexer <- lexer.advance_char()
                            '\n':
                                # Mirrors the pre-automaton skip-loop: the newline is
                                # consumed and scanning resumes inside the `{...}`.
                                mode <- FStringMode.Expr
                                lexer <- lexer.advance_char()
                            '\\':
                                lexer <- lexer.advance_chars(2)
                            _:
                                lexer <- lexer.advance_char()

            return Token(TokenKind.FString, position, start, lexer.position)


        def read_char(lexer: lmut Lexer) -> Token:
            position: LexerPosition = lexer.cursor_position()
            lexer <- lexer.advance_char()
            start: usize = lexer.position

            while not lexer.is_end_of_source() and lexer.current_char() != '\'' and lexer.current_char() != '\n' |lexer|:
                if lexer.current_char() == '\\':
                    lexer <- lexer.advance_char()
                    if lexer.is_end_of_source():
                        return Token(TokenKind.CharLit, position, start, lexer.position)
                    if lexer.current_char() == '\n':
                        return Token(TokenKind.CharLit, position, start, lexer.position)
                lexer <- lexer.advance_char()

            text_end: usize = lexer.position
            if not lexer.is_end_of_source() and lexer.current_char() == '\'':
                lexer <- lexer.advance_char()

            return Token(TokenKind.CharLit, position, start, text_end)
