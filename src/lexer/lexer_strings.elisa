extend Lexer:
    private:
        @inline(always)
        def char_at(source: u8&, source_length: usize, index: usize) -> char:
            NULL_CHAR return if index >= source_length
            return source[index].char()

        @inline(always)
        def current_char(lexer: Lexer&) -> char:
            return char_at(lexer.source, lexer.source_length, lexer.position)

        @inline(always)
        def match_char(lexer: lmut Lexer, expected: char) -> bool:
            false return if lexer.current_char() != expected
            lexer <- lexer.advance_char()
            return true

        def read_string(lexer: lmut Lexer) -> Token:
            position: LexerPosition = lexer.cursor_position()
            lexer <- lexer.advance_char()
            start: usize = lexer.position

            machine over lexer.current_char() while not lexer.is_end_of_source():
                state Scanning

                start Scanning

                Scanning, '"':
                    text_end: usize = lexer.position
                    lexer <- lexer.advance_char()   # closing quote
                    return Token(TokenKind.StringLit, position, start, text_end)

                Scanning, '\n':
                    return Token(TokenKind.StringLit, position, start, lexer.position)

                # Escape at end-of-line/source: consume the backslash and end the literal
                # (mirrors the pre-machine early returns after the escape advance).
                Scanning, '\\' if lexer.position + 1 >= lexer.source_length or lexer.peek(1) == '\n':
                    lexer <- lexer.advance_char()
                    return Token(TokenKind.StringLit, position, start, lexer.position)

                Scanning, '\\':
                    lexer <- lexer.advance_chars(2)
                    -> Scanning

                Scanning, _:
                    lexer <- lexer.advance_char()
                    -> Scanning

            # Unterminated at EOF.
            return Token(TokenKind.StringLit, position, start, lexer.position)

        # f-string literal `f"...{EXPR}..."` -> ONE FString token spanning the RAW
        # interior. Brace- and string-aware: a `"` inside `{...}` belongs to an
        # embedded string literal and does not terminate the f-string; `\\x` escapes
        # are skipped undecoded. Single-line (mirrors stage0's readFString).
        # A `machine` (docs/123): every (state, char) decision is exactly one arm.
        def read_fstring(lexer: lmut Lexer) -> Token:
            position: LexerPosition = lexer.cursor_position()
            lexer <- lexer.advance_char()               # f
            lexer <- lexer.advance_char()               # opening quote
            start: usize = lexer.position

            machine over lexer.current_char() while not lexer.is_end_of_source():
                state Text                              # raw text, outside any `{...}`
                state Expr(depth: usize)                # inside `{...}` (depth = brace nesting)
                state InnerString(depth: usize)         # a `"..."` embedded in the `{...}`

                start Text

                Text, '"':
                    text_end: usize = lexer.position
                    lexer <- lexer.advance_char()       # closing quote
                    return Token(TokenKind.FString, position, start, text_end)

                Text, '\n':
                    # Unterminated: end the raw span at the newline.
                    return Token(TokenKind.FString, position, start, lexer.position)

                # Escape at end-of-line/source: consume the backslash and end the span.
                Text, '\\' if lexer.position + 1 >= lexer.source_length or lexer.peek(1) == '\n':
                    lexer <- lexer.advance_char()
                    return Token(TokenKind.FString, position, start, lexer.position)

                Text, '\\':
                    lexer <- lexer.advance_chars(2)
                    -> Text

                Text, '{' if lexer.peek(1) == '{':      # `{{` is a literal brace
                    lexer <- lexer.advance_chars(2)
                    -> Text

                Text, '{':
                    lexer <- lexer.advance_char()
                    -> Expr(1)

                Text, '}' if lexer.peek(1) == '}':      # `}}` is a literal brace
                    lexer <- lexer.advance_chars(2)
                    -> Text

                Text, _:
                    lexer <- lexer.advance_char()
                    -> Text

                Expr(depth), '\n':
                    return Token(TokenKind.FString, position, start, lexer.position)

                Expr(depth), '{':
                    lexer <- lexer.advance_char()
                    -> Expr(depth + 1)

                Expr(1), '}':
                    lexer <- lexer.advance_char()
                    -> Text

                Expr(depth > 1), '}':
                    lexer <- lexer.advance_char()
                    -> Expr(depth - 1)

                Expr(depth), '"':
                    lexer <- lexer.advance_char()
                    -> InnerString(depth)

                Expr(depth), _:
                    lexer <- lexer.advance_char()
                    -> Expr(depth)

                InnerString(depth), '"':
                    lexer <- lexer.advance_char()
                    -> Expr(depth)

                InnerString(depth), '\n':
                    # Mirrors the pre-automaton skip-loop: the newline is consumed and
                    # scanning resumes inside the `{...}`.
                    lexer <- lexer.advance_char()
                    -> Expr(depth)

                InnerString(depth), '\\':
                    lexer <- lexer.advance_chars(2)
                    -> InnerString(depth)

                InnerString(depth), _:
                    lexer <- lexer.advance_char()
                    -> InnerString(depth)

            return Token(TokenKind.FString, position, start, lexer.position)


        def read_char(lexer: lmut Lexer) -> Token:
            position: LexerPosition = lexer.cursor_position()
            lexer <- lexer.advance_char()
            start: usize = lexer.position

            machine over lexer.current_char() while not lexer.is_end_of_source():
                state Scanning

                start Scanning

                Scanning, '\'':
                    text_end: usize = lexer.position
                    lexer <- lexer.advance_char()   # closing quote
                    return Token(TokenKind.CharLit, position, start, text_end)

                Scanning, '\n':
                    return Token(TokenKind.CharLit, position, start, lexer.position)

                Scanning, '\\' if lexer.position + 1 >= lexer.source_length or lexer.peek(1) == '\n':
                    lexer <- lexer.advance_char()
                    return Token(TokenKind.CharLit, position, start, lexer.position)

                Scanning, '\\':
                    lexer <- lexer.advance_chars(2)
                    -> Scanning

                Scanning, _:
                    lexer <- lexer.advance_char()
                    -> Scanning

            # Unterminated at EOF.
            return Token(TokenKind.CharLit, position, start, lexer.position)
