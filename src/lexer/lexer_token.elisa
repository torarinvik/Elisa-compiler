# Token construction is isolated from the token model; its numeric span fields
# are sourced from the separately verified pure TokenSpan projection.
extend Lexer:
    public:
        def Token(kind: TokenKind, position: LexerPosition, start: usize, text_end: usize, suffix_end: usize) -> Token:
            span: TokenSpan = token_span_fields(position.line.u32(), position.column.u32(), start.u32(), (text_end - start).u32(), (suffix_end - text_end).u16())
            token: mutable Token = zeroed
            token.kind <- kind
            token.line <- span.line
            token.column <- span.column
            token.start <- span.start
            token.length <- span.length
            token.suffix_length <- span.suffix_length
            token.flags.has_suffix <- suffix_end > text_end
            return token

        def Token(kind: TokenKind, position: LexerPosition, start: usize, text_end: usize) -> Token:
            return Token(kind, position, start, text_end, text_end)
