# Payload arithmetic contracts for three- and four-byte UTF-8 sequences. The
# lexer checks the raw-byte ranges and boundary cases before passing normalized
# payloads here; this keeps the arithmetic proof linear in the bounded payloads.
@inline(always)
def lexer_decode_utf8_three(lead_payload: i64, second_payload: i64, third_payload: i64) -> i64:
    requires lead_payload >= 0 and lead_payload <= 15
    requires second_payload >= 0 and second_payload <= 63
    requires third_payload >= 0 and third_payload <= 63
    ensure result == lead_payload * UTF8_THREE_BYTE_LEAD_PLACE_VALUE + second_payload * UTF8_THREE_BYTE_SECOND_PLACE_VALUE + third_payload
    ensure result >= 0
    ensure result <= UTF8_THREE_BYTE_SCALAR_MAX
    return lead_payload * UTF8_THREE_BYTE_LEAD_PLACE_VALUE + second_payload * UTF8_THREE_BYTE_SECOND_PLACE_VALUE + third_payload

@inline(always)
def lexer_decode_utf8_four(lead_payload: i64, second_payload: i64, third_payload: i64, fourth_payload: i64) -> i64:
    requires lead_payload >= 0 and lead_payload <= 4
    requires second_payload >= 0 and second_payload <= 63
    requires third_payload >= 0 and third_payload <= 63
    requires fourth_payload >= 0 and fourth_payload <= 63
    ensure result == lead_payload * UTF8_FOUR_BYTE_LEAD_PLACE_VALUE + second_payload * UTF8_FOUR_BYTE_SECOND_PLACE_VALUE + third_payload * UTF8_FOUR_BYTE_THIRD_PLACE_VALUE + fourth_payload
    ensure result >= 0
    ensure result <= 0x13FFFF
    return lead_payload * UTF8_FOUR_BYTE_LEAD_PLACE_VALUE + second_payload * UTF8_FOUR_BYTE_SECOND_PLACE_VALUE + third_payload * UTF8_FOUR_BYTE_THIRD_PLACE_VALUE + fourth_payload
