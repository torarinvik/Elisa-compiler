# Pure cursor transition components used by Lexer.advance_char. Keeping these
# scalar relations separate makes their source invariants independently
# checkable without importing the lexer scanners.
module LexerPositionStep:
    public:
        def advanced_line(line: int, is_newline: bool) -> int:
            ensure result == (line + 1 if is_newline else line)
            return line + 1 if is_newline else line

        def column_after_newline(is_newline: bool) -> int:
            ensure result == (1 if is_newline else 0)
            return 1 if is_newline else 0

        def advanced_column(column: int) -> int:
            ensure result == column + 1
            return column + 1

        def advanced_offset(offset: usize, source_length: usize) -> usize:
            ensure result == (offset + 1 if offset < source_length else offset)
            return offset + 1 if offset < source_length else offset
