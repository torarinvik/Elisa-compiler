# Decimal digit conversion used while reading #line directives.
module LexerDirectiveDigit:
    public:
        # The lexer passes a byte only from the matching ASCII digit arm. The helper is total
        # over bytes so its arithmetic and fallback behavior are explicit in the contract.
        def decimal_digit_value(character: u8) -> int:
            ensure result == ((character - 48).int() if character >= 48 and character <= 57 else 0)
            return (character - 48).int() if character >= 48 and character <= 57
            return 0
