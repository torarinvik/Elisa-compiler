# Shared bounded pointer-to-view boundary, usable without the complete scanner.
extend Lexer:
    public:
        @inline(always)
        def make_source_view(source: u8&, source_length: usize, start: usize, end: usize) -> sview?:
            null return if start > end or end > source_length
            null return if end <= start
            # The source pointer is paired with the lexer's authoritative byte length;
            # only form the raw-pointer slice after proving the requested half-open span
            # fits that extent. This is the narrow pointer-to-view boundary for source text.
            trusted Unsafe.PointerCast:
                return source[start:end]
