# Shared bounded pointer-to-view boundary, usable without the complete scanner.
extend Lexer:
    public:
        @inline(always)
        def make_source_view(source: u8&, source_length: usize, start: usize, end: usize) -> sview?:
            return null if:
                start > end or end > source_length
                end <= start
            # The caller supplies the readable byte extent for this pointer. The bounds
            # checks prove the requested half-open span fits that supplied extent; they
            # cannot establish that the pointer actually has that much backing storage.
            # Callers must pass the source's real length before reaching this boundary.
            trusted Unsafe.PointerCast:
                return source[start:end]
