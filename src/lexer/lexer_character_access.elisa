# Pure branches for the lexer's bounded character accessor. Separating the
# in-range and out-of-range cases keeps each source-bound byte choice explicit
# in a small, replayable contract without modeling raw-pointer memory.
@inline(always)
def lexer_byte_if_in_range(byte: u8, source_length: usize, index: usize) -> u8:
    requires index < source_length
    ensure result == byte
    return byte

@inline(always)
def lexer_sentinel_if_out_of_range(sentinel: u8, source_length: usize, index: usize) -> u8:
    requires index >= source_length
    ensure result == sentinel
    return sentinel
