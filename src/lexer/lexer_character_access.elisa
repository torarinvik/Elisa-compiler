# Pure byte selection for the lexer's bounded character accessor. Keeping the
# source load outside this function lets the proof kernel establish the exact
# sentinel choice without pretending to model raw-pointer memory.
def lexer_byte_or_sentinel(byte: u8, source_length: usize, index: usize, sentinel: u8) -> u8:
    ensure index >= source_length implies result == sentinel
    ensure index < source_length implies result == byte
    sentinel return if index >= source_length
    return byte
