extend Lexer:
    public:
        # Keyword classification for the self-hosted lexer.
        #
        # This table is the single source of which identifiers are keywords; it
        # MUST stay in lockstep with the stage0 Go keyword table (compiler/src/lexer/
        # token.go `keywords`). The frontend-lexer parity harness checksums token kinds
        # against stage0, so any added/removed/renamed entry here is caught immediately.
        #
        # `aligned` is intentionally absent: its enum slot is reserved but it must remain
        # a usable identifier (see token.go:44).
        #
        # Implemented as an if-chain (not `const dict` + `get … else`) so stage1 can
        # meta-compile the lexer without const-dict lowering. Behavior matches the
        # prior dict table entry-for-entry.
        def frontend_lookup_keyword(text: sview) -> TokenKind:
            TokenKind.As return if text == "as"
            TokenKind.If return if text == "if"
            TokenKind.In return if text == "in"
            TokenKind.Or return if text == "or"
            TokenKind.Is return if text == "is"
            TokenKind.To return if text == "to"
            TokenKind.And return if text == "and"
            TokenKind.Def return if text == "def"
            TokenKind.Not return if text == "not"
            TokenKind.Try return if text == "try"
            TokenKind.Elif return if text == "elif"
            TokenKind.Else return if text == "else"
            TokenKind.Enum return if text == "enum"
            TokenKind.Heap return if text == "heap"
            TokenKind.Null return if text == "null"
            TokenKind.Pass return if text == "pass"
            TokenKind.Repr return if text == "repr"
            TokenKind.Tail return if text == "tail"
            TokenKind.True return if text == "true"
            TokenKind.With return if text == "with"
            TokenKind.Break return if text == "break"
            TokenKind.Catch return if text == "catch"
            TokenKind.Const return if text == "const"
            TokenKind.Error return if text == "error"
            TokenKind.False return if text == "false"
            TokenKind.Match return if text == "match"
            TokenKind.Panic return if text == "panic"
            TokenKind.Raise return if text == "raise"
            TokenKind.Stack return if text == "stack"
            TokenKind.While return if text == "while"
            TokenKind.Export return if text == "export"
            TokenKind.Extern return if text == "extern"
            TokenKind.Global return if text == "global"
            TokenKind.Packed return if text == "packed"
            TokenKind.Return return if text == "return"
            TokenKind.Sizeof return if text == "sizeof"
            TokenKind.Sizeof return if text == "size_of"
            TokenKind.Static return if text == "static"
            TokenKind.Struct return if text == "struct"
            TokenKind.Zeroed return if text == "zeroed"
            TokenKind.Alignof return if text == "alignof"
            TokenKind.Alignof return if text == "align_of"
            TokenKind.Mutable return if text == "mutable"
            TokenKind.Lmut return if text == "lmut"
            TokenKind.Continue return if text == "continue"
            TokenKind.Offsetof return if text == "offsetof"
            TokenKind.Offsetof return if text == "offset_of"
            return TokenKind.Ident
