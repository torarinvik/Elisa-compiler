extend Lexer:
    private:
        # ============================================================
        # Self-hosted frontend lexer
        # ============================================================
        @inline(always)
        def pending_is_empty(lexer: Lexer&) -> bool:
            return lexer.pending_start >= lexer.pending_tokens.count


        def pending_push_back(lexer: lmut Lexer, token: Token):
            lexer.pending_tokens <- lexer.pending_tokens.push(token)


        def pending_pop_front(lexer: lmut Lexer) -> Token:
            can Abort.Panic:
                assert not lexer.pending_is_empty()
                token: Token = lexer.pending_tokens[lexer.pending_start]
                lexer.pending_start <- lexer.pending_start + 1
                return token


        @inline(always)
        def cursor_position(lexer: Lexer&) -> LexerPosition:
            return LexerPosition{line: lexer.line, column: lexer.column, offset: lexer.position}


        @inline(always)
        def is_end_of_source(lexer: Lexer&) -> bool:
            return lexer.position >= lexer.source_length


        def push_pending(lexer: lmut Lexer, token: Token):
            lexer <- lexer.pending_push_back(token) can Memory.Allocate, Abort.Panic


        def pop_pending(lexer: lmut Lexer) -> Token:
            rebind token: Token, lexer = lexer.pending_pop_front() can Abort.Panic
            return token


        @inline(always)
        def is_immediate_grouped_block_introducer(text: sview) -> bool:
            return text == "do"


        @inline(always)
        def active_grouped_block_context(lexer: Lexer&) -> bool:
            if lexer.grouped_block_contexts.count == 0:
                return false
            return lexer.group_depth >= lexer.grouped_block_contexts[lexer.grouped_block_contexts.count - 1].group_depth


        def trim_finished_grouped_block_contexts(lexer: lmut Lexer):
            while lexer.grouped_block_contexts.count > 0 |lexer|:
                top: GroupedBlockContext = lexer.grouped_block_contexts[lexer.grouped_block_contexts.count - 1]
                current_indent: usize = lexer.indentation_top()
                if current_indent > top.base_indent:
                    return
                lexer.grouped_block_contexts <- lexer.grouped_block_contexts.truncate(lexer.grouped_block_contexts.count - 1)


        def measure_indent(lexer: lmut Lexer) -> usize:
            indent: usize =
                while not lexer.is_end_of_source() |lexer, indent: usize = 0| -> indent:
                    character: char = lexer.current_char()
                    if character == ' ':
                        indent <- indent + 1
                        lexer <- lexer.advance_char()
                    elif character == '\t':
                        indent <- indent + FRONTEND_TAB_WIDTH
                        lexer <- lexer.advance_char()
                    else:
                        break
            return indent
        def indentation_top(lexer: Lexer&) -> usize:
            if lexer.indentation_stack.count == 0:
                return 0
            else:
                return lexer.indentation_stack[lexer.indentation_stack.count - 1]

        def push_indent(lexer: lmut Lexer, value: usize):
            can Memory.Allocate, Abort.Panic:
                lexer.indentation_stack <- lexer.indentation_stack.push(value)

        def pop_indent(lexer: lmut Lexer):
            if lexer.indentation_stack.count > 0:
                lexer.indentation_stack <- lexer.indentation_stack.truncate(lexer.indentation_stack.count - 1)

        def handle_indentation(lexer: lmut Lexer):
            can Memory.Allocate, Abort.Panic:
                rebind measured_indent: usize, lexer = lexer.measure_indent()

                indent: usize =
                    while scanning |lexer, indent: usize = measured_indent, scanning = true| -> indent:
                        if lexer.is_end_of_source() or lexer.current_char() == '\n':
                            return

                        if lexer.current_char() == '#':
                            if indent == 0:
                                rebind consumed_line_directive: bool, lexer = lexer.try_consume_line_directive()
                                if consumed_line_directive:
                                    indent, lexer <- lexer.measure_indent()
                                    continue

                            lexer <- lexer.skip_line_comment()
                            if not lexer.is_end_of_source() and lexer.current_char() == '\n':
                                lexer <- lexer.advance_char()
                                while not lexer.is_end_of_source() and lexer.current_char() == '\n' |lexer|:
                                    lexer <- lexer.advance_char()
                            indent, lexer <- lexer.measure_indent()
                        else:
                            if lexer.is_block_comment_start():
                                lexer <- lexer.skip_block_comment()
                                lexer <- lexer.skip_spaces()
                                if lexer.is_end_of_source() or lexer.current_char() == '\n':
                                    if not lexer.is_end_of_source() and lexer.current_char() == '\n':
                                        lexer <- lexer.advance_char()
                                        while not lexer.is_end_of_source() and lexer.current_char() == '\n' |lexer|:
                                            lexer <- lexer.advance_char()
                                    indent, lexer <- lexer.measure_indent()
                                else:
                                    scanning <- false
                            else:
                                scanning <- false

                lexer.at_line_start <- false
                current: usize = lexer.indentation_top()
                if indent > current:
                    lexer <- lexer.push_indent(indent)
                    lexer <- lexer.emit_pending_token(TokenKind.Indent)
                    return

                if indent < current:
                    while lexer.indentation_stack.count > 0 and lexer.indentation_top() > indent |lexer|:
                        lexer <- lexer.pop_indent()
                        lexer <- lexer.emit_pending_token(TokenKind.Dedent)

                    if lexer.indentation_top() < indent:
                        lexer <- lexer.push_indent(indent)
                        lexer <- lexer.emit_pending_token(TokenKind.Indent)
        @inline(always)
        def is_alpha(character: char) -> bool:
            return character in 'a'..'z' or character in 'A'..'Z'
        @inline(always)
        def is_alphanumeric(character: char) -> bool:
            return character.is_alpha() or character.is_digit()
        @inline(always)
        def is_identifier_start(character: char) -> bool:
            return character == '_' or character == '$' or character.is_alpha()
        @inline(always)
        def is_identifier_char(character: char) -> bool:
            return character == '_' or character == '$' or character.is_alphanumeric()

        @inline(always)
        def is_latin1_letter_codepoint(value: u8) -> bool:
            return value == 0xAA or value == 0xB5 or value == 0xBA or value in 0xC0..0xD6 or value in 0xD8..0xF6 or value in 0xF8..0xFF

        @inline(always)
        def is_unicode2_letter_codepoint(value: int) -> bool:
            return value in 0x00F8..0x02C1 or value in 0x02C6..0x02D1 or value in 0x02E0..0x02E4 or value == 0x02EC or value == 0x02EE or value in 0x0370..0x0374 or value in 0x0376..0x0377 or value in 0x037A..0x037D or value == 0x037F or value == 0x0386 or value in 0x0388..0x038A or value == 0x038C or value in 0x038E..0x03A1 or value in 0x03A3..0x03F5 or value in 0x03F7..0x0481 or value in 0x048A..0x052F or value in 0x0531..0x0556 or value == 0x0559 or value in 0x0560..0x0588 or value in 0x05D0..0x05EA or value in 0x05EF..0x05F2 or value in 0x0620..0x064A or value in 0x066E..0x066F or value in 0x0671..0x06D3 or value == 0x06D5 or value in 0x06E5..0x06E6 or value in 0x06EE..0x06EF or value in 0x06FA..0x06FC or value == 0x06FF or value == 0x0710 or value in 0x0712..0x072F or value in 0x074D..0x07A5 or value == 0x07B1 or value in 0x07CA..0x07EA or value in 0x07F4..0x07F5 or value == 0x07FA

        @inline(always)
        def is_unicode2_digit_codepoint(value: int) -> bool:
            return value in 0x0660..0x0669 or value in 0x06F0..0x06F9 or value in 0x07C0..0x07C9

        # Supplementary-plane letters accepted in identifiers: the Mathematical
        # Alphanumeric Symbols block (U+1D400..U+1D7CB). Ranges are the exact
        # unicode.IsLetter gaps over that block (holes are reserved codepoints
        # plus the Sm operators U+1D6C1 nabla / U+1D6DB partial etc.), keeping
        # stage1 token-for-token with stage0's rune classification.
        def is_math_alphanumeric_letter_codepoint(value: int) -> bool:
            return value in 0x1D400..0x1D454 or value in 0x1D456..0x1D49C or value in 0x1D49E..0x1D49F or value == 0x1D4A2 or value in 0x1D4A5..0x1D4A6 or value in 0x1D4A9..0x1D4AC or value in 0x1D4AE..0x1D4B9 or value == 0x1D4BB or value in 0x1D4BD..0x1D4C3 or value in 0x1D4C5..0x1D505 or value in 0x1D507..0x1D50A or value in 0x1D50D..0x1D514 or value in 0x1D516..0x1D51C or value in 0x1D51E..0x1D539 or value in 0x1D53B..0x1D53E or value in 0x1D540..0x1D544 or value == 0x1D546 or value in 0x1D54A..0x1D550 or value in 0x1D552..0x1D6A5 or value in 0x1D6A8..0x1D6C0 or value in 0x1D6C2..0x1D6DA or value in 0x1D6DC..0x1D6FA or value in 0x1D6FC..0x1D714 or value in 0x1D716..0x1D734 or value in 0x1D736..0x1D74E or value in 0x1D750..0x1D76E or value in 0x1D770..0x1D788 or value in 0x1D78A..0x1D7A8 or value in 0x1D7AA..0x1D7C2 or value in 0x1D7C4..0x1D7CB

        @inline(always)
        def is_math_alphanumeric_digit_codepoint(value: int) -> bool:
            return value in 0x1D7CE..0x1D7FF

        # Decode the 4-byte UTF-8 sequence at the cursor to its codepoint, or -1
        # if the bytes at the cursor are not a valid 4-byte sequence.
        @inline(always)
        def four_byte_codepoint_at_cursor(lexer: Lexer&) -> int:
            first: u8 = lexer.source[lexer.position]
            if first < 0xF0 or first > 0xF4 or lexer.position + 3 >= lexer.source_length:
                return -1
            if not lexer.starts_valid_utf8_sequence():
                return -1
            second: u8 = lexer.source[lexer.position + 1]
            third: u8 = lexer.source[lexer.position + 2]
            fourth: u8 = lexer.source[lexer.position + 3]
            return ((first.i64() - 0xF0) * 0x40000 + (second.i64() - 0x80) * 0x1000 + (third.i64() - 0x80) * 0x40 + (fourth.i64() - 0x80)).int()

        @inline(always)
        def is_utf8_continuation(byte: u8) -> bool:
            return byte in 0x80..0xBF

        @inline(always)
        def starts_valid_utf8_sequence(lexer: Lexer&) -> bool:
            first: u8 = lexer.source[lexer.position]
            if first in 0xC2..0xDF:
                return lexer.position + 1 < lexer.source_length and is_utf8_continuation(lexer.source[lexer.position + 1])
            if first == 0xE0:
                return lexer.position + 2 < lexer.source_length and lexer.source[lexer.position + 1] in 0xA0..0xBF and is_utf8_continuation(lexer.source[lexer.position + 2])
            if first in 0xE1..0xEC or first in 0xEE..0xEF:
                return lexer.position + 2 < lexer.source_length and is_utf8_continuation(lexer.source[lexer.position + 1]) and is_utf8_continuation(lexer.source[lexer.position + 2])
            if first == 0xED:
                return lexer.position + 2 < lexer.source_length and lexer.source[lexer.position + 1] in 0x80..0x9F and is_utf8_continuation(lexer.source[lexer.position + 2])
            if first == 0xF0:
                return lexer.position + 3 < lexer.source_length and lexer.source[lexer.position + 1] in 0x90..0xBF and is_utf8_continuation(lexer.source[lexer.position + 2]) and is_utf8_continuation(lexer.source[lexer.position + 3])
            if first in 0xF1..0xF3:
                return lexer.position + 3 < lexer.source_length and is_utf8_continuation(lexer.source[lexer.position + 1]) and is_utf8_continuation(lexer.source[lexer.position + 2]) and is_utf8_continuation(lexer.source[lexer.position + 3])
            if first == 0xF4:
                return lexer.position + 3 < lexer.source_length and lexer.source[lexer.position + 1] in 0x80..0x8F and is_utf8_continuation(lexer.source[lexer.position + 2]) and is_utf8_continuation(lexer.source[lexer.position + 3])
            return false

        @inline(always)
        def unicode_identifier_start_width(lexer: Lexer&) -> u8:
            first: u8 = lexer.source[lexer.position]
            if lexer.position + 1 < lexer.source_length:
                second: u8 = lexer.source[lexer.position + 1]
                if first == 0xC2 and second.is_latin1_letter_codepoint():
                    return 2
                if first == 0xC3 and second in 0x80..0xBF and (0xC0 + (second - 0x80)).u8().is_latin1_letter_codepoint():
                    return 2
                if first in 0xC4..0xDF and second.is_utf8_continuation() and ((first.i64() - 0xC0) * 64 + (second.i64() - 0x80)).int().is_unicode2_letter_codepoint():
                    return 2
            if first >= 0xF0 and lexer.four_byte_codepoint_at_cursor().is_math_alphanumeric_letter_codepoint():
                return 4
            if first.is_latin1_letter_codepoint() and not lexer.starts_valid_utf8_sequence():
                return 1
            return 0

        @inline(always)
        def unicode_identifier_char_width(lexer: Lexer&) -> u8:
            start_width: u8 = lexer.unicode_identifier_start_width()
            if start_width > 0:
                return start_width

            first: u8 = lexer.source[lexer.position]
            if lexer.position + 1 < lexer.source_length:
                second: u8 = lexer.source[lexer.position + 1]
                if first in 0xD9..0xDF and second.is_utf8_continuation() and ((first.i64() - 0xC0) * 64 + (second.i64() - 0x80)).int().is_unicode2_digit_codepoint():
                    return 2
            if first >= 0xF0 and lexer.four_byte_codepoint_at_cursor().is_math_alphanumeric_digit_codepoint():
                return 4
            return 0

        @inline(always)
        def starts_unicode_identifier(lexer: Lexer&) -> bool:
            return lexer.unicode_identifier_start_width() > 0

        @inline(always)
        def continues_unicode_identifier(lexer: Lexer&) -> bool:
            return lexer.unicode_identifier_char_width() > 0

        @inline(always)
        def advance_latin1_identifier_char(lexer: lmut Lexer):
            width: u8 = lexer.unicode_identifier_char_width()
            if width > 1:
                lexer <- lexer.advance_chars(width)
            elif width == 1:
                lexer <- lexer.advance_char()

        @inline(always)
        def valid_suffix(view: sview) -> bool:
            match view[0]:
                'u':
                    return any suffix in ["u", "u8", "u16", "u32", "u64", "usize"] where view == suffix
                'i':
                    return any suffix in ["i8", "i16", "i32", "i64", "isize"] where view == suffix
                'f':
                    return any suffix in ["f32", "f64"] where view == suffix
                _:
                    return false


        @inline(always)
        def read_type_suffix(lexer: lmut Lexer) -> sview?:
            start: usize = lexer.position
            first: char = lexer.current_char()
            begin_type_suffix = first in {'u', 'i', 'f'}
            if not begin_type_suffix:
                return null

            probe: usize =
                while probe < lexer.source_length and char_at(lexer.source, lexer.source_length, probe).is_alphanumeric() |probe: usize = start + 1| -> probe:
                    probe <- probe + 1

            suffix: sview = get lexer.view(start, probe)
            if not suffix.valid_suffix():
                return null

            lexer.position <- probe
            lexer.column <- lexer.column + (probe - start).i64()
            return suffix
        def read_identifier(lexer: lmut Lexer) -> Token:
            position: LexerPosition = lexer.cursor_position()
            start: usize = lexer.position
            # Hot path: identifiers are overwhelmingly ASCII. Scan the common case with a
            # single char read + direct position/column bump (ident chars are never '\n',
            # so advance_char's newline branch and its re-read of the current char are
            # pure overhead here). Fall back to the Latin-1/unicode path only on a
            # non-ASCII continuation byte.
            while not lexer.is_end_of_source() |lexer|:
                character: char = lexer.current_char()
                if character.is_identifier_char():
                    lexer.position <- lexer.position + 1
                    lexer.column <- lexer.column + 1
                elif lexer.continues_unicode_identifier():
                    lexer <- lexer.advance_latin1_identifier_char()
                else:
                    break
            text: sview = get lexer.view(start, lexer.position) else sview("", 0, 0)
            # Every keyword is 2-9 bytes (see FRONTEND_KEYWORDS). Skip the keyword dict
            # hash+probe for identifiers outside that range — the common long snake_case
            # names and 1-char locals — which can never be keywords.
            identifier_length: usize = lexer.position - start
            kind: TokenKind = frontend_lookup_keyword(text) if identifier_length >= 2 and identifier_length <= 9 else TokenKind.Ident
            lexer.pending_grouped_block <- kind == TokenKind.Ident and is_immediate_grouped_block_introducer(text)
            return Token(kind, position, start, lexer.position)
