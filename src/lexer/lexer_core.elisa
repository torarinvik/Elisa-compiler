include "./lexer_cursor_domain.elisa"
include "./lexer_type_suffix.elisa"

extend Lexer:
    private:
        # ============================================================
        # Self-hosted frontend lexer
        # ============================================================
        @inline(always)
        def pending_is_empty(lexer: Lexer&) -> bool:
            return lexer.pending_start >= lexer.pending_tokens.count


        def pending_push_back(lexer: lmut Lexer, token: Token):
            lexer.pending_tokens <- lexer.pending_tokens.push(token)


        def pending_pop_front(lexer: lmut Lexer) -> Token:
            can Abort.Panic:
                assert not lexer.pending_is_empty()
                token: Token = lexer.pending_tokens[lexer.pending_start]
                lexer.pending_start <- lexer.pending_start + 1
                return token


        @inline(always)
        def cursor_position(lexer: Lexer&) -> LexerPosition:
            return LexerPosition{line: lexer.line, column: lexer.column, offset: lexer.position}


        @inline(always)
        def is_end_of_source(lexer: Lexer&) -> bool:
            ensure result == (lexer.position >= lexer.source_length)
            return LexerCursorDomain::cursor_at_or_past_source_end(lexer.position, lexer.source_length)


        def push_pending(lexer: lmut Lexer, token: Token):
            lexer <- lexer.pending_push_back(token) can Memory.Allocate, Abort.Panic


        def pop_pending(lexer: lmut Lexer) -> Token:
            rebind token: Token, lexer = lexer.pending_pop_front() can Abort.Panic
            return token


        @inline(always)
        def is_immediate_grouped_block_introducer(text: sview) -> bool:
            return text == "do"


        @inline(always)
        def active_grouped_block_context(lexer: Lexer&) -> bool:
            return lexer.grouped_block_contexts.count != 0 and lexer.group_depth >= lexer.grouped_block_contexts[lexer.grouped_block_contexts.count - 1].group_depth


        def trim_finished_grouped_block_contexts(lexer: lmut Lexer):
            machine over lexer.indentation_top() while lexer.grouped_block_contexts.count > 0:
                state Trim
                start Trim
                Trim, current_indent if current_indent > lexer.grouped_block_contexts[lexer.grouped_block_contexts.count - 1].base_indent:
                    break
                Trim, _:
                    lexer.grouped_block_contexts <- lexer.grouped_block_contexts.truncate(lexer.grouped_block_contexts.count - 1)
                    -> Trim


        def measure_indent(lexer: lmut Lexer) -> usize:
            # Stage1 meta-compile: payload machines (`state Counting(indent)`) still
            # decline; lower the indent walk as an ordinary while loop.
            lexer.machine_usize <- 0
            machine over lexer.current_char() while not lexer.is_end_of_source():
                state Count
                start Count
                Count, ' ':
                    lexer <- lexer.advance_char()
                    lexer.machine_usize <- lexer.machine_usize + 1
                    -> Count
                Count, '\t':
                    lexer <- lexer.advance_char()
                    lexer.machine_usize <- lexer.machine_usize + FRONTEND_TAB_WIDTH
                    -> Count
                Count, _:
                    break
            return lexer.machine_usize
        def indentation_top(lexer: Lexer&) -> usize:
            return 0 if lexer.indentation_stack.count == 0 else lexer.indentation_stack[lexer.indentation_stack.count - 1]

        # stage0's line continuation (lexer booleanContinuation): the line after a newline
        # continues the previous expression when the previous line ends in `and`/`or`, or
        # when it is indented at least to the current block and opens with `and`, `or` or
        # a comparison operator followed by a space. `newline_at` is the `\n`'s offset;
        # the cursor sits just past it.
        def continues_previous_line(lexer: Lexer&, newline_at: usize) -> bool:
            can Abort.Panic:
                return true if lexer.line_ends_with_boolean(newline_at)
                index: mutable usize = lexer.position
                indent: mutable usize = 0
                while index < lexer.source_length and (char_at(lexer.source, lexer.source_length, index) == ' ' or char_at(lexer.source, lexer.source_length, index) == '\t') |index, indent, lexer|:
                    indent <- indent + (4 if char_at(lexer.source, lexer.source_length, index) == '\t' else 1)
                    index <- index + 1
                return false if indent == 0 or indent < lexer.indentation_top()
                return true if lexer.source_word_at(index, "and") or lexer.source_word_at(index, "or")
                return true if lexer.source_word_at(index, "==") or lexer.source_word_at(index, "!=")
                return true if lexer.source_word_at(index, "<=") or lexer.source_word_at(index, ">=")
                return lexer.source_word_at(index, "<") or lexer.source_word_at(index, ">")

        # Whether `word` is spelled at `index` and followed by a space or tab.
        def source_word_at(lexer: Lexer&, index: usize, word: sview) -> bool:
            can Abort.Panic:
                word_count: usize = word.len.usize() if word.len > 0 else 0
                return false if index + word_count >= lexer.source_length
                for offset in 0..<word_count |lexer, index, word|:
                    return false if char_at(lexer.source, lexer.source_length, index + offset) != word[offset].char()
                after: char = char_at(lexer.source, lexer.source_length, index + word_count)
                return after == ' ' or after == '\t'

        # Whether the line ending at `newline_at` ends with the word `and` or `or`.
        def line_ends_with_boolean(lexer: Lexer&, newline_at: usize) -> bool:
            can Abort.Panic:
                # Only code before an unquoted comment contributes the final token.
                line_start: mutable usize = newline_at
                while line_start > 0 and char_at(lexer.source, lexer.source_length, line_start - 1) != '\n' |line_start, lexer|:
                    line_start <- line_start - 1
                end: mutable usize = newline_at
                quote: mutable char = '\0'
                escaped: mutable bool = false
                for scan in line_start..<newline_at |quote, escaped, end, lexer|:
                    scanned: char = char_at(lexer.source, lexer.source_length, scan)
                    if quote != '\0':
                        if escaped:
                            escaped <- false
                        elif scanned == '\\':
                            escaped <- true
                        elif scanned == quote:
                            quote <- '\0'
                    elif scanned == '"' or scanned == '\'':
                        quote <- scanned
                    elif scanned == '#':
                        end <- scan
                        break
                while end > line_start and (char_at(lexer.source, lexer.source_length, end - 1) == ' ' or char_at(lexer.source, lexer.source_length, end - 1) == '\t') |end, lexer, line_start|:
                    end <- end - 1
                return lexer.word_ends_at(end, "and") or lexer.word_ends_at(end, "or")

        # Whether `word` ends at `end` as a whole identifier.
        def word_ends_at(lexer: Lexer&, end: usize, word: sview) -> bool:
            can Abort.Panic:
                word_count: usize = word.len.usize() if word.len > 0 else 0
                return false if end < word_count
                start: usize = end - word_count
                for offset in 0..<word_count |lexer, start, word|:
                    return false if char_at(lexer.source, lexer.source_length, start + offset) != word[offset].char()
                return start == 0 or not char_at(lexer.source, lexer.source_length, start - 1).is_identifier_char()

        def push_indent(lexer: lmut Lexer, value: usize):
            can Memory.Allocate, Abort.Panic:
                lexer.indentation_stack <- lexer.indentation_stack.push(value)

        def pop_indent(lexer: lmut Lexer):
            lexer.indentation_stack <- lexer.indentation_stack.truncate(lexer.indentation_stack.count - 1) if lexer.indentation_stack.count > 0

        def skip_blank_lines(lexer: lmut Lexer):
            machine over lexer.current_char() while not lexer.is_end_of_source() and lexer.current_char() == '\n':
                state Skip
                start Skip
                Skip, _:
                    lexer <- lexer.advance_char()
                    -> Skip

        def consume_hash_comment_trivia(lexer: lmut Lexer, at_column_zero: bool):
            # A `#line <num> <path>` directive is only ever emitted at column 0 by
            # include expansion; consume it only there. A `#` comment at ANY indent is
            # trivia, so an indented comment-only line (` # note`) never leaks a
            # spurious INDENT into the token stream (stage0 parity).
            state CheckColumn
            state TryDirective
            state SkipComment
            state Done
            handled: bool = start CheckColumn:
                CheckColumn:
                    -> TryDirective if at_column_zero
                    -> SkipComment
                TryDirective:
                    rebind consumed_line_directive: bool, lexer = lexer.try_consume_line_directive()
                    -> Done if consumed_line_directive
                    -> SkipComment
                SkipComment:
                    lexer <- lexer.skip_line_comment()
                    lexer <- lexer.skip_blank_lines()
                    -> Done
                Done:
                    => true

        def consume_indentation_trivia(lexer: lmut Lexer, indent: usize) -> bool:
            return false if lexer.is_end_of_source() or lexer.current_char() == '\n'

            at_hash_comment: bool = lexer.current_char() == '#'
            lexer <- lexer.consume_hash_comment_trivia(indent == 0) if at_hash_comment
            return true if at_hash_comment

            return false if not lexer.is_block_comment_start()

            lexer <- lexer.skip_block_comment()
            lexer <- lexer.skip_spaces()

            return false if not lexer.is_end_of_source() and lexer.current_char() != '\n'
            lexer <- lexer.skip_blank_lines()
            return true

        def raise_indentation(lexer: lmut Lexer, indent: usize):
            can Memory.Allocate, Abort.Panic:
                lexer <- lexer.push_indent(indent)
                lexer <- lexer.emit_pending_token(TokenKind.Indent)

        def apply_indentation_level(lexer: lmut Lexer, indent: usize):
            can Memory.Allocate, Abort.Panic:
                current: usize = lexer.indentation_top()
                lexer <- lexer.raise_indentation(indent) if indent > current
                return if indent >= current

                machine over lexer.indentation_top() while lexer.indentation_stack.count > 0 and lexer.indentation_top() > indent:
                    state Dedent
                    start Dedent
                    Dedent, _:
                        lexer <- lexer.pop_indent()
                        lexer <- lexer.emit_pending_token(TokenKind.Dedent)
                        -> Dedent

                lexer <- lexer.raise_indentation(indent) if lexer.indentation_top() < indent

        def handle_indentation(lexer: lmut Lexer):
            can Memory.Allocate, Abort.Panic:
                # Stage1 meta-compile: expression-while + bare early `return` inside a
                # value-producing loop declines; keep the same control flow as stmts.
                rebind measured_indent: usize, lexer = lexer.measure_indent()
                indent: mutable usize = measured_indent
                lexer.machine_usize <- indent
                lexer.machine_bool <- lexer.is_end_of_source() or lexer.current_char() == '\n'
                machine over lexer.machine_bool:
                    state Check
                    state Trivia
                    start Check
                    Check, true:
                        return
                    Check, _:
                        current_indent: usize = lexer.machine_usize
                        rebind consumed_trivia: bool, lexer = lexer.consume_indentation_trivia(current_indent)
                        lexer.machine_bool <- not consumed_trivia
                        -> Trivia
                    Trivia, true:
                        break
                    Trivia, _:
                        rebind next_indent: usize, lexer = lexer.measure_indent()
                        lexer.machine_usize <- next_indent
                        lexer.machine_bool <- lexer.is_end_of_source() or lexer.current_char() == '\n'
                        -> Check

                indent <- lexer.machine_usize

                lexer.at_line_start <- false
                lexer <- lexer.apply_indentation_level(indent)
        @inline(always)
        def is_alpha(character: char) -> bool:
            return character in 'a'..'z' or character in 'A'..'Z'
        @inline(always)
        def is_alphanumeric(character: char) -> bool:
            return character.is_alpha() or character.is_digit()
        @inline(always)
        def is_identifier_start(character: char) -> bool:
            return character == '_' or character == '$' or character.is_alpha()
        @inline(always)
        def is_identifier_char(character: char) -> bool:
            return character == '_' or character == '$' or character.is_alphanumeric()

        @inline(always)
        def is_latin1_letter_codepoint(value: int) -> bool:
            return value == 0xAA or value == 0xB5 or value == 0xBA or value in 0xC0..0xD6 or value in 0xD8..0xF6 or value in 0xF8..0xFF

        @inline(always)
        def is_unicode2_letter_codepoint(value: int) -> bool:
            return value in 0x00F8..0x02C1 or value in 0x02C6..0x02D1 or value in 0x02E0..0x02E4 or value == 0x02EC or value == 0x02EE or value in 0x0370..0x0374 or value in 0x0376..0x0377 or value in 0x037A..0x037D or value == 0x037F or value == 0x0386 or value in 0x0388..0x038A or value == 0x038C or value in 0x038E..0x03A1 or value in 0x03A3..0x03F5 or value in 0x03F7..0x0481 or value in 0x048A..0x052F or value in 0x0531..0x0556 or value == 0x0559 or value in 0x0560..0x0588 or value in 0x05D0..0x05EA or value in 0x05EF..0x05F2 or value in 0x0620..0x064A or value in 0x066E..0x066F or value in 0x0671..0x06D3 or value == 0x06D5 or value in 0x06E5..0x06E6 or value in 0x06EE..0x06EF or value in 0x06FA..0x06FC or value == 0x06FF or value == 0x0710 or value in 0x0712..0x072F or value in 0x074D..0x07A5 or value == 0x07B1 or value in 0x07CA..0x07EA or value in 0x07F4..0x07F5 or value == 0x07FA

        @inline(always)
        def is_unicode2_digit_codepoint(value: int) -> bool:
            return value in 0x0660..0x0669 or value in 0x06F0..0x06F9 or value in 0x07C0..0x07C9

        # Decode a valid 3-byte UTF-8 sequence at the cursor. Unicode letter and
        # decimal-digit membership is supplied by lexer_unicode_ranges.elisa,
        # generated from the same Unicode tables as the Stage0 Go lexer.
        @inline(always)
        def three_byte_codepoint_at_cursor(lexer: Lexer&) -> int:
            second_byte_index: usize = 1
            third_byte_index: usize = 2

            return -1 if lexer.position >= lexer.source_length
            remaining: usize = lexer.source_length - lexer.position
            return -1 if remaining <= third_byte_index
            first: u8 = lexer.source[lexer.position]
            return -1 if first.i64() < UTF8_THREE_BYTE_LEAD_MIN or first.i64() > UTF8_THREE_BYTE_LEAD_MAX
            second: u8 = lexer.source[lexer.position + second_byte_index]
            third: u8 = lexer.source[lexer.position + third_byte_index]
            return -1 if:
                second.i64() < UTF8_CONTINUATION_MIN or second.i64() > UTF8_CONTINUATION_MAX or third.i64() < UTF8_CONTINUATION_MIN or third.i64() > UTF8_CONTINUATION_MAX
                first.i64() == UTF8_THREE_BYTE_LEAD_MIN and second.i64() < UTF8_E0_SECOND_MIN
                first.i64() == UTF8_SURROGATE_LEAD and second.i64() > UTF8_ED_SECOND_MAX
            return lexer_decode_utf8_three(first.i64() - UTF8_THREE_BYTE_LEAD_MIN, second.i64() - UTF8_CONTINUATION_MIN, third.i64() - UTF8_CONTINUATION_MIN).int()

        # Decode the 4-byte UTF-8 sequence at the cursor to its codepoint, or -1
        # if the bytes at the cursor are not a valid 4-byte sequence.
        @inline(always)
        def four_byte_codepoint_at_cursor(lexer: Lexer&) -> int:
            second_byte_index: usize = 1
            third_byte_index: usize = 2
            fourth_byte_index: usize = 3

            return -1 if lexer.position >= lexer.source_length
            remaining: usize = lexer.source_length - lexer.position
            return -1 if remaining <= fourth_byte_index
            first: u8 = lexer.source[lexer.position]
            return -1 if first.i64() < UTF8_FOUR_BYTE_LEAD_MIN or first.i64() > UTF8_FOUR_BYTE_LEAD_MAX
            second: u8 = lexer.source[lexer.position + second_byte_index]
            third: u8 = lexer.source[lexer.position + third_byte_index]
            fourth: u8 = lexer.source[lexer.position + fourth_byte_index]
            return -1 if:
                second.i64() < UTF8_CONTINUATION_MIN or second.i64() > UTF8_CONTINUATION_MAX or third.i64() < UTF8_CONTINUATION_MIN or third.i64() > UTF8_CONTINUATION_MAX or fourth.i64() < UTF8_CONTINUATION_MIN or fourth.i64() > UTF8_CONTINUATION_MAX
                first.i64() == UTF8_FOUR_BYTE_LEAD_MIN and second.i64() < UTF8_F0_SECOND_MIN
                first.i64() == UTF8_FOUR_BYTE_LEAD_MAX and second.i64() > UTF8_F4_SECOND_MAX
            return lexer_decode_utf8_four(first.i64() - UTF8_FOUR_BYTE_LEAD_MIN, second.i64() - UTF8_CONTINUATION_MIN, third.i64() - UTF8_CONTINUATION_MIN, fourth.i64() - UTF8_CONTINUATION_MIN).int()

        @inline(always)
        def is_utf8_continuation(byte: u8) -> bool:
            return byte.i64() >= UTF8_CONTINUATION_MIN and byte.i64() <= UTF8_CONTINUATION_MAX

        @inline(always)
        def starts_valid_utf8_sequence(lexer: Lexer&) -> bool:
            return false if lexer.position >= lexer.source_length
            remaining: usize = lexer.source_length - lexer.position
            first: u8 = lexer.source[lexer.position]
            return remaining > 1 and is_utf8_continuation(lexer.source[lexer.position + 1]) if first.i64() >= UTF8_TWO_BYTE_LEAD_MIN and first.i64() <= UTF8_TWO_BYTE_LEAD_MAX
            return remaining > 2 and lexer.source[lexer.position + 1].i64() >= UTF8_E0_SECOND_MIN and lexer.source[lexer.position + 1].i64() <= UTF8_CONTINUATION_MAX and is_utf8_continuation(lexer.source[lexer.position + 2]) if first.i64() == UTF8_THREE_BYTE_LEAD_MIN
            return remaining > 2 and is_utf8_continuation(lexer.source[lexer.position + 1]) and is_utf8_continuation(lexer.source[lexer.position + 2]) if (first.i64() > UTF8_THREE_BYTE_LEAD_MIN and first.i64() < UTF8_SURROGATE_LEAD) or (first.i64() > UTF8_SURROGATE_LEAD and first.i64() <= UTF8_THREE_BYTE_LEAD_MAX)
            return remaining > 2 and lexer.source[lexer.position + 1].i64() >= UTF8_CONTINUATION_MIN and lexer.source[lexer.position + 1].i64() <= UTF8_ED_SECOND_MAX and is_utf8_continuation(lexer.source[lexer.position + 2]) if first.i64() == UTF8_SURROGATE_LEAD
            return remaining > 3 and lexer.source[lexer.position + 1].i64() >= UTF8_F0_SECOND_MIN and lexer.source[lexer.position + 1].i64() <= UTF8_CONTINUATION_MAX and is_utf8_continuation(lexer.source[lexer.position + 2]) and is_utf8_continuation(lexer.source[lexer.position + 3]) if first.i64() == UTF8_FOUR_BYTE_LEAD_MIN
            return remaining > 3 and is_utf8_continuation(lexer.source[lexer.position + 1]) and is_utf8_continuation(lexer.source[lexer.position + 2]) and is_utf8_continuation(lexer.source[lexer.position + 3]) if first.i64() > UTF8_FOUR_BYTE_LEAD_MIN and first.i64() < UTF8_FOUR_BYTE_LEAD_MAX
            return remaining > 3 and lexer.source[lexer.position + 1].i64() >= UTF8_CONTINUATION_MIN and lexer.source[lexer.position + 1].i64() <= UTF8_F4_SECOND_MAX and is_utf8_continuation(lexer.source[lexer.position + 2]) and is_utf8_continuation(lexer.source[lexer.position + 3]) if first.i64() == UTF8_FOUR_BYTE_LEAD_MAX
            return false

        @inline(always)
        def unicode_identifier_start_width(lexer: Lexer&) -> u8:
            return 0 if lexer.position >= lexer.source_length
            remaining: usize = lexer.source_length - lexer.position
            first: u8 = lexer.source[lexer.position]
            has_second: bool = remaining > 1
            second: u8 = lexer.source[lexer.position + 1] if has_second else 0
            if has_second and first.i64() >= UTF8_TWO_BYTE_LEAD_MIN and first.i64() <= UTF8_TWO_BYTE_LEAD_MAX and second.is_utf8_continuation():
                two_byte_codepoint: int = lexer_decode_utf8_two(first.i64(), second.i64()).int()
                if first.i64() <= UTF8_TWO_BYTE_LATIN1_LEAD_MAX:
                    return 2 if two_byte_codepoint.is_latin1_letter_codepoint()
                else:
                    return 2 if two_byte_codepoint.is_unicode2_letter_codepoint()
            return 3 if first.i64() >= UTF8_THREE_BYTE_LEAD_MIN and first.i64() <= UTF8_THREE_BYTE_LEAD_MAX and lexer.three_byte_codepoint_at_cursor().is_unicode_letter_codepoint()
            return 4 if first.i64() >= UTF8_FOUR_BYTE_LEAD_MIN and first.i64() <= UTF8_FOUR_BYTE_LEAD_MAX and lexer.four_byte_codepoint_at_cursor().is_unicode_letter_codepoint()
            return 1 if first.int().is_latin1_letter_codepoint() and not lexer.starts_valid_utf8_sequence()
            return 0

        @inline(always)
        def unicode_identifier_char_width(lexer: Lexer&) -> u8:
            return 0 if lexer.position >= lexer.source_length
            remaining: usize = lexer.source_length - lexer.position
            first: u8 = lexer.source[lexer.position]
            has_second: bool = remaining > 1
            second: u8 = lexer.source[lexer.position + 1] if has_second else 0
            if has_second and first.i64() >= UTF8_TWO_BYTE_LEAD_MIN and first.i64() <= UTF8_TWO_BYTE_LEAD_MAX and second.is_utf8_continuation():
                two_byte_codepoint: int = lexer_decode_utf8_two(first.i64(), second.i64()).int()
                if first.i64() <= UTF8_TWO_BYTE_LATIN1_LEAD_MAX:
                    return 2 if two_byte_codepoint.is_latin1_letter_codepoint()
                else:
                    return 2 if two_byte_codepoint.is_unicode2_letter_codepoint()
                return 2 if first.i64() >= UTF8_TWO_BYTE_ARABIC_DIGIT_LEAD_MIN and two_byte_codepoint.is_unicode2_digit_codepoint()
            if first.i64() >= UTF8_THREE_BYTE_LEAD_MIN and first.i64() <= UTF8_THREE_BYTE_LEAD_MAX:
                three_byte_codepoint: int = lexer.three_byte_codepoint_at_cursor()
                return 3 if three_byte_codepoint.is_unicode_letter_codepoint() or three_byte_codepoint.is_unicode_digit_codepoint()
            if first.i64() >= UTF8_FOUR_BYTE_LEAD_MIN and first.i64() <= UTF8_FOUR_BYTE_LEAD_MAX:
                four_byte_codepoint: int = lexer.four_byte_codepoint_at_cursor()
                return 4 if four_byte_codepoint.is_unicode_letter_codepoint() or four_byte_codepoint.is_unicode_digit_codepoint()
            return 1 if first.int().is_latin1_letter_codepoint() and not lexer.starts_valid_utf8_sequence()
            return 0

        @inline(always)
        def starts_unicode_identifier(lexer: Lexer&) -> bool:
            return lexer.unicode_identifier_start_width() > 0

        @inline(always)
        def continues_unicode_identifier(lexer: Lexer&) -> bool:
            return lexer.unicode_identifier_char_width() > 0

        @inline(always)
        def advance_latin1_identifier_char(lexer: lmut Lexer):
            width: u8 = lexer.unicode_identifier_char_width()
            match width:
                0:
                    pass
                1:
                    lexer <- lexer.advance_char()
                _:
                    lexer <- lexer.advance_chars(width)

        @inline(always)
        def valid_suffix(view: sview) -> bool:
            return LexerTypeSuffix::is_valid_type_suffix(view)


        def read_type_suffix(lexer: lmut Lexer) -> sview?:
            return Lexer::read_type_suffix_at(lexer.source, lexer.source_length, lexer.position)

        def read_type_suffix_at(source: u8&, source_length: usize, start: usize) -> sview?:
            first: char = char_at(source, source_length, start)
            return null if not (first == 'u' or first == 'i' or first == 'f')
            probe: mutable usize = start + 1
            probe <- probe + 1 if probe < source_length and char_at(source, source_length, probe).is_alphanumeric()
            probe <- probe + 1 if probe < source_length and char_at(source, source_length, probe).is_alphanumeric()
            probe <- probe + 1 if probe < source_length and char_at(source, source_length, probe).is_alphanumeric()
            probe <- probe + 1 if probe < source_length and char_at(source, source_length, probe).is_alphanumeric()
            probe <- probe + 1 if probe < source_length and char_at(source, source_length, probe).is_alphanumeric()
            match make_source_view(source, source_length, start, probe):
                suffix:
                    # `u`/`i` widths and `f32`/`f64` are a closed suffix grammar. Returning the
                    # exact spellings avoids accepting the Cartesian product of width digits
                    # (such as u14, i34, or i66) rather than only the supported widths.
                    valid: bool = Lexer::valid_suffix(suffix)
                    return suffix if valid
                _:
                    pass
            return null

        @inline(always)
        def read_identifier(lexer: lmut Lexer) -> Token:
            position: LexerPosition = lexer.cursor_position()
            start: usize = lexer.position
            machine over lexer.current_char() while not lexer.is_end_of_source():
                state ScanIdentifier
                start ScanIdentifier
                ScanIdentifier, character if is_identifier_char(character):
                    lexer <- lexer.advance_char()
                    -> ScanIdentifier
                ScanIdentifier, _ if lexer.continues_unicode_identifier():
                    lexer <- lexer.advance_latin1_identifier_char()
                    -> ScanIdentifier
                ScanIdentifier, _:
                    break
            # SLICE the source, do not call the `sview(base, start, end)` CONSTRUCTOR: that
            # one clamps against `strlen(base)` (stage0's std semantics, which stage1 now
            # matches), and `base` here is the WHOLE source buffer — so a constructor call
            # per identifier token is a full scan of the file per token. Measured: 30s ->
            # 76s to compile test/breadth/parse_report.elisa, enough to cross the
            # differential corpus's 60s compile timeout. The lexer's own offsets are in
            # range by construction, which is exactly what every other token-text read here
            # already relies on (Token.text -> make_source_view -> `source[start:end]`).
            text: sview = source_view_or_empty(lexer.source, lexer.source_length, start, lexer.position)
            kind: TokenKind = frontend_lookup_keyword(text)
            lexer.pending_grouped_block <- false
            lexer.pending_grouped_block <- true if kind == TokenKind.Ident and is_immediate_grouped_block_introducer(text)
            return Token(kind, position, start, lexer.position)
