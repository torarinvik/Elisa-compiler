# Cursor arithmetic shared by the comment scanner and its termination proof.
include "./lexer_position_step.elisa"

module LexerCommentScan:
    public:
        def remaining(source_length: usize, position: usize) -> usize:
            requires position <= source_length
            ensure result <= source_length
            return source_length - position

        # Line-comment scanning has a stronger guard than advance_offset: its
        # loop only enters when the current character is not EOF; this helper
        # remains total and saturates at EOF like LexerPositionStep itself.
        def after_one(position: usize, source_length: usize) -> usize:
            ensure result == (position + 1 if position < source_length else position)
            return LexerPositionStep::advanced_offset(position, source_length)

        # A closing block-comment delimiter is recognized only when all three
        # quote characters are present, so three ordinary cursor steps apply.
        def after_three(position: usize, source_length: usize) -> usize:
            ensure result == (LexerPositionStep::advanced_offset(LexerPositionStep::advanced_offset(LexerPositionStep::advanced_offset(position, source_length), source_length), source_length))
            return LexerPositionStep::advanced_offset(LexerPositionStep::advanced_offset(LexerPositionStep::advanced_offset(position, source_length), source_length), source_length)

        def column_after_three(column: int) -> int:
            ensure result == column + 3
            return column + 3
