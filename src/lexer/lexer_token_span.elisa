# Pure record construction makes the span-field preservation contract
# independently replayable from Token's mutable assembly and packed bitset.
extend Lexer:
    public:
        def token_span_fields(line: u32, column: u32, start: u32, length: u32, suffix_length: u16) -> TokenSpan:
            ensure result.line == line
            ensure result.column == column
            ensure result.start == start
            ensure result.length == length
            ensure result.suffix_length == suffix_length
            return TokenSpan{
                line: line,
                column: column,
                start: start,
                length: length,
                suffix_length: suffix_length
            }
