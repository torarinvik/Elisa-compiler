# The numeric lexer accepts only the suffixes listed by this closed grammar.
# Keeping the decision table in one production helper lets the scanner proof
# state the exact accepted language instead of duplicating it in a model.
module LexerTypeSuffix:
    public:
        @inline(always)
        def is_valid_type_suffix(suffix: sview) -> bool:
            ensure result == (
                suffix == "u" or suffix == "u8" or suffix == "u16" or suffix == "u32" or suffix == "u64" or suffix == "usize" or
                suffix == "i8" or suffix == "i16" or suffix == "i32" or suffix == "i64" or suffix == "isize" or
                suffix == "f32" or suffix == "f64"
            )
            return match suffix:
                "u" | "u8" | "u16" | "u32" | "u64" | "usize" | "i8" | "i16" | "i32" | "i64" | "isize" | "f32" | "f64": true
                _: false
