# Named UTF-8 byte classes, Unicode scalar bounds, and decode place values.
const UTF8_CONTINUATION_MIN: i64 = 0x80
const UTF8_CONTINUATION_MAX: i64 = 0xBF
const UTF8_TWO_BYTE_LEAD_MIN: i64 = 0xC2
const UTF8_TWO_BYTE_LEAD_MAX: i64 = 0xDF
const UTF8_TWO_BYTE_LATIN1_LEAD_MAX: i64 = 0xC3
const UTF8_TWO_BYTE_UNICODE2_LEAD_MIN: i64 = 0xC4
const UTF8_TWO_BYTE_ARABIC_DIGIT_LEAD_MIN: i64 = 0xD9
const UTF8_TWO_BYTE_LEAD_PAYLOAD_OFFSET: i64 = 0xC0
const UTF8_THREE_BYTE_LEAD_MIN: i64 = 0xE0
const UTF8_THREE_BYTE_LEAD_MAX: i64 = 0xEF
const UTF8_FOUR_BYTE_LEAD_MIN: i64 = 0xF0
const UTF8_FOUR_BYTE_LEAD_MAX: i64 = 0xF4
const UTF8_E0_SECOND_MIN: i64 = 0xA0
const UTF8_SURROGATE_LEAD: i64 = 0xED
const UTF8_ED_SECOND_MAX: i64 = 0x9F
const UTF8_FIRST_NON_SURROGATE_LEAD: i64 = 0xEE
const UTF8_F0_SECOND_MIN: i64 = 0x90
const UTF8_F4_SECOND_MAX: i64 = 0x8F
const UTF8_THREE_BYTE_SCALAR_MIN: i64 = 0x800
const UTF8_THREE_BYTE_SCALAR_MAX: i64 = 0xFFFF
const UTF8_TWO_BYTE_SCALAR_MIN: i64 = 0x80
const UTF8_TWO_BYTE_SCALAR_MAX: i64 = 0x7FF
const UNICODE_SURROGATE_MIN: i64 = 0xD800
const UNICODE_SURROGATE_MAX: i64 = 0xDFFF
const UTF8_FOUR_BYTE_SCALAR_MIN: i64 = 0x10000
const UNICODE_SCALAR_MAX: i64 = 0x10FFFF
const UTF8_TWO_BYTE_LEAD_PLACE_VALUE: i64 = 0x40
const UTF8_THREE_BYTE_LEAD_PLACE_VALUE: i64 = 0x1000
const UTF8_THREE_BYTE_SECOND_PLACE_VALUE: i64 = 0x40
const UTF8_FOUR_BYTE_LEAD_PLACE_VALUE: i64 = 0x40000
const UTF8_FOUR_BYTE_SECOND_PLACE_VALUE: i64 = 0x1000
