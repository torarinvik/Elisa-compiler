# Source positions are kept separate so their constructor contract can be
# checked without pulling unrelated token scanners into the proof unit.
extend Lexer:
    public:
        struct LexerPosition:
            line: mutable int
            column: mutable int
            offset: mutable usize

        def LexerPosition(line: int, column: int, offset: usize) -> LexerPosition:
            ensure result.line == line
            ensure result.column == column
            ensure result.offset == offset
            return LexerPosition{line: line, column: column, offset: offset}
