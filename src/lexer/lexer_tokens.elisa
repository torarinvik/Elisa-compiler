        def frontend_tokenize(filename: u8&, source: u8&) -> darray[Token]:
            can Memory.Allocate, Abort.Panic:
                return frontend_tokenize_with_len(filename, source, runtime_strlen(source))


        def frontend_tokenize_with_len(filename: u8&, source: u8&, source_len: usize) -> darray[Token]:
            can Memory.Allocate, Abort.Panic:
                lexer: mutable Lexer = Lexer(filename, source, source_len)
                tokens: mutable darray[Token] = []

                while true:
                    rebind token: Token, lexer = lexer.next_token()
                    tokens.push(token)
                    if token.kind == TokenKind.Eof:
                        return tokens

                return tokens


        # Tokenize a sub-span of `source` — the parser's f-string desugar uses this to
        # sub-lex an embedded `{EXPR}` with ABSOLUTE offsets (the Lexer starts at `start`
        # and sees `end` as EOF), so every produced token's views index the original
        # buffer and LSP positions stay valid.
        def frontend_tokenize_span(filename: u8&, source: u8&, start: usize, end: usize) -> darray[Token]:
            can Memory.Allocate, Abort.Panic:
                lexer: mutable Lexer = Lexer(filename, source, end)
                lexer.position <- start
                tokens: mutable darray[Token] = []
                while true:
                    rebind token: Token, lexer = lexer.next_token()
                    tokens.push(token)
                    if token.kind == TokenKind.Eof:
                        return tokens
                return tokens


        # Tokenize purely to harvest the comment spans (Comment-kind tokens that
        # the normal stream drops). For tooling — the LSP semantic-token pass —
        # not the parser.
        def frontend_tokenize_comments_with_len(filename: u8&, source: u8&, source_len: usize) -> darray[Token]:
            can Memory.Allocate, Abort.Panic:
                lexer: mutable Lexer = Lexer(filename, source, source_len)

                while true:
                    rebind token: Token, lexer = lexer.next_token()
                    if token.kind == TokenKind.Eof:
                        # Copy out of the lexer's struct field into a standalone
                        # owned darray: returning the field directly dangles once
                        # the local lexer's region is torn down.
                        result: mutable darray[Token] = []
                        result.extend(lexer.comments)
                        return result

                return []
