        def Lexer(filename: u8&, source: u8&, source_len: usize) -> Lexer:
            return Lexer{
                filename: filename,
                source: source,
                source_len: source_len,
                position: 0,
                line: 1,
                column: 1,
                indentation_stack: [],
                pending_tokens: [],
                comments: [],
                pending_start: 0,
                at_line_start: true,
                group_depth: 0,
                pending_grouped_block: false,
                grouped_block_contexts: []
