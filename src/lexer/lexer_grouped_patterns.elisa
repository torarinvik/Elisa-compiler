extend Lexer:
    private:
        def current_line_indent(lexer: Lexer&) -> usize:
            start: mutable usize = lexer.position
            while start > 0 and char_at(lexer.source, lexer.source_length, start - 1) != '\n' |start, lexer|:
                start <- start - 1
            indent: mutable usize = 0
            while start < lexer.source_length |start, indent, lexer|:
                character: char = char_at(lexer.source, lexer.source_length, start)
                if character == ' ':
                    indent <- indent + 1
                elif character == '\t':
                    indent <- indent + 4
                else:
                    break
                start <- start + 1
            return indent

        def pattern_scrutinee_follows(lexer: Lexer&) -> bool:
            probe: mutable Lexer = lexer[0]
            while probe.position < probe.source_length |probe|:
                character: char = probe.current_char()
                if character == ' ' or character == '\t' or character == '\r' or character == '\n':
                    probe.position <- probe.position + 1
                elif character == '#':
                    while probe.position < probe.source_length and probe.current_char() != '\n' |probe|:
                        probe.position <- probe.position + 1
                else:
                    break
            return false if probe.position >= probe.source_length
            character: char = probe.current_char()
            return true if character == '-' or character == '\'' or character == '"' or character.is_digit() or (character == '.' and probe.peek(1).is_digit())
            return false if not character.is_identifier_start() and not probe.starts_unicode_identifier()
            start: usize = probe.position
            while probe.position < probe.source_length |probe|:
                if probe.current_char().is_identifier_char():
                    probe.position <- probe.position + 1
                else:
                    width: u8 = probe.unicode_identifier_char_width()
                    break if width == 0
                    probe.position <- probe.position + width.usize()
            text: sview = source_view_or_empty(probe.source, probe.source_length, start, probe.position)
            kind: TokenKind = frontend_lookup_keyword(text)
            return kind == TokenKind.Ident or kind == TokenKind.True or kind == TokenKind.False

        def trim_pending_pattern_headers(lexer: lmut Lexer):
            while lexer.pending_pattern_blocks.count > 0 |lexer|:
                break if lexer.pending_pattern_blocks[lexer.pending_pattern_blocks.count - 1].group_depth <= lexer.group_depth
                lexer.pending_pattern_blocks <- lexer.pending_pattern_blocks.truncate(lexer.pending_pattern_blocks.count - 1)

        def take_pattern_header(lexer: lmut Lexer) -> bool:
            return false if lexer.pending_pattern_blocks.count == 0
            header: GroupedPatternHeader = lexer.pending_pattern_blocks[lexer.pending_pattern_blocks.count - 1]
            return false if header.group_depth != lexer.group_depth
            lexer.pending_pattern_blocks <- lexer.pending_pattern_blocks.truncate(lexer.pending_pattern_blocks.count - 1)
            index: mutable usize = header.head_start
            while index + 1 < lexer.position |index, lexer|:
                character: char = char_at(lexer.source, lexer.source_length, index)
                return true if character != ' ' and character != '\t' and character != '\r' and character != '\n'
                index <- index + 1
            return false
