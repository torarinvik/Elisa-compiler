extend Lexer:
    private:
        @inline(always)
        def is_digit(character: char) -> bool:
            return character in '0'..'9'

        @inline(always)
        def is_hex_digit(character: char) -> bool:
            return character.is_digit() or character in 'a'..'f' or character in 'A'..'F'

        @inline(always)
        def has_float_suffix_at(lexer: Lexer&, offset: usize) -> bool:
            if lexer.peek(offset) != 'f':
                return false
            elif lexer.peek(offset + 1) == '3':
                return lexer.peek(offset + 2) == '2' and not lexer.peek(offset + 3).is_identifier_char()
            else:
                return lexer.peek(offset + 1) == '6' and lexer.peek(offset + 2) == '4' and not lexer.peek(offset + 3).is_identifier_char()

        @inline(always)
        def should_read_float_fraction(lexer: Lexer&) -> bool:
            if lexer.current_char() != '.' or lexer.peek(1) == '.':
                return false
            else:
                next_char: char = lexer.peek(1)
                if next_char.is_digit() or next_char == NULL_CHAR:
                    return true
                elif next_char in {'e', 'E'}:
                    offset: mutable usize = 2
                    if lexer.peek(offset) in {'+', '-'}:
                        offset <- offset + 1
                    return lexer.peek(offset).is_digit()
                elif lexer.has_float_suffix_at(1):
                    return true
                else:
                    return not next_char.is_identifier_char()

        # Digit runs never contain '\n', so bump position/column directly and skip
        # advance_char's newline branch + current-char re-read (see read_identifier).
        @inline(always)
        def scan_decimal_digits(lexer: lmut Lexer):
            while not lexer.is_end_of_source() and lexer.current_char().is_digit() |lexer|:
                lexer.position <- lexer.position + 1
                lexer.column <- lexer.column + 1


        @inline(always)
        def scan_hex_digits(lexer: lmut Lexer):
            while not lexer.is_end_of_source() and lexer.current_char().is_hex_digit() |lexer|:
                lexer.position <- lexer.position + 1
                lexer.column <- lexer.column + 1


        def read_number(lexer: lmut Lexer) -> Token:
            position: LexerPosition = lexer.cursor_position()
            start: usize = lexer.position

            if lexer.current_char() == '0' and lexer.peek(1) in {'x', 'X'}:
                lexer <- lexer.advance_char()
                lexer <- lexer.advance_char()
                lexer <- lexer.scan_hex_digits()
                text_end: usize = lexer.position
                rebind suffix: sview?, lexer = lexer.read_type_suffix()
                return Token(TokenKind.HexLit, position, start, text_end, lexer.position)

            lexer <- lexer.scan_decimal_digits()

            is_float: mutable bool = false
            if lexer.should_read_float_fraction():
                is_float <- true
                lexer <- lexer.advance_char()
                lexer <- lexer.scan_decimal_digits()

            if not lexer.is_end_of_source() and lexer.current_char() in {'e', 'E'}:
                exponent_next_char: char = lexer.peek(1)
                exponent_valid: bool = lexer.peek(2).is_digit() if exponent_next_char in {'+', '-'} else exponent_next_char.is_digit()
                if exponent_valid:
                    is_float <- true
                    lexer <- lexer.advance_char()
                    if not lexer.is_end_of_source() and lexer.current_char() in {'+', '-'}:
                        lexer <- lexer.advance_char()
                    lexer <- lexer.scan_decimal_digits()

            text_end: usize = lexer.position
            rebind suffix: sview?, lexer = lexer.read_type_suffix()
            if is_float:
                return Token(TokenKind.FloatLit, position, start, text_end, lexer.position)
            if suffix is text:
                if text == "f32" or text == "f64":
                    return Token(TokenKind.FloatLit, position, start, text_end, lexer.position)
            return Token(TokenKind.IntLit, position, start, text_end, lexer.position)
