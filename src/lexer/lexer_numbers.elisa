extend Lexer:
    private:
        # The number scanner's character classes — a TOTAL partition of char, so the
        # `machine` below dispatches on classes instead of re-testing raw chars
        # (classified dispatch, docs/125 §9). `ExpMark` ('e'/'E') is split out of the
        # hex-letter class so Whole/Fraction can see an exponent lead while Hex
        # consumes it as a plain hex digit (Digit | ExpMark | HexAlpha == hex digit).
        const enum NumberClass of u8:
            Digit        # '0'..'9'
            ExpMark      # 'e' | 'E' (also a hex digit)
            HexAlpha     # 'a'..'d', 'f', 'A'..'D', 'F' (hex letters minus e/E)
            Dot          # '.'
            Sign         # '+' | '-'
            Other

        @inline(always)
        def classify_number_char(c: char) -> NumberClass:
            return when c:
                '0'..='9' -> NumberClass.Digit
                'e' | 'E' -> NumberClass.ExpMark
                'a'..='d' | 'f' | 'A'..='D' | 'F' -> NumberClass.HexAlpha
                '.' -> NumberClass.Dot
                '+' | '-' -> NumberClass.Sign
                _ -> NumberClass.Other

        @inline(always)
        def is_digit(character: char) -> bool:
            return character in '0'..'9'

        @inline(always)
        def is_hex_digit(character: char) -> bool:
            return character.is_digit() or character in 'a'..'f' or character in 'A'..'F'

        @inline(always)
        def has_float_suffix_at(lexer: Lexer&, offset: usize) -> bool:
            a: char = lexer.peek(offset)
            b: char = lexer.peek(offset + 1)
            c: char = lexer.peek(offset + 2)
            d: char = lexer.peek(offset + 3)
            # `f32` / `f64` and nothing else. Written as the two-column table it is — the pair
            # of postfix guards this replaced was here only because the stage1 backend had no
            # lowering for `when a, b:` (fixed 2026-08-06).
            return when a, b:
                'f', '3' -> c == '2' and not d.is_identifier_char()
                'f', '6' -> c == '4' and not d.is_identifier_char()
                _, _ -> false

        def should_read_float_fraction(lexer: Lexer&) -> bool:
            # Not a `.` fraction: a non-dot, or the `..` range operator.
            false return if lexer.current_char() != '.' or lexer.peek(1) == '.'
            # A `.` opens a fraction when the char after it is a digit, end-of-input, a
            # valid `.e±digits` exponent, a float suffix (`.f32`), or any non-identifier
            # char (so `1.foo` stays `1` `.` `foo`, not a fraction).
            next_char: char = lexer.peek(1)
            true return if next_char.is_digit()
            true return if next_char == NULL_CHAR
            if next_char == 'e' or next_char == 'E':
                exp_sign_or_digit: char = lexer.peek(2)
                lexer.peek(3).is_digit() return if exp_sign_or_digit == '+' or exp_sign_or_digit == '-'
                return exp_sign_or_digit.is_digit()
            true return if lexer.has_float_suffix_at(1)
            return not next_char.is_identifier_char()

        # A valid exponent tail follows the current 'e'/'E': `e5`, `e+5`, `e-5` — but
        # not `e` alone or `e+x` (those leave the 'e' to the identifier lexer).
        @inline(always)
        def exponent_follows(lexer: Lexer&) -> bool:
            exponent_next_char: char = lexer.peek(1)
            lexer.peek(2).is_digit() return if exponent_next_char == '+' or exponent_next_char == '-'
            return exponent_next_char.is_digit()

        # Number phases as a flat state machine (docs/125 §9). Payload machines still
        # decline under stage1 meta-compile, so the same transitions are a while+if
        # ladder over a mode tag (u8), with kind carried as a sibling local.
        def read_number(lexer: lmut Lexer) -> Token:
            position: LexerPosition = lexer.cursor_position()
            start: usize = lexer.position

            # Modes: 0 Lead, 1 Whole, 2 Hex, 3 Fraction, 4 ExpLead, 5 ExpDigits, 6 Done
            mode: mutable u8 = 0
            kind: mutable TokenKind = TokenKind.IntLit
            while mode != 6 and not lexer.is_end_of_source() |lexer, mode, kind|:
                class: NumberClass = classify_number_char(lexer.current_char())
                if mode == 0:
                    # Lead: '0x'/'0X' forks to Hex; anything else reclassifies as Whole.
                    if class == NumberClass.Digit and lexer.current_char() == '0' and (lexer.peek(1) == 'x' or lexer.peek(1) == 'X'):
                        lexer <- lexer.advance_char()
                        lexer <- lexer.advance_char()
                        kind <- TokenKind.HexLit
                        mode <- 2
                    else:
                        mode <- 1
                elif mode == 2:
                    # Hex: consume hex digits (Digit | ExpMark | HexAlpha); else done.
                    if class == NumberClass.Digit or class == NumberClass.ExpMark or class == NumberClass.HexAlpha:
                        lexer.position <- lexer.position + 1
                        lexer.column <- lexer.column + 1
                    else:
                        mode <- 6
                elif mode == 1:
                    # Whole decimal.
                    if class == NumberClass.Digit:
                        lexer.position <- lexer.position + 1
                        lexer.column <- lexer.column + 1
                    elif class == NumberClass.Dot and lexer.should_read_float_fraction():
                        lexer <- lexer.advance_char()
                        kind <- TokenKind.FloatLit
                        mode <- 3
                    elif class == NumberClass.ExpMark and lexer.exponent_follows():
                        lexer <- lexer.advance_char()
                        kind <- TokenKind.FloatLit
                        mode <- 4
                    else:
                        mode <- 6
                elif mode == 3:
                    # Fraction digits, optional exponent.
                    if class == NumberClass.Digit:
                        lexer.position <- lexer.position + 1
                        lexer.column <- lexer.column + 1
                    elif class == NumberClass.ExpMark and lexer.exponent_follows():
                        lexer <- lexer.advance_char()
                        mode <- 4
                    else:
                        mode <- 6
                elif mode == 4:
                    # ExpLead: optional sign, then digits.
                    if class == NumberClass.Sign:
                        lexer <- lexer.advance_char()
                        mode <- 5
                    elif class == NumberClass.Digit:
                        lexer.position <- lexer.position + 1
                        lexer.column <- lexer.column + 1
                        mode <- 5
                    else:
                        mode <- 6
                elif mode == 5:
                    if class == NumberClass.Digit:
                        lexer.position <- lexer.position + 1
                        lexer.column <- lexer.column + 1
                    else:
                        mode <- 6
                else:
                    mode <- 6

            text_end: usize = lexer.position
            rebind suffix: sview?, lexer = lexer.read_type_suffix()
            if suffix is suffix_text:
                lexer.position <- text_end + suffix_text.len.usize()
                lexer.column <- lexer.column + suffix_text.len
            final_kind: TokenKind = kind if kind == TokenKind.HexLit else TokenKind.FloatLit if kind == TokenKind.FloatLit or suffix_names_float(suffix) else TokenKind.IntLit
            return Token(final_kind, position, start, text_end, lexer.position)


        # Whether a type suffix spells a float type.
        @inline(always)
        def suffix_names_float(suffix: sview?) -> bool:
            if suffix is text:
                return text == "f32" or text == "f64"
            return false
