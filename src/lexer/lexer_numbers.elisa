extend Lexer:
    private:
        @inline(always)
        def is_digit(character: char) -> bool:
            return character in '0'..'9'

        @inline(always)
        def is_hex_digit(character: char) -> bool:
            return character.is_digit() or character in 'a'..'f' or character in 'A'..'F'

        @inline(always)
        def has_float_suffix_at(lexer: Lexer&, offset: usize) -> bool:
            return when lexer.peek(offset), lexer.peek(offset + 1):
                'f', '3' -> lexer.peek(offset + 2) == '2' and not lexer.peek(offset + 3).is_identifier_char()
                'f', '6' -> lexer.peek(offset + 2) == '4' and not lexer.peek(offset + 3).is_identifier_char()
                _, _ -> false

        @inline(always)
        def should_read_float_fraction(lexer: Lexer&) -> bool:
            # Not a `.` fraction: a non-dot, or the `..` range operator.
            false return if lexer.current_char() != '.' or lexer.peek(1) == '.'
            # A `.` opens a fraction when the char after it is a digit, end-of-input, a
            # valid `.e±digits` exponent, a float suffix (`.f32`), or any non-identifier
            # char (so `1.foo` stays `1` `.` `foo`, not a fraction). A pure decision, so
            # it reads as one boolean value rather than a branch ladder (docs/125 §6b).
            next_char: char = lexer.peek(1)
            return (next_char.is_digit()
                or next_char == NULL_CHAR
                or (next_char in {'e', 'E'} and (lexer.peek(3).is_digit() if lexer.peek(2) in {'+', '-'} else lexer.peek(2).is_digit()))
                or lexer.has_float_suffix_at(1)
                or not next_char.is_identifier_char())

        # Digit runs never contain '\n', so bump position/column directly and skip
        # advance_char's newline branch + current-char re-read (see read_identifier).
        @inline(always)
        def scan_decimal_digits(lexer: lmut Lexer):
            while not lexer.is_end_of_source() and lexer.current_char().is_digit() |lexer|:
                lexer.position <- lexer.position + 1
                lexer.column <- lexer.column + 1


        @inline(always)
        def scan_hex_digits(lexer: lmut Lexer):
            while not lexer.is_end_of_source() and lexer.current_char().is_hex_digit() |lexer|:
                lexer.position <- lexer.position + 1
                lexer.column <- lexer.column + 1


        def read_number(lexer: lmut Lexer) -> Token:
            position: LexerPosition = lexer.cursor_position()
            start: usize = lexer.position

            # Hex `0x…` is a distinct radix lead, not a phase of the decimal scan: it
            # returns its own HexLit. A radix fork whose taken branch consumes and returns
            # can't fold into a value/guard (the `lmut` scan must thread by reassignment,
            # so it needs its own block), and `machine over` matches literal delimiters,
            # not the digit CLASSES a number is built from — so this genuine two-way lead
            # is stated as such (docs/125 §6b `can ComplexFlow:`), mirroring next_token.
            can ComplexFlow:
                if lexer.current_char() == '0' and lexer.peek(1) in {'x', 'X'}:
                    lexer <- lexer.advance_char()
                    lexer <- lexer.advance_char()
                    lexer <- lexer.scan_hex_digits()
                    text_end: usize = lexer.position
                    rebind suffix: sview?, lexer = lexer.read_type_suffix()
                    return Token(TokenKind.HexLit, position, start, text_end, lexer.position)

            lexer <- lexer.scan_decimal_digits()

            # Floatness is not a mutable flag: each phase reports whether it consumed
            # anything, and the literal's kind is a value computed once at the end
            # (docs/125: state as a produced value, not a branch-mutated variable).
            rebind has_fraction: bool, lexer = lexer.scan_float_fraction()
            rebind has_exponent: bool, lexer = lexer.scan_float_exponent()

            text_end: usize = lexer.position
            rebind suffix: sview?, lexer = lexer.read_type_suffix()
            is_float: bool = has_fraction or has_exponent or suffix_names_float(suffix)
            kind: TokenKind = TokenKind.FloatLit if is_float else TokenKind.IntLit
            return Token(kind, position, start, text_end, lexer.position)


        # Consume a `.digits` fraction if one begins here; report whether it did.
        def scan_float_fraction(lexer: lmut Lexer) -> bool:
            false return if not lexer.should_read_float_fraction()
            lexer <- lexer.advance_char()
            lexer <- lexer.scan_decimal_digits()
            return true


        # Consume an `e[+-]digits` exponent if a valid one begins here; report whether it did.
        def scan_float_exponent(lexer: lmut Lexer) -> bool:
            false return if lexer.is_end_of_source() or not (lexer.current_char() in {'e', 'E'})
            exponent_next_char: char = lexer.peek(1)
            exponent_valid: bool = lexer.peek(2).is_digit() if exponent_next_char in {'+', '-'} else exponent_next_char.is_digit()
            false return if not exponent_valid
            lexer <- lexer.advance_char()
            lexer <- lexer.advance_char() if not lexer.is_end_of_source() and lexer.current_char() in {'+', '-'}
            lexer <- lexer.scan_decimal_digits()
            return true


        # Whether a type suffix spells a float type.
        @inline(always)
        def suffix_names_float(suffix: sview?) -> bool:
            if suffix is text:
                return text == "f32" or text == "f64"
            return false
