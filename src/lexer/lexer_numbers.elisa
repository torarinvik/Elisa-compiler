extend Lexer:
    private:
        # The number scanner's character classes — a TOTAL partition of char, so the
        # `machine` below dispatches on classes instead of re-testing raw chars
        # (classified dispatch, docs/125 §9). `ExpMark` ('e'/'E') is split out of the
        # hex-letter class so Whole/Fraction can see an exponent lead while Hex
        # consumes it as a plain hex digit (Digit | ExpMark | HexAlpha == hex digit).
        const enum NumberClass of u8:
            Digit        # '0'..'9'
            ExpMark      # 'e' | 'E' (also a hex digit)
            HexAlpha     # 'a'..'d', 'f', 'A'..'D', 'F' (hex letters minus e/E)
            Dot          # '.'
            Sign         # '+' | '-'
            Other

        @inline(always)
        def classify_number_char(c: char) -> NumberClass:
            return when c:
                '0'..='9' -> NumberClass.Digit
                'e' | 'E' -> NumberClass.ExpMark
                'a'..='d' | 'f' | 'A'..='D' | 'F' -> NumberClass.HexAlpha
                '.' -> NumberClass.Dot
                '+' | '-' -> NumberClass.Sign
                _ -> NumberClass.Other

        @inline(always)
        def is_digit(character: char) -> bool:
            return character in '0'..'9'

        @inline(always)
        def is_hex_digit(character: char) -> bool:
            return character.is_digit() or character in 'a'..'f' or character in 'A'..'F'

        @inline(always)
        def has_float_suffix_at(lexer: Lexer&, offset: usize) -> bool:
            return when lexer.peek(offset), lexer.peek(offset + 1):
                'f', '3' -> lexer.peek(offset + 2) == '2' and not lexer.peek(offset + 3).is_identifier_char()
                'f', '6' -> lexer.peek(offset + 2) == '4' and not lexer.peek(offset + 3).is_identifier_char()
                _, _ -> false

        def should_read_float_fraction(lexer: Lexer&) -> bool:
            # Not a `.` fraction: a non-dot, or the `..` range operator.
            false return if lexer.current_char() != '.' or lexer.peek(1) == '.'
            # A `.` opens a fraction when the char after it is a digit, end-of-input, a
            # valid `.e±digits` exponent, a float suffix (`.f32`), or any non-identifier
            # char (so `1.foo` stays `1` `.` `foo`, not a fraction). A pure decision, so
            # it reads as one boolean value rather than a branch ladder (docs/125 §6b).
            next_char: char = lexer.peek(1)
            return (next_char.is_digit()
                or next_char == NULL_CHAR
                or (next_char in {'e', 'E'} and (lexer.peek(3).is_digit() if lexer.peek(2) in {'+', '-'} else lexer.peek(2).is_digit()))
                or lexer.has_float_suffix_at(1)
                or not next_char.is_identifier_char())

        # A valid exponent tail follows the current 'e'/'E': `e5`, `e+5`, `e-5` — but
        # not `e` alone or `e+x` (those leave the 'e' to the identifier lexer).
        @inline(always)
        def exponent_follows(lexer: Lexer&) -> bool:
            exponent_next_char: char = lexer.peek(1)
            return lexer.peek(2).is_digit() if exponent_next_char in {'+', '-'} else exponent_next_char.is_digit()

        # One classified machine (docs/125 §9): the literal's phases are STATES, its
        # transitions fire on character CLASSES, and lookahead decisions live in
        # guards. The token kind rides the states as payload — `Fraction`/`ExpLead`
        # can only be entered carrying FloatLit, `Hex` only HexLit — and EOF falls
        # out of the machine with that payload intact. Digit-run arms bump
        # position/column directly (runs never contain '\n', see read_identifier);
        # single structural chars advance through advance_char.
        def read_number(lexer: lmut Lexer) -> Token:
            position: LexerPosition = lexer.cursor_position()
            start: usize = lexer.position

            kind: TokenKind =
                machine over classify_number_char(lexer.current_char()) while not lexer.is_end_of_source() -> kind:
                    # Hot states first: state-decl order shapes the lowered dispatch
                    # ladder, and digit runs spend their lives in Whole/Hex.
                    state Whole(kind: TokenKind)
                    state Hex(kind: TokenKind)
                    state Fraction(kind: TokenKind)
                    state ExpDigits(kind: TokenKind)
                    state ExpLead(kind: TokenKind)
                    state Lead(kind: TokenKind)

                    start Lead(TokenKind.IntLit)

                    # The radix fork: a '0x'/'0X' lead selects the hex automaton.
                    Lead(kind), NumberClass.Digit if lexer.current_char() == '0' and lexer.peek(1) in {'x', 'X'}:
                        lexer <- lexer.advance_char()
                        lexer <- lexer.advance_char()
                        -> Hex(TokenKind.HexLit)
                    Lead(kind), NumberClass.Digit | NumberClass.ExpMark | NumberClass.HexAlpha | NumberClass.Dot | NumberClass.Sign | NumberClass.Other:
                        -> Whole(kind)          # same char, reclassified as a decimal lead (Digit here = a non-0x lead)

                    Hex(kind), NumberClass.Digit | NumberClass.ExpMark | NumberClass.HexAlpha:
                        lexer.position <- lexer.position + 1
                        lexer.column <- lexer.column + 1
                        -> Hex(kind)
                    Hex(kind), NumberClass.Dot | NumberClass.Sign | NumberClass.Other:
                        break

                    Whole(kind), NumberClass.Digit:
                        lexer.position <- lexer.position + 1
                        lexer.column <- lexer.column + 1
                        -> Whole(kind)
                    Whole(kind), NumberClass.Dot if lexer.should_read_float_fraction():
                        lexer <- lexer.advance_char()
                        -> Fraction(TokenKind.FloatLit)
                    Whole(kind), NumberClass.ExpMark if lexer.exponent_follows():
                        lexer <- lexer.advance_char()
                        -> ExpLead(TokenKind.FloatLit)
                    Whole(kind), NumberClass.Dot | NumberClass.ExpMark | NumberClass.HexAlpha | NumberClass.Sign | NumberClass.Other:
                        break                   # Dot/ExpMark reach here only when their guards above failed

                    Fraction(kind), NumberClass.Digit:
                        lexer.position <- lexer.position + 1
                        lexer.column <- lexer.column + 1
                        -> Fraction(kind)
                    Fraction(kind), NumberClass.ExpMark if lexer.exponent_follows():
                        lexer <- lexer.advance_char()
                        -> ExpLead(kind)
                    Fraction(kind), NumberClass.ExpMark | NumberClass.HexAlpha | NumberClass.Dot | NumberClass.Sign | NumberClass.Other:
                        break                   # ExpMark reaches here only when its guard above failed

                    ExpLead(kind), NumberClass.Sign:
                        lexer <- lexer.advance_char()
                        -> ExpDigits(kind)
                    ExpLead(kind), NumberClass.Digit:
                        lexer.position <- lexer.position + 1
                        lexer.column <- lexer.column + 1
                        -> ExpDigits(kind)
                    ExpLead(kind), NumberClass.ExpMark | NumberClass.HexAlpha | NumberClass.Dot | NumberClass.Other:
                        break               # a non-sign, non-digit after 'e' ends the number

                    ExpDigits(kind), NumberClass.Digit:
                        lexer.position <- lexer.position + 1
                        lexer.column <- lexer.column + 1
                        -> ExpDigits(kind)
                    ExpDigits(kind), NumberClass.ExpMark | NumberClass.HexAlpha | NumberClass.Dot | NumberClass.Sign | NumberClass.Other:
                        break

            text_end: usize = lexer.position
            rebind suffix: sview?, lexer = lexer.read_type_suffix()
            final_kind: TokenKind = kind if kind == TokenKind.HexLit else TokenKind.FloatLit if kind == TokenKind.FloatLit or suffix_names_float(suffix) else TokenKind.IntLit
            return Token(final_kind, position, start, text_end, lexer.position)


        # Whether a type suffix spells a float type.
        @inline(always)
        def suffix_names_float(suffix: sview?) -> bool:
            if suffix is text:
                return text == "f32" or text == "f64"
            return false
