extend Lexer:
    private:
        # The number scanner's character classes — a TOTAL partition of char, so the
        # `machine` below dispatches on classes instead of re-testing raw chars
        # (classified dispatch, docs/125 §9). Exponent markers are split into valid/other
        # forms so Whole/Fraction can see a valid exponent lead while Hex consumes either
        # spelling as a plain hex digit.
        const enum NumberClass of u8:
            Digit        # '0'..'9'
            ExpMarkValid # 'e' | 'E' followed by a valid exponent
            ExpMarkOther # 'e' | 'E' without a valid exponent (still a hex digit)
            HexAlpha     # 'a'..'d', 'f', 'A'..'D', 'F' (hex letters minus e/E)
            FractionDot  # '.' that opens a decimal fraction
            OtherDot     # '.' that is not a decimal fraction
            Sign         # '+' | '-'
            HexPrefix    # the leading '0' in a 0x/0X literal
            Other

        @inline(always)
        def classify_number_char(c: char) -> NumberClass:
            return when c:
                '0'..='9' -> NumberClass.Digit
                'e' | 'E' -> NumberClass.ExpMarkOther
                'a'..='d' | 'f' | 'A'..='D' | 'F' -> NumberClass.HexAlpha
                '.' -> NumberClass.OtherDot
                '+' | '-' -> NumberClass.Sign
                _ -> NumberClass.Other

        # Classify the current cursor for the number state machine. The lookahead-sensitive
        # classes keep the machine arms straight-line: no nested `if` is needed to decide
        # whether a leading zero opens hex, a dot opens a fraction, or `e` starts an exponent.
        @inline(always)
        def classify_number_input(lexer: Lexer&) -> NumberClass:
            c: char = lexer.current_char()
            state CheckHex
            state CheckFraction
            state CheckExponent
            state HexPrefix
            state FractionDot
            state ValidExponent
            state Plain
            return start CheckHex:
                CheckHex:
                    -> HexPrefix if c == '0' and (lexer.peek(1) == 'x' or lexer.peek(1) == 'X')
                    -> CheckFraction
                CheckFraction:
                    -> FractionDot if c == '.' and lexer.should_read_float_fraction()
                    -> CheckExponent
                CheckExponent:
                    -> ValidExponent if (c == 'e' or c == 'E') and lexer.exponent_follows()
                    -> Plain
                HexPrefix:
                    => NumberClass.HexPrefix
                FractionDot:
                    => NumberClass.FractionDot
                ValidExponent:
                    => NumberClass.ExpMarkValid
                Plain:
                    => classify_number_char(c)

        @inline(always)
        def is_digit(character: char) -> bool:
            return character in '0'..'9'

        @inline(always)
        def is_hex_digit(character: char) -> bool:
            return character.is_digit() or character in 'a'..'f' or character in 'A'..'F'

        @inline(always)
        def has_float_suffix_at(lexer: Lexer&, offset: usize) -> bool:
            a: char = lexer.peek(offset)
            b: char = lexer.peek(offset + 1)
            c: char = lexer.peek(offset + 2)
            d: char = lexer.peek(offset + 3)
            # `f32` / `f64` and nothing else. Written as the two-column table it is — the pair
            # of postfix guards this replaced was here only because the stage1 backend had no
            # lowering for `when a, b:` (fixed 2026-08-06).
            return when a, b:
                'f', '3' -> c == '2' and not d.is_identifier_char()
                'f', '6' -> c == '4' and not d.is_identifier_char()
                _, _ -> false

        def should_read_float_fraction(lexer: Lexer&) -> bool:
            # Not a `.` fraction: a non-dot, or the `..` range operator.
            state CheckDot
            state CheckNext
            state CheckExponent
            state CheckSuffix
            state Answer(value: bool)
            # A `.` opens a fraction when the char after it is a digit, end-of-input, a
            # valid `.e±digits` exponent, a float suffix (`.f32`), or any non-identifier
            # char (so `1.foo` stays `1` `.` `foo`, not a fraction).
            next_char: char = lexer.peek(1)
            return start CheckDot:
                CheckDot:
                    -> Answer(false) if lexer.current_char() != '.' or lexer.peek(1) == '.'
                    -> CheckNext
                CheckNext:
                    -> Answer(true) if next_char.is_digit() or next_char == NULL_CHAR
                    -> CheckExponent if next_char == 'e' or next_char == 'E'
                    -> CheckSuffix
                CheckExponent:
                    exp_sign_or_digit: char = lexer.peek(2)
                    -> Answer(lexer.peek(3).is_digit()) if exp_sign_or_digit == '+' or exp_sign_or_digit == '-'
                    -> Answer(exp_sign_or_digit.is_digit())
                CheckSuffix:
                    -> Answer(true) if lexer.has_float_suffix_at(1)
                    -> Answer(not next_char.is_identifier_char())
                Answer(value):
                    => value

        # A valid exponent tail follows the current 'e'/'E': `e5`, `e+5`, `e-5` — but
        # not `e` alone or `e+x` (those leave the 'e' to the identifier lexer).
        @inline(always)
        def exponent_follows(lexer: Lexer&) -> bool:
            exponent_next_char: char = lexer.peek(1)
            return when exponent_next_char:
                '+' | '-' -> lexer.peek(2).is_digit()
                _ -> exponent_next_char.is_digit()

        # Number phases as a state machine (docs/125 §9). The machine owns all cursor and
        # classification transitions; the eventual token kind is scratch state on the driven
        # lexer because `machine over` is a statement form.
        def read_number(lexer: lmut Lexer) -> Token:
            position: LexerPosition = lexer.cursor_position()
            start: usize = lexer.position

            # Lexing a number is a finite state machine. The input class is recomputed once
            # per iteration and each arm performs at most one cursor transition, making the
            # accepted spellings and termination state explicit.
            lexer.number_kind <- TokenKind.IntLit
            machine over lexer.classify_number_input() while not lexer.is_end_of_source():
                state Lead
                state Whole
                state Hex
                state Fraction
                state ExpLead
                state ExpDigits
                state Done
                start Lead

                Lead, NumberClass.HexPrefix:
                    lexer <- lexer.advance_char()
                    lexer <- lexer.advance_char()
                    lexer.number_kind <- TokenKind.HexLit
                    -> Hex
                Lead, NumberClass.Digit | NumberClass.ExpMarkValid | NumberClass.ExpMarkOther | NumberClass.HexAlpha | NumberClass.FractionDot | NumberClass.OtherDot | NumberClass.Sign | NumberClass.Other:
                    -> Whole

                # HexPrefix still represents the current character `0`; only Lead may
                # consume the following `x` as part of a prefix. In every later state it
                # must behave like an ordinary digit (`10x`, `0x0x1`).
                Whole, NumberClass.Digit | NumberClass.HexPrefix:
                    lexer <- lexer.advance_char()
                    -> Whole
                Whole, NumberClass.FractionDot:
                    lexer <- lexer.advance_char()
                    lexer.number_kind <- TokenKind.FloatLit
                    -> Fraction
                Whole, NumberClass.ExpMarkValid:
                    lexer <- lexer.advance_char()
                    lexer.number_kind <- TokenKind.FloatLit
                    -> ExpLead
                Whole, NumberClass.ExpMarkOther | NumberClass.HexAlpha | NumberClass.OtherDot | NumberClass.Sign | NumberClass.Other:
                    -> Done

                Hex, NumberClass.Digit | NumberClass.ExpMarkValid | NumberClass.ExpMarkOther | NumberClass.HexAlpha | NumberClass.HexPrefix:
                    lexer <- lexer.advance_char()
                    -> Hex
                Hex, NumberClass.FractionDot | NumberClass.OtherDot | NumberClass.Sign | NumberClass.Other:
                    -> Done

                Fraction, NumberClass.Digit | NumberClass.HexPrefix:
                    lexer <- lexer.advance_char()
                    -> Fraction
                Fraction, NumberClass.ExpMarkValid:
                    lexer <- lexer.advance_char()
                    -> ExpLead
                Fraction, NumberClass.ExpMarkOther | NumberClass.HexAlpha | NumberClass.FractionDot | NumberClass.OtherDot | NumberClass.Sign | NumberClass.Other:
                    -> Done

                ExpLead, NumberClass.Sign:
                    lexer <- lexer.advance_char()
                    -> ExpDigits
                ExpLead, NumberClass.Digit | NumberClass.HexPrefix:
                    lexer <- lexer.advance_char()
                    -> ExpDigits
                ExpLead, NumberClass.ExpMarkValid | NumberClass.ExpMarkOther | NumberClass.HexAlpha | NumberClass.FractionDot | NumberClass.OtherDot | NumberClass.Other:
                    -> Done

                ExpDigits, NumberClass.Digit | NumberClass.HexPrefix:
                    lexer <- lexer.advance_char()
                    -> ExpDigits
                ExpDigits, NumberClass.ExpMarkValid | NumberClass.ExpMarkOther | NumberClass.HexAlpha | NumberClass.FractionDot | NumberClass.OtherDot | NumberClass.Sign | NumberClass.Other:
                    -> Done

                Done, NumberClass.Digit | NumberClass.ExpMarkValid | NumberClass.ExpMarkOther | NumberClass.HexAlpha | NumberClass.FractionDot | NumberClass.OtherDot | NumberClass.Sign | NumberClass.HexPrefix | NumberClass.Other:
                    break

            text_end: usize = lexer.position
            rebind suffix: sview?, lexer = lexer.read_type_suffix()
            match suffix:
                suffix_text:
                    lexer.position <- text_end + suffix_text.len.usize()
                    lexer.column <- lexer.column + suffix_text.len
                _:
                    pass
            result_kind: TokenKind = TokenKind.HexLit if lexer.number_kind == TokenKind.HexLit else TokenKind.FloatLit if lexer.number_kind == TokenKind.FloatLit or suffix_names_float(suffix) else TokenKind.IntLit
            return Token(result_kind, position, start, text_end, lexer.position)


        # Whether a type suffix spells a float type.
        @inline(always)
        def suffix_names_float(suffix: sview?) -> bool:
            text: sview = get suffix else empty_sview()
            state Classify
            state Answer(value: bool)
            return start Classify:
                Classify:
                    -> Answer(true) if text == "f32" or text == "f64"
                    -> Answer(false)
                Answer(value):
                    => value
