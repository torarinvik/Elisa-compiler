# `module Lexer` is assembled from self-describing parts: tokens.elisa is the canonical
# `module Lexer:` (the Token/TokenKind/Lexer types), and each remaining file declares its
# own `extend Lexer:` block with its own visibility — so a file's membership and public/
# private status live in the file itself, not in this facade's include layout. This file
# just pulls the parts into the compilation unit and re-exports the public surface. The
# cursor primitives (`peek`/`advance_char`/…) live in the trailing `extend Lexer:` block
# below rather than a separate file — they are small and load-bearing for every part.
include "./tokens.elisa"
include "./lexer_core.elisa"
include "./lexer_strings.elisa"
include "./lexer_comments.elisa"
include "./lexer_numbers.elisa"
include "./lexer_identifiers.elisa"
include "./lexer_tokens.elisa"


type TokenKind = Lexer::TokenKind
type LexerPosition = Lexer::LexerPosition
type Token = Lexer::Token
type Lexer = Lexer::Lexer


def frontend_tokenize(filename: u8&, source: u8&) -> darray[Token]:
    can Memory.Allocate, Abort.Panic:
        return Lexer::frontend_tokenize(filename, source)


def frontend_tokenize_with_length(filename: u8&, source: u8&, source_length: usize) -> darray[Token]:
    can Memory.Allocate, Abort.Panic:
        return Lexer::frontend_tokenize_with_length(filename, source, source_length)


def frontend_tokenize_comments_with_length(filename: u8&, source: u8&, source_length: usize) -> darray[Token]:
    can Memory.Allocate, Abort.Panic:
        return Lexer::frontend_tokenize_comments_with_length(filename, source, source_length)


extend Lexer:
    private:
        @inline(always)
        def peek(lexer: Lexer&, offset: usize) -> char:
            return char_at(lexer.source, lexer.source_length, lexer.position + offset)

        @inline(always)
        def make_source_view(source: u8&, start: usize, end: usize) -> sview?:
            null return if end <= start
            return source[start:end]

        @inline(always)
        def advance_char(lexer: lmut Lexer) -> void:
            return if lexer.is_end_of_source()

            character: char = lexer.current_char()
            lexer.position <- lexer.position + 1

            is_newline: bool = character == '\n'
            lexer.line <- lexer.line + 1 if is_newline else lexer.line
            lexer.column <- 1 if is_newline else lexer.column + 1

        def advance_chars(lexer: lmut Lexer, count: u8):
            for _ in count..>0 |lexer| -> lexer:
                lexer <- lexer.advance_char()
