# `module Lexer` is assembled from self-describing parts: tokens.elisa is the canonical
# `module Lexer:` (the Token/TokenKind/Lexer types), and each remaining file declares its
# own `extend Lexer:` block with its own visibility — so a file's membership and public/
# private status live in the file itself, not in this facade's include layout. This file
# just pulls the parts into the compilation unit and re-exports the public surface. The
# cursor primitives (`peek`/`advance_char`/…) live in the trailing `extend Lexer:` block
# below rather than a separate file — they are small and load-bearing for every part.
include "./tokens.elisa"
include "./lexer_core.elisa"
include "./lexer_strings.elisa"
include "./lexer_comments.elisa"
include "./lexer_numbers.elisa"
include "./lexer_identifiers.elisa"
include "./lexer_tokens.elisa"


type TokenKind = Lexer::TokenKind
type LexerPosition = Lexer::LexerPosition
type Token = Lexer::Token
type Lexer = Lexer::Lexer


def frontend_tokenize(filename: u8&, source: u8&) -> darray[Token]:
    can Memory.Allocate, Abort.Panic:
        return Lexer::frontend_tokenize(filename, source)


def frontend_tokenize_with_length(filename: u8&, source: u8&, source_length: usize) -> darray[Token]:
    can Memory.Allocate, Abort.Panic:
        return Lexer::frontend_tokenize_with_length(filename, source, source_length)


def frontend_tokenize_expanded_unit(filename: u8&, source: u8&, source_length: usize) -> darray[Token]:
    can Memory.Allocate, Abort.Panic:
        return Lexer::frontend_tokenize_expanded_unit(filename, source, source_length)


def frontend_tokenize_comments_with_length(filename: u8&, source: u8&, source_length: usize) -> darray[Token]:
    can Memory.Allocate, Abort.Panic:
        return Lexer::frontend_tokenize_comments_with_length(filename, source, source_length)


extend Lexer:
    public:
        # Public because parser and backend diagnostics need the same source-location identity;
        # the map representation and lookup implementation remain private to Lexer.
        def source_original_line(flat_line: u32) -> u32 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            return source_original_line_from_map(flat_line)


    private:
        const SOURCE_LINE_MAP_SEPARATOR: u8 = 58
        const SOURCE_LINE_MAP_NEWLINE: u8 = 10
        const SOURCE_LINE_MAP_DIGIT_ZERO: u8 = 48

        # The lexer is also compiled as a standalone frontend unit by the breadth reporter.
        # Keep this tiny environment reader local instead of depending on the command-line
        # driver's `env_value`, which is not part of that unit's include graph.
        def source_line_map_value(name: sview, storage: mutable darray[u8]&) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            flag_storage: mutable darray[u8] = []
            for flag_index in 0..<sview_len(name) |flag_storage, name|:
                flag_storage.push(sview_at(name, flag_index))
            flag_storage.push(0)
            flag_name: cstr = (&flag_storage[0]).cast[cstr] can Unsafe.PointerCast
            if getenv(flag_name) is value_bytes:
                cursor: mutable i64 = 0
                keep_scanning: mutable bool = true
                while keep_scanning |cursor, keep_scanning, storage, value_bytes|:
                    byte_ref: u8& = value_bytes + cursor
                    value_byte: u8 = byte_ref
                    if value_byte == 0:
                        keep_scanning <- false
                    else:
                        storage.push(value_byte)
                        cursor <- cursor + 1
            return storage.count > 0

        # Translate a buffer line from a driver-expanded unit to the original source line.
        # The driver publishes the compact text map before tokenization. Reading that map here
        # keeps parser/backend naming independent of mutable process-global tables, so a future
        # multi-request compiler cannot accidentally reuse a previous request's locations.
        def source_original_line_from_map(flat_line: u32) -> u32 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            map_storage: mutable darray[u8] = []
            flat_line return if not source_line_map_value("ELISA_STAGE1_LINE_MAP", &map_storage)
            best_flat: mutable u32 = 0
            best_orig: mutable u32 = 0
            cursor: mutable usize = 0.usize()
            while cursor < map_storage.count |cursor, best_flat, best_orig, map_storage, flat_line|:
                entry_stop: mutable usize = cursor
                while entry_stop < map_storage.count |entry_stop, map_storage|:
                    break if map_storage[entry_stop] == SOURCE_LINE_MAP_NEWLINE
                    entry_stop <- entry_stop + 1.usize()
                scan: mutable usize = cursor
                entry_flat: mutable u32 = 0
                while scan < entry_stop |scan, entry_flat, map_storage|:
                    break if map_storage[scan] == SOURCE_LINE_MAP_SEPARATOR
                    return flat_line if map_storage[scan] < SOURCE_LINE_MAP_DIGIT_ZERO or map_storage[scan] > SOURCE_LINE_MAP_DIGIT_ZERO + 9
                    entry_flat <- entry_flat * 10 + (map_storage[scan] - SOURCE_LINE_MAP_DIGIT_ZERO).u32()
                    scan <- scan + 1.usize()
                return flat_line if scan >= entry_stop
                scan <- scan + 1.usize()
                entry_orig: mutable u32 = 0
                while scan < entry_stop |scan, entry_orig, map_storage|:
                    break if map_storage[scan] == SOURCE_LINE_MAP_SEPARATOR
                    return flat_line if map_storage[scan] < SOURCE_LINE_MAP_DIGIT_ZERO or map_storage[scan] > SOURCE_LINE_MAP_DIGIT_ZERO + 9
                    entry_orig <- entry_orig * 10 + (map_storage[scan] - SOURCE_LINE_MAP_DIGIT_ZERO).u32()
                    scan <- scan + 1.usize()
                if entry_flat <= flat_line and entry_flat >= best_flat:
                    best_flat <- entry_flat
                    best_orig <- entry_orig
                cursor <- entry_stop + 1.usize()
            flat_line return if best_flat == 0
            return best_orig + (flat_line - best_flat)

        @inline(always)
        def peek(lexer: Lexer&, offset: usize) -> char:
            return char_at(lexer.source, lexer.source_length, lexer.position + offset)

        @inline(always)
        def make_source_view(source: u8&, start: usize, end: usize) -> sview?:
            null return if end <= start
            return source[start:end]

        @inline(always)
        def advance_char(lexer: lmut Lexer) -> void:
            return if lexer.is_end_of_source()

            character: char = lexer.current_char()
            lexer.position <- lexer.position + 1

            is_newline: bool = character == '\n'
            lexer.line <- lexer.line + 1 if is_newline else lexer.line
            lexer.column <- 1 if is_newline else lexer.column + 1

        def advance_chars(lexer: lmut Lexer, count: u8):
            machine over lexer for _ in count..>0 -> lexer:
                state Advance
                start Advance

                Advance, _:
                    lexer <- lexer.advance_char()
                    -> Advance
