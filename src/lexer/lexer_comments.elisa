extend Lexer:
    private:
        def skip_line_comment(lexer: lmut Lexer):
            # Record the comment span for tooling before consuming it (position is
            # at the '#'; start == column so a comment token needs no adjustment).
            position: LexerPosition = lexer.cursor_position()
            start: usize = lexer.position
            # Loop stops at '\n', so consumed chars are never newlines: bump directly.
            machine over lexer.current_char() while not lexer.is_end_of_source() and lexer.current_char() != '\n':
                state Scan
                start Scan
                Scan, _:
                    lexer.position <- lexer.position + 1
                    lexer.column <- lexer.column + 1
                    -> Scan
            lexer.comments <- lexer.comments.push(Token(TokenKind.Comment, position, start, lexer.position)) can Memory.Allocate, Abort.Panic


        # docs/122 §5.2 range arm: the ten per-digit arms collapse to one range whose
        # body is the digit's offset from '0'; non-digits stay 0.
        def decimal_digit_value(character: char) -> int:
            match character:
                '0'..='9':
                    return (character.u8() - '0'.u8()).int()
                _:
                    return 0


        def try_consume_line_directive(lexer: lmut Lexer) -> bool:
            # Stage1 meta-compile: set membership `in {…}` declines; use or-chains.
            scan_index: mutable usize = lexer.position + 1
            machine over char_at(lexer.source, lexer.source_length, scan_index) while scan_index < lexer.source_length:
                state Scan
                start Scan
                Scan, ' ' | '\t':
                    scan_index <- scan_index + 1
                    -> Scan
                Scan, _:
                    break

            false return if char_at(lexer.source, lexer.source_length, scan_index) != 'l'
            false return if char_at(lexer.source, lexer.source_length, scan_index + 1) != 'i'
            false return if char_at(lexer.source, lexer.source_length, scan_index + 2) != 'n'
            false return if char_at(lexer.source, lexer.source_length, scan_index + 3) != 'e'

            cursor: mutable usize = scan_index + 4
            lead_ws: char = char_at(lexer.source, lexer.source_length, cursor)
            false return if not (lead_ws == ' ' or lead_ws == '\t')
            machine over char_at(lexer.source, lexer.source_length, cursor) while cursor < lexer.source_length:
                state ScanLeadSpace
                start ScanLeadSpace
                ScanLeadSpace, ' ' | '\t':
                    cursor <- cursor + 1
                    -> ScanLeadSpace
                ScanLeadSpace, _:
                    break

            number_start: usize = cursor
            lexer.machine_int <- 0
            machine over char_at(lexer.source, lexer.source_length, cursor) while cursor < lexer.source_length:
                state ScanLine
                start ScanLine
                ScanLine, '0'..='9':
                    lexer.machine_int <- lexer.machine_int * 10 + decimal_digit_value(char_at(lexer.source, lexer.source_length, cursor))
                    cursor <- cursor + 1
                    -> ScanLine
                ScanLine, _:
                    break
            false return if cursor == number_start

            machine over char_at(lexer.source, lexer.source_length, cursor) while cursor < lexer.source_length:
                state ScanFileSpace
                start ScanFileSpace
                ScanFileSpace, ' ' | '\t':
                    cursor <- cursor + 1
                    -> ScanFileSpace
                ScanFileSpace, _:
                    break

            file_start: usize = cursor
            machine over cursor while cursor < lexer.source_length and char_at(lexer.source, lexer.source_length, cursor) != '\n':
                state ScanFilename
                start ScanFilename
                ScanFilename, _:
                    cursor <- cursor + 1
                    -> ScanFilename

            file_end: mutable usize = cursor
            machine over char_at(lexer.source, lexer.source_length, file_end - 1) while file_end > file_start:
                state TrimFilename
                start TrimFilename
                TrimFilename, ' ' | '\t' | '\r':
                    file_end <- file_end - 1
                    -> TrimFilename
                TrimFilename, _:
                    break
            false return if file_end == file_start

            # Stage0 retargets both the line number and the logical filename.
            # The stage1 token model stores line/column on each token; the logical
            # filename remains lexer state for diagnostics/tooling paths that inspect
            # the active lexer after directive consumption.
            lexer.filename <- lexer.source[file_start:file_end]

            cursor <- cursor + 1 if cursor < lexer.source_length and char_at(lexer.source, lexer.source_length, cursor) == '\n'

            lexer.position <- cursor
            lexer.line <- lexer.machine_int
            lexer.column <- 1
            lexer.at_line_start <- true
            return true


        def consume_line_directives_at_line_start(lexer: lmut Lexer):
            consumed_directive: mutable bool = false
            machine over consumed_directive while lexer.at_line_start and not lexer.is_end_of_source() and lexer.current_char() == '#':
                state Attempt
                state Decide
                start Attempt
                Attempt, _:
                    consumed_directive, lexer <- lexer.try_consume_line_directive()
                    -> Decide
                Decide, true:
                    -> Attempt
                Decide, _:
                    break


        @inline(always)
        def is_block_comment_start(lexer: Lexer&) -> bool:
            return lexer.current_char() == '"' and lexer.peek(1) == '"' and lexer.peek(2) == '"'


        @inline(always)
        def skip_block_comment(lexer: lmut Lexer):
            position: LexerPosition = lexer.cursor_position()
            start: usize = lexer.position
            lexer <- lexer.advance_chars(3)

            machine over lexer.is_block_comment_start() while not lexer.is_end_of_source():
                state Scan
                start Scan
                Scan, true:
                    lexer <- lexer.advance_chars(3)
                    lexer.comments <- lexer.comments.push(Token(TokenKind.Comment, position, start, lexer.position)) can Memory.Allocate, Abort.Panic
                    return
                Scan, _:
                    lexer <- lexer.advance_char()
                    -> Scan

            # Unterminated block comment: still record what was consumed (to EOF).
            lexer.comments <- lexer.comments.push(Token(TokenKind.Comment, position, start, lexer.position)) can Memory.Allocate, Abort.Panic
        @inline(always)
        def skip_spaces(lexer: lmut Lexer):
            # Hot path: spaces/tabs are never '\n', so bump position/column directly and
            # skip advance_char's newline branch + re-read of the current char.
            machine over lexer.current_char() while not lexer.is_end_of_source() and (lexer.current_char() == ' ' or lexer.current_char() == '\t'):
                state Scan
                start Scan
                Scan, _:
                    lexer.position <- lexer.position + 1
                    lexer.column <- lexer.column + 1
                    -> Scan
