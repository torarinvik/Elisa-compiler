extend Lexer:
    private:
        def skip_line_comment(lexer: lmut Lexer):
            # Record the comment span for tooling before consuming it (position is
            # at the '#'; start == column so a comment token needs no adjustment).
            position: LexerPosition = lexer.cursor_position()
            start: usize = lexer.position
            # Loop stops at '\n', so consumed chars are never newlines: bump directly.
            while not lexer.is_end_of_source() and lexer.current_char() != '\n' |lexer|:
                lexer.position <- lexer.position + 1
                lexer.column <- lexer.column + 1
            lexer.comments <- lexer.comments.push(Token(TokenKind.Comment, position, start, lexer.position)) can Memory.Allocate, Abort.Panic


        # docs/122 §5.2 range arm: the ten per-digit arms collapse to one range whose
        # body is the digit's offset from '0'; non-digits stay 0.
        def decimal_digit_value(character: char) -> int:
            match character:
                '0'..='9':
                    return (character.u8() - '0'.u8()).int()
                _:
                    return 0


        def try_consume_line_directive(lexer: lmut Lexer) -> bool:
            scan_index: mutable usize = lexer.position + 1
            while scan_index < lexer.source_length and char_at(lexer.source, lexer.source_length, scan_index) in {' ', '\t'}:
                scan_index <- scan_index + 1

            if char_at(lexer.source, lexer.source_length, scan_index) != 'l':
                return false
            if char_at(lexer.source, lexer.source_length, scan_index + 1) != 'i':
                return false
            if char_at(lexer.source, lexer.source_length, scan_index + 2) != 'n':
                return false
            if char_at(lexer.source, lexer.source_length, scan_index + 3) != 'e':
                return false

            cursor: mutable usize = scan_index + 4
            if not (char_at(lexer.source, lexer.source_length, cursor) in {' ', '\t'}):
                return false
            while cursor < lexer.source_length and char_at(lexer.source, lexer.source_length, cursor) in {' ', '\t'}:
                cursor <- cursor + 1

            number_start: usize = cursor
            line: mutable int = 0
            while cursor < lexer.source_length and char_at(lexer.source, lexer.source_length, cursor).is_digit():
                line <- line * 10 + decimal_digit_value(char_at(lexer.source, lexer.source_length, cursor))
                cursor <- cursor + 1
            if cursor == number_start:
                return false

            while cursor < lexer.source_length and char_at(lexer.source, lexer.source_length, cursor) in {' ', '\t'}:
                cursor <- cursor + 1

            file_start: usize = cursor
            while cursor < lexer.source_length and char_at(lexer.source, lexer.source_length, cursor) != '\n':
                cursor <- cursor + 1

            file_end: mutable usize = cursor
            while file_end > file_start and char_at(lexer.source, lexer.source_length, file_end - 1) in {' ', '\t', '\r'}:
                file_end <- file_end - 1
            if file_end == file_start:
                return false

            # Stage0 retargets both the line number and the logical filename.
            # The stage1 token model stores line/column on each token; the logical
            # filename remains lexer state for diagnostics/tooling paths that inspect
            # the active lexer after directive consumption.
            lexer.filename <- lexer.source[file_start:file_end]

            if cursor < lexer.source_length and char_at(lexer.source, lexer.source_length, cursor) == '\n':
                cursor <- cursor + 1

            lexer.position <- cursor
            lexer.line <- line
            lexer.column <- 1
            lexer.at_line_start <- true
            return true


        def consume_line_directives_at_line_start(lexer: lmut Lexer):
            while lexer.at_line_start and not lexer.is_end_of_source() and lexer.current_char() == '#' |lexer|:
                rebind consumed_directive: bool, lexer = lexer.try_consume_line_directive()
                if not consumed_directive:
                    return


        @inline(always)
        def is_block_comment_start(lexer: Lexer&) -> bool:
            return lexer.current_char() == '"' and lexer.peek(1) == '"' and lexer.peek(2) == '"'


        @inline(always)
        def only_indentation_before_position(lexer: Lexer&, position: usize) -> bool:
            while cursor > 0 |cursor: usize = position|:
                cursor <- cursor - 1
                character: char = char_at(lexer.source, lexer.source_length, cursor)
                if character == '\n':
                    return true
                if character != ' ' and character != '\t':
                    return false
            return true


        def skip_block_comment(lexer: lmut Lexer):
            position: LexerPosition = lexer.cursor_position()
            start: usize = lexer.position
            lexer <- lexer.advance_chars(3)

            machine over lexer.current_char() while not lexer.is_end_of_source():
                state Scanning

                start Scanning

                Scanning, _ if lexer.is_block_comment_start():
                    lexer <- lexer.advance_chars(3)
                    lexer.comments <- lexer.comments.push(Token(TokenKind.Comment, position, start, lexer.position)) can Memory.Allocate, Abort.Panic
                    return

                Scanning, _:
                    lexer <- lexer.advance_char()
                    -> Scanning

            # Unterminated block comment: still record what was consumed (to EOF).
            lexer.comments <- lexer.comments.push(Token(TokenKind.Comment, position, start, lexer.position)) can Memory.Allocate, Abort.Panic
        @inline(always)
        def skip_spaces(lexer: lmut Lexer):
            # Hot path: spaces/tabs are never '\n', so bump position/column directly and
            # skip advance_char's newline branch + re-read of the current char.
            machine over lexer.current_char() while not lexer.is_end_of_source():
                state Skipping

                start Skipping

                Skipping, ' ' | '\t':
                    lexer.position <- lexer.position + 1
                    lexer.column <- lexer.column + 1
                    -> Skipping

                Skipping, _:
                    break
