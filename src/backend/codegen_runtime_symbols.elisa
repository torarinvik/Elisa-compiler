# Exact symbol sets shared by backend linkage and instrumentation decisions.
# Keep these pure so Elisa-proof can reason about the production classifiers directly.
module BackendRuntimeSymbols:
    public:
        def is_allocator_symbol(name: sview) -> bool can[Abort.Panic]:
            ensure result == (name == "new_region" or name == "new_region_backend" or name == "free_region" or name == "free_region_backend" or name == "arena_alloc" or name == "arena_realloc" or name == "arena_memcpy" or name == "arena_memeq" or name == "arena_strdup" or name == "arena_memdup" or name == "arena_snapshot" or name == "arena_reset" or name == "arena_rewind" or name == "arena_free" or name == "arena_adopt" or name == "arena_trim" or name == "alloc_perm" or name == "alloc_scratch" or name == "reset_scratch")
            can Abort.Panic:
                return when name:
                    "new_region" | "new_region_backend" -> true
                    "free_region" | "free_region_backend" -> true
                    "arena_alloc" | "arena_realloc" -> true
                    "arena_memcpy" | "arena_memeq" -> true
                    "arena_strdup" | "arena_memdup" -> true
                    "arena_snapshot" | "arena_reset" -> true
                    "arena_rewind" | "arena_free" -> true
                    "arena_adopt" | "arena_trim" -> true
                    "alloc_perm" | "alloc_scratch" -> true
                    "reset_scratch" -> true
                    _ -> false

        def is_string_runtime_symbol(name: sview) -> bool can[Abort.Panic]:
            ensure result == (name == "ctx_hash_cstr" or name == "ctx_hash_u64" or name == "ctx_strlen" or name == "ctx_streq" or name == "ctx_string_index" or name == "ctx_string_slice" or name == "ctx_string_slice_eq" or name == "ctx_string_slices_eq" or name == "ctx_string_view" or name == "ctx_string_view_len" or name == "ctx_string_view_slice" or name == "ctx_string_view_index" or name == "ctx_string_view_prefix" or name == "ctx_string_view_suffix" or name == "ctx_string_view_eq" or name == "ctx_string_views_eq" or name == "ctx_string_from_view" or name == "ctx_fstr_alloc" or name == "ctx_fstr_append" or name == "ctx_llvm_codegen_fatal")
            can Abort.Panic:
                return when name:
                    "ctx_hash_cstr" | "ctx_hash_u64" -> true
                    "ctx_strlen" | "ctx_streq" -> true
                    "ctx_string_index" | "ctx_string_slice" -> true
                    "ctx_string_slice_eq" | "ctx_string_slices_eq" -> true
                    "ctx_string_view" | "ctx_string_view_len" -> true
                    "ctx_string_view_slice" | "ctx_string_view_index" -> true
                    "ctx_string_view_prefix" | "ctx_string_view_suffix" -> true
                    "ctx_string_view_eq" | "ctx_string_views_eq" -> true
                    "ctx_string_from_view" -> true
                    "ctx_fstr_alloc" | "ctx_fstr_append" -> true
                    "ctx_llvm_codegen_fatal" -> true
                    _ -> false

        def is_trace_runtime_symbol(name: sview) -> bool can[Abort.Panic]:
            ensure result == (name == "elisa_trace_record" or name == "elisa_trace_function_entry" or name == "elisa_trace_function_exit" or name == "elisa_trace_record_value" or name == "elisa_trace_record_id" or name == "elisa_trace_function_entry_id" or name == "elisa_trace_function_exit_id" or name == "elisa_trace_record_value_id" or name == "elisa_trace_count" or name == "elisa_trace_dump" or name == "elisa_trace_install_fault_handler")
            can Abort.Panic:
                return when name:
                    "elisa_trace_record" | "elisa_trace_function_entry" | "elisa_trace_function_exit" | "elisa_trace_record_value" -> true
                    "elisa_trace_record_id" | "elisa_trace_function_entry_id" | "elisa_trace_function_exit_id" | "elisa_trace_record_value_id" -> true
                    "elisa_trace_count" | "elisa_trace_dump" -> true
                    "elisa_trace_install_fault_handler" -> true
                    _ -> false

        def is_aos_store_runtime_symbol(name: sview) -> bool can[Abort.Panic]:
            ensure result == (name == "ctx_aos_store_new_sized" or name == "ctx_aos_store_alloc_sized" or name == "ctx_aos_store_sized_record" or name == "ctx_aos_store_side_slot" or name == "ctx_aos_store_new_with_side_words" or name == "ctx_aos_store_read_side_word" or name == "ctx_aos_store_record_side_words_at")
            can Abort.Panic:
                return when name:
                    "ctx_aos_store_new_sized" | "ctx_aos_store_alloc_sized" | "ctx_aos_store_sized_record" | "ctx_aos_store_side_slot" -> true
                    "ctx_aos_store_new_with_side_words" | "ctx_aos_store_read_side_word" | "ctx_aos_store_record_side_words_at" -> true
                    _ -> false

        def is_packed_store_runtime_symbol(name: sview) -> bool can[Abort.Panic]:
            ensure result == (name == "ctx_packed_store_alloc" or name == "ctx_packed_store_alloc_fixed_index_result" or name == "ctx_packed_store_alloc_fixed_result" or name == "ctx_packed_store_alloc_fixed_result_slow" or name == "ctx_packed_store_alloc_fixed_tagged_index_result" or name == "ctx_packed_store_alloc_fixed_tagged_result" or name == "ctx_packed_store_alloc_fixed_tagged_variant_sparse_result" or name == "ctx_packed_store_alloc_index_result" or name == "ctx_packed_store_alloc_result" or name == "ctx_packed_store_alloc_result_slow" or name == "ctx_packed_store_alloc_tagged_variant_sparse_result" or name == "ctx_packed_store_count" or name == "ctx_packed_store_decode" or name == "ctx_packed_store_decode_index" or name == "ctx_packed_store_decode_variant_sparse" or name == "ctx_packed_store_encode" or name == "ctx_packed_store_encode_index" or name == "ctx_packed_store_encode_variant_sparse" or name == "ctx_packed_store_index_at" or name == "ctx_packed_store_read_index_tag" or name == "ctx_packed_store_read_index_word" or name == "ctx_packed_store_read_side_word" or name == "ctx_packed_store_read_tag" or name == "ctx_packed_store_read_variant_sparse_tag" or name == "ctx_packed_store_read_variant_sparse_word" or name == "ctx_packed_store_read_word" or name == "ctx_packed_store_record_prefix_words" or name == "ctx_packed_store_record_row_ptr" or name == "ctx_packed_store_record_side_words" or name == "ctx_packed_store_record_side_words_at" or name == "ctx_packed_store_record_tag" or name == "ctx_packed_store_reserve" or name == "ctx_packed_store_row_ptr_at" or name == "ctx_packed_store_state_new" or name == "ctx_packed_store_state_new_variant_sparse" or name == "ctx_packed_store_state_new_variant_sparse_with_side_words" or name == "ctx_packed_store_state_new_with_prefix_and_side_words" or name == "ctx_packed_store_state_new_with_prefix_words" or name == "ctx_packed_store_state_new_with_side_words" or name == "ctx_packed_store_view" or name == "ctx_packed_store_word_handle_at")
            can Abort.Panic:
                return when name:
                    "ctx_packed_store_alloc" | "ctx_packed_store_alloc_fixed_index_result" | "ctx_packed_store_alloc_fixed_result" -> true
                    "ctx_packed_store_alloc_fixed_result_slow" | "ctx_packed_store_alloc_fixed_tagged_index_result" | "ctx_packed_store_alloc_fixed_tagged_result" -> true
                    "ctx_packed_store_alloc_fixed_tagged_variant_sparse_result" | "ctx_packed_store_alloc_index_result" | "ctx_packed_store_alloc_result" -> true
                    "ctx_packed_store_alloc_result_slow" | "ctx_packed_store_alloc_tagged_variant_sparse_result" | "ctx_packed_store_count" -> true
                    "ctx_packed_store_decode" | "ctx_packed_store_decode_index" | "ctx_packed_store_decode_variant_sparse" -> true
                    "ctx_packed_store_encode" | "ctx_packed_store_encode_index" | "ctx_packed_store_encode_variant_sparse" -> true
                    "ctx_packed_store_index_at" | "ctx_packed_store_read_index_tag" | "ctx_packed_store_read_index_word" -> true
                    "ctx_packed_store_read_side_word" | "ctx_packed_store_read_tag" | "ctx_packed_store_read_variant_sparse_tag" -> true
                    "ctx_packed_store_read_variant_sparse_word" | "ctx_packed_store_read_word" | "ctx_packed_store_record_prefix_words" -> true
                    "ctx_packed_store_record_row_ptr" | "ctx_packed_store_record_side_words" | "ctx_packed_store_record_side_words_at" -> true
                    "ctx_packed_store_record_tag" | "ctx_packed_store_reserve" | "ctx_packed_store_row_ptr_at" -> true
                    "ctx_packed_store_state_new" | "ctx_packed_store_state_new_variant_sparse" | "ctx_packed_store_state_new_variant_sparse_with_side_words" -> true
                    "ctx_packed_store_state_new_with_prefix_and_side_words" | "ctx_packed_store_state_new_with_prefix_words" | "ctx_packed_store_state_new_with_side_words" -> true
                    "ctx_packed_store_view" | "ctx_packed_store_word_handle_at" -> true
                    _ -> false

        def is_runtime_provided(name: sview) -> bool can[Abort.Panic]:
            ensure result == (is_allocator_symbol(name) or is_string_runtime_symbol(name) or is_trace_runtime_symbol(name) or is_aos_store_runtime_symbol(name) or is_packed_store_runtime_symbol(name))
            return is_allocator_symbol(name) or is_string_runtime_symbol(name) or is_trace_runtime_symbol(name) or is_aos_store_runtime_symbol(name) or is_packed_store_runtime_symbol(name)

        def is_trace_callback(name: sview) -> bool can[Abort.Panic]:
            ensure result == (name == "elisa_trace_record" or name == "elisa_trace_record_id" or name == "elisa_trace_record_value" or name == "elisa_trace_record_value_id" or name == "elisa_trace_function_entry" or name == "elisa_trace_function_entry_id" or name == "elisa_trace_function_exit" or name == "elisa_trace_function_exit_id" or name == "elisa_trace_install_fault_handler")
            can Abort.Panic:
                return when name:
                    "elisa_trace_record" | "elisa_trace_record_id" -> true
                    "elisa_trace_record_value" | "elisa_trace_record_value_id" -> true
                    "elisa_trace_function_entry" | "elisa_trace_function_entry_id" -> true
                    "elisa_trace_function_exit" | "elisa_trace_function_exit_id" -> true
                    "elisa_trace_install_fault_handler" -> true
                    _ -> false

        def is_runtime_external_only(name: sview) -> bool:
            ensure result == (name == "ctx_aos_store_record")
            return name == "ctx_aos_store_record"
