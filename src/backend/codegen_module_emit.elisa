extend Backend:
    public:
        def emit_module_core(file: Ast::File&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef, target_data: LLVMTargetDataRef, want_debug: bool, want_trace: bool, source_name: sview, force_program: bool, checked_contracts: bool) -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Global.Write:
                # Lifted lambda names are module-local. The one-shot compiler gets a fresh
                # process for each request; a retained compile-session must restore that
                # same naming baseline before emitting each module.
                lifted_lambda_counter <- 0
                annotation_pair_cache_invalidate()
            structs: mutable StructTable = new_struct_table(ctx, target_data, checked_contracts)
            structs.target.prefer_private_linkage <- prefer_private_linkage_enabled()
            structs.target.bundled_runtime_build <- bundled_runtime_build() if structs.target.prefer_private_linkage
            structs.target.noalias_mutable_refs <- noalias_mutable_refs_enabled()
            structs.target.wasm_component_types_enabled <- wasm_component_codegen_enabled()
            structs.annotations.named_state_families <- file.state_families
            for annotation in file.enum_annotations |structs|:
                remember_packed_profile(annotation, structs)
                structs.contracts.ghost_functions.push(annotation.name) if annotation.owner == "__ghost_fn"
                if annotation.owner == "__global_region":
                    already_program_region: mutable bool = false
                    for existing_program_region in structs.regions.program_region_names |already_program_region, annotation|:
                        already_program_region <- true if existing_program_region == annotation.name
                    if not already_program_region:
                        structs.regions.program_region_names <- structs.regions.program_region_names.push(annotation.name)
                if annotation.name == "__local_binding_mutable" or annotation.name == "__local_binding_immutable":
                    structs.bindings.local_binding_names <- structs.bindings.local_binding_names.push(annotation.owner)
                    structs.bindings.local_binding_lines <- structs.bindings.local_binding_lines.push(annotation.line)
                    local_binding_line_chain_extend(structs)
                    structs.bindings.local_binding_offsets <- structs.bindings.local_binding_offsets.push(annotation.offset)
                    structs.bindings.local_binding_modes <- structs.bindings.local_binding_modes.push(1) if annotation.name == "__local_binding_mutable"
                    structs.bindings.local_binding_modes <- structs.bindings.local_binding_modes.push(-1) if annotation.name == "__local_binding_immutable"
                if annotation.name == "__query_owner":
                    structs.queries.query_owner_scope_ids <- structs.queries.query_owner_scope_ids.push(query_scope_id_for_annotation(annotation.offset, structs))
                    structs.queries.query_owner_names <- structs.queries.query_owner_names.push(annotation.owner)
                if annotation.owner == "__branch_hint":
                    structs.annotations.branch_hint_lines <- structs.annotations.branch_hint_lines.push(annotation.line)
                    structs.annotations.branch_hint_offsets <- structs.annotations.branch_hint_offsets.push(annotation.offset)
                    structs.annotations.branch_hint_kinds <- structs.annotations.branch_hint_kinds.push(annotation.name)
                # `__ast_refinement` / `__aos` are stamped on EVERY user refinement by the
                # parser; only a store-backed hierarchy (or a recursive enum) is AoS.
                marks_aos: bool = (annotation.name == "__recursive_field" and recursive_enum_selects_aos(file.enum_annotations, annotation.owner, annotation.module)) or ((annotation.name == "__ast_refinement" or annotation.name == "__aos") and hierarchy_is_store_backed(file, annotation.owner, annotation.module))
                if marks_aos:
                    already_aos: mutable bool = false
                    for existing_aos in 0..<structs.packed_layouts.aos_dynamic_names.count |already_aos, annotation, structs|:
                        existing_module: sview = structs.packed_layouts.aos_dynamic_modules[existing_aos] if existing_aos < structs.packed_layouts.aos_dynamic_modules.count else ""
                        already_aos <- true if structs.packed_layouts.aos_dynamic_names[existing_aos] == annotation.owner and existing_module == annotation.module
                    if not already_aos and annotation.owner != "":
                        structs.packed_layouts.aos_dynamic_names <- structs.packed_layouts.aos_dynamic_names.push(annotation.owner)
                        structs.packed_layouts.aos_dynamic_modules <- structs.packed_layouts.aos_dynamic_modules.push(annotation.module)
                if annotation.line == 3900000008 and hierarchy_is_store_backed(file, annotation.owner, annotation.module):
                    already_child_aos: mutable bool = false
                    for existing_child_aos in 0..<structs.packed_layouts.aos_dynamic_names.count |already_child_aos, annotation, structs|:
                        existing_module: sview = structs.packed_layouts.aos_dynamic_modules[existing_child_aos] if existing_child_aos < structs.packed_layouts.aos_dynamic_modules.count else ""
                        already_child_aos <- true if structs.packed_layouts.aos_dynamic_names[existing_child_aos] == annotation.owner and existing_module == annotation.module
                    if not already_child_aos and annotation.owner != "":
                        structs.packed_layouts.aos_dynamic_names <- structs.packed_layouts.aos_dynamic_names.push(annotation.owner)
                        structs.packed_layouts.aos_dynamic_modules <- structs.packed_layouts.aos_dynamic_modules.push(annotation.module)
                    already_parent_aos: mutable bool = false
                    for existing_parent_aos in 0..<structs.packed_layouts.aos_dynamic_names.count |already_parent_aos, annotation, structs|:
                        existing_module: sview = structs.packed_layouts.aos_dynamic_modules[existing_parent_aos] if existing_parent_aos < structs.packed_layouts.aos_dynamic_modules.count else ""
                        already_parent_aos <- true if structs.packed_layouts.aos_dynamic_names[existing_parent_aos] == annotation.name and existing_module == annotation.module
                    if not already_parent_aos and annotation.name != "":
                        structs.packed_layouts.aos_dynamic_names <- structs.packed_layouts.aos_dynamic_names.push(annotation.name)
                        structs.packed_layouts.aos_dynamic_modules <- structs.packed_layouts.aos_dynamic_modules.push(annotation.module)
                # `struct Holder[?]` -- a TYPESTATE header. Recorded by OWNER so the type
                # resolver can erase a `Holder[&]` bracket for THIS struct only; erasing the
                # bracket for every plain struct swallowed generic instantiations and declined
                # 10+ programs across the differential suite.
                structs.annotations.aggregate_state_owners <- structs.annotations.aggregate_state_owners.push(annotation.owner) if annotation.name == "__aggregate_state"
                # `struct S layout(soa)` -- a COLUMN-major aggregate. stage0 lowers it to a
                # struct whose every field is a darray of the declared type
                # (`%SymbolRows = type { %DynArray__usize, %DynArray__u32 }`).
                structs.storage_layouts.soa_layout_owners <- structs.storage_layouts.soa_layout_owners.push(annotation.owner) if annotation.name == "__layout_soa"
                structs.storage_layouts.packed_layout_owners <- structs.storage_layouts.packed_layout_owners.push(annotation.owner) if annotation.name == "__layout_packed"
                structs.visibility.impl_concrete_names <- structs.visibility.impl_concrete_names.push(annotation.name) if annotation.owner == "__impl_concrete"
                if annotation.name == "__query_binder":
                    structs.queries.query_extra_binder_scope_ids <- structs.queries.query_extra_binder_scope_ids.push(query_scope_id_for_annotation(annotation.offset, structs))
                    structs.queries.query_extra_binder_names <- structs.queries.query_extra_binder_names.push(annotation.owner)
                if annotation.owner == "__parallel_comprehension" and annotation.name == "__parallel":
                    structs.queries.parallel_comprehension_scope_ids <- structs.queries.parallel_comprehension_scope_ids.push(query_scope_id_for_annotation(annotation.offset, structs))
                if annotation.name == "__for_brace_field":
                    structs.queries.for_brace_field_offsets <- structs.queries.for_brace_field_offsets.push(annotation.offset)
                    structs.queries.for_brace_field_names <- structs.queries.for_brace_field_names.push(annotation.owner)
                if annotation.name == "__submit_pool":
                    structs.annotations.submit_pool_offsets <- structs.annotations.submit_pool_offsets.push(annotation.offset)
                    structs.annotations.submit_pool_names <- structs.annotations.submit_pool_names.push(annotation.owner)
                if annotation.owner == "__for_interleave":
                    if annotation.name == "8":
                        structs.annotations.loop_interleave_offsets <- structs.annotations.loop_interleave_offsets.push(annotation.offset)
                        structs.annotations.loop_interleave_counts <- structs.annotations.loop_interleave_counts.push(8)
                    elif annotation.name == "16":
                        structs.annotations.loop_interleave_offsets <- structs.annotations.loop_interleave_offsets.push(annotation.offset)
                        structs.annotations.loop_interleave_counts <- structs.annotations.loop_interleave_counts.push(16)
                # `node is Expr.Pair as pair` -- the alias for a VARIANT test, keyed by the
                # exact target position. The parser keeps the variant as the is-RHS (so the
                # test is real) and records the name here. Recorded as an ENUM annotation, not a
                # region one: the region side table has several consumers and one of them read
                # this back as an unknown region qualifier.
                if annotation.name == "__is_variant_alias":
                    structs.annotations.is_variant_alias_lines <- structs.annotations.is_variant_alias_lines.push(annotation.line)
                    structs.annotations.is_variant_alias_offsets <- structs.annotations.is_variant_alias_offsets.push(annotation.offset)
                    structs.annotations.is_variant_alias_names <- structs.annotations.is_variant_alias_names.push(annotation.owner)
            for derived_rule in file.derived_state_rules |structs|:
                structs.annotations.derived_state_owners <- structs.annotations.derived_state_owners.push(derived_rule.owner)
                structs.annotations.derived_state_modules <- structs.annotations.derived_state_modules.push(derived_rule.module_name)
                structs.annotations.derived_state_names <- structs.annotations.derived_state_names.push(derived_rule.state)
                structs.annotations.derived_state_conditions <- structs.annotations.derived_state_conditions.push(derived_rule.condition)
            for region_annotation in file.local_region_annotations |structs|:
                if region_annotation.name == "__region_param":
                    structs.regions.region_param_lines <- structs.regions.region_param_lines.push(region_annotation.line)
                    # Match the backend declaration identity convention: offsets reserve
                    # zero for rows without source identity, so every parser position is +1.
                    structs.regions.region_param_owner_offsets <- structs.regions.region_param_owner_offsets.push(region_annotation.owner_offset + 1)
                    structs.regions.region_param_names <- structs.regions.region_param_names.push(region_annotation.region)
                # The per-DECLARATION `@region` pin, under its own reserved marker. Keyed by
                # the declaration's line and raw token offset; `region` is its arena.
                if region_annotation.name == "__region_pin":
                    structs.regions.local_region_lines <- structs.regions.local_region_lines.push(region_annotation.line)
                    structs.regions.local_region_offsets <- structs.regions.local_region_offsets.push(region_annotation.owner_offset)
                    structs.regions.local_region_names <- structs.regions.local_region_names.push(region_annotation.region)
            # The runtime is declared once per module; each function gets its own arena
            # value below (the `arena` field here is a placeholder until then).
            runtime: mutable Runtime = declare_runtime(m, ctx, want_trace, packed_profile_mode(file.enum_annotations), structs.target.target_pointer_bits)
            runtime.noalias_mutable_refs <- structs.target.noalias_mutable_refs
            runtime.trace_enabled <- want_trace
            runtime.trace_functions_only <- trace_functions_only_enabled()
            generics: mutable GenericTable = new_generic_table()
            top: mutable darray[Decl] = select_module_declarations(file, structs)
            collect_extern_ensures(file, top, structs)
            # Owned in, owned out: threaded functions and their calls become the `&` form
            # (codegen_value_threading.elisa) before anything is registered or declared.
            top <- lower_value_threading(file, top)

            # Templates must be known before any body is emitted: a call decides between
            # "ordinary function" and "instantiate a generic" by looking here.
            register_generics(file, top, generics)
            register_effect_generic_clones(file, top, generics)
            # Mark only the reserved runtime TaskGroup entry points. The manual-group submit
            # proof requires these declaration identities; a same-spelled user stub must not
            # certify a join window.
            for declaration in top:
                trusted_group_api_name: sview = submit_group_runtime_api_declaration_name(declaration)
                if trusted_group_api_name != "":
                    match declaration:
                        Decl.Func(pos: function_pos, _):
                            can Global{Read,Write}:
                                if Lexer::source_line_is_runtime_std(function_pos.line):
                                    structs.annotations.task_group_runtime_api_names.push(trusted_group_api_name)
                                    api_line: u32 = function_pos.line
                                    structs.annotations.task_group_runtime_api_lines.push(api_line)
                        _:
                            pass
            # Keep an exact declaration identity for the only public Task consumer that can
            # safely cross the lexical pool guard: the bundled synchronous pool_await API.
            # Name/signature alone would let a user declaration bless an arbitrary helper.
            for declaration in top:
                if declaration is Decl.Func(await_name, _, _, _, _, _, await_pos):
                    if await_name == "pool_await":
                        can Global{Read,Write}:
                            if Lexer::source_line_is_runtime_std(await_pos.line):
                                structs.annotations.pool_await_runtime_lines.push(await_pos.line)
                                structs.annotations.pool_await_runtime_offsets.push(await_pos.offset)
            fns: mutable FnTable = FnTable{names: [], lines: [], offsets: [], owners: [], needs_arena: [], arena_counts: [], needs_store: [], is_error: [], returns_nullable: [], is_variadic: [], is_extern: [], handles: [], returns: [], param_types: [], param_names: [], param_defaults: [], param_start: [], param_count: [], param_region_slots: []}
            declined: mutable bool = false

            # THREE passes. Structs first: a function signature can name a struct, and a
            # struct field can name another struct, so every struct type must exist before
            # any signature is resolved. Named-empty-then-set-body (see llvm_c.elisa) is
            # what makes the field pass tolerate any declaration order.
            # Generic struct templates first: a concrete struct's field may name a
            # `Base[args]` application, and register_struct_name must know to SKIP a template
            # rather than register it as a (fieldless) concrete type.
            register_module_types(file, top, structs, m, ctx) can Global{Read,Write}
            # AFTER the source types, so the std's own `DynArrayView` wins when it is in the
            # unit and this is a no-op. Without the std there is no declaration to find and
            # every `view[T]` use declined; see synthesize_view_struct.
            _ = synthesize_view_struct(structs)
            # Region-bearing parameter facts are whole-module ABI facts. Compute them after
            # declarations have been selected and before either the declaration or body pass
            # reads them; forwarding through helpers requires a fixpoint over all functions.
            register_region_abi_facts(top, structs, generics)
            # Passes 3 and 4 cover FUNCTIONS only: a struct declaration emits no code of
            # its own (its type was built above), so it is skipped rather than declined.
            # The body pass looks its handle up by NAME — `fns` is no longer index-parallel
            # with `top_decls` now that non-function declarations exist.
            # A function whose SIGNATURE cannot be modeled is simply not declared: it has
            # no entry in `fns`, so every call to it declines its CALLER (which is then
            # stripped below). Only `main` failing is fatal to the module.
            declare_module_functions(file, top, fns, structs, generics, m, ctx) can Global{Read,Write}
            aos_record_runtime_match_count: mutable usize = 0
            aos_record_source_collision: mutable bool = false
            if packed_profile_mode(file.enum_annotations) == 2:
                for record_fn_index in 0..<fns.handles.count |fns, structs, runtime, aos_record_runtime_match_count, aos_record_source_collision|:
                    continue if fns.handles[record_fn_index] != runtime.packed_read_tag
                    if record_fn_index < fns.names.count and record_fn_index < fns.lines.count and record_fn_index < fns.owners.count and record_fn_index < fns.is_extern.count and fns.names[record_fn_index] == "ctx_aos_store_record" and fns.owners[record_fn_index] == "" and not fns.is_extern[record_fn_index]:
                        can Global{Read,Write}:
                            if Lexer::source_line_is_runtime_std(fns.lines[record_fn_index]):
                                aos_record_runtime_match_count <- aos_record_runtime_match_count + 1
                            else:
                                aos_record_source_collision <- true
                    else:
                        aos_record_source_collision <- true
                if aos_record_runtime_match_count == 1 and not aos_record_source_collision:
                    if LLVMGetNamedFunction(m, "ctx_aos_store_record") is record_fn:
                        if record_fn == runtime.packed_read_tag:
                            mark_aos_store_inline_helper(record_fn, ctx)
            register_scratch_summaries(top, fns, structs)
            register_local_scratch_bodies(top, fns, structs)
            structs.memory.memory_declarations <- top
            structs.memory.memory_speed_enabled <- memory_speed_enabled()
            structs.memory.memory_helper_enabled <- memory_policy_enabled("helper")
            structs.memory.memory_reserve_enabled <- memory_policy_enabled("reserve")
            structs.memory.memory_stack_enabled <- memory_policy_enabled("stack")

            # declare_runtime PRE-DECLARES a few names (arena_alloc, ctx_streq,
            # new_region_backend, …). When the SOURCE also defines one, LLVMAddFunction cannot
            # reuse the name and silently appends a suffix, so the body lands on `arena_alloc.2`
            # while `arena_alloc` stays a bodiless declaration — with no DECLINE and no DROPPED,
            # because nothing was declined. In most PROGRAM runtime helpers that is wanted:
            # the declaration binds to elisacore_runtime.o and the renamed copy dead-strips. In the
            # runtime object ITSELF it means the object exports nothing usable.
            #
            # So general runtime rebinding is ONLY FOR A LIBRARY. Broadly doing it for
            # programs was measured and is catastrophic — 36 corpus programs segfaulted (35
            # of them EASM, which does its own LLVMGetNamedFunction bookkeeping) and gen2 broke.
            #
            # Bodies have not been emitted yet, so swapping the table entry is enough: the body
            # goes to the canonical symbol and the renamed declaration is left dead.
            # Explicit arena definitions must also share the builtin handles in
            # programs: mixing external arena_alloc with a private arena_realloc
            # splits reclaimed-span/cache state between two runtime instances.
            # Keep the broader library-only rule for every other runtime name;
            # EASM and other frontend helpers depend on that existing boundary.
            reuse_library: bool = function_index_of(fns, "", "main") < 0
            if reuse_library or declaration_list_has_function(top, "arena_alloc") or declaration_list_has_function(top, "arena_realloc") or declaration_list_has_function(top, "arena_free"):
                for reuse_index in 0..<fns.handles.count |fns, m, structs|:
                    continue if fns.owners[reuse_index] != ""
                    continue if not reuse_library and fns.names[reuse_index] != "arena_alloc" and fns.names[reuse_index] != "arena_realloc" and fns.names[reuse_index] != "arena_free"
                    # Overloads mangle their name, so only a UNIQUE bare name is canonical.
                    first_top_level: i64 = function_index_of(fns, "", fns.names[reuse_index])
                    continue if first_top_level != reuse_index.i64()
                    reuse_same_name: mutable usize = 0
                    reuse_probe: mutable i64 = first_top_level
                    while reuse_probe >= 0 |reuse_same_name, reuse_probe, fns, reuse_index|:
                        reuse_same_name <- reuse_same_name + 1 if fns.owners[reuse_probe.usize()] == ""
                        break if reuse_same_name > 1
                        reuse_probe <- next_function_named(fns, fns.names[reuse_index], reuse_probe)
                    continue if reuse_same_name != 1
                    reuse_storage: mutable darray[u8] = []
                    reuse_name: cstr = sview_to_cstr(fns.names[reuse_index], reuse_storage)
                    if LLVMGetNamedFunction(m, reuse_name) is reuse_owner_handle:
                        # No collision: the lookup hands back this very handle, so this is a
                        # no-op by construction.
                        continue if reuse_owner_handle == fns.handles[reuse_index]
                        # An EXACT type match only. LLVM types are uniqued per context, so this
                        # compares by identity; declare_runtime's signatures are hand-written and
                        # need not agree with the source's, and binding a body to a handle whose
                        # type disagrees would miscompile SILENTLY.
                        continue if LLVMGlobalGetValueType(reuse_owner_handle) != LLVMGlobalGetValueType(fns.handles[reuse_index])
                        continue if LLVMGetFirstBasicBlock(reuse_owner_handle) is reuse_existing_body
                        fns.handles[reuse_index] <- reuse_owner_handle

            # BEFORE the bodies: each alloca needs its function's subprogram already
            # attached to hang a parameter/local variable off. (The declare pass above has
            # run, so every handle is in `fns`.)
            emit_debug_info(file, top, m, fns, structs, runtime, source_name, ctx) can Global{Read,Write} if want_debug
            main_ok: mutable bool = false
            dangling: mutable darray[LLVMValueRef] = []
            emitted_count: i64 = emit_module_bodies(file, top, fns, structs, generics, runtime, m, ctx, builder, main_ok, dangling, force_program) can Global{Read,Write}
            # Never return an object where an unsupported mutable-global initializer was
            # silently replaced by zero. Stage0 rejects that module during LLVM global
            # emission; Stage1 must likewise make the compilation fail.
            return -1 if:
                structs.diagnostics.unsupported_global_initializer != ""
                # A module that DECLARES `main` and failed to emit it is a broken program: decline.
                # A module that declares no `main` at all is a LIBRARY — `native_runtime_support.elisa`
                # is the one the build actually needs — and refusing those was what stopped stage1
                # compiling the standard library from source. The driver still rejects an empty
                # module (`2 return if emitted_count <= 0`), so nothing silently produces a
                # contentless object.
                # Asks whether a top-level `def main` DECLARATION exists, not whether the FnTable
                # holds an entry named `main`. The table also holds EXPORT WRAPPERS, so
                # `export fn main() -> int = ctx_test_main` — which is how a program supplies its
                # entry point without a `def main`, and exactly what stage0's `-emit test-runner`
                # generates — registered under "main" and made this look like a program whose
                # `main` had failed to emit. `main_ok` is only ever set by a top-level Decl.Func,
                # so the module declined with emitted_count -1 and the driver exited 2 with no
                # message. stage0 compiles that shape.
                not main_ok and module_declares_main(top)
            # A PROGRAM that declined a body which is still CALLED cannot link, and until now
            # said so only as `Undefined symbol: _total` from the host linker — the driver
            # exited 0 on an object it knew was broken (the decline is already in
            # `!elisa.declined`). Decline the module instead, so the compiler owns its own bad
            # news. Deliberately narrow, because all three narrowings are load-bearing:
            #   * PROGRAMS only — a library's object exists to be linked against, and
            #     `native_runtime_support.elisa` legitimately leaves symbols to others.
            #   * REFERENCED only — the self-host build drops 45 functions and links fine;
            #     every one of them is either dead or an extern libc/runtime name. Making an
            #     unreferenced drop fatal would refuse to compile this compiler.
            #   * MINUS the runtime-provided names, which the linked runtime object supplies
            #     by design (see name_is_runtime_provided).
            for dangling_index in 0..<dangling.count |dangling|:
                dangling_handle: LLVMValueRef = dangling[dangling_index]
                continue if LLVMGetFirstBasicBlock(dangling_handle) is dangling_revived
                return -1 if declined_function_has_live_use(dangling_handle)
            # Finalize AFTER the bodies: the declares added during emission must exist
            # before the metadata is resolved. Creation itself ran BEFORE them (below the
            # declare pass), so each alloca had its subprogram to hang a variable off.
            if want_debug and runtime.debug_active:
                if runtime.debug_builder is active_debug_builder:
                    LLVMDIBuilderFinalize(active_debug_builder)
            remove_external_noalias_parameter_attributes(m) if structs.target.noalias_mutable_refs
            remove_external_disjoint_scope_metadata(m, ctx) if structs.target.noalias_mutable_refs
            apply_requested_frame_pointers(m, ctx)
            return emitted_count


        def emit_module_with_debug_trace(file: Ast::File&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef, target_data: LLVMTargetDataRef, want_debug: bool, want_trace: bool, source_name: sview, checked_contracts: bool) -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                return emit_module_core(file, m, ctx, builder, target_data, want_debug, want_trace, source_name, false, checked_contracts) can Global{Read,Write}

        def emit_module_with_debug(file: Ast::File&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef, target_data: LLVMTargetDataRef, want_debug: bool, source_name: sview) -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                return emit_module_with_debug_trace(file, m, ctx, builder, target_data, want_debug, false, source_name, true) can Global{Read,Write}

            # The original entry point, unchanged for every caller that does not want debug info.
        def emit_module(file: Ast::File&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef, target_data: LLVMTargetDataRef) -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                return emit_module_with_debug(file, m, ctx, builder, target_data, false, "") can Global{Read,Write}


        # A test unit is a library-shaped source file: its @test functions are called by a
        # host dispatch shim, so it has no source-level `main`. Ordinary object emission
        # intentionally strips test functions from such a library, matching stage0. The
        # `-emit test` driver is nevertheless a PROGRAM build for linkage purposes and must
        # retain those functions. Keep that distinction explicit at the backend boundary
        # instead of making the driver synthesize a fake AST declaration.
        def emit_module_for_tests(file: Ast::File&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef, target_data: LLVMTargetDataRef) -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                return emit_module_core(file, m, ctx, builder, target_data, false, false, "", true, true) can Global{Read,Write}


            # Lower the verified EASM surface into LLVM inline assembly.  Stage0 does this in
            # llvm_easm.go after the project loader has collected `.easm` modules; keeping this
            # entry point separate from emit_module is deliberate because EASM functions are
            # declarations with machine-level contracts, not Elisa AST declarations.
        def easm_llvm_scalar_type(name: sview, ctx: LLVMContextRef, target_bits: u32) -> LLVMTypeRef:
            # EASM address-space carriers and opaque host callable handles are pointers at
            # the ABI boundary; their layout/permission meaning was already checked by the
            # EASM verifier.
            return LLVMPointerTypeInContext(ctx, 0) if name == "cstr" or name == "HostCallable" or name == "HostFsSelector" or Easm::easm_starts(name, "HostPtr[") or Easm::easm_starts(name, "GuestVAddr[") or Easm::easm_starts(name, "NativeMappedGuestPtr[")
            return when name:
                "void" -> LLVMVoidTypeInContext(ctx)
                "bool" -> LLVMInt1TypeInContext(ctx)
                "i8" | "u8" -> LLVMInt8TypeInContext(ctx)
                "i16" | "u16" -> LLVMInt16TypeInContext(ctx)
                "i32" | "u32" -> LLVMInt32TypeInContext(ctx)
                "int" | "isize" | "usize" | "uintptr" -> LLVMIntTypeInContext(ctx, target_bits)
                "i64" | "u64" -> LLVMInt64TypeInContext(ctx)
                "f32" -> LLVMFloatTypeInContext(ctx)
                "f64" -> LLVMDoubleTypeInContext(ctx)
                _ -> LLVMInt64TypeInContext(ctx)


        def easm_append_constraint(out: mutable darray[u8]&, value: sview) -> void can[Abort.Panic, Memory.Allocate]:
            if out.count > 0:
                out.push(44)
            for index in 0..<value.len |out, value|:
                out.push(value[index])


        def easm_append_clobber(out: mutable darray[u8]&, value: sview) -> void can[Abort.Panic, Memory.Allocate]:
            if out.count > 0:
                out.push(44)
            out.push(126)
            out.push(123)
            for index in 0..<value.len |out, value|:
                out.push(value[index])
            out.push(125)

include "./codegen_module_easm.elisa"
