# Stage1 backend — the prefix blocks that BIND or RELEASE something: `destroy NAME`,
# `expect … as …`, `let`, `move`, `with`, and the named `region NAME:` scope whose exit frees
# the arena. codegen_stmt_blocks_exprs.elisa tries the effect-only prefixes (`defer`, `lock`,
# `static`, `in`, `trusted`, `pool`) first and calls in here for the rest; `matched` says
# every block reaches an answer here — the run ends in the named-region scope, which always
# returns — so this is a plain tail call rather than another `matched` hop.
# Part of `module Backend` (see codegen.elisa).

extend Backend:
    private:
        def emit_statement_binding_blocks(block_kind: sview, block_clause: darray[sview]&, block_binding: sview, block_body: darray[Stmt]&, block_line: Ast::Pos, return_type: ValueType, local_scope: mutable Scope&, loops: mutable LoopStack&, regions: mutable RegionStack&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> EmitStatus can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            # The declining answer, named the way the caller's own branches name it.
            declined_status: EmitStatus = EmitStatus.Declined
            # `destroy NAME` — explicitly free a named region NOW. arena_free nulls the
            # Arena's begin/end, so the function-end / return-path unwind that also sees
            # this slot becomes a no-op rather than a double free.
            if block_kind == "destroy":
                declined_status return if block_clause.count != 1
                destroy_type: ValueType = lookup_type(local_scope, block_clause[0])
                declined_status return if destroy_type.kind != TypeKind.Arena
                if lookup_slot(local_scope, block_clause[0]) is destroy_slot:
                    destroy_args: mutable darray[LLVMValueRef] = [destroy_slot]
                    destroy_args_pointer: void& = (&destroy_args[0]).cast[void&] can Unsafe.PointerCast
                    _ = LLVMBuildCall2(builder, runtime.arena_free_type, runtime.arena_free, destroy_args_pointer, 1, "")
                    return EmitStatus.Open
                return declined_status
            # `move pair as Pair(left, right)` — a DESTRUCTURING move. The parser lowers
            # it to Block("move", …) wrapping a Match whose arms have EMPTY bodies, plus
            # one uninitialized VarDecl per binder; the block kind was never handled, so
            # every use declined.
            #
            # stage0 lowers it as a plain per-field extract into fresh locals (read from
            # its -emit llvm: `extractvalue %Pair, 0` -> `store ... ptr %left`). The
            # arms carry no runtime test because the scrutinee's STATIC type already
            # names the struct -- there is no discriminant, so this binds the fields and
            # falls through, exactly as the `is Point{x, y}` destructure does.
            #
            # SOUND SUBSET: a STRUCT scrutinee whose pattern fields are all bare
            # positional Bindings, which is the form the corpus uses. A named-field
            # (`Pair{left: a}`), nested, or literal subpattern declines rather than
            # binding a guessed position.
            # `let {a, b} = value` — the parser lowers it to a one-arm match plus one bare
            # `VarDecl(name, Invalid, Absent)` per binder (whose only job is to make the
            # name visible after the block). The bindings must land in the ENCLOSING scope,
            # so the block is emitted here rather than descended into: a scoped emit would
            # drop them at the closing brace.
            # `expect VALUE as PATTERN` (the no-block spelling) lowers to
            # Block("expect", …) wrapping a one-arm match plus a panic arm, followed by one
            # bare `VarDecl(name, Invalid, Absent)` per binder. The block kind was never
            # handled, so EVERY `expect` statement declined — down to `expect x as 1`.
            # Emit the match in the ENCLOSING scope; a BINDING form still declines, since
            # those trailing declarations carry no type to allocate from.
            if block_kind == "expect":
                # A trailing `VarDecl(name, Invalid, Absent)` exists only to make a binder
                # visible after the block, and carries no type to allocate from — so a
                # BINDING shape declines. A `_` is not a binder: the parser records one for
                # a wildcard, and dropping it is what lets `expect s as E.V(_, 5)` through.
                expect_has_binder: mutable bool = false
                expect_kept: mutable darray[Stmt] = []
                for expect_member in block_body |expect_has_binder, expect_kept|:
                    expect_is_declaration: mutable bool = false
                    match expect_member:
                        Stmt.VarDecl(expect_binder_name, expect_binder_type, expect_binder_value, expect_binder_line):
                            expect_is_declaration <- true
                            expect_has_binder <- true if expect_binder_name != "_"
                        _:
                            pass
                    expect_kept.push(expect_member) if not expect_is_declaration
                declined_status return if expect_has_binder
                # An ANONYMOUS brace pattern (`expect block as {stmts: [1, 2, ...]}`) names
                # no type; the SCRUTINEE's own struct supplies it. Done HERE and not in the
                # match emitter on purpose: stage0 accepts the unnamed brace form only after
                # `expect ... as`, and REJECTS it as a `match` arm, so naming it in the
                # shared emitter would make stage1 accept a program stage0 refuses.
                expect_body: mutable darray[Stmt] = []
                for expect_statement in expect_kept |expect_body, local_scope, fns, structs, generics|:
                    expect_rewritten: mutable Stmt = expect_statement
                    match expect_statement:
                        Stmt.Match(expect_scrutinee, expect_arms, expect_match_line):
                            expect_owner: ValueType = expression_type(expect_scrutinee, local_scope, fns, structs, generics)
                            if expect_owner.kind == TypeKind.Struct and expect_arms.count > 0:
                                if expect_arms[0].pattern is Pattern.Struct(expect_path, expect_fields):
                                    if expect_path == "":
                                        expect_named_arms: mutable darray[MatchArm] = [MatchArm{pattern: (Pattern.Struct(structs.names[expect_owner.bits.usize()], expect_fields)), body: expect_arms[0].body, guard: expect_arms[0].guard}]
                                        for expect_tail in 1..<expect_arms.count |expect_named_arms, expect_arms|:
                                            expect_named_arms.push(expect_arms[expect_tail])
                                        expect_rewritten <- (Stmt.Match(expect_scrutinee, expect_named_arms, expect_match_line))
                        _:
                            pass
                    expect_body.push(expect_rewritten)
                # Built as an `if TEST: … else: …` rather than left to the match emitter:
                # that emitter deliberately declines a struct pattern carrying a LITERAL
                # field test, because stage0 rejects that spelling as a match ARM. After
                # `expect … as` stage0 accepts it, so the test is assembled here.
                expect_lowered: mutable darray[Stmt] = []
                for expect_final in expect_body |expect_lowered, structs|:
                    expect_direct: mutable Stmt = expect_final
                    match expect_final:
                        Stmt.Match(expect_test_scrutinee, expect_test_arms, expect_test_line):
                            expect_is_struct_shape: mutable bool = false
                            if expect_test_arms.count > 0 and expect_test_arms[0].pattern is Pattern.Struct(expect_shape_path, expect_shape_fields):
                                expect_is_struct_shape <- true
                            # `expect stmt as Stmt.While(_, {stmts: [1, 2, ...]})` — a VARIANT
                            # shape with POSITIONAL payload sub-patterns. No expression reads
                            # payload field N, so the tag test BINDS every position to a
                            # synthetic name and the sub-shapes are tested against those names.
                            # A labelled spelling (`Block(tag: 1)`) is a struct pattern wearing
                            # parentheses, not this, and is left alone — binding it by position
                            # would cross the fields.
                            if expect_test_arms.count == 2 and is_catch_all_pattern(expect_test_arms[1].pattern) and expect_test_arms[0].pattern is Pattern.Variant(expect_variant_path, expect_variant_fields):
                                expect_positional: mutable bool = expect_variant_fields.count > 0
                                for expect_probe in expect_variant_fields |expect_positional|:
                                    if expect_probe is Pattern.Field(expect_probe_selector, expect_probe_inner):
                                        expect_positional <- false
                                if expect_positional:
                                    expect_binders: mutable darray[Expr] = []
                                    expect_payload_ok: mutable bool = true
                                    expect_payload_test: mutable Expr = (Expr.BoolLit(true))
                                    for expect_position in 0..<expect_variant_fields.count |expect_binders, expect_payload_ok, expect_payload_test, expect_variant_fields, expect_test_line, structs|:
                                        expect_binder_name: sview = expect_payload_binder_name(expect_position)
                                        if expect_binder_name == "":
                                            expect_payload_ok <- false
                                        else:
                                            expect_binders.push((Expr.Ident(expect_binder_name, expect_test_line)))
                                            if expect_shape_test((Expr.Ident(expect_binder_name, expect_test_line)), expect_variant_fields[expect_position], structs, expect_test_line.line) is expect_part:
                                                expect_payload_test <- (Expr.Binary(expect_payload_test, TokenKind.And, expect_part, expect_test_line))
                                            else:
                                                expect_payload_ok <- false
                                    # The `is` emitter reads the variant head as
                                    # `Expr.Field(Ident(Enum), Variant)`; a single Ident holding
                                    # the dotted text does not match it. The two names come from
                                    # the registered tables because the path cannot be sliced
                                    # here.
                                    expect_enum_index: i64 = penum_enum_of_path(expect_variant_path, structs)
                                    expect_variant_slot: i64 = penum_slot_of_path(expect_variant_path, structs)
                                    expect_payload_ok <- false if expect_enum_index < 0 or expect_variant_slot < 0
                                    if expect_payload_ok:
                                        expect_head: Expr = (Expr.Field((Expr.Ident(structs.penum_names[expect_enum_index.usize()], expect_test_line)), structs.penum_variants[expect_variant_slot.usize()], expect_test_line))
                                        expect_tag_test: Expr = (Expr.Binary(expect_test_scrutinee, TokenKind.Is, (Expr.Call(expect_head, expect_binders, [], expect_test_line)), expect_test_line))
                                        expect_inner_if: darray[Stmt] = [(Stmt.If(expect_payload_test, expect_test_arms[0].body, expect_test_arms[1].body, expect_test_line))]
                                        expect_direct <- (Stmt.If(expect_tag_test, expect_inner_if, expect_test_arms[1].body, expect_test_line))
                            if expect_test_arms.count > 0 and expect_test_arms[0].pattern is Pattern.Tuple(expect_list_elements):
                                expect_is_struct_shape <- true
                            if expect_is_struct_shape and expect_test_arms.count == 2 and is_catch_all_pattern(expect_test_arms[1].pattern):
                                if expect_shape_test(expect_test_scrutinee, expect_test_arms[0].pattern, structs, expect_test_line.line) is expect_shape:
                                    expect_direct <- (Stmt.If(expect_shape, expect_test_arms[0].body, expect_test_arms[1].body, expect_test_line))
                        _:
                            pass
                    expect_lowered.push(expect_direct)
                return emit_statements(expect_lowered, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)
            if block_kind == "let":
                declined_status return if block_body.count == 0
                match block_body[0]:
                    Stmt.Match(lt_scrutinee, lt_arms, lt_match_line):
                        declined_status return if lt_arms.count == 0
                        lt_fields: mutable darray[Pattern] = []
                        match lt_arms[0].pattern:
                            Pattern.Struct(_, lt_struct_fields):
                                lt_fields.extend([lt_field for lt_field in lt_struct_fields])
                            _:
                                pass
                        declined_status return if lt_fields.count == 0
                        # A `layout(soa)` ROW binder: each shorthand field names its own column.
                        match lt_scrutinee:
                            Expr.Ident(lt_row_name, lt_row_name_line):
                                lt_row: i64 = soa_row_binder_index_of(structs, lt_row_name)
                                if lt_row >= 0:
                                    lt_declined: mutable bool = false
                                    for lt_field in lt_fields |lt_declined, lt_row, local_scope, structs, ctx, builder|:
                                        lt_bound: mutable sview = ""
                                        lt_column: mutable sview = ""
                                        match lt_field:
                                            Pattern.Binding(lt_shorthand):
                                                lt_bound <- lt_shorthand
                                                lt_column <- lt_shorthand
                                            Pattern.Field(lt_selector, lt_inner):
                                                lt_column <- lt_selector
                                                if lt_inner.count == 1:
                                                    match lt_inner[0]:
                                                        Pattern.Binding(lt_sub):
                                                            lt_bound <- lt_sub
                                                        _:
                                                            pass
                                            _:
                                                pass
                                        if lt_bound == "" or lt_column == "":
                                            lt_declined <- true
                                        else:
                                            lt_type: ValueType = soa_binder_element_type(lt_row.usize(), lt_column, structs)
                                            if lt_type.kind == TypeKind.Unmodeled:
                                                lt_declined <- true
                                            elif soa_binder_element_address(lt_row.usize(), lt_column, structs, ctx, builder) is lt_address:
                                                lt_llvm: LLVMTypeRef = llvm_type_of(lt_type, structs, ctx)
                                                lt_storage: mutable darray[u8] = []
                                                lt_slot: LLVMValueRef = LLVMBuildAlloca(builder, lt_llvm, sview_to_cstr(lt_bound, lt_storage))
                                                _ = LLVMBuildStore(builder, LLVMBuildLoad2(builder, lt_llvm, lt_address, "soa.let.value"), lt_slot)
                                                declare_local(local_scope, lt_bound, lt_slot, lt_type)
                                            else:
                                                lt_declined <- true
                                    declined_status return if lt_declined
                                    return EmitStatus.Open
                            _:
                                pass
                        # A PLAIN STRUCT scrutinee. Fields are matched by NAME, not position,
                        # so both spellings work: `{left, right}` (shorthand — the binder name
                        # IS the field name) and `{left: base_left}` (an explicit selector with
                        # a renamed binder). stage0 emits one `extractvalue` per binder into
                        # its own alloca, which is exactly what this builds.
                        lt_value_type: ValueType = expression_type(lt_scrutinee, local_scope, fns, structs, generics)
                        declined_status return if lt_value_type.kind != TypeKind.Struct
                        lt_owner: usize = lt_value_type.bits.usize()
                        if emit_expression(lt_scrutinee, lt_value_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is lt_struct_value:
                            lt_struct_declined: mutable bool = false
                            for lt_member in lt_fields |lt_struct_declined, lt_owner, lt_struct_value, local_scope, structs, ctx, builder|:
                                lt_binder: mutable sview = ""
                                lt_selector: mutable sview = ""
                                match lt_member:
                                    Pattern.Binding(lt_plain):
                                        lt_binder <- lt_plain
                                        lt_selector <- lt_plain
                                    Pattern.Field(lt_named, lt_named_inner):
                                        lt_selector <- lt_named
                                        if lt_named_inner.count == 1:
                                            match lt_named_inner[0]:
                                                Pattern.Binding(lt_renamed):
                                                    lt_binder <- lt_renamed
                                                _:
                                                    pass
                                    _:
                                        pass
                                lt_position: mutable i64 = -1
                                lt_position <- field_index_of(structs, lt_owner, lt_selector) if lt_selector != ""
                                if lt_binder == "" or lt_position < 0:
                                    lt_struct_declined <- true
                                else:
                                    lt_member_type: ValueType = structs.field_types[structs.field_start[lt_owner] + lt_position.usize()]
                                    lt_member_storage: mutable darray[u8] = []
                                    lt_member_slot: LLVMValueRef = LLVMBuildAlloca(builder, llvm_type_of(lt_member_type, structs, ctx), sview_to_cstr(lt_binder, lt_member_storage))
                                    _ = LLVMBuildStore(builder, LLVMBuildExtractValue(builder, lt_struct_value, lt_position.u32(), "let.field"), lt_member_slot)
                                    declare_local(local_scope, lt_binder, lt_member_slot, lt_member_type)
                            declined_status return if lt_struct_declined
                            return EmitStatus.Open
                    _:
                        pass
                return declined_status
            if block_kind == "move":
                declined_status return if block_body.count == 0
                match block_body[0]:
                    Stmt.Match(mv_scrutinee, mv_arms, mv_match_line):
                        declined_status return if mv_arms.count == 0
                        mv_pattern: Pattern = mv_arms[0].pattern
                        mv_fields: mutable darray[Pattern] = []
                        match mv_pattern:
                            Pattern.Variant(_, mv_variant_fields):
                                mv_fields.extend([mv_field for mv_field in mv_variant_fields])
                            Pattern.Struct(_, mv_struct_fields):
                                mv_fields.extend([mv_field for mv_field in mv_struct_fields])
                            _:
                                pass
                        declined_status return if mv_fields.count == 0
                        mv_type: ValueType = expression_type(mv_scrutinee, local_scope, fns, structs, generics)
                        declined_status return if mv_type.kind != TypeKind.Struct
                        mv_slot_index: usize = mv_type.bits.usize()
                        declined_status return if mv_fields.count > structs.field_count[mv_slot_index]
                        if emit_expression(mv_scrutinee, mv_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is mv_value:
                            mv_declined: mutable bool = false
                            mv_position: mutable u32 = 0
                            for mv_field in mv_fields |mv_declined, mv_position, mv_slot_index, mv_value, local_scope, structs, ctx, builder|:
                                mv_name: mutable sview = ""
                                match mv_field:
                                    Pattern.Binding(mv_binding_name):
                                        mv_name <- mv_binding_name
                                    _:
                                        pass
                                if mv_name == "":
                                    mv_declined <- true
                                else:
                                    mv_field_type: ValueType = structs.field_types[structs.field_start[mv_slot_index] + mv_position.usize()]
                                    mv_storage: mutable darray[u8] = []
                                    mv_local_slot: LLVMValueRef = LLVMBuildAlloca(builder, llvm_type_of(mv_field_type, structs, ctx), sview_to_cstr(mv_name, mv_storage))
                                    _ = LLVMBuildStore(builder, LLVMBuildExtractValue(builder, mv_value, mv_position, "move.as.field"), mv_local_slot)
                                    declare_local(local_scope, mv_name, mv_local_slot, mv_field_type)
                                mv_position <- mv_position + 1
                            declined_status return if mv_declined
                            return EmitStatus.Open
                    _:
                        pass
                return declined_status
            # `with arena scratch(4096) as owner:` — a SCOPED ALLOCATOR block. It is the
            # region block in different clothes: an owned arena of the given capacity, live
            # for the body, freed at scope end. Rewritten into the region form rather than
            # duplicating ~50 lines of arena setup, unwind bookkeeping and frame tracking.
            #
            # The clause holds the head words (`arena`, the name) plus the captured
            # capacity; the `as` binding, when present, is the name the body uses. Both
            # names denote the same arena, so the binding wins when it is there.
            if block_kind == "with":
                with_capacity: mutable sview = ""
                with_name: mutable sview = ""
                for with_word in block_clause |with_capacity, with_name|:
                    with_probe: mutable i64 = 0
                    if parse_int_literal(with_word, with_probe):
                        with_capacity <- with_word
                    else:
                        with_name <- with_word if with_word != "arena"
                with_name <- block_binding if block_binding != ""
                declined_status return if with_name == "" or with_capacity == ""
                with_clause: mutable darray[sview] = [with_name, with_capacity]
                return emit_statement((Stmt.Block("region", with_clause, "", [entry for entry in block_body], block_line)), return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)
            declined_status return if block_kind != "region"
            # STATEMENT form: `region r(4096)` with no colon — the parser gives the NAME
            # in the BINDING slot, an EMPTY body, and only the optional strategy in the
            # clause (the capacity expression is consumed and dropped). The region is a
            # named Arena local that lives to scope end: `@r`-annotated locals allocate
            # from it and `destroy r` frees it early. NO scoped free: the return-path
            # unwind owns it via the regions stack, and arena_free on a destroyed
            # (nulled) arena is a no-op.
            #
            # An explicit capacity takes its backing UP FRONT, the same as the block
            # form below — stage0 emits `new_region_backend(N, 0)` for BOTH spellings.
            # Treating the capacity as a droppable allocation-strategy detail left the
            # arena with no backing store at all.
            if block_binding != "" and block_body.count == 0:
                stmt_region_arena_type: LLVMTypeRef = arena_llvm_type(ctx)
                stmt_region_storage: mutable darray[u8] = []
                stmt_region_slot: LLVMValueRef = LLVMBuildAlloca(builder, stmt_region_arena_type, sview_to_cstr(block_binding, stmt_region_storage))
                _ = LLVMBuildStore(builder, LLVMConstNull(stmt_region_arena_type), stmt_region_slot)
                # The clause carries the optional strategy name and the optional captured
                # capacity in either order, so it is SCANNED for an integer rather than
                # indexed — the same shape the `with` form above resolves.
                stmt_region_capacity: mutable i64 = 0
                for stmt_region_word in block_clause |stmt_region_capacity|:
                    stmt_region_probe: mutable i64 = 0
                    stmt_region_capacity <- stmt_region_probe if parse_int_literal(stmt_region_word, stmt_region_probe) and stmt_region_probe > 0
                if stmt_region_capacity > 0:
                    stmt_region_capacity_value: LLVMValueRef = LLVMConstInt(runtime_size_llvm_type(ctx), stmt_region_capacity.u64(), 0)
                    stmt_region_backing_args: mutable darray[LLVMValueRef] = [stmt_region_capacity_value, LLVMConstInt(LLVMInt64TypeInContext(ctx), 0, 0)]
                    stmt_region_backing_pointer: void& = (&stmt_region_backing_args[0]).cast[void&] can Unsafe.PointerCast
                    stmt_region_backing: LLVMValueRef = LLVMBuildCall2(builder, runtime.new_region_backend_type, runtime.new_region_backend, stmt_region_backing_pointer, 2, "region.init")
                    stmt_region_begin: LLVMValueRef = LLVMBuildStructGEP2(builder, stmt_region_arena_type, stmt_region_slot, 0, "region.begin")
                    stmt_region_end: LLVMValueRef = LLVMBuildStructGEP2(builder, stmt_region_arena_type, stmt_region_slot, 1, "region.end")
                    _ = LLVMBuildStore(builder, stmt_region_backing, stmt_region_begin)
                    _ = LLVMBuildStore(builder, stmt_region_backing, stmt_region_end)
                else:
                    stmt_region_strategy: LLVMValueRef = LLVMBuildStructGEP2(builder, stmt_region_arena_type, stmt_region_slot, 3, "region.strategy")
                    _ = LLVMBuildStore(builder, LLVMConstInt(LLVMInt64TypeInContext(ctx), 0, 0), stmt_region_strategy)
                declare_local(local_scope, block_binding, stmt_region_slot, ValueType{kind: TypeKind.Arena, bits: 0})
                regions.arenas.push(stmt_region_slot)
                return EmitStatus.Open
            # `region r:` gives clause ["r"]; `region r(4096):` gives ["r", "4096"] —
            # the parser captures the capacity as a span of the SOURCE text, so it is
            # parsed back out here rather than being an Expr.
            declined_status return if block_clause.count != 1 and block_clause.count != 2
            region_capacity: mutable i64 = 0
            if block_clause.count == 2:
                declined_status return if not parse_int_literal(block_clause[1], region_capacity)
                # A non-positive capacity is not a region stage0 would build.
                declined_status return if region_capacity <= 0
            scoped_runtime: mutable Runtime = copied_runtime(runtime)
            scoped_arena_type: LLVMTypeRef = arena_llvm_type(ctx)
            scoped_name_storage: mutable darray[u8] = []
            scoped_slot: LLVMValueRef = LLVMBuildAlloca(builder, scoped_arena_type, sview_to_cstr(block_clause[0], scoped_name_storage))
            _ = LLVMBuildStore(builder, LLVMConstNull(scoped_arena_type), scoped_slot)
            if region_capacity > 0:
                # An explicit capacity takes its backing UP FRONT from the runtime, and
                # `begin` and `end` both start at it (stage0's shape). The lazy strategy
                # word stays 0: the backing already exists, so there is nothing to
                # allocate on first use.
                region_capacity_value: LLVMValueRef = LLVMConstInt(runtime_size_llvm_type(ctx), region_capacity.u64(), 0)
                region_backing_args: mutable darray[LLVMValueRef] = [region_capacity_value, LLVMConstInt(LLVMInt64TypeInContext(ctx), 0, 0)]
                region_backing_pointer: void& = (&region_backing_args[0]).cast[void&] can Unsafe.PointerCast
                region_backing: LLVMValueRef = LLVMBuildCall2(builder, scoped_runtime.new_region_backend_type, scoped_runtime.new_region_backend, region_backing_pointer, 2, "region.init")
                region_begin: LLVMValueRef = LLVMBuildStructGEP2(builder, scoped_arena_type, scoped_slot, 0, "region.begin")
                region_end: LLVMValueRef = LLVMBuildStructGEP2(builder, scoped_arena_type, scoped_slot, 1, "region.end")
                _ = LLVMBuildStore(builder, region_backing, region_begin)
                _ = LLVMBuildStore(builder, region_backing, region_end)
            else:
                scoped_strategy: LLVMValueRef = LLVMBuildStructGEP2(builder, scoped_arena_type, scoped_slot, 3, "region.strategy")
                _ = LLVMBuildStore(builder, LLVMConstInt(LLVMInt64TypeInContext(ctx), 0, 0), scoped_strategy)
            scoped_runtime.arena <- scoped_slot
            # The region's NAME is a value in scope: `region r(4096): return build(r)`
            # passes it as an Arena. Binding it here means the ordinary Ident path emits
            # the `load %Arena, ptr %r` the call site needs -- no special case.
            declare_local(local_scope, block_clause[0], scoped_slot, ValueType{kind: TypeKind.Arena, bits: 0})
            # The block OWNS this region: unlike a threaded arena, it must be freed when
            # the scope ends.
            scoped_runtime.owns_arena <- true
            # Live for the block's duration, so a `return` inside unwinds it along with
            # every enclosing region -- innermost first, which is the order stage0 emits.
            regions.arenas.push(scoped_slot)
            # Record the frame so growth sites can tell a block-local container from one
            # declared outside (see growth_arena_for): outside ones keep growing from
            # the arena they were declared under, not from this region.
            local_scope.region_frame_starts <- local_scope.region_frame_starts.push(local_scope.names.count)
            local_scope.region_frame_arenas <- local_scope.region_frame_arenas.push(scoped_slot)
            local_scope.region_frame_outers <- local_scope.region_frame_outers.push(runtime.arena)
            # A `defer block:` inside the region runs at the region's end, BEFORE the
            # statement that follows — emit_statements owns that.
            scoped_status: EmitStatus = emit_statements(block_body, return_type, local_scope, loops, regions, fns, structs, generics, scoped_runtime, m, ctx, builder)
            local_scope.region_frame_starts <- local_scope.region_frame_starts.truncate(local_scope.region_frame_starts.count - 1)
            local_scope.region_frame_arenas <- local_scope.region_frame_arenas.truncate(local_scope.region_frame_arenas.count - 1)
            local_scope.region_frame_outers <- local_scope.region_frame_outers.truncate(local_scope.region_frame_outers.count - 1)
            _ = regions.arenas.pop()
            declined_status return if scoped_status == EmitStatus.Declined
            # A body that RETURNED already unwound this region on its way out; emitting
            # the free here too would double-free it, and would follow a terminator.
            scoped_status return if scoped_status == EmitStatus.Terminated
            emit_region_free(scoped_runtime, builder)
            return scoped_status
