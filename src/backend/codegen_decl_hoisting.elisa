# Stage1 backend — the EFFECTIVE top-level declarations: nested modules and `impl` bodies
# hoisted out of their scopes, plus the mangled symbol an impl member or a named constructor
# is emitted under. Part of `module Backend` (see codegen.elisa).

extend Backend:
    private:


        # The EFFECTIVE top-level declarations: `file.top_decls` with each `Decl.Scoped`
        # (one `static if` branch body) replaced by its contents when the branch is taken,
        # and dropped when it is not. Every later pass iterates this instead of
        # `file.top_decls`, so branch selection is decided in ONE place rather than being
        # re-derived (inconsistently) by each of the nine passes.
        #
        # Recursive: `static if` blocks nest (arena.elisa selects a backend, then selects
        # again on the chosen backend's constant).
        # `Decl.Scoped` is NOT exclusively a static-if branch -- an `impl` block produces one
        # too (parser_decl.elisa:420). Dropping a Scoped merely because it is not in
        # `taken_lines` would silently delete every impl in the program, so a Scoped whose
        # line is not a static-if branch line at all is inlined UNCONDITIONALLY. Only a
        # genuine branch (its line appears in `branch_lines`) is subject to selection.
        # Record which functions came from an `impl I for C:` block, BEFORE
        # flatten_static_branches inlines the Scoped body into the top-level list and the
        # association is gone. stage0 names these `__impl__I__C__method`; stage1 emitted the
        # bare method name, so `_make` appeared where stage0 exports
        # `___impl__Builder__BuilderTag__make`.
        #
        # Keyed by the METHOD's own line (unique per declaration) rather than by name, so two
        # impls providing the same method name stay distinct.
        def record_impl_member_lines(decls: darray[Decl]&, annotations: darray[Ast::EnumAnnotation]&, structs: mutable StructTable&) -> void can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic, Memory.Allocate:
                for declaration in decls |annotations, structs|:
                    # A `module M:` body is walked too. register_const already descends here
                    # (codegen_module) and this pass did not, so an `impl P for T:` written
                    # inside a module recorded no members and its methods got the PLAIN
                    # symbol instead of `__impl__P__T__m`.
                    #
                    # This is only half the fix: declare_module_functions must also descend
                    # into the impl block, or the members are never declared at all. Landing
                    # either half alone changes nothing observable, which is why this one
                    # looked useless on its own.
                    if declaration_is_module(declaration):
                        nested: mutable darray[Decl] = []
                        for nested_index in 0..<declaration_module_count(declaration) |nested, declaration|:
                            nested.push(declaration_module_at(declaration, nested_index))
                        record_impl_member_lines(nested, annotations, structs)
                        continue
                    if declaration is Decl.Scoped(scoped_body, scoped_line):
                        impl_interface: mutable sview = ""
                        impl_concrete: mutable sview = ""
                        extension_receiver: mutable sview = ""
                        for annotation in annotations |impl_interface, impl_concrete, extension_receiver, scoped_line|:
                            impl_interface <- annotation.name if annotation.owner == "__impl_scope" and annotation.line == scoped_line.line
                            impl_concrete <- annotation.name if annotation.owner == "__impl_concrete" and annotation.line == scoped_line.line
                            extension_receiver <- annotation.name if annotation.owner == "__ext_concrete" and annotation.line == scoped_line.line
                        # An EXTENSION impl (`impl C:`) has a receiver but no interface. The
                        # empty interface is what tells impl_member_symbol to build the
                        # `__ext__` spelling instead of `__impl__`.
                        if extension_receiver != "" and impl_concrete == "":
                            for extension_member in scoped_body |structs, extension_receiver|:
                                extension_name: sview = function_name_of(extension_member)
                                continue if extension_name == ""
                                structs.impl_member_lines <- structs.impl_member_lines.push(function_line_of(extension_member))
                                structs.impl_member_ifaces <- structs.impl_member_ifaces.push("")
                                structs.impl_member_types <- structs.impl_member_types.push(extension_receiver)
                        if impl_interface != "" and impl_concrete != "":
                            for member in scoped_body |structs, impl_interface, impl_concrete|:
                                member_name: sview = function_name_of(member)
                                continue if member_name == ""
                                structs.impl_member_lines <- structs.impl_member_lines.push(function_line_of(member))
                                structs.impl_member_ifaces <- structs.impl_member_ifaces.push(impl_interface)
                                structs.impl_member_types <- structs.impl_member_types.push(impl_concrete)
                        record_impl_member_lines(scoped_body, annotations, structs)




        # A module nested in another module's BODY carries the qualified name `Outer::Inner`
        # from the parser, but every module walk in the backend visits ONE nesting level.
        # Hoist nested modules to the top level (after their parent, recursively) so they are
        # declared and emitted exactly like a verbatim `module Outer::Inner:`.
        def module_without_nested_modules(declaration: Decl) -> Decl can[Abort.Panic, Memory.Allocate]:
            match declaration:
                Decl.Module(module_name, module_body, module_pos):
                    kept: mutable darray[Decl] = []
                    for member in module_body |kept|:
                        kept.push(member) if not declaration_is_module(member)
                    return Decl.Module(module_name, kept, module_pos)
                _:
                    return declaration




        def hoist_nested_children(declaration: Decl, out: mutable darray[Decl]&) -> void can[Abort.Panic, Memory.Allocate]:
            for index in 0..<declaration_module_count(declaration) |out, declaration|:
                member: Decl = declaration_module_at(declaration, index)
                continue if not declaration_is_module(member)
                out.push(module_without_nested_modules(member))
                hoist_nested_children(member, out)




        def hoist_nested_modules(decls: darray[Decl]&, out: mutable darray[Decl]&) -> void can[Abort.Panic, Memory.Allocate]:
            for declaration in decls |out|:
                if declaration_is_module(declaration):
                    out.push(module_without_nested_modules(declaration))
                    hoist_nested_children(declaration, out)
                else:
                    out.push(declaration)


    public:
        # `__impl__I__C__method` for a function declared inside `impl I for C:`, or "" for an
        # ordinary function. Keyed by the method's own LINE so two impls providing the same
        # method name stay distinct.
        def impl_member_symbol(structs: StructTable&, name: sview, line: u32, storage: mutable darray[u8]&) -> bool can[Abort.Panic, Memory.Allocate]:
            for index in 0..<structs.impl_member_lines.count |structs, line, name, storage|:
                continue if structs.impl_member_lines[index] != line
                iface: sview = structs.impl_member_ifaces[index]
                # `__impl__I__C__m` for a protocol impl; `__ext__m__C__m` for an extension
                # impl, whose "interface" slot is the method's own visible name — stage0's
                # two spellings.
                prefix: sview = "__impl__" if iface != "" else "__ext__"
                for prefix_index in 0..<sview_len(prefix) |storage, prefix|:
                    storage.push(sview_at(prefix, prefix_index))
                head_name: sview = iface if iface != "" else name
                for iface_index in 0..<sview_len(head_name) |storage, head_name|:
                    storage.push(sview_at(head_name, iface_index))
                storage.push(95)
                storage.push(95)
                receiver: sview = structs.impl_member_types[index]
                for receiver_index in 0..<sview_len(receiver) |storage, receiver|:
                    storage.push(sview_at(receiver, receiver_index))
                storage.push(95)
                storage.push(95)
                for name_index in 0..<sview_len(name) |storage, name|:
                    storage.push(sview_at(name, name_index))
                return true
            return false


        # `N__for__T__L<line>_C<col>` when `N` is a NAMED CONSTRUCTOR — a function whose own
        # name is a struct and whose return type is that same struct (stage0's rule:
        # constructorDeclInitHookName). Any other function returns false.
        def constructor_symbol(structs: mutable StructTable&, name: sview, return_type: ValueType, line: u32, storage: mutable darray[u8]&) -> bool can[Abort.Panic, Memory.Allocate]:
            false return if return_type.kind != TypeKind.Struct
            false return if structs.names[return_type.bits.usize()] != name
            column: mutable u32 = 0
            found: mutable bool = false
            for index in 0..<structs.decl_line_rows.count |structs, line, column, found|:
                if structs.decl_line_rows[index] == line and not found:
                    column <- structs.decl_column_rows[index]
                    found <- true
            false return if not found
            for name_index in 0..<sview_len(name) |storage, name|:
                storage.push(sview_at(name, name_index))
            for tag_index in 0..<sview_len("__for__") |storage|:
                storage.push(sview_at("__for__", tag_index))
            for type_index in 0..<sview_len(name) |storage, name|:
                storage.push(sview_at(name, type_index))
            storage.push(95)
            storage.push(95)
            storage.push(76)
            append_usize_decimal(line.usize(), storage)
            storage.push(95)
            storage.push(67)
            append_usize_decimal(column.usize(), storage)
            return true
