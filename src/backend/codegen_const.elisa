# Stage1 backend — constants and globals: folding, aggregate materialization, aliases, packed payload rows.
# Part of `module Backend` (see codegen.elisa); split out to keep each file short.

extend Backend:
    private:
        # FNV-1a 64 over a decoded key's bytes. stage0's `staticDictHashCStr`, constant for
        # constant (`compiler/src/backend/llvm_const_dict.go`): the placement of every entry in
        # a const dict depends on reproducing it EXACTLY, and a divergence here is a silently
        # wrong table rather than a decline.
        def const_dict_hash_cstr(bytes: darray[u8]&) -> u64 can[Abort.Panic]:
            hash: mutable u64 = 14695981039346656037.u64()
            for byte in bytes |hash|:
                hash <- hash ^ byte.u64()
                hash <- hash * 1099511628211.u64()
            return hash


        # stage0's `staticDictCapacity`: start at 8, double while the load factor would exceed
        # three quarters.
        def const_dict_capacity(count: usize) -> usize can[Abort.Panic]:
            0.usize() return if count == 0.usize()
            capacity: mutable usize = 8.usize()
            while count * 4.usize() > capacity * 3.usize() |capacity|:
                capacity <- capacity * 2.usize()
            return capacity


        # `const NUMBERS: dict[cstr, u8] = {"one": 1, …}` — a COMPILE-TIME dict. stage0 lays the
        # whole table out statically (`llvm_const_dict.go`) and this reproduces it exactly:
        # capacity from const_dict_capacity, `slot = hash & (capacity - 1)` with LINEAR probing,
        # buckets of `{key, value, i8 state}` where state 1 = occupied and an empty bucket
        # carries a null key and a zero value, and a header of
        # `{buckets, count, count, capacity, null}` — fields 1 AND 2 are both the entry count.
        #
        # Only cstr keys: the integer-key hash is a different function (splitmix64's finalizer)
        # and is left to decline rather than share this path approximately.
        def const_dict_global_value(entries: darray[Ast::DictEntry]&, dict_type: ValueType, top: darray[Decl]&, structs: mutable StructTable&, m: LLVMModuleRef, ctx: LLVMContextRef, dict_ok: mutable bool&) -> LLVMValueRef can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            failure: LLVMValueRef = zeroed
            dict_ok <- false
            failure return if dict_type.kind != TypeKind.Struct
            dict_base: mutable sview = ""
            dict_arg_start: mutable usize = 0
            dict_arg_count: mutable usize = 0
            failure return if not generic_struct_instantiation_of(structs, dict_type, dict_base, dict_arg_start, dict_arg_count)
            failure return if dict_base != "DynDict" or dict_arg_count != 2.usize()
            dict_key_type: ValueType = copied_type(structs.generic_struct_inst_args[dict_arg_start])
            dict_value_type: ValueType = copied_type(structs.generic_struct_inst_args[dict_arg_start + 1.usize()])
            failure return if dict_key_type.kind != TypeKind.CStr
            failure return if not is_numeric_type(dict_value_type) and dict_value_type.kind != TypeKind.Bool
            pointer_llvm: LLVMTypeRef = LLVMPointerTypeInContext(ctx, 0)
            value_llvm: LLVMTypeRef = llvm_type_of(dict_value_type, structs, ctx)
            state_llvm: LLVMTypeRef = LLVMInt8TypeInContext(ctx)
            bucket_fields: mutable darray[LLVMTypeRef] = [pointer_llvm, value_llvm, state_llvm]
            bucket_fields_pointer: void& = (&bucket_fields[0]).cast[void&] can Unsafe.PointerCast
            bucket_llvm: LLVMTypeRef = LLVMStructTypeInContext(ctx, bucket_fields_pointer, 3, 0)
            capacity: usize = const_dict_capacity(entries.count)
            i64_llvm: LLVMTypeRef = LLVMInt64TypeInContext(ctx)
            header_fields: mutable darray[LLVMValueRef] = []
            if capacity == 0.usize():
                header_fields.push(LLVMConstNull(pointer_llvm))
                header_fields.push(LLVMConstInt(i64_llvm, 0, 0))
                header_fields.push(LLVMConstInt(i64_llvm, 0, 0))
                header_fields.push(LLVMConstInt(i64_llvm, 0, 0))
                header_fields.push(LLVMConstNull(pointer_llvm))
                header_pointer0: void& = (&header_fields[0]).cast[void&] can Unsafe.PointerCast
                dict_ok <- true
                return LLVMConstNamedStruct(llvm_type_of(dict_type, structs, ctx), header_pointer0, 5)
            # Placement. `taken` mirrors stage0's `occupied` flag; the key/value indices are
            # kept per slot so the bucket array can be built in slot order afterwards.
            mask: usize = capacity - 1.usize()
            taken: mutable darray[bool] = [false for _slot in 0..<capacity]
            slot_entry: mutable darray[usize] = [0.usize() for _entry_slot in 0..<capacity]
            placement_ok: mutable bool = true
            for entry_index in 0..<entries.count |taken, slot_entry, placement_ok, entries, mask, capacity, structs|:
                continue if not placement_ok
                key_bytes: mutable darray[u8] = []
                if entries[entry_index].key is Expr.StringLit(key_text):
                    escapes_known: mutable bool = true
                    decode_string_escapes(key_text, key_bytes, escapes_known)
                    placement_ok <- false if not escapes_known
                else:
                    placement_ok <- false
                continue if not placement_ok
                slot: mutable usize = (const_dict_hash_cstr(key_bytes) & mask.u64()).usize()
                probes: mutable usize = 0
                while taken[slot] and probes < capacity |slot, probes, taken, mask|:
                    slot <- (slot + 1.usize()) & mask
                    probes <- probes + 1.usize()
                if taken[slot]:
                    placement_ok <- false
                else:
                    taken[slot] <- true
                    slot_entry[slot] <- entry_index
            failure return if not placement_ok
            # The bucket table.
            buckets: mutable darray[LLVMValueRef] = []
            bucket_ok: mutable bool = true
            for slot_index in 0..<capacity |buckets, bucket_ok, taken, slot_entry, entries, dict_value_type, bucket_llvm, pointer_llvm, value_llvm, state_llvm, top, structs, m, ctx|:
                continue if not bucket_ok
                bucket_key: mutable LLVMValueRef = LLVMConstNull(pointer_llvm)
                bucket_value: mutable LLVMValueRef = LLVMConstInt(value_llvm, 0, 0)
                bucket_state: mutable LLVMValueRef = LLVMConstInt(state_llvm, 0, 0)
                if taken[slot_index]:
                    entry: Ast::DictEntry = entries[slot_entry[slot_index]]
                    key_storage: mutable darray[u8] = []
                    if entry.key is Expr.StringLit(bucket_key_text):
                        key_cstr: cstr = decoded_literal_cstr(bucket_key_text, key_storage)
                        key_array: LLVMValueRef = LLVMConstStringInContext(ctx, key_cstr, (key_storage.count - 1.usize()).u32(), 0)
                        key_global: LLVMValueRef = LLVMAddGlobal(m, LLVMTypeOf(key_array), ".const.dict.key")
                        LLVMSetInitializer(key_global, key_array)
                        LLVMSetLinkage(key_global, 9)
                        LLVMSetGlobalConstant(key_global, 1)
                        bucket_key <- key_global
                    else:
                        bucket_ok <- false
                    entry_value_ok: mutable bool = true
                    entry_value: LLVMValueRef = const_aggregate_value(entry.value, dict_value_type, top, structs, m, ctx, entry_value_ok)
                    if entry_value_ok:
                        bucket_value <- entry_value
                    else:
                        bucket_ok <- false
                    bucket_state <- LLVMConstInt(state_llvm, 1, 0)
                continue if not bucket_ok
                slot_fields: mutable darray[LLVMValueRef] = [bucket_key, bucket_value, bucket_state]
                slot_fields_pointer: void& = (&slot_fields[0]).cast[void&] can Unsafe.PointerCast
                buckets.push(LLVMConstNamedStruct(bucket_llvm, slot_fields_pointer, 3))
            failure return if not bucket_ok
            buckets_pointer: void& = (&buckets[0]).cast[void&] can Unsafe.PointerCast
            buckets_array: LLVMValueRef = LLVMConstArray2(bucket_llvm, buckets_pointer, capacity.u64())
            buckets_global: LLVMValueRef = LLVMAddGlobal(m, LLVMArrayType(bucket_llvm, capacity.u32()), ".const.dict.buckets")
            LLVMSetInitializer(buckets_global, buckets_array)
            LLVMSetLinkage(buckets_global, 9)
            LLVMSetGlobalConstant(buckets_global, 1)
            header_fields.push(buckets_global)
            header_fields.push(LLVMConstInt(i64_llvm, entries.count.u64(), 0))
            header_fields.push(LLVMConstInt(i64_llvm, entries.count.u64(), 0))
            header_fields.push(LLVMConstInt(i64_llvm, capacity.u64(), 0))
            header_fields.push(LLVMConstNull(pointer_llvm))
            header_pointer: void& = (&header_fields[0]).cast[void&] can Unsafe.PointerCast
            dict_ok <- true
            return LLVMConstNamedStruct(llvm_type_of(dict_type, structs, ctx), header_pointer, 5)


        def const_aggregate_value(value_expression: Expr, value_type: ValueType, top: darray[Decl]&, structs: mutable StructTable&, m: LLVMModuleRef, ctx: LLVMContextRef, ok: mutable bool&) -> LLVMValueRef can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            aggregate_failure: LLVMValueRef = zeroed
            # Enum members can arrive here as a field expression or as a dotted identifier
            # depending on whether the initializer was parsed through the aggregate literal
            # path. Resolve both spellings directly; relying only on the general scalar folder
            # made `const C[2] = [C.R, C.B]` decline while numeric arrays succeeded.
            if value_expression is Expr.Field(enum_value_head, enum_value_member, enum_value_line):
                enum_value_ordinal: i64 = ordinal_of_dotted_path_expr(value_expression, structs)
                if enum_value_ordinal >= 0 and (is_numeric_type(value_type) or value_type.kind == TypeKind.Bool):
                    return LLVMConstInt(llvm_type_of(value_type, structs, ctx), enum_value_ordinal.u64(), 0)
            if value_expression is Expr.Ident(enum_value_path, enum_value_path_line):
                enum_value_ordinal: i64 = ordinal_of_dotted_path(enum_value_path, structs)
                if enum_value_ordinal >= 0 and (is_numeric_type(value_type) or value_type.kind == TypeKind.Bool):
                    return LLVMConstInt(llvm_type_of(value_type, structs, ctx), enum_value_ordinal.u64(), 0)
            if value_expression is Expr.Ident(zeroed_name, zeroed_line):
                LLVMConstNull(llvm_type_of(value_type, structs, ctx)) return if zeroed_name == "zeroed"
                global_found: mutable bool = false
                global_expression: Expr = const_global_expression(top, zeroed_name, global_found)
                if global_found:
                    return const_aggregate_value(global_expression, value_type, top, structs, m, ctx, ok)
                ok <- false
                return aggregate_failure
            # A string literal in an aggregate initializer has static storage. Materialize
            # that storage as a private constant byte array and return the constant GEP to its
            # first byte, matching the pointer value produced by the ordinary literal emitter.
            # This is especially important for `u8&?[N]`: optional references are niche pointers
            # in stage0, so the array element is a plain `ptr`, not a `{tag, payload}` struct.
            if value_expression is Expr.StringLit(const_string_text):
                string_payload_type: ValueType = optional_payload_of(value_type, structs) if value_type.kind == TypeKind.Optional else value_type
                string_value_is_byte_darray: bool = value_type.kind == TypeKind.DArray and darray_element_of(value_type, structs).kind == TypeKind.Unsigned and darray_element_of(value_type, structs).bits == 8
                string_value_is_niche_optional: bool = value_type.kind == TypeKind.Optional and optional_is_niche(value_type, structs)
                if value_type.kind != TypeKind.CStr and value_type.kind != TypeKind.SView and not string_value_is_byte_darray and value_type.kind != TypeKind.Ref and not string_value_is_niche_optional:
                    ok <- false
                    return aggregate_failure
                if value_type.kind == TypeKind.Ref and ref_is_heap_ref(value_type, structs):
                    ok <- false
                    return aggregate_failure
                if string_value_is_niche_optional and string_payload_type.kind != TypeKind.Ref and string_payload_type.kind != TypeKind.CStr:
                    ok <- false
                    return aggregate_failure
                literal_storage: mutable darray[u8] = []
                literal_cstr: cstr = decoded_literal_cstr(const_string_text, literal_storage)
                literal_array: LLVMValueRef = LLVMConstStringInContext(ctx, literal_cstr, (literal_storage.count - 1.usize()).u32(), 0)
                literal_global: LLVMValueRef = LLVMAddGlobal(m, LLVMTypeOf(literal_array), ".const.aggregate.str")
                LLVMSetInitializer(literal_global, literal_array)
                # LLVMPrivateLinkage == 9.  These are individual string byte arrays, not
                # externally visible aggregate globals.  stage0 uses private linkage here so
                # LLVM's constant merger can coalesce repeated database strings; internal
                # linkage leaves one copy per aggregate initializer and makes large generated
                # constant tables needlessly enormous.
                LLVMSetLinkage(literal_global, 9)
                # LLVMGlobalUnnamedAddr == 2.  String contents, rather than their address,
                # determine identity, which permits the constant merger to share equal rows.
                LLVMSetUnnamedAddress(literal_global, 2)
                LLVMSetGlobalConstant(literal_global, 1)
                literal_indices: mutable darray[LLVMValueRef] = [LLVMConstInt(LLVMInt64TypeInContext(ctx), 0, 0), LLVMConstInt(LLVMInt64TypeInContext(ctx), 0, 0)]
                literal_indices_pointer: void& = (&literal_indices[0]).cast[void&] can Unsafe.PointerCast
                literal_pointer: LLVMValueRef = LLVMConstInBoundsGEP2(LLVMTypeOf(literal_array), literal_global, literal_indices_pointer, 2)
                return literal_pointer if value_type.kind == TypeKind.CStr
                if value_type.kind == TypeKind.SView:
                    sview_fields: mutable darray[LLVMValueRef] = [literal_pointer, LLVMConstInt(LLVMInt64TypeInContext(ctx), (literal_storage.count - 1.usize()).u64(), 0)]
                    sview_fields_pointer: void& = (&sview_fields[0]).cast[void&] can Unsafe.PointerCast
                    return LLVMConstNamedStruct(llvm_type_of(value_type, structs, ctx), sview_fields_pointer, 2)
                if string_value_is_byte_darray:
                    darray_count: LLVMValueRef = LLVMConstInt(LLVMInt64TypeInContext(ctx), (literal_storage.count - 1.usize()).u64(), 0)
                    darray_fields: mutable darray[LLVMValueRef] = [literal_pointer, darray_count, darray_count]
                    darray_fields_pointer: void& = (&darray_fields[0]).cast[void&] can Unsafe.PointerCast
                    return LLVMConstNamedStruct(llvm_type_of(value_type, structs, ctx), darray_fields_pointer, 3)
                return literal_pointer
            if value_type.kind == TypeKind.Array:
                if value_expression is Expr.Array(aggregate_elements, aggregate_line):
                    aggregate_element_type: ValueType = copied_type(structs.array_elements[value_type.bits.usize()])
                    aggregate_extent: u32 = structs.array_extents[value_type.bits.usize()]
                    if aggregate_elements.count.u32() != aggregate_extent:
                        ok <- false
                        return aggregate_failure
                    aggregate_element_llvm: LLVMTypeRef = llvm_type_of(aggregate_element_type, structs, ctx)
                    aggregate_values: mutable darray[LLVMValueRef] = []
                    aggregate_all_ok: mutable bool = true
                    for aggregate_element in aggregate_elements |aggregate_values, aggregate_all_ok, aggregate_element_type, structs, ctx|:
                        aggregate_child_ok: mutable bool = true
                        aggregate_child: LLVMValueRef = const_aggregate_value(aggregate_element, aggregate_element_type, top, structs, m, ctx, aggregate_child_ok)
                        if aggregate_child_ok:
                            aggregate_values.push(aggregate_child)
                        else:
                            aggregate_all_ok <- false
                    if not aggregate_all_ok or aggregate_values.count == 0:
                        ok <- false
                        return aggregate_failure
                    aggregate_values_pointer: void& = (&aggregate_values[0]).cast[void&] can Unsafe.PointerCast
                    return LLVMConstArray2(aggregate_element_llvm, aggregate_values_pointer, aggregate_values.count.u64())
                ok <- false
                return aggregate_failure
            if value_expression is Expr.Index(indexed_global, index_expression, index_line):
                match indexed_global:
                    Expr.Ident(indexed_name, indexed_name_line):
                        source_found: mutable bool = false
                        source_expression: Expr = const_global_expression(top, indexed_name, source_found)
                        if source_found and source_expression is Expr.Array(source_elements, source_line):
                            source_index_ok: mutable bool = true
                            source_index: i64 = fold_const_expr(index_expression, structs, source_index_ok)
                            if source_index_ok and source_index >= 0 and source_index.usize() < source_elements.count:
                                source_index_const_index: i64 = const_index_of(structs, indexed_name)
                                source_index_mutable_index: i64 = mutable_global_index_of(structs, indexed_name)
                                source_index_type: ValueType = copied_type(structs.const_types[source_index_const_index.usize()]) if source_index_const_index >= 0 else copied_type(structs.mutable_global_types[source_index_mutable_index.usize()]) if source_index_mutable_index >= 0 else unmodeled_type()
                                element_type: ValueType = array_element_of(source_index_type, structs)
                                return const_aggregate_value(source_elements[source_index.usize()], element_type, top, structs, m, ctx, ok)
                    _:
                        pass
                ok <- false
                return aggregate_failure
            if value_type.kind == TypeKind.Struct:
                if value_expression is Expr.Construct(construct_type, construct_fields, construct_line):
                    struct_index: usize = value_type.bits.usize()
                    field_count: usize = structs.field_count[struct_index]
                    field_values: mutable darray[LLVMValueRef] = []
                    for field_offset in 0..<field_count |field_values, structs, ctx, struct_index|:
                        field_values.push(LLVMConstNull(llvm_type_of(structs.field_types[structs.field_start[struct_index] + field_offset], structs, ctx)))
                    fields_ok: mutable bool = true
                    for field_offset in 0..<construct_fields.count |field_values, fields_ok, construct_fields, structs, ctx, struct_index, field_count|:
                        field_position: mutable i64 = field_offset.i64()
                        field_position <- field_index_of(structs, struct_index, construct_fields[field_offset].name) if construct_fields[field_offset].name != ""
                        if field_position < 0 or field_position.usize() >= field_count:
                            fields_ok <- false
                        else:
                            field_type: ValueType = copied_type(structs.field_types[structs.field_start[struct_index] + field_position.usize()])
                            field_ok: mutable bool = true
                            field_value: LLVMValueRef = const_aggregate_value(construct_fields[field_offset].value, field_type, top, structs, m, ctx, field_ok)
                            fields_ok <- false if not field_ok
                            field_values[field_position.usize()] <- field_value if field_ok
                    if fields_ok:
                        field_values_pointer: void& = (&field_values[0]).cast[void&] can Unsafe.PointerCast
                        return LLVMConstNamedStruct(llvm_type_of(value_type, structs, ctx), field_values_pointer, field_count.u32())
                ok <- false
                return aggregate_failure
            if value_expression is Expr.Field(field_object, field_name, field_line):
                if field_object is Expr.Construct(field_construct_value_type, field_construct_value_fields, field_construct_value_line):
                    field_construct_type: ValueType = annotation_value_type(field_construct_value_type, structs)
                    if field_construct_type.kind == TypeKind.Struct:
                        field_construct_slot: usize = field_construct_type.bits.usize()
                        field_construct_position: i64 = field_index_of(structs, field_construct_slot, field_name)
                        if field_construct_position >= 0:
                            selected_field_value: mutable Expr = Expr.Invalid
                            selected_field_found: mutable bool = false
                            for field_construct_value_field in field_construct_value_fields |selected_field_value, field_name|:
                                if field_construct_value_field.name == field_name:
                                    selected_field_value <- field_construct_value_field.value
                                    selected_field_found <- true
                            if selected_field_found:
                                field_construct_field_type: ValueType = copied_type(structs.field_types[structs.field_start[field_construct_slot] + field_construct_position.usize()])
                                return const_aggregate_value(selected_field_value, field_construct_field_type, top, structs, m, ctx, ok)
                if field_object is Expr.Index(indexed_field_global, indexed_field_index, indexed_field_line):
                    match indexed_field_global:
                        Expr.Ident(indexed_field_name, indexed_field_name_line):
                            indexed_field_source_found: mutable bool = false
                            indexed_field_source: Expr = const_global_expression(top, indexed_field_name, indexed_field_source_found)
                            indexed_field_const_index: i64 = const_index_of(structs, indexed_field_name)
                            indexed_field_mutable_index: i64 = mutable_global_index_of(structs, indexed_field_name)
                            if indexed_field_source_found and indexed_field_source is Expr.Array(indexed_field_elements, indexed_field_source_line) and (indexed_field_const_index >= 0 or indexed_field_mutable_index >= 0):
                                indexed_field_source_type: ValueType = copied_type(structs.const_types[indexed_field_const_index.usize()]) if indexed_field_const_index >= 0 else copied_type(structs.mutable_global_types[indexed_field_mutable_index.usize()])
                                indexed_field_element_type: ValueType = array_element_of(indexed_field_source_type, structs)
                                indexed_field_index_ok: mutable bool = true
                                indexed_field_position: i64 = fold_const_expr(indexed_field_index, structs, indexed_field_index_ok)
                                if indexed_field_index_ok and indexed_field_position >= 0 and indexed_field_position.usize() < indexed_field_elements.count and indexed_field_element_type.kind == TypeKind.Struct:
                                    indexed_field_struct_index: usize = indexed_field_element_type.bits.usize()
                                    indexed_field_position_in_struct: i64 = field_index_of(structs, indexed_field_struct_index, field_name)
                                    if indexed_field_position_in_struct >= 0:
                                        indexed_field_field_type: ValueType = copied_type(structs.field_types[structs.field_start[indexed_field_struct_index] + indexed_field_position_in_struct.usize()])
                                        return const_aggregate_value(Expr.Field(indexed_field_elements[indexed_field_position.usize()], field_name, field_line), indexed_field_field_type, top, structs, m, ctx, ok)
                        _:
                            pass
                if field_object is Expr.Ident(field_global_name, field_global_line):
                    source_found: mutable bool = false
                    source_expression: Expr = const_global_expression(top, field_global_name, source_found)
                    if source_found and source_expression is Expr.Construct(field_construct_type, field_construct_fields, field_construct_line):
                        direct_field_found: mutable bool = false
                        direct_field_value: mutable Expr = Expr.Invalid
                        for direct_field in field_construct_fields |direct_field_found, direct_field_value, field_name|:
                            if direct_field.name == field_name:
                                direct_field_found <- true
                                direct_field_value <- direct_field.value
                        if direct_field_found:
                            return const_aggregate_value(direct_field_value, value_type, top, structs, m, ctx, ok)
                        source_const_index: i64 = const_index_of(structs, field_global_name)
                        source_mutable_index: i64 = mutable_global_index_of(structs, field_global_name)
                        source_type: ValueType = copied_type(structs.const_types[source_const_index.usize()]) if source_const_index >= 0 else copied_type(structs.mutable_global_types[source_mutable_index.usize()]) if source_mutable_index >= 0 else unmodeled_type()
                        source_struct_index: usize = source_type.bits.usize()
                        source_position: i64 = field_index_of(structs, source_struct_index, field_name)
                        if source_position >= 0:
                            source_field_offset: mutable i64 = -1
                            for candidate_offset in 0..<field_construct_fields.count |field_construct_fields, source_field_offset, field_name|:
                                candidate_name: sview = field_construct_fields[candidate_offset].name
                                source_field_offset <- candidate_offset.i64() if candidate_name == field_name or (candidate_name == "" and candidate_offset.i64() == source_position)
                            if source_field_offset >= 0:
                                field_type: ValueType = copied_type(structs.field_types[structs.field_start[source_struct_index] + source_position.usize()])
                                return const_aggregate_value(field_construct_fields[source_field_offset.usize()].value, field_type, top, structs, m, ctx, ok)
                ok <- false
                return aggregate_failure
            # Float literals are valid elements of fixed-array constant aggregates.  The
            # integer folder below intentionally rejects them, but aggregate materialization
            # must preserve the literal's spelling through LLVMConstRealOfString so a helper
            # such as `return weights[index]` has the same global-backed lowering as stage0.
            if value_expression is Expr.FloatLit(aggregate_float_text) and value_type.kind == TypeKind.Float:
                aggregate_float_storage: mutable darray[u8] = []
                return LLVMConstRealOfString(llvm_type_of(value_type, structs, ctx), sview_to_cstr(aggregate_float_text, aggregate_float_storage))
            # A signed float literal is parsed as Unary(Minus, FloatLit(...)), rather than as
            # one FloatLit token. This matters for large model tables where most weights are
            # negative: treating the wrapper as an integer expression makes the entire const
            # aggregate fail to materialize, and a later dynamic index then has no global to
            # read. Preserve the source spelling so LLVM receives the exact decimal value.
            if value_type.kind == TypeKind.Float and value_expression is Expr.Unary(aggregate_float_operator, aggregate_float_operand, aggregate_float_line):
                match aggregate_float_operand:
                    Expr.FloatLit(aggregate_signed_float_text):
                        if aggregate_float_operator == TokenKind.Minus or aggregate_float_operator == TokenKind.Plus:
                            aggregate_signed_storage: mutable darray[u8] = []
                            aggregate_signed_storage.push(45) if aggregate_float_operator == TokenKind.Minus
                            return LLVMConstRealOfString(llvm_type_of(value_type, structs, ctx), sview_to_cstr(aggregate_signed_float_text, aggregate_signed_storage))
                    _:
                        pass
            if is_numeric_type(value_type) or value_type.kind == TypeKind.Bool:
                scalar_folded_ok: mutable bool = true
                scalar_folded: i64 = fold_const_expr(value_expression, structs, scalar_folded_ok)
                if not scalar_folded_ok:
                    ok <- false
                    return aggregate_failure
                return LLVMConstInt(llvm_type_of(value_type, structs, ctx), scalar_folded.u64(), 0)
            ok <- false
            return aggregate_failure


        # Materialize a global const ARRAY as a real module global (`@xs = internal constant
        # [N x i64] […]`), the way stage0 does. Scalar- AND nested-array elements are modeled
        # (`i64[2][2]` -> `[2 x [2 x i64]]`) so long as the initializer is a fully-foldable
        # literal of exactly the declared shape; anything else leaves const_global_ok false and
        # the const stays declined at its use sites.
        def materialize_const_aggregates(file: Ast::File&, top: darray[Decl]&, structs: mutable StructTable&, m: LLVMModuleRef, ctx: LLVMContextRef) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            for declaration in top |structs, m, ctx|:
                match declaration:
                    Decl.Const(const_name, const_type_expression, const_value, const_is_mutable, const_line):
                        const_index: i64 = const_index_of(structs, const_name)
                        continue if const_index < 0
                        const_type: ValueType = copied_type(structs.const_types[const_index.usize()])
                        continue if const_type.kind != TypeKind.Array and const_type.kind != TypeKind.Struct
                        aggregate_ok: mutable bool = true
                        const_aggregate: mutable LLVMValueRef = zeroed
                        # A compile-time DICT is laid out whole, not folded element by element, and
                        # needs the module to hang its bucket table and key strings off.
                        dict_literal_handled: mutable bool = false
                        match const_value:
                            Expr.DictLit(const_dict_entries, const_dict_line):
                                dict_built_ok: mutable bool = false
                                dict_constant: LLVMValueRef = const_dict_global_value(const_dict_entries, const_type, top, structs, m, ctx, dict_built_ok)
                                if dict_built_ok:
                                    const_aggregate <- dict_constant
                                    dict_literal_handled <- true
                                else:
                                    aggregate_ok <- false
                            _:
                                pass
                        if not dict_literal_handled:
                            const_aggregate <- const_aggregate_value(const_value, const_type, top, structs, m, ctx, aggregate_ok)
                        continue if not aggregate_ok
                        array_llvm: LLVMTypeRef = llvm_type_of(const_type, structs, ctx)
                        const_name_storage: mutable darray[u8] = []
                        const_global: LLVMValueRef = LLVMAddGlobal(m, array_llvm, sview_to_cstr(const_name, const_name_storage))
                        LLVMSetInitializer(const_global, const_aggregate)
                        aggregate_alignment: u32 = struct_alignment(const_type, structs)
                        LLVMSetAlignment(const_global, aggregate_alignment) if aggregate_alignment != 0
                        # LLVMInternalLinkage == 8; a `constant` global is immutable.
                        LLVMSetLinkage(const_global, 8)
                        LLVMSetGlobalConstant(const_global, 1)
                        structs.const_globals[const_index.usize()] <- const_global
                        structs.const_global_ok[const_index.usize()] <- true


                    _:
                        pass
        # Materialize scalar `global` storage. Initializers follow stage0's constant
        # initializer rule for this first slice; an omitted initializer is zeroed.
        # Fold scalar projections from aggregate globals (a.x and table[i].x) before the
        # ordinary scalar folder, which intentionally knows nothing about aggregate places.
        def fold_global_scalar_expr(expression: Expr, top: darray[Decl]&, structs: mutable StructTable&, ok: mutable bool&) -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                if expression is Expr.Field(field_object, field_name, field_line):
                    if field_object is Expr.Ident(field_global_name, field_global_line):
                        source_found: mutable bool = false
                        source_expression: Expr = const_global_expression(top, field_global_name, source_found)
                        if source_found and source_expression is Expr.Construct(field_type_expression, field_fields, field_construct_line):
                            for field_entry in field_fields |field_name, structs, ok|:
                                if field_entry.name == field_name:
                                    return fold_global_scalar_expr(field_entry.value, top, structs, ok)
                    if field_object is Expr.Index(indexed_object, indexed_index, indexed_line):
                        match indexed_object:
                            Expr.Ident(indexed_name, indexed_name_line):
                                source_found: mutable bool = false
                                source_expression: Expr = const_global_expression(top, indexed_name, source_found)
                                if source_found and source_expression is Expr.Array(source_elements, source_array_line):
                                    index_ok: mutable bool = true
                                    index_value: i64 = fold_const_expr(indexed_index, structs, index_ok)
                                    if index_ok and index_value >= 0 and index_value.usize() < source_elements.count:
                                        return fold_global_scalar_expr(Expr.Field(source_elements[index_value.usize()], field_name, field_line), top, structs, ok)
                            _:
                                pass
                    ok <- false
                    return 0
                if expression is Expr.Ident(global_name, global_line):
                    source_found: mutable bool = false
                    source_expression: Expr = const_global_expression(top, global_name, source_found)
                    if source_found:
                        return fold_global_scalar_expr(source_expression, top, structs, ok)
                return fold_const_expr(expression, structs, ok)


        def materialize_mutable_globals(file: Ast::File&, top: darray[Decl]&, structs: mutable StructTable&, m: LLVMModuleRef, ctx: LLVMContextRef) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            # MODULE members too. register_const already descends into `module M:` (see
            # codegen_module), but materialization did not — so a `module M: global g: T`
            # was registered and then never given an LLVM global, and stage1 emitted NO
            # storage for it while stage0 exports `_M.g`. Functions inside a module were
            # always emitted, which is what made the omission look like a naming problem
            # rather than a missing traversal.
            for module_declaration in top |structs, m, ctx, file|:
                continue if not declaration_is_module(module_declaration)
                module_owner: sview = module_name_of(module_declaration)
                for nested_index in 0..<declaration_module_count(module_declaration) |structs, m, ctx, module_declaration, module_owner|:
                    materialize_one_mutable_global(declaration_module_at(module_declaration, nested_index), module_owner, top, structs, m, ctx)
            for declaration in top |structs, m, ctx|:
                materialize_one_mutable_global(declaration, "", top, structs, m, ctx)


        # One `global` declaration. `owner` is the enclosing `module M:` name (empty at top
        # level), so the emitted symbol is `M.g` — the spelling stage0 uses.
        def materialize_one_mutable_global(declaration: Decl, owner: sview, top: darray[Decl]&, structs: mutable StructTable&, m: LLVMModuleRef, ctx: LLVMContextRef) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                if declaration is Decl.Const(global_name, global_type_expression, global_value, global_is_mutable, global_line):
                    return if not global_is_mutable
                    global_index: i64 = mutable_global_index_of(structs, global_name)
                    return if global_index < 0
                    global_type: ValueType = copied_type(structs.mutable_global_types[global_index.usize()])
                    global_llvm_type: LLVMTypeRef = llvm_type_of(global_type, structs, ctx)
                    global_name_storage: mutable darray[u8] = []
                    global_symbol: cstr = sview_to_cstr(global_name, global_name_storage) if owner == "" else qualified_name_cstr(owner, global_name, global_name_storage)
                    global_handle: LLVMValueRef = LLVMAddGlobal(m, global_llvm_type, global_symbol)
                    initializer: mutable LLVMValueRef = LLVMConstNull(global_llvm_type)
                    aggregate_initialized: mutable bool = false
                    # Text-shaped globals go through the same constant path as
                    # aggregates. Without this a `global mutable p: cstr = "x"`
                    # fell through to LLVMConstNull and became a null pointer,
                    # which links and runs but hands every reader nothing.
                    if (global_type.kind == TypeKind.Array or global_type.kind == TypeKind.Struct or global_type.kind == TypeKind.CStr or global_type.kind == TypeKind.SView) and global_value is not Expr.Invalid:
                        aggregate_ok: mutable bool = true
                        aggregate_initializer: LLVMValueRef = const_aggregate_value(global_value, global_type, top, structs, m, ctx, aggregate_ok)
                        if aggregate_ok:
                            initializer <- aggregate_initializer
                            aggregate_initialized <- true
                    if global_value is Expr.FloatLit(global_float_text) and global_type.kind == TypeKind.Float:
                        global_float_storage: mutable darray[u8] = []
                        initializer <- LLVMConstRealOfString(global_llvm_type, sview_to_cstr(global_float_text, global_float_storage))
                    if global_value is not Expr.Invalid and not aggregate_initialized and not (global_value is Expr.FloatLit(_)):
                        initializer_ok: mutable bool = true
                        initializer_value: i64 = fold_global_scalar_expr(global_value, top, structs, initializer_ok)
                        if initializer_ok and (is_integer_type(global_type) or global_type.kind == TypeKind.Bool):
                            initializer <- LLVMConstInt(global_llvm_type, initializer_value.u64(), 0)
                    LLVMSetInitializer(global_handle, initializer)
                    global_alignment: u32 = struct_alignment(global_type, structs)
                    LLVMSetAlignment(global_handle, global_alignment) if global_alignment != 0
                    # Every mutable global is internal in a PROGRAM THAT INCLUDES THE STD —
                    # not just the three collections carriers this used to name, and not in an
                    # ordinary program, which must keep stage0's external linkage.
                    #
                    # A stage1-compiled program delegates the standard library to
                    # elisacore_runtime.o: its own copies of the std FUNCTIONS are renamed and
                    # every call binds to the runtime object's (codegen_module.elisa). The
                    # std's GLOBALS had no such rule, so the program emitted an external
                    # definition of `perm_arena`, `scratch_arena`, the debug-referee ring, the
                    # bridge queues — 37 of them — and the link failed as DUPLICATE the moment
                    # enough std code compiled to emit them. Naming three of them was treating
                    # the instances rather than the rule.
                    #
                    # Internal is right for a program: nothing outside the module can reference
                    # a program's global, the live std code is the runtime object's copy using
                    # the runtime object's storage, and the module-local copy is dead and
                    # strips. It also matches stage0's optimized IR.
                    #
                    # ...but ONLY in a program. A LIBRARY module (no `main`) IS the runtime
                    # object, so internalizing these leaves it exporting nothing for them and
                    # every real std-collection link fails as UNDEFINED rather than duplicate.
                    globals_module_has_main: mutable bool = false
                    globals_module_has_std: mutable bool = false
                    for global_main_probe in top |globals_module_has_main, globals_module_has_std|:
                        globals_module_has_main <- true if function_name_of(global_main_probe) == "main"
                        globals_module_has_std <- true if function_name_of(global_main_probe) == "arena_alloc"
                    LLVMSetLinkage(global_handle, 8) if globals_module_has_main and globals_module_has_std
                    structs.mutable_global_handles[global_index.usize()] <- global_handle


        # Register aliases from parser side tables; this avoids destructuring the recursive
        # packed Decl hierarchy during the backend's type pass.
        def register_aliases(file: Ast::File&, structs: mutable StructTable&) -> void can[Abort.Panic, Memory.Allocate]:
            for alias_name in file.alias_names |structs|:
                structs.alias_names <- structs.alias_names.push(alias_name)
                structs.alias_types <- structs.alias_types.push(unmodeled_type())


        # Resolve each alias to a concrete ValueType in DECLARATION ORDER, one pass.
        #
        # NOT a fixpoint: stage0 requires an alias's target to be already declared
        # (`type A = B` before `type B = i64` is "unknown type B" — verified), unlike
        # structs, which are order-free. Iterating to a fixpoint would resolve that forward
        # reference and make stage1 accept a program the reference compiler REJECTS — a
        # silent divergence, caught by a differential fixture that SKIPped.
        #
        # One in-order pass also subsumes the cycle guard: `type A = B` / `type B = A` never
        # resolves, stays Unmodeled, and declines rather than recursing forever.
        def resolve_aliases(file: Ast::File&, structs: mutable StructTable&) -> void can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                for alias_index in 0..<file.alias_names.count |structs, file|:
                    # Resolve the WHOLE target expression first. The head heuristic keeps the
                    # LAST Ident token in the target span, so `type X = id[Slot]` records
                    # `Slot` — the REFERENT — and the alias came out as that struct instead of
                    # the u32 handle. Falls back to the head, which still covers the plain
                    # `type A = B` spelling and any target the annotation resolver declines.
                    # A REFINED alias — `type Lane4 = u32 is InRange[0, 3]` (a law) or
                    # `type Pct = i64 where 0 <= self <= 100` (an inline predicate) — carries
                    # its constraint in the target expression. Both erase at runtime: stage0
                    # lowers a `Lane4` parameter as a plain i32 and emits no check, so the
                    # alias IS its base type here and the predicate is the semantic layer's
                    # business.
                    #
                    # Unwrapped before the resolver because neither shape is a type
                    # expression: the `is` form is a Binary, and the head heuristic below
                    # keeps the LAST Ident in the span, which is the LAW's name. So the alias
                    # stayed Unmodeled and every function mentioning it declined — including
                    # ones that only did arithmetic on the value.
                    alias_target: mutable Expr = file.alias_targets[alias_index]
                    if alias_target is Expr.Refinement(alias_refined_base, alias_refined_pred, alias_refined_line):
                        alias_target <- alias_refined_base
                    if alias_target is Expr.Binary(alias_is_base, alias_is_operator, alias_is_law, alias_is_line):
                        alias_target <- alias_is_base if alias_is_operator == TokenKind.Is
                    resolved: mutable ValueType = annotation_value_type(alias_target, structs)
                    resolved <- resolve_type_head(file.alias_target_heads[alias_index], structs) if resolved.kind == TypeKind.Unmodeled
                    continue if resolved.kind == TypeKind.Unmodeled
                    structs.alias_types[alias_index] <- resolved


        def alias_index_of(structs: StructTable&, name: sview) -> i64 can[Abort.Panic]:
            index: mutable usize = 0
            while index < structs.alias_names.count |index, structs, name|:
                index.i64() return if structs.alias_names[index] == name
                index <- index + 1
            return -1


        def packed_index_of(structs: StructTable&, name: sview) -> i64 can[Abort.Panic]:
            index: mutable usize = 0
            while index < structs.packed_names.count |index, structs, name|:
                index.i64() return if structs.packed_names[index] == name
                index <- index + 1
            return -1

        # Packed profile ABI: canonical uses the existing variant-sparse runtime; retained_reads
        # uses the dense index/SOA runtime. build_heavy remains reserved for the AoS path below.
        def packed_profile_mode(annotations: darray[Ast::EnumAnnotation]&) -> i32 can[Abort.Panic]:
            for annotation in annotations:
                2 return if annotation.name == "__aos" and annotation.line == 3900000042
                # Recursive values and sealed hierarchies need stable rows because a child
                # value is consumed through its root type. stage0 selects canonical AoS for
                # these automatically; leaving them in variant-sparse mode loses the root row
                # ABI before codegen can reason about the hierarchy.
                2 return if annotation.name == "__recursive_field" or annotation.name == "__ast_refinement"
                if annotation.line == 3900000041:
                    1 return if annotation.name == "retained_reads"
                    2 return if annotation.name == "build_heavy"
            return 0


        # Whether this packed enum is the COMPILER'S OWN AST root, whose store row has a fixed
        # hard-coded shape (`{i32, [32 x i32]}`, 132 bytes). That is a different question from
        # "does this enum use the AoS store machinery" -- packed_is_ast_root, which every other
        # site asks and which is deliberately broader.
        #
        # Conflating the two made a USER packed enum report the AST root's 132-byte row: its
        # store was created with the wrong stride and every payload read back as 0 (stage0
        # answers 5, stage1 answered 0). Two names, two meanings.
        def packed_is_ast_root_row(structs: StructTable&, enum_index: i64) -> bool can[Abort.Panic]:
            false return if enum_index < 0 or enum_index.usize() >= structs.packed_names.count
            false return if structs.packed_variant_count[enum_index.usize()] != 0.usize()
            # Generic user hierarchies use the same zero-variant placeholder shape, but their
            # rows are dynamically sized. Only the parser's dedicated compiler-AST marker may
            # select the historical Node row; testing the generic hierarchy marker here made
            # every user root look like the compiler's 132-byte AST store.
            return packed_is_ast_refinement(structs, enum_index)


        def packed_is_ast_root(structs: StructTable&, enum_index: i64) -> bool can[Abort.Panic]:
            false return if enum_index < 0 or enum_index.usize() >= structs.packed_names.count
            name: sview = structs.packed_names[enum_index.usize()]
            # Whether this packed enum uses the AoS store layout. Historically this was
            # `name == "Node" and variant_count == 0` -- the compiler's own AST-root
            # PLACEHOLDER row -- which scoped the whole AoS subsystem to self-hosting and was
            # believed to be what blocked every user `packed enum`.
            #
            # MEASURED: relaxing it moves exactly ONE of the 21 packed corpus files
            # (backend_packed_zero_payload_object, which then runs correctly -- 7, matching
            # stage0). The other 20 still decline for their own reasons, so the note claiming
            # this one gate explained the cluster was wrong.
            #
            # Kept because it is measured safe -- self-host, the 303-program adversarial suite
            # and the semantic gates are all green with it -- and because the placeholder-row
            # test was never the real rule: a packed enum with variants of its own uses the
            # same store machinery.
            true return if name == "Node" and structs.packed_variant_count[enum_index.usize()] == 0
            # A sealed hierarchy ROOT uses the store machinery too, and it is written
            # variant-less (`enum Widget: pass`), so the variant-count test below cannot see
            # it. Without this a match on ANY member of a user hierarchy declined: the
            # statement-match emitter resolves the scrutinee to its ROOT and then asks
            # whether that root uses the AoS store. Asked STRUCTURALLY here -- this is store
            # membership, not the AST's row layout, which packed_is_ast_root_row owns.
            true return if structs.packed_variant_count[enum_index.usize()] == 0.usize() and packed_name_is_hierarchy_root(structs, name)
            return structs.packed_variant_count[enum_index.usize()] > 0.usize()


        # Whether this packed enum uses the measured dynamic AoS row shape. Unlike
        # packed_is_ast_root, this includes a flat recursive enum (`Tree`) and every member of
        # a user sealed hierarchy. Compiler AST rows retain the historical 32-slot floor, while
        # user rows are sized from their actual widest payload.
        def packed_is_dynamic_aos_enum(structs: StructTable&, enum_index: i64) -> bool can[Abort.Panic]:
            false return if enum_index < 0 or enum_index.usize() >= structs.packed_names.count
            name: sview = structs.packed_names[enum_index.usize()]
            for dynamic_name in structs.aos_dynamic_names |name|:
                true return if dynamic_name == name
            return false


        # The name at the top of `name`'s `is` chain — itself when it has no parent. The step
        # budget is the edge count: a well-formed hierarchy is a tree, so a longer walk means
        # a cycle from malformed input and must terminate rather than hang.
        def packed_hierarchy_root_name(structs: StructTable&, name: sview) -> sview can[Abort.Panic]:
            can Abort.Panic:
                cursor: mutable sview = name
                steps: mutable usize = 0
                while steps < structs.hierarchy_child.count |cursor, steps|:
                    parent: mutable sview = ""
                    for edge_index in 0..<structs.hierarchy_child.count |parent|:
                        parent <- structs.hierarchy_parent[edge_index] if structs.hierarchy_child[edge_index] == cursor
                    break if parent == ""
                    cursor <- parent
                    steps <- steps + 1
                return cursor


        # The tag space of a sealed hierarchy is shared by all refinements. A child enum's
        # local variant ordinal therefore starts after every earlier declaration in the same
        # hierarchy; treating it as a standalone packed enum makes `Button.Push` collide with
        # `Control.Label` (both become tag 0) and is invisible until a match crosses that edge.
        # Flat packed enums retain their local zero-based tags.
        def packed_hierarchy_tag_base(structs: StructTable&, enum_index: i64) -> i64 can[Abort.Panic]:
            return 0 if enum_index < 0 or enum_index.usize() >= structs.packed_names.count
            own_name: sview = structs.packed_names[enum_index.usize()]
            root_name: sview = packed_hierarchy_root_name(structs, own_name)
            is_hierarchy: bool = root_name != own_name or packed_name_is_hierarchy_root(structs, own_name)
            return 0 if not is_hierarchy
            base: mutable i64 = 0
            for prior in 0..<enum_index.usize() |base, structs, root_name|:
                prior_root: sview = packed_hierarchy_root_name(structs, structs.packed_names[prior])
                base <- base + structs.packed_variant_count[prior].i64() if prior_root == root_name
            return base


        # The packed-enum index of the store that owns `enum_index` — the root of its sealed
        # hierarchy. This resolved to the literal name "Node" before, which is why a user
        # hierarchy type-checked and then declined in the backend: its root is not called
        # Node, so the lookup returned -1 and every store query failed.
        def packed_root_index_of(structs: StructTable&, enum_index: i64) -> i64 can[Abort.Panic]:
            can Abort.Panic:
                enum_index return if enum_index < 0 or enum_index.usize() >= structs.packed_names.count
                own_name: sview = structs.packed_names[enum_index.usize()]
                root_name: sview = packed_hierarchy_root_name(structs, own_name)
                # User hierarchies are generic packed/AoS values, not compiler-AST
                # refinements, but their descendants still share the root's store.
                if root_name != own_name:
                    hierarchy_root_index: i64 = packed_index_of(structs, root_name)
                    hierarchy_root_index return if hierarchy_root_index >= 0
                # A flat recursive enum has no variant-less hierarchy anchor, but it still owns
                # a store: its self-referential handles cannot be indexed into a compiler AST
                # store (and there is no Node fallback in a user program).
                enum_index return if packed_is_dynamic_aos_enum(structs, enum_index) and root_name == own_name
                # Trust the edge walk only when it actually resolves a hierarchy: either it
                # MOVED (this enum has a parent) or this enum is itself a root something
                # refines. The auxiliary StructTables (the C-header and debug paths build
                # their own) carry no edges, and there the walk returns the enum's own name —
                # which for `Expr` is a REGISTERED packed name, so trusting it silently made
                # Expr its own store root instead of Node and broke the gen3 fixpoint. The
                # compiler's own AST must keep resolving to Node in exactly that case.
                if packed_is_ast_refinement(structs, enum_index) and (root_name != own_name or packed_name_is_hierarchy_root(structs, own_name)):
                    hierarchy_root_index: i64 = packed_index_of(structs, root_name)
                    hierarchy_root_index return if hierarchy_root_index >= 0
                return enum_index


            # Two packed variant slots have the SAME payload FIELD layout — identical field count and
            # each field's kind+bits. Structurally-identical payloads (`Pattern.Variant{sview,darray}`
            # vs `Pattern.Struct{sview,darray}`) may intern to DIFFERENT aggregate payload slots, so an
            # OR arm binding across them must compare field SPANS, not the aggregate ValueType.
        def packed_slots_same_field_layout(a: i64, b: i64, structs: StructTable&) -> bool can[Abort.Panic]:
            false return if a < 0 or b < 0
            count_a: usize = structs.packed_field_type_count[a.usize()]
            count_b: usize = structs.packed_field_type_count[b.usize()]
            false return if count_a != count_b
            start_a: usize = structs.packed_field_type_start[a.usize()]
            start_b: usize = structs.packed_field_type_start[b.usize()]
            same: mutable bool = true
            for offset in 0..<count_a |same, start_a, start_b, structs|:
                type_a: ValueType = structs.packed_field_types[start_a + offset]
                type_b: ValueType = structs.packed_field_types[start_b + offset]
                same <- false if type_a.kind != type_b.kind or type_a.bits != type_b.bits
            return same


        def packed_is_ast_refinement(structs: StructTable&, enum_index: i64) -> bool can[Abort.Panic]:
            false return if enum_index < 0 or enum_index.usize() >= structs.packed_names.count
            name: sview = structs.packed_names[enum_index.usize()]
            # `Pattern` is `enum Pattern is Node` too (docs/122) — a Node refinement sharing the
            # Node store with hierarchy-global tags, like Expr/Stmt/Decl. Omitting it here (every
            # OTHER refinement list already names it) made packed_root_index_of(Pattern) wrong, so
            # every `match pattern:` / `p is Pattern.X` failed the Node-store-active check.
            for refinement_name in structs.ast_refinement_names |name|:
                true return if refinement_name == name
            return false

        def packed_constructor_enum_name(head: Expr) -> sview:
            match head:
                Expr.Ident(name, _):
                    return name
                Expr.Scope(base, name, _):
                    match base:
                        Expr.Ident(_, _):
                            return name
                        _:
                            pass
                _:
                    pass
            return sview("", 0, 0)


        def packed_variant_index(structs: StructTable&, enum_index: i64, variant_name: sview) -> i64 can[Abort.Panic]:
            can Abort.Panic:
                start: usize = structs.packed_variant_start[enum_index.usize()]
                count: usize = structs.packed_variant_count[enum_index.usize()]
                packed_tag_base: i64 = packed_hierarchy_tag_base(structs, enum_index)
                offset: mutable usize = 0
                while offset < count |offset, structs, start, variant_name|:
                    (packed_tag_base + offset.i64()) return if structs.packed_variants[start + offset] == variant_name
                    offset <- offset + 1
                return -1


            # A variant's ordinal within its own refinement, used only to index the
            # refinement-local payload pools. `packed_variant_index` deliberately returns the
            # hierarchy-wide tag used in the shared AST row.
        def packed_variant_local_index(structs: StructTable&, enum_index: i64, variant_name: sview) -> i64 can[Abort.Panic]:
            start: usize = structs.packed_variant_start[enum_index.usize()]
            count: usize = structs.packed_variant_count[enum_index.usize()]
            offset: mutable usize = 0
            while offset < count |offset, structs, start, variant_name|:
                offset.i64() return if structs.packed_variants[start + offset] == variant_name
                offset <- offset + 1
            return -1


        # The AoS row's payload area, in u32 slots.
        #
        # stage0 sizes it as the MAXIMUM over the whole hierarchy's leaves of
        # `ceil(payload_bytes / 4)` (ensurePackedEnumRowType + enumVariantPayloadSlots, with
        # a u32 slot type). stage1 had `32` written in — which WAS that maximum for the AST
        # as it stood, and silently stopped being one the moment a variant grew. Widening the
        # AST's position payload from a bare `line: u32` to a 24-byte `Pos` span pushed
        # `Decl.Func` to 144 bytes, so every constructor wrote 16 bytes PAST its record and
        # into the next node's tag.
        #
        # Nothing declined and nothing faulted at the write. It surfaced far away, as an
        # exhaustive `match` falling through to its unreachable arm — and only in gen2, the
        # compiler stage1 builds, because gen1 is built by stage0 and stage0 sizes the row
        # correctly. That is the signature of this class of bug: a hard-coded layout constant
        # is invisible until the thing it was measured from changes.
        #
        # A field kind this pass cannot size yields 0, which propagates to "cannot size this
        # variant" and leaves the floor in place rather than guessing. An undersized row
        # corrupts memory, so no answer is better than a wrong one.
        def packed_row_field_align(value_type: ValueType, structs: mutable StructTable&) -> u64 can[Abort.Panic]:
            can Abort.Panic:
                # A packed handle is the u32 row INDEX, not the row.
                4 return if value_type.kind == TypeKind.PackedEnum
                8 return if value_type.kind == TypeKind.SView or value_type.kind == TypeKind.DArray or value_type.kind == TypeKind.View
                8 return if value_type.kind == TypeKind.CStr or value_type.kind == TypeKind.Ref or value_type.kind == TypeKind.Fn
                if value_type.kind == TypeKind.Optional:
                    return packed_row_field_align(optional_payload_of(value_type, structs), structs)
                return payload_type_align(value_type, structs)


        def packed_row_field_bytes(value_type: ValueType, structs: mutable StructTable&) -> u64 can[Abort.Panic]:
            can Abort.Panic:
                4 return if value_type.kind == TypeKind.PackedEnum
                16 return if value_type.kind == TypeKind.SView
                24 return if value_type.kind == TypeKind.DArray or value_type.kind == TypeKind.View
                8 return if value_type.kind == TypeKind.CStr or value_type.kind == TypeKind.Ref or value_type.kind == TypeKind.Fn
                # `T?` lowers to `{i1 present, T}`, and the flag pads out to the payload's own
                # alignment — which is why `Expr?` measures 8 and not 5.
                if value_type.kind == TypeKind.Optional:
                    inner: ValueType = optional_payload_of(value_type, structs)
                    inner_align: u64 = packed_row_field_align(inner, structs)
                    inner_bytes: u64 = packed_row_field_bytes(inner, structs)
                    0 return if inner_align == 0 or inner_bytes == 0
                    return inner_align + inner_bytes
                return payload_type_byte_size(value_type, structs)


        # One variant's payload in u32 slots, laid out C-style: each field at the next
        # multiple of its own alignment, the aggregate rounded to the widest.
        def packed_variant_row_slots(structs: mutable StructTable&, variant_slot: usize) -> u32 can[Abort.Panic]:
            can Abort.Panic:
                0 return if variant_slot >= structs.packed_field_type_count.count
                field_start: usize = structs.packed_field_type_start[variant_slot]
                field_count: usize = structs.packed_field_type_count[variant_slot]
                0 return if field_count == 0
                offset: mutable u64 = 0
                widest_align: mutable u64 = 1
                unsized: mutable bool = false
                for field_index in 0..<field_count |offset, widest_align, unsized, field_start, structs|:
                    member: ValueType = copied_type(structs.packed_field_types[field_start + field_index])
                    member_align: u64 = packed_row_field_align(member, structs)
                    member_size: u64 = packed_row_field_bytes(member, structs)
                    if member_align == 0 or member_size == 0:
                        unsized <- true
                    else:
                        offset <- offset + (member_align - (offset % member_align)) if offset % member_align != 0
                        offset <- offset + member_size
                        widest_align <- member_align if member_align > widest_align
                0 return if unsized
                offset <- offset + (widest_align - (offset % widest_align)) if offset % widest_align != 0
                return ((offset + 3) / 4).u32()


        # The AST root row's payload slots: the widest variant across every Node refinement.
        #
        # Floored at the historical 32 so a hierarchy this pass cannot fully size can only
        # ever WIDEN the row, never shrink it below what already shipped. The floor is not a
        # substitute for measuring — `packed_ast_row_slots_smoke.sh` asserts this number
        # against the `[N x i32]` stage0 emits for the same source.
        def packed_ast_row_slots(structs: mutable StructTable&) -> u32 can[Abort.Panic]:
            can Abort.Panic:
                widest: mutable u32 = 32
                for enum_slot in 0..<structs.packed_names.count |widest, structs|:
                    continue if not packed_is_ast_refinement(structs, enum_slot.i64())
                    variant_start: usize = structs.packed_variant_start[enum_slot]
                    variant_count: usize = structs.packed_variant_count[enum_slot]
                    for variant_offset in 0..<variant_count |widest, structs, variant_start|:
                        slots: u32 = packed_variant_row_slots(structs, (variant_start + variant_offset))
                        widest <- slots if slots > widest
                return widest


        # The user AoS row's payload slots: the widest variant across the whole hierarchy. A
        # root row must be large enough for every descendant, since values flow through the
        # root handle and constructors/matches use one shared store.
        def packed_dynamic_aos_row_slots(structs: mutable StructTable&, enum_index: i64) -> u32 can[Abort.Panic]:
            can Abort.Panic:
                1 return if enum_index < 0 or enum_index.usize() >= structs.packed_names.count
                root_name: sview = packed_hierarchy_root_name(structs, structs.packed_names[enum_index.usize()])
                widest: mutable u32 = 1
                for candidate in 0..<structs.packed_names.count |widest, structs, root_name|:
                    candidate_name: sview = structs.packed_names[candidate]
                    continue if packed_hierarchy_root_name(structs, candidate_name) != root_name
                    variant_start: usize = structs.packed_variant_start[candidate]
                    variant_count: usize = structs.packed_variant_count[candidate]
                    for variant_offset in 0..<variant_count |widest, structs, variant_start|:
                        slots: u32 = packed_variant_row_slots(structs, variant_start + variant_offset)
                        widest <- slots if slots > widest
                return widest


        # The ROW LAYOUT `{i32 tag, [N x i64] payload}` — what a row contains, as distinct
        # from the handle (an i32 index) that names it.
        def packed_row_llvm_type(structs: mutable StructTable&, enum_index: i64, ctx: LLVMContextRef) -> LLVMTypeRef can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            if packed_is_ast_root_row(structs, packed_root_index_of(structs, enum_index)):
                row_fields: mutable darray[LLVMTypeRef] = [LLVMInt32TypeInContext(ctx), LLVMArrayType(LLVMInt32TypeInContext(ctx), packed_ast_row_slots(structs))]
                row_pointer: void& = (&row_fields[0]).cast[void&] can Unsafe.PointerCast
                return LLVMStructTypeInContext(ctx, row_pointer, 2, 0)
            if packed_is_dynamic_aos_enum(structs, enum_index):
                row_fields: mutable darray[LLVMTypeRef] = [LLVMInt32TypeInContext(ctx), LLVMArrayType(LLVMInt32TypeInContext(ctx), packed_dynamic_aos_row_slots(structs, enum_index))]
                row_pointer: void& = (&row_fields[0]).cast[void&] can Unsafe.PointerCast
                return LLVMStructTypeInContext(ctx, row_pointer, 2, 0)
            layout_index: mutable i64 = packed_root_index_of(structs, enum_index)
            layout_index <- enum_index if layout_index < 0
            words: u32 = structs.packed_payload_words[layout_index.usize()]
            commons: u32 = structs.packed_common_counts[layout_index.usize()]
            # `{i32 tag, <commons>, [N x i64] payload}` — commons sit BETWEEN the tag and
            # the payload, which is why every payload index shifts by `commons`. Keep each
            # common at its declared LLVM type; the old hardcoded i64 row was only correct for
            # the compiler's own integer commons and rejected user hierarchies with f32/etc.
            row_fields: mutable darray[LLVMTypeRef] = [LLVMInt32TypeInContext(ctx)]
            row_fields.push(LLVMArrayType(LLVMInt8TypeInContext(ctx), 4)) if commons > 0
            for common_index in 0..<commons.usize() |row_fields, common_index, structs, layout_index, ctx|:
                common_type: ValueType = packed_common_type_at(structs, structs.packed_names[layout_index.usize()], common_index.u32())
                common_llvm_type: LLVMTypeRef = llvm_type_of(common_type, structs, ctx)
                row_fields.push(common_llvm_type)
                common_bytes: u64 = LLVMABISizeOfType(structs.target_data, common_llvm_type)
                row_fields.push(LLVMArrayType(LLVMInt8TypeInContext(ctx), (8 - common_bytes).u32())) if common_bytes > 0 and common_bytes < 8
            row_fields.push(LLVMArrayType(LLVMInt64TypeInContext(ctx), words))
            row_pointer: void& = (&row_fields[0]).cast[void&] can Unsafe.PointerCast
            # The explicit four-byte alignment fillers are real LLVM fields, so the
            # field count is larger than `2 + commons` whenever a common is narrower
            # than one runtime word. Passing the logical count truncated the row type
            # before the payload and made later GEPs either read the wrong field or
            # walk past the LLVM struct for multiple i32 commons.
            return LLVMStructTypeInContext(ctx, row_pointer, row_fields.count.u32(), 0)


        # Dynamic AoS rows use the canonical stage0 representation `{i32, [N x i32]}`.
        # The payload array is a raw byte carrier, so typed Elisa values must cross it through
        # a temporary and four-byte loads/stores; loading an `i64` directly from the array
        # would overrun a one-word row and is invalid for f32 or handle payloads.
        def packed_dynamic_row_payload_words(structs: mutable StructTable&, enum_index: i64, row: LLVMValueRef, ctx: LLVMContextRef, builder: LLVMBuilderRef, name: cstr) -> LLVMValueRef can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            row_type: LLVMTypeRef = packed_row_llvm_type(structs, enum_index, ctx)
            array_type: LLVMTypeRef = LLVMArrayType(LLVMInt32TypeInContext(ctx), packed_dynamic_aos_row_slots(structs, enum_index))
            field_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, row_type, row, 1, name)
            indices: mutable darray[LLVMValueRef] = [LLVMConstInt(LLVMInt32TypeInContext(ctx), 0, 0), LLVMConstInt(LLVMInt32TypeInContext(ctx), 0, 0)]
            indices_pointer: void& = (&indices[0]).cast[void&] can Unsafe.PointerCast
            return LLVMBuildGEP2(builder, array_type, field_pointer, indices_pointer, 2, name)


        def packed_dynamic_row_store_value(value: LLVMValueRef, value_type: ValueType, slots: u32, structs: mutable StructTable&, enum_index: i64, row: LLVMValueRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            return false if slots == 0
            temp: LLVMValueRef = LLVMBuildAlloca(builder, llvm_type_of(value_type, structs, ctx), "packed.raw.store.temp")
            _ = LLVMBuildStore(builder, value, temp)
            i32_pointer: LLVMTypeRef = LLVMPointerTypeInContext(ctx, 0)
            source: LLVMValueRef = LLVMBuildBitCast(builder, temp, i32_pointer, "packed.raw.store.source")
            destination: LLVMValueRef = packed_dynamic_row_payload_words(structs, enum_index, row, ctx, builder, "packed.raw.store.payload")
            for word_index in 0..<slots.usize() |source, destination, word_index, ctx, builder|:
                index: LLVMValueRef = LLVMConstInt(LLVMInt32TypeInContext(ctx), word_index.u64(), 0)
                source_indices: mutable darray[LLVMValueRef] = [index]
                source_pointer: void& = (&source_indices[0]).cast[void&] can Unsafe.PointerCast
                source_word_pointer: LLVMValueRef = LLVMBuildGEP2(builder, LLVMInt32TypeInContext(ctx), source, source_pointer, 1, "packed.raw.store.word")
                source_word: LLVMValueRef = LLVMBuildLoad2(builder, LLVMInt32TypeInContext(ctx), source_word_pointer, "packed.raw.store.word.value")
                destination_indices: mutable darray[LLVMValueRef] = [index]
                destination_pointer: void& = (&destination_indices[0]).cast[void&] can Unsafe.PointerCast
                destination_word_pointer: LLVMValueRef = LLVMBuildGEP2(builder, LLVMInt32TypeInContext(ctx), destination, destination_pointer, 1, "packed.raw.store.destination")
                _ = LLVMBuildStore(builder, source_word, destination_word_pointer)
            return true


        def packed_raw_words_store_value(value: LLVMValueRef, value_type: ValueType, slots: u32, destination: LLVMValueRef, word_offset: u32, structs: mutable StructTable&, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            return false if slots == 0
            value_llvm_type: LLVMTypeRef = llvm_type_of(value_type, structs, ctx)
            value_bytes: u64 = LLVMABISizeOfType(structs.target_data, value_llvm_type)
            word_bytes: u64 = target_pointer_bits().u64() / 8
            return false if value_bytes == 0 or word_bytes == 0 or value_bytes > slots.u64() * word_bytes
            temp: LLVMValueRef = LLVMBuildAlloca(builder, value_llvm_type, "packed.raw.side.store.temp")
            _ = LLVMBuildStore(builder, value, temp)
            byte_type: LLVMTypeRef = LLVMInt8TypeInContext(ctx)
            byte_pointer: LLVMTypeRef = LLVMPointerTypeInContext(ctx, 0)
            source: LLVMValueRef = LLVMBuildBitCast(builder, temp, byte_pointer, "packed.raw.side.store.source")
            destination_bytes: LLVMValueRef = LLVMBuildBitCast(builder, destination, byte_pointer, "packed.raw.side.store.destination")
            destination_index: LLVMValueRef = LLVMConstInt(LLVMInt64TypeInContext(ctx), (word_offset.u64() * word_bytes), 0)
            destination_indices: mutable darray[LLVMValueRef] = [destination_index]
            destination_pointer: void& = (&destination_indices[0]).cast[void&] can Unsafe.PointerCast
            destination_at_offset: LLVMValueRef = LLVMBuildGEP2(builder, byte_type, destination_bytes, destination_pointer, 1, "packed.raw.side.store.destination")
            _ = LLVMBuildMemCpy(builder, destination_at_offset, 1, source, 1, LLVMConstInt(LLVMInt64TypeInContext(ctx), value_bytes, 0))
            return true


        def packed_raw_words_load_value(value_type: ValueType, slots: u32, source: LLVMValueRef, word_offset: u32, structs: mutable StructTable&, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            return null if slots == 0
            value_llvm_type: LLVMTypeRef = llvm_type_of(value_type, structs, ctx)
            value_bytes: u64 = LLVMABISizeOfType(structs.target_data, value_llvm_type)
            word_bytes: u64 = target_pointer_bits().u64() / 8
            return null if value_bytes == 0 or word_bytes == 0 or value_bytes > slots.u64() * word_bytes
            temp: LLVMValueRef = LLVMBuildAlloca(builder, value_llvm_type, "packed.raw.side.load.temp")
            byte_type: LLVMTypeRef = LLVMInt8TypeInContext(ctx)
            byte_pointer: LLVMTypeRef = LLVMPointerTypeInContext(ctx, 0)
            source_bytes: LLVMValueRef = LLVMBuildBitCast(builder, source, byte_pointer, "packed.raw.side.load.source")
            destination: LLVMValueRef = LLVMBuildBitCast(builder, temp, byte_pointer, "packed.raw.side.load.destination")
            source_index: LLVMValueRef = LLVMConstInt(LLVMInt64TypeInContext(ctx), (word_offset.u64() * word_bytes), 0)
            source_indices: mutable darray[LLVMValueRef] = [source_index]
            source_pointer: void& = (&source_indices[0]).cast[void&] can Unsafe.PointerCast
            source_at_offset: LLVMValueRef = LLVMBuildGEP2(builder, byte_type, source_bytes, source_pointer, 1, "packed.raw.side.load.source")
            _ = LLVMBuildMemCpy(builder, destination, 1, source_at_offset, 1, LLVMConstInt(LLVMInt64TypeInContext(ctx), value_bytes, 0))
            return LLVMBuildLoad2(builder, value_llvm_type, temp, "packed.raw.side.load.value")


        # Common fields of dynamic AoS rows live in the canonical side table rather than in
        # the `{tag, [u32]}` row. Reconstruct the source value through a temporary so f32,
        # string-view and aggregate common fields retain their actual ABI representation.
        def packed_side_table_load_value(value_type: ValueType, slots: u32, state: LLVMValueRef, handle: LLVMValueRef, word_offset: u32, runtime: Runtime&, structs: mutable StructTable&, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            return null if slots == 0
            value_llvm_type: LLVMTypeRef = llvm_type_of(value_type, structs, ctx)
            value_bytes: u64 = LLVMABISizeOfType(structs.target_data, value_llvm_type)
            word_bytes: u64 = target_pointer_bits().u64() / 8
            return null if value_bytes == 0 or word_bytes == 0 or value_bytes > slots.u64() * word_bytes
            temp: LLVMValueRef = LLVMBuildAlloca(builder, value_llvm_type, "packed.side.load.temp")
            byte_type: LLVMTypeRef = LLVMInt8TypeInContext(ctx)
            byte_pointer: LLVMTypeRef = LLVMPointerTypeInContext(ctx, 0)
            destination: LLVMValueRef = LLVMBuildBitCast(builder, temp, byte_pointer, "packed.side.load.destination")
            for word_index in 0..<slots.usize() |state, handle, word_index, word_offset, destination, runtime, ctx, builder, value_bytes, word_bytes, byte_type|:
                side_offset: LLVMValueRef = LLVMConstInt(runtime_size_llvm_type(ctx), (word_offset + word_index.u32()).u64(), 0)
                side_args: mutable darray[LLVMValueRef] = [state, handle, side_offset]
                side_args_pointer: void& = (&side_args[0]).cast[void&] can Unsafe.PointerCast
                side_word: LLVMValueRef = LLVMBuildCall2(builder, runtime.packed_read_side_word_type, runtime.packed_read_side_word, side_args_pointer, 3, "packed.side.load.word")
                side_word_temp: LLVMValueRef = LLVMBuildAlloca(builder, runtime_size_llvm_type(ctx), "packed.side.load.word.temp")
                _ = LLVMBuildStore(builder, side_word, side_word_temp)
                destination_index: LLVMValueRef = LLVMConstInt(LLVMInt64TypeInContext(ctx), word_index.u64() * word_bytes, 0)
                destination_indices: mutable darray[LLVMValueRef] = [destination_index]
                destination_pointer: void& = (&destination_indices[0]).cast[void&] can Unsafe.PointerCast
                destination_word_pointer: LLVMValueRef = LLVMBuildGEP2(builder, byte_type, destination, destination_pointer, 1, "packed.side.load.destination.word")
                remaining: mutable u64 = 0
                remaining <- value_bytes - word_index.u64() * word_bytes if value_bytes > word_index.u64() * word_bytes
                chunk: u64 = word_bytes if remaining > word_bytes else remaining
                if chunk > 0:
                    _ = LLVMBuildMemCpy(builder, destination_word_pointer, 1, LLVMBuildBitCast(builder, side_word_temp, byte_pointer, "packed.side.load.word.bytes"), 1, LLVMConstInt(LLVMInt64TypeInContext(ctx), chunk, 0))
            return LLVMBuildLoad2(builder, value_llvm_type, temp, "packed.side.load.value")


        def packed_dynamic_row_load_value(value_type: ValueType, slots: u32, structs: mutable StructTable&, enum_index: i64, row: LLVMValueRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            return null if slots == 0
            temp: LLVMValueRef = LLVMBuildAlloca(builder, llvm_type_of(value_type, structs, ctx), "packed.raw.load.temp")
            i32_pointer: LLVMTypeRef = LLVMPointerTypeInContext(ctx, 0)
            destination: LLVMValueRef = LLVMBuildBitCast(builder, temp, i32_pointer, "packed.raw.load.destination")
            source: LLVMValueRef = packed_dynamic_row_payload_words(structs, enum_index, row, ctx, builder, "packed.raw.load.payload")
            for word_index in 0..<slots.usize() |source, destination, word_index, ctx, builder|:
                index: LLVMValueRef = LLVMConstInt(LLVMInt32TypeInContext(ctx), word_index.u64(), 0)
                indices: mutable darray[LLVMValueRef] = [index]
                indices_pointer: void& = (&indices[0]).cast[void&] can Unsafe.PointerCast
                source_word_pointer: LLVMValueRef = LLVMBuildGEP2(builder, LLVMInt32TypeInContext(ctx), source, indices_pointer, 1, "packed.raw.load.word")
                source_word: LLVMValueRef = LLVMBuildLoad2(builder, LLVMInt32TypeInContext(ctx), source_word_pointer, "packed.raw.load.word.value")
                destination_indices: mutable darray[LLVMValueRef] = [index]
                destination_pointer: void& = (&destination_indices[0]).cast[void&] can Unsafe.PointerCast
                destination_word_pointer: LLVMValueRef = LLVMBuildGEP2(builder, LLVMInt32TypeInContext(ctx), destination, destination_pointer, 1, "packed.raw.load.destination")
                _ = LLVMBuildStore(builder, source_word, destination_word_pointer)
            return LLVMBuildLoad2(builder, llvm_type_of(value_type, structs, ctx), temp, "packed.raw.load.value")


        # A store row's size in bytes: the `{i32, [N x i64]}` handle laid out at i64
        # alignment, so the tag's 4 bytes pad to 8. stage0 passes 16 for a one-word payload
        # (`state_new_variant_sparse(ptr %owner, i64 16)`), which this reproduces.
        def packed_row_bytes(structs: mutable StructTable&, enum_index: i64) -> i64 can[Abort.Panic]:
            can Abort.Panic:
                # 4 (u32 tag) + 4 per u32 payload slot — 132 while the row was [32 x i32].
                (4 + 4 * packed_ast_row_slots(structs).i64()) return if packed_is_ast_root_row(structs, packed_root_index_of(structs, enum_index))
                (4 + 4 * packed_dynamic_aos_row_slots(structs, enum_index).i64()) return if packed_is_dynamic_aos_enum(structs, enum_index)
                # Measure the exact root row type. Every refinement's row lives in the root's
                # store, so one ABI stride governs all members; using a member's own width made
                # a narrow row too short. This also accounts for real alignment/size differences
                # between f32, pointers, and aggregate common fields.
                row_type: LLVMTypeRef = packed_row_llvm_type(structs, enum_index, structs.context)
                return LLVMABISizeOfType(structs.target_data, row_type).i64()


        def register_packed_payload_struct(enum_name: sview, variant_name: sview, fields: darray[ValueType]&, names: darray[sview]&, structs: mutable StructTable&) -> ValueType can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            # The registry index is sufficient to make this anonymous helper type unique;
            # avoiding a second recursive sview concatenation path keeps this constructor
            # lowerable by the self-hosted backend.
            name_storage: mutable darray[u8] = [95, 95, 112, 97, 99, 107, 101, 100, 95, 112, 97, 121, 108, 111, 97, 100, 95]
            append_usize_decimal(structs.names.count, name_storage)
            name_storage.push(0)
            handle: LLVMTypeRef = LLVMStructCreateNamed(structs.context, (&name_storage[0]).cast[cstr] can Unsafe.PointerCast)
            index: usize = structs.names.count
            structs.names <- structs.names.push(sview("__packed_payload", 0, 0))
            structs.owners <- structs.owners.push("")    # packed payload carrier
            structs.handles <- structs.handles.push(handle)
            structs.alignments <- structs.alignments.push(0)
            field_start: usize = structs.field_names.count
            llvm_fields: mutable darray[LLVMTypeRef] = []
            for field_index in 0..<fields.count |llvm_fields, fields, names, structs|:
                llvm_fields.push(llvm_type_of(fields[field_index], structs, structs.context))
                structs.field_names <- structs.field_names.push(names[field_index] if field_index < names.count else sview("", 0, 0))
                structs.field_types <- structs.field_types.push(copied_type(fields[field_index]))
            structs.field_start <- structs.field_start.push(field_start)
            structs.field_count <- structs.field_count.push(fields.count)
            llvm_fields_pointer: void& = (&llvm_fields[0]).cast[void&] can Unsafe.PointerCast
            LLVMStructSetBody(handle, llvm_fields_pointer, llvm_fields.count.u32(), 0)
            return ValueType{kind: TypeKind.Struct, bits: index.u32()}


        # Allocations whose values cross a branch join must live in the function entry
        # block. Keeping the builder in the current block would make a later load observe
        # an alloca that is not dominated by every predecessor.
        # Every LOCAL DECLARATION allocates through here, not through a bare LLVMBuildAlloca at
        # the point of declaration. Hoisting to the entry block is what makes a declared slot
        # DOMINATE every later block, which the multi-target rebind path relies on: it reuses an
        # existing slot only when that slot's alloca is in the entry block or the current block
        # (an equality stand-in for a real dominance query). With declarations allocating
        # in-place, a local declared at function-body level satisfied NEITHER test, so
        # `body, parser <- …` inside an if/else minted a FRESH slot and rebound the name to it —
        # and on any path where that assign did not run, later reads saw uninitialized stack.
        # That is the self-host blocker: `Parser.lambda_expression` built
        # `Expr.Lambda(parameters, body, …)` from a garbage `body` darray header whenever the
        # lambda was a fn TYPE (`fn(i64) -> i64`), so gen2 died in arena_alloc on a bogus size.
        # Hoisting does NOT merge slots — each declaration still builds its own alloca, so
        # shadowing is unchanged; only the instruction's position moves.
        def build_entry_alloca(builder: LLVMBuilderRef, type: LLVMTypeRef, name: cstr) -> LLVMValueRef:
            current_block: LLVMBasicBlockRef = LLVMGetInsertBlock(builder)
            function: LLVMValueRef = LLVMGetBasicBlockParent(current_block)
            entry: LLVMBasicBlockRef = LLVMGetEntryBasicBlock(function)
            first_instruction: LLVMValueRef? = LLVMGetFirstInstruction(entry)
            if first_instruction is first:
                LLVMPositionBuilderBefore(builder, first)
            else:
                LLVMPositionBuilderAtEnd(builder, entry)
            slot: LLVMValueRef = LLVMBuildAlloca(builder, type, name)
            LLVMPositionBuilderAtEnd(builder, current_block)
            return slot


        # Reserve all recursive AST handles before resolving any refinement body. The
        # placeholders make darray[Expr]/darray[Stmt]/darray[Decl] resolve independent of
        # source order; failed resolution resets a placeholder in place rather than popping
        # a different (later-reserved) registry slot.
        def reserve_ast_packed_header(ast_name: sview, structs: mutable StructTable&) -> void can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic:
                return if packed_index_of(structs, ast_name) >= 0
                structs.packed_names <- structs.packed_names.push(ast_name)
                structs.packed_variant_start <- structs.packed_variant_start.push(structs.packed_variants.count)
                structs.packed_variant_count <- structs.packed_variant_count.push(0)
                structs.packed_payload_words <- structs.packed_payload_words.push(0)
                structs.packed_common_counts <- structs.packed_common_counts.push(0)


        def reserve_ast_packed_headers(structs: mutable StructTable&) -> void can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic, Memory.Allocate:
                reserve_ast_packed_header(sview("Node", 0, 4), structs)
                reserve_ast_packed_header(sview("Expr", 0, 4), structs)
                reserve_ast_packed_header(sview("Stmt", 0, 4), structs)
                reserve_ast_packed_header(sview("Decl", 0, 4), structs)
                reserve_ast_packed_header(sview("Pattern", 0, 7), structs)
                # ...and every OTHER sealed hierarchy in the file, by its recorded `is` edges
                # rather than by name. Without a reserved header row a user hierarchy's root
                # has no store for its refinements to share, so every match over it declined
                # even after the rest of the backend learned to find the root structurally.
                for edge_index in 0..<structs.hierarchy_parent.count |structs|:
                    reserve_ast_packed_header(packed_hierarchy_root_name(structs, structs.hierarchy_child[edge_index]), structs)


        def register_packed_variant_rows(enum_name: sview, variants: darray[Ast::EnumVariant]&, commons: u32, start: usize, packed_field_pool_start: usize, declined: mutable bool&, widest: mutable u32&, structs: mutable StructTable&) -> void can[Abort.Panic, Memory.Allocate]:
            for variant in variants |structs, declined, widest, commons|:
                # Commons come first. Preserve every payload field; recursive AST
                # variants routinely carry multiple handles and darray side-tables.
                declined <- true if variant.fields.count.u32() < commons
                payload: mutable ValueType = unmodeled_type()
                payload_fields: mutable darray[ValueType] = []
                payload_names: mutable darray[sview] = []
                for common_index in 0..<commons.usize() |structs, declined, variant|:
                    continue if common_index >= variant.fields.count
                    common_type: ValueType = annotation_value_type(variant.fields[common_index], structs)
                    declined <- true if common_type.kind == TypeKind.Unmodeled
                for payload_index in commons.usize()..<variant.fields.count |payload_fields, payload_names, structs, variant, declined|:
                    payload_type: ValueType = annotation_value_type(variant.fields[payload_index], structs)
                    declined <- true if payload_type.kind == TypeKind.Unmodeled
                    payload_fields.push(payload_type)
                    payload_names.push(variant.field_names[payload_index] if payload_index < variant.field_names.count else sview("", 0, 0))
                if payload_fields.count == 1:
                    payload <- copied_type(payload_fields[0])
                    widest <- 1 if widest == 0
                elif payload_fields.count > 1:
                    payload <- register_packed_payload_struct(enum_name, variant.name, payload_fields, payload_names, structs)
                    widest <- payload_fields.count.u32() if payload_fields.count.u32() > widest
                field_name: mutable sview = ""
                field_name <- payload_names[0] if payload_fields.count == 1
                structs.packed_variants <- structs.packed_variants.push(variant.name)
                structs.packed_payloads <- structs.packed_payloads.push(payload)
                structs.packed_has_payload <- structs.packed_has_payload.push(payload_fields.count > 0)
                structs.packed_field_names <- structs.packed_field_names.push(field_name)
                packed_field_start: usize = structs.packed_field_types.count
                for payload_index in 0..<payload_fields.count |structs, payload_fields, payload_names|:
                    structs.packed_field_types <- structs.packed_field_types.push(copied_type(payload_fields[payload_index]))
                    structs.packed_field_flat_names <- structs.packed_field_flat_names.push(payload_names[payload_index])
                structs.packed_field_type_start <- structs.packed_field_type_start.push(packed_field_start)
                structs.packed_field_type_count <- structs.packed_field_type_count.push(payload_fields.count)
