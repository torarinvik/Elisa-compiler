# Stage1 backend — LLVM-C bindings (`module LlvmC`).
#
# Stage0's backend is cgo over <llvm-c/Core.h>. LLVM-C is a C API, so stage1 binds it
# with plain `extern` declarations — no extern-C bridge is needed (that is only required
# for C++ APIs). The handle types are opaque: LLVM's `LLVMModuleRef` and friends are
# pointers we only ever hand back to LLVM, so Elisa never needs their layout.
#
# These are declared at TOP LEVEL, not inside a `module`: an extern nested in a module is
# name-mangled (`_LlvmC.LLVMAddFunction`), which does not match the C symbol. The std
# declares its externs the same way (see elisacore_std/arena.elisa's `extern malloc`).
#
# Linking: `-emit obj` emits only the module object; the Elisa runtime (arena_free et al.)
# lives in a separately-generated `elisacore_runtime.o`. `-emit c-archive` bundles both,
# but it currently MIS-COMPILES this tree (the packed-store analysis fails — the
# unmodified test/breadth/parse_report.elisa reproduces it), so the build extracts the
# runtime object out of a throwaway c-archive and links it alongside `-emit obj` output.
# See test/parity/backend_native_smoke.sh.

# --- opaque handles -------------------------------------------------------
extern LLVMContextRef
extern LLVMModuleRef
extern LLVMTypeRef
extern LLVMValueRef
extern LLVMBuilderRef
extern LLVMBasicBlockRef
extern LLVMTargetRef
extern LLVMTargetMachineRef

# --- context / module -----------------------------------------------------
extern LLVMContextCreate() -> LLVMContextRef
extern LLVMContextDispose(ctx: LLVMContextRef)
extern LLVMModuleCreateWithNameInContext(name: cstr, ctx: LLVMContextRef) -> LLVMModuleRef
extern LLVMDisposeModule(m: LLVMModuleRef)
extern LLVMPrintModuleToString(m: LLVMModuleRef) -> cstr
extern LLVMWriteBitcodeToFile(m: LLVMModuleRef, path: cstr) -> i32

# --- the DRIVER: target machine + object emission -------------------------------------
# Until now the backend was an IR PRINTER and `llc` did the rest out of process. Emitting
# objects here is what DWARF and -Wperf need: both are invisible in IR text (stage0's own
# `-emit llvm -g` emits zero metadata) and -Wperf's check is inherently post-optimization.
#
# NOTE `LLVMInitializeNativeTarget` is a `static inline` in Target.h, NOT an exported symbol,
# so it cannot be bound — the per-target functions it wraps must be called directly. These
# are the arm64 ones (verified present in libLLVM with nm); a different host needs its own.
extern LLVMInitializeAArch64TargetInfo() -> void
extern LLVMInitializeAArch64Target() -> void
extern LLVMInitializeAArch64TargetMC() -> void
extern LLVMInitializeAArch64AsmPrinter() -> void
extern LLVMInitializeX86TargetInfo() -> void
extern LLVMInitializeX86Target() -> void
extern LLVMInitializeX86TargetMC() -> void
extern LLVMInitializeX86AsmPrinter() -> void
extern LLVMInitializeARMTargetInfo() -> void
extern LLVMInitializeARMTarget() -> void
extern LLVMInitializeARMTargetMC() -> void
extern LLVMInitializeARMAsmPrinter() -> void
extern LLVMInitializeRISCVTargetInfo() -> void
extern LLVMInitializeRISCVTarget() -> void
extern LLVMInitializeRISCVTargetMC() -> void
extern LLVMInitializeRISCVAsmPrinter() -> void
extern LLVMInitializeWebAssemblyTargetInfo() -> void
extern LLVMInitializeWebAssemblyTarget() -> void
extern LLVMInitializeWebAssemblyTargetMC() -> void
extern LLVMInitializeWebAssemblyAsmPrinter() -> void
extern LLVMGetDefaultTargetTriple() -> cstr
# Native stage0 builds tune the target machine to the host CPU and feature string;
# using `generic` here silently changes the optimizer's cost model and can leave
# whole helper families uninlined. These strings are owned by LLVM and must be
# released with LLVMDisposeMessage after LLVMCreateTargetMachine returns.
extern LLVMGetHostCPUName() -> cstr
extern LLVMGetHostCPUFeatures() -> cstr
extern LLVMDisposeMessage(message: cstr) -> void
# Returns 0 on SUCCESS (an LLVMBool error flag, not a truth value).
extern LLVMGetTargetFromTriple(triple: cstr, target_out: void&, error_out: void&) -> i32
extern LLVMCreateTargetMachine(t: LLVMTargetRef, triple: cstr, cpu: cstr, features: cstr, level: i32, reloc: i32, code_model: i32) -> LLVMTargetMachineRef
# `codegen`: 0 = LLVMAssemblyFile, 1 = LLVMObjectFile. Returns 0 on SUCCESS.
extern LLVMTargetMachineEmitToFile(t: LLVMTargetMachineRef, m: LLVMModuleRef, filename: cstr, codegen: i32, error_out: void&) -> i32
extern LLVMSetTarget(m: LLVMModuleRef, triple: cstr) -> void

# Compiler-process configuration used by opt-in backend flags. The stage0 CLI
# exposes these as flags by setting the corresponding environment variables.
@link_name(getenv)
extern getenv(name: cstr) -> u8&?

@link_name(puts)
extern puts(text: cstr) -> i64

# The module's DATALAYOUT. Not cosmetic: without it LLVM falls back to a default in which
# i64 is only 32-BIT ALIGNED, so every `store i64` comes out `align 4` and the vectorizer
# bails. stage0 sets both datalayout and triple; stage1 set neither, which silently cost
# alignment and vectorization on ALL emitted code while every exit code stayed correct.
extern LLVMTargetDataRef
extern LLVMCreateTargetDataLayout(tm: LLVMTargetMachineRef) -> LLVMTargetDataRef
extern LLVMDisposeTargetData(td: LLVMTargetDataRef) -> void
extern LLVMCopyStringRepOfTargetData(td: LLVMTargetDataRef) -> cstr
extern LLVMSetDataLayout(m: LLVMModuleRef, layout: cstr) -> void

# `-emit interpret` renames the user's `main` so a synthesized entry point can call it and
# print its RETURN VALUE — which cannot travel out through the process exit status, since
# that is 0-255 and stage0 prints values like 100000 exactly.
extern LLVMSetValueName2(value: LLVMValueRef, name: cstr, length: usize) -> void

# LAYOUT QUERIES. `-emit c-bind-check` compares a `@c_bind` struct's Elisa layout against the
# real C one, so it needs LLVM's COMPUTED size/alignment/offsets. `struct_alignment` returns
# the DECLARED alignment from the annotation and is not a substitute.
extern LLVMABISizeOfType(td: LLVMTargetDataRef, ty: LLVMTypeRef) -> u64
extern LLVMABIAlignmentOfType(td: LLVMTargetDataRef, ty: LLVMTypeRef) -> u32
extern LLVMOffsetOfElement(td: LLVMTargetDataRef, struct_ty: LLVMTypeRef, element: u32) -> u64

# The PASS PIPELINE. `LLVMRunPasses` takes a pass-pipeline STRING ("default<O2>") rather
# than a level enum, and returns an LLVMErrorRef which is NULL on success -- not a bool.
# This is what `-Wperf` needs: its check runs AFTER the passes (a loop marked
# `elisa.autovec.expected` that did not vectorize is the warning), so a backend that never
# runs them can never make the judgement.
# --- metadata (the `-Wperf` autovec markers) ------------------------------------------
# A loop-ID node must have ITSELF as operand 0 -- LLVM's rule, which is why the build goes
# through a TEMPORARY node and then replaces all its uses with the finished node.
extern LLVMMetadataRef
extern LLVMMDStringInContext2(ctx: LLVMContextRef, s: cstr, length: usize) -> LLVMMetadataRef
extern LLVMMDNodeInContext2(ctx: LLVMContextRef, ops: void&, count: usize) -> LLVMMetadataRef
extern LLVMTemporaryMDNode(ctx: LLVMContextRef, ops: void&?, count: usize) -> LLVMMetadataRef
extern LLVMMetadataReplaceAllUsesWith(temp: LLVMMetadataRef, replacement: LLVMMetadataRef) -> void
extern LLVMGetMDKindIDInContext(ctx: LLVMContextRef, name: cstr, length: u32) -> u32
extern LLVMMetadataAsValue(ctx: LLVMContextRef, md: LLVMMetadataRef) -> LLVMValueRef
# Records a DECLINED function body as module metadata. A decline is otherwise invisible --
# the function is stripped to a bare `declare`, so the only symptom is a link error naming a
# symbol with no hint of which construct the backend refused. Metadata rides along in the IR
# text, costs nothing at runtime, and gives the gates something to assert on.
extern LLVMAddNamedMetadataOperand(m: LLVMModuleRef, name: cstr, value: LLVMValueRef) -> void
# ...and reading it back, which is what turns `!elisa.declined` from a debugging aid into a
# DIAGNOSTIC. The driver exits 2 when a unit declares functions and emitted none; before
# these two it did so with empty stdout AND empty stderr, which reads exactly like a crash.
# `Dest` must point at storage for NumOperands LLVMValueRefs.
extern LLVMGetNamedMetadataNumOperands(m: LLVMModuleRef, name: cstr) -> u32
extern LLVMGetNamedMetadataOperands(m: LLVMModuleRef, name: cstr, dest: void&) -> void
extern LLVMSetMetadata(value: LLVMValueRef, kind: u32, node: LLVMValueRef) -> void

# Function attributes. LLVMAttributeFunctionIndex is UINT32_MAX; enum attributes such as
# `hot`, `cold`, `noinline`, `norecurse`, and `alwaysinline` are name-resolved so this remains
# stable across LLVM versions instead of hard-coding enum IDs.
extern LLVMAttributeRef
extern LLVMGetEnumAttributeKindForName(name: cstr, length: usize) -> u32
extern LLVMCreateEnumAttribute(ctx: LLVMContextRef, kind: u32, value: u64) -> LLVMAttributeRef
extern LLVMCreateTypeAttribute(ctx: LLVMContextRef, kind: u32, type: LLVMTypeRef) -> LLVMAttributeRef
extern LLVMCreateStringAttribute(ctx: LLVMContextRef, key: cstr, key_length: u32, value: cstr, value_length: u32) -> LLVMAttributeRef
extern LLVMAddAttributeAtIndex(function: LLVMValueRef, index: u32, attribute: LLVMAttributeRef) -> void
extern LLVMAddCallSiteAttribute(call: LLVMValueRef, index: u32, attribute: LLVMAttributeRef) -> void
extern LLVMSetFunctionCallConv(function: LLVMValueRef, calling_convention: u32) -> void
extern LLVMSetFastMathFlags(value: LLVMValueRef, flags: u32) -> void

# Reading metadata back AFTER the passes — the `-Wperf` verification half. These all return
# NULL for "absent" (a block with no terminator, an instruction with no such metadata, a
# value that is not an MDNode), so they bind as optionals.
extern LLVMGetFirstFunction(m: LLVMModuleRef) -> LLVMValueRef?
extern LLVMGetNextFunction(f: LLVMValueRef) -> LLVMValueRef?
extern LLVMGetFirstBasicBlock(f: LLVMValueRef) -> LLVMBasicBlockRef?
# "Is this value referenced by anything?" — NULL when it has no users. The stripped body of
# a DECLINED function leaves a bare `declare`; whether that declaration is still CALLED is
# the whole difference between a harmless dead drop and an object that cannot link.
extern LLVMUseRef
extern LLVMGetFirstUse(v: LLVMValueRef) -> LLVMUseRef?
extern LLVMGetNextUse(use: LLVMUseRef) -> LLVMUseRef?
extern LLVMGetUser(use: LLVMUseRef) -> LLVMValueRef
extern LLVMIsAInstruction(value: LLVMValueRef) -> LLVMValueRef?
extern LLVMGetNextBasicBlock(b: LLVMBasicBlockRef) -> LLVMBasicBlockRef?
extern LLVMDeleteBasicBlock(b: LLVMBasicBlockRef) -> void
extern LLVMGetBasicBlockTerminator(b: LLVMBasicBlockRef) -> LLVMValueRef?
extern LLVMGetMetadata(v: LLVMValueRef, kind: u32) -> LLVMValueRef?
extern LLVMIsAMDNode(v: LLVMValueRef) -> LLVMValueRef?
extern LLVMGetMDNodeNumOperands(v: LLVMValueRef) -> u32
extern LLVMGetMDNodeOperands(v: LLVMValueRef, dest: void&) -> void
# Returns NULL when `v` is not an MDString. `cstr?` is rejected (cstr has no spare null), so
# it binds as an optional POINTER and the caller casts.
extern LLVMGetMDString(v: LLVMValueRef, length_out: void&) -> void&?

# --- DWARF (DIBuilder) ----------------------------------------------------------------
# Debug info is built DURING emission and only reaches the object file; stage0's own
# `-emit llvm -g` shows none of it, so the oracle here is dwarfdump on the emitted object,
# not an IR diff.
extern LLVMDIBuilderRef
extern LLVMCreateDIBuilder(m: LLVMModuleRef) -> LLVMDIBuilderRef
extern LLVMDIBuilderFinalize(dib: LLVMDIBuilderRef) -> void
extern LLVMDIBuilderCreateFile(dib: LLVMDIBuilderRef, filename: cstr, filename_len: usize, directory: cstr, directory_len: usize) -> LLVMMetadataRef
# The long tail of zeros is: isOptimized, flags, runtimeVer, splitName, kind, dwoId,
# splitDebugInlining, debugInfoForProfiling, sysroot, sdk. stage0 passes
# LLVMDWARFEmissionFull (=1) for `kind`.
extern LLVMDIBuilderCreateCompileUnit(dib: LLVMDIBuilderRef, lang: i32, file: LLVMMetadataRef, producer: cstr, producer_len: usize, is_optimized: i32, flags: cstr, flags_len: usize, runtime_ver: u32, split_name: cstr, split_name_len: usize, kind: i32, dwo_id: u32, split_debug_inlining: i32, debug_info_for_profiling: i32, sysroot: cstr, sysroot_len: usize, sdk: cstr, sdk_len: usize) -> LLVMMetadataRef
extern LLVMDIBuilderCreateSubroutineType(dib: LLVMDIBuilderRef, file: LLVMMetadataRef, parameter_types: void&?, num_parameter_types: u32, flags: i32) -> LLVMMetadataRef
# A DWARF base type (`DW_TAG_base_type`). `encoding` is a DW_ATE code: 2 boolean,
# 4 float, 5 signed, 7 unsigned, 8 unsigned_char. Without these the subroutine type has no
# parameter types and a debugger shows a function with no signature.
extern LLVMDIBuilderCreateBasicType(dib: LLVMDIBuilderRef, name: cstr, name_len: usize, size_in_bits: u64, encoding: u32, flags: i32) -> LLVMMetadataRef
extern LLVMDIBuilderCreateFunction(dib: LLVMDIBuilderRef, scope: LLVMMetadataRef, name: cstr, name_len: usize, linkage_name: cstr, linkage_name_len: usize, file: LLVMMetadataRef, line: u32, ty: LLVMMetadataRef, is_local_to_unit: i32, is_definition: i32, scope_line: u32, flags: i32, is_optimized: i32) -> LLVMMetadataRef
extern LLVMSetSubprogram(fn: LLVMValueRef, sp: LLVMMetadataRef) -> void
extern LLVMGetSubprogram(fn: LLVMValueRef) -> LLVMMetadataRef
# Local-variable debug info. A variable DIE only reaches the object when a DECLARE record
# ties it to its storage, which is why these must run at the alloca, not in a later pass.
extern LLVMDbgRecordRef
extern LLVMDIBuilderCreateParameterVariable(dib: LLVMDIBuilderRef, scope: LLVMMetadataRef, name: cstr, name_len: usize, arg_no: u32, file: LLVMMetadataRef, line: u32, ty: LLVMMetadataRef, always_preserve: i32, flags: i32) -> LLVMMetadataRef
extern LLVMDIBuilderCreateAutoVariable(dib: LLVMDIBuilderRef, scope: LLVMMetadataRef, name: cstr, name_len: usize, file: LLVMMetadataRef, line: u32, ty: LLVMMetadataRef, always_preserve: i32, flags: i32, align_in_bits: u32) -> LLVMMetadataRef
extern LLVMDIBuilderCreateExpression(dib: LLVMDIBuilderRef, addr: void&?, length: usize) -> LLVMMetadataRef
extern LLVMDIBuilderCreateDebugLocation(ctx: LLVMContextRef, line: u32, column: u32, scope: LLVMMetadataRef, inlined_at: LLVMMetadataRef?) -> LLVMMetadataRef
extern LLVMDIBuilderInsertDeclareRecordAtEnd(dib: LLVMDIBuilderRef, storage: LLVMValueRef, var_info: LLVMMetadataRef, expr: LLVMMetadataRef, debug_loc: LLVMMetadataRef, block: LLVMBasicBlockRef) -> LLVMDbgRecordRef
# The module flags LLVM requires before it will emit DWARF at all.
extern LLVMValueAsMetadata(v: LLVMValueRef) -> LLVMMetadataRef
extern LLVMAddModuleFlag(m: LLVMModuleRef, behavior: i32, key: cstr, key_len: usize, val: LLVMMetadataRef) -> void

extern LLVMPassBuilderOptionsRef
extern LLVMCreatePassBuilderOptions() -> LLVMPassBuilderOptionsRef
extern LLVMDisposePassBuilderOptions(o: LLVMPassBuilderOptionsRef) -> void
extern LLVMPassBuilderOptionsSetLoopInterleaving(o: LLVMPassBuilderOptionsRef, value: i32) -> void
extern LLVMPassBuilderOptionsSetLoopVectorization(o: LLVMPassBuilderOptionsRef, value: i32) -> void
extern LLVMPassBuilderOptionsSetSLPVectorization(o: LLVMPassBuilderOptionsRef, value: i32) -> void
extern LLVMPassBuilderOptionsSetLoopUnrolling(o: LLVMPassBuilderOptionsRef, value: i32) -> void
# Returns an LLVMErrorRef that is NULL on SUCCESS, so it binds as an optional pointer:
# `is` narrowing then reads "an error is present" rather than needing a null compare.
extern LLVMRunPasses(m: LLVMModuleRef, passes: cstr, tm: LLVMTargetMachineRef, o: LLVMPassBuilderOptionsRef) -> void&?
extern LLVMSetTarget(m: LLVMModuleRef, triple: cstr)

# --- types ----------------------------------------------------------------
extern LLVMInt1TypeInContext(ctx: LLVMContextRef) -> LLVMTypeRef
# An integer type of ARBITRARY width — the sub-byte widths a bitfield-backed const enum
# needs (`const enum Mode of u4` is a real `i4` in stage0's IR, not a widened i8).
extern LLVMIntTypeInContext(ctx: LLVMContextRef, bits: u32) -> LLVMTypeRef
extern LLVMInt8TypeInContext(ctx: LLVMContextRef) -> LLVMTypeRef
extern LLVMInt16TypeInContext(ctx: LLVMContextRef) -> LLVMTypeRef
extern LLVMInt32TypeInContext(ctx: LLVMContextRef) -> LLVMTypeRef
extern LLVMInt64TypeInContext(ctx: LLVMContextRef) -> LLVMTypeRef
extern LLVMFloatTypeInContext(ctx: LLVMContextRef) -> LLVMTypeRef
extern LLVMDoubleTypeInContext(ctx: LLVMContextRef) -> LLVMTypeRef
extern LLVMVoidTypeInContext(ctx: LLVMContextRef) -> LLVMTypeRef
# `params` is an `LLVMTypeRef*`; pass a null pointer when count is 0.
extern LLVMFunctionType(ret: LLVMTypeRef, params: void&?, count: u32, is_vararg: i32) -> LLVMTypeRef

# --- functions / blocks ---------------------------------------------------
extern LLVMAddFunction(m: LLVMModuleRef, name: cstr, fn_type: LLVMTypeRef) -> LLVMValueRef
extern LLVMLookupIntrinsicID(name: cstr, name_length: usize) -> u32
extern LLVMGetIntrinsicDeclaration(m: LLVMModuleRef, id: u32, param_types: void&?, param_count: usize) -> LLVMValueRef
extern LLVMAppendBasicBlockInContext(ctx: LLVMContextRef, fn: LLVMValueRef, name: cstr) -> LLVMBasicBlockRef

# --- builder --------------------------------------------------------------
extern LLVMCreateBuilderInContext(ctx: LLVMContextRef) -> LLVMBuilderRef
extern LLVMDisposeBuilder(b: LLVMBuilderRef)
extern LLVMPositionBuilderAtEnd(b: LLVMBuilderRef, block: LLVMBasicBlockRef)
extern LLVMBuildRet(b: LLVMBuilderRef, value: LLVMValueRef) -> LLVMValueRef
extern LLVMBuildRetVoid(b: LLVMBuilderRef) -> LLVMValueRef

# --- arithmetic -----------------------------------------------------------
# `name` is the IR value name (cosmetic; "" is fine). Div/Rem are the SIGNED forms:
# the modeled subset is `i64`, and stage0 likewise picks SDiv/SRem for a signed operand
# type (isSignedIntegerType) and UDiv/URem otherwise.
extern LLVMBuildAdd(b: LLVMBuilderRef, lhs: LLVMValueRef, rhs: LLVMValueRef, name: cstr) -> LLVMValueRef
extern LLVMBuildSub(b: LLVMBuilderRef, lhs: LLVMValueRef, rhs: LLVMValueRef, name: cstr) -> LLVMValueRef
extern LLVMBuildMul(b: LLVMBuilderRef, lhs: LLVMValueRef, rhs: LLVMValueRef, name: cstr) -> LLVMValueRef
extern LLVMBuildSDiv(b: LLVMBuilderRef, lhs: LLVMValueRef, rhs: LLVMValueRef, name: cstr) -> LLVMValueRef
extern LLVMBuildSRem(b: LLVMBuilderRef, lhs: LLVMValueRef, rhs: LLVMValueRef, name: cstr) -> LLVMValueRef
extern LLVMBuildNeg(b: LLVMBuilderRef, value: LLVMValueRef, name: cstr) -> LLVMValueRef

# Bitwise / shift. `>>` is ARITHMETIC (AShr), not logical: the subset is signed i64, so
# the sign bit must replicate — stage0 agrees (verified: -8 >> 1 == -4).
extern LLVMBuildAnd(b: LLVMBuilderRef, lhs: LLVMValueRef, rhs: LLVMValueRef, name: cstr) -> LLVMValueRef
extern LLVMBuildOr(b: LLVMBuilderRef, lhs: LLVMValueRef, rhs: LLVMValueRef, name: cstr) -> LLVMValueRef
extern LLVMBuildXor(b: LLVMBuilderRef, lhs: LLVMValueRef, rhs: LLVMValueRef, name: cstr) -> LLVMValueRef
extern LLVMBuildShl(b: LLVMBuilderRef, lhs: LLVMValueRef, rhs: LLVMValueRef, name: cstr) -> LLVMValueRef
extern LLVMBuildAShr(b: LLVMBuilderRef, lhs: LLVMValueRef, rhs: LLVMValueRef, name: cstr) -> LLVMValueRef
# Unsigned counterparts. stage0 selects these for an unsigned operand type: `u8 200 / 3`
# is 66 (udiv), `u8 200 >> 1` is 100 (lshr) — the signed instructions give -56 and 228.
extern LLVMBuildUDiv(b: LLVMBuilderRef, lhs: LLVMValueRef, rhs: LLVMValueRef, name: cstr) -> LLVMValueRef
extern LLVMBuildURem(b: LLVMBuilderRef, lhs: LLVMValueRef, rhs: LLVMValueRef, name: cstr) -> LLVMValueRef
extern LLVMBuildLShr(b: LLVMBuilderRef, lhs: LLVMValueRef, rhs: LLVMValueRef, name: cstr) -> LLVMValueRef
# Width conversion: SExt/ZExt widen (sign- vs zero-extending), Trunc narrows.
extern LLVMBuildSExt(b: LLVMBuilderRef, value: LLVMValueRef, t: LLVMTypeRef, name: cstr) -> LLVMValueRef
extern LLVMBuildTrunc(b: LLVMBuilderRef, value: LLVMValueRef, t: LLVMTypeRef, name: cstr) -> LLVMValueRef
extern LLVMGetIntTypeWidth(t: LLVMTypeRef) -> u32
extern LLVMTypeOf(value: LLVMValueRef) -> LLVMTypeRef
extern LLVMBuildNot(b: LLVMBuilderRef, value: LLVMValueRef, name: cstr) -> LLVMValueRef

# --- float ----------------------------------------------------------------
# A float literal is built straight from its SOURCE TEXT (LLVMConstRealOfString), so the
# backend never re-parses a decimal — LLVM's own parser decides the exact bits, which is
# both simpler and less likely to disagree with stage0 on rounding.
extern LLVMConstRealOfString(t: LLVMTypeRef, text: cstr) -> LLVMValueRef
# Folding a float CONST EXPRESSION (`const D: f64 = W - S`) needs the leaves as actual
# doubles. Rather than teach the backend to parse decimals -- which is exactly what the
# comment above says not to do -- build each leaf with ConstRealOfString and read it back
# with ConstRealGetDouble, so LLVM's parser still decides the bits. `loses_info` is an
# out-parameter LLVMBool; it is set when the value is not exactly representable.
extern LLVMConstRealGetDouble(value: LLVMValueRef, loses_info: mutable i32&) -> f64
extern LLVMConstReal(t: LLVMTypeRef, value: f64) -> LLVMValueRef
extern LLVMBuildFAdd(b: LLVMBuilderRef, lhs: LLVMValueRef, rhs: LLVMValueRef, name: cstr) -> LLVMValueRef
extern LLVMBuildFSub(b: LLVMBuilderRef, lhs: LLVMValueRef, rhs: LLVMValueRef, name: cstr) -> LLVMValueRef
extern LLVMBuildFMul(b: LLVMBuilderRef, lhs: LLVMValueRef, rhs: LLVMValueRef, name: cstr) -> LLVMValueRef
extern LLVMBuildFDiv(b: LLVMBuilderRef, lhs: LLVMValueRef, rhs: LLVMValueRef, name: cstr) -> LLVMValueRef
extern LLVMBuildFRem(b: LLVMBuilderRef, lhs: LLVMValueRef, rhs: LLVMValueRef, name: cstr) -> LLVMValueRef
extern LLVMBuildFNeg(b: LLVMBuilderRef, value: LLVMValueRef, name: cstr) -> LLVMValueRef
# LLVMRealPredicate: OEQ=1, OGT=2, OGE=3, OLT=4, OLE=5, ONE=6. The ORDERED forms: any
# comparison with NaN is false, which is IEEE `==`/`<` semantics.
extern LLVMBuildFCmp(b: LLVMBuilderRef, predicate: i32, lhs: LLVMValueRef, rhs: LLVMValueRef, name: cstr) -> LLVMValueRef
# int <-> float and float-width conversion. SI/UI pick the SOURCE's signedness; FPToSI
# truncates toward zero (which is what `.i64()` on a float means).
extern LLVMBuildSIToFP(b: LLVMBuilderRef, value: LLVMValueRef, t: LLVMTypeRef, name: cstr) -> LLVMValueRef
extern LLVMBuildUIToFP(b: LLVMBuilderRef, value: LLVMValueRef, t: LLVMTypeRef, name: cstr) -> LLVMValueRef
extern LLVMBuildFPToSI(b: LLVMBuilderRef, value: LLVMValueRef, t: LLVMTypeRef, name: cstr) -> LLVMValueRef
extern LLVMBuildFPToUI(b: LLVMBuilderRef, value: LLVMValueRef, t: LLVMTypeRef, name: cstr) -> LLVMValueRef
extern LLVMBuildFPExt(b: LLVMBuilderRef, value: LLVMValueRef, t: LLVMTypeRef, name: cstr) -> LLVMValueRef
extern LLVMBuildFPTrunc(b: LLVMBuilderRef, value: LLVMValueRef, t: LLVMTypeRef, name: cstr) -> LLVMValueRef

# --- constants ------------------------------------------------------------
extern LLVMConstInt(t: LLVMTypeRef, value: u64, sign_extend: i32) -> LLVMValueRef

# --- memory (locals) ------------------------------------------------------
# Locals are stack slots: `alloca` in the entry block, `store` to assign, `load` to read.
# mem2reg/SROA promote them to SSA registers at -O2, so this costs nothing in the output.
# LLVMBuildLoad2 takes the POINTEE type explicitly (LLVM pointers are opaque).
# --- aggregates -----------------------------------------------------------
# A named struct is created empty and BODY-SET afterwards (LLVMStructSetBody), so a struct
# can refer to itself or to one declared later without a forward-declaration dance.
# LLVMBuildStructGEP2 needs the struct TYPE explicitly — LLVM pointers are opaque, so the
# type cannot be recovered from the pointer.
# A fixed array `T[N]`. LLVMBuildGEP2 walks it with TWO indices — the first steps over
# the array pointer itself (always 0 here), the second selects the element. That is the
# classic C-array GEP shape; StructGEP cannot be used because the index is dynamic.
# A darray is `{ptr items, i64 count, i64 capacity}` and its backing memory comes from an
# `Arena` — this is where the backend stops being self-contained and calls Elisa's runtime
# (arena_alloc / arena_realloc / arena_free), so emitted programs must now link
# elisacore_runtime.o. Layouts are dictated by that runtime, read out of stage0's own
# `-emit llvm` output; they are NOT a choice this backend gets to make.
extern LLVMPointerTypeInContext(ctx: LLVMContextRef, address_space: u32) -> LLVMTypeRef
# Emits exactly stage0's shape for a string literal: a `private unnamed_addr constant
# [N x i8]` plus a pointer to it (verified against `@str = ... c"hi\00"` in its -emit llvm
# output). Building the global and the GEP by hand would be the same IR with more rope.
extern LLVMBuildGlobalStringPtr(builder: LLVMBuilderRef, str: cstr, name: cstr) -> LLVMValueRef
# The module's source filename. Both stages use a stable source basename here: LLVM's target
# machine must not change code generation merely because the caller used an absolute path.
# Full paths remain in source diagnostics and generated `#line` directives. The panic lowering
# reads this basename back for its message, so the two LLVM uses are one fact stored once.
extern LLVMSetSourceFileName(m: LLVMModuleRef, name: cstr, length: usize) -> void
extern LLVMGetSourceFileName(m: LLVMModuleRef, length: usize&) -> cstr
extern LLVMSetModuleIdentifier(m: LLVMModuleRef, ident: cstr, length: usize) -> void
extern LLVMConstNull(t: LLVMTypeRef) -> LLVMValueRef
# `LLVMConstNull(pointer_type)` is a valid LLVMValueRef whose C handle is NOT zero.
# Code that needs to distinguish an absent API handle from an LLVM null constant must
# ask LLVM; comparing the opaque handle with Elisa's `zeroed` value is insufficient.
extern LLVMIsNull(value: LLVMValueRef) -> i32
extern LLVMBuildSelect(b: LLVMBuilderRef, cond: LLVMValueRef, then_value: LLVMValueRef, else_value: LLVMValueRef, name: cstr) -> LLVMValueRef
extern LLVMStructTypeInContext(ctx: LLVMContextRef, elements: void&?, count: u32, is_packed: i32) -> LLVMTypeRef
extern LLVMSetInitializer(global_value: LLVMValueRef, value: LLVMValueRef)
extern LLVMConstNamedStruct(t: LLVMTypeRef, values: void&?, count: u32) -> LLVMValueRef

extern LLVMArrayType(element: LLVMTypeRef, count: u32) -> LLVMTypeRef
extern LLVMBuildGEP2(b: LLVMBuilderRef, t: LLVMTypeRef, ptr: LLVMValueRef, indices: void&?, count: u32, name: cstr) -> LLVMValueRef

# Module-level GLOBALS — the backing for a global const AGGREGATE (`const xs: i64[3] = […]`,
# which stage0 lowers to `@xs = internal constant [3 x i64] […]`, indexed by GEP at each use).
extern LLVMAddGlobal(m: LLVMModuleRef, t: LLVMTypeRef, name: cstr) -> LLVMValueRef
extern LLVMAddAlias2(m: LLVMModuleRef, t: LLVMTypeRef, address_space: u32, aliasee: LLVMValueRef, name: cstr) -> LLVMValueRef
extern LLVMConstArray2(element_type: LLVMTypeRef, values: void&?, length: u64) -> LLVMValueRef
extern LLVMConstInBoundsGEP2(t: LLVMTypeRef, constant: LLVMValueRef, indices: void&?, count: u32) -> LLVMValueRef
# A constant BYTE ARRAY — the storage behind a cstr key in a const dict's bucket table.
# `LLVMBuildGlobalStringPtr` is the usual way to get one, but it needs a BUILDER and the
# const-materialization pass has none, so the array is built and installed by hand.
extern LLVMConstStringInContext(ctx: LLVMContextRef, text: cstr, length: u32, dont_null_terminate: i32) -> LLVMValueRef
extern LLVMSetLinkage(global_value: LLVMValueRef, linkage: u32)
extern LLVMSetUnnamedAddress(global_value: LLVMValueRef, unnamed_address: u32)
extern LLVMSetGlobalConstant(global_value: LLVMValueRef, is_constant: i32)

extern LLVMStructCreateNamed(ctx: LLVMContextRef, name: cstr) -> LLVMTypeRef
extern LLVMGetTypeByName2(ctx: LLVMContextRef, name: cstr) -> LLVMTypeRef
extern LLVMStructSetBody(t: LLVMTypeRef, elements: void&?, count: u32, is_packed: i32)
extern LLVMBuildStructGEP2(b: LLVMBuilderRef, t: LLVMTypeRef, ptr: LLVMValueRef, index: u32, name: cstr) -> LLVMValueRef
# Reads a field out of an aggregate VALUE (no pointer involved) — how stage0 reads a
# payload enum's tag: `%tag = extractvalue %Shape %sh, 0`.
extern LLVMBuildExtractValue(b: LLVMBuilderRef, agg: LLVMValueRef, index: u32, name: cstr) -> LLVMValueRef
# Writes a field into an aggregate VALUE, yielding a new value — how stage0 builds a
# packed store: three chained insertvalues (arena, row_bytes, state).
extern LLVMBuildInsertValue(b: LLVMBuilderRef, agg: LLVMValueRef, elt: LLVMValueRef, index: u32, name: cstr) -> LLVMValueRef
extern LLVMGetUndef(t: LLVMTypeRef) -> LLVMValueRef

extern LLVMBuildAlloca(b: LLVMBuilderRef, t: LLVMTypeRef, name: cstr) -> LLVMValueRef
extern LLVMBuildStore(b: LLVMBuilderRef, value: LLVMValueRef, ptr: LLVMValueRef) -> LLVMValueRef
extern LLVMBuildLoad2(b: LLVMBuilderRef, t: LLVMTypeRef, ptr: LLVMValueRef, name: cstr) -> LLVMValueRef
extern LLVMBuildMemCpy(b: LLVMBuilderRef, dst: LLVMValueRef, dst_align: u32, src: LLVMValueRef, src_align: u32, size: LLVMValueRef) -> LLVMValueRef

# --- atomics -------------------------------------------------------------
# LLVMAtomicOrdering: NotAtomic=0, Unordered=1, Monotonic=2, Acquire=4,
#   Release=5, AcquireRelease=6, SequentiallyConsistent=7. Passed as i32.
# LLVMAtomicRMWBinOp: Xchg=0, Add=1, Sub=2, And=3, Nand=4, Or=5, Xor=6.
# An atomic load/store is an ordinary load/store with its ordering set AND its alignment
# set (LLVM verifier REJECTS an atomic access with no alignment). RMW is a single instr.
extern LLVMSetOrdering(inst: LLVMValueRef, ordering: i32)
extern LLVMSetAlignment(v: LLVMValueRef, bytes: u32)
extern LLVMBuildAtomicRMW(b: LLVMBuilderRef, op: i32, ptr: LLVMValueRef, value: LLVMValueRef, ordering: i32, single_thread: i32) -> LLVMValueRef
extern LLVMBuildFence(b: LLVMBuilderRef, ordering: i32, single_thread: i32, name: cstr) -> LLVMValueRef

# --- comparison -----------------------------------------------------------
# LLVMIntPredicate: EQ=32, NE=33, UGT=34, UGE=35, ULT=36, ULE=37,
#                   SGT=38, SGE=39, SLT=40, SLE=41.
# The modeled subset is signed i64, so ordering uses the S* predicates.
extern LLVMBuildICmp(b: LLVMBuilderRef, predicate: i32, lhs: LLVMValueRef, rhs: LLVMValueRef, name: cstr) -> LLVMValueRef
extern LLVMBuildZExt(b: LLVMBuilderRef, value: LLVMValueRef, t: LLVMTypeRef, name: cstr) -> LLVMValueRef
extern LLVMBuildBitCast(b: LLVMBuilderRef, value: LLVMValueRef, t: LLVMTypeRef, name: cstr) -> LLVMValueRef
# A pointer <-> integer conversion is NOT an integer widening: `zext ptr ... to i64` is
# invalid IR that llc rejects outright. The std's arena_tail_offset_slots takes a pointer
# DIFFERENCE via `.usize()`, which needs these.
extern LLVMBuildPtrToInt(b: LLVMBuilderRef, value: LLVMValueRef, t: LLVMTypeRef, name: cstr) -> LLVMValueRef
extern LLVMBuildIntToPtr(b: LLVMBuilderRef, value: LLVMValueRef, t: LLVMTypeRef, name: cstr) -> LLVMValueRef

# --- control flow ---------------------------------------------------------
extern LLVMBuildBr(b: LLVMBuilderRef, dest: LLVMBasicBlockRef) -> LLVMValueRef
extern LLVMBuildCondBr(b: LLVMBuilderRef, cond: LLVMValueRef, then_block: LLVMBasicBlockRef, else_block: LLVMBasicBlockRef) -> LLVMValueRef
extern LLVMGetInsertBlock(b: LLVMBuilderRef) -> LLVMBasicBlockRef
extern LLVMGetBasicBlockParent(block: LLVMBasicBlockRef) -> LLVMValueRef
extern LLVMGetEntryBasicBlock(function: LLVMValueRef) -> LLVMBasicBlockRef
extern LLVMGetFirstInstruction(block: LLVMBasicBlockRef) -> LLVMValueRef?
extern LLVMGetNextInstruction(inst: LLVMValueRef) -> LLVMValueRef?
extern LLVMGetInstructionOpcode(inst: LLVMValueRef) -> u32
extern LLVMPositionBuilderBefore(b: LLVMBuilderRef, inst: LLVMValueRef)
extern LLVMGetInstructionParent(inst: LLVMValueRef) -> LLVMBasicBlockRef
extern LLVMBuildUnreachable(b: LLVMBuilderRef) -> LLVMValueRef
# The size (in bytes) of a type, as an i64 CONSTANT. Uses the module datalayout, so it is
# correct for aggregates (structs) too -- unlike a hardcoded scalar width. Resolved at
# codegen; no target-data handle needed.
extern LLVMSizeOf(ty: LLVMTypeRef) -> LLVMValueRef
# Read an integer constant produced by LLVMSizeOf. The aggregate ABI classifier uses
# LLVM's target DataLayout rather than a duplicate handwritten layout model; this keeps
# the declaration and call paths in lockstep for large self-hosting compiler structs.
extern LLVMConstIntGetZExtValue(value: LLVMValueRef) -> u64
# Returns NULL when no function of that name exists. The old `-> T?`-always-binds-null bug
# was fixed (stale-bug sweep 2026-07-17); used here to declare `abort` at most once.
extern LLVMGetNamedFunction(m: LLVMModuleRef, name: cstr) -> LLVMValueRef?

# A value's name, `length` receiving the byte count. Used to report a declined generic
# INSTANTIATION by its mangled name (`arena_dict_put__i64__i64`) rather than the template's
# base name -- with several instantiations of one template, the base alone does not say
# which one failed.
extern LLVMGetValueName2(value: LLVMValueRef, length: mutable usize&) -> cstr
extern LLVMGetOperand(value: LLVMValueRef, index: u32) -> LLVMValueRef
extern LLVMGetNumOperands(value: LLVMValueRef) -> u32

# --- calls / params -------------------------------------------------------
# NOTE: LLVMGetBasicBlockTerminator is deliberately NOT bound (EmitStatus tracks it). But
# LLVMGetNamedFunction IS bound above now: the `-> T?`-always-binds-null bug it was avoiding
# was fixed (verified -- contract abort emits exactly ONE `declare void @abort`).
# Both return a pointer that is NULL-or-not, i.e. they want `-> LLVMValueRef?` — and an
# extern declared to return an optional of an opaque extern type ALWAYS binds null in
# stage0, even when C returns a real pointer (isolated repro filed; it is silent, with no
# diagnostic). The backend therefore tracks both facts itself: `FnTable` for name lookup
# and `EmitStatus` for block termination. That is independently better — both are things
# the emitter already knows and need not ask LLVM to recompute.
extern LLVMGetParam(fn: LLVMValueRef, index: u32) -> LLVMValueRef
extern LLVMCountParams(fn: LLVMValueRef) -> u32
# `args` is an `LLVMValueRef*`; pass null when count is 0.
extern LLVMBuildCall2(b: LLVMBuilderRef, fn_type: LLVMTypeRef, fn: LLVMValueRef, args: void&?, count: u32, name: cstr) -> LLVMValueRef
extern LLVMGlobalGetValueType(global_value: LLVMValueRef) -> LLVMTypeRef
# LLVMInlineAsmDialectATT = 0.  The C enum is passed as an i32 because Elisa's extern
# declarations do not need to reproduce LLVM's private enum type.
extern LLVMGetInlineAsm(ty: LLVMTypeRef, asm_text: cstr, asm_length: usize, constraints: cstr, constraints_length: usize, has_side_effects: i32, is_align_stack: i32, dialect: i32, can_throw: i32) -> LLVMValueRef

# --- verify / emit --------------------------------------------------------
# LLVMVerifyModule's action 2 = LLVMReturnStatusAction (report, do not abort).
extern LLVMVerifyModule(m: LLVMModuleRef, action: i32, message: void&?) -> i32
extern LLVMPrintModuleToFile(m: LLVMModuleRef, path: cstr, message: void&?) -> i32

# Type walking for the C ABI classifier at export boundaries (codegen_declare).
extern LLVMGetTypeKind(ty: LLVMTypeRef) -> u32
extern LLVMCountStructElementTypes(ty: LLVMTypeRef) -> u32
extern LLVMStructGetTypeAtIndex(ty: LLVMTypeRef, index: u32) -> LLVMTypeRef
extern LLVMGetElementType(ty: LLVMTypeRef) -> LLVMTypeRef
extern LLVMGetArrayLength2(ty: LLVMTypeRef) -> u64
extern LLVMVectorType(element: LLVMTypeRef, count: u32) -> LLVMTypeRef
