# Stage1 backend — LLVM-C bindings (`module LlvmC`).
#
# Stage0's backend is cgo over <llvm-c/Core.h>. LLVM-C is a C API, so stage1 binds it
# with plain `extern` declarations — no extern-C bridge is needed (that is only required
# for C++ APIs). The handle types are opaque: LLVM's `LLVMModuleRef` and friends are
# pointers we only ever hand back to LLVM, so Elisa never needs their layout.
#
# These are declared at TOP LEVEL, not inside a `module`: an extern nested in a module is
# name-mangled (`_LlvmC.LLVMAddFunction`), which does not match the C symbol. The std
# declares its externs the same way (see elisacore_std/arena.elisa's `extern malloc`).
#
# Linking: `-emit obj` emits only the module object; the Elisa runtime (arena_free et al.)
# lives in a separately-generated `elisacore_runtime.o`. `-emit c-archive` bundles both,
# but it currently MIS-COMPILES this tree (the packed-store analysis fails — the
# unmodified test/breadth/parse_report.elisa reproduces it), so the build extracts the
# runtime object out of a throwaway c-archive and links it alongside `-emit obj` output.
# See test/parity/backend_native_smoke.sh.

# --- opaque handles -------------------------------------------------------
extern LLVMContextRef
extern LLVMModuleRef
extern LLVMTypeRef
extern LLVMValueRef
extern LLVMBuilderRef
extern LLVMBasicBlockRef

# --- context / module -----------------------------------------------------
extern LLVMContextCreate() -> LLVMContextRef
extern LLVMContextDispose(ctx: LLVMContextRef)
extern LLVMModuleCreateWithNameInContext(name: cstr, ctx: LLVMContextRef) -> LLVMModuleRef
extern LLVMDisposeModule(m: LLVMModuleRef)
extern LLVMPrintModuleToString(m: LLVMModuleRef) -> cstr
extern LLVMSetTarget(m: LLVMModuleRef, triple: cstr)

# --- types ----------------------------------------------------------------
extern LLVMInt1TypeInContext(ctx: LLVMContextRef) -> LLVMTypeRef
extern LLVMInt8TypeInContext(ctx: LLVMContextRef) -> LLVMTypeRef
extern LLVMInt16TypeInContext(ctx: LLVMContextRef) -> LLVMTypeRef
extern LLVMInt32TypeInContext(ctx: LLVMContextRef) -> LLVMTypeRef
extern LLVMInt64TypeInContext(ctx: LLVMContextRef) -> LLVMTypeRef
extern LLVMFloatTypeInContext(ctx: LLVMContextRef) -> LLVMTypeRef
extern LLVMDoubleTypeInContext(ctx: LLVMContextRef) -> LLVMTypeRef
extern LLVMVoidTypeInContext(ctx: LLVMContextRef) -> LLVMTypeRef
# `params` is an `LLVMTypeRef*`; pass a null pointer when count is 0.
extern LLVMFunctionType(ret: LLVMTypeRef, params: void&?, count: u32, is_vararg: i32) -> LLVMTypeRef

# --- functions / blocks ---------------------------------------------------
extern LLVMAddFunction(m: LLVMModuleRef, name: cstr, fn_type: LLVMTypeRef) -> LLVMValueRef
extern LLVMAppendBasicBlockInContext(ctx: LLVMContextRef, fn: LLVMValueRef, name: cstr) -> LLVMBasicBlockRef

# --- builder --------------------------------------------------------------
extern LLVMCreateBuilderInContext(ctx: LLVMContextRef) -> LLVMBuilderRef
extern LLVMDisposeBuilder(b: LLVMBuilderRef)
extern LLVMPositionBuilderAtEnd(b: LLVMBuilderRef, block: LLVMBasicBlockRef)
extern LLVMBuildRet(b: LLVMBuilderRef, value: LLVMValueRef) -> LLVMValueRef
extern LLVMBuildRetVoid(b: LLVMBuilderRef) -> LLVMValueRef

# --- arithmetic -----------------------------------------------------------
# `name` is the IR value name (cosmetic; "" is fine). Div/Rem are the SIGNED forms:
# the modeled subset is `i64`, and stage0 likewise picks SDiv/SRem for a signed operand
# type (isSignedIntegerType) and UDiv/URem otherwise.
extern LLVMBuildAdd(b: LLVMBuilderRef, lhs: LLVMValueRef, rhs: LLVMValueRef, name: cstr) -> LLVMValueRef
extern LLVMBuildSub(b: LLVMBuilderRef, lhs: LLVMValueRef, rhs: LLVMValueRef, name: cstr) -> LLVMValueRef
extern LLVMBuildMul(b: LLVMBuilderRef, lhs: LLVMValueRef, rhs: LLVMValueRef, name: cstr) -> LLVMValueRef
extern LLVMBuildSDiv(b: LLVMBuilderRef, lhs: LLVMValueRef, rhs: LLVMValueRef, name: cstr) -> LLVMValueRef
extern LLVMBuildSRem(b: LLVMBuilderRef, lhs: LLVMValueRef, rhs: LLVMValueRef, name: cstr) -> LLVMValueRef
extern LLVMBuildNeg(b: LLVMBuilderRef, value: LLVMValueRef, name: cstr) -> LLVMValueRef

# Bitwise / shift. `>>` is ARITHMETIC (AShr), not logical: the subset is signed i64, so
# the sign bit must replicate — stage0 agrees (verified: -8 >> 1 == -4).
extern LLVMBuildAnd(b: LLVMBuilderRef, lhs: LLVMValueRef, rhs: LLVMValueRef, name: cstr) -> LLVMValueRef
extern LLVMBuildOr(b: LLVMBuilderRef, lhs: LLVMValueRef, rhs: LLVMValueRef, name: cstr) -> LLVMValueRef
extern LLVMBuildXor(b: LLVMBuilderRef, lhs: LLVMValueRef, rhs: LLVMValueRef, name: cstr) -> LLVMValueRef
extern LLVMBuildShl(b: LLVMBuilderRef, lhs: LLVMValueRef, rhs: LLVMValueRef, name: cstr) -> LLVMValueRef
extern LLVMBuildAShr(b: LLVMBuilderRef, lhs: LLVMValueRef, rhs: LLVMValueRef, name: cstr) -> LLVMValueRef
# Unsigned counterparts. stage0 selects these for an unsigned operand type: `u8 200 / 3`
# is 66 (udiv), `u8 200 >> 1` is 100 (lshr) — the signed instructions give -56 and 228.
extern LLVMBuildUDiv(b: LLVMBuilderRef, lhs: LLVMValueRef, rhs: LLVMValueRef, name: cstr) -> LLVMValueRef
extern LLVMBuildURem(b: LLVMBuilderRef, lhs: LLVMValueRef, rhs: LLVMValueRef, name: cstr) -> LLVMValueRef
extern LLVMBuildLShr(b: LLVMBuilderRef, lhs: LLVMValueRef, rhs: LLVMValueRef, name: cstr) -> LLVMValueRef
# Width conversion: SExt/ZExt widen (sign- vs zero-extending), Trunc narrows.
extern LLVMBuildSExt(b: LLVMBuilderRef, value: LLVMValueRef, t: LLVMTypeRef, name: cstr) -> LLVMValueRef
extern LLVMBuildTrunc(b: LLVMBuilderRef, value: LLVMValueRef, t: LLVMTypeRef, name: cstr) -> LLVMValueRef
extern LLVMGetIntTypeWidth(t: LLVMTypeRef) -> u32
extern LLVMTypeOf(value: LLVMValueRef) -> LLVMTypeRef
extern LLVMBuildNot(b: LLVMBuilderRef, value: LLVMValueRef, name: cstr) -> LLVMValueRef

# --- float ----------------------------------------------------------------
# A float literal is built straight from its SOURCE TEXT (LLVMConstRealOfString), so the
# backend never re-parses a decimal — LLVM's own parser decides the exact bits, which is
# both simpler and less likely to disagree with stage0 on rounding.
extern LLVMConstRealOfString(t: LLVMTypeRef, text: cstr) -> LLVMValueRef
extern LLVMBuildFAdd(b: LLVMBuilderRef, lhs: LLVMValueRef, rhs: LLVMValueRef, name: cstr) -> LLVMValueRef
extern LLVMBuildFSub(b: LLVMBuilderRef, lhs: LLVMValueRef, rhs: LLVMValueRef, name: cstr) -> LLVMValueRef
extern LLVMBuildFMul(b: LLVMBuilderRef, lhs: LLVMValueRef, rhs: LLVMValueRef, name: cstr) -> LLVMValueRef
extern LLVMBuildFDiv(b: LLVMBuilderRef, lhs: LLVMValueRef, rhs: LLVMValueRef, name: cstr) -> LLVMValueRef
extern LLVMBuildFRem(b: LLVMBuilderRef, lhs: LLVMValueRef, rhs: LLVMValueRef, name: cstr) -> LLVMValueRef
extern LLVMBuildFNeg(b: LLVMBuilderRef, value: LLVMValueRef, name: cstr) -> LLVMValueRef
# LLVMRealPredicate: OEQ=1, OGT=2, OGE=3, OLT=4, OLE=5, ONE=6. The ORDERED forms: any
# comparison with NaN is false, which is IEEE `==`/`<` semantics.
extern LLVMBuildFCmp(b: LLVMBuilderRef, predicate: i32, lhs: LLVMValueRef, rhs: LLVMValueRef, name: cstr) -> LLVMValueRef
# int <-> float and float-width conversion. SI/UI pick the SOURCE's signedness; FPToSI
# truncates toward zero (which is what `.i64()` on a float means).
extern LLVMBuildSIToFP(b: LLVMBuilderRef, value: LLVMValueRef, t: LLVMTypeRef, name: cstr) -> LLVMValueRef
extern LLVMBuildUIToFP(b: LLVMBuilderRef, value: LLVMValueRef, t: LLVMTypeRef, name: cstr) -> LLVMValueRef
extern LLVMBuildFPToSI(b: LLVMBuilderRef, value: LLVMValueRef, t: LLVMTypeRef, name: cstr) -> LLVMValueRef
extern LLVMBuildFPToUI(b: LLVMBuilderRef, value: LLVMValueRef, t: LLVMTypeRef, name: cstr) -> LLVMValueRef
extern LLVMBuildFPExt(b: LLVMBuilderRef, value: LLVMValueRef, t: LLVMTypeRef, name: cstr) -> LLVMValueRef
extern LLVMBuildFPTrunc(b: LLVMBuilderRef, value: LLVMValueRef, t: LLVMTypeRef, name: cstr) -> LLVMValueRef

# --- constants ------------------------------------------------------------
extern LLVMConstInt(t: LLVMTypeRef, value: u64, sign_extend: i32) -> LLVMValueRef

# --- memory (locals) ------------------------------------------------------
# Locals are stack slots: `alloca` in the entry block, `store` to assign, `load` to read.
# mem2reg/SROA promote them to SSA registers at -O2, so this costs nothing in the output.
# LLVMBuildLoad2 takes the POINTEE type explicitly (LLVM pointers are opaque).
# --- aggregates -----------------------------------------------------------
# A named struct is created empty and BODY-SET afterwards (LLVMStructSetBody), so a struct
# can refer to itself or to one declared later without a forward-declaration dance.
# LLVMBuildStructGEP2 needs the struct TYPE explicitly — LLVM pointers are opaque, so the
# type cannot be recovered from the pointer.
# A fixed array `T[N]`. LLVMBuildGEP2 walks it with TWO indices — the first steps over
# the array pointer itself (always 0 here), the second selects the element. That is the
# classic C-array GEP shape; StructGEP cannot be used because the index is dynamic.
extern LLVMArrayType(element: LLVMTypeRef, count: u32) -> LLVMTypeRef
extern LLVMBuildGEP2(b: LLVMBuilderRef, t: LLVMTypeRef, ptr: LLVMValueRef, indices: void&?, count: u32, name: cstr) -> LLVMValueRef

extern LLVMStructCreateNamed(ctx: LLVMContextRef, name: cstr) -> LLVMTypeRef
extern LLVMStructSetBody(t: LLVMTypeRef, elements: void&?, count: u32, is_packed: i32)
extern LLVMBuildStructGEP2(b: LLVMBuilderRef, t: LLVMTypeRef, ptr: LLVMValueRef, index: u32, name: cstr) -> LLVMValueRef

extern LLVMBuildAlloca(b: LLVMBuilderRef, t: LLVMTypeRef, name: cstr) -> LLVMValueRef
extern LLVMBuildStore(b: LLVMBuilderRef, value: LLVMValueRef, ptr: LLVMValueRef) -> LLVMValueRef
extern LLVMBuildLoad2(b: LLVMBuilderRef, t: LLVMTypeRef, ptr: LLVMValueRef, name: cstr) -> LLVMValueRef

# --- comparison -----------------------------------------------------------
# LLVMIntPredicate: EQ=32, NE=33, UGT=34, UGE=35, ULT=36, ULE=37,
#                   SGT=38, SGE=39, SLT=40, SLE=41.
# The modeled subset is signed i64, so ordering uses the S* predicates.
extern LLVMBuildICmp(b: LLVMBuilderRef, predicate: i32, lhs: LLVMValueRef, rhs: LLVMValueRef, name: cstr) -> LLVMValueRef
extern LLVMBuildZExt(b: LLVMBuilderRef, value: LLVMValueRef, t: LLVMTypeRef, name: cstr) -> LLVMValueRef

# --- control flow ---------------------------------------------------------
extern LLVMBuildBr(b: LLVMBuilderRef, dest: LLVMBasicBlockRef) -> LLVMValueRef
extern LLVMBuildCondBr(b: LLVMBuilderRef, cond: LLVMValueRef, then_block: LLVMBasicBlockRef, else_block: LLVMBasicBlockRef) -> LLVMValueRef
extern LLVMGetInsertBlock(b: LLVMBuilderRef) -> LLVMBasicBlockRef
extern LLVMGetBasicBlockParent(block: LLVMBasicBlockRef) -> LLVMValueRef
extern LLVMBuildUnreachable(b: LLVMBuilderRef) -> LLVMValueRef

# --- calls / params -------------------------------------------------------
# NOTE: LLVMGetNamedFunction / LLVMGetBasicBlockTerminator are deliberately NOT bound.
# Both return a pointer that is NULL-or-not, i.e. they want `-> LLVMValueRef?` — and an
# extern declared to return an optional of an opaque extern type ALWAYS binds null in
# stage0, even when C returns a real pointer (isolated repro filed; it is silent, with no
# diagnostic). The backend therefore tracks both facts itself: `FnTable` for name lookup
# and `EmitStatus` for block termination. That is independently better — both are things
# the emitter already knows and need not ask LLVM to recompute.
extern LLVMGetParam(fn: LLVMValueRef, index: u32) -> LLVMValueRef
extern LLVMCountParams(fn: LLVMValueRef) -> u32
# `args` is an `LLVMValueRef*`; pass null when count is 0.
extern LLVMBuildCall2(b: LLVMBuilderRef, fn_type: LLVMTypeRef, fn: LLVMValueRef, args: void&?, count: u32, name: cstr) -> LLVMValueRef
extern LLVMGlobalGetValueType(global_value: LLVMValueRef) -> LLVMTypeRef

# --- verify / emit --------------------------------------------------------
# LLVMVerifyModule's action 2 = LLVMReturnStatusAction (report, do not abort).
extern LLVMVerifyModule(m: LLVMModuleRef, action: i32, message: void&?) -> i32
extern LLVMPrintModuleToFile(m: LLVMModuleRef, path: cstr, message: void&?) -> i32
