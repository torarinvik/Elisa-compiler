# Stage1 backend — NAMING what the backend refused. A decline that says nothing is
# indistinguishable from a miscompile, so every refusal is recorded in `!elisa.declined` and
# read back out by name. Part of `module Backend` (see codegen.elisa).

extend Backend:
    public:



        # Emit every declaration in `file`. Returns the number emitted, or -1 if ANY
        # declaration was declined.
        #
        # All-or-nothing is the sound choice: a partially-emitted module is WORSE than no
        # module. If `main` is unmodeled but a helper emits, a count-based "did we emit
        # anything?" check reports success and hands back a module quietly missing the
        # program. Declining the whole module keeps "emitted" honest.
        #
        # TWO PASSES: declare every function before emitting any body, so a call to a
        # function defined LATER in the file still resolves. A one-pass emitter would
        # silently decline forward references, which stage0 accepts.
        #
        # Takes `file` BY REFERENCE, mirroring `Semantic::check(file: Ast::File&)` — the
        # AST is a large region-backed structure and there is no reason to copy it.
        #
        # `<-`, NOT `=`: inside a `for … |captures|:` loop a captured scalar must be
        # threaded with `<-`; a plain `=` compiles clean and silently does nothing.
        # `want_debug` emits DWARF (a compile unit + one DISubprogram per function). Kept as a
        # parameter rather than a separate entry point so there is ONE emission path: a
        # second path would drift from this one silently.
        # Strip a half-emitted function back to a bare `declare`: delete every basic
        # block. Used by the per-function tolerance pass — a failed body must not leave
        # unterminated blocks in the module. An unreferenced declaration is linker-
        # stripped; a referenced one fails the LINK loudly, never a silently-wrong binary.
        def strip_function_body(handle: LLVMValueRef) -> void can[Abort.Panic]:
            first_block_opt: mutable LLVMBasicBlockRef? = LLVMGetFirstBasicBlock(handle)
            while first_block_opt is first_block |handle, first_block_opt|:
                LLVMDeleteBasicBlock(first_block)
                first_block_opt <- LLVMGetFirstBasicBlock(handle)




        # Name a declined function in `!elisa.declined`. Without this a decline is SILENT:
        # the body is stripped to a bare `declare`, and the first symptom is a link error
        # naming a mangled symbol with no indication of which function the backend gave up
        # on. (Chasing four such symbols by hand through the real-std dict is what motivated
        # this.) Recorded in the IR itself so `emit_native` output carries it.
        # A function the C RUNTIME also provides. stage0 keeps these external only inside
        # `native_runtime_support.elisa` (isDefaultNativeRuntimeSupportExport); an ORDINARY
        # program that defines its own `arena_alloc` / `new_region` -- as the real std does --
        # must not export them, or linking the program object together with the runtime
        # object fails with "duplicate symbol _new_region".
        #
        # Internal linkage keeps the Elisa definition usable in-module while leaving the
        # runtime's copy to satisfy everyone else. Every OTHER function keeps stage0's
        # default external linkage: stage0 only internalizes wholesale at -O>0
        # (preferPrivateLinkage), which is not this path.
        def name_is_runtime_provided(name: sview) -> bool:
            true return if name == "new_region" or name == "new_region_backend"
            true return if name == "free_region" or name == "free_region_backend"
            true return if name == "arena_alloc" or name == "arena_realloc"
            true return if name == "arena_memcpy" or name == "arena_memeq"
            true return if name == "arena_strdup" or name == "arena_memdup"
            true return if name == "arena_snapshot" or name == "arena_reset"
            true return if name == "arena_rewind" or name == "arena_free"
            true return if name == "arena_adopt" or name == "arena_trim"
            true return if name == "alloc_perm" or name == "alloc_scratch"
            true return if name == "reset_scratch"
            true return if name == "ctx_hash_cstr" or name == "ctx_hash_u64"
            true return if name == "ctx_strlen" or name == "ctx_streq"
            true return if name == "ctx_string_index" or name == "ctx_string_slice"
            true return if name == "ctx_string_slice_eq" or name == "ctx_string_slices_eq"
            true return if name == "ctx_string_view" or name == "ctx_string_view_len"
            true return if name == "ctx_string_view_slice" or name == "ctx_string_view_index"
            true return if name == "ctx_string_view_prefix" or name == "ctx_string_view_suffix"
            true return if name == "ctx_string_view_eq" or name == "ctx_string_views_eq"
            true return if name == "ctx_string_from_view"
            true return if name == "ctx_fstr_alloc" or name == "ctx_fstr_append"
            true return if name == "ctx_llvm_codegen_fatal"
            true return if name == "elisa_trace_record" or name == "elisa_trace_function_entry" or name == "elisa_trace_function_exit" or name == "elisa_trace_record_value"
            true return if name == "elisa_trace_record_id" or name == "elisa_trace_function_entry_id" or name == "elisa_trace_function_exit_id" or name == "elisa_trace_record_value_id"
            true return if name == "elisa_trace_count" or name == "elisa_trace_dump"
            true return if name == "elisa_trace_install_fault_handler"
            # Keep this explicit instead of using a prefix walk: this routine runs while the
            # self-hosted compiler is compiling its own runtime support, so its symbol policy
            # must not depend on an additional string-slice helper being lowered correctly.
            true return if name == "ctx_aos_store_new_with_side_words" or name == "ctx_aos_store_read_side_word" or name == "ctx_aos_store_record_side_words_at"
            true return if name == "ctx_packed_store_alloc" or name == "ctx_packed_store_alloc_fixed_index_result" or name == "ctx_packed_store_alloc_fixed_result"
            true return if name == "ctx_packed_store_alloc_fixed_result_slow" or name == "ctx_packed_store_alloc_fixed_tagged_index_result" or name == "ctx_packed_store_alloc_fixed_tagged_result"
            true return if name == "ctx_packed_store_alloc_fixed_tagged_variant_sparse_result" or name == "ctx_packed_store_alloc_index_result" or name == "ctx_packed_store_alloc_result"
            true return if name == "ctx_packed_store_alloc_result_slow" or name == "ctx_packed_store_alloc_tagged_variant_sparse_result" or name == "ctx_packed_store_count"
            true return if name == "ctx_packed_store_decode" or name == "ctx_packed_store_decode_index" or name == "ctx_packed_store_decode_variant_sparse"
            true return if name == "ctx_packed_store_encode" or name == "ctx_packed_store_encode_index" or name == "ctx_packed_store_encode_variant_sparse"
            true return if name == "ctx_packed_store_index_at" or name == "ctx_packed_store_read_index_tag" or name == "ctx_packed_store_read_index_word"
            true return if name == "ctx_packed_store_read_side_word" or name == "ctx_packed_store_read_tag" or name == "ctx_packed_store_read_variant_sparse_tag"
            true return if name == "ctx_packed_store_read_variant_sparse_word" or name == "ctx_packed_store_read_word" or name == "ctx_packed_store_record_prefix_words"
            true return if name == "ctx_packed_store_record_row_ptr" or name == "ctx_packed_store_record_side_words" or name == "ctx_packed_store_record_side_words_at"
            true return if name == "ctx_packed_store_record_tag" or name == "ctx_packed_store_reserve" or name == "ctx_packed_store_row_ptr_at"
            true return if name == "ctx_packed_store_state_new" or name == "ctx_packed_store_state_new_variant_sparse" or name == "ctx_packed_store_state_new_variant_sparse_with_side_words"
            true return if name == "ctx_packed_store_state_new_with_prefix_and_side_words" or name == "ctx_packed_store_state_new_with_prefix_words" or name == "ctx_packed_store_state_new_with_side_words"
            true return if name == "ctx_packed_store_view" or name == "ctx_packed_store_word_handle_at"
            return false




        # Some runtime functions are present in the source for standalone stage0 builds,
        # but the linked runtime object is the authoritative implementation for stage1.
        # Keep a declined source body from becoming a local panic stub that shadows it.
        def runtime_external_only(name: sview) -> bool:
            return name == "ctx_aos_store_record"




        # 8 = LLVMInternalLinkage. `main` is the entry point crt0 calls from outside the
        # module and always stays external.
        def set_defined_function_linkage(name: sview, handle: LLVMValueRef, module_has_main: bool) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            return if name == "main"
            # Preserve the bootstrap's O0 program path exactly: avoid consulting the runtime
            # whitelist here and use the established whole-program internal linkage rule.
            if not prefer_private_linkage_enabled():
                LLVMSetLinkage(handle, 8) if module_has_main
                return
            # The runtime object is linked beside every stage1 product. If the source unit also
            # contains the runtime-support definitions, leave those definitions internal so the
            # product does not export duplicate symbols. Declined runtime helpers remain
            # declarations and resolve to the linked runtime object as before.
            if name_is_runtime_provided(name):
                LLVMSetLinkage(handle, 8)
                return
            # LLVM's C enum uses 9 for LLVMPrivateLinkage (8 is InternalLinkage). Stage0
            # internalizes every ordinary non-exported definition at O1/O2/O3, including
            # library units that have no `main`; `main` is the only entry-point exception.
            LLVMSetLinkage(handle, 9)




        def record_declined_function(name: sview, m: LLVMModuleRef, ctx: LLVMContextRef) -> void can[Abort.Panic, Memory.Allocate]:
            if dbg_decline_enabled():
                dcl_msg: mutable darray[u8] = []
                _ = dbg_push_sview(dcl_msg, "DROPPED ")
                _ = dbg_push_sview(dcl_msg, name)
                dcl_msg.push(0)
                _ = puts((&dcl_msg[0]).cast[cstr] can Unsafe.PointerCast)
            name_storage: mutable darray[u8] = []
            declined_cstr: cstr = sview_to_cstr(name, name_storage)
            declined_string: LLVMValueRef = LLVMMetadataAsValue(ctx, LLVMMDStringInContext2(ctx, declined_cstr, sview_len(name)))
            LLVMAddNamedMetadataOperand(m, "elisa.declined", declined_string)




        def record_declined_body(name: sview, structs: StructTable&, m: LLVMModuleRef, ctx: LLVMContextRef) -> void can[Abort.Panic, Memory.Allocate]:
            detail: mutable darray[u8] = []
            _ = dbg_push_sview(detail, name)
            if structs.decline_line > 0:
                _ = dbg_push_sview(detail, "@")
                append_usize_decimal(structs.decline_line.usize(), detail)
            if structs.decline_kind != "":
                _ = dbg_push_sview(detail, " (")
                _ = dbg_push_sview(detail, structs.decline_kind)
                _ = dbg_push_sview(detail, ")")
            record_declined_function(sview(&detail[0], 0, detail.count.i64()), m, ctx)




        # Read `!elisa.declined` back out and append the names to `out`, comma-separated.
        # Returns how many there were.
        #
        # The counterpart to record_declined_function. Declines were WRITTEN from the first
        # day and never read: the driver's whole-unit failure path (emitted_count <= 0) exited
        # 2 with no stdout and no stderr, so the one piece of evidence the compiler had already
        # collected about its own failure never reached the person compiling. Reading it costs
        # one metadata walk on a path that is about to abort anyway.
        #
        # Capped at 12 names with a trailing `, …`: a unit that declines everything declines
        # hundreds, and a screenful of names is not more informative than the first few.
        def declined_function_report(m: LLVMModuleRef, out: mutable darray[u8]&) -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                declined_total: u32 = LLVMGetNamedMetadataNumOperands(m, "elisa.declined")
                0 return if declined_total == 0
                declined_ops: mutable darray[LLVMValueRef] = [zeroed for _ in 0..<declined_total.usize()]
                LLVMGetNamedMetadataOperands(m, "elisa.declined", (&declined_ops[0]).cast[void&] can Unsafe.PointerCast)
                shown: mutable i64 = 0
                for declined_index in 0..<declined_ops.count |out, shown, declined_ops|:
                    break if shown >= 12
                    # LLVMAddNamedMetadataOperand WRAPS a bare MDString in a one-element
                    # MDNode (extractMDNode does it), so what comes back out is the node, not
                    # the string: reading GetMDString off the operand directly returns null
                    # and every name renders EMPTY. Unwrap operand 0 first, exactly as
                    # md_property_is does.
                    declined_leaf: mutable LLVMValueRef = declined_ops[declined_index]
                    if LLVMIsAMDNode(declined_leaf) is declined_node:
                        if LLVMGetMDNodeNumOperands(declined_leaf) > 0:
                            declined_inner: mutable darray[LLVMValueRef] = [zeroed for _ in 0..<LLVMGetMDNodeNumOperands(declined_leaf).usize()]
                            LLVMGetMDNodeOperands(declined_leaf, (&declined_inner[0]).cast[void&] can Unsafe.PointerCast)
                            declined_leaf <- declined_inner[0.usize()]
                    declined_length: mutable u32 = 0
                    if LLVMGetMDString(declined_leaf, (&declined_length).cast[void&] can Unsafe.PointerCast) is declined_text:
                        # The postfix `can` grant does not parse inside an argument list.
                        declined_bytes: u8&? = declined_text.cast[u8&?] can Unsafe.PointerCast
                        if shown > 0:
                            out.push(44)
                            out.push(32)
                        _ = dbg_push_sview(out, sview(declined_bytes, 0, declined_length.i64()))
                        shown <- shown + 1
                if declined_ops.count.i64() > shown:
                    _ = dbg_push_sview(out, ", …")
                return declined_ops.count.i64()




        # Record a declined generic INSTANTIATION under the name LLVM knows it by (the
        # mangled `base__K__T`), falling back to the template's base name if the handle has
        # no name yet.
        def record_declined_instantiation(handle: LLVMValueRef, base: sview, structs: StructTable&, m: LLVMModuleRef, ctx: LLVMContextRef) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            mangled_length: mutable usize = 0
            mangled: cstr = LLVMGetValueName2(handle, &mangled_length)
            if mangled_length == 0:
                record_declined_body(base, structs, m, ctx)
                return
            # Preserve the first source-level decline reason on the monomorphized name. The
            # driver prints this metadata when the specialization is still referenced, so a
            # generic effect mismatch is reported with its actual failing body/operation.
            detail: mutable darray[u8] = []
            mangled_bytes: u8& = mangled.cast[u8&] can Unsafe.PointerCast
            _ = dbg_push_sview(detail, sview(mangled_bytes, 0, mangled_length.i64()))
            if structs.decline_line > 0:
                detail.push(64)
                append_usize_decimal(structs.decline_line.usize(), detail)
            if structs.decline_kind != "":
                detail.push(32)
                detail.push(40)
                _ = dbg_push_sview(detail, structs.decline_kind)
                detail.push(41)
            record_declined_function(sview(&detail[0], 0, detail.count.i64()), m, ctx)




            # Emit all declared bodies and drain generic instantiations. The separate helper keeps
            # the module setup routine focused on type/ABI registration and preserves the same
            # all-or-nothing `main` check as the original inline pass.
            # A function whose BODY was declined, minus the ones the linked runtime object
            # legitimately provides. Collected rather than judged on the spot: whether the
            # stripped declaration is still CALLED is only settled once every other body has
            # been emitted, so the verdict belongs to the module driver.
        def note_dangling_decline(name: sview, handle: LLVMValueRef, module_has_main: bool, dangling: mutable darray[LLVMValueRef]&) -> void can[Abort.Panic, Memory.Allocate]:
            return if not module_has_main
            return if name_is_runtime_provided(name) or runtime_external_only(name)
            dangling.push(handle)
