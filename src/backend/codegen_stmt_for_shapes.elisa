# Stage1 backend — the `for` shapes whose ITERABLE decides the lowering: destructuring a struct
# into one local per named field, `reversed(xs)`, a dense view, a string or cstr walked by
# byte, and the dict/set iterations. codegen_stmt_loops.elisa tries the range, parallel and
# enumerate shapes first and calls in here for the rest; `matched` says whether one of these
# claimed the loop, since a claimed-but-declined shape also returns Declined.
# Part of `module Backend` (see codegen.elisa).

extend Backend:
    private:
        # The scalar DArray cursor path snapshots the header and then uses one saved `items`
        # pointer for the whole loop. Only admit a deliberately small fold shape: a named DArray
        # binding (local or borrowed formal), and one assignment to an existing local scalar
        # whose RHS is built from scalar identifiers/literals and pure unary/binary operators.
        # This excludes calls
        # (including callback and stored-function calls), closure creation, and direct header
        # writes, any of which could invalidate the saved cursor or count.
        def darray_pointer_walk_scalar_expr(expression: Expr, source_name: sview, element_name: sview, element_type: ValueType, local_scope: mutable Scope&) -> bool can[Abort.Panic]:
            match expression:
                Expr.IntLit(_, _) | Expr.FloatLit(_, _) | Expr.BoolLit(_, _):
                    return true
                Expr.Ident(name, _):
                    return false if name == source_name
                    if name == element_name:
                        return loop_scratch_scalar_type(element_type)
                    return loop_scratch_scalar_type(lookup_type(local_scope, name))
                Expr.Paren(inner, _):
                    return darray_pointer_walk_scalar_expr(inner, source_name, element_name, element_type, local_scope)
                Expr.Unary(operator, operand, _):
                    return false if operator != TokenKind.Minus and operator != TokenKind.Plus and operator != TokenKind.Not and operator != TokenKind.Tilde
                    return darray_pointer_walk_scalar_expr(operand, source_name, element_name, element_type, local_scope)
                Expr.Binary(left, _, right, _):
                    return darray_pointer_walk_scalar_expr(left, source_name, element_name, element_type, local_scope) and darray_pointer_walk_scalar_expr(right, source_name, element_name, element_type, local_scope)
                _:
                    return false


        def darray_pointer_walk_body_safe(body: darray[Stmt]&, source_name: sview, element_name: sview, element_type: ValueType, local_scope: mutable Scope&) -> bool can[Abort.Panic]:
            return false if body.count != 1
            if body[0] is Stmt.Assign(target, operator, value, _):
                return false if operator != TokenKind.Assign and operator != TokenKind.LArrow
                if target is Expr.Ident(target_name, _):
                    return false if:
                        target_name == source_name or target_name == element_name
                        not (lookup_slot(local_scope, target_name) is target_slot)
                    return loop_scratch_scalar_type(lookup_type(local_scope, target_name)) and darray_pointer_walk_scalar_expr(value, source_name, element_name, element_type, local_scope)
            return false
