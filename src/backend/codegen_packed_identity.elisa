# Stage1 backend — IDENTIFYING a packed enum: its index, its profile, its hierarchy root and
# tag base, whether it is the compiler's own AST root or a dynamic AoS store, and how two
# variant slots compare. Part of `module Backend` (see codegen.elisa).

extend Backend:
    private:


        def packed_owner_at(structs: StructTable&, index: usize) -> sview can[Abort.Panic]:
            return structs.packed_enums.packed_owners[index] if index < structs.packed_enums.packed_owners.count
            return ""


        # Append the name and owner together, then extend the optional name-chain index. Keeping
        # this operation shared makes every placeholder/final-row writer preserve lookup order.
        def packed_name_push(name: sview, owner: sview, structs: mutable StructTable&) -> void can[Abort.Panic, Memory.Allocate]:
            structs.packed_enums.packed_names <- structs.packed_enums.packed_names.push(name)
            structs.packed_enums.packed_owners <- structs.packed_enums.packed_owners.push(owner)
            name_chain_extend(structs.packed_enums.packed_name_buckets, structs.packed_enums.packed_name_tails, structs.packed_enums.packed_name_next, structs.packed_enums.packed_names)



        def packed_index_of_owned(structs: StructTable&, owner: sview, name: sview) -> i64 can[Abort.Panic]:
            index: mutable i64 = name_chain_first(structs.packed_enums.packed_name_buckets, structs.packed_enums.packed_name_next, structs.packed_enums.packed_names, name)
            while index >= 0 |structs, owner, name, index|:
                index return if packed_owner_at(structs, index.usize()) == owner
                index <- name_chain_next(structs.packed_enums.packed_name_buckets, structs.packed_enums.packed_name_next, structs.packed_enums.packed_names, name, index)
            return -1



        # Resolve a packed enum by lexical owner. Taking the first same-named store row is
        # unsound: its row width, hierarchy root, and runtime store ABI may differ.
        def packed_index_of(structs: StructTable&, name: sview) -> i64 can[Abort.Panic]:
            if structs.visibility.current_owner != "":
                owned: i64 = packed_index_of_owned(structs, structs.visibility.current_owner, name)
                return owned if owned >= 0
            top_level: i64 = packed_index_of_owned(structs, "", name)
            return top_level if top_level >= 0
            found: mutable i64 = -1
            matches: mutable i64 = 0
            index: mutable i64 = name_chain_first(structs.packed_enums.packed_name_buckets, structs.packed_enums.packed_name_next, structs.packed_enums.packed_names, name)
            while index >= 0 |found, matches, structs, name, index|:
                found <- index
                matches <- matches + 1
                index <- name_chain_next(structs.packed_enums.packed_name_buckets, structs.packed_enums.packed_name_next, structs.packed_enums.packed_names, name, index)
            return found if matches == 1
            return -1



        # Resolve a packed enum head such as M::Node while retaining the module path.
        def packed_index_of_head(structs: StructTable&, head: Expr) -> i64 can[Abort.Panic]:
            can Abort.Panic:
                match head:
                    Expr.Ident(head_name, head_line):
                        return packed_index_of(structs, head_name)
                    Expr.Scope(scope_base, scoped_name, scoped_line):
                        # Reserved AST headers carry their source module like populated rows.
                        # This keeps `Ast::Expr` separate from a top-level user `Expr` while
                        # still allowing recursive metadata to fill the header in place.
                        if enum_scope_path_matches_range("Ast", 0, 3, scope_base, structs):
                            canonical_ast_index: i64 = packed_index_of_owned(structs, "Ast", scoped_name)
                            return canonical_ast_index if canonical_ast_index >= 0 and packed_is_ast_refinement(structs, canonical_ast_index)
                        best: mutable i64 = -1
                        best_rank: mutable i64 = -1
                        enum_index: mutable i64 = name_chain_first(structs.packed_enums.packed_name_buckets, structs.packed_enums.packed_name_next, structs.packed_enums.packed_names, scoped_name)
                        while enum_index >= 0 |structs, scope_base, scoped_name, best, best_rank, enum_index|:
                            candidate_index: usize = enum_index.usize()
                            enum_index <- name_chain_next(structs.packed_enums.packed_name_buckets, structs.packed_enums.packed_name_next, structs.packed_enums.packed_names, scoped_name, enum_index)
                            candidate_owner: sview = packed_owner_at(structs, candidate_index)
                            continue if candidate_owner == ""
                            rank: i64 = enum_scope_path_rank(candidate_owner, scope_base, structs)
                            if rank > best_rank:
                                best <- candidate_index.i64()
                                best_rank <- rank
                        return best if best >= 0
                    _:
                        pass
                return -1



        # Packed profile ABI: canonical uses the existing variant-sparse runtime; retained_reads
        # uses the dense index/SOA runtime. build_heavy remains reserved for the AoS path below.
        # Whether a RECURSIVE enum (`__recursive_field`) takes the dynamic AoS row. stage0's
        # rule (packedModeForPackedEnum) is `root.RecursivePlain && !layout(soa)`: only a PLAIN
        # `enum` promoted by recursion defaults to AoS. A recursive enum declared with the
        # `packed` keyword, or one that asked for `layout(soa)`, keeps the canonical
        # variant-sparse ABI. Treating every recursive enum as AoS gave `packed enum Node`
        # a 12-byte AoS row where stage0 lays out and reports a 16-byte variant-sparse one.
        def recursive_enum_selects_aos(annotations: darray[Ast::EnumAnnotation]&, owner: sview, enum_module: sview) -> bool can[Abort.Panic]:
            false return if owner == ""
            for annotation in annotations |owner, enum_module|:
                continue if annotation.owner != owner or annotation.module != enum_module
                false return if annotation.name == "__declared_packed" or annotation.name == "__layout_soa"
            return true


        def packed_profile_mode(annotations: darray[Ast::EnumAnnotation]&) -> i32 can[Abort.Panic]:
            for annotation in annotations:
                2 return if annotation.name == "__aos" and annotation.line == 3900000042
                # Recursive values and sealed hierarchies need stable rows because a child
                # value is consumed through its root type. stage0 selects canonical AoS for
                # these automatically; leaving them in variant-sparse mode loses the root row
                # ABI before codegen can reason about the hierarchy.
                2 return if annotation.name == "__ast_refinement"
                2 return if annotation.name == "__recursive_field" and recursive_enum_selects_aos(annotations, annotation.owner, annotation.module)
                if annotation.line == 3900000041:
                    1 return if annotation.name == "retained_reads"
                    2 return if annotation.name == "build_heavy"
            return 0




        # Whether this packed enum is the COMPILER'S OWN AST root, whose store row has a fixed
        # hard-coded shape (`{i32, [32 x i32]}`, 132 bytes). That is a different question from
        # "does this enum use the AoS store machinery" -- packed_is_ast_root, which every other
        # site asks and which is deliberately broader.
        #
        # Conflating the two made a USER packed enum report the AST root's 132-byte row: its
        # store was created with the wrong stride and every payload read back as 0 (stage0
        # answers 5, stage1 answered 0). Two names, two meanings.
        def packed_is_ast_root_row(structs: StructTable&, enum_index: i64) -> bool can[Abort.Panic]:
            false return if enum_index < 0 or enum_index.usize() >= structs.packed_enums.packed_names.count
            false return if structs.packed_enums.packed_variant_count[enum_index.usize()] != 0.usize()
            # Generic user hierarchies use the same zero-variant placeholder shape, but their
            # rows are dynamically sized. Only the parser's dedicated compiler-AST marker may
            # select the historical Node row; testing the generic hierarchy marker here made
            # every user root look like the compiler's 132-byte AST store.
            return structs.packed_enums.packed_names[enum_index.usize()] == "Node" and packed_is_ast_refinement(structs, enum_index)




        def packed_is_ast_root(structs: StructTable&, enum_index: i64) -> bool can[Abort.Panic]:
            false return if enum_index < 0 or enum_index.usize() >= structs.packed_enums.packed_names.count
            name: sview = structs.packed_enums.packed_names[enum_index.usize()]
            # Whether this packed enum uses the AoS store layout. Historically this was
            # `name == "Node" and variant_count == 0` -- the compiler's own AST-root
            # PLACEHOLDER row -- which scoped the whole AoS subsystem to self-hosting and was
            # believed to be what blocked every user `packed enum`.
            #
            # MEASURED: relaxing it moves exactly ONE of the 21 packed corpus files
            # (backend_packed_zero_payload_object, which then runs correctly -- 7, matching
            # stage0). The other 20 still decline for their own reasons, so the note claiming
            # this one gate explained the cluster was wrong.
            #
            # Kept because it is measured safe -- self-host, the 303-program adversarial suite
            # and the semantic gates are all green with it -- and because the placeholder-row
            # test was never the real rule: a packed enum with variants of its own uses the
            # same store machinery.
            true return if name == "Node" and packed_is_ast_root_row(structs, enum_index)
            # A sealed hierarchy ROOT uses the store machinery too, and it is written
            # variant-less (`enum Widget: pass`), so the variant-count test below cannot see
            # it. Without this a match on ANY member of a user hierarchy declined: the
            # statement-match emitter resolves the scrutinee to its ROOT and then asks
            # whether that root uses the AoS store. Asked STRUCTURALLY here -- this is store
            # membership, not the AST's row layout, which packed_is_ast_root_row owns.
            true return if structs.packed_enums.packed_variant_count[enum_index.usize()] == 0.usize() and packed_slot_is_hierarchy_root(structs, enum_index)
            return structs.packed_enums.packed_variant_count[enum_index.usize()] > 0.usize()




        # Whether this packed enum uses the measured dynamic AoS row shape. Unlike
        # packed_is_ast_root, this includes a flat recursive enum (`Tree`) and every member of
        # a user sealed hierarchy. Compiler AST rows retain the historical 32-slot floor, while
        # user rows are sized from their actual widest payload.
        def packed_is_dynamic_aos_enum(structs: StructTable&, enum_index: i64) -> bool can[Abort.Panic]:
            false return if enum_index < 0 or enum_index.usize() >= structs.packed_enums.packed_names.count
            name: sview = structs.packed_enums.packed_names[enum_index.usize()]
            enum_module: sview = packed_hierarchy_module_at_slot(structs, enum_index)
            for dynamic_index in 0..<structs.packed_layouts.aos_dynamic_names.count |name, enum_module, structs|:
                dynamic_module: sview = structs.packed_layouts.aos_dynamic_modules[dynamic_index] if dynamic_index < structs.packed_layouts.aos_dynamic_modules.count else ""
                continue if structs.packed_layouts.aos_dynamic_names[dynamic_index] != name
                true return if dynamic_module == enum_module
            return false




        def packed_hierarchy_root_name_owned(structs: StructTable&, name: sview, enum_module: sview) -> sview can[Abort.Panic]:
            cursor: mutable sview = name
            steps: mutable usize = 0
            while steps < structs.packed_layouts.hierarchy_child.count |cursor, steps, enum_module, structs|:
                parent: mutable sview = ""
                for edge_index in 0..<structs.packed_layouts.hierarchy_child.count |parent, cursor, enum_module, structs|:
                    edge_module: sview = structs.packed_layouts.hierarchy_modules[edge_index] if edge_index < structs.packed_layouts.hierarchy_modules.count else ""
                    parent <- structs.packed_layouts.hierarchy_parent[edge_index] if structs.packed_layouts.hierarchy_child[edge_index] == cursor and edge_module == enum_module
                break if parent == ""
                cursor <- parent
                steps <- steps + 1
            return cursor




        def packed_hierarchy_module_at_slot(structs: StructTable&, enum_index: i64) -> sview can[Abort.Panic]:
            return "" if enum_index < 0 or enum_index.usize() >= structs.packed_enums.packed_names.count
            return packed_owner_at(structs, enum_index.usize())




        # Slot-aware counterpart: hierarchy annotations are scoped by module, so two modules
        # may each define a child with the same leaf name under different roots.
        def packed_hierarchy_root_name_at_slot(structs: StructTable&, enum_index: i64) -> sview can[Abort.Panic]:
            return "" if enum_index < 0 or enum_index.usize() >= structs.packed_enums.packed_names.count
            return packed_hierarchy_root_name_owned(structs, structs.packed_enums.packed_names[enum_index.usize()], packed_hierarchy_module_at_slot(structs, enum_index))




        def packed_slot_is_hierarchy_root(structs: StructTable&, enum_index: i64) -> bool can[Abort.Panic]:
            return false if enum_index < 0 or enum_index.usize() >= structs.packed_enums.packed_names.count
            enum_name: sview = structs.packed_enums.packed_names[enum_index.usize()]
            enum_module: sview = packed_hierarchy_module_at_slot(structs, enum_index)
            for edge_index in 0..<structs.packed_layouts.hierarchy_parent.count |enum_name, enum_module, structs|:
                edge_module: sview = structs.packed_layouts.hierarchy_modules[edge_index] if edge_index < structs.packed_layouts.hierarchy_modules.count else ""
                true return if structs.packed_layouts.hierarchy_parent[edge_index] == enum_name and edge_module == enum_module
            return false




        # The tag space of a sealed hierarchy is shared by all refinements. A child enum's
        # local variant ordinal therefore starts after every earlier declaration in the same
        # hierarchy; treating it as a standalone packed enum makes `Button.Push` collide with
        # `Control.Label` (both become tag 0) and is invisible until a match crosses that edge.
        # Flat packed enums retain their local zero-based tags.
        def packed_hierarchy_tag_base(structs: StructTable&, enum_index: i64) -> i64 can[Abort.Panic]:
            return 0 if enum_index < 0 or enum_index.usize() >= structs.packed_enums.packed_names.count
            own_name: sview = structs.packed_enums.packed_names[enum_index.usize()]
            root_name: sview = packed_hierarchy_root_name_at_slot(structs, enum_index)
            enum_module: sview = packed_hierarchy_module_at_slot(structs, enum_index)
            is_hierarchy: bool = root_name != own_name or packed_slot_is_hierarchy_root(structs, enum_index)
            return 0 if not is_hierarchy
            base: mutable i64 = 0
            for prior in 0..<enum_index.usize() |base, structs, root_name|:
                prior_root: sview = packed_hierarchy_root_name_at_slot(structs, prior.i64())
                base <- base + structs.packed_enums.packed_variant_count[prior].i64() if prior_root == root_name and packed_hierarchy_module_at_slot(structs, prior.i64()) == enum_module
            return base




        # The packed-enum index of the store that owns `enum_index` — the root of its sealed
        # hierarchy. This resolved to the literal name "Node" before, which is why a user
        # hierarchy type-checked and then declined in the backend: its root is not called
        # Node, so the lookup returned -1 and every store query failed.
        def packed_root_index_of(structs: StructTable&, enum_index: i64) -> i64 can[Abort.Panic]:
            can Abort.Panic:
                enum_index return if enum_index < 0 or enum_index.usize() >= structs.packed_enums.packed_names.count
                own_name: sview = structs.packed_enums.packed_names[enum_index.usize()]
                root_name: sview = packed_hierarchy_root_name_at_slot(structs, enum_index)
                # User hierarchies are generic packed/AoS values, not compiler-AST
                # refinements, but their descendants still share the root's store.
                if root_name != own_name:
                    # Resolve the root within the same lexical owner as the member. A bare
                    # name is not sufficient here: two modules may both define `Node`, and
                    # the compiler reserves its AST row in owner `Ast`. Selecting the
                    # first matching root gives the member the wrong store ABI or makes a
                    # valid qualified variant test decline.
                    hierarchy_owner: sview = packed_hierarchy_module_at_slot(structs, enum_index)
                    hierarchy_root_index: mutable i64 = packed_index_of_owned(structs, hierarchy_owner, root_name)
                    hierarchy_root_index <- packed_index_of(structs, root_name) if hierarchy_root_index < 0 and hierarchy_owner == ""
                    hierarchy_root_index return if hierarchy_root_index >= 0
                # A flat recursive enum has no variant-less hierarchy anchor, but it still owns
                # a store: its self-referential handles cannot be indexed into a compiler AST
                # store (and there is no Node fallback in a user program).
                enum_index return if packed_is_dynamic_aos_enum(structs, enum_index) and root_name == own_name
                # Trust the edge walk only when it actually resolves a hierarchy: either it
                # MOVED (this enum has a parent) or this enum is itself a root something
                # refines. The auxiliary StructTables (the C-header and debug paths build
                # their own) carry no edges, and there the walk returns the enum's own name —
                # which for `Expr` is a REGISTERED packed name, so trusting it silently made
                # Expr its own store root instead of Node and broke the gen3 fixpoint. The
                # compiler's own AST must keep resolving to Node in exactly that case.
                if packed_is_ast_refinement(structs, enum_index) and (root_name != own_name or packed_slot_is_hierarchy_root(structs, enum_index)):
                    hierarchy_owner: sview = packed_hierarchy_module_at_slot(structs, enum_index)
                    hierarchy_root_index: mutable i64 = packed_index_of_owned(structs, hierarchy_owner, root_name)
                    hierarchy_root_index <- packed_index_of(structs, root_name) if hierarchy_root_index < 0 and hierarchy_owner == ""
                    hierarchy_root_index return if hierarchy_root_index >= 0
                return enum_index




            # Two packed variant slots have the SAME payload FIELD layout — identical field count and
            # each field's kind+bits. Structurally-identical payloads (`Pattern.Variant{sview,darray}`
            # vs `Pattern.Struct{sview,darray}`) may intern to DIFFERENT aggregate payload slots, so an
            # OR arm binding across them must compare field SPANS, not the aggregate ValueType.
        def packed_slots_same_field_layout(a: i64, b: i64, structs: StructTable&) -> bool can[Abort.Panic]:
            false return if a < 0 or b < 0
            count_a: usize = structs.packed_enums.packed_field_type_count[a.usize()]
            count_b: usize = structs.packed_enums.packed_field_type_count[b.usize()]
            false return if count_a != count_b
            start_a: usize = structs.packed_enums.packed_field_type_start[a.usize()]
            start_b: usize = structs.packed_enums.packed_field_type_start[b.usize()]
            same: mutable bool = true
            for offset in 0..<count_a |same, start_a, start_b, structs|:
                type_a: ValueType = structs.packed_enums.packed_field_types[start_a + offset]
                type_b: ValueType = structs.packed_enums.packed_field_types[start_b + offset]
                same <- false if type_a.kind != type_b.kind or type_a.bits != type_b.bits
            return same




        def packed_is_ast_refinement(structs: StructTable&, enum_index: i64) -> bool can[Abort.Panic]:
            false return if enum_index < 0 or enum_index.usize() >= structs.packed_enums.packed_names.count
            name: sview = structs.packed_enums.packed_names[enum_index.usize()]
            enum_module: sview = packed_owner_at(structs, enum_index.usize())
            # `Pattern` is `enum Pattern is Node` too (docs/122) — a Node refinement sharing the
            # Node store with hierarchy-global tags, like Expr/Stmt/Decl. Omitting it here (every
            # OTHER refinement list already names it) made packed_root_index_of(Pattern) wrong, so
            # every `match pattern:` / `p is Pattern.X` failed the Node-store-active check.
            for refinement_index in 0..<structs.packed_layouts.ast_refinement_names.count |name, enum_module, structs|:
                refinement_module: sview = structs.packed_layouts.ast_refinement_modules[refinement_index] if refinement_index < structs.packed_layouts.ast_refinement_modules.count else ""
                continue if structs.packed_layouts.ast_refinement_names[refinement_index] != name
                true return if refinement_module == enum_module
            return false



        def packed_constructor_enum_name(head: Expr) -> sview:
            match head:
                Expr.Ident(name, _):
                    return name
                Expr.Scope(_, name, _):
                    # This extracts only the leaf spelling. The head-aware registry
                    # lookup separately validates the complete declaring-module path.
                    return name
                _:
                    pass
            return sview("", 0, 0)




        def packed_variant_index(structs: StructTable&, enum_index: i64, variant_name: sview) -> i64 can[Abort.Panic]:
            can Abort.Panic:
                start: usize = structs.packed_enums.packed_variant_start[enum_index.usize()]
                count: usize = structs.packed_enums.packed_variant_count[enum_index.usize()]
                packed_tag_base: i64 = packed_hierarchy_tag_base(structs, enum_index)
                offset: mutable usize = 0
                while offset < count |offset, structs, start, variant_name|:
                    (packed_tag_base + offset.i64()) return if structs.packed_enums.packed_variants[start + offset] == variant_name
                    offset <- offset + 1
                return -1




            # A variant's ordinal within its own refinement, used only to index the
            # refinement-local payload pools. `packed_variant_index` deliberately returns the
            # hierarchy-wide tag used in the shared AST row.
        def packed_variant_local_index(structs: StructTable&, enum_index: i64, variant_name: sview) -> i64 can[Abort.Panic]:
            start: usize = structs.packed_enums.packed_variant_start[enum_index.usize()]
            count: usize = structs.packed_enums.packed_variant_count[enum_index.usize()]
            offset: mutable usize = 0
            while offset < count |offset, structs, start, variant_name|:
                offset.i64() return if structs.packed_enums.packed_variants[start + offset] == variant_name
                offset <- offset + 1
            return -1




        # A store row's size in bytes: the `{i32, [N x i64]}` handle laid out at i64
        # alignment, so the tag's 4 bytes pad to 8. stage0 passes 16 for a one-word payload
        # (`state_new_variant_sparse(ptr %owner, i64 16)`), which this reproduces.
        # Whether this compilation carries the compiler's OWN AST: an `Expr`/`Stmt`/`Decl`/
        # `Pattern` that exists as a real declaration with variants, not merely as the header
        # reserve_ast_packed_headers places in EVERY program. That reservation is what made
        # the reserved `Node` header answer packed_is_ast_root_row for a user program too --
        # so a user hierarchy's store was created at the AST's fixed 132-byte stride while
        # its rows were laid out at their real width. Anything under 132 bytes merely wasted
        # space (every elisa-ui widget row was 132 bytes); a row past it overran the next
        # node: a 15-common chain lost half its links and a 14-common one segfaulted, while
        # stage0 kept every node.
        def packed_program_has_ast_refinements(structs: StructTable&) -> bool can[Abort.Panic]:
            # A refinement counts only when its hierarchy root IS the reserved `Node`:
            # user hierarchy members are registered through the same refinement list
            # (that is how `is`-chains resolve), so "any refinement with variants" was
            # true for every widget program and the gate never closed.
            for ast_root in 0..<structs.packed_enums.packed_names.count |structs|:
                continue if structs.packed_enums.packed_names[ast_root] != "Node" or not packed_is_ast_refinement(structs, ast_root.i64())
                for refinement_index in 0..<structs.packed_enums.packed_names.count |structs, ast_root|:
                    continue if refinement_index == ast_root or not packed_is_ast_refinement(structs, refinement_index.i64())
                    continue if structs.packed_enums.packed_variant_count[refinement_index] == 0
                    true return if packed_root_index_of(structs, refinement_index.i64()) == ast_root.i64()
            return false
