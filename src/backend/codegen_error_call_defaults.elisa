# Fill omitted defaults before the hidden arena arguments of a named error call.
extend Backend:
    private:
        def emit_error_call_defaults(name: sview, owner: sview, supplied: usize, values: mutable darray[LLVMValueRef]&, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            index: i64 = function_index_of(fns, error_callee_owner(fns, structs, name, owner), name)
            true return if index < 0
            count: usize = fns.param_count[index.usize()]
            for position in supplied..<count |values, index, fns, local_scope, structs, generics, runtime, m, ctx, builder|:
                slot: usize = fns.param_start[index.usize()] + position
                expression: Expr = fns.param_defaults[slot]
                false return if expression is Expr.Invalid
                wanted: ValueType = copied_type(fns.param_types[slot])
                if emit_expression_coerced(expression, wanted, local_scope, fns, structs, generics, runtime, m, ctx, builder) is value:
                    values.push(value)
                else:
                    return false
            return true
