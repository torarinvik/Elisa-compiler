# Stage1 backend — `x: T = value`, a local DECLARATION: allocate the slot, emit the initializer
# against the declared type, and record the local (with its region, mutability and drop
# obligation). Reached from codegen_stmt_return_vardecl.elisa, which handles `return` first.
# Part of `module Backend` (see codegen.elisa).

extend Backend:
    private:
        # An initializer made only of integer literals, unary minus/complement, parens and
        # arithmetic: typeless in the same sense a bare literal is.
        def untyped_value_is_integer_literal_tree(value: Expr) -> bool:
            can Abort.Panic:
                match value:
                    Expr.IntLit(_, _):
                        return true
                    Expr.Paren(lit_tree_inner, _):
                        return untyped_value_is_integer_literal_tree(lit_tree_inner)
                    Expr.Unary(lit_tree_op, lit_tree_operand, _):
                        false return if lit_tree_op != TokenKind.Minus and lit_tree_op != TokenKind.Tilde
                        return untyped_value_is_integer_literal_tree(lit_tree_operand)
                    Expr.Binary(lit_tree_left, lit_tree_bop, lit_tree_right, _):
                        false return if not (lit_tree_bop == TokenKind.Plus or lit_tree_bop == TokenKind.Minus or lit_tree_bop == TokenKind.Star or lit_tree_bop == TokenKind.Slash or lit_tree_bop == TokenKind.Percent)
                        return untyped_value_is_integer_literal_tree(lit_tree_left) and untyped_value_is_integer_literal_tree(lit_tree_right)
                    _:
                        return false

        def emit_statement_vardecl(statement: Stmt, return_type: ValueType, local_scope: mutable Scope&, loops: mutable LoopStack&, regions: mutable RegionStack&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef, handled: mutable bool&) -> EmitStatus can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:

            # `x: i64 = value` — a fresh slot plus the initializing store. The slot is
            # allocated at the CURRENT position rather than hoisted to the entry block;
            # mem2reg still promotes it, and the subset has no loop-allocated locals.
            if statement is Stmt.VarDecl(var_name, var_type, var_value, var_line):
                # `_ = EXPR` — an explicit DISCARD (stage0 lowers a bare `x = v` to a VarDecl,
                # so a `_` target arrives here with no annotation). Emit the value for its side
                # effects at its own type and drop the result; nothing is bound. Without this a
                # discarded call (`_ = fetch_add(&a, 2)`, `_ = helper(5)`) declined at the
                # Unmodeled-annotation gate below.
                if var_name == "_":
                    dr_var_status: i64 = try_discarded_darray_reserve(var_value, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                    EmitStatus.Open return if dr_var_status == 1
                    EmitStatus.Declined return if dr_var_status < 0
                    discard_type: ValueType = expression_type(var_value, local_scope, fns, structs, generics)
                    discard_expected: ValueType = discard_type if discard_type.kind != TypeKind.Unmodeled else ValueType{kind: TypeKind.Signed, bits: 64}
                    if emit_expression(var_value, discard_expected, local_scope, fns, structs, generics, runtime, m, ctx, builder) is discarded_var_value:
                        _ = discarded_var_value
                        return EmitStatus.Open
                    return EmitStatus.Declined
                nested_var_value: mutable Expr = var_value
                nested_var_status: i64 = materialize_nested_try_argument(var_value, nested_var_value, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)
                EmitStatus.Declined return if nested_var_status < 0
                if nested_var_status == 1:
                    return emit_statement((Stmt.VarDecl(var_name, var_type, nested_var_value, var_line)), return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)
                # `x: T = get OPT` — MONADIC UNWRAP of an optional. Present → bind the payload to
                # `x`; absent → PROPAGATE None: return a null optional from THIS function (which must
                # itself return an optional). The `get X else BODY` form runs BODY on absent instead.
                # index_map_get does `index: usize = get index_map_find_index(...)`.
                if var_value is Expr.GetElse(get_guarded, get_recovery, get_line):
                    # `try f(x) else err: BLOCK` parses to the SAME node as `get`, but its
                    # guarded expression is an ERROR-returning call rather than an optional:
                    # the recovery runs on a nonzero status code, not on an absent payload.
                    # (The `err` binder is dropped by the parser, so a body that names it
                    # declines downstream on the unresolved ident rather than reading garbage.)
                    if get_recovery.count > 0:
                        if get_guarded is Expr.Call(try_else_callee, try_else_args, try_else_names, try_else_line):
                            # A QUALIFIED callee here (`try WasmBrowser::Permissions::step(...) else
                            # return false`) arrives as a Scope, which this arm never matched.
                            try_else_owner: sview = try_callee_owner(try_else_callee, fns, structs)
                            match try_callee_as_ident(try_else_callee, fns, structs):
                                Expr.Ident(try_else_name, try_else_name_line):
                                    if error_callee_is(fns, structs, generics, try_else_name, try_else_owner):
                                        if emit_propagating_try_value(try_else_name, try_else_args, get_recovery, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder, try_else_owner) is try_else_value:
                                            try_else_storage: mutable darray[u8] = []
                                            try_else_type: ValueType = error_callee_value_type(try_else_name, try_else_args, local_scope, fns, structs, generics, try_else_owner)
                                            try_else_slot: LLVMValueRef = build_entry_alloca(builder, llvm_type_of(try_else_type, structs, ctx), sview_to_cstr(var_name, try_else_storage))
                                            _ = LLVMBuildStore(builder, try_else_value, try_else_slot)
                                            declare_local(local_scope, var_name, try_else_slot, try_else_type)
                                            return EmitStatus.Open
                                        return EmitStatus.Declined
                                _:
                                    pass
                    get_opt_type: ValueType = expression_type(get_guarded, local_scope, fns, structs, generics)
                    # `p: T& = get c_alloc(n) else BODY` — a NULLABLE REFERENCE return. Stage0
                    # represents `-> heap T&?` as a bare ptr with null meaning absent, so the
                    # extern registers as a plain Ref and the Optional test below rejects it.
                    # Present is `ptr != null` and the payload IS the pointer, so no tag or
                    # payload extraction applies.
                    #
                    # Gated on FnTable.returns_nullable rather than on Ref-ness: stage0 REJECTS
                    # `get` on a non-nullable `T&` ("get requires an optional, a nullable
                    # reference, or a container index"), so accepting every Ref here would
                    # compile a program stage0 refuses.
                    if get_opt_type.kind == TypeKind.Ref:
                        gn_index: mutable i64 = -1
                        if get_guarded is Expr.Call(gn_callee, gn_args, gn_names, gn_call_line):
                            match gn_callee:
                                Expr.Ident(gn_name, gn_name_line):
                                    gn_index <- function_index_of(fns, "", gn_name)
                                _:
                                    pass
                        EmitStatus.Declined return if gn_index < 0
                        EmitStatus.Declined return if not fns.returns_nullable[gn_index.usize()]
                        if emit_expression(get_guarded, get_opt_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is gn_pointer:
                            gn_present_flag: LLVMValueRef = LLVMBuildICmp(builder, 33, gn_pointer, LLVMConstNull(LLVMTypeOf(gn_pointer)), "get.present")
                            gn_function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                            gn_present: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, gn_function, "get.present")
                            gn_absent: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, gn_function, "get.absent")
                            _ = LLVMBuildCondBr(builder, gn_present_flag, gn_present, gn_absent)
                            LLVMPositionBuilderAtEnd(builder, gn_absent)
                            if get_recovery.count == 0:
                                emit_region_unwind(regions, runtime, builder)
                                gn_none: LLVMValueRef = LLVMConstNull(llvm_type_of(return_type, structs, ctx))
                                if not emit_sret_return(gn_none, return_type, runtime, structs, ctx, builder):
                                    _ = LLVMBuildRet(builder, gn_none)
                            else:
                                gn_recovery_status: EmitStatus = emit_statements(get_recovery, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)
                                EmitStatus.Declined return if gn_recovery_status != EmitStatus.Terminated
                            LLVMPositionBuilderAtEnd(builder, gn_present)
                            gn_storage: mutable darray[u8] = []
                            gn_slot: LLVMValueRef = build_entry_alloca(builder, LLVMTypeOf(gn_pointer), sview_to_cstr(var_name, gn_storage))
                            _ = LLVMBuildStore(builder, gn_pointer, gn_slot)
                            declare_local(local_scope, var_name, gn_slot, get_opt_type)
                            return EmitStatus.Open
                        return EmitStatus.Declined
                    EmitStatus.Declined return if get_opt_type.kind != TypeKind.Optional
                    # Propagation returns a null of THIS function's declared return type (an optional
                    # for the common `-> T?` case; whatever it is, a zero value is the None/empty).
                    EmitStatus.Declined return if get_recovery.count == 0 and return_type.kind == TypeKind.Unmodeled
                    get_payload_type: ValueType = optional_payload_of(get_opt_type, structs)
                    if emit_expression(get_guarded, get_opt_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is get_opt_value:
                        get_tag: LLVMValueRef = optional_tag_of(get_opt_value, get_opt_type, structs, ctx, builder)
                        get_payload: LLVMValueRef = optional_payload_value_of(get_opt_value, get_opt_type, structs, ctx, builder)
                        get_function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                        get_present: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, get_function, "get.present")
                        get_absent: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, get_function, "get.absent")
                        _ = LLVMBuildCondBr(builder, get_tag, get_present, get_absent)
                        # ABSENT: `get X else BODY` runs BODY; bare `get X` propagates None.
                        LLVMPositionBuilderAtEnd(builder, get_absent)
                        if get_recovery.count == 0:
                            emit_region_unwind(regions, runtime, builder)
                            get_none: LLVMValueRef = LLVMConstNull(llvm_type_of(return_type, structs, ctx))
                            if not emit_sret_return(get_none, return_type, runtime, structs, ctx, builder):
                                _ = LLVMBuildRet(builder, get_none)
                        else:
                            get_recovery_status: EmitStatus = emit_statements(get_recovery, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)
                            EmitStatus.Declined return if get_recovery_status == EmitStatus.Declined
                            # An `else` body that falls through has no value to bind — require it to exit.
                            EmitStatus.Declined return if get_recovery_status == EmitStatus.Open
                        # PRESENT: bind the payload to `x` and continue.
                        LLVMPositionBuilderAtEnd(builder, get_present)
                        get_var_storage: mutable darray[u8] = []
                        get_var_slot: LLVMValueRef = build_entry_alloca(builder, llvm_type_of(get_payload_type, structs, ctx), sview_to_cstr(var_name, get_var_storage))
                        _ = LLVMBuildStore(builder, get_payload, get_var_slot)
                        declare_local(local_scope, var_name, get_var_slot, get_payload_type)
                        return EmitStatus.Open
                    return EmitStatus.Declined
                # The ANNOTATION decides the local's type, and the initializer is emitted
                # at that type — so `a: u8 = 200` stores a real u8.
                # Untyped loop-header binders (`x = expr`, machine mode/input locals) arrive
                # with Expr.Invalid as the annotation. Infer from the initializer so machine
                # desugar (`__machine_mode_0 = Enum.S`, `__machine_input_0 = n`) can emit.
                declared_type: mutable ValueType = annotation_value_type(var_type, structs)
                local_error_family: sview = local_error_family_at(var_line.line, structs)
                declared_type <- intern_error_union_type(declared_type, local_error_family, structs) if local_error_family != ""
                if declared_type.kind == TypeKind.Unmodeled:
                    # `machine from` lowers to a value block whose hidden result carrier is
                    # declared as `= zeroed`. Its type is not present in the synthetic AST, but
                    # the block emitter passes the block's expected value type as return_type.
                    # Use that context for the reserved carrier name; defaulting it through the
                    # zeroed initializer would leave it Unmodeled (or, worse, force i64) and
                    # silently reject valid non-integer machine results.
                    if var_name == "__mf_result" and return_type.kind != TypeKind.Unmodeled:
                        declared_type <- copied_type(return_type)
                    else:
                        declared_type <- expression_type(var_value, local_scope, fns, structs, generics)
                # `ys = xs[lo:hi]` with NO annotation. expression_type types EVERY slice as
                # SView regardless of receiver (codegen_scope.elisa), which for a container
                # receiver is simply wrong — stage0 types a darray slice as DynArrayView —
                # and the emitter declines rather than byte-GEP the header (90aab98).
                #
                # The real view type is interned HERE rather than in expression_type because
                # intern_view_type needs Memory.Allocate, which this site has and
                # expression_type (can[Abort.Panic], 102 call sites in src/backend) does not.
                # Widening that effect row is the change that broke whole-program region
                # inference in unrelated files once before.
                #
                # Only for a genuinely ABSENT annotation: `ys: view[i64] = …` already carries
                # its own type, and a present-but-unmodeled annotation must keep declining.
                declared_type <- slice_receiver_view_type(var_value, declared_type, local_scope, fns, structs, generics) if var_type is Expr.Invalid
                # An INITIALIZED loop accumulator (`for … |n = 0|`) desugars to an UNTYPED decl
                # whose initializer is a bare integer literal — and a literal has no intrinsic
                # type, so the inference above leaves it Unmodeled. Default it the way an integer
                # literal defaults everywhere else (signed 64).
                #
                # Gated on the annotation being Expr.Invalid, i.e. genuinely ABSENT: an
                # annotation that is present but unmodeled must keep declining, since silently
                # calling it i64 would be a wrong answer rather than a drop.
                #
                # This is only sound because the caller now emits such a decl in its OWN SCOPE
                # (see the accumulator handling in codegen_stmt_blocks_exprs). Resolving the type
                # WITHOUT that scoping makes the loop compile and mutate the caller's variable
                # instead of a shadowing copy — measured as 4 where stage0 gives 100.
                #
                # Restricted to an INTEGER-LITERAL initializer, which is the only thing that is
                # genuinely typeless here. Any other untyped initializer whose type could not be
                # inferred keeps declining: defaulting, say, a darray-valued ternary to i64 would
                # be a wrong answer rather than a drop.
                # `|best = -1|` / `|best = 0 - 1|`: a NEGATED or all-literal integer expression
                # is just as typeless as the bare literal (stage0 folds it to one) and
                # defaults the same way; it declined the whole function before (2026-09-08).
                if declared_type.kind == TypeKind.Unmodeled and var_type is Expr.Invalid and untyped_value_is_integer_literal_tree(var_value):
                    declared_type <- ValueType{kind: TypeKind.Signed, bits: 64}
                EmitStatus.Declined return if declared_type.kind == TypeKind.Unmodeled
                # `task: Task[R, S] = submit f(x)` — a POOL SUBMISSION. The parser wraps the
                # submitted call in a value-Block and marks the line `__submit`; stage0 rewrites
                # it to `pool_submitN(&activePool, @f, args…)`, taking the pool from the
                # enclosing `pool workers(N):` block (`local_scope.pool_names`). Rewritten here
                # rather than emitted directly, so the ordinary call path resolves the overload,
                # passes the function by raw pointer and converts the arguments.
                if fn_return_head_at(var_line.line, structs) == "__submit" and (local_scope.pool_names.count > 0 or submit_pool_name_at(var_line.line, structs) != ""):
                    if var_value is Expr.Block(sub_statements, sub_value, sub_captures, sub_block_line):
                        _ = sub_statements
                        _ = sub_captures
                        match sub_value:
                            Expr.Call(sub_callee, sub_args, sub_arg_names, sub_call_line):
                                # An EXPLICIT `submit[pool]` selector names its own pool; otherwise
                                # the enclosing `pool workers(N):` block supplies it.
                                sub_explicit: sview = submit_pool_name_at(var_line.line, structs)
                                sub_pool: sview = sub_explicit if sub_explicit != "" else local_scope.pool_names[local_scope.pool_names.count - 1]
                                # One argument only: `pool_submit1` is the only arity stage0's own
                                # corpus uses, and the helper name is per-arity. A wider submit keeps
                                # declining rather than calling a name that may not exist.
                                if sub_args.count == 1:
                                    sub_call_args: mutable darray[Expr] = [(Expr.Unary(TokenKind.Ampersand, (Expr.Ident(sub_pool, var_line)), var_line)), sub_callee, sub_args[0]]
                                    sub_rewritten: Expr = Expr.Call((Expr.Ident("pool_submit1", var_line)), sub_call_args, [], var_line)
                                    return emit_statement((Stmt.VarDecl(var_name, var_type, sub_rewritten, var_line)), return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)
                            _:
                                pass
                # `x: T = match SCRUT:` whose arms are BLOCKS (statements then a yield) — the
                # match-EXPRESSION emitter handles only single-expression arms and has no statement
                # context, so route it through the statement-level match-into-slot emitter.
                if var_value is Expr.Match(vm_scrutinee, vm_arms, vm_match_line):
                    vm_types: mutable darray[ValueType] = [copied_type(declared_type)]
                    vm_names: mutable darray[sview] = [var_name]
                    return emit_match_into_slot(vm_scrutinee, vm_arms, vm_types, vm_names, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)
                # A declaration without an initializer still needs a real storage
                # object.  In particular, fixed-size stack arrays are used as
                # scratch buffers by the runtime string helpers.  Expr.Invalid is
                # the parser's marker for this form, so materialize the language's
                # zero-initialized local rather than trying to emit it as a value.
                if var_value is Expr.Invalid or var_value is Expr.Absent:
                    uninitialized_storage: mutable darray[u8] = []
                    # One lookup for the alloca AND the zero store — `llvm_type_of` walks the
                    # struct table, and these two are consecutive on the same path.
                    uninitialized_llvm: LLVMTypeRef = llvm_type_of(declared_type, structs, ctx)
                    uninitialized_slot: LLVMValueRef = build_entry_alloca(builder, uninitialized_llvm, sview_to_cstr(var_name, uninitialized_storage))
                    uninitialized_alignment: u32 = struct_alignment(declared_type, structs)
                    LLVMSetAlignment(uninitialized_slot, uninitialized_alignment) if uninitialized_alignment != 0
                    _ = LLVMBuildStore(builder, LLVMConstNull(uninitialized_llvm), uninitialized_slot)
                    declare_local(local_scope, var_name, uninitialized_slot, declared_type)
                    # This path handles `zeroed` as well as an omitted initializer.  It must
                    # preserve the same binding mutability fact as the ordinary initializer
                    # path below: `r: mutable T& = zeroed; r <- &x` rebinds the local slot.
                    # Omitting this mark sends the later assignment through the null pointee
                    # and emits `load ptr null` / `store ... null`, which is a backend crash
                    # rather than a diagnostic.
                    mark_last_local_mutable(local_scope) if declared_type.kind == TypeKind.Ref and type_contains_token(var_type, TokenKind.Mutable)
                    return EmitStatus.Open
                # `v: T = try f(x)` — the value form of a propagating try. The parser strips the
                # `try` head, leaving a bare call to an error-returning fn; the semantic checker
                # already required the `try`, so any error-call RHS here IS one. Emit the
                # propagate-on-error path and store the success value into the local.
                if var_value is Expr.Call(try_var_callee, try_var_args, try_var_arg_names, try_var_call_line):
                    try_var_owner: sview = try_callee_owner(try_var_callee, fns, structs)
                    match try_callee_as_ident(try_var_callee, fns, structs):
                        Expr.Ident(try_var_name, try_var_name_line):
                            if declared_type.kind == TypeKind.ErrorUnion:
                                if emit_error_union_call_value(try_var_name, try_var_args, declared_type, local_scope, fns, structs, generics, runtime, m, ctx, builder, try_var_owner) is union_var_value:
                                    union_var_storage: mutable darray[u8] = []
                                    union_var_slot: LLVMValueRef = build_entry_alloca(builder, llvm_type_of(declared_type, structs, ctx), sview_to_cstr(var_name, union_var_storage))
                                    _ = LLVMBuildStore(builder, union_var_value, union_var_slot)
                                    declare_local(local_scope, var_name, union_var_slot, declared_type)
                                    return EmitStatus.Open
                            if error_callee_is(fns, structs, generics, try_var_name, try_var_owner):
                                try_var_no_recovery: darray[Stmt] = []
                                if emit_propagating_try_value(try_var_name, try_var_args, try_var_no_recovery, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder, try_var_owner) is try_var_value:
                                    try_var_storage: mutable darray[u8] = []
                                    try_var_slot: LLVMValueRef = build_entry_alloca(builder, llvm_type_of(declared_type, structs, ctx), sview_to_cstr(var_name, try_var_storage))
                                    stored_try_value: mutable LLVMValueRef = try_var_value
                                    if declared_type.kind == TypeKind.ErrorUnion:
                                        stored_try_value <- build_error_union_success(try_var_value, error_union_payload_of(declared_type, structs), declared_type, structs, runtime, ctx, builder)
                                    _ = LLVMBuildStore(builder, stored_try_value, try_var_slot)
                                    declare_local(local_scope, var_name, try_var_slot, declared_type)
                                    return EmitStatus.Open
                                return EmitStatus.Declined
                        _:
                            pass
                    # The callee may be a function-valued local/parameter (`f`) rather than a
                    # named error function. Its `try` was erased by the parser just like the
                    # named form, so give the tagged function-value propagation path the same
                    # opportunity before treating the RHS as an ordinary call.
                    if emit_propagating_fn_value_try(try_var_callee, try_var_args, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder) is try_fn_value:
                        try_fn_storage: mutable darray[u8] = []
                        try_fn_slot: LLVMValueRef = build_entry_alloca(builder, llvm_type_of(declared_type, structs, ctx), sview_to_cstr(var_name, try_fn_storage))
                        _ = LLVMBuildStore(builder, try_fn_value, try_fn_slot)
                        declare_local(local_scope, var_name, try_fn_slot, declared_type)
                        return EmitStatus.Open
                # Assigning an OPTIONAL value to a NON-optional local is a type error stage0
                # rejects ("variable expects T, got T?"); DECLINE rather than silently unwrap.
                # Also stops a miscompile: stage1's parser erases the control-flow else of
                # `x: i64 = get f() else return 7`, collapsing it to `x: i64 = f()` (f -> i64?).
                # `v: T = get OPT else return X` — the guarded optional is unwrapped on the
                # PRESENT path; the absent path runs the recovery, which terminates (a
                # `return`/`break`/`continue` is the only recovery form this node carries).
                # The local is therefore a plain `T` wherever it is live.
                if var_value is Expr.GetElse(get_guarded, get_recovery, get_else_line):
                    guarded_type: ValueType = expression_type(get_guarded, local_scope, fns, structs, generics)
                    EmitStatus.Declined return if guarded_type.kind != TypeKind.Optional
                    get_payload: ValueType = optional_payload_of(guarded_type, structs)
                    EmitStatus.Declined return if get_payload.kind != declared_type.kind or get_payload.bits != declared_type.bits
                    if emit_expression(get_guarded, guarded_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is get_optional:
                        get_fn: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                        get_present: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, get_fn, "get.present")
                        get_absent: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, get_fn, "get.absent")
                        get_tag: LLVMValueRef = optional_tag_of(get_optional, guarded_type, structs, ctx, builder)
                        _ = LLVMBuildCondBr(builder, get_tag, get_present, get_absent)
                        # ABSENT: the recovery runs and must leave the block terminated. If it
                        # somehow does not, DECLINE rather than fall through into the present
                        # path, which would read an absent optional's payload.
                        LLVMPositionBuilderAtEnd(builder, get_absent)
                        recovery_status: EmitStatus = emit_statements(get_recovery, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)
                        EmitStatus.Declined return if recovery_status != EmitStatus.Terminated
                        LLVMPositionBuilderAtEnd(builder, get_present)
                        get_value: LLVMValueRef = optional_payload_value_of(get_optional, guarded_type, structs, ctx, builder)
                        get_storage: mutable darray[u8] = []
                        get_slot: LLVMValueRef = build_entry_alloca(builder, llvm_type_of(declared_type, structs, ctx), sview_to_cstr(var_name, get_storage))
                        _ = LLVMBuildStore(builder, get_value, get_slot)
                        declare_local(local_scope, var_name, get_slot, declared_type)
                        return EmitStatus.Open
                    return EmitStatus.Declined
                var_value_type: ValueType = expression_type(var_value, local_scope, fns, structs, generics)
                if var_value_type.kind == TypeKind.Optional and declared_type.kind != TypeKind.Optional:
                    # BARE `get OPT` — the parser ERASES `get X` (no `else`) to the inner
                    # optional-producing expression plus a `__checked_get` line annotation, so
                    # a get-unwrap arrives here as a plain `x: T = OPT` with OPT: T?. stage0
                    # REJECTS an unnarrowed Optional->non-optional VarDecl outright ("variable
                    # expects T, got T?"), so any such decl that is NOT narrowed and reaches the
                    # backend IS a validated bare `get`: bind the payload on PRESENT, PROPAGATE
                    # None on ABSENT (this fn itself returns the optional the None flows into —
                    # `index_map_get` does `index: usize = get index_map_find_index(...)`).
                    if not path_is_narrowed(var_value, structs):
                        EmitStatus.Declined return if return_type.kind != TypeKind.Optional
                        bare_get_payload: ValueType = optional_payload_of(var_value_type, structs)
                        EmitStatus.Declined return if bare_get_payload.kind != declared_type.kind or bare_get_payload.bits != declared_type.bits
                        if emit_expression(var_value, var_value_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is bare_get_optional:
                            bare_get_fn: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                            bare_get_present: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, bare_get_fn, "get.bare.present")
                            bare_get_absent: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, bare_get_fn, "get.bare.absent")
                            bare_get_tag: LLVMValueRef = optional_tag_of(bare_get_optional, var_value_type, structs, ctx, builder)
                            _ = LLVMBuildCondBr(builder, bare_get_tag, bare_get_present, bare_get_absent)
                            # ABSENT: unwind live regions, then return this fn's None (a zeroed
                            # optional aggregate — tag 0 = absent — of the declared return type).
                            LLVMPositionBuilderAtEnd(builder, bare_get_absent)
                            emit_region_unwind(regions, runtime, builder)
                            bare_get_none: LLVMValueRef = LLVMConstNull(llvm_type_of(return_type, structs, ctx))
                            if not emit_sret_return(bare_get_none, return_type, runtime, structs, ctx, builder):
                                _ = LLVMBuildRet(builder, bare_get_none)
                            # PRESENT: bind the payload and continue.
                            LLVMPositionBuilderAtEnd(builder, bare_get_present)
                            bare_get_value: LLVMValueRef = optional_payload_value_of(bare_get_optional, var_value_type, structs, ctx, builder)
                            bare_get_storage: mutable darray[u8] = []
                            bare_get_slot: LLVMValueRef = build_entry_alloca(builder, llvm_type_of(declared_type, structs, ctx), sview_to_cstr(var_name, bare_get_storage))
                            _ = LLVMBuildStore(builder, bare_get_value, bare_get_slot)
                            declare_local(local_scope, var_name, bare_get_slot, declared_type)
                            return EmitStatus.Open
                        return EmitStatus.Declined
                    # NARROWED by an earlier `assert PATH != null`: stage0 accepts the
                    # assignment (and emits a plain pointer copy, its `T&?` being a bare
                    # ptr). stage1's `{i1, ptr}` needs the payload extracted.
                    narrowed_payload: ValueType = optional_payload_of(var_value_type, structs)
                    EmitStatus.Declined return if narrowed_payload.kind != declared_type.kind or narrowed_payload.bits != declared_type.bits
                    if emit_expression(var_value, var_value_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is narrowed_optional:
                        narrowed_value: LLVMValueRef = optional_payload_value_of(narrowed_optional, var_value_type, structs, ctx, builder)
                        narrow_storage: mutable darray[u8] = []
                        narrow_slot: LLVMValueRef = build_entry_alloca(builder, llvm_type_of(declared_type, structs, ctx), sview_to_cstr(var_name, narrow_storage))
                        _ = LLVMBuildStore(builder, narrowed_value, narrow_slot)
                        declare_local(local_scope, var_name, narrow_slot, declared_type)
                        return EmitStatus.Open
                    return EmitStatus.Declined
                # `xs: darray[i64] @host = [...]` — an explicit REGION PIN. The initializer
                # must allocate from the NAMED region, not from the ambient arena: a container
                # pinned to a longer-lived region that lands in a shorter-lived one has its
                # data freed underneath the program (stage0 answers 60 on the two-lifetime
                # fixture; stage1 used to segfault). The qualifier was dropped entirely.
                #
                # The region name is a LOCAL of type Arena (a `region r:` block or bare
                # `region r(n)` statement both bind one) or a `mutable Arena&` alias, which
                # holds a POINTER to someone else's arena and so takes one load.
                pinned_region: sview = local_region_name_at(var_line.line, structs)
                pinned_runtime: mutable Runtime = copied_runtime(runtime)
                pinned_arena: mutable LLVMValueRef = zeroed
                pinned_ok: mutable bool = false
                if pinned_region != "":
                    pinned_type: ValueType = lookup_type(local_scope, pinned_region)
                    if lookup_slot(local_scope, pinned_region) is pinned_slot:
                        if pinned_type.kind == TypeKind.Arena:
                            pinned_arena <- pinned_slot
                            pinned_ok <- true
                        elif pinned_type.kind == TypeKind.Ref and ref_target_of(pinned_type, structs).kind == TypeKind.Arena:
                            pinned_arena <- LLVMBuildLoad2(builder, LLVMPointerTypeInContext(ctx, 0), pinned_slot, "region.pin")
                            pinned_ok <- true
                    # A qualifier that names no LOCAL is a REGION PARAMETER (`def f[@r]`):
                    # `r`'s arena is the one already threaded in as runtime.arena, so the
                    # ambient arena is the right answer and there is nothing to override.
                    # Declining here instead broke the compiler's own self-compile, which
                    # uses that spelling.
                    pinned_runtime.arena <- pinned_arena if pinned_ok
                if emit_expression_coerced(var_value, declared_type, local_scope, fns, structs, generics, pinned_runtime, m, ctx, builder) is initial:
                    # A VOID value cannot be stored. `x: i64 = f()` where `f` returns void
                    # emitted `store void <badref>` — IR the verifier rejects outright, and
                    # which CRASHED the object path inside LLVM's DataLayout (an EXC_BREAKPOINT
                    # in getTypeSizeInBits, exit 133) instead of producing a diagnostic.
                    # Reachable only from a program the frontend already rejected, which is
                    # exactly when a compiler must not trap. Types are uniqued per context, so
                    # this compares by identity.
                    EmitStatus.Declined return if LLVMTypeOf(initial) == LLVMVoidTypeInContext(ctx)
                    name_storage: mutable darray[u8] = []
                    slot: LLVMValueRef = build_entry_alloca(builder, llvm_type_of(declared_type, structs, ctx), sview_to_cstr(var_name, name_storage))
                    local_alignment: u32 = struct_alignment(declared_type, structs)
                    LLVMSetAlignment(slot, local_alignment) if local_alignment != 0
                    _ = LLVMBuildStore(builder, initial, slot)
                    emit_trace_value(var_name, var_line.line, initial, declared_type, runtime, ctx, builder)
                    declare_local(local_scope, var_name, slot, declared_type)
                    register_drop_cleanup(var_name, declared_type, slot, var_line.line, local_scope, structs, ctx, builder)
                    # Remember the pin so LATER growth (`xs.push(...)`) reallocates from the
                    # same region the initial allocation came from -- see growth_arena_for.
                    mark_last_local_arena(local_scope, pinned_arena) if pinned_ok
                    # `r: mutable T& = v` -- the ONE spelling that can annotate a Ref-typed
                    # local `mutable` at all. Marks it so a later `r <- v2` REBINDS (stores a
                    # new T&-typed value into the slot) instead of the write-through every
                    # other Ref-typed local gets on `<-` -- see mark_last_local_mutable and
                    # the matching check in codegen_stmt_assign_flow.elisa.
                    mark_last_local_mutable(local_scope) if declared_type.kind == TypeKind.Ref and type_contains_token(var_type, TokenKind.Mutable)
                    # `runner: fn(i64, i64) -> i64 = add` — remember WHICH function the alias
                    # points at. The Fn type carries parameter TYPES but no parameter NAMES, so
                    # this is the only way a later `runner(y: 7, x: 3)` can be reordered.
                    if declared_type.kind == TypeKind.Fn:
                        if var_value is Expr.Ident(fn_origin_name, fn_origin_line):
                            mark_last_local_fn_origin(local_scope, fn_origin_name) if function_index_of(fns, "", fn_origin_name) >= 0
                    # The same fact one level in: `box: CallbackBox = CallbackBox{run: add}`.
                    # A fn-typed FIELD's `fn(i64, i64)` type has no parameter names either, so a
                    # later `box.run(y: 7, x: 3)` needs the alias target to reorder against --
                    # exactly as the fn-typed LOCAL above does. Only a field initialised from a
                    # bare Ident naming a real function is recorded; anything else (a lambda, a
                    # call result, another field) leaves no entry, and the labelled call keeps
                    # declining rather than guessing an order.
                    if var_value is Expr.Construct(fn_field_ctor_type, fn_field_ctor_fields, fn_field_ctor_line):
                        for fn_field_init in fn_field_ctor_fields |var_name, local_scope, fns|:
                            match fn_field_init.value:
                                Expr.Ident(fn_field_target, fn_field_target_line):
                                    mark_local_fn_field_alias(local_scope, var_name, fn_field_init.name, fn_field_target) if function_index_of(fns, "", fn_field_target) >= 0
                                _:
                                    pass
                    # arg_no 0 = a LOCAL (DW_TAG_variable), not a formal parameter.
                    declare_debug_variable(var_name, slot, declared_type, 0, var_line.line, LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder)), runtime, structs, ctx, builder)
                    return EmitStatus.Open
                return EmitStatus.Declined
            handled <- false
            return EmitStatus.Declined
