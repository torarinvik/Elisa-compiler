# Stage1 backend — `x: T = value`, a local DECLARATION: allocate the slot, emit the initializer
# against the declared type, and record the local (with its region, mutability and drop
# obligation). Reached from codegen_stmt_return_vardecl.elisa, which handles `return` first.
# Part of `module Backend` (see codegen.elisa).

extend Backend:
    private:
        # An initializer made only of integer literals, unary minus/complement, parens and
        # arithmetic: typeless in the same sense a bare literal is.
        def untyped_value_is_integer_literal_tree(value: Expr) -> bool:
            can Abort.Panic:
                match value:
                    Expr.IntLit(_, _):
                        return true
                    Expr.Block(value: lit_tree_value, _):
                        return untyped_value_is_integer_literal_tree(lit_tree_value)
                    Expr.If(_, lit_tree_then, lit_tree_else, _):
                        return untyped_value_is_integer_literal_tree(lit_tree_then) and untyped_value_is_integer_literal_tree(lit_tree_else)
                    # A value `match` whose every YIELDING arm (single expression or block tail)
                    # is a literal tree; an arm that ends in `return`/`raise` yields nothing.
                    Expr.Match(_, lit_tree_arms, _):
                        lit_tree_yields: mutable usize = 0
                        for lit_tree_arm in lit_tree_arms |lit_tree_yields|:
                            continue if lit_tree_arm.body.count == 0
                            if lit_tree_arm.body[lit_tree_arm.body.count - 1] is Stmt.Expr(lit_tree_yield, _):
                                return false if not untyped_value_is_integer_literal_tree(lit_tree_yield)
                                lit_tree_yields <- lit_tree_yields + 1
                        return lit_tree_yields > 0
                    Expr.Paren(lit_tree_inner, _):
                        return untyped_value_is_integer_literal_tree(lit_tree_inner)
                    Expr.Unary(lit_tree_op, lit_tree_operand, _):
                        return false if lit_tree_op != TokenKind.Minus and lit_tree_op != TokenKind.Tilde
                        return untyped_value_is_integer_literal_tree(lit_tree_operand)
                    Expr.Binary(lit_tree_left, lit_tree_bop, lit_tree_right, _):
                        return false if not (lit_tree_bop == TokenKind.Plus or lit_tree_bop == TokenKind.Minus or lit_tree_bop == TokenKind.Star or lit_tree_bop == TokenKind.Slash or lit_tree_bop == TokenKind.Percent)
                        return untyped_value_is_integer_literal_tree(lit_tree_left) and untyped_value_is_integer_literal_tree(lit_tree_right)
                    _:
                        return false

        # The FLOAT counterpart: numeric literals under unary minus, parens and `+ - * /`, with
        # at least one float leaf. stage0 folds `0.0`, `-1.5` and `1 + 2.5` to one untyped float
        # constant and types the binding f64 (`|sum = 0.0|` then `sum <- true` is "cannot assign
        # bool to f64"). Blocks and value-`if`s are left out: nothing measured them.
        def untyped_value_is_float_literal_tree(value: Expr) -> bool:
            can Abort.Panic:
                match value:
                    Expr.FloatLit(_, _):
                        return true
                    Expr.Paren(float_tree_inner, _):
                        return untyped_value_is_float_literal_tree(float_tree_inner)
                    Expr.Unary(float_tree_op, float_tree_operand, _):
                        return false if float_tree_op != TokenKind.Minus
                        return untyped_value_is_float_literal_tree(float_tree_operand)
                    Expr.Binary(float_tree_left, float_tree_bop, float_tree_right, _):
                        return false if not (float_tree_bop == TokenKind.Plus or float_tree_bop == TokenKind.Minus or float_tree_bop == TokenKind.Star or float_tree_bop == TokenKind.Slash)
                        left_float: bool = untyped_value_is_float_literal_tree(float_tree_left)
                        right_float: bool = untyped_value_is_float_literal_tree(float_tree_right)
                        return false if:
                            not (left_float or untyped_value_is_integer_literal_tree(float_tree_left))
                            not (right_float or untyped_value_is_integer_literal_tree(float_tree_right))
                        return left_float or right_float
                    _:
                        return false
