# Stage1 backend — the GENERIC TABLE and the inference that fills it: unify a parameter's
# annotation against a concrete argument type, infer the full type-argument tuple from the
# call (or from the expected type when a parameter appears only in the return), and resolve an
# `errorset R` family. Part of `module Backend` (see codegen.elisa).

extend Backend:
    private:


        # Per-walk exact ValueType identity set. Tiny graphs stay in the linear `keys`
        # vector; larger graphs promote to an open-addressed table whose slots hold
        # one-based indices into `keys` (zero remains an unambiguous empty marker).
        struct BackendTypeVisitSet:
            keys: mutable darray[ValueType]
            buckets: mutable darray[usize]
            hashed: mutable bool


        def backend_type_visit_hash(value_type: ValueType) -> usize:
            h: mutable u64 = value_type.bits.u64() ^ (value_type.kind.u64() * 0x9e3779b97f4a7c15)
            h <- (h ^ (h >> 30)) * 0xbf58476d1ce4e5b9
            h <- (h ^ (h >> 27)) * 0x94d049bb133111eb
            h <- h ^ (h >> 31)
            return h.usize()


        def backend_type_visit_probe(keys: darray[ValueType]&, buckets: darray[usize]&, value_type: ValueType) -> usize can[Abort.Panic]:
            assert buckets.count > 0.usize() and (buckets.count & (buckets.count - 1.usize())) == 0.usize()
            mask: usize = buckets.count - 1.usize()
            slot: mutable usize = backend_type_visit_hash(value_type) & mask
            probed: mutable usize = 0
            trusted Unsafe.AssumeProgress:
                while probed < buckets.count:
                    key_index_plus_one: usize = buckets[slot]
                    if key_index_plus_one == 0.usize():
                        return slot
                    key_index: usize = key_index_plus_one - 1.usize()
                    assert key_index < keys.count
                    prior: ValueType = keys[key_index]
                    return slot if prior.kind == value_type.kind and prior.bits == value_type.bits
                    slot <- (slot + 1.usize()) & mask
                    probed <- probed + 1.usize()
            panic("backend type visit table exhausted")


        def backend_type_visit_grow[@r](visited: mutable BackendTypeVisitSet& @r, capacity: usize) -> void can[Abort.Panic, Memory.Allocate]:
            assert capacity >= 16.usize() and (capacity & (capacity - 1.usize())) == 0.usize()
            new_buckets: mutable darray[usize] @r = []
            new_buckets.resize(capacity)
            for key_index in 0..<visited.keys.count:
                slot: usize = backend_type_visit_probe(visited.keys, new_buckets, visited.keys[key_index])
                assert new_buckets[slot] == 0.usize()
                new_buckets[slot] <- key_index + 1.usize()
            visited.buckets <- new_buckets
            visited.hashed <- true


        # Returns true for a previously visited exact (kind, bits) pair.
        def backend_type_visit_seen_or_insert(visited: mutable BackendTypeVisitSet&, value_type: ValueType) -> bool can[Abort.Panic, Memory.Allocate]:
            if not visited.hashed:
                for prior in visited.keys:
                    return true if prior.kind == value_type.kind and prior.bits == value_type.bits
                if visited.keys.count < 8.usize():
                    visited.keys <- visited.keys.push(copied_type(value_type))
                    return false
                backend_type_visit_grow(visited, 16.usize())
            slot: mutable usize = backend_type_visit_probe(visited.keys, visited.buckets, value_type)
            if visited.buckets[slot] != 0.usize():
                return true
            if visited.keys.count + 1.usize() >= visited.buckets.count - visited.buckets.count / 4.usize():
                new_capacity: usize = visited.buckets.count * 2.usize()
                assert new_capacity > visited.buckets.count
                backend_type_visit_grow(visited, new_capacity)
                slot <- backend_type_visit_probe(visited.keys, visited.buckets, value_type)
            visited.keys <- visited.keys.push(copied_type(value_type))
            visited.buckets[slot] <- visited.keys.count
            return false


        # Generic function TEMPLATES, and the instantiations made from them.
        #
        # The instantiation cache is keyed by (base name, type argument) — NOT by mangled
        # name. That is deliberate: an `sview` is a view, so a mangled name built into a
        # local buffer would DANGLE the moment the buffer's region died (Elisa's region
        # checker catches exactly this). `base_names` are sviews into the SOURCE buffer,
        # which outlives everything, and ValueType is POD — so nothing here borrows.
        #
        # The mangled name is only ever needed transiently, to hand to LLVMAddFunction,
        # which COPIES it. So it is built in a local buffer, used, and dropped.
        #
        # Generic parameter names come from the FILE-level side table
        # (`generic_param_names` / `generic_param_lines`) keyed by the function's LINE —
        # they are NOT on Decl.Func. A row whose line has the high bit set is a BOUND
        # (`[T: Ord]`): metadata the backend never needs, since it only instantiates types
        # the frontend already accepted.
        struct GenericTable:
            names: mutable darray[sview @source]
            # Name chains over `names` (codegen_name_chains.elisa).
            name_buckets: mutable darray[i64] = []
            name_tails: mutable darray[i64] = []
            name_next: mutable darray[i64] = []
            decls: mutable darray[Decl]
            params: mutable darray[sview @source]
            # Parallel to params: only parameters with an explicit `N: usize` parser bound
            # may receive a fixed-array extent during inference.
            param_is_usize_value: mutable darray[bool]
            param_start: mutable darray[usize]
            param_count: mutable darray[usize]
            # Whether each template is ERROR-RETURNING (`… error[E]`): its instantiations must
            # use the i32-status + leading-out-param ABI, in both the signature and the body.
            # Computed at registration from the file's error-line side table (a template has no
            # `error[E]` node on its Decl — the clause is consumed at parse time).
            is_error: mutable darray[bool]
            # Optional errorset parameter name, one row per generic template. This is not
            # an ordinary type argument: it specializes the error family/permission row.
            error_params: mutable darray[sview @source]
            # The MODULE that declared each template, or "" for a top-level generic. An
            # instantiation's body is emitted long after the module walk has moved on, so the
            # owner cannot be read from the emission context: without this row the body is
            # emitted as if top-level, and a bare sibling call inside `module M:` silently
            # binds to a same-named TOP-LEVEL function instead of M's own member. That is a
            # wrong-answer bug, not a diagnostic -- the program compiles and calls the wrong
            # function.
            owners: mutable darray[sview @source]
            # The module whose body is being emitted, mirrored from structs.current_owner at
            # the one place that sets it, so a bare generic call can prefer ITS OWN module's
            # template. generic_index_of has no StructTable in reach.
            current_owner: mutable sview @source
            # Instantiations, keyed by (base name, type-argument TUPLE). A generic may have
            # more than one type parameter (`arena_dict_put[K, T]`), so the arguments live in
            # a flat pool with a per-instantiation span rather than one ValueType per row.
            inst_bases: mutable darray[sview @source]
            inst_args: mutable darray[ValueType]
            inst_arg_start: mutable darray[usize]
            inst_arg_count: mutable darray[usize]
            inst_handles: mutable darray[LLVMValueRef]
            # The template SLOT each instantiation came from. Redundant with the base name UNLESS
            # the name is overloaded (`len[T](Slice)` vs `len[T](ReadView)`): then base+args are not
            # unique, so the slot is what distinguishes the two — used to key the cache and to emit
            # the correct BODY (emit_instantiation_body must not re-derive the slot by first-name).
            inst_slots: mutable darray[usize]
            # Instantiation rows chained by template slot (ascending insertion order). Repeated
            # specialization lookup should compare only this template's argument tuples, not all
            # prior generic function instances. If the chain arrays are ever out of sync with
            # `inst_slots`, lookup falls back to the full scan.
            inst_by_slot_heads: mutable darray[i64]
            inst_by_slot_tails: mutable darray[i64]
            inst_by_slot_next: mutable darray[i64]
            # Concrete error-family selector for each instantiation. Kept parallel to
            # inst_slots so two specializations with the same ordinary type arguments but
            # different error rows never share an LLVM body or symbol.
            inst_error_families: mutable darray[sview @source]
            # Whether this instantiation's SIGNATURE trails the caller's arena — RECORDED at
            # declaration rather than recomputed per call site.
            #
            # signature_needs_arena is ORDER-DEPENDENT: it asks whether a parameter's target is
            # a growable container, and a `dict[K, T]&` parameter only answers yes once
            # `DynDict[K, T]` has been registered. Two instantiations of the same shape
            # therefore disagreed depending on which was declared first —
            # arena_dict_put_or_panic[u64, sview] got NO arena parameter while the
            # arena_dict_put[u64, sview] it calls got one, so the callee read its arena out of a
            # register the caller never set. Every dict `put` then grew its bucket array from a
            # garbage Arena, and the stage1-built semantic analyzer segfaulted probing past the
            # end of it.
            #
            # A call site always declares the instantiation before emitting its arguments, so
            # reading the recorded flag makes the two sides agree BY CONSTRUCTION rather than by
            # both happening to recompute the same answer.
            inst_needs_arena: mutable darray[bool]
            # Whether the instantiation carries the hidden packed-store parameter
            # (a param or the return mentions a store-backed hierarchy), recorded
            # for the same reason as inst_needs_arena.
            inst_needs_store: mutable darray[bool]
            # The hidden-ARENA layout each instantiation was declared with: how many slots,
            # and for every declared parameter the slot it owns (-1 = none), pooled like
            # inst_args. A generic that grows a reference parameter needs THAT caller's arena
            # exactly like an ordinary function (stage0 declares `fill2__i64(a, b, ..., ptr,
            # ptr)`). The declaration used to thread only a return slot while the body read a
            # slot per grown parameter from the region facts, so LLVMGetParam ran past the
            # signature and the compiler crashed in the verifier. The body and every call site
            # now read this record back, so all three agree by construction.
            inst_arena_counts: mutable darray[usize]
            inst_arena_param_start: mutable darray[usize]
            inst_arena_param_counts: mutable darray[usize]
            inst_arena_param_slots: mutable darray[i64]
            # The WORKLIST: instantiations declared but whose BODY still needs emitting. A
            # body cannot be emitted at the call site (the builder sits inside the caller),
            # so emit_module drains this afterwards — and keeps draining, because a generic
            # can call another generic. Type args are pooled the same way as inst_args.
            pending_bases: mutable darray[sview @source]
            pending_args: mutable darray[ValueType]
            pending_arg_start: mutable darray[usize]
            pending_arg_count: mutable darray[usize]
            pending_handles: mutable darray[LLVMValueRef]
            # The instantiation metadata row for each pending body. Carrying it through the
            # worklist avoids searching every declared specialization by LLVM handle when
            # the body reads its recorded hidden-arena layout.
            pending_inst_rows: mutable darray[usize]
            # The template slot for each queued body (parallel to pending_bases). emit_instantiation_body
            # emits generics.decls[this slot] — NOT decls[generic_index_of(base)], which would pick the
            # first overload's body for an overloaded name.
            pending_slots: mutable darray[usize]
            pending_error_families: mutable darray[sview @source]



        def new_generic_table() -> GenericTable can[Abort.Panic, Memory.Allocate]:
            return GenericTable{current_owner: "", names: [], decls: [], params: [], param_is_usize_value: [], param_start: [], param_count: [], is_error: [], error_params: [], owners: [], inst_bases: [], inst_args: [], inst_arg_start: [], inst_arg_count: [], inst_handles: [], inst_slots: [], inst_by_slot_heads: [], inst_by_slot_tails: [], inst_by_slot_next: [], inst_error_families: [], inst_needs_arena: [], inst_needs_store: [], inst_arena_counts: [], inst_arena_param_start: [], inst_arena_param_counts: [], inst_arena_param_slots: [], pending_bases: [], pending_args: [], pending_arg_start: [], pending_arg_count: [], pending_handles: [], pending_inst_rows: [], pending_slots: [], pending_error_families: []}



        # Push one type-parameter binding per (param name, type arg) for template `slot`, so
        # annotation_value_type resolves the template's `K`/`T` to the concrete args. Returns
        # the number pushed, to pop symmetrically with pop_type_bindings.
        def push_type_bindings(generics: GenericTable&, structs: mutable StructTable&, slot: usize, type_args: darray[ValueType]&) -> usize can[Abort.Panic, Memory.Allocate]:
            return 0 if:
                slot >= generics.names.count or slot >= generics.decls.count
                slot >= generics.param_start.count or slot >= generics.param_count.count
            pstart: usize = generics.param_start[slot]
            count: usize = generics.param_count[slot]
            return 0 if:
                pstart > generics.params.count
                count > generics.params.count - pstart
            bound: mutable usize = 0
            for k in 0..<count |structs, generics, pstart, type_args, bound, count|:
                break if k >= type_args.count
                structs.bindings.binding_names <- structs.bindings.binding_names.push(generics.params[pstart + k])
                structs.bindings.binding_types <- structs.bindings.binding_types.push(copied_type(type_args[k]))
                bound <- bound + 1
            return bound



        def pop_type_bindings(structs: mutable StructTable&, count: usize) -> void can[Abort.Panic, Memory.Allocate]:
            for _drop in 0..<count |structs|:
                structs.bindings.binding_names <- structs.bindings.binding_names.truncate(structs.bindings.binding_names.count - 1)
                structs.bindings.binding_types <- structs.bindings.binding_types.truncate(structs.bindings.binding_types.count - 1)



        # Bind an `errorset R` parameter for the duration of resolving a generic signature or
        # body. Error families are source selectors/permissions rather than ValueTypes, so they
        # deliberately live outside the ordinary type binding stack.
        def push_error_family_binding(generics: GenericTable&, structs: mutable StructTable&, slot: usize, family: sview @source) -> usize can[Abort.Panic, Memory.Allocate]:
            return 0 if slot >= generics.error_params.count or generics.error_params[slot] == "" or family == ""
            structs.errors.error_binding_names <- structs.errors.error_binding_names.push(generics.error_params[slot])
            structs.errors.error_binding_families <- structs.errors.error_binding_families.push(family)
            return 1



        def pop_error_family_bindings(structs: mutable StructTable&, count: usize) -> void can[Abort.Panic, Memory.Allocate]:
            for _drop in 0..<count |structs|:
                structs.errors.error_binding_names <- structs.errors.error_binding_names.truncate(structs.errors.error_binding_names.count - 1)
                structs.errors.error_binding_families <- structs.errors.error_binding_families.truncate(structs.errors.error_binding_families.count - 1)



        # Resolve an error-family selector through the current generic binding stack. A plain
        # selector is returned unchanged; a bound selector such as R becomes IoErr.
        def resolved_error_family(family: sview @source, structs: StructTable&) -> sview @source can[Abort.Panic]:
            count: usize = structs.errors.error_binding_names.count
            for offset in 0..<count |family, structs, count|:
                index: usize = count - 1.usize() - offset
                return structs.errors.error_binding_families[index] if structs.errors.error_binding_names[index] == family
            return family



        # The position of type-parameter `name` in template `slot`, or -1. Used by inference
        # to bind the argument that pins that parameter.
        def type_param_position(generics: GenericTable&, slot: usize, name: sview) -> i64 can[Abort.Panic]:
            return -1 if:
                slot >= generics.names.count or slot >= generics.decls.count
                slot >= generics.param_start.count or slot >= generics.param_count.count
            pstart: usize = generics.param_start[slot]
            count: usize = generics.param_count[slot]
            return -1 if:
                pstart > generics.params.count
                count > generics.params.count - pstart
            for k in 0..<count |generics, pstart, name, count|:
                return k.i64() if generics.params[pstart + k] == name
            return -1



        # UNIFY a parameter's type annotation against the CONCRETE type of the argument
        # passed for it, binding any type parameters it names. `mutable`/`&` qualifiers are
        # transparent (the argument's value type is what matters), and a `Base[..]` annotation
        # recurses into a matching generic-struct instantiation's stored arguments — so
        # `dict[K, T]&` unified against a `DynDict[i64, i64]` argument pins K=i64, T=i64.
        def unify_annotation(annotation: Expr, actual: ValueType, generics: GenericTable&, slot: usize, structs: StructTable&, bindings: mutable darray[ValueType]&, bound_flags: mutable darray[bool]&) -> void can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic, Memory.Allocate:
                match annotation:
                    Expr.Unary(qualifier, inner_annotation, qualifier_line):
                        # `mutable T` is transparent. `T&` strips a reference on BOTH sides in step:
                        # the argument for a `Bucket[T]&` parameter is often a `Bucket[i64]&` (e.g.
                        # `&arr[0]`), so the outer `&` must peel off the actual's Ref too before the
                        # inner `Bucket[T]` unifies against the instantiation.
                        unify_annotation(inner_annotation, actual, generics, slot, structs, bindings, bound_flags) if qualifier == TokenKind.Mutable
                        if qualifier == TokenKind.Ampersand:
                            # Read the referent directly (ref_target_of would demand a mutable table).
                            stripped_actual: ValueType = copied_type(structs.interned_types.ref_targets[actual.bits.usize()]) if actual.kind == TypeKind.Ref else copied_type(actual)
                            unify_annotation(inner_annotation, stripped_actual, generics, slot, structs, bindings, bound_flags)
                        if qualifier == TokenKind.Question:
                            # `T&?` / `Box[T]?`: optionality wraps the
                            # parameter shape but does not hide its generic
                            # payload. Peel the concrete optional in lockstep
                            # before continuing inference.
                            optional_actual: ValueType = copied_type(structs.interned_types.optional_targets[actual.bits.usize()]) if actual.kind == TypeKind.Optional else copied_type(actual)
                            unify_annotation(inner_annotation, optional_actual, generics, slot, structs, bindings, bound_flags)
                        return
                    _:
                        pass
                match annotation:
                    Expr.Ident(param_name, param_name_line):
                        position: i64 = type_param_position(generics, slot, param_name)
                        if position >= 0 and not bound_flags[position.usize()]:
                            bindings[position.usize()] <- copied_type(actual)
                            bound_flags[position.usize()] <- true
                        return
                    _:
                        pass
                # `view[T]` annotation against a `view[U]` argument — bind T from the view's
                # interned element. Checked before the generic-struct branch (a View is not a
                # struct instantiation), so `arena_da_fill(view, …)` recovers its element type.
                match annotation:
                    Expr.Index(view_annotation_head, view_annotation_arg, view_annotation_line):
                        match view_annotation_head:
                            Expr.Ident(view_annotation_name, view_annotation_head_line):
                                if view_annotation_name == "view" and actual.kind == TypeKind.View:
                                    unify_annotation(view_annotation_arg, copied_type(structs.interned_types.view_elements[actual.bits.usize()]), generics, slot, structs, bindings, bound_flags)
                                    return
                                # `darray[T]` annotation against a `darray[U]` argument — bind T from the
                                # argument's element (like the view case). Needed so a generic over a darray
                                # PARAMETER (`slice[T](da: darray[T]&)`, `arena_da_fill[T](darray[T]&, …)`)
                                # infers T; the outer `&` was already peeled by the Unary branch above.
                                if view_annotation_name == "darray" and actual.kind == TypeKind.DArray:
                                    unify_annotation(view_annotation_arg, copied_type(structs.interned_types.darray_elements[actual.bits.usize()]), generics, slot, structs, bindings, bound_flags)
                                    return
                            _:
                                pass
                    _:
                        pass
                # `darray[T, shape_in]` — the SHAPED spelling the std uses on every in-place
                # container helper (`arena_da_view[T](da: darray[T, shape_in]&, …)`). The shape
                # argument makes the annotation an IndexN, so the single-argument darray branch
                # above never matched and T never bound, which failed inference for the whole call.
                # Shapes are erased at the type level already; the ELEMENT is type argument 0 and
                # the trailing shapes carry nothing to unify against. (`view` is NOT included: it
                # takes exactly one argument, so a shaped view does not parse.)
                match annotation:
                    Expr.IndexN(shaped_head, shaped_args, shaped_line):
                        match shaped_head:
                            Expr.Ident(shaped_name, shaped_head_line):
                                if shaped_name == "darray" and actual.kind == TypeKind.DArray and shaped_args.count >= 1:
                                    unify_annotation(shaped_args[0], copied_type(structs.interned_types.darray_elements[actual.bits.usize()]), generics, slot, structs, bindings, bound_flags)
                                    return
                            _:
                                pass
                    _:
                        pass
                # `Base[A]` / `Base[A, B]` — recurse into the argument's instantiation arguments
                # when the argument is that same generic struct.
                actual_base: mutable sview = ""
                actual_arg_start: mutable usize = 0
                actual_arg_count: mutable usize = 0
                has_instantiation: bool = generic_struct_instantiation_of(structs, actual, actual_base, actual_arg_start, actual_arg_count)
                return if not has_instantiation
                actual_template_id: u32 = generic_value_template_id(actual, structs)
                match annotation:
                    Expr.Index(base_head, single_type_arg, index_line):
                        match base_head:
                            Expr.Ident(base_name, base_head_line):
                                mapped_base: sview = "DynDict" if base_name == "dict" else ("DynSet" if base_name == "set" else base_name)
                                if mapped_base == actual_base and actual_arg_count == 1 and generic_head_template_id(base_head, mapped_base, structs) == actual_template_id:
                                    unify_annotation(single_type_arg, copied_type(structs.generics.generic_struct_inst_args[actual_arg_start]), generics, slot, structs, bindings, bound_flags)
                            Expr.Scope(_, scoped_name, _):
                                if actual_template_id != 0 and generic_head_template_id(base_head, scoped_name, structs) == actual_template_id and actual_arg_count == 1:
                                    unify_annotation(single_type_arg, copied_type(structs.generics.generic_struct_inst_args[actual_arg_start]), generics, slot, structs, bindings, bound_flags)
                            _:
                                pass
                        return
                    _:
                        pass
                match annotation:
                    Expr.IndexN(multi_base_head, multi_type_args, multi_index_line):
                        match multi_base_head:
                            Expr.Ident(multi_base_name, multi_base_head_line):
                                mapped_multi_base: sview = "DynDict" if multi_base_name == "dict" else ("DynSet" if multi_base_name == "set" else multi_base_name)
                                if mapped_multi_base == actual_base and actual_arg_count == multi_type_args.count and generic_head_template_id(multi_base_head, mapped_multi_base, structs) == actual_template_id:
                                    for arg_position in 0..<multi_type_args.count |multi_type_args, actual_arg_start, generics, slot, structs, bindings, bound_flags|:
                                        unify_annotation(multi_type_args[arg_position], copied_type(structs.generics.generic_struct_inst_args[actual_arg_start + arg_position]), generics, slot, structs, bindings, bound_flags)
                            Expr.Scope(_, scoped_name, _):
                                if actual_template_id != 0 and generic_head_template_id(multi_base_head, scoped_name, structs) == actual_template_id and actual_arg_count == multi_type_args.count:
                                    for arg_position in 0..<multi_type_args.count |multi_type_args, actual_arg_start, generics, slot, structs, bindings, bound_flags|:
                                        unify_annotation(multi_type_args[arg_position], copied_type(structs.generics.generic_struct_inst_args[actual_arg_start + arg_position]), generics, slot, structs, bindings, bound_flags)
                            _:
                                pass
                        return


                    _:
                        pass


            # If `value_type` is a materialized generic-struct instantiation, report its base name
            # and the flat span of its stored type arguments.
        def generic_value_template_id(value_type: ValueType, structs: StructTable&) -> u32 can[Abort.Panic]:
            return 0 if value_type.kind != TypeKind.Struct
            instance: mutable usize = generic_inst_first_row(structs, value_type.bits.usize())
            while instance < structs.generics.generic_struct_inst_index.count |instance, value_type, structs|:
                return generic_instance_template_id(instance, structs) if structs.generics.generic_struct_inst_index[instance] == value_type.bits.usize()
                instance <- generic_inst_next_row(structs, instance)
            return 0

        def generic_head_template_id(head: Expr, name: sview, structs: StructTable&) -> u32 can[Abort.Panic]:
            template_index: mutable i64 = -1
            match head:
                Expr.Ident(_, _):
                    template_index <- generic_struct_index_of(structs, name)
                Expr.Scope(owner, member, _):
                    template_index <- annotation_scoped_template_index(owner, member, structs)
                _:
                    pass
            return (template_index + 1).u32() if template_index >= 0 else 0

        def generic_struct_instantiation_of(structs: StructTable&, value_type: ValueType, out_base: mutable sview&, out_arg_start: mutable usize&, out_arg_count: mutable usize&) -> bool can[Abort.Panic]:
            return false if value_type.kind != TypeKind.Struct
            inst: mutable usize = generic_inst_first_row(structs, value_type.bits.usize())
            while inst < structs.generics.generic_struct_inst_index.count |inst, structs, value_type, out_base, out_arg_start, out_arg_count|:
                if structs.generics.generic_struct_inst_index[inst] == value_type.bits.usize():
                    out_base <- structs.generics.generic_struct_inst_bases[inst]
                    out_arg_start <- structs.generics.generic_struct_inst_arg_start[inst]
                    out_arg_count <- structs.generics.generic_struct_inst_arg_count[inst]
                    return true
                inst <- generic_inst_next_row(structs, inst)
            return false


        # Task completion records retain a pointer to their ThreadPool, and a lexical pool
        # shuts down its ThreadPool on scope exit. Pool-scope escape checks therefore cover
        # Task, TaskGroup, and ThreadPool handles, including values nested in aggregates.
        # Cycles are memoized by (kind,bits); a recursive edge is safe to skip because its
        # first visit still scans every field. Unknown/malformed metadata fails closed, and a
        # depth cap prevents malformed recursive layouts from unbounded work.
        def backend_type_may_contain_pool_lifetime_handle_inner(value_type: ValueType, structs: StructTable&, visited: mutable BackendTypeVisitSet&, depth: usize) -> bool can[Abort.Panic, Memory.Allocate]:
            return true if depth > 128.usize() or value_type.kind == TypeKind.Unmodeled
            return false if value_type.kind == TypeKind.Void or value_type.kind == TypeKind.Signed or value_type.kind == TypeKind.Unsigned or value_type.kind == TypeKind.Bool or value_type.kind == TypeKind.Float or value_type.kind == TypeKind.CStr or value_type.kind == TypeKind.SView or value_type.kind == TypeKind.ConstUsize
            # A function value may be a closure whose environment captured a Task. The current
            # ValueType does not distinguish raw function pointers from closure values, so do not
            # allow one to cross a lexical pool boundary without richer capture provenance.
            return true if:
                value_type.kind == TypeKind.Fn
                # `py::Object` is an opaque pointer and integer/pointer casts can erase its source
                # type. It may therefore be a Task completion handle reinterpreted through the
                # Python boundary; treat it as unknown at pool-lifetime boundaries.
                value_type.kind == TypeKind.PyObject

            if value_type.kind == TypeKind.Struct:
                return true if value_type.bits.usize() >= structs.records.names.count or value_type.bits.usize() >= structs.records.owners.count
                # TaskGroup's opaque linked list owns raw completion handles. Its fields
                # are void pointers, so the structural walk below cannot discover that
                # waiting on the group after its pool shuts down dereferences stale pools.
                return true if:
                    structs.records.names[value_type.bits.usize()] == "TaskGroup" and structs.records.owners[value_type.bits.usize()] == ""
                    structs.records.names[value_type.bits.usize()] == "Task" and structs.records.owners[value_type.bits.usize()] == ""
                    structs.records.names[value_type.bits.usize()] == "ThreadPool" and structs.records.owners[value_type.bits.usize()] == ""
                # Source generic instantiations have distinct concrete Struct rows with
                # substituted field types. Scanning every type argument would mistake
                # phantom parameters (for example MutexGuard[Task]) for stored handles.
                # The synthesized DynDict layout is the exception: its opaque bucket pointer
                # hides K and V, so its recorded arguments are the only payload type facts.

            # Each first visit scans every child before its caller completes. A repeated
            # edge can therefore be skipped even when it points to an active ancestor:
            # that ancestor resumes and scans its remaining siblings. Exact pair comparison
            # avoids collisions between large `bits` values; malformed metadata and the depth
            # cap below still fail closed.
            return false if backend_type_visit_seen_or_insert(visited, value_type)

            match value_type.kind:
                TypeKind.Optional:
                    return true if value_type.bits.usize() >= structs.interned_types.optional_targets.count
                    return backend_type_may_contain_pool_lifetime_handle_inner(structs.interned_types.optional_targets[value_type.bits.usize()], structs, visited, depth + 1.usize())
                TypeKind.ErrorUnion:
                    return true if value_type.bits.usize() >= structs.interned_types.error_union_values.count
                    return backend_type_may_contain_pool_lifetime_handle_inner(structs.interned_types.error_union_values[value_type.bits.usize()], structs, visited, depth + 1.usize())
                TypeKind.Array:
                    return true if value_type.bits.usize() >= structs.interned_types.array_elements.count
                    return backend_type_may_contain_pool_lifetime_handle_inner(structs.interned_types.array_elements[value_type.bits.usize()], structs, visited, depth + 1.usize())
                TypeKind.DArray:
                    return true if value_type.bits.usize() >= structs.interned_types.darray_elements.count
                    return backend_type_may_contain_pool_lifetime_handle_inner(structs.interned_types.darray_elements[value_type.bits.usize()], structs, visited, depth + 1.usize())
                TypeKind.View:
                    return true if value_type.bits.usize() >= structs.interned_types.view_elements.count
                    return backend_type_may_contain_pool_lifetime_handle_inner(structs.interned_types.view_elements[value_type.bits.usize()], structs, visited, depth + 1.usize())
                TypeKind.Ref:
                    return true if value_type.bits.usize() >= structs.interned_types.ref_targets.count
                    return backend_type_may_contain_pool_lifetime_handle_inner(structs.interned_types.ref_targets[value_type.bits.usize()], structs, visited, depth + 1.usize())
                TypeKind.PackedStore:
                    return backend_type_may_contain_pool_lifetime_handle_inner(ValueType{kind: TypeKind.PackedEnum, bits: value_type.bits}, structs, visited, depth + 1.usize())
                TypeKind.Struct:
                    struct_index: usize = value_type.bits.usize()
                    return true if struct_index >= structs.records.field_start.count or struct_index >= structs.records.field_count.count
                    field_start: usize = structs.records.field_start[struct_index]
                    field_count: usize = structs.records.field_count[struct_index]
                    return true if field_start > structs.records.field_types.count or field_count > structs.records.field_types.count - field_start
                    contains_pool_handle: mutable bool = false
                    inst: mutable usize = generic_inst_first_row(structs, struct_index)
                    while inst < structs.generics.generic_struct_inst_index.count |inst, structs, struct_index|:
                        if structs.generics.generic_struct_inst_index[inst] == struct_index:
                            return true if:
                                structs.generics.generic_struct_inst_index.count != structs.generics.generic_struct_inst_bases.count or structs.generics.generic_struct_inst_index.count != structs.generics.generic_struct_inst_template_ids.count or structs.generics.generic_struct_inst_index.count != structs.generics.generic_struct_inst_arg_start.count or structs.generics.generic_struct_inst_index.count != structs.generics.generic_struct_inst_arg_count.count or structs.generics.generic_struct_inst_index.count != structs.generics.generic_struct_inst_ready.count
                                inst >= structs.generics.generic_struct_inst_ready.count or not structs.generics.generic_struct_inst_ready[inst]
                                inst >= structs.generics.generic_struct_inst_arg_start.count or inst >= structs.generics.generic_struct_inst_arg_count.count
                            arg_start: usize = structs.generics.generic_struct_inst_arg_start[inst]
                            arg_count: usize = structs.generics.generic_struct_inst_arg_count[inst]
                            return true if arg_start > structs.generics.generic_struct_inst_args.count or arg_count > structs.generics.generic_struct_inst_args.count - arg_start
                            # Only the synthesized DynDict representation erases its K/V
                            # payload behind an opaque bucket pointer. It gets a template id
                            # of zero; source generic layouts are covered by field types.
                            if structs.generics.generic_struct_inst_bases[inst] == "DynDict" and structs.generics.generic_struct_inst_template_ids[inst] == 0:
                                for arg_offset in 0..<arg_count |contains_pool_handle, structs, visited, depth, arg_start|:
                                    contains_pool_handle <- true if backend_type_may_contain_pool_lifetime_handle_inner(structs.generics.generic_struct_inst_args[arg_start + arg_offset], structs, visited, depth + 1.usize())
                            break
                        inst <- generic_inst_next_row(structs, inst)
                    for field_offset in 0..<field_count |contains_pool_handle, structs, visited, depth, field_start|:
                        contains_pool_handle <- true if backend_type_may_contain_pool_lifetime_handle_inner(structs.records.field_types[field_start + field_offset], structs, visited, depth + 1.usize())
                    return contains_pool_handle
                TypeKind.PayloadEnum:
                    enum_index: usize = value_type.bits.usize()
                    return true if enum_index >= structs.payload_enums.penum_names.count or enum_index >= structs.payload_enums.penum_owners.count or enum_index >= structs.payload_enums.penum_variant_start.count or enum_index >= structs.payload_enums.penum_variant_count.count
                    variant_start: usize = structs.payload_enums.penum_variant_start[enum_index]
                    variant_count: usize = structs.payload_enums.penum_variant_count[enum_index]
                    return true if:
                        structs.payload_enums.penum_has_payload.count != structs.payload_enums.penum_payloads.count or structs.payload_enums.penum_payloads.count != structs.payload_enums.penum_variants.count or structs.payload_enums.penum_variants.count != structs.payload_enums.penum_variant_owners.count or structs.payload_enums.penum_variants.count != structs.payload_enums.penum_variant_modules.count or structs.payload_enums.penum_field_names.count != structs.payload_enums.penum_variants.count or structs.payload_enums.penum_field_type_start.count != structs.payload_enums.penum_field_type_count.count
                        variant_start > structs.payload_enums.penum_payloads.count or variant_count > structs.payload_enums.penum_payloads.count - variant_start
                        variant_start > structs.payload_enums.penum_field_type_start.count or variant_count > structs.payload_enums.penum_field_type_start.count - variant_start
                    contains_pool_handle: mutable bool = false
                    for variant_offset in 0..<variant_count |contains_pool_handle, structs, visited, depth, variant_start|:
                        variant_row: usize = variant_start + variant_offset
                        if variant_row < structs.payload_enums.penum_has_payload.count and structs.payload_enums.penum_has_payload[variant_row]:
                            contains_pool_handle <- true if backend_type_may_contain_pool_lifetime_handle_inner(structs.payload_enums.penum_payloads[variant_row], structs, visited, depth + 1.usize())
                        field_start: usize = structs.payload_enums.penum_field_type_start[variant_row]
                        field_count: usize = structs.payload_enums.penum_field_type_count[variant_row]
                        return true if field_start > structs.payload_enums.penum_field_types.count or field_count > structs.payload_enums.penum_field_types.count - field_start
                        for field_offset in 0..<field_count |contains_pool_handle, structs, visited, depth, field_start|:
                            contains_pool_handle <- true if backend_type_may_contain_pool_lifetime_handle_inner(structs.payload_enums.penum_field_types[field_start + field_offset], structs, visited, depth + 1.usize())
                    return contains_pool_handle
                TypeKind.PackedEnum:
                    enum_index: usize = value_type.bits.usize()
                    return true if enum_index >= structs.packed_enums.packed_names.count or enum_index >= structs.packed_enums.packed_owners.count or enum_index >= structs.packed_enums.packed_variant_start.count or enum_index >= structs.packed_enums.packed_variant_count.count or enum_index >= structs.packed_enums.packed_common_counts.count
                    variant_start: usize = structs.packed_enums.packed_variant_start[enum_index]
                    variant_count: usize = structs.packed_enums.packed_variant_count[enum_index]
                    return true if:
                        structs.packed_enums.packed_has_payload.count != structs.packed_enums.packed_payloads.count or structs.packed_enums.packed_payloads.count != structs.packed_enums.packed_variants.count or structs.packed_enums.packed_field_names.count != structs.packed_enums.packed_variants.count or structs.packed_enums.packed_field_type_start.count != structs.packed_enums.packed_field_type_count.count
                        variant_start > structs.packed_enums.packed_payloads.count or variant_count > structs.packed_enums.packed_payloads.count - variant_start
                        variant_start > structs.packed_enums.packed_field_type_start.count or variant_count > structs.packed_enums.packed_field_type_start.count - variant_start
                    contains_pool_handle: mutable bool = false
                    for variant_offset in 0..<variant_count |contains_pool_handle, structs, visited, depth, variant_start|:
                        variant_row: usize = variant_start + variant_offset
                        if variant_row < structs.packed_enums.packed_has_payload.count and structs.packed_enums.packed_has_payload[variant_row]:
                            contains_pool_handle <- true if backend_type_may_contain_pool_lifetime_handle_inner(structs.packed_enums.packed_payloads[variant_row], structs, visited, depth + 1.usize())
                        field_start: usize = structs.packed_enums.packed_field_type_start[variant_row]
                        field_count: usize = structs.packed_enums.packed_field_type_count[variant_row]
                        return true if field_start > structs.packed_enums.packed_field_types.count or field_count > structs.packed_enums.packed_field_types.count - field_start
                        for field_offset in 0..<field_count |contains_pool_handle, structs, visited, depth, field_start|:
                            contains_pool_handle <- true if backend_type_may_contain_pool_lifetime_handle_inner(structs.packed_enums.packed_field_types[field_start + field_offset], structs, visited, depth + 1.usize())
                    return true if structs.packed_enums.packed_common_owners.count != structs.packed_enums.packed_common_modules.count or structs.packed_enums.packed_common_owners.count != structs.packed_enums.packed_common_names.count or structs.packed_enums.packed_common_owners.count != structs.packed_enums.packed_common_types.count
                    common_fields: mutable usize = 0
                    for common_index in 0..<structs.packed_enums.packed_common_types.count |contains_pool_handle, common_fields, structs, visited, depth, enum_index|:
                        if structs.packed_enums.packed_common_owners[common_index] == structs.packed_enums.packed_names[enum_index] and structs.packed_enums.packed_common_modules[common_index] == structs.packed_enums.packed_owners[enum_index]:
                            common_fields <- common_fields + 1.usize()
                            contains_pool_handle <- true if backend_type_may_contain_pool_lifetime_handle_inner(structs.packed_enums.packed_common_types[common_index], structs, visited, depth + 1.usize())
                    return true if common_fields != structs.packed_enums.packed_common_counts[enum_index].usize()
                    return contains_pool_handle
                _:
                    return false


        def backend_type_may_contain_pool_lifetime_handle(value_type: ValueType, structs: StructTable&) -> bool can[Abort.Panic, Memory.Allocate]:
            visited: mutable BackendTypeVisitSet = BackendTypeVisitSet{keys: [], buckets: [], hashed: false}
            return backend_type_may_contain_pool_lifetime_handle_inner(value_type, structs, visited, 0.usize())


        # Raw projections erase their source record type. Treat pointer-sized scalars as
        # possible handle representations only when the IR type is explicitly pointer-like.
        # `usize` is also pointer-sized but is commonly an ordinary numeric result, so its
        # provenance must come from the source expression or submit argument instead.
        def backend_type_is_raw_pool_handle_representation(value_type: ValueType, structs: StructTable&) -> bool can[Abort.Panic]:
            return true if value_type.kind == TypeKind.Ref or value_type.kind == TypeKind.CStr or value_type.kind == TypeKind.GuestCarrier
            if value_type.kind == TypeKind.Optional:
                return backend_type_is_raw_pool_handle_representation(optional_payload_of(value_type, structs), structs)
            return false
