        def backend_type_may_contain_erased_pool_handle_slot(value_type: ValueType, structs: StructTable&) -> bool can[Abort.Panic, Memory.Allocate]:
            true return if value_type.kind == TypeKind.Unmodeled or value_type.kind == TypeKind.Fn or value_type.kind == TypeKind.PyObject
            if value_type.kind == TypeKind.Signed or value_type.kind == TypeKind.Unsigned:
                return value_type.bits == structs.target.target_pointer_bits
            return true if backend_type_is_raw_pool_handle_representation(value_type, structs)
            return false if value_type.kind != TypeKind.Struct and value_type.kind != TypeKind.PayloadEnum and value_type.kind != TypeKind.PackedEnum and value_type.kind != TypeKind.PackedStore and value_type.kind != TypeKind.Array and value_type.kind != TypeKind.Optional and value_type.kind != TypeKind.ErrorUnion and value_type.kind != TypeKind.DArray and value_type.kind != TypeKind.View
            visited: mutable BackendTypeVisitSet = BackendTypeVisitSet{keys: [], buckets: [], hashed: false}
            return backend_type_may_contain_erased_pool_handle_slot_inner(value_type, structs, visited, 0.usize())


        # The expression walker handles pool-derived projections and compound values before
        # this fallback. A local scalar binding has already passed its declaration, assignment,
        # and call-argument guards; unresolved nonlocal identifiers still fail closed.
        def backend_expression_may_be_unresolved_pool_handle_source(expression: Expr, value_type: ValueType, local_scope: mutable Scope&, structs: StructTable&) -> bool can[Abort.Panic]:
            pointer_word: bool = (value_type.kind == TypeKind.Signed or value_type.kind == TypeKind.Unsigned) and value_type.bits == structs.target.target_pointer_bits
            return false if not backend_type_is_raw_pool_handle_representation(value_type, structs) and not pointer_word
            match expression:
                Expr.Invalid | Expr.Absent | Expr.IntLit(_, _) | Expr.FloatLit(_, _) | Expr.StringLit(_, _) | Expr.CharLit(_, _) | Expr.BoolLit(_, _):
                    return false
                Expr.Ident(source_name, _):
                    folded_ok: mutable bool = true
                    _folded_value: i64 = fold_const_expr(expression, structs, folded_ok)
                    return false if folded_ok or lookup_index(local_scope, source_name) >= 0
                    return true
                # The provenance walker already inspected these expressions. Preserve its
                # result instead of treating every dynamic pointer-width value as a handle.
                Expr.Call(_, _, _, _) | Expr.Field(_, _, _) | Expr.Unary(_, _, _) | Expr.Binary(_, _, _, _) | Expr.Index(_, _, _) | Expr.IndexN(_, _, _) | Expr.Slice(_, _, _, _) | Expr.Paren(_, _) | Expr.Move(_, _) | Expr.RegionNew(_, _, _) | Expr.Block(_, _, _, _) | Expr.If(_, _, _, _) | Expr.Match(_, _, _) | Expr.Catch(_, _, _) | Expr.Array(_, _) | Expr.Tuple(_, _) | Expr.SetLit(_, _) | Expr.DictLit(_, _) | Expr.Construct(_, _, _) | Expr.RecordUpdate(_, _, _) | Expr.Refinement(_, _, _) | Expr.GetElse(_, _, _) | Expr.Comprehension(_, _, _, _, _) | Expr.StaticEffectCall(_, _, _, _, _, _) | Expr.Lambda(_, _, _) | Expr.ShorthandMember(_, _):
                    return false
                _:
                    pass
            folded_ok: mutable bool = true
            _folded_value: i64 = fold_const_expr(expression, structs, folded_ok)
            return not folded_ok


        # Resolve the source expression that supplies one field of a direct struct
        # construction. This keeps projection provenance narrow: a handle in a sibling
        # initializer does not taint a different selected field. Missing fields use their
        # declared default when present; otherwise the constructor's zero initialization
        # cannot introduce a pool handle.
        def backend_aggregate_field_source(expression: Expr, field_name: sview, structs: mutable StructTable&, found: mutable bool&, depth: usize) -> Expr can[Abort.Panic, Memory.Allocate]:
            found <- false
            if depth > 128.usize():
                found <- true
                return Expr.Invalid
            match expression:
                Expr.Construct(construct_type, construct_fields, construct_pos):
                    field_registry_type: mutable ValueType = annotation_value_type(construct_type, structs)
                    field_registry_type <- arena_user_struct(structs) if field_registry_type.kind == TypeKind.Arena
                    return Expr.Invalid if field_registry_type.kind != TypeKind.Struct
                    struct_slot: usize = field_registry_type.bits.usize()
                    if struct_slot >= structs.records.names.count or struct_slot >= structs.records.owners.count or struct_slot >= structs.records.field_start.count or struct_slot >= structs.records.field_count.count:
                        found <- true
                        return Expr.Invalid
                    struct_field_start: usize = structs.records.field_start[struct_slot]
                    struct_field_count: usize = structs.records.field_count[struct_slot]
                    if struct_field_start > structs.records.field_names.count or struct_field_count > structs.records.field_names.count - struct_field_start:
                        found <- true
                        return Expr.Invalid
                    field_position: i64 = field_index_of(structs, struct_slot, field_name)
                    return Expr.Invalid if field_position < 0
                    selected: mutable Expr = Expr.Invalid
                    construction_order: mutable u32 = 0
                    for field_init in construct_fields |found, selected, construction_order, field_position, structs, struct_slot|:
                        supplied_position: mutable i64 = field_index_of(structs, struct_slot, field_init.name)
                        supplied_position <- construction_order.i64() if field_init.name == ""
                        construction_order <- construction_order + 1
                        if supplied_position == field_position:
                            selected <- field_init.value
                            found <- true
                    return selected if found
                    default_owner: sview = structs.records.owners[struct_slot]
                    default_row: i64 = field_default_row(structs, default_owner, structs.records.names[struct_slot], field_name)
                    if default_row >= 0 and default_row.usize() < structs.records.field_default_values.count:
                        found <- true
                        return structs.records.field_default_values[default_row.usize()]
                    found <- true
                    return Expr.IntLit(0, construct_pos)
                Expr.RecordUpdate(record_base, record_fields, _):
                    selected_override_found: mutable bool = false
                    selected_override: mutable Expr = Expr.Invalid
                    for override in record_fields |selected_override_found, selected_override, field_name|:
                        if override.name == field_name:
                            selected_override <- override.value
                            selected_override_found <- true
                    if selected_override_found:
                        found <- true
                        return selected_override
                    return backend_aggregate_field_source(record_base, field_name, structs, found, depth + 1.usize())
                Expr.Field(nested_base, nested_field, _):
                    nested_source_found: mutable bool = false
                    nested_source: Expr = backend_aggregate_field_source(nested_base, nested_field, structs, nested_source_found, depth + 1.usize())
                    return Expr.Invalid if not nested_source_found
                    if nested_source is Expr.Invalid:
                        found <- true
                        return Expr.Invalid
                    return backend_aggregate_field_source(nested_source, field_name, structs, found, depth + 1.usize())
                Expr.Paren(inner, _) | Expr.Move(inner, _):
                    return backend_aggregate_field_source(inner, field_name, structs, found, depth + 1.usize())
                Expr.Block(block_statements, block_value, _, _):
                    block_source_found: mutable bool = false
                    block_source: Expr = block_value
                    if block_value is Expr.Ident(block_value_name, _):
                        block_declared: mutable bool = false
                        block_decl_row: mutable usize = 0
                        block_source <- Expr.Invalid
                        for block_statement_index in 0..<block_statements.count |block_declared, block_decl_row, block_source, block_value_name, block_statements|:
                            match block_statements[block_statement_index]:
                                Stmt.VarDecl(block_decl_name, _, block_decl_value, _):
                                    if block_decl_name == block_value_name:
                                        block_declared <- true
                                        block_decl_row <- block_statement_index
                                        block_source <- block_decl_value
                                _:
                                    pass
                        block_value return if not block_declared
                        block_binding_names: SubmitGroupNameSet = SubmitGroupNameSet{first: block_value_name, second: "", third: "", fail_closed_nested_scopes: true}
                        for block_after_decl in block_decl_row + 1..<block_statements.count |block_binding_names, block_statements|:
                            if submit_group_statement_mentions_names(block_statements[block_after_decl], block_binding_names, true):
                                found <- true
                                return Expr.Invalid
                        found <- true
                        return Expr.Invalid if block_source is Expr.Invalid
                        block_selected_found: mutable bool = false
                        block_selected: Expr = backend_aggregate_field_source(block_source, field_name, structs, block_selected_found, depth + 1.usize())
                        if not block_selected_found:
                            found <- true
                            return Expr.Invalid
                        found <- true
                        return block_selected
                    if block_value is not Expr.Ident(_, _):
                        block_source <- backend_aggregate_field_source(block_value, field_name, structs, block_source_found, depth + 1.usize())
                        found <- block_source_found
                        return block_source
                    return Expr.Invalid
                Expr.Call(enum_ctor_callee, enum_ctor_arguments, enum_ctor_argument_names, enum_ctor_pos):
                    if enum_ctor_callee is Expr.Field(enum_ctor_head, enum_ctor_variant, _):
                        enum_ctor_index: i64 = penum_index_of_head(structs, enum_ctor_head)
                        if enum_ctor_index >= 0 and enum_ctor_index.usize() < structs.payload_enums.penum_variant_start.count and enum_ctor_index.usize() < structs.payload_enums.penum_variant_count.count and enum_ctor_index.usize() < structs.payload_enums.penum_names.count:
                            enum_ctor_variant_start: usize = structs.payload_enums.penum_variant_start[enum_ctor_index.usize()]
                            enum_ctor_variant_count: usize = structs.payload_enums.penum_variant_count[enum_ctor_index.usize()]
                            if enum_ctor_variant_start > structs.payload_enums.penum_variants.count or enum_ctor_variant_count > structs.payload_enums.penum_variants.count - enum_ctor_variant_start or enum_ctor_variant_start > structs.payload_enums.penum_variant_owners.count or enum_ctor_variant_count > structs.payload_enums.penum_variant_owners.count - enum_ctor_variant_start:
                                found <- true
                                return Expr.Invalid
                            enum_ctor_variant_offset: i64 = penum_variant_index_owned(structs, enum_ctor_index, packed_constructor_enum_name(enum_ctor_head), enum_ctor_variant)
                            if enum_ctor_variant_offset >= 0 and enum_ctor_variant_offset < enum_ctor_variant_count.i64():
                                if enum_ctor_variant_start > structs.payload_enums.penum_variants.count or enum_ctor_variant_count > structs.payload_enums.penum_variants.count - enum_ctor_variant_start or enum_ctor_variant_start > structs.payload_enums.penum_field_type_start.count or enum_ctor_variant_count > structs.payload_enums.penum_field_type_start.count - enum_ctor_variant_start or enum_ctor_variant_start > structs.payload_enums.penum_field_type_count.count or enum_ctor_variant_count > structs.payload_enums.penum_field_type_count.count - enum_ctor_variant_start:
                                    found <- true
                                    return Expr.Invalid
                                enum_projection_offset: mutable usize = 0
                                enum_projection_matches: mutable usize = 0
                                for enum_projection_variant in 0..<enum_ctor_variant_count |enum_projection_offset, enum_projection_matches, enum_ctor_variant_start, field_name, structs|:
                                    enum_projection_slot: usize = enum_ctor_variant_start + enum_projection_variant
                                    enum_projection_start: usize = structs.payload_enums.penum_field_type_start[enum_projection_slot]
                                    enum_projection_count: usize = structs.payload_enums.penum_field_type_count[enum_projection_slot]
                                    if enum_projection_start > structs.payload_enums.penum_field_flat_names.count or enum_projection_count > structs.payload_enums.penum_field_flat_names.count - enum_projection_start or enum_projection_start > structs.payload_enums.penum_field_types.count or enum_projection_count > structs.payload_enums.penum_field_types.count - enum_projection_start:
                                        found <- true
                                        return Expr.Invalid
                                    for enum_projection_field in 0..<enum_projection_count |enum_projection_offset, enum_projection_matches, enum_projection_start, enum_projection_slot, enum_projection_variant, field_name, structs|:
                                        if structs.payload_enums.penum_field_flat_names[enum_projection_start + enum_projection_field] == field_name:
                                            enum_projection_offset <- enum_projection_field
                                            enum_projection_matches <- enum_projection_matches + 1
                                if enum_projection_matches == 1:
                                    enum_ctor_slot: usize = enum_ctor_variant_start + enum_ctor_variant_offset.usize()
                                    enum_ctor_field_start: usize = structs.payload_enums.penum_field_type_start[enum_ctor_slot]
                                    enum_ctor_field_count: usize = structs.payload_enums.penum_field_type_count[enum_ctor_slot]
                                    if enum_ctor_field_start > structs.payload_enums.penum_field_flat_names.count or enum_ctor_field_count > structs.payload_enums.penum_field_flat_names.count - enum_ctor_field_start or enum_ctor_field_start > structs.payload_enums.penum_field_types.count or enum_ctor_field_count > structs.payload_enums.penum_field_types.count - enum_ctor_field_start:
                                        found <- true
                                        return Expr.Invalid
                                    # The field reader currently loads the unique declaring
                                    # variant's offset without checking the runtime tag. Another
                                    # constructor can therefore expose overlapping payload bytes;
                                    # only trace a constructor when it declares this exact field.
                                    if enum_projection_offset >= enum_ctor_field_count or structs.payload_enums.penum_field_flat_names[enum_ctor_field_start + enum_projection_offset] != field_name:
                                        found <- true
                                        return Expr.Invalid
                                    if enum_ctor_arguments.count != enum_ctor_field_count or (enum_ctor_argument_names.count != 0 and enum_ctor_argument_names.count != enum_ctor_arguments.count):
                                        found <- true
                                        return Expr.Invalid
                                    enum_ctor_source_index: i64 = named_argument_index(enum_ctor_argument_names, structs.payload_enums.penum_field_flat_names, enum_ctor_field_start, enum_ctor_field_count, 0.usize(), enum_projection_offset)
                                    if enum_ctor_source_index < 0 or enum_ctor_source_index.usize() >= enum_ctor_arguments.count:
                                        found <- true
                                        return Expr.Invalid
                                    found <- true
                                    return enum_ctor_arguments[enum_ctor_source_index.usize()]
                Expr.If(_, _, _, _) | Expr.Match(_, _, _) | Expr.Catch(_, _, _):
                    # A projection from a multi-branch expression has multiple possible
                    # sources; the field-sensitive caller walks each yielded branch.
                    pass
                _:
                    pass
            return Expr.Invalid


        # The builtin concurrency records store their state in raw integer/pointer fields.
        # Those fields lose the Task/ThreadPool/TaskGroup type as soon as a projection is
        # made, so the structural ValueType walk above cannot see a lifetime-bearing value
        # such as `workers.handle`. Keep provenance at the expression boundary for direct
        # projections and value-preserving syntax. Locals and aggregate initializers are
        # checked before they can store such a projection, so this bounded walk does not need
        # a second alias table in Scope.
        def backend_expression_projects_pool_lifetime_handle(expression: Expr, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, depth: usize) -> bool can[Abort.Panic, Memory.Allocate]:
            true return if depth > 128.usize()
            match expression:
                Expr.Field(field_object, field_name, _):
                    projection_type: ValueType = expression_type(expression, local_scope, fns, structs, generics)
                    projection_is_raw_pointer: bool = backend_type_is_raw_pool_handle_representation(projection_type, structs)
                    projection_may_be_hidden_handle: bool = projection_is_raw_pointer or ((projection_type.kind == TypeKind.Signed or projection_type.kind == TypeKind.Unsigned) and projection_type.bits == structs.target.target_pointer_bits)
                    field_object_type: mutable ValueType = expression_type(field_object, local_scope, fns, structs, generics)
                    wrapper_depth: mutable usize = 0
                    while (field_object_type.kind == TypeKind.Ref or field_object_type.kind == TypeKind.Optional) and wrapper_depth < 16.usize() |field_object_type, wrapper_depth, structs|:
                        if field_object_type.kind == TypeKind.Ref:
                            field_object_type <- ref_target_of(field_object_type, structs)
                        else:
                            field_object_type <- optional_payload_of(field_object_type, structs)
                        wrapper_depth <- wrapper_depth + 1.usize()
                    true return if field_object_type.kind == TypeKind.Ref or field_object_type.kind == TypeKind.Optional
                    if field_object_type.kind == TypeKind.Struct:
                        field_struct: usize = field_object_type.bits.usize()
                        if field_struct < structs.records.names.count and field_struct < structs.records.owners.count and structs.records.owners[field_struct] == "":
                            field_struct_name: sview = structs.records.names[field_struct]
                            return true if field_struct_name == "Task" and (field_name == "handle" or field_name == "state")
                            return true if field_struct_name == "ThreadPool" and field_name == "handle"
                            return true if field_struct_name == "TaskGroup" and (field_name == "handle" or field_name == "cleanup")
                    match field_object:
                        Expr.If(_, if_then_value, if_else_value, if_pos):
                            return backend_expression_projects_pool_lifetime_handle(Expr.Field(if_then_value, field_name, if_pos), local_scope, fns, structs, generics, depth + 1.usize()) or backend_expression_projects_pool_lifetime_handle(Expr.Field(if_else_value, field_name, if_pos), local_scope, fns, structs, generics, depth + 1.usize())
                        Expr.Block(_, block_value, _, block_pos):
                            block_source_found: mutable bool = false
                            block_source: Expr = backend_aggregate_field_source(field_object, field_name, structs, block_source_found, depth + 1.usize())
                            if block_source_found:
                                return projection_may_be_hidden_handle if block_source is Expr.Invalid
                                return backend_expression_projects_pool_lifetime_handle(block_source, local_scope, fns, structs, generics, depth + 1.usize())
                            block_projection: Expr = Expr.Field(block_value, field_name, block_pos)
                            return backend_expression_projects_pool_lifetime_handle(block_projection, local_scope, fns, structs, generics, depth + 1.usize())
                        Expr.Match(_, projection_arms, projection_pos) | Expr.Catch(_, projection_arms, projection_pos):
                            projection_saw_unresolved: mutable bool = false
                            projection_saw_yield: mutable bool = false
                            for projection_arm in projection_arms |projection_saw_unresolved, projection_saw_yield, field_name, projection_pos, local_scope, fns, structs, generics, depth|:
                                continue if projection_arm.body.count == 0
                                projection_last: Stmt = projection_arm.body[projection_arm.body.count - 1]
                                if projection_last is Stmt.Expr(projection_yield, _):
                                    projection_saw_yield <- true
                                    projection_source_found: mutable bool = false
                                    projection_source: Expr = backend_aggregate_field_source(projection_yield, field_name, structs, projection_source_found, depth + 1.usize())
                                    if projection_source_found:
                                        return projection_may_be_hidden_handle if projection_source is Expr.Invalid
                                        projection_source_type: ValueType = expression_type(projection_source, local_scope, fns, structs, generics)
                                        return true if projection_is_raw_pointer and (projection_source_type.kind == TypeKind.Struct or projection_source_type.kind == TypeKind.PayloadEnum or projection_source_type.kind == TypeKind.Array)
                                        return true if backend_expression_projects_pool_lifetime_handle(projection_source, local_scope, fns, structs, generics, depth + 1.usize())
                                        return true if backend_expression_may_be_unresolved_pool_handle_source(projection_source, projection_source_type, local_scope, structs)
                                        continue
                                    branch_projection: Expr = Expr.Field(projection_yield, field_name, projection_pos)
                                    if backend_expression_projects_pool_lifetime_handle(branch_projection, local_scope, fns, structs, generics, depth + 1.usize()):
                                        return true
                                    projection_saw_unresolved <- true if projection_may_be_hidden_handle
                            return projection_may_be_hidden_handle if projection_saw_unresolved or not projection_saw_yield
                            return false
                        _:
                            pass
                    selected_field_source_found: mutable bool = false
                    selected_field_source: Expr = backend_aggregate_field_source(field_object, field_name, structs, selected_field_source_found, depth)
                    if selected_field_source_found:
                        return projection_may_be_hidden_handle if selected_field_source is Expr.Invalid
                        selected_source_type: ValueType = expression_type(selected_field_source, local_scope, fns, structs, generics)
                        return true if projection_may_be_hidden_handle and (selected_source_type.kind == TypeKind.Struct or selected_source_type.kind == TypeKind.PayloadEnum or selected_source_type.kind == TypeKind.Array)
                        return backend_expression_projects_pool_lifetime_handle(selected_field_source, local_scope, fns, structs, generics, depth + 1.usize())
                        return backend_expression_may_be_unresolved_pool_handle_source(selected_field_source, selected_source_type, local_scope, structs)
                    projection_has_aggregate_storage: bool = projection_type.kind == TypeKind.Struct or projection_type.kind == TypeKind.PayloadEnum or projection_type.kind == TypeKind.PackedEnum or projection_type.kind == TypeKind.PackedStore or projection_type.kind == TypeKind.Array or projection_type.kind == TypeKind.Optional or projection_type.kind == TypeKind.ErrorUnion or projection_type.kind == TypeKind.DArray or projection_type.kind == TypeKind.View
                    if projection_has_aggregate_storage and backend_type_may_contain_erased_pool_handle_slot(projection_type, structs):
                        return true if backend_expression_projects_pool_lifetime_handle(field_object, local_scope, fns, structs, generics, depth + 1.usize())
                    if field_object is Expr.Ident(local_aggregate_name, _) and lookup_index(local_scope, local_aggregate_name) >= 0:
                        # Local aggregate stores and updates have already passed the pool
                        # lifetime guards; reading a raw-width data field does not create a
                        # handle or need to re-taint the whole record.
                        return false
                    return true if projection_may_be_hidden_handle and (field_object_type.kind == TypeKind.PayloadEnum or field_object_type.kind == TypeKind.Struct)
                    return false
                Expr.Paren(inner, _):
                    return backend_expression_projects_pool_lifetime_handle(inner, local_scope, fns, structs, generics, depth + 1.usize())
                Expr.Move(inner, _):
                    return backend_expression_projects_pool_lifetime_handle(inner, local_scope, fns, structs, generics, depth + 1.usize())
                Expr.RegionNew(inner, _, _):
                    return backend_expression_projects_pool_lifetime_handle(inner, local_scope, fns, structs, generics, depth + 1.usize())
                Expr.Unary(operator, operand, _):
                    return false if operator == TokenKind.Not
                    return backend_expression_projects_pool_lifetime_handle(operand, local_scope, fns, structs, generics, depth + 1.usize())
                Expr.Binary(left, operator, right, _):
                    # Predicates cannot carry the raw handle value, even when one of their
                    # operands is a handle projection.
                    return false if operator == TokenKind.EqEq or operator == TokenKind.BangEq or operator == TokenKind.Lt or operator == TokenKind.Gt or operator == TokenKind.LtEq or operator == TokenKind.GtEq or operator == TokenKind.And or operator == TokenKind.Or or operator == TokenKind.In or operator == TokenKind.Is
                    return backend_expression_projects_pool_lifetime_handle(left, local_scope, fns, structs, generics, depth + 1.usize()) or backend_expression_projects_pool_lifetime_handle(right, local_scope, fns, structs, generics, depth + 1.usize())
                Expr.Index(object, index_expression, _):
                    if object is Expr.Field(cast_source, cast_method, _) and cast_method == "cast":
                        return backend_expression_projects_pool_lifetime_handle(cast_source, local_scope, fns, structs, generics, depth + 1.usize())
                    if object is Expr.Array(array_elements, _):
                        folded_ok: mutable bool = true
                        folded_position: i64 = fold_const_expr(index_expression, structs, folded_ok)
                        if folded_ok and folded_position >= 0:
                            has_spread: mutable bool = false
                            for element in array_elements |has_spread|:
                                if element is Expr.Unary(spread_operator, _, _) and spread_operator == TokenKind.Ellipsis:
                                    has_spread <- true
                            if not has_spread:
                                return false if folded_position.usize() >= array_elements.count
                                return backend_expression_projects_pool_lifetime_handle(array_elements[folded_position.usize()], local_scope, fns, structs, generics, depth + 1.usize())
                    return backend_expression_projects_pool_lifetime_handle(object, local_scope, fns, structs, generics, depth + 1.usize())
                Expr.IndexN(object, _, _):
                    if object is Expr.Field(cast_source, cast_method, _) and cast_method == "cast":
                        return backend_expression_projects_pool_lifetime_handle(cast_source, local_scope, fns, structs, generics, depth + 1.usize())
                    return backend_expression_projects_pool_lifetime_handle(object, local_scope, fns, structs, generics, depth + 1.usize())
                Expr.Slice(object, _, _, _):
                    return backend_expression_projects_pool_lifetime_handle(object, local_scope, fns, structs, generics, depth + 1.usize())
                Expr.Block(_, value, _, _):
                    return backend_expression_projects_pool_lifetime_handle(value, local_scope, fns, structs, generics, depth + 1.usize())
                Expr.If(_, then_value, else_value, _):
                    return backend_expression_projects_pool_lifetime_handle(then_value, local_scope, fns, structs, generics, depth + 1.usize()) or backend_expression_projects_pool_lifetime_handle(else_value, local_scope, fns, structs, generics, depth + 1.usize())
                Expr.Array(elements, _) | Expr.Tuple(elements, _) | Expr.SetLit(elements, _):
                    for element in elements |local_scope, fns, structs, generics, depth|:
                        return true if backend_expression_projects_pool_lifetime_handle(element, local_scope, fns, structs, generics, depth + 1.usize())
                    return false
                Expr.DictLit(entries, _):
                    for entry in entries |local_scope, fns, structs, generics, depth|:
                        return true if backend_expression_projects_pool_lifetime_handle(entry.key, local_scope, fns, structs, generics, depth + 1.usize()) or backend_expression_projects_pool_lifetime_handle(entry.value, local_scope, fns, structs, generics, depth + 1.usize())
                    return false
                Expr.Construct(_, fields, _) | Expr.RecordUpdate(_, fields, _):
                    for field in fields |local_scope, fns, structs, generics, depth|:
                        return true if backend_expression_projects_pool_lifetime_handle(field.value, local_scope, fns, structs, generics, depth + 1.usize())
                    match expression:
                        Expr.RecordUpdate(base, _, _):
                            return backend_expression_projects_pool_lifetime_handle(base, local_scope, fns, structs, generics, depth + 1.usize())
                        _:
                            return false
                Expr.Refinement(base, _, _):
                    return backend_expression_projects_pool_lifetime_handle(base, local_scope, fns, structs, generics, depth + 1.usize())
                Expr.GetElse(guarded, _, _):
                    return backend_expression_projects_pool_lifetime_handle(guarded, local_scope, fns, structs, generics, depth + 1.usize())
                Expr.Match(_, arms, _) | Expr.Catch(_, arms, _):
                    for arm in arms |local_scope, fns, structs, generics, depth|:
                        continue if arm.body.count == 0.usize()
                        arm_last: Stmt = arm.body[arm.body.count - 1.usize()]
                        if arm_last is Stmt.Expr(arm_yield, _):
                            return true if backend_expression_projects_pool_lifetime_handle(arm_yield, local_scope, fns, structs, generics, depth + 1.usize())
                    if expression is Expr.Catch(catch_guarded, _, _):
                        return backend_expression_projects_pool_lifetime_handle(catch_guarded, local_scope, fns, structs, generics, depth + 1.usize())
                    return false
                Expr.Comprehension(_, _, _, body, _):
                    return backend_expression_projects_pool_lifetime_handle(body, local_scope, fns, structs, generics, depth + 1.usize())
                Expr.StaticEffectCall(_, _, _, arguments, _, _):
                    for argument in arguments |local_scope, fns, structs, generics, depth|:
                        return true if backend_expression_projects_pool_lifetime_handle(argument, local_scope, fns, structs, generics, depth + 1.usize())
                    return false
                Expr.Call(callee, arguments, _, _):
                    if backend_is_trusted_pool_await_call(callee, arguments, local_scope, fns, structs, generics):
                        awaited_type: ValueType = expression_type(expression, local_scope, fns, structs, generics)
                        return backend_type_is_raw_pool_handle_representation(awaited_type, structs)
                    call_result_type: ValueType = expression_type(expression, local_scope, fns, structs, generics)
                    call_result_may_hold_handle: bool = backend_type_may_contain_pool_lifetime_handle(call_result_type, structs) or backend_type_may_contain_erased_pool_handle_slot(call_result_type, structs)
                    match callee:
                        Expr.Lambda(_, _, _):
                            # The lifted body has a fresh Scope and can return a captured
                            # ThreadPool.handle without exposing that provenance to this call.
                            # Until closure summaries are available, keep immediate closure
                            # results inside the lifetime boundary.
                            return call_result_may_hold_handle
                        Expr.Ident(local_callee_name, _):
                            if lookup_slot(local_scope, local_callee_name) is local_callee_slot and lookup_type(local_scope, local_callee_name).kind == TypeKind.Fn:
                                return call_result_may_hold_handle
                        _:
                            pass
                    # Scalar casts are representation-preserving for this provenance check:
                    # they can turn a raw pointer/integer into another raw pointer/integer.
                    match callee:
                        Expr.Field(cast_receiver, cast_name, _):
                            if cast_name == "cast" or scalar_type_of_name(cast_name, structs.target.target_pointer_bits).kind != TypeKind.Unmodeled:
                                return backend_expression_projects_pool_lifetime_handle(cast_receiver, local_scope, fns, structs, generics, depth + 1.usize())
                        Expr.Index(Expr.Field(cast_receiver, cast_name, _), _, _) | Expr.IndexN(Expr.Field(cast_receiver, cast_name, _), _, _):
                            if cast_name == "cast":
                                return backend_expression_projects_pool_lifetime_handle(cast_receiver, local_scope, fns, structs, generics, depth + 1.usize())
                        Expr.Ident(cast_name, _) | Expr.Index(Expr.Ident(cast_name, _), _, _) | Expr.IndexN(Expr.Ident(cast_name, _), _, _):
                            if cast_name == "cast" or scalar_type_of_name(cast_name, structs.target.target_pointer_bits).kind != TypeKind.Unmodeled:
                                for argument in arguments |local_scope, fns, structs, generics, depth|:
                                    return true if backend_expression_projects_pool_lifetime_handle(argument, local_scope, fns, structs, generics, depth + 1.usize())
                        _:
                            pass
                    if call_result_may_hold_handle:
                        match callee:
                            Expr.Ident(_, _) | Expr.Scope(_, _, _) | Expr.Index(Expr.Ident(_, _), _, _) | Expr.IndexN(Expr.Ident(_, _), _, _):
                                pass
                            _:
                                indirect_callee_type: ValueType = expression_type(callee, local_scope, fns, structs, generics)
                                return true if indirect_callee_type.kind == TypeKind.Fn
                    if call_result_may_hold_handle:
                        for argument in arguments |local_scope, fns, structs, generics|:
                            argument_type: ValueType = expression_type(argument, local_scope, fns, structs, generics)
                            return true if backend_type_may_contain_pool_lifetime_handle(argument_type, structs)
                            return true if backend_expression_projects_pool_lifetime_handle(argument, local_scope, fns, structs, generics, depth + 1.usize())
                    return false
                _:
                    return false


        def backend_expression_may_contain_pool_lifetime_handle(expression: Expr, value_type: ValueType, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&) -> bool can[Abort.Panic, Memory.Allocate]:
            # `wait all group` is parsed as a value block carrying this marker, then lowered
            # to the bundled synchronous join below. Treat that exact direct-local join as
            # consuming the group handle instead of letting the generic escape check reject
            # it before statement lowering gets a chance to emit the wait.
            if expression is Expr.Block(wait_statements, wait_value, _, wait_pos) and wait_statements.count == 0.usize() and fn_return_head_at_offset(wait_pos.offset, wait_pos.line, structs) == "__wait_all":
                wait_arguments: darray[Expr] = [wait_value]
                return false if backend_is_trusted_task_group_wait_call(Expr.Ident("task_group_wait_all", wait_pos), wait_arguments, local_scope, fns, structs, generics)
            return true if backend_type_may_contain_pool_lifetime_handle(value_type, structs)
            if expression is Expr.Block(_, _, _, await_pos) and fn_return_head_at_offset(await_pos.offset, await_pos.line, structs) == "__await" and backend_type_is_raw_pool_handle_representation(value_type, structs):
                return true
            if expression is Expr.Call(callee, arguments, _, _) and backend_type_is_raw_pool_handle_representation(value_type, structs):
                return true if backend_is_trusted_pool_await_call(callee, arguments, local_scope, fns, structs, generics)
            return backend_expression_projects_pool_lifetime_handle(expression, local_scope, fns, structs, generics, 0.usize())


        # `pool_await` is the one public consumer that synchronously drains a Task before
        # lexical pool cleanup. Permit only the top-level generic runtime template with its
        # exact one-parameter Task -> result signature; a same-named module helper, another
        # overload, an aggregate, or a different consumer remains an ordinary escape.
        def backend_pool_await_source_is_owned_task(expression: Expr, local_scope: mutable Scope&, structs: StructTable&) -> bool can[Abort.Panic]:
            match expression:
                Expr.Ident(name, _):
                    return lookup_slot(local_scope, name) is local_task_slot
                Expr.Move(inner, _) | Expr.Paren(inner, _):
                    return backend_pool_await_source_is_owned_task(inner, local_scope, structs)
                Expr.Block(statements, value, _, pos):
                    false return if statements.count != 0.usize() or not submit_marker_at(pos.offset, structs)
                    return value is Expr.Call(_, _, _, _)
                _:
                    return false


        def backend_is_trusted_pool_await_call(callee: Expr, arguments: darray[Expr]&, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&) -> bool can[Abort.Panic, Memory.Allocate]:
            return false if arguments.count != 1.usize()
            callee_name: mutable sview = ""
            explicit_types: mutable darray[ValueType] = []
            match callee:
                Expr.Ident(name, _):
                    callee_name <- name
                Expr.Index(Expr.Ident(name, _), type_expression, _):
                    callee_name <- name
                    explicit_types.push(annotation_value_type(type_expression, structs))
                Expr.IndexN(Expr.Ident(name, _), type_expressions, _):
                    callee_name <- name
                    for type_expression in type_expressions |explicit_types, structs|:
                        explicit_types.push(annotation_value_type(type_expression, structs))
                _:
                    return false
            return false if callee_name != "pool_await"
            return false if lookup_slot(local_scope, "pool_await") is local_await_slot
            trusted_slot: i64 = generic_index_of_owner(generics, "", "pool_await")
            return false if trusted_slot < 0 or trusted_slot.usize() >= generics.param_count.count or trusted_slot.usize() >= generics.owners.count or trusted_slot.usize() >= generics.decls.count
            return false if generics.owners[trusted_slot.usize()] != "" or generics.param_count[trusted_slot.usize()] != 1
            return false if generic_index_of(generics, "pool_await") != trusted_slot
            # A module/top-level monomorphic function of the same arity wins before generic
            # lookup in the call emitter. Do not apply the generic consumer exception when
            # that ordinary overload could be selected.
            return false if function_index_of_arity(fns, "", "pool_await", 1.usize()) >= 0
            return false if structs.visibility.current_owner != "" and function_index_of_arity(fns, structs.visibility.current_owner, "pool_await", 1.usize()) >= 0
            top_level_template_count: mutable usize = 0
            template_scan: mutable i64 = name_chain_first(generics.name_buckets, generics.name_next, generics.names, "pool_await")
            while template_scan >= 0 |template_scan, generics, top_level_template_count|:
                top_level_template_count <- top_level_template_count + 1.usize() if template_scan.usize() < generics.owners.count and generics.owners[template_scan.usize()] == ""
                template_scan <- name_chain_next(generics.name_buckets, generics.name_next, generics.names, "pool_await", template_scan)
            return false if top_level_template_count != 1.usize()
            trusted_runtime_line: mutable bool = false
            match generics.decls[trusted_slot.usize()]:
                Decl.Func(function_name, params, _, _, _, _, function_pos):
                    return false if function_name != "pool_await" or params.count != 1.usize()
                    for trusted_line in structs.annotations.pool_await_runtime_lines |trusted_runtime_line, function_pos|:
                        trusted_runtime_line <- true if trusted_line == function_pos.line
                _:
                    return false
            return false if not trusted_runtime_line
            return false if not backend_pool_await_source_is_owned_task(arguments[0], local_scope, structs)
            inferred_types: darray[ValueType] = infer_generic_args(trusted_slot.usize(), arguments, local_scope, fns, structs, generics)
            return false if inferred_types.count != 1.usize()
            return false if explicit_types.count != 0.usize() and (explicit_types.count != inferred_types.count or not value_type_identity_equal(explicit_types[0], inferred_types[0]))
            actual_task_type: ValueType = expression_type(arguments[0], local_scope, fns, structs, generics)
            return false if backend_expression_projects_pool_lifetime_handle(arguments[0], local_scope, fns, structs, generics, 0.usize())
            expected_task_type: ValueType = instantiation_param_type_at(trusted_slot.usize(), inferred_types, 0.usize(), generics, structs)
            return false if actual_task_type.kind != TypeKind.Struct or not value_type_identity_equal(actual_task_type, expected_task_type)
            task_base: mutable sview = ""
            task_arg_start: mutable usize = 0
            task_arg_count: mutable usize = 0
            return false if not generic_struct_instantiation_of(structs, actual_task_type, task_base, task_arg_start, task_arg_count) or task_base != "Task" or task_arg_count != 2.usize()
            return false if actual_task_type.bits.usize() >= structs.records.names.count or actual_task_type.bits.usize() >= structs.records.owners.count or structs.records.names[actual_task_type.bits.usize()] != "Task" or structs.records.owners[actual_task_type.bits.usize()] != ""
            return false if task_arg_start > structs.generics.generic_struct_inst_args.count or task_arg_count > structs.generics.generic_struct_inst_args.count - task_arg_start
            result_type: ValueType = generic_return_type_at(trusted_slot.usize(), inferred_types, generics, structs)
            return value_type_identity_equal(result_type, structs.generics.generic_struct_inst_args[task_arg_start])


        # Explicit task_group_add consumes the Task and roots its completion state until the
        # matching wait. Trust only the unique bundled generic API, a direct local TaskGroup
        # reference, and a moved builtin Task argument.
        def backend_is_trusted_task_group_add_call(callee: Expr, arguments: darray[Expr]&, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&) -> bool can[Abort.Panic, Memory.Allocate]:
            return false if arguments.count != 2.usize()
            return false if not submit_group_api_callee_matches(callee, "task_group_add", local_scope, fns, structs, generics)
            return false if local_scope.group_names.count == 0.usize() or local_scope.group_slots.count != local_scope.group_names.count
            active_group_index: usize = local_scope.group_names.count - 1.usize()
            return false if local_scope.group_manual_add.count != local_scope.group_names.count or not local_scope.group_manual_add[active_group_index]
            active_group_name: sview = local_scope.group_names[active_group_index]
            active_group_slot: LLVMValueRef = local_scope.group_slots[active_group_index]
            return false if submit_group_argument_name(arguments[0]) != active_group_name or not (lookup_slot(local_scope, active_group_name) is active_group_slot)
            return false if not submit_group_runtime_apis_are_unique(fns, generics, structs)
            generic_slot: i64 = submit_group_unique_generic_index("task_group_add", generics)
            return false if generic_slot < 0 or generic_slot.usize() >= generics.decls.count
            inferred_types: darray[ValueType] = infer_generic_args(generic_slot.usize(), arguments, local_scope, fns, structs, generics)
            return false if inferred_types.count != 1.usize()
            group_type: ValueType = expression_type(arguments[0], local_scope, fns, structs, generics)
            expected_group_type: ValueType = instantiation_param_type_at(generic_slot.usize(), inferred_types, 0.usize(), generics, structs)
            return false if expected_group_type.kind != TypeKind.Ref or group_type.kind != TypeKind.Ref or not value_type_identity_equal(group_type, expected_group_type)
            group_value_type: ValueType = ref_target_of(expected_group_type, structs)
            return false if group_value_type.kind != TypeKind.Struct or group_value_type.bits.usize() >= structs.records.names.count or group_value_type.bits.usize() >= structs.records.owners.count or structs.records.names[group_value_type.bits.usize()] != "TaskGroup" or structs.records.owners[group_value_type.bits.usize()] != ""
            task_type: ValueType = expression_type(arguments[1], local_scope, fns, structs, generics)
            expected_task_type: ValueType = instantiation_param_type_at(generic_slot.usize(), inferred_types, 1.usize(), generics, structs)
            return false if not value_type_identity_equal(task_type, expected_task_type)
            return false if backend_expression_projects_pool_lifetime_handle(arguments[1], local_scope, fns, structs, generics, 0.usize())
            match arguments[1]:
                Expr.Move(Expr.Ident(_, _), _):
                    return true
                _:
                    return false


        # A TaskGroup wait is a synchronous join, so it consumes the lifetime handle without
        # letting it escape. Trust only the unique marked runtime API and a direct local group
        # argument with the exact mutable TaskGroup reference type. Requiring a local identifier
        # rules out calls that manufacture a handle through an untrusted expression.
        def backend_is_trusted_task_group_wait_call(callee: Expr, arguments: darray[Expr]&, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&) -> bool can[Abort.Panic, Memory.Allocate]:
            return false if arguments.count != 1.usize()
            return false if not submit_group_api_callee_matches(callee, "task_group_wait_all", local_scope, fns, structs, generics)
            return false if not submit_group_runtime_apis_are_unique(fns, generics, structs)
            group_name: sview = submit_group_argument_name(arguments[0])
            return false if group_name == ""
            if lookup_slot(local_scope, group_name) is direct_group_slot:
                _ = direct_group_slot
            else:
                return false
            wait_index: i64 = submit_group_unique_function_index("task_group_wait_all", 1.usize(), fns, generics)
            return false if wait_index < 0 or wait_index.usize() >= fns.param_start.count or wait_index.usize() >= fns.param_count.count
            wait_row: usize = wait_index.usize()
            return false if fns.param_count[wait_row] != 1.usize()
            parameter_index: usize = fns.param_start[wait_row]
            return false if parameter_index >= fns.param_types.count
            expected_group_type: ValueType = fns.param_types[parameter_index]
            actual_group_type: ValueType = expression_type(arguments[0], local_scope, fns, structs, generics)
            return false if expected_group_type.kind != TypeKind.Ref or not value_type_identity_equal(actual_group_type, expected_group_type)
            group_value_type: ValueType = ref_target_of(expected_group_type, structs)
            return false if group_value_type.kind != TypeKind.Struct or group_value_type.bits.usize() >= structs.records.names.count or group_value_type.bits.usize() >= structs.records.owners.count
            return false if structs.records.names[group_value_type.bits.usize()] != "TaskGroup" or structs.records.owners[group_value_type.bits.usize()] != ""
            return true



        # Infer a generic function's full type-argument tuple from its call arguments, by
        # unifying each parameter annotation against the argument's concrete type. Returns the
        # inferred tuple, or an empty darray if any parameter stayed unbound (the caller then
        # declines, or requires an explicit `f[K, V](…)`).
        # A bare integer literal, or a unary +/- wrapping one — the forms that carry no
        # expression type of their own but should default to i64 for generic inference.
        def is_int_literal_expr(expression: Expr) -> bool can[Abort.Panic]:
            can Abort.Panic:
                match expression:
                    Expr.IntLit(literal_value, _):
                        return true
                    Expr.Unary(unary_operator, unary_operand, unary_line):
                        return when unary_operator:
                            TokenKind.Minus | TokenKind.Plus -> is_int_literal_expr(unary_operand)
                            _ -> false
                    Expr.Paren(paren_inner, paren_line):
                        return is_int_literal_expr(paren_inner)
                    _:
                        return false



        # Type arguments for a generic whose parameter appears ONLY in the RETURN type —
        # `def new[T](api: FlagsNamespace) -> Flags[T]`. The argument-driven pass binds nothing
        # there, so the DECLARATION's annotation is the only source; unify the template's
        # return annotation against the expected type. Returns [] unless every parameter comes
        # out bound, so a caller that cannot fully determine the instantiation declines rather
        # than picking one.
        def infer_generic_args_from_expected(slot: usize, expected: ValueType, generics: mutable GenericTable&, structs: mutable StructTable&) -> darray[ValueType] can[Abort.Panic, Memory.Allocate]:
            count: usize = generics.param_count[slot]
            bindings: mutable darray[ValueType] = [unmodeled_type() for _expected_slot in 0..<count]
            bound_flags: mutable darray[bool] = [false for _expected_flag in 0..<count]
            empty: darray[ValueType] = []
            empty return if count == 0 or expected.kind == TypeKind.Unmodeled
            match generics.decls[slot]:
                Decl.Func(expected_fn_name, expected_params, expected_return_opt, expected_body, expected_effects, expected_decorators, expected_line):
                    if expected_return_opt is expected_return_annotation:
                        unify_annotation(expected_return_annotation, expected, generics, slot, structs, bindings, bound_flags)
                _:
                    pass
            all_bound: mutable bool = true
            for expected_flag in bound_flags |all_bound|:
                all_bound <- false if not expected_flag
            empty return if not all_bound
            return bindings



        def infer_generic_args(slot: usize, arguments: darray[Expr]&, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&) -> darray[ValueType] can[Abort.Panic, Memory.Allocate]:
            count: usize = generics.param_count[slot]
            bindings: mutable darray[ValueType] = [unmodeled_type() for _slot_index in 0..<count]
            bound_flags: mutable darray[bool] = [false for _flag_index in 0..<count]
            match generics.decls[slot]:
                Decl.Func(function_name, params, return_type_opt, body, effects, decorators, line):
                    limit: usize = params.count if params.count < arguments.count else arguments.count
                    for position in 0..<limit |bindings, bound_flags, params, arguments, local_scope, fns, structs, generics, slot|:
                        # `f: fn(A) -> R` against a FUNCTION-VALUED argument. unify_annotation takes
                        # a ValueType, and matching a fn-type ANNOTATION against one needs the
                        # actual's parameter and return types, so it is resolved here where the
                        # argument expression is still in hand. Two sources, in order:
                        #   - an interned Fn ValueType (a local or parameter of fn type) carries its
                        #     signature in the fn_pool_* side-pools — this is the case pool_submit1
                        #     needs, where `fn` is its own PARAMETER, not a named function;
                        #   - a bare function NAME has no expression type of its own, so its
                        #     declaration in the FnTable is the only source.
                        # The annotation's own parameter type expressions are keyed by the fn
                        # token offset, so same-line callback signatures remain distinct.
                        lambda_handled: mutable bool = false
                        match params[position].type_expression:
                            Expr.Lambda(lam_names, lam_body, lam_line):
                                lam_param_types: mutable darray[ValueType] = []
                                lam_return_type: mutable ValueType = unmodeled_type()
                                lam_actual_type: ValueType = expression_type(arguments[position], local_scope, fns, structs, generics)
                                if lam_actual_type.kind == TypeKind.Fn and lam_actual_type.bits.usize() < structs.function_types.fn_pool_returns.count:
                                    lambda_handled <- true
                                    lam_pool_start: usize = structs.function_types.fn_pool_param_start[lam_actual_type.bits.usize()]
                                    for lam_pool_i in 0..<structs.function_types.fn_pool_param_count[lam_actual_type.bits.usize()] |lam_param_types, lam_pool_start, structs|:
                                        lam_param_types.push(copied_type(structs.function_types.fn_pool_params[lam_pool_start + lam_pool_i]))
                                    lam_return_type <- fn_return_type_of(lam_actual_type, structs)
                                else:
                                    match arguments[position]:
                                        Expr.Ident(lam_arg_name, _):
                                            if function_index_of(fns, "", lam_arg_name) >= 0:
                                                lambda_handled <- true
                                                for lam_fn_i in 0..<param_type_count(fns, "", lam_arg_name) |lam_param_types, lam_arg_name, fns|:
                                                    lam_param_types.push(param_type_of(fns, "", lam_arg_name, lam_fn_i))
                                                lam_return_type <- lookup_return_type(fns, "", lam_arg_name)
                                        _:
                                            pass
                                if lambda_handled:
                                    lam_probe: mutable usize = 0
                                    lam_index: mutable usize = 0
                                    while lam_probe < structs.function_types.fn_type_param_lines.count |lam_probe, lam_index, lam_line, lam_param_types, bindings, bound_flags, generics, slot, structs|:
                                        if structs.function_types.fn_type_param_lines[lam_probe] == lam_line.line and structs.function_types.fn_type_param_offsets[lam_probe] == lam_line.offset:
                                            if lam_index < lam_param_types.count and lam_param_types[lam_index].kind != TypeKind.Unmodeled:
                                                unify_annotation(structs.function_types.fn_type_param_exprs[lam_probe], lam_param_types[lam_index], generics, slot, structs, bindings, bound_flags)
                                            lam_index <- lam_index + 1
                                        lam_probe <- lam_probe + 1
                                    lam_return_position: i64 = type_param_position(generics, slot, fn_return_head_at_offset(lam_line.offset, lam_line.line, structs))
                                    if lam_return_position >= 0 and not bound_flags[lam_return_position.usize()] and lam_return_type.kind != TypeKind.Unmodeled:
                                        bindings[lam_return_position.usize()] <- copied_type(lam_return_type)
                                        bound_flags[lam_return_position.usize()] <- true
                            _:
                                pass
                        continue if lambda_handled
                        actual: mutable ValueType = expression_type(arguments[position], local_scope, fns, structs, generics)
                        # An untyped int literal argument (`id(21)`) has no expression type of its
                        # own — like stage0's inference, default it to i64 so a bare type-parameter
                        # binds instead of leaving the call uninferable.
                        actual <- ValueType{kind: TypeKind.Signed, bits: 64} if actual.kind == TypeKind.Unmodeled and is_int_literal_expr(arguments[position])
                        continue if actual.kind == TypeKind.Unmodeled
                        fixed_extent_status: i64 = unify_fixed_array_extent(params[position].type_expression, actual, slot, generics, structs, bindings, bound_flags)
                        if fixed_extent_status == 0:
                            bindings <- bindings.truncate(0)
                            return bindings
                        continue if fixed_extent_status == 1
                        unify_annotation(params[position].type_expression, actual, generics, slot, structs, bindings, bound_flags)
                _:
                    pass
            for flag_index in 0..<count |bound_flags, bindings|:
                if not bound_flags[flag_index]:
                    bindings <- bindings.truncate(0)
                    return bindings
            return bindings



        # The index of generic template `name`, or -1.
        # The template slot a bare name resolves to, in the order every other declaration
        # kind uses: the enclosing module's own, then a top-level one, then the first of that
        # name anywhere. It used to return the first slot by bare name alone, so `read_as(1)`
        # written inside `module B:` picked module A's template when A was declared first —
        # and since instantiations are memoized per slot, both modules then shared ONE body,
        # which read A's private state for B's callers.
        def generic_index_of(generics: GenericTable&, name: sview) -> i64 can[Abort.Panic]:
            first: i64 = name_chain_first(generics.name_buckets, generics.name_next, generics.names, name)
            if generics.current_owner != "":
                owned: mutable i64 = first
                while owned >= 0 |owned, generics, name|:
                    owned return if owned.usize() < generics.owners.count and generics.owners[owned.usize()] == generics.current_owner
                    owned <- name_chain_next(generics.name_buckets, generics.name_next, generics.names, name, owned)
            top: mutable i64 = first
            while top >= 0 |top, generics, name|:
                top return if top.usize() >= generics.owners.count or generics.owners[top.usize()] == ""
                top <- name_chain_next(generics.name_buckets, generics.name_next, generics.names, name, top)
            return first



        # Exact owner lookup for a module-qualified generic reference. Unlike a bare name,
        # `Module::f` must never fall through to a same-named template from another module or
        # from the top level: doing so can compile successfully while instantiating the wrong
        # body (and, for container methods, corrupt memory).
        def generic_index_of_owner(generics: GenericTable&, owner: sview, name: sview) -> i64 can[Abort.Panic]:
            index: mutable i64 = name_chain_first(generics.name_buckets, generics.name_next, generics.names, name)
            while index >= 0 |index, generics, owner, name|:
                index return if index.usize() < generics.owners.count and generics.owners[index.usize()] == owner
                index <- name_chain_next(generics.name_buckets, generics.name_next, generics.names, name, index)
            return -1



        # The errorset parameter of generic template `slot`, or empty for a monomorphic
        # error family. It is intentionally not part of GenericTable.param_count: callers
        # never pass an error set as a runtime/type value.
        def generic_error_param_at(generics: GenericTable&, slot: usize) -> sview can[Abort.Panic]:
            return generics.error_params[slot] if slot < generics.error_params.count
            return ""



        def fn_error_family_of(fn_type: ValueType, structs: StructTable&) -> sview can[Abort.Panic]:
            return structs.function_types.fn_pool_error_families[fn_type.bits.usize()] if fn_type.kind == TypeKind.Fn and fn_type.bits.usize() < structs.function_types.fn_pool_error_families.count
            return ""



        # The concrete error family carried by a callable expression. A bare function name
        # is not itself a ValueType in the compact backend, so recover its declared family
        # from FnTable; a local/function field already carries it in the Fn side-pool.
        def concrete_error_family_of(expression: Expr, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&) -> sview can[Abort.Panic, Memory.Allocate]:
            actual: ValueType = expression_type(expression, local_scope, fns, structs, generics)
            if actual.kind == TypeKind.ErrorUnion:
                return error_union_family_of(actual, structs)
            if actual.kind == TypeKind.Fn:
                actual_family: sview = fn_error_family_of(actual, structs)
                return actual_family if actual_family != ""
            match expression:
                Expr.Lambda(lambda_params, lambda_body, lambda_line):
                    lambda_family: sview = fn_error_family_at_offset(lambda_line.offset, lambda_line.line, structs)
                    return lambda_family if lambda_family != ""
                Expr.Ident(callable_name, callable_line):
                    callable_index: i64 = function_index_of(fns, "", callable_name)
                    if callable_index >= 0 and fns.is_error[callable_index.usize()]:
                        return line_error_set_name(structs.errors.error_fn_lines, structs.errors.error_fn_set_names, fns.lines[callable_index.usize()])
                _:
                    pass
            return ""



        # Infer the concrete family for an `errorset R` generic from an argument whose
        # declared parameter mentions R. This is the errorset analogue of infer_generic_args:
        # ordinary type bindings remain in the returned darray, while the family is kept as a
        # source selector for specialization and ABI construction.
        def infer_generic_error_family(slot: usize, arguments: darray[Expr]&, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&) -> sview can[Abort.Panic, Memory.Allocate]:
            wanted_family: sview = generic_error_param_at(generics, slot)
            if wanted_family == "":
                match generics.decls[slot]:
                    Decl.Func(_, _, _, _, _, _, declared_error_line):
                        return line_error_set_name(structs.errors.error_fn_lines, structs.errors.error_fn_set_names, declared_error_line.line)
                    _:
                        return ""
            match generics.decls[slot]:
                Decl.Func(error_generic_name, error_generic_params, error_generic_return, error_generic_body, error_generic_effects, error_generic_decorators, error_generic_line):
                    limit: usize = error_generic_params.count if error_generic_params.count < arguments.count else arguments.count
                    for position in 0..<limit |wanted_family, arguments, local_scope, fns, structs, generics|:
                        pattern: ValueType = parameter_value_type(error_generic_params[position].type_expression, structs)
                        pattern_family: mutable sview = ""
                        pattern_family <- error_union_family_of(pattern, structs) if pattern.kind == TypeKind.ErrorUnion
                        if pattern.kind == TypeKind.Fn:
                            pattern_family <- fn_error_family_of(pattern, structs)
                            pattern_return: ValueType = fn_return_type_of(pattern, structs)
                            if pattern_family == "":
                                pattern_family <- error_union_family_of(pattern_return, structs) if pattern_return.kind == TypeKind.ErrorUnion
                        if pattern_family == wanted_family:
                            actual_family: sview = concrete_error_family_of(arguments[position], local_scope, fns, structs, generics)
                            return actual_family if actual_family != ""
                _:
                    pass
            return ""



        # The already-declared instantiation for (base, type-argument tuple), or null.
        def instantiation_of(generics: GenericTable&, base: sview, type_args: darray[ValueType]&) -> LLVMValueRef? can[Abort.Panic]:
            for index in 0..<generics.inst_bases.count |generics, base, type_args|:
                continue if generics.inst_bases[index] != base
                continue if generics.inst_arg_count[index] != type_args.count
                astart: usize = generics.inst_arg_start[index]
                matched: mutable bool = true
                for k in 0..<type_args.count |generics, matched, astart, type_args|:
                    stored: ValueType = generics.inst_args[astart + k]
                    # Generic arguments are nominal identities, not merely ABI shapes. In
                    # particular, distinct const-enum types can both be `u8`; collapsing them
                    # here reuses the first specialization and can select the wrong static
                    # effect handler later in that body's erased direct-call graph.
                    matched <- false if not value_type_identity_equal(stored, type_args[k])
                generics.inst_handles[index] return if matched
            return null
