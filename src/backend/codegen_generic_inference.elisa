# Stage1 backend — the GENERIC TABLE and the inference that fills it: unify a parameter's
# annotation against a concrete argument type, infer the full type-argument tuple from the
# call (or from the expected type when a parameter appears only in the return), and resolve an
# `errorset R` family. Part of `module Backend` (see codegen.elisa).

extend Backend:
    private:


        # Generic function TEMPLATES, and the instantiations made from them.
        #
        # The instantiation cache is keyed by (base name, type argument) — NOT by mangled
        # name. That is deliberate: an `sview` is a view, so a mangled name built into a
        # local buffer would DANGLE the moment the buffer's region died (Elisa's region
        # checker catches exactly this). `base_names` are sviews into the SOURCE buffer,
        # which outlives everything, and ValueType is POD — so nothing here borrows.
        #
        # The mangled name is only ever needed transiently, to hand to LLVMAddFunction,
        # which COPIES it. So it is built in a local buffer, used, and dropped.
        #
        # Generic parameter names come from the FILE-level side table
        # (`generic_param_names` / `generic_param_lines`) keyed by the function's LINE —
        # they are NOT on Decl.Func. A row whose line has the high bit set is a BOUND
        # (`[T: Ord]`): metadata the backend never needs, since it only instantiates types
        # the frontend already accepted.
        struct GenericTable:
            names: mutable darray[sview]
            decls: mutable darray[Decl]
            params: mutable darray[sview]
            param_start: mutable darray[usize]
            param_count: mutable darray[usize]
            # Whether each template is ERROR-RETURNING (`… error[E]`): its instantiations must
            # use the i32-status + leading-out-param ABI, in both the signature and the body.
            # Computed at registration from the file's error-line side table (a template has no
            # `error[E]` node on its Decl — the clause is consumed at parse time).
            is_error: mutable darray[bool]
            # Optional errorset parameter name, one row per generic template. This is not
            # an ordinary type argument: it specializes the error family/permission row.
            error_params: mutable darray[sview]
            # The MODULE that declared each template, or "" for a top-level generic. An
            # instantiation's body is emitted long after the module walk has moved on, so the
            # owner cannot be read from the emission context: without this row the body is
            # emitted as if top-level, and a bare sibling call inside `module M:` silently
            # binds to a same-named TOP-LEVEL function instead of M's own member. That is a
            # wrong-answer bug, not a diagnostic -- the program compiles and calls the wrong
            # function.
            owners: mutable darray[sview]
            # Instantiations, keyed by (base name, type-argument TUPLE). A generic may have
            # more than one type parameter (`arena_dict_put[K, T]`), so the arguments live in
            # a flat pool with a per-instantiation span rather than one ValueType per row.
            inst_bases: mutable darray[sview]
            inst_args: mutable darray[ValueType]
            inst_arg_start: mutable darray[usize]
            inst_arg_count: mutable darray[usize]
            inst_handles: mutable darray[LLVMValueRef]
            # The template SLOT each instantiation came from. Redundant with the base name UNLESS
            # the name is overloaded (`len[T](Slice)` vs `len[T](ReadView)`): then base+args are not
            # unique, so the slot is what distinguishes the two — used to key the cache and to emit
            # the correct BODY (emit_instantiation_body must not re-derive the slot by first-name).
            inst_slots: mutable darray[usize]
            # Concrete error-family selector for each instantiation. Kept parallel to
            # inst_slots so two specializations with the same ordinary type arguments but
            # different error rows never share an LLVM body or symbol.
            inst_error_families: mutable darray[sview]
            # Whether this instantiation's SIGNATURE trails the caller's arena — RECORDED at
            # declaration rather than recomputed per call site.
            #
            # signature_needs_arena is ORDER-DEPENDENT: it asks whether a parameter's target is
            # a growable container, and a `dict[K, T]&` parameter only answers yes once
            # `DynDict[K, T]` has been registered. Two instantiations of the same shape
            # therefore disagreed depending on which was declared first —
            # arena_dict_put_or_panic[u64, sview] got NO arena parameter while the
            # arena_dict_put[u64, sview] it calls got one, so the callee read its arena out of a
            # register the caller never set. Every dict `put` then grew its bucket array from a
            # garbage Arena, and the stage1-built semantic analyzer segfaulted probing past the
            # end of it.
            #
            # A call site always declares the instantiation before emitting its arguments, so
            # reading the recorded flag makes the two sides agree BY CONSTRUCTION rather than by
            # both happening to recompute the same answer.
            inst_needs_arena: mutable darray[bool]
            # Whether the instantiation carries the hidden packed-store parameter
            # (a param or the return mentions a store-backed hierarchy), recorded
            # for the same reason as inst_needs_arena.
            inst_needs_store: mutable darray[bool]
            # The WORKLIST: instantiations declared but whose BODY still needs emitting. A
            # body cannot be emitted at the call site (the builder sits inside the caller),
            # so emit_module drains this afterwards — and keeps draining, because a generic
            # can call another generic. Type args are pooled the same way as inst_args.
            pending_bases: mutable darray[sview]
            pending_args: mutable darray[ValueType]
            pending_arg_start: mutable darray[usize]
            pending_arg_count: mutable darray[usize]
            pending_handles: mutable darray[LLVMValueRef]
            # The template slot for each queued body (parallel to pending_bases). emit_instantiation_body
            # emits generics.decls[this slot] — NOT decls[generic_index_of(base)], which would pick the
            # first overload's body for an overloaded name.
            pending_slots: mutable darray[usize]
            pending_error_families: mutable darray[sview]




        def new_generic_table() -> GenericTable can[Abort.Panic, Memory.Allocate]:
            return GenericTable{names: [], decls: [], params: [], param_start: [], param_count: [], is_error: [], error_params: [], owners: [], inst_bases: [], inst_args: [], inst_arg_start: [], inst_arg_count: [], inst_handles: [], inst_slots: [], inst_error_families: [], inst_needs_arena: [], inst_needs_store: [], pending_bases: [], pending_args: [], pending_arg_start: [], pending_arg_count: [], pending_handles: [], pending_slots: [], pending_error_families: []}




        # Push one type-parameter binding per (param name, type arg) for template `slot`, so
        # annotation_value_type resolves the template's `K`/`T` to the concrete args. Returns
        # the number pushed, to pop symmetrically with pop_type_bindings.
        def push_type_bindings(generics: GenericTable&, structs: mutable StructTable&, slot: usize, type_args: darray[ValueType]&) -> usize can[Abort.Panic, Memory.Allocate]:
            pstart: usize = generics.param_start[slot]
            count: usize = generics.param_count[slot]
            bound: mutable usize = 0
            for k in 0..<count |structs, generics, pstart, type_args, bound, count|:
                break if k >= type_args.count
                structs.binding_names <- structs.binding_names.push(generics.params[pstart + k])
                structs.binding_types <- structs.binding_types.push(copied_type(type_args[k]))
                bound <- bound + 1
            return bound




        def pop_type_bindings(structs: mutable StructTable&, count: usize) -> void can[Abort.Panic, Memory.Allocate]:
            for _drop in 0..<count |structs|:
                structs.binding_names <- structs.binding_names.truncate(structs.binding_names.count - 1)
                structs.binding_types <- structs.binding_types.truncate(structs.binding_types.count - 1)




        # Bind an `errorset R` parameter for the duration of resolving a generic signature or
        # body. Error families are source selectors/permissions rather than ValueTypes, so they
        # deliberately live outside the ordinary type binding stack.
        def push_error_family_binding(generics: GenericTable&, structs: mutable StructTable&, slot: usize, family: sview) -> usize can[Abort.Panic, Memory.Allocate]:
            return 0 if slot >= generics.error_params.count or generics.error_params[slot] == "" or family == ""
            structs.error_binding_names <- structs.error_binding_names.push(generics.error_params[slot])
            structs.error_binding_families <- structs.error_binding_families.push(family)
            return 1




        def pop_error_family_bindings(structs: mutable StructTable&, count: usize) -> void can[Abort.Panic, Memory.Allocate]:
            for _drop in 0..<count |structs|:
                structs.error_binding_names <- structs.error_binding_names.truncate(structs.error_binding_names.count - 1)
                structs.error_binding_families <- structs.error_binding_families.truncate(structs.error_binding_families.count - 1)




        # Resolve an error-family selector through the current generic binding stack. A plain
        # selector is returned unchanged; a bound selector such as R becomes IoErr.
        def resolved_error_family(family: sview, structs: StructTable&) -> sview can[Abort.Panic]:
            count: usize = structs.error_binding_names.count
            for offset in 0..<count |family, structs, count|:
                index: usize = count - 1.usize() - offset
                structs.error_binding_families[index] return if structs.error_binding_names[index] == family
            return family




        # The position of type-parameter `name` in template `slot`, or -1. Used by inference
        # to bind the argument that pins that parameter.
        def type_param_position(generics: GenericTable&, slot: usize, name: sview) -> i64 can[Abort.Panic]:
            pstart: usize = generics.param_start[slot]
            count: usize = generics.param_count[slot]
            for k in 0..<count |generics, pstart, name, count|:
                k.i64() return if generics.params[pstart + k] == name
            return -1




        # UNIFY a parameter's type annotation against the CONCRETE type of the argument
        # passed for it, binding any type parameters it names. `mutable`/`&` qualifiers are
        # transparent (the argument's value type is what matters), and a `Base[..]` annotation
        # recurses into a matching generic-struct instantiation's stored arguments — so
        # `dict[K, T]&` unified against a `DynDict[i64, i64]` argument pins K=i64, T=i64.
        def unify_annotation(annotation: Expr, actual: ValueType, generics: GenericTable&, slot: usize, structs: StructTable&, bindings: mutable darray[ValueType]&, bound_flags: mutable darray[bool]&) -> void can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic, Memory.Allocate:
                match annotation:
                    Expr.Unary(qualifier, inner_annotation, qualifier_line):
                        # `mutable T` is transparent. `T&` strips a reference on BOTH sides in step:
                        # the argument for a `Bucket[T]&` parameter is often a `Bucket[i64]&` (e.g.
                        # `&arr[0]`), so the outer `&` must peel off the actual's Ref too before the
                        # inner `Bucket[T]` unifies against the instantiation.
                        unify_annotation(inner_annotation, actual, generics, slot, structs, bindings, bound_flags) if qualifier == TokenKind.Mutable
                        if qualifier == TokenKind.Ampersand:
                            # Read the referent directly (ref_target_of would demand a mutable table).
                            stripped_actual: ValueType = copied_type(structs.ref_targets[actual.bits.usize()]) if actual.kind == TypeKind.Ref else copied_type(actual)
                            unify_annotation(inner_annotation, stripped_actual, generics, slot, structs, bindings, bound_flags)
                        if qualifier == TokenKind.Question:
                            # `T&?` / `Box[T]?`: optionality wraps the
                            # parameter shape but does not hide its generic
                            # payload. Peel the concrete optional in lockstep
                            # before continuing inference.
                            optional_actual: ValueType = copied_type(structs.optional_targets[actual.bits.usize()]) if actual.kind == TypeKind.Optional else copied_type(actual)
                            unify_annotation(inner_annotation, optional_actual, generics, slot, structs, bindings, bound_flags)
                        return
                    _:
                        pass
                match annotation:
                    Expr.Ident(param_name, param_name_line):
                        position: i64 = type_param_position(generics, slot, param_name)
                        if position >= 0 and not bound_flags[position.usize()]:
                            bindings[position.usize()] <- copied_type(actual)
                            bound_flags[position.usize()] <- true
                        return
                    _:
                        pass
                # `view[T]` annotation against a `view[U]` argument — bind T from the view's
                # interned element. Checked before the generic-struct branch (a View is not a
                # struct instantiation), so `arena_da_fill(view, …)` recovers its element type.
                match annotation:
                    Expr.Index(view_annotation_head, view_annotation_arg, view_annotation_line):
                        match view_annotation_head:
                            Expr.Ident(view_annotation_name, view_annotation_head_line):
                                if view_annotation_name == "view" and actual.kind == TypeKind.View:
                                    unify_annotation(view_annotation_arg, copied_type(structs.view_elements[actual.bits.usize()]), generics, slot, structs, bindings, bound_flags)
                                    return
                                # `darray[T]` annotation against a `darray[U]` argument — bind T from the
                                # argument's element (like the view case). Needed so a generic over a darray
                                # PARAMETER (`slice[T](da: darray[T]&)`, `arena_da_fill[T](darray[T]&, …)`)
                                # infers T; the outer `&` was already peeled by the Unary branch above.
                                if view_annotation_name == "darray" and actual.kind == TypeKind.DArray:
                                    unify_annotation(view_annotation_arg, copied_type(structs.darray_elements[actual.bits.usize()]), generics, slot, structs, bindings, bound_flags)
                                    return
                            _:
                                pass
                    _:
                        pass
                # `darray[T, shape_in]` — the SHAPED spelling the std uses on every in-place
                # container helper (`arena_da_view[T](da: darray[T, shape_in]&, …)`). The shape
                # argument makes the annotation an IndexN, so the single-argument darray branch
                # above never matched and T never bound, which failed inference for the whole call.
                # Shapes are erased at the type level already; the ELEMENT is type argument 0 and
                # the trailing shapes carry nothing to unify against. (`view` is NOT included: it
                # takes exactly one argument, so a shaped view does not parse.)
                match annotation:
                    Expr.IndexN(shaped_head, shaped_args, shaped_line):
                        match shaped_head:
                            Expr.Ident(shaped_name, shaped_head_line):
                                if shaped_name == "darray" and actual.kind == TypeKind.DArray and shaped_args.count >= 1:
                                    unify_annotation(shaped_args[0], copied_type(structs.darray_elements[actual.bits.usize()]), generics, slot, structs, bindings, bound_flags)
                                    return
                            _:
                                pass
                    _:
                        pass
                # `Base[A]` / `Base[A, B]` — recurse into the argument's instantiation arguments
                # when the argument is that same generic struct.
                actual_base: mutable sview = ""
                actual_arg_start: mutable usize = 0
                actual_arg_count: mutable usize = 0
                has_instantiation: bool = generic_struct_instantiation_of(structs, actual, actual_base, actual_arg_start, actual_arg_count)
                return if not has_instantiation
                match annotation:
                    Expr.Index(base_head, single_type_arg, index_line):
                        match base_head:
                            Expr.Ident(base_name, base_head_line):
                                mapped_base: sview = "DynDict" if base_name == "dict" else ("DynSet" if base_name == "set" else base_name)
                                if mapped_base == actual_base and actual_arg_count == 1:
                                    unify_annotation(single_type_arg, copied_type(structs.generic_struct_inst_args[actual_arg_start]), generics, slot, structs, bindings, bound_flags)
                            _:
                                pass
                        return
                    _:
                        pass
                match annotation:
                    Expr.IndexN(multi_base_head, multi_type_args, multi_index_line):
                        match multi_base_head:
                            Expr.Ident(multi_base_name, multi_base_head_line):
                                mapped_multi_base: sview = "DynDict" if multi_base_name == "dict" else ("DynSet" if multi_base_name == "set" else multi_base_name)
                                if mapped_multi_base == actual_base and actual_arg_count == multi_type_args.count:
                                    for arg_position in 0..<multi_type_args.count |multi_type_args, actual_arg_start, generics, slot, structs, bindings, bound_flags|:
                                        unify_annotation(multi_type_args[arg_position], copied_type(structs.generic_struct_inst_args[actual_arg_start + arg_position]), generics, slot, structs, bindings, bound_flags)
                            _:
                                pass
                        return


                    _:
                        pass


            # If `value_type` is a materialized generic-struct instantiation, report its base name
            # and the flat span of its stored type arguments.
        def generic_struct_instantiation_of(structs: StructTable&, value_type: ValueType, out_base: mutable sview&, out_arg_start: mutable usize&, out_arg_count: mutable usize&) -> bool can[Abort.Panic]:
            false return if value_type.kind != TypeKind.Struct
            for inst in 0..<structs.generic_struct_inst_index.count |structs, value_type, out_base, out_arg_start, out_arg_count|:
                if structs.generic_struct_inst_index[inst] == value_type.bits.usize():
                    out_base <- structs.generic_struct_inst_bases[inst]
                    out_arg_start <- structs.generic_struct_inst_arg_start[inst]
                    out_arg_count <- structs.generic_struct_inst_arg_count[inst]
                    return true
            return false




        # Infer a generic function's full type-argument tuple from its call arguments, by
        # unifying each parameter annotation against the argument's concrete type. Returns the
        # inferred tuple, or an empty darray if any parameter stayed unbound (the caller then
        # declines, or requires an explicit `f[K, V](…)`).
        # A bare integer literal, or a unary +/- wrapping one — the forms that carry no
        # expression type of their own but should default to i64 for generic inference.
        def is_int_literal_expr(expression: Expr) -> bool can[Abort.Panic]:
            can Abort.Panic:
                match expression:
                    Expr.IntLit(literal_value):
                        return true
                    Expr.Unary(unary_operator, unary_operand, unary_line):
                        return when unary_operator:
                            TokenKind.Minus | TokenKind.Plus -> is_int_literal_expr(unary_operand)
                            _ -> false
                    Expr.Paren(paren_inner, paren_line):
                        return is_int_literal_expr(paren_inner)
                    _:
                        return false



        # Type arguments for a generic whose parameter appears ONLY in the RETURN type —
        # `def new[T](api: FlagsNamespace) -> Flags[T]`. The argument-driven pass binds nothing
        # there, so the DECLARATION's annotation is the only source; unify the template's
        # return annotation against the expected type. Returns [] unless every parameter comes
        # out bound, so a caller that cannot fully determine the instantiation declines rather
        # than picking one.
        def infer_generic_args_from_expected(slot: usize, expected: ValueType, generics: mutable GenericTable&, structs: mutable StructTable&) -> darray[ValueType] can[Abort.Panic, Memory.Allocate]:
            count: usize = generics.param_count[slot]
            bindings: mutable darray[ValueType] = [unmodeled_type() for _expected_slot in 0..<count]
            bound_flags: mutable darray[bool] = [false for _expected_flag in 0..<count]
            empty: darray[ValueType] = []
            empty return if count == 0 or expected.kind == TypeKind.Unmodeled
            match generics.decls[slot]:
                Decl.Func(expected_fn_name, expected_params, expected_return_opt, expected_body, expected_effects, expected_decorators, expected_line):
                    if expected_return_opt is expected_return_annotation:
                        unify_annotation(expected_return_annotation, expected, generics, slot, structs, bindings, bound_flags)
                _:
                    pass
            all_bound: mutable bool = true
            for expected_flag in bound_flags |all_bound|:
                all_bound <- false if not expected_flag
            empty return if not all_bound
            return bindings




        def infer_generic_args(slot: usize, arguments: darray[Expr]&, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&) -> darray[ValueType] can[Abort.Panic, Memory.Allocate]:
            count: usize = generics.param_count[slot]
            bindings: mutable darray[ValueType] = [unmodeled_type() for _slot_index in 0..<count]
            bound_flags: mutable darray[bool] = [false for _flag_index in 0..<count]
            match generics.decls[slot]:
                Decl.Func(function_name, params, return_type_opt, body, effects, decorators, line):
                    limit: usize = params.count if params.count < arguments.count else arguments.count
                    for position in 0..<limit |bindings, bound_flags, params, arguments, local_scope, fns, structs, generics, slot|:
                        # `f: fn(A) -> R` against a FUNCTION-VALUED argument. unify_annotation takes
                        # a ValueType, and matching a fn-type ANNOTATION against one needs the
                        # actual's parameter and return types, so it is resolved here where the
                        # argument expression is still in hand. Two sources, in order:
                        #   - an interned Fn ValueType (a local or parameter of fn type) carries its
                        #     signature in the fn_pool_* side-pools — this is the case pool_submit1
                        #     needs, where `fn` is its own PARAMETER, not a named function;
                        #   - a bare function NAME has no expression type of its own, so its
                        #     declaration in the FnTable is the only source.
                        # The annotation's own parameter type expressions are line-keyed exactly as
                        # annotation_lambda_value_type reads them.
                        lambda_handled: mutable bool = false
                        match params[position].type_expression:
                            Expr.Lambda(lam_names, lam_body, lam_line):
                                lam_param_types: mutable darray[ValueType] = []
                                lam_return_type: mutable ValueType = unmodeled_type()
                                lam_actual_type: ValueType = expression_type(arguments[position], local_scope, fns, structs, generics)
                                if lam_actual_type.kind == TypeKind.Fn and lam_actual_type.bits.usize() < structs.fn_pool_returns.count:
                                    lambda_handled <- true
                                    lam_pool_start: usize = structs.fn_pool_param_start[lam_actual_type.bits.usize()]
                                    for lam_pool_i in 0..<structs.fn_pool_param_count[lam_actual_type.bits.usize()] |lam_param_types, lam_pool_start, structs|:
                                        lam_param_types.push(copied_type(structs.fn_pool_params[lam_pool_start + lam_pool_i]))
                                    lam_return_type <- fn_return_type_of(lam_actual_type, structs)
                                else:
                                    match arguments[position]:
                                        Expr.Ident(lam_arg_name, _):
                                            if function_index_of(fns, "", lam_arg_name) >= 0:
                                                lambda_handled <- true
                                                for lam_fn_i in 0..<param_type_count(fns, "", lam_arg_name) |lam_param_types, lam_arg_name, fns|:
                                                    lam_param_types.push(param_type_of(fns, "", lam_arg_name, lam_fn_i))
                                                lam_return_type <- lookup_return_type(fns, "", lam_arg_name)
                                        _:
                                            pass
                                if lambda_handled:
                                    lam_probe: mutable usize = 0
                                    lam_index: mutable usize = 0
                                    while lam_probe < structs.fn_type_param_lines.count |lam_probe, lam_index, lam_line, lam_param_types, bindings, bound_flags, generics, slot, structs|:
                                        if structs.fn_type_param_lines[lam_probe] == lam_line.line:
                                            if lam_index < lam_param_types.count and lam_param_types[lam_index].kind != TypeKind.Unmodeled:
                                                unify_annotation(structs.fn_type_param_exprs[lam_probe], lam_param_types[lam_index], generics, slot, structs, bindings, bound_flags)
                                            lam_index <- lam_index + 1
                                        lam_probe <- lam_probe + 1
                                    lam_return_position: i64 = type_param_position(generics, slot, fn_return_head_at(lam_line.line, structs))
                                    if lam_return_position >= 0 and not bound_flags[lam_return_position.usize()] and lam_return_type.kind != TypeKind.Unmodeled:
                                        bindings[lam_return_position.usize()] <- copied_type(lam_return_type)
                                        bound_flags[lam_return_position.usize()] <- true
                            _:
                                pass
                        continue if lambda_handled
                        actual: mutable ValueType = expression_type(arguments[position], local_scope, fns, structs, generics)
                        # An untyped int literal argument (`id(21)`) has no expression type of its
                        # own — like stage0's inference, default it to i64 so a bare type-parameter
                        # binds instead of leaving the call uninferable.
                        actual <- ValueType{kind: TypeKind.Signed, bits: 64} if actual.kind == TypeKind.Unmodeled and is_int_literal_expr(arguments[position])
                        continue if actual.kind == TypeKind.Unmodeled
                        unify_annotation(params[position].type_expression, actual, generics, slot, structs, bindings, bound_flags)
                _:
                    pass
            for flag_index in 0..<count |bound_flags, bindings|:
                if not bound_flags[flag_index]:
                    bindings <- bindings.truncate(0)
                    return bindings
            return bindings




        # The index of generic template `name`, or -1.
        def generic_index_of(generics: GenericTable&, name: sview) -> i64 can[Abort.Panic]:
            for index in 0..<generics.names.count |generics, name|:
                index.i64() return if generics.names[index] == name
            return -1




        # The errorset parameter of generic template `slot`, or empty for a monomorphic
        # error family. It is intentionally not part of GenericTable.param_count: callers
        # never pass an error set as a runtime/type value.
        def generic_error_param_at(generics: GenericTable&, slot: usize) -> sview can[Abort.Panic]:
            return generics.error_params[slot] if slot < generics.error_params.count
            return ""




        def fn_error_family_of(fn_type: ValueType, structs: StructTable&) -> sview can[Abort.Panic]:
            return structs.fn_pool_error_families[fn_type.bits.usize()] if fn_type.kind == TypeKind.Fn and fn_type.bits.usize() < structs.fn_pool_error_families.count
            return ""




        # The concrete error family carried by a callable expression. A bare function name
        # is not itself a ValueType in the compact backend, so recover its declared family
        # from FnTable; a local/function field already carries it in the Fn side-pool.
        def concrete_error_family_of(expression: Expr, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&) -> sview can[Abort.Panic, Memory.Allocate]:
            actual: ValueType = expression_type(expression, local_scope, fns, structs, generics)
            if actual.kind == TypeKind.ErrorUnion:
                return error_union_family_of(actual, structs)
            if actual.kind == TypeKind.Fn:
                actual_family: sview = fn_error_family_of(actual, structs)
                return actual_family if actual_family != ""
            match expression:
                Expr.Lambda(lambda_params, lambda_body, lambda_line):
                    lambda_family: sview = fn_error_family_at(lambda_line.line, structs)
                    return lambda_family if lambda_family != ""
                Expr.Ident(callable_name, callable_line):
                    callable_index: i64 = function_index_of(fns, "", callable_name)
                    if callable_index >= 0 and fns.is_error[callable_index.usize()]:
                        return line_error_set_name(structs.error_fn_lines, structs.error_fn_set_names, fns.lines[callable_index.usize()])
                _:
                    pass
            return ""




        # Infer the concrete family for an `errorset R` generic from an argument whose
        # declared parameter mentions R. This is the errorset analogue of infer_generic_args:
        # ordinary type bindings remain in the returned darray, while the family is kept as a
        # source selector for specialization and ABI construction.
        def infer_generic_error_family(slot: usize, arguments: darray[Expr]&, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&) -> sview can[Abort.Panic, Memory.Allocate]:
            wanted_family: sview = generic_error_param_at(generics, slot)
            return "" if wanted_family == ""
            match generics.decls[slot]:
                Decl.Func(error_generic_name, error_generic_params, error_generic_return, error_generic_body, error_generic_effects, error_generic_decorators, error_generic_line):
                    limit: usize = error_generic_params.count if error_generic_params.count < arguments.count else arguments.count
                    for position in 0..<limit |wanted_family, arguments, local_scope, fns, structs, generics|:
                        pattern: ValueType = parameter_value_type(error_generic_params[position].type_expression, structs)
                        pattern_family: mutable sview = ""
                        pattern_family <- error_union_family_of(pattern, structs) if pattern.kind == TypeKind.ErrorUnion
                        if pattern.kind == TypeKind.Fn:
                            pattern_family <- fn_error_family_of(pattern, structs)
                            pattern_return: ValueType = fn_return_type_of(pattern, structs)
                            if pattern_family == "":
                                pattern_family <- error_union_family_of(pattern_return, structs) if pattern_return.kind == TypeKind.ErrorUnion
                        if pattern_family == wanted_family:
                            actual_family: sview = concrete_error_family_of(arguments[position], local_scope, fns, structs, generics)
                            return actual_family if actual_family != ""
                _:
                    pass
            return ""




        # The already-declared instantiation for (base, type-argument tuple), or null.
        def instantiation_of(generics: GenericTable&, base: sview, type_args: darray[ValueType]&) -> LLVMValueRef? can[Abort.Panic]:
            for index in 0..<generics.inst_bases.count |generics, base, type_args|:
                continue if generics.inst_bases[index] != base
                continue if generics.inst_arg_count[index] != type_args.count
                astart: usize = generics.inst_arg_start[index]
                matched: mutable bool = true
                for k in 0..<type_args.count |generics, matched, astart, type_args|:
                    stored: ValueType = generics.inst_args[astart + k]
                    # Generic arguments are nominal identities, not merely ABI shapes. In
                    # particular, distinct const-enum types can both be `u8`; collapsing them
                    # here reuses the first specialization and can select the wrong static
                    # effect handler later in that body's erased direct-call graph.
                    matched <- false if not value_type_identity_equal(stored, type_args[k])
                generics.inst_handles[index] return if matched
            return null
