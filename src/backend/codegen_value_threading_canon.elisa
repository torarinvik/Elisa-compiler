# Value-threading, builtin push: `xs <- xs.push(v)` on a plain local is the value spelling of
# the statement `xs.push(v)` (STYLE_GUIDE.md section 6). The assignment form already lowers to
# the in-place push with no store, but the loop optimizations that recognize a push
# (codegen_loop_prereserve.elisa, codegen_memory_speed.elisa) look for the statement form, so
# a fill written with `<-` missed the pre-reserve and the stack buffer. Rewriting the one
# spelling into the other before codegen makes the two compile to identical machine code by
# construction (test/fixtures/value_threading_pairs/darray_push_*).
# Part of `module Backend` (see codegen.elisa).
extend Backend:
    private:
        # `xs <- xs.push(v)` with `xs` a plain name on both sides.
        def vt_push_rebind(statement: Stmt) -> bool can[Abort.Panic]:
            if statement is Stmt.Assign(target, operator, value, _):
                if operator == TokenKind.LArrow and target is Expr.Ident(target_name, _) and value is Expr.Call(callee, arguments, _, _):
                    if arguments.count == 1 and callee is Expr.Field(receiver, method, _):
                        if method == "push" and receiver is Expr.Ident(receiver_name, _):
                            return receiver_name == target_name
            return false

        def vt_has_push_rebind(statements: darray[Stmt]&) -> bool can[Abort.Panic]:
            for statement in statements:
                return true if vt_push_rebind(statement)
                match statement:
                    Stmt.Expr(expression, _):
                        if expression is Expr.Block(nested, _, _, _):
                            return true if vt_has_push_rebind(nested)
                    Stmt.Block(_, _, _, block_body, _):
                        return true if vt_has_push_rebind(block_body)
                    Stmt.If(_, then_body, else_body, _):
                        return true if vt_has_push_rebind(then_body) or vt_has_push_rebind(else_body)
                    Stmt.While(_, while_body, _):
                        return true if vt_has_push_rebind(while_body)
                    Stmt.For(_, _, _, for_body, _):
                        return true if vt_has_push_rebind(for_body)
                    Stmt.Match(_, arms, _):
                        for arm in arms:
                            return true if vt_has_push_rebind(arm.body)
                    _:
                        pass
            return false

        def vt_canonical_statements(statements: darray[Stmt]) -> darray[Stmt] can[Abort.Panic, Memory.Allocate]:
            rewritten: mutable darray[Stmt] = []
            for statement in statements |rewritten|:
                single: Stmt = vt_canonical_statement(statement)
                rewritten.push(single)
            return rewritten

        def vt_canonical_statement(statement: Stmt) -> Stmt can[Abort.Panic, Memory.Allocate]:
            match statement:
                Stmt.Assign(_, _, assign_value, assign_pos):
                    return (Ast::Stmt.Expr(assign_value, assign_pos)) if vt_push_rebind(statement)
                    return statement
                Stmt.Expr(expression, expression_pos):
                    if expression is Expr.Block(nested, block_value, captures, block_pos):
                        nested_rewritten: darray[Stmt] = vt_canonical_statements(nested)
                        return (Ast::Stmt.Expr((Ast::Expr.Block(nested_rewritten, block_value, captures, block_pos)), expression_pos))
                    return statement
                Stmt.Block(kind, clause, binding, block_body, block_pos):
                    block_rewritten: darray[Stmt] = vt_canonical_statements(block_body)
                    return (Ast::Stmt.Block(kind, clause, binding, block_rewritten, block_pos))
                Stmt.If(condition, then_body, else_body, if_pos):
                    then_rewritten: darray[Stmt] = vt_canonical_statements(then_body)
                    else_rewritten: darray[Stmt] = vt_canonical_statements(else_body)
                    return (Ast::Stmt.If(condition, then_rewritten, else_rewritten, if_pos))
                Stmt.While(while_condition, while_body, while_pos):
                    while_rewritten: darray[Stmt] = vt_canonical_statements(while_body)
                    return (Ast::Stmt.While(while_condition, while_rewritten, while_pos))
                Stmt.For(bind, variables, iterable, for_body, for_pos):
                    for_rewritten: darray[Stmt] = vt_canonical_statements(for_body)
                    return (Ast::Stmt.For(bind, variables, iterable, for_rewritten, for_pos))
                Stmt.Match(scrutinee, arms, match_pos):
                    rewritten_arms: mutable darray[Ast::MatchArm] = []
                    for arm in arms |rewritten_arms|:
                        arm_rewritten: darray[Stmt] = vt_canonical_statements(arm.body)
                        rewritten_arms.push(Ast::MatchArm{pattern: arm.pattern, body: arm_rewritten, guard: arm.guard, pos: arm.pos})
                    return (Ast::Stmt.Match(scrutinee, rewritten_arms, match_pos))
                _:
                    return statement

        # DECLARATIONS with every function that spells a push as `xs <- xs.push(v)` rewritten.
        def vt_canonical_declarations(declarations: darray[Decl]) -> darray[Decl] can[Abort.Panic, Memory.Allocate]:
            rewritten: mutable darray[Decl] = []
            for declaration in declarations |rewritten|:
                match declaration:
                    Decl.Func(function_name, params, return_type, body, effects, decorators, function_pos):
                        if vt_has_push_rebind(body):
                            body_rewritten: darray[Stmt] = vt_canonical_statements(body)
                            rewritten.push(Ast::Decl.Func(function_name, params, return_type, body_rewritten, effects, decorators, function_pos))
                        else:
                            rewritten.push(declaration)
                    Decl.Module(module_name, module_body, module_pos):
                        module_rewritten: darray[Decl] = vt_canonical_declarations(module_body)
                        rewritten.push(Ast::Decl.Module(module_name, module_rewritten, module_pos))
                    Decl.Scoped(scoped_body, scoped_pos):
                        scoped_rewritten: darray[Decl] = vt_canonical_declarations(scoped_body)
                        rewritten.push(Ast::Decl.Scoped(scoped_rewritten, scoped_pos))
                    _:
                        rewritten.push(declaration)
            return rewritten
