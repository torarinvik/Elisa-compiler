# Stage1 backend — atomic runtime calls.
# Keep these operations in one lowering so an atomic[T] call can never silently
# fall back to the ordinary, non-atomic `slot.value` implementation.

extend Backend:
    private:
        const LLVM_ATOMIC_ORDERING_MONOTONIC: i32 = 2
        const LLVM_ATOMIC_ORDERING_ACQUIRE: i32 = 4
        const LLVM_ATOMIC_ORDERING_RELEASE: i32 = 5
        const LLVM_ATOMIC_ORDERING_ACQUIRE_RELEASE: i32 = 6
        const LLVM_ATOMIC_ORDERING_SEQ_CST: i32 = 7

        const LLVM_ATOMIC_RMW_XCHG: i32 = 0
        const LLVM_ATOMIC_RMW_ADD: i32 = 1
        const LLVM_ATOMIC_RMW_SUB: i32 = 2
        const LLVM_ATOMIC_RMW_AND: i32 = 3
        const LLVM_ATOMIC_RMW_OR: i32 = 5
        const LLVM_ATOMIC_RMW_XOR: i32 = 6

        const ATOMIC_CELL_VALUE_FIELD: u32 = 0
        const ATOMIC_CMPXCHG_SUCCESS_FIELD: u32 = 1

        def atomic_runtime_call_name(name: sview) -> bool:
            return name == "load" or name == "store" or name == "exchange" or name == "compare_exchange" or name == "fetch_add" or name == "fetch_sub" or name == "fetch_or" or name == "fetch_and" or name == "fetch_xor" or name == "fence"

        def atomic_runtime_call_arity(name: sview, argument_count: usize) -> bool:
            if name == "load": return argument_count == 2
            if name == "store": return argument_count == 3
            if name == "exchange" or name == "fetch_add" or name == "fetch_sub" or name == "fetch_or" or name == "fetch_and" or name == "fetch_xor": return argument_count == 3
            if name == "compare_exchange": return argument_count == 5
            if name == "fence": return argument_count == 1
            return false

        def atomic_memory_order_argument(expression: Expr, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&) -> bool can[Abort.Panic, Memory.Allocate]:
            # The ordinary `MemoryOrder` enum has an i32 backing in the current ABI.
            # Checking its modeled width keeps same-named helpers with other signatures
            # on the ordinary overload path (the frontend has already checked nominal type).
            order_type: ValueType = expression_type(expression, local_scope, fns, structs, generics)
            return order_type.kind == TypeKind.Signed and order_type.bits == 32

        def atomic_order_name(expression: Expr) -> sview:
            match expression:
                Expr.Field(order_type_expr, order_variant, _):
                    if order_type_expr is Expr.Ident(order_type_name, _) and order_type_name == "MemoryOrder":
                        return order_variant
                _:
                    pass
            return ""

        # A recognized enum literal is compile-time evidence and must be valid for the
        # selected operation. Unknown/non-literal values retain the existing conservative
        # SeqCst fallback; dynamic order lowering is a separate feature. Silently mapping a
        # known-invalid literal (for example Release on load) to SeqCst hides a source error.
        def atomic_load_order_valid(expression: Expr) -> bool:
            name: sview = atomic_order_name(expression)
            return true if name == ""
            return name == "Relaxed" or name == "Acquire" or name == "SeqCst"

        def atomic_store_order_valid(expression: Expr) -> bool:
            name: sview = atomic_order_name(expression)
            return true if name == ""
            return name == "Relaxed" or name == "Release" or name == "SeqCst"

        def atomic_fence_order_valid(expression: Expr) -> bool:
            name: sview = atomic_order_name(expression)
            return true if name == ""
            return name == "Acquire" or name == "Release" or name == "AcqRel" or name == "SeqCst"

        def atomic_rmw_order_valid(expression: Expr) -> bool:
            name: sview = atomic_order_name(expression)
            return true if name == ""
            return name == "Relaxed" or name == "Acquire" or name == "Release" or name == "AcqRel" or name == "SeqCst"

        def atomic_compare_exchange_order_pair_valid(success: Expr, failure: Expr) -> bool:
            success_name: sview = atomic_order_name(success)
            failure_name: sview = atomic_order_name(failure)
            # Preserve the conservative dynamic fallback when either value is not a literal.
            return true if success_name == "" or failure_name == ""
            if success_name == "Relaxed": return failure_name == "Relaxed"
            if success_name == "Acquire": return failure_name == "Relaxed" or failure_name == "Acquire"
            if success_name == "Release": return failure_name == "Relaxed"
            if success_name == "AcqRel": return failure_name == "Relaxed" or failure_name == "Acquire"
            if success_name == "SeqCst": return failure_name == "Relaxed" or failure_name == "Acquire" or failure_name == "SeqCst"
            return false

        def atomic_load_ordering(expression: Expr) -> i32:
            match atomic_order_name(expression):
                "Relaxed": return LLVM_ATOMIC_ORDERING_MONOTONIC
                "Acquire": return LLVM_ATOMIC_ORDERING_ACQUIRE
                "SeqCst": return LLVM_ATOMIC_ORDERING_SEQ_CST
                _: return LLVM_ATOMIC_ORDERING_SEQ_CST

        def atomic_store_ordering(expression: Expr) -> i32:
            match atomic_order_name(expression):
                "Relaxed": return LLVM_ATOMIC_ORDERING_MONOTONIC
                "Release": return LLVM_ATOMIC_ORDERING_RELEASE
                "SeqCst": return LLVM_ATOMIC_ORDERING_SEQ_CST
                _: return LLVM_ATOMIC_ORDERING_SEQ_CST

        def atomic_rmw_ordering(expression: Expr) -> i32:
            match atomic_order_name(expression):
                "Relaxed": return LLVM_ATOMIC_ORDERING_MONOTONIC
                "Acquire": return LLVM_ATOMIC_ORDERING_ACQUIRE
                "Release": return LLVM_ATOMIC_ORDERING_RELEASE
                "AcqRel": return LLVM_ATOMIC_ORDERING_ACQUIRE_RELEASE
                "SeqCst": return LLVM_ATOMIC_ORDERING_SEQ_CST
                _: return LLVM_ATOMIC_ORDERING_SEQ_CST

        def atomic_fence_ordering(expression: Expr) -> i32:
            match atomic_order_name(expression):
                "Acquire": return LLVM_ATOMIC_ORDERING_ACQUIRE
                "Release": return LLVM_ATOMIC_ORDERING_RELEASE
                "AcqRel": return LLVM_ATOMIC_ORDERING_ACQUIRE_RELEASE
                "SeqCst": return LLVM_ATOMIC_ORDERING_SEQ_CST
                _: return LLVM_ATOMIC_ORDERING_SEQ_CST

        def atomic_compare_exchange_orderings(success: Expr, failure: Expr) -> (success_order: i32, failure_order: i32):
            success_name: sview = atomic_order_name(success)
            failure_name: sview = atomic_order_name(failure)
            # The semantic front end validates constant order pairs. Runtime or
            # malformed enum values take the safe, stronger pair rather than
            # generating invalid LLVM IR.
            if success_name == "Relaxed" and failure_name == "Relaxed":
                return (LLVM_ATOMIC_ORDERING_MONOTONIC, LLVM_ATOMIC_ORDERING_MONOTONIC)
            if success_name == "Acquire" and (failure_name == "Relaxed" or failure_name == "Acquire"):
                return (LLVM_ATOMIC_ORDERING_ACQUIRE, LLVM_ATOMIC_ORDERING_MONOTONIC if failure_name == "Relaxed" else LLVM_ATOMIC_ORDERING_ACQUIRE)
            if success_name == "Release" and failure_name == "Relaxed":
                return (LLVM_ATOMIC_ORDERING_RELEASE, LLVM_ATOMIC_ORDERING_MONOTONIC)
            if success_name == "AcqRel" and (failure_name == "Relaxed" or failure_name == "Acquire"):
                return (LLVM_ATOMIC_ORDERING_ACQUIRE_RELEASE, LLVM_ATOMIC_ORDERING_MONOTONIC if failure_name == "Relaxed" else LLVM_ATOMIC_ORDERING_ACQUIRE)
            if success_name == "SeqCst" and (failure_name == "Relaxed" or failure_name == "Acquire" or failure_name == "SeqCst"):
                failure_order: i32 = LLVM_ATOMIC_ORDERING_MONOTONIC if failure_name == "Relaxed" else LLVM_ATOMIC_ORDERING_ACQUIRE if failure_name == "Acquire" else LLVM_ATOMIC_ORDERING_SEQ_CST
                return (LLVM_ATOMIC_ORDERING_SEQ_CST, failure_order)
            return (LLVM_ATOMIC_ORDERING_SEQ_CST, LLVM_ATOMIC_ORDERING_SEQ_CST)

        def atomic_value_supports_load_store(value_type: ValueType) -> bool:
            return is_integer_type(value_type) or value_type.kind == TypeKind.Bool or value_type.kind == TypeKind.Float or type_is_pointer(value_type) or value_type.kind == TypeKind.Fn

        def atomic_value_supports_compare_exchange(value_type: ValueType) -> bool:
            return is_integer_type(value_type) or value_type.kind == TypeKind.Bool or type_is_pointer(value_type) or value_type.kind == TypeKind.Fn

        def atomic_runtime_rmw_opcode(name: sview) -> i32:
            match name:
                "exchange": return LLVM_ATOMIC_RMW_XCHG
                "fetch_add": return LLVM_ATOMIC_RMW_ADD
                "fetch_sub": return LLVM_ATOMIC_RMW_SUB
                "fetch_and": return LLVM_ATOMIC_RMW_AND
                "fetch_or": return LLVM_ATOMIC_RMW_OR
                "fetch_xor": return LLVM_ATOMIC_RMW_XOR
                _: return -1

        def emit_atomic_runtime_call(name: sview, arguments: darray[Expr]&, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef, handled: mutable bool&) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            handled <- false
            return null if not atomic_runtime_call_name(name) or not atomic_runtime_call_arity(name, arguments.count)

            if name == "fence":
                return null if not atomic_memory_order_argument(arguments[0], local_scope, fns, structs, generics)
                handled <- true
                return null if not atomic_fence_order_valid(arguments[0])
                return LLVMBuildFence(builder, atomic_fence_ordering(arguments[0]), 0, "")

            return null if arguments.count == 0
            first_type: ValueType = expression_type(arguments[0], local_scope, fns, structs, generics)
            return null if first_type.kind != TypeKind.Ref
            cell_type: ValueType = ref_target_of(first_type, structs)
            return null if cell_type.kind != TypeKind.Struct or structs.names[cell_type.bits.usize()] != "atomic"
            # MemoryOrder is an ordinary enum with a fixed i32 representation. Calls
            # whose order argument has another representation are user overloads, not
            # the atomic runtime API, and must continue through normal name resolution.
            if name == "load": return null if not atomic_memory_order_argument(arguments[1], local_scope, fns, structs, generics)
            if name == "store" or name == "exchange" or name == "fetch_add" or name == "fetch_sub" or name == "fetch_or" or name == "fetch_and" or name == "fetch_xor":
                return null if not atomic_memory_order_argument(arguments[2], local_scope, fns, structs, generics)
            if name == "compare_exchange":
                return null if not atomic_memory_order_argument(arguments[3], local_scope, fns, structs, generics) or not atomic_memory_order_argument(arguments[4], local_scope, fns, structs, generics)

            # Once a canonical atomic call shape is known to target atomic[T], every
            # path below either emits an LLVM atomic instruction or declines; never call
            # the plain generic body, which would race on `slot.value`. Wrong-arity calls
            # were left to normal overload resolution above, since user functions may
            # legitimately reuse these operation names with different signatures.
            handled <- true
            if name == "load": return null if not atomic_load_order_valid(arguments[1])
            if name == "store": return null if not atomic_store_order_valid(arguments[2])
            if name == "exchange" or name == "fetch_add" or name == "fetch_sub" or name == "fetch_or" or name == "fetch_and" or name == "fetch_xor":
                return null if not atomic_rmw_order_valid(arguments[2])
            if name == "compare_exchange":
                return null if not atomic_compare_exchange_order_pair_valid(arguments[3], arguments[4])
            value_index: i64 = field_index_of(structs, cell_type.bits.usize(), "value")
            return null if value_index < 0
            value_type: ValueType = copied_type(structs.field_types[structs.field_start[cell_type.bits.usize()] + value_index.usize()])
            value_llvm: LLVMTypeRef = llvm_type_of(value_type, structs, ctx)
            # LLVM rejects atomic i1 even though Elisa bool occupies one byte in
            # aggregate storage. Perform atomic operations on that byte and convert
            # only at the API boundary.
            storage_llvm: LLVMTypeRef = LLVMInt8TypeInContext(ctx) if value_type.kind == TypeKind.Bool else value_llvm
            cell_llvm: LLVMTypeRef = llvm_type_of(cell_type, structs, ctx)
            value_alignment: u32 = LLVMABIAlignmentOfType(structs.target_data, storage_llvm)
            return null if value_alignment == 0 or not atomic_value_supports_load_store(value_type)

            if emit_expression(arguments[0], first_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is cell_pointer:
                value_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, cell_llvm, cell_pointer, value_index.u32(), "atomic.value.ptr")

                if name == "load":
                    return null if arguments.count != 2
                    loaded: LLVMValueRef = LLVMBuildLoad2(builder, storage_llvm, value_pointer, "atomic.load")
                    LLVMSetOrdering(loaded, atomic_load_ordering(arguments[1]))
                    LLVMSetAlignment(loaded, value_alignment)
                    return LLVMBuildTrunc(builder, loaded, value_llvm, "atomic.load.bool") if value_type.kind == TypeKind.Bool else loaded

                if name == "store":
                    return null if arguments.count != 3
                    if emit_expression(arguments[1], value_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is stored_value:
                        atomic_stored_value: LLVMValueRef = LLVMBuildZExt(builder, stored_value, storage_llvm, "atomic.store.bool") if value_type.kind == TypeKind.Bool else stored_value
                        stored: LLVMValueRef = LLVMBuildStore(builder, atomic_stored_value, value_pointer)
                        LLVMSetOrdering(stored, atomic_store_ordering(arguments[2]))
                        LLVMSetAlignment(stored, value_alignment)
                        return stored
                    return null

                if name == "compare_exchange":
                    return null if arguments.count != 5 or not atomic_value_supports_compare_exchange(value_type)
                    if emit_expression(arguments[1], value_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is expected_value:
                        if emit_expression(arguments[2], value_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is desired_value:
                            atomic_expected: LLVMValueRef = LLVMBuildZExt(builder, expected_value, storage_llvm, "atomic.cmpxchg.bool.expected") if value_type.kind == TypeKind.Bool else expected_value
                            atomic_desired: LLVMValueRef = LLVMBuildZExt(builder, desired_value, storage_llvm, "atomic.cmpxchg.bool.desired") if value_type.kind == TypeKind.Bool else desired_value
                            orders: (success_order: i32, failure_order: i32) = atomic_compare_exchange_orderings(arguments[3], arguments[4])
                            cmpxchg: LLVMValueRef = LLVMBuildAtomicCmpXchg(builder, value_pointer, atomic_expected, atomic_desired, orders.success_order, orders.failure_order, 0)
                            return LLVMBuildExtractValue(builder, cmpxchg, ATOMIC_CMPXCHG_SUCCESS_FIELD, "atomic.cmpxchg.ok")
                        return null
                    return null

                if name == "exchange" or name == "fetch_add" or name == "fetch_sub" or name == "fetch_or" or name == "fetch_and" or name == "fetch_xor":
                    return null if arguments.count != 3
                    opcode: i32 = atomic_runtime_rmw_opcode(name)
                    is_exchange: bool = name == "exchange"
                    return null if opcode < 0 or (is_exchange and not atomic_value_supports_compare_exchange(value_type)) or (not is_exchange and not is_integer_type(value_type))
                    if emit_expression(arguments[1], value_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is rmw_value:
                        atomic_rmw_value: LLVMValueRef = LLVMBuildZExt(builder, rmw_value, storage_llvm, "atomic.exchange.bool") if value_type.kind == TypeKind.Bool else rmw_value
                        atomic_previous: LLVMValueRef = LLVMBuildAtomicRMW(builder, opcode, value_pointer, atomic_rmw_value, atomic_rmw_ordering(arguments[2]), 0)
                        return LLVMBuildTrunc(builder, atomic_previous, value_llvm, "atomic.exchange.bool.result") if value_type.kind == TypeKind.Bool else atomic_previous
                    return null
            return null
