# Stage1 backend — PACKED AST STORE facts: which types are (or contain) a packed AST node,
# which bodies create or reach a store, and the hidden store parameter that follows from it.
# Part of `module Backend` (see codegen.elisa).

extend Backend:
    private:

            # AST handles are packed enums whose payload side tables live outside the
            # value representation. Returning one must keep those nested buffers in a
            # region owned by the caller. Optional AST handles carry the same rule.
        def ast_value_needs_arena(value_type: ValueType, structs: mutable StructTable&) -> bool can[Abort.Panic]:
            can Abort.Panic:
                if value_type.kind == TypeKind.Optional:
                    return ast_value_needs_arena(optional_payload_of(value_type, structs), structs)
                # Packed-enum values are handles into side-table-backed storage. The
                # metadata name is normalized differently across module/extend forms,
                # so key the ABI rule on representation rather than spelling.
                return value_type.kind == TypeKind.PackedEnum




            # The recursive AST hierarchy is a compiler-internal packed value. Stage0 threads
            # its shared store through the parser and backend call graph as a hidden trailing
            # parameter. Keep the first ABI slice deliberately explicit here: the semantic
            # implementation later refines this to transitive per-root needs, while the stage1
            # self-host corpus has one compiler AST store (`Ast.Node`).
            # A function which directly invokes the parser/backend must own the shared AST
            # store before the first call. Stage0 computes this transitively from the call graph;
            # stage1 declarations are emitted in one pass, so retain the small structural walk
            # here and let the declaration pass mark the caller before it builds its ABI.
            # A bare AST hierarchy enum name whose CONSTRUCTION allocates into the packed store.
        def is_ast_enum_name(name: sview, structs: StructTable&) -> bool can[Abort.Panic]:
            can Abort.Panic:
                enum_index: i64 = packed_index_of(structs, name)
                # `packed_is_ast_root` answers whether an enum uses the AoS packed-store
                # representation. It is intentionally true for every user packed enum, so it
                # is not an AST-hierarchy predicate. Confusing the two made an ordinary
                # recursive `enum Node` acquire the compiler's hidden AST-store parameter;
                # a helper constructing it then required a store from its caller and stage1
                # declined a program that stage0 lowered with a local store. Only the sealed
                # zero-variant Node row and explicit Node refinements are compiler AST.
                true return if packed_is_ast_refinement(structs, enum_index)
                return packed_is_ast_root_row(structs, enum_index)



            # Syntactic test for a packed-AST CONSTRUCTOR call `Ast::Expr.Ident(…)` /
            # `Stmt.VarDecl(…)`: the callee is `NS::Enum.Variant` or `Enum.Variant` where Enum is
            # an AST hierarchy root. Building the node writes the AoS store, so a global helper
            # that constructs AST (e.g. `machine_from_is_condition`) needs the store threaded even
            # with no AST parameter and no frontend call.
        def callee_is_ast_constructor(callee: Expr, structs: StructTable&) -> bool can[Abort.Panic]:
            can Abort.Panic:
                match callee:
                    Expr.Field(ctor_head, ctor_variant, ctor_field_line):
                        match ctor_head:
                            Expr.Scope(ctor_scope_base, ctor_enum, ctor_scope_line):
                                return is_ast_enum_name(ctor_enum, structs)
                            _:
                                pass
                        match ctor_head:
                            Expr.Ident(ctor_enum_ident, ctor_enum_ident_line):
                                return is_ast_enum_name(ctor_enum_ident, structs)
                            _:
                                pass
                    _:
                        pass
                return false



        def expression_mentions_ast_store_call(expression: Expr, structs: StructTable&) -> bool can[Abort.Panic]:
            can Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, line):
                        match callee:
                            Expr.Ident(name, name_line):
                                true return if name == "frontend_parser_parse_file" or name == "frontend_parse"
                                # Pymodule report helpers traverse packed AST values through
                                # composed helper calls, so the hidden store requirement must
                                # propagate through their complete call chain.
                                true return if sview_len(name) > 14.usize() and sview_matches_prefix(name, "emit_pymodule_", 0, 14)
                            _:
                                pass
                        match callee:
                            Expr.Scope(scope_head, scope_name, scope_line):
                                match scope_head:
                                    Expr.Ident(scope_owner, scope_owner_line):
                                        true return if scope_owner == "Backend" and (scope_name == "emit_module" or scope_name == "emit_module_with_debug_trace")
                                    _:
                                        pass
                            _:
                                pass
                        true return if callee_is_ast_constructor(callee, structs)
                        true return if expression_mentions_ast_store_call(callee, structs)
                        for argument in arguments |expression|:
                            true return if expression_mentions_ast_store_call(argument, structs)
                        return false
                    _:
                        pass
                match expression:
                    Expr.Field(field_object, field_name, field_line):
                        return expression_mentions_ast_store_call(field_object, structs)
                    _:
                        pass
                match expression:
                    Expr.Scope(scope_base, scope_name, scope_line):
                        return expression_mentions_ast_store_call(scope_base, structs)
                    _:
                        pass
                match expression:
                    Expr.Index(index_object, index_value, index_line):
                        return expression_mentions_ast_store_call(index_object, structs) or expression_mentions_ast_store_call(index_value, structs)
                    _:
                        pass
                match expression:
                    Expr.Binary(binary_left, binary_operator, binary_right, binary_line):
                        return expression_mentions_ast_store_call(binary_left, structs) or expression_mentions_ast_store_call(binary_right, structs)
                    _:
                        pass
                match expression:
                    Expr.Unary(unary_operator, unary_operand, unary_line):
                        return expression_mentions_ast_store_call(unary_operand, structs)
                    _:
                        pass
                match expression:
                    Expr.Paren(paren_inner, paren_line):
                        return expression_mentions_ast_store_call(paren_inner, structs)
                    _:
                        pass
                match expression:
                    Expr.If(if_condition, if_then, if_else, if_line):
                        return expression_mentions_ast_store_call(if_condition, structs) or expression_mentions_ast_store_call(if_then, structs) or expression_mentions_ast_store_call(if_else, structs)
                    _:
                        pass
                return false



        # Does this body CREATE ITS OWN packed store (`s: Node.Store[Local] = Node.Store(r)`)?
        #
        # A function that constructs AST nodes normally has the caller's store threaded in,
        # because the handles it builds are rows in THAT store. One that declares a store of
        # its own is the opposite case: it owns the rows, nothing crosses the boundary, and
        # the hidden parameter is not just unnecessary but unsatisfiable -- an ordinary
        # `main` has no store to hand over, so the CALL declined and took every caller with
        # it. stage0 lowers such a function with no hidden parameter at all.
        def statements_declare_local_packed_store(statements: darray[Stmt]&, structs: mutable StructTable&) -> bool can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic, Memory.Allocate:
                for statement in statements:
                    match statement:
                        Stmt.VarDecl(store_decl_name, store_decl_type, store_decl_value, store_decl_line):
                            match store_decl_type:
                                Expr.Index(store_decl_head, store_decl_state, store_decl_index_line):
                                    match store_decl_head:
                                        Expr.Field(_, _, _):
                                            true return if annotation_index_store_value_type(store_decl_head, structs).kind == TypeKind.PackedStore
                                        _:
                                            pass
                                _:
                                    pass
                        _:
                            pass
                    # Nested blocks count: the store is usually declared inside `region r(N):`.
                    match statement:
                        Stmt.Block(store_block_kind, store_block_clause, store_block_binding, store_block_body, store_block_line):
                            true return if statements_declare_local_packed_store(store_block_body, structs)
                        _:
                            pass
                    match statement:
                        Stmt.If(store_if_condition, store_if_then, store_if_else, store_if_line):
                            true return if statements_declare_local_packed_store(store_if_then, structs) or statements_declare_local_packed_store(store_if_else, structs)
                        _:
                            pass
                    match statement:
                        Stmt.While(store_while_condition, store_while_body, store_while_line):
                            true return if statements_declare_local_packed_store(store_while_body, structs)
                        _:
                            pass
                    match statement:
                        Stmt.For(store_for_bind, store_for_variables, store_for_iterable, store_for_body, store_for_line):
                            true return if statements_declare_local_packed_store(store_for_body, structs)
                        _:
                            pass
                return false




        def statements_mention_ast_store_call(statements: darray[Stmt]&, structs: StructTable&) -> bool can[Abort.Panic]:
            can Abort.Panic:
                for statement in statements:
                    match statement:
                        Stmt.Expr(expression, line):
                            true return if expression_mentions_ast_store_call(expression, structs)
                        _:
                            pass
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            true return if expression_mentions_ast_store_call(value, structs)
                        _:
                            pass
                    match statement:
                        Stmt.Assign(target, operator, value, line):
                            true return if expression_mentions_ast_store_call(target, structs) or expression_mentions_ast_store_call(value, structs)
                        _:
                            pass
                    match statement:
                        Stmt.Return(value_opt, line):
                            if value_opt is value:
                                true return if expression_mentions_ast_store_call(value, structs)
                        _:
                            pass
                    match statement:
                        Stmt.If(condition, then_body, else_body, line):
                            true return if expression_mentions_ast_store_call(condition, structs) or statements_mention_ast_store_call(then_body, structs) or statements_mention_ast_store_call(else_body, structs)
                        _:
                            pass
                    match statement:
                        Stmt.While(condition, body, line):
                            true return if expression_mentions_ast_store_call(condition, structs) or statements_mention_ast_store_call(body, structs)
                        _:
                            pass
                    match statement:
                        Stmt.For(bind, variables, iterable, body, line):
                            true return if expression_mentions_ast_store_call(iterable, structs) or statements_mention_ast_store_call(body, structs)
                        _:
                            pass
                    match statement:
                        Stmt.Block(kind, clause, binding, body, line):
                            true return if statements_mention_ast_store_call(body, structs)
                        _:
                            pass
                    match statement:
                        Stmt.Match(scrutinee, arms, line):
                            true return if expression_mentions_ast_store_call(scrutinee, structs)
                            for arm in arms:
                                true return if expression_mentions_ast_store_call(arm.guard, structs) or statements_mention_ast_store_call(arm.body, structs)
                        _:
                            pass
                return false



        # `module Parser:` and `module Backend:` are the COMPILER'S OWN, and every member of
        # them threads the hidden AST store. Matching on the bare name alone claimed any
        # user module called `Backend` as well: its functions were declared with a store
        # parameter nothing passes, so every call to one declined -- a program was broken by
        # its choice of module name, with no diagnostic naming the collision.
        #
        # `structs.ast_refinement_names` is filled only from `__compiler_ast_refinement`,
        # which the parser stamps solely on the sealed `Node` hierarchy (is_builtin_ast_node).
        # It is therefore the exact test for "this program IS the compiler", and gating the
        # name match on it leaves the compiler's own build unchanged.
        def function_needs_ast_store(owner: sview, name: sview, structs: StructTable&) -> bool can[Abort.Panic]:
            false return if structs.ast_refinement_names.count == 0
            if owner == "Parser" or owner == "Backend":
                return true
            if name == "frontend_parser_parse_file" or name == "frontend_parse":
                return true
            return false



        # A type that IS, or transitively contains, a packed AST node (`Ast::Stmt`,
        # `Ast::Expr`, …). Reading/matching such a value goes through the AoS store, so a
        # GLOBAL helper taking one (e.g. `with_decl_name(statement: Ast::Stmt)`) must have the
        # store threaded even though its body never CONSTRUCTS a node. Follows darray element,
        # ref target, and optional payload so `darray[Ast::Stmt]&` params count too.
        def type_is_or_contains_packed_ast(value_type: ValueType, depth: i64, structs: mutable StructTable&) -> bool can[Abort.Panic]:
            can Abort.Panic:
                false return if depth > 6
                if value_type.kind == TypeKind.PackedEnum:
                    enum_index: i64 = value_type.bits.i64()
                    root: i64 = packed_root_index_of(structs, enum_index)
                    true return if root >= 0 and (packed_is_ast_root_row(structs, root) or packed_is_dynamic_aos_enum(structs, enum_index) or packed_is_ast_refinement(structs, enum_index))
                    # Any packed/AoS enum in a signature needs the store threaded for the same
                    # reason the AST does: the value is a u32 handle into the CALLER's store,
                    # so the callee cannot create one of its own — a locally created store
                    # would index the handle into empty memory. stage0 lowers exactly this
                    # (`kind(i32 handle, %Tree__Store)`); stage1 previously recognized only the
                    # compiler AST marker after generic user hierarchies were separated from it.
                    true return if packed_is_ast_root(structs, enum_index)
                if value_type.kind == TypeKind.DArray:
                    return type_is_or_contains_packed_ast(darray_element_of(value_type, structs), depth + 1, structs)
                if value_type.kind == TypeKind.Array:
                    return type_is_or_contains_packed_ast(array_element_of(value_type, structs), depth + 1, structs)
                if value_type.kind == TypeKind.Ref:
                    return type_is_or_contains_packed_ast(ref_target_of(value_type, structs), depth + 1, structs)
                if value_type.kind == TypeKind.Optional:
                    return type_is_or_contains_packed_ast(optional_payload_of(value_type, structs), depth + 1, structs)
                if value_type.kind == TypeKind.ErrorUnion:
                    return type_is_or_contains_packed_ast(error_union_payload_of(value_type, structs), depth + 1, structs)
                # A STRUCT whose fields reach an AST node — `file: Ast::File&`, whose `top_decls`
                # is a `darray[Decl]`. Without this a function that touches AST nodes only THROUGH
                # a struct parameter got no hidden store, so `runtime.active_store_enum` stayed -1
                # and every `match` on such a node declined (this is what dropped
                # sg_enum_variant_names). Adding an unused `Ast::Decl` parameter made the same
                # function compile, which is how the store — not the type — was identified as the
                # gate. The existing depth cap also terminates a struct that reaches itself
                # through a ref field.
                if value_type.kind == TypeKind.Struct:
                    struct_slot: usize = value_type.bits.usize()
                    if struct_slot < structs.field_start.count:
                        field_base: usize = structs.field_start[struct_slot]
                        field_total: usize = structs.field_count[struct_slot]
                        for field_offset in 0..<field_total |field_base, depth, structs|:
                            true return if type_is_or_contains_packed_ast(copied_type(structs.field_types[field_base + field_offset]), depth + 1, structs)
                return false



        def params_include_packed_ast(param_types: darray[ValueType]&, structs: mutable StructTable&) -> bool can[Abort.Panic]:
            can Abort.Panic:
                for param_type in param_types |structs|:
                    true return if type_is_or_contains_packed_ast(param_type, 0, structs)
                return false



        # Hidden arena ABI count. The packed store is passed first and the independent
        # caller-owned region parameters follow it, exactly as stage0 lowers FuncType.RegionParams.
        # `owner`/`name` remain in the helper signature because callers also use it for extern and
        # synthesized declarations; the source signature, not the namespace, determines the count.
        def frontend_arena_count(owner: sview, name: sview, signature_arena_slots: usize, wants_store: bool) -> usize can[Abort.Panic]:
            can Abort.Panic:
                _ = owner
                _ = name
                _ = wants_store
                return signature_arena_slots
