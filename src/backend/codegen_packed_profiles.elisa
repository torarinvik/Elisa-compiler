# Per-enum packed profile identity. Layout and runtime dispatch must use the
# hierarchy root's owner and name, because different roots can coexist.
extend Backend:
    private:
        # -1 means no explicit profile. Both dense profiles use index/SOA
        # handles, although their payload-prefix policies differ.
        def packed_explicit_profile_mode(annotations: darray[Ast::EnumAnnotation]&, owner: sview, name: sview) -> i32 can[Abort.Panic]:
            for annotation in annotations |owner, name|:
                continue if annotation.line != 3900000041 or annotation.module != owner or annotation.owner != name
                return 0 if annotation.name == "canonical"
                return 1 if annotation.name == "retained_reads" or annotation.name == "build_heavy"
            return -1

        def remember_packed_profile(annotation: Ast::EnumAnnotation, structs: mutable StructTable&) -> void can[Abort.Panic, Memory.Allocate]:
            return if annotation.line != 3900000041
            return if annotation.name != "canonical" and annotation.name != "retained_reads" and annotation.name != "build_heavy"
            structs.packed_layouts.profile_names.push(annotation.owner)
            structs.packed_layouts.profile_modules.push(annotation.module)
            structs.packed_layouts.profile_values.push(annotation.name)

        # Refined enum values use their root store, so resolve the profile on the
        # root rather than the member. A missing annotation remains distinguishable
        # from an explicit canonical selection.
        def packed_profile_at_slot[@r](structs: StructTable& @r, slot: i64) -> sview @r can[Abort.Panic]:
            return "" if slot < 0 or slot.usize() >= structs.packed_enums.packed_names.count
            owner: sview = packed_hierarchy_module_at_slot(structs, slot)
            root: sview = packed_hierarchy_root_name_at_slot(structs, slot)
            for index in 0..<structs.packed_layouts.profile_names.count |structs, owner, root|:
                if structs.packed_layouts.profile_names[index] == root and structs.packed_layouts.profile_modules[index] == owner:
                    return structs.packed_layouts.profile_values[index]
            return ""

        def packed_mode_at_slot(structs: StructTable&, slot: i64) -> i32 can[Abort.Panic]:
            profile: sview = packed_profile_at_slot(structs, slot)
            return 1 if profile == "retained_reads" or profile == "build_heavy"
            return 0 if profile == "canonical"
            return 2 if packed_is_dynamic_aos_enum(structs, slot)
            return 0
