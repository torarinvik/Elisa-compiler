        def submit_group_runtime_api_declaration_name(declaration: Decl) -> sview can[Abort.Panic]:
            match declaration:
                Decl.Func(name, _, _, body, _, decorators, _):
                    "" return if not any decorator in decorators where decorator.name == "internal"
                    if name == "task_group_new":
                        return name if submit_group_statement_list_calls_name(body, "task_group_new_raw")
                    if name == "task_group_wait_all":
                        return name if submit_group_statement_list_calls_name(body, "task_group_wait_all_raw") and submit_group_statement_list_calls_name(body, "ctx_task_group_release_all")
                    if name == "task_group_add":
                        return name if submit_group_statement_list_calls_name(body, "task_group_add_raw") and submit_group_statement_list_calls_name(body, "ctx_task_group_push_state")
                    if name == "task_group_new_raw":
                        return name
                    if name == "task_group_add_raw":
                        return name if submit_group_statement_list_calls_name(body, "ctx_concurrency_alloc")
                    if name == "task_group_wait_all_raw":
                        return name if submit_group_statement_list_calls_name(body, "ctx_pool_wait_record")
                    if name == "ctx_task_group_push_state":
                        return name if submit_group_statement_list_calls_name(body, "ctx_concurrency_alloc")
                    if name == "ctx_task_group_release_all":
                        return name if submit_group_statement_list_calls_name(body, "ctx_concurrency_work1_release")
                    if name == "ctx_pool_wait_record":
                        return name if submit_group_statement_list_calls_name(body, "ctx_pool_wait")
                    return ""
                _:
                    return ""


