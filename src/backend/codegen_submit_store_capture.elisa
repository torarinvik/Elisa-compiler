                        _:
                            pass
                    if not definitely_not_task_group:
                        value_type: ValueType = expression_type(value, local_scope, fns, structs, generics)
                        true return if value_type.kind == TypeKind.Struct and value_type.bits.usize() < structs.records.names.count and structs.records.names[value_type.bits.usize()] == "TaskGroup"
            return false


        # Resolve a one-argument submit like an ordinary direct call: source-order first among
        # typed matches. A module member shadows a top-level declaration. ABI checks happen
        # after selection, so an unsupported first match declines instead of falling through to
        # a later overload that ordinary calls would not select.
        def submit_worker_resolve_owner(owner: sview, name: sview, argument: Expr, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, local_scope: mutable Scope&, out_candidate_count: mutable usize&, out_selected_index: mutable i64&) -> void can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic, Memory.Allocate:
                out_candidate_count <- 0.usize()
                out_selected_index <- -1
                argument_type_ready: mutable bool = false
                argument_type: mutable ValueType = unmodeled_type()
                index_cursor: mutable i64 = first_function_named(fns, name)
                while index_cursor >= 0 and out_selected_index < 0 |index_cursor, fns, owner, name, argument, structs, generics, local_scope, out_candidate_count, out_selected_index, argument_type_ready, argument_type|:
                    index: usize = index_cursor.usize()
                    index_cursor <- next_function_named(fns, name, index_cursor)
                    continue if index >= fns.names.count or index >= fns.owners.count or index >= fns.param_count.count
                    continue if fns.names[index] != name or fns.owners[index] != owner or fns.param_count[index] != 1.usize()
                    out_candidate_count <- out_candidate_count + 1.usize()
                    if not argument_type_ready:
                        argument_type <- expression_type(argument, local_scope, fns, structs, generics)
                        argument_type_ready <- true
                    # Direct calls choose the first source-ordered type match. Keep the
                    # same rule for submit while caching the one argument's inferred type.
                    out_selected_index <- index.i64() if out_selected_index < 0 and overload_candidate_matches_argument(index, 0.usize(), argument, argument_type, fns, structs)


        def submit_worker_index(name: sview, argument: Expr, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, local_scope: mutable Scope&) -> i64 can[Abort.Panic, Memory.Allocate]:
            owner: sview = structs.visibility.current_owner
            if owner != "":
                owner_candidates: mutable usize = 0
                selected: mutable i64 = -1
                submit_worker_resolve_owner(owner, name, argument, fns, structs, generics, local_scope, owner_candidates, selected)
                if owner_candidates > 0.usize():
                    return selected if selected >= 0
