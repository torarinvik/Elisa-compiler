# Stage1 backend — store-capturing `submit` (docs/stage1_performance.md, round 8).
#
# A worker that reads the AST takes the store as a hidden trailing parameter that source cannot
# name, and `pool_submit1`'s `fn(A) -> R` has no slot for it. `submit worker(arg)` of such a worker
# therefore CAPTURES the submitting scope's active store, as stage0 does
# (Elisa-core semantic/analyzer_submit_store_capture.go):
#
#     capture = malloc({A, Store}); capture <- {arg, active_store}
#     pool_submit1[uintptr, R](pool, __submit_store_thunk, capture as uintptr)
#     def __submit_store_thunk(bits: uintptr) -> R:
#         {arg, store} = load bits; free(bits); return worker(arg, store)
#
# The store is borrowed by the worker and must stay alive and read-only until its pool or nursery
# group joins. This lowering declines submissions without a provable structured join or when the
# active region outlives the join. The capture block is freed by its thunk before the worker runs.
# Part of `module Backend` (see codegen.elisa).

extend Backend:
    private:
        struct SubmitGroupWindow:
            group_name: mutable sview
            declaration_row: mutable usize
            join_row: mutable usize
            valid: mutable bool


        struct SubmitGroupNameSet:
            first: sview
            second: sview
            third: sview
            fail_closed_nested_scopes: bool


        def submit_group_empty_window() -> SubmitGroupWindow:
            return SubmitGroupWindow{group_name: "", declaration_row: 0.usize(), join_row: 0.usize(), valid: false}


        def submit_group_name_in_names(name: sview, names: darray[sview]) -> bool:
            for candidate in names:
                return true if candidate == name
            return false


        def submit_group_name_in_set(name: sview, names: SubmitGroupNameSet) -> bool:
            return name == names.first or name == names.second or name == names.third


        def submit_group_name_set_intersects(names: SubmitGroupNameSet, candidates: darray[sview]) -> bool:
            for candidate in candidates:
                true return if submit_group_name_in_set(candidate, names)
            return false


        def submit_group_ascii_identifier_char(text: sview, offset: usize) -> bool:
            return false if offset >= sview_len(text)
            character: u8 = sview_at(text, offset)
            return character == 95 or character == 36 or character in 48..57 or character in 65..90 or character in 97..122


        def submit_group_raw_text_mentions_name(text: sview, name: sview) -> bool can[Abort.Panic]:
            # Pool/nursery capacity clauses are raw spans, not parsed expressions. Search
            # identifier tokens so `workers(i + 1)` retains `i` just like `workers(i)`.
            # The backend's byte scan deliberately fails closed for non-ASCII text: the
            # lexer accepts Unicode identifiers, so byte-level boundary guesses are unsafe.
            return false if name == ""
            text_length: usize = sview_len(text)
            name_length: usize = sview_len(name)
            for offset in 0..<text_length:
                return true if sview_at(text, offset) >= 128
            for offset in 0..<name_length:
                return true if sview_at(name, offset) >= 128
            for offset in 0..<text_length:
                if name_length <= text_length - offset:
                    end: usize = offset + name_length
                    if sview_matches_prefix(text, name, offset.i64(), end.i64()):
                        starts_token: mutable bool = offset == 0
                        starts_token <- not submit_group_ascii_identifier_char(text, offset - 1.usize()) if offset > 0
                        ends_token: bool = end == text_length or not submit_group_ascii_identifier_char(text, end)
                        return true if starts_token and ends_token
            return false


        def submit_group_manual_api_name_set() -> SubmitGroupNameSet:
            return SubmitGroupNameSet{first: "task_group_new", second: "task_group_add", third: "task_group_wait_all", fail_closed_nested_scopes: false}


        # Name-only recognition is not enough: a user overload or module member could make
        # the constructor/wait spelling call a different function. Require one top-level,
        # non-generic declaration for each non-generic entry point and the unique top-level
        # generic task_group_add that emit_task_group_add_value instantiates.
        def submit_group_unique_function_index(name: sview, arity: usize, fns: FnTable&, generics: GenericTable&) -> i64 can[Abort.Panic]:
            matches: mutable usize = 0
            candidate: mutable i64 = -1
            index: mutable i64 = first_function_named(fns, name)
            while index >= 0 |index, matches, candidate, fns, name|:
                return -1 if index.usize() >= fns.owners.count or index.usize() >= fns.param_count.count or index.usize() >= fns.is_extern.count or index.usize() >= fns.needs_store.count or index.usize() >= fns.needs_arena.count or index.usize() >= fns.arena_counts.count
                matches <- matches + 1.usize()
                candidate <- index
                index <- next_function_named(fns, name, index)
            generic_index: i64 = name_chain_first(generics.name_buckets, generics.name_next, generics.names, name)
            return -1 if generic_index >= 0
            return -1 if matches != 1.usize() or candidate < 0
            candidate_index: usize = candidate.usize()
            return -1 if fns.owners[candidate_index] != "" or fns.param_count[candidate_index] != arity or fns.is_extern[candidate_index] or fns.needs_store[candidate_index] or fns.needs_arena[candidate_index] or fns.arena_counts[candidate_index] != 0.usize()
            return candidate


        def submit_group_unique_generic_index(name: sview, generics: GenericTable&) -> i64 can[Abort.Panic]:
            matches: mutable usize = 0
            candidate: mutable i64 = -1
            index: mutable i64 = name_chain_first(generics.name_buckets, generics.name_next, generics.names, name)
            while index >= 0 |index, matches, candidate, generics, name|:
                return -1 if index.usize() >= generics.owners.count or index.usize() >= generics.param_count.count
                matches <- matches + 1.usize()
                candidate <- index
                index <- name_chain_next(generics.name_buckets, generics.name_next, generics.names, name, index)
            return -1 if matches != 1.usize() or candidate < 0
            candidate_index: usize = candidate.usize()
            return -1 if generics.owners[candidate_index] != "" or generics.param_count[candidate_index] != 1.usize()
            return candidate


        def submit_group_runtime_api_marker_matches(name: sview, line: u32, structs: StructTable&) -> bool can[Abort.Panic]:
            false return if structs.annotations.task_group_runtime_api_names.count != structs.annotations.task_group_runtime_api_lines.count
            for index in 0..<structs.annotations.task_group_runtime_api_names.count:
                return true if structs.annotations.task_group_runtime_api_names[index] == name and structs.annotations.task_group_runtime_api_lines[index] == line
            return false


        def submit_group_runtime_apis_are_unique(fns: FnTable&, generics: GenericTable&, structs: mutable StructTable&) -> bool can[Abort.Panic]:
            constructor_index: i64 = submit_group_unique_function_index("task_group_new", 0.usize(), fns, generics)
            wait_index: i64 = submit_group_unique_function_index("task_group_wait_all", 1.usize(), fns, generics)
            raw_constructor_index: i64 = submit_group_unique_function_index("task_group_new_raw", 0.usize(), fns, generics)
            raw_add_index: i64 = submit_group_unique_function_index("task_group_add_raw", 2.usize(), fns, generics)
            raw_wait_index: i64 = submit_group_unique_function_index("task_group_wait_all_raw", 1.usize(), fns, generics)
            push_state_index: i64 = submit_group_unique_function_index("ctx_task_group_push_state", 2.usize(), fns, generics)
            release_state_index: i64 = submit_group_unique_function_index("ctx_task_group_release_all", 1.usize(), fns, generics)
            wait_record_index: i64 = submit_group_unique_function_index("ctx_pool_wait_record", 1.usize(), fns, generics)
            add_index: i64 = submit_group_unique_generic_index("task_group_add", generics)
            false return if constructor_index < 0 or wait_index < 0 or raw_constructor_index < 0 or raw_add_index < 0 or raw_wait_index < 0 or push_state_index < 0 or release_state_index < 0 or wait_record_index < 0 or add_index < 0
            false return if add_index.usize() >= generics.decls.count
            constructor_row: usize = constructor_index.usize()
            wait_row: usize = wait_index.usize()
            raw_constructor_row: usize = raw_constructor_index.usize()
            raw_add_row: usize = raw_add_index.usize()
            raw_wait_row: usize = raw_wait_index.usize()
            push_state_row: usize = push_state_index.usize()
            release_state_row: usize = release_state_index.usize()
            wait_record_row: usize = wait_record_index.usize()
            add_row: usize = add_index.usize()
            false return if constructor_row >= fns.lines.count or wait_row >= fns.lines.count or constructor_row >= fns.returns.count or wait_row >= fns.returns.count or wait_row >= fns.param_start.count or wait_row >= fns.param_count.count
            false return if raw_constructor_row >= fns.lines.count or raw_add_row >= fns.lines.count or raw_wait_row >= fns.lines.count or push_state_row >= fns.lines.count or release_state_row >= fns.lines.count or wait_record_row >= fns.lines.count
            false return if not submit_group_runtime_api_marker_matches("task_group_new", fns.lines[constructor_row], structs)
            false return if not submit_group_runtime_api_marker_matches("task_group_wait_all", fns.lines[wait_row], structs)
            false return if not submit_group_runtime_api_marker_matches("task_group_new_raw", fns.lines[raw_constructor_row], structs)
            false return if not submit_group_runtime_api_marker_matches("task_group_add_raw", fns.lines[raw_add_row], structs)
            false return if not submit_group_runtime_api_marker_matches("task_group_wait_all_raw", fns.lines[raw_wait_row], structs)
            false return if not submit_group_runtime_api_marker_matches("ctx_task_group_push_state", fns.lines[push_state_row], structs)
            false return if not submit_group_runtime_api_marker_matches("ctx_task_group_release_all", fns.lines[release_state_row], structs)
            false return if not submit_group_runtime_api_marker_matches("ctx_pool_wait_record", fns.lines[wait_record_row], structs)
            constructor_type: ValueType = fns.returns[constructor_row]
            false return if constructor_type.kind != TypeKind.Struct or constructor_type.bits.usize() >= structs.records.names.count or structs.records.names[constructor_type.bits.usize()] != "TaskGroup"
            false return if fns.returns[wait_row].kind != TypeKind.Void
            param_index: usize = fns.param_start[wait_row]
            false return if param_index >= fns.param_types.count
            wait_parameter: ValueType = fns.param_types[param_index]
            false return if wait_parameter.kind != TypeKind.Ref
            group_parameter: ValueType = ref_target_of(wait_parameter, structs)
            false return if group_parameter.kind != TypeKind.Struct or group_parameter.bits.usize() >= structs.records.names.count or structs.records.names[group_parameter.bits.usize()] != "TaskGroup"
            false return if first_function_named(fns, "task_group_add") >= 0
            match generics.decls[add_row]:
                Decl.Func(_, params, _, _, _, decorators, function_pos):
                    false return if not any decorator in decorators where decorator.name == "internal"
                    false return if not submit_group_runtime_api_marker_matches("task_group_add", function_pos.line, structs)
                    return params.count == 2.usize()
                _:
                    return false


        def submit_group_argument_name(expression: Expr) -> sview can[Abort.Panic]:
            match expression:
                Expr.Ident(name, _):
                    return name
                Expr.Unary(TokenKind.Ampersand, operand, _) | Expr.Paren(operand, _):
                    return submit_group_argument_name(operand)
                _:
                    return ""


        def submit_group_api_callee_matches(callee: Expr, wanted: sview, local_scope: mutable Scope&, fns: FnTable&, structs: StructTable&, generics: GenericTable&) -> bool can[Abort.Panic]:
            match callee:
                Expr.Ident(name, _):
                    # A local function value can be rebound after its declaration, while
                    # local_fn_origin records only the initializer. Trust only the direct
                    # runtime spelling when no local binding shadows it.
                    false return if name != wanted or lookup_slot(local_scope, name) is local_shadow
                    owner: sview = structs.visibility.current_owner
                    if owner != "":
                        false return if fns.owners.count != fns.names.count or generics.owners.count != generics.names.count
                        function_index: mutable i64 = first_function_named(fns, wanted)
                        while function_index >= 0 |function_index, fns, wanted, owner|:
                            false return if fns.owners[function_index.usize()] == owner
                            function_index <- next_function_named(fns, wanted, function_index)
                        generic_index: mutable i64 = name_chain_first(generics.name_buckets, generics.name_next, generics.names, wanted)
                        while generic_index >= 0 |generic_index, generics, wanted, owner|:
                            false return if generics.owners[generic_index.usize()] == owner
                            generic_index <- name_chain_next(generics.name_buckets, generics.name_next, generics.names, wanted, generic_index)
                    return true
                _:
                    return false


        # Atomic `load`/`store` calls are common around a structured join and do not manipulate
        # TaskGroup state. Trust only their unique bundled generic declarations; a same-named
        # local alias, ordinary overload, or user generic remains an unknown helper call.
        def submit_group_call_is_trusted_atomic(callee: Expr, argument_count: usize, local_scope: mutable Scope&, fns: FnTable&, generics: GenericTable&) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Global{Read,Write}]:
            can Global{Read,Write}:
                match callee:
                    Expr.Ident(name, _):
                        false return if name != "load" and name != "store"
                        false return if lookup_slot(local_scope, name) is local_shadow
                        function_index: mutable i64 = first_function_named(fns, name)
                        false return if function_index >= 0
                        expected_arity: usize = 2.usize() if name == "load" else 3.usize()
                        false return if argument_count != expected_arity
                        generic_index: i64 = submit_group_unique_generic_index(name, generics)
                        false return if generic_index < 0 or generic_index.usize() >= generics.decls.count
                        match generics.decls[generic_index.usize()]:
                            Decl.Func(_, params, _, _, _, _, function_pos):
                                false return if params.count != expected_arity
                                return Lexer::source_line_is_runtime_std(function_pos.line) can Global{Read,Write}
                            _:
                                return false
                    _:
                        return false


        def submit_group_constructor_name(statement: Stmt, local_scope: mutable Scope&, fns: FnTable&, structs: StructTable&, generics: GenericTable&) -> sview can[Abort.Panic]:
            match statement:
                Stmt.VarDecl(name, _, Expr.Call(callee, arguments, _, _), _):
                    return name if arguments.count == 0 and submit_group_api_callee_matches(callee, "task_group_new", local_scope, fns, structs, generics)
                _:
                    pass
            return ""


        def submit_group_wait_matches(statement: Stmt, group_name: sview, local_scope: mutable Scope&, fns: FnTable&, structs: StructTable&, generics: GenericTable&) -> bool can[Abort.Panic]:
            false return if group_name == ""
            match statement:
                Stmt.Expr(Expr.Call(callee, arguments, _, _), _):
                    return arguments.count == 1.usize() and submit_group_api_callee_matches(callee, "task_group_wait_all", local_scope, fns, structs, generics) and submit_group_argument_name(arguments[0]) == group_name
                _:
                    return false


        # A value-bound submit is owned by a manual group only when its immediately
        # following statement transfers that exact local Task into the same group.
        # Requiring the parser's submit marker, a direct worker call, and `move task`
        # keeps aliases, retained Tasks, and merely nearby adds outside this proof.
        def submit_group_submit_add_pair_matches(submit_statement: Stmt, add_statement: Stmt, group_name: sview, local_scope: mutable Scope&, fns: FnTable&, structs: StructTable&, generics: GenericTable&) -> bool can[Abort.Panic]:
            match submit_statement:
                Stmt.VarDecl(task_name, _, Expr.Block(submit_statements, Expr.Call(submit_callee, submit_arguments, _, _), _, submit_pos), _):
                    false return if task_name == "" or task_name == "_" or submit_statements.count != 0.usize() or submit_arguments.count != 1.usize()
                    false return if not submit_marker_at(submit_pos.offset, structs)
                    false return if not (submit_callee is Expr.Ident(_, _))
                    match add_statement:
                        Stmt.Expr(Expr.Call(add_callee, add_arguments, _, _), _):
                            false return if add_arguments.count != 2.usize()
                            false return if not submit_group_api_callee_matches(add_callee, "task_group_add", local_scope, fns, structs, generics)
                            false return if submit_group_argument_name(add_arguments[0]) != group_name
                            match add_arguments[1]:
                                Expr.Move(Expr.Ident(added_task_name, _), _):
                                    return added_task_name == task_name
                                _:
                                    return false
                        _:
                            return false
                _:
                    return false


        # The registration stack currently stores a source name, not a resolved local slot.
        # Keep its meaning stable from the inferred constructor to the exact wait: any read,
        # write, alias, or shadow of that name in between makes name-based registration unsafe.
        # Unknown syntax fails closed so adding an AST node cannot silently weaken this proof.
        def submit_group_pattern_mentions_names(pattern: Pattern, names: SubmitGroupNameSet) -> bool can[Abort.Panic]:
            match pattern:
                Pattern.Wildcard | Pattern.Literal(_):
                    return false
                Pattern.Binding(binding) | Pattern.Pin(binding) | Pattern.Rest(binding):
                    return submit_group_name_in_set(binding, names)
                Pattern.Variant(path, fields) | Pattern.Struct(path, fields):
                    true return if submit_group_name_in_set(path, names)
                    for field in fields:
                        true return if submit_group_pattern_mentions_names(field, names)
                    return false
                Pattern.Field(_, inner):
                    for field in inner:
                        true return if submit_group_pattern_mentions_names(field, names)
                    return false
                Pattern.Tuple(elements) | Pattern.Or(elements):
                    for element in elements:
                        true return if submit_group_pattern_mentions_names(element, names)
                    return false
                Pattern.TypeBind(type_name, binder):
                    return submit_group_name_in_set(type_name, names) or submit_group_name_in_set(binder, names)
                Pattern.As(binding, inner):
                    true return if submit_group_name_in_set(binding, names)
                    for field in inner:
                        true return if submit_group_pattern_mentions_names(field, names)
                    return false
                Pattern.Other(_):
                    return true
                _:
                    return true


        def submit_group_pattern_mentions_manual_api(pattern: Pattern) -> bool can[Abort.Panic]:
            return submit_group_pattern_mentions_names(pattern, submit_group_manual_api_name_set())


        def submit_group_expression_mentions_names(expression: Expr, names: SubmitGroupNameSet, descend_statement_lists: bool) -> bool can[Abort.Panic]:
            match expression:
                Expr.Ident(identifier, _):
                    return submit_group_name_in_set(identifier, names)
                Expr.Call(callee, arguments, _, _):
                    if callee is Expr.Ident(add_name, _) and add_name == "task_group_add" and arguments.count == 2.usize() and submit_group_argument_name(arguments[0]) == names.first:
                        return submit_group_expression_mentions_names(arguments[1], names, descend_statement_lists)
                    true return if submit_group_expression_mentions_names(callee, names, descend_statement_lists)
                    for argument in arguments:
                        true return if submit_group_expression_mentions_names(argument, names, descend_statement_lists)
                    return false
                Expr.StaticEffectCall(effect_type, _, _, arguments, _, _):
                    true return if submit_group_expression_mentions_names(effect_type, names, descend_statement_lists)
                    for argument in arguments:
                        true return if submit_group_expression_mentions_names(argument, names, descend_statement_lists)
                    return false
                Expr.Field(object, member, _) | Expr.Scope(object, member, _):
                    return submit_group_name_in_set(member, names) or submit_group_expression_mentions_names(object, names, descend_statement_lists)
                Expr.Unary(_, object, _) | Expr.Move(object, _) | Expr.RegionNew(object, _, _) | Expr.Paren(object, _):
                    return submit_group_expression_mentions_names(object, names, descend_statement_lists)
                Expr.Index(object, index, _) | Expr.Binary(object, _, index, _):
                    return submit_group_expression_mentions_names(object, names, descend_statement_lists) or submit_group_expression_mentions_names(index, names, descend_statement_lists)
                Expr.Slice(object, low, high, _):
                    return submit_group_expression_mentions_names(object, names, descend_statement_lists) or submit_group_expression_mentions_names(low, names, descend_statement_lists) or submit_group_expression_mentions_names(high, names, descend_statement_lists)
                Expr.IndexN(object, indices, _):
                    true return if submit_group_expression_mentions_names(object, names, descend_statement_lists)
                    for index in indices:
                        true return if submit_group_expression_mentions_names(index, names, descend_statement_lists)
                    return false
                Expr.Array(elements, _) | Expr.Tuple(elements, _) | Expr.SetLit(elements, _):
                    for element in elements:
                        true return if submit_group_expression_mentions_names(element, names, descend_statement_lists)
                    return false
                Expr.DictLit(entries, _):
                    for entry in entries:
                        true return if submit_group_expression_mentions_names(entry.key, names, descend_statement_lists) or submit_group_expression_mentions_names(entry.value, names, descend_statement_lists)
                    return false
                Expr.Construct(type_expression, fields, _):
                    true return if submit_group_expression_mentions_names(type_expression, names, descend_statement_lists)
                    for field in fields:
                        true return if submit_group_expression_mentions_names(field.value, names, descend_statement_lists)
                    return false
                Expr.RecordUpdate(base, fields, _):
                    true return if submit_group_expression_mentions_names(base, names, descend_statement_lists)
                    for field in fields:
                        true return if submit_group_expression_mentions_names(field.value, names, descend_statement_lists)
                    return false
                Expr.If(condition, then_expression, else_expression, _):
                    return submit_group_expression_mentions_names(condition, names, descend_statement_lists) or submit_group_expression_mentions_names(then_expression, names, descend_statement_lists) or submit_group_expression_mentions_names(else_expression, names, descend_statement_lists)
                Expr.Match(scrutinee, arms, _) | Expr.Catch(scrutinee, arms, _):
                    true return if submit_group_expression_mentions_names(scrutinee, names, descend_statement_lists)
                    for arm in arms:
                        true return if submit_group_pattern_mentions_names(arm.pattern, names)
                        true return if submit_group_expression_mentions_names(arm.guard, names, descend_statement_lists)
                        if descend_statement_lists:
                            true return if submit_group_statement_list_mentions_names(arm.body, names, descend_statement_lists)
                        elif names.fail_closed_nested_scopes and arm.body.count > 0.usize():
                            return true
                    return false
                Expr.Comprehension(variable, iterable, condition, body, _):
                    true return if submit_group_name_in_set(variable, names)
                    return submit_group_expression_mentions_names(iterable, names, descend_statement_lists) or submit_group_expression_mentions_names(condition, names, descend_statement_lists) or submit_group_expression_mentions_names(body, names, descend_statement_lists)
                Expr.Refinement(base, predicate, _):
                    return submit_group_expression_mentions_names(base, names, descend_statement_lists) or submit_group_expression_mentions_names(predicate, names, descend_statement_lists)
                Expr.GetElse(guarded, recovery, _):
                    true return if submit_group_expression_mentions_names(guarded, names, descend_statement_lists)
                    if descend_statement_lists:
                        return submit_group_statement_list_mentions_names(recovery, names, descend_statement_lists)
                    return true if names.fail_closed_nested_scopes and recovery.count > 0.usize()
                    return false
                Expr.Lambda(_, _, _):
                    # A lambda body is emitted and guarded in its own function scope. The
                    # preliminary shallow context probe must not classify every lambda as a
                    # manual API use; group-window queries still fail closed on lambda escape.
                    return descend_statement_lists or names.fail_closed_nested_scopes
                Expr.Block(statements, value, captures, _):
                    for capture in captures:
                        # A bare loop-header capture aliases and mutates an existing
                        # outer local in place. It is safe for a proven TaskGroup
                        # window; initialized captures are header declarations in
                        # `statements` and still hit the binding check below. The
                        # fail-closed binder probe retains captures as live uses.
                        continue if not names.fail_closed_nested_scopes and capture == names.first
                        true return if submit_group_name_in_set(capture, names)
                    if descend_statement_lists:
                        true return if submit_group_statement_list_mentions_names(statements, names, descend_statement_lists)
                    elif names.fail_closed_nested_scopes and statements.count > 0.usize():
                        return true
                    return submit_group_expression_mentions_names(value, names, descend_statement_lists)
                Expr.Invalid | Expr.Absent | Expr.IntLit(_, _) | Expr.FloatLit(_, _) | Expr.StringLit(_, _) | Expr.CharLit(_, _) | Expr.BoolLit(_, _) | Expr.ShorthandMember(_, _):
                    return false
                _:
                    return true


        def submit_group_statement_mentions_names(statement: Stmt, names: SubmitGroupNameSet, descend_statement_lists: bool) -> bool can[Abort.Panic]:
            match statement:
                Stmt.Expr(expression, _) | Stmt.Contract(_, expression, _):
                    return submit_group_expression_mentions_names(expression, names, descend_statement_lists)
                Stmt.Block(_, clause, binding, body, _):
