            row: usize = index.usize()
            false return if fns.needs_store[row] or fns.arena_counts[row] != 0 or fns.is_error[row]
            false return if fns.param_count[row] != 1 or fns.is_variadic[row] or fns.is_extern[row]
            false return if value_type_uses_sret(return_type, structs, ctx)
            worker: LLVMValueRef = fns.handles[row]
            false return if LLVMCountParams(worker) != 1
            worker_type: LLVMTypeRef = LLVMGlobalGetValueType(worker)
            false return if LLVMTypeOf(LLVMGetParam(worker, 0)) != llvm_type_of(argument_type, structs, ctx)
            return LLVMGetReturnType(worker_type) == llvm_type_of(return_type, structs, ctx)




