                    # Some are runtime expressions (for example a pool or nursery worker
                    # count), so inspect identifier tokens for names tracked by this proof.
                    for clause_name in clause:
                        true return if submit_group_raw_text_mentions_name(clause_name, names.first) or submit_group_raw_text_mentions_name(clause_name, names.second) or submit_group_raw_text_mentions_name(clause_name, names.third)
                    if descend_statement_lists:
