        def submit_group_early_exit_range(statements: darray[Stmt]&, first: usize, stop: usize) -> bool can[Abort.Panic]:
            false return if first > stop or stop > statements.count
            for row in first..<stop:
                true return if submit_group_early_exit_statements([statements[row]])
            return false


        def submit_group_scan_memo_hash(first: uintptr, count: usize) -> usize:
            h: mutable u64 = first.u64() ^ (count.u64() * 0x9e3779b97f4a7c15)
            h <- (h ^ (h >> 30)) * 0xbf58476d1ce4e5b9
            h <- (h ^ (h >> 27)) * 0x94d049bb133111eb
            h <- h ^ (h >> 31)
            return h.usize()


        def submit_group_scan_memo_probe(entries: darray[SubmitListMemoEntry]&, first: uintptr, count: usize) -> usize can[Abort.Panic]:
            assert entries.count > 0.usize() and (entries.count & (entries.count - 1.usize())) == 0.usize()
            mask: usize = entries.count - 1.usize()
            slot: mutable usize = submit_group_scan_memo_hash(first, count) & mask
            probed: mutable usize = 0
            trusted Unsafe.AssumeProgress:
                while probed < entries.count:
                    return slot if entries[slot].first == 0.uintptr() or (entries[slot].first == first and entries[slot].count == count)
                    slot <- (slot + 1.usize()) & mask
                    probed <- probed + 1.usize()
            panic("submit scan memo table exhausted")


        def submit_group_scan_memo_grow(local_scope: mutable Scope&) -> void can[Abort.Panic, Memory.Allocate]:
            old_entries: darray[SubmitListMemoEntry] = local_scope.submit_scan_memo
            new_capacity: mutable usize = 8.usize()
            if old_entries.count > 0.usize():
                new_capacity <- old_entries.count * 2.usize()
                assert new_capacity > old_entries.count
            new_entries: mutable darray[SubmitListMemoEntry] = []
            new_entries.resize(new_capacity)
            for row in 0..<old_entries.count:
                entry: SubmitListMemoEntry = old_entries[row]
                if entry.first != 0.uintptr():
                    slot: usize = submit_group_scan_memo_probe(new_entries, entry.first, entry.count)
                    new_entries[slot] <- entry
            local_scope.submit_scan_memo <- new_entries


        def submit_group_scan_memo_lookup(local_scope: mutable Scope&, first: uintptr, count: usize, found: mutable bool&) -> bool can[Abort.Panic]:
            found <- false
            entries: darray[SubmitListMemoEntry] = local_scope.submit_scan_memo
            return false if entries.count == 0.usize()
            slot: usize = submit_group_scan_memo_probe(entries, first, count)
            return false if entries[slot].first == 0.uintptr()
            assert entries[slot].first == first and entries[slot].count == count
            found <- true
            return entries[slot].has_submit


        def submit_group_scan_memo_store(local_scope: mutable Scope&, first: uintptr, count: usize, has_submit: bool) -> void can[Abort.Panic, Memory.Allocate]:
            if local_scope.submit_scan_memo.count == 0.usize() or local_scope.submit_scan_memo_used + 1.usize() >= local_scope.submit_scan_memo.count - local_scope.submit_scan_memo.count / 4.usize():
                submit_group_scan_memo_grow(local_scope)
            slot: usize = submit_group_scan_memo_probe(local_scope.submit_scan_memo, first, count)
            if local_scope.submit_scan_memo[slot].first == 0.uintptr():
                local_scope.submit_scan_memo_used <- local_scope.submit_scan_memo_used + 1.usize()
            else:
                assert local_scope.submit_scan_memo[slot].first == first and local_scope.submit_scan_memo[slot].count == count
            local_scope.submit_scan_memo[slot] <- SubmitListMemoEntry{first: first, count: count, has_submit: has_submit}


