                        packed_selector: sview = region_use_name_at(packed_ctor_line.line, structs)
                        if packed_selector != "":
                            packed_selector_type: ValueType = lookup_type(local_scope, packed_selector)
                            if packed_selector_type.kind == TypeKind.PackedStore:
                                if lookup_slot(local_scope, packed_selector) is packed_selector_slot:
                                    packed_runtime.active_store <- LLVMBuildLoad2(builder, llvm_type_of(packed_selector_type, structs, ctx), packed_selector_slot, "store.active")
                                    packed_runtime.active_store_enum <- packed_selector_type.bits.i64()
                                    packed_runtime.active_store_is_block <- true
                        null return if packed_runtime.active_store_enum != packed_store_index
                        packed_tag: i64 = packed_variant_index(structs, packed_ctor_index, packed_ctor_variant)
                        null return if packed_tag < 0
                        packed_slot_index: usize = structs.packed_variant_start[packed_ctor_index.usize()] + packed_variant_local_index(structs, packed_ctor_index, packed_ctor_variant).usize()
                        packed_commons: u32 = structs.packed_common_counts[packed_ctor_index.usize()]
                        # `new Expr.Int(span: 1, value: 42)` — the COMMON args come first,
                        # then at most one payload arg. The parser prepends commons to the
                        # variant's field list, so the arity is commons (+1 with a payload).
                        packed_field_count: usize = structs.packed_field_type_count[packed_slot_index]
                        packed_expected_args: usize = packed_commons.usize() + packed_field_count
                        null return if arguments.count != packed_expected_args

                        packed_arena: LLVMValueRef = LLVMBuildExtractValue(builder, packed_runtime.active_store, 0, "packed.arena")
                        packed_state: LLVMValueRef = LLVMBuildExtractValue(builder, packed_runtime.active_store, 2, "packed.state")
                        # Recursive AST payloads contain darray side-tables. Those tables
                        # belong to the AoS store's arena, not to the constructor's temporary
                        # function arena. The latter is normally freed when this parser helper
                        # returns; using it for the clone leaves a dangling side-table header
                        # and turns a valid node handle into a later semantic crash. Keep the
                        # original runtime for expression evaluation, but direct aggregate
                        # adoption below at the store owner.
                        packed_runtime.arena <- packed_arena
                        packed_alloc_args: mutable darray[LLVMValueRef] = [packed_arena, packed_state, LLVMConstInt(LLVMInt32TypeInContext(ctx), packed_tag.u64(), 0)]
                        if runtime.packed_mode == 2:
                            packed_alloc_args <- [packed_arena, packed_state]
                        packed_alloc_pointer: void& = (&packed_alloc_args[0]).cast[void&] can Unsafe.PointerCast
                        packed_alloc_result: LLVMValueRef = LLVMBuildCall2(builder, runtime.packed_alloc_type, runtime.packed_alloc, packed_alloc_pointer, 2 if runtime.packed_mode == 2 else 3, "packed.variant.alloc")
                        packed_row: LLVMValueRef = LLVMBuildExtractValue(builder, packed_alloc_result, 0, "packed.alloc.ptr")

                        packed_handle_llvm: LLVMTypeRef = packed_row_llvm_type(structs, packed_ctor_index, ctx)
                        _ = LLVMBuildStore(builder, LLVMConstNull(packed_handle_llvm), packed_row)
                        packed_tag_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, packed_handle_llvm, packed_row, 0, "packed.tag.ptr")
                        _ = LLVMBuildStore(builder, LLVMConstInt(LLVMInt32TypeInContext(ctx), packed_tag.u64(), 0), packed_tag_pointer)
                        # Commons are stored INLINE at fields 1..commons, ahead of the payload.
                        packed_common_ok: mutable bool = true
                        for common_index in 0..<packed_commons.usize() |packed_common_ok, arguments, packed_handle_llvm, packed_row, local_scope, fns, structs, generics, runtime, m, ctx, builder|:
                            common_slot_type: ValueType = ValueType{kind: TypeKind.Signed, bits: 64}
                            if emit_expression(arguments[common_index], common_slot_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is common_value:
                                common_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, packed_handle_llvm, packed_row, (1 + common_index).u32(), "packed.common.ptr")
                                _ = LLVMBuildStore(builder, common_value, common_pointer)
                            else:
                                packed_common_ok <- false
                        null return if not packed_common_ok
                        # `packed_has_payload` means "exactly one field" in the metadata
                        # table.  Multi-field variants still carry payloads; they use the
                        # aggregate branch below.  Gating this block on that convenience
                        # flag silently left recursive AST nodes such as Call and Block
                        # with zeroed side data.
                        # `packed_field_count` counts the variant's OWN fields — the commons
                        # are separate (and were 0 for every enum until the count started
                        # flowing). Comparing against `packed_commons` skipped the payload
                        # store for a one-field variant of a one-common enum, so the row kept
                        # its zeroinitializer.
                        if packed_field_count > 0:
                            packed_payload_type: ValueType = copied_type(structs.packed_payloads[packed_slot_index])
                            packed_payload_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, packed_handle_llvm, packed_row, (1 + packed_commons), "packed.payload.ptr")
                            if packed_field_count == 1:
                                if emit_expression(arguments[packed_commons.usize()], packed_payload_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is packed_payload_value:
                                    # Stage0 adopts darray-backed payloads into the store
                                    # arena before recording the node.  This matters when a
                                    # constructor receives a side table built in a nested
                                    # region; storing the source header directly leaves the
                                    # AST pointing at storage that may be freed on return.
                                    if emit_clone_aggregate_value(packed_payload_value, packed_payload_type, packed_payload_type, structs, packed_runtime, m, ctx, builder) is adopted_payload:
                                        _ = LLVMBuildStore(builder, adopted_payload, packed_payload_pointer)
                                    else:
                                        return null
                                else:
                                    return null
                            else:
                                payload_llvm: LLVMTypeRef = llvm_type_of(packed_payload_type, structs, ctx)
                                payload_value: mutable LLVMValueRef = LLVMGetUndef(payload_llvm)
                                payload_start: usize = structs.packed_field_type_start[packed_slot_index]
                                for payload_index in 0..<packed_field_count |payload_value, payload_start, arguments, packed_commons, structs, local_scope, fns, generics, runtime, m, ctx, builder|:
                                    field_type: ValueType = copied_type(structs.packed_field_types[payload_start + payload_index])
                                    if emit_expression(arguments[packed_commons.usize() + payload_index], field_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is field_value:
                                        payload_value <- LLVMBuildInsertValue(builder, payload_value, field_value, payload_index.u32(), "packed.payload.field")
                                    else:
                                        return null
                                if emit_clone_aggregate_value(payload_value, packed_payload_type, packed_payload_type, structs, packed_runtime, m, ctx, builder) is adopted_payload:
                                    payload_value <- adopted_payload
                                else:
                                    return null
                                _ = LLVMBuildStore(builder, payload_value, packed_payload_pointer)
                        if runtime.packed_mode == 1:
                            packed_prefix_args: mutable darray[LLVMValueRef] = [packed_arena, packed_row, packed_state]
                            packed_prefix_pointer: void& = (&packed_prefix_args[0]).cast[void&] can Unsafe.PointerCast
                            LLVMBuildCall2(builder, runtime.packed_record_prefix_type, runtime.packed_record_prefix, packed_prefix_pointer, 3, "")
                        # The VALUE is the row's INDEX, not the row.
                        return LLVMBuildExtractValue(builder, packed_alloc_result, 1, "packed.alloc.index")

            # `Shape.Circle(42)` — a payload-enum CONSTRUCTOR. stage0 emits: alloca, store
            # zeroinitializer, store the tag at field 0, store the payload at field 1, load
            # the value. Only ONE payload argument is modeled, matching what
            # register_payload_enum accepts.
            if callee is Expr.Field(ctor_head, ctor_variant, ctor_line):
                if ctor_head is Expr.Ident(ctor_enum_name, ctor_enum_line):
                    ctor_enum_index: i64 = penum_index_of(structs, ctor_enum_name)
                    if ctor_enum_index >= 0:
                        ctor_tag: i64 = penum_variant_index(structs, ctor_enum_index, ctor_variant)
                        null return if ctor_tag < 0
                        ctor_variant_slot: usize = structs.penum_variant_start[ctor_enum_index.usize()] + ctor_tag.usize()
                        # `Shape.Rect(4, 5)` — a MULTI-FIELD variant: build the field tuple and
                        # store it at the payload pointer (stage0's `store {i64,i64} …`).
                        if structs.penum_field_type_count[ctor_variant_slot] > 1:
                            null return if arguments.count != structs.penum_field_type_count[ctor_variant_slot]
                            multi_type: ValueType = ValueType{kind: TypeKind.PayloadEnum, bits: ctor_enum_index.u32()}
                            multi_llvm: LLVMTypeRef = llvm_type_of(multi_type, structs, ctx)
                            multi_slot_alloca: LLVMValueRef = LLVMBuildAlloca(builder, multi_llvm, "enum.ctor")
                            _ = LLVMBuildStore(builder, LLVMConstNull(multi_llvm), multi_slot_alloca)
                            multi_tag_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, multi_llvm, multi_slot_alloca, 0, "enum.tag.ptr")
                            _ = LLVMBuildStore(builder, LLVMConstInt(LLVMInt32TypeInContext(ctx), ctor_tag.u64(), 0), multi_tag_pointer)
                            multi_tuple_llvm: LLVMTypeRef = penum_field_tuple_type(ctor_variant_slot, structs, ctx)
                            multi_field_start: usize = structs.penum_field_type_start[ctor_variant_slot]
                            # Stored field-by-field THROUGH the payload pointer rather than
                            # built with InsertValue: an ARRAY field's value cannot be inserted
                            # into the tuple, so `Note(text: i64, extra: i64[2])` declined its
                            # constructor (and, since a declined constructor leaves a dangling
                            # call, every program that used it). The struct-literal emitter
                            # already stores its fields this way for the same reason.
                            multi_payload_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, multi_llvm, multi_slot_alloca, 1, "enum.payload.ptr")
                            multi_declined: mutable bool = false
                            # LABELLED fields are reordered into declaration order.
                            # `Shape.Rect(h: 5, w: 2)` was read POSITIONALLY, so the two
                            # fields swapped and the program silently computed a different
                            # answer (stage0 59, stage1 47) -- a wrong answer, not a decline,
                            # because the constructor still emitted. The same reorder the
                            # fn-typed call paths already do, over the variant's field names.
                            for multi_index in 0..<arguments.count |multi_declined, multi_field_start, multi_payload_pointer, multi_tuple_llvm, arguments, argument_names, structs, local_scope, fns, generics, runtime, m, ctx, builder|:
                                multi_field_type: ValueType = copied_type(structs.penum_field_types[multi_field_start + multi_index])
                                multi_source: i64 = named_argument_index(argument_names, structs.penum_field_flat_names, multi_field_start, arguments.count, 0.usize(), multi_index)
                                multi_declined <- true if multi_source < 0
                                continue if multi_source < 0
                                if emit_expression(arguments[multi_source.usize()], multi_field_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is multi_field_value:
                                    _ = LLVMBuildStore(builder, multi_field_value, LLVMBuildStructGEP2(builder, multi_tuple_llvm, multi_payload_pointer, multi_index.u32(), "enum.field.ptr"))
                                else:
                                    multi_declined <- true
                            null return if multi_declined
                            return LLVMBuildLoad2(builder, multi_llvm, multi_slot_alloca, "enum.value")
                        null return if arguments.count != 1
                        ctor_type: ValueType = ValueType{kind: TypeKind.PayloadEnum, bits: ctor_enum_index.u32()}
                        ctor_payload_type: ValueType = copied_type(structs.penum_payloads[structs.penum_variant_start[ctor_enum_index.usize()] + ctor_tag.usize()])
                        null return if ctor_payload_type.kind == TypeKind.Unmodeled
                        ctor_llvm: LLVMTypeRef = llvm_type_of(ctor_type, structs, ctx)
                        ctor_slot: LLVMValueRef = LLVMBuildAlloca(builder, ctor_llvm, "enum.ctor")
                        _ = LLVMBuildStore(builder, LLVMConstNull(ctor_llvm), ctor_slot)
                        ctor_tag_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, ctor_llvm, ctor_slot, 0, "enum.tag.ptr")
                        _ = LLVMBuildStore(builder, LLVMConstInt(LLVMInt32TypeInContext(ctx), ctor_tag.u64(), 0), ctor_tag_pointer)
                        if emit_expression(arguments[0], ctor_payload_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is ctor_payload_value:
                            ctor_payload_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, ctor_llvm, ctor_slot, 1, "enum.payload.ptr")
                            _ = LLVMBuildStore(builder, ctor_payload_value, ctor_payload_pointer)
                            return LLVMBuildLoad2(builder, ctor_llvm, ctor_slot, "enum.value")
                        return null

            # UFCS: `p.get(a)` IS `get(p, a)`. A postfix call unifies casts and UFCS —
            # `recv.Name()` where Name is a TYPE name is a conversion (handled on the cast
            # path), and where Name is a FUNCTION it is an ordinary call with the receiver
            # as the leading argument. Only the latter is resolved here; a name that is
            # neither declines rather than inventing a call.
            if callee is Expr.Field(receiver, method_name, method_line):
                method_as_type: ValueType = scalar_type_of_name(method_name)
                null return if method_as_type.kind != TypeKind.Unmodeled
                # A dict or set receiver's `.get`/`.put`/`.add`/… are SYNTHESIZED calls to std
                # generics, not UFCS to a user function. Detected before the ordinary UFCS
                # lookup because no `get`/`put`/`add` function exists to find — and a set's
                # `.add` did reach that lookup, bound to an unrelated generic named `add`, and
                # emitted `store void` over the receiver.
                # `v.reduce_sum(f)` — the METHOD spelling of the fold. Rewritten to the
                # function form so there is one implementation; stage0 lowers both identically.
                if method_name == "reduce_sum" and arguments.count >= 1:
                    reduce_method_recv: ValueType = expression_type(receiver, local_scope, fns, structs, generics)
                    if reduce_method_recv.kind == TypeKind.View:
                        reduce_method_args: mutable darray[Expr] = [receiver]
                        for reduce_method_extra in arguments |reduce_method_args|:
                            reduce_method_args.push(reduce_method_extra)
                        return emit_call((Expr.Ident("reduce_sum", method_line)), reduce_method_args, [], local_scope, fns, structs, generics, runtime, m, ctx, builder)
                # `rows.valid(r)` / `rows.push(a, b)` in VALUE position on a `layout(soa)`
                # aggregate. `valid` is `r < rowCount`; `push` fans out over the columns (the
                # STATEMENT form does the same) and yields the new row's index, which stage0
                # narrows to i32 -- a RowId is an i32 handle (`%row = alloca i32`).
                soa_call_recv: ValueType = expression_type(receiver, local_scope, fns, structs, generics)
                if soa_call_recv.kind == TypeKind.Struct and struct_declares_soa_layout(structs, structs.names[soa_call_recv.bits.usize()]):
                    soa_call_slot: usize = soa_call_recv.bits.usize()
                    soa_call_columns: usize = structs.field_count[soa_call_slot]
                    if soa_call_columns > 0.usize():
                        soa_call_llvm: LLVMTypeRef = llvm_type_of(soa_call_recv, structs, ctx)
                        if method_name == "valid" and arguments.count == 1:
                            if struct_chain_address(receiver, local_scope, fns, structs, generics, runtime, m, ctx, builder) is soa_valid_base:
                                if emit_expression(arguments[0], ValueType{kind: TypeKind.Signed, bits: 64}, local_scope, fns, structs, generics, runtime, m, ctx, builder) is soa_valid_row:
                                    soa_valid_column: LLVMValueRef = LLVMBuildStructGEP2(builder, soa_call_llvm, soa_valid_base, 0, "soa.valid.col")
                                    soa_valid_count_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, darray_llvm_type(structs, ctx), soa_valid_column, 1, "soa.valid.count.ptr")
                                    soa_valid_count: LLVMValueRef = LLVMBuildLoad2(builder, LLVMInt64TypeInContext(ctx), soa_valid_count_pointer, "soa.valid.count")
                                    # 40 = SLT.
                                    return LLVMBuildICmp(builder, 40, soa_valid_row, soa_valid_count, "soa.valid")
                            return null
                        if method_name == "push" and arguments.count == soa_call_columns:
                            if struct_chain_address(receiver, local_scope, fns, structs, generics, runtime, m, ctx, builder) is soa_pv_base:
                                soa_pv_first: LLVMValueRef = LLVMBuildStructGEP2(builder, soa_call_llvm, soa_pv_base, 0, "soa.pushv.col0")
                                soa_pv_count_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, darray_llvm_type(structs, ctx), soa_pv_first, 1, "soa.pushv.count.ptr")
                                soa_pv_before: LLVMValueRef = LLVMBuildLoad2(builder, LLVMInt64TypeInContext(ctx), soa_pv_count_pointer, "soa.pushv.before")
                                soa_pv_runtime: Runtime = growth_runtime_for(receiver, local_scope, runtime)
                                soa_pv_declined: mutable bool = false
                                for soa_pv_index in 0..<soa_call_columns |soa_pv_declined, soa_pv_base, soa_call_llvm, soa_call_slot, arguments, local_scope, fns, structs, generics, soa_pv_runtime, m, ctx, builder|:
                                    soa_pv_column: LLVMValueRef = LLVMBuildStructGEP2(builder, soa_call_llvm, soa_pv_base, soa_pv_index.u32(), "soa.pushv.col")
                                    soa_pv_type: ValueType = copied_type(structs.field_types[structs.field_start[soa_call_slot] + soa_pv_index])
                                    soa_pv_declined <- true if not emit_darray_push(soa_pv_column, soa_pv_type, arguments[soa_pv_index], local_scope, fns, structs, generics, soa_pv_runtime, m, ctx, builder)
                                null return if soa_pv_declined
                                return LLVMBuildTrunc(builder, soa_pv_before, LLVMInt32TypeInContext(ctx), "soa.rowid")
                            return null
                # `d.entry(k).insert(v)` / `.get_or_insert(v)` — the ENTRY api's mutating
                # members, whose receiver is the `entry` call itself rather than the dict.
                # Checked before the dict dispatch below, which would see a receiver with no
                # dict type and fall through to UFCS.
                if method_name == "insert" or method_name == "get_or_insert":
                    if emit_dict_entry_member(receiver, method_name, arguments, local_scope, fns, structs, generics, runtime, m, ctx, builder) is dict_entry_value:
                        return dict_entry_value
                dict_args: darray[ValueType] = dict_type_args_of(receiver, local_scope, fns, structs, generics)
                if dict_args.count != 0:
                    container_base: sview = container_receiver_base(receiver, local_scope, fns, structs, generics)
                    dict_helper: sview = resolved_container_helper(container_base, method_name, generics)
                    if dict_helper != "":
                        dict_arena_leading: bool = container_method_is_mutating(container_base, method_name)
                        return emit_dict_method_call(dict_helper, dict_args, receiver, arguments, dict_arena_leading, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                # `recv.f(a)` where `f` is a GENERIC user function (`f[T](self: Slice[T], …)`) —
                # the receiver is parameter 0. Try EVERY template slot named `f` and pick the one
                # whose parameter 0 unifies with THIS receiver (the wrong overload leaves a type
                # param unbound → infer returns empty). The selected slot is threaded through
                # instantiation so an overloaded name emits the correct body. This is what the whole
                # UFCS surface of Slice/Deque/IndexMap/InlineVec needs. Checked before the
                # non-generic lookup, which only finds monomorphic functions.
                if generic_index_of(generics, method_name) >= 0:
                    ufcs_chosen_slot: mutable i64 = -1
                    ufcs_chosen_args: mutable darray[ValueType] = []
                    for ufcs_cand_slot in 0..<generics.names.count |ufcs_chosen_slot, ufcs_chosen_args, method_name, receiver, arguments, local_scope, fns, structs, generics|:
                        continue if ufcs_chosen_slot >= 0 or generics.names[ufcs_cand_slot] != method_name
                        ufcs_cand_args: darray[ValueType] = infer_generic_args_ufcs(ufcs_cand_slot, receiver, arguments, local_scope, fns, structs, generics)
                        if ufcs_cand_args.count != 0:
                            ufcs_chosen_slot <- ufcs_cand_slot.i64()
                            ufcs_chosen_args <- ufcs_cand_args
                    if ufcs_chosen_slot >= 0:
                        return emit_generic_ufcs_call(ufcs_chosen_slot.usize(), ufcs_chosen_args, receiver, arguments, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                    return null
                # `items.push(7)` where `extern push[T](box: mutable MethodBox[T]&, item: T)`.
                # A generic extern cannot be declared at DECLARATION time — its parameter types
                # mention `T` — so it is instantiated HERE, per call, from the receiver's
                # concrete instantiation: stage0 emits `declare void @push__i64(ptr, i64)` and
                # calls it, mangling `<name>__<typearg>`.
                #
                # Deliberately narrow: exactly one type parameter, a receiver that IS a generic
                # struct instantiation, and a VOID return. The argument LLVM types come from the
                # arguments actually emitted, so no substitution machinery is needed; anything
                # outside that shape keeps declining rather than inventing a signature.
                if generic_extern_param_of(structs, method_name) != "":
                    gx_receiver: ValueType = expression_type(receiver, local_scope, fns, structs, generics)
                    gx_base: mutable sview = ""
                    gx_arg_start: mutable usize = 0
                    gx_arg_count: mutable usize = 0
                    if generic_struct_instantiation_of(structs, gx_receiver, gx_base, gx_arg_start, gx_arg_count) and gx_arg_count >= 1:
                        gx_type_arg: ValueType = copied_type(structs.generic_struct_inst_args[gx_arg_start])
                        gx_suffix: sview = stage0_scalar_type_name(gx_type_arg)
                        if gx_suffix != "":
                            if struct_chain_address(receiver, local_scope, fns, structs, generics, runtime, m, ctx, builder) is gx_receiver_address:
                                gx_values: mutable darray[LLVMValueRef] = [gx_receiver_address]
                                gx_types: mutable darray[LLVMTypeRef] = [LLVMPointerTypeInContext(ctx, 0)]
                                gx_declined: mutable bool = false
                                for gx_argument in arguments |gx_declined, gx_values, gx_types, gx_type_arg, local_scope, fns, structs, generics, runtime, m, ctx, builder|:
                                    continue if gx_declined
                                    if emit_expression(gx_argument, gx_type_arg, local_scope, fns, structs, generics, runtime, m, ctx, builder) is gx_argument_value:
                                        gx_values.push(gx_argument_value)
                                        gx_types.push(llvm_type_of(gx_type_arg, structs, ctx))
                                    else:
                                        gx_declined <- true
                                null return if gx_declined
                                gx_name_storage: mutable darray[u8] = []
                                for gx_index in 0..<sview_len(method_name) |gx_name_storage, method_name|:
                                    gx_name_storage.push(sview_at(method_name, gx_index))
                                gx_name_storage.push(95)
                                gx_name_storage.push(95)
                                for gx_index in 0..<sview_len(gx_suffix) |gx_name_storage, gx_suffix|:
                                    gx_name_storage.push(sview_at(gx_suffix, gx_index))
                                gx_name_storage.push(0)
                                gx_mangled: cstr = (&gx_name_storage[0]).cast[cstr] can Unsafe.PointerCast
                                gx_types_pointer: void& = (&gx_types[0]).cast[void&] can Unsafe.PointerCast
                                gx_fn_type: LLVMTypeRef = LLVMFunctionType(LLVMVoidTypeInContext(ctx), gx_types_pointer, gx_types.count.u32(), 0)
                                gx_target: LLVMValueRef = declare_or_get_named(m, gx_mangled, gx_fn_type)
                                gx_values_pointer: void& = (&gx_values[0]).cast[void&] can Unsafe.PointerCast
                                return LLVMBuildCall2(builder, gx_fn_type, gx_target, gx_values_pointer, gx_values.count.u32(), "")
                    return null
                ufcs_target_opt: LLVMValueRef? = lookup_function(fns, "", method_name)
                if ufcs_target_opt is ufcs_target:
                    return emit_direct_call("", method_name, receiver, true, arguments, argument_names, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                # Module methods (`module Lexer: def is_digit`) are stored under their owner
                # (`@Lexer.is_digit`). UFCS `c.is_digit()` must still find them. Prefer a
                # unique bare name; when several owners share the name (Lexer.peek vs
                # Parser.peek), disambiguate by UFCS arity (receiver + explicit args) so
                # product meta-compile does not decline the whole callee.
                ufcs_total_arity: usize = arguments.count + 1
                ufcs_owner: mutable sview = ""
                ufcs_hits: mutable i64 = 0
                ufcs_arity_owner: mutable sview = ""
                ufcs_arity_hits: mutable i64 = 0
                for ufcs_scan in 0..<fns.names.count |ufcs_owner, ufcs_hits, ufcs_arity_owner, ufcs_arity_hits, method_name, ufcs_total_arity, fns|:
                    if fns.names[ufcs_scan] == method_name:
                        ufcs_hits <- ufcs_hits + 1
                        ufcs_owner <- fns.owners[ufcs_scan]
                        if fns.param_count[ufcs_scan] == ufcs_total_arity:
                            ufcs_arity_hits <- ufcs_arity_hits + 1
                            ufcs_arity_owner <- fns.owners[ufcs_scan]
                if ufcs_hits == 1 and ufcs_owner != "":
                    return emit_direct_call(ufcs_owner, method_name, receiver, true, arguments, argument_names, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                if ufcs_arity_hits == 1 and ufcs_arity_owner != "":
                    return emit_direct_call(ufcs_arity_owner, method_name, receiver, true, arguments, argument_names, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                return null
            # `M::get(a)` — a MODULE-qualified call. `::` parses to Expr.Scope, a node kind
            # distinct from Expr.Field, so a qualified call is never confused with UFCS.
            if callee is Expr.Scope(scope_head, scope_name, scope_line):
                if scope_head is Expr.Ident(module_name, module_name_line):
                    # `using Mod as M` makes `M::f` mean `Mod::f`; the name is unchanged when
                    # it is not an alias, so this is a no-op for an ordinary qualified call.
                    return emit_direct_call(module_alias_target(module_name, structs), scope_name, callee, false, arguments, argument_names, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                # `A::B::get(a)` — a module declared with a QUALIFIED name is registered
                # VERBATIM ("A::B", the parser captures the whole chain as one source span),
                # while its USE nests Scope inside Scope. Recover the registered owner by
                # matching the two parts against the recorded names rather than by joining
                # them: joining would allocate a name just to look one up, and the recorded
                # sview is exactly what the FnTable compares against.
                if scope_head is Expr.Scope(nested_head, nested_mid, nested_line):
                    if nested_head is Expr.Ident(nested_root, nested_root_line):
                        if qualified_owner_of(fns, nested_root, nested_mid) is qualified_owner:
                            return emit_direct_call(qualified_owner, scope_name, callee, false, arguments, argument_names, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                return null
            return null


        # Emit a call to a NON-generic function by name. UFCS passes its receiver as a
        # SEPARATE leading argument rather than prepending it to a list: building a local
        # `darray[Expr]` of receiver-then-arguments CRASHES stage0 (SIGTRAP inside cgo —
        # bisected to the darray construction itself, a darray of packed-enum node handles
        # built in this function). Threading the receiver is the only spelling that
        # compiles, not a style preference. `receiver` is ignored when `has_receiver` is
        # false; callers pass the callee node itself rather than synthesize a dummy.
        def emit_direct_call(callee_owner: sview, callee_name: sview, receiver: Expr, has_receiver: bool, arguments: darray[Expr]&, argument_names: darray[sview]&, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            total_arguments: usize = arguments.count + 1 if has_receiver else arguments.count
            # Prefer arity-matched overload (Token 4-arg vs 5-arg constructors). Name-only
            # lookup is only the fallback for unique names / legacy single entries.
            # TYPE-matched overload first: several may share this arity, and taking the
            # first was a silent wrong answer (see overload_index_for_args). Only consulted
            # for a call with no receiver, where `arguments` IS the full argument list.
            fn_index: mutable i64 = -1
            if not has_receiver:
                fn_index <- overload_index_for_args(fns, callee_owner, callee_name, arguments, local_scope, structs, generics)
            fn_index <- function_index_of_arity(fns, callee_owner, callee_name, total_arguments) if fn_index < 0
            fn_index <- function_index_of(fns, callee_owner, callee_name) if fn_index < 0
            null return if fn_index < 0
            target: LLVMValueRef = fns.handles[fn_index.usize()]
            # LLVMCountParams counts the implicit trailing ARENA too, so the arity check
            # must expect it — otherwise every call to an arena-threading function
            # declines on a spurious mismatch.
            arena_count: usize = fns.arena_counts[fn_index.usize()]
            wants_arena: bool = arena_count > 0
            wants_store: bool = fns.needs_store[fn_index.usize()]
            call_return_type: ValueType = copied_type(fns.returns[fn_index.usize()])
            sret_return: bool = not fns.is_error[fn_index.usize()] and value_type_uses_sret(call_return_type, structs, ctx)
            variadic_call: bool = fns.is_variadic[fn_index.usize()]
            fixed_arguments: usize = fns.param_count[fn_index.usize()]
            null return if variadic_call and total_arguments < fixed_arguments
            # A call may OMIT trailing parameters that carry defaults, so the supplied count
            # is not the callee's arity. Count the declared params in that case and fill the
            # tail from fns.param_defaults below; without this LLVMCountParams disagreed and
            # every defaulted call declined (`table.add_symbol(name, kind, line)` against a
            # 7-param add_symbol is the shape).
            uses_defaults: bool = not variadic_call and total_arguments < fixed_arguments
            expected_params: usize = fixed_arguments + arena_count + (1 if wants_store else 0) + (1 if sret_return else 0) if variadic_call or uses_defaults else total_arguments + arena_count + (1 if wants_store else 0) + (1 if sret_return else 0)
            null return if LLVMCountParams(target).i64() != expected_params.i64()

            argument_values: mutable darray[LLVMValueRef] = []
            sret_slot: mutable LLVMValueRef = zeroed
            if sret_return:
                sret_slot <- LLVMBuildAlloca(builder, llvm_type_of(call_return_type, structs, ctx), "call.sret")
                argument_values.push(sret_slot)
            declined: mutable bool = false
            argument_index: mutable usize = 0
            if has_receiver:
                receiver_param: ValueType = copied_type(fns.param_types[fns.param_start[fn_index.usize()]]) if fixed_arguments > 0 else unmodeled_type()
                receiver_value: LLVMValueRef? = emit_expression(receiver, receiver_param, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                if receiver_value is emitted_receiver:
                    argument_values.push(materialize_indirect_aggregate_argument(emitted_receiver, receiver_param, structs, ctx, builder))
                else:
                    declined <- true
                argument_index <- 1
            named_call: mutable bool = false
            for argument_name in argument_names |named_call|:
                named_call <- true if argument_name != ""
            if named_call:
                null return if variadic_call
                named_position: mutable usize = 1 if has_receiver else 0
                while named_position < fixed_arguments |argument_values, declined, named_position, argument_names, fns, fn_index, arguments, local_scope, structs, generics, runtime, m, ctx, builder|:
                    source_index: i64 = named_argument_index(argument_names, fns.param_names, fns.param_start[fn_index.usize()], fixed_arguments, named_position if has_receiver else 0, named_position)
                    null return if source_index < 0 or source_index.usize() >= arguments.count
                    named_argument: Expr = arguments[source_index.usize()]
                    named_type: ValueType = copied_type(fns.param_types[fns.param_start[fn_index.usize()] + named_position])
                    if emit_expression(named_argument, named_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is named_value:
                        argument_values.push(materialize_indirect_aggregate_argument(named_value, named_type, structs, ctx, builder))
                    else:
                        declined <- true
                    named_position <- named_position + 1
                null return if declined
            else:
                for argument in arguments |argument_values, declined, argument_index, target, local_scope, fns, structs, generics, runtime, m, ctx, builder, fn_index, fixed_arguments, variadic_call|:
                    # Each argument is emitted at its PARAMETER's declared type, so a
                    # literal argument adopts the parameter type rather than i64.
                    argument_type: mutable ValueType = copied_type(fns.param_types[fns.param_start[fn_index.usize()] + argument_index]) if argument_index < fixed_arguments else expression_type(argument, local_scope, fns, structs, generics)
                    if variadic_call and argument_index >= fixed_arguments and argument_type.kind == TypeKind.Unmodeled:
                        argument_type <- ValueType{kind: TypeKind.Float, bits: 64} if argument is Expr.FloatLit(_)
                        argument_type <- ValueType{kind: TypeKind.Signed, bits: 32} if not (argument is Expr.FloatLit(_))
                    # A NON-Ident argument passed where a `T&` is wanted. emit_expression's Ident
                    # path hands over a local's slot, but a place chain (`tokens[i]`, `a.b`) or an
                    # rvalue (a call result) has no slot, and emitting it at a Ref type silently
                    # yielded the VALUE — the callee then read the struct's first word as a
                    # pointer (`Lexer.text` dereferenced `line`==1 and segfaulted). Hand over a real
                    # address: the place's own address when it has one (so `mutable T&` still
                    # mutates the caller's storage), otherwise a materialized temporary.
                    #
                    # An OPTIONAL ref parameter (`buf: mutable u8&?`) borrows the same way: its
                    # niche form IS a bare pointer, so the callee's LLVM parameter is `ptr` and
                    # an address is exactly what it wants. Without this, `snprintf(fbuf[0], 96,
                    # …)` in the std's fault handler emitted the GEP and then LOADED it —
                    # `call @snprintf(i8 %elem, …)` where a `ptr` is declared, which `opt
                    # -passes=verify` rejects outright. Every std-including program carried that
                    # malformed IR; the object path tolerated it at -O0, so only the -O2
                    # pipeline ever tripped over it.
                    ref_arg_handled: mutable bool = false
                    ref_param_target: mutable ValueType = unmodeled_type()
                    ref_param_target <- ref_target_of(argument_type, structs) if argument_type.kind == TypeKind.Ref
                    if argument_type.kind == TypeKind.Optional and optional_is_niche(argument_type, structs):
                        ref_param_optional_payload: ValueType = optional_payload_of(argument_type, structs)
                        ref_param_target <- ref_target_of(ref_param_optional_payload, structs) if ref_param_optional_payload.kind == TypeKind.Ref
                    if ref_param_target.kind != TypeKind.Unmodeled and not (argument is Expr.Ident(_, _)):
                        ref_arg_value_type: ValueType = expression_type(argument, local_scope, fns, structs, generics)
                        # An EXTERN's reference parameter has its referent ERASED: declare_extern
                        # records `void&` for every provenance-bearing param, because the
                        # extern_params side table keeps only the bare base name and drops the
                        # `&`. So the referent-kind equality below can never hold for an extern,
                        # and `snprintf(fbuf[0], …)` fell through to the value path — emitting
                        # the GEP and then LOADING it. A `void&` parameter is exactly "some
                        # pointer", so any place argument may borrow into it.
                        #
                        # An OPTIONAL argument is NEVER borrowed. Its niche form already IS the
                        # pointer the parameter wants, so taking its address passes `&h.p`
                        # where stage0 passes the field's VALUE — and `&h.p` is never null, so
                        # every `p == null` in the callee flips. That is not hypothetical: the
                        # std's ConcurrencyPoolState.mutex is a `void&?`, pool_submit_raw calls
                        # `ctx_sync_handle(state.mutex)`, and borrowing it made stage1 lock a
                        # pointer-to-field as if it were the pthread mutex — an unsynchronised
                        # queue and a worker dequeuing a corrupt record. `nursery workers(1):
                        # submit …` segfaulted. The erased-referent rule below is for an
                        # EXTERN's parameter, whose ARGUMENT is an ordinary place (`fbuf[0]`,
                        # a u8), and that case is unaffected by this exclusion.
                        ref_param_erased: bool = ref_param_target.kind == TypeKind.Void
                        if ref_arg_value_type.kind != TypeKind.Ref and ref_arg_value_type.kind != TypeKind.CStr and ref_arg_value_type.kind != TypeKind.Optional and ref_arg_value_type.kind != TypeKind.Unmodeled and (ref_param_erased or ref_param_target.kind == ref_arg_value_type.kind):
                            if struct_chain_address(argument, local_scope, fns, structs, generics, runtime, m, ctx, builder) is ref_arg_address:
                                argument_values.push(ref_arg_address)
                                ref_arg_handled <- true
                            elif emit_expression(argument, ref_arg_value_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is ref_arg_rvalue:
                                ref_arg_slot: LLVMValueRef = build_entry_alloca(builder, llvm_type_of(ref_arg_value_type, structs, ctx), "ref.arg.tmp")
                                _ = LLVMBuildStore(builder, ref_arg_rvalue, ref_arg_slot)
                                argument_values.push(ref_arg_slot)
                                ref_arg_handled <- true
                    if ref_arg_handled:
                        argument_index <- argument_index + 1
                        continue
                    # A leading-dot shorthand ARGUMENT (`take(.Imported)`). The parser keeps it
                    # as a ShorthandMember, which no expression path emits, so a shorthand in
                    # argument position declined even for an ordinary non-generic call —
                    # `take(RoutineFlag.Imported)` compiled and `take(.Imported)` did not.
                    # Rewritten to the qualified spelling, which is fully lowered; an ambiguous
                    # or unknown member is returned untouched and declines exactly as before.
                    argument_value: LLVMValueRef? = emit_expression(resolved_shorthand_member(argument, structs), argument_type, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                    if argument_value is emitted_argument:
                        if variadic_call and argument_index >= fixed_arguments:
                            promoted_type: ValueType = c_variadic_promoted_type(argument_type)
                            if emit_conversion(emitted_argument, argument_type, promoted_type, structs, ctx, builder) is promoted_argument:
                                argument_values.push(promoted_argument)
                            else:
                                declined <- true
                        else:
                            argument_values.push(materialize_indirect_aggregate_argument(emitted_argument, argument_type, structs, ctx, builder))
                    else:
                        declined <- true
                    argument_index <- argument_index + 1
            null return if declined
            # Fill the omitted tail from the parameter defaults, at each parameter's declared
            # type. A parameter with no recorded default (Expr.Invalid) DECLINES rather than
            # passing a zero — that would silently invent an argument value.
            if uses_defaults:
                default_position: mutable usize = total_arguments
                while default_position < fixed_arguments |argument_values, declined, default_position, fns, fn_index, local_scope, structs, generics, runtime, m, ctx, builder|:
                    default_slot: usize = fns.param_start[fn_index.usize()] + default_position
                    default_expression: Expr = fns.param_defaults[default_slot]
                    if default_expression is Expr.Invalid:
                        declined <- true
                    else:
                        default_type: ValueType = copied_type(fns.param_types[default_slot])
                        if emit_expression(default_expression, default_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is default_value:
                            argument_values.push(materialize_indirect_aggregate_argument(default_value, default_type, structs, ctx, builder))
                        else:
                            declined <- true
                    default_position <- default_position + 1
                null return if declined

            # LLVMBuildCall2 needs the callee's FUNCTION type, not its pointer
            # type: LLVM pointers are opaque, so the type cannot be recovered from
            # the value itself.
            fn_type: LLVMTypeRef = LLVMGlobalGetValueType(target)
            # A VOID call must be unnamed: "instructions returning void cannot have a name".
            result_name: cstr = call_result_name(call_return_type, sret_return)
            # Hand the callee the ambient/output region when its signature has one. Stage0
            # puts that owner before the packed store only for a caller-visible return; the
            # hidden slots for directly-grown parameters and forwarded-only parameters then
            # follow the store in two partitions. The returned value and the store are both
            # aggregates at the LLVM level, so an ordering error remains verifier-valid while
            # shifting every later operand.
            call_threaded_arena: mutable LLVMValueRef = call_site_arena(arguments, local_scope, runtime)
            ambient_region_slot: bool = arena_count > 0 and fns.ambient_regions[fn_index.usize()]
            if ambient_region_slot:
                # A returned aggregate must be built in the current function's caller-owned
                # ambient region when one exists. Prefer that over the private scratch carrier:
                # `absolute_path -> path_clean` otherwise returned a darray backed by the
                # scratch arena and then freed that arena on return, leaving the caller with a
                # dangling pointer. Scratch remains the correct fallback for a non-threaded
                # caller whose result is consumed locally.
                if not llvm_value_is_null(runtime.caller_arena):
                    call_threaded_arena <- runtime.caller_arena
                elif caller_storage_arena_for(runtime, runtime.active_initializer_name) is initializer_arena:
                    call_threaded_arena <- initializer_arena
                elif not llvm_value_is_null(runtime.scratch_arena):
                    call_threaded_arena <- runtime.scratch_arena
                elif not llvm_value_is_null(runtime.arena):
                    call_threaded_arena <- runtime.arena
            # The implicit ACTIVE-STORE argument. When the CALL SITE is outside any
            # `in store:` block there is no active store, and `runtime.active_store` is
            # `zeroed` -- which pushed a bare `ptr null` where the callee declares a
            # `{ptr, i64, ptr}` STRUCT. LLVM accepts that malformed operand silently (the
            # same family as the `ret i32 0` from a struct-returning function), and the
            # callee then read its store out of null: `eval(root, store)` called from
            # outside the block answered 11 where stage0 says 13.
            #
            # A store passed as an ORDINARY argument is the one the callee means -- that is
            # how stage0's `eval(node, store)` gets it -- so prefer it, and DECLINE rather
            # than hand over a null. Passing a null store is never right.
            # The arena path has a separate invariant: an arena-threading call made from a
            # function with an active local region must never receive a null slot. Keep the
            # ambient region as the final ABI fallback when argument ownership could not be
            # recovered (for example a raw pointer expression with no named local root).
            if llvm_value_is_null(call_threaded_arena) and not llvm_value_is_null(runtime.arena):
                call_threaded_arena <- runtime.arena
            if ambient_region_slot:
                argument_values.push(call_threaded_arena)
            if wants_store:
                call_store: mutable LLVMValueRef = runtime.active_store
                if runtime.active_store_enum < 0:
                    call_store <- zeroed
                    for store_argument in arguments |call_store, local_scope, fns, structs, generics, runtime, m, ctx, builder|:
                        continue if not (expression_type(store_argument, local_scope, fns, structs, generics).kind == TypeKind.PackedStore)
                        store_argument_type: ValueType = expression_type(store_argument, local_scope, fns, structs, generics)
                        if emit_expression(store_argument, store_argument_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is store_argument_value:
                            call_store <- store_argument_value
                null return if call_store == zeroed
                argument_values.push(call_store)
            # Hidden region slots are ordered by ownership role, not source-parameter order:
            # direct growth slots first, then forwarded-only slots. The earlier source-order
            # loop made `capture_machine_from_declared_out(parser, out_edges, store, ...)`
            # exchange the parser arena and the output-table arena. Both are `ptr`, so LLVM
            # accepted the call and the failure appeared later as corrupted parser state.
            hidden_region_slot: mutable usize = 0
            for parameter_position in 0..<fixed_arguments |argument_values, hidden_region_slot, fns, fn_index, has_receiver, receiver, arguments, argument_names, local_scope, runtime, call_threaded_arena|:
                continue if not function_parameter_is_direct_region(fns, fn_index, parameter_position)
                direct_arena: mutable LLVMValueRef = call_threaded_arena
                if has_receiver and parameter_position == 0:
                    direct_arena <- growth_arena_for(receiver, local_scope, runtime)
                else:
                    source_first_position: usize = 1 if has_receiver else 0
                    source_index: i64 = named_argument_index(argument_names, fns.param_names, fns.param_start[fn_index.usize()], fixed_arguments, source_first_position, parameter_position)
                    if source_index >= 0 and source_index.usize() < arguments.count:
                        direct_arena <- growth_arena_for(arguments[source_index.usize()], local_scope, runtime)
                argument_values.push(direct_arena)
                hidden_region_slot <- hidden_region_slot + 1
            for parameter_position in 0..<fixed_arguments |argument_values, hidden_region_slot, fns, fn_index, has_receiver, receiver, arguments, argument_names, local_scope, runtime, call_threaded_arena|:
                continue if not function_parameter_has_region(fns, fn_index, parameter_position)
                continue if function_parameter_is_direct_region(fns, fn_index, parameter_position)
                forwarded_arena: mutable LLVMValueRef = call_threaded_arena
                if has_receiver and parameter_position == 0:
                    forwarded_arena <- growth_arena_for(receiver, local_scope, runtime)
                else:
                    source_first_position: usize = 1 if has_receiver else 0
                    source_index: i64 = named_argument_index(argument_names, fns.param_names, fns.param_start[fn_index.usize()], fixed_arguments, source_first_position, parameter_position)
                    if source_index >= 0 and source_index.usize() < arguments.count:
                        forwarded_arena <- growth_arena_for(arguments[source_index.usize()], local_scope, runtime)
                argument_values.push(forwarded_arena)
                hidden_region_slot <- hidden_region_slot + 1
            hidden_region_count: usize = arena_count - (1 if ambient_region_slot else 0)
            while hidden_region_slot < hidden_region_count |argument_values, hidden_region_slot, hidden_region_count, call_threaded_arena|:
                argument_values.push(call_threaded_arena)
                hidden_region_slot <- hidden_region_slot + 1
            # A VOID value is not a value: `f(g())` where `g` returns void built a call whose
            # operand is `void <badref>`, which the verifier rejects and which crashed the
            # object path inside LLVM's DataLayout rather than producing a diagnostic. One
            # check here rather than at all ten push sites.
            void_argument: mutable bool = false
            for void_probe in argument_values |void_argument, ctx|:
                void_argument <- true if LLVMTypeOf(void_probe) == LLVMVoidTypeInContext(ctx)
            null return if void_argument
            call_result: mutable LLVMValueRef = zeroed
            if argument_values.count == 0:
                call_result <- LLVMBuildCall2(builder, fn_type, target, null, 0, result_name)
            else:
                args_pointer: void& = (&argument_values[0]).cast[void&] can Unsafe.PointerCast
                call_result <- LLVMBuildCall2(builder, fn_type, target, args_pointer, argument_values.count.u32(), result_name)
            add_call_type_attribute(call_result, 1, "sret", llvm_type_of(call_return_type, structs, ctx), ctx) if sret_return
            direct_call_hidden: mutable u32 = 0
            direct_call_hidden <- direct_call_hidden + 1 if fns.is_error[fn_index.usize()]
            direct_call_hidden <- direct_call_hidden + 1 if sret_return
            for direct_param_index in 0..<fixed_arguments |direct_call_hidden, fns, fn_index, structs, ctx, call_result|:
                direct_param_type: ValueType = copied_type(fns.param_types[fns.param_start[fn_index.usize()] + direct_param_index])
                if value_type_uses_indirect_aggregate(direct_param_type, structs, ctx):
                    add_call_type_attribute(call_result, direct_call_hidden + direct_param_index.u32() + 1, "byval", llvm_type_of(direct_param_type, structs, ctx), ctx)
            return LLVMBuildLoad2(builder, llvm_type_of(call_return_type, structs, ctx), sret_slot, "call.sret.value") if sret_return
            return call_result
