# Stage1 backend — the call emitters: `emit_call`'s dispatch and `emit_direct_call`'s ABI marshalling.
# Part of `module Backend` (see codegen.elisa); split out to keep each file short.

extend Backend:
    private:
        # Build the `{ptr, i64 len}` aggregate for `sview(base, start, end)` — the exact
        # semantics of the std constructor stage0 CALLS
        # (elisacore_std/elisacore_runtime_strings.elisa:203):
        #
        #   src = value if value != null else ""
        #   len = strlen(src)
        #   lo  = min(start, len) if start > 0  else 0
        #   hi  = min(end,   len) if end  >= 0  else len
        #   hi  = lo if hi < lo
        #   {src + lo, hi - lo}
        #
        # Emitting `{base + start, end - start}` instead — no strlen, no clamp, no null
        # check — is a WRONG ANSWER at every boundary, and `end < 0` is not a corner case:
        # `__cast__(value: u8&?) -> sview` IS `sview(value, 0, -1)`, so every `x.sview()`
        # produced a view of length -1. An out-of-range span produced a view running off
        # the end of the string.
        #
        # The strlen is not optional and not an optimization loss: it is the bound every
        # clamp is measured against, and stage0 pays exactly the same call.
        def emit_sview_from_parts(base: LLVMValueRef, start: LLVMValueRef, end: LLVMValueRef, sview_llvm: LLVMTypeRef, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            sview_i64: LLVMTypeRef = LLVMInt64TypeInContext(ctx)
            sview_ptr: LLVMTypeRef = LLVMPointerTypeInContext(ctx, 0)
            sview_zero: LLVMValueRef = LLVMConstInt(sview_i64, 0, 0)
            # A NULL base reads as the empty string — never a strlen of address 0.
            sview_empty: LLVMValueRef = LLVMBuildGlobalStringPtr(builder, "", "sview.empty")
            sview_null: LLVMValueRef = LLVMBuildICmp(builder, 32, base, LLVMConstNull(sview_ptr), "sview.base.null")
            sview_src: LLVMValueRef = LLVMBuildSelect(builder, sview_null, sview_empty, base, "sview.src")
            sview_len_params: mutable darray[LLVMTypeRef] = [sview_ptr]
            sview_len_params_pointer: void& = (&sview_len_params[0]).cast[void&] can Unsafe.PointerCast
            sview_len_fn_type: LLVMTypeRef = LLVMFunctionType(sview_i64, sview_len_params_pointer, 1, 0)
            # libc `strlen`, not the runtime's `ctx_strlen`: the std's runtime_strlen is a
            # null-guard around this exact call (the guard is the select above), and LLVM
            # KNOWS this one — it carries readonly/willreturn, so a repeated strlen of the
            # same buffer folds. That matters here: the lexer builds a view per token off
            # one source pointer, and an opaque call would leave a full scan in each.
            sview_len_fn: LLVMValueRef = declare_or_get_named(m, "strlen", sview_len_fn_type)
            sview_len_args: mutable darray[LLVMValueRef] = [sview_src]
            sview_len_args_pointer: void& = (&sview_len_args[0]).cast[void&] can Unsafe.PointerCast
            sview_source_len: LLVMValueRef = LLVMBuildCall2(builder, sview_len_fn_type, sview_len_fn, sview_len_args_pointer, 1, "sview.srclen")
            # `start > 0` is a SIGNED test; the bound test that follows it is UNSIGNED,
            # matching the std, where both sides are usize by then.
            sview_start_positive: LLVMValueRef = LLVMBuildICmp(builder, 38, start, sview_zero, "sview.start.pos")
            sview_start_over: LLVMValueRef = LLVMBuildICmp(builder, 34, start, sview_source_len, "sview.start.over")
            sview_start_clamped: LLVMValueRef = LLVMBuildSelect(builder, sview_start_over, sview_source_len, start, "sview.start.clamped")
            sview_lo: LLVMValueRef = LLVMBuildSelect(builder, sview_start_positive, sview_start_clamped, sview_zero, "sview.lo")
            # A NEGATIVE end means "to the end of the string".
            sview_end_bounded: LLVMValueRef = LLVMBuildICmp(builder, 39, end, sview_zero, "sview.end.bounded")
            sview_end_over: LLVMValueRef = LLVMBuildICmp(builder, 34, end, sview_source_len, "sview.end.over")
            sview_end_clamped: LLVMValueRef = LLVMBuildSelect(builder, sview_end_over, sview_source_len, end, "sview.end.clamped")
            sview_hi_raw: LLVMValueRef = LLVMBuildSelect(builder, sview_end_bounded, sview_end_clamped, sview_source_len, "sview.hi.raw")
            # An INVERTED span is empty, never a negative length.
            sview_hi_under: LLVMValueRef = LLVMBuildICmp(builder, 36, sview_hi_raw, sview_lo, "sview.hi.under")
            sview_hi: LLVMValueRef = LLVMBuildSelect(builder, sview_hi_under, sview_lo, sview_hi_raw, "sview.hi")
            sview_gep_indices: mutable darray[LLVMValueRef] = [sview_lo]
            sview_gep_pointer: void& = (&sview_gep_indices[0]).cast[void&] can Unsafe.PointerCast
            sview_data: LLVMValueRef = LLVMBuildGEP2(builder, LLVMInt8TypeInContext(ctx), sview_src, sview_gep_pointer, 1, "sview.data")
            sview_agg: mutable LLVMValueRef = LLVMGetUndef(sview_llvm)
            sview_agg <- LLVMBuildInsertValue(builder, sview_agg, sview_data, 0, "sview.ins0")
            sview_agg <- LLVMBuildInsertValue(builder, sview_agg, LLVMBuildSub(builder, sview_hi, sview_lo, "sview.len"), 1, "sview.ins1")
            return sview_agg


        def emit_call(callee: Expr, arguments: darray[Expr]&, argument_names: darray[sview], local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            # `dense_key(node, frozen)` — the node's DENSE key. stage0 builds
            # `insertvalue %NodeKey__Expr undef, i32 %node, 0`; with NodeKey erased to its
            # single i32 field the key IS the handle, so this is just the node emitted at
            # i32. The store argument only fixes the key's type and is never read.
            #
            # FIRST in the function on purpose: the ordinary Ident dispatch below resolves
            # against the FnTable and returns null for a builtin name, which swallowed this
            # branch when it sat lower down -- the same placement mistake that cost three
            # attempts on `frozen[N]`.
            if callee is Expr.Ident(dense_key_name, dense_key_line):
                if dense_key_name == "dense_key" and arguments.count == 2:
                    return emit_expression(arguments[0], ValueType{kind: TypeKind.Signed, bits: 32}, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                # `Event(code)` — the PREFIX spelling of a `__cast__` hook whose target is an
                # enum. docs/18: `T(x)` and `x.T()` share one hook lookup. The name is a TYPE,
                # so the FnTable dispatch below finds nothing and declines; claim it here when
                # an exact (source, target) hook exists, and leave everything else alone.
                if arguments.count == 1:
                    prefix_cast_target: ValueType = cast_hook_target_type(dense_key_name, structs)
                    if prefix_cast_target.kind != TypeKind.Unmodeled:
                        prefix_cast_source: ValueType = resolve_type(arguments[0], ValueType{kind: TypeKind.Signed, bits: 64}, local_scope, fns, structs, generics)
                        if cast_hook_index(fns, prefix_cast_source, prefix_cast_target) >= 0:
                            prefix_cast_names: mutable darray[sview] = []
                            return emit_direct_call("", "__cast__", callee, false, arguments, prefix_cast_names, local_scope, fns, structs, generics, runtime, m, ctx, builder)
            # `node_table_fill[Expr, i32](owner, frozen, -1)` — allocate a dense side table
            # over a frozen store and fill it. stage0: read the store's node COUNT, and on a
            # non-zero count `arena_alloc(owner, count * sizeof(V))` + `arena_da_fill(view,
            # init)`, yielding a `{ptr, len}` view; a zero count yields a zeroinitializer.
            # With NodeTable erased to that view (see the annotation side), the result IS the
            # view, so `table[key]` and `table.values` need no cases of their own.
            #
            # FIRST in the function, like dense_key: the generic-call dispatch below would
            # claim the IndexN callee and decline on an unknown template.
            if callee is Expr.IndexN(ntf_head, ntf_type_args, ntf_head_line):
                if ntf_head is Expr.Ident(ntf_name, ntf_name_line):
                    if ntf_name == "node_table_fill" and ntf_type_args.count == 2 and arguments.count == 3:
                        ntf_element: ValueType = annotation_value_type(ntf_type_args[1], structs)
                        null return if ntf_element.kind == TypeKind.Unmodeled or ntf_element.bits == 0
                        ntf_store_type: ValueType = expression_type(arguments[1], local_scope, fns, structs, generics)
                        null return if ntf_store_type.kind != TypeKind.PackedStore
                        null return if runtime.packed_mode == 2
                        if emit_expression(arguments[1], ntf_store_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is ntf_store_value:
                            ntf_state: LLVMValueRef = LLVMBuildExtractValue(builder, ntf_store_value, 2, "node.table.state")
                            ntf_i64: LLVMTypeRef = LLVMInt64TypeInContext(ctx)
                            ntf_ptr_type: LLVMTypeRef = LLVMPointerTypeInContext(ctx, 0)
                            ntf_count_params: mutable darray[LLVMTypeRef] = [ntf_ptr_type]
                            ntf_count_params_ptr: void& = (&ntf_count_params[0]).cast[void&] can Unsafe.PointerCast
                            ntf_count_type: LLVMTypeRef = LLVMFunctionType(ntf_i64, ntf_count_params_ptr, 1, 0)
                            ntf_count_fn: LLVMValueRef = declare_or_get_named(m, "ctx_packed_store_count", ntf_count_type)
                            ntf_count_args: mutable darray[LLVMValueRef] = [ntf_state]
                            ntf_count_args_ptr: void& = (&ntf_count_args[0]).cast[void&] can Unsafe.PointerCast
                            ntf_count: LLVMValueRef = LLVMBuildCall2(builder, ntf_count_type, ntf_count_fn, ntf_count_args_ptr, 1, "node.table.count")
                            ntf_stride: u64 = (ntf_element.bits / 8).u64() if ntf_element.bits >= 8 else 1.u64()
                            ntf_bytes: LLVMValueRef = LLVMBuildMul(builder, ntf_count, LLVMConstInt(ntf_i64, ntf_stride, 0), "node.table.bytes")
                            ntf_arena: LLVMValueRef = call_site_arena(arguments, local_scope, runtime)
                            ntf_alloc_params: mutable darray[LLVMTypeRef] = [ntf_ptr_type, ntf_i64]
                            ntf_alloc_params_ptr: void& = (&ntf_alloc_params[0]).cast[void&] can Unsafe.PointerCast
                            ntf_alloc_type: LLVMTypeRef = LLVMFunctionType(ntf_ptr_type, ntf_alloc_params_ptr, 2, 0)
                            ntf_alloc_fn: LLVMValueRef = declare_or_get_named(m, "arena_alloc", ntf_alloc_type)
                            ntf_alloc_args: mutable darray[LLVMValueRef] = [ntf_arena, ntf_bytes]
                            ntf_alloc_args_ptr: void& = (&ntf_alloc_args[0]).cast[void&] can Unsafe.PointerCast
                            ntf_data: LLVMValueRef = LLVMBuildCall2(builder, ntf_alloc_type, ntf_alloc_fn, ntf_alloc_args_ptr, 2, "node.table.alloc")
                            ntf_view_type: LLVMTypeRef = llvm_type_of(intern_view_type(ntf_element, structs), structs, ctx)
                            ntf_view: mutable LLVMValueRef = LLVMBuildInsertValue(builder, LLVMGetUndef(ntf_view_type), ntf_data, 0, "node.table.view.data")
                            ntf_view <- LLVMBuildInsertValue(builder, ntf_view, ntf_count, 1, "node.table.view.len")
                            if emit_expression(arguments[2], ntf_element, local_scope, fns, structs, generics, runtime, m, ctx, builder) is ntf_init:
                                ntf_fill_params: mutable darray[LLVMTypeRef] = [ntf_view_type, llvm_type_of(ntf_element, structs, ctx)]
                                ntf_fill_params_ptr: void& = (&ntf_fill_params[0]).cast[void&] can Unsafe.PointerCast
                                ntf_fill_type: LLVMTypeRef = LLVMFunctionType(LLVMVoidTypeInContext(ctx), ntf_fill_params_ptr, 2, 0)
                                ntf_fill_fn: LLVMValueRef = declare_or_get_named(m, "arena_da_fill", ntf_fill_type)
                                ntf_fill_args: mutable darray[LLVMValueRef] = [ntf_view, ntf_init]
                                ntf_fill_args_ptr: void& = (&ntf_fill_args[0]).cast[void&] can Unsafe.PointerCast
                                _ = LLVMBuildCall2(builder, ntf_fill_type, ntf_fill_fn, ntf_fill_args_ptr, 2, "")
                                return ntf_view
                            return null
                        return null
            # `B.make(value)` inside `def f[B: Builder]` — STATIC protocol dispatch through a
            # bound type parameter. An impl body flattens into ordinary top-level functions, so
            # once B is bound the method is reachable by its bare name; the head is a bound
            # generic and not a value, which is what distinguishes this from UFCS.
            #
            # Gated on the unit declaring exactly ONE impl: with two, the bare name is
            # ambiguous and picking either would silently dispatch to the wrong one.
            #
            # That gate is right about the HAZARD and too coarse about the REMEDY. It asks
            # whether the UNIT is unambiguous when the question is whether THIS CALL is: T is
            # BOUND while the instantiation is being emitted, so the arguments have concrete
            # types and ordinary overload resolution can name the impl. Ask for a UNIQUE
            # exact match and the ambiguity is settled per call rather than per program —
            # `impl Tagged for i64` beside `impl Tagged for f64` dispatches correctly where
            # the old gate declined outright.
            #
            # Unique, not merely first: stage1 models `char`, `int`, `i64` and `isize` as ONE
            # ValueType (Signed/64), so the std's `impl Str for char` and `impl Str for i64`
            # are genuinely indistinguishable here — taking the first made `print(42)` print
            # "*" (chr(42)), which is exactly the silent wrong dispatch the single-impl gate
            # was protecting against. An ambiguous set falls through and declines.
            if callee is Expr.Field(protocol_head, protocol_method, protocol_method_line):
                if protocol_head is Expr.Ident(protocol_parameter, protocol_parameter_line):
                    if bound_type_of(structs, protocol_parameter).kind != TypeKind.Unmodeled:
                        # Resolve through the BOUND TYPE first. The impl tables already say
                        # which conformance a receiver has, so two impls of ONE protocol stop
                        # being ambiguous: `impl_member_types` names the receiver and
                        # `impl_member_lines` gives that member's own line, which keys the
                        # exact FnTable row.
                        #
                        # Before this, two impls whose methods share a signature made
                        # overload_match_count return 2, both fallbacks below declined, and
                        # EVERY instantiation failed -- so a protocol supported exactly one
                        # implementation per unit, which defeats the point of having one.
                        # elisa-ui only escaped it because its two Painters and two Controls
                        # never share a compilation unit.
                        # Matched by TYPE, not by source spelling, and dispatched only on a
                        # UNIQUE match. That is what keeps the char/i64 guard intact without
                        # weakening it: `impl Str for char` and `impl Str for int` resolve to
                        # the same ValueType here, so they both match, the count is 2, and
                        # this falls through to the fallbacks exactly as before. Two impls
                        # over genuinely distinct types -- two structs, or bool and cstr --
                        # match once and dispatch.
                        protocol_bound: ValueType = bound_type_of(structs, protocol_parameter)
                        protocol_row: mutable i64 = -1
                        protocol_hits: mutable i64 = 0
                        for protocol_impl_index in 0..<structs.impl_member_lines.count |protocol_row, protocol_hits, protocol_bound, protocol_method, structs, fns|:
                            # Only protocol conformances: an EXTENSION impl records an empty
                            # interface, and its methods are not protocol members.
                            continue if structs.impl_member_ifaces[protocol_impl_index] == ""
                            protocol_receiver_name: sview = structs.impl_member_types[protocol_impl_index]
                            protocol_receiver_struct: i64 = struct_index_of(structs, protocol_receiver_name)
                            protocol_receiver_type: ValueType = ValueType{kind: TypeKind.Struct, bits: protocol_receiver_struct.u64()} if protocol_receiver_struct >= 0 else scalar_type_of_name(protocol_receiver_name)
                            continue if protocol_receiver_type.kind == TypeKind.Unmodeled
                            continue if protocol_receiver_type.kind != protocol_bound.kind or protocol_receiver_type.bits != protocol_bound.bits
                            protocol_candidate: i64 = function_index_of_line(fns, "", protocol_method, structs.impl_member_lines[protocol_impl_index])
                            continue if protocol_candidate < 0
                            protocol_hits <- protocol_hits + 1
                            protocol_row <- protocol_candidate
                        if protocol_hits == 1:
                            return emit_direct_call_indexed(protocol_row, callee, false, arguments, argument_names, local_scope, fns, structs, generics, runtime, m, ctx, builder, null)
                        if structs.impl_concrete_names.count == 1.usize() and function_index_of(fns, "", protocol_method) >= 0:
                            return emit_call((Expr.Ident(protocol_method, protocol_method_line)), arguments, argument_names, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                        if overload_match_count(fns, "", protocol_method, arguments, local_scope, structs, generics) == 1:
                            return emit_call((Expr.Ident(protocol_method, protocol_method_line)), arguments, argument_names, local_scope, fns, structs, generics, runtime, m, ctx, builder)
            # `T.new(...)` is the source spelling for the hidden constructor synthesized by
            # the legacy `typestate T:` declaration. Stage0 rewrites this in semantic analysis;
            # stage1 has no separate semantic rewrite pass, so do the same normalization at the
            # generic call boundary. Restrict it to structs carrying the aggregate-state marker:
            # an ordinary UFCS method named `new` must continue through normal overload lookup.
            if callee is Expr.Field(typestate_ctor_object, typestate_ctor_method, typestate_ctor_line):
                if typestate_ctor_method == "new" and typestate_ctor_object is Expr.Ident(typestate_ctor_type, typestate_ctor_type_line) and struct_declares_aggregate_state(structs, typestate_ctor_type):
                    typestate_ctor_storage: mutable darray[u8] = []
                    for typestate_ctor_prefix_index in 0..<sview_len("__typestate_") |typestate_ctor_storage|:
                        typestate_ctor_storage.push(sview_at("__typestate_", typestate_ctor_prefix_index))
                    for typestate_ctor_type_index in 0..<sview_len(typestate_ctor_type) |typestate_ctor_storage, typestate_ctor_type|:
                        typestate_ctor_storage.push(sview_at(typestate_ctor_type, typestate_ctor_type_index))
                    for typestate_ctor_suffix_index in 0..<sview_len("_new") |typestate_ctor_storage|:
                        typestate_ctor_storage.push(sview_at("_new", typestate_ctor_suffix_index))
                    typestate_ctor_name: sview = sview(&typestate_ctor_storage[0], 0, typestate_ctor_storage.count)
                    return emit_direct_call("", typestate_ctor_name, callee, false, arguments, argument_names, local_scope, fns, structs, generics, runtime, m, ctx, builder) if function_index_of(fns, "", typestate_ctor_name) >= 0
            # `f[i64](x)` — an EXPLICIT type argument makes the callee an Index, not an
            # Ident; the bracket holds a TYPE, so it resolves as an annotation.
            if callee is Expr.Index(generic_callee, generic_argument, generic_call_line):
                if generic_callee is Expr.Ident(explicit_name, explicit_name_line):
                    if explicit_name == "darray_pop" and arguments.count == 1:
                        explicit_pop_type: ValueType = darray_type_behind_expr(arguments[0], local_scope, structs)
                        if explicit_pop_type.kind == TypeKind.DArray:
                            if darray_address_of_expr(arguments[0], local_scope, fns, structs, generics, runtime, m, ctx, builder) is explicit_pop_slot:
                                return emit_darray_pop_value(explicit_pop_slot, explicit_pop_type, structs, m, ctx, builder)
                        return null
                    explicit_type: ValueType = annotation_value_type(generic_argument, structs)
                    null return if explicit_type.kind == TypeKind.Unmodeled
                    null return if generic_index_of(generics, explicit_name) < 0
                    explicit_args: mutable darray[ValueType] = [explicit_type]
                    return emit_generic_call(explicit_name, explicit_args, arguments, argument_names, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                # `M::f[i64](x)` — the same template reached through a module. A generic is
                # registered under its BARE name (parser_types_function records no owner for
                # one), so the MEMBER name is what resolves it. Without this the callee is a
                # Scope rather than an Ident, nothing matched, and every call to a generic
                # declared inside `module M:` was declined -- which is why a protocol driver
                # could not live in a module at all.
                if generic_callee is Expr.Scope(scoped_head, scoped_name, scoped_line):
                    scoped_type: ValueType = annotation_value_type(generic_argument, structs)
                    null return if scoped_type.kind == TypeKind.Unmodeled
                    null return if generic_index_of(generics, scoped_name) < 0
                    scoped_args: mutable darray[ValueType] = [scoped_type]
                    return emit_generic_call(scoped_name, scoped_args, arguments, argument_names, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                return null
            # `f[K, V](x)` — EXPLICIT multi-argument type application. The callee is an
            # IndexN whose bracket holds the type arguments.
            if callee is Expr.IndexN(multi_generic_callee, multi_generic_args, multi_generic_line):
                # `M::f[K, V](x)`: same rule as the single-argument form above.
                if multi_generic_callee is Expr.Scope(multi_scoped_head, multi_scoped_name, multi_scoped_line):
                    if generic_index_of(generics, multi_scoped_name) >= 0:
                        multi_scoped_args: mutable darray[ValueType] = []
                        multi_scoped_declined: mutable bool = false
                        for scoped_type_argument in multi_generic_args |multi_scoped_args, multi_scoped_declined, structs|:
                            scoped_resolved: ValueType = annotation_value_type(scoped_type_argument, structs)
                            multi_scoped_declined <- true if scoped_resolved.kind == TypeKind.Unmodeled
                            multi_scoped_args.push(scoped_resolved)
                        null return if multi_scoped_declined
                        return emit_generic_call(multi_scoped_name, multi_scoped_args, arguments, argument_names, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                if multi_generic_callee is Expr.Ident(multi_name, multi_name_line):
                    null return if generic_index_of(generics, multi_name) < 0
                    multi_type_args: mutable darray[ValueType] = []
                    multi_declined: mutable bool = false
                    for type_argument_expression in multi_generic_args |multi_type_args, multi_declined, structs|:
                        resolved_type_argument: ValueType = annotation_value_type(type_argument_expression, structs)
                        multi_declined <- true if resolved_type_argument.kind == TypeKind.Unmodeled
                        multi_type_args.push(resolved_type_argument)
                    null return if multi_declined
                    return emit_generic_call(multi_name, multi_type_args, arguments, argument_names, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                return null
            # `xs.pop()` is a value-producing darray operation. Lower it before ordinary UFCS
            # lookup so stage1 does not manufacture an unresolved `darray_pop[T]` declaration.
            if callee is Expr.Field(pop_object, pop_method, pop_line):
                if pop_method == "pop" and arguments.count == 0:
                    pop_array_type: ValueType = darray_type_behind_expr(pop_object, local_scope, structs)
                    if pop_array_type.kind == TypeKind.DArray:
                        if darray_address_of_expr(pop_object, local_scope, fns, structs, generics, runtime, m, ctx, builder) is pop_slot:
                            return emit_darray_pop_value(pop_slot, pop_array_type, structs, m, ctx, builder)
                    return null
            return emit_call_named(callee, arguments, argument_names, local_scope, fns, structs, generics, runtime, m, ctx, builder)
        def emit_direct_call(callee_owner: sview, callee_name: sview, receiver: Expr, has_receiver: bool, arguments: darray[Expr]&, argument_names: darray[sview]&, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            total_arguments: usize = arguments.count + 1 if has_receiver else arguments.count
            # Prefer arity-matched overload (Token 4-arg vs 5-arg constructors). Name-only
            # lookup is only the fallback for unique names / legacy single entries.
            # TYPE-matched overload first: several may share this arity, and taking the
            # first was a silent wrong answer (see overload_index_for_args). Only consulted
            # for a call with no receiver, where `arguments` IS the full argument list.
            # A UFCS call resolves over the SAME full list, receiver first: `c.area()` with
            # `impl Shape for Circle` and `impl Shape for Square` both declaring a one-param
            # `area` used to skip the typed pass and take the first arity match, so every
            # receiver dispatched to whichever impl was declared first (the differential
            # case ufcs_overload_by_receiver). Only the protocol-through-bound-type path was
            # typed; a value receiver is the common spelling and was not.
            fn_index: mutable i64 = -1
            if has_receiver:
                receiver_first: mutable darray[Expr] = [receiver]
                for ufcs_argument in arguments |receiver_first|:
                    receiver_first.push(ufcs_argument)
                fn_index <- overload_index_for_args(fns, callee_owner, callee_name, receiver_first, local_scope, structs, generics)
            else:
                fn_index <- overload_index_for_args(fns, callee_owner, callee_name, arguments, local_scope, structs, generics)
            fn_index <- function_index_of_arity(fns, callee_owner, callee_name, total_arguments) if fn_index < 0
            fn_index <- function_index_of(fns, callee_owner, callee_name) if fn_index < 0
            null return if fn_index < 0
            return emit_direct_call_indexed(fn_index, receiver, has_receiver, arguments, argument_names, local_scope, fns, structs, generics, runtime, m, ctx, builder, null)


        # Emit a call to an ALREADY-RESOLVED FnTable row.
        #
        # Split out of emit_direct_call, whose body below this point uses neither the
        # owner nor the name -- only the resolved index. A caller that already knows
        # exactly which row it wants can say so instead of re-resolving by name.
        #
        # Protocol dispatch is the case that needs it: two impls of one protocol give
        # two same-named rows, and name resolution is RIGHT to refuse them (taking the
        # first made `print(42)` print "*" once, because char and i64 are one ValueType
        # here). The bound type says which impl is meant, so the caller resolves the
        # row and hands it over.
        def emit_direct_call_indexed(fn_index: i64, receiver: Expr, has_receiver: bool, arguments: darray[Expr]&, argument_names: darray[sview]&, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef, sret_destination: LLVMValueRef?) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            total_arguments: usize = arguments.count + 1 if has_receiver else arguments.count
            target: LLVMValueRef = fns.handles[fn_index.usize()]
            # LLVMCountParams counts the implicit trailing ARENA too, so the arity check
            # must expect it — otherwise every call to an arena-threading function
            # declines on a spurious mismatch.
            arena_count: usize = fns.arena_counts[fn_index.usize()]
            wants_arena: bool = arena_count > 0
            wants_store: bool = fns.needs_store[fn_index.usize()]
            call_return_type: ValueType = copied_type(fns.returns[fn_index.usize()])
            sret_return: bool = not fns.is_error[fn_index.usize()] and value_type_uses_sret(call_return_type, structs, ctx)
            variadic_call: bool = fns.is_variadic[fn_index.usize()]
            fixed_arguments: usize = fns.param_count[fn_index.usize()]
            null return if variadic_call and total_arguments < fixed_arguments
            # A call may OMIT trailing parameters that carry defaults, so the supplied count
            # is not the callee's arity. Count the declared params in that case and fill the
            # tail from fns.param_defaults below; without this LLVMCountParams disagreed and
            # every defaulted call declined (`table.add_symbol(name, kind, line)` against a
            # 7-param add_symbol is the shape).
            uses_defaults: bool = not variadic_call and total_arguments < fixed_arguments
            expected_params: usize = fixed_arguments + arena_count + (1 if wants_store else 0) + (1 if sret_return else 0) if variadic_call or uses_defaults else total_arguments + arena_count + (1 if wants_store else 0) + (1 if sret_return else 0)
            null return if LLVMCountParams(target).i64() != expected_params.i64()

            argument_values: mutable darray[LLVMValueRef] = []
            sret_slot: mutable LLVMValueRef = zeroed
            if sret_return:
                if sret_destination is destination:
                    sret_slot <- destination
                else:
                    sret_slot <- build_entry_alloca(builder, llvm_type_of(call_return_type, structs, ctx), "call.sret")
                argument_values.push(sret_slot)
            declined: mutable bool = false
            argument_index: mutable usize = 0
            if has_receiver:
                receiver_param: ValueType = copied_type(fns.param_types[fns.param_start[fn_index.usize()]]) if fixed_arguments > 0 else unmodeled_type()
                if indirect_aggregate_argument_address(receiver, receiver_param, local_scope, fns, structs, generics, runtime, m, ctx, builder) is receiver_address:
                    argument_values.push(receiver_address)
                elif emit_expression(receiver, receiver_param, local_scope, fns, structs, generics, runtime, m, ctx, builder) is emitted_receiver:
                    argument_values.push(materialize_indirect_aggregate_argument(emitted_receiver, receiver_param, structs, ctx, builder))
                else:
                    declined <- true
                argument_index <- 1
            named_call: mutable bool = false
            for argument_name in argument_names |named_call|:
                named_call <- true if argument_name != ""
            if named_call:
                null return if variadic_call
                named_position: mutable usize = 1 if has_receiver else 0
                while named_position < fixed_arguments |argument_values, declined, named_position, argument_names, fns, fn_index, arguments, local_scope, structs, generics, runtime, m, ctx, builder|:
                    source_index: i64 = named_argument_index(argument_names, fns.param_names, fns.param_start[fn_index.usize()], fixed_arguments, named_position if has_receiver else 0, named_position)
                    null return if source_index < 0 or source_index.usize() >= arguments.count
                    named_argument: Expr = arguments[source_index.usize()]
                    named_type: ValueType = copied_type(fns.param_types[fns.param_start[fn_index.usize()] + named_position])
                    if indirect_aggregate_argument_address(named_argument, named_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is named_address:
                        argument_values.push(named_address)
                    elif emit_expression(named_argument, named_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is named_value:
                        argument_values.push(materialize_indirect_aggregate_argument(named_value, named_type, structs, ctx, builder))
                    else:
                        declined <- true
                    named_position <- named_position + 1
                null return if declined
            else:
                for argument in arguments |argument_values, declined, argument_index, target, local_scope, fns, structs, generics, runtime, m, ctx, builder, fn_index, fixed_arguments, variadic_call|:
                    # Each argument is emitted at its PARAMETER's declared type, so a
                    # literal argument adopts the parameter type rather than i64.
                    argument_type: mutable ValueType = copied_type(fns.param_types[fns.param_start[fn_index.usize()] + argument_index]) if argument_index < fixed_arguments else expression_type(argument, local_scope, fns, structs, generics)
                    if variadic_call and argument_index >= fixed_arguments and argument_type.kind == TypeKind.Unmodeled:
                        argument_type <- ValueType{kind: TypeKind.Float, bits: 64} if argument is Expr.FloatLit(_, _)
                        argument_type <- ValueType{kind: TypeKind.Signed, bits: 32} if not (argument is Expr.FloatLit(_, _))
                    # A NON-Ident argument passed where a `T&` is wanted. emit_expression's Ident
                    # path hands over a local's slot, but a place chain (`tokens[i]`, `a.b`) or an
                    # rvalue (a call result) has no slot, and emitting it at a Ref type silently
                    # yielded the VALUE — the callee then read the struct's first word as a
                    # pointer (`Lexer.text` dereferenced `line`==1 and segfaulted). Hand over a real
                    # address: the place's own address when it has one (so `mutable T&` still
                    # mutates the caller's storage), otherwise a materialized temporary.
                    #
                    # An OPTIONAL ref parameter (`buf: mutable u8&?`) borrows the same way: its
                    # niche form IS a bare pointer, so the callee's LLVM parameter is `ptr` and
                    # an address is exactly what it wants. Without this, `snprintf(fbuf[0], 96,
                    # …)` in the std's fault handler emitted the GEP and then LOADED it —
                    # `call @snprintf(i8 %elem, …)` where a `ptr` is declared, which `opt
                    # -passes=verify` rejects outright. Every std-including program carried that
                    # malformed IR; the object path tolerated it at -O0, so only the -O2
                    # pipeline ever tripped over it.
                    ref_arg_handled: mutable bool = false
                    ref_param_target: mutable ValueType = unmodeled_type()
                    ref_param_target <- ref_target_of(argument_type, structs) if argument_type.kind == TypeKind.Ref
                    if argument_type.kind == TypeKind.Optional and optional_is_niche(argument_type, structs):
                        ref_param_optional_payload: ValueType = optional_payload_of(argument_type, structs)
                        ref_param_target <- ref_target_of(ref_param_optional_payload, structs) if ref_param_optional_payload.kind == TypeKind.Ref
                    if ref_param_target.kind != TypeKind.Unmodeled and not (argument is Expr.Ident(_, _)):
                        ref_arg_value_type: ValueType = expression_type(argument, local_scope, fns, structs, generics)
                        # An EXTERN's reference parameter has its referent ERASED: declare_extern
                        # records `void&` for every provenance-bearing param, because the
                        # extern_params side table keeps only the bare base name and drops the
                        # `&`. So the referent-kind equality below can never hold for an extern,
                        # and `snprintf(fbuf[0], …)` fell through to the value path — emitting
                        # the GEP and then LOADING it. A `void&` parameter is exactly "some
                        # pointer", so any place argument may borrow into it.
                        #
                        # An OPTIONAL argument is NEVER borrowed. Its niche form already IS the
                        # pointer the parameter wants, so taking its address passes `&h.p`
                        # where stage0 passes the field's VALUE — and `&h.p` is never null, so
                        # every `p == null` in the callee flips. That is not hypothetical: the
                        # std's ConcurrencyPoolState.mutex is a `void&?`, pool_submit_raw calls
                        # `ctx_sync_handle(state.mutex)`, and borrowing it made stage1 lock a
                        # pointer-to-field as if it were the pthread mutex — an unsynchronised
                        # queue and a worker dequeuing a corrupt record. `nursery workers(1):
                        # submit …` segfaulted. The erased-referent rule below is for an
                        # EXTERN's parameter, whose ARGUMENT is an ordinary place (`fbuf[0]`,
                        # a u8), and that case is unaffected by this exclusion.
                        ref_param_erased: bool = ref_param_target.kind == TypeKind.Void
                        if ref_arg_value_type.kind != TypeKind.Ref and ref_arg_value_type.kind != TypeKind.CStr and ref_arg_value_type.kind != TypeKind.Optional and ref_arg_value_type.kind != TypeKind.Unmodeled and (ref_param_erased or ref_param_target.kind == ref_arg_value_type.kind):
                            if struct_chain_address(argument, local_scope, fns, structs, generics, runtime, m, ctx, builder) is ref_arg_address:
                                argument_values.push(ref_arg_address)
                                ref_arg_handled <- true
                            elif emit_expression(argument, ref_arg_value_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is ref_arg_rvalue:
                                ref_arg_slot: LLVMValueRef = build_entry_alloca(builder, llvm_type_of(ref_arg_value_type, structs, ctx), "ref.arg.tmp")
                                _ = LLVMBuildStore(builder, ref_arg_rvalue, ref_arg_slot)
                                argument_values.push(ref_arg_slot)
                                ref_arg_handled <- true
                    if ref_arg_handled:
                        argument_index <- argument_index + 1
                        continue
                    if indirect_aggregate_argument_address(argument, argument_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is direct_aggregate_address:
                        argument_values.push(direct_aggregate_address)
                        argument_index <- argument_index + 1
                        continue
                    # A leading-dot shorthand ARGUMENT (`take(.Imported)`). The parser keeps it
                    # as a ShorthandMember, which no expression path emits, so a shorthand in
                    # argument position declined even for an ordinary non-generic call —
                    # `take(RoutineFlag.Imported)` compiled and `take(.Imported)` did not.
                    # Rewritten to the qualified spelling, which is fully lowered; an ambiguous
                    # or unknown member is returned untouched and declines exactly as before.
                    argument_value: LLVMValueRef? = emit_expression(resolved_shorthand_member(argument, structs), argument_type, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                    if argument_value is emitted_argument:
                        if variadic_call and argument_index >= fixed_arguments:
                            promoted_type: ValueType = c_variadic_promoted_type(argument_type)
                            if emit_conversion(emitted_argument, argument_type, promoted_type, structs, ctx, builder) is promoted_argument:
                                argument_values.push(promoted_argument)
                            else:
                                declined <- true
                        else:
                            argument_values.push(materialize_indirect_aggregate_argument(emitted_argument, argument_type, structs, ctx, builder))
                    else:
                        declined <- true
                    argument_index <- argument_index + 1
            null return if declined
            # Fill the omitted tail from the parameter defaults, at each parameter's declared
            # type. A parameter with no recorded default (Expr.Invalid) DECLINES rather than
            # passing a zero — that would silently invent an argument value.
            if uses_defaults:
                default_position: mutable usize = total_arguments
                while default_position < fixed_arguments |argument_values, declined, default_position, fns, fn_index, local_scope, structs, generics, runtime, m, ctx, builder|:
                    default_slot: usize = fns.param_start[fn_index.usize()] + default_position
                    default_expression: Expr = fns.param_defaults[default_slot]
                    if default_expression is Expr.Invalid:
                        declined <- true
                    else:
                        default_type: ValueType = copied_type(fns.param_types[default_slot])
                        if emit_expression(default_expression, default_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is default_value:
                            argument_values.push(materialize_indirect_aggregate_argument(default_value, default_type, structs, ctx, builder))
                        else:
                            declined <- true
                    default_position <- default_position + 1
                null return if declined

            # LLVMBuildCall2 needs the callee's FUNCTION type, not its pointer
            # type: LLVM pointers are opaque, so the type cannot be recovered from
            # the value itself.
            fn_type: LLVMTypeRef = LLVMGlobalGetValueType(target)
            # A VOID call must be unnamed: "instructions returning void cannot have a name".
            result_name: cstr = call_result_name(call_return_type, sret_return)
            # Hand the callee OUR region when its signature threads one: the container
            # it grows is ours, so its backing must come from a region that outlives
            # the call. Stage0 orders hidden arguments as explicit values, packed store,
            # then the independent caller-region slots.
            call_threaded_arena: mutable LLVMValueRef = call_site_arena(arguments, local_scope, runtime)
            # The implicit ACTIVE-STORE argument. When the CALL SITE is outside any
            # `in store:` block there is no active store, and `runtime.active_store` is
            # `zeroed` -- which pushed a bare `ptr null` where the callee declares a
            # `{ptr, i64, ptr}` STRUCT. LLVM accepts that malformed operand silently (the
            # same family as the `ret i32 0` from a struct-returning function), and the
            # callee then read its store out of null: `eval(root, store)` called from
            # outside the block answered 11 where stage0 says 13.
            #
            # A store passed as an ORDINARY argument is the one the callee means -- that is
            # how stage0's `eval(node, store)` gets it -- so prefer it, and DECLINE rather
            # than hand over a null. Passing a null store is never right.
            # The arena path has a separate invariant: an arena-threading call made from a
            # function with an active local region must never receive a null slot. Keep the
            # ambient region as the final ABI fallback when argument ownership could not be
            # recovered (for example a raw pointer expression with no named local root).
            if llvm_value_is_null(call_threaded_arena) and not llvm_value_is_null(runtime.arena):
                call_threaded_arena <- runtime.arena
            if wants_store:
                call_store: mutable LLVMValueRef = runtime.active_store
                if runtime.active_store_enum < 0:
                    call_store <- zeroed
                    for store_argument in arguments |call_store, local_scope, fns, structs, generics, runtime, m, ctx, builder|:
                        continue if not (expression_type(store_argument, local_scope, fns, structs, generics).kind == TypeKind.PackedStore)
                        store_argument_type: ValueType = expression_type(store_argument, local_scope, fns, structs, generics)
                        if emit_expression(store_argument, store_argument_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is store_argument_value:
                            call_store <- store_argument_value
                null return if call_store == zeroed
                argument_values.push(call_store)
            # Hidden region slots are independent. Map each slot-bearing explicit parameter
            # back to the source argument so a forwarded reference preserves its owner arena;
            # use the ambient call arena only for a return/explicit region slot or an omitted
            # defaulted argument. Passing one arena to every slot is ABI-compatible at the
            # type level but corrupts the compiler's multi-table walkers at runtime.
            direct_arena_slot: mutable usize = 0
            for parameter_position in 0..<fixed_arguments |argument_values, direct_arena_slot, arena_count, fns, fn_index, structs, has_receiver, receiver, arguments, argument_names, local_scope, runtime, call_threaded_arena|:
                parameter_type: ValueType = copied_type(fns.param_types[fns.param_start[fn_index.usize()] + parameter_position])
                continue if not function_parameter_has_region(fns, fn_index, parameter_position)
                direct_arena: mutable LLVMValueRef = call_threaded_arena
                if has_receiver and parameter_position == 0:
                    direct_arena <- growth_arena_for(receiver, local_scope, runtime)
                else:
                    source_first_position: usize = 1 if has_receiver else 0
                    source_index: i64 = named_argument_index(argument_names, fns.param_names, fns.param_start[fn_index.usize()], fixed_arguments, source_first_position, parameter_position)
                    if source_index >= 0 and source_index.usize() < arguments.count:
                        direct_arena <- growth_arena_for(arguments[source_index.usize()], local_scope, runtime)
                argument_values.push(direct_arena)
                direct_arena_slot <- direct_arena_slot + 1
            while direct_arena_slot < arena_count |argument_values, direct_arena_slot, call_threaded_arena|:
                argument_values.push(call_threaded_arena)
                direct_arena_slot <- direct_arena_slot + 1
            # A VOID value is not a value: `f(g())` where `g` returns void built a call whose
            # operand is `void <badref>`, which the verifier rejects and which crashed the
            # object path inside LLVM's DataLayout rather than producing a diagnostic. One
            # check here rather than at all ten push sites.
            void_argument: mutable bool = false
            for void_probe in argument_values |void_argument, ctx|:
                void_argument <- true if LLVMTypeOf(void_probe) == LLVMVoidTypeInContext(ctx)
            null return if void_argument
            call_result: mutable LLVMValueRef = zeroed
            if argument_values.count == 0:
                call_result <- LLVMBuildCall2(builder, fn_type, target, null, 0, result_name)
            else:
                args_pointer: void& = (&argument_values[0]).cast[void&] can Unsafe.PointerCast
                call_result <- LLVMBuildCall2(builder, fn_type, target, args_pointer, argument_values.count.u32(), result_name)
            add_call_type_attribute(call_result, 1, "sret", llvm_type_of(call_return_type, structs, ctx), ctx) if sret_return
            if fns.is_extern[fn_index.usize()]:
                direct_call_hidden: mutable u32 = 0
                direct_call_hidden <- direct_call_hidden + 1 if fns.is_error[fn_index.usize()]
                direct_call_hidden <- direct_call_hidden + 1 if sret_return
                for direct_param_index in 0..<fixed_arguments |direct_call_hidden, fns, fn_index, structs, ctx, call_result|:
                    direct_param_type: ValueType = copied_type(fns.param_types[fns.param_start[fn_index.usize()] + direct_param_index])
                    if value_type_uses_indirect_aggregate(direct_param_type, structs, ctx):
                        add_call_type_attribute(call_result, direct_call_hidden + direct_param_index.u32() + 1, "byval", llvm_type_of(direct_param_type, structs, ctx), ctx)
            return sret_slot if sret_return and sret_destination is destination
            return LLVMBuildLoad2(builder, llvm_type_of(call_return_type, structs, ctx), sret_slot, "call.sret.value") if sret_return
            return call_result


        # Direct-call twin for assignments whose destination is already an aggregate place. The
        # ordinary expression path must return a first-class value; this variant hands the field
        # slot to the callee's sret parameter so a large result never becomes an SSA aggregate.
        # 0 means that the call was not a recognized large aggregate call. -1 means that it
        # was recognized but argument lowering declined after emitting part of the call. That
        # distinction matters: callers must not fall back to ordinary expression lowering after
        # side effects have already been emitted, or the source call could execute twice.
        def emit_direct_call_into_sret(callee_owner: sview, callee_name: sview, receiver: Expr, has_receiver: bool, arguments: darray[Expr]&, argument_names: darray[sview]&, destination: LLVMValueRef, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            total_arguments: usize = arguments.count + 1 if has_receiver else arguments.count
            fn_index: mutable i64 = -1
            if has_receiver:
                receiver_first: mutable darray[Expr] = [receiver]
                for ufcs_argument in arguments |receiver_first|:
                    receiver_first.push(ufcs_argument)
                fn_index <- overload_index_for_args(fns, callee_owner, callee_name, receiver_first, local_scope, structs, generics)
            else:
                fn_index <- overload_index_for_args(fns, callee_owner, callee_name, arguments, local_scope, structs, generics)
            fn_index <- function_index_of_arity(fns, callee_owner, callee_name, total_arguments) if fn_index < 0
            fn_index <- function_index_of(fns, callee_owner, callee_name) if fn_index < 0
            # Bare calls written inside a module are owned by that enclosing module even
            # though their AST callee is only an Ident. Mirror emit_call_named's lexical lookup
            # here; otherwise a large aggregate `updated <- writer_put_byte(...)` falls back to
            # a first-class sret load/store simply because the destination-aware resolver lost
            # the current owner.
            if fn_index < 0 and callee_owner == "" and structs.current_owner != "":
                if has_receiver:
                    owner_receiver_first: mutable darray[Expr] = [receiver]
                    for owner_ufcs_argument in arguments |owner_receiver_first|:
                        owner_receiver_first.push(owner_ufcs_argument)
                    fn_index <- overload_index_for_args(fns, structs.current_owner, callee_name, owner_receiver_first, local_scope, structs, generics)
                else:
                    fn_index <- overload_index_for_args(fns, structs.current_owner, callee_name, arguments, local_scope, structs, generics)
                fn_index <- function_index_of_arity(fns, structs.current_owner, callee_name, total_arguments) if fn_index < 0
                fn_index <- function_index_of(fns, structs.current_owner, callee_name) if fn_index < 0
            return 0 if fn_index < 0
            return 0 if fns.is_error[fn_index.usize()]
            return 0 if not value_type_uses_sret(fns.returns[fn_index.usize()], structs, ctx)
            if emit_direct_call_indexed(fn_index, receiver, has_receiver, arguments, argument_names, local_scope, fns, structs, generics, runtime, m, ctx, builder, destination) is emitted_call:
                _ = emitted_call
                return 1
            return -1

include "./codegen_call_named.elisa"
include "./codegen_call_store.elisa"
include "./codegen_call_receiver.elisa"
