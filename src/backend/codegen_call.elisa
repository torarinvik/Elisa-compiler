                            argument_values.push(named_address)
                        elif (emit_expression_coerced(named_argument, named_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}) is named_value:
                            argument_values.push(materialize_indirect_aggregate_argument(named_value, named_type, structs, ctx, builder))
                        else:
                            declined <- true
                    named_position <- named_position + 1
                null return if declined
            else:
                for argument in arguments |argument_values, declined, argument_index, target, local_scope, fns, structs, generics, runtime, m, ctx, builder, fn_index, fixed_arguments, variadic_call|:
                    # Each argument is emitted at its PARAMETER's declared type, so a
                    # literal argument adopts the parameter type rather than i64.
                    argument_type: mutable ValueType = copied_type(fns.param_types[fns.param_start[fn_index.usize()] + argument_index]) if argument_index < fixed_arguments else expression_type(argument, local_scope, fns, structs, generics)
                    if variadic_call and argument_index >= fixed_arguments and argument_type.kind == TypeKind.Unmodeled:
                        argument_type <- ValueType{kind: TypeKind.Float, bits: 64} if argument is Expr.FloatLit(_, _)
                        argument_type <- ValueType{kind: TypeKind.Signed, bits: 32} if not (argument is Expr.FloatLit(_, _))
                    # A NON-Ident argument passed where a `T&` is wanted. emit_expression's Ident
                    # path hands over a local's slot, but a place chain (`tokens[i]`, `a.b`) or an
                    # rvalue (a call result) has no slot, and emitting it at a Ref type silently
                    # yielded the VALUE — the callee then read the struct's first word as a
                    # pointer (`Lexer.text` dereferenced `line`==1 and segfaulted). Hand over a real
                    # address: the place's own address when it has one (so `mutable T&` still
                    # mutates the caller's storage), otherwise a materialized temporary.
                    #
                    # An OPTIONAL ref parameter (`buf: mutable u8&?`) borrows the same way: its
                    # niche form IS a bare pointer, so the callee's LLVM parameter is `ptr` and
                    # an address is exactly what it wants. Without this, `snprintf(fbuf[0], 96,
                    # …)` in the std's fault handler emitted the GEP and then LOADED it —
                    # `call @snprintf(i8 %elem, …)` where a `ptr` is declared, which `opt
                    # -passes=verify` rejects outright. Every std-including program carried that
                    # malformed IR; the object path tolerated it at -O0, so only the -O2
                    # pipeline ever tripped over it.
                    ref_arg_handled: mutable bool = false
                    ref_param_target: mutable ValueType = unmodeled_type()
                    ref_param_target <- ref_target_of(argument_type, structs) if argument_type.kind == TypeKind.Ref
                    if argument_type.kind == TypeKind.Optional and optional_is_niche(argument_type, structs):
                        ref_param_optional_payload: ValueType = optional_payload_of(argument_type, structs)
                        ref_param_target <- ref_target_of(ref_param_optional_payload, structs) if ref_param_optional_payload.kind == TypeKind.Ref
                    if ref_param_target.kind != TypeKind.Unmodeled and not (argument is Expr.Ident(_, _)):
                        ref_arg_value_type: ValueType = expression_type(argument, local_scope, fns, structs, generics)
                        # An EXTERN's reference parameter has its referent ERASED: declare_extern
                        # records `void&` for every provenance-bearing param, because the
                        # extern_params side table keeps only the bare base name and drops the
                        # `&`. So the referent-kind equality below can never hold for an extern,
                        # and `snprintf(fbuf[0], …)` fell through to the value path — emitting
                        # the GEP and then LOADING it. A `void&` parameter is exactly "some
                        # pointer", so any place argument may borrow into it.
                        #
                        # An OPTIONAL argument is NEVER borrowed. Its niche form already IS the
                        # pointer the parameter wants, so taking its address passes `&h.p`
                        # where stage0 passes the field's VALUE — and `&h.p` is never null, so
                        # every `p == null` in the callee flips. That is not hypothetical: the
                        # std's ConcurrencyPoolState.mutex is a `void&?`, pool_submit_raw calls
                        # `ctx_sync_handle(state.mutex)`, and borrowing it made stage1 lock a
                        # pointer-to-field as if it were the pthread mutex — an unsynchronised
                        # queue and a worker dequeuing a corrupt record. `nursery workers(1):
                        # submit …` segfaulted. The erased-referent rule below is for an
                        # EXTERN's parameter, whose ARGUMENT is an ordinary place (`fbuf[0]`,
                        # a u8), and that case is unaffected by this exclusion.
                        ref_param_erased: bool = ref_param_target.kind == TypeKind.Void
                        if ref_arg_value_type.kind != TypeKind.Ref and ref_arg_value_type.kind != TypeKind.CStr and ref_arg_value_type.kind != TypeKind.Optional and ref_arg_value_type.kind != TypeKind.Unmodeled and (ref_param_erased or ref_param_target.kind == ref_arg_value_type.kind):
                            if (struct_chain_address(argument, local_scope, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}) is ref_arg_address:
                                argument_values.push(ref_arg_address)
                                ref_arg_handled <- true
                            elif (emit_expression(argument, ref_arg_value_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}) is ref_arg_rvalue:
                                ref_arg_slot: LLVMValueRef = build_entry_alloca(builder, llvm_type_of(ref_arg_value_type, structs, ctx), "ref.arg.tmp")
                                _ = LLVMBuildStore(builder, ref_arg_rvalue, ref_arg_slot)
                                argument_values.push(ref_arg_slot)
                                ref_arg_handled <- true
                    if ref_arg_handled:
                        argument_index <- argument_index + 1
                        continue
                    if (indirect_aggregate_argument_address(argument, argument_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}) is direct_aggregate_address:
                        argument_values.push(direct_aggregate_address)
                        argument_index <- argument_index + 1
                        continue
                    # A leading-dot shorthand ARGUMENT (`take(.Imported)`). The parser keeps it
                    # as a ShorthandMember, which no expression path emits, so a shorthand in
                    # argument position declined even for an ordinary non-generic call —
                    # `take(RoutineFlag.Imported)` compiled and `take(.Imported)` did not.
                    # Rewritten to the qualified spelling, which is fully lowered; an ambiguous
                    # or unknown member is returned untouched and declines exactly as before.
                    argument_value: LLVMValueRef? = emit_expression_coerced(resolved_shorthand_member(argument, structs), argument_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}
                    if argument_value is emitted_argument:
                        if variadic_call and argument_index >= fixed_arguments:
                            promoted_type: ValueType = c_variadic_promoted_type(argument_type)
                            if emit_conversion(emitted_argument, argument_type, promoted_type, structs, ctx, builder) is promoted_argument:
                                argument_values.push(promoted_argument)
                            else:
                                declined <- true
                        else:
                            argument_values.push(materialize_indirect_aggregate_argument(emitted_argument, argument_type, structs, ctx, builder))
                    else:
                        declined <- true
                    argument_index <- argument_index + 1
            null return if declined
            # Fill the omitted tail from the parameter defaults, at each parameter's declared
            # type. A parameter with no recorded default (Expr.Invalid) DECLINES rather than
            # passing a zero — that would silently invent an argument value.
            if uses_defaults and not named_call:
                default_position: mutable usize = total_arguments
                while default_position < fixed_arguments |argument_values, declined, default_position, fns, fn_index, local_scope, structs, generics, runtime, m, ctx, builder|:
                    default_slot: usize = fns.param_start[fn_index.usize()] + default_position
                    default_expression: Expr = fns.param_defaults[default_slot]
                    if default_expression is Expr.Invalid:
                        declined <- true
                    else:
                        default_type: ValueType = copied_type(fns.param_types[default_slot])
                        empty_default_type_args: darray[ValueType] = []
                        default_owner: sview = fns.owners[fn_index.usize()] if fn_index.usize() < fns.owners.count else ""
                        if (emit_call_default_argument(default_expression, default_type, default_owner, -1, -1, empty_default_type_args, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}) is default_value:
                            argument_values.push(default_value)
                        else:
                            declined <- true
                    default_position <- default_position + 1
                null return if declined

            # LLVMBuildCall2 needs the callee's FUNCTION type, not its pointer
            # type: LLVM pointers are opaque, so the type cannot be recovered from
            # the value itself.
            fn_type: LLVMTypeRef = LLVMGlobalGetValueType(target)
            # A VOID call must be unnamed: "instructions returning void cannot have a name".
            result_name: cstr = call_result_name(call_return_type, sret_return)
            # Hand the callee OUR region when its signature threads one: the container
            # it grows is ours, so its backing must come from a region that outlives
            # the call. Stage0 orders hidden arguments as explicit values, packed store,
            # then the independent caller-region slots.
            call_threaded_arena: mutable LLVMValueRef = call_site_arena(arguments, local_scope, runtime, structs)
            # The implicit ACTIVE-STORE argument. When the CALL SITE is outside any
            # `in store:` block there is no active store, and `runtime.active_store` is
            # `zeroed` -- which pushed a bare `ptr null` where the callee declares a
            # `{ptr, i64, ptr}` STRUCT. LLVM accepts that malformed operand silently (the
            # same family as the `ret i32 0` from a struct-returning function), and the
            # callee then read its store out of null: `eval(root, store)` called from
            # outside the block answered 11 where stage0 says 13.
            #
            # A store passed as an ORDINARY argument is the one the callee means -- that is
            # how stage0's `eval(node, store)` gets it -- so prefer it, and DECLINE rather
            # than hand over a null. Passing a null store is never right.
            # The arena path has a separate invariant: an arena-threading call made from a
            # function with an active local region must never receive a null slot. Keep the
            # ambient region as the final ABI fallback when argument ownership could not be
            # recovered (for example a raw pointer expression with no named local root).
            if llvm_value_is_null(call_threaded_arena) and not llvm_value_is_null(runtime.arena):
                call_threaded_arena <- runtime.arena
            if wants_store:
                call_store: mutable LLVMValueRef? = runtime.active_store if runtime.active_store_enum >= 0 else null
                if runtime.active_store_enum < 0:
                    for store_argument in arguments |call_store, local_scope, fns, structs, generics, runtime, m, ctx, builder|:
                        continue if not (expression_type(store_argument, local_scope, fns, structs, generics).kind == TypeKind.PackedStore)
                        store_argument_type: ValueType = expression_type(store_argument, local_scope, fns, structs, generics)
                        call_store <- emit_expression(store_argument, store_argument_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}
                if call_store is resolved_call_store:
                    argument_values.push(resolved_call_store)
                else:
                    return null
            # Hidden region slots are independent. Map each slot-bearing explicit parameter
            # back to the source argument so a forwarded reference preserves its owner arena;
            # use the ambient call arena only for a return/explicit region slot or an omitted
            # defaulted argument. Passing one arena to every slot is ABI-compatible at the
            # type level but corrupts the compiler's multi-table walkers at runtime.
            direct_arena_slot: mutable usize = 0
            for parameter_position in 0..<fixed_arguments |argument_values, direct_arena_slot, arena_count, fns, fn_index, structs, has_receiver, receiver, arguments, argument_names, local_scope, runtime, call_threaded_arena|:
                parameter_type: ValueType = copied_type(fns.param_types[fns.param_start[fn_index.usize()] + parameter_position])
                continue if not function_parameter_has_region(fns, fn_index, parameter_position)
                direct_arena: mutable LLVMValueRef = call_threaded_arena
                if has_receiver and parameter_position == 0:
                    direct_arena <- growth_arena_for(receiver, local_scope, runtime)
                else:
                    source_first_position: usize = 1 if has_receiver else 0
                    source_index: i64 = named_argument_index(argument_names, fns.param_names, fns.param_start[fn_index.usize()], fixed_arguments, source_first_position, parameter_position)
                    if source_index >= 0 and source_index.usize() < arguments.count:
                        direct_arena <- growth_arena_for(arguments[source_index.usize()], local_scope, runtime)
                # A null slot is the NO-REGION placeholder (codegen_declare): this function was
                # judged to own no arena, yet the callee grows the argument's storage. The callee
                # would allocate out of null (the StaticEffectCall pre-pass gap segfaulted here).
                # That judgement was wrong somewhere upstream, so decline instead of guessing.
                null return if llvm_value_is_null(direct_arena)
                argument_values.push(direct_arena)
                direct_arena_slot <- direct_arena_slot + 1
            while direct_arena_slot < arena_count |argument_values, direct_arena_slot, call_threaded_arena|:
                argument_values.push(call_threaded_arena)
                direct_arena_slot <- direct_arena_slot + 1
            # docs/127 D8 — snapshot the ELISA-LEVEL arguments before the C plan below splits a
            # view into (pointer, length) and unwraps a resource handle. An extern's `ensure`
            # is written against its SURFACE signature, where `s` is still one `view[T]` with a
            # `.count`, so the check has to bind the values the source passed, not the C ones.
            ensure_applies: bool = extern_ensure_applies(fn_index, fns, structs)
            ensure_arguments: mutable darray[LLVMValueRef] = []
            ensure_hidden: mutable usize = 0
            if ensure_applies:
                ensure_hidden <- ensure_hidden + 1 if fns.is_error[fn_index.usize()]
                ensure_hidden <- ensure_hidden + 1 if sret_return
                for ensure_argument in argument_values |ensure_arguments|:
                    ensure_arguments.push(ensure_argument)
            # A C-ABI extern with a C parameter plan: reorder/split the explicit arguments into
            # the C order (docs/127 §3.3). Hidden leading slots and the trailing tail (variadic
            # arguments, arena slots) are untouched.
            if c_plan >= 0:
                plan_hidden: mutable usize = 0
                plan_hidden <- plan_hidden + 1 if fns.is_error[fn_index.usize()]
                plan_hidden <- plan_hidden + 1 if sret_return
                planned_values: mutable darray[LLVMValueRef] = []
                for lead in 0..<plan_hidden |planned_values, argument_values|:
                    planned_values.push(argument_values[lead])
                # The plan SPLITS an argument, so it only holds if the emitted value really has
                # the shape the plan assumes: a {ptr, len} aggregate for a view, a struct for a
                # resource, a pointer to load through. When an argument emitted at some other
                # shape, extracting from it is not merely wrong IR — LLVMBuildExtractValue on a
                # non-aggregate builds an instruction with a NULL type and then names it, which
                # dereferences null inside LLVM and SEGFAULTS the compiler.
                #
                # Reached today by a packed enum's `tail` payload bound in a match: stage1 binds
                # it as a bare `ptr` (`%items = alloca ptr`) where stage0 binds the view
                # (`alloca %DynArrayView`), so `take_view(items)` on a `@callconv(c)` extern
                # crashed while the same call without the C convention only declined. Declining
                # here reports the function by name instead, which is the honest answer until
                # the packed tail binding itself carries the view.
                plan_shape_bad: mutable bool = false
                for code_index in 0..<fns.c_plan_count[c_plan.usize()] |planned_values, argument_values, fns, c_plan, plan_hidden, plan_shape_bad, ctx, builder|:
                    code: u32 = fns.c_plan_codes[fns.c_plan_start[c_plan.usize()] + code_index]
                    source: LLVMValueRef = argument_values[plan_hidden + (code / 8).usize()]
                    source_kind: u32 = LLVMGetTypeKind(LLVMTypeOf(source))
                    source_fields: u32 = LLVMCountStructElementTypes(LLVMTypeOf(source)) if source_kind == 10 else 0
                    if code % 8 == 1 or code % 8 == 2:
                        plan_shape_bad <- true if source_fields < 2
                    elif code % 8 == 3:
                        plan_shape_bad <- true if source_fields < 1
                    elif code % 8 == 4:
                        plan_shape_bad <- true if source_kind != 12
                    if plan_shape_bad:
                        planned_values.push(source)
                    elif code % 8 == 1:
                        planned_values.push(LLVMBuildExtractValue(builder, source, 0, "extern.view.ptr"))
                    elif code % 8 == 2:
                        planned_values.push(LLVMBuildExtractValue(builder, source, 1, "extern.view.len"))
                    elif code % 8 == 3:
                        planned_values.push(LLVMBuildExtractValue(builder, source, 0, "extern.resource.handle"))
                    elif code % 8 == 4:
                        planned_values.push(LLVMBuildLoad2(builder, LLVMPointerTypeInContext(ctx, 0), source, "extern.resource.handle"))
                    else:
                        planned_values.push(source)
                null return if plan_shape_bad
                tail_start: usize = plan_hidden + fixed_arguments
                for tail_index in tail_start..<argument_values.count |planned_values, argument_values|:
                    planned_values.push(argument_values[tail_index])
                argument_values <- planned_values
            # A VOID value is not a value: `f(g())` where `g` returns void built a call whose
            # operand is `void <badref>`, which the verifier rejects and which crashed the
            # object path inside LLVM's DataLayout rather than producing a diagnostic. One
            # check here rather than at all ten push sites.
            void_argument: mutable bool = false
            for void_probe in argument_values |void_argument, ctx|:
                void_argument <- true if LLVMTypeOf(void_probe) == LLVMVoidTypeInContext(ctx)
            null return if void_argument
            # Every path below either assigns a call result or declines.
            call_result: mutable LLVMValueRef = LLVMConstNull(LLVMPointerTypeInContext(ctx, 0))
            if fns.is_error[fn_index.usize()]:
                direct_error_family: mutable sview = line_error_set_name(structs.errors.error_fn_lines, structs.errors.error_fn_set_names, fns.lines[fn_index.usize()])
                direct_error_family <- resolved_error_family(direct_error_family, structs)
                if emit_error_status_call(target, argument_values, direct_error_family, fns.is_extern[fn_index.usize()], structs, ctx, builder) is direct_error_result:
                    call_result <- direct_error_result
                else:
                    return null
            else:
                if argument_values.count == 0:
                    call_result <- LLVMBuildCall2(builder, fn_type, target, null, 0, result_name)
                else:
                    args_pointer: void& = (&argument_values[0]).cast[void&] can Unsafe.PointerCast
                    call_result <- LLVMBuildCall2(builder, fn_type, target, args_pointer, argument_values.count.u32(), result_name)
            clear_all_local_callable_aliases(local_scope) if direct_call_may_mutate_local_callable_aliases(fn_index, has_receiver, arguments, fns, structs)
            add_call_type_attribute(call_result, 1, "sret", llvm_type_of(call_return_type, structs, ctx), ctx) if sret_return
            # An `extern resource` came back as its bare handle: wrap it into the struct, and
            # for `Name?` into the aggregate optional from a null test (docs/127 §3.2).
            if fns.is_extern[fn_index.usize()]:
                resource_kind: u32 = resource_return_kind_of(fns, fns.names[fn_index.usize()])
                if resource_kind != 0:
                    resource_payload_type: ValueType = optional_payload_of(call_return_type, structs) if resource_kind == 2 else copied_type(call_return_type)
                    resource_struct_llvm: LLVMTypeRef = llvm_type_of(resource_payload_type, structs, ctx)
                    resource_wrapped: LLVMValueRef = LLVMBuildInsertValue(builder, LLVMGetUndef(resource_struct_llvm), call_result, 0, "extern.resource.wrap")
                    if resource_kind == 2:
                        resource_present: LLVMValueRef = LLVMBuildICmp(builder, 33, call_result, LLVMConstNull(LLVMPointerTypeInContext(ctx, 0)), "extern.opt.present")
                        resource_optional: LLVMValueRef = LLVMBuildInsertValue(builder, LLVMGetUndef(llvm_type_of(call_return_type, structs, ctx)), resource_present, 0, "extern.opt.tag")
                        call_result <- LLVMBuildInsertValue(builder, resource_optional, resource_wrapped, 1, "extern.opt.val")
                    else:
                        call_result <- resource_wrapped
            if fns.is_extern[fn_index.usize()]:
                direct_call_hidden: mutable u32 = 0
                direct_call_hidden <- direct_call_hidden + 1 if fns.is_error[fn_index.usize()]
                direct_call_hidden <- direct_call_hidden + 1 if sret_return
                direct_call_hidden <- direct_call_hidden + 1 if extern_error_sret
                # A split view occupies two LLVM parameters, so every attribute index after
                # it shifts by one per split view before it.
                for direct_param_index in 0..<fixed_arguments |direct_call_hidden, fns, fn_index, structs, ctx, call_result, c_plan|:
                    direct_param_type: ValueType = copied_type(fns.param_types[fns.param_start[fn_index.usize()] + direct_param_index])
                    if value_type_uses_indirect_aggregate(direct_param_type, structs, ctx):
                        add_call_type_attribute(call_result, direct_call_hidden + c_plan_position_of(fns, c_plan, direct_param_index).u32() + 1, "byval", llvm_type_of(direct_param_type, structs, ctx), ctx)
            if ensure_applies:
                ensure_result: mutable LLVMValueRef = call_result
                ensure_result <- LLVMBuildLoad2(builder, llvm_type_of(call_return_type, structs, ctx), sret_slot, "call.sret.ensure") if sret_return
                ensure_result <- LLVMBuildLoad2(builder, llvm_type_of(call_return_type, structs, ctx), error_out_slot, "call.error.ensure") if fns.is_error[fn_index.usize()] and call_return_type.kind != TypeKind.Void
                null return if not (emit_extern_ensure_checks(fn_index, ensure_arguments, ensure_hidden, ensure_result, call_return_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write})
            return sret_slot if sret_return and sret_destination is destination
            return LLVMBuildLoad2(builder, llvm_type_of(call_return_type, structs, ctx), sret_slot, "call.sret.value") if sret_return
            return call_result


        def resource_return_kind_of(fns: FnTable&, name: sview) -> u32 can[Abort.Panic]:
            for index in 0..<fns.resource_return_names.count:
                fns.resource_return_kinds[index] return if fns.resource_return_names[index] == name
            return 0

        # The plan row of a C-ABI extern by name, or -1.
        def c_plan_index_of(fns: FnTable&, name: sview) -> i64 can[Abort.Panic]:
            for index in 0..<fns.c_plan_names.count:
                index.i64() return if fns.c_plan_names[index] == name
            return -1

        # The C position of an Elisa parameter's whole value (or its pointer, for a split
        # view) under plan `c_plan`; the parameter's own index when there is no plan.
        def c_plan_position_of(fns: FnTable&, c_plan: i64, param_index: usize) -> usize can[Abort.Panic]:
            param_index return if c_plan < 0
            for code_index in 0..<fns.c_plan_count[c_plan.usize()]:
                code: u32 = fns.c_plan_codes[fns.c_plan_start[c_plan.usize()] + code_index]
                code_index return if (code / 8).usize() == param_index and code % 8 != 2
            return param_index


        # Direct-call twin for assignments whose destination is already an aggregate place. The
        # ordinary expression path must return a first-class value; this variant hands the field
        # slot to the callee's sret parameter so a large result never becomes an SSA aggregate.
        # 0 means that the call was not a recognized large aggregate call. -1 means that it
        # was recognized but argument lowering declined after emitting part of the call. That
        # distinction matters: callers must not fall back to ordinary expression lowering after
        # side effects have already been emitted, or the source call could execute twice.
        def emit_direct_call_into_sret(callee_owner: sview, callee_name: sview, receiver: Expr, has_receiver: bool, arguments: darray[Expr]&, argument_names: darray[sview]&, destination: LLVMValueRef, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            return -1 if direct_call_has_untrusted_pool_lifetime_argument(receiver, has_receiver, arguments, local_scope, fns, structs, generics)
            return 0 if not direct_call_argument_names_are_well_formed(arguments, argument_names)
            fn_index: mutable i64 = -1
            if has_receiver:
                receiver_first: mutable darray[Expr] = [receiver]
                for ufcs_argument in arguments |receiver_first|:
                    receiver_first.push(ufcs_argument)
                receiver_names: mutable darray[sview] = [""]
                for explicit_position in 0..<arguments.count |receiver_names, explicit_position, argument_names, arguments|:
                    receiver_names.push(argument_names[explicit_position]) if argument_names.count == arguments.count
                    receiver_names.push("") if argument_names.count != arguments.count
                fn_index <- overload_index_for_call_args(fns, callee_owner, callee_name, receiver_first, receiver_names, local_scope, structs, generics)
                fn_index <- function_index_of_unique_call_shape(fns, callee_owner, callee_name, receiver_first, receiver_names) if fn_index < 0
            else:
                fn_index <- overload_index_for_call_args(fns, callee_owner, callee_name, arguments, argument_names, local_scope, structs, generics)
                fn_index <- function_index_of_unique_call_shape(fns, callee_owner, callee_name, arguments, argument_names) if fn_index < 0
            # Bare calls written inside a module are owned by that enclosing module even
            # though their AST callee is only an Ident. Mirror emit_call_named's lexical lookup
            # here; otherwise a large aggregate `updated <- writer_put_byte(...)` falls back to
            # a first-class sret load/store simply because the destination-aware resolver lost
            # the current owner.
            if fn_index < 0 and callee_owner == "" and structs.visibility.current_owner != "" and function_index_of(fns, "", callee_name) < 0:
                if has_receiver:
                    owner_receiver_first: mutable darray[Expr] = [receiver]
                    for owner_ufcs_argument in arguments |owner_receiver_first|:
                        owner_receiver_first.push(owner_ufcs_argument)
                    owner_receiver_names: mutable darray[sview] = [""]
                    for explicit_position in 0..<arguments.count |owner_receiver_names, explicit_position, argument_names, arguments|:
                        owner_receiver_names.push(argument_names[explicit_position]) if argument_names.count == arguments.count
                        owner_receiver_names.push("") if argument_names.count != arguments.count
                    fn_index <- overload_index_for_call_args(fns, structs.visibility.current_owner, callee_name, owner_receiver_first, owner_receiver_names, local_scope, structs, generics)
                    fn_index <- function_index_of_unique_call_shape(fns, structs.visibility.current_owner, callee_name, owner_receiver_first, owner_receiver_names) if fn_index < 0
                else:
                    fn_index <- overload_index_for_call_args(fns, structs.visibility.current_owner, callee_name, arguments, argument_names, local_scope, structs, generics)
                    fn_index <- function_index_of_unique_call_shape(fns, structs.visibility.current_owner, callee_name, arguments, argument_names) if fn_index < 0
            return 0 if fn_index < 0
            return 0 if fns.is_error[fn_index.usize()]
            return 0 if not value_type_uses_sret(fns.returns[fn_index.usize()], structs, ctx)
            if (emit_direct_call_indexed(fn_index, receiver, has_receiver, arguments, argument_names, local_scope, fns, structs, generics, runtime, m, ctx, builder, destination) can Global{Read,Write}) is emitted_call:
                _ = emitted_call
                return 1
            return -1

include "./codegen_atomic.elisa"
include "./codegen_call_named.elisa"
include "./codegen_call_store.elisa"
include "./codegen_call_receiver.elisa"
