# Stage1 backend — the call emitters: `emit_call`'s dispatch and `emit_direct_call`'s ABI marshalling.
# Part of `module Backend` (see codegen.elisa); split out to keep each file short.

extend Backend:
    private:
        # Explicit generic arguments accept both type expressions and const values.
        # `annotation_value_type` recognizes integer literals as ConstUsize, but a
        # module-qualified integer constant such as `Buffer::CAPACITY` needs lookup
        # through the constant table before the generic instantiation can be selected.
        def generic_argument_value_type(expression: Expr, structs: mutable StructTable&) -> ValueType can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            resolved: ValueType = annotation_value_type(expression, structs)
            return resolved if resolved.kind != TypeKind.Unmodeled
            const_index: mutable i64 = -1
            match expression:
                Expr.Ident(const_name, _):
                    const_index <- const_index_of(structs, const_name)
                Expr.Scope(const_head, const_name, _):
                    if const_head is Expr.Ident(const_module, _):
                        const_index <- const_index_of_in(structs, const_scope_owner(structs, const_module), const_name)
                    elif const_head is Expr.Scope(const_root_head, const_mid, _):
                        if const_root_head is Expr.Ident(const_root, _):
                            if const_owner_of(structs, module_alias_target(const_root, structs), const_mid) is const_nested_owner:
                                const_index <- const_index_of_in(structs, const_nested_owner, const_name)
                _:
                    pass
            return unmodeled_type() if const_index < 0 or not structs.constants.const_resolved[const_index.usize()]
            const_type: ValueType = copied_type(structs.constants.const_types[const_index.usize()])
            const_value: i64 = structs.constants.const_values[const_index.usize()]
            return unmodeled_type() if not is_integer_type(const_type) or const_value < 0 or const_value > 4294967295
            return ValueType{kind: TypeKind.ConstUsize, bits: const_value.u32()}

        # Region-only applications use the concrete function ABI. Region names are
        # lifetime arguments, never runtime value types or monomorphization keys.
        def region_only_call_index(callee: Expr, arguments: darray[Expr]&, argument_names: darray[sview @source]&, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&) -> i64 can[Abort.Panic, Memory.Allocate]:
            base: mutable Expr = callee
            region_count: mutable usize = 0
            match callee:
                Expr.Index(head, selector, _):
                    return -1 if not (selector is Expr.Ident)
                    base <- head
                    region_count <- 1
                Expr.IndexN(head, selectors, _):
                    for selector in selectors:
                        return -1 if not (selector is Expr.Ident)
                    base <- head
                    region_count <- selectors.count
                _:
                    return -1
            owner: mutable sview = ""
            name: mutable sview = ""
            match base:
                Expr.Ident(bare_name, _):
                    name <- bare_name
                    if function_has_call_shape(fns, structs.visibility.current_owner, name, arguments, argument_names):
                        owner <- structs.visibility.current_owner
                    elif generic_index_of_owner(generics, structs.visibility.current_owner, name) >= 0:
                        return -1
                    elif not function_has_call_shape(fns, "", name, arguments, argument_names):
                        return -1 if generic_index_of_owner(generics, "", name) >= 0
                        owner_row: i64 = function_index_for_unique_call_owner(fns, name, arguments, argument_names, false)
                        return -1 if owner_row < 0
                        owner <- fns.owners[owner_row.usize()]
                    # A generic from another module must not hide this concrete
                    # function. Keep generic precedence within the selected owner.
                    return -1 if generic_index_of_owner(generics, owner, name) >= 0
                Expr.Scope(head, member, _):
                    return -1 if generic_index_of_scoped_member(generics, fns, structs, head, member) >= 0
                    name <- member
                    rank: mutable i64 = -1
                    row: mutable i64 = first_function_named(fns, name)
                    while row >= 0 |row, rank, owner, fns, structs, head, name|:
                        candidate_rank: i64 = enum_scope_path_rank(fns.owners[row.usize()], head, structs)
                        if candidate_rank > rank:
                            rank <- candidate_rank
                            owner <- fns.owners[row.usize()]
                        row <- next_function_named(fns, name, row)
                    return -1 if rank < 0
                _:
                    return -1
            index: mutable i64 = overload_index_for_call_args(fns, owner, name, arguments, argument_names, local_scope, structs, generics)
            index <- function_index_of_unique_call_shape(fns, owner, name, arguments, argument_names) if index < 0
            return -1 if index < 0
            return -1 if index.usize() >= fns.lines.count or index.usize() >= fns.offsets.count
            declared_regions: usize = region_parameter_count(fns.lines[index.usize()], fns.offsets[index.usize()], structs)
            return index if declared_regions == region_count and region_count > 0 else -1

        # Build the `{ptr, i64 len}` aggregate for `sview(base, start, end)` — the exact
        # semantics of the std constructor stage0 CALLS
        # (elisacore_std/elisacore_runtime_strings.elisa:203):
        #
        #   src = value if value != null else ""
        #   len = strlen(src)
        #   lo  = min(start, len) if start > 0  else 0
        #   hi  = min(end,   len) if end  >= 0  else len
        #   hi  = lo if hi < lo
        #   {src + lo, hi - lo}
        #
        # Emitting `{base + start, end - start}` instead — no strlen, no clamp, no null
        # check — is a WRONG ANSWER at every boundary, and `end < 0` is not a corner case:
        # `__cast__(value: cstr?) -> sview` IS `sview(value, 0, -1)`, so every `x.sview()`
        # produced a view of length -1. An out-of-range span produced a view running off
        # the end of the string.
        #
        # The strlen is not optional and not an optimization loss: it is the bound every
        # clamp is measured against, and stage0 pays exactly the same call.
        def emit_normalized_cstr_source(base: LLVMValueRef, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            sview_ptr: LLVMTypeRef = LLVMPointerTypeInContext(ctx, 0)
            sview_empty_bytes: LLVMValueRef = LLVMConstStringInContext(ctx, "", 0, 0)
            sview_empty_global: LLVMValueRef =
                if LLVMGetNamedGlobal(m, ".elisa.cstr.empty") is existing_empty_global:
                    existing_empty_global
                else:
                    empty_global: LLVMValueRef = LLVMAddGlobal(m, LLVMTypeOf(sview_empty_bytes), ".elisa.cstr.empty")
                    LLVMSetInitializer(empty_global, sview_empty_bytes)
                    LLVMSetLinkage(empty_global, 9)
                    LLVMSetUnnamedAddress(empty_global, 2)
                    LLVMSetGlobalConstant(empty_global, 1)
                    empty_global
            sview_empty_indices: mutable darray[LLVMValueRef] = [LLVMConstInt(LLVMInt64TypeInContext(ctx), 0, 0), LLVMConstInt(LLVMInt64TypeInContext(ctx), 0, 0)]
            sview_empty_indices_pointer: void& = (&sview_empty_indices[0]).cast[void&] can Unsafe.PointerCast
            sview_empty: LLVMValueRef = LLVMConstInBoundsGEP2(LLVMGlobalGetValueType(sview_empty_global), sview_empty_global, sview_empty_indices_pointer, 2)
            sview_null: LLVMValueRef = LLVMBuildICmp(builder, LLVMIntPredicate::EQ, base, LLVMConstNull(sview_ptr), "sview.base.null")
            return LLVMBuildSelect(builder, sview_null, sview_empty, base, "sview.src")


        # Return strlen as i64 with the same target-usize conversion as runtime_strlen(...).i64().
        # On 64-bit this intentionally preserves the signed bit pattern for lengths above
        # INT64_MAX; SView construction applies its separate canonical-empty rule afterward.
        def emit_cstr_strlen_i64(source: LLVMValueRef, m: LLVMModuleRef, ctx: LLVMContextRef, target_bits: u32, builder: LLVMBuilderRef) -> LLVMValueRef can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            sview_i64: LLVMTypeRef = LLVMInt64TypeInContext(ctx)
            sview_ptr: LLVMTypeRef = LLVMPointerTypeInContext(ctx, 0)
            sview_strlen_type: LLVMTypeRef = LLVMInt32TypeInContext(ctx) if target_bits == 32 else sview_i64
            sview_len_params: mutable darray[LLVMTypeRef] = [sview_ptr]
            sview_len_params_pointer: void& = (&sview_len_params[0]).cast[void&] can Unsafe.PointerCast
            sview_len_fn_type: LLVMTypeRef = LLVMFunctionType(sview_strlen_type, sview_len_params_pointer, 1, 0)
            sview_len_fn: LLVMValueRef = declare_or_get_named(m, "strlen", sview_len_fn_type)
            sview_len_args: mutable darray[LLVMValueRef] = [source]
            sview_len_args_pointer: void& = (&sview_len_args[0]).cast[void&] can Unsafe.PointerCast
            sview_strlen_value: LLVMValueRef = LLVMBuildCall2(builder, sview_len_fn_type, sview_len_fn, sview_len_args_pointer, 1, "sview.srclen")
            return LLVMBuildZExt(builder, sview_strlen_value, sview_i64, "sview.srclen.i64") if target_bits == 32 else sview_strlen_value


        def emit_sview_from_parts(base: LLVMValueRef, start: LLVMValueRef, end: LLVMValueRef, sview_llvm: LLVMTypeRef, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef, target_bits: u32) -> LLVMValueRef can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            sview_i64: LLVMTypeRef = LLVMInt64TypeInContext(ctx)
            sview_ptr: LLVMTypeRef = LLVMPointerTypeInContext(ctx, 0)
            sview_zero: LLVMValueRef = LLVMConstInt(sview_i64, 0, 0)
            # libc strlen returns `size_t`, which is i32 on wasm32 and i64 on the
            # native targets used here. A stdlib `extern strlen(...) -> usize`
            # may already have declared the symbol in the module; declaring this
            # helper as i64 unconditionally made the later i64 call use an
            # incompatible i32 function. LLVM lowered that signature bitcast to
            # a trap stub (`strlen_bitcast_invalid`) in the browser. Match the
            # declaration's target ABI, then widen the unsigned result for the
            # helper's i64 clamp arithmetic.
            # A NULL base reads as the empty string — never a strlen of address 0.
            sview_src: LLVMValueRef = emit_normalized_cstr_source(base, m, ctx, builder)
            # libc `strlen`, not the runtime's `ctx_strlen`: the std's runtime_strlen is a
            # null-guard around this exact call (the guard is the select above), and LLVM
            # KNOWS this one — it carries readonly/willreturn, so a repeated strlen of the
            # same buffer folds. That matters here: the lexer builds a view per token off
            # one source pointer, and an opaque call would leave a full scan in each.
            sview_source_len: LLVMValueRef = emit_cstr_strlen_i64(sview_src, m, ctx, target_bits, builder)
            # `start > 0` is a SIGNED test; the bound test that follows it is UNSIGNED,
            # matching the std, where both sides are usize by then.
            sview_start_positive: LLVMValueRef = LLVMBuildICmp(builder, LLVMIntPredicate::SGT, start, sview_zero, "sview.start.pos")
            sview_start_over: LLVMValueRef = LLVMBuildICmp(builder, LLVMIntPredicate::UGT, start, sview_source_len, "sview.start.over")
            sview_start_clamped: LLVMValueRef = LLVMBuildSelect(builder, sview_start_over, sview_source_len, start, "sview.start.clamped")
            sview_lo: LLVMValueRef = LLVMBuildSelect(builder, sview_start_positive, sview_start_clamped, sview_zero, "sview.lo")
            # A NEGATIVE end means "to the end of the string".
            sview_end_bounded: LLVMValueRef = LLVMBuildICmp(builder, LLVMIntPredicate::SGE, end, sview_zero, "sview.end.bounded")
            sview_end_over: LLVMValueRef = LLVMBuildICmp(builder, LLVMIntPredicate::UGT, end, sview_source_len, "sview.end.over")
            sview_end_clamped: LLVMValueRef = LLVMBuildSelect(builder, sview_end_over, sview_source_len, end, "sview.end.clamped")
            sview_hi_raw: LLVMValueRef = LLVMBuildSelect(builder, sview_end_bounded, sview_end_clamped, sview_source_len, "sview.hi.raw")
            # An INVERTED span is empty, never a negative length.
            sview_hi_under: LLVMValueRef = LLVMBuildICmp(builder, LLVMIntPredicate::ULT, sview_hi_raw, sview_lo, "sview.hi.under")
            sview_hi: LLVMValueRef = LLVMBuildSelect(builder, sview_hi_under, sview_lo, sview_hi_raw, "sview.hi")
            sview_gep_indices: mutable darray[LLVMValueRef] = [sview_lo]
            sview_gep_pointer: void& = (&sview_gep_indices[0]).cast[void&] can Unsafe.PointerCast
            sview_data: LLVMValueRef = LLVMBuildGEP2(builder, LLVMInt8TypeInContext(ctx), sview_src, sview_gep_pointer, 1, "sview.data")
            sview_length: LLVMValueRef = LLVMBuildSub(builder, sview_hi, sview_lo, "sview.len")
            # The runtime converts the resulting usize extent to signed i64 and
            # canonicalizes an unrepresentable result to `{src, 0}`. Check the
            # subtraction result (not the full source length): a very large source
            # may still produce a valid short slice. On 32-bit, every usize extent
            # fits in signed i64 after the widening above.
            sview_length_valid: LLVMValueRef = LLVMBuildICmp(builder, LLVMIntPredicate::SGE, sview_length, sview_zero, "sview.len.representable") if target_bits == 64 else LLVMConstInt(LLVMInt1TypeInContext(ctx), 1, 0)
            sview_result_data: LLVMValueRef = LLVMBuildSelect(builder, sview_length_valid, sview_data, sview_src, "sview.data.canonical") if target_bits == 64 else sview_data
            sview_result_length: LLVMValueRef = LLVMBuildSelect(builder, sview_length_valid, sview_length, sview_zero, "sview.len.canonical") if target_bits == 64 else sview_length
            sview_agg: mutable LLVMValueRef = LLVMGetUndef(sview_llvm)
            sview_agg <- LLVMBuildInsertValue(builder, sview_agg, sview_result_data, 0, "sview.ins0")
            sview_agg <- LLVMBuildInsertValue(builder, sview_agg, sview_result_length, 1, "sview.ins1")
            return sview_agg


        def emit_call[@scope_region, @fns_region, @structs_region, @generics_region, @runtime_region](callee: Expr, arguments: darray[Expr]&, argument_names: darray[sview @source], local_scope: mutable Scope& @scope_region, fns: FnTable& @fns_region, structs: mutable StructTable& @structs_region, generics: mutable GenericTable& @generics_region, runtime: Runtime& @runtime_region, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            # Task/TaskGroup values retain pool completion state, and a ThreadPool is shut
            # down by its lexical scope. Passing any of these values to an arbitrary helper
            # could let it retain a handle beyond cleanup. Only the proven synchronous consumers
            # (`pool_await`, `task_group_wait_all`) and the checked ownership transfer
            # (`task_group_add`) are exempt. The source-level `await` form lowers through the
            # dedicated Expr.Block path; ordinary calls fail closed until call effects carry
            # pool-lifetime ownership.
            if local_scope.pool_names.count > 0 or local_scope.group_names.count > 0:
                if not backend_is_trusted_pool_await_call(callee, arguments, local_scope, fns, structs, generics) and not backend_is_trusted_task_group_add_call(callee, arguments, local_scope, fns, structs, generics) and not backend_is_trusted_task_group_wait_call(callee, arguments, local_scope, fns, structs, generics):
                    # UFCS/method calls pass the expression left of `.method` as a hidden
                    # first argument, separate from `arguments`; include it in the same
                    # escape check so `task.method()` or `pool.method()` cannot bypass it.
                    match callee:
                        Expr.Field(task_escape_receiver, _, _):
                            if backend_expression_may_contain_pool_lifetime_handle(task_escape_receiver, expression_type(task_escape_receiver, local_scope, fns, structs, generics), local_scope, fns, structs, generics):
                                return null
                        _:
                            pass
                    for task_escape_argument in arguments |local_scope, fns, structs, generics|:
                        if backend_expression_may_contain_pool_lifetime_handle(task_escape_argument, expression_type(task_escape_argument, local_scope, fns, structs, generics), local_scope, fns, structs, generics):
                            return null
            # `va_arg[T](storage)` is a compiler-owned typed primitive. LLVM
            # represents it as an instruction, not a linkable intrinsic or
            # runtime function, so it must be lowered before ordinary generic
            # call resolution can manufacture an extern symbol.
            if callee is Expr.Index(va_arg_head, va_arg_type, va_arg_line):
                if va_arg_head is Expr.Ident(va_arg_name, va_arg_name_line):
                    if va_arg_name == "va_arg":
                        va_arg_result: ValueType = annotation_value_type(va_arg_type, structs)
                        return null if va_arg_result.kind == TypeKind.Unmodeled or arguments.count != 1.usize()
                        if (emit_expression(arguments[0], unmodeled_type(), local_scope, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}) is va_arg_storage:
                            va_arg_result_llvm: LLVMTypeRef = llvm_type_of(va_arg_result, structs, ctx)
                            return LLVMBuildVAArg(builder, va_arg_storage, va_arg_result_llvm, "va_arg")
            if callee is Expr.IndexN(va_arg_head, va_arg_types, va_arg_line):
                if va_arg_head is Expr.Ident(va_arg_name, va_arg_name_line):
                    if va_arg_name == "va_arg":
                        return null if va_arg_types.count != 1.usize() or arguments.count != 1.usize()
                        va_arg_result: ValueType = annotation_value_type(va_arg_types[0], structs)
                        return null if va_arg_result.kind == TypeKind.Unmodeled
                        if (emit_expression(arguments[0], unmodeled_type(), local_scope, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}) is va_arg_storage:
                            va_arg_result_llvm: LLVMTypeRef = llvm_type_of(va_arg_result, structs, ctx)
                            return LLVMBuildVAArg(builder, va_arg_storage, va_arg_result_llvm, "va_arg")
            # `llvm_va_copy(destination, source)` is the translator's generic
            # spelling for C's `__builtin_va_copy`. LLVM overloads the intrinsic
            # by the pointer address space, so resolve it explicitly instead of
            # allowing ordinary extern declaration logic to invent a symbol.
            if callee is Expr.Ident(va_copy_name, va_copy_line):
                if va_copy_name == "llvm_va_copy" and arguments.count == 2.usize():
                    if (emit_expression(arguments[0], unmodeled_type(), local_scope, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}) is va_copy_destination:
                        if (emit_expression(arguments[1], unmodeled_type(), local_scope, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}) is va_copy_source:
                            va_copy_intrinsic_name: sview = "llvm.va_copy"
                            va_copy_intrinsic_storage: mutable darray[u8] = []
                            va_copy_intrinsic_cstr: cstr = sview_to_cstr(va_copy_intrinsic_name, va_copy_intrinsic_storage)
                            va_copy_intrinsic_id: u32 = LLVMLookupIntrinsicID(va_copy_intrinsic_cstr, va_copy_intrinsic_name.len)
                            return null if va_copy_intrinsic_id == 0
                            va_copy_overload_types: mutable darray[LLVMTypeRef] = [LLVMTypeOf(va_copy_destination)]
                            va_copy_overload_pointer: void& = (&va_copy_overload_types[0]).cast[void&] can Unsafe.PointerCast
                            va_copy_intrinsic: LLVMValueRef = LLVMGetIntrinsicDeclaration(m, va_copy_intrinsic_id, va_copy_overload_pointer, 1)
                            return null if va_copy_intrinsic == zeroed
                            va_copy_arguments: mutable darray[LLVMValueRef] = [va_copy_destination, va_copy_source]
                            va_copy_arguments_pointer: void& = (&va_copy_arguments[0]).cast[void&] can Unsafe.PointerCast
                            return LLVMBuildCall2(builder, LLVMGlobalGetValueType(va_copy_intrinsic), va_copy_intrinsic, va_copy_arguments_pointer, 2, "")
            # `dense_key(node, frozen)` — the node's DENSE key. stage0 builds
            # `insertvalue %NodeKey__Expr undef, i32 %node, 0`; with NodeKey erased to its
            # single i32 field the key IS the handle, so this is just the node emitted at
            # i32. The store argument only fixes the key's type and is never read.
            #
            # FIRST in the function on purpose: the ordinary Ident dispatch below resolves
            # against the FnTable and returns null for a builtin name, which swallowed this
            # branch when it sat lower down -- the same placement mistake that cost three
            # attempts on `frozen[N]`.
            if callee is Expr.Ident(dense_key_name, dense_key_line):
                if dense_key_name == "dense_key" and arguments.count == 2:
                    return emit_expression(arguments[0], ValueType{kind: TypeKind.Signed, bits: 32}, local_scope, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}
                # `Event(code)` — the PREFIX spelling of a `__cast__` hook whose target is an
                # enum. docs/18: `T(x)` and `x.T()` share one hook lookup. The name is a TYPE,
                # so the FnTable dispatch below finds nothing and declines; claim it here when
                # an exact (source, target) hook exists, and leave everything else alone.
                if arguments.count == 1:
                    prefix_cast_target: ValueType = cast_hook_target_type(dense_key_name, structs)
                    if prefix_cast_target.kind != TypeKind.Unmodeled:
                        prefix_cast_source: ValueType = resolve_type(arguments[0], ValueType{kind: TypeKind.Signed, bits: 64}, local_scope, fns, structs, generics)
                        if cast_hook_index(fns, prefix_cast_source, prefix_cast_target) >= 0:
                            prefix_cast_names: mutable darray[sview @source] = []
                            return emit_direct_call("", "__cast__", callee, false, true, arguments, prefix_cast_names, local_scope, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}
            # `node_table_fill[Expr, i32](owner, frozen, -1)` — allocate a dense side table
            # over a frozen store and fill it. stage0: read the store's node COUNT, and on a
            # non-zero count `arena_alloc(owner, count * sizeof(V))` + `arena_da_fill(view,
            # init)`, yielding a `{ptr, len}` view; a zero count yields a zeroinitializer.
            # With NodeTable erased to that view (see the annotation side), the result IS the
            # view, so `table[key]` and `table.values` need no cases of their own.
            #
            # FIRST in the function, like dense_key: the generic-call dispatch below would
            # claim the IndexN callee and decline on an unknown template.
            if callee is Expr.IndexN(ntf_head, ntf_type_args, ntf_head_line):
                if ntf_head is Expr.Ident(ntf_name, ntf_name_line):
                    if ntf_name == "node_table_fill" and ntf_type_args.count == 2 and arguments.count == 3:
                        ntf_element: ValueType = annotation_value_type(ntf_type_args[1], structs)
                        return null if ntf_element.kind == TypeKind.Unmodeled or ntf_element.kind == TypeKind.Void
                        ntf_store_type: ValueType = expression_type(arguments[1], local_scope, fns, structs, generics)
                        return null if:
                            ntf_store_type.kind != TypeKind.PackedStore
                            runtime.packed_mode == 2
                        if (emit_expression(arguments[1], ntf_store_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}) is ntf_store_value:
                            ntf_state: LLVMValueRef = LLVMBuildExtractValue(builder, ntf_store_value, 2, "node.table.state")
                            # Call arguments are eager even when the store is empty. Emit the
                            # initializer before selecting the allocation/fill path so its
                            # effects are preserved for a zero-row store as well.
                            if (emit_expression(arguments[2], ntf_element, local_scope, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}) is ntf_init:
                                ntf_ptr_type: LLVMTypeRef = LLVMPointerTypeInContext(ctx, 0)
                                ntf_count_params: mutable darray[LLVMTypeRef] = [ntf_ptr_type]
                                ntf_count_params_ptr: void& = (&ntf_count_params[0]).cast[void&] can Unsafe.PointerCast
                                ntf_size_type: LLVMTypeRef = runtime_size_llvm_type(ctx, structs.target.target_pointer_bits)
                                ntf_count_type: LLVMTypeRef = LLVMFunctionType(ntf_size_type, ntf_count_params_ptr, 1, 0)
                                ntf_count_fn: LLVMValueRef = declare_or_get_named(m, "ctx_packed_store_count", ntf_count_type)
                                ntf_count_args: mutable darray[LLVMValueRef] = [ntf_state]
                                ntf_count_args_ptr: void& = (&ntf_count_args[0]).cast[void&] can Unsafe.PointerCast
                                ntf_count_native: LLVMValueRef = LLVMBuildCall2(builder, ntf_count_type, ntf_count_fn, ntf_count_args_ptr, 1, "node.table.count")
