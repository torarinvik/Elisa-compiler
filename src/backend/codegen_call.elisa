# Stage1 backend — the call emitters: `emit_call`'s dispatch and `emit_direct_call`'s ABI marshalling.
# Part of `module Backend` (see codegen.elisa); split out to keep each file short.

extend Backend:
    private:
        # Build the `{ptr, i64 len}` aggregate for `sview(base, start, end)` — the exact
        # semantics of the std constructor stage0 CALLS
        # (elisacore_std/elisacore_runtime_strings.elisa:203):
        #
        #   src = value if value != null else ""
        #   len = strlen(src)
        #   lo  = min(start, len) if start > 0  else 0
        #   hi  = min(end,   len) if end  >= 0  else len
        #   hi  = lo if hi < lo
        #   {src + lo, hi - lo}
        #
        # Emitting `{base + start, end - start}` instead — no strlen, no clamp, no null
        # check — is a WRONG ANSWER at every boundary, and `end < 0` is not a corner case:
        # `__cast__(value: u8&?) -> sview` IS `sview(value, 0, -1)`, so every `x.sview()`
        # produced a view of length -1. An out-of-range span produced a view running off
        # the end of the string.
        #
        # The strlen is not optional and not an optimization loss: it is the bound every
        # clamp is measured against, and stage0 pays exactly the same call.
        def emit_sview_from_parts(base: LLVMValueRef, start: LLVMValueRef, end: LLVMValueRef, sview_llvm: LLVMTypeRef, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            sview_i64: LLVMTypeRef = LLVMInt64TypeInContext(ctx)
            sview_ptr: LLVMTypeRef = LLVMPointerTypeInContext(ctx, 0)
            sview_zero: LLVMValueRef = LLVMConstInt(sview_i64, 0, 0)
            # A NULL base reads as the empty string — never a strlen of address 0.
            sview_empty: LLVMValueRef = LLVMBuildGlobalStringPtr(builder, "", "sview.empty")
            sview_null: LLVMValueRef = LLVMBuildICmp(builder, 32, base, LLVMConstNull(sview_ptr), "sview.base.null")
            sview_src: LLVMValueRef = LLVMBuildSelect(builder, sview_null, sview_empty, base, "sview.src")
            sview_len_params: mutable darray[LLVMTypeRef] = [sview_ptr]
            sview_len_params_pointer: void& = (&sview_len_params[0]).cast[void&] can Unsafe.PointerCast
            sview_len_fn_type: LLVMTypeRef = LLVMFunctionType(sview_i64, sview_len_params_pointer, 1, 0)
            # libc `strlen`, not the runtime's `ctx_strlen`: the std's runtime_strlen is a
            # null-guard around this exact call (the guard is the select above), and LLVM
            # KNOWS this one — it carries readonly/willreturn, so a repeated strlen of the
            # same buffer folds. That matters here: the lexer builds a view per token off
            # one source pointer, and an opaque call would leave a full scan in each.
            sview_len_fn: LLVMValueRef = declare_or_get_named(m, "strlen", sview_len_fn_type)
            sview_len_args: mutable darray[LLVMValueRef] = [sview_src]
            sview_len_args_pointer: void& = (&sview_len_args[0]).cast[void&] can Unsafe.PointerCast
            sview_source_len: LLVMValueRef = LLVMBuildCall2(builder, sview_len_fn_type, sview_len_fn, sview_len_args_pointer, 1, "sview.srclen")
            # `start > 0` is a SIGNED test; the bound test that follows it is UNSIGNED,
            # matching the std, where both sides are usize by then.
            sview_start_positive: LLVMValueRef = LLVMBuildICmp(builder, 38, start, sview_zero, "sview.start.pos")
            sview_start_over: LLVMValueRef = LLVMBuildICmp(builder, 34, start, sview_source_len, "sview.start.over")
            sview_start_clamped: LLVMValueRef = LLVMBuildSelect(builder, sview_start_over, sview_source_len, start, "sview.start.clamped")
            sview_lo: LLVMValueRef = LLVMBuildSelect(builder, sview_start_positive, sview_start_clamped, sview_zero, "sview.lo")
            # A NEGATIVE end means "to the end of the string".
            sview_end_bounded: LLVMValueRef = LLVMBuildICmp(builder, 39, end, sview_zero, "sview.end.bounded")
            sview_end_over: LLVMValueRef = LLVMBuildICmp(builder, 34, end, sview_source_len, "sview.end.over")
            sview_end_clamped: LLVMValueRef = LLVMBuildSelect(builder, sview_end_over, sview_source_len, end, "sview.end.clamped")
            sview_hi_raw: LLVMValueRef = LLVMBuildSelect(builder, sview_end_bounded, sview_end_clamped, sview_source_len, "sview.hi.raw")
            # An INVERTED span is empty, never a negative length.
            sview_hi_under: LLVMValueRef = LLVMBuildICmp(builder, 36, sview_hi_raw, sview_lo, "sview.hi.under")
            sview_hi: LLVMValueRef = LLVMBuildSelect(builder, sview_hi_under, sview_lo, sview_hi_raw, "sview.hi")
            sview_gep_indices: mutable darray[LLVMValueRef] = [sview_lo]
            sview_gep_pointer: void& = (&sview_gep_indices[0]).cast[void&] can Unsafe.PointerCast
            sview_data: LLVMValueRef = LLVMBuildGEP2(builder, LLVMInt8TypeInContext(ctx), sview_src, sview_gep_pointer, 1, "sview.data")
            sview_agg: mutable LLVMValueRef = LLVMGetUndef(sview_llvm)
            sview_agg <- LLVMBuildInsertValue(builder, sview_agg, sview_data, 0, "sview.ins0")
            sview_agg <- LLVMBuildInsertValue(builder, sview_agg, LLVMBuildSub(builder, sview_hi, sview_lo, "sview.len"), 1, "sview.ins1")
            return sview_agg


        def emit_call(callee: Expr, arguments: darray[Expr]&, argument_names: darray[sview], local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            # `dense_key(node, frozen)` — the node's DENSE key. stage0 builds
            # `insertvalue %NodeKey__Expr undef, i32 %node, 0`; with NodeKey erased to its
            # single i32 field the key IS the handle, so this is just the node emitted at
            # i32. The store argument only fixes the key's type and is never read.
            #
            # FIRST in the function on purpose: the ordinary Ident dispatch below resolves
            # against the FnTable and returns null for a builtin name, which swallowed this
            # branch when it sat lower down -- the same placement mistake that cost three
            # attempts on `frozen[N]`.
            if callee is Expr.Ident(dense_key_name, dense_key_line):
                if dense_key_name == "dense_key" and arguments.count == 2:
                    return emit_expression(arguments[0], ValueType{kind: TypeKind.Signed, bits: 32}, local_scope, fns, structs, generics, runtime, m, ctx, builder)
            # `node_table_fill[Expr, i32](owner, frozen, -1)` — allocate a dense side table
            # over a frozen store and fill it. stage0: read the store's node COUNT, and on a
            # non-zero count `arena_alloc(owner, count * sizeof(V))` + `arena_da_fill(view,
            # init)`, yielding a `{ptr, len}` view; a zero count yields a zeroinitializer.
            # With NodeTable erased to that view (see the annotation side), the result IS the
            # view, so `table[key]` and `table.values` need no cases of their own.
            #
            # FIRST in the function, like dense_key: the generic-call dispatch below would
            # claim the IndexN callee and decline on an unknown template.
            if callee is Expr.IndexN(ntf_head, ntf_type_args, ntf_head_line):
                if ntf_head is Expr.Ident(ntf_name, ntf_name_line):
                    if ntf_name == "node_table_fill" and ntf_type_args.count == 2 and arguments.count == 3:
                        ntf_element: ValueType = annotation_value_type(ntf_type_args[1], structs)
                        null return if ntf_element.kind == TypeKind.Unmodeled or ntf_element.bits == 0
                        ntf_store_type: ValueType = expression_type(arguments[1], local_scope, fns, structs, generics)
                        null return if ntf_store_type.kind != TypeKind.PackedStore
                        null return if runtime.packed_mode == 2
                        if emit_expression(arguments[1], ntf_store_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is ntf_store_value:
                            ntf_state: LLVMValueRef = LLVMBuildExtractValue(builder, ntf_store_value, 2, "node.table.state")
                            ntf_i64: LLVMTypeRef = LLVMInt64TypeInContext(ctx)
                            ntf_ptr_type: LLVMTypeRef = LLVMPointerTypeInContext(ctx, 0)
                            ntf_count_params: mutable darray[LLVMTypeRef] = [ntf_ptr_type]
                            ntf_count_params_ptr: void& = (&ntf_count_params[0]).cast[void&] can Unsafe.PointerCast
                            ntf_count_type: LLVMTypeRef = LLVMFunctionType(ntf_i64, ntf_count_params_ptr, 1, 0)
                            ntf_count_fn: LLVMValueRef = declare_or_get_named(m, "ctx_packed_store_count", ntf_count_type)
                            ntf_count_args: mutable darray[LLVMValueRef] = [ntf_state]
                            ntf_count_args_ptr: void& = (&ntf_count_args[0]).cast[void&] can Unsafe.PointerCast
                            ntf_count: LLVMValueRef = LLVMBuildCall2(builder, ntf_count_type, ntf_count_fn, ntf_count_args_ptr, 1, "node.table.count")
                            ntf_stride: u64 = (ntf_element.bits / 8).u64() if ntf_element.bits >= 8 else 1.u64()
                            ntf_bytes: LLVMValueRef = LLVMBuildMul(builder, ntf_count, LLVMConstInt(ntf_i64, ntf_stride, 0), "node.table.bytes")
                            ntf_arena: LLVMValueRef = call_site_arena(arguments, local_scope, runtime)
                            ntf_alloc_params: mutable darray[LLVMTypeRef] = [ntf_ptr_type, ntf_i64]
                            ntf_alloc_params_ptr: void& = (&ntf_alloc_params[0]).cast[void&] can Unsafe.PointerCast
                            ntf_alloc_type: LLVMTypeRef = LLVMFunctionType(ntf_ptr_type, ntf_alloc_params_ptr, 2, 0)
                            ntf_alloc_fn: LLVMValueRef = declare_or_get_named(m, "arena_alloc", ntf_alloc_type)
                            ntf_alloc_args: mutable darray[LLVMValueRef] = [ntf_arena, ntf_bytes]
                            ntf_alloc_args_ptr: void& = (&ntf_alloc_args[0]).cast[void&] can Unsafe.PointerCast
                            ntf_data: LLVMValueRef = LLVMBuildCall2(builder, ntf_alloc_type, ntf_alloc_fn, ntf_alloc_args_ptr, 2, "node.table.alloc")
                            ntf_view_type: LLVMTypeRef = llvm_type_of(intern_view_type(ntf_element, structs), structs, ctx)
                            ntf_view: mutable LLVMValueRef = LLVMBuildInsertValue(builder, LLVMGetUndef(ntf_view_type), ntf_data, 0, "node.table.view.data")
                            ntf_view <- LLVMBuildInsertValue(builder, ntf_view, ntf_count, 1, "node.table.view.len")
                            if emit_expression(arguments[2], ntf_element, local_scope, fns, structs, generics, runtime, m, ctx, builder) is ntf_init:
                                ntf_fill_params: mutable darray[LLVMTypeRef] = [ntf_view_type, llvm_type_of(ntf_element, structs, ctx)]
                                ntf_fill_params_ptr: void& = (&ntf_fill_params[0]).cast[void&] can Unsafe.PointerCast
                                ntf_fill_type: LLVMTypeRef = LLVMFunctionType(LLVMVoidTypeInContext(ctx), ntf_fill_params_ptr, 2, 0)
                                ntf_fill_fn: LLVMValueRef = declare_or_get_named(m, "arena_da_fill", ntf_fill_type)
                                ntf_fill_args: mutable darray[LLVMValueRef] = [ntf_view, ntf_init]
                                ntf_fill_args_ptr: void& = (&ntf_fill_args[0]).cast[void&] can Unsafe.PointerCast
                                _ = LLVMBuildCall2(builder, ntf_fill_type, ntf_fill_fn, ntf_fill_args_ptr, 2, "")
                                return ntf_view
                            return null
                        return null
            # `B.make(value)` inside `def f[B: Builder]` — STATIC protocol dispatch through a
            # bound type parameter. An impl body flattens into ordinary top-level functions, so
            # once B is bound the method is reachable by its bare name; the head is a bound
            # generic and not a value, which is what distinguishes this from UFCS.
            #
            # Gated on the unit declaring exactly ONE impl: with two, the bare name is
            # ambiguous and picking either would silently dispatch to the wrong one.
            #
            # That gate is right about the HAZARD and too coarse about the REMEDY. It asks
            # whether the UNIT is unambiguous when the question is whether THIS CALL is: T is
            # BOUND while the instantiation is being emitted, so the arguments have concrete
            # types and ordinary overload resolution can name the impl. Ask for a UNIQUE
            # exact match and the ambiguity is settled per call rather than per program —
            # `impl Tagged for i64` beside `impl Tagged for f64` dispatches correctly where
            # the old gate declined outright.
            #
            # Unique, not merely first: stage1 models `char`, `int`, `i64` and `isize` as ONE
            # ValueType (Signed/64), so the std's `impl Str for char` and `impl Str for i64`
            # are genuinely indistinguishable here — taking the first made `print(42)` print
            # "*" (chr(42)), which is exactly the silent wrong dispatch the single-impl gate
            # was protecting against. An ambiguous set falls through and declines.
            if callee is Expr.Field(protocol_head, protocol_method, protocol_method_line):
                if protocol_head is Expr.Ident(protocol_parameter, protocol_parameter_line):
                    if bound_type_of(structs, protocol_parameter).kind != TypeKind.Unmodeled:
                        if structs.impl_concrete_names.count == 1.usize() and function_index_of(fns, "", protocol_method) >= 0:
                            return emit_call((Expr.Ident(protocol_method, protocol_method_line)), arguments, argument_names, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                        if overload_match_count(fns, "", protocol_method, arguments, local_scope, structs, generics) == 1:
                            return emit_call((Expr.Ident(protocol_method, protocol_method_line)), arguments, argument_names, local_scope, fns, structs, generics, runtime, m, ctx, builder)
            # `f[i64](x)` — an EXPLICIT type argument makes the callee an Index, not an
            # Ident; the bracket holds a TYPE, so it resolves as an annotation.
            if callee is Expr.Index(generic_callee, generic_argument, generic_call_line):
                if generic_callee is Expr.Ident(explicit_name, explicit_name_line):
                    if explicit_name == "darray_pop" and arguments.count == 1:
                        explicit_pop_type: ValueType = darray_type_behind_expr(arguments[0], local_scope, structs)
                        if explicit_pop_type.kind == TypeKind.DArray:
                            if darray_address_of_expr(arguments[0], local_scope, fns, structs, generics, runtime, m, ctx, builder) is explicit_pop_slot:
                                return emit_darray_pop_value(explicit_pop_slot, explicit_pop_type, structs, m, ctx, builder)
                        return null
                    explicit_type: ValueType = annotation_value_type(generic_argument, structs)
                    null return if explicit_type.kind == TypeKind.Unmodeled
                    null return if generic_index_of(generics, explicit_name) < 0
                    explicit_args: mutable darray[ValueType] = [explicit_type]
                    return emit_generic_call(explicit_name, explicit_args, arguments, argument_names, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                return null
            # `f[K, V](x)` — EXPLICIT multi-argument type application. The callee is an
            # IndexN whose bracket holds the type arguments.
            if callee is Expr.IndexN(multi_generic_callee, multi_generic_args, multi_generic_line):
                if multi_generic_callee is Expr.Ident(multi_name, multi_name_line):
                    null return if generic_index_of(generics, multi_name) < 0
                    multi_type_args: mutable darray[ValueType] = []
                    multi_declined: mutable bool = false
                    for type_argument_expression in multi_generic_args |multi_type_args, multi_declined, structs|:
                        resolved_type_argument: ValueType = annotation_value_type(type_argument_expression, structs)
                        multi_declined <- true if resolved_type_argument.kind == TypeKind.Unmodeled
                        multi_type_args.push(resolved_type_argument)
                    null return if multi_declined
                    return emit_generic_call(multi_name, multi_type_args, arguments, argument_names, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                return null
            # `xs.pop()` is a value-producing darray operation. Lower it before ordinary UFCS
            # lookup so stage1 does not manufacture an unresolved `darray_pop[T]` declaration.
            if callee is Expr.Field(pop_object, pop_method, pop_line):
                if pop_method == "pop" and arguments.count == 0:
                    pop_array_type: ValueType = darray_type_behind_expr(pop_object, local_scope, structs)
                    if pop_array_type.kind == TypeKind.DArray:
                        if darray_address_of_expr(pop_object, local_scope, fns, structs, generics, runtime, m, ctx, builder) is pop_slot:
                            return emit_darray_pop_value(pop_slot, pop_array_type, structs, m, ctx, builder)
                    return null
            if callee is Expr.Ident(callee_name, callee_line):
                # UFCS lowering may present `items.pop()` as the normalized free call
                # `pop(items)` rather than retaining the Field callee. Keep the darray
                # fast path on both shapes; otherwise recursive AST containers fall back
                # to a generic `darray_pop[T]` instantiation whose aggregate body may be
                # declined by the self-host backend.
                if callee_name == "pop" and arguments.count == 1:
                    normalized_pop_type: ValueType = darray_type_behind_expr(arguments[0], local_scope, structs)
                    if normalized_pop_type.kind == TypeKind.DArray:
                        if darray_address_of_expr(arguments[0], local_scope, fns, structs, generics, runtime, m, ctx, builder) is normalized_pop_slot:
                            return emit_darray_pop_value(normalized_pop_slot, normalized_pop_type, structs, m, ctx, builder)
                # `ctx_hash_value(key)` — the compiler-emitted hash builtin (no user function
                # of that name exists), lowered per the key's concrete type.
                if callee_name == "ctx_hash_value" and arguments.count == 1:
                    return emit_hash_builtin(arguments[0], local_scope, fns, structs, generics, runtime, m, ctx, builder)
                # `__fstr(pieces…)` — the f-string builder desugared from `f"…"`.
                if callee_name == "__fstr":
                    return emit_fstr_builtin(arguments, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                # `size_of(T)` — the type's byte size as a compile-time constant (its argument
                # is a TYPE, so it resolves as an annotation). The dict grow path sizes its
                # bucket array with `size_of(DictBucket[K, T])`.
                if callee_name == "size_of" and arguments.count == 1:
                    size_of_type: ValueType = annotation_value_type(arguments[0], structs)
                    null return if size_of_type.kind == TypeKind.Unmodeled
                    return LLVMSizeOf(llvm_type_of(size_of_type, structs, ctx))
                # `sview(base, start, end)` — construct a string view `{ptr, len}` (stage0
                # `%StringView`). Used heavily by the self-host frontend (`empty_sview`,
                # token spans). Inline the aggregate rather than calling the runtime helper
                # so the product corpus does not depend on a pre-linked `@sview` when the
                # stage1 backend itself is the code under emission.
                # `readonly(v)` is a TYPE-LEVEL marker with no representation: stage0 stores the
                # operand straight through (`store %DynArrayView %whole2, ptr %ro`), no call and
                # no conversion. Emitting it as the identity is what lets a readonly view be
                # bound, sliced and passed on; without it every function taking one declined.
                # `split_at(v, n)` — the halves `v[0:n]` and `v[n:len]`, as a `{left, right}`
                # pair. Built inline: both halves are ordinary view slices, so there is no
                # runtime helper to call.
                if callee_name == "split_at" and arguments.count == 2:
                    split_view_type: ValueType = expression_type(arguments[0], local_scope, fns, structs, generics)
                    null return if split_view_type.kind != TypeKind.View
                    split_element: ValueType = view_element_of(split_view_type, structs)
                    split_result: ValueType = synthesize_split_view(split_element, structs)
                    null return if split_result.kind != TypeKind.Struct
                    if emit_expression(arguments[0], split_view_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is split_base:
                        if emit_expression(arguments[1], ValueType{kind: TypeKind.Signed, bits: 64}, local_scope, fns, structs, generics, runtime, m, ctx, builder) is split_at_index:
                            split_i64: LLVMTypeRef = LLVMInt64TypeInContext(ctx)
                            split_element_llvm: LLVMTypeRef = llvm_type_of(split_element, structs, ctx)
                            split_view_llvm: LLVMTypeRef = llvm_type_of(split_view_type, structs, ctx)
                            split_data: LLVMValueRef = LLVMBuildExtractValue(builder, split_base, 0, "split.data")
                            split_len: LLVMValueRef = LLVMBuildExtractValue(builder, split_base, 1, "split.len")
                            split_left: mutable LLVMValueRef = LLVMGetUndef(split_view_llvm)
                            split_left <- LLVMBuildInsertValue(builder, split_left, split_data, 0, "split.left.data")
                            split_left <- LLVMBuildInsertValue(builder, split_left, split_at_index, 1, "split.left.len")
                            split_right_offsets: mutable darray[LLVMValueRef] = [split_at_index]
                            split_right_pointer: void& = (&split_right_offsets[0]).cast[void&] can Unsafe.PointerCast
                            split_right_data: LLVMValueRef = LLVMBuildGEP2(builder, split_element_llvm, split_data, split_right_pointer, 1, "split.right.data")
                            split_right: mutable LLVMValueRef = LLVMGetUndef(split_view_llvm)
                            split_right <- LLVMBuildInsertValue(builder, split_right, split_right_data, 0, "split.right.data.ins")
                            split_right <- LLVMBuildInsertValue(builder, split_right, LLVMBuildSub(builder, split_len, split_at_index, "split.right.len"), 1, "split.right.len.ins")
                            split_pair: mutable LLVMValueRef = LLVMGetUndef(llvm_type_of(split_result, structs, ctx))
                            split_pair <- LLVMBuildInsertValue(builder, split_pair, split_left, 0, "split.pair.left")
                            split_pair <- LLVMBuildInsertValue(builder, split_pair, split_right, 1, "split.pair.right")
                            _ = split_i64
                            return split_pair
                    return null
                # `reduce_sum(v, f, extra…)` — fold a view through `f`, summing the results.
                # stage0 emits a plain counted loop with two phis (index and accumulator),
                # calling `f(elem, extra…)` per element; there is no runtime helper.
                if callee_name == "reduce_sum" and arguments.count >= 2:
                    reduce_view_type: ValueType = expression_type(arguments[0], local_scope, fns, structs, generics)
                    null return if reduce_view_type.kind != TypeKind.View
                    reduce_element: ValueType = view_element_of(reduce_view_type, structs)
                    null return if reduce_element.kind == TypeKind.Unmodeled
                    if emit_expression(arguments[0], reduce_view_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is reduce_source:
                        reduce_i64: LLVMTypeRef = LLVMInt64TypeInContext(ctx)
                        reduce_elem_llvm: LLVMTypeRef = llvm_type_of(reduce_element, structs, ctx)
                        reduce_data: LLVMValueRef = LLVMBuildExtractValue(builder, reduce_source, 0, "reduce_sum.src.data")
                        reduce_total: LLVMValueRef = LLVMBuildExtractValue(builder, reduce_source, 1, "reduce_sum.total")
                        reduce_index: LLVMValueRef = LLVMBuildAlloca(builder, reduce_i64, "reduce_sum.i")
                        _ = LLVMBuildStore(builder, LLVMConstInt(reduce_i64, 0, 0), reduce_index)
                        reduce_acc: LLVMValueRef = LLVMBuildAlloca(builder, reduce_elem_llvm, "reduce_sum.acc")
                        _ = LLVMBuildStore(builder, LLVMConstNull(reduce_elem_llvm), reduce_acc)
                        reduce_function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                        reduce_cond: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, reduce_function, "reduce_sum.cond")
                        reduce_body: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, reduce_function, "reduce_sum.body")
                        reduce_end: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, reduce_function, "reduce_sum.end")
                        _ = LLVMBuildBr(builder, reduce_cond)
                        LLVMPositionBuilderAtEnd(builder, reduce_cond)
                        reduce_at: LLVMValueRef = LLVMBuildLoad2(builder, reduce_i64, reduce_index, "reduce_sum.index")
                        # 36 = ULT: a view length is unsigned, as stage0 reads it.
                        _ = LLVMBuildCondBr(builder, LLVMBuildICmp(builder, 36, reduce_at, reduce_total, "reduce_sum.has_more"), reduce_body, reduce_end)
                        LLVMPositionBuilderAtEnd(builder, reduce_body)
                        reduce_offsets: mutable darray[LLVMValueRef] = [reduce_at]
                        reduce_offsets_pointer: void& = (&reduce_offsets[0]).cast[void&] can Unsafe.PointerCast
                        reduce_elem_ptr: LLVMValueRef = LLVMBuildGEP2(builder, reduce_elem_llvm, reduce_data, reduce_offsets_pointer, 1, "reduce_sum.src.ptr")
