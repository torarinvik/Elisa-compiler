extend Backend:
    private:
        def emit_vardecl_get_else[@scope_region, @loops_region, @regions_region, @fns_region, @structs_region, @generics_region](statement: Stmt, return_type: ValueType, local_scope: mutable Scope& @scope_region, loops: mutable LoopStack& @loops_region, regions: mutable RegionStack& @regions_region, fns: FnTable& @fns_region, structs: mutable StructTable& @structs_region, generics: mutable GenericTable& @generics_region, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef, handled: mutable bool&) -> EmitStatus can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            if statement is Stmt.VarDecl(var_name, var_type, var_value, var_line):
                if var_value is Expr.GetElse(get_guarded, get_recovery, get_line):
                    # `try f(x) else err: BLOCK` parses to the SAME node as `get`, but its
                    # guarded expression is an ERROR-returning call rather than an optional:
                    # the recovery runs on a nonzero status code, not on an absent payload.
                    # (The `err` binder is dropped by the parser, so a body that names it
                    # declines downstream on the unresolved ident rather than reading garbage.)
                    if get_recovery.count > 0:
                        if get_guarded is Expr.Call(try_else_callee, try_else_args, try_else_names, try_else_line):
                            # A QUALIFIED callee here (`try WasmBrowser::Permissions::step(...) else
                            # return false`) arrives as a Scope, which this arm never matched.
                            try_else_owner: sview = try_callee_owner_with_generics(try_else_callee, fns, structs, generics)
                            match try_callee_as_ident_with_generics(try_else_callee, fns, structs, generics):
                                Expr.Ident(try_else_name, try_else_name_line):
                                    if error_callee_is(fns, structs, generics, try_else_name, try_else_owner):
                                        if (emit_propagating_try_value(try_else_name, try_else_args, get_recovery, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder, try_else_owner) can Global{Read,Write}) is try_else_value:
                                            try_else_storage: mutable darray[u8] = []
                                            try_else_type: ValueType = error_callee_value_type(try_else_name, try_else_args, local_scope, fns, structs, generics, try_else_owner)
                                            try_else_slot: LLVMValueRef = build_entry_alloca(builder, llvm_type_of(try_else_type, structs, ctx), sview_to_cstr(var_name, try_else_storage))
                                            _ = LLVMBuildStore(builder, try_else_value, try_else_slot)
                                            declare_local(local_scope, var_name, try_else_slot, try_else_type)
                                            return EmitStatus.Open
                                        return EmitStatus.Declined
                                _:
                                    pass
                    get_opt_type: ValueType = expression_type(get_guarded, local_scope, fns, structs, generics)
                    # `p: T& = get c_alloc(n) else BODY` — a NULLABLE REFERENCE return. Stage0
                    # represents `-> heap T&?` as a bare ptr with null meaning absent, so the
                    # extern registers as a plain Ref and the Optional test below rejects it.
                    # Present is `ptr != null` and the payload IS the pointer, so no tag or
                    # payload extraction applies.
                    #
                    # Gated on FnTable.returns_nullable rather than on Ref-ness: stage0 REJECTS
                    # `get` on a non-nullable `T&` ("get requires an optional, a nullable
                    # reference, or a container index"), so accepting every Ref here would
                    # compile a program stage0 refuses.
                    if get_opt_type.kind == TypeKind.Ref:
                        gn_index: mutable i64 = -1
                        if get_guarded is Expr.Call(gn_callee, gn_args, gn_names, gn_call_line):
                            match gn_callee:
                                Expr.Ident(gn_name, gn_name_line):
                                    gn_index <- function_index_of(fns, "", gn_name)
                                _:
                                    pass
                        return EmitStatus.Declined if:
                            gn_index < 0
                            not fns.returns_nullable[gn_index.usize()]
                        if (emit_expression(get_guarded, get_opt_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}) is gn_pointer:
                            gn_present_flag: LLVMValueRef = LLVMBuildICmp(builder, 33, gn_pointer, LLVMConstNull(LLVMTypeOf(gn_pointer)), "get.present")
                            gn_function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                            gn_present: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, gn_function, "get.present")
                            gn_absent: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, gn_function, "get.absent")
                            _ = LLVMBuildCondBr(builder, gn_present_flag, gn_present, gn_absent)
                            LLVMPositionBuilderAtEnd(builder, gn_absent)
                            if get_recovery.count == 0:
                                (emit_region_unwind(regions, runtime, builder) can Global{Read,Write})
                                gn_none: LLVMValueRef = LLVMConstNull(llvm_type_of(return_type, structs, ctx))
                                if not emit_sret_return(gn_none, return_type, runtime, structs, ctx, builder):
                                    _ = LLVMBuildRet(builder, gn_none)
                            else:
                                gn_recovery_status: EmitStatus = emit_statements(&get_recovery, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}
                                return EmitStatus.Declined if gn_recovery_status != EmitStatus.Terminated
                            LLVMPositionBuilderAtEnd(builder, gn_present)
                            gn_storage: mutable darray[u8] = []
                            gn_slot: LLVMValueRef = build_entry_alloca(builder, LLVMTypeOf(gn_pointer), sview_to_cstr(var_name, gn_storage))
                            _ = LLVMBuildStore(builder, gn_pointer, gn_slot)
                            declare_local(local_scope, var_name, gn_slot, get_opt_type)
                            return EmitStatus.Open
                        return EmitStatus.Declined
                    # `v: T = get xs[i] else return/raise` -- a CHECKED INDEX, not an optional
                    # unwrap. Its whole point is that the caller never has to prove the index
                    # in range, because an out-of-range one takes the recovery instead of
                    # reading an element -- so the guarded expression's type is the ELEMENT
                    # type, and the Optional gate on the next line declined it, and with it the
                    # enclosing function ("declined 1: f@3 (variable declaration)") while
                    # stage0 compiled the same source. `return get xs[0] else return 0` arrives
                    # through the synthetic `__return_get` declaration, which is why a RETURN
                    # was reported as a variable declaration.
                    #
                    # The bounds guard's failure edge IS the recovery, so point it there and
                    # let the ORDINARY index emitter produce the access: every container shape
                    # it already resolves (chain, borrowed, field, literal, call-result) comes
                    # along, rather than a second slot resolver here that would handle fewer.
                    # An index nested INSIDE the guarded one diverts to the same recovery --
                    # the outer access cannot be attempted with an out-of-range subscript
                    # anyway, so that is where it belongs too.
                    if get_recovery.count > 0 and get_opt_type.kind != TypeKind.Optional and get_opt_type.kind != TypeKind.Unmodeled:
                        if get_guarded is Expr.Index(gi_collection, gi_index, gi_pos):
                            _ = gi_collection
                            _ = gi_index
                            _ = gi_pos
                            gi_fn: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                            gi_absent: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, gi_fn, "get.index.absent")
                            gi_runtime: mutable Runtime = copied_runtime(runtime)
                            gi_runtime.index_recovery_active <- true
                            gi_runtime.index_recovery_block <- gi_absent
                            if (emit_expression(get_guarded, get_opt_type, local_scope, fns, structs, generics, &gi_runtime, m, ctx, builder) can Global{Read,Write}) is gi_value:
                                # The guard left the builder on its in-bounds block; that is
                                # where the binding lives.
                                gi_present: LLVMBasicBlockRef = LLVMGetInsertBlock(builder)
                                # ABSENT: the recovery runs and must leave the block TERMINATED.
                                # It is emitted whether or not the guard could branch here (a
                                # constant index inside a fixed extent elides the test), so the
                                # block is never left without a terminator.
                                LLVMPositionBuilderAtEnd(builder, gi_absent)
                                gi_recovery_status: EmitStatus = emit_statements(&get_recovery, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}
                                return EmitStatus.Declined if gi_recovery_status != EmitStatus.Terminated
                                LLVMPositionBuilderAtEnd(builder, gi_present)
                                gi_storage: mutable darray[u8] = []
                                gi_slot: LLVMValueRef = build_entry_alloca(builder, llvm_type_of(get_opt_type, structs, ctx), sview_to_cstr(var_name, gi_storage))
                                _ = LLVMBuildStore(builder, gi_value, gi_slot)
                                declare_local(local_scope, var_name, gi_slot, get_opt_type)
                                register_drop_cleanup(var_name, get_opt_type, gi_slot, var_line.line, local_scope, structs, ctx, builder)
                                return EmitStatus.Open
                            return EmitStatus.Declined
                    return EmitStatus.Declined if:
                        get_opt_type.kind != TypeKind.Optional
                        # Propagation returns a null of THIS function's declared return type (an optional
                        # for the common `-> T?` case; whatever it is, a zero value is the None/empty).
                        get_recovery.count == 0 and return_type.kind == TypeKind.Unmodeled
                    get_payload_type: ValueType = optional_payload_of(get_opt_type, structs)
                    if (emit_expression(get_guarded, get_opt_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}) is get_opt_value:
                        get_tag: LLVMValueRef = optional_tag_of(get_opt_value, get_opt_type, structs, ctx, builder)
                        get_payload: LLVMValueRef = optional_payload_value_of(get_opt_value, get_opt_type, structs, ctx, builder)
                        get_function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                        get_present: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, get_function, "get.present")
                        get_absent: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, get_function, "get.absent")
                        _ = LLVMBuildCondBr(builder, get_tag, get_present, get_absent)
                        # ABSENT: `get X else BODY` runs BODY; bare `get X` propagates None.
                        LLVMPositionBuilderAtEnd(builder, get_absent)
                        if get_recovery.count == 0:
                            (emit_region_unwind(regions, runtime, builder) can Global{Read,Write})
                            get_none: LLVMValueRef = LLVMConstNull(llvm_type_of(return_type, structs, ctx))
                            if not emit_sret_return(get_none, return_type, runtime, structs, ctx, builder):
                                _ = LLVMBuildRet(builder, get_none)
                        else:
                            get_recovery_status: EmitStatus = emit_statements(&get_recovery, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}
                            return EmitStatus.Declined if:
                                get_recovery_status == EmitStatus.Declined
                                # An `else` body that falls through has no value to bind — require it to exit.
                                get_recovery_status == EmitStatus.Open
                        # PRESENT: bind the payload to `x` and continue.
                        LLVMPositionBuilderAtEnd(builder, get_present)
                        get_var_storage: mutable darray[u8] = []
                        get_var_slot: LLVMValueRef = build_entry_alloca(builder, llvm_type_of(get_payload_type, structs, ctx), sview_to_cstr(var_name, get_var_storage))
                        _ = LLVMBuildStore(builder, get_payload, get_var_slot)
                        declare_local(local_scope, var_name, get_var_slot, get_payload_type)
                        # A successful `get` creates the local just as an ordinary initializer
                        # does. Arm its destructor on the present path; the absent path exits
                        # before the binding exists and therefore owes no cleanup.
                        register_drop_cleanup(var_name, get_payload_type, get_var_slot, var_line.line, local_scope, structs, ctx, builder)
                        return EmitStatus.Open
                    return EmitStatus.Declined
            return EmitStatus.Declined
