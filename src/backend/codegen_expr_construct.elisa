# Stage1 backend — building a struct VALUE: `Type{field: v}` construction and `base with
# {field: v}` record update, which takes the struct from the base's own type because it has
# no type name to resolve. Part of `module Backend` (see codegen.elisa).

extend Backend:
    private:
        # Build an exact struct literal directly in caller-provided storage. Large struct
        # values otherwise become an LLVM aggregate `load` followed by an `sret` `store`;
        # SROA expands that copy into one instruction per byte/field for types such as
        # Glyphs.Coverage (16 KiB). Return 1 when emitted, 0 when this expression/type is
        # not eligible (and no IR was emitted), and -1 if an eligible construction could
        # not be completed. The latter must not fall back after partially evaluating fields.
        def emit_struct_construct_into_slot(expression: Expr, expected: ValueType, destination: LLVMValueRef, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            if expression is Expr.Construct(construct_type, construct_fields, construct_line):
                built_type: ValueType = annotation_value_type(construct_type, structs)
                return 0 if built_type.kind != TypeKind.Struct or expected.kind != TypeKind.Struct
                return 0 if not value_type_identity_equal(built_type, expected)
                struct_slot: usize = built_type.bits.usize()
                struct_llvm: LLVMTypeRef = llvm_type_of(built_type, structs, ctx)

                # Validate every field position before evaluating any initializer, so an
                # invalid literal can safely take the existing value-producing path.
                field_order: mutable u32 = 0
                valid_fields: mutable bool = true
                for field_init in construct_fields |field_order, valid_fields, struct_slot, structs|:
                    position: i64 = field_index_of(structs, struct_slot, field_init.name) if field_init.name != "" else field_order.i64()
                    valid_fields <- false if position < 0 or position.usize() >= structs.field_count[struct_slot]
                    field_order <- field_order + 1
                return -1 if not valid_fields

                supplied: mutable darray[bool] = []
                for _ in 0..<structs.field_count[struct_slot] |supplied|:
                    supplied.push(false)
                field_order <- 0
                for field_init in construct_fields |field_order, supplied, struct_slot, structs|:
                    position: i64 = field_index_of(structs, struct_slot, field_init.name) if field_init.name != "" else field_order.i64()
                    supplied[position.usize()] <- true
                    field_order <- field_order + 1

                field_order <- 0
                declined: mutable bool = false
                for field_init in construct_fields |declined, field_order, supplied, struct_slot, struct_llvm, destination, local_scope, fns, structs, generics, runtime, m, ctx, builder|:
                    position: i64 = field_index_of(structs, struct_slot, field_init.name) if field_init.name != "" else field_order.i64()
                    field_order <- field_order + 1
                    field_type: ValueType = structs.field_types[structs.field_start[struct_slot] + position.usize()]
                    field_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, struct_llvm, destination, position.u32(), "sret.field.ptr")
                    nested_status: i64 = emit_struct_construct_into_slot(field_init.value, field_type, field_pointer, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                    if nested_status == 0:
                        if is_zeroed_literal(field_init.value):
                            emit_zero_value_to_slot(field_pointer, field_type, structs, ctx, builder)
                        elif emit_expression_coerced(field_init.value, field_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is field_value:
                            _ = LLVMBuildStore(builder, field_value, field_pointer)
                        else:
                            declined <- true
                    elif nested_status < 0:
                        declined <- true
                return -1 if declined

                # Initialize omitted fields individually, preserving declared defaults and
                # zero semantics without ever constructing an aggregate SSA value.
                for default_position in 0..<supplied.count |supplied, struct_slot, struct_llvm, destination, local_scope, fns, structs, generics, runtime, m, ctx, builder, built_type|:
                    if not supplied[default_position]:
                        default_slot: usize = structs.field_start[struct_slot] + default_position
                        default_type: ValueType = structs.field_types[default_slot]
                        default_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, struct_llvm, destination, default_position.u32(), "sret.field.default.ptr")
                        emit_zero_value_to_slot(default_pointer, default_type, structs, ctx, builder)
                        default_row: i64 = field_default_row(structs, structs.names[struct_slot], structs.field_names[default_slot])
                        if default_row >= 0:
                            default_expr: Expr = structs.field_default_values[default_row.usize()]
                            if not is_zeroed_literal(default_expr):
                                nested_default_status: i64 = emit_struct_construct_into_slot(default_expr, default_type, default_pointer, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                                if nested_default_status == 0:
                                    if emit_expression(default_expr, default_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is default_value:
                                        _ = LLVMBuildStore(builder, default_value, default_pointer)
                                elif nested_default_status < 0:
                                    declined <- true
                return -1 if declined
                return 1
            return 0

        def emit_expression_record_and_construct(expression: Expr, expected: ValueType, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef, handled: mutable bool&) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            match expression:
                Expr.RecordUpdate(ru_base, ru_fields, ru_line):
                    ru_type: ValueType = expression_type(ru_base, local_scope, fns, structs, generics)
                    null return if ru_type.kind != TypeKind.Struct
                    ru_slot: usize = ru_type.bits.usize()
                    ru_llvm: LLVMTypeRef = llvm_type_of(ru_type, structs, ctx)
                    if emit_expression(ru_base, ru_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is ru_base_value:
                        ru_temporary: LLVMValueRef = LLVMBuildAlloca(builder, ru_llvm, "record.update")
                        _ = LLVMBuildStore(builder, ru_base_value, ru_temporary)
                        ru_declined: mutable bool = false
                        for ru_field in ru_fields |ru_declined, ru_slot, ru_llvm, ru_temporary, local_scope, fns, structs, generics, runtime, m, ctx, builder|:
                            ru_position: i64 = field_index_of(structs, ru_slot, ru_field.name)
                            if ru_position < 0:
                                ru_declined <- true
                            else:
                                ru_field_type: ValueType = structs.field_types[structs.field_start[ru_slot] + ru_position.usize()]
                                if emit_expression_coerced(ru_field.value, ru_field_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is ru_field_value:
                                    _ = LLVMBuildStore(builder, ru_field_value, LLVMBuildStructGEP2(builder, ru_llvm, ru_temporary, ru_position.u32(), "record.update.field.ptr"))
                                else:
                                    ru_declined <- true
                        null return if ru_declined
                        return LLVMBuildLoad2(builder, ru_llvm, ru_temporary, "record.update.load")
                    return null
                _:
                    pass
            match expression:
                Expr.Construct(construct_type, construct_fields, construct_line):
                    built_type: mutable ValueType = annotation_value_type(construct_type, structs)
                    # Arena has a dedicated ABI type, but its field registry is
                    # the runtime's declared struct (as for arena field reads).
                    # Keep the ABI carrier while resolving literal fields through
                    # that declaration; treating it as non-struct declined Arena{}.
                    field_registry_type: ValueType = arena_user_struct(structs) if built_type.kind == TypeKind.Arena else built_type
                    null return if field_registry_type.kind != TypeKind.Struct
                    struct_slot: usize = field_registry_type.bits.usize()
                    # `StringView` is the named source spelling for the builtin `sview` ABI.
                    # Its field registry is useful for labelled construction, but the value must
                    # use the same anonymous `{ptr, i64}` LLVM type as every `sview` signature;
                    # returning `%StringView` where the function returns `{ptr, i64}` is invalid.
                    built_type <- ValueType{kind: TypeKind.SView, bits: 0} if structs.names[struct_slot] == "StringView"

                    struct_llvm: LLVMTypeRef = llvm_type_of(built_type, structs, ctx)
                    temporary: LLVMValueRef = LLVMBuildAlloca(builder, struct_llvm, "construct")
                    declined: mutable bool = false
                    field_order: mutable u32 = 0
                    # Which positions the literal actually supplied — the rest are candidates for
                    # a declared `= default`.
                    supplied: mutable darray[bool] = []
                    for _ in 0..<structs.field_count[struct_slot] |supplied|:
                        supplied.push(false)
                    # Record supplied fields before evaluating initializers. That means an
                    # explicitly initialized large array is not first zeroed as part of the
                    # entire aggregate and then overwritten with a second aggregate store.
                    for field_init in construct_fields |field_order, supplied, struct_slot, structs|:
                        position: mutable i64 = field_index_of(structs, struct_slot, field_init.name)
                        if field_init.name == "":
                            position <- field_order.i64()
                        field_order <- field_order + 1
                        if position >= 0:
                            if position.usize() < supplied.count:
                                supplied[position.usize()] <- true
                    field_order <- 0
                    for field_init in construct_fields |declined, field_order, supplied, struct_slot, struct_llvm, temporary, local_scope, fns, structs, generics, runtime, m, ctx, builder|:
                        position: mutable i64 = field_index_of(structs, struct_slot, field_init.name)
                        if field_init.name == "":
                            position <- field_order.i64()
                        field_order <- field_order + 1
                        if position < 0:
                            declined <- true
                        else:
                            field_type: ValueType = structs.field_types[structs.field_start[struct_slot] + position.usize()]
                            field_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, struct_llvm, temporary, position.u32(), "field.ptr")
                            if is_zeroed_literal(field_init.value):
                                emit_zero_value_to_slot(field_pointer, field_type, structs, ctx, builder)
                            elif emit_expression_coerced(field_init.value, field_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is field_value:
                                _ = LLVMBuildStore(builder, field_value, field_pointer)
                            else:
                                declined <- true
                    null return if declined
                    # Initialize omitted fields individually. A field with an unevaluable
                    # default retains its zero just as before; large pointer-free aggregates
                    # stay compact, while pointer fields keep LLVMConstNull semantics.
                    for default_position in 0..<supplied.count |supplied, struct_slot, struct_llvm, temporary, local_scope, fns, structs, generics, runtime, built_type|:
                        if not supplied[default_position]:
                            default_slot: usize = structs.field_start[struct_slot] + default_position
                            default_type: ValueType = structs.field_types[default_slot]
                            default_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, struct_llvm, temporary, default_position.u32(), "field.default.ptr")
                            emit_zero_value_to_slot(default_pointer, default_type, structs, ctx, builder)
                            if built_type.kind == TypeKind.Struct:
                                default_row: i64 = field_default_row(structs, structs.names[struct_slot], structs.field_names[default_slot])
                                if default_row >= 0:
                                    default_expr: Expr = structs.field_default_values[default_row.usize()]
                                    if not is_zeroed_literal(default_expr):
                                        if emit_expression(default_expr, default_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is default_value:
                                            _ = LLVMBuildStore(builder, default_value, default_pointer)
                    return LLVMBuildLoad2(builder, struct_llvm, temporary, "constructed")

                _:
                    pass
            # Bitset flag read: `token.flags.has_suffix` — outer field is the packed u8,
            # inner name is a 1-bit flag (stage0: load i8, and mask, icmp ne 0). For the
            # self-host Token shape the only flag is bit 0 (`has_suffix`).
            return emit_expression_field_read(expression, expected, local_scope, fns, structs, generics, runtime, m, ctx, builder, handled)
