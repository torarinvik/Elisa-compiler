# Stage1 backend — building a struct VALUE: `Type{field: v}` construction and `base with
# {field: v}` record update, which takes the struct from the base's own type because it has
# no type name to resolve. Part of `module Backend` (see codegen.elisa).

extend Backend:
    private:
        # Construct a large aggregate directly in a caller-provided sret slot. The ordinary
        # expression constructor must return an SSA aggregate for value-position callers, but a
        # return statement already owns storage; materializing the whole value there is both
        # unnecessary and hostile to LLVM's legalizer.
        #
        # The result is tri-state: 0 is not this shape, 1 means the destination was written, and
        # -1 means this constructor claimed the shape but one field declined. A claimed failure
        # must not fall through to ordinary lowering after field side effects have run.
        def emit_construct_into_sret(expression: Expr, expected: ValueType, destination: LLVMValueRef, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            match expression:
                Expr.Construct(construct_type, construct_fields, construct_line):
                    built_type: mutable ValueType = annotation_value_type(construct_type, structs)
                    check_lowered_private_field(built_type, "", construct_line.line, structs)
                    field_registry_type: ValueType = arena_user_struct(structs) if built_type.kind == TypeKind.Arena else built_type
                    return 0 if field_registry_type.kind != TypeKind.Struct
                    struct_slot: usize = field_registry_type.bits.usize()
                    built_type <- ValueType{kind: TypeKind.SView, bits: 0} if structs.names[struct_slot] == "StringView"
                    return 0 if not value_type_uses_sret(expected, structs, ctx)
                    construct_llvm: LLVMTypeRef = llvm_type_of(built_type, structs, ctx)
                    construct_alignment: mutable u32 = LLVMABIAlignmentOfType(structs.target_data, construct_llvm)
                    construct_alignment <- 1 if construct_alignment == 0
                    construct_size: LLVMValueRef = LLVMConstInt(LLVMInt64TypeInContext(ctx), LLVMABISizeOfType(structs.target_data, construct_llvm), 0)
                    _ = LLVMBuildMemSet(builder, destination, LLVMConstInt(LLVMInt8TypeInContext(ctx), 0, 0), construct_size, construct_alignment)
                    declined: mutable bool = false
                    field_order: mutable u32 = 0
                    supplied: mutable darray[bool] = []
                    for _ in 0..<structs.field_count[struct_slot] |supplied|:
                        supplied.push(false)
                    for field_init in construct_fields |declined, field_order, supplied, struct_slot, construct_llvm, destination, local_scope, fns, structs, generics, runtime, m, ctx, builder|:
                        position: mutable i64 = field_index_of(structs, struct_slot, field_init.name)
                        position <- field_order.i64() if field_init.name == ""
                        field_order <- field_order + 1
                        if position < 0:
                            declined <- true
                        else:
                            field_type: ValueType = structs.field_types[structs.field_start[struct_slot] + position.usize()]
                            supplied[position.usize()] <- true
                            field_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, construct_llvm, destination, position.u32(), "sret.field.ptr")
                            field_written: mutable bool = false
                            if field_init.value is Expr.Call(field_call_callee, field_call_arguments, field_call_argument_names, field_call_line):
                                match field_call_callee:
                                    Expr.Ident(field_call_name, field_call_name_line):
                                        field_direct_status: i64 = emit_direct_call_into_sret("", field_call_name, field_call_callee, false, field_call_arguments, field_call_argument_names, field_pointer, local_scope, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}
                                        field_written <- true if field_direct_status == 1
                                        field_written <- true if field_direct_status < 0
                                        declined <- true if field_direct_status < 0
                                    Expr.Scope(field_call_scope_head, field_call_name, field_call_scope_line):
                                        if field_call_scope_head is Expr.Ident(field_call_module, field_call_module_line):
                                            field_direct_status: i64 = emit_direct_call_into_sret(module_alias_target(field_call_module, structs), field_call_name, field_call_callee, false, field_call_arguments, field_call_argument_names, field_pointer, local_scope, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}
                                            field_written <- true if field_direct_status == 1
                                            field_written <- true if field_direct_status < 0
                                            declined <- true if field_direct_status < 0
                                    _:
                                        pass
                            if not field_written and (indirect_aggregate_argument_address(field_init.value, field_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}) is field_source:
                                field_alignment: mutable u32 = LLVMABIAlignmentOfType(structs.target_data, llvm_type_of(field_type, structs, ctx))
                                field_alignment <- 1 if field_alignment == 0
                                field_size: LLVMValueRef = LLVMConstInt(LLVMInt64TypeInContext(ctx), LLVMABISizeOfType(structs.target_data, llvm_type_of(field_type, structs, ctx)), 0)
                                _ = LLVMBuildMemMove(builder, field_pointer, field_alignment, field_source, field_alignment, field_size)
                                field_written <- true
                            if not field_written:
                                if (emit_expression_coerced(field_init.value, field_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}) is field_value:
                                    _ = LLVMBuildStore(builder, field_value, field_pointer)
                                else:
                                    declined <- true
                    return -1 if declined
                    if built_type.kind == TypeKind.Struct:
                        for default_position in 0..<supplied.count |supplied, struct_slot, construct_llvm, destination, local_scope, fns, structs, generics, runtime, m, ctx, builder|:
                            if not supplied[default_position]:
                                default_slot: usize = structs.field_start[struct_slot] + default_position
                                default_row: i64 = field_default_row(structs, structs.names[struct_slot], structs.field_names[default_slot])
                                if default_row >= 0:
                                    default_type: ValueType = structs.field_types[default_slot]
                                    default_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, construct_llvm, destination, default_position.u32(), "sret.field.default.ptr")
                                    if (indirect_aggregate_argument_address(structs.field_default_values[default_row.usize()], default_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}) is default_source:
                                        default_alignment: mutable u32 = LLVMABIAlignmentOfType(structs.target_data, llvm_type_of(default_type, structs, ctx))
                                        default_alignment <- 1 if default_alignment == 0
                                        default_size: LLVMValueRef = LLVMConstInt(LLVMInt64TypeInContext(ctx), LLVMABISizeOfType(structs.target_data, llvm_type_of(default_type, structs, ctx)), 0)
                                        _ = LLVMBuildMemMove(builder, default_pointer, default_alignment, default_source, default_alignment, default_size)
                                    elif (emit_expression(structs.field_default_values[default_row.usize()], default_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}) is default_value:
                                        _ = LLVMBuildStore(builder, default_value, default_pointer)
                    return 1
                _:
                    return 0

        # The standalone component runtime intentionally does not include the native
        # prelude's StringView declaration. Preserve its source-level field spelling while
        # constructing the same builtin `{ptr, i64}` value as `sview` directly.
        def emit_stringview_record_value(fields: darray[Ast::FieldInit], expected: ValueType, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            null return if expected.kind != TypeKind.SView and expected.kind != TypeKind.Unmodeled
            sview_type: ValueType = ValueType{kind: TypeKind.SView, bits: 0}
            sview_llvm: LLVMTypeRef = llvm_type_of(sview_type, structs, ctx)
            sview_value: mutable LLVMValueRef = LLVMConstNull(sview_llvm)
            supplied: mutable darray[bool] = [false, false]
            data_type: ValueType = intern_ref_type(ValueType{kind: TypeKind.Unsigned, bits: 8}, structs)
            length_type: ValueType = ValueType{kind: TypeKind.Signed, bits: 64}
            order: mutable u32 = 0
            declined: mutable bool = false
            for field in fields |supplied, order, data_type, length_type, sview_value, local_scope, fns, structs, generics, runtime, m, ctx, builder, declined|:
                position: mutable i64 = -1
                if field.name == "":
                    position <- order.i64()
                elif field.name == "data":
                    position <- 0
                elif field.name == "len":
                    position <- 1
                order <- order + 1
                if position < 0 or position >= 2:
                    declined <- true
                elif supplied[position.usize()]:
                    declined <- true
                elif position == 0:
                    if (emit_expression_coerced(field.value, data_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}) is field_value:
                        supplied[0] <- true
                        sview_value <- LLVMBuildInsertValue(builder, sview_value, field_value, 0, "stringview.data")
                    else:
                        declined <- true
                else:
                    if (emit_expression_coerced(field.value, length_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}) is field_value:
                        supplied[1] <- true
                        sview_value <- LLVMBuildInsertValue(builder, sview_value, field_value, 1, "stringview.len")
                    else:
                        declined <- true
            null return if declined
            return sview_value

        def emit_expression_record_and_construct(expression: Expr, expected: ValueType, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef, handled: mutable bool&) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            match expression:
                Expr.RecordUpdate(ru_base, ru_fields, ru_line):
                    ru_type: ValueType = expression_type(ru_base, local_scope, fns, structs, generics)
                    null return if ru_type.kind != TypeKind.Struct
                    ru_slot: usize = ru_type.bits.usize()
                    ru_llvm: LLVMTypeRef = llvm_type_of(ru_type, structs, ctx)
                    if (emit_expression(ru_base, ru_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}) is ru_base_value:
                        ru_temporary: LLVMValueRef = build_entry_alloca(builder, ru_llvm, "record.update")
                        _ = LLVMBuildStore(builder, ru_base_value, ru_temporary)
                        ru_declined: mutable bool = false
                        for ru_field in ru_fields |ru_declined, ru_slot, ru_type, ru_line, ru_llvm, ru_temporary, local_scope, fns, structs, generics, runtime, m, ctx, builder|:
                            check_lowered_private_field(ru_type, ru_field.name, ru_line.line, structs)
                            ru_position: i64 = field_index_of(structs, ru_slot, ru_field.name)
                            if ru_position < 0:
                                ru_declined <- true
                            else:
                                ru_field_type: ValueType = structs.field_types[structs.field_start[ru_slot] + ru_position.usize()]
                                if (emit_expression_coerced(ru_field.value, ru_field_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}) is ru_field_value:
                                    _ = LLVMBuildStore(builder, ru_field_value, LLVMBuildStructGEP2(builder, ru_llvm, ru_temporary, ru_position.u32(), "record.update.field.ptr"))
                                else:
                                    ru_declined <- true
                        null return if ru_declined
                        return LLVMBuildLoad2(builder, ru_llvm, ru_temporary, "record.update.load")
                    return null
                _:
                    pass
            match expression:
                Expr.Construct(construct_type, construct_fields, construct_line):
                    if construct_type is Expr.Ident(construct_name, construct_name_line):
                        if construct_name == "StringView":
                            return emit_stringview_record_value(construct_fields, expected, local_scope, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}
                    built_type: mutable ValueType = annotation_value_type(construct_type, structs)
                    # Arena has a dedicated ABI type, but its field registry is
                    # the runtime's declared struct (as for arena field reads).
                    # Keep the ABI carrier while resolving literal fields through
                    # that declaration; treating it as non-struct declined Arena{}.
                    field_registry_type: ValueType = arena_user_struct(structs) if built_type.kind == TypeKind.Arena else built_type
                    null return if field_registry_type.kind != TypeKind.Struct
                    struct_slot: usize = field_registry_type.bits.usize()
                    # `StringView` is the named source spelling for the builtin `sview` ABI.
                    # Its field registry is useful for labelled construction, but the value must
                    # use the same anonymous `{ptr, i64}` LLVM type as every `sview` signature;
                    # returning `%StringView` where the function returns `{ptr, i64}` is invalid.
                    built_type <- ValueType{kind: TypeKind.SView, bits: 0} if structs.names[struct_slot] == "StringView"

                    # LLVM's anonymous sview value and the named StringView struct are
                    # layout-compatible but not interchangeable as pointer-to-aggregate types.
                    # Build the ABI value directly instead of using the generic struct spill.
                    if structs.names[struct_slot] == "StringView":
                        null return if structs.field_count[struct_slot] != 2
                        sview_llvm: LLVMTypeRef = llvm_type_of(built_type, structs, ctx)
                        sview_value: mutable LLVMValueRef = LLVMConstNull(sview_llvm)
                        sview_supplied: mutable darray[bool] = []
                        for _ in 0..<structs.field_count[struct_slot] |sview_supplied|:
                            sview_supplied.push(false)
                        sview_order: mutable u32 = 0
                        sview_declined: mutable bool = false
                        for sview_field in construct_fields |sview_supplied, sview_order, struct_slot, structs, sview_llvm, sview_value, local_scope, fns, generics, runtime, m, ctx, builder, sview_declined|:
                            sview_position: mutable i64 = field_index_of(structs, struct_slot, sview_field.name)
                            sview_position <- sview_order.i64() if sview_field.name == ""
                            sview_order <- sview_order + 1
                            if sview_position < 0 or sview_position >= structs.field_count[struct_slot].i64():
                                sview_declined <- true
                            else:
                                sview_slot: usize = structs.field_start[struct_slot] + sview_position.usize()
                                sview_field_type: ValueType = structs.field_types[sview_slot]
                                sview_supplied[sview_position.usize()] <- true
                                if (emit_expression_coerced(sview_field.value, sview_field_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}) is sview_field_value:
                                    sview_value <- LLVMBuildInsertValue(builder, sview_value, sview_field_value, sview_position.u32(), "sview.construct.field")
                                else:
                                    sview_declined <- true
                        null return if sview_declined
                        for sview_default_position in 0..<sview_supplied.count |sview_supplied, sview_llvm, sview_value, local_scope, fns, structs, generics, runtime, m, ctx, builder, sview_declined|:
                            if not sview_supplied[sview_default_position]:
                                sview_default_slot: usize = structs.field_start[struct_slot] + sview_default_position
                                sview_default_row: i64 = field_default_row(structs, structs.names[struct_slot], structs.field_names[sview_default_slot])
                                if sview_default_row >= 0:
                                    sview_default_type: ValueType = structs.field_types[sview_default_slot]
                                    sview_default_expr: Expr = structs.field_default_values[sview_default_row.usize()]
                                    if not is_zeroed_literal(sview_default_expr):
                                        if (emit_expression(sview_default_expr, sview_default_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}) is sview_default_value:
                                            sview_value <- LLVMBuildInsertValue(builder, sview_value, sview_default_value, sview_default_position.u32(), "sview.construct.default")
                                        else:
                                            sview_declined <- true
                        null return if sview_declined
                        return sview_value

                    struct_llvm: LLVMTypeRef = llvm_type_of(built_type, structs, ctx)
                    temporary: LLVMValueRef = build_entry_alloca(builder, struct_llvm, "construct")
                    if value_type_uses_indirect_aggregate(built_type, structs, ctx):
                        construct_alignment: mutable u32 = LLVMABIAlignmentOfType(structs.target_data, struct_llvm)
                        construct_alignment <- 1 if construct_alignment == 0
                        construct_size: LLVMValueRef = LLVMConstInt(LLVMInt64TypeInContext(ctx), LLVMABISizeOfType(structs.target_data, struct_llvm), 0)
                        _ = LLVMBuildMemSet(builder, temporary, LLVMConstInt(LLVMInt8TypeInContext(ctx), 0, 0), construct_size, construct_alignment)
                    else:
                        _ = LLVMBuildStore(builder, LLVMConstNull(struct_llvm), temporary)
                    declined: mutable bool = false
                    field_order: mutable u32 = 0
                    # Which positions the literal actually supplied — the rest are candidates for
                    # a declared `= default`.
                    supplied: mutable darray[bool] = []
                    for _ in 0..<structs.field_count[struct_slot] |supplied|:
                        supplied.push(false)
                    # Record supplied fields before evaluating initializers. That means an
                    # explicitly initialized large array is not first zeroed as part of the
                    # entire aggregate and then overwritten with a second aggregate store.
                    for field_init in construct_fields |field_order, supplied, struct_slot, structs|:
                        position: mutable i64 = field_index_of(structs, struct_slot, field_init.name)
                        if field_init.name == "":
                            position <- field_order.i64()
                        field_order <- field_order + 1
                        if position >= 0:
                            if position.usize() < supplied.count:
                                supplied[position.usize()] <- true
                    field_order <- 0
                    for field_init in construct_fields |declined, field_order, supplied, struct_slot, struct_llvm, temporary, local_scope, fns, structs, generics, runtime, m, ctx, builder|:
                        position: mutable i64 = field_index_of(structs, struct_slot, field_init.name)
                        if field_init.name == "":
                            position <- field_order.i64()
                        field_order <- field_order + 1
                        if position < 0:
                            declined <- true
                        else:
                            field_type: ValueType = structs.field_types[structs.field_start[struct_slot] + position.usize()]
                            supplied[position.usize()] <- true
                            field_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, struct_llvm, temporary, position.u32(), "field.ptr")
                            field_written: mutable bool = false
                            if field_init.value is Expr.Call(field_call_callee, field_call_arguments, field_call_argument_names, field_call_line):
                                match field_call_callee:
                                    Expr.Ident(field_call_name, field_call_name_line):
                                        field_direct_status: i64 = emit_direct_call_into_sret("", field_call_name, field_call_callee, false, field_call_arguments, field_call_argument_names, field_pointer, local_scope, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}
                                        field_written <- true if field_direct_status == 1
                                        declined <- true if field_direct_status < 0
                                    Expr.Scope(field_call_scope_head, field_call_name, field_call_scope_line):
                                        if field_call_scope_head is Expr.Ident(field_call_module, field_call_module_line):
                                            field_direct_status: i64 = emit_direct_call_into_sret(module_alias_target(field_call_module, structs), field_call_name, field_call_callee, false, field_call_arguments, field_call_argument_names, field_pointer, local_scope, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}
                                            field_written <- true if field_direct_status == 1
                                            declined <- true if field_direct_status < 0
                                    _:
                                        pass
                            if not field_written and (indirect_aggregate_argument_address(field_init.value, field_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}) is field_source:
                                field_alignment: mutable u32 = LLVMABIAlignmentOfType(structs.target_data, llvm_type_of(field_type, structs, ctx))
                                field_alignment <- 1 if field_alignment == 0
                                field_size: LLVMValueRef = LLVMConstInt(LLVMInt64TypeInContext(ctx), LLVMABISizeOfType(structs.target_data, llvm_type_of(field_type, structs, ctx)), 0)
                                _ = LLVMBuildMemMove(builder, field_pointer, field_alignment, field_source, field_alignment, field_size)
                                field_written <- true
                            if not field_written:
                                if (emit_expression_coerced(field_init.value, field_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}) is field_value:
                                    _ = LLVMBuildStore(builder, field_value, field_pointer)
                                    field_written <- true
                                else:
                                    declined <- true
                    null return if declined
                    # Initialize omitted fields individually. A field with an unevaluable
                    # default retains its zero just as before; large pointer-free aggregates
                    # stay compact, while pointer fields keep LLVMConstNull semantics.
                    for default_position in 0..<supplied.count |supplied, struct_slot, struct_llvm, temporary, local_scope, fns, structs, generics, runtime, built_type|:
                        if not supplied[default_position]:
                            default_slot: usize = structs.field_start[struct_slot] + default_position
                            default_type: ValueType = structs.field_types[default_slot]
                            default_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, struct_llvm, temporary, default_position.u32(), "field.default.ptr")
                            emit_zero_value_to_slot(default_pointer, default_type, structs, ctx, builder)
                            if built_type.kind == TypeKind.Struct:
                                default_row: i64 = field_default_row(structs, structs.names[struct_slot], structs.field_names[default_slot])
                                if default_row >= 0:
                                    default_expr: Expr = structs.field_default_values[default_row.usize()]
                                    if not is_zeroed_literal(default_expr):
                                        if (emit_expression(default_expr, default_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}) is default_value:
                                            _ = LLVMBuildStore(builder, default_value, default_pointer)
                    return LLVMBuildLoad2(builder, struct_llvm, temporary, "constructed")

                _:
                    pass
            # Bitset flag read: `token.flags.has_suffix` — outer field is the packed u8,
            # inner name is a 1-bit flag (stage0: load i8, and mask, icmp ne 0). For the
            # self-host Token shape the only flag is bit 0 (`has_suffix`).
            return emit_expression_field_read(expression, expected, local_scope, fns, structs, generics, runtime, m, ctx, builder, handled) can Global{Read,Write}
