# Checked signed-i64 predicates for compile-time constant folding. The folder
# performs arithmetic and shifts only after their corresponding guards accept.
module BackendConstArithmetic:
    public:
        const I64_MAX: i64 = 9223372036854775807
        const I64_MIN: i64 = 0 - I64_MAX - 1
        const I64_SHIFT_WIDTH: i64 = 64

        def add_is_safe(left: i64, right: i64) -> bool:
            ensure result == (right == 0 or (right > 0 and left <= I64_MAX - right) or (right < 0 and left >= I64_MIN - right))
            ensure result implies (left + right >= I64_MIN and left + right <= I64_MAX)
            return right == 0 or (right > 0 and left <= I64_MAX - right) or (right < 0 and left >= I64_MIN - right)

        def subtract_is_safe(left: i64, right: i64) -> bool:
            ensure result == (right == 0 or (right > 0 and left >= I64_MIN + right) or (right < 0 and left <= I64_MAX + right))
            ensure result implies (left - right >= I64_MIN and left - right <= I64_MAX)
            return right == 0 or (right > 0 and left >= I64_MIN + right) or (right < 0 and left <= I64_MAX + right)

        def multiply_is_safe(left: i64, right: i64) -> bool:
            ensure result == (
                left == 0 or right == 0
                or (left > 0 and right > 0 and left <= I64_MAX / right)
                or (left > 0 and right < 0 and right >= I64_MIN / left)
                or (left < 0 and right > 0 and left >= I64_MIN / right)
                or (left < 0 and right < 0 and left >= I64_MAX / right))
            ensure (result and (left == 0 or right == 0)) implies left * right == 0
            ensure (result and left > 0 and right > 0) implies (left * right >= 0 and left * right <= I64_MAX)
            ensure (result and left > 0 and right < 0) implies (left * right >= I64_MIN and left * right <= 0)
            ensure (result and left < 0 and right > 0) implies (left * right >= I64_MIN and left * right <= 0)
            ensure (result and left < 0 and right < 0) implies (left * right >= 0 and left * right <= I64_MAX)
            return (
                left == 0 or right == 0
                or (left > 0 and right > 0 and left <= I64_MAX / right)
                or (left > 0 and right < 0 and right >= I64_MIN / left)
                or (left < 0 and right > 0 and left >= I64_MIN / right)
                or (left < 0 and right < 0 and left >= I64_MAX / right))

        def division_is_safe(left: i64, right: i64) -> bool:
            ensure result == (right != 0 and (left != I64_MIN or right != -1))
            return right != 0 and (left != I64_MIN or right != -1)

        def remainder_is_safe(left: i64, right: i64) -> bool:
            ensure result == (right != 0 and (left != I64_MIN or right != -1))
            return right != 0 and (left != I64_MIN or right != -1)

        def negation_is_safe(value: i64) -> bool:
            ensure result == (value != I64_MIN)
            ensure result implies (0 - value >= I64_MIN and 0 - value <= I64_MAX)
            return value != I64_MIN

        def shift_count_is_safe(count: i64) -> bool:
            ensure result == (count >= 0 and count < I64_SHIFT_WIDTH)
            return count >= 0 and count < I64_SHIFT_WIDTH
