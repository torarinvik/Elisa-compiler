extend Backend:
    private:
        def contract_quantifier_head_at(line: u32, structs: mutable StructTable&, valid: mutable bool&) -> sview can[Abort.Panic]:
            metadata_valid: bool = query_scope_metadata_valid(structs)
            valid <- metadata_valid
            return "" if not metadata_valid
            found: mutable sview = ""
            paired: usize = structs.queries.query_lines.count
            for probe in 0..<paired |found, line, structs|:
                continue if structs.queries.query_lines[probe] != line or structs.queries.query_binders[probe] != ""
                return "" if found != "" and found != structs.queries.query_heads[probe]
                found <- structs.queries.query_heads[probe]
            return found




        # A no-recovery `try` keeps only the guarded expression node. Match its raw root
        # offset, never the display line, which #line can reuse for siblings. Real source
        # expressions cannot have offset zero; synthetic AST nodes must not borrow markers.
        def propagating_try_expr_at(offset: u32, structs: mutable StructTable&) -> bool:
            paired: usize = structs.annotations.propagating_try_call_offsets.count
            return false if offset == 0 or paired == 0
            for probe in 0..<paired |offset, structs|:
                return true if structs.annotations.propagating_try_call_offsets[probe] == offset
            return false



        # A pin belongs to one declaration token, including same-line siblings.
        def local_region_name_at(line: u32, offset: u32, structs: mutable StructTable&) -> sview can[Abort.Panic]:
            paired: usize = structs.regions.local_region_lines.count
            return "" if paired != structs.regions.local_region_offsets.count or paired != structs.regions.local_region_names.count
            found: mutable sview = ""
            for probe in 0..<paired |found, line, offset, structs|:
                continue if structs.regions.local_region_lines[probe] != line or structs.regions.local_region_offsets[probe] != offset
                return "" if found != "" and found != structs.regions.local_region_names[probe]
                found <- structs.regions.local_region_names[probe]
            return found




        # The recorded return-type head for a function type, submit, or other marked expression.
        # It never borrows a marker from another AST token on the same source line.
        def fn_return_head_at_offset(offset: u32, line: u32, structs: StructTable&) -> sview can[Abort.Panic]:
            paired: mutable usize = structs.function_types.fn_return_lines.count if structs.function_types.fn_return_lines.count < structs.function_types.fn_return_heads.count else structs.function_types.fn_return_heads.count
            paired <- structs.function_types.fn_return_offsets.count if structs.function_types.fn_return_offsets.count < paired
            found: mutable sview = ""
            for probe in 0..<paired |found, offset, line, structs|:
                continue if structs.function_types.fn_return_lines[probe] != line or structs.function_types.fn_return_offsets[probe] != offset
                return "" if found != "" and found != structs.function_types.fn_return_heads[probe]
                found <- structs.function_types.fn_return_heads[probe]
            return found




        def error_family_at(lines: darray[u32]&, families: darray[sview]&, line: u32) -> sview can[Abort.Panic]:
            for index in 0..<lines.count |lines, families, line|:
                return families[index] if lines[index] == line
            return sview("", 0, 0)




        def clone_error_family_at(line: u32, structs: mutable StructTable&) -> sview can[Abort.Panic]:
            can Abort.Panic:
                return error_family_at(structs.errors.clone_error_lines, structs.errors.clone_error_families, line)




        def local_error_family_at(line: u32, structs: mutable StructTable&) -> sview can[Abort.Panic]:
            can Abort.Panic:
                return error_family_at(structs.errors.local_error_lines, structs.errors.local_error_families, line)




        def type_expression_line(expression: Expr) -> u32:
            return match expression:
                Expr.Ident(_, ident_line): ident_line.line
                Expr.Index(_, _, index_line): index_line.line
                Expr.IndexN(_, _, indexn_line): indexn_line.line
                Expr.Unary(_, _, unary_line): unary_line.line
                Expr.Field(_, _, field_line): field_line.line
                Expr.Scope(_, _, scope_line): scope_line.line
                Expr.Tuple(_, tuple_line): tuple_line.line
                Expr.Lambda(_, _, lambda_line): lambda_line.line
                _: 0




        def field_error_family_for(expression: Expr, structs: mutable StructTable&) -> sview can[Abort.Panic]:
            can Abort.Panic:
                return error_family_at(structs.errors.field_error_lines, structs.errors.field_error_families, type_expression_line(expression))




        def parameter_value_type(expression: Expr, structs: mutable StructTable&) -> ValueType can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                # Expression-only type consumers (for example local declaration helpers)
                # have no owning parameter identity. Do not guess a parameter error set
                # from a shared source line.
                return annotation_value_type(expression, structs)



        def parameter_error_family_for(parameter: ParamDecl, params: darray[ParamDecl]&, structs: StructTable&) -> sview can[Abort.Panic]:
            can Abort.Panic:
                parameter_line: u32 = parameter.name_pos.line if parameter.name_pos.line != 0 else type_expression_line(parameter.type_expression)
                parameter_offset: u32 = parameter.name_pos.offset
                if parameter_offset != 0:
                    exact_family: mutable sview = ""
                    exact_count: mutable usize = 0
                    for index in 0..<structs.errors.param_error_offsets.count |exact_family, exact_count, index, parameter_offset, structs|:
                        if index < structs.errors.param_error_lines.count and structs.errors.param_error_offsets[index] == parameter_offset:
                            exact_family <- structs.errors.param_error_families[index] if index < structs.errors.param_error_families.count
                            exact_count <- exact_count + 1.usize()
                    return exact_family if exact_count == 1
                    return ""

                # Older/synthetic parameter metadata may not carry offsets. A line fallback
                # is only safe when that line has exactly one parameter and one legacy
                # offset-zero annotation; otherwise the row cannot be assigned reliably.
                return "" if parameter_line == 0
                params_on_line: mutable usize = 0
                for candidate in params |params_on_line, parameter_line|:
                    candidate_line: u32 = candidate.name_pos.line if candidate.name_pos.line != 0 else type_expression_line(candidate.type_expression)
                    params_on_line <- params_on_line + 1.usize() if candidate_line == parameter_line
                legacy_family: mutable sview = ""
                legacy_count: mutable usize = 0
                for index in 0..<structs.errors.param_error_lines.count |legacy_family, legacy_count, index, parameter_line, structs|:
                    if index < structs.errors.param_error_families.count and index < structs.errors.param_error_offsets.count and structs.errors.param_error_lines[index] == parameter_line and structs.errors.param_error_offsets[index] == 0:
                        legacy_family <- structs.errors.param_error_families[index]
                        legacy_count <- legacy_count + 1.usize()
                return legacy_family if params_on_line == 1 and legacy_count == 1
                return ""



        def parameter_decl_value_type(parameter: ParamDecl, params: darray[ParamDecl]&, structs: mutable StructTable&) -> ValueType can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                payload: ValueType = annotation_value_type(parameter.type_expression, structs)
                family: sview = parameter_error_family_for(parameter, params, structs)
                if family != "":
                    return intern_error_union_type(payload, family, structs)
                return payload



            # Resolve a bare type HEAD NAME (`i64`, `dstr`, a struct) to a ValueType. Only the
            # forms a fn return head can name in the modeled subset; Unmodeled otherwise.
        def resolve_type_head(head: sview, structs: mutable StructTable&) -> ValueType can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic, Memory.Allocate:
                scalar: ValueType = scalar_type_of_name(head, structs.target.target_pointer_bits)
                return scalar if scalar.kind != TypeKind.Unmodeled
                # A head naming the CURRENT instantiation's type PARAMETER. The parser's compact
                # fn-type side table keeps only heads, so `fn(A) -> R` reaches here as the bare
                # names "A"/"R"; without this the interned Fn type carried an Unmodeled return,
                # which nothing noticed (a fn value is a pointer either way) until inference tried
                # to recover R from it. Checked after the scalars so a parameter can never shadow
                # a builtin name.
                bound_head: ValueType = bound_type_of(structs, head)
                return bound_head if has_bound_type(structs, head)
                # bits 1 is a MARKER, not a width: it distinguishes an opaque HANDLE from a real
                # C string, because `cstr == cstr` is a CONTENT compare (ctx_streq) while
                # `handle == handle` must be POINTER IDENTITY. Both still lower to `ptr`, and
                # emit_conversion treats ptr->ptr as a no-op whatever the bits, so the marker
                # changes nothing but equality. Compiled as a content compare, the library
                # reconciliation in emit_module_core read two distinct llvm::Function objects as
                # "equal" strings, skipped the repoint, and the stage1-built runtime object
                # exported arena_alloc.2/arena_free.4 instead of the real names.
                return ValueType{kind: TypeKind.CStr, bits: 1} if llvm_opaque_handle_name(head)
                return intern_darray_type(ValueType{kind: TypeKind.Unsigned, bits: 8}, structs) if head == "dstr"
                # `type X = id[T]` resolves by HEAD alone: an `id[T]` handle erases to its u32
                # backing whatever T is, so the referent cannot change the representation.
                return ValueType{kind: TypeKind.Unsigned, bits: 32} if head == "id"
                head_struct: i64 = struct_index_of(structs, head)
                return ValueType{kind: TypeKind.Struct, bits: head_struct.u32()} if head_struct >= 0
                # An alias head (`type A = B` where B is itself an alias). resolve_aliases fills
                # the table in declaration order, so a target declared earlier is already
                # resolved here; a cycle stays Unmodeled and declines, as before.
                head_alias: i64 = alias_index_of(structs, head)
                if head_alias >= 0:
                    aliased: ValueType = copied_type(structs.aliases.alias_types[head_alias.usize()])
                    return aliased if aliased.kind != TypeKind.Unmodeled
                # The parser's compact fn-type side table retains only the type HEAD (`Slice`),
                # not its bracket arguments (`Slice[T]`). When the surrounding signature has
                # already resolved the concrete generic field before reaching `fn(Slice[T])`,
                # recover that ready instance by base name. This preserves the parameter's real
                # LLVM aggregate type without guessing when no matching instance exists.
                template_slot: i64 = generic_struct_index_of(structs, head)
                return unmodeled_type() if template_slot == -2
                expected_template: u32 = (template_slot + 1).u32() if template_slot >= 0 else 0
                found_instance: mutable i64 = -1
                for instance in 0..<structs.generics.generic_struct_inst_bases.count |structs, head, expected_template, found_instance|:
                    continue if structs.generics.generic_struct_inst_bases[instance] != head or generic_instance_template_id(instance, structs) != expected_template
                    if structs.generics.generic_struct_inst_ready[instance]:
                        return unmodeled_type() if found_instance >= 0
                        found_instance <- structs.generics.generic_struct_inst_index[instance].i64()
                return ValueType{kind: TypeKind.Struct, bits: found_instance.u32()} if found_instance >= 0
                return unmodeled_type()

include "./codegen_debug_trace.elisa"
include "./codegen_literals_decode.elisa"
include "./codegen_pattern_tests.elisa"
include "./codegen_value_type.elisa"
