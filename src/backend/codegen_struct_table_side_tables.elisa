extend Backend:
    private:
        struct BackendQueries:
            # Offset+1 scope IDs reserve zero for synthetic/unavailable positions. If any
            # parser annotation maps to zero, query-side metadata is malformed and lookup
            # must fail closed rather than attach it to a synthetic comprehension.
            scope_ids_well_formed: mutable bool = true
            # `any index, item in xs.enumerate() where …` — the EXTRA binders of a
            # multi-binder query, keyed by the parse-local Comprehension query scope ID.
            # The Comprehension node carries only the first binder.
            query_extra_binder_scope_ids: mutable darray[u32] = []
            query_extra_binder_names: mutable darray[sview @source] = []
            # `for {left, right: item_right} in xs` — each FIELD name in pattern order,
            # keyed by the exact owning `for` token offset carried by Stmt.For's Pos.
            for_brace_field_offsets: mutable darray[u32] = []
            for_brace_field_names: mutable darray[sview] = []
            # QUERY heads and binders, keyed by the parse-local query scope ID derived from the
            # exact head token. Line identity is insufficient for multiple queries on one line,
            # and binder spelling is insufficient when two same-named queries use different heads.
            query_lines: mutable darray[u32] = []
            query_scope_ids: mutable darray[u32] = []
            query_heads: mutable darray[sview] = []
            query_binders: mutable darray[sview] = []
            # List comprehensions marked `by par`, keyed by the Comprehension node's query scope
            # ID. The marker remains in the file annotation table; the node carries the ID.
            parallel_comprehension_scope_ids: mutable darray[u32] = []
            # `EXPR for each x in xs with OWNER`: the parser records OWNER at its token offset
            # (`__query_owner`), converted here to the Comprehension's parse-local scope ID
            # because the node has no owner-name slot. The
            # produced darray must grow in OWNER's arena; growing it in the function's auto
            # region freed it at the return (adversarial projection_query_explicit_owner).
            query_owner_scope_ids: mutable darray[u32] = []
            query_owner_names: mutable darray[sview] = []
            # `x: darray[i64] @host = [...]` — the REGION a local declaration is pinned to,
            # keyed by the declaration's line. Without these the qualifier was dropped
            # entirely and the container was allocated from whatever arena happened to be
            # ambient; a declaration pinned to a LONGER-lived region landed in a shorter-lived
            # one and its data was freed underneath the program (see the fixture in
            # test/breadth: stage0 answers 60, stage1 used to segfault).
            # Query scope IDs whose query carries a `where PATTERN: GUARD` filter, so the node's
            # BODY slot holds the GUARD rather than a projection. See __query_guard.
            query_guard_scope_ids: mutable darray[u32] = []
            # Query scope IDs whose PROJECTION query carries a guard the node cannot hold. See
            # __query_guard_dropped: these must decline, not emit an unguarded filter.
            query_dropped_guard_scope_ids: mutable darray[u32] = []

        struct BackendLoops:
            # `for row in s.rows():` — the ROW BINDER in scope for the loop body. A row view is
            # (aggregate address, row index); rather than materialise stage0's `{ptr, i64}`
            # pair, the binder is recorded here and `row.field` resolves to the element address
            # directly. Pushed on loop entry, popped on exit.
            soa_row_binder_names: mutable darray[sview] = []
            soa_row_binder_slots: mutable darray[u32] = []
            soa_row_binder_bases: mutable darray[LLVMValueRef] = []
            soa_row_binder_indexes: mutable darray[LLVMValueRef] = []
            # The loop stack of the statement being emitted, for the VALUE BLOCKS in it. A
            # value block is emitted as an expression, which carries no loop stack, so a
            # `continue if tmp < 0` inside `total: i64 = <block>` reads its enclosing loops
            # here. emit_statement appends the statement's loop stack as a new FRAME (the rows
            # from `ambient_frame_start` / `ambient_label_frame_start` on) around a statement
            # inside a loop whose value is a block, and truncates it after;
            # emit_scoped_value_block copies the current frame. No frame outside loops.
            ambient_frame_start: mutable usize = 0
            ambient_label_frame_start: mutable usize = 0
            ambient_loop_exits: mutable darray[LLVMBasicBlockRef] = []
            ambient_loop_continues: mutable darray[LLVMBasicBlockRef] = []
            ambient_loop_defer_marks: mutable darray[usize] = []
            ambient_label_names: mutable darray[sview @source] = []
            ambient_label_depths: mutable darray[usize] = []

        struct BackendPackedLayouts:
            # Names the PARSER marked as members of the sealed Node hierarchy
            # (`__ast_refinement`). Keyed on the declaration's ancestry, not on the bare
            # name, so a program's own `packed enum Expr:` is an ordinary packed enum.
            ast_refinement_names: mutable darray[sview] = []
            ast_refinement_modules: mutable darray[sview] = []
            # Bumped on every reset or append to ast_refinement_names. Unlike the packed
            # layout stamp's table counts, this catches same-count refinement rebuilds.
            ast_refinement_epoch: mutable u64 = 0
            hierarchy_child: mutable darray[sview] = []
            hierarchy_parent: mutable darray[sview] = []
            hierarchy_modules: mutable darray[sview] = []
            # Packed enums that use the canonical AoS row ABI. This includes the compiler AST,
            # user sealed hierarchies, and plain recursive enums. It is deliberately separate
            # from ast_refinement_names: a recursive enum such as `Tree` is packed/AoS without
            # belonging to the compiler's sealed Node hierarchy.
            aos_dynamic_names: mutable darray[sview] = []
            aos_dynamic_modules: mutable darray[sview] = []
            # Bumped by every IN-PLACE write to a table a packed row layout reads (field spans,
            # payload words, variant spans); with the tables' counts it stamps the memos below.
            layout_epoch: mutable u64 = 0
            # Narrow epoch for the in-place variant-count writes read by the sized-hierarchy
            # threshold. Packed-name appends are covered separately by packed_names.count.
            packed_variant_count_epoch: mutable u64 = 0
            # Memo for the hierarchy-wide sized-record threshold. Its key uses only the
            # packed enum inputs and the dedicated refinement epoch; optional/array/ref
            # intern tables grow during codegen and must not invalidate this memo.
            packed_ast_sized_hierarchy_valid: mutable bool = false
            packed_ast_sized_hierarchy_result: mutable bool = false
            packed_ast_sized_hierarchy_names_count: mutable usize = 0
            packed_ast_sized_hierarchy_variant_epoch: mutable u64 = 0
            packed_ast_sized_hierarchy_refinement_epoch: mutable u64 = 0
            # packed_ast_row_slots / packed_dynamic_aos_row_slots answers and the layout stamp
            # each was computed under (0 = none); see packed_layout_stamp.
            packed_ast_slots_memo: mutable u32 = 0
            packed_ast_slots_stamp: mutable u64 = 0
            packed_aos_slots_memo: mutable darray[u32] = []
            packed_aos_slots_stamp: mutable darray[u64] = []

        struct BackendConstants:
            # GLOBAL consts. stage0 INLINES them: `const LIMIT: i64 = 42` emits no `@LIMIT`
            # global and no load — `LIMIT + NAME.i64()` lowers to `sadd(42, 7)` (read from
            # its -emit llvm output). So a const is a compile-time VALUE substituted at the
            # use site, and the backend needs only name -> (type, folded value).
            #
            # Folded to a FIXPOINT, unlike aliases: stage0 ACCEPTS a forward reference here
            # (`const A: i64 = B + 2` before `const B` works — verified), so an in-order pass
            # would decline a program the reference compiler compiles. A CYCLE never folds
            # and stays unresolved, which declines — stage0 rejects it too ("const \"A\"
            # initializer must be a compile-time i64 value").
            const_names: mutable darray[sview] = []
            # The module a const was declared in, "" for a top-level one. Consts used to be
            # keyed by BARE NAME alone, so two modules each declaring `SIZE` collapsed onto
            # one row and the second silently overwrote the first -- a wrong answer, and one
            # that qualifying the use site did not save you from, because the collision was
            # in the table rather than in the lookup.
            const_owners: mutable darray[sview @source] = []
            # Name chains over const_names (codegen_name_chains.elisa).
            const_name_buckets: mutable darray[i64] = []
            const_name_tails: mutable darray[i64] = []
            const_name_next: mutable darray[i64] = []
            const_types: mutable darray[ValueType] = []
            const_values: mutable darray[i64] = []
            const_resolved: mutable darray[bool] = []
            # A FLOAT const's source text (`const PI: f64 = 3.0` → "3.0"), inlined at the use
            # site via LLVMConstRealOfString (never re-parse the decimal). "" for non-float.
            const_float_text: mutable darray[sview] = []
            # A float const whose initializer is an EXPRESSION (`const D: f64 = W - S`) has no
            # source text to inline, so it carries its FOLDED VALUE instead. Keeping this
            # separate from const_values (which is i64) is the point: folding a float const
            # through the INTEGER folder is what made `W - S` silently read back as 0.0.
            # A `const cstr = "..."` carries its literal TEXT: the use site materializes a
            # global string and yields a POINTER to it, the same thing an inline literal
            # emits. Without this the const was simply unresolved and every function that
            # referenced it DECLINED -- which is what kept nw-core's config suite on stage0.
            const_cstr_text: mutable darray[sview] = []
            # Whether that text carrier holds a string LITERAL initializer. The text alone cannot
            # say: `const E = ""` carries an empty text exactly like a const that has none, so every
            # use of an empty string const declined while stage0 emitted the empty string.
            const_text_is_literal: mutable darray[bool] = []
            # Whether the const's TYPE came from that literal (`const NAME = "..."`, unannotated).
            # stage0 types such a const as the literal's own static `u8&`, so `NAME.len` is a
            # compile-time string's length and folds; an annotated `const NAME: cstr = "..."` is a
            # C string whose `.len` stays a runtime ctx_strlen (see const_string_len).
            const_literal_typed: mutable darray[bool] = []
            const_float_values: mutable darray[f64] = []
            const_float_ok: mutable darray[bool] = []
            # A global const AGGREGATE (array) is backed by a real module GLOBAL rather than a
            # folded scalar: `const_globals[i]` is its `@name` handle (indexed by GEP at use)
            # and `const_global_ok[i]` marks the slot as materialized. Scalar consts leave the
            # handle null and stay on the fold path above.
            const_globals: mutable darray[LLVMValueRef] = []
            const_global_ok: mutable darray[bool] = []

        struct BackendGlobals:
            # External C globals. Unlike Elisa `const` values these remain addressable LLVM
            # declarations and are loaded/stored at each use site.
            extern_global_names: mutable darray[sview] = []
            extern_global_types: mutable darray[ValueType] = []
            extern_global_handles: mutable darray[LLVMValueRef] = []
            mutable_global_names: mutable darray[sview] = []
            # Name chains over mutable_global_names. Built after the registry becomes large
            # enough to amortize the fixed bucket table; appends keep an initialized index
            # current, while name_chain_first/next preserve the linear fallback beforehand.
            mutable_global_name_buckets: mutable darray[i64] = []
            mutable_global_name_tails: mutable darray[i64] = []
            mutable_global_name_next: mutable darray[i64] = []
            # The enclosing `module M:` name, "" at top level — the same key consts carry in
            # const_owners. Without it two modules' `global counter` shared ONE row and the
            # last one materialized wrote its handle over the first's (see the lookup).
            mutable_global_owners: mutable darray[sview] = []
            mutable_global_types: mutable darray[ValueType] = []
            mutable_global_handles: mutable darray[LLVMValueRef] = []

        struct BackendContracts:
            # The `ensure PRED` postconditions of the function CURRENTLY being emitted.
            # Refilled per function by emit_function_body and read at every `return`, which
            # is where stage0 checks them: it allocates `%result`, stores the returned value
            # into it, then branches on each predicate. Threaded on StructTable rather than
            # Runtime because Runtime is COPIED per function (copied_runtime) and this is a
            # container -- the side-table channel static-branch positions already uses.
            pending_ensures: mutable darray[Expr] = []
            # Whether this build CHECKS contracts at runtime. stage0's rule, which this
            # mirrors: checks are emitted at -O0 (or under ELISACORE_FORCE_CONTRACTS) and
            # erased above it -- "debug verifies what release assumes". Defaults to true so
            # the header and shape paths, which build a table without a driver, keep
            # checking. Currently read by the extern `ensure` boundary check (docs/127 D8);
            # the in-body contract statements do NOT yet consult it, which is a known
            # divergence from stage0 at -O1 and above.
            checked_contracts: mutable bool = true
            # A native extern's `ensure` predicates, keyed by its declaration offset, with the trusted ones already filtered out. The parser captures
            # them into the file's signature-contract channel; the backend re-checks each one
            # at every call site, which is what makes an extern's postcondition a GUARANTEE
            # rather than an assumption (docs/127 D8).
            # Global source byte offset plus one, matching FnTable.offsets for native externs.
            extern_ensure_offsets: mutable darray[u32] = []
            extern_ensure_exprs: mutable darray[Expr] = []
            # Whole-program facts used by the opt-in disjoint-parameter alias metadata.
            # A mask bit marks a source parameter that is proven distinct from every other
            # eligible darray reference parameter at every observed call site.
            disjoint_function_names: mutable darray[sview] = []
            disjoint_function_masks: mutable darray[u64] = []
            disjoint_function_arities: mutable darray[u32] = []
            disjoint_candidate_masks: mutable darray[u64] = []

        struct BackendBindings:
            # Paths proven non-null by an `assert PATH != null` in the function currently
            # being emitted. stage0 NARROWS on that assert: `assert m.items != null` makes
            # the following `items: DictBucket[K,T]& = m.items` legal (it rejects the same
            # assignment WITHOUT the assert -- verified against stage0 both ways). The std
            # dict's find/get/put all depend on it.
            #
            # A path is `owner.field` (field == "" for a bare local). Recorded per function
            # and dropped as soon as anything ASSIGNS to the path, since the proof dies with
            # the value it was about.
            narrowed_owners: mutable darray[sview @source] = []
            narrowed_fields: mutable darray[sview @source] = []
            # The CURRENT generic instantiation's type-parameter bindings: `binding_names[i]`
            # (e.g. "T") stands for `binding_types[i]` (e.g. i64). Empty outside one.
            #
            # These live in the registry rather than as their own threaded parameter: the
            # registry already reaches every place a type is resolved, and constructing a
            # fresh empty bindings table per call site is REGION-POLYMORPHIC (so illegal in
            # a non-region-inferable context). Set on entry to an instantiation, cleared on
            # exit. `binding_names` are sviews into the source buffer, so nothing dangles.
            binding_names: mutable darray[sview @source] = []
            binding_types: mutable darray[ValueType] = []
            local_binding_names: mutable darray[sview] = []
            local_binding_lines: mutable darray[u32] = []
            # Line chains over local_binding_lines (codegen_name_chains.elisa).
            local_binding_line_buckets: mutable darray[i64] = []
            local_binding_line_tails: mutable darray[i64] = []
            local_binding_line_next: mutable darray[i64] = []
            local_binding_offsets: mutable darray[u32] = []
            local_binding_modes: mutable darray[i64] = []
            # CONDITION BINDING SLOTS — one entry-block alloca per name bound anywhere in the
            # condition currently being emitted, shared by every `is` test in it.
            #
            # `a is T(x) or b is U(x)` short-circuits: if the first test matches, the second
            # test's block never runs. Giving each test its own slot and resolving the body's
            # `x` to the LAST one declared then reads a slot nothing ever stored — which is
            # how the gen3 bootstrap died (a garbage AST handle into ctx_aos_store_record).
            # Sharing one slot means whichever alternative matched is the one that wrote it.
            # Mirrors stage0's createConditionBindingScope / `<name>.cond` entry allocas.
            cond_bind_names: mutable darray[sview] = []
            cond_bind_slots: mutable darray[LLVMValueRef] = []
            cond_bind_types: mutable darray[LLVMTypeRef] = []
            # Emission depth of `emit_condition`. The registry is live while > 0 and cleared
            # when the outermost condition finishes, so slots never leak across conditions.
            cond_bind_depth: mutable usize = 0
            # Parameter names of the function whose body the global-store analysis is
            # scanning. A parameter shadows a module global of the same name for the whole
            # body, so a place rooted at it is never a global store (codegen_global_rehome).
            global_store_shadows: mutable darray[sview] = []

        struct BackendFunctionTypes:
            # `fn(…)->R` signature reconstruction. The parser drops fn-type param/return types
            # from the AST, recording only HEAD NAMES on the __lambda_return / __lambda_param
            # annotations keyed by the fn-type token offset. Populated ONCE (register_fn_signatures)
            # from file.enum_annotations: `fn_return_lines[i]` -> `fn_return_heads[i]`. A resolved
            # Fn ValueType carries its RETURN type in the `fn_pool_returns` side-pool at `bits`,
            # so a call through a fn value knows its result type even in argument position.
            fn_return_lines: mutable darray[u32] = []
            fn_return_heads: mutable darray[sview] = []
            fn_return_offsets: mutable darray[u32] = []
            fn_pool_returns: mutable darray[ValueType] = []
            # Whether each first-class function type returns an error union, and the
            # source family selector (`R` while a generic is being specialized). The
            # return payload remains in fn_pool_returns only for infallible functions;
            # fallible function values carry the complete ErrorUnion ValueType there.
            fn_pool_errors: mutable darray[bool] = []
            fn_pool_error_families: mutable darray[sview @source] = []
            fn_param_lines: mutable darray[u32] = []
            fn_param_offsets: mutable darray[u32] = []
            fn_param_heads: mutable darray[sview] = []
            fn_pool_param_start: mutable darray[usize] = []
            fn_pool_param_count: mutable darray[usize] = []
            fn_pool_params: mutable darray[ValueType] = []
            # Function-type error suffix metadata, keyed by the Expr.Lambda token offset. The
            # parser preserves `fn(...) -> T error[E]` here before annotation resolution.
            fn_error_lines: mutable darray[u32] = []
            fn_error_offsets: mutable darray[u32] = []
            fn_error_occurrence_offsets: mutable darray[u32] = []
            fn_error_families: mutable darray[sview @source] = []
            # Full function-value parameter type expressions copied from Ast::File. These
            # preserve generic arguments that the legacy head-only annotation rows discard.
            fn_type_param_lines: mutable darray[u32] = []
            fn_type_param_offsets: mutable darray[u32] = []
            fn_type_return_lines: mutable darray[u32] = []
            fn_type_return_offsets: mutable darray[u32] = []
            fn_type_return_exprs: mutable darray[Ast::Expr] = []
            fn_type_param_exprs: mutable darray[Expr] = []

        # LLVM helpers created while lowering dynamic-array growth. These handles are
        # module-local, so each call site can reuse the compiler-owned helper even when a
        # source function or @link_name occupies its preferred symbol spelling.
        struct BackendContainerHelpers:
            darray_grow: mutable LLVMValueRef? = null
            darray_grow_to: mutable LLVMValueRef? = null

        struct BackendRegions:
            # Lines of functions declared with a REGION PARAMETER (`def f[@r](…)`). Such a
            # function allocates into the CALLER's region -- `xs: darray[T] @r = []` inside it
            # must outlive the call -- so it takes the arena as a hidden trailing parameter
            # even when nothing in its signature is a growable reference. Recorded by the
            # parser as a `__region_param` row in `local_region_annotations`.
            region_param_lines: mutable darray[u32] = []
            # Backend-normalized owner declaration offsets (Ast::Pos.offset + 1) distinguish
            # region parameters from same-line siblings and match function_offset_of/FnTable.
            region_param_owner_offsets: mutable darray[u32] = []
            # Region selector names paired with line and owner offset. This lets `new[r]` inside
            # a generic body select its hidden caller-region slot without borrowing a same-line
            # sibling's region names or arena positions.
            region_param_names: mutable darray[sview] = []
            # Exact hidden-region facts for ordinary function declarations. The flags are flat
            # and parallel to each function's source parameters; they are populated by the
            # module pre-pass after direct body growth is known and after forwarding reaches a
            # fixpoint.
            region_fact_names: mutable darray[sview] = []
            # Name buckets accelerate forwarding lookup without changing row order.
            region_fact_buckets: mutable darray[i64] = []
            region_fact_next: mutable darray[i64] = []
            # The owner module for each region-fact row. Bare names are not globally unique:
            # a module member such as `Box::add` may share its spelling with a stdlib generic
            # `add`. Keeping the owner beside the fact lets the forwarding fixpoint resolve a
            # call the same way the ordinary backend resolver does, instead of taking the first
            # same-named row and silently dropping the caller-region ABI slot.
            region_fact_owners: mutable darray[sview] = []
            region_fact_lines: mutable darray[u32] = []
            # Backend-normalized declaration offsets (Ast::Pos.offset + 1) disambiguate
            # same-line fact rows and match function_offset_of/FnTable.
            region_fact_offsets: mutable darray[u32] = []
            # Line chains over region_fact_lines (codegen_name_chains.elisa).
            region_fact_line_buckets: mutable darray[i64] = []
            region_fact_line_tails: mutable darray[i64] = []
            region_fact_line_next: mutable darray[i64] = []
            region_fact_starts: mutable darray[usize] = []
            region_fact_counts: mutable darray[usize] = []
            region_fact_params: mutable darray[bool] = []
            # Reverse dependencies for the region-forwarding worklist. Each edge stores
            # a caller visit under the callee fact row it reads.
            region_fact_dependent_heads: mutable darray[i64] = []
            region_fact_dependent_next: mutable darray[i64] = []
            region_fact_dependent_visits: mutable darray[usize] = []
            region_fact_dependency_last_visit: mutable darray[i64] = []
            region_forward_active_visit: mutable usize = 0
            region_forward_recording: mutable bool = false
            # Parameter names, parallel to region_fact_params, so the forwarding
            # pass can map a NAMED argument to its callee position.
            region_fact_param_names: mutable darray[sview] = []
            # The reference aliases (`ref_alias_collect`) of the function the region pre-pass
            # is scanning, so growth through `r = p` flags `p` exactly as `p.push` would.
            region_alias_names: mutable darray[sview @source] = []
            region_alias_roots: mutable darray[sview @source] = []
            # Alias graphs are built during the declaration pass only for alias-heavy
            # functions. Node-name buckets resolve names, ordered edge chains
            # preserve every alias/rebind/branch edge, and generation stamps make cycle
            # detection linear without allocating or linearly searching a visited list.
            # One small sentinel row per declaration visit maps only indexed functions to
            # graph metadata. The larger start/count tables contain rows only for graphs
            # that pass the alias-count threshold.
            region_alias_graph_slot_rows: mutable darray[i64] = []
            region_alias_graph_node_starts: mutable darray[usize] = []
            region_alias_graph_node_counts: mutable darray[usize] = []
            region_alias_graph_edge_starts: mutable darray[usize] = []
            region_alias_graph_edge_counts: mutable darray[usize] = []
            region_alias_graph_bucket_starts: mutable darray[usize] = []
            region_alias_graph_bucket_counts: mutable darray[usize] = []
            region_alias_graph_generations: mutable darray[u64] = []
            region_alias_graph_active_slot: mutable usize = 0
            region_alias_graph_active: mutable bool = false
            region_alias_graph_buckets: mutable darray[i64] = []
            region_alias_graph_node_names: mutable darray[sview @source] = []
            region_alias_graph_node_heads: mutable darray[i64] = []
            region_alias_graph_node_tails: mutable darray[i64] = []
            region_alias_graph_node_params: mutable darray[i64] = []
            region_alias_graph_node_seen: mutable darray[u64] = []
            # Shared breadth-first work queue for graph root/forwarding walks. The two
            # passes are synchronous and non-reentrant; clearing it retains capacity
            # across repeated roots and forwarding rounds.
            region_alias_graph_pending_nodes: mutable darray[i64] = []
            region_alias_graph_edge_sources: mutable darray[i64] = []
            region_alias_graph_edge_targets: mutable darray[i64] = []
            region_alias_graph_edge_next: mutable darray[i64] = []
            local_region_lines: mutable darray[u32] = []
            local_region_offsets: mutable darray[u32] = []
            local_region_names: mutable darray[sview] = []

        # Module state composed by responsibility. Registries retain their row indexes;
        # temporary function state is separate from persistent type and symbol facts.
        struct StructTable:
            memory: mutable BackendMemory = BackendMemory{}
            diagnostics: mutable BackendDiagnostics = BackendDiagnostics{}
            records: mutable BackendRecords = BackendRecords{}
            errors: mutable BackendErrors = BackendErrors{}
            annotations: mutable BackendAnnotations = BackendAnnotations{}
            storage_layouts: mutable BackendStorageLayouts = BackendStorageLayouts{}
            generics: mutable BackendGenerics = BackendGenerics{}
            aliases: mutable BackendAliases = BackendAliases{}
            target: mutable BackendTarget
            interned_types: mutable BackendInternedTypes = BackendInternedTypes{}
