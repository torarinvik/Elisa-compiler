                        null return if not is_numeric_type(in_operand_type)
                        in_bool_type: LLVMTypeRef = LLVMInt1TypeInContext(ctx)
                        if emit_expression(in_left, in_operand_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is in_left_value:
                            in_result: mutable LLVMValueRef = LLVMConstInt(in_bool_type, 0, 0)
                            in_declined: mutable bool = false
                            for in_element in in_elements |in_result, in_declined, in_left_value, in_operand_type, local_scope, fns, structs, generics, runtime, m, ctx, builder|:
                                continue if in_declined
                                if emit_expression(in_element, in_operand_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is in_element_value:
                                    in_eq: LLVMValueRef = LLVMBuildICmp(builder, 32, in_left_value, in_element_value, "in.eq")
                                    in_result <- LLVMBuildOr(builder, in_result, in_eq, "in.or")
                                else:
                                    in_declined <- true
                            null return if in_declined
                            return in_result
                        return null
                    return null
            if expression is Expr.Binary(binary_left, binary_operator, binary_right, binary_line):
                # `and`/`or` SHORT-CIRCUIT: the right side must only be emitted on the path
                # that reaches it, so they cannot go through emit_binary.
                if binary_operator == TokenKind.And or binary_operator == TokenKind.Or:
                    return emit_short_circuit(binary_left, binary_operator, binary_right, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                # The OPERANDS' type is not the result type: `a < b` yields bool but must
                # compare at a's type. Take whichever side is known; a literal defers.
                operand_type: mutable ValueType = expression_type(binary_left, local_scope, fns, structs, generics)
                if operand_type.kind == TypeKind.Unmodeled:
                    operand_type <- expression_type(binary_right, local_scope, fns, structs, generics)
                if operand_type.kind == TypeKind.Unmodeled:
                    # Both sides are literals (`2 + 3`): fall back to the context, which
                    # for a comparison is bool — so use i64 there.
                    operand_type <- expected if is_numeric_type(expected) else ValueType{kind: TypeKind.Signed, bits: 64}
                # `heap T& + int` / `- int` — RAW-pointer arithmetic: advance by `int` elements
                # of T (a GEP at T's stride). The heap flag (not the kind) distinguishes this
                # from a SAFE `T&`, which value-adds below. The arena allocator (arena.elisa)
                # walks its backing store as `heap u8&`. A void pointee strides by bytes (i8).
                if ref_is_heap_ref(operand_type, structs) and (binary_operator == TokenKind.Plus or binary_operator == TokenKind.Minus):
                    heap_ptr_pointee: ValueType = ref_target_of(operand_type, structs)
                    heap_ptr_stride: LLVMTypeRef = LLVMInt8TypeInContext(ctx) if heap_ptr_pointee.kind == TypeKind.Void else llvm_type_of(heap_ptr_pointee, structs, ctx)
                    if emit_expression(binary_left, operand_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is heap_ptr_base:
                        if emit_expression(binary_right, ValueType{kind: TypeKind.Signed, bits: 64}, local_scope, fns, structs, generics, runtime, m, ctx, builder) is heap_ptr_offset:
                            heap_ptr_index: LLVMValueRef = heap_ptr_offset if binary_operator == TokenKind.Plus else LLVMBuildNeg(builder, heap_ptr_offset, "heap.ptr.neg")
                            heap_ptr_indices: mutable darray[LLVMValueRef] = [heap_ptr_index]
                            heap_ptr_indices_pointer: void& = (&heap_ptr_indices[0]).cast[void&] can Unsafe.PointerCast
                            return LLVMBuildGEP2(builder, heap_ptr_stride, heap_ptr_base, heap_ptr_indices_pointer, 1, "heap.ptr.arith")
                        return null
                    return null
                # `ptr + int` / `ptr - int` on a BYTE pointer — `void&` or `u8&` — is pointer
                # arithmetic (a GEP over i8), NOT a deref-then-add. The std's
                # collections_void_from_data_at walks raw bytes as `data.cast[u8&] + offset`,
                # and a `u8& + i8` emitted as an integer `add` is invalid IR that llc rejects
                # outright (it also truncated the offset to i8, silently capping it at 255).
                #
                # `u8&` and `void&` ONLY — verified against stage0 across referents: u8 GEPs,
                # while i8/u16/i32/u64/f64 all dereference and value-add. `u8&` is stage0's
                # designated raw-byte-pointer type, and the asymmetry with `i8&` is deliberate,
                # so this cannot be generalized to "any small integer referent".
                byte_ptr_target: ValueType = ref_target_of(operand_type, structs)
                is_byte_pointer: bool = byte_ptr_target.kind == TypeKind.Void or (byte_ptr_target.kind == TypeKind.Unsigned and byte_ptr_target.bits == 8)
                if operand_type.kind == TypeKind.Ref and is_byte_pointer and (binary_operator == TokenKind.Plus or binary_operator == TokenKind.Minus):
                    if emit_expression(binary_left, operand_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is ptr_arith_base:
                        if emit_expression(binary_right, ValueType{kind: TypeKind.Signed, bits: 64}, local_scope, fns, structs, generics, runtime, m, ctx, builder) is ptr_arith_offset:
                            ptr_arith_index: LLVMValueRef = ptr_arith_offset if binary_operator == TokenKind.Plus else LLVMBuildNeg(builder, ptr_arith_offset, "ptr.neg")
                            ptr_arith_indices: mutable darray[LLVMValueRef] = [ptr_arith_index]
                            ptr_arith_indices_pointer: void& = (&ptr_arith_indices[0]).cast[void&] can Unsafe.PointerCast
                            return LLVMBuildGEP2(builder, LLVMInt8TypeInContext(ctx), ptr_arith_base, ptr_arith_indices_pointer, 1, "ptr.arith")
                        return null
                    return null
                # A ref operand auto-dereferences: compare/compute at its target type.
                operand_type <- ref_target_of(operand_type, structs) if operand_type.kind == TypeKind.Ref
                # `a == C.R` / `a != C.R` — a PAYLOAD-enum value equality. The value is a
                # `{i32 tag, …}` aggregate, so compare the TAG fields (stage0 compares the
                # ordinal). A payloadless plain enum is this representation, and equality is the
                # one operation on it not already covered by match/ctor/return.
                if operand_type.kind == TypeKind.PayloadEnum and (binary_operator == TokenKind.EqEq or binary_operator == TokenKind.BangEq):
                    if emit_expression(binary_left, operand_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is penum_eq_left:
                        if emit_expression(binary_right, operand_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is penum_eq_right:
                            penum_eq_left_tag: LLVMValueRef = LLVMBuildExtractValue(builder, penum_eq_left, 0, "penum.eq.ltag")
                            penum_eq_right_tag: LLVMValueRef = LLVMBuildExtractValue(builder, penum_eq_right, 0, "penum.eq.rtag")
                            penum_eq_value: LLVMValueRef = LLVMBuildICmp(builder, int_predicate_of(binary_operator), penum_eq_left_tag, penum_eq_right_tag, "penum.eq")
                            penum_eq_result: ValueType = ValueType{kind: TypeKind.Bool, bits: 1}
                            return emit_conversion(penum_eq_value, penum_eq_result, expected, structs, ctx, builder) if expected.kind != TypeKind.Unmodeled and (expected.kind != penum_eq_result.kind or expected.bits != penum_eq_result.bits) else penum_eq_value
                        return null
                    return null
                # `cstr == cstr` / `cstr != cstr`: stage0 lowers to `ctx_streq(a, b)` (i64,
                # nonzero = equal) — a CONTENT compare, not a pointer compare. Reduce it to an
                # i64 `streq_code <op> 0` and reuse the ordinary integer-comparison machinery so
                # the surrounding-context widening is identical. `==` is `streq != 0`, `!=` is
                # `streq == 0` (the operator inverts against the zero test).
                if operand_type.kind == TypeKind.CStr and (binary_operator == TokenKind.EqEq or binary_operator == TokenKind.BangEq):
                    cstr_type: ValueType = ValueType{kind: TypeKind.CStr, bits: 0}
                    if emit_expression(binary_left, cstr_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is streq_left:
                        if emit_expression(binary_right, cstr_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is streq_right:
                            streq_args: mutable darray[LLVMValueRef] = [streq_left, streq_right]
                            streq_args_pointer: void& = (&streq_args[0]).cast[void&] can Unsafe.PointerCast
                            streq_code: LLVMValueRef = LLVMBuildCall2(builder, runtime.streq_type, runtime.streq, streq_args_pointer, 2, "streq")
                            streq_inner_op: TokenKind = TokenKind.BangEq if binary_operator == TokenKind.EqEq else TokenKind.EqEq
                            streq_zero: LLVMValueRef = LLVMConstInt(LLVMInt64TypeInContext(ctx), 0, 0)
                            streq_int64: ValueType = ValueType{kind: TypeKind.Signed, bits: 64}
                            streq_result_type: ValueType = ValueType{kind: TypeKind.Bool, bits: 1}
                            if emit_binary(streq_inner_op, streq_code, streq_zero, streq_int64, structs, runtime.fast_math, ctx, builder) is streq_value:
                                return emit_conversion(streq_value, streq_result_type, expected, structs, ctx, builder) if expected.kind != TypeKind.Unmodeled and (expected.kind != streq_result_type.kind or expected.bits != streq_result_type.bits) else streq_value
                            return null
                        return null
                    return null
                # `sview == sview` / `!=`: `ctx_string_views_eq(a, b)` (BY VALUE, i64 nonzero =
                # equal), then the same `code <op> 0` reduction as the cstr path.
                if operand_type.kind == TypeKind.SView and (binary_operator == TokenKind.EqEq or binary_operator == TokenKind.BangEq):
                    if emit_expression(binary_left, operand_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is sveq_left:
                        if emit_expression(binary_right, operand_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is sveq_right:
                            sveq_args: mutable darray[LLVMValueRef] = [sveq_left, sveq_right]
                            sveq_args_pointer: void& = (&sveq_args[0]).cast[void&] can Unsafe.PointerCast
                            sveq_code: LLVMValueRef = LLVMBuildCall2(builder, runtime.sview_eq_type, runtime.sview_eq, sveq_args_pointer, 2, "sview.eq")
                            sveq_inner_op: TokenKind = TokenKind.BangEq if binary_operator == TokenKind.EqEq else TokenKind.EqEq
                            sveq_zero: LLVMValueRef = LLVMConstInt(LLVMInt64TypeInContext(ctx), 0, 0)
                            sveq_int64: ValueType = ValueType{kind: TypeKind.Signed, bits: 64}
                            sveq_result_type: ValueType = ValueType{kind: TypeKind.Bool, bits: 1}
                            if emit_binary(sveq_inner_op, sveq_code, sveq_zero, sveq_int64, structs, runtime.fast_math, ctx, builder) is sveq_value:
                                return emit_conversion(sveq_value, sveq_result_type, expected, structs, ctx, builder) if expected.kind != TypeKind.Unmodeled and (expected.kind != sveq_result_type.kind or expected.bits != sveq_result_type.bits) else sveq_value
                            return null
                        return null
                    return null
                # `bool == bool` / `bool != bool` compare as `icmp eq i1` (stage0's shape).
                # Equality is the only bool operator; ordering/arithmetic on bool stays declined.
                bool_equality: bool = operand_type.kind == TypeKind.Bool and (binary_operator == TokenKind.EqEq or binary_operator == TokenKind.BangEq)
                null return if not is_numeric_type(operand_type) and not bool_equality
                # A comparison/`is` operator yields `bool` regardless of the OPERAND type, so
                # the value handed to the surrounding-context conversion is a bool, not an
                # `operand_type`-width int. Widening it as if it were `operand_type` (e.g.
                # `bool` <- `i64`) declines and strips the whole function.
                result_type: ValueType = ValueType{kind: TypeKind.Bool, bits: 1} if int_predicate_of(binary_operator) >= 0 else operand_type
                # Elisa's operation type is anchored by the left operand (stage0 converts
                # the right operand to that type, then widens the result to the surrounding
                # context if needed). This is observable for `i32 + i64`: the i64 is narrowed
                # to i32 for the arithmetic, and the resulting i32 is widened at assignment.
                # A REF operand auto-dereferences to its target, so compare the TARGET's
                # width/kind, not the pointer (`total + a` where `a: i64&` from a dict `.get`
                # binding must not read as a mixed-width Ref-vs-i64 mismatch).
                left_own_raw: ValueType = expression_type(binary_left, local_scope, fns, structs, generics)
                right_own_raw: ValueType = expression_type(binary_right, local_scope, fns, structs, generics)
                left_own: ValueType = ref_target_of(left_own_raw, structs) if left_own_raw.kind == TypeKind.Ref else left_own_raw
                right_own: ValueType = ref_target_of(right_own_raw, structs) if right_own_raw.kind == TypeKind.Ref else right_own_raw
                if left_own.kind != TypeKind.Unmodeled and right_own.kind != TypeKind.Unmodeled:
                    null return if left_own.kind != operand_type.kind or left_own.bits != operand_type.bits
                    null return if not is_integer_type(left_own) and (right_own.kind != operand_type.kind or right_own.bits != operand_type.bits)
                if emit_expression(binary_left, left_own if left_own.kind != TypeKind.Unmodeled else operand_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is left_raw:
                    if emit_expression(binary_right, right_own if right_own.kind != TypeKind.Unmodeled else operand_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is right_raw:
                        if left_own.kind == TypeKind.Unmodeled:
                            if right_own.kind == TypeKind.Unmodeled:
                                if emit_binary(binary_operator, left_raw, right_raw, operand_type, structs, runtime.fast_math, ctx, builder) is binary_value:
                                    return emit_conversion(binary_value, result_type, expected, structs, ctx, builder) if expected.kind != TypeKind.Unmodeled and (expected.kind != result_type.kind or expected.bits != result_type.bits) else binary_value
                                return null
                            if emit_conversion(right_raw, right_own, operand_type, structs, ctx, builder) is converted_right:
                                if emit_binary(binary_operator, left_raw, converted_right, operand_type, structs, runtime.fast_math, ctx, builder) is binary_value:
                                    return emit_conversion(binary_value, result_type, expected, structs, ctx, builder) if expected.kind != TypeKind.Unmodeled and (expected.kind != result_type.kind or expected.bits != result_type.bits) else binary_value
                                return null
                            return null
                        if emit_conversion(left_raw, left_own, operand_type, structs, ctx, builder) is converted_left:
                            if right_own.kind == TypeKind.Unmodeled:
                                if emit_binary(binary_operator, converted_left, right_raw, operand_type, structs, runtime.fast_math, ctx, builder) is binary_value:
                                    return emit_conversion(binary_value, result_type, expected, structs, ctx, builder) if expected.kind != TypeKind.Unmodeled and (expected.kind != result_type.kind or expected.bits != result_type.bits) else binary_value
                                return null
                            if emit_conversion(right_raw, right_own, operand_type, structs, ctx, builder) is converted_right:
                                if emit_binary(binary_operator, converted_left, converted_right, operand_type, structs, runtime.fast_math, ctx, builder) is binary_value:
                                    return emit_conversion(binary_value, result_type, expected, structs, ctx, builder) if expected.kind != TypeKind.Unmodeled and (expected.kind != result_type.kind or expected.bits != result_type.bits) else binary_value
                                return null
                        return null
                return null
            # A value `match` over an integer scrutinee: `match n: 0: 100 … _: 300`.
            #
            # Lowered as an ordered COMPARE CHAIN, not a switch: arms must be tried in
            # source order, and turning a dense chain into a switch is llc's job.
            if expression is Expr.Match(match_scrutinee, match_arms, match_line):
                scrutinee_type: ValueType = resolve_type(match_scrutinee, ValueType{kind: TypeKind.Signed, bits: 64}, local_scope, fns, structs, generics)
                # An integer scrutinee compares directly; a PAYLOAD ENUM compares on its TAG.
                penum_scrutinee: bool = scrutinee_type.kind == TypeKind.PayloadEnum
                # A PACKED scrutinee is an i32 store INDEX: its tag and payload are read back
                # through the runtime rather than out of the value.
                packed_scrutinee: bool = scrutinee_type.kind == TypeKind.PackedEnum
                # A CSTR scrutinee's arms are string-literal patterns compared with ctx_streq.
                cstr_scrutinee: bool = scrutinee_type.kind == TypeKind.CStr
                # An SVIEW scrutinee's arms compare each literal via ctx_string_views_eq.
                sview_scrutinee: bool = scrutinee_type.kind == TypeKind.SView
                null return if packed_scrutinee and runtime.active_store_enum != packed_root_index_of(structs, scrutinee_type.bits.i64())
                null return if not is_integer_type(scrutinee_type) and not penum_scrutinee and not packed_scrutinee and not cstr_scrutinee and not sview_scrutinee
                match_type: LLVMTypeRef = llvm_type_of(expected, structs, ctx)
                null return if expected.kind == TypeKind.Unmodeled
                if emit_expression(match_scrutinee, scrutinee_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is scrutinee_raw:
                    function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                    # `%match.tag.value = extractvalue %Shape %sh, 0` — stage0's shape. The
                    # tag is an i32 regardless of the payload, so the compare constant below
                    # is built at i32, not at the scrutinee's own type.
                    scrutinee: mutable LLVMValueRef = scrutinee_raw
                    compare_type: mutable LLVMTypeRef = llvm_type_of(scrutinee_type, structs, ctx)
                    penum_slot: mutable LLVMValueRef = scrutinee_raw
                    if packed_scrutinee:
                        # `%packed.tag.store = call i32 @ctx_packed_store_read_variant_sparse_tag(ptr %state, i32 %n)`
                        packed_match_state: LLVMValueRef = LLVMBuildExtractValue(builder, runtime.active_store, 2, "packed.state")
                        packed_tag_index: LLVMValueRef = LLVMBuildZExt(builder, scrutinee_raw, LLVMInt64TypeInContext(ctx), "packed.tag.index") if runtime.packed_mode == 2 else scrutinee_raw
                        packed_tag_args: mutable darray[LLVMValueRef] = [packed_match_state, packed_tag_index]
                        packed_tag_pointer: void& = (&packed_tag_args[0]).cast[void&] can Unsafe.PointerCast
                        scrutinee <- LLVMBuildCall2(builder, runtime.packed_read_tag_type, runtime.packed_read_tag, packed_tag_pointer, 2, "packed.tag.store")
                        if runtime.packed_mode == 2:
                            packed_row_type: LLVMTypeRef = packed_row_llvm_type(structs, scrutinee_type.bits.i64(), ctx)
                            packed_tag_pointer2: LLVMValueRef = LLVMBuildStructGEP2(builder, packed_row_type, scrutinee, 0, "packed.aos.tag.ptr")
                            scrutinee <- LLVMBuildLoad2(builder, LLVMInt32TypeInContext(ctx), packed_tag_pointer2, "packed.aos.tag")
                        compare_type <- LLVMInt32TypeInContext(ctx)
                    if penum_scrutinee:
                        scrutinee <- LLVMBuildExtractValue(builder, scrutinee_raw, 0, "match.tag.value")
                        compare_type <- LLVMInt32TypeInContext(ctx)
                        # The payload is read through memory (stage0 spills the value too),
                        # so the arm's binding loads from this slot.
                        penum_slot <- LLVMBuildAlloca(builder, llvm_type_of(scrutinee_type, structs, ctx), "match.payload.tmp")
                        _ = LLVMBuildStore(builder, scrutinee_raw, penum_slot)
                    result_slot: LLVMValueRef = LLVMBuildAlloca(builder, match_type, "match.result")
                    done_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "match.done")
                    declined: mutable bool = false
                    saw_default: mutable bool = false

                    for arm in match_arms |declined, saw_default, cstr_scrutinee, sview_scrutinee, scrutinee, scrutinee_type, penum_scrutinee, packed_scrutinee, scrutinee_raw, penum_slot, compare_type, expected, result_slot, done_block, function, local_scope, fns, structs, generics, runtime, m, ctx, builder|:
                        # Once a catch-all is emitted the chain is closed.
                        continue if declined or saw_default
                        if arm_value_expression(arm.body) is arm_expression:
                            arm_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "match.arm")
                            # `match s: "done":` — an SVIEW scrutinee compares each literal via
                            # ctx_string_views_eq (nonzero = equal); `_`/binder is the catch-all.
                            if sview_scrutinee:
                                if arm.pattern is Pattern.Literal(sview_pat_text):
                                    sview_pat_storage: mutable darray[u8] = []
                                    if string_pattern_content_cstr(sview_pat_text, sview_pat_storage) is sview_pat_cstr:
                                        sview_pat_global: LLVMValueRef = LLVMBuildGlobalStringPtr(builder, sview_pat_cstr, "svpat")
                                        sview_lit_type: LLVMTypeRef = llvm_type_of(scrutinee_type, structs, ctx)
                                        sview_lit_undef: LLVMValueRef = LLVMGetUndef(sview_lit_type)
                                        sview_lit_with_ptr: LLVMValueRef = LLVMBuildInsertValue(builder, sview_lit_undef, sview_pat_global, 0, "svpat.ptr")
                                        sview_lit_len: LLVMValueRef = LLVMConstInt(LLVMInt64TypeInContext(ctx), (sview_pat_storage.count - 1).u64(), 0)
                                        sview_lit: LLVMValueRef = LLVMBuildInsertValue(builder, sview_lit_with_ptr, sview_lit_len, 1, "svpat.len")
                                        sview_next_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "match.next")
                                        sview_eq_args: mutable darray[LLVMValueRef] = [scrutinee_raw, sview_lit]
                                        sview_eq_pointer: void& = (&sview_eq_args[0]).cast[void&] can Unsafe.PointerCast
                                        sview_eq_code: LLVMValueRef = LLVMBuildCall2(builder, runtime.sview_eq_type, runtime.sview_eq, sview_eq_pointer, 2, "match.sview.eq")
                                        sview_hit: LLVMValueRef = LLVMBuildICmp(builder, 33, sview_eq_code, LLVMConstInt(LLVMInt64TypeInContext(ctx), 0, 0), "match.sview.hit")
                                        _ = LLVMBuildCondBr(builder, sview_hit, arm_block, sview_next_block)
                                        LLVMPositionBuilderAtEnd(builder, arm_block)
                                        if emit_expression(arm_expression, expected, local_scope, fns, structs, generics, runtime, m, ctx, builder) is sview_arm_value:
                                            _ = LLVMBuildStore(builder, sview_arm_value, result_slot)
                                            _ = LLVMBuildBr(builder, done_block)
                                        else:
                                            declined <- true
                                        LLVMPositionBuilderAtEnd(builder, sview_next_block)
                                    else:
                                        declined <- true
                                    continue
                                if is_catch_all_pattern(arm.pattern):
                                    _ = LLVMBuildBr(builder, arm_block)
                                    LLVMPositionBuilderAtEnd(builder, arm_block)
                                    if arm.pattern is Pattern.Binding(sview_bind_name):
                                        sview_bind_storage: mutable darray[u8] = []
                                        sview_bind_slot: LLVMValueRef = LLVMBuildAlloca(builder, llvm_type_of(scrutinee_type, structs, ctx), sview_to_cstr(sview_bind_name, sview_bind_storage))
                                        _ = LLVMBuildStore(builder, scrutinee_raw, sview_bind_slot)
                                        declare_local(local_scope, sview_bind_name, sview_bind_slot, scrutinee_type)
                                    if emit_expression(arm_expression, expected, local_scope, fns, structs, generics, runtime, m, ctx, builder) is sview_default_value:
                                        _ = LLVMBuildStore(builder, sview_default_value, result_slot)
                                        _ = LLVMBuildBr(builder, done_block)
                                        saw_default <- true
                                    else:
                                        declined <- true
                                    continue
                                declined <- true
                                continue
                            # `match s: "yes":` — a CSTR scrutinee compares each string-literal
                            # arm with `ctx_streq(s, "lit") != 0`; `_`/binder is the catch-all.
                            if cstr_scrutinee:
                                if arm.pattern is Pattern.Literal(cstr_pat_text):
                                    cstr_pat_storage: mutable darray[u8] = []
                                    if string_pattern_content_cstr(cstr_pat_text, cstr_pat_storage) is cstr_pat_cstr:
                                        cstr_pat_global: LLVMValueRef = LLVMBuildGlobalStringPtr(builder, cstr_pat_cstr, "strpat")
                                        cstr_next_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "match.next")
                                        cstr_streq_args: mutable darray[LLVMValueRef] = [scrutinee, cstr_pat_global]
                                        cstr_streq_pointer: void& = (&cstr_streq_args[0]).cast[void&] can Unsafe.PointerCast
                                        cstr_streq_code: LLVMValueRef = LLVMBuildCall2(builder, runtime.streq_type, runtime.streq, cstr_streq_pointer, 2, "match.streq")
                                        cstr_hit: LLVMValueRef = LLVMBuildICmp(builder, 33, cstr_streq_code, LLVMConstInt(LLVMInt64TypeInContext(ctx), 0, 0), "match.streq.hit")
                                        _ = LLVMBuildCondBr(builder, cstr_hit, arm_block, cstr_next_block)
                                        LLVMPositionBuilderAtEnd(builder, arm_block)
                                        if emit_expression(arm_expression, expected, local_scope, fns, structs, generics, runtime, m, ctx, builder) is cstr_arm_value:
                                            _ = LLVMBuildStore(builder, cstr_arm_value, result_slot)
                                            _ = LLVMBuildBr(builder, done_block)
                                        else:
                                            declined <- true
                                        LLVMPositionBuilderAtEnd(builder, cstr_next_block)
                                    else:
                                        declined <- true
                                    continue
                                if is_catch_all_pattern(arm.pattern):
                                    _ = LLVMBuildBr(builder, arm_block)
                                    LLVMPositionBuilderAtEnd(builder, arm_block)
                                    if arm.pattern is Pattern.Binding(cstr_bind_name):
                                        cstr_bind_storage: mutable darray[u8] = []
                                        cstr_bind_slot: LLVMValueRef = LLVMBuildAlloca(builder, llvm_type_of(scrutinee_type, structs, ctx), sview_to_cstr(cstr_bind_name, cstr_bind_storage))
                                        _ = LLVMBuildStore(builder, scrutinee_raw, cstr_bind_slot)
                                        declare_local(local_scope, cstr_bind_name, cstr_bind_slot, scrutinee_type)
                                    if emit_expression(arm_expression, expected, local_scope, fns, structs, generics, runtime, m, ctx, builder) is cstr_default_value:
                                        _ = LLVMBuildStore(builder, cstr_default_value, result_slot)
                                        _ = LLVMBuildBr(builder, done_block)
                                        saw_default <- true
                                    else:
                                        declined <- true
                                    continue
                                declined <- true
                                continue
                            # `Color.Red:` — a CONST ENUM variant arm is an ordinal
                            # comparison, exactly like an integer-literal arm (stage0 emits
                            # `icmp eq i8 %c, 0`). Resolved to its ordinal and folded into
                            # the same compare chain.
                            variant_ordinal: mutable i64 = -1
                            payload_binding: mutable sview = ""
                            payload_declined: mutable bool = false
                            # A MULTI-FIELD variant arm (`Rect(w, h)`) binds one name per field;
                            # collected here so the tuple-extract at the bind site can reach them
                            # (`variant_fields` is scoped to the pattern match below).
                            payload_multi_bindings: mutable darray[sview] = []
                            # The `is` binding is scoped to its branch, so the path is copied
                            # out for the payload load further down.
                            payload_path: mutable sview = ""
                            if arm.pattern is Pattern.Variant(variant_path, variant_fields):
                                payload_path <- variant_path
                                if packed_scrutinee:
                                    variant_ordinal <- packed_variant_index_of_path(variant_path, structs)
                                    if variant_fields.count == 1:
                                        if variant_fields[0] is Pattern.Binding(packed_bound):
                                            payload_binding <- packed_bound
                                        elif variant_fields[0] is Pattern.Wildcard:
                                            payload_binding <- ""
                                        else:
                                            payload_declined <- true
                                    if variant_fields.count > 1:
                                        for packed_multi_field in variant_fields |payload_multi_bindings, payload_declined|:
                                            if packed_multi_field is Pattern.Binding(packed_multi_bound):
                                                payload_multi_bindings.push(packed_multi_bound)
                                            elif packed_multi_field is Pattern.Wildcard:
                                                payload_multi_bindings.push("")
                                            else:
                                                payload_declined <- true
                                if penum_scrutinee:
                                    # `Shape.Circle(r)` — the tag is the variant's index in
                                    # its own enum, and the arm binds ONE name per payload field.
                                    variant_ordinal <- penum_variant_index_of_path(variant_path, structs)
                                    if variant_fields.count == 1:
                                        if variant_fields[0] is Pattern.Binding(bound_name):
                                            payload_binding <- bound_name
                                        elif variant_fields[0] is Pattern.Wildcard:
                                            payload_binding <- ""
                                        else:
                                            payload_declined <- true
                                    if variant_fields.count > 1:
                                        for multi_field in variant_fields |payload_multi_bindings, payload_declined|:
                                            if multi_field is Pattern.Binding(multi_bound):
                                                payload_multi_bindings.push(multi_bound)
                                            elif multi_field is Pattern.Wildcard:
                                                payload_multi_bindings.push("")
                                            else:
                                                payload_declined <- true
                                else:
                                    # CONST-enum 0-field variant (`Color.Red`). Guard on NOT packed:
                                    # a packed 0-field AST variant (`Ast::Expr.Absent`) already has its
                                    # ordinal from the packed branch above, and ordinal_of_dotted_path
                                    # (a const-enum lookup) would clobber it back to -1 and decline.
                                    if not packed_scrutinee and variant_fields.count == 0:
                                        variant_ordinal <- ordinal_of_dotted_path(variant_path, structs)
                            if payload_declined:
                                declined <- true
                                continue
                            if variant_ordinal >= 0:
                                next_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "match.next")
                                hit: LLVMValueRef = LLVMBuildICmp(builder, 32, scrutinee, LLVMConstInt(compare_type, variant_ordinal.u64(), 0), "match.cmp")
                                _ = LLVMBuildCondBr(builder, hit, arm_block, next_block)
                                LLVMPositionBuilderAtEnd(builder, arm_block)
                                if arm_has_guard(arm.guard):
                                    if emit_condition(arm.guard, local_scope, fns, structs, generics, runtime, m, ctx, builder) is guard_bit:
                                        guarded_body: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "match.guard")
                                        _ = LLVMBuildCondBr(builder, guard_bit, guarded_body, next_block)
                                        LLVMPositionBuilderAtEnd(builder, guarded_body)
                                    else:
                                        declined <- true
                                        continue
                                # Bind the payload INSIDE the arm: `getelementptr %Shape, ptr
                                # %tmp, i32 0, i32 1` then load at the variant's own type.
                                if packed_scrutinee and payload_binding != "":
                                    # `call i64 @ctx_packed_store_read_variant_sparse_word(i32 %n, ptr %state, i64 1)`
                                    # -- word 0 is the tag, so the first payload field is word 1.
                                    packed_arm_payload: ValueType = packed_payload_of_path(payload_path, structs)
                                    if packed_arm_payload.kind == TypeKind.Unmodeled:
                                        declined <- true
                                        continue
                                    packed_arm_state: LLVMValueRef = LLVMBuildExtractValue(builder, runtime.active_store, 2, "packed.state")
                                    # Word 0 is the tag and words 1..commons are the common
                                    # fields, so the first payload word is 1 + commons.
                                    packed_arm_commons: u32 = structs.packed_common_counts[scrutinee_type.bits.usize()]
                                    packed_arm_arena: LLVMValueRef = LLVMBuildExtractValue(builder, runtime.active_store, 0, "packed.arena")
                                    packed_word_args: mutable darray[LLVMValueRef] = [scrutinee_raw, packed_arm_state, LLVMConstInt(LLVMInt64TypeInContext(ctx), (1 + packed_arm_commons).u64(), 0)]
                                    if runtime.packed_mode == 1:
                                        packed_word_args <- [packed_arm_arena, scrutinee_raw, packed_arm_state, LLVMConstInt(LLVMInt64TypeInContext(ctx), (1 + packed_arm_commons).u64(), 0)]
                                    if runtime.packed_mode == 2:
                                        packed_word_index: LLVMValueRef = LLVMBuildZExt(builder, scrutinee_raw, LLVMInt64TypeInContext(ctx), "packed.word.index")
                                        packed_word_args <- [packed_arm_state, packed_word_index]
                                    packed_word_pointer: void& = (&packed_word_args[0]).cast[void&] can Unsafe.PointerCast
                                    packed_word: mutable LLVMValueRef = LLVMBuildCall2(builder, runtime.packed_read_word_type, runtime.packed_read_word, packed_word_pointer, 2 if runtime.packed_mode == 2 else (4 if runtime.packed_mode == 1 else 3), "packed.word")
                                    if runtime.packed_mode == 2:
                                        packed_aos_type: LLVMTypeRef = packed_row_llvm_type(structs, scrutinee_type.bits.i64(), ctx)
                                        if packed_is_ast_root(structs, packed_root_index_of(structs, scrutinee_type.bits.i64())):
                                            packed_aos_payload_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, packed_aos_type, packed_word, 1, "packed.aos.payload")
                                            packed_word <- LLVMBuildLoad2(builder, llvm_type_of(packed_arm_payload, structs, ctx), packed_aos_payload_pointer, "packed.aos.value")
                                        else:
                                            packed_aos_payload_array: LLVMTypeRef = LLVMArrayType(LLVMInt64TypeInContext(ctx), structs.packed_payload_words[scrutinee_type.bits.usize()])
                                            packed_aos_payload_field: LLVMValueRef = LLVMBuildStructGEP2(builder, packed_aos_type, packed_word, (1 + packed_arm_commons).u32(), "packed.aos.payload.field")
                                            packed_aos_indices: mutable darray[LLVMValueRef] = [LLVMConstInt(LLVMInt32TypeInContext(ctx), 0, 0), LLVMConstInt(LLVMInt32TypeInContext(ctx), 0, 0)]
                                            packed_aos_indices_pointer: void& = (&packed_aos_indices[0]).cast[void&] can Unsafe.PointerCast
                                            packed_aos_payload_pointer: LLVMValueRef = LLVMBuildGEP2(builder, packed_aos_payload_array, packed_aos_payload_field, packed_aos_indices_pointer, 2, "packed.aos.payload")
                                            packed_word <- LLVMBuildLoad2(builder, LLVMInt64TypeInContext(ctx), packed_aos_payload_pointer, "packed.aos.word")
                                    # The runtime hands back an i64 word; a narrower payload
                                    # is truncated to its own width.
                                    packed_word_type: mutable ValueType = ValueType{kind: TypeKind.Signed, bits: 64}
                                    packed_word_type <- packed_arm_payload if runtime.packed_mode == 2 and packed_is_ast_root(structs, packed_root_index_of(structs, scrutinee_type.bits.i64()))
                                    if emit_conversion(packed_word, packed_word_type, packed_arm_payload, structs, ctx, builder) is packed_arm_value:
                                        packed_arm_storage: mutable darray[u8] = []
                                        packed_arm_slot: LLVMValueRef = LLVMBuildAlloca(builder, llvm_type_of(packed_arm_payload, structs, ctx), sview_to_cstr(payload_binding, packed_arm_storage))
                                        _ = LLVMBuildStore(builder, packed_arm_value, packed_arm_slot)
                                        declare_local(local_scope, payload_binding, packed_arm_slot, packed_arm_payload)
                                    else:
                                        declined <- true
                                        continue
                                if packed_scrutinee and payload_multi_bindings.count > 1:
                                    packed_multi_slot: i64 = packed_slot_of_path(payload_path, structs)
                                    packed_multi_payload: ValueType = packed_payload_of_path(payload_path, structs)
                                    if packed_multi_slot < 0 or packed_multi_payload.kind == TypeKind.Unmodeled or runtime.packed_mode != 2:
                                        declined <- true
                                        continue
                                    packed_multi_row_type: LLVMTypeRef = packed_row_llvm_type(structs, scrutinee_type.bits.i64(), ctx)
                                    # The scrutinee is an i32 store index, not the row
                                    # pointer. Decode the AoS record before applying the
                                    # row GEP; passing the integer handle as a pointer
                                    # makes LLVM-C trap while emitting parser matches.
                                    packed_multi_state: LLVMValueRef = LLVMBuildExtractValue(builder, runtime.active_store, 2, "packed.multi.state")
                                    # `scrutinee` is the TAG loaded out of the row; the record is
                                    # addressed by the store HANDLE, which is `scrutinee_raw`.
                                    # Using the tag here read row #tag instead of row #handle, so
                                    # every multi-field packed binding saw another node's payload.
                                    packed_multi_index: LLVMValueRef = LLVMBuildZExt(builder, scrutinee_raw, LLVMInt64TypeInContext(ctx), "packed.multi.index")
                                    packed_multi_record_args: mutable darray[LLVMValueRef] = [packed_multi_state, packed_multi_index]
                                    packed_multi_record_pointer: void& = (&packed_multi_record_args[0]).cast[void&] can Unsafe.PointerCast
                                    packed_multi_record: LLVMValueRef = LLVMBuildCall2(builder, runtime.packed_read_word_type, runtime.packed_read_word, packed_multi_record_pointer, 2, "packed.aos.aggregate.record")
                                    packed_multi_payload_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, packed_multi_row_type, packed_multi_record, (1 + structs.packed_common_counts[scrutinee_type.bits.usize()]), "packed.aos.aggregate.ptr")
                                    packed_multi_value: LLVMValueRef = LLVMBuildLoad2(builder, llvm_type_of(packed_multi_payload, structs, ctx), packed_multi_payload_pointer, "packed.aos.aggregate")
                                    packed_multi_start: usize = structs.packed_field_type_start[packed_multi_slot.usize()]
                                    for packed_multi_index in 0..<payload_multi_bindings.count |payload_multi_bindings, packed_multi_start, packed_multi_value, structs, local_scope, ctx, builder|:
                                        packed_multi_type: ValueType = copied_type(structs.packed_field_types[packed_multi_start + packed_multi_index])
                                        packed_multi_field: LLVMValueRef = LLVMBuildExtractValue(builder, packed_multi_value, packed_multi_index.u32(), "packed.aos.field")
                                        if payload_multi_bindings[packed_multi_index] != "":
                                            packed_multi_storage: mutable darray[u8] = []
                                            packed_multi_slot_ptr: LLVMValueRef = LLVMBuildAlloca(builder, llvm_type_of(packed_multi_type, structs, ctx), sview_to_cstr(payload_multi_bindings[packed_multi_index], packed_multi_storage))
                                            _ = LLVMBuildStore(builder, packed_multi_field, packed_multi_slot_ptr)
                                            declare_local(local_scope, payload_multi_bindings[packed_multi_index], packed_multi_slot_ptr, packed_multi_type)
                                if penum_scrutinee and payload_binding != "":
                                    payload_type: ValueType = penum_payload_of_path(payload_path, structs)
                                    if payload_type.kind == TypeKind.Unmodeled:
                                        declined <- true
                                        continue
                                    payload_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, llvm_type_of(scrutinee_type, structs, ctx), penum_slot, 1, "enum.payload.ptr")
                                    payload_value: LLVMValueRef = LLVMBuildLoad2(builder, llvm_type_of(payload_type, structs, ctx), payload_pointer, "match.payload")
                                    payload_name_storage: mutable darray[u8] = []
                                    payload_slot: LLVMValueRef = LLVMBuildAlloca(builder, llvm_type_of(payload_type, structs, ctx), sview_to_cstr(payload_binding, payload_name_storage))
                                    _ = LLVMBuildStore(builder, payload_value, payload_slot)
                                    declare_local(local_scope, payload_binding, payload_slot, payload_type)
                                # `Rect(w, h)` — load the field tuple from the payload blob and
                                # bind each field by extractvalue (stage0's `extractvalue {i64,i64}`).
                                if penum_scrutinee and payload_multi_bindings.count > 1:
                                    multi_arm_slot: i64 = penum_slot_of_path(payload_path, structs)
                                    if multi_arm_slot < 0:
                                        declined <- true
                                        continue
                                    multi_arm_tuple: LLVMTypeRef = penum_field_tuple_type(multi_arm_slot.usize(), structs, ctx)
                                    multi_arm_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, llvm_type_of(scrutinee_type, structs, ctx), penum_slot, 1, "enum.payload.ptr")
                                    multi_arm_value: LLVMValueRef = LLVMBuildLoad2(builder, multi_arm_tuple, multi_arm_pointer, "match.payload")
                                    multi_arm_start: usize = structs.penum_field_type_start[multi_arm_slot.usize()]
                                    for multi_bind_index in 0..<payload_multi_bindings.count |payload_multi_bindings, multi_arm_start, multi_arm_value, structs, local_scope, ctx, builder|:
                                        multi_bind_type: ValueType = copied_type(structs.penum_field_types[multi_arm_start + multi_bind_index])
                                        multi_bind_value: LLVMValueRef = LLVMBuildExtractValue(builder, multi_arm_value, multi_bind_index.u32(), "match.field")
                                        if payload_multi_bindings[multi_bind_index] != "":
                                            multi_bind_storage: mutable darray[u8] = []
                                            multi_bind_slot: LLVMValueRef = LLVMBuildAlloca(builder, llvm_type_of(multi_bind_type, structs, ctx), sview_to_cstr(payload_multi_bindings[multi_bind_index], multi_bind_storage))
                                            _ = LLVMBuildStore(builder, multi_bind_value, multi_bind_slot)
                                            declare_local(local_scope, payload_multi_bindings[multi_bind_index], multi_bind_slot, multi_bind_type)
                                if emit_expression(arm_expression, expected, local_scope, fns, structs, generics, runtime, m, ctx, builder) is variant_value:
                                    _ = LLVMBuildStore(builder, variant_value, result_slot)
                                    _ = LLVMBuildBr(builder, done_block)
                                else:
                                    declined <- true
                                LLVMPositionBuilderAtEnd(builder, next_block)
                                continue
                            if arm.pattern is Pattern.Literal(literal_text):
                                literal_value: mutable i64 = 0
                                if parse_pattern_scalar(literal_text, literal_value):
                                    next_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "match.next")
                                    # 32 = LLVMIntEQ (equality needs no signedness).
                                    hit: LLVMValueRef = LLVMBuildICmp(builder, 32, scrutinee, LLVMConstInt(llvm_type_of(scrutinee_type, structs, ctx), literal_value.u64(), 1), "match.cmp")
                                    _ = LLVMBuildCondBr(builder, hit, arm_block, next_block)
                                    LLVMPositionBuilderAtEnd(builder, arm_block)
                                    if arm_has_guard(arm.guard):
                                        if emit_condition(arm.guard, local_scope, fns, structs, generics, runtime, m, ctx, builder) is guard_bit:
                                            guarded_body: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "match.guard")
                                            _ = LLVMBuildCondBr(builder, guard_bit, guarded_body, next_block)
                                            LLVMPositionBuilderAtEnd(builder, guarded_body)
                                        else:
                                            declined <- true
                                            continue
                                    if emit_expression(arm_expression, expected, local_scope, fns, structs, generics, runtime, m, ctx, builder) is arm_value:
                                        _ = LLVMBuildStore(builder, arm_value, result_slot)
                                        _ = LLVMBuildBr(builder, done_block)
                                    else:
                                        declined <- true
                                    LLVMPositionBuilderAtEnd(builder, next_block)
                                else:
                                    declined <- true
                            elif arm.pattern is Pattern.Range(range_lo, range_hi, range_inclusive):
                                # `0..<5:` / `0..=127:` — a two-sided integer bound test.
                                next_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "match.next")
                                if emit_range_test(scrutinee, scrutinee_type, range_lo, range_hi, range_inclusive, llvm_type_of(scrutinee_type, structs, ctx), ctx, builder) is range_hit:
                                    _ = LLVMBuildCondBr(builder, range_hit, arm_block, next_block)
                                    LLVMPositionBuilderAtEnd(builder, arm_block)
                                    if arm_has_guard(arm.guard):
                                        if emit_condition(arm.guard, local_scope, fns, structs, generics, runtime, m, ctx, builder) is guard_bit:
                                            guarded_body: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "match.guard")
                                            _ = LLVMBuildCondBr(builder, guard_bit, guarded_body, next_block)
                                            LLVMPositionBuilderAtEnd(builder, guarded_body)
                                        else:
                                            declined <- true
                                            continue
                                    if emit_expression(arm_expression, expected, local_scope, fns, structs, generics, runtime, m, ctx, builder) is range_arm_value:
                                        _ = LLVMBuildStore(builder, range_arm_value, result_slot)
                                        _ = LLVMBuildBr(builder, done_block)
                                    else:
                                        declined <- true
                                    LLVMPositionBuilderAtEnd(builder, next_block)
                                else:
                                    declined <- true
                            elif arm.pattern is Pattern.Or(or_options):
                                # `0 | 2 | 4:` / `E.A | E.B:` — hit if ANY binding-free option hits.
                                next_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "match.next")
                                if emit_or_pattern_hit(or_options, scrutinee, scrutinee_type, penum_scrutinee, compare_type, structs, ctx, builder) is or_hit:
                                    _ = LLVMBuildCondBr(builder, or_hit, arm_block, next_block)
                                    LLVMPositionBuilderAtEnd(builder, arm_block)
                                    if arm_has_guard(arm.guard):
                                        if emit_condition(arm.guard, local_scope, fns, structs, generics, runtime, m, ctx, builder) is guard_bit:
                                            guarded_body: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "match.guard")
                                            _ = LLVMBuildCondBr(builder, guard_bit, guarded_body, next_block)
                                            LLVMPositionBuilderAtEnd(builder, guarded_body)
                                        else:
                                            declined <- true
                                            continue
                                    if emit_expression(arm_expression, expected, local_scope, fns, structs, generics, runtime, m, ctx, builder) is or_arm_value:
                                        _ = LLVMBuildStore(builder, or_arm_value, result_slot)
                                        _ = LLVMBuildBr(builder, done_block)
                                    else:
                                        declined <- true
                                    LLVMPositionBuilderAtEnd(builder, next_block)
                                else:
                                    declined <- true
                            else:
                                if is_catch_all_pattern(arm.pattern):
                                    _ = LLVMBuildBr(builder, arm_block)
                                    LLVMPositionBuilderAtEnd(builder, arm_block)
                                    if arm.pattern is Pattern.Binding(binding_name):
                                        binding_storage: mutable darray[u8] = []
                                        binding_slot: LLVMValueRef = LLVMBuildAlloca(builder, llvm_type_of(scrutinee_type, structs, ctx), sview_to_cstr(binding_name, binding_storage))
                                        _ = LLVMBuildStore(builder, scrutinee_raw, binding_slot)
                                        declare_local(local_scope, binding_name, binding_slot, scrutinee_type)
                                    if emit_expression(arm_expression, expected, local_scope, fns, structs, generics, runtime, m, ctx, builder) is default_value:
                                        _ = LLVMBuildStore(builder, default_value, result_slot)
                                        _ = LLVMBuildBr(builder, done_block)
                                        saw_default <- true
                                    else:
                                        declined <- true
                                else:
                                    declined <- true
                        else:
                            declined <- true

                    null return if declined
                    # Fell off the chain with no `_`: unreachable (the frontend proves
                    # exhaustiveness; inventing a value would hide a real gap).
                    terminate_if_no_default(saw_default, builder)
                    LLVMPositionBuilderAtEnd(builder, done_block)
                    return LLVMBuildLoad2(builder, match_type, result_slot, "match")
                return null

            # A value `if`: `a if cond else b`. Only ONE arm is evaluated, so it uses the
            # same result-slot lowering as `and`/`or`.
            if expression is Expr.If(ternary_condition, then_expression, else_expression, ternary_line):
                null return if expected.kind == TypeKind.Unmodeled
                # `if` is also used as a value-shaped mutation expression, for example
                # `parser <- parse_list() if bracketed else parse_one()`, where both arms
                # return void and mutate the lmut receiver. A void LLVM type cannot have an
                # alloca/result slot; emit the two side-effect arms directly and join them.
                if expected.kind == TypeKind.Void:
                    if emit_condition(ternary_condition, local_scope, fns, structs, generics, runtime, m, ctx, builder) is void_condition_bit:
                        void_function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                        void_then_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, void_function, "ifv.then")
                        void_else_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, void_function, "ifv.else")
                        void_done_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, void_function, "ifv.done")
                        _ = LLVMBuildCondBr(builder, void_condition_bit, void_then_block, void_else_block)
                        LLVMPositionBuilderAtEnd(builder, void_then_block)
                        if emit_expression(then_expression, expected, local_scope, fns, structs, generics, runtime, m, ctx, builder) is void_then_value:
                            _ = void_then_value
                            _ = LLVMBuildBr(builder, void_done_block)
                            LLVMPositionBuilderAtEnd(builder, void_else_block)
                            if emit_expression(else_expression, expected, local_scope, fns, structs, generics, runtime, m, ctx, builder) is void_else_value:
                                _ = void_else_value
                                _ = LLVMBuildBr(builder, void_done_block)
                                LLVMPositionBuilderAtEnd(builder, void_done_block)
                                # The caller only uses the presence of a value to recognize
                                # successful emission; this sentinel is never stored or returned.
                                return LLVMConstNull(LLVMPointerTypeInContext(ctx, 0))
                    return null
                ternary_type: LLVMTypeRef = llvm_type_of(expected, structs, ctx)
                result_slot: LLVMValueRef = LLVMBuildAlloca(builder, ternary_type, "if.result")
                if emit_condition(ternary_condition, local_scope, fns, structs, generics, runtime, m, ctx, builder) is condition_bit:
                    function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                    then_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "ifx.then")
                    else_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "ifx.else")
                    done_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "ifx.done")
                    _ = LLVMBuildCondBr(builder, condition_bit, then_block, else_block)

                    LLVMPositionBuilderAtEnd(builder, then_block)
                    if emit_expression(then_expression, expected, local_scope, fns, structs, generics, runtime, m, ctx, builder) is then_value:
                        _ = LLVMBuildStore(builder, then_value, result_slot)
                        _ = LLVMBuildBr(builder, done_block)
                        LLVMPositionBuilderAtEnd(builder, else_block)
                        # An `else` is mandatory in a value position; an Absent else
                        # declines (no value on one path).
                        if emit_expression(else_expression, expected, local_scope, fns, structs, generics, runtime, m, ctx, builder) is else_value:
                            _ = LLVMBuildStore(builder, else_value, result_slot)
                            _ = LLVMBuildBr(builder, done_block)
                            LLVMPositionBuilderAtEnd(builder, done_block)
                            return LLVMBuildLoad2(builder, ternary_type, result_slot, "ifx")
                return null
            # `[10, 30, 2]` — a fixed-array literal. Built in a temporary slot element by
            # element, then loaded back; SROA turns it into registers/constants at -O2.
            # The array is zero-initialized first, so a short literal deterministically
            # leaves omitted trailing elements at their zero value.
            # `{}` initializing a dict: the zero value of its DynDict struct (null items, 0
            # count/used/capacity, null arena) — stage0 emits `store %DynDict zeroinitializer`.
            # `{k: v, …}` — a zeroed DynDict in a slot, then `arena_dict_put_or_panic(arena, &m,
            # key, value)` per entry (the std's frictionless, panic-on-OOM insert; the analogue of
            # the non-empty set literal below). Needs the std + the DynDict K/V types from
            # `expected`'s instantiation args.
            if expression is Expr.DictLit(dict_entries, dict_literal_line):
                null return if expected.kind != TypeKind.Struct
                dict_lit_llvm: LLVMTypeRef = llvm_type_of(expected, structs, ctx)
                if dict_entries.count == 0:
                    return LLVMConstNull(dict_lit_llvm)
                dict_lit_base: mutable sview = ""
                dict_lit_arg_start: mutable usize = 0
                dict_lit_arg_count: mutable usize = 0
                dict_lit_has_inst: bool = generic_struct_instantiation_of(structs, expected, dict_lit_base, dict_lit_arg_start, dict_lit_arg_count)
                null return if not dict_lit_has_inst or dict_lit_base != "DynDict" or dict_lit_arg_count != 2
                dict_lit_key_type: ValueType = copied_type(structs.generic_struct_inst_args[dict_lit_arg_start])
                dict_lit_value_type: ValueType = copied_type(structs.generic_struct_inst_args[dict_lit_arg_start + 1.usize()])
                dict_lit_type_args: mutable darray[ValueType] = [dict_lit_key_type, dict_lit_value_type]
                if instantiate_generic("arena_dict_put_or_panic", dict_lit_type_args, generics, structs, m, ctx) is dict_put_target:
                    dict_lit_slot: LLVMValueRef = LLVMBuildAlloca(builder, dict_lit_llvm, "dict.literal")
                    _ = LLVMBuildStore(builder, LLVMConstNull(dict_lit_llvm), dict_lit_slot)
                    dict_put_fn_type: LLVMTypeRef = LLVMGlobalGetValueType(dict_put_target)
                    dict_lit_declined: mutable bool = false
                    for dict_entry in dict_entries |dict_lit_declined, dict_lit_key_type, dict_lit_value_type, dict_lit_slot, dict_put_target, dict_put_fn_type, local_scope, fns, structs, generics, runtime, m, ctx, builder|:
                        continue if dict_lit_declined
                        if emit_expression(dict_entry.key, dict_lit_key_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is dict_entry_key_value:
                            if emit_expression(dict_entry.value, dict_lit_value_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is dict_entry_value_value:
                                dict_put_args: mutable darray[LLVMValueRef] = [runtime.arena, dict_lit_slot, dict_entry_key_value, dict_entry_value_value]
                                dict_put_args_pointer: void& = (&dict_put_args[0]).cast[void&] can Unsafe.PointerCast
                                _ = LLVMBuildCall2(builder, dict_put_fn_type, dict_put_target, dict_put_args_pointer, 4, "dict.put")
                            else:
                                dict_lit_declined <- true
                        else:
                            dict_lit_declined <- true
                    null return if dict_lit_declined
                    return LLVMBuildLoad2(builder, dict_lit_llvm, dict_lit_slot, "dict.literal.value")
                return null
            # `{}` may also parse as an empty set literal; same zero-aggregate handling.
            if expression is Expr.SetLit(set_elements, set_literal_line):
                null return if expected.kind != TypeKind.Struct
                set_lit_llvm: LLVMTypeRef = llvm_type_of(expected, structs, ctx)
                # An empty set `{}` is a zeroed DynSet (null items, 0 counts) — no allocation.
                if set_elements.count == 0:
                    return LLVMConstNull(set_lit_llvm)
                # `{a, b, …}` — a zeroed DynSet in a slot, then `arena_set_add_or_panic(arena,
                # &set, elem)` per element (the std's frictionless, panic-on-OOM insert; the
                # error-returning `arena_set_add` is avoided so no error out-param is needed).
                # Needs the std + the DynSet element type from `expected`'s instantiation args.
                set_lit_base: mutable sview = ""
                set_lit_arg_start: mutable usize = 0
                set_lit_arg_count: mutable usize = 0
                set_lit_has_inst: bool = generic_struct_instantiation_of(structs, expected, set_lit_base, set_lit_arg_start, set_lit_arg_count)
                null return if not set_lit_has_inst or set_lit_base != "DynSet" or set_lit_arg_count != 1
                set_lit_elem_type: ValueType = copied_type(structs.generic_struct_inst_args[set_lit_arg_start])
                set_lit_type_args: mutable darray[ValueType] = [set_lit_elem_type]
                if instantiate_generic("arena_set_add_or_panic", set_lit_type_args, generics, structs, m, ctx) is set_add_target:
                    set_lit_slot: LLVMValueRef = LLVMBuildAlloca(builder, set_lit_llvm, "set.literal")
                    _ = LLVMBuildStore(builder, LLVMConstNull(set_lit_llvm), set_lit_slot)
                    set_add_fn_type: LLVMTypeRef = LLVMGlobalGetValueType(set_add_target)
                    set_lit_declined: mutable bool = false
                    for set_element in set_elements |set_lit_declined, set_lit_elem_type, set_lit_slot, set_add_target, set_add_fn_type, local_scope, fns, structs, generics, runtime, m, ctx, builder|:
                        continue if set_lit_declined
                        if emit_expression(set_element, set_lit_elem_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is set_element_value:
                            set_add_args: mutable darray[LLVMValueRef] = [runtime.arena, set_lit_slot, set_element_value]
                            set_add_args_pointer: void& = (&set_add_args[0]).cast[void&] can Unsafe.PointerCast
                            _ = LLVMBuildCall2(builder, set_add_fn_type, set_add_target, set_add_args_pointer, 3, "set.add")
                        else:
                            set_lit_declined <- true
                    null return if set_lit_declined
                    return LLVMBuildLoad2(builder, set_lit_llvm, set_lit_slot, "set.literal.value")
                return null
            if expression is Expr.Array(array_elements, array_literal_line):
                # Darray literals use the same allocation/growth path as `.push(...)`.
                if expected.kind == TypeKind.DArray:
                    if array_elements.count == 0:
                        return LLVMConstNull(darray_llvm_type(structs, ctx))
                    element_type: ValueType = darray_element_of(expected, structs)
                    null return if element_type.kind == TypeKind.Unmodeled
                    header: LLVMTypeRef = darray_llvm_type(structs, ctx)
                    temporary: LLVMValueRef = LLVMBuildAlloca(builder, header, "darray.literal")
                    _ = LLVMBuildStore(builder, LLVMConstNull(header), temporary)
                    declined: mutable bool = false
                    for element_expression in array_elements |declined, temporary, expected, local_scope, fns, structs, generics, runtime, m, ctx, builder|:
                        if emit_darray_push(temporary, expected, element_expression, local_scope, fns, structs, generics, runtime, m, ctx, builder):
                            declined <- declined
                        else:
                            declined <- true
                    null return if declined
                    return LLVMBuildLoad2(builder, header, temporary, "darray.literal.value")
                null return if expected.kind != TypeKind.Array
                slot_index: usize = expected.bits.usize()
                null return if array_elements.count > structs.array_extents[slot_index].usize()
                element_type: ValueType = structs.array_elements[slot_index]
                array_llvm: LLVMTypeRef = llvm_type_of(expected, structs, ctx)
                temporary: LLVMValueRef = LLVMBuildAlloca(builder, array_llvm, "array")
                _ = LLVMBuildStore(builder, LLVMConstNull(array_llvm), temporary)
                declined: mutable bool = false
                position: mutable u32 = 0
                for element_expression in array_elements |declined, position, element_type, array_llvm, temporary, local_scope, fns, structs, generics, runtime, m, ctx, builder|:
                    indices: mutable darray[LLVMValueRef] = [LLVMConstInt(LLVMInt64TypeInContext(ctx), 0, 0), LLVMConstInt(LLVMInt64TypeInContext(ctx), position.u64(), 0)]
                    indices_pointer: void& = (&indices[0]).cast[void&] can Unsafe.PointerCast
                    pointer: LLVMValueRef = LLVMBuildGEP2(builder, array_llvm, temporary, indices_pointer, 2, "init.ptr")
                    if emit_expression(element_expression, element_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is element_value:
                        _ = LLVMBuildStore(builder, element_value, pointer)
                    else:
                        declined <- true
                    position <- position + 1
                null return if declined
                return LLVMBuildLoad2(builder, array_llvm, temporary, "arrayval")

            # Named-tuple VALUE `(a, b, …)` — construct positionally into the EXPECTED tuple
            # struct (a synthesized anonymous struct; register_tuple_types resolved its type).
            if expression is Expr.Tuple(tuple_value_elements, tuple_value_line):
                null return if expected.kind != TypeKind.Struct
                tuple_value_slot: usize = expected.bits.usize()
                null return if structs.field_count[tuple_value_slot] != tuple_value_elements.count
                tuple_value_llvm: LLVMTypeRef = llvm_type_of(expected, structs, ctx)
                tuple_value_temporary: LLVMValueRef = LLVMBuildAlloca(builder, tuple_value_llvm, "tuple")
                tuple_value_field_start: usize = structs.field_start[tuple_value_slot]
                tuple_value_declined: mutable bool = false
                tuple_value_position: mutable u32 = 0
                for tuple_value_element in tuple_value_elements |tuple_value_declined, tuple_value_position, tuple_value_field_start, tuple_value_llvm, tuple_value_temporary, local_scope, fns, structs, generics, runtime, m, ctx, builder|:
                    tuple_value_field_type: ValueType = copied_type(structs.field_types[tuple_value_field_start + tuple_value_position.usize()])
                    tuple_value_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, tuple_value_llvm, tuple_value_temporary, tuple_value_position, "tuple.field.ptr")
                    if emit_expression(tuple_value_element, tuple_value_field_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is tuple_value_field:
                        _ = LLVMBuildStore(builder, tuple_value_field, tuple_value_pointer)
                    else:
                        tuple_value_declined <- true
                    tuple_value_position <- tuple_value_position + 1
                null return if tuple_value_declined
                return LLVMBuildLoad2(builder, tuple_value_llvm, tuple_value_temporary, "tupleval")

            # `x.cast[T]` — a REINTERPRET cast (parsed as Index(Field(x,"cast"), T), no call).
            # Only pointer<->pointer is modeled (a ref/cstr/void& is a `ptr`, and opaque
            # pointers make it a no-op) — that is all the std alloc helpers need
            # (`ptr.cast[mutable T&]`). A non-pointer reinterpret declines.
            if expression is Expr.Index(cast_index_head, cast_index_type, cast_index_line):
                if cast_index_head is Expr.Field(cast_source, cast_method, cast_method_line):
                    if cast_method == "cast":
                        cast_target: ValueType = annotation_value_type(cast_index_type, structs)
                        null return if cast_target.kind == TypeKind.Unmodeled
                        # `ptr.cast[uintptr]` — a POINTER→INTEGER reinterpret (the inverse of the
                        # `int.cast[T&]` case below). A `uintptr`/`usize` stash of a raw address, as
                        # in Slice[T]'s `(&da[0]).cast[uintptr]`; this is a `ptrtoint` to the target
                        # integer width. Handled first so integer targets do not fall to the
                        # pointer-only decline just below.
                        if is_integer_type(cast_target):
                            cast_int_source_type: ValueType = expression_type(cast_source, local_scope, fns, structs, generics)
                            null return if not type_is_pointer(cast_int_source_type)
                            if emit_expression(cast_source, cast_int_source_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is cast_ptr_value:
                                return LLVMBuildPtrToInt(builder, cast_ptr_value, llvm_type_of(cast_target, structs, ctx), "ptrtoint")
                            return null
                        # `raw.cast[GuestVAddr[L]]` / `HostPtr[T]` — address-space carriers are
                        # i64 storage; a cast from uintptr is a pure integer bit-cast (identity
                        # at the LLVM level), matching stage0's GuestVAddr local-carrier lowering.
                        if cast_target.kind == TypeKind.GuestCarrier:
                            cast_guest_source_type: ValueType = expression_type(cast_source, local_scope, fns, structs, generics)
                            null return if not is_integer_type(cast_guest_source_type) and cast_guest_source_type.kind != TypeKind.GuestCarrier
                            if emit_expression(cast_source, cast_guest_source_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is cast_guest_value:
                                return cast_guest_value
                            return null
                        # `ptr.cast[T&?]` — an OPTIONAL-of-pointer target. Produce the bare
                        # pointer, then wrap: wrap_optional already derives a heap ref's tag
                        # from a null test, so a null source stays ABSENT rather than being
                        # handed back as a present-but-null reference.
                        cast_wraps_optional: bool = cast_target.kind == TypeKind.Optional and type_is_pointer(optional_payload_of(cast_target, structs))
                        null return if not type_is_pointer(cast_target) and not cast_wraps_optional
                        cast_source_type: ValueType = expression_type(cast_source, local_scope, fns, structs, generics)
                        # An INTEGER source (`raw: uintptr` -> `mutable heap Region&`) is a
                        # real reinterpret and needs an `inttoptr`; pointer<->pointer is free
                        # under opaque pointers. Anything else is not a reinterpret at all.
                        cast_source_is_int: bool = is_integer_type(cast_source_type)
                        null return if not type_is_pointer(cast_source_type) and not cast_source_is_int
                        if emit_expression(cast_source, cast_source_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is cast_source_value:
                            cast_pointer: mutable LLVMValueRef = cast_source_value
                            if cast_source_is_int:
