                        return LLVMBuildLoad2(builder, llvm_type_of(extern_global_type, structs, ctx), structs.extern_global_handles[extern_global_index.usize()], "extern.global")
                    mutable_global_index: i64 = mutable_global_index_of(structs, ident_name)
                    if mutable_global_index >= 0:
                        mutable_global_type: ValueType = copied_type(structs.mutable_global_types[mutable_global_index.usize()])
                        return LLVMBuildLoad2(builder, llvm_type_of(mutable_global_type, structs, ctx), structs.mutable_global_handles[mutable_global_index.usize()], "global")
                    const_index: i64 = const_index_of(structs, ident_name)
