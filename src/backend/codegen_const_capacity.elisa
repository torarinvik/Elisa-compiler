# Stage1 backend — CONSTANT CAPACITY EXPRESSIONS: parse and fold the source text used in
# `region`, `pool`, and `with` headers. These headers retain their capacity as a source span
# rather than an Expr node, so this small parser reconstructs the integer expression and
# delegates evaluation to Backend.fold_const_expr.

extend Backend:
    private:

        def capacity_span_skip_spaces(text: sview, cursor: mutable usize&) -> void can[Abort.Panic]:
            while cursor < sview_len(text) and (sview_at(text, cursor) == 32 or sview_at(text, cursor) == 9) |cursor, text|:
                cursor <- cursor + 1


        def capacity_span_ident_start(byte: u8) -> bool can[Abort.Panic]:
            return (byte >= 65 and byte <= 90) or (byte >= 97 and byte <= 122) or byte == 95


        def capacity_span_ident_byte(byte: u8) -> bool can[Abort.Panic]:
            return capacity_span_ident_start(byte) or (byte >= 48 and byte <= 57)


        # Precedence mirrors parser_expr_binary. TokenKind.Eof is the sentinel for
        # "there is no binary operator at this cursor" and is never emitted into the AST.
        def capacity_span_operator(text: sview, cursor: usize) -> (operator: TokenKind, width: usize, precedence: i32) can[Abort.Panic]:
            length: usize = sview_len(text)
            (TokenKind.Eof, 0, -1.i32()) return if cursor >= length
            if cursor + 1.usize() < length:
                first: u8 = sview_at(text, cursor)
                second: u8 = sview_at(text, cursor + 1.usize())
                (TokenKind.LShift, 2, 4.i32()) return if first == 60 and second == 60
                (TokenKind.RShift, 2, 4.i32()) return if first == 62 and second == 62
                (TokenKind.EqEq, 2, 0.i32()) return if first == 61 and second == 61
                (TokenKind.BangEq, 2, 0.i32()) return if first == 33 and second == 61
                (TokenKind.LtEq, 2, 0.i32()) return if first == 60 and second == 61
                (TokenKind.GtEq, 2, 0.i32()) return if first == 62 and second == 61
            return match sview_at(text, cursor):
                60: (TokenKind.Lt, 1, 0.i32())
                62: (TokenKind.Gt, 1, 0.i32())
                124: (TokenKind.Pipe, 1, 1.i32())
                94: (TokenKind.Caret, 1, 2.i32())
                38: (TokenKind.Ampersand, 1, 3.i32())
                43: (TokenKind.Plus, 1, 5.i32())
                45: (TokenKind.Minus, 1, 5.i32())
                42: (TokenKind.Star, 1, 6.i32())
                47: (TokenKind.Slash, 1, 6.i32())
                37: (TokenKind.Percent, 1, 6.i32())
                _: (TokenKind.Eof, 0, -1.i32())


        def capacity_span_parse_primary(text: sview, cursor: mutable usize) -> (known: bool, expression: Expr, cursor: usize) can[Abort.Panic, Memory.Allocate]:
            capacity_span_skip_spaces(text, cursor)
            invalid: Expr = Expr.Invalid
            (false, invalid, cursor) return if cursor >= sview_len(text)
            if sview_at(text, cursor) == 40:
                cursor <- cursor + 1
                inner: (known: bool, expression: Expr, cursor: usize) = capacity_span_parse_binary(text, cursor, 0)
                cursor <- inner.cursor
                (false, invalid, cursor) return if not inner.known
                capacity_span_skip_spaces(text, cursor)
                (false, invalid, cursor) return if cursor >= sview_len(text) or sview_at(text, cursor) != 41
                cursor <- cursor + 1
                return (true, Expr.Paren(inner.expression, Ast::pos_at_line(0)), cursor)
            if sview_at(text, cursor) >= 48 and sview_at(text, cursor) <= 57:
                start: usize = cursor
                while cursor < sview_len(text) and sview_at(text, cursor) >= 48 and sview_at(text, cursor) <= 57 |cursor, text|:
                    cursor <- cursor + 1
                literal_end: usize = cursor
                literal: sview = text[start:literal_end]
                value: mutable i64 = 0
                (false, invalid, cursor) return if not parse_int_literal(literal, value)
                return (true, Expr.IntLit(value, Ast::pos_at_line(0)), cursor)
            (false, invalid, cursor) return if not capacity_span_ident_start(sview_at(text, cursor))
            ident_start: usize = cursor
            while cursor < sview_len(text) and capacity_span_ident_byte(sview_at(text, cursor)) |cursor, text|:
                cursor <- cursor + 1
            ident_end: usize = cursor
            expression: mutable Expr = Expr.Ident(text[ident_start:ident_end], Ast::pos_at_line(0))
            # Qualified constants (`Module::CAP` and `Outer::Inner::CAP`) use the same
            # Scope shape as the real parser rather than falling back to a bare-name lookup.
            while true |cursor, text, expression|:
                capacity_span_skip_spaces(text, cursor)
                break if cursor + 1.usize() >= sview_len(text) or sview_at(text, cursor) != 58 or sview_at(text, cursor + 1.usize()) != 58
                cursor <- cursor + 2
                capacity_span_skip_spaces(text, cursor)
                (false, invalid, cursor) return if cursor >= sview_len(text) or not capacity_span_ident_start(sview_at(text, cursor))
                qualified_start: usize = cursor
                while cursor < sview_len(text) and capacity_span_ident_byte(sview_at(text, cursor)) |cursor, text|:
                    cursor <- cursor + 1
                qualified_end: usize = cursor
                expression <- Expr.Scope(expression, text[qualified_start:qualified_end], Ast::pos_at_line(0))
            return (true, expression, cursor)


        def capacity_span_parse_unary(text: sview, cursor: mutable usize) -> (known: bool, expression: Expr, cursor: usize) can[Abort.Panic, Memory.Allocate]:
            capacity_span_skip_spaces(text, cursor)
            invalid: Expr = Expr.Invalid
            (false, invalid, cursor) return if cursor >= sview_len(text)
            operator: mutable TokenKind = TokenKind.Eof
            if sview_at(text, cursor) == 43:
                operator <- TokenKind.Plus
            elif sview_at(text, cursor) == 45:
                operator <- TokenKind.Minus
            elif sview_at(text, cursor) == 126:
                operator <- TokenKind.Tilde
            else:
                return capacity_span_parse_primary(text, cursor)
            cursor <- cursor + 1
            operand: (known: bool, expression: Expr, cursor: usize) = capacity_span_parse_unary(text, cursor)
            cursor <- operand.cursor
            (false, invalid, cursor) return if not operand.known
            return (true, Expr.Unary(operator, operand.expression, Ast::pos_at_line(0)), cursor)


        def capacity_span_parse_binary(text: sview, cursor: mutable usize, minimum_precedence: i32) -> (known: bool, expression: Expr, cursor: usize) can[Abort.Panic, Memory.Allocate]:
            invalid: Expr = Expr.Invalid
            left: mutable (known: bool, expression: Expr, cursor: usize) = capacity_span_parse_unary(text, cursor)
            cursor <- left.cursor
            (false, invalid, cursor) return if not left.known
            while true |cursor, text, minimum_precedence, left|:
                capacity_span_skip_spaces(text, cursor)
                operation: (operator: TokenKind, width: usize, precedence: i32) = capacity_span_operator(text, cursor)
                break if operation.precedence < minimum_precedence
                cursor <- cursor + operation.width
                right: (known: bool, expression: Expr, cursor: usize) = capacity_span_parse_binary(text, cursor, operation.precedence + 1)
                cursor <- right.cursor
                (false, invalid, cursor) return if not right.known
                left <- (true, Expr.Binary(left.expression, operation.operator, right.expression, Ast::pos_at_line(0)), right.cursor)
            return (left.known, left.expression, cursor)


        def fold_const_capacity_text(text: sview, structs: mutable StructTable&, out_value: mutable i64&) -> bool can[Abort.Panic, Memory.Allocate]:
            false return if sview_len(text) == 0
            cursor: mutable usize = 0
            parsed: (known: bool, expression: Expr, cursor: usize) = capacity_span_parse_binary(text, cursor, 0)
            cursor <- parsed.cursor
            false return if not parsed.known
            capacity_span_skip_spaces(text, cursor)
            false return if cursor != sview_len(text)
            folded_ok: mutable bool = true
            folded: i64 = fold_const_expr(parsed.expression, structs, folded_ok)
            false return if not folded_ok
            out_value <- folded
            return true
