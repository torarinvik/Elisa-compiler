# Typed static-effect lowering. This is invoked with the same type bindings as
# ordinary generic annotation resolution. No candidate data is emitted to LLVM.
extend Backend:
    private:
        def static_effect_type_matches(requested: Expr, installed: Expr, structs: mutable StructTable&) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            return false if not Ast::effect_path_equal(Ast::effect_application_head(requested), Ast::effect_application_head(installed))
            requested_arguments: darray[Expr] = Ast::effect_application_arguments(requested)
            installed_arguments: darray[Expr] = Ast::effect_application_arguments(installed)
            return false if requested_arguments.count != installed_arguments.count
            for index in 0..<requested_arguments.count |structs|:
                requested_type: ValueType = annotation_value_type(requested_arguments[index], structs)
                installed_type: ValueType = annotation_value_type(installed_arguments[index], structs)
                return false if requested_type.kind == TypeKind.Unmodeled or installed_type.kind == TypeKind.Unmodeled
                return false if not value_type_identity_equal(requested_type, installed_type)
            return true

        def lower_static_effect_call(expression: Expr, structs: mutable StructTable&) -> Expr? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            if expression is Expr.StaticEffectCall(requested, operation, candidates, arguments, argument_names, position):
                for candidate in candidates |structs|:
                    continue if not static_effect_type_matches(requested, candidate.effect_type, structs)
                    direct_arguments: mutable darray[Expr] = []
                    direct_names: mutable darray[sview] = []
                    for capture in candidate.captures |direct_arguments, direct_names|:
                        direct_arguments.push(capture)
                        direct_names.push("")
                    for index in 0..<arguments.count |direct_arguments, direct_names|:
                        direct_arguments.push(arguments[index])
                        direct_names.push(argument_names[index] if index < argument_names.count else "")
                    candidate_callee: mutable Expr = Expr.Ident(candidate.callee, Ast::pos_at_line(0))
                    if candidate.callee_owner != "":
                        candidate_callee <- Expr.Scope(Expr.Ident(candidate.callee_owner, Ast::pos_at_line(0)), candidate.callee, Ast::pos_at_line(0))
                    return Expr.Call(candidate_callee, direct_arguments, direct_names, position)
            return null
