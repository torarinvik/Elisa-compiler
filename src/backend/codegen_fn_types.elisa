# Stage1 backend — first-class FUNCTION types: interning a `fn(A) -> R` (and its `error[E]`
# sibling) into the side pools, and reading the return type and error family back out.
# Part of `module Backend` (see codegen.elisa).

extend Backend:
    private:
        # Function ValueType.bits stores a return-pool slot as u32. Keep the
        # candidate slot representable before appending the corresponding row;
        # otherwise the final `.u32()` cast could alias an earlier signature.
        const MAX_FN_TYPE_SLOT: usize = 4294967295

        # A Fn ValueType carrying `return_type` + `param_types` in the parallel side-pools at
        # `bits` (fn_pool_returns and the fn_pool_param_* span are index-parallel).
        def intern_fn_type(return_type: ValueType, param_types: darray[ValueType]&, structs: mutable StructTable&) -> ValueType can[Abort.Panic, Memory.Allocate]:
            unmodeled_type() return if structs.function_types.fn_pool_returns.count > MAX_FN_TYPE_SLOT
            structs.function_types.fn_pool_returns.push(return_type)
            structs.function_types.fn_pool_errors.push(false)
            structs.function_types.fn_pool_error_families.push("")
            structs.function_types.fn_pool_param_start.push(structs.function_types.fn_pool_params.count)
            structs.function_types.fn_pool_param_count.push(param_types.count)
            for param_type in param_types |structs|:
                structs.function_types.fn_pool_params.push(copied_type(param_type))
            return ValueType{kind: TypeKind.Fn, bits: (structs.function_types.fn_pool_returns.count - 1).u32()}



        # Function types with `error[...]` returns use the same first-class function-value
        # representation as ordinary functions, but their callable ABI has a leading payload
        # out-pointer and returns an i32 status. Keep the family in a parallel pool so a generic
        # `fn() -> T error[R]` can resolve R after its enclosing template is specialized.
        def intern_error_fn_type(return_type: ValueType, family: sview @source, param_types: darray[ValueType]&, structs: mutable StructTable&) -> ValueType can[Abort.Panic, Memory.Allocate]:
            unmodeled_type() return if structs.function_types.fn_pool_returns.count > MAX_FN_TYPE_SLOT
            structs.function_types.fn_pool_returns.push(return_type)
            structs.function_types.fn_pool_errors.push(true)
            structs.function_types.fn_pool_error_families.push(family)
            structs.function_types.fn_pool_param_start.push(structs.function_types.fn_pool_params.count)
            structs.function_types.fn_pool_param_count.push(param_types.count)
            for param_type in param_types |structs|:
                structs.function_types.fn_pool_params.push(copied_type(param_type))
            return ValueType{kind: TypeKind.Fn, bits: (structs.function_types.fn_pool_returns.count - 1).u32()}



        def fn_error_family_at_offset(offset: u32, line: u32, structs: StructTable&) -> sview can[Abort.Panic]:
            paired: mutable usize = structs.function_types.fn_error_lines.count if structs.function_types.fn_error_lines.count < structs.function_types.fn_error_families.count else structs.function_types.fn_error_families.count
            paired <- structs.function_types.fn_error_offsets.count if structs.function_types.fn_error_offsets.count < paired
            found: mutable sview = ""
            for index in 0..<paired |found, offset, line, structs|:
                continue if structs.function_types.fn_error_lines[index] != line or structs.function_types.fn_error_offsets[index] != offset
                return "" if found != "" and found != structs.function_types.fn_error_families[index]
                found <- structs.function_types.fn_error_families[index]
            return found



        # The RETURN type a Fn value produces when called, or Unmodeled if unknown.
        def fn_return_type_of(fn_type: ValueType, structs: mutable StructTable&) -> ValueType can[Abort.Panic]:
            return unmodeled_type() if:
                fn_type.kind != TypeKind.Fn
                fn_type.bits.usize() >= structs.function_types.fn_pool_returns.count
            return copied_type(structs.function_types.fn_pool_returns[fn_type.bits.usize()])
