# Stage1 backend — the INDEXED annotation forms `T[N]`, `Store[T]` and `(A, B)`: a fixed array,
# a packed store handle, a named application and a tuple all spell as an index, so each has to
# be told apart before it can name a ValueType.
# Part of `module Backend` (see codegen.elisa).

extend Backend:
    private:


        def annotation_index_store_value_type(array_head: Expr, structs: mutable StructTable&) -> ValueType can[Abort.Panic]:
            can Abort.Panic:
                # The head is the HIERARCHY, and it may be named through its module:
                # `Ast::Node.Store[Local]` as readily as `Node.Store[Local]`. Matching only
                # a bare Ident here left the qualified spelling unmodeled, which declined the
                # whole variable declaration and, with it, every function that called the one
                # holding it. packed_constructor_enum_name answers both forms -- packed rows
                # are keyed by the bare name, so the qualifier is a namespace here.
                match array_head:
                    Expr.Field(store_enum_expr, store_member, store_member_line):
                        if store_member == "Store":
                            store_enum_name: sview = packed_constructor_enum_name(store_enum_expr)
                            if store_enum_name != "":
                                store_index: i64 = packed_index_of(structs, store_enum_name)
                                ValueType{kind: TypeKind.PackedStore, bits: store_index.u32()} return if store_index >= 0
                    _:
                        pass
                return unmodeled_type()




        def annotation_index_fixed_value_type(array_head: Expr, array_extent: Expr, structs: mutable StructTable&) -> ValueType can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                # The extent folds through the const table, so `heap Entry&?[NB]` resolves and
                # not just `[4]`. This path takes every annotation whose HEAD is not a bare
                # name — a qualified element type like `heap T&?` — which is exactly how the
                # runtime's two string caches are declared. Folding only on the named path left
                # them Unmodeled and still dropping their readers.
                extent_ok: mutable bool = true
                extent_value: i64 = fold_const_expr(array_extent, structs, extent_ok)
                if extent_ok:
                    element: ValueType = annotation_value_type(array_head, structs)
                    unmodeled_type() return if element.kind == TypeKind.Unmodeled
                    unmodeled_type() return if extent_value <= 0
                    return intern_array_type(element, extent_value.u32(), structs)
                return unmodeled_type()




        def annotation_index_named_value_type(array_head: Expr, container_name: sview, array_extent: Expr, structs: mutable StructTable&) -> ValueType can[Abort.Panic, Memory.Allocate]:
            # An enum-named array (`MyEnum[N]`) is an array of the enum's BACKING. The
            # extent folds through the const table so `MyEnum[CAP]` keeps that lowering
            # instead of falling through to the generic array tail below, which would
            # give an array of the enum type itself.
            enum_extent_ok: mutable bool = true
            enum_array_extent: i64 = fold_const_expr(array_extent, structs, enum_extent_ok)
            if enum_extent_ok:
                enum_array_slot: i64 = enum_index_of(structs, container_name)
                if enum_array_slot >= 0:
                    enum_array_backing: ValueType = copied_type(structs.enum_backings[enum_array_slot.usize()])
                    intern_array_type(enum_array_backing, enum_array_extent.u32(), structs) return if enum_array_extent > 0
            if container_name == "GuestVAddr" or container_name == "HostPtr" or container_name == "NativeMappedGuestPtr":
                match array_extent:
                    Expr.Ident(carrier_layout, carrier_layout_line):
                        return intern_guest_carrier(carrier_layout, structs)
                    _:
                        pass
                return unmodeled_type()
            # `cstr[shape_left]` — same erasure: a shaped cstr IS a cstr (stage0 gives a
            # bare `ptr`).
            ValueType{kind: TypeKind.CStr, bits: 0} return if container_name == "cstr"
            # `NodeKey[Expr]` — a DENSE key into a frozen packed store. stage0 gives it a
            # one-field struct (`%NodeKey__Expr = type { i32 }`) holding the node handle;
            # stage1 erases it to that field, since the key is only ever consumed by
            # `table[key]` and `frozen[key]` and never crosses a compiler boundary.
            ValueType{kind: TypeKind.Signed, bits: 32} return if container_name == "NodeKey"
            if container_name == "darray":
                darray_element: mutable ValueType = annotation_value_type(array_extent, structs)
                match array_extent:
                    Expr.Ident(darray_opaque_name, darray_opaque_line):
                        # bits 1: the opaque-handle MARKER (see llvm_opaque_handle_name's use in
                        # codegen_env) -- handle equality is pointer identity, not ctx_streq.
                        darray_element <- ValueType{kind: TypeKind.CStr, bits: 1} if llvm_opaque_handle_name(darray_opaque_name)
                    _:
                        pass
                unmodeled_type() return if darray_element.kind == TypeKind.Unmodeled
                return intern_darray_type(darray_element, structs)
            if container_name == "view":
                view_element: ValueType = annotation_value_type(array_extent, structs)
                unmodeled_type() return if view_element.kind == TypeKind.Unmodeled
                return intern_view_type(view_element, structs)
            match array_extent:
                Expr.IntLit(extent_value):
                    element: ValueType = annotation_value_type(array_head, structs)
                    unmodeled_type() return if element.kind == TypeKind.Unmodeled
                    unmodeled_type() return if extent_value <= 0
                    return intern_array_type(element, extent_value.u32(), structs)
                _:
                    pass
            # `RowId[S]` — a `layout(soa)` ROW HANDLE. stage0 represents it as a plain i32
            # (`%row = alloca i32`), the row index narrowed from the column count.
            ValueType{kind: TypeKind.Signed, bits: 32} return if container_name == "RowId"
            # `id[T]` — a TYPED HANDLE, represented by stage0 as a plain u32 (verified:
            # `def to_index(x: MyId)` lowers to `define i64 @to_index(i32 %0)`). The
            # referent only exists for type-checking, so the backend erases it.
            ValueType{kind: TypeKind.Unsigned, bits: 32} return if container_name == "id"
            mapped_generic_base: sview = "DynSet" if container_name == "set" else container_name
            if generic_struct_index_of(structs, mapped_generic_base) >= 0:
                single_argument: ValueType = annotation_value_type(array_extent, structs)
                single_argument_list: mutable darray[ValueType] = [single_argument]
                return instantiate_generic_struct(mapped_generic_base, single_argument_list, structs)
            # No DynSet TEMPLATE in this unit, because there is none to declare: stage0's set
            # layout is a backend builtin. Register it directly (synthesize_set_struct). The
            # template branch above still wins when a unit does declare its own — which is
            # what set_real_smoke.sh prepends.
            # The proof-carrying view helpers' result types.
            synthesize_mutex_guard(annotation_value_type(array_extent, structs), structs) return if container_name == "MutexGuard"
            synthesize_split_view(annotation_value_type(array_extent, structs), structs) return if container_name == "SplitView"
            synthesize_chunks_exact_view(annotation_value_type(array_extent, structs), structs) return if container_name == "ChunksExactView"
            synthesize_set_struct(annotation_value_type(array_extent, structs), structs) return if container_name == "set"
            synthesize_set_bucket(annotation_value_type(array_extent, structs), structs) return if container_name == "SetBucket"
            # `i64[CAP]` — a fixed array whose EXTENT is a named const rather than a
            # literal. stage0 folds the extent through its const table; stage1 accepted
            # only Expr.IntLit, so the whole annotation stayed Unmodeled, the global was
            # never registered, and EVERY read and write of it declined. That is how the
            # runtime's five array globals (the trace tapes and the two string caches,
            # all written `T[SOME_CAP]`) silently dropped ~20 functions.
            #
            # Checked LAST so nothing that resolves today changes: a generic
            # instantiation (`Box[T]`) still wins, and an extent that does not fold to a
            # positive integer stays declined rather than guessed.
            # `Holder[&]` — a TYPESTATE qualifier on a plain (non-generic) struct. States are a
            # type-level refinement with no representation: stage0 passes the struct BY VALUE
            # and GEPs the field, identical to the unqualified spelling
            # (`define i32 @read(%Holder %0)`). Checked after every container and generic
            # spelling above, so it can only claim a bracket nothing else understands.
            if struct_declares_aggregate_state(structs, container_name):
                state_struct_index: i64 = struct_index_of(structs, container_name)
                ValueType{kind: TypeKind.Struct, bits: state_struct_index.u32()} return if state_struct_index >= 0
            extent_ok: mutable bool = true
            folded_extent: i64 = fold_const_expr(array_extent, structs, extent_ok)
            if extent_ok and folded_extent > 0:
                folded_element: ValueType = annotation_value_type(array_head, structs)
                unmodeled_type() return if folded_element.kind == TypeKind.Unmodeled
                return intern_array_type(folded_element, folded_extent.u32(), structs)
            return unmodeled_type()




        def annotation_index_value_type(array_head: Expr, array_extent: Expr, structs: mutable StructTable&) -> ValueType can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                return match array_head:
                    Expr.Field(_, _, _): annotation_index_store_value_type(array_head, structs)
                    Expr.Ident(container_name, container_line): annotation_index_named_value_type(array_head, container_name, array_extent, structs)
                    _: annotation_index_fixed_value_type(array_head, array_extent, structs)




        def annotation_tuple_value_type(tuple_type_elements: darray[Expr], tuple_type_line: i64, structs: mutable StructTable&) -> ValueType can[Abort.Panic, Memory.Allocate]:
            unmodeled_type() return if tuple_type_elements.count == 0
            # Labels are keyed by LINE, so TWO tuple types on one line return both label sets
            # concatenated — `def f(a: (k: i64, b: sview)) -> (ok: bool, n: i64)` yields 5
            # labels on one line, and neither tuple's element count divides 5. This function
            # cannot tell from the line alone which occurrence it is, so it tries every START
            # offset, reading the labels the way the parser wrote them, and keeps the offsets
            # that name an already-registered tuple struct with matching element TYPES
            # (register_tuple_types knows the source order and registers each tuple under its
            # own labels). A unique hit resolves; two different hits stay ambiguous and decline.
            tuple_labels_all: darray[sview] = tuple_labels_at(tuple_type_line, structs)
            unmodeled_type() return if tuple_labels_all.count < tuple_type_elements.count
            tuple_element_types: mutable darray[ValueType] = []
            tuple_declined: mutable bool = false
            for tuple_element in tuple_type_elements |tuple_element_types, tuple_declined, structs|:
                tuple_element_type: ValueType = annotation_value_type(tuple_element, structs)
                tuple_declined <- true if tuple_element_type.kind == TypeKind.Unmodeled
                tuple_element_types.push(tuple_element_type)
            unmodeled_type() return if tuple_declined
            tuple_window_limit: usize = tuple_labels_all.count - tuple_type_elements.count + 1
            tuple_found: mutable i64 = -1
            tuple_ambiguous: mutable bool = false
            for tuple_offset in 0..<tuple_window_limit |tuple_found, tuple_ambiguous, tuple_type_line, tuple_type_elements, tuple_element_types, structs|:
                tuple_labels: darray[sview] = tuple_labels_window(tuple_type_line, tuple_offset, tuple_type_elements, structs)
                continue if tuple_labels.count != tuple_type_elements.count
                tuple_slot: i64 = tuple_struct_lookup(tuple_labels, tuple_element_types, structs)
                continue if tuple_slot < 0
                tuple_ambiguous <- true if tuple_found >= 0 and tuple_found != tuple_slot
                tuple_found <- tuple_slot
            ValueType{kind: TypeKind.Struct, bits: tuple_found.u32()} return if tuple_found >= 0 and not tuple_ambiguous
            return unmodeled_type()
