# Verified byte scanning shared by the EASM parser helpers.
module EasmTextScan:
    public:
        const ASCII_SPACE: u8 = 32
        const ASCII_TAB: u8 = 9
        const BYTE_INDEX_STEP: usize = 1
        const SIGNED_INDEX_STEP: i64 = 1

        def contains_memory_address_delimiter(has_parenthesis: bool, has_square_bracket: bool) -> bool:
            ensure result == (has_parenthesis or has_square_bracket)
            return has_parenthesis or has_square_bracket

        # Search for the first occurrence of a non-empty needle. An empty needle
            # deliberately returns the text length to preserve the verifier's legacy sentinel.
        def find(text: sview, needle: sview) -> usize:
            ensure result <= sview_len(text)
            ensure (sview_len(needle) == 0 or sview_len(text) < sview_len(needle)) implies result == sview_len(text)
            ensure result < sview_len(text) implies (
                sview_len(needle) > 0 and
                sview_len(needle) <= sview_len(text) and
                result <= sview_len(text) - sview_len(needle) and
                text[result:result + sview_len(needle)] == needle
            )
            ensure (forall candidate in 0..<result:
                sview_len(needle) == 0 or
                sview_len(needle) > sview_len(text) - candidate or
                text[candidate:candidate + sview_len(needle)] != needle
            )
            text_length: usize = sview_len(text)
            needle_length: usize = sview_len(needle)
            assert text_length == sview_len(text)
            assert needle_length == sview_len(needle)
            if needle_length == 0 or text_length < needle_length:
                return text_length
            search_limit: usize = text_length - needle_length + BYTE_INDEX_STEP
            index: mutable usize = 0
            while index < search_limit |index, search_limit, text, needle, needle_length, text_length|:
                decreases search_limit - index
                invariant index <= search_limit
                invariant (forall candidate in 0..<index:
                    needle_length <= text_length - candidate and
                    text[candidate:candidate + needle_length] != needle
                )
                if text[index:index + needle_length] == needle:
                    return index
                index <- index + BYTE_INDEX_STEP
            return text_length

        # Decide whether the prefix bytes match exactly; a longer prefix cannot match.
        def starts_with(text: sview, prefix: sview) -> bool:
            ensure result implies sview_len(prefix) <= sview_len(text)
            ensure result implies (forall prefix_index in 0..<sview_len(prefix):
                prefix_index >= sview_len(text) or sview_at(text, prefix_index) == sview_at(prefix, prefix_index)
            )
            ensure (sview_len(prefix) <= sview_len(text) and (forall prefix_index in 0..<sview_len(prefix):
                prefix_index >= sview_len(text) or sview_at(text, prefix_index) == sview_at(prefix, prefix_index)
            )) implies result
            text_length: usize = sview_len(text)
            prefix_length: usize = sview_len(prefix)
            return false if prefix_length > text_length
            index: mutable usize = 0
            while index < prefix_length |index, text, prefix, prefix_length|:
                decreases prefix_length - index
                invariant index <= prefix_length
                invariant forall matched_index in 0..<index:
                    sview_at(text, matched_index) == sview_at(prefix, matched_index)
                return false if sview_at(text, index) != sview_at(prefix, index)
                index <- index + BYTE_INDEX_STEP
            return true

        def equal(a: sview, b: sview) -> bool:
            ensure result implies sview_len(a) == sview_len(b)
            ensure result implies (forall index in 0..<sview_len(a):
                index >= sview_len(b) or sview_at(a, index) == sview_at(b, index)
            )
            ensure (sview_len(a) == sview_len(b) and (forall index in 0..<sview_len(a):
                index >= sview_len(b) or sview_at(a, index) == sview_at(b, index)
            )) implies result
            return sview_len(a) == sview_len(b) and starts_with(a, b)

        def first_space(text: sview) -> i64:
            ensure result >= 0
            ensure text.len < 0 implies result == 0
            ensure text.len >= 0 implies result <= text.len
            ensure text.len < 0 or result == text.len or (
                result < text.len and (text[result] == ASCII_SPACE or text[result] == ASCII_TAB)
            )
            ensure (forall prefix_index in 0..<result: text.len < 0 or prefix_index >= text.len or (text[prefix_index] != ASCII_SPACE and text[prefix_index] != ASCII_TAB))
            index: mutable i64 = 0
            while index < text.len |index, text|:
                decreases text.len - index
                invariant index >= 0
                invariant text.len < 0 implies index == 0
                invariant text.len >= 0 implies index <= text.len
                invariant forall prefix_index in 0..<index: text.len < 0 or prefix_index >= text.len or (text[prefix_index] != ASCII_SPACE and text[prefix_index] != ASCII_TAB)
                return index if text[index] == ASCII_SPACE or text[index] == ASCII_TAB
                index <- index + SIGNED_INDEX_STEP
            return index

        # Return the maximal half-open span left after removing only leading and
        # trailing ASCII spaces and tabs. Internal whitespace remains in the span.
        def trim_bounds(text: sview) -> (start: usize, end: usize):
            ensure result.start <= result.end
            ensure result.end <= sview_len(text)
            ensure (forall prefix_index in 0..<result.start:
                sview_at(text, prefix_index) == ASCII_SPACE or sview_at(text, prefix_index) == ASCII_TAB
            )
            ensure (forall suffix_index in result.end..<sview_len(text):
                sview_at(text, suffix_index) == ASCII_SPACE or sview_at(text, suffix_index) == ASCII_TAB
            )
            ensure result.start == result.end or (
                sview_at(text, result.start) != ASCII_SPACE and
                sview_at(text, result.start) != ASCII_TAB and
                sview_at(text, result.end - BYTE_INDEX_STEP) != ASCII_SPACE and
                sview_at(text, result.end - BYTE_INDEX_STEP) != ASCII_TAB
            )
            ensure result.start != result.end or result.start == sview_len(text)
            text_length: usize = sview_len(text)
            first: mutable usize = 0
            last: mutable usize = text_length
            while first < last and (sview_at(text, first) == ASCII_SPACE or sview_at(text, first) == ASCII_TAB) |first, last, text, text_length|:
                decreases last - first
                invariant first <= last
                invariant last <= text_length
                invariant forall prefix_index in 0..<first:
                    sview_at(text, prefix_index) == ASCII_SPACE or sview_at(text, prefix_index) == ASCII_TAB
                first <- first + BYTE_INDEX_STEP
            assert first == last or (
                sview_at(text, first) != ASCII_SPACE and sview_at(text, first) != ASCII_TAB
            )
            while last > first and (sview_at(text, last - BYTE_INDEX_STEP) == ASCII_SPACE or sview_at(text, last - BYTE_INDEX_STEP) == ASCII_TAB) |last, first, text, text_length|:
                decreases last - first
                invariant first <= last
                invariant last <= text_length
                invariant first == last or (
                    sview_at(text, first) != ASCII_SPACE and sview_at(text, first) != ASCII_TAB
                )
                invariant forall prefix_index in 0..<first:
                    sview_at(text, prefix_index) == ASCII_SPACE or sview_at(text, prefix_index) == ASCII_TAB
                invariant forall suffix_index in last..<text_length:
                    sview_at(text, suffix_index) == ASCII_SPACE or sview_at(text, suffix_index) == ASCII_TAB
                last <- last - BYTE_INDEX_STEP
            assert last == first or (
                sview_at(text, last - BYTE_INDEX_STEP) != ASCII_SPACE and
                sview_at(text, last - BYTE_INDEX_STEP) != ASCII_TAB
            )
            return (first, last)

        def trim(text: sview) -> sview:
            bounds: (start: usize, end: usize) = trim_bounds(text)
            return text[bounds.start:bounds.end]
