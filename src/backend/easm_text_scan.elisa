# Verified byte scanning shared by the EASM parser helpers.
module EasmTextScan:
    public:
        const ASCII_SPACE: u8 = 32
        const ASCII_TAB: u8 = 9
        const BYTE_INDEX_STEP: usize = 1
        const SIGNED_INDEX_STEP: i64 = 1

        # Search for one byte directly so callers can use the miss path as a
        # byte-level absence fact without reasoning about slice equality.
        def find_byte(text: sview, needle: u8) -> usize:
            ensure result <= text.len
            ensure result == text.len or text[result] == needle
            ensure (forall candidate in 0..<result: text[candidate] != needle)
            ensure result == find_byte_spec(text, needle)
            index: mutable usize = 0
            while index < text.len |index, text, needle|:
                decreases text.len - index
                invariant index <= text.len
                invariant (forall candidate in 0..<index: text[candidate] != needle)
                return index if text[index] == needle
                index <- index + BYTE_INDEX_STEP
            return text.len

        ghost def find_byte_from_spec(text: sview, needle: u8, index: usize) -> usize:
            requires index <= text.len
            decreases text.len - index
            ensure result >= index
            ensure result <= text.len
            ensure result == text.len or text[result] == needle
            ensure (forall candidate in index..<result: text[candidate] != needle)
            return text.len if index == text.len
            return index if text[index] == needle
            return find_byte_from_spec(text, needle, index + BYTE_INDEX_STEP)

        ghost def find_byte_spec(text: sview, needle: u8) -> usize:
            ensure result <= text.len
            ensure result == text.len or text[result] == needle
            ensure (forall candidate in 0..<result: text[candidate] != needle)
            return find_byte_from_spec(text, needle, 0.usize())

        def contains_memory_address_delimiter(has_parenthesis: bool, has_square_bracket: bool) -> bool:
            ensure result == (has_parenthesis or has_square_bracket)
            return has_parenthesis or has_square_bracket

        # Search for the first occurrence of a non-empty needle. An empty needle
        # deliberately returns the text length to preserve the verifier's legacy sentinel.
        ghost def find_no_match_before(text: sview, needle: sview, bound: usize) -> bool:
            requires needle.len > 0 and needle.len <= text.len
            requires bound <= text.len - needle.len + BYTE_INDEX_STEP
            decreases bound
            ensure bound == 0 implies result
            ensure (
                (bound > 0) implies (
                    result == (
                        find_no_match_before(text, needle, bound - BYTE_INDEX_STEP) and
                        text[bound - BYTE_INDEX_STEP:(bound - BYTE_INDEX_STEP) + needle.len] != needle
                    )
                )
            )
            return true if bound == 0
            return find_no_match_before(text, needle, bound - BYTE_INDEX_STEP) and text[bound - BYTE_INDEX_STEP:(bound - BYTE_INDEX_STEP) + needle.len] != needle

        def find(text: sview, needle: sview) -> usize:
            ensure result <= text.len
            ensure (needle.len == 0 or text.len < needle.len) implies result == text.len
            ensure result < text.len implies (
                needle.len > 0 and
                needle.len <= text.len and
                result <= text.len - needle.len and
                text[result:result + needle.len] == needle
            )
            ensure (needle.len > 0 and needle.len <= text.len and result < text.len) implies (
                find_no_match_before(text, needle, result)
            )
            ensure (needle.len > 0 and needle.len <= text.len and result == text.len) implies (
                find_no_match_before(text, needle, text.len - needle.len + BYTE_INDEX_STEP)
            )
            if needle.len == 0 or text.len < needle.len:
                return text.len
            assert needle.len > 0 and needle.len <= text.len
            search_limit: usize = text.len - needle.len + BYTE_INDEX_STEP
            assert search_limit <= text.len
            assert search_limit == text.len - needle.len + BYTE_INDEX_STEP
            index: mutable usize = 0
            while index < search_limit |index, search_limit, text, needle|:
                decreases search_limit - index
                invariant index <= search_limit
                invariant find_no_match_before(text, needle, index)
                assert index <= text.len - needle.len
                assert index + needle.len <= text.len
                if text[index:index + needle.len] == needle:
                    assert index < text.len
                    assert index <= text.len - needle.len
                    assert text[index:index + needle.len] == needle
                    assert find_no_match_before(text, needle, index)
                    return index
                else:
                    assert text[index:index + needle.len] != needle
                    assert index + BYTE_INDEX_STEP <= search_limit
                    assert find_no_match_before(text, needle, index + BYTE_INDEX_STEP) == (
                        find_no_match_before(text, needle, index) and
                        text[index:index + needle.len] != needle
                    )
                    assert find_no_match_before(text, needle, index + BYTE_INDEX_STEP)
                index <- index + BYTE_INDEX_STEP
            assert index == search_limit
            assert find_no_match_before(text, needle, search_limit)
            assert search_limit == text.len - needle.len + BYTE_INDEX_STEP
            assert find_no_match_before(text, needle, text.len - needle.len + BYTE_INDEX_STEP)
            return text.len

        # Decide whether the prefix bytes match exactly; a longer prefix cannot match.
        def starts_with(text: sview, prefix: sview) -> bool:
            ensure result implies prefix.len <= text.len
            ensure result implies (forall prefix_index in 0..<prefix.len:
                prefix_index >= text.len or text[prefix_index] == prefix[prefix_index]
            )
            ensure (prefix.len <= text.len and (forall prefix_index in 0..<prefix.len:
                prefix_index >= text.len or text[prefix_index] == prefix[prefix_index]
            )) implies result
            text_length: usize = text.len
            prefix_length: usize = prefix.len
            return false if prefix_length > text_length
            index: mutable usize = 0
            while index < prefix_length |index, text, prefix, prefix_length|:
                decreases prefix_length - index
                invariant index <= prefix_length
                invariant forall matched_index in 0..<index:
                    text[matched_index] == prefix[matched_index]
                return false if text[index] != prefix[index]
                index <- index + BYTE_INDEX_STEP
            return true

        def equal(a: sview, b: sview) -> bool:
            ensure result implies a.len == b.len
            ensure result implies (forall index in 0..<a.len:
                index >= b.len or a[index] == b[index]
            )
            ensure (a.len == b.len and (forall index in 0..<a.len:
                index >= b.len or a[index] == b[index]
            )) implies result
            return a.len == b.len and starts_with(a, b)

        def first_space(text: sview) -> i64:
            ensure result >= 0
            ensure text.len < 0 implies result == 0
            ensure text.len >= 0 implies result <= text.len
            ensure text.len < 0 or result == text.len or (
                result < text.len and (text[result] == ASCII_SPACE or text[result] == ASCII_TAB)
            )
            ensure (forall prefix_index in 0..<result: text.len < 0 or prefix_index >= text.len or (text[prefix_index] != ASCII_SPACE and text[prefix_index] != ASCII_TAB))
            index: mutable i64 = 0
            while index < text.len |index, text|:
                decreases text.len - index
                invariant index >= 0
                invariant text.len < 0 implies index == 0
                invariant text.len >= 0 implies index <= text.len
                invariant forall prefix_index in 0..<index: text.len < 0 or prefix_index >= text.len or (text[prefix_index] != ASCII_SPACE and text[prefix_index] != ASCII_TAB)
                return index if text[index] == ASCII_SPACE or text[index] == ASCII_TAB
                index <- index + SIGNED_INDEX_STEP
            return index

        # Return the maximal half-open span left after removing only leading and
        # trailing ASCII spaces and tabs. Internal whitespace remains in the span.
        def trim_bounds(text: sview) -> (start: usize, end: usize):
            ensure result.start <= result.end
            ensure result.end <= text.len
            ensure (forall prefix_index in 0..<result.start:
                text[prefix_index] == ASCII_SPACE or text[prefix_index] == ASCII_TAB
            )
            ensure (forall suffix_index in result.end..<text.len:
                text[suffix_index] == ASCII_SPACE or text[suffix_index] == ASCII_TAB
            )
            ensure result.start == result.end or (
                text[result.start] != ASCII_SPACE and
                text[result.start] != ASCII_TAB and
                text[result.end - BYTE_INDEX_STEP] != ASCII_SPACE and
                text[result.end - BYTE_INDEX_STEP] != ASCII_TAB
            )
            ensure result.start != result.end or result.start == text.len
            text_length: usize = text.len
            assert text_length == text.len
            first: mutable usize = 0
            last: mutable usize = text_length
            assert first <= last
            assert last <= text_length
            assert forall prefix_index in 0..<first:
                text[prefix_index] == ASCII_SPACE or text[prefix_index] == ASCII_TAB
            while first < last and (text[first] == ASCII_SPACE or text[first] == ASCII_TAB) |first, last, text, text_length|:
                decreases last - first
                invariant first <= last
                invariant last == text_length
                invariant last <= text_length
                invariant text_length == text.len
                invariant first == 0 or (forall prefix_index in 0..<first:
                    text[prefix_index] == ASCII_SPACE or text[prefix_index] == ASCII_TAB
                )
                first <- first + BYTE_INDEX_STEP
            assert first <= last
            assert last <= text_length
            assert forall prefix_index in 0..<first:
                text[prefix_index] == ASCII_SPACE or text[prefix_index] == ASCII_TAB
            assert (first != last or first == text_length)
            assert first == last or (
                text[first] != ASCII_SPACE and text[first] != ASCII_TAB
            )
            assert forall suffix_index in last..<text_length:
                text[suffix_index] == ASCII_SPACE or text[suffix_index] == ASCII_TAB
            while last > first and (text[last - BYTE_INDEX_STEP] == ASCII_SPACE or text[last - BYTE_INDEX_STEP] == ASCII_TAB) |last, first, text, text_length|:
                decreases last - first
                invariant first <= last
                invariant first == text_length or (
                    text[first] != ASCII_SPACE and text[first] != ASCII_TAB
                )
                invariant last <= text_length
                invariant text_length == text.len
                invariant first == last or (
                    text[first] != ASCII_SPACE and text[first] != ASCII_TAB
                )
                invariant forall prefix_index in 0..<first:
                    text[prefix_index] == ASCII_SPACE or text[prefix_index] == ASCII_TAB
                invariant last == text_length or (forall suffix_index in last..<text_length:
                    text[suffix_index] == ASCII_SPACE or text[suffix_index] == ASCII_TAB
                )
                last <- last - BYTE_INDEX_STEP
            assert first <= last
            assert last <= text_length
            assert forall prefix_index in 0..<first:
                text[prefix_index] == ASCII_SPACE or text[prefix_index] == ASCII_TAB
            assert forall suffix_index in last..<text_length:
                text[suffix_index] == ASCII_SPACE or text[suffix_index] == ASCII_TAB
            assert first == last or (
                text[first] != ASCII_SPACE and text[first] != ASCII_TAB
            )
            assert (first != last or first == text_length)
            assert last == first or (
                text[last - BYTE_INDEX_STEP] != ASCII_SPACE and
                text[last - BYTE_INDEX_STEP] != ASCII_TAB
            )
            return (first, last)

        def trim(text: sview) -> sview:
            bounds: (start: usize, end: usize) = trim_bounds(text)
            return text[bounds.start:bounds.end]

        # Pure recursive specifications of the scanners above, for use in ghost functions.
        ghost def find_from_spec(text: sview, needle: sview, index: usize) -> usize:
            requires needle.len > 0 and needle.len <= text.len and index <= text.len - needle.len + BYTE_INDEX_STEP
            decreases text.len - needle.len + BYTE_INDEX_STEP - index
            ensure result <= text.len
            return text.len if index == text.len - needle.len + BYTE_INDEX_STEP
            return index if text[index:index + needle.len] == needle
            return find_from_spec(text, needle, index + BYTE_INDEX_STEP)

        ghost def find_spec(text: sview, needle: sview) -> usize:
            ensure result <= text.len
            return text.len if needle.len == 0 or text.len < needle.len
            return find_from_spec(text, needle, 0)

        ghost def trim_start_spec(text: sview, first: usize) -> usize:
            requires first <= text.len
            decreases text.len - first
            ensure result >= first and result <= text.len
            return first if first == text.len
            return first if text[first] != ASCII_SPACE and text[first] != ASCII_TAB
            return trim_start_spec(text, first + BYTE_INDEX_STEP)

        ghost def trim_end_spec(text: sview, first: usize, last: usize) -> usize:
            requires first <= last and last <= text.len
            decreases last - first
            ensure result >= first and result <= last
            return last if last == first
            return last if text[last - BYTE_INDEX_STEP] != ASCII_SPACE and text[last - BYTE_INDEX_STEP] != ASCII_TAB
            return trim_end_spec(text, first, last - BYTE_INDEX_STEP)

        ghost def trim_bounds_spec_from(text: sview, first: usize) -> (start: usize, end: usize):
            requires first <= text.len
            ensure result.start <= result.end
            ensure result.end <= text.len
            return (first, trim_end_spec(text, first, text.len))

        ghost def trim_bounds_spec(text: sview) -> (start: usize, end: usize):
            ensure result.start <= result.end
            ensure result.end <= text.len
            return trim_bounds_spec_from(text, trim_start_spec(text, 0))

        ghost def trim_spec(text: sview) -> sview:
            ensure text.len < 0 implies result.len == 0
            ensure result.len >= 0
            ensure text.len >= 0 implies result.len <= text.len
            return "" if text.len < 0
            return text[trim_bounds_spec(text).start:trim_bounds_spec(text).end]
