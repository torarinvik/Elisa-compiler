# Verified byte scanning shared by the EASM parser helpers.
module EasmTextScan:
    public:
        def first_space(text: sview) -> i64:
            ensure result >= 0
            ensure text.length < 0 implies result == 0
            ensure text.length >= 0 implies result <= text.length
            ensure text.length < 0 or result == text.length or (
                result < text.length and (text[result] == 32 or text[result] == 9)
            )
            ensure (forall prefix_index in 0..<result: text.length < 0 or prefix_index >= text.length or (text[prefix_index] != 32 and text[prefix_index] != 9))
            index: mutable i64 = 0
            while index < text.length |index, text|:
                decreases text.length - index
                invariant index >= 0
                invariant text.length < 0 implies index == 0
                invariant text.length >= 0 implies index <= text.length
                invariant forall prefix_index in 0..<index: text.length < 0 or prefix_index >= text.length or (text[prefix_index] != 32 and text[prefix_index] != 9)
                return index if text[index] == 32 or text[index] == 9
                index <- index + 1
            return index
