# Stage1 backend — WHICH ARENA a growing container allocates from: the variable a mutating
# chain is rooted at, the arena that root was declared in, and the hidden arena a call
# therefore threads to a callee that grows one.
# Part of `module Backend` (see codegen.elisa).

extend Backend:
    private:


        # The base VARIABLE a container-mutating chain is rooted at: `xs` for `xs.push`,
        # `structs` for `structs.binding_names.push`, `rows[i]` -> `rows`. "" when the root
        # is not a named local (a call result, a literal), in which case the ambient arena
        # is the only answer available.
        def growth_root_name(expression: Expr) -> sview can[Abort.Panic]:
            can Abort.Panic:
                return match expression:
                    Expr.Ident(gr_name, gr_line): gr_name
                    Expr.Field(gr_object, gr_field, gr_field_line): growth_root_name(gr_object)
                    Expr.Index(gr_head, gr_index, gr_index_line): growth_root_name(gr_head)
                    Expr.Paren(gr_inner, gr_paren_line): growth_root_name(gr_inner)
                    _: ""




            # The arena a container rooted at `expression` GROWS from. stage0's rule, measured:
            # growth allocates from the arena the container was DECLARED under, not the arena
            # that happens to be ambient at the push site. Inside `region scratch(4096):` a push
            # to a darray declared OUTSIDE the block still calls `arena_alloc(ptr %__auto, …)`;
            # using the block's arena instead hands back memory that is freed at the block's
            # end — that use-after-free is what crashed the compiler itself on every propagating
            # `try` to a generic (error_callee_target infers inside `region scratch:` while
            # pushing into the caller's `structs`/`generics` tables).
            #
            # Resolution: the innermost region frame whose `start` the root's declaration index
            # reaches owns it; a root declared before EVERY frame gets the outermost frame's
            # `outer` arena; no frames (or no named root) is the ambient runtime.arena — the
            # pre-existing behavior, and correct outside region blocks.
        def growth_arena_for(expression: Expr, local_scope: mutable Scope&, runtime: Runtime&) -> LLVMValueRef can[Abort.Panic]:
            can Abort.Panic:
                ga_root: sview = growth_root_name(expression)
                runtime.arena return if ga_root == ""
                ga_found: mutable i64 = -1
                for ga_index in 0..<local_scope.names.count |ga_found, local_scope, ga_root|:
                    ga_found <- ga_index.i64() if local_scope.names[ga_index] == ga_root
                runtime.arena return if ga_found < 0
                # A reference parameter aliases storage owned by the caller. Its growth must
                # never fall back to the callee's scratch arena, even when the function also
                # has local region-backed temporaries.
                ga_type: ValueType = lookup_type(local_scope, ga_root)
                if ga_type.kind == TypeKind.Ref:
                    if ga_found.usize() < local_scope.local_parameter_arena_indices.count:
                        parameter_arena_index: i64 = local_scope.local_parameter_arena_indices[ga_found.usize()]
                        if parameter_arena_index >= 0 and parameter_arena_index.usize() < runtime.caller_arenas.count:
                            return runtime.caller_arenas[parameter_arena_index.usize()]
                    return runtime.caller_arena if not llvm_value_is_null(runtime.caller_arena)
                    return runtime.arena
                # An EXPLICIT `@region` pin wins over the lexical frame rule below: the
                # declaration named the arena, so growth must go to the same one the initial
                # allocation did.
                if ga_found.usize() < local_scope.local_has_declared_arena.count:
                    local_scope.local_declared_arenas[ga_found.usize()] return if local_scope.local_has_declared_arena[ga_found.usize()]
                ga_frame: mutable i64 = local_scope.region_frame_starts.count.i64() - 1
                while ga_frame >= 0 |ga_frame, ga_found, local_scope|:
                    local_scope.region_frame_arenas[ga_frame.usize()] return if ga_found >= local_scope.region_frame_starts[ga_frame.usize()].i64()
                    ga_frame <- ga_frame - 1
                local_scope.region_frame_outers[0] return if local_scope.region_frame_outers.count > 0
                return runtime.arena




            # `runtime` with its arena swapped to the declaration arena of `expression`'s root —
            # what a growth site (push/extend/resize) must emit its reallocation against.
        def growth_runtime_for(expression: Expr, local_scope: mutable Scope&, runtime: Runtime&) -> Runtime can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic:
                grown: mutable Runtime = copied_runtime(runtime)
                grown.arena <- growth_arena_for(expression, local_scope, runtime)
                return grown




            # The hidden arena a CALL threads to a callee that grows a container. stage0 passes
            # the arena of the growable REF argument's DECLARATION, not the ambient one:
            # `region scratch: helper(outer)` emits `call @helper(ptr %outer, ptr %__auto)` —
            # measured, -emit llvm. The callee's growth of `outer` must outlive `scratch`.
            #
            # Resolution: the first argument whose root is a named container-carrying local
            # (darray, struct, or a ref to one) decides; a call with no such argument keeps the
            # ambient arena, which is also the correct region for a RETURNED container built
            # inside a `region` block. With no region frames the ambient arena already equals
            # every declaration arena, so this is the pre-existing behavior at zero cost.
            # Among several container arguments the OUTERMOST declaration wins: a callee that
            # grows two tables gets the longer-lived arena, so nothing it stores outlives its
            # backing (the shorter-lived data at worst lives a little longer). Picking the FIRST
            # argument instead handed generic_return_type(name, inferred, generics, structs) the
            # scratch region `inferred` lives in, and every push into `structs` died with it.
        def call_site_arena(arguments: darray[Expr]&, local_scope: mutable Scope&, runtime: Runtime&) -> LLVMValueRef can[Abort.Panic]:
            can Abort.Panic:
                if local_scope.region_frame_starts.count == 0:
                    for no_frame_argument in arguments |local_scope, runtime|:
                        no_frame_root: sview = growth_root_name(no_frame_argument)
                        continue if no_frame_root == ""
                        no_frame_type: ValueType = lookup_type(local_scope, no_frame_root)
                        if no_frame_type.kind == TypeKind.Ref:
                            return growth_arena_for(no_frame_argument, local_scope, runtime)
                    return runtime.arena
                best_level: mutable i64 = 2147483647
                best_arena: mutable LLVMValueRef = zeroed
                have_best: mutable bool = false
                for argument in arguments |local_scope, runtime, best_level, best_arena, have_best|:
                    csa_root: sview = growth_root_name(argument)
                    continue if csa_root == ""
                    csa_type: ValueType = lookup_type(local_scope, csa_root)
                    csa_kind: TypeKind = csa_type.kind
                    continue if csa_kind != TypeKind.DArray and csa_kind != TypeKind.Struct and csa_kind != TypeKind.Ref
                    csa_found: mutable i64 = -1
                    for csa_index in 0..<local_scope.names.count |csa_found, local_scope, csa_root|:
                        csa_found <- csa_index.i64() if local_scope.names[csa_index] == csa_root
                    continue if csa_found < 0
                    # The frame that owns this argument's declaration: -1 = before every frame.
                    csa_level: mutable i64 = -1
                    for csa_frame in 0..<local_scope.region_frame_starts.count |csa_level, csa_found, local_scope|:
                        csa_level <- csa_frame.i64() if csa_found >= local_scope.region_frame_starts[csa_frame].i64()
                    if csa_level < best_level:
                        best_level <- csa_level
                        best_arena <- growth_arena_for(argument, local_scope, runtime)
                        have_best <- true
                best_arena return if have_best
                return runtime.arena




            # The slot an `is` test must store its binding into.
            #
            # Inside a condition, every `is` test binding the same name at the same LLVM type
            # shares ONE entry-block alloca. That is what makes an or-chain correct: only the
            # alternative that actually matched runs, so only it stores — and the body reads the
            # single slot it wrote. Per-test slots would leave the body reading whichever slot
            # was declared last, which for a short-circuited alternative was never written.
            #
            # The slot is always an ENTRY alloca so it dominates the body, and it is always a
            # FRESH slot the first time a name appears in this condition — never an outer local
            # of the same name, so a binding that shadows leaves the shadowed variable intact.
            # Outside a condition (depth 0) each test just gets its own entry slot, as before.
            # The scope is a flat, append-only list scanned BACKWARDS, so a declaration left in
            # place after its block ends makes a LATER use of the same name resolve to that
            # block's slot — which the later path never stored. That is a miscompile, not a
            # lookup nicety: `emit_statement_loops` declares `int64_type` inside the darray-`for`
            # branch, and the range-`for` branch BELOW it then allocated with that undominated
            # slot. gen2 died building the compiler on exactly that (LLVMBuildAlloca on a garbage
            # type). stage0 scopes with a parent chain; the flat list gets the same effect by
            # truncating back to the mark taken when the block opened.
        # The darray type an unannotated COMPREHENSION declaration produces:
        # `xs = [item + 1 for item in items if item > 0]`.
        #
        # expression_type answers Unmodeled for a comprehension (its type comes from context,
        # and here there is none), and literal_container_type only reads Array literals -- so
        # the declaration declined even though the annotated form works. The element type is
        # the PROJECTION's type with the binder in scope, so the binder is bound to the
        # iterable's element type for exactly the length of that query and then popped.
        #
        # The binder's slot is `zeroed`: expression_type reads TYPES only, and the binding is
        # removed before anything can emit against it.
        def comprehension_result_type(comprehension_var: sview, iterable: Expr, body: Expr, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&) -> ValueType can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                unmodeled_type() return if body is Expr.Absent
                element: mutable ValueType = unmodeled_type()
                source: ValueType = iterable_darray_type(iterable, local_scope, fns, structs, generics)
                if source.kind == TypeKind.DArray:
                    element <- darray_element_of(source, structs)
                else:
                    match iterable:
                        Expr.Binary(range_lo, range_operator, range_hi, _):
                            # `[index for index in 1..<count]` — a RANGE source. The binder's type is
                            # the range's, taken from whichever bound has one (a bare literal has none).
                            if range_operator == TokenKind.RangeLt or range_operator == TokenKind.RangeLe:
                                element <- expression_type(range_hi, local_scope, fns, structs, generics)
                                element <- expression_type(range_lo, local_scope, fns, structs, generics) if element.kind == TypeKind.Unmodeled
                                element <- ValueType{kind: TypeKind.Signed, bits: 64} if element.kind == TypeKind.Unmodeled
                        _:
                            pass
                unmodeled_type() return if element.kind == TypeKind.Unmodeled
                probe_mark: usize = scope_mark(local_scope)
                declare_local(local_scope, comprehension_var, zeroed, element)
                projected: ValueType = expression_type(body, local_scope, fns, structs, generics)
                scope_restore(local_scope, probe_mark)
                unmodeled_type() return if projected.kind == TypeKind.Unmodeled
                return intern_darray_type(projected, structs)
