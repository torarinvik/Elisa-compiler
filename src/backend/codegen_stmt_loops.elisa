# Stage1 backend — `emit_statement`: `break`, `continue` and the `for` loop.
# A group of the statement emitter's branches, called from codegen_statement.elisa.
# `handled` is set TRUE on entry and cleared only if no branch here matched, so a branch
# that DECLINES still stops the dispatch — exactly as it did when every branch shared one
# function body.

extend Backend:
    private:
        # The darray header address for a READ — iteration, `.count`, `.items`.
        #
        # A NAMED darray — a local, a borrowed param, a struct field, a nested index — has a
        # real header address, and reading it in place is what the other darray paths do.
        # A CALL RESULT has no address at all (`for issue in verify_module_locksteps(m):`,
        # `easm_parse_params(line).count`), so emit the value and spill it into a slot.
        #
        # The spill is sound ONLY for READS. `xs.pop()` / `.reserve()` must keep using
        # darray_address_of_expr directly, or their mutation would land in the copy and be
        # lost — which is why this is a separate locator rather than a change to that one.
        # The darray type of an ITERABLE, through all three shapes a `for` header and a query
        # fold share:
        #   * a NAMED locator — `xs`, `b.items`, `m[i]`
        #   * a CALL result — no name, so the ordinary expression typer
        #   * an INLINE literal — no name AND no type of its own: the literal emitter takes
        #     its shape from the EXPECTED type, and neither a loop header nor a fold head
        #     supplies one. Read the element type off the elements instead — the first element
        #     whose own type is known wins, and a bare int literal defaults signed-64 as it
        #     does everywhere else. An empty literal, or one whose elements are all untyped,
        #     stays Unmodeled and keeps declining.
        #   * a FIXED ARRAY — `array[T, N]`, whose storage is contiguous but carries no
        #     header. Reported as the `darray[T]` it will be READ as; darray_read_slot builds
        #     the matching header. See iterable_fixed_array_type.
        #
        # The `for` loop grew this ladder first; `sum x in [1, 2, 3]` declined for exactly the
        # missing third rung, so it is shared rather than copied.
        def iterable_darray_type(iterable: Expr, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&) -> ValueType can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                container_type: mutable ValueType = darray_type_behind_expr(iterable, local_scope, structs)
                container_type <- expression_type(iterable, local_scope, fns, structs, generics) if container_type.kind != TypeKind.DArray
                # A fixed array READS exactly like a darray once it has a header, so report the
                # darray type and let darray_read_slot synthesize one over its storage. Iteration
                # binds a COPY of each element, so nothing writes back through the borrowed view.
                fixed_array: ValueType = iterable_fixed_array_type(iterable, local_scope, fns, structs, generics)
                if fixed_array.kind == TypeKind.Array:
                    fixed_element: ValueType = array_element_of(fixed_array, structs)
                    intern_darray_type(fixed_element, structs) return if fixed_element.kind != TypeKind.Unmodeled
                if container_type.kind != TypeKind.DArray:
                    match iterable:
                        Expr.Array(literal_elements, _):
                            literal_element_type: mutable ValueType = unmodeled_type()
                            for literal_element in literal_elements |literal_element_type, local_scope, fns, structs, generics|:
                                continue if literal_element_type.kind != TypeKind.Unmodeled
                                literal_element_type <- expression_type(literal_element, local_scope, fns, structs, generics)
                                if literal_element_type.kind == TypeKind.Unmodeled:
                                    match literal_element:
                                        Expr.IntLit(_, _):
                                            literal_element_type <- ValueType{kind: TypeKind.Signed, bits: 64}
                                        _:
                                            pass
                            container_type <- intern_darray_type(literal_element_type, structs) if literal_element_type.kind != TypeKind.Unmodeled
                        _:
                            pass
                return container_type


            # The fixed-array type of an iterable, through a bare name or a `array[T, N]&`
            # parameter. Unmodeled for everything else.
        def iterable_fixed_array_type(iterable: Expr, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&) -> ValueType can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                bound: mutable ValueType = match iterable:
                    Expr.Ident(array_name, _): lookup_type(local_scope, array_name)
                    _: expression_type(iterable, local_scope, fns, structs, generics)
                bound <- ref_target_of(bound, structs) if bound.kind == TypeKind.Ref
                bound return if bound.kind == TypeKind.Array
                return unmodeled_type()


            # The ADDRESS of a fixed array's storage. A local array IS its slot; an
            # `array[T, N]&` parameter's slot holds a POINTER to the caller's, so it takes one
            # more load. struct_address_of cannot serve here — it resolves Struct/View/Ref-to-
            # struct bindings only and answers null for an Array.
        def fixed_array_storage_address(iterable: Expr, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                match iterable:
                    Expr.Ident(array_name, array_name_line):
                        declared: ValueType = lookup_type(local_scope, array_name)
                        if lookup_slot(local_scope, array_name) is array_slot:
                            array_slot return if declared.kind == TypeKind.Array
                            if declared.kind == TypeKind.Ref and ref_target_of(declared, structs).kind == TypeKind.Array:
                                return LLVMBuildLoad2(builder, LLVMPointerTypeInContext(ctx, 0), array_slot, "array.ref")
                        return null
                    _:
                        pass
                return struct_chain_address(iterable, local_scope, fns, structs, generics, runtime, m, ctx, builder)


            # A darray HEADER over a fixed array's storage: `{ptr items, i64 count, i64 capacity}`
            # with `items` pointing at element 0 and both counts the compile-time extent. This is
            # what lets one darray walk serve `for x in xs` and every query fold when `xs` is an
            # `array[T, N]` — the alternative was a second copy of the loop plumbing in five
            # places. Read-only by construction: the loop binds a COPY of each element.
        def fixed_array_header_slot(iterable: Expr, array_type: ValueType, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            null return if array_type.kind != TypeKind.Array
            array_slot: usize = array_type.bits.usize()
            null return if array_slot >= structs.array_extents.count
            if fixed_array_storage_address(iterable, local_scope, fns, structs, generics, runtime, m, ctx, builder) is storage_address:
                int64_type: LLVMTypeRef = LLVMInt64TypeInContext(ctx)
                extent: LLVMValueRef = LLVMConstInt(int64_type, structs.array_extents[array_slot].u64(), 0)
                zero: LLVMValueRef = LLVMConstInt(int64_type, 0, 0)
                first_indices: mutable darray[LLVMValueRef] = [zero, zero]
                first_pointer: void& = (&first_indices[0]).cast[void&] can Unsafe.PointerCast
                items: LLVMValueRef = LLVMBuildGEP2(builder, llvm_type_of(array_type, structs, ctx), storage_address, first_pointer, 2, "array.items")
                header_type: LLVMTypeRef = darray_llvm_type(structs, ctx)
                header_slot: LLVMValueRef = build_entry_alloca(builder, header_type, "array.header")
                _ = LLVMBuildStore(builder, items, LLVMBuildStructGEP2(builder, header_type, header_slot, 0, "array.header.items"))
                _ = LLVMBuildStore(builder, extent, LLVMBuildStructGEP2(builder, header_type, header_slot, 1, "array.header.count"))
                _ = LLVMBuildStore(builder, extent, LLVMBuildStructGEP2(builder, header_type, header_slot, 2, "array.header.cap"))
                return header_slot
            return null


            # The stage0 iterator owns a VALUE copy of a fixed-array source before binding a
            # mutable element reference. Thus `for mutable item in items` mutates the iterator's
            # copy, not `items` itself. Keep that semantic boundary while still exposing the
            # element's address directly to the body (no per-element copy or write-back loop).
        def mutable_fixed_array_header_slot(iterable: Expr, array_type: ValueType, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            null return if array_type.kind != TypeKind.Array
            array_slot: usize = array_type.bits.usize()
            null return if array_slot >= structs.array_extents.count
            if fixed_array_storage_address(iterable, local_scope, fns, structs, generics, runtime, m, ctx, builder) is storage_address:
                array_llvm: LLVMTypeRef = llvm_type_of(array_type, structs, ctx)
                source_copy: LLVMValueRef = build_entry_alloca(builder, array_llvm, "iter.src")
                _ = LLVMBuildStore(builder, LLVMBuildLoad2(builder, array_llvm, storage_address, "iter.src.value"), source_copy)
                int64_type: LLVMTypeRef = LLVMInt64TypeInContext(ctx)
                extent: LLVMValueRef = LLVMConstInt(int64_type, structs.array_extents[array_slot].u64(), 0)
                zero: LLVMValueRef = LLVMConstInt(int64_type, 0, 0)
                first_indices: mutable darray[LLVMValueRef] = [zero, zero]
                first_pointer: void& = (&first_indices[0]).cast[void&] can Unsafe.PointerCast
                items: LLVMValueRef = LLVMBuildGEP2(builder, array_llvm, source_copy, first_pointer, 2, "iter.src.items")
                header_type: LLVMTypeRef = darray_llvm_type(structs, ctx)
                header_slot: LLVMValueRef = build_entry_alloca(builder, header_type, "array.header")
                _ = LLVMBuildStore(builder, items, LLVMBuildStructGEP2(builder, header_type, header_slot, 0, "array.header.items"))
                _ = LLVMBuildStore(builder, extent, LLVMBuildStructGEP2(builder, header_type, header_slot, 1, "array.header.count"))
                _ = LLVMBuildStore(builder, extent, LLVMBuildStructGEP2(builder, header_type, header_slot, 2, "array.header.cap"))
                return header_slot
            return null


        def darray_read_slot(iterable: Expr, container_type: ValueType, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                # BEFORE the darray locators: a fixed array has no header of its own, so it must
                # get the synthesized one rather than fall through to the value spill below (which
                # would store an `[N x T]` into a `{ptr, i64, i64}` slot).
                fixed_array: ValueType = iterable_fixed_array_type(iterable, local_scope, fns, structs, generics)
                if fixed_array.kind == TypeKind.Array:
                    return fixed_array_header_slot(iterable, fixed_array, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                if darray_address_of_expr(iterable, local_scope, fns, structs, generics, runtime, m, ctx, builder) is addressed_slot:
                    return addressed_slot
                if emit_expression(iterable, container_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is iterable_value:
                    spill_slot: LLVMValueRef = build_entry_alloca(builder, darray_llvm_type(structs, ctx), "for.darray.spill")
                    _ = LLVMBuildStore(builder, iterable_value, spill_slot)
                    return spill_slot
                return null


        def emit_statement_loops(statement: Stmt, return_type: ValueType, local_scope: mutable Scope&, loops: mutable LoopStack&, regions: mutable RegionStack&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef, handled: mutable bool&) -> EmitStatus can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            handled <- true
            int64_type: LLVMTypeRef = LLVMInt64TypeInContext(ctx)
            # `break` / `continue`. A LABEL is not modeled (the subset has no labelled
            # loops), and neither is a `break` outside any loop — an empty stack declines
            # rather than emitting a branch to nowhere.
            match statement:
                Stmt.Break(break_label, break_line):
                    EmitStatus.Declined return if break_label != ""
                    EmitStatus.Declined return if loops.exits.count == 0
                    # A `break` leaves every scope inside the loop at once, so it runs their
                    # scope-exit `defer`s on the way out — the normal end-of-iteration unwind is
                    # in emit_statements_scoped, which a `break` jumps straight past.
                    if loops.defer_marks.count > 0:
                        EmitStatus.Declined return if not emit_deferred_actions_from(local_scope, loops.defer_marks[loops.defer_marks.count - 1], true, fns, structs, generics, runtime, m, ctx, builder)
                    _ = LLVMBuildBr(builder, loops.exits[loops.exits.count - 1])
                    return EmitStatus.Terminated

                _:
                    pass
            match statement:
                Stmt.Continue(continue_label, continue_line):
                    EmitStatus.Declined return if continue_label != ""
                    EmitStatus.Declined return if loops.continues.count == 0
                    # `continue` ends the ITERATION, which is the same scope exit.
                    if loops.defer_marks.count > 0:
                        EmitStatus.Declined return if not emit_deferred_actions_from(local_scope, loops.defer_marks[loops.defer_marks.count - 1], true, fns, structs, generics, runtime, m, ctx, builder)
                    _ = LLVMBuildBr(builder, loops.continues[loops.continues.count - 1])
                    return EmitStatus.Terminated

                _:
                    pass
            match statement:
                Stmt.For(for_bind, for_variables, for_iterable, for_body, for_line):
                    # `bind` is a MODIFIER ("parallel" / "mutable" / ""), NOT the loop
                    # variable — the names live in `variables`. Data-parallel range loops are
                        # lowered through the structured runtime combinator; other parallel forms are
                        # still rejected until their source-view lowering is available.
                    if for_bind == "parallel":
                        parallel_range_status: EmitStatus = emit_parallel_range_for(for_variables, for_iterable, for_body, for_line.line, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)
                        parallel_range_status return if parallel_range_status != EmitStatus.Declined
                        parallel_band_status: EmitStatus = emit_parallel_band_for(for_variables, for_iterable, for_body, for_line.line, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                        parallel_band_status return if parallel_band_status != EmitStatus.Declined
                    # `mutable` keeps the loop binder as an address into the iterable's
                    # storage. The ordinary darray/fixed-array walk below can use the same
                    # zero-overhead pointer, while other binding modifiers remain unsupported.
                    EmitStatus.Declined return if for_bind != "" and for_bind != "mutable"
                    # `for x in xs where COND:` — the parser wraps the iterable as
                    # Expr.Refinement(base, condition). NOTHING here matched Refinement, so the
                    # whole loop declined -- including a plain boolean filter, not just the
                    # pattern-filter forms.
                    #
                    # Desugar rather than thread a condition through every iteration path:
                    # `for x in (base where c): body` IS `for x in base: if c: body`, and the
                    # rewrite reaches the range, darray, fixed-array, dict and enumerate paths
                    # below without touching any of them. The filter is evaluated INSIDE the
                    # body, after the loop variable is bound, which is what lets it reference
                    # that variable at all.
                    #
                    # A BARE PATTERN filter (`where Enum.Variant(binders)`) is not a boolean and
                    # is not rewritten here: it would need the payload BOUND as well as tested,
                    # so it keeps declining rather than being emitted as a condition it is not.
                    # A RANGE base is excluded deliberately: stage0's PARSER REJECTS
                    # `for i in 0..<10 where c:` outright ("expected :, got where"), while
                    # stage1's parser accepts it. Emitting the desugaring for that shape would
                    # make stage1 run a program stage0 refuses -- the PERMISSIVE direction,
                    # which the gate ratchets at zero. Declining keeps both compilers refusing
                    # it. The container forms (`for x in xs where c:`) ARE valid in stage0 and
                    # are what this handles.
                    match for_iterable:
                        Expr.Refinement(for_filter_base, for_filter_condition, for_filter_line):
                            for_base_is_range: mutable bool = false
                            match for_filter_base:
                                Expr.Binary(for_range_lo, for_range_operator, for_range_hi, for_range_line):
                                    for_base_is_range <- for_range_operator == TokenKind.RangeLt or for_range_operator == TokenKind.RangeLe
                                _:
                                    pass
                            EmitStatus.Declined return if for_base_is_range
                            # A BARE PATTERN filter (`where Enum.Variant(binders)`) is a PATTERN,
                            # not a predicate: it must BIND the payload as well as test the tag. It
                            # is exactly what `LOOPVAR is Enum.Variant(binders)` already means, and
                            # that form is fully lowered (tag test + payload binding), so rewrite to
                            # it rather than growing a second pattern-matching path here. The
                            # semantic layer already puts the binders in scope for the body.
                            #
                            # Single loop variable only: with several binders (`for k, v in d`) there
                            # is no one subject for the `is` test, so that shape keeps declining.
                            for_filter_test: mutable Expr = for_filter_condition
                            if is_bare_pattern_filter_expr(for_filter_condition) or is_bare_variant_filter_expr(for_filter_condition, structs):
                                EmitStatus.Declined return if for_variables.count != 1
                                for_filter_test <- (Expr.Binary((Expr.Ident(for_variables[0], for_filter_line)), TokenKind.Is, for_filter_condition, for_filter_line))
                            for_filtered_body: mutable darray[Stmt] = [(Stmt.If(for_filter_test, for_body, [], for_filter_line))]
                            return emit_statement((Stmt.For(for_bind, for_variables, for_filter_base, for_filtered_body, for_line)), return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)
                        _:
                            pass
                    # `for row in s.rows():` — ROW ITERATION over a `layout(soa)` aggregate. The
                    # binder is a row VIEW; rather than materialise stage0's `{ptr, i64}` pair, the
                    # aggregate's address and the loop index are recorded as a binder and
                    # `row.field` resolves straight to the element address (the same GEP the
                    # explicit `s[i].field` form produces).
                    #
                    # `rows` is accepted both called (`s.rows()`) and bare (`s.rows`) — stage0's own
                    # corpus writes it both ways.
                    if (for_variables.count == 1 or for_variables.count == 2) and for_bind == "":
                        # The row SEQUENCE, peeled out of its wrappers: `s.rows()`, the bare
                        # `s.rows`, `s.rows().enumerate()` (index + row) and `rev(s.rows())`
                        # (descending) are the four spellings stage0's corpus uses.
                        soa_iter_walk: mutable Expr = for_iterable
                        soa_iter_reversed: mutable bool = false
                        soa_iter_enumerated: mutable bool = false
                        match soa_iter_walk:
                            Expr.Call(soa_rev_callee, soa_rev_args, soa_rev_names, soa_rev_line):
                                match soa_rev_callee:
                                    Expr.Ident(soa_rev_name, soa_rev_name_line):
                                        if soa_rev_name == "rev" and soa_rev_args.count == 1:
                                            soa_iter_reversed <- true
                                            soa_iter_walk <- soa_rev_args[0]
                                    _:
                                        pass
                            _:
                                pass
                        match soa_iter_walk:
                            Expr.Call(soa_en_callee, soa_en_args, soa_en_names, soa_en_line):
                                match soa_en_callee:
                                    Expr.Field(soa_en_object, soa_en_method, soa_en_method_line):
                                        if soa_en_method == "enumerate" and soa_en_args.count == 0:
                                            soa_iter_enumerated <- true
                                            soa_iter_walk <- soa_en_object
                                    _:
                                        pass
                            _:
                                pass
                        soa_iter_source: mutable Expr = Expr.Absent
                        match soa_iter_walk:
                            Expr.Call(soa_it_callee, soa_it_args, soa_it_names, soa_it_line):
                                match soa_it_callee:
                                    Expr.Field(soa_it_object, soa_it_method, soa_it_method_line):
                                        soa_iter_source <- soa_it_object if soa_it_method == "rows" and soa_it_args.count == 0
                                    _:
                                        pass
                            _:
                                pass
                        match soa_iter_walk:
                            Expr.Field(soa_bare_object, soa_bare_method, soa_bare_line):
                                soa_iter_source <- soa_bare_object if soa_bare_method == "rows"
                            _:
                                pass
                        # An enumerate needs both binders. Otherwise one binder is the row VIEW and
                        # N binders DESTRUCTURE the row, one per column in declaration order
                        # (`for {name_key, depth} in s.rows()` — the brace form parses as a plain
                        # multi-binder head).
                        soa_iter_destructured: mutable bool = false
                        if not (soa_iter_source is Expr.Absent) and not soa_iter_enumerated:
                            soa_head_type: ValueType = expression_type(soa_iter_source, local_scope, fns, structs, generics)
                            if soa_head_type.kind == TypeKind.Struct:
                                soa_iter_destructured <- for_variables.count == structs.field_count[soa_head_type.bits.usize()] and for_variables.count > 1.usize()
                        soa_iter_source <- Expr.Absent if soa_iter_enumerated and for_variables.count != 2
                        soa_iter_source <- Expr.Absent if not soa_iter_enumerated and for_variables.count != 1 and not soa_iter_destructured
                        if not (soa_iter_source is Expr.Absent):
                            soa_iter_type: ValueType = expression_type(soa_iter_source, local_scope, fns, structs, generics)
                            if soa_iter_type.kind == TypeKind.Struct and struct_declares_soa_layout(structs, structs.names[soa_iter_type.bits.usize()]) and structs.field_count[soa_iter_type.bits.usize()] > 0.usize():
                                if struct_chain_address(soa_iter_source, local_scope, fns, structs, generics, runtime, m, ctx, builder) is soa_iter_base:
                                    soa_iter_llvm: LLVMTypeRef = llvm_type_of(soa_iter_type, structs, ctx)
                                    soa_iter_i64: LLVMTypeRef = LLVMInt64TypeInContext(ctx)
                                    soa_iter_index: LLVMValueRef = build_entry_alloca(builder, soa_iter_i64, "soa.iter.i")
                                    soa_iter_col0_pre: LLVMValueRef = LLVMBuildStructGEP2(builder, llvm_type_of(soa_iter_type, structs, ctx), soa_iter_base, 0, "soa.iter.col0.pre")
                                    soa_iter_count_pre: LLVMValueRef = LLVMBuildLoad2(builder, soa_iter_i64, LLVMBuildStructGEP2(builder, darray_llvm_type(structs, ctx), soa_iter_col0_pre, 1, "soa.iter.count.pre.ptr"), "soa.iter.count.pre")
                                    # `rev(...)` walks DOWN from count-1; the forward form starts at 0.
                                    _ = LLVMBuildStore(builder, LLVMBuildSub(builder, soa_iter_count_pre, LLVMConstInt(soa_iter_i64, 1, 0), "soa.iter.last") if soa_iter_reversed else LLVMConstInt(soa_iter_i64, 0, 0), soa_iter_index)
                                    soa_iter_function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                                    soa_iter_cond: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, soa_iter_function, "soa.iter.cond")
                                    soa_iter_body: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, soa_iter_function, "soa.iter.body")
                                    soa_iter_step: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, soa_iter_function, "soa.iter.step")
                                    soa_iter_done: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, soa_iter_function, "soa.iter.done")
                                    _ = LLVMBuildBr(builder, soa_iter_cond)
                                    LLVMPositionBuilderAtEnd(builder, soa_iter_cond)
                                    soa_iter_col0: LLVMValueRef = LLVMBuildStructGEP2(builder, soa_iter_llvm, soa_iter_base, 0, "soa.iter.col0")
                                    soa_iter_count: LLVMValueRef = LLVMBuildLoad2(builder, soa_iter_i64, LLVMBuildStructGEP2(builder, darray_llvm_type(structs, ctx), soa_iter_col0, 1, "soa.iter.count.ptr"), "soa.iter.count")
                                    soa_iter_at: LLVMValueRef = LLVMBuildLoad2(builder, soa_iter_i64, soa_iter_index, "soa.iter.at")
                                    # 40 = SLT, 39 = SGE. Reversed runs while the index is still >= 0.
                                    _ = LLVMBuildCondBr(builder, LLVMBuildICmp(builder, 39, soa_iter_at, LLVMConstInt(soa_iter_i64, 0, 0), "soa.iter.more.rev") if soa_iter_reversed else LLVMBuildICmp(builder, 40, soa_iter_at, soa_iter_count, "soa.iter.more"), soa_iter_body, soa_iter_done)
                                    LLVMPositionBuilderAtEnd(builder, soa_iter_body)
                                    # `for i, row in s.rows().enumerate()` — the FIRST binder is the
                                    # running index, the second the row.
                                    # One local per column, loaded from that column at the current
                                    # row. The binder ORDER is the declaration order, which is what
                                    # the brace form means.
                                    if soa_iter_destructured:
                                        soa_de_slot: usize = soa_iter_type.bits.usize()
                                        soa_de_declined: mutable bool = false
                                        for soa_de_index in 0..<for_variables.count |soa_de_declined, soa_de_slot, soa_iter_base, soa_iter_llvm, soa_iter_index, soa_iter_i64, for_variables, local_scope, structs, ctx, builder|:
                                            soa_de_type: ValueType = darray_element_of(copied_type(structs.field_types[structs.field_start[soa_de_slot] + soa_de_index]), structs)
                                            if soa_de_type.kind == TypeKind.Unmodeled:
                                                soa_de_declined <- true
                                            else:
                                                soa_de_column: LLVMValueRef = LLVMBuildStructGEP2(builder, soa_iter_llvm, soa_iter_base, soa_de_index.u32(), "soa.de.col")
                                                soa_de_items: LLVMValueRef = LLVMBuildLoad2(builder, LLVMPointerTypeInContext(ctx, 0), LLVMBuildStructGEP2(builder, darray_llvm_type(structs, ctx), soa_de_column, 0, "soa.de.items.ptr"), "soa.de.items")
                                                soa_de_offsets: mutable darray[LLVMValueRef] = [LLVMBuildLoad2(builder, soa_iter_i64, soa_iter_index, "soa.de.at")]
                                                soa_de_offset_pointer: void& = (&soa_de_offsets[0]).cast[void&] can Unsafe.PointerCast
                                                soa_de_llvm: LLVMTypeRef = llvm_type_of(soa_de_type, structs, ctx)
                                                soa_de_element: LLVMValueRef = LLVMBuildGEP2(builder, soa_de_llvm, soa_de_items, soa_de_offset_pointer, 1, "soa.de.elem")
                                                soa_de_storage: mutable darray[u8] = []
                                                soa_de_local: LLVMValueRef = build_entry_alloca(builder, soa_de_llvm, sview_to_cstr(for_variables[soa_de_index], soa_de_storage))
                                                _ = LLVMBuildStore(builder, LLVMBuildLoad2(builder, soa_de_llvm, soa_de_element, "soa.de.value"), soa_de_local)
                                                declare_local(local_scope, for_variables[soa_de_index], soa_de_local, soa_de_type)
                                        EmitStatus.Declined return if soa_de_declined
                                    if soa_iter_enumerated:
                                        soa_iter_index_storage: mutable darray[u8] = []
                                        soa_iter_index_slot: LLVMValueRef = build_entry_alloca(builder, soa_iter_i64, sview_to_cstr(for_variables[0], soa_iter_index_storage))
                                        _ = LLVMBuildStore(builder, LLVMBuildLoad2(builder, soa_iter_i64, soa_iter_index, "soa.iter.at.bind"), soa_iter_index_slot)
                                        declare_local(local_scope, for_variables[0], soa_iter_index_slot, ValueType{kind: TypeKind.Signed, bits: 64})
                                    # A DESTRUCTURED head binds columns, not a row view, so it pushes
                                    # a name nothing can reference (the binders are real locals).
                                    structs.soa_row_binder_names <- structs.soa_row_binder_names.push("" if soa_iter_destructured else (for_variables[1] if soa_iter_enumerated else for_variables[0]))
                                    structs.soa_row_binder_slots <- structs.soa_row_binder_slots.push(soa_iter_type.bits)
                                    structs.soa_row_binder_bases <- structs.soa_row_binder_bases.push(soa_iter_base)
                                    structs.soa_row_binder_indexes <- structs.soa_row_binder_indexes.push(soa_iter_index)
                                    loops.exits <- loops.exits.push(soa_iter_done)
                                    loops.defer_marks <- loops.defer_marks.push(local_scope.deferred.count)
                                    loops.continues <- loops.continues.push(soa_iter_step)
                                    soa_iter_status: EmitStatus = emit_statements_scoped(for_body, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)
                                    _ = loops.exits.pop()
                                    _ = loops.defer_marks.pop()
                                    _ = loops.continues.pop()
                                    structs.soa_row_binder_names <- structs.soa_row_binder_names.truncate(structs.soa_row_binder_names.count - 1)
                                    structs.soa_row_binder_slots <- structs.soa_row_binder_slots.truncate(structs.soa_row_binder_slots.count - 1)
                                    structs.soa_row_binder_bases <- structs.soa_row_binder_bases.truncate(structs.soa_row_binder_bases.count - 1)
                                    structs.soa_row_binder_indexes <- structs.soa_row_binder_indexes.truncate(structs.soa_row_binder_indexes.count - 1)
                                    EmitStatus.Declined return if soa_iter_status == EmitStatus.Declined
                                    branch_if_open(soa_iter_status, builder, soa_iter_step)
                                    LLVMPositionBuilderAtEnd(builder, soa_iter_step)
                                    soa_iter_next: LLVMValueRef = LLVMBuildLoad2(builder, soa_iter_i64, soa_iter_index, "soa.iter.at.next")
                                    _ = LLVMBuildStore(builder, LLVMBuildSub(builder, soa_iter_next, LLVMConstInt(soa_iter_i64, 1, 0), "soa.iter.dec") if soa_iter_reversed else LLVMBuildAdd(builder, soa_iter_next, LLVMConstInt(soa_iter_i64, 1, 0), "soa.iter.inc"), soa_iter_index)
                                    _ = LLVMBuildBr(builder, soa_iter_cond)
                                    LLVMPositionBuilderAtEnd(builder, soa_iter_done)
                                    return EmitStatus.Open
                                return EmitStatus.Declined
                    # `for k, v in d` — DICT ITERATION over the std DynDict (a LIBRARY type; its
                    # layout is `items: DictBucket&? , count, used, capacity, arena`, with
                    # DictBucket = `key, value, state:u8` (state 1 == occupied)). Walk the raw
                    # bucket array 0..<capacity, bind k/v only for occupied slots. Mirrors stage0's
                    # two-binder iter loop over dict entries.
                    # `for chunk in chunks:` — walking a ChunksExactView. The count is the struct's
                    # third field and each chunk is the same view the `chunks[i]` read builds, so
                    # the loop only supplies the index.
                    if for_variables.count == 1 and for_bind == "":
                        ce_recv: ValueType = expression_type(for_iterable, local_scope, fns, structs, generics)
                        if ce_recv.kind == TypeKind.Struct and synthesized_struct_base_is(structs, ce_recv, "ChunksExactView"):
                            ce_view_type: ValueType = copied_type(structs.field_types[structs.field_start[ce_recv.bits.usize()]])
                            ce_element: ValueType = view_element_of(ce_view_type, structs)
                            EmitStatus.Declined return if ce_element.kind == TypeKind.Unmodeled
                            if emit_expression(for_iterable, ce_recv, local_scope, fns, structs, generics, runtime, m, ctx, builder) is ce_agg:
                                ce_i64: LLVMTypeRef = LLVMInt64TypeInContext(ctx)
                                ce_view_llvm: LLVMTypeRef = llvm_type_of(ce_view_type, structs, ctx)
                                ce_base: LLVMValueRef = LLVMBuildExtractValue(builder, ce_agg, 0, "ce.base")
                                ce_len: LLVMValueRef = LLVMBuildExtractValue(builder, ce_agg, 1, "ce.len")
                                ce_count: LLVMValueRef = LLVMBuildExtractValue(builder, ce_agg, 2, "ce.count")
                                ce_data: LLVMValueRef = LLVMBuildExtractValue(builder, ce_base, 0, "ce.data")
                                ce_index: LLVMValueRef = build_entry_alloca(builder, ce_i64, "ce.i")
                                _ = LLVMBuildStore(builder, LLVMConstInt(ce_i64, 0, 0), ce_index)
                                ce_storage: mutable darray[u8] = []
                                ce_bind: LLVMValueRef = build_entry_alloca(builder, ce_view_llvm, sview_to_cstr(for_variables[0], ce_storage))
                                declare_local(local_scope, for_variables[0], ce_bind, ce_view_type)
                                ce_function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                                ce_cond: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, ce_function, "ce.cond")
                                ce_bodyb: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, ce_function, "ce.body")
                                ce_step: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, ce_function, "ce.step")
                                ce_exit: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, ce_function, "ce.exit")
                                _ = LLVMBuildBr(builder, ce_cond)
                                LLVMPositionBuilderAtEnd(builder, ce_cond)
                                ce_cur: LLVMValueRef = LLVMBuildLoad2(builder, ce_i64, ce_index, "ce.cur")
                                # 40 = SLT.
                                _ = LLVMBuildCondBr(builder, LLVMBuildICmp(builder, 40, ce_cur, ce_count, "ce.more"), ce_bodyb, ce_exit)
                                LLVMPositionBuilderAtEnd(builder, ce_bodyb)
                                ce_offsets: mutable darray[LLVMValueRef] = [LLVMBuildMul(builder, ce_cur, ce_len, "ce.offset")]
                                ce_offsets_pointer: void& = (&ce_offsets[0]).cast[void&] can Unsafe.PointerCast
                                ce_at: LLVMValueRef = LLVMBuildGEP2(builder, llvm_type_of(ce_element, structs, ctx), ce_data, ce_offsets_pointer, 1, "ce.at")
                                ce_chunk: mutable LLVMValueRef = LLVMGetUndef(ce_view_llvm)
                                ce_chunk <- LLVMBuildInsertValue(builder, ce_chunk, ce_at, 0, "ce.chunk.data")
                                ce_chunk <- LLVMBuildInsertValue(builder, ce_chunk, ce_len, 1, "ce.chunk.len")
                                _ = LLVMBuildStore(builder, ce_chunk, ce_bind)
                                loops.exits <- loops.exits.push(ce_exit)
                                loops.defer_marks <- loops.defer_marks.push(local_scope.deferred.count)
                                loops.continues <- loops.continues.push(ce_step)
                                ce_status: EmitStatus = emit_statements_scoped(for_body, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)
                                _ = loops.exits.pop()
                                _ = loops.defer_marks.pop()
                                _ = loops.continues.pop()
                                EmitStatus.Declined return if ce_status == EmitStatus.Declined
                                branch_if_open(ce_status, builder, ce_step)
                                LLVMPositionBuilderAtEnd(builder, ce_step)
                                _ = LLVMBuildStore(builder, LLVMBuildAdd(builder, LLVMBuildLoad2(builder, ce_i64, ce_index, "ce.next.cur"), LLVMConstInt(ce_i64, 1, 0), "ce.next"), ce_index)
                                _ = LLVMBuildBr(builder, ce_cond)
                                LLVMPositionBuilderAtEnd(builder, ce_exit)
                                return EmitStatus.Open
                            return EmitStatus.Declined
                    # `for {a, b} in items:` — DESTRUCTURED struct elements. The brace head parses
                    # as a plain multi-binder loop, so N binders over a container of STRUCTS means
                    for_shape_matched: mutable bool = false
                    for_shape_value: EmitStatus = emit_statement_for_iterable_shapes(for_bind, for_variables, for_iterable, for_body, for_line, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder, &for_shape_matched)
                    for_shape_value return if for_shape_matched
                    return EmitStatus.Declined
                _:
                    pass
            handled <- false
            return EmitStatus.Declined

include "./codegen_stmt_for_shapes.elisa"
