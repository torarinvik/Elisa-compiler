# Stage1 backend — parameter/function ATTRIBUTES: noalias, disjointness facts, branch hints.
# Part of `module Backend` (see codegen.elisa); split out to keep each file short.

extend Backend:
    private:
        def add_parameter_attribute(fn: LLVMValueRef, index: u32, attr_name: sview, ctx: LLVMContextRef) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            return if attr_name == ""
            name_storage: mutable darray[u8] = []
            attr_cstr: cstr = sview_to_cstr(attr_name, name_storage)
            kind: u32 = LLVMGetEnumAttributeKindForName(attr_cstr, sview_len(attr_name))
            return if kind == 0
            attribute: LLVMAttributeRef = LLVMCreateEnumAttribute(ctx, kind, 0)
            LLVMAddAttributeAtIndex(fn, index, attribute)




        # Type-valued LLVM ABI attributes (currently sret) must be attached to both the
        # declaration and every call site. Keeping this beside the ordinary enum-attribute
        # helper prevents a hidden ABI pointer from being emitted without its corresponding
        # LLVM contract.
        def add_type_parameter_attribute(fn: LLVMValueRef, index: u32, attr_name: sview, attr_type: LLVMTypeRef, ctx: LLVMContextRef) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            return if attr_name == "" or attr_type == zeroed
            name_storage: mutable darray[u8] = []
            attr_cstr: cstr = sview_to_cstr(attr_name, name_storage)
            kind: u32 = LLVMGetEnumAttributeKindForName(attr_cstr, sview_len(attr_name))
            return if kind == 0
            attribute: LLVMAttributeRef = LLVMCreateTypeAttribute(ctx, kind, attr_type)
            LLVMAddAttributeAtIndex(fn, index, attribute)




        def add_call_type_attribute(call: LLVMValueRef, index: u32, attr_name: sview, attr_type: LLVMTypeRef, ctx: LLVMContextRef) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            return if attr_name == "" or attr_type == zeroed
            name_storage: mutable darray[u8] = []
            attr_cstr: cstr = sview_to_cstr(attr_name, name_storage)
            kind: u32 = LLVMGetEnumAttributeKindForName(attr_cstr, sview_len(attr_name))
            return if kind == 0
            attribute: LLVMAttributeRef = LLVMCreateTypeAttribute(ctx, kind, attr_type)
            LLVMAddCallSiteAttribute(call, index, attribute)




        def type_contains_token(expression: Expr, wanted: TokenKind) -> bool can[Abort.Panic]:
            can Abort.Panic:
                return match expression:
                    Expr.Unary(operator, operand, line): true if operator == wanted else type_contains_token(operand, wanted)
                    Expr.Binary(left, operator, right, line): type_contains_token(left, wanted) or type_contains_token(right, wanted)
                    Expr.Paren(inner, line): type_contains_token(inner, wanted)
                    Expr.Refinement(base, predicate, line): type_contains_token(base, wanted)
                    _: false




        def noalias_pointee_eligible(value_type: ValueType, structs: mutable StructTable&) -> bool can[Abort.Panic]:
            can Abort.Panic:
                false return if value_type.kind != TypeKind.Ref or ref_is_heap_ref(value_type, structs)
                pointee: ValueType = ref_target_of(value_type, structs)
                # Mutable darray references are forwarded through nested checker/runtime
                # calls, so an ABI-level noalias promise would be unsound for them.
                return is_numeric_type(pointee)




            # Stamp noalias only on the stage0-proven scalar subset. Darray references,
            # structs, views, void, heap, and immutable references
            # remain deliberately unannotated.
        def apply_noalias_parameter_attributes(fn: LLVMValueRef, params: darray[Ast::ParamDecl], parameter_base: u32, structs: mutable StructTable&, ctx: LLVMContextRef) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                return if not noalias_mutable_refs_enabled()
                parameter_index: mutable usize = 0
                for parameter in params |parameter_index, fn, parameter_base, structs, ctx|:
                    parameter_type: ValueType = parameter_value_type(parameter.type_expression, structs)
                    if parameter_type.kind == TypeKind.Ref and type_contains_token(parameter.type_expression, TokenKind.Mutable) and type_contains_token(parameter.type_expression, TokenKind.Ampersand) and noalias_pointee_eligible(parameter_type, structs):
                        add_parameter_attribute(fn, parameter_base + parameter_index.u32(), "noalias", ctx)
                    parameter_index <- parameter_index + 1




        def finish_float_instruction(value: LLVMValueRef, fast_math: bool) -> LLVMValueRef:
            LLVMSetFastMathFlags(value, 127) if fast_math
            return value




        def add_function_string_attribute(fn: LLVMValueRef, key: sview, value: sview, ctx: LLVMContextRef) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            return if key == "" or value == ""
            key_storage: mutable darray[u8] = []
            value_storage: mutable darray[u8] = []
            key_cstr: cstr = sview_to_cstr(key, key_storage)
            value_cstr: cstr = sview_to_cstr(value, value_storage)
            attribute: LLVMAttributeRef = LLVMCreateStringAttribute(ctx, key_cstr, sview_len(key).u32(), value_cstr, sview_len(value).u32())
            LLVMAddAttributeAtIndex(fn, 4294967295, attribute)




        def branch_hint_for(structs: StructTable&, line: u32) -> sview can[Abort.Panic]:
            for index in 0..<structs.branch_hint_lines.count |structs, line|:
                if structs.branch_hint_lines[index] == line:
                    return structs.branch_hint_kinds[index]
            return ""

include "./codegen_disjoint_proof.elisa"
include "./codegen_disjoint_query.elisa"
include "./codegen_alias_metadata.elisa"
