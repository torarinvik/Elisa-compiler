# Stage1 backend — parameter/function ATTRIBUTES: noalias, disjointness facts, branch hints.
# Part of `module Backend` (see codegen.elisa); split out to keep each file short.

extend Backend:
    private:
        # Apply after body emission so generated helpers are covered too. External
        # declarations have no code here and must not inherit this build policy.
        def apply_requested_frame_pointers(m: LLVMModuleRef, ctx: LLVMContextRef) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            return if not keep_frame_pointer_enabled()
            function: mutable LLVMValueRef? = LLVMGetFirstFunction(m)
            while function is handle:
                if LLVMGetFirstBasicBlock(handle) is body:
                    add_function_string_attribute(handle, "frame-pointer", "all", ctx)
                function <- LLVMGetNextFunction(handle)


        def add_parameter_attribute(fn: LLVMValueRef, index: u32, attr_name: sview, ctx: LLVMContextRef) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            return if attr_name == ""
            name_storage: mutable darray[u8] = []
            attr_cstr: cstr = sview_to_cstr(attr_name, name_storage)
            kind: u32 = LLVMGetEnumAttributeKindForName(attr_cstr, attr_name.len)
            return if kind == 0
            attribute: LLVMAttributeRef = LLVMCreateEnumAttribute(ctx, kind, 0)
            LLVMAddAttributeAtIndex(fn, index, attribute)




        # Type-valued LLVM ABI attributes (currently sret) must be attached to both the
        # declaration and every call site. Keeping this beside the ordinary enum-attribute
        # helper prevents a hidden ABI pointer from being emitted without its corresponding
        # LLVM contract.
        def add_type_parameter_attribute(fn: LLVMValueRef, index: u32, attr_name: sview, attr_type: LLVMTypeRef, ctx: LLVMContextRef) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            return if attr_name == "" or attr_type == zeroed
            name_storage: mutable darray[u8] = []
            attr_cstr: cstr = sview_to_cstr(attr_name, name_storage)
            kind: u32 = LLVMGetEnumAttributeKindForName(attr_cstr, attr_name.len)
            return if kind == 0
            attribute: LLVMAttributeRef = LLVMCreateTypeAttribute(ctx, kind, attr_type)
            LLVMAddAttributeAtIndex(fn, index, attribute)




        def add_call_type_attribute(call: LLVMValueRef, index: u32, attr_name: sview, attr_type: LLVMTypeRef, ctx: LLVMContextRef) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            return if attr_name == "" or attr_type == zeroed
            name_storage: mutable darray[u8] = []
            attr_cstr: cstr = sview_to_cstr(attr_name, name_storage)
            kind: u32 = LLVMGetEnumAttributeKindForName(attr_cstr, attr_name.len)
            return if kind == 0
            attribute: LLVMAttributeRef = LLVMCreateTypeAttribute(ctx, kind, attr_type)
            LLVMAddCallSiteAttribute(call, index, attribute)




        def type_contains_token(expression: Expr, wanted: TokenKind) -> bool can[Abort.Panic]:
            can Abort.Panic:
                return match expression:
                    Expr.Unary(operator, operand, line): true if operator == wanted else type_contains_token(operand, wanted)
                    Expr.Binary(left, operator, right, line): type_contains_token(left, wanted) or type_contains_token(right, wanted)
                    Expr.Paren(inner, line): type_contains_token(inner, wanted)
                    Expr.Refinement(base, predicate, line): type_contains_token(base, wanted)
                    _: false


        # A mutable marker grants write capability at the reference layer it
        # directly qualifies. Stop at the first `&`: a mutable inner pointer
        # in `(mutable T&) &` must not make the outer readonly reference mutable.
        def type_outer_reference_is_mutable(expression: Expr) -> bool can[Abort.Panic]:
            can Abort.Panic:
                match expression:
                    Expr.Unary(operator, operand, line):
                        return true if operator == TokenKind.Mutable
                        return false if operator == TokenKind.Ampersand
                        return type_outer_reference_is_mutable(operand)
                    Expr.Binary(left, operator, right, line):
                        return type_outer_reference_is_mutable(left)
                    Expr.Paren(inner, line):
                        return type_outer_reference_is_mutable(inner)
                    Expr.Refinement(base, predicate, line):
                        return type_outer_reference_is_mutable(base)
                    _:
                        return false




        def noalias_pointee_eligible(value_type: ValueType, structs: mutable StructTable&) -> bool can[Abort.Panic]:
            can Abort.Panic:
                return false if value_type.kind != TypeKind.Ref or ref_is_heap_ref(value_type, structs)
                pointee: ValueType = ref_target_of(value_type, structs)
                # Mutable darray references are forwarded through nested checker/runtime
                # calls, so an ABI-level noalias promise would be unsound for them.
                return is_numeric_type(pointee)




            # Stamp noalias only on the stage0-proven scalar subset. Darray references,
            # structs, views, void, heap, and immutable references
            # remain deliberately unannotated.
        def apply_noalias_parameter_attributes(fn: LLVMValueRef, params: darray[Ast::ParamDecl], parameter_base: u32, structs: mutable StructTable&, ctx: LLVMContextRef) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                return if not structs.target.noalias_mutable_refs
                parameter_index: mutable usize = 0
                for parameter in params |parameter_index, fn, parameter_base, structs, ctx|:
                    parameter_type: ValueType = parameter_decl_value_type(parameter, params, structs)
                    if parameter_type.kind == TypeKind.Ref and type_outer_reference_is_mutable(parameter.type_expression) and noalias_pointee_eligible(parameter_type, structs):
                        add_parameter_attribute(fn, parameter_base + parameter_index.u32(), "noalias", ctx)
                    parameter_index <- parameter_index + 1


        # The mutable-reference noalias hint is proved only for checked in-module calls.
        # A C caller can pass the same address for two parameters, including through an
        # export wrapper that forwards those pointers unchanged. Remove the generated
        # parameter contract from any such ABI boundary before LLVM optimization.
        def remove_noalias_parameter_attributes(fn: LLVMValueRef) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            kind_storage: mutable darray[u8] = []
            kind_name: cstr = sview_to_cstr("noalias", kind_storage)
            kind: u32 = LLVMGetEnumAttributeKindForName(kind_name, 7.usize())
            return if kind == 0
            parameter_count: usize = LLVMCountParams(fn).usize()
            for parameter_offset in 0..<parameter_count |fn, kind|:
                LLVMRemoveEnumAttributeAtIndex(fn, (parameter_offset + 1.usize()).u32(), kind)


        # Run after export linkage is finalized. This covers direct exports, main and
        # test-visible definitions, and O0 builds where otherwise-private helpers remain
        # externally linked. Internal-only functions retain the optimization contract.
        def remove_external_noalias_parameter_attributes(m: LLVMModuleRef) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            function: mutable LLVMValueRef? = LLVMGetFirstFunction(m)
            while function is handle:
                linkage: u32 = LLVMGetLinkage(handle)
                remove_noalias_parameter_attributes(handle) if linkage != 8 and linkage != 9
                function <- LLVMGetNextFunction(handle)




        def finish_float_instruction(value: LLVMValueRef, fast_math: bool) -> LLVMValueRef:
            LLVMSetFastMathFlags(value, 127) if fast_math
            return value




        def add_function_string_attribute(fn: LLVMValueRef, key: sview, value: sview, ctx: LLVMContextRef) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            return if key == "" or value == ""
            key_storage: mutable darray[u8] = []
            value_storage: mutable darray[u8] = []
            key_cstr: cstr = sview_to_cstr(key, key_storage)
            value_cstr: cstr = sview_to_cstr(value, value_storage)
            attribute: LLVMAttributeRef = LLVMCreateStringAttribute(ctx, key_cstr, key.len.u32(), value_cstr, value.len.u32())
            LLVMAddAttributeAtIndex(fn, 4294967295, attribute)




        def branch_hint_for(structs: StructTable&, line: u32) -> sview can[Abort.Panic]:
            for index in 0..<structs.annotations.branch_hint_lines.count |structs, line|:
                if structs.annotations.branch_hint_lines[index] == line:
                    return structs.annotations.branch_hint_kinds[index]
            return ""

include "./codegen_disjoint_proof.elisa"
include "./codegen_disjoint_query.elisa"
include "./codegen_alias_metadata.elisa"
