# Stage1 backend — questions an assignment asks about a PLACE: whether two expressions name the
# same one, whether an expression threads its expected type down, and whether a comprehension
# is one of the two folds that already yields an optional.
# Part of `module Backend` (see codegen.elisa).

extend Backend:
    private:


        # Whether an expression threads its `expected` type down to sub-expressions rather
        # than producing a value directly. Such a form must NOT be implicitly wrapped: its
        # ARMS each wrap themselves, which is what makes `42 if flag else null` work.
        def propagates_expected(expression: Expr) -> bool can[Abort.Panic]:
            can Abort.Panic:
                return match expression:
                    Expr.If(condition, then_expression, else_expression, line): true
                    Expr.Match(scrutinee, arms, match_line): true
                    Expr.Paren(inner, paren_line): propagates_expected(inner)
                    _: false




            # Whether two expressions name the SAME assignable place — `d` and `d`, or
            # `table.name_primary` and `table.name_primary`. Syntactic and deliberately narrow:
            # only Ident roots and field chains, so it can never claim two different places are
            # one. Used to recognise the in-place reassignment form `PLACE <- PLACE.method(…)`.
        def same_assign_place(left: Expr, right: Expr) -> bool can[Abort.Panic]:
            can Abort.Panic:
                match left:
                    Expr.Ident(left_name, left_line):
                        return match right:
                            Expr.Ident(right_name, right_line): left_name == right_name
                            _: false
                    Expr.Field(left_object, left_field, left_field_line):
                        match right:
                            Expr.Field(right_object, right_field, right_field_line):
                                return false if left_field != right_field
                                return same_assign_place(left_object, right_object)
                            _:
                                return false
                    _:
                        return false




            # Whether `expression` is a `min`/`max` query — the two folds whose result is ALREADY
            # optional, because an iterable with no qualifying element has no extremum.
            #
            # The implicit optional wrap (emit_expression) re-emits at the PAYLOAD type and wraps,
            # which is right for every value form that produces a payload. min/max produce the
            # optional themselves, absence included, so they must be emitted at the optional type
            # instead — otherwise they arrive at emit_comprehension with `expected` = i64 and
            # decline. Keyed off the same line-keyed `__query` head marker the folds dispatch on.
        def comprehension_is_extremum(expression: Expr, structs: mutable StructTable&) -> bool can[Abort.Panic]:
            can Abort.Panic:
                match expression:
                    Expr.Comprehension(extremum_var, extremum_iterable, extremum_condition, extremum_body, extremum_line):
                        extremum_head: sview = query_head_for(extremum_line.line, extremum_var, structs)
                        # `first` belongs here for the same reason: it produces the optional
                        # itself (absent when nothing matches), so re-emitting at the payload type
                        # hands emit_comprehension `expected` = i64 and it declines.
                        return when extremum_head:
                            "min" | "max" | "first" -> true
                            _ -> false
                    _:
                        pass
                return false
