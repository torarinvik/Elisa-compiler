# Stage1 backend — the TYPE of an expression that reads a PLACE: an index, a field, a struct
# construction or record update, a refinement, and the calls whose result type comes from a
# signature. Continues the walk begun in codegen_expression_type.elisa, which covers the
# literal and operator forms; both answer WITHOUT emitting anything.
# Part of `module Backend` (see codegen.elisa).

extend Backend:
    private:
        # Return the type of the row the ordinary direct-call resolver would select.
        # A unique type match wins; otherwise only a unique argument shape may supply a
        # return type. Ambiguous or unresolved calls stay Unmodeled so callers do not
        # infer a return ABI from declaration order.
        def resolved_call_return_type(owner: sview, name: sview, arguments: darray[Expr]&, argument_names: darray[sview]&, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, depth: i64) -> ValueType can[Abort.Panic, Memory.Allocate]:
            index: mutable i64 = overload_index_for_call_args_at_depth(fns, owner, name, arguments, argument_names, local_scope, structs, generics, depth)
            index <- function_index_of_unique_call_shape(fns, owner, name, arguments, argument_names) if index < 0
            return copied_type(fns.returns[index.usize()]) if index >= 0 and index.usize() < fns.returns.count
            return unmodeled_type()
