# Stage1 backend — CONST-ENUM lookup and the pattern rewrites that desugar onto it: leading-dot
# shorthand, bare enum members, `expect … as SHAPE`, struct patterns as `is`-tests, and the
# bare-variant loop filter. Part of `module Backend` (see codegen.elisa).

extend Backend:
    private:


        # The owner stored for enum row `index`, or "" for a legacy/malformed row.
        # All owner columns are defensive because the table is also constructed by the
        # C-header path and older serialized callers may not have the parallel entry.
        def enum_owner_at(structs: StructTable&, index: usize) -> sview can[Abort.Panic]:
            return structs.const_enums.enum_owners[index] if index < structs.const_enums.enum_owners.count
            return ""




        # Resolve a const-enum name under an EXPLICIT owner. Unlike the old bare-name scan,
        # this cannot select another module's same-named enum and therefore cannot give a
        # member the wrong ordinal or backing width.
        def enum_index_of_owned(structs: StructTable&, owner: sview, name: sview) -> i64 can[Abort.Panic]:
            index: mutable i64 = name_chain_first(structs.const_enums.enum_name_buckets, structs.const_enums.enum_name_next, structs.const_enums.enum_names, name)
            while index >= 0 |index, structs, owner, name|:
                return index if enum_owner_at(structs, index.usize()) == owner
                index <- name_chain_next(structs.const_enums.enum_name_buckets, structs.const_enums.enum_name_next, structs.const_enums.enum_names, name, index)
            return -1




        # The index of const enum `name`, or -1. Resolution is lexical: the current module's
        # declaration wins, then a top-level declaration. A cross-module fallback is allowed
        # only when the name is globally unique; choosing the first row among two modules is a
        # silent wrong-answer bug for enums because the variant values are part of codegen.
        # Compare one byte range of a registered owner against a parsed module path. A
        # qualified enum head is an Expr.Scope tree, not a flat string: A::B::State is
        # Scope(Scope(Ident("A"), "B"), "State"). Keeping the comparison range-based avoids
        # allocating a joined owner name while still checking every path component.
        def sview_range_matches(source: sview, start: usize, end: usize, candidate: sview) -> bool can[Abort.Panic]:
            return false if end < start or end - start != candidate.len
            for offset in 0..<candidate.len |source, candidate, start|:
                return false if source[start + offset] != candidate[offset]
            return true



        def enum_scope_path_matches_range_mode(owner: sview, start: usize, end: usize, path: Expr, structs: StructTable&, resolve_aliases: bool) -> bool can[Abort.Panic]:
            can Abort.Panic:
                separator: mutable usize = end
                scan: mutable usize = start
                while scan + 1.usize() < end |scan, separator, owner|:
                    separator <- scan if owner[scan] == 58 and owner[scan + 1.usize()] == 58
                    scan <- scan + 1.usize()
                match path:
                    Expr.Ident(path_name, path_line):
                        source_offset: mutable u32 = Ast::expr_pos(path).offset
                        source_offset <- structs.visibility.current_source_offset if source_offset == 0
                        if resolve_aliases and source_offset != 0:
                            expected_owner: sview = string_view_slice(owner, start.i64(), end.i64())
                            return module_alias_path_matches_owner(path_name, expected_owner, structs.visibility.current_owner, source_offset, structs)
                        resolved_root: sview = module_alias_target(path_name, structs) if resolve_aliases else path_name
                        return sview_range_matches(owner, start, end, resolved_root)
                    Expr.Scope(path_base, path_name, path_line):
                        return false if:
                            separator == end or separator + 2.usize() >= end
                            not sview_range_matches(owner, separator + 2.usize(), end, path_name)
                        return enum_scope_path_matches_range_mode(owner, start, separator, path_base, structs, resolve_aliases)
                    _:
                        pass
                return false



        def enum_scope_path_matches_range(owner: sview, start: usize, end: usize, path: Expr, structs: StructTable&) -> bool can[Abort.Panic]:
            return enum_scope_path_matches_range_mode(owner, start, end, path, structs, true)


        # The source offset belongs to the root identifier of a qualified module path.
        def enum_scope_path_source_offset(path: Expr) -> u32 can[Abort.Panic]:
            match path:
                Expr.Ident(_, _):
                    return Ast::expr_pos(path).offset
                Expr.Scope(path_base, _, _):
                    return enum_scope_path_source_offset(path_base)
                _:
                    pass
            return 0


        # A module path may be relative to the function's enclosing module. Thus, inside
        # module Outer, Inner::State denotes the row owned by Outer::Inner, while an
        # explicit Outer::Inner::State is handled by the exact comparison above.
        def enum_scope_path_matches_enclosing(owner: sview, enclosing: sview, path: Expr, structs: StructTable&) -> bool can[Abort.Panic]:
            can Abort.Panic:
                prefix_length: usize = enclosing.len
                return false if:
                    prefix_length == 0 or owner.len <= prefix_length + 2.usize()
                    not sview_range_matches(owner, 0, prefix_length, enclosing)
                    owner[prefix_length] != 58 or owner[prefix_length + 1.usize()] != 58
                return enum_scope_path_matches_range(owner, prefix_length + 2.usize(), owner.len, path, structs)



        # Rank qualified paths by lexical specificity; absolute matches rank zero.
        # The nearest enclosing namespace must win regardless of registry row order.
        def enum_scope_path_rank(owner: sview, path: Expr, structs: StructTable&) -> i64 can[Abort.Panic]:
            enclosing: sview = structs.visibility.current_owner
            owner_length: usize = owner.len
            enclosing_length: usize = enclosing.len
            # Each candidate prefix used to rescan these same bytes. Cache their common
            # prefix once, then visit enclosing separators from nearest to farthest.
            common_limit: mutable usize = owner_length
            common_limit <- enclosing_length if enclosing_length < common_limit
            common_prefix: mutable usize = 0
            while common_prefix < common_limit |common_prefix, owner, enclosing|:
                break if owner[common_prefix] != enclosing[common_prefix]
                common_prefix <- common_prefix + 1.usize()
            prefix: mutable usize = enclosing_length
            while prefix > 0 |prefix, enclosing, owner, path, structs|:
                if owner_length > prefix + 2.usize() and common_prefix >= prefix:
                    if owner[prefix] == 58 and owner[prefix + 1.usize()] == 58:
                        return (prefix + 1.usize()).i64() if enum_scope_path_matches_range_mode(owner, prefix + 2.usize(), owner.len, path, structs, false)
                parent: mutable usize = 0
                separator_cursor: mutable usize = prefix - 1.usize()
                while separator_cursor > 0 |parent, separator_cursor, enclosing|:
                    separator_cursor <- separator_cursor - 1.usize()
                    if enclosing[separator_cursor] == 58 and enclosing[separator_cursor + 1.usize()] == 58:
                        parent <- separator_cursor
                        break
                prefix <- parent
            # A visible alias is resolved against the source position of this path. Give
            # that target above ancestor modules while leaving the current module's real
            # child module ahead of an alias with the same spelling.
            path_offset: mutable u32 = enum_scope_path_source_offset(path)
            path_offset <- structs.visibility.current_source_offset if path_offset == 0
            if path_offset != 0 and enum_scope_path_matches_range(owner, 0, owner_length, path, structs) and not enum_scope_path_matches_range_mode(owner, 0, owner_length, path, structs, false):
                return (enclosing_length + 1.usize()).i64() if enclosing_length == 0
                return enclosing_length.i64()
            return 0 if enum_scope_path_matches_range(owner, 0, owner_length, path, structs)
            return -1


        # Resolve a const-enum head while preserving an explicit module qualifier. The old
        # callers extracted only the leaf name from a qualified path, then called enum_index_of;
        # from a different module that either declined or silently selected another module's
        # same-named enum. This helper makes the owner part of the lookup and uses the same
        # lexical relative-path rule as function resolution.
        def enum_index_of_head(structs: mutable StructTable&, head: Expr) -> i64 can[Abort.Panic]:
            can Abort.Panic:
                match head:
                    Expr.Ident(head_name, head_line):
                        return enum_index_of(structs, head_name)
                    Expr.Scope(scope_base, scoped_name, scoped_line):
                        best: mutable i64 = -1
                        best_rank: mutable i64 = -1
                        enum_row: mutable i64 = name_chain_first(structs.const_enums.enum_name_buckets, structs.const_enums.enum_name_next, structs.const_enums.enum_names, scoped_name)
                        while enum_row >= 0 |enum_row, structs, scope_base, scoped_name, best, best_rank|:
                            candidate_owner: sview = enum_owner_at(structs, enum_row.usize())
                            if candidate_owner != "":
                                rank: i64 = enum_scope_path_rank(candidate_owner, scope_base, structs)
                                if rank > best_rank:
                                    best <- enum_row
                                    best_rank <- rank
                            enum_row <- name_chain_next(structs.const_enums.enum_name_buckets, structs.const_enums.enum_name_next, structs.const_enums.enum_names, scoped_name, enum_row)
                        return best
                    _:
                        pass
                return -1


        def enum_index_of(structs: StructTable&, name: sview) -> i64 can[Abort.Panic]:
            if structs.visibility.current_owner != "":
                owned: i64 = enum_index_of_owned(structs, structs.visibility.current_owner, name)
                return owned if owned >= 0
                # A lexical payload declaration shadows a foreign const namesake.
                return -1 if penum_index_of_owned(structs, structs.visibility.current_owner, name) >= 0
            top_level: i64 = enum_index_of_owned(structs, "", name)
            return top_level if top_level >= 0
            found: i64 = name_chain_first(structs.const_enums.enum_name_buckets, structs.const_enums.enum_name_next, structs.const_enums.enum_names, name)
            return -1 if found < 0
            return found if name_chain_next(structs.const_enums.enum_name_buckets, structs.const_enums.enum_name_next, structs.const_enums.enum_names, name, found) < 0
            return -1




        # The ORDINAL of `variant` in const enum `slot`, or -1. Callers that need the value
        # a member compiles to use this ordinal to index enum_variant_values; the value itself
        # may be -1, so it cannot also serve as the membership sentinel.
        def enum_ordinal_of(structs: mutable StructTable&, slot: usize, variant: sview) -> i64 can[Abort.Panic]:
            for offset in 0..<structs.const_enums.enum_variant_count[slot] |structs, slot, variant|:
                return offset.i64() if structs.const_enums.enum_variants[structs.const_enums.enum_variant_start[slot] + offset] == variant
            return -1




        # The name of the enum that owns leading-dot shorthand member `.variant`, or "".
        #
        # `.Variant` (Expr.ShorthandMember) names its enum from CONTEXT, but a const enum
        # erases to a plain Signed/Unsigned ValueType -- the scrutinee's type cannot say
        # which enum it came from. Resolve by variant NAME instead, and only when the answer
        # is UNAMBIGUOUS: exactly one CONST enum in the program declares a member with this
        # name. Two enums sharing a member name return "" and the caller declines, exactly as
        # it did before -- narrower than stage0's contextual typing, but never a WRONG enum.
        #
        # CONST enums only, deliberately: stage0 rejects the shorthand anywhere else, with
        # `shorthand member ".Circle" requires an expected const enum type` (read from its
        # own -emit llvm output on a payload-enum `is`). An earlier draft also searched the
        # payload-enum pool; that made `v is .Circle` compile and answer FALSE for a Square
        # where stage0's -emit obj answered true -- i.e. it turned a decline into a silent
        # divergence on a form stage0 does not even accept. Payload enums must keep
        # declining until there is an oracle worth matching.
        def shorthand_member_enum_name(structs: mutable StructTable&, variant: sview) -> sview can[Abort.Panic]:
            # Prefer the declaration in the function's module, then a top-level declaration.
            # Only the selected scope is allowed to contribute candidates; otherwise a
            # `.Complete` shorthand could silently bind to another module's enum.
            if structs.visibility.current_owner != "":
                found_owned: mutable sview = ""
                owned_matches: mutable i64 = 0
                for enum_index in 0..<structs.const_enums.enum_names.count |structs, variant, found_owned, owned_matches|:
                    continue if enum_owner_at(structs, enum_index) != structs.visibility.current_owner
                    continue if enum_ordinal_of(structs, enum_index, variant) < 0
                    found_owned <- structs.const_enums.enum_names[enum_index]
                    owned_matches <- owned_matches + 1
                    return "" if owned_matches > 1
                return found_owned if owned_matches == 1
                return "" if owned_matches > 1
                found_top: mutable sview = ""
                top_matches: mutable i64 = 0
                for enum_index in 0..<structs.const_enums.enum_names.count |structs, variant, found_top, top_matches|:
                    continue if enum_owner_at(structs, enum_index) != ""
                    continue if enum_ordinal_of(structs, enum_index, variant) < 0
                    found_top <- structs.const_enums.enum_names[enum_index]
                    top_matches <- top_matches + 1
                    return "" if top_matches > 1
                return found_top if top_matches == 1
                return "" if top_matches > 1
            found: mutable sview = ""
            matches: mutable i64 = 0
            for enum_index in 0..<structs.const_enums.enum_names.count |structs, variant, found, matches|:
                continue if enum_ordinal_of(structs, enum_index, variant) < 0
                found <- structs.const_enums.enum_names[enum_index]
                matches <- matches + 1
                return "" if matches > 1
            return found if matches == 1
            return ""




        # `value[RoutineFlag.Imported]` on a `Flags[T]` — a BIT TEST, not a container read.
        # Returns the member's ORDINAL, or -1 when this is not that shape. Recognised narrowly:
        # a struct (or ref to one) with exactly ONE unsigned field named `bits`, indexed by a
        # CONST-ENUM member. stage0 lowers it inline as `(bits & (1 << ordinal)) != 0` — the
        # names in its IR (`flags.bits` / `flags.hit` / `flags.has`) say the shape is built into
        # the compiler rather than user code.
        def flags_bit_test_ordinal(receiver: ValueType, index_expression: Expr, structs: mutable StructTable&) -> i64 can[Abort.Panic]:
            fbt_receiver: mutable ValueType = copied_type(receiver)
            fbt_receiver <- ref_target_of(fbt_receiver, structs) if fbt_receiver.kind == TypeKind.Ref
            return -1 if fbt_receiver.kind != TypeKind.Struct
            fbt_slot: usize = fbt_receiver.bits.usize()
            return -1 if:
                structs.records.field_count[fbt_slot] != 1.usize()
                structs.records.field_names[structs.records.field_start[fbt_slot]] != "bits"
            fbt_field: ValueType = copied_type(structs.records.field_types[structs.records.field_start[fbt_slot]])
            return -1 if fbt_field.kind != TypeKind.Unsigned
            # Both spellings are read directly rather than through
            # resolved_shorthand_member: that helper BUILDS an Expr and so is
            # region-polymorphic, which a plain i64-returning query cannot call.
            match index_expression:
                Expr.Field(fbt_head, fbt_variant, fbt_variant_line):
                    match fbt_head:
                        Expr.Ident(fbt_enum_name, fbt_enum_line):
                            fbt_enum: i64 = enum_index_of(structs, fbt_enum_name)
                            return enum_ordinal_of(structs, fbt_enum.usize(), fbt_variant) if fbt_enum >= 0
                        _:
                            pass
                _:
                    pass
            match index_expression:
                Expr.ShorthandMember(fbt_parts, fbt_short_line):
                    if fbt_parts.count == 1:
                        fbt_short_enum: sview = shorthand_member_enum_name(structs, fbt_parts[0])
                        if fbt_short_enum != "":
                            fbt_short_index: i64 = enum_index_of(structs, fbt_short_enum)
                            return enum_ordinal_of(structs, fbt_short_index.usize(), fbt_parts[0]) if fbt_short_index >= 0
                _:
                    pass
            return -1




        # Rewrite a leading-dot shorthand `.Variant` into the equivalent `Enum.Variant`
        # Field expression, so paths that only know the qualified spelling can emit it
        # unchanged. Returns the expression untouched when it is not a shorthand, or when
        # the owning enum is ambiguous/unknown (the caller then declines exactly as before).
        def resolved_shorthand_member(expression: Expr, structs: mutable StructTable&) -> Expr can[Abort.Panic]:
            match expression:
                Expr.ShorthandMember(rsm_parts, rsm_line):
                    if rsm_parts.count == 1:
                        rsm_enum: sview = shorthand_member_enum_name(structs, rsm_parts[0])
                        if rsm_enum != "":
                            return (Expr.Field((Expr.Ident(rsm_enum, rsm_line)), rsm_parts[0], rsm_line))
                _:
                    pass
            return expression




        # Rewrite an UNQUALIFIED const-enum member (`IDENT` in `kind in {.IF..=IDENT}`) into
        # `Enum.IDENT`. Only the SECOND bound of a range is ever written this way -- the first
        # carries the leading dot -- and stage0 resolves it from the range's element type.
        #
        # Two guards keep it from claiming ordinary identifiers: the name must NOT be a local
        # in scope (a range over variables, `x in {lo..=hi}`, must stay as it is), and exactly
        # ONE const enum must declare a member with that name. Anything else is returned
        # untouched and the caller declines exactly as before.
        def resolved_bare_enum_member(expression: Expr, local_scope: mutable Scope&, structs: mutable StructTable&) -> Expr can[Abort.Panic]:
            match expression:
                Expr.Ident(rbm_name, rbm_line):
                    if lookup_type(local_scope, rbm_name).kind == TypeKind.Unmodeled:
                        rbm_enum: sview = shorthand_member_enum_name(structs, rbm_name)
                        if rbm_enum != "":
                            return (Expr.Field((Expr.Ident(rbm_enum, rbm_line)), rbm_name, rbm_line))
                _:
                    pass
            return expression




