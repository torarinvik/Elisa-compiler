# Read-only name lookup over a registry name column: bucket chains over an indexed prefix
# of the rows plus a linear scan of the unindexed tail, exactly like
# codegen_function_name_index.elisa but over any `darray[sview]` column with its own three
# chain arrays. A walk visits every row whose name EQUALS the key, in ascending row order,
# so a caller that keeps its full predicate answers exactly what its old `0..<count` scan
# answered. A push site that forgets name_chain_extend only leaves rows in the tail.
# Names must not be rewritten in place; the indexed columns are append-only.
# Part of `module Backend` (see codegen.elisa).
extend Backend:
    private:
        const NAME_CHAIN_BUCKET_COUNT: usize = 4096
        const NAME_CHAIN_HASH_OFFSET: u64 = 14695981039346656037
        const NAME_CHAIN_HASH_PRIME: u64 = 1099511628211
        const NAME_CHAIN_NONE: i64 = -1

        def name_chain_bucket(name: sview) -> usize:
            hash: mutable u64 = NAME_CHAIN_HASH_OFFSET
            for index in 0..<sview_len(name) |hash, name|:
                hash <- (hash ^ sview_at(name, index).u64()) * NAME_CHAIN_HASH_PRIME
            return (hash % NAME_CHAIN_BUCKET_COUNT.u64()).usize()

        # Chain every row of NAMES not yet indexed (rebuilding if the column shrank).
        def name_chain_extend(buckets: mutable darray[i64]&, tails: mutable darray[i64]&, next: mutable darray[i64]&, names: darray[sview]&) -> void can[Abort.Panic, Memory.Allocate]:
            if buckets.count != NAME_CHAIN_BUCKET_COUNT or tails.count != NAME_CHAIN_BUCKET_COUNT or next.count > names.count:
                buckets.truncate(0)
                tails.truncate(0)
                next.truncate(0)
                for _ in 0..<NAME_CHAIN_BUCKET_COUNT |buckets, tails|:
                    buckets.push(NAME_CHAIN_NONE)
                    tails.push(NAME_CHAIN_NONE)
            while next.count < names.count |buckets, tails, next, names|:
                row: usize = next.count
                bucket: usize = name_chain_bucket(names[row])
                next.push(NAME_CHAIN_NONE)
                last_row: i64 = tails[bucket]
                if last_row >= 0:
                    next[last_row.usize()] <- row.i64()
                else:
                    buckets[bucket] <- row.i64()
                tails[bucket] <- row.i64()

        def name_chain_prefix(buckets: darray[i64]&, next: darray[i64]&, names: darray[sview]&) -> usize can[Abort.Panic]:
            return 0 if buckets.count != NAME_CHAIN_BUCKET_COUNT or next.count > names.count
            return next.count

        def name_chain_tail(names: darray[sview]&, name: sview, start: usize) -> i64 can[Abort.Panic]:
            for index in start..<names.count |names, name|:
                return index.i64() if names[index] == name
            return NAME_CHAIN_NONE

        def name_chain_from(next: darray[i64]&, names: darray[sview]&, name: sview, start: i64, prefix: usize) -> i64 can[Abort.Panic]:
            cursor: mutable i64 = start
            while cursor >= 0 |cursor, next, names, name|:
                return cursor if names[cursor.usize()] == name
                cursor <- next[cursor.usize()]
            return name_chain_tail(names, name, prefix)

        # The first row named NAME, or -1.
        def name_chain_first(buckets: darray[i64]&, next: darray[i64]&, names: darray[sview]&, name: sview) -> i64 can[Abort.Panic]:
            prefix: usize = name_chain_prefix(buckets, next, names)
            return name_chain_tail(names, name, 0) if prefix == 0
            return name_chain_from(next, names, name, buckets[name_chain_bucket(name)], prefix)

        # The next row after CURRENT named NAME, or -1.
        def name_chain_next(buckets: darray[i64]&, next: darray[i64]&, names: darray[sview]&, name: sview, current: i64) -> i64 can[Abort.Panic]:
            return NAME_CHAIN_NONE if current < 0
            prefix: usize = name_chain_prefix(buckets, next, names)
            if current.usize() < prefix:
                return name_chain_from(next, names, name, next[current.usize()], prefix)
            return name_chain_tail(names, name, current.usize() + 1)
