# Top-level operand separators for the EASM instruction subset.
module EasmOperandScan:
    public:
        const ASCII_COMMA: u8 = 44
        const ASCII_LEFT_PAREN: u8 = 40
        const ASCII_RIGHT_PAREN: u8 = 41
        const ASCII_DOLLAR: u8 = 36
        const ASCII_PERCENT: u8 = 37
        const ASCII_STAR: u8 = 42
        const ASCII_LEFT_BRACKET: u8 = 91
        const ASCII_SPACE: u8 = 32
        const ASCII_TAB: u8 = 9
        const ASCII_X: u8 = 120
        const ASCII_ZERO: u8 = 48
        const ASCII_NINE: u8 = 57
        const ASCII_ONE: u8 = 49
        const ASCII_TWO: u8 = 50
        const ASCII_THREE: u8 = 51
        const SCAN_STEP: usize = 1
        const INDIRECT_REGISTER_PREFIX_LENGTH: usize = 2
        const MAX_MODELED_OPERAND_COUNT: usize = 2
        const TOO_MANY_OPERANDS_SENTINEL: usize = 3

        @inline(always)
        def needs_arity_rejection(operand_count: usize) -> bool:
            ensure result == (operand_count > MAX_MODELED_OPERAND_COUNT)
            return operand_count > MAX_MODELED_OPERAND_COUNT

        @inline(always)
        def is_zero_operand_instruction(op: sview) -> bool:
            ensure result == (
                op == "ret" or op == "retq" or op == "cpuid" or op == "cld" or op == "std" or
                op == "lfence" or op == "rdtsc" or op == "pause" or op == "yield" or op == "isb" or
                op == "emms" or op == "vzeroall" or op == "trap"
            )
            return match op:
                "ret" | "retq" | "cpuid" | "cld" | "std": true
                "lfence" | "rdtsc" | "pause" | "yield" | "isb": true
                "emms" | "vzeroall" | "trap": true
                _: false

        @inline(always)
        def is_one_operand_instruction(op: sview) -> bool:
            ensure result == (
                op == "push" or op == "pushq" or op == "pop" or op == "popq" or
                op == "inc" or op == "incq" or op == "dec" or op == "decq" or
                op == "neg" or op == "negq" or op == "not" or op == "notq" or
                op == "call" or op == "callq" or op == "jmp" or op == "jmpq" or
                op == "je" or op == "jz" or op == "jne" or op == "jnz" or
                op == "jl" or op == "jle" or op == "jg" or op == "jge" or
                op == "jb" or op == "jbe" or op == "ja" or op == "jae" or
                op == "fldcw" or op == "fnstcw" or op == "stmxcsr" or op == "ldmxcsr"
            )
            return match op:
                "push" | "pushq" | "pop" | "popq": true
                "inc" | "incq" | "dec" | "decq" | "neg" | "negq" | "not" | "notq": true
                "call" | "callq" | "jmp" | "jmpq": true
                "je" | "jz" | "jne" | "jnz" | "jl" | "jle" | "jg" | "jge" | "jb" | "jbe" | "ja" | "jae": true
                "fldcw" | "fnstcw" | "stmxcsr" | "ldmxcsr": true
                _: false

        @inline(always)
        def is_two_operand_instruction(op: sview) -> bool:
            ensure result == (
                op == "mov" or op == "movq" or op == "movb" or op == "movw" or op == "movl" or
                op == "movsx" or op == "movsxd" or op == "movsbw" or op == "movsbl" or op == "movsbq" or
                op == "movswl" or op == "movswq" or op == "movslq" or op == "movzx" or op == "movzbw" or
                op == "movzbl" or op == "movzbq" or op == "movzwl" or op == "movzwq" or
                op == "lea" or op == "leaq" or op == "xchg" or op == "xchgl" or op == "xchgq" or
                op == "add" or op == "addq" or op == "sub" or op == "subq" or
                op == "and" or op == "andq" or op == "or" or op == "orq" or op == "xor" or op == "xorq" or
                op == "cmp" or op == "cmpq" or op == "test" or op == "testq" or op == "mrs"
            )
            return match op:
                "mov" | "movq" | "movb" | "movw" | "movl": true
                "movsx" | "movsxd" | "movsbw" | "movsbl" | "movsbq" | "movswl" | "movswq" | "movslq": true
                "movzx" | "movzbw" | "movzbl" | "movzbq" | "movzwl" | "movzwq": true
                "lea" | "leaq" | "xchg" | "xchgl" | "xchgq": true
                "add" | "addq" | "sub" | "subq": true
                "and" | "andq" | "or" | "orq" | "xor" | "xorq": true
                "cmp" | "cmpq" | "test" | "testq" | "mrs": true
                _: false

        @inline(always)
        def is_shift_instruction(op: sview) -> bool:
            ensure result == (
                op == "shl" or op == "shlq" or op == "sal" or op == "salq" or
                op == "shr" or op == "shrq" or op == "sar" or op == "sarq"
            )
            return match op:
                "shl" | "shlq" | "sal" | "salq" | "shr" | "shrq" | "sar" | "sarq": true
                _: false

        @inline(always)
        def operand_arity_supported(op: sview, operand_count: usize) -> bool:
            ensure result == (
                (is_zero_operand_instruction(op) and operand_count == 0) or
                (not is_zero_operand_instruction(op) and is_one_operand_instruction(op) and operand_count == 1) or
                (not is_zero_operand_instruction(op) and not is_one_operand_instruction(op) and is_two_operand_instruction(op) and operand_count == 2) or
                (not is_zero_operand_instruction(op) and not is_one_operand_instruction(op) and not is_two_operand_instruction(op) and is_shift_instruction(op) and (operand_count == 1 or operand_count == 2))
            )
            if is_zero_operand_instruction(op):
                return operand_count == 0
            if is_one_operand_instruction(op):
                return operand_count == 1
            if is_two_operand_instruction(op):
                return operand_count == 2
            if is_shift_instruction(op):
                return operand_count == 1 or operand_count == 2
            return false

        # MRS is the deliberately small AArch64 exception in the otherwise AT&T/x86
        # operand verifier. Its destination must be an X register (or XZR), and the
        # capability model currently exposes only the virtual counter register.
        def is_aarch64_mrs_form(result_register: sview, system_register: sview) -> bool:
            ensure result == (
                system_register == "cntvct_el0" and
                (result_register == "xzr" or
                    (result_register.len == 2 and result_register[0] == ASCII_X and
                        result_register[1] >= ASCII_ZERO and result_register[1] <= ASCII_NINE) or
                    (result_register.len == 3 and result_register[0] == ASCII_X and
                        (((result_register[1] == ASCII_ONE or result_register[1] == ASCII_TWO) and
                            result_register[2] >= ASCII_ZERO and result_register[2] <= ASCII_NINE) or
                            (result_register[1] == ASCII_THREE and result_register[2] == ASCII_ZERO)))
                )
            )
            if system_register != "cntvct_el0":
                return false
            if result_register == "xzr":
                return true
            if result_register.len == 2 and result_register[0] == ASCII_X:
                digit: u8 = result_register[1]
                return digit >= ASCII_ZERO and digit <= ASCII_NINE
            if result_register.len == 3 and result_register[0] == ASCII_X:
                tens: u8 = result_register[1]
                ones: u8 = result_register[2]
                return ((tens == ASCII_ONE and ones >= ASCII_ZERO and ones <= ASCII_NINE) or
                    (tens == ASCII_TWO and ones >= ASCII_ZERO and ones <= ASCII_NINE) or
                    (tens == ASCII_THREE and ones == ASCII_ZERO))
            return false

        @inline(always)
        def exact_register_form(operand: sview, register_name: sview) -> bool:
            ensure result == (
                (operand.len == register_name.len + SCAN_STEP and
                    operand.len > 0 and operand[0] == ASCII_PERCENT and
                    operand[SCAN_STEP:operand.len] == register_name) or
                (operand.len == register_name.len + INDIRECT_REGISTER_PREFIX_LENGTH and
                    operand.len >= INDIRECT_REGISTER_PREFIX_LENGTH and operand[0] == ASCII_STAR and
                    operand[1] == ASCII_PERCENT and
                    operand[INDIRECT_REGISTER_PREFIX_LENGTH:operand.len] == register_name)
            )
            return (
                (operand.len == register_name.len + SCAN_STEP and
                    operand.len > 0 and operand[0] == ASCII_PERCENT and
                    operand[SCAN_STEP:operand.len] == register_name) or
                (operand.len == register_name.len + INDIRECT_REGISTER_PREFIX_LENGTH and
                    operand.len >= INDIRECT_REGISTER_PREFIX_LENGTH and operand[0] == ASCII_STAR and
                    operand[1] == ASCII_PERCENT and
                    operand[INDIRECT_REGISTER_PREFIX_LENGTH:operand.len] == register_name)
            )

        @inline(always)
        def is_direct_control_target(op: sview, operand: sview, is_final_operand: bool) -> bool:
            ensure result == (
                is_final_operand and operand.len > 0 and
                operand[0] != ASCII_PERCENT and operand[0] != ASCII_DOLLAR and
                operand[0] != ASCII_STAR and operand[0] != ASCII_LEFT_PAREN and
                operand[0] != ASCII_LEFT_BRACKET and
                EasmTextScan::find(operand, ":") == operand.len and
                (op == "call" or op == "callq" or op == "jmp" or op == "jmpq" or
                    op == "je" or op == "jz" or op == "jne" or op == "jnz" or
                    op == "jl" or op == "jle" or op == "jg" or op == "jge" or
                    op == "jb" or op == "jbe" or op == "ja" or op == "jae")
            )
            return is_final_operand and operand.len > 0 and operand[0] != ASCII_PERCENT and operand[0] != ASCII_DOLLAR and operand[0] != ASCII_STAR and operand[0] != ASCII_LEFT_PAREN and operand[0] != ASCII_LEFT_BRACKET and EasmTextScan::find(operand, ":") == operand.len and (op == "call" or op == "callq" or op == "jmp" or op == "jmpq" or op == "je" or op == "jz" or op == "jne" or op == "jnz" or op == "jl" or op == "jle" or op == "jg" or op == "jge" or op == "jb" or op == "jbe" or op == "ja" or op == "jae")

        @inline(always)
        def rejects_unmodeled_operand_form(operand_present: bool, memory_address: bool, register_operand: bool, immediate_operand: bool, direct_control_target: bool) -> bool:
            ensure result == (
                operand_present and not memory_address and not register_operand and
                not immediate_operand and not direct_control_target
            )
            return operand_present and not memory_address and not register_operand and not immediate_operand and not direct_control_target

        @inline(always)
        def rejects_return_immediate(op: sview, immediate_operand: bool) -> bool:
            ensure result == (immediate_operand and (op == "ret" or op == "retq"))
            return immediate_operand and (op == "ret" or op == "retq")

        @inline(always)
        def rejects_unresolved_conditional_target(is_conditional_jump: bool, target_is_local: bool, direct_control_capability: bool, relocation_symbol_capability: bool) -> bool:
            ensure result == (
                is_conditional_jump and not target_is_local and
                not direct_control_capability and not relocation_symbol_capability
            )
            return is_conditional_jump and not target_is_local and not direct_control_capability and not relocation_symbol_capability

        @inline(always)
        def first_operand_byte(text: sview, from: usize) -> usize:
            requires from <= text.len
            ensure result >= from and result <= text.len
            ensure result == text.len or (
                text[result] != ASCII_SPACE and text[result] != ASCII_TAB
            )
            ensure (forall candidate in from..<result:
                text[candidate] == ASCII_SPACE or text[candidate] == ASCII_TAB
            )
            text_length: usize = text.len
            index: mutable usize = from
            while index < text_length |index, from, text, text_length|:
                decreases text_length - index
                invariant from <= index and index <= text_length
                invariant (forall candidate in from..<index:
                    text[candidate] == ASCII_SPACE or text[candidate] == ASCII_TAB
                )
                return index if text[index] != ASCII_SPACE and text[index] != ASCII_TAB
                index <- index + SCAN_STEP
            return text_length

        # Find the next comma outside the sole parenthesized group supported by the EASM
        # address parser. A missing result uses text.length, matching the verified find helper.
        @inline(always)
        def next_top_level_separator(text: sview, from: usize, has_address: bool, open: usize, close: usize) -> usize:
            requires from <= text.len and open <= text.len and close <= text.len
            ensure result <= text.len
            ensure result == text.len or (
                result >= from and text[result] == ASCII_COMMA and
                (not has_address or result < open or result > close)
            )
            ensure (forall candidate in from..<result:
                text[candidate] != ASCII_COMMA or
                (has_address and candidate >= open and candidate <= close)
            )
            text_length: usize = text.len
            prefix_end: usize = open if has_address else text_length
            if from < prefix_end:
                prefix: sview = text[from:prefix_end]
                prefix_comma: usize = EasmTextScan::find(prefix, ",")
                if prefix_comma < prefix.len:
                    return from + prefix_comma
            if has_address:
                after_address: mutable usize = close + SCAN_STEP
                after_address <- from if from > after_address
                if after_address < text_length:
                    suffix: sview = text[after_address:text_length]
                    suffix_comma: usize = EasmTextScan::find(suffix, ",")
                    if suffix_comma < suffix.len:
                        return after_address + suffix_comma
            return text_length

        # Parentheses delimit an AT&T base/index/scale tuple. Nested, repeated, or unbalanced
        # groups are outside the verifier's address grammar and must be rejected.
        @inline(always)
        def scan_instruction(text: sview) -> (start: usize, count: usize, first_separator: usize, last_separator: usize, has_address_group: bool, address_open: usize, address_close: usize, valid: bool):
            ensure result.start <= text.len
            ensure result.count <= TOO_MANY_OPERANDS_SENTINEL
            ensure result.first_separator <= text.len and result.last_separator <= text.len
            ensure result.address_open <= text.len and result.address_close <= text.len
            ensure result.valid or (
                result.count == 0 and result.first_separator == text.len and result.last_separator == text.len and
                not result.has_address_group and result.address_open == text.len and result.address_close == text.len
            )
            ensure result.valid and result.count == 0 implies (
                result.start == text.len and result.first_separator == text.len and
                result.last_separator == text.len and not result.has_address_group and
                result.address_open == text.len and result.address_close == text.len
            )
            ensure result.valid implies result.start == first_operand_byte(text, EasmTextScan::first_space(text).usize())
            ensure result.valid and not result.has_address_group implies (
                result.address_open == text.len and result.address_close == text.len
            )
            ensure result.valid and not result.has_address_group implies (
                forall candidate in result.start..<text.len:
                    text[candidate] != ASCII_LEFT_PAREN and text[candidate] != ASCII_RIGHT_PAREN
            )
            ensure result.valid and result.has_address_group implies (
                result.start <= result.address_open and result.address_open < result.address_close and
                result.address_close < text.len and
                text[result.address_open] == ASCII_LEFT_PAREN and
                text[result.address_close] == ASCII_RIGHT_PAREN
            )
            ensure result.valid and result.has_address_group implies (
                forall candidate in result.start..<result.address_open:
                    text[candidate] != ASCII_LEFT_PAREN and text[candidate] != ASCII_RIGHT_PAREN
            )
            ensure result.valid and result.has_address_group implies (
                forall candidate in result.address_open + SCAN_STEP..<result.address_close:
                    text[candidate] != ASCII_LEFT_PAREN and text[candidate] != ASCII_RIGHT_PAREN
            )
            ensure result.valid and result.has_address_group implies (
                forall candidate in result.address_close + SCAN_STEP..<text.len:
                    text[candidate] != ASCII_LEFT_PAREN and text[candidate] != ASCII_RIGHT_PAREN
            )
            ensure result.valid and result.count == 1 implies (
                result.first_separator == text.len and result.last_separator == text.len and
                result.start < text.len and
                first_operand_byte(text[result.start:text.len], 0.usize()) < (text[result.start:text.len]).len and
                next_top_level_separator(text, result.start, result.has_address_group, result.address_open, result.address_close) == text.len
            )
            ensure result.valid and result.count == 2 implies (
                result.first_separator < text.len and result.first_separator == result.last_separator and
                result.first_separator == next_top_level_separator(text, result.start, result.has_address_group, result.address_open, result.address_close) and
                next_top_level_separator(text, result.first_separator + SCAN_STEP, result.has_address_group, result.address_open, result.address_close) == text.len and
                first_operand_byte(text[result.start:result.first_separator], 0.usize()) < (text[result.start:result.first_separator]).len and
                first_operand_byte(text[result.first_separator + SCAN_STEP:text.len], 0.usize()) < (text[result.first_separator + SCAN_STEP:text.len]).len
            )
            ensure result.valid and result.count == TOO_MANY_OPERANDS_SENTINEL implies (
                result.first_separator < result.last_separator and result.last_separator < text.len and
                result.first_separator == next_top_level_separator(text, result.start, result.has_address_group, result.address_open, result.address_close) and
                result.last_separator == next_top_level_separator(text, result.first_separator + SCAN_STEP, result.has_address_group, result.address_open, result.address_close) and
                first_operand_byte(text[result.start:result.first_separator], 0.usize()) < (text[result.start:result.first_separator]).len and
                first_operand_byte(text[result.first_separator + SCAN_STEP:result.last_separator], 0.usize()) < (text[result.first_separator + SCAN_STEP:result.last_separator]).len and
                first_operand_byte(text[result.last_separator + SCAN_STEP:text.len], 0.usize()) < (text[result.last_separator + SCAN_STEP:text.len]).len
            )
            text_length: usize = text.len
            start: usize = first_operand_byte(text, EasmTextScan::first_space(text).usize())
            if start >= text_length:
                return (text_length, 0, text_length, text_length, false, text_length, text_length, true)

            operands: sview = text[start:text_length]
            open_relative: usize = EasmTextScan::find(operands, "(")
            close_relative: usize = EasmTextScan::find(operands, ")")
            open: mutable usize = text_length
            close: mutable usize = text_length
            has_address: mutable bool = false
            if open_relative < operands.len:
                has_address <- true
                open <- start + open_relative
                if close_relative < open_relative:
                    return (start, 0, text_length, text_length, false, text_length, text_length, false)
                after_open: sview = text[open + SCAN_STEP:text_length]
                close_after_open: usize = EasmTextScan::find(after_open, ")")
                if close_after_open >= after_open.len:
                    return (start, 0, text_length, text_length, false, text_length, text_length, false)
                close <- open + SCAN_STEP + close_after_open
                address_contents: sview = text[open + SCAN_STEP:close]
                trailing: sview = text[close + SCAN_STEP:text_length]
                if EasmTextScan::find(address_contents, "(") < address_contents.len:
                    return (start, 0, text_length, text_length, false, text_length, text_length, false)
                if EasmTextScan::find(trailing, "(") < trailing.len or EasmTextScan::find(trailing, ")") < trailing.len:
                    return (start, 0, text_length, text_length, false, text_length, text_length, false)
            elif close_relative < operands.len:
                return (start, 0, text_length, text_length, false, text_length, text_length, false)

            first_separator: usize = next_top_level_separator(text, start, has_address, open, close)
            if first_separator >= text_length:
                return (start, 1, text_length, text_length, has_address, open, close, true)
            first_span: sview = text[start:first_separator]
            if first_operand_byte(first_span, 0.usize()) >= first_span.len:
                return (start, 0, text_length, text_length, false, text_length, text_length, false)
            second_separator: usize = next_top_level_separator(text, first_separator + SCAN_STEP, has_address, open, close)
            if second_separator >= text_length:
                single_second_span: sview = text[first_separator + SCAN_STEP:text_length]
                if first_operand_byte(single_second_span, 0.usize()) >= single_second_span.len:
                    return (start, 0, text_length, text_length, false, text_length, text_length, false)
                return (start, 2, first_separator, first_separator, has_address, open, close, true)
            middle_span: sview = text[first_separator + SCAN_STEP:second_separator]
            final_span: sview = text[second_separator + SCAN_STEP:text_length]
            if first_operand_byte(middle_span, 0.usize()) >= middle_span.len or first_operand_byte(final_span, 0.usize()) >= final_span.len:
                return (start, 0, text_length, text_length, false, text_length, text_length, false)
            return (start, TOO_MANY_OPERANDS_SENTINEL, first_separator, second_separator, has_address, open, close, true)
