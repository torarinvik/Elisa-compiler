# Top-level operand separators for the EASM instruction subset.
module EasmOperandScan:
    public:
        struct InstructionScanResult:
            start: usize
            count: usize
            first_separator: usize
            last_separator: usize
            has_address_group: bool
            address_open: usize
            address_close: usize
            valid: bool

        const ASCII_COMMA: u8 = 44
        const ASCII_LEFT_PAREN: u8 = 40
        const ASCII_RIGHT_PAREN: u8 = 41
        const ASCII_DOLLAR: u8 = 36
        const ASCII_PERCENT: u8 = 37
        const ASCII_STAR: u8 = 42
        const ASCII_LEFT_BRACKET: u8 = 91
        const ASCII_SPACE: u8 = 32
        const ASCII_TAB: u8 = 9
        const ASCII_X: u8 = 120
        const ASCII_ZERO: u8 = 48
        const ASCII_NINE: u8 = 57
        const ASCII_ONE: u8 = 49
        const ASCII_TWO: u8 = 50
        const ASCII_THREE: u8 = 51
        const SCAN_STEP: usize = 1
        const INDIRECT_REGISTER_PREFIX_LENGTH: usize = 2
        const MAX_MODELED_OPERAND_COUNT: usize = 2
        const TOO_MANY_OPERANDS_SENTINEL: usize = 3

        @inline(always)
        def needs_arity_rejection(operand_count: usize) -> bool:
            ensure result == (operand_count > MAX_MODELED_OPERAND_COUNT)
            return operand_count > MAX_MODELED_OPERAND_COUNT

        @inline(always)
        def is_zero_operand_instruction(op: sview) -> bool:
            ensure result == (
                op == "ret" or op == "retq" or op == "cpuid" or op == "cld" or op == "std" or
                op == "lfence" or op == "rdtsc" or op == "pause" or op == "yield" or op == "isb" or
                op == "emms" or op == "vzeroall" or op == "trap"
            )
            return (
                op == "ret" or op == "retq" or op == "cpuid" or op == "cld" or op == "std" or
                op == "lfence" or op == "rdtsc" or op == "pause" or op == "yield" or op == "isb" or
                op == "emms" or op == "vzeroall" or op == "trap"
            )

        @inline(always)
        def is_one_operand_instruction(op: sview) -> bool:
            ensure result == (
                op == "push" or op == "pushq" or op == "pop" or op == "popq" or
                op == "inc" or op == "incq" or op == "dec" or op == "decq" or
                op == "neg" or op == "negq" or op == "not" or op == "notq" or
                op == "call" or op == "callq" or op == "jmp" or op == "jmpq" or
                op == "je" or op == "jz" or op == "jne" or op == "jnz" or
                op == "jl" or op == "jle" or op == "jg" or op == "jge" or
                op == "jb" or op == "jbe" or op == "ja" or op == "jae" or
                op == "fldcw" or op == "fnstcw" or op == "stmxcsr" or op == "ldmxcsr"
            )
            return (
                op == "push" or op == "pushq" or op == "pop" or op == "popq" or
                op == "inc" or op == "incq" or op == "dec" or op == "decq" or
                op == "neg" or op == "negq" or op == "not" or op == "notq" or
                op == "call" or op == "callq" or op == "jmp" or op == "jmpq" or
                op == "je" or op == "jz" or op == "jne" or op == "jnz" or
                op == "jl" or op == "jle" or op == "jg" or op == "jge" or
                op == "jb" or op == "jbe" or op == "ja" or op == "jae" or
                op == "fldcw" or op == "fnstcw" or op == "stmxcsr" or op == "ldmxcsr"
            )

        @inline(always)
        def is_two_operand_instruction(op: sview) -> bool:
            ensure result == (
                op == "mov" or op == "movq" or op == "movb" or op == "movw" or op == "movl" or
                op == "movsx" or op == "movsxd" or op == "movsbw" or op == "movsbl" or op == "movsbq" or
                op == "movswl" or op == "movswq" or op == "movslq" or op == "movzx" or op == "movzbw" or
                op == "movzbl" or op == "movzbq" or op == "movzwl" or op == "movzwq" or
                op == "lea" or op == "leaq" or op == "xchg" or op == "xchgl" or op == "xchgq" or
                op == "add" or op == "addq" or op == "sub" or op == "subq" or
                op == "and" or op == "andq" or op == "or" or op == "orq" or op == "xor" or op == "xorq" or
                op == "cmp" or op == "cmpq" or op == "test" or op == "testq" or op == "mrs"
            )
            return (
                op == "mov" or op == "movq" or op == "movb" or op == "movw" or op == "movl" or
                op == "movsx" or op == "movsxd" or op == "movsbw" or op == "movsbl" or op == "movsbq" or
                op == "movswl" or op == "movswq" or op == "movslq" or op == "movzx" or op == "movzbw" or
                op == "movzbl" or op == "movzbq" or op == "movzwl" or op == "movzwq" or
                op == "lea" or op == "leaq" or op == "xchg" or op == "xchgl" or op == "xchgq" or
                op == "add" or op == "addq" or op == "sub" or op == "subq" or
                op == "and" or op == "andq" or op == "or" or op == "orq" or op == "xor" or op == "xorq" or
                op == "cmp" or op == "cmpq" or op == "test" or op == "testq" or op == "mrs"
            )

        @inline(always)
        def is_shift_instruction(op: sview) -> bool:
            ensure result == (
                op == "shl" or op == "shlq" or op == "sal" or op == "salq" or
                op == "shr" or op == "shrq" or op == "sar" or op == "sarq"
            )
            return (
                op == "shl" or op == "shlq" or op == "sal" or op == "salq" or
                op == "shr" or op == "shrq" or op == "sar" or op == "sarq"
            )

        @inline(always)
        def operand_arity_supported(op: sview, operand_count: usize) -> bool:
            ensure result == (
                (is_zero_operand_instruction(op) and operand_count == 0) or
                (not is_zero_operand_instruction(op) and is_one_operand_instruction(op) and operand_count == 1) or
                (not is_zero_operand_instruction(op) and not is_one_operand_instruction(op) and is_two_operand_instruction(op) and operand_count == 2) or
                (not is_zero_operand_instruction(op) and not is_one_operand_instruction(op) and not is_two_operand_instruction(op) and is_shift_instruction(op) and (operand_count == 1 or operand_count == 2))
            )
            return (
                (is_zero_operand_instruction(op) and operand_count == 0) or
                (not is_zero_operand_instruction(op) and is_one_operand_instruction(op) and operand_count == 1) or
                (not is_zero_operand_instruction(op) and not is_one_operand_instruction(op) and is_two_operand_instruction(op) and operand_count == 2) or
                (not is_zero_operand_instruction(op) and not is_one_operand_instruction(op) and not is_two_operand_instruction(op) and is_shift_instruction(op) and (operand_count == 1 or operand_count == 2))
            )

        # MRS is the deliberately small AArch64 exception in the otherwise AT&T/x86
        # operand verifier. Its destination must be an X register (or XZR), and the
        # capability model currently exposes only the virtual counter register.
        def is_aarch64_mrs_form(result_register: sview, system_register: sview) -> bool:
            ensure result == (
                system_register == "cntvct_el0" and
                (result_register == "xzr" or
                    (result_register.len == 2 and result_register[0] == ASCII_X and
                        result_register[1] >= ASCII_ZERO and result_register[1] <= ASCII_NINE) or
                    (result_register.len == 3 and result_register[0] == ASCII_X and
                        (((result_register[1] == ASCII_ONE or result_register[1] == ASCII_TWO) and
                            result_register[2] >= ASCII_ZERO and result_register[2] <= ASCII_NINE) or
                            (result_register[1] == ASCII_THREE and result_register[2] == ASCII_ZERO)))
                )
            )
            return (
                system_register == "cntvct_el0" and
                (result_register == "xzr" or
                    (result_register.len == 2 and result_register[0] == ASCII_X and
                        result_register[1] >= ASCII_ZERO and result_register[1] <= ASCII_NINE) or
                    (result_register.len == 3 and result_register[0] == ASCII_X and
                        (((result_register[1] == ASCII_ONE or result_register[1] == ASCII_TWO) and
                            result_register[2] >= ASCII_ZERO and result_register[2] <= ASCII_NINE) or
                            (result_register[1] == ASCII_THREE and result_register[2] == ASCII_ZERO)))
                )
            )

        @inline(always)
        def exact_register_form(operand: sview, register_name: sview) -> bool:
            ensure result == (
                (operand.len == register_name.len + SCAN_STEP and
                    operand.len > 0 and operand[0] == ASCII_PERCENT and
                    operand[SCAN_STEP:operand.len] == register_name) or
                (operand.len == register_name.len + INDIRECT_REGISTER_PREFIX_LENGTH and
                    operand.len >= INDIRECT_REGISTER_PREFIX_LENGTH and operand[0] == ASCII_STAR and
                    operand[1] == ASCII_PERCENT and
                    operand[INDIRECT_REGISTER_PREFIX_LENGTH:operand.len] == register_name)
            )
            return (
                (operand.len == register_name.len + SCAN_STEP and
                    operand.len > 0 and operand[0] == ASCII_PERCENT and
                    operand[SCAN_STEP:operand.len] == register_name) or
                (operand.len == register_name.len + INDIRECT_REGISTER_PREFIX_LENGTH and
                    operand.len >= INDIRECT_REGISTER_PREFIX_LENGTH and operand[0] == ASCII_STAR and
                    operand[1] == ASCII_PERCENT and
                    operand[INDIRECT_REGISTER_PREFIX_LENGTH:operand.len] == register_name)
            )

        @inline(always)
        def is_direct_control_target(op: sview, operand: sview, is_final_operand: bool) -> bool:
            ensure result == (
                is_final_operand and operand.len > 0 and
                operand[0] != ASCII_PERCENT and operand[0] != ASCII_DOLLAR and
                operand[0] != ASCII_STAR and operand[0] != ASCII_LEFT_PAREN and
                operand[0] != ASCII_LEFT_BRACKET and
                EasmTextScan::find(operand, ":") == operand.len and
                (op == "call" or op == "callq" or op == "jmp" or op == "jmpq" or
                    op == "je" or op == "jz" or op == "jne" or op == "jnz" or
                    op == "jl" or op == "jle" or op == "jg" or op == "jge" or
                    op == "jb" or op == "jbe" or op == "ja" or op == "jae")
            )
            return is_final_operand and operand.len > 0 and operand[0] != ASCII_PERCENT and operand[0] != ASCII_DOLLAR and operand[0] != ASCII_STAR and operand[0] != ASCII_LEFT_PAREN and operand[0] != ASCII_LEFT_BRACKET and EasmTextScan::find(operand, ":") == operand.len and (op == "call" or op == "callq" or op == "jmp" or op == "jmpq" or op == "je" or op == "jz" or op == "jne" or op == "jnz" or op == "jl" or op == "jle" or op == "jg" or op == "jge" or op == "jb" or op == "jbe" or op == "ja" or op == "jae")

        @inline(always)
        def rejects_unmodeled_operand_form(operand_present: bool, memory_address: bool, register_operand: bool, immediate_operand: bool, direct_control_target: bool) -> bool:
            ensure result == (
                operand_present and not memory_address and not register_operand and
                not immediate_operand and not direct_control_target
            )
            return operand_present and not memory_address and not register_operand and not immediate_operand and not direct_control_target

        @inline(always)
        def rejects_return_immediate(op: sview, immediate_operand: bool) -> bool:
            ensure result == (immediate_operand and (op == "ret" or op == "retq"))
            return immediate_operand and (op == "ret" or op == "retq")

        @inline(always)
        def rejects_unresolved_conditional_target(is_conditional_jump: bool, target_is_local: bool, direct_control_capability: bool, relocation_symbol_capability: bool) -> bool:
            ensure result == (
                is_conditional_jump and not target_is_local and
                not direct_control_capability and not relocation_symbol_capability
            )
            return is_conditional_jump and not target_is_local and not direct_control_capability and not relocation_symbol_capability

        @inline(always)
        def first_operand_byte(text: sview, from: usize) -> usize:
            requires from <= text.len
            ensure result >= from and result <= text.len
            ensure result == text.len or (
                text[result] != ASCII_SPACE and text[result] != ASCII_TAB
            )
            ensure (forall candidate in from..<result:
                text[candidate] == ASCII_SPACE or text[candidate] == ASCII_TAB
            )
            text_length: usize = text.len
            suffix: sview = text[from:text_length]
            bounds: (start: usize, end: usize) = EasmTextScan::trim_bounds(suffix)
            offset: usize = bounds.start
            assert bounds.start <= bounds.end and bounds.end <= suffix.len
            assert offset <= suffix.len
            assert from + offset <= text_length
            assert from <= from + offset
            assert offset == suffix.len or (
                suffix[offset] != ASCII_SPACE and suffix[offset] != ASCII_TAB
            )
            assert forall candidate in 0..<offset:
                suffix[candidate] == ASCII_SPACE or suffix[candidate] == ASCII_TAB
            assert from + offset == text_length or (
                text[from + offset] != ASCII_SPACE and text[from + offset] != ASCII_TAB
            )
            assert forall candidate in from..<from + offset:
                text[candidate] == ASCII_SPACE or text[candidate] == ASCII_TAB
            return from + offset

        # Find the next comma outside the sole parenthesized group supported by the EASM
        # address parser. A missing result uses text.len, matching the verified find helper.
        @inline(always)
        def next_top_level_separator(text: sview, from: usize, has_address: bool, open: usize, close: usize) -> usize:
            requires from <= text.len and open <= text.len and close <= text.len
            ensure result <= text.len
            ensure result >= from
            ensure result == text.len or (
                result >= from and text[result] == ASCII_COMMA and
                (not has_address or result < open or result > close)
            )
            ensure (forall candidate in from..<result:
                text[candidate] != ASCII_COMMA or
                (has_address and candidate >= open and candidate <= close)
            )
            text_length: usize = text.len
            if from == text_length:
                return text_length
            if not has_address or open > close:
                suffix: sview = text[from:text_length]
                relative: usize = EasmTextScan::find_byte(suffix, ASCII_COMMA)
                assert relative <= suffix.len
                if relative < suffix.len:
                    found: usize = from + relative
                    assert found < text_length
                    assert text[found] == ASCII_COMMA
                    assert not has_address or found < open or found > close
                    assert forall candidate in from..<found:
                        text[candidate] != ASCII_COMMA or
                        (has_address and candidate >= open and candidate <= close)
                    return found
                assert forall candidate in from..<text_length:
                    text[candidate] != ASCII_COMMA or
                    (has_address and candidate >= open and candidate <= close)
                return text_length

            if from < open:
                before_address: sview = text[from:open]
                before_relative: usize = EasmTextScan::find_byte(before_address, ASCII_COMMA)
                assert before_relative <= before_address.len
                if before_relative < before_address.len:
                    found_before: usize = from + before_relative
                    assert found_before < open
                    assert text[found_before] == ASCII_COMMA
                    assert forall candidate in from..<found_before:
                        text[candidate] != ASCII_COMMA
                    return found_before
                assert forall candidate in from..<open:
                    text[candidate] != ASCII_COMMA

            outside_start: mutable usize = from
            if from <= close:
                outside_start <- close + SCAN_STEP if close < text_length else text_length
            assert from <= outside_start and outside_start <= text_length
            assert forall candidate in from..<outside_start:
                text[candidate] != ASCII_COMMA or
                (has_address and candidate >= open and candidate <= close)
            after_address: sview = text[outside_start:text_length]
            after_relative: usize = EasmTextScan::find_byte(after_address, ASCII_COMMA)
            assert after_relative <= after_address.len
            if after_relative < after_address.len:
                found_after: usize = outside_start + after_relative
                assert found_after < text_length
                assert found_after > close
                assert text[found_after] == ASCII_COMMA
                assert forall candidate in outside_start..<found_after:
                    text[candidate] != ASCII_COMMA
                assert forall candidate in from..<found_after:
                    text[candidate] != ASCII_COMMA or
                    (has_address and candidate >= open and candidate <= close)
                return found_after
            assert forall candidate in outside_start..<text_length:
                text[candidate] != ASCII_COMMA
            assert forall candidate in from..<text_length:
                text[candidate] != ASCII_COMMA or
                (has_address and candidate >= open and candidate <= close)
            return text_length

    private:
        # Invalid scans use one canonical sentinel shape. Keeping this construction in one
        # helper lets callers prove the sentinel fields once while preserving the public
        # scan_instruction postconditions.
        def invalid_scan_result(text_length: usize, start: usize) -> InstructionScanResult:
            requires start <= text_length
            ensure result.start == start
            ensure result.start <= text_length
            ensure result.count == 0
            ensure result.first_separator == text_length and result.last_separator == text_length
            ensure not result.has_address_group
            ensure result.address_open == text_length and result.address_close == text_length
            ensure not result.valid
            return InstructionScanResult{start: start, count: 0, first_separator: text_length, last_separator: text_length, has_address_group: false, address_open: text_length, address_close: text_length, valid: false}

        def empty_scan_result(text_length: usize) -> InstructionScanResult:
            ensure result.start == text_length
            ensure result.count == 0
            ensure result.first_separator == text_length and result.last_separator == text_length
            ensure not result.has_address_group
            ensure result.address_open == text_length and result.address_close == text_length
            ensure result.valid
            return InstructionScanResult{start: text_length, count: 0, first_separator: text_length, last_separator: text_length, has_address_group: false, address_open: text_length, address_close: text_length, valid: true}

    public:
        # Parentheses delimit an AT&T base/index/scale tuple. Nested, repeated, or unbalanced
        # groups are outside the verifier's address grammar and must be rejected.
        @inline(always)
        def scan_instruction(text: sview) -> InstructionScanResult:
            ensure result.start <= text.len
            ensure result.count <= TOO_MANY_OPERANDS_SENTINEL
            ensure result.first_separator <= text.len and result.last_separator <= text.len
            ensure result.address_open <= text.len and result.address_close <= text.len
            ensure result.valid or (
                result.count == 0 and result.first_separator == text.len and result.last_separator == text.len and
                not result.has_address_group and result.address_open == text.len and result.address_close == text.len
            )
            ensure result.valid and result.count == 0 implies (
                result.start == text.len and result.first_separator == text.len and
                result.last_separator == text.len and not result.has_address_group and
                result.address_open == text.len and result.address_close == text.len
            )
            ensure result.valid implies result.start == first_operand_byte(text, EasmTextScan::first_space(text).usize())
            ensure result.valid and not result.has_address_group implies (
                result.address_open == text.len and result.address_close == text.len
            )
            ensure result.valid and not result.has_address_group implies (
                forall candidate in result.start..<text.len:
                    text[candidate] != ASCII_LEFT_PAREN and text[candidate] != ASCII_RIGHT_PAREN
            )
            ensure result.valid and result.has_address_group implies (
                result.start <= result.address_open and result.address_open < result.address_close and
                result.address_close < text.len and
                text[result.address_open] == ASCII_LEFT_PAREN and
                text[result.address_close] == ASCII_RIGHT_PAREN
            )
            ensure result.valid and result.has_address_group implies (
                forall candidate in result.start..<result.address_open:
                    text[candidate] != ASCII_LEFT_PAREN and text[candidate] != ASCII_RIGHT_PAREN
            )
            ensure result.valid and result.has_address_group implies (
                forall candidate in result.address_open + SCAN_STEP..<result.address_close:
                    text[candidate] != ASCII_LEFT_PAREN and text[candidate] != ASCII_RIGHT_PAREN
            )
            ensure result.valid and result.has_address_group implies (
                forall candidate in result.address_close + SCAN_STEP..<text.len:
                    text[candidate] != ASCII_LEFT_PAREN and text[candidate] != ASCII_RIGHT_PAREN
            )
            ensure result.valid and result.count == 1 implies (
                result.first_separator == text.len and result.last_separator == text.len and
                result.start < text.len and
                first_operand_byte(text[result.start:text.len], 0.usize()) < (text[result.start:text.len]).len and
                next_top_level_separator(text, result.start, result.has_address_group, result.address_open, result.address_close) == text.len
            )
            ensure result.valid and result.count == 2 implies (
                result.first_separator < text.len and result.first_separator == result.last_separator and
                result.first_separator == next_top_level_separator(text, result.start, result.has_address_group, result.address_open, result.address_close) and
                next_top_level_separator(text, result.first_separator + SCAN_STEP, result.has_address_group, result.address_open, result.address_close) == text.len and
                first_operand_byte(text[result.start:result.first_separator], 0.usize()) < (text[result.start:result.first_separator]).len and
                first_operand_byte(text[result.first_separator + SCAN_STEP:text.len], 0.usize()) < (text[result.first_separator + SCAN_STEP:text.len]).len
            )
            ensure result.valid and result.count == TOO_MANY_OPERANDS_SENTINEL implies (
                result.first_separator < result.last_separator and result.last_separator < text.len and
                result.first_separator == next_top_level_separator(text, result.start, result.has_address_group, result.address_open, result.address_close) and
                result.last_separator == next_top_level_separator(text, result.first_separator + SCAN_STEP, result.has_address_group, result.address_open, result.address_close) and
                first_operand_byte(text[result.start:result.first_separator], 0.usize()) < (text[result.start:result.first_separator]).len and
                first_operand_byte(text[result.first_separator + SCAN_STEP:result.last_separator], 0.usize()) < (text[result.first_separator + SCAN_STEP:result.last_separator]).len and
                first_operand_byte(text[result.last_separator + SCAN_STEP:text.len], 0.usize()) < (text[result.last_separator + SCAN_STEP:text.len]).len
            )
            text_length: usize = text.len
            first_space: i64 = EasmTextScan::first_space(text)
            assert first_space >= 0 and first_space <= text_length.i64()
            first_space_offset: usize = first_space.usize()
            assert first_space_offset <= text_length
            start: usize = first_operand_byte(text, first_space_offset)
            assert start <= text_length
            if start >= text_length:
                assert start == text_length
                return empty_scan_result(text_length)

            operands: sview = text[start:text_length]
            open_relative: usize = EasmTextScan::find_byte(operands, ASCII_LEFT_PAREN)
            close_relative: usize = EasmTextScan::find_byte(operands, ASCII_RIGHT_PAREN)
            open: mutable usize = text_length
            close: mutable usize = text_length
            has_address: mutable bool = false
            if open_relative < operands.len:
                has_address <- true
                open <- start + open_relative
                if close_relative < open_relative:
                    return invalid_scan_result(text_length, start)
                if close_relative >= operands.len:
                    return invalid_scan_result(text_length, start)
                after_open: sview = text[open + SCAN_STEP:text_length]
                close_after_open: usize = EasmTextScan::find_byte(after_open, ASCII_RIGHT_PAREN)
                if close_after_open >= after_open.len:
                    return invalid_scan_result(text_length, start)
                close <- open + SCAN_STEP + close_after_open
                address_contents: sview = text[open + SCAN_STEP:close]
                trailing: sview = text[close + SCAN_STEP:text_length]
                if EasmTextScan::find_byte(address_contents, ASCII_LEFT_PAREN) < address_contents.len:
                    return invalid_scan_result(text_length, start)
                if EasmTextScan::find_byte(trailing, ASCII_LEFT_PAREN) < trailing.len or EasmTextScan::find_byte(trailing, ASCII_RIGHT_PAREN) < trailing.len:
                    return invalid_scan_result(text_length, start)
            elif close_relative < operands.len:
                return invalid_scan_result(text_length, start)

            if has_address:
                assert start <= open
                assert open < close
                assert close < text_length
                assert text[open] == ASCII_LEFT_PAREN
                assert text[close] == ASCII_RIGHT_PAREN
                assert forall candidate in start..<open:
                    text[candidate] != ASCII_LEFT_PAREN and text[candidate] != ASCII_RIGHT_PAREN
                assert forall candidate in open + SCAN_STEP..<close:
                    text[candidate] != ASCII_LEFT_PAREN and text[candidate] != ASCII_RIGHT_PAREN
                assert forall candidate in close + SCAN_STEP..<text_length:
                    text[candidate] != ASCII_LEFT_PAREN and text[candidate] != ASCII_RIGHT_PAREN
            else:
                assert open == text_length
                assert close == text_length
                assert forall candidate in start..<text_length:
                    text[candidate] != ASCII_LEFT_PAREN and text[candidate] != ASCII_RIGHT_PAREN

            first_separator: usize = next_top_level_separator(text, start, has_address, open, close)
            if first_separator >= text_length:
                single_scan: InstructionScanResult = InstructionScanResult{
                    start: start,
                    count: 1,
                    first_separator: text_length,
                    last_separator: text_length,
                    has_address_group: has_address,
                    address_open: open,
                    address_close: close,
                    valid: true
                }
                assert single_scan.start == start
                assert single_scan.count == 1
                assert single_scan.first_separator == text_length
                assert single_scan.last_separator == text_length
                assert single_scan.has_address_group == has_address
                assert single_scan.address_open == open
                assert single_scan.address_close == close
                assert single_scan.valid
                assert single_scan.start <= text.len
                assert single_scan.address_open <= text.len and single_scan.address_close <= text.len
                assert not (single_scan.valid and not single_scan.has_address_group) or (
                    single_scan.address_open == text.len and single_scan.address_close == text.len
                )
                assert not (single_scan.valid and not single_scan.has_address_group) or (
                    forall candidate in single_scan.start..<text.len:
                        text[candidate] != ASCII_LEFT_PAREN and text[candidate] != ASCII_RIGHT_PAREN
                )
                assert not (single_scan.valid and single_scan.has_address_group) or (
                    single_scan.start <= single_scan.address_open and single_scan.address_open < single_scan.address_close and
                    single_scan.address_close < text.len and text[single_scan.address_open] == ASCII_LEFT_PAREN and
                    text[single_scan.address_close] == ASCII_RIGHT_PAREN
                )
                assert not (single_scan.valid and single_scan.has_address_group) or (
                    forall candidate in single_scan.start..<single_scan.address_open:
                        text[candidate] != ASCII_LEFT_PAREN and text[candidate] != ASCII_RIGHT_PAREN
                )
                assert not (single_scan.valid and single_scan.has_address_group) or (
                    forall candidate in single_scan.address_open + SCAN_STEP..<single_scan.address_close:
                        text[candidate] != ASCII_LEFT_PAREN and text[candidate] != ASCII_RIGHT_PAREN
                )
                assert not (single_scan.valid and single_scan.has_address_group) or (
                    forall candidate in single_scan.address_close + SCAN_STEP..<text.len:
                        text[candidate] != ASCII_LEFT_PAREN and text[candidate] != ASCII_RIGHT_PAREN
                )
                assert not single_scan.valid or single_scan.count != 1 or (
                    single_scan.first_separator == text.len and single_scan.last_separator == text.len and
                    single_scan.start < text.len and
                    first_operand_byte(text[single_scan.start:text.len], 0.usize()) < (text[single_scan.start:text.len]).len and
                    next_top_level_separator(text, single_scan.start, single_scan.has_address_group, single_scan.address_open, single_scan.address_close) == text.len
                )
                return single_scan
            first_span: sview = text[start:first_separator]
            if first_operand_byte(first_span, 0.usize()) >= first_span.len:
                return invalid_scan_result(text_length, start)
            second_separator: usize = next_top_level_separator(text, first_separator + SCAN_STEP, has_address, open, close)
            if second_separator >= text_length:
                single_second_span: sview = text[first_separator + SCAN_STEP:text_length]
                if first_operand_byte(single_second_span, 0.usize()) >= single_second_span.len:
                    return invalid_scan_result(text_length, start)
                two_scan: InstructionScanResult = InstructionScanResult{
                    start: start,
                    count: 2,
                    first_separator: first_separator,
                    last_separator: first_separator,
                    has_address_group: has_address,
                    address_open: open,
                    address_close: close,
                    valid: true
                }
                assert two_scan.start == start
                assert two_scan.count == 2
                assert two_scan.first_separator == first_separator
                assert two_scan.last_separator == first_separator
                assert two_scan.has_address_group == has_address
                assert two_scan.address_open == open
                assert two_scan.address_close == close
                assert two_scan.valid
                assert two_scan.start <= text.len
                assert two_scan.address_open <= text.len and two_scan.address_close <= text.len
                assert two_scan.first_separator < text.len
                assert two_scan.first_separator + SCAN_STEP <= text.len
                assert not (two_scan.valid and not two_scan.has_address_group) or (
                    two_scan.address_open == text.len and two_scan.address_close == text.len
                )
                assert not (two_scan.valid and not two_scan.has_address_group) or (
                    forall candidate in two_scan.start..<text.len:
                        text[candidate] != ASCII_LEFT_PAREN and text[candidate] != ASCII_RIGHT_PAREN
                )
                assert not (two_scan.valid and two_scan.has_address_group) or (
                    two_scan.start <= two_scan.address_open and two_scan.address_open < two_scan.address_close and
                    two_scan.address_close < text.len and text[two_scan.address_open] == ASCII_LEFT_PAREN and
                    text[two_scan.address_close] == ASCII_RIGHT_PAREN
                )
                assert not (two_scan.valid and two_scan.has_address_group) or (
                    forall candidate in two_scan.start..<two_scan.address_open:
                        text[candidate] != ASCII_LEFT_PAREN and text[candidate] != ASCII_RIGHT_PAREN
                )
                assert not (two_scan.valid and two_scan.has_address_group) or (
                    forall candidate in two_scan.address_open + SCAN_STEP..<two_scan.address_close:
                        text[candidate] != ASCII_LEFT_PAREN and text[candidate] != ASCII_RIGHT_PAREN
                )
                assert not (two_scan.valid and two_scan.has_address_group) or (
                    forall candidate in two_scan.address_close + SCAN_STEP..<text.len:
                        text[candidate] != ASCII_LEFT_PAREN and text[candidate] != ASCII_RIGHT_PAREN
                )
                assert not two_scan.valid or two_scan.count != 2 or (
                    two_scan.first_separator < text.len and two_scan.first_separator == two_scan.last_separator and
                    two_scan.first_separator == next_top_level_separator(text, two_scan.start, two_scan.has_address_group, two_scan.address_open, two_scan.address_close) and
                    next_top_level_separator(text, two_scan.first_separator + SCAN_STEP, two_scan.has_address_group, two_scan.address_open, two_scan.address_close) == text.len and
                    first_operand_byte(text[two_scan.start:two_scan.first_separator], 0.usize()) < (text[two_scan.start:two_scan.first_separator]).len and
                    first_operand_byte(text[two_scan.first_separator + SCAN_STEP:text.len], 0.usize()) < (text[two_scan.first_separator + SCAN_STEP:text.len]).len
                )
                return two_scan
            middle_span: sview = text[first_separator + SCAN_STEP:second_separator]
            final_span: sview = text[second_separator + SCAN_STEP:text_length]
            if first_operand_byte(middle_span, 0.usize()) >= middle_span.len or first_operand_byte(final_span, 0.usize()) >= final_span.len:
                return invalid_scan_result(text_length, start)
            many_scan: InstructionScanResult = InstructionScanResult{
                start: start,
                count: TOO_MANY_OPERANDS_SENTINEL,
                first_separator: first_separator,
                last_separator: second_separator,
                has_address_group: has_address,
                address_open: open,
                address_close: close,
                valid: true
            }
            assert many_scan.start == start
            assert many_scan.count == TOO_MANY_OPERANDS_SENTINEL
            assert many_scan.first_separator == first_separator
            assert many_scan.last_separator == second_separator
            assert many_scan.has_address_group == has_address
            assert many_scan.address_open == open
            assert many_scan.address_close == close
            assert many_scan.first_separator < text.len
            assert many_scan.first_separator + SCAN_STEP <= text.len
            assert many_scan.last_separator < text.len
            assert many_scan.valid
            assert many_scan.start <= text.len
            assert many_scan.address_open <= text.len and many_scan.address_close <= text.len
            assert not (many_scan.valid and not many_scan.has_address_group) or (
                many_scan.address_open == text.len and many_scan.address_close == text.len
            )
            assert not (many_scan.valid and not many_scan.has_address_group) or (
                forall candidate in many_scan.start..<text.len:
                    text[candidate] != ASCII_LEFT_PAREN and text[candidate] != ASCII_RIGHT_PAREN
            )
            assert not (many_scan.valid and many_scan.has_address_group) or (
                many_scan.start <= many_scan.address_open and many_scan.address_open < many_scan.address_close and
                many_scan.address_close < text.len and text[many_scan.address_open] == ASCII_LEFT_PAREN and
                text[many_scan.address_close] == ASCII_RIGHT_PAREN
            )
            assert not (many_scan.valid and many_scan.has_address_group) or (
                forall candidate in many_scan.start..<many_scan.address_open:
                    text[candidate] != ASCII_LEFT_PAREN and text[candidate] != ASCII_RIGHT_PAREN
            )
            assert not (many_scan.valid and many_scan.has_address_group) or (
                forall candidate in many_scan.address_open + SCAN_STEP..<many_scan.address_close:
                    text[candidate] != ASCII_LEFT_PAREN and text[candidate] != ASCII_RIGHT_PAREN
            )
            assert not (many_scan.valid and many_scan.has_address_group) or (
                forall candidate in many_scan.address_close + SCAN_STEP..<text.len:
                    text[candidate] != ASCII_LEFT_PAREN and text[candidate] != ASCII_RIGHT_PAREN
            )
            assert not many_scan.valid or many_scan.count != TOO_MANY_OPERANDS_SENTINEL or (
                many_scan.first_separator < many_scan.last_separator and many_scan.last_separator < text.len and
                many_scan.first_separator == next_top_level_separator(text, many_scan.start, many_scan.has_address_group, many_scan.address_open, many_scan.address_close) and
                many_scan.last_separator == next_top_level_separator(text, many_scan.first_separator + SCAN_STEP, many_scan.has_address_group, many_scan.address_open, many_scan.address_close) and
                first_operand_byte(text[many_scan.start:many_scan.first_separator], 0.usize()) < (text[many_scan.start:many_scan.first_separator]).len and
                first_operand_byte(text[many_scan.first_separator + SCAN_STEP:many_scan.last_separator], 0.usize()) < (text[many_scan.first_separator + SCAN_STEP:many_scan.last_separator]).len and
                first_operand_byte(text[many_scan.last_separator + SCAN_STEP:text.len], 0.usize()) < (text[many_scan.last_separator + SCAN_STEP:text.len]).len
            )
            assert many_scan.start <= text.len
            assert many_scan.count <= TOO_MANY_OPERANDS_SENTINEL
            assert many_scan.first_separator <= text.len and many_scan.last_separator <= text.len
            assert many_scan.address_open <= text.len and many_scan.address_close <= text.len
            assert many_scan.start == first_operand_byte(text, EasmTextScan::first_space(text).usize())
            return many_scan
