# Stage1 backend — emit one object with N forked LLVM code generators.
# Part of `module Backend` (see codegen.elisa).
#
# Unoptimised codegen of the compiler's own ~110k-line module spends most of its wall
# clock in LLVM's single-threaded SelectionDAG/AsmPrinter. When ELISA_STAGE1_JOBS asks
# for N > 1 workers, the finished, verified module is partitioned by function: defined
# functions are split into N contiguous runs of roughly equal instruction count, and the
# process forks a tree of workers, one per run. Each child keeps the bodies of its own run,
# marks every other definition available_externally (code generation skips it; an
# optimising machine erases it instead, see part_restrict_module), and writes
# `<out>.part<k>.o`; the parent then merges the parts with a relocatable link (`ld -r`)
# into the requested object.
#
# Linkage is rewritten identically in every partition so cross-partition references
# resolve: a function or mutable/external global with internal or private linkage
# becomes a HIDDEN external symbol renamed under the `elisa.part.` prefix. The live
# emitter's names are partition-local. Cache snapshots add a stable source-unit
# namespace because their objects can be linked with other translation units.
# Mutable and external globals and local constants are owned by partition 0. Keeping one
# local-constant definition preserves address identity when distinct functions take its
# address. linkonce/weak definitions are left in every
# partition. A global alias stays in the partition that defines its aliasee; elsewhere
# its uses are redirected to the aliasee's declaration and the alias becomes private.
#
# The partitioning is a pure function of the module, so the merged object is
# deterministic: two builds from the same compiler and source are byte-identical, which
# is what the gen2/gen3 fixpoint compares. Unset or 1 keeps the single-object path.

extern fork() -> i32
extern waitpid(pid: i32, status: mutable i32&, options: i32) -> i32
extern _exit(status: i32) -> void
extern setpgid(pid: i32, pgid: i32) -> i32
@link_name("kill")
extern kill_backend(pid: i32, signal: i32) -> i32
extern LLVMGetFirstGlobal(m: LLVMModuleRef) -> LLVMValueRef?
extern LLVMGetNextGlobal(global_value: LLVMValueRef) -> LLVMValueRef?
extern LLVMGetFirstGlobalAlias(m: LLVMModuleRef) -> cstr?
extern LLVMGetNextGlobalAlias(alias: cstr) -> cstr?
extern LLVMGetFirstGlobalIFunc(m: LLVMModuleRef) -> cstr?
extern LLVMGetNextGlobalIFunc(ifunc: LLVMValueRef) -> LLVMValueRef?
extern LLVMGetComdat(value: LLVMValueRef) -> cstr?
extern LLVMAliasGetAliasee(alias: LLVMValueRef) -> LLVMValueRef
extern LLVMIsDeclaration(global_value: LLVMValueRef) -> i32
extern LLVMIsGlobalConstant(global_value: LLVMValueRef) -> i32
extern LLVMSetVisibility(global_value: LLVMValueRef, visibility: u32) -> void
extern LLVMHasPersonalityFn(fn: LLVMValueRef) -> i32
@link_name("LLVMSetPersonalityFn")
extern elisa_part_clear_personality(fn: LLVMValueRef, personality: LLVMValueRef?) -> void
@link_name("LLVMSetInitializer")
extern elisa_part_clear_initializer(global_value: LLVMValueRef, value: LLVMValueRef?) -> void

extend Backend:
    private:
        const PART_LINKAGE_EXTERNAL: u32 = 0
        const PART_LINKAGE_AVAILABLE_EXTERNALLY: u32 = 1
        const PART_LINKAGE_INTERNAL: u32 = 8
        const PART_LINKAGE_PRIVATE: u32 = 9
        const PART_VISIBILITY_HIDDEN: u32 = 1
        # LLVMPrintMessageAction: print the verifier's diagnostic to stderr and return.
        const PART_VERIFY_PRINT_MESSAGE: i32 = 1
        # LLVMReturnStatusAction: report failure to the caller without changing stderr.
        const PART_VERIFY_RETURN_STATUS: i32 = 2
        const PART_SIGKILL: i32 = 9
        # LLVMValueKind values for GlobalValue subclasses and BlockAddress are stable
        # across the supported LLVM versions. LLVM 23 inserted ConstantByte before
        # InlineAsm, so its value kind is selected from the loaded LLVM version below.
        # Unknown majors fail closed until their enum mapping is reviewed.
        const PART_VALUE_KIND_FUNCTION: u32 = 5
        const PART_VALUE_KIND_GLOBAL_ALIAS: u32 = 6
        const PART_VALUE_KIND_GLOBAL_IFUNC: u32 = 7
        const PART_VALUE_KIND_GLOBAL_VARIABLE: u32 = 8
        const PART_VALUE_KIND_BLOCK_ADDRESS: u32 = 9
        const PART_VALUE_KIND_INLINE_ASM_PRE_23: u32 = 23
        const PART_VALUE_KIND_INLINE_ASM_23_PLUS: u32 = 24
        const PART_CACHE_CONSTANT_DEPTH_LIMIT: u32 = 256
        # Instructions per forked emitter below which another worker costs more than it saves.
        const PART_MIN_WEIGHT_PER_JOB: i64 = 20000
        # Logical cache ownership is independent from ELISA_STAGE1_JOBS. The selected
        # count is the largest dense FNV bucket count no greater than this cap.
        # Changing this rule or the name hash requires an ownership-version bump.
        const PART_CACHE_MAX_LOGICAL_SHARDS: usize = 16
        const PART_CACHE_OWNERSHIP_VERSION: u32 = 6

    public:
        const PART_CACHE_PREP_UNSUPPORTED: u8 = 0
        const PART_CACHE_PREP_READY: u8 = 1
        const PART_CACHE_PREP_FAILED: u8 = 2

        # snapshot_path is NUL-terminated for C APIs; helper request serialization must
        # encode only its bytes before the final terminator.
        struct PartCachePreparedShard:
            logical_shard: usize
            snapshot_path: darray[u8]

        struct PartCachePreparedSet:
            status: u8
            logical_shards: usize
            ownership_version: u32
            shards: darray[PartCachePreparedShard]

    private:
        def part_cache_inline_asm_value_kind() -> u32:
            major: mutable u32 = 0
            minor: mutable u32 = 0
            patch: mutable u32 = 0
            LLVMGetVersion(&major, &minor, &patch)
            version_code: u64 = major.u64() * 1000000 + minor.u64() * 1000 + patch.u64()
            return 0 if version_code < 19000000 or version_code >= 24000000
            return PART_VALUE_KIND_INLINE_ASM_PRE_23 if major < 23
            PART_VALUE_KIND_INLINE_ASM_23_PLUS

        struct PartCacheFunctionIdentity:
            hash: u64
            defined: bool

        struct PartCacheGlobalIdentity:
            defined: bool
            owned_by_zero: bool

        struct PartCacheOwnerAnalysis:
            logical_shards: usize
            function_owners: darray[i64]
            global_owners: darray[i64]

        # Stable across edits to one source unit. Two independently seeded 64-bit
        # FNV streams keep the linker namespace compact while making cross-unit
        # collisions vanishingly unlikely; the canonical source path is the input.
        struct PartSymbolNamespace:
            high: u64
            low: u64

        def part_symbol_namespace(source_unit: sview) -> PartSymbolNamespace can[Abort.Panic]:
            high: mutable u64 = 14695981039346656037
            low: mutable u64 = 7809847782465536322
            for index in 0..<source_unit.len |high, low, source_unit|:
                byte: u64 = source_unit[index].u64()
                high <- (high ^ byte) * 1099511628211
                low <- (low ^ (byte ^ 165.u64())) * 1099511628211
            high <- (high ^ source_unit.len.u64()) * 1099511628211
            low <- (low ^ source_unit.len.u64()) * 1099511628211
            return PartSymbolNamespace{high: high, low: low}

        def part_push_hex_u64(buffer: mutable darray[u8]&, value: u64) -> void can[Abort.Panic, Memory.Allocate]:
            for digit_index in 0..<16 |buffer, value|:
                shift: u64 = (15 - digit_index).u64() * 4
                digit: u8 = ((value >> shift) & 15.u64()).u8()
                if digit < 10:
                    buffer.push(48 + digit)
                else:
                    buffer.push(87 + digit)

        def part_cache_name_is_stable(name: u8&, length: usize) -> bool can[Unsafe.PointerCast]:
            return false if length == 0
            # Lifted lambda symbols are assigned in source traversal order, so a
            # preceding lambda can rename every later one after an unrelated edit.
            if length >= 7:
                lambda_prefix: sview = "lambda_"
                for index in 0..<lambda_prefix.len |name, lambda_prefix|:
                    byte_ref: u8& = name + index
                    return false if byte_ref != lambda_prefix[index]
            for index in 0..<length |name|:
                byte_ref: u8& = name + index
                byte: u8 = byte_ref
                # Period and dollar names are used by LLVM and several generated
                # specialization paths. Keep those identities on the cold path.
                return false if byte == 46 or byte == 36 or byte < 33
            return true

        def part_cache_name_is_reserved(name: u8&, length: usize) -> bool can[Unsafe.PointerCast]:
            return false if length < 11
            prefix: sview = "elisa.part."
            for index in 0..<prefix.len |name, prefix|:
                byte_ref: u8& = name + index
                return false if byte_ref != prefix[index]
            return true

        # The live O0 partition keeps foreign bodies available_externally, but a
        # cache snapshot strips them. An alwaysinline caller can therefore acquire
        # code from a foreign body during backend emission; reject such modules until
        # the cross-shard inline dependency is part of the shard key.
        def part_cache_function_has_alwaysinline(function: LLVMValueRef) -> bool:
            kind: u32 = LLVMGetEnumAttributeKindForName("alwaysinline", 12)
            # LLVMAttributeRef is opaque too; use a raw pointer solely for presence.
            return kind != 0 and LLVMGetEnumAttributeAtIndex(function, 4294967295, kind) != null

        # Return true for a constant tree containing a BlockAddress or InlineAsm.
        # Global values are leaves here: following a global would recurse through
        # initializer cycles.
        def part_cache_constant_has_unsupported_value(value: LLVMValueRef, depth: u32, inline_asm_kind: u32) -> bool can[Unsafe.PointerCast]:
            kind: u32 = LLVMGetValueKind(value)
            return true if kind == PART_VALUE_KIND_BLOCK_ADDRESS or kind == inline_asm_kind
            return false if kind == PART_VALUE_KIND_FUNCTION or kind == PART_VALUE_KIND_GLOBAL_ALIAS or kind == PART_VALUE_KIND_GLOBAL_IFUNC or kind == PART_VALUE_KIND_GLOBAL_VARIABLE
            # LLVMValueRef? silently binds as absent for opaque extern handles in
            # Stage0. The raw pointer is only a type test; recurse through `value`.
            if LLVMIsAConstant(value) != null:
                return true if depth >= PART_CACHE_CONSTANT_DEPTH_LIMIT
                operand_count: u32 = LLVMGetNumOperands(value)
                for operand_index in 0..<operand_count |operand_index, value|:
                    operand: LLVMValueRef = LLVMGetOperand(value, operand_index)
                    return true if part_cache_constant_has_unsupported_value(operand, depth + 1, inline_asm_kind)
            return false

        # Body stripping can invalidate a BlockAddress or remove function-level
        # InlineAsm stored in a global initializer or retained function. Reject such
        # modules before making any clones.
        def part_cache_module_has_unsupported_value(m: LLVMModuleRef) -> bool can[Unsafe.PointerCast]:
            inline_asm_kind: u32 = part_cache_inline_asm_value_kind()
            return true if inline_asm_kind == 0
            global_opt: mutable LLVMValueRef? = LLVMGetFirstGlobal(m)
            while global_opt is global_value |global_opt|:
                if LLVMIsDeclaration(global_value) == 0:
                    return true if part_cache_constant_has_unsupported_value(LLVMGetInitializer(global_value), 0, inline_asm_kind)
                global_opt <- LLVMGetNextGlobal(global_value)
            function_opt: mutable LLVMValueRef? = LLVMGetFirstFunction(m)
            while function_opt is function |function_opt|:
                if LLVMIsDeclaration(function) == 0:
                    block_opt: mutable LLVMBasicBlockRef? = LLVMGetFirstBasicBlock(function)
                    while block_opt is block |block_opt|:
                        inst_opt: mutable LLVMValueRef? = LLVMGetFirstInstruction(block)
                        while inst_opt is inst |inst_opt|:
                            operand_count: u32 = LLVMGetNumOperands(inst)
                            for operand_index in 0..<operand_count |operand_index, inst|:
                                operand: LLVMValueRef = LLVMGetOperand(inst, operand_index)
                                return true if part_cache_constant_has_unsupported_value(operand, 0, inline_asm_kind)
                            inst_opt <- LLVMGetNextInstruction(inst)
                        block_opt <- LLVMGetNextBasicBlock(block)
                function_opt <- LLVMGetNextFunction(function)
            return false

        def part_cache_symbol_hash(name: u8&, length: usize) -> u64 can[Unsafe.PointerCast]:
            hash: mutable u64 = 14695981039346656037
            for index in 0..<length |hash, name|:
                byte_ref: u8& = name + index
                byte_value: u8 = byte_ref
                hash <- (hash ^ byte_value.u64()) * 1099511628211
            return hash

        # Strict admission for the first shard snapshot recipe. Unowned definitions,
        # aliases, ifuncs, COMDAT members, debug bodies, and unstable names can carry
        # dependencies not represented by the restricted snapshot contract.
        def part_cache_stable_owners(m: LLVMModuleRef) -> PartCacheOwnerAnalysis? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            return null if:
                LLVMGetFirstGlobalAlias(m) is alias
                LLVMGetFirstGlobalIFunc(m) is ifunc
                LLVMGetNamedMetadataNumOperands(m, "llvm.dbg.cu") != 0
                part_cache_module_has_unsupported_value(m)
            # Inputs are fresh modules built by this source code generator. It has no
            # module-scope inline-assembly setter or bitcode import path; function-level
            # LLVM InlineAsm values are rejected by the value scan above.
            identities: mutable darray[PartCacheFunctionIdentity] = []
            global_identities: mutable darray[PartCacheGlobalIdentity] = []
            global_opt: mutable LLVMValueRef? = LLVMGetFirstGlobal(m)
            while global_opt is global_value |global_opt, identities, global_identities|:
                global_name_length: mutable usize = 0
                global_name: u8& = LLVMGetValueName2(global_value, &global_name_length)
                return null if part_cache_name_is_reserved(global_name, global_name_length)
                if LLVMIsDeclaration(global_value) != 0:
                    global_identities.push(PartCacheGlobalIdentity{defined: false, owned_by_zero: false})
                else:
                    return null if LLVMGetComdat(global_value) is comdat
                    linkage: u32 = LLVMGetLinkage(global_value)
                    local_constant: bool = part_linkage_is_local(linkage) and LLVMIsGlobalConstant(global_value) != 0
                    owned_by_zero: bool = part_global_owned(global_value)
                    return null if not owned_by_zero and not local_constant
                    global_identities.push(PartCacheGlobalIdentity{defined: true, owned_by_zero: owned_by_zero})
                global_opt <- LLVMGetNextGlobal(global_value)
            function_opt: mutable LLVMValueRef? = LLVMGetFirstFunction(m)
            while function_opt is function |identities, function_opt|:
                name_length: mutable usize = 0
                name_bytes: u8& = LLVMGetValueName2(function, &name_length)
                return null if part_cache_name_is_reserved(name_bytes, name_length)
                if LLVMIsDeclaration(function) != 0:
                    identities.push(PartCacheFunctionIdentity{hash: 0, defined: false})
                else:
                    return null if:
                        LLVMGetComdat(function) is comdat
                        not part_function_owned(function)
                        not part_cache_name_is_stable(name_bytes, name_length)
                        part_cache_function_has_alwaysinline(function)
                    # LLVM's module symbol table guarantees unique GlobalValue names;
                    # generated duplicate spellings acquire a suffix rejected above.
                    identities.push(PartCacheFunctionIdentity{hash: part_cache_symbol_hash(name_bytes, name_length), defined: true})
                function_opt <- LLVMGetNextFunction(function)
            definitions: usize = 0
            for identity in identities:
                definitions <- definitions + 1 if identity.defined
            return null if definitions == 0
            candidate: mutable usize = PART_CACHE_MAX_LOGICAL_SHARDS if definitions >= PART_CACHE_MAX_LOGICAL_SHARDS else definitions
            chosen: mutable usize = 1
            found_dense_count: mutable bool = false
            while candidate > 0 and not found_dense_count |candidate, chosen, found_dense_count, identities|:
                counts: mutable darray[u32] = []
                counts.resize(candidate)
                for identity in identities |counts, candidate|:
                    if identity.defined:
                        bucket: usize = (identity.hash % candidate.u64()).usize()
                        counts[bucket] <- counts[bucket] + 1
                dense: mutable bool = true
                for count in counts |dense|:
                    dense <- false if count == 0
                if dense:
                    chosen <- candidate
                    found_dense_count <- true
                else:
                    candidate <- candidate - 1
            owners: mutable darray[i64] = []
            for identity in identities |owners, chosen|:
                owners.push((identity.hash % chosen.u64()).i64() if identity.defined else -1)
            global_owners: mutable darray[i64] = []
            for identity in global_identities |global_owners, chosen|:
                # Match live partition emission: mutable/external globals and local
                # constants have one definition in shard zero.
                owner: i64 = 0 if identity.owned_by_zero else -1
                global_owners.push(owner if identity.defined else -1)
            return PartCacheOwnerAnalysis{logical_shards: chosen, function_owners: owners, global_owners: global_owners}

        def part_cache_snapshot_prefix_length(prefix: darray[u8]&) -> usize:
            length: mutable usize = prefix.count
            length <- length - 1 if length > 0 and prefix[length - 1] == 0
            return 0 if length == 0
            for index in 0..<length |prefix|:
                return 0 if prefix[index] == 0
            return length

        def part_cache_snapshot_path(prefix: darray[u8]&, prefix_length: usize, logical_shard: usize) -> darray[u8] can[Abort.Panic, Memory.Allocate]:
            path: mutable darray[u8] = []
            for index in 0..<prefix_length |path, prefix|:
                path.push(prefix[index])
            path.extend(".shard")
            part_push_decimal(path, logical_shard.i64())
            path.extend(".bc")
            path.push(0)
            return path

        def part_cache_remove_snapshots(shards: darray[PartCachePreparedShard]&) -> void can[Unsafe.PointerCast]:
            for shard in shards:
                _ = unlink_backend((&shard.snapshot_path[0]).cast[cstr] can Unsafe.PointerCast)

        # Keep one LLVM clone alive only while its restricted snapshot is verified and
        # written. The defer also covers allocation/panic exits from restriction and IO.
        def part_cache_prepare_one_shard(m: LLVMModuleRef, function_owners: darray[i64]&, global_owners: darray[i64]&, snapshot_prefix: darray[u8]&, prefix_length: usize, logical_shard: usize, unit_namespace: PartSymbolNamespace) -> PartCachePreparedShard? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            clone: LLVMModuleRef = LLVMCloneModule(m)
            defer block:
                LLVMDisposeModule(clone)
            part_cache_restrict_module(clone, function_owners, global_owners, logical_shard.i64(), unit_namespace)
            return null if LLVMVerifyModule(clone, PART_VERIFY_RETURN_STATUS, null) != 0
            snapshot_path: mutable darray[u8] = part_cache_snapshot_path(snapshot_prefix, prefix_length, logical_shard)
            write_status: i32 = LLVMWriteBitcodeToFile(clone, (&snapshot_path[0]).cast[cstr] can Unsafe.PointerCast)
            if write_status != 0:
                _ = unlink_backend((&snapshot_path[0]).cast[cstr] can Unsafe.PointerCast)
                return null
            return PartCachePreparedShard{logical_shard: logical_shard, snapshot_path: snapshot_path}

        # Build an isolated, verifier-checked snapshot for every stable logical shard.
        # Foreign function bodies are erased before serialization, so one body's bytes do
        # not leak into all other shard keys. Each clone is verified, serialized, and
        # disposed immediately; the unique prefix must be in a private directory, and a
        # future miss path must parse only its selected snapshot.
    public:
        def prepare_part_cache_shards(m: LLVMModuleRef, snapshot_prefix: darray[u8]&, source_unit: sview) -> PartCachePreparedSet can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            prefix_length: usize = part_cache_snapshot_prefix_length(snapshot_prefix)
            if prefix_length == 0 or source_unit.len == 0:
                return PartCachePreparedSet{status: PART_CACHE_PREP_UNSUPPORTED, logical_shards: 0, ownership_version: PART_CACHE_OWNERSHIP_VERSION, shards: []}
            unit_namespace: PartSymbolNamespace = part_symbol_namespace(source_unit)
            if LLVMVerifyModule(m, PART_VERIFY_RETURN_STATUS, null) != 0:
                return PartCachePreparedSet{status: PART_CACHE_PREP_FAILED, logical_shards: 0, ownership_version: PART_CACHE_OWNERSHIP_VERSION, shards: []}
            owners_opt: PartCacheOwnerAnalysis? = part_cache_stable_owners(m)
            if owners_opt is owners:
                shards: mutable darray[PartCachePreparedShard] = []
                shards.reserve(owners.logical_shards)
                keep_snapshots: mutable bool = false
                defer block:
                    if not keep_snapshots:
                        part_cache_remove_snapshots(shards)
                for logical_shard in 0..<owners.logical_shards |shards, owners|:
                    if part_cache_prepare_one_shard(m, owners.function_owners, owners.global_owners, snapshot_prefix, prefix_length, logical_shard, unit_namespace) is prepared:
                        shards.push(prepared)
                    else:
                        return PartCachePreparedSet{status: PART_CACHE_PREP_FAILED, logical_shards: owners.logical_shards, ownership_version: PART_CACHE_OWNERSHIP_VERSION, shards: []}
                keep_snapshots <- true
                return PartCachePreparedSet{status: PART_CACHE_PREP_READY, logical_shards: owners.logical_shards, ownership_version: PART_CACHE_OWNERSHIP_VERSION, shards: shards}
            return PartCachePreparedSet{status: PART_CACHE_PREP_UNSUPPORTED, logical_shards: 0, ownership_version: PART_CACHE_OWNERSHIP_VERSION, shards: []}

    private:
        # Applies the existing partition linkage rules to a clone, but strips every
        # foreign body. The live O0 parallel emitter keeps its COW-friendly path below.
        def part_cache_restrict_module(m: LLVMModuleRef, function_owners: darray[i64]&, global_owners: darray[i64]&, part: i64, unit_namespace: PartSymbolNamespace) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            ordinal: mutable i64 = 0
            global_index: mutable usize = 0
            global_opt: mutable LLVMValueRef? = LLVMGetFirstGlobal(m)
            while global_opt is global_value |ordinal, global_index, global_opt, part, global_owners|:
                owner: i64 = global_owners[global_index]
                if owner >= 0:
                    part_cache_externalize(global_value, ordinal, unit_namespace)
                    if owner != part:
                        elisa_part_clear_initializer(global_value, null)
                        LLVMSetLinkage(global_value, PART_LINKAGE_EXTERNAL)
                ordinal <- ordinal + 1
                global_index <- global_index + 1
                global_opt <- LLVMGetNextGlobal(global_value)
            function_index: mutable usize = 0
            function_opt: mutable LLVMValueRef? = LLVMGetFirstFunction(m)
            while function_opt is function |ordinal, function_index, function_opt, function_owners, part|:
                owner: i64 = function_owners[function_index]
                if owner >= 0:
                    part_cache_externalize(function, ordinal, unit_namespace)
                    if owner != part:
                        part_strip_body(function)
                ordinal <- ordinal + 1
                function_index <- function_index + 1
                function_opt <- LLVMGetNextFunction(function)

    public:
        def dispose_part_cache_shards(prepared: mutable PartCachePreparedSet&) -> void:
            part_cache_remove_snapshots(prepared.shards)
            prepared.shards.clear()
            prepared.status <- PART_CACHE_PREP_UNSUPPORTED

    private:
        def part_linkage_is_local(linkage: u32) -> bool:
            linkage == PART_LINKAGE_INTERNAL or linkage == PART_LINKAGE_PRIVATE

        def part_linkage_is_partitioned(linkage: u32) -> bool:
            linkage == PART_LINKAGE_EXTERNAL or part_linkage_is_local(linkage)

        def part_function_weight(f: LLVMValueRef) -> i64:
            weight: mutable i64 = 0
            block_opt: mutable LLVMBasicBlockRef? = LLVMGetFirstBasicBlock(f)
            while block_opt is block |weight, block_opt|:
                inst_opt: mutable LLVMValueRef? = LLVMGetFirstInstruction(block)
                while inst_opt is inst |weight, inst_opt|:
                    weight <- weight + 1
                    inst_opt <- LLVMGetNextInstruction(inst)
                block_opt <- LLVMGetNextBasicBlock(block)
            weight

        # A defined function this pass distributes; everything else stays as it is.
        def part_function_owned(f: LLVMValueRef) -> bool:
            return false if LLVMIsDeclaration(f) != 0
            part_linkage_is_partitioned(LLVMGetLinkage(f))

        # A defined global with exactly one owner: mutable or visible globals, plus
        # local constants whose addresses may be significant. Duplicating such a
        # constant across objects can make pointer equality depend on partitioning.
        def part_global_owned(g: LLVMValueRef) -> bool:
            return false if LLVMIsDeclaration(g) != 0
            linkage: u32 = LLVMGetLinkage(g)
            part_linkage_is_partitioned(linkage)

        # A local symbol becomes a hidden external for references between shards.
        # Cross-unit cache snapshots use part_cache_externalize below.
        def part_externalize(value: LLVMValueRef, ordinal: i64) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            linkage: u32 = LLVMGetLinkage(value)
            return if not part_linkage_is_local(linkage)
            name_length: mutable usize = 0
            name_bytes: u8& = LLVMGetValueName2(value, &name_length)
            renamed: mutable darray[u8] = []
            emit_tokens_push_sview_backend(renamed, "elisa.part.")
            if name_length == 0:
                emit_tokens_push_sview_backend(renamed, "anon.")
                part_push_decimal(renamed, ordinal)
            else:
                for name_index in 0..<name_length |renamed, name_bytes|:
                    byte_ref: u8& = name_bytes + name_index
                    renamed.push(byte_ref)
            renamed_length: usize = renamed.count
            renamed.push(0)
            LLVMSetValueName2(value, (&renamed[0]).cast[cstr], renamed_length)
            LLVMSetLinkage(value, PART_LINKAGE_EXTERNAL)
            LLVMSetVisibility(value, PART_VISIBILITY_HIDDEN)

        # Cache snapshots may be linked with objects from other source units. Give
        # each local symbol a stable namespace derived from the canonical source path;
        # the live parallel-emission path keeps its established partition-local names.
        def part_cache_externalize(value: LLVMValueRef, ordinal: i64, unit_namespace: PartSymbolNamespace) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            linkage: u32 = LLVMGetLinkage(value)
            return if not part_linkage_is_local(linkage)
            name_length: mutable usize = 0
            name_bytes: u8& = LLVMGetValueName2(value, &name_length)
            renamed: mutable darray[u8] = []
            emit_tokens_push_sview_backend(renamed, "elisa.part.")
            part_push_hex_u64(renamed, unit_namespace.high)
            part_push_hex_u64(renamed, unit_namespace.low)
            emit_tokens_push_sview_backend(renamed, ".")
            if name_length == 0:
                emit_tokens_push_sview_backend(renamed, "anon.")
                part_push_decimal(renamed, ordinal)
            else:
                for name_index in 0..<name_length |renamed, name_bytes|:
                    byte_ref: u8& = name_bytes + name_index
                    renamed.push(byte_ref)
            renamed_length: usize = renamed.count
            renamed.push(0)
            LLVMSetValueName2(value, (&renamed[0]).cast[cstr], renamed_length)
            LLVMSetLinkage(value, PART_LINKAGE_EXTERNAL)
            LLVMSetVisibility(value, PART_VISIBILITY_HIDDEN)

        def part_push_decimal(buffer: mutable darray[u8]&, value: i64) -> void can[Abort.Panic, Memory.Allocate]:
            digits: mutable darray[u8] = []
            remaining: mutable i64 = value
            digits.push(48) if remaining == 0
            while remaining > 0 |remaining, digits|:
                digits.push((48 + remaining % 10).u8())
                remaining <- remaining / 10
            index: mutable usize = digits.count
            while index > 0 |index, buffer, digits|:
                index <- index - 1
                buffer.push(digits[index])

        def emit_tokens_push_sview_backend(buffer: mutable darray[u8]&, text: sview) -> void can[Abort.Panic, Memory.Allocate]:
            for text_index in 0..<text.len |buffer, text|:
                buffer.push(text[text_index])

        # Instruction weight (+1) of every function the pass distributes, in module order;
        # -1 for one it leaves alone.
        def part_function_weights(m: LLVMModuleRef) -> darray[i64] can[Abort.Panic, Memory.Allocate]:
            weights: mutable darray[i64] = []
            function_opt: mutable LLVMValueRef? = LLVMGetFirstFunction(m)
            while function_opt is function |weights, function_opt|:
                weight: i64 = part_function_weight(function) + 1 if part_function_owned(function) else -1
                weights.push(weight)
                function_opt <- LLVMGetNextFunction(function)
            weights

        def part_total_weight(weights: darray[i64]&) -> i64 can[Abort.Panic]:
            total: mutable i64 = 0
            for weight in weights |total|:
                total <- total + weight if weight > 0
            total

        # Workers worth forking for TOTAL instructions: each costs a fork, a code generator
        # set-up and a part file for `ld -r` (~1 ms), which dominated small units (a 30-line
        # file spent 26 ms of 50 in 32-way emission, 3 ms serially).
        def part_effective_jobs(total: i64, jobs: i64) -> i64:
            useful: i64 = total / PART_MIN_WEIGHT_PER_JOB
            return 1 if useful < 1
            useful if useful < jobs else jobs

        # Turn a definition into a declaration. strip_function_body erases every
        # instruction of every block before deleting any block: deleting block k while a
        # later block's branch still names it corrupted the heap in every forked child.
        def part_strip_body(f: LLVMValueRef) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            strip_function_body(f)
            elisa_part_clear_personality(f, null) if LLVMHasPersonalityFn(f) != 0

        # Owner of every function, in module order (-1: not partitioned).
        def part_function_owners(weights: darray[i64]&, total: i64, jobs: i64) -> darray[i64] can[Abort.Panic, Memory.Allocate]:
            owners: mutable darray[i64] = []
            prefix: mutable i64 = 0
            for weight in weights |owners, prefix, total, jobs|:
                if weight < 0:
                    owners.push(-1)
                else:
                    owner: mutable i64 = (prefix * jobs) / total if total > 0 else 0
                    owner <- jobs - 1 if owner >= jobs
                    owners.push(owner)
                    prefix <- prefix + weight
            owners

        # Rewrite the module into partition `part` of `jobs` (runs in the forked child).
        def part_restrict_module(m: LLVMModuleRef, owners: darray[i64]&, part: i64, strip: bool) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            ordinal: mutable i64 = 0
            global_opt: mutable LLVMValueRef? = LLVMGetFirstGlobal(m)
            while global_opt is global_value |ordinal, global_opt, part|:
                if part_global_owned(global_value):
                    part_externalize(global_value, ordinal)
                    if part != 0:
                        elisa_part_clear_initializer(global_value, null)
                        LLVMSetLinkage(global_value, PART_LINKAGE_EXTERNAL)
                ordinal <- ordinal + 1
                global_opt <- LLVMGetNextGlobal(global_value)
            function_index: mutable usize = 0
            function_opt: mutable LLVMValueRef? = LLVMGetFirstFunction(m)
            while function_opt is function |ordinal, function_index, function_opt, owners, part|:
                owner: i64 = owners[function_index]
                if owner >= 0:
                    part_externalize(function, ordinal)
                    # Unoptimised: another partition's function stays a body the code
                    # generator skips (MachineFunctionPass never runs on available_externally
                    # functions); erasing it instead touched every page of the module in every
                    # child (copy-on-write) and was most of each worker's time. An optimising
                    # target machine still runs its IR-level passes (CodeGenPrepare, LSR, ...)
                    # over every body, so there the body is erased.
                    if owner != part:
                        if strip:
                            part_strip_body(function)
                        else:
                            LLVMSetLinkage(function, PART_LINKAGE_AVAILABLE_EXTERNALLY)
                ordinal <- ordinal + 1
                function_index <- function_index + 1
                function_opt <- LLVMGetNextFunction(function)
            alias_cstr_opt: mutable cstr? = LLVMGetFirstGlobalAlias(m)
            while alias_cstr_opt is alias_cstr |alias_cstr_opt|:
                alias: LLVMValueRef = alias_cstr.cast[LLVMValueRef] can Unsafe.PointerCast
                aliasee: LLVMValueRef = LLVMAliasGetAliasee(alias)
                if LLVMIsDeclaration(aliasee) != 0 or LLVMGetLinkage(aliasee) == PART_LINKAGE_AVAILABLE_EXTERNALLY:
                    LLVMReplaceAllUsesWith(alias, aliasee)
                    LLVMSetLinkage(alias, PART_LINKAGE_PRIVATE)
                alias_cstr_opt <- LLVMGetNextGlobalAlias(alias_cstr)

        # Runs in a forked child and never returns: serve parts [first, stop). While more than
        # one part is left, fork a child for the upper half and keep the lower; then emit
        # the one remaining part and wait for every child this process forked. The exit
        # status is 0 only when this part and every part below it in the tree were written.
        def part_fork_range(machine: void&, m: LLVMModuleRef, path: cstr, owners: darray[i64]&, first: i64, stop: i64, strip: bool) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            low: mutable i64 = first
            high: mutable i64 = stop
            kids: mutable darray[i32] = []
            while high - low > 1 |low, high, kids|:
                middle: i64 = low + (high - low) / 2
                kid: i32 = fork()
                if kid == 0:
                    kids.truncate(0)
                    low <- middle
                else:
                    kids.push(kid)
                    high <- middle
            part_restrict_module(m, owners, low, strip)
            child_path: darray[u8] = part_path(path, low)
            ok: mutable bool = emit_object(machine, m, (&child_path[0]).cast[cstr])
            for kid in kids |ok|:
                if kid < 0:
                    ok <- false
                else:
                    status: mutable i32 = 0
                    waited: i32 = waitpid(kid, &status, 0)
                    ok <- false if waited != kid or status != 0
            _exit(0 if ok else 1)

        def part_path(out_path: cstr, part: i64) -> darray[u8] can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            path: mutable darray[u8] = []
            part_push_cstr(path, out_path)
            emit_tokens_push_sview_backend(path, ".part")
            part_push_decimal(path, part)
            emit_tokens_push_sview_backend(path, ".o")
            path.push(0)
            path

        # Append the bytes of a NUL-terminated string (without the terminator).
        def part_push_cstr(buffer: mutable darray[u8]&, text: cstr) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            bytes: u8& = text.cast[u8&]
            index: mutable usize = 0
            while true |index, bytes, buffer|:
                byte_ref: u8& = bytes + index
                byte_value: u8 = byte_ref
                break if byte_value == 0
                buffer.push(byte_value)
                index <- index + 1

        def part_shell_quote(buffer: mutable darray[u8]&, path: darray[u8]&) -> void can[Abort.Panic, Memory.Allocate]:
            buffer.push(39)
            for path_byte in path |buffer|:
                continue if path_byte == 0
                if path_byte == 39:
                    emit_tokens_push_sview_backend(buffer, "'\\''")
                else:
                    buffer.push(path_byte)
            buffer.push(39)

    public:
        # ELISA_STAGE1_JOBS, clamped to 1..64; 1 when unset or malformed.
        def parallel_emit_jobs() -> i64 can[Abort.Panic, Unsafe.PointerCast]:
            if getenv("ELISA_STAGE1_JOBS") is jobs_text:
                jobs_bytes: u8& = jobs_text.cast[u8&]
                jobs: mutable i64 = 0
                index: mutable usize = 0
                while true |jobs, index, jobs_bytes|:
                    byte_ref: u8& = jobs_bytes + index
                    digit: u8 = byte_ref
                    break if digit < 48 or digit > 57
                    jobs <- jobs * 10 + (digit - 48).i64()
                    break if jobs > 64
                    index <- index + 1
                return 64 if jobs > 64
                return 1 if jobs < 1
                return jobs
            1

        # Emit `m` to `path` with `jobs` forked code generators; serial when jobs <= 1.
        # The module is unchanged in the parent.
        # OPTIMIZED: `machine` was configured above -O0 (see part_restrict_module).
        def emit_object_parallel(machine: void&, m: LLVMModuleRef, path: cstr, requested_jobs: i64, optimized: bool) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Blocking.IO]:
            return (emit_object_parallel_status(machine, m, path, requested_jobs, false, optimized) can Global.Write) == 0

        # emit_object_parallel for a module NOT yet verified: the LLVM verifier runs first,
        # before any worker forks (overlapping it with the workers let rejected IR reach
        # instruction selection). 0 = written, 2 = the verifier rejected the module
        # (its diagnostic is printed; no object is written), 4 = emission failed. For an
        # unoptimised machine only. A serial
        # emission verifies first, exactly as before.
        def emit_object_parallel_verifying(machine: void&, m: LLVMModuleRef, path: cstr, requested_jobs: i64) -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Blocking.IO]:
            return emit_object_parallel_status(machine, m, path, requested_jobs, true, false) can Global.Write

        def emit_object_parallel_status(machine: void&, m: LLVMModuleRef, path: cstr, requested_jobs: i64, verify: bool, optimized: bool) -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Blocking.IO]:
            jobs: mutable i64 = requested_jobs
            weights: mutable darray[i64] = []
            total: mutable i64 = 0
            if requested_jobs > 1:
                weights <- part_function_weights(m)
                total <- part_total_weight(weights)
                jobs <- part_effective_jobs(total, requested_jobs)
            # Verify before any worker forks: instruction selection over IR the verifier rejects
            # can crash or hang LLVM, and a hung worker would block the waitpid below.
            return 2 if verify and LLVMVerifyModule(m, PART_VERIFY_PRINT_MESSAGE, null) != 0
            if jobs <= 1:
                return 0 if emit_object(machine, m, path)
                return 4
            owners: darray[i64] = part_function_owners(weights, total, jobs)
            # The workers are forked as a tree (part_fork_range): a fork of the whole compiler
            # copies its page tables (~65 ms for the self-host unit), so 32 forks in a row
            # from the parent put ~2 s before the last worker started.
            children: mutable darray[i32] = []
            root_child: i32 = fork()
            # The worker tree gets its own process group, so a failure can stop every worker,
            # orphans of a dead mid-tree worker included, before the part files are unlinked.
            if root_child == 0:
                _ = setpgid(0, 0)
                part_fork_range(machine, m, path, owners, 0, jobs, optimized)
            if root_child > 0:
                _ = setpgid(root_child, root_child)
            children.push(root_child)
            all_ok: mutable bool = true
            for child in children |all_ok|:
                if child < 0:
                    all_ok <- false
                else:
                    status: mutable i32 = 0
                    waited: i32 = waitpid(child, &status, 0)
                    all_ok <- false if waited != child or status != 0
            if not all_ok and root_child > 0:
                _ = kill_backend(0 - root_child, PART_SIGKILL)
            command: mutable darray[u8] = []
            if getenv("ELISA_LD") is linker_text:
                part_push_cstr(command, linker_text.cast[cstr])
            else:
                emit_tokens_push_sview_backend(command, "ld")
            emit_tokens_push_sview_backend(command, " -r -o ")
            out_storage: mutable darray[u8] = []
            part_push_cstr(out_storage, path)
            part_shell_quote(command, out_storage)
            for part in 0..<jobs.usize() |command, path|:
                command.push(32)
                part_file: darray[u8] = part_path(path, part.i64())
                part_shell_quote(command, part_file)
            command.push(0)
            if all_ok:
                # The include line map can outgrow one exec string, and `system` then fails
                # with E2BIG before the shell starts; `ld -r` never reads it.
                line_map: mutable darray[u8] = []
                line_map_hidden: bool = Lexer::line_map_suspend(&line_map) can Global.Write
                all_ok <- system_backend((&command[0]).cast[cstr]) == 0
                Lexer::line_map_resume(&line_map, line_map_hidden) can Global.Write
            for part in 0..<jobs.usize() |path|:
                part_file: darray[u8] = part_path(path, part.i64())
                _ = unlink_backend((&part_file[0]).cast[cstr])
            return 0 if all_ok
            return 4

@link_name("system")
extern system_backend(command: cstr) -> i32
@link_name("unlink")
extern unlink_backend(path: cstr) -> i32
