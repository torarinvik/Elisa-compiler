# Pure representation decisions for optional values. The backend's LLVM operations consume
# this policy so the niche/tag split and tagged null-presence rule can be proved independently.
module BackendOptionalRepresentationPolicy:
    public:
        # Pointer-like payloads use null as the absent value, so no separate tag is needed.
        def pointer_payload_uses_niche(is_ref: bool, is_cstr: bool, is_fn: bool, is_pyobject: bool) -> bool:
            ensure result == (is_ref or is_cstr or is_fn or is_pyobject)
            return is_ref or is_cstr or is_fn or is_pyobject

        # When a tagged optional is required, nullable payloads need a null-derived tag.
        # Non-null references can keep the constant-present tag unless forced by a cast.
        def tagged_payload_needs_null_test(force_null_test: bool, is_cstr: bool, is_heap_ref: bool) -> bool:
            ensure result == (force_null_test or is_cstr or is_heap_ref)
            return force_null_test or is_cstr or is_heap_ref
