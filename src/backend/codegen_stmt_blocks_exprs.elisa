# Stage1 backend — `emit_statement`: prefix blocks (`region`/`can`/`in`…), contracts and expression statements.
# A group of the statement emitter's branches, called from codegen_statement.elisa.
# `handled` is set TRUE on entry and cleared only if no branch here matched, so a branch
# that DECLINES still stops the dispatch — exactly as it did when every branch shared one
# function body.

extend Backend:
    private:
        # Whether a loop-header YIELD name is one the block actually binds: a bare capture
        # (`|acc|`), or an INITIALIZED accumulator (`|n = 0|`), which the parser records as an
        # untyped VarDecl and deliberately does NOT add to the capture list.
        def block_yield_name_is_bound(name: sview, captures: darray[sview]&, statements: darray[Stmt]&) -> bool can[Abort.Panic]:
            for capture_name in captures |name|:
                true return if capture_name == name
            # ANY VarDecl among these statements is a header accumulator — the block is exactly
            # `[accumulator decls…, the loop]`. Both the untyped form (`|n = 0|`) and the TYPED
            # form (`|position: usize = 0|`) count; keying on untyped only missed the latter.
            for candidate in statements |name|:
                match candidate:
                    Stmt.VarDecl(byn_decl_name, byn_decl_type, byn_decl_value, byn_decl_line):
                        true return if byn_decl_name == name
                    _:
                        pass
            return false


        def emit_statement_blocks_exprs(statement: Stmt, return_type: ValueType, local_scope: mutable Scope&, loops: mutable LoopStack&, regions: mutable RegionStack&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef, handled: mutable bool&) -> EmitStatus can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            handled <- true
            # `xs.push(v)` — a statement-position method call on a darray.
            # `region r:` — a NAMED, SCOPED region. stage0 emits `%r = alloca %Arena`,
            # allocates the block's containers from it (`arena_alloc(ptr %r, ...)`), and
            # arena_free's it at scope exit. Structurally the same thing emit_function_body
            # builds for a function's implicit auto region, so it reuses that shape and just
            # swaps which arena the block's statements allocate from.
            #
            # ONLY `region` is handled here. Every other Stmt.Block kind (`can ...:`,
            # `catch ...:`, arms) declines: `kind` is an opaque sview, so quietly treating an
            # unknown block as "just run the body" would silently drop the very semantics the
            # prefix carries. `region NAME(capacity):` likewise declines -- the capacity
            # lands in `clause` alongside the name and is not modeled.
            match statement:
                Stmt.Block(block_kind, block_clause, block_binding, block_body, block_line):
                    declined_status: EmitStatus = EmitStatus.Declined
                    if block_kind == "defer" and block_clause.count > 0 and (block_clause[0] == "function" or block_clause[0] == "block"):
                        local_scope.deferred <- local_scope.deferred.push(DeferredAction{body: [], names: [], slots: [], types: [], scope_exit: block_clause[0] == "block"})
                        deferred_index: usize = local_scope.deferred.count - 1
                        local_scope.deferred[deferred_index].body.extend(block_body)
                        local_scope.deferred[deferred_index].names.extend(local_scope.names)
                        local_scope.deferred[deferred_index].slots.extend(local_scope.slots)
                        local_scope.deferred[deferred_index].types.extend(local_scope.types)
                        return EmitStatus.Open
                    # `lock mu as g:` — a scoped MUTEX guard. stage0's shape, read off its IR:
                    # `g = mutex_lock(&mu)`, then on EVERY exit path load `g`, test the guard
                    # handle against null, and if it is live zero `g` and call `mutex_unlock(g)`.
                    #
                    # That IS defer semantics with a null-guard, so the unlock is registered as a
                    # DeferredAction rather than appended after the body: an early `return` inside
                    # the lock unwinds through the same path a `defer block:` takes, instead of
                    # skipping a trailing unlock and leaking the lock.
                    if block_kind == "lock" and block_clause.count == 1 and block_binding != "":
                        lock_target: Expr = Expr.Ident(block_clause[0], block_line)
                        lock_call: Expr = Expr.Call((Expr.Ident("mutex_lock", block_line)), [(Expr.Unary(TokenKind.Ampersand, lock_target, block_line))], [], block_line)
                        lock_guard_type: ValueType = expression_type(lock_call, local_scope, fns, structs, generics)
                        declined_status return if lock_guard_type.kind == TypeKind.Unmodeled
                        if emit_expression(lock_call, lock_guard_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is lock_guard_value:
                            lock_guard_storage: mutable darray[u8] = []
                            lock_guard_slot: LLVMValueRef = LLVMBuildAlloca(builder, llvm_type_of(lock_guard_type, structs, ctx), sview_to_cstr(block_binding, lock_guard_storage))
                            _ = LLVMBuildStore(builder, lock_guard_value, lock_guard_slot)
                            declare_local(local_scope, block_binding, lock_guard_slot, lock_guard_type)
                            lock_unlock_body: mutable darray[Stmt] = [(Stmt.Expr((Expr.Call((Expr.Ident("mutex_unlock", block_line)), [(Expr.Ident(block_binding, block_line))], [], block_line)), block_line))]
                            lock_mark: usize = local_scope.deferred.count
                            local_scope.deferred <- local_scope.deferred.push(DeferredAction{body: [], names: [], slots: [], types: [], scope_exit: true})
                            local_scope.deferred[lock_mark].body.extend(lock_unlock_body)
                            local_scope.deferred[lock_mark].names.extend(local_scope.names)
                            local_scope.deferred[lock_mark].slots.extend(local_scope.slots)
                            local_scope.deferred[lock_mark].types.extend(local_scope.types)
                            lock_status: EmitStatus = emit_statements(block_body, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)
                            declined_status return if lock_status == EmitStatus.Declined
                            # A body that RETURNED already unwound the guard on its way out.
                            if lock_status == EmitStatus.Open:
                                declined_status return if not emit_deferred_actions_from(local_scope, lock_mark, false, fns, structs, generics, runtime, m, ctx, builder)
                            local_scope.deferred <- local_scope.deferred.truncate(lock_mark)
                            return lock_status
                        return declined_status
                    # `static if/elif/else` in statement position: the parser keeps every
                    # branch's body, so an UNTAKEN branch must emit NOTHING -- its body may
                    # declare the same locals as the taken one, or call externs that only exist
                    # on another target. A taken branch (and a bare `static:` block, whose line
                    # is in neither table) emits inline into the enclosing scope, which is
                    # stage0's scoping: a local declared in a taken branch is visible after
                    # the chain (arena.elisa binds `r` this way).
                    # `static assert COND` — captured into the static-assert registry at parse
                    # time and const-evaluated by the semantic layer; at runtime it is NOTHING.
                    if block_kind == "static_assert":
                        return EmitStatus.Open
                    if block_kind == "static":
                        is_static_branch: bool = static_branch_is_taken(structs.static_branch_lines, block_line.line)
                        static_kept: bool = static_branch_is_taken(structs.static_taken_lines, block_line.line) if is_static_branch else true
                        EmitStatus.Open return if not static_kept
                        # A CALL to a `static def` is compile-time only: stage0 evaluates it
                        # during static execution and emits NOTHING for it (`static: answer(2)`
                        # lowers to an empty `keep()`, with no `@answer` in the module at all).
                        # select_module_declarations already drops `static def` declarations, so
                        # such a callee has no FnTable entry -- the call could not be emitted and
                        # took the whole enclosing function down with it.
                        #
                        # Drop those call statements and emit the rest, which keeps the reason
                        # this block emits inline at all: a local declared in a taken `static if`
                        # branch stays visible afterwards.
                        #
                        # Scoped to `static` bodies, where code IS compile-time by definition. An
                        # unresolved call anywhere else still declines -- the frontend has already
                        # rejected genuinely undefined names, so inside `static` a missing entry
                        # means exactly "filtered static def".
                        # A BARE `static:` block is compile-time in its entirety: stage0 emits an
                        # empty function for one (`keep()` is a bare `ret void`, with no check and
                        # no trap). stage1 kept each statement as a RUNTIME statement, which is why
                        # `static: assert size_of[Header]() == 16` emitted a real assert — and why
                        # TWO of them, or a bare `assert offset_of[…]`, declined.
                        #
                        # (`assert` reaches here as a `Stmt.Expr`, not a `Stmt.Contract`: the
                        # contract parse requires an IDENT after `assert`, and `size_of`/`offset_of`
                        # lex as their own token kinds, so the statement falls through to an
                        # expression. Filtering by statement shape could not have caught it.)
                        #
                        # Only the bare form. A TAKEN `static if` branch still emits inline, which
                        # is what keeps a local declared there visible afterwards (arena.elisa
                        # binds `r` that way).
                        EmitStatus.Open return if not is_static_branch
                        static_runtime_body: mutable darray[Stmt] = []
                        for static_statement in block_body |static_runtime_body, fns|:
                            static_is_compile_time: mutable bool = false
                            match static_statement:
                                Stmt.Expr(static_expression, static_expression_line):
                                    match static_expression:
                                        Expr.Call(static_callee, static_args, static_arg_names, static_call_line):
                                            match static_callee:
                                                Expr.Ident(static_callee_name, static_callee_line):
                                                    static_is_compile_time <- function_index_of(fns, "", static_callee_name) < 0
                                                _:
                                                    pass
                                        _:
                                            pass
                                _:
                                    pass
                            static_runtime_body.push(static_statement) if not static_is_compile_time
                        return emit_statements(static_runtime_body, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)
                    # `in owner:` — make an EXISTING arena the active one for the block. stage0
                    # requires this before a container can be built from an explicit `Arena`
                    # parameter ("darray push requires an active in <arena>: scope"): passing an
                    # arena does not make it the allocation target, activating it does.
                    #
                    # The arena is BORROWED, so owns_arena is false and nothing here frees it --
                    # it belongs to whoever opened it.
                    if block_kind == "in":
                        declined_status return if block_clause.count != 1
                        # `in auto:` — DEPRECATED, and transparent. stage0 still compiles it
                        # (its deprecation says "remove the block and rely on region
                        # inference"), so the block is equivalent to its own body: the ambient
                        # inferred region already backs everything inside it.
                        #
                        # `auto` is not a type, so the lookup below found nothing and the whole
                        # function DECLINED — a program stage0 compiles produced no object at
                        # all here.
                        if block_clause[0] == "auto":
                            return emit_statements(block_body, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)
                        in_type: ValueType = lookup_type(local_scope, block_clause[0])
                        # `in store:` — make a packed STORE active. Every packed constructor in
                        # the block allocates its row from this store.
                        if in_type.kind == TypeKind.PackedStore:
                            if lookup_slot(local_scope, block_clause[0]) is store_slot:
                                store_runtime: mutable Runtime = copied_runtime(runtime)
                                store_runtime.active_store <- LLVMBuildLoad2(builder, llvm_type_of(in_type, structs, ctx), store_slot, "store.active")
                                store_runtime.active_store_enum <- in_type.bits.i64()
                                store_runtime.active_store_is_block <- true
                                return emit_statements(block_body, return_type, local_scope, loops, regions, fns, structs, generics, store_runtime, m, ctx, builder)
                            return declined_status
                        # `in owner:` where owner is a BORROWED arena (`owner: mutable Arena&`) — the
                        # common case in std container ctors (IndexMap/InlineVec take `owner: Arena&`).
                        # The parameter slot holds a POINTER to the caller's arena, so load it and make
                        # that the active allocation target (vs a direct `Arena` local, whose slot IS
                        # the arena storage).
                        if in_type.kind == TypeKind.Ref and ref_target_of(in_type, structs).kind == TypeKind.Arena:
                            if lookup_slot(local_scope, block_clause[0]) is in_ref_slot:
                                in_ref_runtime: mutable Runtime = copied_runtime(runtime)
                                in_ref_runtime.arena <- LLVMBuildLoad2(builder, LLVMPointerTypeInContext(ctx, 0), in_ref_slot, "in.arena.ref")
                                in_ref_runtime.owns_arena <- false
                                return emit_statements(block_body, return_type, local_scope, loops, regions, fns, structs, generics, in_ref_runtime, m, ctx, builder)
                            return declined_status
                        declined_status return if in_type.kind != TypeKind.Arena
                        if lookup_slot(local_scope, block_clause[0]) is in_slot:
                            in_runtime: mutable Runtime = copied_runtime(runtime)
                            in_runtime.arena <- in_slot
                            in_runtime.owns_arena <- false
                            # Same frame bookkeeping as `region`: containers declared OUTSIDE the
                            # block keep growing from their declaration arena.
                            local_scope.region_frame_starts <- local_scope.region_frame_starts.push(local_scope.names.count)
                            local_scope.region_frame_arenas <- local_scope.region_frame_arenas.push(in_slot)
                            local_scope.region_frame_outers <- local_scope.region_frame_outers.push(runtime.arena)
                            in_status: EmitStatus = emit_statements(block_body, return_type, local_scope, loops, regions, fns, structs, generics, in_runtime, m, ctx, builder)
                            local_scope.region_frame_starts <- local_scope.region_frame_starts.truncate(local_scope.region_frame_starts.count - 1)
                            local_scope.region_frame_arenas <- local_scope.region_frame_arenas.truncate(local_scope.region_frame_arenas.count - 1)
                            local_scope.region_frame_outers <- local_scope.region_frame_outers.truncate(local_scope.region_frame_outers.count - 1)
                            return in_status
                        return declined_status
                    # `trusted X:` / `can X:` — a trust/effect-grant wrapper. The grant is a
                    # COMPILE-TIME assertion (the frontend proves it); there is no runtime
                    # lowering, so the body simply runs in the current scope. The std dict's
                    # probe loops sit inside `trusted Unsafe.AssumeProgress:`.
                    # `assert C by TACTIC:` and `proof C:` both parse to this block, with the GOAL
                    # riding as `body[0]` (a Stmt.Contract) and the proof steps after it. The proof
                    # is discharged by the semantic layer (check_assert_by) and ERASED here -- stage0
                    # lowers the goal as an ordinary runtime contract check and emits nothing at all
                    # for the body, whose statements are lemma calls and nested asserts that exist
                    # only to justify the goal.
                    if block_kind == "assert_by":
                        declined_status return if block_body.count == 0
                        return emit_statement(block_body[0], return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)
                    if block_kind == "trusted" or block_kind == "can":
                        # Permission blocks are lexical blocks in stage0 as well as
                        # compile-time grants. Keeping the body in the current backend
                        # scope made a machine transition's arm alias shadow the scalar
                        # destination field after the transition scope was supposed to
                        # close. Use the ordinary scoped emitter: it preserves zero runtime
                        # cost while restoring bindings and deferred cleanup at the boundary.
                        return emit_statements_scoped(block_body, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)
                    # `pool workers(N):` and `nursery workers(N):` own a typed ThreadPool for the duration of the
                    # block. The frontend keeps the worker-count expression as the first pool
                    # clause entry; the source-level runtime functions provide the actual pool
                    # implementation, so this lowering stays ABI-compatible with both the
                    # std runtime and small backend fixtures.
                    # `scope pool_new(2):` — a SCOPE GUARD. stage0 evaluates the expression into a
                    # guard slot and picks the cleanup from the guard's TYPE; for a `ThreadPool` it
                    # emits exactly the pool block's shutdown, so it runs through this branch with
                    # the constructor taken from the clause instead of being hard-coded. A guard of
                    # any other type declines (the type check below is what enforces it) rather
                    # than being left uncleaned.
                    if block_kind == "pool" or block_kind == "nursery" or block_kind == "scope":
                        scope_guard_block: bool = block_kind == "scope"
                        declined_status return if scope_guard_block and block_clause.count == 0
                        pool_constructor: sview = block_clause[0] if scope_guard_block else "pool_new"
                        pool_binding: mutable sview = block_binding if block_binding != "" else "workers"
                        pool_binding <- "__scope_guard" if scope_guard_block
                        pool_new_type: ValueType = lookup_return_type(fns, "", pool_constructor)
                        pool_shutdown_type: ValueType = lookup_return_type(fns, "", "pool_shutdown")
                        declined_status return if pool_new_type.kind == TypeKind.Unmodeled or pool_shutdown_type.kind == TypeKind.Unmodeled
                        group_new_type: ValueType = lookup_return_type(fns, "", "task_group_new")
                        group_wait_type: ValueType = lookup_return_type(fns, "", "task_group_wait_all")
                        declined_status return if block_kind == "nursery" and (group_new_type.kind == TypeKind.Unmodeled or group_wait_type.kind == TypeKind.Unmodeled)
                        # The worker count. A LITERAL keeps the existing constant lowering exactly;
                        # anything else is passed through as an expression, because the count is
                        # routinely COMPUTED — `nursery workers(nw)` where `nw` came from a default
                        # parameter or a per-input band calculation. Requiring a literal declined
                        # every such block, which is the whole reason for_indices_par was dropped.
                        # A `scope` clause leads with the CONSTRUCTOR name, so it has an argument
                        # only from the second entry on.
                        pool_has_argument: bool = block_clause.count > (1.usize() if scope_guard_block else 0.usize())
                        pool_workers: mutable i64 = 0
                        pool_workers_is_literal: mutable bool = not pool_has_argument
                        if pool_has_argument:
                            pool_workers_is_literal <- parse_int_literal(block_clause[block_clause.count - 1], pool_workers)
                            declined_status return if pool_workers_is_literal and pool_workers < 0
                        # The clause is retained as source TEXT, so a non-literal count is rebuilt as
                        # an Ident reference to that name. A count that is not a bare name declines
                        # through the ordinary unresolved-identifier path rather than being guessed at.
                        pool_arguments: mutable darray[Expr] = [Expr.IntLit(pool_workers)] if pool_workers_is_literal else [(Expr.Ident(block_clause[block_clause.count - 1], block_line))]
                        pool_arguments <- [] if scope_guard_block and not pool_has_argument
                        if emit_call(Expr.Ident(pool_constructor, block_line), pool_arguments, [], local_scope, fns, structs, generics, runtime, m, ctx, builder) is pool_value:
                            pool_storage: mutable darray[u8] = []
                            pool_slot: LLVMValueRef = LLVMBuildAlloca(builder, llvm_type_of(pool_new_type, structs, ctx), sview_to_cstr(pool_binding, pool_storage))
                            _ = LLVMBuildStore(builder, pool_value, pool_slot)
                            declare_local(local_scope, pool_binding, pool_slot, pool_new_type)
                            group_binding: sview = "__nursery_group"
                            if block_kind == "nursery":
                                empty_group_args: darray[Expr] = []
                                if emit_call(Expr.Ident("task_group_new", block_line), empty_group_args, [], local_scope, fns, structs, generics, runtime, m, ctx, builder) is group_value:
                                    group_storage: mutable darray[u8] = []
                                    group_slot: LLVMValueRef = LLVMBuildAlloca(builder, llvm_type_of(group_new_type, structs, ctx), sview_to_cstr(group_binding, group_storage))
                                    _ = LLVMBuildStore(builder, group_value, group_slot)
                                    declare_local(local_scope, group_binding, group_slot, group_new_type)
                                    local_scope.group_names.push(group_binding)
                                else:
                                    return declined_status
                            local_scope.pool_names.push(pool_binding)
                            # Only a ThreadPool guard has a modeled cleanup; anything else would be
                            # emitted and then silently leaked.
                            if scope_guard_block:
                                scope_pool_type: ValueType = lookup_return_type(fns, "", "pool_new")
                                if scope_pool_type.kind != pool_new_type.kind or scope_pool_type.bits != pool_new_type.bits:
                                    _ = local_scope.pool_names.pop()
                                    return declined_status
                            # `pool_shutdown(pool: ThreadPool&)` takes a REFERENCE, and the bare
                            # `pool_shutdown(workers)` form DECLINES -- measured: the same call
                            # written `pool_shutdown(&p)` emits, `pool_shutdown(p)` does not. The
                            # old code passed the bare ident AND discarded the result without an
                            # else, so the call silently emitted NOTHING and the block still
                            # reported success: `pool workers(4):` compiled while leaking the pool.
                            pool_cleanup: mutable darray[Stmt] = []
                            if block_kind == "nursery":
                                pool_cleanup.push((Stmt.Expr((Expr.Call((Expr.Ident("task_group_wait_all", block_line)), [(Expr.Ident(group_binding, block_line))], [], block_line)), block_line)))
                            pool_cleanup.push((Stmt.Expr((Expr.Call((Expr.Ident("pool_shutdown", block_line)), [(Expr.Unary(TokenKind.Ampersand, (Expr.Ident(pool_binding, block_line)), block_line))], [], block_line)), block_line)))
                            # Registered as a DEFERRED action rather than appended after the body:
                            # a body that RETURNS terminates the block, and the old code skipped the
                            # shutdown entirely there on the assumption that an enclosing unwind
                            # emitted it -- nothing does, so `pool workers(4): return 7` leaked too.
                            pool_mark: usize = local_scope.deferred.count
                            local_scope.deferred <- local_scope.deferred.push(DeferredAction{body: [], names: [], slots: [], types: [], scope_exit: true})
                            local_scope.deferred[pool_mark].body.extend(pool_cleanup)
                            local_scope.deferred[pool_mark].names.extend(local_scope.names)
                            local_scope.deferred[pool_mark].slots.extend(local_scope.slots)
                            local_scope.deferred[pool_mark].types.extend(local_scope.types)
                            pool_status: EmitStatus = emit_statements(block_body, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)
                            _ = local_scope.pool_names.pop()
                            if block_kind == "nursery":
                                _ = local_scope.group_names.pop()
                            if pool_status == EmitStatus.Declined:
                                local_scope.deferred <- local_scope.deferred.truncate(pool_mark)
                                return declined_status
                            # An OPEN body runs the cleanup here; a TERMINATED one already unwound
                            # it on the way out. A cleanup that fails to emit DECLINES.
                            pool_emitted: mutable bool = true
                            if pool_status == EmitStatus.Open:
                                pool_emitted <- emit_deferred_actions_from(local_scope, pool_mark, false, fns, structs, generics, runtime, m, ctx, builder)
                            local_scope.deferred <- local_scope.deferred.truncate(pool_mark)
                            declined_status return if not pool_emitted
                            return pool_status
                        return declined_status
                    return emit_statement_binding_blocks(block_kind, block_clause, block_binding, block_body, block_line, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)

                _:
                    pass
            return emit_statement_expr(statement, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder, handled)
include "./codegen_stmt_binding_blocks.elisa"

include "./codegen_stmt_expr.elisa"
include "./codegen_stmt_expr_calls.elisa"
