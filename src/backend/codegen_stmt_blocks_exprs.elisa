# Stage1 backend — `emit_statement`: prefix blocks (`region`/`can`/`in`…), contracts and expression statements.
# A group of the statement emitter's branches, called from codegen_statement.elisa.
# `handled` is set TRUE on entry and cleared only if no branch here matched, so a branch
# that DECLINES still stops the dispatch — exactly as it did when every branch shared one
# function body.

extend Backend:
    private:
        # Whether a loop-header YIELD name is one the block actually binds: a bare capture
        # (`|acc|`), or an INITIALIZED accumulator (`|n = 0|`), which the parser records as an
        # untyped VarDecl and deliberately does NOT add to the capture list.
        def block_yield_name_is_bound(name: sview, captures: darray[sview]&, statements: darray[Stmt]&) -> bool can[Abort.Panic]:
            for capture_name in captures |name|:
                true return if capture_name == name
            # ANY VarDecl among these statements is a header accumulator — the block is exactly
            # `[accumulator decls…, the loop]`. Both the untyped form (`|n = 0|`) and the TYPED
            # form (`|position: usize = 0|`) count; keying on untyped only missed the latter.
            for candidate in statements |name|:
                if candidate is Stmt.VarDecl(byn_decl_name, byn_decl_type, byn_decl_value, byn_decl_line):
                    true return if byn_decl_name == name
            return false


        def emit_statement_blocks_exprs(statement: Stmt, return_type: ValueType, local_scope: mutable Scope&, loops: mutable LoopStack&, regions: mutable RegionStack&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef, handled: mutable bool&) -> EmitStatus can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            handled <- true
            # `xs.push(v)` — a statement-position method call on a darray.
            # `region r:` — a NAMED, SCOPED region. stage0 emits `%r = alloca %Arena`,
            # allocates the block's containers from it (`arena_alloc(ptr %r, ...)`), and
            # arena_free's it at scope exit. Structurally the same thing emit_function_body
            # builds for a function's implicit auto region, so it reuses that shape and just
            # swaps which arena the block's statements allocate from.
            #
            # ONLY `region` is handled here. Every other Stmt.Block kind (`can ...:`,
            # `catch ...:`, arms) declines: `kind` is an opaque sview, so quietly treating an
            # unknown block as "just run the body" would silently drop the very semantics the
            # prefix carries. `region NAME(capacity):` likewise declines -- the capacity
            # lands in `clause` alongside the name and is not modeled.
            if statement is Stmt.Block(block_kind, block_clause, block_binding, block_body, block_line):
                declined_status: EmitStatus = EmitStatus.Declined
                if block_kind == "defer" and block_clause.count > 0 and (block_clause[0] == "function" or block_clause[0] == "block"):
                    local_scope.deferred <- local_scope.deferred.push(DeferredAction{body: [], names: [], slots: [], types: [], scope_exit: block_clause[0] == "block"})
                    deferred_index: usize = local_scope.deferred.count - 1
                    local_scope.deferred[deferred_index].body.extend(block_body)
                    local_scope.deferred[deferred_index].names.extend(local_scope.names)
                    local_scope.deferred[deferred_index].slots.extend(local_scope.slots)
                    local_scope.deferred[deferred_index].types.extend(local_scope.types)
                    return EmitStatus.Open
                # `lock mu as g:` — a scoped MUTEX guard. stage0's shape, read off its IR:
                # `g = mutex_lock(&mu)`, then on EVERY exit path load `g`, test the guard
                # handle against null, and if it is live zero `g` and call `mutex_unlock(g)`.
                #
                # That IS defer semantics with a null-guard, so the unlock is registered as a
                # DeferredAction rather than appended after the body: an early `return` inside
                # the lock unwinds through the same path a `defer block:` takes, instead of
                # skipping a trailing unlock and leaking the lock.
                if block_kind == "lock" and block_clause.count == 1 and block_binding != "":
                    lock_target: Expr = Expr.Ident(block_clause[0], block_line)
                    lock_call: Expr = Expr.Call((Expr.Ident("mutex_lock", block_line)), [(Expr.Unary(TokenKind.Ampersand, lock_target, block_line))], [], block_line)
                    lock_guard_type: ValueType = expression_type(lock_call, local_scope, fns, structs, generics)
                    declined_status return if lock_guard_type.kind == TypeKind.Unmodeled
                    if emit_expression(lock_call, lock_guard_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is lock_guard_value:
                        lock_guard_storage: mutable darray[u8] = []
                        lock_guard_slot: LLVMValueRef = LLVMBuildAlloca(builder, llvm_type_of(lock_guard_type, structs, ctx), sview_to_cstr(block_binding, lock_guard_storage))
                        _ = LLVMBuildStore(builder, lock_guard_value, lock_guard_slot)
                        declare_local(local_scope, block_binding, lock_guard_slot, lock_guard_type)
                        lock_unlock_body: mutable darray[Stmt] = [(Stmt.Expr((Expr.Call((Expr.Ident("mutex_unlock", block_line)), [(Expr.Ident(block_binding, block_line))], [], block_line)), block_line))]
                        lock_mark: usize = local_scope.deferred.count
                        local_scope.deferred <- local_scope.deferred.push(DeferredAction{body: [], names: [], slots: [], types: [], scope_exit: true})
                        local_scope.deferred[lock_mark].body.extend(lock_unlock_body)
                        local_scope.deferred[lock_mark].names.extend(local_scope.names)
                        local_scope.deferred[lock_mark].slots.extend(local_scope.slots)
                        local_scope.deferred[lock_mark].types.extend(local_scope.types)
                        lock_status: EmitStatus = emit_statements(block_body, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)
                        declined_status return if lock_status == EmitStatus.Declined
                        # A body that RETURNED already unwound the guard on its way out.
                        if lock_status == EmitStatus.Open:
                            declined_status return if not emit_deferred_actions_from(local_scope, lock_mark, false, fns, structs, generics, runtime, m, ctx, builder)
                        local_scope.deferred <- local_scope.deferred.truncate(lock_mark)
                        return lock_status
                    return declined_status
                # `static if/elif/else` in statement position: the parser keeps every
                # branch's body, so an UNTAKEN branch must emit NOTHING -- its body may
                # declare the same locals as the taken one, or call externs that only exist
                # on another target. A taken branch (and a bare `static:` block, whose line
                # is in neither table) emits inline into the enclosing scope, which is
                # stage0's scoping: a local declared in a taken branch is visible after
                # the chain (arena.elisa binds `r` this way).
                # `static assert COND` — captured into the static-assert registry at parse
                # time and const-evaluated by the semantic layer; at runtime it is NOTHING.
                if block_kind == "static_assert":
                    return EmitStatus.Open
                if block_kind == "static":
                    is_static_branch: bool = static_branch_is_taken(structs.static_branch_lines, block_line)
                    static_kept: bool = static_branch_is_taken(structs.static_taken_lines, block_line) if is_static_branch else true
                    EmitStatus.Open return if not static_kept
                    # A CALL to a `static def` is compile-time only: stage0 evaluates it
                    # during static execution and emits NOTHING for it (`static: answer(2)`
                    # lowers to an empty `keep()`, with no `@answer` in the module at all).
                    # select_module_declarations already drops `static def` declarations, so
                    # such a callee has no FnTable entry -- the call could not be emitted and
                    # took the whole enclosing function down with it.
                    #
                    # Drop those call statements and emit the rest, which keeps the reason
                    # this block emits inline at all: a local declared in a taken `static if`
                    # branch stays visible afterwards.
                    #
                    # Scoped to `static` bodies, where code IS compile-time by definition. An
                    # unresolved call anywhere else still declines -- the frontend has already
                    # rejected genuinely undefined names, so inside `static` a missing entry
                    # means exactly "filtered static def".
                    # A BARE `static:` block is compile-time in its entirety: stage0 emits an
                    # empty function for one (`keep()` is a bare `ret void`, with no check and
                    # no trap). stage1 kept each statement as a RUNTIME statement, which is why
                    # `static: assert size_of[Header]() == 16` emitted a real assert — and why
                    # TWO of them, or a bare `assert offset_of[…]`, declined.
                    #
                    # (`assert` reaches here as a `Stmt.Expr`, not a `Stmt.Contract`: the
                    # contract parse requires an IDENT after `assert`, and `size_of`/`offset_of`
                    # lex as their own token kinds, so the statement falls through to an
                    # expression. Filtering by statement shape could not have caught it.)
                    #
                    # Only the bare form. A TAKEN `static if` branch still emits inline, which
                    # is what keeps a local declared there visible afterwards (arena.elisa
                    # binds `r` that way).
                    EmitStatus.Open return if not is_static_branch
                    static_runtime_body: mutable darray[Stmt] = []
                    for static_statement in block_body |static_runtime_body, fns|:
                        static_is_compile_time: mutable bool = false
                        if static_statement is Stmt.Expr(static_expression, static_expression_line):
                            if static_expression is Expr.Call(static_callee, static_args, static_arg_names, static_call_line):
                                if static_callee is Expr.Ident(static_callee_name, static_callee_line):
                                    static_is_compile_time <- function_index_of(fns, "", static_callee_name) < 0
                        static_runtime_body.push(static_statement) if not static_is_compile_time
                    return emit_statements(static_runtime_body, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)
                # `in owner:` — make an EXISTING arena the active one for the block. stage0
                # requires this before a container can be built from an explicit `Arena`
                # parameter ("darray push requires an active in <arena>: scope"): passing an
                # arena does not make it the allocation target, activating it does.
                #
                # The arena is BORROWED, so owns_arena is false and nothing here frees it --
                # it belongs to whoever opened it.
                if block_kind == "in":
                    declined_status return if block_clause.count != 1
                    in_type: ValueType = lookup_type(local_scope, block_clause[0])
                    # `in store:` — make a packed STORE active. Every packed constructor in
                    # the block allocates its row from this store.
                    if in_type.kind == TypeKind.PackedStore:
                        if lookup_slot(local_scope, block_clause[0]) is store_slot:
                            store_runtime: mutable Runtime = copied_runtime(runtime)
                            store_runtime.active_store <- LLVMBuildLoad2(builder, llvm_type_of(in_type, structs, ctx), store_slot, "store.active")
                            store_runtime.active_store_enum <- in_type.bits.i64()
                            return emit_statements(block_body, return_type, local_scope, loops, regions, fns, structs, generics, store_runtime, m, ctx, builder)
                        return declined_status
                    # `in owner:` where owner is a BORROWED arena (`owner: mutable Arena&`) — the
                    # common case in std container ctors (IndexMap/InlineVec take `owner: Arena&`).
                    # The parameter slot holds a POINTER to the caller's arena, so load it and make
                    # that the active allocation target (vs a direct `Arena` local, whose slot IS
                    # the arena storage).
                    if in_type.kind == TypeKind.Ref and ref_target_of(in_type, structs).kind == TypeKind.Arena:
                        if lookup_slot(local_scope, block_clause[0]) is in_ref_slot:
                            in_ref_runtime: mutable Runtime = copied_runtime(runtime)
                            in_ref_runtime.arena <- LLVMBuildLoad2(builder, LLVMPointerTypeInContext(ctx, 0), in_ref_slot, "in.arena.ref")
                            in_ref_runtime.owns_arena <- false
                            return emit_statements(block_body, return_type, local_scope, loops, regions, fns, structs, generics, in_ref_runtime, m, ctx, builder)
                        return declined_status
                    declined_status return if in_type.kind != TypeKind.Arena
                    if lookup_slot(local_scope, block_clause[0]) is in_slot:
                        in_runtime: mutable Runtime = copied_runtime(runtime)
                        in_runtime.arena <- in_slot
                        in_runtime.owns_arena <- false
                        # Same frame bookkeeping as `region`: containers declared OUTSIDE the
                        # block keep growing from their declaration arena.
                        local_scope.region_frame_starts <- local_scope.region_frame_starts.push(local_scope.names.count)
                        local_scope.region_frame_arenas <- local_scope.region_frame_arenas.push(in_slot)
                        local_scope.region_frame_outers <- local_scope.region_frame_outers.push(runtime.arena)
                        in_status: EmitStatus = emit_statements(block_body, return_type, local_scope, loops, regions, fns, structs, generics, in_runtime, m, ctx, builder)
                        local_scope.region_frame_starts <- local_scope.region_frame_starts.truncate(local_scope.region_frame_starts.count - 1)
                        local_scope.region_frame_arenas <- local_scope.region_frame_arenas.truncate(local_scope.region_frame_arenas.count - 1)
                        local_scope.region_frame_outers <- local_scope.region_frame_outers.truncate(local_scope.region_frame_outers.count - 1)
                        return in_status
                    return declined_status
                # `trusted X:` / `can X:` — a trust/effect-grant wrapper. The grant is a
                # COMPILE-TIME assertion (the frontend proves it); there is no runtime
                # lowering, so the body simply runs in the current scope. The std dict's
                # probe loops sit inside `trusted Unsafe.AssumeProgress:`.
                # `assert C by TACTIC:` and `proof C:` both parse to this block, with the GOAL
                # riding as `body[0]` (a Stmt.Contract) and the proof steps after it. The proof
                # is discharged by the semantic layer (check_assert_by) and ERASED here -- stage0
                # lowers the goal as an ordinary runtime contract check and emits nothing at all
                # for the body, whose statements are lemma calls and nested asserts that exist
                # only to justify the goal.
                if block_kind == "assert_by":
                    declined_status return if block_body.count == 0
                    return emit_statement(block_body[0], return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)
                if block_kind == "trusted" or block_kind == "can":
                    return emit_statements(block_body, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)
                # `pool workers(N):` and `nursery workers(N):` own a typed ThreadPool for the duration of the
                # block. The frontend keeps the worker-count expression as the first pool
                # clause entry; the source-level runtime functions provide the actual pool
                # implementation, so this lowering stays ABI-compatible with both the
                # std runtime and small backend fixtures.
                # `scope pool_new(2):` — a SCOPE GUARD. stage0 evaluates the expression into a
                # guard slot and picks the cleanup from the guard's TYPE; for a `ThreadPool` it
                # emits exactly the pool block's shutdown, so it runs through this branch with
                # the constructor taken from the clause instead of being hard-coded. A guard of
                # any other type declines (the type check below is what enforces it) rather
                # than being left uncleaned.
                if block_kind == "pool" or block_kind == "nursery" or block_kind == "scope":
                    scope_guard_block: bool = block_kind == "scope"
                    declined_status return if scope_guard_block and block_clause.count == 0
                    pool_constructor: sview = block_clause[0] if scope_guard_block else "pool_new"
                    pool_binding: mutable sview = block_binding if block_binding != "" else "workers"
                    pool_binding <- "__scope_guard" if scope_guard_block
                    pool_new_type: ValueType = lookup_return_type(fns, "", pool_constructor)
                    pool_shutdown_type: ValueType = lookup_return_type(fns, "", "pool_shutdown")
                    declined_status return if pool_new_type.kind == TypeKind.Unmodeled or pool_shutdown_type.kind == TypeKind.Unmodeled
                    group_new_type: ValueType = lookup_return_type(fns, "", "task_group_new")
                    group_wait_type: ValueType = lookup_return_type(fns, "", "task_group_wait_all")
                    declined_status return if block_kind == "nursery" and (group_new_type.kind == TypeKind.Unmodeled or group_wait_type.kind == TypeKind.Unmodeled)
                    # The worker count. A LITERAL keeps the existing constant lowering exactly;
                    # anything else is passed through as an expression, because the count is
                    # routinely COMPUTED — `nursery workers(nw)` where `nw` came from a default
                    # parameter or a per-input band calculation. Requiring a literal declined
                    # every such block, which is the whole reason for_indices_par was dropped.
                    # A `scope` clause leads with the CONSTRUCTOR name, so it has an argument
                    # only from the second entry on.
                    pool_has_argument: bool = block_clause.count > (1.usize() if scope_guard_block else 0.usize())
                    pool_workers: mutable i64 = 0
                    pool_workers_is_literal: mutable bool = not pool_has_argument
                    if pool_has_argument:
                        pool_workers_is_literal <- parse_int_literal(block_clause[block_clause.count - 1], pool_workers)
                        declined_status return if pool_workers_is_literal and pool_workers < 0
                    # The clause is retained as source TEXT, so a non-literal count is rebuilt as
                    # an Ident reference to that name. A count that is not a bare name declines
                    # through the ordinary unresolved-identifier path rather than being guessed at.
                    pool_arguments: mutable darray[Expr] = [Expr.IntLit(pool_workers)] if pool_workers_is_literal else [(Expr.Ident(block_clause[block_clause.count - 1], block_line))]
                    pool_arguments <- [] if scope_guard_block and not pool_has_argument
                    if emit_call(Expr.Ident(pool_constructor, block_line), pool_arguments, [], local_scope, fns, structs, generics, runtime, m, ctx, builder) is pool_value:
                        pool_storage: mutable darray[u8] = []
                        pool_slot: LLVMValueRef = LLVMBuildAlloca(builder, llvm_type_of(pool_new_type, structs, ctx), sview_to_cstr(pool_binding, pool_storage))
                        _ = LLVMBuildStore(builder, pool_value, pool_slot)
                        declare_local(local_scope, pool_binding, pool_slot, pool_new_type)
                        group_binding: sview = "__nursery_group"
                        if block_kind == "nursery":
                            empty_group_args: darray[Expr] = []
                            if emit_call(Expr.Ident("task_group_new", block_line), empty_group_args, [], local_scope, fns, structs, generics, runtime, m, ctx, builder) is group_value:
                                group_storage: mutable darray[u8] = []
                                group_slot: LLVMValueRef = LLVMBuildAlloca(builder, llvm_type_of(group_new_type, structs, ctx), sview_to_cstr(group_binding, group_storage))
                                _ = LLVMBuildStore(builder, group_value, group_slot)
                                declare_local(local_scope, group_binding, group_slot, group_new_type)
                                local_scope.group_names.push(group_binding)
                            else:
                                return declined_status
                        local_scope.pool_names.push(pool_binding)
                        # Only a ThreadPool guard has a modeled cleanup; anything else would be
                        # emitted and then silently leaked.
                        if scope_guard_block:
                            scope_pool_type: ValueType = lookup_return_type(fns, "", "pool_new")
                            if scope_pool_type.kind != pool_new_type.kind or scope_pool_type.bits != pool_new_type.bits:
                                _ = local_scope.pool_names.pop()
                                return declined_status
                        # `pool_shutdown(pool: ThreadPool&)` takes a REFERENCE, and the bare
                        # `pool_shutdown(workers)` form DECLINES -- measured: the same call
                        # written `pool_shutdown(&p)` emits, `pool_shutdown(p)` does not. The
                        # old code passed the bare ident AND discarded the result without an
                        # else, so the call silently emitted NOTHING and the block still
                        # reported success: `pool workers(4):` compiled while leaking the pool.
                        pool_cleanup: mutable darray[Stmt] = []
                        if block_kind == "nursery":
                            pool_cleanup.push((Stmt.Expr((Expr.Call((Expr.Ident("task_group_wait_all", block_line)), [(Expr.Ident(group_binding, block_line))], [], block_line)), block_line)))
                        pool_cleanup.push((Stmt.Expr((Expr.Call((Expr.Ident("pool_shutdown", block_line)), [(Expr.Unary(TokenKind.Ampersand, (Expr.Ident(pool_binding, block_line)), block_line))], [], block_line)), block_line)))
                        # Registered as a DEFERRED action rather than appended after the body:
                        # a body that RETURNS terminates the block, and the old code skipped the
                        # shutdown entirely there on the assumption that an enclosing unwind
                        # emitted it -- nothing does, so `pool workers(4): return 7` leaked too.
                        pool_mark: usize = local_scope.deferred.count
                        local_scope.deferred <- local_scope.deferred.push(DeferredAction{body: [], names: [], slots: [], types: [], scope_exit: true})
                        local_scope.deferred[pool_mark].body.extend(pool_cleanup)
                        local_scope.deferred[pool_mark].names.extend(local_scope.names)
                        local_scope.deferred[pool_mark].slots.extend(local_scope.slots)
                        local_scope.deferred[pool_mark].types.extend(local_scope.types)
                        pool_status: EmitStatus = emit_statements(block_body, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)
                        _ = local_scope.pool_names.pop()
                        if block_kind == "nursery":
                            _ = local_scope.group_names.pop()
                        if pool_status == EmitStatus.Declined:
                            local_scope.deferred <- local_scope.deferred.truncate(pool_mark)
                            return declined_status
                        # An OPEN body runs the cleanup here; a TERMINATED one already unwound
                        # it on the way out. A cleanup that fails to emit DECLINES.
                        pool_emitted: mutable bool = true
                        if pool_status == EmitStatus.Open:
                            pool_emitted <- emit_deferred_actions_from(local_scope, pool_mark, false, fns, structs, generics, runtime, m, ctx, builder)
                        local_scope.deferred <- local_scope.deferred.truncate(pool_mark)
                        declined_status return if not pool_emitted
                        return pool_status
                    return declined_status
                # `destroy NAME` — explicitly free a named region NOW. arena_free nulls the
                # Arena's begin/end, so the function-end / return-path unwind that also sees
                # this slot becomes a no-op rather than a double free.
                if block_kind == "destroy":
                    declined_status return if block_clause.count != 1
                    destroy_type: ValueType = lookup_type(local_scope, block_clause[0])
                    declined_status return if destroy_type.kind != TypeKind.Arena
                    if lookup_slot(local_scope, block_clause[0]) is destroy_slot:
                        destroy_args: mutable darray[LLVMValueRef] = [destroy_slot]
                        destroy_args_pointer: void& = (&destroy_args[0]).cast[void&] can Unsafe.PointerCast
                        _ = LLVMBuildCall2(builder, runtime.arena_free_type, runtime.arena_free, destroy_args_pointer, 1, "")
                        return EmitStatus.Open
                    return declined_status
                # `move pair as Pair(left, right)` — a DESTRUCTURING move. The parser lowers
                # it to Block("move", …) wrapping a Match whose arms have EMPTY bodies, plus
                # one uninitialized VarDecl per binder; the block kind was never handled, so
                # every use declined.
                #
                # stage0 lowers it as a plain per-field extract into fresh locals (read from
                # its -emit llvm: `extractvalue %Pair, 0` -> `store ... ptr %left`). The
                # arms carry no runtime test because the scrutinee's STATIC type already
                # names the struct -- there is no discriminant, so this binds the fields and
                # falls through, exactly as the `is Point{x, y}` destructure does.
                #
                # SOUND SUBSET: a STRUCT scrutinee whose pattern fields are all bare
                # positional Bindings, which is the form the corpus uses. A named-field
                # (`Pair{left: a}`), nested, or literal subpattern declines rather than
                # binding a guessed position.
                # `let {a, b} = value` — the parser lowers it to a one-arm match plus one bare
                # `VarDecl(name, Invalid, Absent)` per binder (whose only job is to make the
                # name visible after the block). The bindings must land in the ENCLOSING scope,
                # so the block is emitted here rather than descended into: a scoped emit would
                # drop them at the closing brace.
                if block_kind == "let":
                    declined_status return if block_body.count == 0
                    if block_body[0] is Stmt.Match(lt_scrutinee, lt_arms, lt_match_line):
                        declined_status return if lt_arms.count == 0
                        lt_fields: mutable darray[Pattern] = []
                        if lt_arms[0].pattern is Pattern.Struct(lt_path, lt_struct_fields):
                            lt_fields.extend([lt_field for lt_field in lt_struct_fields])
                        declined_status return if lt_fields.count == 0
                        # A `layout(soa)` ROW binder: each shorthand field names its own column.
                        if lt_scrutinee is Expr.Ident(lt_row_name, lt_row_name_line):
                            lt_row: i64 = soa_row_binder_index_of(structs, lt_row_name)
                            if lt_row >= 0:
                                lt_declined: mutable bool = false
                                for lt_field in lt_fields |lt_declined, lt_row, local_scope, structs, ctx, builder|:
                                    lt_bound: mutable sview = ""
                                    lt_column: mutable sview = ""
                                    if lt_field is Pattern.Binding(lt_shorthand):
                                        lt_bound <- lt_shorthand
                                        lt_column <- lt_shorthand
                                    if lt_field is Pattern.Field(lt_selector, lt_inner):
                                        lt_column <- lt_selector
                                        lt_bound <- lt_sub if lt_inner.count == 1 and lt_inner[0] is Pattern.Binding(lt_sub) else ""
                                    if lt_bound == "" or lt_column == "":
                                        lt_declined <- true
                                    else:
                                        lt_type: ValueType = soa_binder_element_type(lt_row.usize(), lt_column, structs)
                                        if lt_type.kind == TypeKind.Unmodeled:
                                            lt_declined <- true
                                        elif soa_binder_element_address(lt_row.usize(), lt_column, structs, ctx, builder) is lt_address:
                                            lt_llvm: LLVMTypeRef = llvm_type_of(lt_type, structs, ctx)
                                            lt_storage: mutable darray[u8] = []
                                            lt_slot: LLVMValueRef = LLVMBuildAlloca(builder, lt_llvm, sview_to_cstr(lt_bound, lt_storage))
                                            _ = LLVMBuildStore(builder, LLVMBuildLoad2(builder, lt_llvm, lt_address, "soa.let.value"), lt_slot)
                                            declare_local(local_scope, lt_bound, lt_slot, lt_type)
                                        else:
                                            lt_declined <- true
                                declined_status return if lt_declined
                                return EmitStatus.Open
                        # A PLAIN STRUCT scrutinee. Fields are matched by NAME, not position,
                        # so both spellings work: `{left, right}` (shorthand — the binder name
                        # IS the field name) and `{left: base_left}` (an explicit selector with
                        # a renamed binder). stage0 emits one `extractvalue` per binder into
                        # its own alloca, which is exactly what this builds.
                        lt_value_type: ValueType = expression_type(lt_scrutinee, local_scope, fns, structs, generics)
                        declined_status return if lt_value_type.kind != TypeKind.Struct
                        lt_owner: usize = lt_value_type.bits.usize()
                        if emit_expression(lt_scrutinee, lt_value_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is lt_struct_value:
                            lt_struct_declined: mutable bool = false
                            for lt_member in lt_fields |lt_struct_declined, lt_owner, lt_struct_value, local_scope, structs, ctx, builder|:
                                lt_binder: mutable sview = ""
                                lt_selector: mutable sview = ""
                                if lt_member is Pattern.Binding(lt_plain):
                                    lt_binder <- lt_plain
                                    lt_selector <- lt_plain
                                if lt_member is Pattern.Field(lt_named, lt_named_inner):
                                    lt_selector <- lt_named
                                    lt_binder <- lt_renamed if lt_named_inner.count == 1 and lt_named_inner[0] is Pattern.Binding(lt_renamed) else ""
                                lt_position: mutable i64 = -1
                                lt_position <- field_index_of(structs, lt_owner, lt_selector) if lt_selector != ""
                                if lt_binder == "" or lt_position < 0:
                                    lt_struct_declined <- true
                                else:
                                    lt_member_type: ValueType = structs.field_types[structs.field_start[lt_owner] + lt_position.usize()]
                                    lt_member_storage: mutable darray[u8] = []
                                    lt_member_slot: LLVMValueRef = LLVMBuildAlloca(builder, llvm_type_of(lt_member_type, structs, ctx), sview_to_cstr(lt_binder, lt_member_storage))
                                    _ = LLVMBuildStore(builder, LLVMBuildExtractValue(builder, lt_struct_value, lt_position.u32(), "let.field"), lt_member_slot)
                                    declare_local(local_scope, lt_binder, lt_member_slot, lt_member_type)
                            declined_status return if lt_struct_declined
                            return EmitStatus.Open
                    return declined_status
                if block_kind == "move":
                    declined_status return if block_body.count == 0
                    if block_body[0] is Stmt.Match(mv_scrutinee, mv_arms, mv_match_line):
                        declined_status return if mv_arms.count == 0
                        mv_pattern: Pattern = mv_arms[0].pattern
                        mv_fields: mutable darray[Pattern] = []
                        if mv_pattern is Pattern.Variant(mv_path, mv_variant_fields):
                            mv_fields.extend([mv_field for mv_field in mv_variant_fields])
                        if mv_pattern is Pattern.Struct(mv_struct_path, mv_struct_fields):
                            mv_fields.extend([mv_field for mv_field in mv_struct_fields])
                        declined_status return if mv_fields.count == 0
                        mv_type: ValueType = expression_type(mv_scrutinee, local_scope, fns, structs, generics)
                        declined_status return if mv_type.kind != TypeKind.Struct
                        mv_slot_index: usize = mv_type.bits.usize()
                        declined_status return if mv_fields.count > structs.field_count[mv_slot_index]
                        if emit_expression(mv_scrutinee, mv_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is mv_value:
                            mv_declined: mutable bool = false
                            mv_position: mutable u32 = 0
                            for mv_field in mv_fields |mv_declined, mv_position, mv_slot_index, mv_value, local_scope, structs, ctx, builder|:
                                mv_name: mutable sview = ""
                                if mv_field is Pattern.Binding(mv_binding_name):
                                    mv_name <- mv_binding_name
                                if mv_name == "":
                                    mv_declined <- true
                                else:
                                    mv_field_type: ValueType = structs.field_types[structs.field_start[mv_slot_index] + mv_position.usize()]
                                    mv_storage: mutable darray[u8] = []
                                    mv_local_slot: LLVMValueRef = LLVMBuildAlloca(builder, llvm_type_of(mv_field_type, structs, ctx), sview_to_cstr(mv_name, mv_storage))
                                    _ = LLVMBuildStore(builder, LLVMBuildExtractValue(builder, mv_value, mv_position, "move.as.field"), mv_local_slot)
                                    declare_local(local_scope, mv_name, mv_local_slot, mv_field_type)
                                mv_position <- mv_position + 1
                            declined_status return if mv_declined
                            return EmitStatus.Open
                    return declined_status
                # `with arena scratch(4096) as owner:` — a SCOPED ALLOCATOR block. It is the
                # region block in different clothes: an owned arena of the given capacity, live
                # for the body, freed at scope end. Rewritten into the region form rather than
                # duplicating ~50 lines of arena setup, unwind bookkeeping and frame tracking.
                #
                # The clause holds the head words (`arena`, the name) plus the captured
                # capacity; the `as` binding, when present, is the name the body uses. Both
                # names denote the same arena, so the binding wins when it is there.
                if block_kind == "with":
                    with_capacity: mutable sview = ""
                    with_name: mutable sview = ""
                    for with_word in block_clause |with_capacity, with_name|:
                        with_probe: mutable i64 = 0
                        if parse_int_literal(with_word, with_probe):
                            with_capacity <- with_word
                        else:
                            with_name <- with_word if with_word != "arena"
                    with_name <- block_binding if block_binding != ""
                    declined_status return if with_name == "" or with_capacity == ""
                    with_clause: mutable darray[sview] = [with_name, with_capacity]
                    return emit_statement((Stmt.Block("region", with_clause, "", block_body, block_line)), return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)
                declined_status return if block_kind != "region"
                # STATEMENT form: `region r(4096)` with no colon — the parser gives the NAME
                # in the BINDING slot, an EMPTY body, and only the optional strategy in the
                # clause (the capacity expression is consumed and dropped). The region is a
                # named Arena local that lives to scope end: `@r`-annotated locals allocate
                # from it and `destroy r` frees it early. Lowered as the block form's alloca
                # (lazy CHAINED backing — capacity presizing is an allocation-strategy
                # detail, not observable behavior) with NO scoped free: the return-path
                # unwind owns it via the regions stack, and arena_free on a destroyed
                # (nulled) arena is a no-op.
                if block_binding != "" and block_body.count == 0:
                    stmt_region_arena_type: LLVMTypeRef = arena_llvm_type(ctx)
                    stmt_region_storage: mutable darray[u8] = []
                    stmt_region_slot: LLVMValueRef = LLVMBuildAlloca(builder, stmt_region_arena_type, sview_to_cstr(block_binding, stmt_region_storage))
                    _ = LLVMBuildStore(builder, LLVMConstNull(stmt_region_arena_type), stmt_region_slot)
                    stmt_region_strategy: LLVMValueRef = LLVMBuildStructGEP2(builder, stmt_region_arena_type, stmt_region_slot, 3, "region.strategy")
                    _ = LLVMBuildStore(builder, LLVMConstInt(LLVMInt64TypeInContext(ctx), 0, 0), stmt_region_strategy)
                    declare_local(local_scope, block_binding, stmt_region_slot, ValueType{kind: TypeKind.Arena, bits: 0})
                    regions.arenas.push(stmt_region_slot)
                    return EmitStatus.Open
                # `region r:` gives clause ["r"]; `region r(4096):` gives ["r", "4096"] —
                # the parser captures the capacity as a span of the SOURCE text, so it is
                # parsed back out here rather than being an Expr.
                declined_status return if block_clause.count != 1 and block_clause.count != 2
                region_capacity: mutable i64 = 0
                if block_clause.count == 2:
                    declined_status return if not parse_int_literal(block_clause[1], region_capacity)
                    # A non-positive capacity is not a region stage0 would build.
                    declined_status return if region_capacity <= 0
                scoped_runtime: mutable Runtime = copied_runtime(runtime)
                scoped_arena_type: LLVMTypeRef = arena_llvm_type(ctx)
                scoped_name_storage: mutable darray[u8] = []
                scoped_slot: LLVMValueRef = LLVMBuildAlloca(builder, scoped_arena_type, sview_to_cstr(block_clause[0], scoped_name_storage))
                _ = LLVMBuildStore(builder, LLVMConstNull(scoped_arena_type), scoped_slot)
                if region_capacity > 0:
                    # An explicit capacity takes its backing UP FRONT from the runtime, and
                    # `begin` and `end` both start at it (stage0's shape). The lazy strategy
                    # word stays 0: the backing already exists, so there is nothing to
                    # allocate on first use.
                    region_backing_args: mutable darray[LLVMValueRef] = [LLVMConstInt(LLVMInt64TypeInContext(ctx), region_capacity.u64(), 0), LLVMConstInt(LLVMInt64TypeInContext(ctx), 0, 0)]
                    region_backing_pointer: void& = (&region_backing_args[0]).cast[void&] can Unsafe.PointerCast
                    region_backing: LLVMValueRef = LLVMBuildCall2(builder, scoped_runtime.new_region_backend_type, scoped_runtime.new_region_backend, region_backing_pointer, 2, "region.init")
                    region_begin: LLVMValueRef = LLVMBuildStructGEP2(builder, scoped_arena_type, scoped_slot, 0, "region.begin")
                    region_end: LLVMValueRef = LLVMBuildStructGEP2(builder, scoped_arena_type, scoped_slot, 1, "region.end")
                    _ = LLVMBuildStore(builder, region_backing, region_begin)
                    _ = LLVMBuildStore(builder, region_backing, region_end)
                else:
                    scoped_strategy: LLVMValueRef = LLVMBuildStructGEP2(builder, scoped_arena_type, scoped_slot, 3, "region.strategy")
                    _ = LLVMBuildStore(builder, LLVMConstInt(LLVMInt64TypeInContext(ctx), 0, 0), scoped_strategy)
                scoped_runtime.arena <- scoped_slot
                # The region's NAME is a value in scope: `region r(4096): return build(r)`
                # passes it as an Arena. Binding it here means the ordinary Ident path emits
                # the `load %Arena, ptr %r` the call site needs -- no special case.
                declare_local(local_scope, block_clause[0], scoped_slot, ValueType{kind: TypeKind.Arena, bits: 0})
                # The block OWNS this region: unlike a threaded arena, it must be freed when
                # the scope ends.
                scoped_runtime.owns_arena <- true
                # Live for the block's duration, so a `return` inside unwinds it along with
                # every enclosing region -- innermost first, which is the order stage0 emits.
                regions.arenas.push(scoped_slot)
                # Record the frame so growth sites can tell a block-local container from one
                # declared outside (see growth_arena_for): outside ones keep growing from
                # the arena they were declared under, not from this region.
                local_scope.region_frame_starts <- local_scope.region_frame_starts.push(local_scope.names.count)
                local_scope.region_frame_arenas <- local_scope.region_frame_arenas.push(scoped_slot)
                local_scope.region_frame_outers <- local_scope.region_frame_outers.push(runtime.arena)
                # A `defer block:` inside the region runs at the region's end, BEFORE the
                # statement that follows — emit_statements owns that.
                scoped_status: EmitStatus = emit_statements(block_body, return_type, local_scope, loops, regions, fns, structs, generics, scoped_runtime, m, ctx, builder)
                local_scope.region_frame_starts <- local_scope.region_frame_starts.truncate(local_scope.region_frame_starts.count - 1)
                local_scope.region_frame_arenas <- local_scope.region_frame_arenas.truncate(local_scope.region_frame_arenas.count - 1)
                local_scope.region_frame_outers <- local_scope.region_frame_outers.truncate(local_scope.region_frame_outers.count - 1)
                _ = regions.arenas.pop()
                declined_status return if scoped_status == EmitStatus.Declined
                # A body that RETURNED already unwound this region on its way out; emitting
                # the free here too would double-free it, and would follow a terminator.
                scoped_status return if scoped_status == EmitStatus.Terminated
                emit_region_free(scoped_runtime, builder)
                return scoped_status

            # `requires PRED` / `ensure PRED` — a design-by-contract check. stage0 lowers it
            # to `if not PRED: <panic>`: evaluate the predicate and, on failure, abort. A
            # provably-true predicate is optimized away (stage0's -O2 drops it entirely), so
            # the success path costs nothing after the optimizer runs.
            #
            # `requires` (a PRECONDITION over the parameters) is checked HERE. `ensure` is a
            # postcondition over `result`, which is not bound until the return -- so it is
            # only RECORDED here and checked on every return path (emit_ensure_checks),
            # which is where stage0 checks it too.
            # The fail path calls libc `abort()` rather than reproducing stage0's
            # printf+backtrace panic verbatim -- the SUCCESS path (predicate holds) is then
            # bit-identical to stage0, and a FAILING contract aborts in both.
            if statement is Stmt.Contract(contract_kind, contract_pred, contract_line):
                declined_contract: EmitStatus = EmitStatus.Declined
                # `decreases` is a loop-variant termination obligation the frontend
                # discharges — NO runtime lowering, so skip it. (The std dict probe loops
                # carry `decreases`.)
                EmitStatus.Open return if contract_kind == "decreases" or contract_kind == "decreases*"
                # `ensure` is a POSTCONDITION: record it and check it at every return, where
                # `result` exists. Recording (rather than a pre-scan in emit_function_body)
                # keeps the clause's meaning lexical — a return placed BEFORE it is not
                # governed by it, which is also how stage0 reads the prologue.
                if contract_kind == "ensure":
                    structs.pending_ensures.push(contract_pred)
                    return EmitStatus.Open
                # `requires` (precondition) and `assert` both lower to a runtime check that
                # aborts on a false predicate — bit-identical to stage0 on the success path.
                declined_contract return if contract_kind != "requires" and contract_kind != "assert"
                bool_type_c: ValueType = ValueType{kind: TypeKind.Bool, bits: 1}
                if emit_expression(contract_pred, bool_type_c, local_scope, fns, structs, generics, runtime, m, ctx, builder) is contract_value:
                    emit_contract_guard(contract_value, m, ctx, builder)
                    # Past the guard the predicate HOLDS, so `assert p != null` narrows `p`
                    # for the rest of the function -- stage0's rule, which the std dict
                    # relies on to read `m.items` as a plain ref.
                    record_null_assert(contract_pred, structs)
                    return EmitStatus.Open
                return declined_contract

            # `raise MyErr.Bad` — parses to Call(Ident("raise"), [E.Variant]). It TERMINATES:
            # store a zero into the error out-param (the success value is unused on the error
            # path) and return the i32 code `ordinal + 1` (0 is reserved for success).
            if statement is Stmt.Expr(raise_stmt_expr, raise_stmt_line):
                if raise_stmt_expr is Expr.Call(raise_callee, raise_args, raise_arg_names, raise_call_line):
                    if raise_callee is Expr.Ident(raise_name, raise_name_line):
                        if raise_name == "raise" and runtime.in_error_fn and raise_args.count == 1:
                            raise_ordinal: i64 = ordinal_of_dotted_path_expr(raise_args[0], structs)
                            if raise_ordinal >= 0:
                                # A `raise` is a function EXIT, so it unwinds `defer` exactly
                                # as `return` does. It did not, so a deferred block was simply
                                # dropped on the error path — the one path where cleanup
                                # matters most.
                                EmitStatus.Declined return if not emit_deferred_actions(local_scope, false, fns, structs, generics, runtime, m, ctx, builder)
                                emit_region_unwind(regions, runtime, builder)
                                # The out-param slot is a pointer; zero its first word so a
                                # later spurious read is deterministic (stage0 stores 0).
                                _ = LLVMBuildStore(builder, LLVMConstInt(LLVMInt64TypeInContext(ctx), 0, 0), runtime.error_out)
                                _ = LLVMBuildRet(builder, LLVMConstInt(LLVMInt32TypeInContext(ctx), (raise_ordinal + 1).u64(), 0))
                                return EmitStatus.Terminated
                        # `panic(MESSAGE)` — an unconditional abort. stage0 prints a backtrace
                        # first, but the SUCCESS path never reaches a panic, so lowering to
                        # libc `abort()` + unreachable is bit-identical where it matters and
                        # aborts in both compilers where the panic fires. TERMINATES the block.
                        # (The frictionless dict wrappers panic on OOM in their catch arms.)
                        if raise_name == "panic":
                            panic_abort_type: LLVMTypeRef = LLVMFunctionType(LLVMVoidTypeInContext(ctx), null, 0, 0)
                            panic_abort_fn: LLVMValueRef = declare_or_get_abort(m, panic_abort_type)
                            _ = LLVMBuildCall2(builder, panic_abort_type, panic_abort_fn, null, 0, "")
                            _ = LLVMBuildUnreachable(builder)
                            return EmitStatus.Terminated
            if statement is Stmt.Expr(statement_expression, statement_expression_line):
                # `pass` parses to Stmt.Expr(Expr.Invalid) — a deliberate no-op, so emit nothing
                # and stay open (emitting Expr.Invalid as a value would decline the function).
                EmitStatus.Open return if statement_expression is Expr.Invalid
                # `f(a) if COND else g(b)` — a TERNARY in STATEMENT position, where both arms
                # are side-effecting CALLS rather than values (semantic_api_message picks
                # between two `buffer.extend(...)` calls this way). Emitting it as a VALUE
                # declines: the arms are void. Lower it as an if/else over the two arms run as
                # STATEMENTS, which is what it means.
                if statement_expression is Expr.If(ternary_condition, ternary_then, ternary_else, ternary_line):
                    if not (ternary_else is Expr.Absent):
                        if emit_condition(ternary_condition, local_scope, fns, structs, generics, runtime, m, ctx, builder) is ternary_bit:
                            ternary_function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                            ternary_then_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, ternary_function, "ternary.then")
                            ternary_else_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, ternary_function, "ternary.else")
                            ternary_done_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, ternary_function, "ternary.done")
                            _ = LLVMBuildCondBr(builder, ternary_bit, ternary_then_block, ternary_else_block)
                            LLVMPositionBuilderAtEnd(builder, ternary_then_block)
                            ternary_then_status: EmitStatus = emit_statement((Stmt.Expr(ternary_then, ternary_line)), return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)
                            EmitStatus.Declined return if ternary_then_status == EmitStatus.Declined
                            branch_if_open(ternary_then_status, builder, ternary_done_block)
                            LLVMPositionBuilderAtEnd(builder, ternary_else_block)
                            ternary_else_status: EmitStatus = emit_statement((Stmt.Expr(ternary_else, ternary_line)), return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)
                            EmitStatus.Declined return if ternary_else_status == EmitStatus.Declined
                            branch_if_open(ternary_else_status, builder, ternary_done_block)
                            LLVMPositionBuilderAtEnd(builder, ternary_done_block)
                            return EmitStatus.Open
                        return EmitStatus.Declined
                # A bare IDENT as a statement is the accumulator yield of a capture-listed loop,
                # restated per branch: `for d in ds |table| -> table:` whose match arms each end
                # in `table`. The loop's own `-> table` is already treated as a no-op annotation
                # below (captures mutate in place), and these per-arm restatements are the same
                # annotation — evaluating an identifier has no effect, so emit nothing.
                #
                # Only when the name is a LOCAL IN SCOPE. That is what keeps this from
                # resurrecting the THREADING form `|n = 0| -> n + x`, where the yield really does
                # feed the next iteration and discarding it would be a silent wrong answer:
                # stage0 gives that form a shadowing loop-local (verified — the outer `n` is
                # unchanged), stage1 models no such local and declines the whole `for` before
                # reaching the body. A non-Ident yield is not matched here at all.
                if statement_expression is Expr.Ident(bare_stmt_name, bare_stmt_line):
                    EmitStatus.Open return if lookup_type(local_scope, bare_stmt_name).kind != TypeKind.Unmodeled
                # A bare LITERAL as a statement (`0` on its own line) is a no-op stage0 accepts
                # and emits nothing for. It reaches here as an ordinary value expression and
                # declined the whole function — which mattered because it is the natural way to
                # end a `catch` arm, where stage0 REQUIRES an expression tail.
                EmitStatus.Open return if statement_expression is Expr.IntLit
                EmitStatus.Open return if statement_expression is Expr.BoolLit
                EmitStatus.Open return if statement_expression is Expr.FloatLit
                # A capture-listed loop (`for … |m, total|:`) parses as
                # Stmt.Expr(Expr.Block([accumulator decls…, the loop], yield, captures)).
                # In STATEMENT position with no yield the block is just its statements —
                # captures are annotations, and the accumulator declarations are emitted as
                # ordinary VarDecls in the ENCLOSING scope. A block WITH a yield is a value
                # position and stays unmodeled here.
                #
                # WARNING: enclosing-scope emission is only sound for a capture WITHOUT an
                # initializer (`|acc|`), which names an existing outer local and mutates it in
                # place. An INITIALIZED capture (`|n = 0|`) is a different thing: stage0 gives
                # it a SHADOWING loop-local, so the outer `n` is untouched after the loop.
                # Measured, not assumed — this comment previously claimed "stage0 scopes them
                # the same way" and that is FALSE: for
                #     n: mutable i64 = 100
                #     for x in xs |n = 0|: n <- n + x
                #     return n
                # stage0 returns 100, while emitting the decl into the enclosing scope returns
                # the accumulated 4. The initialized form is kept DECLINING for exactly this
                # reason (its untyped decl fails to resolve a type, which is what stops it
                # today); do not "fix" that type inference without also giving the accumulator
                # its own scope, or the loop silently returns the wrong variable.
                if statement_expression is Expr.Block(block_statements, block_value, block_captures, block_line):
                    # A submitted task is represented as an empty value block too, but it is
                    # still a STATEMENT semantically. Route it through emit_expression so the
                    # pool submission lowering runs instead of treating the non-invalid tail as
                    # an unsupported value-block statement.
                    if block_statements.count == 0:
                        for submit_marker in structs.fn_return_lines |structs, block_line|:
                            if submit_marker == block_line:
                                if fn_return_head_at(block_line, structs) == "__wait_all":
                                    wait_all_arguments: mutable darray[Expr] = [block_value]
                                    if emit_call(Expr.Ident("task_group_wait_all", block_line), wait_all_arguments, [], local_scope, fns, structs, generics, runtime, m, ctx, builder) is waited_all:
                                        _ = waited_all
                                        return EmitStatus.Open
                                    return EmitStatus.Declined
                                if emit_expression(statement_expression, ValueType{kind: TypeKind.Void, bits: 0}, local_scope, fns, structs, generics, runtime, m, ctx, builder) is submitted_statement:
                                    _ = submitted_statement
                                    return EmitStatus.Open
                                return EmitStatus.Declined
                    # Loop headers `for … |cap| -> cap:` yield the capture back for rebinding.
                    # In statement position lmut/captures already mutate in place, so a yield
                    # that is just the capture Ident is a no-op annotation — emit the body.
                    # (Lexer `for _ in count..>0 |lexer| -> lexer:` is this form.)
                    # In STATEMENT position the yield is a no-op annotation: bare captures
                    # mutate in place, and an initialized accumulator is a block-scoped local
                    # whose value has nowhere to go. Accept a bare capture ident, an accumulator
                    # this block declares, and a TUPLE of those — `for s in xs |a, b| -> a, b:`
                    # is how the semantic layer's multi-accumulator walkers are written, and the
                    # tuple form declined outright.
                    #
                    # Restricted to names this block BINDS. A yield naming anything else would be
                    # a real value being discarded, which is not safe to assume.
                    yield_ok: mutable bool = block_value is Expr.Invalid
                    if block_value is Expr.Ident(yield_name, yield_line):
                        yield_ok <- block_yield_name_is_bound(yield_name, block_captures, block_statements)
                    if block_value is Expr.Tuple(yield_elements, yield_tuple_line):
                        yield_all_bound: mutable bool = yield_elements.count > 0
                        for yield_element in yield_elements |yield_all_bound, block_captures, block_statements|:
                            if yield_element is Expr.Ident(yield_el_name, yield_el_line):
                                yield_all_bound <- false if not block_yield_name_is_bound(yield_el_name, block_captures, block_statements)
                            else:
                                yield_all_bound <- false
                        yield_ok <- yield_all_bound
                    EmitStatus.Declined return if not yield_ok
                    # An INITIALIZED capture (`|n = 0|`) desugars to an untyped VarDecl named by
                    # the capture list. stage0 gives it a SHADOWING loop-local, so it must NOT
                    # survive into the enclosing scope — emitting it there makes the loop mutate
                    # the caller's variable of the same name (measured: 4 where stage0 gives 100,
                    # see the WARNING above). Emit the whole block scoped so the accumulator dies
                    # with it.
                    #
                    # Only when such a decl is actually present: an UNINITIALIZED capture
                    # (`|acc|`) names an existing outer local that the body mutates in place, and
                    # scoping that would be wrong in the other direction — the mutation has to
                    # outlive the loop.
                    block_has_accumulator_decl: mutable bool = false
                    for acc_stmt in block_statements |block_has_accumulator_decl, block_captures|:
                        if acc_stmt is Stmt.VarDecl(acc_name, acc_type, acc_value, acc_line):
                            # Typed (`|position: usize = 0|`) as well as untyped: an INITIALIZED
                            # capture shadows either way, so both must be block-scoped.
                            block_has_accumulator_decl <- true
                    if block_has_accumulator_decl:
                        return emit_statements_scoped(block_statements, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)
                    return emit_statements(block_statements, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)
                if statement_expression is Expr.Call(push_callee, push_arguments, push_argument_names, push_call_line):
                    if push_callee is Expr.Field(push_object, push_method, push_method_line):
                        # Receiver may be a bare Ident (`xs.push`) or a struct field holding a
                        # darray (`b.items.push`), both resolved by the _expr helpers.
                        push_type: ValueType = darray_type_behind_expr(push_object, local_scope, structs)
                        # `rows.push(a, b)` / `rows.reserve(n)` on a `layout(soa)` aggregate --
                        # ROW-level operations that fan out over the columns. One argument per
                        # column for push (in declaration order); reserve takes one count and
                        # applies it to every column.
                        soa_recv: ValueType = expression_type(push_object, local_scope, fns, structs, generics)
                        if soa_recv.kind == TypeKind.Struct and struct_declares_soa_layout(structs, structs.names[soa_recv.bits.usize()]):
                            soa_slot: usize = soa_recv.bits.usize()
                            soa_columns: usize = structs.field_count[soa_slot]
                            if push_method == "push" and push_arguments.count == soa_columns and soa_columns > 0.usize():
                                if struct_chain_address(push_object, local_scope, fns, structs, generics, runtime, m, ctx, builder) is soa_push_address:
                                    soa_push_llvm: LLVMTypeRef = llvm_type_of(soa_recv, structs, ctx)
                                    soa_push_runtime: Runtime = growth_runtime_for(push_object, local_scope, runtime)
                                    soa_push_declined: mutable bool = false
                                    for soa_push_index in 0..<soa_columns |soa_push_declined, soa_push_address, soa_push_llvm, soa_slot, push_arguments, local_scope, fns, structs, generics, soa_push_runtime, m, ctx, builder|:
                                        soa_push_column: LLVMValueRef = LLVMBuildStructGEP2(builder, soa_push_llvm, soa_push_address, soa_push_index.u32(), "soa.push.col")
                                        soa_push_type: ValueType = copied_type(structs.field_types[structs.field_start[soa_slot] + soa_push_index])
                                        soa_push_declined <- true if not emit_darray_push(soa_push_column, soa_push_type, push_arguments[soa_push_index], local_scope, fns, structs, generics, soa_push_runtime, m, ctx, builder)
                                    EmitStatus.Declined return if soa_push_declined
                                    return EmitStatus.Open
                                return EmitStatus.Declined
                            if push_method == "reserve" and push_arguments.count == 1 and soa_columns > 0.usize():
                                if struct_chain_address(push_object, local_scope, fns, structs, generics, runtime, m, ctx, builder) is soa_res_address:
                                    if emit_expression(push_arguments[0], ValueType{kind: TypeKind.Signed, bits: 64}, local_scope, fns, structs, generics, runtime, m, ctx, builder) is soa_res_needed:
                                        soa_res_llvm: LLVMTypeRef = llvm_type_of(soa_recv, structs, ctx)
                                        soa_res_runtime: Runtime = growth_runtime_for(push_object, local_scope, runtime)
                                        soa_res_declined: mutable bool = false
                                        for soa_res_index in 0..<soa_columns |soa_res_declined, soa_res_address, soa_res_llvm, soa_slot, soa_res_needed, structs, soa_res_runtime, m, ctx, builder|:
                                            soa_res_column: LLVMValueRef = LLVMBuildStructGEP2(builder, soa_res_llvm, soa_res_address, soa_res_index.u32(), "soa.reserve.col")
                                            soa_res_type: ValueType = copied_type(structs.field_types[structs.field_start[soa_slot] + soa_res_index])
                                            soa_res_declined <- true if not emit_darray_reserve(soa_res_column, soa_res_type, soa_res_needed, structs, soa_res_runtime, m, ctx, builder)
                                        EmitStatus.Declined return if soa_res_declined
                                        return EmitStatus.Open
                                return EmitStatus.Declined
                        # `xs.push([72, 105])` — an ARRAY-LITERAL argument pushes EVERY element,
                        # which is a bulk extend: stage0 lowers it through its
                        # `darray.extend.*` path, not as a single push. emit_darray_push takes
                        # ONE element, so the literal form declined.
                        #
                        # Pushed element-by-element here, the same way the extend path already
                        # handles a literal source. The elements are known at compile time, so
                        # there is no loop to build.
                        # NOT when the ELEMENT is itself an array: for `darray[array[i64, 2]]`
                        # the literal IS one element, not a list of them, and splitting it
                        # would push two i64s into a slot expecting one pair. The
                        # darray_of_fixed_array_push regression case catches exactly that.
                        push_lit_element_type: ValueType = darray_element_of(push_type, structs) if push_type.kind == TypeKind.DArray else unmodeled_type()
                        if push_type.kind == TypeKind.DArray and push_method == "push" and push_arguments.count == 1 and push_lit_element_type.kind != TypeKind.Array and push_arguments[0] is Expr.Array(push_lit_elements, push_lit_line):
                            if darray_address_of_expr(push_object, local_scope, fns, structs, generics, runtime, m, ctx, builder) is push_lit_slot:
                                push_lit_runtime: Runtime = growth_runtime_for(push_object, local_scope, runtime)
                                push_lit_declined: mutable bool = false
                                for push_lit_element in push_lit_elements |push_lit_declined, push_lit_slot, push_type, local_scope, fns, structs, generics, push_lit_runtime, m, ctx, builder|:
                                    push_lit_declined <- true if not emit_darray_push(push_lit_slot, push_type, push_lit_element, local_scope, fns, structs, generics, push_lit_runtime, m, ctx, builder)
                                EmitStatus.Declined return if push_lit_declined
                                return EmitStatus.Open
                            return EmitStatus.Declined
                        if push_type.kind == TypeKind.DArray and push_method == "push" and push_arguments.count == 1:
                            if darray_address_of_expr(push_object, local_scope, fns, structs, generics, runtime, m, ctx, builder) is push_slot:
                                push_growth_runtime: Runtime = growth_runtime_for(push_object, local_scope, runtime)
                                if emit_darray_push(push_slot, push_type, push_arguments[0], local_scope, fns, structs, generics, push_growth_runtime, m, ctx, builder):
                                    return EmitStatus.Open
                            return EmitStatus.Declined
                        # `xs.clear()` — logically empty the darray by zeroing its count (the
                        # backing/capacity are retained, matching stage0). No element teardown is
                        # needed: darray elements are plain values in an arena.
                        if push_type.kind == TypeKind.DArray and push_method == "clear" and push_arguments.count == 0:
                            if darray_address_of_expr(push_object, local_scope, fns, structs, generics, runtime, m, ctx, builder) is clear_slot:
                                clear_header: LLVMTypeRef = darray_llvm_type(structs, ctx)
                                clear_count_ptr: LLVMValueRef = LLVMBuildStructGEP2(builder, clear_header, clear_slot, 1, "clear.cnt.ptr")
                                _ = LLVMBuildStore(builder, LLVMConstInt(LLVMInt64TypeInContext(ctx), 0, 0), clear_count_ptr)
                                return EmitStatus.Open
                            return EmitStatus.Declined
                        # `xs.reserve(n)` — ensure capacity >= n without changing count or
                        # storing an element (see emit_darray_reserve). Works for any element
                        # type, so the IndexMap ctor's `map.entries.reserve(cap)` lowers here.
                        if push_type.kind == TypeKind.DArray and push_method == "reserve" and push_arguments.count == 1:
                            if darray_address_of_expr(push_object, local_scope, fns, structs, generics, runtime, m, ctx, builder) is reserve_slot:
                                if emit_expression(push_arguments[0], ValueType{kind: TypeKind.Unsigned, bits: 64}, local_scope, fns, structs, generics, runtime, m, ctx, builder) is reserve_n:
                                    if emit_darray_reserve(reserve_slot, push_type, reserve_n, structs, runtime, m, ctx, builder):
                                        return EmitStatus.Open
                            return EmitStatus.Declined
                        # `xs.truncate(n)` — SHRINK to at most n elements: count becomes min(count,
                        # n). A no-op when n >= count. Pure count clamp, like clear; the backing is
                        # retained and growth is never triggered (truncate only shrinks).
                        if push_type.kind == TypeKind.DArray and push_method == "truncate" and push_arguments.count == 1:
                            if darray_address_of_expr(push_object, local_scope, fns, structs, generics, runtime, m, ctx, builder) is trunc_slot:
                                trunc_i64: LLVMTypeRef = LLVMInt64TypeInContext(ctx)
                                if emit_expression(push_arguments[0], ValueType{kind: TypeKind.Unsigned, bits: 64}, local_scope, fns, structs, generics, runtime, m, ctx, builder) is trunc_n:
                                    trunc_header: LLVMTypeRef = darray_llvm_type(structs, ctx)
                                    trunc_count_ptr: LLVMValueRef = LLVMBuildStructGEP2(builder, trunc_header, trunc_slot, 1, "trunc.cnt.ptr")
                                    trunc_count: LLVMValueRef = LLVMBuildLoad2(builder, trunc_i64, trunc_count_ptr, "trunc.cnt")
                                    # min(count, n) via an unsigned compare (counts are non-negative).
                                    trunc_smaller: LLVMValueRef = LLVMBuildICmp(builder, 36, trunc_n, trunc_count, "trunc.lt")
                                    trunc_new: LLVMValueRef = LLVMBuildSelect(builder, trunc_smaller, trunc_n, trunc_count, "trunc.new")
                                    _ = LLVMBuildStore(builder, trunc_new, trunc_count_ptr)
                                    return EmitStatus.Open
                            return EmitStatus.Declined
                        # `xs.resize(n)` — set the length to exactly n: zero-fill new tail elements
                        # when growing, drop the tail when shrinking. Lowered by pushing a ZERO
                        # element while count < n (reusing emit_darray_push's growth), then storing
                        # n as the final count (which also performs the shrink case). Restricted to
                        # scalar element types so a `0` literal is a valid fill value.
                        if push_type.kind == TypeKind.DArray and push_method == "resize" and push_arguments.count == 1:
                            rz_elem: ValueType = darray_element_of(push_type, structs)
                            EmitStatus.Declined return if rz_elem.kind == TypeKind.Unmodeled
                            # The fill value. A SCALAR element takes the `0` literal it always
                            # did; anything else (a view, a struct, a nested container) takes
                            # `zeroed`, the language's own zero value. Restricting the whole
                            # method to scalars meant `darray[view[u8]].resize(n)` declined
                            # even though the growth loop below is element-type agnostic --
                            # only the fill literal ever was not.
                            rz_is_scalar: bool = rz_elem.kind == TypeKind.Signed or rz_elem.kind == TypeKind.Unsigned or rz_elem.kind == TypeKind.Float
                            rz_fill: Expr = (Expr.IntLit(0)) if rz_is_scalar else (Expr.Ident("zeroed", push_call_line))
                            if darray_address_of_expr(push_object, local_scope, fns, structs, generics, runtime, m, ctx, builder) is rz_slot:
                                rz_i64: LLVMTypeRef = LLVMInt64TypeInContext(ctx)
                                rz_header: LLVMTypeRef = darray_llvm_type(structs, ctx)
                                rz_count_ptr: LLVMValueRef = LLVMBuildStructGEP2(builder, rz_header, rz_slot, 1, "resize.cnt.ptr")
                                if emit_expression(push_arguments[0], ValueType{kind: TypeKind.Unsigned, bits: 64}, local_scope, fns, structs, generics, runtime, m, ctx, builder) is rz_n:
                                    rz_function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                                    rz_cond: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, rz_function, "resize.cond")
                                    rz_push_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, rz_function, "resize.push")
                                    rz_after: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, rz_function, "resize.after")
                                    _ = LLVMBuildBr(builder, rz_cond)
                                    LLVMPositionBuilderAtEnd(builder, rz_cond)
                                    # Grow only while count < n; the ULT stops exactly at n. If the
                                    # array is already >= n the loop body never runs.
                                    rz_cur: LLVMValueRef = LLVMBuildLoad2(builder, rz_i64, rz_count_ptr, "resize.cur")
                                    rz_more: LLVMValueRef = LLVMBuildICmp(builder, 36, rz_cur, rz_n, "resize.more")
                                    _ = LLVMBuildCondBr(builder, rz_more, rz_push_block, rz_after)
                                    LLVMPositionBuilderAtEnd(builder, rz_push_block)
                                    rz_growth_runtime: Runtime = growth_runtime_for(push_object, local_scope, runtime)
                                    if emit_darray_push(rz_slot, push_type, rz_fill, local_scope, fns, structs, generics, rz_growth_runtime, m, ctx, builder):
                                        _ = LLVMBuildBr(builder, rz_cond)
                                        LLVMPositionBuilderAtEnd(builder, rz_after)
                                        # Final count is exactly n: a no-op after growth, the shrink
                                        # (drop the tail) when the array started longer than n.
                                        _ = LLVMBuildStore(builder, rz_n, rz_count_ptr)
                                        return EmitStatus.Open
                                    return EmitStatus.Declined
                            return EmitStatus.Declined
                        # `xs.extend(ys)` — append every element of the source darray to the
                        # target. Lowered as a push loop over the source's elements (behaviourally
                        # identical to stage0's grow+copy; exit-code-verified). The per-element
                        # value rides as a synthesized `ys[__extend_idx]` index expression so it
                        # reuses emit_darray_push (which handles growth) and the index-read path.
                        if push_type.kind == TypeKind.DArray and push_method == "extend" and push_arguments.count == 1:
                            ext_source_type: mutable ValueType = darray_type_behind_expr(push_arguments[0], local_scope, structs)
                            ext_source_type <- expression_type(push_arguments[0], local_scope, fns, structs, generics) if ext_source_type.kind == TypeKind.Unmodeled
                            # `darray[u8].extend(sview)` is the byte-copy form used by the
                            # compiler's header/parser tooling (`out.extend(text)`). A string
                            # view is not a darray, so the darray-only path below would decline
                            # every such helper and leave its body as an unresolved declaration.
                            # A STRING-LITERAL source (`domain_storage.extend("elisa.disjoint.")`)
                            # emits as an sview `{ptr, len}` at expected SView, so it reuses this path.
                            ext_source_is_strlit: mutable bool = false
                            if push_arguments[0] is Expr.StringLit(ext_strlit_text):
                                ext_source_is_strlit <- true
                            # A LITERAL source (`sb.extend([0.u8()])`, how the std terminates a
                            # string builder). A literal has no address, so both loop paths below
                            # declined on darray_address_of_expr. There is nothing to loop over
                            # either — the element count is known here, so push each element
                            # expression straight through emit_darray_push (which handles growth).
                            if push_arguments[0] is Expr.Array(ext_lit_elements, ext_lit_line):
                                if darray_address_of_expr(push_object, local_scope, fns, structs, generics, runtime, m, ctx, builder) is ext_lit_target_slot:
                                    ext_lit_growth_runtime: Runtime = growth_runtime_for(push_object, local_scope, runtime)
                                    ext_lit_declined: mutable bool = false
                                    for ext_lit_element in ext_lit_elements |ext_lit_declined, ext_lit_target_slot, push_type, local_scope, fns, structs, generics, ext_lit_growth_runtime, m, ctx, builder|:
                                        ext_lit_declined <- true if not emit_darray_push(ext_lit_target_slot, push_type, ext_lit_element, local_scope, fns, structs, generics, ext_lit_growth_runtime, m, ctx, builder)
                                    EmitStatus.Declined return if ext_lit_declined
                                    return EmitStatus.Open
                                return EmitStatus.Declined
                            # `xs.extend(v)` where v is a `view[T]` — a VIEW source. Same shape
                            # as the sview byte-copy below (loop the length, push `src[i]`),
                            # but element-typed rather than fixed to u8, and the element types
                            # must agree. Indexing a view is already lowered, so the loop
                            # reuses it exactly as the sview path does.
                            if ext_source_type.kind == TypeKind.View and push_type.kind == TypeKind.DArray:
                                ext_view_element: ValueType = view_element_of(ext_source_type, structs)
                                ext_view_target_element: ValueType = darray_element_of(push_type, structs)
                                EmitStatus.Declined return if ext_view_element.kind == TypeKind.Unmodeled or ext_view_target_element.kind == TypeKind.Unmodeled
                                EmitStatus.Declined return if ext_view_element.kind != ext_view_target_element.kind or ext_view_element.bits != ext_view_target_element.bits
                                ext_view_struct: ValueType = view_struct_type(ext_source_type, structs)
                                EmitStatus.Declined return if ext_view_struct.kind == TypeKind.Unmodeled
                                if darray_address_of_expr(push_object, local_scope, fns, structs, generics, runtime, m, ctx, builder) is ext_view_target_slot:
                                    ext_view_growth_runtime: Runtime = growth_runtime_for(push_object, local_scope, runtime)
                                    if emit_expression(push_arguments[0], ext_view_struct, local_scope, fns, structs, generics, runtime, m, ctx, builder) is ext_view_value:
                                        ext_view_i64: LLVMTypeRef = LLVMInt64TypeInContext(ctx)
                                        ext_view_len: LLVMValueRef = LLVMBuildExtractValue(builder, ext_view_value, 1, "extend.view.len")
                                        ext_view_index_slot: LLVMValueRef = LLVMBuildAlloca(builder, ext_view_i64, "extend.view.i")
                                        _ = LLVMBuildStore(builder, LLVMConstInt(ext_view_i64, 0, 0), ext_view_index_slot)
                                        declare_local(local_scope, "__extend_view_idx", ext_view_index_slot, ValueType{kind: TypeKind.Signed, bits: 64})
                                        ext_view_function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                                        ext_view_cond: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, ext_view_function, "extend.view.cond")
                                        ext_view_body: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, ext_view_function, "extend.view.body")
                                        ext_view_done: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, ext_view_function, "extend.view.done")
                                        _ = LLVMBuildBr(builder, ext_view_cond)
                                        LLVMPositionBuilderAtEnd(builder, ext_view_cond)
                                        ext_view_index: LLVMValueRef = LLVMBuildLoad2(builder, ext_view_i64, ext_view_index_slot, "extend.view.cur")
                                        ext_view_more: LLVMValueRef = LLVMBuildICmp(builder, 36, ext_view_index, ext_view_len, "extend.view.more")
                                        _ = LLVMBuildCondBr(builder, ext_view_more, ext_view_body, ext_view_done)
                                        LLVMPositionBuilderAtEnd(builder, ext_view_body)
                                        ext_view_index_expr: Expr = Expr.Index(push_arguments[0], Expr.Ident("__extend_view_idx", push_call_line), push_call_line)
                                        if emit_darray_push(ext_view_target_slot, push_type, ext_view_index_expr, local_scope, fns, structs, generics, ext_view_growth_runtime, m, ctx, builder):
                                            ext_view_next: LLVMValueRef = LLVMBuildAdd(builder, ext_view_index, LLVMConstInt(ext_view_i64, 1, 0), "extend.view.next")
                                            _ = LLVMBuildStore(builder, ext_view_next, ext_view_index_slot)
                                            _ = LLVMBuildBr(builder, ext_view_cond)
                                            LLVMPositionBuilderAtEnd(builder, ext_view_done)
                                            return EmitStatus.Open
                                        return EmitStatus.Declined
                                return EmitStatus.Declined
                            if (ext_source_type.kind == TypeKind.SView or ext_source_is_strlit) and push_type.kind == TypeKind.DArray:
                                ext_byte_element: ValueType = darray_element_of(push_type, structs)
                                EmitStatus.Declined return if ext_byte_element.kind != TypeKind.Unsigned or ext_byte_element.bits != 8
                                ext_sview_source_type: ValueType = ValueType{kind: TypeKind.SView, bits: 0}
                                if darray_address_of_expr(push_object, local_scope, fns, structs, generics, runtime, m, ctx, builder) is ext_sview_target_slot:
                                    ext_sview_growth_runtime: Runtime = growth_runtime_for(push_object, local_scope, runtime)
                                    if emit_expression(push_arguments[0], ext_sview_source_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is ext_sview_value:
                                        ext_sview_len: LLVMValueRef = LLVMBuildExtractValue(builder, ext_sview_value, 1, "extend.sview.len")
                                        ext_sview_index_slot: LLVMValueRef = LLVMBuildAlloca(builder, LLVMInt64TypeInContext(ctx), "extend.sview.i")
                                        _ = LLVMBuildStore(builder, LLVMConstInt(LLVMInt64TypeInContext(ctx), 0, 0), ext_sview_index_slot)
                                        declare_local(local_scope, "__extend_sview_idx", ext_sview_index_slot, ValueType{kind: TypeKind.Signed, bits: 64})
                                        ext_sview_function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                                        ext_sview_cond: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, ext_sview_function, "extend.sview.cond")
                                        ext_sview_body: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, ext_sview_function, "extend.sview.body")
                                        ext_sview_done: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, ext_sview_function, "extend.sview.done")
                                        _ = LLVMBuildBr(builder, ext_sview_cond)
                                        LLVMPositionBuilderAtEnd(builder, ext_sview_cond)
                                        ext_sview_index: LLVMValueRef = LLVMBuildLoad2(builder, LLVMInt64TypeInContext(ctx), ext_sview_index_slot, "extend.sview.cur")
                                        ext_sview_more: LLVMValueRef = LLVMBuildICmp(builder, 36, ext_sview_index, ext_sview_len, "extend.sview.more")
                                        _ = LLVMBuildCondBr(builder, ext_sview_more, ext_sview_body, ext_sview_done)
                                        LLVMPositionBuilderAtEnd(builder, ext_sview_body)
                                        ext_sview_index_expr: Expr = Expr.Index(push_arguments[0], Expr.Ident("__extend_sview_idx", push_call_line), push_call_line)
                                        if emit_darray_push(ext_sview_target_slot, push_type, ext_sview_index_expr, local_scope, fns, structs, generics, ext_sview_growth_runtime, m, ctx, builder):
                                            ext_sview_next: LLVMValueRef = LLVMBuildAdd(builder, ext_sview_index, LLVMConstInt(LLVMInt64TypeInContext(ctx), 1, 0), "extend.sview.next")
                                            _ = LLVMBuildStore(builder, ext_sview_next, ext_sview_index_slot)
                                            _ = LLVMBuildBr(builder, ext_sview_cond)
                                            LLVMPositionBuilderAtEnd(builder, ext_sview_done)
                                            return EmitStatus.Open
                                        return EmitStatus.Declined
                                return EmitStatus.Declined
                            # `dst.extend([x for x in xs])` — a COMPREHENSION source, the shape the
                            # semantic layer's scope walkers use (`bound.extend([p for p in params])`).
                            # A comprehension is a VALUE with no address, so the darray path below
                            # could not take one and declined. Materializing it matters beyond just
                            # getting an address: the loop re-emits the source expression once per
                            # iteration as `src[__extend_idx]`, so handing it the comprehension
                            # directly would REBUILD THE WHOLE LIST on every element — quadratic,
                            # and each rebuild allocates. Emit it ONCE into a temp local and let the
                            # ordinary loop read that local by name.
                            # Only an Ident / Field / Index names storage we can take the address
                            # of. Every other darray-valued argument is a VALUE — a comprehension
                            # (`bound.extend([p for p in params])`), a call (`buffer.extend(f"...")`,
                            # since an f-string desugars to `__fstr(chunks…)` returning darray[u8]),
                            # a ternary between two f-strings, a block. Those all declined here.
                            #
                            # Materializing matters beyond just getting an address: the loop below
                            # re-emits its source once per element as `src[__extend_idx]`, so passing
                            # a value expression straight through would RE-EVALUATE IT PER BYTE —
                            # quadratic, allocating each time, and calling any side-effecting callee
                            # once per element. Emit it ONCE into a temp local instead.
                            ext_src_expr: mutable Expr = push_arguments[0]
                            ext_addressable: mutable bool = false
                            if push_arguments[0] is Expr.Ident(ext_a_name, ext_a_line):
                                ext_addressable <- true
                            if push_arguments[0] is Expr.Field(ext_f_head, ext_f_name, ext_f_line):
                                ext_addressable <- true
                            if push_arguments[0] is Expr.Index(ext_i_obj, ext_i_idx, ext_i_line):
                                ext_addressable <- true
                            if not ext_addressable:
                                ext_value_type: mutable ValueType = expression_type(push_arguments[0], local_scope, fns, structs, generics)
                                ext_value_type <- push_type if ext_value_type.kind != TypeKind.DArray
                                if ext_value_type.kind == TypeKind.DArray:
                                    if emit_expression(push_arguments[0], ext_value_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is ext_materialized:
                                        ext_tmp_slot: LLVMValueRef = LLVMBuildAlloca(builder, darray_llvm_type(structs, ctx), "extend.value.tmp")
                                        _ = LLVMBuildStore(builder, ext_materialized, ext_tmp_slot)
                                        declare_local(local_scope, "__extend_value", ext_tmp_slot, ext_value_type)
                                        ext_src_expr <- Expr.Ident("__extend_value", push_call_line)
                                        ext_source_type <- ext_value_type
                                    else:
                                        return EmitStatus.Declined
                            EmitStatus.Declined return if ext_source_type.kind != TypeKind.DArray
                            if darray_address_of_expr(push_object, local_scope, fns, structs, generics, runtime, m, ctx, builder) is ext_target_slot:
                                if darray_address_of_expr(ext_src_expr, local_scope, fns, structs, generics, runtime, m, ctx, builder) is ext_source_slot:
                                    ext_growth_runtime: Runtime = growth_runtime_for(push_object, local_scope, runtime)
                                    ext_i64: LLVMTypeRef = LLVMInt64TypeInContext(ctx)
                                    ext_header: LLVMTypeRef = darray_llvm_type(structs, ctx)
                                    # Snapshot the source count before the loop (a self-extend then
                                    # copies only the original elements, matching a grow+copy).
                                    ext_count_ptr: LLVMValueRef = LLVMBuildStructGEP2(builder, ext_header, ext_source_slot, 1, "extend.src.cnt.ptr")
                                    ext_count: LLVMValueRef = LLVMBuildLoad2(builder, ext_i64, ext_count_ptr, "extend.src.cnt")
                                    ext_idx_slot: LLVMValueRef = LLVMBuildAlloca(builder, ext_i64, "extend.i")
                                    _ = LLVMBuildStore(builder, LLVMConstInt(ext_i64, 0, 0), ext_idx_slot)
                                    declare_local(local_scope, "__extend_idx", ext_idx_slot, ValueType{kind: TypeKind.Signed, bits: 64})
                                    ext_function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                                    ext_cond: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, ext_function, "extend.cond")
                                    ext_bodyb: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, ext_function, "extend.body")
                                    ext_done: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, ext_function, "extend.done")
                                    _ = LLVMBuildBr(builder, ext_cond)
                                    LLVMPositionBuilderAtEnd(builder, ext_cond)
                                    ext_cur: LLVMValueRef = LLVMBuildLoad2(builder, ext_i64, ext_idx_slot, "extend.cur")
                                    ext_more: LLVMValueRef = LLVMBuildICmp(builder, 40, ext_cur, ext_count, "extend.more")
                                    _ = LLVMBuildCondBr(builder, ext_more, ext_bodyb, ext_done)
                                    LLVMPositionBuilderAtEnd(builder, ext_bodyb)
                                    ext_index_expr: Expr = Expr.Index(ext_src_expr, Expr.Ident("__extend_idx", push_call_line), push_call_line)
                                    if emit_darray_push(ext_target_slot, push_type, ext_index_expr, local_scope, fns, structs, generics, ext_growth_runtime, m, ctx, builder):
                                        _ = LLVMBuildStore(builder, LLVMBuildAdd(builder, ext_cur, LLVMConstInt(ext_i64, 1, 0), "extend.next"), ext_idx_slot)
                                        _ = LLVMBuildBr(builder, ext_cond)
                                        LLVMPositionBuilderAtEnd(builder, ext_done)
                                        return EmitStatus.Open
                                    return EmitStatus.Declined
                                return EmitStatus.Declined
                            return EmitStatus.Declined
                    # `try f(args)` (statement, propagating — the parser strips the `try` head,
                    # leaving a bare call to an ERROR fn). It uses the error ABI (out-slot + i32
                    # status), and on a NONZERO status propagates: unwind and return that code
                    # from THIS (error-returning) function. The std dict's `try arena_dict_reserve
                    # (…)` is exactly this. Without it the call omits the out-param and every
                    # later argument shifts left (m gets a scalar → null-deref crash).
                    if push_callee is Expr.Ident(propagate_name, propagate_name_line):
                        if error_callee_is(fns, generics, propagate_name):
                            return emit_propagating_try(propagate_name, push_arguments, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)
                    # The same statement, with EXPLICIT type arguments (`try arena_dict_reserve
                    # [cstr[key_shape], i64](…)`): the bracket makes the callee an Index/IndexN,
                    # so the Ident branch above never fires and the inference-based helper has
                    # no argument to recover K/V from.
                    stmt_gtry_base: mutable sview = ""
                    stmt_gtry_ok: mutable bool = false
                    stmt_gtry_types: darray[ValueType] = generic_callee_type_args(push_callee, &stmt_gtry_base, &stmt_gtry_ok, structs)
                    if stmt_gtry_ok:
                        if emit_propagating_generic_try_value(stmt_gtry_base, stmt_gtry_types, push_arguments, false, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder) is stmt_gtry_slot:
                            return EmitStatus.Open
                    # Any other call in STATEMENT position — typically a `-> void` call like
                    # `bump(c)`. The result (if any) is simply discarded; `expected` is Void
                    # because a statement wants no value.
                    if emit_call(push_callee, push_arguments, push_argument_names, local_scope, fns, structs, generics, runtime, m, ctx, builder) is discarded_result:
                        return EmitStatus.Open
                    return EmitStatus.Declined
                # A DISCARDED expression statement — a bare `n + 1`, which stage0 evaluates
                # and throws the value away. Everything above handles a SHAPE (a call, a
                # ternary of calls, a capture block); this is the general case, and without
                # it the whole function DROPPED (measured on
                # test/fixtures/diagnostics/unused_expression.pos.elisa, which stage0
                # compiles). Emitting for value and ignoring the result IS the semantics.
                # A shape whose type cannot be inferred, or that the expression emitter
                # cannot model, still declines — this widens what compiles, never what is
                # silently guessed.
                discard_type: ValueType = expression_type(statement_expression, local_scope, fns, structs, generics)
                if discard_type.kind != TypeKind.Unmodeled:
                    if emit_expression(statement_expression, discard_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is discarded_statement_value:
                        _ = discarded_statement_value
                        return EmitStatus.Open
                return EmitStatus.Declined
            handled <- false
            return EmitStatus.Declined
