extend Backend:
    private:
        def emit_comprehension(comprehension_var: sview @source, iterable: Expr, condition: Expr, body: Expr, comprehension_line: u32, comprehension_scope_id: u32, expected: ValueType, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            return null if comprehension_scope_id == 0
            # A PROJECTION query whose guard the AST cannot carry: emitting the filter without
            # it silently widens the result. Decline the whole query instead.
            return null if query_guard_dropped_at(comprehension_scope_id, structs)
            return null if not query_scope_metadata_valid(structs)
            query_extra_rows_valid: mutable bool = true
            query_extra_count: usize = query_extra_binder_count_at(comprehension_scope_id, structs, query_extra_rows_valid)
            return null if not query_extra_rows_valid
            # The execution-mode marker is kept in the file-level side table because the
            # compact Comprehension AST is shared by queries and collection builders.
            # Parallel maps are handled before the sequential/query dispatch so an explicit
            # `by par` never silently degrades to a serial loop.
            if parallel_comprehension_at(comprehension_scope_id, structs):
                return null if query_extra_count > 0.usize()
                return null if condition is not Expr.Absent
                return emit_parallel_comprehension(comprehension_var, iterable, body, comprehension_line, expected, local_scope, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}
            # `[x + y for x in xs for y in ys]` — later clauses ride in the body as a spread of
            # the inner comprehension (codegen_comprehension_nested.elisa).
            match nested_comprehension_inner(body):
                Expr.Absent:
                    pass
                _:
                    return null if query_extra_count > 0.usize()
                    return emit_nested_comprehension(comprehension_var, iterable, condition, body, comprehension_line, expected, local_scope, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}
            # `any index, item in xs.enumerate() where …` — the supported two-binder query.
            # The Comprehension node carries the INDEX; the element binder is the scope-ID
            # keyed extra. Other extra-binder arities or non-enumerate forms are declined
            # below instead of silently dropping names from the source program.
            # `.enumerate()` receiver here so every emitter below iterates the plain source and
            # simply also binds the loop counter. The extra binder is keyed by query scope ID.
            qi_index: mutable sview = ""
            qi_var: mutable sview = comprehension_var
            qi_iterable: mutable Expr = iterable
            enumerate_receiver: Expr = query_enumerate_receiver(iterable)
            match enumerate_receiver:
                Expr.Absent:
                    return null if query_extra_count > 0.usize()
                _:
                    return null if query_extra_count > 1.usize()
                    qi_extra: sview = query_extra_binder_at(comprehension_scope_id, structs)
                    if qi_extra != "":
                        qi_index <- comprehension_var
                        qi_var <- qi_extra
                        qi_iterable <- enumerate_receiver
                    else:
                        return null if query_extra_count == 1.usize()
            # A container comprehension whose `expected` is a struct is either a DICT
            # comprehension (`{k: v for …}`, a DynDict — the pair rides in `body` as a Tuple) or a
            # SET comprehension (`{x for …}`, a DynSet — `body` is the element). Route by base;
            # both are dispatched before the darray path.
            if expected.kind == TypeKind.Struct:
                return null if query_extra_count > 0.usize()
                comp_struct_base: mutable sview = ""
                comp_struct_arg_start: mutable usize = 0
                comp_struct_arg_count: mutable usize = 0
                comp_struct_has: bool = generic_struct_instantiation_of(structs, expected, comp_struct_base, comp_struct_arg_start, comp_struct_arg_count)
                return null if not comp_struct_has
                if comp_struct_base == "DynSet":
                    return emit_set_comprehension(comprehension_var, iterable, condition, body, expected, local_scope, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}
                return emit_dict_comprehension(comprehension_var, iterable, condition, body, expected, local_scope, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}
            # Quantifier `any|all VAR in ITER where COND` — Comprehension with empty body,
            # expected bool. Stage0 lowers to a loop that short-circuits.
            #
            # WHICH quantifier comes from the scope-ID `__query` marker, exactly as `count`
            # does below. It has to: Expr.Comprehension drops the head keyword, and treating
            # every bool empty-body form as `any` made `all x in [1, 0] where x > 0` return
            # TRUE — a wrong answer that compiled, linked and ran clean. An unrecognised head
            # DECLINES rather than guessing; a decline is loud at link time, a wrong
            # quantifier is silent forever.
            # A quantifier's `body` slot carries the GUARD of a `where PATTERN: GUARD` filter
            # (the parser has no separate slot for it), so a non-empty body no longer excludes
            # this branch -- it selects the guarded form.
            if expected.kind == TypeKind.Bool:
                quantifier_head: sview = query_head_for(comprehension_scope_id, comprehension_var, structs)
                universal_quantifier: bool = quantifier_head == "all" or quantifier_head == "forall"
                existential_quantifier: bool = quantifier_head == "any" or quantifier_head == "exists"
                return null if not universal_quantifier and not existential_quantifier
                return emit_any_quantifier(qi_var, qi_index, qi_iterable, condition, body, universal_quantifier, local_scope, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}
            # `count|sum|product VAR in ITER [where COND]` — a FOLD to an integer, not a bool
            # quantifier and not a collection. The parser drops the query head from the node,
            # so which fold this is comes from the scope-ID marker recorded at parse time;
            # without that marker the folds are indistinguishable from one another and must
            # not be guessed. An unrecognised head still declines.
            # A `count … where PATTERN: GUARD` carries the GUARD in the body slot (there is no
            # separate one), so a non-empty body no longer excludes this branch when the
            # scope-ID guard marker says that is what the body is.
            integer_fold_guarded: bool = query_has_guard_at(comprehension_scope_id, structs)
            if is_integer_type(expected) and (body is Expr.Absent or integer_fold_guarded):
                integer_fold_head: sview = query_head_for(comprehension_scope_id, comprehension_var, structs)
                integer_fold_guard: mutable Expr = (Expr.Absent)
                integer_fold_guard <- body if integer_fold_guarded
                return emit_count_quantifier(qi_var, qi_index, qi_iterable, condition, integer_fold_guard, integer_fold_head, expected, local_scope, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}
            # `min|max VAR in ITER [where COND]` — the folds whose result is OPTIONAL, since
            # an empty iterable has no extremum. stage0 types these as `T?`, so they arrive
            # here with an Optional `expected` rather than a bare integer.
            if expected.kind == TypeKind.Optional:
                extremum_head: sview = query_head_for(comprehension_scope_id, comprehension_var, structs)
                # `first` is the one Optional-producing query with a PROJECTION form
                # (`entry.name for first entry in …`), so it is dispatched whether or not the
                # node carries a body. min/max have no projection spelling and still require
                # an empty one.
                if extremum_head == "first":
                    return emit_first_quantifier(qi_var, qi_index, qi_iterable, condition, body, expected, local_scope, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}
                match body:
                    Expr.Absent:
                        pass
                    _:
                        return null
                return null if extremum_head != "min" and extremum_head != "max"
                return emit_minmax_quantifier(qi_var, qi_index, qi_iterable, condition, extremum_head == "max", expected, local_scope, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}
            return null if expected.kind != TypeKind.DArray
            # `each VAR in ITER where COND` — the COLLECTION query. It carries no projection
            # body because the element IS the binder: `each item in xs where c` means exactly
            # `[item for item in xs if c]`, which this branch already lowers. Supply the
            # identity body rather than writing a second collection loop.
            #
            # The head marker is consulted but not required: this branch is already gated on a
            # DARRAY expected type, and every other body-less query (`any`/`all`/`forall`/
            # `exists`) is BOOL, so a body-less comprehension collecting into a darray can only
            # be `each`.
            # For a leading-keyword `each … where PATTERN: GUARD` the BODY slot holds the
            # GUARD, not a projection -- collecting it would push a bool as the element. Split
            # the two roles on the scope-ID marker: with a guard the element is the binder
            # (the identity form) and the guard joins the filter.
            collection_guard: mutable Expr = (Expr.Absent)
            collection_body: mutable Expr = body
            if query_has_guard_at(comprehension_scope_id, structs):
                collection_guard <- body
                collection_body <- (Expr.Ident(qi_var, Ast::pos_at_line(comprehension_line)))
            else:
                match body:
                    Expr.Absent:
                        collection_head: sview = query_head_for(comprehension_scope_id, comprehension_var, structs)
                        collection_body <- (Expr.Ident(qi_var, Ast::pos_at_line(comprehension_line))) if collection_head == "each" or collection_head == ""
                    _:
                        pass
            # A quantifier (`any`/`all`) has no body; only the collection form is modeled.
            match collection_body:
                Expr.Absent:
                    return null
                _:
                    pass
            match condition:
                Expr.BoolLit(filter_value, _):
                    if not filter_value:
                        return LLVMConstNull(darray_llvm_type(structs, ctx))
                _:
                    pass
            int64_type: LLVMTypeRef = LLVMInt64TypeInContext(ctx)
            element_type: ValueType = darray_element_of(expected, structs)
            return null if element_type.kind == TypeKind.Unmodeled

            # Only an integer RANGE iterable is modeled: its length is known before the loop,
            # which is what makes the presize possible at all.
            match iterable:
                Expr.Binary(range_low, range_operator, range_high, range_line):
                    return null if range_operator != TokenKind.RangeLt and range_operator != TokenKind.RangeLe
                    inclusive: bool = range_operator == TokenKind.RangeLe
                    index_type: ValueType = ValueType{kind: TypeKind.Signed, bits: 64}
                    if (emit_expression(range_low, index_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}) is low_value:
                        if (emit_expression(range_high, index_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}) is high_value:
                            # Decide emptiness before subtracting. For a reversed extreme range,
                            # `high - low` itself can wrap to a positive value (for example
                            # `1 ..< i64::MIN`), turning an empty comprehension into a huge fill.
                            # When the range is nonempty, its cardinality must fit the signed
                            # i64 loop index; trap if subtraction or the inclusive increment
                            # cannot represent it.
                            nonempty_predicate: i32 = 39 if inclusive else 38
                            nonempty: LLVMValueRef = LLVMBuildICmp(builder, nonempty_predicate, high_value, low_value, "comp.range.nonempty")
                            safe_high: LLVMValueRef = LLVMBuildSelect(builder, nonempty, high_value, low_value, "comp.span.high.safe")
                            count: mutable LLVMValueRef = LLVMConstInt(int64_type, 0, 0)
                            if emit_checked_int_binary(TokenKind.Minus, safe_high, low_value, index_type, structs, m, ctx, builder) is span:
                                count <- span
                                if inclusive:
                                    if emit_checked_int_binary(TokenKind.Plus, span, LLVMConstInt(int64_type, 1, 0), index_type, structs, m, ctx, builder) is inclusive_count:
                                        count <- LLVMBuildSelect(builder, nonempty, inclusive_count, LLVMConstInt(int64_type, 0, 0), "comp.count.inclusive")
                                    else:
                                        return null
                            else:
                                return null

                            header: LLVMTypeRef = darray_llvm_type(structs, ctx)
                            result_slot: LLVMValueRef = build_entry_alloca(builder, header, "list.comp.result")
                            _ = LLVMBuildStore(builder, LLVMConstNull(header), result_slot)
                            stride: LLVMValueRef = element_stride(element_type, structs, ctx)
                            if emit_checked_reserve_binary(count, stride, true, m, ctx, builder, structs.target.target_pointer_bits) is bytes:
                                alloc_args: mutable darray[LLVMValueRef] = [runtime.arena, runtime_size_argument(bytes, ctx, builder, structs.target.target_pointer_bits)]
                                alloc_pointer: void& = (&alloc_args[0]).cast[void&] can Unsafe.PointerCast
                                items: LLVMValueRef = LLVMBuildCall2(builder, runtime.arena_alloc_type, (runtime.arena_alloc can Global{Read,Write}), alloc_pointer, 2, "comp.alloc")
                                items_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, header, result_slot, 0, "comp.items.ptr")
                                count_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, header, result_slot, 1, "comp.count.ptr")
                                capacity_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, header, result_slot, 2, "comp.cap.ptr")
                                _ = LLVMBuildStore(builder, items, items_pointer)
                                darray_store_size(builder, count, capacity_pointer, ctx, structs.target.target_pointer_bits)
                                # Capacity is the range bound; count is the number of values that
                                # actually pass a dynamic filter and starts at zero.
                                filtered: bool = match condition:
                                    Expr.Absent: false
                                    Expr.BoolLit: false
                                    _: true
                                if filtered:
                                    darray_store_size(builder, LLVMConstInt(int64_type, 0, 0), count_pointer, ctx, structs.target.target_pointer_bits)
                                else:
                                    darray_store_size(builder, count, count_pointer, ctx, structs.target.target_pointer_bits)
                                darray_store_size(builder, count, capacity_pointer, ctx, structs.target.target_pointer_bits)
                                output_index_slot: LLVMValueRef = build_entry_alloca(builder, int64_type, "comp.out.i")
                                _ = LLVMBuildStore(builder, LLVMConstInt(int64_type, 0, 0), output_index_slot)

                                function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                                index_slot: LLVMValueRef = build_entry_alloca(builder, int64_type, "comp.i")
                                _ = LLVMBuildStore(builder, LLVMConstInt(int64_type, 0, 0), index_slot)
                                var_slot: LLVMValueRef = build_entry_alloca(builder, llvm_type_of(index_type, structs, ctx), "comp.var")
                                declare_local(local_scope, comprehension_var, var_slot, index_type)

                                condition_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "comp.cond")
                                body_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "comp.input")
                                write_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "comp.write")
                                skip_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "comp.skip")
                                latch_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "comp.latch")
                                done_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "comp.done")
                                _ = LLVMBuildBr(builder, condition_block)
                                LLVMPositionBuilderAtEnd(builder, condition_block)
                                current: LLVMValueRef = LLVMBuildLoad2(builder, int64_type, index_slot, "comp.i.cur")
                                more: LLVMValueRef = LLVMBuildICmp(builder, 40, current, count, "comp.more")
                                _ = LLVMBuildCondBr(builder, more, body_block, done_block)

                                LLVMPositionBuilderAtEnd(builder, body_block)
                                _ = LLVMBuildStore(builder, LLVMBuildAdd(builder, low_value, current, "comp.var.value"), var_slot)
                                if filtered:
                                    if (emit_filter_predicate(comprehension_var, condition, collection_guard, local_scope, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}) is predicate:
                                        _ = LLVMBuildCondBr(builder, predicate, write_block, skip_block)
                                    else:
                                        LLVMPositionBuilderAtEnd(builder, done_block)
                                        return null
                                    LLVMPositionBuilderAtEnd(builder, write_block)
                                if (emit_expression(collection_body, element_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}) is element_value:
                                    loaded_items: LLVMValueRef = LLVMBuildLoad2(builder, LLVMPointerTypeInContext(ctx, 0), items_pointer, "comp.items")
                                    # A darray indexes with a ONE-index GEP: `items` is already a T*.
                                    output_index: LLVMValueRef = LLVMBuildLoad2(builder, int64_type, output_index_slot, "comp.out.i.cur") if filtered else current
                                    comp_indices: mutable darray[LLVMValueRef] = [output_index]
                                    comp_indices_pointer: void& = (&comp_indices[0]).cast[void&] can Unsafe.PointerCast
                                    slot_pointer: LLVMValueRef = LLVMBuildGEP2(builder, llvm_type_of(element_type, structs, ctx), loaded_items, comp_indices_pointer, 1, "comp.slot")
                                    _ = LLVMBuildStore(builder, element_value, slot_pointer)
                                    if filtered:
                                        _ = LLVMBuildStore(builder, LLVMBuildAdd(builder, output_index, LLVMConstInt(int64_type, 1, 0), "comp.out.i.next"), output_index_slot)
                                        darray_store_size(builder, LLVMBuildAdd(builder, output_index, LLVMConstInt(int64_type, 1, 0), "comp.count.next"), count_pointer, ctx, structs.target.target_pointer_bits)
                                    _ = LLVMBuildStore(builder, LLVMBuildAdd(builder, current, LLVMConstInt(int64_type, 1, 0), "comp.i.next"), index_slot)
                                    # The LATCH is what carries the marker: this branch is the loop's
                                    # back-edge, and `!llvm.loop` belongs on it.
                                    _ = LLVMBuildBr(builder, latch_block)
                                    if filtered:
                                        LLVMPositionBuilderAtEnd(builder, skip_block)
                                        _ = LLVMBuildStore(builder, LLVMBuildAdd(builder, current, LLVMConstInt(int64_type, 1, 0), "comp.i.skip"), index_slot)
                                        _ = LLVMBuildBr(builder, latch_block)
                                    LLVMPositionBuilderAtEnd(builder, latch_block)
                                    latch: LLVMValueRef = LLVMBuildBr(builder, condition_block)
                                    tag_autovec_loop(latch, "comprehension", ctx)
                                    if not filtered:
                                        LLVMPositionBuilderAtEnd(builder, write_block)
                                        _ = LLVMBuildUnreachable(builder)
                                        LLVMPositionBuilderAtEnd(builder, skip_block)
                                        _ = LLVMBuildUnreachable(builder)
                                    LLVMPositionBuilderAtEnd(builder, done_block)
                                    return LLVMBuildLoad2(builder, header, result_slot, "list.comp.value")
                                LLVMPositionBuilderAtEnd(builder, done_block)
                                return null
                            return null
                _:
                    pass
            # `[BODY for VAR in XS (if COND)?]` over an existing DARRAY source (the most common
            # comprehension form; the range path above needs a compile-time count and cannot take
            # one). The source count is dynamic, so this builds the output by PUSH — behaviourally
            # identical, exit-code-verified; it forgoes the range path's presize/vectorize, which
            # a dynamic-length source could not use anyway.
            lc_source_type: ValueType = iterable_darray_type(qi_iterable, local_scope, fns, structs, generics)
            if lc_source_type.kind == TypeKind.DArray:
                if (darray_read_slot(qi_iterable, lc_source_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}) is lc_source_slot:
                    lc_source_elem: ValueType = darray_element_of(lc_source_type, structs)
                    return null if lc_source_elem.kind == TypeKind.Unmodeled
                    lc_i64: LLVMTypeRef = LLVMInt64TypeInContext(ctx)
                    lc_header: LLVMTypeRef = darray_llvm_type(structs, ctx)
                    lc_out_slot: LLVMValueRef = build_entry_alloca(builder, lc_header, "list.comp.d.out")
                    _ = LLVMBuildStore(builder, LLVMConstNull(lc_header), lc_out_slot)
                    lc_count_ptr: LLVMValueRef = LLVMBuildStructGEP2(builder, lc_header, lc_source_slot, 1, "list.comp.d.cnt.ptr")
                    lc_count: LLVMValueRef = darray_load_size_i64(lc_count_ptr, ctx, builder, "list.comp.d.cnt", structs.target.target_pointer_bits)
                    # Without a filter the output has exactly the source's count: reserve it once
                    # up front, so the pushes below never grow (one allocation instead of a
                    # doubling series of reallocations and copies).
                    lc_unfiltered: bool = match condition:
                        Expr.Absent: true
                        Expr.BoolLit(lc_constant_filter, _): lc_constant_filter
                        _: false
                    if lc_unfiltered:
                        return null if not (emit_darray_reserve(lc_out_slot, expected, lc_count, structs, runtime, m, ctx, builder) can Global{Read,Write})
                    lc_index_slot: LLVMValueRef = build_entry_alloca(builder, lc_i64, "list.comp.d.i")
                    _ = LLVMBuildStore(builder, LLVMConstInt(lc_i64, 0, 0), lc_index_slot)
                    lc_var_slot: LLVMValueRef = build_entry_alloca(builder, llvm_type_of(lc_source_elem, structs, ctx), "list.comp.d.var")
                    declare_local(local_scope, qi_var, lc_var_slot, lc_source_elem)
                    # `each index, item in xs.enumerate()` — the index binder rides the counter.
                    lc_pos_slot: LLVMValueRef = build_entry_alloca(builder, lc_i64, "list.comp.d.pos")
                    if qi_index != "":
                        declare_local(local_scope, qi_index, lc_pos_slot, ValueType{kind: TypeKind.Signed, bits: 64})
                    lc_filtered: bool = match condition:
                        Expr.Absent: false
                        Expr.BoolLit: false
                        _: true
                    # A constant-false filter yields the empty darray.
                    match condition:
                        Expr.BoolLit(lc_filter_value, _):
                            if not lc_filter_value:
                                return LLVMBuildLoad2(builder, lc_header, lc_out_slot, "list.comp.d.empty")
                        _:
                            pass
                    lc_function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                    lc_cond: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, lc_function, "list.comp.d.cond")
                    lc_bodyb: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, lc_function, "list.comp.d.body")
                    lc_push_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, lc_function, "list.comp.d.push")
                    lc_step: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, lc_function, "list.comp.d.step")
                    lc_done: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, lc_function, "list.comp.d.done")
                    # The source's items pointer, loaded once before the loop as the `for`
                    # statement does (codegen_stmt_for_shapes.elisa), so both compile alike.
                    lc_items_ptr: LLVMValueRef = LLVMBuildStructGEP2(builder, lc_header, lc_source_slot, 0, "list.comp.d.items.ptr")
                    lc_items: LLVMValueRef = LLVMBuildLoad2(builder, LLVMPointerTypeInContext(ctx, 0), lc_items_ptr, "list.comp.d.items")
                    _ = LLVMBuildBr(builder, lc_cond)
                    LLVMPositionBuilderAtEnd(builder, lc_cond)
                    lc_cur: LLVMValueRef = LLVMBuildLoad2(builder, lc_i64, lc_index_slot, "list.comp.d.cur")
                    lc_more: LLVMValueRef = LLVMBuildICmp(builder, 40, lc_cur, lc_count, "list.comp.d.more")
                    _ = LLVMBuildCondBr(builder, lc_more, lc_bodyb, lc_done)
                    LLVMPositionBuilderAtEnd(builder, lc_bodyb)
                    # Bind VAR = source[cur]: load the items pointer loaded before the loop and
                    # GEP by the current counter at the element stride — the same shape the darray
                    # for-loop uses to walk its backing.
                    if true:
                        lc_elem_llvm: LLVMTypeRef = llvm_type_of(lc_source_elem, structs, ctx)
                        lc_gep_indices: mutable darray[LLVMValueRef] = [lc_cur]
                        lc_gep_pointer: void& = (&lc_gep_indices[0]).cast[void&] can Unsafe.PointerCast
                        lc_elem_ptr: LLVMValueRef = LLVMBuildGEP2(builder, lc_elem_llvm, lc_items, lc_gep_pointer, 1, "list.comp.d.elem.ptr")
                        lc_elem_value: LLVMValueRef = LLVMBuildLoad2(builder, lc_elem_llvm, lc_elem_ptr, "list.comp.d.elem")
                        _ = LLVMBuildStore(builder, lc_elem_value, lc_var_slot)
                        if qi_index != "":
                            _ = LLVMBuildStore(builder, lc_cur, lc_pos_slot)
                        lc_body_ok: mutable bool = true
                        if lc_filtered:
                            if (emit_filter_predicate(qi_var, condition, collection_guard, local_scope, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}) is lc_pred:
                                _ = LLVMBuildCondBr(builder, lc_pred, lc_push_block, lc_step)
                            else:
                                lc_body_ok <- false
                        else:
                            _ = LLVMBuildBr(builder, lc_push_block)
                        return null if not lc_body_ok
                        LLVMPositionBuilderAtEnd(builder, lc_push_block)
                        if (emit_darray_push(lc_out_slot, expected, collection_body, local_scope, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}):
                            _ = LLVMBuildBr(builder, lc_step)
                            LLVMPositionBuilderAtEnd(builder, lc_step)
                            _ = LLVMBuildStore(builder, LLVMBuildAdd(builder, lc_cur, LLVMConstInt(lc_i64, 1, 0), "list.comp.d.next"), lc_index_slot)
                            _ = LLVMBuildBr(builder, lc_cond)
                            LLVMPositionBuilderAtEnd(builder, lc_done)
                            return LLVMBuildLoad2(builder, lc_header, lc_out_slot, "list.comp.d.value")
                        return null
                    return null
            # `[c for c in s]` over an SVIEW — the byte-collect shape the semantic layer's
            # sview_equal uses. sview is `{ptr, i64 len}`, so the element is a u8 read by
            # index < len; the CFG is the darray path's with the header loads replaced by
            # ExtractValue. A PUSH loop rather than presize-and-fill: the filtered form has
            # no known count, and unlike the range comprehension this shape is a byte walk,
            # not a vectorization target. cstr is NOT accepted here — its length needs a
            # strlen call, so it stays a decline rather than a wrong (zero-length) answer.
            lc_sview_type: ValueType = expression_type(iterable, local_scope, fns, structs, generics)
            if lc_sview_type.kind == TypeKind.SView:
                if (emit_expression(iterable, lc_sview_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}) is lc_s_value:
                    lc_s_u8: ValueType = ValueType{kind: TypeKind.Unsigned, bits: 8}
                    return null if element_type.kind != TypeKind.Unsigned or element_type.bits != 8
                    lc_s_i64: LLVMTypeRef = LLVMInt64TypeInContext(ctx)
                    lc_s_u8_llvm: LLVMTypeRef = LLVMInt8TypeInContext(ctx)
                    lc_s_header: LLVMTypeRef = darray_llvm_type(structs, ctx)
                    lc_s_out_slot: LLVMValueRef = build_entry_alloca(builder, lc_s_header, "list.comp.s.out")
                    _ = LLVMBuildStore(builder, LLVMConstNull(lc_s_header), lc_s_out_slot)
                    lc_s_ptr: LLVMValueRef = LLVMBuildExtractValue(builder, lc_s_value, 0, "list.comp.s.ptr")
                    lc_s_len: LLVMValueRef = darray_size_value_i64(LLVMBuildExtractValue(builder, lc_s_value, 1, "list.comp.s.len.raw"), ctx, builder, "list.comp.s.len")
                    lc_s_index_slot: LLVMValueRef = build_entry_alloca(builder, lc_s_i64, "list.comp.s.i")
                    _ = LLVMBuildStore(builder, LLVMConstInt(lc_s_i64, 0, 0), lc_s_index_slot)
                    lc_s_var_slot: LLVMValueRef = build_entry_alloca(builder, lc_s_u8_llvm, "list.comp.s.var")
                    declare_local(local_scope, comprehension_var, lc_s_var_slot, lc_s_u8)
                    lc_s_filtered: bool = match condition:
                        Expr.Absent: false
                        Expr.BoolLit: false
                        _: true
                    match condition:
                        Expr.BoolLit(lc_s_filter_value, _):
                            if not lc_s_filter_value:
                                return LLVMBuildLoad2(builder, lc_s_header, lc_s_out_slot, "list.comp.s.empty")
                        _:
                            pass
                    lc_s_function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                    lc_s_cond: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, lc_s_function, "list.comp.s.cond")
                    lc_s_bodyb: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, lc_s_function, "list.comp.s.body")
                    lc_s_push_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, lc_s_function, "list.comp.s.push")
                    lc_s_step: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, lc_s_function, "list.comp.s.step")
                    lc_s_done: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, lc_s_function, "list.comp.s.done")
                    _ = LLVMBuildBr(builder, lc_s_cond)
                    LLVMPositionBuilderAtEnd(builder, lc_s_cond)
                    lc_s_cur: LLVMValueRef = LLVMBuildLoad2(builder, lc_s_i64, lc_s_index_slot, "list.comp.s.cur")
                    lc_s_more: LLVMValueRef = LLVMBuildICmp(builder, 40, lc_s_cur, lc_s_len, "list.comp.s.more")
                    _ = LLVMBuildCondBr(builder, lc_s_more, lc_s_bodyb, lc_s_done)
                    LLVMPositionBuilderAtEnd(builder, lc_s_bodyb)
                    lc_s_gep_indices: mutable darray[LLVMValueRef] = [lc_s_cur]
                    lc_s_gep_pointer: void& = (&lc_s_gep_indices[0]).cast[void&] can Unsafe.PointerCast
                    lc_s_byte_ptr: LLVMValueRef = LLVMBuildGEP2(builder, lc_s_u8_llvm, lc_s_ptr, lc_s_gep_pointer, 1, "list.comp.s.byte.ptr")
                    lc_s_byte: LLVMValueRef = LLVMBuildLoad2(builder, lc_s_u8_llvm, lc_s_byte_ptr, "list.comp.s.byte")
                    _ = LLVMBuildStore(builder, lc_s_byte, lc_s_var_slot)
                    lc_s_body_ok: mutable bool = true
                    if lc_s_filtered:
                        if (emit_filter_predicate(comprehension_var, condition, collection_guard, local_scope, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}) is lc_s_pred:
                            _ = LLVMBuildCondBr(builder, lc_s_pred, lc_s_push_block, lc_s_step)
                        else:
                            lc_s_body_ok <- false
                    else:
                        _ = LLVMBuildBr(builder, lc_s_push_block)
                    return null if not lc_s_body_ok
                    LLVMPositionBuilderAtEnd(builder, lc_s_push_block)
                    if (emit_darray_push(lc_s_out_slot, expected, collection_body, local_scope, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}):
                        _ = LLVMBuildBr(builder, lc_s_step)
                        LLVMPositionBuilderAtEnd(builder, lc_s_step)
                        _ = LLVMBuildStore(builder, LLVMBuildAdd(builder, lc_s_cur, LLVMConstInt(lc_s_i64, 1, 0), "list.comp.s.next"), lc_s_index_slot)
                        _ = LLVMBuildBr(builder, lc_s_cond)
                        LLVMPositionBuilderAtEnd(builder, lc_s_done)
                        return LLVMBuildLoad2(builder, lc_s_header, lc_s_out_slot, "list.comp.s.value")
                    return null
            return null
