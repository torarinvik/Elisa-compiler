# Stage1 backend — type resolution/conversion, index addressing, and the list comprehension emitter.
# Part of `module Backend` (see codegen.elisa); split out to keep each file short.

extend Backend:
    private:
        # The type a value will actually have: its own if known, else the context's.
        # An integer literal has no intrinsic type, so `expected` is what makes
        # `a: u8 = 200` a u8 rather than an i64 that is then truncated behind your back.
        def resolve_type(expression: Expr, expected: ValueType, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&) -> ValueType can[Abort.Panic]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                own: ValueType = expression_type(expression, local_scope, fns, structs, generics)
                own return if own.kind != TypeKind.Unmodeled
                return expected


            # Convert `value` from `from_type` to `to_type`. Widening sign-extends a signed
            # source and zero-extends an unsigned one (that IS the difference between
            # `u8 200 -> i64 200` and `i8 200 -> i64 -56`); narrowing truncates. Same width is
            # a no-op — a signed/unsigned reinterpretation costs no instruction.
        def emit_conversion(value: LLVMValueRef, from_type: ValueType, to_type: ValueType, structs: mutable StructTable&, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                null return if from_type.kind == TypeKind.Unmodeled or to_type.kind == TypeKind.Unmodeled
                target: LLVMTypeRef = llvm_type_of(to_type, structs, ctx)
                # C permits boolean/integer conversions. The translator uses a boolean
                # result from APIs such as SDL_GetJoystickButton and then emits an explicit
                # `.i32()` cast, while C truth tests can also place an integer in a bool field.
                # Keep Elisa's ordinary source-level bool rules strict; this is the backend's
                # ABI conversion for generated C expressions.
                if from_type.kind == TypeKind.Bool and is_integer_type(to_type):
                    return LLVMBuildZExt(builder, value, target, "bool.to.int")
                if to_type.kind == TypeKind.Bool and is_integer_type(from_type):
                    return LLVMBuildICmp(builder, 33, value, LLVMConstInt(llvm_type_of(from_type, structs, ctx), 0, 0), "int.to.bool")
                if from_type.kind == TypeKind.Bool or to_type.kind == TypeKind.Bool:
                    value return if from_type.kind == to_type.kind
                    return null

                # float -> int TRUNCATES toward zero (`7.5.i64()` is 7, and `(-7.5).i64()` is
                # -7), which is what FPToSI does — verified against stage0.
                if from_type.kind == TypeKind.Float and to_type.kind != TypeKind.Float:
                    return LLVMBuildFPToSI(builder, value, target, "fptosi") if to_type.kind == TypeKind.Signed else LLVMBuildFPToUI(builder, value, target, "fptoui")
                # int -> float follows the SOURCE's signedness: u8 200 becomes 200.0, i8 -56
                # becomes -56.0.
                if to_type.kind == TypeKind.Float and from_type.kind != TypeKind.Float:
                    return LLVMBuildSIToFP(builder, value, target, "sitofp") if from_type.kind == TypeKind.Signed else LLVMBuildUIToFP(builder, value, target, "uitofp")
                if from_type.kind == TypeKind.Float and to_type.kind == TypeKind.Float:
                    value return if from_type.bits == to_type.bits
                    return LLVMBuildFPTrunc(builder, value, target, "fptrunc") if to_type.bits < from_type.bits else LLVMBuildFPExt(builder, value, target, "fpext")

                # POINTER <-> INTEGER is a distinct cast, not a width change: `zext ptr .. to i64`
                # is invalid IR llc rejects. The std takes a pointer DIFFERENCE this way --
                # arena_tail_offset_slots is `(ptr.cast[heap u8&].usize() - base.usize()) / stride`
                # -- so every dict program went through here.
                # A FUNCTION pointer and a NICHE optional are pointer-shaped too, and both were
                # missing: the std's fault-handler install is
                # `elisa_trace_fault_handler.cast[void&?].uintptr()`, whose source is an optional
                # ref (niche form: a bare ptr). That fell through to the width branch and emitted
                # `zext ptr @elisa_trace_fault_handler to i64` — an invalid cast opcode, in every
                # program that includes the std. stage0 emits `ptrtoint`.
                from_is_pointer: bool = from_type.kind == TypeKind.Ref or from_type.kind == TypeKind.CStr or from_type.kind == TypeKind.PyObject or from_type.kind == TypeKind.Fn or optional_is_niche(from_type, structs)
                to_is_pointer: bool = to_type.kind == TypeKind.Ref or to_type.kind == TypeKind.CStr or to_type.kind == TypeKind.PyObject or to_type.kind == TypeKind.Fn or optional_is_niche(to_type, structs)
                if from_is_pointer or to_is_pointer:
                    LLVMBuildPtrToInt(builder, value, target, "ptrtoint") return if from_is_pointer and is_integer_type(to_type)
                    LLVMBuildIntToPtr(builder, value, target, "inttoptr") return if to_is_pointer and is_integer_type(from_type)
                    # FLOAT <-> POINTER needs the integer step spelled out: there is no direct
                    # opcode, and `inttoptr double` is invalid IR. stage0 goes through i64 in
                    # both directions (`fptoui` then `inttoptr`, and `ptrtoint` then `uitofp`
                    # -- read from its -emit llvm); without these the cast fell through to the
                    # width branch below and declined.
                    if to_is_pointer and from_type.kind == TypeKind.Float:
                        float_to_pointer_bits: LLVMValueRef = LLVMBuildFPToUI(builder, value, LLVMInt64TypeInContext(ctx), "fptoui")
                        return LLVMBuildIntToPtr(builder, float_to_pointer_bits, target, "inttoptr")
                    if from_is_pointer and to_type.kind == TypeKind.Float:
                        pointer_to_float_bits: LLVMValueRef = LLVMBuildPtrToInt(builder, value, LLVMInt64TypeInContext(ctx), "ptrtoint")
                        return LLVMBuildUIToFP(builder, pointer_to_float_bits, target, "uitofp")
                    # ptr -> ptr is a no-op under opaque pointers; anything else is unmodeled.
                    value return if from_is_pointer and to_is_pointer
                    return null

                value return if from_type.bits == to_type.bits
                LLVMBuildTrunc(builder, value, target, "trunc") return if to_type.bits < from_type.bits
                return LLVMBuildSExt(builder, value, target, "sext") if from_type.kind == TypeKind.Signed else LLVMBuildZExt(builder, value, target, "zext")


        # Emit an expression for a concrete destination, with one final, uniform
        # coercion step for scalar values. Most expression branches already honor
        # `expected`, but C translation reaches the same store through many routes:
        # a field, an indexed element, a local, a call, or a nested chain. Keeping
        # this policy here prevents those routes from disagreeing about ordinary C
        # conversions such as `double -> int` and `unsigned char -> size_t`.
        #
        # An unknown expression type is deliberately emitted with the expected type:
        # integer/float literals and context-typed value-if expressions need that
        # context in order to exist at all. Known numeric expressions are emitted at
        # their natural type first, then converted explicitly so a branch that does
        # not propagate `expected` cannot create a width-mismatched LLVM store.
        def emit_expression_coerced(expression: Expr, expected: ValueType, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            actual: ValueType = expression_type(expression, local_scope, fns, structs, generics)
            if actual.kind == TypeKind.Unmodeled or expected.kind == TypeKind.Unmodeled:
                return emit_expression(expression, expected, local_scope, fns, structs, generics, runtime, m, ctx, builder)
            if actual.kind == expected.kind and actual.bits == expected.bits:
                return emit_expression(expression, expected, local_scope, fns, structs, generics, runtime, m, ctx, builder)
            if is_numeric_type(actual) and is_numeric_type(expected):
                if emit_expression(expression, actual, local_scope, fns, structs, generics, runtime, m, ctx, builder) is natural_value:
                    return emit_conversion(natural_value, actual, expected, structs, ctx, builder)
                return null
            # Reference-valued calls and locals have their own auto-dereference rules
            # in the expression emitter. Let that path see the destination type rather
            # than treating a pointer-shaped value as a scalar here.
            return emit_expression(expression, expected, local_scope, fns, structs, generics, runtime, m, ctx, builder)


            # The ADDRESS of `xs[i]` for a DARRAY.
            #
            # ONE index, not two: `items` is already a `T*`, so there is no leading 0 to step
            # over the way a fixed array's pointer-to-array needs.
        def emit_darray_index_address(array_slot: LLVMValueRef, array_type: ValueType, index_expression: Expr, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            null return if array_type.kind != TypeKind.DArray
            element_type: ValueType = darray_element_of(array_type, structs)
            null return if element_type.kind == TypeKind.Unmodeled
            index_type: ValueType = ValueType{kind: TypeKind.Signed, bits: 64}
            if emit_expression(index_expression, index_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is index_value:
                emit_index_bounds_guard(array_slot, array_type, index_value, runtime, structs, m, ctx, builder)
                items_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, darray_llvm_type(structs, ctx), array_slot, 0, "darray.items.ptr")
                items: LLVMValueRef = LLVMBuildLoad2(builder, LLVMPointerTypeInContext(ctx, 0), items_pointer, "darray.items")
                tag_darray_header_access(items, ctx)
                indices: mutable darray[LLVMValueRef] = [index_value]
                indices_pointer: void& = (&indices[0]).cast[void&] can Unsafe.PointerCast
                element_pointer: LLVMValueRef = LLVMBuildGEP2(builder, llvm_type_of(element_type, structs, ctx), items, indices_pointer, 1, "darray.elem.ptr")
                return element_pointer
            return null


        # The ADDRESS of `xs[i]`.
        #
        # A two-index GEP: the first index (always 0) steps over the array POINTER itself,
        # the second selects the element — the classic C-array shape. StructGEP cannot be
        # used because the index is dynamic.
        #
        # NO BOUNDS CHECK: the subset does not model one. That matches `-emit obj` without
        # -fbounds-check, which is what the differential compares against; a checked build
        # is a separate feature, not a silent default.
        def emit_index_address(array_slot: LLVMValueRef, array_type: ValueType, index_expression: Expr, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            null return if array_type.kind != TypeKind.Array
            index_type: ValueType = ValueType{kind: TypeKind.Signed, bits: 64}
            if emit_expression(index_expression, index_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is index_value:
                emit_index_bounds_guard(array_slot, array_type, index_value, runtime, structs, m, ctx, builder)
                indices: mutable darray[LLVMValueRef] = [LLVMConstInt(LLVMInt64TypeInContext(ctx), 0, 0), index_value]
                indices_pointer: void& = (&indices[0]).cast[void&] can Unsafe.PointerCast
                return LLVMBuildGEP2(builder, llvm_type_of(array_type, structs, ctx), array_slot, indices_pointer, 2, "elem.ptr")
            return null


        # Copy a Runtime out of a reference (same borrow rule as copied_type).
        def copied_runtime(runtime: Runtime&) -> Runtime:
            return Runtime{
                owns_arena: runtime.owns_arena,
                fast_math: runtime.fast_math,
                force_bounds_check: runtime.force_bounds_check,
                active_store: runtime.active_store,
                active_store_enum: runtime.active_store_enum,
                error_out: runtime.error_out,
                in_error_fn: runtime.in_error_fn,
                error_fn_line: runtime.error_fn_line,
                error_fn_family: runtime.error_fn_family,
                fn_return_type: copied_type(runtime.fn_return_type),
                main_returns_status: runtime.main_returns_status,
                streq: runtime.streq,
                streq_type: runtime.streq_type,
                sview_eq: runtime.sview_eq,
                sview_eq_type: runtime.sview_eq_type,
                sview_index: runtime.sview_index,
                sview_index_type: runtime.sview_index_type,
                debug_builder: runtime.debug_builder,
                debug_file: runtime.debug_file,
                debug_active: runtime.debug_active,
                trace_record: runtime.trace_record,
                trace_record_type: runtime.trace_record_type,
                trace_record_value: runtime.trace_record_value,
                trace_record_value_type: runtime.trace_record_value_type,
                trace_name: runtime.trace_name,
                trace_enabled: runtime.trace_enabled,
                trace_fault_install: runtime.trace_fault_install,
                trace_fault_install_type: runtime.trace_fault_install_type,
                disjoint_function_name: runtime.disjoint_function_name,
                disjoint_function_mask: runtime.disjoint_function_mask,
                disjoint_param_slots: runtime.disjoint_param_slots,
                disjoint_param_indices: runtime.disjoint_param_indices,
                disjoint_element_ptrs: runtime.disjoint_element_ptrs,
                disjoint_element_indices: runtime.disjoint_element_indices,
                packed_state_new: runtime.packed_state_new,
                packed_state_new_type: runtime.packed_state_new_type,
                packed_state_new_side: runtime.packed_state_new_side,
                packed_state_new_side_type: runtime.packed_state_new_side_type,
                packed_alloc: runtime.packed_alloc,
                packed_alloc_type: runtime.packed_alloc_type,
                packed_alloc_result_type: runtime.packed_alloc_result_type,
                packed_read_tag: runtime.packed_read_tag,
                packed_read_tag_type: runtime.packed_read_tag_type,
                packed_read_word: runtime.packed_read_word,
                packed_read_word_type: runtime.packed_read_word_type,
                packed_record_prefix: runtime.packed_record_prefix,
                packed_record_prefix_type: runtime.packed_record_prefix_type,
                packed_record_side_words: runtime.packed_record_side_words,
                packed_record_side_words_type: runtime.packed_record_side_words_type,
                packed_read_side_word: runtime.packed_read_side_word,
                packed_read_side_word_type: runtime.packed_read_side_word_type,
                active_store_is_block: runtime.active_store_is_block, packed_mode: runtime.packed_mode,
                new_region_backend: runtime.new_region_backend,
                new_region_backend_type: runtime.new_region_backend_type,
                arena_alloc: runtime.arena_alloc,
                arena_realloc: runtime.arena_realloc,
                arena_free: runtime.arena_free,
                arena_alloc_type: runtime.arena_alloc_type,
                arena_realloc_type: runtime.arena_realloc_type,
                arena_free_type: runtime.arena_free_type,
                arena: runtime.arena,
                caller_arena: runtime.caller_arena,
                caller_arenas: runtime.caller_arenas
            }


        # `arena_free(region)` — release the function's auto region. Idempotent in the
        # runtime and a no-op for a region that never allocated (strategy 2 is lazy), so
        # emitting it unconditionally on every return path is correct and cheap.
        def emit_region_free(runtime: Runtime&, builder: LLVMBuilderRef) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            # A BORROWED region (the caller's, threaded in) is not ours to free.
            return if not runtime.owns_arena
            arguments: mutable darray[LLVMValueRef] = [runtime.arena]
            arguments_pointer: void& = (&arguments[0]).cast[void&] can Unsafe.PointerCast
            _ = LLVMBuildCall2(builder, runtime.arena_free_type, runtime.arena_free, arguments_pointer, 1, "")


        # `xs.push(v)` — grow-if-needed, store, bump count.
        #
        # Mirrors stage0's lowering, read out of its own `-emit llvm` output:
        #
        #   count = xs.count; needed = count + 1
        #   if xs.capacity < needed:
        #       new_cap = capacity == 0 ? 8 : max(capacity * 2, needed)
        #       items = xs.items == null ? arena_alloc(arena, new_bytes)
        #                                : arena_realloc(arena, items, old_bytes, new_bytes)
        #       xs.items = items; xs.capacity = new_cap
        #   xs.items[count] = v; xs.count = needed
        #
        # The 8 initial capacity is stage0's runtime policy. Overflow TRAPS are omitted:
        # they only abort on a capacity that cannot occur in a modeled program, so their
        # absence is unobservable in the differential — but it does mean this lowering is
        # not a bit-for-bit clone, only a behavioural one.
        # Tag a loop's LATCH branch `!llvm.loop !{ <self>, !{ "elisa.autovec.expected", pos,
        # reason } }` — stage0's exact shape.
        #
        # The marker rides IN THE IR, which is the point: it survives inlining (a held
        # function reference would not), so a post-optimization pass can still identify a
        # comprehension build loop that was lowered to be vectorizable and then wasn't. That
        # is the entire basis of `-Wperf`.
        #
        # LLVM requires a loop-ID node's operand 0 to be the node ITSELF, so it is built via
        # a temporary that is then replaced by the finished node.
        def tag_autovec_loop(branch: LLVMValueRef, position: sview, ctx: LLVMContextRef) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            position_storage: mutable darray[u8] = []
            position_text: cstr = sview_to_cstr(position, position_storage)
            marker_name: LLVMMetadataRef = LLVMMDStringInContext2(ctx, "elisa.autovec.expected", 22)
            position_md: LLVMMetadataRef = LLVMMDStringInContext2(ctx, position_text, sview_len(position))
            reason_md: LLVMMetadataRef = LLVMMDStringInContext2(ctx, "", 0)
            marker_ops: mutable darray[LLVMMetadataRef] = [marker_name, position_md, reason_md]
            marker_pointer: void& = (&marker_ops[0]).cast[void&] can Unsafe.PointerCast
            marker_node: LLVMMetadataRef = LLVMMDNodeInContext2(ctx, marker_pointer, 3)

            temporary: LLVMMetadataRef = LLVMTemporaryMDNode(ctx, null, 0)
            loop_ops: mutable darray[LLVMMetadataRef] = [temporary, marker_node]
            loop_pointer: void& = (&loop_ops[0]).cast[void&] can Unsafe.PointerCast
            loop_id: LLVMMetadataRef = LLVMMDNodeInContext2(ctx, loop_pointer, 2)
            LLVMMetadataReplaceAllUsesWith(temporary, loop_id)

            kind: u32 = LLVMGetMDKindIDInContext(ctx, "llvm.loop", 9)
            LLVMSetMetadata(branch, kind, LLVMMetadataAsValue(ctx, loop_id))


        # `[BODY for VAR in LOW..<HIGH]` — a list comprehension, lowered PRESIZE-AND-FILL the
        # way stage0 does: compute the count, allocate the backing once, set count/capacity
        # up front, then write each element BY INDEX.
        #
        # Not a push loop. A push loop is behaviourally identical and would pass every
        # differential here, but it reallocates as it grows and defeats the vectorizer — and
        # vectorization is the whole point of the construct (`-Wperf`'s autovec verifier tags
        # exactly these loops and reports the ones that failed). Emitting the slow shape for
        # a construct that exists to be fast would be a divergence the exit code cannot see.
        #
        # Constant filters preserve the presized lowering: `if true` is ordinary and
        # `if false` produces an empty darray.
        # `any|all VAR in ITER where COND` — bool quantifier (Comprehension with empty body).
        # Models fixed array-literal iterables (the self-host `valid_suffix` shape) by
        # unrolling: bind VAR to each element and short-circuit on the first DECIDING COND.
        #
        # The two quantifiers are one loop with three things flipped, so they share it rather
        # than duplicating ~80 lines of block plumbing:
        #
        #   universal=false (`any`)  seed FALSE, short-circuit to TRUE  on the first COND that HOLDS
        #   universal=true  (`all`)  seed TRUE,  short-circuit to FALSE on the first COND that FAILS
        #
        # The seed is also the answer for an empty ITER, which is what makes `all` over an
        # empty darray vacuously TRUE — the case that separates it from `any` even when every
        # element would agree.
        # A query filter's effective predicate: the `where` CONDITION, and -- when the query
        # carries the `where PATTERN: GUARD` form -- the guard evaluated only on the matched
        # side, where the pattern's payload bindings are live.
        #
        # It cannot be folded into `condition and guard`: stage0 REJECTS that spelling in a
        # query filter ("undefined identifier" for the payload binder), so emitting it would
        # be permissive. Nesting is also what the `for`-loop form does with the same shape.
        def emit_filter_predicate(comprehension_var: sview, condition: Expr, guard: Expr, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            gp_bool: LLVMTypeRef = LLVMInt1TypeInContext(ctx)
            # A BARE PATTERN filter (`where Expr.Int(value)`, no `item is` in front) is a
            # PATTERN, not a predicate: it must BIND the payload as well as test the tag. It
            # means exactly `BINDER is PATTERN`, which is fully lowered, so rewrite to that
            # rather than grow a second pattern path here -- the `for`-loop filter does the
            # same. Both the payload form and the payload-free one are covered.
            gp_condition: mutable Expr = condition
            if is_bare_pattern_filter_expr(condition) or is_bare_variant_filter_expr(condition, structs):
                gp_condition <- (Expr.Binary((Expr.Ident(comprehension_var, Ast::pos_at_line(0))), TokenKind.Is, condition, Ast::pos_at_line(0)))
            if emit_condition(gp_condition, local_scope, fns, structs, generics, runtime, m, ctx, builder) is gp_condition_bit:
                match guard:
                    Expr.Absent:
                        return gp_condition_bit
                    _:
                        pass
                gp_slot: LLVMValueRef = LLVMBuildAlloca(builder, gp_bool, "filter.pred")
                _ = LLVMBuildStore(builder, LLVMConstInt(gp_bool, 0, 0), gp_slot)
                gp_function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                gp_guard_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, gp_function, "filter.guard")
                gp_merge_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, gp_function, "filter.merge")
                _ = LLVMBuildCondBr(builder, gp_condition_bit, gp_guard_block, gp_merge_block)
                LLVMPositionBuilderAtEnd(builder, gp_guard_block)
                if emit_condition(guard, local_scope, fns, structs, generics, runtime, m, ctx, builder) is gp_guard_bit:
                    _ = LLVMBuildStore(builder, gp_guard_bit, gp_slot)
                    _ = LLVMBuildBr(builder, gp_merge_block)
                    LLVMPositionBuilderAtEnd(builder, gp_merge_block)
                    return LLVMBuildLoad2(builder, gp_bool, gp_slot, "filter.pred.value")
                return null
            return null


        def emit_any_quantifier(comprehension_var: sview, index_binder: sview, iterable: Expr, condition: Expr, guard: Expr, universal: bool, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            # The value the loop settles on if it never short-circuits, and the value it
            # stores when it does. Always opposites.
            seed_bit: u64 = 1 if universal else 0
            decided_bit: u64 = 0 if universal else 1
            match iterable:
                Expr.Array(elements, array_line):
                    null return if elements.count == 0
                    bool_ty: LLVMTypeRef = LLVMInt1TypeInContext(ctx)
                    result_slot: LLVMValueRef = LLVMBuildAlloca(builder, bool_ty, "any.result")
                    _ = LLVMBuildStore(builder, LLVMConstInt(bool_ty, seed_bit, 0), result_slot)
                    function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                    done_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "any.done")
                    declined: mutable bool = false
                    for element in elements |declined, comprehension_var, condition, universal, decided_bit, result_slot, done_block, function, local_scope, fns, structs, generics, runtime, m, ctx, builder|:
                        continue if declined
                        elem_type: mutable ValueType = expression_type(element, local_scope, fns, structs, generics)
                        # A bare int literal has no type of its own, and the CStr fallback below
                        # was written for the self-host `valid_suffix` shape, whose elements are
                        # STRING literals. So `all x in [1, 2, 3] where x > 0` typed `1` as a
                        # string, failed to emit it, and declined — while the same quantifier over
                        # a NAMED darray worked. Default to signed-64 first, as the `for` header
                        # and the integer folds do.
                        if elem_type.kind == TypeKind.Unmodeled:
                            match element:
                                Expr.IntLit(_):
                                    elem_type <- ValueType{kind: TypeKind.Signed, bits: 64}
                                _:
                                    pass
                        if elem_type.kind == TypeKind.Unmodeled:
                            elem_type <- ValueType{kind: TypeKind.CStr, bits: 0}
                        if emit_expression(element, elem_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is elem_value:
                            var_slot: LLVMValueRef = LLVMBuildAlloca(builder, llvm_type_of(elem_type, structs, ctx), "any.var")
                            _ = LLVMBuildStore(builder, elem_value, var_slot)
                            declare_local(local_scope, comprehension_var, var_slot, elem_type)
                            if emit_filter_predicate(comprehension_var, condition, guard, local_scope, fns, structs, generics, runtime, m, ctx, builder) is cond_bit:
                                hit_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "any.hit")
                                next_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "any.next")
                                # `all` decides on the FALSE edge, `any` on the true one — same two
                                # blocks, opposite successors.
                                if universal:
                                    _ = LLVMBuildCondBr(builder, cond_bit, next_block, hit_block)
                                else:
                                    _ = LLVMBuildCondBr(builder, cond_bit, hit_block, next_block)
                                LLVMPositionBuilderAtEnd(builder, hit_block)
                                _ = LLVMBuildStore(builder, LLVMConstInt(bool_ty, decided_bit, 0), result_slot)
                                _ = LLVMBuildBr(builder, done_block)
                                LLVMPositionBuilderAtEnd(builder, next_block)
                            else:
                                declined <- true
                        else:
                            declined <- true
                    null return if declined
                    _ = LLVMBuildBr(builder, done_block)
                    LLVMPositionBuilderAtEnd(builder, done_block)
                    return LLVMBuildLoad2(builder, bool_ty, result_slot, "any.load")
                _:
                    pass
            # `any VAR in XS where COND` over an existing DARRAY (the self-hosted machine helpers
            # scan arm.payloads / arm.input_literals / a Stmt.Block body this way; the array-literal
            # path above only took `any x in [a, b]`). Loop over XS, eval COND per element,
            # short-circuit to TRUE on the first hit; default FALSE. Mirrors the comprehension walk.
            aq_source_type: ValueType = iterable_darray_type(iterable, local_scope, fns, structs, generics)
            if aq_source_type.kind == TypeKind.DArray:
                if darray_read_slot(iterable, aq_source_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is aq_slot:
                    aq_elem: ValueType = darray_element_of(aq_source_type, structs)
                    null return if aq_elem.kind == TypeKind.Unmodeled
                    match condition:
                        Expr.Absent:
                            return null
                        _:
                            pass
                    aq_i64: LLVMTypeRef = LLVMInt64TypeInContext(ctx)
                    aq_bool: LLVMTypeRef = LLVMInt1TypeInContext(ctx)
                    aq_header: LLVMTypeRef = darray_llvm_type(structs, ctx)
                    aq_result_slot: LLVMValueRef = LLVMBuildAlloca(builder, aq_bool, "any.d.result")
                    _ = LLVMBuildStore(builder, LLVMConstInt(aq_bool, seed_bit, 0), aq_result_slot)
                    aq_count_ptr: LLVMValueRef = LLVMBuildStructGEP2(builder, aq_header, aq_slot, 1, "any.d.cnt.ptr")
                    aq_count: LLVMValueRef = LLVMBuildLoad2(builder, aq_i64, aq_count_ptr, "any.d.cnt")
                    aq_index_slot: LLVMValueRef = LLVMBuildAlloca(builder, aq_i64, "any.d.i")
                    _ = LLVMBuildStore(builder, LLVMConstInt(aq_i64, 0, 0), aq_index_slot)
                    aq_var_slot: LLVMValueRef = LLVMBuildAlloca(builder, llvm_type_of(aq_elem, structs, ctx), "any.d.var")
                    declare_local(local_scope, comprehension_var, aq_var_slot, aq_elem)
                    # `any index, item in xs.enumerate()` — the INDEX binder rides the loop
                    # counter. Its slot is allocated once, outside the loop.
                    aq_pos_slot: LLVMValueRef = LLVMBuildAlloca(builder, aq_i64, "any.d.pos")
                    if index_binder != "":
                        declare_local(local_scope, index_binder, aq_pos_slot, ValueType{kind: TypeKind.Signed, bits: 64})
                    aq_function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                    aq_cond_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, aq_function, "any.d.cond")
                    aq_body_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, aq_function, "any.d.body")
                    aq_hit_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, aq_function, "any.d.hit")
                    aq_step_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, aq_function, "any.d.step")
                    aq_done_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, aq_function, "any.d.done")
                    _ = LLVMBuildBr(builder, aq_cond_block)
                    LLVMPositionBuilderAtEnd(builder, aq_cond_block)
                    aq_cur: LLVMValueRef = LLVMBuildLoad2(builder, aq_i64, aq_index_slot, "any.d.cur")
                    aq_more: LLVMValueRef = LLVMBuildICmp(builder, 40, aq_cur, aq_count, "any.d.more")
                    _ = LLVMBuildCondBr(builder, aq_more, aq_body_block, aq_done_block)
                    LLVMPositionBuilderAtEnd(builder, aq_body_block)
                    aq_items_ptr: LLVMValueRef = LLVMBuildStructGEP2(builder, aq_header, aq_slot, 0, "any.d.items.ptr")
                    aq_items: LLVMValueRef = LLVMBuildLoad2(builder, LLVMPointerTypeInContext(ctx, 0), aq_items_ptr, "any.d.items")
                    aq_elem_llvm: LLVMTypeRef = llvm_type_of(aq_elem, structs, ctx)
                    aq_gep_indices: mutable darray[LLVMValueRef] = [aq_cur]
                    aq_gep_pointer: void& = (&aq_gep_indices[0]).cast[void&] can Unsafe.PointerCast
                    aq_elem_ptr: LLVMValueRef = LLVMBuildGEP2(builder, aq_elem_llvm, aq_items, aq_gep_pointer, 1, "any.d.elem.ptr")
                    aq_elem_value: LLVMValueRef = LLVMBuildLoad2(builder, aq_elem_llvm, aq_elem_ptr, "any.d.elem")
                    _ = LLVMBuildStore(builder, aq_elem_value, aq_var_slot)
                    if index_binder != "":
                        _ = LLVMBuildStore(builder, aq_cur, aq_pos_slot)
                    if emit_filter_predicate(comprehension_var, condition, guard, local_scope, fns, structs, generics, runtime, m, ctx, builder) is aq_pred:
                        if universal:
                            _ = LLVMBuildCondBr(builder, aq_pred, aq_step_block, aq_hit_block)
                        else:
                            _ = LLVMBuildCondBr(builder, aq_pred, aq_hit_block, aq_step_block)
                        LLVMPositionBuilderAtEnd(builder, aq_hit_block)
                        _ = LLVMBuildStore(builder, LLVMConstInt(aq_bool, decided_bit, 0), aq_result_slot)
                        _ = LLVMBuildBr(builder, aq_done_block)
                        LLVMPositionBuilderAtEnd(builder, aq_step_block)
                        aq_next: LLVMValueRef = LLVMBuildAdd(builder, aq_cur, LLVMConstInt(aq_i64, 1, 0), "any.d.next")
                        _ = LLVMBuildStore(builder, aq_next, aq_index_slot)
                        _ = LLVMBuildBr(builder, aq_cond_block)
                        LLVMPositionBuilderAtEnd(builder, aq_done_block)
                        return LLVMBuildLoad2(builder, aq_bool, aq_result_slot, "any.d.load")
                    return null
            return null


        # `count|sum|product VAR in XS [where COND]` over a DARRAY: walk every element (no
        # short-circuit — a fold must see them all), accumulating when COND holds. Returns
        # the accumulator at `expected`'s integer type.
        #
        # One loop, three accumulators — `fold_head` picks the seed and the step:
        #   count    seed 0, acc + 1        (ignores the element's value)
        #   sum      seed 0, acc + element
        #   product  seed 1, acc * element
        #
        # sum/product read the ELEMENT, so they additionally require it to have the result's
        # exact integer type; a widening/narrowing fold declines rather than guessing a
        # conversion. `count` does not read the element and so has no such constraint.
        #
        # A MISSING `where` (`sum x in xs`) folds every element: the predicate is constant
        # true. This used to decline, which was right while only `count` was modeled and the
        # head keyword was unknown.
        def emit_count_quantifier(comprehension_var: sview, index_binder: sview, iterable: Expr, condition: Expr, guard: Expr, fold_head: sview, expected: ValueType, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            # Same iterable ladder the `for` header uses — a fold over an INLINE literal
            # (`sum x in [1, 2, 3]`) has no name to locate and no type of its own, and
            # locating it by name alone was the whole reason it declined.
            cq_source_type: ValueType = iterable_darray_type(iterable, local_scope, fns, structs, generics)
            null return if cq_source_type.kind != TypeKind.DArray
            cq_is_sum: bool = fold_head == "sum"
            cq_is_product: bool = fold_head == "product"
            null return if not cq_is_sum and not cq_is_product and fold_head != "count"
            if darray_read_slot(iterable, cq_source_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is cq_slot:
                cq_elem: ValueType = darray_element_of(cq_source_type, structs)
                null return if cq_elem.kind == TypeKind.Unmodeled
                # sum/product accumulate the element itself, so its type must BE the result
                # type — no implicit widening.
                if cq_is_sum or cq_is_product:
                    null return if cq_elem.kind != expected.kind or cq_elem.bits != expected.bits
                cq_i64: LLVMTypeRef = LLVMInt64TypeInContext(ctx)
                cq_result_llvm: LLVMTypeRef = llvm_type_of(expected, structs, ctx)
                cq_header: LLVMTypeRef = darray_llvm_type(structs, ctx)
                cq_count_slot: LLVMValueRef = LLVMBuildAlloca(builder, cq_result_llvm, "count.n")
                # An empty iterable folds to the seed: 0 for a sum/count, 1 for a product.
                cq_seed: u64 = 1 if cq_is_product else 0
                _ = LLVMBuildStore(builder, LLVMConstInt(cq_result_llvm, cq_seed, 0), cq_count_slot)
                cq_len_ptr: LLVMValueRef = LLVMBuildStructGEP2(builder, cq_header, cq_slot, 1, "count.len.ptr")
                cq_len: LLVMValueRef = LLVMBuildLoad2(builder, cq_i64, cq_len_ptr, "count.len")
                cq_index_slot: LLVMValueRef = LLVMBuildAlloca(builder, cq_i64, "count.i")
                _ = LLVMBuildStore(builder, LLVMConstInt(cq_i64, 0, 0), cq_index_slot)
                cq_var_slot: LLVMValueRef = LLVMBuildAlloca(builder, llvm_type_of(cq_elem, structs, ctx), "count.var")
                declare_local(local_scope, comprehension_var, cq_var_slot, cq_elem)
                cq_pos_slot: LLVMValueRef = LLVMBuildAlloca(builder, cq_i64, "count.pos")
                if index_binder != "":
                    declare_local(local_scope, index_binder, cq_pos_slot, ValueType{kind: TypeKind.Signed, bits: 64})
                cq_function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                cq_cond_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, cq_function, "count.cond")
                cq_body_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, cq_function, "count.body")
                cq_hit_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, cq_function, "count.hit")
                cq_step_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, cq_function, "count.step")
                cq_done_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, cq_function, "count.done")
                _ = LLVMBuildBr(builder, cq_cond_block)
                LLVMPositionBuilderAtEnd(builder, cq_cond_block)
                cq_cur: LLVMValueRef = LLVMBuildLoad2(builder, cq_i64, cq_index_slot, "count.cur")
                cq_more: LLVMValueRef = LLVMBuildICmp(builder, 40, cq_cur, cq_len, "count.more")
                _ = LLVMBuildCondBr(builder, cq_more, cq_body_block, cq_done_block)
                LLVMPositionBuilderAtEnd(builder, cq_body_block)
                cq_items_ptr: LLVMValueRef = LLVMBuildStructGEP2(builder, cq_header, cq_slot, 0, "count.items.ptr")
                cq_items: LLVMValueRef = LLVMBuildLoad2(builder, LLVMPointerTypeInContext(ctx, 0), cq_items_ptr, "count.items")
                cq_elem_llvm: LLVMTypeRef = llvm_type_of(cq_elem, structs, ctx)
                cq_gep_indices: mutable darray[LLVMValueRef] = [cq_cur]
                cq_gep_pointer: void& = (&cq_gep_indices[0]).cast[void&] can Unsafe.PointerCast
                cq_elem_ptr: LLVMValueRef = LLVMBuildGEP2(builder, cq_elem_llvm, cq_items, cq_gep_pointer, 1, "count.elem.ptr")
                cq_elem_value: LLVMValueRef = LLVMBuildLoad2(builder, cq_elem_llvm, cq_elem_ptr, "count.elem")
                _ = LLVMBuildStore(builder, cq_elem_value, cq_var_slot)
                if index_binder != "":
                    _ = LLVMBuildStore(builder, cq_cur, cq_pos_slot)
                # No `where` means every element folds, so the predicate is a constant true
                # rather than an emitted condition.
                cq_predicate: mutable LLVMValueRef = LLVMConstInt(LLVMInt1TypeInContext(ctx), 1, 0)
                cq_predicate_ok: mutable bool = true
                match condition:
                    Expr.Absent:
                        pass
                    _:
                        if emit_filter_predicate(comprehension_var, condition, guard, local_scope, fns, structs, generics, runtime, m, ctx, builder) is cq_emitted_predicate:
                            cq_predicate <- cq_emitted_predicate
                        else:
                            cq_predicate_ok <- false
                null return if not cq_predicate_ok
                _ = LLVMBuildCondBr(builder, cq_predicate, cq_hit_block, cq_step_block)
                LLVMPositionBuilderAtEnd(builder, cq_hit_block)
                cq_seen: LLVMValueRef = LLVMBuildLoad2(builder, cq_result_llvm, cq_count_slot, "count.seen")
                cq_stepped: mutable LLVMValueRef = LLVMBuildAdd(builder, cq_seen, LLVMConstInt(cq_result_llvm, 1, 0), "count.inc")
                if cq_is_sum:
                    cq_stepped <- LLVMBuildAdd(builder, cq_seen, cq_elem_value, "sum.acc")
                elif cq_is_product:
                    cq_stepped <- LLVMBuildMul(builder, cq_seen, cq_elem_value, "product.acc")
                _ = LLVMBuildStore(builder, cq_stepped, cq_count_slot)
                _ = LLVMBuildBr(builder, cq_step_block)
                LLVMPositionBuilderAtEnd(builder, cq_step_block)
                _ = LLVMBuildStore(builder, LLVMBuildAdd(builder, cq_cur, LLVMConstInt(cq_i64, 1, 0), "count.next"), cq_index_slot)
                _ = LLVMBuildBr(builder, cq_cond_block)
                LLVMPositionBuilderAtEnd(builder, cq_done_block)
                return LLVMBuildLoad2(builder, cq_result_llvm, cq_count_slot, "count.value")
            return null


        # `min|max VAR in XS [where COND]` over a DARRAY — a fold whose result is OPTIONAL,
        # because an iterable with no qualifying element has no minimum. Seeded ABSENT, so
        # that case falls out of the seed exactly the way `all`'s vacuous truth does; a
        # seeded 0 would be a wrong ANSWER indistinguishable from a real 0 in the data.
        #
        # No short-circuit and no extra blocks: inside the hit block the running optional is
        # either absent (take the element) or present (take it only if it compares better),
        # which is two selects.
        # `first VAR in ITER [where COND]` -- the first element satisfying the predicate, as
        # an Optional (absent when nothing matches). Same skeleton as the min/max fold, but it
        # STOPS at the first hit instead of folding over every element, so the answer for a
        # duplicate-satisfying iterable is positional rather than extremal.
        def emit_first_quantifier(comprehension_var: sview, index_binder: sview, iterable: Expr, condition: Expr, projection: Expr, expected: ValueType, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            fq_source_type: ValueType = iterable_darray_type(iterable, local_scope, fns, structs, generics)
            null return if fq_source_type.kind != TypeKind.DArray
            fq_payload: ValueType = optional_payload_of(expected, structs)
            null return if not is_integer_type(fq_payload)
            # The tagged `{i1, T}` form only, as with min/max: a niche optional has no room
            # for a separate absent state over an integer payload.
            null return if optional_is_niche(expected, structs)
            if darray_read_slot(iterable, fq_source_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is fq_slot:
                fq_elem: ValueType = darray_element_of(fq_source_type, structs)
                null return if fq_elem.kind == TypeKind.Unmodeled
                # `entry.name for first entry in entries where …` — the PROJECTION form. The
                # element and the result no longer have to be the same type: the binder is
                # bound to the element and the projection is evaluated at the payload type.
                # Only the IDENTITY form still requires them to agree, since there the element
                # IS the result.
                fq_projecting: bool = match projection:
                    Expr.Absent: false
                    _: true
                null return if not fq_projecting and (fq_elem.kind != fq_payload.kind or fq_elem.bits != fq_payload.bits)
                fq_i64: LLVMTypeRef = LLVMInt64TypeInContext(ctx)
                fq_bool: LLVMTypeRef = LLVMInt1TypeInContext(ctx)
                fq_optional_llvm: LLVMTypeRef = llvm_type_of(expected, structs, ctx)
                fq_header: LLVMTypeRef = darray_llvm_type(structs, ctx)
                fq_result_slot: LLVMValueRef = LLVMBuildAlloca(builder, fq_optional_llvm, "first.opt")
                # ABSENT: tag false, payload zero -- also the answer when nothing matches.
                _ = LLVMBuildStore(builder, LLVMConstNull(fq_optional_llvm), fq_result_slot)
                fq_len_ptr: LLVMValueRef = LLVMBuildStructGEP2(builder, fq_header, fq_slot, 1, "first.len.ptr")
                fq_len: LLVMValueRef = LLVMBuildLoad2(builder, fq_i64, fq_len_ptr, "first.len")
                fq_index_slot: LLVMValueRef = LLVMBuildAlloca(builder, fq_i64, "first.i")
                _ = LLVMBuildStore(builder, LLVMConstInt(fq_i64, 0, 0), fq_index_slot)
                fq_var_slot: LLVMValueRef = LLVMBuildAlloca(builder, llvm_type_of(fq_elem, structs, ctx), "first.var")
                declare_local(local_scope, comprehension_var, fq_var_slot, fq_elem)
                fq_pos_slot: LLVMValueRef = LLVMBuildAlloca(builder, fq_i64, "first.pos")
                if index_binder != "":
                    declare_local(local_scope, index_binder, fq_pos_slot, ValueType{kind: TypeKind.Signed, bits: 64})
                fq_function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                fq_cond_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, fq_function, "first.cond")
                fq_body_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, fq_function, "first.body")
                fq_hit_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, fq_function, "first.hit")
                fq_step_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, fq_function, "first.step")
                fq_done_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, fq_function, "first.done")
                _ = LLVMBuildBr(builder, fq_cond_block)
                LLVMPositionBuilderAtEnd(builder, fq_cond_block)
                fq_cur: LLVMValueRef = LLVMBuildLoad2(builder, fq_i64, fq_index_slot, "first.cur")
                fq_more: LLVMValueRef = LLVMBuildICmp(builder, 40, fq_cur, fq_len, "first.more")
                _ = LLVMBuildCondBr(builder, fq_more, fq_body_block, fq_done_block)
                LLVMPositionBuilderAtEnd(builder, fq_body_block)
                fq_items_ptr: LLVMValueRef = LLVMBuildStructGEP2(builder, fq_header, fq_slot, 0, "first.items.ptr")
                fq_items: LLVMValueRef = LLVMBuildLoad2(builder, LLVMPointerTypeInContext(ctx, 0), fq_items_ptr, "first.items")
                fq_elem_llvm: LLVMTypeRef = llvm_type_of(fq_elem, structs, ctx)
                fq_gep_indices: mutable darray[LLVMValueRef] = [fq_cur]
                fq_gep_pointer: void& = (&fq_gep_indices[0]).cast[void&] can Unsafe.PointerCast
                fq_elem_ptr: LLVMValueRef = LLVMBuildGEP2(builder, fq_elem_llvm, fq_items, fq_gep_pointer, 1, "first.elem.ptr")
                fq_elem_value: LLVMValueRef = LLVMBuildLoad2(builder, fq_elem_llvm, fq_elem_ptr, "first.elem")
                _ = LLVMBuildStore(builder, fq_elem_value, fq_var_slot)
                if index_binder != "":
                    _ = LLVMBuildStore(builder, fq_cur, fq_pos_slot)
                fq_predicate: mutable LLVMValueRef = LLVMConstInt(fq_bool, 1, 0)
                fq_predicate_ok: mutable bool = true
                match condition:
                    Expr.Absent:
                        pass
                    _:
                        if emit_condition(condition, local_scope, fns, structs, generics, runtime, m, ctx, builder) is fq_emitted_predicate:
                            fq_predicate <- fq_emitted_predicate
                        else:
                            fq_predicate_ok <- false
                null return if not fq_predicate_ok
                _ = LLVMBuildCondBr(builder, fq_predicate, fq_hit_block, fq_step_block)
                LLVMPositionBuilderAtEnd(builder, fq_hit_block)
                fq_payload_value: mutable LLVMValueRef = fq_elem_value
                if fq_projecting:
                    if emit_expression(projection, fq_payload, local_scope, fns, structs, generics, runtime, m, ctx, builder) is fq_projected:
                        fq_payload_value <- fq_projected
                    else:
                        return null
                fq_found: mutable LLVMValueRef = LLVMGetUndef(fq_optional_llvm)
                fq_found <- LLVMBuildInsertValue(builder, fq_found, LLVMConstInt(fq_bool, 1, 0), 0, "first.tag")
                fq_found <- LLVMBuildInsertValue(builder, fq_found, fq_payload_value, 1, "first.payload")
                _ = LLVMBuildStore(builder, fq_found, fq_result_slot)
                # STOP -- that is the whole difference from the min/max fold.
                _ = LLVMBuildBr(builder, fq_done_block)
                LLVMPositionBuilderAtEnd(builder, fq_step_block)
                _ = LLVMBuildStore(builder, LLVMBuildAdd(builder, fq_cur, LLVMConstInt(fq_i64, 1, 0), "first.next.i"), fq_index_slot)
                _ = LLVMBuildBr(builder, fq_cond_block)
                LLVMPositionBuilderAtEnd(builder, fq_done_block)
                return LLVMBuildLoad2(builder, fq_optional_llvm, fq_result_slot, "first.value")
            return null


        def emit_minmax_quantifier(comprehension_var: sview, index_binder: sview, iterable: Expr, condition: Expr, want_max: bool, expected: ValueType, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            mq_source_type: ValueType = iterable_darray_type(iterable, local_scope, fns, structs, generics)
            null return if mq_source_type.kind != TypeKind.DArray
            mq_payload: ValueType = optional_payload_of(expected, structs)
            null return if not is_integer_type(mq_payload)
            # The tagged `{i1, T}` form only: a niche optional has no room for a separate
            # absent state over an integer payload.
            null return if optional_is_niche(expected, structs)
            if darray_read_slot(iterable, mq_source_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is mq_slot:
                mq_elem: ValueType = darray_element_of(mq_source_type, structs)
                null return if mq_elem.kind != mq_payload.kind or mq_elem.bits != mq_payload.bits
                mq_i64: LLVMTypeRef = LLVMInt64TypeInContext(ctx)
                mq_bool: LLVMTypeRef = LLVMInt1TypeInContext(ctx)
                mq_optional_llvm: LLVMTypeRef = llvm_type_of(expected, structs, ctx)
                mq_payload_llvm: LLVMTypeRef = llvm_type_of(mq_payload, structs, ctx)
                mq_header: LLVMTypeRef = darray_llvm_type(structs, ctx)
                mq_result_slot: LLVMValueRef = LLVMBuildAlloca(builder, mq_optional_llvm, "minmax.opt")
                # ABSENT: tag false, payload zero. Also the answer for an empty iterable.
                _ = LLVMBuildStore(builder, LLVMConstNull(mq_optional_llvm), mq_result_slot)
                mq_len_ptr: LLVMValueRef = LLVMBuildStructGEP2(builder, mq_header, mq_slot, 1, "minmax.len.ptr")
                mq_len: LLVMValueRef = LLVMBuildLoad2(builder, mq_i64, mq_len_ptr, "minmax.len")
                mq_index_slot: LLVMValueRef = LLVMBuildAlloca(builder, mq_i64, "minmax.i")
                _ = LLVMBuildStore(builder, LLVMConstInt(mq_i64, 0, 0), mq_index_slot)
                mq_var_slot: LLVMValueRef = LLVMBuildAlloca(builder, llvm_type_of(mq_elem, structs, ctx), "minmax.var")
                declare_local(local_scope, comprehension_var, mq_var_slot, mq_elem)
                mq_pos_slot: LLVMValueRef = LLVMBuildAlloca(builder, mq_i64, "minmax.pos")
                if index_binder != "":
                    declare_local(local_scope, index_binder, mq_pos_slot, ValueType{kind: TypeKind.Signed, bits: 64})
                mq_function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                mq_cond_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, mq_function, "minmax.cond")
                mq_body_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, mq_function, "minmax.body")
                mq_hit_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, mq_function, "minmax.hit")
                mq_step_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, mq_function, "minmax.step")
                mq_done_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, mq_function, "minmax.done")
                _ = LLVMBuildBr(builder, mq_cond_block)
                LLVMPositionBuilderAtEnd(builder, mq_cond_block)
                mq_cur: LLVMValueRef = LLVMBuildLoad2(builder, mq_i64, mq_index_slot, "minmax.cur")
                mq_more: LLVMValueRef = LLVMBuildICmp(builder, 40, mq_cur, mq_len, "minmax.more")
                _ = LLVMBuildCondBr(builder, mq_more, mq_body_block, mq_done_block)
                LLVMPositionBuilderAtEnd(builder, mq_body_block)
                mq_items_ptr: LLVMValueRef = LLVMBuildStructGEP2(builder, mq_header, mq_slot, 0, "minmax.items.ptr")
                mq_items: LLVMValueRef = LLVMBuildLoad2(builder, LLVMPointerTypeInContext(ctx, 0), mq_items_ptr, "minmax.items")
                mq_elem_llvm: LLVMTypeRef = llvm_type_of(mq_elem, structs, ctx)
                mq_gep_indices: mutable darray[LLVMValueRef] = [mq_cur]
                mq_gep_pointer: void& = (&mq_gep_indices[0]).cast[void&] can Unsafe.PointerCast
                mq_elem_ptr: LLVMValueRef = LLVMBuildGEP2(builder, mq_elem_llvm, mq_items, mq_gep_pointer, 1, "minmax.elem.ptr")
                mq_elem_value: LLVMValueRef = LLVMBuildLoad2(builder, mq_elem_llvm, mq_elem_ptr, "minmax.elem")
                _ = LLVMBuildStore(builder, mq_elem_value, mq_var_slot)
                if index_binder != "":
                    _ = LLVMBuildStore(builder, mq_cur, mq_pos_slot)
                mq_predicate: mutable LLVMValueRef = LLVMConstInt(mq_bool, 1, 0)
                mq_predicate_ok: mutable bool = true
                match condition:
                    Expr.Absent:
                        pass
                    _:
                        if emit_condition(condition, local_scope, fns, structs, generics, runtime, m, ctx, builder) is mq_emitted_predicate:
                            mq_predicate <- mq_emitted_predicate
                        else:
                            mq_predicate_ok <- false
                null return if not mq_predicate_ok
                _ = LLVMBuildCondBr(builder, mq_predicate, mq_hit_block, mq_step_block)
                LLVMPositionBuilderAtEnd(builder, mq_hit_block)
                mq_current: LLVMValueRef = LLVMBuildLoad2(builder, mq_optional_llvm, mq_result_slot, "minmax.cur.opt")
                mq_have: LLVMValueRef = LLVMBuildExtractValue(builder, mq_current, 0, "minmax.have")
                mq_best: LLVMValueRef = LLVMBuildExtractValue(builder, mq_current, 1, "minmax.best")
                # Signedness follows the ELEMENT type: an unsigned fold must not order its
                # values as two's-complement signed.
                mq_signed: bool = mq_elem.kind == TypeKind.Signed
                mq_op: mutable u32 = 36
                mq_op <- 40 if mq_signed and not want_max
                mq_op <- 34 if want_max and not mq_signed
                mq_op <- 38 if want_max and mq_signed
                mq_better: LLVMValueRef = LLVMBuildICmp(builder, mq_op, mq_elem_value, mq_best, "minmax.better")
                # With nothing seen yet the element wins outright; otherwise it must beat the
                # incumbent.
                mq_take: LLVMValueRef = LLVMBuildSelect(builder, mq_have, mq_better, LLVMConstInt(mq_bool, 1, 0), "minmax.take")
                mq_next_payload: LLVMValueRef = LLVMBuildSelect(builder, mq_take, mq_elem_value, mq_best, "minmax.next")
                mq_updated: mutable LLVMValueRef = LLVMGetUndef(mq_optional_llvm)
                mq_updated <- LLVMBuildInsertValue(builder, mq_updated, LLVMConstInt(mq_bool, 1, 0), 0, "minmax.tag")
                mq_updated <- LLVMBuildInsertValue(builder, mq_updated, mq_next_payload, 1, "minmax.payload")
                _ = LLVMBuildStore(builder, mq_updated, mq_result_slot)
                _ = LLVMBuildBr(builder, mq_step_block)
                LLVMPositionBuilderAtEnd(builder, mq_step_block)
                _ = LLVMBuildStore(builder, LLVMBuildAdd(builder, mq_cur, LLVMConstInt(mq_i64, 1, 0), "minmax.next.i"), mq_index_slot)
                _ = LLVMBuildBr(builder, mq_cond_block)
                LLVMPositionBuilderAtEnd(builder, mq_done_block)
                _ = mq_payload_llvm
                return LLVMBuildLoad2(builder, mq_optional_llvm, mq_result_slot, "minmax.value")
            return null


        # The generic template slot whose first parameter is the requested parallel source
        # view. `par_map_collect` is overloaded for Slice[T] and ReadView[T], so a name-only
        # lookup would always choose the writable Slice overload and reject an immutable
        # darray reference. Slot selection here mirrors the ordinary UFCS overload path.
        def parallel_map_collect_slot(view_name: sview, generics: GenericTable&) -> i64 can[Abort.Panic]:
            for slot in 0..<generics.names.count:
                continue if generics.names[slot] != "par_map_collect"
                match generics.decls[slot]:
                    Decl.Func(_, parallel_params, _, _, _, _, _):
                        continue if parallel_params.count == 0
                        match parallel_params[0].type_expression:
                            Expr.IndexN(parallel_head, _, _):
                                if parallel_head is Expr.Ident(parallel_type_name, _):
                                    return slot.i64() if parallel_type_name == view_name
                            Expr.Index(parallel_head_legacy, _, _):
                                if parallel_head_legacy is Expr.Ident(parallel_legacy_name, _):
                                    return slot.i64() if parallel_legacy_name == view_name
                            Expr.Ident(parallel_bare_name, _):
                                return slot.i64() if parallel_bare_name == view_name
                            _:
                                pass
                    _:
                        pass
            return -1


        # `[value for item in source by par]` lowers to the existing structured-parallel
        # collector. An owned darray is borrowed as a writable Slice because the collector
        # only writes its newly allocated output; an already-borrowed darray is passed through
        # ReadView so an immutable reference never gains write permission. The UFCS emitter
        # is used with an explicit template slot because the two overloads share one source name.
        def emit_parallel_comprehension(comprehension_var: sview, iterable: Expr, body: Expr, comprehension_line: u32, expected: ValueType, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            null return if expected.kind != TypeKind.DArray
            source_type: ValueType = iterable_darray_type(iterable, local_scope, fns, structs, generics)
            null return if source_type.kind != TypeKind.DArray
            source_element: ValueType = darray_element_of(source_type, structs)
            output_element: ValueType = darray_element_of(expected, structs)
            null return if source_element.kind == TypeKind.Unmodeled or output_element.kind == TypeKind.Unmodeled
            source_view_name: mutable sview = "Slice"
            source_view: mutable Expr = (Expr.Call(Expr.Ident("slice", Ast::pos_at_line(comprehension_line)), [Expr.Unary(TokenKind.Ampersand, iterable, Ast::pos_at_line(comprehension_line))], [""], Ast::pos_at_line(comprehension_line)))
            raw_source_type: ValueType = expression_type(iterable, local_scope, fns, structs, generics)
            if raw_source_type.kind == TypeKind.Ref:
                source_view_name <- "ReadView"
                source_view <- (Expr.Call(Expr.Ident("read_view", Ast::pos_at_line(comprehension_line)), [iterable], [""], Ast::pos_at_line(comprehension_line)))
            slot: i64 = parallel_map_collect_slot(source_view_name, generics)
            null return if slot < 0
            lambda_body: darray[Stmt] = [Stmt.Return(body, Ast::pos_at_line(comprehension_line))]
            transform: Expr = Expr.Lambda([comprehension_var], lambda_body, Ast::pos_at_line(comprehension_line))
            type_args: darray[ValueType] = [source_element, output_element]
            ufcs_arguments: mutable darray[Expr] = [transform]
            return emit_generic_ufcs_call(slot.usize(), type_args, source_view, ufcs_arguments, local_scope, fns, structs, generics, runtime, m, ctx, builder)


        def emit_comprehension(comprehension_var: sview, iterable: Expr, condition: Expr, body: Expr, comprehension_line: u32, expected: ValueType, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            # A PROJECTION query whose guard the AST cannot carry: emitting the filter without
            # it silently widens the result. Decline the whole query instead.
            null return if query_guard_dropped_at(comprehension_line, structs)
            # The execution-mode marker is kept in the file-level side table because the
            # compact Comprehension AST is shared by queries and collection builders.
            # Parallel maps are handled before the sequential/query dispatch so an explicit
            # `by par` never silently degrades to a serial loop.
            if parallel_comprehension_at(comprehension_line.i64(), structs):
                null return if condition is not Expr.Absent
                return emit_parallel_comprehension(comprehension_var, iterable, body, comprehension_line, expected, local_scope, fns, structs, generics, runtime, m, ctx, builder)
            # `any index, item in xs.enumerate() where …` — a MULTI-BINDER query. The
            # Comprehension node carries only the FIRST binder, which for the enumerate form
            # is the INDEX; the element binder is the line-keyed extra. Unwrap the
            # `.enumerate()` receiver here so every emitter below iterates the plain source and
            # simply also binds the loop counter.
            qi_index: mutable sview = ""
            qi_var: mutable sview = comprehension_var
            qi_iterable: mutable Expr = iterable
            match query_enumerate_receiver(iterable):
                Expr.Absent:
                    pass
                _:
                    qi_extra: sview = query_extra_binder_at(comprehension_line.i64(), structs)
                    if qi_extra != "":
                        qi_index <- comprehension_var
                        qi_var <- qi_extra
                        qi_iterable <- query_enumerate_receiver(iterable)
            # A container comprehension whose `expected` is a struct is either a DICT
            # comprehension (`{k: v for …}`, a DynDict — the pair rides in `body` as a Tuple) or a
            # SET comprehension (`{x for …}`, a DynSet — `body` is the element). Route by base;
            # both are dispatched before the darray path.
            if expected.kind == TypeKind.Struct:
                comp_struct_base: mutable sview = ""
                comp_struct_arg_start: mutable usize = 0
                comp_struct_arg_count: mutable usize = 0
                comp_struct_has: bool = generic_struct_instantiation_of(structs, expected, comp_struct_base, comp_struct_arg_start, comp_struct_arg_count)
                null return if not comp_struct_has
                if comp_struct_base == "DynSet":
                    return emit_set_comprehension(comprehension_var, iterable, condition, body, expected, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                return emit_dict_comprehension(comprehension_var, iterable, condition, body, expected, local_scope, fns, structs, generics, runtime, m, ctx, builder)
            # Quantifier `any|all VAR in ITER where COND` — Comprehension with empty body,
            # expected bool. Stage0 lowers to a loop that short-circuits.
            #
            # WHICH quantifier comes from the line-keyed `__query` marker, exactly as `count`
            # does below. It has to: Expr.Comprehension drops the head keyword, and treating
            # every bool empty-body form as `any` made `all x in [1, 0] where x > 0` return
            # TRUE — a wrong answer that compiled, linked and ran clean. An unrecognised head
            # DECLINES rather than guessing; a decline is loud at link time, a wrong
            # quantifier is silent forever.
            # A quantifier's `body` slot carries the GUARD of a `where PATTERN: GUARD` filter
            # (the parser has no separate slot for it), so a non-empty body no longer excludes
            # this branch -- it selects the guarded form.
            if expected.kind == TypeKind.Bool:
                quantifier_head: sview = query_head_for(comprehension_line, comprehension_var, structs)
                universal_quantifier: bool = quantifier_head == "all" or quantifier_head == "forall"
                existential_quantifier: bool = quantifier_head == "any" or quantifier_head == "exists"
                null return if not universal_quantifier and not existential_quantifier
                return emit_any_quantifier(qi_var, qi_index, qi_iterable, condition, body, universal_quantifier, local_scope, fns, structs, generics, runtime, m, ctx, builder)
            # `count|sum|product VAR in ITER [where COND]` — a FOLD to an integer, not a bool
            # quantifier and not a collection. The parser drops the query head from the node,
            # so which fold this is comes from the line-keyed marker recorded at parse time;
            # without that marker the folds are indistinguishable from one another and must
            # not be guessed. An unrecognised head still declines.
            # A `count … where PATTERN: GUARD` carries the GUARD in the body slot (there is no
            # separate one), so a non-empty body no longer excludes this branch when the
            # line-keyed guard marker says that is what the body is.
            integer_fold_guarded: bool = query_has_guard_at(comprehension_line, structs)
            if is_integer_type(expected) and (body is Expr.Absent or integer_fold_guarded):
                integer_fold_head: sview = query_head_for(comprehension_line, comprehension_var, structs)
                integer_fold_guard: mutable Expr = (Expr.Absent)
                integer_fold_guard <- body if integer_fold_guarded
                return emit_count_quantifier(qi_var, qi_index, qi_iterable, condition, integer_fold_guard, integer_fold_head, expected, local_scope, fns, structs, generics, runtime, m, ctx, builder)
            # `min|max VAR in ITER [where COND]` — the folds whose result is OPTIONAL, since
            # an empty iterable has no extremum. stage0 types these as `T?`, so they arrive
            # here with an Optional `expected` rather than a bare integer.
            if expected.kind == TypeKind.Optional:
                extremum_head: sview = query_head_for(comprehension_line, comprehension_var, structs)
                # `first` is the one Optional-producing query with a PROJECTION form
                # (`entry.name for first entry in …`), so it is dispatched whether or not the
                # node carries a body. min/max have no projection spelling and still require
                # an empty one.
                if extremum_head == "first":
                    return emit_first_quantifier(qi_var, qi_index, qi_iterable, condition, body, expected, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                match body:
                    Expr.Absent:
                        pass
                    _:
                        return null
                null return if extremum_head != "min" and extremum_head != "max"
                return emit_minmax_quantifier(qi_var, qi_index, qi_iterable, condition, extremum_head == "max", expected, local_scope, fns, structs, generics, runtime, m, ctx, builder)
            null return if expected.kind != TypeKind.DArray
            # `each VAR in ITER where COND` — the COLLECTION query. It carries no projection
            # body because the element IS the binder: `each item in xs where c` means exactly
            # `[item for item in xs if c]`, which this branch already lowers. Supply the
            # identity body rather than writing a second collection loop.
            #
            # The head marker is consulted but not required: this branch is already gated on a
            # DARRAY expected type, and every other body-less query (`any`/`all`/`forall`/
            # `exists`) is BOOL, so a body-less comprehension collecting into a darray can only
            # be `each`.
            # For a leading-keyword `each … where PATTERN: GUARD` the BODY slot holds the
            # GUARD, not a projection -- collecting it would push a bool as the element. Split
            # the two roles on the line-keyed marker: with a guard the element is the binder
            # (the identity form) and the guard joins the filter.
            collection_guard: mutable Expr = (Expr.Absent)
            collection_body: mutable Expr = body
            if query_has_guard_at(comprehension_line, structs):
                collection_guard <- body
                collection_body <- (Expr.Ident(qi_var, Ast::pos_at_line(comprehension_line)))
            else:
                match body:
                    Expr.Absent:
                        collection_head: sview = query_head_for(comprehension_line, comprehension_var, structs)
                        collection_body <- (Expr.Ident(qi_var, Ast::pos_at_line(comprehension_line))) if collection_head == "each" or collection_head == ""
                    _:
                        pass
            # A quantifier (`any`/`all`) has no body; only the collection form is modeled.
            match collection_body:
                Expr.Absent:
                    return null
                _:
                    pass
            match condition:
                Expr.BoolLit(filter_value):
                    if not filter_value:
                        return LLVMConstNull(darray_llvm_type(structs, ctx))
                _:
                    pass
            int64_type: LLVMTypeRef = LLVMInt64TypeInContext(ctx)
            element_type: ValueType = darray_element_of(expected, structs)
            null return if element_type.kind == TypeKind.Unmodeled

            # Only an integer RANGE iterable is modeled: its length is known before the loop,
            # which is what makes the presize possible at all.
            match iterable:
                Expr.Binary(range_low, range_operator, range_high, range_line):
                    null return if range_operator != TokenKind.RangeLt and range_operator != TokenKind.RangeLe
                    inclusive: bool = range_operator == TokenKind.RangeLe
                    index_type: ValueType = ValueType{kind: TypeKind.Signed, bits: 64}
                    if emit_expression(range_low, index_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is low_value:
                        if emit_expression(range_high, index_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is high_value:
                            span: LLVMValueRef = LLVMBuildSub(builder, high_value, low_value, "comp.span")
                            count: mutable LLVMValueRef = span
                            count <- LLVMBuildAdd(builder, span, LLVMConstInt(int64_type, 1, 0), "comp.count") if inclusive
                            # An empty or reversed range yields an empty darray, not a negative
                            # allocation.
                            positive: LLVMValueRef = LLVMBuildICmp(builder, 38, count, LLVMConstInt(int64_type, 0, 0), "comp.count.pos")
                            count <- LLVMBuildSelect(builder, positive, count, LLVMConstInt(int64_type, 0, 0), "comp.count.clamped")

                            header: LLVMTypeRef = darray_llvm_type(structs, ctx)
                            result_slot: LLVMValueRef = LLVMBuildAlloca(builder, header, "list.comp.result")
                            _ = LLVMBuildStore(builder, LLVMConstNull(header), result_slot)
                            stride: LLVMValueRef = element_stride(element_type, structs, ctx)
                            bytes: LLVMValueRef = LLVMBuildMul(builder, count, stride, "comp.bytes")
                            alloc_args: mutable darray[LLVMValueRef] = [runtime.arena, runtime_size_argument(bytes, ctx, builder)]
                            alloc_pointer: void& = (&alloc_args[0]).cast[void&] can Unsafe.PointerCast
                            items: LLVMValueRef = LLVMBuildCall2(builder, runtime.arena_alloc_type, runtime.arena_alloc, alloc_pointer, 2, "comp.alloc")
                            items_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, header, result_slot, 0, "comp.items.ptr")
                            count_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, header, result_slot, 1, "comp.count.ptr")
                            capacity_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, header, result_slot, 2, "comp.cap.ptr")
                            _ = LLVMBuildStore(builder, items, items_pointer)
                            # Capacity is the range bound; count is the number of values that
                            # actually pass a dynamic filter and starts at zero.
                            filtered: bool = match condition:
                                Expr.Absent: false
                                Expr.BoolLit: false
                                _: true
                            if filtered:
                                _ = LLVMBuildStore(builder, LLVMConstInt(int64_type, 0, 0), count_pointer)
                            else:
                                _ = LLVMBuildStore(builder, count, count_pointer)
                            output_index_slot: LLVMValueRef = LLVMBuildAlloca(builder, int64_type, "comp.out.i")
                            _ = LLVMBuildStore(builder, LLVMConstInt(int64_type, 0, 0), output_index_slot)

                            function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                            index_slot: LLVMValueRef = LLVMBuildAlloca(builder, int64_type, "comp.i")
                            _ = LLVMBuildStore(builder, LLVMConstInt(int64_type, 0, 0), index_slot)
                            var_slot: LLVMValueRef = LLVMBuildAlloca(builder, llvm_type_of(index_type, structs, ctx), "comp.var")
                            declare_local(local_scope, comprehension_var, var_slot, index_type)

                            condition_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "comp.cond")
                            body_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "comp.input")
                            write_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "comp.write")
                            skip_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "comp.skip")
                            latch_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "comp.latch")
                            done_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "comp.done")
                            _ = LLVMBuildBr(builder, condition_block)
                            LLVMPositionBuilderAtEnd(builder, condition_block)
                            current: LLVMValueRef = LLVMBuildLoad2(builder, int64_type, index_slot, "comp.i.cur")
                            more: LLVMValueRef = LLVMBuildICmp(builder, 40, current, count, "comp.more")
                            _ = LLVMBuildCondBr(builder, more, body_block, done_block)

                            LLVMPositionBuilderAtEnd(builder, body_block)
                            _ = LLVMBuildStore(builder, LLVMBuildAdd(builder, low_value, current, "comp.var.value"), var_slot)
                            if filtered:
                                if emit_filter_predicate(comprehension_var, condition, collection_guard, local_scope, fns, structs, generics, runtime, m, ctx, builder) is predicate:
                                    _ = LLVMBuildCondBr(builder, predicate, write_block, skip_block)
                                else:
                                    LLVMPositionBuilderAtEnd(builder, done_block)
                                    return null
                                LLVMPositionBuilderAtEnd(builder, write_block)
                            if emit_expression(collection_body, element_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is element_value:
                                loaded_items: LLVMValueRef = LLVMBuildLoad2(builder, LLVMPointerTypeInContext(ctx, 0), items_pointer, "comp.items")
                                # A darray indexes with a ONE-index GEP: `items` is already a T*.
                                output_index: LLVMValueRef = LLVMBuildLoad2(builder, int64_type, output_index_slot, "comp.out.i.cur") if filtered else current
                                comp_indices: mutable darray[LLVMValueRef] = [output_index]
                                comp_indices_pointer: void& = (&comp_indices[0]).cast[void&] can Unsafe.PointerCast
                                slot_pointer: LLVMValueRef = LLVMBuildGEP2(builder, llvm_type_of(element_type, structs, ctx), loaded_items, comp_indices_pointer, 1, "comp.slot")
                                _ = LLVMBuildStore(builder, element_value, slot_pointer)
                                if filtered:
                                    _ = LLVMBuildStore(builder, LLVMBuildAdd(builder, output_index, LLVMConstInt(int64_type, 1, 0), "comp.out.i.next"), output_index_slot)
                                    _ = LLVMBuildStore(builder, LLVMBuildAdd(builder, output_index, LLVMConstInt(int64_type, 1, 0), "comp.count.next"), count_pointer)
                                _ = LLVMBuildStore(builder, LLVMBuildAdd(builder, current, LLVMConstInt(int64_type, 1, 0), "comp.i.next"), index_slot)
                                # The LATCH is what carries the marker: this branch is the loop's
                                # back-edge, and `!llvm.loop` belongs on it.
                                _ = LLVMBuildBr(builder, latch_block)
                                LLVMPositionBuilderAtEnd(builder, skip_block)
                                _ = LLVMBuildStore(builder, LLVMBuildAdd(builder, current, LLVMConstInt(int64_type, 1, 0), "comp.i.skip"), index_slot)
                                _ = LLVMBuildBr(builder, latch_block)
                                LLVMPositionBuilderAtEnd(builder, latch_block)
                                latch: LLVMValueRef = LLVMBuildBr(builder, condition_block)
                                tag_autovec_loop(latch, "comprehension", ctx)
                                if not filtered:
                                    LLVMPositionBuilderAtEnd(builder, write_block)
                                    _ = LLVMBuildUnreachable(builder)
                                    LLVMPositionBuilderAtEnd(builder, skip_block)
                                    _ = LLVMBuildUnreachable(builder)
                                LLVMPositionBuilderAtEnd(builder, done_block)
                                return LLVMBuildLoad2(builder, header, result_slot, "list.comp.value")
                            LLVMPositionBuilderAtEnd(builder, done_block)
                            return null
                _:
                    pass
            # `[BODY for VAR in XS (if COND)?]` over an existing DARRAY source (the most common
            # comprehension form; the range path above needs a compile-time count and cannot take
            # one). The source count is dynamic, so this builds the output by PUSH — behaviourally
            # identical, exit-code-verified; it forgoes the range path's presize/vectorize, which
            # a dynamic-length source could not use anyway.
            lc_source_type: ValueType = iterable_darray_type(qi_iterable, local_scope, fns, structs, generics)
            if lc_source_type.kind == TypeKind.DArray:
                if darray_read_slot(qi_iterable, lc_source_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is lc_source_slot:
                    lc_source_elem: ValueType = darray_element_of(lc_source_type, structs)
                    null return if lc_source_elem.kind == TypeKind.Unmodeled
                    lc_i64: LLVMTypeRef = LLVMInt64TypeInContext(ctx)
                    lc_header: LLVMTypeRef = darray_llvm_type(structs, ctx)
                    lc_out_slot: LLVMValueRef = LLVMBuildAlloca(builder, lc_header, "list.comp.d.out")
                    _ = LLVMBuildStore(builder, LLVMConstNull(lc_header), lc_out_slot)
                    lc_count_ptr: LLVMValueRef = LLVMBuildStructGEP2(builder, lc_header, lc_source_slot, 1, "list.comp.d.cnt.ptr")
                    lc_count: LLVMValueRef = LLVMBuildLoad2(builder, lc_i64, lc_count_ptr, "list.comp.d.cnt")
                    lc_index_slot: LLVMValueRef = LLVMBuildAlloca(builder, lc_i64, "list.comp.d.i")
                    _ = LLVMBuildStore(builder, LLVMConstInt(lc_i64, 0, 0), lc_index_slot)
                    lc_var_slot: LLVMValueRef = LLVMBuildAlloca(builder, llvm_type_of(lc_source_elem, structs, ctx), "list.comp.d.var")
                    declare_local(local_scope, qi_var, lc_var_slot, lc_source_elem)
                    # `each index, item in xs.enumerate()` — the index binder rides the counter.
                    lc_pos_slot: LLVMValueRef = LLVMBuildAlloca(builder, lc_i64, "list.comp.d.pos")
                    if qi_index != "":
                        declare_local(local_scope, qi_index, lc_pos_slot, ValueType{kind: TypeKind.Signed, bits: 64})
                    lc_filtered: bool = match condition:
                        Expr.Absent: false
                        Expr.BoolLit: false
                        _: true
                    # A constant-false filter yields the empty darray.
                    match condition:
                        Expr.BoolLit(lc_filter_value):
                            if not lc_filter_value:
                                return LLVMBuildLoad2(builder, lc_header, lc_out_slot, "list.comp.d.empty")
                        _:
                            pass
                    lc_function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                    lc_cond: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, lc_function, "list.comp.d.cond")
                    lc_bodyb: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, lc_function, "list.comp.d.body")
                    lc_push_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, lc_function, "list.comp.d.push")
                    lc_step: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, lc_function, "list.comp.d.step")
                    lc_done: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, lc_function, "list.comp.d.done")
                    _ = LLVMBuildBr(builder, lc_cond)
                    LLVMPositionBuilderAtEnd(builder, lc_cond)
                    lc_cur: LLVMValueRef = LLVMBuildLoad2(builder, lc_i64, lc_index_slot, "list.comp.d.cur")
                    lc_more: LLVMValueRef = LLVMBuildICmp(builder, 40, lc_cur, lc_count, "list.comp.d.more")
                    _ = LLVMBuildCondBr(builder, lc_more, lc_bodyb, lc_done)
                    LLVMPositionBuilderAtEnd(builder, lc_bodyb)
                    # Bind VAR = source[cur]: load the source's items pointer (header field 0) and
                    # GEP by the current counter at the element stride — the same shape the darray
                    # for-loop uses to walk its backing.
                    if true:
                        lc_items_ptr: LLVMValueRef = LLVMBuildStructGEP2(builder, lc_header, lc_source_slot, 0, "list.comp.d.items.ptr")
                        lc_items: LLVMValueRef = LLVMBuildLoad2(builder, LLVMPointerTypeInContext(ctx, 0), lc_items_ptr, "list.comp.d.items")
                        lc_elem_llvm: LLVMTypeRef = llvm_type_of(lc_source_elem, structs, ctx)
                        lc_gep_indices: mutable darray[LLVMValueRef] = [lc_cur]
                        lc_gep_pointer: void& = (&lc_gep_indices[0]).cast[void&] can Unsafe.PointerCast
                        lc_elem_ptr: LLVMValueRef = LLVMBuildGEP2(builder, lc_elem_llvm, lc_items, lc_gep_pointer, 1, "list.comp.d.elem.ptr")
                        lc_elem_value: LLVMValueRef = LLVMBuildLoad2(builder, lc_elem_llvm, lc_elem_ptr, "list.comp.d.elem")
                        _ = LLVMBuildStore(builder, lc_elem_value, lc_var_slot)
                        if qi_index != "":
                            _ = LLVMBuildStore(builder, lc_cur, lc_pos_slot)
                        lc_body_ok: mutable bool = true
                        if lc_filtered:
                            if emit_filter_predicate(qi_var, condition, collection_guard, local_scope, fns, structs, generics, runtime, m, ctx, builder) is lc_pred:
                                _ = LLVMBuildCondBr(builder, lc_pred, lc_push_block, lc_step)
                            else:
                                lc_body_ok <- false
                        else:
                            _ = LLVMBuildBr(builder, lc_push_block)
                        null return if not lc_body_ok
                        LLVMPositionBuilderAtEnd(builder, lc_push_block)
                        if emit_darray_push(lc_out_slot, expected, collection_body, local_scope, fns, structs, generics, runtime, m, ctx, builder):
                            _ = LLVMBuildBr(builder, lc_step)
                            LLVMPositionBuilderAtEnd(builder, lc_step)
                            _ = LLVMBuildStore(builder, LLVMBuildAdd(builder, lc_cur, LLVMConstInt(lc_i64, 1, 0), "list.comp.d.next"), lc_index_slot)
                            _ = LLVMBuildBr(builder, lc_cond)
                            LLVMPositionBuilderAtEnd(builder, lc_done)
                            return LLVMBuildLoad2(builder, lc_header, lc_out_slot, "list.comp.d.value")
                        return null
                    return null
            # `[c for c in s]` over an SVIEW — the byte-collect shape the semantic layer's
            # sview_equal uses. sview is `{ptr, i64 len}`, so the element is a u8 read by
            # index < len; the CFG is the darray path's with the header loads replaced by
            # ExtractValue. A PUSH loop rather than presize-and-fill: the filtered form has
            # no known count, and unlike the range comprehension this shape is a byte walk,
            # not a vectorization target. cstr is NOT accepted here — its length needs a
            # strlen call, so it stays a decline rather than a wrong (zero-length) answer.
            lc_sview_type: ValueType = expression_type(iterable, local_scope, fns, structs, generics)
            if lc_sview_type.kind == TypeKind.SView:
                if emit_expression(iterable, lc_sview_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is lc_s_value:
                    lc_s_u8: ValueType = ValueType{kind: TypeKind.Unsigned, bits: 8}
                    null return if element_type.kind != TypeKind.Unsigned or element_type.bits != 8
                    lc_s_i64: LLVMTypeRef = LLVMInt64TypeInContext(ctx)
                    lc_s_u8_llvm: LLVMTypeRef = LLVMInt8TypeInContext(ctx)
                    lc_s_header: LLVMTypeRef = darray_llvm_type(structs, ctx)
                    lc_s_out_slot: LLVMValueRef = LLVMBuildAlloca(builder, lc_s_header, "list.comp.s.out")
                    _ = LLVMBuildStore(builder, LLVMConstNull(lc_s_header), lc_s_out_slot)
                    lc_s_ptr: LLVMValueRef = LLVMBuildExtractValue(builder, lc_s_value, 0, "list.comp.s.ptr")
                    lc_s_len: LLVMValueRef = LLVMBuildExtractValue(builder, lc_s_value, 1, "list.comp.s.len")
                    lc_s_index_slot: LLVMValueRef = LLVMBuildAlloca(builder, lc_s_i64, "list.comp.s.i")
                    _ = LLVMBuildStore(builder, LLVMConstInt(lc_s_i64, 0, 0), lc_s_index_slot)
                    lc_s_var_slot: LLVMValueRef = LLVMBuildAlloca(builder, lc_s_u8_llvm, "list.comp.s.var")
                    declare_local(local_scope, comprehension_var, lc_s_var_slot, lc_s_u8)
                    lc_s_filtered: bool = match condition:
                        Expr.Absent: false
                        Expr.BoolLit: false
                        _: true
                    match condition:
                        Expr.BoolLit(lc_s_filter_value):
                            if not lc_s_filter_value:
                                return LLVMBuildLoad2(builder, lc_s_header, lc_s_out_slot, "list.comp.s.empty")
                        _:
                            pass
                    lc_s_function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                    lc_s_cond: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, lc_s_function, "list.comp.s.cond")
                    lc_s_bodyb: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, lc_s_function, "list.comp.s.body")
                    lc_s_push_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, lc_s_function, "list.comp.s.push")
                    lc_s_step: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, lc_s_function, "list.comp.s.step")
                    lc_s_done: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, lc_s_function, "list.comp.s.done")
                    _ = LLVMBuildBr(builder, lc_s_cond)
                    LLVMPositionBuilderAtEnd(builder, lc_s_cond)
                    lc_s_cur: LLVMValueRef = LLVMBuildLoad2(builder, lc_s_i64, lc_s_index_slot, "list.comp.s.cur")
                    lc_s_more: LLVMValueRef = LLVMBuildICmp(builder, 40, lc_s_cur, lc_s_len, "list.comp.s.more")
                    _ = LLVMBuildCondBr(builder, lc_s_more, lc_s_bodyb, lc_s_done)
                    LLVMPositionBuilderAtEnd(builder, lc_s_bodyb)
                    lc_s_gep_indices: mutable darray[LLVMValueRef] = [lc_s_cur]
                    lc_s_gep_pointer: void& = (&lc_s_gep_indices[0]).cast[void&] can Unsafe.PointerCast
                    lc_s_byte_ptr: LLVMValueRef = LLVMBuildGEP2(builder, lc_s_u8_llvm, lc_s_ptr, lc_s_gep_pointer, 1, "list.comp.s.byte.ptr")
                    lc_s_byte: LLVMValueRef = LLVMBuildLoad2(builder, lc_s_u8_llvm, lc_s_byte_ptr, "list.comp.s.byte")
                    _ = LLVMBuildStore(builder, lc_s_byte, lc_s_var_slot)
                    lc_s_body_ok: mutable bool = true
                    if lc_s_filtered:
                        if emit_filter_predicate(comprehension_var, condition, collection_guard, local_scope, fns, structs, generics, runtime, m, ctx, builder) is lc_s_pred:
                            _ = LLVMBuildCondBr(builder, lc_s_pred, lc_s_push_block, lc_s_step)
                        else:
                            lc_s_body_ok <- false
                    else:
                        _ = LLVMBuildBr(builder, lc_s_push_block)
                    null return if not lc_s_body_ok
                    LLVMPositionBuilderAtEnd(builder, lc_s_push_block)
                    if emit_darray_push(lc_s_out_slot, expected, collection_body, local_scope, fns, structs, generics, runtime, m, ctx, builder):
                        _ = LLVMBuildBr(builder, lc_s_step)
                        LLVMPositionBuilderAtEnd(builder, lc_s_step)
                        _ = LLVMBuildStore(builder, LLVMBuildAdd(builder, lc_s_cur, LLVMConstInt(lc_s_i64, 1, 0), "list.comp.s.next"), lc_s_index_slot)
                        _ = LLVMBuildBr(builder, lc_s_cond)
                        LLVMPositionBuilderAtEnd(builder, lc_s_done)
                        return LLVMBuildLoad2(builder, lc_s_header, lc_s_out_slot, "list.comp.s.value")
                    return null
            return null
