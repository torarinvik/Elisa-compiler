# Stage1 backend — `emit_expression`: the match-expression form plus value-`if`, dict/set/array/tuple literals and slicing.
# A group of the expression emitter's branches, called from codegen_expression.elisa.
# `handled` is set TRUE on entry and cleared only if no branch here matched, so a
# branch that DECLINES (returns null) still stops the dispatch — exactly as it did
# when every branch shared one function body.

extend Backend:
    private:
        def emit_expression_match_aggregates(expression: Expr, expected: ValueType, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef, handled: mutable bool&) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            # This group owns only match/value-if/dict expressions. The array, set and
            # tuple emitters live in codegen_expr_index_fields.elisa. The old split left
            # this dispatcher claiming every expression before that group ran; an empty
            # darray literal (`x: dstr = []`) therefore declined here and never reached
            # the already-implemented darray literal lowering.
            match_aggregate_expression: mutable bool = false
            if expression is Expr.Match(_, _, _):
                match_aggregate_expression <- true
            if expression is Expr.If(_, _, _, _):
                match_aggregate_expression <- true
            if expression is Expr.DictLit(_, _):
                match_aggregate_expression <- true
            if not match_aggregate_expression:
                handled <- false
                return null
            handled <- true
            # A value `match` over an integer scrutinee: `match n: 0: 100 … _: 300`.
            #
            # Lowered as an ordered COMPARE CHAIN, not a switch: arms must be tried in
            # source order, and turning a dense chain into a switch is llc's job.
            match expression:
                Expr.Match(match_scrutinee, match_arms, match_line):
                    scrutinee_type: ValueType = resolve_type(match_scrutinee, ValueType{kind: TypeKind.Signed, bits: 64}, local_scope, fns, structs, generics)
                    # An integer scrutinee compares directly; a PAYLOAD ENUM compares on its TAG.
                    penum_scrutinee: bool = scrutinee_type.kind == TypeKind.PayloadEnum
                    # A PACKED scrutinee is an i32 store INDEX: its tag and payload are read back
                    # through the runtime rather than out of the value.
                    packed_scrutinee: bool = scrutinee_type.kind == TypeKind.PackedEnum
                    # A CSTR scrutinee's arms are string-literal patterns compared with ctx_streq.
                    cstr_scrutinee: bool = scrutinee_type.kind == TypeKind.CStr
                    # An SVIEW scrutinee's arms compare each literal via ctx_string_views_eq.
                    sview_scrutinee: bool = scrutinee_type.kind == TypeKind.SView
                    null return if packed_scrutinee and runtime.active_store_enum != packed_root_index_of(structs, scrutinee_type.bits.i64())
                    null return if not is_integer_type(scrutinee_type) and not penum_scrutinee and not packed_scrutinee and not cstr_scrutinee and not sview_scrutinee
                    match_type: LLVMTypeRef = llvm_type_of(expected, structs, ctx)
                    null return if expected.kind == TypeKind.Unmodeled
                    if emit_expression(match_scrutinee, scrutinee_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is scrutinee_raw:
                        function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                        # `%match.tag.value = extractvalue %Shape %sh, 0` — stage0's shape. The
                        # tag is an i32 regardless of the payload, so the compare constant below
                        # is built at i32, not at the scrutinee's own type.
                        scrutinee: mutable LLVMValueRef = scrutinee_raw
                        compare_type: mutable LLVMTypeRef = llvm_type_of(scrutinee_type, structs, ctx)
                        penum_slot: mutable LLVMValueRef = scrutinee_raw
                        if packed_scrutinee:
                            # `%packed.tag.store = call i32 @ctx_packed_store_read_variant_sparse_tag(ptr %state, i32 %n)`
                            packed_match_state: LLVMValueRef = LLVMBuildExtractValue(builder, runtime.active_store, 2, "packed.state")
                            packed_tag_index: LLVMValueRef = LLVMBuildZExt(builder, scrutinee_raw, LLVMInt64TypeInContext(ctx), "packed.tag.index") if runtime.packed_mode == 2 else scrutinee_raw
                            packed_tag_args: mutable darray[LLVMValueRef] = [packed_match_state, packed_tag_index]
                            packed_tag_pointer: void& = (&packed_tag_args[0]).cast[void&] can Unsafe.PointerCast
                            scrutinee <- LLVMBuildCall2(builder, runtime.packed_read_tag_type, runtime.packed_read_tag, packed_tag_pointer, 2, "packed.tag.store")
                            if runtime.packed_mode == 2:
                                packed_row_type: LLVMTypeRef = packed_row_llvm_type(structs, scrutinee_type.bits.i64(), ctx)
                                packed_tag_pointer2: LLVMValueRef = LLVMBuildStructGEP2(builder, packed_row_type, scrutinee, 0, "packed.aos.tag.ptr")
                                scrutinee <- LLVMBuildLoad2(builder, LLVMInt32TypeInContext(ctx), packed_tag_pointer2, "packed.aos.tag")
                            compare_type <- LLVMInt32TypeInContext(ctx)
                        if penum_scrutinee:
                            scrutinee <- LLVMBuildExtractValue(builder, scrutinee_raw, 0, "match.tag.value")
                            compare_type <- LLVMInt32TypeInContext(ctx)
                            # The payload is read through memory (stage0 spills the value too),
                            # so the arm's binding loads from this slot.
                            penum_slot <- LLVMBuildAlloca(builder, llvm_type_of(scrutinee_type, structs, ctx), "match.payload.tmp")
                            _ = LLVMBuildStore(builder, scrutinee_raw, penum_slot)
                        result_slot: LLVMValueRef = LLVMBuildAlloca(builder, match_type, "match.result")
                        done_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "match.done")
                        declined: mutable bool = false
                        saw_default: mutable bool = false

                        # An OR-arm whose alternatives have DIFFERING packed field layouts
                        # cannot share one test: the binds below would read the FIRST
                        # alternative's offsets for every variant — a silent wrong value.
                        # Expand it into one single-variant arm per alternative, all sharing
                        # the body; arms are tested in order, so N sequential tests are
                        # equivalent to one OR'd test. Same-layout OR-arms are left alone.
                        # This mirrors the statement emitter's spm_arms pre-pass.
                        vpm_arms: mutable darray[MatchArm] = []
                        for vpm_src_arm in match_arms |vpm_arms, structs|:
                            vpm_expanded: mutable bool = false
                            match vpm_src_arm.pattern:
                                Pattern.Or(vpm_pre_opts):
                                    vpm_pre_ok: mutable bool = vpm_pre_opts.count > 0
                                    vpm_pre_differ: mutable bool = false
                                    vpm_pre_ref: mutable i64 = -1
                                    for vpm_pre_opt in vpm_pre_opts |vpm_pre_ok, vpm_pre_differ, vpm_pre_ref, structs|:
                                        match vpm_pre_opt:
                                            Pattern.Variant(vpm_pre_path, _):
                                                vpm_pre_slot: i64 = packed_slot_of_path(vpm_pre_path, structs)
                                                if vpm_pre_slot < 0:
                                                    vpm_pre_ok <- false
                                                elif vpm_pre_ref < 0:
                                                    vpm_pre_ref <- vpm_pre_slot
                                                else:
                                                    vpm_pre_differ <- true if not packed_slots_same_field_layout(vpm_pre_ref, vpm_pre_slot, structs)
                                            _:
                                                vpm_pre_ok <- false
                                    if vpm_pre_ok and vpm_pre_differ:
                                        vpm_arms.extend([MatchArm{pattern: vpm_pre_opt2, body: vpm_src_arm.body, guard: vpm_src_arm.guard} for vpm_pre_opt2 in vpm_pre_opts])
                                        vpm_expanded <- true
                                _:
                                    pass
                            vpm_arms.push(vpm_src_arm) if not vpm_expanded

                        for arm in vpm_arms |declined, saw_default, cstr_scrutinee, sview_scrutinee, scrutinee, scrutinee_type, penum_scrutinee, packed_scrutinee, scrutinee_raw, penum_slot, compare_type, expected, result_slot, done_block, function, local_scope, fns, structs, generics, runtime, m, ctx, builder|:
                            emit_value_match_arm(arm, &declined, &saw_default, cstr_scrutinee, sview_scrutinee, scrutinee, scrutinee_type, penum_scrutinee, packed_scrutinee, scrutinee_raw, penum_slot, compare_type, expected, result_slot, done_block, function, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                        null return if declined
                        # Fell off the chain with no `_`: unreachable (the frontend proves
                        # exhaustiveness; inventing a value would hide a real gap).
                        terminate_if_no_default(saw_default, builder)
                        LLVMPositionBuilderAtEnd(builder, done_block)
                        return LLVMBuildLoad2(builder, match_type, result_slot, "match")
                    return null

                _:
                    pass
            return emit_expression_if_and_dict(expression, expected, local_scope, fns, structs, generics, runtime, m, ctx, builder, handled)

include "./codegen_expr_value_if.elisa"

include "./codegen_expr_match_arm.elisa"
