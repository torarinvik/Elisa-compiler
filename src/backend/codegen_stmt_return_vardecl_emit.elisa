                            if generic_return_type(ret_gtry_base, ret_gtry_types, generics, structs).kind == TypeKind.Void:
                                if (emit_propagating_generic_try_value(ret_gtry_base, ret_gtry_types, ret_try_args, false, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}) is ret_gvoid_slot:
                                    _ = ret_gvoid_slot
                                    ret_gvoid_bare: Expr? = null
                                    return emit_statement((Stmt.Return(ret_gvoid_bare, return_line)), return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}
                                return EmitStatus.Declined
                        if ret_gtry_ok:
                            if (emit_propagating_generic_try_value(ret_gtry_base, ret_gtry_types, ret_try_args, true, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}) is ret_gtry_value:
                                return EmitStatus.Declined if not (emit_ensure_checks(ret_gtry_value, return_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write})
                                (emit_region_unwind(regions, runtime, builder) can Global{Read,Write})
                                return EmitStatus.Terminated if emit_sret_return(ret_gtry_value, return_type, runtime, structs, ctx, builder)
                                if runtime.in_error_fn:
                                    _ = LLVMBuildStore(builder, ret_gtry_value, runtime.error_out)
                                    _ = LLVMBuildRet(builder, error_success_return_value(structs, runtime, ctx))
                                    return EmitStatus.Terminated
                                _ = LLVMBuildRet(builder, ret_gtry_value)
                                return EmitStatus.Terminated
                    # `return match SCRUT:` — the match-EXPRESSION emitter handles only
                    # single-expression arms and has no statement context, so the semantic
                    # layer's `return match declaration:` shapes declined. Lower it with the
                    # statement-level match-into-slot emitter — the same one `x: T = match …`
                    # routes to — into a synthetic local, then return that local so the
                    # ensure / deferred / region-unwind / error-ABI tail below is shared
                    # verbatim rather than duplicated.
                    #
                    # The two emitters are NOT ordered by capability, so route on what the
                    # match-expression emitter cannot do rather than routing everything:
                    #   - a PACKED (AST-node) scrutinee — only the slot emitter binds payload
                    #     fields;
                    #   - any arm with a BLOCK body (statements then a yield) — the expression
                    #     emitter takes single-expression arms only, which is why
                    #     `return match inferred_type.kind:` with a `TypeKind.Named:` block arm
                    #     declined even though its scrutinee is a plain integer.
