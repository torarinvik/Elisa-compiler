                    # patterns (`return when c: '0'..='9' -> …`) the slot emitter does not —
                    # routing those here dropped `classify_number_char`.
                    return_operand: mutable Expr = return_value
                    if return_value is Expr.Match(rm_scrutinee, rm_arms, rm_match_line):
                        rm_scrutinee_type: ValueType = expression_type(rm_scrutinee, local_scope, fns, structs, generics)
                        rm_has_block_arm: mutable bool = false
                        for rm_arm in rm_arms |rm_has_block_arm|:
                            rm_has_block_arm <- true if not arm_yields_single_value(rm_arm.body)
                        # A multi-column `when` (`return when a, b:`) is a TUPLE scrutinee: the
                        # match-expression emitter has no scalar type to switch on, so the
                        # decision table is lowered in the slot emitter alongside the block-arm
                        # forms. This is the spelling the construct actually appears in.
                        # `return match OPT:` with a literal `null` arm. The value-position
                        # match emitters have no optional-scrutinee case, but the STATEMENT
                        # match now does, so rewrite each arm's value into a `return` and emit
                        # the whole thing as a statement match -- `return match o: null: 0 …`
                        # IS `match o: null: return 0 …`. Only arms that are single value
                        # expressions can be rewritten; anything else keeps the old routing.
                        rm_is_optional_null: mutable bool = false
                        if rm_scrutinee_type.kind == TypeKind.Optional:
                            for rm_null_probe in rm_arms |rm_is_optional_null|:
                                if rm_null_probe.pattern is Pattern.Literal(rm_null_text):
                                    rm_is_optional_null <- true if rm_null_text == "null"
                        # Simple null/binder/`_` arms now lower on the value emitter, which
                        # keeps a guarded binder and the original optional result intact.
                        if rm_is_optional_null and not rm_has_block_arm and not optional_value_match_supported(rm_arms):
                            rm_return_arms: mutable darray[MatchArm] @source = []
                            rm_rewrite_ok: mutable bool = true
                            for rm_arm_value in rm_arms |rm_return_arms, rm_rewrite_ok, return_line|:
                                if arm_value_expression(rm_arm_value.body) is rm_arm_expression:
                                    rm_return_body: darray[Stmt] @source = [(Stmt.Return((rm_arm_expression), return_line))]
                                    rm_return_arms.push(MatchArm{pattern: rm_arm_value.pattern, body: rm_return_body, guard: rm_arm_value.guard})
                                else:
                                    rm_rewrite_ok <- false
                            if rm_rewrite_ok:
                                rm_stmt_status: EmitStatus = emit_statement((Stmt.Match(rm_scrutinee, rm_return_arms, rm_match_line)), return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}
                                return EmitStatus.Declined if rm_stmt_status == EmitStatus.Declined
                                return EmitStatus.Terminated
                        rm_is_when_table: bool = rm_scrutinee is Expr.Tuple
                        if rm_scrutinee_type.kind == TypeKind.PackedEnum or rm_has_block_arm or rm_is_when_table:
                            rm_types: mutable darray[ValueType] = [copied_type(return_type)]
                            rm_names: mutable darray[sview @source] = ["__return_match"]
                            return EmitStatus.Declined if (emit_match_into_slot(rm_scrutinee, rm_arms, rm_types, rm_names, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}) != EmitStatus.Open
                            return_operand <- Expr.Ident("__return_match", return_line)
                    # `return get OPT else BODY` — the monadic unwrap in RETURN position.
                    # emit_expression has no GetElse case (the construct carries control flow),
                    # so this declined. Route it through the LOCAL-declaration emitter, which
                    # already lowers every GetElse shape, by declaring a synthetic local and
                    # returning that: the ensure / deferred / region-unwind / error-ABI tail
                    # below is then shared verbatim.
                    #
                    # The synthetic declaration's ANNOTATION is Invalid on purpose — the GetElse
                    # branch there types the binding from the guarded optional's payload and
                    # never consults the annotation.
                    if return_value is Expr.GetElse(rg_guarded, rg_recovery, rg_get_line):
                        _ = rg_guarded
                        _ = rg_recovery
                        rg_status: EmitStatus = emit_statement((Stmt.VarDecl("__return_get", Expr.Invalid, return_value, rg_get_line)), return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}
                        return EmitStatus.Declined if rg_status != EmitStatus.Open
                        return_operand <- Expr.Ident("__return_get", return_line)
                    # `return value` in an error-returning function can forward a first-class
                    # non-void `T error[E]` value. The ordinary return emitter asks for the
                    # function's success payload type (`T`), so passing that expected type to
                    # an ErrorUnion expression used to make the identifier path load the whole
                    # `{code, payload_ptr}` descriptor and store it through the `T` out-slot;
                    # stage1 then returned success without ever copying the payload. Stage0
                    # extracts the descriptor code and loads the payload before completing the
                    # split error-return ABI. Keep this path before the ordinary coercion so
                    # the descriptor is emitted with its own type.
                    if runtime.in_error_fn:
                        forwarded_type: ValueType = expression_type(return_operand, local_scope, fns, structs, generics)
                        if forwarded_type.kind == TypeKind.ErrorUnion:
                            forwarded_payload_type: ValueType = error_union_payload_of(forwarded_type, structs)
                            if forwarded_payload_type.kind == return_type.kind and forwarded_payload_type.bits == return_type.bits:
                                if (emit_expression(return_operand, forwarded_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}) is forwarded_union:
                                    forwarded_status: LLVMValueRef = LLVMBuildExtractValue(builder, forwarded_union, 0, "return.error.status")
                                    forwarded_payload_ptr: LLVMValueRef = LLVMBuildExtractValue(builder, forwarded_union, 1, "return.error.payload.ptr")
                                    forwarded_payload: LLVMValueRef = LLVMBuildLoad2(builder, llvm_type_of(return_type, structs, ctx), forwarded_payload_ptr, "return.error.payload")
                                    return EmitStatus.Declined if:
                                        not (emit_ensure_checks(forwarded_payload, return_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write})
                                        not (emit_deferred_actions(local_scope, false, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write})
                                    (emit_region_unwind(regions, runtime, builder) can Global{Read,Write})
                                    _ = LLVMBuildStore(builder, forwarded_payload, runtime.error_out)
                                    _ = LLVMBuildRet(builder, forwarded_status)
                                    return EmitStatus.Terminated
                    # A direct large-aggregate call can write straight into this function's
                    # hidden sret destination. Keeping the result in memory avoids a temporary
                    # aggregate load/store, and the tri-state helper prevents a partially
                    # emitted call from being evaluated again by the fallback path.
                    if structs.contracts.pending_ensures.count == 0 and value_type_uses_sret(return_type, structs, ctx):
                        return_destination: LLVMValueRef = LLVMGetParam(LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder)), 0)
                        if return_operand is Expr.Call(transition_callee, transition_arguments, transition_names, transition_call_pos):
                            if transition_callee is Expr.Index(Expr.Ident(transition_name, _), Expr.Ident(_, _), _) and transition_name == "transition" and transition_arguments.count == 1 and transition_names.count == 1 and transition_names[0] == "":
                                if transition_arguments[0] is Expr.Move(Expr.Ident(transition_source_name, transition_source_pos), _):
                                    transition_source_type: ValueType = expression_type(transition_arguments[0], local_scope, fns, structs, generics)
                                    transition_layout_ok: mutable bool = protocol_transition_payload_compatible(transition_source_type, return_type, structs)
                                    source_layout: LLVMTypeRef = llvm_type_of(transition_source_type, structs, ctx) if transition_layout_ok else LLVMVoidTypeInContext(ctx)
                                    target_layout: LLVMTypeRef = llvm_type_of(return_type, structs, ctx) if transition_layout_ok else LLVMVoidTypeInContext(ctx)
                                    transition_layout_ok <- false if transition_layout_ok and (LLVMABISizeOfType(structs.target.target_data, source_layout) != LLVMABISizeOfType(structs.target.target_data, target_layout) or LLVMABIAlignmentOfType(structs.target.target_data, source_layout) != LLVMABIAlignmentOfType(structs.target.target_data, target_layout))
                                    transition_source_place: Expr = Expr.Ident(transition_source_name, transition_source_pos)
                                    if transition_layout_ok and (indirect_aggregate_argument_address(transition_source_place, transition_source_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}) is transition_source_address:
                                        emit_sret_copy_from_address(transition_source_address, return_type, runtime, structs, ctx, builder)
                                        return EmitStatus.Declined if not (emit_deferred_actions(local_scope, false, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write})
                                        (emit_region_unwind(regions, runtime, builder) can Global{Read,Write})
                                        emit_sret_address_return_terminator(runtime, structs, ctx, builder)
                                        return EmitStatus.Terminated
                        if return_operand is Expr.Construct(_, _, _):
                            return_construct_status: i64 = emit_construct_into_sret(return_operand, return_type, return_destination, local_scope, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}
                            if return_construct_status == 1:
                                return EmitStatus.Declined if not (emit_deferred_actions(local_scope, false, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write})
                                (emit_region_unwind(regions, runtime, builder) can Global{Read,Write})
                                if runtime.in_error_fn:
                                    _ = LLVMBuildRet(builder, error_success_return_value(structs, runtime, ctx))
                                else:
                                    _ = LLVMBuildRetVoid(builder)
                                return EmitStatus.Terminated
                            return EmitStatus.Declined if return_construct_status < 0
                        if return_operand is Expr.Call(return_callee, return_arguments, return_argument_names, return_call_line):
                            match return_callee:
                                Expr.Ident(return_name, return_name_line):
                                    return_call_status: i64 = emit_direct_call_into_sret("", return_name, return_callee, false, return_arguments, return_argument_names, return_destination, local_scope, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}
                                    if return_call_status == 1:
                                        return EmitStatus.Declined if not (emit_deferred_actions(local_scope, false, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write})
                                        (emit_region_unwind(regions, runtime, builder) can Global{Read,Write})
                                        if runtime.in_error_fn:
                                            _ = LLVMBuildRet(builder, error_success_return_value(structs, runtime, ctx))
                                        else:
                                            _ = LLVMBuildRetVoid(builder)
                                        return EmitStatus.Terminated
                                    return EmitStatus.Declined if return_call_status < 0
                                Expr.Scope(return_scope_head, return_name, return_scope_line):
                                    if return_scope_head is Expr.Ident(return_module, return_module_line):
                                        return_call_status: i64 = emit_direct_call_into_sret(module_alias_target(return_module, structs), return_name, return_callee, false, return_arguments, return_argument_names, return_destination, local_scope, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}
                                        if return_call_status == 1:
                                            return EmitStatus.Declined if not (emit_deferred_actions(local_scope, false, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write})
                                            (emit_region_unwind(regions, runtime, builder) can Global{Read,Write})
                                            if runtime.in_error_fn:
                                                _ = LLVMBuildRet(builder, error_success_return_value(structs, runtime, ctx))
                                            else:
                                                _ = LLVMBuildRetVoid(builder)
                                            return EmitStatus.Terminated
                                        return EmitStatus.Declined if return_call_status < 0
                                _:
                                    pass
                    # A large aggregate returned from an addressable place can stay in memory all
                    # the way to the sret destination. Contracts need a value, so only take this
                    # fast path when no postcondition remains to inspect.
                    if structs.contracts.pending_ensures.count == 0 and value_type_uses_sret(return_type, structs, ctx) and (indirect_aggregate_argument_address(return_operand, return_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}) is return_address:
                        emit_sret_copy_from_address(return_address, return_type, runtime, structs, ctx, builder)
                        return EmitStatus.Declined if not (emit_deferred_actions(local_scope, false, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write})
                        (emit_region_unwind(regions, runtime, builder) can Global{Read,Write})
                        emit_sret_address_return_terminator(runtime, structs, ctx, builder)
                        return EmitStatus.Terminated
                    emitted: LLVMValueRef? = emit_expression_coerced(return_operand, return_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}
                    if emitted is return_constant:
                        # `return helper()` where `helper` is `-> void`, from a `-> void`
                        # function. The operand is a VOID-typed call: it must be EMITTED (for its
                        # side effect -- already done above) but can never be a `ret` operand.
                        # LLVMBuildRet with a void value produces `ret void <badref>`, malformed
                        # IR that slips past the type-identity check below (void == void, so the
                        # types "match") and then TRAPPED LLVM outright during object emission --
                        # stage1 died with SIGTRAP and no diagnostic where stage0 compiles it.
                        # Finish with `ret void`, sharing the bare-`return` tail's guards.
                        if return_type.kind == TypeKind.Void and not runtime.in_error_fn:
                            return EmitStatus.Declined if:
                                not (emit_void_ensure_checks(local_scope, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write})
                                not (emit_deferred_actions(local_scope, false, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write})
                            (emit_region_unwind(regions, runtime, builder) can Global{Read,Write})
                            if runtime.main_returns_status:
                                _ = LLVMBuildRet(builder, LLVMConstInt(LLVMInt32TypeInContext(ctx), 0, 0))
                            else:
                                _ = LLVMBuildRetVoid(builder)
                            return EmitStatus.Terminated
                        # The returned value's LLVM type must BE the function's return type.
                        # `ret ptr` from an `-> i64` function (returning a `fn` value, which
                        # stage0 rejects with "return type expects i64, got fn(i64) -> i64") is
                        # IR the verifier refuses; the object path tolerates it and produces
                        # nonsense. `ret void` from a value-returning function is the same
                        # defect, and crashed LLVM outright.
                        #
                        # Types are uniqued per context, so this compares by identity. Skipped
                        # for an unmodeled return type, where there is nothing to compare
                        # against.
                        return EmitStatus.Declined if:
                            return_type.kind != TypeKind.Unmodeled and not runtime.in_error_fn and LLVMTypeOf(return_constant) != llvm_type_of(return_type, structs, ctx)
                            # Postconditions run BEFORE the unwind: a predicate may read a
                            # container the auto region still backs.
                            not (emit_ensure_checks(return_constant, return_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write})
                            # Unwind EVERY live owned region on the way out — the function's auto
                            # region AND any enclosing `region NAME:` scopes. This lives on the
                            # return path rather than at one function exit because a return can
                            # happen from inside any depth of scope.
                            not (emit_deferred_actions(local_scope, false, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write})
                        (emit_region_unwind(regions, runtime, builder) can Global{Read,Write})
                        # An error fn writes the SUCCESS value through its out-param and
                        # returns the i32 success code 0, rather than returning the value.
                        return EmitStatus.Terminated if emit_sret_return(return_constant, return_type, runtime, structs, ctx, builder)
                        if runtime.in_error_fn:
                            _ = LLVMBuildStore(builder, return_constant, runtime.error_out)
                            _ = LLVMBuildRet(builder, error_success_return_value(structs, runtime, ctx))
                            return EmitStatus.Terminated
                        _ = LLVMBuildRet(builder, return_constant)
                        return EmitStatus.Terminated
                    return EmitStatus.Declined
                # A bare `return` — only valid in a `-> void` function. A `void error[E]` fn
                # still uses the i32-status ABI, so success returns the 0 code, not `ret void`.
                if return_type.kind == TypeKind.Void:
                    return EmitStatus.Declined if:
                        not (emit_void_ensure_checks(local_scope, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write})
                        not (emit_deferred_actions(local_scope, false, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write})
                    (emit_region_unwind(regions, runtime, builder) can Global{Read,Write})
                    if runtime.in_error_fn:
                        _ = LLVMBuildRet(builder, error_success_return_value(structs, runtime, ctx))
                    elif runtime.main_returns_status:
                        _ = LLVMBuildRet(builder, LLVMConstInt(LLVMInt32TypeInContext(ctx), 0, 0))
                    else:
                        _ = LLVMBuildRetVoid(builder)
                    return EmitStatus.Terminated
                return EmitStatus.Declined
            return emit_statement_vardecl(statement, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder, handled) can Global{Read,Write}

