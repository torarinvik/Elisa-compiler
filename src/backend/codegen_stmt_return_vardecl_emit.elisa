extend Backend:
    private:
        def emit_statement_return_vardecl[@scope_region, @loops_region, @regions_region, @fns_region, @structs_region, @generics_region](statement: Stmt, return_type: ValueType, local_scope: mutable Scope& @scope_region, loops: mutable LoopStack& @loops_region, regions: mutable RegionStack& @regions_region, fns: FnTable& @fns_region, structs: mutable StructTable& @structs_region, generics: mutable GenericTable& @generics_region, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef, handled: mutable bool&) -> EmitStatus can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            handled <- true
            if statement is Stmt.Return(return_value_opt, return_line):
                if return_value_opt is return_value:
                    nested_return_value: mutable Expr = return_value
                    nested_return_status: i64 = materialize_nested_try_argument(return_value, nested_return_value, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}
                    return EmitStatus.Declined if nested_return_status < 0
                    return emit_statement((Stmt.Return(nested_return_value, return_line)), return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write} if nested_return_status == 1
                    # Task completion records and TaskGroups retain pool state, and lexical
                    # pool cleanup shuts down its ThreadPool before this function returns.
                    # None of those handles may cross that cleanup boundary, including when
                    # nested in an aggregate. VarDecl submits have their own tracked path;
                    # this return check catches every other typed handle escape.
                    if local_scope.pool_names.count > 0 or local_scope.group_names.count > 0:
                        return EmitStatus.Declined if backend_expression_may_contain_pool_lifetime_handle(return_value, return_type, local_scope, fns, structs, generics)
                    # `await task` may arrive here as a value-transparent block after the
                    # semantic expression walkers. Lower it directly in return position as a
                    # fallback to the ordinary expression emitter, preserving the task value
                    # and avoiding a synchronous call-through.
                    await_return_marker: mutable bool = false
                    if return_value is Expr.Block(_, _, _, await_return_pos):
                        await_return_marker <- fn_return_head_at_offset(await_return_pos.offset, await_return_pos.line, structs) == "__await"
                    if await_return_marker:
                        if local_scope.pool_names.count > 0 or local_scope.group_names.count > 0:
                            return EmitStatus.Declined if backend_type_is_raw_pool_handle_representation(return_type, structs)
                        await_operand: mutable Expr = return_value
                        if return_value is Expr.Block(await_block_statements, await_block_value, await_block_captures, await_block_line):
                            await_operand <- await_block_value
                        await_task_type: ValueType = expression_type(await_operand, local_scope, fns, structs, generics)
                        await_base: mutable sview = ""
                        await_arg_start: mutable usize = 0
                        await_arg_count: mutable usize = 0
                        await_is_direct_task: mutable bool = generic_struct_instantiation_of(structs, await_task_type, await_base, await_arg_start, await_arg_count) and await_base == "Task"
                        if await_is_direct_task:
                            if await_task_type.bits.usize() >= structs.records.names.count or await_task_type.bits.usize() >= structs.records.owners.count:
                                await_is_direct_task <- false
                            else:
                                await_is_direct_task <- structs.records.names[await_task_type.bits.usize()] == "Task" and structs.records.owners[await_task_type.bits.usize()] == ""
                        if not await_is_direct_task and await_task_type.kind == TypeKind.Struct and await_task_type.bits.usize() < structs.records.names.count and await_task_type.bits.usize() < structs.records.owners.count:
                            await_is_direct_task <- structs.records.names[await_task_type.bits.usize()] == "Task" and structs.records.owners[await_task_type.bits.usize()] == ""
                        # The synthesized built-in Task handle records only a marker
                        # argument, not its result type. A declared generic Task[R, S]
                        # records both arguments; use R only in that complete case so a
                        # phantom built-in handle reaches the exact non-generic fallback.
                        if await_is_direct_task and await_arg_count == 2:
                            return EmitStatus.Declined if await_arg_start >= structs.generics.generic_struct_inst_args.count or await_arg_count > structs.generics.generic_struct_inst_args.count - await_arg_start
                            await_result_type: ValueType = copied_type(structs.generics.generic_struct_inst_args[await_arg_start])
                            await_types: mutable darray[ValueType] = [await_result_type]
                            await_arguments: mutable darray[Expr] = [await_operand]
                            if (emit_generic_call("pool_await", await_types, await_arguments, [], local_scope, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}) is awaited_return_value:
                                return EmitStatus.Declined if:
                                    not (emit_ensure_checks(awaited_return_value, return_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write})
                                    not (emit_deferred_actions(local_scope, false, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write})
                                (emit_region_unwind(regions, runtime, builder) can Global{Read,Write})
                                return EmitStatus.Terminated if emit_sret_return(awaited_return_value, return_type, runtime, structs, ctx, builder)
                                if runtime.in_error_fn:
                                    _ = LLVMBuildStore(builder, awaited_return_value, runtime.error_out)
                                    _ = LLVMBuildRet(builder, error_success_return_value(structs, runtime, ctx))
                                    return EmitStatus.Terminated
                                _ = LLVMBuildRet(builder, awaited_return_value)
                                return EmitStatus.Terminated
                            return EmitStatus.Declined
                        return EmitStatus.Declined if await_is_direct_task and await_arg_count > 2
                        # A NON-generic `pool_await` — the shape stage0's own corpus declares
                        # (`extern pool_await(task: Task[i64, Pending]) -> i64`). The generic
                        # path above reads the RESULT type out of the Task instantiation's
                        # recorded arguments, which a BUILT-IN Task handle does not carry: both
                        # of its type arguments are phantom. Fall back to the ordinary call.
                        if await_is_direct_task:
                            await_direct_args: mutable darray[Expr] = [await_operand]
                            # Resolve a unique one-argument API row by the concrete Task type,
                            # then call that row directly. Routing this compiler-generated
                            # await through emit_call would reject the Task argument as an
                            # arbitrary helper escape; routing by name alone could instead
                            # select an unrelated overload.
                            await_api_hits: i64 = overload_match_count(fns, "", "pool_await", await_direct_args, local_scope, structs, generics)
                            await_api_index: i64 = overload_index_for_args(fns, "", "pool_await", await_direct_args, local_scope, structs, generics)
                            if await_api_hits == 1 and await_api_index >= 0 and await_api_index.usize() < fns.param_start.count and await_api_index.usize() < fns.param_count.count:
                                await_api_row: usize = await_api_index.usize()
                                if fns.param_count[await_api_row] == 1 and fns.param_start[await_api_row] < fns.param_types.count:
                                    await_api_task_type: ValueType = copied_type(fns.param_types[fns.param_start[await_api_row]])
                                    if value_type_identity_equal(await_api_task_type, await_task_type):
                                        await_no_argument_names: darray[sview @source] = []
                                        if (emit_direct_call_indexed(await_api_index, Expr.Invalid, false, await_direct_args, await_no_argument_names, local_scope, fns, structs, generics, runtime, m, ctx, builder, null) can Global{Read,Write}) is await_direct_value:
                                            return EmitStatus.Declined if:
                                                not (emit_ensure_checks(await_direct_value, return_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write})
                                                # The DEFERRED actions run on this exit too — an enclosing
                                                # `pool workers(N):` registers its `pool_shutdown` there, and
                                                # skipping it leaked the pool on the awaited-return path
                                                # (measured: shutdown=0 against stage0's 1).
                                                not (emit_deferred_actions(local_scope, false, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write})
                                            (emit_region_unwind(regions, runtime, builder) can Global{Read,Write})
                                            return EmitStatus.Terminated if emit_sret_return(await_direct_value, return_type, runtime, structs, ctx, builder)
                                            if runtime.in_error_fn:
                                                _ = LLVMBuildStore(builder, await_direct_value, runtime.error_out)
                                                _ = LLVMBuildRet(builder, error_success_return_value(structs, runtime, ctx))
                                                return EmitStatus.Terminated
                                            _ = LLVMBuildRet(builder, await_direct_value)
                                            return EmitStatus.Terminated
                        return EmitStatus.Declined
                    # `return sb.extend([0.u8()])` — `extend` in VALUE position. It mutates the
                    # target IN PLACE and yields it, so the value is simply the target's address
                    # once the append has run. Rather than duplicate the ~70-line append loop,
                    # run the STATEMENT form (which handles darray/sview/string-literal sources
                    # and growth) on the same call node, then hand back the address.
                    # Only a REF-to-darray return type takes this path: that is the shape the
                    # std's builder helpers declare (`-> mutable darray[u8, shape_out]&`), and a
                    # by-value darray return would need a copy rather than an alias.
                    if return_type.kind == TypeKind.Ref:
                        ext_ret_target: ValueType = ref_target_of(return_type, structs)
                        if ext_ret_target.kind == TypeKind.DArray:
                            if return_value is Expr.Call(ext_ret_callee, ext_ret_args, ext_ret_names, ext_ret_line):
                                match ext_ret_callee:
                                    Expr.Field(ext_ret_object, ext_ret_method, ext_ret_method_line):
                                        if ext_ret_method == "extend" and ext_ret_args.count == 1:
                                            ext_ret_status: EmitStatus = emit_statement((Stmt.Expr(return_value, ext_ret_line)), return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}
                                            return EmitStatus.Declined if ext_ret_status != EmitStatus.Open
                                            if (darray_address_of_expr(ext_ret_object, local_scope, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}) is ext_ret_address:
                                                return EmitStatus.Declined if not (emit_ensure_checks(ext_ret_address, return_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write})
                                                (emit_region_unwind(regions, runtime, builder) can Global{Read,Write})
                                                if runtime.in_error_fn:
                                                    _ = LLVMBuildStore(builder, ext_ret_address, runtime.error_out)
                                                    _ = LLVMBuildRet(builder, error_success_return_value(structs, runtime, ctx))
                                                    return EmitStatus.Terminated
                                                _ = LLVMBuildRet(builder, ext_ret_address)
                                                return EmitStatus.Terminated
                                            return EmitStatus.Declined
                                    _:
                                        pass
                    # `return (try f(x)) and COND` — a propagating try as an OPERAND. The
                    # value form below only ever matched a try that WAS the whole returned
                    # expression, so the same call one level in declined. Bind it to a
                    # synthetic local first (which propagates on the error path exactly as the
                    # whole-expression form does) and re-emit the return with the operand
                    # replaced by that name. Only the LEFT operand: the right one is evaluated
                    # conditionally under `and`/`or`, and hoisting a propagating call out of a
                    # short-circuit would run it when the source says it must not.
                    if return_value is Expr.Binary(ret_op_left, ret_op_kind, ret_op_right, ret_op_line):
                        match ret_op_left:
                            Expr.Call(ret_op_callee, ret_op_args, ret_op_names, ret_op_call_line):
                                match ret_op_callee:
                                    Expr.Ident(ret_op_name, ret_op_name_line):
                                        if error_callee_is(fns, structs, generics, ret_op_name):
                                            ret_op_value_type: ValueType = error_callee_value_type(ret_op_name, ret_op_args, local_scope, fns, structs, generics)
                                            return EmitStatus.Declined if ret_op_value_type.kind == TypeKind.Unmodeled
                                            if (emit_propagating_try_value(ret_op_name, ret_op_args, null, ret_op_value_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}) is ret_op_bound:
                                                ret_op_storage: mutable darray[u8] = []
                                                ret_op_slot: LLVMValueRef = build_entry_alloca(builder, llvm_type_of(ret_op_value_type, structs, ctx), sview_to_cstr("__try_operand", ret_op_storage))
                                                _ = LLVMBuildStore(builder, ret_op_bound, ret_op_slot)
                                                declare_local(local_scope, "__try_operand", ret_op_slot, ret_op_value_type)
                                                ret_op_rewritten: Stmt = (Stmt.Return((Expr.Binary((Expr.Ident("__try_operand", ret_op_line)), ret_op_kind, ret_op_right, ret_op_line)), return_line))
                                                return emit_statement(ret_op_rewritten, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}
                                            return EmitStatus.Declined
                                    _:
                                        pass
                            _:
                                pass
                        # `return value + (try f(x))` — the same propagating try as the RIGHT
                        # operand, which is where both of stage0's own corpus cases put it
                        # (`value + (try recursive_pair_node_sum(next))`). The left-operand form
                        # above declined this.
                        #
                        # Two guards make the hoist safe, because it evaluates the call BEFORE
                        # the left operand:
                        #   - NOT `and`/`or`: their right operand is evaluated conditionally, and
                        #     hoisting a propagating call out of a short-circuit would run it
                        #     where the source says it must not — the same rule the left-operand
                        #     form states for its own case.
                        #   - the left operand must be an IDENT or an INT LITERAL, i.e.
                        #     side-effect-free, so running it after the call is unobservable.
                        #     Anything else keeps declining rather than silently reordering.
                        ret_rop_short_circuit: bool = ret_op_kind == TokenKind.And or ret_op_kind == TokenKind.Or
                        ret_rop_pure_left: bool = (ret_op_left is Expr.Ident(ret_rop_left_name, ret_rop_left_line)) or (ret_op_left is Expr.IntLit(ret_rop_left_value, _))
                        # `return L and (try f(x))` / `return L or (try f(x))`. Hoisting is wrong
                        # here — the call must not run when L already decides the answer — so
                        # rewrite into the branch that PRESERVES the short circuit and let the
                        # whole-expression try form below lower each arm:
                        #     `L and T`  ->  if L: return T          else return false
                        #     `L or  T`  ->  if L: return true       else return T
                        # `L` keeps its original position, so its side effects and their order
                        # are unchanged, and `T` is emitted only on the branch that reaches it.
                        if ret_rop_short_circuit and (ret_op_right is Expr.Call(ret_sc_callee, ret_sc_args, ret_sc_names, ret_sc_call_line)):
                            match ret_sc_callee:
                                Expr.Ident(ret_sc_name, ret_sc_name_line):
                                    if error_callee_is(fns, structs, generics, ret_sc_name):
                                        ret_sc_short_value: bool = ret_op_kind == TokenKind.Or
                                        ret_sc_then: darray[Stmt] @source = [(Stmt.Return((Expr.BoolLit(true, Ast::pos_at_line(0))), return_line))] if ret_sc_short_value else [(Stmt.Return(ret_op_right, return_line))]
                                        ret_sc_else: darray[Stmt] @source = [(Stmt.Return(ret_op_right, return_line))] if ret_sc_short_value else [(Stmt.Return((Expr.BoolLit(false, Ast::pos_at_line(0))), return_line))]
                                        return emit_statement((Stmt.If(ret_op_left, ret_sc_then, ret_sc_else, ret_op_line)), return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}
                                _:
                                    pass
                        if ret_op_right is Expr.Call(ret_rop_callee, ret_rop_args, ret_rop_names, ret_rop_call_line) and not ret_rop_short_circuit and ret_rop_pure_left:
                            match ret_rop_callee:
                                Expr.Ident(ret_rop_name, ret_rop_name_line):
                                    if error_callee_is(fns, structs, generics, ret_rop_name):
                                        ret_rop_value_type: ValueType = error_callee_value_type(ret_rop_name, ret_rop_args, local_scope, fns, structs, generics)
                                        return EmitStatus.Declined if ret_rop_value_type.kind == TypeKind.Unmodeled
                                        if (emit_propagating_try_value(ret_rop_name, ret_rop_args, null, ret_rop_value_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}) is ret_rop_bound:
                                            ret_rop_storage: mutable darray[u8] = []
                                            ret_rop_slot: LLVMValueRef = build_entry_alloca(builder, llvm_type_of(ret_rop_value_type, structs, ctx), sview_to_cstr("__try_operand", ret_rop_storage))
                                            _ = LLVMBuildStore(builder, ret_rop_bound, ret_rop_slot)
                                            declare_local(local_scope, "__try_operand", ret_rop_slot, ret_rop_value_type)
                                            ret_rop_rewritten: Stmt = (Stmt.Return((Expr.Binary(ret_op_left, ret_op_kind, (Expr.Ident("__try_operand", ret_op_line)), ret_op_line)), return_line))
                                            return emit_statement(ret_rop_rewritten, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}
                                        return EmitStatus.Declined
                                _:
                                    pass
                    # `return try f(x)` — the value form of a propagating try in return position.
                    if return_value is Expr.Call(ret_try_callee, ret_try_args, ret_try_arg_names, ret_try_call_line):
                        match try_callee_as_ident_with_generics(ret_try_callee, fns, structs, generics):
                            Expr.Ident(ret_try_name, ret_try_name_line):
                                if error_callee_is(fns, structs, generics, ret_try_name, try_callee_owner_with_generics(ret_try_callee, fns, structs, generics)):
                                    ret_try_no_recovery: darray[Stmt] = []
                                    # `return try g(x)` where BOTH `g` and this function are
                                    # `void error[E]` -- the idiomatic way to forward a failure
                                    # from a void-payload callee. There is no success VALUE, so
                                    # the value form below bails (`emit_propagating_try_value`
                                    # returns null on a Void payload) and the whole function
                                    # declined. `try g(x)` in STATEMENT position already lowers
                                    # this correctly, including the i64 dummy out-slot a
                                    # void-success callee needs; run that, then hand the
                                    # continuation to the bare-`return` tail, which writes this
                                    # function's own success status. Routing through
                                    # `emit_statement` rather than copying that tail keeps the
                                    # ensure/deferred/unwind guards in one place.
                                    #
                                    # A no-`else` `try` parses to the bare call, so this covers
