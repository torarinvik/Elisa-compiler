                                    # shape, and the same lowering stage0 gives it.
                                    if return_type.kind == TypeKind.Void and runtime.in_error_fn:
                                        ret_vtry_payload: ValueType = error_callee_value_type(ret_try_name, ret_try_args, local_scope, fns, structs, generics, try_callee_owner_with_generics(ret_try_callee, fns, structs, generics))
                                        if ret_vtry_payload.kind == TypeKind.Void:
                                            ret_vtry_status: EmitStatus = emit_propagating_try(ret_try_name, ret_try_args, ret_try_no_recovery, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder, try_callee_owner_with_generics(ret_try_callee, fns, structs, generics)) can Global{Read,Write}
                                            return EmitStatus.Declined if ret_vtry_status != EmitStatus.Open
                                            ret_vtry_bare: Expr? = null
                                            return emit_statement((Stmt.Return(ret_vtry_bare, return_line)), return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}
                                    if (emit_propagating_try_value(ret_try_name, ret_try_args, null, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder, try_callee_owner_with_generics(ret_try_callee, fns, structs, generics)) can Global{Read,Write}) is ret_try_value:
                                        return EmitStatus.Declined if not (emit_ensure_checks(ret_try_value, return_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write})
                                        (emit_region_unwind(regions, runtime, builder) can Global{Read,Write})
                                        if runtime.in_error_fn:
                                            _ = LLVMBuildStore(builder, ret_try_value, runtime.error_out)
                                            _ = LLVMBuildRet(builder, error_success_return_value(structs, runtime, ctx))
                                            return EmitStatus.Terminated
                                        _ = LLVMBuildRet(builder, ret_try_value)
                                        return EmitStatus.Terminated
                                    return EmitStatus.Declined
                            _:
                                pass
                        # `return try f[K, V](x)` — the same propagating try, but the explicit
                        # type-argument bracket makes the callee an Index/IndexN, not an Ident.
                        ret_gtry_base: mutable sview = ""
                        ret_gtry_ok: mutable bool = false
                        ret_gtry_types: darray[ValueType] = generic_callee_type_args(ret_try_callee, &ret_gtry_base, &ret_gtry_ok, structs)
                        # The VOID-payload instantiation, for the same reason as the plain
                        # callee above: the value form refuses a Void success type outright
                        # (`wants_value and gtry_type.kind == Void`). Ask for the statement
                        # form instead -- which already allocates the i64 dummy out-slot a
