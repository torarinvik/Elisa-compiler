# Stage1 backend -- (owner, name) hash chains over a unit's enum-annotation stream, held in
# fixed global tables (the backend has scalar globals only) and keyed by the stream's buffer
# address and row count. "Is there an annotation with owner X and name Y" was a scan of the
# whole stream per question: extern_return_is_pointer (~150k asks) and
# declaration_is_generated_typestate (~19k) were ~6% of IR generation for the self-host
# unit. A chain visits, in stream order, only the rows whose pair hashes like the key, and
# every caller still compares the real fields, so a collision costs one comparison. A
# stream larger than the tables keeps the scan.
# Part of `module Backend` (see codegen.elisa).
const ANNOTATION_PAIR_BUCKETS: usize = 65536
const ANNOTATION_PAIR_CAPACITY: usize = 1048576
global mutable annotation_pair_base: uintptr
global mutable annotation_pair_rows: usize
# First and last rows' lines: with base and count, the key that tells a stream from a later
# one allocated at the same address.
global mutable annotation_pair_first_line: u32
global mutable annotation_pair_last_line: u32
# 1 = chains valid for (base, rows), 2 = the stream overflowed the tables.
global mutable annotation_pair_state: u8
# Bucket -> first row + 1 (0 = empty); row -> next row + 1 in the same bucket.
global mutable annotation_pair_heads: array[u32, 65536]
global mutable annotation_pair_tails: array[u32, 65536]
global mutable annotation_pair_next: array[u32, 1048576]

extend Backend:
    private:
        def annotation_pair_bucket(owner: sview, name: sview) -> usize can[Abort.Panic]:
            hash: mutable u64 = 14695981039346656037
            for offset in 0..<sview_len(owner) |hash, owner|:
                hash <- (hash ^ sview_at(owner, offset).u64()) * 1099511628211
            hash <- (hash ^ 255) * 1099511628211
            for offset in 0..<sview_len(name) |hash, name|:
                hash <- (hash ^ sview_at(name, offset).u64()) * 1099511628211
            return (hash % ANNOTATION_PAIR_BUCKETS.u64()).usize()

        # Whether the chains describe ANNOTATIONS (building them if needed).
        def annotation_pairs_ready(annotations: darray[Ast::EnumAnnotation]&) -> bool can[Abort.Panic]:
            false return if annotations.count == 0
            base: mutable uintptr = 0
            can Unsafe.PointerCast:
                base <- (&annotations[0]).cast[uintptr]
            first_line: u32 = annotations[0].line
            last_line: u32 = annotations[annotations.count - 1].line
            if base == annotation_pair_base and annotations.count == annotation_pair_rows and first_line == annotation_pair_first_line and last_line == annotation_pair_last_line and annotation_pair_state != 0:
                return annotation_pair_state == 1
            annotation_pair_base <- base
            annotation_pair_rows <- annotations.count
            annotation_pair_first_line <- first_line
            annotation_pair_last_line <- last_line
            if annotations.count > ANNOTATION_PAIR_CAPACITY:
                annotation_pair_state <- 2
                return false
            for bucket in 0..<ANNOTATION_PAIR_BUCKETS:
                annotation_pair_heads[bucket] <- 0
                annotation_pair_tails[bucket] <- 0
            for row in 0..<annotations.count |annotations|:
                bucket: usize = annotation_pair_bucket(annotations[row].owner, annotations[row].name)
                annotation_pair_next[row] <- 0
                last: u32 = annotation_pair_tails[bucket]
                if last != 0:
                    annotation_pair_next[last.usize() - 1] <- (row + 1).u32()
                else:
                    annotation_pair_heads[bucket] <- (row + 1).u32()
                annotation_pair_tails[bucket] <- (row + 1).u32()
            annotation_pair_state <- 1
            return true

        # The first row (from FROM_ROW + 1 on, or the start when FROM_ROW < 0) with exactly
        # this OWNER and NAME, or -1.
        def annotation_pair_find(annotations: darray[Ast::EnumAnnotation]&, owner: sview, name: sview, from_row: i64) -> i64 can[Abort.Panic]:
            if annotation_pairs_ready(annotations):
                cursor: mutable u32 = annotation_pair_heads[annotation_pair_bucket(owner, name)] if from_row < 0 else annotation_pair_next[from_row.usize()]
                while cursor != 0 |cursor, annotations, owner, name|:
                    row: usize = cursor.usize() - 1
                    row.i64() return if annotations[row].owner == owner and annotations[row].name == name
                    cursor <- annotation_pair_next[row]
                return -1
            start: usize = 0 if from_row < 0 else from_row.usize() + 1
            for row in start..<annotations.count |annotations, owner, name|:
                row.i64() return if annotations[row].owner == owner and annotations[row].name == name
            return -1
