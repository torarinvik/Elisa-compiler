# Stage1 backend — the two DISPATCHERS: `emit_expression` and `emit_statement`.
#
# Each walks its branch groups in the original source order, and each group reports back
# through a `handled` flag rather than through its return value: a branch that DECLINES
# returns null/Declined, which is indistinguishable from `no branch matched` without it.
# The groups live in codegen_expr_*.elisa and codegen_stmt_*.elisa.

extend Backend:
    private:
        def backend_expression_line(expression: Expr) -> u32:
            return match expression:
                Expr.Ident(_, line) | Expr.Call(_, _, _, line) | Expr.Field(_, _, line) | Expr.Scope(_, _, line) | Expr.Index(_, _, line) | Expr.Binary(_, _, _, line) | Expr.Unary(_, _, line) | Expr.Move(_, line) | Expr.RegionNew(_, _, line) | Expr.Refinement(_, _, line) | Expr.GetElse(_, _, line) | Expr.Paren(_, line) | Expr.Array(_, line) | Expr.Tuple(_, line) | Expr.SetLit(_, line) | Expr.DictLit(_, line) | Expr.Construct(_, _, line) | Expr.RecordUpdate(_, _, line) | Expr.If(_, _, _, line) | Expr.Match(_, _, line) | Expr.Catch(_, _, line) | Expr.Comprehension(_, _, _, _, line) | Expr.Lambda(_, _, line) | Expr.ShorthandMember(_, line) | Expr.IndexN(_, _, line) | Expr.Slice(_, _, _, line) | Expr.Block(_, _, _, line): line.line
                Expr.StaticEffectCall(_, _, _, _, _, line): line.line
                _: 0

        def backend_expression_kind(expression: Expr) -> sview:
            return match expression:
                # A deferred generic operation is only valid when one installed candidate
                # matches its monomorphized type arguments. Reaching this branch means the
                # candidate family existed but no specialization matched; keep the decline
                # actionable instead of describing it as an opaque backend failure.
                Expr.StaticEffectCall(_, _, _, _, _, _): "abstract effect specialization mismatch"
                Expr.Call(_, _, _, _): "call expression"
                Expr.Field(_, _, _) | Expr.Scope(_, _, _): "field expression"
                Expr.Index(_, _, _) | Expr.IndexN(_, _, _) | Expr.Slice(_, _, _, _): "index expression"
                Expr.Binary(_, _, _, _): "binary expression"
                Expr.Unary(_, _, _) | Expr.Move(_, _) | Expr.Paren(_, _): "unary expression"
                Expr.Construct(_, _, _) | Expr.RecordUpdate(_, _, _): "record expression"
                Expr.Array(_, _) | Expr.Tuple(_, _) | Expr.SetLit(_, _) | Expr.DictLit(_, _): "aggregate expression"
                Expr.If(_, _, _, _) | Expr.Match(_, _, _) | Expr.Catch(_, _, _): "control expression"
                Expr.Block(_, _, _, _): "block expression"
                _: "expression"

        def backend_statement_line(statement: Stmt) -> u32:
            return match statement:
                Stmt.VarDecl(_, _, _, line) | Stmt.Assign(_, _, _, line) | Stmt.Expr(_, line) | Stmt.Return(_, line) | Stmt.If(_, _, _, line) | Stmt.While(_, _, line) | Stmt.For(_, _, _, _, line) | Stmt.Block(_, _, _, _, line) | Stmt.Match(_, _, line) | Stmt.Break(_, line) | Stmt.Continue(_, line) | Stmt.Contract(_, _, line): line.line
                Stmt.Invalid: 0

        def backend_statement_kind(statement: Stmt) -> sview:
            return match statement:
                Stmt.VarDecl(_, _, _, _): "variable declaration"
                Stmt.Assign(_, _, _, _): "assignment"
                Stmt.Expr(_, _): "expression statement"
                Stmt.Return(_, _): "return statement"
                Stmt.If(_, _, _, _): "if statement"
                Stmt.While(_, _, _): "while statement"
                Stmt.For(_, _, _, _, _): "for statement"
                Stmt.Block(_, _, _, _, _): "block statement"
                Stmt.Match(_, _, _): "match statement"
                Stmt.Break(_, _): "break statement"
                Stmt.Continue(_, _): "continue statement"
                Stmt.Contract(_, _, _): "contract statement"
                Stmt.Invalid: "invalid statement"

        def remember_expression_decline(expression: Expr, structs: mutable StructTable&) -> void:
            if structs.decline_line == 0:
                structs.decline_line <- backend_expression_line(expression)
                structs.decline_kind <- backend_expression_kind(expression)

        def remember_statement_decline(statement: Stmt, structs: mutable StructTable&) -> void:
            # Statement dispatch is the transaction boundary: speculative
            # expression probes may fail before another branch succeeds. If the
            # complete statement ultimately declines, its location is the
            # reliable source location to report.
            statement_kind: sview = backend_statement_kind(statement)
            # Preserve the first leaf expression when one has already identified
            # the actual backend gap. The outer statement kind is useful, but
            # `x[i] <- f(y)` is not actionable when the failure is the call or
            # the index expression inside it. A statement with no leaf decline
            # still gets its own location below.
            return if structs.decline_line != 0
            structs.decline_line <- backend_statement_line(statement)
            structs.decline_kind <- statement_kind

        # Emit a value expression, producing a value of `resolve_type(expression, expected)`.
        # `null` = unmodeled; the caller must decline.
        def emit_expression(expression: Expr, expected: ValueType, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                if expression is Expr.StaticEffectCall(_, _, _, _, _, _):
                    if lower_static_effect_call(expression, structs) is direct_call:
                        return emit_expression(direct_call, expected, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                    remember_expression_decline(expression, structs)
                    return null
                # Literal, lambda, optional-wrap, block, comprehension, refinement and catch forms — see codegen_expr_literals.elisa.
                literals_handled: mutable bool = false
                literals_value: LLVMValueRef? = emit_expression_literals(expression, expected, local_scope, fns, structs, generics, runtime, m, ctx, builder, literals_handled)
                if literals_handled:
                    if literals_value is emitted_literal:
                        return emitted_literal
                    remember_expression_decline(expression, structs)
                    return null
                # String literals, identifiers, parenthesised/unary forms and the leading binary operators — see codegen_expr_idents_binary.elisa.
                idents_binary_handled: mutable bool = false
                idents_binary_value: LLVMValueRef? = emit_expression_idents_binary(expression, expected, local_scope, fns, structs, generics, runtime, m, ctx, builder, idents_binary_handled)
                if idents_binary_handled:
                    if idents_binary_value is emitted_ident:
                        return emitted_ident
                    remember_expression_decline(expression, structs)
                    return null
                # The remaining binary operators — see codegen_expr_binary_tail.elisa.
                binary_tail_handled: mutable bool = false
                binary_tail_value: LLVMValueRef? = emit_expression_binary_tail(expression, expected, local_scope, fns, structs, generics, runtime, m, ctx, builder, binary_tail_handled)
                if binary_tail_handled:
                    if binary_tail_value is emitted_binary:
                        return emitted_binary
                    remember_expression_decline(expression, structs)
                    return null
                # The match-expression form plus value-`if`, dict/set/array/tuple literals and slicing — see codegen_expr_match_aggregates.elisa.
                match_aggregates_handled: mutable bool = false
                match_aggregates_value: LLVMValueRef? = emit_expression_match_aggregates(expression, expected, local_scope, fns, structs, generics, runtime, m, ctx, builder, match_aggregates_handled)
                if match_aggregates_handled:
                    if match_aggregates_value is emitted_aggregate:
                        return emitted_aggregate
                    remember_expression_decline(expression, structs)
                    return null
                # Struct subscripts are protocol calls (`__index__`); built-in arrays,
                # views, strings, and pointers remain owned by the following index group.
                index_overload_handled: mutable bool = false
                index_overload_value: LLVMValueRef? = emit_expression_index_overload(expression, expected, local_scope, fns, structs, generics, runtime, m, ctx, builder, index_overload_handled)
                if index_overload_handled:
                    if index_overload_value is emitted_index_overload:
                        return emitted_index_overload
                    remember_expression_decline(expression, structs)
                    return null
                # Indexing, struct construction and field/scope access — see codegen_expr_index_fields.elisa.
                index_fields_handled: mutable bool = false
                index_fields_value: LLVMValueRef? = emit_expression_index_fields(expression, expected, local_scope, fns, structs, generics, runtime, m, ctx, builder, index_fields_handled)
                if index_fields_handled:
                    if index_fields_value is emitted_index:
                        return emitted_index
                    remember_expression_decline(expression, structs)
                    return null
                # Call expressions — see codegen_expr_calls.elisa.
                calls_handled: mutable bool = false
                calls_value: LLVMValueRef? = emit_expression_calls(expression, expected, local_scope, fns, structs, generics, runtime, m, ctx, builder, calls_handled)
                if calls_handled:
                    if calls_value is emitted_call:
                        return emitted_call
                    remember_expression_decline(expression, structs)
                    return null
                remember_expression_decline(expression, structs)
                return null


            # Emit one statement. Returns false to DECLINE (unmodeled construct).
        def emit_statement(statement: Stmt, return_type: ValueType, local_scope: mutable Scope&, loops: mutable LoopStack&, regions: mutable RegionStack&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> EmitStatus can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                int64_type: LLVMTypeRef = LLVMInt64TypeInContext(ctx)
                emit_trace_step(statement, runtime, ctx, builder)
                # Prefix blocks (`region`/`can`/`in`…), contracts and expression statements — see codegen_stmt_blocks_exprs.elisa.
                blocks_exprs_handled: mutable bool = false
                blocks_exprs_status: EmitStatus = emit_statement_blocks_exprs(statement, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder, blocks_exprs_handled)
                if blocks_exprs_handled:
                    remember_statement_decline(statement, structs) if blocks_exprs_status == EmitStatus.Declined
                    return blocks_exprs_status
                # `return` and local declarations — see codegen_stmt_return_vardecl.elisa.
                return_vardecl_handled: mutable bool = false
                return_vardecl_status: EmitStatus = emit_statement_return_vardecl(statement, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder, return_vardecl_handled)
                if return_vardecl_handled:
                    remember_statement_decline(statement, structs) if return_vardecl_status == EmitStatus.Declined
                    return return_vardecl_status
                # Assignment, `if` and `while` — see codegen_stmt_assign_flow.elisa.
                assign_flow_handled: mutable bool = false
                assign_flow_status: EmitStatus = emit_statement_assign_flow(statement, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder, assign_flow_handled)
                if assign_flow_handled:
                    remember_statement_decline(statement, structs) if assign_flow_status == EmitStatus.Declined
                    return assign_flow_status
                # The `match` STATEMENT: optional, call and packed-AST scrutinees — see codegen_stmt_match.elisa.
                match_handled: mutable bool = false
                match_status: EmitStatus = emit_statement_match(statement, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder, match_handled)
                if match_handled:
                    remember_statement_decline(statement, structs) if match_status == EmitStatus.Declined
                    return match_status
                # `break`, `continue` and the `for` loop — see codegen_stmt_loops.elisa.
                loops_handled: mutable bool = false
                loops_status: EmitStatus = emit_statement_loops(statement, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder, loops_handled)
                if loops_handled:
                    remember_statement_decline(statement, structs) if loops_status == EmitStatus.Declined
                    return loops_status
                remember_statement_decline(statement, structs)
                return EmitStatus.Declined
