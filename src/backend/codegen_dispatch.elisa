# Stage1 backend — the two DISPATCHERS: `emit_expression` and `emit_statement`.
#
# Each walks its branch groups in the original source order, and each group reports back
# through a `handled` flag rather than through its return value: a branch that DECLINES
# returns null/Declined, which is indistinguishable from `no branch matched` without it.
# The groups live in codegen_expr_*.elisa and codegen_stmt_*.elisa.

extend Backend:
    private:
        # Emit a value expression, producing a value of `resolve_type(expression, expected)`.
        # `null` = unmodeled; the caller must decline.
        def emit_expression(expression: Expr, expected: ValueType, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            # Literal, lambda, optional-wrap, block, comprehension, refinement and catch forms — see codegen_expr_literals.elisa.
            literals_handled: mutable bool = false
            literals_value: LLVMValueRef? = emit_expression_literals(expression, expected, local_scope, fns, structs, generics, runtime, m, ctx, builder, literals_handled)
            literals_value return if literals_handled
            # String literals, identifiers, parenthesised/unary forms and the leading binary operators — see codegen_expr_idents_binary.elisa.
            idents_binary_handled: mutable bool = false
            idents_binary_value: LLVMValueRef? = emit_expression_idents_binary(expression, expected, local_scope, fns, structs, generics, runtime, m, ctx, builder, idents_binary_handled)
            idents_binary_value return if idents_binary_handled
            # The remaining binary operators — see codegen_expr_binary_tail.elisa.
            binary_tail_handled: mutable bool = false
            binary_tail_value: LLVMValueRef? = emit_expression_binary_tail(expression, expected, local_scope, fns, structs, generics, runtime, m, ctx, builder, binary_tail_handled)
            binary_tail_value return if binary_tail_handled
            # The match-expression form plus value-`if`, dict/set/array/tuple literals and slicing — see codegen_expr_match_aggregates.elisa.
            match_aggregates_handled: mutable bool = false
            match_aggregates_value: LLVMValueRef? = emit_expression_match_aggregates(expression, expected, local_scope, fns, structs, generics, runtime, m, ctx, builder, match_aggregates_handled)
            match_aggregates_value return if match_aggregates_handled
            # Indexing, struct construction and field/scope access — see codegen_expr_index_fields.elisa.
            index_fields_handled: mutable bool = false
            index_fields_value: LLVMValueRef? = emit_expression_index_fields(expression, expected, local_scope, fns, structs, generics, runtime, m, ctx, builder, index_fields_handled)
            index_fields_value return if index_fields_handled
            # Call expressions — see codegen_expr_calls.elisa.
            calls_handled: mutable bool = false
            calls_value: LLVMValueRef? = emit_expression_calls(expression, expected, local_scope, fns, structs, generics, runtime, m, ctx, builder, calls_handled)
            calls_value return if calls_handled
            return null


        # Emit one statement. Returns false to DECLINE (unmodeled construct).
        def emit_statement(statement: Stmt, return_type: ValueType, local_scope: mutable Scope&, loops: mutable LoopStack&, regions: mutable RegionStack&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> EmitStatus can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            int64_type: LLVMTypeRef = LLVMInt64TypeInContext(ctx)
            emit_trace_step(statement, runtime, ctx, builder)
            # Prefix blocks (`region`/`can`/`in`…), contracts and expression statements — see codegen_stmt_blocks_exprs.elisa.
            blocks_exprs_handled: mutable bool = false
            blocks_exprs_status: EmitStatus = emit_statement_blocks_exprs(statement, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder, blocks_exprs_handled)
            blocks_exprs_status return if blocks_exprs_handled
            # `return` and local declarations — see codegen_stmt_return_vardecl.elisa.
            return_vardecl_handled: mutable bool = false
            return_vardecl_status: EmitStatus = emit_statement_return_vardecl(statement, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder, return_vardecl_handled)
            return_vardecl_status return if return_vardecl_handled
            # Assignment, `if` and `while` — see codegen_stmt_assign_flow.elisa.
            assign_flow_handled: mutable bool = false
            assign_flow_status: EmitStatus = emit_statement_assign_flow(statement, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder, assign_flow_handled)
            assign_flow_status return if assign_flow_handled
            # The `match` STATEMENT: optional, call and packed-AST scrutinees — see codegen_stmt_match.elisa.
            match_handled: mutable bool = false
            match_status: EmitStatus = emit_statement_match(statement, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder, match_handled)
            match_status return if match_handled
            # `break`, `continue` and the `for` loop — see codegen_stmt_loops.elisa.
            loops_handled: mutable bool = false
            loops_status: EmitStatus = emit_statement_loops(statement, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder, loops_handled)
            loops_status return if loops_handled
            return EmitStatus.Declined
