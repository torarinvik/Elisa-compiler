# Stage1 backend — the MODULE's target and the artifacts written from it: triple and datalayout
# from a real target machine, the optimisation pipeline, and the bitcode/object writers.
# Part of `module Backend` (see codegen.elisa).

extend Backend:
    public:


        # Does this MDNode's operand 0 spell `name`?
        def md_property_is(property: LLVMValueRef, name: sview) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            # `is` binds when the value is PRESENT, so this reads "not an MDNode -> false".
            # Writing `false return if ... is node` inverts it and rejects every real node --
            # which is exactly the bug that made this verifier silently never warn.
            false return if not (LLVMIsAMDNode(property) is md_node)
            false return if LLVMGetMDNodeNumOperands(property) == 0
            # LLVM overwrites every output slot. Seed with a valid handle nevertheless:
            # zero is not a valid LLVMValueRef and would leave an invalid representation if
            # the foreign call ever returned fewer operands than its reported count.
            operands: mutable darray[LLVMValueRef] = [property for _ in 0..<LLVMGetMDNodeNumOperands(property).usize()]
            LLVMGetMDNodeOperands(property, (&operands[0]).cast[void&] can Unsafe.PointerCast)
            length: mutable u32 = 0
            if LLVMGetMDString(operands[0], (&length).cast[void&] can Unsafe.PointerCast) is text_pointer:
                # The postfix `can` grant does not parse inside an argument list; bind first.
                text_bytes: u8& = text_pointer.cast[u8&] can Unsafe.PointerCast
                return counted_bytes_match(text_bytes, length.usize(), name)
            return false




        # Compare an MDString's (pointer, length) against an sview. LLVM supplies a counted
        # byte sequence here, not a C-string, so preserve that bound without strlen scanning.
        def counted_bytes_match(text: u8&, length: usize, name: sview) -> bool can[Abort.Panic, Unsafe.PointerCast]:
            false return if length != sview_len(name)
            return unsafe_sview_bounded_bytes(text, length) == name




        # After the pass pipeline: report every loop marked `elisa.autovec.expected` that did
        # NOT come out vectorized. This is `-Wperf`.
        #
        # It has to run AFTER the passes -- the judgement IS "the vectorizer saw this loop and
        # declined". LLVM adds `llvm.loop.isvectorized` to the loop's metadata when it
        # succeeds; our marker riding in the same node is what ties the verdict back to the
        # comprehension that asked for it.
        #
        # Returns the number of unvectorized marked loops.
        def verify_autovec_expectations(m: LLVMModuleRef, ctx: LLVMContextRef) -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            kind: u32 = LLVMGetMDKindIDInContext(ctx, "llvm.loop", 9)
            warnings: mutable i64 = 0
            function_opt: mutable LLVMValueRef? = LLVMGetFirstFunction(m)
            while function_opt is function |warnings, kind, function_opt|:
                block_opt: mutable LLVMBasicBlockRef? = LLVMGetFirstBasicBlock(function)
                while block_opt is block |warnings, kind, block_opt|:
                    if LLVMGetBasicBlockTerminator(block) is terminator:
                        if LLVMGetMetadata(terminator, kind) is loop_md:
                            marked: mutable bool = false
                            vectorized: mutable bool = false
                            count: u32 = LLVMGetMDNodeNumOperands(loop_md)
                            if count > 1:
                                # `loop_md` is a valid handle to use as initialized storage;
                                # LLVM then replaces each element with the corresponding op.
                                loop_ops: mutable darray[LLVMValueRef] = [loop_md for _ in 0..<count.usize()]
                                LLVMGetMDNodeOperands(loop_md, (&loop_ops[0]).cast[void&] can Unsafe.PointerCast)
                                # Operand 0 is the node's self-reference; the properties follow.
                                for index in 1..<count.usize() |marked, vectorized, loop_ops|:
                                    marked <- true if md_property_is(loop_ops[index], "elisa.autovec.expected")
                                    vectorized <- true if md_property_is(loop_ops[index], "llvm.loop.isvectorized")
                            warnings <- warnings + 1 if marked and not vectorized
                    block_opt <- LLVMGetNextBasicBlock(block)
                function_opt <- LLVMGetNextFunction(function)
            return warnings





        # Give the module its TARGET: triple + datalayout, taken from a real target machine.
        #
        # This is not decoration. Without a datalayout LLVM uses a default where i64 is
        # 32-bit aligned, so every `store i64` is emitted `align 4` and the loop vectorizer
        # refuses to touch it — silently costing alignment and vectorization on all emitted
        # code while every exit code stayed correct. Nothing in a behavioural suite can see
        # this; stage0's module header is what gives it away.
        #
        # Returns the machine so a caller that also emits objects can reuse it. Initializing
        # the target is idempotent.
        # Configure a target machine with the same code-generation level as the
        # IR optimisation pipeline.  The old helper hard-coded level 0, so an
        # `-O2` module was optimized in LLVM IR and then lowered by an O0
        # machine.  Besides leaving target-specific combine/legalization work
        # disabled, that exposed the arm64 aggregate ABI bug in the AppKit
        # painter: `SurfaceStyle` values were marshalled differently by the
        # unoptimized emitter than by the optimized IR.  Keep the legacy
        # two-argument entry point for report/code paths that intentionally do
        # not request optimization, and make the normal driver path explicit.
        def configure_module_target_for_level(m: LLVMModuleRef, requested_triple: sview, requested_level: i64) -> void& can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            triple_storage: mutable darray[u8] = []
            triple: cstr = LLVMGetDefaultTargetTriple() if requested_triple == "" else sview_to_cstr(requested_triple, triple_storage)
            # LLVM exposes the per-target initializers, but its all-target helpers are
            # static inline and therefore unavailable to a self-hosted LLVM-C client.
            # Initialize the families stage0's target path commonly accepts explicitly.
            if requested_triple == "" or sview_matches_prefix(requested_triple, "aarch64", 0, 7) or sview_matches_prefix(requested_triple, "arm64", 0, 5):
                LLVMInitializeAArch64TargetInfo()
                LLVMInitializeAArch64Target()
                LLVMInitializeAArch64TargetMC()
                LLVMInitializeAArch64AsmPrinter()
            if requested_triple == "":
                LLVMInitializeX86TargetInfo()
                LLVMInitializeX86Target()
                LLVMInitializeX86TargetMC()
                LLVMInitializeX86AsmPrinter()
                LLVMInitializeARMTargetInfo()
                LLVMInitializeARMTarget()
                LLVMInitializeARMTargetMC()
                LLVMInitializeARMAsmPrinter()
                LLVMInitializeRISCVTargetInfo()
                LLVMInitializeRISCVTarget()
                LLVMInitializeRISCVTargetMC()
                LLVMInitializeRISCVAsmPrinter()
                LLVMInitializeWebAssemblyTargetInfo()
                LLVMInitializeWebAssemblyTarget()
                LLVMInitializeWebAssemblyTargetMC()
                LLVMInitializeWebAssemblyAsmPrinter()
            if sview_matches_prefix(requested_triple, "arm", 0, 3) or sview_matches_prefix(requested_triple, "thumb", 0, 5):
                LLVMInitializeARMTargetInfo()
                LLVMInitializeARMTarget()
                LLVMInitializeARMTargetMC()
                LLVMInitializeARMAsmPrinter()
            if sview_matches_prefix(requested_triple, "x86", 0, 3) or sview_matches_prefix(requested_triple, "i686", 0, 4):
                LLVMInitializeX86TargetInfo()
                LLVMInitializeX86Target()
                LLVMInitializeX86TargetMC()
                LLVMInitializeX86AsmPrinter()
            if sview_matches_prefix(requested_triple, "riscv", 0, 5):
                LLVMInitializeRISCVTargetInfo()
                LLVMInitializeRISCVTarget()
                LLVMInitializeRISCVTargetMC()
                LLVMInitializeRISCVAsmPrinter()
            if sview_matches_prefix(requested_triple, "wasm", 0, 4):
                LLVMInitializeWebAssemblyTargetInfo()
                LLVMInitializeWebAssemblyTarget()
                LLVMInitializeWebAssemblyTargetMC()
                LLVMInitializeWebAssemblyAsmPrinter()
            LLVMSetTarget(m, triple)
            # LLVMTargetRef is an opaque handle type, and its optional currently has a tagged
            # representation. Use the ABI pointer type for both this out-cell and all opaque
            # target-machine calls; C's LLVMTargetRef is itself just a pointer.
            target_storage: mutable void&? = null
            error_storage: mutable void&? = null
            error_slot: mutable u8&& = (&error_storage).cast[mutable u8&&] can Unsafe.PointerCast
            target_pointer: void& = (&target_storage).cast[void&] can Unsafe.PointerCast
            error_pointer: void& = (&error_storage).cast[void&] can Unsafe.PointerCast
            target_status: i32 = LLVMGetTargetFromTriple(triple, target_pointer, error_pointer)
            owns_triple: bool = requested_triple == ""
            if target_status != 0:
                if error_storage is error_message:
                    error_text: cstr = error_slot[0].cast[cstr] can Unsafe.PointerCast
                    LLVMDisposeMessage(error_text)
                LLVMDisposeMessage(triple) if owns_triple
                panic("LLVM could not resolve the requested target triple")
            if target_storage is target:
                # Match stage0: native emission is tuned to the host CPU/features, while an
                # explicit target triple stays portable and uses the generic CPU. This is
                # observable in optimized output: the target-machine cost model controls
                # inlining/vectorization, so always using `generic` can leave large helper
                # families uninlined even when the pass pipeline itself is the same.
                cpu: mutable cstr = ""
                features: mutable cstr = ""
                host_tuned: bool = requested_triple == ""
                if host_tuned:
                    cpu <- LLVMGetHostCPUName()
                    features <- LLVMGetHostCPUFeatures()
                # LLVMCodeGenOptLevel: None=0, Less=1, Default=2, Aggressive=3.
                # Clamp hostile or future values to the conservative default; the
                # driver only supplies 0..3, but this boundary is also used by
                # report tools and must never pass an invalid enum to LLVM.
                machine_level: i32 = requested_level.i32() if requested_level >= 0 and requested_level <= 3 else 0
                # Shared-library consumers (Android NativeActivity, Python extension modules,
                # and similar hosts) need position-independent relocations. Keep the historical
                # static model by default, but make PIC an explicit opt-in so ordinary native
                # executable emission remains byte-for-byte compatible.
                relocation_model: i32 = 2 if getenv("ELISA_STAGE1_PIC") is pic and pic.cast[cstr] == "1" else 0
                # This C function returns a nullable opaque handle. Give its pointer return
                # the same one-word nullable representation as C, then establish presence
                # before loading it through an opaque-handle view.
                machine_storage: void&? = LLVMCreateTargetMachine(target, triple, cpu, features, machine_level, relocation_model, 0)
                LLVMDisposeMessage(cpu) if host_tuned
                LLVMDisposeMessage(features) if host_tuned
                LLVMDisposeMessage(triple) if owns_triple
                if machine_storage is target_machine:
                    target_data: LLVMTargetDataRef = LLVMCreateTargetDataLayout(target_machine)
                    layout: cstr = LLVMCopyStringRepOfTargetData(target_data)
                    LLVMSetDataLayout(m, layout)
                    LLVMDisposeMessage(layout)
                    LLVMDisposeTargetData(target_data)
                    return target_machine
                panic("LLVM could not create a target machine for the requested triple")
            LLVMDisposeMessage(triple) if owns_triple
            panic("LLVM reported success without returning a target handle")



        # Compatibility entry point used by metadata/report helpers.  Those
        # paths do not run an optimization pipeline, so level 0 remains the
        # correct and deterministic choice for them.
        def configure_module_target_for(m: LLVMModuleRef, requested_triple: sview) -> void& can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            return configure_module_target_for_level(m, requested_triple, 0)



        def configure_module_target(m: LLVMModuleRef) -> void& can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                return configure_module_target_for(m, "")




            # Run LLVM's new pass manager on an already-emitted module. This is the stage1
            # counterpart of stage0's GenerateLLVMIRWithOpt family; callers choose the exact
            # pipeline string (for example, `default<O2>`), while the target machine supplies
            # the module's target-specific legality and cost model. LLVM returns NULL on success.
        # Give the runtime's AST-record lookup an available_externally body so an optimising
        # pipeline can inline it. `ctx_aos_store_record(state, index)` is linked from the
        # runtime object (runtime_external_only); every packed-AST field read calls it, and as
        # an opaque call it cost ~9 instructions plus the call per read (~7% of the self-host
        # semantic gate). The body below is the runtime's own code, instruction for
        # instruction, on its 64-bit PackedAoSStore layout -- chunks.data at 0, chunks.count
        # at 8, record_bytes at 32, 256 records per chunk; an out-of-range chunk traps as the
        # bounds check does there. available_externally keeps the linked definition
        # authoritative: the optimiser drops this copy after inlining, and unoptimised builds
        # never see it (their objects are unchanged).
        def inline_aos_store_record(m: LLVMModuleRef) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            if LLVMGetNamedFunction(m, "ctx_aos_store_record") is record_fn:
                inline_aos_store_record_body(m, record_fn)
            if LLVMGetNamedFunction(m, "ctx_aos_store_side_slot") is side_fn:
                inline_aos_store_side_slot_body(m, side_fn)


        # `ctx_aos_store_side_slot(state, index)` (a node's cold Pos span,
        # codegen_packed_cold_pos.elisa), inlined the same way: side_chunks.data at 48,
        # side_words at 72 of the 64-bit PackedAoSStore, 256 records per chunk.
        def inline_aos_store_side_slot_body(m: LLVMModuleRef, side_fn: LLVMValueRef) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            return if LLVMIsDeclaration(side_fn) == 0 or LLVMCountParams(side_fn) != 2
            state: LLVMValueRef = LLVMGetParam(side_fn, 0)
            record_index: LLVMValueRef = LLVMGetParam(side_fn, 1)
            return if LLVMGetTypeKind(LLVMTypeOf(state)) != 12 or LLVMGetTypeKind(LLVMTypeOf(record_index)) != 8
            return if LLVMGetIntTypeWidth(LLVMTypeOf(record_index)) != 64
            ctx: LLVMContextRef = LLVMGetModuleContext(m)
            i8_type: LLVMTypeRef = LLVMInt8TypeInContext(ctx)
            i64_type: LLVMTypeRef = LLVMInt64TypeInContext(ctx)
            pointer_type: LLVMTypeRef = LLVMPointerTypeInContext(ctx, 0)
            builder: LLVMBuilderRef = LLVMCreateBuilderInContext(ctx)
            entry: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, side_fn, "entry")
            LLVMPositionBuilderAtEnd(builder, entry)
            chunk_index: LLVMValueRef = LLVMBuildLShr(builder, record_index, LLVMConstInt(i64_type, 8, 0), "side.chunk.index")
            data_offset: mutable darray[LLVMValueRef] = [LLVMConstInt(i64_type, 48, 0)]
            data_pointer: LLVMValueRef = LLVMBuildGEP2(builder, i8_type, state, (&data_offset[0]).cast[void&], 1, "side.chunks.data.ptr")
            data: LLVMValueRef = LLVMBuildLoad2(builder, pointer_type, data_pointer, "side.chunks.data")
            slot_index: mutable darray[LLVMValueRef] = [chunk_index]
            slot_pointer: LLVMValueRef = LLVMBuildGEP2(builder, i64_type, data, (&slot_index[0]).cast[void&], 1, "side.chunk.slot")
            chunk_base: LLVMValueRef = LLVMBuildLoad2(builder, i64_type, slot_pointer, "side.chunk.base")
            words_offset: mutable darray[LLVMValueRef] = [LLVMConstInt(i64_type, 72, 0)]
            words_pointer: LLVMValueRef = LLVMBuildGEP2(builder, i8_type, state, (&words_offset[0]).cast[void&], 1, "side.words.ptr")
            side_words: LLVMValueRef = LLVMBuildLoad2(builder, i64_type, words_pointer, "side.words")
            in_chunk: LLVMValueRef = LLVMBuildAnd(builder, record_index, LLVMConstInt(i64_type, 255, 0), "side.in.chunk")
            slot_words: LLVMValueRef = LLVMBuildMul(builder, in_chunk, side_words, "side.slot.words")
            offset: LLVMValueRef = LLVMBuildMul(builder, slot_words, LLVMConstInt(i64_type, 8, 0), "side.slot.offset")
            address: LLVMValueRef = LLVMBuildAdd(builder, chunk_base, offset, "side.slot.address")
            _ = LLVMBuildRet(builder, LLVMBuildIntToPtr(builder, address, pointer_type, "side.slot"))
            LLVMDisposeBuilder(builder)
            LLVMSetLinkage(side_fn, PART_LINKAGE_AVAILABLE_EXTERNALLY)


        def inline_aos_store_record_body(m: LLVMModuleRef, record_fn: LLVMValueRef) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            return if LLVMIsDeclaration(record_fn) == 0 or LLVMCountParams(record_fn) != 2
            state: LLVMValueRef = LLVMGetParam(record_fn, 0)
            record_index: LLVMValueRef = LLVMGetParam(record_fn, 1)
            # LLVMPointerTypeKind = 12, LLVMIntegerTypeKind = 8.
            return if LLVMGetTypeKind(LLVMTypeOf(state)) != 12 or LLVMGetTypeKind(LLVMTypeOf(record_index)) != 8
            return if LLVMGetIntTypeWidth(LLVMTypeOf(record_index)) != 64
            ctx: LLVMContextRef = LLVMGetModuleContext(m)
            i8_type: LLVMTypeRef = LLVMInt8TypeInContext(ctx)
            i64_type: LLVMTypeRef = LLVMInt64TypeInContext(ctx)
            pointer_type: LLVMTypeRef = LLVMPointerTypeInContext(ctx, 0)
            builder: LLVMBuilderRef = LLVMCreateBuilderInContext(ctx)
            entry: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, record_fn, "entry")
            in_range: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, record_fn, "in.range")
            out_of_range: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, record_fn, "out.of.range")
            LLVMPositionBuilderAtEnd(builder, entry)
            chunk_index: LLVMValueRef = LLVMBuildLShr(builder, record_index, LLVMConstInt(i64_type, 8, 0), "chunk.index")
            count_offset: mutable darray[LLVMValueRef] = [LLVMConstInt(i64_type, 8, 0)]
            count_pointer: LLVMValueRef = LLVMBuildGEP2(builder, i8_type, state, (&count_offset[0]).cast[void&], 1, "chunks.count.ptr")
            chunk_count: LLVMValueRef = LLVMBuildLoad2(builder, i64_type, count_pointer, "chunks.count")
            # LLVMIntUGE = 35.
            outside: LLVMValueRef = LLVMBuildICmp(builder, 35, chunk_index, chunk_count, "chunk.outside")
            _ = LLVMBuildCondBr(builder, outside, out_of_range, in_range)
            LLVMPositionBuilderAtEnd(builder, out_of_range)
            trap_name: sview = "llvm.trap"
            trap_storage: mutable darray[u8] = []
            trap_id: u32 = LLVMLookupIntrinsicID(sview_to_cstr(trap_name, trap_storage), sview_len(trap_name))
            trap_fn: LLVMValueRef = LLVMGetIntrinsicDeclaration(m, trap_id, null, 0)
            trap_type: LLVMTypeRef = LLVMFunctionType(LLVMVoidTypeInContext(ctx), null, 0, 0)
            _ = LLVMBuildCall2(builder, trap_type, trap_fn, null, 0, "")
            _ = LLVMBuildUnreachable(builder)
            LLVMPositionBuilderAtEnd(builder, in_range)
            data: LLVMValueRef = LLVMBuildLoad2(builder, pointer_type, state, "chunks.data")
            slot_index: mutable darray[LLVMValueRef] = [chunk_index]
            slot_pointer: LLVMValueRef = LLVMBuildGEP2(builder, i64_type, data, (&slot_index[0]).cast[void&], 1, "chunk.slot")
            chunk_base: LLVMValueRef = LLVMBuildLoad2(builder, i64_type, slot_pointer, "chunk.base")
            record_offset: mutable darray[LLVMValueRef] = [LLVMConstInt(i64_type, 32, 0)]
            record_bytes_pointer: LLVMValueRef = LLVMBuildGEP2(builder, i8_type, state, (&record_offset[0]).cast[void&], 1, "record.bytes.ptr")
            record_bytes: LLVMValueRef = LLVMBuildLoad2(builder, i64_type, record_bytes_pointer, "record.bytes")
            in_chunk: LLVMValueRef = LLVMBuildAnd(builder, record_index, LLVMConstInt(i64_type, 255, 0), "in.chunk")
            sized_storage: mutable darray[u8] = []
            if LLVMGetNamedFunction(m, sview_to_cstr("ctx_aos_store_alloc_sized", sized_storage)) is sized_alloc:
                # A program with a SIZED store (codegen_packed_sized_records.elisa): there
                # record_bytes == 0 and the chunk holds record ADDRESSES (8 bytes each).
                sized_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, record_fn, "sized")
                fixed_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, record_fn, "fixed")
                is_sized: LLVMValueRef = LLVMBuildICmp(builder, 32, record_bytes, LLVMConstInt(i64_type, 0, 0), "record.sized")
                _ = LLVMBuildCondBr(builder, is_sized, sized_block, fixed_block)
                LLVMPositionBuilderAtEnd(builder, sized_block)
                slot_offset: LLVMValueRef = LLVMBuildMul(builder, in_chunk, LLVMConstInt(i64_type, 8, 0), "sized.slot.offset")
                slot_address: LLVMValueRef = LLVMBuildIntToPtr(builder, LLVMBuildAdd(builder, chunk_base, slot_offset, "sized.slot.address"), pointer_type, "sized.slot")
                _ = LLVMBuildRet(builder, LLVMBuildLoad2(builder, pointer_type, slot_address, "sized.record"))
                LLVMPositionBuilderAtEnd(builder, fixed_block)
            offset: LLVMValueRef = LLVMBuildMul(builder, in_chunk, record_bytes, "record.offset")
            address: LLVMValueRef = LLVMBuildAdd(builder, chunk_base, offset, "record.address")
            _ = LLVMBuildRet(builder, LLVMBuildIntToPtr(builder, address, pointer_type, "record"))
            LLVMDisposeBuilder(builder)
            LLVMSetLinkage(record_fn, PART_LINKAGE_AVAILABLE_EXTERNALLY)


        def run_optimization(machine: void&, m: LLVMModuleRef, pipeline: sview) -> bool can[Abort.Panic, Memory.Allocate]:
            pipeline_storage: mutable darray[u8] = []
            options: LLVMPassBuilderOptionsRef = LLVMCreatePassBuilderOptions()
            # Match stage0's pass-builder defaults. LLVM's C API otherwise leaves these
            # policy switches at library defaults, which can silently disable the
            # vectorizer/unroller even with the same `default<O*>` pipeline.
            LLVMPassBuilderOptionsSetLoopInterleaving(options, 1)
            LLVMPassBuilderOptionsSetLoopVectorization(options, 1)
            LLVMPassBuilderOptionsSetSLPVectorization(options, 1)
            LLVMPassBuilderOptionsSetLoopUnrolling(options, 1)
            pass_error: void&? = LLVMRunPasses(m, sview_to_cstr(pipeline, pipeline_storage), machine, options)
            LLVMDisposePassBuilderOptions(options)
            if pass_error is real_error:
                return false
            return true




        # Artifact writers matching stage0's backend entry points. The module must already
        # have been configured and emitted; these functions deliberately report the C API's
        # status instead of hiding a failed write behind a partially-created artifact.
        def write_bitcode(m: LLVMModuleRef, path: sview) -> bool can[Abort.Panic, Memory.Allocate]:
            path_storage: mutable darray[u8] = []
            return LLVMWriteBitcodeToFile(m, sview_to_cstr(path, path_storage)) == 0




        def emit_object(machine: void&, m: LLVMModuleRef, path: cstr) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            # Take a NUL-terminated path (cstr), not sview: stage1 meta-compile does not
            # lower the runtime `sview(cstr?,…)` constructor reliably, and the product
            # driver already holds a terminated path buffer for gen2.
            error_message: mutable cstr = zeroed
            error_pointer: void& = (&error_message).cast[void&] can Unsafe.PointerCast
            return LLVMTargetMachineEmitToFile(machine, m, path, 1, error_pointer) == 0

include "./codegen_aggregate_copies.elisa"
include "./codegen_parallel_emit.elisa"
