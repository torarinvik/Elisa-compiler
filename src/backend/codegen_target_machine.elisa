# Stage1 backend — the MODULE's target and the artifacts written from it: triple and datalayout
# from a real target machine, the optimisation pipeline, and the bitcode/object writers.
# Part of `module Backend` (see codegen.elisa).

extend Backend:
    public:


        # Does this MDNode's operand 0 spell `name`?
        def md_property_is(property: LLVMValueRef, name: sview) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            # `is` binds when the value is PRESENT, so this reads "not an MDNode -> false".
            # Writing `false return if ... is node` inverts it and rejects every real node --
            # which is exactly the bug that made this verifier silently never warn.
            false return if not (LLVMIsAMDNode(property) is md_node)
            false return if LLVMGetMDNodeNumOperands(property) == 0
            operands: mutable darray[LLVMValueRef] = [zeroed for _ in 0..<LLVMGetMDNodeNumOperands(property).usize()]
            LLVMGetMDNodeOperands(property, (&operands[0]).cast[void&] can Unsafe.PointerCast)
            length: mutable u32 = 0
            if LLVMGetMDString(operands[0], (&length).cast[void&] can Unsafe.PointerCast) is text_pointer:
                # The postfix `can` grant does not parse inside an argument list; bind first.
                text: cstr = text_pointer.cast[cstr] can Unsafe.PointerCast
                return cstr_matches(text, length.usize(), name)
            return false




        # Compare an MDString's (pointer, length) against an sview.
        #
        # Via the `sview(ptr, start, end)` constructor rather than hand-rolled pointer
        # arithmetic: my first cut wrote `(&bytes)[index]` on a `u8&`, which takes the address
        # of the LOCAL holding the reference and indexes THAT -- reading unrelated stack and
        # segfaulting. A reference is not an array.
        def cstr_matches(text: cstr, length: usize, name: sview) -> bool can[Abort.Panic, Unsafe.PointerCast]:
            false return if length != sview_len(name)
            bytes: u8&? = text.cast[u8&?] can Unsafe.PointerCast
            return sview(bytes, 0, length.i64()) == name




        # After the pass pipeline: report every loop marked `elisa.autovec.expected` that did
        # NOT come out vectorized. This is `-Wperf`.
        #
        # It has to run AFTER the passes -- the judgement IS "the vectorizer saw this loop and
        # declined". LLVM adds `llvm.loop.isvectorized` to the loop's metadata when it
        # succeeds; our marker riding in the same node is what ties the verdict back to the
        # comprehension that asked for it.
        #
        # Returns the number of unvectorized marked loops.
        def verify_autovec_expectations(m: LLVMModuleRef, ctx: LLVMContextRef) -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            kind: u32 = LLVMGetMDKindIDInContext(ctx, "llvm.loop", 9)
            warnings: mutable i64 = 0
            function_opt: mutable LLVMValueRef? = LLVMGetFirstFunction(m)
            while function_opt is function |warnings, kind, function_opt|:
                block_opt: mutable LLVMBasicBlockRef? = LLVMGetFirstBasicBlock(function)
                while block_opt is block |warnings, kind, block_opt|:
                    if LLVMGetBasicBlockTerminator(block) is terminator:
                        if LLVMGetMetadata(terminator, kind) is loop_md:
                            marked: mutable bool = false
                            vectorized: mutable bool = false
                            count: u32 = LLVMGetMDNodeNumOperands(loop_md)
                            if count > 1:
                                loop_ops: mutable darray[LLVMValueRef] = [zeroed for _ in 0..<count.usize()]
                                LLVMGetMDNodeOperands(loop_md, (&loop_ops[0]).cast[void&] can Unsafe.PointerCast)
                                # Operand 0 is the node's self-reference; the properties follow.
                                for index in 1..<count.usize() |marked, vectorized, loop_ops|:
                                    marked <- true if md_property_is(loop_ops[index], "elisa.autovec.expected")
                                    vectorized <- true if md_property_is(loop_ops[index], "llvm.loop.isvectorized")
                            warnings <- warnings + 1 if marked and not vectorized
                    block_opt <- LLVMGetNextBasicBlock(block)
                function_opt <- LLVMGetNextFunction(function)
            return warnings





        # Give the module its TARGET: triple + datalayout, taken from a real target machine.
        #
        # This is not decoration. Without a datalayout LLVM uses a default where i64 is
        # 32-bit aligned, so every `store i64` is emitted `align 4` and the loop vectorizer
        # refuses to touch it — silently costing alignment and vectorization on all emitted
        # code while every exit code stayed correct. Nothing in a behavioural suite can see
        # this; stage0's module header is what gives it away.
        #
        # Returns the machine so a caller that also emits objects can reuse it. Initializing
        # the target is idempotent.
        def configure_module_target_for(m: LLVMModuleRef, requested_triple: sview) -> LLVMTargetMachineRef can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            triple_storage: mutable darray[u8] = []
            triple: cstr = LLVMGetDefaultTargetTriple() if requested_triple == "" else sview_to_cstr(requested_triple, triple_storage)
            # LLVM exposes the per-target initializers, but its all-target helpers are
            # static inline and therefore unavailable to a self-hosted LLVM-C client.
            # Initialize the families stage0's target path commonly accepts explicitly.
            if requested_triple == "" or sview_matches_prefix(requested_triple, "aarch64", 0, 7) or sview_matches_prefix(requested_triple, "arm64", 0, 5):
                LLVMInitializeAArch64TargetInfo()
                LLVMInitializeAArch64Target()
                LLVMInitializeAArch64TargetMC()
                LLVMInitializeAArch64AsmPrinter()
            if requested_triple == "":
                LLVMInitializeX86TargetInfo()
                LLVMInitializeX86Target()
                LLVMInitializeX86TargetMC()
                LLVMInitializeX86AsmPrinter()
                LLVMInitializeARMTargetInfo()
                LLVMInitializeARMTarget()
                LLVMInitializeARMTargetMC()
                LLVMInitializeARMAsmPrinter()
                LLVMInitializeRISCVTargetInfo()
                LLVMInitializeRISCVTarget()
                LLVMInitializeRISCVTargetMC()
                LLVMInitializeRISCVAsmPrinter()
                LLVMInitializeWebAssemblyTargetInfo()
                LLVMInitializeWebAssemblyTarget()
                LLVMInitializeWebAssemblyTargetMC()
                LLVMInitializeWebAssemblyAsmPrinter()
            if sview_matches_prefix(requested_triple, "arm", 0, 3) or sview_matches_prefix(requested_triple, "thumb", 0, 5):
                LLVMInitializeARMTargetInfo()
                LLVMInitializeARMTarget()
                LLVMInitializeARMTargetMC()
                LLVMInitializeARMAsmPrinter()
            if sview_matches_prefix(requested_triple, "x86", 0, 3) or sview_matches_prefix(requested_triple, "i686", 0, 4):
                LLVMInitializeX86TargetInfo()
                LLVMInitializeX86Target()
                LLVMInitializeX86TargetMC()
                LLVMInitializeX86AsmPrinter()
            if sview_matches_prefix(requested_triple, "riscv", 0, 5):
                LLVMInitializeRISCVTargetInfo()
                LLVMInitializeRISCVTarget()
                LLVMInitializeRISCVTargetMC()
                LLVMInitializeRISCVAsmPrinter()
            if sview_matches_prefix(requested_triple, "wasm", 0, 4):
                LLVMInitializeWebAssemblyTargetInfo()
                LLVMInitializeWebAssemblyTarget()
                LLVMInitializeWebAssemblyTargetMC()
                LLVMInitializeWebAssemblyAsmPrinter()
            LLVMSetTarget(m, triple)
            target: mutable LLVMTargetRef = zeroed
            error_message: mutable cstr = zeroed
            target_pointer: void& = (&target).cast[void&] can Unsafe.PointerCast
            error_pointer: void& = (&error_message).cast[void&] can Unsafe.PointerCast
            _ = LLVMGetTargetFromTriple(triple, target_pointer, error_pointer)
            # Match stage0: native emission is tuned to the host CPU/features, while an
            # explicit target triple stays portable and uses the generic CPU. This is
            # observable in optimized output: the target-machine cost model controls
            # inlining/vectorization, so always using `generic` can leave large helper
            # families uninlined even when the pass pipeline itself is the same.
            cpu: mutable cstr = ""
            features: mutable cstr = ""
            host_tuned: bool = requested_triple == ""
            if host_tuned:
                cpu <- LLVMGetHostCPUName()
                features <- LLVMGetHostCPUFeatures()
            machine: LLVMTargetMachineRef = LLVMCreateTargetMachine(target, triple, cpu, features, 0, 0, 0)
            LLVMDisposeMessage(cpu) if host_tuned
            LLVMDisposeMessage(features) if host_tuned
            layout: cstr = LLVMCopyStringRepOfTargetData(LLVMCreateTargetDataLayout(machine))
            LLVMSetDataLayout(m, layout)
            LLVMDisposeMessage(layout)
            return machine



        def configure_module_target(m: LLVMModuleRef) -> LLVMTargetMachineRef can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                return configure_module_target_for(m, "")




            # Run LLVM's new pass manager on an already-emitted module. This is the stage1
            # counterpart of stage0's GenerateLLVMIRWithOpt family; callers choose the exact
            # pipeline string (for example, `default<O2>`), while the target machine supplies
            # the module's target-specific legality and cost model. LLVM returns NULL on success.
        def run_optimization(machine: LLVMTargetMachineRef, m: LLVMModuleRef, pipeline: sview) -> bool can[Abort.Panic, Memory.Allocate]:
            pipeline_storage: mutable darray[u8] = []
            options: LLVMPassBuilderOptionsRef = LLVMCreatePassBuilderOptions()
            # Match stage0's pass-builder defaults. LLVM's C API otherwise leaves these
            # policy switches at library defaults, which can silently disable the
            # vectorizer/unroller even with the same `default<O*>` pipeline.
            LLVMPassBuilderOptionsSetLoopInterleaving(options, 1)
            LLVMPassBuilderOptionsSetLoopVectorization(options, 1)
            LLVMPassBuilderOptionsSetSLPVectorization(options, 1)
            LLVMPassBuilderOptionsSetLoopUnrolling(options, 1)
            pass_error: void&? = LLVMRunPasses(m, sview_to_cstr(pipeline, pipeline_storage), machine, options)
            LLVMDisposePassBuilderOptions(options)
            if pass_error is real_error:
                return false
            return true




        # Artifact writers matching stage0's backend entry points. The module must already
        # have been configured and emitted; these functions deliberately report the C API's
        # status instead of hiding a failed write behind a partially-created artifact.
        def write_bitcode(m: LLVMModuleRef, path: sview) -> bool can[Abort.Panic, Memory.Allocate]:
            path_storage: mutable darray[u8] = []
            return LLVMWriteBitcodeToFile(m, sview_to_cstr(path, path_storage)) == 0




        def emit_object(machine: LLVMTargetMachineRef, m: LLVMModuleRef, path: cstr) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            # Take a NUL-terminated path (cstr), not sview: stage1 meta-compile does not
            # lower the runtime `sview(u8&?,…)` constructor reliably, and the product
            # driver already holds a terminated path buffer for gen2.
            error_message: mutable cstr = zeroed
            error_pointer: void& = (&error_message).cast[void&] can Unsafe.PointerCast
            return LLVMTargetMachineEmitToFile(machine, m, path, 1, error_pointer) == 0
