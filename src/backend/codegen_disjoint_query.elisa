# Stage1 backend — READING the disjointness facts back at a use site: which parameter a pointer
# came from, the per-function proven mask, and the scope name the metadata is keyed on.
# Part of `module Backend` (see codegen.elisa).

extend Backend:
    private:


        def disjoint_mask_has(mask: u64, index: u32) -> bool can[Abort.Panic]:
            bit: mutable u64 = 1
            for _ in 0..<index |bit|:
                bit <- bit * 2
            return mask >= bit and (mask / bit) % 2 == 1




        def disjoint_param_index(name: sview, parameters: darray[Ast::ParamDecl]&) -> i64 can[Abort.Panic]:
            index: mutable i64 = 0
            for parameter in parameters |name, index|:
                if parameter.name == name:
                    return index
                index <- index + 1
            return -1




        def register_disjoint_facts(declarations: darray[Decl]&, structs: mutable StructTable&) -> void can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                disjoint_collect_candidates(declarations, structs)
                disjoint_finalize_facts(declarations, structs)




        def disjoint_function_mask(function_name: sview, structs: StructTable&) -> u64 can[Abort.Panic]:
            for index in 0..<structs.disjoint_function_names.count |function_name, structs|:
                if structs.disjoint_function_names[index] == function_name:
                    return structs.disjoint_function_masks[index]
            return 0




        def disjoint_scope_name(index: u32) -> sview:
            if index == 0:
                return "elt.p0"
            if index == 1:
                return "elt.p1"
            if index == 2:
                return "elt.p2"
            if index == 3:
                return "elt.p3"
            if index == 4:
                return "elt.p4"
            if index == 5:
                return "elt.p5"
            if index == 6:
                return "elt.p6"
            if index == 7:
                return "elt.p7"
            if index == 8:
                return "elt.p8"
            if index == 9:
                return "elt.p9"
            if index == 10:
                return "elt.p10"
            if index == 11:
                return "elt.p11"
            if index == 12:
                return "elt.p12"
            if index == 13:
                return "elt.p13"
            if index == 14:
                return "elt.p14"
            if index == 15:
                return "elt.p15"
            return "elt.p0"




        def disjoint_param_index_for_pointer(pointer: LLVMValueRef, runtime: Runtime&) -> i64 can[Abort.Panic]:
            for index in 0..<runtime.disjoint_param_slots.count |runtime, pointer|:
                slot: LLVMValueRef = runtime.disjoint_param_slots[index]
                current: mutable LLVMValueRef = pointer
                for _ in 0..<8 |current, slot|:
                    if current == slot:
                        return runtime.disjoint_param_indices[index].i64()
                    if current == zeroed:
                        break
                    if LLVMGetNumOperands(current) == 0:
                        break
                    current <- LLVMGetOperand(current, 0)
            return -1




        def disjoint_element_index_for_pointer(pointer: LLVMValueRef, runtime: Runtime&) -> i64 can[Abort.Panic]:
            can Abort.Panic:
                for index in 0..<runtime.disjoint_element_ptrs.count |runtime, pointer|:
                    if runtime.disjoint_element_ptrs[index] == pointer:
                        return runtime.disjoint_element_indices[index].i64()
                return disjoint_param_index_for_pointer(pointer, runtime)
