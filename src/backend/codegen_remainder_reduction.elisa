# Late AArch64 reduction grouping, matching the Stage0 wrapping-add rule.
# Only the two unflagged additions move; quotient/product flags remain intact.
include "./posix_loader.elisa"
extern LLVMSetOperand(value: LLVMValueRef, index: u32, operand: LLVMValueRef)

extend Backend:
    private:
        struct RRFlags:
            nuw_fn: void&
            nsw_fn: void&

        def rr_opcode(value: LLVMValueRef, opcode: u32) -> bool:
            return false if LLVMIsAInstruction(value) == null
            return false if LLVMGetInstructionOpcode(value) != opcode
            ty: LLVMTypeRef = LLVMTypeOf(value)
            LLVMGetTypeKind(ty) == 8 and LLVMGetIntTypeWidth(ty) == 64

        def rr_wrapping_add(value: LLVMValueRef, flags: RRFlags&) -> bool can[Unsafe.PointerCast, Unsafe.PointerArithmetic]:
            return false if not rr_opcode(value, 8)
            return false if (flags.nuw_fn.call_as[fn(LLVMValueRef) -> i32](value) can[Unsafe.PointerCast, Unsafe.PointerArithmetic]) != 0
            (flags.nsw_fn.call_as[fn(LLVMValueRef) -> i32](value) can[Unsafe.PointerCast, Unsafe.PointerArithmetic]) == 0

        def rr_target_prefix(text: u8&, prefix: sview) -> bool can[Unsafe.PointerArithmetic]:
            for index in 0..<prefix.len |text, prefix|:
                return false if text[index] == 0 or text[index] != prefix[index].u8()
            true

        def rr_target(module: LLVMModuleRef) -> bool can[Unsafe.PointerCast, Unsafe.PointerArithmetic]:
            if LLVMGetTarget(module) is target:
                text: u8& = target.cast[u8&] can Unsafe.PointerCast
                return (rr_target_prefix(text, "arm64-") can Unsafe.PointerArithmetic) or (rr_target_prefix(text, "aarch64-") can Unsafe.PointerArithmetic)
            false

        def rr_group(sum: LLVMValueRef, builder: LLVMBuilderRef, flags: RRFlags&) -> bool can[Unsafe.PointerCast, Unsafe.PointerArithmetic]:
            return false if not (rr_wrapping_add(sum, flags) can[Unsafe.PointerCast, Unsafe.PointerArithmetic])
            block: LLVMBasicBlockRef = LLVMGetInstructionParent(sum)
            for side in 0..<2 |sum, builder, block, flags|:
                inner: LLVMValueRef = LLVMGetOperand(sum, side.u32())
                product: LLVMValueRef = LLVMGetOperand(sum, (1 - side).u32())
                continue if not (rr_wrapping_add(inner, flags) can[Unsafe.PointerCast, Unsafe.PointerArithmetic]) or not rr_opcode(product, 12)
                continue if LLVMGetInstructionParent(inner) != block
                if LLVMGetFirstUse(inner) is use:
                    continue if LLVMGetNextUse(use) != null or LLVMGetUser(use) != sum
                else:
                    continue
                for product_side in 0..<2 |sum, builder, block, inner, product|:
                    quotient: LLVMValueRef = LLVMGetOperand(product, product_side.u32())
                    negative: LLVMValueRef = LLVMGetOperand(product, (1 - product_side).u32())
                    continue if not rr_opcode(quotient, 14) or LLVMIsAConstantInt(negative) == null
                    divisor: LLVMValueRef = LLVMGetOperand(quotient, 1)
                    continue if LLVMIsAConstantInt(divisor) == null
                    divisor_value: u64 = LLVMConstIntGetZExtValue(divisor)
                    continue if divisor_value == 0
                    negative_value: u64 = (18446744073709551615.u64() - divisor_value) + 1.u64()
                    continue if LLVMConstIntGetZExtValue(negative) != negative_value
                    numerator: LLVMValueRef = LLVMGetOperand(quotient, 0)
                    for number_side in 0..<2 |sum, builder, block, inner, product, numerator|:
                        accumulator: LLVMValueRef = LLVMGetOperand(inner, (1 - number_side).u32())
                        continue if LLVMGetOperand(inner, number_side.u32()) != numerator
                        continue if not rr_opcode(accumulator, 44) or LLVMGetInstructionParent(accumulator) != block
                        # (N+A)+P == (N+P)+A modulo 2^64, with the same poison inputs.
                        LLVMPositionBuilderBefore(builder, sum)
                        remainder: LLVMValueRef = LLVMBuildAdd(builder, numerator, product, "elisa.remainder.grouped")
                        LLVMSetOperand(sum, 0, remainder)
                        LLVMSetOperand(sum, 1, accumulator)
                        LLVMInstructionEraseFromParent(inner)
                        return true
            false

        def rr_scan(module: LLVMModuleRef, ctx: LLVMContextRef, flags: RRFlags&) -> usize can[Unsafe.PointerCast, Unsafe.PointerArithmetic]:
            return 0 if not (rr_target(module) can[Unsafe.PointerCast, Unsafe.PointerArithmetic])
            builder: LLVMBuilderRef = LLVMCreateBuilderInContext(ctx)
            defer block:
                LLVMDisposeBuilder(builder)
            optnone: u32 = LLVMGetEnumAttributeKindForName("optnone", 7)
            changed: mutable usize = 0
            remaining: mutable usize = 262144
            function_opt: mutable LLVMValueRef? = LLVMGetFirstFunction(module)
            while function_opt is function |function_opt, changed, remaining, builder, optnone, flags|:
                if LLVMGetEnumAttributeAtIndex(function, 4294967295, optnone) == null:
                    block_opt: mutable LLVMBasicBlockRef? = LLVMGetFirstBasicBlock(function)
                    while block_opt is block |block_opt, changed, remaining, builder, flags|:
                        instruction_opt: mutable LLVMValueRef? = LLVMGetFirstInstruction(block)
                        while instruction_opt is instruction |instruction_opt, changed, remaining, builder, flags|:
                            return changed if remaining == 0
                            remaining <- remaining - 1
                            next: LLVMValueRef? = LLVMGetNextInstruction(instruction)
                            changed <- changed + 1 if (rr_group(instruction, builder, flags) can[Unsafe.PointerCast, Unsafe.PointerArithmetic])
                            instruction_opt <- next
                        block_opt <- LLVMGetNextBasicBlock(block)
                function_opt <- LLVMGetNextFunction(function)
            changed

    public:
        static if ELISA_TARGET_OS_POSIX:
            def rr_same_llvm_image(anchor: void&, target: void&) -> bool:
                a: mutable ArtifactDlInfo = ArtifactDlInfo{image_path: "", image_base: anchor, symbol_name: "", symbol_address: anchor}
                b: mutable ArtifactDlInfo = ArtifactDlInfo{image_path: "", image_base: target, symbol_name: "", symbol_address: target}
                return false if artifact_identity_dladdr(anchor, &a) == 0 or artifact_identity_dladdr(target, &b) == 0
                a.image_base == b.image_base

            def group_remainder_reductions(module: LLVMModuleRef, ctx: LLVMContextRef) -> usize can[Unsafe.PointerCast, Unsafe.PointerArithmetic, Global.Read]:
                # Match the other LLVM-sensitive passes: flags must come from the
                # same image as the API that owns these instruction handles.
                direct_anchor: void& = LLVMContextCreate.cast[void&] can Unsafe.PointerCast
                if artifact_identity_dlopen(null, 2) is handle:
                    defer block:
                        _ = artifact_identity_dlclose(handle)
                    if artifact_identity_dlsym(handle, "LLVMContextCreate") is anchor:
                        return 0 if not (rr_same_llvm_image(direct_anchor, anchor) can Global.Read)
                        version_fn: void& = LLVMGetVersion.cast[void&] can Unsafe.PointerCast
                        return 0 if not (rr_same_llvm_image(anchor, version_fn) can Global.Read)
                        major: mutable u32 = 0
                        minor: mutable u32 = 0
                        patch: mutable u32 = 0
                        LLVMGetVersion(&major, &minor, &patch)
                        return 0 if major < 21
                        if artifact_identity_dlsym(handle, "LLVMGetNUW") is nuw_fn:
                            if artifact_identity_dlsym(handle, "LLVMGetNSW") is nsw_fn:
                                return 0 if not (rr_same_llvm_image(anchor, nuw_fn) can Global.Read)
                                return 0 if not (rr_same_llvm_image(anchor, nsw_fn) can Global.Read)
                                flags: RRFlags = RRFlags{nuw_fn: nuw_fn, nsw_fn: nsw_fn}
                                return rr_scan(module, ctx, &flags) can[Unsafe.PointerCast, Unsafe.PointerArithmetic]
                0
        static else:
            def group_remainder_reductions(module: LLVMModuleRef, ctx: LLVMContextRef) -> usize:
                0
