# Checked decimal digit steps used by the EASM contract integer parser.
module EasmCheckedDecimal:
    public:
        const DECIMAL_RADIX: i64 = 10
        const MAX_DECIMAL_DIGIT: i64 = DECIMAL_RADIX - 1
        const I64_MAX: i64 = 9223372036854775807
        const I64_MIN: i64 = 0 - I64_MAX - 1
        const ASCII_DIGIT_ZERO: u8 = 48
        const ASCII_DIGIT_NINE: u8 = 57
        const ASCII_MINUS: u8 = 45

        def append_positive_digit(value: i64, digit: i64) -> (valid: bool, value: i64):
            requires value >= 0 and digit >= 0 and digit <= MAX_DECIMAL_DIGIT
            ensure result.valid == (value < I64_MAX / DECIMAL_RADIX
                or (value == I64_MAX / DECIMAL_RADIX and digit <= I64_MAX % DECIMAL_RADIX))
            ensure result.valid implies result.value == value * DECIMAL_RADIX + digit
            ensure not result.valid implies result.value == 0
            limit: i64 = I64_MAX / DECIMAL_RADIX
            final_digit_limit: i64 = I64_MAX % DECIMAL_RADIX
            return (false, 0) if:
                value > limit
                value == limit and digit > final_digit_limit
            return (true, value * DECIMAL_RADIX + digit)

        def append_negative_digit(value: i64, digit: i64) -> (valid: bool, value: i64):
            requires value <= 0 and digit >= 0 and digit <= MAX_DECIMAL_DIGIT
            ensure result.valid == (value > I64_MIN / DECIMAL_RADIX
                or (value == I64_MIN / DECIMAL_RADIX and digit <= 0 - (I64_MIN % DECIMAL_RADIX)))
            ensure result.valid implies result.value == value * DECIMAL_RADIX - digit
            ensure not result.valid implies result.value == 0
            limit: i64 = I64_MIN / DECIMAL_RADIX
            final_digit_limit: i64 = 0 - (I64_MIN % DECIMAL_RADIX)
            return (false, 0) if:
                value < limit
                value == limit and digit > final_digit_limit
            return (true, value * DECIMAL_RADIX - digit)

        # Independent recursive reference fold for the byte parser. This is ghost code: it
        # defines the signed-decimal result without calling the production digit helpers.
        ghost def decimal_parse_reference_from(text: sview, position: usize, negative: bool, value: i64, consumed_digit: bool) -> (valid: bool, value: i64):
            requires position <= text.len and (negative implies value <= 0) and (not negative implies value >= 0)
            decreases text.len - position
            ensure not result.valid implies result.value == 0
            ensure result.valid implies (negative implies result.value <= 0)
            ensure result.valid implies (not negative implies result.value >= 0)
            ensure (position == text.len and not consumed_digit) implies not result.valid
            return (true, value) if position == text.len and consumed_digit
            return (false, 0) if position == text.len
            byte: u8 = text[position]
            return (false, 0) if byte < ASCII_DIGIT_ZERO or byte > ASCII_DIGIT_NINE
            digit: i64 = (byte - ASCII_DIGIT_ZERO).i64()
            if negative:
                limit: i64 = I64_MIN / DECIMAL_RADIX
                final_digit_limit: i64 = 0 - (I64_MIN % DECIMAL_RADIX)
                return (false, 0) if value < limit or (value == limit and digit > final_digit_limit)
                next_value: i64 = value * DECIMAL_RADIX - digit
                next: (valid: bool, value: i64) = decimal_parse_reference_from(text, position + 1, true, next_value, true)
                return next
            limit: i64 = I64_MAX / DECIMAL_RADIX
            final_digit_limit: i64 = I64_MAX % DECIMAL_RADIX
            return (false, 0) if value > limit or (value == limit and digit > final_digit_limit)
            next_value: i64 = value * DECIMAL_RADIX + digit
            next: (valid: bool, value: i64) = decimal_parse_reference_from(text, position + 1, false, next_value, true)
            return next

        ghost def decimal_parse_reference(text: sview) -> (valid: bool, value: i64):
            ensure not result.valid implies result.value == 0
            ensure (result.valid and text.len > 0 and text[0] == ASCII_MINUS) implies result.value <= 0
            ensure (result.valid and text.len > 0 and text[0] != ASCII_MINUS) implies result.value >= 0
            return (false, 0) if text.len <= 0 or text.len.usize().i64() != text.len
            return decimal_parse_reference_from(text, 1, true, 0, false) if text.len > 0 and text[0] == EasmCheckedDecimal::ASCII_MINUS
            return decimal_parse_reference_from(text, 0, false, 0, false)

        # Parse a signed decimal without ever evaluating an unchecked multiply-add.
        # The negative accumulator path represents I64_MIN without negating it.
        def parse_signed(text: sview) -> (valid: bool, value: i64):
            ensure result.valid == decimal_parse_reference(text).valid
            ensure result.value == decimal_parse_reference(text).value
            ensure not result.valid implies result.value == 0
            ensure (result.valid and text.len > 0 and text[0] == ASCII_MINUS) implies result.value <= 0
            ensure (result.valid and text.len > 0 and text[0] != ASCII_MINUS) implies result.value >= 0
            ensure result.valid implies (
                text.len > 0
                and (text[0] != ASCII_MINUS or text.len > 1)
            )
            ensure result.valid implies (forall digit_index in 0..<text.len:
                (digit_index == 0 and text[digit_index] == ASCII_MINUS)
                or (text[digit_index] >= ASCII_DIGIT_ZERO and text[digit_index] <= ASCII_DIGIT_NINE)
            )
            return (false, 0) if text.len <= 0 or text.len.usize().i64() != text.len
            ghost reference: (valid: bool, value: i64) = decimal_parse_reference(text)
            position: mutable usize = 0
            negative: mutable bool = false
            if text.len > 0 and text[0] == EasmCheckedDecimal::ASCII_MINUS:
                negative <- true
                position <- 1
            assert (position != text.len) or not reference.valid
            assert (position != text.len) or reference.value == 0
            return (false, 0) if position == text.len
            value: mutable i64 = 0
            start: usize = position
            assert decimal_parse_reference_from(text, position, negative, value, position > start).valid == reference.valid
            assert decimal_parse_reference_from(text, position, negative, value, position > start).value == reference.value
            while position < text.len |position, text, value|:
                decreases text.len - position
                invariant position <= text.len
                invariant start < text.len
                invariant negative implies position >= 1
                invariant negative implies value <= 0
                invariant not negative implies value >= 0
                invariant decimal_parse_reference_from(text, position, negative, value, position > start).valid == reference.valid
                invariant decimal_parse_reference_from(text, position, negative, value, position > start).value == reference.value
                invariant forall digit_index in 0..<position: (negative and digit_index == 0 and text[digit_index] == ASCII_MINUS) or (text[digit_index] >= ASCII_DIGIT_ZERO and text[digit_index] <= ASCII_DIGIT_NINE)
                byte: u8 = text[position]
                if byte < ASCII_DIGIT_ZERO or byte > ASCII_DIGIT_NINE:
                    assert not reference.valid
                    assert reference.value == 0
                    return (false, 0)
                digit: i64 = (byte - ASCII_DIGIT_ZERO).i64()
                if negative:
                    step: (valid: bool, value: i64) = append_negative_digit(value, digit)
                    if not step.valid:
                        assert not reference.valid
                        assert reference.value == 0
                        return (false, 0)
                    value <- step.value
                else:
                    step: (valid: bool, value: i64) = append_positive_digit(value, digit)
                    if not step.valid:
                        assert not reference.valid
                        assert reference.value == 0
                        return (false, 0)
                    value <- step.value
                position <- position + 1
                assert decimal_parse_reference_from(text, position, negative, value, position > start).valid == reference.valid
                assert decimal_parse_reference_from(text, position, negative, value, position > start).value == reference.value
            assert decimal_parse_reference_from(text, position, negative, value, position > start).valid
            assert decimal_parse_reference_from(text, position, negative, value, position > start).value == value
            assert reference.valid
            assert reference.value == value
            return (true, value)
