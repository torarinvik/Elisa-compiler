# Checked decimal digit steps used by the EASM contract integer parser.
module EasmCheckedDecimal:
    public:
        const DECIMAL_RADIX: i64 = 10
        const MAX_DECIMAL_DIGIT: i64 = DECIMAL_RADIX - 1
        const I64_MAX: i64 = 9223372036854775807
        const I64_MIN: i64 = 0 - I64_MAX - 1
        const ASCII_DIGIT_ZERO: u8 = 48
        const ASCII_DIGIT_NINE: u8 = 57
        const ASCII_MINUS: u8 = 45

        def append_positive_digit(value: i64, digit: i64) -> (valid: bool, value: i64):
            requires digit >= 0 and digit <= MAX_DECIMAL_DIGIT
            ensure result.valid == (value >= 0 and (value < I64_MAX / DECIMAL_RADIX
                or (value == I64_MAX / DECIMAL_RADIX and digit <= I64_MAX % DECIMAL_RADIX)))
            ensure result.valid implies result.value == value * DECIMAL_RADIX + digit
            ensure not result.valid implies result.value == 0
            limit: i64 = I64_MAX / DECIMAL_RADIX
            final_digit_limit: i64 = I64_MAX % DECIMAL_RADIX
            return (false, 0) if value < 0
            return (false, 0) if:
                value > limit
                value == limit and digit > final_digit_limit
            return (true, value * DECIMAL_RADIX + digit)

        def append_negative_digit(value: i64, digit: i64) -> (valid: bool, value: i64):
            requires digit >= 0 and digit <= MAX_DECIMAL_DIGIT
            ensure result.valid == (value <= 0 and (value > I64_MIN / DECIMAL_RADIX
                or (value == I64_MIN / DECIMAL_RADIX and digit <= 0 - (I64_MIN % DECIMAL_RADIX))))
            ensure result.valid implies result.value == value * DECIMAL_RADIX - digit
            ensure not result.valid implies result.value == 0
            limit: i64 = I64_MIN / DECIMAL_RADIX
            final_digit_limit: i64 = 0 - (I64_MIN % DECIMAL_RADIX)
            return (false, 0) if value > 0
            return (false, 0) if:
                value < limit
                value == limit and digit > final_digit_limit
            return (true, value * DECIMAL_RADIX - digit)

        # Independent recursive reference fold for the byte parser. This is ghost code: it
        # defines the signed-decimal result without calling the production digit helpers.
        ghost def decimal_parse_reference_from(text: sview, position: usize, negative: bool, value: i64, consumed_digit: bool) -> (valid: bool, value: i64):
            requires position <= text.len
            decreases text.len - position
            ensure (position == text.len and not consumed_digit) implies (not result.valid and result.value == 0)
            ensure (position == text.len and consumed_digit) implies (result.valid and result.value == value)
            return (false, 0) if position == text.len and not consumed_digit
            return (true, value) if position == text.len
            return (false, 0) if text[position] < ASCII_DIGIT_ZERO or text[position] > ASCII_DIGIT_NINE
            return (false, 0) if negative and value > 0
            return (false, 0) if not negative and value < 0
            return (false, 0) if negative and (
                value < I64_MIN / DECIMAL_RADIX or
                (value == I64_MIN / DECIMAL_RADIX and (text[position] - ASCII_DIGIT_ZERO).i64() > 0 - (I64_MIN % DECIMAL_RADIX))
            )
            return decimal_parse_reference_from(
                text,
                position + 1,
                true,
                value * DECIMAL_RADIX - (text[position] - ASCII_DIGIT_ZERO).i64(),
                true
            ) if negative
            return (false, 0) if value > I64_MAX / DECIMAL_RADIX or (
                value == I64_MAX / DECIMAL_RADIX and
                (text[position] - ASCII_DIGIT_ZERO).i64() > I64_MAX % DECIMAL_RADIX
            )
            return decimal_parse_reference_from(
                text,
                position + 1,
                false,
                value * DECIMAL_RADIX + (text[position] - ASCII_DIGIT_ZERO).i64(),
                true
            )

        ghost def decimal_parse_reference(text: sview) -> (valid: bool, value: i64):
            ensure (text.len <= 0 or text.len.usize().i64() != text.len) implies (not result.valid and result.value == 0)
            ensure (text.len == 1 and text[0] == ASCII_MINUS) implies (not result.valid and result.value == 0)
            return (false, 0) if text.len <= 0 or text.len.usize().i64() != text.len
            return (false, 0) if text.len == 1 and text[0] == ASCII_MINUS
            return decimal_parse_reference_from(text, 1, true, 0, false) if text.len > 0 and text[0] == EasmCheckedDecimal::ASCII_MINUS
            return decimal_parse_reference_from(text, 0, false, 0, false)

        # Parse a signed decimal without ever evaluating an unchecked multiply-add.
        # The negative accumulator path represents I64_MIN without negating it.
        def parse_signed(text: sview) -> (valid: bool, value: i64):
            ensure result.valid == decimal_parse_reference(text).valid
            ensure result.value == decimal_parse_reference(text).value
            ensure not result.valid implies result.value == 0
            ensure (result.valid and text.len > 0 and text[0] == ASCII_MINUS) implies result.value <= 0
            ensure (result.valid and text.len > 0 and text[0] != ASCII_MINUS) implies result.value >= 0
            ensure result.valid implies (
                text.len > 0
                and (text[0] != ASCII_MINUS or text.len > 1)
            )
            ensure result.valid implies (forall digit_index in 0..<text.len:
                (digit_index == 0 and text[digit_index] == ASCII_MINUS)
                or (text[digit_index] >= ASCII_DIGIT_ZERO and text[digit_index] <= ASCII_DIGIT_NINE)
            )
            valid: mutable bool = text.len > 0 and text.len.usize().i64() == text.len
            position: mutable usize = 0
            if valid:
                if text.len > 0 and text[0] == EasmCheckedDecimal::ASCII_MINUS:
                    position <- 1
            negative: bool = position == 1
            if valid and text.len == 1 and negative:
                assert not decimal_parse_reference(text).valid
                assert decimal_parse_reference(text).value == 0
                valid <- false
            value: mutable i64 = 0
            start: usize = position
            if valid:
                assert position < text.len
                assert start < text.len
            assert not negative or position >= 1
            assert not negative or value <= 0
            assert negative or value >= 0
            assert not valid or negative == (text.len > 0 and text[0] == ASCII_MINUS)
            assert not valid or (forall digit_index in 0..<position:
                (negative and digit_index == 0 and text[digit_index] == ASCII_MINUS)
                or (text[digit_index] >= ASCII_DIGIT_ZERO and text[digit_index] <= ASCII_DIGIT_NINE)
            )
            if valid:
                assert decimal_parse_reference_from(text, position, negative, value, position > start).valid == decimal_parse_reference(text).valid
                assert decimal_parse_reference_from(text, position, negative, value, position > start).value == decimal_parse_reference(text).value
            while valid and position < text.len |position, text, value, valid|:
                decreases text.len - position
                invariant (
                    (not valid or position <= text.len) and
                    (not valid or start < text.len) and
                    (not valid or negative == (text.len > 0 and text[0] == ASCII_MINUS)) and
                    (negative implies position >= 1) and
                    (negative implies value <= 0) and
                    (not negative implies value >= 0) and
                    (not valid or decimal_parse_reference_from(text, position, negative, value, position > start).valid == decimal_parse_reference(text).valid) and
                    (not valid or decimal_parse_reference_from(text, position, negative, value, position > start).value == decimal_parse_reference(text).value) and
                    (not valid or (forall digit_index in 0..<position: (negative and digit_index == 0 and text[digit_index] == ASCII_MINUS) or (text[digit_index] >= ASCII_DIGIT_ZERO and text[digit_index] <= ASCII_DIGIT_NINE)))
                )
                byte: u8 = text[position]
                if byte < ASCII_DIGIT_ZERO or byte > ASCII_DIGIT_NINE:
                    assert not decimal_parse_reference(text).valid
                    assert decimal_parse_reference(text).value == 0
                    valid <- false
                    break
                else:
                    digit: i64 = (byte - ASCII_DIGIT_ZERO).i64()
                    if negative:
                        step: (valid: bool, value: i64) = append_negative_digit(value, digit)
                        if not step.valid:
                            assert not decimal_parse_reference(text).valid
                            assert decimal_parse_reference(text).value == 0
                            valid <- false
                            break
                        assert step.valid
                        assert step.value <= 0
                        value <- step.value
                    else:
                        step: (valid: bool, value: i64) = append_positive_digit(value, digit)
                        if not step.valid:
                            assert not decimal_parse_reference(text).valid
                            assert decimal_parse_reference(text).value == 0
                            valid <- false
                            break
                        assert step.valid
                        assert step.value >= 0
                        value <- step.value
                    assert not negative or value <= 0
                    assert negative or value >= 0
                    position <- position + 1
                    assert position <= text.len
                    assert not valid or (forall digit_index in 0..<position:
                        (negative and digit_index == 0 and text[digit_index] == ASCII_MINUS)
                        or (text[digit_index] >= ASCII_DIGIT_ZERO and text[digit_index] <= ASCII_DIGIT_NINE)
                    )
                    assert decimal_parse_reference_from(text, position, negative, value, position > start).valid == decimal_parse_reference(text).valid
                    assert decimal_parse_reference_from(text, position, negative, value, position > start).value == decimal_parse_reference(text).value
            if valid:
                assert position == text.len
                assert negative == (text.len > 0 and text[0] == ASCII_MINUS)
                assert not negative or value <= 0
                assert negative or value >= 0
                assert forall digit_index in 0..<text.len:
                    (negative and digit_index == 0 and text[digit_index] == ASCII_MINUS)
                    or (text[digit_index] >= ASCII_DIGIT_ZERO and text[digit_index] <= ASCII_DIGIT_NINE)
                # The loop invariant relates both recursive results, and the reference
                # fold's exact-end contract fixes its value to this accumulator.
                return (true, value)
            assert not decimal_parse_reference(text).valid
            assert decimal_parse_reference(text).value == 0
            return (false, 0)
