# Stage1 backend — declaring a function's LLVM signature and emitting its body.
# Part of `module Backend` (see codegen.elisa); split out to keep each file short.

extend Backend:
    private:


        # Emit the body of an already-declared function. False = declined.
        # Binds `Self` for an impl member's body (see push_self_binding), then emits it.
        def emit_function_body(declaration: Decl, owner: sview, fn: LLVMValueRef, error_lines: darray[u32]&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            self_bound: usize = push_self_binding(structs, function_line_of(declaration))
            emitted: bool = emit_function_body_bound(declaration, owner, fn, error_lines, fns, structs, generics, runtime, m, ctx, builder)
            pop_type_bindings(structs, self_bound)
            return emitted




        def emit_function_body_bound(declaration: Decl, owner: sview, fn: LLVMValueRef, error_lines: darray[u32]&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            if declaration is Decl.Func(function_name, params, return_type_opt, body, effects, decorators, line):
                structs.decline_line <- 0
                structs.decline_kind <- ""
                # Record the owning module for the whole of this body's emission, so a bare
                # sibling call inside `module M:` can resolve to M's own member. Set on every
                # function, "" included, so it never carries a stale owner from the previous
                # one. See the bare-call resolver in codegen_call.elisa.
                structs.current_owner <- owner
                # From the ANNOTATION, not from `fns`: a generic TEMPLATE has no fns entry
                # (only its instantiations do), and with bindings active the annotation
                # already resolves `T` to this instantiation's concrete type.
                # A MISSING return annotation means `void` — `def zero_buckets[K,T](…):` with
                # no `-> T` is a void procedure (the std dict's zero-fill / place / clear
                # helpers are all written this way). Only a PRESENT but unmodeled annotation
                # declines.
                return_value_type: mutable ValueType = ValueType{kind: TypeKind.Void, bits: 0}
                if return_type_opt is declared_return:
                    return_value_type <- annotation_value_type(declared_return, structs)
                false return if return_value_type.kind == TypeKind.Unmodeled
                # `ensure` clauses and narrowing proofs are per-FUNCTION: drop the previous
                # function's, or they would apply to a body that never asserted them.
                while structs.pending_ensures.count > 0 |structs|:
                    _ = structs.pending_ensures.pop()
                clear_narrowings(structs)
                entry: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, fn, "entry")
                LLVMPositionBuilderAtEnd(builder, entry)

                # This function's AUTO REGION.  The bootstrap path keeps the established
                # zeroed per-function carrier while the stage1 region-inference pass is still
                # being brought to parity with stage0; removing it here makes the self-hosted
                # compiler lose the ambient arena used by container-building helpers.
                local_runtime: mutable Runtime = copied_runtime(runtime)
                local_runtime.function_line <- line.line
                local_runtime.trace_function_id <- trace_identity_id_for_function(owner, function_name, params.count, line.line, fn)
                local_runtime.disjoint_function_name <- function_name
                local_runtime.disjoint_function_mask <- disjoint_function_mask(function_name, structs)
                local_runtime.fast_math <- false
                for decorator in decorators |local_runtime|:
                    local_runtime.fast_math <- true if decorator.name == "fast_math"
                if local_runtime.trace_enabled:
                    trace_name_storage: mutable darray[u8] = []
                    local_runtime.trace_name <- LLVMBuildGlobalStringPtr(builder, sview_to_cstr(function_name, trace_name_storage), "trace.function")
                    _ = LLVMBuildCall2(builder, local_runtime.trace_fault_install_type, local_runtime.trace_fault_install, null, 0, "")
                    entry_trace: LLVMValueRef = declare_or_get_named(m, "elisa_trace_function_entry_id", local_runtime.trace_record_id_type)
                    entry_arguments: mutable darray[LLVMValueRef] = [local_runtime.trace_name, LLVMConstInt(LLVMInt32TypeInContext(ctx), line.line.u64(), 0), LLVMConstInt(LLVMInt64TypeInContext(ctx), local_runtime.trace_function_id, 0)]
                    entry_arguments_pointer: void& = (&entry_arguments[0]).cast[void&] can Unsafe.PointerCast
                    _ = LLVMBuildCall2(builder, local_runtime.trace_record_id_type, entry_trace, entry_arguments_pointer, 3, "")
                # A function taking a growable container by reference grows the CALLER's
                # region, handed over as the implicit trailing parameter, rather than its
                # own: the container's backing outlives this call, so allocating it from a
                # region freed at return would hand the caller freed memory.
                # An error fn's out-param is LLVM param 0; declared params (and the arena)
                # shift past it by one. Large aggregate returns use the same leading slot
                # shape, but their slot is the sret destination and the function returns void.
                fn_is_error: bool = line_is_error_returning(error_lines, function_line_of(declaration))
                error_param_offset: u32 = 1 if fn_is_error else 0
                sret_return: bool = not fn_is_error and value_type_uses_sret(return_value_type, structs, ctx)
                leading_param_offset: u32 = 1 if fn_is_error or sret_return else 0
                if fn_is_error:
                    local_runtime.error_out <- LLVMGetParam(fn, 0)
                    local_runtime.in_error_fn <- true
                    local_runtime.error_fn_line <- function_line_of(declaration)
                    local_runtime.error_fn_family <- resolved_error_family(line_error_set_name(structs.error_fn_lines, structs.error_fn_set_names, function_line_of(declaration)), structs)
                # The body's declared return type, so an expression emitter that must emit a
                # `return` from inside an expression (a terminating `catch` arm) has a type to
                # emit the returned value at.
                local_runtime.fn_return_type <- copied_type(return_value_type)
                local_runtime.main_returns_status <- owner == "" and function_name == "main" and return_value_type.kind == TypeKind.Void and not fn_is_error and not sret_return
                # The hidden-parameter ABI is whatever the DECLARATION built the LLVM function
                # type with — read it back rather than recomputing it.
                #
                # Recomputing was wrong twice over: the body asked
                # `function_needs_store_for_declaration` where the declaration asked
                # `function_needs_ast_store or force_ast_store or params_include_packed_ast`,
                # and `signature_needs_arena` is order-dependent (a `dict[K, T]&` parameter only
                # counts as growable once DynDict[K, T] is registered, and declaration and body
                # run in different registration states). Either disagreement shifts every
                # trailing parameter: the body then reads its arena or its AoS store out of a
                # register the caller never set, and the first packed-AST access dereferences
                # garbage. That is what crashed the stage1-built analyzer in
                # Semantic.check_expression_mutating_call.
                #
                # A missing row can only mean this body has no declaration, which cannot happen
                # (declare_module_functions runs first) — recompute there so the fallback is
                # still defined rather than silently ABI-less.
                declared_arena_count: i64 = function_arena_count_for_declaration(declaration, fns)
                # ...except a generic INSTANTIATION, which has no row (templates are never
                # declared into fns). Its signature was built by instantiate_generic with
                # this same predicate over the same bindings, so recomputing here agrees.
                ast_store_needed: bool = function_needs_store_for_declaration(declaration, fns) if declared_arena_count >= 0 else declaration_signature_needs_store(params, return_value_type, structs)
                signature_arena_slots: mutable usize = signature_arena_count(params, return_value_type, body, function_line_of(declaration), structs)
                arena_count: mutable usize = frontend_arena_count(owner, function_name, signature_arena_slots, ast_store_needed)
                arena_count <- declared_arena_count.usize() if declared_arena_count >= 0
                threads_arena: bool = arena_count > 0
                function_region_row: i64 = function_index_of_line(fns, owner, function_name, function_line_of(declaration))
                # A hidden arena parameter is an ABI fact. For functions without one,
                # allocate the lazy per-function carrier only when the body can actually
                # construct or grow region-backed data. Scalar-only bodies must not acquire
                # an `arena_free` dependency just because the old bootstrap emitter wrapped
                # every function uniformly.
                needs_auto_region: mutable bool = auto_region_statements_need_arena(body, fns, structs, generics)
                local_packed_store_root: i64 = auto_region_statements_packed_store_root(body, fns, structs)
                # A hidden AST store normally arrives with its own arena in the store
                # value. Store-aware helpers therefore do not acquire a carrier merely
                # because their ABI carries a store; actual packed constructors and the
                # synthetic compiler-main root are handled by the body scan below.
                # The hidden store precedes the region slots in the stage0 ABI. Region slots are
                # caller-owned, but the body may still need a separate function-local scratch
                # arena for temporaries such as the `digits` array in append_decimal.
                caller_arena_parameter_index: u32 = params.count.u32() + leading_param_offset + (1 if ast_store_needed else 0)
                if threads_arena:
                    local_runtime.caller_arenas <- []
                    for arena_index in 0..<arena_count |local_runtime, fn, caller_arena_parameter_index|:
                        local_runtime.caller_arenas <- local_runtime.caller_arenas.push(LLVMGetParam(fn, caller_arena_parameter_index + arena_index.u32()))
                    local_runtime.caller_arena <- local_runtime.caller_arenas[0]
                # `arena_free` must NOT own an auto region. The epilogue releases the region by
                # CALLING arena_free, so arena_free would call itself unconditionally on every
                # exit path — an infinite recursion that exhausts the stack and then faults in
                # the PROLOGUE, which is why the crash reads as `arena_free + 8` storing to
                # `[sp, #0x10]` rather than as a bad pointer.
                #
                # Invisible in a program: the Elisa body is dead there because calls bind to
                # elisacore_runtime.o's C copy. It is exactly what made the stage1-built runtime
                # object segfault (exit 139) once that body became the live one.
                #
                # arena_free is the unique self-referential case — every other function's
                # epilogue calls a DIFFERENT function, so it terminates — and it allocates
                # nothing, so it has no use for a region. Clearing `owns_arena` suppresses both
                # the regions-stack unwind and emit_region_free, which are separate paths.
                # A threaded region is an ownership fact, not only a growth hint. Aggregate
                # temporaries may be adopted into caller-owned tables after construction, so
                # allocating them in a callee scratch arena creates latent use-after-free even
                # when the final push itself selects the right parameter arena. Use scratch
                # storage only when the signature has no caller-owned region at all.
                if needs_auto_region and not threads_arena:
                    arena_type: LLVMTypeRef = arena_llvm_type(ctx)
                    arena_slot: LLVMValueRef = LLVMBuildAlloca(builder, arena_type, "auto.region")
                    _ = LLVMBuildStore(builder, LLVMConstNull(arena_type), arena_slot)
                    strategy_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, arena_type, arena_slot, 3, "region.strategy")
                    _ = LLVMBuildStore(builder, LLVMConstInt(LLVMInt64TypeInContext(ctx), 0, 0), strategy_pointer)
                    local_runtime.arena <- arena_slot
                    local_runtime.owns_arena <- true
                    # Keep arena_free from taking ownership of its own carrier.
                    local_runtime.owns_arena <- false if function_name == "arena_free" and owner == ""
                elif threads_arena:
                    # There is no local allocation to reclaim. Container growth through a
                    # by-reference parameter still uses the caller-owned region.
                    local_runtime.arena <- local_runtime.caller_arena
                    local_runtime.owns_arena <- false
                else:
                    # No body operation should consume this placeholder. It is a correctly
                    # typed null pointer so a declined/unmodeled path cannot accidentally
                    # turn a zeroed LLVM handle into an arbitrary pointer.
                    local_runtime.arena <- LLVMConstNull(LLVMPointerTypeInContext(ctx, 0))
                    local_runtime.owns_arena <- false
                if ast_store_needed:
                    store_parameter_index: u32 = params.count.u32() + leading_param_offset
                    local_runtime.active_store <- LLVMGetParam(fn, store_parameter_index)
                    # The AST hierarchy is a single compiler-internal store rooted at
                    # `Node`. Use the actual registered root index so constructors and
                    # matches in Parser/Backend bodies can validate the hidden store ABI.
                    # The store belongs to the hierarchy this signature actually mentions,
                    # not to a hierarchy named "Node". For the compiler's own AST the two
                    # are the same; for a user hierarchy (a widget tree) the root is its own
                    # declaration, and hardcoding Node handed the body the wrong store index
                    # so every match over the value declined.
                    local_runtime.active_store_enum <- body_store_root_index(declaration, fns, structs)
                    local_runtime.active_store_is_block <- true
                elif local_packed_store_root >= 0:
                    # User packed/recursive enums use an implicit store owned by the
                    # function's inferred region. Only the compiler's sealed AST hierarchy
                    # receives the hidden store parameter above; treating every packed enum
                    # as AST would force helper callers to carry a store ABI that stage0 does
                    # not have. The store is created once at function entry and reused by all
                    # bare `new Enum.V(...)` constructions and matches in this region.
                    local_packed_row_bytes: i64 = packed_row_bytes(structs, local_packed_store_root)
                    local_packed_state_args: mutable darray[LLVMValueRef] = [local_runtime.arena, LLVMConstInt(LLVMInt64TypeInContext(ctx), local_packed_row_bytes.u64(), 0)]
                    # Sized by the COMMON count, not the side-table word count: counting
                    # only side-table commons (8713592c) broke the gen3 fixpoint, because
                    # the compiler's own stores keep every common in the side chunk whatever
                    # the storage mode says. An all-inline user hierarchy therefore carries
                    # an unused side word per common; memory only, never read.
                    local_packed_side_words: u32 = packed_aos_common_count(structs, local_packed_store_root) if local_runtime.packed_mode == 2 else 0
                    local_packed_state_fn: mutable LLVMValueRef = local_runtime.packed_state_new
                    local_packed_state_type: mutable LLVMTypeRef = local_runtime.packed_state_new_type
                    if local_packed_side_words > 0:
                        local_packed_state_args.push(LLVMConstInt(LLVMInt64TypeInContext(ctx), local_packed_side_words.u64(), 0))
                        local_packed_state_fn <- local_runtime.packed_state_new_side
                        local_packed_state_type <- local_runtime.packed_state_new_side_type
                    local_packed_state_pointer: void& = (&local_packed_state_args[0]).cast[void&] can Unsafe.PointerCast
                    local_packed_state: LLVMValueRef = LLVMBuildCall2(builder, local_packed_state_type, local_packed_state_fn, local_packed_state_pointer, local_packed_state_args.count.u32(), "local.packed.store.state")
                    local_packed_store_type: ValueType = ValueType{kind: TypeKind.PackedStore, bits: local_packed_store_root.u32()}
                    local_packed_store_llvm: LLVMTypeRef = llvm_type_of(local_packed_store_type, structs, ctx)
                    local_packed_with_arena: LLVMValueRef = LLVMBuildInsertValue(builder, LLVMGetUndef(local_packed_store_llvm), local_runtime.arena, 0, "local.packed.store.arena")
                    local_packed_with_row: LLVMValueRef = LLVMBuildInsertValue(builder, local_packed_with_arena, LLVMConstInt(LLVMInt64TypeInContext(ctx), local_packed_row_bytes.u64(), 0), 1, "local.packed.store.row_bytes")
                    local_runtime.active_store <- LLVMBuildInsertValue(builder, local_packed_with_row, local_packed_state, 2, "local.packed.store")
                    local_runtime.active_store_enum <- local_packed_store_root
                    local_runtime.active_store_is_block <- true
                # Stage0's executable entry point is deliberately store-free in its public
                # signature, but it creates the compiler AST store before calling the
                # frontend.  The frontend wrappers receive that value as their hidden store
                # context.  Without this entry initialization, stage1 passes a null store
                # into `frontend_parser_parse_file`; parsing can appear to work until the
                # first nested AST handle is resolved, at which point the AoS index is
                # interpreted against an uninitialized store and eventually goes out of
                # range.
                # ...only when `Node` is the compiler's own AST ROOT (the reserved,
                # variant-less header). A program that declares its own `packed enum Node:`
                # got a free active store here, so its constructor emitted where stage0
                # rejects it ("requires an active in Node.Store: scope").
                # ...for the program's sealed hierarchy root, whichever it is. Keyed on the
                # reserved variant-less root ROW rather than the name "Node" so a user
                # hierarchy's `main` creates the one store its whole tree shares.
                entry_root_index: i64 = program_hierarchy_root_index(structs)
                if owner == "" and function_name == "main" and needs_auto_region and packed_is_ast_root_row(structs, entry_root_index):
                    root_index: i64 = entry_root_index
                    false return if root_index < 0
                    row_bytes: i64 = packed_row_bytes(structs, root_index)
                    state_args: mutable darray[LLVMValueRef] = [local_runtime.arena, LLVMConstInt(LLVMInt64TypeInContext(ctx), row_bytes.u64(), 0)]
                    side_words: u32 = packed_aos_common_count(structs, root_index) if local_runtime.packed_mode == 2 else 0
                    state_fn: mutable LLVMValueRef = local_runtime.packed_state_new
                    state_type: mutable LLVMTypeRef = local_runtime.packed_state_new_type
                    if side_words > 0:
                        state_args.push(LLVMConstInt(LLVMInt64TypeInContext(ctx), side_words.u64(), 0))
                        state_fn <- local_runtime.packed_state_new_side
                        state_type <- local_runtime.packed_state_new_side_type
                    state_pointer: void& = (&state_args[0]).cast[void&] can Unsafe.PointerCast
                    state: LLVMValueRef = LLVMBuildCall2(builder, state_type, state_fn, state_pointer, state_args.count.u32(), "main.packed.store.state")
                    store_type: ValueType = ValueType{kind: TypeKind.PackedStore, bits: root_index.u32()}
                    store_llvm: LLVMTypeRef = llvm_type_of(store_type, structs, ctx)
                    with_arena: LLVMValueRef = LLVMBuildInsertValue(builder, LLVMGetUndef(store_llvm), local_runtime.arena, 0, "main.packed.store.arena")
                    with_row: LLVMValueRef = LLVMBuildInsertValue(builder, with_arena, LLVMConstInt(LLVMInt64TypeInContext(ctx), row_bytes.u64(), 0), 1, "main.packed.store.row_bytes")
                    local_runtime.active_store <- LLVMBuildInsertValue(builder, with_row, state, 2, "main.packed.store")
                    local_runtime.active_store_enum <- root_index

                # Each parameter gets a slot too, so a parameter reads and assigns exactly
                # like a local and emit_expression's Ident path needs no param special
                # case. mem2reg removes the copy.
                local_scope: mutable Scope = Scope{names: [], slots: [], types: [], pool_names: [], group_names: [], deferred: []}
                loops: mutable LoopStack = LoopStack{exits: [], continues: [], defer_marks: []}
                # The function's auto region is the outermost OWNED region — unless the arena
                # is threaded in, in which case it is the CALLER's and nothing here frees it,
                # so the stack stays empty.
                regions: mutable RegionStack = RegionStack{arenas: []}
                regions.arenas.push(local_runtime.arena) if local_runtime.owns_arena
                parameter_index: mutable u32 = leading_param_offset
                parameter_arena_index: mutable i64 = 0
                for parameter in params |local_scope, parameter_index, fn, ctx, builder|:
                    parameter_type: ValueType = parameter_value_type(parameter.type_expression, structs)
                    source_parameter_index: u32 = parameter_index - leading_param_offset
                    name_storage: mutable darray[u8] = []
                    slot: LLVMValueRef = LLVMBuildAlloca(builder, llvm_type_of(parameter_type, structs, ctx), sview_to_cstr(parameter.name, name_storage))
                    parameter_value: mutable LLVMValueRef = LLVMGetParam(fn, parameter_index)
                    if value_type_uses_indirect_aggregate(parameter_type, structs, ctx):
                        parameter_value <- LLVMBuildLoad2(builder, llvm_type_of(parameter_type, structs, ctx), parameter_value, "byval.param")
                    _ = LLVMBuildStore(builder, parameter_value, slot)
                    declare_local(local_scope, parameter.name, slot, parameter_type)
                    # A BY-VALUE parameter carries the obligation its caller handed over:
                    # `consume(move t)` suppresses the caller's drop, so the callee owes the
                    # one release. Registering only locals leaked every moved-in value.
                    # register_drop_cleanup is a no-op for anything but a struct with a
                    # `__drop__` hook, so references and scalars are unaffected. The
                    # parameter already has its own alloca above, so the drop zeroes this
                    # frame's slot and never reaches back into the caller's.
                    #
                    # EXCEPT inside a destructor: `__drop__` IS its receiver's death, so
                    # arming a cleanup for `self` there recurses until the stack dies
                    # (stage0's isOwnDropReceiver guard). A destructor takes only its
                    # receiver, so skipping the whole body is the same rule.
                    register_drop_cleanup(parameter.name, parameter_type, slot, line.line, local_scope, structs, ctx, builder) if function_name != "__drop__"
                    has_parameter_region: bool = function_region_row >= 0 and fns.param_start[function_region_row.usize()] + source_parameter_index.usize() < fns.param_region_slots.count and fns.param_region_slots[fns.param_start[function_region_row.usize()] + source_parameter_index.usize()]
                    if has_parameter_region:
                        mark_last_local_parameter_arena(local_scope, parameter_arena_index)
                        parameter_arena_index <- parameter_arena_index + 1
                    if local_runtime.disjoint_function_mask != 0 and disjoint_numeric_darray_ref(parameter.type_expression, structs):
                        bit: mutable u64 = 1
                        for _ in 0..<source_parameter_index |bit|:
                            bit <- bit * 2
                        if (local_runtime.disjoint_function_mask / bit) % 2 == 1:
                            local_runtime.disjoint_param_slots <- local_runtime.disjoint_param_slots.push(slot)
                            local_runtime.disjoint_param_indices <- local_runtime.disjoint_param_indices.push(source_parameter_index)
                    # DWARF argument numbers start at 1, and count DECLARED parameters --
                    # the error out-param and the threaded arena are ABI additions the
                    # source never named, so they are not numbered here.
                    declare_debug_variable(parameter.name, slot, parameter_type, parameter_index + 1 - leading_param_offset, line.line, fn, local_runtime, structs, ctx, builder)
                    parameter_index <- parameter_index + 1

                body_status: mutable EmitStatus = EmitStatus.Open
                body_status <- emit_statements(body, return_value_type, local_scope, loops, regions, fns, structs, generics, local_runtime, m, ctx, builder)
                false return if body_status == EmitStatus.Declined
                # A `-> void` function may legitimately run off the end: close it with
                # `ret void` (and free the region first, like any other return path). A
                # value-returning function that falls through is NOT modeled — rather than
                # invent a return value, decline; LLVM would reject the open block anyway.
                if body_status == EmitStatus.Open:
                    false return if return_value_type.kind != TypeKind.Void
                    # `defer` runs on EVERY exit, and falling off the end of a `-> void`
                    # function is one. Only the explicit-`return` paths unwound them, so a
                    # void function with no trailing `return` silently dropped every deferred
                    # block: `defer block: note(1)` … `note(3)` answered 3 where stage0
                    # answers 31. Found by adversarial differential testing; nothing in the
                    # compiler's own sources hits it, because they all return explicitly.
                    false return if not emit_deferred_actions(local_scope, false, fns, structs, generics, local_runtime, m, ctx, builder)
                    emit_region_free(local_runtime, builder)
                    # A `void error[E]` fn that runs off the end succeeds — return the 0 code.
                    if fn_is_error or local_runtime.main_returns_status:
                        _ = LLVMBuildRet(builder, LLVMConstInt(LLVMInt32TypeInContext(ctx), 0, 0))
                    else:
                        _ = LLVMBuildRetVoid(builder)
                    instrument_trace_function_exits(fn, function_name, function_line_of(declaration), local_runtime, m, ctx, builder)
                    return true
                instrument_trace_function_exits(fn, function_name, function_line_of(declaration), local_runtime, m, ctx, builder)
                return true
            return false

include "./codegen_declare_decorators.elisa"
include "./codegen_declare_signature.elisa"
include "./codegen_declare_extern.elisa"
include "./codegen_c_abi.elisa"
include "./codegen_export_aliases.elisa"
