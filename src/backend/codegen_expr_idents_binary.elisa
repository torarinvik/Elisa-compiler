# Stage1 backend — `emit_expression`: string literals, identifiers, parenthesised/unary forms and the leading binary operators.
# A group of the expression emitter's branches, called from codegen_expression.elisa.
# `handled` is set TRUE on entry and cleared only if no branch here matched, so a
# branch that DECLINES (returns null) still stops the dispatch — exactly as it did
# when every branch shared one function body.

extend Backend:
    private:
        def emit_expression_idents_binary(expression: Expr, expected: ValueType, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef, handled: mutable bool&) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            handled <- true
            # `Module::NAME` where NAME is a CONST. Constants are keyed by (owner, name),
            # so the qualifier names the owner to look in -- and it has to, because the
            # enclosing module now wins a bare lookup: re-dispatching `PySet::MINSIZE` as a
            # bare `MINSIZE` from inside PyPoint would find PyPoint's own if it had one.
            #
            # Without this a module could not read another module's constant at all: the
            # Scope form had no const branch, fell through every arm, and DECLINED -- which
            # takes the whole unit with it. stage0 resolves it. Found because PyPoint reads
            # PySet's MINSIZE/EMPTY/LINEAR_PROBES, and every function of PyPoint that
            # touched one declined while the ones that did not compiled fine.
            #
            # Rewritten to the bare Ident and re-dispatched rather than duplicating the
            # const emission, so cstr/float/array consts keep behaving identically.
            if expression is Expr.Scope(scope_base, scope_const_name, scope_const_line):
                if scope_base is Expr.Ident(scope_module_name, scope_module_line):
                    if lookup_type(local_scope, scope_const_name).kind == TypeKind.Unmodeled:
                        scoped_const_index: mutable i64 = const_index_of_in(structs, scope_module_name, scope_const_name)
                        if scoped_const_index < 0:
                            # Not that module's own: a qualifier may still name a const that
                            # lives at the top level, which is what it resolved to before
                            # consts had owners at all.
                            scoped_const_index <- const_index_of(structs, scope_const_name)
                        # A module-qualified GLOBAL takes the same route. Globals are
                        # registered under their BARE name (codegen_struct_reg pushes
                        # const_name with no owner at all), so the rewrite that already
                        # resolves a const resolves one too.
                        #
                        # Without this `M::LIMIT` compiled while `M::counter` declined as a
                        # "field expression" -- an asymmetry with no reason behind it, and the
                        # one that forced a module-owned backend to expose public accessors
                        # just to read its own state from outside.
                        if scoped_const_index < 0 and mutable_global_index_of(structs, scope_const_name) >= 0:
                            scoped_global_handled: mutable bool = false
                            scoped_global_saved_owner: sview = structs.current_owner
                            structs.current_owner <- scope_module_name
                            scoped_global_value: LLVMValueRef? = emit_expression_idents_binary((Expr.Ident(scope_const_name, scope_const_line)), expected, local_scope, fns, structs, generics, runtime, m, ctx, builder, &scoped_global_handled)
                            structs.current_owner <- scoped_global_saved_owner
                            return scoped_global_value
                        if scoped_const_index >= 0 and structs.const_resolved[scoped_const_index.usize()]:
                            scoped_handled: mutable bool = false
                            # Emit the bare form AS IF inside the named module, which is what
                            # the qualifier means. Restored immediately: this is the enclosing
                            # module for every other resolution in the function being built.
                            scoped_saved_owner: sview = structs.current_owner
                            structs.current_owner <- scope_module_name
                            scoped_value: LLVMValueRef? = emit_expression_idents_binary((Expr.Ident(scope_const_name, scope_const_line)), expected, local_scope, fns, structs, generics, runtime, m, ctx, builder, &scoped_handled)
                            structs.current_owner <- scoped_saved_owner
                            return scoped_value
            if expression is Expr.Ident(ident_name, ident_line):
                ident_type: ValueType = lookup_type(local_scope, ident_name)
                # A bare function NAME used where a `fn(…)` value is expected passes its RAW
                # pointer `@name` (bit0 clear = not a closure) — how `apply(dbl, …)` hands over
                # `dbl`. Checked before the local/const paths, but only for the Fn expectation,
                # so an ordinary local of the same name still shadows.
                if expected.kind == TypeKind.Fn and ident_type.kind == TypeKind.Unmodeled:
                    fn_value_index: i64 = function_index_of(fns, "", ident_name)
                    fns.handles[fn_value_index.usize()] return if fn_value_index >= 0
                # A GLOBAL const is INLINED at its use site, exactly as stage0 does: no
                # global, no load, just the folded value at the const's own type. Checked
                # only when the name is not a local, so a local still shadows it.
                if ident_type.kind == TypeKind.Unmodeled:
                    # A project may contain both `extern T x` from a header and
                    # the real `T x` definition from another translation unit.
                    # The definition is the canonical ABI/type source; looking
                    # at the extern row first makes incomplete arrays and other
                    # declaration-only shapes shadow the actual global.
                    mutable_global_index: i64 = mutable_global_index_of(structs, ident_name)
                    if mutable_global_index >= 0:
                        mutable_global_type: ValueType = copied_type(structs.mutable_global_types[mutable_global_index.usize()])
                        if expected.kind == TypeKind.Ref:
                            mutable_global_target: ValueType = ref_target_of(expected, structs)
                            if mutable_global_target.kind == mutable_global_type.kind and mutable_global_target.bits == mutable_global_type.bits:
                                mutable_global_offsets: mutable darray[LLVMValueRef] = [LLVMConstInt(LLVMInt64TypeInContext(ctx), 0, 0)]
                                mutable_global_offsets_pointer: void& = (&mutable_global_offsets[0]).cast[void&] can Unsafe.PointerCast
                                return LLVMBuildGEP2(builder, LLVMInt8TypeInContext(ctx), structs.mutable_global_handles[mutable_global_index.usize()], mutable_global_offsets_pointer, 1, "global.ref")
                        mutable_global_loaded: LLVMValueRef = LLVMBuildLoad2(builder, llvm_type_of(mutable_global_type, structs, ctx), structs.mutable_global_handles[mutable_global_index.usize()], "global")
                        if expected.kind != TypeKind.Unmodeled and is_numeric_type(mutable_global_type) and is_numeric_type(expected) and (mutable_global_type.kind != expected.kind or mutable_global_type.bits != expected.bits):
                            if emit_conversion(mutable_global_loaded, mutable_global_type, expected, structs, ctx, builder) is mutable_global_converted:
                                return mutable_global_converted
                        return mutable_global_loaded
                    extern_global_index: i64 = extern_global_index_of(structs, ident_name)
                    if extern_global_index >= 0:
                        extern_global_type: ValueType = copied_type(structs.extern_global_types[extern_global_index.usize()])
                        if expected.kind == TypeKind.Ref:
                            extern_global_target: ValueType = ref_target_of(expected, structs)
                            if extern_global_target.kind == extern_global_type.kind and extern_global_target.bits == extern_global_type.bits:
                                extern_global_offsets: mutable darray[LLVMValueRef] = [LLVMConstInt(LLVMInt64TypeInContext(ctx), 0, 0)]
                                extern_global_offsets_pointer: void& = (&extern_global_offsets[0]).cast[void&] can Unsafe.PointerCast
                                return LLVMBuildGEP2(builder, LLVMInt8TypeInContext(ctx), structs.extern_global_handles[extern_global_index.usize()], extern_global_offsets_pointer, 1, "extern.global.ref")
                        extern_global_loaded: LLVMValueRef = LLVMBuildLoad2(builder, llvm_type_of(extern_global_type, structs, ctx), structs.extern_global_handles[extern_global_index.usize()], "extern.global")
                        if expected.kind != TypeKind.Unmodeled and is_numeric_type(extern_global_type) and is_numeric_type(expected) and (extern_global_type.kind != expected.kind or extern_global_type.bits != expected.bits):
                            if emit_conversion(extern_global_loaded, extern_global_type, expected, structs, ctx, builder) is extern_global_converted:
                                return extern_global_converted
                        return extern_global_loaded
                    const_index: i64 = const_index_of(structs, ident_name)
                    if const_index >= 0 and structs.const_resolved[const_index.usize()]:
                        const_type: ValueType = copied_type(structs.const_types[const_index.usize()])
                        if const_type.kind == TypeKind.Array or const_type.kind == TypeKind.Struct:
                            if structs.const_global_ok[const_index.usize()]:
                                return LLVMBuildLoad2(builder, llvm_type_of(const_type, structs, ctx), structs.const_globals[const_index.usize()], "global.const")
                            null return if ident_type.kind == TypeKind.Unmodeled
                        # A CSTR const materializes a global string and yields a pointer to
                        # it -- byte for byte what an inline literal at this site emits.
                        if const_type.kind == TypeKind.CStr:
                            null return if structs.const_cstr_text[const_index.usize()] == ""
                            const_cstr_storage: mutable darray[u8] = []
                            const_cstr_pointer: LLVMValueRef = LLVMBuildGlobalStringPtr(builder, decoded_literal_cstr(structs.const_cstr_text[const_index.usize()], const_cstr_storage), "global.const.cstr")
                            # A cstr const is a pointer in its own type, but a use in an
                            # sview context needs the same borrowed `{ptr, decoded_len}`
                            # aggregate emitted for an inline string literal. Returning only
                            # the pointer here left the length field undefined, so a global
                            # cstr passed to an `sview` parameter could report an arbitrary
                            # length or run past its terminator.
                            if expected.kind == TypeKind.SView:
                                const_cstr_sview_type: LLVMTypeRef = llvm_type_of(expected, structs, ctx)
                                const_cstr_sview_undef: LLVMValueRef = LLVMGetUndef(const_cstr_sview_type)
                                const_cstr_sview_with_pointer: LLVMValueRef = LLVMBuildInsertValue(builder, const_cstr_sview_undef, const_cstr_pointer, 0, "global.const.sview.ptr")
                                const_cstr_decoded_length: usize = const_cstr_storage.count - 1.usize()
                                const_cstr_sview_length: LLVMValueRef = LLVMConstInt(LLVMInt64TypeInContext(ctx), const_cstr_decoded_length.u64(), 0)
                                return LLVMBuildInsertValue(builder, const_cstr_sview_with_pointer, const_cstr_sview_length, 1, "global.const.sview.len")
                            return const_cstr_pointer
                        # A FLOAT const inlines its source text via LLVMConstRealOfString (its
                        # value never fits/parses as an i64).
                        if const_type.kind == TypeKind.Float:
                            # An EXPRESSION initializer carries a folded value rather than
                            # text; a LITERAL one carries text. Neither is a licence to emit
                            # ConstRealOfString("") -- that reads back as 0.0 and is how
                            # `const D: f64 = W - S` silently became zero.
                            if structs.const_float_ok[const_index.usize()]:
                                return LLVMConstReal(llvm_type_of(const_type, structs, ctx), structs.const_float_values[const_index.usize()])
                            null return if structs.const_float_text[const_index.usize()] == ""
                            const_float_storage: mutable darray[u8] = []
                            return LLVMConstRealOfString(llvm_type_of(const_type, structs, ctx), sview_to_cstr(structs.const_float_text[const_index.usize()], const_float_storage))
                        # A bool const is a real i1; its folded value (0/1) inlines like an int.
                        null return if not is_integer_type(const_type) and const_type.kind != TypeKind.Bool
                        return LLVMConstInt(llvm_type_of(const_type, structs, ctx), structs.const_values[const_index.usize()].u64(), 0)
                    # A CONST-GENERIC param used as a VALUE (`vec.len < N` in InlineVec[T, N]'s
                    # body): fold N to its bound value and inline the integer, exactly as a global
                    # const is inlined. fold_const_expr reads the ConstUsize binding; a plain
                    # unbound name still declines (fold_ok stays false).
                    cg_fold_ok: mutable bool = true
                    cg_value: i64 = fold_const_expr(expression, structs, cg_fold_ok)
                    if cg_fold_ok:
                        cg_target: LLVMTypeRef = llvm_type_of(expected, structs, ctx) if is_integer_type(expected) else LLVMInt64TypeInContext(ctx)
                        return LLVMConstInt(cg_target, cg_value.u64(), 0)
                null return if ident_type.kind == TypeKind.Unmodeled
                if lookup_slot(local_scope, ident_name) is slot:
                    # A REF-typed local used in a VALUE context auto-DEREFERENCES: the slot
                    # holds a pointer, so read the pointer out and then load the pointee.
                    # This is how `if d.get(k) is a: total <- total + a` reads through the
                    # `mutable T&` binding (stage0: `%a = load ptr, ...; load i64, ptr %a`).
                    # Only when `expected` is a concrete NON-ref value type — otherwise the
                    # ref itself is wanted (passed on, or the context is unknown).
                    if ident_type.kind == TypeKind.Ref and expected.kind != TypeKind.Ref and expected.kind != TypeKind.Unmodeled:
                        ref_target: ValueType = ref_target_of(ident_type, structs)
                        if ref_target.kind == expected.kind and ref_target.bits == expected.bits:
                            ref_pointer: LLVMValueRef = LLVMBuildLoad2(builder, LLVMPointerTypeInContext(ctx, 0), slot, "ref.ptr")
                            return LLVMBuildLoad2(builder, llvm_type_of(ref_target, structs, ctx), ref_pointer, "ref.value")
                        # C expressions routinely read through a pointer into a wider or
                        # narrower scalar destination (`i32 *p` assigned to `i64`, or a
                        # `double *` assigned to an integer field).  The old path only
                        # accepted an exact target type, so the otherwise ordinary load was
                        # reported as an unmodeled expression.  Load the pointee once and use
                        # the same numeric conversion used by calls and binary operands.
                        if is_numeric_type(ref_target) and is_numeric_type(expected):
                            ref_pointer: LLVMValueRef = LLVMBuildLoad2(builder, LLVMPointerTypeInContext(ctx, 0), slot, "ref.ptr")
                            ref_loaded: LLVMValueRef = LLVMBuildLoad2(builder, llvm_type_of(ref_target, structs, ctx), ref_pointer, "ref.value")
                            if emit_conversion(ref_loaded, ref_target, expected, structs, ctx, builder) is ref_converted:
                                return ref_converted
                    # An OPTIONAL-REF local used where its ref PAYLOAD is expected UNWRAPS it:
                    # extract the payload pointer (field 1 of `{i1, ptr}`). The std does this
                    # right after `assert opt != null` (`items: Bucket& = m.items`); presence is
                    # the frontend's proof, not re-checked here.
                    if ident_type.kind == TypeKind.Optional and expected.kind == TypeKind.Ref:
                        optional_ref_payload: ValueType = optional_payload_of(ident_type, structs)
                        if optional_ref_payload.kind == TypeKind.Ref:
                            optional_ref_llvm: LLVMTypeRef = llvm_type_of(ident_type, structs, ctx)
                            optional_ref_loaded: LLVMValueRef = LLVMBuildLoad2(builder, optional_ref_llvm, slot, "unwrap.opt")
                            return optional_payload_value_of(optional_ref_loaded, ident_type, structs, ctx, builder)
                    # A flow-proven optional function value uses the pointer niche: loading the
                    # optional already yields the callable pointer, so unwrapping is representation-free.
                    if ident_type.kind == TypeKind.Optional and expected.kind == TypeKind.Fn:
                        optional_fn_payload: ValueType = optional_payload_of(ident_type, structs)
                        if optional_fn_payload.kind == TypeKind.Fn:
                            return LLVMBuildLoad2(builder, llvm_type_of(ident_type, structs, ctx), slot, "unwrap.opt.fn")
                    # A proven-present optional packed AST handle is likewise passed as its
                    # bare i32 store index when a recursive packed payload expects `Expr`.
                    if ident_type.kind == TypeKind.Optional and expected.kind == TypeKind.PackedEnum:
                        optional_packed_payload: ValueType = optional_payload_of(ident_type, structs)
                        if optional_packed_payload.kind == TypeKind.PackedEnum and optional_packed_payload.bits == expected.bits:
                            optional_packed_value: LLVMValueRef = LLVMBuildLoad2(builder, llvm_type_of(ident_type, structs, ctx), slot, "optional.packed.value")
                            return optional_payload_value_of(optional_packed_value, ident_type, structs, ctx, builder)
                    # A local passed where a REFERENCE is wanted: hand over its ADDRESS.
                    # Locals are already allocas, so `&local` IS the slot — exactly what
                    # stage0 emits (`call void @bump(ptr %x)`). No `&` operator is needed
                    # at the call site; the expected type drives it.
                    if expected.kind == TypeKind.Ref and ident_type.kind != TypeKind.Ref:
                        # A `cstr` local is ALREADY a pointer value (`char*`); when a ref/ptr param
                        # is expected (e.g. a duplicate `getenv(name: u8&)` overload bound to a cstr
                        # argument), pass the LOADED pointer, not the slot's address (`char**`).
                        # Both cstr and a bare ref lower to `ptr`, so this is a no-op reinterpret.
                        if ident_type.kind == TypeKind.CStr:
                            return LLVMBuildLoad2(builder, llvm_type_of(ident_type, structs, ctx), slot, "cstr.as.ref")
                        null return if ref_target_of(expected, structs).kind != ident_type.kind
                        return slot
                    loaded_ident: LLVMValueRef = LLVMBuildLoad2(builder, llvm_type_of(ident_type, structs, ctx), slot, "load")
                    # A local identifier is the one expression path that historically returned
                    # its storage type verbatim.  That made `i32_field <- f64_local` build an
                    # invalid store while equivalent call/field expressions were converted.
                    # Keep representation-identical values untouched, but honor a concrete
                    # numeric destination for ordinary scalar locals.
                    if expected.kind != TypeKind.Unmodeled and is_numeric_type(ident_type) and is_numeric_type(expected) and (ident_type.kind != expected.kind or ident_type.bits != expected.bits):
                        if emit_conversion(loaded_ident, ident_type, expected, structs, ctx, builder) is converted_ident:
                            return converted_ident
                        return null
                    return loaded_ident
                return null
            return emit_expression_unary(expression, expected, local_scope, fns, structs, generics, runtime, m, ctx, builder, handled)
include "./codegen_expr_is_struct_patterns.elisa"

include "./codegen_expr_unary.elisa"
include "./codegen_expr_optional_binary.elisa"
include "./codegen_expr_membership.elisa"
