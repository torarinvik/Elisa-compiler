# Stage1 backend — LLVM codegen (`module Backend`).
#
# The stage0 counterpart is compiler/src/backend/llvm_*.go (~54k lines of cgo). This is
# the growing port of that: it walks the stage1 AST and drives LLVM-C (see llvm_c.elisa).
#
# Sound SUBSET, mirroring how the frontend was ported: only firmly-modeled constructs
# emit. Every emitter returns a "declined" signal for anything it does not model, and
# `emit_module` turns ANY decline into a whole-module decline, so the driver reports an
# honest UNSUPPORTED instead of handing back a module that is quietly missing code.
# Coverage grows one construct at a time, each with a compile-and-run fixture asserting
# real behavior (an exit code), plus a differential against stage0 where the reference
# compiler can compile the same source.
#
# Modeled today: `def f(a: i64, …) -> i64` over signed i64 — int literals, idents,
# `+ - * / %`, unary `+`/`-`, comparisons, parens, locals (`x: i64 = …`), assignment,
# `if`/`else`, `while`, `return`, and direct calls to other modeled functions.

include "../semantic/semantic.elisa"
include "llvm_c.elisa"
using Ast

module Backend:

    private:

        # LLVM-C takes NUL-terminated `const char*`, but an `sview` is a (ptr, len) view
        # into the source buffer with no terminator — taking `&view[0]` would hand LLVM a
        # string that runs to the end of the FILE. Copy the bytes and terminate.
        # `storage` is caller-owned on purpose: the returned pointer aliases it, so it
        # must outlive the LLVM call that consumes the name.
        def sview_to_cstr(name: sview, storage: mutable darray[u8]&) -> cstr can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            for index in 0..<sview_len(name) |storage|:
                storage.push(sview_at(name, index))
            storage.push(0)
            return (&storage[0]).cast[cstr] can Unsafe.PointerCast


        # The INNER bytes of a string-literal pattern span, which arrives quote-INCLUSIVE
        # (`"yes"`) because a pattern literal keeps its raw source text. Strips the surrounding
        # double quotes and returns a NUL-terminated cstr of the content. Declines (null) on a
        # backslash: escape decoding would have to match stage0's exactly, so a `"a\n"` pattern
        # is left to decline rather than risk a mis-encoded compare.
        def string_pattern_content_cstr(text: sview, storage: mutable darray[u8]&) -> cstr? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            length: usize = sview_len(text)
            null return if length == 0
            # The span may or may not include the surrounding double quotes depending on how
            # the pattern lexer captured it; strip a matched pair when present.
            quoted: bool = length >= 2 and sview_at(text, 0) == 34 and sview_at(text, length - 1) == 34
            start: usize = 1 if quoted else 0
            stop: usize = length - 1 if quoted else length
            index: mutable usize = start
            while index < stop |storage, index|:
                byte: u8 = sview_at(text, index)
                null return if byte == 92
                storage.push(byte)
                index <- index + 1
            storage.push(0)
            return (&storage[0]).cast[cstr] can Unsafe.PointerCast


        # The LLVM SYMBOL name for `owner::name`: stage0 emits `module M: def get()` as
        # `define i64 @M.get` — DOT-separated, even though the call spelling is `M::get()`.
        # An empty owner is a top-level function and keeps its bare name.
        def qualified_name_cstr(owner: sview, name: sview, storage: mutable darray[u8]&) -> cstr can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            sview_to_cstr(name, storage) return if sview_len(owner) == 0
            for index in 0..<sview_len(owner) |storage|:
                storage.push(sview_at(owner, index))
            storage.push(46)
            for index in 0..<sview_len(name) |storage|:
                storage.push(sview_at(name, index))
            storage.push(0)
            return (&storage[0]).cast[cstr] can Unsafe.PointerCast


        # A modeled value's type. `bits` is the integer width; `Bool` is i1 (LLVM's
        # natural boolean) and carries no width of its own.
        #
        # Signedness is not cosmetic: stage0 lowers `u8 200 / 3` to `udiv` (66) and
        # `u8 200 >> 1` to `lshr` (100). Reading those as signed gives -56 and 228 — so a
        # backend that ignores signedness silently miscompiles unsigned arithmetic.
        const enum TypeKind of u8:
            Unmodeled
            Signed
            Unsigned
            Bool
            Float
            # `void` — legal ONLY as a return type. It has no values, so nothing can be a
            # `void` local, parameter, or operand; every other position rejects it because
            # `unmodeled_type()` is what those paths test for and Void is not that.
            Void
            # A user struct. `bits` is its index in the StructTable — a ValueType must stay
            # POD (an sview name would be fine, but an index also gives O(1) field lookup).
            Struct
            # A fixed array `T[N]`. `bits` indexes the StructTable's ARRAY side-pool
            # (`array_elements` / `array_extents`) — same reason as Struct: ValueType is
            # POD, so a nested element type cannot live inline.
            Array
            # A `packed enum`'s HANDLE. Same `{i32, [N x i64]}` shape as a payload enum, but
            # the value is a row in an AoS store rather than inline data: the tag and payload
            # are read back through ctx_packed_store_* rather than by extractvalue/GEP.
            # `bits` indexes the PACKED side-pool.
            PackedEnum
            # `Node.Store[Local]` — `{ptr arena, i64 row_bytes, ptr state}`. `bits` indexes
            # the PACKED side-pool of the enum it stores.
            PackedStore
            # `Arena` — the runtime's region carrier, `{ptr, ptr, i64, i64}`, passed BY
            # VALUE (stage0: `define i64 @build(%Arena %0)` and `%r1 = load %Arena, ptr %r`
            # at the call site). Note the asymmetry: `Arena` is legal as a PARAMETER type
            # but rejected as a region ANNOTATION (`-> darray[i64] @owner` is "internal
            # runtime carrier type ... not supported in user-facing code").
            Arena
            # A PAYLOAD-carrying enum (`enum Shape: Circle(r: i64)`). In LLVM a TAGGED UNION
            # `{ i32, [N x i64] }`: field 0 is the variant ORDINAL, field 1 is payload
            # storage sized to the largest variant (stage0's `%Shape = type { i32, [1 x
            # i64] }`, read from its IR). NOT the AoS packed store -- that is `packed enum`,
            # a different subsystem. `bits` indexes the PAYLOAD-ENUM side-pool.
            PayloadEnum
            # `cstr` — a NUL-terminated string constant. In LLVM just a `ptr`: stage0
            # lowers `s: cstr = "hi"` to `@str = private unnamed_addr constant [3 x i8]
            # c"hi\00"` plus `store ptr @str`. Carries no length, so `.count`, indexing and
            # comparison are NOT modeled (they need the runtime) and decline.
            CStr
            # A reference `T&` / `mutable T&`. `bits` indexes the REF side-pool
            # (`ref_targets`). In LLVM it is just a `ptr` — stage0 lowers
            # `def bump(n: mutable i64&)` to `define void @bump(ptr)` and `bump(x)` to
            # `call void @bump(ptr %x)`. Mutability is a FRONTEND concern (it already
            # rejects writes through a `T&`), so the backend models only the referent.
            Ref
            # An optional `T?`. `bits` indexes the OPTIONAL side-pool (`optional_targets`).
            # Represented exactly as stage0 does — `{i1 has_value, T value}` (read from its
            # `-emit llvm`: `%Optional__i64 = type { i1, i64 }`).
            Optional
            # A `darray[T]`. `bits` indexes the DARRAY side-pool (`darray_elements`).
            # Represented exactly as stage0 does — `{ptr items, i64 count, i64 capacity}`,
            # backed by an Arena — because both link the SAME runtime, so the layout is
            # dictated, not chosen.
            DArray
            # A `view[T]` — the runtime's `DynArrayView` fat pointer `{data, len}`. `bits`
            # indexes the VIEW side-pool (`view_elements`), carrying the phantom element T
            # so a generic call like `arena_da_fill(view, …)` can INFER T from the argument.
            # Lowers to the one `DynArrayView` struct regardless of T (like darray).
            View
            # `sview` — a string VIEW, stage0's `%StringView = type { ptr, i64 }` (a byte
            # pointer plus a length). Distinct from `cstr` (bare `ptr`, NUL-terminated) and
            # from `view[T]` (DynArrayView). A literal `s: sview = "hi"` is the aggregate
            # `{ptr @str, i64 2}`; equality goes through `ctx_string_views_eq` BY VALUE.
            SView


        struct ValueType:
            kind: TypeKind
            bits: u32


        def unmodeled_type() -> ValueType:
            return ValueType{kind: TypeKind.Unmodeled, bits: 0}


        def is_integer_type(value_type: ValueType) -> bool:
            return value_type.kind == TypeKind.Signed or value_type.kind == TypeKind.Unsigned


        # The i1 test for a `Pattern.Range` arm (`lo..<hi` / `lo..=hi`) over an INTEGER
        # scrutinee: `scrutinee >= lo AND scrutinee </<= hi`. Signed/unsigned drives the
        # predicate (a u8 range must compare with U* predicates). Returns null when either
        # bound is not an integer literal (e.g. a char-literal range) so the caller declines.
        # LLVM IntPredicate: UGE=35 ULT=36 ULE=37 SGE=39 SLT=40 SLE=41.
        def emit_range_test(scrutinee: LLVMValueRef, scrutinee_type: ValueType, lo_text: sview, hi_text: sview, inclusive: bool, compare_type: LLVMTypeRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic]:
            lo_value: mutable i64 = 0
            hi_value: mutable i64 = 0
            null return if not parse_int_literal(lo_text, lo_value)
            null return if not parse_int_literal(hi_text, hi_value)
            unsigned: bool = scrutinee_type.kind == TypeKind.Unsigned
            lo_pred: u32 = 35 if unsigned else 39
            hi_pred: mutable u32 = 40
            hi_pred <- 41 if inclusive
            if unsigned:
                hi_pred <- 37 if inclusive else 36
            lo_hit: LLVMValueRef = LLVMBuildICmp(builder, lo_pred, scrutinee, LLVMConstInt(compare_type, lo_value.u64(), 1), "range.lo")
            hi_hit: LLVMValueRef = LLVMBuildICmp(builder, hi_pred, scrutinee, LLVMConstInt(compare_type, hi_value.u64(), 1), "range.hi")
            return LLVMBuildAnd(builder, lo_hit, hi_hit, "range.in")


        # The i1 test for ONE simple, binding-free arm pattern against an already-lowered
        # `scrutinee` (a raw integer, or a payload-enum's extracted i32 tag when `penum`).
        # Handles integer/const-enum-ordinal literals, field-less variant paths, and integer
        # ranges — the sub-patterns an OR-pattern (`0 | 2 | 4`, `E.A | E.B`) is built from.
        # Returns null for anything with a binding or payload (an OR alternative cannot bind).
        def emit_simple_pattern_hit(pattern: Pattern, scrutinee: LLVMValueRef, scrutinee_type: ValueType, penum: bool, compare_type: LLVMTypeRef, structs: mutable StructTable&, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic]:
            if pattern is Pattern.Literal(literal_text):
                literal_value: mutable i64 = 0
                null return if not parse_int_literal(literal_text, literal_value)
                return LLVMBuildICmp(builder, 32, scrutinee, LLVMConstInt(compare_type, literal_value.u64(), 1), "or.cmp")
            if pattern is Pattern.Variant(variant_path, variant_fields):
                null return if variant_fields.count != 0
                ordinal: mutable i64 = penum_variant_index_of_path(variant_path, structs) if penum else ordinal_of_dotted_path(variant_path, structs)
                null return if ordinal < 0
                return LLVMBuildICmp(builder, 32, scrutinee, LLVMConstInt(compare_type, ordinal.u64(), 1), "or.cmp")
            if pattern is Pattern.Range(range_lo, range_hi, range_inclusive):
                null return if penum
                return emit_range_test(scrutinee, scrutinee_type, range_lo, range_hi, range_inclusive, compare_type, ctx, builder)
            return null


        # The combined i1 test for an OR-pattern's option list: hit if ANY option hits.
        # Returns null if any option is not a simple binding-free pattern.
        def emit_or_pattern_hit(options: darray[Pattern], scrutinee: LLVMValueRef, scrutinee_type: ValueType, penum: bool, compare_type: LLVMTypeRef, structs: mutable StructTable&, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate]:
            null return if options.count == 0
            combined: mutable LLVMValueRef = zeroed
            have: mutable bool = false
            failed: mutable bool = false
            for option in options |combined, have, failed, scrutinee, scrutinee_type, penum, compare_type, structs, ctx, builder|:
                continue if failed
                if emit_simple_pattern_hit(option, scrutinee, scrutinee_type, penum, compare_type, structs, ctx, builder) is option_hit:
                    combined <- option_hit if not have
                    combined <- LLVMBuildOr(builder, combined, option_hit, "or.any") if have
                    have <- true
                else:
                    failed <- true
            null return if failed or not have
            return combined


        def is_numeric_type(value_type: ValueType) -> bool:
            return is_integer_type(value_type) or value_type.kind == TypeKind.Float


        # Whether the type lowers to an LLVM `ptr` — a reference or a cstr. Used to keep a
        # `.cast[T]` reinterpret to the pointer<->pointer no-op the std alloc helpers need.
        def type_is_pointer(value_type: ValueType) -> bool:
            return value_type.kind == TypeKind.Ref or value_type.kind == TypeKind.CStr


        # The named scalar types the backend models. Anything else (f32/f64, containers,
        # user types) yields Unmodeled and DECLINES rather than being guessed at.
        #
        # `int` is stage0's signed 64-bit default; `usize` is pointer-width (64 here — the
        # port targets arm64/x86-64, and a 32-bit target would need this to follow the
        # target triple).
        def scalar_type_of_name(name: sview) -> ValueType:
            ValueType{kind: TypeKind.CStr, bits: 0} return if name == "cstr"
            ValueType{kind: TypeKind.SView, bits: 0} return if name == "sview"
            ValueType{kind: TypeKind.Signed, bits: 8} return if name == "i8"
            ValueType{kind: TypeKind.Signed, bits: 16} return if name == "i16"
            ValueType{kind: TypeKind.Signed, bits: 32} return if name == "i32"
            ValueType{kind: TypeKind.Signed, bits: 64} return if name == "i64" or name == "int"
            ValueType{kind: TypeKind.Unsigned, bits: 8} return if name == "u8"
            ValueType{kind: TypeKind.Unsigned, bits: 16} return if name == "u16"
            ValueType{kind: TypeKind.Unsigned, bits: 32} return if name == "u32"
            ValueType{kind: TypeKind.Unsigned, bits: 64} return if name == "u64" or name == "usize" or name == "uintptr"
            ValueType{kind: TypeKind.Bool, bits: 1} return if name == "bool"
            # stage0 lowers `char` to i64 (`define i64 @f(i64)`, `icmp eq i64`) — a full-width
            # signed scalar, not a byte. Model it identically so char arithmetic/compares work.
            ValueType{kind: TypeKind.Signed, bits: 64} return if name == "char"
            ValueType{kind: TypeKind.Float, bits: 32} return if name == "f32"
            ValueType{kind: TypeKind.Float, bits: 64} return if name == "f64"
            ValueType{kind: TypeKind.Void, bits: 0} return if name == "void"
            return unmodeled_type()


        # What `name` is bound to in the CURRENT instantiation, or Unmodeled if it is not a
        # type parameter (i.e. it is an ordinary type name).
        def bound_type_of(structs: mutable StructTable&, name: sview) -> ValueType can[Abort.Panic]:
            # Scan most-recent-first so an inner instantiation's binding shadows an outer
            # one that reuses the same parameter name (`DictBucket[K, T]` nested inside
            # `DynDict[K, T]`). For a single instantiation there are no duplicates, so this
            # is identical to a forward scan.
            count: usize = structs.binding_names.count
            for offset in 0..<count |structs, name, count|:
                index: usize = count - 1 - offset
                copied_type(structs.binding_types[index]) return if structs.binding_names[index] == name
            return unmodeled_type()


        # The return type of generic `base` instantiated at `type_argument`: its return
        # annotation resolved under that binding.
        def generic_return_type(base: sview, type_args: darray[ValueType]&, generics: mutable GenericTable&, structs: mutable StructTable&) -> ValueType can[Abort.Panic, Memory.Allocate]:
            index: i64 = generic_index_of(generics, base)
            unmodeled_type() return if index < 0
            slot: usize = index.usize()
            unmodeled_type() return if generics.param_count[slot] != type_args.count
            if generics.decls[slot] is Decl.Func(function_name, params, return_type_opt, body, effects, decorators, line):
                # A missing return annotation is `void` — so a call to it names its result ""
                # (LLVM rejects a named void instruction).
                resolved: mutable ValueType = ValueType{kind: TypeKind.Void, bits: 0}
                if return_type_opt is declared_return:
                    bound: usize = push_type_bindings(generics, structs, slot, type_args)
                    resolved <- annotation_value_type(declared_return, structs)
                    pop_type_bindings(structs, bound)
                return resolved
            return unmodeled_type()


        # The type an annotation denotes. Only a bare scalar name is modeled.
        #
        # `mutable` is a QUALIFIER on the annotation, not part of the type: `x: mutable
        # i64` denotes i64 and just says the binding can be reassigned. It rides as a
        # Unary node wrapping the type, so it is unwrapped here — mutability is the
        # frontend's business (it already rejects `x <- 1` on an immutable local), and the
        # backend only needs the underlying type.
        def annotation_value_type(type_expression: Expr, structs: mutable StructTable&) -> ValueType can[Abort.Panic]:
            if type_expression is Expr.Unary(qualifier, qualified_type, qualifier_line):
                # `mutable T` — a QUALIFIER, not part of the type: mutability is the
                # frontend's business, so the underlying type is what matters.
                annotation_value_type(qualified_type, structs) return if qualifier == TokenKind.Mutable
                # `heap T` / `stack T` — a STORAGE qualifier the region checker uses. `stack` is
                # transparent (representation-identical). `heap T&` marks a RAW pointer: keep it
                # a Ref (same `ptr`, same deref/field/index) but flag it heap so `+`/`-` become
                # pointer arithmetic — the arena allocator walks its backing store this way.
                annotation_value_type(qualified_type, structs) return if qualifier == TokenKind.Stack
                if qualifier == TokenKind.Heap:
                    heap_qualified: ValueType = annotation_value_type(qualified_type, structs)
                    intern_heap_ref_type(ref_target_of(heap_qualified, structs), structs) return if heap_qualified.kind == TypeKind.Ref
                    # `heap T&?` nests the `?` INSIDE the `heap` qualifier, so the recursion
                    # hands back an Optional and the heap flag would be dropped on the way
                    # out — leaving the payload an ordinary (never-null) ref, which is what
                    # made `malloc`'s null result wrap as PRESENT. Re-intern through the
                    # optional so the heap-ness survives.
                    if heap_qualified.kind == TypeKind.Optional:
                        heap_payload: ValueType = optional_payload_of(heap_qualified, structs)
                        intern_optional_type(intern_heap_ref_type(ref_target_of(heap_payload, structs), structs), structs) return if heap_payload.kind == TypeKind.Ref
                    return heap_qualified
                # `T&` — a POSTFIX unary in the AST (the parser distinguishes it from infix
                # bitwise-and by looking past the whole `&` run).
                intern_ref_type(annotation_value_type(qualified_type, structs), structs) return if qualifier == TokenKind.Ampersand
                # `T?` — also a postfix unary.
                intern_optional_type(annotation_value_type(qualified_type, structs), structs) return if qualifier == TokenKind.Question
                # `tail T` — a flexible/tail array member (the inline data at a struct's end).
                # stage0 lays it out as a plain `ptr`; model it as a heap ref to T (a `ptr` of
                # pointer stride), so a struct carrying one gets a body and the right size.
                intern_heap_ref_type(annotation_value_type(qualified_type, structs), structs) return if qualifier == TokenKind.Tail
                return unmodeled_type()
            # `i64[3]` — a fixed array. The bracket holds an extent VALUE and the HEAD is
            # the element type. A NON-literal bracket (`cstr[shape]`) is a shape parameter,
            # not an array, and is not modeled.
            # `Node.Store[Local]` — Index(Field(Ident, "Store"), typestate). The TYPESTATE is
            # not modeled: [Local] and [Frozen] have the same layout, and the distinction is
            # a semantic one (freeze/move) the backend does not enforce. Accepting both here
            # would be wrong only if the backend implemented freeze, which it does not -- so
            # `freeze`/`move` themselves still decline.
            if type_expression is Expr.Index(store_head, store_state, store_line):
                if store_head is Expr.Field(store_enum_expr, store_member, store_member_line):
                    if store_enum_expr is Expr.Ident(store_enum_name, store_enum_line):
                        if store_member == "Store":
                            store_index: i64 = packed_index_of(structs, store_enum_name)
                            ValueType{kind: TypeKind.PackedStore, bits: store_index.u32()} return if store_index >= 0
            if type_expression is Expr.Index(array_head, array_extent, array_line):
                # `darray[T]` — the head is a CONTAINER NAME, not an element type, and the
                # bracket holds a TYPE rather than an extent.
                if array_head is Expr.Ident(container_name, container_line):
                    if container_name == "darray":
                        darray_element: ValueType = annotation_value_type(array_extent, structs)
                        # Only scalar elements are modeled: a nested container or struct
                        # element needs its own stride/layout handling.
                        unmodeled_type() return if darray_element.kind == TypeKind.Unmodeled
                        unmodeled_type() return if darray_element.kind == TypeKind.Array
                        return intern_darray_type(darray_element, structs)
                    # `view[T]` — the runtime's `DynArrayView` fat pointer, interned with its
                    # phantom element T so a generic call can infer T from a `view[T]` argument.
                    if container_name == "view":
                        view_element: ValueType = annotation_value_type(array_extent, structs)
                        unmodeled_type() return if view_element.kind == TypeKind.Unmodeled
                        return intern_view_type(view_element, structs)
                if array_extent is Expr.IntLit(extent_value):
                    element: ValueType = annotation_value_type(array_head, structs)
                    unmodeled_type() return if element.kind == TypeKind.Unmodeled
                    unmodeled_type() return if extent_value <= 0
                    return intern_array_type(element, extent_value.u32(), structs)
                # `Box[i64]` — a single-argument generic struct application.
                if array_head is Expr.Ident(generic_base, generic_base_line):
                    if generic_struct_index_of(structs, generic_base) >= 0:
                        single_argument: ValueType = annotation_value_type(array_extent, structs)
                        single_argument_list: mutable darray[ValueType] = [single_argument]
                        return instantiate_generic_struct(generic_base, single_argument_list, structs)
                return unmodeled_type()
            # `dict[K, V]` / `Pair[K, V]` — a multi-argument generic type application. The
            # `dict` spelling denotes the runtime's `DynDict[K, V]` struct.
            if type_expression is Expr.IndexN(application_head, application_args, application_line):
                if application_head is Expr.Ident(application_name, application_name_line):
                    resolved_base: sview = "DynDict" if application_name == "dict" else application_name
                    if generic_struct_index_of(structs, resolved_base) >= 0:
                        argument_types: mutable darray[ValueType] = []
                        application_declined: mutable bool = false
                        for argument_expression in application_args |argument_types, application_declined, structs|:
                            argument_type: ValueType = annotation_value_type(argument_expression, structs)
                            application_declined <- true if argument_type.kind == TypeKind.Unmodeled
                            argument_types.push(argument_type)
                        unmodeled_type() return if application_declined
                        return instantiate_generic_struct(resolved_base, argument_types, structs)
                return unmodeled_type()
            if type_expression is Expr.Ident(type_name, type_line):
                # A TYPE PARAMETER shadows everything: inside an instantiation of
                # `identity[T]` with T=i64, the annotation `T` denotes i64.
                bound: ValueType = bound_type_of(structs, type_name)
                bound return if bound.kind != TypeKind.Unmodeled
                scalar: ValueType = scalar_type_of_name(type_name)
                scalar return if scalar.kind != TypeKind.Unmodeled
                ValueType{kind: TypeKind.Arena, bits: 0} return if type_name == "Arena"
                # `dstr` (dynamic string) IS a `darray[u8]` — stage0 lays it out as
                # `%DynArray__u8 = {ptr,i64,i64}` and builds a literal byte-by-byte. Reuse the
                # darray machinery (count / index / iterate / arena-threaded return) wholesale.
                intern_darray_type(ValueType{kind: TypeKind.Unsigned, bits: 8}, structs) return if type_name == "dstr"
                # An ALIAS denotes its target and has no representation of its own. Resolved
                # to a fixpoint at registration, so this is a lookup, never a recursion.
                alias_index: i64 = alias_index_of(structs, type_name)
                copied_type(structs.alias_types[alias_index.usize()]) return if alias_index >= 0
                # A CONST ENUM name denotes its BACKING scalar — stage0 passes
                # `c: Color` as an i8, so there is no distinct enum type to model.
                enum_index: i64 = enum_index_of(structs, type_name)
                copied_type(structs.enum_backings[enum_index.usize()]) return if enum_index >= 0
                packed_annotation_index: i64 = packed_index_of(structs, type_name)
                ValueType{kind: TypeKind.PackedEnum, bits: packed_annotation_index.u32()} return if packed_annotation_index >= 0
                penum_index: i64 = penum_index_of(structs, type_name)
                ValueType{kind: TypeKind.PayloadEnum, bits: penum_index.u32()} return if penum_index >= 0
                # A user STRUCT name: `bits` carries its registry index.
                struct_index: i64 = struct_index_of(structs, type_name)
                ValueType{kind: TypeKind.Struct, bits: struct_index.u32()} return if struct_index >= 0
            return unmodeled_type()


        # The LLVM type backing a ValueType.
        def llvm_type_of(value_type: ValueType, structs: mutable StructTable&, ctx: LLVMContextRef) -> LLVMTypeRef can[Abort.Panic]:
            LLVMVoidTypeInContext(ctx) return if value_type.kind == TypeKind.Void
            LLVMInt1TypeInContext(ctx) return if value_type.kind == TypeKind.Bool
            # A cstr is an opaque `ptr`, exactly as stage0 passes it (`define i64
            # @take(ptr)`).
            LLVMPointerTypeInContext(ctx, 0) return if value_type.kind == TypeKind.CStr
            arena_llvm_type(ctx) return if value_type.kind == TypeKind.Arena
            # A packed handle is an **i32 INDEX** into the store, NOT the row. stage0:
            # `%n = alloca i32`, `store i32 %packed.alloc.index, ptr %n`, and the match
            # passes that index to the runtime. The `{i32, [N x i64]}` struct below is only
            # the ROW LAYOUT, used when WRITING a row -- it is never the value's type.
            LLVMInt32TypeInContext(ctx) return if value_type.kind == TypeKind.PackedEnum
            # `{ptr arena, i64 row_bytes, ptr state}` — stage0's `%Node__Store`.
            if value_type.kind == TypeKind.PackedStore:
                store_fields: mutable darray[LLVMTypeRef] = [LLVMPointerTypeInContext(ctx, 0), LLVMInt64TypeInContext(ctx), LLVMPointerTypeInContext(ctx, 0)]
                store_pointer: void& = (&store_fields[0]).cast[void&] can Unsafe.PointerCast
                return LLVMStructTypeInContext(ctx, store_pointer, 3, 0)
            # `{ i32, [N x i64] }` — stage0's tagged-union layout for a payload enum.
            if value_type.kind == TypeKind.PayloadEnum:
                words: u32 = structs.penum_payload_words[value_type.bits.usize()]
                penum_fields: mutable darray[LLVMTypeRef] = [LLVMInt32TypeInContext(ctx), LLVMArrayType(LLVMInt64TypeInContext(ctx), words)]
                penum_pointer: void& = (&penum_fields[0]).cast[void&] can Unsafe.PointerCast
                return LLVMStructTypeInContext(ctx, penum_pointer, 2, 0)
            structs.handles[value_type.bits.usize()] return if value_type.kind == TypeKind.Struct
            if value_type.kind == TypeKind.Array:
                slot: usize = value_type.bits.usize()
                return LLVMArrayType(llvm_type_of(structs.array_elements[slot], structs, ctx), structs.array_extents[slot])
            # `{i1 has_value, T value}` — stage0's Optional layout.
            if value_type.kind == TypeKind.Optional:
                payload: ValueType = copied_type(structs.optional_targets[value_type.bits.usize()])
                fields: mutable darray[LLVMTypeRef] = [LLVMInt1TypeInContext(ctx), llvm_type_of(payload, structs, ctx)]
                fields_pointer: void& = (&fields[0]).cast[void&] can Unsafe.PointerCast
                return LLVMStructTypeInContext(ctx, fields_pointer, 2, 0)
            # A reference is just a pointer; the referent matters only at the load/store.
            LLVMPointerTypeInContext(ctx, 0) return if value_type.kind == TypeKind.Ref
            # `{ptr items, i64 count, i64 capacity}` — stage0's DynArray layout, which the
            # shared runtime dictates.
            if value_type.kind == TypeKind.DArray:
                return darray_llvm_type(structs, ctx)
            # A `view[T]` lowers to the one `DynArrayView` struct regardless of its element.
            if value_type.kind == TypeKind.View:
                view_llvm_struct: ValueType = view_struct_type(value_type, structs)
                return structs.handles[view_llvm_struct.bits.usize()] if view_llvm_struct.kind == TypeKind.Struct else LLVMPointerTypeInContext(ctx, 0)
            # `%StringView = type { ptr, i64 }` — stage0's byte-pointer + length pair.
            if value_type.kind == TypeKind.SView:
                sview_fields: mutable darray[LLVMTypeRef] = [LLVMPointerTypeInContext(ctx, 0), LLVMInt64TypeInContext(ctx)]
                sview_pointer: void& = (&sview_fields[0]).cast[void&] can Unsafe.PointerCast
                return LLVMStructTypeInContext(ctx, sview_pointer, 2, 0)
            if value_type.kind == TypeKind.Float:
                return LLVMFloatTypeInContext(ctx) if value_type.bits == 32 else LLVMDoubleTypeInContext(ctx)
            LLVMInt8TypeInContext(ctx) return if value_type.bits == 8
            LLVMInt16TypeInContext(ctx) return if value_type.bits == 16
            LLVMInt32TypeInContext(ctx) return if value_type.bits == 32
            return LLVMInt64TypeInContext(ctx)


        # The module's struct types.
        #
        # Field names/types live in FLAT pools with a per-struct span, the same shape as
        # FnTable's parameters — a nested `darray[darray[…]]` would make this
        # region-polymorphic for no benefit.
        struct StructTable:
            names: mutable darray[sview]
            handles: mutable darray[LLVMTypeRef]
            field_names: mutable darray[sview]
            field_types: mutable darray[ValueType]
            field_start: mutable darray[usize]
            field_count: mutable darray[usize]
            # GENERIC struct templates. A `struct Box[T]:` is NOT a concrete type — it is
            # a template materialized per type-argument tuple into an ordinary registered
            # struct named `Box__i64` (the concrete name doubles as the instantiation memo:
            # struct_index_of finding it means it is already built). The template stores its
            # own Decl so its member types can be re-resolved with the type parameters bound.
            # Param names live in a FLAT pool with a per-template span, like struct fields.
            generic_struct_names: mutable darray[sview]
            generic_struct_decls: mutable darray[Decl]
            generic_struct_param_names: mutable darray[sview]
            generic_struct_param_start: mutable darray[usize]
            generic_struct_param_count: mutable darray[usize]
            # Instantiation memo, keyed by (base, type-argument tuple) — NOT by a mangled
            # name, so no synthetic name sview has to outlive the call that builds it. Args
            # are flattened into a pool with a per-instantiation span; `inst_index` is the
            # resulting entry's slot in `names`/`handles`.
            generic_struct_inst_bases: mutable darray[sview]
            generic_struct_inst_args: mutable darray[ValueType]
            generic_struct_inst_arg_start: mutable darray[usize]
            generic_struct_inst_arg_count: mutable darray[usize]
            generic_struct_inst_index: mutable darray[usize]
            # Base names currently mid-instantiation. A self-recursive generic struct that
            # recurses BY VALUE (infinite size) is declined rather than looped on; the valid
            # by-pointer case (`Node[T]: next: Node[T]&?`) is not modeled yet and also
            # declines here, conservatively.
            generic_struct_inprogress: mutable darray[sview]
            # The module's LLVM context, stashed so annotation_value_type — which has no ctx
            # parameter — can LAZILY materialize a `Base[args]` instantiation (create its
            # named struct and set its body) the first time an annotation names it.
            context: LLVMContextRef
            # Fixed-array types, interned on demand: `array_elements[i]` is the element
            # type and `array_extents[i]` the length of the array whose ValueType has
            # `bits == i`. Interning (rather than a fresh entry per mention) keeps
            # `i64[3]` one type, so two locals of the same array type compare equal.
            array_elements: mutable darray[ValueType]
            array_extents: mutable darray[u32]
            # `darray[T]` element types, interned the same way.
            darray_elements: mutable darray[ValueType]
            # `view[T]` element types, interned the same way — the phantom element the
            # `DynArrayView` fat pointer carries for type checking / generic inference.
            view_elements: mutable darray[ValueType]
            # `T&` referent types, interned the same way.
            ref_targets: mutable darray[ValueType]
            # Parallel to ref_targets: whether each interned ref is a RAW HEAP pointer (`heap
            # T&`) rather than a safe reference. A heap ref does POINTER arithmetic on `+`/`-`
            # (advance by stride); a safe ref value-adds (deref then add). The `kind` stays Ref
            # for both, so deref / field / index handling is identical — only arithmetic asks.
            ref_is_heap: mutable darray[bool]
            # `T?` payload types, interned the same way.
            optional_targets: mutable darray[ValueType]
            # CONST enums. A `const enum Color of u8` IS its backing scalar (stage0 lowers
            # `def code(c: Color)` to `define i64 @code(i8 %0)`), and a variant is its
            # ORDINAL — `match c: Color.Red:` is `icmp eq i8 %c, 0`. So the backend needs
            # only name -> backing type, and (enum, variant) -> ordinal. Flat pools with a
            # per-enum span, same shape as struct fields.
            enum_names: mutable darray[sview]
            enum_backings: mutable darray[ValueType]
            enum_variants: mutable darray[sview]
            enum_variant_start: mutable darray[usize]
            enum_variant_count: mutable darray[usize]
            # PAYLOAD-carrying enums, in a side-pool parallel to the const-enum one above.
            # `penum_payloads` is the payload ValueType of each variant (one per variant, in
            # declaration order); a variant with NO payload still takes a slot so that a
            # variant's index within its enum IS its tag.
            penum_names: mutable darray[sview]
            penum_variants: mutable darray[sview]
            penum_payloads: mutable darray[ValueType]
            penum_has_payload: mutable darray[bool]
            # The payload field's declared NAME (""), used to check a LABELLED constructor
            # argument: `Shape.Circle(r: 42)` is only that constructor if `r` is the field's
            # real name -- otherwise it is a different program and must not be emitted.
            penum_field_names: mutable darray[sview]
            # MULTI-FIELD payload variants (`Rect(i64, i64)`): each variant's field types and
            # declared names in a flat pool, spanned per variant-slot by _start/_count. A
            # single-field variant keeps its proven single-value path (penum_payloads /
            # penum_has_payload above); a variant with COUNT>1 fields is emitted through these
            # pools instead (tuple store on construction, tuple extract on match). Every
            # variant-slot gets a span (0 fields = empty span) so the pools stay index-parallel.
            penum_field_types: mutable darray[ValueType]
            penum_field_flat_names: mutable darray[sview]
            penum_field_type_start: mutable darray[usize]
            penum_field_type_count: mutable darray[usize]
            # PACKED enums (`packed enum Node:`) — the same per-variant pools as penum_*, but
            # a separate table because the REPRESENTATION differs: a packed value is a store
            # row, not inline data. Kept apart so neither path can silently claim the other's
            # enums (which is exactly the bug 5403a62 fixed).
            packed_names: mutable darray[sview]
            packed_variants: mutable darray[sview]
            packed_payloads: mutable darray[ValueType]
            packed_has_payload: mutable darray[bool]
            packed_field_names: mutable darray[sview]
            packed_variant_start: mutable darray[usize]
            packed_variant_count: mutable darray[usize]
            packed_payload_words: mutable darray[u32]
            # How many leading fields of each variant are COMMON (shared across variants).
            # The parser PREPENDS them to every variant's field list, so from here a common
            # block just means "the first N fields are shared". They are stored INLINE
            # between the tag and the payload: stage0 lays out `%Expr = {i32, i64, [1 x i64]}`
            # for one common field, vs `{i32, [1 x i64]}` for none.
            packed_common_counts: mutable darray[u32]
            penum_variant_start: mutable darray[usize]
            penum_variant_count: mutable darray[usize]
            # Payload words (i64 units) of the WIDEST variant — the `[N x i64]` extent.
            penum_payload_words: mutable darray[u32]
            # `alias Num = i64` — a NAME for an existing type, carrying no representation of
            # its own, so it resolves to the target's ValueType and disappears.
            #
            # Resolved to a FIXPOINT at registration rather than by recursing at each
            # mention: `alias A = B` / `alias B = A` would otherwise recurse forever (the
            # same shape as the value-binding cycle that stack-overflows a naive resolver).
            # A cycle simply never resolves, stays Unmodeled, and DECLINES.
            alias_names: mutable darray[sview]
            alias_types: mutable darray[ValueType]
            # GLOBAL consts. stage0 INLINES them: `const LIMIT: i64 = 42` emits no `@LIMIT`
            # global and no load — `LIMIT + NAME.i64()` lowers to `sadd(42, 7)` (read from
            # its -emit llvm output). So a const is a compile-time VALUE substituted at the
            # use site, and the backend needs only name -> (type, folded value).
            #
            # Folded to a FIXPOINT, unlike aliases: stage0 ACCEPTS a forward reference here
            # (`const A: i64 = B + 2` before `const B` works — verified), so an in-order pass
            # would decline a program the reference compiler compiles. A CYCLE never folds
            # and stays unresolved, which declines — stage0 rejects it too ("const \"A\"
            # initializer must be a compile-time i64 value").
            const_names: mutable darray[sview]
            const_types: mutable darray[ValueType]
            const_values: mutable darray[i64]
            const_resolved: mutable darray[bool]
            # A FLOAT const's source text (`const PI: f64 = 3.0` → "3.0"), inlined at the use
            # site via LLVMConstRealOfString (never re-parse the decimal). "" for non-float.
            const_float_text: mutable darray[sview]
            # A global const AGGREGATE (array) is backed by a real module GLOBAL rather than a
            # folded scalar: `const_globals[i]` is its `@name` handle (indexed by GEP at use)
            # and `const_global_ok[i]` marks the slot as materialized. Scalar consts leave the
            # handle null and stay on the fold path above.
            const_globals: mutable darray[LLVMValueRef]
            const_global_ok: mutable darray[bool]
            # `static if` selection results, stashed here because StructTable already
            # reaches every emitter: branch head lines (all of them) and the taken subset.
            # A Stmt.Block("static") whose line is a branch line emits only when taken;
            # a bare `static:` block (line in neither) emits unconditionally.
            static_branch_lines: mutable darray[u32]
            static_taken_lines: mutable darray[u32]
            # The `ensure PRED` postconditions of the function CURRENTLY being emitted.
            # Refilled per function by emit_function_body and read at every `return`, which
            # is where stage0 checks them: it allocates `%result`, stores the returned value
            # into it, then branches on each predicate. Threaded on StructTable rather than
            # Runtime because Runtime is COPIED per function (copied_runtime) and this is a
            # container -- the side-table channel static_branch_lines already uses.
            pending_ensures: mutable darray[Expr]
            # The CURRENT generic instantiation's type-parameter bindings: `binding_names[i]`
            # (e.g. "T") stands for `binding_types[i]` (e.g. i64). Empty outside one.
            #
            # These live in the registry rather than as their own threaded parameter: the
            # registry already reaches every place a type is resolved, and constructing a
            # fresh empty bindings table per call site is REGION-POLYMORPHIC (so illegal in
            # a non-region-inferable context). Set on entry to an instantiation, cleared on
            # exit. `binding_names` are sviews into the source buffer, so nothing dangles.
            binding_names: mutable darray[sview]
            binding_types: mutable darray[ValueType]


        # The LLVM type of ANY darray: `{ptr, i64, i64}` = {items, count, capacity}.
        #
        # One shape for every element type — the element only affects the STRIDE when
        # indexing, never the header. Matches stage0's `%DynArray__T` (verified by reading
        # its `-emit llvm` output); the layout is dictated by the shared runtime.
        def darray_llvm_type(structs: mutable StructTable&, ctx: LLVMContextRef) -> LLVMTypeRef can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            int64_type: LLVMTypeRef = LLVMInt64TypeInContext(ctx)
            fields: mutable darray[LLVMTypeRef] = [LLVMPointerTypeInContext(ctx, 0), int64_type, int64_type]
            fields_pointer: void& = (&fields[0]).cast[void&] can Unsafe.PointerCast
            return LLVMStructTypeInContext(ctx, fields_pointer, 3, 0)


        # The `Arena` header: `{ptr, ptr, i64, i64}`. Field 3 is the STRATEGY, which the
        # runtime reads; stage0 stores 2 (lazy) for an auto region, so this does too.
        def arena_llvm_type(ctx: LLVMContextRef) -> LLVMTypeRef can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            pointer_type: LLVMTypeRef = LLVMPointerTypeInContext(ctx, 0)
            int64_type: LLVMTypeRef = LLVMInt64TypeInContext(ctx)
            fields: mutable darray[LLVMTypeRef] = [pointer_type, pointer_type, int64_type, int64_type]
            fields_pointer: void& = (&fields[0]).cast[void&] can Unsafe.PointerCast
            return LLVMStructTypeInContext(ctx, fields_pointer, 4, 0)


        # Copy a ValueType out of the region-backed registry.
        #
        # ValueType is POD, but a value read straight out of `structs`' darrays is a
        # BORROW tied to the registry's region — returning it region-less is (correctly)
        # rejected. Rebuilding it from its fields severs the borrow at zero cost.
        def copied_type(value_type: ValueType) -> ValueType:
            return ValueType{kind: value_type.kind, bits: value_type.bits}


        # Intern a fixed-array type `element[extent]`, returning its ValueType. Same
        # element+extent always yields the same index, so `i64[3]` is one type.
        def intern_array_type(element: ValueType, extent: u32, structs: mutable StructTable&) -> ValueType can[Abort.Panic, Memory.Allocate]:
            for index in 0..<structs.array_elements.count |structs, element, extent|:
                existing: ValueType = structs.array_elements[index]
                if existing.kind == element.kind and existing.bits == element.bits and structs.array_extents[index] == extent:
                    return ValueType{kind: TypeKind.Array, bits: index.u32()}
            structs.array_elements <- structs.array_elements.push(element)
            structs.array_extents <- structs.array_extents.push(extent)
            return ValueType{kind: TypeKind.Array, bits: (structs.array_elements.count - 1).u32()}


        # Intern a `darray[T]` type.
        def intern_darray_type(element: ValueType, structs: mutable StructTable&) -> ValueType can[Abort.Panic, Memory.Allocate]:
            for index in 0..<structs.darray_elements.count |structs, element|:
                existing: ValueType = structs.darray_elements[index]
                if existing.kind == element.kind and existing.bits == element.bits:
                    return ValueType{kind: TypeKind.DArray, bits: index.u32()}
            structs.darray_elements <- structs.darray_elements.push(element)
            return ValueType{kind: TypeKind.DArray, bits: (structs.darray_elements.count - 1).u32()}


        # Intern a `view[T]` type — one interned entry per element, lowering to DynArrayView.
        def intern_view_type(element: ValueType, structs: mutable StructTable&) -> ValueType can[Abort.Panic, Memory.Allocate]:
            for index in 0..<structs.view_elements.count |structs, element|:
                existing: ValueType = structs.view_elements[index]
                if existing.kind == element.kind and existing.bits == element.bits:
                    return ValueType{kind: TypeKind.View, bits: index.u32()}
            structs.view_elements <- structs.view_elements.push(element)
            return ValueType{kind: TypeKind.View, bits: (structs.view_elements.count - 1).u32()}


        def view_element_of(value_type: ValueType, structs: mutable StructTable&) -> ValueType can[Abort.Panic]:
            unmodeled_type() return if value_type.kind != TypeKind.View
            return copied_type(structs.view_elements[value_type.bits.usize()])


        # A `view[T]` decays to the `DynArrayView` STRUCT for every representation purpose
        # (LLVM type, field access) — only inference cares about the element. Unmodeled if
        # DynArrayView is not in scope (a program using `view[T]` without the std).
        def view_struct_type(value_type: ValueType, structs: mutable StructTable&) -> ValueType can[Abort.Panic]:
            unmodeled_type() return if value_type.kind != TypeKind.View
            view_struct_index: i64 = struct_index_of(structs, "DynArrayView")
            unmodeled_type() return if view_struct_index < 0
            return ValueType{kind: TypeKind.Struct, bits: view_struct_index.u32()}


        # Intern a reference type `T&`.
        def intern_ref_type(target: ValueType, structs: mutable StructTable&) -> ValueType can[Abort.Panic, Memory.Allocate]:
            unmodeled_type() return if target.kind == TypeKind.Unmodeled
            for index in 0..<structs.ref_targets.count |structs, target|:
                existing: ValueType = structs.ref_targets[index]
                if existing.kind == target.kind and existing.bits == target.bits and not structs.ref_is_heap[index]:
                    return ValueType{kind: TypeKind.Ref, bits: index.u32()}
            structs.ref_targets <- structs.ref_targets.push(target)
            structs.ref_is_heap <- structs.ref_is_heap.push(false)
            return ValueType{kind: TypeKind.Ref, bits: (structs.ref_targets.count - 1).u32()}

        # Intern a RAW HEAP pointer `heap T&` — a Ref (same LLVM `ptr`, same deref/field/index
        # handling) distinguished only by its heap flag, which makes `+`/`-` pointer arithmetic.
        def intern_heap_ref_type(target: ValueType, structs: mutable StructTable&) -> ValueType can[Abort.Panic, Memory.Allocate]:
            unmodeled_type() return if target.kind == TypeKind.Unmodeled
            for index in 0..<structs.ref_targets.count |structs, target|:
                existing: ValueType = structs.ref_targets[index]
                if existing.kind == target.kind and existing.bits == target.bits and structs.ref_is_heap[index]:
                    return ValueType{kind: TypeKind.Ref, bits: index.u32()}
            structs.ref_targets <- structs.ref_targets.push(target)
            structs.ref_is_heap <- structs.ref_is_heap.push(true)
            return ValueType{kind: TypeKind.Ref, bits: (structs.ref_targets.count - 1).u32()}

        # Whether a value type is a raw heap pointer (`heap T&`) — the query arithmetic asks.
        def ref_is_heap_ref(value_type: ValueType, structs: StructTable&) -> bool can[Abort.Panic]:
            return value_type.kind == TypeKind.Ref and structs.ref_is_heap[value_type.bits.usize()]


        # Intern an optional type `T?`.
        def intern_optional_type(payload: ValueType, structs: mutable StructTable&) -> ValueType can[Abort.Panic, Memory.Allocate]:
            unmodeled_type() return if payload.kind == TypeKind.Unmodeled or payload.kind == TypeKind.Optional
            for index in 0..<structs.optional_targets.count |structs, payload|:
                existing: ValueType = structs.optional_targets[index]
                if existing.kind == payload.kind and existing.bits == payload.bits:
                    return ValueType{kind: TypeKind.Optional, bits: index.u32()}
            structs.optional_targets <- structs.optional_targets.push(payload)
            return ValueType{kind: TypeKind.Optional, bits: (structs.optional_targets.count - 1).u32()}


        # The payload type of a `T?`.
        def optional_payload_of(value_type: ValueType, structs: mutable StructTable&) -> ValueType can[Abort.Panic]:
            unmodeled_type() return if value_type.kind != TypeKind.Optional
            return copied_type(structs.optional_targets[value_type.bits.usize()])


        # The referent type of a `T&`.
        # A function gains an implicit trailing `ptr` arena parameter — and allocates from
        # THAT rather than its own auto region — when a container it touches must outlive
        # the call. Two triggers, both verified against stage0's IR:
        #
        #   * a GROWABLE container REF param: `def fill(out: mutable darray[i64]&)` emits as
        #     `define void @fill(ptr, ptr)` and grows via `arena_alloc(ptr %1, ...)`;
        #   * a container RETURN type: `def build() -> darray[i64]` emits as
        #     `define %DynArray__i64 @build(ptr %0)` and allocates the returned darray's
        #     backing from the CALLER's region.
        #
        # Both are the same rule: the backing belongs to the caller, so a callee-local
        # region would free it at return and hand back freed memory. The return case IS
        # region-return inference, and it is why returning an owned container no longer has
        # to decline (see 95915b5, which declined it precisely because this was missing).
        # libc `abort()` for a failed contract's fail path. Declared once; a repeat
        # LLVMAddFunction would create a duplicate, so reuse an existing declaration.
        def declare_or_get_abort(m: LLVMModuleRef, abort_type: LLVMTypeRef) -> LLVMValueRef can[Abort.Panic, Unsafe.PointerCast]:
            if LLVMGetNamedFunction(m, "abort") is existing:
                return existing
            return LLVMAddFunction(m, "abort", abort_type)


        # Declare a runtime symbol (by name) once, reusing an existing declaration. Used for
        # compiler-emitted builtins whose implementation lives in elisacore_runtime.o.
        def declare_or_get_named(m: LLVMModuleRef, name: cstr, fn_type: LLVMTypeRef) -> LLVMValueRef can[Abort.Panic, Unsafe.PointerCast]:
            if LLVMGetNamedFunction(m, name) is existing:
                return existing
            return LLVMAddFunction(m, name, fn_type)


        # `ctx_hash_value(key)` — the compiler-emitted hash builtin the runtime dict uses.
        # stage0's lowering (llvm_hash.go): a cstr key hashes its content via ctx_hash_cstr
        # (FNV-1a); every fixed-size scalar key zero-extends to u64 and runs ctx_hash_u64
        # (splitmix64). Both return u64 and live in elisacore_runtime.o.
        def emit_hash_builtin(key_expression: Expr, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            key_type: ValueType = expression_type(key_expression, local_scope, fns, structs, generics)
            int64_type: LLVMTypeRef = LLVMInt64TypeInContext(ctx)
            # A cstr key: hash the content.
            if key_type.kind == TypeKind.CStr:
                if emit_expression(key_expression, key_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is cstr_value:
                    cstr_params: mutable darray[LLVMTypeRef] = [LLVMPointerTypeInContext(ctx, 0)]
                    cstr_pointer: void& = (&cstr_params[0]).cast[void&] can Unsafe.PointerCast
                    cstr_hash_type: LLVMTypeRef = LLVMFunctionType(int64_type, cstr_pointer, 1, 0)
                    cstr_hash_fn: LLVMValueRef = declare_or_get_named(m, "ctx_hash_cstr", cstr_hash_type)
                    cstr_args: mutable darray[LLVMValueRef] = [cstr_value]
                    cstr_args_pointer: void& = (&cstr_args[0]).cast[void&] can Unsafe.PointerCast
                    return LLVMBuildCall2(builder, cstr_hash_type, cstr_hash_fn, cstr_args_pointer, 1, "hash.cstr")
                return null
            # A fixed-size scalar (integer / bool / char / const enum): zero-extend to u64.
            null return if not is_integer_type(key_type) and key_type.kind != TypeKind.Bool
            if emit_expression(key_expression, key_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is scalar_value:
                extended: mutable LLVMValueRef = scalar_value
                extended <- LLVMBuildZExt(builder, scalar_value, int64_type, "hash.zext") if key_type.bits < 64
                u64_params: mutable darray[LLVMTypeRef] = [int64_type]
                u64_pointer: void& = (&u64_params[0]).cast[void&] can Unsafe.PointerCast
                u64_hash_type: LLVMTypeRef = LLVMFunctionType(int64_type, u64_pointer, 1, 0)
                u64_hash_fn: LLVMValueRef = declare_or_get_named(m, "ctx_hash_u64", u64_hash_type)
                u64_args: mutable darray[LLVMValueRef] = [extended]
                u64_args_pointer: void& = (&u64_args[0]).cast[void&] can Unsafe.PointerCast
                return LLVMBuildCall2(builder, u64_hash_type, u64_hash_fn, u64_args_pointer, 1, "hash.u64")
            return null


        # Whether the function declared at `line` returns an error union. The frontend
        # records error-returning functions by LINE in File.error_set_func_lines (the
        # `error[E]` clause is consumed at parse time; only this side table survives).
        def line_is_error_returning(error_lines: darray[u32]&, line: u32) -> bool can[Abort.Panic]:
            for error_line in error_lines |line|:
                true return if error_line == line
            return false


        # Whether a struct holds a darray anywhere in its (recursive) fields — such a struct
        # returned by value carries a darray whose BUFFER must outlive the callee, so the
        # function must thread the caller's arena (build the darray there, not in the callee's
        # auto-region which frees on return → a use-after-free when the caller reads it).
        def struct_contains_darray(struct_type: ValueType, structs: mutable StructTable&) -> bool can[Abort.Panic]:
            false return if struct_type.kind != TypeKind.Struct
            struct_darray_slot: usize = struct_type.bits.usize()
            struct_darray_start: usize = structs.field_start[struct_darray_slot]
            struct_darray_count: usize = structs.field_count[struct_darray_slot]
            for struct_darray_index in 0..<struct_darray_count |structs, struct_darray_start|:
                struct_darray_field: ValueType = copied_type(structs.field_types[struct_darray_start + struct_darray_index])
                true return if struct_darray_field.kind == TypeKind.DArray
                true return if struct_darray_field.kind == TypeKind.Struct and struct_contains_darray(struct_darray_field, structs)
            return false

        def signature_needs_arena(params: darray[ParamDecl]&, return_value_type: ValueType, structs: mutable StructTable&) -> bool can[Abort.Panic]:
            true return if return_value_type.kind == TypeKind.DArray
            true return if return_value_type.kind == TypeKind.Struct and struct_contains_darray(return_value_type, structs)
            for parameter in params |structs|:
                parameter_type: ValueType = annotation_value_type(parameter.type_expression, structs)
                continue if parameter_type.kind != TypeKind.Ref
                arena_param_target: ValueType = ref_target_of(parameter_type, structs)
                # A `darray[T]&` param may be GROWN (`xs.push`); a `Struct&` whose fields hold a
                # darray may grow that field (`b.items.push`). Both need the CALLER's arena
                # threaded so the growth outlives the call (else a use-after-free).
                true return if arena_param_target.kind == TypeKind.DArray
                true return if arena_param_target.kind == TypeKind.Struct and struct_contains_darray(arena_param_target, structs)
            return false


        # The darray ValueType behind `name`, whether it is a local darray or a
        # `darray[T]&` parameter — Unmodeled when it is neither.
        def darray_type_behind(local_scope: mutable Scope&, name: sview, structs: mutable StructTable&) -> ValueType can[Abort.Panic]:
            bound: ValueType = lookup_type(local_scope, name)
            bound return if bound.kind == TypeKind.DArray
            unmodeled_type() return if bound.kind != TypeKind.Ref
            target: ValueType = ref_target_of(bound, structs)
            target return if target.kind == TypeKind.DArray
            return unmodeled_type()


        # The ADDRESS of the darray header named `name`. A local darray IS its slot; a
        # `darray[T]&` parameter's slot holds a POINTER to the CALLER's darray, so it takes
        # one extra load. Every darray operation goes through this so that push/count/index
        # work identically on a local and on a borrowed one.
        # The darray type behind an EXPR receiver: a bare Ident (`xs`) or a struct field
        # holding a darray (`b.items`). Enables container-in-struct ops.
        def darray_type_behind_expr(object: Expr, local_scope: mutable Scope&, structs: mutable StructTable&) -> ValueType can[Abort.Panic]:
            if object is Expr.Ident(darray_name, darray_name_line):
                return darray_type_behind(local_scope, darray_name, structs)
            if object is Expr.Field(darray_inner, darray_field, darray_field_line):
                inner_type: ValueType = struct_chain_type(darray_inner, local_scope, structs)
                unmodeled_type() return if inner_type.kind != TypeKind.Struct
                inner_slot: usize = inner_type.bits.usize()
                position: i64 = field_index_of(structs, inner_slot, darray_field)
                unmodeled_type() return if position < 0
                field_type: ValueType = copied_type(structs.field_types[structs.field_start[inner_slot] + position.usize()])
                field_type return if field_type.kind == TypeKind.DArray
            # `m[i]` where `m: darray[darray[T]]` — the indexed element is itself a darray.
            if object is Expr.Index(indexed_darray, index_darray_expr, index_darray_line):
                indexed_element_type: ValueType = struct_chain_type(object, local_scope, structs)
                indexed_element_type return if indexed_element_type.kind == TypeKind.DArray
            return unmodeled_type()


        # The ADDRESS of the darray header behind an EXPR receiver. For a struct field, the
        # header sits inline, so it is a GEP into the struct's address.
        def darray_address_of_expr(object: Expr, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            if object is Expr.Ident(darray_name, darray_name_line):
                return darray_address_of(local_scope, darray_name, structs, ctx, builder)
            if object is Expr.Field(darray_inner, darray_field, darray_field_line):
                inner_type: ValueType = struct_chain_type(darray_inner, local_scope, structs)
                null return if inner_type.kind != TypeKind.Struct
                inner_slot: usize = inner_type.bits.usize()
                position: i64 = field_index_of(structs, inner_slot, darray_field)
                null return if position < 0
                if struct_chain_address(darray_inner, local_scope, fns, structs, generics, runtime, m, ctx, builder) is inner_address:
                    return LLVMBuildStructGEP2(builder, llvm_type_of(inner_type, structs, ctx), inner_address, position.u32(), "darray.field.ptr")
                return null
            # `m[i]` where `m: darray[darray[T]]` — the address of the inner darray header is
            # the address of that element in the outer buffer (nested-index address).
            if object is Expr.Index(indexed_darray, index_darray_expr, index_darray_line):
                return struct_chain_address(object, local_scope, fns, structs, generics, runtime, m, ctx, builder)
            return null


        def darray_address_of(local_scope: mutable Scope&, name: sview, structs: mutable StructTable&, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic]:
            bound: ValueType = lookup_type(local_scope, name)
            if lookup_slot(local_scope, name) is bound_slot:
                bound_slot return if bound.kind == TypeKind.DArray
                null return if bound.kind != TypeKind.Ref
                null return if ref_target_of(bound, structs).kind != TypeKind.DArray
                return LLVMBuildLoad2(builder, LLVMPointerTypeInContext(ctx, 0), bound_slot, "darray.ref")
            return null


        def ref_target_of(value_type: ValueType, structs: mutable StructTable&) -> ValueType can[Abort.Panic]:
            unmodeled_type() return if value_type.kind != TypeKind.Ref
            return copied_type(structs.ref_targets[value_type.bits.usize()])


        # The element type of a `darray[T]`.
        def darray_element_of(value_type: ValueType, structs: mutable StructTable&) -> ValueType can[Abort.Panic]:
            unmodeled_type() return if value_type.kind != TypeKind.DArray
            return copied_type(structs.darray_elements[value_type.bits.usize()])


        # The size in BYTES of a scalar type — the stride a darray indexes by. Only scalars
        # are modeled as darray elements, so this needs no DataLayout query.
        # The byte stride of a darray/array element as an i64 value. A scalar uses its
        # known width (a literal, so the fast path stays literal); a STRUCT uses LLVMSizeOf,
        # which the datalayout resolves -- this is what lets darray[Struct] compute a correct
        # element size instead of declining.
        def element_stride(element_type: ValueType, structs: mutable StructTable&, ctx: LLVMContextRef) -> LLVMValueRef can[Abort.Panic]:
            # An aggregate element (struct, fixed array, nested darray header, or view fat
            # pointer) is sized by its LLVM type; only a plain scalar has a fixed byte size.
            # A DArray/View element that fell through to scalar_byte_size got stride 0, so the
            # container allocated a 0-byte buffer and every push corrupted memory.
            LLVMSizeOf(llvm_type_of(element_type, structs, ctx)) return if element_type.kind == TypeKind.Struct or element_type.kind == TypeKind.Array or element_type.kind == TypeKind.DArray or element_type.kind == TypeKind.View
            return LLVMConstInt(LLVMInt64TypeInContext(ctx), scalar_byte_size(element_type), 0)


        def scalar_byte_size(value_type: ValueType) -> u64:
            1 return if value_type.kind == TypeKind.Bool
            return (value_type.bits / 8).u64()


        # The element type of an array ValueType.
        def array_element_of(value_type: ValueType, structs: mutable StructTable&) -> ValueType can[Abort.Panic]:
            unmodeled_type() return if value_type.kind != TypeKind.Array
            return copied_type(structs.array_elements[value_type.bits.usize()])


        # The index of const enum `name`, or -1.
        def enum_index_of(structs: mutable StructTable&, name: sview) -> i64 can[Abort.Panic]:
            for index in 0..<structs.enum_names.count |structs, name|:
                index.i64() return if structs.enum_names[index] == name
            return -1


        # The ORDINAL of `variant` in const enum `slot`, or -1. Ordinals are declaration
        # order — that is what stage0 compares against (`icmp eq i8 %c, 0` for the first).
        def enum_ordinal_of(structs: mutable StructTable&, slot: usize, variant: sview) -> i64 can[Abort.Panic]:
            for offset in 0..<structs.enum_variant_count[slot] |structs, slot, variant|:
                offset.i64() return if structs.enum_variants[structs.enum_variant_start[slot] + offset] == variant
            return -1


        # Resolve `Color.Green` -> (backing type, ordinal). Ordinal -1 when it is not a
        # const-enum member.
        def enum_member_ordinal(structs: mutable StructTable&, enum_name: sview, variant: sview) -> i64 can[Abort.Panic]:
            index: i64 = enum_index_of(structs, enum_name)
            -1 return if index < 0
            return enum_ordinal_of(structs, index.usize(), variant)


        # The registry index of struct `name`, or -1.
        def struct_index_of(structs: mutable StructTable&, name: sview) -> i64 can[Abort.Panic]:
            for index in 0..<structs.names.count |structs, name|:
                index.i64() return if structs.names[index] == name
            return -1


        # The position of `field` within struct `struct_index`, or -1. This IS the LLVM
        # element index: fields are emitted in declaration order.
        def field_index_of(structs: mutable StructTable&, struct_index: usize, field: sview) -> i64 can[Abort.Panic]:
            for offset in 0..<structs.field_count[struct_index] |structs, struct_index, field|:
                offset.i64() return if structs.field_names[structs.field_start[struct_index] + offset] == field
            return -1


        # The runtime entry points a darray needs, plus the current function's auto
        # region. Declared once per module and threaded down, because `push` can appear
        # anywhere an expression can.
        #
        # `arena` is the function's AUTO REGION: stage0 gives every function one, zeroed,
        # with strategy 2 (lazy), and `arena_free`s it on every return path. That is the
        # first real piece of Elisa's region model in this backend — container backing
        # lives in a region, not in malloc.
        struct Runtime:
            # `arena` is per-FUNCTION (each gets its own auto region), so it is the one
            # mutable field: the module-level Runtime carries a placeholder that
            # emit_function_body replaces with the function's own region slot.
            arena: mutable LLVMValueRef
            # False when `arena` is the CALLER's, handed over as the implicit trailing
            # parameter. Freeing it then would destroy a region this function does not own
            # and the caller is still using -- so every arena_free is gated on this.
            owns_arena: mutable bool
            arena_alloc: LLVMValueRef
            arena_realloc: LLVMValueRef
            arena_free: LLVMValueRef
            arena_alloc_type: LLVMTypeRef
            arena_realloc_type: LLVMTypeRef
            arena_free_type: LLVMTypeRef
            # `region r(4096):` — a region with an explicit CAPACITY gets its backing up
            # front from the runtime (`call ptr @new_region_backend(i64 4096, i64 0)`)
            # instead of the lazy strategy an auto region uses.
            new_region_backend: LLVMValueRef
            new_region_backend_type: LLVMTypeRef
            # The AoS store's runtime entry points. The store is RUNTIME-CALL based rather
            # than open-coded, which is why porting it is declaring these and calling them.
            packed_state_new: LLVMValueRef
            packed_state_new_type: LLVMTypeRef
            packed_alloc: LLVMValueRef
            packed_alloc_type: LLVMTypeRef
            packed_alloc_result_type: LLVMTypeRef
            packed_read_tag: LLVMValueRef
            packed_read_tag_type: LLVMTypeRef
            packed_read_word: LLVMValueRef
            packed_read_word_type: LLVMTypeRef
            # The store an `in store:` block made ACTIVE, and which packed enum it stores
            # (-1 = none). Threaded on Runtime for the same reason `arena` is: a packed
            # constructor names no store, it uses whichever one is in scope. stage0 is
            # explicit that this is required, not implicit -- "packed enum constructor
            # Node.Leaf requires an active in Node.Store: scope".
            active_store: mutable LLVMValueRef
            active_store_enum: mutable i64
            # When the current function returns an error union: the leading `ptr` out-param
            # (the T value is stored through it) and a flag. A `return x` then stores x to
            # the out-param and returns `i32 0`; a `raise` returns `i32 (ordinal + 1)`.
            error_out: mutable LLVMValueRef
            in_error_fn: mutable bool
            # `cstr == cstr` / `!=` lower to `ctx_streq(a, b)` (i64, nonzero = equal), the
            # same content comparison stage0 emits — NOT a pointer compare.
            streq: LLVMValueRef
            streq_type: LLVMTypeRef
            # `sview == sview` / `!=` lower to `ctx_string_views_eq(a, b)` (i64, nonzero =
            # equal), taking two `%StringView` values BY VALUE.
            sview_eq: LLVMValueRef
            sview_eq_type: LLVMTypeRef
            # `sview[i]` lowers to `ctx_string_view_index(sv, i)` (i64 byte), the view passed
            # BY VALUE.
            sview_index: LLVMValueRef
            sview_index_type: LLVMTypeRef


        # Declare the runtime entry points in the module. Signatures are dictated by
        # elisacore_runtime.o (read from stage0's own emitted IR):
        #   ptr  arena_alloc(ptr arena, i64 bytes)
        #   ptr  arena_realloc(ptr arena, ptr old, i64 old_bytes, i64 new_bytes)
        #   void arena_free(ptr arena)
        def declare_runtime(m: LLVMModuleRef, ctx: LLVMContextRef) -> Runtime can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            pointer_type: LLVMTypeRef = LLVMPointerTypeInContext(ctx, 0)
            int64_type: LLVMTypeRef = LLVMInt64TypeInContext(ctx)

            alloc_params: mutable darray[LLVMTypeRef] = [pointer_type, int64_type]
            alloc_pointer: void& = (&alloc_params[0]).cast[void&] can Unsafe.PointerCast
            alloc_type: LLVMTypeRef = LLVMFunctionType(pointer_type, alloc_pointer, 2, 0)

            realloc_params: mutable darray[LLVMTypeRef] = [pointer_type, pointer_type, int64_type, int64_type]
            realloc_pointer: void& = (&realloc_params[0]).cast[void&] can Unsafe.PointerCast
            realloc_type: LLVMTypeRef = LLVMFunctionType(pointer_type, realloc_pointer, 4, 0)

            free_params: mutable darray[LLVMTypeRef] = [pointer_type]
            free_pointer: void& = (&free_params[0]).cast[void&] can Unsafe.PointerCast
            free_type: LLVMTypeRef = LLVMFunctionType(LLVMVoidTypeInContext(ctx), free_pointer, 1, 0)

            backend_params: mutable darray[LLVMTypeRef] = [LLVMInt64TypeInContext(ctx), LLVMInt64TypeInContext(ctx)]
            backend_pointer: void& = (&backend_params[0]).cast[void&] can Unsafe.PointerCast
            backend_type: LLVMTypeRef = LLVMFunctionType(pointer_type, backend_pointer, 2, 0)

            int32_type: LLVMTypeRef = LLVMInt32TypeInContext(ctx)
            state_new_params: mutable darray[LLVMTypeRef] = [pointer_type, int64_type]
            state_new_pointer: void& = (&state_new_params[0]).cast[void&] can Unsafe.PointerCast
            state_new_type: LLVMTypeRef = LLVMFunctionType(pointer_type, state_new_pointer, 2, 0)

            # `%PackedStoreIndexAllocResult = { ptr row, i32 index }`
            alloc_result_fields: mutable darray[LLVMTypeRef] = [pointer_type, int32_type]
            alloc_result_pointer: void& = (&alloc_result_fields[0]).cast[void&] can Unsafe.PointerCast
            alloc_result_type: LLVMTypeRef = LLVMStructTypeInContext(ctx, alloc_result_pointer, 2, 0)
            packed_alloc_params: mutable darray[LLVMTypeRef] = [pointer_type, pointer_type, int32_type]
            packed_alloc_params_pointer: void& = (&packed_alloc_params[0]).cast[void&] can Unsafe.PointerCast
            alloc_fn_type: LLVMTypeRef = LLVMFunctionType(alloc_result_type, packed_alloc_params_pointer, 3, 0)

            read_tag_params: mutable darray[LLVMTypeRef] = [pointer_type, int32_type]
            read_tag_pointer: void& = (&read_tag_params[0]).cast[void&] can Unsafe.PointerCast
            read_tag_type: LLVMTypeRef = LLVMFunctionType(int32_type, read_tag_pointer, 2, 0)

            read_word_params: mutable darray[LLVMTypeRef] = [int32_type, pointer_type, int64_type]
            read_word_pointer: void& = (&read_word_params[0]).cast[void&] can Unsafe.PointerCast
            read_word_type: LLVMTypeRef = LLVMFunctionType(int64_type, read_word_pointer, 3, 0)

            streq_params: mutable darray[LLVMTypeRef] = [pointer_type, pointer_type]
            streq_pointer: void& = (&streq_params[0]).cast[void&] can Unsafe.PointerCast
            streq_type: LLVMTypeRef = LLVMFunctionType(int64_type, streq_pointer, 2, 0)

            sview_struct_fields: mutable darray[LLVMTypeRef] = [pointer_type, int64_type]
            sview_struct_pointer: void& = (&sview_struct_fields[0]).cast[void&] can Unsafe.PointerCast
            sview_struct_llvm: LLVMTypeRef = LLVMStructTypeInContext(ctx, sview_struct_pointer, 2, 0)
            sview_eq_params: mutable darray[LLVMTypeRef] = [sview_struct_llvm, sview_struct_llvm]
            sview_eq_pointer: void& = (&sview_eq_params[0]).cast[void&] can Unsafe.PointerCast
            sview_eq_type: LLVMTypeRef = LLVMFunctionType(int64_type, sview_eq_pointer, 2, 0)

            sview_index_params: mutable darray[LLVMTypeRef] = [sview_struct_llvm, int64_type]
            sview_index_pointer: void& = (&sview_index_params[0]).cast[void&] can Unsafe.PointerCast
            sview_index_type: LLVMTypeRef = LLVMFunctionType(int64_type, sview_index_pointer, 2, 0)

            return Runtime{
                streq: LLVMAddFunction(m, "ctx_streq", streq_type),
                streq_type: streq_type,
                sview_eq: LLVMAddFunction(m, "ctx_string_views_eq", sview_eq_type),
                sview_eq_type: sview_eq_type,
                sview_index: LLVMAddFunction(m, "ctx_string_view_index", sview_index_type),
                sview_index_type: sview_index_type,
                owns_arena: true,
                active_store: LLVMConstNull(pointer_type),
                active_store_enum: -1,
                error_out: LLVMConstNull(pointer_type),
                in_error_fn: false,
                packed_state_new: LLVMAddFunction(m, "ctx_packed_store_state_new_variant_sparse", state_new_type),
                packed_state_new_type: state_new_type,
                packed_alloc: LLVMAddFunction(m, "ctx_packed_store_alloc_fixed_tagged_variant_sparse_result", alloc_fn_type),
                packed_alloc_type: alloc_fn_type,
                packed_alloc_result_type: alloc_result_type,
                packed_read_tag: LLVMAddFunction(m, "ctx_packed_store_read_variant_sparse_tag", read_tag_type),
                packed_read_tag_type: read_tag_type,
                packed_read_word: LLVMAddFunction(m, "ctx_packed_store_read_variant_sparse_word", read_word_type),
                packed_read_word_type: read_word_type,
                new_region_backend: LLVMAddFunction(m, "new_region_backend", backend_type),
                new_region_backend_type: backend_type,
                arena_alloc: LLVMAddFunction(m, "arena_alloc", alloc_type),
                arena_realloc: LLVMAddFunction(m, "arena_realloc", realloc_type),
                arena_free: LLVMAddFunction(m, "arena_free", free_type),
                arena_alloc_type: alloc_type,
                arena_realloc_type: realloc_type,
                arena_free_type: free_type,
                # No region until a function supplies its own; a null placeholder keeps
                # the module clean (declaring a dummy function to fill this would emit a
                # bogus symbol).
                arena: LLVMConstNull(pointer_type)
            }


        # Generic function TEMPLATES, and the instantiations made from them.
        #
        # The instantiation cache is keyed by (base name, type argument) — NOT by mangled
        # name. That is deliberate: an `sview` is a view, so a mangled name built into a
        # local buffer would DANGLE the moment the buffer's region died (Elisa's region
        # checker catches exactly this). `base_names` are sviews into the SOURCE buffer,
        # which outlives everything, and ValueType is POD — so nothing here borrows.
        #
        # The mangled name is only ever needed transiently, to hand to LLVMAddFunction,
        # which COPIES it. So it is built in a local buffer, used, and dropped.
        #
        # Generic parameter names come from the FILE-level side table
        # (`generic_param_names` / `generic_param_lines`) keyed by the function's LINE —
        # they are NOT on Decl.Func. A row whose line has the high bit set is a BOUND
        # (`[T: Ord]`): metadata the backend never needs, since it only instantiates types
        # the frontend already accepted.
        struct GenericTable:
            names: mutable darray[sview]
            decls: mutable darray[Decl]
            params: mutable darray[sview]
            param_start: mutable darray[usize]
            param_count: mutable darray[usize]
            # Whether each template is ERROR-RETURNING (`… error[E]`): its instantiations must
            # use the i32-status + leading-out-param ABI, in both the signature and the body.
            # Computed at registration from the file's error-line side table (a template has no
            # `error[E]` node on its Decl — the clause is consumed at parse time).
            is_error: mutable darray[bool]
            # Instantiations, keyed by (base name, type-argument TUPLE). A generic may have
            # more than one type parameter (`arena_dict_put[K, T]`), so the arguments live in
            # a flat pool with a per-instantiation span rather than one ValueType per row.
            inst_bases: mutable darray[sview]
            inst_args: mutable darray[ValueType]
            inst_arg_start: mutable darray[usize]
            inst_arg_count: mutable darray[usize]
            inst_handles: mutable darray[LLVMValueRef]
            # The WORKLIST: instantiations declared but whose BODY still needs emitting. A
            # body cannot be emitted at the call site (the builder sits inside the caller),
            # so emit_module drains this afterwards — and keeps draining, because a generic
            # can call another generic. Type args are pooled the same way as inst_args.
            pending_bases: mutable darray[sview]
            pending_args: mutable darray[ValueType]
            pending_arg_start: mutable darray[usize]
            pending_arg_count: mutable darray[usize]
            pending_handles: mutable darray[LLVMValueRef]


        def new_generic_table() -> GenericTable can[Abort.Panic, Memory.Allocate]:
            return GenericTable{names: [], decls: [], params: [], param_start: [], param_count: [], is_error: [], inst_bases: [], inst_args: [], inst_arg_start: [], inst_arg_count: [], inst_handles: [], pending_bases: [], pending_args: [], pending_arg_start: [], pending_arg_count: [], pending_handles: []}


        # Push one type-parameter binding per (param name, type arg) for template `slot`, so
        # annotation_value_type resolves the template's `K`/`T` to the concrete args. Returns
        # the number pushed, to pop symmetrically with pop_type_bindings.
        def push_type_bindings(generics: GenericTable&, structs: mutable StructTable&, slot: usize, type_args: darray[ValueType]&) -> usize can[Abort.Panic, Memory.Allocate]:
            pstart: usize = generics.param_start[slot]
            count: usize = generics.param_count[slot]
            bound: mutable usize = 0
            for k in 0..<count |structs, generics, pstart, type_args, bound, count|:
                break if k >= type_args.count
                structs.binding_names <- structs.binding_names.push(generics.params[pstart + k])
                structs.binding_types <- structs.binding_types.push(copied_type(type_args[k]))
                bound <- bound + 1
            return bound


        def pop_type_bindings(structs: mutable StructTable&, count: usize) -> void can[Abort.Panic, Memory.Allocate]:
            for _drop in 0..<count |structs|:
                _ = structs.binding_names.pop()
                _ = structs.binding_types.pop()


        # The position of type-parameter `name` in template `slot`, or -1. Used by inference
        # to bind the argument that pins that parameter.
        def type_param_position(generics: GenericTable&, slot: usize, name: sview) -> i64 can[Abort.Panic]:
            pstart: usize = generics.param_start[slot]
            count: usize = generics.param_count[slot]
            for k in 0..<count |generics, pstart, name, count|:
                k.i64() return if generics.params[pstart + k] == name
            return -1


        # UNIFY a parameter's type annotation against the CONCRETE type of the argument
        # passed for it, binding any type parameters it names. `mutable`/`&` qualifiers are
        # transparent (the argument's value type is what matters), and a `Base[..]` annotation
        # recurses into a matching generic-struct instantiation's stored arguments — so
        # `dict[K, T]&` unified against a `DynDict[i64, i64]` argument pins K=i64, T=i64.
        def unify_annotation(annotation: Expr, actual: ValueType, generics: GenericTable&, slot: usize, structs: StructTable&, bindings: mutable darray[ValueType]&, bound_flags: mutable darray[bool]&) -> void can[Abort.Panic, Memory.Allocate]:
            if annotation is Expr.Unary(qualifier, inner_annotation, qualifier_line):
                # `mutable T` is transparent. `T&` strips a reference on BOTH sides in step:
                # the argument for a `Bucket[T]&` parameter is often a `Bucket[i64]&` (e.g.
                # `&arr[0]`), so the outer `&` must peel off the actual's Ref too before the
                # inner `Bucket[T]` unifies against the instantiation.
                unify_annotation(inner_annotation, actual, generics, slot, structs, bindings, bound_flags) if qualifier == TokenKind.Mutable
                if qualifier == TokenKind.Ampersand:
                    # Read the referent directly (ref_target_of would demand a mutable table).
                    stripped_actual: ValueType = copied_type(structs.ref_targets[actual.bits.usize()]) if actual.kind == TypeKind.Ref else copied_type(actual)
                    unify_annotation(inner_annotation, stripped_actual, generics, slot, structs, bindings, bound_flags)
                return
            if annotation is Expr.Ident(param_name, param_name_line):
                position: i64 = type_param_position(generics, slot, param_name)
                if position >= 0 and not bound_flags[position.usize()]:
                    bindings[position.usize()] <- copied_type(actual)
                    bound_flags[position.usize()] <- true
                return
            # `view[T]` annotation against a `view[U]` argument — bind T from the view's
            # interned element. Checked before the generic-struct branch (a View is not a
            # struct instantiation), so `arena_da_fill(view, …)` recovers its element type.
            if annotation is Expr.Index(view_annotation_head, view_annotation_arg, view_annotation_line):
                if view_annotation_head is Expr.Ident(view_annotation_name, view_annotation_head_line):
                    if view_annotation_name == "view" and actual.kind == TypeKind.View:
                        unify_annotation(view_annotation_arg, copied_type(structs.view_elements[actual.bits.usize()]), generics, slot, structs, bindings, bound_flags)
                        return
            # `Base[A]` / `Base[A, B]` — recurse into the argument's instantiation arguments
            # when the argument is that same generic struct.
            actual_base: mutable sview = ""
            actual_arg_start: mutable usize = 0
            actual_arg_count: mutable usize = 0
            has_instantiation: bool = generic_struct_instantiation_of(structs, actual, actual_base, actual_arg_start, actual_arg_count)
            return if not has_instantiation
            if annotation is Expr.Index(base_head, single_type_arg, index_line):
                if base_head is Expr.Ident(base_name, base_head_line):
                    mapped_base: sview = "DynDict" if base_name == "dict" else base_name
                    if mapped_base == actual_base and actual_arg_count == 1:
                        unify_annotation(single_type_arg, copied_type(structs.generic_struct_inst_args[actual_arg_start]), generics, slot, structs, bindings, bound_flags)
                return
            if annotation is Expr.IndexN(multi_base_head, multi_type_args, multi_index_line):
                if multi_base_head is Expr.Ident(multi_base_name, multi_base_head_line):
                    mapped_multi_base: sview = "DynDict" if multi_base_name == "dict" else multi_base_name
                    if mapped_multi_base == actual_base and actual_arg_count == multi_type_args.count:
                        for arg_position in 0..<multi_type_args.count |multi_type_args, actual_arg_start, generics, slot, structs, bindings, bound_flags|:
                            unify_annotation(multi_type_args[arg_position], copied_type(structs.generic_struct_inst_args[actual_arg_start + arg_position]), generics, slot, structs, bindings, bound_flags)
                return


        # If `value_type` is a materialized generic-struct instantiation, report its base name
        # and the flat span of its stored type arguments.
        def generic_struct_instantiation_of(structs: StructTable&, value_type: ValueType, out_base: mutable sview&, out_arg_start: mutable usize&, out_arg_count: mutable usize&) -> bool can[Abort.Panic]:
            false return if value_type.kind != TypeKind.Struct
            for inst in 0..<structs.generic_struct_inst_index.count |structs, value_type, out_base, out_arg_start, out_arg_count|:
                if structs.generic_struct_inst_index[inst] == value_type.bits.usize():
                    out_base <- structs.generic_struct_inst_bases[inst]
                    out_arg_start <- structs.generic_struct_inst_arg_start[inst]
                    out_arg_count <- structs.generic_struct_inst_arg_count[inst]
                    return true
            return false


        # Infer a generic function's full type-argument tuple from its call arguments, by
        # unifying each parameter annotation against the argument's concrete type. Returns the
        # inferred tuple, or an empty darray if any parameter stayed unbound (the caller then
        # declines, or requires an explicit `f[K, V](…)`).
        # A bare integer literal, or a unary +/- wrapping one — the forms that carry no
        # expression type of their own but should default to i64 for generic inference.
        def is_int_literal_expr(expression: Expr) -> bool can[Abort.Panic]:
            true return if expression is Expr.IntLit(literal_value)
            if expression is Expr.Unary(unary_operator, unary_operand, unary_line):
                return (unary_operator == TokenKind.Minus or unary_operator == TokenKind.Plus) and is_int_literal_expr(unary_operand)
            if expression is Expr.Paren(paren_inner, paren_line):
                return is_int_literal_expr(paren_inner)
            return false

        def infer_generic_args(slot: usize, arguments: darray[Expr]&, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&) -> darray[ValueType] can[Abort.Panic, Memory.Allocate]:
            count: usize = generics.param_count[slot]
            bindings: mutable darray[ValueType] = [unmodeled_type() for _slot_index in 0..<count]
            bound_flags: mutable darray[bool] = [false for _flag_index in 0..<count]
            no_args: darray[ValueType] = []
            if generics.decls[slot] is Decl.Func(function_name, params, return_type_opt, body, effects, decorators, line):
                limit: usize = params.count if params.count < arguments.count else arguments.count
                for position in 0..<limit |bindings, bound_flags, params, arguments, local_scope, fns, structs, generics, slot|:
                    actual: mutable ValueType = expression_type(arguments[position], local_scope, fns, structs, generics)
                    # An untyped int literal argument (`id(21)`) has no expression type of its
                    # own — like stage0's inference, default it to i64 so a bare type-parameter
                    # binds instead of leaving the call uninferable.
                    actual <- ValueType{kind: TypeKind.Signed, bits: 64} if actual.kind == TypeKind.Unmodeled and is_int_literal_expr(arguments[position])
                    continue if actual.kind == TypeKind.Unmodeled
                    unify_annotation(params[position].type_expression, actual, generics, slot, structs, bindings, bound_flags)
            for flag_index in 0..<count |bound_flags, no_args, count|:
                no_args return if not bound_flags[flag_index]
            return bindings


        # The index of generic template `name`, or -1.
        def generic_index_of(generics: GenericTable&, name: sview) -> i64 can[Abort.Panic]:
            for index in 0..<generics.names.count |generics, name|:
                index.i64() return if generics.names[index] == name
            return -1


        # The already-declared instantiation for (base, type-argument tuple), or null.
        def instantiation_of(generics: GenericTable&, base: sview, type_args: darray[ValueType]&) -> LLVMValueRef? can[Abort.Panic]:
            for index in 0..<generics.inst_bases.count |generics, base, type_args|:
                continue if generics.inst_bases[index] != base
                continue if generics.inst_arg_count[index] != type_args.count
                astart: usize = generics.inst_arg_start[index]
                matched: mutable bool = true
                for k in 0..<type_args.count |generics, matched, astart, type_args|:
                    stored: ValueType = generics.inst_args[astart + k]
                    matched <- false if stored.kind != type_args[k].kind or stored.bits != type_args[k].bits
                generics.inst_handles[index] return if matched
            return null


        # A function's local slots: `names[i]` lives in the `alloca` at `slots[i]`.
        # Parallel darrays rather than a dict: scopes are tiny (a handful of locals), a
        # linear scan beats hashing, and it keeps the opaque extern handle out of a dict's
        # key/value machinery.
        struct Scope:
            names: mutable darray[sview]
            slots: mutable darray[LLVMValueRef]
            types: mutable darray[ValueType]


        # The module's functions by name. Built in emit_module's declare pass, so a call
        # to a function defined LATER in the file still resolves.
        #
        # Kept here rather than asking LLVMGetNamedFunction: that returns NULL-or-pointer,
        # i.e. it needs `-> LLVMValueRef?`, and an extern returning an optional of an
        # opaque extern type always binds null in stage0 (silent, no diagnostic). We
        # already know every function we declared, so this is also just less work.
        struct FnTable:
            names: mutable darray[sview]
            # The enclosing MODULE's name, or "" for a top-level function. Functions are
            # keyed on the (owner, name) PAIR rather than on a mangled "M.get" string:
            # `names` are sviews into the SOURCE buffer, and a synthesized name has no
            # source text to point at — an sview into a growing darray would dangle. The
            # mangled form is built only as a temporary cstr for the LLVM symbol.
            owners: mutable darray[sview]
            # True when the function has an implicit trailing arena parameter (it takes a
            # growable container by reference). The CALL SITE must then pass its own arena.
            needs_arena: mutable darray[bool]
            # True when the function returns an error union `T error[E]`: its LLVM signature
            # is `i32 @f(ptr out, <params>)` -- an i32 error code, with the T value written
            # through a leading out-pointer. `returns[i]` still holds T (the success type).
            is_error: mutable darray[bool]
            handles: mutable darray[LLVMValueRef]
            returns: mutable darray[ValueType]
            # Parameter types as a FLAT pool plus a per-function span (`param_start[i]`,
            # `param_count[i]`) — a nested `darray[darray[ValueType]]` would make this
            # region-polymorphic for no benefit.
            param_types: mutable darray[ValueType]
            param_start: mutable darray[usize]
            param_count: mutable darray[usize]


        # The enclosing loops' branch targets, innermost LAST. `break` jumps to
        # `exits[last]`, `continue` to `continues[last]`. A loop pushes before emitting its
        # body and pops after, so a `break` outside any loop finds an empty stack and
        # DECLINES rather than emitting a wild branch.
        #
        # `continue` targets differ per loop form: a `while` continues to its condition
        # block, a `for` to its INCREMENT block (skipping the increment would make
        # `continue` an infinite loop).
        struct LoopStack:
            exits: mutable darray[LLVMBasicBlockRef]
            continues: mutable darray[LLVMBasicBlockRef]


        # The OWNED regions currently live, outermost FIRST. A `return` has to unwind every
        # one of them, not just the innermost: stage0's IR for a return inside `region r:`
        # frees `%r` AND the enclosing function's auto region on that path.
        #
        # Only OWNED regions are listed. A threaded (borrowed) arena belongs to the caller
        # and is never freed here, so an arena-threading function's stack is simply empty.
        struct RegionStack:
            arenas: mutable darray[LLVMValueRef]


        # Free every live owned region, innermost FIRST (reverse declaration order), which is
        # the order stage0 emits them in.
        def emit_region_unwind(regions: RegionStack&, runtime: Runtime&, builder: LLVMBuilderRef) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            index: mutable i64 = regions.arenas.count.i64() - 1
            while index >= 0 |index, regions, runtime, builder|:
                scoped: mutable Runtime = copied_runtime(runtime)
                scoped.arena <- regions.arenas[index.usize()]
                scoped.owns_arena <- true
                emit_region_free(scoped, builder)
                index <- index - 1


        # What emitting a statement did to control flow.
        #
        # `Terminated` means the statement ended the block (a `return`, or an `if` whose
        # arms all returned). The emitter tracks this itself instead of asking
        # LLVMGetBasicBlockTerminator — same optional-extern bug as FnTable — and it is
        # the better design regardless: LLVM rejects a block with two terminators, so the
        # emitter must know whether a block is still open BEFORE it appends a branch.
        const enum EmitStatus of u8:
            Declined
            Open
            Terminated


        # The handle for `owner::name`, or null when there is no such function.
        def lookup_function(fns: FnTable&, owner: sview, name: sview) -> LLVMValueRef? can[Abort.Panic]:
            for index in 0..<fns.names.count |fns, owner, name|:
                fns.handles[index] return if fns.names[index] == name and fns.owners[index] == owner
            return null


        # The index of `name` in the scope, or -1. Scanned back to front so a later
        # (shadowing) declaration wins.
        def lookup_index(local_scope: mutable Scope&, name: sview) -> i64 can[Abort.Panic]:
            index: mutable i64 = local_scope.names.count.i64() - 1
            while index >= 0 |local_scope, name, index|:
                index return if local_scope.names[index.usize()] == name
                index <- index - 1
            return -1


        # The alloca backing `name`, or null when the name is not a local.
        def lookup_slot(local_scope: mutable Scope&, name: sview) -> LLVMValueRef? can[Abort.Panic]:
            index: i64 = lookup_index(local_scope, name)
            null return if index < 0
            return local_scope.slots[index.usize()]


        # The declared type of `name`, or Unmodeled when it is not a local.
        def lookup_type(local_scope: mutable Scope&, name: sview) -> ValueType can[Abort.Panic]:
            index: i64 = lookup_index(local_scope, name)
            unmodeled_type() return if index < 0
            return copied_type(local_scope.types[index.usize()])


        # Record a local: name, slot and declared type, kept index-parallel.
        def declare_local(local_scope: mutable Scope&, name: sview, slot: LLVMValueRef, value_type: ValueType) -> void can[Abort.Panic, Memory.Allocate]:
            local_scope.names <- local_scope.names.push(name)
            local_scope.slots <- local_scope.slots.push(slot)
            local_scope.types <- local_scope.types.push(value_type)


        # The declared type of function `name`'s parameter `position`, or Unmodeled.
        # Emitting each argument at its parameter's type is what makes a literal argument
        # adopt the parameter type instead of defaulting to i64.
        def param_type_of(fns: FnTable&, owner: sview, name: sview, position: usize) -> ValueType can[Abort.Panic]:
            for index in 0..<fns.names.count |fns, owner, name, position|:
                if fns.names[index] == name and fns.owners[index] == owner:
                    unmodeled_type() return if position >= fns.param_count[index]
                    return copied_type(fns.param_types[fns.param_start[index] + position])
            return unmodeled_type()


        # The declared return type of `name`, or Unmodeled when the module has no such
        # function.
        def lookup_return_type(fns: FnTable&, owner: sview, name: sview) -> ValueType can[Abort.Panic]:
            for index in 0..<fns.names.count |fns, owner, name|:
                copied_type(fns.returns[index]) return if fns.names[index] == name and fns.owners[index] == owner
            return unmodeled_type()


        # The type an expression yields, WITHOUT emitting anything.
        #
        # Bottom-up, and deliberately partial: an integer LITERAL has no type of its own
        # (Unmodeled) and adopts whatever its context supplies. That is why the emitters
        # thread an `expected` type downward — `a: u8 = 200` must make 200 a u8, not an
        # i64 that is then silently truncated.
        def expression_type(expression: Expr, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&) -> ValueType can[Abort.Panic]:
            if expression is Expr.Ident(ident_name, ident_line):
                # A LOCAL shadows a global const, so the scope is consulted first.
                local_type: ValueType = lookup_type(local_scope, ident_name)
                local_type return if local_type.kind != TypeKind.Unmodeled
                const_index: i64 = const_index_of(structs, ident_name)
                copied_type(structs.const_types[const_index.usize()]) return if const_index >= 0 and structs.const_resolved[const_index.usize()]
                # A global const AGGREGATE is not scalar-folded but still has a known type.
                copied_type(structs.const_types[const_index.usize()]) return if const_index >= 0 and structs.const_global_ok[const_index.usize()]
                return unmodeled_type()
            if expression is Expr.Paren(paren_inner, paren_line):
                return expression_type(paren_inner, local_scope, fns, structs, generics)
            # A move has the moved value's type: it transfers ownership, not representation.
            if expression is Expr.Move(moved_value, move_line):
                return expression_type(moved_value, local_scope, fns, structs, generics)
            if expression is Expr.BoolLit(bool_value):
                return ValueType{kind: TypeKind.Bool, bits: 1}
            # A STRING literal has a type of its own (cstr) — unlike an int literal, which
            # defers to its context. There is no other string type in the subset for it to
            # adopt, and stage0 gives `"hi"` a cstr regardless of context.
            if expression is Expr.StringLit(string_text):
                return ValueType{kind: TypeKind.CStr, bits: 0}
            # A FLOAT literal, like an int literal, defers to its context (`x: f32 = 1.5`),
            # so it reports Unmodeled here rather than pinning itself to f64.
            if expression is Expr.Unary(unary_operator, unary_operand, unary_line):
                # `not x` is a bool whatever `x` is; `-x` / `~x` keep the operand's type.
                ValueType{kind: TypeKind.Bool, bits: 1} return if unary_operator == TokenKind.Not or unary_operator == TokenKind.Bang
                # `&place` is a reference to the place's type.
                if unary_operator == TokenKind.Ampersand:
                    place_type: ValueType = expression_type(unary_operand, local_scope, fns, structs, generics)
                    unmodeled_type() return if place_type.kind == TypeKind.Unmodeled
                    return intern_ref_type(place_type, structs)
                return expression_type(unary_operand, local_scope, fns, structs, generics)
            if expression is Expr.Binary(binary_left, binary_operator, binary_right, binary_line):
                # A comparison, logical, or `is` narrowing yields bool regardless of operands.
                ValueType{kind: TypeKind.Bool, bits: 1} return if binary_operator == TokenKind.Is
                ValueType{kind: TypeKind.Bool, bits: 1} return if int_predicate_of(binary_operator) >= 0
                ValueType{kind: TypeKind.Bool, bits: 1} return if binary_operator == TokenKind.And or binary_operator == TokenKind.Or
                # Arithmetic keeps the operands' type: take whichever side is known, since
                # a literal contributes nothing.
                left_type: ValueType = expression_type(binary_left, local_scope, fns, structs, generics)
                left_type return if left_type.kind != TypeKind.Unmodeled
                return expression_type(binary_right, local_scope, fns, structs, generics)
            # `x.cast[T]` — a reinterpret cast has the target type.
            if expression is Expr.Index(cast_type_head, cast_type_arg, cast_type_line):
                if cast_type_head is Expr.Field(cast_type_source, cast_type_method, cast_type_method_line):
                    if cast_type_method == "cast":
                        return annotation_value_type(cast_type_arg, structs)
            # `xs[i]` — an index READ yields the element type of an array, a darray, OR a
            # `Struct&` used as a C-style pointer base (`items[i]` on a `DictBucket[K,T]&`).
            if expression is Expr.Index(indexed_object, index_expression, index_line):
                indexed_type: ValueType = expression_type(indexed_object, local_scope, fns, structs, generics)
                # A byte read from a string (cstr / view[u8]) is an i64 (the runtime index
                # helpers return i64), matching stage0.
                ValueType{kind: TypeKind.Signed, bits: 64} return if indexed_type.kind == TypeKind.CStr or indexed_type.kind == TypeKind.SView
                darray_element_of(indexed_type, structs) return if indexed_type.kind == TypeKind.DArray
                if indexed_type.kind == TypeKind.Ref:
                    ref_indexed_element: ValueType = ref_target_of(indexed_type, structs)
                    ref_indexed_element return if ref_indexed_element.kind == TypeKind.Struct
                return array_element_of(indexed_type, structs)
            # `p.x` — a field READ has the field's declared type. (A cast `x.u8()` is a
            # Field under a Call, handled below, so a bare Field is always a field read.)
            # `Color.Green` has the enum's BACKING type.
            if expression is Expr.Field(enum_head, enum_member, enum_head_line):
                if enum_head is Expr.Ident(enum_head_name, enum_head_name_line):
                    penum_head_index: i64 = penum_index_of(structs, enum_head_name)
                    ValueType{kind: TypeKind.PayloadEnum, bits: penum_head_index.u32()} return if penum_head_index >= 0
                    enum_slot: i64 = enum_index_of(structs, enum_head_name)
                    if enum_slot >= 0:
                        copied_type(structs.enum_backings[enum_slot.usize()]) return if enum_ordinal_of(structs, enum_slot.usize(), enum_member) >= 0
            if expression is Expr.Field(field_object, field_name, field_line):
                object_type: mutable ValueType = expression_type(field_object, local_scope, fns, structs, generics)
                # AUTO-DEREF: `p.x` where `p: P&` reads P's field. A reference is
                # transparent for member access — the frontend has already decided the
                # access is legal, so the backend just looks through it. An optional HEAP
                # ref (`heap T&?`) is looked through too: stage0 represents it as a bare
                # ptr and permits flow-guarded access without narrowing.
                if object_type.kind == TypeKind.Optional:
                    field_opt_payload: ValueType = optional_payload_of(object_type, structs)
                    object_type <- field_opt_payload if field_opt_payload.kind == TypeKind.Ref and ref_is_heap_ref(field_opt_payload, structs)
                object_type <- ref_target_of(object_type, structs) if object_type.kind == TypeKind.Ref
                # An arena CARRIER's fields read the user-declared `struct Arena`.
                object_type <- arena_user_struct(structs) if object_type.kind == TypeKind.Arena
                # `xs.count` is a usize-shaped i64.
                ValueType{kind: TypeKind.Signed, bits: 64} return if object_type.kind == TypeKind.DArray and field_name == "count"
                # A `view[T]` field read goes through its DynArrayView struct.
                object_type <- view_struct_type(object_type, structs) if object_type.kind == TypeKind.View
                unmodeled_type() return if object_type.kind != TypeKind.Struct
                struct_slot: usize = object_type.bits.usize()
                position: i64 = field_index_of(structs, struct_slot, field_name)
                unmodeled_type() return if position < 0
                return copied_type(structs.field_types[structs.field_start[struct_slot] + position.usize()])
            # `Point{x: 1, y: 2}` — a brace construction has the constructed type.
            if expression is Expr.Construct(construct_type, construct_fields, construct_line):
                return annotation_value_type(construct_type, structs)
            if expression is Expr.Call(call_callee, call_arguments, call_argument_names, call_line):
                # `x.u8()` is a CAST (postfix call unifies cast and UFCS: `recv.Name()`
                # where Name is a type name is a conversion).
                if call_callee is Expr.Field(cast_object, cast_name, cast_line):
                    if cast_object is Expr.Ident(packed_call_enum, packed_call_enum_line):
                        packed_call_index: i64 = packed_index_of(structs, packed_call_enum)
                        ValueType{kind: TypeKind.PackedEnum, bits: packed_call_index.u32()} return if packed_call_index >= 0 and cast_name != "Store"
                    if cast_object is Expr.Ident(store_type_enum, store_type_enum_line):
                        if cast_name == "Store":
                            store_type_index: i64 = packed_index_of(structs, store_type_enum)
                            ValueType{kind: TypeKind.PackedStore, bits: store_type_index.u32()} return if store_type_index >= 0
                    # `Shape.Circle(42)` is a payload-enum CONSTRUCTOR and has the enum's
                    # type. Checked before the cast/UFCS split: the head is an enum NAME, so
                    # neither of those readings applies.
                    if cast_object is Expr.Ident(ctor_enum_name, ctor_enum_line):
                        ctor_index: i64 = penum_index_of(structs, ctor_enum_name)
                        ValueType{kind: TypeKind.PayloadEnum, bits: ctor_index.u32()} return if ctor_index >= 0
                    # A dict receiver's `.get`/`.put`/… is a synthesized std-generic call —
                    # its type is that helper's return annotation resolved under the receiver's
                    # (K, T). Needed so `if d.get(k) is v:` can see the `T&?` it narrows.
                    dict_return_args: darray[ValueType] = dict_type_args_of(cast_object, local_scope, fns, structs, generics)
                    if dict_return_args.count != 0:
                        dict_return_helper: sview = dict_method_helper(cast_name)
                        if dict_return_helper != "":
                            return generic_return_type(dict_return_helper, dict_return_args, generics, structs)
                    # A type name is a CAST and has that type; anything else is UFCS
                    # (`p.get()` == `get(p)`) and has the FUNCTION's return type. Without
                    # the second case a UFCS call reports Unmodeled and every
                    # type-directed check downstream silently stops applying.
                    cast_type: ValueType = scalar_type_of_name(cast_name)
                    cast_type return if cast_type.kind != TypeKind.Unmodeled
                    return lookup_return_type(fns, "", cast_name)
                # `f[i64](x)` — an explicit generic call. Its type is the template's return
                # annotation resolved under that binding, which for `-> T` is the type
                # argument itself.
                if call_callee is Expr.Index(generic_head, generic_type_argument, generic_head_line):
                    if generic_head is Expr.Ident(generic_head_name, generic_head_name_line):
                        if generic_index_of(generics, generic_head_name) >= 0:
                            single_return_args: mutable darray[ValueType] = [annotation_value_type(generic_type_argument, structs)]
                            return generic_return_type(generic_head_name, single_return_args, generics, structs)
                # `f[K, V](x)` — an explicit MULTI-argument generic call's type.
                if call_callee is Expr.IndexN(multi_head, multi_head_args, multi_head_line):
                    if multi_head is Expr.Ident(multi_head_name, multi_head_name_line):
                        if generic_index_of(generics, multi_head_name) >= 0:
                            multi_return_args: mutable darray[ValueType] = []
                            for multi_return_arg_expr in multi_head_args |multi_return_args, structs|:
                                multi_return_args.push(annotation_value_type(multi_return_arg_expr, structs))
                            return generic_return_type(multi_head_name, multi_return_args, generics, structs)
                if call_callee is Expr.Ident(callee_name, callee_line):
                    # The `ctx_hash_value` builtin returns u64.
                    ValueType{kind: TypeKind.Unsigned, bits: 64} return if callee_name == "ctx_hash_value"
                    ValueType{kind: TypeKind.Unsigned, bits: 64} return if callee_name == "size_of"
                    intern_ref_type(ValueType{kind: TypeKind.Void, bits: 0}, structs) return if callee_name == "arena_alloc"
                    # A GENERIC template is NOT in `fns` — only its instantiations are —
                    # so it must be resolved through the template. Without this a generic
                    # call reports Unmodeled and every type-directed check downstream
                    # (operand typing, the mixed-width guard) silently stops applying.
                    if generic_index_of(generics, callee_name) >= 0:
                        unmodeled_type() return if call_arguments.count == 0
                        inferred_return_slot: usize = generic_index_of(generics, callee_name).usize()
                        inferred_return_args: darray[ValueType] = infer_generic_args(inferred_return_slot, call_arguments, local_scope, fns, structs, generics)
                        unmodeled_type() return if inferred_return_args.count == 0
                        return generic_return_type(callee_name, inferred_return_args, generics, structs)
                    return lookup_return_type(fns, "", callee_name)
                # A module-qualified call's type is the qualified function's return type.
                if call_callee is Expr.Scope(scope_head, scope_name, scope_line):
                    if scope_head is Expr.Ident(module_name, module_name_line):
                        return lookup_return_type(fns, module_name, scope_name)
            return unmodeled_type()


        # Map an Elisa comparison token to an LLVMIntPredicate, or -1 when the operator is
        # not a comparison. Signed predicates (SLT/SLE/SGT/SGE): the subset is i64.
        def int_predicate_of(operator: TokenKind) -> i32:
            32 return if operator == TokenKind.EqEq
            33 return if operator == TokenKind.BangEq
            40 return if operator == TokenKind.Lt
            41 return if operator == TokenKind.LtEq
            38 return if operator == TokenKind.Gt
            39 return if operator == TokenKind.GtEq
            return -1


        # The same comparison for an UNSIGNED operand type. Equality is signedness-free
        # (32/33); ordering is not — SLT(40)/SLE(41)/SGT(38)/SGE(39) become
        # ULT(36)/ULE(37)/UGT(34)/UGE(35). Comparing `u8 200 < 3` with SLT reads 200 as
        # -56 and answers TRUE.
        def unsigned_predicate_of(predicate: i32) -> i32:
            36 return if predicate == 40
            37 return if predicate == 41
            34 return if predicate == 38
            35 return if predicate == 39
            return predicate


        # Emit `left <op> right` for the modeled signed-i64 operators. `null` = unmodeled,
        # so a bitwise/logical op declines rather than emitting something wrong.
        #
        # A comparison yields an `i1`; every modeled value is an i64, so the i1 is
        # zero-extended back to i64. Conditions re-narrow with `!= 0` (emit_condition),
        # which keeps ONE uniform value representation instead of tracking i1-vs-i64.
        #
        # SDiv/SRem (not UDiv/URem): the subset is signed. Elisa's `%` is LLVM's `srem`
        # (sign follows the DIVIDEND: -7 % 2 == -1) — verified against stage0, which
        # selects the same instruction for a signed operand type.
        # The ORDERED float predicate matching an integer one. Ordered = any comparison
        # with NaN is false, which is IEEE `==` / `<` semantics.
        # OEQ=1, OGT=2, OGE=3, OLT=4, OLE=5, ONE=6.
        def float_predicate_of(operator: TokenKind) -> i32:
            1 return if operator == TokenKind.EqEq
            6 return if operator == TokenKind.BangEq
            4 return if operator == TokenKind.Lt
            5 return if operator == TokenKind.LtEq
            2 return if operator == TokenKind.Gt
            3 return if operator == TokenKind.GtEq
            return -1


        def emit_binary(operator: TokenKind, left: LLVMValueRef, right: LLVMValueRef, operand_type: ValueType, structs: mutable StructTable&, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic]:
            # Floats are a different instruction family end to end: fadd/fdiv/fcmp, never
            # add/sdiv/icmp. Bitwise and shifts have no float form and decline.
            if operand_type.kind == TypeKind.Float:
                LLVMBuildFAdd(builder, left, right, "fadd") return if operator == TokenKind.Plus
                LLVMBuildFSub(builder, left, right, "fsub") return if operator == TokenKind.Minus
                LLVMBuildFMul(builder, left, right, "fmul") return if operator == TokenKind.Star
                LLVMBuildFDiv(builder, left, right, "fdiv") return if operator == TokenKind.Slash
                LLVMBuildFRem(builder, left, right, "frem") return if operator == TokenKind.Percent
                float_predicate: i32 = float_predicate_of(operator)
                LLVMBuildFCmp(builder, float_predicate, left, right, "fcmp") return if float_predicate >= 0
                return null
            unsigned: bool = operand_type.kind == TypeKind.Unsigned
            LLVMBuildAdd(builder, left, right, "add") return if operator == TokenKind.Plus
            LLVMBuildSub(builder, left, right, "sub") return if operator == TokenKind.Minus
            LLVMBuildMul(builder, left, right, "mul") return if operator == TokenKind.Star
            LLVMBuildAnd(builder, left, right, "and") return if operator == TokenKind.Ampersand
            LLVMBuildOr(builder, left, right, "or") return if operator == TokenKind.Pipe
            LLVMBuildXor(builder, left, right, "xor") return if operator == TokenKind.Caret
            LLVMBuildShl(builder, left, right, "shl") return if operator == TokenKind.LShift

            # Signedness picks the INSTRUCTION, and it is observable: stage0 gives
            # `u8 200 / 3` == 66 (udiv) and `u8 200 >> 1` == 100 (lshr); the signed forms
            # answer -56 and 228.
            if operator == TokenKind.Slash:
                return LLVMBuildUDiv(builder, left, right, "div") if unsigned else LLVMBuildSDiv(builder, left, right, "div")
            if operator == TokenKind.Percent:
                return LLVMBuildURem(builder, left, right, "rem") if unsigned else LLVMBuildSRem(builder, left, right, "rem")
            if operator == TokenKind.RShift:
                return LLVMBuildLShr(builder, left, right, "shr") if unsigned else LLVMBuildAShr(builder, left, right, "shr")

            predicate: i32 = int_predicate_of(operator)
            if predicate >= 0:
                resolved: i32 = unsigned_predicate_of(predicate) if unsigned else predicate
                # A comparison yields an i1 — the modeled `bool` — NOT a widened int.
                return LLVMBuildICmp(builder, resolved, left, right, "cmp")
            return null


        # Parse an integer pattern's literal TEXT (`Pattern.Literal` carries raw source
        # text, not a value). False when it is not a plain decimal integer, so a
        # char/string/float pattern DECLINES instead of being misread as a number.
        def parse_int_literal(text: sview, out_value: mutable i64&) -> bool can[Abort.Panic]:
            false return if sview_len(text) == 0
            negative: bool = sview_at(text, 0) == 45
            start: usize = 1 if negative else 0
            false return if sview_len(text) == start
            accumulated: mutable i64 = 0
            ok: mutable bool = true
            for index in start..<sview_len(text) |accumulated, ok, text|:
                byte: u8 = sview_at(text, index)
                if byte < 48 or byte > 57:
                    ok <- false
                else:
                    accumulated <- accumulated * 10 + (byte.i64() - 48)
            false return if not ok
            out_value <- 0 - accumulated if negative else accumulated
            return true


        # `Color.Red` -> its ordinal, or -1 if the path is not a const-enum member.
        # Whether a LABELLED call is a payload-enum constructor whose label is the payload
        # field's real name: `Shape.Circle(r: 42)` where the field is declared `r`. A label
        # that names something else is a different program, so it must not be emitted as
        # this constructor.
        def penum_ctor_labels_match(callee: Expr, argument_names: darray[sview]&, structs: mutable StructTable&) -> bool can[Abort.Panic]:
            false return if argument_names.count != 1
            if callee is Expr.Field(label_head, label_variant, label_line):
                if label_head is Expr.Ident(label_enum, label_enum_line):
                    label_enum_index: i64 = penum_index_of(structs, label_enum)
                    false return if label_enum_index < 0
                    label_tag: i64 = penum_variant_index(structs, label_enum_index, label_variant)
                    false return if label_tag < 0
                    slot: usize = structs.penum_variant_start[label_enum_index.usize()] + label_tag.usize()
                    false return if not structs.penum_has_payload[slot]
                    return structs.penum_field_names[slot] == argument_names[0]
            return false


        def packed_variant_index_of_path(path: sview, structs: mutable StructTable&) -> i64 can[Abort.Panic]:
            dot: mutable i64 = -1
            for index in 0..<sview_len(path) |dot, path|:
                dot <- index.i64() if sview_at(path, index) == 46
            -1 return if dot <= 0
            for enum_index in 0..<structs.packed_names.count |structs, path, dot|:
                continue if not sview_matches_prefix(path, structs.packed_names[enum_index], 0, dot)
                for offset in 0..<structs.packed_variant_count[enum_index] |structs, path, dot, enum_index|:
                    variant: sview = structs.packed_variants[structs.packed_variant_start[enum_index] + offset]
                    offset.i64() return if sview_matches_prefix(path, variant, dot + 1, sview_len(path).i64())
            return -1


        def packed_payload_of_path(path: sview, structs: mutable StructTable&) -> ValueType can[Abort.Panic]:
            dot: mutable i64 = -1
            for index in 0..<sview_len(path) |dot, path|:
                dot <- index.i64() if sview_at(path, index) == 46
            unmodeled_type() return if dot <= 0
            for enum_index in 0..<structs.packed_names.count |structs, path, dot|:
                continue if not sview_matches_prefix(path, structs.packed_names[enum_index], 0, dot)
                for offset in 0..<structs.packed_variant_count[enum_index] |structs, path, dot, enum_index|:
                    slot: usize = structs.packed_variant_start[enum_index] + offset
                    continue if not sview_matches_prefix(path, structs.packed_variants[slot], dot + 1, sview_len(path).i64())
                    unmodeled_type() return if not structs.packed_has_payload[slot]
                    return copied_type(structs.packed_payloads[slot])
            return unmodeled_type()


        # The packed twin of penum_ctor_labels_match: `new Node.Leaf(v: 42)` labels the
        # payload field, and the label must be the field's real name.
        def packed_ctor_labels_match(callee: Expr, argument_names: darray[sview]&, structs: mutable StructTable&) -> bool can[Abort.Panic]:
            # With a `common:` block a constructor carries commons THEN the payload
            # (`new Expr.Int(span: 1, value: 42)`), so more than one label is legitimate.
            # Only the payload label is checked against its declared name here; the commons
            # are positional-by-construction (the parser prepends them in order).
            true return if argument_names.count > 1
            false return if argument_names.count != 1
            if callee is Expr.Field(packed_label_head, packed_label_variant, packed_label_line):
                if packed_label_head is Expr.Ident(packed_label_enum, packed_label_enum_line):
                    packed_label_index: i64 = packed_index_of(structs, packed_label_enum)
                    false return if packed_label_index < 0
                    packed_label_tag: i64 = packed_variant_index(structs, packed_label_index, packed_label_variant)
                    false return if packed_label_tag < 0
                    packed_label_slot: usize = structs.packed_variant_start[packed_label_index.usize()] + packed_label_tag.usize()
                    false return if not structs.packed_has_payload[packed_label_slot]
                    return structs.packed_field_names[packed_label_slot] == argument_names[0]
            return false


        # `Shape.Circle` -> the variant's TAG, or -1. Same byte-comparison approach as
        # ordinal_of_dotted_path, against the payload-enum pools.
        def penum_variant_index_of_path(path: sview, structs: mutable StructTable&) -> i64 can[Abort.Panic]:
            dot: mutable i64 = -1
            for index in 0..<sview_len(path) |dot, path|:
                dot <- index.i64() if sview_at(path, index) == 46
            -1 return if dot <= 0
            for enum_index in 0..<structs.penum_names.count |structs, path, dot|:
                continue if not sview_matches_prefix(path, structs.penum_names[enum_index], 0, dot)
                for offset in 0..<structs.penum_variant_count[enum_index] |structs, path, dot, enum_index|:
                    variant: sview = structs.penum_variants[structs.penum_variant_start[enum_index] + offset]
                    offset.i64() return if sview_matches_prefix(path, variant, dot + 1, sview_len(path).i64())
            return -1


        # `Shape.Circle` -> its payload's ValueType, or Unmodeled when the path names no
        # payload-carrying variant.
        def penum_payload_of_path(path: sview, structs: mutable StructTable&) -> ValueType can[Abort.Panic]:
            dot: mutable i64 = -1
            for index in 0..<sview_len(path) |dot, path|:
                dot <- index.i64() if sview_at(path, index) == 46
            unmodeled_type() return if dot <= 0
            for enum_index in 0..<structs.penum_names.count |structs, path, dot|:
                continue if not sview_matches_prefix(path, structs.penum_names[enum_index], 0, dot)
                for offset in 0..<structs.penum_variant_count[enum_index] |structs, path, dot, enum_index|:
                    slot: usize = structs.penum_variant_start[enum_index] + offset
                    continue if not sview_matches_prefix(path, structs.penum_variants[slot], dot + 1, sview_len(path).i64())
                    unmodeled_type() return if not structs.penum_has_payload[slot]
                    return copied_type(structs.penum_payloads[slot])
            return unmodeled_type()

        # The variant-slot for `Enum.Variant` (an index into the per-variant pools), or -1.
        def penum_slot_of_path(path: sview, structs: mutable StructTable&) -> i64 can[Abort.Panic]:
            dot: mutable i64 = -1
            for index in 0..<sview_len(path) |dot, path|:
                dot <- index.i64() if sview_at(path, index) == 46
            -1 return if dot <= 0
            for enum_index in 0..<structs.penum_names.count |structs, path, dot|:
                continue if not sview_matches_prefix(path, structs.penum_names[enum_index], 0, dot)
                for offset in 0..<structs.penum_variant_count[enum_index] |structs, path, dot, enum_index|:
                    slot: usize = structs.penum_variant_start[enum_index] + offset
                    (structs.penum_variant_start[enum_index] + offset).i64() return if sview_matches_prefix(path, structs.penum_variants[slot], dot + 1, sview_len(path).i64())
            return -1

        # The `{T0, T1, …}` tuple LLVM type over a MULTI-FIELD variant-slot's fields — the
        # value stored into (and loaded from) the `[N x i64]` payload blob. Only meaningful
        # when `penum_field_type_count[slot] > 1`.
        def penum_field_tuple_type(slot: usize, structs: mutable StructTable&, ctx: LLVMContextRef) -> LLVMTypeRef can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            field_count: usize = structs.penum_field_type_count[slot]
            field_start: usize = structs.penum_field_type_start[slot]
            field_llvm: mutable darray[LLVMTypeRef] = []
            for field_index in 0..<field_count |field_llvm, field_start, structs, ctx|:
                field_llvm.push(llvm_type_of(copied_type(structs.penum_field_types[field_start + field_index]), structs, ctx))
            field_pointer: void& = (&field_llvm[0]).cast[void&] can Unsafe.PointerCast
            return LLVMStructTypeInContext(ctx, field_pointer, field_count.u32(), 0)


        # `Shape.Circle` -> the enclosing enum's ValueType, or Unmodeled.
        def penum_type_of_path(path: sview, structs: mutable StructTable&) -> ValueType can[Abort.Panic]:
            dot: mutable i64 = -1
            for index in 0..<sview_len(path) |dot, path|:
                dot <- index.i64() if sview_at(path, index) == 46
            unmodeled_type() return if dot <= 0
            for enum_index in 0..<structs.penum_names.count |structs, path, dot|:
                ValueType{kind: TypeKind.PayloadEnum, bits: enum_index.u32()} return if sview_matches_prefix(path, structs.penum_names[enum_index], 0, dot)
            return unmodeled_type()


        # `E.Variant` as an Expr.Field -> the variant's ordinal in its (payload-free) enum,
        # or -1. Error sets parse as plain enums, so their ordinals live in the enum pools.
        def ordinal_of_dotted_path_expr(expression: Expr, structs: mutable StructTable&) -> i64 can[Abort.Panic]:
            if expression is Expr.Field(enum_head, variant_name, field_line):
                if enum_head is Expr.Ident(enum_name, enum_name_line):
                    enum_index: i64 = penum_index_of(structs, enum_name)
                    penum_variant_index(structs, enum_index, variant_name) return if enum_index >= 0
                    plain_index: i64 = enum_index_of(structs, enum_name)
                    enum_ordinal_of(structs, plain_index.usize(), variant_name) return if plain_index >= 0
            return -1


        # Pattern.Variant carries the path as one dotted STRING, so it is split here.
        def ordinal_of_dotted_path(path: sview, structs: mutable StructTable&) -> i64 can[Abort.Panic]:
            dot: mutable i64 = -1
            for index in 0..<sview_len(path) |dot, path|:
                dot <- index.i64() if sview_at(path, index) == 46
            -1 return if dot <= 0
            # Match by comparing BYTES against each registered enum/variant rather than
            # slicing `path` into two sviews: `&path[0]` is a `char&`, not the `u8&?` that
            # `sview(...)` wants, and a view-into-a-view buys nothing here.
            for enum_index in 0..<structs.enum_names.count |structs, path, dot|:
                continue if not sview_matches_prefix(path, structs.enum_names[enum_index], 0, dot)
                for offset in 0..<structs.enum_variant_count[enum_index] |structs, path, dot, enum_index|:
                    variant: sview = structs.enum_variants[structs.enum_variant_start[enum_index] + offset]
                    offset.i64() return if sview_matches_prefix(path, variant, dot + 1, sview_len(path).i64())
            return -1


        # Whether `path[start..end)` equals `candidate`, byte for byte.
        def sview_matches_prefix(path: sview, candidate: sview, start: i64, end: i64) -> bool can[Abort.Panic]:
            false return if (end - start) != sview_len(candidate).i64()
            matched: mutable bool = true
            for index in 0..<sview_len(candidate) |matched, path, candidate, start|:
                matched <- false if sview_at(path, (start + index.i64()).usize()) != sview_at(candidate, index)
            return matched


        # Whether a pattern matches anything. ONLY `_` does: a BINDING arm is not legal in
        # an integer match — stage0 rejects `other: other + 2` with "top-level integer
        # match arm must use an integer literal or _" (and then "undefined identifier
        # other"). Treating a binding as a catch-all made stage1 emit code for a program
        # the language rejects; caught by the stage0 differential.
        #
        # Written as a `match`, NOT `pattern is Pattern.Wildcard`: `is` on a PAYLOAD-LESS
        # packed-enum variant crashes stage0's backend with "unsupported expression
        # *ast.TypeExprExpr" (the bare `Pattern.Wildcard` parses as a type path). `is` WITH
        # a payload and `match` both work — filed with a 12-line repro. Keep this a match
        # until that lands.
        def is_catch_all_pattern(pattern: Pattern) -> bool can[Abort.Panic]:
            return match pattern:
                Pattern.Wildcard: true
                Pattern.Binding(_): true
                _: false


        # Whether an arm carries a guard (`0 if n > 1:`). A guard is a second per-arm
        # condition and is NOT modeled, so a guarded arm must DECLINE: ignoring it emits
        # the arm unconditionally, which is a silent miscompile (observed — stage1 gave
        # 100 where stage0 gives 42).
        #
        # A `match`, not `guard is Expr.Absent`, for the same payload-less-variant ICE.
        def arm_has_guard(guard: Expr) -> bool can[Abort.Panic]:
            return match guard:
                Expr.Absent: false
                _: true



        # The single value an arm body yields, for a value `match`. Only a one-expression
        # body is modeled (`0: 100`).
        #
        # Returns `Expr?` rather than filling a `mutable Expr&` out-param: an out-param
        # needs a placeholder to initialize (`Expr.Invalid`), and CONSTRUCTING a
        # packed-enum node requires an active `in Ast.Expr.Store:` scope the backend does
        # not have — it only ever READS the AST. Returning the existing handle constructs
        # nothing.
        def arm_value_expression(body: darray[Stmt]&) -> Expr? can[Abort.Panic]:
            null return if body.count != 1
            if body[0] is Stmt.Expr(arm_expression, arm_expression_line):
                return arm_expression
            return null


        # Close a `match` that has no `_` arm. Nothing matching means the frontend's
        # exhaustiveness proof was wrong, so `unreachable` is the honest terminator —
        # inventing a default value would hide the gap. A guard helper, not a ternary: a
        # VOID ternary ICEs stage0 (`%termp = phi void`).
        def terminate_if_no_default(saw_default: bool, builder: LLVMBuilderRef) -> void can[Abort.Panic]:
            return if saw_default
            _ = LLVMBuildUnreachable(builder)


        # The binary operator a compound assignment applies (`+=` -> `+`), or `Eof` when
        # the token is not a compound assignment. (TokenKind has no Invalid; `Eof` can
        # never appear as a real operator, so it is the natural sentinel.) Keeps the
        # lowering honest: `x op= v` is exactly `x <- x op v`, so it reuses emit_binary
        # instead of re-deriving each operator.
        def compound_operator_of(operator: TokenKind) -> TokenKind:
            TokenKind.Plus return if operator == TokenKind.PlusEq
            TokenKind.Minus return if operator == TokenKind.MinusEq
            TokenKind.Star return if operator == TokenKind.StarEq
            TokenKind.Slash return if operator == TokenKind.SlashEq
            TokenKind.Percent return if operator == TokenKind.PercentEq
            TokenKind.Ampersand return if operator == TokenKind.AmpEq
            TokenKind.Pipe return if operator == TokenKind.PipeEq
            TokenKind.Caret return if operator == TokenKind.CaretEq
            TokenKind.LShift return if operator == TokenKind.LShiftEq
            TokenKind.RShift return if operator == TokenKind.RShiftEq
            return TokenKind.Eof


        # `left and right` / `left or right`, SHORT-CIRCUITING. Yields a modeled `bool`
        # (i1), like every other comparison.
        #
        # Lowered through a result SLOT rather than a phi: `right` may itself append
        # blocks, so the join's predecessor is not necessarily `rhs_block` and a phi would
        # need incoming-block bookkeeping. mem2reg restores the phi at -O2.
        #
        #   result = <short-circuit answer>   ; `and` -> false, `or` -> true
        #   br left ? rhs : done              ; `or` swaps the targets
        #   rhs:  result = right; br done
        #   done: load result
        def emit_short_circuit(left_expression: Expr, operator: TokenKind, right_expression: Expr, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            bool_type: LLVMTypeRef = LLVMInt1TypeInContext(ctx)
            is_and: bool = operator == TokenKind.And

            result_slot: LLVMValueRef = LLVMBuildAlloca(builder, bool_type, "sc.result")
            if emit_condition(left_expression, local_scope, fns, structs, generics, runtime, m, ctx, builder) is left_bit:
                # `false and _` is false; `true or _` is true.
                short_value: LLVMValueRef = LLVMConstInt(bool_type, 0, 0) if is_and else LLVMConstInt(bool_type, 1, 0)
                _ = LLVMBuildStore(builder, short_value, result_slot)

                function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                rhs_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "sc.rhs")
                done_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "sc.done")
                # `and` runs the right side only when the left is TRUE; `or` only when FALSE.
                if is_and:
                    _ = LLVMBuildCondBr(builder, left_bit, rhs_block, done_block)
                else:
                    _ = LLVMBuildCondBr(builder, left_bit, done_block, rhs_block)

                LLVMPositionBuilderAtEnd(builder, rhs_block)
                if emit_condition(right_expression, local_scope, fns, structs, generics, runtime, m, ctx, builder) is right_bit:
                    _ = LLVMBuildStore(builder, right_bit, result_slot)
                    _ = LLVMBuildBr(builder, done_block)
                    LLVMPositionBuilderAtEnd(builder, done_block)
                    return LLVMBuildLoad2(builder, bool_type, result_slot, "sc")
            return null


        # Declare an instantiation of a generic template, and queue its body.
        #
        # The SIGNATURE is built here — cheap, needs no builder, and yields the handle the
        # call site needs immediately. The BODY is queued because emitting it needs the
        # builder, which is currently positioned inside the caller.
        def instantiate_generic(base: sview, type_args: darray[ValueType]&, generics: mutable GenericTable&, structs: mutable StructTable&, m: LLVMModuleRef, ctx: LLVMContextRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            if instantiation_of(generics, base, type_args) is already_declared:
                return already_declared

            index: i64 = generic_index_of(generics, base)
            null return if index < 0
            slot: usize = index.usize()
            # The call must supply exactly one argument per type parameter.
            null return if generics.param_count[slot] != type_args.count

            if generics.decls[slot] is Decl.Func(function_name, params, return_type_opt, body, effects, decorators, line):
                # Bind every K/T for the duration of resolving this signature.
                bound: usize = push_type_bindings(generics, structs, slot, type_args)
                # A MISSING return annotation is `void` (std helpers omit `-> void`).
                return_value_type: mutable ValueType = ValueType{kind: TypeKind.Void, bits: 0}
                if return_type_opt is return_type:
                    return_value_type <- annotation_value_type(return_type, structs)
                llvm_params: mutable darray[LLVMTypeRef] = []
                declined: mutable bool = false
                for parameter in params |llvm_params, declined, structs, ctx|:
                    parameter_type: ValueType = annotation_value_type(parameter.type_expression, structs)
                    if parameter_type.kind == TypeKind.Unmodeled:
                        declined <- true
                    else:
                        llvm_params.push(llvm_type_of(parameter_type, structs, ctx))

                # The arena/error ABI must match emit_function_body's param layout for the
                # instantiation body: `[out-param if error], <declared params>, [arena if
                # the signature grows a container]`, and an error fn returns i32.
                instantiation_is_error: bool = generics.is_error[slot]
                instantiation_needs_arena: bool = signature_needs_arena(params, return_value_type, structs)
                pop_type_bindings(structs, bound)
                null return if declined or return_value_type.kind == TypeKind.Unmodeled

                name_storage: mutable darray[u8] = []
                mangled: cstr = mangled_name_multi_into(base, type_args, structs, name_storage)
                llvm_return: mutable LLVMTypeRef = llvm_type_of(return_value_type, structs, ctx)
                llvm_return <- LLVMInt32TypeInContext(ctx) if instantiation_is_error
                full_params: mutable darray[LLVMTypeRef] = []
                full_params.push(LLVMPointerTypeInContext(ctx, 0)) if instantiation_is_error
                for llvm_param in llvm_params |full_params|:
                    full_params.push(llvm_param)
                full_params.push(LLVMPointerTypeInContext(ctx, 0)) if instantiation_needs_arena
                fn_type: mutable LLVMTypeRef = LLVMFunctionType(llvm_return, null, 0, 0)
                if full_params.count != 0:
                    params_pointer: void& = (&full_params[0]).cast[void&] can Unsafe.PointerCast
                    fn_type <- LLVMFunctionType(llvm_return, params_pointer, full_params.count.u32(), 0)
                handle: LLVMValueRef = LLVMAddFunction(m, mangled, fn_type)

                inst_arg_start: usize = generics.inst_args.count
                for argument in type_args |generics|:
                    generics.inst_args <- generics.inst_args.push(copied_type(argument))
                generics.inst_bases <- generics.inst_bases.push(base)
                generics.inst_arg_start <- generics.inst_arg_start.push(inst_arg_start)
                generics.inst_arg_count <- generics.inst_arg_count.push(type_args.count)
                generics.inst_handles <- generics.inst_handles.push(handle)
                pending_arg_start: usize = generics.pending_args.count
                for argument in type_args |generics|:
                    generics.pending_args <- generics.pending_args.push(copied_type(argument))
                generics.pending_bases <- generics.pending_bases.push(base)
                generics.pending_arg_start <- generics.pending_arg_start.push(pending_arg_start)
                generics.pending_arg_count <- generics.pending_arg_count.push(type_args.count)
                generics.pending_handles <- generics.pending_handles.push(handle)
                return handle
            return null


        # The declared type of instantiation (base, args)'s parameter `position`, resolved
        # through the template's bindings.
        def instantiation_param_type(base: sview, type_args: darray[ValueType]&, position: usize, generics: mutable GenericTable&, structs: mutable StructTable&) -> ValueType can[Abort.Panic, Memory.Allocate]:
            index: i64 = generic_index_of(generics, base)
            unmodeled_type() return if index < 0
            slot: usize = index.usize()
            if generics.decls[slot] is Decl.Func(function_name, params, return_type_opt, body, effects, decorators, line):
                unmodeled_type() return if position >= params.count
                # POP is symmetric via pop_type_bindings — never `<- []`, which would rebind
                # the caller's darray to callee-region memory AND wipe an outer instantiation's
                # bindings (the historical nested-generic crash).
                bound: usize = push_type_bindings(generics, structs, slot, type_args)
                resolved: ValueType = annotation_value_type(params[position].type_expression, structs)
                pop_type_bindings(structs, bound)
                return resolved
            return unmodeled_type()


        # The IR name for a call's result. A VOID call must be UNNAMED — LLVM rejects
        # "instructions returning void cannot have a name".
        def call_result_name(return_type: ValueType) -> cstr:
            return "" if return_type.kind == TypeKind.Void else "call"


        # Emit a call to a generic function, instantiating on first use.
        # Whether a generic INSTANTIATION threads an arena — the same predicate
        # instantiate_generic uses to build the signature (so the call site matches). Computed
        # under the type-arg bindings so `wrap[i64] -> darray[i64]` (grows a darray) is detected.
        def instantiation_wants_arena(base: sview, type_args: darray[ValueType]&, generics: mutable GenericTable&, structs: mutable StructTable&) -> bool can[Abort.Panic, Memory.Allocate]:
            arena_slot: i64 = generic_index_of(generics, base)
            false return if arena_slot < 0
            if generics.decls[arena_slot.usize()] is Decl.Func(arena_fn_name, arena_params, arena_ret_opt, arena_body, arena_effects, arena_decs, arena_line):
                arena_bound: usize = push_type_bindings(generics, structs, arena_slot.usize(), type_args)
                arena_ret_type: mutable ValueType = ValueType{kind: TypeKind.Void, bits: 0}
                if arena_ret_opt is arena_ret:
                    arena_ret_type <- annotation_value_type(arena_ret, structs)
                arena_wanted: bool = signature_needs_arena(arena_params, arena_ret_type, structs)
                pop_type_bindings(structs, arena_bound)
                return arena_wanted
            return false

        def emit_generic_call(base: sview, type_args: darray[ValueType]&, arguments: darray[Expr]&, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            if instantiate_generic(base, type_args, generics, structs, m, ctx) is target:
                argument_values: mutable darray[LLVMValueRef] = []
                declined: mutable bool = false
                argument_index: mutable usize = 0
                for argument in arguments |argument_values, declined, argument_index, base, type_args, local_scope, fns, structs, generics, runtime, m, ctx, builder|:
                    # Each argument is emitted at its PARAMETER's type, resolved through the
                    # instantiation's bindings — so a literal argument to `f[u8]` becomes a
                    # u8, not an i64.
                    wanted: ValueType = instantiation_param_type(base, type_args, argument_index, generics, structs)
                    if emit_expression(argument, wanted, local_scope, fns, structs, generics, runtime, m, ctx, builder) is emitted_argument:
                        argument_values.push(emitted_argument)
                    else:
                        declined <- true
                    argument_index <- argument_index + 1
                null return if declined
                # A container-growing/-returning instantiation trails an arena param (matching
                # instantiate_generic's signature); hand over OUR arena so the darray it builds
                # lives in a region that outlives the call.
                argument_values.push(runtime.arena) if instantiation_wants_arena(base, type_args, generics, structs)
                fn_type: LLVMTypeRef = LLVMGlobalGetValueType(target)
                # A VOID call must be unnamed: "instructions returning void cannot have a name".
                gresult_name: cstr = call_result_name(generic_return_type(base, type_args, generics, structs))
                LLVMBuildCall2(builder, fn_type, target, null, 0, gresult_name) return if argument_values.count == 0
                args_pointer: void& = (&argument_values[0]).cast[void&] can Unsafe.PointerCast
                return LLVMBuildCall2(builder, fn_type, target, args_pointer, argument_values.count.u32(), gresult_name)
            return null


        # Emit a synthesized dict-method call — stage0 lowers `d.get(k)` / `d.put(k, v)` to a
        # call to a std generic (`arena_dict_get` / `arena_dict_put_or_panic`), NOT to a user
        # `get`/`put` function. The RECEIVER is threaded separately (a `darray[Expr]` of
        # receiver-then-args crashes stage0), and for a mutating helper the region leads the
        # argument list (stage0: `arena_dict_put_or_panic(ptr %region, ptr %d, …)`).
        def emit_dict_method_call(base: sview, type_args: darray[ValueType]&, receiver: Expr, arguments: darray[Expr]&, arena_leading: bool, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            if instantiate_generic(base, type_args, generics, structs, m, ctx) is target:
                dict_arg_values: mutable darray[LLVMValueRef] = []
                param_index: mutable usize = 0
                # The leading region for a mutating helper — hand over OUR arena.
                if arena_leading:
                    dict_arg_values.push(runtime.arena)
                    param_index <- 1
                # The receiver, emitted at its `dict[K,T]&` parameter type (a bare dict local
                # auto-borrows to its slot).
                receiver_wanted: ValueType = instantiation_param_type(base, type_args, param_index, generics, structs)
                if emit_expression(receiver, receiver_wanted, local_scope, fns, structs, generics, runtime, m, ctx, builder) is receiver_value:
                    dict_arg_values.push(receiver_value)
                    param_index <- param_index + 1
                    method_declined: mutable bool = false
                    for method_argument in arguments |dict_arg_values, method_declined, param_index, base, type_args, local_scope, fns, structs, generics, runtime, m, ctx, builder|:
                        method_wanted: ValueType = instantiation_param_type(base, type_args, param_index, generics, structs)
                        if emit_expression(method_argument, method_wanted, local_scope, fns, structs, generics, runtime, m, ctx, builder) is method_argument_value:
                            dict_arg_values.push(method_argument_value)
                        else:
                            method_declined <- true
                        param_index <- param_index + 1
                    null return if method_declined
                    dict_fn_type: LLVMTypeRef = LLVMGlobalGetValueType(target)
                    dict_result_name: cstr = call_result_name(generic_return_type(base, type_args, generics, structs))
                    dict_args_pointer: void& = (&dict_arg_values[0]).cast[void&] can Unsafe.PointerCast
                    return LLVMBuildCall2(builder, dict_fn_type, target, dict_args_pointer, dict_arg_values.count.u32(), dict_result_name)
                return null
            return null


        # If `receiver` has a `DynDict[K, T]` type, return its type-argument tuple (K, T);
        # otherwise an empty darray. Used to lower `d.get`/`d.put` to the arena_dict_* helpers.
        def dict_type_args_of(receiver: Expr, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&) -> darray[ValueType] can[Abort.Panic, Memory.Allocate]:
            empty: darray[ValueType] = []
            receiver_type: ValueType = expression_type(receiver, local_scope, fns, structs, generics)
            empty return if receiver_type.kind != TypeKind.Struct
            receiver_base: mutable sview = ""
            receiver_arg_start: mutable usize = 0
            receiver_arg_count: mutable usize = 0
            has_instantiation: bool = generic_struct_instantiation_of(structs, receiver_type, receiver_base, receiver_arg_start, receiver_arg_count)
            empty return if not has_instantiation
            empty return if receiver_base != "DynDict"
            collected: mutable darray[ValueType] = []
            for offset in 0..<receiver_arg_count |collected, structs, receiver_arg_start|:
                collected.push(copied_type(structs.generic_struct_inst_args[receiver_arg_start + offset]))
            return collected


        # The std helper a dict method lowers to — the FRICTIONLESS (panic-on-OOM, no `can`)
        # surface, matching stage0's synthetic `dict.<method>` lowering. Empty = not a dict
        # method (fall through to ordinary UFCS).
        def dict_method_helper(method_name: sview) -> sview can[Abort.Panic]:
            return when method_name:
                "get" -> "arena_dict_get"
                "get_mut" -> "arena_dict_get_mut"
                "put" -> "arena_dict_put_or_panic"
                "get_or_insert" -> "arena_dict_get_or_insert_or_panic"
                "reserve" -> "arena_dict_reserve_or_panic"
                "contains" -> "arena_dict_contains"
                "remove" -> "arena_dict_remove"
                _ -> ""


        # Whether a dict method mutates the map and therefore takes a LEADING region argument.
        def dict_method_is_mutating(method_name: sview) -> bool can[Abort.Panic]:
            return method_name in {"put", "get_or_insert", "reserve"}


        # Emit a call `f(args…)`. Only a direct call to a named, already-declared function
        # is modeled: the callee must exist in the module (emit_module declares every
        # function before emitting any body, so definition order does not matter) and the
        # arity must match.
        def emit_call(callee: Expr, arguments: darray[Expr]&, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            # `f[i64](x)` — an EXPLICIT type argument makes the callee an Index, not an
            # Ident; the bracket holds a TYPE, so it resolves as an annotation.
            if callee is Expr.Index(generic_callee, generic_argument, generic_call_line):
                if generic_callee is Expr.Ident(explicit_name, explicit_name_line):
                    explicit_type: ValueType = annotation_value_type(generic_argument, structs)
                    null return if explicit_type.kind == TypeKind.Unmodeled
                    null return if generic_index_of(generics, explicit_name) < 0
                    explicit_args: mutable darray[ValueType] = [explicit_type]
                    return emit_generic_call(explicit_name, explicit_args, arguments, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                return null
            # `f[K, V](x)` — EXPLICIT multi-argument type application. The callee is an
            # IndexN whose bracket holds the type arguments.
            if callee is Expr.IndexN(multi_generic_callee, multi_generic_args, multi_generic_line):
                if multi_generic_callee is Expr.Ident(multi_name, multi_name_line):
                    null return if generic_index_of(generics, multi_name) < 0
                    multi_type_args: mutable darray[ValueType] = []
                    multi_declined: mutable bool = false
                    for type_argument_expression in multi_generic_args |multi_type_args, multi_declined, structs|:
                        resolved_type_argument: ValueType = annotation_value_type(type_argument_expression, structs)
                        multi_declined <- true if resolved_type_argument.kind == TypeKind.Unmodeled
                        multi_type_args.push(resolved_type_argument)
                    null return if multi_declined
                    return emit_generic_call(multi_name, multi_type_args, arguments, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                return null
            if callee is Expr.Ident(callee_name, callee_line):
                # `ctx_hash_value(key)` — the compiler-emitted hash builtin (no user function
                # of that name exists), lowered per the key's concrete type.
                if callee_name == "ctx_hash_value" and arguments.count == 1:
                    return emit_hash_builtin(arguments[0], local_scope, fns, structs, generics, runtime, m, ctx, builder)
                # `size_of(T)` — the type's byte size as a compile-time constant (its argument
                # is a TYPE, so it resolves as an annotation). The dict grow path sizes its
                # bucket array with `size_of(DictBucket[K, T])`.
                if callee_name == "size_of" and arguments.count == 1:
                    size_of_type: ValueType = annotation_value_type(arguments[0], structs)
                    null return if size_of_type.kind == TypeKind.Unmodeled
                    return LLVMSizeOf(llvm_type_of(size_of_type, structs, ctx))
                # `arena_alloc(region, nbytes)` — the runtime allocator, callable by name from
                # std code. The region is an `Arena&` (a pointer); nbytes is a usize.
                if callee_name == "arena_alloc" and arguments.count == 2:
                    arena_ref_type: ValueType = intern_ref_type(ValueType{kind: TypeKind.Arena, bits: 0}, structs)
                    if emit_expression(arguments[0], arena_ref_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is alloc_region:
                        if emit_expression(arguments[1], ValueType{kind: TypeKind.Unsigned, bits: 64}, local_scope, fns, structs, generics, runtime, m, ctx, builder) is alloc_size:
                            alloc_args: mutable darray[LLVMValueRef] = [alloc_region, alloc_size]
                            alloc_args_pointer: void& = (&alloc_args[0]).cast[void&] can Unsafe.PointerCast
                            return LLVMBuildCall2(builder, runtime.arena_alloc_type, runtime.arena_alloc, alloc_args_pointer, 2, "arena.alloc")
                    return null
                # A GENERIC callee with an INFERRED type argument: `identity(42)`. The first
                # argument's own type supplies it — enough for the single-type-parameter
                # subset. A multi-parameter generic can't be inferred from one argument, so it
                # declines here and requires an explicit `f[K, V](…)`.
                if generic_index_of(generics, callee_name) >= 0:
                    null return if arguments.count == 0
                    inferred_slot: usize = generic_index_of(generics, callee_name).usize()
                    inferred_args: darray[ValueType] = infer_generic_args(inferred_slot, arguments, local_scope, fns, structs, generics)
                    null return if inferred_args.count == 0
                    return emit_generic_call(callee_name, inferred_args, arguments, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                return emit_direct_call("", callee_name, callee, false, arguments, local_scope, fns, structs, generics, runtime, m, ctx, builder)
            # `Node.Store(owner)` — build the AoS store: ask the runtime for its state, then
            # assemble `{arena, row_bytes, state}` with three insertvalues (stage0's shape).
            if callee is Expr.Field(store_ctor_head, store_ctor_member, store_ctor_line):
                if store_ctor_head is Expr.Ident(store_ctor_enum, store_ctor_enum_line):
                    if store_ctor_member == "Store":
                        store_ctor_index: i64 = packed_index_of(structs, store_ctor_enum)
                        if store_ctor_index >= 0:
                            null return if arguments.count != 1
                            # The owner is an Arena; the runtime takes it BY POINTER, so the
                            # argument must be a name whose slot we can hand over rather than
                            # a temporary.
                            if arguments[0] is Expr.Ident(owner_name, owner_line):
                                null return if lookup_type(local_scope, owner_name).kind != TypeKind.Arena
                                if lookup_slot(local_scope, owner_name) is owner_slot:
                                    row_bytes: i64 = packed_row_bytes(structs, store_ctor_index)
                                    state_args: mutable darray[LLVMValueRef] = [owner_slot, LLVMConstInt(LLVMInt64TypeInContext(ctx), row_bytes.u64(), 0)]
                                    state_pointer: void& = (&state_args[0]).cast[void&] can Unsafe.PointerCast
                                    state: LLVMValueRef = LLVMBuildCall2(builder, runtime.packed_state_new_type, runtime.packed_state_new, state_pointer, 2, "packed.store.state")
                                    store_type: ValueType = ValueType{kind: TypeKind.PackedStore, bits: store_ctor_index.u32()}
                                    store_llvm: LLVMTypeRef = llvm_type_of(store_type, structs, ctx)
                                    with_arena: LLVMValueRef = LLVMBuildInsertValue(builder, LLVMGetUndef(store_llvm), owner_slot, 0, "packed.store.arena")
                                    with_row: LLVMValueRef = LLVMBuildInsertValue(builder, with_arena, LLVMConstInt(LLVMInt64TypeInContext(ctx), row_bytes.u64(), 0), 1, "packed.store.row_bytes")
                                    return LLVMBuildInsertValue(builder, with_row, state, 2, "packed.store.state1")
                            return null

            # `Node.Leaf(v: 42)` inside an `in store:` block — a PACKED constructor. Unlike
            # a payload enum's inline value, this allocates a ROW: extract the arena/state
            # out of the active store, call alloc_fixed_tagged_variant_sparse_result(arena,
            # state, tag), zero the row, then write the payload. stage0's shape exactly.
            if callee is Expr.Field(packed_ctor_head, packed_ctor_variant, packed_ctor_line):
                if packed_ctor_head is Expr.Ident(packed_ctor_enum, packed_ctor_enum_line):
                    packed_ctor_index: i64 = packed_index_of(structs, packed_ctor_enum)
                    if packed_ctor_index >= 0:
                        # No active store -> decline. stage0 rejects the same program
                        # ("requires an active in Node.Store: scope"), and there is no store
                        # to allocate the row from anyway.
                        null return if runtime.active_store_enum != packed_ctor_index
                        packed_tag: i64 = packed_variant_index(structs, packed_ctor_index, packed_ctor_variant)
                        null return if packed_tag < 0
                        packed_slot_index: usize = structs.packed_variant_start[packed_ctor_index.usize()] + packed_tag.usize()
                        packed_wants_payload: bool = structs.packed_has_payload[packed_slot_index]
                        packed_commons: u32 = structs.packed_common_counts[packed_ctor_index.usize()]
                        # `new Expr.Int(span: 1, value: 42)` — the COMMON args come first,
                        # then at most one payload arg. The parser prepends commons to the
                        # variant's field list, so the arity is commons (+1 with a payload).
                        packed_expected_args: usize = packed_commons.usize() + 1 if packed_wants_payload else packed_commons.usize()
                        null return if arguments.count != packed_expected_args

                        packed_arena: LLVMValueRef = LLVMBuildExtractValue(builder, runtime.active_store, 0, "packed.arena")
                        packed_state: LLVMValueRef = LLVMBuildExtractValue(builder, runtime.active_store, 2, "packed.state")
                        packed_alloc_args: mutable darray[LLVMValueRef] = [packed_arena, packed_state, LLVMConstInt(LLVMInt32TypeInContext(ctx), packed_tag.u64(), 0)]
                        packed_alloc_pointer: void& = (&packed_alloc_args[0]).cast[void&] can Unsafe.PointerCast
                        packed_alloc_result: LLVMValueRef = LLVMBuildCall2(builder, runtime.packed_alloc_type, runtime.packed_alloc, packed_alloc_pointer, 3, "packed.variant_sparse.alloc")
                        packed_row: LLVMValueRef = LLVMBuildExtractValue(builder, packed_alloc_result, 0, "packed.alloc.ptr")

                        packed_handle_llvm: LLVMTypeRef = packed_row_llvm_type(structs, packed_ctor_index, ctx)
                        _ = LLVMBuildStore(builder, LLVMConstNull(packed_handle_llvm), packed_row)
                        packed_tag_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, packed_handle_llvm, packed_row, 0, "packed.tag.ptr")
                        _ = LLVMBuildStore(builder, LLVMConstInt(LLVMInt32TypeInContext(ctx), packed_tag.u64(), 0), packed_tag_pointer)
                        # Commons are stored INLINE at fields 1..commons, ahead of the payload.
                        packed_common_ok: mutable bool = true
                        for common_index in 0..<packed_commons.usize() |packed_common_ok, arguments, packed_handle_llvm, packed_row, local_scope, fns, structs, generics, runtime, m, ctx, builder|:
                            common_slot_type: ValueType = ValueType{kind: TypeKind.Signed, bits: 64}
                            if emit_expression(arguments[common_index], common_slot_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is common_value:
                                common_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, packed_handle_llvm, packed_row, (1 + common_index).u32(), "packed.common.ptr")
                                _ = LLVMBuildStore(builder, common_value, common_pointer)
                            else:
                                packed_common_ok <- false
                        null return if not packed_common_ok
                        if packed_wants_payload:
                            packed_payload_type: ValueType = copied_type(structs.packed_payloads[packed_slot_index])
                            # The payload sits AFTER the commons: field 1 + commons.
                            if emit_expression(arguments[packed_commons.usize()], packed_payload_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is packed_payload_value:
                                packed_payload_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, packed_handle_llvm, packed_row, (1 + packed_commons), "packed.payload.ptr")
                                _ = LLVMBuildStore(builder, packed_payload_value, packed_payload_pointer)
                            else:
                                return null
                        # The VALUE is the row's INDEX, not the row.
                        return LLVMBuildExtractValue(builder, packed_alloc_result, 1, "packed.alloc.index")

            # `Shape.Circle(42)` — a payload-enum CONSTRUCTOR. stage0 emits: alloca, store
            # zeroinitializer, store the tag at field 0, store the payload at field 1, load
            # the value. Only ONE payload argument is modeled, matching what
            # register_payload_enum accepts.
            if callee is Expr.Field(ctor_head, ctor_variant, ctor_line):
                if ctor_head is Expr.Ident(ctor_enum_name, ctor_enum_line):
                    ctor_enum_index: i64 = penum_index_of(structs, ctor_enum_name)
                    if ctor_enum_index >= 0:
                        ctor_tag: i64 = penum_variant_index(structs, ctor_enum_index, ctor_variant)
                        null return if ctor_tag < 0
                        ctor_variant_slot: usize = structs.penum_variant_start[ctor_enum_index.usize()] + ctor_tag.usize()
                        # `Shape.Rect(4, 5)` — a MULTI-FIELD variant: build the field tuple and
                        # store it at the payload pointer (stage0's `store {i64,i64} …`).
                        if structs.penum_field_type_count[ctor_variant_slot] > 1:
                            null return if arguments.count != structs.penum_field_type_count[ctor_variant_slot]
                            multi_type: ValueType = ValueType{kind: TypeKind.PayloadEnum, bits: ctor_enum_index.u32()}
                            multi_llvm: LLVMTypeRef = llvm_type_of(multi_type, structs, ctx)
                            multi_slot_alloca: LLVMValueRef = LLVMBuildAlloca(builder, multi_llvm, "enum.ctor")
                            _ = LLVMBuildStore(builder, LLVMConstNull(multi_llvm), multi_slot_alloca)
                            multi_tag_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, multi_llvm, multi_slot_alloca, 0, "enum.tag.ptr")
                            _ = LLVMBuildStore(builder, LLVMConstInt(LLVMInt32TypeInContext(ctx), ctor_tag.u64(), 0), multi_tag_pointer)
                            multi_tuple_llvm: LLVMTypeRef = penum_field_tuple_type(ctor_variant_slot, structs, ctx)
                            multi_field_start: usize = structs.penum_field_type_start[ctor_variant_slot]
                            multi_tuple_value: mutable LLVMValueRef = LLVMGetUndef(multi_tuple_llvm)
                            multi_declined: mutable bool = false
                            for multi_index in 0..<arguments.count |multi_tuple_value, multi_declined, multi_field_start, arguments, structs, local_scope, fns, generics, runtime, m, ctx, builder|:
                                multi_field_type: ValueType = copied_type(structs.penum_field_types[multi_field_start + multi_index])
                                if emit_expression(arguments[multi_index], multi_field_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is multi_field_value:
                                    multi_tuple_value <- LLVMBuildInsertValue(builder, multi_tuple_value, multi_field_value, multi_index.u32(), "enum.field")
                                else:
                                    multi_declined <- true
                            null return if multi_declined
                            multi_payload_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, multi_llvm, multi_slot_alloca, 1, "enum.payload.ptr")
                            _ = LLVMBuildStore(builder, multi_tuple_value, multi_payload_pointer)
                            return LLVMBuildLoad2(builder, multi_llvm, multi_slot_alloca, "enum.value")
                        null return if arguments.count != 1
                        ctor_type: ValueType = ValueType{kind: TypeKind.PayloadEnum, bits: ctor_enum_index.u32()}
                        ctor_payload_type: ValueType = copied_type(structs.penum_payloads[structs.penum_variant_start[ctor_enum_index.usize()] + ctor_tag.usize()])
                        null return if ctor_payload_type.kind == TypeKind.Unmodeled
                        ctor_llvm: LLVMTypeRef = llvm_type_of(ctor_type, structs, ctx)
                        ctor_slot: LLVMValueRef = LLVMBuildAlloca(builder, ctor_llvm, "enum.ctor")
                        _ = LLVMBuildStore(builder, LLVMConstNull(ctor_llvm), ctor_slot)
                        ctor_tag_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, ctor_llvm, ctor_slot, 0, "enum.tag.ptr")
                        _ = LLVMBuildStore(builder, LLVMConstInt(LLVMInt32TypeInContext(ctx), ctor_tag.u64(), 0), ctor_tag_pointer)
                        if emit_expression(arguments[0], ctor_payload_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is ctor_payload_value:
                            ctor_payload_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, ctor_llvm, ctor_slot, 1, "enum.payload.ptr")
                            _ = LLVMBuildStore(builder, ctor_payload_value, ctor_payload_pointer)
                            return LLVMBuildLoad2(builder, ctor_llvm, ctor_slot, "enum.value")
                        return null

            # UFCS: `p.get(a)` IS `get(p, a)`. A postfix call unifies casts and UFCS —
            # `recv.Name()` where Name is a TYPE name is a conversion (handled on the cast
            # path), and where Name is a FUNCTION it is an ordinary call with the receiver
            # as the leading argument. Only the latter is resolved here; a name that is
            # neither declines rather than inventing a call.
            if callee is Expr.Field(receiver, method_name, method_line):
                method_as_type: ValueType = scalar_type_of_name(method_name)
                null return if method_as_type.kind != TypeKind.Unmodeled
                # A dict receiver's `.get`/`.put`/… are SYNTHESIZED calls to std generics, not
                # UFCS to a user function. Detected before the ordinary UFCS lookup because no
                # `get`/`put` function exists to find.
                dict_args: darray[ValueType] = dict_type_args_of(receiver, local_scope, fns, structs, generics)
                if dict_args.count != 0:
                    dict_helper: sview = dict_method_helper(method_name)
                    if dict_helper != "":
                        dict_arena_leading: bool = dict_method_is_mutating(method_name)
                        return emit_dict_method_call(dict_helper, dict_args, receiver, arguments, dict_arena_leading, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                ufcs_target_opt: LLVMValueRef? = lookup_function(fns, "", method_name)
                if ufcs_target_opt is ufcs_target:
                    return emit_direct_call("", method_name, receiver, true, arguments, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                return null
            # `M::get(a)` — a MODULE-qualified call. `::` parses to Expr.Scope, a node kind
            # distinct from Expr.Field, so a qualified call is never confused with UFCS.
            # Only a single level is modeled: `A::B::get` nests Scope inside Scope, whose
            # head is not an Ident, so it declines rather than mangling a wrong symbol.
            if callee is Expr.Scope(scope_head, scope_name, scope_line):
                if scope_head is Expr.Ident(module_name, module_name_line):
                    return emit_direct_call(module_name, scope_name, callee, false, arguments, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                return null
            return null


        # Emit a call to a NON-generic function by name. UFCS passes its receiver as a
        # SEPARATE leading argument rather than prepending it to a list: building a local
        # `darray[Expr]` of receiver-then-arguments CRASHES stage0 (SIGTRAP inside cgo —
        # bisected to the darray construction itself, a darray of packed-enum node handles
        # built in this function). Threading the receiver is the only spelling that
        # compiles, not a style preference. `receiver` is ignored when `has_receiver` is
        # false; callers pass the callee node itself rather than synthesize a dummy.
        def emit_direct_call(callee_owner: sview, callee_name: sview, receiver: Expr, has_receiver: bool, arguments: darray[Expr]&, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            target_opt: LLVMValueRef? = lookup_function(fns, callee_owner, callee_name)
            if target_opt is target:
                total_arguments: usize = arguments.count + 1 if has_receiver else arguments.count
                # LLVMCountParams counts the implicit trailing ARENA too, so the arity check
                # must expect it — otherwise every call to an arena-threading function
                # declines on a spurious mismatch.
                wants_arena: bool = callee_needs_arena(fns, callee_owner, callee_name)
                expected_params: usize = total_arguments + 1 if wants_arena else total_arguments
                null return if LLVMCountParams(target).i64() != expected_params.i64()

                argument_values: mutable darray[LLVMValueRef] = []
                declined: mutable bool = false
                argument_index: mutable usize = 0
                if has_receiver:
                    receiver_value: LLVMValueRef? = emit_expression(receiver, param_type_of(fns, callee_owner, callee_name, 0), local_scope, fns, structs, generics, runtime, m, ctx, builder)
                    if receiver_value is emitted_receiver:
                        argument_values.push(emitted_receiver)
                    else:
                        declined <- true
                    argument_index <- 1
                for argument in arguments |argument_values, declined, argument_index, target, local_scope, fns, structs, generics, runtime, m, ctx, builder|:
                    # Each argument is emitted at its PARAMETER's declared type, so a
                    # literal argument adopts the parameter type rather than i64.
                    argument_value: LLVMValueRef? = emit_expression(argument, param_type_of(fns, callee_owner, callee_name, argument_index), local_scope, fns, structs, generics, runtime, m, ctx, builder)
                    if argument_value is emitted_argument:
                        argument_values.push(emitted_argument)
                    else:
                        declined <- true
                    argument_index <- argument_index + 1
                null return if declined

                # LLVMBuildCall2 needs the callee's FUNCTION type, not its pointer
                # type: LLVM pointers are opaque, so the type cannot be recovered from
                # the value itself.
                fn_type: LLVMTypeRef = LLVMGlobalGetValueType(target)
                # A VOID call must be unnamed: "instructions returning void cannot have a name".
                result_name: cstr = call_result_name(lookup_return_type(fns, callee_owner, callee_name))
                # Hand the callee OUR region when its signature threads one: the container
                # it grows is ours, so its backing must come from a region that outlives
                # the call.
                if wants_arena:
                    argument_values.push(runtime.arena)
                    arena_pointer: void& = (&argument_values[0]).cast[void&] can Unsafe.PointerCast
                    return LLVMBuildCall2(builder, fn_type, target, arena_pointer, (total_arguments + 1).u32(), result_name)
                LLVMBuildCall2(builder, fn_type, target, null, 0, result_name) return if total_arguments == 0
                args_pointer: void& = (&argument_values[0]).cast[void&] can Unsafe.PointerCast
                return LLVMBuildCall2(builder, fn_type, target, args_pointer, total_arguments.u32(), result_name)
            return null


        # The type a value will actually have: its own if known, else the context's.
        # An integer literal has no intrinsic type, so `expected` is what makes
        # `a: u8 = 200` a u8 rather than an i64 that is then truncated behind your back.
        def resolve_type(expression: Expr, expected: ValueType, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&) -> ValueType can[Abort.Panic]:
            own: ValueType = expression_type(expression, local_scope, fns, structs, generics)
            own return if own.kind != TypeKind.Unmodeled
            return expected


        # Convert `value` from `from_type` to `to_type`. Widening sign-extends a signed
        # source and zero-extends an unsigned one (that IS the difference between
        # `u8 200 -> i64 200` and `i8 200 -> i64 -56`); narrowing truncates. Same width is
        # a no-op — a signed/unsigned reinterpretation costs no instruction.
        def emit_conversion(value: LLVMValueRef, from_type: ValueType, to_type: ValueType, structs: mutable StructTable&, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic]:
            null return if from_type.kind == TypeKind.Unmodeled or to_type.kind == TypeKind.Unmodeled
            target: LLVMTypeRef = llvm_type_of(to_type, structs, ctx)
            # bool <-> int needs an explicit widening decision; only int<->int, float, and
            # the identity are modeled.
            if from_type.kind == TypeKind.Bool or to_type.kind == TypeKind.Bool:
                value return if from_type.kind == to_type.kind
                return null

            # float -> int TRUNCATES toward zero (`7.5.i64()` is 7, and `(-7.5).i64()` is
            # -7), which is what FPToSI does — verified against stage0.
            if from_type.kind == TypeKind.Float and to_type.kind != TypeKind.Float:
                return LLVMBuildFPToSI(builder, value, target, "fptosi") if to_type.kind == TypeKind.Signed else LLVMBuildFPToUI(builder, value, target, "fptoui")
            # int -> float follows the SOURCE's signedness: u8 200 becomes 200.0, i8 -56
            # becomes -56.0.
            if to_type.kind == TypeKind.Float and from_type.kind != TypeKind.Float:
                return LLVMBuildSIToFP(builder, value, target, "sitofp") if from_type.kind == TypeKind.Signed else LLVMBuildUIToFP(builder, value, target, "uitofp")
            if from_type.kind == TypeKind.Float and to_type.kind == TypeKind.Float:
                value return if from_type.bits == to_type.bits
                return LLVMBuildFPTrunc(builder, value, target, "fptrunc") if to_type.bits < from_type.bits else LLVMBuildFPExt(builder, value, target, "fpext")

            # POINTER <-> INTEGER is a distinct cast, not a width change: `zext ptr .. to i64`
            # is invalid IR llc rejects. The std takes a pointer DIFFERENCE this way --
            # arena_tail_offset_slots is `(ptr.cast[heap u8&].usize() - base.usize()) / stride`
            # -- so every dict program went through here.
            from_is_pointer: bool = from_type.kind == TypeKind.Ref or from_type.kind == TypeKind.CStr
            to_is_pointer: bool = to_type.kind == TypeKind.Ref or to_type.kind == TypeKind.CStr
            if from_is_pointer or to_is_pointer:
                LLVMBuildPtrToInt(builder, value, target, "ptrtoint") return if from_is_pointer and is_integer_type(to_type)
                LLVMBuildIntToPtr(builder, value, target, "inttoptr") return if to_is_pointer and is_integer_type(from_type)
                # ptr -> ptr is a no-op under opaque pointers; anything else is unmodeled.
                value return if from_is_pointer and to_is_pointer
                return null

            value return if from_type.bits == to_type.bits
            LLVMBuildTrunc(builder, value, target, "trunc") return if to_type.bits < from_type.bits
            return LLVMBuildSExt(builder, value, target, "sext") if from_type.kind == TypeKind.Signed else LLVMBuildZExt(builder, value, target, "zext")


        # The ADDRESS of `xs[i]` for a DARRAY.
        #
        # ONE index, not two: `items` is already a `T*`, so there is no leading 0 to step
        # over the way a fixed array's pointer-to-array needs.
        def emit_darray_index_address(array_slot: LLVMValueRef, array_type: ValueType, index_expression: Expr, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            null return if array_type.kind != TypeKind.DArray
            element_type: ValueType = darray_element_of(array_type, structs)
            null return if element_type.kind == TypeKind.Unmodeled
            index_type: ValueType = ValueType{kind: TypeKind.Signed, bits: 64}
            if emit_expression(index_expression, index_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is index_value:
                items_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, darray_llvm_type(structs, ctx), array_slot, 0, "darray.items.ptr")
                items: LLVMValueRef = LLVMBuildLoad2(builder, LLVMPointerTypeInContext(ctx, 0), items_pointer, "darray.items")
                indices: mutable darray[LLVMValueRef] = [index_value]
                indices_pointer: void& = (&indices[0]).cast[void&] can Unsafe.PointerCast
                return LLVMBuildGEP2(builder, llvm_type_of(element_type, structs, ctx), items, indices_pointer, 1, "darray.elem.ptr")
            return null


        # The ADDRESS of `xs[i]`.
        #
        # A two-index GEP: the first index (always 0) steps over the array POINTER itself,
        # the second selects the element — the classic C-array shape. StructGEP cannot be
        # used because the index is dynamic.
        #
        # NO BOUNDS CHECK: the subset does not model one. That matches `-emit obj` without
        # -fbounds-check, which is what the differential compares against; a checked build
        # is a separate feature, not a silent default.
        def emit_index_address(array_slot: LLVMValueRef, array_type: ValueType, index_expression: Expr, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            null return if array_type.kind != TypeKind.Array
            index_type: ValueType = ValueType{kind: TypeKind.Signed, bits: 64}
            if emit_expression(index_expression, index_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is index_value:
                indices: mutable darray[LLVMValueRef] = [LLVMConstInt(LLVMInt64TypeInContext(ctx), 0, 0), index_value]
                indices_pointer: void& = (&indices[0]).cast[void&] can Unsafe.PointerCast
                return LLVMBuildGEP2(builder, llvm_type_of(array_type, structs, ctx), array_slot, indices_pointer, 2, "elem.ptr")
            return null


        # Copy a Runtime out of a reference (same borrow rule as copied_type).
        def copied_runtime(runtime: Runtime&) -> Runtime:
            return Runtime{
                owns_arena: runtime.owns_arena,
                active_store: runtime.active_store,
                active_store_enum: runtime.active_store_enum,
                error_out: runtime.error_out,
                in_error_fn: runtime.in_error_fn,
                streq: runtime.streq,
                streq_type: runtime.streq_type,
                sview_eq: runtime.sview_eq,
                sview_eq_type: runtime.sview_eq_type,
                sview_index: runtime.sview_index,
                sview_index_type: runtime.sview_index_type,
                packed_state_new: runtime.packed_state_new,
                packed_state_new_type: runtime.packed_state_new_type,
                packed_alloc: runtime.packed_alloc,
                packed_alloc_type: runtime.packed_alloc_type,
                packed_alloc_result_type: runtime.packed_alloc_result_type,
                packed_read_tag: runtime.packed_read_tag,
                packed_read_tag_type: runtime.packed_read_tag_type,
                packed_read_word: runtime.packed_read_word,
                packed_read_word_type: runtime.packed_read_word_type,
                new_region_backend: runtime.new_region_backend,
                new_region_backend_type: runtime.new_region_backend_type,
                arena_alloc: runtime.arena_alloc,
                arena_realloc: runtime.arena_realloc,
                arena_free: runtime.arena_free,
                arena_alloc_type: runtime.arena_alloc_type,
                arena_realloc_type: runtime.arena_realloc_type,
                arena_free_type: runtime.arena_free_type,
                arena: runtime.arena
            }


        # `arena_free(region)` — release the function's auto region. Idempotent in the
        # runtime and a no-op for a region that never allocated (strategy 2 is lazy), so
        # emitting it unconditionally on every return path is correct and cheap.
        def emit_region_free(runtime: Runtime&, builder: LLVMBuilderRef) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            # A BORROWED region (the caller's, threaded in) is not ours to free.
            return if not runtime.owns_arena
            arguments: mutable darray[LLVMValueRef] = [runtime.arena]
            arguments_pointer: void& = (&arguments[0]).cast[void&] can Unsafe.PointerCast
            _ = LLVMBuildCall2(builder, runtime.arena_free_type, runtime.arena_free, arguments_pointer, 1, "")


        # `xs.push(v)` — grow-if-needed, store, bump count.
        #
        # Mirrors stage0's lowering, read out of its own `-emit llvm` output:
        #
        #   count = xs.count; needed = count + 1
        #   if xs.capacity < needed:
        #       new_cap = capacity == 0 ? 256 : max(capacity * 2, needed)
        #       items = xs.items == null ? arena_alloc(arena, new_bytes)
        #                                : arena_realloc(arena, items, old_bytes, new_bytes)
        #       xs.items = items; xs.capacity = new_cap
        #   xs.items[count] = v; xs.count = needed
        #
        # The 256 initial capacity is stage0's, not a guess. Overflow TRAPS are omitted:
        # they only abort on a capacity that cannot occur in a modeled program, so their
        # absence is unobservable in the differential — but it does mean this lowering is
        # not a bit-for-bit clone, only a behavioural one.
        # Tag a loop's LATCH branch `!llvm.loop !{ <self>, !{ "elisa.autovec.expected", pos,
        # reason } }` — stage0's exact shape.
        #
        # The marker rides IN THE IR, which is the point: it survives inlining (a held
        # function reference would not), so a post-optimization pass can still identify a
        # comprehension build loop that was lowered to be vectorizable and then wasn't. That
        # is the entire basis of `-Wperf`.
        #
        # LLVM requires a loop-ID node's operand 0 to be the node ITSELF, so it is built via
        # a temporary that is then replaced by the finished node.
        def tag_autovec_loop(branch: LLVMValueRef, position: sview, ctx: LLVMContextRef) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            position_storage: mutable darray[u8] = []
            position_text: cstr = sview_to_cstr(position, position_storage)
            marker_name: LLVMMetadataRef = LLVMMDStringInContext2(ctx, "elisa.autovec.expected", 22)
            position_md: LLVMMetadataRef = LLVMMDStringInContext2(ctx, position_text, sview_len(position))
            reason_md: LLVMMetadataRef = LLVMMDStringInContext2(ctx, "", 0)
            marker_ops: mutable darray[LLVMMetadataRef] = [marker_name, position_md, reason_md]
            marker_pointer: void& = (&marker_ops[0]).cast[void&] can Unsafe.PointerCast
            marker_node: LLVMMetadataRef = LLVMMDNodeInContext2(ctx, marker_pointer, 3)

            temporary: LLVMMetadataRef = LLVMTemporaryMDNode(ctx, null, 0)
            loop_ops: mutable darray[LLVMMetadataRef] = [temporary, marker_node]
            loop_pointer: void& = (&loop_ops[0]).cast[void&] can Unsafe.PointerCast
            loop_id: LLVMMetadataRef = LLVMMDNodeInContext2(ctx, loop_pointer, 2)
            LLVMMetadataReplaceAllUsesWith(temporary, loop_id)

            kind: u32 = LLVMGetMDKindIDInContext(ctx, "llvm.loop", 9)
            LLVMSetMetadata(branch, kind, LLVMMetadataAsValue(ctx, loop_id))


        # `[BODY for VAR in LOW..<HIGH]` — a list comprehension, lowered PRESIZE-AND-FILL the
        # way stage0 does: compute the count, allocate the backing once, set count/capacity
        # up front, then write each element BY INDEX.
        #
        # Not a push loop. A push loop is behaviourally identical and would pass every
        # differential here, but it reallocates as it grows and defeats the vectorizer — and
        # vectorization is the whole point of the construct (`-Wperf`'s autovec verifier tags
        # exactly these loops and reports the ones that failed). Emitting the slow shape for
        # a construct that exists to be fast would be a divergence the exit code cannot see.
        #
        # Constant filters preserve the presized lowering: `if true` is ordinary and
        # `if false` produces an empty darray.
        def emit_comprehension(comprehension_var: sview, iterable: Expr, condition: Expr, body: Expr, expected: ValueType, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            null return if expected.kind != TypeKind.DArray
            # A quantifier (`any`/`all`) has no body; only the collection form is modeled.
            null return if body is Expr.Absent
            if condition is Expr.BoolLit(filter_value):
                if not filter_value:
                    return LLVMConstNull(darray_llvm_type(structs, ctx))
            int64_type: LLVMTypeRef = LLVMInt64TypeInContext(ctx)
            element_type: ValueType = darray_element_of(expected, structs)
            null return if element_type.kind == TypeKind.Unmodeled

            # Only an integer RANGE iterable is modeled: its length is known before the loop,
            # which is what makes the presize possible at all.
            if iterable is Expr.Binary(range_low, range_operator, range_high, range_line):
                null return if range_operator != TokenKind.RangeLt and range_operator != TokenKind.RangeLe
                inclusive: bool = range_operator == TokenKind.RangeLe
                index_type: ValueType = ValueType{kind: TypeKind.Signed, bits: 64}
                if emit_expression(range_low, index_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is low_value:
                    if emit_expression(range_high, index_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is high_value:
                        span: LLVMValueRef = LLVMBuildSub(builder, high_value, low_value, "comp.span")
                        count: mutable LLVMValueRef = span
                        count <- LLVMBuildAdd(builder, span, LLVMConstInt(int64_type, 1, 0), "comp.count") if inclusive
                        # An empty or reversed range yields an empty darray, not a negative
                        # allocation.
                        positive: LLVMValueRef = LLVMBuildICmp(builder, 38, count, LLVMConstInt(int64_type, 0, 0), "comp.count.pos")
                        count <- LLVMBuildSelect(builder, positive, count, LLVMConstInt(int64_type, 0, 0), "comp.count.clamped")

                        header: LLVMTypeRef = darray_llvm_type(structs, ctx)
                        result_slot: LLVMValueRef = LLVMBuildAlloca(builder, header, "list.comp.result")
                        _ = LLVMBuildStore(builder, LLVMConstNull(header), result_slot)
                        stride: LLVMValueRef = element_stride(element_type, structs, ctx)
                        bytes: LLVMValueRef = LLVMBuildMul(builder, count, stride, "comp.bytes")
                        alloc_args: mutable darray[LLVMValueRef] = [runtime.arena, bytes]
                        alloc_pointer: void& = (&alloc_args[0]).cast[void&] can Unsafe.PointerCast
                        items: LLVMValueRef = LLVMBuildCall2(builder, runtime.arena_alloc_type, runtime.arena_alloc, alloc_pointer, 2, "comp.alloc")
                        items_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, header, result_slot, 0, "comp.items.ptr")
                        count_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, header, result_slot, 1, "comp.count.ptr")
                        capacity_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, header, result_slot, 2, "comp.cap.ptr")
                        _ = LLVMBuildStore(builder, items, items_pointer)
                        # Capacity is the range bound; count is the number of values that
                        # actually pass a dynamic filter and starts at zero.
                        filtered: mutable bool = true
                        if condition is Expr.Absent:
                            filtered <- false
                        elif condition is Expr.BoolLit:
                            filtered <- false
                        if filtered:
                            _ = LLVMBuildStore(builder, LLVMConstInt(int64_type, 0, 0), count_pointer)
                        else:
                            _ = LLVMBuildStore(builder, count, count_pointer)
                        output_index_slot: LLVMValueRef = LLVMBuildAlloca(builder, int64_type, "comp.out.i")
                        _ = LLVMBuildStore(builder, LLVMConstInt(int64_type, 0, 0), output_index_slot)

                        function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                        index_slot: LLVMValueRef = LLVMBuildAlloca(builder, int64_type, "comp.i")
                        _ = LLVMBuildStore(builder, LLVMConstInt(int64_type, 0, 0), index_slot)
                        var_slot: LLVMValueRef = LLVMBuildAlloca(builder, llvm_type_of(index_type, structs, ctx), "comp.var")
                        declare_local(local_scope, comprehension_var, var_slot, index_type)

                        condition_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "comp.cond")
                        body_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "comp.input")
                        write_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "comp.write")
                        skip_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "comp.skip")
                        latch_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "comp.latch")
                        done_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "comp.done")
                        _ = LLVMBuildBr(builder, condition_block)
                        LLVMPositionBuilderAtEnd(builder, condition_block)
                        current: LLVMValueRef = LLVMBuildLoad2(builder, int64_type, index_slot, "comp.i.cur")
                        more: LLVMValueRef = LLVMBuildICmp(builder, 40, current, count, "comp.more")
                        _ = LLVMBuildCondBr(builder, more, body_block, done_block)

                        LLVMPositionBuilderAtEnd(builder, body_block)
                        _ = LLVMBuildStore(builder, LLVMBuildAdd(builder, low_value, current, "comp.var.value"), var_slot)
                        if filtered:
                            if emit_condition(condition, local_scope, fns, structs, generics, runtime, m, ctx, builder) is predicate:
                                _ = LLVMBuildCondBr(builder, predicate, write_block, skip_block)
                            else:
                                LLVMPositionBuilderAtEnd(builder, done_block)
                                return null
                            LLVMPositionBuilderAtEnd(builder, write_block)
                        if emit_expression(body, element_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is element_value:
                            loaded_items: LLVMValueRef = LLVMBuildLoad2(builder, LLVMPointerTypeInContext(ctx, 0), items_pointer, "comp.items")
                            # A darray indexes with a ONE-index GEP: `items` is already a T*.
                            output_index: LLVMValueRef = LLVMBuildLoad2(builder, int64_type, output_index_slot, "comp.out.i.cur") if filtered else current
                            comp_indices: mutable darray[LLVMValueRef] = [output_index]
                            comp_indices_pointer: void& = (&comp_indices[0]).cast[void&] can Unsafe.PointerCast
                            slot_pointer: LLVMValueRef = LLVMBuildGEP2(builder, llvm_type_of(element_type, structs, ctx), loaded_items, comp_indices_pointer, 1, "comp.slot")
                            _ = LLVMBuildStore(builder, element_value, slot_pointer)
                            if filtered:
                                _ = LLVMBuildStore(builder, LLVMBuildAdd(builder, output_index, LLVMConstInt(int64_type, 1, 0), "comp.out.i.next"), output_index_slot)
                                _ = LLVMBuildStore(builder, LLVMBuildAdd(builder, output_index, LLVMConstInt(int64_type, 1, 0), "comp.count.next"), count_pointer)
                            _ = LLVMBuildStore(builder, LLVMBuildAdd(builder, current, LLVMConstInt(int64_type, 1, 0), "comp.i.next"), index_slot)
                            # The LATCH is what carries the marker: this branch is the loop's
                            # back-edge, and `!llvm.loop` belongs on it.
                            _ = LLVMBuildBr(builder, latch_block)
                            LLVMPositionBuilderAtEnd(builder, skip_block)
                            _ = LLVMBuildStore(builder, LLVMBuildAdd(builder, current, LLVMConstInt(int64_type, 1, 0), "comp.i.skip"), index_slot)
                            _ = LLVMBuildBr(builder, latch_block)
                            LLVMPositionBuilderAtEnd(builder, latch_block)
                            latch: LLVMValueRef = LLVMBuildBr(builder, condition_block)
                            tag_autovec_loop(latch, "comprehension", ctx)
                            if not filtered:
                                LLVMPositionBuilderAtEnd(builder, write_block)
                                _ = LLVMBuildUnreachable(builder)
                                LLVMPositionBuilderAtEnd(builder, skip_block)
                                _ = LLVMBuildUnreachable(builder)
                            LLVMPositionBuilderAtEnd(builder, done_block)
                            return LLVMBuildLoad2(builder, header, result_slot, "list.comp.value")
                        LLVMPositionBuilderAtEnd(builder, done_block)
                        return null
            return null


        def emit_darray_push(array_slot: LLVMValueRef, array_type: ValueType, value_expression: Expr, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            element_type: ValueType = darray_element_of(array_type, structs)
            false return if element_type.kind == TypeKind.Unmodeled
            int64_type: LLVMTypeRef = LLVMInt64TypeInContext(ctx)
            header: LLVMTypeRef = darray_llvm_type(structs, ctx)
            stride: LLVMValueRef = element_stride(element_type, structs, ctx)

            items_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, header, array_slot, 0, "darray.items.ptr")
            count_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, header, array_slot, 1, "darray.count.ptr")
            capacity_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, header, array_slot, 2, "darray.cap.ptr")

            count: LLVMValueRef = LLVMBuildLoad2(builder, int64_type, count_pointer, "push.count")
            needed: LLVMValueRef = LLVMBuildAdd(builder, count, LLVMConstInt(int64_type, 1, 0), "push.needed")
            capacity: LLVMValueRef = LLVMBuildLoad2(builder, int64_type, capacity_pointer, "push.cap")

            function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
            grow_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "push.grow")
            store_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "push.store")
            # 35 = UGE: capacities are unsigned.
            enough: LLVMValueRef = LLVMBuildICmp(builder, 35, capacity, needed, "push.cap.ok")
            _ = LLVMBuildCondBr(builder, enough, store_block, grow_block)

            LLVMPositionBuilderAtEnd(builder, grow_block)
            doubled: LLVMValueRef = LLVMBuildMul(builder, capacity, LLVMConstInt(int64_type, 2, 0), "push.cap.double")
            # 32 = EQ.
            is_empty: LLVMValueRef = LLVMBuildICmp(builder, 32, capacity, LLVMConstInt(int64_type, 0, 0), "push.cap.zero")
            base: LLVMValueRef = LLVMBuildSelect(builder, is_empty, LLVMConstInt(int64_type, 256, 0), doubled, "push.cap.base")
            # 36 = ULT.
            too_small: LLVMValueRef = LLVMBuildICmp(builder, 36, base, needed, "push.cap.lt")
            new_capacity: LLVMValueRef = LLVMBuildSelect(builder, too_small, needed, base, "push.cap.new")
            old_bytes: LLVMValueRef = LLVMBuildMul(builder, capacity, stride, "push.old.bytes")
            new_bytes: LLVMValueRef = LLVMBuildMul(builder, new_capacity, stride, "push.new.bytes")

            old_items: LLVMValueRef = LLVMBuildLoad2(builder, LLVMPointerTypeInContext(ctx, 0), items_pointer, "push.items")
            is_null: LLVMValueRef = LLVMBuildICmp(builder, 32, old_items, LLVMConstNull(LLVMPointerTypeInContext(ctx, 0)), "push.items.null")
            alloc_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "push.alloc")
            realloc_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "push.realloc")
            grown_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "push.grown")
            _ = LLVMBuildCondBr(builder, is_null, alloc_block, realloc_block)

            # The fresh pointer lands in a slot rather than a phi: both arms are calls, and
            # a slot needs no incoming-block bookkeeping. mem2reg restores the phi at -O2.
            LLVMPositionBuilderAtEnd(builder, alloc_block)
            alloc_arguments: mutable darray[LLVMValueRef] = [runtime.arena, new_bytes]
            alloc_pointer: void& = (&alloc_arguments[0]).cast[void&] can Unsafe.PointerCast
            allocated: LLVMValueRef = LLVMBuildCall2(builder, runtime.arena_alloc_type, runtime.arena_alloc, alloc_pointer, 2, "push.alloc")
            _ = LLVMBuildStore(builder, allocated, items_pointer)
            _ = LLVMBuildBr(builder, grown_block)

            LLVMPositionBuilderAtEnd(builder, realloc_block)
            realloc_arguments: mutable darray[LLVMValueRef] = [runtime.arena, old_items, old_bytes, new_bytes]
            realloc_pointer: void& = (&realloc_arguments[0]).cast[void&] can Unsafe.PointerCast
            reallocated: LLVMValueRef = LLVMBuildCall2(builder, runtime.arena_realloc_type, runtime.arena_realloc, realloc_pointer, 4, "push.realloc")
            _ = LLVMBuildStore(builder, reallocated, items_pointer)
            _ = LLVMBuildBr(builder, grown_block)

            LLVMPositionBuilderAtEnd(builder, grown_block)
            _ = LLVMBuildStore(builder, new_capacity, capacity_pointer)
            _ = LLVMBuildBr(builder, store_block)

            LLVMPositionBuilderAtEnd(builder, store_block)
            if emit_expression(value_expression, element_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is pushed_value:
                items: LLVMValueRef = LLVMBuildLoad2(builder, LLVMPointerTypeInContext(ctx, 0), items_pointer, "push.items.cur")
                indices: mutable darray[LLVMValueRef] = [count]
                indices_pointer: void& = (&indices[0]).cast[void&] can Unsafe.PointerCast
                # ONE index: `items` is already a T*, not a pointer-to-array, so there is
                # no leading 0 to step over (unlike a fixed array's two-index GEP).
                slot: LLVMValueRef = LLVMBuildGEP2(builder, llvm_type_of(element_type, structs, ctx), items, indices_pointer, 1, "push.slot")
                _ = LLVMBuildStore(builder, pushed_value, slot)
                _ = LLVMBuildStore(builder, needed, count_pointer)
                return true
            return false


        # The user-defined `struct Arena`, when the program declares one. The NAME `Arena`
        # always annotates as TypeKind.Arena (the runtime carrier -- `in` blocks and arena
        # threading key on it), but the std DEFINES the struct itself, with fields the
        # allocator walks (`a.begin`). The two are layout-identical by construction (the
        # backend's auto-region {ptr,ptr,i64,i64} IS the std's {begin,end,end_index,
        # strategy}), so FIELD ACCESS resolves through the declared struct while the type
        # stays Arena everywhere else. Without this, every std function touching an arena
        # field declined -- arena_used_slots was the observable casualty.
        def arena_user_struct(structs: mutable StructTable&) -> ValueType can[Abort.Panic]:
            for index in 0..<structs.names.count |structs|:
                ValueType{kind: TypeKind.Struct, bits: index.u32()} return if structs.names[index] == "Arena"
            return unmodeled_type()


        # The ADDRESS of a struct-typed local, and the struct's type.
        #
        # For a plain local that is its alloca. For a `P&` parameter the alloca holds a
        # POINTER, so the address is that pointer LOADED — one indirection more. Everything
        # downstream (field GEP, field store) is then identical, which is why field access
        # needs no ref-specific path of its own.
        def struct_address_of(name: sview, local_scope: mutable Scope&, structs: mutable StructTable&, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            declared: ValueType = lookup_type(local_scope, name)
            if lookup_slot(local_scope, name) is slot:
                slot return if declared.kind == TypeKind.Struct
                # A `view[T]` local IS its slot (it holds the DynArrayView value inline).
                slot return if declared.kind == TypeKind.View
                if declared.kind == TypeKind.Ref:
                    ref_addr_target: mutable ValueType = ref_target_of(declared, structs)
                    # `a.begin` where `a: mutable Arena&` -- field access through the arena
                    # CARRIER reads the user-declared `struct Arena` (see arena_user_struct).
                    ref_addr_target <- arena_user_struct(structs) if ref_addr_target.kind == TypeKind.Arena
                    null return if ref_addr_target.kind != TypeKind.Struct and ref_addr_target.kind != TypeKind.View
                    return LLVMBuildLoad2(builder, LLVMPointerTypeInContext(ctx, 0), slot, "ref.deref")
                # `cursor.count` where `cursor: heap Node&?` -- field access through an
                # UN-NARROWED optional heap ref. stage0 represents `heap T&?` as a bare ptr
                # and emits the load unconditionally (the null case is guarded by program
                # flow, e.g. `while cursor != null`), so stage1 matches by reading the
                # optional's ptr payload out of its `{i1, ptr}` slot. Heap refs only: a
                # plain `T&?` has no such stage0 precedent.
                if declared.kind == TypeKind.Optional:
                    opt_payload: ValueType = optional_payload_of(declared, structs)
                    if opt_payload.kind == TypeKind.Ref and ref_is_heap_ref(opt_payload, structs):
                        opt_addr_target: ValueType = ref_target_of(opt_payload, structs)
                        null return if opt_addr_target.kind != TypeKind.Struct
                        opt_llvm: LLVMTypeRef = llvm_type_of(declared, structs, ctx)
                        opt_value_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, opt_llvm, slot, 1, "opt.heap.ptr")
                        return LLVMBuildLoad2(builder, LLVMPointerTypeInContext(ctx, 0), opt_value_pointer, "opt.heap.deref")
            return null


        # The struct type behind a name, looking through one reference.
        def struct_type_of_name(name: sview, local_scope: mutable Scope&, structs: mutable StructTable&) -> ValueType can[Abort.Panic]:
            declared: ValueType = lookup_type(local_scope, name)
            declared return if declared.kind == TypeKind.Struct
            # A `view[T]` accesses fields (`dst.data`, `dst.len`) through its DynArrayView.
            view_struct_type(declared, structs) return if declared.kind == TypeKind.View
            view_struct_type(ref_target_of(declared, structs), structs) return if declared.kind == TypeKind.Ref and ref_target_of(declared, structs).kind == TypeKind.View
            # An optional HEAP ref looks through both wrappers (see struct_address_of).
            if declared.kind == TypeKind.Optional:
                opt_name_payload: ValueType = optional_payload_of(declared, structs)
                ref_target_of(opt_name_payload, structs) return if opt_name_payload.kind == TypeKind.Ref and ref_is_heap_ref(opt_name_payload, structs)
            behind_ref: ValueType = ref_target_of(declared, structs)
            # An arena CARRIER's fields read the user-declared `struct Arena`.
            arena_user_struct(structs) return if behind_ref.kind == TypeKind.Arena
            return behind_ref


        # The struct type of a field-access CHAIN (`o`, `o.i`, `o.i.j`, ...). Recurses so
        # nested field reads resolve their receiver's type, not just a bare Ident's.
        def struct_chain_type(object: Expr, local_scope: mutable Scope&, structs: mutable StructTable&) -> ValueType can[Abort.Panic]:
            if object is Expr.Ident(chain_name, chain_name_line):
                return struct_type_of_name(chain_name, local_scope, structs)
            if object is Expr.Field(chain_inner, chain_field, chain_field_line):
                inner_type: ValueType = struct_chain_type(chain_inner, local_scope, structs)
                unmodeled_type() return if inner_type.kind != TypeKind.Struct
                inner_slot: usize = inner_type.bits.usize()
                position: i64 = field_index_of(structs, inner_slot, chain_field)
                unmodeled_type() return if position < 0
                return copied_type(structs.field_types[structs.field_start[inner_slot] + position.usize()])
            # `a[i]` -> the container's element type. Enables `a[i].field`.
            if object is Expr.Index(indexed_container, index_expr, index_line):
                # A bare local is looked up directly; any OTHER receiver (a nested index
                # `m[i][j]`, a field chain `s.grid[i]`) resolves recursively.
                container_type: mutable ValueType = struct_chain_type(indexed_container, local_scope, structs)
                if indexed_container is Expr.Ident(container_name, container_name_line):
                    local_container_type: ValueType = lookup_type(local_scope, container_name)
                    container_type <- local_container_type if local_container_type.kind != TypeKind.Unmodeled
                    # A global const ARRAY (`const xs: i64[3]`) is not a local: take its type
                    # from the const table so `xs[i]` resolves its element type.
                    if local_container_type.kind == TypeKind.Unmodeled:
                        const_container_index: i64 = const_index_of(structs, container_name)
                        container_type <- copied_type(structs.const_types[const_container_index.usize()]) if const_container_index >= 0 and structs.const_global_ok[const_container_index.usize()]
                darray_element_of(container_type, structs) return if container_type.kind == TypeKind.DArray
                array_element_of(container_type, structs) return if container_type.kind == TypeKind.Array
                # `items[i]` where `items: Struct&` — a C-style pointer base. The element is
                # the referent struct (the std indexes `DictBucket[K,T]&` this way).
                if container_type.kind == TypeKind.Ref:
                    ref_element: ValueType = ref_target_of(container_type, structs)
                    ref_element return if ref_element.kind == TypeKind.Struct
            return unmodeled_type()


        # The ADDRESS of a field-access chain's struct value. A bare Ident is its slot; a
        # nested field GEPs into its receiver's address. This is what makes `o.i.v` work:
        # the receiver `o.i` is itself a Field, addressed recursively rather than requiring
        # an Ident.
        def struct_chain_address(object: Expr, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            if object is Expr.Ident(chain_name, chain_name_line):
                return struct_address_of(chain_name, local_scope, structs, ctx, builder)
            if object is Expr.Field(chain_inner, chain_field, chain_field_line):
                inner_type: ValueType = struct_chain_type(chain_inner, local_scope, structs)
                null return if inner_type.kind != TypeKind.Struct
                inner_slot: usize = inner_type.bits.usize()
                position: i64 = field_index_of(structs, inner_slot, chain_field)
                null return if position < 0
                if struct_chain_address(chain_inner, local_scope, fns, structs, generics, runtime, m, ctx, builder) is inner_address:
                    inner_llvm: LLVMTypeRef = llvm_type_of(inner_type, structs, ctx)
                    return LLVMBuildStructGEP2(builder, inner_llvm, inner_address, position.u32(), "field.chain.ptr")
                return null
            # `a[i]` -> the element's ADDRESS, so `a[i].field` reads/writes in place rather
            # than spilling a copy. darray and fixed array use their own index-address paths.
            if object is Expr.Index(indexed_container, index_expr, index_line):
                if indexed_container is Expr.Ident(container_name, container_name_line):
                    container_type: ValueType = lookup_type(local_scope, container_name)
                    if lookup_slot(local_scope, container_name) is container_slot:
                        if container_type.kind == TypeKind.DArray:
                            return emit_darray_index_address(container_slot, container_type, index_expr, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                        if container_type.kind == TypeKind.Array:
                            return emit_index_address(container_slot, container_type, index_expr, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                        # `items[i]` where `items: Struct&` — the slot holds a pointer to
                        # element 0; the element address is a GEP by index at the struct's
                        # stride (C-style pointer indexing, how the std walks DictBucket rows).
                        if container_type.kind == TypeKind.Ref:
                            ref_element: ValueType = ref_target_of(container_type, structs)
                            if ref_element.kind == TypeKind.Struct:
                                base_pointer: LLVMValueRef = LLVMBuildLoad2(builder, LLVMPointerTypeInContext(ctx, 0), container_slot, "ref.base")
                                if emit_expression(index_expr, ValueType{kind: TypeKind.Signed, bits: 64}, local_scope, fns, structs, generics, runtime, m, ctx, builder) is index_value:
                                    element_llvm: LLVMTypeRef = llvm_type_of(ref_element, structs, ctx)
                                    ref_indices: mutable darray[LLVMValueRef] = [index_value]
                                    ref_indices_pointer: void& = (&ref_indices[0]).cast[void&] can Unsafe.PointerCast
                                    return LLVMBuildGEP2(builder, element_llvm, base_pointer, ref_indices_pointer, 1, "ref.index.ptr")
                                return null
                    # `xs[i]` where `xs` is a global const ARRAY — the base "slot" is the
                    # `@xs` global itself, GEP'd exactly like a local fixed array.
                    const_array_index: i64 = const_index_of(structs, container_name)
                    if const_array_index >= 0 and structs.const_global_ok[const_array_index.usize()]:
                        const_array_type: ValueType = copied_type(structs.const_types[const_array_index.usize()])
                        return emit_index_address(structs.const_globals[const_array_index.usize()], const_array_type, index_expr, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                    return null
                # A NESTED index (`m[i][j]`): address the inner element recursively, then
                # index into it.
                inner_container_type: ValueType = struct_chain_type(indexed_container, local_scope, structs)
                if struct_chain_address(indexed_container, local_scope, fns, structs, generics, runtime, m, ctx, builder) is inner_container_address:
                    if inner_container_type.kind == TypeKind.DArray:
                        return emit_darray_index_address(inner_container_address, inner_container_type, index_expr, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                    if inner_container_type.kind == TypeKind.Array:
                        return emit_index_address(inner_container_address, inner_container_type, index_expr, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                return null
            return null


        # Whether an expression threads its `expected` type down to sub-expressions rather
        # than producing a value directly. Such a form must NOT be implicitly wrapped: its
        # ARMS each wrap themselves, which is what makes `42 if flag else null` work.
        def propagates_expected(expression: Expr) -> bool can[Abort.Panic]:
            if expression is Expr.If(condition, then_expression, else_expression, line):
                return true
            if expression is Expr.Match(scrutinee, arms, match_line):
                return true
            if expression is Expr.Paren(inner, paren_line):
                return propagates_expected(inner)
            return false


        # Whether an expression is the `null` literal (an IDENT named "null" in the AST).
        def is_null_literal(expression: Expr) -> bool can[Abort.Panic]:
            if expression is Expr.Ident(name, line):
                return name == "null"
            return false


        # Wrap `value` (of type `payload`) into a `T?` — `{true, value}`.
        #
        # Built through a slot rather than insertvalue: the tag and payload are two plain
        # stores, and SROA collapses it at -O2 exactly the same. An Elisa expression of
        # payload type in an optional context is implicitly wrapped — the language has no
        # `some(x)`, so this is where that happens.
        # `force_null_test` — derive the tag from `value != null` even when the payload type
        # says the reference cannot be null. A REINTERPRET (`heapptr.cast[u8&?]`) is exactly
        # that case: the payload annotation is a plain `u8&`, but the value came from a raw
        # pointer that may well be null, and a constant `true` tag would hand the program a
        # null it believes is a real reference.
        def wrap_optional_tagged(value: LLVMValueRef, optional_type: ValueType, force_null_test: bool, structs: mutable StructTable&, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            optional_llvm: LLVMTypeRef = llvm_type_of(optional_type, structs, ctx)
            slot: LLVMValueRef = LLVMBuildAlloca(builder, optional_llvm, "opt")
            tag_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, optional_llvm, slot, 0, "opt.tag.ptr")
            # A HEAP pointer carries its own absence: null IS the empty case, which is how
            # stage0 represents `heap T&?` (a bare `ptr`, tested with `icmp ne ptr, null`).
            # Wrapping one with a hardcoded `true` tag would report a FAILED `malloc` as
            # present and hand the program a null it believes is real. An ordinary `T&` is
            # never null, so it keeps the constant tag.
            payload_type: ValueType = optional_payload_of(optional_type, structs)
            if force_null_test or (payload_type.kind == TypeKind.Ref and ref_is_heap_ref(payload_type, structs)):
                null_pointer: LLVMValueRef = LLVMConstNull(LLVMPointerTypeInContext(ctx, 0))
                _ = LLVMBuildStore(builder, LLVMBuildICmp(builder, 33, value, null_pointer, "opt.present"), tag_pointer)
            else:
                _ = LLVMBuildStore(builder, LLVMConstInt(LLVMInt1TypeInContext(ctx), 1, 0), tag_pointer)
            value_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, optional_llvm, slot, 1, "opt.value.ptr")
            _ = LLVMBuildStore(builder, value, value_pointer)
            return LLVMBuildLoad2(builder, optional_llvm, slot, "opt.wrapped")


        # The ordinary wrap: the payload TYPE decides whether the tag is a null test.
        def wrap_optional(value: LLVMValueRef, optional_type: ValueType, structs: mutable StructTable&, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            return wrap_optional_tagged(value, optional_type, false, structs, ctx, builder)


        # Emit a value expression, producing a value of `resolve_type(expression, expected)`.
        # `null` = unmodeled; the caller must decline.
        def emit_expression(expression: Expr, expected: ValueType, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            # IMPLICIT WRAP: Elisa has no `some(x)` — an expression of payload type in an
            # optional context IS the optional. Handled before everything else so each
            # value form stays unaware of optionals: re-emit at the PAYLOAD type, then wrap.
            # `null` is excluded (it is the empty optional, not a payload).
            if expected.kind == TypeKind.Optional:
                payload_type: ValueType = optional_payload_of(expected, structs)
                # A value-`if` / `match` already threads `expected` DOWN to its arms, so
                # each arm wraps itself. Wrapping the whole form instead would push the
                # payload type into the arms and reject `42 if flag else null` — the `null`
                # arm is not an i64.
                if not is_null_literal(expression) and not propagates_expected(expression):
                    own: ValueType = expression_type(expression, local_scope, fns, structs, generics)
                    if own.kind != TypeKind.Optional:
                        if emit_expression(expression, payload_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is payload_value:
                            return wrap_optional(payload_value, expected, structs, ctx, builder)
                        return null
            if expression is Expr.IntLit(literal_value):
                # A literal takes the context's type. sign_extend=1 so a negative literal
                # fills correctly at any width.
                null return if not is_integer_type(expected)
                return LLVMConstInt(llvm_type_of(expected, structs, ctx), literal_value.u64(), 1)
            if expression is Expr.BoolLit(bool_value):
                bool_type: LLVMTypeRef = LLVMInt1TypeInContext(ctx)
                return LLVMConstInt(bool_type, 1, 0) if bool_value else LLVMConstInt(bool_type, 0, 0)
            # `1.5` — built from the SOURCE TEXT, so LLVM's own parser decides the exact
            # bits rather than the backend re-implementing decimal rounding.
            if expression is Expr.FloatLit(float_text):
                null return if expected.kind != TypeKind.Float
                text_storage: mutable darray[u8] = []
                return LLVMConstRealOfString(llvm_type_of(expected, structs, ctx), sview_to_cstr(float_text, text_storage))
            # An ident is a local read: load from its slot, at the slot's own type.
            # `null` is an IDENT named "null" in the AST, not its own node. It is the
            # empty optional: `{false, undef}` — the payload half is never read when the
            # tag is false, so a zeroed struct is the whole value.
            # `move x` — an ownership TRANSFER, which the backend emits as the value itself.
            # Verified against stage0's IR: `freeze(move store)` adds no runtime call and no
            # new instruction, just `%frozen = alloca %Node__Store` + a copy of the store
            # value. The typestate (`Store[Local]` -> `Store[Frozen]`) is enforced by the
            # SEMANTIC checker -- same layout, no runtime effect -- so honouring the marker
            # here would be inventing work stage0 does not do.
            #
            # `freeze` itself never reaches the backend: the parser discards the marker and
            # yields the wrapped value.
            if expression is Expr.Move(moved_value, move_line):
                return emit_expression(moved_value, expected, local_scope, fns, structs, generics, runtime, m, ctx, builder)
            if expression is Expr.Comprehension(comp_var, comp_iterable, comp_condition, comp_body, comp_line):
                return emit_comprehension(comp_var, comp_iterable, comp_condition, comp_body, expected, local_scope, fns, structs, generics, runtime, m, ctx, builder)
            # `try CALL else FALLBACK` -> Expr.Refinement(fallback, guarded). Modeled only
            # when the guarded is a call to an ERROR-returning function: call it with a fresh
            # out-slot, and if the returned i32 code is 0 use the out-value, else the
            # fallback. (`get arr[i] else f`, the optional form, shares this node but is not
            # modeled here.)
            if expression is Expr.Refinement(try_fallback, try_guarded, try_line):
                if try_guarded is Expr.Call(try_callee, try_args, try_arg_names, try_call_line):
                    if try_callee is Expr.Ident(try_name, try_name_line):
                        if error_callee_is(fns, generics, try_name):
                            try_value_type: ValueType = error_callee_value_type(try_name, try_args, local_scope, fns, structs, generics)
                            null return if try_value_type.kind == TypeKind.Unmodeled
                            if error_callee_target(try_name, try_args, local_scope, fns, structs, generics, m, ctx) is try_target:
                                try_out_slot: LLVMValueRef = LLVMBuildAlloca(builder, llvm_type_of(try_value_type, structs, ctx), "try.out")
                                try_call_args: mutable darray[LLVMValueRef] = [try_out_slot]
                                try_declined: mutable bool = false
                                try_arg_index: mutable usize = 0
                                for try_arg in try_args |try_call_args, try_declined, try_arg_index, try_name, local_scope, fns, structs, generics, runtime, m, ctx, builder|:
                                    if emit_expression(try_arg, error_callee_param_type(try_name, try_args, try_arg_index, local_scope, fns, structs, generics), local_scope, fns, structs, generics, runtime, m, ctx, builder) is try_arg_value:
                                        try_call_args.push(try_arg_value)
                                    else:
                                        try_declined <- true
                                    try_arg_index <- try_arg_index + 1
                                null return if try_declined
                                try_fn_type: LLVMTypeRef = LLVMGlobalGetValueType(try_target)
                                try_args_pointer: void& = (&try_call_args[0]).cast[void&] can Unsafe.PointerCast
                                try_code: LLVMValueRef = LLVMBuildCall2(builder, try_fn_type, try_target, try_args_pointer, try_call_args.count.u32(), "try.code")
                                try_ok: LLVMValueRef = LLVMBuildICmp(builder, 32, try_code, LLVMConstInt(LLVMInt32TypeInContext(ctx), 0, 0), "try.ok")
                                function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                                try_value_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "try.value")
                                try_fallback_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "try.fallback")
                                try_done_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "try.done")
                                # alloca+store+load, not phi -- the codebase avoids phi (a
                                # void phi ICEs stage0, and the two paths merge cleanly here).
                                try_result_type: LLVMTypeRef = llvm_type_of(try_value_type, structs, ctx)
                                try_result_slot: LLVMValueRef = LLVMBuildAlloca(builder, try_result_type, "try.result")
                                _ = LLVMBuildCondBr(builder, try_ok, try_value_block, try_fallback_block)
                                LLVMPositionBuilderAtEnd(builder, try_value_block)
                                try_value: LLVMValueRef = LLVMBuildLoad2(builder, try_result_type, try_out_slot, "try.value.load")
                                _ = LLVMBuildStore(builder, try_value, try_result_slot)
                                _ = LLVMBuildBr(builder, try_done_block)
                                LLVMPositionBuilderAtEnd(builder, try_fallback_block)
                                if emit_expression(try_fallback, try_value_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is try_fallback_value:
                                    _ = LLVMBuildStore(builder, try_fallback_value, try_result_slot)
                                    _ = LLVMBuildBr(builder, try_done_block)
                                else:
                                    return null
                                LLVMPositionBuilderAtEnd(builder, try_done_block)
                                return LLVMBuildLoad2(builder, try_result_type, try_result_slot, "try.value")
                # `get OPT else FALLBACK` — the OPTIONAL-unwrap form: evaluate the guarded
                # optional; if present yield its payload, else the fallback. (The error-call
                # form above shares this node; a darray-bounds `get arr[i] else f` does not,
                # since arr[i] is not optional-typed here — it declines.)
                opt_guarded_type: ValueType = expression_type(try_guarded, local_scope, fns, structs, generics)
                if opt_guarded_type.kind == TypeKind.Optional:
                    opt_payload_type: ValueType = optional_payload_of(opt_guarded_type, structs)
                    null return if opt_payload_type.kind == TypeKind.Unmodeled
                    if emit_expression(try_guarded, opt_guarded_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is opt_guarded_value:
                        opt_llvm: LLVMTypeRef = llvm_type_of(opt_guarded_type, structs, ctx)
                        opt_holder: LLVMValueRef = LLVMBuildAlloca(builder, opt_llvm, "get.opt")
                        _ = LLVMBuildStore(builder, opt_guarded_value, opt_holder)
                        opt_tag_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, opt_llvm, opt_holder, 0, "get.tag.ptr")
                        opt_tag: LLVMValueRef = LLVMBuildLoad2(builder, LLVMInt1TypeInContext(ctx), opt_tag_pointer, "get.tag")
                        opt_function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                        opt_value_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, opt_function, "get.value")
                        opt_fallback_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, opt_function, "get.fallback")
                        opt_done_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, opt_function, "get.done")
                        opt_payload_llvm: LLVMTypeRef = llvm_type_of(opt_payload_type, structs, ctx)
                        opt_result_slot: LLVMValueRef = LLVMBuildAlloca(builder, opt_payload_llvm, "get.result")
                        _ = LLVMBuildCondBr(builder, opt_tag, opt_value_block, opt_fallback_block)
                        LLVMPositionBuilderAtEnd(builder, opt_value_block)
                        opt_value_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, opt_llvm, opt_holder, 1, "get.value.ptr")
                        _ = LLVMBuildStore(builder, LLVMBuildLoad2(builder, opt_payload_llvm, opt_value_pointer, "get.value.load"), opt_result_slot)
                        _ = LLVMBuildBr(builder, opt_done_block)
                        LLVMPositionBuilderAtEnd(builder, opt_fallback_block)
                        if emit_expression(try_fallback, opt_payload_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is opt_fallback_value:
                            _ = LLVMBuildStore(builder, opt_fallback_value, opt_result_slot)
                            _ = LLVMBuildBr(builder, opt_done_block)
                        else:
                            return null
                        LLVMPositionBuilderAtEnd(builder, opt_done_block)
                        opt_result: LLVMValueRef = LLVMBuildLoad2(builder, opt_payload_llvm, opt_result_slot, "get.value")
                        return emit_conversion(opt_result, opt_payload_type, expected, structs, ctx, builder) if expected.kind != TypeKind.Unmodeled and (expected.kind != opt_payload_type.kind or expected.bits != opt_payload_type.bits) else opt_result
