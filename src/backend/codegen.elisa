# Stage1 backend — LLVM codegen (`module Backend`).
#
# The stage0 counterpart is compiler/src/backend/llvm_*.go (~54k lines of cgo). This is
# the growing port of that: it walks the stage1 AST and drives LLVM-C (see llvm_c.elisa).
#
# Sound SUBSET, mirroring how the frontend was ported: only firmly-modeled constructs
# emit. Every emitter returns a "declined" signal for anything it does not model, and
# `emit_module` turns ANY decline into a whole-module decline, so the driver reports an
# honest UNSUPPORTED instead of handing back a module that is quietly missing code.
# Coverage grows one construct at a time, each with a compile-and-run fixture asserting
# real behavior (an exit code), plus a differential against stage0 where the reference
# compiler can compile the same source.
#
# Modeled today: `def f(a: i64, …) -> i64` over signed i64 — int literals, idents,
# `+ - * / %`, unary `+`/`-`, comparisons, parens, locals (`x: i64 = …`), assignment,
# `if`/`else`, `while`, `return`, and direct calls to other modeled functions.

include "../semantic/semantic.elisa"
include "llvm_c.elisa"
using Ast

module Backend:

    private:

        # LLVM-C takes NUL-terminated `const char*`, but an `sview` is a (ptr, len) view
        # into the source buffer with no terminator — taking `&view[0]` would hand LLVM a
        # string that runs to the end of the FILE. Copy the bytes and terminate.
        # `storage` is caller-owned on purpose: the returned pointer aliases it, so it
        # must outlive the LLVM call that consumes the name.
        def sview_to_cstr(name: sview, storage: mutable darray[u8]&) -> cstr can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            for index in 0..<sview_len(name) |storage|:
                storage.push(sview_at(name, index))
            storage.push(0)
            return (&storage[0]).cast[cstr] can Unsafe.PointerCast


        # The LLVM SYMBOL name for `owner::name`: stage0 emits `module M: def get()` as
        # `define i64 @M.get` — DOT-separated, even though the call spelling is `M::get()`.
        # An empty owner is a top-level function and keeps its bare name.
        def qualified_name_cstr(owner: sview, name: sview, storage: mutable darray[u8]&) -> cstr can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            sview_to_cstr(name, storage) return if sview_len(owner) == 0
            for index in 0..<sview_len(owner) |storage|:
                storage.push(sview_at(owner, index))
            storage.push(46)
            for index in 0..<sview_len(name) |storage|:
                storage.push(sview_at(name, index))
            storage.push(0)
            return (&storage[0]).cast[cstr] can Unsafe.PointerCast


        # A modeled value's type. `bits` is the integer width; `Bool` is i1 (LLVM's
        # natural boolean) and carries no width of its own.
        #
        # Signedness is not cosmetic: stage0 lowers `u8 200 / 3` to `udiv` (66) and
        # `u8 200 >> 1` to `lshr` (100). Reading those as signed gives -56 and 228 — so a
        # backend that ignores signedness silently miscompiles unsigned arithmetic.
        const enum TypeKind of u8:
            Unmodeled
            Signed
            Unsigned
            Bool
            Float
            # `void` — legal ONLY as a return type. It has no values, so nothing can be a
            # `void` local, parameter, or operand; every other position rejects it because
            # `unmodeled_type()` is what those paths test for and Void is not that.
            Void
            # A user struct. `bits` is its index in the StructTable — a ValueType must stay
            # POD (an sview name would be fine, but an index also gives O(1) field lookup).
            Struct
            # A fixed array `T[N]`. `bits` indexes the StructTable's ARRAY side-pool
            # (`array_elements` / `array_extents`) — same reason as Struct: ValueType is
            # POD, so a nested element type cannot live inline.
            Array
            # `Arena` — the runtime's region carrier, `{ptr, ptr, i64, i64}`, passed BY
            # VALUE (stage0: `define i64 @build(%Arena %0)` and `%r1 = load %Arena, ptr %r`
            # at the call site). Note the asymmetry: `Arena` is legal as a PARAMETER type
            # but rejected as a region ANNOTATION (`-> darray[i64] @owner` is "internal
            # runtime carrier type ... not supported in user-facing code").
            Arena
            # A PAYLOAD-carrying enum (`enum Shape: Circle(r: i64)`). In LLVM a TAGGED UNION
            # `{ i32, [N x i64] }`: field 0 is the variant ORDINAL, field 1 is payload
            # storage sized to the largest variant (stage0's `%Shape = type { i32, [1 x
            # i64] }`, read from its IR). NOT the AoS packed store -- that is `packed enum`,
            # a different subsystem. `bits` indexes the PAYLOAD-ENUM side-pool.
            PayloadEnum
            # `cstr` — a NUL-terminated string constant. In LLVM just a `ptr`: stage0
            # lowers `s: cstr = "hi"` to `@str = private unnamed_addr constant [3 x i8]
            # c"hi\00"` plus `store ptr @str`. Carries no length, so `.count`, indexing and
            # comparison are NOT modeled (they need the runtime) and decline.
            CStr
            # A reference `T&` / `mutable T&`. `bits` indexes the REF side-pool
            # (`ref_targets`). In LLVM it is just a `ptr` — stage0 lowers
            # `def bump(n: mutable i64&)` to `define void @bump(ptr)` and `bump(x)` to
            # `call void @bump(ptr %x)`. Mutability is a FRONTEND concern (it already
            # rejects writes through a `T&`), so the backend models only the referent.
            Ref
            # An optional `T?`. `bits` indexes the OPTIONAL side-pool (`optional_targets`).
            # Represented exactly as stage0 does — `{i1 has_value, T value}` (read from its
            # `-emit llvm`: `%Optional__i64 = type { i1, i64 }`).
            Optional
            # A `darray[T]`. `bits` indexes the DARRAY side-pool (`darray_elements`).
            # Represented exactly as stage0 does — `{ptr items, i64 count, i64 capacity}`,
            # backed by an Arena — because both link the SAME runtime, so the layout is
            # dictated, not chosen.
            DArray


        struct ValueType:
            kind: TypeKind
            bits: u32


        def unmodeled_type() -> ValueType:
            return ValueType{kind: TypeKind.Unmodeled, bits: 0}


        def is_integer_type(value_type: ValueType) -> bool:
            return value_type.kind == TypeKind.Signed or value_type.kind == TypeKind.Unsigned


        def is_numeric_type(value_type: ValueType) -> bool:
            return is_integer_type(value_type) or value_type.kind == TypeKind.Float


        # The named scalar types the backend models. Anything else (f32/f64, containers,
        # user types) yields Unmodeled and DECLINES rather than being guessed at.
        #
        # `int` is stage0's signed 64-bit default; `usize` is pointer-width (64 here — the
        # port targets arm64/x86-64, and a 32-bit target would need this to follow the
        # target triple).
        def scalar_type_of_name(name: sview) -> ValueType:
            ValueType{kind: TypeKind.CStr, bits: 0} return if name == "cstr"
            ValueType{kind: TypeKind.Signed, bits: 8} return if name == "i8"
            ValueType{kind: TypeKind.Signed, bits: 16} return if name == "i16"
            ValueType{kind: TypeKind.Signed, bits: 32} return if name == "i32"
            ValueType{kind: TypeKind.Signed, bits: 64} return if name == "i64" or name == "int"
            ValueType{kind: TypeKind.Unsigned, bits: 8} return if name == "u8"
            ValueType{kind: TypeKind.Unsigned, bits: 16} return if name == "u16"
            ValueType{kind: TypeKind.Unsigned, bits: 32} return if name == "u32"
            ValueType{kind: TypeKind.Unsigned, bits: 64} return if name == "u64" or name == "usize"
            ValueType{kind: TypeKind.Bool, bits: 1} return if name == "bool"
            ValueType{kind: TypeKind.Float, bits: 32} return if name == "f32"
            ValueType{kind: TypeKind.Float, bits: 64} return if name == "f64"
            ValueType{kind: TypeKind.Void, bits: 0} return if name == "void"
            return unmodeled_type()


        # What `name` is bound to in the CURRENT instantiation, or Unmodeled if it is not a
        # type parameter (i.e. it is an ordinary type name).
        def bound_type_of(structs: mutable StructTable&, name: sview) -> ValueType can[Abort.Panic]:
            for index in 0..<structs.binding_names.count |structs, name|:
                copied_type(structs.binding_types[index]) return if structs.binding_names[index] == name
            return unmodeled_type()


        # The return type of generic `base` instantiated at `type_argument`: its return
        # annotation resolved under that binding.
        def generic_return_type(base: sview, type_argument: ValueType, generics: mutable GenericTable&, structs: mutable StructTable&) -> ValueType can[Abort.Panic, Memory.Allocate]:
            index: i64 = generic_index_of(generics, base)
            unmodeled_type() return if index < 0
            slot: usize = index.usize()
            unmodeled_type() return if generics.param_count[slot] != 1
            if generics.decls[slot] is Decl.Func(function_name, params, return_type_opt, body, effects, decorators, line):
                if return_type_opt is declared_return:
                    structs.binding_names <- structs.binding_names.push(generics.params[generics.param_start[slot]])
                    structs.binding_types <- structs.binding_types.push(copied_type(type_argument))
                    resolved: ValueType = annotation_value_type(declared_return, structs)
                    _ = structs.binding_names.pop()
                    _ = structs.binding_types.pop()
                    return resolved
            return unmodeled_type()


        # The type an annotation denotes. Only a bare scalar name is modeled.
        #
        # `mutable` is a QUALIFIER on the annotation, not part of the type: `x: mutable
        # i64` denotes i64 and just says the binding can be reassigned. It rides as a
        # Unary node wrapping the type, so it is unwrapped here — mutability is the
        # frontend's business (it already rejects `x <- 1` on an immutable local), and the
        # backend only needs the underlying type.
        def annotation_value_type(type_expression: Expr, structs: mutable StructTable&) -> ValueType can[Abort.Panic]:
            if type_expression is Expr.Unary(qualifier, qualified_type, qualifier_line):
                # `mutable T` — a QUALIFIER, not part of the type: mutability is the
                # frontend's business, so the underlying type is what matters.
                annotation_value_type(qualified_type, structs) return if qualifier == TokenKind.Mutable
                # `T&` — a POSTFIX unary in the AST (the parser distinguishes it from infix
                # bitwise-and by looking past the whole `&` run).
                intern_ref_type(annotation_value_type(qualified_type, structs), structs) return if qualifier == TokenKind.Ampersand
                # `T?` — also a postfix unary.
                intern_optional_type(annotation_value_type(qualified_type, structs), structs) return if qualifier == TokenKind.Question
                return unmodeled_type()
            # `i64[3]` — a fixed array. The bracket holds an extent VALUE and the HEAD is
            # the element type. A NON-literal bracket (`cstr[shape]`) is a shape parameter,
            # not an array, and is not modeled.
            if type_expression is Expr.Index(array_head, array_extent, array_line):
                # `darray[T]` — the head is a CONTAINER NAME, not an element type, and the
                # bracket holds a TYPE rather than an extent.
                if array_head is Expr.Ident(container_name, container_line):
                    if container_name == "darray":
                        darray_element: ValueType = annotation_value_type(array_extent, structs)
                        # Only scalar elements are modeled: a nested container or struct
                        # element needs its own stride/layout handling.
                        unmodeled_type() return if darray_element.kind == TypeKind.Unmodeled or darray_element.kind == TypeKind.Struct
                        unmodeled_type() return if darray_element.kind == TypeKind.Array or darray_element.kind == TypeKind.DArray
                        return intern_darray_type(darray_element, structs)
                if array_extent is Expr.IntLit(extent_value):
                    element: ValueType = annotation_value_type(array_head, structs)
                    unmodeled_type() return if element.kind == TypeKind.Unmodeled or element.kind == TypeKind.Array
                    unmodeled_type() return if extent_value <= 0
                    return intern_array_type(element, extent_value.u32(), structs)
                return unmodeled_type()
            if type_expression is Expr.Ident(type_name, type_line):
                # A TYPE PARAMETER shadows everything: inside an instantiation of
                # `identity[T]` with T=i64, the annotation `T` denotes i64.
                bound: ValueType = bound_type_of(structs, type_name)
                bound return if bound.kind != TypeKind.Unmodeled
                scalar: ValueType = scalar_type_of_name(type_name)
                scalar return if scalar.kind != TypeKind.Unmodeled
                ValueType{kind: TypeKind.Arena, bits: 0} return if type_name == "Arena"
                # An ALIAS denotes its target and has no representation of its own. Resolved
                # to a fixpoint at registration, so this is a lookup, never a recursion.
                alias_index: i64 = alias_index_of(structs, type_name)
                copied_type(structs.alias_types[alias_index.usize()]) return if alias_index >= 0
                # A CONST ENUM name denotes its BACKING scalar — stage0 passes
                # `c: Color` as an i8, so there is no distinct enum type to model.
                enum_index: i64 = enum_index_of(structs, type_name)
                copied_type(structs.enum_backings[enum_index.usize()]) return if enum_index >= 0
                penum_index: i64 = penum_index_of(structs, type_name)
                ValueType{kind: TypeKind.PayloadEnum, bits: penum_index.u32()} return if penum_index >= 0
                # A user STRUCT name: `bits` carries its registry index.
                struct_index: i64 = struct_index_of(structs, type_name)
                ValueType{kind: TypeKind.Struct, bits: struct_index.u32()} return if struct_index >= 0
            return unmodeled_type()


        # The LLVM type backing a ValueType.
        def llvm_type_of(value_type: ValueType, structs: mutable StructTable&, ctx: LLVMContextRef) -> LLVMTypeRef can[Abort.Panic]:
            LLVMVoidTypeInContext(ctx) return if value_type.kind == TypeKind.Void
            LLVMInt1TypeInContext(ctx) return if value_type.kind == TypeKind.Bool
            # A cstr is an opaque `ptr`, exactly as stage0 passes it (`define i64
            # @take(ptr)`).
            LLVMPointerTypeInContext(ctx, 0) return if value_type.kind == TypeKind.CStr
            arena_llvm_type(ctx) return if value_type.kind == TypeKind.Arena
            # `{ i32, [N x i64] }` — stage0's tagged-union layout for a payload enum.
            if value_type.kind == TypeKind.PayloadEnum:
                words: u32 = structs.penum_payload_words[value_type.bits.usize()]
                penum_fields: mutable darray[LLVMTypeRef] = [LLVMInt32TypeInContext(ctx), LLVMArrayType(LLVMInt64TypeInContext(ctx), words)]
                penum_pointer: void& = (&penum_fields[0]).cast[void&] can Unsafe.PointerCast
                return LLVMStructTypeInContext(ctx, penum_pointer, 2, 0)
            structs.handles[value_type.bits.usize()] return if value_type.kind == TypeKind.Struct
            if value_type.kind == TypeKind.Array:
                slot: usize = value_type.bits.usize()
                return LLVMArrayType(llvm_type_of(structs.array_elements[slot], structs, ctx), structs.array_extents[slot])
            # `{i1 has_value, T value}` — stage0's Optional layout.
            if value_type.kind == TypeKind.Optional:
                payload: ValueType = copied_type(structs.optional_targets[value_type.bits.usize()])
                fields: mutable darray[LLVMTypeRef] = [LLVMInt1TypeInContext(ctx), llvm_type_of(payload, structs, ctx)]
                fields_pointer: void& = (&fields[0]).cast[void&] can Unsafe.PointerCast
                return LLVMStructTypeInContext(ctx, fields_pointer, 2, 0)
            # A reference is just a pointer; the referent matters only at the load/store.
            LLVMPointerTypeInContext(ctx, 0) return if value_type.kind == TypeKind.Ref
            # `{ptr items, i64 count, i64 capacity}` — stage0's DynArray layout, which the
            # shared runtime dictates.
            if value_type.kind == TypeKind.DArray:
                return darray_llvm_type(structs, ctx)
            if value_type.kind == TypeKind.Float:
                return LLVMFloatTypeInContext(ctx) if value_type.bits == 32 else LLVMDoubleTypeInContext(ctx)
            LLVMInt8TypeInContext(ctx) return if value_type.bits == 8
            LLVMInt16TypeInContext(ctx) return if value_type.bits == 16
            LLVMInt32TypeInContext(ctx) return if value_type.bits == 32
            return LLVMInt64TypeInContext(ctx)


        # The module's struct types.
        #
        # Field names/types live in FLAT pools with a per-struct span, the same shape as
        # FnTable's parameters — a nested `darray[darray[…]]` would make this
        # region-polymorphic for no benefit.
        struct StructTable:
            names: mutable darray[sview]
            handles: mutable darray[LLVMTypeRef]
            field_names: mutable darray[sview]
            field_types: mutable darray[ValueType]
            field_start: mutable darray[usize]
            field_count: mutable darray[usize]
            # Fixed-array types, interned on demand: `array_elements[i]` is the element
            # type and `array_extents[i]` the length of the array whose ValueType has
            # `bits == i`. Interning (rather than a fresh entry per mention) keeps
            # `i64[3]` one type, so two locals of the same array type compare equal.
            array_elements: mutable darray[ValueType]
            array_extents: mutable darray[u32]
            # `darray[T]` element types, interned the same way.
            darray_elements: mutable darray[ValueType]
            # `T&` referent types, interned the same way.
            ref_targets: mutable darray[ValueType]
            # `T?` payload types, interned the same way.
            optional_targets: mutable darray[ValueType]
            # CONST enums. A `const enum Color of u8` IS its backing scalar (stage0 lowers
            # `def code(c: Color)` to `define i64 @code(i8 %0)`), and a variant is its
            # ORDINAL — `match c: Color.Red:` is `icmp eq i8 %c, 0`. So the backend needs
            # only name -> backing type, and (enum, variant) -> ordinal. Flat pools with a
            # per-enum span, same shape as struct fields.
            enum_names: mutable darray[sview]
            enum_backings: mutable darray[ValueType]
            enum_variants: mutable darray[sview]
            enum_variant_start: mutable darray[usize]
            enum_variant_count: mutable darray[usize]
            # PAYLOAD-carrying enums, in a side-pool parallel to the const-enum one above.
            # `penum_payloads` is the payload ValueType of each variant (one per variant, in
            # declaration order); a variant with NO payload still takes a slot so that a
            # variant's index within its enum IS its tag.
            penum_names: mutable darray[sview]
            penum_variants: mutable darray[sview]
            penum_payloads: mutable darray[ValueType]
            penum_has_payload: mutable darray[bool]
            penum_variant_start: mutable darray[usize]
            penum_variant_count: mutable darray[usize]
            # Payload words (i64 units) of the WIDEST variant — the `[N x i64]` extent.
            penum_payload_words: mutable darray[u32]
            # `alias Num = i64` — a NAME for an existing type, carrying no representation of
            # its own, so it resolves to the target's ValueType and disappears.
            #
            # Resolved to a FIXPOINT at registration rather than by recursing at each
            # mention: `alias A = B` / `alias B = A` would otherwise recurse forever (the
            # same shape as the value-binding cycle that stack-overflows a naive resolver).
            # A cycle simply never resolves, stays Unmodeled, and DECLINES.
            alias_names: mutable darray[sview]
            alias_types: mutable darray[ValueType]
            # GLOBAL consts. stage0 INLINES them: `const LIMIT: i64 = 42` emits no `@LIMIT`
            # global and no load — `LIMIT + NAME.i64()` lowers to `sadd(42, 7)` (read from
            # its -emit llvm output). So a const is a compile-time VALUE substituted at the
            # use site, and the backend needs only name -> (type, folded value).
            #
            # Folded to a FIXPOINT, unlike aliases: stage0 ACCEPTS a forward reference here
            # (`const A: i64 = B + 2` before `const B` works — verified), so an in-order pass
            # would decline a program the reference compiler compiles. A CYCLE never folds
            # and stays unresolved, which declines — stage0 rejects it too ("const \"A\"
            # initializer must be a compile-time i64 value").
            const_names: mutable darray[sview]
            const_types: mutable darray[ValueType]
            const_values: mutable darray[i64]
            const_resolved: mutable darray[bool]
            # The CURRENT generic instantiation's type-parameter bindings: `binding_names[i]`
            # (e.g. "T") stands for `binding_types[i]` (e.g. i64). Empty outside one.
            #
            # These live in the registry rather than as their own threaded parameter: the
            # registry already reaches every place a type is resolved, and constructing a
            # fresh empty bindings table per call site is REGION-POLYMORPHIC (so illegal in
            # a non-region-inferable context). Set on entry to an instantiation, cleared on
            # exit. `binding_names` are sviews into the source buffer, so nothing dangles.
            binding_names: mutable darray[sview]
            binding_types: mutable darray[ValueType]


        # The LLVM type of ANY darray: `{ptr, i64, i64}` = {items, count, capacity}.
        #
        # One shape for every element type — the element only affects the STRIDE when
        # indexing, never the header. Matches stage0's `%DynArray__T` (verified by reading
        # its `-emit llvm` output); the layout is dictated by the shared runtime.
        def darray_llvm_type(structs: mutable StructTable&, ctx: LLVMContextRef) -> LLVMTypeRef can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            int64_type: LLVMTypeRef = LLVMInt64TypeInContext(ctx)
            fields: mutable darray[LLVMTypeRef] = [LLVMPointerTypeInContext(ctx, 0), int64_type, int64_type]
            fields_pointer: void& = (&fields[0]).cast[void&] can Unsafe.PointerCast
            return LLVMStructTypeInContext(ctx, fields_pointer, 3, 0)


        # The `Arena` header: `{ptr, ptr, i64, i64}`. Field 3 is the STRATEGY, which the
        # runtime reads; stage0 stores 2 (lazy) for an auto region, so this does too.
        def arena_llvm_type(ctx: LLVMContextRef) -> LLVMTypeRef can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            pointer_type: LLVMTypeRef = LLVMPointerTypeInContext(ctx, 0)
            int64_type: LLVMTypeRef = LLVMInt64TypeInContext(ctx)
            fields: mutable darray[LLVMTypeRef] = [pointer_type, pointer_type, int64_type, int64_type]
            fields_pointer: void& = (&fields[0]).cast[void&] can Unsafe.PointerCast
            return LLVMStructTypeInContext(ctx, fields_pointer, 4, 0)


        # Copy a ValueType out of the region-backed registry.
        #
        # ValueType is POD, but a value read straight out of `structs`' darrays is a
        # BORROW tied to the registry's region — returning it region-less is (correctly)
        # rejected. Rebuilding it from its fields severs the borrow at zero cost.
        def copied_type(value_type: ValueType) -> ValueType:
            return ValueType{kind: value_type.kind, bits: value_type.bits}


        # Intern a fixed-array type `element[extent]`, returning its ValueType. Same
        # element+extent always yields the same index, so `i64[3]` is one type.
        def intern_array_type(element: ValueType, extent: u32, structs: mutable StructTable&) -> ValueType can[Abort.Panic, Memory.Allocate]:
            for index in 0..<structs.array_elements.count |structs, element, extent|:
                existing: ValueType = structs.array_elements[index]
                if existing.kind == element.kind and existing.bits == element.bits and structs.array_extents[index] == extent:
                    return ValueType{kind: TypeKind.Array, bits: index.u32()}
            structs.array_elements <- structs.array_elements.push(element)
            structs.array_extents <- structs.array_extents.push(extent)
            return ValueType{kind: TypeKind.Array, bits: (structs.array_elements.count - 1).u32()}


        # Intern a `darray[T]` type.
        def intern_darray_type(element: ValueType, structs: mutable StructTable&) -> ValueType can[Abort.Panic, Memory.Allocate]:
            for index in 0..<structs.darray_elements.count |structs, element|:
                existing: ValueType = structs.darray_elements[index]
                if existing.kind == element.kind and existing.bits == element.bits:
                    return ValueType{kind: TypeKind.DArray, bits: index.u32()}
            structs.darray_elements <- structs.darray_elements.push(element)
            return ValueType{kind: TypeKind.DArray, bits: (structs.darray_elements.count - 1).u32()}


        # Intern a reference type `T&`.
        def intern_ref_type(target: ValueType, structs: mutable StructTable&) -> ValueType can[Abort.Panic, Memory.Allocate]:
            unmodeled_type() return if target.kind == TypeKind.Unmodeled
            for index in 0..<structs.ref_targets.count |structs, target|:
                existing: ValueType = structs.ref_targets[index]
                if existing.kind == target.kind and existing.bits == target.bits:
                    return ValueType{kind: TypeKind.Ref, bits: index.u32()}
            structs.ref_targets <- structs.ref_targets.push(target)
            return ValueType{kind: TypeKind.Ref, bits: (structs.ref_targets.count - 1).u32()}


        # Intern an optional type `T?`.
        def intern_optional_type(payload: ValueType, structs: mutable StructTable&) -> ValueType can[Abort.Panic, Memory.Allocate]:
            unmodeled_type() return if payload.kind == TypeKind.Unmodeled or payload.kind == TypeKind.Optional
            for index in 0..<structs.optional_targets.count |structs, payload|:
                existing: ValueType = structs.optional_targets[index]
                if existing.kind == payload.kind and existing.bits == payload.bits:
                    return ValueType{kind: TypeKind.Optional, bits: index.u32()}
            structs.optional_targets <- structs.optional_targets.push(payload)
            return ValueType{kind: TypeKind.Optional, bits: (structs.optional_targets.count - 1).u32()}


        # The payload type of a `T?`.
        def optional_payload_of(value_type: ValueType, structs: mutable StructTable&) -> ValueType can[Abort.Panic]:
            unmodeled_type() return if value_type.kind != TypeKind.Optional
            return copied_type(structs.optional_targets[value_type.bits.usize()])


        # The referent type of a `T&`.
        # A function gains an implicit trailing `ptr` arena parameter — and allocates from
        # THAT rather than its own auto region — when a container it touches must outlive
        # the call. Two triggers, both verified against stage0's IR:
        #
        #   * a GROWABLE container REF param: `def fill(out: mutable darray[i64]&)` emits as
        #     `define void @fill(ptr, ptr)` and grows via `arena_alloc(ptr %1, ...)`;
        #   * a container RETURN type: `def build() -> darray[i64]` emits as
        #     `define %DynArray__i64 @build(ptr %0)` and allocates the returned darray's
        #     backing from the CALLER's region.
        #
        # Both are the same rule: the backing belongs to the caller, so a callee-local
        # region would free it at return and hand back freed memory. The return case IS
        # region-return inference, and it is why returning an owned container no longer has
        # to decline (see 95915b5, which declined it precisely because this was missing).
        def signature_needs_arena(params: darray[ParamDecl]&, return_value_type: ValueType, structs: mutable StructTable&) -> bool can[Abort.Panic]:
            true return if return_value_type.kind == TypeKind.DArray
            for parameter in params |structs|:
                parameter_type: ValueType = annotation_value_type(parameter.type_expression, structs)
                continue if parameter_type.kind != TypeKind.Ref
                true return if ref_target_of(parameter_type, structs).kind == TypeKind.DArray
            return false


        # The darray ValueType behind `name`, whether it is a local darray or a
        # `darray[T]&` parameter — Unmodeled when it is neither.
        def darray_type_behind(local_scope: mutable Scope&, name: sview, structs: mutable StructTable&) -> ValueType can[Abort.Panic]:
            bound: ValueType = lookup_type(local_scope, name)
            bound return if bound.kind == TypeKind.DArray
            unmodeled_type() return if bound.kind != TypeKind.Ref
            target: ValueType = ref_target_of(bound, structs)
            target return if target.kind == TypeKind.DArray
            return unmodeled_type()


        # The ADDRESS of the darray header named `name`. A local darray IS its slot; a
        # `darray[T]&` parameter's slot holds a POINTER to the CALLER's darray, so it takes
        # one extra load. Every darray operation goes through this so that push/count/index
        # work identically on a local and on a borrowed one.
        def darray_address_of(local_scope: mutable Scope&, name: sview, structs: mutable StructTable&, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic]:
            bound: ValueType = lookup_type(local_scope, name)
            if lookup_slot(local_scope, name) is bound_slot:
                bound_slot return if bound.kind == TypeKind.DArray
                null return if bound.kind != TypeKind.Ref
                null return if ref_target_of(bound, structs).kind != TypeKind.DArray
                return LLVMBuildLoad2(builder, LLVMPointerTypeInContext(ctx, 0), bound_slot, "darray.ref")
            return null


        def ref_target_of(value_type: ValueType, structs: mutable StructTable&) -> ValueType can[Abort.Panic]:
            unmodeled_type() return if value_type.kind != TypeKind.Ref
            return copied_type(structs.ref_targets[value_type.bits.usize()])


        # The element type of a `darray[T]`.
        def darray_element_of(value_type: ValueType, structs: mutable StructTable&) -> ValueType can[Abort.Panic]:
            unmodeled_type() return if value_type.kind != TypeKind.DArray
            return copied_type(structs.darray_elements[value_type.bits.usize()])


        # The size in BYTES of a scalar type — the stride a darray indexes by. Only scalars
        # are modeled as darray elements, so this needs no DataLayout query.
        def scalar_byte_size(value_type: ValueType) -> u64:
            1 return if value_type.kind == TypeKind.Bool
            return (value_type.bits / 8).u64()


        # The element type of an array ValueType.
        def array_element_of(value_type: ValueType, structs: mutable StructTable&) -> ValueType can[Abort.Panic]:
            unmodeled_type() return if value_type.kind != TypeKind.Array
            return copied_type(structs.array_elements[value_type.bits.usize()])


        # The index of const enum `name`, or -1.
        def enum_index_of(structs: mutable StructTable&, name: sview) -> i64 can[Abort.Panic]:
            for index in 0..<structs.enum_names.count |structs, name|:
                index.i64() return if structs.enum_names[index] == name
            return -1


        # The ORDINAL of `variant` in const enum `slot`, or -1. Ordinals are declaration
        # order — that is what stage0 compares against (`icmp eq i8 %c, 0` for the first).
        def enum_ordinal_of(structs: mutable StructTable&, slot: usize, variant: sview) -> i64 can[Abort.Panic]:
            for offset in 0..<structs.enum_variant_count[slot] |structs, slot, variant|:
                offset.i64() return if structs.enum_variants[structs.enum_variant_start[slot] + offset] == variant
            return -1


        # Resolve `Color.Green` -> (backing type, ordinal). Ordinal -1 when it is not a
        # const-enum member.
        def enum_member_ordinal(structs: mutable StructTable&, enum_name: sview, variant: sview) -> i64 can[Abort.Panic]:
            index: i64 = enum_index_of(structs, enum_name)
            -1 return if index < 0
            return enum_ordinal_of(structs, index.usize(), variant)


        # The registry index of struct `name`, or -1.
        def struct_index_of(structs: mutable StructTable&, name: sview) -> i64 can[Abort.Panic]:
            for index in 0..<structs.names.count |structs, name|:
                index.i64() return if structs.names[index] == name
            return -1


        # The position of `field` within struct `struct_index`, or -1. This IS the LLVM
        # element index: fields are emitted in declaration order.
        def field_index_of(structs: mutable StructTable&, struct_index: usize, field: sview) -> i64 can[Abort.Panic]:
            for offset in 0..<structs.field_count[struct_index] |structs, struct_index, field|:
                offset.i64() return if structs.field_names[structs.field_start[struct_index] + offset] == field
            return -1


        # The runtime entry points a darray needs, plus the current function's auto
        # region. Declared once per module and threaded down, because `push` can appear
        # anywhere an expression can.
        #
        # `arena` is the function's AUTO REGION: stage0 gives every function one, zeroed,
        # with strategy 2 (lazy), and `arena_free`s it on every return path. That is the
        # first real piece of Elisa's region model in this backend — container backing
        # lives in a region, not in malloc.
        struct Runtime:
            # `arena` is per-FUNCTION (each gets its own auto region), so it is the one
            # mutable field: the module-level Runtime carries a placeholder that
            # emit_function_body replaces with the function's own region slot.
            arena: mutable LLVMValueRef
            # False when `arena` is the CALLER's, handed over as the implicit trailing
            # parameter. Freeing it then would destroy a region this function does not own
            # and the caller is still using -- so every arena_free is gated on this.
            owns_arena: mutable bool
            arena_alloc: LLVMValueRef
            arena_realloc: LLVMValueRef
            arena_free: LLVMValueRef
            arena_alloc_type: LLVMTypeRef
            arena_realloc_type: LLVMTypeRef
            arena_free_type: LLVMTypeRef
            # `region r(4096):` — a region with an explicit CAPACITY gets its backing up
            # front from the runtime (`call ptr @new_region_backend(i64 4096, i64 0)`)
            # instead of the lazy strategy an auto region uses.
            new_region_backend: LLVMValueRef
            new_region_backend_type: LLVMTypeRef


        # Declare the runtime entry points in the module. Signatures are dictated by
        # elisacore_runtime.o (read from stage0's own emitted IR):
        #   ptr  arena_alloc(ptr arena, i64 bytes)
        #   ptr  arena_realloc(ptr arena, ptr old, i64 old_bytes, i64 new_bytes)
        #   void arena_free(ptr arena)
        def declare_runtime(m: LLVMModuleRef, ctx: LLVMContextRef) -> Runtime can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            pointer_type: LLVMTypeRef = LLVMPointerTypeInContext(ctx, 0)
            int64_type: LLVMTypeRef = LLVMInt64TypeInContext(ctx)

            alloc_params: mutable darray[LLVMTypeRef] = [pointer_type, int64_type]
            alloc_pointer: void& = (&alloc_params[0]).cast[void&] can Unsafe.PointerCast
            alloc_type: LLVMTypeRef = LLVMFunctionType(pointer_type, alloc_pointer, 2, 0)

            realloc_params: mutable darray[LLVMTypeRef] = [pointer_type, pointer_type, int64_type, int64_type]
            realloc_pointer: void& = (&realloc_params[0]).cast[void&] can Unsafe.PointerCast
            realloc_type: LLVMTypeRef = LLVMFunctionType(pointer_type, realloc_pointer, 4, 0)

            free_params: mutable darray[LLVMTypeRef] = [pointer_type]
            free_pointer: void& = (&free_params[0]).cast[void&] can Unsafe.PointerCast
            free_type: LLVMTypeRef = LLVMFunctionType(LLVMVoidTypeInContext(ctx), free_pointer, 1, 0)

            backend_params: mutable darray[LLVMTypeRef] = [LLVMInt64TypeInContext(ctx), LLVMInt64TypeInContext(ctx)]
            backend_pointer: void& = (&backend_params[0]).cast[void&] can Unsafe.PointerCast
            backend_type: LLVMTypeRef = LLVMFunctionType(pointer_type, backend_pointer, 2, 0)

            return Runtime{
                owns_arena: true,
                new_region_backend: LLVMAddFunction(m, "new_region_backend", backend_type),
                new_region_backend_type: backend_type,
                arena_alloc: LLVMAddFunction(m, "arena_alloc", alloc_type),
                arena_realloc: LLVMAddFunction(m, "arena_realloc", realloc_type),
                arena_free: LLVMAddFunction(m, "arena_free", free_type),
                arena_alloc_type: alloc_type,
                arena_realloc_type: realloc_type,
                arena_free_type: free_type,
                # No region until a function supplies its own; a null placeholder keeps
                # the module clean (declaring a dummy function to fill this would emit a
                # bogus symbol).
                arena: LLVMConstNull(pointer_type)
            }


        # Generic function TEMPLATES, and the instantiations made from them.
        #
        # The instantiation cache is keyed by (base name, type argument) — NOT by mangled
        # name. That is deliberate: an `sview` is a view, so a mangled name built into a
        # local buffer would DANGLE the moment the buffer's region died (Elisa's region
        # checker catches exactly this). `base_names` are sviews into the SOURCE buffer,
        # which outlives everything, and ValueType is POD — so nothing here borrows.
        #
        # The mangled name is only ever needed transiently, to hand to LLVMAddFunction,
        # which COPIES it. So it is built in a local buffer, used, and dropped.
        #
        # Generic parameter names come from the FILE-level side table
        # (`generic_param_names` / `generic_param_lines`) keyed by the function's LINE —
        # they are NOT on Decl.Func. A row whose line has the high bit set is a BOUND
        # (`[T: Ord]`): metadata the backend never needs, since it only instantiates types
        # the frontend already accepted.
        struct GenericTable:
            names: mutable darray[sview]
            decls: mutable darray[Decl]
            params: mutable darray[sview]
            param_start: mutable darray[usize]
            param_count: mutable darray[usize]
            # Instantiations, keyed by (base name, type argument).
            inst_bases: mutable darray[sview]
            inst_types: mutable darray[ValueType]
            inst_handles: mutable darray[LLVMValueRef]
            # The WORKLIST: instantiations declared but whose BODY still needs emitting. A
            # body cannot be emitted at the call site (the builder sits inside the caller),
            # so emit_module drains this afterwards — and keeps draining, because a generic
            # can call another generic.
            pending_bases: mutable darray[sview]
            pending_types: mutable darray[ValueType]
            pending_handles: mutable darray[LLVMValueRef]


        def new_generic_table() -> GenericTable can[Abort.Panic, Memory.Allocate]:
            return GenericTable{names: [], decls: [], params: [], param_start: [], param_count: [], inst_bases: [], inst_types: [], inst_handles: [], pending_bases: [], pending_types: [], pending_handles: []}


        # The index of generic template `name`, or -1.
        def generic_index_of(generics: GenericTable&, name: sview) -> i64 can[Abort.Panic]:
            for index in 0..<generics.names.count |generics, name|:
                index.i64() return if generics.names[index] == name
            return -1


        # The already-declared instantiation for (base, type), or null.
        def instantiation_of(generics: GenericTable&, base: sview, type_argument: ValueType) -> LLVMValueRef? can[Abort.Panic]:
            for index in 0..<generics.inst_bases.count |generics, base, type_argument|:
                if generics.inst_bases[index] == base:
                    existing: ValueType = generics.inst_types[index]
                    generics.inst_handles[index] return if existing.kind == type_argument.kind and existing.bits == type_argument.bits
            return null


        # A function's local slots: `names[i]` lives in the `alloca` at `slots[i]`.
        # Parallel darrays rather than a dict: scopes are tiny (a handful of locals), a
        # linear scan beats hashing, and it keeps the opaque extern handle out of a dict's
        # key/value machinery.
        struct Scope:
            names: mutable darray[sview]
            slots: mutable darray[LLVMValueRef]
            types: mutable darray[ValueType]


        # The module's functions by name. Built in emit_module's declare pass, so a call
        # to a function defined LATER in the file still resolves.
        #
        # Kept here rather than asking LLVMGetNamedFunction: that returns NULL-or-pointer,
        # i.e. it needs `-> LLVMValueRef?`, and an extern returning an optional of an
        # opaque extern type always binds null in stage0 (silent, no diagnostic). We
        # already know every function we declared, so this is also just less work.
        struct FnTable:
            names: mutable darray[sview]
            # The enclosing MODULE's name, or "" for a top-level function. Functions are
            # keyed on the (owner, name) PAIR rather than on a mangled "M.get" string:
            # `names` are sviews into the SOURCE buffer, and a synthesized name has no
            # source text to point at — an sview into a growing darray would dangle. The
            # mangled form is built only as a temporary cstr for the LLVM symbol.
            owners: mutable darray[sview]
            # True when the function has an implicit trailing arena parameter (it takes a
            # growable container by reference). The CALL SITE must then pass its own arena.
            needs_arena: mutable darray[bool]
            handles: mutable darray[LLVMValueRef]
            returns: mutable darray[ValueType]
            # Parameter types as a FLAT pool plus a per-function span (`param_start[i]`,
            # `param_count[i]`) — a nested `darray[darray[ValueType]]` would make this
            # region-polymorphic for no benefit.
            param_types: mutable darray[ValueType]
            param_start: mutable darray[usize]
            param_count: mutable darray[usize]


        # The enclosing loops' branch targets, innermost LAST. `break` jumps to
        # `exits[last]`, `continue` to `continues[last]`. A loop pushes before emitting its
        # body and pops after, so a `break` outside any loop finds an empty stack and
        # DECLINES rather than emitting a wild branch.
        #
        # `continue` targets differ per loop form: a `while` continues to its condition
        # block, a `for` to its INCREMENT block (skipping the increment would make
        # `continue` an infinite loop).
        struct LoopStack:
            exits: mutable darray[LLVMBasicBlockRef]
            continues: mutable darray[LLVMBasicBlockRef]


        # The OWNED regions currently live, outermost FIRST. A `return` has to unwind every
        # one of them, not just the innermost: stage0's IR for a return inside `region r:`
        # frees `%r` AND the enclosing function's auto region on that path.
        #
        # Only OWNED regions are listed. A threaded (borrowed) arena belongs to the caller
        # and is never freed here, so an arena-threading function's stack is simply empty.
        struct RegionStack:
            arenas: mutable darray[LLVMValueRef]


        # Free every live owned region, innermost FIRST (reverse declaration order), which is
        # the order stage0 emits them in.
        def emit_region_unwind(regions: RegionStack&, runtime: Runtime&, builder: LLVMBuilderRef) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            index: mutable i64 = regions.arenas.count.i64() - 1
            while index >= 0 |index, regions, runtime, builder|:
                scoped: mutable Runtime = copied_runtime(runtime)
                scoped.arena <- regions.arenas[index.usize()]
                scoped.owns_arena <- true
                emit_region_free(scoped, builder)
                index <- index - 1


        # What emitting a statement did to control flow.
        #
        # `Terminated` means the statement ended the block (a `return`, or an `if` whose
        # arms all returned). The emitter tracks this itself instead of asking
        # LLVMGetBasicBlockTerminator — same optional-extern bug as FnTable — and it is
        # the better design regardless: LLVM rejects a block with two terminators, so the
        # emitter must know whether a block is still open BEFORE it appends a branch.
        const enum EmitStatus of u8:
            Declined
            Open
            Terminated


        # The handle for `owner::name`, or null when there is no such function.
        def lookup_function(fns: FnTable&, owner: sview, name: sview) -> LLVMValueRef? can[Abort.Panic]:
            for index in 0..<fns.names.count |fns, owner, name|:
                fns.handles[index] return if fns.names[index] == name and fns.owners[index] == owner
            return null


        # The index of `name` in the scope, or -1. Scanned back to front so a later
        # (shadowing) declaration wins.
        def lookup_index(local_scope: mutable Scope&, name: sview) -> i64 can[Abort.Panic]:
            index: mutable i64 = local_scope.names.count.i64() - 1
            while index >= 0 |local_scope, name, index|:
                index return if local_scope.names[index.usize()] == name
                index <- index - 1
            return -1


        # The alloca backing `name`, or null when the name is not a local.
        def lookup_slot(local_scope: mutable Scope&, name: sview) -> LLVMValueRef? can[Abort.Panic]:
            index: i64 = lookup_index(local_scope, name)
            null return if index < 0
            return local_scope.slots[index.usize()]


        # The declared type of `name`, or Unmodeled when it is not a local.
        def lookup_type(local_scope: mutable Scope&, name: sview) -> ValueType can[Abort.Panic]:
            index: i64 = lookup_index(local_scope, name)
            unmodeled_type() return if index < 0
            return copied_type(local_scope.types[index.usize()])


        # Record a local: name, slot and declared type, kept index-parallel.
        def declare_local(local_scope: mutable Scope&, name: sview, slot: LLVMValueRef, value_type: ValueType) -> void can[Abort.Panic, Memory.Allocate]:
            local_scope.names <- local_scope.names.push(name)
            local_scope.slots <- local_scope.slots.push(slot)
            local_scope.types <- local_scope.types.push(value_type)


        # The declared type of function `name`'s parameter `position`, or Unmodeled.
        # Emitting each argument at its parameter's type is what makes a literal argument
        # adopt the parameter type instead of defaulting to i64.
        def param_type_of(fns: FnTable&, owner: sview, name: sview, position: usize) -> ValueType can[Abort.Panic]:
            for index in 0..<fns.names.count |fns, owner, name, position|:
                if fns.names[index] == name and fns.owners[index] == owner:
                    unmodeled_type() return if position >= fns.param_count[index]
                    return copied_type(fns.param_types[fns.param_start[index] + position])
            return unmodeled_type()


        # The declared return type of `name`, or Unmodeled when the module has no such
        # function.
        def lookup_return_type(fns: FnTable&, owner: sview, name: sview) -> ValueType can[Abort.Panic]:
            for index in 0..<fns.names.count |fns, owner, name|:
                copied_type(fns.returns[index]) return if fns.names[index] == name and fns.owners[index] == owner
            return unmodeled_type()


        # The type an expression yields, WITHOUT emitting anything.
        #
        # Bottom-up, and deliberately partial: an integer LITERAL has no type of its own
        # (Unmodeled) and adopts whatever its context supplies. That is why the emitters
        # thread an `expected` type downward — `a: u8 = 200` must make 200 a u8, not an
        # i64 that is then silently truncated.
        def expression_type(expression: Expr, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&) -> ValueType can[Abort.Panic]:
            if expression is Expr.Ident(ident_name, ident_line):
                # A LOCAL shadows a global const, so the scope is consulted first.
                local_type: ValueType = lookup_type(local_scope, ident_name)
                local_type return if local_type.kind != TypeKind.Unmodeled
                const_index: i64 = const_index_of(structs, ident_name)
                copied_type(structs.const_types[const_index.usize()]) return if const_index >= 0 and structs.const_resolved[const_index.usize()]
                return unmodeled_type()
            if expression is Expr.Paren(paren_inner, paren_line):
                return expression_type(paren_inner, local_scope, fns, structs, generics)
            if expression is Expr.BoolLit(bool_value):
                return ValueType{kind: TypeKind.Bool, bits: 1}
            # A STRING literal has a type of its own (cstr) — unlike an int literal, which
            # defers to its context. There is no other string type in the subset for it to
            # adopt, and stage0 gives `"hi"` a cstr regardless of context.
            if expression is Expr.StringLit(string_text):
                return ValueType{kind: TypeKind.CStr, bits: 0}
            # A FLOAT literal, like an int literal, defers to its context (`x: f32 = 1.5`),
            # so it reports Unmodeled here rather than pinning itself to f64.
            if expression is Expr.Unary(unary_operator, unary_operand, unary_line):
                # `not x` is a bool whatever `x` is; `-x` / `~x` keep the operand's type.
                ValueType{kind: TypeKind.Bool, bits: 1} return if unary_operator == TokenKind.Not or unary_operator == TokenKind.Bang
                return expression_type(unary_operand, local_scope, fns, structs, generics)
            if expression is Expr.Binary(binary_left, binary_operator, binary_right, binary_line):
                # A comparison, logical, or `is` narrowing yields bool regardless of operands.
                ValueType{kind: TypeKind.Bool, bits: 1} return if binary_operator == TokenKind.Is
                ValueType{kind: TypeKind.Bool, bits: 1} return if int_predicate_of(binary_operator) >= 0
                ValueType{kind: TypeKind.Bool, bits: 1} return if binary_operator == TokenKind.And or binary_operator == TokenKind.Or
                # Arithmetic keeps the operands' type: take whichever side is known, since
                # a literal contributes nothing.
                left_type: ValueType = expression_type(binary_left, local_scope, fns, structs, generics)
                left_type return if left_type.kind != TypeKind.Unmodeled
                return expression_type(binary_right, local_scope, fns, structs, generics)
            # `xs[i]` — an index READ yields the element type of an array OR a darray.
            if expression is Expr.Index(indexed_object, index_expression, index_line):
                indexed_type: ValueType = expression_type(indexed_object, local_scope, fns, structs, generics)
                darray_element_of(indexed_type, structs) return if indexed_type.kind == TypeKind.DArray
                return array_element_of(indexed_type, structs)
            # `p.x` — a field READ has the field's declared type. (A cast `x.u8()` is a
            # Field under a Call, handled below, so a bare Field is always a field read.)
            # `Color.Green` has the enum's BACKING type.
            if expression is Expr.Field(enum_head, enum_member, enum_head_line):
                if enum_head is Expr.Ident(enum_head_name, enum_head_name_line):
                    penum_head_index: i64 = penum_index_of(structs, enum_head_name)
                    ValueType{kind: TypeKind.PayloadEnum, bits: penum_head_index.u32()} return if penum_head_index >= 0
                    enum_slot: i64 = enum_index_of(structs, enum_head_name)
                    if enum_slot >= 0:
                        copied_type(structs.enum_backings[enum_slot.usize()]) return if enum_ordinal_of(structs, enum_slot.usize(), enum_member) >= 0
            if expression is Expr.Field(field_object, field_name, field_line):
                object_type: mutable ValueType = expression_type(field_object, local_scope, fns, structs, generics)
                # AUTO-DEREF: `p.x` where `p: P&` reads P's field. A reference is
                # transparent for member access — the frontend has already decided the
                # access is legal, so the backend just looks through it.
                object_type <- ref_target_of(object_type, structs) if object_type.kind == TypeKind.Ref
                # `xs.count` is a usize-shaped i64.
                ValueType{kind: TypeKind.Signed, bits: 64} return if object_type.kind == TypeKind.DArray and field_name == "count"
                unmodeled_type() return if object_type.kind != TypeKind.Struct
                struct_slot: usize = object_type.bits.usize()
                position: i64 = field_index_of(structs, struct_slot, field_name)
                unmodeled_type() return if position < 0
                return copied_type(structs.field_types[structs.field_start[struct_slot] + position.usize()])
            # `Point{x: 1, y: 2}` — a brace construction has the constructed type.
            if expression is Expr.Construct(construct_type, construct_fields, construct_line):
                return annotation_value_type(construct_type, structs)
            if expression is Expr.Call(call_callee, call_arguments, call_argument_names, call_line):
                # `x.u8()` is a CAST (postfix call unifies cast and UFCS: `recv.Name()`
                # where Name is a type name is a conversion).
                if call_callee is Expr.Field(cast_object, cast_name, cast_line):
                    # `Shape.Circle(42)` is a payload-enum CONSTRUCTOR and has the enum's
                    # type. Checked before the cast/UFCS split: the head is an enum NAME, so
                    # neither of those readings applies.
                    if cast_object is Expr.Ident(ctor_enum_name, ctor_enum_line):
                        ctor_index: i64 = penum_index_of(structs, ctor_enum_name)
                        ValueType{kind: TypeKind.PayloadEnum, bits: ctor_index.u32()} return if ctor_index >= 0
                    # A type name is a CAST and has that type; anything else is UFCS
                    # (`p.get()` == `get(p)`) and has the FUNCTION's return type. Without
                    # the second case a UFCS call reports Unmodeled and every
                    # type-directed check downstream silently stops applying.
                    cast_type: ValueType = scalar_type_of_name(cast_name)
                    cast_type return if cast_type.kind != TypeKind.Unmodeled
                    return lookup_return_type(fns, "", cast_name)
                # `f[i64](x)` — an explicit generic call. Its type is the template's return
                # annotation resolved under that binding, which for `-> T` is the type
                # argument itself.
                if call_callee is Expr.Index(generic_head, generic_type_argument, generic_head_line):
                    if generic_head is Expr.Ident(generic_head_name, generic_head_name_line):
                        if generic_index_of(generics, generic_head_name) >= 0:
                            return generic_return_type(generic_head_name, annotation_value_type(generic_type_argument, structs), generics, structs)
                if call_callee is Expr.Ident(callee_name, callee_line):
                    # A GENERIC template is NOT in `fns` — only its instantiations are —
                    # so it must be resolved through the template. Without this a generic
                    # call reports Unmodeled and every type-directed check downstream
                    # (operand typing, the mixed-width guard) silently stops applying.
                    if generic_index_of(generics, callee_name) >= 0:
                        unmodeled_type() return if call_arguments.count == 0
                        inferred: ValueType = expression_type(call_arguments[0], local_scope, fns, structs, generics)
                        unmodeled_type() return if inferred.kind == TypeKind.Unmodeled
                        return generic_return_type(callee_name, inferred, generics, structs)
                    return lookup_return_type(fns, "", callee_name)
                # A module-qualified call's type is the qualified function's return type.
                if call_callee is Expr.Scope(scope_head, scope_name, scope_line):
                    if scope_head is Expr.Ident(module_name, module_name_line):
                        return lookup_return_type(fns, module_name, scope_name)
            return unmodeled_type()


        # Map an Elisa comparison token to an LLVMIntPredicate, or -1 when the operator is
        # not a comparison. Signed predicates (SLT/SLE/SGT/SGE): the subset is i64.
        def int_predicate_of(operator: TokenKind) -> i32:
            32 return if operator == TokenKind.EqEq
            33 return if operator == TokenKind.BangEq
            40 return if operator == TokenKind.Lt
            41 return if operator == TokenKind.LtEq
            38 return if operator == TokenKind.Gt
            39 return if operator == TokenKind.GtEq
            return -1


        # The same comparison for an UNSIGNED operand type. Equality is signedness-free
        # (32/33); ordering is not — SLT(40)/SLE(41)/SGT(38)/SGE(39) become
        # ULT(36)/ULE(37)/UGT(34)/UGE(35). Comparing `u8 200 < 3` with SLT reads 200 as
        # -56 and answers TRUE.
        def unsigned_predicate_of(predicate: i32) -> i32:
            36 return if predicate == 40
            37 return if predicate == 41
            34 return if predicate == 38
            35 return if predicate == 39
            return predicate


        # Emit `left <op> right` for the modeled signed-i64 operators. `null` = unmodeled,
        # so a bitwise/logical op declines rather than emitting something wrong.
        #
        # A comparison yields an `i1`; every modeled value is an i64, so the i1 is
        # zero-extended back to i64. Conditions re-narrow with `!= 0` (emit_condition),
        # which keeps ONE uniform value representation instead of tracking i1-vs-i64.
        #
        # SDiv/SRem (not UDiv/URem): the subset is signed. Elisa's `%` is LLVM's `srem`
        # (sign follows the DIVIDEND: -7 % 2 == -1) — verified against stage0, which
        # selects the same instruction for a signed operand type.
        # The ORDERED float predicate matching an integer one. Ordered = any comparison
        # with NaN is false, which is IEEE `==` / `<` semantics.
        # OEQ=1, OGT=2, OGE=3, OLT=4, OLE=5, ONE=6.
        def float_predicate_of(operator: TokenKind) -> i32:
            1 return if operator == TokenKind.EqEq
            6 return if operator == TokenKind.BangEq
            4 return if operator == TokenKind.Lt
            5 return if operator == TokenKind.LtEq
            2 return if operator == TokenKind.Gt
            3 return if operator == TokenKind.GtEq
            return -1


        def emit_binary(operator: TokenKind, left: LLVMValueRef, right: LLVMValueRef, operand_type: ValueType, structs: mutable StructTable&, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic]:
            # Floats are a different instruction family end to end: fadd/fdiv/fcmp, never
            # add/sdiv/icmp. Bitwise and shifts have no float form and decline.
            if operand_type.kind == TypeKind.Float:
                LLVMBuildFAdd(builder, left, right, "fadd") return if operator == TokenKind.Plus
                LLVMBuildFSub(builder, left, right, "fsub") return if operator == TokenKind.Minus
                LLVMBuildFMul(builder, left, right, "fmul") return if operator == TokenKind.Star
                LLVMBuildFDiv(builder, left, right, "fdiv") return if operator == TokenKind.Slash
                LLVMBuildFRem(builder, left, right, "frem") return if operator == TokenKind.Percent
                float_predicate: i32 = float_predicate_of(operator)
                LLVMBuildFCmp(builder, float_predicate, left, right, "fcmp") return if float_predicate >= 0
                return null
            unsigned: bool = operand_type.kind == TypeKind.Unsigned
            LLVMBuildAdd(builder, left, right, "add") return if operator == TokenKind.Plus
            LLVMBuildSub(builder, left, right, "sub") return if operator == TokenKind.Minus
            LLVMBuildMul(builder, left, right, "mul") return if operator == TokenKind.Star
            LLVMBuildAnd(builder, left, right, "and") return if operator == TokenKind.Ampersand
            LLVMBuildOr(builder, left, right, "or") return if operator == TokenKind.Pipe
            LLVMBuildXor(builder, left, right, "xor") return if operator == TokenKind.Caret
            LLVMBuildShl(builder, left, right, "shl") return if operator == TokenKind.LShift

            # Signedness picks the INSTRUCTION, and it is observable: stage0 gives
            # `u8 200 / 3` == 66 (udiv) and `u8 200 >> 1` == 100 (lshr); the signed forms
            # answer -56 and 228.
            if operator == TokenKind.Slash:
                return LLVMBuildUDiv(builder, left, right, "div") if unsigned else LLVMBuildSDiv(builder, left, right, "div")
            if operator == TokenKind.Percent:
                return LLVMBuildURem(builder, left, right, "rem") if unsigned else LLVMBuildSRem(builder, left, right, "rem")
            if operator == TokenKind.RShift:
                return LLVMBuildLShr(builder, left, right, "shr") if unsigned else LLVMBuildAShr(builder, left, right, "shr")

            predicate: i32 = int_predicate_of(operator)
            if predicate >= 0:
                resolved: i32 = unsigned_predicate_of(predicate) if unsigned else predicate
                # A comparison yields an i1 — the modeled `bool` — NOT a widened int.
                return LLVMBuildICmp(builder, resolved, left, right, "cmp")
            return null


        # Parse an integer pattern's literal TEXT (`Pattern.Literal` carries raw source
        # text, not a value). False when it is not a plain decimal integer, so a
        # char/string/float pattern DECLINES instead of being misread as a number.
        def parse_int_literal(text: sview, out_value: mutable i64&) -> bool can[Abort.Panic]:
            false return if sview_len(text) == 0
            negative: bool = sview_at(text, 0) == 45
            start: usize = 1 if negative else 0
            false return if sview_len(text) == start
            accumulated: mutable i64 = 0
            ok: mutable bool = true
            for index in start..<sview_len(text) |accumulated, ok, text|:
                byte: u8 = sview_at(text, index)
                if byte < 48 or byte > 57:
                    ok <- false
                else:
                    accumulated <- accumulated * 10 + (byte.i64() - 48)
            false return if not ok
            out_value <- 0 - accumulated if negative else accumulated
            return true


        # `Color.Red` -> its ordinal, or -1 if the path is not a const-enum member.
        # `Shape.Circle` -> the variant's TAG, or -1. Same byte-comparison approach as
        # ordinal_of_dotted_path, against the payload-enum pools.
        def penum_variant_index_of_path(path: sview, structs: mutable StructTable&) -> i64 can[Abort.Panic]:
            dot: mutable i64 = -1
            for index in 0..<sview_len(path) |dot, path|:
                dot <- index.i64() if sview_at(path, index) == 46
            -1 return if dot <= 0
            for enum_index in 0..<structs.penum_names.count |structs, path, dot|:
                continue if not sview_matches_prefix(path, structs.penum_names[enum_index], 0, dot)
                for offset in 0..<structs.penum_variant_count[enum_index] |structs, path, dot, enum_index|:
                    variant: sview = structs.penum_variants[structs.penum_variant_start[enum_index] + offset]
                    offset.i64() return if sview_matches_prefix(path, variant, dot + 1, sview_len(path).i64())
            return -1


        # `Shape.Circle` -> its payload's ValueType, or Unmodeled when the path names no
        # payload-carrying variant.
        def penum_payload_of_path(path: sview, structs: mutable StructTable&) -> ValueType can[Abort.Panic]:
            dot: mutable i64 = -1
            for index in 0..<sview_len(path) |dot, path|:
                dot <- index.i64() if sview_at(path, index) == 46
            unmodeled_type() return if dot <= 0
            for enum_index in 0..<structs.penum_names.count |structs, path, dot|:
                continue if not sview_matches_prefix(path, structs.penum_names[enum_index], 0, dot)
                for offset in 0..<structs.penum_variant_count[enum_index] |structs, path, dot, enum_index|:
                    slot: usize = structs.penum_variant_start[enum_index] + offset
                    continue if not sview_matches_prefix(path, structs.penum_variants[slot], dot + 1, sview_len(path).i64())
                    unmodeled_type() return if not structs.penum_has_payload[slot]
                    return copied_type(structs.penum_payloads[slot])
            return unmodeled_type()


        # `Shape.Circle` -> the enclosing enum's ValueType, or Unmodeled.
        def penum_type_of_path(path: sview, structs: mutable StructTable&) -> ValueType can[Abort.Panic]:
            dot: mutable i64 = -1
            for index in 0..<sview_len(path) |dot, path|:
                dot <- index.i64() if sview_at(path, index) == 46
            unmodeled_type() return if dot <= 0
            for enum_index in 0..<structs.penum_names.count |structs, path, dot|:
                ValueType{kind: TypeKind.PayloadEnum, bits: enum_index.u32()} return if sview_matches_prefix(path, structs.penum_names[enum_index], 0, dot)
            return unmodeled_type()


        # Pattern.Variant carries the path as one dotted STRING, so it is split here.
        def ordinal_of_dotted_path(path: sview, structs: mutable StructTable&) -> i64 can[Abort.Panic]:
            dot: mutable i64 = -1
            for index in 0..<sview_len(path) |dot, path|:
                dot <- index.i64() if sview_at(path, index) == 46
            -1 return if dot <= 0
            # Match by comparing BYTES against each registered enum/variant rather than
            # slicing `path` into two sviews: `&path[0]` is a `char&`, not the `u8&?` that
            # `sview(...)` wants, and a view-into-a-view buys nothing here.
            for enum_index in 0..<structs.enum_names.count |structs, path, dot|:
                continue if not sview_matches_prefix(path, structs.enum_names[enum_index], 0, dot)
                for offset in 0..<structs.enum_variant_count[enum_index] |structs, path, dot, enum_index|:
                    variant: sview = structs.enum_variants[structs.enum_variant_start[enum_index] + offset]
                    offset.i64() return if sview_matches_prefix(path, variant, dot + 1, sview_len(path).i64())
            return -1


        # Whether `path[start..end)` equals `candidate`, byte for byte.
        def sview_matches_prefix(path: sview, candidate: sview, start: i64, end: i64) -> bool can[Abort.Panic]:
            false return if (end - start) != sview_len(candidate).i64()
            matched: mutable bool = true
            for index in 0..<sview_len(candidate) |matched, path, candidate, start|:
                matched <- false if sview_at(path, (start + index.i64()).usize()) != sview_at(candidate, index)
            return matched


        # Whether a pattern matches anything. ONLY `_` does: a BINDING arm is not legal in
        # an integer match — stage0 rejects `other: other + 2` with "top-level integer
        # match arm must use an integer literal or _" (and then "undefined identifier
        # other"). Treating a binding as a catch-all made stage1 emit code for a program
        # the language rejects; caught by the stage0 differential.
        #
        # Written as a `match`, NOT `pattern is Pattern.Wildcard`: `is` on a PAYLOAD-LESS
        # packed-enum variant crashes stage0's backend with "unsupported expression
        # *ast.TypeExprExpr" (the bare `Pattern.Wildcard` parses as a type path). `is` WITH
        # a payload and `match` both work — filed with a 12-line repro. Keep this a match
        # until that lands.
        def is_catch_all_pattern(pattern: Pattern) -> bool can[Abort.Panic]:
            return match pattern:
                Pattern.Wildcard: true
                _: false


        # Whether an arm carries a guard (`0 if n > 1:`). A guard is a second per-arm
        # condition and is NOT modeled, so a guarded arm must DECLINE: ignoring it emits
        # the arm unconditionally, which is a silent miscompile (observed — stage1 gave
        # 100 where stage0 gives 42).
        #
        # A `match`, not `guard is Expr.Absent`, for the same payload-less-variant ICE.
        def arm_has_guard(guard: Expr) -> bool can[Abort.Panic]:
            return match guard:
                Expr.Absent: false
                _: true



        # The single value an arm body yields, for a value `match`. Only a one-expression
        # body is modeled (`0: 100`).
        #
        # Returns `Expr?` rather than filling a `mutable Expr&` out-param: an out-param
        # needs a placeholder to initialize (`Expr.Invalid`), and CONSTRUCTING a
        # packed-enum node requires an active `in Ast.Expr.Store:` scope the backend does
        # not have — it only ever READS the AST. Returning the existing handle constructs
        # nothing.
        def arm_value_expression(body: darray[Stmt]&) -> Expr? can[Abort.Panic]:
            null return if body.count != 1
            if body[0] is Stmt.Expr(arm_expression, arm_expression_line):
                return arm_expression
            return null


        # Close a `match` that has no `_` arm. Nothing matching means the frontend's
        # exhaustiveness proof was wrong, so `unreachable` is the honest terminator —
        # inventing a default value would hide the gap. A guard helper, not a ternary: a
        # VOID ternary ICEs stage0 (`%termp = phi void`).
        def terminate_if_no_default(saw_default: bool, builder: LLVMBuilderRef) -> void can[Abort.Panic]:
            return if saw_default
            _ = LLVMBuildUnreachable(builder)


        # The binary operator a compound assignment applies (`+=` -> `+`), or `Eof` when
        # the token is not a compound assignment. (TokenKind has no Invalid; `Eof` can
        # never appear as a real operator, so it is the natural sentinel.) Keeps the
        # lowering honest: `x op= v` is exactly `x <- x op v`, so it reuses emit_binary
        # instead of re-deriving each operator.
        def compound_operator_of(operator: TokenKind) -> TokenKind:
            TokenKind.Plus return if operator == TokenKind.PlusEq
            TokenKind.Minus return if operator == TokenKind.MinusEq
            TokenKind.Star return if operator == TokenKind.StarEq
            TokenKind.Slash return if operator == TokenKind.SlashEq
            TokenKind.Percent return if operator == TokenKind.PercentEq
            TokenKind.Ampersand return if operator == TokenKind.AmpEq
            TokenKind.Pipe return if operator == TokenKind.PipeEq
            TokenKind.Caret return if operator == TokenKind.CaretEq
            TokenKind.LShift return if operator == TokenKind.LShiftEq
            TokenKind.RShift return if operator == TokenKind.RShiftEq
            return TokenKind.Eof


        # `left and right` / `left or right`, SHORT-CIRCUITING. Yields a modeled `bool`
        # (i1), like every other comparison.
        #
        # Lowered through a result SLOT rather than a phi: `right` may itself append
        # blocks, so the join's predecessor is not necessarily `rhs_block` and a phi would
        # need incoming-block bookkeeping. mem2reg restores the phi at -O2.
        #
        #   result = <short-circuit answer>   ; `and` -> false, `or` -> true
        #   br left ? rhs : done              ; `or` swaps the targets
        #   rhs:  result = right; br done
        #   done: load result
        def emit_short_circuit(left_expression: Expr, operator: TokenKind, right_expression: Expr, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            bool_type: LLVMTypeRef = LLVMInt1TypeInContext(ctx)
            is_and: bool = operator == TokenKind.And

            result_slot: LLVMValueRef = LLVMBuildAlloca(builder, bool_type, "sc.result")
            if emit_condition(left_expression, local_scope, fns, structs, generics, runtime, m, ctx, builder) is left_bit:
                # `false and _` is false; `true or _` is true.
                short_value: LLVMValueRef = LLVMConstInt(bool_type, 0, 0) if is_and else LLVMConstInt(bool_type, 1, 0)
                _ = LLVMBuildStore(builder, short_value, result_slot)

                function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                rhs_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "sc.rhs")
                done_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "sc.done")
                # `and` runs the right side only when the left is TRUE; `or` only when FALSE.
                if is_and:
                    _ = LLVMBuildCondBr(builder, left_bit, rhs_block, done_block)
                else:
                    _ = LLVMBuildCondBr(builder, left_bit, done_block, rhs_block)

                LLVMPositionBuilderAtEnd(builder, rhs_block)
                if emit_condition(right_expression, local_scope, fns, structs, generics, runtime, m, ctx, builder) is right_bit:
                    _ = LLVMBuildStore(builder, right_bit, result_slot)
                    _ = LLVMBuildBr(builder, done_block)
                    LLVMPositionBuilderAtEnd(builder, done_block)
                    return LLVMBuildLoad2(builder, bool_type, result_slot, "sc")
            return null


        # Declare an instantiation of a generic template, and queue its body.
        #
        # The SIGNATURE is built here — cheap, needs no builder, and yields the handle the
        # call site needs immediately. The BODY is queued because emitting it needs the
        # builder, which is currently positioned inside the caller.
        def instantiate_generic(base: sview, type_argument: ValueType, generics: mutable GenericTable&, structs: mutable StructTable&, m: LLVMModuleRef, ctx: LLVMContextRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            if instantiation_of(generics, base, type_argument) is already_declared:
                return already_declared

            index: i64 = generic_index_of(generics, base)
            null return if index < 0
            slot: usize = index.usize()
            # Only ONE type parameter is modeled; more needs per-parameter inference.
            null return if generics.param_count[slot] != 1

            if generics.decls[slot] is Decl.Func(function_name, params, return_type_opt, body, effects, decorators, line):
                if return_type_opt is return_type:
                    # Bind T for the duration of resolving this signature.
                    structs.binding_names <- structs.binding_names.push(generics.params[generics.param_start[slot]])
                    structs.binding_types <- structs.binding_types.push(copied_type(type_argument))

                    return_value_type: ValueType = annotation_value_type(return_type, structs)
                    llvm_params: mutable darray[LLVMTypeRef] = []
                    declined: mutable bool = false
                    for parameter in params |llvm_params, declined, structs, ctx|:
                        parameter_type: ValueType = annotation_value_type(parameter.type_expression, structs)
                        if parameter_type.kind == TypeKind.Unmodeled:
                            declined <- true
                        else:
                            llvm_params.push(llvm_type_of(parameter_type, structs, ctx))

                    _ = structs.binding_names.pop()
                    _ = structs.binding_types.pop()
                    null return if declined or return_value_type.kind == TypeKind.Unmodeled

                    name_storage: mutable darray[u8] = []
                    mangled: cstr = mangled_name_into(base, type_argument, name_storage)
                    llvm_return: LLVMTypeRef = llvm_type_of(return_value_type, structs, ctx)
                    fn_type: mutable LLVMTypeRef = LLVMFunctionType(llvm_return, null, 0, 0)
                    if params.count != 0:
                        params_pointer: void& = (&llvm_params[0]).cast[void&] can Unsafe.PointerCast
                        fn_type <- LLVMFunctionType(llvm_return, params_pointer, params.count.u32(), 0)
                    handle: LLVMValueRef = LLVMAddFunction(m, mangled, fn_type)

                    generics.inst_bases <- generics.inst_bases.push(base)
                    generics.inst_types <- generics.inst_types.push(copied_type(type_argument))
                    generics.inst_handles <- generics.inst_handles.push(handle)
                    generics.pending_bases <- generics.pending_bases.push(base)
                    generics.pending_types <- generics.pending_types.push(copied_type(type_argument))
                    generics.pending_handles <- generics.pending_handles.push(handle)
                    return handle
            return null


        # The declared type of instantiation (base, type)'s parameter `position`, resolved
        # through the template's bindings.
        def instantiation_param_type(base: sview, type_argument: ValueType, position: usize, generics: mutable GenericTable&, structs: mutable StructTable&) -> ValueType can[Abort.Panic, Memory.Allocate]:
            index: i64 = generic_index_of(generics, base)
            unmodeled_type() return if index < 0
            slot: usize = index.usize()
            if generics.decls[slot] is Decl.Func(function_name, params, return_type_opt, body, effects, decorators, line):
                unmodeled_type() return if position >= params.count
                structs.binding_names <- structs.binding_names.push(generics.params[generics.param_start[slot]])
                structs.binding_types <- structs.binding_types.push(copied_type(type_argument))
                resolved: ValueType = annotation_value_type(params[position].type_expression, structs)
                # POP — never `<- []`. Assigning a fresh `[]` here does NOT clear the
                # caller's darray: it REBINDS the caller's field to a new empty darray
                # allocated in THIS callee's auto region, which is freed on return, so every
                # later access follows freed memory. It also wiped any OUTER instantiation's
                # bindings. That was the nested-generic crash (SIGTRAP from a bounds check
                # against a garbage count). The empty literal is allocated where you are
                # STANDING, not where the field lives.
                _ = structs.binding_names.pop()
                _ = structs.binding_types.pop()
                return resolved
            return unmodeled_type()


        # The IR name for a call's result. A VOID call must be UNNAMED — LLVM rejects
        # "instructions returning void cannot have a name".
        def call_result_name(return_type: ValueType) -> cstr:
            return "" if return_type.kind == TypeKind.Void else "call"


        # Emit a call to a generic function, instantiating on first use.
        def emit_generic_call(base: sview, type_argument: ValueType, arguments: darray[Expr]&, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            if instantiate_generic(base, type_argument, generics, structs, m, ctx) is target:
                argument_values: mutable darray[LLVMValueRef] = []
                declined: mutable bool = false
                argument_index: mutable usize = 0
                for argument in arguments |argument_values, declined, argument_index, base, type_argument, local_scope, fns, structs, generics, runtime, m, ctx, builder|:
                    # Each argument is emitted at its PARAMETER's type, resolved through the
                    # instantiation's bindings — so a literal argument to `f[u8]` becomes a
                    # u8, not an i64.
                    wanted: ValueType = instantiation_param_type(base, type_argument, argument_index, generics, structs)
                    if emit_expression(argument, wanted, local_scope, fns, structs, generics, runtime, m, ctx, builder) is emitted_argument:
                        argument_values.push(emitted_argument)
                    else:
                        declined <- true
                    argument_index <- argument_index + 1
                null return if declined
                fn_type: LLVMTypeRef = LLVMGlobalGetValueType(target)
                # A VOID call must be unnamed: "instructions returning void cannot have a name".
                gresult_name: cstr = call_result_name(generic_return_type(base, type_argument, generics, structs))
                LLVMBuildCall2(builder, fn_type, target, null, 0, gresult_name) return if arguments.count == 0
                args_pointer: void& = (&argument_values[0]).cast[void&] can Unsafe.PointerCast
                return LLVMBuildCall2(builder, fn_type, target, args_pointer, arguments.count.u32(), gresult_name)
            return null


        # Emit a call `f(args…)`. Only a direct call to a named, already-declared function
        # is modeled: the callee must exist in the module (emit_module declares every
        # function before emitting any body, so definition order does not matter) and the
        # arity must match.
        def emit_call(callee: Expr, arguments: darray[Expr]&, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            # `f[i64](x)` — an EXPLICIT type argument makes the callee an Index, not an
            # Ident; the bracket holds a TYPE, so it resolves as an annotation.
            if callee is Expr.Index(generic_callee, generic_argument, generic_call_line):
                if generic_callee is Expr.Ident(explicit_name, explicit_name_line):
                    explicit_type: ValueType = annotation_value_type(generic_argument, structs)
                    null return if explicit_type.kind == TypeKind.Unmodeled
                    null return if generic_index_of(generics, explicit_name) < 0
                    return emit_generic_call(explicit_name, explicit_type, arguments, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                return null
            if callee is Expr.Ident(callee_name, callee_line):
                # A GENERIC callee with an INFERRED type argument: `identity(42)`. The first
                # argument's own type supplies it — enough for the single-type-parameter
                # subset. A bare literal argument has no type of its own, so `identity(42)`
                # with no other information declines rather than guessing i64.
                if generic_index_of(generics, callee_name) >= 0:
                    null return if arguments.count == 0
                    inferred: ValueType = expression_type(arguments[0], local_scope, fns, structs, generics)
                    null return if inferred.kind == TypeKind.Unmodeled
                    return emit_generic_call(callee_name, inferred, arguments, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                return emit_direct_call("", callee_name, callee, false, arguments, local_scope, fns, structs, generics, runtime, m, ctx, builder)
            # `Shape.Circle(42)` — a payload-enum CONSTRUCTOR. stage0 emits: alloca, store
            # zeroinitializer, store the tag at field 0, store the payload at field 1, load
            # the value. Only ONE payload argument is modeled, matching what
            # register_payload_enum accepts.
            if callee is Expr.Field(ctor_head, ctor_variant, ctor_line):
                if ctor_head is Expr.Ident(ctor_enum_name, ctor_enum_line):
                    ctor_enum_index: i64 = penum_index_of(structs, ctor_enum_name)
                    if ctor_enum_index >= 0:
                        ctor_tag: i64 = penum_variant_index(structs, ctor_enum_index, ctor_variant)
                        null return if ctor_tag < 0
                        null return if arguments.count != 1
                        ctor_type: ValueType = ValueType{kind: TypeKind.PayloadEnum, bits: ctor_enum_index.u32()}
                        ctor_payload_type: ValueType = copied_type(structs.penum_payloads[structs.penum_variant_start[ctor_enum_index.usize()] + ctor_tag.usize()])
                        null return if ctor_payload_type.kind == TypeKind.Unmodeled
                        ctor_llvm: LLVMTypeRef = llvm_type_of(ctor_type, structs, ctx)
                        ctor_slot: LLVMValueRef = LLVMBuildAlloca(builder, ctor_llvm, "enum.ctor")
                        _ = LLVMBuildStore(builder, LLVMConstNull(ctor_llvm), ctor_slot)
                        ctor_tag_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, ctor_llvm, ctor_slot, 0, "enum.tag.ptr")
                        _ = LLVMBuildStore(builder, LLVMConstInt(LLVMInt32TypeInContext(ctx), ctor_tag.u64(), 0), ctor_tag_pointer)
                        if emit_expression(arguments[0], ctor_payload_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is ctor_payload_value:
                            ctor_payload_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, ctor_llvm, ctor_slot, 1, "enum.payload.ptr")
                            _ = LLVMBuildStore(builder, ctor_payload_value, ctor_payload_pointer)
                            return LLVMBuildLoad2(builder, ctor_llvm, ctor_slot, "enum.value")
                        return null

            # UFCS: `p.get(a)` IS `get(p, a)`. A postfix call unifies casts and UFCS —
            # `recv.Name()` where Name is a TYPE name is a conversion (handled on the cast
            # path), and where Name is a FUNCTION it is an ordinary call with the receiver
            # as the leading argument. Only the latter is resolved here; a name that is
            # neither declines rather than inventing a call.
            if callee is Expr.Field(receiver, method_name, method_line):
                method_as_type: ValueType = scalar_type_of_name(method_name)
                null return if method_as_type.kind != TypeKind.Unmodeled
                ufcs_target_opt: LLVMValueRef? = lookup_function(fns, "", method_name)
                if ufcs_target_opt is ufcs_target:
                    return emit_direct_call("", method_name, receiver, true, arguments, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                return null
            # `M::get(a)` — a MODULE-qualified call. `::` parses to Expr.Scope, a node kind
            # distinct from Expr.Field, so a qualified call is never confused with UFCS.
            # Only a single level is modeled: `A::B::get` nests Scope inside Scope, whose
            # head is not an Ident, so it declines rather than mangling a wrong symbol.
            if callee is Expr.Scope(scope_head, scope_name, scope_line):
                if scope_head is Expr.Ident(module_name, module_name_line):
                    return emit_direct_call(module_name, scope_name, callee, false, arguments, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                return null
            return null


        # Emit a call to a NON-generic function by name. UFCS passes its receiver as a
        # SEPARATE leading argument rather than prepending it to a list: building a local
        # `darray[Expr]` of receiver-then-arguments CRASHES stage0 (SIGTRAP inside cgo —
        # bisected to the darray construction itself, a darray of packed-enum node handles
        # built in this function). Threading the receiver is the only spelling that
        # compiles, not a style preference. `receiver` is ignored when `has_receiver` is
        # false; callers pass the callee node itself rather than synthesize a dummy.
        def emit_direct_call(callee_owner: sview, callee_name: sview, receiver: Expr, has_receiver: bool, arguments: darray[Expr]&, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            target_opt: LLVMValueRef? = lookup_function(fns, callee_owner, callee_name)
            if target_opt is target:
                total_arguments: usize = arguments.count + 1 if has_receiver else arguments.count
                # LLVMCountParams counts the implicit trailing ARENA too, so the arity check
                # must expect it — otherwise every call to an arena-threading function
                # declines on a spurious mismatch.
                wants_arena: bool = callee_needs_arena(fns, callee_owner, callee_name)
                expected_params: usize = total_arguments + 1 if wants_arena else total_arguments
                null return if LLVMCountParams(target).i64() != expected_params.i64()

                argument_values: mutable darray[LLVMValueRef] = []
                declined: mutable bool = false
                argument_index: mutable usize = 0
                if has_receiver:
                    receiver_value: LLVMValueRef? = emit_expression(receiver, param_type_of(fns, callee_owner, callee_name, 0), local_scope, fns, structs, generics, runtime, m, ctx, builder)
                    if receiver_value is emitted_receiver:
                        argument_values.push(emitted_receiver)
                    else:
                        declined <- true
                    argument_index <- 1
                for argument in arguments |argument_values, declined, argument_index, target, local_scope, fns, structs, generics, runtime, m, ctx, builder|:
                    # Each argument is emitted at its PARAMETER's declared type, so a
                    # literal argument adopts the parameter type rather than i64.
                    argument_value: LLVMValueRef? = emit_expression(argument, param_type_of(fns, callee_owner, callee_name, argument_index), local_scope, fns, structs, generics, runtime, m, ctx, builder)
                    if argument_value is emitted_argument:
                        argument_values.push(emitted_argument)
                    else:
                        declined <- true
                    argument_index <- argument_index + 1
                null return if declined

                # LLVMBuildCall2 needs the callee's FUNCTION type, not its pointer
                # type: LLVM pointers are opaque, so the type cannot be recovered from
                # the value itself.
                fn_type: LLVMTypeRef = LLVMGlobalGetValueType(target)
                # A VOID call must be unnamed: "instructions returning void cannot have a name".
                result_name: cstr = call_result_name(lookup_return_type(fns, callee_owner, callee_name))
                # Hand the callee OUR region when its signature threads one: the container
                # it grows is ours, so its backing must come from a region that outlives
                # the call.
                if wants_arena:
                    argument_values.push(runtime.arena)
                    arena_pointer: void& = (&argument_values[0]).cast[void&] can Unsafe.PointerCast
                    return LLVMBuildCall2(builder, fn_type, target, arena_pointer, (total_arguments + 1).u32(), result_name)
                LLVMBuildCall2(builder, fn_type, target, null, 0, result_name) return if total_arguments == 0
                args_pointer: void& = (&argument_values[0]).cast[void&] can Unsafe.PointerCast
                return LLVMBuildCall2(builder, fn_type, target, args_pointer, total_arguments.u32(), result_name)
            return null


        # The type a value will actually have: its own if known, else the context's.
        # An integer literal has no intrinsic type, so `expected` is what makes
        # `a: u8 = 200` a u8 rather than an i64 that is then truncated behind your back.
        def resolve_type(expression: Expr, expected: ValueType, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&) -> ValueType can[Abort.Panic]:
            own: ValueType = expression_type(expression, local_scope, fns, structs, generics)
            own return if own.kind != TypeKind.Unmodeled
            return expected


        # Convert `value` from `from_type` to `to_type`. Widening sign-extends a signed
        # source and zero-extends an unsigned one (that IS the difference between
        # `u8 200 -> i64 200` and `i8 200 -> i64 -56`); narrowing truncates. Same width is
        # a no-op — a signed/unsigned reinterpretation costs no instruction.
        def emit_conversion(value: LLVMValueRef, from_type: ValueType, to_type: ValueType, structs: mutable StructTable&, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic]:
            null return if from_type.kind == TypeKind.Unmodeled or to_type.kind == TypeKind.Unmodeled
            target: LLVMTypeRef = llvm_type_of(to_type, structs, ctx)
            # bool <-> int needs an explicit widening decision; only int<->int, float, and
            # the identity are modeled.
            if from_type.kind == TypeKind.Bool or to_type.kind == TypeKind.Bool:
                value return if from_type.kind == to_type.kind
                return null

            # float -> int TRUNCATES toward zero (`7.5.i64()` is 7, and `(-7.5).i64()` is
            # -7), which is what FPToSI does — verified against stage0.
            if from_type.kind == TypeKind.Float and to_type.kind != TypeKind.Float:
                return LLVMBuildFPToSI(builder, value, target, "fptosi") if to_type.kind == TypeKind.Signed else LLVMBuildFPToUI(builder, value, target, "fptoui")
            # int -> float follows the SOURCE's signedness: u8 200 becomes 200.0, i8 -56
            # becomes -56.0.
            if to_type.kind == TypeKind.Float and from_type.kind != TypeKind.Float:
                return LLVMBuildSIToFP(builder, value, target, "sitofp") if from_type.kind == TypeKind.Signed else LLVMBuildUIToFP(builder, value, target, "uitofp")
            if from_type.kind == TypeKind.Float and to_type.kind == TypeKind.Float:
                value return if from_type.bits == to_type.bits
                return LLVMBuildFPTrunc(builder, value, target, "fptrunc") if to_type.bits < from_type.bits else LLVMBuildFPExt(builder, value, target, "fpext")

            value return if from_type.bits == to_type.bits
            LLVMBuildTrunc(builder, value, target, "trunc") return if to_type.bits < from_type.bits
            return LLVMBuildSExt(builder, value, target, "sext") if from_type.kind == TypeKind.Signed else LLVMBuildZExt(builder, value, target, "zext")


        # The ADDRESS of `xs[i]` for a DARRAY.
        #
        # ONE index, not two: `items` is already a `T*`, so there is no leading 0 to step
        # over the way a fixed array's pointer-to-array needs.
        def emit_darray_index_address(array_slot: LLVMValueRef, array_type: ValueType, index_expression: Expr, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            null return if array_type.kind != TypeKind.DArray
            element_type: ValueType = darray_element_of(array_type, structs)
            null return if element_type.kind == TypeKind.Unmodeled
            index_type: ValueType = ValueType{kind: TypeKind.Signed, bits: 64}
            if emit_expression(index_expression, index_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is index_value:
                items_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, darray_llvm_type(structs, ctx), array_slot, 0, "darray.items.ptr")
                items: LLVMValueRef = LLVMBuildLoad2(builder, LLVMPointerTypeInContext(ctx, 0), items_pointer, "darray.items")
                indices: mutable darray[LLVMValueRef] = [index_value]
                indices_pointer: void& = (&indices[0]).cast[void&] can Unsafe.PointerCast
                return LLVMBuildGEP2(builder, llvm_type_of(element_type, structs, ctx), items, indices_pointer, 1, "darray.elem.ptr")
            return null


        # The ADDRESS of `xs[i]`.
        #
        # A two-index GEP: the first index (always 0) steps over the array POINTER itself,
        # the second selects the element — the classic C-array shape. StructGEP cannot be
        # used because the index is dynamic.
        #
        # NO BOUNDS CHECK: the subset does not model one. That matches `-emit obj` without
        # -fbounds-check, which is what the differential compares against; a checked build
        # is a separate feature, not a silent default.
        def emit_index_address(array_slot: LLVMValueRef, array_type: ValueType, index_expression: Expr, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            null return if array_type.kind != TypeKind.Array
            index_type: ValueType = ValueType{kind: TypeKind.Signed, bits: 64}
            if emit_expression(index_expression, index_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is index_value:
                indices: mutable darray[LLVMValueRef] = [LLVMConstInt(LLVMInt64TypeInContext(ctx), 0, 0), index_value]
                indices_pointer: void& = (&indices[0]).cast[void&] can Unsafe.PointerCast
                return LLVMBuildGEP2(builder, llvm_type_of(array_type, structs, ctx), array_slot, indices_pointer, 2, "elem.ptr")
            return null


        # Copy a Runtime out of a reference (same borrow rule as copied_type).
        def copied_runtime(runtime: Runtime&) -> Runtime:
            return Runtime{
                owns_arena: runtime.owns_arena,
                new_region_backend: runtime.new_region_backend,
                new_region_backend_type: runtime.new_region_backend_type,
                arena_alloc: runtime.arena_alloc,
                arena_realloc: runtime.arena_realloc,
                arena_free: runtime.arena_free,
                arena_alloc_type: runtime.arena_alloc_type,
                arena_realloc_type: runtime.arena_realloc_type,
                arena_free_type: runtime.arena_free_type,
                arena: runtime.arena
            }


        # `arena_free(region)` — release the function's auto region. Idempotent in the
        # runtime and a no-op for a region that never allocated (strategy 2 is lazy), so
        # emitting it unconditionally on every return path is correct and cheap.
        def emit_region_free(runtime: Runtime&, builder: LLVMBuilderRef) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            # A BORROWED region (the caller's, threaded in) is not ours to free.
            return if not runtime.owns_arena
            arguments: mutable darray[LLVMValueRef] = [runtime.arena]
            arguments_pointer: void& = (&arguments[0]).cast[void&] can Unsafe.PointerCast
            _ = LLVMBuildCall2(builder, runtime.arena_free_type, runtime.arena_free, arguments_pointer, 1, "")


        # `xs.push(v)` — grow-if-needed, store, bump count.
        #
        # Mirrors stage0's lowering, read out of its own `-emit llvm` output:
        #
        #   count = xs.count; needed = count + 1
        #   if xs.capacity < needed:
        #       new_cap = capacity == 0 ? 256 : max(capacity * 2, needed)
        #       items = xs.items == null ? arena_alloc(arena, new_bytes)
        #                                : arena_realloc(arena, items, old_bytes, new_bytes)
        #       xs.items = items; xs.capacity = new_cap
        #   xs.items[count] = v; xs.count = needed
        #
        # The 256 initial capacity is stage0's, not a guess. Overflow TRAPS are omitted:
        # they only abort on a capacity that cannot occur in a modeled program, so their
        # absence is unobservable in the differential — but it does mean this lowering is
        # not a bit-for-bit clone, only a behavioural one.
        def emit_darray_push(array_slot: LLVMValueRef, array_type: ValueType, value_expression: Expr, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            element_type: ValueType = darray_element_of(array_type, structs)
            false return if element_type.kind == TypeKind.Unmodeled
            int64_type: LLVMTypeRef = LLVMInt64TypeInContext(ctx)
            header: LLVMTypeRef = darray_llvm_type(structs, ctx)
            stride: LLVMValueRef = LLVMConstInt(int64_type, scalar_byte_size(element_type), 0)

            items_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, header, array_slot, 0, "darray.items.ptr")
            count_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, header, array_slot, 1, "darray.count.ptr")
            capacity_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, header, array_slot, 2, "darray.cap.ptr")

            count: LLVMValueRef = LLVMBuildLoad2(builder, int64_type, count_pointer, "push.count")
            needed: LLVMValueRef = LLVMBuildAdd(builder, count, LLVMConstInt(int64_type, 1, 0), "push.needed")
            capacity: LLVMValueRef = LLVMBuildLoad2(builder, int64_type, capacity_pointer, "push.cap")

            function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
            grow_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "push.grow")
            store_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "push.store")
            # 35 = UGE: capacities are unsigned.
            enough: LLVMValueRef = LLVMBuildICmp(builder, 35, capacity, needed, "push.cap.ok")
            _ = LLVMBuildCondBr(builder, enough, store_block, grow_block)

            LLVMPositionBuilderAtEnd(builder, grow_block)
            doubled: LLVMValueRef = LLVMBuildMul(builder, capacity, LLVMConstInt(int64_type, 2, 0), "push.cap.double")
            # 32 = EQ.
            is_empty: LLVMValueRef = LLVMBuildICmp(builder, 32, capacity, LLVMConstInt(int64_type, 0, 0), "push.cap.zero")
            base: LLVMValueRef = LLVMBuildSelect(builder, is_empty, LLVMConstInt(int64_type, 256, 0), doubled, "push.cap.base")
            # 36 = ULT.
            too_small: LLVMValueRef = LLVMBuildICmp(builder, 36, base, needed, "push.cap.lt")
            new_capacity: LLVMValueRef = LLVMBuildSelect(builder, too_small, needed, base, "push.cap.new")
            old_bytes: LLVMValueRef = LLVMBuildMul(builder, capacity, stride, "push.old.bytes")
            new_bytes: LLVMValueRef = LLVMBuildMul(builder, new_capacity, stride, "push.new.bytes")

            old_items: LLVMValueRef = LLVMBuildLoad2(builder, LLVMPointerTypeInContext(ctx, 0), items_pointer, "push.items")
            is_null: LLVMValueRef = LLVMBuildICmp(builder, 32, old_items, LLVMConstNull(LLVMPointerTypeInContext(ctx, 0)), "push.items.null")
            alloc_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "push.alloc")
            realloc_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "push.realloc")
            grown_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "push.grown")
            _ = LLVMBuildCondBr(builder, is_null, alloc_block, realloc_block)

            # The fresh pointer lands in a slot rather than a phi: both arms are calls, and
            # a slot needs no incoming-block bookkeeping. mem2reg restores the phi at -O2.
            LLVMPositionBuilderAtEnd(builder, alloc_block)
            alloc_arguments: mutable darray[LLVMValueRef] = [runtime.arena, new_bytes]
            alloc_pointer: void& = (&alloc_arguments[0]).cast[void&] can Unsafe.PointerCast
            allocated: LLVMValueRef = LLVMBuildCall2(builder, runtime.arena_alloc_type, runtime.arena_alloc, alloc_pointer, 2, "push.alloc")
            _ = LLVMBuildStore(builder, allocated, items_pointer)
            _ = LLVMBuildBr(builder, grown_block)

            LLVMPositionBuilderAtEnd(builder, realloc_block)
            realloc_arguments: mutable darray[LLVMValueRef] = [runtime.arena, old_items, old_bytes, new_bytes]
            realloc_pointer: void& = (&realloc_arguments[0]).cast[void&] can Unsafe.PointerCast
            reallocated: LLVMValueRef = LLVMBuildCall2(builder, runtime.arena_realloc_type, runtime.arena_realloc, realloc_pointer, 4, "push.realloc")
            _ = LLVMBuildStore(builder, reallocated, items_pointer)
            _ = LLVMBuildBr(builder, grown_block)

            LLVMPositionBuilderAtEnd(builder, grown_block)
            _ = LLVMBuildStore(builder, new_capacity, capacity_pointer)
            _ = LLVMBuildBr(builder, store_block)

            LLVMPositionBuilderAtEnd(builder, store_block)
            if emit_expression(value_expression, element_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is pushed_value:
                items: LLVMValueRef = LLVMBuildLoad2(builder, LLVMPointerTypeInContext(ctx, 0), items_pointer, "push.items.cur")
                indices: mutable darray[LLVMValueRef] = [count]
                indices_pointer: void& = (&indices[0]).cast[void&] can Unsafe.PointerCast
                # ONE index: `items` is already a T*, not a pointer-to-array, so there is
                # no leading 0 to step over (unlike a fixed array's two-index GEP).
                slot: LLVMValueRef = LLVMBuildGEP2(builder, llvm_type_of(element_type, structs, ctx), items, indices_pointer, 1, "push.slot")
                _ = LLVMBuildStore(builder, pushed_value, slot)
                _ = LLVMBuildStore(builder, needed, count_pointer)
                return true
            return false


        # The ADDRESS of a struct-typed local, and the struct's type.
        #
        # For a plain local that is its alloca. For a `P&` parameter the alloca holds a
        # POINTER, so the address is that pointer LOADED — one indirection more. Everything
        # downstream (field GEP, field store) is then identical, which is why field access
        # needs no ref-specific path of its own.
        def struct_address_of(name: sview, local_scope: mutable Scope&, structs: mutable StructTable&, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            declared: ValueType = lookup_type(local_scope, name)
            if lookup_slot(local_scope, name) is slot:
                slot return if declared.kind == TypeKind.Struct
                if declared.kind == TypeKind.Ref:
                    null return if ref_target_of(declared, structs).kind != TypeKind.Struct
                    return LLVMBuildLoad2(builder, LLVMPointerTypeInContext(ctx, 0), slot, "ref.deref")
            return null


        # The struct type behind a name, looking through one reference.
        def struct_type_of_name(name: sview, local_scope: mutable Scope&, structs: mutable StructTable&) -> ValueType can[Abort.Panic]:
            declared: ValueType = lookup_type(local_scope, name)
            declared return if declared.kind == TypeKind.Struct
            return ref_target_of(declared, structs)


        # Whether an expression threads its `expected` type down to sub-expressions rather
        # than producing a value directly. Such a form must NOT be implicitly wrapped: its
        # ARMS each wrap themselves, which is what makes `42 if flag else null` work.
        def propagates_expected(expression: Expr) -> bool can[Abort.Panic]:
            if expression is Expr.If(condition, then_expression, else_expression, line):
                return true
            if expression is Expr.Match(scrutinee, arms, match_line):
                return true
            if expression is Expr.Paren(inner, paren_line):
                return propagates_expected(inner)
            return false


        # Whether an expression is the `null` literal (an IDENT named "null" in the AST).
        def is_null_literal(expression: Expr) -> bool can[Abort.Panic]:
            if expression is Expr.Ident(name, line):
                return name == "null"
            return false


        # Wrap `value` (of type `payload`) into a `T?` — `{true, value}`.
        #
        # Built through a slot rather than insertvalue: the tag and payload are two plain
        # stores, and SROA collapses it at -O2 exactly the same. An Elisa expression of
        # payload type in an optional context is implicitly wrapped — the language has no
        # `some(x)`, so this is where that happens.
        def wrap_optional(value: LLVMValueRef, optional_type: ValueType, structs: mutable StructTable&, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            optional_llvm: LLVMTypeRef = llvm_type_of(optional_type, structs, ctx)
            slot: LLVMValueRef = LLVMBuildAlloca(builder, optional_llvm, "opt")
            tag_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, optional_llvm, slot, 0, "opt.tag.ptr")
            _ = LLVMBuildStore(builder, LLVMConstInt(LLVMInt1TypeInContext(ctx), 1, 0), tag_pointer)
            value_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, optional_llvm, slot, 1, "opt.value.ptr")
            _ = LLVMBuildStore(builder, value, value_pointer)
            return LLVMBuildLoad2(builder, optional_llvm, slot, "opt.wrapped")


        # Emit a value expression, producing a value of `resolve_type(expression, expected)`.
        # `null` = unmodeled; the caller must decline.
        def emit_expression(expression: Expr, expected: ValueType, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            # IMPLICIT WRAP: Elisa has no `some(x)` — an expression of payload type in an
            # optional context IS the optional. Handled before everything else so each
            # value form stays unaware of optionals: re-emit at the PAYLOAD type, then wrap.
            # `null` is excluded (it is the empty optional, not a payload).
            if expected.kind == TypeKind.Optional:
                payload_type: ValueType = optional_payload_of(expected, structs)
                # A value-`if` / `match` already threads `expected` DOWN to its arms, so
                # each arm wraps itself. Wrapping the whole form instead would push the
                # payload type into the arms and reject `42 if flag else null` — the `null`
                # arm is not an i64.
                if not is_null_literal(expression) and not propagates_expected(expression):
                    own: ValueType = expression_type(expression, local_scope, fns, structs, generics)
                    if own.kind != TypeKind.Optional:
                        if emit_expression(expression, payload_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is payload_value:
                            return wrap_optional(payload_value, expected, structs, ctx, builder)
                        return null
            if expression is Expr.IntLit(literal_value):
                # A literal takes the context's type. sign_extend=1 so a negative literal
                # fills correctly at any width.
                null return if not is_integer_type(expected)
                return LLVMConstInt(llvm_type_of(expected, structs, ctx), literal_value.u64(), 1)
            if expression is Expr.BoolLit(bool_value):
                bool_type: LLVMTypeRef = LLVMInt1TypeInContext(ctx)
                return LLVMConstInt(bool_type, 1, 0) if bool_value else LLVMConstInt(bool_type, 0, 0)
            # `1.5` — built from the SOURCE TEXT, so LLVM's own parser decides the exact
            # bits rather than the backend re-implementing decimal rounding.
            if expression is Expr.FloatLit(float_text):
                null return if expected.kind != TypeKind.Float
                text_storage: mutable darray[u8] = []
                return LLVMConstRealOfString(llvm_type_of(expected, structs, ctx), sview_to_cstr(float_text, text_storage))
            # An ident is a local read: load from its slot, at the slot's own type.
            # `null` is an IDENT named "null" in the AST, not its own node. It is the
            # empty optional: `{false, undef}` — the payload half is never read when the
            # tag is false, so a zeroed struct is the whole value.
            if expression is Expr.StringLit(string_text):
                null return if expected.kind != TypeKind.CStr and expected.kind != TypeKind.Unmodeled
                literal_storage: mutable darray[u8] = []
                return LLVMBuildGlobalStringPtr(builder, sview_to_cstr(string_text, literal_storage), "str")
            if expression is Expr.Ident(null_name, null_line):
                if null_name == "null":
                    null return if expected.kind != TypeKind.Optional
                    return LLVMConstNull(llvm_type_of(expected, structs, ctx))
            if expression is Expr.Ident(ident_name, ident_line):
                ident_type: ValueType = lookup_type(local_scope, ident_name)
                # A GLOBAL const is INLINED at its use site, exactly as stage0 does: no
                # global, no load, just the folded value at the const's own type. Checked
                # only when the name is not a local, so a local still shadows it.
                if ident_type.kind == TypeKind.Unmodeled:
                    const_index: i64 = const_index_of(structs, ident_name)
                    if const_index >= 0 and structs.const_resolved[const_index.usize()]:
                        const_type: ValueType = copied_type(structs.const_types[const_index.usize()])
                        null return if not is_integer_type(const_type)
                        return LLVMConstInt(llvm_type_of(const_type, structs, ctx), structs.const_values[const_index.usize()].u64(), 0)
                null return if ident_type.kind == TypeKind.Unmodeled
                if lookup_slot(local_scope, ident_name) is slot:
                    # A local passed where a REFERENCE is wanted: hand over its ADDRESS.
                    # Locals are already allocas, so `&local` IS the slot — exactly what
                    # stage0 emits (`call void @bump(ptr %x)`). No `&` operator is needed
                    # at the call site; the expected type drives it.
                    if expected.kind == TypeKind.Ref and ident_type.kind != TypeKind.Ref:
                        null return if ref_target_of(expected, structs).kind != ident_type.kind
                        return slot
                    return LLVMBuildLoad2(builder, llvm_type_of(ident_type, structs, ctx), slot, "load")
                return null
            if expression is Expr.Paren(paren_inner, paren_line):
                return emit_expression(paren_inner, expected, local_scope, fns, structs, generics, runtime, m, ctx, builder)
            if expression is Expr.Unary(unary_operator, unary_operand, unary_line):
                # `not x` needs a bool operand, not `expected` (which is itself bool).
                if unary_operator == TokenKind.Not or unary_operator == TokenKind.Bang:
                    bool_type_n: ValueType = ValueType{kind: TypeKind.Bool, bits: 1}
                    if emit_expression(unary_operand, bool_type_n, local_scope, fns, structs, generics, runtime, m, ctx, builder) is bool_operand:
                        # `not` on an i1 is XOR with 1.
                        return LLVMBuildXor(builder, bool_operand, LLVMConstInt(LLVMInt1TypeInContext(ctx), 1, 0), "not")
                    return null
                operand_type: ValueType = resolve_type(unary_operand, expected, local_scope, fns, structs, generics)
                null return if not is_numeric_type(operand_type)
                if emit_expression(unary_operand, operand_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is operand:
                    operand return if unary_operator == TokenKind.Plus
                    if unary_operator == TokenKind.Minus:
                        # `-x` on a float is fneg; `~x` has no float form.
                        return LLVMBuildFNeg(builder, operand, "fneg") if operand_type.kind == TypeKind.Float else LLVMBuildNeg(builder, operand, "neg")
                    if unary_operator == TokenKind.Tilde:
                        null return if operand_type.kind == TypeKind.Float
                        return LLVMBuildNot(builder, operand, "bnot")
                return null
            # `v is name` — optional NARROWING. Yields the tag as a bool AND binds the
            # payload to `name`, which the guarded block then reads. The binding is
            # introduced unconditionally here; the frontend has already proved it is only
            # read where the tag is true, so the backend does not re-prove it.
            if expression is Expr.Binary(is_left, is_operator, is_right, is_line):
                if is_operator == TokenKind.Is:
                    if is_right is Expr.Ident(bind_name, bind_line):
                        optional_type: ValueType = expression_type(is_left, local_scope, fns, structs, generics)
                        null return if optional_type.kind != TypeKind.Optional
                        if emit_expression(is_left, optional_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is optional_value:
                            optional_llvm: LLVMTypeRef = llvm_type_of(optional_type, structs, ctx)
                            holder: LLVMValueRef = LLVMBuildAlloca(builder, optional_llvm, "is.opt")
                            _ = LLVMBuildStore(builder, optional_value, holder)
                            payload_type: ValueType = optional_payload_of(optional_type, structs)
                            payload_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, optional_llvm, holder, 1, "is.value.ptr")
                            bind_storage: mutable darray[u8] = []
                            bind_slot: LLVMValueRef = LLVMBuildAlloca(builder, llvm_type_of(payload_type, structs, ctx), sview_to_cstr(bind_name, bind_storage))
                            _ = LLVMBuildStore(builder, LLVMBuildLoad2(builder, llvm_type_of(payload_type, structs, ctx), payload_pointer, "is.value"), bind_slot)
                            declare_local(local_scope, bind_name, bind_slot, payload_type)
                            tag_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, optional_llvm, holder, 0, "is.tag.ptr")
                            return LLVMBuildLoad2(builder, LLVMInt1TypeInContext(ctx), tag_pointer, "is.tag")
                    return null
            if expression is Expr.Binary(binary_left, binary_operator, binary_right, binary_line):
                # `and`/`or` SHORT-CIRCUIT: the right side must only be emitted on the path
                # that reaches it, so they cannot go through emit_binary.
                if binary_operator == TokenKind.And or binary_operator == TokenKind.Or:
                    return emit_short_circuit(binary_left, binary_operator, binary_right, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                # The OPERANDS' type is not the result type: `a < b` yields bool but must
                # compare at a's type. Take whichever side is known; a literal defers.
                operand_type: mutable ValueType = expression_type(binary_left, local_scope, fns, structs, generics)
                if operand_type.kind == TypeKind.Unmodeled:
                    operand_type <- expression_type(binary_right, local_scope, fns, structs, generics)
                if operand_type.kind == TypeKind.Unmodeled:
                    # Both sides are literals (`2 + 3`): fall back to the context, which
                    # for a comparison is bool — so use i64 there.
                    operand_type <- expected if is_numeric_type(expected) else ValueType{kind: TypeKind.Signed, bits: 64}
                null return if not is_numeric_type(operand_type)
                # MIXED WIDTHS are not modeled: Elisa has no implicit numeric conversion
                # in the subset, and silently extending one side would invent semantics.
                left_own: ValueType = expression_type(binary_left, local_scope, fns, structs, generics)
                right_own: ValueType = expression_type(binary_right, local_scope, fns, structs, generics)
                null return if left_own.kind != TypeKind.Unmodeled and (left_own.bits != operand_type.bits or left_own.kind != operand_type.kind)
                null return if right_own.kind != TypeKind.Unmodeled and (right_own.bits != operand_type.bits or right_own.kind != operand_type.kind)
                if emit_expression(binary_left, operand_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is left:
                    if emit_expression(binary_right, operand_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is right:
                        return emit_binary(binary_operator, left, right, operand_type, structs, ctx, builder)
                return null
            # A value `match` over an integer scrutinee: `match n: 0: 100 … _: 300`.
            #
            # Lowered as an ordered COMPARE CHAIN, not a switch: arms must be tried in
            # source order, and turning a dense chain into a switch is llc's job.
            if expression is Expr.Match(match_scrutinee, match_arms, match_line):
                scrutinee_type: ValueType = resolve_type(match_scrutinee, ValueType{kind: TypeKind.Signed, bits: 64}, local_scope, fns, structs, generics)
                # An integer scrutinee compares directly; a PAYLOAD ENUM compares on its TAG.
                penum_scrutinee: bool = scrutinee_type.kind == TypeKind.PayloadEnum
                null return if not is_integer_type(scrutinee_type) and not penum_scrutinee
                match_type: LLVMTypeRef = llvm_type_of(expected, structs, ctx)
                null return if expected.kind == TypeKind.Unmodeled
                if emit_expression(match_scrutinee, scrutinee_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is scrutinee_raw:
                    function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                    # `%match.tag.value = extractvalue %Shape %sh, 0` — stage0's shape. The
                    # tag is an i32 regardless of the payload, so the compare constant below
                    # is built at i32, not at the scrutinee's own type.
                    scrutinee: mutable LLVMValueRef = scrutinee_raw
                    compare_type: mutable LLVMTypeRef = llvm_type_of(scrutinee_type, structs, ctx)
                    penum_slot: mutable LLVMValueRef = scrutinee_raw
                    if penum_scrutinee:
                        scrutinee <- LLVMBuildExtractValue(builder, scrutinee_raw, 0, "match.tag.value")
                        compare_type <- LLVMInt32TypeInContext(ctx)
                        # The payload is read through memory (stage0 spills the value too),
                        # so the arm's binding loads from this slot.
                        penum_slot <- LLVMBuildAlloca(builder, llvm_type_of(scrutinee_type, structs, ctx), "match.payload.tmp")
                        _ = LLVMBuildStore(builder, scrutinee_raw, penum_slot)
                    result_slot: LLVMValueRef = LLVMBuildAlloca(builder, match_type, "match.result")
                    done_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "match.done")
                    declined: mutable bool = false
                    saw_default: mutable bool = false

                    for arm in match_arms |declined, saw_default, scrutinee, scrutinee_type, penum_scrutinee, penum_slot, compare_type, expected, result_slot, done_block, function, local_scope, fns, structs, generics, runtime, m, ctx, builder|:
                        # Once a catch-all is emitted the chain is closed.
                        continue if declined or saw_default
                        if arm_has_guard(arm.guard):
                            declined <- true
                            continue
                        if arm_value_expression(arm.body) is arm_expression:
                            arm_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "match.arm")
                            # `Color.Red:` — a CONST ENUM variant arm is an ordinal
                            # comparison, exactly like an integer-literal arm (stage0 emits
                            # `icmp eq i8 %c, 0`). Resolved to its ordinal and folded into
                            # the same compare chain.
                            variant_ordinal: mutable i64 = -1
                            payload_binding: mutable sview = ""
                            payload_declined: mutable bool = false
                            # The `is` binding is scoped to its branch, so the path is copied
                            # out for the payload load further down.
                            payload_path: mutable sview = ""
                            if arm.pattern is Pattern.Variant(variant_path, variant_fields):
                                payload_path <- variant_path
                                if penum_scrutinee:
                                    # `Shape.Circle(r)` — the tag is the variant's index in
                                    # its own enum, and the arm may bind ONE payload field.
                                    variant_ordinal <- penum_variant_index_of_path(variant_path, structs)
                                    payload_declined <- true if variant_fields.count > 1
                                    if variant_fields.count == 1:
                                        if variant_fields[0] is Pattern.Binding(bound_name):
                                            payload_binding <- bound_name
                                        else:
                                            payload_declined <- true
                                else:
                                    if variant_fields.count == 0:
                                        variant_ordinal <- ordinal_of_dotted_path(variant_path, structs)
                            if payload_declined:
                                declined <- true
                                continue
                            if variant_ordinal >= 0:
                                next_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "match.next")
                                hit: LLVMValueRef = LLVMBuildICmp(builder, 32, scrutinee, LLVMConstInt(compare_type, variant_ordinal.u64(), 0), "match.cmp")
                                _ = LLVMBuildCondBr(builder, hit, arm_block, next_block)
                                LLVMPositionBuilderAtEnd(builder, arm_block)
                                # Bind the payload INSIDE the arm: `getelementptr %Shape, ptr
                                # %tmp, i32 0, i32 1` then load at the variant's own type.
                                if penum_scrutinee and payload_binding != "":
                                    payload_type: ValueType = penum_payload_of_path(payload_path, structs)
                                    if payload_type.kind == TypeKind.Unmodeled:
                                        declined <- true
                                        continue
                                    payload_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, llvm_type_of(scrutinee_type, structs, ctx), penum_slot, 1, "enum.payload.ptr")
                                    payload_value: LLVMValueRef = LLVMBuildLoad2(builder, llvm_type_of(payload_type, structs, ctx), payload_pointer, "match.payload")
                                    payload_name_storage: mutable darray[u8] = []
                                    payload_slot: LLVMValueRef = LLVMBuildAlloca(builder, llvm_type_of(payload_type, structs, ctx), sview_to_cstr(payload_binding, payload_name_storage))
                                    _ = LLVMBuildStore(builder, payload_value, payload_slot)
                                    declare_local(local_scope, payload_binding, payload_slot, payload_type)
                                if emit_expression(arm_expression, expected, local_scope, fns, structs, generics, runtime, m, ctx, builder) is variant_value:
                                    _ = LLVMBuildStore(builder, variant_value, result_slot)
                                    _ = LLVMBuildBr(builder, done_block)
                                else:
                                    declined <- true
                                LLVMPositionBuilderAtEnd(builder, next_block)
                                continue
                            if arm.pattern is Pattern.Literal(literal_text):
                                literal_value: mutable i64 = 0
                                if parse_int_literal(literal_text, literal_value):
                                    next_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "match.next")
                                    # 32 = LLVMIntEQ (equality needs no signedness).
                                    hit: LLVMValueRef = LLVMBuildICmp(builder, 32, scrutinee, LLVMConstInt(llvm_type_of(scrutinee_type, structs, ctx), literal_value.u64(), 1), "match.cmp")
                                    _ = LLVMBuildCondBr(builder, hit, arm_block, next_block)
                                    LLVMPositionBuilderAtEnd(builder, arm_block)
                                    if emit_expression(arm_expression, expected, local_scope, fns, structs, generics, runtime, m, ctx, builder) is arm_value:
                                        _ = LLVMBuildStore(builder, arm_value, result_slot)
                                        _ = LLVMBuildBr(builder, done_block)
                                    else:
                                        declined <- true
                                    LLVMPositionBuilderAtEnd(builder, next_block)
                                else:
                                    declined <- true
                            else:
                                if is_catch_all_pattern(arm.pattern):
                                    _ = LLVMBuildBr(builder, arm_block)
                                    LLVMPositionBuilderAtEnd(builder, arm_block)
                                    if emit_expression(arm_expression, expected, local_scope, fns, structs, generics, runtime, m, ctx, builder) is default_value:
                                        _ = LLVMBuildStore(builder, default_value, result_slot)
                                        _ = LLVMBuildBr(builder, done_block)
                                        saw_default <- true
                                    else:
                                        declined <- true
                                else:
                                    declined <- true
                        else:
                            declined <- true

                    null return if declined
                    # Fell off the chain with no `_`: unreachable (the frontend proves
                    # exhaustiveness; inventing a value would hide a real gap).
                    terminate_if_no_default(saw_default, builder)
                    LLVMPositionBuilderAtEnd(builder, done_block)
                    return LLVMBuildLoad2(builder, match_type, result_slot, "match")
                return null

            # A value `if`: `a if cond else b`. Only ONE arm is evaluated, so it uses the
            # same result-slot lowering as `and`/`or`.
            if expression is Expr.If(ternary_condition, then_expression, else_expression, ternary_line):
                null return if expected.kind == TypeKind.Unmodeled
                ternary_type: LLVMTypeRef = llvm_type_of(expected, structs, ctx)
                result_slot: LLVMValueRef = LLVMBuildAlloca(builder, ternary_type, "if.result")
                if emit_condition(ternary_condition, local_scope, fns, structs, generics, runtime, m, ctx, builder) is condition_bit:
                    function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                    then_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "ifx.then")
                    else_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "ifx.else")
                    done_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "ifx.done")
                    _ = LLVMBuildCondBr(builder, condition_bit, then_block, else_block)

                    LLVMPositionBuilderAtEnd(builder, then_block)
                    if emit_expression(then_expression, expected, local_scope, fns, structs, generics, runtime, m, ctx, builder) is then_value:
                        _ = LLVMBuildStore(builder, then_value, result_slot)
                        _ = LLVMBuildBr(builder, done_block)
                        LLVMPositionBuilderAtEnd(builder, else_block)
                        # An `else` is mandatory in a value position; an Absent else
                        # declines (no value on one path).
                        if emit_expression(else_expression, expected, local_scope, fns, structs, generics, runtime, m, ctx, builder) is else_value:
                            _ = LLVMBuildStore(builder, else_value, result_slot)
                            _ = LLVMBuildBr(builder, done_block)
                            LLVMPositionBuilderAtEnd(builder, done_block)
                            return LLVMBuildLoad2(builder, ternary_type, result_slot, "ifx")
                return null
            # `[10, 30, 2]` — a fixed-array literal. Built in a temporary slot element by
            # element, then loaded back; SROA turns it into registers/constants at -O2.
            # The literal must have exactly the declared extent: a short literal would
            # leave elements undef.
            if expression is Expr.Array(array_elements, array_literal_line):
                # `[]` initializing a darray: the zero value {null, 0, 0}. `[1, 2]` into a
                # darray is not modeled (it would need a push per element plus the grow
                # path inline), so it declines.
                if expected.kind == TypeKind.DArray:
                    null return if array_elements.count != 0
                    return LLVMConstNull(darray_llvm_type(structs, ctx))
                null return if expected.kind != TypeKind.Array
                slot_index: usize = expected.bits.usize()
                null return if array_elements.count != structs.array_extents[slot_index].usize()
                element_type: ValueType = structs.array_elements[slot_index]
                array_llvm: LLVMTypeRef = llvm_type_of(expected, structs, ctx)
                temporary: LLVMValueRef = LLVMBuildAlloca(builder, array_llvm, "array")
                declined: mutable bool = false
                position: mutable u32 = 0
                for element_expression in array_elements |declined, position, element_type, array_llvm, temporary, local_scope, fns, structs, generics, runtime, m, ctx, builder|:
                    indices: mutable darray[LLVMValueRef] = [LLVMConstInt(LLVMInt64TypeInContext(ctx), 0, 0), LLVMConstInt(LLVMInt64TypeInContext(ctx), position.u64(), 0)]
                    indices_pointer: void& = (&indices[0]).cast[void&] can Unsafe.PointerCast
                    pointer: LLVMValueRef = LLVMBuildGEP2(builder, array_llvm, temporary, indices_pointer, 2, "init.ptr")
                    if emit_expression(element_expression, element_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is element_value:
                        _ = LLVMBuildStore(builder, element_value, pointer)
                    else:
                        declined <- true
                    position <- position + 1
                null return if declined
                return LLVMBuildLoad2(builder, array_llvm, temporary, "arrayval")

            # `xs[i]` — an index READ. Only a local array receiver is modeled: the address
            # comes from the local's slot, so no temporary spill is needed.
            if expression is Expr.Index(indexed_object, index_expression, index_line):
                if indexed_object is Expr.Ident(array_name, array_name_line):
                    array_type: ValueType = lookup_type(local_scope, array_name)
                    # A BORROWED darray (`darray[T]&`) indexes exactly like a local one once
                    # its header address is loaded out of the parameter slot.
                    borrowed_type: ValueType = darray_type_behind(local_scope, array_name, structs)
                    if borrowed_type.kind == TypeKind.DArray and array_type.kind == TypeKind.Ref:
                        if darray_address_of(local_scope, array_name, structs, ctx, builder) is borrowed_slot:
                            if emit_darray_index_address(borrowed_slot, borrowed_type, index_expression, local_scope, fns, structs, generics, runtime, m, ctx, builder) is borrowed_pointer:
                                borrowed_element: ValueType = darray_element_of(borrowed_type, structs)
                                return LLVMBuildLoad2(builder, llvm_type_of(borrowed_element, structs, ctx), borrowed_pointer, "darray.elem")
                        return null
                    if lookup_slot(local_scope, array_name) is array_slot:
                        # A darray indexes through its `items` pointer; a fixed array
                        # indexes the storage directly.
                        if array_type.kind == TypeKind.DArray:
                            if emit_darray_index_address(array_slot, array_type, index_expression, local_scope, fns, structs, generics, runtime, m, ctx, builder) is darray_pointer:
                                darray_element: ValueType = darray_element_of(array_type, structs)
                                return LLVMBuildLoad2(builder, llvm_type_of(darray_element, structs, ctx), darray_pointer, "darray.elem")
                            return null
                        null return if array_type.kind != TypeKind.Array
                        if emit_index_address(array_slot, array_type, index_expression, local_scope, fns, structs, generics, runtime, m, ctx, builder) is pointer:
                            element_type: ValueType = array_element_of(array_type, structs)
                            return LLVMBuildLoad2(builder, llvm_type_of(element_type, structs, ctx), pointer, "elem")
                return null

            # `Point{x: 40, y: 2}` — build the value in a temporary slot, store each
            # field, then load the whole struct back. mem2reg/SROA turn this into plain
            # registers at -O2, so the temporary costs nothing in the output.
            #
            # Fields must be given by NAME and all of them present: the subset does not
            # model shorthand or defaulted construction, so a missing field declines
            # rather than silently leaving a slot undef.
            if expression is Expr.Construct(construct_type, construct_fields, construct_line):
                built_type: ValueType = annotation_value_type(construct_type, structs)
                null return if built_type.kind != TypeKind.Struct
                struct_slot: usize = built_type.bits.usize()
                null return if construct_fields.count != structs.field_count[struct_slot]

                struct_llvm: LLVMTypeRef = llvm_type_of(built_type, structs, ctx)
                temporary: LLVMValueRef = LLVMBuildAlloca(builder, struct_llvm, "construct")
                declined: mutable bool = false
                for field_init in construct_fields |declined, struct_slot, struct_llvm, temporary, local_scope, fns, structs, generics, runtime, m, ctx, builder|:
                    position: i64 = field_index_of(structs, struct_slot, field_init.name)
                    if position < 0:
                        declined <- true
                    else:
                        field_type: ValueType = structs.field_types[structs.field_start[struct_slot] + position.usize()]
                        if emit_expression(field_init.value, field_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is field_value:
                            _ = LLVMBuildStore(builder, field_value, LLVMBuildStructGEP2(builder, struct_llvm, temporary, position.u32(), "field.ptr"))
                        else:
                            declined <- true
                null return if declined
                return LLVMBuildLoad2(builder, struct_llvm, temporary, "constructed")

            # `Color.Green` — a CONST ENUM member is a constant of the enum's backing
            # type: its declaration-order ordinal.
            if expression is Expr.Field(enum_object, enum_variant, enum_field_line):
                if enum_object is Expr.Ident(enum_type_name, enum_type_line):
                    enum_slot: i64 = enum_index_of(structs, enum_type_name)
                    if enum_slot >= 0:
                        ordinal: i64 = enum_ordinal_of(structs, enum_slot.usize(), enum_variant)
                        null return if ordinal < 0
                        backing: ValueType = copied_type(structs.enum_backings[enum_slot.usize()])
                        return LLVMConstInt(llvm_type_of(backing, structs, ctx), ordinal.u64(), 0)
                    # `Opt.None` — a PAYLOAD-FREE variant of a payload enum, used as a bare
                    # value rather than called. It is still the tagged union: the tag, with
                    # the payload slot left zeroed.
                    penum_slot_index: i64 = penum_index_of(structs, enum_type_name)
                    if penum_slot_index >= 0:
                        penum_tag: i64 = penum_variant_index(structs, penum_slot_index, enum_variant)
                        null return if penum_tag < 0
                        # A variant WITH a payload is a constructor and must be called; a
                        # bare mention of one is not a value.
                        null return if structs.penum_has_payload[structs.penum_variant_start[penum_slot_index.usize()] + penum_tag.usize()]
                        penum_value_type: ValueType = ValueType{kind: TypeKind.PayloadEnum, bits: penum_slot_index.u32()}
                        penum_llvm: LLVMTypeRef = llvm_type_of(penum_value_type, structs, ctx)
                        penum_ctor_slot: LLVMValueRef = LLVMBuildAlloca(builder, penum_llvm, "enum.ctor")
                        _ = LLVMBuildStore(builder, LLVMConstNull(penum_llvm), penum_ctor_slot)
                        penum_tag_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, penum_llvm, penum_ctor_slot, 0, "enum.tag.ptr")
                        _ = LLVMBuildStore(builder, LLVMConstInt(LLVMInt32TypeInContext(ctx), penum_tag.u64(), 0), penum_tag_pointer)
                        return LLVMBuildLoad2(builder, penum_llvm, penum_ctor_slot, "enum.value")

            # `xs.count` — read the darray header's count field.
            if expression is Expr.Field(darray_object, darray_field, darray_field_line):
                if darray_object is Expr.Ident(darray_name, darray_name_line):
                    darray_type: ValueType = darray_type_behind(local_scope, darray_name, structs)
                    if darray_type.kind == TypeKind.DArray and darray_field == "count":
                        if darray_address_of(local_scope, darray_name, structs, ctx, builder) is darray_slot:
                            count_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, darray_llvm_type(structs, ctx), darray_slot, 1, "darray.count.ptr")
                            return LLVMBuildLoad2(builder, LLVMInt64TypeInContext(ctx), count_pointer, "darray.count")

            # `p.x` — a field READ. Only a local struct receiver is modeled: the address
            # comes from the local's slot, so there is no need to spill a temporary.
            if expression is Expr.Field(field_object, field_name, field_line):
                if field_object is Expr.Ident(object_name, object_line):
                    # Looks through a reference: `p.x` works the same for `p: P` and `p: P&`.
                    object_type: ValueType = struct_type_of_name(object_name, local_scope, structs)
                    null return if object_type.kind != TypeKind.Struct
                    struct_slot: usize = object_type.bits.usize()
                    position: i64 = field_index_of(structs, struct_slot, field_name)
                    null return if position < 0
                    if struct_address_of(object_name, local_scope, structs, ctx, builder) is object_address:
                        field_type: ValueType = structs.field_types[structs.field_start[struct_slot] + position.usize()]
                        struct_llvm: LLVMTypeRef = llvm_type_of(object_type, structs, ctx)
                        pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, struct_llvm, object_address, position.u32(), "field.ptr")
                        return LLVMBuildLoad2(builder, llvm_type_of(field_type, structs, ctx), pointer, "field")
                return null

            if expression is Expr.Call(call_callee, call_arguments, call_argument_names, call_line):
                # A labelled argument is a different calling convention; not modeled.
                for argument_name in call_argument_names:
                    null return if argument_name != ""
                # `x.u8()` is a CAST, not a call: postfix call unifies cast and UFCS, so a
                # TYPE-NAME receiver-method is a conversion. A receiver-method that is NOT a
                # type name falls through to emit_call, which resolves it as UFCS.
                if call_callee is Expr.Field(cast_object, cast_name, cast_line):
                    target_type: ValueType = scalar_type_of_name(cast_name)
                    if target_type.kind != TypeKind.Unmodeled:
                        null return if call_arguments.count != 0
                        # The source's own type decides; only a bare literal receiver needs a
                        # default, and `1.5.i64()` is not a form the subset needs to model.
                        source_type: ValueType = resolve_type(cast_object, ValueType{kind: TypeKind.Signed, bits: 64}, local_scope, fns, structs, generics)
                        if emit_expression(cast_object, source_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is source_value:
                            return emit_conversion(source_value, source_type, target_type, structs, ctx, builder)
                        return null
                return emit_call(call_callee, call_arguments, local_scope, fns, structs, generics, runtime, m, ctx, builder)
            return null


        # Emit a branch condition: a modeled `bool` (i1). Elisa requires a bool condition,
        # so this simply emits at bool type — no `!= 0` narrowing, because a comparison
        # already yields i1 and a bool local is stored as i1.
        def emit_condition(condition: Expr, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            bool_type: ValueType = ValueType{kind: TypeKind.Bool, bits: 1}
            condition_type: ValueType = resolve_type(condition, bool_type, local_scope, fns, structs, generics)
            null return if condition_type.kind != TypeKind.Bool
            return emit_expression(condition, bool_type, local_scope, fns, structs, generics, runtime, m, ctx, builder)


        # Branch to `dest` only when the just-emitted region left the block OPEN. An arm
        # that already returned must not also get a branch — LLVM rejects a block with two
        # terminators.
        def branch_if_open(status: EmitStatus, builder: LLVMBuilderRef, dest: LLVMBasicBlockRef) -> void can[Abort.Panic]:
            return if status != EmitStatus.Open
            _ = LLVMBuildBr(builder, dest)


        # Emit a statement list. Declined if ANY statement declined; Terminated if the
        # list ended the block.
        #
        # A statement AFTER a terminator is unreachable; the subset does not model dead
        # code, so it declines rather than emitting into a closed block (which LLVM would
        # reject anyway).
        def emit_statements(body: darray[Stmt]&, return_type: ValueType, local_scope: mutable Scope&, loops: mutable LoopStack&, regions: mutable RegionStack&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> EmitStatus can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            status: mutable EmitStatus = EmitStatus.Open
            for statement in body |status, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder|:
                if status == EmitStatus.Open:
                    status <- emit_statement(statement, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)
                else:
                    status <- EmitStatus.Declined
            return status


        # Emit one statement. Returns false to DECLINE (unmodeled construct).
        def emit_statement(statement: Stmt, return_type: ValueType, local_scope: mutable Scope&, loops: mutable LoopStack&, regions: mutable RegionStack&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> EmitStatus can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            int64_type: LLVMTypeRef = LLVMInt64TypeInContext(ctx)

            # `xs.push(v)` — a statement-position method call on a darray.
            # `region r:` — a NAMED, SCOPED region. stage0 emits `%r = alloca %Arena`,
            # allocates the block's containers from it (`arena_alloc(ptr %r, ...)`), and
            # arena_free's it at scope exit. Structurally the same thing emit_function_body
            # builds for a function's implicit auto region, so it reuses that shape and just
            # swaps which arena the block's statements allocate from.
            #
            # ONLY `region` is handled here. Every other Stmt.Block kind (`can ...:`,
            # `catch ...:`, arms) declines: `kind` is an opaque sview, so quietly treating an
            # unknown block as "just run the body" would silently drop the very semantics the
            # prefix carries. `region NAME(capacity):` likewise declines -- the capacity
            # lands in `clause` alongside the name and is not modeled.
            if statement is Stmt.Block(block_kind, block_clause, block_binding, block_body, block_line):
                declined_status: EmitStatus = EmitStatus.Declined
                declined_status return if block_kind != "region"
                # `region r:` gives clause ["r"]; `region r(4096):` gives ["r", "4096"] —
                # the parser captures the capacity as a span of the SOURCE text, so it is
                # parsed back out here rather than being an Expr.
                declined_status return if block_clause.count != 1 and block_clause.count != 2
                region_capacity: mutable i64 = 0
                if block_clause.count == 2:
                    declined_status return if not parse_int_literal(block_clause[1], region_capacity)
                    # A non-positive capacity is not a region stage0 would build.
                    declined_status return if region_capacity <= 0
                scoped_runtime: mutable Runtime = copied_runtime(runtime)
                scoped_arena_type: LLVMTypeRef = arena_llvm_type(ctx)
                scoped_name_storage: mutable darray[u8] = []
                scoped_slot: LLVMValueRef = LLVMBuildAlloca(builder, scoped_arena_type, sview_to_cstr(block_clause[0], scoped_name_storage))
                _ = LLVMBuildStore(builder, LLVMConstNull(scoped_arena_type), scoped_slot)
                if region_capacity > 0:
                    # An explicit capacity takes its backing UP FRONT from the runtime, and
                    # `begin` and `end` both start at it (stage0's shape). The lazy strategy
                    # word stays 0: the backing already exists, so there is nothing to
                    # allocate on first use.
                    region_backing_args: mutable darray[LLVMValueRef] = [LLVMConstInt(LLVMInt64TypeInContext(ctx), region_capacity.u64(), 0), LLVMConstInt(LLVMInt64TypeInContext(ctx), 0, 0)]
                    region_backing_pointer: void& = (&region_backing_args[0]).cast[void&] can Unsafe.PointerCast
                    region_backing: LLVMValueRef = LLVMBuildCall2(builder, scoped_runtime.new_region_backend_type, scoped_runtime.new_region_backend, region_backing_pointer, 2, "region.init")
                    region_begin: LLVMValueRef = LLVMBuildStructGEP2(builder, scoped_arena_type, scoped_slot, 0, "region.begin")
                    region_end: LLVMValueRef = LLVMBuildStructGEP2(builder, scoped_arena_type, scoped_slot, 1, "region.end")
                    _ = LLVMBuildStore(builder, region_backing, region_begin)
                    _ = LLVMBuildStore(builder, region_backing, region_end)
                else:
                    scoped_strategy: LLVMValueRef = LLVMBuildStructGEP2(builder, scoped_arena_type, scoped_slot, 3, "region.strategy")
                    _ = LLVMBuildStore(builder, LLVMConstInt(LLVMInt64TypeInContext(ctx), 2, 0), scoped_strategy)
                scoped_runtime.arena <- scoped_slot
                # The region's NAME is a value in scope: `region r(4096): return build(r)`
                # passes it as an Arena. Binding it here means the ordinary Ident path emits
                # the `load %Arena, ptr %r` the call site needs -- no special case.
                declare_local(local_scope, block_clause[0], scoped_slot, ValueType{kind: TypeKind.Arena, bits: 0})
                # The block OWNS this region: unlike a threaded arena, it must be freed when
                # the scope ends.
                scoped_runtime.owns_arena <- true
                # Live for the block's duration, so a `return` inside unwinds it along with
                # every enclosing region -- innermost first, which is the order stage0 emits.
                regions.arenas.push(scoped_slot)
                scoped_status: EmitStatus = emit_statements(block_body, return_type, local_scope, loops, regions, fns, structs, generics, scoped_runtime, m, ctx, builder)
                _ = regions.arenas.pop()
                declined_status return if scoped_status == EmitStatus.Declined
                # A body that RETURNED already unwound this region on its way out; emitting
                # the free here too would double-free it, and would follow a terminator.
                scoped_status return if scoped_status == EmitStatus.Terminated
                emit_region_free(scoped_runtime, builder)
                return scoped_status

            if statement is Stmt.Expr(statement_expression, statement_expression_line):
                if statement_expression is Expr.Call(push_callee, push_arguments, push_argument_names, push_call_line):
                    if push_callee is Expr.Field(push_object, push_method, push_method_line):
                        if push_object is Expr.Ident(push_name, push_name_line):
                            push_type: ValueType = darray_type_behind(local_scope, push_name, structs)
                            if push_type.kind == TypeKind.DArray and push_method == "push" and push_arguments.count == 1:
                                if darray_address_of(local_scope, push_name, structs, ctx, builder) is push_slot:
                                    if emit_darray_push(push_slot, push_type, push_arguments[0], local_scope, fns, structs, generics, runtime, m, ctx, builder):
                                        return EmitStatus.Open
                                return EmitStatus.Declined
                    # Any other call in STATEMENT position — typically a `-> void` call like
                    # `bump(c)`. The result (if any) is simply discarded; `expected` is Void
                    # because a statement wants no value.
                    if emit_call(push_callee, push_arguments, local_scope, fns, structs, generics, runtime, m, ctx, builder) is discarded_result:
                        return EmitStatus.Open
                return EmitStatus.Declined

            if statement is Stmt.Return(return_value_opt, return_line):
                if return_value_opt is return_value:
                    emitted: LLVMValueRef? = emit_expression(return_value, return_type, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                    if emitted is return_constant:
                        # Unwind EVERY live owned region on the way out — the function's auto
                        # region AND any enclosing `region NAME:` scopes. This lives on the
                        # return path rather than at one function exit because a return can
                        # happen from inside any depth of scope.
                        emit_region_unwind(regions, runtime, builder)
                        _ = LLVMBuildRet(builder, return_constant)
                        return EmitStatus.Terminated
                    return EmitStatus.Declined
                # A bare `return` — only valid in a `-> void` function.
                if return_type.kind == TypeKind.Void:
                    emit_region_unwind(regions, runtime, builder)
                    _ = LLVMBuildRetVoid(builder)
                    return EmitStatus.Terminated
                return EmitStatus.Declined

            # `x: i64 = value` — a fresh slot plus the initializing store. The slot is
            # allocated at the CURRENT position rather than hoisted to the entry block;
            # mem2reg still promotes it, and the subset has no loop-allocated locals.
            if statement is Stmt.VarDecl(var_name, var_type, var_value, var_line):
                # The ANNOTATION decides the local's type, and the initializer is emitted
                # at that type — so `a: u8 = 200` stores a real u8.
                declared_type: ValueType = annotation_value_type(var_type, structs)
                EmitStatus.Declined return if declared_type.kind == TypeKind.Unmodeled
                if emit_expression(var_value, declared_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is initial:
                    name_storage: mutable darray[u8] = []
                    slot: LLVMValueRef = LLVMBuildAlloca(builder, llvm_type_of(declared_type, structs, ctx), sview_to_cstr(var_name, name_storage))
                    _ = LLVMBuildStore(builder, initial, slot)
                    declare_local(local_scope, var_name, slot, declared_type)
                    return EmitStatus.Open
                return EmitStatus.Declined

            # `x <- value`. `<-` is Elisa's ASSIGNMENT operator; `=` is DECLARATION
            # (`x: T = v`, or bare `x = v` which stage0 lowers to a fresh VarDeclStmt —
            # `x = 42` after `x: i64 = 1` is "duplicate local", not a store). stage1's
            # parser currently folds BOTH `<-` and `=` into Stmt.Assign, so the operator
            # must be checked here: modeling `=` as a store would silently contradict
            # stage0, where `i = i + 1` in a loop body declares a fresh shadow and the
            # outer `i` never moves (an infinite loop, no diagnostic — observed).
            # Compound assignment (`+=`) and non-ident targets also decline.
            if statement is Stmt.Assign(assign_target, assign_operator, assign_value, assign_line):
                # `x op= v` is exactly `x <- x op v`: load, apply, store.
                compound: TokenKind = compound_operator_of(assign_operator)
                if compound != TokenKind.Eof:
                    if assign_target is Expr.Ident(compound_name, compound_name_line):
                        if lookup_slot(local_scope, compound_name) is compound_slot:
                            target_type: ValueType = lookup_type(local_scope, compound_name)
                            if emit_expression(assign_value, target_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is operand:
                                current: LLVMValueRef = LLVMBuildLoad2(builder, llvm_type_of(target_type, structs, ctx), compound_slot, "aug.load")
                                if emit_binary(compound, current, operand, target_type, structs, ctx, builder) is combined:
                                    _ = LLVMBuildStore(builder, combined, compound_slot)
                                    return EmitStatus.Open
                    return EmitStatus.Declined
                # `p.x <- v` — a field assignment: address, then store. Goes through
                # struct_address_of, so it works identically for a local struct and for a
                # `mutable P&` parameter (the ref just adds one load).
                if assign_target is Expr.Field(assign_object, assign_field, assign_field_line):
                    EmitStatus.Declined return if assign_operator != TokenKind.LArrow
                    if assign_object is Expr.Ident(assign_object_name, assign_object_name_line):
                        assign_struct_type: ValueType = struct_type_of_name(assign_object_name, local_scope, structs)
                        EmitStatus.Declined return if assign_struct_type.kind != TypeKind.Struct
                        assign_struct_slot: usize = assign_struct_type.bits.usize()
                        field_position: i64 = field_index_of(structs, assign_struct_slot, assign_field)
                        EmitStatus.Declined return if field_position < 0
                        if struct_address_of(assign_object_name, local_scope, structs, ctx, builder) is assign_address:
                            assign_field_type: ValueType = structs.field_types[structs.field_start[assign_struct_slot] + field_position.usize()]
                            field_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, llvm_type_of(assign_struct_type, structs, ctx), assign_address, field_position.u32(), "field.ptr")
                            if emit_expression(assign_value, assign_field_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is field_value:
                                _ = LLVMBuildStore(builder, field_value, field_pointer)
                                return EmitStatus.Open
                    return EmitStatus.Declined

                # `xs[i] <- v` — an index assignment: address, then store. Only a plain
                # `<-` to a local array is modeled (a compound `xs[i] += v` would need the
                # address computed once and reused, which is a separate lowering).
                if assign_target is Expr.Index(assign_array, assign_index, assign_index_line):
                    EmitStatus.Declined return if assign_operator != TokenKind.LArrow
                    if assign_array is Expr.Ident(assign_array_name, assign_array_name_line):
                        assign_array_type: ValueType = lookup_type(local_scope, assign_array_name)
                        if lookup_slot(local_scope, assign_array_name) is darray_assign_slot:
                            if assign_array_type.kind == TypeKind.DArray:
                                if emit_darray_index_address(darray_assign_slot, assign_array_type, assign_index, local_scope, fns, structs, generics, runtime, m, ctx, builder) is darray_element_pointer:
                                    darray_assign_element: ValueType = darray_element_of(assign_array_type, structs)
                                    if emit_expression(assign_value, darray_assign_element, local_scope, fns, structs, generics, runtime, m, ctx, builder) is darray_assigned:
                                        _ = LLVMBuildStore(builder, darray_assigned, darray_element_pointer)
                                        return EmitStatus.Open
                                return EmitStatus.Declined
                        EmitStatus.Declined return if assign_array_type.kind != TypeKind.Array
                        if lookup_slot(local_scope, assign_array_name) is assign_array_slot:
                            if emit_index_address(assign_array_slot, assign_array_type, assign_index, local_scope, fns, structs, generics, runtime, m, ctx, builder) is element_pointer:
                                element_type: ValueType = array_element_of(assign_array_type, structs)
                                if emit_expression(assign_value, element_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is element_value:
                                    _ = LLVMBuildStore(builder, element_value, element_pointer)
                                    return EmitStatus.Open
                    return EmitStatus.Declined

                EmitStatus.Declined return if assign_operator != TokenKind.LArrow
                if assign_target is Expr.Ident(target_name, target_line):
                    slot_opt: LLVMValueRef? = lookup_slot(local_scope, target_name)
                    if slot_opt is slot:
                        new_value: LLVMValueRef? = emit_expression(assign_value, lookup_type(local_scope, target_name), local_scope, fns, structs, generics, runtime, m, ctx, builder)
                        if new_value is assigned:
                            _ = LLVMBuildStore(builder, assigned, slot)
                            return EmitStatus.Open
                return EmitStatus.Declined

            if statement is Stmt.If(if_condition, then_body, else_body, if_line):
                condition_opt: LLVMValueRef? = emit_condition(if_condition, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                if condition_opt is condition_bit:
                    function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                    then_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "if.then")
                    else_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "if.else")
                    join_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "if.join")
                    _ = LLVMBuildCondBr(builder, condition_bit, then_block, else_block)

                    LLVMPositionBuilderAtEnd(builder, then_block)
                    then_status: EmitStatus = emit_statements(then_body, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)
                    EmitStatus.Declined return if then_status == EmitStatus.Declined
                    branch_if_open(then_status, builder, join_block)

                    LLVMPositionBuilderAtEnd(builder, else_block)
                    else_status: EmitStatus = emit_statements(else_body, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)
                    EmitStatus.Declined return if else_status == EmitStatus.Declined
                    branch_if_open(else_status, builder, join_block)

                    LLVMPositionBuilderAtEnd(builder, join_block)
                    # Both arms returned: the join is unreachable. It still needs a
                    # terminator or the module is invalid, and the `if` as a whole has
                    # ended the block.
                    if then_status == EmitStatus.Terminated and else_status == EmitStatus.Terminated:
                        _ = LLVMBuildUnreachable(builder)
                        return EmitStatus.Terminated
                    return EmitStatus.Open
                return EmitStatus.Declined

            if statement is Stmt.While(while_condition, while_body, while_line):
                function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                head_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "while.head")
                body_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "while.body")
                exit_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "while.exit")

                # The condition is re-evaluated each iteration, so it lives in its own
                # block that the body branches back to.
                _ = LLVMBuildBr(builder, head_block)
                LLVMPositionBuilderAtEnd(builder, head_block)
                condition_opt: LLVMValueRef? = emit_condition(while_condition, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                if condition_opt is condition_bit:
                    _ = LLVMBuildCondBr(builder, condition_bit, body_block, exit_block)
                    LLVMPositionBuilderAtEnd(builder, body_block)
                    # A `while` continues to its CONDITION.
                    loops.exits <- loops.exits.push(exit_block)
                    loops.continues <- loops.continues.push(head_block)
                    body_status: EmitStatus = emit_statements(while_body, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)
                    _ = loops.exits.pop()
                    _ = loops.continues.pop()
                    EmitStatus.Declined return if body_status == EmitStatus.Declined
                    # A body that returned does not loop back.
                    branch_if_open(body_status, builder, head_block)
                    # The loop may always exit via the condition, so the exit block is
                    # reachable and OPEN regardless of what the body did.
                    LLVMPositionBuilderAtEnd(builder, exit_block)
                    return EmitStatus.Open
                return EmitStatus.Declined

            # `break` / `continue`. A LABEL is not modeled (the subset has no labelled
            # loops), and neither is a `break` outside any loop — an empty stack declines
            # rather than emitting a branch to nowhere.
            if statement is Stmt.Break(break_label, break_line):
                EmitStatus.Declined return if break_label != ""
                EmitStatus.Declined return if loops.exits.count == 0
                _ = LLVMBuildBr(builder, loops.exits[loops.exits.count - 1])
                return EmitStatus.Terminated

            if statement is Stmt.Continue(continue_label, continue_line):
                EmitStatus.Declined return if continue_label != ""
                EmitStatus.Declined return if loops.continues.count == 0
                _ = LLVMBuildBr(builder, loops.continues[loops.continues.count - 1])
                return EmitStatus.Terminated

            # `for i in a..<b:` / `for i in a..=b:` over an integer range. Only the range
            # forms are modeled: iterating a container needs the container ABI.
            #
            # Lowered as: i = a; head: i < b ? body : exit; body -> step: i = i + 1 -> head.
            # The increment lives in its OWN block so `continue` can target it — jumping
            # straight back to the head would skip the step and spin forever.
            if statement is Stmt.For(for_bind, for_variables, for_iterable, for_body, for_line):
                # `bind` is a MODIFIER ("parallel" / "mutable" / ""), NOT the loop
                # variable — the names live in `variables`. Only the plain single-variable
                # form is modeled; `for parallel …` and `for k, v in …` decline.
                EmitStatus.Declined return if for_bind != ""
                EmitStatus.Declined return if for_variables.count != 1
                for_variable: sview = for_variables[0]
                if for_iterable is Expr.Binary(range_low, range_operator, range_high, range_line):
                    inclusive: bool = range_operator == TokenKind.RangeLe
                    EmitStatus.Declined return if range_operator != TokenKind.RangeLt and not inclusive

                    # The loop variable's type comes from the range bounds; a bare
                    # `0..<10` is two literals, so it defaults to signed 64.
                    loop_type: ValueType = resolve_type(range_low, resolve_type(range_high, ValueType{kind: TypeKind.Signed, bits: 64}, local_scope, fns, structs, generics), local_scope, fns, structs, generics)
                    EmitStatus.Declined return if not is_integer_type(loop_type)
                    low_opt: LLVMValueRef? = emit_expression(range_low, loop_type, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                    high_opt: LLVMValueRef? = emit_expression(range_high, loop_type, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                    if low_opt is low_value:
                        if high_opt is high_value:
                            name_storage: mutable darray[u8] = []
                            slot: LLVMValueRef = LLVMBuildAlloca(builder, int64_type, sview_to_cstr(for_variable, name_storage))
                            _ = LLVMBuildStore(builder, low_value, slot)
                            declare_local(local_scope, for_variable, slot, loop_type)

                            function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                            head_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "for.head")
                            body_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "for.body")
                            step_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "for.step")
                            exit_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "for.exit")

                            _ = LLVMBuildBr(builder, head_block)
                            LLVMPositionBuilderAtEnd(builder, head_block)
                            loop_llvm_type: LLVMTypeRef = llvm_type_of(loop_type, structs, ctx)
                            counter: LLVMValueRef = LLVMBuildLoad2(builder, loop_llvm_type, slot, "for.i")
                            # 41 = SLE (`..=`), 40 = SLT (`..<`).
                            signed_predicate: i32 = 41 if inclusive else 40
                            predicate: i32 = unsigned_predicate_of(signed_predicate) if loop_type.kind == TypeKind.Unsigned else signed_predicate
                            keep_going: LLVMValueRef = LLVMBuildICmp(builder, predicate, counter, high_value, "for.cmp")
                            _ = LLVMBuildCondBr(builder, keep_going, body_block, exit_block)

                            LLVMPositionBuilderAtEnd(builder, body_block)
                            loops.exits <- loops.exits.push(exit_block)
                            loops.continues <- loops.continues.push(step_block)
                            body_status: EmitStatus = emit_statements(for_body, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)
                            _ = loops.exits.pop()
                            _ = loops.continues.pop()
                            EmitStatus.Declined return if body_status == EmitStatus.Declined
                            branch_if_open(body_status, builder, step_block)

                            LLVMPositionBuilderAtEnd(builder, step_block)
                            stepped: LLVMValueRef = LLVMBuildAdd(builder, LLVMBuildLoad2(builder, loop_llvm_type, slot, "for.cur"), LLVMConstInt(loop_llvm_type, 1, 0), "for.next")
                            _ = LLVMBuildStore(builder, stepped, slot)
                            _ = LLVMBuildBr(builder, head_block)

                            LLVMPositionBuilderAtEnd(builder, exit_block)
                            return EmitStatus.Open
                return EmitStatus.Declined

            return EmitStatus.Declined


        # A function declaration's name, or "" for any other declaration. (Only reached
        # after declare_function accepted, i.e. it IS a Func.)
        # A function declaration's name, or "" for anything else (a struct, an enum, an
        # extern). Used to skip non-function declarations in the function passes.
        def function_name_of(declaration: Decl) -> sview can[Abort.Panic]:
            if declaration is Decl.Func(function_name, params, return_type_opt, body, effects, decorators, line):
                return function_name
            return ""


        # Does `owner::name` take the implicit trailing arena parameter?
        def callee_needs_arena(fns: FnTable&, owner: sview, name: sview) -> bool can[Abort.Panic]:
            for index in 0..<fns.names.count |fns, owner, name|:
                fns.needs_arena[index] return if fns.names[index] == name and fns.owners[index] == owner
            return false


        # The index of function `owner::name` in the table, or -1.
        def function_index_of(fns: FnTable&, owner: sview, name: sview) -> i64 can[Abort.Panic]:
            for index in 0..<fns.names.count |fns, owner, name|:
                index.i64() return if fns.names[index] == name and fns.owners[index] == owner
            return -1


        # Register every generic function TEMPLATE in the file.
        def register_generics(file: Ast::File&, generics: mutable GenericTable&) -> void can[Abort.Panic, Memory.Allocate]:
            for declaration in file.top_decls |generics, file|:
                if declaration is Decl.Func(function_name, params, return_type_opt, body, effects, decorators, line):
                    start: usize = generics.params.count
                    for row in 0..<file.generic_param_lines.count |generics, file, line|:
                        # High bit set => a BOUND row (`[T: Ord]`), not a type parameter.
                        continue if file.generic_param_lines[row] >= 2147483648
                        continue if file.generic_param_lines[row] != line
                        generics.params <- generics.params.push(file.generic_param_names[row])
                    added: usize = generics.params.count - start
                    if added != 0:
                        generics.names <- generics.names.push(function_name)
                        generics.decls <- generics.decls.push(declaration)
                        generics.param_start <- generics.param_start.push(start)
                        generics.param_count <- generics.param_count.push(added)


        # The source-level spelling a type contributes to a mangled name. Must agree with
        # stage0's scheme (`identity__i64`), read from its emitted IR.
        def push_type_name(value_type: ValueType, storage: mutable darray[u8]&) -> void can[Abort.Panic, Memory.Allocate]:
            text: mutable sview = "unknown"
            if value_type.kind == TypeKind.Bool:
                text <- "bool"
            if value_type.kind == TypeKind.Float:
                text <- "f32" if value_type.bits == 32 else "f64"
            if value_type.kind == TypeKind.Signed:
                text <- "i8" if value_type.bits == 8 else ("i16" if value_type.bits == 16 else ("i32" if value_type.bits == 32 else "i64"))
            if value_type.kind == TypeKind.Unsigned:
                text <- "u8" if value_type.bits == 8 else ("u16" if value_type.bits == 16 else ("u32" if value_type.bits == 32 else "u64"))
            for index in 0..<sview_len(text) |storage, text|:
                storage.push(sview_at(text, index))


        # Build `identity` + i64 -> "identity__i64" into `storage`, NUL-terminated.
        #
        # The result is transient by design: LLVMAddFunction COPIES the name, so the buffer
        # can die immediately. Nothing keeps an sview to it — the instantiation cache is
        # keyed by (base, type), precisely so no name has to outlive this call.
        def mangled_name_into(base: sview, type_argument: ValueType, storage: mutable darray[u8]&) -> cstr can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            for index in 0..<sview_len(base) |storage, base|:
                storage.push(sview_at(base, index))
            storage.push(95)
            storage.push(95)
            push_type_name(type_argument, storage)
            storage.push(0)
            return (&storage[0]).cast[cstr] can Unsafe.PointerCast


        # Pass 1: create the NAMED (empty) LLVM type for a struct declaration and record
        # its name. Bodies are set separately so declaration order never matters.
        def register_struct_name(declaration: Decl, structs: mutable StructTable&, ctx: LLVMContextRef) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            if declaration is Decl.Struct(struct_name, members, affinity, has_named_states, has_derive, invariants, struct_line):
                name_storage: mutable darray[u8] = []
                handle: LLVMTypeRef = LLVMStructCreateNamed(ctx, sview_to_cstr(struct_name, name_storage))
                structs.names <- structs.names.push(struct_name)
                structs.handles <- structs.handles.push(handle)
                structs.field_start <- structs.field_start.push(0)
                structs.field_count <- structs.field_count.push(0)


        def const_index_of(structs: StructTable&, name: sview) -> i64 can[Abort.Panic]:
            index: mutable usize = 0
            while index < structs.const_names.count |index, structs, name|:
                index.i64() return if structs.const_names[index] == name
                index <- index + 1
            return -1


        # Register a global const's NAME and declared type; fold_consts fills in the value.
        # `const A: mutable i64 = 42` is accepted by stage0, so is_mutable is not a decline.
        def register_const(declaration: Decl, structs: mutable StructTable&) -> void can[Abort.Panic, Memory.Allocate]:
            if declaration is Decl.Const(const_name, const_type_expression, const_value, const_is_mutable, const_line):
                structs.const_names <- structs.const_names.push(const_name)
                structs.const_types <- structs.const_types.push(annotation_value_type(const_type_expression, structs))
                structs.const_values <- structs.const_values.push(0)
                structs.const_resolved <- structs.const_resolved.push(false)


        # Constant-FOLD an initializer to an integer. Only the forms stage0 itself calls a
        # "compile-time value" are modeled: literals, other consts, and integer arithmetic.
        # `ok` is false for anything else (a call, an unresolved const), which propagates
        # outward as a decline rather than a guessed value.
        def fold_const_expr(expression: Expr, structs: StructTable&, ok: mutable bool&) -> i64 can[Abort.Panic]:
            if expression is Expr.IntLit(literal_value):
                return literal_value
            if expression is Expr.Paren(paren_inner, paren_line):
                return fold_const_expr(paren_inner, structs, ok)
            if expression is Expr.Ident(ident_name, ident_line):
                const_index: i64 = const_index_of(structs, ident_name)
                if const_index >= 0 and structs.const_resolved[const_index.usize()]:
                    return structs.const_values[const_index.usize()]
                ok <- false
                return 0
            if expression is Expr.Unary(unary_operator, unary_operand, unary_line):
                operand_value: i64 = fold_const_expr(unary_operand, structs, ok)
                (0 - operand_value) return if unary_operator == TokenKind.Minus
                ok <- false
                return 0
            if expression is Expr.Binary(binary_left, binary_operator, binary_right, binary_line):
                left_value: i64 = fold_const_expr(binary_left, structs, ok)
                right_value: i64 = fold_const_expr(binary_right, structs, ok)
                # `not ok` directly on the `mutable bool&` param is rejected ("not operator
                # requires bool operand") — read it through a local first.
                operands_ok: bool = ok
                0 return if not operands_ok
                (left_value + right_value) return if binary_operator == TokenKind.Plus
                (left_value - right_value) return if binary_operator == TokenKind.Minus
                (left_value * right_value) return if binary_operator == TokenKind.Star
                if binary_operator == TokenKind.Slash:
                    # Folding a division by zero would invent a value for a program that has
                    # none; decline and let stage0's own diagnostic stand.
                    ok <- false if right_value == 0 else ok
                    0 return if right_value == 0
                    return left_value / right_value
                ok <- false
                return 0
            ok <- false
            return 0


        # Fold every global const to its value, iterating to a FIXPOINT so a const may
        # reference one declared LATER (stage0 accepts that). Each pass must resolve at
        # least one new const or nothing ever will, so `const_names.count` passes suffice.
        def fold_consts(file: Ast::File&, structs: mutable StructTable&) -> void can[Abort.Panic, Memory.Allocate]:
            pass_index: mutable usize = 0
            while pass_index < structs.const_names.count |pass_index, file, structs|:
                progressed: mutable bool = false
                for declaration in file.top_decls |progressed, structs|:
                    if declaration is Decl.Const(const_name, const_type_expression, const_value, const_is_mutable, const_line):
                        const_index: i64 = const_index_of(structs, const_name)
                        continue if const_index < 0
                        continue if structs.const_resolved[const_index.usize()]
                        folded_ok: mutable bool = true
                        folded: i64 = fold_const_expr(const_value, structs, folded_ok)
                        continue if not folded_ok
                        structs.const_values[const_index.usize()] <- folded
                        structs.const_resolved[const_index.usize()] <- true
                        progressed <- true
                break if not progressed
                pass_index <- pass_index + 1


        # Register an alias NAME with a placeholder type; resolve_aliases fills it in.
        def register_alias(declaration: Decl, structs: mutable StructTable&) -> void can[Abort.Panic, Memory.Allocate]:
            if declaration is Decl.Alias(alias_name, alias_target, alias_line):
                structs.alias_names <- structs.alias_names.push(alias_name)
                structs.alias_types <- structs.alias_types.push(unmodeled_type())


        # Resolve each alias to a concrete ValueType in DECLARATION ORDER, one pass.
        #
        # NOT a fixpoint: stage0 requires an alias's target to be already declared
        # (`type A = B` before `type B = i64` is "unknown type B" — verified), unlike
        # structs, which are order-free. Iterating to a fixpoint would resolve that forward
        # reference and make stage1 accept a program the reference compiler REJECTS — a
        # silent divergence, caught by a differential fixture that SKIPped.
        #
        # One in-order pass also subsumes the cycle guard: `type A = B` / `type B = A` never
        # resolves, stays Unmodeled, and declines rather than recursing forever.
        def resolve_aliases(file: Ast::File&, structs: mutable StructTable&) -> void can[Abort.Panic, Memory.Allocate]:
            for declaration in file.top_decls |structs|:
                if declaration is Decl.Alias(alias_name, alias_target, alias_line):
                    alias_index: i64 = alias_index_of(structs, alias_name)
                    continue if alias_index < 0
                    resolved: ValueType = annotation_value_type(alias_target, structs)
                    continue if resolved.kind == TypeKind.Unmodeled
                    structs.alias_types[alias_index.usize()] <- resolved


        def alias_index_of(structs: StructTable&, name: sview) -> i64 can[Abort.Panic]:
            index: mutable usize = 0
            while index < structs.alias_names.count |index, structs, name|:
                index.i64() return if structs.alias_names[index] == name
                index <- index + 1
            return -1


        def penum_index_of(structs: StructTable&, name: sview) -> i64 can[Abort.Panic]:
            index: mutable usize = 0
            while index < structs.penum_names.count |index, structs, name|:
                index.i64() return if structs.penum_names[index] == name
                index <- index + 1
            return -1


        # A variant's TAG is its index within its own enum's span, matching stage0, where the
        # tag compare is `icmp eq i32 %tag, <declaration ordinal>`. -1 when unknown.
        def penum_variant_index(structs: StructTable&, enum_index: i64, variant_name: sview) -> i64 can[Abort.Panic]:
            start: usize = structs.penum_variant_start[enum_index.usize()]
            count: usize = structs.penum_variant_count[enum_index.usize()]
            offset: mutable usize = 0
            while offset < count |offset, structs, start, variant_name|:
                offset.i64() return if structs.penum_variants[start + offset] == variant_name
                offset <- offset + 1
            return -1


        # Register a PAYLOAD-carrying enum as a tagged union. Only the subset stage0's layout
        # makes trivially reproducible is modeled: at most ONE payload field per variant, of a
        # scalar type. A multi-field or aggregate payload needs the widest-variant layout
        # computed the way stage0 computes it, and guessing it would silently misread every
        # payload -- so it declines by not registering, and every use then declines too.
        def register_payload_enum(declaration: Decl, packed_names: darray[sview]&, structs: mutable StructTable&) -> void can[Abort.Panic, Memory.Allocate]:
            if declaration is Decl.Enum(enum_name, variants, is_const, storage_type, enum_line):
                return if is_const
                return if variants.count == 0
                # A `packed enum` is NOT this representation: its values are HANDLES into an
                # AoS store (ctx_packed_store_*), not an inline `{i32, [N x i64]}`. Registering
                # one here emitted an inline tagged union for a program stage0 REJECTS
                # ("packed enum match over Node requires an in Node.Store clause") -- wrong
                # representation AND more permissive than the reference compiler. Decl.Enum
                # carries no packed flag; the names live in a parallel FILE side-table, which
                # is why this has to be passed in.
                for packed_name in packed_names |enum_name|:
                    return if packed_name == enum_name
                start: usize = structs.penum_variants.count
                declined: mutable bool = false
                widest: mutable u32 = 0
                for variant in variants |structs, declined, widest|:
                    declined <- true if variant.fields.count > 1
                    payload: mutable ValueType = unmodeled_type()
                    if variant.fields.count == 1:
                        payload <- annotation_value_type(variant.fields[0], structs)
                        # Only a scalar payload: it must fit the `[N x i64]` slot and be read
                        # back by a plain load at the payload pointer.
                        declined <- true if not is_numeric_type(payload) and payload.kind != TypeKind.Bool
                        widest <- 1 if widest == 0
                    structs.penum_variants <- structs.penum_variants.push(variant.name)
                    structs.penum_payloads <- structs.penum_payloads.push(payload)
                    structs.penum_has_payload <- structs.penum_has_payload.push(variant.fields.count == 1)
                if declined:
                    # Unregister: leave no half-built enum behind for a use site to find.
                    while structs.penum_variants.count > start |structs|:
                        _ = structs.penum_variants.pop()
                        _ = structs.penum_payloads.pop()
                        _ = structs.penum_has_payload.pop()
                    return
                structs.penum_names <- structs.penum_names.push(enum_name)
                structs.penum_variant_start <- structs.penum_variant_start.push(start)
                structs.penum_variant_count <- structs.penum_variant_count.push(variants.count)
                structs.penum_payload_words <- structs.penum_payload_words.push(widest)


        # Register a CONST enum: its backing scalar and its variants in declaration order
        # (the ordinal IS the variant's value). Only `const enum … of <scalar>` is modeled —
        # a payload-carrying enum is a packed AoS store, a different subsystem entirely.
        def register_enum(declaration: Decl, structs: mutable StructTable&) -> void can[Abort.Panic, Memory.Allocate]:
            if declaration is Decl.Enum(enum_name, variants, is_const, storage_type, enum_line):
                return if not is_const
                backing: ValueType = annotation_value_type(storage_type, structs)
                return if not is_integer_type(backing)
                start: usize = structs.enum_variants.count
                declined: mutable bool = false
                for variant in variants |structs, declined|:
                    # A variant with a PAYLOAD is not a const enum member.
                    declined <- true if variant.fields.count != 0
                    structs.enum_variants <- structs.enum_variants.push(variant.name)
                return if declined or variants.count == 0
                structs.enum_names <- structs.enum_names.push(enum_name)
                structs.enum_backings <- structs.enum_backings.push(backing)
                structs.enum_variant_start <- structs.enum_variant_start.push(start)
                structs.enum_variant_count <- structs.enum_variant_count.push(variants.count)


        # Pass 2: fill in a struct's field types and set its LLVM body. False = declined
        # (a field whose type is outside the modeled subset).
        #
        # Fields are emitted in DECLARATION ORDER, so a field's position is its LLVM
        # element index — which is what makes field_index_of usable directly in a GEP.
        def set_struct_body(declaration: Decl, structs: mutable StructTable&, ctx: LLVMContextRef) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            if declaration is Decl.Struct(struct_name, members, affinity, has_named_states, has_derive, invariants, struct_line):
                index: i64 = struct_index_of(structs, struct_name)
                false return if index < 0
                slot: usize = index.usize()

                element_types: mutable darray[LLVMTypeRef] = []
                declined: mutable bool = false
                start: usize = structs.field_names.count
                for member in members |element_types, declined, structs, ctx|:
                    member_type: ValueType = annotation_value_type(member.type_expression, structs)
                    if member_type.kind == TypeKind.Unmodeled or member_type.kind == TypeKind.Struct:
                        # A nested struct field would need the field's own layout resolved
                        # first; only scalar fields are modeled.
                        declined <- true
                    else:
                        element_types.push(llvm_type_of(member_type, structs, ctx))
                        structs.field_names <- structs.field_names.push(member.name)
                        structs.field_types <- structs.field_types.push(member_type)
                false return if declined
                false return if members.count == 0

                structs.field_start[slot] <- start
                structs.field_count[slot] <- members.count
                elements_pointer: void& = (&element_types[0]).cast[void&] can Unsafe.PointerCast
                LLVMStructSetBody(structs.handles[slot], elements_pointer, members.count.u32(), 0)
                return true
            return true


        # Declare `def name(a: T, …) -> R` in the module WITHOUT a body, recording its
        # types in `fns`. Null when the signature is outside the modeled subset.
        #
        # Signature types are REAL now: any modeled scalar width/signedness, not just i64.
        def declare_function(declaration: Decl, owner: sview, fns: mutable FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, m: LLVMModuleRef, ctx: LLVMContextRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            if declaration is Decl.Func(function_name, params, return_type_opt, body, effects, decorators, line):
                if return_type_opt is return_type:
                    return_value_type: ValueType = annotation_value_type(return_type, structs)
                    null return if return_value_type.kind == TypeKind.Unmodeled

                    llvm_param_types: mutable darray[LLVMTypeRef] = []
                    declared_param_types: mutable darray[ValueType] = []
                    declined: mutable bool = false
                    for parameter in params |llvm_param_types, declared_param_types, declined, ctx|:
                        parameter_type: ValueType = annotation_value_type(parameter.type_expression, structs)
                        if parameter_type.kind == TypeKind.Unmodeled:
                            declined <- true
                        else:
                            llvm_param_types.push(llvm_type_of(parameter_type, structs, ctx))
                            declared_param_types.push(parameter_type)
                    null return if declined

                    name_storage: mutable darray[u8] = []
                    fn_name: cstr = qualified_name_cstr(owner, function_name, name_storage)
                    # The implicit trailing arena parameter, if this signature needs one.
                    wants_arena: bool = signature_needs_arena(params, return_value_type, structs)
                    llvm_param_types.push(LLVMPointerTypeInContext(ctx, 0)) if wants_arena
                    total_params: usize = params.count + 1 if wants_arena else params.count
                    llvm_return: LLVMTypeRef = llvm_type_of(return_value_type, structs, ctx)
                    fn_type: mutable LLVMTypeRef = LLVMFunctionType(llvm_return, null, 0, 0)
                    if total_params != 0:
                        params_pointer: void& = (&llvm_param_types[0]).cast[void&] can Unsafe.PointerCast
                        fn_type <- LLVMFunctionType(llvm_return, params_pointer, total_params.u32(), 0)
                    handle: LLVMValueRef = LLVMAddFunction(m, fn_name, fn_type)

                    fns.names <- fns.names.push(function_name)
                    fns.owners <- fns.owners.push(owner)
                    fns.needs_arena <- fns.needs_arena.push(wants_arena)
                    fns.handles <- fns.handles.push(handle)
                    fns.returns <- fns.returns.push(return_value_type)
                    fns.param_start <- fns.param_start.push(fns.param_types.count)
                    fns.param_count <- fns.param_count.push(params.count)
                    for declared in declared_param_types |fns|:
                        fns.param_types <- fns.param_types.push(declared)
                    return handle
                return null
            return null


        # Emit the body of an already-declared function. False = declined.
        def emit_function_body(declaration: Decl, fn: LLVMValueRef, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            if declaration is Decl.Func(function_name, params, return_type_opt, body, effects, decorators, line):
                # From the ANNOTATION, not from `fns`: a generic TEMPLATE has no fns entry
                # (only its instantiations do), and with bindings active the annotation
                # already resolves `T` to this instantiation's concrete type.
                return_value_type: mutable ValueType = unmodeled_type()
                if return_type_opt is declared_return:
                    return_value_type <- annotation_value_type(declared_return, structs)
                false return if return_value_type.kind == TypeKind.Unmodeled
                entry: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, fn, "entry")
                LLVMPositionBuilderAtEnd(builder, entry)

                # This function's AUTO REGION — the first real piece of Elisa's region
                # model here. stage0 gives every function one: an Arena alloca, zeroed,
                # with strategy 2 (lazy, so an untouched region costs no syscall), which
                # backs any container the function builds and is arena_free'd on return.
                local_runtime: mutable Runtime = copied_runtime(runtime)
                # A function taking a growable container by reference grows the CALLER's
                # region, handed over as the implicit trailing parameter, rather than its
                # own: the container's backing outlives this call, so allocating it from a
                # region freed at return would hand the caller freed memory.
                threads_arena: bool = signature_needs_arena(params, return_value_type, structs)
                if threads_arena:
                    local_runtime.arena <- LLVMGetParam(fn, params.count.u32())
                    local_runtime.owns_arena <- false
                else:
                    arena_type: LLVMTypeRef = arena_llvm_type(ctx)
                    arena_slot: LLVMValueRef = LLVMBuildAlloca(builder, arena_type, "auto.region")
                    _ = LLVMBuildStore(builder, LLVMConstNull(arena_type), arena_slot)
                    strategy_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, arena_type, arena_slot, 3, "region.strategy")
                    _ = LLVMBuildStore(builder, LLVMConstInt(LLVMInt64TypeInContext(ctx), 2, 0), strategy_pointer)
                    local_runtime.arena <- arena_slot

                # Each parameter gets a slot too, so a parameter reads and assigns exactly
                # like a local and emit_expression's Ident path needs no param special
                # case. mem2reg removes the copy.
                local_scope: mutable Scope = Scope{names: [], slots: [], types: []}
                loops: mutable LoopStack = LoopStack{exits: [], continues: []}
                # The function's auto region is the outermost OWNED region — unless the arena
                # is threaded in, in which case it is the CALLER's and nothing here frees it,
                # so the stack stays empty.
                regions: mutable RegionStack = RegionStack{arenas: []}
                regions.arenas.push(local_runtime.arena) if not threads_arena
                parameter_index: mutable u32 = 0
                for parameter in params |local_scope, parameter_index, fn, ctx, builder|:
                    parameter_type: ValueType = annotation_value_type(parameter.type_expression, structs)
                    name_storage: mutable darray[u8] = []
                    slot: LLVMValueRef = LLVMBuildAlloca(builder, llvm_type_of(parameter_type, structs, ctx), sview_to_cstr(parameter.name, name_storage))
                    _ = LLVMBuildStore(builder, LLVMGetParam(fn, parameter_index), slot)
                    declare_local(local_scope, parameter.name, slot, parameter_type)
                    parameter_index <- parameter_index + 1

                body_status: EmitStatus = emit_statements(body, return_value_type, local_scope, loops, regions, fns, structs, generics, local_runtime, m, ctx, builder)
                false return if body_status == EmitStatus.Declined
                # A `-> void` function may legitimately run off the end: close it with
                # `ret void` (and free the region first, like any other return path). A
                # value-returning function that falls through is NOT modeled — rather than
                # invent a return value, decline; LLVM would reject the open block anyway.
                if body_status == EmitStatus.Open:
                    false return if return_value_type.kind != TypeKind.Void
                    emit_region_free(local_runtime, builder)
                    _ = LLVMBuildRetVoid(builder)
                    return true
                return true
            return false

        # Emit the body of one queued instantiation, with its type parameter BOUND for the
        # whole emission — so every `T` inside resolves to the concrete type.
        def emit_instantiation_body(index: usize, generics: mutable GenericTable&, fns: FnTable&, structs: mutable StructTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            base: sview = generics.pending_bases[index]
            type_argument: ValueType = copied_type(generics.pending_types[index])
            handle: LLVMValueRef = generics.pending_handles[index]
            template_index: i64 = generic_index_of(generics, base)
            false return if template_index < 0
            slot: usize = template_index.usize()

            structs.binding_names <- structs.binding_names.push(generics.params[generics.param_start[slot]])
            structs.binding_types <- structs.binding_types.push(copied_type(type_argument))
            emitted: bool = emit_function_body(generics.decls[slot], handle, fns, structs, generics, runtime, m, ctx, builder)
            _ = structs.binding_names.pop()
            _ = structs.binding_types.pop()
            return emitted


    public:

        # Emit every declaration in `file`. Returns the number emitted, or -1 if ANY
        # declaration was declined.
        #
        # All-or-nothing is the sound choice: a partially-emitted module is WORSE than no
        # module. If `main` is unmodeled but a helper emits, a count-based "did we emit
        # anything?" check reports success and hands back a module quietly missing the
        # program. Declining the whole module keeps "emitted" honest.
        #
        # TWO PASSES: declare every function before emitting any body, so a call to a
        # function defined LATER in the file still resolves. A one-pass emitter would
        # silently decline forward references, which stage0 accepts.
        #
        # Takes `file` BY REFERENCE, mirroring `Semantic::check(file: Ast::File&)` — the
        # AST is a large region-backed structure and there is no reason to copy it.
        #
        # `<-`, NOT `=`: inside a `for … |captures|:` loop a captured scalar must be
        # threaded with `<-`; a plain `=` compiles clean and silently does nothing.
        def emit_module(file: Ast::File&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            structs: mutable StructTable = StructTable{names: [], handles: [], field_names: [], field_types: [], field_start: [], field_count: [], array_elements: [], array_extents: [], darray_elements: [], ref_targets: [], optional_targets: [], enum_names: [], enum_backings: [], enum_variants: [], enum_variant_start: [], enum_variant_count: [], binding_names: [], binding_types: [], penum_names: [], penum_variants: [], penum_payloads: [], penum_has_payload: [], penum_variant_start: [], penum_variant_count: [], penum_payload_words: [], alias_names: [], alias_types: [], const_names: [], const_types: [], const_values: [], const_resolved: []}
            # The runtime is declared once per module; each function gets its own arena
            # value below (the `arena` field here is a placeholder until then).
            runtime: mutable Runtime = declare_runtime(m, ctx)
            generics: mutable GenericTable = new_generic_table()
            # Templates must be known before any body is emitted: a call decides between
            # "ordinary function" and "instantiate a generic" by looking here.
            register_generics(file, generics)
            fns: mutable FnTable = FnTable{names: [], owners: [], needs_arena: [], handles: [], returns: [], param_types: [], param_start: [], param_count: []}
            declined: mutable bool = false

            # THREE passes. Structs first: a function signature can name a struct, and a
            # struct field can name another struct, so every struct type must exist before
            # any signature is resolved. Named-empty-then-set-body (see llvm_c.elisa) is
            # what makes the field pass tolerate any declaration order.
            for declaration in file.top_decls |structs, ctx|:
                register_struct_name(declaration, structs, ctx)
                # Const enums resolve to a scalar, so they must be known before any
                # signature or field mentioning one is resolved.
                register_enum(declaration, structs)
                register_payload_enum(declaration, file.packed_enum_names, structs)
                register_alias(declaration, structs)
            # Aliases resolve AFTER struct names and enums (an alias may name either) and
            # BEFORE struct bodies (a field may be alias-typed).
            resolve_aliases(file, structs)
            # Consts are registered after aliases so a const may be alias-typed, and folded
            # in their own fixpoint pass.
            for declaration in file.top_decls |structs|:
                register_const(declaration, structs)
            fold_consts(file, structs)
            for declaration in file.top_decls |structs, declined, ctx|:
                declined <- true if not set_struct_body(declaration, structs, ctx) else declined
            -1 return if declined

            # Passes 3 and 4 cover FUNCTIONS only: a struct declaration emits no code of
            # its own (its type was built above), so it is skipped rather than declined.
            # The body pass looks its handle up by NAME — `fns` is no longer index-parallel
            # with `top_decls` now that non-function declarations exist.
            for declaration in file.top_decls |fns, declined, structs, generics, m, ctx|:
                # A MODULE's functions are declared under the module's name as their owner
                # (stage0 emits `module M: def get()` as `@M.get`). Without this a module's
                # functions were never declared at all and every qualified call declined.
                if declaration is Decl.Module(module_name, module_body, module_line):
                    for nested in module_body |fns, declined, structs, generics, m, ctx, module_name|:
                        continue if function_name_of(nested) == ""
                        continue if generic_index_of(generics, function_name_of(nested)) >= 0
                        if not (declare_function(nested, module_name, fns, structs, generics, m, ctx) is declared_nested_fn):
                            declined <- true
                    continue
                continue if function_name_of(declaration) == ""
                # A generic TEMPLATE has no code of its own — only its instantiations do —
                # so it is skipped here, not declined.
                continue if generic_index_of(generics, function_name_of(declaration)) >= 0
                # declare_function records the signature's types into `fns` itself.
                if not (declare_function(declaration, "", fns, structs, generics, m, ctx) is declared_fn):
                    declined <- true
            -1 return if declined

            emitted_count: mutable i64 = 0
            for declaration in file.top_decls |emitted_count, declined, fns, structs, m, ctx, builder|:
                if declaration is Decl.Module(module_name, module_body, module_line):
                    for nested in module_body |emitted_count, declined, fns, structs, m, ctx, builder, module_name|:
                        nested_name: sview = function_name_of(nested)
                        continue if nested_name == ""
                        continue if generic_index_of(generics, nested_name) >= 0
                        nested_index: i64 = function_index_of(fns, module_name, nested_name)
                        if nested_index < 0:
                            declined <- true
                            continue
                        nested_emitted: bool = emit_function_body(nested, fns.handles[nested_index.usize()], fns, structs, generics, runtime, m, ctx, builder)
                        emitted_count <- emitted_count + 1 if nested_emitted else emitted_count
                        declined <- true if not nested_emitted else declined
                    continue
                declaration_name: sview = function_name_of(declaration)
                continue if declaration_name == ""
                continue if generic_index_of(generics, declaration_name) >= 0
                handle_index: i64 = function_index_of(fns, "", declaration_name)
                if handle_index < 0:
                    declined <- true
                    continue
                emitted: bool = emit_function_body(declaration, fns.handles[handle_index.usize()], fns, structs, generics, runtime, m, ctx, builder)
                emitted_count <- emitted_count + 1 if emitted else emitted_count
                declined <- true if not emitted else declined
            -1 return if declined

            # Drain the instantiation worklist. A LOOP, not a single pass: emitting one
            # instantiation's body can request another (a generic calling a generic), which
            # appends to the queue while it is being drained.
            drained: mutable usize = 0
            while drained < generics.pending_bases.count |drained, generics, fns, structs, runtime, m, ctx, builder, declined, emitted_count|:
                if emit_instantiation_body(drained, generics, fns, structs, runtime, m, ctx, builder):
                    emitted_count <- emitted_count + 1
                else:
                    declined <- true
                drained <- drained + 1
            -1 return if declined
            return emitted_count
