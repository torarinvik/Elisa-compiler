# Stage1 backend — LLVM codegen (`module Backend`).
#
# The stage0 counterpart is compiler/src/backend/llvm_*.go (~54k lines of cgo). This is
# the spine of that port: it walks the stage1 AST and drives LLVM-C (see llvm_c.elisa).
#
# Sound SUBSET, mirroring how the frontend was ported: only firmly-modeled constructs
# emit. `emit_function` returns false for anything it does not model yet, so the driver
# can report an honest "unsupported" instead of emitting wrong code. Coverage grows one
# construct at a time, each with a compile-and-run fixture that asserts real behavior
# (an exit code / stdout), never just "it compiled".

include "../semantic/semantic.elisa"
include "llvm_c.elisa"
using Ast

module Backend:

    private:

        # LLVM-C takes NUL-terminated `const char*`, but an `sview` is a (ptr, len) view
        # into the source buffer with no terminator — taking `&view[0]` would hand LLVM a
        # string that runs to the end of the FILE. Copy the bytes and terminate.
        # `storage` is caller-owned on purpose: the returned pointer aliases it, so it
        # must outlive the LLVM call that consumes the name.
        def sview_to_cstr(name: sview, storage: mutable darray[u8]&) -> cstr can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            for index in 0..<sview_len(name) |storage|:
                storage.push(sview_at(name, index))
            storage.push(0)
            return (&storage[0]).cast[cstr] can Unsafe.PointerCast


        # An `i64` literal is the only value form the spine models. `null` means "not
        # modeled" and the caller must decline to emit.
        #
        # Returns a bare `LLVMValueRef?` rather than a `(value, ok)` pair: `null` already
        # carries "not modeled", so the companion flag was redundant.
        def emit_expression(expression: Expr, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic]:
            if expression is Expr.IntLit(literal_value):
                int64_type: LLVMTypeRef = LLVMInt64TypeInContext(ctx)
                # sign_extend=1: Elisa's `i64` is signed, so a negative literal must
                # sign-extend into LLVM's u64-shaped constant argument.
                return LLVMConstInt(int64_type, literal_value.u64(), 1)
            # `(inner)` is pure grouping — no value of its own.
            if expression is Expr.Paren(paren_inner, paren_line):
                return emit_expression(paren_inner, ctx, builder)
            if expression is Expr.Unary(unary_operator, unary_operand, unary_line):
                operand_value: LLVMValueRef? = emit_expression(unary_operand, ctx, builder)
                if operand_value is operand:
                    # Unary `+` is the identity; `-` negates. Anything else is unmodeled.
                    operand return if unary_operator == TokenKind.Plus
                    LLVMBuildNeg(builder, operand, "neg") return if unary_operator == TokenKind.Minus
                return null
            if expression is Expr.Binary(binary_left, binary_operator, binary_right, binary_line):
                left_value: LLVMValueRef? = emit_expression(binary_left, ctx, builder)
                right_value: LLVMValueRef? = emit_expression(binary_right, ctx, builder)
                if left_value is left:
                    if right_value is right:
                        return emit_binary(binary_operator, left, right, builder)
                return null
            return null


        # The signed-`i64` arithmetic operators. `null` = unmodeled, so a comparison or a
        # bitwise op still declines rather than silently emitting something wrong.
        #
        # SDiv/SRem (not UDiv/URem): the modeled subset is `i64`, which is signed. Elisa's
        # `%` follows LLVM's `srem` (sign of the DIVIDEND: -7 % 2 == -1), matching stage0,
        # which selects the same instruction for a signed operand type.
        def emit_binary(operator: TokenKind, left: LLVMValueRef, right: LLVMValueRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic]:
            LLVMBuildAdd(builder, left, right, "add") return if operator == TokenKind.Plus
            LLVMBuildSub(builder, left, right, "sub") return if operator == TokenKind.Minus
            LLVMBuildMul(builder, left, right, "mul") return if operator == TokenKind.Star
            LLVMBuildSDiv(builder, left, right, "div") return if operator == TokenKind.Slash
            LLVMBuildSRem(builder, left, right, "rem") return if operator == TokenKind.Percent
            return null

    public:

        # Emit every declaration in `file`. Returns the number emitted, or -1 if ANY
        # declaration was declined.
        #
        # All-or-nothing is the sound choice: a partially-emitted module is WORSE than no
        # module. If `main` is unmodeled but a helper emits, a count-based "did we emit
        # anything?" check reports success and hands back a module that is quietly missing
        # the program. Declining the whole module keeps "emitted" honest.
        #
        # Takes `file` BY REFERENCE, mirroring `Semantic::check(file: Ast::File&)` — the
        # AST is a large region-backed structure and there is no reason to copy it.
        #
        # `emitted_count <- …`, NOT `=`: inside a `for … |captures|:` loop a captured
        # scalar must be threaded with `<-`. A plain `=` compiles clean and silently does
        # nothing, so the count stays 0 and every emitted function looks unsupported.
        def emit_module(file: Ast::File&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            emitted_count: mutable i64 = 0
            declined: mutable bool = false
            for declaration in file.top_decls |emitted_count, declined, m, ctx, builder|:
                emitted: bool = emit_function(declaration, m, ctx, builder)
                emitted_count <- emitted_count + 1 if emitted else emitted_count
                declined <- true if not emitted else declined
            -1 return if declined
            return emitted_count


        # Emit one `def name() -> i64` whose body is a single `return <int literal>`.
        # Deliberately narrow: this is the vertical slice that proves the whole toolchain
        # (lex -> parse -> backend -> LLVM -> object -> link -> run), not a general emitter.
        # Returns false when the declaration is outside the modeled subset.
        def emit_function(declaration: Decl, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            if declaration is Decl.Func(function_name, params, return_type, body, effects, decorators, line):
                false return if params.count != 0
                false return if body.count != 1

                statement: Stmt = body[0]
                if statement is Stmt.Return(return_value_opt, return_line):
                    if return_value_opt is return_value:
                        emitted: LLVMValueRef? = emit_expression(return_value, ctx, builder)
                        if emitted is return_constant:
                            int64_type: LLVMTypeRef = LLVMInt64TypeInContext(ctx)
                            # A parameterless function: null params pointer, count 0.
                            fn_type: LLVMTypeRef = LLVMFunctionType(int64_type, null, 0, 0)
                            name_storage: mutable darray[u8] = []
                            fn_name: cstr = sview_to_cstr(function_name, name_storage)
                            fn: LLVMValueRef = LLVMAddFunction(m, fn_name, fn_type)
                            entry: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, fn, "entry")
                            LLVMPositionBuilderAtEnd(builder, entry)
                            _ = LLVMBuildRet(builder, return_constant)
                            return true
                return false
            # Not a function declaration (a struct/enum/extern/…): not modeled.
            return false
