# `module Backend` is assembled from self-describing parts: codegen_env.elisa is the
# canonical `module Backend:` (shared helpers and the type-interning tables), and each
# remaining file declares its own `extend Backend:` block with its own visibility section —
# so a file's module membership is visible in the file itself rather than encoded by this
# facade's include layout (mirrors parser.elisa / lexer.elisa).
#
# The stage0 counterpart is compiler/src/backend/llvm_*.go (~54k lines of cgo). This is the
# growing port of that: it walks the stage1 AST and drives LLVM-C (see llvm_c.elisa).
#
# Sound SUBSET, mirroring how the frontend was ported: only firmly-modeled constructs emit.
# Every emitter returns a "declined" signal for anything it does not model, and `emit_module`
# turns ANY decline into a whole-module decline, so the driver reports an honest UNSUPPORTED
# instead of handing back a module that is quietly missing code.

include "./codegen_env.elisa"
include "./codegen_annotation_types.elisa"
include "./codegen_type_tables.elisa"
include "./codegen_abi_facts.elisa"
include "./codegen_runtime_decl.elisa"
include "./codegen_scope.elisa"
include "./codegen_packed_meta.elisa"
include "./codegen_generic_call.elisa"
include "./codegen_clone.elisa"
include "./codegen_call.elisa"
include "./codegen_convert.elisa"
include "./codegen_container_ops.elisa"
include "./codegen_place.elisa"
include "./codegen_dispatch.elisa"
include "./codegen_expr_literals.elisa"
include "./codegen_expr_idents_binary.elisa"
include "./codegen_expr_binary_tail.elisa"
include "./codegen_expr_match_aggregates.elisa"
include "./codegen_expr_index_overload.elisa"
include "./codegen_expr_index_fields.elisa"
include "./codegen_expr_calls.elisa"
include "./codegen_condition.elisa"
include "./codegen_stmt_blocks_exprs.elisa"
