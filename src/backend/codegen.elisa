# Stage1 backend — LLVM codegen (`module Backend`).
#
# The stage0 counterpart is compiler/src/backend/llvm_*.go (~54k lines of cgo). This is
# the growing port of that: it walks the stage1 AST and drives LLVM-C (see llvm_c.elisa).
#
# Sound SUBSET, mirroring how the frontend was ported: only firmly-modeled constructs
# emit. Every emitter returns a "declined" signal for anything it does not model, and
# `emit_module` turns ANY decline into a whole-module decline, so the driver reports an
# honest UNSUPPORTED instead of handing back a module that is quietly missing code.
# Coverage grows one construct at a time, each with a compile-and-run fixture asserting
# real behavior (an exit code), plus a differential against stage0 where the reference
# compiler can compile the same source.
#
# Modeled today: `def f(a: i64, …) -> i64` over signed i64 — int literals, idents,
# `+ - * / %`, unary `+`/`-`, comparisons, parens, locals (`x: i64 = …`), assignment,
# `if`/`else`, `while`, `return`, and direct calls to other modeled functions.

include "../parser/parser.elisa"
include "llvm_c.elisa"
include "c_header.elisa"
include "easm_model.elisa"
using Ast

module Backend:

    private:

        # LLVM-C takes NUL-terminated `const char*`, but an `sview` is a (ptr, len) view
        # into the source buffer with no terminator — taking `&view[0]` would hand LLVM a
        # string that runs to the end of the FILE. Copy the bytes and terminate.
        # `storage` is caller-owned on purpose: the returned pointer aliases it, so it
        # must outlive the LLVM call that consumes the name.
        def sview_to_cstr(name: sview, storage: mutable darray[u8]&) -> cstr can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            for index in 0..<sview_len(name) |storage|:
                storage.push(sview_at(name, index))
            storage.push(0)
            return (&storage[0]).cast[cstr] can Unsafe.PointerCast


        # `-fnoalias` is an explicit opt-in in stage0 because an incorrect noalias
        # promise is a silent optimizer miscompile. The stage1 driver is itself a
        # native program, so mirror the CLI's process configuration through libc's
        # environment rather than changing the source-language ABI.
        def noalias_mutable_refs_enabled() -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            flag_storage: mutable darray[u8] = []
            flag_name: cstr = sview_to_cstr("ELISACORE_NOALIAS_MUTABLE_REFS", flag_storage)
            if getenv(flag_name) is real:
                return true
            return false


        # `-fbounds-check` is an opt-in debugging mode in stage0. Keep the switch in
        # the process environment so the self-hosted product and the stage0-seeded
        # driver use the same configuration path.
        def force_bounds_check_enabled() -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            flag_storage: mutable darray[u8] = []
            flag_name: cstr = sview_to_cstr("ELISACORE_FORCE_BOUNDS_CHECK", flag_storage)
            if getenv(flag_name) is real:
                return true
            return false


        # The INNER bytes of a string-literal pattern span, which arrives quote-INCLUSIVE
        # (`"yes"`) because a pattern literal keeps its raw source text. Strips the surrounding
        # double quotes and returns a NUL-terminated cstr of the content. Declines (null) on a
        # backslash: escape decoding would have to match stage0's exactly, so a `"a\n"` pattern
        # is left to decline rather than risk a mis-encoded compare.
        def string_pattern_content_cstr(text: sview, storage: mutable darray[u8]&) -> cstr? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            length: usize = sview_len(text)
            null return if length == 0
            # The span may or may not include the surrounding double quotes depending on how
            # the pattern lexer captured it; strip a matched pair when present.
            quoted: bool = length >= 2 and sview_at(text, 0) == 34 and sview_at(text, length - 1) == 34
            start: usize = 1 if quoted else 0
            stop: usize = length - 1 if quoted else length
            index: mutable usize = start
            while index < stop |storage, index|:
                byte: u8 = sview_at(text, index)
                null return if byte == 92
                storage.push(byte)
                index <- index + 1
            storage.push(0)
            return (&storage[0]).cast[cstr] can Unsafe.PointerCast


        # The LLVM SYMBOL name for `owner::name`: stage0 emits `module M: def get()` as
        # `define i64 @M.get` — DOT-separated, even though the call spelling is `M::get()`.
        # An empty owner is a top-level function and keeps its bare name.
        def qualified_name_cstr(owner: sview, name: sview, storage: mutable darray[u8]&) -> cstr can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            sview_to_cstr(name, storage) return if sview_len(owner) == 0
            for index in 0..<sview_len(owner) |storage|:
                storage.push(sview_at(owner, index))
            storage.push(46)
            for index in 0..<sview_len(name) |storage|:
                storage.push(sview_at(name, index))
            storage.push(0)
            return (&storage[0]).cast[cstr] can Unsafe.PointerCast


        # A modeled value's type. `bits` is the integer width; `Bool` is i1 (LLVM's
        # natural boolean) and carries no width of its own.
        #
        # Signedness is not cosmetic: stage0 lowers `u8 200 / 3` to `udiv` (66) and
        # `u8 200 >> 1` to `lshr` (100). Reading those as signed gives -56 and 228 — so a
        # backend that ignores signedness silently miscompiles unsigned arithmetic.
        const enum TypeKind of u8:
            Unmodeled
            Signed
            Unsigned
            Bool
            Float
            # `void` — legal ONLY as a return type. It has no values, so nothing can be a
            # `void` local, parameter, or operand; every other position rejects it because
            # `unmodeled_type()` is what those paths test for and Void is not that.
            Void
            # A user struct. `bits` is its index in the StructTable — a ValueType must stay
            # POD (an sview name would be fine, but an index also gives O(1) field lookup).
            Struct
            # A fixed array `T[N]`. `bits` indexes the StructTable's ARRAY side-pool
            # (`array_elements` / `array_extents`) — same reason as Struct: ValueType is
            # POD, so a nested element type cannot live inline.
            Array
            # A `packed enum`'s HANDLE. Same `{i32, [N x i64]}` shape as a payload enum, but
            # the value is a row in an AoS store rather than inline data: the tag and payload
            # are read back through ctx_packed_store_* rather than by extractvalue/GEP.
            # `bits` indexes the PACKED side-pool.
            PackedEnum
            # `Node.Store[Local]` — `{ptr arena, i64 row_bytes, ptr state}`. `bits` indexes
            # the PACKED side-pool of the enum it stores.
            PackedStore
            # `Arena` — the runtime's region carrier, `{ptr, ptr, i64, i64}`, passed BY
            # VALUE (stage0: `define i64 @build(%Arena %0)` and `%r1 = load %Arena, ptr %r`
            # at the call site). Note the asymmetry: `Arena` is legal as a PARAMETER type
            # but rejected as a region ANNOTATION (`-> darray[i64] @owner` is "internal
            # runtime carrier type ... not supported in user-facing code").
            Arena
            # A PAYLOAD-carrying enum (`enum Shape: Circle(r: i64)`). In LLVM a TAGGED UNION
            # `{ i32, [N x i64] }`: field 0 is the variant ORDINAL, field 1 is payload
            # storage sized to the largest variant (stage0's `%Shape = type { i32, [1 x
            # i64] }`, read from its IR). NOT the AoS packed store -- that is `packed enum`,
            # a different subsystem. `bits` indexes the PAYLOAD-ENUM side-pool.
            PayloadEnum
            # `cstr` — a NUL-terminated string constant. In LLVM just a `ptr`: stage0
            # lowers `s: cstr = "hi"` to `@str = private unnamed_addr constant [3 x i8]
            # c"hi\00"` plus `store ptr @str`. Carries no length, so `.count`, indexing and
            # comparison are NOT modeled (they need the runtime) and decline.
            CStr
            # A reference `T&` / `mutable T&`. `bits` indexes the REF side-pool
            # (`ref_targets`). In LLVM it is just a `ptr` — stage0 lowers
            # `def bump(n: mutable i64&)` to `define void @bump(ptr)` and `bump(x)` to
            # `call void @bump(ptr %x)`. Mutability is a FRONTEND concern (it already
            # rejects writes through a `T&`), so the backend models only the referent.
            Ref
            # An optional `T?`. `bits` indexes the OPTIONAL side-pool (`optional_targets`).
            # Represented exactly as stage0 does — `{i1 has_value, T value}` (read from its
            # `-emit llvm`: `%Optional__i64 = type { i1, i64 }`).
            Optional
            # A value-carrying `T error[E]`. `bits` indexes the ERROR-UNION side-pools;
            # LLVM uses stage0's `{i32 error_code, ptr payload}` descriptor.
            ErrorUnion
            # A `darray[T]`. `bits` indexes the DARRAY side-pool (`darray_elements`).
            # Represented exactly as stage0 does — `{ptr items, i64 count, i64 capacity}`,
            # backed by an Arena — because both link the SAME runtime, so the layout is
            # dictated, not chosen.
            DArray
            # A `view[T]` — the runtime's `DynArrayView` fat pointer `{data, len}`. `bits`
            # indexes the VIEW side-pool (`view_elements`), carrying the phantom element T
            # so a generic call like `arena_da_fill(view, …)` can INFER T from the argument.
            # Lowers to the one `DynArrayView` struct regardless of T (like darray).
            View
            # `sview` — a string VIEW, stage0's `%StringView = type { ptr, i64 }` (a byte
            # pointer plus a length). Distinct from `cstr` (bare `ptr`, NUL-terminated) and
            # from `view[T]` (DynArrayView). A literal `s: sview = "hi"` is the aggregate
            # `{ptr @str, i64 2}`; equality goes through `ctx_string_views_eq` BY VALUE.
            SView
            # `fn(A, …) -> R` — a first-class function value. Represented as stage0 does: a
            # low-bit-TAGGED `ptr`. Bit0 clear = a raw function pointer (`@f`), called directly;
            # bit0 set = points (after `& ~1`) at an `%ElisaCoreLambdaClosure = {ptr code, ptr
            # env}`, called `code(env, args…)`. The result type at a call site comes from the
            # EXPECTED type (a `return f(x)` / `y: R = f(x)` supplies it), so `bits` is unused.
            Fn
            # `GuestVAddr[L]` / `HostPtr[T]` address-space carriers (docs/107). ABI storage is
            # `i64`/`uintptr`; `bits` indexes `guest_layouts` with the layout/pointee name so
            # overlay accessors can resolve field offsets. HostPtr uses the same kind because
            # both are raw address integers at the LLVM boundary.
            GuestCarrier


        struct ValueType:
            kind: TypeKind
            bits: u32

        # The `{value, overflow}` result returned by LLVM's checked integer intrinsics.
        # Stage0 uses these for every allocation-size multiplication and for darray capacity
        # growth; keeping the pair explicit lets the stage1 emitter choose between trapping
        # and the safe-capacity fallback without silently dropping the flag.
        struct OverflowResult:
            value: LLVMValueRef
            overflow: LLVMValueRef


        def unmodeled_type() -> ValueType:
            return ValueType{kind: TypeKind.Unmodeled, bits: 0}


        def is_integer_type(value_type: ValueType) -> bool:
            return value_type.kind == TypeKind.Signed or value_type.kind == TypeKind.Unsigned


        # The i1 test for a `Pattern.Range` arm (`lo..<hi` / `lo..=hi`) over an INTEGER
        # scrutinee: `scrutinee >= lo AND scrutinee </<= hi`. Signed/unsigned drives the
        # predicate (a u8 range must compare with U* predicates). Returns null when either
        # bound is not an integer literal (e.g. a char-literal range) so the caller declines.
        # LLVM IntPredicate: UGE=35 ULT=36 ULE=37 SGE=39 SLT=40 SLE=41.
        def emit_range_test(scrutinee: LLVMValueRef, scrutinee_type: ValueType, lo_text: sview, hi_text: sview, inclusive: bool, compare_type: LLVMTypeRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic]:
            lo_value: mutable i64 = 0
            hi_value: mutable i64 = 0
            null return if not parse_pattern_scalar(lo_text, lo_value)
            null return if not parse_pattern_scalar(hi_text, hi_value)
            unsigned: bool = scrutinee_type.kind == TypeKind.Unsigned
            lo_pred: u32 = 35 if unsigned else 39
            hi_pred: mutable u32 = 40
            hi_pred <- 41 if inclusive
            if unsigned:
                hi_pred <- 37 if inclusive else 36
            lo_hit: LLVMValueRef = LLVMBuildICmp(builder, lo_pred, scrutinee, LLVMConstInt(compare_type, lo_value.u64(), 1), "range.lo")
            hi_hit: LLVMValueRef = LLVMBuildICmp(builder, hi_pred, scrutinee, LLVMConstInt(compare_type, hi_value.u64(), 1), "range.hi")
            return LLVMBuildAnd(builder, lo_hit, hi_hit, "range.in")


        # The i1 test for ONE simple, binding-free arm pattern against an already-lowered
        # `scrutinee` (a raw integer, or a payload-enum's extracted i32 tag when `penum`).
        # Handles integer/const-enum-ordinal literals, field-less variant paths, and integer
        # ranges — the sub-patterns an OR-pattern (`0 | 2 | 4`, `E.A | E.B`) is built from.
        # Returns null for anything with a binding or payload (an OR alternative cannot bind).
        def emit_simple_pattern_hit(pattern: Pattern, scrutinee: LLVMValueRef, scrutinee_type: ValueType, penum: bool, compare_type: LLVMTypeRef, structs: mutable StructTable&, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic]:
            if pattern is Pattern.Literal(literal_text):
                literal_value: mutable i64 = 0
                null return if not parse_pattern_scalar(literal_text, literal_value)
                return LLVMBuildICmp(builder, 32, scrutinee, LLVMConstInt(compare_type, literal_value.u64(), 1), "or.cmp")
            if pattern is Pattern.Variant(variant_path, variant_fields):
                null return if variant_fields.count != 0
                ordinal: mutable i64 = penum_variant_index_of_path(variant_path, structs) if penum else ordinal_of_dotted_path(variant_path, structs)
                null return if ordinal < 0
                return LLVMBuildICmp(builder, 32, scrutinee, LLVMConstInt(compare_type, ordinal.u64(), 1), "or.cmp")
            if pattern is Pattern.Range(range_lo, range_hi, range_inclusive):
                null return if penum
                return emit_range_test(scrutinee, scrutinee_type, range_lo, range_hi, range_inclusive, compare_type, ctx, builder)
            return null


        # The combined i1 test for an OR-pattern's option list: hit if ANY option hits.
        # Returns null if any option is not a simple binding-free pattern.
        def emit_or_pattern_hit(options: darray[Pattern], scrutinee: LLVMValueRef, scrutinee_type: ValueType, penum: bool, compare_type: LLVMTypeRef, structs: mutable StructTable&, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate]:
            null return if options.count == 0
            combined: mutable LLVMValueRef = zeroed
            have: mutable bool = false
            failed: mutable bool = false
            for option in options |combined, have, failed, scrutinee, scrutinee_type, penum, compare_type, structs, ctx, builder|:
                continue if failed
                if emit_simple_pattern_hit(option, scrutinee, scrutinee_type, penum, compare_type, structs, ctx, builder) is option_hit:
                    combined <- option_hit if not have
                    combined <- LLVMBuildOr(builder, combined, option_hit, "or.any") if have
                    have <- true
                else:
                    failed <- true
            null return if failed or not have
            return combined


        def is_numeric_type(value_type: ValueType) -> bool:
            return is_integer_type(value_type) or value_type.kind == TypeKind.Float


        # Whether the type lowers to an LLVM `ptr` — a reference or a cstr. Used to keep a
        # `.cast[T]` reinterpret to the pointer<->pointer no-op the std alloc helpers need.
        def type_is_pointer(value_type: ValueType) -> bool:
            return value_type.kind == TypeKind.Ref or value_type.kind == TypeKind.CStr


        # The named scalar types the backend models. Anything else (f32/f64, containers,
        # user types) yields Unmodeled and DECLINES rather than being guessed at.
        #
        # `int` is stage0's signed 64-bit default; `usize` is pointer-width (64 here — the
        # port targets arm64/x86-64, and a 32-bit target would need this to follow the
        # target triple).
        def scalar_type_of_name(name: sview) -> ValueType:
            ValueType{kind: TypeKind.CStr, bits: 0} return if name == "cstr"
            ValueType{kind: TypeKind.SView, bits: 0} return if name == "sview"
            ValueType{kind: TypeKind.Signed, bits: 8} return if name == "i8"
            ValueType{kind: TypeKind.Signed, bits: 16} return if name == "i16"
            ValueType{kind: TypeKind.Signed, bits: 32} return if name == "i32"
            # `isize` is the signed pointer-width counterpart of `usize` and is used by
            # the portable runtime's sysconf/ callback seams.
            ValueType{kind: TypeKind.Signed, bits: 64} return if name == "i64" or name == "int" or name == "isize"
            ValueType{kind: TypeKind.Unsigned, bits: 8} return if name == "u8"
            ValueType{kind: TypeKind.Unsigned, bits: 16} return if name == "u16"
            ValueType{kind: TypeKind.Unsigned, bits: 32} return if name == "u32"
            ValueType{kind: TypeKind.Unsigned, bits: 64} return if name == "u64" or name == "usize" or name == "uintptr"
            ValueType{kind: TypeKind.Bool, bits: 1} return if name == "bool"
            # stage0 lowers `char` to i64 (`define i64 @f(i64)`, `icmp eq i64`) — a full-width
            # signed scalar, not a byte. Model it identically so char arithmetic/compares work.
            ValueType{kind: TypeKind.Signed, bits: 64} return if name == "char"
            ValueType{kind: TypeKind.Float, bits: 32} return if name == "f32"
            ValueType{kind: TypeKind.Float, bits: 64} return if name == "f64"
            ValueType{kind: TypeKind.Void, bits: 0} return if name == "void"
            return unmodeled_type()


        # LLVM-C exposes opaque handle typedefs as pointer-sized values. They are declared
        # as bare extern names in llvm_c.elisa, so resolve them explicitly while registering
        # aggregate fields as well as function parameters; waiting for the extern declaration
        # pass leaves fields such as `Scope.slots: darray[LLVMValueRef]` unmodeled.
        def llvm_opaque_handle_name(name: sview) -> bool:
            return name == "LLVMContextRef" or name == "LLVMModuleRef" or name == "LLVMTypeRef" or name == "LLVMValueRef" or name == "LLVMBuilderRef" or name == "LLVMBasicBlockRef" or name == "LLVMTargetRef" or name == "LLVMTargetMachineRef" or name == "LLVMTargetDataRef" or name == "LLVMMetadataRef" or name == "LLVMAttributeRef" or name == "LLVMDIBuilderRef" or name == "LLVMDbgRecordRef" or name == "LLVMPassBuilderOptionsRef"


        # What `name` is bound to in the CURRENT instantiation, or Unmodeled if it is not a
        # type parameter (i.e. it is an ordinary type name).
        def bound_type_of(structs: mutable StructTable&, name: sview) -> ValueType can[Abort.Panic]:
            # Scan most-recent-first so an inner instantiation's binding shadows an outer
            # one that reuses the same parameter name (`DictBucket[K, T]` nested inside
            # `DynDict[K, T]`). For a single instantiation there are no duplicates, so this
            # is identical to a forward scan.
            count: usize = structs.binding_names.count
            for offset in 0..<count |structs, name, count|:
                index: usize = count - 1 - offset
                copied_type(structs.binding_types[index]) return if structs.binding_names[index] == name
            return unmodeled_type()


        # The return type of generic `base` instantiated at `type_argument`: its return
        # annotation resolved under that binding.
        def generic_return_type(base: sview, type_args: darray[ValueType]&, generics: mutable GenericTable&, structs: mutable StructTable&) -> ValueType can[Abort.Panic, Memory.Allocate]:
            index: i64 = generic_index_of(generics, base)
            unmodeled_type() return if index < 0
            return generic_return_type_at(index.usize(), type_args, generics, structs)


        def generic_return_type_at(slot: usize, type_args: darray[ValueType]&, generics: mutable GenericTable&, structs: mutable StructTable&) -> ValueType can[Abort.Panic, Memory.Allocate]:
            unmodeled_type() return if slot >= generics.names.count
            unmodeled_type() return if generics.param_count[slot] != type_args.count
            if generics.decls[slot] is Decl.Func(function_name, params, return_type_opt, body, effects, decorators, line):
                # A missing return annotation is `void` — so a call to it names its result ""
                # (LLVM rejects a named void instruction).
                resolved: mutable ValueType = ValueType{kind: TypeKind.Void, bits: 0}
                if return_type_opt is declared_return:
                    bound: usize = push_type_bindings(generics, structs, slot, type_args)
                    resolved <- annotation_value_type(declared_return, structs)
                    pop_type_bindings(structs, bound)
                return resolved
            return unmodeled_type()


        # The type an annotation denotes. Only a bare scalar name is modeled.
        #
        # `mutable` is a QUALIFIER on the annotation, not part of the type: `x: mutable
        # i64` denotes i64 and just says the binding can be reassigned. It rides as a
        # Unary node wrapping the type, so it is unwrapped here — mutability is the
        # frontend's business (it already rejects `x <- 1` on an immutable local), and the
        # backend only needs the underlying type.
        # Record every `fn(…)->R` type's RETURN-type head (parser side-table __lambda_return,
        # keyed by the fn-type's line) so a Fn ValueType can carry its result type.
        def register_fn_signatures(file: Ast::File&, structs: mutable StructTable&) -> void can[Abort.Panic, Memory.Allocate]:
            for annotation in file.enum_annotations |structs|:
                if annotation.owner == "__lambda_return":
                    structs.fn_return_lines.push(annotation.line)
                    structs.fn_return_heads.push(annotation.name)
                if annotation.owner == "__lambda_param":
                    structs.fn_param_lines.push(annotation.line)
                    structs.fn_param_heads.push(annotation.name)
                if annotation.owner == "__submit":
                    # Reuse the line-keyed return side table as a compact marker; submit
                    # lines never collide with a function-type expression's line.
                    structs.fn_return_lines.push(annotation.line)
                    structs.fn_return_heads.push("__submit")
                if annotation.owner == "__await":
                    structs.fn_return_lines.push(annotation.line)
                    structs.fn_return_heads.push("__await")
                if annotation.owner == "__wait_all":
                    structs.fn_return_lines.push(annotation.line)
                    structs.fn_return_heads.push("__wait_all")
                if annotation.owner == "__clone_error_union":
                    structs.clone_error_lines.push(annotation.line)
                    structs.clone_error_families.push(annotation.name)
                if annotation.owner == "__local_error_union":
                    structs.local_error_lines.push(annotation.line)
                    structs.local_error_families.push(annotation.name)
                if annotation.owner == "__field_error_union":
                    structs.field_error_lines.push(annotation.line)
                    structs.field_error_families.push(annotation.name)
                if annotation.owner == "__param_error_union":
                    structs.param_error_lines.push(annotation.line)
                    structs.param_error_families.push(annotation.name)
                if annotation.owner == "__tuple_label":
                    structs.tuple_label_lines.push(annotation.line)
                    structs.tuple_label_names.push(annotation.name)
                # Guest-overlay field offsets: `__overlay_field` carries the byte offset in
                # `line`; width is filled after struct bodies are registered (see
                # finalize_overlay_field_widths). Layout association uses `__overlay_struct`
                # markers in source order for fields declared under that layout.
                if annotation.owner == "__overlay_field":
                    structs.overlay_field_names.push(annotation.name)
                    structs.overlay_field_offsets.push(annotation.line)
                    structs.overlay_field_widths.push(0)
                    structs.overlay_field_layouts.push(sview("", 0, 0))
            # Associate overlay fields with their layout struct: the parser emits
            # `__overlay_struct` for the layout, then field annotations for its members.
            # Walk annotations in order and bind each field to the most recent overlay struct.
            current_overlay: mutable sview = sview("", 0, 0)
            field_cursor: mutable usize = 0
            for annotation in file.enum_annotations |structs, current_overlay, field_cursor|:
                if annotation.owner == "__overlay_struct":
                    current_overlay <- annotation.name
                elif annotation.owner == "__overlay_field" and field_cursor < structs.overlay_field_names.count:
                    structs.overlay_field_layouts[field_cursor] <- current_overlay
                    field_cursor <- field_cursor + 1
            structs.fn_type_param_lines <- file.fn_type_param_lines
            structs.fn_type_param_exprs <- file.fn_type_param_exprs

        # The recorded return-type head for the fn-type declared at `line`, or "".
        def fn_return_head_at(line: u32, structs: mutable StructTable&) -> sview can[Abort.Panic]:
            probe: mutable usize = 0
            while probe < structs.fn_return_lines.count |probe, line, structs|:
                structs.fn_return_heads[probe] return if structs.fn_return_lines[probe] == line
                probe <- probe + 1
            return sview("", 0, 0)


        def error_family_at(lines: darray[u32]&, families: darray[sview]&, line: u32) -> sview can[Abort.Panic]:
            for index in 0..<lines.count |lines, families, line|:
                families[index] return if lines[index] == line
            return sview("", 0, 0)


        def clone_error_family_at(line: u32, structs: mutable StructTable&) -> sview can[Abort.Panic]:
            return error_family_at(structs.clone_error_lines, structs.clone_error_families, line)


        def local_error_family_at(line: u32, structs: mutable StructTable&) -> sview can[Abort.Panic]:
            return error_family_at(structs.local_error_lines, structs.local_error_families, line)


        def type_expression_line(expression: Expr) -> u32:
            return match expression:
                Expr.Ident(_, ident_line): ident_line
                Expr.Index(_, _, index_line): index_line
                Expr.IndexN(_, _, indexn_line): indexn_line
                Expr.Unary(_, _, unary_line): unary_line
                Expr.Field(_, _, field_line): field_line
                Expr.Scope(_, _, scope_line): scope_line
                Expr.Tuple(_, tuple_line): tuple_line
                Expr.Lambda(_, _, lambda_line): lambda_line
                _: 0


        def field_error_family_for(expression: Expr, structs: mutable StructTable&) -> sview can[Abort.Panic]:
            return error_family_at(structs.field_error_lines, structs.field_error_families, type_expression_line(expression))


        def parameter_value_type(expression: Expr, structs: mutable StructTable&) -> ValueType can[Abort.Panic, Memory.Allocate]:
            payload: ValueType = annotation_value_type(expression, structs)
            family: sview = error_family_at(structs.param_error_lines, structs.param_error_families, type_expression_line(expression))
            if family != "":
                return intern_error_union_type(payload, family, structs)
            return payload

        # Resolve a bare type HEAD NAME (`i64`, `dstr`, a struct) to a ValueType. Only the
        # forms a fn return head can name in the modeled subset; Unmodeled otherwise.
        def resolve_type_head(head: sview, structs: mutable StructTable&) -> ValueType can[Abort.Panic, Memory.Allocate]:
            scalar: ValueType = scalar_type_of_name(head)
            scalar return if scalar.kind != TypeKind.Unmodeled
            ValueType{kind: TypeKind.CStr, bits: 0} return if llvm_opaque_handle_name(head)
            intern_darray_type(ValueType{kind: TypeKind.Unsigned, bits: 8}, structs) return if head == "dstr"
            head_struct: i64 = struct_index_of(structs, head)
            ValueType{kind: TypeKind.Struct, bits: head_struct.u32()} return if head_struct >= 0
            # The parser's compact fn-type side table retains only the type HEAD (`Slice`),
            # not its bracket arguments (`Slice[T]`). When the surrounding signature has
            # already resolved the concrete generic field before reaching `fn(Slice[T])`,
            # recover that ready instance by base name. This preserves the parameter's real
            # LLVM aggregate type without guessing when no matching instance exists.
            for instance in 0..<structs.generic_struct_inst_bases.count |structs, head|:
                continue if structs.generic_struct_inst_bases[instance] != head
                ValueType{kind: TypeKind.Struct, bits: structs.generic_struct_inst_index[instance].u32()} return if structs.generic_struct_inst_ready[instance]
            return unmodeled_type()

        # A Fn ValueType carrying `return_type` + `param_types` in the parallel side-pools at
        # `bits` (fn_pool_returns and the fn_pool_param_* span are index-parallel).
        def intern_fn_type(return_type: ValueType, param_types: darray[ValueType]&, structs: mutable StructTable&) -> ValueType can[Abort.Panic, Memory.Allocate]:
            structs.fn_pool_returns.push(return_type)
            structs.fn_pool_param_start.push(structs.fn_pool_params.count)
            structs.fn_pool_param_count.push(param_types.count)
            for param_type in param_types |structs|:
                structs.fn_pool_params.push(copied_type(param_type))
            return ValueType{kind: TypeKind.Fn, bits: (structs.fn_pool_returns.count - 1).u32()}

        # The RETURN type a Fn value produces when called, or Unmodeled if unknown.
        def fn_return_type_of(fn_type: ValueType, structs: mutable StructTable&) -> ValueType can[Abort.Panic]:
            unmodeled_type() return if fn_type.kind != TypeKind.Fn
            unmodeled_type() return if fn_type.bits.usize() >= structs.fn_pool_returns.count
            return copied_type(structs.fn_pool_returns[fn_type.bits.usize()])

        def annotation_unary_value_type(qualifier: TokenKind, qualified_type: Expr, structs: mutable StructTable&) -> ValueType can[Abort.Panic, Memory.Allocate]:
                # `mutable T` — a QUALIFIER, not part of the type: mutability is the
                # frontend's business, so the underlying type is what matters.
                if qualifier == TokenKind.Mutable:
                    return annotation_value_type(qualified_type, structs)
                # `lmut T` — linear-mutable exclusive access (docs/120). ABI is a pointer to T,
                # same as `T&` / provenance-bearing params; stage0 lowers it as a reference.
                # Without this the qualifier fell through to Unmodeled and every `lmut Parser`
                # / `lmut Lexer` signature in the self-host corpus was declined.
                if qualifier == TokenKind.Lmut:
                    lmut_target: ValueType = annotation_value_type(qualified_type, structs)
                    unmodeled_type() return if lmut_target.kind == TypeKind.Unmodeled
                    # `lmut T&` is already a ref; do not double-wrap.
                    if lmut_target.kind == TypeKind.Ref:
                        return lmut_target
                    return intern_ref_type(lmut_target, structs)
                # `heap T` / `stack T` — a STORAGE qualifier the region checker uses. `stack` is
                # transparent (representation-identical). `heap T&` marks a RAW pointer: keep it
                # a Ref (same `ptr`, same deref/field/index) but flag it heap so `+`/`-` become
                # pointer arithmetic — the arena allocator walks its backing store this way.
                if qualifier == TokenKind.Stack:
                    return annotation_value_type(qualified_type, structs)
                if qualifier == TokenKind.Heap:
                    heap_qualified: ValueType = annotation_value_type(qualified_type, structs)
                    if heap_qualified.kind == TypeKind.Ref:
                        return intern_heap_ref_type(ref_target_of(heap_qualified, structs), structs)
                    # `heap T&?` nests the `?` INSIDE the `heap` qualifier, so the recursion
                    # hands back an Optional and the heap flag would be dropped on the way
                    # out — leaving the payload an ordinary (never-null) ref, which is what
                    # made `malloc`'s null result wrap as PRESENT. Re-intern through the
                    # optional so the heap-ness survives.
                    if heap_qualified.kind == TypeKind.Optional:
                        heap_payload: ValueType = optional_payload_of(heap_qualified, structs)
                        if heap_payload.kind == TypeKind.Ref:
                            return intern_optional_type(intern_heap_ref_type(ref_target_of(heap_payload, structs), structs), structs)
                    return heap_qualified
                # `T&` — a POSTFIX unary in the AST (the parser distinguishes it from infix
                # bitwise-and by looking past the whole `&` run).
                if qualifier == TokenKind.Ampersand:
                    return intern_ref_type(annotation_value_type(qualified_type, structs), structs)
                # `T?` — also a postfix unary.
                if qualifier == TokenKind.Question:
                    return intern_optional_type(annotation_value_type(qualified_type, structs), structs)
                # `tail T` — a flexible/tail array member (the inline data at a struct's end).
                # stage0 lays it out as a plain `ptr`; model it as a heap ref to T (a `ptr` of
                # pointer stride), so a struct carrying one gets a body and the right size.
                if qualifier == TokenKind.Tail:
                    return intern_heap_ref_type(annotation_value_type(qualified_type, structs), structs)
                return unmodeled_type()


		def annotation_index_value_type(array_head: Expr, array_extent: Expr, structs: mutable StructTable&) -> ValueType can[Abort.Panic, Memory.Allocate]:
            # `Node.Store[Local]` — Index(Field(Ident, "Store"), typestate). The TYPESTATE is
            # not modeled: [Local] and [Frozen] have the same layout, and the distinction is
            # a semantic one (freeze/move) the backend does not enforce.
            store_head: Expr = array_head
            store_state: Expr = array_extent
            if store_head is Expr.Field(store_enum_expr, store_member, store_member_line):
                if store_enum_expr is Expr.Ident(store_enum_name, store_enum_line):
                    if store_member == "Store":
                        store_index: i64 = packed_index_of(structs, store_enum_name)
                        if store_index >= 0:
                            return ValueType{kind: TypeKind.PackedStore, bits: store_index.u32()}
            # `i64[3]` — a fixed array. The bracket holds an extent VALUE and the HEAD is
            # the element type. A NON-literal bracket (`cstr[shape]`) is not modeled.
            if array_head is Expr.Ident(enum_array_name, enum_array_line) and array_extent is Expr.IntLit(enum_array_extent):
                enum_array_slot: i64 = enum_index_of(structs, enum_array_name)
                if enum_array_slot >= 0:
                    enum_array_backing: ValueType = copied_type(structs.enum_backings[enum_array_slot.usize()])
                    intern_array_type(enum_array_backing, enum_array_extent.u32(), structs) return if enum_array_extent > 0
            if array_head is Expr.Ident(container_name, container_line):
                if container_name == "GuestVAddr" or container_name == "HostPtr" or container_name == "NativeMappedGuestPtr":
                    if array_extent is Expr.Ident(carrier_layout, carrier_layout_line):
                        return intern_guest_carrier(carrier_layout, structs)
                    return unmodeled_type()
                if container_name == "darray":
                    darray_element: mutable ValueType = annotation_value_type(array_extent, structs)
                    if array_extent is Expr.Ident(darray_opaque_name, darray_opaque_line):
                        darray_element <- ValueType{kind: TypeKind.CStr, bits: 0} if llvm_opaque_handle_name(darray_opaque_name)
                    unmodeled_type() return if darray_element.kind == TypeKind.Unmodeled
                    unmodeled_type() return if darray_element.kind == TypeKind.Array
                    return intern_darray_type(darray_element, structs)
                if container_name == "view":
                    view_element: ValueType = annotation_value_type(array_extent, structs)
                    unmodeled_type() return if view_element.kind == TypeKind.Unmodeled
                    return intern_view_type(view_element, structs)
            if array_extent is Expr.IntLit(extent_value):
                element: ValueType = annotation_value_type(array_head, structs)
                unmodeled_type() return if element.kind == TypeKind.Unmodeled
                unmodeled_type() return if extent_value <= 0
                return intern_array_type(element, extent_value.u32(), structs)
            if array_head is Expr.Ident(generic_base, generic_base_line):
                mapped_generic_base: sview = "DynSet" if generic_base == "set" else generic_base
                if generic_struct_index_of(structs, mapped_generic_base) >= 0:
                    single_argument: ValueType = annotation_value_type(array_extent, structs)
                    single_argument_list: mutable darray[ValueType] = [single_argument]
                    return instantiate_generic_struct(mapped_generic_base, single_argument_list, structs)
			return unmodeled_type()


		def annotation_tuple_value_type(tuple_type_elements: darray[Expr], tuple_type_line: i64, structs: mutable StructTable&) -> ValueType can[Abort.Panic, Memory.Allocate]:
			tuple_labels: darray[sview] = tuple_labels_at(tuple_type_line, structs)
			unmodeled_type() return if tuple_type_elements.count == 0 or tuple_labels.count != tuple_type_elements.count
			tuple_element_types: mutable darray[ValueType] = []
			tuple_declined: mutable bool = false
			for tuple_element in tuple_type_elements |tuple_element_types, tuple_declined, structs|:
				tuple_element_type: ValueType = annotation_value_type(tuple_element, structs)
				tuple_declined <- true if tuple_element_type.kind == TypeKind.Unmodeled
				tuple_element_types.push(tuple_element_type)
			unmodeled_type() return if tuple_declined
			tuple_slot: i64 = tuple_struct_lookup(tuple_labels, tuple_element_types, structs)
			ValueType{kind: TypeKind.Struct, bits: tuple_slot.u32()} return if tuple_slot >= 0
			return unmodeled_type()


        def annotation_application_value_type(application_head: Expr, application_args: darray[Expr], structs: mutable StructTable&) -> ValueType can[Abort.Panic, Memory.Allocate]:
            if application_head is Expr.Ident(application_name, application_name_line):
                if application_args.count == 2 and application_args[0] is Expr.Ident(enum_array_name, enum_array_line) and application_args[1] is Expr.IntLit(enum_array_extent):
					enum_array_slot: i64 = enum_index_of(structs, enum_array_name)
					if enum_array_slot >= 0:
						enum_array_backing: ValueType = copied_type(structs.enum_backings[enum_array_slot.usize()])
						intern_array_type(enum_array_backing, enum_array_extent.u32(), structs) return if enum_array_extent > 0
				# `array[T, N]` — the explicit fixed-array spelling (stage0 accepts it
				# alongside the canonical `T[N]`). Element type in arg 0, extent literal in
				# arg 1; resolves to the same interned Array type as `T[N]`.
				if application_name == "array" and application_args.count == 2:
					array_n_element: ValueType = annotation_value_type(application_args[0], structs)
					unmodeled_type() return if array_n_element.kind == TypeKind.Unmodeled
					if application_args[1] is Expr.IntLit(array_n_extent):
						unmodeled_type() return if array_n_extent <= 0
						return intern_array_type(array_n_element, array_n_extent.u32(), structs)
					return unmodeled_type()
				resolved_base: sview = "DynDict" if application_name == "dict" else ("DynSet" if application_name == "set" else application_name)
				if generic_struct_index_of(structs, resolved_base) >= 0:
					argument_types: mutable darray[ValueType] = []
					application_declined: mutable bool = false
					for argument_expression in application_args |argument_types, application_declined, structs|:
						argument_type: ValueType = annotation_value_type(argument_expression, structs)
						application_declined <- true if argument_type.kind == TypeKind.Unmodeled
						argument_types.push(argument_type)
					unmodeled_type() return if application_declined
					return instantiate_generic_struct(resolved_base, argument_types, structs)
			return unmodeled_type()


        def annotation_scope_value_type(type_scope_head: Expr, type_scope_name: sview, type_scope_line: i64, structs: mutable StructTable&) -> ValueType can[Abort.Panic]:
            # `Lexer::Token` / `M::T` — module-qualified type name. Stage1 registers
            # nested types under their bare name; the qualifier is only a namespace path.
            return match type_scope_head:
                Expr.Ident(type_module_name, type_module_line): annotation_value_type(Expr.Ident(type_scope_name, type_scope_line), structs)
                _: unmodeled_type()


		def annotation_ident_value_type(type_name: sview, type_line: i64, structs: mutable StructTable&) -> ValueType can[Abort.Panic, Memory.Allocate]:
			# A TYPE PARAMETER shadows everything: inside an instantiation of
			# `identity[T]` with T=i64, the annotation `T` denotes i64.
			bound: ValueType = bound_type_of(structs, type_name)
			bound return if bound.kind != TypeKind.Unmodeled
			scalar: ValueType = scalar_type_of_name(type_name)
			scalar return if scalar.kind != TypeKind.Unmodeled
			ValueType{kind: TypeKind.CStr, bits: 0} return if llvm_opaque_handle_name(type_name)
			ValueType{kind: TypeKind.Arena, bits: 0} return if type_name == "Arena"
			# `dstr` (dynamic string) IS a `darray[u8]`.
			intern_darray_type(ValueType{kind: TypeKind.Unsigned, bits: 8}, structs) return if type_name == "dstr"
			# An ALIAS denotes its target and has no representation of its own. An
			# unresolved alias must not shadow a same-named struct/enum.
			alias_index: i64 = alias_index_of(structs, type_name)
			if alias_index >= 0:
				aliased: ValueType = copied_type(structs.alias_types[alias_index.usize()])
				aliased return if aliased.kind != TypeKind.Unmodeled
			# A CONST ENUM name denotes its backing scalar.
			enum_index: i64 = enum_index_of(structs, type_name)
			copied_type(structs.enum_backings[enum_index.usize()]) return if enum_index >= 0
			packed_annotation_index: i64 = packed_index_of(structs, type_name)
			ValueType{kind: TypeKind.PackedEnum, bits: packed_annotation_index.u32()} return if packed_annotation_index >= 0
			penum_index: i64 = penum_index_of(structs, type_name)
			ValueType{kind: TypeKind.PayloadEnum, bits: penum_index.u32()} return if penum_index >= 0
			struct_index: i64 = struct_index_of(structs, type_name)
			ValueType{kind: TypeKind.Struct, bits: struct_index.u32()} return if struct_index >= 0
			return unmodeled_type()


		def annotation_lambda_value_type(fn_type_line: i64, structs: mutable StructTable&) -> ValueType can[Abort.Panic, Memory.Allocate]:
			fn_return_head: sview = fn_return_head_at(fn_type_line, structs)
			fn_return_resolved: ValueType = resolve_type_head(fn_return_head, structs) if fn_return_head != "" else unmodeled_type()
			# Collect this fn-type's param types from the parser metadata into a local list.
			fn_param_type_list: mutable darray[ValueType] = []
			fn_param_probe: mutable usize = 0
			fn_full_type_probe: mutable usize = 0
			while fn_param_probe < structs.fn_param_lines.count |fn_param_type_list, fn_param_probe, fn_type_line, structs|:
				if structs.fn_param_lines[fn_param_probe] == fn_type_line:
					while fn_full_type_probe < structs.fn_type_param_lines.count and structs.fn_type_param_lines[fn_full_type_probe] != fn_type_line |fn_full_type_probe, structs, fn_type_line|:
						fn_full_type_probe <- fn_full_type_probe + 1
					if fn_full_type_probe < structs.fn_type_param_lines.count:
						fn_param_type_list.push(annotation_value_type(structs.fn_type_param_exprs[fn_full_type_probe], structs))
						fn_full_type_probe <- fn_full_type_probe + 1
					else:
						fn_param_type_list.push(resolve_type_head(structs.fn_param_heads[fn_param_probe], structs))
				fn_param_probe <- fn_param_probe + 1
			return intern_fn_type(fn_return_resolved, fn_param_type_list, structs)


        def annotation_value_type(type_expression: Expr, structs: mutable StructTable&) -> ValueType can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            return match type_expression:
                Expr.Unary(qualifier, qualified_type, qualifier_line): annotation_unary_value_type(qualifier, qualified_type, structs)
                Expr.Index(array_head, array_extent, array_line): annotation_index_value_type(array_head, array_extent, structs)
                Expr.Tuple(tuple_type_elements, tuple_type_line): annotation_tuple_value_type(tuple_type_elements, tuple_type_line, structs)
                Expr.IndexN(application_head, application_args, application_line): annotation_application_value_type(application_head, application_args, structs)
                Expr.Scope(type_scope_head, type_scope_name, type_scope_line): annotation_scope_value_type(type_scope_head, type_scope_name, type_scope_line, structs)
                Expr.Ident(type_name, type_line): annotation_ident_value_type(type_name, type_line, structs)
                Expr.Lambda(fn_type_params, fn_type_body, fn_type_line): annotation_lambda_value_type(fn_type_line, structs)
                _: unmodeled_type()


        # The LLVM type backing a ValueType.
        def llvm_type_of(value_type: ValueType, structs: mutable StructTable&, ctx: LLVMContextRef) -> LLVMTypeRef can[Abort.Panic]:
            LLVMVoidTypeInContext(ctx) return if value_type.kind == TypeKind.Void
            LLVMInt1TypeInContext(ctx) return if value_type.kind == TypeKind.Bool
            # A cstr is an opaque `ptr`, exactly as stage0 passes it (`define i64
            # @take(ptr)`).
            LLVMPointerTypeInContext(ctx, 0) return if value_type.kind == TypeKind.CStr
            # A `fn(…)->R` value is a (possibly tagged) `ptr` — see the TypeKind.Fn note.
            LLVMPointerTypeInContext(ctx, 0) return if value_type.kind == TypeKind.Fn
            # GuestVAddr/HostPtr carriers are raw address integers (stage0: i64).
            LLVMInt64TypeInContext(ctx) return if value_type.kind == TypeKind.GuestCarrier
            arena_llvm_type(ctx) return if value_type.kind == TypeKind.Arena
            # A packed handle is an **i32 INDEX** into the store, NOT the row. stage0:
            # `%n = alloca i32`, `store i32 %packed.alloc.index, ptr %n`, and the match
            # passes that index to the runtime. The `{i32, [N x i64]}` struct below is only
            # the ROW LAYOUT, used when WRITING a row -- it is never the value's type.
            LLVMInt32TypeInContext(ctx) return if value_type.kind == TypeKind.PackedEnum
            # `{ptr arena, i64 row_bytes, ptr state}` — stage0's `%Node__Store`.
            if value_type.kind == TypeKind.PackedStore:
                store_fields: mutable darray[LLVMTypeRef] = [LLVMPointerTypeInContext(ctx, 0), LLVMInt64TypeInContext(ctx), LLVMPointerTypeInContext(ctx, 0)]
                store_pointer: void& = (&store_fields[0]).cast[void&] can Unsafe.PointerCast
                return LLVMStructTypeInContext(ctx, store_pointer, 3, 0)
            # `{ i32, [N x i64] }` — stage0's tagged-union layout for a payload enum.
            if value_type.kind == TypeKind.PayloadEnum:
                words: u32 = structs.penum_payload_words[value_type.bits.usize()]
                penum_fields: mutable darray[LLVMTypeRef] = [LLVMInt32TypeInContext(ctx), LLVMArrayType(LLVMInt64TypeInContext(ctx), words)]
                penum_pointer: void& = (&penum_fields[0]).cast[void&] can Unsafe.PointerCast
                return LLVMStructTypeInContext(ctx, penum_pointer, 2, 0)
            structs.handles[value_type.bits.usize()] return if value_type.kind == TypeKind.Struct
            if value_type.kind == TypeKind.Array:
                slot: usize = value_type.bits.usize()
                return LLVMArrayType(llvm_type_of(structs.array_elements[slot], structs, ctx), structs.array_extents[slot])
            # `{i1 has_value, T value}` — stage0's Optional layout.
            if value_type.kind == TypeKind.Optional:
                payload: ValueType = copied_type(structs.optional_targets[value_type.bits.usize()])
                fields: mutable darray[LLVMTypeRef] = [LLVMInt1TypeInContext(ctx), llvm_type_of(payload, structs, ctx)]
                fields_pointer: void& = (&fields[0]).cast[void&] can Unsafe.PointerCast
                return LLVMStructTypeInContext(ctx, fields_pointer, 2, 0)
            # Value-carrying error unions are descriptors: the status code is zero on
            # success and nonzero on failure; the payload pointer is valid on success.
            if value_type.kind == TypeKind.ErrorUnion:
                error_union_fields: mutable darray[LLVMTypeRef] = [LLVMInt32TypeInContext(ctx), LLVMPointerTypeInContext(ctx, 0)]
                error_union_pointer: void& = (&error_union_fields[0]).cast[void&] can Unsafe.PointerCast
                return LLVMStructTypeInContext(ctx, error_union_pointer, 2, 0)
            # A reference is just a pointer; the referent matters only at the load/store.
            LLVMPointerTypeInContext(ctx, 0) return if value_type.kind == TypeKind.Ref
            # `{ptr items, i64 count, i64 capacity}` — stage0's DynArray layout, which the
            # shared runtime dictates.
            if value_type.kind == TypeKind.DArray:
                return darray_llvm_type(structs, ctx)
            # A `view[T]` lowers to the one `DynArrayView` struct regardless of its element.
            if value_type.kind == TypeKind.View:
                view_llvm_struct: ValueType = view_struct_type(value_type, structs)
                if view_llvm_struct.kind == TypeKind.Struct:
                    return structs.handles[view_llvm_struct.bits.usize()]
                # The runtime's DynArrayView declaration is not present in every standalone
                # stage1 input, but its ABI is fixed: `{ptr data, i64 len}`. Do not fall back
                # to a raw pointer, since view clone/slice lowering uses extractvalue on it.
                view_fields: mutable darray[LLVMTypeRef] = [LLVMPointerTypeInContext(ctx, 0), LLVMInt64TypeInContext(ctx)]
                view_fields_pointer: void& = (&view_fields[0]).cast[void&] can Unsafe.PointerCast
                return LLVMStructTypeInContext(ctx, view_fields_pointer, 2, 0)
            # `%StringView = type { ptr, i64 }` — stage0's byte-pointer + length pair.
            if value_type.kind == TypeKind.SView:
                sview_fields: mutable darray[LLVMTypeRef] = [LLVMPointerTypeInContext(ctx, 0), LLVMInt64TypeInContext(ctx)]
                sview_pointer: void& = (&sview_fields[0]).cast[void&] can Unsafe.PointerCast
                return LLVMStructTypeInContext(ctx, sview_pointer, 2, 0)
            if value_type.kind == TypeKind.Float:
                return LLVMFloatTypeInContext(ctx) if value_type.bits == 32 else LLVMDoubleTypeInContext(ctx)
            LLVMInt8TypeInContext(ctx) return if value_type.bits == 8
            LLVMInt16TypeInContext(ctx) return if value_type.bits == 16
            LLVMInt32TypeInContext(ctx) return if value_type.bits == 32
            return LLVMInt64TypeInContext(ctx)


        # The module's struct types.
        #
        # Field names/types live in FLAT pools with a per-struct span, the same shape as
        # FnTable's parameters — a nested `darray[darray[…]]` would make this
        # region-polymorphic for no benefit.
        struct StructTable:
            names: mutable darray[sview]
            handles: mutable darray[LLVMTypeRef]
            alignments: mutable darray[u32]
            field_names: mutable darray[sview]
            field_types: mutable darray[ValueType]
            field_start: mutable darray[usize]
            field_count: mutable darray[usize]
            # Named-tuple field LABELS recovered from the parser's `__tuple_label` side-table
            # (labels are stripped from the Expr.Tuple node, recorded by line). A named tuple
            # type `(x: i64, y: i64)` is modeled as a synthesized anonymous (empty-named)
            # struct pre-registered by register_tuple_types; these give the `.field` names.
            tuple_label_lines: mutable darray[u32]
            tuple_label_names: mutable darray[sview]
            # Guest-overlay / address-space carriers (docs/107). `guest_layouts[i]` is the
            # layout name for a GuestCarrier ValueType with `bits == i`. Overlay field offsets
            # and widths come from the parser's `__overlay_field` annotations plus the field
            # type width on the layout struct.
            guest_layouts: mutable darray[sview]
            overlay_field_names: mutable darray[sview]
            overlay_field_offsets: mutable darray[u32]
            overlay_field_widths: mutable darray[u32]
            overlay_field_layouts: mutable darray[sview]
            # GENERIC struct templates. A `struct Box[T]:` is NOT a concrete type — it is
            # a template materialized per type-argument tuple into an ordinary registered
            # struct named `Box__i64` (the concrete name doubles as the instantiation memo:
            # struct_index_of finding it means it is already built). The template stores its
            # own Decl so its member types can be re-resolved with the type parameters bound.
            # Param names live in a FLAT pool with a per-template span, like struct fields.
            generic_struct_names: mutable darray[sview]
            generic_struct_decls: mutable darray[Decl]
            generic_struct_param_names: mutable darray[sview]
            generic_struct_param_start: mutable darray[usize]
            generic_struct_param_count: mutable darray[usize]
            # Instantiation memo, keyed by (base, type-argument tuple) — NOT by a mangled
            # name, so no synthetic name sview has to outlive the call that builds it. Args
            # are flattened into a pool with a per-instantiation span; `inst_index` is the
            # resulting entry's slot in `names`/`handles`.
            generic_struct_inst_bases: mutable darray[sview]
            generic_struct_inst_args: mutable darray[ValueType]
            generic_struct_inst_arg_start: mutable darray[usize]
            generic_struct_inst_arg_count: mutable darray[usize]
            generic_struct_inst_index: mutable darray[usize]
            # Whether the corresponding generic instance has a completed LLVM body. A false
            # entry is visible only while its base is in generic_struct_inprogress; this lets
            # pointer-mediated recursion refer to the opaque placeholder without making a
            # declined instance look usable on a later lookup.
            generic_struct_inst_ready: mutable darray[bool]
            # Base names currently mid-instantiation. A self-recursive generic struct that
            # recurses BY VALUE (infinite size) is declined rather than looped on; the valid
            # by-pointer case (`Node[T]: next: Node[T]&?`) is not modeled yet and also
            # declines here, conservatively.
            generic_struct_inprogress: mutable darray[sview]
            # The module's LLVM context, stashed so annotation_value_type — which has no ctx
            # parameter — can LAZILY materialize a `Base[args]` instantiation (create its
            # named struct and set its body) the first time an annotation names it.
            context: LLVMContextRef
            # Fixed-array types, interned on demand: `array_elements[i]` is the element
            # type and `array_extents[i]` the length of the array whose ValueType has
            # `bits == i`. Interning (rather than a fresh entry per mention) keeps
            # `i64[3]` one type, so two locals of the same array type compare equal.
            array_elements: mutable darray[ValueType]
            array_extents: mutable darray[u32]
            # `darray[T]` element types, interned the same way.
            darray_elements: mutable darray[ValueType]
            # `view[T]` element types, interned the same way — the phantom element the
            # `DynArrayView` fat pointer carries for type checking / generic inference.
            view_elements: mutable darray[ValueType]
            # `T&` referent types, interned the same way.
            ref_targets: mutable darray[ValueType]
            # Parallel to ref_targets: whether each interned ref is a RAW HEAP pointer (`heap
            # T&`) rather than a safe reference. A heap ref does POINTER arithmetic on `+`/`-`
            # (advance by stride); a safe ref value-adds (deref then add). The `kind` stays Ref
            # for both, so deref / field / index handling is identical — only arithmetic asks.
            ref_is_heap: mutable darray[bool]
            # `T?` payload types, interned the same way.
            optional_targets: mutable darray[ValueType]
            # Value-carrying `T error[E]` types. The value representation is the stage0
            # descriptor `{i32 error_code, ptr payload}`; the side pools retain the
            # payload type and error-set family.
            error_union_values: mutable darray[ValueType] = []
            error_union_families: mutable darray[sview] = []
            # CONST enums. A `const enum Color of u8` IS its backing scalar (stage0 lowers
            # `def code(c: Color)` to `define i64 @code(i8 %0)`), and a variant is its
            # ORDINAL — `match c: Color.Red:` is `icmp eq i8 %c, 0`. So the backend needs
            # only name -> backing type, and (enum, variant) -> ordinal. Flat pools with a
            # per-enum span, same shape as struct fields.
            enum_names: mutable darray[sview]
            enum_backings: mutable darray[ValueType]
            enum_variants: mutable darray[sview]
            enum_variant_start: mutable darray[usize]
            enum_variant_count: mutable darray[usize]
            # PAYLOAD-carrying enums, in a side-pool parallel to the const-enum one above.
            # `penum_payloads` is the payload ValueType of each variant (one per variant, in
            # declaration order); a variant with NO payload still takes a slot so that a
            # variant's index within its enum IS its tag.
            penum_names: mutable darray[sview]
            penum_variants: mutable darray[sview]
            penum_payloads: mutable darray[ValueType]
            penum_has_payload: mutable darray[bool]
            # The payload field's declared NAME (""), used to check a LABELLED constructor
            # argument: `Shape.Circle(r: 42)` is only that constructor if `r` is the field's
            # real name -- otherwise it is a different program and must not be emitted.
            penum_field_names: mutable darray[sview]
            # MULTI-FIELD payload variants (`Rect(i64, i64)`): each variant's field types and
            # declared names in a flat pool, spanned per variant-slot by _start/_count. A
            # single-field variant keeps its proven single-value path (penum_payloads /
            # penum_has_payload above); a variant with COUNT>1 fields is emitted through these
            # pools instead (tuple store on construction, tuple extract on match). Every
            # variant-slot gets a span (0 fields = empty span) so the pools stay index-parallel.
            penum_field_types: mutable darray[ValueType]
            penum_field_flat_names: mutable darray[sview]
            penum_field_type_start: mutable darray[usize]
            penum_field_type_count: mutable darray[usize]
            # PACKED enums (`packed enum Node:`) — the same per-variant pools as penum_*, but
            # a separate table because the REPRESENTATION differs: a packed value is a store
            # row, not inline data. Kept apart so neither path can silently claim the other's
            # enums (which is exactly the bug 5403a62 fixed).
            packed_names: mutable darray[sview]
            packed_variants: mutable darray[sview]
            packed_payloads: mutable darray[ValueType]
            packed_has_payload: mutable darray[bool]
            packed_field_names: mutable darray[sview]
            packed_variant_start: mutable darray[usize]
            packed_variant_count: mutable darray[usize]
            packed_payload_words: mutable darray[u32]
            # Full payload field spans for aggregate packed variants.
            packed_field_types: mutable darray[ValueType]
            packed_field_flat_names: mutable darray[sview]
            packed_field_type_start: mutable darray[usize]
            packed_field_type_count: mutable darray[usize]
            # How many leading fields of each variant are COMMON (shared across variants).
            # The parser PREPENDS them to every variant's field list, so from here a common
            # block just means "the first N fields are shared". They are stored INLINE
            # between the tag and the payload: stage0 lays out `%Expr = {i32, i64, [1 x i64]}`
            # for one common field, vs `{i32, [1 x i64]}` for none.
            packed_common_counts: mutable darray[u32]
            penum_variant_start: mutable darray[usize]
            penum_variant_count: mutable darray[usize]
            # Payload words (i64 units) of the WIDEST variant — the `[N x i64]` extent.
            penum_payload_words: mutable darray[u32]
            # `alias Num = i64` — a NAME for an existing type, carrying no representation of
            # its own, so it resolves to the target's ValueType and disappears.
            #
            # Resolved to a FIXPOINT at registration rather than by recursing at each
            # mention: `alias A = B` / `alias B = A` would otherwise recurse forever (the
            # same shape as the value-binding cycle that stack-overflows a naive resolver).
            # A cycle simply never resolves, stays Unmodeled, and DECLINES.
            alias_names: mutable darray[sview]
            alias_types: mutable darray[ValueType]
            # GLOBAL consts. stage0 INLINES them: `const LIMIT: i64 = 42` emits no `@LIMIT`
            # global and no load — `LIMIT + NAME.i64()` lowers to `sadd(42, 7)` (read from
            # its -emit llvm output). So a const is a compile-time VALUE substituted at the
            # use site, and the backend needs only name -> (type, folded value).
            #
            # Folded to a FIXPOINT, unlike aliases: stage0 ACCEPTS a forward reference here
            # (`const A: i64 = B + 2` before `const B` works — verified), so an in-order pass
            # would decline a program the reference compiler compiles. A CYCLE never folds
            # and stays unresolved, which declines — stage0 rejects it too ("const \"A\"
            # initializer must be a compile-time i64 value").
            const_names: mutable darray[sview]
            const_types: mutable darray[ValueType]
            const_values: mutable darray[i64]
            const_resolved: mutable darray[bool]
            # A FLOAT const's source text (`const PI: f64 = 3.0` → "3.0"), inlined at the use
            # site via LLVMConstRealOfString (never re-parse the decimal). "" for non-float.
            const_float_text: mutable darray[sview]
            # A global const AGGREGATE (array) is backed by a real module GLOBAL rather than a
            # folded scalar: `const_globals[i]` is its `@name` handle (indexed by GEP at use)
            # and `const_global_ok[i]` marks the slot as materialized. Scalar consts leave the
            # handle null and stay on the fold path above.
            const_globals: mutable darray[LLVMValueRef]
            const_global_ok: mutable darray[bool]
            # External C globals. Unlike Elisa `const` values these remain addressable LLVM
            # declarations and are loaded/stored at each use site.
            extern_global_names: mutable darray[sview]
            extern_global_types: mutable darray[ValueType]
            extern_global_handles: mutable darray[LLVMValueRef]
            # Mutable Elisa globals have owned module storage and are distinct from
            # immutable folded consts and external C globals.
            mutable_global_names: mutable darray[sview]
            mutable_global_types: mutable darray[ValueType]
            mutable_global_handles: mutable darray[LLVMValueRef]
            # `static if` selection results, stashed here because StructTable already
            # reaches every emitter: branch head lines (all of them) and the taken subset.
            # A Stmt.Block("static") whose line is a branch line emits only when taken;
            # a bare `static:` block (line in neither) emits unconditionally.
            static_branch_lines: mutable darray[u32]
            static_taken_lines: mutable darray[u32]
            # The `ensure PRED` postconditions of the function CURRENTLY being emitted.
            # Refilled per function by emit_function_body and read at every `return`, which
            # is where stage0 checks them: it allocates `%result`, stores the returned value
            # into it, then branches on each predicate. Threaded on StructTable rather than
            # Runtime because Runtime is COPIED per function (copied_runtime) and this is a
            # container -- the side-table channel static_branch_lines already uses.
            pending_ensures: mutable darray[Expr]
            # Paths proven non-null by an `assert PATH != null` in the function currently
            # being emitted. stage0 NARROWS on that assert: `assert m.items != null` makes
            # the following `items: DictBucket[K,T]& = m.items` legal (it rejects the same
            # assignment WITHOUT the assert -- verified against stage0 both ways). The std
            # dict's find/get/put all depend on it.
            #
            # A path is `owner.field` (field == "" for a bare local). Recorded per function
            # and dropped as soon as anything ASSIGNS to the path, since the proof dies with
            # the value it was about.
            narrowed_owners: mutable darray[sview]
            narrowed_fields: mutable darray[sview]
            # The CURRENT generic instantiation's type-parameter bindings: `binding_names[i]`
            # (e.g. "T") stands for `binding_types[i]` (e.g. i64). Empty outside one.
            #
            # These live in the registry rather than as their own threaded parameter: the
            # registry already reaches every place a type is resolved, and constructing a
            # fresh empty bindings table per call site is REGION-POLYMORPHIC (so illegal in
            # a non-region-inferable context). Set on entry to an instantiation, cleared on
            # exit. `binding_names` are sviews into the source buffer, so nothing dangles.
            binding_names: mutable darray[sview]
            binding_types: mutable darray[ValueType]
            # `fn(…)->R` signature reconstruction. The parser drops fn-type param/return types
            # from the AST, recording only HEAD NAMES on the __lambda_return / __lambda_param
            # annotations keyed by the fn-type's line. Populated ONCE (register_fn_signatures)
            # from file.enum_annotations: `fn_return_lines[i]` -> `fn_return_heads[i]`. A resolved
            # Fn ValueType carries its RETURN type in the `fn_pool_returns` side-pool at `bits`,
            # so a call through a fn value knows its result type even in argument position.
            fn_return_lines: mutable darray[u32]
            fn_return_heads: mutable darray[sview]
            fn_pool_returns: mutable darray[ValueType]
            fn_param_lines: mutable darray[u32]
            fn_param_heads: mutable darray[sview]
            fn_pool_param_start: mutable darray[usize]
            fn_pool_param_count: mutable darray[usize]
            fn_pool_params: mutable darray[ValueType]
            # Full function-value parameter type expressions copied from Ast::File. These
            # preserve generic arguments that the legacy head-only annotation rows discard.
            fn_type_param_lines: mutable darray[u32]
            fn_type_param_exprs: mutable darray[Expr]
            # Explicit `clone[T error[E]]` targets preserved by the parser side table.
            clone_error_lines: mutable darray[u32] = []
            clone_error_families: mutable darray[sview] = []
            # Local `x: T error[E]` declarations preserved by the parser side table.
            local_error_lines: mutable darray[u32] = []
            local_error_families: mutable darray[sview] = []
            field_error_lines: mutable darray[u32] = []
            field_error_families: mutable darray[sview] = []
            param_error_lines: mutable darray[u32] = []
            param_error_families: mutable darray[sview] = []
            branch_hint_lines: mutable darray[u32]
            branch_hint_kinds: mutable darray[sview]
            # Whole-program facts used by the opt-in disjoint-parameter alias metadata.
            # A mask bit marks a source parameter that is proven distinct from every other
            # eligible darray reference parameter at every observed call site.
            disjoint_function_names: mutable darray[sview] = []
            disjoint_function_masks: mutable darray[u64] = []
            disjoint_candidate_masks: mutable darray[u64] = []


        # The LLVM type of ANY darray: `{ptr, i64, i64}` = {items, count, capacity}.
        #
        # One shape for every element type — the element only affects the STRIDE when
        # indexing, never the header. Matches stage0's `%DynArray__T` (verified by reading
        # its `-emit llvm` output); the layout is dictated by the shared runtime.
        def darray_llvm_type(structs: mutable StructTable&, ctx: LLVMContextRef) -> LLVMTypeRef can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            int64_type: LLVMTypeRef = LLVMInt64TypeInContext(ctx)
            fields: mutable darray[LLVMTypeRef] = [LLVMPointerTypeInContext(ctx, 0), int64_type, int64_type]
            fields_pointer: void& = (&fields[0]).cast[void&] can Unsafe.PointerCast
            return LLVMStructTypeInContext(ctx, fields_pointer, 3, 0)


        # The `Arena` header: `{ptr, ptr, i64, i64}`. Field 3 is the STRATEGY, which the
        # runtime reads; stage0 stores 2 (lazy) for an auto region, so this does too.
        def arena_llvm_type(ctx: LLVMContextRef) -> LLVMTypeRef can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            pointer_type: LLVMTypeRef = LLVMPointerTypeInContext(ctx, 0)
            int64_type: LLVMTypeRef = LLVMInt64TypeInContext(ctx)
            fields: mutable darray[LLVMTypeRef] = [pointer_type, pointer_type, int64_type, int64_type]
            fields_pointer: void& = (&fields[0]).cast[void&] can Unsafe.PointerCast
            return LLVMStructTypeInContext(ctx, fields_pointer, 4, 0)


        # Copy a ValueType out of the region-backed registry.
        #
        # ValueType is POD, but a value read straight out of `structs`' darrays is a
        # BORROW tied to the registry's region — returning it region-less is (correctly)
        # rejected. Rebuilding it from its fields severs the borrow at zero cost.
        def copied_type(value_type: ValueType) -> ValueType:
            return ValueType{kind: value_type.kind, bits: value_type.bits}


        # Intern a fixed-array type `element[extent]`, returning its ValueType. Same
        # element+extent always yields the same index, so `i64[3]` is one type.
        def intern_array_type(element: ValueType, extent: u32, structs: mutable StructTable&) -> ValueType can[Abort.Panic, Memory.Allocate]:
            for index in 0..<structs.array_elements.count |structs, element, extent|:
                existing: ValueType = structs.array_elements[index]
                if existing.kind == element.kind and existing.bits == element.bits and structs.array_extents[index] == extent:
                    return ValueType{kind: TypeKind.Array, bits: index.u32()}
            structs.array_elements <- structs.array_elements.push(element)
            structs.array_extents <- structs.array_extents.push(extent)
            return ValueType{kind: TypeKind.Array, bits: (structs.array_elements.count - 1).u32()}


        # Intern a guest/host address-space carrier (`GuestVAddr[L]`, `HostPtr[T]`).
        def intern_guest_carrier(layout: sview, structs: mutable StructTable&) -> ValueType can[Abort.Panic, Memory.Allocate]:
            for index in 0..<structs.guest_layouts.count |structs, layout|:
                ValueType{kind: TypeKind.GuestCarrier, bits: index.u32()} return if structs.guest_layouts[index] == layout
            structs.guest_layouts.push(layout)
            return ValueType{kind: TypeKind.GuestCarrier, bits: (structs.guest_layouts.count - 1).u32()}


        def guest_carrier_layout(value_type: ValueType, structs: mutable StructTable&) -> sview can[Abort.Panic]:
            sview("", 0, 0) return if value_type.kind != TypeKind.GuestCarrier
            sview("", 0, 0) return if value_type.bits.usize() >= structs.guest_layouts.count
            return structs.guest_layouts[value_type.bits.usize()]


        # Fill overlay field widths from the layout struct's field types once bodies exist.
        def finalize_overlay_field_widths(structs: mutable StructTable&) -> void can[Abort.Panic]:
            for index in 0..<structs.overlay_field_names.count |structs|:
                continue if structs.overlay_field_widths[index] != 0
                layout: sview = structs.overlay_field_layouts[index]
                continue if layout == ""
                layout_slot: i64 = struct_index_of(structs, layout)
                continue if layout_slot < 0
                field_pos: i64 = field_index_of(structs, layout_slot.usize(), structs.overlay_field_names[index])
                continue if field_pos < 0
                field_type: ValueType = copied_type(structs.field_types[structs.field_start[layout_slot.usize()] + field_pos.usize()])
                width: mutable u32 = 0
                if field_type.kind == TypeKind.Signed or field_type.kind == TypeKind.Unsigned:
                    width <- 1 if field_type.bits == 8 else width
                    width <- 2 if field_type.bits == 16 else width
                    width <- 4 if field_type.bits == 32 else width
                    width <- 8 if field_type.bits == 64 else width
                    # Default unknown scalar overlays to 8 (u64) — stage0's common guest word.
                    width <- 8 if width == 0 else width
                structs.overlay_field_widths[index] <- width


        # Look up a guest-overlay field's (offset, width) for a layout, or (-1, 0) if unknown.
        def overlay_field_info(structs: mutable StructTable&, layout: sview, field: sview) -> (offset: i64, width: u32) can[Abort.Panic]:
            for index in 0..<structs.overlay_field_names.count |structs, layout, field|:
                if structs.overlay_field_names[index] == field and (structs.overlay_field_layouts[index] == layout or structs.overlay_field_layouts[index] == ""):
                    return (structs.overlay_field_offsets[index].i64(), structs.overlay_field_widths[index])
            return (0 - 1, 0)


        # Intern a `darray[T]` type.
        def intern_darray_type(element: ValueType, structs: mutable StructTable&) -> ValueType can[Abort.Panic, Memory.Allocate]:
            for index in 0..<structs.darray_elements.count |structs, element|:
                existing: ValueType = structs.darray_elements[index]
                if existing.kind == element.kind and existing.bits == element.bits:
                    return ValueType{kind: TypeKind.DArray, bits: index.u32()}
            structs.darray_elements <- structs.darray_elements.push(element)
            return ValueType{kind: TypeKind.DArray, bits: (structs.darray_elements.count - 1).u32()}


        # Intern a `view[T]` type — one interned entry per element, lowering to DynArrayView.
        def intern_view_type(element: ValueType, structs: mutable StructTable&) -> ValueType can[Abort.Panic, Memory.Allocate]:
            for index in 0..<structs.view_elements.count |structs, element|:
                existing: ValueType = structs.view_elements[index]
                if existing.kind == element.kind and existing.bits == element.bits:
                    return ValueType{kind: TypeKind.View, bits: index.u32()}
            structs.view_elements <- structs.view_elements.push(element)
            return ValueType{kind: TypeKind.View, bits: (structs.view_elements.count - 1).u32()}


        def view_element_of(value_type: ValueType, structs: mutable StructTable&) -> ValueType can[Abort.Panic]:
            unmodeled_type() return if value_type.kind != TypeKind.View
            return copied_type(structs.view_elements[value_type.bits.usize()])


        # A `view[T]` decays to the `DynArrayView` STRUCT for every representation purpose
        # (LLVM type, field access) — only inference cares about the element. Unmodeled if
        # DynArrayView is not in scope (a program using `view[T]` without the std).
        def view_struct_type(value_type: ValueType, structs: mutable StructTable&) -> ValueType can[Abort.Panic]:
            unmodeled_type() return if value_type.kind != TypeKind.View
            view_struct_index: i64 = struct_index_of(structs, "DynArrayView")
            unmodeled_type() return if view_struct_index < 0
            return ValueType{kind: TypeKind.Struct, bits: view_struct_index.u32()}


        # Intern a reference type `T&`.
        def intern_ref_type(target: ValueType, structs: mutable StructTable&) -> ValueType can[Abort.Panic, Memory.Allocate]:
            unmodeled_type() return if target.kind == TypeKind.Unmodeled
            for index in 0..<structs.ref_targets.count |structs, target|:
                existing: ValueType = structs.ref_targets[index]
                if existing.kind == target.kind and existing.bits == target.bits and not structs.ref_is_heap[index]:
                    return ValueType{kind: TypeKind.Ref, bits: index.u32()}
            structs.ref_targets <- structs.ref_targets.push(target)
            structs.ref_is_heap <- structs.ref_is_heap.push(false)
            return ValueType{kind: TypeKind.Ref, bits: (structs.ref_targets.count - 1).u32()}

        # Intern a RAW HEAP pointer `heap T&` — a Ref (same LLVM `ptr`, same deref/field/index
        # handling) distinguished only by its heap flag, which makes `+`/`-` pointer arithmetic.
        def intern_heap_ref_type(target: ValueType, structs: mutable StructTable&) -> ValueType can[Abort.Panic, Memory.Allocate]:
            unmodeled_type() return if target.kind == TypeKind.Unmodeled
            for index in 0..<structs.ref_targets.count |structs, target|:
                existing: ValueType = structs.ref_targets[index]
                if existing.kind == target.kind and existing.bits == target.bits and structs.ref_is_heap[index]:
                    return ValueType{kind: TypeKind.Ref, bits: index.u32()}
            structs.ref_targets <- structs.ref_targets.push(target)
            structs.ref_is_heap <- structs.ref_is_heap.push(true)
            return ValueType{kind: TypeKind.Ref, bits: (structs.ref_targets.count - 1).u32()}

        # Whether a value type is a raw heap pointer (`heap T&`) — the query arithmetic asks.
        def ref_is_heap_ref(value_type: ValueType, structs: StructTable&) -> bool can[Abort.Panic]:
            return value_type.kind == TypeKind.Ref and structs.ref_is_heap[value_type.bits.usize()]


        # Intern an optional type `T?`.
        def intern_optional_type(payload: ValueType, structs: mutable StructTable&) -> ValueType can[Abort.Panic, Memory.Allocate]:
            unmodeled_type() return if payload.kind == TypeKind.Unmodeled or payload.kind == TypeKind.Optional
            for index in 0..<structs.optional_targets.count |structs, payload|:
                existing: ValueType = structs.optional_targets[index]
                if existing.kind == payload.kind and existing.bits == payload.bits:
                    return ValueType{kind: TypeKind.Optional, bits: index.u32()}
            structs.optional_targets <- structs.optional_targets.push(payload)
            return ValueType{kind: TypeKind.Optional, bits: (structs.optional_targets.count - 1).u32()}


        # The payload type of a `T?`.
        def optional_payload_of(value_type: ValueType, structs: mutable StructTable&) -> ValueType can[Abort.Panic]:
            unmodeled_type() return if value_type.kind != TypeKind.Optional
            return copied_type(structs.optional_targets[value_type.bits.usize()])


        # Intern a value-carrying error union. Error-family names are source-backed sviews;
        # keeping them beside the payload type mirrors the stage0 ErrorUnionType pair.
        def intern_error_union_type(payload: ValueType, family: sview, structs: mutable StructTable&) -> ValueType can[Abort.Panic, Memory.Allocate]:
            unmodeled_type() return if payload.kind == TypeKind.Unmodeled or family == ""
            for index in 0..<structs.error_union_values.count |structs, payload, family|:
                existing: ValueType = structs.error_union_values[index]
                if existing.kind == payload.kind and existing.bits == payload.bits and structs.error_union_families[index] == family:
                    return ValueType{kind: TypeKind.ErrorUnion, bits: index.u32()}
            structs.error_union_values.push(payload)
            structs.error_union_families.push(family)
            return ValueType{kind: TypeKind.ErrorUnion, bits: (structs.error_union_values.count - 1).u32()}


        def error_union_payload_of(value_type: ValueType, structs: mutable StructTable&) -> ValueType can[Abort.Panic]:
            unmodeled_type() return if value_type.kind != TypeKind.ErrorUnion
            return copied_type(structs.error_union_values[value_type.bits.usize()])


        def error_union_family_of(value_type: ValueType, structs: mutable StructTable&) -> sview can[Abort.Panic]:
            sview("", 0, 0) return if value_type.kind != TypeKind.ErrorUnion
            return structs.error_union_families[value_type.bits.usize()]


        # The referent type of a `T&`.
        # A function gains an implicit trailing `ptr` arena parameter — and allocates from
        # THAT rather than its own auto region — when a container it touches must outlive
        # the call. Two triggers, both verified against stage0's IR:
        #
        #   * a GROWABLE container REF param: `def fill(out: mutable darray[i64]&)` emits as
        #     `define void @fill(ptr, ptr)` and grows via `arena_alloc(ptr %1, ...)`;
        #   * a container RETURN type: `def build() -> darray[i64]` emits as
        #     `define %DynArray__i64 @build(ptr %0)` and allocates the returned darray's
        #     backing from the CALLER's region.
        #
        # Both are the same rule: the backing belongs to the caller, so a callee-local
        # region would free it at return and hand back freed memory. The return case IS
        # region-return inference, and it is why returning an owned container no longer has
        # to decline (see 95915b5, which declined it precisely because this was missing).
        # libc `abort()` for a failed contract's fail path. Declared once; a repeat
        # LLVMAddFunction would create a duplicate, so reuse an existing declaration.
        def declare_or_get_abort(m: LLVMModuleRef, abort_type: LLVMTypeRef) -> LLVMValueRef can[Abort.Panic, Unsafe.PointerCast]:
            if LLVMGetNamedFunction(m, "abort") is existing:
                return existing
            return LLVMAddFunction(m, "abort", abort_type)


        # Declare a runtime symbol (by name) once, reusing an existing declaration. Used for
        # compiler-emitted builtins whose implementation lives in elisacore_runtime.o.
        def declare_or_get_named(m: LLVMModuleRef, name: cstr, fn_type: LLVMTypeRef) -> LLVMValueRef can[Abort.Panic, Unsafe.PointerCast]:
            if LLVMGetNamedFunction(m, name) is existing:
                return existing
            return LLVMAddFunction(m, name, fn_type)


        # `ctx_hash_value(key)` — the compiler-emitted hash builtin the runtime dict uses.
        # stage0's lowering (llvm_hash.go): a cstr key hashes its content via ctx_hash_cstr
        # (FNV-1a); every fixed-size scalar key zero-extends to u64 and runs ctx_hash_u64
        # (splitmix64). Both return u64 and live in elisacore_runtime.o.
        def emit_hash_builtin(key_expression: Expr, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            key_type: ValueType = expression_type(key_expression, local_scope, fns, structs, generics)
            int64_type: LLVMTypeRef = LLVMInt64TypeInContext(ctx)
            # A cstr key: hash the content.
            if key_type.kind == TypeKind.CStr:
                if emit_expression(key_expression, key_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is cstr_value:
                    cstr_params: mutable darray[LLVMTypeRef] = [LLVMPointerTypeInContext(ctx, 0)]
                    cstr_pointer: void& = (&cstr_params[0]).cast[void&] can Unsafe.PointerCast
                    cstr_hash_type: LLVMTypeRef = LLVMFunctionType(int64_type, cstr_pointer, 1, 0)
                    cstr_hash_fn: LLVMValueRef = declare_or_get_named(m, "ctx_hash_cstr", cstr_hash_type)
                    cstr_args: mutable darray[LLVMValueRef] = [cstr_value]
                    cstr_args_pointer: void& = (&cstr_args[0]).cast[void&] can Unsafe.PointerCast
                    return LLVMBuildCall2(builder, cstr_hash_type, cstr_hash_fn, cstr_args_pointer, 1, "hash.cstr")
                return null
            # A fixed-size scalar (integer / bool / char / const enum): zero-extend to u64.
            null return if not is_integer_type(key_type) and key_type.kind != TypeKind.Bool
            if emit_expression(key_expression, key_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is scalar_value:
                extended: mutable LLVMValueRef = scalar_value
                extended <- LLVMBuildZExt(builder, scalar_value, int64_type, "hash.zext") if key_type.bits < 64
                u64_params: mutable darray[LLVMTypeRef] = [int64_type]
                u64_pointer: void& = (&u64_params[0]).cast[void&] can Unsafe.PointerCast
                u64_hash_type: LLVMTypeRef = LLVMFunctionType(int64_type, u64_pointer, 1, 0)
                u64_hash_fn: LLVMValueRef = declare_or_get_named(m, "ctx_hash_u64", u64_hash_type)
                u64_args: mutable darray[LLVMValueRef] = [extended]
                u64_args_pointer: void& = (&u64_args[0]).cast[void&] can Unsafe.PointerCast
                return LLVMBuildCall2(builder, u64_hash_type, u64_hash_fn, u64_args_pointer, 1, "hash.u64")
            return null


        # `__fstr(chunk_or_value, …)` — the compiler-emitted f-string builder the parser
        # desugars `f"…{x}…"` into. Each argument is a STRING-LIKE piece (a literal chunk or an
        # interpolated dstr/sview — the checker rejects a non-string interpolant), so lowering
        # is stage0's: sum the byte lengths, `ctx_fstr_alloc(total)` a `%DynArray__u8`, then
        # `ctx_fstr_append(slot, data, len)` each piece in order and load the result dstr.
        def emit_fstr_builtin(arguments: darray[Expr]&, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            int64_type: LLVMTypeRef = LLVMInt64TypeInContext(ctx)
            pointer_type: LLVMTypeRef = LLVMPointerTypeInContext(ctx, 0)
            dstr_header: LLVMTypeRef = darray_llvm_type(structs, ctx)
            datas: mutable darray[LLVMValueRef] = []
            lengths: mutable darray[LLVMValueRef] = []
            declined: mutable bool = false
            for argument in arguments |datas, lengths, declined, local_scope, fns, structs, generics, runtime, m, ctx, builder|:
                continue if declined
                if argument is Expr.StringLit(chunk_text):
                    chunk_storage: mutable darray[u8] = []
                    chunk_global: LLVMValueRef = LLVMBuildGlobalStringPtr(builder, sview_to_cstr(chunk_text, chunk_storage), "fstr.chunk")
                    datas.push(chunk_global)
                    lengths.push(LLVMConstInt(int64_type, sview_len(chunk_text).u64(), 0))
                else:
                    argument_type: ValueType = expression_type(argument, local_scope, fns, structs, generics)
                    is_dstr: bool = argument_type.kind == TypeKind.DArray and darray_element_of(argument_type, structs).kind == TypeKind.Unsigned and darray_element_of(argument_type, structs).bits == 8
                    is_sview: bool = argument_type.kind == TypeKind.SView
                    if not is_dstr and not is_sview:
                        declined <- true
                    elif emit_expression(argument, argument_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is piece_value:
                        # dstr `{ptr items, i64 count, i64 cap}` and sview `{ptr, i64 len}` both
                        # carry the data pointer at field 0 and the byte length at field 1.
                        datas.push(LLVMBuildExtractValue(builder, piece_value, 0, "fstr.data"))
                        lengths.push(LLVMBuildExtractValue(builder, piece_value, 1, "fstr.len"))
                    else:
                        declined <- true
            null return if declined
            total: mutable LLVMValueRef = LLVMConstInt(int64_type, 0, 0)
            for piece_length in lengths |total, builder|:
                total <- LLVMBuildAdd(builder, total, piece_length, "fstr.total")
            alloc_params: mutable darray[LLVMTypeRef] = [int64_type]
            alloc_params_pointer: void& = (&alloc_params[0]).cast[void&] can Unsafe.PointerCast
            alloc_type: LLVMTypeRef = LLVMFunctionType(dstr_header, alloc_params_pointer, 1, 0)
            alloc_fn: LLVMValueRef = declare_or_get_named(m, "ctx_fstr_alloc", alloc_type)
            alloc_args: mutable darray[LLVMValueRef] = [total]
            alloc_args_pointer: void& = (&alloc_args[0]).cast[void&] can Unsafe.PointerCast
            dstr_value: LLVMValueRef = LLVMBuildCall2(builder, alloc_type, alloc_fn, alloc_args_pointer, 1, "fstr.alloc")
            fstr_slot: LLVMValueRef = LLVMBuildAlloca(builder, dstr_header, "fstr.slot")
            _ = LLVMBuildStore(builder, dstr_value, fstr_slot)
            append_params: mutable darray[LLVMTypeRef] = [pointer_type, pointer_type, int64_type]
            append_params_pointer: void& = (&append_params[0]).cast[void&] can Unsafe.PointerCast
            append_type: LLVMTypeRef = LLVMFunctionType(LLVMVoidTypeInContext(ctx), append_params_pointer, 3, 0)
            append_fn: LLVMValueRef = declare_or_get_named(m, "ctx_fstr_append", append_type)
            piece_index: mutable usize = 0
            while piece_index < datas.count |piece_index, datas, lengths, fstr_slot, append_type, append_fn, builder|:
                append_args: mutable darray[LLVMValueRef] = [fstr_slot, datas[piece_index], lengths[piece_index]]
                append_args_pointer: void& = (&append_args[0]).cast[void&] can Unsafe.PointerCast
                _ = LLVMBuildCall2(builder, append_type, append_fn, append_args_pointer, 3, "")
                piece_index <- piece_index + 1
            return LLVMBuildLoad2(builder, dstr_header, fstr_slot, "fstr.result")


        # Whether the function declared at `line` returns an error union. The frontend
        # records error-returning functions by LINE in File.error_set_func_lines (the
        # `error[E]` clause is consumed at parse time; only this side table survives).
        def line_is_error_returning(error_lines: darray[u32]&, line: u32) -> bool can[Abort.Panic]:
            for error_line in error_lines |line|:
                true return if error_line == line
            return false


        # Whether a struct holds a darray anywhere in its (recursive) fields — such a struct
        # returned by value carries a darray whose BUFFER must outlive the callee, so the
        # function must thread the caller's arena (build the darray there, not in the callee's
        # auto-region which frees on return → a use-after-free when the caller reads it).
        def struct_contains_darray(struct_type: ValueType, structs: mutable StructTable&) -> bool can[Abort.Panic]:
            false return if struct_type.kind != TypeKind.Struct
            struct_darray_slot: usize = struct_type.bits.usize()
            struct_darray_start: usize = structs.field_start[struct_darray_slot]
            struct_darray_count: usize = structs.field_count[struct_darray_slot]
            for struct_darray_index in 0..<struct_darray_count |structs, struct_darray_start|:
                struct_darray_field: ValueType = copied_type(structs.field_types[struct_darray_start + struct_darray_index])
                true return if struct_darray_field.kind == TypeKind.DArray
                true return if struct_darray_field.kind == TypeKind.Struct and struct_contains_darray(struct_darray_field, structs)
            return false

        def signature_needs_arena(params: darray[ParamDecl]&, return_value_type: ValueType, structs: mutable StructTable&) -> bool can[Abort.Panic]:
            true return if return_value_type.kind == TypeKind.DArray
            true return if return_value_type.kind == TypeKind.Struct and struct_contains_darray(return_value_type, structs)
            for parameter in params |structs|:
                parameter_type: ValueType = parameter_value_type(parameter.type_expression, structs)
                continue if parameter_type.kind != TypeKind.Ref
                arena_param_target: ValueType = ref_target_of(parameter_type, structs)
                # A `darray[T]&` param may be GROWN (`xs.push`); a `Struct&` whose fields hold a
                # darray may grow that field (`b.items.push`). Both need the CALLER's arena
                # threaded so the growth outlives the call (else a use-after-free).
                true return if arena_param_target.kind == TypeKind.DArray
                true return if arena_param_target.kind == TypeKind.Struct and struct_contains_darray(arena_param_target, structs)
            return false


        # The recursive AST hierarchy is a compiler-internal packed value. Stage0 threads
        # its shared store through the parser and backend call graph as a hidden trailing
        # parameter. Keep the first ABI slice deliberately explicit here: the semantic
        # implementation later refines this to transitive per-root needs, while the stage1
        # self-host corpus has one compiler AST store (`Ast.Node`).
        def function_needs_ast_store(owner: sview, name: sview) -> bool can[Abort.Panic]:
            if owner == "Parser" or owner == "Backend":
                return true
            if name == "frontend_parser_parse_file" or name == "frontend_parse":
                return true
            return false


        # The darray ValueType behind `name`, whether it is a local darray or a
        # `darray[T]&` parameter — Unmodeled when it is neither.
        def darray_type_behind(local_scope: mutable Scope&, name: sview, structs: mutable StructTable&) -> ValueType can[Abort.Panic]:
            bound: ValueType = lookup_type(local_scope, name)
            bound return if bound.kind == TypeKind.DArray
            unmodeled_type() return if bound.kind != TypeKind.Ref
            target: ValueType = ref_target_of(bound, structs)
            target return if target.kind == TypeKind.DArray
            return unmodeled_type()


        # The ADDRESS of the darray header named `name`. A local darray IS its slot; a
        # `darray[T]&` parameter's slot holds a POINTER to the CALLER's darray, so it takes
        # one extra load. Every darray operation goes through this so that push/count/index
        # work identically on a local and on a borrowed one.
        # The darray type behind an EXPR receiver: a bare Ident (`xs`) or a struct field
        # holding a darray (`b.items`). Enables container-in-struct ops.
        def darray_type_behind_expr(object: Expr, local_scope: mutable Scope&, structs: mutable StructTable&) -> ValueType can[Abort.Panic]:
            if object is Expr.Ident(darray_name, darray_name_line):
                return darray_type_behind(local_scope, darray_name, structs)
            if object is Expr.Field(darray_inner, darray_field, darray_field_line):
                inner_type: mutable ValueType = struct_chain_type(darray_inner, local_scope, structs)
                inner_type <- ref_target_of(inner_type, structs) if inner_type.kind == TypeKind.Ref
                if inner_type.kind == TypeKind.Optional:
                    inner_payload: ValueType = optional_payload_of(inner_type, structs)
                    inner_type <- ref_target_of(inner_payload, structs) if inner_payload.kind == TypeKind.Ref and ref_is_heap_ref(inner_payload, structs)
                inner_type <- arena_user_struct(structs) if inner_type.kind == TypeKind.Arena
                unmodeled_type() return if inner_type.kind != TypeKind.Struct
                inner_slot: usize = inner_type.bits.usize()
                position: i64 = field_index_of(structs, inner_slot, darray_field)
                unmodeled_type() return if position < 0
                field_type: ValueType = copied_type(structs.field_types[structs.field_start[inner_slot] + position.usize()])
                field_type return if field_type.kind == TypeKind.DArray
            # `m[i]` where `m: darray[darray[T]]` — the indexed element is itself a darray.
            if object is Expr.Index(indexed_darray, index_darray_expr, index_darray_line):
                indexed_element_type: ValueType = struct_chain_type(object, local_scope, structs)
                indexed_element_type return if indexed_element_type.kind == TypeKind.DArray
            return unmodeled_type()


        # The ADDRESS of the darray header behind an EXPR receiver. For a struct field, the
        # header sits inline, so it is a GEP into the struct's address.
        def darray_address_of_expr(object: Expr, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            if object is Expr.Ident(darray_name, darray_name_line):
                return darray_address_of(local_scope, darray_name, structs, ctx, builder)
            if object is Expr.Field(darray_inner, darray_field, darray_field_line):
                inner_type: mutable ValueType = struct_chain_type(darray_inner, local_scope, structs)
                inner_type <- ref_target_of(inner_type, structs) if inner_type.kind == TypeKind.Ref
                if inner_type.kind == TypeKind.Optional:
                    inner_payload: ValueType = optional_payload_of(inner_type, structs)
                    inner_type <- ref_target_of(inner_payload, structs) if inner_payload.kind == TypeKind.Ref and ref_is_heap_ref(inner_payload, structs)
                inner_type <- arena_user_struct(structs) if inner_type.kind == TypeKind.Arena
                null return if inner_type.kind != TypeKind.Struct
                inner_slot: usize = inner_type.bits.usize()
                position: i64 = field_index_of(structs, inner_slot, darray_field)
                null return if position < 0
                if struct_chain_address(darray_inner, local_scope, fns, structs, generics, runtime, m, ctx, builder) is inner_address:
                    return LLVMBuildStructGEP2(builder, llvm_type_of(inner_type, structs, ctx), inner_address, position.u32(), "darray.field.ptr")
                return null
            # `m[i]` where `m: darray[darray[T]]` — the address of the inner darray header is
            # the address of that element in the outer buffer (nested-index address).
            if object is Expr.Index(indexed_darray, index_darray_expr, index_darray_line):
                return struct_chain_address(object, local_scope, fns, structs, generics, runtime, m, ctx, builder)
            return null


        def darray_address_of(local_scope: mutable Scope&, name: sview, structs: mutable StructTable&, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic]:
            bound: ValueType = lookup_type(local_scope, name)
            if lookup_slot(local_scope, name) is bound_slot:
                bound_slot return if bound.kind == TypeKind.DArray
                null return if bound.kind != TypeKind.Ref
                null return if ref_target_of(bound, structs).kind != TypeKind.DArray
                return LLVMBuildLoad2(builder, LLVMPointerTypeInContext(ctx, 0), bound_slot, "darray.ref")
            return null


        # `darray.pop()` decrements the header count and returns the now-last element.
        # Keep this as a value lowering rather than relying on a generic runtime symbol:
        # stage0 monomorphizes `darray_pop[T]`, while a self-hosted stage1 build must be able
        # to emit the compiler's own `u8`/Token/ValueType pops without an external generic
        # library object.
        def emit_darray_pop_value(slot: LLVMValueRef, array_type: ValueType, structs: mutable StructTable&, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            element_type: ValueType = darray_element_of(array_type, structs)
            header: LLVMTypeRef = darray_llvm_type(structs, ctx)
            count_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, header, slot, 1, "pop.count.ptr")
            count: LLVMValueRef = LLVMBuildLoad2(builder, LLVMInt64TypeInContext(ctx), count_pointer, "pop.count")
            new_count: LLVMValueRef = LLVMBuildSub(builder, count, LLVMConstInt(LLVMInt64TypeInContext(ctx), 1, 0), "pop.new.count")
            _ = LLVMBuildStore(builder, new_count, count_pointer)
            items_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, header, slot, 0, "pop.items.ptr")
            items: LLVMValueRef = LLVMBuildLoad2(builder, LLVMPointerTypeInContext(ctx, 0), items_pointer, "pop.items")
            indices: mutable darray[LLVMValueRef] = [new_count]
            indices_pointer: void& = (&indices[0]).cast[void&] can Unsafe.PointerCast
            element_pointer: LLVMValueRef = LLVMBuildGEP2(builder, llvm_type_of(element_type, structs, ctx), items, indices_pointer, 1, "pop.element.ptr")
            return LLVMBuildLoad2(builder, llvm_type_of(element_type, structs, ctx), element_pointer, "pop.value")


        def ref_target_of(value_type: ValueType, structs: mutable StructTable&) -> ValueType can[Abort.Panic]:
            unmodeled_type() return if value_type.kind != TypeKind.Ref
            return copied_type(structs.ref_targets[value_type.bits.usize()])


        # The element type of a `darray[T]`.
        def darray_element_of(value_type: ValueType, structs: mutable StructTable&) -> ValueType can[Abort.Panic]:
            unmodeled_type() return if value_type.kind != TypeKind.DArray
            return copied_type(structs.darray_elements[value_type.bits.usize()])


        # The size in BYTES of a scalar type — the stride a darray indexes by. Only scalars
        # are modeled as darray elements, so this needs no DataLayout query.
        # The byte stride of a darray/array element as an i64 value. A scalar uses its
        # known width (a literal, so the fast path stays literal); a STRUCT uses LLVMSizeOf,
        # which the datalayout resolves -- this is what lets darray[Struct] compute a correct
        # element size instead of declining.
        def element_stride(element_type: ValueType, structs: mutable StructTable&, ctx: LLVMContextRef) -> LLVMValueRef can[Abort.Panic]:
            # An aggregate element (struct, fixed array, nested darray header, or view fat
            # pointer) is sized by its LLVM type; only a plain scalar has a fixed byte size.
            # A DArray/View element that fell through to scalar_byte_size got stride 0, so the
            # container allocated a 0-byte buffer and every push corrupted memory.
            LLVMSizeOf(llvm_type_of(element_type, structs, ctx)) return if element_type.kind == TypeKind.Struct or element_type.kind == TypeKind.Array or element_type.kind == TypeKind.DArray or element_type.kind == TypeKind.View
            return LLVMConstInt(LLVMInt64TypeInContext(ctx), scalar_byte_size(element_type), 0)


        def scalar_byte_size(value_type: ValueType) -> u64:
            1 return if value_type.kind == TypeKind.Bool
            return (value_type.bits / 8).u64()


        # The element type of an array ValueType.
        def array_element_of(value_type: ValueType, structs: mutable StructTable&) -> ValueType can[Abort.Panic]:
            unmodeled_type() return if value_type.kind != TypeKind.Array
            return copied_type(structs.array_elements[value_type.bits.usize()])


        # The index of const enum `name`, or -1.
        def enum_index_of(structs: mutable StructTable&, name: sview) -> i64 can[Abort.Panic]:
            for index in 0..<structs.enum_names.count |structs, name|:
                index.i64() return if structs.enum_names[index] == name
            return -1


        # The ORDINAL of `variant` in const enum `slot`, or -1. Ordinals are declaration
        # order — that is what stage0 compares against (`icmp eq i8 %c, 0` for the first).
        def enum_ordinal_of(structs: mutable StructTable&, slot: usize, variant: sview) -> i64 can[Abort.Panic]:
            for offset in 0..<structs.enum_variant_count[slot] |structs, slot, variant|:
                offset.i64() return if structs.enum_variants[structs.enum_variant_start[slot] + offset] == variant
            return -1


        # Resolve `Color.Green` -> (backing type, ordinal). Ordinal -1 when it is not a
        # const-enum member.
        def enum_member_ordinal(structs: mutable StructTable&, enum_name: sview, variant: sview) -> i64 can[Abort.Panic]:
            index: i64 = enum_index_of(structs, enum_name)
            -1 return if index < 0
            return enum_ordinal_of(structs, index.usize(), variant)


        # The registry index of struct `name`, or -1.
        def struct_index_of(structs: mutable StructTable&, name: sview) -> i64 can[Abort.Panic]:
            for index in 0..<structs.names.count |structs, name|:
                index.i64() return if structs.names[index] == name
            return -1


        # The position of `field` within struct `struct_index`, or -1. This IS the LLVM
        # element index: fields are emitted in declaration order.
        def field_index_of(structs: mutable StructTable&, struct_index: usize, field: sview) -> i64 can[Abort.Panic]:
            for offset in 0..<structs.field_count[struct_index] |structs, struct_index, field|:
                offset.i64() return if structs.field_names[structs.field_start[struct_index] + offset] == field
            return -1


        # The runtime entry points a darray needs, plus the current function's auto
        # region. Declared once per module and threaded down, because `push` can appear
        # anywhere an expression can.
        #
        # `arena` is the function's AUTO REGION: stage0 gives every function one, zeroed,
        # with strategy 2 (lazy), and `arena_free`s it on every return path. That is the
        # first real piece of Elisa's region model in this backend — container backing
        # lives in a region, not in malloc.
        struct Runtime:
            # `arena` is per-FUNCTION (each gets its own auto region), so it is the one
            # mutable field: the module-level Runtime carries a placeholder that
            # emit_function_body replaces with the function's own region slot.
            arena: mutable LLVMValueRef
            # False when `arena` is the CALLER's, handed over as the implicit trailing
            # parameter. Freeing it then would destroy a region this function does not own
            # and the caller is still using -- so every arena_free is gated on this.
            owns_arena: mutable bool
            fast_math: mutable bool
            force_bounds_check: bool
            arena_alloc: LLVMValueRef
            arena_realloc: LLVMValueRef
            arena_free: LLVMValueRef
            arena_alloc_type: LLVMTypeRef
            arena_realloc_type: LLVMTypeRef
            arena_free_type: LLVMTypeRef
            # `region r(4096):` — a region with an explicit CAPACITY gets its backing up
            # front from the runtime (`call ptr @new_region_backend(i64 4096, i64 0)`)
            # instead of the lazy strategy an auto region uses.
            new_region_backend: LLVMValueRef
            new_region_backend_type: LLVMTypeRef
            # The AoS store's runtime entry points. The store is RUNTIME-CALL based rather
            # than open-coded, which is why porting it is declaring these and calling them.
            packed_state_new: LLVMValueRef
            packed_state_new_type: LLVMTypeRef
            packed_alloc: LLVMValueRef
            packed_alloc_type: LLVMTypeRef
            packed_alloc_result_type: LLVMTypeRef
            packed_read_tag: LLVMValueRef
            packed_read_tag_type: LLVMTypeRef
            packed_read_word: LLVMValueRef
            packed_read_word_type: LLVMTypeRef
            packed_record_prefix: LLVMValueRef
            packed_record_prefix_type: LLVMTypeRef
            packed_mode: i32
            # The store an `in store:` block made ACTIVE, and which packed enum it stores
            # (-1 = none). Threaded on Runtime for the same reason `arena` is: a packed
            # constructor names no store, it uses whichever one is in scope. stage0 is
            # explicit that this is required, not implicit -- "packed enum constructor
            # Node.Leaf requires an active in Node.Store: scope".
            active_store: mutable LLVMValueRef
            active_store_enum: mutable i64
            # When the current function returns an error union: the leading `ptr` out-param
            # (the T value is stored through it) and a flag. A `return x` then stores x to
            # the out-param and returns `i32 0`; a `raise` returns `i32 (ordinal + 1)`.
            error_out: mutable LLVMValueRef
            in_error_fn: mutable bool
            # `cstr == cstr` / `!=` lower to `ctx_streq(a, b)` (i64, nonzero = equal), the
            # same content comparison stage0 emits — NOT a pointer compare.
            streq: LLVMValueRef
            streq_type: LLVMTypeRef
            # `sview == sview` / `!=` lower to `ctx_string_views_eq(a, b)` (i64, nonzero =
            # equal), taking two `%StringView` values BY VALUE.
            sview_eq: LLVMValueRef
            sview_eq_type: LLVMTypeRef
            # `sview[i]` lowers to `ctx_string_view_index(sv, i)` (i64 byte), the view passed
            # BY VALUE.
            sview_index: LLVMValueRef
            sview_index_type: LLVMTypeRef
            # DWARF. A variable DIE only reaches the object when a DECLARE record ties it to
            # its storage, so these must be available AT the alloca -- carried on Runtime
            # (already threaded everywhere) rather than in a separate later pass.
            # `debug_active` is false for a `-g`-less build, where every declare is skipped.
            debug_builder: mutable LLVMDIBuilderRef
            debug_file: mutable LLVMMetadataRef
            debug_active: mutable bool
            # Optional stage0-compatible execution trace hook. The runtime owns the ring
            # buffer; the backend only supplies the current function and source line.
            trace_record: LLVMValueRef
            trace_record_type: LLVMTypeRef
            trace_record_value: LLVMValueRef
            trace_record_value_type: LLVMTypeRef
            trace_name: mutable LLVMValueRef
            trace_enabled: mutable bool
            # The stage0 trace runtime installs the optional SIGSEGV/SIGBUS referee
            # lazily. The backend calls its idempotent entry point when trace emission is
            # enabled so fault-time records use the same ring as ordinary steps.
            trace_fault_install: LLVMValueRef
            trace_fault_install_type: LLVMTypeRef
            # Active per-function disjoint scope state. The slot arrays are rebuilt for
            # each body so element GEPs can be associated with their source parameter.
            disjoint_function_name: mutable sview
            disjoint_function_mask: mutable u64
            disjoint_param_slots: mutable darray[LLVMValueRef]
            disjoint_param_indices: mutable darray[u32]
            disjoint_element_ptrs: mutable darray[LLVMValueRef]
            disjoint_element_indices: mutable darray[u32]


        # Declare the runtime entry points in the module. Signatures are dictated by
        # elisacore_runtime.o (read from stage0's own emitted IR):
        #   ptr  arena_alloc(ptr arena, i64 bytes)
        #   ptr  arena_realloc(ptr arena, ptr old, i64 old_bytes, i64 new_bytes)
        #   void arena_free(ptr arena)
        def declare_runtime(m: LLVMModuleRef, ctx: LLVMContextRef, enable_trace: bool, packed_mode: i32) -> Runtime can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            pointer_type: LLVMTypeRef = LLVMPointerTypeInContext(ctx, 0)
            int64_type: LLVMTypeRef = LLVMInt64TypeInContext(ctx)

            alloc_params: mutable darray[LLVMTypeRef] = [pointer_type, int64_type]
            alloc_pointer: void& = (&alloc_params[0]).cast[void&] can Unsafe.PointerCast
            alloc_type: LLVMTypeRef = LLVMFunctionType(pointer_type, alloc_pointer, 2, 0)

            realloc_params: mutable darray[LLVMTypeRef] = [pointer_type, pointer_type, int64_type, int64_type]
            realloc_pointer: void& = (&realloc_params[0]).cast[void&] can Unsafe.PointerCast
            realloc_type: LLVMTypeRef = LLVMFunctionType(pointer_type, realloc_pointer, 4, 0)

            free_params: mutable darray[LLVMTypeRef] = [pointer_type]
            free_pointer: void& = (&free_params[0]).cast[void&] can Unsafe.PointerCast
            free_type: LLVMTypeRef = LLVMFunctionType(LLVMVoidTypeInContext(ctx), free_pointer, 1, 0)

            backend_params: mutable darray[LLVMTypeRef] = [LLVMInt64TypeInContext(ctx), LLVMInt64TypeInContext(ctx)]
            backend_pointer: void& = (&backend_params[0]).cast[void&] can Unsafe.PointerCast
            backend_type: LLVMTypeRef = LLVMFunctionType(pointer_type, backend_pointer, 2, 0)

            int32_type: LLVMTypeRef = LLVMInt32TypeInContext(ctx)
            state_new_params: mutable darray[LLVMTypeRef] = [pointer_type, int64_type]
            state_new_pointer: void& = (&state_new_params[0]).cast[void&] can Unsafe.PointerCast
            state_new_type: LLVMTypeRef = LLVMFunctionType(pointer_type, state_new_pointer, 2, 0)

            # `%PackedStoreIndexAllocResult = { ptr row, i32 index }`
            alloc_result_fields: mutable darray[LLVMTypeRef] = [pointer_type, int32_type]
            alloc_result_pointer: void& = (&alloc_result_fields[0]).cast[void&] can Unsafe.PointerCast
            alloc_result_type: LLVMTypeRef = LLVMStructTypeInContext(ctx, alloc_result_pointer, 2, 0)
            packed_alloc_params: mutable darray[LLVMTypeRef] = [pointer_type, pointer_type, int32_type]
            if packed_mode == 2:
                packed_alloc_params <- [pointer_type, pointer_type]
            packed_alloc_params_pointer: void& = (&packed_alloc_params[0]).cast[void&] can Unsafe.PointerCast
            alloc_fn_type: LLVMTypeRef = LLVMFunctionType(alloc_result_type, packed_alloc_params_pointer, 2 if packed_mode == 2 else 3, 0)

            read_tag_params: mutable darray[LLVMTypeRef] = [pointer_type, int32_type]
            if packed_mode == 2:
                read_tag_params <- [pointer_type, int64_type]
            read_tag_pointer: void& = (&read_tag_params[0]).cast[void&] can Unsafe.PointerCast
            read_tag_type: LLVMTypeRef = LLVMFunctionType(pointer_type if packed_mode == 2 else int32_type, read_tag_pointer, 2, 0)

            read_word_params: mutable darray[LLVMTypeRef] = [int32_type, pointer_type, int64_type]
            if packed_mode == 1:
                read_word_params <- [pointer_type, int32_type, pointer_type, int64_type]
            if packed_mode == 2:
                read_word_params <- [pointer_type, int32_type]
            read_word_pointer: void& = (&read_word_params[0]).cast[void&] can Unsafe.PointerCast
            read_word_type: LLVMTypeRef = LLVMFunctionType(pointer_type if packed_mode == 2 else int64_type, read_word_pointer, 2 if packed_mode == 2 else (4 if packed_mode == 1 else 3), 0)

            record_prefix_params: mutable darray[LLVMTypeRef] = [pointer_type, pointer_type, pointer_type]
            record_prefix_pointer: void& = (&record_prefix_params[0]).cast[void&] can Unsafe.PointerCast
            record_prefix_type: LLVMTypeRef = LLVMFunctionType(LLVMVoidTypeInContext(ctx), record_prefix_pointer, 3, 0)

            streq_params: mutable darray[LLVMTypeRef] = [pointer_type, pointer_type]
            streq_pointer: void& = (&streq_params[0]).cast[void&] can Unsafe.PointerCast
            streq_type: LLVMTypeRef = LLVMFunctionType(int64_type, streq_pointer, 2, 0)

            sview_struct_fields: mutable darray[LLVMTypeRef] = [pointer_type, int64_type]
            sview_struct_pointer: void& = (&sview_struct_fields[0]).cast[void&] can Unsafe.PointerCast
            sview_struct_llvm: LLVMTypeRef = LLVMStructTypeInContext(ctx, sview_struct_pointer, 2, 0)
            sview_eq_params: mutable darray[LLVMTypeRef] = [sview_struct_llvm, sview_struct_llvm]
            sview_eq_pointer: void& = (&sview_eq_params[0]).cast[void&] can Unsafe.PointerCast
            sview_eq_type: LLVMTypeRef = LLVMFunctionType(int64_type, sview_eq_pointer, 2, 0)

            sview_index_params: mutable darray[LLVMTypeRef] = [sview_struct_llvm, int64_type]
            sview_index_pointer: void& = (&sview_index_params[0]).cast[void&] can Unsafe.PointerCast
            sview_index_type: LLVMTypeRef = LLVMFunctionType(int64_type, sview_index_pointer, 2, 0)

            trace_params: mutable darray[LLVMTypeRef] = [pointer_type, int32_type]
            trace_pointer: void& = (&trace_params[0]).cast[void&] can Unsafe.PointerCast
            trace_type: LLVMTypeRef = LLVMFunctionType(LLVMVoidTypeInContext(ctx), trace_pointer, 2, 0)
            trace_value_params: mutable darray[LLVMTypeRef] = [pointer_type, int32_type, pointer_type, int64_type]
            trace_value_pointer: void& = (&trace_value_params[0]).cast[void&] can Unsafe.PointerCast
            trace_value_type: LLVMTypeRef = LLVMFunctionType(LLVMVoidTypeInContext(ctx), trace_value_pointer, 4, 0)
            trace_fault_install_type: LLVMTypeRef = LLVMFunctionType(LLVMVoidTypeInContext(ctx), null, 0, 0)
            trace_record_handle: LLVMValueRef = LLVMAddFunction(m, "elisa_trace_record", trace_type) if enable_trace else zeroed
            trace_record_value_handle: LLVMValueRef = LLVMAddFunction(m, "elisa_trace_record_value", trace_value_type) if enable_trace else zeroed
            trace_fault_install_handle: LLVMValueRef = LLVMAddFunction(m, "elisa_trace_install_fault_handler", trace_fault_install_type) if enable_trace else zeroed
            aos_record_handle: LLVMValueRef = LLVMAddFunction(m, "ctx_aos_store_record", read_tag_type) if packed_mode == 2 else zeroed

            return Runtime{
                streq: LLVMAddFunction(m, "ctx_streq", streq_type),
                streq_type: streq_type,
                sview_eq: LLVMAddFunction(m, "ctx_string_views_eq", sview_eq_type),
                sview_eq_type: sview_eq_type,
                sview_index: LLVMAddFunction(m, "ctx_string_view_index", sview_index_type),
                sview_index_type: sview_index_type,
                # Filled in by emit_module_with_debug when `-g` is on; `debug_active` gates
                # every use, so the placeholders are never dereferenced otherwise.
                debug_builder: zeroed,
                debug_file: zeroed,
                debug_active: false,
                trace_record: trace_record_handle,
                trace_record_type: trace_type,
                trace_record_value: trace_record_value_handle,
                trace_record_value_type: trace_value_type,
                trace_name: LLVMConstNull(pointer_type),
                trace_enabled: false,
                trace_fault_install: trace_fault_install_handle,
                trace_fault_install_type: trace_fault_install_type,
                disjoint_function_name: "",
                disjoint_function_mask: 0,
                disjoint_param_slots: [],
                disjoint_param_indices: [],
                disjoint_element_ptrs: [],
                disjoint_element_indices: [],
                owns_arena: true,
                fast_math: false,
                force_bounds_check: force_bounds_check_enabled(),
                active_store: LLVMConstNull(pointer_type),
                active_store_enum: -1,
                error_out: LLVMConstNull(pointer_type),
                in_error_fn: false,
                packed_mode: packed_mode,
                packed_state_new: LLVMAddFunction(m, "ctx_aos_store_new" if packed_mode == 2 else ("ctx_packed_store_state_new" if packed_mode == 1 else "ctx_packed_store_state_new_variant_sparse"), state_new_type),
                packed_state_new_type: state_new_type,
                packed_alloc: LLVMAddFunction(m, "ctx_aos_store_alloc" if packed_mode == 2 else ("ctx_packed_store_alloc_fixed_tagged_index_result" if packed_mode == 1 else "ctx_packed_store_alloc_fixed_tagged_variant_sparse_result"), alloc_fn_type),
                packed_alloc_type: alloc_fn_type,
                packed_alloc_result_type: alloc_result_type,
                packed_read_tag: aos_record_handle if packed_mode == 2 else LLVMAddFunction(m, "ctx_packed_store_read_index_tag" if packed_mode == 1 else "ctx_packed_store_read_variant_sparse_tag", read_tag_type),
                packed_read_tag_type: read_tag_type,
                packed_read_word: aos_record_handle if packed_mode == 2 else LLVMAddFunction(m, "ctx_packed_store_read_index_word" if packed_mode == 1 else "ctx_packed_store_read_variant_sparse_word", read_word_type),
                packed_read_word_type: read_word_type,
                packed_record_prefix: LLVMAddFunction(m, "ctx_packed_store_record_prefix_words", record_prefix_type) if packed_mode == 1 else zeroed,
                packed_record_prefix_type: record_prefix_type,
                new_region_backend: LLVMAddFunction(m, "new_region_backend", backend_type),
                new_region_backend_type: backend_type,
                arena_alloc: LLVMAddFunction(m, "arena_alloc", alloc_type),
                arena_realloc: LLVMAddFunction(m, "arena_realloc", realloc_type),
                arena_free: LLVMAddFunction(m, "arena_free", free_type),
                arena_alloc_type: alloc_type,
                arena_realloc_type: realloc_type,
                arena_free_type: free_type,
                # No region until a function supplies its own; a null placeholder keeps
                # the module clean (declaring a dummy function to fill this would emit a
                # bogus symbol).
                arena: LLVMConstNull(pointer_type)
            }


        # Generic function TEMPLATES, and the instantiations made from them.
        #
        # The instantiation cache is keyed by (base name, type argument) — NOT by mangled
        # name. That is deliberate: an `sview` is a view, so a mangled name built into a
        # local buffer would DANGLE the moment the buffer's region died (Elisa's region
        # checker catches exactly this). `base_names` are sviews into the SOURCE buffer,
        # which outlives everything, and ValueType is POD — so nothing here borrows.
        #
        # The mangled name is only ever needed transiently, to hand to LLVMAddFunction,
        # which COPIES it. So it is built in a local buffer, used, and dropped.
        #
        # Generic parameter names come from the FILE-level side table
        # (`generic_param_names` / `generic_param_lines`) keyed by the function's LINE —
        # they are NOT on Decl.Func. A row whose line has the high bit set is a BOUND
        # (`[T: Ord]`): metadata the backend never needs, since it only instantiates types
        # the frontend already accepted.
        struct GenericTable:
            names: mutable darray[sview]
            decls: mutable darray[Decl]
            params: mutable darray[sview]
            param_start: mutable darray[usize]
            param_count: mutable darray[usize]
            # Whether each template is ERROR-RETURNING (`… error[E]`): its instantiations must
            # use the i32-status + leading-out-param ABI, in both the signature and the body.
            # Computed at registration from the file's error-line side table (a template has no
            # `error[E]` node on its Decl — the clause is consumed at parse time).
            is_error: mutable darray[bool]
            # Instantiations, keyed by (base name, type-argument TUPLE). A generic may have
            # more than one type parameter (`arena_dict_put[K, T]`), so the arguments live in
            # a flat pool with a per-instantiation span rather than one ValueType per row.
            inst_bases: mutable darray[sview]
            inst_args: mutable darray[ValueType]
            inst_arg_start: mutable darray[usize]
            inst_arg_count: mutable darray[usize]
            inst_handles: mutable darray[LLVMValueRef]
            # The template SLOT each instantiation came from. Redundant with the base name UNLESS
            # the name is overloaded (`len[T](Slice)` vs `len[T](ReadView)`): then base+args are not
            # unique, so the slot is what distinguishes the two — used to key the cache and to emit
            # the correct BODY (emit_instantiation_body must not re-derive the slot by first-name).
            inst_slots: mutable darray[usize]
            # The WORKLIST: instantiations declared but whose BODY still needs emitting. A
            # body cannot be emitted at the call site (the builder sits inside the caller),
            # so emit_module drains this afterwards — and keeps draining, because a generic
            # can call another generic. Type args are pooled the same way as inst_args.
            pending_bases: mutable darray[sview]
            pending_args: mutable darray[ValueType]
            pending_arg_start: mutable darray[usize]
            pending_arg_count: mutable darray[usize]
            pending_handles: mutable darray[LLVMValueRef]
            # The template slot for each queued body (parallel to pending_bases). emit_instantiation_body
            # emits generics.decls[this slot] — NOT decls[generic_index_of(base)], which would pick the
            # first overload's body for an overloaded name.
            pending_slots: mutable darray[usize]


        def new_generic_table() -> GenericTable can[Abort.Panic, Memory.Allocate]:
            return GenericTable{names: [], decls: [], params: [], param_start: [], param_count: [], is_error: [], inst_bases: [], inst_args: [], inst_arg_start: [], inst_arg_count: [], inst_handles: [], inst_slots: [], pending_bases: [], pending_args: [], pending_arg_start: [], pending_arg_count: [], pending_handles: [], pending_slots: []}


        # Push one type-parameter binding per (param name, type arg) for template `slot`, so
        # annotation_value_type resolves the template's `K`/`T` to the concrete args. Returns
        # the number pushed, to pop symmetrically with pop_type_bindings.
        def push_type_bindings(generics: GenericTable&, structs: mutable StructTable&, slot: usize, type_args: darray[ValueType]&) -> usize can[Abort.Panic, Memory.Allocate]:
            pstart: usize = generics.param_start[slot]
            count: usize = generics.param_count[slot]
            bound: mutable usize = 0
            for k in 0..<count |structs, generics, pstart, type_args, bound, count|:
                break if k >= type_args.count
                structs.binding_names <- structs.binding_names.push(generics.params[pstart + k])
                structs.binding_types <- structs.binding_types.push(copied_type(type_args[k]))
                bound <- bound + 1
            return bound


        def pop_type_bindings(structs: mutable StructTable&, count: usize) -> void can[Abort.Panic, Memory.Allocate]:
            for _drop in 0..<count |structs|:
                _ = structs.binding_names.pop()
                _ = structs.binding_types.pop()


        # The position of type-parameter `name` in template `slot`, or -1. Used by inference
        # to bind the argument that pins that parameter.
        def type_param_position(generics: GenericTable&, slot: usize, name: sview) -> i64 can[Abort.Panic]:
            pstart: usize = generics.param_start[slot]
            count: usize = generics.param_count[slot]
            for k in 0..<count |generics, pstart, name, count|:
                k.i64() return if generics.params[pstart + k] == name
            return -1


        # UNIFY a parameter's type annotation against the CONCRETE type of the argument
        # passed for it, binding any type parameters it names. `mutable`/`&` qualifiers are
        # transparent (the argument's value type is what matters), and a `Base[..]` annotation
        # recurses into a matching generic-struct instantiation's stored arguments — so
        # `dict[K, T]&` unified against a `DynDict[i64, i64]` argument pins K=i64, T=i64.
        def unify_annotation(annotation: Expr, actual: ValueType, generics: GenericTable&, slot: usize, structs: StructTable&, bindings: mutable darray[ValueType]&, bound_flags: mutable darray[bool]&) -> void can[Abort.Panic, Memory.Allocate]:
            if annotation is Expr.Unary(qualifier, inner_annotation, qualifier_line):
                # `mutable T` is transparent. `T&` strips a reference on BOTH sides in step:
                # the argument for a `Bucket[T]&` parameter is often a `Bucket[i64]&` (e.g.
                # `&arr[0]`), so the outer `&` must peel off the actual's Ref too before the
                # inner `Bucket[T]` unifies against the instantiation.
                unify_annotation(inner_annotation, actual, generics, slot, structs, bindings, bound_flags) if qualifier == TokenKind.Mutable
                if qualifier == TokenKind.Ampersand:
                    # Read the referent directly (ref_target_of would demand a mutable table).
                    stripped_actual: ValueType = copied_type(structs.ref_targets[actual.bits.usize()]) if actual.kind == TypeKind.Ref else copied_type(actual)
                    unify_annotation(inner_annotation, stripped_actual, generics, slot, structs, bindings, bound_flags)
                return
            if annotation is Expr.Ident(param_name, param_name_line):
                position: i64 = type_param_position(generics, slot, param_name)
                if position >= 0 and not bound_flags[position.usize()]:
                    bindings[position.usize()] <- copied_type(actual)
                    bound_flags[position.usize()] <- true
                return
            # `view[T]` annotation against a `view[U]` argument — bind T from the view's
            # interned element. Checked before the generic-struct branch (a View is not a
            # struct instantiation), so `arena_da_fill(view, …)` recovers its element type.
            if annotation is Expr.Index(view_annotation_head, view_annotation_arg, view_annotation_line):
                if view_annotation_head is Expr.Ident(view_annotation_name, view_annotation_head_line):
                    if view_annotation_name == "view" and actual.kind == TypeKind.View:
                        unify_annotation(view_annotation_arg, copied_type(structs.view_elements[actual.bits.usize()]), generics, slot, structs, bindings, bound_flags)
                        return
                    # `darray[T]` annotation against a `darray[U]` argument — bind T from the
                    # argument's element (like the view case). Needed so a generic over a darray
                    # PARAMETER (`slice[T](da: darray[T]&)`, `arena_da_fill[T](darray[T]&, …)`)
                    # infers T; the outer `&` was already peeled by the Unary branch above.
                    if view_annotation_name == "darray" and actual.kind == TypeKind.DArray:
                        unify_annotation(view_annotation_arg, copied_type(structs.darray_elements[actual.bits.usize()]), generics, slot, structs, bindings, bound_flags)
                        return
            # `Base[A]` / `Base[A, B]` — recurse into the argument's instantiation arguments
            # when the argument is that same generic struct.
            actual_base: mutable sview = ""
            actual_arg_start: mutable usize = 0
            actual_arg_count: mutable usize = 0
            has_instantiation: bool = generic_struct_instantiation_of(structs, actual, actual_base, actual_arg_start, actual_arg_count)
            return if not has_instantiation
            if annotation is Expr.Index(base_head, single_type_arg, index_line):
                if base_head is Expr.Ident(base_name, base_head_line):
                    mapped_base: sview = "DynDict" if base_name == "dict" else ("DynSet" if base_name == "set" else base_name)
                    if mapped_base == actual_base and actual_arg_count == 1:
                        unify_annotation(single_type_arg, copied_type(structs.generic_struct_inst_args[actual_arg_start]), generics, slot, structs, bindings, bound_flags)
                return
            if annotation is Expr.IndexN(multi_base_head, multi_type_args, multi_index_line):
                if multi_base_head is Expr.Ident(multi_base_name, multi_base_head_line):
                    mapped_multi_base: sview = "DynDict" if multi_base_name == "dict" else ("DynSet" if multi_base_name == "set" else multi_base_name)
                    if mapped_multi_base == actual_base and actual_arg_count == multi_type_args.count:
                        for arg_position in 0..<multi_type_args.count |multi_type_args, actual_arg_start, generics, slot, structs, bindings, bound_flags|:
                            unify_annotation(multi_type_args[arg_position], copied_type(structs.generic_struct_inst_args[actual_arg_start + arg_position]), generics, slot, structs, bindings, bound_flags)
                return


        # If `value_type` is a materialized generic-struct instantiation, report its base name
        # and the flat span of its stored type arguments.
        def generic_struct_instantiation_of(structs: StructTable&, value_type: ValueType, out_base: mutable sview&, out_arg_start: mutable usize&, out_arg_count: mutable usize&) -> bool can[Abort.Panic]:
            false return if value_type.kind != TypeKind.Struct
            for inst in 0..<structs.generic_struct_inst_index.count |structs, value_type, out_base, out_arg_start, out_arg_count|:
                if structs.generic_struct_inst_index[inst] == value_type.bits.usize():
                    out_base <- structs.generic_struct_inst_bases[inst]
                    out_arg_start <- structs.generic_struct_inst_arg_start[inst]
                    out_arg_count <- structs.generic_struct_inst_arg_count[inst]
                    return true
            return false


        # Infer a generic function's full type-argument tuple from its call arguments, by
        # unifying each parameter annotation against the argument's concrete type. Returns the
        # inferred tuple, or an empty darray if any parameter stayed unbound (the caller then
        # declines, or requires an explicit `f[K, V](…)`).
        # A bare integer literal, or a unary +/- wrapping one — the forms that carry no
        # expression type of their own but should default to i64 for generic inference.
        def is_int_literal_expr(expression: Expr) -> bool can[Abort.Panic]:
            true return if expression is Expr.IntLit(literal_value)
            if expression is Expr.Unary(unary_operator, unary_operand, unary_line):
                return (unary_operator == TokenKind.Minus or unary_operator == TokenKind.Plus) and is_int_literal_expr(unary_operand)
            if expression is Expr.Paren(paren_inner, paren_line):
                return is_int_literal_expr(paren_inner)
            return false

        def infer_generic_args(slot: usize, arguments: darray[Expr]&, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&) -> darray[ValueType] can[Abort.Panic, Memory.Allocate]:
            count: usize = generics.param_count[slot]
            bindings: mutable darray[ValueType] = [unmodeled_type() for _slot_index in 0..<count]
            bound_flags: mutable darray[bool] = [false for _flag_index in 0..<count]
            no_args: darray[ValueType] = []
            if generics.decls[slot] is Decl.Func(function_name, params, return_type_opt, body, effects, decorators, line):
                limit: usize = params.count if params.count < arguments.count else arguments.count
                for position in 0..<limit |bindings, bound_flags, params, arguments, local_scope, fns, structs, generics, slot|:
                    actual: mutable ValueType = expression_type(arguments[position], local_scope, fns, structs, generics)
                    # An untyped int literal argument (`id(21)`) has no expression type of its
                    # own — like stage0's inference, default it to i64 so a bare type-parameter
                    # binds instead of leaving the call uninferable.
                    actual <- ValueType{kind: TypeKind.Signed, bits: 64} if actual.kind == TypeKind.Unmodeled and is_int_literal_expr(arguments[position])
                    continue if actual.kind == TypeKind.Unmodeled
                    unify_annotation(params[position].type_expression, actual, generics, slot, structs, bindings, bound_flags)
            for flag_index in 0..<count |bound_flags, no_args, count|:
                no_args return if not bound_flags[flag_index]
            return bindings


        # The index of generic template `name`, or -1.
        def generic_index_of(generics: GenericTable&, name: sview) -> i64 can[Abort.Panic]:
            for index in 0..<generics.names.count |generics, name|:
                index.i64() return if generics.names[index] == name
            return -1


        # The already-declared instantiation for (base, type-argument tuple), or null.
        def instantiation_of(generics: GenericTable&, base: sview, type_args: darray[ValueType]&) -> LLVMValueRef? can[Abort.Panic]:
            for index in 0..<generics.inst_bases.count |generics, base, type_args|:
                continue if generics.inst_bases[index] != base
                continue if generics.inst_arg_count[index] != type_args.count
                astart: usize = generics.inst_arg_start[index]
                matched: mutable bool = true
                for k in 0..<type_args.count |generics, matched, astart, type_args|:
                    stored: ValueType = generics.inst_args[astart + k]
                    matched <- false if stored.kind != type_args[k].kind or stored.bits != type_args[k].bits
                generics.inst_handles[index] return if matched
            return null


        # A deferred function body keeps references to the slots visible at its declaration
        # point. Capturing slots (rather than only names) preserves stage0's lexical-shadowing
        # rule when the deferred body runs later.
        struct DeferredAction:
            body: mutable darray[Stmt]
            names: mutable darray[sview]
            slots: mutable darray[LLVMValueRef]
            types: mutable darray[ValueType]
            scope_exit: bool


        # A function's local slots: `names[i]` lives in the `alloca` at `slots[i]`.
        # Parallel darrays rather than a dict: scopes are tiny (a handful of locals), a
        # linear scan beats hashing, and it keeps the opaque extern handle out of a dict's
        # key/value machinery.
        struct Scope:
            names: mutable darray[sview]
            slots: mutable darray[LLVMValueRef]
            types: mutable darray[ValueType]
            # Active structured-concurrency owners. These are backend-only lexical stacks;
            # the frontend has already checked pool/nursery nesting and submit placement.
            pool_names: mutable darray[sview]
            group_names: mutable darray[sview]
            deferred: mutable darray[DeferredAction]


        # The module's functions by name. Built in emit_module's declare pass, so a call
        # to a function defined LATER in the file still resolves.
        #
        # Kept here rather than asking LLVMGetNamedFunction: that returns NULL-or-pointer,
        # i.e. it needs `-> LLVMValueRef?`, and an extern returning an optional of an
        # opaque extern type always binds null in stage0 (silent, no diagnostic). We
        # already know every function we declared, so this is also just less work.
        struct FnTable:
            names: mutable darray[sview]
            # Source declaration line for each entry. Body emission uses this to select
            # the exact overload; name+arity is insufficient when several same-arity
            # overloads exist (notably the std `__cast__` family).
            lines: mutable darray[u32]
            # The enclosing MODULE's name, or "" for a top-level function. Functions are
            # keyed on the (owner, name) PAIR rather than on a mangled "M.get" string:
            # `names` are sviews into the SOURCE buffer, and a synthesized name has no
            # source text to point at — an sview into a growing darray would dangle. The
            # mangled form is built only as a temporary cstr for the LLVM symbol.
            owners: mutable darray[sview]
            # True when the function has an implicit trailing arena parameter (it takes a
            # growable container by reference). The CALL SITE must then pass its own arena.
            needs_arena: mutable darray[bool]
            # True when the function carries the compiler's implicit AST packed-store
            # context. Stage0 injects this trailing ABI parameter for Parser/Backend
            # functions that expose the recursive AST hierarchy; it is distinct from the
            # caller-owned Arena parameter above.
            needs_store: mutable darray[bool]
            # True when the function returns an error union `T error[E]`: its LLVM signature
            # is `i32 @f(ptr out, <params>)` -- an i32 error code, with the T value written
            # through a leading out-pointer. `returns[i]` still holds T (the success type).
            is_error: mutable darray[bool]
            # True for a C variadic extern. `param_count[i]` remains the number of fixed
            # parameters; calls may provide additional promoted C arguments after them.
            is_variadic: mutable darray[bool]
            handles: mutable darray[LLVMValueRef]
            returns: mutable darray[ValueType]
            # Parameter types as a FLAT pool plus a per-function span (`param_start[i]`,
            # `param_count[i]`) — a nested `darray[darray[ValueType]]` would make this
            # region-polymorphic for no benefit.
            param_types: mutable darray[ValueType]
            param_names: mutable darray[sview]
            param_start: mutable darray[usize]
            param_count: mutable darray[usize]


        # The enclosing loops' branch targets, innermost LAST. `break` jumps to
        # `exits[last]`, `continue` to `continues[last]`. A loop pushes before emitting its
        # body and pops after, so a `break` outside any loop finds an empty stack and
        # DECLINES rather than emitting a wild branch.
        #
        # `continue` targets differ per loop form: a `while` continues to its condition
        # block, a `for` to its INCREMENT block (skipping the increment would make
        # `continue` an infinite loop).
        struct LoopStack:
            exits: mutable darray[LLVMBasicBlockRef]
            continues: mutable darray[LLVMBasicBlockRef]


        # The OWNED regions currently live, outermost FIRST. A `return` has to unwind every
        # one of them, not just the innermost: stage0's IR for a return inside `region r:`
        # frees `%r` AND the enclosing function's auto region on that path.
        #
        # Only OWNED regions are listed. A threaded (borrowed) arena belongs to the caller
        # and is never freed here, so an arena-threading function's stack is simply empty.
        struct RegionStack:
            arenas: mutable darray[LLVMValueRef]


        # Free every live owned region, innermost FIRST (reverse declaration order), which is
        # the order stage0 emits them in.
        def emit_region_unwind(regions: RegionStack&, runtime: Runtime&, builder: LLVMBuilderRef) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            index: mutable i64 = regions.arenas.count.i64() - 1
            while index >= 0 |index, regions, runtime, builder|:
                arguments: mutable darray[LLVMValueRef] = [regions.arenas[index.usize()]]
                arguments_pointer: void& = (&arguments[0]).cast[void&] can Unsafe.PointerCast
                _ = LLVMBuildCall2(builder, runtime.arena_free_type, runtime.arena_free, arguments_pointer, 1, "")
                index <- index - 1

        # Run function-level deferred bodies in reverse registration order. Each action
        # reconstructs the lexical scope captured at its declaration, so a later shadowing
        # declaration cannot change what the deferred body observes.
        def emit_deferred_actions(local_scope: Scope&, only_scope_exit: bool, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            index: mutable i64 = local_scope.deferred.count.i64() - 1
            while index >= 0 |index, local_scope, fns, structs, generics, runtime, m, ctx, builder|:
                action: DeferredAction = local_scope.deferred[index.usize()]
                if only_scope_exit and not action.scope_exit:
                    index <- index - 1
                    continue
                captured: mutable Scope = Scope{names: [], slots: [], types: [], pool_names: [], group_names: [], deferred: []}
                for captured_name in action.names |captured, action|:
                    captured.names <- captured.names.push(captured_name)
                for captured_slot in action.slots |captured, action|:
                    captured.slots <- captured.slots.push(captured_slot)
                for captured_type in action.types |captured, action|:
                    captured.types <- captured.types.push(captured_type)
                deferred_loops: mutable LoopStack = LoopStack{exits: [], continues: []}
                deferred_regions: mutable RegionStack = RegionStack{arenas: []}
                status: EmitStatus = emit_statements(action.body, ValueType{kind: TypeKind.Void, bits: 0}, captured, deferred_loops, deferred_regions, fns, structs, generics, runtime, m, ctx, builder)
                if status != EmitStatus.Open:
                    return false
                index <- index - 1
            return true


        # What emitting a statement did to control flow.
        #
        # `Terminated` means the statement ended the block (a `return`, or an `if` whose
        # arms all returned). The emitter tracks this itself instead of asking
        # LLVMGetBasicBlockTerminator — same optional-extern bug as FnTable — and it is
        # the better design regardless: LLVM rejects a block with two terminators, so the
        # emitter must know whether a block is still open BEFORE it appends a branch.
        const enum EmitStatus of u8:
            Declined
            Open
            Terminated


        # The handle for `owner::name`, or null when there is no such function.
        # When overloads share a bare name, the first registered entry is returned —
        # prefer `lookup_function_arity` at call sites with a known argument count.
        def lookup_function(fns: FnTable&, owner: sview, name: sview) -> LLVMValueRef? can[Abort.Panic]:
            for index in 0..<fns.names.count |fns, owner, name|:
                fns.handles[index] return if fns.names[index] == name and fns.owners[index] == owner
            return null

        # Overload-aware lookup: match bare name + owner + declared parameter count
        # (arena / error-out params are not included in `arity`).
        def lookup_function_arity(fns: FnTable&, owner: sview, name: sview, arity: usize) -> LLVMValueRef? can[Abort.Panic]:
            for index in 0..<fns.names.count |fns, owner, name, arity|:
                fns.handles[index] return if fns.names[index] == name and fns.owners[index] == owner and fns.param_count[index] == arity
            return null


        # The index of `name` in the scope, or -1. Scanned back to front so a later
        # (shadowing) declaration wins.
        def lookup_index(local_scope: mutable Scope&, name: sview) -> i64 can[Abort.Panic]:
            index: mutable i64 = local_scope.names.count.i64() - 1
            while index >= 0 |local_scope, name, index|:
                index return if local_scope.names[index.usize()] == name
                index <- index - 1
            return -1


        # The alloca backing `name`, or null when the name is not a local.
        def lookup_slot(local_scope: mutable Scope&, name: sview) -> LLVMValueRef? can[Abort.Panic]:
            index: i64 = lookup_index(local_scope, name)
            null return if index < 0
            return local_scope.slots[index.usize()]


        # The declared type of `name`, or Unmodeled when it is not a local.
        def lookup_type(local_scope: mutable Scope&, name: sview) -> ValueType can[Abort.Panic]:
            index: i64 = lookup_index(local_scope, name)
            unmodeled_type() return if index < 0
            return copied_type(local_scope.types[index.usize()])


        # Record a local: name, slot and declared type, kept index-parallel.
        def declare_local(local_scope: mutable Scope&, name: sview, slot: LLVMValueRef, value_type: ValueType) -> void can[Abort.Panic, Memory.Allocate]:
            local_scope.names <- local_scope.names.push(name)
            local_scope.slots <- local_scope.slots.push(slot)
            local_scope.types <- local_scope.types.push(value_type)


        # The declared type of function `name`'s parameter `position`, or Unmodeled.
        # Emitting each argument at its parameter's type is what makes a literal argument
        # adopt the parameter type instead of defaulting to i64.
        def param_type_of(fns: FnTable&, owner: sview, name: sview, position: usize) -> ValueType can[Abort.Panic]:
            for index in 0..<fns.names.count |fns, owner, name, position|:
                if fns.names[index] == name and fns.owners[index] == owner:
                    unmodeled_type() return if position >= fns.param_count[index]
                    return copied_type(fns.param_types[fns.param_start[index] + position])
            return unmodeled_type()


        def param_type_count(fns: FnTable&, owner: sview, name: sview) -> usize can[Abort.Panic]:
            for index in 0..<fns.names.count |fns, owner, name|:
                fns.param_count[index] return if fns.names[index] == name and fns.owners[index] == owner
            return 0


        # Return the source-argument index that supplies parameter `wanted`. Positional
        # arguments fill the next unassigned parameter; labelled arguments select by name.
        # `first_position` is 1 for UFCS calls because parameter 0 is the implicit receiver.
        def named_argument_index(argument_names: darray[sview]&, parameter_names: darray[sview]&, parameter_start: usize, parameter_count: usize, first_position: usize, wanted: usize) -> i64 can[Abort.Panic, Memory.Allocate]:
            -1 return if wanted < first_position or wanted >= parameter_count
            assigned: mutable darray[bool] = [false for _slot in 0..<parameter_count]
            assigned[0] <- true if first_position == 1 and parameter_count > 0
            next_pos: mutable usize = first_position
            for argument_index in 0..<argument_names.count |assigned, next_pos, argument_names, parameter_names, parameter_start, parameter_count, first_position, wanted|:
                argument_name: sview = argument_names[argument_index]
                selected: mutable usize = parameter_count
                if argument_name != "":
                    for parameter_index in first_position..<parameter_count |selected, argument_name, parameter_names, parameter_start|:
                        if parameter_names[parameter_start + parameter_index] == argument_name:
                            selected <- parameter_index
                            break
                else:
                    while next_pos < parameter_count and assigned[next_pos] |next_pos, assigned|:
                        next_pos <- next_pos + 1
                    selected <- next_pos
                    next_pos <- next_pos + 1 if next_pos < parameter_count
                argument_index.i64() return if selected == wanted and selected < parameter_count and not assigned[selected]
                -1 return if selected >= parameter_count or assigned[selected]
                assigned[selected] <- true
            return -1


        # Generic declarations retain their parameter names in the AST rather than in FnTable.
        # Use the same source-to-parameter assignment rules as ordinary calls.
        def generic_named_argument_index(argument_names: darray[sview]&, parameters: darray[ParamDecl], wanted: usize) -> i64 can[Abort.Panic, Memory.Allocate]:
            assigned: mutable darray[bool] = [false for _slot in 0..<parameters.count]
            next_pos: mutable usize = 0
            for argument_index in 0..<argument_names.count |assigned, next_pos, argument_names, parameters, wanted|:
                argument_name: sview = argument_names[argument_index]
                selected: mutable usize = parameters.count
                if argument_name != "":
                    for parameter_index in 0..<parameters.count |selected, argument_name, parameters|:
                        if parameters[parameter_index].name == argument_name:
                            selected <- parameter_index
                            break
                else:
                    while next_pos < parameters.count and assigned[next_pos] |next_pos, assigned|:
                        next_pos <- next_pos + 1
                    selected <- next_pos
                    next_pos <- next_pos + 1 if next_pos < parameters.count
                argument_index.i64() return if selected == wanted and selected < parameters.count and not assigned[selected]
                -1 return if selected >= parameters.count or assigned[selected]
                assigned[selected] <- true
            return -1


        # Whether `owner::name` is a C variadic declaration. Only externs may currently
        # populate this flag; ordinary Elisa functions remain fixed-arity.
        def function_is_variadic(fns: FnTable&, owner: sview, name: sview) -> bool can[Abort.Panic]:
            for index in 0..<fns.names.count |fns, owner, name|:
                fns.is_variadic[index] return if fns.names[index] == name and fns.owners[index] == owner
            return false


        # C default argument promotions for the unnamed tail of a variadic call.
        def c_variadic_promoted_type(value_type: ValueType) -> ValueType can[Abort.Panic]:
            ValueType{kind: TypeKind.Signed, bits: 32} return if value_type.kind == TypeKind.Bool
            ValueType{kind: TypeKind.Signed, bits: 32} return if (value_type.kind == TypeKind.Signed or value_type.kind == TypeKind.Unsigned) and value_type.bits < 32
            ValueType{kind: TypeKind.Float, bits: 64} return if value_type.kind == TypeKind.Float and value_type.bits == 32
            return copied_type(value_type)


        # The declared return type of `name`, or Unmodeled when the module has no such
        # function.
        def lookup_return_type(fns: FnTable&, owner: sview, name: sview) -> ValueType can[Abort.Panic]:
            for index in 0..<fns.names.count |fns, owner, name|:
                copied_type(fns.returns[index]) return if fns.names[index] == name and fns.owners[index] == owner
            return unmodeled_type()


        # The type an expression yields, WITHOUT emitting anything.
        #
        # Bottom-up, and deliberately partial: an integer LITERAL has no type of its own
        # (Unmodeled) and adopts whatever its context supplies. That is why the emitters
        # thread an `expected` type downward — `a: u8 = 200` must make 200 a u8, not an
        # i64 that is then silently truncated.
        def expression_type(expression: Expr, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&) -> ValueType can[Abort.Panic]:
            if expression is Expr.Ident(ident_name, ident_line):
                # A LOCAL shadows a global const, so the scope is consulted first.
                local_type: ValueType = lookup_type(local_scope, ident_name)
                local_type return if local_type.kind != TypeKind.Unmodeled
                extern_global_index: i64 = extern_global_index_of(structs, ident_name)
                copied_type(structs.extern_global_types[extern_global_index.usize()]) return if extern_global_index >= 0
                mutable_global_index: i64 = mutable_global_index_of(structs, ident_name)
                copied_type(structs.mutable_global_types[mutable_global_index.usize()]) return if mutable_global_index >= 0
                const_index: i64 = const_index_of(structs, ident_name)
                copied_type(structs.const_types[const_index.usize()]) return if const_index >= 0 and structs.const_resolved[const_index.usize()]
                # A global const AGGREGATE is not scalar-folded but still has a known type.
                copied_type(structs.const_types[const_index.usize()]) return if const_index >= 0 and structs.const_global_ok[const_index.usize()]
                return unmodeled_type()
            if expression is Expr.Paren(paren_inner, paren_line):
                return expression_type(paren_inner, local_scope, fns, structs, generics)
            # A move has the moved value's type: it transfers ownership, not representation.
            if expression is Expr.Move(moved_value, move_line):
                return expression_type(moved_value, local_scope, fns, structs, generics)
            if expression is Expr.BoolLit(bool_value):
                return ValueType{kind: TypeKind.Bool, bits: 1}
            if expression is Expr.CharLit(char_text):
                return ValueType{kind: TypeKind.Signed, bits: 64}
            if expression is Expr.Slice(slice_object, slice_start_expr, slice_end_expr, slice_line):
                return ValueType{kind: TypeKind.SView, bits: 0}
            # A STRING literal has a type of its own (cstr) — unlike an int literal, which
            # defers to its context. There is no other string type in the subset for it to
            # adopt, and stage0 gives `"hi"` a cstr regardless of context.
            if expression is Expr.StringLit(string_text):
                return ValueType{kind: TypeKind.CStr, bits: 0}
            # A FLOAT literal, like an int literal, defers to its context (`x: f32 = 1.5`),
            # so it reports Unmodeled here rather than pinning itself to f64.
            if expression is Expr.Unary(unary_operator, unary_operand, unary_line):
                # `not x` is a bool whatever `x` is; `-x` / `~x` keep the operand's type.
                ValueType{kind: TypeKind.Bool, bits: 1} return if unary_operator == TokenKind.Not or unary_operator == TokenKind.Bang
                # `&place` is a reference to the place's type.
                if unary_operator == TokenKind.Ampersand:
                    place_type: ValueType = expression_type(unary_operand, local_scope, fns, structs, generics)
                    unmodeled_type() return if place_type.kind == TypeKind.Unmodeled
                    return intern_ref_type(place_type, structs)
                return expression_type(unary_operand, local_scope, fns, structs, generics)
            if expression is Expr.Binary(binary_left, binary_operator, binary_right, binary_line):
                # A comparison, logical, `is` narrowing, or `in` membership yields bool
                # regardless of operands.
                ValueType{kind: TypeKind.Bool, bits: 1} return if binary_operator == TokenKind.Is
                ValueType{kind: TypeKind.Bool, bits: 1} return if binary_operator == TokenKind.In
                ValueType{kind: TypeKind.Bool, bits: 1} return if int_predicate_of(binary_operator) >= 0
                ValueType{kind: TypeKind.Bool, bits: 1} return if binary_operator == TokenKind.And or binary_operator == TokenKind.Or
                # Arithmetic keeps the operands' type: take whichever side is known, since
                # a literal contributes nothing.
                left_type: ValueType = expression_type(binary_left, local_scope, fns, structs, generics)
                left_type return if left_type.kind != TypeKind.Unmodeled
                return expression_type(binary_right, local_scope, fns, structs, generics)
            # `x.cast[T]` — a reinterpret cast has the target type.
            if expression is Expr.Index(cast_type_head, cast_type_arg, cast_type_line):
                if cast_type_head is Expr.Field(cast_type_source, cast_type_method, cast_type_method_line):
                    if cast_type_method == "cast":
                        return annotation_value_type(cast_type_arg, structs)
            # `xs[i]` — an index READ yields the element type of an array, a darray, OR a
            # `Struct&` used as a C-style pointer base (`items[i]` on a `DictBucket[K,T]&`).
            if expression is Expr.Index(indexed_object, index_expression, index_line):
                indexed_type: ValueType = expression_type(indexed_object, local_scope, fns, structs, generics)
                # A byte read from a string (cstr / view[u8]) is an i64 (the runtime index
                # helpers return i64), matching stage0.
                ValueType{kind: TypeKind.Signed, bits: 64} return if indexed_type.kind == TypeKind.CStr or indexed_type.kind == TypeKind.SView
                darray_element_of(indexed_type, structs) return if indexed_type.kind == TypeKind.DArray
                if indexed_type.kind == TypeKind.Ref:
                    ref_indexed_element: ValueType = ref_target_of(indexed_type, structs)
                    ref_indexed_element return if ref_indexed_element.kind == TypeKind.Struct
                    # `p[i]` where `p: T&` is a ref to a NUMERIC scalar used as a pointer base
                    # (Slice's `p: T& = base.cast[T&]; p[i]` / `&p[lo]`): the element IS that scalar.
                    ref_indexed_element return if ref_indexed_element.kind == TypeKind.Signed or ref_indexed_element.kind == TypeKind.Unsigned or ref_indexed_element.kind == TypeKind.Float
                    # `da[i]` where `da: darray[T]&` — a borrowed darray param: the element is the
                    # darray's element (so `&da[i]` types as a ref to it, which slice() needs).
                    darray_element_of(ref_indexed_element, structs) return if ref_indexed_element.kind == TypeKind.DArray
                # `found[0]` where `found: T&?` is an optional ref to a numeric scalar (narrowed
                # non-null): the element is that scalar. index_map_find_index reads it this way.
                if indexed_type.kind == TypeKind.Optional:
                    opt_indexed_payload: ValueType = optional_payload_of(indexed_type, structs)
                    if opt_indexed_payload.kind == TypeKind.Ref:
                        opt_indexed_elem: ValueType = ref_target_of(opt_indexed_payload, structs)
                        opt_indexed_elem return if opt_indexed_elem.kind == TypeKind.Signed or opt_indexed_elem.kind == TypeKind.Unsigned or opt_indexed_elem.kind == TypeKind.Float
                return array_element_of(indexed_type, structs)
            # `p.x` — a field READ has the field's declared type. (A cast `x.u8()` is a
            # Field under a Call, handled below, so a bare Field is always a field read.)
            # `Color.Green` / `Lexer::TokenKind.Ident` has the enum's BACKING type.
            if expression is Expr.Field(enum_head, enum_member, enum_head_line):
                enum_head_name: mutable sview = ""
                if enum_head is Expr.Ident(enum_ident_name, enum_ident_line):
                    enum_head_name <- enum_ident_name
                # Module-qualified enum type: `Lexer::TokenKind.Ident`.
                if enum_head is Expr.Scope(enum_scope_head, enum_scope_name, enum_scope_line):
                    enum_head_name <- enum_scope_name
                if enum_head_name != "":
                    penum_head_index: i64 = penum_index_of(structs, enum_head_name)
                    ValueType{kind: TypeKind.PayloadEnum, bits: penum_head_index.u32()} return if penum_head_index >= 0
                    enum_slot: i64 = enum_index_of(structs, enum_head_name)
                    if enum_slot >= 0:
                        copied_type(structs.enum_backings[enum_slot.usize()]) return if enum_ordinal_of(structs, enum_slot.usize(), enum_member) >= 0
            if expression is Expr.Field(field_object, field_name, field_line):
                # Bitset flag names type as bool (`token.flags.has_suffix`).
                ValueType{kind: TypeKind.Bool, bits: 1} return if field_name == "has_suffix" or field_name == "has_prefix"
                object_type: mutable ValueType = expression_type(field_object, local_scope, fns, structs, generics)
                # AUTO-DEREF: `p.x` where `p: P&` reads P's field. A reference is
                # transparent for member access — the frontend has already decided the
                # access is legal, so the backend just looks through it. An optional HEAP
                # ref (`heap T&?`) is looked through too: stage0 represents it as a bare
                # ptr and permits flow-guarded access without narrowing.
                if object_type.kind == TypeKind.Optional:
                    field_opt_payload: ValueType = optional_payload_of(object_type, structs)
                    object_type <- field_opt_payload if field_opt_payload.kind == TypeKind.Ref and ref_is_heap_ref(field_opt_payload, structs)
                object_type <- ref_target_of(object_type, structs) if object_type.kind == TypeKind.Ref
                # Builtin string views are anonymous `{ptr, i64}` values rather than entries
                # in StructTable. Their two ABI fields are still source-visible as `.data` and
                # `.len`; resolve them directly before the named-struct path below.
                if object_type.kind == TypeKind.SView:
                    if field_name == "data":
                        return intern_ref_type(ValueType{kind: TypeKind.Unsigned, bits: 8}, structs)
                    if field_name == "len":
                        return ValueType{kind: TypeKind.Signed, bits: 64}
                    return unmodeled_type()
                # An arena CARRIER's fields read the user-declared `struct Arena`.
                object_type <- arena_user_struct(structs) if object_type.kind == TypeKind.Arena
                # `xs.count` is a usize-shaped i64.
                ValueType{kind: TypeKind.Signed, bits: 64} return if object_type.kind == TypeKind.DArray and field_name == "count"
                # A `view[T]` field read goes through its DynArrayView struct.
                object_type <- view_struct_type(object_type, structs) if object_type.kind == TypeKind.View
                unmodeled_type() return if object_type.kind != TypeKind.Struct
                struct_slot: usize = object_type.bits.usize()
                position: i64 = field_index_of(structs, struct_slot, field_name)
                unmodeled_type() return if position < 0
                return copied_type(structs.field_types[structs.field_start[struct_slot] + position.usize()])
            # `Point{x: 1, y: 2}` — a brace construction has the constructed type.
            if expression is Expr.Construct(construct_type, construct_fields, construct_line):
                return annotation_value_type(construct_type, structs)
            if expression is Expr.Call(call_callee, call_arguments, call_argument_names, call_line):
                # A call through a `fn(…)`-typed local is an indirect call; its type is the
                # fn value's declared RETURN type (so `f(f(x))` types its inner call).
                if call_callee is Expr.Ident(fn_call_name, fn_call_name_line):
                    fn_call_type: ValueType = lookup_type(local_scope, fn_call_name)
                    fn_return_type_of(fn_call_type, structs) return if fn_call_type.kind == TypeKind.Fn
                # `x.u8()` is a CAST (postfix call unifies cast and UFCS: `recv.Name()`
                # where Name is a type name is a conversion).
                if call_callee is Expr.Field(cast_object, cast_name, cast_line):
                    if cast_object is Expr.Ident(packed_call_enum, packed_call_enum_line):
                        packed_call_index: i64 = packed_index_of(structs, packed_call_enum)
                        ValueType{kind: TypeKind.PackedEnum, bits: packed_call_index.u32()} return if packed_call_index >= 0 and cast_name != "Store"
                    qualified_packed_name: sview = packed_constructor_enum_name(cast_object)
                    if qualified_packed_name != "":
                        qualified_packed_index: i64 = packed_index_of(structs, qualified_packed_name)
                        ValueType{kind: TypeKind.PackedEnum, bits: qualified_packed_index.u32()} return if qualified_packed_index >= 0 and cast_name != "Store"
                    if cast_object is Expr.Ident(store_type_enum, store_type_enum_line):
                        if cast_name == "Store":
                            store_type_index: i64 = packed_index_of(structs, store_type_enum)
                            ValueType{kind: TypeKind.PackedStore, bits: store_type_index.u32()} return if store_type_index >= 0
                    # `Shape.Circle(42)` is a payload-enum CONSTRUCTOR and has the enum's
                    # type. Checked before the cast/UFCS split: the head is an enum NAME, so
                    # neither of those readings applies.
                    if cast_object is Expr.Ident(ctor_enum_name, ctor_enum_line):
                        ctor_index: i64 = penum_index_of(structs, ctor_enum_name)
                        ValueType{kind: TypeKind.PayloadEnum, bits: ctor_index.u32()} return if ctor_index >= 0
                    # A dict receiver's `.get`/`.put`/… is a synthesized std-generic call —
                    # its type is that helper's return annotation resolved under the receiver's
                    # (K, T). Needed so `if d.get(k) is v:` can see the `T&?` it narrows.
                    dict_return_args: darray[ValueType] = dict_type_args_of(cast_object, local_scope, fns, structs, generics)
                    if dict_return_args.count != 0:
                        dict_return_helper: sview = dict_method_helper(cast_name)
                        if dict_return_helper != "":
                            return generic_return_type(dict_return_helper, dict_return_args, generics, structs)
                    # A type name is a CAST and has that type; anything else is UFCS
                    # (`p.get()` == `get(p)`) and has the FUNCTION's return type. Without
                    # the second case a UFCS call reports Unmodeled and every
                    # type-directed check downstream silently stops applying.
                    cast_type: ValueType = scalar_type_of_name(cast_name)
                    cast_type return if cast_type.kind != TypeKind.Unmodeled
                    top_ufcs: ValueType = lookup_return_type(fns, "", cast_name)
                    top_ufcs return if top_ufcs.kind != TypeKind.Unmodeled
                    # Module methods (`module Lexer: def match_char`) live under owner M.
                    # Prefer arity match: UFCS has implicit receiver + call_arguments.
                    ufcs_arity: usize = call_arguments.count + 1
                    for ufcs_ret_scan in 0..<fns.names.count |cast_name, fns, ufcs_arity|:
                        if fns.names[ufcs_ret_scan] == cast_name and fns.param_count[ufcs_ret_scan] == ufcs_arity:
                            return copied_type(fns.returns[ufcs_ret_scan])
                    ufcs_owner: mutable sview = ""
                    ufcs_hits: mutable i64 = 0
                    for ufcs_ret_scan2 in 0..<fns.names.count |ufcs_owner, ufcs_hits, cast_name, fns|:
                        if fns.names[ufcs_ret_scan2] == cast_name:
                            ufcs_hits <- ufcs_hits + 1
                            ufcs_owner <- fns.owners[ufcs_ret_scan2]
                    lookup_return_type(fns, ufcs_owner, cast_name) return if ufcs_hits == 1
                    return unmodeled_type()
                # `f[i64](x)` — an explicit generic call. Its type is the template's return
                # annotation resolved under that binding, which for `-> T` is the type
                # argument itself.
                if call_callee is Expr.Index(generic_head, generic_type_argument, generic_head_line):
                    if generic_head is Expr.Ident(generic_head_name, generic_head_name_line):
                        if generic_head_name == "clone":
                            clone_payload_type: ValueType = annotation_value_type(generic_type_argument, structs)
                            clone_error_family: sview = clone_error_family_at(generic_head_line, structs)
                            if clone_error_family != "":
                                return intern_error_union_type(clone_payload_type, clone_error_family, structs)
                            return clone_payload_type
                        if generic_index_of(generics, generic_head_name) >= 0:
                            single_return_args: mutable darray[ValueType] = [annotation_value_type(generic_type_argument, structs)]
                            return generic_return_type(generic_head_name, single_return_args, generics, structs)
                # `f[K, V](x)` — an explicit MULTI-argument generic call's type.
                if call_callee is Expr.IndexN(multi_head, multi_head_args, multi_head_line):
                    if multi_head is Expr.Ident(multi_head_name, multi_head_name_line):
                        if multi_head_name == "clone" and multi_head_args.count > 0:
                            clone_multi_payload: ValueType = annotation_value_type(multi_head_args[0], structs)
                            clone_multi_family: sview = clone_error_family_at(multi_head_line, structs)
                            if clone_multi_family != "":
                                return intern_error_union_type(clone_multi_payload, clone_multi_family, structs)
                            return clone_multi_payload
                        if generic_index_of(generics, multi_head_name) >= 0:
                            multi_return_args: mutable darray[ValueType] = []
                            for multi_return_arg_expr in multi_head_args |multi_return_args, structs|:
                                multi_return_args.push(annotation_value_type(multi_return_arg_expr, structs))
                            return generic_return_type(multi_head_name, multi_return_args, generics, structs)
                if call_callee is Expr.Ident(callee_name, callee_line):
                    # The `ctx_hash_value` builtin returns u64.
                    ValueType{kind: TypeKind.Unsigned, bits: 64} return if callee_name == "ctx_hash_value"
                    # `__fstr(…)` builds a dstr (`darray[u8]`).
                    intern_darray_type(ValueType{kind: TypeKind.Unsigned, bits: 8}, structs) return if callee_name == "__fstr"
                    ValueType{kind: TypeKind.Unsigned, bits: 64} return if callee_name == "size_of"
                    intern_ref_type(ValueType{kind: TypeKind.Void, bits: 0}, structs) return if callee_name == "arena_alloc"
                    # `i64(x)` / `u8(x)` — a prefix value CONVERSION (the canonical `T(x)`
                    # spelling; postfix `x.i64()` is on the cast path). A scalar type name applied
                    # to one argument has that scalar type. Checked before the generic/function
                    # lookup so a downstream `i64(x) - k` sees an i64 operand, not Unmodeled.
                    prefix_conversion_type: ValueType = scalar_type_of_name(callee_name)
                    prefix_conversion_type return if prefix_conversion_type.kind != TypeKind.Unmodeled and call_arguments.count == 1
                    # A GENERIC template is NOT in `fns` — only its instantiations are —
                    # so it must be resolved through the template. Without this a generic
                    # call reports Unmodeled and every type-directed check downstream
                    # (operand typing, the mixed-width guard) silently stops applying.
                    if generic_index_of(generics, callee_name) >= 0:
                        unmodeled_type() return if call_arguments.count == 0
                        inferred_return_slot: usize = generic_index_of(generics, callee_name).usize()
                        inferred_return_args: darray[ValueType] = infer_generic_args(inferred_return_slot, call_arguments, local_scope, fns, structs, generics)
                        unmodeled_type() return if inferred_return_args.count == 0
                        return generic_return_type(callee_name, inferred_return_args, generics, structs)
                    top_return: ValueType = lookup_return_type(fns, "", callee_name)
                    top_return return if top_return.kind != TypeKind.Unmodeled
                    # Bare sibling call inside a module. Prefer arity-matched overload
                    # (Token 4-arg forwarding to 5-arg); unique-name fallback otherwise.
                    bare_ret_arity: usize = call_arguments.count
                    for bare_ret_scan in 0..<fns.names.count |callee_name, fns, bare_ret_arity|:
                        if fns.names[bare_ret_scan] == callee_name and fns.param_count[bare_ret_scan] == bare_ret_arity:
                            return copied_type(fns.returns[bare_ret_scan])
                    bare_ret_owner: mutable sview = ""
                    bare_ret_hits: mutable i64 = 0
                    for bare_ret_scan2 in 0..<fns.names.count |bare_ret_owner, bare_ret_hits, callee_name, fns|:
                        if fns.names[bare_ret_scan2] == callee_name:
                            bare_ret_hits <- bare_ret_hits + 1
                            bare_ret_owner <- fns.owners[bare_ret_scan2]
                    lookup_return_type(fns, bare_ret_owner, callee_name) return if bare_ret_hits == 1
                    return unmodeled_type()
                # A module-qualified call's type is the qualified function's return type.
                if call_callee is Expr.Scope(scope_head, scope_name, scope_line):
                    if scope_head is Expr.Ident(module_name, module_name_line):
                        return lookup_return_type(fns, module_name, scope_name)
            return unmodeled_type()


        # Map an Elisa comparison token to an LLVMIntPredicate, or -1 when the operator is
        # not a comparison. Signed predicates (SLT/SLE/SGT/SGE): the subset is i64.
        def int_predicate_of(operator: TokenKind) -> i32:
            32 return if operator == TokenKind.EqEq
            33 return if operator == TokenKind.BangEq
            40 return if operator == TokenKind.Lt
            41 return if operator == TokenKind.LtEq
            38 return if operator == TokenKind.Gt
            39 return if operator == TokenKind.GtEq
            return -1


        # The same comparison for an UNSIGNED operand type. Equality is signedness-free
        # (32/33); ordering is not — SLT(40)/SLE(41)/SGT(38)/SGE(39) become
        # ULT(36)/ULE(37)/UGT(34)/UGE(35). Comparing `u8 200 < 3` with SLT reads 200 as
        # -56 and answers TRUE.
        def unsigned_predicate_of(predicate: i32) -> i32:
            36 return if predicate == 40
            37 return if predicate == 41
            34 return if predicate == 38
            35 return if predicate == 39
            return predicate


        # Emit `left <op> right` for the modeled signed-i64 operators. `null` = unmodeled,
        # so a bitwise/logical op declines rather than emitting something wrong.
        #
        # A comparison yields an `i1`; every modeled value is an i64, so the i1 is
        # zero-extended back to i64. Conditions re-narrow with `!= 0` (emit_condition),
        # which keeps ONE uniform value representation instead of tracking i1-vs-i64.
        #
        # SDiv/SRem (not UDiv/URem): the subset is signed. Elisa's `%` is LLVM's `srem`
        # (sign follows the DIVIDEND: -7 % 2 == -1) — verified against stage0, which
        # selects the same instruction for a signed operand type.
        # The ORDERED float predicate matching an integer one. Ordered = any comparison
        # with NaN is false, which is IEEE `==` / `<` semantics.
        # OEQ=1, OGT=2, OGE=3, OLT=4, OLE=5, ONE=6.
        def float_predicate_of(operator: TokenKind) -> i32:
            1 return if operator == TokenKind.EqEq
            6 return if operator == TokenKind.BangEq
            4 return if operator == TokenKind.Lt
            5 return if operator == TokenKind.LtEq
            2 return if operator == TokenKind.Gt
            3 return if operator == TokenKind.GtEq
            return -1


        def emit_binary(operator: TokenKind, left: LLVMValueRef, right: LLVMValueRef, operand_type: ValueType, structs: mutable StructTable&, fast_math: bool, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic]:
            # Floats are a different instruction family end to end: fadd/fdiv/fcmp, never
            # add/sdiv/icmp. Bitwise and shifts have no float form and decline.
            if operand_type.kind == TypeKind.Float:
                finish_float_instruction(LLVMBuildFAdd(builder, left, right, "fadd"), fast_math) return if operator == TokenKind.Plus
                finish_float_instruction(LLVMBuildFSub(builder, left, right, "fsub"), fast_math) return if operator == TokenKind.Minus
                finish_float_instruction(LLVMBuildFMul(builder, left, right, "fmul"), fast_math) return if operator == TokenKind.Star
                finish_float_instruction(LLVMBuildFDiv(builder, left, right, "fdiv"), fast_math) return if operator == TokenKind.Slash
                finish_float_instruction(LLVMBuildFRem(builder, left, right, "frem"), fast_math) return if operator == TokenKind.Percent
                float_predicate: i32 = float_predicate_of(operator)
                finish_float_instruction(LLVMBuildFCmp(builder, float_predicate, left, right, "fcmp"), fast_math) return if float_predicate >= 0
                return null
            unsigned: bool = operand_type.kind == TypeKind.Unsigned
            LLVMBuildAdd(builder, left, right, "add") return if operator == TokenKind.Plus
            LLVMBuildSub(builder, left, right, "sub") return if operator == TokenKind.Minus
            LLVMBuildMul(builder, left, right, "mul") return if operator == TokenKind.Star
            LLVMBuildAnd(builder, left, right, "and") return if operator == TokenKind.Ampersand
            LLVMBuildOr(builder, left, right, "or") return if operator == TokenKind.Pipe
            LLVMBuildXor(builder, left, right, "xor") return if operator == TokenKind.Caret
            LLVMBuildShl(builder, left, right, "shl") return if operator == TokenKind.LShift

            # Signedness picks the INSTRUCTION, and it is observable: stage0 gives
            # `u8 200 / 3` == 66 (udiv) and `u8 200 >> 1` == 100 (lshr); the signed forms
            # answer -56 and 228.
            if operator == TokenKind.Slash:
                return LLVMBuildUDiv(builder, left, right, "div") if unsigned else LLVMBuildSDiv(builder, left, right, "div")
            if operator == TokenKind.Percent:
                return LLVMBuildURem(builder, left, right, "rem") if unsigned else LLVMBuildSRem(builder, left, right, "rem")
            if operator == TokenKind.RShift:
                return LLVMBuildLShr(builder, left, right, "shr") if unsigned else LLVMBuildAShr(builder, left, right, "shr")

            predicate: i32 = int_predicate_of(operator)
            if predicate >= 0:
                resolved: i32 = unsigned_predicate_of(predicate) if unsigned else predicate
                # A comparison yields an i1 — the modeled `bool` — NOT a widened int.
                return LLVMBuildICmp(builder, resolved, left, right, "cmp")
            return null


        # Parse an integer pattern's literal TEXT (`Pattern.Literal` carries raw source
        # text, not a value). False when it is not a plain decimal integer, so a
        # char/string/float pattern DECLINES instead of being misread as a number.
        def parse_int_literal(text: sview, out_value: mutable i64&) -> bool can[Abort.Panic]:
            false return if sview_len(text) == 0
            negative: bool = sview_at(text, 0) == 45
            start: usize = 1 if negative else 0
            false return if sview_len(text) == start
            accumulated: mutable i64 = 0
            ok: mutable bool = true
            for index in start..<sview_len(text) |accumulated, ok, text|:
                byte: u8 = sview_at(text, index)
                if byte < 48 or byte > 57:
                    ok <- false
                else:
                    accumulated <- accumulated * 10 + (byte.i64() - 48)
            false return if not ok
            out_value <- 0 - accumulated if negative else accumulated
            return true


        # Char pattern / CharLit interior → Unicode code unit as i64.
        # Accepts lexer interior form (`A`, `\n`) and quoted form (`'A'`, `'\n'`).
        def parse_char_literal_code(text: sview, out_value: mutable i64&) -> bool can[Abort.Panic]:
            false return if sview_len(text) == 0
            # Quoted: `'x'` / `'\n'`.
            if sview_len(text) >= 3 and sview_at(text, 0) == 39 and sview_at(text, sview_len(text) - 1) == 39:
                inner_start: usize = 1
                inner_end: usize = sview_len(text) - 1
                false return if inner_end <= inner_start
                first: u8 = sview_at(text, inner_start)
                if first == 92:
                    false return if inner_start + 1 >= inner_end
                    esc: u8 = sview_at(text, inner_start + 1)
                    out_value <- 10 if esc == 110 else (9 if esc == 116 else (13 if esc == 114 else (0 if esc == 48 else (92 if esc == 92 else (39 if esc == 39 else esc.i64())))))
                    return true
                out_value <- first.i64()
                return true
            # Interior-only (lexer CharLit token text).
            if sview_len(text) == 1:
                out_value <- sview_at(text, 0).i64()
                return true
            if sview_len(text) >= 2 and sview_at(text, 0) == 92:
                esc2: u8 = sview_at(text, 1)
                out_value <- 10 if esc2 == 110 else (9 if esc2 == 116 else (13 if esc2 == 114 else (0 if esc2 == 48 else (92 if esc2 == 92 else (39 if esc2 == 39 else esc2.i64())))))
                return true
            return false


        # Pattern literal/range bound: integer text OR char code.
        # CharLit patterns are stored QUOTED (`'0'`) by the parser so they are distinct
        # from integer `0`. Unquoted pure decimals stay integers.
        def parse_pattern_scalar(text: sview, out_value: mutable i64&) -> bool can[Abort.Panic]:
            # Quoted char (`'x'` / `'\n'`).
            if sview_len(text) >= 2 and sview_at(text, 0) == 39:
                return parse_char_literal_code(text, out_value)
            # Escape interior without quotes (legacy).
            if sview_len(text) >= 2 and sview_at(text, 0) == 92:
                return parse_char_literal_code(text, out_value)
            # Integer (including single-digit unquoted).
            true return if parse_int_literal(text, out_value)
            # Single-byte non-digit interior (e.g. `A` if a path still omits quotes).
            return parse_char_literal_code(text, out_value)


        # `Color.Red` -> its ordinal, or -1 if the path is not a const-enum member.
        # Whether a LABELLED call is a payload-enum constructor whose label is the payload
        # field's real name: `Shape.Circle(r: 42)` where the field is declared `r`. A label
        # that names something else is a different program, so it must not be emitted as
        # this constructor.
        def penum_ctor_labels_match(callee: Expr, argument_names: darray[sview]&, structs: mutable StructTable&) -> bool can[Abort.Panic]:
            false return if argument_names.count != 1
            if callee is Expr.Field(label_head, label_variant, label_line):
                if label_head is Expr.Ident(label_enum, label_enum_line):
                    label_enum_index: i64 = penum_index_of(structs, label_enum)
                    false return if label_enum_index < 0
                    label_tag: i64 = penum_variant_index(structs, label_enum_index, label_variant)
                    false return if label_tag < 0
                    slot: usize = structs.penum_variant_start[label_enum_index.usize()] + label_tag.usize()
                    false return if not structs.penum_has_payload[slot]
                    return structs.penum_field_names[slot] == argument_names[0]
            return false


        def packed_variant_index_of_path(path: sview, structs: mutable StructTable&) -> i64 can[Abort.Panic]:
            dot: mutable i64 = -1
            for index in 0..<sview_len(path) |dot, path|:
                dot <- index.i64() if sview_at(path, index) == 46
            -1 return if dot <= 0
            for enum_index in 0..<structs.packed_names.count |structs, path, dot|:
                continue if not packed_path_matches_enum(path, structs.packed_names[enum_index], dot)
                for offset in 0..<structs.packed_variant_count[enum_index] |structs, path, dot, enum_index|:
                    variant: sview = structs.packed_variants[structs.packed_variant_start[enum_index] + offset]
                    packed_tag_base: mutable i64 = 0
                    if packed_is_ast_refinement(structs, enum_index):
                        for prior_enum in 0..<enum_index |packed_tag_base, structs|:
                            packed_tag_base <- packed_tag_base + structs.packed_variant_count[prior_enum].i64() if packed_is_ast_refinement(structs, prior_enum.i64())
                    (packed_tag_base + offset.i64()) return if sview_matches_prefix(path, variant, dot + 1, sview_len(path).i64())
            return -1


        # Source patterns may spell a refinement as `Ast::Expr.Variant` (or
        # `Ast.Expr.Variant`), while the packed registry intentionally stores the
        # leaf refinement name `Expr`. Accept both forms at the lookup boundary.
        def packed_path_matches_enum(path: sview, enum_name: sview, dot: i64) -> bool can[Abort.Panic]:
            true return if sview_matches_prefix(path, enum_name, 0, dot)
            prefix_len: i64 = sview_len(enum_name).i64()
            true return if dot == prefix_len + 5 and sview_matches_prefix(path, enum_name, 5, dot)
            true return if dot == prefix_len + 4 and sview_matches_prefix(path, enum_name, 4, dot)
            return false


        def packed_variant_index_of_parts(enum_name: sview, variant_name: sview, structs: mutable StructTable&) -> i64 can[Abort.Panic]:
            enum_index: i64 = packed_index_of(structs, enum_name)
            -1 return if enum_index < 0
            local_index: i64 = packed_variant_local_index(structs, enum_index, variant_name)
            -1 return if local_index < 0
            packed_tag_base: mutable i64 = 0
            if packed_is_ast_refinement(structs, enum_index):
                for prior_enum in 0..<enum_index |packed_tag_base, structs|:
                    packed_tag_base <- packed_tag_base + structs.packed_variant_count[prior_enum.usize()].i64() if packed_is_ast_refinement(structs, prior_enum)
            return packed_tag_base + local_index


        def packed_payload_of_path(path: sview, structs: mutable StructTable&) -> ValueType can[Abort.Panic]:
            dot: mutable i64 = -1
            for index in 0..<sview_len(path) |dot, path|:
                dot <- index.i64() if sview_at(path, index) == 46
            unmodeled_type() return if dot <= 0
            for enum_index in 0..<structs.packed_names.count |structs, path, dot|:
                continue if not packed_path_matches_enum(path, structs.packed_names[enum_index], dot)
                for offset in 0..<structs.packed_variant_count[enum_index] |structs, path, dot, enum_index|:
                    slot: usize = structs.packed_variant_start[enum_index] + offset
                    continue if not sview_matches_prefix(path, structs.packed_variants[slot], dot + 1, sview_len(path).i64())
                    unmodeled_type() return if not structs.packed_has_payload[slot]
                    return copied_type(structs.packed_payloads[slot])
            return unmodeled_type()


        # Return the packed payload pool slot for `Child.Variant`. The variant tag is
        # hierarchy-global for AST refinements, but payload metadata remains local to the
        # declaring refinement.
        def packed_slot_of_path(path: sview, structs: mutable StructTable&) -> i64 can[Abort.Panic]:
            dot: mutable i64 = -1
            for index in 0..<sview_len(path) |dot, path|:
                dot <- index.i64() if sview_at(path, index) == 46
            -1 return if dot <= 0
            for enum_index in 0..<structs.packed_names.count |structs, path, dot|:
                continue if not packed_path_matches_enum(path, structs.packed_names[enum_index], dot)
                for offset in 0..<structs.packed_variant_count[enum_index] |structs, path, dot, enum_index|:
                    slot: usize = structs.packed_variant_start[enum_index] + offset
                    slot.i64() return if sview_matches_prefix(path, structs.packed_variants[slot], dot + 1, sview_len(path).i64())
            return -1


        # The packed twin of penum_ctor_labels_match: `new Node.Leaf(v: 42)` labels the
        # payload field, and the label must be the field's real name.
        def packed_ctor_labels_match(callee: Expr, argument_names: darray[sview]&, structs: mutable StructTable&) -> bool can[Abort.Panic]:
            # With a `common:` block a constructor carries commons THEN the payload
            # (`new Expr.Int(span: 1, value: 42)`), so more than one label is legitimate.
            # Only the payload label is checked against its declared name here; the commons
            # are positional-by-construction (the parser prepends them in order).
            true return if argument_names.count > 1
            false return if argument_names.count != 1
            if callee is Expr.Field(packed_label_head, packed_label_variant, packed_label_line):
                if packed_label_head is Expr.Ident(packed_label_enum, packed_label_enum_line):
                    packed_label_index: i64 = packed_index_of(structs, packed_label_enum)
                    false return if packed_label_index < 0
                    packed_label_tag: i64 = packed_variant_index(structs, packed_label_index, packed_label_variant)
                    false return if packed_label_tag < 0
                    packed_label_slot: usize = structs.packed_variant_start[packed_label_index.usize()] + packed_variant_local_index(structs, packed_label_index, packed_label_variant).usize()
                    false return if not structs.packed_has_payload[packed_label_slot]
                    return structs.packed_field_names[packed_label_slot] == argument_names[0]
            return false


        # `Shape.Circle` -> the variant's TAG, or -1. Same byte-comparison approach as
        # ordinal_of_dotted_path, against the payload-enum pools.
        def penum_variant_index_of_path(path: sview, structs: mutable StructTable&) -> i64 can[Abort.Panic]:
            dot: mutable i64 = -1
            for index in 0..<sview_len(path) |dot, path|:
                dot <- index.i64() if sview_at(path, index) == 46
            -1 return if dot <= 0
            for enum_index in 0..<structs.penum_names.count |structs, path, dot|:
                continue if not sview_matches_prefix(path, structs.penum_names[enum_index], 0, dot)
                for offset in 0..<structs.penum_variant_count[enum_index] |structs, path, dot, enum_index|:
                    variant: sview = structs.penum_variants[structs.penum_variant_start[enum_index] + offset]
                    offset.i64() return if sview_matches_prefix(path, variant, dot + 1, sview_len(path).i64())
            return -1


        # `Shape.Circle` -> its payload's ValueType, or Unmodeled when the path names no
        # payload-carrying variant.
        def penum_payload_of_path(path: sview, structs: mutable StructTable&) -> ValueType can[Abort.Panic]:
            dot: mutable i64 = -1
            for index in 0..<sview_len(path) |dot, path|:
                dot <- index.i64() if sview_at(path, index) == 46
            unmodeled_type() return if dot <= 0
            for enum_index in 0..<structs.penum_names.count |structs, path, dot|:
                continue if not sview_matches_prefix(path, structs.penum_names[enum_index], 0, dot)
                for offset in 0..<structs.penum_variant_count[enum_index] |structs, path, dot, enum_index|:
                    slot: usize = structs.penum_variant_start[enum_index] + offset
                    continue if not sview_matches_prefix(path, structs.penum_variants[slot], dot + 1, sview_len(path).i64())
                    unmodeled_type() return if not structs.penum_has_payload[slot]
                    return copied_type(structs.penum_payloads[slot])
            return unmodeled_type()

        # The variant-slot for `Enum.Variant` (an index into the per-variant pools), or -1.
        def penum_slot_of_path(path: sview, structs: mutable StructTable&) -> i64 can[Abort.Panic]:
            dot: mutable i64 = -1
            for index in 0..<sview_len(path) |dot, path|:
                dot <- index.i64() if sview_at(path, index) == 46
            -1 return if dot <= 0
            for enum_index in 0..<structs.penum_names.count |structs, path, dot|:
                continue if not sview_matches_prefix(path, structs.penum_names[enum_index], 0, dot)
                for offset in 0..<structs.penum_variant_count[enum_index] |structs, path, dot, enum_index|:
                    slot: usize = structs.penum_variant_start[enum_index] + offset
                    (structs.penum_variant_start[enum_index] + offset).i64() return if sview_matches_prefix(path, structs.penum_variants[slot], dot + 1, sview_len(path).i64())
            return -1

        # The `{T0, T1, …}` tuple LLVM type over a MULTI-FIELD variant-slot's fields — the
        # value stored into (and loaded from) the `[N x i64]` payload blob. Only meaningful
        # when `penum_field_type_count[slot] > 1`.
        def penum_field_tuple_type(slot: usize, structs: mutable StructTable&, ctx: LLVMContextRef) -> LLVMTypeRef can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            field_count: usize = structs.penum_field_type_count[slot]
            field_start: usize = structs.penum_field_type_start[slot]
            field_llvm: mutable darray[LLVMTypeRef] = []
            for field_index in 0..<field_count |field_llvm, field_start, structs, ctx|:
                field_llvm.push(llvm_type_of(copied_type(structs.penum_field_types[field_start + field_index]), structs, ctx))
            field_pointer: void& = (&field_llvm[0]).cast[void&] can Unsafe.PointerCast
            return LLVMStructTypeInContext(ctx, field_pointer, field_count.u32(), 0)


        # `Shape.Circle` -> the enclosing enum's ValueType, or Unmodeled.
        def penum_type_of_path(path: sview, structs: mutable StructTable&) -> ValueType can[Abort.Panic]:
            dot: mutable i64 = -1
            for index in 0..<sview_len(path) |dot, path|:
                dot <- index.i64() if sview_at(path, index) == 46
            unmodeled_type() return if dot <= 0
            for enum_index in 0..<structs.penum_names.count |structs, path, dot|:
                ValueType{kind: TypeKind.PayloadEnum, bits: enum_index.u32()} return if sview_matches_prefix(path, structs.penum_names[enum_index], 0, dot)
            return unmodeled_type()


        # `E.Variant` as an Expr.Field -> the variant's ordinal in its (payload-free) enum,
        # or -1. Error sets parse as plain enums, so their ordinals live in the enum pools.
        def ordinal_of_dotted_path_expr(expression: Expr, structs: mutable StructTable&) -> i64 can[Abort.Panic]:
            if expression is Expr.Field(enum_head, variant_name, field_line):
                if enum_head is Expr.Ident(enum_name, enum_name_line):
                    enum_index: i64 = penum_index_of(structs, enum_name)
                    penum_variant_index(structs, enum_index, variant_name) return if enum_index >= 0
                    plain_index: i64 = enum_index_of(structs, enum_name)
                    enum_ordinal_of(structs, plain_index.usize(), variant_name) return if plain_index >= 0
            return -1


        # Pattern.Variant carries the path as one dotted STRING, so it is split here.
        def ordinal_of_dotted_path(path: sview, structs: mutable StructTable&) -> i64 can[Abort.Panic]:
            dot: mutable i64 = -1
            for index in 0..<sview_len(path) |dot, path|:
                dot <- index.i64() if sview_at(path, index) == 46
            -1 return if dot <= 0
            # Match by comparing BYTES against each registered enum/variant rather than
            # slicing `path` into two sviews: `&path[0]` is a `char&`, not the `u8&?` that
            # `sview(...)` wants, and a view-into-a-view buys nothing here.
            for enum_index in 0..<structs.enum_names.count |structs, path, dot|:
                continue if not sview_matches_prefix(path, structs.enum_names[enum_index], 0, dot)
                for offset in 0..<structs.enum_variant_count[enum_index] |structs, path, dot, enum_index|:
                    variant: sview = structs.enum_variants[structs.enum_variant_start[enum_index] + offset]
                    offset.i64() return if sview_matches_prefix(path, variant, dot + 1, sview_len(path).i64())
            return -1


        # Whether `path[start..end)` equals `candidate`, byte for byte.
        def sview_matches_prefix(path: sview, candidate: sview, start: i64, end: i64) -> bool can[Abort.Panic]:
            false return if (end - start) != sview_len(candidate).i64()
            matched: mutable bool = true
            for index in 0..<sview_len(candidate) |matched, path, candidate, start|:
                matched <- false if sview_at(path, (start + index.i64()).usize()) != sview_at(candidate, index)
            return matched


        # Whether a pattern matches anything. ONLY `_` does: a BINDING arm is not legal in
        # an integer match — stage0 rejects `other: other + 2` with "top-level integer
        # match arm must use an integer literal or _" (and then "undefined identifier
        # other"). Treating a binding as a catch-all made stage1 emit code for a program
        # the language rejects; caught by the stage0 differential.
        #
        # Written as a `match`, NOT `pattern is Pattern.Wildcard`: `is` on a PAYLOAD-LESS
        # packed-enum variant crashes stage0's backend with "unsupported expression
        # *ast.TypeExprExpr" (the bare `Pattern.Wildcard` parses as a type path). `is` WITH
        # a payload and `match` both work — filed with a 12-line repro. Keep this a match
        # until that lands.
        def is_catch_all_pattern(pattern: Pattern) -> bool can[Abort.Panic]:
            return match pattern:
                Pattern.Wildcard: true
                Pattern.Binding(_): true
                _: false


        # Whether an arm carries a guard (`0 if n > 1:`). Guards are emitted as a second
        # condition after the pattern test; this helper keeps the branching paths explicit.
        #
        # A `match`, not `guard is Expr.Absent`, for the same payload-less-variant ICE.
        def arm_has_guard(guard: Expr) -> bool can[Abort.Panic]:
            return match guard:
                Expr.Absent: false
                _: true



        # The single value an arm body yields, for a value `match`. Only a one-expression
        # body is modeled (`0: 100`).
        #
        # Returns `Expr?` rather than filling a `mutable Expr&` out-param: an out-param
        # needs a placeholder to initialize (`Expr.Invalid`), and CONSTRUCTING a
        # packed-enum node requires an active `in Ast.Expr.Store:` scope the backend does
        # not have — it only ever READS the AST. Returning the existing handle constructs
        # nothing.
        def arm_value_expression(body: darray[Stmt]&) -> Expr? can[Abort.Panic]:
            null return if body.count != 1
            if body[0] is Stmt.Expr(arm_expression, arm_expression_line):
                return arm_expression
            return null


        # Close a `match` that has no `_` arm. Nothing matching means the frontend's
        # exhaustiveness proof was wrong, so `unreachable` is the honest terminator —
        # inventing a default value would hide the gap. A guard helper, not a ternary: a
        # VOID ternary ICEs stage0 (`%termp = phi void`).
        def terminate_if_no_default(saw_default: bool, builder: LLVMBuilderRef) -> void can[Abort.Panic]:
            return if saw_default
            _ = LLVMBuildUnreachable(builder)


        # The binary operator a compound assignment applies (`+=` -> `+`), or `Eof` when
        # the token is not a compound assignment. (TokenKind has no Invalid; `Eof` can
        # never appear as a real operator, so it is the natural sentinel.) Keeps the
        # lowering honest: `x op= v` is exactly `x <- x op v`, so it reuses emit_binary
        # instead of re-deriving each operator.
        def compound_operator_of(operator: TokenKind) -> TokenKind:
            TokenKind.Plus return if operator == TokenKind.PlusEq
            TokenKind.Minus return if operator == TokenKind.MinusEq
            TokenKind.Star return if operator == TokenKind.StarEq
            TokenKind.Slash return if operator == TokenKind.SlashEq
            TokenKind.Percent return if operator == TokenKind.PercentEq
            TokenKind.Ampersand return if operator == TokenKind.AmpEq
            TokenKind.Pipe return if operator == TokenKind.PipeEq
            TokenKind.Caret return if operator == TokenKind.CaretEq
            TokenKind.LShift return if operator == TokenKind.LShiftEq
            TokenKind.RShift return if operator == TokenKind.RShiftEq
            return TokenKind.Eof


        # `left and right` / `left or right`, SHORT-CIRCUITING. Yields a modeled `bool`
        # (i1), like every other comparison.
        #
        # Lowered through a result SLOT rather than a phi: `right` may itself append
        # blocks, so the join's predecessor is not necessarily `rhs_block` and a phi would
        # need incoming-block bookkeeping. mem2reg restores the phi at -O2.
        #
        #   result = <short-circuit answer>   ; `and` -> false, `or` -> true
        #   br left ? rhs : done              ; `or` swaps the targets
        #   rhs:  result = right; br done
        #   done: load result
        def emit_short_circuit(left_expression: Expr, operator: TokenKind, right_expression: Expr, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            bool_type: LLVMTypeRef = LLVMInt1TypeInContext(ctx)
            is_and: bool = operator == TokenKind.And

            result_slot: LLVMValueRef = LLVMBuildAlloca(builder, bool_type, "sc.result")
            if emit_condition(left_expression, local_scope, fns, structs, generics, runtime, m, ctx, builder) is left_bit:
                # `false and _` is false; `true or _` is true.
                short_value: LLVMValueRef = LLVMConstInt(bool_type, 0, 0) if is_and else LLVMConstInt(bool_type, 1, 0)
                _ = LLVMBuildStore(builder, short_value, result_slot)

                function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                rhs_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "sc.rhs")
                done_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "sc.done")
                # `and` runs the right side only when the left is TRUE; `or` only when FALSE.
                if is_and:
                    _ = LLVMBuildCondBr(builder, left_bit, rhs_block, done_block)
                else:
                    _ = LLVMBuildCondBr(builder, left_bit, done_block, rhs_block)

                LLVMPositionBuilderAtEnd(builder, rhs_block)
                if emit_condition(right_expression, local_scope, fns, structs, generics, runtime, m, ctx, builder) is right_bit:
                    _ = LLVMBuildStore(builder, right_bit, result_slot)
                    _ = LLVMBuildBr(builder, done_block)
                    LLVMPositionBuilderAtEnd(builder, done_block)
                    return LLVMBuildLoad2(builder, bool_type, result_slot, "sc")
            return null


        # Declare an instantiation of a generic template, and queue its body.
        #
        # The SIGNATURE is built here — cheap, needs no builder, and yields the handle the
        # call site needs immediately. The BODY is queued because emitting it needs the
        # builder, which is currently positioned inside the caller.
        def instantiate_generic(base: sview, type_args: darray[ValueType]&, generics: mutable GenericTable&, structs: mutable StructTable&, m: LLVMModuleRef, ctx: LLVMContextRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            # Direct-name entry (the common case): resolve the FIRST template with this name. For a
            # unique name that is the only template; an overloaded name is disambiguated only via
            # instantiate_generic_at (the UFCS path), which selects the slot by receiver type.
            index: i64 = generic_index_of(generics, base)
            null return if index < 0
            return instantiate_generic_at(index.usize(), type_args, generics, structs, m, ctx)


        # Number of generic templates sharing `name` (1 for a unique name, >1 for an overload set).
        def generic_slot_count(generics: GenericTable&, name: sview) -> usize can[Abort.Panic]:
            count: mutable usize = 0.usize()
            for index in 0..<generics.names.count |count, generics, name|:
                count <- count + 1.usize() if generics.names[index] == name
            return count


        # The instantiation cached for (SLOT, args), or null. Keyed on slot rather than base name so
        # two overloads of the same name with the same type args do not alias to one handle.
        def instantiation_of_slot(generics: GenericTable&, slot: usize, type_args: darray[ValueType]&) -> LLVMValueRef? can[Abort.Panic]:
            for index in 0..<generics.inst_slots.count |generics, slot, type_args|:
                continue if generics.inst_slots[index] != slot
                continue if generics.inst_arg_count[index] != type_args.count
                astart: usize = generics.inst_arg_start[index]
                matched: mutable bool = true
                for k in 0..<type_args.count |generics, matched, astart, type_args|:
                    stored: ValueType = generics.inst_args[astart + k]
                    matched <- false if stored.kind != type_args[k].kind or stored.bits != type_args[k].bits
                generics.inst_handles[index] return if matched
            return null


        # Instantiate template SLOT for `type_args` (declaring the signature + queuing the body).
        # instantiate_generic delegates here after resolving the slot; the UFCS path calls it with an
        # overload-selected slot. The mangled name gets a slot suffix ONLY for overloaded names, so a
        # unique name's instantiation keeps its exact current symbol.
        def instantiate_generic_at(slot: usize, type_args: darray[ValueType]&, generics: mutable GenericTable&, structs: mutable StructTable&, m: LLVMModuleRef, ctx: LLVMContextRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            null return if slot >= generics.names.count
            base: sview = generics.names[slot]
            if instantiation_of_slot(generics, slot, type_args) is already_declared:
                return already_declared
            # The call must supply exactly one argument per type parameter.
            null return if generics.param_count[slot] != type_args.count

            if generics.decls[slot] is Decl.Func(function_name, params, return_type_opt, body, effects, decorators, line):
                # Bind every K/T for the duration of resolving this signature.
                bound: usize = push_type_bindings(generics, structs, slot, type_args)
                # A MISSING return annotation is `void` (std helpers omit `-> void`).
                return_value_type: mutable ValueType = ValueType{kind: TypeKind.Void, bits: 0}
                if return_type_opt is return_type:
                    return_value_type <- annotation_value_type(return_type, structs)
                llvm_params: mutable darray[LLVMTypeRef] = []
                declined: mutable bool = false
                for parameter in params |llvm_params, declined, structs, ctx|:
                    parameter_type: ValueType = parameter_value_type(parameter.type_expression, structs)
                    if parameter_type.kind == TypeKind.Unmodeled:
                        declined <- true
                    else:
                        llvm_params.push(llvm_type_of(parameter_type, structs, ctx))

                # The arena/error ABI must match emit_function_body's param layout for the
                # instantiation body: `[out-param if error], <declared params>, [arena if
                # the signature grows a container]`, and an error fn returns i32.
                instantiation_is_error: bool = generics.is_error[slot]
                instantiation_needs_arena: bool = signature_needs_arena(params, return_value_type, structs)
                pop_type_bindings(structs, bound)
                null return if declined or return_value_type.kind == TypeKind.Unmodeled

                name_storage: mutable darray[u8] = []
                mangled_slot_suffix: i64 = slot.i64() if generic_slot_count(generics, base) > 1.usize() else -1
                mangled: cstr = mangled_name_multi_into(base, type_args, mangled_slot_suffix, structs, name_storage)
                llvm_return: mutable LLVMTypeRef = llvm_type_of(return_value_type, structs, ctx)
                llvm_return <- LLVMInt32TypeInContext(ctx) if instantiation_is_error
                full_params: mutable darray[LLVMTypeRef] = []
                full_params.push(LLVMPointerTypeInContext(ctx, 0)) if instantiation_is_error
                for llvm_param in llvm_params |full_params|:
                    full_params.push(llvm_param)
                full_params.push(LLVMPointerTypeInContext(ctx, 0)) if instantiation_needs_arena
                fn_type: mutable LLVMTypeRef = LLVMFunctionType(llvm_return, null, 0, 0)
                if full_params.count != 0:
                    params_pointer: void& = (&full_params[0]).cast[void&] can Unsafe.PointerCast
                    fn_type <- LLVMFunctionType(llvm_return, params_pointer, full_params.count.u32(), 0)
                handle: LLVMValueRef = LLVMAddFunction(m, mangled, fn_type)

                inst_arg_start: usize = generics.inst_args.count
                for argument in type_args |generics|:
                    generics.inst_args <- generics.inst_args.push(copied_type(argument))
                generics.inst_bases <- generics.inst_bases.push(base)
                generics.inst_arg_start <- generics.inst_arg_start.push(inst_arg_start)
                generics.inst_arg_count <- generics.inst_arg_count.push(type_args.count)
                generics.inst_handles <- generics.inst_handles.push(handle)
                generics.inst_slots <- generics.inst_slots.push(slot)
                pending_arg_start: usize = generics.pending_args.count
                for argument in type_args |generics|:
                    generics.pending_args <- generics.pending_args.push(copied_type(argument))
                generics.pending_bases <- generics.pending_bases.push(base)
                generics.pending_arg_start <- generics.pending_arg_start.push(pending_arg_start)
                generics.pending_arg_count <- generics.pending_arg_count.push(type_args.count)
                generics.pending_handles <- generics.pending_handles.push(handle)
                generics.pending_slots <- generics.pending_slots.push(slot)
                return handle
            return null


        # The declared type of instantiation (base, args)'s parameter `position`, resolved
        # through the template's bindings.
        def instantiation_param_type(base: sview, type_args: darray[ValueType]&, position: usize, generics: mutable GenericTable&, structs: mutable StructTable&) -> ValueType can[Abort.Panic, Memory.Allocate]:
            index: i64 = generic_index_of(generics, base)
            unmodeled_type() return if index < 0
            return instantiation_param_type_at(index.usize(), type_args, position, generics, structs)


        def instantiation_param_type_at(slot: usize, type_args: darray[ValueType]&, position: usize, generics: mutable GenericTable&, structs: mutable StructTable&) -> ValueType can[Abort.Panic, Memory.Allocate]:
            unmodeled_type() return if slot >= generics.names.count
            if generics.decls[slot] is Decl.Func(function_name, params, return_type_opt, body, effects, decorators, line):
                unmodeled_type() return if position >= params.count
                # POP is symmetric via pop_type_bindings — never `<- []`, which would rebind
                # the caller's darray to callee-region memory AND wipe an outer instantiation's
                # bindings (the historical nested-generic crash).
                bound: usize = push_type_bindings(generics, structs, slot, type_args)
                resolved: ValueType = parameter_value_type(params[position].type_expression, structs)
                pop_type_bindings(structs, bound)
                return resolved
            return unmodeled_type()


        # The IR name for a call's result. A VOID call must be UNNAMED — LLVM rejects
        # "instructions returning void cannot have a name".
        def call_result_name(return_type: ValueType) -> cstr:
            return "" if return_type.kind == TypeKind.Void else "call"

        # Emit a call to a generic function, instantiating on first use.
        # Whether a generic INSTANTIATION threads an arena — the same predicate
        # instantiate_generic uses to build the signature (so the call site matches). Computed
        # under the type-arg bindings so `wrap[i64] -> darray[i64]` (grows a darray) is detected.
        def instantiation_wants_arena(base: sview, type_args: darray[ValueType]&, generics: mutable GenericTable&, structs: mutable StructTable&) -> bool can[Abort.Panic, Memory.Allocate]:
            arena_index: i64 = generic_index_of(generics, base)
            false return if arena_index < 0
            return instantiation_wants_arena_at(arena_index.usize(), type_args, generics, structs)


        def instantiation_wants_arena_at(arena_slot: usize, type_args: darray[ValueType]&, generics: mutable GenericTable&, structs: mutable StructTable&) -> bool can[Abort.Panic, Memory.Allocate]:
            false return if arena_slot >= generics.names.count
            if generics.decls[arena_slot] is Decl.Func(arena_fn_name, arena_params, arena_ret_opt, arena_body, arena_effects, arena_decs, arena_line):
                arena_bound: usize = push_type_bindings(generics, structs, arena_slot, type_args)
                arena_ret_type: mutable ValueType = ValueType{kind: TypeKind.Void, bits: 0}
                if arena_ret_opt is arena_ret:
                    arena_ret_type <- annotation_value_type(arena_ret, structs)
                arena_wanted: bool = signature_needs_arena(arena_params, arena_ret_type, structs)
                pop_type_bindings(structs, arena_bound)
                return arena_wanted
            return false

        def emit_generic_call(base: sview, type_args: darray[ValueType]&, arguments: darray[Expr]&, argument_names: darray[sview], local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            if instantiate_generic(base, type_args, generics, structs, m, ctx) is target:
                argument_values: mutable darray[LLVMValueRef] = []
                declined: mutable bool = false
                argument_index: mutable usize = 0
                named_call: mutable bool = false
                for argument_name in argument_names |named_call|:
                    named_call <- true if argument_name != ""
                if named_call:
                    generic_slot: i64 = generic_index_of(generics, base)
                    null return if generic_slot < 0
                    if generics.decls[generic_slot.usize()] is Decl.Func(generic_name, generic_params, generic_return, generic_body, generic_effects, generic_decorators, generic_line):
                        named_position: mutable usize = 0
                        while named_position < generic_params.count |argument_values, declined, named_position, argument_names, arguments, generic_params, base, type_args, local_scope, fns, structs, generics, runtime, m, ctx, builder|:
                            source_index: i64 = generic_named_argument_index(argument_names, generic_params, named_position)
                            null return if source_index < 0 or source_index.usize() >= arguments.count
                            named_wanted: ValueType = instantiation_param_type(base, type_args, named_position, generics, structs)
                            if emit_expression(arguments[source_index.usize()], named_wanted, local_scope, fns, structs, generics, runtime, m, ctx, builder) is named_argument_value:
                                argument_values.push(named_argument_value)
                            else:
                                declined <- true
                            named_position <- named_position + 1
                    else:
                        declined <- true
                else:
                    for argument in arguments |argument_values, declined, argument_index, base, type_args, local_scope, fns, structs, generics, runtime, m, ctx, builder|:
                        # Each argument is emitted at its PARAMETER's type, resolved through the
                        # instantiation's bindings — so a literal argument to `f[u8]` becomes a
                        # u8, not an i64.
                        wanted: ValueType = instantiation_param_type(base, type_args, argument_index, generics, structs)
                        if emit_expression(argument, wanted, local_scope, fns, structs, generics, runtime, m, ctx, builder) is emitted_argument:
                            argument_values.push(emitted_argument)
                        else:
                            declined <- true
                        argument_index <- argument_index + 1
                null return if declined
                # A container-growing/-returning instantiation trails an arena param (matching
                # instantiate_generic's signature); hand over OUR arena so the darray it builds
                # lives in a region that outlives the call.
                argument_values.push(runtime.arena) if instantiation_wants_arena(base, type_args, generics, structs)
                fn_type: LLVMTypeRef = LLVMGlobalGetValueType(target)
                # A VOID call must be unnamed: "instructions returning void cannot have a name".
                gresult_name: cstr = call_result_name(generic_return_type(base, type_args, generics, structs))
                LLVMBuildCall2(builder, fn_type, target, null, 0, gresult_name) return if argument_values.count == 0
                args_pointer: void& = (&argument_values[0]).cast[void&] can Unsafe.PointerCast
                return LLVMBuildCall2(builder, fn_type, target, args_pointer, argument_values.count.u32(), gresult_name)
            return null


        # Add an already-emitted task to a nursery group. The task value cannot be emitted a
        # second time (doing so would submit the work twice), so this small value-call variant
        # mirrors emit_generic_call but accepts the second LLVM argument directly.
        def emit_task_group_add_value(group_name: sview, task_value: LLVMValueRef, task_result_type: ValueType, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            group_args: darray[ValueType] = [task_result_type]
            if instantiate_generic("task_group_add", group_args, generics, structs, m, ctx) is target:
                group_wanted: ValueType = instantiation_param_type("task_group_add", group_args, 0, generics, structs)
                if emit_expression(Expr.Ident(group_name, 0), group_wanted, local_scope, fns, structs, generics, runtime, m, ctx, builder) is group_value:
                    add_type: LLVMTypeRef = LLVMGlobalGetValueType(target)
                    add_args: mutable darray[LLVMValueRef] = [group_value, task_value]
                    add_pointer: void& = (&add_args[0]).cast[void&] can Unsafe.PointerCast
                    return LLVMBuildCall2(builder, add_type, target, add_pointer, 2, "")
            return null


        # Infer template SLOT's type arguments for a UFCS call `recv.f(a, b)` == `f(recv, a, b)`:
        # parameter 0 unifies with the receiver, parameters 1+ with the explicit arguments. The
        # receiver is threaded separately (a receiver-then-args darray[Expr] crashes stage0).
        # Returns empty when any parameter stays unbound — which is how the WRONG overload for this
        # receiver is rejected (its parameter-0 base will not match, leaving a type param free).
        def infer_generic_args_ufcs(slot: usize, receiver: Expr, arguments: darray[Expr]&, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&) -> darray[ValueType] can[Abort.Panic, Memory.Allocate]:
            count: usize = generics.param_count[slot]
            bindings: mutable darray[ValueType] = [unmodeled_type() for _slot_index in 0..<count]
            bound_flags: mutable darray[bool] = [false for _flag_index in 0..<count]
            no_args: darray[ValueType] = []
            if generics.decls[slot] is Decl.Func(function_name, params, return_type_opt, body, effects, decorators, line):
                no_args return if params.count == 0
                receiver_actual: ValueType = expression_type(receiver, local_scope, fns, structs, generics)
                unify_annotation(params[0].type_expression, receiver_actual, generics, slot, structs, bindings, bound_flags) if receiver_actual.kind != TypeKind.Unmodeled
                arg_limit: usize = (params.count - 1.usize()) if (params.count - 1.usize()) < arguments.count else arguments.count
                for position in 0..<arg_limit |bindings, bound_flags, params, arguments, local_scope, fns, structs, generics, slot|:
                    actual: mutable ValueType = expression_type(arguments[position], local_scope, fns, structs, generics)
                    actual <- ValueType{kind: TypeKind.Signed, bits: 64} if actual.kind == TypeKind.Unmodeled and is_int_literal_expr(arguments[position])
                    continue if actual.kind == TypeKind.Unmodeled
                    unify_annotation(params[position + 1.usize()].type_expression, actual, generics, slot, structs, bindings, bound_flags)
            for flag_index in 0..<count |bound_flags, no_args, count|:
                no_args return if not bound_flags[flag_index]
            return bindings


        # Emit a UFCS call to a GENERIC user function at a specific template SLOT: `recv.f(a)` as
        # `f(recv, a)`, receiver as parameter 0. The slot-keyed analogue of emit_generic_call, used
        # for overloaded std generics (Slice/Deque/…) that direct-name resolution cannot distinguish.
        def emit_generic_ufcs_call(slot: usize, type_args: darray[ValueType]&, receiver: Expr, arguments: darray[Expr]&, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            if instantiate_generic_at(slot, type_args, generics, structs, m, ctx) is target:
                argument_values: mutable darray[LLVMValueRef] = []
                declined: mutable bool = false
                receiver_wanted: ValueType = instantiation_param_type_at(slot, type_args, 0.usize(), generics, structs)
                if emit_expression(receiver, receiver_wanted, local_scope, fns, structs, generics, runtime, m, ctx, builder) is emitted_receiver:
                    argument_values.push(emitted_receiver)
                else:
                    declined <- true
                argument_index: mutable usize = 1.usize()
                for argument in arguments |argument_values, declined, argument_index, slot, type_args, local_scope, fns, structs, generics, runtime, m, ctx, builder|:
                    wanted: ValueType = instantiation_param_type_at(slot, type_args, argument_index, generics, structs)
                    if emit_expression(argument, wanted, local_scope, fns, structs, generics, runtime, m, ctx, builder) is emitted_argument:
                        argument_values.push(emitted_argument)
                    else:
                        declined <- true
                    argument_index <- argument_index + 1.usize()
                null return if declined
                argument_values.push(runtime.arena) if instantiation_wants_arena_at(slot, type_args, generics, structs)
                ufcs_fn_type: LLVMTypeRef = LLVMGlobalGetValueType(target)
                ufcs_result_name: cstr = call_result_name(generic_return_type_at(slot, type_args, generics, structs))
                LLVMBuildCall2(builder, ufcs_fn_type, target, null, 0, ufcs_result_name) return if argument_values.count == 0
                ufcs_args_pointer: void& = (&argument_values[0]).cast[void&] can Unsafe.PointerCast
                return LLVMBuildCall2(builder, ufcs_fn_type, target, ufcs_args_pointer, argument_values.count.u32(), ufcs_result_name)
            return null


        # Emit a synthesized dict-method call — stage0 lowers `d.get(k)` / `d.put(k, v)` to a
        # call to a std generic (`arena_dict_get` / `arena_dict_put_or_panic`), NOT to a user
        # `get`/`put` function. The RECEIVER is threaded separately (a `darray[Expr]` of
        # receiver-then-args crashes stage0), and for a mutating helper the region leads the
        # argument list (stage0: `arena_dict_put_or_panic(ptr %region, ptr %d, …)`).
        # Emit a lambda VALUE `fn(params) => body` as a tagged closure, per stage0's ABI:
        # malloc an env of the captured enclosing scalars, emit a LIFTED `@lambda(ptr env,
        # params…)` whose body loads its captures from env, then malloc a `{code, env}` closure
        # and `ptrtoint | 1`-tag it. `expected` (a Fn) supplies the param + return types. Sound
        # subset: only SCALAR captures (int/bool/float) and a modeled return; anything else
        # declines. Non-capturing lambdas pass a null env.
        def emit_lambda_value(lambda_params: darray[sview], lambda_body: darray[Stmt], expected: ValueType, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            int64_type: LLVMTypeRef = LLVMInt64TypeInContext(ctx)
            pointer_type: LLVMTypeRef = LLVMPointerTypeInContext(ctx, 0)
            null return if expected.kind != TypeKind.Fn
            return_type: ValueType = fn_return_type_of(expected, structs)
            null return if return_type.kind == TypeKind.Unmodeled
            null return if expected.bits.usize() >= structs.fn_pool_param_start.count
            param_span_start: usize = structs.fn_pool_param_start[expected.bits.usize()]
            param_span_count: usize = structs.fn_pool_param_count[expected.bits.usize()]
            null return if param_span_count != lambda_params.count
            return_llvm: LLVMTypeRef = llvm_type_of(return_type, structs, ctx)
            param_types: mutable darray[ValueType] = []
            param_llvms: mutable darray[LLVMTypeRef] = []
            param_declined: mutable bool = false
            param_probe: mutable usize = 0
            while param_probe < param_span_count |param_types, param_llvms, param_declined, param_probe, param_span_start, structs, ctx|:
                one_param: ValueType = copied_type(structs.fn_pool_params[param_span_start + param_probe])
                param_declined <- true if one_param.kind == TypeKind.Unmodeled
                param_types.push(one_param)
                param_llvms.push(llvm_type_of(one_param, structs, ctx))
                param_probe <- param_probe + 1
            null return if param_declined
            # Capture every SCALAR local in scope, BY VALUE (load it now, in the caller block).
            capture_names: mutable darray[sview] = []
            capture_types: mutable darray[ValueType] = []
            capture_llvms: mutable darray[LLVMTypeRef] = []
            capture_values: mutable darray[LLVMValueRef] = []
            capture_probe: mutable usize = 0
            while capture_probe < local_scope.names.count |capture_names, capture_types, capture_llvms, capture_values, capture_probe, local_scope, structs, ctx, builder|:
                capture_type: ValueType = copied_type(local_scope.types[capture_probe])
                if is_integer_type(capture_type) or capture_type.kind == TypeKind.Bool or capture_type.kind == TypeKind.Float:
                    capture_llvm: LLVMTypeRef = llvm_type_of(capture_type, structs, ctx)
                    capture_names.push(local_scope.names[capture_probe])
                    capture_types.push(capture_type)
                    capture_llvms.push(capture_llvm)
                    capture_values.push(LLVMBuildLoad2(builder, capture_llvm, local_scope.slots[capture_probe], "lambda.capture"))
                capture_probe <- capture_probe + 1
            # Build + fill the env (null when nothing is captured).
            has_env: bool = capture_names.count > 0
            env_struct_type: mutable LLVMTypeRef = zeroed
            env_pointer: mutable LLVMValueRef = LLVMConstNull(pointer_type)
            malloc_param_types: mutable darray[LLVMTypeRef] = [int64_type]
            malloc_types_pointer: void& = (&malloc_param_types[0]).cast[void&] can Unsafe.PointerCast
            malloc_type: LLVMTypeRef = LLVMFunctionType(pointer_type, malloc_types_pointer, 1, 0)
            malloc_fn: LLVMValueRef = declare_or_get_named(m, "malloc", malloc_type)
            if has_env:
                env_fields_pointer: void& = (&capture_llvms[0]).cast[void&] can Unsafe.PointerCast
                env_struct_type <- LLVMStructTypeInContext(ctx, env_fields_pointer, capture_names.count.u32(), 0)
                env_malloc_args: mutable darray[LLVMValueRef] = [LLVMSizeOf(env_struct_type)]
                env_malloc_pointer: void& = (&env_malloc_args[0]).cast[void&] can Unsafe.PointerCast
                env_pointer <- LLVMBuildCall2(builder, malloc_type, malloc_fn, env_malloc_pointer, 1, "lambda.env")
                store_probe: mutable usize = 0
                while store_probe < capture_names.count |store_probe, env_struct_type, env_pointer, capture_values, builder|:
                    store_field: LLVMValueRef = LLVMBuildStructGEP2(builder, env_struct_type, env_pointer, store_probe.u32(), "lambda.env.field")
                    _ = LLVMBuildStore(builder, capture_values[store_probe], store_field)
                    store_probe <- store_probe + 1
            # The LIFTED function `@lambda(ptr env, params…)`. LLVM uniquifies the name.
            lifted_llvm_types: mutable darray[LLVMTypeRef] = [pointer_type]
            lifted_llvm_types.extend(param_llvms)
            lifted_types_pointer: void& = (&lifted_llvm_types[0]).cast[void&] can Unsafe.PointerCast
            lifted_fn_type: LLVMTypeRef = LLVMFunctionType(return_llvm, lifted_types_pointer, (param_span_count + 1).u32(), 0)
            lifted_fn: LLVMValueRef = LLVMAddFunction(m, "lambda", lifted_fn_type)
            saved_block: LLVMBasicBlockRef = LLVMGetInsertBlock(builder)
            lifted_entry: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, lifted_fn, "entry")
            LLVMPositionBuilderAtEnd(builder, lifted_entry)
            lifted_scope: mutable Scope = Scope{names: [], slots: [], types: [], pool_names: [], group_names: [], deferred: []}
            lifted_loops: mutable LoopStack = LoopStack{exits: [], continues: []}
            lifted_regions: mutable RegionStack = RegionStack{arenas: []}
            lifted_runtime: mutable Runtime = copied_runtime(runtime)
            lifted_arena_type: LLVMTypeRef = arena_llvm_type(ctx)
            lifted_arena_slot: LLVMValueRef = LLVMBuildAlloca(builder, lifted_arena_type, "auto.region")
            _ = LLVMBuildStore(builder, LLVMConstNull(lifted_arena_type), lifted_arena_slot)
            lifted_strategy_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, lifted_arena_type, lifted_arena_slot, 3, "region.strategy")
            _ = LLVMBuildStore(builder, LLVMConstInt(int64_type, 2, 0), lifted_strategy_pointer)
            lifted_runtime.arena <- lifted_arena_slot
            lifted_runtime.owns_arena <- true
            lifted_runtime.debug_active <- false
            lifted_regions.arenas.push(lifted_arena_slot)
            # Load each capture from the env param (param 0) into a fresh local.
            env_param: LLVMValueRef = LLVMGetParam(lifted_fn, 0)
            load_probe: mutable usize = 0
            while load_probe < capture_names.count |load_probe, env_struct_type, env_param, capture_llvms, capture_names, capture_types, lifted_scope, builder|:
                load_field: LLVMValueRef = LLVMBuildStructGEP2(builder, env_struct_type, env_param, load_probe.u32(), "lambda.cap.ptr")
                loaded_capture: LLVMValueRef = LLVMBuildLoad2(builder, capture_llvms[load_probe], load_field, "lambda.cap")
                capture_slot: LLVMValueRef = LLVMBuildAlloca(builder, capture_llvms[load_probe], "lambda.cap.slot")
                _ = LLVMBuildStore(builder, loaded_capture, capture_slot)
                declare_local(lifted_scope, capture_names[load_probe], capture_slot, capture_types[load_probe])
                load_probe <- load_probe + 1
            # Declare the lambda's own params (LLVM params 1..).
            lifted_param_probe: mutable usize = 0
            while lifted_param_probe < lambda_params.count |lifted_param_probe, lifted_fn, param_llvms, param_types, lambda_params, lifted_scope, builder|:
                lifted_param_slot: LLVMValueRef = LLVMBuildAlloca(builder, param_llvms[lifted_param_probe], "lambda.param")
                _ = LLVMBuildStore(builder, LLVMGetParam(lifted_fn, (lifted_param_probe + 1).u32()), lifted_param_slot)
                declare_local(lifted_scope, lambda_params[lifted_param_probe], lifted_param_slot, param_types[lifted_param_probe])
                lifted_param_probe <- lifted_param_probe + 1
            lifted_status: EmitStatus = emit_statements(lambda_body, return_type, lifted_scope, lifted_loops, lifted_regions, fns, structs, generics, lifted_runtime, m, ctx, builder)
            lifted_ok: mutable bool = lifted_status != EmitStatus.Declined
            if lifted_status == EmitStatus.Open:
                if return_type.kind == TypeKind.Void:
                    emit_region_free(lifted_runtime, builder)
                    _ = LLVMBuildRetVoid(builder)
                else:
                    lifted_ok <- false
            LLVMPositionBuilderAtEnd(builder, saved_block)
            if not lifted_ok:
                strip_function_body(lifted_fn)
                return null
            # Build the `{code, env}` closure and tag it.
            closure_fields: mutable darray[LLVMTypeRef] = [pointer_type, pointer_type]
            closure_fields_pointer: void& = (&closure_fields[0]).cast[void&] can Unsafe.PointerCast
            closure_struct_type: LLVMTypeRef = LLVMStructTypeInContext(ctx, closure_fields_pointer, 2, 0)
            closure_malloc_args: mutable darray[LLVMValueRef] = [LLVMSizeOf(closure_struct_type)]
            closure_malloc_pointer: void& = (&closure_malloc_args[0]).cast[void&] can Unsafe.PointerCast
            closure_pointer: LLVMValueRef = LLVMBuildCall2(builder, malloc_type, malloc_fn, closure_malloc_pointer, 1, "lambda.closure")
            closure_code_field: LLVMValueRef = LLVMBuildStructGEP2(builder, closure_struct_type, closure_pointer, 0, "lambda.closure.code")
            _ = LLVMBuildStore(builder, lifted_fn, closure_code_field)
            closure_env_field: LLVMValueRef = LLVMBuildStructGEP2(builder, closure_struct_type, closure_pointer, 1, "lambda.closure.env")
            _ = LLVMBuildStore(builder, env_pointer, closure_env_field)
            closure_integer: LLVMValueRef = LLVMBuildPtrToInt(builder, closure_pointer, int64_type, "lambda.closure.int")
            closure_tagged: LLVMValueRef = LLVMBuildOr(builder, closure_integer, LLVMConstInt(int64_type, 1, 0), "lambda.closure.tagged")
            return LLVMBuildIntToPtr(builder, closure_tagged, pointer_type, "lambda.closure.value")


        # Call THROUGH a `fn(…)` VALUE (a fn-typed local/param), e.g. `fn(value)` inside
        # `apply(fn: fn(i64)->i64, …)`. The value is a low-bit-tagged ptr: bit0 clear → a raw
        # function pointer (call directly); bit0 set → an `%ElisaCoreLambdaClosure = {ptr code,
        # ptr env}` (unmask, load code+env, call `code(env, args…)`). The result type is the
        # EXPECTED type (a `return f(x)` / `y: R = f(x)` supplies it). Branch results merge
        # through an alloca (LLVMBuildPhi is not bound). Mirrors stage0's llvm call lowering.
        def emit_fn_value_call(callee: Expr, arguments: darray[Expr]&, expected: ValueType, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            int64_type: LLVMTypeRef = LLVMInt64TypeInContext(ctx)
            pointer_type: LLVMTypeRef = LLVMPointerTypeInContext(ctx, 0)
            # The result type: the fn value's own DECLARED return type (from its Fn signature)
            # is authoritative and works even in argument position (`f(f(x))`); fall back to the
            # call site's EXPECTED type when the signature carries no return (older Fn{bits:0}).
            declared_return: mutable ValueType = unmodeled_type()
            if callee is Expr.Ident(callee_fn_name, callee_fn_name_line):
                declared_return <- fn_return_type_of(lookup_type(local_scope, callee_fn_name), structs)
            result_type: ValueType = declared_return if declared_return.kind != TypeKind.Unmodeled else expected
            null return if result_type.kind == TypeKind.Void or result_type.kind == TypeKind.Unmodeled or result_type.kind == TypeKind.Fn
            return_llvm: LLVMTypeRef = llvm_type_of(result_type, structs, ctx)
            fn_pointer_opt: LLVMValueRef? = emit_expression(callee, ValueType{kind: TypeKind.Fn, bits: 0}, local_scope, fns, structs, generics, runtime, m, ctx, builder)
            fn_pointer: mutable LLVMValueRef = zeroed
            got_fn_pointer: mutable bool = false
            if fn_pointer_opt is fn_pointer_bound:
                fn_pointer <- fn_pointer_bound
                got_fn_pointer <- true
            null return if not got_fn_pointer
            # The fn value's declared PARAM types (from its Fn signature pool) so a LITERAL
            # argument (`f(20)`) adopts the param type instead of failing expression_type.
            callee_param_types: mutable darray[ValueType] = []
            if callee is Expr.Ident(callee_param_name, callee_param_line):
                callee_fn_type: ValueType = lookup_type(local_scope, callee_param_name)
                if callee_fn_type.kind == TypeKind.Fn and callee_fn_type.bits.usize() < structs.fn_pool_param_start.count:
                    callee_param_start: usize = structs.fn_pool_param_start[callee_fn_type.bits.usize()]
                    callee_param_span: usize = structs.fn_pool_param_count[callee_fn_type.bits.usize()]
                    callee_param_offset: mutable usize = 0
                    while callee_param_offset < callee_param_span |callee_param_types, callee_param_offset, callee_param_start, structs|:
                        callee_param_types.push(copied_type(structs.fn_pool_params[callee_param_start + callee_param_offset]))
                        callee_param_offset <- callee_param_offset + 1
            argument_values: mutable darray[LLVMValueRef] = []
            argument_llvm_types: mutable darray[LLVMTypeRef] = []
            arg_declined: mutable bool = false
            arg_index: mutable usize = 0
            for call_argument in arguments |argument_values, argument_llvm_types, arg_declined, arg_index, callee_param_types, local_scope, fns, structs, generics, runtime, m, ctx, builder|:
                continue if arg_declined
                signature_arg_type: ValueType = copied_type(callee_param_types[arg_index]) if arg_index < callee_param_types.count else unmodeled_type()
                inferred_arg_type: ValueType = expression_type(call_argument, local_scope, fns, structs, generics)
                call_argument_type: ValueType = signature_arg_type if signature_arg_type.kind != TypeKind.Unmodeled else inferred_arg_type
                if call_argument_type.kind == TypeKind.Unmodeled:
                    arg_declined <- true
                elif emit_expression(call_argument, call_argument_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is call_argument_value:
                    argument_values.push(call_argument_value)
                    argument_llvm_types.push(llvm_type_of(call_argument_type, structs, ctx))
                else:
                    arg_declined <- true
                arg_index <- arg_index + 1
            null return if arg_declined
            argument_count: usize = argument_values.count
            # A zero-argument function value (`f()`) is supported: LLVM ignores the args/types
            # base pointers when the count is 0, but Elisa cannot index `[0]` on an EMPTY darray,
            # so the RAW path below falls back to a 1-element dummy pointer (never read). The
            # CLOSURE path is unaffected — it always prepends the env, so its arrays are non-empty.
            raw_dummy_type: mutable darray[LLVMTypeRef] = [LLVMPointerTypeInContext(ctx, 0)]
            raw_dummy_value: mutable darray[LLVMValueRef] = [fn_pointer]
            result_slot: LLVMValueRef = LLVMBuildAlloca(builder, return_llvm, "fnval.result")
            fn_integer: LLVMValueRef = LLVMBuildPtrToInt(builder, fn_pointer, int64_type, "fnval.int")
            fn_tag: LLVMValueRef = LLVMBuildAnd(builder, fn_integer, LLVMConstInt(int64_type, 1, 0), "fnval.tag")
            is_closure: LLVMValueRef = LLVMBuildICmp(builder, 33, fn_tag, LLVMConstInt(int64_type, 0, 0), "fnval.is_closure")
            enclosing: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
            raw_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, enclosing, "fnval.raw")
            closure_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, enclosing, "fnval.closure")
            merge_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, enclosing, "fnval.merge")
            _ = LLVMBuildCondBr(builder, is_closure, closure_block, raw_block)
            # RAW: call the pointer as an ordinary `return_llvm (args…)` function.
            LLVMPositionBuilderAtEnd(builder, raw_block)
            raw_types_pointer: void& = (&argument_llvm_types[0]).cast[void&] can Unsafe.PointerCast if argument_count > 0 else (&raw_dummy_type[0]).cast[void&] can Unsafe.PointerCast
            raw_fn_type: LLVMTypeRef = LLVMFunctionType(return_llvm, raw_types_pointer, argument_count.u32(), 0)
            raw_args_pointer: void& = (&argument_values[0]).cast[void&] can Unsafe.PointerCast if argument_count > 0 else (&raw_dummy_value[0]).cast[void&] can Unsafe.PointerCast
            raw_result: LLVMValueRef = LLVMBuildCall2(builder, raw_fn_type, fn_pointer, raw_args_pointer, argument_count.u32(), "fnval.raw.call")
            _ = LLVMBuildStore(builder, raw_result, result_slot)
            _ = LLVMBuildBr(builder, merge_block)
            # CLOSURE: unmask (bit0 is known set here, so `- 1` clears it), load {code, env},
            # and call `code(env, args…)`.
            LLVMPositionBuilderAtEnd(builder, closure_block)
            closure_integer: LLVMValueRef = LLVMBuildSub(builder, fn_integer, LLVMConstInt(int64_type, 1, 0), "fnval.unmask")
            closure_pointer: LLVMValueRef = LLVMBuildIntToPtr(builder, closure_integer, pointer_type, "fnval.cptr")
            closure_fields: mutable darray[LLVMTypeRef] = [pointer_type, pointer_type]
            closure_fields_pointer: void& = (&closure_fields[0]).cast[void&] can Unsafe.PointerCast
            closure_struct_type: LLVMTypeRef = LLVMStructTypeInContext(ctx, closure_fields_pointer, 2, 0)
            code_field_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, closure_struct_type, closure_pointer, 0, "fnval.code.ptr")
            env_field_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, closure_struct_type, closure_pointer, 1, "fnval.env.ptr")
            code_pointer: LLVMValueRef = LLVMBuildLoad2(builder, pointer_type, code_field_pointer, "fnval.code")
            env_pointer: LLVMValueRef = LLVMBuildLoad2(builder, pointer_type, env_field_pointer, "fnval.env")
            closure_arg_types: mutable darray[LLVMTypeRef] = [pointer_type]
            closure_arg_types.extend(argument_llvm_types)
            closure_arg_values: mutable darray[LLVMValueRef] = [env_pointer]
            closure_arg_values.extend(argument_values)
            closure_types_pointer: void& = (&closure_arg_types[0]).cast[void&] can Unsafe.PointerCast
            closure_fn_type: LLVMTypeRef = LLVMFunctionType(return_llvm, closure_types_pointer, (argument_count + 1).u32(), 0)
            closure_args_pointer: void& = (&closure_arg_values[0]).cast[void&] can Unsafe.PointerCast
            closure_result: LLVMValueRef = LLVMBuildCall2(builder, closure_fn_type, code_pointer, closure_args_pointer, (argument_count + 1).u32(), "fnval.closure.call")
            _ = LLVMBuildStore(builder, closure_result, result_slot)
            _ = LLVMBuildBr(builder, merge_block)
            LLVMPositionBuilderAtEnd(builder, merge_block)
            return LLVMBuildLoad2(builder, return_llvm, result_slot, "fnval.merged")


        def emit_dict_method_call(base: sview, type_args: darray[ValueType]&, receiver: Expr, arguments: darray[Expr]&, arena_leading: bool, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            if instantiate_generic(base, type_args, generics, structs, m, ctx) is target:
                dict_arg_values: mutable darray[LLVMValueRef] = []
                param_index: mutable usize = 0
                # The leading region for a mutating helper — hand over OUR arena.
                if arena_leading:
                    dict_arg_values.push(runtime.arena)
                    param_index <- 1
                # The receiver, emitted at its `dict[K,T]&` parameter type (a bare dict local
                # auto-borrows to its slot).
                receiver_wanted: ValueType = instantiation_param_type(base, type_args, param_index, generics, structs)
                if emit_expression(receiver, receiver_wanted, local_scope, fns, structs, generics, runtime, m, ctx, builder) is receiver_value:
                    dict_arg_values.push(receiver_value)
                    param_index <- param_index + 1
                    method_declined: mutable bool = false
                    for method_argument in arguments |dict_arg_values, method_declined, param_index, base, type_args, local_scope, fns, structs, generics, runtime, m, ctx, builder|:
                        method_wanted: ValueType = instantiation_param_type(base, type_args, param_index, generics, structs)
                        if emit_expression(method_argument, method_wanted, local_scope, fns, structs, generics, runtime, m, ctx, builder) is method_argument_value:
                            dict_arg_values.push(method_argument_value)
                        else:
                            method_declined <- true
                        param_index <- param_index + 1
                    null return if method_declined
                    dict_fn_type: LLVMTypeRef = LLVMGlobalGetValueType(target)
                    dict_result_name: cstr = call_result_name(generic_return_type(base, type_args, generics, structs))
                    dict_args_pointer: void& = (&dict_arg_values[0]).cast[void&] can Unsafe.PointerCast
                    return LLVMBuildCall2(builder, dict_fn_type, target, dict_args_pointer, dict_arg_values.count.u32(), dict_result_name)
                return null
            return null


        # If `receiver` has a `DynDict[K, T]` type, return its type-argument tuple (K, T);
        # otherwise an empty darray. Used to lower `d.get`/`d.put` to the arena_dict_* helpers.
        def dict_type_args_of(receiver: Expr, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&) -> darray[ValueType] can[Abort.Panic, Memory.Allocate]:
            empty: darray[ValueType] = []
            receiver_type: ValueType = expression_type(receiver, local_scope, fns, structs, generics)
            empty return if receiver_type.kind != TypeKind.Struct
            receiver_base: mutable sview = ""
            receiver_arg_start: mutable usize = 0
            receiver_arg_count: mutable usize = 0
            has_instantiation: bool = generic_struct_instantiation_of(structs, receiver_type, receiver_base, receiver_arg_start, receiver_arg_count)
            empty return if not has_instantiation
            empty return if receiver_base != "DynDict"
            collected: mutable darray[ValueType] = []
            for offset in 0..<receiver_arg_count |collected, structs, receiver_arg_start|:
                collected.push(copied_type(structs.generic_struct_inst_args[receiver_arg_start + offset]))
            return collected


        # The std helper a dict method lowers to — the FRICTIONLESS (panic-on-OOM, no `can`)
        # surface, matching stage0's synthetic `dict.<method>` lowering. Empty = not a dict
        # method (fall through to ordinary UFCS).
        def dict_method_helper(method_name: sview) -> sview can[Abort.Panic]:
            return when method_name:
                "get" -> "arena_dict_get"
                "get_mut" -> "arena_dict_get_mut"
                "put" -> "arena_dict_put_or_panic"
                "get_or_insert" -> "arena_dict_get_or_insert_or_panic"
                "reserve" -> "arena_dict_reserve_or_panic"
                "contains" -> "arena_dict_contains"
                "remove" -> "arena_dict_remove"
                "clear" -> "arena_dict_clear"
                _ -> ""


        # Whether a dict method mutates the map and therefore takes a LEADING region argument.
        def dict_method_is_mutating(method_name: sview) -> bool can[Abort.Panic]:
            return method_name in {"put", "get_or_insert", "reserve"}


        # Emit a call `f(args…)`. Only a direct call to a named, already-declared function
        # is modeled: the callee must exist in the module (emit_module declares every
        # function before emitting any body, so definition order does not matter) and the
        # arity must match.
        # The LLVMAtomicRMWBinOp code for a std atomic read-modify-write op name, or -1.
        # exchange=Xchg(0), fetch_add=Add(1), fetch_sub=Sub(2), fetch_and=And(3),
        # fetch_or=Or(5), fetch_xor=Xor(6).
        def atomic_rmw_op_of(name: sview) -> i64 can[Abort.Panic]:
            0 return if name == "exchange"
            1 return if name == "fetch_add"
            2 return if name == "fetch_sub"
            3 return if name == "fetch_and"
            5 return if name == "fetch_or"
            6 return if name == "fetch_xor"
            return -1


        # Whether an atomic cell's value type is a modeled INTEGER (known byte size) — the only
        # shape LLVM atomic load/store/RMW handle here.
        def atomic_value_is_integer(value_type: ValueType) -> bool can[Abort.Panic]:
            return is_integer_type(value_type) and (value_type.bits == 8 or value_type.bits == 16 or value_type.bits == 32 or value_type.bits == 64)


        # Recursive value cloning used by the darray clone path. Scalar values are already
        # value-owned; fixed arrays, structs, optionals, and nested darrays need element/field
        # reconstruction so an aggregate does not accidentally retain source-owned storage.
        def emit_clone_error_union_value(source_value: LLVMValueRef, source_type: ValueType, target_type: ValueType, structs: mutable StructTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            null return if source_type.kind != TypeKind.ErrorUnion or target_type.kind != TypeKind.ErrorUnion
            source_payload_type: ValueType = error_union_payload_of(source_type, structs)
            target_payload_type: ValueType = error_union_payload_of(target_type, structs)
            null return if source_payload_type.kind != target_payload_type.kind or source_payload_type.bits != target_payload_type.bits
            source_code: LLVMValueRef = LLVMBuildExtractValue(builder, source_value, 0, "clone.error.code")
            source_payload_ptr: LLVMValueRef = LLVMBuildExtractValue(builder, source_value, 1, "clone.error.payload")
            zero_code: LLVMValueRef = LLVMConstInt(LLVMInt32TypeInContext(ctx), 0, 0)
            is_success: LLVMValueRef = LLVMBuildICmp(builder, 32, source_code, zero_code, "clone.error.ok")
            function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
            success_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "clone.error.success")
            failure_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "clone.error.failure")
            merge_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "clone.error.merge")
            union_llvm: LLVMTypeRef = llvm_type_of(target_type, structs, ctx)
            result_slot: LLVMValueRef = LLVMBuildAlloca(builder, union_llvm, "clone.error.slot")
            _ = LLVMBuildCondBr(builder, is_success, success_block, failure_block)

            LLVMPositionBuilderAtEnd(builder, success_block)
            payload_llvm: LLVMTypeRef = llvm_type_of(source_payload_type, structs, ctx)
            source_payload: LLVMValueRef = LLVMBuildLoad2(builder, payload_llvm, source_payload_ptr, "clone.error.payload.load")
            if emit_clone_aggregate_value(source_payload, source_payload_type, target_payload_type, structs, runtime, m, ctx, builder) is cloned_payload:
                payload_size: LLVMValueRef = LLVMSizeOf(payload_llvm)
                alloc_args: mutable darray[LLVMValueRef] = [runtime.arena, payload_size]
                alloc_pointer: void& = (&alloc_args[0]).cast[void&] can Unsafe.PointerCast
                destination_payload_ptr: LLVMValueRef = LLVMBuildCall2(builder, runtime.arena_alloc_type, runtime.arena_alloc, alloc_pointer, 2, "clone.error.alloc")
                _ = LLVMBuildStore(builder, cloned_payload, destination_payload_ptr)
                success_result: mutable LLVMValueRef = LLVMGetUndef(union_llvm)
                success_result <- LLVMBuildInsertValue(builder, success_result, zero_code, 0, "clone.error.success.code")
                success_result <- LLVMBuildInsertValue(builder, success_result, destination_payload_ptr, 1, "clone.error.success.payload")
                _ = LLVMBuildStore(builder, success_result, result_slot)
                _ = LLVMBuildBr(builder, merge_block)
            else:
                return null

            LLVMPositionBuilderAtEnd(builder, failure_block)
            failure_result: mutable LLVMValueRef = LLVMGetUndef(union_llvm)
            failure_result <- LLVMBuildInsertValue(builder, failure_result, source_code, 0, "clone.error.failure.code")
            failure_result <- LLVMBuildInsertValue(builder, failure_result, LLVMConstNull(LLVMPointerTypeInContext(ctx, 0)), 1, "clone.error.failure.payload")
            _ = LLVMBuildStore(builder, failure_result, result_slot)
            _ = LLVMBuildBr(builder, merge_block)

            LLVMPositionBuilderAtEnd(builder, merge_block)
            return LLVMBuildLoad2(builder, union_llvm, result_slot, "clone.error.result")


        # Materialize the successful result of `try f(...)` into a first-class error-union
        # local. Error-call lowering already produced the payload value; the union descriptor
        # owns a fresh payload slot in the current arena and carries status code zero.
        def build_error_union_success(payload_value: LLVMValueRef, payload_type: ValueType, union_type: ValueType, structs: mutable StructTable&, runtime: Runtime&, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            payload_llvm: LLVMTypeRef = llvm_type_of(payload_type, structs, ctx)
            payload_size: LLVMValueRef = LLVMSizeOf(payload_llvm)
            alloc_args: mutable darray[LLVMValueRef] = [runtime.arena, payload_size]
            alloc_pointer: void& = (&alloc_args[0]).cast[void&] can Unsafe.PointerCast
            payload_slot: LLVMValueRef = LLVMBuildCall2(builder, runtime.arena_alloc_type, runtime.arena_alloc, alloc_pointer, 2, "error.union.alloc")
            _ = LLVMBuildStore(builder, payload_value, payload_slot)
            result: mutable LLVMValueRef = LLVMGetUndef(llvm_type_of(union_type, structs, ctx))
            result <- LLVMBuildInsertValue(builder, result, LLVMConstInt(LLVMInt32TypeInContext(ctx), 0, 0), 0, "error.union.code")
            result <- LLVMBuildInsertValue(builder, result, payload_slot, 1, "error.union.payload")
            return result


        def emit_clone_aggregate_value(source_value: LLVMValueRef, source_type: ValueType, target_type: ValueType, structs: mutable StructTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            null return if source_type.kind != target_type.kind
            # Optional type IDs are compiler-local intern slots. Equivalent annotations can
            # receive different IDs while lowering a call, so compare their payload shapes
            # instead of requiring the IDs themselves to match.
            if source_type.kind == TypeKind.Optional:
                source_payload_shape: ValueType = optional_payload_of(source_type, structs)
                target_payload_shape: ValueType = optional_payload_of(target_type, structs)
                null return if source_payload_shape.kind != target_payload_shape.kind or source_payload_shape.bits != target_payload_shape.bits
            elif source_type.kind == TypeKind.ErrorUnion:
                null return if error_union_family_of(source_type, structs) != error_union_family_of(target_type, structs)
                return emit_clone_error_union_value(source_value, source_type, target_type, structs, runtime, m, ctx, builder)
            else:
                null return if source_type.bits != target_type.bits
            if source_type.kind == TypeKind.Optional:
                payload_type: ValueType = optional_payload_of(source_type, structs)
                optional_type: LLVMTypeRef = llvm_type_of(target_type, structs, ctx)
                # The payload is value-owned for scalar optionals; preserve the tagged
                # aggregate directly when recursive reconstruction is unavailable.
                if payload_type.kind == TypeKind.Signed or payload_type.kind == TypeKind.Unsigned or payload_type.kind == TypeKind.Float or payload_type.kind == TypeKind.Bool:
                    return source_value
                source_tag: LLVMValueRef = LLVMBuildExtractValue(builder, source_value, 0, "clone.optional.tag")
                source_payload: LLVMValueRef = LLVMBuildExtractValue(builder, source_value, 1, "clone.optional.payload")
                if emit_clone_aggregate_value(source_payload, payload_type, payload_type, structs, runtime, m, ctx, builder) is cloned_payload:
                    result: mutable LLVMValueRef = LLVMGetUndef(optional_type)
                    result <- LLVMBuildInsertValue(builder, result, source_tag, 0, "clone.optional.tag.out")
                    result <- LLVMBuildInsertValue(builder, result, cloned_payload, 1, "clone.optional.payload.out")
                    return result
                return null
            if source_type.kind == TypeKind.Array:
                source_element: ValueType = array_element_of(source_type, structs)
                target_element: ValueType = array_element_of(target_type, structs)
                null return if structs.array_extents[source_type.bits.usize()] != structs.array_extents[target_type.bits.usize()]
                array_type: LLVMTypeRef = llvm_type_of(target_type, structs, ctx)
                result: mutable LLVMValueRef = LLVMGetUndef(array_type)
                for index in 0..<structs.array_extents[target_type.bits.usize()] |result, source_value, source_element, target_element, structs, ctx, builder|:
                    source_field: LLVMValueRef = LLVMBuildExtractValue(builder, source_value, index.u32(), "clone.array.src")
                    if emit_clone_aggregate_value(source_field, source_element, target_element, structs, runtime, m, ctx, builder) is cloned_field:
                        result <- LLVMBuildInsertValue(builder, result, cloned_field, index.u32(), "clone.array.dst")
                    else:
                        return null
                return result
            if source_type.kind == TypeKind.Struct:
                slot: usize = source_type.bits.usize()
                null return if structs.field_count[slot] == 0
                struct_type: LLVMTypeRef = llvm_type_of(target_type, structs, ctx)
                result: mutable LLVMValueRef = LLVMGetUndef(struct_type)
                for index in 0..<structs.field_count[slot] |result, source_value, structs, ctx, builder|:
                    field_type: ValueType = copied_type(structs.field_types[structs.field_start[slot] + index])
                    null return if field_type.kind == TypeKind.Unmodeled
                    source_field: LLVMValueRef = LLVMBuildExtractValue(builder, source_value, index.u32(), "clone.field.src")
                    if emit_clone_aggregate_value(source_field, field_type, field_type, structs, runtime, m, ctx, builder) is cloned_field:
                        result <- LLVMBuildInsertValue(builder, result, cloned_field, index.u32(), "clone.field.dst")
                    else:
                        return null
                return result
            if source_type.kind == TypeKind.DArray:
                return emit_clone_nested_darray_value(source_value, source_type, target_type, structs, runtime, m, ctx, builder)
            null return if source_type.kind == TypeKind.View
            return source_value


        # Clone a darray value when it appears inside another aggregate (for example a
        # struct field or a darray element). The direct clone builtin has the same lowering,
        # but this value-level form lets aggregate recursion deep-copy nested containers.
        def emit_clone_nested_darray_value(source_value: LLVMValueRef, source_type: ValueType, target_type: ValueType, structs: mutable StructTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            null return if source_type.kind != TypeKind.DArray or target_type.kind != TypeKind.DArray
            source_element: ValueType = darray_element_of(source_type, structs)
            target_element: ValueType = darray_element_of(target_type, structs)
            null return if source_element.kind == TypeKind.Unmodeled or target_element.kind == TypeKind.Unmodeled
            null return if source_element.kind != target_element.kind or source_element.bits != target_element.bits
            header: LLVMTypeRef = darray_llvm_type(structs, ctx)
            count_type: LLVMTypeRef = LLVMInt64TypeInContext(ctx)
            source_items: LLVMValueRef = LLVMBuildExtractValue(builder, source_value, 0, "clone.nested.src.items")
            source_count: LLVMValueRef = LLVMBuildExtractValue(builder, source_value, 1, "clone.nested.src.count")
            stride: LLVMValueRef = element_stride(target_element, structs, ctx)
            byte_count: LLVMValueRef = LLVMBuildMul(builder, source_count, stride, "clone.nested.bytes")
            alloc_arguments: mutable darray[LLVMValueRef] = [runtime.arena, byte_count]
            alloc_pointer: void& = (&alloc_arguments[0]).cast[void&] can Unsafe.PointerCast
            destination_items: LLVMValueRef = LLVMBuildCall2(builder, runtime.arena_alloc_type, runtime.arena_alloc, alloc_pointer, 2, "clone.nested.alloc")
            function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
            index_slot: LLVMValueRef = LLVMBuildAlloca(builder, count_type, "clone.nested.index")
            _ = LLVMBuildStore(builder, LLVMConstInt(count_type, 0, 0), index_slot)
            loop_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "clone.nested.loop")
            body_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "clone.nested.body")
            end_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "clone.nested.end")
            _ = LLVMBuildBr(builder, loop_block)
            LLVMPositionBuilderAtEnd(builder, loop_block)
            current_index: LLVMValueRef = LLVMBuildLoad2(builder, count_type, index_slot, "clone.nested.index.load")
            more: LLVMValueRef = LLVMBuildICmp(builder, 36, current_index, source_count, "clone.nested.more")
            _ = LLVMBuildCondBr(builder, more, body_block, end_block)
            LLVMPositionBuilderAtEnd(builder, body_block)
            indices: mutable darray[LLVMValueRef] = [current_index]
            indices_pointer: void& = (&indices[0]).cast[void&] can Unsafe.PointerCast
            element_llvm: LLVMTypeRef = llvm_type_of(source_element, structs, ctx)
            source_pointer: LLVMValueRef = LLVMBuildGEP2(builder, element_llvm, source_items, indices_pointer, 1, "clone.nested.src.ptr")
            destination_pointer: LLVMValueRef = LLVMBuildGEP2(builder, element_llvm, destination_items, indices_pointer, 1, "clone.nested.dst.ptr")
            source_element_value: LLVMValueRef = LLVMBuildLoad2(builder, element_llvm, source_pointer, "clone.nested.src.value")
            if emit_clone_aggregate_value(source_element_value, source_element, target_element, structs, runtime, m, ctx, builder) is cloned_element:
                _ = LLVMBuildStore(builder, cloned_element, destination_pointer)
            else:
                return null
            next_index: LLVMValueRef = LLVMBuildAdd(builder, current_index, LLVMConstInt(count_type, 1, 0), "clone.nested.next")
            _ = LLVMBuildStore(builder, next_index, index_slot)
            _ = LLVMBuildBr(builder, loop_block)
            LLVMPositionBuilderAtEnd(builder, end_block)
            result: mutable LLVMValueRef = LLVMGetUndef(header)
            result <- LLVMBuildInsertValue(builder, result, destination_items, 0, "clone.nested.items")
            result <- LLVMBuildInsertValue(builder, result, source_count, 1, "clone.nested.count")
            result <- LLVMBuildInsertValue(builder, result, source_count, 2, "clone.nested.capacity")
            return result


        def emit_clone_value_builtin(callee: Expr, arguments: darray[Expr]&, expected: ValueType, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            is_clone: mutable bool = false
            if callee is Expr.Index(object, type_argument, line):
                is_clone <- true if object is Expr.Ident(name, name_line) and name == "clone"
            if callee is Expr.IndexN(object, type_arguments, line):
                is_clone <- true if object is Expr.Ident(name, name_line) and name == "clone"
            null return if not is_clone or arguments.count != 1 or expected.kind == TypeKind.DArray or expected.kind == TypeKind.Unmodeled
            source_type: ValueType = expression_type(arguments[0], local_scope, fns, structs, generics)
            if emit_expression(arguments[0], source_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is source_value:
                return emit_clone_aggregate_value(source_value, source_type, expected, structs, runtime, m, ctx, builder)
            return null


        def emit_clone_darray_builtin(callee: Expr, arguments: darray[Expr]&, expected: ValueType, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            is_clone: mutable bool = false
            if callee is Expr.Index(object, type_argument, line):
                is_clone <- true if object is Expr.Ident(name, name_line) and name == "clone"
            if callee is Expr.IndexN(object, type_arguments, line):
                is_clone <- true if object is Expr.Ident(name, name_line) and name == "clone"
            null return if not is_clone or arguments.count != 1 or expected.kind != TypeKind.DArray
            source_type: ValueType = expression_type(arguments[0], local_scope, fns, structs, generics)
            null return if source_type.kind != TypeKind.DArray and source_type.kind != TypeKind.View and source_type.kind != TypeKind.SView and source_type.kind != TypeKind.Array
            source_element: mutable ValueType = ValueType{kind: TypeKind.Unsigned, bits: 8}
            source_element <- darray_element_of(source_type, structs) if source_type.kind == TypeKind.DArray
            source_element <- view_element_of(source_type, structs) if source_type.kind == TypeKind.View
            source_element <- array_element_of(source_type, structs) if source_type.kind == TypeKind.Array
            target_element: ValueType = darray_element_of(expected, structs)
            null return if source_element.kind == TypeKind.Unmodeled or target_element.kind == TypeKind.Unmodeled
            null return if source_element.kind != target_element.kind or source_element.bits != target_element.bits
            source_expression_type: ValueType = view_struct_type(source_type, structs) if source_type.kind == TypeKind.View else source_type
            if emit_expression(arguments[0], source_expression_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is source_value:
                header: LLVMTypeRef = darray_llvm_type(structs, ctx)
                count_type: LLVMTypeRef = LLVMInt64TypeInContext(ctx)
                source_items: mutable LLVMValueRef = zeroed
                source_count: mutable LLVMValueRef = zeroed
                if source_type.kind == TypeKind.Array:
                    source_array_llvm: LLVMTypeRef = llvm_type_of(source_type, structs, ctx)
                    source_array_slot: LLVMValueRef = LLVMBuildAlloca(builder, source_array_llvm, "clone.src.array")
                    _ = LLVMBuildStore(builder, source_value, source_array_slot)
                    source_array_indices: mutable darray[LLVMValueRef] = [LLVMConstInt(count_type, 0, 0), LLVMConstInt(count_type, 0, 0)]
                    source_array_indices_pointer: void& = (&source_array_indices[0]).cast[void&] can Unsafe.PointerCast
                    source_items <- LLVMBuildGEP2(builder, source_array_llvm, source_array_slot, source_array_indices_pointer, 2, "clone.src.array.items")
                    source_count <- LLVMConstInt(count_type, structs.array_extents[source_type.bits.usize()].u64(), 0)
                else:
                    source_items <- LLVMBuildExtractValue(builder, source_value, 0, "clone.src.items")
                    source_count <- LLVMBuildExtractValue(builder, source_value, 1, "clone.src.count")
                stride: LLVMValueRef = element_stride(target_element, structs, ctx)
                byte_count: LLVMValueRef = LLVMBuildMul(builder, source_count, stride, "clone.bytes")
                alloc_arguments: mutable darray[LLVMValueRef] = [runtime.arena, byte_count]
                alloc_pointer: void& = (&alloc_arguments[0]).cast[void&] can Unsafe.PointerCast
                destination_items: LLVMValueRef = LLVMBuildCall2(builder, runtime.arena_alloc_type, runtime.arena_alloc, alloc_pointer, 2, "clone.alloc")
                function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                index_slot: LLVMValueRef = LLVMBuildAlloca(builder, count_type, "clone.index")
                _ = LLVMBuildStore(builder, LLVMConstInt(count_type, 0, 0), index_slot)
                loop_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "clone.loop")
                body_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "clone.body")
                end_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "clone.end")
                _ = LLVMBuildBr(builder, loop_block)
                LLVMPositionBuilderAtEnd(builder, loop_block)
                current_index: LLVMValueRef = LLVMBuildLoad2(builder, count_type, index_slot, "clone.index.load")
                more: LLVMValueRef = LLVMBuildICmp(builder, 36, current_index, source_count, "clone.more")
                _ = LLVMBuildCondBr(builder, more, body_block, end_block)
                LLVMPositionBuilderAtEnd(builder, body_block)
                indices: mutable darray[LLVMValueRef] = [current_index]
                indices_pointer: void& = (&indices[0]).cast[void&] can Unsafe.PointerCast
                source_pointer: LLVMValueRef = LLVMBuildGEP2(builder, llvm_type_of(source_element, structs, ctx), source_items, indices_pointer, 1, "clone.src.ptr")
                destination_pointer: LLVMValueRef = LLVMBuildGEP2(builder, llvm_type_of(target_element, structs, ctx), destination_items, indices_pointer, 1, "clone.dst.ptr")
                source_element_value: LLVMValueRef = LLVMBuildLoad2(builder, llvm_type_of(source_element, structs, ctx), source_pointer, "clone.src.value")
                if emit_clone_aggregate_value(source_element_value, source_element, target_element, structs, runtime, m, ctx, builder) is cloned_element:
                    _ = LLVMBuildStore(builder, cloned_element, destination_pointer)
                else:
                    return null
                next_index: LLVMValueRef = LLVMBuildAdd(builder, current_index, LLVMConstInt(count_type, 1, 0), "clone.next")
                _ = LLVMBuildStore(builder, next_index, index_slot)
                _ = LLVMBuildBr(builder, loop_block)
                LLVMPositionBuilderAtEnd(builder, end_block)
                result: mutable LLVMValueRef = LLVMGetUndef(header)
                result <- LLVMBuildInsertValue(builder, result, destination_items, 0, "clone.items")
                result <- LLVMBuildInsertValue(builder, result, source_count, 1, "clone.count")
                result <- LLVMBuildInsertValue(builder, result, source_count, 2, "clone.capacity")
                return result
            return null


        def emit_call(callee: Expr, arguments: darray[Expr]&, argument_names: darray[sview], local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            # `f[i64](x)` — an EXPLICIT type argument makes the callee an Index, not an
            # Ident; the bracket holds a TYPE, so it resolves as an annotation.
            if callee is Expr.Index(generic_callee, generic_argument, generic_call_line):
                if generic_callee is Expr.Ident(explicit_name, explicit_name_line):
                    if explicit_name == "darray_pop" and arguments.count == 1:
                        explicit_pop_type: ValueType = darray_type_behind_expr(arguments[0], local_scope, structs)
                        if explicit_pop_type.kind == TypeKind.DArray:
                            if darray_address_of_expr(arguments[0], local_scope, fns, structs, generics, runtime, m, ctx, builder) is explicit_pop_slot:
                                return emit_darray_pop_value(explicit_pop_slot, explicit_pop_type, structs, ctx, builder)
                        return null
                    explicit_type: ValueType = annotation_value_type(generic_argument, structs)
                    null return if explicit_type.kind == TypeKind.Unmodeled
                    null return if generic_index_of(generics, explicit_name) < 0
                    explicit_args: mutable darray[ValueType] = [explicit_type]
                    return emit_generic_call(explicit_name, explicit_args, arguments, argument_names, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                return null
            # `f[K, V](x)` — EXPLICIT multi-argument type application. The callee is an
            # IndexN whose bracket holds the type arguments.
            if callee is Expr.IndexN(multi_generic_callee, multi_generic_args, multi_generic_line):
                if multi_generic_callee is Expr.Ident(multi_name, multi_name_line):
                    null return if generic_index_of(generics, multi_name) < 0
                    multi_type_args: mutable darray[ValueType] = []
                    multi_declined: mutable bool = false
                    for type_argument_expression in multi_generic_args |multi_type_args, multi_declined, structs|:
                        resolved_type_argument: ValueType = annotation_value_type(type_argument_expression, structs)
                        multi_declined <- true if resolved_type_argument.kind == TypeKind.Unmodeled
                        multi_type_args.push(resolved_type_argument)
                    null return if multi_declined
                    return emit_generic_call(multi_name, multi_type_args, arguments, argument_names, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                return null
            # `xs.pop()` is a value-producing darray operation. Lower it before ordinary UFCS
            # lookup so stage1 does not manufacture an unresolved `darray_pop[T]` declaration.
            if callee is Expr.Field(pop_object, pop_method, pop_line):
                if pop_method == "pop" and arguments.count == 0:
                    pop_array_type: ValueType = darray_type_behind_expr(pop_object, local_scope, structs)
                    if pop_array_type.kind == TypeKind.DArray:
                        if darray_address_of_expr(pop_object, local_scope, fns, structs, generics, runtime, m, ctx, builder) is pop_slot:
                            return emit_darray_pop_value(pop_slot, pop_array_type, structs, ctx, builder)
                    return null
            if callee is Expr.Ident(callee_name, callee_line):
                # `ctx_hash_value(key)` — the compiler-emitted hash builtin (no user function
                # of that name exists), lowered per the key's concrete type.
                if callee_name == "ctx_hash_value" and arguments.count == 1:
                    return emit_hash_builtin(arguments[0], local_scope, fns, structs, generics, runtime, m, ctx, builder)
                # `__fstr(pieces…)` — the f-string builder desugared from `f"…"`.
                if callee_name == "__fstr":
                    return emit_fstr_builtin(arguments, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                # `size_of(T)` — the type's byte size as a compile-time constant (its argument
                # is a TYPE, so it resolves as an annotation). The dict grow path sizes its
                # bucket array with `size_of(DictBucket[K, T])`.
                if callee_name == "size_of" and arguments.count == 1:
                    size_of_type: ValueType = annotation_value_type(arguments[0], structs)
                    null return if size_of_type.kind == TypeKind.Unmodeled
                    return LLVMSizeOf(llvm_type_of(size_of_type, structs, ctx))
                # `sview(base, start, end)` — construct a string view `{ptr, len}` (stage0
                # `%StringView`). Used heavily by the self-host frontend (`empty_sview`,
                # token spans). Inline the aggregate rather than calling the runtime helper
                # so the product corpus does not depend on a pre-linked `@sview` when the
                # stage1 backend itself is the code under emission.
                if callee_name == "sview" and arguments.count == 3:
                    sview_type: ValueType = ValueType{kind: TypeKind.SView, bits: 0}
                    sview_llvm: LLVMTypeRef = llvm_type_of(sview_type, structs, ctx)
                    # A nullable `u8&?` is represented as `{i1, ptr}`. The constructor needs
                    # the payload pointer, not that tagged aggregate; unwrap it before the
                    # byte GEP. Plain cstr arguments remain the existing raw-pointer path.
                    sview_source_type: ValueType = expression_type(arguments[0], local_scope, fns, structs, generics)
                    sview_base: mutable LLVMValueRef = zeroed
                    sview_base_ok: mutable bool = false
                    if sview_source_type.kind == TypeKind.Optional and optional_payload_of(sview_source_type, structs).kind == TypeKind.Ref:
                        if emit_expression(arguments[0], sview_source_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is sview_optional_base:
                            sview_base <- LLVMBuildExtractValue(builder, sview_optional_base, 1, "sview.optional.data")
                            sview_base_ok <- true
                    elif emit_expression(arguments[0], ValueType{kind: TypeKind.CStr, bits: 0}, local_scope, fns, structs, generics, runtime, m, ctx, builder) is sview_direct_base:
                        sview_base <- sview_direct_base
                        sview_base_ok <- true
                    if sview_base_ok:
                        if emit_expression(arguments[1], ValueType{kind: TypeKind.Signed, bits: 64}, local_scope, fns, structs, generics, runtime, m, ctx, builder) is sview_start:
                            if emit_expression(arguments[2], ValueType{kind: TypeKind.Signed, bits: 64}, local_scope, fns, structs, generics, runtime, m, ctx, builder) is sview_end:
                                sview_len_val: LLVMValueRef = LLVMBuildSub(builder, sview_end, sview_start, "sview.len")
                                sview_gep_indices: mutable darray[LLVMValueRef] = [sview_start]
                                sview_gep_ptr: void& = (&sview_gep_indices[0]).cast[void&] can Unsafe.PointerCast
                                sview_data: LLVMValueRef = LLVMBuildGEP2(builder, LLVMInt8TypeInContext(ctx), sview_base, sview_gep_ptr, 1, "sview.data")
                                sview_agg: mutable LLVMValueRef = LLVMGetUndef(sview_llvm)
                                sview_agg <- LLVMBuildInsertValue(builder, sview_agg, sview_data, 0, "sview.ins0")
                                sview_agg <- LLVMBuildInsertValue(builder, sview_agg, sview_len_val, 1, "sview.ins1")
                                return sview_agg
                            return null
                        return null
                    return null
                # `i64(x)` / `u8(x)` — a prefix value CONVERSION (canonical `T(x)`; postfix
                # `x.i64()` is on the cast path). A scalar type name applied to ONE argument
                # converts it to the target scalar. A user cannot define a function named after a
                # scalar type, so this never shadows a real call. An untyped-literal argument
                # (`i64(5)`) is emitted directly at the target width.
                prefix_convert_target: ValueType = scalar_type_of_name(callee_name)
                if prefix_convert_target.kind != TypeKind.Unmodeled and arguments.count == 1:
                    prefix_convert_from: ValueType = expression_type(arguments[0], local_scope, fns, structs, generics)
                    if prefix_convert_from.kind == TypeKind.Unmodeled:
                        return emit_expression(arguments[0], prefix_convert_target, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                    if emit_expression(arguments[0], prefix_convert_from, local_scope, fns, structs, generics, runtime, m, ctx, builder) is prefix_convert_value:
                        return emit_conversion(prefix_convert_value, prefix_convert_from, prefix_convert_target, structs, ctx, builder)
                    return null
                # ATOMIC PRIMITIVE INTERCEPT: a call to a std atomic op — load/store/exchange/
                # fetch_add/fetch_sub/fetch_and/fetch_or/fetch_xor — whose FIRST argument is an
                # `atomic[T]&` (an integer cell) lowers to a REAL LLVM atomic instruction rather
                # than a plain function call (whose `slot.value` body is non-atomic). SeqCst
                # ordering, matching stage0's default. Gated on the atomic[T]-integer receiver, so
                # a user function of the same name on any other type is unaffected. compare_exchange
                # / fence / non-integer cells fall through to the normal call (sound: single-threaded
                # they behave identically; only true multi-thread atomicity differs).
                atomic_intercept_rmw: i64 = atomic_rmw_op_of(callee_name)
                atomic_intercept_load: bool = callee_name == "load"
                atomic_intercept_store: bool = callee_name == "store"
                if (atomic_intercept_rmw >= 0 or atomic_intercept_load or atomic_intercept_store) and arguments.count >= 1:
                    atomic_first_type: ValueType = expression_type(arguments[0], local_scope, fns, structs, generics)
                    if atomic_first_type.kind == TypeKind.Ref:
                        atomic_cell_type: ValueType = ref_target_of(atomic_first_type, structs)
                        if atomic_cell_type.kind == TypeKind.Struct and structs.names[atomic_cell_type.bits.usize()] == "atomic":
                            atomic_cell_slot: usize = atomic_cell_type.bits.usize()
                            atomic_value_index: i64 = field_index_of(structs, atomic_cell_slot, "value")
                            if atomic_value_index >= 0:
                                atomic_value_type: ValueType = copied_type(structs.field_types[structs.field_start[atomic_cell_slot] + atomic_value_index.usize()])
                                if atomic_value_is_integer(atomic_value_type):
                                    if emit_expression(arguments[0], atomic_first_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is atomic_cell_pointer:
                                        atomic_cell_llvm: LLVMTypeRef = llvm_type_of(atomic_cell_type, structs, ctx)
                                        atomic_value_llvm: LLVMTypeRef = llvm_type_of(atomic_value_type, structs, ctx)
                                        atomic_value_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, atomic_cell_llvm, atomic_cell_pointer, atomic_value_index.u32(), "atomic.value.ptr")
                                        atomic_align: u32 = (atomic_value_type.bits / 8).u32()
                                        if atomic_intercept_load:
                                            atomic_loaded: LLVMValueRef = LLVMBuildLoad2(builder, atomic_value_llvm, atomic_value_pointer, "atomic.load")
                                            LLVMSetOrdering(atomic_loaded, 7)
                                            LLVMSetAlignment(atomic_loaded, atomic_align)
                                            return atomic_loaded
                                        if atomic_intercept_store and arguments.count >= 2:
                                            if emit_expression(arguments[1], atomic_value_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is atomic_store_value:
                                                atomic_stored: LLVMValueRef = LLVMBuildStore(builder, atomic_store_value, atomic_value_pointer)
                                                LLVMSetOrdering(atomic_stored, 7)
                                                LLVMSetAlignment(atomic_stored, atomic_align)
                                                return atomic_stored
                                            return null
                                        if atomic_intercept_rmw >= 0 and arguments.count >= 2:
                                            if emit_expression(arguments[1], atomic_value_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is atomic_rmw_value:
                                                return LLVMBuildAtomicRMW(builder, atomic_intercept_rmw.i32(), atomic_value_pointer, atomic_rmw_value, 7, 0)
                                            return null
                # `arena_alloc(region, nbytes)` — the runtime allocator, callable by name from
                # std code. The region is an `Arena&` (a pointer); nbytes is a usize.
                if callee_name == "arena_alloc" and arguments.count == 2:
                    arena_ref_type: ValueType = intern_ref_type(ValueType{kind: TypeKind.Arena, bits: 0}, structs)
                    if emit_expression(arguments[0], arena_ref_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is alloc_region:
                        if emit_expression(arguments[1], ValueType{kind: TypeKind.Unsigned, bits: 64}, local_scope, fns, structs, generics, runtime, m, ctx, builder) is alloc_size:
                            alloc_args: mutable darray[LLVMValueRef] = [alloc_region, alloc_size]
                            alloc_args_pointer: void& = (&alloc_args[0]).cast[void&] can Unsafe.PointerCast
                            return LLVMBuildCall2(builder, runtime.arena_alloc_type, runtime.arena_alloc, alloc_args_pointer, 2, "arena.alloc")
                    return null
                # A GENERIC callee with an INFERRED type argument: `identity(42)`. The first
                # argument's own type supplies it — enough for the single-type-parameter
                # subset. A multi-parameter generic can't be inferred from one argument, so it
                # declines here and requires an explicit `f[K, V](…)`.
                if generic_index_of(generics, callee_name) >= 0:
                    null return if arguments.count == 0
                    inferred_slot: usize = generic_index_of(generics, callee_name).usize()
                    inferred_args: darray[ValueType] = infer_generic_args(inferred_slot, arguments, local_scope, fns, structs, generics)
                    null return if inferred_args.count == 0
                    return emit_generic_call(callee_name, inferred_args, arguments, argument_names, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                # Sibling methods inside `module M:` call each other as bare names; those
                # functions are stored under owner M. Overloads share a name: resolve by
                # arity first, then unique-name owner fallback into emit_direct_call.
                if lookup_function(fns, "", callee_name) is top_level_fn:
                    return emit_direct_call("", callee_name, callee, false, arguments, argument_names, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                bare_arity: usize = arguments.count
                bare_owner: mutable sview = ""
                bare_hits: mutable i64 = 0
                bare_arity_hits: mutable i64 = 0
                for bare_scan in 0..<fns.names.count |bare_owner, bare_hits, bare_arity_hits, callee_name, fns, bare_arity|:
                    if fns.names[bare_scan] == callee_name:
                        bare_hits <- bare_hits + 1
                        bare_owner <- fns.owners[bare_scan]
                        bare_arity_hits <- bare_arity_hits + 1 if fns.param_count[bare_scan] == bare_arity else bare_arity_hits
                # One arity match under some owner, or a unique bare name: emit_direct_call
                # re-selects by arity against that owner.
                if bare_arity_hits == 1 or bare_hits == 1:
                    return emit_direct_call(bare_owner, callee_name, callee, false, arguments, argument_names, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                # Multiple overloads across owners with same arity is ambiguous — decline.
                return null
            # `Node.Store(owner)` — build the AoS store: ask the runtime for its state, then
            # assemble `{arena, row_bytes, state}` with three insertvalues (stage0's shape).
            if callee is Expr.Field(store_ctor_head, store_ctor_member, store_ctor_line):
                if store_ctor_head is Expr.Ident(store_ctor_enum, store_ctor_enum_line):
                    if store_ctor_member == "Store":
                        store_ctor_index: i64 = packed_index_of(structs, store_ctor_enum)
                        if store_ctor_index >= 0:
                            null return if arguments.count != 1
                            # The owner is an Arena; the runtime takes it BY POINTER, so the
                            # argument must be a name whose slot we can hand over rather than
                            # a temporary.
                            if arguments[0] is Expr.Ident(owner_name, owner_line):
                                null return if lookup_type(local_scope, owner_name).kind != TypeKind.Arena
                                if lookup_slot(local_scope, owner_name) is owner_slot:
                                    row_bytes: i64 = packed_row_bytes(structs, store_ctor_index)
                                    state_args: mutable darray[LLVMValueRef] = [owner_slot, LLVMConstInt(LLVMInt64TypeInContext(ctx), row_bytes.u64(), 0)]
                                    state_pointer: void& = (&state_args[0]).cast[void&] can Unsafe.PointerCast
                                    state: LLVMValueRef = LLVMBuildCall2(builder, runtime.packed_state_new_type, runtime.packed_state_new, state_pointer, 2, "packed.store.state")
                                    store_type: ValueType = ValueType{kind: TypeKind.PackedStore, bits: store_ctor_index.u32()}
                                    store_llvm: LLVMTypeRef = llvm_type_of(store_type, structs, ctx)
                                    with_arena: LLVMValueRef = LLVMBuildInsertValue(builder, LLVMGetUndef(store_llvm), owner_slot, 0, "packed.store.arena")
                                    with_row: LLVMValueRef = LLVMBuildInsertValue(builder, with_arena, LLVMConstInt(LLVMInt64TypeInContext(ctx), row_bytes.u64(), 0), 1, "packed.store.row_bytes")
                                    return LLVMBuildInsertValue(builder, with_row, state, 2, "packed.store.state1")
                            return null

            # `Node.Leaf(v: 42)` inside an `in store:` block — a PACKED constructor. Unlike
            # a payload enum's inline value, this allocates a ROW: extract the arena/state
            # out of the active store, call alloc_fixed_tagged_variant_sparse_result(arena,
            # state, tag), zero the row, then write the payload. stage0's shape exactly.
            if callee is Expr.Field(packed_ctor_head, packed_ctor_variant, packed_ctor_line):
                packed_ctor_enum_name: sview = packed_constructor_enum_name(packed_ctor_head)
                if packed_ctor_enum_name != "":
                    packed_ctor_index: i64 = packed_index_of(structs, packed_ctor_enum_name)
                    if packed_ctor_index >= 0:
                        # No active store -> decline. stage0 rejects the same program
                        # ("requires an active in Node.Store: scope"), and there is no store
                        # to allocate the row from anyway.
                        packed_store_index: i64 = packed_root_index_of(structs, packed_ctor_index)
                        null return if packed_store_index < 0
                        null return if runtime.active_store_enum != packed_store_index
                        packed_tag: i64 = packed_variant_index(structs, packed_ctor_index, packed_ctor_variant)
                        null return if packed_tag < 0
                        packed_slot_index: usize = structs.packed_variant_start[packed_ctor_index.usize()] + packed_variant_local_index(structs, packed_ctor_index, packed_ctor_variant).usize()
                        packed_wants_payload: bool = structs.packed_has_payload[packed_slot_index]
                        packed_commons: u32 = structs.packed_common_counts[packed_ctor_index.usize()]
                        # `new Expr.Int(span: 1, value: 42)` — the COMMON args come first,
                        # then at most one payload arg. The parser prepends commons to the
                        # variant's field list, so the arity is commons (+1 with a payload).
                        packed_field_count: usize = structs.packed_field_type_count[packed_slot_index]
                        packed_expected_args: usize = packed_commons.usize() + packed_field_count
                        null return if arguments.count != packed_expected_args

                        packed_arena: LLVMValueRef = LLVMBuildExtractValue(builder, runtime.active_store, 0, "packed.arena")
                        packed_state: LLVMValueRef = LLVMBuildExtractValue(builder, runtime.active_store, 2, "packed.state")
                        packed_alloc_args: mutable darray[LLVMValueRef] = [packed_arena, packed_state, LLVMConstInt(LLVMInt32TypeInContext(ctx), packed_tag.u64(), 0)]
                        if runtime.packed_mode == 2:
                            packed_alloc_args <- [packed_arena, packed_state]
                        packed_alloc_pointer: void& = (&packed_alloc_args[0]).cast[void&] can Unsafe.PointerCast
                        packed_alloc_result: LLVMValueRef = LLVMBuildCall2(builder, runtime.packed_alloc_type, runtime.packed_alloc, packed_alloc_pointer, 2 if runtime.packed_mode == 2 else 3, "packed.variant.alloc")
                        packed_row: LLVMValueRef = LLVMBuildExtractValue(builder, packed_alloc_result, 0, "packed.alloc.ptr")

                        packed_handle_llvm: LLVMTypeRef = packed_row_llvm_type(structs, packed_ctor_index, ctx)
                        _ = LLVMBuildStore(builder, LLVMConstNull(packed_handle_llvm), packed_row)
                        packed_tag_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, packed_handle_llvm, packed_row, 0, "packed.tag.ptr")
                        _ = LLVMBuildStore(builder, LLVMConstInt(LLVMInt32TypeInContext(ctx), packed_tag.u64(), 0), packed_tag_pointer)
                        # Commons are stored INLINE at fields 1..commons, ahead of the payload.
                        packed_common_ok: mutable bool = true
                        for common_index in 0..<packed_commons.usize() |packed_common_ok, arguments, packed_handle_llvm, packed_row, local_scope, fns, structs, generics, runtime, m, ctx, builder|:
                            common_slot_type: ValueType = ValueType{kind: TypeKind.Signed, bits: 64}
                            if emit_expression(arguments[common_index], common_slot_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is common_value:
                                common_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, packed_handle_llvm, packed_row, (1 + common_index).u32(), "packed.common.ptr")
                                _ = LLVMBuildStore(builder, common_value, common_pointer)
                            else:
                                packed_common_ok <- false
                        null return if not packed_common_ok
                        if packed_wants_payload:
                            packed_payload_type: ValueType = copied_type(structs.packed_payloads[packed_slot_index])
                            packed_payload_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, packed_handle_llvm, packed_row, (1 + packed_commons), "packed.payload.ptr")
                            if packed_field_count == 1:
                                if emit_expression(arguments[packed_commons.usize()], packed_payload_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is packed_payload_value:
                                    _ = LLVMBuildStore(builder, packed_payload_value, packed_payload_pointer)
                                else:
                                    return null
                            else:
                                payload_llvm: LLVMTypeRef = llvm_type_of(packed_payload_type, structs, ctx)
                                payload_value: mutable LLVMValueRef = LLVMGetUndef(payload_llvm)
                                payload_start: usize = structs.packed_field_type_start[packed_slot_index]
                                for payload_index in 0..<packed_field_count |payload_value, payload_start, arguments, packed_commons, structs, local_scope, fns, generics, runtime, m, ctx, builder|:
                                    field_type: ValueType = copied_type(structs.packed_field_types[payload_start + payload_index])
                                    if emit_expression(arguments[packed_commons.usize() + payload_index], field_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is field_value:
                                        payload_value <- LLVMBuildInsertValue(builder, payload_value, field_value, payload_index.u32(), "packed.payload.field")
                                    else:
                                        return null
                                _ = LLVMBuildStore(builder, payload_value, packed_payload_pointer)
                        if runtime.packed_mode == 1:
                            packed_prefix_args: mutable darray[LLVMValueRef] = [packed_arena, packed_row, packed_state]
                            packed_prefix_pointer: void& = (&packed_prefix_args[0]).cast[void&] can Unsafe.PointerCast
                            LLVMBuildCall2(builder, runtime.packed_record_prefix_type, runtime.packed_record_prefix, packed_prefix_pointer, 3, "")
                        # The VALUE is the row's INDEX, not the row.
                        return LLVMBuildExtractValue(builder, packed_alloc_result, 1, "packed.alloc.index")

            # `Shape.Circle(42)` — a payload-enum CONSTRUCTOR. stage0 emits: alloca, store
            # zeroinitializer, store the tag at field 0, store the payload at field 1, load
            # the value. Only ONE payload argument is modeled, matching what
            # register_payload_enum accepts.
            if callee is Expr.Field(ctor_head, ctor_variant, ctor_line):
                if ctor_head is Expr.Ident(ctor_enum_name, ctor_enum_line):
                    ctor_enum_index: i64 = penum_index_of(structs, ctor_enum_name)
                    if ctor_enum_index >= 0:
                        ctor_tag: i64 = penum_variant_index(structs, ctor_enum_index, ctor_variant)
                        null return if ctor_tag < 0
                        ctor_variant_slot: usize = structs.penum_variant_start[ctor_enum_index.usize()] + ctor_tag.usize()
                        # `Shape.Rect(4, 5)` — a MULTI-FIELD variant: build the field tuple and
                        # store it at the payload pointer (stage0's `store {i64,i64} …`).
                        if structs.penum_field_type_count[ctor_variant_slot] > 1:
                            null return if arguments.count != structs.penum_field_type_count[ctor_variant_slot]
                            multi_type: ValueType = ValueType{kind: TypeKind.PayloadEnum, bits: ctor_enum_index.u32()}
                            multi_llvm: LLVMTypeRef = llvm_type_of(multi_type, structs, ctx)
                            multi_slot_alloca: LLVMValueRef = LLVMBuildAlloca(builder, multi_llvm, "enum.ctor")
                            _ = LLVMBuildStore(builder, LLVMConstNull(multi_llvm), multi_slot_alloca)
                            multi_tag_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, multi_llvm, multi_slot_alloca, 0, "enum.tag.ptr")
                            _ = LLVMBuildStore(builder, LLVMConstInt(LLVMInt32TypeInContext(ctx), ctor_tag.u64(), 0), multi_tag_pointer)
                            multi_tuple_llvm: LLVMTypeRef = penum_field_tuple_type(ctor_variant_slot, structs, ctx)
                            multi_field_start: usize = structs.penum_field_type_start[ctor_variant_slot]
                            multi_tuple_value: mutable LLVMValueRef = LLVMGetUndef(multi_tuple_llvm)
                            multi_declined: mutable bool = false
                            for multi_index in 0..<arguments.count |multi_tuple_value, multi_declined, multi_field_start, arguments, structs, local_scope, fns, generics, runtime, m, ctx, builder|:
                                multi_field_type: ValueType = copied_type(structs.penum_field_types[multi_field_start + multi_index])
                                if emit_expression(arguments[multi_index], multi_field_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is multi_field_value:
                                    multi_tuple_value <- LLVMBuildInsertValue(builder, multi_tuple_value, multi_field_value, multi_index.u32(), "enum.field")
                                else:
                                    multi_declined <- true
                            null return if multi_declined
                            multi_payload_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, multi_llvm, multi_slot_alloca, 1, "enum.payload.ptr")
                            _ = LLVMBuildStore(builder, multi_tuple_value, multi_payload_pointer)
                            return LLVMBuildLoad2(builder, multi_llvm, multi_slot_alloca, "enum.value")
                        null return if arguments.count != 1
                        ctor_type: ValueType = ValueType{kind: TypeKind.PayloadEnum, bits: ctor_enum_index.u32()}
                        ctor_payload_type: ValueType = copied_type(structs.penum_payloads[structs.penum_variant_start[ctor_enum_index.usize()] + ctor_tag.usize()])
                        null return if ctor_payload_type.kind == TypeKind.Unmodeled
                        ctor_llvm: LLVMTypeRef = llvm_type_of(ctor_type, structs, ctx)
                        ctor_slot: LLVMValueRef = LLVMBuildAlloca(builder, ctor_llvm, "enum.ctor")
                        _ = LLVMBuildStore(builder, LLVMConstNull(ctor_llvm), ctor_slot)
                        ctor_tag_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, ctor_llvm, ctor_slot, 0, "enum.tag.ptr")
                        _ = LLVMBuildStore(builder, LLVMConstInt(LLVMInt32TypeInContext(ctx), ctor_tag.u64(), 0), ctor_tag_pointer)
                        if emit_expression(arguments[0], ctor_payload_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is ctor_payload_value:
                            ctor_payload_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, ctor_llvm, ctor_slot, 1, "enum.payload.ptr")
                            _ = LLVMBuildStore(builder, ctor_payload_value, ctor_payload_pointer)
                            return LLVMBuildLoad2(builder, ctor_llvm, ctor_slot, "enum.value")
                        return null

            # UFCS: `p.get(a)` IS `get(p, a)`. A postfix call unifies casts and UFCS —
            # `recv.Name()` where Name is a TYPE name is a conversion (handled on the cast
            # path), and where Name is a FUNCTION it is an ordinary call with the receiver
            # as the leading argument. Only the latter is resolved here; a name that is
            # neither declines rather than inventing a call.
            if callee is Expr.Field(receiver, method_name, method_line):
                method_as_type: ValueType = scalar_type_of_name(method_name)
                null return if method_as_type.kind != TypeKind.Unmodeled
                # A dict receiver's `.get`/`.put`/… are SYNTHESIZED calls to std generics, not
                # UFCS to a user function. Detected before the ordinary UFCS lookup because no
                # `get`/`put` function exists to find.
                dict_args: darray[ValueType] = dict_type_args_of(receiver, local_scope, fns, structs, generics)
                if dict_args.count != 0:
                    dict_helper: sview = dict_method_helper(method_name)
                    if dict_helper != "":
                        dict_arena_leading: bool = dict_method_is_mutating(method_name)
                        return emit_dict_method_call(dict_helper, dict_args, receiver, arguments, dict_arena_leading, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                # `recv.f(a)` where `f` is a GENERIC user function (`f[T](self: Slice[T], …)`) —
                # the receiver is parameter 0. Try EVERY template slot named `f` and pick the one
                # whose parameter 0 unifies with THIS receiver (the wrong overload leaves a type
                # param unbound → infer returns empty). The selected slot is threaded through
                # instantiation so an overloaded name emits the correct body. This is what the whole
                # UFCS surface of Slice/Deque/IndexMap/InlineVec needs. Checked before the
                # non-generic lookup, which only finds monomorphic functions.
                if generic_index_of(generics, method_name) >= 0:
                    ufcs_chosen_slot: mutable i64 = -1
                    ufcs_chosen_args: mutable darray[ValueType] = []
                    for ufcs_cand_slot in 0..<generics.names.count |ufcs_chosen_slot, ufcs_chosen_args, method_name, receiver, arguments, local_scope, fns, structs, generics|:
                        continue if ufcs_chosen_slot >= 0 or generics.names[ufcs_cand_slot] != method_name
                        ufcs_cand_args: darray[ValueType] = infer_generic_args_ufcs(ufcs_cand_slot, receiver, arguments, local_scope, fns, structs, generics)
                        if ufcs_cand_args.count != 0:
                            ufcs_chosen_slot <- ufcs_cand_slot.i64()
                            ufcs_chosen_args <- ufcs_cand_args
                    if ufcs_chosen_slot >= 0:
                        return emit_generic_ufcs_call(ufcs_chosen_slot.usize(), ufcs_chosen_args, receiver, arguments, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                    return null
                ufcs_target_opt: LLVMValueRef? = lookup_function(fns, "", method_name)
                if ufcs_target_opt is ufcs_target:
                    return emit_direct_call("", method_name, receiver, true, arguments, argument_names, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                # Module methods (`module Lexer: def is_digit`) are stored under their owner
                # (`@Lexer.is_digit`). UFCS `c.is_digit()` must still find them. Prefer a
                # unique bare name; when several owners share the name (Lexer.peek vs
                # Parser.peek), disambiguate by UFCS arity (receiver + explicit args) so
                # product meta-compile does not decline the whole callee.
                ufcs_total_arity: usize = arguments.count + 1
                ufcs_owner: mutable sview = ""
                ufcs_hits: mutable i64 = 0
                ufcs_arity_owner: mutable sview = ""
                ufcs_arity_hits: mutable i64 = 0
                for ufcs_scan in 0..<fns.names.count |ufcs_owner, ufcs_hits, ufcs_arity_owner, ufcs_arity_hits, method_name, ufcs_total_arity, fns|:
                    if fns.names[ufcs_scan] == method_name:
                        ufcs_hits <- ufcs_hits + 1
                        ufcs_owner <- fns.owners[ufcs_scan]
                        if fns.param_count[ufcs_scan] == ufcs_total_arity:
                            ufcs_arity_hits <- ufcs_arity_hits + 1
                            ufcs_arity_owner <- fns.owners[ufcs_scan]
                if ufcs_hits == 1 and ufcs_owner != "":
                    return emit_direct_call(ufcs_owner, method_name, receiver, true, arguments, argument_names, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                if ufcs_arity_hits == 1 and ufcs_arity_owner != "":
                    return emit_direct_call(ufcs_arity_owner, method_name, receiver, true, arguments, argument_names, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                return null
            # `M::get(a)` — a MODULE-qualified call. `::` parses to Expr.Scope, a node kind
            # distinct from Expr.Field, so a qualified call is never confused with UFCS.
            # Only a single level is modeled: `A::B::get` nests Scope inside Scope, whose
            # head is not an Ident, so it declines rather than mangling a wrong symbol.
            if callee is Expr.Scope(scope_head, scope_name, scope_line):
                if scope_head is Expr.Ident(module_name, module_name_line):
                    return emit_direct_call(module_name, scope_name, callee, false, arguments, argument_names, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                return null
            return null


        # Emit a call to a NON-generic function by name. UFCS passes its receiver as a
        # SEPARATE leading argument rather than prepending it to a list: building a local
        # `darray[Expr]` of receiver-then-arguments CRASHES stage0 (SIGTRAP inside cgo —
        # bisected to the darray construction itself, a darray of packed-enum node handles
        # built in this function). Threading the receiver is the only spelling that
        # compiles, not a style preference. `receiver` is ignored when `has_receiver` is
        # false; callers pass the callee node itself rather than synthesize a dummy.
        def emit_direct_call(callee_owner: sview, callee_name: sview, receiver: Expr, has_receiver: bool, arguments: darray[Expr]&, argument_names: darray[sview]&, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            total_arguments: usize = arguments.count + 1 if has_receiver else arguments.count
            # Prefer arity-matched overload (Token 4-arg vs 5-arg constructors). Name-only
            # lookup is only the fallback for unique names / legacy single entries.
            fn_index: mutable i64 = function_index_of_arity(fns, callee_owner, callee_name, total_arguments)
            fn_index <- function_index_of(fns, callee_owner, callee_name) if fn_index < 0
            null return if fn_index < 0
            target: LLVMValueRef = fns.handles[fn_index.usize()]
            # LLVMCountParams counts the implicit trailing ARENA too, so the arity check
            # must expect it — otherwise every call to an arena-threading function
            # declines on a spurious mismatch.
            wants_arena: bool = fns.needs_arena[fn_index.usize()]
            wants_store: bool = fns.needs_store[fn_index.usize()]
            variadic_call: bool = fns.is_variadic[fn_index.usize()]
            fixed_arguments: usize = fns.param_count[fn_index.usize()]
            null return if variadic_call and total_arguments < fixed_arguments
            expected_params: usize = fixed_arguments + (1 if wants_arena else 0) + (1 if wants_store else 0) if variadic_call else total_arguments + (1 if wants_arena else 0) + (1 if wants_store else 0)
            null return if LLVMCountParams(target).i64() != expected_params.i64()

            argument_values: mutable darray[LLVMValueRef] = []
            declined: mutable bool = false
            argument_index: mutable usize = 0
            if has_receiver:
                receiver_param: ValueType = copied_type(fns.param_types[fns.param_start[fn_index.usize()]]) if fixed_arguments > 0 else unmodeled_type()
                receiver_value: LLVMValueRef? = emit_expression(receiver, receiver_param, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                if receiver_value is emitted_receiver:
                    argument_values.push(emitted_receiver)
                else:
                    declined <- true
                argument_index <- 1
            named_call: mutable bool = false
            for argument_name in argument_names |named_call|:
                named_call <- true if argument_name != ""
            if named_call:
                null return if variadic_call
                named_position: mutable usize = 1 if has_receiver else 0
                while named_position < fixed_arguments |argument_values, declined, named_position, argument_names, fns, fn_index, arguments, local_scope, structs, generics, runtime, m, ctx, builder|:
                    source_index: i64 = named_argument_index(argument_names, fns.param_names, fns.param_start[fn_index.usize()], fixed_arguments, named_position if has_receiver else 0, named_position)
                    null return if source_index < 0 or source_index.usize() >= arguments.count
                    named_argument: Expr = arguments[source_index.usize()]
                    named_type: ValueType = copied_type(fns.param_types[fns.param_start[fn_index.usize()] + named_position])
                    if emit_expression(named_argument, named_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is named_value:
                        argument_values.push(named_value)
                    else:
                        declined <- true
                    named_position <- named_position + 1
                null return if declined
            else:
                for argument in arguments |argument_values, declined, argument_index, target, local_scope, fns, structs, generics, runtime, m, ctx, builder, fn_index, fixed_arguments, variadic_call|:
                    # Each argument is emitted at its PARAMETER's declared type, so a
                    # literal argument adopts the parameter type rather than i64.
                    argument_type: mutable ValueType = copied_type(fns.param_types[fns.param_start[fn_index.usize()] + argument_index]) if argument_index < fixed_arguments else expression_type(argument, local_scope, fns, structs, generics)
                    if variadic_call and argument_index >= fixed_arguments and argument_type.kind == TypeKind.Unmodeled:
                        argument_type <- ValueType{kind: TypeKind.Float, bits: 64} if argument is Expr.FloatLit(_)
                        argument_type <- ValueType{kind: TypeKind.Signed, bits: 32} if not (argument is Expr.FloatLit(_))
                    argument_value: LLVMValueRef? = emit_expression(argument, argument_type, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                    if argument_value is emitted_argument:
                        if variadic_call and argument_index >= fixed_arguments:
                            promoted_type: ValueType = c_variadic_promoted_type(argument_type)
                            if emit_conversion(emitted_argument, argument_type, promoted_type, structs, ctx, builder) is promoted_argument:
                                argument_values.push(promoted_argument)
                            else:
                                declined <- true
                        else:
                            argument_values.push(emitted_argument)
                    else:
                        declined <- true
                    argument_index <- argument_index + 1
            null return if declined

            # LLVMBuildCall2 needs the callee's FUNCTION type, not its pointer
            # type: LLVM pointers are opaque, so the type cannot be recovered from
            # the value itself.
            fn_type: LLVMTypeRef = LLVMGlobalGetValueType(target)
            # A VOID call must be unnamed: "instructions returning void cannot have a name".
            result_name: cstr = call_result_name(copied_type(fns.returns[fn_index.usize()]))
            # Hand the callee OUR region when its signature threads one: the container
            # it grows is ours, so its backing must come from a region that outlives
            # the call.
            argument_values.push(runtime.arena) if wants_arena
            argument_values.push(runtime.active_store) if wants_store
            LLVMBuildCall2(builder, fn_type, target, null, 0, result_name) return if argument_values.count == 0
            args_pointer: void& = (&argument_values[0]).cast[void&] can Unsafe.PointerCast
            return LLVMBuildCall2(builder, fn_type, target, args_pointer, argument_values.count.u32(), result_name)


        # The type a value will actually have: its own if known, else the context's.
        # An integer literal has no intrinsic type, so `expected` is what makes
        # `a: u8 = 200` a u8 rather than an i64 that is then truncated behind your back.
        def resolve_type(expression: Expr, expected: ValueType, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&) -> ValueType can[Abort.Panic]:
            own: ValueType = expression_type(expression, local_scope, fns, structs, generics)
            own return if own.kind != TypeKind.Unmodeled
            return expected


        # Convert `value` from `from_type` to `to_type`. Widening sign-extends a signed
        # source and zero-extends an unsigned one (that IS the difference between
        # `u8 200 -> i64 200` and `i8 200 -> i64 -56`); narrowing truncates. Same width is
        # a no-op — a signed/unsigned reinterpretation costs no instruction.
        def emit_conversion(value: LLVMValueRef, from_type: ValueType, to_type: ValueType, structs: mutable StructTable&, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic]:
            null return if from_type.kind == TypeKind.Unmodeled or to_type.kind == TypeKind.Unmodeled
            target: LLVMTypeRef = llvm_type_of(to_type, structs, ctx)
            # bool <-> int needs an explicit widening decision; only int<->int, float, and
            # the identity are modeled.
            if from_type.kind == TypeKind.Bool or to_type.kind == TypeKind.Bool:
                value return if from_type.kind == to_type.kind
                return null

            # float -> int TRUNCATES toward zero (`7.5.i64()` is 7, and `(-7.5).i64()` is
            # -7), which is what FPToSI does — verified against stage0.
            if from_type.kind == TypeKind.Float and to_type.kind != TypeKind.Float:
                return LLVMBuildFPToSI(builder, value, target, "fptosi") if to_type.kind == TypeKind.Signed else LLVMBuildFPToUI(builder, value, target, "fptoui")
            # int -> float follows the SOURCE's signedness: u8 200 becomes 200.0, i8 -56
            # becomes -56.0.
            if to_type.kind == TypeKind.Float and from_type.kind != TypeKind.Float:
                return LLVMBuildSIToFP(builder, value, target, "sitofp") if from_type.kind == TypeKind.Signed else LLVMBuildUIToFP(builder, value, target, "uitofp")
            if from_type.kind == TypeKind.Float and to_type.kind == TypeKind.Float:
                value return if from_type.bits == to_type.bits
                return LLVMBuildFPTrunc(builder, value, target, "fptrunc") if to_type.bits < from_type.bits else LLVMBuildFPExt(builder, value, target, "fpext")

            # POINTER <-> INTEGER is a distinct cast, not a width change: `zext ptr .. to i64`
            # is invalid IR llc rejects. The std takes a pointer DIFFERENCE this way --
            # arena_tail_offset_slots is `(ptr.cast[heap u8&].usize() - base.usize()) / stride`
            # -- so every dict program went through here.
            from_is_pointer: bool = from_type.kind == TypeKind.Ref or from_type.kind == TypeKind.CStr
            to_is_pointer: bool = to_type.kind == TypeKind.Ref or to_type.kind == TypeKind.CStr
            if from_is_pointer or to_is_pointer:
                LLVMBuildPtrToInt(builder, value, target, "ptrtoint") return if from_is_pointer and is_integer_type(to_type)
                LLVMBuildIntToPtr(builder, value, target, "inttoptr") return if to_is_pointer and is_integer_type(from_type)
                # ptr -> ptr is a no-op under opaque pointers; anything else is unmodeled.
                value return if from_is_pointer and to_is_pointer
                return null

            value return if from_type.bits == to_type.bits
            LLVMBuildTrunc(builder, value, target, "trunc") return if to_type.bits < from_type.bits
            return LLVMBuildSExt(builder, value, target, "sext") if from_type.kind == TypeKind.Signed else LLVMBuildZExt(builder, value, target, "zext")


        # The ADDRESS of `xs[i]` for a DARRAY.
        #
        # ONE index, not two: `items` is already a `T*`, so there is no leading 0 to step
        # over the way a fixed array's pointer-to-array needs.
        def emit_darray_index_address(array_slot: LLVMValueRef, array_type: ValueType, index_expression: Expr, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            null return if array_type.kind != TypeKind.DArray
            element_type: ValueType = darray_element_of(array_type, structs)
            null return if element_type.kind == TypeKind.Unmodeled
            index_type: ValueType = ValueType{kind: TypeKind.Signed, bits: 64}
            if emit_expression(index_expression, index_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is index_value:
                emit_index_bounds_guard(array_slot, array_type, index_value, runtime, structs, m, ctx, builder)
                items_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, darray_llvm_type(structs, ctx), array_slot, 0, "darray.items.ptr")
                items: LLVMValueRef = LLVMBuildLoad2(builder, LLVMPointerTypeInContext(ctx, 0), items_pointer, "darray.items")
                tag_darray_header_access(items, ctx)
                indices: mutable darray[LLVMValueRef] = [index_value]
                indices_pointer: void& = (&indices[0]).cast[void&] can Unsafe.PointerCast
                element_pointer: LLVMValueRef = LLVMBuildGEP2(builder, llvm_type_of(element_type, structs, ctx), items, indices_pointer, 1, "darray.elem.ptr")
                return element_pointer
            return null


        # The ADDRESS of `xs[i]`.
        #
        # A two-index GEP: the first index (always 0) steps over the array POINTER itself,
        # the second selects the element — the classic C-array shape. StructGEP cannot be
        # used because the index is dynamic.
        #
        # NO BOUNDS CHECK: the subset does not model one. That matches `-emit obj` without
        # -fbounds-check, which is what the differential compares against; a checked build
        # is a separate feature, not a silent default.
        def emit_index_address(array_slot: LLVMValueRef, array_type: ValueType, index_expression: Expr, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            null return if array_type.kind != TypeKind.Array
            index_type: ValueType = ValueType{kind: TypeKind.Signed, bits: 64}
            if emit_expression(index_expression, index_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is index_value:
                emit_index_bounds_guard(array_slot, array_type, index_value, runtime, structs, m, ctx, builder)
                indices: mutable darray[LLVMValueRef] = [LLVMConstInt(LLVMInt64TypeInContext(ctx), 0, 0), index_value]
                indices_pointer: void& = (&indices[0]).cast[void&] can Unsafe.PointerCast
                return LLVMBuildGEP2(builder, llvm_type_of(array_type, structs, ctx), array_slot, indices_pointer, 2, "elem.ptr")
            return null


        # Copy a Runtime out of a reference (same borrow rule as copied_type).
        def copied_runtime(runtime: Runtime&) -> Runtime:
            return Runtime{
                owns_arena: runtime.owns_arena,
                fast_math: runtime.fast_math,
                force_bounds_check: runtime.force_bounds_check,
                active_store: runtime.active_store,
                active_store_enum: runtime.active_store_enum,
                error_out: runtime.error_out,
                in_error_fn: runtime.in_error_fn,
                streq: runtime.streq,
                streq_type: runtime.streq_type,
                sview_eq: runtime.sview_eq,
                sview_eq_type: runtime.sview_eq_type,
                sview_index: runtime.sview_index,
                sview_index_type: runtime.sview_index_type,
                debug_builder: runtime.debug_builder,
                debug_file: runtime.debug_file,
                debug_active: runtime.debug_active,
                trace_record: runtime.trace_record,
                trace_record_type: runtime.trace_record_type,
                trace_record_value: runtime.trace_record_value,
                trace_record_value_type: runtime.trace_record_value_type,
                trace_name: runtime.trace_name,
                trace_enabled: runtime.trace_enabled,
                trace_fault_install: runtime.trace_fault_install,
                trace_fault_install_type: runtime.trace_fault_install_type,
                disjoint_function_name: runtime.disjoint_function_name,
                disjoint_function_mask: runtime.disjoint_function_mask,
                disjoint_param_slots: runtime.disjoint_param_slots,
                disjoint_param_indices: runtime.disjoint_param_indices,
                disjoint_element_ptrs: runtime.disjoint_element_ptrs,
                disjoint_element_indices: runtime.disjoint_element_indices,
                packed_state_new: runtime.packed_state_new,
                packed_state_new_type: runtime.packed_state_new_type,
                packed_alloc: runtime.packed_alloc,
                packed_alloc_type: runtime.packed_alloc_type,
                packed_alloc_result_type: runtime.packed_alloc_result_type,
                packed_read_tag: runtime.packed_read_tag,
                packed_read_tag_type: runtime.packed_read_tag_type,
                packed_read_word: runtime.packed_read_word,
                packed_read_word_type: runtime.packed_read_word_type,
                packed_record_prefix: runtime.packed_record_prefix,
                packed_record_prefix_type: runtime.packed_record_prefix_type,
                packed_mode: runtime.packed_mode,
                new_region_backend: runtime.new_region_backend,
                new_region_backend_type: runtime.new_region_backend_type,
                arena_alloc: runtime.arena_alloc,
                arena_realloc: runtime.arena_realloc,
                arena_free: runtime.arena_free,
                arena_alloc_type: runtime.arena_alloc_type,
                arena_realloc_type: runtime.arena_realloc_type,
                arena_free_type: runtime.arena_free_type,
                arena: runtime.arena
            }


        # `arena_free(region)` — release the function's auto region. Idempotent in the
        # runtime and a no-op for a region that never allocated (strategy 2 is lazy), so
        # emitting it unconditionally on every return path is correct and cheap.
        def emit_region_free(runtime: Runtime&, builder: LLVMBuilderRef) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            # A BORROWED region (the caller's, threaded in) is not ours to free.
            return if not runtime.owns_arena
            arguments: mutable darray[LLVMValueRef] = [runtime.arena]
            arguments_pointer: void& = (&arguments[0]).cast[void&] can Unsafe.PointerCast
            _ = LLVMBuildCall2(builder, runtime.arena_free_type, runtime.arena_free, arguments_pointer, 1, "")


        # `xs.push(v)` — grow-if-needed, store, bump count.
        #
        # Mirrors stage0's lowering, read out of its own `-emit llvm` output:
        #
        #   count = xs.count; needed = count + 1
        #   if xs.capacity < needed:
        #       new_cap = capacity == 0 ? 256 : max(capacity * 2, needed)
        #       items = xs.items == null ? arena_alloc(arena, new_bytes)
        #                                : arena_realloc(arena, items, old_bytes, new_bytes)
        #       xs.items = items; xs.capacity = new_cap
        #   xs.items[count] = v; xs.count = needed
        #
        # The 256 initial capacity is stage0's, not a guess. Overflow TRAPS are omitted:
        # they only abort on a capacity that cannot occur in a modeled program, so their
        # absence is unobservable in the differential — but it does mean this lowering is
        # not a bit-for-bit clone, only a behavioural one.
        # Tag a loop's LATCH branch `!llvm.loop !{ <self>, !{ "elisa.autovec.expected", pos,
        # reason } }` — stage0's exact shape.
        #
        # The marker rides IN THE IR, which is the point: it survives inlining (a held
        # function reference would not), so a post-optimization pass can still identify a
        # comprehension build loop that was lowered to be vectorizable and then wasn't. That
        # is the entire basis of `-Wperf`.
        #
        # LLVM requires a loop-ID node's operand 0 to be the node ITSELF, so it is built via
        # a temporary that is then replaced by the finished node.
        def tag_autovec_loop(branch: LLVMValueRef, position: sview, ctx: LLVMContextRef) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            position_storage: mutable darray[u8] = []
            position_text: cstr = sview_to_cstr(position, position_storage)
            marker_name: LLVMMetadataRef = LLVMMDStringInContext2(ctx, "elisa.autovec.expected", 22)
            position_md: LLVMMetadataRef = LLVMMDStringInContext2(ctx, position_text, sview_len(position))
            reason_md: LLVMMetadataRef = LLVMMDStringInContext2(ctx, "", 0)
            marker_ops: mutable darray[LLVMMetadataRef] = [marker_name, position_md, reason_md]
            marker_pointer: void& = (&marker_ops[0]).cast[void&] can Unsafe.PointerCast
            marker_node: LLVMMetadataRef = LLVMMDNodeInContext2(ctx, marker_pointer, 3)

            temporary: LLVMMetadataRef = LLVMTemporaryMDNode(ctx, null, 0)
            loop_ops: mutable darray[LLVMMetadataRef] = [temporary, marker_node]
            loop_pointer: void& = (&loop_ops[0]).cast[void&] can Unsafe.PointerCast
            loop_id: LLVMMetadataRef = LLVMMDNodeInContext2(ctx, loop_pointer, 2)
            LLVMMetadataReplaceAllUsesWith(temporary, loop_id)

            kind: u32 = LLVMGetMDKindIDInContext(ctx, "llvm.loop", 9)
            LLVMSetMetadata(branch, kind, LLVMMetadataAsValue(ctx, loop_id))


        # `[BODY for VAR in LOW..<HIGH]` — a list comprehension, lowered PRESIZE-AND-FILL the
        # way stage0 does: compute the count, allocate the backing once, set count/capacity
        # up front, then write each element BY INDEX.
        #
        # Not a push loop. A push loop is behaviourally identical and would pass every
        # differential here, but it reallocates as it grows and defeats the vectorizer — and
        # vectorization is the whole point of the construct (`-Wperf`'s autovec verifier tags
        # exactly these loops and reports the ones that failed). Emitting the slow shape for
        # a construct that exists to be fast would be a divergence the exit code cannot see.
        #
        # Constant filters preserve the presized lowering: `if true` is ordinary and
        # `if false` produces an empty darray.
        # `any VAR in ITER where COND` — bool quantifier (Comprehension with empty body).
        # Models fixed array-literal iterables (the self-host `valid_suffix` shape) by
        # unrolling: bind VAR to each element and short-circuit on first true COND.
        def emit_any_quantifier(comprehension_var: sview, iterable: Expr, condition: Expr, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            if iterable is Expr.Array(elements, array_line):
                null return if elements.count == 0
                bool_ty: LLVMTypeRef = LLVMInt1TypeInContext(ctx)
                result_slot: LLVMValueRef = LLVMBuildAlloca(builder, bool_ty, "any.result")
                _ = LLVMBuildStore(builder, LLVMConstInt(bool_ty, 0, 0), result_slot)
                function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                done_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "any.done")
                declined: mutable bool = false
                for element in elements |declined, comprehension_var, condition, result_slot, done_block, function, local_scope, fns, structs, generics, runtime, m, ctx, builder|:
                    continue if declined
                    elem_type: mutable ValueType = expression_type(element, local_scope, fns, structs, generics)
                    if elem_type.kind == TypeKind.Unmodeled:
                        elem_type <- ValueType{kind: TypeKind.CStr, bits: 0}
                    if emit_expression(element, elem_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is elem_value:
                        var_slot: LLVMValueRef = LLVMBuildAlloca(builder, llvm_type_of(elem_type, structs, ctx), "any.var")
                        _ = LLVMBuildStore(builder, elem_value, var_slot)
                        declare_local(local_scope, comprehension_var, var_slot, elem_type)
                        if emit_condition(condition, local_scope, fns, structs, generics, runtime, m, ctx, builder) is cond_bit:
                            hit_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "any.hit")
                            next_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "any.next")
                            _ = LLVMBuildCondBr(builder, cond_bit, hit_block, next_block)
                            LLVMPositionBuilderAtEnd(builder, hit_block)
                            _ = LLVMBuildStore(builder, LLVMConstInt(bool_ty, 1, 0), result_slot)
                            _ = LLVMBuildBr(builder, done_block)
                            LLVMPositionBuilderAtEnd(builder, next_block)
                        else:
                            declined <- true
                    else:
                        declined <- true
                null return if declined
                _ = LLVMBuildBr(builder, done_block)
                LLVMPositionBuilderAtEnd(builder, done_block)
                return LLVMBuildLoad2(builder, bool_ty, result_slot, "any.load")
            return null


        def emit_comprehension(comprehension_var: sview, iterable: Expr, condition: Expr, body: Expr, expected: ValueType, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            # A container comprehension whose `expected` is a struct is either a DICT
            # comprehension (`{k: v for …}`, a DynDict — the pair rides in `body` as a Tuple) or a
            # SET comprehension (`{x for …}`, a DynSet — `body` is the element). Route by base;
            # both are dispatched before the darray path.
            if expected.kind == TypeKind.Struct:
                comp_struct_base: mutable sview = ""
                comp_struct_arg_start: mutable usize = 0
                comp_struct_arg_count: mutable usize = 0
                comp_struct_has: bool = generic_struct_instantiation_of(structs, expected, comp_struct_base, comp_struct_arg_start, comp_struct_arg_count)
                null return if not comp_struct_has
                if comp_struct_base == "DynSet":
                    return emit_set_comprehension(comprehension_var, iterable, condition, body, expected, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                return emit_dict_comprehension(comprehension_var, iterable, condition, body, expected, local_scope, fns, structs, generics, runtime, m, ctx, builder)
            # Quantifier `any|all VAR in ITER where COND` — Comprehension with empty body,
            # expected bool. Stage0 lowers to a loop that short-circuits. Without an any/all
            # marker on the node we treat these as `any` (self-host lexer uses `any` heavily;
            # `all` is rarer and can be refined later via annotation).
            if expected.kind == TypeKind.Bool and body is Expr.Absent:
                return emit_any_quantifier(comprehension_var, iterable, condition, local_scope, fns, structs, generics, runtime, m, ctx, builder)
            null return if expected.kind != TypeKind.DArray
            # A quantifier (`any`/`all`) has no body; only the collection form is modeled.
            null return if body is Expr.Absent
            if condition is Expr.BoolLit(filter_value):
                if not filter_value:
                    return LLVMConstNull(darray_llvm_type(structs, ctx))
            int64_type: LLVMTypeRef = LLVMInt64TypeInContext(ctx)
            element_type: ValueType = darray_element_of(expected, structs)
            null return if element_type.kind == TypeKind.Unmodeled

            # Only an integer RANGE iterable is modeled: its length is known before the loop,
            # which is what makes the presize possible at all.
            if iterable is Expr.Binary(range_low, range_operator, range_high, range_line):
                null return if range_operator != TokenKind.RangeLt and range_operator != TokenKind.RangeLe
                inclusive: bool = range_operator == TokenKind.RangeLe
                index_type: ValueType = ValueType{kind: TypeKind.Signed, bits: 64}
                if emit_expression(range_low, index_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is low_value:
                    if emit_expression(range_high, index_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is high_value:
                        span: LLVMValueRef = LLVMBuildSub(builder, high_value, low_value, "comp.span")
                        count: mutable LLVMValueRef = span
                        count <- LLVMBuildAdd(builder, span, LLVMConstInt(int64_type, 1, 0), "comp.count") if inclusive
                        # An empty or reversed range yields an empty darray, not a negative
                        # allocation.
                        positive: LLVMValueRef = LLVMBuildICmp(builder, 38, count, LLVMConstInt(int64_type, 0, 0), "comp.count.pos")
                        count <- LLVMBuildSelect(builder, positive, count, LLVMConstInt(int64_type, 0, 0), "comp.count.clamped")

                        header: LLVMTypeRef = darray_llvm_type(structs, ctx)
                        result_slot: LLVMValueRef = LLVMBuildAlloca(builder, header, "list.comp.result")
                        _ = LLVMBuildStore(builder, LLVMConstNull(header), result_slot)
                        stride: LLVMValueRef = element_stride(element_type, structs, ctx)
                        bytes: LLVMValueRef = LLVMBuildMul(builder, count, stride, "comp.bytes")
                        alloc_args: mutable darray[LLVMValueRef] = [runtime.arena, bytes]
                        alloc_pointer: void& = (&alloc_args[0]).cast[void&] can Unsafe.PointerCast
                        items: LLVMValueRef = LLVMBuildCall2(builder, runtime.arena_alloc_type, runtime.arena_alloc, alloc_pointer, 2, "comp.alloc")
                        items_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, header, result_slot, 0, "comp.items.ptr")
                        count_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, header, result_slot, 1, "comp.count.ptr")
                        capacity_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, header, result_slot, 2, "comp.cap.ptr")
                        _ = LLVMBuildStore(builder, items, items_pointer)
                        # Capacity is the range bound; count is the number of values that
                        # actually pass a dynamic filter and starts at zero.
                        filtered: mutable bool = true
                        if condition is Expr.Absent:
                            filtered <- false
                        elif condition is Expr.BoolLit:
                            filtered <- false
                        if filtered:
                            _ = LLVMBuildStore(builder, LLVMConstInt(int64_type, 0, 0), count_pointer)
                        else:
                            _ = LLVMBuildStore(builder, count, count_pointer)
                        output_index_slot: LLVMValueRef = LLVMBuildAlloca(builder, int64_type, "comp.out.i")
                        _ = LLVMBuildStore(builder, LLVMConstInt(int64_type, 0, 0), output_index_slot)

                        function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                        index_slot: LLVMValueRef = LLVMBuildAlloca(builder, int64_type, "comp.i")
                        _ = LLVMBuildStore(builder, LLVMConstInt(int64_type, 0, 0), index_slot)
                        var_slot: LLVMValueRef = LLVMBuildAlloca(builder, llvm_type_of(index_type, structs, ctx), "comp.var")
                        declare_local(local_scope, comprehension_var, var_slot, index_type)

                        condition_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "comp.cond")
                        body_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "comp.input")
                        write_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "comp.write")
                        skip_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "comp.skip")
                        latch_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "comp.latch")
                        done_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "comp.done")
                        _ = LLVMBuildBr(builder, condition_block)
                        LLVMPositionBuilderAtEnd(builder, condition_block)
                        current: LLVMValueRef = LLVMBuildLoad2(builder, int64_type, index_slot, "comp.i.cur")
                        more: LLVMValueRef = LLVMBuildICmp(builder, 40, current, count, "comp.more")
                        _ = LLVMBuildCondBr(builder, more, body_block, done_block)

                        LLVMPositionBuilderAtEnd(builder, body_block)
                        _ = LLVMBuildStore(builder, LLVMBuildAdd(builder, low_value, current, "comp.var.value"), var_slot)
                        if filtered:
                            if emit_condition(condition, local_scope, fns, structs, generics, runtime, m, ctx, builder) is predicate:
                                _ = LLVMBuildCondBr(builder, predicate, write_block, skip_block)
                            else:
                                LLVMPositionBuilderAtEnd(builder, done_block)
                                return null
                            LLVMPositionBuilderAtEnd(builder, write_block)
                        if emit_expression(body, element_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is element_value:
                            loaded_items: LLVMValueRef = LLVMBuildLoad2(builder, LLVMPointerTypeInContext(ctx, 0), items_pointer, "comp.items")
                            # A darray indexes with a ONE-index GEP: `items` is already a T*.
                            output_index: LLVMValueRef = LLVMBuildLoad2(builder, int64_type, output_index_slot, "comp.out.i.cur") if filtered else current
                            comp_indices: mutable darray[LLVMValueRef] = [output_index]
                            comp_indices_pointer: void& = (&comp_indices[0]).cast[void&] can Unsafe.PointerCast
                            slot_pointer: LLVMValueRef = LLVMBuildGEP2(builder, llvm_type_of(element_type, structs, ctx), loaded_items, comp_indices_pointer, 1, "comp.slot")
                            _ = LLVMBuildStore(builder, element_value, slot_pointer)
                            if filtered:
                                _ = LLVMBuildStore(builder, LLVMBuildAdd(builder, output_index, LLVMConstInt(int64_type, 1, 0), "comp.out.i.next"), output_index_slot)
                                _ = LLVMBuildStore(builder, LLVMBuildAdd(builder, output_index, LLVMConstInt(int64_type, 1, 0), "comp.count.next"), count_pointer)
                            _ = LLVMBuildStore(builder, LLVMBuildAdd(builder, current, LLVMConstInt(int64_type, 1, 0), "comp.i.next"), index_slot)
                            # The LATCH is what carries the marker: this branch is the loop's
                            # back-edge, and `!llvm.loop` belongs on it.
                            _ = LLVMBuildBr(builder, latch_block)
                            LLVMPositionBuilderAtEnd(builder, skip_block)
                            _ = LLVMBuildStore(builder, LLVMBuildAdd(builder, current, LLVMConstInt(int64_type, 1, 0), "comp.i.skip"), index_slot)
                            _ = LLVMBuildBr(builder, latch_block)
                            LLVMPositionBuilderAtEnd(builder, latch_block)
                            latch: LLVMValueRef = LLVMBuildBr(builder, condition_block)
                            tag_autovec_loop(latch, "comprehension", ctx)
                            if not filtered:
                                LLVMPositionBuilderAtEnd(builder, write_block)
                                _ = LLVMBuildUnreachable(builder)
                                LLVMPositionBuilderAtEnd(builder, skip_block)
                                _ = LLVMBuildUnreachable(builder)
                            LLVMPositionBuilderAtEnd(builder, done_block)
                            return LLVMBuildLoad2(builder, header, result_slot, "list.comp.value")
                        LLVMPositionBuilderAtEnd(builder, done_block)
                        return null
            # `[BODY for VAR in XS (if COND)?]` over an existing DARRAY source (the most common
            # comprehension form; the range path above needs a compile-time count and cannot take
            # one). The source count is dynamic, so this builds the output by PUSH — behaviourally
            # identical, exit-code-verified; it forgoes the range path's presize/vectorize, which
            # a dynamic-length source could not use anyway.
            lc_source_type: ValueType = darray_type_behind_expr(iterable, local_scope, structs)
            if lc_source_type.kind == TypeKind.DArray:
                if darray_address_of_expr(iterable, local_scope, fns, structs, generics, runtime, m, ctx, builder) is lc_source_slot:
                    lc_source_elem: ValueType = darray_element_of(lc_source_type, structs)
                    null return if lc_source_elem.kind == TypeKind.Unmodeled
                    lc_i64: LLVMTypeRef = LLVMInt64TypeInContext(ctx)
                    lc_header: LLVMTypeRef = darray_llvm_type(structs, ctx)
                    lc_out_slot: LLVMValueRef = LLVMBuildAlloca(builder, lc_header, "list.comp.d.out")
                    _ = LLVMBuildStore(builder, LLVMConstNull(lc_header), lc_out_slot)
                    lc_count_ptr: LLVMValueRef = LLVMBuildStructGEP2(builder, lc_header, lc_source_slot, 1, "list.comp.d.cnt.ptr")
                    lc_count: LLVMValueRef = LLVMBuildLoad2(builder, lc_i64, lc_count_ptr, "list.comp.d.cnt")
                    lc_index_slot: LLVMValueRef = LLVMBuildAlloca(builder, lc_i64, "list.comp.d.i")
                    _ = LLVMBuildStore(builder, LLVMConstInt(lc_i64, 0, 0), lc_index_slot)
                    lc_var_slot: LLVMValueRef = LLVMBuildAlloca(builder, llvm_type_of(lc_source_elem, structs, ctx), "list.comp.d.var")
                    declare_local(local_scope, comprehension_var, lc_var_slot, lc_source_elem)
                    lc_filtered: mutable bool = true
                    if condition is Expr.Absent:
                        lc_filtered <- false
                    elif condition is Expr.BoolLit:
                        lc_filtered <- false
                    # A constant-false filter yields the empty darray.
                    if condition is Expr.BoolLit(lc_filter_value):
                        if not lc_filter_value:
                            return LLVMBuildLoad2(builder, lc_header, lc_out_slot, "list.comp.d.empty")
                    lc_function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                    lc_cond: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, lc_function, "list.comp.d.cond")
                    lc_bodyb: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, lc_function, "list.comp.d.body")
                    lc_push_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, lc_function, "list.comp.d.push")
                    lc_step: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, lc_function, "list.comp.d.step")
                    lc_done: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, lc_function, "list.comp.d.done")
                    _ = LLVMBuildBr(builder, lc_cond)
                    LLVMPositionBuilderAtEnd(builder, lc_cond)
                    lc_cur: LLVMValueRef = LLVMBuildLoad2(builder, lc_i64, lc_index_slot, "list.comp.d.cur")
                    lc_more: LLVMValueRef = LLVMBuildICmp(builder, 40, lc_cur, lc_count, "list.comp.d.more")
                    _ = LLVMBuildCondBr(builder, lc_more, lc_bodyb, lc_done)
                    LLVMPositionBuilderAtEnd(builder, lc_bodyb)
                    # Bind VAR = source[cur]: load the source's items pointer (header field 0) and
                    # GEP by the current counter at the element stride — the same shape the darray
                    # for-loop uses to walk its backing.
                    if true:
                        lc_items_ptr: LLVMValueRef = LLVMBuildStructGEP2(builder, lc_header, lc_source_slot, 0, "list.comp.d.items.ptr")
                        lc_items: LLVMValueRef = LLVMBuildLoad2(builder, LLVMPointerTypeInContext(ctx, 0), lc_items_ptr, "list.comp.d.items")
                        lc_elem_llvm: LLVMTypeRef = llvm_type_of(lc_source_elem, structs, ctx)
                        lc_gep_indices: mutable darray[LLVMValueRef] = [lc_cur]
                        lc_gep_pointer: void& = (&lc_gep_indices[0]).cast[void&] can Unsafe.PointerCast
                        lc_elem_ptr: LLVMValueRef = LLVMBuildGEP2(builder, lc_elem_llvm, lc_items, lc_gep_pointer, 1, "list.comp.d.elem.ptr")
                        lc_elem_value: LLVMValueRef = LLVMBuildLoad2(builder, lc_elem_llvm, lc_elem_ptr, "list.comp.d.elem")
                        _ = LLVMBuildStore(builder, lc_elem_value, lc_var_slot)
                        lc_body_ok: mutable bool = true
                        if lc_filtered:
                            if emit_condition(condition, local_scope, fns, structs, generics, runtime, m, ctx, builder) is lc_pred:
                                _ = LLVMBuildCondBr(builder, lc_pred, lc_push_block, lc_step)
                            else:
                                lc_body_ok <- false
                        else:
                            _ = LLVMBuildBr(builder, lc_push_block)
                        null return if not lc_body_ok
                        LLVMPositionBuilderAtEnd(builder, lc_push_block)
                        if emit_darray_push(lc_out_slot, expected, body, local_scope, fns, structs, generics, runtime, m, ctx, builder):
                            _ = LLVMBuildBr(builder, lc_step)
                            LLVMPositionBuilderAtEnd(builder, lc_step)
                            _ = LLVMBuildStore(builder, LLVMBuildAdd(builder, lc_cur, LLVMConstInt(lc_i64, 1, 0), "list.comp.d.next"), lc_index_slot)
                            _ = LLVMBuildBr(builder, lc_cond)
                            LLVMPositionBuilderAtEnd(builder, lc_done)
                            return LLVMBuildLoad2(builder, lc_header, lc_out_slot, "list.comp.d.value")
                        return null
                    return null
            return null


        # `{k: v for VAR in LOW..<HIGH (where COND)?}` — a DICT comprehension. Unlike the darray
        # comprehension there is no presize/vectorize: a dict is built the way stage0 lowers it,
        # a zeroed DynDict plus one `arena_dict_put_or_panic(arena, &d, key, value)` per iteration
        # that passes the optional filter. `expected` is the DynDict[K, V] struct; the key/value
        # pair rides in `body` as a two-element Tuple. Only an integer-range iterable is modeled.
        def emit_dict_comprehension(comprehension_var: sview, iterable: Expr, condition: Expr, body: Expr, expected: ValueType, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            dc_base: mutable sview = ""
            dc_arg_start: mutable usize = 0
            dc_arg_count: mutable usize = 0
            dc_has: bool = generic_struct_instantiation_of(structs, expected, dc_base, dc_arg_start, dc_arg_count)
            null return if not dc_has or dc_base != "DynDict" or dc_arg_count != 2
            null return if body is Expr.Absent
            # The key/value pair rides in `body` as a two-element Tuple.
            dc_key_expr: mutable Expr = Expr.Absent
            dc_value_expr: mutable Expr = Expr.Absent
            dc_pair_ok: mutable bool = false
            if body is Expr.Tuple(dc_pair_read, dc_pair_read_line):
                if dc_pair_read.count == 2:
                    dc_key_expr <- dc_pair_read[0]
                    dc_value_expr <- dc_pair_read[1]
                    dc_pair_ok <- true
            null return if not dc_pair_ok
            dc_key_type: ValueType = copied_type(structs.generic_struct_inst_args[dc_arg_start])
            dc_value_type: ValueType = copied_type(structs.generic_struct_inst_args[dc_arg_start + 1.usize()])
            # A constant-false filter yields the empty dict; a constant-true or absent filter
            # runs every iteration; a dynamic filter branches per element.
            if condition is Expr.BoolLit(dc_filter_value):
                if not dc_filter_value:
                    return LLVMConstNull(llvm_type_of(expected, structs, ctx))
            # `{k: v for VAR in XS (if COND)?}` over an existing DARRAY source: walk the backing,
            # bind VAR = source[i], put each key/value that passes the filter. Handled before the
            # integer-range path below; leaves that path untouched.
            dc_src_type: ValueType = darray_type_behind_expr(iterable, local_scope, structs)
            if dc_src_type.kind == TypeKind.DArray:
                if darray_address_of_expr(iterable, local_scope, fns, structs, generics, runtime, m, ctx, builder) is dc_src_slot:
                    dc_src_elem: ValueType = darray_element_of(dc_src_type, structs)
                    null return if dc_src_elem.kind == TypeKind.Unmodeled
                    dc_dtype_args: mutable darray[ValueType] = [dc_key_type, dc_value_type]
                    if instantiate_generic("arena_dict_put_or_panic", dc_dtype_args, generics, structs, m, ctx) is dc_dput:
                        dc_di64: LLVMTypeRef = LLVMInt64TypeInContext(ctx)
                        dc_dheader: LLVMTypeRef = darray_llvm_type(structs, ctx)
                        dc_delem_llvm: LLVMTypeRef = llvm_type_of(dc_src_elem, structs, ctx)
                        dc_dllvm: LLVMTypeRef = llvm_type_of(expected, structs, ctx)
                        dc_dput_fn_type: LLVMTypeRef = LLVMGlobalGetValueType(dc_dput)
                        dc_dslot: LLVMValueRef = LLVMBuildAlloca(builder, dc_dllvm, "dict.comp.d")
                        _ = LLVMBuildStore(builder, LLVMConstNull(dc_dllvm), dc_dslot)
                        dc_dcount_ptr: LLVMValueRef = LLVMBuildStructGEP2(builder, dc_dheader, dc_src_slot, 1, "dict.comp.d.cnt.ptr")
                        dc_dcount: LLVMValueRef = LLVMBuildLoad2(builder, dc_di64, dc_dcount_ptr, "dict.comp.d.cnt")
                        dc_ditems_ptr: LLVMValueRef = LLVMBuildStructGEP2(builder, dc_dheader, dc_src_slot, 0, "dict.comp.d.items.ptr")
                        dc_ditems: LLVMValueRef = LLVMBuildLoad2(builder, LLVMPointerTypeInContext(ctx, 0), dc_ditems_ptr, "dict.comp.d.items")
                        dc_didx_slot: LLVMValueRef = LLVMBuildAlloca(builder, dc_di64, "dict.comp.d.i")
                        _ = LLVMBuildStore(builder, LLVMConstInt(dc_di64, 0, 0), dc_didx_slot)
                        dc_dvar_slot: LLVMValueRef = LLVMBuildAlloca(builder, dc_delem_llvm, "dict.comp.d.var")
                        declare_local(local_scope, comprehension_var, dc_dvar_slot, dc_src_elem)
                        dc_dfiltered: mutable bool = true
                        if condition is Expr.Absent:
                            dc_dfiltered <- false
                        elif condition is Expr.BoolLit:
                            dc_dfiltered <- false
                        dc_dfunction: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                        dc_dcond: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, dc_dfunction, "dict.comp.d.cond")
                        dc_dbody: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, dc_dfunction, "dict.comp.d.body")
                        dc_dput_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, dc_dfunction, "dict.comp.d.put")
                        dc_dstep: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, dc_dfunction, "dict.comp.d.step")
                        dc_ddone: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, dc_dfunction, "dict.comp.d.done")
                        _ = LLVMBuildBr(builder, dc_dcond)
                        LLVMPositionBuilderAtEnd(builder, dc_dcond)
                        dc_dcur: LLVMValueRef = LLVMBuildLoad2(builder, dc_di64, dc_didx_slot, "dict.comp.d.cur")
                        dc_dmore: LLVMValueRef = LLVMBuildICmp(builder, 40, dc_dcur, dc_dcount, "dict.comp.d.more")
                        _ = LLVMBuildCondBr(builder, dc_dmore, dc_dbody, dc_ddone)
                        LLVMPositionBuilderAtEnd(builder, dc_dbody)
                        dc_dgep_indices: mutable darray[LLVMValueRef] = [dc_dcur]
                        dc_dgep_pointer: void& = (&dc_dgep_indices[0]).cast[void&] can Unsafe.PointerCast
                        dc_delem_ptr: LLVMValueRef = LLVMBuildGEP2(builder, dc_delem_llvm, dc_ditems, dc_dgep_pointer, 1, "dict.comp.d.elem.ptr")
                        _ = LLVMBuildStore(builder, LLVMBuildLoad2(builder, dc_delem_llvm, dc_delem_ptr, "dict.comp.d.elem"), dc_dvar_slot)
                        dc_dbody_ok: mutable bool = true
                        if dc_dfiltered:
                            if emit_condition(condition, local_scope, fns, structs, generics, runtime, m, ctx, builder) is dc_dpred:
                                _ = LLVMBuildCondBr(builder, dc_dpred, dc_dput_block, dc_dstep)
                            else:
                                dc_dbody_ok <- false
                        else:
                            _ = LLVMBuildBr(builder, dc_dput_block)
                        null return if not dc_dbody_ok
                        LLVMPositionBuilderAtEnd(builder, dc_dput_block)
                        if emit_expression(dc_key_expr, dc_key_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is dc_dkv:
                            if emit_expression(dc_value_expr, dc_value_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is dc_dvv:
                                dc_dput_args: mutable darray[LLVMValueRef] = [runtime.arena, dc_dslot, dc_dkv, dc_dvv]
                                dc_dput_args_pointer: void& = (&dc_dput_args[0]).cast[void&] can Unsafe.PointerCast
                                _ = LLVMBuildCall2(builder, dc_dput_fn_type, dc_dput, dc_dput_args_pointer, 4, "dict.comp.d.put.call")
                                _ = LLVMBuildBr(builder, dc_dstep)
                                LLVMPositionBuilderAtEnd(builder, dc_dstep)
                                _ = LLVMBuildStore(builder, LLVMBuildAdd(builder, dc_dcur, LLVMConstInt(dc_di64, 1, 0), "dict.comp.d.next"), dc_didx_slot)
                                _ = LLVMBuildBr(builder, dc_dcond)
                                LLVMPositionBuilderAtEnd(builder, dc_ddone)
                                return LLVMBuildLoad2(builder, dc_dllvm, dc_dslot, "dict.comp.d.value")
                            return null
                        return null
                    return null
                return null
            # Only an integer-range iterable is modeled (its bounds are known before the loop).
            dc_low_expr: mutable Expr = Expr.Absent
            dc_high_expr: mutable Expr = Expr.Absent
            dc_inclusive: mutable bool = false
            dc_range_ok: mutable bool = false
            if iterable is Expr.Binary(dc_low_read, dc_op_read, dc_high_read, dc_range_read_line):
                if dc_op_read == TokenKind.RangeLt or dc_op_read == TokenKind.RangeLe:
                    dc_low_expr <- dc_low_read
                    dc_high_expr <- dc_high_read
                    dc_inclusive <- dc_op_read == TokenKind.RangeLe
                    dc_range_ok <- true
            null return if not dc_range_ok
            dc_type_args: mutable darray[ValueType] = [dc_key_type, dc_value_type]
            if instantiate_generic("arena_dict_put_or_panic", dc_type_args, generics, structs, m, ctx) is dc_put:
                dc_i64: LLVMTypeRef = LLVMInt64TypeInContext(ctx)
                dc_index_type: ValueType = ValueType{kind: TypeKind.Signed, bits: 64}
                if emit_expression(dc_low_expr, dc_index_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is dc_low_value:
                    if emit_expression(dc_high_expr, dc_index_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is dc_high_value:
                        dc_llvm: LLVMTypeRef = llvm_type_of(expected, structs, ctx)
                        dc_put_fn_type: LLVMTypeRef = LLVMGlobalGetValueType(dc_put)
                        dc_slot: LLVMValueRef = LLVMBuildAlloca(builder, dc_llvm, "dict.comp")
                        _ = LLVMBuildStore(builder, LLVMConstNull(dc_llvm), dc_slot)
                        # Upper bound as a `<` limit: an inclusive `..=` adds one.
                        dc_limit: mutable LLVMValueRef = dc_high_value
                        dc_limit <- LLVMBuildAdd(builder, dc_high_value, LLVMConstInt(dc_i64, 1, 0), "dict.comp.limit") if dc_inclusive
                        dc_index_slot: LLVMValueRef = LLVMBuildAlloca(builder, dc_i64, "dict.comp.i")
                        _ = LLVMBuildStore(builder, dc_low_value, dc_index_slot)
                        dc_var_slot: LLVMValueRef = LLVMBuildAlloca(builder, llvm_type_of(dc_index_type, structs, ctx), "dict.comp.var")
                        declare_local(local_scope, comprehension_var, dc_var_slot, dc_index_type)
                        dc_filtered: mutable bool = true
                        if condition is Expr.Absent:
                            dc_filtered <- false
                        elif condition is Expr.BoolLit:
                            dc_filtered <- false
                        dc_function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                        dc_cond: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, dc_function, "dict.comp.cond")
                        dc_bodyb: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, dc_function, "dict.comp.body")
                        dc_put_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, dc_function, "dict.comp.put")
                        dc_step: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, dc_function, "dict.comp.step")
                        dc_done: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, dc_function, "dict.comp.done")
                        _ = LLVMBuildBr(builder, dc_cond)
                        LLVMPositionBuilderAtEnd(builder, dc_cond)
                        dc_cur: LLVMValueRef = LLVMBuildLoad2(builder, dc_i64, dc_index_slot, "dict.comp.cur")
                        dc_more: LLVMValueRef = LLVMBuildICmp(builder, 40, dc_cur, dc_limit, "dict.comp.more")
                        _ = LLVMBuildCondBr(builder, dc_more, dc_bodyb, dc_done)
                        LLVMPositionBuilderAtEnd(builder, dc_bodyb)
                        _ = LLVMBuildStore(builder, dc_cur, dc_var_slot)
                        dc_body_ok: mutable bool = true
                        if dc_filtered:
                            if emit_condition(condition, local_scope, fns, structs, generics, runtime, m, ctx, builder) is dc_pred:
                                _ = LLVMBuildCondBr(builder, dc_pred, dc_put_block, dc_step)
                            else:
                                dc_body_ok <- false
                        else:
                            _ = LLVMBuildBr(builder, dc_put_block)
                        null return if not dc_body_ok
                        LLVMPositionBuilderAtEnd(builder, dc_put_block)
                        if emit_expression(dc_key_expr, dc_key_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is dc_kv:
                            if emit_expression(dc_value_expr, dc_value_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is dc_vv:
                                dc_put_args: mutable darray[LLVMValueRef] = [runtime.arena, dc_slot, dc_kv, dc_vv]
                                dc_put_args_pointer: void& = (&dc_put_args[0]).cast[void&] can Unsafe.PointerCast
                                _ = LLVMBuildCall2(builder, dc_put_fn_type, dc_put, dc_put_args_pointer, 4, "dict.comp.put.call")
                                _ = LLVMBuildBr(builder, dc_step)
                                LLVMPositionBuilderAtEnd(builder, dc_step)
                                _ = LLVMBuildStore(builder, LLVMBuildAdd(builder, dc_cur, LLVMConstInt(dc_i64, 1, 0), "dict.comp.next"), dc_index_slot)
                                _ = LLVMBuildBr(builder, dc_cond)
                                LLVMPositionBuilderAtEnd(builder, dc_done)
                                return LLVMBuildLoad2(builder, dc_llvm, dc_slot, "dict.comp.value")
                            return null
                        return null
                    return null
                return null
            return null


        # `{x for VAR in LOW..<HIGH (if COND)?}` — a SET comprehension. The single-column analogue
        # of the dict comprehension: a zeroed DynSet plus one `arena_set_add_or_panic(arena, &s,
        # elem)` per iteration that passes the optional filter. `expected` is the DynSet[T] struct;
        # `body` is the element expression. Only an integer-range iterable is modeled.
        def emit_set_comprehension(comprehension_var: sview, iterable: Expr, condition: Expr, body: Expr, expected: ValueType, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            sc_base: mutable sview = ""
            sc_arg_start: mutable usize = 0
            sc_arg_count: mutable usize = 0
            sc_has: bool = generic_struct_instantiation_of(structs, expected, sc_base, sc_arg_start, sc_arg_count)
            null return if not sc_has or sc_base != "DynSet" or sc_arg_count != 1
            null return if body is Expr.Absent
            sc_elem_type: ValueType = copied_type(structs.generic_struct_inst_args[sc_arg_start])
            # A constant-false filter yields the empty set; other filters loop.
            if condition is Expr.BoolLit(sc_filter_value):
                if not sc_filter_value:
                    return LLVMConstNull(llvm_type_of(expected, structs, ctx))
            # `{x for VAR in XS (if COND)?}` over an existing DARRAY source: walk the backing, add
            # each element that passes the filter. Handled before the range path; leaves it intact.
            sc_src_type: ValueType = darray_type_behind_expr(iterable, local_scope, structs)
            if sc_src_type.kind == TypeKind.DArray:
                if darray_address_of_expr(iterable, local_scope, fns, structs, generics, runtime, m, ctx, builder) is sc_src_slot:
                    sc_src_elem: ValueType = darray_element_of(sc_src_type, structs)
                    null return if sc_src_elem.kind == TypeKind.Unmodeled
                    sc_dtype_args: mutable darray[ValueType] = [sc_elem_type]
                    if instantiate_generic("arena_set_add_or_panic", sc_dtype_args, generics, structs, m, ctx) is sc_dadd:
                        sc_di64: LLVMTypeRef = LLVMInt64TypeInContext(ctx)
                        sc_dheader: LLVMTypeRef = darray_llvm_type(structs, ctx)
                        sc_delem_llvm: LLVMTypeRef = llvm_type_of(sc_src_elem, structs, ctx)
                        sc_dllvm: LLVMTypeRef = llvm_type_of(expected, structs, ctx)
                        sc_dadd_fn_type: LLVMTypeRef = LLVMGlobalGetValueType(sc_dadd)
                        sc_dslot: LLVMValueRef = LLVMBuildAlloca(builder, sc_dllvm, "set.comp.d")
                        _ = LLVMBuildStore(builder, LLVMConstNull(sc_dllvm), sc_dslot)
                        sc_dcount_ptr: LLVMValueRef = LLVMBuildStructGEP2(builder, sc_dheader, sc_src_slot, 1, "set.comp.d.cnt.ptr")
                        sc_dcount: LLVMValueRef = LLVMBuildLoad2(builder, sc_di64, sc_dcount_ptr, "set.comp.d.cnt")
                        sc_ditems_ptr: LLVMValueRef = LLVMBuildStructGEP2(builder, sc_dheader, sc_src_slot, 0, "set.comp.d.items.ptr")
                        sc_ditems: LLVMValueRef = LLVMBuildLoad2(builder, LLVMPointerTypeInContext(ctx, 0), sc_ditems_ptr, "set.comp.d.items")
                        sc_didx_slot: LLVMValueRef = LLVMBuildAlloca(builder, sc_di64, "set.comp.d.i")
                        _ = LLVMBuildStore(builder, LLVMConstInt(sc_di64, 0, 0), sc_didx_slot)
                        sc_dvar_slot: LLVMValueRef = LLVMBuildAlloca(builder, sc_delem_llvm, "set.comp.d.var")
                        declare_local(local_scope, comprehension_var, sc_dvar_slot, sc_src_elem)
                        sc_dfiltered: mutable bool = true
                        if condition is Expr.Absent:
                            sc_dfiltered <- false
                        elif condition is Expr.BoolLit:
                            sc_dfiltered <- false
                        sc_dfunction: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                        sc_dcond: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, sc_dfunction, "set.comp.d.cond")
                        sc_dbody: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, sc_dfunction, "set.comp.d.body")
                        sc_dadd_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, sc_dfunction, "set.comp.d.add")
                        sc_dstep: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, sc_dfunction, "set.comp.d.step")
                        sc_ddone: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, sc_dfunction, "set.comp.d.done")
                        _ = LLVMBuildBr(builder, sc_dcond)
                        LLVMPositionBuilderAtEnd(builder, sc_dcond)
                        sc_dcur: LLVMValueRef = LLVMBuildLoad2(builder, sc_di64, sc_didx_slot, "set.comp.d.cur")
                        sc_dmore: LLVMValueRef = LLVMBuildICmp(builder, 40, sc_dcur, sc_dcount, "set.comp.d.more")
                        _ = LLVMBuildCondBr(builder, sc_dmore, sc_dbody, sc_ddone)
                        LLVMPositionBuilderAtEnd(builder, sc_dbody)
                        sc_dgep_indices: mutable darray[LLVMValueRef] = [sc_dcur]
                        sc_dgep_pointer: void& = (&sc_dgep_indices[0]).cast[void&] can Unsafe.PointerCast
                        sc_delem_ptr: LLVMValueRef = LLVMBuildGEP2(builder, sc_delem_llvm, sc_ditems, sc_dgep_pointer, 1, "set.comp.d.elem.ptr")
                        _ = LLVMBuildStore(builder, LLVMBuildLoad2(builder, sc_delem_llvm, sc_delem_ptr, "set.comp.d.elem"), sc_dvar_slot)
                        sc_dbody_ok: mutable bool = true
                        if sc_dfiltered:
                            if emit_condition(condition, local_scope, fns, structs, generics, runtime, m, ctx, builder) is sc_dpred:
                                _ = LLVMBuildCondBr(builder, sc_dpred, sc_dadd_block, sc_dstep)
                            else:
                                sc_dbody_ok <- false
                        else:
                            _ = LLVMBuildBr(builder, sc_dadd_block)
                        null return if not sc_dbody_ok
                        LLVMPositionBuilderAtEnd(builder, sc_dadd_block)
                        if emit_expression(body, sc_elem_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is sc_delem_value:
                            sc_dadd_args: mutable darray[LLVMValueRef] = [runtime.arena, sc_dslot, sc_delem_value]
                            sc_dadd_args_pointer: void& = (&sc_dadd_args[0]).cast[void&] can Unsafe.PointerCast
                            _ = LLVMBuildCall2(builder, sc_dadd_fn_type, sc_dadd, sc_dadd_args_pointer, 3, "set.comp.d.add.call")
                            _ = LLVMBuildBr(builder, sc_dstep)
                            LLVMPositionBuilderAtEnd(builder, sc_dstep)
                            _ = LLVMBuildStore(builder, LLVMBuildAdd(builder, sc_dcur, LLVMConstInt(sc_di64, 1, 0), "set.comp.d.next"), sc_didx_slot)
                            _ = LLVMBuildBr(builder, sc_dcond)
                            LLVMPositionBuilderAtEnd(builder, sc_ddone)
                            return LLVMBuildLoad2(builder, sc_dllvm, sc_dslot, "set.comp.d.value")
                        return null
                    return null
                return null
            # Only an integer-range iterable is modeled.
            sc_low_expr: mutable Expr = Expr.Absent
            sc_high_expr: mutable Expr = Expr.Absent
            sc_inclusive: mutable bool = false
            sc_range_ok: mutable bool = false
            if iterable is Expr.Binary(sc_low_read, sc_op_read, sc_high_read, sc_range_read_line):
                if sc_op_read == TokenKind.RangeLt or sc_op_read == TokenKind.RangeLe:
                    sc_low_expr <- sc_low_read
                    sc_high_expr <- sc_high_read
                    sc_inclusive <- sc_op_read == TokenKind.RangeLe
                    sc_range_ok <- true
            null return if not sc_range_ok
            sc_type_args: mutable darray[ValueType] = [sc_elem_type]
            if instantiate_generic("arena_set_add_or_panic", sc_type_args, generics, structs, m, ctx) is sc_add:
                sc_i64: LLVMTypeRef = LLVMInt64TypeInContext(ctx)
                sc_index_type: ValueType = ValueType{kind: TypeKind.Signed, bits: 64}
                if emit_expression(sc_low_expr, sc_index_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is sc_low_value:
                    if emit_expression(sc_high_expr, sc_index_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is sc_high_value:
                        sc_llvm: LLVMTypeRef = llvm_type_of(expected, structs, ctx)
                        sc_add_fn_type: LLVMTypeRef = LLVMGlobalGetValueType(sc_add)
                        sc_slot: LLVMValueRef = LLVMBuildAlloca(builder, sc_llvm, "set.comp")
                        _ = LLVMBuildStore(builder, LLVMConstNull(sc_llvm), sc_slot)
                        sc_limit: mutable LLVMValueRef = sc_high_value
                        sc_limit <- LLVMBuildAdd(builder, sc_high_value, LLVMConstInt(sc_i64, 1, 0), "set.comp.limit") if sc_inclusive
                        sc_index_slot: LLVMValueRef = LLVMBuildAlloca(builder, sc_i64, "set.comp.i")
                        _ = LLVMBuildStore(builder, sc_low_value, sc_index_slot)
                        sc_var_slot: LLVMValueRef = LLVMBuildAlloca(builder, llvm_type_of(sc_index_type, structs, ctx), "set.comp.var")
                        declare_local(local_scope, comprehension_var, sc_var_slot, sc_index_type)
                        sc_filtered: mutable bool = true
                        if condition is Expr.Absent:
                            sc_filtered <- false
                        elif condition is Expr.BoolLit:
                            sc_filtered <- false
                        sc_function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                        sc_cond: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, sc_function, "set.comp.cond")
                        sc_bodyb: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, sc_function, "set.comp.body")
                        sc_add_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, sc_function, "set.comp.add")
                        sc_step: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, sc_function, "set.comp.step")
                        sc_done: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, sc_function, "set.comp.done")
                        _ = LLVMBuildBr(builder, sc_cond)
                        LLVMPositionBuilderAtEnd(builder, sc_cond)
                        sc_cur: LLVMValueRef = LLVMBuildLoad2(builder, sc_i64, sc_index_slot, "set.comp.cur")
                        sc_more: LLVMValueRef = LLVMBuildICmp(builder, 40, sc_cur, sc_limit, "set.comp.more")
                        _ = LLVMBuildCondBr(builder, sc_more, sc_bodyb, sc_done)
                        LLVMPositionBuilderAtEnd(builder, sc_bodyb)
                        _ = LLVMBuildStore(builder, sc_cur, sc_var_slot)
                        sc_body_ok: mutable bool = true
                        if sc_filtered:
                            if emit_condition(condition, local_scope, fns, structs, generics, runtime, m, ctx, builder) is sc_pred:
                                _ = LLVMBuildCondBr(builder, sc_pred, sc_add_block, sc_step)
                            else:
                                sc_body_ok <- false
                        else:
                            _ = LLVMBuildBr(builder, sc_add_block)
                        null return if not sc_body_ok
                        LLVMPositionBuilderAtEnd(builder, sc_add_block)
                        if emit_expression(body, sc_elem_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is sc_elem_value:
                            sc_add_args: mutable darray[LLVMValueRef] = [runtime.arena, sc_slot, sc_elem_value]
                            sc_add_args_pointer: void& = (&sc_add_args[0]).cast[void&] can Unsafe.PointerCast
                            _ = LLVMBuildCall2(builder, sc_add_fn_type, sc_add, sc_add_args_pointer, 3, "set.comp.add.call")
                            _ = LLVMBuildBr(builder, sc_step)
                            LLVMPositionBuilderAtEnd(builder, sc_step)
                            _ = LLVMBuildStore(builder, LLVMBuildAdd(builder, sc_cur, LLVMConstInt(sc_i64, 1, 0), "set.comp.next"), sc_index_slot)
                            _ = LLVMBuildBr(builder, sc_cond)
                            LLVMPositionBuilderAtEnd(builder, sc_done)
                            return LLVMBuildLoad2(builder, sc_llvm, sc_slot, "set.comp.value")
                        return null
                    return null
                return null
            return null


        def emit_darray_push(array_slot: LLVMValueRef, array_type: ValueType, value_expression: Expr, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            element_type: ValueType = darray_element_of(array_type, structs)
            false return if element_type.kind == TypeKind.Unmodeled
            int64_type: LLVMTypeRef = LLVMInt64TypeInContext(ctx)
            header: LLVMTypeRef = darray_llvm_type(structs, ctx)
            stride: LLVMValueRef = element_stride(element_type, structs, ctx)

            items_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, header, array_slot, 0, "darray.items.ptr")
            count_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, header, array_slot, 1, "darray.count.ptr")
            capacity_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, header, array_slot, 2, "darray.cap.ptr")

            count: LLVMValueRef = LLVMBuildLoad2(builder, int64_type, count_pointer, "push.count")
            needed: LLVMValueRef = LLVMBuildAdd(builder, count, LLVMConstInt(int64_type, 1, 0), "push.needed")
            capacity: LLVMValueRef = LLVMBuildLoad2(builder, int64_type, capacity_pointer, "push.cap")

            function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
            grow_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "push.grow")
            store_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "push.store")
            # 35 = UGE: capacities are unsigned.
            enough: LLVMValueRef = LLVMBuildICmp(builder, 35, capacity, needed, "push.cap.ok")
            _ = LLVMBuildCondBr(builder, enough, store_block, grow_block)

            LLVMPositionBuilderAtEnd(builder, grow_block)
            doubled: mutable LLVMValueRef = zeroed
            if emit_overflow_binary(capacity, LLVMConstInt(int64_type, 2, 0), true, m, ctx, builder) is doubled_result:
                doubled <- LLVMBuildSelect(builder, doubled_result.overflow, needed, doubled_result.value, "push.cap.double.safe")
            else:
                return false
            # 32 = EQ.
            is_empty: LLVMValueRef = LLVMBuildICmp(builder, 32, capacity, LLVMConstInt(int64_type, 0, 0), "push.cap.zero")
            base: LLVMValueRef = LLVMBuildSelect(builder, is_empty, LLVMConstInt(int64_type, 256, 0), doubled, "push.cap.base")
            # 36 = ULT.
            too_small: LLVMValueRef = LLVMBuildICmp(builder, 36, base, needed, "push.cap.lt")
            new_capacity: LLVMValueRef = LLVMBuildSelect(builder, too_small, needed, base, "push.cap.new")
            if emit_checked_reserve_binary(capacity, stride, true, m, ctx, builder) is push_old_bytes:
                if emit_checked_reserve_binary(new_capacity, stride, true, m, ctx, builder) is push_new_bytes:
                    old_bytes: LLVMValueRef = push_old_bytes
                    new_bytes: LLVMValueRef = push_new_bytes
                    old_items: LLVMValueRef = LLVMBuildLoad2(builder, LLVMPointerTypeInContext(ctx, 0), items_pointer, "push.items")
                    is_null: LLVMValueRef = LLVMBuildICmp(builder, 32, old_items, LLVMConstNull(LLVMPointerTypeInContext(ctx, 0)), "push.items.null")
                    alloc_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "push.alloc")
                    realloc_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "push.realloc")
                    grown_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "push.grown")
                    _ = LLVMBuildCondBr(builder, is_null, alloc_block, realloc_block)

                    LLVMPositionBuilderAtEnd(builder, alloc_block)
                    alloc_arguments: mutable darray[LLVMValueRef] = [runtime.arena, new_bytes]
                    alloc_pointer: void& = (&alloc_arguments[0]).cast[void&] can Unsafe.PointerCast
                    allocated: LLVMValueRef = LLVMBuildCall2(builder, runtime.arena_alloc_type, runtime.arena_alloc, alloc_pointer, 2, "push.alloc")
                    _ = LLVMBuildStore(builder, allocated, items_pointer)
                    _ = LLVMBuildBr(builder, grown_block)

                    LLVMPositionBuilderAtEnd(builder, realloc_block)
                    realloc_arguments: mutable darray[LLVMValueRef] = [runtime.arena, old_items, old_bytes, new_bytes]
                    realloc_pointer: void& = (&realloc_arguments[0]).cast[void&] can Unsafe.PointerCast
                    reallocated: LLVMValueRef = LLVMBuildCall2(builder, runtime.arena_realloc_type, runtime.arena_realloc, realloc_pointer, 4, "push.realloc")
                    _ = LLVMBuildStore(builder, reallocated, items_pointer)
                    _ = LLVMBuildBr(builder, grown_block)

                    LLVMPositionBuilderAtEnd(builder, grown_block)
                else:
                    return false
            else:
                return false
            _ = LLVMBuildStore(builder, new_capacity, capacity_pointer)
            _ = LLVMBuildBr(builder, store_block)

            LLVMPositionBuilderAtEnd(builder, store_block)
            if emit_expression(value_expression, element_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is pushed_value:
                items: LLVMValueRef = LLVMBuildLoad2(builder, LLVMPointerTypeInContext(ctx, 0), items_pointer, "push.items.cur")
                indices: mutable darray[LLVMValueRef] = [count]
                indices_pointer: void& = (&indices[0]).cast[void&] can Unsafe.PointerCast
                # ONE index: `items` is already a T*, not a pointer-to-array, so there is
                # no leading 0 to step over (unlike a fixed array's two-index GEP).
                slot: LLVMValueRef = LLVMBuildGEP2(builder, llvm_type_of(element_type, structs, ctx), items, indices_pointer, 1, "push.slot")
                _ = LLVMBuildStore(builder, pushed_value, slot)
                _ = LLVMBuildStore(builder, needed, count_pointer)
                return true
            return false


        # Emit a width-preserving LLVM overflow intrinsic for usize (i64 on the current
        # targets). The caller decides whether overflow traps or selects a fallback value.
        def emit_overflow_binary(left: LLVMValueRef, right: LLVMValueRef, multiply: bool, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> OverflowResult? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            intrinsic_name: sview = "llvm.umul.with.overflow" if multiply else "llvm.uadd.with.overflow"
            intrinsic_storage: mutable darray[u8] = []
            intrinsic_cstr: cstr = sview_to_cstr(intrinsic_name, intrinsic_storage)
            intrinsic_id: u32 = LLVMLookupIntrinsicID(intrinsic_cstr, sview_len(intrinsic_name))
            null return if intrinsic_id == 0
            int_type: LLVMTypeRef = LLVMInt64TypeInContext(ctx)
            parameter_types: mutable darray[LLVMTypeRef] = [int_type]
            parameter_pointer: void& = (&parameter_types[0]).cast[void&] can Unsafe.PointerCast
            intrinsic_fn: LLVMValueRef = LLVMGetIntrinsicDeclaration(m, intrinsic_id, parameter_pointer, 1)
            null return if intrinsic_fn == zeroed
            arguments: mutable darray[LLVMValueRef] = [left, right]
            arguments_pointer: void& = (&arguments[0]).cast[void&] can Unsafe.PointerCast
            call: LLVMValueRef = LLVMBuildCall2(builder, LLVMGlobalGetValueType(intrinsic_fn), intrinsic_fn, arguments_pointer, 2, "checked.binary")
            return OverflowResult{value: LLVMBuildExtractValue(builder, call, 0, "checked.value"), overflow: LLVMBuildExtractValue(builder, call, 1, "checked.overflow")}


        # Checked reserve-bound arithmetic traps on overflow, matching stage0's
        # `llvm.uadd/umul.with.overflow` lowering instead of allowing a wrapped byte count.
        def emit_checked_reserve_binary(left: LLVMValueRef, right: LLVMValueRef, multiply: bool, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            if emit_overflow_binary(left, right, multiply, m, ctx, builder) is result:
                function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                trap_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "reserve.overflow")
                continue_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "reserve.checked")
                _ = LLVMBuildCondBr(builder, result.overflow, trap_block, continue_block)
                LLVMPositionBuilderAtEnd(builder, trap_block)
                _ = LLVMBuildUnreachable(builder)
                LLVMPositionBuilderAtEnd(builder, continue_block)
                return result.value
            return null


        # Re-emit `+` and `*` trees used as reserve bounds through checked intrinsics.
        # Other expressions use the ordinary expression emitter unchanged.
        def emit_reserve_bound(expression: Expr, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            if expression is Expr.Paren(inner_expression, inner_line):
                return emit_reserve_bound(inner_expression, local_scope, fns, structs, generics, runtime, m, ctx, builder)
            if expression is Expr.Binary(bound_left, bound_operator, bound_right, bound_line):
                if bound_operator == TokenKind.Plus or bound_operator == TokenKind.Star:
                    if emit_reserve_bound(bound_left, local_scope, fns, structs, generics, runtime, m, ctx, builder) is left_value:
                        if emit_reserve_bound(bound_right, local_scope, fns, structs, generics, runtime, m, ctx, builder) is right_value:
                            return emit_checked_reserve_binary(left_value, right_value, bound_operator == TokenKind.Star, m, ctx, builder)
                        return null
                    return null
            return emit_expression(expression, ValueType{kind: TypeKind.Unsigned, bits: 64}, local_scope, fns, structs, generics, runtime, m, ctx, builder)


        # `xs.reserve(n)` — ensure capacity >= n WITHOUT changing count or storing any
        # element. The grow half of push (alloc-or-realloc to n*stride, then seal the new
        # capacity), guarded by the same `capacity UGE needed` skip. Unlike resize (which
        # push-fills zeros and so is scalar-only), reserve never materializes an element, so
        # it works for ANY element type — including a darray of structs (IndexMap.entries).
        def emit_darray_reserve(array_slot: LLVMValueRef, array_type: ValueType, needed: LLVMValueRef, structs: mutable StructTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            element_type: ValueType = darray_element_of(array_type, structs)
            false return if element_type.kind == TypeKind.Unmodeled
            int64_type: LLVMTypeRef = LLVMInt64TypeInContext(ctx)
            header: LLVMTypeRef = darray_llvm_type(structs, ctx)
            stride: LLVMValueRef = element_stride(element_type, structs, ctx)

            items_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, header, array_slot, 0, "reserve.items.ptr")
            capacity_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, header, array_slot, 2, "reserve.cap.ptr")
            capacity: LLVMValueRef = LLVMBuildLoad2(builder, int64_type, capacity_pointer, "reserve.cap")

            function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
            grow_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "reserve.grow")
            done_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "reserve.done")
            # 35 = UGE: already big enough → nothing to do.
            enough: LLVMValueRef = LLVMBuildICmp(builder, 35, capacity, needed, "reserve.cap.ok")
            _ = LLVMBuildCondBr(builder, enough, done_block, grow_block)

            LLVMPositionBuilderAtEnd(builder, grow_block)
            # Grow to exactly `needed` (>= old capacity here, so never shrinks the backing).
            if emit_checked_reserve_binary(capacity, stride, true, m, ctx, builder) is old_bytes_checked:
                if emit_checked_reserve_binary(needed, stride, true, m, ctx, builder) is new_bytes_checked:
                    old_bytes: LLVMValueRef = old_bytes_checked
                    new_bytes: LLVMValueRef = new_bytes_checked
                    old_items: LLVMValueRef = LLVMBuildLoad2(builder, LLVMPointerTypeInContext(ctx, 0), items_pointer, "reserve.items")
                    is_null: LLVMValueRef = LLVMBuildICmp(builder, 32, old_items, LLVMConstNull(LLVMPointerTypeInContext(ctx, 0)), "reserve.items.null")
                    alloc_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "reserve.alloc")
                    realloc_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "reserve.realloc")
                    _ = LLVMBuildCondBr(builder, is_null, alloc_block, realloc_block)

                    LLVMPositionBuilderAtEnd(builder, alloc_block)
                    alloc_arguments: mutable darray[LLVMValueRef] = [runtime.arena, new_bytes]
                    alloc_pointer: void& = (&alloc_arguments[0]).cast[void&] can Unsafe.PointerCast
                    allocated: LLVMValueRef = LLVMBuildCall2(builder, runtime.arena_alloc_type, runtime.arena_alloc, alloc_pointer, 2, "reserve.alloc")
                    _ = LLVMBuildStore(builder, allocated, items_pointer)
                    _ = LLVMBuildStore(builder, needed, capacity_pointer)
                    _ = LLVMBuildBr(builder, done_block)

                    LLVMPositionBuilderAtEnd(builder, realloc_block)
                    realloc_arguments: mutable darray[LLVMValueRef] = [runtime.arena, old_items, old_bytes, new_bytes]
                    realloc_pointer: void& = (&realloc_arguments[0]).cast[void&] can Unsafe.PointerCast
                    reallocated: LLVMValueRef = LLVMBuildCall2(builder, runtime.arena_realloc_type, runtime.arena_realloc, realloc_pointer, 4, "reserve.realloc")
                    _ = LLVMBuildStore(builder, reallocated, items_pointer)
                    _ = LLVMBuildStore(builder, needed, capacity_pointer)
                    _ = LLVMBuildBr(builder, done_block)

                    LLVMPositionBuilderAtEnd(builder, done_block)
                    return true
                return false
            return false


        # `_ = xs.reserve(n)` — reserve returns `mutable darray&` (for chaining), so it is
        # DISCARDED via `_ =` rather than appearing as a bare statement (unlike void `push`).
        # Both discard sites (`_` VarDecl and `_` Assign) route through emit_expression, which
        # does not model the darray growth method — intercept it here first. Returns 1 = handled
        # (Open), -1 = recognized-but-declined, 0 = not a darray reserve (fall through).
        def try_discarded_darray_reserve(value_expression: Expr, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            if value_expression is Expr.Call(dr_callee, dr_arguments, dr_argument_names, dr_call_line):
                if dr_callee is Expr.Field(dr_object, dr_method, dr_method_line):
                    if dr_method == "reserve" and dr_arguments.count == 1:
                        dr_type: ValueType = darray_type_behind_expr(dr_object, local_scope, structs)
                        if dr_type.kind == TypeKind.DArray:
                            if darray_address_of_expr(dr_object, local_scope, fns, structs, generics, runtime, m, ctx, builder) is dr_slot:
                                if emit_reserve_bound(dr_arguments[0], local_scope, fns, structs, generics, runtime, m, ctx, builder) is dr_n:
                                    if emit_darray_reserve(dr_slot, dr_type, dr_n, structs, runtime, m, ctx, builder):
                                        return 1
                            return -1
            return 0


        # The user-defined `struct Arena`, when the program declares one. The NAME `Arena`
        # always annotates as TypeKind.Arena (the runtime carrier -- `in` blocks and arena
        # threading key on it), but the std DEFINES the struct itself, with fields the
        # allocator walks (`a.begin`). The two are layout-identical by construction (the
        # backend's auto-region {ptr,ptr,i64,i64} IS the std's {begin,end,end_index,
        # strategy}), so FIELD ACCESS resolves through the declared struct while the type
        # stays Arena everywhere else. Without this, every std function touching an arena
        # field declined -- arena_used_slots was the observable casualty.
        def arena_user_struct(structs: mutable StructTable&) -> ValueType can[Abort.Panic]:
            for index in 0..<structs.names.count |structs|:
                ValueType{kind: TypeKind.Struct, bits: index.u32()} return if structs.names[index] == "Arena"
            return unmodeled_type()


        # The ADDRESS of a struct-typed local, and the struct's type.
        #
        # For a plain local that is its alloca. For a `P&` parameter the alloca holds a
        # POINTER, so the address is that pointer LOADED — one indirection more. Everything
        # downstream (field GEP, field store) is then identical, which is why field access
        # needs no ref-specific path of its own.
        def struct_address_of(name: sview, local_scope: mutable Scope&, structs: mutable StructTable&, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            declared: ValueType = lookup_type(local_scope, name)
            if lookup_slot(local_scope, name) is slot:
                slot return if declared.kind == TypeKind.Struct
                # A `view[T]` local IS its slot (it holds the DynArrayView value inline).
                slot return if declared.kind == TypeKind.View
                if declared.kind == TypeKind.Ref:
                    ref_addr_target: mutable ValueType = ref_target_of(declared, structs)
                    # `a.begin` where `a: mutable Arena&` -- field access through the arena
                    # CARRIER reads the user-declared `struct Arena` (see arena_user_struct).
                    ref_addr_target <- arena_user_struct(structs) if ref_addr_target.kind == TypeKind.Arena
                    null return if ref_addr_target.kind != TypeKind.Struct and ref_addr_target.kind != TypeKind.View
                    return LLVMBuildLoad2(builder, LLVMPointerTypeInContext(ctx, 0), slot, "ref.deref")
                # `cursor.count` where `cursor: heap Node&?` -- field access through an
                # UN-NARROWED optional heap ref. stage0 represents `heap T&?` as a bare ptr
                # and emits the load unconditionally (the null case is guarded by program
                # flow, e.g. `while cursor != null`), so stage1 matches by reading the
                # optional's ptr payload out of its `{i1, ptr}` slot. Heap refs only: a
                # plain `T&?` has no such stage0 precedent.
                if declared.kind == TypeKind.Optional:
                    opt_payload: ValueType = optional_payload_of(declared, structs)
                    if opt_payload.kind == TypeKind.Ref and ref_is_heap_ref(opt_payload, structs):
                        opt_addr_target: ValueType = ref_target_of(opt_payload, structs)
                        null return if opt_addr_target.kind != TypeKind.Struct
                        opt_llvm: LLVMTypeRef = llvm_type_of(declared, structs, ctx)
                        opt_value_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, opt_llvm, slot, 1, "opt.heap.ptr")
                        return LLVMBuildLoad2(builder, LLVMPointerTypeInContext(ctx, 0), opt_value_pointer, "opt.heap.deref")
            const_global_index: i64 = const_index_of(structs, name)
            if const_global_index >= 0 and structs.const_global_ok[const_global_index.usize()]:
                return structs.const_globals[const_global_index.usize()]
            mutable_global_index: i64 = mutable_global_index_of(structs, name)
            if mutable_global_index >= 0:
                return structs.mutable_global_handles[mutable_global_index.usize()]
            return null


        # The struct type behind a name, looking through one reference.
        def struct_type_of_name(name: sview, local_scope: mutable Scope&, structs: mutable StructTable&) -> ValueType can[Abort.Panic]:
            declared: ValueType = lookup_type(local_scope, name)
            declared return if declared.kind == TypeKind.Struct
            # A `view[T]` accesses fields (`dst.data`, `dst.len`) through its DynArrayView.
            view_struct_type(declared, structs) return if declared.kind == TypeKind.View
            view_struct_type(ref_target_of(declared, structs), structs) return if declared.kind == TypeKind.Ref and ref_target_of(declared, structs).kind == TypeKind.View
            # An optional HEAP ref looks through both wrappers (see struct_address_of).
            if declared.kind == TypeKind.Optional:
                opt_name_payload: ValueType = optional_payload_of(declared, structs)
                ref_target_of(opt_name_payload, structs) return if opt_name_payload.kind == TypeKind.Ref and ref_is_heap_ref(opt_name_payload, structs)
            behind_ref: ValueType = ref_target_of(declared, structs)
            # An arena CARRIER's fields read the user-declared `struct Arena`.
            arena_user_struct(structs) return if behind_ref.kind == TypeKind.Arena
            return behind_ref


        # The struct type of a field-access CHAIN (`o`, `o.i`, `o.i.j`, ...). Recurses so
        # nested field reads resolve their receiver's type, not just a bare Ident's.
        def struct_chain_type(object: Expr, local_scope: mutable Scope&, structs: mutable StructTable&) -> ValueType can[Abort.Panic]:
            if object is Expr.Ident(chain_name, chain_name_line):
                chain_local_type: ValueType = lookup_type(local_scope, chain_name)
                chain_local_type return if chain_local_type.kind != TypeKind.Unmodeled
                chain_const_index: i64 = const_index_of(structs, chain_name)
                copied_type(structs.const_types[chain_const_index.usize()]) return if chain_const_index >= 0 and structs.const_global_ok[chain_const_index.usize()]
                chain_mutable_index: i64 = mutable_global_index_of(structs, chain_name)
                copied_type(structs.mutable_global_types[chain_mutable_index.usize()]) return if chain_mutable_index >= 0
                return struct_type_of_name(chain_name, local_scope, structs)
            if object is Expr.Field(chain_inner, chain_field, chain_field_line):
                inner_type: mutable ValueType = struct_chain_type(chain_inner, local_scope, structs)
                # Member access auto-dereferences references just like expression_type.
                # This matters for p.field where p: T&: the chain resolver is used by
                # both field assignment and address formation, so rejecting the ref here
                # silently strips the whole function body and leaves only a declaration.
                inner_type <- ref_target_of(inner_type, structs) if inner_type.kind == TypeKind.Ref
                if inner_type.kind == TypeKind.Optional:
                    inner_payload: ValueType = optional_payload_of(inner_type, structs)
                    inner_type <- ref_target_of(inner_payload, structs) if inner_payload.kind == TypeKind.Ref and ref_is_heap_ref(inner_payload, structs)
                inner_type <- arena_user_struct(structs) if inner_type.kind == TypeKind.Arena
                unmodeled_type() return if inner_type.kind != TypeKind.Struct
                inner_slot: usize = inner_type.bits.usize()
                position: i64 = field_index_of(structs, inner_slot, chain_field)
                unmodeled_type() return if position < 0
                return copied_type(structs.field_types[structs.field_start[inner_slot] + position.usize()])
            # `a[i]` -> the container's element type. Enables `a[i].field`.
            if object is Expr.Index(indexed_container, index_expr, index_line):
                # A bare local is looked up directly; any OTHER receiver (a nested index
                # `m[i][j]`, a field chain `s.grid[i]`) resolves recursively.
                container_type: mutable ValueType = struct_chain_type(indexed_container, local_scope, structs)
                if indexed_container is Expr.Ident(container_name, container_name_line):
                    local_container_type: ValueType = lookup_type(local_scope, container_name)
                    container_type <- local_container_type if local_container_type.kind != TypeKind.Unmodeled
                    # A global const ARRAY (`const xs: i64[3]`) is not a local: take its type
                    # from the const table so `xs[i]` resolves its element type.
                    if local_container_type.kind == TypeKind.Unmodeled:
                        const_container_index: i64 = const_index_of(structs, container_name)
                        container_type <- copied_type(structs.const_types[const_container_index.usize()]) if const_container_index >= 0 and structs.const_global_ok[const_container_index.usize()]
                        mutable_container_index: i64 = mutable_global_index_of(structs, container_name)
                        container_type <- copied_type(structs.mutable_global_types[mutable_container_index.usize()]) if mutable_container_index >= 0
                darray_element_of(container_type, structs) return if container_type.kind == TypeKind.DArray
                array_element_of(container_type, structs) return if container_type.kind == TypeKind.Array
                # `items[i]` where `items: Struct&` — a C-style pointer base. The element is
                # the referent struct (the std indexes `DictBucket[K,T]&` this way).
                if container_type.kind == TypeKind.Ref:
                    ref_element: ValueType = ref_target_of(container_type, structs)
                    ref_element return if ref_element.kind == TypeKind.Struct
                    # `p[i]` where `p: T&` is a ref to a NUMERIC scalar (Slice's `p[i] <- v` assign
                    # target): the element IS that scalar, so the write fallback can type its value.
                    ref_element return if ref_element.kind == TypeKind.Signed or ref_element.kind == TypeKind.Unsigned or ref_element.kind == TypeKind.Float
                # `d.items[i]` where the field `items` is an OPTIONAL ref `T&?` used as a buffer
                # pointer (Deque). The element is the ref's referent — unwrap the optional first.
                if container_type.kind == TypeKind.Optional:
                    opt_ref_payload: ValueType = optional_payload_of(container_type, structs)
                    if opt_ref_payload.kind == TypeKind.Ref:
                        opt_ref_element: ValueType = ref_target_of(opt_ref_payload, structs)
                        opt_ref_element return if opt_ref_element.kind == TypeKind.Struct or opt_ref_element.kind == TypeKind.Signed or opt_ref_element.kind == TypeKind.Unsigned or opt_ref_element.kind == TypeKind.Float
            return unmodeled_type()


        # The ADDRESS of a field-access chain's struct value. A bare Ident is its slot; a
        # nested field GEPs into its receiver's address. This is what makes `o.i.v` work:
        # the receiver `o.i` is itself a Field, addressed recursively rather than requiring
        # an Ident.
        def struct_chain_address(object: Expr, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            if object is Expr.Ident(chain_name, chain_name_line):
                if struct_address_of(chain_name, local_scope, structs, ctx, builder) is base_address:
                    emit_pointer_deref_guard(base_address, runtime, m, ctx, builder)
                    return base_address
                return null
            if object is Expr.Field(chain_inner, chain_field, chain_field_line):
                inner_type: mutable ValueType = struct_chain_type(chain_inner, local_scope, structs)
                inner_type <- ref_target_of(inner_type, structs) if inner_type.kind == TypeKind.Ref
                if inner_type.kind == TypeKind.Optional:
                    inner_payload: ValueType = optional_payload_of(inner_type, structs)
                    inner_type <- ref_target_of(inner_payload, structs) if inner_payload.kind == TypeKind.Ref and ref_is_heap_ref(inner_payload, structs)
                inner_type <- arena_user_struct(structs) if inner_type.kind == TypeKind.Arena
                null return if inner_type.kind != TypeKind.Struct
                inner_slot: usize = inner_type.bits.usize()
                position: i64 = field_index_of(structs, inner_slot, chain_field)
                null return if position < 0
                if struct_chain_address(chain_inner, local_scope, fns, structs, generics, runtime, m, ctx, builder) is inner_address:
                    inner_llvm: LLVMTypeRef = llvm_type_of(inner_type, structs, ctx)
                    emit_pointer_deref_guard(inner_address, runtime, m, ctx, builder)
                    return LLVMBuildStructGEP2(builder, inner_llvm, inner_address, position.u32(), "field.chain.ptr")
                return null
            # `a[i]` -> the element's ADDRESS, so `a[i].field` reads/writes in place rather
            # than spilling a copy. darray and fixed array use their own index-address paths.
            if object is Expr.Index(indexed_container, index_expr, index_line):
                if indexed_container is Expr.Ident(container_name, container_name_line):
                    container_type: ValueType = lookup_type(local_scope, container_name)
                    # A BORROWED darray param (`da: darray[T]&`) indexed and address-taken
                    # (`&da[i]`, as in Slice's `slice(&da)` → `(&da[0]).cast[uintptr]`): the header
                    # address is loaded out of the parameter slot, then the element is GEP'd like
                    # any darray. Checked before the plain-local and ref-to-struct cases.
                    chain_borrowed_type: ValueType = darray_type_behind(local_scope, container_name, structs)
                    if chain_borrowed_type.kind == TypeKind.DArray and container_type.kind == TypeKind.Ref:
                        if darray_address_of(local_scope, container_name, structs, ctx, builder) is chain_borrowed_slot:
                            return emit_darray_index_address(chain_borrowed_slot, chain_borrowed_type, index_expr, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                        return null
                    if lookup_slot(local_scope, container_name) is container_slot:
                        if container_type.kind == TypeKind.DArray:
                            return emit_darray_index_address(container_slot, container_type, index_expr, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                        if container_type.kind == TypeKind.Array:
                            return emit_index_address(container_slot, container_type, index_expr, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                        # `p[i]` where `p: T&` is a ref used as a C-style pointer base: the slot
                        # holds a pointer to element 0; the element ADDRESS is a GEP by index at the
                        # element stride. Covers a STRUCT element (how the std walks DictBucket rows)
                        # AND a NUMERIC scalar (Slice's `&p[lo]` / `p[i] <- v`, where the assign
                        # target and address-of both resolve here).
                        if container_type.kind == TypeKind.Ref:
                            ref_element: ValueType = ref_target_of(container_type, structs)
                            if ref_element.kind == TypeKind.Struct or ref_element.kind == TypeKind.Signed or ref_element.kind == TypeKind.Unsigned or ref_element.kind == TypeKind.Float:
                                base_pointer: LLVMValueRef = LLVMBuildLoad2(builder, LLVMPointerTypeInContext(ctx, 0), container_slot, "ref.base")
                                if emit_expression(index_expr, ValueType{kind: TypeKind.Signed, bits: 64}, local_scope, fns, structs, generics, runtime, m, ctx, builder) is index_value:
                                    element_llvm: LLVMTypeRef = llvm_type_of(ref_element, structs, ctx)
                                    ref_indices: mutable darray[LLVMValueRef] = [index_value]
                                    ref_indices_pointer: void& = (&ref_indices[0]).cast[void&] can Unsafe.PointerCast
                                    return LLVMBuildGEP2(builder, element_llvm, base_pointer, ref_indices_pointer, 1, "ref.index.ptr")
                                return null
                    # `xs[i]` where `xs` is a global const ARRAY — the base "slot" is the
                    # `@xs` global itself, GEP'd exactly like a local fixed array.
                    const_array_index: i64 = const_index_of(structs, container_name)
                    if const_array_index >= 0 and structs.const_global_ok[const_array_index.usize()]:
                        const_array_type: ValueType = copied_type(structs.const_types[const_array_index.usize()])
                        return emit_index_address(structs.const_globals[const_array_index.usize()], const_array_type, index_expr, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                    mutable_array_index: i64 = mutable_global_index_of(structs, container_name)
                    if mutable_array_index >= 0:
                        mutable_array_type: ValueType = copied_type(structs.mutable_global_types[mutable_array_index.usize()])
                        return emit_index_address(structs.mutable_global_handles[mutable_array_index.usize()], mutable_array_type, index_expr, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                    return null
                # A NESTED index (`m[i][j]`): address the inner element recursively, then
                # index into it.
                inner_container_type: ValueType = struct_chain_type(indexed_container, local_scope, structs)
                if struct_chain_address(indexed_container, local_scope, fns, structs, generics, runtime, m, ctx, builder) is inner_container_address:
                    if inner_container_type.kind == TypeKind.DArray:
                        return emit_darray_index_address(inner_container_address, inner_container_type, index_expr, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                    if inner_container_type.kind == TypeKind.Array:
                        return emit_index_address(inner_container_address, inner_container_type, index_expr, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                    # `b.items[i]` where the FIELD `items` is a ref (`T&`) or optional-ref (`T&?`)
                    # used as a C-style buffer pointer — Deque's `d.items[phys]` (`items: T&?`). The
                    # field slot holds the ref (an optional is {i1, ptr}; take field 1). Load the raw
                    # pointer, then GEP by index at the element stride.
                    field_ref_payload: mutable ValueType = inner_container_type
                    field_ref_is_optional: bool = inner_container_type.kind == TypeKind.Optional
                    field_ref_payload <- optional_payload_of(inner_container_type, structs) if field_ref_is_optional
                    if field_ref_payload.kind == TypeKind.Ref:
                        field_ref_elem: ValueType = ref_target_of(field_ref_payload, structs)
                        null return if field_ref_elem.kind == TypeKind.Unmodeled
                        field_ref_raw: mutable LLVMValueRef = LLVMBuildLoad2(builder, LLVMPointerTypeInContext(ctx, 0), inner_container_address, "field.ref.ptr")
                        if field_ref_is_optional:
                            field_opt_llvm: LLVMTypeRef = llvm_type_of(inner_container_type, structs, ctx)
                            field_opt_value: LLVMValueRef = LLVMBuildLoad2(builder, field_opt_llvm, inner_container_address, "field.opt")
                            field_ref_raw <- LLVMBuildExtractValue(builder, field_opt_value, 1, "field.opt.ptr")
                        if emit_expression(index_expr, ValueType{kind: TypeKind.Unsigned, bits: 64}, local_scope, fns, structs, generics, runtime, m, ctx, builder) is field_ref_index:
                            field_ref_elem_llvm: LLVMTypeRef = llvm_type_of(field_ref_elem, structs, ctx)
                            field_ref_gep_indices: mutable darray[LLVMValueRef] = [field_ref_index]
                            field_ref_gep_pointer: void& = (&field_ref_gep_indices[0]).cast[void&] can Unsafe.PointerCast
                            return LLVMBuildGEP2(builder, field_ref_elem_llvm, field_ref_raw, field_ref_gep_pointer, 1, "field.ref.elem.ptr")
                        return null
                return null
            return null


        # Whether an expression threads its `expected` type down to sub-expressions rather
        # than producing a value directly. Such a form must NOT be implicitly wrapped: its
        # ARMS each wrap themselves, which is what makes `42 if flag else null` work.
        def propagates_expected(expression: Expr) -> bool can[Abort.Panic]:
            if expression is Expr.If(condition, then_expression, else_expression, line):
                return true
            if expression is Expr.Match(scrutinee, arms, match_line):
                return true
            if expression is Expr.Paren(inner, paren_line):
                return propagates_expected(inner)
            return false


        # Whether an expression is the `null` literal (an IDENT named "null" in the AST).
        def is_null_literal(expression: Expr) -> bool can[Abort.Panic]:
            if expression is Expr.Ident(name, line):
                return name == "null"
            return false


        # Wrap `value` (of type `payload`) into a `T?` — `{true, value}`.
        #
        # Built through a slot rather than insertvalue: the tag and payload are two plain
        # stores, and SROA collapses it at -O2 exactly the same. An Elisa expression of
        # payload type in an optional context is implicitly wrapped — the language has no
        # `some(x)`, so this is where that happens.
        # `force_null_test` — derive the tag from `value != null` even when the payload type
        # says the reference cannot be null. A REINTERPRET (`heapptr.cast[u8&?]`) is exactly
        # that case: the payload annotation is a plain `u8&`, but the value came from a raw
        # pointer that may well be null, and a constant `true` tag would hand the program a
        # null it believes is a real reference.
        def wrap_optional_tagged(value: LLVMValueRef, optional_type: ValueType, force_null_test: bool, structs: mutable StructTable&, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            optional_llvm: LLVMTypeRef = llvm_type_of(optional_type, structs, ctx)
            slot: LLVMValueRef = LLVMBuildAlloca(builder, optional_llvm, "opt")
            tag_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, optional_llvm, slot, 0, "opt.tag.ptr")
            # A HEAP pointer carries its own absence: null IS the empty case, which is how
            # stage0 represents `heap T&?` (a bare `ptr`, tested with `icmp ne ptr, null`).
            # Wrapping one with a hardcoded `true` tag would report a FAILED `malloc` as
            # present and hand the program a null it believes is real. An ordinary `T&` is
            # never null, so it keeps the constant tag.
            payload_type: ValueType = optional_payload_of(optional_type, structs)
            if force_null_test or (payload_type.kind == TypeKind.Ref and ref_is_heap_ref(payload_type, structs)):
                null_pointer: LLVMValueRef = LLVMConstNull(LLVMPointerTypeInContext(ctx, 0))
                _ = LLVMBuildStore(builder, LLVMBuildICmp(builder, 33, value, null_pointer, "opt.present"), tag_pointer)
            else:
                _ = LLVMBuildStore(builder, LLVMConstInt(LLVMInt1TypeInContext(ctx), 1, 0), tag_pointer)
            value_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, optional_llvm, slot, 1, "opt.value.ptr")
            _ = LLVMBuildStore(builder, value, value_pointer)
            return LLVMBuildLoad2(builder, optional_llvm, slot, "opt.wrapped")


        # The ordinary wrap: the payload TYPE decides whether the tag is a null test.
        def wrap_optional(value: LLVMValueRef, optional_type: ValueType, structs: mutable StructTable&, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            return wrap_optional_tagged(value, optional_type, false, structs, ctx, builder)


        # Catch a first-class value-carrying error union. Calls have a separate lowering
        # below because their ABI is split into an i32 status plus an out pointer; locals,
        # fields, and parameters already use the stage0 descriptor `{i32 code, ptr payload}`.
        def emit_catch_error_union_value(union_value: LLVMValueRef, value_type: ValueType, catch_arms: darray[MatchArm]&, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            null return if catch_arms.count < 1
            payload_type: ValueType = error_union_payload_of(value_type, structs)
            null return if payload_type.kind == TypeKind.Unmodeled
            union_code: LLVMValueRef = LLVMBuildExtractValue(builder, union_value, 0, "catch.union.code")
            function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
            value_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "catch.union.value")
            dispatch_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "catch.union.dispatch")
            done_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "catch.union.done")
            payload_llvm: LLVMTypeRef = llvm_type_of(payload_type, structs, ctx)
            result_slot: LLVMValueRef = LLVMBuildAlloca(builder, payload_llvm, "catch.union.result")
            ok: LLVMValueRef = LLVMBuildICmp(builder, 32, union_code, LLVMConstInt(LLVMInt32TypeInContext(ctx), 0, 0), "catch.union.ok")
            _ = LLVMBuildCondBr(builder, ok, value_block, dispatch_block)

            LLVMPositionBuilderAtEnd(builder, value_block)
            success_arm: MatchArm = catch_arms[0]
            null return if arm_has_guard(success_arm.guard)
            if success_arm.pattern is Pattern.Binding(success_name):
                success_payload_ptr: LLVMValueRef = LLVMBuildExtractValue(builder, union_value, 1, "catch.union.payload.ptr")
                declare_local(local_scope, success_name, success_payload_ptr, payload_type)
            if arm_value_expression(success_arm.body) is success_expression:
                if emit_expression(success_expression, payload_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is success_result:
                    _ = LLVMBuildStore(builder, success_result, result_slot)
                    _ = LLVMBuildBr(builder, done_block)
                else:
                    return null
            else:
                return null

            LLVMPositionBuilderAtEnd(builder, dispatch_block)
            error_arm_index: mutable usize = 1
            declined: mutable bool = false
            saw_catch_all: mutable bool = false
            while error_arm_index < catch_arms.count |error_arm_index, declined, saw_catch_all, catch_arms, union_code, payload_type, result_slot, done_block, function, local_scope, fns, structs, generics, runtime, m, ctx, builder|:
                error_arm: MatchArm = catch_arms[error_arm_index]
                error_arm_index <- error_arm_index + 1
                continue if declined or saw_catch_all
                if arm_has_guard(error_arm.guard):
                    declined <- true
                    continue
                if arm_value_expression(error_arm.body) is error_expression:
                    if error_arm.pattern is Pattern.Wildcard:
                        if emit_expression(error_expression, payload_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is wildcard_result:
                            _ = LLVMBuildStore(builder, wildcard_result, result_slot)
                            _ = LLVMBuildBr(builder, done_block)
                            saw_catch_all <- true
                        else:
                            declined <- true
                        continue
                    if error_arm.pattern is Pattern.TypeBind(error_type_name, error_binder):
                        if error_type_name != "error":
                            declined <- true
                            continue
                        if emit_expression(error_expression, payload_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is error_bind_result:
                            _ = LLVMBuildStore(builder, error_bind_result, result_slot)
                            _ = LLVMBuildBr(builder, done_block)
                            saw_catch_all <- true
                        else:
                            declined <- true
                        continue
                    if error_arm.pattern is Pattern.Variant(error_path, error_fields):
                        if error_fields.count != 0:
                            declined <- true
                            continue
                        ordinal: mutable i64 = penum_variant_index_of_path(error_path, structs)
                        if ordinal < 0:
                            ordinal <- ordinal_of_dotted_path(error_path, structs)
                        if ordinal < 0:
                            declined <- true
                            continue
                        arm_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "catch.union.arm")
                        next_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "catch.union.next")
                        hit: LLVMValueRef = LLVMBuildICmp(builder, 32, union_code, LLVMConstInt(LLVMInt32TypeInContext(ctx), (ordinal + 1).u64(), 0), "catch.union.cmp")
                        _ = LLVMBuildCondBr(builder, hit, arm_block, next_block)
                        LLVMPositionBuilderAtEnd(builder, arm_block)
                        if emit_expression(error_expression, payload_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is arm_result:
                            _ = LLVMBuildStore(builder, arm_result, result_slot)
                            _ = LLVMBuildBr(builder, done_block)
                        else:
                            declined <- true
                        LLVMPositionBuilderAtEnd(builder, next_block)
                        continue
                    declined <- true
                else:
                    declined <- true
            null return if declined
            if not saw_catch_all:
                _ = LLVMBuildUnreachable(builder)
            LLVMPositionBuilderAtEnd(builder, done_block)
            return LLVMBuildLoad2(builder, payload_llvm, result_slot, "catch.union.value")


        # Emit a value expression, producing a value of `resolve_type(expression, expected)`.
        # `null` = unmodeled; the caller must decline.
        def emit_expression(expression: Expr, expected: ValueType, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            # A lambda VALUE `fn(params) => body` in a `fn(…)` context — lift it to a closure.
            # (An empty-body Expr.Lambda is a fn-TYPE annotation, never emitted as a value.)
            if expected.kind == TypeKind.Fn and expression is Expr.Lambda(lambda_value_params, lambda_value_body, lambda_value_line):
                lambda_value_ok: bool = lambda_value_body.count > 0
                emit_lambda_value(lambda_value_params, lambda_value_body, expected, local_scope, fns, structs, generics, runtime, m, ctx, builder) return if lambda_value_ok
            # IMPLICIT WRAP: Elisa has no `some(x)` — an expression of payload type in an
            # optional context IS the optional. Handled before everything else so each
            # value form stays unaware of optionals: re-emit at the PAYLOAD type, then wrap.
            # `null` is excluded (it is the empty optional, not a payload).
            if expected.kind == TypeKind.Optional:
                payload_type: ValueType = optional_payload_of(expected, structs)
                # A value-`if` / `match` already threads `expected` DOWN to its arms, so
                # each arm wraps itself. Wrapping the whole form instead would push the
                # payload type into the arms and reject `42 if flag else null` — the `null`
                # arm is not an i64.
                if not is_null_literal(expression) and not propagates_expected(expression):
                    own: ValueType = expression_type(expression, local_scope, fns, structs, generics)
                    if own.kind != TypeKind.Optional:
                        if emit_expression(expression, payload_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is payload_value:
                            return wrap_optional(payload_value, expected, structs, ctx, builder)
                        return null
            if expression is Expr.CharLit(char_text):
                # stage0: char literals lower to i64 code units (e.g. '0' → 48).
                # Lexer token text is the INTERIOR only (`A`, not `'A'`); quoted form is
                # also accepted when a pattern/alias re-wraps the content.
                char_code: mutable i64 = 0
                if not parse_char_literal_code(char_text, char_code):
                    return null
                char_ty: ValueType = expected if is_integer_type(expected) else ValueType{kind: TypeKind.Signed, bits: 64}
                return LLVMConstInt(llvm_type_of(char_ty, structs, ctx), char_code.u64(), 1)
            if expression is Expr.IntLit(literal_value):
                # A literal takes the context's type. sign_extend=1 so a negative literal
                # fills correctly at any width.
                null return if not is_integer_type(expected)
                return LLVMConstInt(llvm_type_of(expected, structs, ctx), literal_value.u64(), 1)
            if expression is Expr.BoolLit(bool_value):
                bool_type: LLVMTypeRef = LLVMInt1TypeInContext(ctx)
                return LLVMConstInt(bool_type, 1, 0) if bool_value else LLVMConstInt(bool_type, 0, 0)
            # `1.5` — built from the SOURCE TEXT, so LLVM's own parser decides the exact
            # bits rather than the backend re-implementing decimal rounding.
            if expression is Expr.FloatLit(float_text):
                null return if expected.kind != TypeKind.Float
                text_storage: mutable darray[u8] = []
                return LLVMConstRealOfString(llvm_type_of(expected, structs, ctx), sview_to_cstr(float_text, text_storage))
            # An ident is a local read: load from its slot, at the slot's own type.
            # `null` is an IDENT named "null" in the AST, not its own node. It is the
            # empty optional: `{false, undef}` — the payload half is never read when the
            # tag is false, so a zeroed struct is the whole value.
            # `move x` — an ownership TRANSFER, which the backend emits as the value itself.
            # Verified against stage0's IR: `freeze(move store)` adds no runtime call and no
            # new instruction, just `%frozen = alloca %Node__Store` + a copy of the store
