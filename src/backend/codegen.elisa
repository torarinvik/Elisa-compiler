                    # Locals are already allocas, so `&local` IS the slot — exactly what
                    # stage0 emits (`call void @bump(ptr %x)`). No `&` operator is needed
                    # at the call site; the expected type drives it.
                    if expected.kind == TypeKind.Ref and ident_type.kind != TypeKind.Ref:
                        null return if ref_target_of(expected, structs).kind != ident_type.kind
                        return slot
                    return LLVMBuildLoad2(builder, llvm_type_of(ident_type, structs, ctx), slot, "load")
                return null
            if expression is Expr.Paren(paren_inner, paren_line):
                return emit_expression(paren_inner, expected, local_scope, fns, structs, generics, runtime, m, ctx, builder)
            if expression is Expr.Unary(unary_operator, unary_operand, unary_line):
                # `&lvalue` — the ADDRESS of a local, a field chain, or an indexed element,
                # yielded as a `T&` (a raw ptr in LLVM). A bare local IS its own slot; any
                # deeper place (`&b.value`, `&xs[i].field`) GEPs through struct_chain_address.
                if unary_operator == TokenKind.Ampersand:
                    if unary_operand is Expr.Ident(addr_name, addr_line):
                        if lookup_slot(local_scope, addr_name) is addr_slot:
                            return addr_slot
                        return null
                    return struct_chain_address(unary_operand, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                # `not x` needs a bool operand, not `expected` (which is itself bool).
                if unary_operator == TokenKind.Not or unary_operator == TokenKind.Bang:
                    bool_type_n: ValueType = ValueType{kind: TypeKind.Bool, bits: 1}
                    if emit_expression(unary_operand, bool_type_n, local_scope, fns, structs, generics, runtime, m, ctx, builder) is bool_operand:
                        # `not` on an i1 is XOR with 1.
                        return LLVMBuildXor(builder, bool_operand, LLVMConstInt(LLVMInt1TypeInContext(ctx), 1, 0), "not")
                    return null
                operand_type: ValueType = resolve_type(unary_operand, expected, local_scope, fns, structs, generics)
                null return if not is_numeric_type(operand_type)
                if emit_expression(unary_operand, operand_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is operand:
                    operand return if unary_operator == TokenKind.Plus
                    if unary_operator == TokenKind.Minus:
                        # `-x` on a float is fneg; `~x` has no float form.
                        return LLVMBuildFNeg(builder, operand, "fneg") if operand_type.kind == TypeKind.Float else LLVMBuildNeg(builder, operand, "neg")
                    if unary_operator == TokenKind.Tilde:
                        null return if operand_type.kind == TypeKind.Float
                        return LLVMBuildNot(builder, operand, "bnot")
                return null
            # `opt == null` / `opt != null` — a PRESENCE test against the optional's tag
            # (field 0), whichever side is the `null` literal. The std dict guards on
            # `m.items == null` this way. Distinct from `is` narrowing: no binding.
            if expression is Expr.Binary(null_left, null_operator, null_right, null_line):
                if null_operator == TokenKind.EqEq or null_operator == TokenKind.BangEq:
                    left_is_null: bool = is_null_literal(null_left)
                    right_is_null: bool = is_null_literal(null_right)
                    if left_is_null or right_is_null:
                        optional_operand: Expr = null_right if left_is_null else null_left
                        null_optional_type: ValueType = expression_type(optional_operand, local_scope, fns, structs, generics)
                        null return if null_optional_type.kind != TypeKind.Optional
                        if emit_expression(optional_operand, null_optional_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is null_optional_value:
                            null_optional_llvm: LLVMTypeRef = llvm_type_of(null_optional_type, structs, ctx)
                            null_holder: LLVMValueRef = LLVMBuildAlloca(builder, null_optional_llvm, "nullcmp.opt")
                            _ = LLVMBuildStore(builder, null_optional_value, null_holder)
                            null_tag_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, null_optional_llvm, null_holder, 0, "nullcmp.tag.ptr")
                            null_tag: LLVMValueRef = LLVMBuildLoad2(builder, LLVMInt1TypeInContext(ctx), null_tag_pointer, "nullcmp.tag")
