                return null

            # `catch f(args):` with a success arm and error-variant arms. The callee is an
            # ERROR fn (i32 status + out-param, stage0's ABI): call it, `code == 0` takes
            # the SUCCESS arm (arm 0, its Binding pattern names the out-value), a nonzero
            # code is `ordinal + 1` and dispatches down an icmp chain over the error arms.
            # Merged through a result slot, not a phi (the codebase avoids phi).
            if expression is Expr.Catch(catch_guarded, catch_arms, catch_line):
                null return if catch_arms.count < 1
                if catch_guarded is Expr.Call(catch_callee, catch_args, catch_arg_names, catch_call_line):
                    if catch_callee is Expr.Ident(catch_name, catch_name_line):
                        null return if not error_callee_is(fns, generics, catch_name)
                        catch_value_type: ValueType = error_callee_value_type(catch_name, catch_args, local_scope, fns, structs, generics)
                        null return if catch_value_type.kind == TypeKind.Unmodeled
                        if error_callee_target(catch_name, catch_args, local_scope, fns, structs, generics, m, ctx) is catch_target:
                            catch_value_llvm: LLVMTypeRef = llvm_type_of(catch_value_type, structs, ctx)
                            catch_out_slot: LLVMValueRef = LLVMBuildAlloca(builder, catch_value_llvm, "catch.out")
                            catch_call_args: mutable darray[LLVMValueRef] = [catch_out_slot]
                            catch_declined: mutable bool = false
                            catch_arg_index: mutable usize = 0
                            for catch_arg in catch_args |catch_call_args, catch_declined, catch_arg_index, catch_name, local_scope, fns, structs, generics, runtime, m, ctx, builder|:
                                if emit_expression(catch_arg, error_callee_param_type(catch_name, catch_args, catch_arg_index, local_scope, fns, structs, generics), local_scope, fns, structs, generics, runtime, m, ctx, builder) is catch_arg_value:
                                    catch_call_args.push(catch_arg_value)
                                else:
                                    catch_declined <- true
                                catch_arg_index <- catch_arg_index + 1
                            null return if catch_declined
                            catch_fn_type: LLVMTypeRef = LLVMGlobalGetValueType(catch_target)
                            catch_args_pointer: void& = (&catch_call_args[0]).cast[void&] can Unsafe.PointerCast
                            catch_code: LLVMValueRef = LLVMBuildCall2(builder, catch_fn_type, catch_target, catch_args_pointer, catch_call_args.count.u32(), "catch.code")
                            function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                            catch_value_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "catch.value")
                            catch_dispatch_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "catch.dispatch")
                            catch_done_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "catch.done")
                            catch_result_slot: LLVMValueRef = LLVMBuildAlloca(builder, catch_value_llvm, "catch.result")
                            catch_ok: LLVMValueRef = LLVMBuildICmp(builder, 32, catch_code, LLVMConstInt(LLVMInt32TypeInContext(ctx), 0, 0), "catch.ok")
                            _ = LLVMBuildCondBr(builder, catch_ok, catch_value_block, catch_dispatch_block)

                            # SUCCESS arm: arm 0. A Binding pattern names the out-slot value
                            # for the arm's body; a Wildcard uses the value unchanged.
                            LLVMPositionBuilderAtEnd(builder, catch_value_block)
                            success_arm: MatchArm = catch_arms[0]
                            null return if arm_has_guard(success_arm.guard)
                            if success_arm.pattern is Pattern.Binding(success_binding):
                                declare_local(local_scope, success_binding, catch_out_slot, catch_value_type)
                            if arm_value_expression(success_arm.body) is success_expression:
                                if emit_expression(success_expression, catch_value_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is success_value:
                                    _ = LLVMBuildStore(builder, success_value, catch_result_slot)
                                    _ = LLVMBuildBr(builder, catch_done_block)
                                else:
                                    return null
                            else:
                                return null

                            # ERROR arms: icmp chain over `code == ordinal + 1`. A Wildcard
                            # arm is the catch-all; without one the chain ends unreachable
                            # (the checker proved exhaustiveness).
                            LLVMPositionBuilderAtEnd(builder, catch_dispatch_block)
                            error_arm_index: mutable usize = 1
                            error_declined: mutable bool = false
                            saw_catch_all: mutable bool = false
                            while error_arm_index < catch_arms.count |error_arm_index, error_declined, saw_catch_all, catch_arms, catch_code, catch_value_type, catch_result_slot, catch_done_block, function, local_scope, fns, structs, generics, runtime, m, ctx, builder|:
                                error_arm: MatchArm = catch_arms[error_arm_index]
                                error_arm_index <- error_arm_index + 1
                                continue if error_declined or saw_catch_all
                                if arm_has_guard(error_arm.guard):
                                    error_declined <- true
                                    continue
                                if arm_value_expression(error_arm.body) is error_expression:
                                    if error_arm.pattern is Pattern.Wildcard:
                                        # catch-all: emit straight into the current block.
                                        if emit_expression(error_expression, catch_value_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is catch_all_value:
                                            _ = LLVMBuildStore(builder, catch_all_value, catch_result_slot)
                                            _ = LLVMBuildBr(builder, catch_done_block)
                                            saw_catch_all <- true
                                        else:
                                            error_declined <- true
                                        continue
                                    if error_arm.pattern is Pattern.TypeBind(error_type_name, error_binder):
                                        # `error e:` — the CATCH-ALL handler (same as the statement
                                        # form). The binder is NOT declared: a body that reads `e`
                                        # declines on the unknown ident rather than seeing a wrong
                                        # value. Any other TypeBind type is not a catch form.
                                        if error_type_name != "error":
                                            error_declined <- true
                                            continue
                                        if emit_expression(error_expression, catch_value_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is typebind_value:
                                            _ = LLVMBuildStore(builder, typebind_value, catch_result_slot)
                                            _ = LLVMBuildBr(builder, catch_done_block)
                                            saw_catch_all <- true
                                        else:
                                            error_declined <- true
                                        continue
                                    if error_arm.pattern is Pattern.Variant(error_path, error_fields):
                                        if error_fields.count != 0:
                                            error_declined <- true
                                            continue
                                        # An error decl registers as a PAYLOAD enum, so its
                                        # variant index comes from the penum pools; a const
                                        # enum path is the fallback.
                                        error_ordinal: mutable i64 = penum_variant_index_of_path(error_path, structs)
                                        if error_ordinal < 0:
                                            error_ordinal <- ordinal_of_dotted_path(error_path, structs)
                                        if error_ordinal < 0:
                                            error_declined <- true
                                            continue
                                        error_arm_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "catch.arm")
                                        error_next_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "catch.next")
                                        error_hit: LLVMValueRef = LLVMBuildICmp(builder, 32, catch_code, LLVMConstInt(LLVMInt32TypeInContext(ctx), (error_ordinal + 1).u64(), 0), "catch.cmp")
                                        _ = LLVMBuildCondBr(builder, error_hit, error_arm_block, error_next_block)
                                        LLVMPositionBuilderAtEnd(builder, error_arm_block)
                                        if emit_expression(error_expression, catch_value_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is error_value:
                                            _ = LLVMBuildStore(builder, error_value, catch_result_slot)
                                            _ = LLVMBuildBr(builder, catch_done_block)
                                        else:
                                            error_declined <- true
                                        LLVMPositionBuilderAtEnd(builder, error_next_block)
                                        continue
                                    error_declined <- true
                                else:
                                    error_declined <- true
                            null return if error_declined
                            # No catch-all: the residual block is unreachable (stage0's
                            # catch.fail) -- the checker proved the arms exhaustive.
                            if not saw_catch_all:
                                _ = LLVMBuildUnreachable(builder)
                            LLVMPositionBuilderAtEnd(builder, catch_done_block)
                            return LLVMBuildLoad2(builder, catch_value_llvm, catch_result_slot, "catch.value")
                return null
            if expression is Expr.StringLit(string_text):
                # `"hi"` in a `dstr` (= darray[u8]) context — build a byte darray in the arena,
                # exactly as stage0 does (alloc, store each byte, build the {ptr,count,cap}
                # header). The surrounding fn threads an arena when it returns/holds a dstr.
                if expected.kind == TypeKind.DArray and darray_element_of(expected, structs).kind == TypeKind.Unsigned and darray_element_of(expected, structs).bits == 8:
                    dstr_len: usize = sview_len(string_text)
                    dstr_cap: i64 = 256 if dstr_len.i64() < 256 else dstr_len.i64()
                    dstr_header: LLVMTypeRef = darray_llvm_type(structs, ctx)
                    dstr_slot: LLVMValueRef = LLVMBuildAlloca(builder, dstr_header, "dstr.literal")
                    _ = LLVMBuildStore(builder, LLVMConstNull(dstr_header), dstr_slot)
                    dstr_alloc_args: mutable darray[LLVMValueRef] = [runtime.arena, LLVMConstInt(LLVMInt64TypeInContext(ctx), dstr_cap.u64(), 0)]
                    dstr_alloc_pointer: void& = (&dstr_alloc_args[0]).cast[void&] can Unsafe.PointerCast
                    dstr_buffer: LLVMValueRef = LLVMBuildCall2(builder, runtime.arena_alloc_type, runtime.arena_alloc, dstr_alloc_pointer, 2, "dstr.alloc")
                    for dstr_byte_index in 0..<dstr_len |dstr_buffer, string_text, ctx, builder|:
                        dstr_byte_offset: mutable darray[LLVMValueRef] = [LLVMConstInt(LLVMInt64TypeInContext(ctx), dstr_byte_index.u64(), 0)]
                        dstr_byte_offset_pointer: void& = (&dstr_byte_offset[0]).cast[void&] can Unsafe.PointerCast
                        dstr_byte_slot: LLVMValueRef = LLVMBuildGEP2(builder, LLVMInt8TypeInContext(ctx), dstr_buffer, dstr_byte_offset_pointer, 1, "dstr.byte.ptr")
                        _ = LLVMBuildStore(builder, LLVMConstInt(LLVMInt8TypeInContext(ctx), sview_at(string_text, dstr_byte_index).u64(), 0), dstr_byte_slot)
                    dstr_items_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, dstr_header, dstr_slot, 0, "dstr.items.ptr")
                    _ = LLVMBuildStore(builder, dstr_buffer, dstr_items_pointer)
                    dstr_count_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, dstr_header, dstr_slot, 1, "dstr.count.ptr")
                    _ = LLVMBuildStore(builder, LLVMConstInt(LLVMInt64TypeInContext(ctx), dstr_len.u64(), 0), dstr_count_pointer)
                    dstr_cap_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, dstr_header, dstr_slot, 2, "dstr.cap.ptr")
                    _ = LLVMBuildStore(builder, LLVMConstInt(LLVMInt64TypeInContext(ctx), dstr_cap.u64(), 0), dstr_cap_pointer)
                    return LLVMBuildLoad2(builder, dstr_header, dstr_slot, "dstr.literal.value")
                null return if expected.kind != TypeKind.CStr and expected.kind != TypeKind.SView and expected.kind != TypeKind.Unmodeled
                literal_storage: mutable darray[u8] = []
                string_global: LLVMValueRef = LLVMBuildGlobalStringPtr(builder, sview_to_cstr(string_text, literal_storage), "str")
                # An `sview` context wants the `{ptr, i64 len}` aggregate, not the bare ptr.
                if expected.kind == TypeKind.SView:
                    sview_llvm: LLVMTypeRef = llvm_type_of(expected, structs, ctx)
                    sview_undef: LLVMValueRef = LLVMGetUndef(sview_llvm)
                    sview_with_ptr: LLVMValueRef = LLVMBuildInsertValue(builder, sview_undef, string_global, 0, "sview.ptr")
                    sview_len_value: LLVMValueRef = LLVMConstInt(LLVMInt64TypeInContext(ctx), sview_len(string_text).u64(), 0)
                    return LLVMBuildInsertValue(builder, sview_with_ptr, sview_len_value, 1, "sview.len")
                return string_global
            if expression is Expr.Ident(null_name, null_line):
                if null_name == "null":
                    null return if expected.kind != TypeKind.Optional
                    return LLVMConstNull(llvm_type_of(expected, structs, ctx))
                # `zeroed` — the all-zero value of the CONTEXT type: 0 for a scalar, a null
                # pointer for a ref, and `zeroinitializer` for a struct/array. The dict grow
                # path zero-fills fresh buckets with `zeroed`.
                if null_name == "zeroed":
                    null return if expected.kind == TypeKind.Unmodeled
                    return LLVMConstNull(llvm_type_of(expected, structs, ctx))
            if expression is Expr.Ident(ident_name, ident_line):
                ident_type: ValueType = lookup_type(local_scope, ident_name)
                # A GLOBAL const is INLINED at its use site, exactly as stage0 does: no
                # global, no load, just the folded value at the const's own type. Checked
                # only when the name is not a local, so a local still shadows it.
                if ident_type.kind == TypeKind.Unmodeled:
                    const_index: i64 = const_index_of(structs, ident_name)
                    if const_index >= 0 and structs.const_resolved[const_index.usize()]:
                        const_type: ValueType = copied_type(structs.const_types[const_index.usize()])
                        # A FLOAT const inlines its source text via LLVMConstRealOfString (its
                        # value never fits/parses as an i64).
                        if const_type.kind == TypeKind.Float:
                            const_float_storage: mutable darray[u8] = []
                            return LLVMConstRealOfString(llvm_type_of(const_type, structs, ctx), sview_to_cstr(structs.const_float_text[const_index.usize()], const_float_storage))
                        # A bool const is a real i1; its folded value (0/1) inlines like an int.
                        null return if not is_integer_type(const_type) and const_type.kind != TypeKind.Bool
                        return LLVMConstInt(llvm_type_of(const_type, structs, ctx), structs.const_values[const_index.usize()].u64(), 0)
                null return if ident_type.kind == TypeKind.Unmodeled
                if lookup_slot(local_scope, ident_name) is slot:
                    # A REF-typed local used in a VALUE context auto-DEREFERENCES: the slot
                    # holds a pointer, so read the pointer out and then load the pointee.
                    # This is how `if d.get(k) is a: total <- total + a` reads through the
                    # `mutable T&` binding (stage0: `%a = load ptr, ...; load i64, ptr %a`).
                    # Only when `expected` is a concrete NON-ref value type — otherwise the
                    # ref itself is wanted (passed on, or the context is unknown).
                    if ident_type.kind == TypeKind.Ref and expected.kind != TypeKind.Ref and expected.kind != TypeKind.Unmodeled:
                        ref_target: ValueType = ref_target_of(ident_type, structs)
                        if ref_target.kind == expected.kind and ref_target.bits == expected.bits:
                            ref_pointer: LLVMValueRef = LLVMBuildLoad2(builder, LLVMPointerTypeInContext(ctx, 0), slot, "ref.ptr")
                            return LLVMBuildLoad2(builder, llvm_type_of(ref_target, structs, ctx), ref_pointer, "ref.value")
                    # An OPTIONAL-REF local used where its ref PAYLOAD is expected UNWRAPS it:
                    # extract the payload pointer (field 1 of `{i1, ptr}`). The std does this
                    # right after `assert opt != null` (`items: Bucket& = m.items`); presence is
                    # the frontend's proof, not re-checked here.
                    if ident_type.kind == TypeKind.Optional and expected.kind == TypeKind.Ref:
                        optional_ref_payload: ValueType = optional_payload_of(ident_type, structs)
                        if optional_ref_payload.kind == TypeKind.Ref:
                            optional_ref_llvm: LLVMTypeRef = llvm_type_of(ident_type, structs, ctx)
                            optional_ref_payload_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, optional_ref_llvm, slot, 1, "unwrap.payload.ptr")
                            return LLVMBuildLoad2(builder, LLVMPointerTypeInContext(ctx, 0), optional_ref_payload_pointer, "unwrap.ref")
