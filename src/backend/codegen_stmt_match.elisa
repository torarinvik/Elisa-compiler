# Stage1 backend — `emit_statement`: the `match` STATEMENT: optional, call and packed-AST scrutinees.
# A group of the statement emitter's branches, called from codegen_statement.elisa.
# `handled` is set TRUE on entry and cleared only if no branch here matched, so a branch
# that DECLINES still stops the dispatch — exactly as it did when every branch shared one
# function body.

extend Backend:
    private:
        # A nested variant pattern may apply to an optional packed-enum field. Test
        # presence first and only pass the extracted payload to the packed-store reader;
        # treating the tagged `{present, payload}` LLVM aggregate as an integer handle
        # generates invalid IR (and would be semantically wrong even if LLVM accepted it).
        def emit_packed_variant_subpattern_test(sub_path: sview @source, sub_fields: darray[Pattern]&, value: LLVMValueRef, value_type: ValueType, next_block: LLVMBasicBlockRef, function: LLVMValueRef, local_scope: mutable Scope&, structs: mutable StructTable&, m: LLVMModuleRef, runtime: Runtime&, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            # Const enums lower to their signed/unsigned scalar representation.
            # A zero-field variant constrains that scalar; it is not an AST handle.
            if is_integer_type(value_type):
                return false if sub_fields.count != 0
                enum_value_found: mutable bool = false
                enum_value: i64 = const_enum_value_of_dotted_path(sub_path, structs, enum_value_found)
                return false if not enum_value_found
                hit: LLVMValueRef = LLVMBuildICmp(builder, 32, value, LLVMConstInt(llvm_type_of(value_type, structs, ctx), enum_value.u64(), 1), "sub.enum.hit")
                matched: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "sub.enum.matched")
                _ = LLVMBuildCondBr(builder, hit, matched, next_block)
                LLVMPositionBuilderAtEnd(builder, matched)
                return true
            if value_type.kind == TypeKind.Optional:
                payload_type: ValueType = optional_payload_of(value_type, structs)
                return false if payload_type.kind != TypeKind.PackedEnum
                present: LLVMValueRef = optional_tag_of(value, value_type, structs, ctx, builder)
                present_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "sub.optional.present")
                _ = LLVMBuildCondBr(builder, present, present_block, next_block)
                LLVMPositionBuilderAtEnd(builder, present_block)
                payload: LLVMValueRef = optional_payload_value_of(value, value_type, structs, ctx, builder)
                return emit_packed_subpattern_test(sub_path, sub_fields, payload, next_block, function, local_scope, structs, m, runtime, ctx, builder)
            return false if value_type.kind != TypeKind.PackedEnum
            return emit_packed_subpattern_test(sub_path, sub_fields, value, next_block, function, local_scope, structs, m, runtime, ctx, builder)

        # Test a NESTED packed sub-pattern against a sub-node HANDLE, and bind its fields.
        #
        # Reads the sub-node's record, compares its tag, and falls through to `next_block` on a
        # mismatch — so the arm runs only when every nested test holds. Then binds each field: a
        # Binding by name, a Wildcard not at all, and a nested Variant by RECURSING. The
        # recursion is what makes DEPTH > 1 work, e.g.
        # `Expr.Unary(op, Expr.Field(Expr.Ident(owner, l), field, fl), al)`, where hand-written
        # one-level code left `owner` unbound and the arm body then failed to emit.
        #
        # Returns false to DECLINE. Every read here is guarded by the caller's outer tag test,
        # so the handle is only dereferenced once the enclosing variant matched.
        def emit_packed_subpattern_test(sub_path: sview, sub_fields: darray[Pattern]&, handle_value: LLVMValueRef, next_block: LLVMBasicBlockRef, function: LLVMValueRef, local_scope: mutable Scope&, structs: mutable StructTable&, m: LLVMModuleRef, runtime: Runtime&, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            sub_slot: i64 = packed_slot_of_path(sub_path, structs)
            sub_ord: i64 = packed_variant_index_of_path(sub_path, structs)
            return false if:
                sub_slot < 0 or sub_ord < 0 or runtime.packed_mode != 2
                sub_fields.count > 0 and sub_fields.count != structs.packed_enums.packed_field_type_count[sub_slot.usize()]
            # Do not silently treat unimplemented constraints as wildcards.
            for sub_pattern in sub_fields:
                match sub_pattern:
                    Pattern.Binding(_) | Pattern.Wildcard | Pattern.Variant(_, _) | Pattern.Literal(_):
                        pass
                    _:
                        return false
            sub_state: LLVMValueRef = LLVMBuildExtractValue(builder, runtime.active_store, 2, "sub.state")
            sub_h64: LLVMValueRef = LLVMBuildZExt(builder, handle_value, LLVMInt64TypeInContext(ctx), "sub.h64")
            sub_args: mutable darray[LLVMValueRef] = [sub_state, sub_h64]
            sub_args_pointer: void& = (&sub_args[0]).cast[void&] can Unsafe.PointerCast
            sub_record: LLVMValueRef = packed_ast_sized_record_read(structs, runtime, m, ctx, builder, sub_state, sub_h64, runtime.packed_read_word_type, runtime.packed_read_word, sub_args_pointer, 2, "sub.record")
            # packed_row_llvm_type is keyed by ENUM INDEX; `sub_slot` is a variant SLOT. Passing
            # the slot built a row from another enum's payload_words/common_counts, so the
            # payload GEP below landed at the wrong offset and every binder after the first came
            # out garbage — `Expr.Index(Expr.Field(receiver, selector, _), _, _)` bound `selector`
            # to something that was never the field name, which is why the stage1-built analyzer
            # silently stopped reporting `pointer cast requires can[Unsafe]`.
            sub_enum_index: i64 = packed_enum_index_of_path(sub_path, structs)
            return false if sub_enum_index < 0
            sub_row: LLVMTypeRef = packed_row_llvm_type(structs, sub_enum_index, ctx)
            sub_tag_ptr: LLVMValueRef = LLVMBuildStructGEP2(builder, sub_row, sub_record, 0, "sub.tag.ptr")
            sub_tag: LLVMValueRef = LLVMBuildLoad2(builder, LLVMInt32TypeInContext(ctx), sub_tag_ptr, "sub.tag")
            sub_hit: LLVMValueRef = LLVMBuildICmp(builder, 32, sub_tag, LLVMConstInt(LLVMInt32TypeInContext(ctx), sub_ord.u64(), 0), "sub.cmp")
            sub_cont: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "sub.cont")
            _ = LLVMBuildCondBr(builder, sub_hit, sub_cont, next_block)
            LLVMPositionBuilderAtEnd(builder, sub_cont)
            return true if sub_fields.count == 0
            sub_payload: ValueType = packed_payload_of_path(sub_path, structs)
            return false if sub_payload.kind == TypeKind.Unmodeled
            sub_pay: mutable LLVMValueRef = LLVMGetUndef(llvm_type_of(sub_payload, structs, ctx))
            if packed_typed_row_load_payload(sub_payload, sub_slot.usize(), structs, sub_enum_index, sub_row, sub_record, sub_state, sub_h64, ctx, builder) is sub_pay_loaded:
                sub_pay <- sub_pay_loaded
            else:
                return false
            sub_field_start: usize = structs.packed_enums.packed_field_type_start[sub_slot.usize()]
            sub_ok: mutable bool = true
            # One field: the payload IS the value, so there is no ExtractValue.
            if sub_fields.count == 1:
                match sub_fields[0]:
                    Pattern.Binding(sub_one_name):
                        sub_one_storage: mutable darray[u8] = []
                        sub_one_slot: LLVMValueRef = build_entry_alloca(builder, llvm_type_of(sub_payload, structs, ctx), sview_to_cstr(sub_one_name, sub_one_storage))
                        _ = LLVMBuildStore(builder, sub_pay, sub_one_slot)
                        declare_local(local_scope, sub_one_name, sub_one_slot, sub_payload)
                    Pattern.Variant(sub_one_path, sub_one_fields):
                        sub_ok <- emit_packed_variant_subpattern_test(sub_one_path, sub_one_fields, sub_pay, sub_payload, next_block, function, local_scope, structs, m, runtime, ctx, builder)
                    Pattern.Literal(sub_one_literal):
                        if payload_literal_hit(sub_one_literal, sub_pay, sub_payload, structs, runtime, ctx, builder) is sub_one_hit:
                            sub_one_cont: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "sub.literal.cont")
                            _ = LLVMBuildCondBr(builder, sub_one_hit, sub_one_cont, next_block)
                            LLVMPositionBuilderAtEnd(builder, sub_one_cont)
                        else:
                            sub_ok <- false
                    _:
                        pass
            if sub_fields.count > 1:
                for sub_index in 0..<sub_fields.count |sub_ok, sub_fields, sub_field_start, sub_pay, next_block, function, local_scope, structs, m, runtime, ctx, builder|:
                    continue if not sub_ok
                    sub_field_type: ValueType = copied_type(structs.packed_enums.packed_field_types[sub_field_start + sub_index])
                    sub_field_value: LLVMValueRef = LLVMBuildExtractValue(builder, sub_pay, sub_index.u32(), "sub.field")
                    match sub_fields[sub_index]:
                        Pattern.Binding(sub_bind_name):
                            sub_bind_storage: mutable darray[u8] = []
                            sub_bind_slot: LLVMValueRef = build_entry_alloca(builder, llvm_type_of(sub_field_type, structs, ctx), sview_to_cstr(sub_bind_name, sub_bind_storage))
                            _ = LLVMBuildStore(builder, sub_field_value, sub_bind_slot)
                            declare_local(local_scope, sub_bind_name, sub_bind_slot, sub_field_type)
                        Pattern.Variant(sub_nest_path, sub_nest_fields):
                            sub_ok <- emit_packed_variant_subpattern_test(sub_nest_path, sub_nest_fields, sub_field_value, sub_field_type, next_block, function, local_scope, structs, m, runtime, ctx, builder)
                        Pattern.Literal(sub_literal):
                            if payload_literal_hit(sub_literal, sub_field_value, sub_field_type, structs, runtime, ctx, builder) is sub_literal_hit:
                                sub_literal_cont: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "sub.literal.cont")
                                _ = LLVMBuildCondBr(builder, sub_literal_hit, sub_literal_cont, next_block)
                                LLVMPositionBuilderAtEnd(builder, sub_literal_cont)
                            else:
                                sub_ok <- false
                        _:
                            pass
            return sub_ok


        def match_null_arm_index(arms: darray[MatchArm]&) -> i64 can[Abort.Panic]:
            for arm_index in 0..<arms.count |arms|:
                if arms[arm_index].pattern is Pattern.Literal(literal_text):
                    return arm_index.i64() if literal_text == "null"
            return -1

include "./codegen_stmt_match_emit.elisa"
