# Stage1 backend — `emit_statement`: the `match` STATEMENT: optional, call and packed-AST scrutinees.
# A group of the statement emitter's branches, called from codegen_statement.elisa.
# `handled` is set TRUE on entry and cleared only if no branch here matched, so a branch
# that DECLINES still stops the dispatch — exactly as it did when every branch shared one
# function body.

extend Backend:
    private:
        # Test a NESTED packed sub-pattern against a sub-node HANDLE, and bind its fields.
        #
        # Reads the sub-node's record, compares its tag, and falls through to `next_block` on a
        # mismatch — so the arm runs only when every nested test holds. Then binds each field: a
        # Binding by name, a Wildcard not at all, and a nested Variant by RECURSING. The
        # recursion is what makes DEPTH > 1 work, e.g.
        # `Expr.Unary(op, Expr.Field(Expr.Ident(owner, l), field, fl), al)`, where hand-written
        # one-level code left `owner` unbound and the arm body then failed to emit.
        #
        # Returns false to DECLINE. Every read here is guarded by the caller's outer tag test,
        # so the handle is only dereferenced once the enclosing variant matched.
        def emit_packed_subpattern_test(sub_path: sview, sub_fields: darray[Pattern]&, handle_value: LLVMValueRef, next_block: LLVMBasicBlockRef, function: LLVMValueRef, local_scope: mutable Scope&, structs: mutable StructTable&, runtime: Runtime&, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            sub_slot: i64 = packed_slot_of_path(sub_path, structs)
            sub_ord: i64 = packed_variant_index_of_path(sub_path, structs)
            false return if sub_slot < 0 or sub_ord < 0 or runtime.packed_mode != 2
            sub_state: LLVMValueRef = LLVMBuildExtractValue(builder, runtime.active_store, 2, "sub.state")
            sub_h64: LLVMValueRef = LLVMBuildZExt(builder, handle_value, LLVMInt64TypeInContext(ctx), "sub.h64")
            sub_args: mutable darray[LLVMValueRef] = [sub_state, sub_h64]
            sub_args_pointer: void& = (&sub_args[0]).cast[void&] can Unsafe.PointerCast
            sub_record: LLVMValueRef = LLVMBuildCall2(builder, runtime.packed_read_word_type, runtime.packed_read_word, sub_args_pointer, 2, "sub.record")
            # packed_row_llvm_type is keyed by ENUM INDEX; `sub_slot` is a variant SLOT. Passing
            # the slot built a row from another enum's payload_words/common_counts, so the
            # payload GEP below landed at the wrong offset and every binder after the first came
            # out garbage — `Expr.Index(Expr.Field(receiver, selector, _), _, _)` bound `selector`
            # to something that was never the field name, which is why the stage1-built analyzer
            # silently stopped reporting `pointer cast requires can[Unsafe]`.
            sub_enum_index: i64 = packed_enum_index_of_path(sub_path, structs)
            false return if sub_enum_index < 0
            sub_row: LLVMTypeRef = packed_row_llvm_type(structs, sub_enum_index, ctx)
            sub_tag_ptr: LLVMValueRef = LLVMBuildStructGEP2(builder, sub_row, sub_record, 0, "sub.tag.ptr")
            sub_tag: LLVMValueRef = LLVMBuildLoad2(builder, LLVMInt32TypeInContext(ctx), sub_tag_ptr, "sub.tag")
            sub_hit: LLVMValueRef = LLVMBuildICmp(builder, 32, sub_tag, LLVMConstInt(LLVMInt32TypeInContext(ctx), sub_ord.u64(), 0), "sub.cmp")
            sub_cont: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "sub.cont")
            _ = LLVMBuildCondBr(builder, sub_hit, sub_cont, next_block)
            LLVMPositionBuilderAtEnd(builder, sub_cont)
            true return if sub_fields.count == 0
            sub_payload: ValueType = packed_payload_of_path(sub_path, structs)
            true return if sub_payload.kind == TypeKind.Unmodeled
            sub_pay_ptr: LLVMValueRef = LLVMBuildStructGEP2(builder, sub_row, sub_record, 1, "sub.payload.ptr")
            sub_pay: LLVMValueRef = LLVMBuildLoad2(builder, llvm_type_of(sub_payload, structs, ctx), sub_pay_ptr, "sub.payload")
            sub_field_start: usize = structs.packed_field_type_start[sub_slot.usize()]
            sub_ok: mutable bool = true
            # One field: the payload IS the value, so there is no ExtractValue.
            if sub_fields.count == 1:
                if sub_fields[0] is Pattern.Binding(sub_one_name):
                    sub_one_storage: mutable darray[u8] = []
                    sub_one_slot: LLVMValueRef = LLVMBuildAlloca(builder, llvm_type_of(sub_payload, structs, ctx), sview_to_cstr(sub_one_name, sub_one_storage))
                    _ = LLVMBuildStore(builder, sub_pay, sub_one_slot)
                    declare_local(local_scope, sub_one_name, sub_one_slot, sub_payload)
                elif sub_fields[0] is Pattern.Variant(sub_one_path, sub_one_fields):
                    sub_ok <- emit_packed_subpattern_test(sub_one_path, sub_one_fields, sub_pay, next_block, function, local_scope, structs, runtime, ctx, builder)
            if sub_fields.count > 1:
                for sub_index in 0..<sub_fields.count |sub_ok, sub_fields, sub_field_start, sub_pay, next_block, function, local_scope, structs, runtime, ctx, builder|:
                    continue if not sub_ok
                    sub_field_type: ValueType = copied_type(structs.packed_field_types[sub_field_start + sub_index])
                    sub_field_value: LLVMValueRef = LLVMBuildExtractValue(builder, sub_pay, sub_index.u32(), "sub.field")
                    if sub_fields[sub_index] is Pattern.Binding(sub_bind_name):
                        sub_bind_storage: mutable darray[u8] = []
                        sub_bind_slot: LLVMValueRef = LLVMBuildAlloca(builder, llvm_type_of(sub_field_type, structs, ctx), sview_to_cstr(sub_bind_name, sub_bind_storage))
                        _ = LLVMBuildStore(builder, sub_field_value, sub_bind_slot)
                        declare_local(local_scope, sub_bind_name, sub_bind_slot, sub_field_type)
                    elif sub_fields[sub_index] is Pattern.Variant(sub_nest_path, sub_nest_fields):
                        sub_ok <- emit_packed_subpattern_test(sub_nest_path, sub_nest_fields, sub_field_value, next_block, function, local_scope, structs, runtime, ctx, builder)
            return sub_ok


        def emit_statement_match(statement: Stmt, return_type: ValueType, local_scope: mutable Scope&, loops: mutable LoopStack&, regions: mutable RegionStack&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef, handled: mutable bool&) -> EmitStatus can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            handled <- true
            # `for i in a..<b:` / `for i in a..=b:` over an integer range. Only the range
            # forms are modeled: iterating a container needs the container ABI.
            #
            # Lowered as: i = a; head: i < b ? body : exit; body -> step: i = i + 1 -> head.
            # The increment lives in its OWN block so `continue` can target it — jumping
            # straight back to the head would skip the step and spin forever.
            # STATEMENT-position `catch f(args):` — the parser lowers it to Stmt.Match
            # whose scrutinee is the fallible CALL. Modeled when the callee is an ERROR
            # fn: call through the out-param ABI, `code == 0` runs the success arm (a
            # Binding pattern names the out value), a nonzero code is `ordinal + 1` and
            # dispatches down the error arms; `error e:` / `_` is the catch-all. Arm
            # bodies are full statement blocks (usually `return …`), joined at a done
            # block for any arm left open.
            if statement is Stmt.Match(stmt_match_scrutinee, stmt_match_arms, stmt_match_line):
                EmitStatus.Declined return if stmt_match_arms.count < 1
                # `match NODE in STORE:` — the packed in-store clause. `in` is a binary
                # operator, so the parser hands the whole header over as
                # `Binary(NODE, In, STORE)` and the scrutinee reads as a boolean membership
                # test. No parser change is needed (and a parser-side split LOSES a frontend
                # diagnostic -- stage0 reports BOTH an undefined store name and the store-type
                # error, and splitting stops the resolver walking the store expression).
                #
                # Unwrap it here instead: make STORE the active store, exactly as an
                # `in store:` BLOCK does, and re-enter on NODE alone.
                if stmt_match_scrutinee is Expr.Binary(mis_node, mis_operator, mis_store, mis_binary_line):
                    if mis_operator == TokenKind.In:
                        if mis_store is Expr.Ident(mis_store_name, mis_store_name_line):
                            mis_store_type: ValueType = lookup_type(local_scope, mis_store_name)
                            EmitStatus.Declined return if mis_store_type.kind != TypeKind.PackedStore
                            if lookup_slot(local_scope, mis_store_name) is mis_store_slot:
                                mis_runtime: mutable Runtime = copied_runtime(runtime)
                                mis_runtime.active_store <- LLVMBuildLoad2(builder, llvm_type_of(mis_store_type, structs, ctx), mis_store_slot, "store.active")
                                mis_runtime.active_store_enum <- mis_store_type.bits.i64()
                                return emit_statement((Stmt.Match(mis_node, stmt_match_arms, stmt_match_line)), return_type, local_scope, loops, regions, fns, structs, generics, mis_runtime, m, ctx, builder)
                            return EmitStatus.Declined
                # `match p: Point{x, y}: …` — a plain STRUCT destructure arm. A struct pattern
                # has no discriminant (`p`'s static type already names the struct), so once the
                # FIRST arm's pattern is a Struct matching the scrutinee's type, every later arm
                # is statically unreachable — matching stage0's own emitted shape, which gives
                # the struct arm's body an unconditional `br` and leaves any further arm dead
                # code with "No predecessors!". Later arms are simply not compiled, exactly as
                # stage0 never reaches them.
                #
                # Every struct-pattern field parses as `Pattern.Field(selector, [inner])` — even
                # shorthand `{x}` (parser_stmt_pattern.elisa) — so `selector` is always the
                # field's declared name. SOUND SUBSET: only Binding/Wildcard inner patterns are
                # modeled; a literal or nested sub-pattern field declines (falls through to the
                # ordinary dispatch below, which will also decline — no example of that shape
                # exists in the corpus to verify a value-comparing implementation against).
                # `match p: Point{x, y} as whole: …` — same struct destructure, plus the
                # entire matched value bound to `whole` alongside its fields (docs/122 §5.4
                # as-binding). The parser only ever wraps a Variant or Struct pattern in
                # `Pattern.As` (parser_stmt_pattern.elisa), so unwrapping it here first and
                # falling through to the identical Struct handling below — with one extra
                # bind for the whole value — covers the struct case with no new dispatch
                # shape. SOUND SUBSET: same restriction as the plain struct arm.
                # A struct-pattern match with a TEST and further arms
                # (`Token(kind: .INTEGER, …): … / _: …`). The single-arm destructure path below
                # emits arm 0 UNCONDITIONALLY, which is right only when there is nothing to
                # test and nothing after it.
                #
                # Rewritten instead of extended: the pattern is rebuilt as an `is` EXPRESSION
                # and the arm becomes `if SCRUT is PATTERN: body else: match SCRUT: <rest>`.
                # The `is` emitter already lowers the whole spelling -- field tests, nested
                # struct fields, payload bindings -- and re-entering on the remaining arms
                # keeps first-wins order without a second struct-matching engine.
                if stmt_match_arms.count >= 2 and not arm_has_guard(stmt_match_arms[0].guard):
                    sps_is_struct_shape: mutable bool = false
                    sps_arm_pattern: Pattern = stmt_match_arms[0].pattern
                    if sps_arm_pattern is Pattern.Struct(sps_path, sps_fields):
                        sps_is_struct_shape <- true
                    if sps_arm_pattern is Pattern.Variant(sps_vpath, sps_vfields):
                        # The PARENTHESISED spelling. Gated on the head naming a STRUCT so an
                        # ordinary enum-variant arm keeps its own (scalar-chain) path.
                        sps_is_struct_shape <- true if sps_vfields.count > 0 and struct_index_of(structs, sps_vpath) >= 0
                    # A LITERAL field test (`Block{tag: 1}` / `Block(tag: 1)`) is rebuildable,
                    # but stage0's parser REJECTS that spelling as a match ARM — it only accepts
                    # it after `expect … as`, which builds its own test. Declining here keeps
                    # stage1 from compiling a program stage0 refuses.
                    sps_has_literal_field: mutable bool = false
                    if sps_arm_pattern is Pattern.Struct(sps_lit_path, sps_lit_fields):
                        for sps_lit_field in sps_lit_fields |sps_has_literal_field|:
                            if sps_lit_field is Pattern.Field(sps_lit_selector, sps_lit_inner):
                                if sps_lit_inner.count == 1 and sps_lit_inner[0] is Pattern.Literal(sps_lit_text):
                                    sps_has_literal_field <- true
                    if sps_arm_pattern is Pattern.Variant(sps_litv_path, sps_litv_fields):
                        for sps_litv_field in sps_litv_fields |sps_has_literal_field|:
                            if sps_litv_field is Pattern.Field(sps_litv_selector, sps_litv_inner):
                                if sps_litv_inner.count == 1 and sps_litv_inner[0] is Pattern.Literal(sps_litv_text):
                                    sps_has_literal_field <- true
                    sps_is_struct_shape <- false if sps_has_literal_field
                    if sps_is_struct_shape:
                        if struct_pattern_as_expr(sps_arm_pattern, structs, stmt_match_line) is sps_test:
                            sps_rest: mutable darray[MatchArm] = []
                            for sps_index in 1..<stmt_match_arms.count |sps_rest, stmt_match_arms|:
                                sps_rest.push(stmt_match_arms[sps_index])
                            # A lone CATCH-ALL tail becomes the else-body directly: re-entering
                            # `match SCRUT:` with only a `_` arm asks the match emitter to type
                            # a scrutinee it has nothing to compare, and it declines.
                            sps_else: mutable darray[Stmt] = []
                            if sps_rest.count == 1 and is_catch_all_pattern(sps_rest[0].pattern) and not arm_has_guard(sps_rest[0].guard):
                                sps_else.extend(sps_rest[0].body)
                            else:
                                sps_else.push((Stmt.Match(stmt_match_scrutinee, sps_rest, stmt_match_line)))
                            sps_test_expr: Expr = (Expr.Binary(stmt_match_scrutinee, TokenKind.Is, sps_test, stmt_match_line))
                            return emit_statement((Stmt.If(sps_test_expr, stmt_match_arms[0].body, sps_else, stmt_match_line)), return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)
                sms_as_name: mutable sview = ""
                sms_pattern: mutable Pattern = stmt_match_arms[0].pattern
                if stmt_match_arms[0].pattern is Pattern.As(sms_as_outer_name, sms_as_inner):
                    if sms_as_inner.count == 1 and sms_as_inner[0] is Pattern.Struct(_, _):
                        sms_as_name <- sms_as_outer_name
                        sms_pattern <- sms_as_inner[0]
                if sms_pattern is Pattern.Struct(sms_path, sms_fields):
                    if not arm_has_guard(stmt_match_arms[0].guard):
                        sms_slot: i64 = struct_index_of(structs, sms_path)
                        if sms_slot >= 0:
                            sms_scrut_type: ValueType = expression_type(stmt_match_scrutinee, local_scope, fns, structs, generics)
                            if sms_scrut_type.kind == TypeKind.Struct and sms_scrut_type.bits == sms_slot.u32():
                                sms_declined: mutable bool = false
                                sms_positions: mutable darray[i64] = []
                                sms_names: mutable darray[sview] = []
                                for sms_field in sms_fields |sms_declined, sms_positions, sms_names, sms_slot, structs|:
                                    if sms_field is Pattern.Field(sms_selector, sms_inner):
                                        # A Wildcard field needs no position at all — nothing is
                                        # extracted or bound for it — so it is decided BEFORE any
                                        # by-name lookup. That matters because the parser sets
                                        # `selector` from the field's own cursor token even for a
                                        # bare `_` (parser_stmt_pattern.elisa), so a `_` field's
                                        # selector is the literal text "_", never a real field
                                        # name; looking that up here would always miss and wrongly
                                        # decline `Point{x, _}`.
                                        if sms_inner.count == 1 and sms_inner[0] is Pattern.Wildcard:
                                            pass
                                        else:
                                            sms_position: i64 = field_index_of(structs, sms_slot.usize(), sms_selector)
                                            if sms_position < 0 or sms_inner.count != 1:
                                                sms_declined <- true
                                            elif sms_inner[0] is Pattern.Binding(sms_bind_name):
                                                sms_positions.push(sms_position)
                                                sms_names.push(sms_bind_name)
                                            else:
                                                sms_declined <- true
                                    else:
                                        sms_declined <- true
                                if not sms_declined:
                                    if emit_expression(stmt_match_scrutinee, sms_scrut_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is sms_struct_value:
                                        for sms_bind_index in 0..<sms_positions.count |sms_positions, sms_names, sms_struct_value, sms_slot, structs, local_scope, ctx, builder|:
                                            sms_field_type: ValueType = structs.field_types[structs.field_start[sms_slot.usize()] + sms_positions[sms_bind_index].usize()]
                                            sms_field_value: LLVMValueRef = LLVMBuildExtractValue(builder, sms_struct_value, sms_positions[sms_bind_index].u32(), "match.struct.field")
                                            sms_bind_slot: LLVMValueRef = LLVMBuildAlloca(builder, llvm_type_of(sms_field_type, structs, ctx), "match.struct.bind")
                                            _ = LLVMBuildStore(builder, sms_field_value, sms_bind_slot)
                                            declare_local(local_scope, sms_names[sms_bind_index], sms_bind_slot, sms_field_type)
                                        if sms_as_name != "":
                                            sms_whole_slot: LLVMValueRef = LLVMBuildAlloca(builder, llvm_type_of(sms_scrut_type, structs, ctx), "match.struct.whole")
                                            _ = LLVMBuildStore(builder, sms_struct_value, sms_whole_slot)
                                            declare_local(local_scope, sms_as_name, sms_whole_slot, sms_scrut_type)
                                        return emit_statements_scoped(stmt_match_arms[0].body, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)
                                    return EmitStatus.Declined
                # `match OPT: null: … binding: …` — a match whose scrutinee is an OPTIONAL value.
                # Two arms: a `null` (or `_`) arm and a BINDING arm that binds the payload. Lowered
                # like `if OPT is v:` but as a match: test the tag (field 0), branch to the binding
                # arm (bind v = payload) or the null arm. IndexMap's put/find use exactly this.
                match_opt_type: ValueType = expression_type(stmt_match_scrutinee, local_scope, fns, structs, generics)
                if match_opt_type.kind == TypeKind.Optional and stmt_match_arms.count == 2:
                    mo_payload_type: ValueType = optional_payload_of(match_opt_type, structs)
                    mo_null_arm_index: mutable i64 = -1
                    mo_bind_arm_index: mutable i64 = -1
                    mo_bind_name: mutable sview = ""
                    for mo_arm_i in 0..<stmt_match_arms.count |mo_null_arm_index, mo_bind_arm_index, mo_bind_name, stmt_match_arms|:
                        mo_arm: MatchArm = stmt_match_arms[mo_arm_i]
                        if mo_arm.pattern is Pattern.Literal(mo_lit_text):
                            mo_null_arm_index <- mo_arm_i.i64() if mo_lit_text == "null"
                        if mo_arm.pattern is Pattern.Wildcard:
                            mo_null_arm_index <- mo_arm_i.i64() if mo_null_arm_index < 0
                        if mo_arm.pattern is Pattern.Binding(mo_pat_name):
                            mo_bind_arm_index <- mo_arm_i.i64()
                            mo_bind_name <- mo_pat_name
                    if mo_null_arm_index >= 0 and mo_bind_arm_index >= 0:
                        # A guarded arm is not the plain null/binding split modeled here.
                        if stmt_match_arms[mo_null_arm_index.usize()].guard is Expr.Absent and stmt_match_arms[mo_bind_arm_index.usize()].guard is Expr.Absent:
                            if emit_expression(stmt_match_scrutinee, match_opt_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is mo_opt_value:
                                mo_opt_llvm: LLVMTypeRef = llvm_type_of(match_opt_type, structs, ctx)
                                mo_tag: LLVMValueRef = optional_tag_of(mo_opt_value, match_opt_type, structs, ctx, builder)
                                mo_payload: LLVMValueRef = optional_payload_value_of(mo_opt_value, match_opt_type, structs, ctx, builder)
                                mo_function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                                mo_bind_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, mo_function, "match.opt.present")
                                mo_null_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, mo_function, "match.opt.absent")
                                mo_done_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, mo_function, "match.opt.done")
                                _ = LLVMBuildCondBr(builder, mo_tag, mo_bind_block, mo_null_block)
                                # PRESENT: bind the payload to the arm's name, run its body.
                                LLVMPositionBuilderAtEnd(builder, mo_bind_block)
                                mo_bind_storage: mutable darray[u8] = []
                                mo_bind_slot: LLVMValueRef = LLVMBuildAlloca(builder, llvm_type_of(mo_payload_type, structs, ctx), sview_to_cstr(mo_bind_name, mo_bind_storage))
                                _ = LLVMBuildStore(builder, mo_payload, mo_bind_slot)
                                declare_local(local_scope, mo_bind_name, mo_bind_slot, mo_payload_type)
                                mo_bind_status: EmitStatus = emit_statements_scoped(stmt_match_arms[mo_bind_arm_index.usize()].body, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)
                                EmitStatus.Declined return if mo_bind_status == EmitStatus.Declined
                                branch_if_open(mo_bind_status, builder, mo_done_block)
                                # ABSENT: run the null arm's body.
                                LLVMPositionBuilderAtEnd(builder, mo_null_block)
                                mo_null_status: EmitStatus = emit_statements_scoped(stmt_match_arms[mo_null_arm_index.usize()].body, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)
                                EmitStatus.Declined return if mo_null_status == EmitStatus.Declined
                                branch_if_open(mo_null_status, builder, mo_done_block)
                                LLVMPositionBuilderAtEnd(builder, mo_done_block)
                                return EmitStatus.Open
                            return EmitStatus.Declined
                # The GENERAL optional match: a literal `null` arm plus any number of arms that
                # match the PAYLOAD (`null:` / `Expr.Int(value):` / `_:`). The two-arm
                # null/binding split above stays as it is -- it is the shape the std's index
                # maps use and it is proven -- and this catches everything else.
                #
                # Rather than grow a second pattern-matching engine, the payload is bound to a
                # synthetic local and the REMAINING arms are re-entered as an ordinary match on
                # it. Every payload pattern the match emitter already models therefore works
                # here unchanged; the same trick the `return match` route uses.
                if match_opt_type.kind == TypeKind.Optional and stmt_match_arms.count >= 2:
                    gmo_null_index: mutable i64 = -1
                    for gmo_i in 0..<stmt_match_arms.count |gmo_null_index, stmt_match_arms|:
                        if stmt_match_arms[gmo_i].pattern is Pattern.Literal(gmo_lit):
                            gmo_null_index <- gmo_i.i64() if gmo_lit == "null" and gmo_null_index < 0
                    if gmo_null_index >= 0:
                        EmitStatus.Declined return if not (stmt_match_arms[gmo_null_index.usize()].guard is Expr.Absent)
                        gmo_payload_type: ValueType = optional_payload_of(match_opt_type, structs)
                        EmitStatus.Declined return if gmo_payload_type.kind == TypeKind.Unmodeled
                        gmo_rest: mutable darray[MatchArm] = []
                        for gmo_j in 0..<stmt_match_arms.count |gmo_rest, gmo_null_index, stmt_match_arms|:
                            gmo_rest.push(stmt_match_arms[gmo_j]) if gmo_j.i64() != gmo_null_index
                        EmitStatus.Declined return if gmo_rest.count == 0
                        if emit_expression(stmt_match_scrutinee, match_opt_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is gmo_value:
                            gmo_tag: LLVMValueRef = optional_tag_of(gmo_value, match_opt_type, structs, ctx, builder)
                            gmo_payload: LLVMValueRef = optional_payload_value_of(gmo_value, match_opt_type, structs, ctx, builder)
                            gmo_function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                            gmo_present: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, gmo_function, "match.optn.present")
                            gmo_absent: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, gmo_function, "match.optn.absent")
                            gmo_done: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, gmo_function, "match.optn.done")
                            _ = LLVMBuildCondBr(builder, gmo_tag, gmo_present, gmo_absent)
                            LLVMPositionBuilderAtEnd(builder, gmo_absent)
                            gmo_null_status: EmitStatus = emit_statements_scoped(stmt_match_arms[gmo_null_index.usize()].body, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)
                            EmitStatus.Declined return if gmo_null_status == EmitStatus.Declined
                            branch_if_open(gmo_null_status, builder, gmo_done)
                            LLVMPositionBuilderAtEnd(builder, gmo_present)
                            gmo_storage: mutable darray[u8] = []
                            gmo_slot: LLVMValueRef = build_entry_alloca(builder, llvm_type_of(gmo_payload_type, structs, ctx), sview_to_cstr("__match_opt", gmo_storage))
                            _ = LLVMBuildStore(builder, gmo_payload, gmo_slot)
                            gmo_mark: usize = scope_mark(local_scope)
                            declare_local(local_scope, "__match_opt", gmo_slot, gmo_payload_type)
                            gmo_inner_status: EmitStatus = emit_statement((Stmt.Match((Expr.Ident("__match_opt", stmt_match_line)), gmo_rest, stmt_match_line)), return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)
                            scope_restore(local_scope, gmo_mark)
                            EmitStatus.Declined return if gmo_inner_status == EmitStatus.Declined
                            branch_if_open(gmo_inner_status, builder, gmo_done)
                            LLVMPositionBuilderAtEnd(builder, gmo_done)
                            return EmitStatus.Open
                        return EmitStatus.Declined
                if stmt_match_scrutinee is Expr.Call(smc_callee, smc_args, smc_arg_names, smc_call_line):
                    if smc_callee is Expr.Ident(smc_name, smc_name_line):
                        # A NON-ERROR callee is not a `catch` at all — fall THROUGH to the
                        # ordinary scrutinee paths below, where a call returning a packed AST
                        # node is matched like any other packed value. Returning Declined here
                        # made `match where_predicate_of_type(t):` unreachable: those are the
                        # only two call-scrutinee matches in the semantic layer and both died
                        # on this line, never reaching the packed path.
                        if error_callee_is(fns, generics, smc_name):
                            smc_value_type: ValueType = error_callee_value_type(smc_name, smc_args, local_scope, fns, structs, generics)
                            EmitStatus.Declined return if smc_value_type.kind == TypeKind.Unmodeled
                            if error_callee_target(smc_name, smc_args, local_scope, fns, structs, generics, m, ctx) is smc_target:
                                smc_value_llvm: LLVMTypeRef = llvm_type_of(smc_value_type, structs, ctx)
                                smc_out_slot: LLVMValueRef = LLVMBuildAlloca(builder, smc_value_llvm, "catch.out")
                                smc_call_args: mutable darray[LLVMValueRef] = [smc_out_slot]
                                smc_declined: mutable bool = false
                                smc_arg_index: mutable usize = 0
                                for smc_arg in smc_args |smc_call_args, smc_declined, smc_arg_index, smc_name, local_scope, fns, structs, generics, runtime, m, ctx, builder|:
                                    if emit_expression(smc_arg, error_callee_param_type(smc_name, smc_args, smc_arg_index, local_scope, fns, structs, generics), local_scope, fns, structs, generics, runtime, m, ctx, builder) is smc_arg_value:
                                        smc_call_args.push(smc_arg_value)
                                    else:
                                        smc_declined <- true
                                    smc_arg_index <- smc_arg_index + 1
                                EmitStatus.Declined return if smc_declined
                                smc_call_args.push(call_site_arena(smc_args, local_scope, runtime)) if error_callee_wants_arena(smc_name, smc_args, local_scope, fns, structs, generics)
                                smc_fn_type: LLVMTypeRef = LLVMGlobalGetValueType(smc_target)
                                smc_args_pointer: void& = (&smc_call_args[0]).cast[void&] can Unsafe.PointerCast
                                smc_call_value: LLVMValueRef = LLVMBuildCall2(builder, smc_fn_type, smc_target, smc_args_pointer, smc_call_args.count.u32(), "catch.code")
                                # See the matching note in codegen_expr_literals: a payload-carrying
                                # error set returns the `%ErrSet__E` struct, whose field 0 is the code.
                                smc_code: LLVMValueRef = LLVMBuildExtractValue(builder, smc_call_value, 0, "errset.code") if function_returns_error_struct(fns, structs, "", smc_name) else smc_call_value
                                function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                                smc_value_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "catch.value")
                                smc_dispatch_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "catch.dispatch")
                                smc_done_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "catch.done")
                                smc_ok: LLVMValueRef = LLVMBuildICmp(builder, 32, smc_code, LLVMConstInt(LLVMInt32TypeInContext(ctx), 0, 0), "catch.ok")
                                _ = LLVMBuildCondBr(builder, smc_ok, smc_value_block, smc_dispatch_block)

                                LLVMPositionBuilderAtEnd(builder, smc_value_block)
                                smc_success: MatchArm = stmt_match_arms[0]
                                EmitStatus.Declined return if arm_has_guard(smc_success.guard)
                                if smc_success.pattern is Pattern.Binding(smc_success_binding):
                                    declare_local(local_scope, smc_success_binding, smc_out_slot, smc_value_type)
                                smc_any_open: mutable bool = false
                                smc_success_status: EmitStatus = emit_statements_scoped(smc_success.body, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)
                                EmitStatus.Declined return if smc_success_status == EmitStatus.Declined
                                smc_any_open <- true if smc_success_status == EmitStatus.Open
                                branch_if_open(smc_success_status, builder, smc_done_block)

                                LLVMPositionBuilderAtEnd(builder, smc_dispatch_block)
                                smc_arm_index: mutable usize = 1
                                smc_error_declined: mutable bool = false
                                smc_saw_catch_all: mutable bool = false
                                while smc_arm_index < stmt_match_arms.count |smc_arm_index, smc_error_declined, smc_saw_catch_all, smc_any_open, stmt_match_arms, smc_code, smc_done_block, return_type, function, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder|:
                                    smc_arm: MatchArm = stmt_match_arms[smc_arm_index]
                                    smc_arm_index <- smc_arm_index + 1
                                    continue if smc_error_declined or smc_saw_catch_all
                                    if arm_has_guard(smc_arm.guard):
                                        smc_error_declined <- true
                                        continue
                                    # `error e:` (TypeBind) and `_` are both the CATCH-ALL: run
                                    # the body in the current dispatch block. The binder is NOT
                                    # declared — a body that reads `e` declines on the unknown
                                    # ident rather than seeing a wrong value.
                                    smc_is_catch_all: mutable bool = false
                                    if smc_arm.pattern is Pattern.Wildcard:
                                        smc_is_catch_all <- true
                                    if smc_arm.pattern is Pattern.TypeBind(smc_type_name, smc_binder):
                                        smc_is_catch_all <- true if smc_type_name == "error"
                                    if smc_is_catch_all:
                                        smc_all_status: EmitStatus = emit_statements_scoped(smc_arm.body, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)
                                        if smc_all_status == EmitStatus.Declined:
                                            smc_error_declined <- true
                                            continue
                                        smc_any_open <- true if smc_all_status == EmitStatus.Open
                                        branch_if_open(smc_all_status, builder, smc_done_block)
                                        smc_saw_catch_all <- true
                                        continue
                                    if smc_arm.pattern is Pattern.Variant(smc_path, smc_fields):
                                        if smc_fields.count != 0:
                                            smc_error_declined <- true
                                            continue
                                        smc_ordinal: mutable i64 = penum_variant_index_of_path(smc_path, structs)
                                        if smc_ordinal < 0:
                                            smc_ordinal <- ordinal_of_dotted_path(smc_path, structs)
                                        if smc_ordinal < 0:
                                            smc_error_declined <- true
                                            continue
                                        smc_arm_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "catch.arm")
                                        smc_next_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "catch.next")
                                        smc_hit: LLVMValueRef = LLVMBuildICmp(builder, 32, smc_code, LLVMConstInt(LLVMInt32TypeInContext(ctx), (smc_ordinal + 1).u64(), 0), "catch.cmp")
                                        _ = LLVMBuildCondBr(builder, smc_hit, smc_arm_block, smc_next_block)
                                        LLVMPositionBuilderAtEnd(builder, smc_arm_block)
                                        smc_arm_status: EmitStatus = emit_statements_scoped(smc_arm.body, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)
                                        if smc_arm_status == EmitStatus.Declined:
                                            smc_error_declined <- true
                                            continue
                                        smc_any_open <- true if smc_arm_status == EmitStatus.Open
                                        branch_if_open(smc_arm_status, builder, smc_done_block)
                                        LLVMPositionBuilderAtEnd(builder, smc_next_block)
                                        continue
                                    smc_error_declined <- true
                                EmitStatus.Declined return if smc_error_declined
                                if not smc_saw_catch_all:
                                    _ = LLVMBuildUnreachable(builder)
                                LLVMPositionBuilderAtEnd(builder, smc_done_block)
                                # Every arm returned: the done block has no predecessors, so the
                                # whole catch is a TERMINATOR (terminate the dead block too).
                                if not smc_any_open:
                                    _ = LLVMBuildUnreachable(builder)
                                    return EmitStatus.Terminated
                                return EmitStatus.Open
                # A `match SCRUTINEE:` STATEMENT over a PACKED AST node (Expr/Stmt/Decl/Pattern over
                # the Node store) — mirrors emit_expression's packed arm reads but with STATEMENT arm
                # bodies. Handles `T.Variant(binders):` and `T.A(b)|T.B(b):` (OR, same payload layout)
                # and `_`; binders may be Binding or Wildcard; guards supported; AST-root only.
                spm_type: ValueType = resolve_type(stmt_match_scrutinee, ValueType{kind: TypeKind.Signed, bits: 64}, local_scope, fns, structs, generics)
                # The AoS profile (`packed_mode == 2`) reads a ROW POINTER and GEPs the tag out
                # of it; the DEFAULT variant-sparse profile (mode 0, what a user `packed enum`
                # gets without a `@profile`) reads the tag through
                # `ctx_packed_store_read_variant_sparse_tag` and each payload word through
                # `ctx_packed_store_read_variant_sparse_word`. Both runtime entry points are
                # already declared, and the match EXPRESSION emitter already uses them -- only
                # this STATEMENT path was mode-2 only, which is why a default-profile packed
                # match declined while the same store and `new` compiled.
                # The INDEX profile (`@packed_profile(retained_reads)`, mode 1) was excluded
                # here, so every statement match over one declined — the word reads above now
                # carry its four-argument shape, so it goes through the same path.
                #
                # A common-carrying INDEX enum used to decline here. stage0 keeps the commons in
                # a SIDE table (`ctx_packed_store_read_side_word`) and starts the payload at
                # `1 + inlineCommons`, where stage1 stores every common inline and starts the
                # payload at `1 + commons`. That difference is NOT observable -- a store never
                # crosses compilers, and stage1's writer, row type and row STRIDE already agree
                # on the inline layout -- so it was never the reason this declined.
                #
                # The real cause was an ARITY bug at the common-field read in
                # codegen_expr_index_fields: it emitted the variant-sparse three-argument call
                # against the index profile's four-parameter reader. That is what produced the
                # 139-vs-28 segfault twice, and it is fixed at that site.
                spm_mode_ok: bool = runtime.packed_mode == 2 or runtime.packed_mode == 0 or runtime.packed_mode == 1
                if spm_type.kind == TypeKind.PackedEnum and spm_mode_ok:
                    spm_root: i64 = packed_root_index_of(structs, spm_type.bits.i64())
                    EmitStatus.Declined return if runtime.active_store_enum != spm_root
                    EmitStatus.Declined return if not packed_is_ast_root(structs, spm_root)
                    if emit_expression(stmt_match_scrutinee, spm_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is spm_index_value:
                        spm_function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                        spm_state: LLVMValueRef = LLVMBuildExtractValue(builder, runtime.active_store, 2, "spm.state")
                        # The INDEX profile's word reader takes the arena as a leading argument
                        # (`ctx_packed_store_read_index_word(arena, index, state, word)`), where
                        # the variant-sparse one takes three. Every word read below picks its
                        # shape from the mode; without this the statement match emitted a
                        # three-argument call against a four-argument declaration, so EVERY
                        # `@packed_profile(retained_reads)` enum with a payload declined.
                        spm_arena: LLVMValueRef = LLVMBuildExtractValue(builder, runtime.active_store, 0, "spm.arena")
                        spm_row_type: LLVMTypeRef = packed_row_llvm_type(structs, spm_type.bits.i64(), ctx)
                        spm_record: mutable LLVMValueRef = zeroed
                        spm_tag: mutable LLVMValueRef = zeroed
                        if runtime.packed_mode == 2:
                            spm_index64: LLVMValueRef = LLVMBuildZExt(builder, spm_index_value, LLVMInt64TypeInContext(ctx), "spm.index")
                            spm_record_args: mutable darray[LLVMValueRef] = [spm_state, spm_index64]
                            spm_record_pointer: void& = (&spm_record_args[0]).cast[void&] can Unsafe.PointerCast
                            spm_record <- LLVMBuildCall2(builder, runtime.packed_read_word_type, runtime.packed_read_word, spm_record_pointer, 2, "spm.record")
                            spm_tag_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, spm_row_type, spm_record, 0, "spm.tag.ptr")
                            spm_tag <- LLVMBuildLoad2(builder, LLVMInt32TypeInContext(ctx), spm_tag_pointer, "spm.tag")
                        else:
                            spm_tag_args: mutable darray[LLVMValueRef] = [spm_state, spm_index_value]
                            spm_tag_call_pointer: void& = (&spm_tag_args[0]).cast[void&] can Unsafe.PointerCast
                            spm_tag <- LLVMBuildCall2(builder, runtime.packed_read_tag_type, runtime.packed_read_tag, spm_tag_call_pointer, 2, "packed.tag.store")
                        spm_done: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, spm_function, "spm.done")
                        spm_declined: mutable bool = false
                        spm_saw_default: mutable bool = false
                        spm_any_open: mutable bool = false
                        # An OR-arm whose alternatives have DIFFERENT payload layouts
                        # (`Expr.Unary(op, operand, line) | Expr.Paren(operand, line)`) cannot
                        # share one bind: each alternative holds `operand` at its own index, so
                        # binding them all from the first alternative's offsets would read the
                        # WRONG FIELD. Rather than restructure the arm CFG, EXPAND such an arm
                        # into one single-variant arm per alternative, all sharing the body —
                        # the per-variant path below already binds each correctly, and a match
                        # tests arms in order, so N sequential tests are equivalent to one
                        # OR'd test. Only the differing-layout case is expanded; a same-layout
                        # OR-arm keeps its existing single shared test, unchanged.
                        spm_arms: mutable darray[MatchArm] = []
                        for spm_src_arm in stmt_match_arms |spm_arms, structs|:
                            spm_expanded: mutable bool = false
                            if spm_src_arm.pattern is Pattern.Or(spm_pre_opts):
                                spm_pre_ok: mutable bool = spm_pre_opts.count > 0
                                spm_pre_differ: mutable bool = false
                                spm_pre_ref: mutable i64 = -1
                                for spm_pre_opt in spm_pre_opts |spm_pre_ok, spm_pre_differ, spm_pre_ref, structs|:
                                    if spm_pre_opt is Pattern.Variant(spm_pre_path, spm_pre_fields):
                                        spm_pre_slot: i64 = packed_slot_of_path(spm_pre_path, structs)
                                        if spm_pre_slot < 0:
                                            spm_pre_ok <- false
                                        elif spm_pre_ref < 0:
                                            spm_pre_ref <- spm_pre_slot
                                        else:
                                            spm_pre_differ <- true if not packed_slots_same_field_layout(spm_pre_ref, spm_pre_slot, structs)
                                    else:
                                        spm_pre_ok <- false
                                if spm_pre_ok and spm_pre_differ:
                                    spm_arms.extend([MatchArm{pattern: spm_pre_opt2, body: spm_src_arm.body, guard: spm_src_arm.guard} for spm_pre_opt2 in spm_pre_opts])
                                    spm_expanded <- true
                            spm_arms.push(spm_src_arm) if not spm_expanded
                        for spm_arm in spm_arms |spm_declined, spm_saw_default, spm_any_open, spm_type, spm_record, spm_row_type, spm_tag, spm_function, spm_done, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder|:
                            continue if spm_declined or spm_saw_default
                            if arm_has_guard(spm_arm.guard) and is_catch_all_pattern(spm_arm.pattern):
                                spm_declined <- true
                                continue
                            spm_arm_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, spm_function, "spm.arm")
                            if is_catch_all_pattern(spm_arm.pattern):
                                _ = LLVMBuildBr(builder, spm_arm_block)
                                LLVMPositionBuilderAtEnd(builder, spm_arm_block)
                                spm_default_status: EmitStatus = emit_statements_scoped(spm_arm.body, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)
                                spm_declined <- true if spm_default_status == EmitStatus.Declined
                                spm_any_open <- true if spm_default_status == EmitStatus.Open
                                branch_if_open(spm_default_status, builder, spm_done)
                                spm_saw_default <- true if spm_default_status != EmitStatus.Declined
                                continue
                            spm_ordinals: mutable darray[i64] = []
                            spm_slot: mutable i64 = -1
                            spm_fields: mutable darray[Pattern] = []
                            spm_arm_ok: mutable bool = false
                            # `Expr.Unary(op, operand, line) as whole:` — docs/122 §5.4
                            # as-binding on a packed-AST-node variant arm. The parser only ever
                            # wraps a single Variant (never an Or) in Pattern.As, so unwrapping
                            # it here — before the single-variant classification below — and
                            # leaving the Or-arm classification on the ORIGINAL `spm_arm.pattern`
                            # (which then simply never matches Pattern.Or for an As-wrapped arm,
                            # same as today) covers it with no change to the OR/nested-subpattern
                            # paths at all.
                            spm_as_name: mutable sview = ""
                            spm_pattern: mutable Pattern = spm_arm.pattern
                            if spm_arm.pattern is Pattern.As(spm_as_outer_name, spm_as_inner):
                                if spm_as_inner.count == 1 and spm_as_inner[0] is Pattern.Variant(_, _):
                                    spm_as_name <- spm_as_outer_name
                                    spm_pattern <- spm_as_inner[0]
                            if spm_pattern is Pattern.Variant(spm_path, spm_v_fields):
                                spm_v_ord: i64 = packed_variant_index_of_path(spm_path, structs)
                                spm_v_slot: i64 = packed_slot_of_path(spm_path, structs)
                                if spm_v_ord >= 0 and spm_v_slot >= 0:
                                    spm_ordinals.push(spm_v_ord)
                                    spm_slot <- spm_v_slot
                                    spm_fields <- spm_v_fields
                                    spm_arm_ok <- true
                            if spm_arm.pattern is Pattern.Or(spm_or_opts):
                                spm_or_ok: mutable bool = spm_or_opts.count > 0
                                spm_ref_payload: mutable ValueType = unmodeled_type()
                                spm_ref_slot: mutable i64 = -1
                                for spm_opt in spm_or_opts |spm_or_ok, spm_ordinals, spm_slot, spm_fields, spm_ref_payload, spm_ref_slot, structs|:
                                    if spm_opt is Pattern.Variant(spm_opt_path, spm_opt_fields):
                                        spm_opt_ord: i64 = packed_variant_index_of_path(spm_opt_path, structs)
                                        spm_opt_slot: i64 = packed_slot_of_path(spm_opt_path, structs)
                                        if spm_opt_ord < 0 or spm_opt_slot < 0 or not structs.packed_has_payload[spm_opt_slot.usize()]:
                                            spm_or_ok <- false
                                        else:
                                            spm_opt_payload: ValueType = copied_type(structs.packed_payloads[spm_opt_slot.usize()])
                                            if spm_ref_payload.kind == TypeKind.Unmodeled:
                                                spm_ref_payload <- spm_opt_payload
                                                spm_ref_slot <- spm_opt_slot
                                                spm_slot <- spm_opt_slot
                                                spm_fields <- spm_opt_fields
                                            else:
                                                spm_or_ok <- false if not packed_slots_same_field_layout(spm_ref_slot, spm_opt_slot, structs)
                                            spm_ordinals.push(spm_opt_ord)
                                    else:
                                        spm_or_ok <- false
                                spm_arm_ok <- true if spm_or_ok and spm_slot >= 0
                            if not spm_arm_ok:
                                spm_declined <- true
                                continue
                            if true:
                                # A payload field may itself be a VARIANT pattern
                                # (`Expr.Call(Expr.Ident(name, line), args, names, line)`).
                                # Permitted only in the multi-field shape, which is every
                                # occurrence in the semantic layer; a nested pattern in a
                                # single-field payload still declines.
                                spm_has_nested: mutable bool = false
                                spm_all_binders: mutable bool = true
                                for spm_bf in spm_fields |spm_all_binders, spm_has_nested|:
                                    if spm_bf is Pattern.Variant(spm_bf_path, spm_bf_sub):
                                        spm_has_nested <- true
                                    # A string LITERAL sub-pattern — `Stmt.Block("region", clause,
                                    # binding, body, line)`, how the region walkers select one block
                                    # kind. The field is an sview and the test is a content compare,
                                    # emitted with the nested tests below.
                                    elif spm_bf is Pattern.Literal(spm_bf_lit):
                                        spm_has_nested <- true
                                    # A LABELLED binder (`Both(left: left, right: right)`) is a
                                    # Field wrapping a Binding. It binds exactly like the bare
                                    # spelling -- only the ORDER is given by the label instead
                                    # of by position, which the payload read resolves.
                                    elif spm_bf is Pattern.Field(spm_bf_label, spm_bf_inner):
                                        spm_all_binders <- false if not (spm_bf_inner.count == 1 and spm_bf_inner[0] is Pattern.Binding(spm_bf_sub))
                                    elif not (spm_bf is Pattern.Binding(spm_bf_name)) and not (spm_bf is Pattern.Wildcard):
                                        spm_all_binders <- false
                                # A NESTED variant in a SINGLE-field payload
                                # (`Expr.Wrap(inner: Expr.Lit(value: v))`) is now lowered below:
                                # the payload IS the child's handle, so its tag is read from the
                                # store exactly as the outer tag was and compared against the
                                # nested variant's ordinal. Only the labelled spelling and only
                                # when the field is itself a packed node; anything else still
                                # declines rather than binding without testing.
                                spm_nested_single: mutable bool = false
                                if spm_fields.count == 1:
                                    if spm_fields[0] is Pattern.Field(spm_ns_label, spm_ns_inner):
                                        if spm_ns_inner.count == 1 and spm_ns_inner[0] is Pattern.Variant(spm_ns_path, spm_ns_sub):
                                            spm_nested_single <- true
                                spm_all_binders <- true if spm_nested_single
                                spm_all_binders <- false if spm_has_nested and spm_fields.count <= 1 and not spm_nested_single
                                if not spm_all_binders:
                                    spm_declined <- true
                                    continue
                                spm_next_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, spm_function, "spm.next")
                                spm_hit: mutable LLVMValueRef = zeroed
                                spm_hit_first: mutable bool = true
                                for spm_ord in spm_ordinals |spm_hit, spm_hit_first, spm_tag, ctx, builder|:
                                    spm_cmp: LLVMValueRef = LLVMBuildICmp(builder, 32, spm_tag, LLVMConstInt(LLVMInt32TypeInContext(ctx), spm_ord.u64(), 0), "spm.cmp")
                                    if spm_hit_first:
                                        spm_hit <- spm_cmp
                                        spm_hit_first <- false
                                    else:
                                        spm_hit <- LLVMBuildOr(builder, spm_hit, spm_cmp, "spm.or")
                                _ = LLVMBuildCondBr(builder, spm_hit, spm_arm_block, spm_next_block)
                                LLVMPositionBuilderAtEnd(builder, spm_arm_block)
                                if spm_as_name != "":
                                    spm_whole_slot: LLVMValueRef = LLVMBuildAlloca(builder, llvm_type_of(spm_type, structs, ctx), "spm.whole")
                                    _ = LLVMBuildStore(builder, spm_index_value, spm_whole_slot)
                                    declare_local(local_scope, spm_as_name, spm_whole_slot, spm_type)
                                if spm_fields.count > 0 and structs.packed_has_payload[spm_slot.usize()]:
                                    spm_payload: ValueType = copied_type(structs.packed_payloads[spm_slot.usize()])
                                    if spm_payload.kind == TypeKind.Unmodeled:
                                        spm_declined <- true
                                    else:
                                        spm_payload_value: mutable LLVMValueRef = zeroed
                                        if runtime.packed_mode == 2:
                                            # The AoS row is `{i32 tag, <commons x i64>, [N x i64] payload}`,
                                            # so the payload sits at `1 + commons`, not at 1. With a
                                            # common declared, index 1 IS the common: `Expr.Int(value: 3)`
                                            # with `span: 7` read back 7 for `value` -- a silent wrong
                                            # answer (77 where stage0 says 37), not a decline.
                                            spm_aos_commons: u32 = structs.packed_common_counts[spm_type.bits.usize()]
                                            spm_payload_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, spm_row_type, spm_record, (1 + spm_aos_commons), "spm.payload.ptr")
                                            spm_payload_value <- LLVMBuildLoad2(builder, llvm_type_of(spm_payload, structs, ctx), spm_payload_pointer, "spm.payload")
                                        elif spm_fields.count > 1:
                                            # A MULTI-FIELD payload is read field by field
                                            # below; the single-word read here would try to
                                            # convert one i64 into the whole payload STRUCT and
                                            # decline before that ran.
                                            pass
                                        else:
                                            # Word 0 is the tag and words 1..commons are the
                                            # common fields, so the first payload word is
                                            # `1 + commons` -- the same index the expression
                                            # emitter uses.
                                            spm_commons: u32 = structs.packed_common_counts[spm_type.bits.usize()]
                                            spm_word_args: mutable darray[LLVMValueRef] = [spm_index_value, spm_state, LLVMConstInt(LLVMInt64TypeInContext(ctx), (1 + spm_commons).u64(), 0)]
                                            spm_word_args <- [spm_arena, spm_index_value, spm_state, LLVMConstInt(LLVMInt64TypeInContext(ctx), (1 + spm_commons).u64(), 0)] if runtime.packed_mode == 1
                                            spm_word_pointer: void& = (&spm_word_args[0]).cast[void&] can Unsafe.PointerCast
                                            spm_payload_word: LLVMValueRef = LLVMBuildCall2(builder, runtime.packed_read_word_type, runtime.packed_read_word, spm_word_pointer, spm_word_args.count.u32(), "packed.word")
                                            if spm_payload.kind == TypeKind.PackedEnum:
                                                # A payload that is ITSELF a node (`Wrap(child: Expr)`)
                                                # is stored as its i32 handle, so the word is
                                                # truncated rather than converted -- emit_conversion
                                                # models scalars and would decline a PackedEnum
                                                # target, taking the whole arm with it.
                                                spm_payload_value <- LLVMBuildTrunc(builder, spm_payload_word, LLVMInt32TypeInContext(ctx), "packed.child.handle")
                                            elif emit_conversion(spm_payload_word, ValueType{kind: TypeKind.Signed, bits: 64}, spm_payload, structs, ctx, builder) is spm_payload_converted:
                                                spm_payload_value <- spm_payload_converted
                                            else:
                                                spm_declined <- true
                                        spm_field_start: usize = structs.packed_field_type_start[spm_slot.usize()]
                                        # MULTI-FIELD payload under the variant-sparse profile:
                                        # each field is its OWN word, at `1 + commons + i`. The
                                        # AoS profile keeps one aggregate load and extracts, so
                                        # only mode 0 needs the per-field reads. A binder may be
                                        # LABELLED (`Both(left: left, right: right)`), which
                                        # arrives as Pattern.Field -- resolved to its declared
                                        # index so the word read matches the binder.
                                        if runtime.packed_mode != 2 and spm_fields.count > 1 and not spm_declined:
                                            spm_mf_commons: u32 = structs.packed_common_counts[spm_type.bits.usize()]
                                            spm_mf_count: usize = structs.packed_field_type_count[spm_slot.usize()]
                                            for spm_mf_index in 0..<spm_fields.count |spm_declined, spm_fields, spm_field_start, spm_mf_commons, spm_mf_count, spm_slot, spm_index_value, spm_state, structs, local_scope, runtime, ctx, builder|:
                                                spm_mf_name: mutable sview = ""
                                                spm_mf_position: mutable usize = spm_mf_index
                                                if spm_fields[spm_mf_index] is Pattern.Binding(spm_mf_bound):
                                                    spm_mf_name <- spm_mf_bound
                                                if spm_fields[spm_mf_index] is Pattern.Field(spm_mf_label, spm_mf_inner):
                                                    spm_mf_found: mutable i64 = -1
                                                    for spm_mf_probe in 0..<spm_mf_count |spm_mf_found, spm_mf_label, spm_field_start, structs|:
                                                        spm_mf_found <- spm_mf_probe.i64() if structs.packed_field_flat_names[spm_field_start + spm_mf_probe] == spm_mf_label
                                                    if spm_mf_found < 0 or spm_mf_inner.count != 1:
                                                        spm_declined <- true
                                                    else:
                                                        spm_mf_position <- spm_mf_found.usize()
                                                        spm_mf_name <- spm_mf_sub if spm_mf_inner[0] is Pattern.Binding(spm_mf_sub) else ""
                                                continue if spm_mf_name == "" or spm_declined
                                                spm_mf_type: ValueType = copied_type(structs.packed_field_types[spm_field_start + spm_mf_position])
                                                spm_mf_args: mutable darray[LLVMValueRef] = [spm_index_value, spm_state, LLVMConstInt(LLVMInt64TypeInContext(ctx), (1 + spm_mf_commons).u64() + spm_mf_position.u64(), 0)]
                                                spm_mf_args <- [spm_arena, spm_index_value, spm_state, LLVMConstInt(LLVMInt64TypeInContext(ctx), (1 + spm_mf_commons).u64() + spm_mf_position.u64(), 0)] if runtime.packed_mode == 1
                                                spm_mf_pointer: void& = (&spm_mf_args[0]).cast[void&] can Unsafe.PointerCast
                                                spm_mf_word: LLVMValueRef = LLVMBuildCall2(builder, runtime.packed_read_word_type, runtime.packed_read_word, spm_mf_pointer, spm_mf_args.count.u32(), "packed.word")
                                                # A payload field that is ITSELF a node (`Add(left: Expr,
                                                # right: Expr)`) is stored as its i32 handle. emit_conversion
                                                # models scalars and declines a PackedEnum target, taking the
                                                # whole arm with it -- so the recursive shape stage0's own
                                                # packed programs use could bind nothing.
                                                if spm_mf_type.kind == TypeKind.PackedEnum:
                                                    spm_mf_handle: LLVMValueRef = LLVMBuildTrunc(builder, spm_mf_word, LLVMInt32TypeInContext(ctx), "packed.field.handle")
                                                    spm_mf_hstorage: mutable darray[u8] = []
                                                    spm_mf_hslot: LLVMValueRef = LLVMBuildAlloca(builder, llvm_type_of(spm_mf_type, structs, ctx), sview_to_cstr(spm_mf_name, spm_mf_hstorage))
                                                    _ = LLVMBuildStore(builder, spm_mf_handle, spm_mf_hslot)
                                                    declare_local(local_scope, spm_mf_name, spm_mf_hslot, spm_mf_type)
                                                elif emit_conversion(spm_mf_word, ValueType{kind: TypeKind.Signed, bits: 64}, spm_mf_type, structs, ctx, builder) is spm_mf_value:
                                                    spm_mf_storage: mutable darray[u8] = []
                                                    spm_mf_slot: LLVMValueRef = LLVMBuildAlloca(builder, llvm_type_of(spm_mf_type, structs, ctx), sview_to_cstr(spm_mf_name, spm_mf_storage))
                                                    _ = LLVMBuildStore(builder, spm_mf_value, spm_mf_slot)
                                                    declare_local(local_scope, spm_mf_name, spm_mf_slot, spm_mf_type)
                                                else:
                                                    spm_declined <- true
                                        elif spm_fields.count == 1:
                                            # A single payload field may be written LABELLED
                                            # (`Expr.Int(value: value)`) -- the form stage0's own
                                            # packed test programs use. It arrives as Pattern.Field,
                                            # which only the MULTI-field loop above resolved, so the
                                            # binder was never declared and the arm body declined on
                                            # an unknown name. Resolve the label against the single
                                            # declared field and bind its inner name.
                                            spm_single_label: mutable sview = ""
                                            if spm_fields[0] is Pattern.Field(spm_sf_label, spm_sf_inner):
                                                if spm_sf_inner.count == 1 and structs.packed_field_type_count[spm_slot.usize()] == 1.usize() and structs.packed_field_flat_names[spm_field_start] == spm_sf_label:
                                                    spm_single_label <- spm_sf_sub if spm_sf_inner[0] is Pattern.Binding(spm_sf_sub) else ""
                                                # A NESTED sub-pattern has no binder at THIS
                                                # level; it is tested and bound below.
                                                if spm_single_label == "" and not spm_nested_single:
                                                    spm_declined <- true
                                            if spm_single_label != "":
                                                spm_label_storage: mutable darray[u8] = []
                                                spm_label_slot: LLVMValueRef = LLVMBuildAlloca(builder, llvm_type_of(spm_payload, structs, ctx), sview_to_cstr(spm_single_label, spm_label_storage))
                                                _ = LLVMBuildStore(builder, spm_payload_value, spm_label_slot)
                                                declare_local(local_scope, spm_single_label, spm_label_slot, spm_payload)
                                            if spm_fields[0] is Pattern.Binding(spm_single_name):
                                                spm_single_storage: mutable darray[u8] = []
                                                spm_single_slot: LLVMValueRef = LLVMBuildAlloca(builder, llvm_type_of(spm_payload, structs, ctx), sview_to_cstr(spm_single_name, spm_single_storage))
                                                _ = LLVMBuildStore(builder, spm_payload_value, spm_single_slot)
                                                declare_local(local_scope, spm_single_name, spm_single_slot, spm_payload)
                                            # The NESTED sub-pattern: test the child's tag, then
                                            # bind the child's own single field. A miss falls
                                            # through to the next arm, so first-wins order and
                                            # the sibling arms are unaffected.
                                            if spm_nested_single:
                                                if spm_payload.kind != TypeKind.PackedEnum:
                                                    spm_declined <- true
                                                elif spm_fields[0] is Pattern.Field(spm_nn_label, spm_nn_inner):
                                                    if spm_nn_inner[0] is Pattern.Variant(spm_nn_path, spm_nn_sub):
                                                        spm_nn_ordinal: i64 = packed_variant_index_of_path(spm_nn_path, structs)
                                                        spm_nn_slot: i64 = packed_slot_of_path(spm_nn_path, structs)
                                                        if spm_nn_ordinal < 0 or spm_nn_slot < 0 or spm_nn_sub.count > 1.usize():
                                                            spm_declined <- true
                                                        else:
                                                            spm_nn_enum: usize = spm_payload.bits.usize()
                                                            spm_nn_commons: u32 = structs.packed_common_counts[spm_nn_enum]
                                                            spm_nn_row: LLVMTypeRef = packed_row_llvm_type(structs, spm_nn_enum.i64(), ctx)
                                                            spm_nn_tag: mutable LLVMValueRef = zeroed
                                                            spm_nn_record: mutable LLVMValueRef = zeroed
                                                            if runtime.packed_mode == 2:
                                                                spm_nn_index64: LLVMValueRef = LLVMBuildZExt(builder, spm_payload_value, LLVMInt64TypeInContext(ctx), "spm.nn.index")
                                                                spm_nn_record_args: mutable darray[LLVMValueRef] = [spm_state, spm_nn_index64]
                                                                spm_nn_record_pointer: void& = (&spm_nn_record_args[0]).cast[void&] can Unsafe.PointerCast
                                                                spm_nn_record <- LLVMBuildCall2(builder, runtime.packed_read_word_type, runtime.packed_read_word, spm_nn_record_pointer, 2, "spm.nn.record")
                                                                spm_nn_tag <- LLVMBuildLoad2(builder, LLVMInt32TypeInContext(ctx), LLVMBuildStructGEP2(builder, spm_nn_row, spm_nn_record, 0, "spm.nn.tag.ptr"), "spm.nn.tag")
                                                            else:
                                                                spm_nn_tag_args: mutable darray[LLVMValueRef] = [spm_state, spm_payload_value]
                                                                spm_nn_tag_pointer: void& = (&spm_nn_tag_args[0]).cast[void&] can Unsafe.PointerCast
                                                                spm_nn_tag <- LLVMBuildCall2(builder, runtime.packed_read_tag_type, runtime.packed_read_tag, spm_nn_tag_pointer, 2, "spm.nn.tag")
                                                            spm_nn_body: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, spm_function, "spm.nested.ok")
                                                            _ = LLVMBuildCondBr(builder, LLVMBuildICmp(builder, 32, spm_nn_tag, LLVMConstInt(LLVMInt32TypeInContext(ctx), spm_nn_ordinal.u64(), 0), "spm.nn.cmp"), spm_nn_body, spm_next_block)
                                                            LLVMPositionBuilderAtEnd(builder, spm_nn_body)
                                                            if spm_nn_sub.count == 1:
                                                                spm_nn_bind: mutable sview = ""
                                                                if spm_nn_sub[0] is Pattern.Binding(spm_nn_bare):
                                                                    spm_nn_bind <- spm_nn_bare
                                                                if spm_nn_sub[0] is Pattern.Field(spm_nn_flabel, spm_nn_finner):
                                                                    spm_nn_bind <- spm_nn_fsub if spm_nn_finner.count == 1 and spm_nn_finner[0] is Pattern.Binding(spm_nn_fsub) else ""
                                                                if spm_nn_bind == "":
                                                                    spm_declined <- true
                                                                else:
                                                                    spm_nn_payload: ValueType = copied_type(structs.packed_payloads[spm_nn_slot.usize()])
                                                                    if spm_nn_payload.kind == TypeKind.Unmodeled:
                                                                        spm_declined <- true
                                                                    else:
                                                                        spm_nn_value: mutable LLVMValueRef = zeroed
                                                                        spm_nn_ok: mutable bool = true
                                                                        if runtime.packed_mode == 2:
                                                                            spm_nn_value <- LLVMBuildLoad2(builder, llvm_type_of(spm_nn_payload, structs, ctx), LLVMBuildStructGEP2(builder, spm_nn_row, spm_nn_record, (1 + spm_nn_commons), "spm.nn.payload.ptr"), "spm.nn.payload")
                                                                        else:
                                                                            spm_nn_word_args: mutable darray[LLVMValueRef] = [spm_payload_value, spm_state, LLVMConstInt(LLVMInt64TypeInContext(ctx), (1 + spm_nn_commons).u64(), 0)]
                                                                            spm_nn_word_args <- [spm_arena, spm_payload_value, spm_state, LLVMConstInt(LLVMInt64TypeInContext(ctx), (1 + spm_nn_commons).u64(), 0)] if runtime.packed_mode == 1
                                                                            spm_nn_word_pointer: void& = (&spm_nn_word_args[0]).cast[void&] can Unsafe.PointerCast
                                                                            spm_nn_word: LLVMValueRef = LLVMBuildCall2(builder, runtime.packed_read_word_type, runtime.packed_read_word, spm_nn_word_pointer, spm_nn_word_args.count.u32(), "spm.nn.word")
                                                                            if spm_nn_payload.kind == TypeKind.PackedEnum:
                                                                                spm_nn_value <- LLVMBuildTrunc(builder, spm_nn_word, LLVMInt32TypeInContext(ctx), "spm.nn.handle")
                                                                            elif emit_conversion(spm_nn_word, ValueType{kind: TypeKind.Signed, bits: 64}, spm_nn_payload, structs, ctx, builder) is spm_nn_converted:
                                                                                spm_nn_value <- spm_nn_converted
                                                                            else:
                                                                                spm_nn_ok <- false
                                                                        if spm_nn_ok:
                                                                            spm_nn_storage: mutable darray[u8] = []
                                                                            spm_nn_slot_alloca: LLVMValueRef = LLVMBuildAlloca(builder, llvm_type_of(spm_nn_payload, structs, ctx), sview_to_cstr(spm_nn_bind, spm_nn_storage))
                                                                            _ = LLVMBuildStore(builder, spm_nn_value, spm_nn_slot_alloca)
                                                                            declare_local(local_scope, spm_nn_bind, spm_nn_slot_alloca, spm_nn_payload)
                                                                        else:
                                                                            spm_declined <- true
                                        if spm_fields.count > 1 and runtime.packed_mode == 2:
                                            for spm_bind_index in 0..<spm_fields.count |spm_fields, spm_field_start, spm_payload_value, structs, local_scope, ctx, builder|:
                                                # The binder may be LABELLED (`Add(left: left, right: right)`),
                                                # which arrives as Pattern.Field. Only the word-reading (mode 0)
                                                # loop resolved labels, so under the AoS profile a labelled
                                                # multi-field arm bound NOTHING and the body declined on the
                                                # unknown names.
                                                spm_multi_label: mutable sview = ""
                                                spm_multi_slot_index: mutable usize = spm_bind_index
                                                if spm_fields[spm_bind_index] is Pattern.Field(spm_ml_label, spm_ml_inner):
                                                    if spm_ml_inner.count == 1:
                                                        spm_ml_found: mutable i64 = -1
                                                        for spm_ml_probe in 0..<structs.packed_field_type_count[spm_slot.usize()] |spm_ml_found, spm_ml_label, spm_field_start, structs|:
                                                            spm_ml_found <- spm_ml_probe.i64() if structs.packed_field_flat_names[spm_field_start + spm_ml_probe] == spm_ml_label
                                                        if spm_ml_found >= 0:
                                                            spm_multi_slot_index <- spm_ml_found.usize()
                                                            spm_multi_label <- spm_ml_sub if spm_ml_inner[0] is Pattern.Binding(spm_ml_sub) else ""
                                                if spm_multi_label != "":
                                                    spm_ml_type: ValueType = copied_type(structs.packed_field_types[spm_field_start + spm_multi_slot_index])
                                                    spm_ml_raw: LLVMValueRef = LLVMBuildExtractValue(builder, spm_payload_value, spm_multi_slot_index.u32(), "spm.field")
                                                    spm_ml_value: LLVMValueRef = LLVMBuildTrunc(builder, spm_ml_raw, LLVMInt32TypeInContext(ctx), "packed.field.handle") if spm_ml_type.kind == TypeKind.PackedEnum else spm_ml_raw
                                                    spm_ml_storage: mutable darray[u8] = []
                                                    spm_ml_slot: LLVMValueRef = LLVMBuildAlloca(builder, llvm_type_of(spm_ml_type, structs, ctx), sview_to_cstr(spm_multi_label, spm_ml_storage))
                                                    _ = LLVMBuildStore(builder, spm_ml_value, spm_ml_slot)
                                                    declare_local(local_scope, spm_multi_label, spm_ml_slot, spm_ml_type)
                                                if spm_fields[spm_bind_index] is Pattern.Binding(spm_multi_name):
                                                    spm_multi_type: ValueType = copied_type(structs.packed_field_types[spm_field_start + spm_bind_index])
                                                    spm_multi_raw: LLVMValueRef = LLVMBuildExtractValue(builder, spm_payload_value, spm_bind_index.u32(), "spm.field")
                                                    # Same node-handle narrowing as the word path: the row
                                                    # holds i64 words, a packed handle is i32.
                                                    spm_multi_field: LLVMValueRef = LLVMBuildTrunc(builder, spm_multi_raw, LLVMInt32TypeInContext(ctx), "packed.field.handle") if spm_multi_type.kind == TypeKind.PackedEnum else spm_multi_raw
                                                    spm_multi_storage: mutable darray[u8] = []
                                                    spm_multi_slot: LLVMValueRef = LLVMBuildAlloca(builder, llvm_type_of(spm_multi_type, structs, ctx), sview_to_cstr(spm_multi_name, spm_multi_storage))
                                                    _ = LLVMBuildStore(builder, spm_multi_field, spm_multi_slot)
                                                    declare_local(local_scope, spm_multi_name, spm_multi_slot, spm_multi_type)
                                            # NESTED sub-patterns, after the plain binds. Each one
                                            # reads its sub-node's record, tests that node's tag and
                                            # falls through to spm_next_block on a mismatch — the arm
                                            # only matches when every nested test holds — then binds
                                            # the sub-pattern's own fields from its own payload.
                                            for spm_nest_index in 0..<spm_fields.count |spm_fields, spm_payload_value, spm_declined, spm_function, spm_next_block, spm_field_start, structs, local_scope, runtime, ctx, builder|:
                                                # A string LITERAL sub-pattern: the field is an
                                                # sview and the test is a CONTENT compare through
                                                # the runtime, not a tag read. Same fall-through
                                                # shape as the variant tests below.
                                                if spm_fields[spm_nest_index] is Pattern.Literal(spm_lit_text):
                                                    spm_lit_type: ValueType = copied_type(structs.packed_field_types[spm_field_start + spm_nest_index])
                                                    if spm_lit_type.kind != TypeKind.SView:
                                                        spm_declined <- true
                                                    else:
                                                        spm_lit_field: LLVMValueRef = LLVMBuildExtractValue(builder, spm_payload_value, spm_nest_index.u32(), "spm.nest.lit.field")
                                                        if sview_literal_hit(spm_lit_text, spm_lit_field, spm_lit_type, structs, runtime, ctx, builder) is spm_lit_hit:
                                                            spm_lit_cont: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, spm_function, "spm.nest.lit.cont")
                                                            _ = LLVMBuildCondBr(builder, spm_lit_hit, spm_lit_cont, spm_next_block)
                                                            LLVMPositionBuilderAtEnd(builder, spm_lit_cont)
                                                        else:
                                                            spm_declined <- true
                                                if spm_fields[spm_nest_index] is Pattern.Variant(spm_nest_path, spm_nest_fields):
                                                    # RECURSIVE: also handles a nested variant that
                                                    # itself contains one. The previous inline code
                                                    # bound only Pattern.Binding sub-fields and
                                                    # silently SKIPPED a deeper Variant, leaving its
                                                    # names unbound so the arm body then declined —
                                                    # `Expr.Unary(op, Expr.Field(Expr.Ident(o, l), f, fl), al)`
                                                    # is the shape that needs depth 2.
                                                    spm_nest_handle: LLVMValueRef = LLVMBuildExtractValue(builder, spm_payload_value, spm_nest_index.u32(), "spm.nest.handle")
                                                    # A CONST-ENUM sub-pattern (`Expr.Unary(TokenKind.Minus, …)`)
                                                    # is NOT a packed node: the field holds the variant's ordinal
                                                    # directly, so the test is an integer compare rather than a
                                                    # store read. Payloadless only, and the field's registered
                                                    # type must really be an integer.
                                                    spm_nest_const: i64 = ordinal_of_dotted_path(spm_nest_path, structs)
                                                    if packed_slot_of_path(spm_nest_path, structs) < 0 and spm_nest_const >= 0 and spm_nest_fields.count == 0:
                                                        spm_const_type: ValueType = copied_type(structs.packed_field_types[spm_field_start + spm_nest_index])
                                                        if not is_integer_type(spm_const_type):
                                                            spm_declined <- true
                                                        else:
                                                            spm_const_hit: LLVMValueRef = LLVMBuildICmp(builder, 32, spm_nest_handle, LLVMConstInt(llvm_type_of(spm_const_type, structs, ctx), spm_nest_const.u64(), 0), "spm.nest.const.cmp")
                                                            spm_const_cont: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, spm_function, "spm.nest.const.cont")
                                                            _ = LLVMBuildCondBr(builder, spm_const_hit, spm_const_cont, spm_next_block)
                                                            LLVMPositionBuilderAtEnd(builder, spm_const_cont)
                                                    else:
                                                        spm_declined <- true if not emit_packed_subpattern_test(spm_nest_path, spm_nest_fields, spm_nest_handle, spm_next_block, spm_function, local_scope, structs, runtime, ctx, builder)
                                if not spm_declined and arm_has_guard(spm_arm.guard):
                                    if emit_condition(spm_arm.guard, local_scope, fns, structs, generics, runtime, m, ctx, builder) is spm_guard_bit:
                                        spm_guard_body: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, spm_function, "spm.guard")
                                        _ = LLVMBuildCondBr(builder, spm_guard_bit, spm_guard_body, spm_next_block)
                                        LLVMPositionBuilderAtEnd(builder, spm_guard_body)
                                    else:
                                        spm_declined <- true
                                if spm_declined:
                                    LLVMPositionBuilderAtEnd(builder, spm_next_block)
                                else:
                                    spm_arm_status: EmitStatus = emit_statements_scoped(spm_arm.body, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)
                                    spm_declined <- true if spm_arm_status == EmitStatus.Declined
                                    spm_any_open <- true if spm_arm_status == EmitStatus.Open
                                    branch_if_open(spm_arm_status, builder, spm_done)
                                    LLVMPositionBuilderAtEnd(builder, spm_next_block)
                        EmitStatus.Declined return if spm_declined
                        if not spm_saw_default:
                            _ = LLVMBuildUnreachable(builder)
                        LLVMPositionBuilderAtEnd(builder, spm_done)
                        if not spm_any_open:
                            _ = LLVMBuildUnreachable(builder)
                            return EmitStatus.Terminated
                        return EmitStatus.Open
                    return EmitStatus.Declined

                # A multi-column `when` (an `Expr.Tuple` scrutinee). Checked before the
                # scalar shapes because a tuple has no scalar type at all — resolve_type
                # reports it Unmodeled, which is how the whole construct used to decline.
                match_tuple_handled: mutable bool = false
                match_tuple_status: EmitStatus = emit_statement_match_tuple(stmt_match_scrutinee, stmt_match_arms, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder, match_tuple_handled)
                match_tuple_status return if match_tuple_handled

                # Integer / const-enum / cstr / sview / payload-enum scrutinees — the
                # remaining shapes, split into codegen_stmt_match_scalar.elisa. It returns
                # Declined for a shape it does not model, exactly as this branch's tail did.
                match_scalar_handled: mutable bool = false
                return emit_statement_match_scalar(stmt_match_scrutinee, stmt_match_arms, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder, match_scalar_handled)
            handled <- false
            return EmitStatus.Declined
