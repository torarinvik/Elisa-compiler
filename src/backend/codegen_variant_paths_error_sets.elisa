extend Backend:
    private:
        def penum_path_variant_offset(path: sview, dot: i64, enum_index: i64, structs: mutable StructTable&) -> i64 can[Abort.Panic]:
            start: usize = structs.payload_enums.penum_variant_start[enum_index.usize()]
            count: usize = structs.payload_enums.penum_variant_count[enum_index.usize()]
            fallback: mutable i64 = -1
            for offset in 0..<count |structs, path, dot, start, fallback|:
                slot: usize = start + offset
                continue if not sview_matches_prefix(path, structs.payload_enums.penum_variants[slot], dot + 1, path.len.i64())
                owner_matches: bool = slot < structs.payload_enums.penum_variant_owners.count and ((structs.payload_enums.penum_variant_owners[slot]).len.i64() == dot and sview_matches_prefix(path, structs.payload_enums.penum_variant_owners[slot], 0, dot) or penum_path_owner_leaf_matches(path, dot, structs.payload_enums.penum_variant_owners[slot]))
                return offset.i64() if owner_matches
                fallback <- offset.i64() if fallback < 0
            return fallback




        # Resolve a source variant path in a specific (possibly merged or restricted) error
        # family. Its ordinal is not necessarily the ordinal in the source enum: error
        # unions may reorder and subset variants, and that family-local offset is both the
        # status-code discriminator and the payload-layout slot.
        def penum_variant_offset_in_family(path: sview @source, family_index: i64, structs: mutable StructTable&) -> i64 can[Abort.Panic]:
            return -1 if family_index < 0 or family_index.usize() >= structs.payload_enums.penum_names.count
            dot: mutable i64 = -1
            for index in 0..<path.len |dot, path|:
                dot <- index.i64() if path[index] == 46
            start: usize = structs.payload_enums.penum_variant_start[family_index.usize()]
            count: usize = structs.payload_enums.penum_variant_count[family_index.usize()]
            if dot <= 0:
                found: mutable i64 = -1
                matches: mutable usize = 0
                for offset in 0..<count |found, matches, start, path, structs|:
                    found <- offset.i64() if structs.payload_enums.penum_variants[start + offset] == path
                    matches <- matches + 1 if structs.payload_enums.penum_variants[start + offset] == path
                return found if matches == 1
                return -1
            for offset in 0..<count |structs, path, dot, start|:
                slot: usize = start + offset
                continue if not sview_matches_prefix(path, structs.payload_enums.penum_variants[slot], dot + 1, path.len.i64())
                owner: sview = structs.payload_enums.penum_variant_owners[slot] if slot < structs.payload_enums.penum_variant_owners.count else ""
                module: sview = structs.payload_enums.penum_variant_modules[slot] if slot < structs.payload_enums.penum_variant_modules.count else ""
                return offset.i64() if error_variant_source_matches(path, dot, owner, module, structs)
            return -1




        # The composite error-family registry stores exactly the ordered, restricted variant
        # rows used by the ABI. Resolve both discriminator and payload layout from that row;
        # source enum ordinals are not interchangeable with merged-family tags.
        def error_variant_owner_matches(path: sview, dot: i64, owner: sview) -> bool can[Abort.Panic]:
            return false if owner == "" or dot <= 0
            leaf_start: mutable usize = 0
            for index in 0..<dot.usize() |leaf_start, path|:
                leaf_start <- index + 2.usize() if index + 1.usize() < dot.usize() and path[index] == 58 and path[index + 1.usize()] == 58
                leaf_start <- index + 1.usize() if path[index] == 46
            leaf_length: usize = dot.usize() - leaf_start
            return false if leaf_length != owner.len
            return sview_matches_prefix(path, owner, leaf_start.i64(), dot)


        def error_variant_source_matches(path: sview @source, dot: i64, owner: sview, module: sview, structs: mutable StructTable&) -> bool can[Abort.Panic]:
            return false if dot <= 0 or not error_variant_owner_matches(path, dot, owner)
            payload_index: i64 = penum_path_enum_index(path, dot, structs)
            if payload_index >= 0:
                source_offset: i64 = penum_path_variant_offset(path, dot, payload_index, structs)
                if source_offset >= 0:
                    source_slot: usize = structs.payload_enums.penum_variant_start[payload_index.usize()] + source_offset.usize()
                    return false if source_slot >= structs.payload_enums.penum_variant_owners.count or source_slot >= structs.payload_enums.penum_variant_modules.count
                    return structs.payload_enums.penum_variant_owners[source_slot] == owner and structs.payload_enums.penum_variant_modules[source_slot] == module
            head: Expr = enum_head_of_dotted_variant_path(path, dot.usize())
            return false if head is Expr.Invalid
            variant: sview = path[(dot.usize() + 1.usize()):path.len]
            const_index: i64 = enum_index_of_head(structs, head)
            if const_index >= 0 and enum_ordinal_of(structs, const_index.usize(), variant) >= 0:
                return structs.const_enums.enum_names[const_index.usize()] == owner and enum_owner_at(structs, const_index.usize()) == module
            return variant_qualified_type_matches(path, dot, module, owner, structs) if dot > owner.len.i64()
            return module == "" or error_union_module_is_ancestor(module, structs.visibility.current_owner)




        def error_set_key_is_composite(set_name: sview) -> bool can[Abort.Panic]:
            for index in 0..<set_name.len |set_name|:
                return true if set_name[index] == 44 or set_name[index] == 123 or set_name[index] == 46
            return false




        def error_variant_location(path: sview @source, family: sview, structs: mutable StructTable&) -> ErrorVariantLocation can[Abort.Panic]:
            missing: ErrorVariantLocation = ErrorVariantLocation{ordinal: -1, enum_index: -1, variant_offset: -1, field_base: 1}
            family_index: i64 = penum_index_of(structs, family)
            return missing if family_index < 0
            dot: mutable i64 = -1
            for index in 0..<path.len |dot, path|:
                dot <- index.i64() if path[index] == 46
            return missing if dot <= 0
            variant_start: usize = structs.payload_enums.penum_variant_start[family_index.usize()]
            variant_count: usize = structs.payload_enums.penum_variant_count[family_index.usize()]
            found: mutable i64 = -1
            matches: mutable usize = 0
            for offset in 0..<variant_count |found, matches, variant_start, family_index, path, dot, structs|:
                slot: usize = variant_start + offset
                continue if not sview_matches_prefix(path, structs.payload_enums.penum_variants[slot], dot + 1, path.len.i64())
                owner: sview = structs.payload_enums.penum_variant_owners[slot]
                module: sview = structs.payload_enums.penum_variant_modules[slot] if slot < structs.payload_enums.penum_variant_modules.count else ""
                continue if not error_variant_source_matches(path, dot, owner, module, structs)
                found <- offset.i64()
                matches <- matches + 1
            return missing if matches != 1
            field_base: usize = error_set_variant_field_base(structs, family_index, found.usize())
            return ErrorVariantLocation{ordinal: found, enum_index: family_index, variant_offset: found, field_base: field_base}




        # Raise expressions carry an AST field/call, not the dotted path string used by match
        # patterns. Resolve the head and leaf directly against the same canonical union row.
        def error_variant_location_expr(expression: Expr, family: sview, structs: mutable StructTable&) -> ErrorVariantLocation can[Abort.Panic]:
            missing: ErrorVariantLocation = ErrorVariantLocation{ordinal: -1, enum_index: -1, variant_offset: -1, field_base: 1}
            match expression:
                Expr.Field(enum_head, variant, line):
                    enum_name: sview = enum_head_name(enum_head)
                    family_index: i64 = penum_index_of(structs, family)
                    return missing if family_index < 0 or enum_name == ""
                    source_module: mutable sview = ""
                    source_owner: mutable sview = enum_name
                    source_index: mutable i64 = penum_index_of_head(structs, enum_head)
                    if source_index >= 0:
                        source_offset: i64 = penum_variant_index_owned(structs, source_index, enum_name, variant)
                        return missing if source_offset < 0
                        source_slot: usize = structs.payload_enums.penum_variant_start[source_index.usize()] + source_offset.usize()
                        source_owner <- structs.payload_enums.penum_variant_owners[source_slot] if source_slot < structs.payload_enums.penum_variant_owners.count
                        source_module <- structs.payload_enums.penum_variant_modules[source_slot] if source_slot < structs.payload_enums.penum_variant_modules.count
                    else:
                        source_index <- enum_index_of_head(structs, enum_head)
                        return missing if source_index < 0
                        source_module <- enum_owner_at(structs, source_index.usize())
                    variant_start: usize = structs.payload_enums.penum_variant_start[family_index.usize()]
                    variant_count: usize = structs.payload_enums.penum_variant_count[family_index.usize()]
                    found: mutable i64 = -1
                    matches: mutable usize = 0
                    for offset in 0..<variant_count |found, matches, variant_start, family_index, enum_name, variant, structs|:
                        slot: usize = variant_start + offset
                        continue if structs.payload_enums.penum_variants[slot] != variant
                        continue if structs.payload_enums.penum_variant_owners[slot] != source_owner
                        continue if slot >= structs.payload_enums.penum_variant_modules.count or structs.payload_enums.penum_variant_modules[slot] != source_module
                        found <- offset.i64()
                        matches <- matches + 1
                    return missing if matches != 1
                    field_base: usize = error_set_variant_field_base(structs, family_index, found.usize())
                    return ErrorVariantLocation{ordinal: found, enum_index: family_index, variant_offset: found, field_base: field_base}
                _:
                    pass
            return missing



        def penum_variant_index_of_path(path: sview, structs: mutable StructTable&) -> i64 can[Abort.Panic]:
            can Abort.Panic:
                dot: mutable i64 = -1
                for index in 0..<path.len |dot, path|:
                    dot <- index.i64() if path[index] == 46
                return -1 if dot <= 0
                enum_index: i64 = penum_path_enum_index(path, dot, structs)
                return -1 if enum_index < 0
                return penum_path_variant_offset(path, dot, enum_index, structs)


        # Body paths are stored as strings in Pattern nodes, so path resolution cannot recover
        # the alias declaration that was visible where the pattern appeared. Use the retained
        # arm/expression offset while resolving, then restore the surrounding codegen context.
        def variant_path_source_offset_enter(source_offset: u32, structs: mutable StructTable&) -> u32:
            saved_offset: u32 = structs.visibility.current_source_offset
            structs.visibility.current_source_offset <- source_offset
            return saved_offset


        def variant_path_source_offset_leave(saved_offset: u32, structs: mutable StructTable&) -> void:
            structs.visibility.current_source_offset <- saved_offset


        def penum_variant_index_of_path_at(path: sview, source_offset: u32, structs: mutable StructTable&) -> i64 can[Abort.Panic]:
            saved_offset: u32 = variant_path_source_offset_enter(source_offset, structs)
            result: i64 = penum_variant_index_of_path(path, structs)
            variant_path_source_offset_leave(saved_offset, structs)
            return result




            # `Shape.Circle` -> its payload's ValueType, or Unmodeled when the path names no
            # payload-carrying variant.
        def penum_payload_of_path(path: sview, structs: mutable StructTable&) -> ValueType can[Abort.Panic]:
            can Abort.Panic:
                dot: mutable i64 = -1
                for index in 0..<path.len |dot, path|:
                    dot <- index.i64() if path[index] == 46
                return unmodeled_type() if dot <= 0
                enum_index: i64 = penum_path_enum_index(path, dot, structs)
                return unmodeled_type() if enum_index < 0
                offset: i64 = penum_path_variant_offset(path, dot, enum_index, structs)
                return unmodeled_type() if offset < 0
                slot: usize = structs.payload_enums.penum_variant_start[enum_index.usize()] + offset.usize()
                return unmodeled_type() if not structs.payload_enums.penum_has_payload[slot]
                return copied_type(structs.payload_enums.penum_payloads[slot])


        def penum_payload_of_path_at(path: sview, source_offset: u32, structs: mutable StructTable&) -> ValueType can[Abort.Panic]:
            saved_offset: u32 = variant_path_source_offset_enter(source_offset, structs)
            result: ValueType = penum_payload_of_path(path, structs)
            variant_path_source_offset_leave(saved_offset, structs)
            return result



            # The variant-slot for `Enum.Variant` (an index into the per-variant pools), or -1.
        # The payload enum a dotted variant path names, or -1. Companion to
        # penum_slot_of_path: callers that need to REBUILD the path as an expression need the
        # enum's own registered name (a real sview), because slicing `path` is not available
        # here — `&path[0]` is a `char&`, not the `u8&?` `sview(...)` wants.
        def penum_enum_of_path(path: sview, structs: mutable StructTable&) -> i64 can[Abort.Panic]:
            can Abort.Panic:
                dot: mutable i64 = -1
                for index in 0..<path.len |dot, path|:
                    dot <- index.i64() if path[index] == 46
                return -1 if dot <= 0
                enum_index: i64 = penum_path_enum_index(path, dot, structs)
                return -1 if:
                    enum_index < 0
                    penum_path_variant_offset(path, dot, enum_index, structs) < 0
                return enum_index


        def penum_enum_of_path_at(path: sview, source_offset: u32, structs: mutable StructTable&) -> i64 can[Abort.Panic]:
            saved_offset: u32 = variant_path_source_offset_enter(source_offset, structs)
            result: i64 = penum_enum_of_path(path, structs)
            variant_path_source_offset_leave(saved_offset, structs)
            return result




        def penum_slot_of_path(path: sview, structs: mutable StructTable&) -> i64 can[Abort.Panic]:
            can Abort.Panic:
                dot: mutable i64 = -1
                for index in 0..<path.len |dot, path|:
                    dot <- index.i64() if path[index] == 46
                return -1 if dot <= 0
                enum_index: i64 = penum_path_enum_index(path, dot, structs)
                return -1 if enum_index < 0
                offset: i64 = penum_path_variant_offset(path, dot, enum_index, structs)
                return -1 if offset < 0
                return structs.payload_enums.penum_variant_start[enum_index.usize()].i64() + offset


        def penum_slot_of_path_at(path: sview, source_offset: u32, structs: mutable StructTable&) -> i64 can[Abort.Panic]:
            saved_offset: u32 = variant_path_source_offset_enter(source_offset, structs)
            result: i64 = penum_slot_of_path(path, structs)
            variant_path_source_offset_leave(saved_offset, structs)
            return result



            # The `{T0, T1, …}` tuple LLVM type over a MULTI-FIELD variant-slot's fields — the
            # value stored into (and loaded from) the `[N x i64]` payload blob. Only meaningful
            # when `penum_field_type_count[slot] > 1`.
        def penum_field_tuple_type(slot: usize, structs: mutable StructTable&, ctx: LLVMContextRef) -> LLVMTypeRef can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            field_count: usize = structs.payload_enums.penum_field_type_count[slot]
            field_start: usize = structs.payload_enums.penum_field_type_start[slot]
            field_llvm: mutable darray[LLVMTypeRef] = []
            for field_index in 0..<field_count |field_llvm, field_start, structs, ctx|:
                field_llvm.push(llvm_type_of(copied_type(structs.payload_enums.penum_field_types[field_start + field_index]), structs, ctx))
            field_pointer: void& = (&field_llvm[0]).cast[void&] can Unsafe.PointerCast
            return LLVMStructTypeInContext(ctx, field_pointer, field_count.u32(), 0)




        # The enum NAME out of a variant head. A MODULE-QUALIFIED head (`Ast::Expr.Invalid`)
        # parses as Expr.Scope, not Expr.Ident, so every `is` test written that way missed the
        # Ident-only checks and declined. Returns "" when the head is neither shape.
        def enum_head_name(head: Expr) -> sview can[Abort.Panic]:
            match head:
                Expr.Ident(ehn_ident_name, ehn_ident_line):
                    return ehn_ident_name
                _:
                    pass
            match head:
                Expr.Scope(ehn_scope_base, ehn_scope_name, ehn_scope_line):
                    return ehn_scope_name
                _:
                    pass
            return ""




        # `E.Variant` as an Expr.Field -> the tag/ordinal used by error and payload metadata,
        # or -1. Const-enum constant folding uses enum_constant_value_of_expr below instead.
        def ordinal_of_dotted_path_expr(expression: Expr, structs: mutable StructTable&) -> i64 can[Abort.Panic]:
            can Abort.Panic:
                match expression:
                    Expr.Field(enum_head, variant_name, field_line):
                        enum_name: sview = enum_head_name(enum_head)
                        enum_index: i64 = penum_index_of_head(structs, enum_head)
                        return penum_variant_index(structs, enum_index, variant_name) if enum_index >= 0
                        plain_index: i64 = enum_index_of_head(structs, enum_head)
                        return enum_ordinal_of(structs, plain_index.usize(), variant_name) if plain_index >= 0
                    _:
                        pass
                return -1




        # A const-enum Expr.Field's explicit backing value (or a payload-enum's tag), with
        # membership reported separately so every i64 value, including -1, remains representable.
        def enum_constant_value_of_expr(expression: Expr, structs: mutable StructTable&, found: mutable bool&) -> i64 can[Abort.Panic]:
            can Abort.Panic:
                found <- false
                match expression:
                    Expr.Field(enum_head, variant_name, field_line):
                        penum_index: i64 = penum_index_of_head(structs, enum_head)
                        if penum_index >= 0:
                            penum_tag: i64 = penum_variant_index(structs, penum_index, variant_name)
                            if penum_tag >= 0:
                                found <- true
                                return penum_tag
                        const_index: i64 = enum_index_of_head(structs, enum_head)
                        if const_index >= 0:
                            const_ordinal: i64 = enum_ordinal_of(structs, const_index.usize(), variant_name)
                            if const_ordinal >= 0:
                                found <- true
                                return structs.const_enums.enum_variant_values[structs.const_enums.enum_variant_start[const_index.usize()] + const_ordinal.usize()]
                    _:
                        pass
                return 0




        # Build the Expr.Ident/Scope head for a dotted enum variant path. Preserving every
        # module component lets enum_index_of_head apply the same lexical and owner ranking as
        # field-expression lookup (`M::Color.Red`).
        def enum_head_of_dotted_variant_path(path: sview @source, dot: usize) -> Expr can[Abort.Panic]:
            invalid: Expr = Expr.Invalid
            return invalid if dot == 0 or dot >= path.len
            head: mutable Expr = Expr.Invalid
            have_head: mutable bool = false
            segment_start: mutable usize = 0
            scan: mutable usize = 0
            while scan < dot |scan, dot, path, head, have_head, segment_start, invalid|:
                if path[scan] == 58 and scan + 1.usize() < dot and path[scan + 1.usize()] == 58:
                    segment: sview = path[segment_start:scan]
                    return invalid if segment == ""
                    head <- Expr.Ident(segment, Ast::pos_at_line(0)) if not have_head
                    head <- Expr.Scope(head, segment, Ast::pos_at_line(0)) if have_head
                    have_head <- true
                    scan <- scan + 2.usize()
                    segment_start <- scan
                else:
                    scan <- scan + 1.usize()
            final_segment: sview = path[segment_start:dot]
            return invalid if final_segment == ""
            head <- Expr.Ident(final_segment, Ast::pos_at_line(0)) if not have_head
            head <- Expr.Scope(head, final_segment, Ast::pos_at_line(0)) if have_head
            return head




        # Resolve a const-enum dotted path to its explicit backing value. The separate found
        # result is required because -1 is a valid member value.
        def const_enum_value_of_dotted_path(path: sview @source, structs: mutable StructTable&, found: mutable bool&) -> i64 can[Abort.Panic]:
            can Abort.Panic:
                found <- false
                dot: mutable i64 = -1
                for index in 0..<path.len |dot, path|:
                    dot <- index.i64() if path[index] == 46
                return 0 if dot <= 0
                enum_head: Expr = enum_head_of_dotted_variant_path(path, dot.usize())
                enum_index: i64 = enum_index_of_head(structs, enum_head)
                return 0 if enum_index < 0
                variant_name: sview = path[(dot.usize() + 1.usize()):path.len]
                variant_ordinal: i64 = enum_ordinal_of(structs, enum_index.usize(), variant_name)
                return 0 if variant_ordinal < 0
                found <- true
                return structs.const_enums.enum_variant_values[structs.const_enums.enum_variant_start[enum_index.usize()] + variant_ordinal.usize()]




        # Pattern.Variant carries the path as one dotted STRING. This helper returns a
        # declaration ordinal for error tags and payload metadata, not a const enum's value.
        def ordinal_of_dotted_path(path: sview @source, structs: mutable StructTable&) -> i64 can[Abort.Panic]:
            can Abort.Panic:
                dot: mutable i64 = -1
                for index in 0..<path.len |dot, path|:
                    dot <- index.i64() if path[index] == 46
                return -1 if dot <= 0
                enum_head: Expr = enum_head_of_dotted_variant_path(path, dot.usize())
                enum_index: i64 = enum_index_of_head(structs, enum_head)
                return -1 if enum_index < 0
                variant_name: sview = path[(dot.usize() + 1.usize()):path.len]
                return enum_ordinal_of(structs, enum_index.usize(), variant_name)




            # Whether `path[start..end)` equals `candidate`, byte for byte.
        def sview_matches_prefix(path: sview, candidate: sview, start: i64, end: i64) -> bool can[Abort.Panic]:
            path_length: usize = path.len
            candidate_length: usize = candidate.len
            return false if:
                path.len < 0 or candidate.len < 0
                path_length.i64() != path.len or candidate_length.i64() != candidate.len
                start < 0 or end < start or end > path.len
                end - start != candidate.len
            matched: mutable bool = true
            for index in 0..<candidate_length |matched, path, candidate, start|:
                matched <- false if path[(start + index.i64()).usize()] != candidate[index]
            return matched




        # Whether a pattern matches anything. ONLY `_` does: a BINDING arm is not legal in
        # an integer match — stage0 rejects `other: other + 2` with "top-level integer
        # match arm must use an integer literal or _" (and then "undefined identifier
        # other"). Treating a binding as a catch-all made stage1 emit code for a program
        # the language rejects; caught by the stage0 differential.
        #
        # Written as a `match`, NOT `pattern is Pattern.Wildcard`: `is` on a PAYLOAD-LESS
        # packed-enum variant crashes stage0's backend with "unsupported expression
        # *ast.TypeExprExpr" (the bare `Pattern.Wildcard` parses as a type path). `is` WITH
        # a payload and `match` both work — filed with a 12-line repro. Keep this a match
        # until that lands.
        # Whether `name` IS `ancestor` or refines it transitively -- the backend's copy of
        # docs/77's descends-from test, read off the hierarchy edges StructTable records.
        def enum_descends_from(structs: StructTable&, name: sview, ancestor: sview, enum_module: sview) -> bool can[Abort.Panic]:
            return true if name == ancestor
            cursor: mutable sview = name
            steps: mutable usize = 0
            while steps < structs.packed_layouts.hierarchy_child.count |cursor, steps, enum_module, structs|:
                parent: mutable sview = ""
                for edge_index in 0..<structs.packed_layouts.hierarchy_child.count |parent, cursor, enum_module, structs|:
                    edge_module: sview = structs.packed_layouts.hierarchy_modules[edge_index] if edge_index < structs.packed_layouts.hierarchy_modules.count else ""
                    parent <- structs.packed_layouts.hierarchy_parent[edge_index] if structs.packed_layouts.hierarchy_child[edge_index] == cursor and edge_module == enum_module
                return false if parent == ""
                return true if parent == ancestor
                cursor <- parent
                steps <- steps + 1
            return false




        # The leaf-tag RANGE a docs/77 §2 category arm dispatches on. A hierarchy registers
        # its members' leaves in PRE-ORDER, so a category's leaves are one contiguous span
        # and membership is the docs/81 primitive `tag - lo <u count`. Returns false when
        # `category` owns no row of this enum, which is what keeps a bind arm against an
        # unrelated type a plain catch-all.
        def penum_category_tag_range(structs: StructTable&, enum_index: i64, category: sview, lo: mutable i64&, count: mutable i64&) -> bool can[Abort.Panic]:
            lo <- -1
            count <- 0
            return false if enum_index < 0 or enum_index.usize() >= structs.payload_enums.penum_variant_start.count
            start: usize = structs.payload_enums.penum_variant_start[enum_index.usize()]
            total: usize = structs.payload_enums.penum_variant_count[enum_index.usize()]
            enum_module: sview = structs.payload_enums.penum_owners[enum_index.usize()] if enum_index.usize() < structs.payload_enums.penum_owners.count else ""
            for offset in 0..<total |lo, count, structs, start, category|:
                slot: usize = start + offset
                continue if slot >= structs.payload_enums.penum_variant_owners.count
                continue if not enum_descends_from(structs, structs.payload_enums.penum_variant_owners[slot], category, enum_module)
                lo <- offset.i64() if lo < 0
                count <- count + 1
            return lo >= 0 and count > 0

        # Reject foreign enum patterns before any payload load is emitted. Same
        # spelling and tag do not imply the same payload size or declaration.
        def pattern_matches_payload_family(pattern: Pattern, family: u32, structs: mutable StructTable&) -> bool can[Abort.Panic]:
            match pattern:
                Pattern.Variant(path, _):
                    dot: mutable i64 = -1
                    for index in 0..<path.len |dot, path|:
                        dot <- index.i64() if path[index] == 46
                    return true if dot <= 0
                    owner: i64 = penum_path_enum_index(path, dot, structs)
                    # A qualified/typed variant path must resolve to this declaration.
                    # Treating an unresolved foreign path as harmless lets later lowering
                    # fall back to a same-named row and read its incompatible payload.
                    return owner == family.i64()
                Pattern.Or(options):
                    for option in options |family, structs|:
                        return false if not pattern_matches_payload_family(option, family, structs)
                Pattern.As(_, inner):
                    for option in inner |family, structs|:
                        return false if not pattern_matches_payload_family(option, family, structs)
                _:
                    pass
            return true

        def is_target_matches_enum_family(target: Expr, family: ValueType, structs: mutable StructTable&) -> bool can[Abort.Panic]:
            match target:
                Expr.Call(callee: callee, _):
                    return is_target_matches_enum_family(callee, family, structs)
                Expr.Paren(inner, _):
                    return is_target_matches_enum_family(inner, family, structs)
                Expr.Field(head, _, _):
                    if family.kind == TypeKind.PayloadEnum:
                        row: i64 = penum_index_of_head(structs, head)
                        return row == family.bits.i64()
                    if family.kind == TypeKind.PackedEnum:
                        row: i64 = packed_index_of_head(structs, head)
                        return row == family.bits.i64()
                _:
                    pass
            return true


        def penum_path_enum_index_at(path: sview, dot: i64, source_offset: u32, structs: mutable StructTable&) -> i64 can[Abort.Panic]:
            saved_offset: u32 = variant_path_source_offset_enter(source_offset, structs)
            result: i64 = penum_path_enum_index(path, dot, structs)
            variant_path_source_offset_leave(saved_offset, structs)
            return result


        def penum_variant_offset_in_family_at(path: sview @source, family_index: i64, source_offset: u32, structs: mutable StructTable&) -> i64 can[Abort.Panic]:
            saved_offset: u32 = variant_path_source_offset_enter(source_offset, structs)
            result: i64 = penum_variant_offset_in_family(path, family_index, structs)
            variant_path_source_offset_leave(saved_offset, structs)
            return result


        def error_variant_location_at(path: sview @source, family: sview, source_offset: u32, structs: mutable StructTable&) -> ErrorVariantLocation can[Abort.Panic]:
            saved_offset: u32 = variant_path_source_offset_enter(source_offset, structs)
            result: ErrorVariantLocation = error_variant_location(path, family, structs)
            variant_path_source_offset_leave(saved_offset, structs)
            return result


        def error_variant_location_expr_at(expression: Expr, family: sview, source_offset: u32, structs: mutable StructTable&) -> ErrorVariantLocation can[Abort.Panic]:
            saved_offset: u32 = variant_path_source_offset_enter(source_offset, structs)
            result: ErrorVariantLocation = error_variant_location_expr(expression, family, structs)
            variant_path_source_offset_leave(saved_offset, structs)
            return result


        def ordinal_of_dotted_path_expr_at(expression: Expr, source_offset: u32, structs: mutable StructTable&) -> i64 can[Abort.Panic]:
            saved_offset: u32 = variant_path_source_offset_enter(source_offset, structs)
            result: i64 = ordinal_of_dotted_path_expr(expression, structs)
            variant_path_source_offset_leave(saved_offset, structs)
            return result


        def ordinal_of_dotted_path_at(path: sview @source, source_offset: u32, structs: mutable StructTable&) -> i64 can[Abort.Panic]:
            saved_offset: u32 = variant_path_source_offset_enter(source_offset, structs)
            result: i64 = ordinal_of_dotted_path(path, structs)
            variant_path_source_offset_leave(saved_offset, structs)
            return result


        def pattern_matches_payload_family_at(pattern: Pattern, family: u32, source_offset: u32, structs: mutable StructTable&) -> bool can[Abort.Panic]:
            saved_offset: u32 = variant_path_source_offset_enter(source_offset, structs)
            result: bool = pattern_matches_payload_family(pattern, family, structs)
            variant_path_source_offset_leave(saved_offset, structs)
            return result


        def is_target_matches_enum_family_at(target: Expr, family: ValueType, structs: mutable StructTable&) -> bool can[Abort.Panic]:
            saved_offset: u32 = variant_path_source_offset_enter(Ast::expr_pos(target).offset, structs)
            result: bool = is_target_matches_enum_family(target, family, structs)
            variant_path_source_offset_leave(saved_offset, structs)
            return result
