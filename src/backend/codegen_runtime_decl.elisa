# Stage1 backend — declaring the runtime's LLVM function types and the per-function Runtime record.
# Part of `module Backend` (see codegen.elisa); split out to keep each file short.

extend Backend:
    private:
        # The language-level `usize` used by runtime entry points follows the requested
        # target even though several container layouts still carry i64 counters internally.
        # Convert at the runtime boundary so wasm32 definitions reconcile with their
        # declarations instead of being auto-renamed to `arena_alloc.2` and left unresolved.
        def runtime_size_llvm_type(ctx: LLVMContextRef) -> LLVMTypeRef:
            LLVMInt32TypeInContext(ctx) return if target_pointer_bits() == 32
            return LLVMInt64TypeInContext(ctx)


        def runtime_size_argument(value: LLVMValueRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef:
            size_type: LLVMTypeRef = runtime_size_llvm_type(ctx)
            value return if LLVMTypeOf(value) == size_type
            return LLVMBuildTrunc(builder, value, size_type, "runtime.usize") if target_pointer_bits() == 32 else LLVMBuildZExt(builder, value, size_type, "runtime.usize")


        def runtime_core_types(ctx: LLVMContextRef, packed_mode: i32) -> RuntimeCoreTypes can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            pointer_type: LLVMTypeRef = LLVMPointerTypeInContext(ctx, 0)
            int64_type: LLVMTypeRef = LLVMInt64TypeInContext(ctx)
            int32_type: LLVMTypeRef = LLVMInt32TypeInContext(ctx)
            size_type: LLVMTypeRef = runtime_size_llvm_type(ctx)
            alloc_params: mutable darray[LLVMTypeRef] = [pointer_type, size_type]
            alloc_pointer: void& = (&alloc_params[0]).cast[void&] can Unsafe.PointerCast
            alloc_type: LLVMTypeRef = LLVMFunctionType(pointer_type, alloc_pointer, 2, 0)
            realloc_params: mutable darray[LLVMTypeRef] = [pointer_type, pointer_type, size_type, size_type]
            realloc_pointer: void& = (&realloc_params[0]).cast[void&] can Unsafe.PointerCast
            realloc_type: LLVMTypeRef = LLVMFunctionType(pointer_type, realloc_pointer, 4, 0)
            free_params: mutable darray[LLVMTypeRef] = [pointer_type]
            free_pointer: void& = (&free_params[0]).cast[void&] can Unsafe.PointerCast
            free_type: LLVMTypeRef = LLVMFunctionType(LLVMVoidTypeInContext(ctx), free_pointer, 1, 0)
            backend_params: mutable darray[LLVMTypeRef] = [size_type, int64_type]
            backend_pointer: void& = (&backend_params[0]).cast[void&] can Unsafe.PointerCast
            backend_type: LLVMTypeRef = LLVMFunctionType(pointer_type, backend_pointer, 2, 0)
            state_new_params: mutable darray[LLVMTypeRef] = [pointer_type, size_type]
            state_new_pointer: void& = (&state_new_params[0]).cast[void&] can Unsafe.PointerCast
            state_new_type: LLVMTypeRef = LLVMFunctionType(pointer_type, state_new_pointer, 2, 0)
            alloc_result_fields: mutable darray[LLVMTypeRef] = [pointer_type, int32_type]
            alloc_result_pointer: void& = (&alloc_result_fields[0]).cast[void&] can Unsafe.PointerCast
            # This is also a source-level runtime struct. Register the identified type now
            # so the later source declaration reuses the exact same LLVM handle.
            alloc_result_type: LLVMTypeRef = LLVMStructCreateNamed(ctx, "PackedStoreIndexAllocResult")
            LLVMStructSetBody(alloc_result_type, alloc_result_pointer, 2, 0)
            packed_alloc_params: mutable darray[LLVMTypeRef] = [pointer_type, pointer_type, int32_type]
            if packed_mode == 2:
                packed_alloc_params <- [pointer_type, pointer_type]
            packed_alloc_params_pointer: void& = (&packed_alloc_params[0]).cast[void&] can Unsafe.PointerCast
            alloc_fn_type: LLVMTypeRef = LLVMFunctionType(alloc_result_type, packed_alloc_params_pointer, 2 if packed_mode == 2 else 3, 0)
            read_tag_params: mutable darray[LLVMTypeRef] = [pointer_type, int32_type]
            if packed_mode == 2:
                read_tag_params <- [pointer_type, int64_type]
            read_tag_pointer: void& = (&read_tag_params[0]).cast[void&] can Unsafe.PointerCast
            read_tag_type: LLVMTypeRef = LLVMFunctionType(pointer_type if packed_mode == 2 else int32_type, read_tag_pointer, 2, 0)
            read_word_params: mutable darray[LLVMTypeRef] = [int32_type, pointer_type, size_type]
            if packed_mode == 1:
                read_word_params <- [pointer_type, int32_type, pointer_type, size_type]
            if packed_mode == 2:
                read_word_params <- [pointer_type, int32_type]
            read_word_pointer: void& = (&read_word_params[0]).cast[void&] can Unsafe.PointerCast
            read_word_type: LLVMTypeRef = LLVMFunctionType(pointer_type if packed_mode == 2 else size_type, read_word_pointer, 2 if packed_mode == 2 else (4 if packed_mode == 1 else 3), 0)
            record_prefix_params: mutable darray[LLVMTypeRef] = [pointer_type, pointer_type, pointer_type]
            record_prefix_pointer: void& = (&record_prefix_params[0]).cast[void&] can Unsafe.PointerCast
            record_prefix_type: LLVMTypeRef = LLVMFunctionType(LLVMVoidTypeInContext(ctx), record_prefix_pointer, 3, 0)
            return RuntimeCoreTypes{pointer: pointer_type, alloc: alloc_type, realloc: realloc_type, free: free_type, backend: backend_type, state_new: state_new_type, alloc_result: alloc_result_type, packed_alloc: alloc_fn_type, read_tag: read_tag_type, read_word: read_word_type, record_prefix: record_prefix_type}


        struct RuntimeStringTypes:
            streq: LLVMTypeRef
            sview: LLVMTypeRef
            sview_eq: LLVMTypeRef
            sview_index: LLVMTypeRef


        def runtime_string_types(ctx: LLVMContextRef) -> RuntimeStringTypes can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            pointer_type: LLVMTypeRef = LLVMPointerTypeInContext(ctx, 0)
            int64_type: LLVMTypeRef = LLVMInt64TypeInContext(ctx)
            streq_params: mutable darray[LLVMTypeRef] = [pointer_type, pointer_type]
            streq_pointer: void& = (&streq_params[0]).cast[void&] can Unsafe.PointerCast
            streq_type: LLVMTypeRef = LLVMFunctionType(int64_type, streq_pointer, 2, 0)
            sview_fields: mutable darray[LLVMTypeRef] = [pointer_type, int64_type]
            sview_pointer: void& = (&sview_fields[0]).cast[void&] can Unsafe.PointerCast
            sview_type: LLVMTypeRef = LLVMStructTypeInContext(ctx, sview_pointer, 2, 0)
            sview_eq_params: mutable darray[LLVMTypeRef] = [sview_type, sview_type]
            sview_eq_pointer: void& = (&sview_eq_params[0]).cast[void&] can Unsafe.PointerCast
            sview_eq_type: LLVMTypeRef = LLVMFunctionType(int64_type, sview_eq_pointer, 2, 0)
            sview_index_params: mutable darray[LLVMTypeRef] = [sview_type, int64_type]
            sview_index_pointer: void& = (&sview_index_params[0]).cast[void&] can Unsafe.PointerCast
            sview_index_type: LLVMTypeRef = LLVMFunctionType(int64_type, sview_index_pointer, 2, 0)
            return RuntimeStringTypes{streq: streq_type, sview: sview_type, sview_eq: sview_eq_type, sview_index: sview_index_type}


        def runtime_trace_type(ctx: LLVMContextRef) -> LLVMTypeRef can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            pointer_type: LLVMTypeRef = LLVMPointerTypeInContext(ctx, 0)
            int32_type: LLVMTypeRef = LLVMInt32TypeInContext(ctx)
            trace_params: mutable darray[LLVMTypeRef] = [pointer_type, int32_type]
            trace_pointer: void& = (&trace_params[0]).cast[void&] can Unsafe.PointerCast
            return LLVMFunctionType(LLVMVoidTypeInContext(ctx), trace_pointer, 2, 0)


        def runtime_trace_value_type(ctx: LLVMContextRef) -> LLVMTypeRef can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            pointer_type: LLVMTypeRef = LLVMPointerTypeInContext(ctx, 0)
            int32_type: LLVMTypeRef = LLVMInt32TypeInContext(ctx)
            int64_type: LLVMTypeRef = LLVMInt64TypeInContext(ctx)
            trace_value_params: mutable darray[LLVMTypeRef] = [pointer_type, int32_type, pointer_type, int64_type]
            trace_value_pointer: void& = (&trace_value_params[0]).cast[void&] can Unsafe.PointerCast
            return LLVMFunctionType(LLVMVoidTypeInContext(ctx), trace_value_pointer, 4, 0)


        def runtime_trace_fault_type(ctx: LLVMContextRef) -> LLVMTypeRef can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            return LLVMFunctionType(LLVMVoidTypeInContext(ctx), null, 0, 0)


        def runtime_types(ctx: LLVMContextRef, packed_mode: i32) -> RuntimeTypes can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                core: RuntimeCoreTypes = runtime_core_types(ctx, packed_mode)
                strings: RuntimeStringTypes = runtime_string_types(ctx)
                trace_type: LLVMTypeRef = runtime_trace_type(ctx)
                trace_value_type: LLVMTypeRef = runtime_trace_value_type(ctx)
                return RuntimeTypes{pointer: core.pointer, alloc: core.alloc, realloc: core.realloc, free: core.free, backend: core.backend, state_new: core.state_new, alloc_result: core.alloc_result, packed_alloc: core.packed_alloc, read_tag: core.read_tag, read_word: core.read_word, record_prefix: core.record_prefix, streq: strings.streq, sview: strings.sview, sview_eq: strings.sview_eq, sview_index: strings.sview_index, trace: trace_type, trace_value: trace_value_type, trace_fault_install: runtime_trace_fault_type(ctx)}


            # Declare the runtime entry points in the module. Signatures are dictated by
            # elisacore_runtime.o (read from stage0's own emitted IR):
            #   ptr  arena_alloc(ptr arena, usize bytes)
            #   ptr  arena_realloc(ptr arena, ptr old, usize old_bytes, usize new_bytes)
            #   void arena_free(ptr arena)
        def declare_runtime(m: LLVMModuleRef, ctx: LLVMContextRef, enable_trace: bool, packed_mode: i32) -> Runtime can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            types: RuntimeTypes = runtime_types(ctx, packed_mode)
            pointer_type: LLVMTypeRef = types.pointer
            alloc_type: LLVMTypeRef = types.alloc
            realloc_type: LLVMTypeRef = types.realloc
            free_type: LLVMTypeRef = types.free
            backend_type: LLVMTypeRef = types.backend
            state_new_type: LLVMTypeRef = types.state_new
            alloc_result_type: LLVMTypeRef = types.alloc_result
            alloc_fn_type: LLVMTypeRef = types.packed_alloc
            read_tag_type: LLVMTypeRef = types.read_tag
            read_word_type: LLVMTypeRef = types.read_word
            record_prefix_type: LLVMTypeRef = types.record_prefix
            streq_type: LLVMTypeRef = types.streq
            sview_struct_llvm: LLVMTypeRef = types.sview
            sview_eq_type: LLVMTypeRef = types.sview_eq
            sview_index_type: LLVMTypeRef = types.sview_index
            trace_type: LLVMTypeRef = types.trace
            trace_value_type: LLVMTypeRef = types.trace_value
            trace_fault_install_type: LLVMTypeRef = runtime_trace_fault_type(ctx)
            trace_record_handle: LLVMValueRef = LLVMAddFunction(m, "elisa_trace_record", trace_type) if enable_trace else zeroed
            trace_record_value_handle: LLVMValueRef = LLVMAddFunction(m, "elisa_trace_record_value", trace_value_type) if enable_trace else zeroed
            trace_fault_install_handle: LLVMValueRef = LLVMAddFunction(m, "elisa_trace_install_fault_handler", trace_fault_install_type) if enable_trace else zeroed
            aos_record_handle: LLVMValueRef = LLVMAddFunction(m, "ctx_aos_store_record", read_tag_type) if packed_mode == 2 else zeroed

            return Runtime{
                streq: LLVMAddFunction(m, "ctx_streq", streq_type),
                streq_type: streq_type,
                sview_eq: LLVMAddFunction(m, "ctx_string_views_eq", sview_eq_type),
                sview_eq_type: sview_eq_type,
                sview_index: LLVMAddFunction(m, "ctx_string_view_index", sview_index_type),
                sview_index_type: sview_index_type,
                # Filled in by emit_module_with_debug when `-g` is on; `debug_active` gates
                # every use, so the placeholders are never dereferenced otherwise.
                debug_builder: zeroed,
                debug_file: zeroed,
                debug_active: false,
                trace_record: trace_record_handle,
                trace_record_type: trace_type,
                trace_record_value: trace_record_value_handle,
                trace_record_value_type: trace_value_type,
                trace_name: LLVMConstNull(pointer_type),
                trace_enabled: false,
                trace_fault_install: trace_fault_install_handle,
                trace_fault_install_type: trace_fault_install_type,
                disjoint_function_name: "",
                disjoint_function_mask: 0,
                disjoint_param_slots: [],
                disjoint_param_indices: [],
                disjoint_element_ptrs: [],
                disjoint_element_indices: [],
                owns_arena: true,
                fast_math: false,
                force_bounds_check: force_bounds_check_enabled(),
                active_store: LLVMConstNull(pointer_type),
                active_store_enum: -1,
                error_out: LLVMConstNull(pointer_type),
                in_error_fn: false,
                main_returns_status: false,
                packed_mode: packed_mode,
                active_store_is_block: false,
                packed_state_new: LLVMAddFunction(m, "ctx_aos_store_new" if packed_mode == 2 else ("ctx_packed_store_state_new" if packed_mode == 1 else "ctx_packed_store_state_new_variant_sparse"), state_new_type),
                packed_state_new_type: state_new_type,
                packed_alloc: LLVMAddFunction(m, "ctx_aos_store_alloc" if packed_mode == 2 else ("ctx_packed_store_alloc_fixed_tagged_index_result" if packed_mode == 1 else "ctx_packed_store_alloc_fixed_tagged_variant_sparse_result"), alloc_fn_type),
                packed_alloc_type: alloc_fn_type,
                packed_alloc_result_type: alloc_result_type,
                packed_read_tag: aos_record_handle if packed_mode == 2 else LLVMAddFunction(m, "ctx_packed_store_read_index_tag" if packed_mode == 1 else "ctx_packed_store_read_variant_sparse_tag", read_tag_type),
                packed_read_tag_type: read_tag_type,
                packed_read_word: aos_record_handle if packed_mode == 2 else LLVMAddFunction(m, "ctx_packed_store_read_index_word" if packed_mode == 1 else "ctx_packed_store_read_variant_sparse_word", read_word_type),
                packed_read_word_type: read_word_type,
                packed_record_prefix: LLVMAddFunction(m, "ctx_packed_store_record_prefix_words", record_prefix_type) if packed_mode == 1 else zeroed,
                packed_record_prefix_type: record_prefix_type,
                new_region_backend: LLVMAddFunction(m, "new_region_backend", backend_type),
                new_region_backend_type: backend_type,
                arena_alloc: LLVMAddFunction(m, "arena_alloc", alloc_type),
                arena_realloc: LLVMAddFunction(m, "arena_realloc", realloc_type),
                arena_free: LLVMAddFunction(m, "arena_free", free_type),
                arena_alloc_type: alloc_type,
                arena_realloc_type: realloc_type,
                arena_free_type: free_type,
                # No region until a function supplies its own; a null placeholder keeps
                # the module clean (declaring a dummy function to fill this would emit a
                # bogus symbol). The caller-owned arena is likewise populated only while
                # emitting a function with hidden region parameters.
                arena: LLVMConstNull(pointer_type),
                caller_arena: LLVMConstNull(pointer_type),
                caller_arenas: []
            }


        # Generic function TEMPLATES, and the instantiations made from them.
        #
        # The instantiation cache is keyed by (base name, type argument) — NOT by mangled
        # name. That is deliberate: an `sview` is a view, so a mangled name built into a
        # local buffer would DANGLE the moment the buffer's region died (Elisa's region
        # checker catches exactly this). `base_names` are sviews into the SOURCE buffer,
        # which outlives everything, and ValueType is POD — so nothing here borrows.
        #
        # The mangled name is only ever needed transiently, to hand to LLVMAddFunction,
        # which COPIES it. So it is built in a local buffer, used, and dropped.
        #
        # Generic parameter names come from the FILE-level side table
        # (`generic_param_names` / `generic_param_lines`) keyed by the function's LINE —
        # they are NOT on Decl.Func. A row whose line has the high bit set is a BOUND
        # (`[T: Ord]`): metadata the backend never needs, since it only instantiates types
        # the frontend already accepted.
        struct GenericTable:
            names: mutable darray[sview]
            decls: mutable darray[Decl]
            params: mutable darray[sview]
            param_start: mutable darray[usize]
            param_count: mutable darray[usize]
            # Whether each template is ERROR-RETURNING (`… error[E]`): its instantiations must
            # use the i32-status + leading-out-param ABI, in both the signature and the body.
            # Computed at registration from the file's error-line side table (a template has no
            # `error[E]` node on its Decl — the clause is consumed at parse time).
            is_error: mutable darray[bool]
            # Instantiations, keyed by (base name, type-argument TUPLE). A generic may have
            # more than one type parameter (`arena_dict_put[K, T]`), so the arguments live in
            # a flat pool with a per-instantiation span rather than one ValueType per row.
            inst_bases: mutable darray[sview]
            inst_args: mutable darray[ValueType]
            inst_arg_start: mutable darray[usize]
            inst_arg_count: mutable darray[usize]
            inst_handles: mutable darray[LLVMValueRef]
            # The template SLOT each instantiation came from. Redundant with the base name UNLESS
            # the name is overloaded (`len[T](Slice)` vs `len[T](ReadView)`): then base+args are not
            # unique, so the slot is what distinguishes the two — used to key the cache and to emit
            # the correct BODY (emit_instantiation_body must not re-derive the slot by first-name).
            inst_slots: mutable darray[usize]
            # Whether this instantiation's SIGNATURE trails the caller's arena — RECORDED at
            # declaration rather than recomputed per call site.
            #
            # signature_needs_arena is ORDER-DEPENDENT: it asks whether a parameter's target is
            # a growable container, and a `dict[K, T]&` parameter only answers yes once
            # `DynDict[K, T]` has been registered. Two instantiations of the same shape
            # therefore disagreed depending on which was declared first —
            # arena_dict_put_or_panic[u64, sview] got NO arena parameter while the
            # arena_dict_put[u64, sview] it calls got one, so the callee read its arena out of a
            # register the caller never set. Every dict `put` then grew its bucket array from a
            # garbage Arena, and the stage1-built semantic analyzer segfaulted probing past the
            # end of it.
            #
            # A call site always declares the instantiation before emitting its arguments, so
            # reading the recorded flag makes the two sides agree BY CONSTRUCTION rather than by
            # both happening to recompute the same answer.
            inst_needs_arena: mutable darray[bool]
            # The WORKLIST: instantiations declared but whose BODY still needs emitting. A
            # body cannot be emitted at the call site (the builder sits inside the caller),
            # so emit_module drains this afterwards — and keeps draining, because a generic
            # can call another generic. Type args are pooled the same way as inst_args.
            pending_bases: mutable darray[sview]
            pending_args: mutable darray[ValueType]
            pending_arg_start: mutable darray[usize]
            pending_arg_count: mutable darray[usize]
            pending_handles: mutable darray[LLVMValueRef]
            # The template slot for each queued body (parallel to pending_bases). emit_instantiation_body
            # emits generics.decls[this slot] — NOT decls[generic_index_of(base)], which would pick the
            # first overload's body for an overloaded name.
            pending_slots: mutable darray[usize]


        def new_generic_table() -> GenericTable can[Abort.Panic, Memory.Allocate]:
            return GenericTable{names: [], decls: [], params: [], param_start: [], param_count: [], is_error: [], inst_bases: [], inst_args: [], inst_arg_start: [], inst_arg_count: [], inst_handles: [], inst_slots: [], inst_needs_arena: [], pending_bases: [], pending_args: [], pending_arg_start: [], pending_arg_count: [], pending_handles: [], pending_slots: []}


        # Push one type-parameter binding per (param name, type arg) for template `slot`, so
        # annotation_value_type resolves the template's `K`/`T` to the concrete args. Returns
        # the number pushed, to pop symmetrically with pop_type_bindings.
        def push_type_bindings(generics: GenericTable&, structs: mutable StructTable&, slot: usize, type_args: darray[ValueType]&) -> usize can[Abort.Panic, Memory.Allocate]:
            pstart: usize = generics.param_start[slot]
            count: usize = generics.param_count[slot]
            bound: mutable usize = 0
            for k in 0..<count |structs, generics, pstart, type_args, bound, count|:
                break if k >= type_args.count
                structs.binding_names <- structs.binding_names.push(generics.params[pstart + k])
                structs.binding_types <- structs.binding_types.push(copied_type(type_args[k]))
                bound <- bound + 1
            return bound


        def pop_type_bindings(structs: mutable StructTable&, count: usize) -> void can[Abort.Panic, Memory.Allocate]:
            for _drop in 0..<count |structs|:
                structs.binding_names <- structs.binding_names.truncate(structs.binding_names.count - 1)
                structs.binding_types <- structs.binding_types.truncate(structs.binding_types.count - 1)


        # The position of type-parameter `name` in template `slot`, or -1. Used by inference
        # to bind the argument that pins that parameter.
        def type_param_position(generics: GenericTable&, slot: usize, name: sview) -> i64 can[Abort.Panic]:
            pstart: usize = generics.param_start[slot]
            count: usize = generics.param_count[slot]
            for k in 0..<count |generics, pstart, name, count|:
                k.i64() return if generics.params[pstart + k] == name
            return -1


        # UNIFY a parameter's type annotation against the CONCRETE type of the argument
        # passed for it, binding any type parameters it names. `mutable`/`&` qualifiers are
        # transparent (the argument's value type is what matters), and a `Base[..]` annotation
        # recurses into a matching generic-struct instantiation's stored arguments — so
        # `dict[K, T]&` unified against a `DynDict[i64, i64]` argument pins K=i64, T=i64.
        def unify_annotation(annotation: Expr, actual: ValueType, generics: GenericTable&, slot: usize, structs: StructTable&, bindings: mutable darray[ValueType]&, bound_flags: mutable darray[bool]&) -> void can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic, Memory.Allocate:
                match annotation:
                    Expr.Unary(qualifier, inner_annotation, qualifier_line):
                        # `mutable T` is transparent. `T&` strips a reference on BOTH sides in step:
                        # the argument for a `Bucket[T]&` parameter is often a `Bucket[i64]&` (e.g.
                        # `&arr[0]`), so the outer `&` must peel off the actual's Ref too before the
                        # inner `Bucket[T]` unifies against the instantiation.
                        unify_annotation(inner_annotation, actual, generics, slot, structs, bindings, bound_flags) if qualifier == TokenKind.Mutable
                        if qualifier == TokenKind.Ampersand:
                            # Read the referent directly (ref_target_of would demand a mutable table).
                            stripped_actual: ValueType = copied_type(structs.ref_targets[actual.bits.usize()]) if actual.kind == TypeKind.Ref else copied_type(actual)
                            unify_annotation(inner_annotation, stripped_actual, generics, slot, structs, bindings, bound_flags)
                        return
                    _:
                        pass
                match annotation:
                    Expr.Ident(param_name, param_name_line):
                        position: i64 = type_param_position(generics, slot, param_name)
                        if position >= 0 and not bound_flags[position.usize()]:
                            bindings[position.usize()] <- copied_type(actual)
                            bound_flags[position.usize()] <- true
                        return
                    _:
                        pass
                # `view[T]` annotation against a `view[U]` argument — bind T from the view's
                # interned element. Checked before the generic-struct branch (a View is not a
                # struct instantiation), so `arena_da_fill(view, …)` recovers its element type.
                match annotation:
                    Expr.Index(view_annotation_head, view_annotation_arg, view_annotation_line):
                        match view_annotation_head:
                            Expr.Ident(view_annotation_name, view_annotation_head_line):
                                if view_annotation_name == "view" and actual.kind == TypeKind.View:
                                    unify_annotation(view_annotation_arg, copied_type(structs.view_elements[actual.bits.usize()]), generics, slot, structs, bindings, bound_flags)
                                    return
                                # `darray[T]` annotation against a `darray[U]` argument — bind T from the
                                # argument's element (like the view case). Needed so a generic over a darray
                                # PARAMETER (`slice[T](da: darray[T]&)`, `arena_da_fill[T](darray[T]&, …)`)
                                # infers T; the outer `&` was already peeled by the Unary branch above.
                                if view_annotation_name == "darray" and actual.kind == TypeKind.DArray:
                                    unify_annotation(view_annotation_arg, copied_type(structs.darray_elements[actual.bits.usize()]), generics, slot, structs, bindings, bound_flags)
                                    return
                            _:
                                pass
                    _:
                        pass
                # `darray[T, shape_in]` — the SHAPED spelling the std uses on every in-place
                # container helper (`arena_da_view[T](da: darray[T, shape_in]&, …)`). The shape
                # argument makes the annotation an IndexN, so the single-argument darray branch
                # above never matched and T never bound, which failed inference for the whole call.
                # Shapes are erased at the type level already; the ELEMENT is type argument 0 and
                # the trailing shapes carry nothing to unify against. (`view` is NOT included: it
                # takes exactly one argument, so a shaped view does not parse.)
                match annotation:
                    Expr.IndexN(shaped_head, shaped_args, shaped_line):
                        match shaped_head:
                            Expr.Ident(shaped_name, shaped_head_line):
                                if shaped_name == "darray" and actual.kind == TypeKind.DArray and shaped_args.count >= 1:
                                    unify_annotation(shaped_args[0], copied_type(structs.darray_elements[actual.bits.usize()]), generics, slot, structs, bindings, bound_flags)
                                    return
                            _:
                                pass
                    _:
                        pass
                # `Base[A]` / `Base[A, B]` — recurse into the argument's instantiation arguments
                # when the argument is that same generic struct.
                actual_base: mutable sview = ""
                actual_arg_start: mutable usize = 0
                actual_arg_count: mutable usize = 0
                has_instantiation: bool = generic_struct_instantiation_of(structs, actual, actual_base, actual_arg_start, actual_arg_count)
                return if not has_instantiation
                match annotation:
                    Expr.Index(base_head, single_type_arg, index_line):
                        match base_head:
                            Expr.Ident(base_name, base_head_line):
                                mapped_base: sview = "DynDict" if base_name == "dict" else ("DynSet" if base_name == "set" else base_name)
                                if mapped_base == actual_base and actual_arg_count == 1:
                                    unify_annotation(single_type_arg, copied_type(structs.generic_struct_inst_args[actual_arg_start]), generics, slot, structs, bindings, bound_flags)
                            _:
                                pass
                        return
                    _:
                        pass
                match annotation:
                    Expr.IndexN(multi_base_head, multi_type_args, multi_index_line):
                        match multi_base_head:
                            Expr.Ident(multi_base_name, multi_base_head_line):
                                mapped_multi_base: sview = "DynDict" if multi_base_name == "dict" else ("DynSet" if multi_base_name == "set" else multi_base_name)
                                if mapped_multi_base == actual_base and actual_arg_count == multi_type_args.count:
                                    for arg_position in 0..<multi_type_args.count |multi_type_args, actual_arg_start, generics, slot, structs, bindings, bound_flags|:
                                        unify_annotation(multi_type_args[arg_position], copied_type(structs.generic_struct_inst_args[actual_arg_start + arg_position]), generics, slot, structs, bindings, bound_flags)
                            _:
                                pass
                        return


                    _:
                        pass
            # If `value_type` is a materialized generic-struct instantiation, report its base name
            # and the flat span of its stored type arguments.
        def generic_struct_instantiation_of(structs: StructTable&, value_type: ValueType, out_base: mutable sview&, out_arg_start: mutable usize&, out_arg_count: mutable usize&) -> bool can[Abort.Panic]:
            false return if value_type.kind != TypeKind.Struct
            for inst in 0..<structs.generic_struct_inst_index.count |structs, value_type, out_base, out_arg_start, out_arg_count|:
                if structs.generic_struct_inst_index[inst] == value_type.bits.usize():
                    out_base <- structs.generic_struct_inst_bases[inst]
                    out_arg_start <- structs.generic_struct_inst_arg_start[inst]
                    out_arg_count <- structs.generic_struct_inst_arg_count[inst]
                    return true
            return false


        # Infer a generic function's full type-argument tuple from its call arguments, by
        # unifying each parameter annotation against the argument's concrete type. Returns the
        # inferred tuple, or an empty darray if any parameter stayed unbound (the caller then
        # declines, or requires an explicit `f[K, V](…)`).
        # A bare integer literal, or a unary +/- wrapping one — the forms that carry no
        # expression type of their own but should default to i64 for generic inference.
        def is_int_literal_expr(expression: Expr) -> bool can[Abort.Panic]:
            can Abort.Panic:
                match expression:
                    Expr.IntLit(literal_value):
                        return true
                    Expr.Unary(unary_operator, unary_operand, unary_line):
                        return when unary_operator:
                            TokenKind.Minus | TokenKind.Plus -> is_int_literal_expr(unary_operand)
                            _ -> false
                    Expr.Paren(paren_inner, paren_line):
                        return is_int_literal_expr(paren_inner)
                    _:
                        return false

        # Type arguments for a generic whose parameter appears ONLY in the RETURN type —
        # `def new[T](api: FlagsNamespace) -> Flags[T]`. The argument-driven pass binds nothing
        # there, so the DECLARATION's annotation is the only source; unify the template's
        # return annotation against the expected type. Returns [] unless every parameter comes
        # out bound, so a caller that cannot fully determine the instantiation declines rather
        # than picking one.
        def infer_generic_args_from_expected(slot: usize, expected: ValueType, generics: mutable GenericTable&, structs: mutable StructTable&) -> darray[ValueType] can[Abort.Panic, Memory.Allocate]:
            count: usize = generics.param_count[slot]
            bindings: mutable darray[ValueType] = [unmodeled_type() for _expected_slot in 0..<count]
            bound_flags: mutable darray[bool] = [false for _expected_flag in 0..<count]
            empty: darray[ValueType] = []
            empty return if count == 0 or expected.kind == TypeKind.Unmodeled
            match generics.decls[slot]:
                Decl.Func(expected_fn_name, expected_params, expected_return_opt, expected_body, expected_effects, expected_decorators, expected_line):
                    if expected_return_opt is expected_return_annotation:
                        unify_annotation(expected_return_annotation, expected, generics, slot, structs, bindings, bound_flags)
                _:
                    pass
            all_bound: mutable bool = true
            for expected_flag in bound_flags |all_bound|:
                all_bound <- false if not expected_flag
            empty return if not all_bound
            return bindings


        def infer_generic_args(slot: usize, arguments: darray[Expr]&, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&) -> darray[ValueType] can[Abort.Panic, Memory.Allocate]:
            count: usize = generics.param_count[slot]
            bindings: mutable darray[ValueType] = [unmodeled_type() for _slot_index in 0..<count]
            bound_flags: mutable darray[bool] = [false for _flag_index in 0..<count]
            match generics.decls[slot]:
                Decl.Func(function_name, params, return_type_opt, body, effects, decorators, line):
                    limit: usize = params.count if params.count < arguments.count else arguments.count
                    for position in 0..<limit |bindings, bound_flags, params, arguments, local_scope, fns, structs, generics, slot|:
                        # `f: fn(A) -> R` against a FUNCTION-VALUED argument. unify_annotation takes
                        # a ValueType, and matching a fn-type ANNOTATION against one needs the
                        # actual's parameter and return types, so it is resolved here where the
                        # argument expression is still in hand. Two sources, in order:
                        #   - an interned Fn ValueType (a local or parameter of fn type) carries its
                        #     signature in the fn_pool_* side-pools — this is the case pool_submit1
                        #     needs, where `fn` is its own PARAMETER, not a named function;
                        #   - a bare function NAME has no expression type of its own, so its
                        #     declaration in the FnTable is the only source.
                        # The annotation's own parameter type expressions are line-keyed exactly as
                        # annotation_lambda_value_type reads them.
                        lambda_handled: mutable bool = false
                        match params[position].type_expression:
                            Expr.Lambda(lam_names, lam_body, lam_line):
                                lam_param_types: mutable darray[ValueType] = []
                                lam_return_type: mutable ValueType = unmodeled_type()
                                lam_actual_type: ValueType = expression_type(arguments[position], local_scope, fns, structs, generics)
                                if lam_actual_type.kind == TypeKind.Fn and lam_actual_type.bits.usize() < structs.fn_pool_returns.count:
                                    lambda_handled <- true
                                    lam_pool_start: usize = structs.fn_pool_param_start[lam_actual_type.bits.usize()]
                                    for lam_pool_i in 0..<structs.fn_pool_param_count[lam_actual_type.bits.usize()] |lam_param_types, lam_pool_start, structs|:
                                        lam_param_types.push(copied_type(structs.fn_pool_params[lam_pool_start + lam_pool_i]))
                                    lam_return_type <- fn_return_type_of(lam_actual_type, structs)
                                else:
                                    match arguments[position]:
                                        Expr.Ident(lam_arg_name, _):
                                            if function_index_of(fns, "", lam_arg_name) >= 0:
                                                lambda_handled <- true
                                                for lam_fn_i in 0..<param_type_count(fns, "", lam_arg_name) |lam_param_types, lam_arg_name, fns|:
                                                    lam_param_types.push(param_type_of(fns, "", lam_arg_name, lam_fn_i))
                                                lam_return_type <- lookup_return_type(fns, "", lam_arg_name)
                                        _:
                                            pass
                                if lambda_handled:
                                    lam_probe: mutable usize = 0
                                    lam_index: mutable usize = 0
                                    while lam_probe < structs.fn_type_param_lines.count |lam_probe, lam_index, lam_line, lam_param_types, bindings, bound_flags, generics, slot, structs|:
                                        if structs.fn_type_param_lines[lam_probe] == lam_line.line:
                                            if lam_index < lam_param_types.count and lam_param_types[lam_index].kind != TypeKind.Unmodeled:
                                                unify_annotation(structs.fn_type_param_exprs[lam_probe], lam_param_types[lam_index], generics, slot, structs, bindings, bound_flags)
                                            lam_index <- lam_index + 1
                                        lam_probe <- lam_probe + 1
                                    lam_return_position: i64 = type_param_position(generics, slot, fn_return_head_at(lam_line.line, structs))
                                    if lam_return_position >= 0 and not bound_flags[lam_return_position.usize()] and lam_return_type.kind != TypeKind.Unmodeled:
                                        bindings[lam_return_position.usize()] <- copied_type(lam_return_type)
                                        bound_flags[lam_return_position.usize()] <- true
                            _:
                                pass
                        continue if lambda_handled
                        actual: mutable ValueType = expression_type(arguments[position], local_scope, fns, structs, generics)
                        # An untyped int literal argument (`id(21)`) has no expression type of its
                        # own — like stage0's inference, default it to i64 so a bare type-parameter
                        # binds instead of leaving the call uninferable.
                        actual <- ValueType{kind: TypeKind.Signed, bits: 64} if actual.kind == TypeKind.Unmodeled and is_int_literal_expr(arguments[position])
                        continue if actual.kind == TypeKind.Unmodeled
                        unify_annotation(params[position].type_expression, actual, generics, slot, structs, bindings, bound_flags)
                _:
                    pass
            for flag_index in 0..<count |bound_flags, bindings|:
                if not bound_flags[flag_index]:
                    bindings <- bindings.truncate(0)
                    return bindings
            return bindings


        # The index of generic template `name`, or -1.
        def generic_index_of(generics: GenericTable&, name: sview) -> i64 can[Abort.Panic]:
            for index in 0..<generics.names.count |generics, name|:
                index.i64() return if generics.names[index] == name
            return -1


        # The already-declared instantiation for (base, type-argument tuple), or null.
        def instantiation_of(generics: GenericTable&, base: sview, type_args: darray[ValueType]&) -> LLVMValueRef? can[Abort.Panic]:
            for index in 0..<generics.inst_bases.count |generics, base, type_args|:
                continue if generics.inst_bases[index] != base
                continue if generics.inst_arg_count[index] != type_args.count
                astart: usize = generics.inst_arg_start[index]
                matched: mutable bool = true
                for k in 0..<type_args.count |generics, matched, astart, type_args|:
                    stored: ValueType = generics.inst_args[astart + k]
                    matched <- false if stored.kind != type_args[k].kind or stored.bits != type_args[k].bits
                generics.inst_handles[index] return if matched
            return null


        # A deferred function body keeps references to the slots visible at its declaration
        # point. Capturing slots (rather than only names) preserves stage0's lexical-shadowing
        # rule when the deferred body runs later.
        struct DeferredAction:
            body: mutable darray[Stmt]
            names: mutable darray[sview]
            slots: mutable darray[LLVMValueRef]
            types: mutable darray[ValueType]
            scope_exit: bool


        # A function's local slots: `names[i]` lives in the `alloca` at `slots[i]`.
        # Parallel darrays rather than a dict: scopes are tiny (a handful of locals), a
        # linear scan beats hashing, and it keeps the opaque extern handle out of a dict's
        # key/value machinery.
        struct Scope:
            names: mutable darray[sview]
            slots: mutable darray[LLVMValueRef]
            types: mutable darray[ValueType]
            # Kept index-parallel with names/slots/types by declare_local, which always
            # pushes `false`. Only a plain `x: mutable T& = v` VarDecl (the one call site
            # that can spell the `mutable` keyword on a Ref-typed annotation at all) flips
            # its own entry true, via mark_last_local_mutable, right after declaring it.
            # Everything else -- match-arm payloads, `get ... else` bindings, `try`
            # bindings, loop accumulators -- has no such keyword to inspect and stays
            # false, which is the PRE-EXISTING (write-through) behavior, unchanged.
            local_is_mutable: mutable darray[bool] = []
            # For a local declared `runner: fn(...) -> R = add`, the name of the function it
            # ALIASES ("add"), else "". Index-parallel with names/slots/types; declare_local
            # always pushes "" and only the VarDecl site that can see the initializer fills it
            # in, via mark_last_local_fn_origin.
            #
            # It exists for LABELLED calls through the alias: a `fn(i64, i64) -> i64` type has
            # no parameter NAMES to reorder `runner(y: 7, x: 3)` against, so without the origin
            # the labels cannot be resolved at all (stage0 resolves the alias back to its
            # target). Defaulted so partial Scope literals stay valid.
            local_fn_origins: mutable darray[sview] = []
            # The same fact one level in: a STRUCT-typed local whose fn-typed FIELD was
            # initialised from a named function (`box: CallbackBox = CallbackBox{run: add}`),
            # so that `box.run(y: 7, x: 3)` can be reordered against `add`'s parameter names.
            # A `fn(i64, i64)` field type carries no names, and stage0 recovers them the same
            # way -- by resolving the alias back to its target (measured: it answers 23 for
            # `sub` called as `(y: 7, x: 30)`, i.e. 30 - 7, not 7 - 30).
            #
            # THREE parallel pools rather than one "local.field" key, because building that key
            # means concatenating two sviews into a buffer whose region may die before the
            # lookup -- the dangling-view trap the generic instantiation cache documents.
            #
            # NOT index-parallel with names/slots/types: a local contributes one entry per
            # aliased field, or none. Looked up by scanning for the (local, field) pair.
            fn_field_alias_locals: mutable darray[sview] = []
            fn_field_alias_fields: mutable darray[sview] = []
            fn_field_alias_targets: mutable darray[sview] = []
            # The arena a local was DECLARED against because of an explicit `@region`
            # qualifier, and whether it has one. Index-parallel with names/slots/types;
            # declare_local pushes "absent" and only the VarDecl site that can see the
            # qualifier fills it in. growth_arena_for consults it before the region frames,
            # because an explicit pin overrides the lexical rule.
            local_declared_arenas: mutable darray[LLVMValueRef] = []
            local_has_declared_arena: mutable darray[bool] = []
            # Index-parallel with names/slots/types. A non-negative entry identifies the
            # hidden caller-region slot owned by a reference parameter; -1 means ordinary local.
            local_parameter_arena_indices: mutable darray[i64] = []
            # Active structured-concurrency owners. These are backend-only lexical stacks;
            # the frontend has already checked pool/nursery nesting and submit placement.
            pool_names: mutable darray[sview]
            group_names: mutable darray[sview]
            deferred: mutable darray[DeferredAction]
            # REGION FRAMES: one entry per active `region r:` / `in owner:` block, innermost
            # last. `starts` is names.count at block entry, `arenas` the block's arena, and
            # `outers` the arena that was ambient OUTSIDE the block. A darray grows from the
            # arena it was DECLARED under (stage0 allocates `outer.push` from %__auto even
            # inside `region scratch:`), so growth sites resolve the target's root name
            # against these frames instead of using the ambient runtime.arena. Defaulted so
            # partial Scope literals (deferred capture, lambdas) stay valid — an empty frame
            # stack simply falls back to runtime.arena, which is the pre-existing behavior.
            region_frame_starts: mutable darray[usize] = []
            region_frame_arenas: mutable darray[LLVMValueRef] = []
            region_frame_outers: mutable darray[LLVMValueRef] = []


        # The module's functions by name. Built in emit_module's declare pass, so a call
        # to a function defined LATER in the file still resolves.
        #
        # Kept here rather than asking LLVMGetNamedFunction: that returns NULL-or-pointer,
        # i.e. it needs `-> LLVMValueRef?`, and an extern returning an optional of an
        # opaque extern type always binds null in stage0 (silent, no diagnostic). We
        # already know every function we declared, so this is also just less work.
        struct FnTable:
            names: mutable darray[sview]
            # Source declaration line for each entry. Body emission uses this to select
            # the exact overload; name+arity is insufficient when several same-arity
            # overloads exist (notably the std `__cast__` family).
            lines: mutable darray[u32]
            # The enclosing MODULE's name, or "" for a top-level function. Functions are
            # keyed on the (owner, name) PAIR rather than on a mangled "M.get" string:
            # `names` are sviews into the SOURCE buffer, and a synthesized name has no
            # source text to point at — an sview into a growing darray would dangle. The
            # mangled form is built only as a temporary cstr for the LLVM symbol.
            owners: mutable darray[sview]
            # True when the function has an implicit trailing arena parameter (it takes a
            # growable container by reference). The CALL SITE must then pass its own arena.
            needs_arena: mutable darray[bool]
            # Number of hidden arena parameters. Parser functions carrying AST store context
            # use the stage0 ABI `arena, store, arena`; ordinary arena-threaded functions use
            # one trailing arena. Keeping the count avoids collapsing two distinct lifetimes.
            arena_counts: mutable darray[usize]
            # True when the function carries the compiler's implicit AST packed-store
            # context. Stage0 injects this trailing ABI parameter for Parser/Backend
            # functions that expose the recursive AST hierarchy; it is distinct from the
            # caller-owned Arena parameter above.
            needs_store: mutable darray[bool]
            # True when the function returns an error union `T error[E]`: its LLVM signature
            # is `i32 @f(ptr out, <params>)` -- an i32 error code, with the T value written
            # through a leading out-pointer. `returns[i]` still holds T (the success type).
            is_error: mutable darray[bool]
            # True when the declared return type is a NULLABLE REFERENCE (`-> heap T&?`).
            # Such a return registers as a plain Ref -- stage0 represents it as a bare ptr
            # with null meaning absent -- so the ValueType alone cannot tell it from a
            # non-nullable `-> T&`. `get f()` is legal on the nullable one only.
            returns_nullable: mutable darray[bool]
            # True for a C variadic extern. `param_count[i]` remains the number of fixed
            # parameters; calls may provide additional promoted C arguments after them.
            is_variadic: mutable darray[bool]
            handles: mutable darray[LLVMValueRef]
            returns: mutable darray[ValueType]
            # Parameter types as a FLAT pool plus a per-function span (`param_start[i]`,
            # `param_count[i]`) — a nested `darray[darray[ValueType]]` would make this
            # region-polymorphic for no benefit.
            param_types: mutable darray[ValueType]
            param_names: mutable darray[sview]
            # Per-parameter DEFAULT value expression, parallel to param_names/param_types.
            # Expr.Invalid when the parameter has no default. A call site that omits a
            # trailing argument fills it from here; without this the call declined.
            param_defaults: mutable darray[Expr]
            param_start: mutable darray[usize]
            param_count: mutable darray[usize]
            # Whether each source parameter owns one of the hidden caller-region slots.
            # This is inferred from the function body, not from the broad shape of its type.
            param_region_slots: mutable darray[bool]


        # The enclosing loops' branch targets, innermost LAST. `break` jumps to
        # `exits[last]`, `continue` to `continues[last]`. A loop pushes before emitting its
        # body and pops after, so a `break` outside any loop finds an empty stack and
        # DECLINES rather than emitting a wild branch.
        #
        # `continue` targets differ per loop form: a `while` continues to its condition
        # block, a `for` to its INCREMENT block (skipping the increment would make
        # `continue` an infinite loop).
        struct LoopStack:
            exits: mutable darray[LLVMBasicBlockRef]
            continues: mutable darray[LLVMBasicBlockRef]
            # The `deferred` count when each loop BODY began. A `break` leaves every scope
            # inside the loop at once, so it must unwind the scope-exit `defer`s registered
            # since this mark — and no further, or it would run an enclosing region's.
            defer_marks: mutable darray[usize]


        # The OWNED regions currently live, outermost FIRST. A `return` has to unwind every
        # one of them, not just the innermost: stage0's IR for a return inside `region r:`
        # frees `%r` AND the enclosing function's auto region on that path.
        #
        # Only OWNED regions are listed. A threaded (borrowed) arena belongs to the caller
        # and is never freed here, so an arena-threading function's stack is simply empty.
        struct RegionStack:
            arenas: mutable darray[LLVMValueRef]


        # Free every live owned region, innermost FIRST (reverse declaration order), which is
        # the order stage0 emits them in.
        def emit_region_unwind(regions: RegionStack&, runtime: Runtime&, builder: LLVMBuilderRef) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            index: mutable i64 = regions.arenas.count.i64() - 1
            while index >= 0 |index, regions, runtime, builder|:
                arguments: mutable darray[LLVMValueRef] = [regions.arenas[index.usize()]]
                arguments_pointer: void& = (&arguments[0]).cast[void&] can Unsafe.PointerCast
                _ = LLVMBuildCall2(builder, runtime.arena_free_type, runtime.arena_free, arguments_pointer, 1, "")
                index <- index - 1

        # Run function-level deferred bodies in reverse registration order. Each action
        # reconstructs the lexical scope captured at its declaration, so a later shadowing
        # declaration cannot change what the deferred body observes.
        def emit_deferred_actions(local_scope: Scope&, only_scope_exit: bool, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                return emit_deferred_actions_from(local_scope, 0, only_scope_exit, fns, structs, generics, runtime, m, ctx, builder)


            # The same walk bounded BELOW by `from_index` — the actions a nested scope itself
            # registered. A `defer block:` runs when the scope that declared it ends, so a block
            # must not unwind the enclosing function's actions on the way out.
        def emit_deferred_actions_from(local_scope: Scope&, from_index: usize, only_scope_exit: bool, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            index: mutable i64 = local_scope.deferred.count.i64() - 1
            while index >= from_index.i64() |index, from_index, local_scope, fns, structs, generics, runtime, m, ctx, builder|:
                action: DeferredAction = local_scope.deferred[index.usize()]
                if only_scope_exit and not action.scope_exit:
                    index <- index - 1
                    continue
                captured: mutable Scope = Scope{names: [], slots: [], types: [], pool_names: [], group_names: [], deferred: []}
                for captured_name in action.names |captured, action|:
                    captured.names <- captured.names.push(captured_name)
                for captured_slot in action.slots |captured, action|:
                    captured.slots <- captured.slots.push(captured_slot)
                for captured_type in action.types |captured, action|:
                    captured.types <- captured.types.push(captured_type)
                deferred_loops: mutable LoopStack = LoopStack{exits: [], continues: [], defer_marks: []}
                deferred_regions: mutable RegionStack = RegionStack{arenas: []}
                status: EmitStatus = emit_statements(action.body, ValueType{kind: TypeKind.Void, bits: 0}, captured, deferred_loops, deferred_regions, fns, structs, generics, runtime, m, ctx, builder)
                if status != EmitStatus.Open:
                    return false
                index <- index - 1
            return true


        # What emitting a statement did to control flow.
        #
        # `Terminated` means the statement ended the block (a `return`, or an `if` whose
        # arms all returned). The emitter tracks this itself instead of asking
        # LLVMGetBasicBlockTerminator — same optional-extern bug as FnTable — and it is
        # the better design regardless: LLVM rejects a block with two terminators, so the
        # emitter must know whether a block is still open BEFORE it appends a branch.
        const enum EmitStatus of u8:
