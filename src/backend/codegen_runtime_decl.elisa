# Stage1 backend — declaring the runtime's LLVM function types and the per-function Runtime record.
# Part of `module Backend` (see codegen.elisa); split out to keep each file short.

extend Backend:
    private:
        # The language-level `usize` used by runtime entry points follows the requested
        # target even though several container layouts still carry i64 counters internally.
        # Convert at the runtime boundary so wasm32 definitions reconcile with their
        # declarations instead of being auto-renamed to `arena_alloc.2` and left unresolved.
        def runtime_size_llvm_type(ctx: LLVMContextRef) -> LLVMTypeRef:
            LLVMInt32TypeInContext(ctx) return if target_pointer_bits() == 32
            return LLVMInt64TypeInContext(ctx)




        def runtime_size_argument(value: LLVMValueRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef:
            size_type: LLVMTypeRef = runtime_size_llvm_type(ctx)
            value return if LLVMTypeOf(value) == size_type
            return LLVMBuildTrunc(builder, value, size_type, "runtime.usize") if target_pointer_bits() == 32 else LLVMBuildZExt(builder, value, size_type, "runtime.usize")




        def runtime_core_types(ctx: LLVMContextRef, packed_mode: i32) -> RuntimeCoreTypes can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            pointer_type: LLVMTypeRef = LLVMPointerTypeInContext(ctx, 0)
            int64_type: LLVMTypeRef = LLVMInt64TypeInContext(ctx)
            int32_type: LLVMTypeRef = LLVMInt32TypeInContext(ctx)
            size_type: LLVMTypeRef = runtime_size_llvm_type(ctx)
            alloc_params: mutable darray[LLVMTypeRef] = [pointer_type, size_type]
            alloc_pointer: void& = (&alloc_params[0]).cast[void&] can Unsafe.PointerCast
            alloc_type: LLVMTypeRef = LLVMFunctionType(pointer_type, alloc_pointer, 2, 0)
            realloc_params: mutable darray[LLVMTypeRef] = [pointer_type, pointer_type, size_type, size_type]
            realloc_pointer: void& = (&realloc_params[0]).cast[void&] can Unsafe.PointerCast
            realloc_type: LLVMTypeRef = LLVMFunctionType(pointer_type, realloc_pointer, 4, 0)
            free_params: mutable darray[LLVMTypeRef] = [pointer_type]
            free_pointer: void& = (&free_params[0]).cast[void&] can Unsafe.PointerCast
            free_type: LLVMTypeRef = LLVMFunctionType(LLVMVoidTypeInContext(ctx), free_pointer, 1, 0)
            backend_params: mutable darray[LLVMTypeRef] = [size_type, int64_type]
            backend_pointer: void& = (&backend_params[0]).cast[void&] can Unsafe.PointerCast
            backend_type: LLVMTypeRef = LLVMFunctionType(pointer_type, backend_pointer, 2, 0)
            state_new_params: mutable darray[LLVMTypeRef] = [pointer_type, size_type]
            state_new_pointer: void& = (&state_new_params[0]).cast[void&] can Unsafe.PointerCast
            state_new_type: LLVMTypeRef = LLVMFunctionType(pointer_type, state_new_pointer, 2, 0)
            state_new_side_params: mutable darray[LLVMTypeRef] = [pointer_type, size_type, size_type]
            state_new_side_pointer: void& = (&state_new_side_params[0]).cast[void&] can Unsafe.PointerCast
            state_new_side_type: LLVMTypeRef = LLVMFunctionType(pointer_type, state_new_side_pointer, 3, 0)
            alloc_result_fields: mutable darray[LLVMTypeRef] = [pointer_type, int32_type]
            alloc_result_pointer: void& = (&alloc_result_fields[0]).cast[void&] can Unsafe.PointerCast
            # This is also a source-level runtime struct. Register the identified type now
            # so the later source declaration reuses the exact same LLVM handle.
            alloc_result_type: LLVMTypeRef = LLVMStructCreateNamed(ctx, "PackedStoreIndexAllocResult")
            LLVMStructSetBody(alloc_result_type, alloc_result_pointer, 2, 0)
            packed_alloc_params: mutable darray[LLVMTypeRef] = [pointer_type, pointer_type, int32_type]
            if packed_mode == 2:
                packed_alloc_params <- [pointer_type, pointer_type]
            packed_alloc_params_pointer: void& = (&packed_alloc_params[0]).cast[void&] can Unsafe.PointerCast
            alloc_fn_type: LLVMTypeRef = LLVMFunctionType(alloc_result_type, packed_alloc_params_pointer, 2 if packed_mode == 2 else 3, 0)
            read_tag_params: mutable darray[LLVMTypeRef] = [pointer_type, int32_type]
            if packed_mode == 2:
                read_tag_params <- [pointer_type, int64_type]
            read_tag_pointer: void& = (&read_tag_params[0]).cast[void&] can Unsafe.PointerCast
            read_tag_type: LLVMTypeRef = LLVMFunctionType(pointer_type if packed_mode == 2 else int32_type, read_tag_pointer, 2, 0)
            read_word_params: mutable darray[LLVMTypeRef] = [int32_type, pointer_type, size_type]
            if packed_mode == 1:
                read_word_params <- [pointer_type, int32_type, pointer_type, size_type]
            if packed_mode == 2:
                read_word_params <- [pointer_type, int32_type]
            read_word_pointer: void& = (&read_word_params[0]).cast[void&] can Unsafe.PointerCast
            read_word_type: LLVMTypeRef = LLVMFunctionType(pointer_type if packed_mode == 2 else size_type, read_word_pointer, 2 if packed_mode == 2 else (4 if packed_mode == 1 else 3), 0)
            record_prefix_params: mutable darray[LLVMTypeRef] = [pointer_type, pointer_type, pointer_type]
            record_prefix_pointer: void& = (&record_prefix_params[0]).cast[void&] can Unsafe.PointerCast
            record_prefix_type: LLVMTypeRef = LLVMFunctionType(LLVMVoidTypeInContext(ctx), record_prefix_pointer, 3, 0)
            record_side_words_params: mutable darray[LLVMTypeRef] = [pointer_type, pointer_type, pointer_type, int32_type]
            record_side_words_pointer: void& = (&record_side_words_params[0]).cast[void&] can Unsafe.PointerCast
            record_side_words_type: LLVMTypeRef = LLVMFunctionType(LLVMVoidTypeInContext(ctx), record_side_words_pointer, 4, 0)
            read_side_word_params: mutable darray[LLVMTypeRef] = [pointer_type, int32_type, size_type]
            read_side_word_pointer: void& = (&read_side_word_params[0]).cast[void&] can Unsafe.PointerCast
            read_side_word_type: LLVMTypeRef = LLVMFunctionType(size_type, read_side_word_pointer, 3, 0)
            return RuntimeCoreTypes{pointer: pointer_type, alloc: alloc_type, realloc: realloc_type, free: free_type, backend: backend_type, state_new: state_new_type, state_new_side: state_new_side_type, alloc_result: alloc_result_type, packed_alloc: alloc_fn_type, read_tag: read_tag_type, read_word: read_word_type, record_prefix: record_prefix_type, record_side_words: record_side_words_type, read_side_word: read_side_word_type}




        struct RuntimeStringTypes:
            streq: LLVMTypeRef
            sview: LLVMTypeRef
            sview_eq: LLVMTypeRef
            sview_index: LLVMTypeRef




        def runtime_string_types(ctx: LLVMContextRef) -> RuntimeStringTypes can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            pointer_type: LLVMTypeRef = LLVMPointerTypeInContext(ctx, 0)
            int64_type: LLVMTypeRef = LLVMInt64TypeInContext(ctx)
            streq_params: mutable darray[LLVMTypeRef] = [pointer_type, pointer_type]
            streq_pointer: void& = (&streq_params[0]).cast[void&] can Unsafe.PointerCast
            streq_type: LLVMTypeRef = LLVMFunctionType(int64_type, streq_pointer, 2, 0)
            sview_fields: mutable darray[LLVMTypeRef] = [pointer_type, int64_type]
            sview_pointer: void& = (&sview_fields[0]).cast[void&] can Unsafe.PointerCast
            sview_type: LLVMTypeRef = LLVMStructTypeInContext(ctx, sview_pointer, 2, 0)
            sview_eq_params: mutable darray[LLVMTypeRef] = [sview_type, sview_type]
            sview_eq_pointer: void& = (&sview_eq_params[0]).cast[void&] can Unsafe.PointerCast
            sview_eq_type: LLVMTypeRef = LLVMFunctionType(int64_type, sview_eq_pointer, 2, 0)
            sview_index_params: mutable darray[LLVMTypeRef] = [sview_type, int64_type]
            sview_index_pointer: void& = (&sview_index_params[0]).cast[void&] can Unsafe.PointerCast
            sview_index_type: LLVMTypeRef = LLVMFunctionType(int64_type, sview_index_pointer, 2, 0)
            return RuntimeStringTypes{streq: streq_type, sview: sview_type, sview_eq: sview_eq_type, sview_index: sview_index_type}




        def runtime_trace_type(ctx: LLVMContextRef) -> LLVMTypeRef can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            pointer_type: LLVMTypeRef = LLVMPointerTypeInContext(ctx, 0)
            int32_type: LLVMTypeRef = LLVMInt32TypeInContext(ctx)
            trace_params: mutable darray[LLVMTypeRef] = [pointer_type, int32_type]
            trace_pointer: void& = (&trace_params[0]).cast[void&] can Unsafe.PointerCast
            return LLVMFunctionType(LLVMVoidTypeInContext(ctx), trace_pointer, 2, 0)




        def runtime_trace_value_type(ctx: LLVMContextRef) -> LLVMTypeRef can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            pointer_type: LLVMTypeRef = LLVMPointerTypeInContext(ctx, 0)
            int32_type: LLVMTypeRef = LLVMInt32TypeInContext(ctx)
            int64_type: LLVMTypeRef = LLVMInt64TypeInContext(ctx)
            # The raw value remains an i64 so pointers and unsigned scalars keep their
            # machine representation. The final i32 tells collectors whether to decode
            # that word as a signed i64, avoiding -1 becoming UINT64_MAX in reports.
            trace_value_params: mutable darray[LLVMTypeRef] = [pointer_type, int32_type, pointer_type, int64_type, int32_type]
            trace_value_pointer: void& = (&trace_value_params[0]).cast[void&] can Unsafe.PointerCast
            return LLVMFunctionType(LLVMVoidTypeInContext(ctx), trace_value_pointer, 5, 0)




        def runtime_trace_fault_type(ctx: LLVMContextRef) -> LLVMTypeRef can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            return LLVMFunctionType(LLVMVoidTypeInContext(ctx), null, 0, 0)




        def runtime_types(ctx: LLVMContextRef, packed_mode: i32) -> RuntimeTypes can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                core: RuntimeCoreTypes = runtime_core_types(ctx, packed_mode)
                strings: RuntimeStringTypes = runtime_string_types(ctx)
                trace_type: LLVMTypeRef = runtime_trace_type(ctx)
                trace_value_type: LLVMTypeRef = runtime_trace_value_type(ctx)
                return RuntimeTypes{pointer: core.pointer, alloc: core.alloc, realloc: core.realloc, free: core.free, backend: core.backend, state_new: core.state_new, state_new_side: core.state_new_side, alloc_result: core.alloc_result, packed_alloc: core.packed_alloc, read_tag: core.read_tag, read_word: core.read_word, record_prefix: core.record_prefix, record_side_words: core.record_side_words, read_side_word: core.read_side_word, streq: strings.streq, sview: strings.sview, sview_eq: strings.sview_eq, sview_index: strings.sview_index, trace: trace_type, trace_value: trace_value_type, trace_fault_install: runtime_trace_fault_type(ctx)}




            # Declare the runtime entry points in the module. Signatures are dictated by
            # elisacore_runtime.o (read from stage0's own emitted IR):
            #   ptr  arena_alloc(ptr arena, usize bytes)
            #   ptr  arena_realloc(ptr arena, ptr old, usize old_bytes, usize new_bytes)
            #   void arena_free(ptr arena)
        def declare_runtime(m: LLVMModuleRef, ctx: LLVMContextRef, enable_trace: bool, packed_mode: i32) -> Runtime can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            types: RuntimeTypes = runtime_types(ctx, packed_mode)
            pointer_type: LLVMTypeRef = types.pointer
            alloc_type: LLVMTypeRef = types.alloc
            realloc_type: LLVMTypeRef = types.realloc
            free_type: LLVMTypeRef = types.free
            backend_type: LLVMTypeRef = types.backend
            state_new_type: LLVMTypeRef = types.state_new
            state_new_side_type: LLVMTypeRef = types.state_new_side
            alloc_result_type: LLVMTypeRef = types.alloc_result
            alloc_fn_type: LLVMTypeRef = types.packed_alloc
            read_tag_type: LLVMTypeRef = types.read_tag
            read_word_type: LLVMTypeRef = types.read_word
            record_prefix_type: LLVMTypeRef = types.record_prefix
            record_side_words_type: LLVMTypeRef = types.record_side_words
            read_side_word_type: LLVMTypeRef = types.read_side_word
            streq_type: LLVMTypeRef = types.streq
            sview_struct_llvm: LLVMTypeRef = types.sview
            sview_eq_type: LLVMTypeRef = types.sview_eq
            sview_index_type: LLVMTypeRef = types.sview_index
            trace_type: LLVMTypeRef = types.trace
            trace_value_type: LLVMTypeRef = types.trace_value
            trace_fault_install_type: LLVMTypeRef = runtime_trace_fault_type(ctx)
            trace_record_handle: LLVMValueRef = LLVMAddFunction(m, "elisa_trace_record", trace_type) if enable_trace else zeroed
            trace_record_value_handle: LLVMValueRef = LLVMAddFunction(m, "elisa_trace_record_value", trace_value_type) if enable_trace else zeroed
            trace_fault_install_handle: LLVMValueRef = LLVMAddFunction(m, "elisa_trace_install_fault_handler", trace_fault_install_type) if enable_trace else zeroed
            aos_record_handle: LLVMValueRef = LLVMAddFunction(m, "ctx_aos_store_record", read_tag_type) if packed_mode == 2 else zeroed
            aos_state_new_side_handle: LLVMValueRef = LLVMAddFunction(m, "ctx_aos_store_new_with_side_words", state_new_side_type) if packed_mode == 2 else zeroed
            aos_record_side_words_handle: LLVMValueRef = LLVMAddFunction(m, "ctx_aos_store_record_side_words_at", record_side_words_type) if packed_mode == 2 else zeroed
            aos_read_side_word_handle: LLVMValueRef = LLVMAddFunction(m, "ctx_aos_store_read_side_word", read_side_word_type) if packed_mode == 2 else zeroed

            return Runtime{
                streq: LLVMAddFunction(m, "ctx_streq", streq_type),
                streq_type: streq_type,
                sview_eq: LLVMAddFunction(m, "ctx_string_views_eq", sview_eq_type),
                sview_eq_type: sview_eq_type,
                sview_index: LLVMAddFunction(m, "ctx_string_view_index", sview_index_type),
                sview_index_type: sview_index_type,
                # Filled in by emit_module_with_debug when `-g` is on; `debug_active` gates
                # every use, so the placeholders are never dereferenced otherwise.
                debug_builder: zeroed,
                debug_file: zeroed,
                debug_active: false,
                trace_record: trace_record_handle,
                trace_record_type: trace_type,
                trace_record_value: trace_record_value_handle,
                trace_record_value_type: trace_value_type,
                trace_name: LLVMConstNull(pointer_type),
                trace_enabled: false,
                trace_fault_install: trace_fault_install_handle,
                trace_fault_install_type: trace_fault_install_type,
                disjoint_function_name: "",
                disjoint_function_mask: 0,
                disjoint_param_slots: [],
                disjoint_param_indices: [],
                disjoint_element_ptrs: [],
                disjoint_element_indices: [],
                owns_arena: true,
                fast_math: false,
                force_bounds_check: force_bounds_check_enabled(),
                active_store: LLVMConstNull(pointer_type),
                active_store_enum: -1,
                error_out: LLVMConstNull(pointer_type),
                in_error_fn: false,
                error_fn_family: "",
                main_returns_status: false,
                packed_mode: packed_mode,
                active_store_is_block: false,
                packed_state_new: LLVMAddFunction(m, "ctx_aos_store_new" if packed_mode == 2 else ("ctx_packed_store_state_new" if packed_mode == 1 else "ctx_packed_store_state_new_variant_sparse"), state_new_type),
                packed_state_new_type: state_new_type,
                packed_state_new_side: aos_state_new_side_handle,
                packed_state_new_side_type: state_new_side_type,
                packed_alloc: LLVMAddFunction(m, "ctx_aos_store_alloc" if packed_mode == 2 else ("ctx_packed_store_alloc_fixed_tagged_index_result" if packed_mode == 1 else "ctx_packed_store_alloc_fixed_tagged_variant_sparse_result"), alloc_fn_type),
                packed_alloc_type: alloc_fn_type,
                packed_alloc_result_type: alloc_result_type,
                packed_read_tag: aos_record_handle if packed_mode == 2 else LLVMAddFunction(m, "ctx_packed_store_read_index_tag" if packed_mode == 1 else "ctx_packed_store_read_variant_sparse_tag", read_tag_type),
                packed_read_tag_type: read_tag_type,
                packed_read_word: aos_record_handle if packed_mode == 2 else LLVMAddFunction(m, "ctx_packed_store_read_index_word" if packed_mode == 1 else "ctx_packed_store_read_variant_sparse_word", read_word_type),
                packed_read_word_type: read_word_type,
                packed_record_prefix: LLVMAddFunction(m, "ctx_packed_store_record_prefix_words", record_prefix_type) if packed_mode == 1 else zeroed,
                packed_record_prefix_type: record_prefix_type,
                packed_record_side_words: aos_record_side_words_handle,
                packed_record_side_words_type: record_side_words_type,
                packed_read_side_word: aos_read_side_word_handle,
                packed_read_side_word_type: read_side_word_type,
                new_region_backend: LLVMAddFunction(m, "new_region_backend", backend_type),
                new_region_backend_type: backend_type,
                arena_alloc: LLVMAddFunction(m, "arena_alloc", alloc_type),
                arena_realloc: LLVMAddFunction(m, "arena_realloc", realloc_type),
                arena_free: LLVMAddFunction(m, "arena_free", free_type),
                arena_alloc_type: alloc_type,
                arena_realloc_type: realloc_type,
                arena_free_type: free_type,
                # No region until a function supplies its own; a null placeholder keeps
                # the module clean (declaring a dummy function to fill this would emit a
                # bogus symbol). The caller-owned arena is likewise populated only while
                # emitting a function with hidden region parameters.
                arena: LLVMConstNull(pointer_type),
                caller_arena: LLVMConstNull(pointer_type),
                caller_arenas: []
            }

include "./codegen_generic_inference.elisa"
include "./codegen_emit_state.elisa"
include "./codegen_cleanup.elisa"
