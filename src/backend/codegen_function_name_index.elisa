# Read-only name lookup over an indexed declaration prefix and an appended tail.
# Bucket chains retain source order, including collisions and overloads. Names
# must not be rewritten in place; existing FnTable producers only append keys.
extend Backend:
    private:
        const FUNCTION_NAME_BUCKET_COUNT: usize = 1024
        const FUNCTION_NAME_INDEX_MIN_ROWS: usize = 64
        const FUNCTION_NAME_HASH_OFFSET: u64 = 14695981039346656037
        const FUNCTION_NAME_HASH_PRIME: u64 = 1099511628211
        const FUNCTION_NAME_NOT_FOUND: i64 = -1

        def function_name_bucket(name: sview) -> usize:
            hash: mutable u64 = FUNCTION_NAME_HASH_OFFSET
            for index in 0..<sview_len(name) |hash, name|:
                hash <- (hash ^ sview_at(name, index).u64()) * FUNCTION_NAME_HASH_PRIME
            return (hash % FUNCTION_NAME_BUCKET_COUNT.u64()).usize()

        def build_function_name_index(fns: mutable FnTable&) -> void can[Abort.Panic, Memory.Allocate]:
            fns.name_buckets <- []
            fns.name_next <- []
            return if fns.names.count < FUNCTION_NAME_INDEX_MIN_ROWS
            for _ in 0..<FUNCTION_NAME_BUCKET_COUNT |fns|:
                fns.name_buckets.push(FUNCTION_NAME_NOT_FOUND)
            for _ in 0..<fns.names.count |fns|:
                fns.name_next.push(FUNCTION_NAME_NOT_FOUND)
            remaining: mutable usize = fns.names.count
            while remaining > 0 |remaining, fns|:
                remaining <- remaining - 1
                bucket: usize = function_name_bucket(fns.names[remaining])
                fns.name_next[remaining] <- fns.name_buckets[bucket]
                fns.name_buckets[bucket] <- remaining.i64()

        def function_name_prefix_count(fns: FnTable&) -> usize can[Abort.Panic]:
            return 0 if fns.name_buckets.count != FUNCTION_NAME_BUCKET_COUNT or fns.name_next.count > fns.names.count
            return fns.name_next.count

        def function_name_tail_match(fns: FnTable&, name: sview, start: usize) -> i64 can[Abort.Panic]:
            for index in start..<fns.names.count |fns, name|:
                return index.i64() if fns.names[index] == name
            return FUNCTION_NAME_NOT_FOUND

        def function_name_chain_match(fns: FnTable&, name: sview, start: i64, prefix_count: usize) -> i64 can[Abort.Panic]:
            cursor: mutable i64 = start
            while cursor >= 0 |cursor, fns, name|:
                return cursor if fns.names[cursor.usize()] == name
                cursor <- fns.name_next[cursor.usize()]
            return function_name_tail_match(fns, name, prefix_count)

        def first_function_named(fns: FnTable&, name: sview) -> i64 can[Abort.Panic]:
            prefix_count: usize = function_name_prefix_count(fns)
            return function_name_tail_match(fns, name, 0) if prefix_count == 0
            return function_name_chain_match(fns, name, fns.name_buckets[function_name_bucket(name)], prefix_count)

        def next_function_named(fns: FnTable&, name: sview, current: i64) -> i64 can[Abort.Panic]:
            return FUNCTION_NAME_NOT_FOUND if current < 0
            prefix_count: usize = function_name_prefix_count(fns)
            if current.usize() < prefix_count:
                return function_name_chain_match(fns, name, fns.name_next[current.usize()], prefix_count)
            return function_name_tail_match(fns, name, current.usize() + 1)
