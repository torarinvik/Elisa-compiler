# Stage1 backend — the LOCAL SCOPE: declaring a local and finding its slot, the marks that
# record mutability, pinned region, and fn-alias origin, the save/restore pair around a
# block, and the slots an `is` binding opens.
# Part of `module Backend` (see codegen.elisa).

extend Backend:
    private:


        # The index of `name` in the scope, or -1. Scanned back to front so a later
        # (shadowing) declaration wins.
        def lookup_index(local_scope: mutable Scope&, name: sview) -> i64 can[Abort.Panic]:
            index: mutable i64 = local_scope.names.count.i64() - 1
            while index >= 0 |local_scope, name, index|:
                index return if local_scope.names[index.usize()] == name
                index <- index - 1
            return -1




        # The alloca backing `name`, or null when the name is not a local.
        def lookup_slot(local_scope: mutable Scope&, name: sview) -> LLVMValueRef? can[Abort.Panic]:
            can Abort.Panic:
                index: i64 = lookup_index(local_scope, name)
                null return if index < 0
                return local_scope.slots[index.usize()]




            # The declared type of `name`, or Unmodeled when it is not a local.
        def lookup_type(local_scope: mutable Scope&, name: sview) -> ValueType can[Abort.Panic]:
            can Abort.Panic:
                index: i64 = lookup_index(local_scope, name)
                unmodeled_type() return if index < 0
                return copied_type(local_scope.types[index.usize()])




            # Record a local: name, slot and declared type, kept index-parallel.
        def declare_local(local_scope: mutable Scope&, name: sview, slot: LLVMValueRef, value_type: ValueType) -> void can[Abort.Panic, Memory.Allocate]:
            local_scope.names <- local_scope.names.push(name)
            local_scope.slots <- local_scope.slots.push(slot)
            local_scope.types <- local_scope.types.push(value_type)
            local_scope.local_is_mutable <- local_scope.local_is_mutable.push(false)
            local_scope.local_fn_origins <- local_scope.local_fn_origins.push("")
            local_scope.local_declared_arenas <- local_scope.local_declared_arenas.push(zeroed)
            local_scope.local_has_declared_arena <- local_scope.local_has_declared_arena.push(false)
            local_scope.local_parameter_arena_indices <- local_scope.local_parameter_arena_indices.push(-1)




        # Associate the most recently declared parameter with one hidden caller-region slot.
        def mark_last_local_parameter_arena(local_scope: mutable Scope&, arena_index: i64) -> void can[Abort.Panic, Memory.Allocate]:
            return if local_scope.local_parameter_arena_indices.count == 0
            local_scope.local_parameter_arena_indices[local_scope.local_parameter_arena_indices.count - 1.usize()] <- arena_index




        # Pin the most recently declared local to `arena`, the region its `@region` qualifier
        # named. Called from the VarDecl site right after declare_local.
        def mark_last_local_arena(local_scope: mutable Scope&, arena: LLVMValueRef) -> void can[Abort.Panic, Memory.Allocate]:
            return if local_scope.local_has_declared_arena.count == 0
            last_arena_index: usize = local_scope.local_has_declared_arena.count - 1.usize()
            local_scope.local_declared_arenas[last_arena_index] <- arena
            local_scope.local_has_declared_arena[last_arena_index] <- true




        # Record that the most recently declared local ALIASES the named function. Called from
        # the VarDecl site right after declare_local, mirroring mark_last_local_mutable.
        def mark_last_local_fn_origin(local_scope: mutable Scope&, origin: sview) -> void can[Abort.Panic, Memory.Allocate]:
            return if local_scope.local_fn_origins.count == 0
            local_scope.local_fn_origins[local_scope.local_fn_origins.count - 1.usize()] <- origin




        # Record that struct-typed local `local_name`'s fn-typed field `field_name` was
        # initialised from the named function. Called from the VarDecl site, which is the only
        # place that can see a struct literal's field initialisers.
        def mark_local_fn_field_alias(local_scope: mutable Scope&, local_name: sview, field_name: sview, target: sview) -> void can[Abort.Panic, Memory.Allocate]:
            local_scope.fn_field_alias_locals <- local_scope.fn_field_alias_locals.push(local_name)
            local_scope.fn_field_alias_fields <- local_scope.fn_field_alias_fields.push(field_name)
            local_scope.fn_field_alias_targets <- local_scope.fn_field_alias_targets.push(target)




        # The function `local.field` aliases, or "" when none was recorded. Scans BACKWARDS so
        # the most recent declaration of a shadowed local wins, matching local_fn_origin.
        def local_fn_field_alias(local_scope: Scope&, local_name: sview, field_name: sview) -> sview can[Abort.Panic]:
            scan: mutable usize = local_scope.fn_field_alias_locals.count
            while scan > 0.usize() |scan, local_scope, local_name, field_name|:
                scan <- scan - 1
                if local_scope.fn_field_alias_locals[scan] == local_name and local_scope.fn_field_alias_fields[scan] == field_name:
                    return local_scope.fn_field_alias_targets[scan]
            return ""




        # The function a fn-typed local aliases, or "" when it aliases none. Innermost wins,
        # matching lookup_type's shadowing rule.
        def local_fn_origin(local_scope: Scope&, name: sview) -> sview can[Abort.Panic]:
            scan: mutable usize = local_scope.names.count
            while scan > 0.usize() |scan, local_scope, name|:
                scan <- scan - 1
                if local_scope.names[scan] == name:
                    "" return if scan >= local_scope.local_fn_origins.count
                    return local_scope.local_fn_origins[scan]
            return ""




            # Flip the MOST RECENTLY declared local's mutability bit to true. Called once,
            # right after declare_local, only at the VarDecl site whose own type annotation
            # spells `mutable` on a Ref type -- see the Scope.local_is_mutable field comment
            # for why every other declare_local call site is left at the pushed `false`.
        def mark_last_local_mutable(local_scope: mutable Scope&) -> void can[Abort.Panic]:
            last_index: i64 = local_scope.local_is_mutable.count.i64() - 1
            return if last_index < 0
            local_scope.local_is_mutable[last_index.usize()] <- true




            # Whether NAME's local binding was declared with the `mutable` keyword on its own
            # type annotation. False for a name that isn't a local at all (lookup_index < 0).
        def local_binding_is_mutable(local_scope: mutable Scope&, name: sview) -> bool can[Abort.Panic]:
            index: i64 = lookup_index(local_scope, name)
            false return if index < 0
            return local_scope.local_is_mutable[index.usize()]




        def scope_mark(local_scope: mutable Scope&) -> usize can[Abort.Panic]:
            return local_scope.names.count




        def scope_restore(local_scope: mutable Scope&, mark: usize) -> void can[Abort.Panic]:
            can Abort.Panic:
                while local_scope.names.count > mark |local_scope|:
                    _ = local_scope.names.pop()
                    _ = local_scope.slots.pop()
                    _ = local_scope.types.pop()




            # The slot already opened for `name` at `slot_type` in the current condition, or null.
        def cond_bind_slot_of(structs: mutable StructTable&, name: sview, slot_type: LLVMTypeRef) -> LLVMValueRef? can[Abort.Panic]:
            null return if structs.cond_bind_depth == 0
            for index in 0..<structs.cond_bind_names.count |structs, name, slot_type|:
                structs.cond_bind_slots[index] return if structs.cond_bind_names[index] == name and structs.cond_bind_types[index] == slot_type
            return null




        def bind_is_slot(local_scope: mutable Scope&, structs: mutable StructTable&, name: sview, value_type: ValueType, slot_type: LLVMTypeRef, builder: LLVMBuilderRef) -> LLVMValueRef can[Abort.Panic, Memory.Allocate]:
            if cond_bind_slot_of(structs, name, slot_type) is shared_slot:
                # The SLOT is shared across every bind of this name -- that is the point,
                # and it is what makes the binding survive the match. The NAME still has to
                # be declared again here: the first bind's declare_local went into a scope
                # that has since closed, so a second `if x is held:` left `held` resolving
                # to nothing and the body was emitted against an Unmodeled type. A write
                # through it then declined (`held.pressed <- v` on a packed common), while
                # the same code with a different binder name compiled -- which is what made
                # this look like a per-arm problem rather than a per-name one.
                declare_local(local_scope, name, shared_slot, value_type)
                return shared_slot
            storage: mutable darray[u8] = []
            slot: LLVMValueRef = build_entry_alloca(builder, slot_type, sview_to_cstr(name, storage))
            declare_local(local_scope, name, slot, value_type)
            if structs.cond_bind_depth > 0:
                structs.cond_bind_names <- structs.cond_bind_names.push(name)
                structs.cond_bind_slots <- structs.cond_bind_slots.push(slot)
                structs.cond_bind_types <- structs.cond_bind_types.push(slot_type)
            return slot
