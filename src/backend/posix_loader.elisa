# Shared POSIX loader ABI: returned handles and symbols may be null.
struct ArtifactDlInfo:
    image_path: cstr
    image_base: void&
    symbol_name: cstr
    symbol_address: void&

static if ELISA_TARGET_OS_POSIX:
    @link_name("dlopen")
    extern artifact_identity_dlopen(path: u8&?, mode: i32) -> void&?
    @link_name("dlsym")
    extern artifact_identity_dlsym(handle: void&, name: cstr) -> void&?
    @link_name("dlclose")
    extern artifact_identity_dlclose(handle: void&) -> i32
    @link_name("dladdr")
    extern artifact_identity_dladdr(address: void&, info: mutable ArtifactDlInfo&) -> i32
