# Stage1 backend — the TYPE of an unannotated global const, inferred from its initializer
# the way stage0 does. Part of `module Backend` (see codegen.elisa).

extend Backend:
    private:
        # The type of an UNANNOTATED `const NAME = VALUE`, taken from the initializer the way
        # stage0 does: literals, earlier consts, and operators over them
        # (`const LIMIT = 2 + MAX_POINTS * MAX_POINTS`). Anything else stays Unmodeled
        # and declines rather than being guessed at.
        def infer_const_type(const_value: Expr, structs: mutable StructTable&) -> ValueType can[Abort.Panic]:
            # `const N = "abcd".len` / `.length` / `GREETING.len`: a compile-time string's length is
            # an `i64` in stage0 (constStringLenField), so the const is one too.
            if const_value is Expr.Field(inferred_len_receiver, inferred_len_member, inferred_len_line):
                if (inferred_len_member == "len" or inferred_len_member == "length") and const_eval_string_len(inferred_len_receiver, structs) >= 0:
                    return ValueType{kind: TypeKind.Signed, bits: 64}
            if const_value is Expr.IntLit(inferred_int_literal, _):
                # stage0's default integer type is `int` -- signed 64-bit.
                return ValueType{kind: TypeKind.Signed, bits: 64}
            if const_value is Expr.BoolLit(inferred_bool_literal, _):
                return ValueType{kind: TypeKind.Bool, bits: 1}
            if const_value is Expr.FloatLit(inferred_float_literal, _):
                return ValueType{kind: TypeKind.Float, bits: 64}
            if const_value is Expr.StringLit(inferred_string_literal, _):
                # An unannotated string constant defaults to the compiler's NUL-terminated
                # literal type, matching the ordinary `const NAME = "..."` source spelling.
                return ValueType{kind: TypeKind.CStr, bits: 0}
            if const_value is Expr.Paren(inferred_inner, inferred_paren_line):
                return infer_const_type(inferred_inner, structs)
            if const_value is Expr.Ident(inferred_const_name, inferred_ident_line):
                inferred_const_index: i64 = const_index_of(structs, inferred_const_name)
                return copied_type(structs.constants.const_types[inferred_const_index.usize()]) if inferred_const_index >= 0
            if const_value is Expr.Unary(inferred_unary_operator, inferred_unary_operand, inferred_unary_line):
                return ValueType{kind: TypeKind.Bool, bits: 1} if inferred_unary_operator == TokenKind.Not
                return infer_const_type(inferred_unary_operand, structs) if inferred_unary_operator == TokenKind.Minus or inferred_unary_operator == TokenKind.Tilde
            if const_value is Expr.Binary(inferred_left, inferred_operator, inferred_right, inferred_binary_line):
                return infer_const_binary_type(inferred_left, inferred_operator, inferred_right, structs)
            return ValueType{kind: TypeKind.Unmodeled, bits: 0}



        # A comparison or logical operator is `bool`. Arithmetic takes its operands' common
        # type: a bare integer literal adopts the other side's type (`WIDTH * 2` keeps a
        # `u32` WIDTH's type), and an integer meets a float as `f64`.
        def infer_const_binary_type(left: Expr, operator: TokenKind, right: Expr, structs: mutable StructTable&) -> ValueType can[Abort.Panic]:
            unmodeled: ValueType = ValueType{kind: TypeKind.Unmodeled, bits: 0}
            return ValueType{kind: TypeKind.Bool, bits: 1} if int_predicate_of(operator) >= 0 or operator == TokenKind.And or operator == TokenKind.Or
            left_type: ValueType = infer_const_type(left, structs)
            right_type: ValueType = infer_const_type(right, structs)
            return unmodeled if not is_const_arithmetic_type(left_type) or not is_const_arithmetic_type(right_type)
            return right_type if paren_stripped_expression(left) is Expr.IntLit(left_literal, _)
            return left_type if paren_stripped_expression(right) is Expr.IntLit(right_literal, _)
            return left_type if left_type.kind == right_type.kind and left_type.bits == right_type.bits
            return ValueType{kind: TypeKind.Float, bits: 64} if (left_type.kind == TypeKind.Float and right_type.kind == TypeKind.Signed) or (left_type.kind == TypeKind.Signed and right_type.kind == TypeKind.Float)
            return unmodeled



        def is_const_arithmetic_type(value_type: ValueType) -> bool:
            return is_integer_type(value_type) or value_type.kind == TypeKind.Float
