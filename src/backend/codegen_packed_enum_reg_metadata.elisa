extend Backend:
    private:
        def register_packed_enums_from_metadata(file: Ast::File&, packed_or_ast: darray[sview]&, membership: PackedOwnerMembership&, structs: mutable StructTable&) -> void can[Abort.Panic, Memory.Allocate]:
            # Reserve every packed/AoS declaration in SOURCE order before filling payload
            # rows. A sealed hierarchy's root is often a variant-less ordinary `enum` and
            # therefore absent from payload metadata; reserving only payload entries made
            # the root disappear from reports and left descendants before their store owner.
            for reserve_enum_index in 0..<file.enum_decl_names.count |file, membership, structs|:
                reserve_enum_name: sview = file.enum_decl_names[reserve_enum_index]
                reserve_owner: sview = file.enum_decl_owners[reserve_enum_index] if reserve_enum_index < file.enum_decl_owners.count else ""
                reserve_packed_placeholder(reserve_enum_name, structs, reserve_owner) if reserve_enum_index < membership.enum_declarations.count and membership.enum_declarations[reserve_enum_index]
            register_packed_common_storage_from_metadata(file.enum_annotations, structs)
            register_packed_common_names_from_metadata(file.payload_enum_names, file.payload_enum_owners, file.payload_enum_variant_starts, file.payload_enum_variant_counts, file.payload_enum_variant_fields, file.payload_enum_variant_field_names, file.payload_enum_variant_field_starts, file.enum_common_owners, file.enum_common_modules, file.enum_common_counts, structs)
            register_packed_common_names_from_common_metadata(file.enum_common_owners, file.enum_common_modules, file.enum_common_counts, file.enum_common_starts, file.enum_common_fields, file.enum_common_field_names, structs)
            # Registration walks declarations in SOURCE order, and a payload field whose type
            # is a packed enum declared LATER resolved to Unmodeled -- which declined the whole
            # referring enum, so every match and construction over it went with it. stage0 has
            # no such order dependence: moving the two declarations past each other compiled the
            # byte-identical program. Reserving the names first removes the asymmetry.
            for enum_index in 0..<file.payload_enum_names.count |file, membership, structs|:
                enum_name: sview = file.payload_enum_names[enum_index]
                continue if file.payload_enum_is_const[enum_index] or file.payload_enum_variant_counts[enum_index] == 0
                payload_owner: sview = file.payload_enum_owners[enum_index] if enum_index < file.payload_enum_owners.count else ""
                reserve_packed_placeholder(enum_name, structs, payload_owner) if enum_index < membership.payload_enums.count and membership.payload_enums[enum_index]
            for enum_index in 0..<file.payload_enum_names.count |file, packed_or_ast, membership, structs|:
                payload_owner: sview = file.payload_enum_owners[enum_index] if enum_index < file.payload_enum_owners.count else ""
                continue if enum_index >= membership.payload_enums.count or not membership.payload_enums[enum_index]
                register_packed_enum_entry_flat(file.payload_enum_names[enum_index], file.payload_enum_variant_names, file.payload_enum_variant_fields, file.payload_enum_variant_field_names, file.payload_enum_variant_field_starts, file.payload_enum_variant_field_counts, file.payload_enum_variant_starts[enum_index], file.payload_enum_variant_counts[enum_index], file.payload_enum_is_const[enum_index], packed_or_ast, file.enum_common_owners, file.enum_common_modules, file.enum_common_counts, structs, payload_owner)
            # A hierarchy ROOT is declared variant-less, so registration gives it a row of
            # size zero -- but every one of its refinements' rows lives in ITS store, so the
            # stride has to cover the widest of them. Propagate that here, after every member
            # is registered. Without it the store was created with a zero-word row and the
            # first construction wrote past it.
            for root_index in 0..<structs.packed_enums.packed_names.count |structs|:
                continue if structs.packed_enums.packed_variant_count[root_index] != 0.usize()
                continue if not packed_slot_is_hierarchy_root(structs, root_index.i64())
                widest_words: mutable u32 = 0
                widest_commons: mutable u32 = 0
                for member_index in 0..<structs.packed_enums.packed_names.count |widest_words, widest_commons, structs, root_index|:
                    continue if member_index == root_index
                    continue if packed_hierarchy_root_name_at_slot(structs, member_index.i64()) != structs.packed_enums.packed_names[root_index] or packed_owner_at(structs, member_index) != packed_owner_at(structs, root_index)
                    widest_words <- structs.packed_enums.packed_payload_words[member_index] if structs.packed_enums.packed_payload_words[member_index] > widest_words
                    widest_commons <- structs.packed_enums.packed_common_counts[member_index] if structs.packed_enums.packed_common_counts[member_index] > widest_commons
                structs.packed_enums.packed_payload_words[root_index] <- widest_words
                structs.packed_enums.packed_common_counts[root_index] <- widest_commons
                # ...and the common field NAMES. register_packed_common_names reads them off
                # a variant's field list, so a variant-less root registers none -- and then
                # reading a common field through the ROOT type (`w.x` where w: Widget) found
                # no entry and silently produced the wrong word. The members all inherit the
                # root's commons, so any member's list is the root's list.
                copied_names: mutable bool = false
                for donor_index in 0..<structs.packed_enums.packed_names.count |copied_names, structs, root_index, widest_commons|:
                    continue if copied_names or donor_index == root_index
                    continue if packed_hierarchy_root_name_at_slot(structs, donor_index.i64()) != structs.packed_enums.packed_names[root_index] or packed_owner_at(structs, donor_index) != packed_owner_at(structs, root_index)
                    continue if structs.packed_enums.packed_common_counts[donor_index] != widest_commons or widest_commons == 0
                    donor_seen: mutable u32 = 0
                    # The body appends inherited metadata to packed_common_owners. Capture the
                    # source bound before walking it, otherwise a multi-common hierarchy makes
                    # the compiler chase its own newly appended tail indefinitely.
                    donor_probe_limit: usize = structs.packed_enums.packed_common_owners.count
                    for probe in 0..<donor_probe_limit |donor_seen, structs, donor_index, root_index|:
                        continue if structs.packed_enums.packed_common_owners[probe] != structs.packed_enums.packed_names[donor_index] or probe >= structs.packed_enums.packed_common_modules.count or structs.packed_enums.packed_common_modules[probe] != packed_owner_at(structs, donor_index)
                        structs.packed_enums.packed_common_owners <- structs.packed_enums.packed_common_owners.push(structs.packed_enums.packed_names[root_index])
                        structs.packed_enums.packed_common_modules <- structs.packed_enums.packed_common_modules.push(packed_owner_at(structs, root_index))
                        structs.packed_enums.packed_common_names <- structs.packed_enums.packed_common_names.push(structs.packed_enums.packed_common_names[probe])
                        structs.packed_enums.packed_common_types <- structs.packed_enums.packed_common_types.push(copied_type(structs.packed_enums.packed_common_types[probe])) if probe < structs.packed_enums.packed_common_types.count
                        donor_seen <- donor_seen + 1
                    copied_names <- true if donor_seen > 0
            for enum_index in 0..<file.enum_decl_names.count |file, packed_or_ast, membership, structs|:
                register_packed_decl_from_metadata(file, enum_index, packed_or_ast, membership, structs)




        def penum_owner_at(structs: StructTable&, index: usize) -> sview can[Abort.Panic]:
            return structs.payload_enums.penum_owners[index] if index < structs.payload_enums.penum_owners.count
            return ""



        const PAYLOAD_ENUM_NAME_CHAIN_THRESHOLD: usize = 32

        # Build only after finalize_payload_enum_words, which can tombstone an unusable enum
        # by blanking its name. From that point onward the registry is append-only and these
        # chains can safely accelerate both exact-owner and qualified-head lookups.
        def penum_name_chain_extend(structs: mutable StructTable&) -> void can[Abort.Panic, Memory.Allocate]:
            live_names: mutable usize = 0
            for index in 0..<structs.payload_enums.penum_names.count |live_names, structs|:
                live_names <- live_names + 1 if structs.payload_enums.penum_names[index] != ""
            return if live_names < PAYLOAD_ENUM_NAME_CHAIN_THRESHOLD
            name_chain_extend(structs.payload_enums.penum_name_buckets, structs.payload_enums.penum_name_tails, structs.payload_enums.penum_name_next, structs.payload_enums.penum_names)




        def penum_index_of_owned(structs: StructTable&, owner: sview, name: sview) -> i64 can[Abort.Panic]:
            index: mutable i64 = name_chain_first(structs.payload_enums.penum_name_buckets, structs.payload_enums.penum_name_next, structs.payload_enums.penum_names, name)
            while index >= 0 |index, structs, owner, name|:
                return index if structs.payload_enums.penum_names[index.usize()] == name and penum_owner_at(structs, index.usize()) == owner
                index <- name_chain_next(structs.payload_enums.penum_name_buckets, structs.payload_enums.penum_name_next, structs.payload_enums.penum_names, name, index)
            return -1



        # Resolve a payload enum by lexical owner first, then top-level, and finally only
        # when the leaf name is globally unique. The previous first-row fallback made two
        # modules with Result enums share one representation and could bind a constructor or
        # tag test to the wrong variant table.
        def penum_index_of(structs: StructTable&, name: sview) -> i64 can[Abort.Panic]:
            if structs.visibility.current_owner != "":
                owned: i64 = penum_index_of_owned(structs, structs.visibility.current_owner, name)
                return owned if owned >= 0
            top_level: i64 = penum_index_of_owned(structs, "", name)
            return top_level if top_level >= 0
            found: mutable i64 = -1
            matches: mutable i64 = 0
            index: mutable i64 = name_chain_first(structs.payload_enums.penum_name_buckets, structs.payload_enums.penum_name_next, structs.payload_enums.penum_names, name)
            while index >= 0 |found, matches, index, structs, name|:
                if structs.payload_enums.penum_names[index.usize()] == name:
                    found <- index
                    matches <- matches + 1
                index <- name_chain_next(structs.payload_enums.penum_name_buckets, structs.payload_enums.penum_name_next, structs.payload_enums.penum_names, name, index)
            return found if matches == 1
            # A refinement of an INLINE hierarchy is an alias of its root's payload enum.
            # Resolve it with the same lexical-owner rules as real payload rows; the old
            # first alias fallback let one module's `Decl` capture another's representation.
            if structs.visibility.current_owner != "":
                owned_alias: i64 = alias_index_of_owned(structs, structs.visibility.current_owner, name)
                if owned_alias >= 0:
                    owned_type: ValueType = structs.aliases.alias_types[owned_alias.usize()]
                    return owned_type.bits.i64() if owned_type.kind == TypeKind.PayloadEnum and owned_type.bits.usize() < structs.payload_enums.penum_names.count
            top_alias: i64 = alias_index_of_owned(structs, "", name)
            if top_alias >= 0:
                top_type: ValueType = structs.aliases.alias_types[top_alias.usize()]
                return top_type.bits.i64() if top_type.kind == TypeKind.PayloadEnum and top_type.bits.usize() < structs.payload_enums.penum_names.count
            alias_found: mutable i64 = -1
            alias_matches: mutable i64 = 0
            for alias_index in 0..<structs.aliases.alias_names.count |alias_found, alias_matches, structs, name|:
                continue if structs.aliases.alias_names[alias_index] != name
                continue if alias_index >= structs.aliases.alias_types.count
                candidate_type: ValueType = structs.aliases.alias_types[alias_index]
                if candidate_type.kind == TypeKind.PayloadEnum and candidate_type.bits.usize() < structs.payload_enums.penum_names.count:
                    alias_found <- candidate_type.bits.i64()
                    alias_matches <- alias_matches + 1
            return alias_found if alias_matches == 1
            return -1



        # The qualified head form used by constructors and variant tests. The leaf name is
        # not sufficient when modules independently declare the same payload enum.
        def penum_index_of_head(structs: StructTable&, head: Expr) -> i64 can[Abort.Panic]:
            can Abort.Panic:
                match head:
                    Expr.Ident(head_name, head_line):
                        return penum_index_of(structs, head_name)
                    Expr.Scope(scope_base, scoped_name, scoped_line):
                        best: mutable i64 = -1
                        best_rank: mutable i64 = -1
                        enum_index: mutable i64 = name_chain_first(structs.payload_enums.penum_name_buckets, structs.payload_enums.penum_name_next, structs.payload_enums.penum_names, scoped_name)
                        while enum_index >= 0 |structs, scope_base, best, best_rank, enum_index|:
                            candidate_owner: sview = penum_owner_at(structs, enum_index.usize())
                            if candidate_owner != "":
                                rank: i64 = enum_scope_path_rank(candidate_owner, scope_base, structs)
                                if rank > best_rank:
                                    best <- enum_index
                                    best_rank <- rank
                            enum_index <- name_chain_next(structs.payload_enums.penum_name_buckets, structs.payload_enums.penum_name_next, structs.payload_enums.penum_names, scoped_name, enum_index)
                        return best if best >= 0
                        # Inline hierarchy members are aliases of the root row rather than
                        # separate `penum_names` entries. Keep the module qualifier attached
                        # while resolving the alias, and decline if multiple compatible
                        # aliases would produce different payload rows.
                        alias_found: mutable i64 = -1
                        alias_matches: mutable i64 = 0
                        for alias_index in 0..<structs.aliases.alias_names.count |alias_found, alias_matches, structs, scope_base, scoped_name|:
                            continue if structs.aliases.alias_names[alias_index] != scoped_name or alias_index >= structs.aliases.alias_types.count
                            alias_owner: sview = alias_owner_at(structs, alias_index)
                            direct_alias_match: bool = alias_owner != "" and enum_scope_path_matches_range(alias_owner, 0, alias_owner.len, scope_base, structs)
                            enclosing_alias_match: bool = structs.visibility.current_owner != "" and enum_scope_path_matches_enclosing(alias_owner, structs.visibility.current_owner, scope_base, structs)
                            continue if not direct_alias_match and not enclosing_alias_match
                            alias_type: ValueType = structs.aliases.alias_types[alias_index]
                            continue if alias_type.kind != TypeKind.PayloadEnum or alias_type.bits.usize() >= structs.payload_enums.penum_names.count
                            alias_found <- alias_type.bits.i64()
                            alias_matches <- alias_matches + 1
                        return alias_found if alias_matches == 1
                    _:
                        pass
                return -1




        # A variant's TAG is its index within its own enum's span, matching stage0, where the
        # tag compare is `icmp eq i32 %tag, <declaration ordinal>`. -1 when unknown.
        # `Owner.V` inside a payload enum's span: the row DECLARED by `owner` (a refinement
        # of an inline hierarchy, or the enum itself) named `variant_name`. Falls back to a
        # name-only match, which is what a plain enum needs and what the old lookup did.
        def penum_variant_index_owned(structs: StructTable&, enum_index: i64, owner: sview, variant_name: sview) -> i64 can[Abort.Panic]:
            start: usize = structs.payload_enums.penum_variant_start[enum_index.usize()]
            count: usize = structs.payload_enums.penum_variant_count[enum_index.usize()]
            for offset in 0..<count |structs, start, owner, variant_name|:
                slot: usize = start + offset
                continue if structs.payload_enums.penum_variants[slot] != variant_name
                return offset.i64() if slot >= structs.payload_enums.penum_variant_owners.count or structs.payload_enums.penum_variant_owners[slot] == owner
            return penum_variant_index(structs, enum_index, variant_name)



        def penum_variant_index(structs: StructTable&, enum_index: i64, variant_name: sview) -> i64 can[Abort.Panic]:
            start: usize = structs.payload_enums.penum_variant_start[enum_index.usize()]
            count: usize = structs.payload_enums.penum_variant_count[enum_index.usize()]
            offset: mutable usize = 0
            while offset < count |offset, structs, start, variant_name|:
                return offset.i64() if structs.payload_enums.penum_variants[start + offset] == variant_name
                offset <- offset + 1
            return -1
