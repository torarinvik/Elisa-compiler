# Elisa bindings of elisa_llvm_ir_edits.h: IR edits the LLVM C API lacks.
extern ElisaValueMapRef

extern ElisaLLVMSetIncomingBlock(phi: LLVMValueRef, index: u32, block: LLVMBasicBlockRef) -> void
extern ElisaLLVMDeleteDeadBlocks(blocks: void&, count: u32) -> void
extern ElisaLLVMSetICmpPredicate(compare: LLVMValueRef, predicate: i32) -> void
extern ElisaLLVMRecursivelyDeleteTriviallyDeadInstructions(value: LLVMValueRef) -> void
extern ElisaLLVMCloneFunction(function: LLVMValueRef) -> LLVMValueRef
extern ElisaLLVMAdoptFunctionBody(function: LLVMValueRef, donor: LLVMValueRef) -> void
extern ElisaLLVMInlineCall(call: LLVMValueRef) -> i32
extern ElisaLLVMRemoveUnreachableBlocks(function: LLVMValueRef) -> i32
extern ElisaLLVMRemoveIncomingForBlock(phi: LLVMValueRef, block: LLVMBasicBlockRef) -> void
extern ElisaLLVMRemoveIncomingValue(phi: LLVMValueRef, index: u32) -> void
extern ElisaLLVMSplitBlock(instruction: LLVMValueRef) -> LLVMBasicBlockRef
extern ElisaLLVMSplitEdge(source: LLVMBasicBlockRef, destination: LLVMBasicBlockRef) -> LLVMBasicBlockRef
extern ElisaLLVMCreateValueMap() -> ElisaValueMapRef
extern ElisaLLVMDisposeValueMap(map: ElisaValueMapRef) -> void
extern ElisaLLVMValueMapSet(map: ElisaValueMapRef, key: LLVMValueRef, value: LLVMValueRef) -> void
extern ElisaLLVMValueMapGet(map: ElisaValueMapRef, key: LLVMValueRef) -> LLVMValueRef?
extern ElisaLLVMCloneBasicBlock(block: LLVMBasicBlockRef, map: ElisaValueMapRef, suffix: cstr, function: LLVMValueRef) -> LLVMBasicBlockRef
extern ElisaLLVMRemapInstruction(instruction: LLVMValueRef, map: ElisaValueMapRef) -> void
extern ElisaLLVMRemapInstructionKeepingModule(instruction: LLVMValueRef, map: ElisaValueMapRef) -> void
extern ElisaLLVMMetadataIsDistinct(node: LLVMMetadataRef) -> i32
extern ElisaLLVMEraseNamedMetadata(node: void&) -> void
extern ElisaLLVMCloneFunctionWithMap(function: LLVMValueRef, map: ElisaValueMapRef) -> LLVMValueRef
extern ElisaLLVMMoveInstructionToBlockEnd(instruction: LLVMValueRef, block: LLVMBasicBlockRef) -> void
extern ElisaLLVMSetCallAttributesFromFunction(call: LLVMValueRef, function: LLVMValueRef) -> void
extern ElisaLLVMEmitGEPOffset(builder: LLVMBuilderRef, gep: LLVMValueRef) -> LLVMValueRef
extern ElisaLLVMBlockDropAllReferences(block: LLVMBasicBlockRef) -> void
extern ElisaLLVMBlockRemovePredecessor(block: LLVMBasicBlockRef, predecessor: LLVMBasicBlockRef, keep_one_input_phis: i32) -> void
