# Elisa bindings of elisa_llvm_analysis.h: the LLVM analyses the
# Elisa-hosted passes need beyond LLVM's own C API.
include "./elisa_llvm_constant_range.elisa"

extern ElisaFunctionAnalysesRef
extern ElisaLoopRef

extern ElisaLLVMCreateFunctionAnalyses(function: LLVMValueRef) -> ElisaFunctionAnalysesRef?
extern ElisaLLVMDisposeFunctionAnalyses(analyses: ElisaFunctionAnalysesRef) -> void
extern ElisaLLVMInvalidateFunctionAnalyses(analyses: ElisaFunctionAnalysesRef) -> void

extern ElisaLLVMBlockDominates(analyses: ElisaFunctionAnalysesRef, dominator: LLVMBasicBlockRef, dominated: LLVMBasicBlockRef) -> i32
extern ElisaLLVMInstructionDominates(analyses: ElisaFunctionAnalysesRef, definition: LLVMValueRef, user: LLVMValueRef) -> i32
extern ElisaLLVMImmediateDominator(analyses: ElisaFunctionAnalysesRef, block: LLVMBasicBlockRef) -> LLVMBasicBlockRef?
extern ElisaLLVMEdgeDominates(analyses: ElisaFunctionAnalysesRef, edge_source: LLVMBasicBlockRef, edge_target: LLVMBasicBlockRef, use: LLVMBasicBlockRef) -> i32

extern ElisaLLVMLoopCount(analyses: ElisaFunctionAnalysesRef) -> u32
extern ElisaLLVMLoopAt(analyses: ElisaFunctionAnalysesRef, index: u32) -> ElisaLoopRef
extern ElisaLLVMLoopForBlock(analyses: ElisaFunctionAnalysesRef, block: LLVMBasicBlockRef) -> ElisaLoopRef?
extern ElisaLLVMLoopParent(loop: ElisaLoopRef) -> ElisaLoopRef?
extern ElisaLLVMLoopDepth(loop: ElisaLoopRef) -> u32
extern ElisaLLVMLoopSubLoopCount(loop: ElisaLoopRef) -> u32
extern ElisaLLVMLoopBlockCount(loop: ElisaLoopRef) -> u32
extern ElisaLLVMLoopBlockAt(loop: ElisaLoopRef, index: u32) -> LLVMBasicBlockRef
extern ElisaLLVMLoopContainsBlock(loop: ElisaLoopRef, block: LLVMBasicBlockRef) -> i32
extern ElisaLLVMLoopHeader(loop: ElisaLoopRef) -> LLVMBasicBlockRef
extern ElisaLLVMLoopLatch(loop: ElisaLoopRef) -> LLVMBasicBlockRef?
extern ElisaLLVMLoopPreheader(loop: ElisaLoopRef) -> LLVMBasicBlockRef?
extern ElisaLLVMLoopPredecessor(loop: ElisaLoopRef) -> LLVMBasicBlockRef?
extern ElisaLLVMLoopIsInvariant(loop: ElisaLoopRef, value: LLVMValueRef) -> i32
extern ElisaLLVMLoopGetLoopID(loop: ElisaLoopRef) -> void&?
extern ElisaLLVMLoopSetLoopID(loop: ElisaLoopRef, loop_id: LLVMMetadataRef) -> void
# `properties` points at `count` LLVMMetadataRef handles.
extern ElisaLLVMCreateLoopID(context: LLVMContextRef, properties: void&, count: u32) -> LLVMMetadataRef

extern ElisaLLVMModuleTargetIsAArch64(module: LLVMModuleRef) -> i32
extern ElisaLLVMModuleTargetArchIsAArch64(module: LLVMModuleRef) -> i32
extern ElisaLLVMModuleTargetIsDarwin(module: LLVMModuleRef) -> i32

extern ElisaLLVMBlockHasAddressTaken(block: LLVMBasicBlockRef) -> i32
extern ElisaLLVMHasMetadataOtherThanDebugLoc(instruction: LLVMValueRef) -> i32
extern ElisaLLVMIsConstantOne(value: LLVMValueRef) -> i32
extern ElisaLLVMIsConstantZero(value: LLVMValueRef) -> i32
extern ElisaLLVMIsSpecificInt(value: LLVMValueRef, expected: u64) -> i32
extern ElisaLLVMMayHaveSideEffects(instruction: LLVMValueRef) -> i32
extern ElisaLLVMCallDoesNotAccessMemory(call: LLVMValueRef) -> i32
extern ElisaLLVMFunctionHasEntryCount(function: LLVMValueRef) -> i32
extern ElisaLLVMConstantIntIsNegative(constant: LLVMValueRef) -> i32
extern ElisaLLVMConstantIntIsPositivePowerOfTwo(constant: LLVMValueRef) -> i32
extern ElisaLLVMConstantIntEquals(constant: LLVMValueRef, value: u64) -> i32
extern ElisaLLVMConstantIntActiveBits(constant: LLVMValueRef) -> u32
extern ElisaLLVMConstantIntMaskWidth(constant: LLVMValueRef) -> u32
extern ElisaLLVMConstantIntUnsignedGreater(first: LLVMValueRef, second: LLVMValueRef) -> i32
extern ElisaLLVMConstantIntTrailingZeros(constant: LLVMValueRef) -> u32
extern ElisaLLVMConstantIntOddPart(constant: LLVMValueRef) -> LLVMValueRef
extern ElisaLLVMConstantIntLowBits(type: LLVMTypeRef, bits: u32) -> LLVMValueRef
extern ElisaLLVMConstantIntsAgreeInLowBits(first: LLVMValueRef, second: LLVMValueRef, bits: u32) -> i32
extern ElisaLLVMMayReadOrWriteMemory(instruction: LLVMValueRef) -> i32
extern ElisaLLVMStripPointerCasts(value: LLVMValueRef) -> LLVMValueRef
extern ElisaLLVMConstantFloatIsNegativeFiniteNonzero(constant: LLVMValueRef) -> i32
extern ElisaLLVMIsGuaranteedNotToBeUndefOrPoison(value: LLVMValueRef) -> i32
extern ElisaLLVMIsGuaranteedNotToBeUndefOrPoisonAt(analyses: ElisaFunctionAnalysesRef, value: LLVMValueRef, context: LLVMValueRef) -> i32
extern ElisaLLVMLazyValueConstantRange(analyses: ElisaFunctionAnalysesRef, value: LLVMValueRef, context: LLVMValueRef, undef_allowed: i32) -> ElisaConstantRangeRef
extern ElisaLLVMIsImpliedCondition(condition: LLVMValueRef, implied: LLVMValueRef, module: LLVMModuleRef, condition_is_true: i32) -> i32

extern ElisaLLVMConstantMaxBackedgeTakenCount(analyses: ElisaFunctionAnalysesRef, loop: ElisaLoopRef, count: mutable u64&) -> i32
extern ElisaLLVMScalarEvolutionUnsignedMaxActiveBits(analyses: ElisaFunctionAnalysesRef, value: LLVMValueRef) -> u32
