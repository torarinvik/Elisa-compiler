# Elisa bindings of elisa_llvm_loop_transforms.h: LLVM's loop transformation utilities.
extern ElisaLLVMTopLevelLoopCount(analyses: ElisaFunctionAnalysesRef) -> u32
extern ElisaLLVMTopLevelLoopAt(analyses: ElisaFunctionAnalysesRef, index: u32) -> ElisaLoopRef
extern ElisaLLVMLoopSubLoopAt(loop: ElisaLoopRef, index: u32) -> ElisaLoopRef
extern ElisaLLVMLoopIsSimplifyForm(loop: ElisaLoopRef) -> i32
extern ElisaLLVMSimplifyLoop(analyses: ElisaFunctionAnalysesRef, loop: ElisaLoopRef, preserve_lcssa: i32) -> i32
extern ElisaLLVMFormLCSSA(analyses: ElisaFunctionAnalysesRef, loop: ElisaLoopRef) -> i32
extern ElisaLLVMCanPeelLoop(loop: ElisaLoopRef) -> i32
extern ElisaLLVMPeelLoop(analyses: ElisaFunctionAnalysesRef, loop: ElisaLoopRef, count: u32, peel_last: i32, preserve_lcssa: i32) -> void
extern ElisaLLVMSplitBlockKeepingLoops(analyses: ElisaFunctionAnalysesRef, instruction: LLVMValueRef, name: cstr) -> LLVMBasicBlockRef
extern ElisaLLVMCloneLoopWithPreheader(analyses: ElisaFunctionAnalysesRef, before: LLVMBasicBlockRef, loop_dominator: LLVMBasicBlockRef, loop: ElisaLoopRef, map: ElisaValueMapRef, suffix: cstr) -> ElisaLoopRef
extern ElisaLLVMUnrollLoop(analyses: ElisaFunctionAnalysesRef, loop: ElisaLoopRef, count: u32, flags: u32, expansion_budget: u32) -> u32

# The UnrollLoopOptions flags of ElisaLLVMUnrollLoop.
const module ElisaUnrollFlag:
    FORCE: u32 = 1
    RUNTIME: u32 = 2
    ALLOW_EXPENSIVE_TRIP_COUNT: u32 = 4
    UNROLL_REMAINDER: u32 = 8
    FORGET_ALL_SCEV: u32 = 16
    RUNTIME_MULTI_EXIT: u32 = 32
    ADD_ADDITIONAL_ACCUMULATORS: u32 = 64
    PRESERVE_LCSSA: u32 = 128

# LoopUnrollResult.
const module ElisaUnrollResult:
    UNMODIFIED: u32 = 0
