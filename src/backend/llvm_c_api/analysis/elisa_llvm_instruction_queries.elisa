# Elisa bindings of elisa_llvm_instruction_queries.h: what one instruction may do to
# memory, and whether it may run speculatively at another point.
extern ElisaLLVMMayHaveSideEffects(instruction: LLVMValueRef) -> i32
extern ElisaLLVMMayReadOrWriteMemory(instruction: LLVMValueRef) -> i32
extern ElisaLLVMMayReadFromMemory(instruction: LLVMValueRef) -> i32
extern ElisaLLVMMayWriteToMemory(instruction: LLVMValueRef) -> i32
extern ElisaLLVMIsSafeToSpeculativelyExecuteAt(instruction: LLVMValueRef, context: LLVMValueRef) -> i32
extern ElisaLLVMCallOnlyReadsMemory(call: LLVMValueRef) -> i32
extern ElisaLLVMCallOnlyAccessesInaccessibleMemory(call: LLVMValueRef) -> i32
extern ElisaLLVMMemoryIntrinsicDestinationAlignment(intrinsic: LLVMValueRef) -> u32
