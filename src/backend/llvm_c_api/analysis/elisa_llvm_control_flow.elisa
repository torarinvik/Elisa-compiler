# Elisa bindings of elisa_llvm_control_flow.h: reachability between instructions and
# blocks, and whether an instruction runs on every iteration of a loop.
extern ElisaLLVMInstructionIsPotentiallyReachable(from: LLVMValueRef, target: LLVMValueRef) -> i32
extern ElisaLLVMInstructionIsPotentiallyReachableWithin(analyses: ElisaFunctionAnalysesRef, from: LLVMValueRef, target: LLVMValueRef) -> i32
extern ElisaLLVMBlockIsPotentiallyReachableWithin(analyses: ElisaFunctionAnalysesRef, from: LLVMBasicBlockRef, target: LLVMBasicBlockRef, use_loops: i32) -> i32
extern ElisaLLVMLoopIsGuaranteedToExecute(analyses: ElisaFunctionAnalysesRef, loop: ElisaLoopRef, instruction: LLVMValueRef) -> i32
