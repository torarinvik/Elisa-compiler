# Elisa bindings of elisa_llvm_scalar_evolution_expressions.h: scalar evolution's
# expression trees (a loop exit's count) and the unsigned range of any node.
include "./elisa_llvm_analysis.elisa"

extern ElisaScalarEvolutionExpressionRef

# The node kinds of ElisaScalarEvolutionKind.
const module ElisaScalarEvolutionKind:
    COULD_NOT_COMPUTE: u32 = 0
    CONSTANT: u32 = 1
    UNKNOWN: u32 = 2
    TRUNCATE: u32 = 3
    ZERO_EXTEND: u32 = 4
    SIGN_EXTEND: u32 = 5
    OTHER_CAST: u32 = 6
    ADD: u32 = 7
    MULTIPLY: u32 = 8
    UNSIGNED_MINIMUM: u32 = 9
    UNSIGNED_MAXIMUM: u32 = 10
    SIGNED_MINIMUM: u32 = 11
    SIGNED_MAXIMUM: u32 = 12
    OTHER_OPERATION: u32 = 13
    OTHER: u32 = 14
    ADD_RECURRENCE: u32 = 15
    UNSIGNED_DIVIDE: u32 = 16

extern ElisaLLVMScalarEvolutionExitCount(analyses: ElisaFunctionAnalysesRef, loop: ElisaLoopRef, exiting_block: LLVMBasicBlockRef) -> ElisaScalarEvolutionExpressionRef
extern ElisaLLVMScalarEvolutionExpressionKind(expression: ElisaScalarEvolutionExpressionRef) -> u32
extern ElisaLLVMScalarEvolutionExpressionType(expression: ElisaScalarEvolutionExpressionRef) -> LLVMTypeRef
extern ElisaLLVMScalarEvolutionExpressionOperandCount(expression: ElisaScalarEvolutionExpressionRef) -> u32
extern ElisaLLVMScalarEvolutionExpressionOperandAt(expression: ElisaScalarEvolutionExpressionRef, index: u32) -> ElisaScalarEvolutionExpressionRef
extern ElisaLLVMScalarEvolutionExpressionValue(expression: ElisaScalarEvolutionExpressionRef) -> LLVMValueRef
extern ElisaLLVMScalarEvolutionOfValue(analyses: ElisaFunctionAnalysesRef, value: LLVMValueRef) -> ElisaScalarEvolutionExpressionRef
extern ElisaLLVMScalarEvolutionConstantOf(analyses: ElisaFunctionAnalysesRef, type: LLVMTypeRef, value: u64) -> ElisaScalarEvolutionExpressionRef
extern ElisaLLVMScalarEvolutionRewriteValue(analyses: ElisaFunctionAnalysesRef, expression: ElisaScalarEvolutionExpressionRef, value: LLVMValueRef, replacement: ElisaScalarEvolutionExpressionRef) -> ElisaScalarEvolutionExpressionRef
extern ElisaLLVMScalarEvolutionRecurrenceLoop(expression: ElisaScalarEvolutionExpressionRef) -> ElisaLoopRef?
extern ElisaLLVMScalarEvolutionEvaluateAtIteration(analyses: ElisaFunctionAnalysesRef, recurrence: ElisaScalarEvolutionExpressionRef, iteration: ElisaScalarEvolutionExpressionRef) -> ElisaScalarEvolutionExpressionRef
extern ElisaLLVMScalarEvolutionApplyLoopGuards(analyses: ElisaFunctionAnalysesRef, expression: ElisaScalarEvolutionExpressionRef, loop: ElisaLoopRef) -> ElisaScalarEvolutionExpressionRef
extern ElisaLLVMScalarEvolutionPointerBase(analyses: ElisaFunctionAnalysesRef, expression: ElisaScalarEvolutionExpressionRef) -> ElisaScalarEvolutionExpressionRef
extern ElisaLLVMScalarEvolutionRemovePointerBase(analyses: ElisaFunctionAnalysesRef, expression: ElisaScalarEvolutionExpressionRef) -> ElisaScalarEvolutionExpressionRef
extern ElisaLLVMScalarEvolutionExpressionUnsignedRange(analyses: ElisaFunctionAnalysesRef, expression: ElisaScalarEvolutionExpressionRef) -> ElisaConstantRangeRef
