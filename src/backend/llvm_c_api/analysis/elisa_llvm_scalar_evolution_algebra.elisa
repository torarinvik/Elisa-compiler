# Elisa bindings of elisa_llvm_scalar_evolution_algebra.h: sums, differences, products,
# negations and add recurrences of scalar evolution expressions, and what scalar
# evolution knows about them.
include "./elisa_llvm_scalar_evolution_expressions.elisa"

extern ElisaLLVMScalarEvolutionAdd(analyses: ElisaFunctionAnalysesRef, left: ElisaScalarEvolutionExpressionRef, right: ElisaScalarEvolutionExpressionRef) -> ElisaScalarEvolutionExpressionRef
extern ElisaLLVMScalarEvolutionMinus(analyses: ElisaFunctionAnalysesRef, left: ElisaScalarEvolutionExpressionRef, right: ElisaScalarEvolutionExpressionRef) -> ElisaScalarEvolutionExpressionRef
extern ElisaLLVMScalarEvolutionMultiply(analyses: ElisaFunctionAnalysesRef, left: ElisaScalarEvolutionExpressionRef, right: ElisaScalarEvolutionExpressionRef) -> ElisaScalarEvolutionExpressionRef
extern ElisaLLVMScalarEvolutionNegate(analyses: ElisaFunctionAnalysesRef, value: ElisaScalarEvolutionExpressionRef) -> ElisaScalarEvolutionExpressionRef
extern ElisaLLVMScalarEvolutionAddTerms(analyses: ElisaFunctionAnalysesRef, terms: void&, count: u32) -> ElisaScalarEvolutionExpressionRef
extern ElisaLLVMScalarEvolutionMultiplyTerms(analyses: ElisaFunctionAnalysesRef, factors: void&, count: u32) -> ElisaScalarEvolutionExpressionRef
extern ElisaLLVMScalarEvolutionUnsignedDivideExact(analyses: ElisaFunctionAnalysesRef, dividend: ElisaScalarEvolutionExpressionRef, divisor: ElisaScalarEvolutionExpressionRef) -> ElisaScalarEvolutionExpressionRef
extern ElisaLLVMScalarEvolutionTruncateOrZeroExtend(analyses: ElisaFunctionAnalysesRef, expression: ElisaScalarEvolutionExpressionRef, type: LLVMTypeRef) -> ElisaScalarEvolutionExpressionRef
extern ElisaLLVMScalarEvolutionAddRecurrence(analyses: ElisaFunctionAnalysesRef, start: ElisaScalarEvolutionExpressionRef, step: ElisaScalarEvolutionExpressionRef, loop: ElisaLoopRef, no_unsigned_wrap: i32) -> ElisaScalarEvolutionExpressionRef
extern ElisaLLVMScalarEvolutionStepRecurrence(analyses: ElisaFunctionAnalysesRef, recurrence: ElisaScalarEvolutionExpressionRef) -> ElisaScalarEvolutionExpressionRef
extern ElisaLLVMScalarEvolutionSymbolicMaxBackedgeTakenCount(analyses: ElisaFunctionAnalysesRef, loop: ElisaLoopRef) -> ElisaScalarEvolutionExpressionRef
extern ElisaLLVMScalarEvolutionIsKnownPredicateAt(analyses: ElisaFunctionAnalysesRef, predicate: i32, left: ElisaScalarEvolutionExpressionRef, right: ElisaScalarEvolutionExpressionRef, at: LLVMValueRef) -> i32
extern ElisaLLVMScalarEvolutionIsKnownNonZero(analyses: ElisaFunctionAnalysesRef, expression: ElisaScalarEvolutionExpressionRef) -> i32
extern ElisaLLVMScalarEvolutionIsKnownNonNegative(analyses: ElisaFunctionAnalysesRef, expression: ElisaScalarEvolutionExpressionRef) -> i32
extern ElisaLLVMScalarEvolutionIsLoopInvariant(analyses: ElisaFunctionAnalysesRef, expression: ElisaScalarEvolutionExpressionRef, loop: ElisaLoopRef) -> i32
extern ElisaLLVMScalarEvolutionTypeSizeInBits(analyses: ElisaFunctionAnalysesRef, type: LLVMTypeRef) -> u32
