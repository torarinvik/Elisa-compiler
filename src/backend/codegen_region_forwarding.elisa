        def region_scan_forwarding_expression(expression: Expr, params: darray[ParamDecl]&, structs: mutable StructTable&, fact_row: usize, changed: mutable bool&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                if expression is Expr.Call(region_forward_call_callee, region_forward_call_arguments, region_forward_call_names, region_forward_call_line):
                    callee_name: sview = region_callee_name(region_forward_call_callee)
                    receiver_offset: mutable usize = 0.usize()
                    if region_forward_call_callee is Expr.Field(region_forward_arity_receiver, region_forward_arity_method, region_forward_arity_line):
                        receiver_offset <- 1.usize()
