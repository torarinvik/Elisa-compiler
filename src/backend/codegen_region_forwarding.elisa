                # exactly one row has the supplied arity, then gives any top-level name
                # precedence regardless of arity. The latter matters for defaulted
                # parameters, which are selected after this name-level dispatch.
                (structs.visibility.current_owner, true) return if structs.visibility.current_owner != "" and own_arity_hits == 1
