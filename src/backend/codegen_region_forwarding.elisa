                if expression is Expr.Binary(region_forward_binary_left, region_forward_binary_operator, region_forward_binary_right, region_forward_binary_line):
                    region_scan_forwarding_expression(region_forward_binary_left, params, structs, fact_row, changed)
                    region_scan_forwarding_expression(region_forward_binary_right, params, structs, fact_row, changed)
                    return
                if expression is Expr.Unary(region_forward_unary_operator, region_forward_unary_operand, region_forward_unary_line):
                    region_scan_forwarding_expression(region_forward_unary_operand, params, structs, fact_row, changed)
                    return
                if expression is Expr.Move(region_forward_move_operand, region_forward_move_line):
                    region_scan_forwarding_expression(region_forward_move_operand, params, structs, fact_row, changed)
                    return
                if expression is Expr.RegionNew(region_forward_new_operand, region_forward_new_region, region_forward_new_line):
                    region_scan_forwarding_expression(region_forward_new_operand, params, structs, fact_row, changed)
