                        # A scalar member write is not growth of the containing struct.
                        if region_assign_target is Expr.Ident(assigned_name, assigned_pos):
                            region_mark_root(assigned_name, params, flags, structs)
                        region_scan_expression(region_assign_target, params, flags, structs)
                        region_scan_expression(region_assign_value, params, flags, structs)
                    elif region_statement is Stmt.Return(region_return_value, region_return_line):
                        if region_return_value is region_returned:
                            region_scan_expression(region_returned, params, flags, structs)
                    elif region_statement is Stmt.If(region_stmt_if_condition, region_stmt_if_then, region_stmt_if_else, region_stmt_if_line):
                        region_scan_expression(region_stmt_if_condition, params, flags, structs)
                        region_scan_statements(region_stmt_if_then, params, flags, structs)
                        region_scan_statements(region_stmt_if_else, params, flags, structs)
                    elif region_statement is Stmt.While(region_stmt_while_condition, region_stmt_while_body, region_stmt_while_line):
                        region_scan_expression(region_stmt_while_condition, params, flags, structs)
                        region_scan_statements(region_stmt_while_body, params, flags, structs)
                    elif region_statement is Stmt.For(region_for_bind, region_for_variables, region_for_iterable, region_for_body, region_for_line):
                        region_scan_expression(region_for_iterable, params, flags, structs)
                        region_scan_statements(region_for_body, params, flags, structs)
                    elif region_statement is Stmt.Block(region_stmt_block_kind, region_stmt_block_clause, region_stmt_block_binding, region_stmt_block_body, region_stmt_block_line):
                        skipped_in_block: bool = structs.memory.region_scan_skips_in_blocks and region_stmt_block_kind == "in" and region_stmt_block_clause.count == 1 and region_stmt_block_clause[0] != "auto"
                        region_scan_statements(region_stmt_block_body, params, flags, structs) if not skipped_in_block
                    elif region_statement is Stmt.Match(region_stmt_match_scrutinee, region_stmt_match_arms, region_stmt_match_line):
                        region_scan_expression(region_stmt_match_scrutinee, params, flags, structs)
