                    position: i64 = (argument_index + receiver_offset).i64()
                    if named_call:
                        position <- positions[argument_index] if argument_index < positions.count else -1
                    if position >= minimum_position.i64() and position < count.i64():
                        region_mark_forwarded(root, position.usize(), row, params, structs, fact_row, changed)
                    elif position < 0:
