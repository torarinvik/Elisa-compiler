# Stage1 backend — the region-forwarding PRE-PASS: walk each body, mark the locals and callees
# that allocate into a caller's region, and record the forwarded flags the signature facts in
# codegen_abi_regions.elisa then read. Part of `module Backend` (see codegen.elisa).

extend Backend:
    private:
        const REGION_FACT_BUCKET_COUNT: usize = 1024
        const REGION_FACT_HASH_OFFSET: u64 = 14695981039346656037
        const REGION_FACT_HASH_PRIME: u64 = 1099511628211

        def region_fact_name_bucket(name: sview) -> usize:
            hash: mutable u64 = REGION_FACT_HASH_OFFSET
            for index in 0..<sview_len(name) |hash, name|:
                hash <- (hash ^ sview_at(name, index).u64()) * REGION_FACT_HASH_PRIME
            return (hash % REGION_FACT_BUCKET_COUNT.u64()).usize()

        def region_build_name_index(structs: mutable StructTable&) -> void can[Abort.Panic, Memory.Allocate]:
            structs.region_fact_buckets <- []
            structs.region_fact_next <- []
            for _ in 0..<REGION_FACT_BUCKET_COUNT |structs|:
                structs.region_fact_buckets <- structs.region_fact_buckets.push(-1)
            for _ in 0..<structs.region_fact_names.count |structs|:
                structs.region_fact_next <- structs.region_fact_next.push(-1)
            # Prepend in reverse so collisions and duplicate names retain source order.
            remaining: mutable usize = structs.region_fact_names.count
            while remaining > 0 |remaining, structs|:
                remaining <- remaining - 1
                bucket: usize = region_fact_name_bucket(structs.region_fact_names[remaining])
                structs.region_fact_next[remaining] <- structs.region_fact_buckets[bucket]
                structs.region_fact_buckets[bucket] <- remaining.i64()


        def region_mark_root(root: sview, params: darray[ParamDecl]&, flags: mutable darray[bool]&, structs: mutable StructTable&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                return if root == ""
                for parameter_index in 0..<params.count |params, flags, root, structs|:
                    continue if params[parameter_index].name != root
                    parameter_type: ValueType = parameter_value_type(params[parameter_index].type_expression, structs)
                    flags[parameter_index] <- true if ref_type_can_grow(parameter_type, structs)
                    return




        def region_scan_expression(expression: Expr, params: darray[ParamDecl]&, flags: mutable darray[bool]&, structs: mutable StructTable&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                if expression is Expr.Call(region_call_callee, region_call_arguments, region_call_names, region_call_line):
                    if region_call_callee is Expr.Field(region_call_receiver, region_call_method, region_call_field_line):
                        region_mark_root(region_growth_root(region_call_receiver), params, flags, structs) if region_growth_method(region_call_method)
                    region_scan_expression(region_call_callee, params, flags, structs)
                    for region_call_argument in region_call_arguments |params, flags, structs|:
                        region_scan_expression(region_call_argument, params, flags, structs)
                    return
                if expression is Expr.Field(region_field_object, region_field_name, region_field_line):
                    region_scan_expression(region_field_object, params, flags, structs)
                    return
                if expression is Expr.Scope(region_scope_base, region_scope_name, region_scope_line):
                    region_scan_expression(region_scope_base, params, flags, structs)
                    return
                if expression is Expr.Index(region_index_object, region_index_value, region_index_line):
                    region_scan_expression(region_index_object, params, flags, structs)
                    region_scan_expression(region_index_value, params, flags, structs)
                    return
                if expression is Expr.Slice(region_slice_object, region_slice_low, region_slice_high, region_slice_line):
                    region_scan_expression(region_slice_object, params, flags, structs)
                    region_scan_expression(region_slice_low, params, flags, structs)
                    region_scan_expression(region_slice_high, params, flags, structs)
                    return
                if expression is Expr.IndexN(region_indexn_object, region_indexn_arguments, region_indexn_line):
                    region_scan_expression(region_indexn_object, params, flags, structs)
                    for region_indexn_argument in region_indexn_arguments |params, flags, structs|:
                        region_scan_expression(region_indexn_argument, params, flags, structs)
                    return
                if expression is Expr.Binary(region_binary_left, region_binary_operator, region_binary_right, region_binary_line):
                    region_scan_expression(region_binary_left, params, flags, structs)
                    region_scan_expression(region_binary_right, params, flags, structs)
                    return
                if expression is Expr.Unary(region_unary_operator, region_unary_operand, region_unary_line):
                    region_scan_expression(region_unary_operand, params, flags, structs)
                    return
                if expression is Expr.Move(region_move_operand, region_move_line):
                    region_scan_expression(region_move_operand, params, flags, structs)
                    return
                if expression is Expr.RegionNew(region_new_operand, region_new_region, region_new_line):
                    region_scan_expression(region_new_operand, params, flags, structs)
                    return
                if expression is Expr.Paren(region_paren_inner, region_paren_line):
                    region_scan_expression(region_paren_inner, params, flags, structs)
                    return
                if expression is Expr.Array(region_array_elements, region_array_line) or expression is Expr.Tuple(region_array_elements, region_tuple_line) or expression is Expr.SetLit(region_array_elements, region_set_line):
                    for region_element in region_array_elements |params, flags, structs|:
                        region_scan_expression(region_element, params, flags, structs)
                    return
                if expression is Expr.DictLit(region_dict_entries, region_dict_line):
                    for region_entry in region_dict_entries |params, flags, structs|:
                        region_scan_expression(region_entry.key, params, flags, structs)
                        region_scan_expression(region_entry.value, params, flags, structs)
                    return
                if expression is Expr.Construct(region_construct_type, region_construct_fields, region_construct_line):
                    region_scan_expression(region_construct_type, params, flags, structs)
                    for region_field_init in region_construct_fields |params, flags, structs|:
                        region_scan_expression(region_field_init.value, params, flags, structs)
                    return
                if expression is Expr.RecordUpdate(region_update_base, region_update_fields, region_update_line):
                    region_scan_expression(region_update_base, params, flags, structs)
                    for region_field_init in region_update_fields |params, flags, structs|:
                        region_scan_expression(region_field_init.value, params, flags, structs)
                    return
                if expression is Expr.If(region_if_condition, region_if_then, region_if_else, region_if_line):
                    region_scan_expression(region_if_condition, params, flags, structs)
                    region_scan_expression(region_if_then, params, flags, structs)
                    region_scan_expression(region_if_else, params, flags, structs)
                    return
                if expression is Expr.Match(region_match_scrutinee, region_match_arms, region_match_line) or expression is Expr.Catch(region_match_scrutinee, region_match_arms, region_catch_line):
                    region_scan_expression(region_match_scrutinee, params, flags, structs)
                    for region_arm in region_match_arms |params, flags, structs|:
                        region_scan_expression(region_arm.guard, params, flags, structs)
                        region_scan_statements(region_arm.body, params, flags, structs)
                    return
                if expression is Expr.Comprehension(region_comp_var, region_comp_iterable, region_comp_condition, region_comp_body, region_comp_line):
                    region_scan_expression(region_comp_iterable, params, flags, structs)
                    region_scan_expression(region_comp_condition, params, flags, structs)
                    region_scan_expression(region_comp_body, params, flags, structs)
                    return
                if expression is Expr.Refinement(region_refinement_base, region_refinement_predicate, region_refinement_line):
                    region_scan_expression(region_refinement_base, params, flags, structs)
                    region_scan_expression(region_refinement_predicate, params, flags, structs)
                    return
                if expression is Expr.GetElse(region_get_guarded, region_get_recovery, region_get_line):
                    region_scan_expression(region_get_guarded, params, flags, structs)
                    region_scan_statements(region_get_recovery, params, flags, structs)
                    return
                if expression is Expr.Block(region_block_statements, region_block_value, region_block_captures, region_block_line):
                    region_scan_statements(region_block_statements, params, flags, structs)
                    region_scan_expression(region_block_value, params, flags, structs)
                    return




        def region_scan_statements(statements: darray[Stmt], params: darray[ParamDecl]&, flags: mutable darray[bool]&, structs: mutable StructTable&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                for region_statement in statements |params, flags, structs|:
                    if region_statement is Stmt.Expr(region_statement_expression, region_statement_line):
                        region_scan_expression(region_statement_expression, params, flags, structs)
                    elif region_statement is Stmt.VarDecl(region_var_name, region_var_type, region_var_value, region_var_line):
                        region_scan_expression(region_var_type, params, flags, structs)
                        region_scan_expression(region_var_value, params, flags, structs)
                    elif region_statement is Stmt.Assign(region_assign_target, region_assign_operator, region_assign_value, region_assign_line):
                        region_scan_expression(region_assign_target, params, flags, structs)
                        region_scan_expression(region_assign_value, params, flags, structs)
                    elif region_statement is Stmt.Return(region_return_value, region_return_line):
                        if region_return_value is region_returned:
                            region_scan_expression(region_returned, params, flags, structs)
                    elif region_statement is Stmt.If(region_stmt_if_condition, region_stmt_if_then, region_stmt_if_else, region_stmt_if_line):
                        region_scan_expression(region_stmt_if_condition, params, flags, structs)
                        region_scan_statements(region_stmt_if_then, params, flags, structs)
                        region_scan_statements(region_stmt_if_else, params, flags, structs)
                    elif region_statement is Stmt.While(region_stmt_while_condition, region_stmt_while_body, region_stmt_while_line):
                        region_scan_expression(region_stmt_while_condition, params, flags, structs)
                        region_scan_statements(region_stmt_while_body, params, flags, structs)
                    elif region_statement is Stmt.For(region_for_bind, region_for_variables, region_for_iterable, region_for_body, region_for_line):
                        region_scan_expression(region_for_iterable, params, flags, structs)
                        region_scan_statements(region_for_body, params, flags, structs)
                    elif region_statement is Stmt.Block(region_stmt_block_kind, region_stmt_block_clause, region_stmt_block_binding, region_stmt_block_body, region_stmt_block_line):
                        region_scan_statements(region_stmt_block_body, params, flags, structs)
                    elif region_statement is Stmt.Match(region_stmt_match_scrutinee, region_stmt_match_arms, region_stmt_match_line):
                        region_scan_expression(region_stmt_match_scrutinee, params, flags, structs)
                        for region_stmt_arm in region_stmt_match_arms |params, flags, structs|:
                            region_scan_expression(region_stmt_arm.guard, params, flags, structs)
                            region_scan_statements(region_stmt_arm.body, params, flags, structs)
                    elif region_statement is Stmt.Contract(region_contract_kind, region_contract_expression, region_contract_line):
                        region_scan_expression(region_contract_expression, params, flags, structs)




        def body_region_parameter_flags(params: darray[ParamDecl]&, body: darray[Stmt], structs: mutable StructTable&, flags: mutable darray[bool]&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                for _ in 0..<params.count |flags|:
                    flags.push(false)
                region_scan_statements(body, params, flags, structs)
                return




        def region_callee_name(callee: Expr) -> sview can[Abort.Panic]:
            if callee is Expr.Ident(region_callee_ident, region_callee_ident_line):
                return region_callee_ident
            if callee is Expr.Field(region_callee_object, region_callee_field, region_callee_field_line):
                return region_callee_field
            if callee is Expr.Scope(region_callee_base, region_callee_scope, region_callee_scope_line):
                return region_callee_scope
            return ""




        # Resolve the owner used by the region-forwarding pre-pass. A bare call inside a
        # module follows the same lexical rule as ordinary codegen: prefer that module's own
        # member, then fall back to a top-level function. A qualified call names its owner in
        # the scope expression. The module alias table is consulted too, so `using Box as B` and
        # `B::add(...)` do not lose the region fact merely because the source spelling is short.
        def region_callee_owner(callee: Expr, structs: StructTable&) -> sview can[Abort.Panic]:
            if callee is Expr.Scope(region_owner_base, region_owner_name, region_owner_line):
                if region_owner_base is Expr.Ident(region_owner_ident, region_owner_ident_line):
                    for alias_index in 0..<structs.module_alias_names.count |structs, region_owner_ident|:
                        return structs.module_alias_targets[alias_index] if structs.module_alias_names[alias_index] == region_owner_ident
                    return region_owner_ident
            return structs.current_owner




        def region_fact_parameter_has_region(callee_name: sview, callee_owner: sview, parameter_position: usize, structs: StructTable&) -> bool can[Abort.Panic]:
            fallback: mutable bool = false
            fallback_found: mutable bool = false
            indexed: bool = structs.region_fact_buckets.count == REGION_FACT_BUCKET_COUNT and structs.region_fact_next.count == structs.region_fact_names.count
            cursor: mutable i64 = structs.region_fact_buckets[region_fact_name_bucket(callee_name)] if indexed else 0
            while cursor >= 0 and cursor.usize() < structs.region_fact_names.count |cursor, structs, callee_name, callee_owner, parameter_position, fallback, fallback_found|:
                function_index: usize = cursor.usize()
                cursor <- structs.region_fact_next[function_index] if indexed else cursor + 1
                continue if structs.region_fact_names[function_index] != callee_name
                continue if parameter_position >= structs.region_fact_counts[function_index]
                fact: bool = structs.region_fact_params[structs.region_fact_starts[function_index] + parameter_position]
                return fact if structs.region_fact_owners[function_index] == callee_owner
                if callee_owner != "" and structs.region_fact_owners[function_index] == "" and not fallback_found:
                    fallback <- fact
                    fallback_found <- true
            return fallback




        def region_mark_forwarded(root: sview, parameter_position: usize, callee_name: sview, callee_owner: sview, params: darray[ParamDecl]&, structs: mutable StructTable&, fact_row: usize, changed: mutable bool&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                return if root == "" or callee_name == ""
                for caller_position in 0..<params.count |params, structs, fact_row, root, changed|:
                    continue if params[caller_position].name != root
                    slot: usize = structs.region_fact_starts[fact_row] + caller_position
                    # Forwarding only grows the caller's fact set. A local root
                    # or an already-known fact cannot change this pass, so avoid
                    # scanning every callee fact until a caller slot needs it.
                    return if structs.region_fact_params[slot]
                    return if not region_fact_parameter_has_region(callee_name, callee_owner, parameter_position, structs)
                    if not structs.region_fact_params[slot]:
                        structs.region_fact_params[slot] <- true
                        changed <- true
                    return




        def region_scan_forwarding_expression(expression: Expr, params: darray[ParamDecl]&, structs: mutable StructTable&, fact_row: usize, changed: mutable bool&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                if expression is Expr.Call(region_forward_call_callee, region_forward_call_arguments, region_forward_call_names, region_forward_call_line):
                    callee_name: sview = region_callee_name(region_forward_call_callee)
                    callee_owner: sview = region_callee_owner(region_forward_call_callee, structs)
                    receiver_offset: mutable usize = 0.usize()
                    if region_forward_call_callee is Expr.Field(region_forward_receiver, region_forward_method, region_forward_field_line):
                        receiver_offset <- 1.usize()
                        region_mark_forwarded(region_growth_root(region_forward_receiver), 0.usize(), callee_name, callee_owner, params, structs, fact_row, changed)
                    for argument_index in 0..<region_forward_call_arguments.count |region_forward_call_arguments, callee_name, params, structs, fact_row, changed|:
                        position: usize = argument_index + receiver_offset
                        region_mark_forwarded(region_growth_root(region_forward_call_arguments[argument_index]), position, callee_name, callee_owner, params, structs, fact_row, changed)
                    region_scan_forwarding_expression(region_forward_call_callee, params, structs, fact_row, changed)
                    for region_forward_argument in region_forward_call_arguments |params, structs, fact_row, changed|:
                        region_scan_forwarding_expression(region_forward_argument, params, structs, fact_row, changed)
                    return
                if expression is Expr.Field(region_forward_field_object, region_forward_field_name, region_forward_field_line):
                    region_scan_forwarding_expression(region_forward_field_object, params, structs, fact_row, changed)
                    return
                if expression is Expr.Scope(region_forward_scope_base, region_forward_scope_name, region_forward_scope_line):
                    region_scan_forwarding_expression(region_forward_scope_base, params, structs, fact_row, changed)
                    return
                if expression is Expr.Index(region_forward_index_object, region_forward_index_value, region_forward_index_line):
                    region_scan_forwarding_expression(region_forward_index_object, params, structs, fact_row, changed)
                    region_scan_forwarding_expression(region_forward_index_value, params, structs, fact_row, changed)
                    return
                if expression is Expr.Slice(region_forward_slice_object, region_forward_slice_low, region_forward_slice_high, region_forward_slice_line):
                    region_scan_forwarding_expression(region_forward_slice_object, params, structs, fact_row, changed)
                    region_scan_forwarding_expression(region_forward_slice_low, params, structs, fact_row, changed)
                    region_scan_forwarding_expression(region_forward_slice_high, params, structs, fact_row, changed)
                    return
                if expression is Expr.IndexN(region_forward_indexn_object, region_forward_indexn_arguments, region_forward_indexn_line):
                    region_scan_forwarding_expression(region_forward_indexn_object, params, structs, fact_row, changed)
                    for region_forward_indexn_argument in region_forward_indexn_arguments |params, structs, fact_row, changed|:
                        region_scan_forwarding_expression(region_forward_indexn_argument, params, structs, fact_row, changed)
                    return
                if expression is Expr.Binary(region_forward_binary_left, region_forward_binary_operator, region_forward_binary_right, region_forward_binary_line):
                    region_scan_forwarding_expression(region_forward_binary_left, params, structs, fact_row, changed)
                    region_scan_forwarding_expression(region_forward_binary_right, params, structs, fact_row, changed)
                    return
                if expression is Expr.Unary(region_forward_unary_operator, region_forward_unary_operand, region_forward_unary_line):
                    region_scan_forwarding_expression(region_forward_unary_operand, params, structs, fact_row, changed)
                    return
                if expression is Expr.Move(region_forward_move_operand, region_forward_move_line):
                    region_scan_forwarding_expression(region_forward_move_operand, params, structs, fact_row, changed)
                    return
                if expression is Expr.RegionNew(region_forward_new_operand, region_forward_new_region, region_forward_new_line):
                    region_scan_forwarding_expression(region_forward_new_operand, params, structs, fact_row, changed)
                    return
                if expression is Expr.Paren(region_forward_paren_inner, region_forward_paren_line):
                    region_scan_forwarding_expression(region_forward_paren_inner, params, structs, fact_row, changed)
                    return
                if expression is Expr.Array(region_forward_array_elements, region_forward_array_line) or expression is Expr.Tuple(region_forward_array_elements, region_forward_tuple_line) or expression is Expr.SetLit(region_forward_array_elements, region_forward_set_line):
                    for region_forward_element in region_forward_array_elements |params, structs, fact_row, changed|:
                        region_scan_forwarding_expression(region_forward_element, params, structs, fact_row, changed)
                    return
                if expression is Expr.DictLit(region_forward_dict_entries, region_forward_dict_line):
                    for region_forward_entry in region_forward_dict_entries |params, structs, fact_row, changed|:
                        region_scan_forwarding_expression(region_forward_entry.key, params, structs, fact_row, changed)
                        region_scan_forwarding_expression(region_forward_entry.value, params, structs, fact_row, changed)
                    return
                if expression is Expr.Construct(region_forward_construct_type, region_forward_construct_fields, region_forward_construct_line):
                    region_scan_forwarding_expression(region_forward_construct_type, params, structs, fact_row, changed)
                    for region_forward_field_init in region_forward_construct_fields |params, structs, fact_row, changed|:
                        region_scan_forwarding_expression(region_forward_field_init.value, params, structs, fact_row, changed)
                    return
                if expression is Expr.RecordUpdate(region_forward_update_base, region_forward_update_fields, region_forward_update_line):
                    region_scan_forwarding_expression(region_forward_update_base, params, structs, fact_row, changed)
                    for region_forward_field_init in region_forward_update_fields |params, structs, fact_row, changed|:
                        region_scan_forwarding_expression(region_forward_field_init.value, params, structs, fact_row, changed)
                    return
                if expression is Expr.If(region_forward_if_condition, region_forward_if_then, region_forward_if_else, region_forward_if_line):
                    region_scan_forwarding_expression(region_forward_if_condition, params, structs, fact_row, changed)
                    region_scan_forwarding_expression(region_forward_if_then, params, structs, fact_row, changed)
                    region_scan_forwarding_expression(region_forward_if_else, params, structs, fact_row, changed)
                    return
                if expression is Expr.Match(region_forward_match_scrutinee, region_forward_match_arms, region_forward_match_line) or expression is Expr.Catch(region_forward_match_scrutinee, region_forward_match_arms, region_forward_catch_line):
                    region_scan_forwarding_expression(region_forward_match_scrutinee, params, structs, fact_row, changed)
                    for region_forward_arm in region_forward_match_arms |params, structs, fact_row, changed|:
                        region_scan_forwarding_expression(region_forward_arm.guard, params, structs, fact_row, changed)
                        region_scan_forwarding_statements(region_forward_arm.body, params, structs, fact_row, changed)
                    return
                if expression is Expr.Comprehension(region_forward_comp_var, region_forward_comp_iterable, region_forward_comp_condition, region_forward_comp_body, region_forward_comp_line):
                    region_scan_forwarding_expression(region_forward_comp_iterable, params, structs, fact_row, changed)
                    region_scan_forwarding_expression(region_forward_comp_condition, params, structs, fact_row, changed)
                    region_scan_forwarding_expression(region_forward_comp_body, params, structs, fact_row, changed)
                    return
                if expression is Expr.Refinement(region_forward_refinement_base, region_forward_refinement_predicate, region_forward_refinement_line):
                    region_scan_forwarding_expression(region_forward_refinement_base, params, structs, fact_row, changed)
                    region_scan_forwarding_expression(region_forward_refinement_predicate, params, structs, fact_row, changed)
                    return
                if expression is Expr.GetElse(region_forward_get_guarded, region_forward_get_recovery, region_forward_get_line):
                    region_scan_forwarding_expression(region_forward_get_guarded, params, structs, fact_row, changed)
                    region_scan_forwarding_statements(region_forward_get_recovery, params, structs, fact_row, changed)
                    return
                if expression is Expr.Block(region_forward_block_statements, region_forward_block_value, region_forward_block_captures, region_forward_block_line):
                    region_scan_forwarding_statements(region_forward_block_statements, params, structs, fact_row, changed)
                    region_scan_forwarding_expression(region_forward_block_value, params, structs, fact_row, changed)
                    return




        def region_scan_forwarding_statements(statements: darray[Stmt], params: darray[ParamDecl]&, structs: mutable StructTable&, fact_row: usize, changed: mutable bool&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                for region_forward_statement in statements |params, structs, fact_row, changed|:
                    if region_forward_statement is Stmt.Expr(region_forward_statement_expression, region_forward_statement_line):
                        region_scan_forwarding_expression(region_forward_statement_expression, params, structs, fact_row, changed)
                    elif region_forward_statement is Stmt.VarDecl(region_forward_var_name, region_forward_var_type, region_forward_var_value, region_forward_var_line):
                        region_scan_forwarding_expression(region_forward_var_value, params, structs, fact_row, changed)
                    elif region_forward_statement is Stmt.Assign(region_forward_assign_target, region_forward_assign_operator, region_forward_assign_value, region_forward_assign_line):
                        region_scan_forwarding_expression(region_forward_assign_target, params, structs, fact_row, changed)
                        region_scan_forwarding_expression(region_forward_assign_value, params, structs, fact_row, changed)
                    elif region_forward_statement is Stmt.Return(region_forward_return_value, region_forward_return_line):
                        if region_forward_return_value is region_forward_returned:
                            region_scan_forwarding_expression(region_forward_returned, params, structs, fact_row, changed)
                    elif region_forward_statement is Stmt.If(region_forward_stmt_if_condition, region_forward_stmt_if_then, region_forward_stmt_if_else, region_forward_stmt_if_line):
                        region_scan_forwarding_expression(region_forward_stmt_if_condition, params, structs, fact_row, changed)
                        region_scan_forwarding_statements(region_forward_stmt_if_then, params, structs, fact_row, changed)
                        region_scan_forwarding_statements(region_forward_stmt_if_else, params, structs, fact_row, changed)
                    elif region_forward_statement is Stmt.While(region_forward_stmt_while_condition, region_forward_stmt_while_body, region_forward_stmt_while_line):
                        region_scan_forwarding_expression(region_forward_stmt_while_condition, params, structs, fact_row, changed)
                        region_scan_forwarding_statements(region_forward_stmt_while_body, params, structs, fact_row, changed)
                    elif region_forward_statement is Stmt.For(region_forward_for_bind, region_forward_for_variables, region_forward_for_iterable, region_forward_for_body, region_forward_for_line):
                        region_scan_forwarding_expression(region_forward_for_iterable, params, structs, fact_row, changed)
                        region_scan_forwarding_statements(region_forward_for_body, params, structs, fact_row, changed)
                    elif region_forward_statement is Stmt.Block(region_forward_stmt_block_kind, region_forward_stmt_block_clause, region_forward_stmt_block_binding, region_forward_stmt_block_body, region_forward_stmt_block_line):
                        region_scan_forwarding_statements(region_forward_stmt_block_body, params, structs, fact_row, changed)
                    elif region_forward_statement is Stmt.Match(region_forward_stmt_match_scrutinee, region_forward_stmt_match_arms, region_forward_stmt_match_line):
                        region_scan_forwarding_expression(region_forward_stmt_match_scrutinee, params, structs, fact_row, changed)
                        for region_forward_stmt_arm in region_forward_stmt_match_arms |params, structs, fact_row, changed|:
                            region_scan_forwarding_expression(region_forward_stmt_arm.guard, params, structs, fact_row, changed)
                            region_scan_forwarding_statements(region_forward_stmt_arm.body, params, structs, fact_row, changed)
                    elif region_forward_statement is Stmt.Contract(region_forward_contract_kind, region_forward_contract_expression, region_forward_contract_line):
                        region_scan_forwarding_expression(region_forward_contract_expression, params, structs, fact_row, changed)




        def region_record_declarations(declarations: darray[Decl], owner: sview, structs: mutable StructTable&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                for declaration in declarations |structs|:
                    if declaration is Decl.Func(region_fact_name, region_fact_params, region_fact_return, region_fact_body, region_fact_effects, region_fact_decorators, region_fact_line):
                        flags: mutable darray[bool] = []
                        body_region_parameter_flags(region_fact_params, region_fact_body, structs, flags)
                        structs.region_fact_names <- structs.region_fact_names.push(region_fact_name)
                        structs.region_fact_owners <- structs.region_fact_owners.push(owner)
                        structs.region_fact_lines <- structs.region_fact_lines.push(region_fact_line.line)
                        structs.region_fact_starts <- structs.region_fact_starts.push(structs.region_fact_params.count)
                        structs.region_fact_counts <- structs.region_fact_counts.push(region_fact_params.count)
                        for flag in flags |structs|:
                            structs.region_fact_params <- structs.region_fact_params.push(flag)
                    elif declaration is Decl.Module(region_fact_module_name, region_fact_module_body, region_fact_module_line):
                        region_record_declarations(region_fact_module_body, region_fact_module_name, structs)
                    elif declaration is Decl.Scoped(region_fact_scoped_body, region_fact_scoped_line):
                        region_record_declarations(region_fact_scoped_body, owner, structs)




        def region_apply_forwarding_declarations(declarations: darray[Decl], owner: sview, structs: mutable StructTable&, changed: mutable bool&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                for declaration in declarations |structs, changed|:
                    if declaration is Decl.Func(region_forward_fact_name, region_forward_fact_params, region_forward_fact_return, region_forward_fact_body, region_forward_fact_effects, region_forward_fact_decorators, region_forward_fact_line):
                        row: i64 = region_fact_row(region_forward_fact_name, region_forward_fact_line.line, structs)
                        if row >= 0:
                            previous_owner: sview = structs.current_owner
                            structs.current_owner <- owner
                            region_scan_forwarding_statements(region_forward_fact_body, region_forward_fact_params, structs, row.usize(), changed)
                            structs.current_owner <- previous_owner
                    elif declaration is Decl.Module(region_forward_module_name, region_forward_module_body, region_forward_module_line):
                        region_apply_forwarding_declarations(region_forward_module_body, region_forward_module_name, structs, changed)
                    elif declaration is Decl.Scoped(region_forward_scoped_body, region_forward_scoped_line):
                        region_apply_forwarding_declarations(region_forward_scoped_body, owner, structs, changed)




        def register_region_abi_facts(top: darray[Decl], structs: mutable StructTable&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                region_record_declarations(top, "", structs)
                region_build_name_index(structs)
                changed: mutable bool = true
                rounds: mutable usize = 0
                while changed and rounds <= structs.region_fact_names.count |structs, changed, rounds|:
                    changed <- false
                    region_apply_forwarding_declarations(top, "", structs, changed)
                    rounds <- rounds + 1
