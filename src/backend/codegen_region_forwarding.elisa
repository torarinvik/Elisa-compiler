                        region_scan_forwarding_expression(region_forward_for_iterable, params, structs, fact_row, changed)
                        region_scan_forwarding_statements(region_forward_for_body, params, structs, fact_row, changed)
                    elif region_forward_statement is Stmt.Block(region_forward_stmt_block_kind, region_forward_stmt_block_clause, region_forward_stmt_block_binding, region_forward_stmt_block_body, region_forward_stmt_block_line):
                        region_scan_forwarding_statements(region_forward_stmt_block_body, params, structs, fact_row, changed)
                    elif region_forward_statement is Stmt.Match(region_forward_stmt_match_scrutinee, region_forward_stmt_match_arms, region_forward_stmt_match_line):
                        region_scan_forwarding_expression(region_forward_stmt_match_scrutinee, params, structs, fact_row, changed)
                        for region_forward_stmt_arm in region_forward_stmt_match_arms |params, structs, fact_row, changed|:
                            region_scan_forwarding_expression(region_forward_stmt_arm.guard, params, structs, fact_row, changed)
                            region_scan_forwarding_statements(region_forward_stmt_arm.body, params, structs, fact_row, changed)
                    elif region_forward_statement is Stmt.Contract(region_forward_contract_kind, region_forward_contract_expression, region_forward_contract_line):
                        region_scan_forwarding_expression(region_forward_contract_expression, params, structs, fact_row, changed)




        # A generic TEMPLATE is scanned before any instantiation exists, so its type
        # parameters are unbound and `out: mutable darray[T]&` resolved Unmodeled -- never
        # growable. Its fact row then said "no region" for a parameter the body pushes into:
        # every instantiation took no arena slot and grew the caller's darray in its own auto
        # region, freed on return (a silent 160 where stage0 gives 164). Bind each type
        # parameter to a scalar placeholder for the scan; growability of a container
        # reference does not depend on its element type. Returns the bindings pushed (0 for
        # an ordinary function).
        def region_bind_template_placeholders(name: sview, line: u32, generics: GenericTable&, structs: mutable StructTable&) -> usize can[Abort.Panic, Memory.Allocate]:
            # Use the append-only name chain, preserving declaration order for duplicate
            # templates while avoiding a scan of every generic declaration for each function.
            template_cursor: mutable i64 = name_chain_first(generics.name_buckets, generics.name_next, generics.names, name)
            while template_cursor >= 0 |generics, structs, name, line, template_cursor|:
                template_slot: usize = template_cursor.usize()
                template_cursor <- name_chain_next(generics.name_buckets, generics.name_next, generics.names, name, template_cursor)
                template_line_matches: mutable bool = false
                if generics.decls[template_slot] is Decl.Func(template_name, template_params, template_return, template_body, template_effects, template_decorators, template_line):
                    template_line_matches <- template_line.line == line
                continue if not template_line_matches
                placeholders: mutable darray[ValueType] = []
                for _ in 0..<generics.param_count[template_slot] |placeholders|:
                    placeholders.push(scalar_type_of_name("i64", structs.target.target_pointer_bits))
                return push_type_bindings(generics, structs, template_slot, placeholders)
            return 0




        def region_record_declarations(declarations: darray[Decl], owner: sview, structs: mutable StructTable&, generics: GenericTable&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                for declaration in declarations |structs, generics|:
                    if declaration is Decl.Func(region_fact_name, region_fact_params, region_fact_return, region_fact_body, region_fact_effects, region_fact_decorators, region_fact_line):
                        flags: mutable darray[bool] = []
                        placeholder_bound: usize = region_bind_template_placeholders(region_fact_name, region_fact_line.line, generics, structs)
                        body_region_parameter_flags(region_fact_params, region_fact_body, structs, flags)
                        pop_type_bindings(structs, placeholder_bound)
                        structs.regions.region_fact_names <- structs.regions.region_fact_names.push(region_fact_name)
                        structs.regions.region_fact_owners <- structs.regions.region_fact_owners.push(owner)
                        structs.regions.region_fact_lines <- structs.regions.region_fact_lines.push(region_fact_line.line)
                        line_chain_extend(structs.regions.region_fact_line_buckets, structs.regions.region_fact_line_tails, structs.regions.region_fact_line_next, structs.regions.region_fact_lines)
                        structs.regions.region_fact_starts <- structs.regions.region_fact_starts.push(structs.regions.region_fact_params.count)
                        structs.regions.region_fact_counts <- structs.regions.region_fact_counts.push(region_fact_params.count)
                        for flag in flags |structs|:
                            structs.regions.region_fact_params <- structs.regions.region_fact_params.push(flag)
                        for region_fact_param in region_fact_params |structs|:
                            structs.regions.region_fact_param_names <- structs.regions.region_fact_param_names.push(region_fact_param.name)
                    elif declaration is Decl.Module(region_fact_module_name, region_fact_module_body, region_fact_module_line):
                        region_record_declarations(region_fact_module_body, region_fact_module_name, structs, generics)
                    elif declaration is Decl.Scoped(region_fact_scoped_body, region_fact_scoped_line):
                        region_record_declarations(region_fact_scoped_body, owner, structs, generics)




        def region_apply_forwarding_declarations(declarations: darray[Decl], owner: sview, structs: mutable StructTable&, generics: GenericTable&, managed_by_visit: mutable darray[bool]&, visit_index: mutable usize&, changed: mutable bool&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                for declaration in declarations |structs, generics, managed_by_visit, visit_index, changed|:
                    if declaration is Decl.Func(region_forward_fact_name, region_forward_fact_params, region_forward_fact_return, region_forward_fact_body, region_forward_fact_effects, region_forward_fact_decorators, region_forward_fact_line):
                        row: i64 = region_fact_row(region_forward_fact_name, region_forward_fact_line.line, structs)
                        visit_slot: usize = visit_index
                        if visit_slot == managed_by_visit.count:
                            managed_by_visit.push(row >= 0 and params_manage_arena(region_forward_fact_params, structs))
                        arena_managed: bool = managed_by_visit[visit_slot]
                        visit_index <- visit_index + 1
                        if row >= 0 and not arena_managed:
                            previous_owner: sview = structs.visibility.current_owner
                            structs.visibility.current_owner <- owner
                            forward_placeholder_bound: usize = region_bind_template_placeholders(region_forward_fact_name, region_forward_fact_line.line, generics, structs)
                            region_load_aliases(region_forward_fact_body, structs)
                            region_scan_forwarding_statements(region_forward_fact_body, region_forward_fact_params, structs, row.usize(), changed)
                            pop_type_bindings(structs, forward_placeholder_bound)
                            structs.visibility.current_owner <- previous_owner
                    elif declaration is Decl.Module(region_forward_module_name, region_forward_module_body, region_forward_module_line):
                        region_apply_forwarding_declarations(region_forward_module_body, region_forward_module_name, structs, generics, managed_by_visit, visit_index, changed)
                    elif declaration is Decl.Scoped(region_forward_scoped_body, region_forward_scoped_line):
                        region_apply_forwarding_declarations(region_forward_scoped_body, owner, structs, generics, managed_by_visit, visit_index, changed)




        def register_region_abi_facts(top: darray[Decl], structs: mutable StructTable&, generics: GenericTable&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                region_record_declarations(top, "", structs, generics)
                region_build_name_index(structs)
                # params_manage_arena for each Decl.Func, in walk order: every round walks
                # the same tree in the same order, so the n-th function visited is the same
                # declaration each round. It reads only declared parameter types, which no
                # forwarding round changes; re-resolving every parameter annotation of every
                # function on every round was pure repetition (~3% of a self-host compile).
                # Keyed by visit, not fact row, so two declarations sharing a row keep
                # their own answers.
                managed_by_visit: mutable darray[bool] = []
                changed: mutable bool = true
                rounds: mutable usize = 0
                while changed and rounds <= structs.regions.region_fact_names.count |structs, managed_by_visit, changed, rounds|:
                    changed <- false
                    visit_index: mutable usize = 0
                    region_apply_forwarding_declarations(top, "", structs, generics, managed_by_visit, visit_index, changed)
                    rounds <- rounds + 1
