                while cursor >= 0 and cursor.usize() < structs.regions.region_fact_names.count |cursor, structs, name, arity, top_level_name, name_hits, name_owner, name_owner_conflict, own_arity_hits|:
                    row: usize = cursor.usize()
                    cursor <- structs.regions.region_fact_next[row] if indexed else cursor + 1
                    continue if structs.regions.region_fact_names[row] != name
                    row_owner: sview = structs.regions.region_fact_owners[row]
                    top_level_name <- true if row_owner == ""
                    name_owner_conflict <- true if name_hits > 0 and name_owner != row_owner
                    name_owner <- row_owner if name_hits == 0
                    name_hits <- name_hits + 1
                    if structs.regions.region_fact_counts[row] == arity:
