                visited: mutable darray[sview] = []
                cursor: mutable usize = 0
                while cursor < pending.count |pending, visited, cursor, parameter_position, callee_fact_row, params, structs, fact_row, changed|:
                    current_root: sview = pending[cursor]
                    cursor <- cursor + 1
                    continue if current_root == "" or current_root == "?"
                    already_visited: mutable bool = false
                    for visited_index in 0..<visited.count |already_visited, visited, current_root|:
                        already_visited <- true if visited[visited_index] == current_root
                    continue if already_visited
                    visited.push(current_root)
                    for alias_index in 0..<structs.regions.region_alias_names.count |pending, structs, current_root|:
                        if structs.regions.region_alias_names[alias_index] == current_root:
                            pending.push(structs.regions.region_alias_roots[alias_index])
                    for caller_position in 0..<params.count |params, structs, fact_row, current_root, changed, callee_fact_row, parameter_position|:
                        continue if params[caller_position].name != current_root
                        slot: usize = structs.regions.region_fact_starts[fact_row] + caller_position
                        continue if structs.regions.region_fact_params[slot]
                        continue if not region_fact_parameter_has_region(callee_fact_row, parameter_position, structs)
                        structs.regions.region_fact_params[slot] <- true
                        changed <- true
                        break




        # Apply one possible callee declaration row. Overloaded declarations are unioned
        # below; each row gets its own labels, parameter count and forwarding facts.
        def region_forward_call_row(row: usize, arguments: darray[Expr]&, argument_names: darray[sview]&, receiver_offset: usize, named_call: bool, minimum_position: usize, receiver_root: sview, params: darray[ParamDecl]&, structs: mutable StructTable&, fact_row: usize, changed: mutable bool&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                return if row >= structs.regions.region_fact_starts.count or row >= structs.regions.region_fact_counts.count
                start: usize = structs.regions.region_fact_starts[row]
                count: usize = structs.regions.region_fact_counts[row]
                return if start > structs.regions.region_fact_params.count or count > structs.regions.region_fact_params.count - start
                return if minimum_position >= count
                if receiver_offset == 1 and minimum_position == 0:
                    region_mark_forwarded(receiver_root, 0.usize(), row, params, structs, fact_row, changed)
                positions: mutable darray[i64] = []
                if named_call:
