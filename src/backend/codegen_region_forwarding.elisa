        def body_region_parameter_flags(params: darray[ParamDecl]&, body: darray[Stmt], graph_slot: usize, structs: mutable StructTable&, flags: mutable darray[bool]&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                region_alias_graph_ensure_slot(graph_slot, structs)
