# Stage1 backend — the region-forwarding PRE-PASS: walk each body, mark the locals and callees
# that allocate into a caller's region, and record the forwarded flags the signature facts in
# codegen_abi_regions.elisa then read. Part of `module Backend` (see codegen.elisa).

extend Backend:
    private:
        const REGION_FACT_BUCKET_COUNT: usize = 1024
        const REGION_FACT_HASH_OFFSET: u64 = 14695981039346656037
        const REGION_FACT_HASH_PRIME: u64 = 1099511628211
        const REGION_ALIAS_GRAPH_INDEX_THRESHOLD: usize = 16
        const REGION_ALIAS_GRAPH_MIN_BUCKET_COUNT: usize = 16
        const REGION_ALIAS_GRAPH_MAX_ROWS: usize = 262144

        def region_fact_name_bucket(name: sview) -> usize:
            hash: mutable u64 = REGION_FACT_HASH_OFFSET
            for index in 0..<sview_len(name) |hash, name|:
                hash <- (hash ^ sview_at(name, index).u64()) * REGION_FACT_HASH_PRIME
            return (hash % REGION_FACT_BUCKET_COUNT.u64()).usize()


        def region_alias_graph_hash(name: sview) -> u64:
            hash: mutable u64 = REGION_FACT_HASH_OFFSET
            for index in 0..<sview_len(name) |hash, name|:
                hash <- (hash ^ sview_at(name, index).u64()) * REGION_FACT_HASH_PRIME
            return hash

        def region_build_name_index(structs: mutable StructTable&) -> void can[Abort.Panic, Memory.Allocate]:
            structs.regions.region_fact_buckets <- []
            structs.regions.region_fact_next <- []
            for _ in 0..<REGION_FACT_BUCKET_COUNT |structs|:
                structs.regions.region_fact_buckets <- structs.regions.region_fact_buckets.push(-1)
            for _ in 0..<structs.regions.region_fact_names.count |structs|:
                structs.regions.region_fact_next <- structs.regions.region_fact_next.push(-1)
            # Prepend in reverse so collisions and duplicate names retain source order.
            remaining: mutable usize = structs.regions.region_fact_names.count
            while remaining > 0 |remaining, structs|:
                remaining <- remaining - 1
                bucket: usize = region_fact_name_bucket(structs.regions.region_fact_names[remaining])
                structs.regions.region_fact_next[remaining] <- structs.regions.region_fact_buckets[bucket]
                structs.regions.region_fact_buckets[bucket] <- remaining.i64()


        # Load the reference aliases of the body about to be scanned. The collector fills
        # the tables in `structs` directly: staging the names in a local darray and copying
        # them over gave each name that local's inferred region, which stage0 rejects as a
        # store into the longer-lived `structs` (likewise for scope_load_aliases).
        def region_load_aliases(body: darray[Stmt], structs: mutable StructTable&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                structs.regions.region_alias_graph_active <- false
                structs.regions.region_alias_names <- []
                structs.regions.region_alias_roots <- []
                ref_alias_collect(body, structs, structs.regions.region_alias_names, structs.regions.region_alias_roots)


        # The forwarding facts grow across fixed-point rounds, but a function's local alias
        # map depends only on its body and bound declaration types. Capture that map on its
        # first visit, then restore it by declaration visitation order on later rounds. The
        # flat tables keep duplicate name/line fact rows separate and avoid nested darrays.
        def region_alias_graph_ensure_slot(visit_slot: usize, structs: mutable StructTable&) -> void can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic, Memory.Allocate:
                while structs.regions.region_alias_graph_slot_rows.count <= visit_slot |visit_slot, structs|:
                    structs.regions.region_alias_graph_slot_rows.push(-1)


        def region_alias_cache_visit(visit_slot: usize, capture_current: bool, restore_current: bool, structs: mutable StructTable&, starts: mutable darray[usize]&, counts: mutable darray[usize]&, names: mutable darray[sview]&, roots: mutable darray[sview]&) -> void can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic, Memory.Allocate:
                region_alias_graph_ensure_slot(visit_slot, structs)
                if visit_slot == starts.count:
                    starts.push(names.count)
                    cached_count: mutable usize = 0
                    if capture_current:
                        cached_count <- structs.regions.region_alias_names.count
                        for alias_index in 0..<cached_count |names, roots, structs|:
                            names.push(structs.regions.region_alias_names[alias_index])
                            roots.push(structs.regions.region_alias_roots[alias_index])
                    else:
                        structs.regions.region_alias_names <- []
                        structs.regions.region_alias_roots <- []
                    counts.push(cached_count)
                    return
                if capture_current:
                    # Indexed functions reserve an empty alias-cache slot. If a graph later
                    # fails validation, append the body-collected rows and repoint the slot
                    # so later fixed-point rounds can restore the flat fallback.
                    starts[visit_slot] <- names.count
                    cached_count: usize = structs.regions.region_alias_names.count
                    counts[visit_slot] <- cached_count
                    for alias_index in 0..<cached_count |names, roots, structs|:
                        names.push(structs.regions.region_alias_names[alias_index])
                        roots.push(structs.regions.region_alias_roots[alias_index])
                structs.regions.region_alias_names <- []
                structs.regions.region_alias_roots <- []
                if not capture_current and restore_current:
                    start: usize = starts[visit_slot]
                    count: usize = counts[visit_slot]
                    for alias_index in 0..<count |names, roots, structs, start|:
                        structs.regions.region_alias_names.push(names[start + alias_index])
                        structs.regions.region_alias_roots.push(roots[start + alias_index])


        # Return the graph-local node for NAME, using full sview equality after the hash
        # probe. Buckets contain global node rows, but the selected bucket range belongs to
        # exactly one function graph.
        def region_alias_graph_find_node(visit_slot: usize, name: sview, structs: StructTable&) -> i64 can[Abort.Panic]:
            return -1 if visit_slot >= structs.regions.region_alias_graph_slot_rows.count
            graph_row: i64 = structs.regions.region_alias_graph_slot_rows[visit_slot]
            return -1 if graph_row < 0
            return region_alias_graph_find_graph_node(graph_row.usize(), name, structs)


        def region_alias_graph_find_graph_node(graph_row: usize, name: sview, structs: StructTable&) -> i64 can[Abort.Panic]:
            return -1 if graph_row >= structs.regions.region_alias_graph_bucket_starts.count or graph_row >= structs.regions.region_alias_graph_bucket_counts.count
            bucket_count: usize = structs.regions.region_alias_graph_bucket_counts[graph_row]
            return -1 if bucket_count == 0 or (bucket_count & (bucket_count - 1.usize())) != 0.usize()
            bucket_start: usize = structs.regions.region_alias_graph_bucket_starts[graph_row]
            return -1 if bucket_start > structs.regions.region_alias_graph_buckets.count or bucket_count > structs.regions.region_alias_graph_buckets.count - bucket_start
            bucket: usize = (region_alias_graph_hash(name) & (bucket_count.u64() - 1.u64())).usize()
            probes: mutable usize = 0
            while probes < bucket_count |bucket, bucket_count, bucket_start, name, probes, structs|:
                node: i64 = structs.regions.region_alias_graph_buckets[bucket_start + bucket]
                return -1 if node < 0
                return node if node.usize() < structs.regions.region_alias_graph_node_names.count and structs.regions.region_alias_graph_node_names[node.usize()] == name
                bucket <- (bucket + 1.usize()) & (bucket_count - 1.usize())
                probes <- probes + 1.usize()
            return -1


        # Validate the complete graph before publishing its slot. The runtime row check is
        # deliberately constant-time; these O(nodes + edges + buckets) checks happen once
        # during construction, before the graph can be used by a function scan.
        def region_alias_graph_storage_valid(graph_row: usize, params: darray[ParamDecl]&, structs: StructTable&) -> bool can[Abort.Panic]:
            return false if graph_row >= structs.regions.region_alias_graph_node_starts.count or graph_row >= structs.regions.region_alias_graph_node_counts.count or graph_row >= structs.regions.region_alias_graph_edge_starts.count or graph_row >= structs.regions.region_alias_graph_edge_counts.count or graph_row >= structs.regions.region_alias_graph_bucket_starts.count or graph_row >= structs.regions.region_alias_graph_bucket_counts.count or graph_row >= structs.regions.region_alias_graph_generations.count
            node_start: usize = structs.regions.region_alias_graph_node_starts[graph_row]
            node_count: usize = structs.regions.region_alias_graph_node_counts[graph_row]
            return false if node_start > structs.regions.region_alias_graph_node_names.count or node_count > structs.regions.region_alias_graph_node_names.count - node_start
            return false if node_start > structs.regions.region_alias_graph_node_heads.count or node_count > structs.regions.region_alias_graph_node_heads.count - node_start
            return false if node_start > structs.regions.region_alias_graph_node_tails.count or node_count > structs.regions.region_alias_graph_node_tails.count - node_start
            return false if node_start > structs.regions.region_alias_graph_node_params.count or node_count > structs.regions.region_alias_graph_node_params.count - node_start
            return false if node_start > structs.regions.region_alias_graph_node_seen.count or node_count > structs.regions.region_alias_graph_node_seen.count - node_start
            edge_start: usize = structs.regions.region_alias_graph_edge_starts[graph_row]
            edge_count: usize = structs.regions.region_alias_graph_edge_counts[graph_row]
            return false if edge_start > structs.regions.region_alias_graph_edge_sources.count or edge_count > structs.regions.region_alias_graph_edge_sources.count - edge_start
            return false if edge_start > structs.regions.region_alias_graph_edge_targets.count or edge_count > structs.regions.region_alias_graph_edge_targets.count - edge_start
            return false if edge_start > structs.regions.region_alias_graph_edge_next.count or edge_count > structs.regions.region_alias_graph_edge_next.count - edge_start
            bucket_start: usize = structs.regions.region_alias_graph_bucket_starts[graph_row]
            bucket_count: usize = structs.regions.region_alias_graph_bucket_counts[graph_row]
            return false if bucket_count == 0 or (bucket_count & (bucket_count - 1.usize())) != 0.usize()
            return false if bucket_start > structs.regions.region_alias_graph_buckets.count or bucket_count > structs.regions.region_alias_graph_buckets.count - bucket_start
            occupied_buckets: mutable usize = 0
            for bucket_offset in 0..<bucket_count |bucket_offset, bucket_start, node_start, node_count, occupied_buckets, structs|:
                bucket_node: i64 = structs.regions.region_alias_graph_buckets[bucket_start + bucket_offset]
                if bucket_node >= 0:
                    return false if bucket_node.usize() < node_start or bucket_node.usize() - node_start >= node_count
                    occupied_buckets <- occupied_buckets + 1.usize()
                else:
                    return false if bucket_node != -1
            return false if occupied_buckets != node_count
            for node_offset in 0..<node_count |node_offset, node_start, params, structs|:
                node_index: usize = node_start + node_offset
                return false if region_alias_graph_find_graph_node(graph_row, structs.regions.region_alias_graph_node_names[node_index], structs) != node_index.i64()
                parameter_index: i64 = structs.regions.region_alias_graph_node_params[node_index]
                return false if parameter_index < -1 or (parameter_index >= 0 and parameter_index.usize() >= params.count)
                return false if parameter_index >= 0 and params[parameter_index.usize()].name != structs.regions.region_alias_graph_node_names[node_index]
            for parameter_index in 0..<params.count |parameter_index, node_start, node_count, params, structs|:
                parameter_node: i64 = region_alias_graph_find_graph_node(graph_row, params[parameter_index].name, structs)
                return false if parameter_node < 0 or parameter_node.usize() < node_start or parameter_node.usize() - node_start >= node_count
                first_parameter: i64 = structs.regions.region_alias_graph_node_params[parameter_node.usize()]
                return false if first_parameter < 0 or first_parameter.usize() > parameter_index
            for edge_offset in 0..<edge_count |edge_offset, edge_start, node_start, node_count, structs|:
                source_node: i64 = structs.regions.region_alias_graph_edge_sources[edge_start + edge_offset]
                target_node: i64 = structs.regions.region_alias_graph_edge_targets[edge_start + edge_offset]
                return false if source_node < 0 or target_node < 0 or source_node.usize() < node_start or source_node.usize() - node_start >= node_count or target_node.usize() < node_start or target_node.usize() - node_start >= node_count
            walked_edges: mutable usize = 0
            for node_offset in 0..<node_count |node_offset, node_start, edge_start, edge_count, walked_edges, structs|:
                node_index: usize = node_start + node_offset
                edge_cursor: i64 = structs.regions.region_alias_graph_node_heads[node_index]
                expected_tail_edge: i64 = structs.regions.region_alias_graph_node_tails[node_index]
                if edge_cursor < 0:
                    return false if edge_cursor != -1 or expected_tail_edge != -1
                    continue
                return false if expected_tail_edge < 0 or expected_tail_edge.usize() < edge_start or expected_tail_edge.usize() - edge_start >= edge_count
                node_steps: mutable usize = 0
                last_edge: i64 = -1
                while edge_cursor >= 0 |edge_cursor, edge_start, edge_count, node_index, node_steps, last_edge, walked_edges, structs|:
                    return false if node_steps >= edge_count
                    edge_index: usize = edge_cursor.usize()
                    return false if edge_index < edge_start or edge_index - edge_start >= edge_count
                    return false if structs.regions.region_alias_graph_edge_sources[edge_index] != node_index.i64()
                    next_edge: i64 = structs.regions.region_alias_graph_edge_next[edge_index]
                    return false if next_edge < -1 or (next_edge >= 0 and (next_edge.usize() < edge_start or next_edge.usize() - edge_start >= edge_count))
                    node_steps <- node_steps + 1.usize()
                    walked_edges <- walked_edges + 1.usize()
                    last_edge <- edge_cursor
                    edge_cursor <- next_edge
                return false if last_edge != expected_tail_edge
            return walked_edges == edge_count


        # Check row-level bounds in constant time before indexed traversal. Graph publication
        # happens only after the builder validates every row; this guard keeps stale or
        # inconsistent metadata on the fallback path.
        def region_alias_graph_row_valid(visit_slot: usize, structs: StructTable&) -> bool can[Abort.Panic]:
            return false if visit_slot >= structs.regions.region_alias_graph_slot_rows.count
            mapped_row: i64 = structs.regions.region_alias_graph_slot_rows[visit_slot]
            return false if mapped_row < 0
            graph_row: usize = mapped_row.usize()
            return false if graph_row >= structs.regions.region_alias_graph_node_starts.count or graph_row >= structs.regions.region_alias_graph_node_counts.count or graph_row >= structs.regions.region_alias_graph_edge_starts.count or graph_row >= structs.regions.region_alias_graph_edge_counts.count or graph_row >= structs.regions.region_alias_graph_bucket_starts.count or graph_row >= structs.regions.region_alias_graph_bucket_counts.count or graph_row >= structs.regions.region_alias_graph_generations.count
            node_start: usize = structs.regions.region_alias_graph_node_starts[graph_row]
            node_count: usize = structs.regions.region_alias_graph_node_counts[graph_row]
            return false if node_start > structs.regions.region_alias_graph_node_names.count or node_count > structs.regions.region_alias_graph_node_names.count - node_start
            return false if node_start > structs.regions.region_alias_graph_node_heads.count or node_count > structs.regions.region_alias_graph_node_heads.count - node_start
            return false if node_start > structs.regions.region_alias_graph_node_tails.count or node_count > structs.regions.region_alias_graph_node_tails.count - node_start
            return false if node_start > structs.regions.region_alias_graph_node_params.count or node_count > structs.regions.region_alias_graph_node_params.count - node_start
            return false if node_start > structs.regions.region_alias_graph_node_seen.count or node_count > structs.regions.region_alias_graph_node_seen.count - node_start
            edge_start: usize = structs.regions.region_alias_graph_edge_starts[graph_row]
            edge_count: usize = structs.regions.region_alias_graph_edge_counts[graph_row]
            return false if edge_start > structs.regions.region_alias_graph_edge_sources.count or edge_count > structs.regions.region_alias_graph_edge_sources.count - edge_start
            return false if edge_start > structs.regions.region_alias_graph_edge_targets.count or edge_count > structs.regions.region_alias_graph_edge_targets.count - edge_start
            return false if edge_start > structs.regions.region_alias_graph_edge_next.count or edge_count > structs.regions.region_alias_graph_edge_next.count - edge_start
            bucket_start: usize = structs.regions.region_alias_graph_bucket_starts[graph_row]
            bucket_count: usize = structs.regions.region_alias_graph_bucket_counts[graph_row]
            return false if bucket_count == 0 or (bucket_count & (bucket_count - 1.usize())) != 0.usize()
            return false if bucket_start > structs.regions.region_alias_graph_buckets.count or bucket_count > structs.regions.region_alias_graph_buckets.count - bucket_start
            return true


        # Recreate the old flat alias inputs in exact collector order if an indexed walk
        # cannot obtain a generation stamp. The stored source/target rows retain duplicates.
        def region_alias_graph_restore_linear_aliases(visit_slot: usize, structs: mutable StructTable&) -> bool can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic, Memory.Allocate:
                return false if visit_slot >= structs.regions.region_alias_graph_slot_rows.count
                mapped_row: i64 = structs.regions.region_alias_graph_slot_rows[visit_slot]
                return false if mapped_row < 0 or mapped_row.usize() >= structs.regions.region_alias_graph_node_starts.count or mapped_row.usize() >= structs.regions.region_alias_graph_node_counts.count or mapped_row.usize() >= structs.regions.region_alias_graph_edge_starts.count or mapped_row.usize() >= structs.regions.region_alias_graph_edge_counts.count
                graph_row: usize = mapped_row.usize()
                node_start: usize = structs.regions.region_alias_graph_node_starts[graph_row]
                node_count: usize = structs.regions.region_alias_graph_node_counts[graph_row]
                return false if node_start > structs.regions.region_alias_graph_node_names.count or node_count > structs.regions.region_alias_graph_node_names.count - node_start
                edge_start: usize = structs.regions.region_alias_graph_edge_starts[graph_row]
                edge_count: usize = structs.regions.region_alias_graph_edge_counts[graph_row]
                return false if edge_start > structs.regions.region_alias_graph_edge_sources.count or edge_count > structs.regions.region_alias_graph_edge_sources.count - edge_start
                return false if edge_start > structs.regions.region_alias_graph_edge_targets.count or edge_count > structs.regions.region_alias_graph_edge_targets.count - edge_start
                for edge_offset in 0..<edge_count |edge_offset, edge_start, node_start, node_count, structs|:
                    source_node: i64 = structs.regions.region_alias_graph_edge_sources[edge_start + edge_offset]
                    target_node: i64 = structs.regions.region_alias_graph_edge_targets[edge_start + edge_offset]
                    return false if source_node < 0 or target_node < 0
                    source_index: usize = source_node.usize()
                    target_index: usize = target_node.usize()
                    return false if source_index < node_start or target_index < node_start
                    return false if source_index - node_start >= node_count or target_index - node_start >= node_count
                structs.regions.region_alias_names <- []
                structs.regions.region_alias_roots <- []
                for edge_offset in 0..<edge_count |edge_offset, edge_start, structs|:
                    source_node: usize = structs.regions.region_alias_graph_edge_sources[edge_start + edge_offset].usize()
                    target_node: usize = structs.regions.region_alias_graph_edge_targets[edge_start + edge_offset].usize()
                    structs.regions.region_alias_names.push(structs.regions.region_alias_graph_node_names[source_node])
                    structs.regions.region_alias_roots.push(structs.regions.region_alias_graph_node_names[target_node])
                return true


        def region_alias_graph_intern_node(graph_row: usize, name: sview, structs: mutable StructTable&) -> i64 can[Abort.Panic, Memory.Allocate]:
            existing: i64 = region_alias_graph_find_graph_node(graph_row, name, structs)
            return existing if existing >= 0
            return -1 if graph_row >= structs.regions.region_alias_graph_bucket_starts.count or graph_row >= structs.regions.region_alias_graph_bucket_counts.count
            bucket_count: usize = structs.regions.region_alias_graph_bucket_counts[graph_row]
            return -1 if bucket_count == 0
            bucket_start: usize = structs.regions.region_alias_graph_bucket_starts[graph_row]
            bucket: usize = (region_alias_graph_hash(name) & (bucket_count.u64() - 1.u64())).usize()
            probes: mutable usize = 0
            while probes < bucket_count |bucket, bucket_count, bucket_start, name, probes, structs|:
                bucket_row: usize = bucket_start + bucket
                if structs.regions.region_alias_graph_buckets[bucket_row] < 0:
                    node: usize = structs.regions.region_alias_graph_node_names.count
                    structs.regions.region_alias_graph_node_names.push(name)
                    structs.regions.region_alias_graph_node_heads.push(-1)
                    structs.regions.region_alias_graph_node_tails.push(-1)
                    structs.regions.region_alias_graph_node_params.push(-1)
                    structs.regions.region_alias_graph_node_seen.push(0)
                    structs.regions.region_alias_graph_buckets[bucket_row] <- node.i64()
                    return node.i64()
                bucket <- (bucket + 1.usize()) & (bucket_count - 1.usize())
                probes <- probes + 1.usize()
            # Capacity is sized for all alias endpoints and parameters at a load factor <= 1/2.
            return -1


        def region_alias_graph_rollback(graph_row: usize, structs: mutable StructTable&) -> void:
            node_start: usize = structs.regions.region_alias_graph_node_starts[graph_row]
            edge_start: usize = structs.regions.region_alias_graph_edge_starts[graph_row]
            bucket_start: usize = structs.regions.region_alias_graph_bucket_starts[graph_row]
            structs.regions.region_alias_graph_node_names.truncate(node_start)
            structs.regions.region_alias_graph_node_heads.truncate(node_start)
            structs.regions.region_alias_graph_node_tails.truncate(node_start)
            structs.regions.region_alias_graph_node_params.truncate(node_start)
            structs.regions.region_alias_graph_node_seen.truncate(node_start)
            structs.regions.region_alias_graph_edge_sources.truncate(edge_start)
            structs.regions.region_alias_graph_edge_targets.truncate(edge_start)
            structs.regions.region_alias_graph_edge_next.truncate(edge_start)
            structs.regions.region_alias_graph_buckets.truncate(bucket_start)
            structs.regions.region_alias_graph_node_starts.truncate(graph_row)
            structs.regions.region_alias_graph_node_counts.truncate(graph_row)
            structs.regions.region_alias_graph_edge_starts.truncate(graph_row)
            structs.regions.region_alias_graph_edge_counts.truncate(graph_row)
            structs.regions.region_alias_graph_bucket_starts.truncate(graph_row)
            structs.regions.region_alias_graph_bucket_counts.truncate(graph_row)
            structs.regions.region_alias_graph_generations.truncate(graph_row)


        # Build one graph after the first alias collection for a function. Alias edges are
        # appended in collector order and are never deduplicated: branch and rebind alternatives
        # deliberately widen the possible referents. Node interning only merges equal names.
        # Any capacity or consistency failure rolls back all appended rows and leaves the
        # caller on the original linear walk.
        def region_alias_graph_build(visit_slot: usize, params: darray[ParamDecl]&, structs: mutable StructTable&) -> bool can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic, Memory.Allocate:
                return false if visit_slot >= structs.regions.region_alias_graph_slot_rows.count
                return true if structs.regions.region_alias_graph_slot_rows[visit_slot] >= 0
                alias_count: usize = structs.regions.region_alias_names.count
                return false if alias_count < REGION_ALIAS_GRAPH_INDEX_THRESHOLD or alias_count != structs.regions.region_alias_roots.count
                # Bound the per-graph arithmetic before multiplying or doubling. Oversized
                # graphs retain the exact linear fallback and cannot leave a partial index.
                return false if alias_count > REGION_ALIAS_GRAPH_MAX_ROWS or params.count > REGION_ALIAS_GRAPH_MAX_ROWS
                node_limit: usize = alias_count * 2 + params.count
                return false if node_limit > REGION_ALIAS_GRAPH_MAX_ROWS / 2
                bucket_count: mutable usize = REGION_ALIAS_GRAPH_MIN_BUCKET_COUNT
                while bucket_count < node_limit * 2 |bucket_count, node_limit|:
                    bucket_count <- bucket_count * 2
                return false if bucket_count > REGION_ALIAS_GRAPH_MAX_ROWS
                node_start: usize = structs.regions.region_alias_graph_node_names.count
                edge_start: usize = structs.regions.region_alias_graph_edge_targets.count
                return false if structs.regions.region_alias_graph_edge_sources.count != edge_start
                bucket_start: usize = structs.regions.region_alias_graph_buckets.count
                graph_row: usize = structs.regions.region_alias_graph_node_starts.count
                return false if graph_row >= REGION_ALIAS_GRAPH_MAX_ROWS
                return false if node_start > REGION_ALIAS_GRAPH_MAX_ROWS - node_limit
                return false if edge_start > REGION_ALIAS_GRAPH_MAX_ROWS - alias_count
                return false if bucket_start > REGION_ALIAS_GRAPH_MAX_ROWS - bucket_count
                structs.regions.region_alias_graph_node_starts.push(node_start)
                structs.regions.region_alias_graph_node_counts.push(0)
                structs.regions.region_alias_graph_edge_starts.push(edge_start)
                structs.regions.region_alias_graph_edge_counts.push(0)
                structs.regions.region_alias_graph_bucket_starts.push(bucket_start)
                structs.regions.region_alias_graph_bucket_counts.push(bucket_count)
                structs.regions.region_alias_graph_generations.push(0)
                for _ in 0..<bucket_count |structs|:
                    structs.regions.region_alias_graph_buckets.push(-1)
                failed: mutable bool = false
                for alias_index in 0..<alias_count |structs, graph_row, failed|:
                    source_node: i64 = region_alias_graph_intern_node(graph_row, structs.regions.region_alias_names[alias_index], structs)
                    target_node: i64 = region_alias_graph_intern_node(graph_row, structs.regions.region_alias_roots[alias_index], structs)
                    if source_node < 0 or target_node < 0:
                        failed <- true
                        break
                    edge: usize = structs.regions.region_alias_graph_edge_targets.count
                    structs.regions.region_alias_graph_edge_sources.push(source_node)
                    structs.regions.region_alias_graph_edge_targets.push(target_node)
                    structs.regions.region_alias_graph_edge_next.push(-1)
                    source: usize = source_node.usize()
                    previous_edge: i64 = structs.regions.region_alias_graph_node_tails[source]
                    if previous_edge >= 0:
                        structs.regions.region_alias_graph_edge_next[previous_edge.usize()] <- edge.i64()
                    else:
                        structs.regions.region_alias_graph_node_heads[source] <- edge.i64()
                    structs.regions.region_alias_graph_node_tails[source] <- edge.i64()
                if not failed:
                    for parameter_index in 0..<params.count |structs, graph_row, params, failed|:
                        parameter_node: i64 = region_alias_graph_intern_node(graph_row, params[parameter_index].name, structs)
                        if parameter_node < 0:
                            failed <- true
                            break
                        parameter_slot: usize = parameter_node.usize()
                        if structs.regions.region_alias_graph_node_params[parameter_slot] < 0:
                            structs.regions.region_alias_graph_node_params[parameter_slot] <- parameter_index.i64()
                if failed:
                    region_alias_graph_rollback(graph_row, structs)
                    return false
                node_count: usize = structs.regions.region_alias_graph_node_names.count - node_start
                edge_count: usize = structs.regions.region_alias_graph_edge_targets.count - edge_start
                if node_count > REGION_ALIAS_GRAPH_MAX_ROWS or edge_count != alias_count or structs.regions.region_alias_graph_edge_sources.count - edge_start != alias_count:
                    region_alias_graph_rollback(graph_row, structs)
                    return false
                structs.regions.region_alias_graph_node_counts[graph_row] <- node_count
                structs.regions.region_alias_graph_edge_counts[graph_row] <- edge_count
                if not region_alias_graph_storage_valid(graph_row, params, structs):
                    region_alias_graph_rollback(graph_row, structs)
                    return false
                # Publish the visit-to-graph mapping only after every node and edge validates.
                structs.regions.region_alias_graph_slot_rows[visit_slot] <- graph_row.i64()
                return true


        def region_alias_graph_next_generation(visit_slot: usize, structs: mutable StructTable&) -> u64 can[Abort.Panic]:
            graph_row: i64 = structs.regions.region_alias_graph_slot_rows[visit_slot]
            graph_index: usize = graph_row.usize()
            node_start: usize = structs.regions.region_alias_graph_node_starts[graph_index]
            node_count: usize = structs.regions.region_alias_graph_node_counts[graph_index]
            previous_generation: u64 = structs.regions.region_alias_graph_generations[graph_index]
            generation: mutable u64 = 1.u64()
            if previous_generation == 18446744073709551615:
                for node_offset in 0..<node_count |structs, node_start|:
                    structs.regions.region_alias_graph_node_seen[node_start + node_offset] <- 0
            else:
                generation <- previous_generation + 1.u64()
            structs.regions.region_alias_graph_generations[graph_index] <- generation
            return generation


        def region_mark_all_root_parameters(params: darray[ParamDecl]&, flags: mutable darray[bool]&, structs: mutable StructTable&) -> void can[Abort.Panic]:
            for parameter_index in 0..<params.count |params, flags, structs|:
                parameter_type: ValueType = parameter_value_type(params[parameter_index].type_expression, structs)
                flags[parameter_index] <- true if ref_type_can_grow(parameter_type, structs)


        def region_mark_all_forwarded_parameters(parameter_position: usize, callee_fact_row: usize, params: darray[ParamDecl]&, structs: mutable StructTable&, fact_row: usize, changed: mutable bool&) -> void can[Abort.Panic]:
            return if not region_fact_parameter_has_region(callee_fact_row, parameter_position, structs)
            return if fact_row >= structs.regions.region_fact_starts.count or fact_row >= structs.regions.region_fact_counts.count
            start: usize = structs.regions.region_fact_starts[fact_row]
            count: usize = structs.regions.region_fact_counts[fact_row]
            return if start > structs.regions.region_fact_params.count
            available: usize = structs.regions.region_fact_params.count - start
            bounded_count: mutable usize = count if count < available else available
            bounded_count <- params.count if params.count < bounded_count else bounded_count
            for caller_position in 0..<bounded_count |caller_position, start, params, structs, changed|:
                parameter_type: ValueType = parameter_value_type(params[caller_position].type_expression, structs)
                continue if not ref_type_can_grow(parameter_type, structs)
                slot: usize = start + caller_position
                if not structs.regions.region_fact_params[slot]:
                    structs.regions.region_fact_params[slot] <- true
                    changed <- true




        # A stored value that may carry storage from THIS function's arena: a named local
        # (not a parameter, whose storage the caller already owns), a non-empty literal, or
        # a call result (built in the call-site arena). `[]` allocates nothing.
        def region_store_value_allocates(value: Expr, params: darray[ParamDecl]&) -> bool can[Abort.Panic]:
            if value is Expr.Ident(store_value_name, store_value_pos):
                for store_param in params |store_value_name|:
                    false return if store_param.name == store_value_name
                return true
            if value is Expr.Array(store_elements, store_array_pos):
                return store_elements.count > 0
            if value is Expr.Paren(store_inner, store_paren_pos):
                can Abort.Panic:
                    return region_store_value_allocates(store_inner, params)
            if value is Expr.Move(store_moved, store_move_pos):
                can Abort.Panic:
                    return region_store_value_allocates(store_moved, params)
            if value is Expr.Call(store_callee, store_arguments, store_names, store_call_pos):
                return true
            if value is Expr.StaticEffectCall(store_effect_type, store_effect_operation, store_effect_candidates, store_effect_arguments, store_effect_names, store_effect_pos):
                return true
            return false

        # A generic effect operation (`Sink[T].put(out, v)`) lowers at EMIT time to a direct
        # call of the selected handler operation (lower_static_effect_call), with the
        # handler's captures prepended. The pre-pass never saw that call, so a handler that
        # grew `out` left this function without the caller's arena: the clone received the
        # null no-region placeholder and passed it on (segfault). Scan every candidate as the
        # call it may become -- over-approximating the selection only moves storage UP the
        # placement ladder, which is always sound.
        def region_static_effect_candidate_calls(expression: Expr) -> darray[Expr] can[Abort.Panic, Memory.Allocate]:
            calls: mutable darray[Expr] = []
            if expression is Expr.StaticEffectCall(effect_type, effect_operation, effect_candidates, effect_arguments, effect_argument_names, effect_position):
                for effect_candidate in effect_candidates |calls, effect_arguments, effect_argument_names, effect_position|:
                    candidate_arguments: mutable darray[Expr] = []
                    candidate_names: mutable darray[sview] = []
                    for effect_capture in effect_candidate.captures |candidate_arguments, candidate_names|:
                        candidate_arguments.push(effect_capture)
                        candidate_names.push("")
                    for effect_index in 0..<effect_arguments.count |candidate_arguments, candidate_names, effect_arguments, effect_argument_names|:
                        candidate_arguments.push(effect_arguments[effect_index])
                        candidate_names.push(effect_argument_names[effect_index] if effect_index < effect_argument_names.count else "")
                    candidate_callee: mutable Expr = Expr.Ident(effect_candidate.callee, Ast::pos_at_line(0))
                    if effect_candidate.callee_owner != "":
                        candidate_callee <- Expr.Scope(Expr.Ident(effect_candidate.callee_owner, Ast::pos_at_line(0)), effect_candidate.callee, Ast::pos_at_line(0))
                    calls.push(Expr.Call(candidate_callee, candidate_arguments, candidate_names, effect_position))
            return calls




        def region_mark_root(root: sview, params: darray[ParamDecl]&, flags: mutable darray[bool]&, structs: mutable StructTable&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                return if root == "" or root == "?"
                graph_slot: usize = structs.regions.region_alias_graph_active_slot
                if structs.regions.region_alias_graph_active and graph_slot < structs.regions.region_alias_graph_slot_rows.count and structs.regions.region_alias_graph_slot_rows[graph_slot] >= 0:
                    graph_failed: mutable bool = false
                    structs.regions.region_alias_graph_pending_nodes.truncate(0)
                    graph_row: usize = structs.regions.region_alias_graph_slot_rows[graph_slot].usize()
                    node_start: usize = structs.regions.region_alias_graph_node_starts[graph_row]
                    node_count: usize = structs.regions.region_alias_graph_node_counts[graph_row]
                    edge_start: usize = structs.regions.region_alias_graph_edge_starts[graph_row]
                    edge_count: usize = structs.regions.region_alias_graph_edge_counts[graph_row]
                    root_node: i64 = region_alias_graph_find_node(graph_slot, root, structs)
                    if root_node < 0:
                        # Every alias endpoint and parameter name is interned while the
                        # graph is built. A missing name therefore has no work in the old
                        # linear path either; keep the indexed graph active for later roots.
                        return
                    elif root_node.usize() < node_start or root_node.usize() - node_start >= node_count:
                        graph_failed <- true
                    else:
                        generation: u64 = region_alias_graph_next_generation(graph_slot, structs)
                        if generation == 0:
                            graph_failed <- true
                        else:
                            structs.regions.region_alias_graph_pending_nodes.push(root_node)
                            structs.regions.region_alias_graph_node_seen[root_node.usize()] <- generation
                            cursor: mutable usize = 0
                            while cursor < structs.regions.region_alias_graph_pending_nodes.count |cursor, params, flags, structs, graph_row, node_start, node_count, edge_start, edge_count, generation, graph_failed|:
                                current_node: i64 = structs.regions.region_alias_graph_pending_nodes[cursor]
                                cursor <- cursor + 1.usize()
                                if current_node < 0 or current_node.usize() < node_start or current_node.usize() - node_start >= node_count:
                                    graph_failed <- true
                                    break
                                current_node_index: usize = current_node.usize()
                                if structs.regions.region_alias_graph_node_names[current_node_index] == "" or structs.regions.region_alias_graph_node_names[current_node_index] == "?":
                                    continue
                                parameter_index: i64 = structs.regions.region_alias_graph_node_params[current_node_index]
                                if parameter_index < -1 or (parameter_index >= 0 and parameter_index.usize() >= params.count):
                                    graph_failed <- true
                                    break
                                if parameter_index >= 0:
                                    if params[parameter_index.usize()].name != structs.regions.region_alias_graph_node_names[current_node_index]:
                                        graph_failed <- true
                                        break
                                    parameter_type: ValueType = parameter_value_type(params[parameter_index.usize()].type_expression, structs)
                                    flags[parameter_index.usize()] <- true if ref_type_can_grow(parameter_type, structs)
                                edge_cursor: mutable i64 = structs.regions.region_alias_graph_node_heads[current_node_index]
                                edge_steps: mutable usize = 0
                                while edge_cursor >= 0 and edge_steps < edge_count |edge_cursor, edge_steps, structs, edge_start, edge_count, node_start, node_count, generation, graph_failed|:
                                    edge_index: usize = edge_cursor.usize()
                                    if edge_index < edge_start or edge_index - edge_start >= edge_count:
                                        graph_failed <- true
                                        break
                                    if structs.regions.region_alias_graph_edge_sources[edge_index] != current_node_index.i64():
                                        graph_failed <- true
                                        break
                                    target_node: i64 = structs.regions.region_alias_graph_edge_targets[edge_index]
                                    if target_node < 0 or target_node.usize() < node_start or target_node.usize() - node_start >= node_count:
                                        graph_failed <- true
                                        break
                                    if structs.regions.region_alias_graph_node_seen[target_node.usize()] != generation:
                                        structs.regions.region_alias_graph_node_seen[target_node.usize()] <- generation
                                        structs.regions.region_alias_graph_pending_nodes.push(target_node)
                                    edge_cursor <- structs.regions.region_alias_graph_edge_next[edge_index]
                                    edge_steps <- edge_steps + 1.usize()
                                if edge_cursor != -1:
                                    graph_failed <- true
                                break if graph_failed
                            if not graph_failed:
                                return
                    restored: bool = region_alias_graph_restore_linear_aliases(graph_slot, structs)
                    structs.regions.region_alias_graph_active <- false
                    if not restored:
                        region_mark_all_root_parameters(params, flags, structs)
                        return
                elif structs.regions.region_alias_graph_active:
                    structs.regions.region_alias_graph_active <- false
                    region_mark_all_root_parameters(params, flags, structs)
                    return
                has_alias: mutable bool = false
                for alias_index in 0..<structs.regions.region_alias_names.count |has_alias, structs, root|:
                    has_alias <- true if structs.regions.region_alias_names[alias_index] == root
                if not has_alias:
                    for parameter_index in 0..<params.count |params, flags, root, structs|:
                        continue if params[parameter_index].name != root
                        parameter_type: ValueType = parameter_value_type(params[parameter_index].type_expression, structs)
                        flags[parameter_index] <- true if ref_type_can_grow(parameter_type, structs)
                        return
                    return
                pending: mutable darray[sview] = [root]
                visited: mutable darray[sview] = []
                cursor: mutable usize = 0
                while cursor < pending.count |pending, visited, cursor, params, flags, structs|:
                    current_root: sview = pending[cursor]
                    cursor <- cursor + 1
                    continue if current_root == "" or current_root == "?"
                    already_visited: mutable bool = false
                    for visited_index in 0..<visited.count |already_visited, visited, current_root|:
                        already_visited <- true if visited[visited_index] == current_root
                    continue if already_visited
                    visited.push(current_root)
                    for parameter_index in 0..<params.count |params, flags, current_root, structs|:
                        continue if params[parameter_index].name != current_root
                        parameter_type: ValueType = parameter_value_type(params[parameter_index].type_expression, structs)
                        flags[parameter_index] <- true if ref_type_can_grow(parameter_type, structs)
                        break
                    for alias_index in 0..<structs.regions.region_alias_names.count |pending, structs, current_root|:
                        if structs.regions.region_alias_names[alias_index] == current_root:
                            pending.push(structs.regions.region_alias_roots[alias_index])




        def region_scan_expression(expression: Expr, params: darray[ParamDecl]&, flags: mutable darray[bool]&, structs: mutable StructTable&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                if expression is Expr.Call(region_call_callee, region_call_arguments, region_call_names, region_call_line):
                    if region_call_callee is Expr.Field(region_call_receiver, region_call_method, region_call_field_line):
                        region_mark_root(region_growth_root(region_call_receiver), params, flags, structs) if region_growth_method(region_call_method)
                    region_scan_expression(region_call_callee, params, flags, structs)
                    for region_call_argument in region_call_arguments |params, flags, structs|:
                        region_scan_expression(region_call_argument, params, flags, structs)
                    return
                if expression is Expr.Field(region_field_object, region_field_name, region_field_line):
                    region_scan_expression(region_field_object, params, flags, structs)
                    return
                if expression is Expr.Scope(region_scope_base, region_scope_name, region_scope_line):
                    region_scan_expression(region_scope_base, params, flags, structs)
                    return
                if expression is Expr.Index(region_index_object, region_index_value, region_index_line):
                    region_scan_expression(region_index_object, params, flags, structs)
                    region_scan_expression(region_index_value, params, flags, structs)
                    return
                if expression is Expr.Slice(region_slice_object, region_slice_low, region_slice_high, region_slice_line):
                    region_scan_expression(region_slice_object, params, flags, structs)
                    region_scan_expression(region_slice_low, params, flags, structs)
                    region_scan_expression(region_slice_high, params, flags, structs)
                    return
                if expression is Expr.IndexN(region_indexn_object, region_indexn_arguments, region_indexn_line):
                    region_scan_expression(region_indexn_object, params, flags, structs)
                    for region_indexn_argument in region_indexn_arguments |params, flags, structs|:
                        region_scan_expression(region_indexn_argument, params, flags, structs)
                    return
                if expression is Expr.Binary(region_binary_left, region_binary_operator, region_binary_right, region_binary_line):
                    region_scan_expression(region_binary_left, params, flags, structs)
                    region_scan_expression(region_binary_right, params, flags, structs)
                    return
                if expression is Expr.Unary(region_unary_operator, region_unary_operand, region_unary_line):
                    region_scan_expression(region_unary_operand, params, flags, structs)
                    return
                if expression is Expr.Move(region_move_operand, region_move_line):
                    region_scan_expression(region_move_operand, params, flags, structs)
                    return
                if expression is Expr.RegionNew(region_new_operand, region_new_region, region_new_line):
                    region_scan_expression(region_new_operand, params, flags, structs)
                    return
                if expression is Expr.Paren(region_paren_inner, region_paren_line):
                    region_scan_expression(region_paren_inner, params, flags, structs)
                    return
                if expression is Expr.Array(region_array_elements, region_array_line) or expression is Expr.Tuple(region_array_elements, region_tuple_line) or expression is Expr.SetLit(region_array_elements, region_set_line):
                    for region_element in region_array_elements |params, flags, structs|:
                        region_scan_expression(region_element, params, flags, structs)
                    return
                if expression is Expr.DictLit(region_dict_entries, region_dict_line):
                    for region_entry in region_dict_entries |params, flags, structs|:
                        region_scan_expression(region_entry.key, params, flags, structs)
                        region_scan_expression(region_entry.value, params, flags, structs)
                    return
                if expression is Expr.Construct(region_construct_type, region_construct_fields, region_construct_line):
                    region_scan_expression(region_construct_type, params, flags, structs)
                    for region_field_init in region_construct_fields |params, flags, structs|:
                        region_scan_expression(region_field_init.value, params, flags, structs)
                    return
                if expression is Expr.RecordUpdate(region_update_base, region_update_fields, region_update_line):
                    region_scan_expression(region_update_base, params, flags, structs)
                    for region_field_init in region_update_fields |params, flags, structs|:
                        region_scan_expression(region_field_init.value, params, flags, structs)
                    return
                if expression is Expr.If(region_if_condition, region_if_then, region_if_else, region_if_line):
                    region_scan_expression(region_if_condition, params, flags, structs)
                    region_scan_expression(region_if_then, params, flags, structs)
                    region_scan_expression(region_if_else, params, flags, structs)
                    return
                if expression is Expr.Match(region_match_scrutinee, region_match_arms, region_match_line) or expression is Expr.Catch(region_match_scrutinee, region_match_arms, region_catch_line):
                    region_scan_expression(region_match_scrutinee, params, flags, structs)
                    for region_arm in region_match_arms |params, flags, structs|:
                        region_scan_expression(region_arm.guard, params, flags, structs)
                        region_scan_statements(region_arm.body, params, flags, structs)
                    return
                if expression is Expr.Comprehension(region_comp_var, region_comp_iterable, region_comp_condition, region_comp_body, region_comp_line):
                    region_scan_expression(region_comp_iterable, params, flags, structs)
                    region_scan_expression(region_comp_condition, params, flags, structs)
                    region_scan_expression(region_comp_body, params, flags, structs)
                    return
                if expression is Expr.Refinement(region_refinement_base, region_refinement_predicate, region_refinement_line):
                    region_scan_expression(region_refinement_base, params, flags, structs)
                    region_scan_expression(region_refinement_predicate, params, flags, structs)
                    return
                if expression is Expr.GetElse(region_get_guarded, region_get_recovery, region_get_line):
                    region_scan_expression(region_get_guarded, params, flags, structs)
                    region_scan_statements(region_get_recovery, params, flags, structs)
                    return
                if expression is Expr.Block(region_block_statements, region_block_value, region_block_captures, region_block_line):
                    region_scan_statements(region_block_statements, params, flags, structs)
                    region_scan_expression(region_block_value, params, flags, structs)
                    return
                if expression is Expr.StaticEffectCall(region_effect_type, region_effect_operation, region_effect_candidates, region_effect_arguments, region_effect_names, region_effect_line):
                    for region_effect_call in region_static_effect_candidate_calls(expression) |params, flags, structs|:
                        region_scan_expression(region_effect_call, params, flags, structs)
                    return




        def region_scan_statements(statements: darray[Stmt], params: darray[ParamDecl]&, flags: mutable darray[bool]&, structs: mutable StructTable&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                for region_statement in statements |params, flags, structs|:
                    if region_statement is Stmt.Expr(region_statement_expression, region_statement_line):
                        region_scan_expression(region_statement_expression, params, flags, structs)
                    elif region_statement is Stmt.VarDecl(region_var_name, region_var_type, region_var_value, region_var_line):
                        region_scan_expression(region_var_type, params, flags, structs)
                        region_scan_expression(region_var_value, params, flags, structs)
                    elif region_statement is Stmt.Assign(region_assign_target, region_assign_operator, region_assign_value, region_assign_line):
                        if region_assign_operator == TokenKind.PlusEq:
                            append_scope: mutable Scope = Scope{names: [], types: [], slots: [], pool_names: [], group_names: [], deferred: []}
                            for append_param in params |append_scope, structs|:
                                append_scope.names.push(append_param.name)
                                append_scope.types.push(annotation_value_type(append_param.type_expression, structs))
                            if darray_type_behind_expr(region_assign_target, append_scope, structs).kind == TypeKind.DArray:
                                region_mark_root(region_growth_root(region_assign_target), params, flags, structs)
                        # STORING freshly built region storage into a parameter's place
                        # (`rows[0] <- fresh`, `p.items <- built`) escapes it to the caller just
                        # as growth does: without the caller's arena `fresh` died with this
                        # function's (use-after-free; stage0 rejects "value escapes").
                        if region_assign_target is Expr.Ident(store_target_name, store_target_pos):
                            pass
                        elif region_store_value_allocates(region_assign_value, params):
                            store_scope: mutable Scope = Scope{names: [], types: [], slots: [], pool_names: [], group_names: [], deferred: []}
                            for store_param in params |store_scope, structs|:
                                store_scope.names.push(store_param.name)
                                store_scope.types.push(annotation_value_type(store_param.type_expression, structs))
                            if darray_type_behind_expr(region_assign_target, store_scope, structs).kind == TypeKind.DArray:
                                region_mark_root(region_growth_root(region_assign_target), params, flags, structs)
