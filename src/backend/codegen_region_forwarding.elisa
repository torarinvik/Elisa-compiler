                (name_owner, true) return if name_hits > 0 and not name_owner_conflict
                return (structs.visibility.current_owner, false)




        def region_fact_parameter_has_region(row: usize, parameter_position: usize, structs: StructTable&) -> bool can[Abort.Panic]:
            return false if row >= structs.regions.region_fact_starts.count or row >= structs.regions.region_fact_counts.count
            count: usize = structs.regions.region_fact_counts[row]
            return false if parameter_position >= count
            start: usize = structs.regions.region_fact_starts[row]
            return false if start > structs.regions.region_fact_params.count or count > structs.regions.region_fact_params.count - start
            return structs.regions.region_fact_params[start + parameter_position]




        # Map source arguments to callee parameter positions once per call. The sequential
        # assignment rules match named_argument_index: positional entries take the next free
        # parameter, names search only explicit parameters, and the first invalid or duplicate
        # entry stops later assignments while keeping earlier mappings usable.
        def region_forward_argument_positions(argument_names: darray[sview]&, receiver_offset: usize, row: i64, structs: StructTable&) -> darray[i64] can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic, Memory.Allocate:
                positions: mutable darray[i64] = [-1 for _ in 0..<argument_names.count]
                return positions if row < 0 or row.usize() >= structs.regions.region_fact_starts.count or row.usize() >= structs.regions.region_fact_counts.count or structs.regions.region_fact_param_names.count != structs.regions.region_fact_params.count
                start: usize = structs.regions.region_fact_starts[row.usize()]
                count: usize = structs.regions.region_fact_counts[row.usize()]
                return positions if start > structs.regions.region_fact_param_names.count or count > structs.regions.region_fact_param_names.count - start
                assigned: mutable darray[bool] = [false for _slot in 0..<count]
                assigned[0] <- true if receiver_offset == 1 and count > 0
                next_position: mutable usize = receiver_offset
                for argument_index in 0..<argument_names.count |positions, assigned, next_position, argument_names, structs, start, count, receiver_offset|:
                    argument_name: sview = argument_names[argument_index]
                    selected: mutable usize = count
                    if argument_name != "":
                        for parameter_index in receiver_offset..<count |selected, argument_name, structs, start|:
                            if structs.regions.region_fact_param_names[start + parameter_index] == argument_name:
                                selected <- parameter_index
                                break
                    else:
                        while next_position < count and assigned[next_position] |next_position, assigned|:
                            next_position <- next_position + 1
                        selected <- next_position
                        next_position <- next_position + 1 if next_position < count
                    break if selected >= count or assigned[selected]
                    positions[argument_index] <- selected.i64()
                    assigned[selected] <- true
                return positions




        def region_mark_forwarded(root: sview, parameter_position: usize, callee_fact_row: usize, params: darray[ParamDecl]&, structs: mutable StructTable&, fact_row: usize, changed: mutable bool&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                return if root == "" or root == "?"
                has_alias: mutable bool = false
                for alias_index in 0..<structs.regions.region_alias_names.count |has_alias, structs, root|:
                    has_alias <- true if structs.regions.region_alias_names[alias_index] == root
                if not has_alias:
                    for caller_position in 0..<params.count |params, structs, fact_row, root, changed, callee_fact_row, parameter_position|:
                        continue if params[caller_position].name != root
                        slot: usize = structs.regions.region_fact_starts[fact_row] + caller_position
                        return if structs.regions.region_fact_params[slot]
                        return if not region_fact_parameter_has_region(callee_fact_row, parameter_position, structs)
