                    elif root_node.usize() < node_start or root_node.usize() - node_start >= node_count:
                        graph_failed <- true
                    else:
                        generation: u64 = region_alias_graph_next_generation(graph_slot, structs)
                        if generation == 0:
                            graph_failed <- true
                        else:
                            structs.regions.region_alias_graph_pending_nodes.push(root_node)
                            structs.regions.region_alias_graph_node_seen[root_node.usize()] <- generation
                            node_cursor: mutable usize = 0
                            while node_cursor < structs.regions.region_alias_graph_pending_nodes.count |node_cursor, structs, graph_row, node_start, node_count, edge_start, edge_count, generation, params, parameter_position, callee_fact_row, fact_row, changed, graph_failed|:
                                current_node: i64 = structs.regions.region_alias_graph_pending_nodes[node_cursor]
                                node_cursor <- node_cursor + 1.usize()
                                if current_node < 0 or current_node.usize() < node_start or current_node.usize() - node_start >= node_count:
                                    graph_failed <- true
                                    break
                                current_node_index: usize = current_node.usize()
                                if structs.regions.region_alias_graph_node_names[current_node_index] == "" or structs.regions.region_alias_graph_node_names[current_node_index] == "?":
                                    continue
                                edge_cursor: mutable i64 = structs.regions.region_alias_graph_node_heads[current_node_index]
                                edge_steps: mutable usize = 0
                                while edge_cursor >= 0 and edge_steps < edge_count |edge_cursor, edge_steps, structs, edge_start, edge_count, node_start, node_count, generation, graph_failed|:
                                    edge_index: usize = edge_cursor.usize()
                                    if edge_index < edge_start or edge_index - edge_start >= edge_count:
                                        graph_failed <- true
                                        break
                                    if structs.regions.region_alias_graph_edge_sources[edge_index] != current_node_index.i64():
                                        graph_failed <- true
                                        break
                                    target_node: i64 = structs.regions.region_alias_graph_edge_targets[edge_index]
                                    if target_node < 0 or target_node.usize() < node_start or target_node.usize() - node_start >= node_count:
                                        graph_failed <- true
                                        break
                                    if structs.regions.region_alias_graph_node_seen[target_node.usize()] != generation:
                                        structs.regions.region_alias_graph_node_seen[target_node.usize()] <- generation
                                        structs.regions.region_alias_graph_pending_nodes.push(target_node)
                                    edge_cursor <- structs.regions.region_alias_graph_edge_next[edge_index]
                                    edge_steps <- edge_steps + 1.usize()
                                if edge_cursor != -1:
                                    graph_failed <- true
                                break if graph_failed
                                caller_position: i64 = structs.regions.region_alias_graph_node_params[current_node_index]
                                if caller_position < -1 or (caller_position >= 0 and caller_position.usize() >= params.count):
                                    graph_failed <- true
                                    break
                                if caller_position >= 0:
                                    if params[caller_position.usize()].name != structs.regions.region_alias_graph_node_names[current_node_index]:
                                        graph_failed <- true
                                        break
                                    if fact_row >= structs.regions.region_fact_starts.count or fact_row >= structs.regions.region_fact_counts.count:
                                        graph_failed <- true
                                        break
                                    fact_start: usize = structs.regions.region_fact_starts[fact_row]
                                    fact_count: usize = structs.regions.region_fact_counts[fact_row]
                                    if caller_position.usize() >= fact_count or fact_start > structs.regions.region_fact_params.count or fact_count > structs.regions.region_fact_params.count - fact_start:
                                        graph_failed <- true
                                        break
                                    slot: usize = fact_start + caller_position.usize()
                                    if not structs.regions.region_fact_params[slot] and region_fact_parameter_has_region(callee_fact_row, parameter_position, structs):
                                        structs.regions.region_fact_params[slot] <- true
                                        changed <- true
                            if not graph_failed:
                                return
                    restored: bool = region_alias_graph_restore_linear_aliases(graph_slot, structs)
                    structs.regions.region_alias_graph_active <- false
                    if not restored:
                        region_mark_all_forwarded_parameters(parameter_position, callee_fact_row, params, structs, fact_row, changed)
                        return
                    # The indexed path validates the caller fact row before it mutates
                    # individual slots. If that validation caused the graph walk to fall
                    # back, keep the same fail-closed behavior here: the legacy path below
                    # indexes these rows directly.
                    if fact_row >= structs.regions.region_fact_starts.count or fact_row >= structs.regions.region_fact_counts.count:
                        region_mark_all_forwarded_parameters(parameter_position, callee_fact_row, params, structs, fact_row, changed)
                        return
                    fallback_fact_start: usize = structs.regions.region_fact_starts[fact_row]
                    fallback_fact_count: usize = structs.regions.region_fact_counts[fact_row]
                    if fallback_fact_start > structs.regions.region_fact_params.count or fallback_fact_count != params.count or fallback_fact_count > structs.regions.region_fact_params.count - fallback_fact_start:
                        region_mark_all_forwarded_parameters(parameter_position, callee_fact_row, params, structs, fact_row, changed)
                        return
                elif structs.regions.region_alias_graph_active:
                    structs.regions.region_alias_graph_active <- false
                    region_mark_all_forwarded_parameters(parameter_position, callee_fact_row, params, structs, fact_row, changed)
                    return
                has_alias: mutable bool = false
                for alias_index in 0..<structs.regions.region_alias_names.count |has_alias, structs, root|:
                    has_alias <- true if structs.regions.region_alias_names[alias_index] == root
                if not has_alias:
                    for caller_position in 0..<params.count |params, structs, fact_row, root, changed, callee_fact_row, parameter_position|:
                        continue if params[caller_position].name != root
                        slot: usize = structs.regions.region_fact_starts[fact_row] + caller_position
                        return if structs.regions.region_fact_params[slot]
                        return if not region_fact_parameter_has_region(callee_fact_row, parameter_position, structs)
                        structs.regions.region_fact_params[slot] <- true
                        changed <- true
                        return
                    return
                pending: mutable darray[sview] = [root]
                visited: mutable darray[sview] = []
                cursor: mutable usize = 0
                while cursor < pending.count |pending, visited, cursor, parameter_position, callee_fact_row, params, structs, fact_row, changed|:
                    current_root: sview = pending[cursor]
                    cursor <- cursor + 1
                    continue if current_root == "" or current_root == "?"
                    already_visited: mutable bool = false
                    for visited_index in 0..<visited.count |already_visited, visited, current_root|:
                        already_visited <- true if visited[visited_index] == current_root
                    continue if already_visited
                    visited.push(current_root)
                    for alias_index in 0..<structs.regions.region_alias_names.count |pending, structs, current_root|:
                        if structs.regions.region_alias_names[alias_index] == current_root:
                            pending.push(structs.regions.region_alias_roots[alias_index])
                    for caller_position in 0..<params.count |params, structs, fact_row, current_root, changed, callee_fact_row, parameter_position|:
                        continue if params[caller_position].name != current_root
                        slot: usize = structs.regions.region_fact_starts[fact_row] + caller_position
                        continue if structs.regions.region_fact_params[slot]
                        continue if not region_fact_parameter_has_region(callee_fact_row, parameter_position, structs)
                        structs.regions.region_fact_params[slot] <- true
                        changed <- true
                        break




        # Apply one possible callee declaration row. Overloaded declarations are unioned
        # below; each row gets its own labels, parameter count and forwarding facts.
        def region_forward_call_row(row: usize, arguments: darray[Expr]&, argument_names: darray[sview]&, receiver_offset: usize, named_call: bool, minimum_position: usize, receiver_root: sview, params: darray[ParamDecl]&, structs: mutable StructTable&, fact_row: usize, changed: mutable bool&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                return if row >= structs.regions.region_fact_starts.count or row >= structs.regions.region_fact_counts.count
                start: usize = structs.regions.region_fact_starts[row]
                count: usize = structs.regions.region_fact_counts[row]
                return if start > structs.regions.region_fact_params.count or count > structs.regions.region_fact_params.count - start
                return if minimum_position >= count
                if receiver_offset == 1 and minimum_position == 0:
                    region_mark_forwarded(receiver_root, 0.usize(), row, params, structs, fact_row, changed)
