                        while second_cursor >= 0 and second_cursor.usize() < structs.regions.region_fact_names.count |second_cursor, structs, callee_name, region_forward_call_arguments, region_forward_call_names, receiver_offset, named_call, receiver_root, params, fact_row, changed, indexed|:
                            candidate_row: usize = second_cursor.usize()
                            second_cursor <- structs.regions.region_fact_next[candidate_row] if indexed else second_cursor + 1
