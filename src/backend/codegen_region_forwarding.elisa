# Stage1 backend — the region-forwarding PRE-PASS: walk each body, mark the locals and callees
# that allocate into a caller's region, and record the forwarded flags the signature facts in
# codegen_abi_regions.elisa then read. Part of `module Backend` (see codegen.elisa).

extend Backend:
    private:
        const REGION_FACT_BUCKET_COUNT: usize = 1024
        const REGION_FACT_HASH_OFFSET: u64 = 14695981039346656037
        const REGION_FACT_HASH_PRIME: u64 = 1099511628211

        def region_fact_name_bucket(name: sview) -> usize:
            hash: mutable u64 = REGION_FACT_HASH_OFFSET
            for index in 0..<sview_len(name) |hash, name|:
                hash <- (hash ^ sview_at(name, index).u64()) * REGION_FACT_HASH_PRIME
            return (hash % REGION_FACT_BUCKET_COUNT.u64()).usize()

        def region_build_name_index(structs: mutable StructTable&) -> void can[Abort.Panic, Memory.Allocate]:
            structs.regions.region_fact_buckets <- []
            structs.regions.region_fact_next <- []
            for _ in 0..<REGION_FACT_BUCKET_COUNT |structs|:
                structs.regions.region_fact_buckets <- structs.regions.region_fact_buckets.push(-1)
            for _ in 0..<structs.regions.region_fact_names.count |structs|:
                structs.regions.region_fact_next <- structs.regions.region_fact_next.push(-1)
            # Prepend in reverse so collisions and duplicate names retain source order.
            remaining: mutable usize = structs.regions.region_fact_names.count
            while remaining > 0 |remaining, structs|:
                remaining <- remaining - 1
                bucket: usize = region_fact_name_bucket(structs.regions.region_fact_names[remaining])
                structs.regions.region_fact_next[remaining] <- structs.regions.region_fact_buckets[bucket]
                structs.regions.region_fact_buckets[bucket] <- remaining.i64()


        # Load the reference aliases of the body about to be scanned. The collector fills
        # the tables in `structs` directly: staging the names in a local darray and copying
        # them over gave each name that local's inferred region, which stage0 rejects as a
        # store into the longer-lived `structs` (likewise for scope_load_aliases).
        def region_load_aliases(body: darray[Stmt], structs: mutable StructTable&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                structs.regions.region_alias_names <- []
                structs.regions.region_alias_roots <- []
                ref_alias_collect(body, structs, structs.regions.region_alias_names, structs.regions.region_alias_roots)




        # A stored value that may carry storage from THIS function's arena: a named local
        # (not a parameter, whose storage the caller already owns), a non-empty literal, or
        # a call result (built in the call-site arena). `[]` allocates nothing.
        def region_store_value_allocates(value: Expr, params: darray[ParamDecl]&) -> bool can[Abort.Panic]:
            if value is Expr.Ident(store_value_name, store_value_pos):
                for store_param in params |store_value_name|:
                    false return if store_param.name == store_value_name
                return true
            if value is Expr.Array(store_elements, store_array_pos):
                return store_elements.count > 0
            if value is Expr.Paren(store_inner, store_paren_pos):
                can Abort.Panic:
                    return region_store_value_allocates(store_inner, params)
            if value is Expr.Move(store_moved, store_move_pos):
                can Abort.Panic:
                    return region_store_value_allocates(store_moved, params)
            if value is Expr.Call(store_callee, store_arguments, store_names, store_call_pos):
                return true
            if value is Expr.StaticEffectCall(store_effect_type, store_effect_operation, store_effect_candidates, store_effect_arguments, store_effect_names, store_effect_pos):
                return true
            return false

        # A generic effect operation (`Sink[T].put(out, v)`) lowers at EMIT time to a direct
        # call of the selected handler operation (lower_static_effect_call), with the
        # handler's captures prepended. The pre-pass never saw that call, so a handler that
        # grew `out` left this function without the caller's arena: the clone received the
        # null no-region placeholder and passed it on (segfault). Scan every candidate as the
        # call it may become -- over-approximating the selection only moves storage UP the
        # placement ladder, which is always sound.
        def region_static_effect_candidate_calls(expression: Expr) -> darray[Expr] can[Abort.Panic, Memory.Allocate]:
            calls: mutable darray[Expr] = []
            if expression is Expr.StaticEffectCall(effect_type, effect_operation, effect_candidates, effect_arguments, effect_argument_names, effect_position):
                for effect_candidate in effect_candidates |calls, effect_arguments, effect_argument_names, effect_position|:
                    candidate_arguments: mutable darray[Expr] = []
                    candidate_names: mutable darray[sview] = []
                    for effect_capture in effect_candidate.captures |candidate_arguments, candidate_names|:
                        candidate_arguments.push(effect_capture)
                        candidate_names.push("")
                    for effect_index in 0..<effect_arguments.count |candidate_arguments, candidate_names, effect_arguments, effect_argument_names|:
                        candidate_arguments.push(effect_arguments[effect_index])
                        candidate_names.push(effect_argument_names[effect_index] if effect_index < effect_argument_names.count else "")
                    candidate_callee: mutable Expr = Expr.Ident(effect_candidate.callee, Ast::pos_at_line(0))
                    if effect_candidate.callee_owner != "":
                        candidate_callee <- Expr.Scope(Expr.Ident(effect_candidate.callee_owner, Ast::pos_at_line(0)), effect_candidate.callee, Ast::pos_at_line(0))
                    calls.push(Expr.Call(candidate_callee, candidate_arguments, candidate_names, effect_position))
            return calls




        def region_mark_root(root: sview, params: darray[ParamDecl]&, flags: mutable darray[bool]&, structs: mutable StructTable&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                return if root == "" or root == "?"
                has_alias: mutable bool = false
                for alias_index in 0..<structs.regions.region_alias_names.count |has_alias, structs, root|:
                    has_alias <- true if structs.regions.region_alias_names[alias_index] == root
                if not has_alias:
                    for parameter_index in 0..<params.count |params, flags, root, structs|:
                        continue if params[parameter_index].name != root
                        parameter_type: ValueType = parameter_value_type(params[parameter_index].type_expression, structs)
                        flags[parameter_index] <- true if ref_type_can_grow(parameter_type, structs)
                        return
                    return
                pending: mutable darray[sview] = [root]
                visited: mutable darray[sview] = []
                cursor: mutable usize = 0
                while cursor < pending.count |pending, visited, cursor, params, flags, structs|:
                    current_root: sview = pending[cursor]
                    cursor <- cursor + 1
                    continue if current_root == "" or current_root == "?"
                    already_visited: mutable bool = false
                    for visited_index in 0..<visited.count |already_visited, visited, current_root|:
                        already_visited <- true if visited[visited_index] == current_root
                    continue if already_visited
                    visited.push(current_root)
                    for parameter_index in 0..<params.count |params, flags, current_root, structs|:
                        continue if params[parameter_index].name != current_root
                        parameter_type: ValueType = parameter_value_type(params[parameter_index].type_expression, structs)
                        flags[parameter_index] <- true if ref_type_can_grow(parameter_type, structs)
                        break
                    for alias_index in 0..<structs.regions.region_alias_names.count |pending, structs, current_root|:
                        if structs.regions.region_alias_names[alias_index] == current_root:
                            pending.push(structs.regions.region_alias_roots[alias_index])




        def region_scan_expression(expression: Expr, params: darray[ParamDecl]&, flags: mutable darray[bool]&, structs: mutable StructTable&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                if expression is Expr.Call(region_call_callee, region_call_arguments, region_call_names, region_call_line):
                    if region_call_callee is Expr.Field(region_call_receiver, region_call_method, region_call_field_line):
                        region_mark_root(region_growth_root(region_call_receiver), params, flags, structs) if region_growth_method(region_call_method)
                    region_scan_expression(region_call_callee, params, flags, structs)
                    for region_call_argument in region_call_arguments |params, flags, structs|:
                        region_scan_expression(region_call_argument, params, flags, structs)
                    return
                if expression is Expr.Field(region_field_object, region_field_name, region_field_line):
                    region_scan_expression(region_field_object, params, flags, structs)
                    return
                if expression is Expr.Scope(region_scope_base, region_scope_name, region_scope_line):
                    region_scan_expression(region_scope_base, params, flags, structs)
                    return
                if expression is Expr.Index(region_index_object, region_index_value, region_index_line):
                    region_scan_expression(region_index_object, params, flags, structs)
                    region_scan_expression(region_index_value, params, flags, structs)
                    return
                if expression is Expr.Slice(region_slice_object, region_slice_low, region_slice_high, region_slice_line):
                    region_scan_expression(region_slice_object, params, flags, structs)
                    region_scan_expression(region_slice_low, params, flags, structs)
                    region_scan_expression(region_slice_high, params, flags, structs)
                    return
                if expression is Expr.IndexN(region_indexn_object, region_indexn_arguments, region_indexn_line):
                    region_scan_expression(region_indexn_object, params, flags, structs)
                    for region_indexn_argument in region_indexn_arguments |params, flags, structs|:
                        region_scan_expression(region_indexn_argument, params, flags, structs)
                    return
                if expression is Expr.Binary(region_binary_left, region_binary_operator, region_binary_right, region_binary_line):
                    region_scan_expression(region_binary_left, params, flags, structs)
                    region_scan_expression(region_binary_right, params, flags, structs)
                    return
                if expression is Expr.Unary(region_unary_operator, region_unary_operand, region_unary_line):
                    region_scan_expression(region_unary_operand, params, flags, structs)
                    return
                if expression is Expr.Move(region_move_operand, region_move_line):
                    region_scan_expression(region_move_operand, params, flags, structs)
                    return
                if expression is Expr.RegionNew(region_new_operand, region_new_region, region_new_line):
                    region_scan_expression(region_new_operand, params, flags, structs)
                    return
                if expression is Expr.Paren(region_paren_inner, region_paren_line):
                    region_scan_expression(region_paren_inner, params, flags, structs)
                    return
                if expression is Expr.Array(region_array_elements, region_array_line) or expression is Expr.Tuple(region_array_elements, region_tuple_line) or expression is Expr.SetLit(region_array_elements, region_set_line):
                    for region_element in region_array_elements |params, flags, structs|:
                        region_scan_expression(region_element, params, flags, structs)
                    return
                if expression is Expr.DictLit(region_dict_entries, region_dict_line):
                    for region_entry in region_dict_entries |params, flags, structs|:
                        region_scan_expression(region_entry.key, params, flags, structs)
                        region_scan_expression(region_entry.value, params, flags, structs)
                    return
                if expression is Expr.Construct(region_construct_type, region_construct_fields, region_construct_line):
                    region_scan_expression(region_construct_type, params, flags, structs)
                    for region_field_init in region_construct_fields |params, flags, structs|:
                        region_scan_expression(region_field_init.value, params, flags, structs)
                    return
                if expression is Expr.RecordUpdate(region_update_base, region_update_fields, region_update_line):
                    region_scan_expression(region_update_base, params, flags, structs)
                    for region_field_init in region_update_fields |params, flags, structs|:
                        region_scan_expression(region_field_init.value, params, flags, structs)
                    return
                if expression is Expr.If(region_if_condition, region_if_then, region_if_else, region_if_line):
                    region_scan_expression(region_if_condition, params, flags, structs)
                    region_scan_expression(region_if_then, params, flags, structs)
                    region_scan_expression(region_if_else, params, flags, structs)
                    return
                if expression is Expr.Match(region_match_scrutinee, region_match_arms, region_match_line) or expression is Expr.Catch(region_match_scrutinee, region_match_arms, region_catch_line):
                    region_scan_expression(region_match_scrutinee, params, flags, structs)
                    for region_arm in region_match_arms |params, flags, structs|:
                        region_scan_expression(region_arm.guard, params, flags, structs)
                        region_scan_statements(region_arm.body, params, flags, structs)
                    return
                if expression is Expr.Comprehension(region_comp_var, region_comp_iterable, region_comp_condition, region_comp_body, region_comp_line):
                    region_scan_expression(region_comp_iterable, params, flags, structs)
                    region_scan_expression(region_comp_condition, params, flags, structs)
                    region_scan_expression(region_comp_body, params, flags, structs)
                    return
                if expression is Expr.Refinement(region_refinement_base, region_refinement_predicate, region_refinement_line):
                    region_scan_expression(region_refinement_base, params, flags, structs)
                    region_scan_expression(region_refinement_predicate, params, flags, structs)
                    return
                if expression is Expr.GetElse(region_get_guarded, region_get_recovery, region_get_line):
                    region_scan_expression(region_get_guarded, params, flags, structs)
                    region_scan_statements(region_get_recovery, params, flags, structs)
                    return
                if expression is Expr.Block(region_block_statements, region_block_value, region_block_captures, region_block_line):
                    region_scan_statements(region_block_statements, params, flags, structs)
                    region_scan_expression(region_block_value, params, flags, structs)
                    return
                if expression is Expr.StaticEffectCall(region_effect_type, region_effect_operation, region_effect_candidates, region_effect_arguments, region_effect_names, region_effect_line):
                    for region_effect_call in region_static_effect_candidate_calls(expression) |params, flags, structs|:
                        region_scan_expression(region_effect_call, params, flags, structs)
                    return




        def region_scan_statements(statements: darray[Stmt], params: darray[ParamDecl]&, flags: mutable darray[bool]&, structs: mutable StructTable&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                for region_statement in statements |params, flags, structs|:
                    if region_statement is Stmt.Expr(region_statement_expression, region_statement_line):
                        region_scan_expression(region_statement_expression, params, flags, structs)
                    elif region_statement is Stmt.VarDecl(region_var_name, region_var_type, region_var_value, region_var_line):
                        region_scan_expression(region_var_type, params, flags, structs)
                        region_scan_expression(region_var_value, params, flags, structs)
                    elif region_statement is Stmt.Assign(region_assign_target, region_assign_operator, region_assign_value, region_assign_line):
                        if region_assign_operator == TokenKind.PlusEq:
                            append_scope: mutable Scope = Scope{names: [], types: [], slots: [], pool_names: [], group_names: [], deferred: []}
                            for append_param in params |append_scope, structs|:
                                append_scope.names.push(append_param.name)
                                append_scope.types.push(annotation_value_type(append_param.type_expression, structs))
                            if darray_type_behind_expr(region_assign_target, append_scope, structs).kind == TypeKind.DArray:
                                region_mark_root(region_growth_root(region_assign_target), params, flags, structs)
                        # STORING freshly built region storage into a parameter's place
                        # (`rows[0] <- fresh`, `p.items <- built`) escapes it to the caller just
                        # as growth does: without the caller's arena `fresh` died with this
                        # function's (use-after-free; stage0 rejects "value escapes").
                        if region_assign_target is Expr.Ident(store_target_name, store_target_pos):
                            pass
                        elif region_store_value_allocates(region_assign_value, params):
                            store_scope: mutable Scope = Scope{names: [], types: [], slots: [], pool_names: [], group_names: [], deferred: []}
                            for store_param in params |store_scope, structs|:
                                store_scope.names.push(store_param.name)
                                store_scope.types.push(annotation_value_type(store_param.type_expression, structs))
                            if darray_type_behind_expr(region_assign_target, store_scope, structs).kind == TypeKind.DArray:
                                region_mark_root(region_growth_root(region_assign_target), params, flags, structs)
                        # Replacing a growable output reference needs its caller arena.
                        # A scalar member write is not growth of the containing struct.
                        if region_assign_target is Expr.Ident(assigned_name, assigned_pos):
                            region_mark_root(assigned_name, params, flags, structs)
                        region_scan_expression(region_assign_target, params, flags, structs)
                        region_scan_expression(region_assign_value, params, flags, structs)
                    elif region_statement is Stmt.Return(region_return_value, region_return_line):
                        if region_return_value is region_returned:
                            region_scan_expression(region_returned, params, flags, structs)
                    elif region_statement is Stmt.If(region_stmt_if_condition, region_stmt_if_then, region_stmt_if_else, region_stmt_if_line):
                        region_scan_expression(region_stmt_if_condition, params, flags, structs)
                        region_scan_statements(region_stmt_if_then, params, flags, structs)
                        region_scan_statements(region_stmt_if_else, params, flags, structs)
                    elif region_statement is Stmt.While(region_stmt_while_condition, region_stmt_while_body, region_stmt_while_line):
                        region_scan_expression(region_stmt_while_condition, params, flags, structs)
                        region_scan_statements(region_stmt_while_body, params, flags, structs)
                    elif region_statement is Stmt.For(region_for_bind, region_for_variables, region_for_iterable, region_for_body, region_for_line):
                        region_scan_expression(region_for_iterable, params, flags, structs)
                        region_scan_statements(region_for_body, params, flags, structs)
                    elif region_statement is Stmt.Block(region_stmt_block_kind, region_stmt_block_clause, region_stmt_block_binding, region_stmt_block_body, region_stmt_block_line):
                        skipped_in_block: bool = structs.memory.region_scan_skips_in_blocks and region_stmt_block_kind == "in" and region_stmt_block_clause.count == 1 and region_stmt_block_clause[0] != "auto"
                        region_scan_statements(region_stmt_block_body, params, flags, structs) if not skipped_in_block
                    elif region_statement is Stmt.Match(region_stmt_match_scrutinee, region_stmt_match_arms, region_stmt_match_line):
                        region_scan_expression(region_stmt_match_scrutinee, params, flags, structs)
                        for region_stmt_arm in region_stmt_match_arms |params, flags, structs|:
                            region_scan_expression(region_stmt_arm.guard, params, flags, structs)
                            region_scan_statements(region_stmt_arm.body, params, flags, structs)
                    elif region_statement is Stmt.Contract(region_contract_kind, region_contract_expression, region_contract_line):
                        region_scan_expression(region_contract_expression, params, flags, structs)




        def body_region_parameter_flags(params: darray[ParamDecl]&, body: darray[Stmt], structs: mutable StructTable&, flags: mutable darray[bool]&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                for _ in 0..<params.count |flags|:
                    flags.push(false)
                return if params_manage_arena(params, structs)
                region_load_aliases(body, structs)
                region_scan_statements(body, params, flags, structs)
                return




        # An arena-managed function (params_manage_arena) has no hidden caller slot, so a
        # reference parameter it grows OUTSIDE an `in <arena>:` block would grow in this
        # function's own auto region -- freed at return while the caller still owns the
        # container (measured: `plain_arena(a, ys)` doing `ys.push(2)` reallocated `ys` into
        # `%auto.region` and then called `arena_free` on it). stage0 rejects exactly this
        # ("darray push has no region to grow into"), so the body declines instead.
        def arena_managed_growth_outside_in(params: darray[ParamDecl]&, body: darray[Stmt], structs: mutable StructTable&) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                false return if not params_manage_arena(params, structs)
                outside_flags: mutable darray[bool] = []
                for _ in 0..<params.count |outside_flags|:
                    outside_flags.push(false)
                structs.memory.region_scan_skips_in_blocks <- true
                region_load_aliases(body, structs)
                region_scan_statements(body, params, outside_flags, structs)
                structs.memory.region_scan_skips_in_blocks <- false
                for outside_flag in outside_flags:
                    true return if outside_flag
                return false




        # The name under an explicit instantiation's head (`f`, `M::f`, `recv.f`).
        def region_callee_head_name(head: Expr) -> sview can[Abort.Panic]:
            if head is Expr.Ident(region_head_ident, region_head_ident_line):
                return region_head_ident
            if head is Expr.Field(region_head_object, region_head_field, region_head_field_line):
                return region_head_field
            if head is Expr.Scope(region_head_base, region_head_scope, region_head_scope_line):
                return region_head_scope
            return ""




        def region_callee_name(callee: Expr) -> sview can[Abort.Panic]:
            if callee is Expr.Ident(region_callee_ident, region_callee_ident_line):
                return region_callee_ident
            if callee is Expr.Field(region_callee_object, region_callee_field, region_callee_field_line):
                return region_callee_field
            if callee is Expr.Scope(region_callee_base, region_callee_scope, region_callee_scope_line):
                return region_callee_scope
            # `f[T](...)` / `f[K, V](...)`: an explicit instantiation calls the template `f`.
            # Without this, forwarding a parameter into a generic that grows it was invisible:
            # the caller took no arena and the generic grew its storage in the caller's own
            # auto region, freed on return.
            can Abort.Panic:
                if callee is Expr.Index(region_callee_generic_head, region_callee_generic_arg, region_callee_generic_line):
                    return region_callee_head_name(region_callee_generic_head)
                if callee is Expr.IndexN(region_callee_generic_heads, region_callee_generic_args, region_callee_generic_lines):
                    return region_callee_head_name(region_callee_generic_heads)
            return ""




        # Resolve the owner used by the region-forwarding pre-pass: the function ordinary
        # codegen will actually CALL, found with its rules over the fact rows. A qualified
        # call names its owner in the scope expression; the module alias table is consulted
        # too, so `using Box as B` and `B::add(...)` do not lose the region fact merely
        # because the source spelling is short.
        #
        # A bare call follows emit_call_named: the enclosing module's own member at that
        # arity, then a top-level function, then the one owner declaring that name (or that
        # name at that arity). A receiver call follows the UFCS path: top level first, then
        # the unique owner. `arity` counts the receiver.
        #
        # Answering "the enclosing module" for every bare call was a use-after-free. A helper
        # in `extend Semantic` that only FORWARDS its `mutable darray[u8]&` to `push_sview`
        # (declared in `module Bytes`, reached through `using Bytes`) found no Semantic row
        # and no top-level row, so its parameter was not marked. The helper then took no
        # caller arena, gave the callee its own `auto.region`, and freed the buffer's new
        # storage on return: the self-hosted compiler printed diagnostics whose first bytes
        # were zero.
        def region_callee_owner(callee: Expr, arity: usize, structs: StructTable&) -> (owner: sview, resolved: bool) can[Abort.Panic]:
            can Abort.Panic:
                # Explicit generic application wraps the callee in Index/IndexN. Preserve
                # the module owner from its head (`M::f[T](...)`) instead of resolving the
                # extracted name as a bare call that could pick a same-named top-level row.
                if callee is Expr.Index(region_owner_generic_head, region_owner_generic_arg, region_owner_generic_line):
                    if region_owner_generic_head is Expr.Scope(_, _, _):
                        return region_callee_owner(region_owner_generic_head, arity, structs)
                if callee is Expr.IndexN(region_owner_generic_heads, region_owner_generic_args, region_owner_generic_lines):
                    if region_owner_generic_heads is Expr.Scope(_, _, _):
                        return region_callee_owner(region_owner_generic_heads, arity, structs)
                if callee is Expr.Scope(region_owner_base, region_owner_name, region_owner_line):
                    if region_owner_base is Expr.Ident(region_owner_ident, region_owner_ident_line):
                        for alias_index in 0..<structs.aliases.module_alias_names.count |structs, region_owner_ident|:
                            return (structs.aliases.module_alias_targets[alias_index], true) if structs.aliases.module_alias_names[alias_index] == region_owner_ident
                        return (region_owner_ident, true)
                    return (structs.visibility.current_owner, false)
                receiver_call: mutable bool = false
                if callee is Expr.Field(region_owner_receiver, region_owner_method, region_owner_method_line):
                    receiver_call <- true
                name: sview = region_callee_name(callee)
                top_level_name: mutable bool = false
                name_hits: mutable i64 = 0
                name_owner: mutable sview = ""
                name_owner_conflict: mutable bool = false
                own_arity_hits: mutable i64 = 0
                indexed: bool = structs.regions.region_fact_buckets.count == REGION_FACT_BUCKET_COUNT and structs.regions.region_fact_next.count == structs.regions.region_fact_names.count
