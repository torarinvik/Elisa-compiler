                    # instead of rescanning the full names array for every argument.
                    named_call: mutable bool = false
                    for argument_name in region_forward_call_names |named_call|:
                        named_call <- true if argument_name != ""
                    indexed: bool = structs.regions.region_fact_buckets.count == REGION_FACT_BUCKET_COUNT and structs.regions.region_fact_next.count == structs.regions.region_fact_names.count
                    first_cursor: mutable i64 = structs.regions.region_fact_buckets[region_fact_name_bucket(callee_name)] if indexed else 0
                    exact_owner_found: mutable bool = false
                    ownerless_found: mutable bool = false
                    exact_owner_max_count: mutable usize = 0
                    while first_cursor >= 0 and first_cursor.usize() < structs.regions.region_fact_names.count |first_cursor, structs, callee_name, callee_owner, callee_resolution, exact_owner_found, ownerless_found, exact_owner_max_count, region_forward_call_arguments, region_forward_call_names, receiver_offset, named_call, receiver_root, params, fact_row, changed, indexed|:
                        candidate_row: usize = first_cursor.usize()
                        first_cursor <- structs.regions.region_fact_next[candidate_row] if indexed else first_cursor + 1
                        continue if structs.regions.region_fact_names[candidate_row] != callee_name
                        candidate_owner: sview = structs.regions.region_fact_owners[candidate_row]
                        if not callee_resolution.resolved:
                            region_forward_call_row(candidate_row, region_forward_call_arguments, region_forward_call_names, receiver_offset, named_call, 0.usize(), receiver_root, params, structs, fact_row, changed)
                        elif candidate_owner == callee_owner:
                            exact_owner_found <- true
                            exact_owner_max_count <- structs.regions.region_fact_counts[candidate_row] if structs.regions.region_fact_counts[candidate_row] > exact_owner_max_count
                            region_forward_call_row(candidate_row, region_forward_call_arguments, region_forward_call_names, receiver_offset, named_call, 0.usize(), receiver_root, params, structs, fact_row, changed)
