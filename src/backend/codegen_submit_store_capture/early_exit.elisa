extend Backend:
    private:
        def submit_group_runtime_api_declaration_name(declaration: Decl) -> sview can[Abort.Panic]:
            match declaration:
                # Identity is the bundled runtime source line (checked by the caller) plus
                # the body shape below. `@internal` is not required: task_group_new, _add
                # and _wait_all became public API (e734d6f5c), and demanding the marker
                # declined every lexical nursery in the runtime.
                Decl.Func(name: name, body: body, _):
                    if name == "task_group_new":
                        return name if submit_group_statement_list_calls_name(body, "task_group_new_raw")
                    if name == "task_group_wait_all":
                        return name if submit_group_statement_list_calls_name(body, "task_group_wait_all_raw") and submit_group_statement_list_calls_name(body, "ctx_task_group_release_all")
                    if name == "task_group_add":
                        return name if submit_group_statement_list_calls_name(body, "task_group_add_raw")
                    if name == "task_group_new_raw":
                        return name
                    if name == "task_group_add_raw":
                        return name if submit_group_statement_list_calls_name(body, "ctx_concurrency_alloc")
                    if name == "task_group_wait_all_raw":
                        return name if submit_group_statement_list_calls_name(body, "ctx_pool_wait_record")
                    if name == "ctx_task_group_release_all":
                        return name if submit_group_statement_list_calls_name(body, "ctx_concurrency_work1_release")
                    if name == "ctx_pool_wait_record":
                        return name if submit_group_statement_list_calls_name(body, "ctx_pool_wait")
                    return ""
                _:
                    return ""


        def submit_group_early_exit_expression(expression: Expr) -> bool can[Abort.Panic]:
            match expression:
                Expr.GetElse(_, _, _):
                    return true
                Expr.Lambda(_, _, _):
                    return false
                Expr.Call(callee, arguments, _, _):
                    return true if submit_group_early_exit_expression(callee)
                    for argument in arguments:
                        return true if submit_group_early_exit_expression(argument)
                    return false
                Expr.StaticEffectCall(arguments: arguments, _):
                    for argument in arguments:
                        return true if submit_group_early_exit_expression(argument)
                    return false
                Expr.Field(object, _, _) | Expr.Scope(object, _, _) | Expr.Unary(_, object, _) | Expr.Move(object, _) | Expr.RegionNew(object, _, _) | Expr.Paren(object, _):
                    return submit_group_early_exit_expression(object)
                Expr.Index(object, index, _) | Expr.Binary(object, _, index, _):
                    return submit_group_early_exit_expression(object) or submit_group_early_exit_expression(index)
                Expr.Slice(object, low, high, _):
                    return submit_group_early_exit_expression(object) or submit_group_early_exit_expression(low) or submit_group_early_exit_expression(high)
                Expr.IndexN(object, indices, _):
                    return true if submit_group_early_exit_expression(object)
                    for index in indices:
                        return true if submit_group_early_exit_expression(index)
                    return false
                Expr.Array(elements, _) | Expr.Tuple(elements, _) | Expr.SetLit(elements, _):
                    for element in elements:
                        return true if submit_group_early_exit_expression(element)
                    return false
                Expr.DictLit(entries, _):
                    for entry in entries:
                        return true if submit_group_early_exit_expression(entry.key) or submit_group_early_exit_expression(entry.value)
                    return false
                Expr.Construct(_, fields, _):
                    for field in fields:
                        return true if submit_group_early_exit_expression(field.value)
                    return false
                Expr.RecordUpdate(base, fields, _):
                    return true if submit_group_early_exit_expression(base)
                    for field in fields:
                        return true if submit_group_early_exit_expression(field.value)
                    return false
                Expr.If(condition, then_expression, else_expression, _):
                    return submit_group_early_exit_expression(condition) or submit_group_early_exit_expression(then_expression) or submit_group_early_exit_expression(else_expression)
                Expr.Match(scrutinee, arms, _) | Expr.Catch(scrutinee, arms, _):
                    return true if submit_group_early_exit_expression(scrutinee)
                    for arm in arms:
                        return true if submit_group_early_exit_expression(arm.guard) or submit_group_early_exit_statements(arm.body)
                    return false
                Expr.Comprehension(iterable: iterable, condition: condition, body: body, _):
                    return submit_group_early_exit_expression(iterable) or submit_group_early_exit_expression(condition) or submit_group_early_exit_expression(body)
                Expr.Refinement(base, predicate, _):
                    return submit_group_early_exit_expression(base) or submit_group_early_exit_expression(predicate)
                Expr.Block(statements, value, _, _):
                    return submit_group_early_exit_statements(statements) or submit_group_early_exit_expression(value)
                Expr.Invalid | Expr.Absent | Expr.IntLit(_, _) | Expr.FloatLit(_, _) | Expr.StringLit(_, _) | Expr.CharLit(_, _) | Expr.BoolLit(_, _) | Expr.Ident(_, _) | Expr.ShorthandMember(_, _):
                    return false
                _:
                    return true


        def submit_group_early_exit_statements(statements: darray[Stmt]) -> bool can[Abort.Panic]:
            for statement in statements:
                match statement:
                    Stmt.Return(_, _) | Stmt.Break(_, _) | Stmt.Continue(_, _):
                        return true
                    Stmt.Expr(expression, _):
                        return true if submit_group_early_exit_expression(expression)
                    Stmt.VarDecl(value: value, _):
                        return true if submit_group_early_exit_expression(value)
                    Stmt.Assign(target, _, value, _):
                        return true if submit_group_early_exit_expression(target) or submit_group_early_exit_expression(value)
                    Stmt.If(condition, then_body, else_body, _):
                        return true if submit_group_early_exit_expression(condition) or submit_group_early_exit_statements(then_body) or submit_group_early_exit_statements(else_body)
                    Stmt.While(condition, body, _):
                        return true if submit_group_early_exit_expression(condition) or submit_group_early_exit_statements(body)
                    Stmt.For(iterable: iterable, body: body, _):
                        return true if submit_group_early_exit_expression(iterable) or submit_group_early_exit_statements(body)
                    Stmt.Block(body: body, _):
                        return true if submit_group_early_exit_statements(body)
                    Stmt.Match(scrutinee, arms, _):
                        return true if submit_group_early_exit_expression(scrutinee)
                        for arm in arms:
                            return true if submit_group_early_exit_expression(arm.guard) or submit_group_early_exit_statements(arm.body)
                    Stmt.Contract(_, expression, _):
                        return true if submit_group_early_exit_expression(expression)
                    Stmt.Invalid:
                        return true
                    _:
                        return true
            return false


        def submit_group_early_exit_range(statements: darray[Stmt]&, first: usize, stop: usize) -> bool can[Abort.Panic]:
            return false if first > stop or stop > statements.count
            for row in first..<stop:
                single_statement: darray[Stmt] = [statements[row]]
                return true if submit_group_early_exit_statements(single_statement)
            return false


        def submit_group_scan_memo_hash(first: uintptr, count: usize) -> usize:
            h: mutable u64 = first.u64() ^ (count.u64() * 0x9e3779b97f4a7c15)
            h <- (h ^ (h >> 30)) * 0xbf58476d1ce4e5b9
            h <- (h ^ (h >> 27)) * 0x94d049bb133111eb
            h <- h ^ (h >> 31)
            return h.usize()


        def submit_group_scan_memo_probe(entries: darray[SubmitListMemoEntry]&, first: uintptr, count: usize) -> usize can[Abort.Panic]:
            assert entries.count > 0.usize() and (entries.count & (entries.count - 1.usize())) == 0.usize()
            mask: usize = entries.count - 1.usize()
            slot: mutable usize = submit_group_scan_memo_hash(first, count) & mask
            probed: mutable usize = 0
            trusted Unsafe.AssumeProgress:
                while probed < entries.count:
                    return slot if entries[slot].first == 0.uintptr() or (entries[slot].first == first and entries[slot].count == count)
                    slot <- (slot + 1.usize()) & mask
                    probed <- probed + 1.usize()
            panic("submit scan memo table exhausted")


        def submit_group_scan_memo_grow(local_scope: mutable Scope&) -> void can[Abort.Panic, Memory.Allocate]:
            old_entries: darray[SubmitListMemoEntry] = local_scope.submit_scan_memo
            new_capacity: mutable usize = 8.usize()
            if old_entries.count > 0.usize():
                new_capacity <- old_entries.count * 2.usize()
                assert new_capacity > old_entries.count
            new_entries: mutable darray[SubmitListMemoEntry] = []
            new_entries.resize(new_capacity)
            for row in 0..<old_entries.count:
                entry: SubmitListMemoEntry = old_entries[row]
                if entry.first != 0.uintptr():
                    slot: usize = submit_group_scan_memo_probe(new_entries, entry.first, entry.count)
                    new_entries[slot] <- entry
            local_scope.submit_scan_memo <- new_entries


        def submit_group_scan_memo_lookup(local_scope: mutable Scope&, first: uintptr, count: usize, found: mutable bool&) -> bool can[Abort.Panic]:
            found <- false
            entries: darray[SubmitListMemoEntry] = local_scope.submit_scan_memo
            return false if entries.count == 0.usize()
            slot: usize = submit_group_scan_memo_probe(entries, first, count)
            return false if entries[slot].first == 0.uintptr()
            assert entries[slot].first == first and entries[slot].count == count
            found <- true
            return entries[slot].has_submit


        def submit_group_scan_memo_store(local_scope: mutable Scope&, first: uintptr, count: usize, has_submit: bool) -> void can[Abort.Panic, Memory.Allocate]:
            if local_scope.submit_scan_memo.count == 0.usize() or local_scope.submit_scan_memo_used + 1.usize() >= local_scope.submit_scan_memo.count - local_scope.submit_scan_memo.count / 4.usize():
                submit_group_scan_memo_grow(local_scope)
            slot: usize = submit_group_scan_memo_probe(local_scope.submit_scan_memo, first, count)
            if local_scope.submit_scan_memo[slot].first == 0.uintptr():
                local_scope.submit_scan_memo_used <- local_scope.submit_scan_memo_used + 1.usize()
            else:
                assert local_scope.submit_scan_memo[slot].first == first and local_scope.submit_scan_memo[slot].count == count
            local_scope.submit_scan_memo[slot] <- SubmitListMemoEntry{first: first, count: count, has_submit: has_submit}


        def submit_group_expression_has_submit(expression: Expr, local_scope: mutable Scope&, structs: StructTable&) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            match expression:
                Expr.Block(statements, value, _, pos):
                    return true if submit_marker_at(pos.offset, structs)
                    return submit_group_expression_has_submit(value, local_scope, structs) or submit_group_statement_list_has_submit(statements, local_scope, structs)
                Expr.Call(callee, arguments, _, _):
                    return true if submit_group_expression_has_submit(callee, local_scope, structs)
                    for argument in arguments:
                        return true if submit_group_expression_has_submit(argument, local_scope, structs)
                    return false
                Expr.StaticEffectCall(arguments: arguments, _):
                    for argument in arguments:
                        return true if submit_group_expression_has_submit(argument, local_scope, structs)
                    return false
                Expr.Field(object, _, _) | Expr.Scope(object, _, _) | Expr.Unary(_, object, _) | Expr.Move(object, _) | Expr.RegionNew(object, _, _) | Expr.Paren(object, _):
                    return submit_group_expression_has_submit(object, local_scope, structs)
                Expr.Index(object, index, _) | Expr.Binary(object, _, index, _):
                    return submit_group_expression_has_submit(object, local_scope, structs) or submit_group_expression_has_submit(index, local_scope, structs)
                Expr.Slice(object, low, high, _):
                    return submit_group_expression_has_submit(object, local_scope, structs) or submit_group_expression_has_submit(low, local_scope, structs) or submit_group_expression_has_submit(high, local_scope, structs)
                Expr.IndexN(object, indices, _):
                    return true if submit_group_expression_has_submit(object, local_scope, structs)
                    for index in indices:
                        return true if submit_group_expression_has_submit(index, local_scope, structs)
                    return false
                Expr.Array(elements, _) | Expr.Tuple(elements, _) | Expr.SetLit(elements, _):
                    for element in elements:
                        return true if submit_group_expression_has_submit(element, local_scope, structs)
                    return false
                Expr.DictLit(entries, _):
                    for entry in entries:
                        return true if submit_group_expression_has_submit(entry.key, local_scope, structs) or submit_group_expression_has_submit(entry.value, local_scope, structs)
                    return false
                Expr.Construct(_, fields, _):
                    for field in fields:
                        return true if submit_group_expression_has_submit(field.value, local_scope, structs)
                    return false
                Expr.RecordUpdate(base, fields, _):
                    return true if submit_group_expression_has_submit(base, local_scope, structs)
                    for field in fields:
                        return true if submit_group_expression_has_submit(field.value, local_scope, structs)
                    return false
                Expr.If(condition, then_expression, else_expression, _):
                    return submit_group_expression_has_submit(condition, local_scope, structs) or submit_group_expression_has_submit(then_expression, local_scope, structs) or submit_group_expression_has_submit(else_expression, local_scope, structs)
                Expr.Match(scrutinee, arms, _) | Expr.Catch(scrutinee, arms, _):
                    return true if submit_group_expression_has_submit(scrutinee, local_scope, structs)
                    for arm in arms:
                        return true if:
                            submit_group_expression_has_submit(arm.guard, local_scope, structs)
                            submit_group_statement_list_has_submit(arm.body, local_scope, structs)
                    return false
                Expr.Comprehension(iterable: iterable, condition: condition, body: body, _):
                    return submit_group_expression_has_submit(iterable, local_scope, structs) or submit_group_expression_has_submit(condition, local_scope, structs) or submit_group_expression_has_submit(body, local_scope, structs)
                Expr.Refinement(base, predicate, _):
                    return submit_group_expression_has_submit(base, local_scope, structs) or submit_group_expression_has_submit(predicate, local_scope, structs)
                Expr.GetElse(guarded, recovery, _):
                    return submit_group_expression_has_submit(guarded, local_scope, structs) or submit_group_statement_list_has_submit(recovery, local_scope, structs)
                Expr.Lambda(_, _, _):
                    return true
                Expr.Invalid | Expr.Absent | Expr.IntLit(_, _) | Expr.FloatLit(_, _) | Expr.StringLit(_, _) | Expr.CharLit(_, _) | Expr.BoolLit(_, _) | Expr.Ident(_, _) | Expr.ShorthandMember(_, _):
                    return false
                _:
                    return true


        def submit_group_statement_has_submit(statement: Stmt, local_scope: mutable Scope&, structs: StructTable&) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            match statement:
                Stmt.Expr(Expr.Block(statements, value, _, pos), _):
                    return true if submit_marker_at(pos.offset, structs)
                    return submit_group_expression_has_submit(value, local_scope, structs) or submit_group_statement_list_has_submit(statements, local_scope, structs)
                Stmt.Expr(expression, _) | Stmt.Contract(_, expression, _):
                    return submit_group_expression_has_submit(expression, local_scope, structs)
                Stmt.VarDecl(value: value, _):
                    return submit_group_expression_has_submit(value, local_scope, structs)
                Stmt.Return(value, _):
                    if value is return_value:
                        return submit_group_expression_has_submit(return_value, local_scope, structs)
                    return false
                Stmt.Assign(target, _, value, _):
                    return submit_group_expression_has_submit(target, local_scope, structs) or submit_group_expression_has_submit(value, local_scope, structs)
                Stmt.If(condition, then_body, else_body, _):
                    return true if:
                        submit_group_expression_has_submit(condition, local_scope, structs)
                        submit_group_statement_list_has_submit(then_body, local_scope, structs)
                    return submit_group_statement_list_has_submit(else_body, local_scope, structs)
                Stmt.While(condition, body, _) | Stmt.For(_, _, condition, body, _):
                    return submit_group_expression_has_submit(condition, local_scope, structs) or submit_group_statement_list_has_submit(body, local_scope, structs)
                Stmt.Block(body: body, _):
                    return submit_group_statement_list_has_submit(body, local_scope, structs)
                Stmt.Match(scrutinee, arms, _):
                    return true if submit_group_expression_has_submit(scrutinee, local_scope, structs)
                    for arm in arms:
                        return true if submit_group_expression_has_submit(arm.guard, local_scope, structs) or submit_group_statement_list_has_submit(arm.body, local_scope, structs)
                    return false
                Stmt.Invalid:
                    return true
                _:
                    return true


        def submit_group_statement_list_has_submit(statements: darray[Stmt]&, local_scope: mutable Scope&, structs: StructTable&) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            return false if statements.count == 0.usize()
            first: uintptr = (&statements[0]).cast[uintptr] can Unsafe.PointerCast
            cached: mutable bool = false
            cached_value: bool = submit_group_scan_memo_lookup(local_scope, first, statements.count, cached)
            return cached_value if cached
            nested_list: bool = local_scope.submit_scan_depth > 0.usize()
            local_scope.submit_scan_depth <- local_scope.submit_scan_depth + 1.usize()
            has_submit: mutable bool = false
            for statement in statements:
                if submit_group_statement_has_submit(statement, local_scope, structs):
                    has_submit <- true
                    break
            local_scope.submit_scan_depth <- local_scope.submit_scan_depth - 1.usize()
            # A flat one-list function needs no memo allocation. A nested list is likely to be
            # queried again by its own emitter; once any nested entry exists, retain its parent
            # result too so repeated parent checks also become constant-time.
            submit_group_scan_memo_store(local_scope, first, statements.count, has_submit) if nested_list or local_scope.submit_scan_memo_used > 0.usize()
            return has_submit


        def submit_group_submit_sites_are_bare(statement: Stmt, group_name: sview, local_scope: mutable Scope&, structs: StructTable&, fns: FnTable&, generics: GenericTable&, found: mutable bool&) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            match statement:
                Stmt.Expr(Expr.Block(statements, value, _, pos), _):
                    if submit_marker_at(pos.offset, structs):
                        return false if:
                            statements.count != 0
                            not (value is Expr.Call(_, _, _, _))
                            submit_group_expression_has_submit(value, local_scope, structs)
                        found <- true
                        return true
                    return false if not submit_group_submit_site_list_is_bare(statements, group_name, local_scope, structs, fns, generics, found)
                    return not submit_group_expression_has_submit(value, local_scope, structs)
                Stmt.Expr(expression, _):
                    return not submit_group_expression_has_submit(expression, local_scope, structs)
                Stmt.VarDecl(value: value, _):
                    return not submit_group_expression_has_submit(value, local_scope, structs)
                Stmt.Return(value, _):
                    if value is return_value:
                        return not submit_group_expression_has_submit(return_value, local_scope, structs)
                    return true
                Stmt.Assign(target, _, value, _):
                    return not (submit_group_expression_has_submit(target, local_scope, structs) or submit_group_expression_has_submit(value, local_scope, structs))
                Stmt.If(condition, then_body, else_body, _):
                    return false if:
                        submit_group_expression_has_submit(condition, local_scope, structs)
                        not submit_group_submit_site_list_is_bare(then_body, group_name, local_scope, structs, fns, generics, found)
                    return submit_group_submit_site_list_is_bare(else_body, group_name, local_scope, structs, fns, generics, found)
                Stmt.While(condition, body, _):
                    return false if submit_group_expression_has_submit(condition, local_scope, structs)
                    return submit_group_submit_site_list_is_bare(body, group_name, local_scope, structs, fns, generics, found)
                Stmt.For(iterable: iterable, body: body, _):
                    return false if submit_group_expression_has_submit(iterable, local_scope, structs)
                    return submit_group_submit_site_list_is_bare(body, group_name, local_scope, structs, fns, generics, found)
                Stmt.Block(body: body, _):
                    return submit_group_submit_site_list_is_bare(body, group_name, local_scope, structs, fns, generics, found)
                Stmt.Match(scrutinee, arms, _):
                    return false if submit_group_expression_has_submit(scrutinee, local_scope, structs)
                    for arm in arms:
                        return false if:
                            submit_group_expression_has_submit(arm.guard, local_scope, structs)
                            not submit_group_submit_site_list_is_bare(arm.body, group_name, local_scope, structs, fns, generics, found)
                    return true
                Stmt.Contract(_, expression, _):
                    return not submit_group_expression_has_submit(expression, local_scope, structs)
                Stmt.Invalid:
                    return false
                _:
                    return false


        def submit_group_submit_site_list_is_bare(statements: darray[Stmt], group_name: sview, local_scope: mutable Scope&, structs: StructTable&, fns: FnTable&, generics: GenericTable&, found: mutable bool&) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            row: mutable usize = 0
            while row < statements.count |row, statements, group_name, local_scope, structs, fns, generics, found|:
                if row + 1.usize() < statements.count and submit_group_submit_add_pair_matches(statements[row], statements[row + 1.usize()], group_name, local_scope, fns, structs, generics):
                    found <- true
                    row <- row + 2.usize()
                    continue
                return false if not submit_group_submit_sites_are_bare(statements[row], group_name, local_scope, structs, fns, generics, found)
                row <- row + 1.usize()
            return true


        def submit_group_submit_site_range_is_bare(statements: darray[Stmt]&, first: usize, stop: usize, group_name: sview, local_scope: mutable Scope&, structs: StructTable&, fns: FnTable&, generics: GenericTable&, found: mutable bool&) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            return false if first > stop or stop > statements.count
            row: mutable usize = first
            while row < stop |row, stop, statements, group_name, local_scope, structs, fns, generics, found|:
                if row + 1.usize() < stop and submit_group_submit_add_pair_matches(statements[row], statements[row + 1.usize()], group_name, local_scope, fns, structs, generics):
                    found <- true
                    row <- row + 2.usize()
                    continue
                return false if not submit_group_submit_sites_are_bare(statements[row], group_name, local_scope, structs, fns, generics, found)
                row <- row + 1.usize()
            return true


        # Pool cleanup groups only submits whose Task result is discarded. A submit in
        # value position stays caller-owned (for example, a local Task that is awaited
        # before the pool exits). Expression blocks and branch expressions need their
        # result context carried recursively; if a submit appears in a shape we cannot
        # classify, decline the pool lowering rather than emit an untracked completion.
        def submit_group_scan_discarded_expression(expression: Expr, result_is_discarded: bool, local_scope: mutable Scope&, structs: StructTable&, found: mutable bool&, uncertain: mutable bool&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            match expression:
                Expr.Block(statements, value, _, pos):
                    if submit_marker_at(pos.offset, structs):
                        if statements.count != 0.usize():
                            uncertain <- true
                            return
                        match value:
                            Expr.Call(callee, arguments, _, _):
                                found <- true if result_is_discarded
                                if submit_group_expression_has_submit(callee, local_scope, structs):
                                    uncertain <- true
                                    return
                                for argument in arguments |found, uncertain|:
                                    # The worker call can receive or retain an inner Task; its
                                    # completion is not consumed just because the outer result is
                                    # discarded. Reject nested submissions at this boundary.
                                    if submit_group_expression_has_submit(argument, local_scope, structs):
                                        uncertain <- true
                                        return
                            _:
                                uncertain <- true
                        return
                    submit_group_scan_discarded_statement_list(statements, local_scope, structs, found, uncertain)
                    submit_group_scan_discarded_expression(value, result_is_discarded, local_scope, structs, found, uncertain)
                Expr.Call(callee, arguments, _, _):
                    # An unknown call can retain, drop, or transfer a Task argument. The
                    # scanner cannot prove that a discarded call result also consumes its
                    # nested submission, so reject that shape. Even a same-spelled await
                    # callee is not trusted here: local shadowing is resolved by codegen,
                    # not by this pre-scan.
                    if submit_group_expression_has_submit(expression, local_scope, structs):
                        uncertain <- true
                    return
                Expr.StaticEffectCall(arguments: arguments, _):
                    if submit_group_expression_has_submit(expression, local_scope, structs):
                        uncertain <- true
                    return
                Expr.Field(object, _, _) | Expr.Scope(object, _, _) | Expr.Unary(_, object, _) | Expr.Move(object, _) | Expr.RegionNew(object, _, _) | Expr.Paren(object, _):
                    submit_group_scan_discarded_expression(object, result_is_discarded, local_scope, structs, found, uncertain)
                Expr.Index(object, index, _) | Expr.Binary(object, _, index, _):
                    if submit_group_expression_has_submit(expression, local_scope, structs):
                        uncertain <- true
                        return
                Expr.Slice(object, low, high, _):
                    if submit_group_expression_has_submit(expression, local_scope, structs):
                        uncertain <- true
                        return
                Expr.IndexN(object, indices, _):
                    if submit_group_expression_has_submit(expression, local_scope, structs):
                        uncertain <- true
                        return
                Expr.Array(elements, _) | Expr.Tuple(elements, _) | Expr.SetLit(elements, _):
                    if submit_group_expression_has_submit(expression, local_scope, structs):
                        uncertain <- true
                        return
                Expr.DictLit(entries, _):
                    if submit_group_expression_has_submit(expression, local_scope, structs):
                        uncertain <- true
                        return
                Expr.Construct(_, fields, _):
                    if submit_group_expression_has_submit(expression, local_scope, structs):
                        uncertain <- true
                        return
                Expr.RecordUpdate(base, fields, _):
                    if submit_group_expression_has_submit(expression, local_scope, structs):
                        uncertain <- true
                        return
                Expr.If(condition, then_expression, else_expression, _):
                    submit_group_scan_discarded_expression(condition, false, local_scope, structs, found, uncertain)
                    submit_group_scan_discarded_expression(then_expression, result_is_discarded, local_scope, structs, found, uncertain)
                    submit_group_scan_discarded_expression(else_expression, result_is_discarded, local_scope, structs, found, uncertain)
                Expr.Match(scrutinee, arms, _) | Expr.Catch(scrutinee, arms, _):
                    submit_group_scan_discarded_expression(scrutinee, false, local_scope, structs, found, uncertain)
                    for arm in arms |found, uncertain|:
                        submit_group_scan_discarded_expression(arm.guard, false, local_scope, structs, found, uncertain)
                        if arm_value_expression(arm.body) is arm_value:
                            submit_group_scan_discarded_expression(arm_value, result_is_discarded, local_scope, structs, found, uncertain)
                        elif submit_group_statement_list_has_submit(arm.body, local_scope, structs):
                            # A multi-statement value arm can mix prefix effects with a
                            # yielded value. Do not guess which submit result is discarded.
                            uncertain <- true
                Expr.Comprehension(iterable: iterable, condition: condition, body: body, _):
                    if submit_group_expression_has_submit(expression, local_scope, structs):
                        uncertain <- true
                        return
                Expr.Refinement(base, predicate, _):
                    if submit_group_expression_has_submit(expression, local_scope, structs):
                        uncertain <- true
                        return
                Expr.GetElse(guarded, recovery, _):
                    if submit_group_expression_has_submit(expression, local_scope, structs):
                        uncertain <- true
                        return
                Expr.Lambda(_, body, _):
                    uncertain <- true if submit_group_statement_list_has_submit(body, local_scope, structs)
                Expr.Invalid | Expr.Absent | Expr.IntLit(_, _) | Expr.FloatLit(_, _) | Expr.StringLit(_, _) | Expr.CharLit(_, _) | Expr.BoolLit(_, _) | Expr.Ident(_, _) | Expr.ShorthandMember(_, _):
                    pass
                _:
                    uncertain <- true if submit_group_expression_has_submit(expression, local_scope, structs)


        # `_ <- value` discards the value; any other target keeps it.
        def submit_group_target_is_discard(target: Expr) -> bool:
            match target:
                Expr.Ident(target_name, _):
                    return target_name == "_"
                _:
                    return false

        def submit_group_scan_discarded_statement(statement: Stmt, local_scope: mutable Scope&, structs: StructTable&, found: mutable bool&, uncertain: mutable bool&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            match statement:
                Stmt.Expr(expression, _):
                    submit_group_scan_discarded_expression(expression, true, local_scope, structs, found, uncertain)
                Stmt.VarDecl(name, _, value, _):
                    submit_group_scan_discarded_expression(value, name == "_", local_scope, structs, found, uncertain)
                Stmt.Assign(target, _, value, _):
                    submit_group_scan_discarded_expression(target, false, local_scope, structs, found, uncertain)
                    submit_group_scan_discarded_expression(value, submit_group_target_is_discard(target), local_scope, structs, found, uncertain)
                Stmt.Return(value, _):
                    if value is returned_value:
                        submit_group_scan_discarded_expression(returned_value, false, local_scope, structs, found, uncertain)
                Stmt.If(condition, then_body, else_body, _):
                    submit_group_scan_discarded_expression(condition, false, local_scope, structs, found, uncertain)
                    submit_group_scan_discarded_statement_list(then_body, local_scope, structs, found, uncertain)
                    submit_group_scan_discarded_statement_list(else_body, local_scope, structs, found, uncertain)
                Stmt.While(condition, body, _):
                    submit_group_scan_discarded_expression(condition, false, local_scope, structs, found, uncertain)
                    submit_group_scan_discarded_statement_list(body, local_scope, structs, found, uncertain)
                Stmt.For(iterable: iterable, body: body, _):
                    submit_group_scan_discarded_expression(iterable, false, local_scope, structs, found, uncertain)
                    submit_group_scan_discarded_statement_list(body, local_scope, structs, found, uncertain)
                Stmt.Block(body: body, _):
                    submit_group_scan_discarded_statement_list(body, local_scope, structs, found, uncertain)
                Stmt.Match(scrutinee, arms, _):
                    submit_group_scan_discarded_expression(scrutinee, false, local_scope, structs, found, uncertain)
                    for arm in arms |found, uncertain|:
                        submit_group_scan_discarded_expression(arm.guard, false, local_scope, structs, found, uncertain)
                        submit_group_scan_discarded_statement_list(arm.body, local_scope, structs, found, uncertain)
                Stmt.Contract(_, expression, _):
                    uncertain <- true if submit_group_expression_has_submit(expression, local_scope, structs)
                    submit_group_scan_discarded_expression(expression, false, local_scope, structs, found, uncertain)
                Stmt.Invalid:
                    uncertain <- true
                Stmt.Break(_, _) | Stmt.Continue(_, _):
                    pass
                _:
                    uncertain <- true if submit_group_statement_has_submit(statement, local_scope, structs)


        def submit_group_scan_discarded_statement_list(statements: darray[Stmt]&, local_scope: mutable Scope&, structs: StructTable&, found: mutable bool&, uncertain: mutable bool&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            for statement in statements |found, uncertain|:
                submit_group_scan_discarded_statement(statement, local_scope, structs, found, uncertain)


        def submit_group_statement_list_has_discarded_submit(statements: darray[Stmt]&, local_scope: mutable Scope&, structs: StructTable&, uncertain: mutable bool&) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            found: mutable bool = false
            submit_group_scan_discarded_statement_list(statements, local_scope, structs, found, uncertain)
            return found


        def submit_group_window(body: darray[Stmt]&, local_scope: mutable Scope&, structs: mutable StructTable&, fns: FnTable&, generics: GenericTable&) -> SubmitGroupWindow can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Global{Read,Write}]:
            can Global{Read,Write}:
                window: mutable SubmitGroupWindow = submit_group_empty_window()
                return window if body.count < 3.usize() or structs.annotations.submit_offsets.count == 0.usize()
                declaration_count: mutable usize = 0
                for row in 0..<body.count:
                    candidate_name: sview = submit_group_constructor_name(body[row], local_scope, fns, structs, generics)
                    if candidate_name != "":
                        declaration_count <- declaration_count + 1.usize()
                        window.group_name <- candidate_name
                        window.declaration_row <- row
                return submit_group_empty_window() if declaration_count != 1.usize()
                join_count: mutable usize = 0
                for row in window.declaration_row + 1.usize()..<body.count:
                    if submit_group_wait_matches(body[row], window.group_name, local_scope, fns, structs, generics):
                        join_count <- join_count + 1.usize()
                        window.join_row <- row
                return submit_group_empty_window() if:
                    join_count != 1.usize()
                    window.group_name == "task_group_new" or window.group_name == "task_group_add" or window.group_name == "task_group_wait_all"
                    submit_group_api_is_shadowed(local_scope)
                    submit_group_early_exit_range(body, window.declaration_row + 1.usize(), window.join_row)
                    submit_group_range_mentions_name(body, window.declaration_row + 1.usize(), window.join_row, window.group_name)
                # The declaration scan starts at the statement-list head, not after the group
                # constructor: a same-scope function value bound before this lexical window can
                # shadow the constructor, add, or wait call when those rows are emitted.
                return submit_group_empty_window() if:
                    submit_group_range_declares_api_binding(body, 0.usize(), window.join_row)
                    (submit_group_range_has_untrusted_call(body, window.declaration_row + 1.usize(), window.join_row, window.group_name, local_scope, structs, fns, generics) can Global{Read,Write})
                has_submit: mutable bool = false
                return submit_group_empty_window() if:
                    not submit_group_submit_site_range_is_bare(body, window.declaration_row + 1.usize(), window.join_row, window.group_name, local_scope, structs, fns, generics, has_submit)
                    not has_submit
                    not submit_group_runtime_apis_are_unique(fns, generics, structs)
                window.valid <- true
                return window


        def submit_group_range_mentions_name(statements: darray[Stmt]&, first: usize, stop: usize, name: sview) -> bool can[Abort.Panic]:
            return true if first > stop or stop > statements.count
            names: SubmitGroupNameSet = SubmitGroupNameSet{first: name, second: "", third: "", fail_closed_nested_scopes: false}
            for row in first..<stop:
                return true if submit_group_statement_mentions_names(statements[row], names, true)
            return false
