extend Backend:
    private:
        # Range-binder liveness runs once for each emitted loop. Descending into nested
        # statement lists would rescan their whole subtrees for every enclosing binder, so
        # treat any nonempty nested body as a possible use instead. This bounds repeated
        # analysis while preserving correctness: uncertain binders keep their stack slot.
        def submit_group_range_binder_may_be_mentioned(statements: darray[Stmt]&, first: usize, stop: usize, name: sview) -> bool can[Abort.Panic]:
            return true if first > stop or stop > statements.count
            names: SubmitGroupNameSet = SubmitGroupNameSet{first: name, second: "", third: "", fail_closed_nested_scopes: true}
            for row in first..<stop:
                return true if submit_group_statement_mentions_names(statements[row], names, false)
            return false


        def submit_group_binding_is_task_group(name: sview, local_scope: mutable Scope&, structs: StructTable&) -> bool can[Abort.Panic]:
            value_type: ValueType = lookup_type(local_scope, name)
            return value_type.kind == TypeKind.Struct and value_type.bits.usize() < structs.records.names.count and structs.records.names[value_type.bits.usize()] == "TaskGroup"


        def submit_group_api_is_shadowed(local_scope: mutable Scope&) -> bool can[Abort.Panic]:
            return true if:
                lookup_slot(local_scope, "task_group_new") is constructor_shadow
                lookup_slot(local_scope, "task_group_add") is add_shadow
                lookup_slot(local_scope, "task_group_wait_all") is wait_shadow
            return false


        # A declaration in the same statement list can shadow an API anywhere in the
        # candidate window, including before the constructor. Child statement lists are
        # checked when they are emitted; this scan covers bindings whose scope reaches the join.
        def submit_group_target_binds_api_name(target: Expr) -> bool can[Abort.Panic]:
            match target:
                Expr.Ident(name, _):
                    return name == "task_group_new" or name == "task_group_add" or name == "task_group_wait_all"
                Expr.Tuple(elements, _) | Expr.Array(elements, _):
                    for element in elements:
                        return true if submit_group_target_binds_api_name(element)
                    return false
                Expr.Paren(inner, _):
                    return submit_group_target_binds_api_name(inner)
                _:
                    return false


        def submit_group_range_declares_api_binding(statements: darray[Stmt]&, first: usize, stop: usize) -> bool can[Abort.Panic]:
            return true if first > stop or stop > statements.count
            for row in first..<stop:
                match statements[row]:
                    Stmt.VarDecl(name: name, _):
                        return true if name == "task_group_new" or name == "task_group_add" or name == "task_group_wait_all"
                    Stmt.Assign(target: target, _):
                        return true if submit_group_target_binds_api_name(target)
                    _:
                        pass
            return false


        def submit_group_statement_list_mentions_manual_api(statements: darray[Stmt]&) -> bool can[Abort.Panic]:
            manual_api_names: SubmitGroupNameSet = submit_group_manual_api_name_set()
            # Nested statement lists have their own emit_statements_value proof. Inspect this
            # list's direct expressions and conditions, but leave child bodies to that proof.
            return submit_group_statement_list_mentions_names(statements, manual_api_names, false)


        # Calls to arbitrary helpers can hide an inner TaskGroup constructor or wait behind
        # a wrapper. The source-level proof only understands the reserved constructor/wait
        # identities and the compiler-marked submit blocks; decline other call shapes in a
        # group interval instead of treating lexical spelling as a proof of the join.
        def submit_group_expression_has_untrusted_call(expression: Expr, local_scope: mutable Scope&, structs: StructTable&, fns: FnTable&, generics: GenericTable&) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Global{Read,Write}]:
            can Global{Read,Write}:
                match expression:
                    Expr.Call(callee, arguments, _, _):
                        trusted_call: bool = submit_group_api_callee_matches(callee, "task_group_new", local_scope, fns, structs, generics) or submit_group_api_callee_matches(callee, "task_group_wait_all", local_scope, fns, structs, generics) or (submit_group_call_is_trusted_atomic(callee, arguments.count, local_scope, fns, generics) can Global{Read,Write})
                        if trusted_call:
                            for argument in arguments:
                                return true if submit_group_expression_has_untrusted_call(argument, local_scope, structs, fns, generics)
                            return false
                        return true
                    Expr.StaticEffectCall(_, _, _, _, _, _):
                        return true
                    Expr.Block(statements, value, _, pos):
                        if submit_marker_at(pos.offset, structs):
                            return false if statements.count != 0.usize()
                            match value:
                                Expr.Call(callee, arguments, _, _):
                                    return true if submit_group_expression_has_untrusted_call(callee, local_scope, structs, fns, generics)
                                    for argument in arguments:
                                        return true if submit_group_expression_has_untrusted_call(argument, local_scope, structs, fns, generics)
                                    return false
                                _:
                                    return true
                        return true if submit_group_statement_list_has_untrusted_call(statements, local_scope, structs, fns, generics)
                        return submit_group_expression_has_untrusted_call(value, local_scope, structs, fns, generics)
                    Expr.Field(object, _, _) | Expr.Scope(object, _, _) | Expr.Unary(_, object, _) | Expr.Move(object, _) | Expr.RegionNew(object, _, _) | Expr.Paren(object, _):
                        return submit_group_expression_has_untrusted_call(object, local_scope, structs, fns, generics)
                    Expr.Index(object, index, _) | Expr.Binary(object, _, index, _):
                        return submit_group_expression_has_untrusted_call(object, local_scope, structs, fns, generics) or submit_group_expression_has_untrusted_call(index, local_scope, structs, fns, generics)
                    Expr.Slice(object, low, high, _):
                        return submit_group_expression_has_untrusted_call(object, local_scope, structs, fns, generics) or submit_group_expression_has_untrusted_call(low, local_scope, structs, fns, generics) or submit_group_expression_has_untrusted_call(high, local_scope, structs, fns, generics)
                    Expr.IndexN(object, indices, _):
                        return true if submit_group_expression_has_untrusted_call(object, local_scope, structs, fns, generics)
                        for index in indices:
                            return true if submit_group_expression_has_untrusted_call(index, local_scope, structs, fns, generics)
                        return false
                    Expr.Array(elements, _) | Expr.Tuple(elements, _) | Expr.SetLit(elements, _):
                        for element in elements:
                            return true if submit_group_expression_has_untrusted_call(element, local_scope, structs, fns, generics)
                        return false
                    Expr.DictLit(entries, _):
                        for entry in entries:
                            return true if submit_group_expression_has_untrusted_call(entry.key, local_scope, structs, fns, generics) or submit_group_expression_has_untrusted_call(entry.value, local_scope, structs, fns, generics)
                        return false
                    Expr.Construct(type_expression, fields, _):
                        return true if submit_group_expression_has_untrusted_call(type_expression, local_scope, structs, fns, generics)
                        for field in fields:
                            return true if submit_group_expression_has_untrusted_call(field.value, local_scope, structs, fns, generics)
                        return false
                    Expr.RecordUpdate(base, fields, _):
                        return true if submit_group_expression_has_untrusted_call(base, local_scope, structs, fns, generics)
                        for field in fields:
                            return true if submit_group_expression_has_untrusted_call(field.value, local_scope, structs, fns, generics)
                        return false
                    Expr.If(condition, then_expression, else_expression, _):
                        return submit_group_expression_has_untrusted_call(condition, local_scope, structs, fns, generics) or submit_group_expression_has_untrusted_call(then_expression, local_scope, structs, fns, generics) or submit_group_expression_has_untrusted_call(else_expression, local_scope, structs, fns, generics)
                    Expr.Match(scrutinee, arms, _) | Expr.Catch(scrutinee, arms, _):
                        return true if submit_group_expression_has_untrusted_call(scrutinee, local_scope, structs, fns, generics)
                        for arm in arms:
                            return true if:
                                submit_group_pattern_mentions_manual_api(arm.pattern)
                                submit_group_expression_has_untrusted_call(arm.guard, local_scope, structs, fns, generics)
                                submit_group_statement_list_has_untrusted_call(arm.body, local_scope, structs, fns, generics)
                        return false
                    Expr.Comprehension(variable, iterable, condition, body, _, _):
                        return true if variable == "task_group_new" or variable == "task_group_add" or variable == "task_group_wait_all"
                        return submit_group_expression_has_untrusted_call(iterable, local_scope, structs, fns, generics) or submit_group_expression_has_untrusted_call(condition, local_scope, structs, fns, generics) or submit_group_expression_has_untrusted_call(body, local_scope, structs, fns, generics)
                    Expr.Refinement(base, predicate, _):
                        return submit_group_expression_has_untrusted_call(base, local_scope, structs, fns, generics) or submit_group_expression_has_untrusted_call(predicate, local_scope, structs, fns, generics)
                    Expr.GetElse(guarded, recovery, _):
                        return true if submit_group_expression_has_untrusted_call(guarded, local_scope, structs, fns, generics)
                        return submit_group_statement_list_has_untrusted_call(recovery, local_scope, structs, fns, generics)
                    Expr.Lambda(_, _, _) | Expr.Invalid | Expr.Absent | Expr.IntLit(_, _) | Expr.FloatLit(_, _) | Expr.StringLit(_, _) | Expr.CharLit(_, _) | Expr.BoolLit(_, _) | Expr.Ident(_, _) | Expr.ShorthandMember(_, _):
                        return false
                    _:
                        return true


        def submit_group_statement_has_untrusted_call(statement: Stmt, group_name: sview, local_scope: mutable Scope&, structs: StructTable&, fns: FnTable&, generics: GenericTable&) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Global{Read,Write}]:
            can Global{Read,Write}:
                match statement:
                    Stmt.Expr(expression, _) | Stmt.Contract(_, expression, _):
                        return submit_group_expression_has_untrusted_call(expression, local_scope, structs, fns, generics)
                    Stmt.VarDecl(name, type_expression, value, _):
                        return true if name == "task_group_new" or name == "task_group_add" or name == "task_group_wait_all"
                        return submit_group_expression_has_untrusted_call(type_expression, local_scope, structs, fns, generics) or submit_group_expression_has_untrusted_call(value, local_scope, structs, fns, generics)
                    Stmt.Assign(target, _, value, _):
                        return true if submit_group_target_binds_api_name(target)
                        return submit_group_expression_has_untrusted_call(target, local_scope, structs, fns, generics) or submit_group_expression_has_untrusted_call(value, local_scope, structs, fns, generics)
                    Stmt.If(condition, then_body, else_body, _):
                        return true if submit_group_expression_has_untrusted_call(condition, local_scope, structs, fns, generics)
                        return submit_group_statement_list_has_untrusted_call_paired(then_body, group_name, local_scope, structs, fns, generics) or submit_group_statement_list_has_untrusted_call_paired(else_body, group_name, local_scope, structs, fns, generics)
                    Stmt.While(condition, body, _):
                        return submit_group_expression_has_untrusted_call(condition, local_scope, structs, fns, generics) or submit_group_statement_list_has_untrusted_call_paired(body, group_name, local_scope, structs, fns, generics)
                    Stmt.For(_, variables, iterable, body, _):
                        return true if submit_group_name_in_names("task_group_new", variables) or submit_group_name_in_names("task_group_add", variables) or submit_group_name_in_names("task_group_wait_all", variables)
                        return submit_group_expression_has_untrusted_call(iterable, local_scope, structs, fns, generics) or submit_group_statement_list_has_untrusted_call_paired(body, group_name, local_scope, structs, fns, generics)
                    Stmt.Block(binding: binding, body: body, _):
                        return true if binding == "task_group_new" or binding == "task_group_add" or binding == "task_group_wait_all"
                        return submit_group_statement_list_has_untrusted_call_paired(body, group_name, local_scope, structs, fns, generics)
                    Stmt.Match(scrutinee, arms, _):
                        return true if submit_group_expression_has_untrusted_call(scrutinee, local_scope, structs, fns, generics)
                        for arm in arms:
                            return true if:
                                submit_group_pattern_mentions_manual_api(arm.pattern)
                                submit_group_expression_has_untrusted_call(arm.guard, local_scope, structs, fns, generics)
                                submit_group_statement_list_has_untrusted_call_paired(arm.body, group_name, local_scope, structs, fns, generics)
                        return false
                    Stmt.Return(value, _):
                        if value is returned_value:
                            return submit_group_expression_has_untrusted_call(returned_value, local_scope, structs, fns, generics)
                        return false
                    Stmt.Invalid:
                        return true
                    Stmt.Break(_, _) | Stmt.Continue(_, _):
                        return false
                    _:
                        return true


        def submit_group_statement_list_has_untrusted_call(statements: darray[Stmt], local_scope: mutable Scope&, structs: StructTable&, fns: FnTable&, generics: GenericTable&) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Global{Read,Write}]:
            can Global{Read,Write}:
                for statement in statements:
                    return true if submit_group_statement_has_untrusted_call(statement, "", local_scope, structs, fns, generics)
                return false


        def submit_group_statement_list_has_untrusted_call_paired(statements: darray[Stmt]&, group_name: sview, local_scope: mutable Scope&, structs: StructTable&, fns: FnTable&, generics: GenericTable&) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Global{Read,Write}]:
            can Global{Read,Write}:
                row: mutable usize = 0
                while row < statements.count |row, statements, group_name, local_scope, structs, fns, generics|:
                    if row + 1.usize() < statements.count and submit_group_submit_add_pair_matches(statements[row], statements[row + 1.usize()], group_name, local_scope, fns, structs, generics):
                        return true if submit_group_statement_has_untrusted_call(statements[row], group_name, local_scope, structs, fns, generics)
                        row <- row + 2.usize()
                        continue
                    return true if submit_group_statement_has_untrusted_call(statements[row], group_name, local_scope, structs, fns, generics)
                    row <- row + 1.usize()
                return false


        def submit_group_range_has_untrusted_call(statements: darray[Stmt]&, first: usize, stop: usize, group_name: sview, local_scope: mutable Scope&, structs: StructTable&, fns: FnTable&, generics: GenericTable&) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Global{Read,Write}]:
            can Global{Read,Write}:
                return true if first > stop or stop > statements.count
                row: mutable usize = first
                while row < stop |row, stop, statements, group_name, local_scope, structs, fns, generics|:
                    if row + 1.usize() < stop and submit_group_submit_add_pair_matches(statements[row], statements[row + 1.usize()], group_name, local_scope, fns, structs, generics):
                        return true if submit_group_statement_has_untrusted_call(statements[row], group_name, local_scope, structs, fns, generics)
                        row <- row + 2.usize()
                        continue
                    return true if submit_group_statement_has_untrusted_call(statements[row], group_name, local_scope, structs, fns, generics)
                    row <- row + 1.usize()
                return false


        def submit_group_statement_list_declares_task_group(statements: darray[Stmt]&, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&) -> bool can[Abort.Panic, Memory.Allocate]:
            for statement in statements:
                if statement is Stmt.VarDecl(_, _, value, _):
                    # These root AST forms have a result category that cannot be TaskGroup,
                    # so avoid recursively typing their operands just for this guard. Keep
                    # every uncertain form on the existing fail-closed inference path.
                    definitely_not_task_group: mutable bool = false
                    match value:
                        Expr.IntLit(_, _) | Expr.FloatLit(_, _) | Expr.StringLit(_, _) | Expr.CharLit(_, _) | Expr.BoolLit(_, _) | Expr.Slice(_, _, _, _):
                            definitely_not_task_group <- true
                        Expr.Unary(operator, _, _):
                            definitely_not_task_group <- operator == TokenKind.Not or operator == TokenKind.Ampersand
                        Expr.Binary(operator: operator, _):
                            definitely_not_task_group <- operator == TokenKind.Is or operator == TokenKind.In or int_predicate_of(operator) >= 0 or operator == TokenKind.And or operator == TokenKind.Or
                        Expr.RegionNew(_, region_name, _):
                            # Packed-store and other selectors forward their operand type;
                            # only Arena-backed `new` is known to produce a reference.
                            definitely_not_task_group <- lookup_type(local_scope, region_name).kind == TypeKind.Arena
                        _:
                            pass
                    if not definitely_not_task_group:
                        value_type: ValueType = expression_type(value, local_scope, fns, structs, generics)
                        return true if value_type.kind == TypeKind.Struct and value_type.bits.usize() < structs.records.names.count and structs.records.names[value_type.bits.usize()] == "TaskGroup"
            return false


        # Explicitly-instantiated generic submits do not yet validate labels against the
        # generic declaration's formal parameters. Keep that path positional-only. Monomorphic
        # workers use the same label-aware resolver as ordinary direct calls below.
        def submit_call_has_only_positional_arguments(argument_count: usize, argument_names: darray[sview]) -> bool can[Abort.Panic]:
            return false if argument_names.count != 0 and argument_names.count != argument_count
            for argument_name in argument_names:
                return false if argument_name != ""
            return true


        def submit_worker_row_has_pool_submit1_arity(index: i64, fns: FnTable&) -> bool can[Abort.Panic]:
            return false if index < 0 or index.usize() >= fns.param_count.count or index.usize() >= fns.is_variadic.count
            row: usize = index.usize()
            return fns.param_count[row] == 1.usize() and not fns.is_variadic[row]


        def submit_worker_index(name: sview, argument: Expr, argument_names: darray[sview]&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, local_scope: mutable Scope&) -> i64 can[Abort.Panic, Memory.Allocate]:
            return -1 if argument_names.count != 0 and argument_names.count != 1.usize()
            worker_arguments: mutable darray[Expr] = [argument]
            argument_name: sview = argument_names[0] if argument_names.count == 1.usize() else ""
            current_owner: sview = structs.visibility.current_owner
            # Match emit_call_named: a shape-compatible enclosing-module member shadows an
            # inferred generic and top-level declarations. The typed resolver chooses among
            # same-owner overloads; the shape fallback is only used when exactly one row can
            # accept the labels/defaults but the argument's type is contextual or convertible.
            if current_owner != "":
                worker_row: mutable i64 = overload_index_for_one_call_arg(fns, current_owner, name, argument, argument_name, local_scope, structs, generics)
                if worker_row >= 0:
                    return worker_row if submit_worker_row_has_pool_submit1_arity(worker_row, fns)
                    return -1
                # A typed match already proves the call shape. Scan shape separately only
                # on typed miss, where it preserves contextual fallback and owner shadowing.
                if function_has_call_shape(fns, current_owner, name, worker_arguments, argument_names):
                    worker_row <- function_index_of_unique_call_shape(fns, current_owner, name, worker_arguments, argument_names)
                    return worker_row if submit_worker_row_has_pool_submit1_arity(worker_row, fns)
                    return -1
            # An uninstantiated generic worker is not lowered by this dedicated submit path.
            # If ordinary call resolution would take that generic fallback, fail closed rather
            # than accidentally submitting a same-named monomorphic function.
            return -1 if generic_index_of(generics, name) >= 0 and not exact_overload_exists_for_call_args(fns, name, worker_arguments, argument_names, local_scope, structs, generics, 0)
            # Bare calls prefer a top-level declaration when one exists. Otherwise apply the
            # same unique-owner policy used by ordinary calls, including call-shape filtering
            # when several module owners define this name.
            if function_index_of(fns, "", name) >= 0:
                worker_row: mutable i64 = overload_index_for_one_call_arg(fns, "", name, argument, argument_name, local_scope, structs, generics)
                worker_row <- function_index_of_unique_call_shape(fns, "", name, worker_arguments, argument_names) if worker_row < 0
                return worker_row if submit_worker_row_has_pool_submit1_arity(worker_row, fns)
                return -1
            owner_row: i64 = function_index_for_unique_call_owner(fns, name, worker_arguments, argument_names)
            return -1 if owner_row < 0
            selected_owner: sview = fns.owners[owner_row.usize()]
            worker_row: mutable i64 = overload_index_for_one_call_arg(fns, selected_owner, name, argument, argument_name, local_scope, structs, generics)
            worker_row <- function_index_of_unique_call_shape(fns, selected_owner, name, worker_arguments, argument_names) if worker_row < 0
            return worker_row if submit_worker_row_has_pool_submit1_arity(worker_row, fns)
            return -1

        # True when this direct worker row requires the caller's packed store. This is
        # deliberately independent of whether this backend can capture its ABI: callers must
        # decline unsupported store-taking workers, never send them through pool_submit1 as if
        # they had an ordinary `fn(A) -> R` signature.
        def submit_worker_requires_store(index: i64, fns: FnTable&) -> bool can[Abort.Panic]:
            return false if index < 0 or index.usize() >= fns.needs_store.count
            row: usize = index.usize()
            return fns.needs_store[row]




        # A structured pool joins its work before its enclosing region is released. A nursery
        # group also joins an expression-statement task, including one sent to an explicit pool.
        # Regions opened after the chosen join owner are shorter-lived than that join and cannot
        # back a captured store. VarDecl submits are not group-added, so they need a pool owner.
        def submit_group_lifetime_is_scoped(local_scope: Scope&) -> bool can[Abort.Panic]:
            return false if local_scope.group_names.count == 0
            group_index: usize = local_scope.group_names.count - 1.usize()
            return false if group_index >= local_scope.group_region_frame_depths.count
            return local_scope.group_region_frame_depths[group_index] == local_scope.region_frame_starts.count


        def submit_group_has_manual_add_owner(local_scope: Scope&) -> bool can[Abort.Panic]:
            return false if local_scope.group_manual_add.count != local_scope.group_names.count or local_scope.group_names.count == 0.usize()
            return local_scope.group_manual_add[local_scope.group_names.count - 1.usize()]


        def submit_group_manual_add_lifetime_is_scoped(local_scope: Scope&) -> bool can[Abort.Panic]:
            return false if:
                local_scope.group_manual_add.count != local_scope.group_names.count
                local_scope.group_names.count == 0.usize()
            group_index: usize = local_scope.group_names.count - 1.usize()
            return false if not local_scope.group_manual_add[group_index] or group_index >= local_scope.group_region_frame_depths.count
            return local_scope.group_region_frame_depths[group_index] == local_scope.region_frame_starts.count


        def submit_store_capture_lifetime_is_scoped(pool: sview, will_group_add: bool, manual_group_add: bool, local_scope: mutable Scope&) -> bool can[Abort.Panic]:
            if manual_group_add:
                return will_group_add and submit_group_manual_add_lifetime_is_scoped(local_scope)
            if will_group_add:
                # When the task is retained by a group, that group's wait is the actual join
                # owner. Do not let a matching pool depth hide a shorter-lived group region.
                return submit_group_lifetime_is_scoped(local_scope)
            index: mutable i64 = local_scope.pool_names.count.i64() - 1
            while index >= 0 |index, pool, local_scope|:
                if local_scope.pool_names[index.usize()] == pool:
                    if lookup_slot(local_scope, pool) is selected_pool_slot:
                        if index.usize() < local_scope.pool_slots.count:
                            if local_scope.pool_slots[index.usize()] == selected_pool_slot:
                                if index.usize() < local_scope.pool_region_frame_depths.count:
                                    return local_scope.pool_region_frame_depths[index.usize()] == local_scope.region_frame_starts.count
                index <- index - 1
            return false




        # The ordinary callback path accepts only a truly plain `fn(A) -> R`. In particular,
        # arena, error, sret, and other hidden parameters cannot be inferred from an opaque LLVM
        # function pointer at the pool_submit1 call site.
        def submit_worker_is_plain(index: i64, argument_type: ValueType, return_type: ValueType, fns: FnTable&, structs: mutable StructTable&, ctx: LLVMContextRef) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            return false if index < 0 or index.usize() >= fns.needs_store.count
            row: usize = index.usize()
            return false if:
                fns.needs_store[row] or fns.arena_counts[row] != 0 or fns.is_error[row]
                fns.param_count[row] != 1 or fns.is_variadic[row] or fns.is_extern[row]
                value_type_uses_sret(return_type, structs, ctx)
            worker: LLVMValueRef = fns.handles[row]
            return false if LLVMCountParams(worker) != 1
            worker_type: LLVMTypeRef = LLVMGlobalGetValueType(worker)
            # An indirect aggregate (ParIndexArg: two usizes and an fn) is passed by
            # pointer, both by the worker's declaration and by the fn-value call inside
            # pool_submit1's entry -- the same rule emit_store_capturing_submit applies.
            expected_argument_llvm: LLVMTypeRef = LLVMPointerTypeInContext(ctx, 0) if value_type_uses_indirect_aggregate(argument_type, structs, ctx) else llvm_type_of(argument_type, structs, ctx)
            return false if LLVMTypeOf(LLVMGetParam(worker, 0)) != expected_argument_llvm
            return LLVMGetReturnType(worker_type) == llvm_type_of(return_type, structs, ctx)




        # Explicit generic callbacks are accepted only when the instantiated handle is
        # provably the plain one-argument ABI expected by pool_submit1. Unknown, overloaded,
        # store-taking, arena, error, sret, or body-known store users decline instead of
        # relying on opaque-pointer function types to make an invalid callback look compatible.
        def submit_generic_worker_is_plain(name: sview, type_args: darray[ValueType]&, argument_type: ValueType, return_type: ValueType, generics: mutable GenericTable&, structs: mutable StructTable&, m: LLVMModuleRef, ctx: LLVMContextRef) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            slot: i64 = generic_index_of(generics, name)
            return false if:
                slot < 0 or generic_slot_count(generics, name) != 1.usize()
                slot.usize() >= generics.is_error.count or generics.is_error[slot.usize()]
                value_type_uses_sret(return_type, structs, ctx)
            match generics.decls[slot.usize()]:
                Decl.Func(generic_name, generic_params, generic_return, generic_body, generic_effects, generic_decorators, generic_line):
                    return false if:
                        generic_params.count != 1
                        function_needs_ast_store(generics.owners[slot.usize()], generic_name, structs)
                        statements_mention_ast_store_call(generic_body, structs)
                        instantiation_wants_store_at(slot.usize(), type_args, generics)
                        instantiation_wants_arena_at(slot.usize(), type_args, generics, structs)
                _:
                    return false
            if instantiate_generic_at(slot.usize(), type_args, generics, structs, m, ctx) is target:
                return false if LLVMCountParams(target) != 1
                target_type: LLVMTypeRef = LLVMGlobalGetValueType(target)
                generic_argument_llvm: LLVMTypeRef = LLVMPointerTypeInContext(ctx, 0) if value_type_uses_indirect_aggregate(argument_type, structs, ctx) else llvm_type_of(argument_type, structs, ctx)
                return false if LLVMTypeOf(LLVMGetParam(target, 0)) != generic_argument_llvm
                return LLVMGetReturnType(target_type) == llvm_type_of(return_type, structs, ctx)
            return false




        def submit_thunk_symbol(ordinal: u64) -> darray[u8] can[Abort.Panic, Memory.Allocate]:
            symbol: mutable darray[u8] = []
            for prefix_index in 0..<("__submit_store_thunk_").len |symbol|:
                symbol.push(("__submit_store_thunk_")[prefix_index])
            remaining: mutable u64 = ordinal
            digits: mutable darray[u8] = []
            if remaining == 0.u64():
                digits.push(48)
            while remaining > 0.u64() |digits, remaining|:
                digits.push((48.u64() + remaining % 10.u64()).u8())
                remaining <- remaining / 10.u64()
            digit_index: mutable usize = digits.count
            while digit_index > 0.usize() |digit_index, symbol, digits|:
                digit_index <- digit_index - 1.usize()
                symbol.push(digits[digit_index])
            symbol.push(0)
            return symbol

        # Lower `submit worker(argument)` for a store-taking worker (see the file comment).
        # Returns the submitted Task value, or null to decline.
        def emit_store_capturing_submit(worker_index: i64, submit_pool: sview @source, argument: Expr, argument_type: ValueType, return_type: ValueType, line: Ast::Pos, local_scope: mutable Scope&, will_group_add: bool, manual_group_add: bool, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            return null if:
                not submit_worker_requires_store(worker_index, fns) or runtime.active_store_enum < 0
                backend_expression_may_contain_pool_lifetime_handle(argument, argument_type, local_scope, fns, structs, generics)
                not submit_store_capture_lifetime_is_scoped(submit_pool, will_group_add, manual_group_add, local_scope)
            worker_row: usize = worker_index.usize()
            return null if worker_row >= fns.arena_counts.count or worker_row >= fns.is_error.count or worker_row >= fns.param_count.count or worker_row >= fns.is_variadic.count or worker_row >= fns.is_extern.count
            worker_arena_count: usize = fns.arena_counts[worker_row]
            # Hidden arena slots are caller-owned. For a reference parameter, its slot can
            # own the backing that a worker grows and publishes through the captured value.
            # This thunk has no proof for that owner yet, so never substitute a fresh arena
            # that would be freed as soon as the task returns.
            return null if:
                worker_arena_count != 0.usize() or fns.is_error[worker_row]
                fns.param_count[worker_row] != 1 or fns.is_variadic[worker_row] or fns.is_extern[worker_row]
                value_type_uses_sret(return_type, structs, ctx)
            worker: LLVMValueRef = fns.handles[worker_row]
            # Validate the source and LLVM signatures before indexing any hidden parameters or
            # emitting the thunk. The ABI order is the source argument, packed store, then
            # hidden arena slots.
            return null if LLVMCountParams(worker) != 2
            expected_store_root: mutable i64 = auto_region_type_packed_store_root(argument_type, 0, structs)
            return_store_root: i64 = auto_region_type_packed_store_root(return_type, 0, structs)
            expected_store_root <- return_store_root if expected_store_root < 0
            return null if:
                expected_store_root < 0 or expected_store_root != runtime.active_store_enum
                return_store_root >= 0 and return_store_root != runtime.active_store_enum
                not auto_region_type_packed_store_roots_match(argument_type, runtime.active_store_enum, 0, structs)
                not auto_region_type_packed_store_roots_match(return_type, runtime.active_store_enum, 0, structs)
            worker_type: LLVMTypeRef = LLVMGlobalGetValueType(worker)
            captured_argument_llvm: LLVMTypeRef = llvm_type_of(argument_type, structs, ctx)
            pointer_type: LLVMTypeRef = LLVMPointerTypeInContext(ctx, 0)
            worker_argument_llvm: LLVMTypeRef = LLVMTypeOf(LLVMGetParam(worker, 0))
            argument_is_indirect: bool = value_type_uses_indirect_aggregate(argument_type, structs, ctx)
            return null if worker_argument_llvm != (pointer_type if argument_is_indirect else captured_argument_llvm)
            store_llvm: LLVMTypeRef = LLVMTypeOf(LLVMGetParam(worker, 1))
            return null if LLVMTypeOf(runtime.active_store) != store_llvm
            return_llvm: LLVMTypeRef = LLVMGetReturnType(worker_type)
            return null if return_llvm != llvm_type_of(return_type, structs, ctx)
            bits_llvm: LLVMTypeRef = LLVMIntTypeInContext(ctx, structs.target.target_pointer_bits)
            size_llvm: LLVMTypeRef = LLVMIntTypeInContext(ctx, structs.target.target_pointer_bits)
            capture_fields: mutable darray[LLVMTypeRef] = [captured_argument_llvm, store_llvm]
            capture_fields_pointer: void& = (&capture_fields[0]).cast[void&] can Unsafe.PointerCast
            capture_type: LLVMTypeRef = LLVMStructTypeInContext(ctx, capture_fields_pointer, 2, 0)
            malloc_params: mutable darray[LLVMTypeRef] = [size_llvm]
            malloc_params_pointer: void& = (&malloc_params[0]).cast[void&] can Unsafe.PointerCast
            malloc_type: LLVMTypeRef = LLVMFunctionType(pointer_type, malloc_params_pointer, 1, 0)
            malloc_fn: LLVMValueRef = declare_or_get_named(m, "malloc", malloc_type)
            return null if:
                LLVMGlobalGetValueType(malloc_fn) != malloc_type
                LLVMTypeOf(LLVMSizeOf(capture_type)) != size_llvm
            free_params: mutable darray[LLVMTypeRef] = [pointer_type]
            free_params_pointer: void& = (&free_params[0]).cast[void&] can Unsafe.PointerCast
            free_type: LLVMTypeRef = LLVMFunctionType(LLVMVoidTypeInContext(ctx), free_params_pointer, 1, 0)
            free_fn: LLVMValueRef = declare_or_get_named(m, "free", free_type)
            return null if LLVMGlobalGetValueType(free_fn) != free_type

            # The entry thunk: unpack the capture, release it, and call the worker. Hidden
            # arena slots are excluded above until their caller-owned identity can be captured.
            thunk_params: mutable darray[LLVMTypeRef] = [bits_llvm]
            thunk_params_pointer: void& = (&thunk_params[0]).cast[void&] can Unsafe.PointerCast
            thunk_type: LLVMTypeRef = LLVMFunctionType(return_llvm, thunk_params_pointer, 1, 0)
            thunk_symbol: mutable darray[u8] = []
            thunk_name_available: mutable bool = false
            while not thunk_name_available |thunk_symbol, thunk_name_available, structs|:
                thunk_symbol <- submit_thunk_symbol(structs.annotations.submit_thunk_counter)
                structs.annotations.submit_thunk_counter <- structs.annotations.submit_thunk_counter + 1.u64()
                if LLVMGetNamedFunction(m, (&thunk_symbol[0]).cast[cstr]) is existing_thunk:
                    pass
                else:
                    thunk_name_available <- true
            thunk: LLVMValueRef = LLVMAddFunction(m, (&thunk_symbol[0]).cast[cstr], thunk_type)
            # 8 = InternalLinkage: one private copy per submit site.
            LLVMSetLinkage(thunk, 8)
            thunk_builder: LLVMBuilderRef = LLVMCreateBuilderInContext(ctx)
            LLVMPositionBuilderAtEnd(thunk_builder, LLVMAppendBasicBlockInContext(ctx, thunk, "entry"))
            thunk_capture: LLVMValueRef = LLVMBuildIntToPtr(thunk_builder, LLVMGetParam(thunk, 0), pointer_type, "capture")
            thunk_argument: LLVMValueRef = LLVMBuildLoad2(thunk_builder, captured_argument_llvm, LLVMBuildStructGEP2(thunk_builder, capture_type, thunk_capture, 0, "capture.arg.slot"), "capture.arg")
            thunk_store: LLVMValueRef = LLVMBuildLoad2(thunk_builder, store_llvm, LLVMBuildStructGEP2(thunk_builder, capture_type, thunk_capture, 1, "capture.store.slot"), "capture.store")
            free_args: mutable darray[LLVMValueRef] = [thunk_capture]
            free_args_pointer: void& = (&free_args[0]).cast[void&] can Unsafe.PointerCast
            _ = LLVMBuildCall2(thunk_builder, free_type, free_fn, free_args_pointer, 1, "")
            worker_args: mutable darray[LLVMValueRef] = [thunk_argument, thunk_store]
            worker_argument: mutable LLVMValueRef = thunk_argument
            if argument_is_indirect:
                worker_argument_slot: LLVMValueRef = LLVMBuildAlloca(thunk_builder, captured_argument_llvm, "submit.worker.argument")
                _ = LLVMBuildStore(thunk_builder, thunk_argument, worker_argument_slot)
                worker_argument <- worker_argument_slot
                worker_args[0] <- worker_argument
            worker_args_pointer: void& = (&worker_args[0]).cast[void&] can Unsafe.PointerCast
            # 0 = LLVMVoidTypeKind: a void call must be unnamed.
            returns_void: bool = LLVMGetTypeKind(return_llvm) == 0
            worker_call: LLVMValueRef = LLVMBuildCall2(thunk_builder, worker_type, worker, worker_args_pointer, worker_args.count.u32(), "" if returns_void else "worker")
            # The thunk uses the default convention as a pool callback, but the indirect
            # worker call must match the worker declaration's own ABI convention.
            LLVMSetInstructionCallConv(worker_call, LLVMGetFunctionCallConv(worker))
            if returns_void:
                _ = LLVMBuildRetVoid(thunk_builder)
            else:
                _ = LLVMBuildRet(thunk_builder, worker_call)
            LLVMDisposeBuilder(thunk_builder)

            # The submission: build the capture here, hand its address to pool_submit1[uintptr, R].
            captured_argument: mutable LLVMValueRef? = null
            if argument_is_indirect:
                if (indirect_aggregate_argument_address(argument, argument_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}) is indirect_argument_address:
                    captured_argument <- LLVMBuildLoad2(builder, captured_argument_llvm, indirect_argument_address, "submit.capture.arg.value")
                elif (emit_expression_coerced(argument, argument_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}) is indirect_argument_value:
                    captured_argument <- indirect_argument_value
            elif (emit_expression_coerced(argument, argument_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}) is argument_value:
                captured_argument <- argument_value
            if captured_argument is captured_value:
                return null if LLVMTypeOf(captured_value) != captured_argument_llvm
                malloc_args: mutable darray[LLVMValueRef] = [LLVMSizeOf(capture_type)]
                malloc_args_pointer: void& = (&malloc_args[0]).cast[void&] can Unsafe.PointerCast
                capture: LLVMValueRef = LLVMBuildCall2(builder, malloc_type, malloc_fn, malloc_args_pointer, 1, "submit.capture")
                # `malloc` may fail even when the queue allocation below would succeed. Do not
                # form a GEP from its null result: abort through the target-aware backend helper,
                # which uses `llvm.trap` for freestanding component guests.
                submit_function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                capture_alloc_failed: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, submit_function, "submit.capture.oom")
                capture_alloc_ready: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, submit_function, "submit.capture.ready")
                capture_is_null: LLVMValueRef = LLVMBuildICmp(builder, 32, capture, LLVMConstNull(pointer_type), "submit.capture.null")
                _ = LLVMBuildCondBr(builder, capture_is_null, capture_alloc_failed, capture_alloc_ready)
                LLVMPositionBuilderAtEnd(builder, capture_alloc_failed)
                capture_abort_type: LLVMTypeRef = LLVMFunctionType(LLVMVoidTypeInContext(ctx), null, 0, 0)
                capture_abort: LLVMValueRef = declare_or_get_abort(m, capture_abort_type, structs.target.wasm_component_types_enabled)
                _ = LLVMBuildCall2(builder, capture_abort_type, capture_abort, null, 0, "")
                _ = LLVMBuildUnreachable(builder)
                LLVMPositionBuilderAtEnd(builder, capture_alloc_ready)
                _ = LLVMBuildStore(builder, captured_value, LLVMBuildStructGEP2(builder, capture_type, capture, 0, "submit.capture.arg"))
                _ = LLVMBuildStore(builder, runtime.active_store, LLVMBuildStructGEP2(builder, capture_type, capture, 1, "submit.capture.store"))
                capture_bits: LLVMValueRef = LLVMBuildPtrToInt(builder, capture, bits_llvm, "submit.capture.bits")
                submit_types: darray[ValueType] = [ValueType{kind: TypeKind.Unsigned, bits: structs.target.target_pointer_bits}, copied_type(return_type)]
                if instantiate_generic("pool_submit1", submit_types, generics, structs, m, ctx) is target:
                    return null if LLVMCountParams(target) != 3
                    pool_wanted: ValueType = instantiation_param_type("pool_submit1", submit_types, 0, generics, structs)
                    pool_expression: Expr = Expr.Ident(submit_pool, line)
                    pool_value: mutable LLVMValueRef? = null
                    if (indirect_aggregate_argument_address(pool_expression, pool_wanted, local_scope, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}) is pool_address:
                        pool_value <- pool_address
                    elif (emit_expression(pool_expression, pool_wanted, local_scope, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}) is pool_emitted:
                        pool_value <- materialize_indirect_aggregate_argument(pool_emitted, pool_wanted, structs, ctx, builder)
                    if pool_value is resolved_pool:
                        submit_args: mutable darray[LLVMValueRef] = [resolved_pool, thunk, capture_bits]
                        submit_args_pointer: void& = (&submit_args[0]).cast[void&] can Unsafe.PointerCast
                        return LLVMBuildCall2(builder, LLVMGlobalGetValueType(target), target, submit_args_pointer, 3, "submit.task")
            return null
