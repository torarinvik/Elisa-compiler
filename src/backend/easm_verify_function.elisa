# Stage1 EASM — per-instruction and per-header verification of a parsed EASM function.
# Part of `module Easm` (see easm_model.elisa); split out to keep each file short.

extend Easm:
    public:
        def verify_function_instructions(fn: Function, issues: mutable darray[Issue]&, stack_delta: mutable i64&, stack_touched: mutable bool&, stack_known: mutable bool&, uses_call: mutable bool&, writes_segment_any: mutable bool&):
            live_registers: mutable darray[sview] = []
            for input in fn.inputs:
                equals: usize = easm_find(input, "=")
                if equals < input.len:
                    input_register: sview = easm_register_operand(input[equals + 1.usize():input.len])
                    if input_register.len > 0:
                        live_registers.push(input_register)
            for label_index in 0..<fn.labels.count |fn|:
                for earlier_label in 0..<label_index |fn|:
                    if fn.labels[label_index].name == fn.labels[earlier_label].name:
                        issues.push(Issue{severity: Severity.Error, code: "duplicate-label-contract", line: fn.labels[label_index].line, message: "label contract duplicates an earlier label"})
            for inst in fn.instructions:
                if inst.op.len == 0 or not easm_known_op(inst.op):
                    issues.push(Issue{severity: Severity.Error, code: "unknown-op", line: inst.line, message: "instruction mnemonic is not in the EASM operation set"})
                source_operand: mutable sview = ""
                destination_operand: mutable sview = ""
                # Parser pseudo-ops (`compose`, `state`, labels, and similar metadata) do
                # not use the machine-instruction operand grammar. Keep arity enforcement
                # scoped to executable instructions so commas in metadata are not rejected.
                if inst.pseudo:
                    source_operand <- easm_substitute_operand(easm_first_operand(inst.text), inst)
                    destination_operand <- easm_substitute_operand(easm_last_operand(inst.text), inst)
                else:
                    operand_scan: EasmOperandScan::InstructionScanResult = EasmOperandScan::scan_instruction(inst.text)
                    if operand_scan.valid and operand_scan.count > 0 and operand_scan.count <= EasmOperandScan::MAX_MODELED_OPERAND_COUNT:
                        source_end: usize = operand_scan.first_separator if operand_scan.first_separator < inst.text.len else inst.text.len
                        source_operand <- easm_substitute_operand(easm_trim(inst.text[operand_scan.start:source_end]), inst)
                        destination_start: usize = operand_scan.last_separator + 1.usize() if operand_scan.last_separator < inst.text.len else operand_scan.start
                        destination_operand <- easm_substitute_operand(easm_trim(inst.text[destination_start:inst.text.len]), inst)
                    unsupported_operands: mutable bool = not operand_scan.valid or EasmOperandScan::needs_arity_rejection(operand_scan.count)
                    if not unsupported_operands and easm_known_op(inst.op):
                        unsupported_operands <- not EasmOperandScan::operand_arity_supported(inst.op, operand_scan.count)
                        unsupported_operands <- not easm_instruction_operand_roles_supported(inst.op, operand_scan.count, source_operand, destination_operand) if not unsupported_operands
                    if unsupported_operands:
                        issues.push(Issue{severity: Severity.Error, code: "unsupported-operands", line: inst.line, message: "instruction operand shape is outside the verified EASM model"})
                        continue
                    unmodeled_operand: mutable bool = false
                    source_memory_operand: bool = easm_memory_operand(source_operand)
                    destination_memory_operand: bool = easm_memory_operand(destination_operand)
                    # The modeled x86 instructions have at most one explicit memory
                    # operand. `lea` additionally requires an address source and a direct
                    # register destination; accepting other shapes only defers rejection to
                    # the assembler after the verifier has claimed the body is modeled.
                    unmodeled_operand <- true if operand_scan.count == 2 and source_memory_operand and destination_memory_operand
                    is_lea: bool = inst.op == "lea" or inst.op == "leaq"
                    lea_destination_register: sview = easm_register_operand(destination_operand)
                    lea_destination_is_direct_register: bool = destination_operand.len > 0 and destination_operand[0] == EasmOperandScan::ASCII_PERCENT and EasmOperandScan::exact_register_form(destination_operand, lea_destination_register)
                    unmodeled_operand <- true if is_lea and (operand_scan.count != 2 or not source_memory_operand or not lea_destination_is_direct_register)
                    for operand_index in 0..<operand_scan.count |operand_index, inst, operand_scan, unmodeled_operand|:
                        operand: sview = source_operand if operand_index == 0 else destination_operand
                        continue if operand.len == 0
                        memory_address: bool = easm_memory_operand(operand)
                        parsed_register: sview = easm_register_operand(operand)
                        register_operand: bool = EasmOperandScan::exact_register_form(operand, parsed_register)
                        immediate_operand: bool = operand[0] == EasmOperandScan::ASCII_DOLLAR
                        is_final_operand: bool = operand_index == 1 or operand_scan.count == 1
                        direct_target: bool = EasmOperandScan::is_direct_control_target(inst.op, operand, is_final_operand)
                        unmodeled_operand <- true if EasmOperandScan::rejects_unmodeled_operand_form(
                            true, memory_address, register_operand, immediate_operand, direct_target
                        ) or EasmOperandScan::rejects_return_immediate(inst.op, immediate_operand)
                    if unmodeled_operand:
                        issues.push(Issue{severity: Severity.Error, code: "unsupported-operand-form", line: inst.line, message: "operand form is outside the verified EASM register, immediate, and address model"})
                        continue
                capability: sview = easm_required_capability(inst.op)
                if capability.len > 0 and not easm_contract_has_word(fn.requires, capability):
                    issues.push(Issue{severity: Severity.Error, code: "missing-capability", line: inst.line, message: "instruction requires a capability in the requires contract"})
                implicit_reads: i64 = easm_implicit_read_mask(inst.op)
                if (implicit_reads & 1) != 0 and not easm_live_has(live_registers, "rax"):
                    issues.push(Issue{severity: Severity.Error, code: "implicit-read-uninitialized", line: inst.line, message: "instruction implicitly reads rax, which is not established"})
                if (implicit_reads & 2) != 0 and not easm_live_has(live_registers, "rcx"):
                    issues.push(Issue{severity: Severity.Error, code: "implicit-read-uninitialized", line: inst.line, message: "instruction implicitly reads rcx, which is not established"})
                implicit_writes: i64 = easm_implicit_write_mask(inst.op)
                if (implicit_writes & 1) != 0 and not easm_contract_has_word(fn.clobbers, "rax") and not easm_contract_has_register(fn.outputs, "rax"):
                    issues.push(Issue{severity: Severity.Error, code: "implicit-clobber-missing", line: inst.line, message: "instruction implicitly writes rax without an output or clobber declaration"})
                if (implicit_writes & 2) != 0 and not easm_contract_has_word(fn.clobbers, "rcx") and not easm_contract_has_register(fn.outputs, "rcx"):
                    issues.push(Issue{severity: Severity.Error, code: "implicit-clobber-missing", line: inst.line, message: "instruction implicitly writes rcx without an output or clobber declaration"})
                if (implicit_writes & 4) != 0 and not easm_contract_has_word(fn.clobbers, "rdx") and not easm_contract_has_register(fn.outputs, "rdx"):
                    issues.push(Issue{severity: Severity.Error, code: "implicit-clobber-missing", line: inst.line, message: "instruction implicitly writes rdx without an output or clobber declaration"})
                if (implicit_writes & 8) != 0 and not easm_contract_has_word(fn.clobbers, "rbx") and not easm_contract_has_register(fn.outputs, "rbx"):
                    issues.push(Issue{severity: Severity.Error, code: "implicit-clobber-missing", line: inst.line, message: "instruction implicitly writes rbx without an output or clobber declaration"})
                if implicit_writes != 0 and (easm_equal(inst.op, "cpuid") or easm_equal(inst.op, "rdtsc")):
                    live_registers <- []
                    live_registers.push("rax") if (implicit_writes & 1) != 0
                    live_registers.push("rcx") if (implicit_writes & 2) != 0
                    live_registers.push("rdx") if (implicit_writes & 4) != 0
                    live_registers.push("rbx") if (implicit_writes & 8) != 0
                read_register: mutable sview = easm_register_operand(source_operand)
                read_register <- "" if easm_starts(inst.op, "pop")
                if read_register.len > 0 and easm_register_bit(read_register) != EasmRegisterMasks::RSP and not easm_self_zeroing(inst) and not easm_live_has(live_registers, read_register) and not easm_contract_has_register(fn.preserves, read_register):
                    issues.push(Issue{severity: Severity.Error, code: "register-read-uninitialized", line: inst.line, message: "instruction reads a register that is not declared as an input or preserved"})
                destination_read_register: sview = easm_register_operand(destination_operand)
                if easm_reads_destination(inst) and destination_read_register != read_register and easm_register_bit(destination_read_register) != EasmRegisterMasks::RSP and not easm_live_has(live_registers, destination_read_register) and not easm_contract_has_register(fn.preserves, destination_read_register):
                    issues.push(Issue{severity: Severity.Error, code: "register-read-uninitialized", line: inst.line, message: "read-modify-write instruction reads a destination register that is not declared as an input or preserved"})
                source_memory_base: sview = easm_memory_base_register(source_operand)
                if source_memory_base != "" and source_memory_base != "rsp" and source_memory_base != "rip" and not easm_live_has(live_registers, source_memory_base) and not easm_contract_has_register(fn.preserves, source_memory_base):
                    issues.push(Issue{severity: Severity.Error, code: "register-read-uninitialized", line: inst.line, message: "memory address reads a base register that is not declared as an input or preserved"})
                destination_memory_base: sview = easm_memory_base_register(destination_operand)
                if destination_memory_base != "" and destination_memory_base != "rsp" and destination_memory_base != "rip" and not easm_live_has(live_registers, destination_memory_base) and not easm_contract_has_register(fn.preserves, destination_memory_base) and destination_memory_base != source_memory_base:
                    issues.push(Issue{severity: Severity.Error, code: "register-read-uninitialized", line: inst.line, message: "memory address reads a base register that is not declared as an input or preserved"})
                source_memory_index: sview = easm_memory_index_register(source_operand)
                if source_memory_index != "" and source_memory_index != "rsp" and source_memory_index != "rip" and not easm_live_has(live_registers, source_memory_index) and not easm_contract_has_register(fn.preserves, source_memory_index) and source_memory_index != source_memory_base and source_memory_index != destination_memory_base:
                    issues.push(Issue{severity: Severity.Error, code: "register-read-uninitialized", line: inst.line, message: "memory address reads an index register that is not declared as an input or preserved"})
                destination_memory_index: sview = easm_memory_index_register(destination_operand)
                if destination_memory_index != "" and destination_memory_index != "rsp" and destination_memory_index != "rip" and not easm_live_has(live_registers, destination_memory_index) and not easm_contract_has_register(fn.preserves, destination_memory_index) and destination_memory_index != source_memory_base and destination_memory_index != destination_memory_base and destination_memory_index != source_memory_index:
                    issues.push(Issue{severity: Severity.Error, code: "register-read-uninitialized", line: inst.line, message: "memory address reads an index register that is not declared as an input or preserved"})
                write_register: mutable sview = easm_register_operand(destination_operand)
                write_register <- "" if easm_starts(inst.op, "push") or easm_starts(inst.op, "call") or easm_starts(inst.op, "jmp") or easm_starts(inst.op, "ret") or easm_starts(inst.op, "cmp") or easm_starts(inst.op, "test")
                if write_register.len > 0 and not easm_contract_has_register(fn.outputs, write_register) and not easm_contract_has_register(fn.clobbers, write_register):
                    issues.push(Issue{severity: Severity.Error, code: "register-write-without-clobber", line: inst.line, message: "instruction writes a register that is not declared as an output or clobber"})
                if write_register.len > 0 and not easm_live_has(live_registers, write_register):
                    live_registers.push(write_register)
                if inst.op == "xchg" or inst.op == "xchgl" or inst.op == "xchgq":
                    source_write_register: sview = easm_register_operand(source_operand)
                    if source_write_register != "" and source_write_register != write_register:
                        if not easm_contract_has_register(fn.outputs, source_write_register) and not easm_contract_has_register(fn.clobbers, source_write_register):
                            issues.push(Issue{severity: Severity.Error, code: "register-write-without-clobber", line: inst.line, message: "instruction writes a register that is not declared as an output or clobber"})
                        if not easm_live_has(live_registers, source_write_register):
                            live_registers.push(source_write_register)
                if easm_memory_reads(inst) and not easm_contract_has_exact(fn.clobbers, "memory") and not easm_contract_has_exact(fn.clobbers, "memory.read"):
                    issues.push(Issue{severity: Severity.Error, code: "memory-read-without-clobber", line: inst.line, message: "memory read requires a memory or memory.read clobber"})
                if easm_memory_writes(inst) and not easm_contract_has_exact(fn.clobbers, "memory") and not easm_contract_has_exact(fn.clobbers, "memory.write"):
                    issues.push(Issue{severity: Severity.Error, code: "memory-write-without-clobber", line: inst.line, message: "memory write requires a memory or memory.write clobber"})
                if (easm_find(source_operand, "%fs") < source_operand.len or easm_find(source_operand, "%gs") < source_operand.len or easm_find(destination_operand, "%fs") < destination_operand.len or easm_find(destination_operand, "%gs") < destination_operand.len) and not easm_contract_has_word(fn.requires, "x86_64.segment"):
                    issues.push(Issue{severity: Severity.Error, code: "segment-register-intent-missing", line: inst.line, message: "fs/gs use requires an x86_64.segment capability"})
                last_operand: sview = easm_trim(destination_operand)
                writes_segment: bool = last_operand == "%fs" or last_operand == "%gs"
                writes_segment_any <- true if writes_segment
                uses_call <- true if easm_starts(inst.op, "call")
                if writes_segment and not easm_contract_has_word(fn.requires, "x86_64.segment.write"):
                    issues.push(Issue{severity: Severity.Error, code: "segment-register-write-intent-missing", line: inst.line, message: "writing fs/gs requires x86_64.segment.write intent"})
                if writes_segment and not easm_contract_has_word(fn.clobbers, "memory") and not easm_contract_has_word(fn.clobbers, "memory.write"):
                    issues.push(Issue{severity: Severity.Error, code: "segment-register-write-without-memory-clobber", line: inst.line, message: "writing fs/gs requires a memory clobber"})
                if (easm_starts(inst.op, "add") or easm_starts(inst.op, "sub") or easm_starts(inst.op, "cmp") or easm_starts(inst.op, "test")) and not easm_contract_has_word(fn.clobbers, "cc") and not easm_contract_has_word(fn.clobbers, "flags"):
                    issues.push(Issue{severity: Severity.Error, code: "cc-clobber-missing", line: inst.line, message: "arithmetic instruction requires a cc or flags clobber"})
                if easm_starts(inst.op, "push"):
                    stack_delta <- stack_delta - 8
                    stack_touched <- true
                stack_write_handled: mutable bool = false
                if easm_starts(inst.op, "pop"):
                    stack_touched <- true
                    stack_write_handled <- true
                    pop_destination: sview = easm_register_operand(destination_operand)
                    if easm_register_bit(pop_destination) == EasmRegisterMasks::RSP:
                        issues.push(Issue{severity: Severity.Error, code: "pop-stack-pointer", line: inst.line, message: "pop may not write the stack pointer or one of its aliases"})
                        stack_known <- false
                    else:
                        stack_delta <- stack_delta + 8
                stack_adjust_destination: sview = easm_register_operand(destination_operand)
                if easm_starts(inst.op, "add") or easm_starts(inst.op, "sub"):
                    if easm_register_bit(stack_adjust_destination) == EasmRegisterMasks::RSP:
                        stack_touched <- true
                        stack_write_handled <- true
                        if stack_adjust_destination != "rsp":
                            issues.push(Issue{severity: Severity.Error, code: "unsupported-stack-pointer-width", line: inst.line, message: "stack-pointer arithmetic must write the 64-bit %rsp register; narrower aliases are unsupported"})
                            stack_known <- false
                        else:
                            immediate: (valid: bool, value: i64) = easm_immediate_operand_after_dollar_checked(source_operand)
                            if not immediate.valid:
                                issues.push(Issue{severity: Severity.Error, code: "invalid-stack-adjustment", line: inst.line, message: "stack-pointer adjustment requires a valid signed 32-bit immediate"})
                                stack_known <- false
                            else:
                                if easm_starts(inst.op, "add"):
                                    stack_delta <- stack_delta + immediate.value
                                else:
                                    stack_delta <- stack_delta - immediate.value
                stack_write_register: sview = easm_stack_pointer_write_register(inst)
                if stack_write_register != "" and not stack_write_handled:
                    stack_touched <- true
                    stack_known <- false
                    if stack_write_register != "rsp":
                        issues.push(Issue{severity: Severity.Error, code: "unsupported-stack-pointer-width", line: inst.line, message: "direct stack-pointer writes must use the 64-bit %rsp register; narrower aliases are unsupported"})
                    elif not easm_contract_has_word(fn.requires, "stack.balance.unchecked"):
                        issues.push(Issue{severity: Severity.Error, code: "unsupported-stack-pointer-write", line: inst.line, message: "direct stack-pointer writes outside modeled push/pop and immediate add/sub are unsupported without stack.balance.unchecked"})
                if easm_starts(inst.op, "call"):
                    if stack_known == false and not easm_contract_has_word(fn.requires, "stack.call_alignment.unchecked"):
                        issues.push(Issue{severity: Severity.Error, code: "call-stack-alignment-unknown", line: inst.line, message: "call stack alignment is unknown after an unmodeled stack-pointer write"})
                    elif stack_known == true and (8 + stack_delta) % 16 != 0 and not easm_contract_has_word(fn.requires, "stack.call_alignment.unchecked"):
                        issues.push(Issue{severity: Severity.Error, code: "call-stack-misaligned", line: inst.line, message: "call executes with stack pointer not aligned to 16 bytes"})
                if easm_starts(inst.op, "call"):
                    live_registers <- []
                control_target: sview = easm_trim(destination_operand)
                indirect_control_target: bool = easm_find(control_target, "*") < control_target.len or easm_memory_operand(control_target) or (control_target.len > 0 and control_target[0] == 37)
                target_is_local: bool = easm_label_index(fn.instructions, control_target) >= 0
                if EasmOperandScan::rejects_unresolved_conditional_target(
                    easm_is_conditional_jump(inst.op), target_is_local,
                    easm_contract_has_word(fn.requires, "control.direct"),
                    easm_contract_has_word(fn.requires, "relocation.symbol")
                ):
                    issues.push(Issue{severity: Severity.Error, code: "unknown-label", line: inst.line, message: "conditional jump target is not a declared local label"})
                if easm_starts(inst.op, "jmp") and not indirect_control_target:
                    target: sview = control_target
                    if target.len > 0:
                        known_label: mutable bool = false
                        for label in fn.labels:
                            known_label <- true if easm_equal(label.name, target)
                        for possible in fn.instructions:
                            if possible.op == "label" and easm_find(possible.text, target) < possible.text.len:
                                known_label <- true
                        if not known_label and not easm_contract_has_word(fn.requires, "control.direct") and not easm_contract_has_word(fn.requires, "relocation.symbol"):
                            issues.push(Issue{severity: Severity.Error, code: "unknown-label", line: inst.line, message: "direct jump target is not a declared label"})
                if easm_starts(inst.op, "call") or easm_starts(inst.op, "jmp"):
                    target_operand: sview = control_target
                    indirect: bool = indirect_control_target
                    if indirect and not easm_contract_has_word(fn.requires, "control.indirect"):
                        issues.push(Issue{severity: Severity.Error, code: "indirect-control-intent-missing", line: inst.line, message: "indirect call/jmp requires control.indirect intent"})
                    if not indirect and not easm_contract_has_word(fn.requires, "control.direct") and not easm_contract_has_word(fn.requires, "relocation.symbol"):
                        local_label: mutable bool = false
                        for label in fn.labels:
                            local_label <- true if easm_equal(label.name, target_operand)
                        if not local_label:
                            issues.push(Issue{severity: Severity.Error, code: "direct-control-intent-missing", line: inst.line, message: "direct symbolic call/jmp requires control.direct or relocation.symbol intent"})

        def easm_operand_is_direct_register(operand: sview) -> bool:
            register: sview = easm_register_operand(operand)
            return operand.len > 0 and operand[0] == EasmOperandScan::ASCII_PERCENT and EasmOperandScan::exact_register_form(operand, register) and easm_register_bit(register) != 0

        def easm_operand_is_segment_register(operand: sview) -> bool:
            return operand == "%fs" or operand == "%gs"

        def easm_address_register_width(operand: sview) -> i64:
            return EasmAddressWidthPolicy::ADDRESS_REGISTER_WIDTH_UNKNOWN if not easm_operand_is_direct_register(operand)
            return EasmAddressWidthPolicy::address_register_width(easm_register_operand(operand))

        def easm_memory_address_tuple_supported(operand: sview) -> bool:
            return false if:
                not easm_memory_operand(operand)
                easm_find(operand, "[") < operand.len or easm_find(operand, "]") < operand.len
            open: usize = easm_find(operand, "(")
            return false if:
                open >= operand.len
                easm_find(operand[0:open], ")") < open
            close_relative: usize = easm_find(operand[open:operand.len], ")")
            false return if close_relative >= (operand[open:operand.len]).len
            close: usize = open + close_relative
            false return if (easm_trim(operand[close + 1.usize():operand.len])).len != 0
            inside: sview = operand[open + 1.usize():close]
            false return if easm_find(inside, "(") < inside.len or easm_find(inside, ")") < inside.len
            first_comma: usize = easm_find(inside, ",")
            if first_comma >= inside.len:
                base: sview = easm_trim(inside)
                return base == "%rip" or easm_address_register_width(base) != 0
            base_field: sview = easm_trim(inside[0:first_comma])
            base_width: i64 = easm_address_register_width(base_field)
            return false if:
                base_field == "" or base_width == 0
                base_field == "%rip"
            remainder: sview = inside[first_comma + 1.usize():inside.len]
            second_comma: usize = easm_find(remainder, ",")
            if second_comma >= remainder.len:
                index_field: sview = easm_trim(remainder)
                return true if index_field == ""
                index_width: i64 = easm_address_register_width(index_field)
                return index_width == base_width and easm_register_bit(easm_register_operand(index_field)) != EasmRegisterMasks::RSP
            index_field: sview = easm_trim(remainder[0:second_comma])
            scale_field: sview = easm_trim(remainder[second_comma + 1.usize():remainder.len])
            index_width: i64 = easm_address_register_width(index_field)
            return false if:
                index_field == "" or index_width == 0 or index_width != base_width
                easm_register_bit(easm_register_operand(index_field)) == EasmRegisterMasks::RSP
                easm_find(scale_field, ",") < scale_field.len
            return scale_field == "1" or scale_field == "2" or scale_field == "4" or scale_field == "8"

        def easm_operand_is_supported_memory(operand: sview) -> bool:
            false return if not easm_memory_address_tuple_supported(operand)
            base: sview = easm_memory_base_register(operand)
            index: sview = easm_memory_index_register(operand)
            base_supported: bool = base == "" or base == "rip" or easm_register_bit(base) != 0
            index_supported: bool = index == "" or (easm_register_bit(index) != 0 and easm_register_bit(index) != EasmRegisterMasks::RSP)
            return base_supported and index_supported

        def easm_operand_is_immediate(operand: sview) -> bool:
            return operand.len > 0 and operand[0] == EasmOperandScan::ASCII_DOLLAR

        def easm_operand_is_data_source(operand: sview) -> bool:
            return easm_operand_is_direct_register(operand) or easm_operand_is_supported_memory(operand) or easm_operand_is_immediate(operand)

        def easm_operand_is_writable(operand: sview) -> bool:
            return easm_operand_is_direct_register(operand) or easm_operand_is_supported_memory(operand)

        def easm_is_move_operation(op: sview) -> bool:
            return op == "mov" or op == "movq" or op == "movb" or op == "movw" or op == "movl"

        def easm_move_operand_roles_supported(source: sview, destination: sview) -> bool:
            source_segment: bool = easm_operand_is_segment_register(source)
            destination_segment: bool = easm_operand_is_segment_register(destination)
            false return if source_segment and destination_segment
            if source_segment:
                return easm_operand_is_writable(destination)
            if destination_segment:
                return (easm_operand_is_direct_register(source) or easm_operand_is_supported_memory(source)) and not easm_operand_is_immediate(source)
            return easm_operand_is_data_source(source) and easm_operand_is_writable(destination)

        def easm_is_extension_move(op: sview) -> bool:
            return (
                op == "movsx" or op == "movsxd" or op == "movsbw" or op == "movsbl" or op == "movsbq" or
                op == "movswl" or op == "movswq" or op == "movslq" or op == "movzx" or
                op == "movzbw" or op == "movzbl" or op == "movzbq" or op == "movzwl" or op == "movzwq"
            )

        def easm_is_shift_operation(op: sview) -> bool:
            return easm_starts(op, "shl") or easm_starts(op, "sal") or easm_starts(op, "shr") or easm_starts(op, "sar")

        def easm_is_call_or_unconditional_jump(op: sview) -> bool:
            return op == "call" or op == "callq" or op == "jmp" or op == "jmpq"

        def easm_operand_is_control_target(op: sview, operand: sview) -> bool:
            true return if EasmOperandScan::is_direct_control_target(op, operand, true) and not easm_memory_operand(operand)
            return false if:
                not easm_is_call_or_unconditional_jump(op)
                operand.len < EasmOperandScan::INDIRECT_REGISTER_PREFIX_LENGTH or operand[0] != EasmOperandScan::ASCII_STAR
            indirect_operand: sview = easm_trim(operand[1:operand.len])
            return easm_operand_is_direct_register(indirect_operand) or easm_operand_is_supported_memory(indirect_operand)

        def easm_instruction_operand_roles_supported(op: sview, count: usize, source: sview, destination: sview) -> bool:
            false return if not EasmOperandScan::operand_arity_supported(op, count)
            true return if count == 0
            if op == "mrs":
                return false
            if op == "call" or op == "callq" or op == "jmp" or op == "jmpq":
                return easm_operand_is_control_target(op, destination)
            if (op == "je" or op == "jz" or op == "jne" or op == "jnz" or op == "jl" or op == "jle" or
                op == "jg" or op == "jge" or op == "jb" or op == "jbe" or op == "ja" or op == "jae"):
                return EasmOperandScan::is_direct_control_target(op, destination, true)
            if op == "push" or op == "pushq":
                return easm_operand_is_data_source(source) or easm_operand_is_segment_register(source)
            if op == "pop" or op == "popq":
                return easm_operand_is_writable(destination) or easm_operand_is_segment_register(destination)
            if (op == "inc" or op == "incq" or op == "dec" or op == "decq" or
                op == "neg" or op == "negq" or op == "not" or op == "notq"):
                return easm_operand_is_writable(destination)
            if op == "fldcw" or op == "ldmxcsr":
                return easm_operand_is_supported_memory(source)
            if op == "fnstcw" or op == "stmxcsr":
                return easm_operand_is_supported_memory(destination)
            if op == "lea" or op == "leaq":
                return easm_operand_is_supported_memory(source) and easm_operand_is_direct_register(destination)
            if easm_is_shift_operation(op):
                if count == 1:
                    return easm_operand_is_writable(destination)
                shift_count_is_valid: bool = easm_operand_is_immediate(source) or (easm_operand_is_direct_register(source) and easm_register_operand(source) == "cl")
                return shift_count_is_valid and easm_operand_is_writable(destination)
            if op == "xchg" or op == "xchgl" or op == "xchgq":
                return easm_operand_is_writable(source) and easm_operand_is_writable(destination) and not (easm_memory_operand(source) and easm_memory_operand(destination))
            if easm_is_move_operation(op):
                return easm_move_operand_roles_supported(source, destination)
            if easm_is_extension_move(op):
                return (not easm_operand_is_immediate(source)) and easm_operand_is_direct_register(destination) and easm_operand_is_data_source(source)
            if EasmOperandScan::is_two_operand_instruction(op):
                return easm_operand_is_data_source(source) and easm_operand_is_writable(destination)
            return false

        def verify_function_header(module: Module, outer_index: usize, fn: Function, issues: mutable darray[Issue]&):
            if fn.name.len == 0:
                issues.push(Issue{severity: Severity.Error, code: "empty-function-name", line: fn.line, message: "function name must not be empty"})
            easm_verify_register_contracts(fn, issues)
            for earlier in 0..<outer_index |module, fn|:
                if fn.name == module.functions[earlier].name and fn.name.len > 0:
                    issues.push(Issue{severity: Severity.Error, code: "duplicate-export", line: fn.line, message: "EASM export duplicates an earlier export"})
                    break
            if not easm_starts(fn.return_type, "void") and fn.outputs.count == 0:
                issues.push(Issue{severity: Severity.Error, code: "missing-return-output", line: fn.line, message: "non-void EASM export must declare an output binding"})
            for input in fn.inputs:
                if easm_find(input, "=") == input.len:
                    issues.push(Issue{severity: Severity.Error, code: "invalid-input-binding", line: fn.line, message: "input binding must use name = register syntax"})
            for output in fn.outputs:
                if easm_find(output, "=") == output.len:
                    issues.push(Issue{severity: Severity.Error, code: "invalid-output-binding", line: fn.line, message: "output binding must use name = register syntax"})
            if easm_callee_saved_unprotected(fn):
                issues.push(Issue{severity: Severity.Error, code: "callee-saved-not-preserved", line: fn.line, message: "callee-saved register is clobbered without a preservation contract"})
            easm_verify_callee_saved_preservation(fn, issues)
            issues.reserve(issues.count + module.protocols.count)
            for protocol in module.protocols:
                for method in protocol.methods:
                    if easm_equal(method.name, fn.name) and method.arity != fn.params.count.i64():
                        issues.push(Issue{severity: Severity.Error, code: "protocol-arity-mismatch", line: fn.line, message: "platform implementation does not match protocol method arity"})

        def verify_function_post(module: Module, fn: Function, stack_delta: i64, stack_touched: bool, stack_known: bool, uses_call: bool, writes_segment_any: bool, issues: mutable darray[Issue]&):
            if stack_touched and stack_known and stack_delta != 0 and not easm_contract_has_word(fn.requires, "stack.balance.unchecked"):
                issues.push(Issue{severity: Severity.Error, code: "stack-unbalanced", line: fn.line, message: "stack pointer delta is not restored before function exit"})
            if uses_call and fn.stack_facts.count == 0 and not easm_contract_has_word(fn.requires, "stack.call_alignment.unchecked"):
                issues.push(Issue{severity: Severity.Error, code: "call-without-stack-contract", line: fn.line, message: "call requires an explicit stack contract"})
            if writes_segment_any and easm_contract_has_word(fn.control, "returns") and not easm_contract_has_word(fn.requires, "x86_64.segment.restore") and not easm_contract_has_word(fn.requires, "x86_64.segment.persistent"):
                issues.push(Issue{severity: Severity.Error, code: "segment-register-return-without-lifetime-contract", line: fn.line, message: "returning after writing fs/gs requires restore or persistent segment intent"})
            easm_verify_handles(fn, issues)
            easm_verify_memory_roles(fn, module.layouts, issues)
            easm_verify_frame_contracts(fn, issues)
            easm_verify_machine_roles(fn, issues)


        def verify_module_locksteps(module: Module) -> darray[Issue]:
            issues: mutable darray[Issue] = []
            issues.reserve(issues.count + module.functions.count)
            for fn in module.functions:
                if fn.reference.count > 0 or fn.targets.count > 0:
                    if fn.reference.count == 0:
                        issues.push(Issue{severity: Severity.Error, code: "lockstep-missing-reference", line: fn.line, message: "target lockstep implementation requires a reference body"})
                    issues.reserve(issues.count + fn.targets.count)
                    for target_body in fn.targets:
                        if not easm_equal(target_body.lockstep, "reference"):
                            issues.push(Issue{severity: Severity.Error, code: "lockstep-unknown-reference", line: target_body.line, message: "lockstep target must name the reference body"})
                        for target_instruction in target_body.instructions:
                            if target_instruction.op.len == 0 or not easm_known_op(target_instruction.op):
                                issues.push(Issue{severity: Severity.Error, code: "unknown-target-op", line: target_instruction.line, message: "target instruction mnemonic is not in the EASM operation set"})
                        for target_issue in verify_lockstep_body(module, fn, target_body.instructions) |issues|:
                            issues.push(target_issue)
                for inst in fn.reference:
                    if inst.op.len == 0 or not easm_known_op(inst.op):
                        issues.push(Issue{severity: Severity.Error, code: "unknown-reference-op", line: inst.line, message: "reference instruction mnemonic is not in the EASM operation set"})
                if fn.reference.count > 0:
                    for reference_issue in verify_lockstep_body(module, fn, fn.reference) |issues|:
                        issues.push(reference_issue)

            return issues


        def verify_one_function(module: Module, outer_index: usize, fn: Function, issues: mutable darray[Issue]&):
            return if not easm_target_matches(fn.platform, module.target)
            verify_function_header(module, outer_index, fn, issues)
            stack_delta: mutable i64 = 0
            stack_touched: mutable bool = false
            stack_known: mutable bool = true
            uses_call: mutable bool = false
            writes_segment_any: mutable bool = false
            verify_function_instructions(fn, issues, stack_delta, stack_touched, stack_known, uses_call, writes_segment_any)
            verify_function_post(module, fn, stack_delta, stack_touched, stack_known, uses_call, writes_segment_any, issues)


        def verify_module_functions(module: Module, issues: mutable darray[Issue]&):
            for outer_index in 0..<module.functions.count |module|:
                fn: Function = module.functions[outer_index]
                verify_one_function(module, outer_index, fn, issues)


        def verify_module_fragments(module: Module, issues: mutable darray[Issue]&):
            issues.reserve(issues.count + module.fragments.count)
            for fragment in module.fragments:
                for inst in fragment.instructions:
                    if inst.op.len == 0 or not easm_known_op(inst.op):
                        issues.push(Issue{severity: Severity.Error, code: "unknown-fragment-op", line: inst.line, message: "fragment instruction mnemonic is not in the EASM operation set"})


        def verify_function_compositions(fn: Function, fragments: darray[Function]&, issues: mutable darray[Issue]&):
            issues.reserve(issues.count + fn.instructions.count)
            for inst in fn.instructions:
                if easm_starts(inst.op, "compose"):
                    open: usize = easm_find(inst.text, "compose ")
                    name_start: usize = open + 8.usize()
                    name_end: mutable usize = easm_first_space(inst.text[name_start:inst.text.len]) + name_start
                    args_open: usize = easm_find(inst.text, "(")
                    if args_open >= name_start and args_open < name_end:
                        name_end <- args_open
                    name: sview = easm_trim(inst.text[name_start:name_end])
                    found: mutable bool = false
                    for fragment in fragments:
                        if fragment.name == name:
                            found <- true
                            args_close: mutable usize = inst.text.len
                            if args_open < inst.text.len:
                                args_close <- easm_find(inst.text[args_open:inst.text.len], ")") + args_open
                            if args_open < inst.text.len and args_close > args_open:
                                argument_count: i64 = easm_compose_argument_count(inst.text[args_open + 1.usize():args_close])
                                if argument_count != fragment.params.count.i64():
                                    issues.push(Issue{severity: Severity.Error, code: "fragment-arity", line: inst.line, message: "compose argument count does not match fragment parameters"})
                    if not found:
                        issues.push(Issue{severity: Severity.Error, code: "unknown-fragment", line: inst.line, message: "compose references an unknown fragment"})
            verify_control_flow_merges(fn, issues)


        def verify_module_compositions(module: Module, issues: mutable darray[Issue]&):
            for fn in module.functions |module, issues|:
                verify_function_compositions(fn, module.fragments, issues)


        def verify_module(module: Module) -> darray[Issue]:
            issues: mutable darray[Issue] = []
            verify_module_layouts(module, issues)
            verify_module_protocols(module, issues)
            verify_module_functions(module, issues)
            for lockstep_issue in verify_module_locksteps(module) |issues|:
                issues.push(lockstep_issue)
            verify_module_fragments(module, issues)
            verify_module_compositions(module, issues)
            return issues

        def analyze_templates(module: mutable Module&) -> void:
            for template in module.templates |module|:
                referenced: mutable darray[sview] = []
                template.patch_points <- []
                for instruction_index in 0..<template.instructions.count |template, module, referenced|:
                    instruction: Instruction = template.instructions[instruction_index]
                    if instruction.op == "compose":
                        module.issues.push(Issue{severity: Severity.Error, code: "template-compose", line: instruction.line, message: "templates may not compose fragments"})
                    operand_class: sview = easm_template_operand_class(instruction.op)
                    for hole in template.holes |template, module, referenced, instruction, instruction_index, operand_class|:
                        if easm_find(instruction.text, hole.name) >= instruction.text.len:
                            continue
                        referenced.push(hole.name)
                        hole_class: sview = easm_template_hole_class(hole.type_name)
                        if operand_class != "" and hole_class != "" and operand_class != hole_class:
                            module.issues.push(Issue{severity: Severity.Error, code: "template-hole-type-mismatch", line: instruction.line, message: "template hole type does not match the instruction operand width"})
                        template.patch_points.push(PatchPoint{hole: hole.name, type_name: hole.type_name, instruction_index: instruction_index.i64(), class_name: operand_class})
                for hole in template.holes:
                    found: mutable bool = false
                    for used in referenced:
                        found <- true if used == hole.name
                    if not found:
                        module.issues.push(Issue{severity: Severity.Error, code: "unused-template-hole", line: template.line, message: "template hole is declared but never referenced"})

        def easm_template_hole_class(type_name: sview) -> sview:
            return when type_name:
                "u16" | "i16" | "GuestFsSelector" | "HostFsSelector" | "GuestGsSelector" | "HostGsSelector" -> "sel16"
                _ -> "wide64"

        def easm_template_operand_class(op: sview) -> sview:
            return when op:
                "movw" | "fldcw" | "fnstcw" -> "sel16"
                "movabs" | "movq" | "lea" | "call" | "callq" | "jmp" | "jmpq" | "push" | "pushq" -> "wide64"
                _ -> ""

        def easm_first_space(text: sview) -> usize:
            return EasmTextScan::first_space(text).usize()

        def easm_parse_i64_checked(text: sview) -> (valid: bool, value: i64):
            ensure result.valid == EasmCheckedDecimal::decimal_parse_reference(text).valid and result.value == EasmCheckedDecimal::decimal_parse_reference(text).value and (result.valid or result.value == 0)
            return EasmCheckedDecimal::parse_signed(text)

        # Pure specification of easm_parse_i64 through the checked-decimal reference.
        ghost def easm_parse_i64_spec(text: sview) -> i64:
            return EasmCheckedDecimal::decimal_parse_reference(text).value if EasmCheckedDecimal::decimal_parse_reference(text).valid else 0

        def easm_parse_i64(text: sview) -> i64:
            ensure result == easm_parse_i64_spec(text)
            parsed: (valid: bool, value: i64) = easm_parse_i64_checked(text)
            value: i64 = parsed.value if parsed.valid else 0
            assert value == easm_parse_i64_spec(text)
            return value

        def easm_type_width(type_name: sview) -> i64:
            return match type_name:
                "u8" | "i8" | "bool": 1
                "u16" | "i16": 2
                "u32" | "i32" | "f32": 4
                "u64" | "i64" | "f64" | "ptr" | "uintptr": 8
                _: 0

        def easm_find(text: sview, needle: sview) -> usize:
            return EasmTextScan::find(text, needle)

        def easm_binding_register(binding: sview) -> sview:
            equals: usize = easm_find(binding, "=")
            if equals >= binding.len:
                return ""
            return easm_register_operand(binding[equals + 1.usize():binding.len])

        def easm_instruction_reads_register(instruction: Instruction, wanted: sview) -> bool:
            if instruction.pseudo:
                return false
            wanted_bit: i64 = easm_register_bit(wanted)
            if wanted_bit == 0:
                return false
            source: sview = easm_first_operand(instruction.text)
            if easm_register_bit(easm_register_operand(source)) == wanted_bit:
                return true
            return easm_register_bit(easm_memory_base_register(source)) == wanted_bit

        def easm_function_reads_register(fn: Function, wanted: sview) -> bool:
            for instruction in fn.instructions:
                if easm_instruction_reads_register(instruction, wanted):
                    return true
            return false

        def easm_prune_conditional_inputs[@r](variants: mutable darray[Function] @r) -> void:
            ever_used: mutable i64 = 0
            for variant in variants:
                for input in variant.inputs:
                    register: sview = easm_binding_register(input)
                    if easm_function_reads_register(variant, register):
                        ever_used <- ever_used | easm_register_bit(register)
            for variant_index in 0..<variants.count |variant_index, variants|:
                variant: mutable Function = variants[variant_index]
                kept_inputs: mutable darray[sview] @r = []
                dropped_names: mutable darray[sview] @r = []
                for input in variant.inputs:
                    register: sview = easm_binding_register(input)
                    bit: i64 = easm_register_bit(register)
                    if bit != 0 and (ever_used & bit) != 0 and not easm_function_reads_register(variant, register):
                        dropped_names.push(easm_binding_name(input))
                    else:
                        kept_inputs.push(input)
                kept_params: mutable darray[Param] @r = []
                for parameter in variant.params:
                    drop: mutable bool = false
                    for name in dropped_names:
                        drop <- true if easm_equal(parameter.name, name)
                    if not drop:
                        kept_params.push(parameter)
                variant.inputs <- kept_inputs
                variant.params <- kept_params
                variants[variant_index] <- variant
