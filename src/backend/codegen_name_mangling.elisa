# Stage1 backend — the MANGLED LLVM symbol a monomorphized or overloaded declaration is emitted
# under: the source-level spelling each type argument contributes, the `__ov<slot>` overload
# suffix, and the qualified-owner lookups that resolve a written name to a registered one.
# Part of `module Backend` (see codegen.elisa).

extend Backend:
    private:


        # `candidate == head ++ "::" ++ tail`, without building the join.
        def qualified_owner_matches(candidate: sview, head: sview, rest: sview) -> bool can[Abort.Panic]:
            head_length: usize = sview_len(head)
            rest_length: usize = sview_len(rest)
            false return if head_length == 0 or rest_length == 0
            false return if sview_len(candidate) != head_length + 2.usize() + rest_length
            for index in 0..<head_length |candidate, head|:
                false return if sview_at(candidate, index) != sview_at(head, index)
            false return if sview_at(candidate, head_length) != 58
            false return if sview_at(candidate, head_length + 1.usize()) != 58
            for index in 0..<rest_length |candidate, rest, head_length|:
                false return if sview_at(candidate, head_length + 2.usize() + index) != sview_at(rest, index)
            return true




        # The module a `using Mod as M` alias stands for, or the name unchanged when it is not
        # an alias. The pools are parallel and pushed in the parser's order, so an entry only
        # counts when both halves are present.
        def module_alias_target(name: sview, structs: StructTable&) -> sview can[Abort.Panic]:
            for index in 0..<structs.module_alias_names.count |structs, name|:
                continue if index >= structs.module_alias_targets.count
                structs.module_alias_targets[index] return if structs.module_alias_names[index] == name
            return name




        # The REGISTERED owner sview for a two-part module path `head::tail`, or null.
        # Returning the recorded sview (rather than a freshly joined one) is what lets the
        # ordinary FnTable lookups compare it by content with no allocation anywhere.
        def qualified_owner_of(fns: FnTable&, head: sview, rest: sview) -> sview? can[Abort.Panic]:
            can Abort.Panic:
                for index in 0..<fns.owners.count |fns, head, rest|:
                    fns.owners[index] return if qualified_owner_matches(fns.owners[index], head, rest)
                return null




            # The source-level spelling a type contributes to a mangled name. Must agree with
            # stage0's scheme (`identity__i64`), read from its emitted IR.
        def push_type_name(value_type: ValueType, storage: mutable darray[u8]&) -> void can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic, Memory.Allocate:
                # INJECTIVE over kinds, and it has to be. This named only the four scalar
                # families and spelled EVERY other kind "unknown" — which is not a cosmetic gap:
                # two instantiations differing only in an unnamed argument mangle to ONE symbol,
                # LLVM renames the second DEFINITION, and every CALL (emitted by name) binds to
                # the first. That is exactly the DictBucket heap corruption described under
                # push_generic_arg_name, which was closed for STRUCT arguments and left open for
                # every other non-scalar. MEASURED: the self-hosted object carried 29 `__unknown`
                # symbols (`arena_dict_put__unknown__i64`, `arena_dict_find_index__u64__unknown`,
                # …), so `dict[sview, i64]` and `dict[cstr, i64]` in one program would have
                # shared a body.
                #
                # `bits` is appended wherever it INDEXES a side table (struct/array/darray/view/
                # ref/optional/packed/enum/fn), because that index is the only thing separating
                # two types of the same kind. Every symbol mangled here is LOCAL (nm reports `t`),
                # so the spelling never has to agree with stage0's for anything to link.
                text: mutable sview = "unknown"
                indexed: mutable bool = false
                match value_type.kind:
                    TypeKind.Unmodeled:
                        pass
                    TypeKind.Bool:
                        text <- "bool"
                    TypeKind.Float:
                        text <- "f32" if value_type.bits == 32 else "f64"
                    TypeKind.Signed:
                        text <- "i8" if value_type.bits == 8 else ("i16" if value_type.bits == 16 else ("i32" if value_type.bits == 32 else "i64"))
                    TypeKind.Unsigned:
                        text <- "u8" if value_type.bits == 8 else ("u16" if value_type.bits == 16 else ("u32" if value_type.bits == 32 else "u64"))
                    TypeKind.Void:
                        text <- "void"
                    TypeKind.Struct:
                        text <- "st"
                        indexed <- true
                    TypeKind.Array:
                        text <- "arr"
                        indexed <- true
                    TypeKind.PackedEnum:
                        text <- "pe"
                        indexed <- true
                    TypeKind.PackedStore:
                        text <- "ps"
                        indexed <- true
                    TypeKind.Arena:
                        text <- "arena"
                    TypeKind.PayloadEnum:
                        text <- "en"
                        indexed <- true
                    TypeKind.CStr:
                        text <- "cstr"
                    TypeKind.Ref:
                        text <- "ref"
                        indexed <- true
                    TypeKind.Optional:
                        text <- "opt"
                        indexed <- true
                    TypeKind.ErrorUnion:
                        text <- "eu"
                        indexed <- true
                    TypeKind.DArray:
                        text <- "da"
                        indexed <- true
                    TypeKind.View:
                        text <- "vw"
                        indexed <- true
                    TypeKind.SView:
                        text <- "sview"
                    TypeKind.PyObject:
                        text <- "pyobj"
                    TypeKind.Fn:
                        text <- "fn"
                        indexed <- true
                    TypeKind.GuestCarrier:
                        text <- "gc"
                        indexed <- true
                    # A CONST-GENERIC value arg: `bits` holds the VALUE, so "n"+value spells it and
                    # keeps `InlineVec[i64, 4]` distinct from `[i64, 8]` (the whole point of mangling).
                    TypeKind.ConstUsize:
                        text <- "n"
                        indexed <- true
                for index in 0..<sview_len(text) |storage, text|:
                    storage.push(sview_at(text, index))
                append_usize_decimal(value_type.bits.usize(), storage) if indexed




            # One NESTING LEVEL of a struct type argument's name: the registered struct name
            # alone, no arguments of its own. Used for the args appended by
            # push_generic_arg_name, which is what stops that from having to recurse.
        def push_inst_arg_name(value_type: ValueType, structs: StructTable&, storage: mutable darray[u8]&) -> void can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic, Memory.Allocate:
                if value_type.kind == TypeKind.Struct:
                    inner_name: sview = structs.names[value_type.bits.usize()]
                    for index in 0..<sview_len(inner_name) |storage, inner_name|:
                        storage.push(sview_at(inner_name, index))
                    return
                push_type_name(value_type, storage)




            # Row in the generic-struct INSTANTIATION side table that produced struct
            # `struct_index`, or -1 for a plain (non-instantiated) struct.
        def generic_inst_row_of(structs: StructTable&, struct_index: usize) -> i64 can[Abort.Panic]:
            for row in 0..<structs.generic_struct_inst_index.count |structs, struct_index|:
                row.i64() return if structs.generic_struct_inst_index[row] == struct_index
            return -1




        # A type argument's contribution to a monomorphized name.
        #
        # This MUST be injective over struct arguments. It previously pushed only the
        # registered struct name, on the reasoning that LLVM uniquifies a duplicate named
        # struct anyway — but that is true of TYPES, not FUNCTIONS. A generic struct's
        # instantiations all register under their BASE name (codegen_struct_reg.elisa: the
        # full name goes to LLVMStructCreateNamed, `base` goes to structs.names), so
        # `DictBucket[u64, sview]` and `DictBucket[?, i64]` both rendered `DictBucket` and
        # every function mangled over them COLLIDED: LLVM renamed the second DEFINITION
        # (`@arena_da_fill__DictBucket.10995`) while every CALL, emitted by name, bound to
        # the first. A dict's bucket array was then filled at another instantiation's
        # STRIDE — the heap corruption that crashed the stage1-built semantic analyzer in
        # arena_dict_find_index.
        #
        # So append the instantiation's own type arguments. Depth one: the appended args
        # use push_inst_arg_name, which does not recurse.
        def push_generic_arg_name(value_type: ValueType, structs: StructTable&, storage: mutable darray[u8]&) -> void can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic, Memory.Allocate:
                # A const-enum-spelled scalar mangles under the ENUM's name (stage0:
                # `add__RoutineFlag`), not its backing width.
                if value_type.enum_id > 0 and (value_type.enum_id.usize() - 1.usize()) < structs.enum_names.count:
                    enum_spelling: sview = structs.enum_names[value_type.enum_id.usize() - 1.usize()]
                    for spelling_index in 0..<sview_len(enum_spelling) |storage, enum_spelling|:
                        storage.push(sview_at(enum_spelling, spelling_index))
                    return
                if value_type.kind == TypeKind.Struct:
                    struct_name: sview = structs.names[value_type.bits.usize()]
                    for index in 0..<sview_len(struct_name) |storage, struct_name|:
                        storage.push(sview_at(struct_name, index))
                    inst_row: i64 = generic_inst_row_of(structs, value_type.bits.usize())
                    return if inst_row < 0
                    arg_start: usize = structs.generic_struct_inst_arg_start[inst_row.usize()]
                    arg_count: usize = structs.generic_struct_inst_arg_count[inst_row.usize()]
                    # UNROLLED for the same reason as mangled_name_multi_into: growing `storage`
                    # through a nested call INSIDE a loop is not a region-inferable pattern.
                    append_inst_arg_at(structs, arg_start, arg_count, 0.usize(), storage)
                    append_inst_arg_at(structs, arg_start, arg_count, 1.usize(), storage)
                    append_inst_arg_at(structs, arg_start, arg_count, 2.usize(), storage)
                    append_inst_arg_at(structs, arg_start, arg_count, 3.usize(), storage)
                    return
                push_type_name(value_type, storage)




            # Append `__<argname>` for instantiation argument `position`. A no-op past the end,
            # so push_generic_arg_name can call it a fixed number of times.
        def append_inst_arg_at(structs: StructTable&, arg_start: usize, arg_count: usize, position: usize, storage: mutable darray[u8]&) -> void can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic, Memory.Allocate:
                return if position >= arg_count
                # ONE underscore. This is a NESTED instantiation argument — the `Vec[i32]`
                # inside `keep_left[Vec[i32]]` — which stage0 renders `Vec_i32`, giving the
                # whole symbol `keep_left__Vec_i32`. The DOUBLE underscore belongs to the
                # top-level separator in append_mangled_arg (`identity__i32`), and using it
                # here too produced `keep_left__Vec__i32`.
                storage.push(95)
                push_inst_arg_name(structs.generic_struct_inst_args[arg_start + position], structs, storage)




            # `arena_dict_put` + [i64, i64] -> "arena_dict_put__i64__i64". One `__ARG` per type
            # argument, so a two-parameter generic gets a distinct name per (K, T) tuple. Struct
            # arguments contribute their registered name (push_generic_arg_name).
            # Append `value` as ASCII decimal digits to `storage` (used to make an overloaded
            # instantiation's symbol name unique by its template slot).
        def append_usize_decimal(value: usize, storage: mutable darray[u8]&) -> void can[Abort.Panic, Memory.Allocate]:
            if value == 0.usize():
                storage.push(48)
                return
            digits: mutable darray[u8] = []
            remaining: mutable usize = value
            for _step in 0..<24 |digits, remaining|:
                break if remaining == 0.usize()
                digits.push((48.usize() + (remaining % 10.usize())).u8())
                remaining <- remaining / 10.usize()
            # digits are least-significant-first; append reversed.
            for reverse_index in 0..<digits.count |storage, digits|:
                storage.push(digits[digits.count - 1.usize() - reverse_index])




        # `slot_suffix >= 0` appends `__ov<slot>` before the terminator, disambiguating the LLVM
        # symbol for an OVERLOADED template (unique names pass -1 and keep their exact symbol).
        def mangled_name_multi_into(base: sview, type_args: darray[ValueType]&, slot_suffix: i64, structs: StructTable&, storage: mutable darray[u8]&) -> cstr can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate:
                for index in 0..<sview_len(base) |storage, base|:
                    storage.push(sview_at(base, index))
                # UNROLLED rather than a loop: growing `storage` through a nested call INSIDE a
                # loop is not a region-inferable pattern (the callee's growth site can't reach a
                # loop-carried region), so each arg is appended on a straight-line path. Four
                # covers every modeled generic (dict is two); a 5+-parameter generic would alias
                # names, which only costs readability since the instantiation memo is the key.
                append_mangled_arg(type_args, 0, structs, storage)
                append_mangled_arg(type_args, 1, structs, storage)
                append_mangled_arg(type_args, 2, structs, storage)
                append_mangled_arg(type_args, 3, structs, storage)
                if slot_suffix >= 0:
                    storage.push(95)
                    storage.push(95)
                    storage.push(111)
                    storage.push(118)
                    append_usize_decimal(slot_suffix.usize(), storage)
                storage.push(0)
                return (&storage[0]).cast[cstr] can Unsafe.PointerCast




            # Append `__<argname>` for type_args[position] when it exists. A no-op past the end,
            # so mangled_name_multi_into can call it a fixed number of times.
        def append_mangled_arg(type_args: darray[ValueType]&, position: usize, structs: StructTable&, storage: mutable darray[u8]&) -> void can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic, Memory.Allocate:
                return if position >= type_args.count
                storage.push(95)
                storage.push(95)
                push_generic_arg_name(type_args[position], structs, storage)
