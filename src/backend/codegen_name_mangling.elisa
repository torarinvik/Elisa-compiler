# Stage1 backend — the MANGLED LLVM symbol a monomorphized or overloaded declaration is emitted
# under: the source-level spelling each type argument contributes, the `__ov<slot>` overload
# suffix, and the qualified-owner lookups that resolve a written name to a registered one.
# Part of `module Backend` (see codegen.elisa).

extend Backend:
    private:


        # `candidate == head ++ "::" ++ tail`, without building the join.
        def qualified_owner_matches(candidate: sview, head: sview, rest: sview) -> bool can[Abort.Panic]:
            head_length: usize = head.len
            rest_length: usize = rest.len
            return false if:
                head_length == 0 or rest_length == 0
                candidate.len != head_length + 2.usize() + rest_length
            for index in 0..<head_length |candidate, head|:
                return false if candidate[index] != head[index]
            return false if:
                candidate[head_length] != 58
                candidate[head_length + 1.usize()] != 58
            for index in 0..<rest_length |candidate, rest, head_length|:
                return false if candidate[head_length + 2.usize() + index] != rest[index]
            return true




        # Whether one lexical module contains another. The empty module is file scope and
        # therefore an ancestor of every module.
        def module_alias_scope_is_ancestor(candidate: sview, module: sview) -> bool:
            return true if candidate == module or candidate == ""
            return false if candidate.len + 2.usize() >= module.len
            for index in 0..<candidate.len |candidate, module|:
                return false if candidate[index] != module[index]
            return module[candidate.len] == 58 and module[candidate.len + 1.usize()] == 58


        # Pick the nearest visible alias declaration before the queried source offset. The
        # scope and offset columns come directly from the parser's __using_alias annotation;
        # flattened alias order alone lets another module's same-named alias win.
        def module_alias_row_target(name: sview, lexical_module: sview, before_offset: u32, structs: StructTable&) -> (found: bool, ambiguous: bool, target: sview @source, scope: sview @source, offset: u32) can[Abort.Panic]:
            paired: mutable usize = structs.aliases.module_alias_names.count
            paired <- structs.aliases.module_alias_targets.count if structs.aliases.module_alias_targets.count < paired
            paired <- structs.aliases.module_alias_scopes.count if structs.aliases.module_alias_scopes.count < paired
            paired <- structs.aliases.module_alias_offsets.count if structs.aliases.module_alias_offsets.count < paired
            selected_target: mutable sview @source = ""
            selected_scope: mutable sview @source = ""
            selected_scope_length: mutable usize = 0
            selected_offset: mutable u32 = 0
            found: mutable bool = false
            ambiguous: mutable bool = false
            for index in 0..<paired |selected_target, selected_scope, selected_scope_length, selected_offset, found, ambiguous, structs, name, lexical_module, before_offset|:
                continue if structs.aliases.module_alias_names[index] != name
                alias_offset: u32 = structs.aliases.module_alias_offsets[index]
                continue if before_offset != 0 and alias_offset >= before_offset
                alias_scope: sview = structs.aliases.module_alias_scopes[index]
                continue if not module_alias_scope_is_ancestor(alias_scope, lexical_module)
                alias_target: sview = structs.aliases.module_alias_targets[index]
                if not found or alias_scope.len > selected_scope_length or (alias_scope == selected_scope and alias_offset > selected_offset):
                    selected_target <- alias_target
                    selected_scope <- alias_scope
                    selected_scope_length <- alias_scope.len
                    selected_offset <- alias_offset
                    found <- true
                    ambiguous <- false
                elif alias_scope == selected_scope and alias_offset == selected_offset:
                    ambiguous <- true if alias_target != selected_target
            return (found, ambiguous, selected_target, selected_scope, selected_offset)


        # Compare one spelling of a module-path suffix with a canonical `::` path prefix.
        # The source spelling can use either `.` or `::` between module components.
        def module_alias_path_compare_prefix(path: sview, path_start: usize, owner: sview, owner_start: usize) -> (matched: bool, end: usize) can[Abort.Panic]:
            path_index: mutable usize = path_start
            owner_index: mutable usize = owner_start
            while path_index < path.len |path_index, owner_index, path, owner|:
                if path[path_index] == 46:
                    return (false, owner_index) if owner_index + 1.usize() >= owner.len or owner[owner_index] != 58 or owner[owner_index + 1.usize()] != 58
                    path_index <- path_index + 1.usize()
                    owner_index <- owner_index + 2.usize()
                elif path_index + 1.usize() < path.len and path[path_index] == 58 and path[path_index + 1.usize()] == 58:
                    return (false, owner_index) if owner_index + 1.usize() >= owner.len or owner[owner_index] != 58 or owner[owner_index + 1.usize()] != 58
                    path_index <- path_index + 2.usize()
                    owner_index <- owner_index + 2.usize()
                else:
                    return (false, owner_index) if owner_index >= owner.len or path[path_index] != owner[owner_index]
                    path_index <- path_index + 1.usize()
                    owner_index <- owner_index + 1.usize()
            return (true, owner_index)


        # Resolve aliases recursively in the path head while matching against a canonical
        # owner. This handles `using Root::Nested as N` even when `Root` is itself an alias.
        def module_alias_path_prefix_end(path: sview, owner: sview, lexical_module: sview, before_offset: u32, structs: StructTable&, depth: u32 = 0) -> (matched: bool, end: usize) can[Abort.Panic]:
            return (false, 0) if depth >= 16
            root_end: mutable usize = 0
            while root_end < path.len |root_end, path|:
                break if path[root_end] == 58 or path[root_end] == 46
                root_end <- root_end + 1.usize()
            return (false, 0) if root_end == 0
            root: sview = string_view_slice(path, 0, root_end.i64())
            alias: (found: bool, ambiguous: bool, target: sview @source, scope: sview @source, offset: u32) = module_alias_row_target(root, lexical_module, before_offset, structs)
            return (false, 0) if alias.ambiguous
            return module_alias_path_compare_prefix(path, 0, owner, 0) if not alias.found
            target_prefix: (matched: bool, end: usize) = module_alias_path_prefix_end(alias.target, owner, alias.scope, alias.offset, structs, depth + 1)
            return (false, 0) if not target_prefix.matched
            return module_alias_path_compare_prefix(path, root_end, owner, target_prefix.end)


        def module_alias_path_matches_owner(path: sview, owner: sview, lexical_module: sview, before_offset: u32, structs: StructTable&) -> bool can[Abort.Panic]:
            resolved: (matched: bool, end: usize) = module_alias_path_prefix_end(path, owner, lexical_module, before_offset, structs)
            return resolved.matched and resolved.end == owner.len


        # Append a qualified module path after recursively expanding its root alias. Alias
        # targets can themselves contain a path (`using Root::Nested as N`), and Root may be
        # another source-scoped alias. Keep lookup at each hop anchored to that alias's
        # declaration scope and offset so a later shadow cannot affect an earlier target.
        def append_module_alias_path(path: sview, lexical_module: sview, before_offset: u32, structs: StructTable&, storage: mutable darray[u8]&, depth: u32 = 0) -> bool can[Abort.Panic, Memory.Allocate]:
            return false if depth >= 16
            root_end: mutable usize = 0
            while root_end < path.len |root_end, path|:
                break if path[root_end] == 58 or path[root_end] == 46
                root_end <- root_end + 1.usize()
            return false if root_end == 0
            root: sview = string_view_slice(path, 0, root_end.i64())
            alias: (found: bool, ambiguous: bool, target: sview @source, scope: sview @source, offset: u32) = module_alias_row_target(root, lexical_module, before_offset, structs)
            return false if alias.ambiguous
            if alias.found:
                return false if not append_module_alias_path(alias.target, alias.scope, alias.offset, structs, storage, depth + 1)
            else:
                for index in 0..<root_end |storage, path|:
                    storage.push(path[index])
            path_index: mutable usize = root_end
            while path_index < path.len |path_index, storage, path|:
                if path[path_index] == 46:
                    storage.push(58)
                    storage.push(58)
                    path_index <- path_index + 1.usize()
                elif path_index + 1.usize() < path.len and path[path_index] == 58 and path[path_index + 1.usize()] == 58:
                    storage.push(58)
                    storage.push(58)
                    path_index <- path_index + 2.usize()
                else:
                    storage.push(path[path_index])
                    path_index <- path_index + 1.usize()
            return true


        # The module a `using Mod as M` alias stands for, or the name unchanged when it is not
        # an alias. Source-backed expressions (defaults in particular) use scoped rows;
        # callers without a source offset retain the established first-match lookup.
        def module_alias_target(name: sview, structs: StructTable&) -> sview can[Abort.Panic]:
            is_alias: mutable bool = false
            target: sview = module_alias_chain_target(name, structs, is_alias)
            return target if is_alias else name

        # The registered (program-lived) module the alias chain starting at `name` ends at;
        # `is_alias` is false, and the result "", when `name` is not an alias. A malformed
        # cycle that never settles also yields "". Returning only table rows keeps the result
        # `@source` whatever region `name` lives in.
        def module_alias_chain_target(name: sview, structs: StructTable&, is_alias: mutable bool&) -> sview @source can[Abort.Panic]:
            hopped: mutable bool = false
            target: mutable sview @source = ""
            if structs.visibility.current_source_offset != 0:
                lookup_name: mutable sview = name
                lexical_module: mutable sview = structs.visibility.current_owner
                before_offset: mutable u32 = structs.visibility.current_source_offset
                for step in 0..=structs.aliases.module_alias_names.count |lookup_name, lexical_module, before_offset, target, hopped, is_alias, structs|:
                    selected: (found: bool, ambiguous: bool, target: sview @source, scope: sview @source, offset: u32) = module_alias_row_target(lookup_name, lexical_module, before_offset, structs)
                    if selected.ambiguous:
                        is_alias <- true
                        return sview("", 0, 0)
                    if not selected.found:
                        is_alias <- hopped
                        return target
                    target <- selected.target
                    lexical_module <- selected.scope
                    before_offset <- selected.offset
                    lookup_name <- target
                    hopped <- true
                    is_alias <- true
                return sview("", 0, 0)
            # Each step follows a recorded alias. Bound traversal by the row count
            # so malformed cycles cannot hang or select an unrelated declaration.
            for step in 0..=structs.aliases.module_alias_names.count |structs, target, hopped, is_alias|:
                found: mutable bool = false
                for index in 0..<structs.aliases.module_alias_names.count |structs, target, found, hopped|:
                    continue if index >= structs.aliases.module_alias_targets.count
                    matches: bool = (structs.aliases.module_alias_names[index] == target) if hopped else (structs.aliases.module_alias_names[index] == name)
                    if matches:
                        target <- structs.aliases.module_alias_targets[index]
                        hopped <- true
                        found <- true
                        break
                if not found:
                    is_alias <- hopped
                    return target
            is_alias <- hopped
            return sview("", 0, 0)




        # The REGISTERED owner sview for a two-part module path `head::tail`, or null.
        # Returning the recorded sview (rather than a freshly joined one) is what lets the
        # ordinary FnTable lookups compare it by content with no allocation anywhere.
        def qualified_owner_of(fns: FnTable&, head: sview, rest: sview) -> sview? can[Abort.Panic]:
            can Abort.Panic:
                for index in 0..<fns.owners.count |fns, head, rest|:
                    return fns.owners[index] if qualified_owner_matches(fns.owners[index], head, rest)
                return null




        # Append a module path from the head of an Expr.Scope (`M` in `M::f`, or
        # `A::B` in `A::B::f`) to a byte buffer. Module aliases apply only to the root.
        # Building the path locally avoids storing transient sviews in either symbol table.
        def append_scope_owner_path(head: Expr, structs: StructTable&, storage: mutable darray[u8]&) -> bool can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic, Memory.Allocate:
                match head:
                    Expr.Ident(root_name, _):
                        source_offset: mutable u32 = Ast::expr_pos(head).offset
                        source_offset <- structs.visibility.current_source_offset if source_offset == 0
                        if source_offset != 0:
                            return append_module_alias_path(root_name, structs.visibility.current_owner, source_offset, structs, storage)
                        root_owner: sview = module_alias_target(root_name, structs)
                        for root_index in 0..<root_owner.len |root_owner, storage|:
                            storage.push(root_owner[root_index])
                        return true
                    Expr.Scope(parent, member, _):
                        return false if not append_scope_owner_path(parent, structs, storage)
                        storage.push(58)
                        storage.push(58)
                        for member_index in 0..<member.len |member, storage|:
                            storage.push(member[member_index])
                        return true
                    _:
                        return false




        # Resolve a generic named by a qualified scope, preserving ordinary module lookup
        # precedence. The direct qualified owner wins first. Only when that owner has no
        # function by this name may a short path inside a module resolve relative to the
        # current module (e.g. `Inner::f` from `Outer` means `Outer::Inner::f`).
        def generic_index_of_scoped_member(generics: GenericTable&, fns: FnTable&, structs: StructTable&, head: Expr, member: sview) -> i64 can[Abort.Panic, Memory.Allocate]:
            path_storage: mutable darray[u8] = []
            return -1 if not append_scope_owner_path(head, structs, path_storage) or path_storage.count == 0
            path_owner: sview = bytes_view_range(path_storage, 0, path_storage.count)
            direct_slot: i64 = generic_index_of_owner(generics, path_owner, member)
            return direct_slot if direct_slot >= 0
            return -1 if function_index_of(fns, path_owner, member) >= 0 or structs.visibility.current_owner == ""
            relative_storage: mutable darray[u8] = []
            for current_index in 0..<structs.visibility.current_owner.len |structs, relative_storage|:
                relative_storage.push(structs.visibility.current_owner[current_index])
            relative_storage.push(58)
            relative_storage.push(58)
            for path_index in 0..<path_storage.count |path_storage, relative_storage|:
                relative_storage.push(path_storage[path_index])
            relative_owner: sview = bytes_view_range(relative_storage, 0, relative_storage.count)
            return generic_index_of_owner(generics, relative_owner, member)




            # The source-level spelling a type contributes to a mangled name. Must agree with
            # stage0's scheme (`identity__i64`), read from its emitted IR.
        def push_type_name(value_type: ValueType, storage: mutable darray[u8]&) -> void can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic, Memory.Allocate:
                # INJECTIVE over kinds, and it has to be. This named only the four scalar
                # families and spelled EVERY other kind "unknown" — which is not a cosmetic gap:
                # two instantiations differing only in an unnamed argument mangle to ONE symbol,
                # LLVM renames the second DEFINITION, and every CALL (emitted by name) binds to
                # the first. That is exactly the DictBucket heap corruption described under
                # push_generic_arg_name, which was closed for STRUCT arguments and left open for
                # every other non-scalar. MEASURED: the self-hosted object carried 29 `__unknown`
                # symbols (`arena_dict_put__unknown__i64`, `arena_dict_find_index__u64__unknown`,
                # …), so `dict[sview, i64]` and `dict[cstr, i64]` in one program would have
                # shared a body.
                #
                # `bits` is appended wherever it INDEXES a side table (struct/array/darray/view/
                # ref/optional/packed/enum/fn), because that index is the only thing separating
                # two types of the same kind. Every symbol mangled here is LOCAL (nm reports `t`),
                # so the spelling never has to agree with stage0's for anything to link.
                text: mutable sview = "unknown"
                indexed: mutable bool = false
                match value_type.kind:
                    TypeKind.Unmodeled:
                        text <- builtin_state_marker_name(value_type.bits)
                    TypeKind.Bool:
                        text <- "bool"
                    TypeKind.Float:
                        text <- "f32" if value_type.bits == 32 else "f64"
                    TypeKind.Signed:
                        text <- "i8" if value_type.bits == 8 else ("i16" if value_type.bits == 16 else ("i32" if value_type.bits == 32 else "i64"))
                    TypeKind.Unsigned:
                        text <- "u8" if value_type.bits == 8 else ("u16" if value_type.bits == 16 else ("u32" if value_type.bits == 32 else "u64"))
                    TypeKind.Void:
                        text <- "void"
                    TypeKind.Struct:
                        text <- "st"
                        indexed <- true
                    TypeKind.Array:
                        text <- "arr"
                        indexed <- true
                    TypeKind.PackedEnum:
                        text <- "pe"
                        indexed <- true
                    TypeKind.PackedStore:
                        text <- "ps"
                        indexed <- true
                    TypeKind.Arena:
                        text <- "arena"
                    TypeKind.PayloadEnum:
                        text <- "en"
                        indexed <- true
                    TypeKind.CStr:
                        text <- "cstr"
                    TypeKind.Ref:
                        text <- "ref"
                        indexed <- true
                    TypeKind.Optional:
                        text <- "opt"
                        indexed <- true
                    TypeKind.ErrorUnion:
                        text <- "eu"
                        indexed <- true
                    TypeKind.DArray:
                        text <- "da"
                        indexed <- true
                    TypeKind.View:
                        text <- "vw"
                        indexed <- true
                    TypeKind.SView:
                        text <- "sview"
                    TypeKind.PyObject:
                        text <- "pyobj"
                    TypeKind.Fn:
                        text <- "fn"
                        indexed <- true
                    TypeKind.GuestCarrier:
                        text <- "gc"
                        indexed <- true
                    # A CONST-GENERIC value arg: `bits` holds the VALUE, so "n"+value spells it and
                    # keeps `InlineVec[i64, 4]` distinct from `[i64, 8]` (the whole point of mangling).
                    TypeKind.ConstUsize:
                        text <- "n"
                        indexed <- true
                for index in 0..<text.len |storage, text|:
                    storage.push(text[index])
                append_usize_decimal(value_type.bits.usize(), storage) if indexed




            # One NESTING LEVEL of a struct type argument's name: the registered struct name
            # alone, no arguments of its own. Used for the args appended by
            # push_generic_arg_name, which is what stops that from having to recurse.
        def push_inst_arg_name(value_type: ValueType, structs: StructTable&, storage: mutable darray[u8]&) -> void can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic, Memory.Allocate:
                if value_type.kind == TypeKind.Struct:
                    inner_name: sview = structs.records.names[value_type.bits.usize()]
                    for index in 0..<inner_name.len |storage, inner_name|:
                        storage.push(inner_name[index])
                    return
                push_type_name(value_type, storage)




            # Row in the generic-struct INSTANTIATION side table that produced struct
            # `struct_index`, or -1 for a plain (non-instantiated) struct.
        def generic_inst_row_of(structs: StructTable&, struct_index: usize) -> i64 can[Abort.Panic]:
            row: mutable usize = generic_inst_first_row(structs, struct_index)
            while row < structs.generics.generic_struct_inst_index.count |row, structs, struct_index|:
                return row.i64() if structs.generics.generic_struct_inst_index[row] == struct_index
                row <- generic_inst_next_row(structs, row)
            return -1




        # A type argument's contribution to a monomorphized name.
        #
        # This MUST be injective over struct arguments. It previously pushed only the
        # registered struct name, on the reasoning that LLVM uniquifies a duplicate named
        # struct anyway — but that is true of TYPES, not FUNCTIONS. A generic struct's
        # instantiations all register under their BASE name (codegen_struct_reg.elisa: the
        # full name goes to LLVMStructCreateNamed, `base` goes to structs.records.names), so
        # `DictBucket[u64, sview]` and `DictBucket[?, i64]` both rendered `DictBucket` and
        # every function mangled over them COLLIDED: LLVM renamed the second DEFINITION
        # (`@arena_da_fill__DictBucket.10995`) while every CALL, emitted by name, bound to
        # the first. A dict's bucket array was then filled at another instantiation's
        # STRIDE — the heap corruption that crashed the stage1-built semantic analyzer in
        # arena_dict_find_index.
        #
        # So append the instantiation's own type arguments. Depth one: the appended args
        # use push_inst_arg_name, which does not recurse.
        def push_generic_arg_name(value_type: ValueType, structs: StructTable&, storage: mutable darray[u8]&) -> void can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic, Memory.Allocate:
                # A const-enum-spelled scalar mangles under the ENUM's name (stage0:
                # `add__RoutineFlag`), not its backing width.
                if value_type.enum_id > 0 and (value_type.enum_id.usize() - 1.usize()) < structs.const_enums.enum_names.count:
                    enum_spelling: sview = structs.const_enums.enum_names[value_type.enum_id.usize() - 1.usize()]
                    for spelling_index in 0..<enum_spelling.len |storage, enum_spelling|:
                        storage.push(enum_spelling[spelling_index])
                    return
                if value_type.kind == TypeKind.Struct:
                    struct_name: sview = structs.records.names[value_type.bits.usize()]
                    for index in 0..<struct_name.len |storage, struct_name|:
                        storage.push(struct_name[index])
                    inst_row: i64 = generic_inst_row_of(structs, value_type.bits.usize())
                    return if inst_row < 0
                    arg_start: usize = structs.generics.generic_struct_inst_arg_start[inst_row.usize()]
                    arg_count: usize = structs.generics.generic_struct_inst_arg_count[inst_row.usize()]
                    # UNROLLED for the same reason as mangled_name_multi_into: growing `storage`
                    # through a nested call INSIDE a loop is not a region-inferable pattern.
                    append_inst_arg_at(structs, arg_start, arg_count, 0.usize(), storage)
                    append_inst_arg_at(structs, arg_start, arg_count, 1.usize(), storage)
                    append_inst_arg_at(structs, arg_start, arg_count, 2.usize(), storage)
                    append_inst_arg_at(structs, arg_start, arg_count, 3.usize(), storage)
                    return
                push_type_name(value_type, storage)




            # Append `__<argname>` for instantiation argument `position`. A no-op past the end,
            # so push_generic_arg_name can call it a fixed number of times.
        def append_inst_arg_at(structs: StructTable&, arg_start: usize, arg_count: usize, position: usize, storage: mutable darray[u8]&) -> void can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic, Memory.Allocate:
                return if position >= arg_count
                # ONE underscore. This is a NESTED instantiation argument — the `Vec[i32]`
                # inside `keep_left[Vec[i32]]` — which stage0 renders `Vec_i32`, giving the
                # whole symbol `keep_left__Vec_i32`. The DOUBLE underscore belongs to the
                # top-level separator in append_mangled_arg (`identity__i32`), and using it
                # here too produced `keep_left__Vec__i32`.
                storage.push(95)
                push_inst_arg_name(structs.generics.generic_struct_inst_args[arg_start + position], structs, storage)




            # `arena_dict_put` + [i64, i64] -> "arena_dict_put__i64__i64". One `__ARG` per type
            # argument, so a two-parameter generic gets a distinct name per (K, T) tuple. Struct
            # arguments contribute their registered name (push_generic_arg_name).
            # Append `value` as ASCII decimal digits to `storage` (used to make an overloaded
            # instantiation's symbol name unique by its template slot).
        def append_usize_decimal(value: usize, storage: mutable darray[u8]&) -> void can[Abort.Panic, Memory.Allocate]:
            if value == 0.usize():
                storage.push(48)
                return
            digits: mutable darray[u8] = []
            remaining: mutable usize = value
            for _step in 0..<24 |digits, remaining|:
                break if remaining == 0.usize()
                digits.push((48.usize() + (remaining % 10.usize())).u8())
                remaining <- remaining / 10.usize()
            # digits are least-significant-first; append reversed.
            for reverse_index in 0..<digits.count |storage, digits|:
                storage.push(digits[digits.count - 1.usize() - reverse_index])




        # `slot_suffix >= 0` appends `__ov<slot>` before the terminator, disambiguating the LLVM
        # symbol for an OVERLOADED template (unique names pass -1 and keep their exact symbol).
        def mangled_name_multi_into(base: sview, type_args: darray[ValueType]&, slot_suffix: i64, structs: StructTable&, storage: mutable darray[u8]&) -> cstr can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate:
                for index in 0..<base.len |storage, base|:
                    storage.push(base[index])
                # UNROLLED rather than a loop: growing `storage` through a nested call INSIDE a
                # loop is not a region-inferable pattern (the callee's growth site can't reach a
                # loop-carried region), so each arg is appended on a straight-line path. Four
                # covers every modeled generic (dict is two); a 5+-parameter generic would alias
                # names, which only costs readability since the instantiation memo is the key.
                append_mangled_arg(type_args, 0, structs, storage)
                append_mangled_arg(type_args, 1, structs, storage)
                append_mangled_arg(type_args, 2, structs, storage)
                append_mangled_arg(type_args, 3, structs, storage)
                if slot_suffix >= 0:
                    storage.push(95)
                    storage.push(95)
                    storage.push(111)
                    storage.push(118)
                    append_usize_decimal(slot_suffix.usize(), storage)
                storage.push(0)
                return (&storage[0]).cast[cstr] can Unsafe.PointerCast




            # Append `__<argname>` for type_args[position] when it exists. A no-op past the end,
            # so mangled_name_multi_into can call it a fixed number of times.
        def append_mangled_arg(type_args: darray[ValueType]&, position: usize, structs: StructTable&, storage: mutable darray[u8]&) -> void can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic, Memory.Allocate:
                return if position >= type_args.count
                storage.push(95)
                storage.push(95)
                push_generic_arg_name(type_args[position], structs, storage)
