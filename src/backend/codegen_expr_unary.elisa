# Stage1 backend — PARENTHESES and UNARY operators: `-x`, `not x`, `&x`, a dereference, and the
# overloaded `__neg__` a struct can supply. Reached from codegen_expr_idents_binary.elisa;
# `handled` keeps the original try order.
# Part of `module Backend` (see codegen.elisa).

extend Backend:
    private:
        def emit_expression_unary(expression: Expr, expected: ValueType, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef, handled: mutable bool&) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            if expression is Expr.Paren(paren_inner, paren_line):
                return emit_expression(paren_inner, expected, local_scope, fns, structs, generics, runtime, m, ctx, builder)
            if expression is Expr.Unary(unary_operator, unary_operand, unary_line):
                # `&lvalue` — the ADDRESS of a local, a field chain, or an indexed element,
                # yielded as a `T&` (a raw ptr in LLVM). A bare local IS its own slot; any
                # deeper place (`&b.value`, `&xs[i].field`) GEPs through struct_chain_address.
                if unary_operator == TokenKind.Ampersand:
                    # C pointer arithmetic is sometimes projected by the translator as
                    # `&(table[0][0])[offset]`: the prefix `&` applies to an indexed
                    # scalar place, where the final index is an offset from the scalar's
                    # address. Lower this C-shaped form directly as a one-index GEP from
                    # the address of the inner scalar place.
                    match unary_operand:
                        Expr.Index(pointer_arithmetic_base, pointer_arithmetic_offset, _):
                            pointer_arithmetic_base_type: ValueType = expression_type(pointer_arithmetic_base, local_scope, fns, structs, generics)
                            if pointer_arithmetic_base_type.kind != TypeKind.Unmodeled and pointer_arithmetic_base_type.kind != TypeKind.Array and pointer_arithmetic_base_type.kind != TypeKind.DArray and pointer_arithmetic_base_type.kind != TypeKind.View:
                                # A reference identifier is a POINTER VALUE in this form, not
                                # the address of the local slot that stores that pointer. The
                                # generic place probe below intentionally returns the slot
                                # address for `&local`; using it here makes LLVMBuildGEP2 index
                                # the reference slot itself (8-byte pointer stride) instead of
                                # the referenced element (for example 4-byte i32 stride).
                                # C pointer arithmetic must evaluate the base expression first
                                # and GEP using its referent type. Nullable C pointers use the
                                # same niche representation as their `T&` payload, so unwrap
                                # the payload before forming the GEP.
                                # A ref whose TARGET is a container is not C pointer arithmetic:
                                # `storage[i]` on `storage: mutable darray[u8]&` indexes the
                                # container's elements through its header, which the generic
                                # place path below already does. Taking the raw-GEP form here
                                # strides over the HEADER type and hands out the header address
                                # itself — every name the backend built through sview_to_cstr
                                # came back as the data-pointer bytes.
                                pointer_arithmetic_pointee: mutable ValueType = unmodeled_type()
                                pointer_arithmetic_is_optional: bool = pointer_arithmetic_base_type.kind == TypeKind.Optional
                                if pointer_arithmetic_base_type.kind == TypeKind.Ref:
                                    pointer_arithmetic_ref_target: ValueType = ref_target_of(pointer_arithmetic_base_type, structs)
                                    pointer_arithmetic_pointee <- pointer_arithmetic_ref_target if pointer_arithmetic_ref_target.kind != TypeKind.DArray and pointer_arithmetic_ref_target.kind != TypeKind.Array and pointer_arithmetic_ref_target.kind != TypeKind.View
                                elif pointer_arithmetic_base_type.kind == TypeKind.CStr:
                                    pointer_arithmetic_pointee <- ValueType{kind: TypeKind.Unsigned, bits: 8}
                                elif pointer_arithmetic_is_optional:
                                    pointer_arithmetic_optional_payload: ValueType = optional_payload_of(pointer_arithmetic_base_type, structs)
                                    if pointer_arithmetic_optional_payload.kind == TypeKind.Ref:
                                        pointer_arithmetic_optional_target: ValueType = ref_target_of(pointer_arithmetic_optional_payload, structs)
                                        pointer_arithmetic_pointee <- pointer_arithmetic_optional_target if pointer_arithmetic_optional_target.kind != TypeKind.DArray and pointer_arithmetic_optional_target.kind != TypeKind.Array and pointer_arithmetic_optional_target.kind != TypeKind.View
                                    elif pointer_arithmetic_optional_payload.kind == TypeKind.CStr:
                                        pointer_arithmetic_pointee <- ValueType{kind: TypeKind.Unsigned, bits: 8}
                                if pointer_arithmetic_pointee.kind != TypeKind.Unmodeled:
                                    if emit_expression(pointer_arithmetic_base, pointer_arithmetic_base_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is pointer_arithmetic_emitted:
                                        pointer_arithmetic_value: mutable LLVMValueRef = pointer_arithmetic_emitted
                                        if pointer_arithmetic_is_optional:
                                            pointer_arithmetic_value <- optional_payload_value_of(pointer_arithmetic_value, pointer_arithmetic_base_type, structs, ctx, builder)
                                        if emit_expression(pointer_arithmetic_offset, ValueType{kind: TypeKind.Signed, bits: 64}, local_scope, fns, structs, generics, runtime, m, ctx, builder) is pointer_arithmetic_direct_index:
                                            pointer_arithmetic_direct_indices: mutable darray[LLVMValueRef] = [pointer_arithmetic_direct_index]
                                            pointer_arithmetic_direct_indices_pointer: void& = (&pointer_arithmetic_direct_indices[0]).cast[void&] can Unsafe.PointerCast
                                            return LLVMBuildGEP2(builder, llvm_type_of(pointer_arithmetic_pointee, structs, ctx), pointer_arithmetic_value, pointer_arithmetic_direct_indices_pointer, 1, "pointer.arithmetic.ref.ptr")
                                if struct_chain_address(pointer_arithmetic_base, local_scope, fns, structs, generics, runtime, m, ctx, builder) is pointer_arithmetic_address:
                                    if emit_expression(pointer_arithmetic_offset, ValueType{kind: TypeKind.Signed, bits: 64}, local_scope, fns, structs, generics, runtime, m, ctx, builder) is pointer_arithmetic_index:
                                        pointer_arithmetic_indices: mutable darray[LLVMValueRef] = [pointer_arithmetic_index]
                                        pointer_arithmetic_indices_pointer: void& = (&pointer_arithmetic_indices[0]).cast[void&] can Unsafe.PointerCast
                                        return LLVMBuildGEP2(builder, llvm_type_of(pointer_arithmetic_base_type, structs, ctx), pointer_arithmetic_address, pointer_arithmetic_indices_pointer, 1, "pointer.arithmetic.ptr")
                                # The base can itself be a pointer-valued rvalue, for example
                                # `&(&p[-1])[-64]`. It has no place address for
                                # `struct_chain_address` to discover: the inner `&` already
                                # produced the pointer value. Evaluate that base directly and
                                # GEP using its pointee type. This is the general C pointer
                                # arithmetic case, independent of the source program.
                                if pointer_arithmetic_base_type.kind == TypeKind.Ref:
                                    pointer_arithmetic_pointee: ValueType = ref_target_of(pointer_arithmetic_base_type, structs)
                                    if pointer_arithmetic_pointee.kind != TypeKind.Unmodeled and pointer_arithmetic_pointee.kind != TypeKind.Array and pointer_arithmetic_pointee.kind != TypeKind.DArray and pointer_arithmetic_pointee.kind != TypeKind.View:
                                        if emit_expression(pointer_arithmetic_base, pointer_arithmetic_base_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is pointer_arithmetic_value:
                                            if emit_expression(pointer_arithmetic_offset, ValueType{kind: TypeKind.Signed, bits: 64}, local_scope, fns, structs, generics, runtime, m, ctx, builder) is pointer_arithmetic_index_value:
                                                pointer_arithmetic_value_indices: mutable darray[LLVMValueRef] = [pointer_arithmetic_index_value]
                                                pointer_arithmetic_value_indices_pointer: void& = (&pointer_arithmetic_value_indices[0]).cast[void&] can Unsafe.PointerCast
                                                return LLVMBuildGEP2(builder, llvm_type_of(pointer_arithmetic_pointee, structs, ctx), pointer_arithmetic_value, pointer_arithmetic_value_indices_pointer, 1, "pointer.arithmetic.rvalue.ptr")
                        _:
                            pass
                    match unary_operand:
                        Expr.Ident(addr_name, _):
                            if lookup_slot(local_scope, addr_name) is addr_slot:
                                return addr_slot
                            # A mutable global is already represented by its LLVM global
                            # address; taking `&global` must return that handle directly.
                            return struct_address_of(addr_name, local_scope, structs, ctx, builder)
                        _:
                            pass
                    return struct_chain_address(unary_operand, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                # `!x` is the ID-UNWRAP operator, NOT boolean not — stage0 rejects `!x` on
                # anything but an `id[T]` ("id unwrap operator requires id[T] operand, got
                # i64"). Since `id[T]` erases to its u32 backing, the unwrap is the value
                # itself. Treating Bang as `not` made every id-unwrap emit an i1 xor.
                if unary_operator == TokenKind.Bang:
                    unwrap_type: ValueType = expression_type(unary_operand, local_scope, fns, structs, generics)
                    null return if unwrap_type.kind != TypeKind.Unsigned
                    if emit_expression(unary_operand, unwrap_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is unwrapped:
                        return emit_conversion(unwrapped, unwrap_type, expected, structs, ctx, builder) if expected.kind != TypeKind.Unmodeled and (expected.kind != unwrap_type.kind or expected.bits != unwrap_type.bits) else unwrapped
                    return null
                # `not x` needs a bool operand, not `expected` (which is itself bool).
                if unary_operator == TokenKind.Not:
                    bool_type_n: ValueType = ValueType{kind: TypeKind.Bool, bits: 1}
                    if emit_expression(unary_operand, bool_type_n, local_scope, fns, structs, generics, runtime, m, ctx, builder) is bool_operand:
                        # `not` on an i1 is XOR with 1.
                        return LLVMBuildXor(builder, bool_operand, LLVMConstInt(LLVMInt1TypeInContext(ctx), 1, 0), "not")
                    return null
                operand_type: ValueType = resolve_type(unary_operand, expected, local_scope, fns, structs, generics)
                # STRUCT operand with a matching `impl Neg for T` — same rewrite-to-method-
                # call approach as the binary struct-protocol operators (codegen_expr_binary_
                # tail.elisa): `-a` becomes `a.__neg__()`, reusing the existing, already-
                # correct UFCS/impl-method call machinery.
                if operand_type.kind == TypeKind.Struct and unary_operator == TokenKind.Minus:
                    struct_neg_call: Expr = Expr.Call(Expr.Field(unary_operand, "__neg__", unary_line), [], [], unary_line)
                    if emit_expression(struct_neg_call, expected, local_scope, fns, structs, generics, runtime, m, ctx, builder) is struct_neg_value:
                        return struct_neg_value
                    return null
                null return if not is_numeric_type(operand_type)
                if emit_expression(unary_operand, operand_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is operand:
                    operand return if unary_operator == TokenKind.Plus
                    if unary_operator == TokenKind.Minus:
                        # `-x` on a float is fneg; `~x` has no float form.
                        return finish_float_instruction(LLVMBuildFNeg(builder, operand, "fneg"), runtime.fast_math) if operand_type.kind == TypeKind.Float else LLVMBuildNeg(builder, operand, "neg")
                    if unary_operator == TokenKind.Tilde:
                        null return if operand_type.kind == TypeKind.Float
                        return LLVMBuildNot(builder, operand, "bnot")
                return null
            # `opt == null` / `opt != null` — a PRESENCE test against the optional's tag
            # (field 0), whichever side is the `null` literal. The std dict guards on
            # `m.items == null` this way. Distinct from `is` narrowing: no binding.
            return emit_expression_optional_binary(expression, expected, local_scope, fns, structs, generics, runtime, m, ctx, builder, handled)
