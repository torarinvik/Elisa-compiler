# Native consumer for the shared typed scalar IR.

extend Backend:
    private:
        const SIGNED_I64_CONSTANT: i32 = 1


        def emit_core_i64_program(program: ElisaCoreIR::Program, fn: LLVMValueRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> void:
            entry: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, fn, "entry")
            LLVMPositionBuilderAtEnd(builder, entry)
            LLVMSetCurrentDebugLocation2(builder, null)
            local_slot: mutable LLVMValueRef = zeroed
            if program.has_local:
                local_slot <- LLVMBuildAlloca(builder, LLVMInt64TypeInContext(ctx), "core.local.slot")
                initializer: LLVMValueRef = LLVMConstInt(LLVMInt64TypeInContext(ctx), program.local_value.u64(), SIGNED_I64_CONSTANT)
                _ = LLVMBuildStore(builder, initializer, local_slot)
            if not program.has_binary_operator:
                value: mutable LLVMValueRef = LLVMConstInt(LLVMInt64TypeInContext(ctx), program.left.u64(), SIGNED_I64_CONSTANT)
                value <- LLVMBuildLoad2(builder, LLVMInt64TypeInContext(ctx), local_slot, "core.local") if program.has_local
                _ = LLVMBuildRet(builder, value)
                return
            left_value: mutable LLVMValueRef = LLVMConstInt(LLVMInt64TypeInContext(ctx), program.left.u64(), SIGNED_I64_CONSTANT)
            left_value <- LLVMBuildLoad2(builder, LLVMInt64TypeInContext(ctx), local_slot, "core.local") if program.has_local
            right_value: LLVMValueRef = LLVMConstInt(LLVMInt64TypeInContext(ctx), program.right.u64(), SIGNED_I64_CONSTANT)
            result: mutable LLVMValueRef = zeroed
            result <- LLVMBuildAdd(builder, left_value, right_value, "core.add") if program.operator == ElisaCoreIR::I64BinaryOperator.Add
            result <- LLVMBuildSub(builder, left_value, right_value, "core.subtract") if program.operator == ElisaCoreIR::I64BinaryOperator.Subtract
            result <- LLVMBuildMul(builder, left_value, right_value, "core.multiply") if program.operator == ElisaCoreIR::I64BinaryOperator.Multiply
            result <- LLVMBuildSDiv(builder, left_value, right_value, "core.divide") if program.operator == ElisaCoreIR::I64BinaryOperator.Divide
            _ = LLVMBuildRet(builder, result)
