# Native consumer for the shared typed scalar IR.

extend Backend:
    private:
        const SIGNED_I64_CONSTANT: i32 = 1


        def core_i64_left_value(program: ElisaCoreIR::Program, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef:
            if program.has_local:
                local_slot: LLVMValueRef = LLVMBuildAlloca(builder, LLVMInt64TypeInContext(ctx), "core.local.slot")
                initializer: LLVMValueRef = LLVMConstInt(LLVMInt64TypeInContext(ctx), program.local_value.u64(), SIGNED_I64_CONSTANT)
                _ = LLVMBuildStore(builder, initializer, local_slot)
                return LLVMBuildLoad2(builder, LLVMInt64TypeInContext(ctx), local_slot, "core.local")
            return LLVMConstInt(LLVMInt64TypeInContext(ctx), program.left.u64(), SIGNED_I64_CONSTANT)


        def emit_core_i64_program(program: ElisaCoreIR::Program, fn: LLVMValueRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> void:
            entry: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, fn, "entry")
            LLVMPositionBuilderAtEnd(builder, entry)
            LLVMSetCurrentDebugLocation2(builder, null)
            left_value: LLVMValueRef = core_i64_left_value(program, ctx, builder)
            if not program.has_binary_operator:
                _ = LLVMBuildRet(builder, left_value)
                return
            right_value: LLVMValueRef = LLVMConstInt(LLVMInt64TypeInContext(ctx), program.right.u64(), SIGNED_I64_CONSTANT)
            result: LLVMValueRef = match program.operator:
                ElisaCoreIR::I64BinaryOperator.Add: LLVMBuildAdd(builder, left_value, right_value, "core.add")
                ElisaCoreIR::I64BinaryOperator.Subtract: LLVMBuildSub(builder, left_value, right_value, "core.subtract")
                ElisaCoreIR::I64BinaryOperator.Multiply: LLVMBuildMul(builder, left_value, right_value, "core.multiply")
                ElisaCoreIR::I64BinaryOperator.Divide: LLVMBuildSDiv(builder, left_value, right_value, "core.divide")
            _ = LLVMBuildRet(builder, result)
