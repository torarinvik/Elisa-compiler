# Stage1 backend — the COMMON FIELDS a packed hierarchy's members all carry: their names and
# types, whether each is stored inline in the row or in a side table, and the row/word index
# a read of one lands on. Part of `module Backend` (see codegen.elisa).

extend Backend:
    private:
        # The parser stores payload enum fields in flat, parser-owned pools. Keep this
        # path flat all the way through registration: constructing a temporary
        # Ast.EnumVariant would recreate nested darray headers whose backing storage
        # can belong to a short-lived parser arena.
        # Record a packed enum's COMMON field names, each row tagged with the OWNING enum.
        # Every variant carries the commons PREPENDED to its own fields, so the first variant's
        # leading `commons` names are them. Idempotent: a second registration of the same enum
        # adds nothing.
        # Whether `name` is the ROOT of a sealed hierarchy — something declares `is name`.
        # The four sealed-root cases below tested `name == "Node"`, which recognised only the
        # compiler's own AST root and left a user hierarchy's variant-less root unreserved,
        # so its refinements had no store to share.
        def packed_name_is_hierarchy_root(structs: StructTable&, name: sview) -> bool can[Abort.Panic]:
            false return if name == ""
            for edge_index in 0..<structs.hierarchy_parent.count |name|:
                true return if structs.hierarchy_parent[edge_index] == name
            return false




        def register_packed_common_names(enum_name: sview, variant_fields: darray[Ast::Expr]&, variant_field_names: darray[sview]&, variant_field_starts: darray[usize]&, variant_start: usize, variant_count: usize, commons: u32, structs: mutable StructTable&) -> void can[Abort.Panic, Memory.Allocate]:
            return if variant_count == 0 or commons == 0
            owner_name: sview = packed_hierarchy_root_name(structs, enum_name)
            owner_module: sview = structs.current_owner
            paired: mutable usize = structs.packed_common_owners.count if structs.packed_common_owners.count < structs.packed_common_names.count else structs.packed_common_names.count
            paired <- structs.packed_common_modules.count if structs.packed_common_modules.count < paired
            for existing_index in 0..<paired |owner_name, structs|:
                return if structs.packed_common_owners[existing_index] == owner_name and structs.packed_common_modules[existing_index] == owner_module
            first_start: usize = variant_field_starts[variant_start]
            for common_index in 0..<commons.usize() |structs, variant_fields, variant_field_names, first_start, owner_name|:
                continue if first_start + common_index >= variant_fields.count
                structs.packed_common_owners <- structs.packed_common_owners.push(owner_name)
                structs.packed_common_modules <- structs.packed_common_modules.push(owner_module)
                structs.packed_common_names <- structs.packed_common_names.push(variant_field_names[first_start + common_index])
                structs.packed_common_types <- structs.packed_common_types.push(annotation_value_type(variant_fields[first_start + common_index], structs))




        # A hierarchy root can be a variant-less `pass` declaration. Its row registration is
        # intentionally skipped, but its common fields still define the store's side-table ABI.
        # Recover those fields from the parser's flat payload metadata before ordinary variants
        # are registered.
        def register_packed_common_names_from_metadata(enum_names: darray[sview]&, enum_modules: darray[sview]&, variant_starts: darray[usize]&, variant_counts: darray[usize]&, variant_fields: darray[Ast::Expr]&, variant_field_names: darray[sview]&, variant_field_starts: darray[usize]&, common_owners: darray[sview]&, common_modules: darray[sview]&, common_counts: darray[u32]&, structs: mutable StructTable&) -> void can[Abort.Panic, Memory.Allocate]:
            for enum_index in 0..<enum_names.count |enum_names, enum_modules, variant_starts, variant_counts, variant_fields, variant_field_names, variant_field_starts, common_owners, common_counts, structs|:
                enum_name: sview = enum_names[enum_index]
                commons: mutable u32 = 0
                enum_module: sview = enum_modules[enum_index] if enum_index < enum_modules.count else ""
                for owner_index in 0..<common_owners.count |commons, common_owners, common_modules, common_counts, enum_name, enum_module|:
                    commons <- common_counts[owner_index] if common_owners[owner_index] == enum_name and owner_index < common_modules.count and common_modules[owner_index] == enum_module
                continue if commons == 0 or variant_counts[enum_index] == 0
                register_packed_common_names(enum_name, variant_fields, variant_field_names, variant_field_starts, variant_starts[enum_index], variant_counts[enum_index], commons, structs)




        # The root of a sealed hierarchy can be a variant-less `pass` declaration. Its common
        # fields are therefore absent from the flat payload-variant pools; use the parser's
        # full common registry for those rows. This also keeps field names and declared types
        # available to the C ABI report and to side-table stores/loads.
        def register_packed_common_names_from_common_metadata(common_owners: darray[sview]&, common_modules: darray[sview]&, common_counts: darray[u32]&, common_starts: darray[usize]&, common_fields: darray[Ast::Expr]&, common_field_names: darray[sview]&, structs: mutable StructTable&) -> void can[Abort.Panic, Memory.Allocate]:
            paired: mutable usize = common_owners.count
            paired <- common_counts.count if common_counts.count < paired
            paired <- common_starts.count if common_starts.count < paired
            for owner_index in 0..<paired |common_owners, common_modules, common_counts, common_starts, common_fields, common_field_names, structs|:
                owner_name: sview = packed_hierarchy_root_name(structs, common_owners[owner_index])
                owner_module: sview = common_modules[owner_index] if owner_index < common_modules.count else ""
                # A variant-less hierarchy root has no payload metadata row of its own, but it
                # still owns the shared store. Reserve that root so constructors for descendants
                # can resolve their common store through `packed_root_index_of`.
                # Keep the root's module owner when the root is reserved from common-field
                # metadata. Dropping it creates an ownerless `Node` placeholder, so a qualified
                # member such as `Ast::Leaf` cannot recover the matching `Ast::Node` store root
                # without falling back to a potentially unrelated same-named root.
                reserve_packed_placeholder(owner_name, structs, owner_module) if owner_name != ""
                common_count: u32 = common_counts[owner_index]
                start: usize = common_starts[owner_index]
                existing: mutable bool = false
                for probe in 0..<structs.packed_common_owners.count |existing, owner_name, owner_module, structs|:
                    existing <- true if probe < structs.packed_common_modules.count and structs.packed_common_owners[probe] == owner_name and structs.packed_common_modules[probe] == owner_module
                continue if existing
                for common_index in 0..<common_count.usize() |common_index, common_count, start, common_fields, common_field_names, owner_name, structs|:
                    continue if start + common_index >= common_fields.count or start + common_index >= common_field_names.count
                    structs.packed_common_owners <- structs.packed_common_owners.push(owner_name)
                    structs.packed_common_modules <- structs.packed_common_modules.push(owner_module)
                    structs.packed_common_names <- structs.packed_common_names.push(common_field_names[start + common_index])
                    structs.packed_common_types <- structs.packed_common_types.push(annotation_value_type(common_fields[start + common_index], structs))




        # The position of `field` among `enum_name`'s common fields, or -1.
        # The innermost `for row in s.rows():` binder called `name`, or -1.
        def soa_row_binder_index_of(structs: StructTable&, name: sview) -> i64 can[Abort.Panic]:
            probe: mutable i64 = structs.soa_row_binder_names.count.i64() - 1
            while probe >= 0 |structs, name, probe|:
                probe return if structs.soa_row_binder_names[probe.usize()] == name
                probe <- probe - 1
            return -1



        def packed_common_module_of(structs: StructTable&, enum_name: sview) -> sview can[Abort.Panic]:
            enum_index: i64 = packed_index_of(structs, enum_name)
            return packed_owner_at(structs, enum_index.usize()) if enum_index >= 0
            return structs.current_owner



        def packed_common_row_matches(structs: StructTable&, probe: usize, enum_name: sview, canonical_name: sview, enum_module: sview) -> bool can[Abort.Panic]:
            return false if probe >= structs.packed_common_modules.count
            return false if structs.packed_common_modules[probe] != enum_module
            return structs.packed_common_owners[probe] == enum_name or structs.packed_common_owners[probe] == canonical_name




        def packed_common_index_of(enum_name: sview, field: sview, structs: mutable StructTable&) -> i64 can[Abort.Panic]:
            paired: mutable usize = structs.packed_common_owners.count if structs.packed_common_owners.count < structs.packed_common_names.count else structs.packed_common_names.count
            canonical_name: sview = packed_hierarchy_root_name(structs, enum_name)
            enum_module: sview = packed_common_module_of(structs, enum_name)
            paired <- structs.packed_common_modules.count if structs.packed_common_modules.count < paired
            position: mutable i64 = -1
            seen: mutable i64 = 0
            for probe in 0..<paired |position, seen, enum_name, canonical_name, enum_module, field, structs|:
                continue if not packed_common_row_matches(structs, probe, enum_name, canonical_name, enum_module)
                position <- seen if structs.packed_common_names[probe] == field
                seen <- seen + 1
            return position




        def packed_common_type_at(structs: StructTable&, enum_name: sview, common_index: u32) -> ValueType can[Abort.Panic]:
            missing: ValueType = unmodeled_type()
            canonical_name: sview = packed_hierarchy_root_name(structs, enum_name)
            enum_module: sview = packed_common_module_of(structs, enum_name)
            paired: mutable usize = structs.packed_common_owners.count
            paired <- structs.packed_common_names.count if structs.packed_common_names.count < paired
            paired <- structs.packed_common_types.count if structs.packed_common_types.count < paired
            paired <- structs.packed_common_modules.count if structs.packed_common_modules.count < paired
            seen: mutable u32 = 0
            for probe in 0..<paired |seen, common_index, enum_name, canonical_name, enum_module, structs|:
                continue if not packed_common_row_matches(structs, probe, enum_name, canonical_name, enum_module)
                return copied_type(structs.packed_common_types[probe]) if seen == common_index
                seen <- seen + 1
            return missing




        # The common NAME at a hierarchy-relative position. Keep this lookup paired with
        # packed_common_type_at: common metadata is owner-keyed because packed enum rows are
        # reserved and filled through several independent registration paths.
        def packed_common_name_at(structs: StructTable&, enum_name: sview, common_index: u32) -> sview can[Abort.Panic]:
            canonical_name: sview = packed_hierarchy_root_name(structs, enum_name)
            enum_module: sview = packed_common_module_of(structs, enum_name)
            paired: mutable usize = structs.packed_common_owners.count
            paired <- structs.packed_common_names.count if structs.packed_common_names.count < paired
            paired <- structs.packed_common_modules.count if structs.packed_common_modules.count < paired
            seen: mutable u32 = 0
            for probe in 0..<paired |seen, common_index, enum_name, canonical_name, enum_module, structs|:
                continue if not packed_common_row_matches(structs, probe, enum_name, canonical_name, enum_module)
                return structs.packed_common_names[probe] if seen == common_index
                seen <- seen + 1
            return ""




        # Explicit common storage is carried through the parser's annotation side channel. A
        # mode of 1 means `@storage(inline)` and 2 means `@storage(side_table)`; mode 0 means
        # the source did not override the ABI default. The owner is normalized to the hierarchy
        # root so an inherited field has one physical placement for every refinement.
        def packed_common_storage_mode(structs: StructTable&, enum_name: sview, common_index: u32) -> u8 can[Abort.Panic]:
            common_name: sview = packed_common_name_at(structs, enum_name, common_index)
            return 0 if common_name == ""
            canonical_name: sview = packed_hierarchy_root_name(structs, enum_name)
            enum_module: sview = packed_common_module_of(structs, enum_name)
            paired: mutable usize = structs.packed_common_storage_owners.count
            paired <- structs.packed_common_storage_modules.count if structs.packed_common_storage_modules.count < paired
            paired <- structs.packed_common_storage_names.count if structs.packed_common_storage_names.count < paired
            paired <- structs.packed_common_storage_modes.count if structs.packed_common_storage_modes.count < paired
            for probe in 0..<paired |common_name, enum_name, canonical_name, enum_module, structs|:
                continue if structs.packed_common_storage_owners[probe] != enum_name and structs.packed_common_storage_owners[probe] != canonical_name
                continue if structs.packed_common_storage_modules[probe] != enum_module
                return structs.packed_common_storage_modes[probe] if structs.packed_common_storage_names[probe] == common_name
            return 0




        def packed_common_is_inline(structs: StructTable&, enum_name: sview, common_index: u32) -> bool can[Abort.Panic]:
            return packed_common_storage_mode(structs, enum_name, common_index) == 1




        # Common fields are inherited by every member of a hierarchy. The row for a child may
        # therefore have a larger `packed_common_counts` value than its root, but the physical
        # side table is one canonical root layout shared by all members.
        def packed_aos_common_count(structs: StructTable&, enum_index: i64) -> u32 can[Abort.Panic]:
            return 0 if enum_index < 0 or enum_index.usize() >= structs.packed_names.count
            root_name: sview = packed_hierarchy_root_name(structs, structs.packed_names[enum_index.usize()])
            widest: mutable u32 = 0
            for candidate in 0..<structs.packed_names.count |widest, structs, root_name|:
                continue if packed_hierarchy_root_name(structs, structs.packed_names[candidate]) != root_name
                widest <- structs.packed_common_counts[candidate] if structs.packed_common_counts[candidate] > widest
            return widest




        # Dynamic AoS uses the dense handle as the side-table index. Only COMMON fields that
        # remain in the side table consume side words; an explicit inline common is a real row
        # field and must not make the runtime allocate or record a phantom column.
        def packed_aos_side_common_count(structs: mutable StructTable&, enum_index: i64) -> u32 can[Abort.Panic]:
            commons: u32 = packed_aos_common_count(structs, enum_index)
            return 0 if commons == 0 or enum_index < 0 or enum_index.usize() >= structs.packed_names.count
            enum_name: sview = structs.packed_names[enum_index.usize()]
            total: mutable u32 = 0
            for common_index in 0..<commons.usize() |total, common_index, enum_name, structs|:
                continue if packed_common_is_inline(structs, enum_name, common_index.u32())
                total <- total + packed_common_side_word_count(packed_common_type_at(structs, enum_name, common_index.u32()), structs)
            return total




        def packed_common_side_word_count(value_type: ValueType, structs: mutable StructTable&) -> u32 can[Abort.Panic]:
            word_bytes: u64 = (target_pointer_bits().u64() / 8)
            return 0 if word_bytes == 0
            field_type: LLVMTypeRef = llvm_type_of(value_type, structs, structs.context)
            field_bytes: u64 = LLVMABISizeOfType(structs.target_data, field_type)
            return 0 if field_bytes == 0
            return ((field_bytes + word_bytes - 1) / word_bytes).u32()




        def packed_common_side_word_offset(structs: mutable StructTable&, enum_name: sview, common_index: u32) -> u32 can[Abort.Panic]:
            offset: mutable u32 = 0
            for prior in 0..<common_index.usize() |offset, enum_name, structs|:
                offset <- offset + packed_common_side_word_count(packed_common_type_at(structs, enum_name, prior.u32()), structs) if not packed_common_is_inline(structs, enum_name, prior.u32())
            return offset




        # Dynamic AoS rows are `{tag, inline commons..., payload words}`. Side-table commons
        # have no row field, so the physical index is the tag plus the number of preceding
        # inline commons, not the logical common index.
        def packed_dynamic_common_row_field_index(structs: StructTable&, enum_index: i64, common_index: u32) -> u32 can[Abort.Panic]:
            return 1 if enum_index < 0 or enum_index.usize() >= structs.packed_names.count
            enum_name: sview = structs.packed_names[enum_index.usize()]
            field: mutable u32 = 1
            for prior in 0..<common_index.usize() |field, prior, enum_name, structs|:
                field <- field + 1 if packed_common_is_inline(structs, enum_name, prior.u32())
            return field




        def packed_dynamic_payload_row_field_index(structs: StructTable&, enum_index: i64) -> u32 can[Abort.Panic]:
            return 1 if enum_index < 0 or enum_index.usize() >= structs.packed_names.count
            return 1 + packed_aos_inline_common_count(structs, enum_index)




        def packed_aos_inline_common_count(structs: StructTable&, enum_index: i64) -> u32 can[Abort.Panic]:
            commons: u32 = packed_aos_common_count(structs, enum_index)
            return 0 if commons == 0 or enum_index < 0 or enum_index.usize() >= structs.packed_names.count
            enum_name: sview = structs.packed_names[enum_index.usize()]
            total: mutable u32 = 0
            for common_index in 0..<commons.usize() |total, common_index, enum_name, structs|:
                total <- total + 1 if packed_common_is_inline(structs, enum_name, common_index.u32())
            return total




        # Legacy packed rows are read by the runtime as eight-byte words. Keep a declared
        # common's actual LLVM type in the row, but account for the explicit tag padding and
        # any tail padding needed to give each common one word-aligned slot. The logical word
        # number remains `1 + common_index`; this helper returns the LLVM STRUCT field index.
        def packed_common_row_field_index(structs: mutable StructTable&, enum_index: i64, common_index: u32) -> u32 can[Abort.Panic]:
            return (1 + common_index) if common_index == 0 and structs.packed_common_counts[enum_index.usize()] == 0
            field: mutable u32 = 2
            enum_name: sview = structs.packed_names[packed_root_index_of(structs, enum_index).usize()] if packed_root_index_of(structs, enum_index) >= 0 else structs.packed_names[enum_index.usize()]
            for prior in 0..<common_index.usize() |field, prior, structs, enum_name|:
                field <- field + 1
                prior_type: ValueType = packed_common_type_at(structs, enum_name, prior.u32())
                prior_bytes: u64 = LLVMABISizeOfType(structs.target_data, llvm_type_of(prior_type, structs, structs.context))
                field <- field + 1 if prior_bytes < 8
            return field




        def packed_payload_row_field_index(structs: mutable StructTable&, enum_index: i64) -> u32 can[Abort.Panic]:
            commons: u32 = structs.packed_common_counts[enum_index.usize()]
            return 1 if commons == 0
            field: mutable u32 = 2
            enum_name: sview = structs.packed_names[packed_root_index_of(structs, enum_index).usize()] if packed_root_index_of(structs, enum_index) >= 0 else structs.packed_names[enum_index.usize()]
            for common_index in 0..<commons.usize() |field, common_index, structs, enum_name|:
                field <- field + 1
                common_type: ValueType = packed_common_type_at(structs, enum_name, common_index.u32())
                common_bytes: u64 = LLVMABISizeOfType(structs.target_data, llvm_type_of(common_type, structs, structs.context))
                field <- field + 1 if common_bytes < 8
            return field




        # Drain `@storage(inline|side_table)` common-field annotations emitted by the parser.
        # The AST's common field expressions intentionally do not grow a storage-mode member;
        # this side channel keeps the stage1 representation compact while preserving the ABI
        # choice needed by dynamic AoS rows.
        def register_packed_common_storage_from_metadata(annotations: darray[Ast::EnumAnnotation]&, structs: mutable StructTable&) -> void can[Abort.Panic, Memory.Allocate]:
            for annotation in annotations |structs|:
                storage_mode: mutable u8 = 0
                storage_mode <- 1 if annotation.line == 3900000088
                storage_mode <- 2 if annotation.line == 3900000089
                continue if storage_mode == 0 or annotation.owner == "" or annotation.name == ""
                owner_name: sview = packed_hierarchy_root_name(structs, annotation.owner)
                already_recorded: mutable bool = false
                paired: mutable usize = structs.packed_common_storage_owners.count
                paired <- structs.packed_common_storage_modules.count if structs.packed_common_storage_modules.count < paired
                paired <- structs.packed_common_storage_names.count if structs.packed_common_storage_names.count < paired
                for existing in 0..<paired |already_recorded, owner_name, annotation, structs|:
                    already_recorded <- true if structs.packed_common_storage_owners[existing] == owner_name and structs.packed_common_storage_modules[existing] == annotation.module and structs.packed_common_storage_names[existing] == annotation.name
                continue if already_recorded
                structs.packed_common_storage_owners <- structs.packed_common_storage_owners.push(owner_name)
                structs.packed_common_storage_modules <- structs.packed_common_storage_modules.push(annotation.module)
                structs.packed_common_storage_names <- structs.packed_common_storage_names.push(annotation.name)
                structs.packed_common_storage_modes <- structs.packed_common_storage_modes.push(storage_mode)
