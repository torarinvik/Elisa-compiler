# Stage1 backend — what a source unit CONTAINS, asked of the declaration list before anything
# is emitted: does it define `main`, is it its own runtime object, which declarations are
# tests, lemmas or modules. Part of `module Backend` (see codegen.elisa).

extend Backend:
    public:


        def new_struct_table(ctx: LLVMContextRef, target_data: LLVMTargetDataRef) -> StructTable can[Abort.Panic, Memory.Allocate]:
            table: mutable StructTable = StructTable{names: [], handles: [], alignments: [], field_names: [], field_types: [], field_start: [], field_count: [], tuple_label_lines: [], tuple_label_names: [], guest_layouts: [], overlay_field_names: [], overlay_field_offsets: [], overlay_field_widths: [], overlay_field_layouts: [], generic_struct_names: [], generic_struct_decls: [], generic_struct_param_names: [], generic_struct_param_start: [], generic_struct_param_count: [], generic_struct_inst_bases: [], generic_struct_inst_args: [], generic_struct_inst_arg_start: [], generic_struct_inst_arg_count: [], generic_struct_inst_index: [], generic_struct_inst_ready: [], generic_struct_inprogress: [], context: ctx, target_data: target_data, array_elements: [], array_extents: [], darray_elements: [], view_elements: [], ref_targets: [], ref_is_heap: [], optional_targets: [], enum_names: [], enum_backings: [], enum_variants: [], enum_variant_values: [], enum_variant_start: [], enum_variant_count: [], binding_names: [], binding_types: [], penum_names: [], penum_variants: [], penum_variant_owners: [], penum_payloads: [], penum_has_payload: [], penum_field_names: [], penum_field_types: [], penum_field_flat_names: [], penum_field_type_start: [], penum_field_type_count: [], packed_names: [], packed_variants: [], packed_payloads: [], packed_has_payload: [], packed_field_names: [], packed_variant_start: [], packed_variant_count: [], packed_payload_words: [], packed_field_types: [], packed_field_flat_names: [], packed_field_type_start: [], packed_field_type_count: [], packed_common_counts: [], ast_refinement_names: [], penum_variant_start: [], penum_variant_count: [], penum_payload_words: [], alias_names: [], alias_types: [], module_alias_names: [], module_alias_targets: [], const_names: [], const_owners: [], const_types: [], const_values: [], const_resolved: [], const_float_text: [], const_cstr_text: [], const_float_values: [], const_float_ok: [], const_globals: [], const_global_ok: [], extern_global_names: [], extern_global_types: [], extern_global_handles: [], decl_line_rows: [], decl_column_rows: [], impl_member_lines: [], impl_member_ifaces: [], impl_member_types: [], mutable_global_names: [], mutable_global_owners: [], mutable_global_types: [], mutable_global_handles: [], static_branch_lines: [], static_taken_lines: [], pending_ensures: [], narrowed_owners: [], narrowed_fields: [], fn_return_lines: [], fn_return_heads: [], query_lines: [], query_heads: [], query_binders: [], fn_pool_returns: [], fn_param_lines: [], fn_param_heads: [], fn_pool_param_start: [], fn_pool_param_count: [], fn_pool_params: [], fn_type_param_lines: [], fn_type_param_exprs: [], fn_type_return_lines: [], fn_type_return_exprs: [], branch_hint_lines: [], branch_hint_kinds: [], disjoint_function_names: [], disjoint_function_masks: []}
            # The AST packed-store headers are NOT reserved here. Doing it in the FACTORY
            # seeded `Node`/`Expr`/`Stmt`/`Decl`/`Pattern` into the packed registry for
            # EVERY program, so an ordinary user `enum Expr:` found a packed slot already
            # present and was registered as a packed AoS enum instead of a payload enum --
            # its constructor then declined, while the byte-identical program with the enum
            # renamed to `Shape` compiled. register_module_types reserves them only for a
            # program that actually declares the Node hierarchy (an `__ast_refinement`
            # annotation), which is the honest test.
            return table



        # A `lemma` is GHOST code: the analyzer discharges its obligations statically and
        # stage0 emits NOTHING for it. stage1 parsed a lemma into an ordinary Decl.Func, so
        # it emitted a real function — `_weaken` appeared in the object where stage0 exports
        # nothing. The `assert ... by:` block that calls it is already erased, so the
        # declaration has no remaining call site.
        def function_is_lemma(annotations: darray[Ast::EnumAnnotation]&, name: sview) -> bool can[Abort.Panic]:
            false return if name == ""
            for annotation in annotations |name|:
                true return if annotation.owner == "__lemma" and annotation.name == name
            return false




        # The test runner's C shim calls the original test symbols directly. In test mode
        # those particular definitions must stay externally visible even though the rest of
        # the source is treated as a program and is internalized like an ordinary executable.
        def declaration_is_test(declaration: Decl) -> bool can[Abort.Panic]:
            match declaration:
                Decl.Func(_, _, _, _, _, decorators, _):
                    for decorator in decorators:
                        true return if decorator.name == "test"
                _:
                    pass
            return false




        # A source unit that includes the complete default runtime is its own runtime object.
        # In that case the backend must emit every runtime body, including the one helper that is
        # normally external-only for ordinary programs.  Test runners can contain the runtime in
        # the same unit as their tests; stripping that helper and then suppressing the separate
        # runtime object leaves an undefined symbol at link time.
        def declaration_list_has_function(declarations: darray[Decl], target: sview) -> bool can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic, Memory.Allocate:
                for declaration in declarations |target|:
                    if declaration is Decl.Func(function_name, function_params, function_return, function_body, function_effects, function_decorators, function_line):
                        true return if function_name == target
                    if declaration is Decl.Module(module_name, module_body, module_line):
                        true return if declaration_list_has_function(module_body, target)
                    if declaration is Decl.Scoped(scoped_body, scoped_line):
                        true return if declaration_list_has_function(scoped_body, target)
                return false




        def declarations_define_default_runtime(declarations: darray[Decl]) -> bool can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic, Memory.Allocate:
                return declaration_list_has_function(declarations, "arena_alloc") and declaration_list_has_function(declarations, "ctx_strlen") and declaration_list_has_function(declarations, "ctx_string_view_slice")




        # Does a top-level `def main` DECLARATION exist? Distinct from
        # `function_index_of(fns, "", "main") >= 0`, which is ALSO true when `main` comes from
        # an export wrapper (`export fn main() -> int = target`).
        def module_declares_main(top: darray[Decl]) -> bool can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic, Memory.Allocate:
                for declaration in top:
                    true return if function_name_of(declaration) == "main"
                    if declaration_is_module(declaration):
                        for nested_index in 0..<declaration_module_count(declaration) |declaration|:
                            true return if function_name_of(declaration_module_at(declaration, nested_index)) == "main"
                return false




        def declaration_is_module(declaration: Decl) -> bool can[Abort.Panic]:
            return match declaration:
                Decl.Module(module_name, module_body, module_line): true
                _: false




        def declaration_module_count(declaration: Decl) -> usize can[Abort.Panic]:
            return match declaration:
                Decl.Module(module_name, module_body, module_line): module_body.count
                _: 0




        def module_name_of(declaration: Decl) -> sview can[Abort.Panic]:
            return match declaration:
                Decl.Module(module_name, module_body, module_line): module_name
                _: ""




        def declaration_is_extern(declaration: Decl) -> bool can[Abort.Panic]:
            return match declaration:
                Decl.Extern(extern_name, param_start, arity, variadic, callable, return_type, decorators, line): true
                _: false




        def declaration_extern_name(declaration: Decl) -> sview can[Abort.Panic]:
            return match declaration:
                Decl.Extern(extern_name, param_start, arity, variadic, callable, return_type, decorators, line): extern_name
                _: ""




        def declaration_module_at(declaration: Decl, index: usize) -> Decl can[Abort.Panic]:
            return match declaration:
                Decl.Module(module_name, module_body, module_line): module_body[index]
                _: (Decl.Invalid)
