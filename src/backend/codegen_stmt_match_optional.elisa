# Stage1 backend — a `match` STATEMENT whose scrutinee is an OPTIONAL: `match opt: null: … /
# binding: …`, the same shape over the niche representation, and the form that matches the
# PAYLOAD directly. An error-returning call is recognised here too, because its success type
# is itself a niche optional and the ordinary optional path would claim it wrongly.
# Called from codegen_stmt_match.elisa; `matched` says whether this claimed the statement,
# since a claimed-but-declined match also returns Declined.
# Part of `module Backend` (see codegen.elisa).

extend Backend:
    private:
        def emit_statement_match_optional(stmt_match_scrutinee: Expr, stmt_match_arms: darray[MatchArm]&, stmt_match_line: Ast::Pos, return_type: ValueType, local_scope: mutable Scope&, loops: mutable LoopStack&, regions: mutable RegionStack&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef, matched: mutable bool&) -> EmitStatus can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            matched <- true
            # type, but its statement-level Match is governed by the ERROR ABI, not by
            # optional-tag matching. Detect that shape before the optional fast paths:
            # otherwise the optional emitter tries to emit the fallible call as an
            # ordinary optional expression, declines, and the real catch emitter below
            # is never reached. This was exposed by generic dict helpers because their
            # `T&? error[RuntimeError]` success type is exactly a niche optional.
            stmt_match_is_error_call: mutable bool = false
            match stmt_match_scrutinee:
                Expr.Call(stmt_error_callee, stmt_error_args, stmt_error_arg_names, stmt_error_line):
                    match stmt_error_callee:
                        Expr.Ident(stmt_error_name, stmt_error_name_line):
                            stmt_match_is_error_call <- error_callee_is(fns, structs, generics, stmt_error_name)
                        _:
                            pass
                _:
                    pass
            # `match OPT: null: … binding: …` — a match whose scrutinee is an OPTIONAL value.
            # Two arms: a `null` (or `_`) arm and a BINDING arm that binds the payload. Lowered
            # like `if OPT is v:` but as a match: test the tag (field 0), branch to the binding
            # arm (bind v = payload) or the null arm. IndexMap's put/find use exactly this.
            match_opt_type: ValueType = expression_type(stmt_match_scrutinee, local_scope, fns, structs, generics)
            match_opt_null_arm_index: i64 = match_null_arm_index(stmt_match_arms)
            if match_opt_type.kind == TypeKind.Optional and stmt_match_arms.count == 2 and not stmt_match_is_error_call:
                mo_payload_type: ValueType = optional_payload_of(match_opt_type, structs)
                mo_null_arm_index: mutable i64 = -1
                mo_bind_arm_index: mutable i64 = -1
                mo_bind_name: mutable sview = ""
                for mo_arm_i in 0..<stmt_match_arms.count |mo_null_arm_index, mo_bind_arm_index, mo_bind_name, stmt_match_arms|:
                    mo_arm: MatchArm = stmt_match_arms[mo_arm_i]
                    if mo_arm.pattern is Pattern.Literal(mo_lit_text):
                        mo_null_arm_index <- mo_arm_i.i64() if mo_lit_text == "null"
                    if mo_arm.pattern is Pattern.Wildcard:
                        mo_null_arm_index <- mo_arm_i.i64() if mo_null_arm_index < 0
                    if mo_arm.pattern is Pattern.Binding(mo_pat_name):
                        mo_bind_arm_index <- mo_arm_i.i64()
                        mo_bind_name <- mo_pat_name
                if mo_null_arm_index >= 0 and mo_bind_arm_index >= 0:
                    # A guarded arm is not the plain null/binding split modeled here.
                    match stmt_match_arms[mo_null_arm_index.usize()].guard:
                        Expr.Absent:
                            match stmt_match_arms[mo_bind_arm_index.usize()].guard:
                                Expr.Absent:
                                    if emit_expression(stmt_match_scrutinee, match_opt_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is mo_opt_value:
                                        mo_opt_llvm: LLVMTypeRef = llvm_type_of(match_opt_type, structs, ctx)
                                        mo_tag: LLVMValueRef = optional_tag_of(mo_opt_value, match_opt_type, structs, ctx, builder)
                                        mo_payload: LLVMValueRef = optional_payload_value_of(mo_opt_value, match_opt_type, structs, ctx, builder)
                                        mo_function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                                        mo_bind_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, mo_function, "match.opt.present")
                                        mo_null_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, mo_function, "match.opt.absent")
                                        mo_done_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, mo_function, "match.opt.done")
                                        _ = LLVMBuildCondBr(builder, mo_tag, mo_bind_block, mo_null_block)
                                        # PRESENT: bind the payload to the arm's name, run its body.
                                        LLVMPositionBuilderAtEnd(builder, mo_bind_block)
                                        mo_bind_storage: mutable darray[u8] = []
                                        mo_bind_slot: LLVMValueRef = build_entry_alloca(builder, llvm_type_of(mo_payload_type, structs, ctx), sview_to_cstr(mo_bind_name, mo_bind_storage))
                                        _ = LLVMBuildStore(builder, mo_payload, mo_bind_slot)
                                        declare_local(local_scope, mo_bind_name, mo_bind_slot, mo_payload_type)
                                        mo_bind_status: EmitStatus = emit_statements_scoped(stmt_match_arms[mo_bind_arm_index.usize()].body, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)
                                        EmitStatus.Declined return if mo_bind_status == EmitStatus.Declined
                                        branch_if_open(mo_bind_status, builder, mo_done_block)
                                        # ABSENT: run the null arm's body.
                                        LLVMPositionBuilderAtEnd(builder, mo_null_block)
                                        mo_null_status: EmitStatus = emit_statements_scoped(stmt_match_arms[mo_null_arm_index.usize()].body, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)
                                        EmitStatus.Declined return if mo_null_status == EmitStatus.Declined
                                        branch_if_open(mo_null_status, builder, mo_done_block)
                                        LLVMPositionBuilderAtEnd(builder, mo_done_block)
                                        if mo_bind_status != EmitStatus.Open and mo_null_status != EmitStatus.Open:
                                            _ = LLVMBuildUnreachable(builder)
                                            return EmitStatus.Terminated
                                        return EmitStatus.Open
                                    return EmitStatus.Declined
                                _:
                                    pass
                        _:
                            pass
            # Optional payload matches may omit an explicit `null` arm. This is common for
            # AST inspection: `Return(value: Expr?)` is matched as
            # `Expr.Call(...): ... / _ : ...`, where both arms describe the PRESENT Expr
            # payload and absence simply falls through. Unwrap that outer carrier, then
            # re-enter the ordinary matcher over a synthetic payload local. Stage0 does
            # this optional boundary before its packed-node matcher; treating the Optional
            # as the packed enum itself made every nested AST inspection silently decline.
            if match_opt_type.kind == TypeKind.Optional and stmt_match_arms.count >= 1 and not stmt_match_is_error_call and match_opt_null_arm_index < 0:
                if emit_expression(stmt_match_scrutinee, match_opt_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is om_value:
                    om_present: LLVMValueRef = optional_tag_of(om_value, match_opt_type, structs, ctx, builder)
                    om_payload_type: ValueType = optional_payload_of(match_opt_type, structs)
                    EmitStatus.Declined return if om_payload_type.kind == TypeKind.Unmodeled
                    om_payload: LLVMValueRef = optional_payload_value_of(om_value, match_opt_type, structs, ctx, builder)
                    om_function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                    om_present_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, om_function, "match.optional.present")
                    om_absent_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, om_function, "match.optional.absent")
                    om_done_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, om_function, "match.optional.done")
                    _ = LLVMBuildCondBr(builder, om_present, om_present_block, om_absent_block)
                    om_null_index: mutable i64 = -1
                    for om_index in 0..<stmt_match_arms.count |om_null_index, stmt_match_arms|:
                        if stmt_match_arms[om_index].pattern is Pattern.Literal(om_literal):
                            om_null_index <- om_index.i64() if om_literal == "null" and om_null_index < 0
                    om_payload_arms: mutable darray[MatchArm] = []
                    for om_index in 0..<stmt_match_arms.count |om_payload_arms, om_null_index, stmt_match_arms|:
                        om_payload_arms.push(stmt_match_arms[om_index]) if om_index.i64() != om_null_index
                    LLVMPositionBuilderAtEnd(builder, om_present_block)
                    if om_payload_arms.count > 0:
                        om_slot: LLVMValueRef = build_entry_alloca(builder, llvm_type_of(om_payload_type, structs, ctx), "match.optional.payload")
                        _ = LLVMBuildStore(builder, om_payload, om_slot)
                        om_mark: usize = scope_mark(local_scope)
                        declare_local(local_scope, "__match_optional", om_slot, om_payload_type)
                        om_status: EmitStatus = emit_statement((Stmt.Match((Expr.Ident("__match_optional", stmt_match_line)), om_payload_arms, stmt_match_line)), return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)
                        scope_restore(local_scope, om_mark)
                        EmitStatus.Declined return if om_status == EmitStatus.Declined
                        branch_if_open(om_status, builder, om_done_block)
                    else:
                        _ = LLVMBuildBr(builder, om_done_block)
                    LLVMPositionBuilderAtEnd(builder, om_absent_block)
                    if om_null_index >= 0:
                        om_absent_status: EmitStatus = emit_statements_scoped(stmt_match_arms[om_null_index.usize()].body, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)
                        EmitStatus.Declined return if om_absent_status == EmitStatus.Declined
                        branch_if_open(om_absent_status, builder, om_done_block)
                    else:
                        _ = LLVMBuildBr(builder, om_done_block)
                    LLVMPositionBuilderAtEnd(builder, om_done_block)
                    return EmitStatus.Open
                return EmitStatus.Declined

            # The GENERAL optional match: a literal `null` arm plus any number of arms that
            # match the PAYLOAD (`null:` / `Expr.Int(value):` / `_:`). The two-arm
            # null/binding split above stays as it is -- it is the shape the std's index
            # maps use and it is proven -- and this catches everything else.
            #
            # Rather than grow a second pattern-matching engine, the payload is bound to a
            # synthetic local and the REMAINING arms are re-entered as an ordinary match on
            # it. Every payload pattern the match emitter already models therefore works
            # here unchanged; the same trick the `return match` route uses.
            if match_opt_type.kind == TypeKind.Optional and stmt_match_arms.count >= 2 and not stmt_match_is_error_call:
                gmo_null_index: mutable i64 = -1
                for gmo_i in 0..<stmt_match_arms.count |gmo_null_index, stmt_match_arms|:
                    if stmt_match_arms[gmo_i].pattern is Pattern.Literal(gmo_lit):
                        gmo_null_index <- gmo_i.i64() if gmo_lit == "null" and gmo_null_index < 0
                if gmo_null_index >= 0:
                    match stmt_match_arms[gmo_null_index.usize()].guard:
                        Expr.Absent:
                            pass
                        _:
                            return EmitStatus.Declined
                    gmo_payload_type: ValueType = optional_payload_of(match_opt_type, structs)
                    EmitStatus.Declined return if gmo_payload_type.kind == TypeKind.Unmodeled
                    gmo_rest: mutable darray[MatchArm] = []
                    for gmo_j in 0..<stmt_match_arms.count |gmo_rest, gmo_null_index, stmt_match_arms|:
                        gmo_rest.push(stmt_match_arms[gmo_j]) if gmo_j.i64() != gmo_null_index
                    EmitStatus.Declined return if gmo_rest.count == 0
                    if emit_expression(stmt_match_scrutinee, match_opt_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is gmo_value:
                        gmo_tag: LLVMValueRef = optional_tag_of(gmo_value, match_opt_type, structs, ctx, builder)
                        gmo_payload: LLVMValueRef = optional_payload_value_of(gmo_value, match_opt_type, structs, ctx, builder)
                        gmo_function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                        gmo_present: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, gmo_function, "match.optn.present")
                        gmo_absent: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, gmo_function, "match.optn.absent")
                        gmo_done: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, gmo_function, "match.optn.done")
                        _ = LLVMBuildCondBr(builder, gmo_tag, gmo_present, gmo_absent)
                        LLVMPositionBuilderAtEnd(builder, gmo_absent)
                        gmo_null_status: EmitStatus = emit_statements_scoped(stmt_match_arms[gmo_null_index.usize()].body, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)
                        EmitStatus.Declined return if gmo_null_status == EmitStatus.Declined
                        branch_if_open(gmo_null_status, builder, gmo_done)
                        LLVMPositionBuilderAtEnd(builder, gmo_present)
                        gmo_storage: mutable darray[u8] = []
                        gmo_slot: LLVMValueRef = build_entry_alloca(builder, llvm_type_of(gmo_payload_type, structs, ctx), sview_to_cstr("__match_opt", gmo_storage))
                        _ = LLVMBuildStore(builder, gmo_payload, gmo_slot)
                        gmo_mark: usize = scope_mark(local_scope)
                        declare_local(local_scope, "__match_opt", gmo_slot, gmo_payload_type)
                        gmo_inner_status: EmitStatus = emit_statement((Stmt.Match((Expr.Ident("__match_opt", stmt_match_line)), gmo_rest, stmt_match_line)), return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)
                        scope_restore(local_scope, gmo_mark)
                        EmitStatus.Declined return if gmo_inner_status == EmitStatus.Declined
                        branch_if_open(gmo_inner_status, builder, gmo_done)
                        LLVMPositionBuilderAtEnd(builder, gmo_done)
                        if gmo_null_status != EmitStatus.Open and gmo_inner_status != EmitStatus.Open:
                            _ = LLVMBuildUnreachable(builder)
                            return EmitStatus.Terminated
                        return EmitStatus.Open
                    return EmitStatus.Declined
            matched <- false
            return EmitStatus.Declined
