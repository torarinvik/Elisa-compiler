# Stage1 backend — the multi-column `when` DECISION TABLE (docs/125 §4), statement form.
#
# `when a, b:` reaches the backend as a `match` over an `Expr.Tuple` scrutinee whose rows are
# `Pattern.Tuple` — the desugar stage0 performs in its own parser, which stage1 reproduces
# byte-for-byte because `-emit ast` is held to parity. Neither compiler builds a tuple VALUE
# here: each column is an ordinary scalar, and a row hits when every column hits.
#
# Lowered as the same first-wins chain the scalar emitter builds, with a conjunction per row
# instead of a single compare. Column scrutinees are emitted ONCE, ahead of the chain, so an
# N-row table evaluates each scrutinee once rather than N times — which stops being merely a
# size argument the moment a scrutinee is a call.
#
# Split into its own file (the scalar match file is already long); `handled` clears when the
# scrutinee is not a tuple, so the caller falls through to its other shapes.

extend Backend:
    private:
        def emit_statement_match_tuple(stmt_match_scrutinee: Expr, stmt_match_arms: darray[MatchArm]&, return_type: ValueType, local_scope: mutable Scope&, loops: mutable LoopStack&, regions: mutable RegionStack&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef, handled: mutable bool&) -> EmitStatus can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            handled <- false
            if stmt_match_scrutinee is Expr.Tuple(wt_elements, wt_tuple_line):
                handled <- true
                EmitStatus.Declined return if wt_elements.count < 2 or stmt_match_arms.count < 1
                # The column scrutinees, emitted once each. Kept as LOCALS rather than filled
                # by a helper: stage0 miscompiles a `mutable darray[ValueType]&` PARAMETER that
                # is pushed to — the symptom is an "unknown type ValueType" reported against an
                # unrelated file, and the site it names moves as the source moves.
                wt_values: mutable darray[LLVMValueRef] = []
                wt_types: mutable darray[ValueType] = []
                wt_compare_types: mutable darray[LLVMTypeRef] = []
                wt_column_failed: mutable bool = false
                for wt_element in wt_elements |wt_column_failed, wt_values, wt_types, wt_compare_types, local_scope, fns, structs, generics, runtime, m, ctx, builder|:
                    continue if wt_column_failed
                    wt_element_type: ValueType = resolve_type(wt_element, ValueType{kind: TypeKind.Signed, bits: 64}, local_scope, fns, structs, generics)
                    if not is_integer_type(wt_element_type) and wt_element_type.kind != TypeKind.Bool and wt_element_type.kind != TypeKind.CStr and wt_element_type.kind != TypeKind.SView:
                        wt_column_failed <- true
                        continue
                    if emit_expression(wt_element, wt_element_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is wt_element_value:
                        wt_values.push(wt_element_value)
                        wt_compare_types.push(llvm_type_of(wt_element_type, structs, ctx))
                        wt_types.push(wt_element_type)
                    else:
                        wt_column_failed <- true
                EmitStatus.Declined return if wt_column_failed
                wt_function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                wt_done: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, wt_function, "when.done")
                wt_declined: mutable bool = false
                wt_saw_default: mutable bool = false
                wt_any_open: mutable bool = false
                for wt_arm in stmt_match_arms |wt_declined, wt_saw_default, wt_any_open, wt_values, wt_types, wt_compare_types, wt_function, wt_done, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder|:
                    continue if wt_declined or wt_saw_default
                    # A guard on a row is not part of the table grammar; decline rather than
                    # emit a row whose condition is only half tested.
                    if arm_has_guard(wt_arm.guard):
                        wt_declined <- true
                        continue
                    wt_arm_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, wt_function, "when.row")
                    # The parser moves the `_` default row LAST (order-independence), so
                    # reaching it ends the chain.
                    if is_catch_all_pattern(wt_arm.pattern):
                        _ = LLVMBuildBr(builder, wt_arm_block)
                        LLVMPositionBuilderAtEnd(builder, wt_arm_block)
                        wt_default_status: EmitStatus = emit_statements_scoped(wt_arm.body, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)
                        wt_declined <- true if wt_default_status == EmitStatus.Declined
                        wt_any_open <- true if wt_default_status == EmitStatus.Open
                        branch_if_open(wt_default_status, builder, wt_done)
                        wt_saw_default <- true if wt_default_status != EmitStatus.Declined
                        continue
                    wt_columns: mutable darray[Pattern] = []
                    if not when_row_columns(wt_arm.pattern, wt_columns):
                        wt_declined <- true
                        continue
                    if wt_columns.count != wt_values.count:
                        wt_declined <- true
                        continue
                    wt_next_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, wt_function, "when.next")
                    if emit_when_row_hit(wt_columns, wt_values, wt_types, wt_compare_types, structs, runtime, ctx, builder) is wt_hit:
                        _ = LLVMBuildCondBr(builder, wt_hit, wt_arm_block, wt_next_block)
                        LLVMPositionBuilderAtEnd(builder, wt_arm_block)
                        wt_row_status: EmitStatus = emit_statements_scoped(wt_arm.body, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)
                        wt_declined <- true if wt_row_status == EmitStatus.Declined
                        wt_any_open <- true if wt_row_status == EmitStatus.Open
                        branch_if_open(wt_row_status, builder, wt_done)
                        LLVMPositionBuilderAtEnd(builder, wt_next_block)
                    else:
                        wt_declined <- true
                EmitStatus.Declined return if wt_declined
                # No `_` row: the chain falls out of its last `when.next` into the join. A
                # `when` is total by stage0's R2 check, so this is the unmatched tail of a table
                # whose totality was proven in the frontend, not a hole.
                if not wt_saw_default:
                    _ = LLVMBuildBr(builder, wt_done)
                    wt_any_open <- true
                LLVMPositionBuilderAtEnd(builder, wt_done)
                if not wt_any_open:
                    _ = LLVMBuildUnreachable(builder)
                    return EmitStatus.Terminated
                return EmitStatus.Open
            return EmitStatus.Declined
