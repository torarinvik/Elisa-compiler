# Exact EASM opcode-token to scalar memory-width classification.
module EasmAccessWidth:
    public:
        def access_width(op: sview) -> i64:
            ensure result == (
                1 if (op == "movb" or op == "xchgb") else
                2 if (op == "movw" or op == "xchgw") else
                4 if (op == "movl" or op == "xchgl") else
                8 if (op == "movq" or op == "xchgq") else 0
            )
            can Abort.Panic:
                return when op:
                    "movb" | "xchgb" -> 1
                    "movw" | "xchgw" -> 2
                    "movl" | "xchgl" -> 4
                    "movq" | "xchgq" -> 8
                    _ -> 0
