# Stage1 EASM model.
#
# This is the first shared layer of the stage0 EASM backend port: typed records used by the
# parser, verifier, and LLVM inline-assembly emitter. Keeping these records separate from the
# ordinary Elisa ValueType model is intentional — EASM has machine registers, stack facts,
# guest overlays, and patchable instruction templates that are not Elisa values.

module Easm:
    public:
        const enum Severity of u8:
            Error
            Warning

        struct Issue:
            severity: Severity
            code: sview
            line: i64
            message: sview

        struct Param:
            name: sview
            type_name: sview

        struct Instruction:
            op: sview
            text: sview
            line: mutable i64
            pseudo: bool
            substitution_count: mutable i64
            substitution0: mutable Substitution
            substitution1: mutable Substitution
            substitution2: mutable Substitution
            substitution3: mutable Substitution

        struct Substitution:
            from: sview
            replacement: sview

        struct TargetBody:
            arch: sview
            lockstep: sview
            instructions: mutable darray[Instruction]
            line: i64

        struct LabelContract:
            name: sview
            preconditions: darray[sview]
            line: i64

        struct LayoutField:
            offset: i64
            name: sview
            type_name: sview
            width: i64
            requires_size_at_least: i64
            line: i64

        struct Layout:
            name: mutable sview
            fields: mutable darray[LayoutField]
            size: mutable i64
            stride: mutable i64
            line: mutable i64

        struct GuestOverlayAccess:
            layout: sview
            field: sview
            offset: i64
            width: i64
            access_width: i64

        # ABI-neutral lowering result for the source-level guest-overlay accessor.  The call is
        # emitted into caller-owned bytes rather than stored as a temporary string, because sview
        # values borrow source storage and Elisa has no implicit string concatenation.
        struct GuestOverlayDesugar:
            access: GuestOverlayAccess
            base: sview
            memory: sview
            value: sview
            is_write: bool
            accessor_name: sview

        struct Function:
            name: mutable sview
            params: mutable darray[Param]
            return_type: sview
            abi: sview
            effects: mutable darray[sview]
            requires: mutable darray[sview]
            changes: mutable darray[sview]
            reads: mutable darray[sview]
            clobbers: mutable darray[sview]
            preserves: mutable darray[sview]
            facts: mutable darray[sview]
            inputs: mutable darray[sview]
            outputs: mutable darray[sview]
            stack_facts: mutable darray[sview]
            control: mutable darray[sview]
            labels: mutable darray[LabelContract]
            instructions: mutable darray[Instruction]
            reference: mutable darray[Instruction]
            targets: mutable darray[TargetBody]
            line: i64
            platform: sview

        # One explicit instruction transition row, corresponding to stage0's opRule.  Masks
        # use the same canonical register bits as the verifier; `result_defines` distinguishes
        # defined implicit results (cpuid/rdtsc) from caller-clobbered values.
        struct OperationEffect:
            known: bool
            capability: sview
            clobbers_flags: bool
            implicit_cc: bool
            implicit_reads: i64
            implicit_writes: i64
            result_defines: bool

        struct ProtocolMethod:
            name: sview
            arity: i64
            return_type: sview

        struct Protocol:
            name: sview
            methods: mutable darray[ProtocolMethod]
            line: i64

        struct PatchPoint:
            hole: sview
            type_name: sview
            instruction_index: i64
            class_name: sview

        struct PatchByte:
            hole: sview
            offset: i64
            width: i64

        struct TemplateImage:
            bytes: darray[u8]
            patches: darray[PatchByte]

        struct PatchValue:
            hole: sview
            value: u64

        struct Template:
            name: sview
            holes: mutable darray[Param]
            instructions: mutable darray[Instruction]
            patch_points: mutable darray[PatchPoint]
            line: i64

        struct Module:
            path: mutable sview
            name: mutable sview
            target: mutable sview
            issues: mutable darray[Issue]
            functions: mutable darray[Function]
            fragments: mutable darray[Function]
            protocols: mutable darray[Protocol]
            templates: mutable darray[Template]
            layouts: mutable darray[Layout]

        # Host-facing project boundary. The self-hosted compiler does not own filesystem
        # discovery yet, so callers provide the configured project/dependency sources. Keeping
        # source bytes alive in this record is important: parsed sviews intentionally borrow
        # those buffers rather than copying every EASM token.
        struct ProjectSource:
            path: sview
            bytes: darray[u8]

        struct Project:
            target: sview
            modules: mutable darray[Module]
            issues: mutable darray[Issue]

        # The stage0 verifier carries these facts through control-flow edges and meets them at
        # labels.  Stage1 uses a fixed register bitset instead of a map: this keeps the analysis
        # allocation-free and, importantly, makes the meet operation explicit (a register is live
        # after a merge only when it is live on every incoming edge).
        struct FlowState:
            live: mutable i64
            stack_delta: mutable i64
            stack_mod16: mutable i64
            stack_known: mutable bool
            flags_live: mutable bool
            valid: mutable bool

        struct MemoryProvenance:
            register: sview
            type_name: sview
            parameter: sview

        # Control-flow provenance state. `types` is indexed by the same register bits used by the
        # liveness analysis. `ambiguous` records a meet where incoming edges disagree (typed vs
        # untyped, or two different carriers); an empty type alone is not enough to distinguish an
        # ordinary raw register from an unsound provenance join.
        struct ProvenanceFlow:
            types: mutable darray[sview]
            ambiguous: mutable i64
            valid: mutable bool

        def easm_register_bit(register: sview) -> i64:
            if easm_equal(register, "rax") or easm_equal(register, "eax") or easm_equal(register, "ax") or easm_equal(register, "al"):
                return 1
            if easm_equal(register, "rcx") or easm_equal(register, "ecx") or easm_equal(register, "cx") or easm_equal(register, "cl"):
                return 2
            if easm_equal(register, "rdx") or easm_equal(register, "edx") or easm_equal(register, "dx") or easm_equal(register, "dl"):
                return 4
            if easm_equal(register, "rbx") or easm_equal(register, "ebx") or easm_equal(register, "bx") or easm_equal(register, "bl"):
                return 8
            if easm_equal(register, "rsi") or easm_equal(register, "esi") or easm_equal(register, "si") or easm_equal(register, "sil"):
                return 16
            if easm_equal(register, "rdi") or easm_equal(register, "edi") or easm_equal(register, "di") or easm_equal(register, "dil"):
                return 32
            if easm_equal(register, "rbp") or easm_equal(register, "ebp") or easm_equal(register, "bp") or easm_equal(register, "bpl"):
                return 64
            if easm_equal(register, "rsp") or easm_equal(register, "esp") or easm_equal(register, "sp") or easm_equal(register, "spl"):
                return 128
            if easm_equal(register, "r8") or easm_equal(register, "r8d") or easm_equal(register, "r8w") or easm_equal(register, "r8b"):
                return 256
            if easm_equal(register, "r9") or easm_equal(register, "r9d") or easm_equal(register, "r9w") or easm_equal(register, "r9b"):
                return 512
            if easm_equal(register, "r10") or easm_equal(register, "r10d") or easm_equal(register, "r10w") or easm_equal(register, "r10b"):
                return 1024
            if easm_equal(register, "r11") or easm_equal(register, "r11d") or easm_equal(register, "r11w") or easm_equal(register, "r11b"):
                return 2048
            if easm_equal(register, "r12") or easm_equal(register, "r12d") or easm_equal(register, "r12w") or easm_equal(register, "r12b"):
                return 4096
            if easm_equal(register, "r13") or easm_equal(register, "r13d") or easm_equal(register, "r13w") or easm_equal(register, "r13b"):
                return 8192
            if easm_equal(register, "r14") or easm_equal(register, "r14d") or easm_equal(register, "r14w") or easm_equal(register, "r14b"):
                return 16384
            if easm_equal(register, "r15") or easm_equal(register, "r15d") or easm_equal(register, "r15w") or easm_equal(register, "r15b"):
                return 32768
            return 0

        def easm_register_mask(text: sview) -> i64:
            mask: mutable i64 = 0
            mask <- mask | 1 if easm_find(text, "%rax") < sview_len(text)
            mask <- mask | 2 if easm_find(text, "%rcx") < sview_len(text)
            mask <- mask | 4 if easm_find(text, "%rdx") < sview_len(text)
            mask <- mask | 8 if easm_find(text, "%rbx") < sview_len(text)
            mask <- mask | 16 if easm_find(text, "%rsi") < sview_len(text)
            mask <- mask | 32 if easm_find(text, "%rdi") < sview_len(text)
            mask <- mask | 64 if easm_find(text, "%rbp") < sview_len(text)
            mask <- mask | 128 if easm_find(text, "%rsp") < sview_len(text)
            mask <- mask | 256 if easm_find(text, "%r8") < sview_len(text)
            mask <- mask | 512 if easm_find(text, "%r9") < sview_len(text)
            mask <- mask | 1024 if easm_find(text, "%r10") < sview_len(text)
            mask <- mask | 2048 if easm_find(text, "%r11") < sview_len(text)
            mask <- mask | 4096 if easm_find(text, "%r12") < sview_len(text)
            mask <- mask | 8192 if easm_find(text, "%r13") < sview_len(text)
            mask <- mask | 16384 if easm_find(text, "%r14") < sview_len(text)
            mask <- mask | 32768 if easm_find(text, "%r15") < sview_len(text)
            return mask

        def easm_substitution_at(instruction: Instruction, index: i64) -> Substitution:
            if index == 0:
                return instruction.substitution0
            if index == 1:
                return instruction.substitution1
            if index == 2:
                return instruction.substitution2
            return instruction.substitution3

        def easm_substitute_operand(operand: sview, instruction: Instruction) -> sview:
            value: sview = easm_trim(operand)
            for index in 0..<instruction.substitution_count.usize() |index, instruction, value|:
                substitution: Substitution = easm_substitution_at(instruction, index.i64())
                if easm_equal(value, substitution.from):
                    return substitution.replacement
            return value

        def easm_instruction_register_mask(instruction: Instruction) -> i64:
            mask: mutable i64 = easm_register_mask(instruction.text)
            for index in 0..<instruction.substitution_count.usize() |index, instruction, mask|:
                substitution: Substitution = easm_substitution_at(instruction, index.i64())
                if easm_find(instruction.text, substitution.from) < sview_len(instruction.text):
                    mask <- mask | easm_register_mask(substitution.replacement)
            return mask

        def easm_written_mask(instruction: Instruction) -> i64:
            if easm_starts(instruction.op, "cmp") or easm_starts(instruction.op, "test") or easm_starts(instruction.op, "push") or easm_starts(instruction.op, "pop") or easm_starts(instruction.op, "call") or easm_starts(instruction.op, "jmp") or easm_starts(instruction.op, "ret"):
                return 0
            return easm_register_bit(easm_register_operand(easm_substitute_operand(easm_last_operand(instruction.text), instruction)))

        def easm_read_mask(instruction: Instruction) -> i64:
            all_registers: i64 = easm_instruction_register_mask(instruction)
            written: i64 = easm_written_mask(instruction)
            if easm_starts(instruction.op, "mov") or easm_starts(instruction.op, "lea"):
                return all_registers & (~written)
            return all_registers

        def easm_instruction_has_memory(instruction: Instruction) -> bool:
            if easm_memory_operand(instruction.text):
                return true
            for index in 0..<instruction.substitution_count.usize() |index, instruction|:
                substitution: Substitution = easm_substitution_at(instruction, index.i64())
                if easm_memory_operand(substitution.replacement):
                    return true
            return false

        def easm_label_name(instruction: Instruction) -> sview:
            if instruction.op != "label":
                return ""
            text: sview = easm_trim(instruction.text)
            if sview_len(text) > 0 and sview_at(text, sview_len(text) - 1.usize()) == 58:
                return easm_trim(text[0:sview_len(text) - 1.usize()])
            return text

        def easm_label_index(instructions: darray[Instruction], target: sview) -> i64:
            for index in 0..<instructions.count |instructions, target|:
                if easm_equal(easm_label_name(instructions[index]), target):
                    return index.i64()
            return -1

        def easm_is_conditional_jump(op: sview) -> bool:
            return easm_starts(op, "j") and not easm_equal(op, "jmp") and not easm_equal(op, "jmpq")

        def easm_is_terminator(op: sview) -> bool:
            return easm_equal(op, "jmp") or easm_equal(op, "jmpq") or easm_equal(op, "ret") or easm_equal(op, "retq")

        def easm_flow_equal(a: FlowState, b: FlowState) -> bool:
            return a.valid == b.valid and a.live == b.live and a.stack_delta == b.stack_delta and a.stack_mod16 == b.stack_mod16 and a.stack_known == b.stack_known and a.flags_live == b.flags_live

        def easm_propagate_flow(target: i64, incoming: FlowState, entries: mutable darray[FlowState]&, meets: mutable darray[i64]&, counts: mutable darray[i64]&) -> bool:
            if target < 0 or target >= entries.count.i64():
                return false
            changed: mutable bool = false
            if counts[target.usize()] == 0:
                meets[target.usize()] <- incoming.live
                counts[target.usize()] <- 1
            else:
                new_meet: i64 = meets[target.usize()] & incoming.live
                changed <- true if new_meet != meets[target.usize()]
                meets[target.usize()] <- new_meet
                counts[target.usize()] <- counts[target.usize()] + 1
            if not entries[target.usize()].valid:
                entries[target.usize()] <- incoming
                return true
            current: FlowState = entries[target.usize()]
            joined: FlowState = current
            joined.live <- current.live & incoming.live
            joined.flags_live <- current.flags_live and incoming.flags_live
            joined.stack_known <- current.stack_known and incoming.stack_known and current.stack_mod16 == incoming.stack_mod16
            joined.stack_mod16 <- current.stack_mod16 if joined.stack_known else 0
            joined.stack_delta <- current.stack_delta if current.stack_delta == incoming.stack_delta else 0
            changed <- true if not easm_flow_equal(current, joined)
            entries[target.usize()] <- joined
            return changed

        def easm_flow_transfer(instruction: Instruction, incoming: FlowState) -> FlowState:
            out: mutable FlowState = incoming
            written: i64 = easm_written_mask(instruction)
            if written != 0:
                out.live <- out.live | written
            if easm_starts(instruction.op, "call"):
                out.live <- out.live & (~(2 | 4 | 16 | 32 | 256 | 512 | 1024 | 2048))
                out.flags_live <- false
            if easm_starts(instruction.op, "cmp") or easm_starts(instruction.op, "test"):
                out.flags_live <- true
            if easm_starts(instruction.op, "add") or easm_starts(instruction.op, "sub"):
                out.flags_live <- false
            if easm_starts(instruction.op, "push"):
                out.stack_delta <- out.stack_delta - 8
                out.stack_mod16 <- (out.stack_mod16 - 8) % 16 if out.stack_known
            if easm_starts(instruction.op, "pop"):
                out.stack_delta <- out.stack_delta + 8
                out.stack_mod16 <- (out.stack_mod16 + 8) % 16 if out.stack_known
            if (easm_starts(instruction.op, "add") or easm_starts(instruction.op, "sub")) and easm_find(instruction.text, "%rsp") < sview_len(instruction.text):
                amount: i64 = easm_immediate_after_dollar(instruction.text)
                out.stack_delta <- out.stack_delta + amount if easm_starts(instruction.op, "add") else out.stack_delta - amount
                out.stack_mod16 <- (out.stack_mod16 + amount) % 16 if easm_starts(instruction.op, "add") and out.stack_known
                out.stack_mod16 <- (out.stack_mod16 - amount) % 16 if easm_starts(instruction.op, "sub") and out.stack_known
            return out

        def easm_provenance_slot(register: sview) -> i64:
            bit: i64 = easm_register_bit(register)
            return match bit:
                1: 0
                2: 1
                4: 2
                8: 3
                16: 4
                32: 5
                64: 6
                128: 7
                256: 8
                512: 9
                1024: 10
                2048: 11
                4096: 12
                8192: 13
                16384: 14
                32768: 15
                _: -1

        def easm_empty_provenance_flow() -> ProvenanceFlow:
            types: mutable darray[sview] = []
            for _ in 0..<16 |types|:
                types.push("")
            return ProvenanceFlow{types: types, ambiguous: 0, valid: false}

        def easm_provenance_flow_equal(a: ProvenanceFlow, b: ProvenanceFlow) -> bool:
            false return if a.valid != b.valid or a.ambiguous != b.ambiguous or a.types.count != b.types.count
            for index in 0..<a.types.count |a, b|:
                false return if a.types[index] != b.types[index]
            return true

        def easm_provenance_flow_propagate(target: i64, incoming: ProvenanceFlow, entries: mutable darray[ProvenanceFlow]&, counts: mutable darray[i64]&) -> bool:
            false return if target < 0 or target >= entries.count.i64()
            if not entries[target.usize()].valid:
                entries[target.usize()] <- incoming
                counts[target.usize()] <- 1
                return true
            current: ProvenanceFlow = entries[target.usize()]
            joined: ProvenanceFlow = current
            joined.valid <- true
            for index in 0..<joined.types.count |index, joined, current, incoming|:
                if current.types[index] != incoming.types[index]:
                    joined.ambiguous <- joined.ambiguous | (1 << index.i64())
                    joined.types[index] <- ""
                if (current.ambiguous & (1 << index.i64())) != 0 or (incoming.ambiguous & (1 << index.i64())) != 0:
                    joined.ambiguous <- joined.ambiguous | (1 << index.i64())
            counts[target.usize()] <- counts[target.usize()] + 1
            changed: bool = not easm_provenance_flow_equal(current, joined)
            entries[target.usize()] <- joined
            return changed

        def easm_provenance_flow_transfer(instruction: Instruction, incoming: ProvenanceFlow) -> ProvenanceFlow:
            out: mutable ProvenanceFlow = incoming
            out return if easm_starts(instruction.op, "cmp") or easm_starts(instruction.op, "test") or easm_starts(instruction.op, "push") or easm_starts(instruction.op, "call") or easm_starts(instruction.op, "jmp") or easm_starts(instruction.op, "ret")
            destination: sview = easm_register_operand(easm_last_operand(instruction.text))
            destination_slot: i64 = easm_provenance_slot(destination)
            out return if destination_slot < 0
            source: sview = easm_first_operand(instruction.text)
            source_register: sview = easm_register_operand(source)
            source_slot: i64 = easm_provenance_slot(source_register)
            if easm_starts(instruction.op, "mov"):
                out.types[destination_slot.usize()] <- out.types[source_slot.usize()] if source_slot >= 0 else ""
                out.ambiguous <- out.ambiguous | (1 << destination_slot) if source_slot >= 0 and (out.ambiguous & (1 << source_slot)) != 0 else out.ambiguous & (~(1 << destination_slot))
            elif easm_starts(instruction.op, "lea"):
                base: sview = easm_memory_base_register(source)
                base_slot: i64 = easm_provenance_slot(base)
                out.types[destination_slot.usize()] <- out.types[base_slot.usize()] if base_slot >= 0 else ""
                out.ambiguous <- out.ambiguous | (1 << destination_slot) if base_slot >= 0 and (out.ambiguous & (1 << base_slot)) != 0 else out.ambiguous & (~(1 << destination_slot))
            elif easm_starts(instruction.op, "add") or easm_starts(instruction.op, "sub") or easm_starts(instruction.op, "inc") or easm_starts(instruction.op, "dec"):
                return out
            else:
                out.types[destination_slot.usize()] <- ""
                out.ambiguous <- out.ambiguous & (~(1 << destination_slot))
            return out

        # Unlike the linear provenance walk, this pass meets carrier facts at labels. A dereference
        # after a branch is rejected only when the base's provenance actually disagrees between
        # incoming edges, avoiding false positives for ordinary raw registers.
        def easm_verify_provenance_merges(fn: Function, issues: mutable darray[Issue]&) -> void:
            count: usize = fn.instructions.count
            return if count == 0
            entries: mutable darray[ProvenanceFlow] = []
            incoming_counts: mutable darray[i64] = []
            for _ in 0..<count |entries, incoming_counts|:
                entries.push(easm_empty_provenance_flow())
                incoming_counts.push(0)
            initial: ProvenanceFlow = easm_empty_provenance_flow()
            initial.valid <- true
            for input in fn.inputs:
                register: sview = easm_binding_register(input)
                slot: i64 = easm_provenance_slot(register)
                if slot >= 0:
                    initial.types[slot.usize()] <- easm_param_type(fn, easm_binding_name(input))
            entries[0] <- initial
            incoming_counts[0] <- 1
            for _ in 0..<(count + 1) |entries, incoming_counts, fn, issues|:
                changed: mutable bool = false
                for index in 0..<count |index, entries, incoming_counts, fn, issues, changed|:
                    continue if not entries[index].valid
                    instruction: Instruction = fn.instructions[index]
                    state: ProvenanceFlow = easm_provenance_flow_transfer(instruction, entries[index])
                    if easm_starts(instruction.op, "j"):
                        target: sview = easm_last_operand(instruction.text)
                        if sview_len(target) > 0 and sview_at(target, 0) != 37:
                            changed <- easm_provenance_flow_propagate(easm_label_index(fn.instructions, target), state, entries, incoming_counts) or changed
                        continue if easm_is_terminator(instruction.op)
                    if not easm_is_terminator(instruction.op) and index + 1 < count:
                        changed <- easm_provenance_flow_propagate(index.i64() + 1, state, entries, incoming_counts) or changed
                break if not changed
            for index in 0..<count |index, entries, incoming_counts, fn, issues|:
                # The ambiguity is attached to the merged entry state and is propagated through
                # the label itself, so the first instruction after a label may have one textual
                # predecessor even though its state came from multiple incoming edges.
                continue if entries[index].ambiguous == 0
                instruction: Instruction = fn.instructions[index]
                continue if instruction.op == "label"
                for operand_index in 0..<2 |operand_index, instruction, entries, issues|:
                    operand: sview = easm_first_operand(instruction.text) if operand_index == 0 else easm_last_operand(instruction.text)
                    continue if not easm_memory_operand(operand)
                    base: sview = easm_memory_base_register(operand)
                    slot: i64 = easm_provenance_slot(base)
                    if slot >= 0 and (entries[index].ambiguous & (1 << slot)) != 0:
                        issues.push(Issue{severity: Severity.Error, code: "provenance-merge-unsound", line: instruction.line, message: "memory base has conflicting typed-carrier provenance at a control-flow merge"})

        # Resolve a register's typed carrier through multi-hop mov/lea chains back to an
        # input parameter. Single-edge lookups miss intermediate copies (`HostPtr -> rcx -> rdx`).
        def easm_resolve_carrier_type(fn: Function, register: sview, limit: i64) -> sview:
            "" return if register == "" or limit <= 0
            direct: sview = easm_input_type_for_register(fn, register)
            direct return if direct != ""
            # Walk instructions in reverse, following the last write that defines `register`.
            probe: mutable i64 = fn.instructions.count.i64() - 1
            while probe >= 0 |probe, fn, register, limit|:
                candidate: Instruction = fn.instructions[probe.usize()]
                if easm_starts(candidate.op, "mov") or easm_starts(candidate.op, "lea"):
                    if easm_register_operand(easm_last_operand(candidate.text)) == register:
                        source: mutable sview = easm_register_operand(easm_first_operand(candidate.text))
                        source <- easm_memory_base_register(easm_first_operand(candidate.text)) if easm_starts(candidate.op, "lea") else source
                        return easm_resolve_carrier_type(fn, source, limit - 1)
                probe <- probe - 1
            return ""


        # Direct two-edge join fallback. This complements the fixed-point state above for the
        # common EASM shape where a conditional branch skips over one carrier assignment. Multi-hop
        # carrier chains are resolved so intermediate copies of HostPtr/GuestVAddr still meet.
        def easm_verify_simple_provenance_joins(fn: Function, issues: mutable darray[Issue]&) -> void:
            for label_index in 0..<fn.instructions.count |label_index, fn, issues|:
                continue if fn.instructions[label_index].op != "label"
                label: sview = easm_label_name(fn.instructions[label_index])
                continue if label == ""
                next: mutable usize = label_index + 1
                while next < fn.instructions.count and fn.instructions[next].op == "label":
                    next <- next + 1
                continue if next >= fn.instructions.count or not easm_memory_operand(easm_first_operand(fn.instructions[next].text))
                base: sview = easm_memory_base_register(easm_first_operand(fn.instructions[next].text))
                continue if base == ""
                for jump_index in 0..<label_index |jump_index, label_index, fn, issues, base, label|:
                    jump: Instruction = fn.instructions[jump_index]
                    continue if not easm_is_conditional_jump(jump.op) or easm_last_operand(jump.text) != label
                    before: mutable sview = ""
                    for probe in 0..<jump_index |probe, fn, base, before|:
                        candidate: Instruction = fn.instructions[probe]
                        if easm_starts(candidate.op, "mov") or easm_starts(candidate.op, "lea"):
                            if easm_register_operand(easm_last_operand(candidate.text)) == base:
                                before <- easm_register_operand(easm_first_operand(candidate.text))
                                before <- easm_memory_base_register(easm_first_operand(candidate.text)) if easm_starts(candidate.op, "lea")
                    after: mutable sview = ""
                    for probe in jump_index + 1..<label_index |probe, fn, base, after|:
                        candidate: Instruction = fn.instructions[probe]
                        if easm_starts(candidate.op, "mov") or easm_starts(candidate.op, "lea"):
                            if easm_register_operand(easm_last_operand(candidate.text)) == base:
                                after <- easm_register_operand(easm_first_operand(candidate.text))
                                after <- easm_memory_base_register(easm_first_operand(candidate.text)) if easm_starts(candidate.op, "lea")
                    before_type: sview = easm_resolve_carrier_type(fn, before, 8)
                    after_type: sview = easm_resolve_carrier_type(fn, after, 8)
                    if before != "" and after != "" and before_type != "" and after_type != "" and before_type != after_type:
                        issues.push(Issue{severity: Severity.Error, code: "provenance-merge-unsound", line: fn.instructions[next].line, message: "memory base receives different typed carriers on incoming control-flow edges"})

        def verify_control_flow_merges(fn: Function, issues: mutable darray[Issue]&) -> void:
            count: usize = fn.instructions.count
            return if count == 0
            entries: mutable darray[FlowState] = []
            meets: mutable darray[i64] = []
            incoming_counts: mutable darray[i64] = []
            for index in 0..<count |entries, meets, incoming_counts|:
                entries.push(FlowState{live: 0, stack_delta: 0, stack_mod16: 8, stack_known: true, flags_live: false, valid: false})
                meets.push(0)
                incoming_counts.push(0)
            initial_live: mutable i64 = 0
            for input in fn.inputs:
                equals: usize = easm_find(input, "=")
                if equals < sview_len(input):
                    initial_live <- initial_live | easm_register_bit(easm_register_operand(input[equals + 1.usize():sview_len(input)]))
            entries[0] <- FlowState{live: initial_live, stack_delta: 0, stack_mod16: 8, stack_known: true, flags_live: false, valid: true}
            meets[0] <- initial_live
            incoming_counts[0] <- 1
            for round_index in 0..<(count + 1) |round_index, entries, meets, incoming_counts, fn, issues|:
                changed: mutable bool = false
                for index in 0..<count |index, entries, meets, incoming_counts, fn, issues, changed|:
                    continue if not entries[index].valid
                    instruction: Instruction = fn.instructions[index]
                    state: FlowState = easm_flow_transfer(instruction, entries[index])
                    if easm_starts(instruction.op, "j"):
                        target: sview = easm_last_operand(instruction.text)
                        if sview_len(target) > 0 and sview_at(target, 0) != 37:
                            changed <- easm_propagate_flow(easm_label_index(fn.instructions, target), state, entries, meets, incoming_counts) or changed
                        if easm_is_terminator(instruction.op):
                            continue
                    if not easm_is_terminator(instruction.op) and index + 1 < count:
                        changed <- easm_propagate_flow(index.i64() + 1, state, entries, meets, incoming_counts) or changed
                break if not changed
            for index in 0..<count |index, entries, meets, incoming_counts, fn, issues|:
                continue if fn.instructions[index].op != "label" or incoming_counts[index] < 2
                label: sview = easm_label_name(fn.instructions[index])
                continue if sview_len(label) == 0
                # A declared label contract is the explicit type for the merge and is checked by
                # the ordinary contract verifier.  Contract-less merges must establish values on
                # every edge; the meet is the set that is actually safe to carry forward.
                has_contract: mutable bool = false
                for contract in fn.labels:
                    has_contract <- true if easm_equal(contract.name, label)
                continue if has_contract
                demanded: mutable i64 = 0
                probe: mutable usize = index + 1
                while probe < count:
                    next: Instruction = fn.instructions[probe]
                    demanded <- demanded | easm_read_mask(next)
                    demanded <- demanded & (~easm_written_mask(next))
                    break if easm_written_mask(next) != 0 or next.op == "label"
                    probe <- probe + 1
                missing: i64 = demanded & (~meets[index])
                if missing != 0:
                    issues.push(Issue{severity: Severity.Error, code: "merge-state-unsound", line: fn.instructions[index].line, message: "merge label carries a register that is not established on every incoming edge; declare a labels contract or write the register on every edge"})
                if entries[index].stack_known and entries[index].stack_mod16 != 0:
                    for probe_instruction in index + 1..<count |probe_instruction, fn, issues, entries|:
                        break if fn.instructions[probe_instruction].op == "label"
                        if easm_starts(fn.instructions[probe_instruction].op, "call") and not easm_contract_has_word(fn.requires, "stack.call_alignment.unchecked"):
                            issues.push(Issue{severity: Severity.Error, code: "merge-stack-alignment-unsound", line: fn.instructions[index].line, message: "merge label does not establish a common stack alignment before call"})
                            break

        # Stage0's layout size rule: an explicit size wins; otherwise the largest declared
        # field extent determines the overlay's minimum size. Stride is the fixed record size
        # for table overlays and takes precedence over the field-derived size.
        def layout_size(layout: Layout) -> i64:
            if layout.size > 0:
                return layout.size
            if layout.stride > 0:
                return layout.stride
            largest: mutable i64 = 0
            for field in layout.fields |largest|:
                extent: i64 = field.offset + field.width
                largest <- extent if extent > largest
            return largest

        # The width checked by a guest-overlay accessor. -1 means that the named field is not
        # declared; 0 means declared but width-unknown, matching stage0's layout semantics.
        def layout_field_width(layout: Layout, field_name: sview) -> i64:
            for field in layout.fields |field_name|:
                if field.name == field_name:
                    return field.width
            return -1

        # A small, pure verifier primitive shared by the eventual EASM parser and the Elisa
        # semantic overlay checks: an accessor is valid only when the field exists and its
        # declared width is either unknown or equals the machine access width.
        def layout_access_is_valid(layout: Layout, field_name: sview, access_width: i64) -> bool:
            declared_width: i64 = layout_field_width(layout, field_name)
            if declared_width < 0:
                return false
            return declared_width == 0 or declared_width == access_width

        # Resolve the standalone guest-overlay form that stage0 exposes through
        # CheckGuestOverlayAccess. This remains separate from instruction verification so a
        # named field can be checked before it is lowered to a MemoryManager operation.
        def resolve_guest_overlay_access(layout: Layout, field_name: sview, access_width: i64, issues: mutable darray[Issue]&) -> GuestOverlayAccess:
            for field in layout.fields:
                if field.name != field_name:
                    continue
                total: i64 = layout_size(layout)
                if field.width > 0 and field.offset + field.width > total:
                    issues.push(Issue{severity: Severity.Error, code: "overlay-field-out-of-bounds", line: field.line, message: "guest-overlay field extends beyond the declared layout size"})
                    return GuestOverlayAccess{layout: layout.name, field: field.name, offset: field.offset, width: field.width, access_width: access_width}
                if field.width > 0 and field.width != access_width:
                    issues.push(Issue{severity: Severity.Error, code: "overlay-field-width-mismatch", line: field.line, message: "guest-overlay access width does not match the declared field width"})
                return GuestOverlayAccess{layout: layout.name, field: field.name, offset: field.offset, width: field.width, access_width: access_width}
            issues.push(Issue{severity: Severity.Error, code: "overlay-unknown-field", line: 0, message: "guest-overlay field is not declared in the layout"})
            return GuestOverlayAccess{layout: layout.name, field: field_name, offset: -1, width: 0, access_width: access_width}

        # Parse and lower `base.field[mem]` and `base.field[mem] = value`.  This is the stage1
        # counterpart of stage0's DesugarGuestOverlayAccessor: resolution remains authoritative,
        # while the successful result can be written as the exact MemoryManager operation through
        # emit_guest_overlay_call.  The parser deliberately accepts only identifier-shaped base,
        # field, and memory names; arbitrary expressions remain the ordinary explicit API.
        def guest_overlay_identifier(text: sview, cursor: mutable usize&) -> sview:
            start: usize = cursor
            while cursor < sview_len(text) |cursor, text|:
                byte: u8 = sview_at(text, cursor)
                valid: bool = (byte >= 48 and byte <= 57) or (byte >= 65 and byte <= 90) or (byte >= 97 and byte <= 122) or byte == 95
                break if not valid
                cursor <- cursor + 1
            end: usize = cursor
            return text[start:end]

        def guest_overlay_skip_space(text: sview, cursor: mutable usize&) -> void:
            while cursor < sview_len(text) and (sview_at(text, cursor) == 32 or sview_at(text, cursor) == 9) |cursor, text|:
                cursor <- cursor + 1

        def guest_overlay_expect(text: sview, cursor: mutable usize&, expected: u8) -> bool:
            guest_overlay_skip_space(text, cursor)
            false return if cursor >= sview_len(text) or sview_at(text, cursor) != expected
            cursor <- cursor + 1
            return true

        def guest_overlay_accessor_name(width: i64, is_write: bool) -> sview:
            if is_write:
                return match width:
                    1: "MemoryManager_WriteU8"
                    2: "MemoryManager_WriteU16"
                    4: "MemoryManager_WriteU32"
                    8: "MemoryManager_WriteU64"
                    _: ""
            return match width:
                1: "MemoryManager_ReadU8"
                2: "MemoryManager_ReadU16"
                4: "MemoryManager_ReadU32"
                8: "MemoryManager_ReadU64"
                _: ""

        def desugar_guest_overlay_accessor(layout: Layout, source: sview, issues: mutable darray[Issue]&) -> GuestOverlayDesugar:
            cursor: mutable usize = 0
            guest_overlay_skip_space(source, cursor)
            base: sview = guest_overlay_identifier(source, cursor)
            if sview_len(base) == 0 or not guest_overlay_expect(source, cursor, 46):
                issues.push(Issue{severity: Severity.Error, code: "overlay-bad-accessor", line: 0, message: "expected `base.field[mem]` or `base.field[mem] = value`"})
                return GuestOverlayDesugar{access: GuestOverlayAccess{layout: "", field: "", offset: -1, width: 0, access_width: 0}, base: "", memory: "", value: "", is_write: false, accessor_name: ""}
            field: sview = guest_overlay_identifier(source, cursor)
            if sview_len(field) == 0 or not guest_overlay_expect(source, cursor, 91):
                issues.push(Issue{severity: Severity.Error, code: "overlay-bad-accessor", line: 0, message: "expected a field followed by `[memory]`"})
                return GuestOverlayDesugar{access: GuestOverlayAccess{layout: "", field: "", offset: -1, width: 0, access_width: 0}, base: "", memory: "", value: "", is_write: false, accessor_name: ""}
            memory: sview = guest_overlay_identifier(source, cursor)
            if sview_len(memory) == 0 or not guest_overlay_expect(source, cursor, 93):
                issues.push(Issue{severity: Severity.Error, code: "overlay-bad-accessor", line: 0, message: "expected a memory identifier inside brackets"})
                return GuestOverlayDesugar{access: GuestOverlayAccess{layout: "", field: "", offset: -1, width: 0, access_width: 0}, base: "", memory: "", value: "", is_write: false, accessor_name: ""}
            guest_overlay_skip_space(source, cursor)
            is_write: mutable bool = false
            value: mutable sview = ""
            if cursor < sview_len(source) and sview_at(source, cursor) == 61:
                is_write <- true
                cursor <- cursor + 1
                guest_overlay_skip_space(source, cursor)
                value <- source[cursor:sview_len(source)]
                if sview_len(value) == 0:
                    issues.push(Issue{severity: Severity.Error, code: "overlay-bad-accessor", line: 0, message: "a guest-overlay write requires a value"})
                    return GuestOverlayDesugar{access: GuestOverlayAccess{layout: "", field: "", offset: -1, width: 0, access_width: 0}, base: "", memory: "", value: "", is_write: false, accessor_name: ""}
            elif cursor != sview_len(source):
                issues.push(Issue{severity: Severity.Error, code: "overlay-bad-accessor", line: 0, message: "unexpected text after guest-overlay accessor"})
                return GuestOverlayDesugar{access: GuestOverlayAccess{layout: "", field: "", offset: -1, width: 0, access_width: 0}, base: "", memory: "", value: "", is_write: false, accessor_name: ""}

            # The named form derives its access width from the declared field, exactly as stage0
            # does; unknown fields are reported by the shared resolver.
            width: i64 = layout_field_width(layout, field)
            access: GuestOverlayAccess = resolve_guest_overlay_access(layout, field, width, issues)
            accessor: sview = guest_overlay_accessor_name(width, is_write)
            if sview_len(accessor) == 0:
                issues.push(Issue{severity: Severity.Error, code: "overlay-field-width-mismatch", line: 0, message: "guest-overlay field width has no MemoryManager accessor"})
                return GuestOverlayDesugar{access: GuestOverlayAccess{layout: "", field: "", offset: -1, width: 0, access_width: 0}, base: "", memory: "", value: "", is_write: false, accessor_name: ""}
            return GuestOverlayDesugar{access: access, base: base, memory: memory, value: value, is_write: is_write, accessor_name: accessor}

        def emit_guest_overlay_call(desugar: GuestOverlayDesugar, out: mutable darray[u8]&) -> void:
            easm_append_text(out, desugar.accessor_name)
            easm_append_text(out, "(")
            easm_append_text(out, desugar.memory)
            easm_append_text(out, ", ")
            easm_append_text(out, desugar.base)
            easm_append_text(out, " + ")
            # Offset is emitted numerically without allocating a temporary string.  The public
            # resolver remains usable even when callers only need the typed offset.
            easm_append_i64(out, desugar.access.offset)
            if desugar.is_write:
                easm_append_text(out, ", ")
                easm_append_text(out, desugar.value)
            easm_append_text(out, ")")

        # Runtime half of stage0 template assembly: copy the llvm-mc-produced image and fill its
        # typed little-endian patch slots. The caller owns `out` and therefore controls its arena;
        # the function itself performs no allocation and returns false for a missing hole value or
        # an out-of-range patch.
        def instantiate_template(image: TemplateImage, values: darray[PatchValue], out: mutable darray[u8]&) -> bool:
            for byte in image.bytes:
                out.push(byte)
            for patch in image.patches:
                supplied: mutable bool = false
                value: mutable u64 = 0
                for candidate in values:
                    if easm_equal(candidate.hole, patch.hole):
                        supplied <- true
                        value <- candidate.value
                false return if not supplied
                false return if patch.offset < 0 or patch.width < 0 or patch.offset + patch.width > out.count.i64()
                for byte_index in 0..<patch.width.usize() |out, value, patch|:
                    out[(patch.offset.usize() + byte_index)] <- (value >> (byte_index.u64() * 8)).u8()
            return true

        # Derive runtime patch bytes from two assembler images. The assembler remains an
        # external target-description authority (llvm-mc in the host driver), but the byte-diff
        # algorithm itself is stage1-owned and shared with TemplateImage instantiation. A hole
        # must preserve instruction length; each contiguous changed range becomes one PatchByte.
        def derive_template_patches(base: darray[u8], hole: sview, flipped: darray[u8], patches: mutable darray[PatchByte]&) -> bool:
            false return if base.count != flipped.count
            cursor: mutable usize = 0
            while cursor < base.count |cursor, base, flipped, hole, patches|:
                if base[cursor] == flipped[cursor]:
                    cursor <- cursor + 1
                    continue
                start: usize = cursor
                while cursor < base.count and base[cursor] != flipped[cursor] |cursor, base, flipped|:
                    cursor <- cursor + 1
                patches.push(PatchByte{hole: hole, offset: start.i64(), width: (cursor - start).i64()})
            return patches.count > 0

        def easm_append_text(out: mutable darray[u8]&, text: sview) -> void:
            for index in 0..<sview_len(text) |out, text|:
                out.push(sview_at(text, index))

        def easm_append_i64(out: mutable darray[u8]&, value: i64) -> void:
            if value < 0:
                out.push(45)
                easm_append_i64(out, 0 - value)
                return
            if value >= 10:
                easm_append_i64(out, value / 10)
            out.push((48 + (value % 10)).u8())

        def easm_append_instruction_text(out: mutable darray[u8]&, instruction: Instruction) -> void:
            if instruction.substitution_count == 0:
                easm_append_text(out, instruction.text)
                return
            cursor: mutable usize = 0
            while cursor < sview_len(instruction.text):
                replaced: mutable bool = false
                for substitution_index in 0..<instruction.substitution_count.usize() |substitution_index, instruction, out, cursor, replaced|:
                    substitution: Substitution = easm_substitution_at(instruction, substitution_index.i64())
                    if cursor + sview_len(substitution.from) <= sview_len(instruction.text) and instruction.text[cursor:cursor + sview_len(substitution.from)] == substitution.from:
                        easm_append_text(out, substitution.replacement)
                        cursor <- cursor + sview_len(substitution.from)
                        replaced <- true
                        break
                if not replaced:
                    out.push(sview_at(instruction.text, cursor))
                    cursor <- cursor + 1

        def easm_target_matches(declared: sview, target: sview) -> bool:
            if sview_len(declared) == 0 or easm_equal(declared, "any"):
                return true
            if sview_at(declared, 0) == 40:
                close: usize = easm_find(declared, ")")
                false return if close >= sview_len(declared)
                cursor: mutable usize = 1
                while cursor < close |cursor, declared, target|:
                    while cursor < close and (sview_at(declared, cursor) == 32 or sview_at(declared, cursor) == 9 or sview_at(declared, cursor) == 44):
                        cursor <- cursor + 1
                    break if cursor >= close
                    end: mutable usize = cursor
                    while end < close and sview_at(declared, end) != 44 |end, declared|:
                        end <- end + 1
                    false return if not easm_platform_key_matches(easm_trim(declared[cursor:end]), target)
                    cursor <- end + 1.usize()
                return true
            return easm_platform_key_matches(declared, target)

        def easm_platform_key_matches(key: sview, target: sview) -> bool:
            true return if key == "" or easm_equal(key, "any")
            if easm_equal(key, "x86_64") or easm_equal(key, "amd64"):
                return easm_starts(target, "x86_64") or easm_starts(target, "amd64")
            if easm_equal(key, "aarch64") or easm_equal(key, "arm64"):
                return easm_starts(target, "aarch64") or easm_starts(target, "arm64")
            return easm_find(target, key) < sview_len(target)

        # Native integration surface corresponding to stage0's nativeEASMAssemblySource: emit
        # target-filtered exported bodies as ordinary assembler text. The caller supplies the
        # output buffer/arena; pseudo instructions stay in the model for verification but do not
        # reach the assembler, and `trap` maps to the platform breakpoint mnemonic.
        def emit_native_assembly(module: Module, target: sview, out: mutable darray[u8]&) -> void:
            return if not easm_target_matches(module.target, target)
            easm_append_text(out, ".text\n")
            for fn in module.functions:
                if not easm_target_matches(fn.platform, target):
                    continue
                if sview_len(fn.name) == 0:
                    continue
                easm_append_text(out, "\n.globl ")
                if easm_starts(target, "darwin") or easm_starts(target, "macos"):
                    easm_append_text(out, "_")
                easm_append_text(out, fn.name)
                easm_append_text(out, "\n")
                if easm_starts(target, "darwin") or easm_starts(target, "macos"):
                    easm_append_text(out, "_")
                easm_append_text(out, fn.name)
                easm_append_text(out, ":\n")
                for instruction in fn.instructions:
                    continue if instruction.pseudo
                    easm_append_text(out, "\t")
                    if easm_equal(instruction.op, "trap"):
                        easm_append_text(out, "int3")
                    else:
                        easm_append_instruction_text(out, instruction)
                    easm_append_text(out, "\n")

        def easm_trim(text: sview) -> sview:
            first: mutable usize = 0
            last: mutable usize = sview_len(text)
            while first < last and (sview_at(text, first) == 32 or sview_at(text, first) == 9) |first, text, last|:
                first <- first + 1
            while last > first and (sview_at(text, last - 1.usize()) == 32 or sview_at(text, last - 1.usize()) == 9) |last, text, first|:
                last <- last - 1
            return text[first:last]

        def easm_starts(text: sview, prefix: sview) -> bool:
            false return if sview_len(text) < sview_len(prefix)
            for index in 0..<sview_len(prefix) |text, prefix|:
                false return if sview_at(text, index) != sview_at(prefix, index)
            return true

        def easm_equal(a: sview, b: sview) -> bool:
            return sview_len(a) == sview_len(b) and easm_starts(a, b)

        def easm_known_op(op: sview) -> bool:
            # Keep this list exact.  The previous prefix checks accepted spellings such as
            # `movgarbage` and every `j*` mnemonic, whereas stage0 admits only this inventory
            # (plus the parser's internal compose/state/label pseudo-ops).
            return easm_equal(op, "mov") or easm_equal(op, "movq") or easm_equal(op, "lea") or easm_equal(op, "leaq") or easm_equal(op, "push") or easm_equal(op, "pushq") or easm_equal(op, "pop") or easm_equal(op, "popq") or easm_equal(op, "movb") or easm_equal(op, "movw") or easm_equal(op, "movl") or easm_equal(op, "movsx") or easm_equal(op, "movsxd") or easm_equal(op, "movsbw") or easm_equal(op, "movsbl") or easm_equal(op, "movsbq") or easm_equal(op, "movswl") or easm_equal(op, "movswq") or easm_equal(op, "movslq") or easm_equal(op, "movzx") or easm_equal(op, "movzbw") or easm_equal(op, "movzbl") or easm_equal(op, "movzbq") or easm_equal(op, "movzwl") or easm_equal(op, "movzwq") or easm_equal(op, "xchg") or easm_equal(op, "xchgl") or easm_equal(op, "xchgq") or easm_equal(op, "add") or easm_equal(op, "addq") or easm_equal(op, "sub") or easm_equal(op, "subq") or easm_equal(op, "and") or easm_equal(op, "andq") or easm_equal(op, "or") or easm_equal(op, "orq") or easm_equal(op, "not") or easm_equal(op, "notq") or easm_equal(op, "neg") or easm_equal(op, "negq") or easm_equal(op, "xor") or easm_equal(op, "xorq") or easm_equal(op, "shl") or easm_equal(op, "shlq") or easm_equal(op, "sal") or easm_equal(op, "salq") or easm_equal(op, "shr") or easm_equal(op, "shrq") or easm_equal(op, "sar") or easm_equal(op, "sarq") or easm_equal(op, "cmp") or easm_equal(op, "cmpq") or easm_equal(op, "test") or easm_equal(op, "testq") or easm_equal(op, "inc") or easm_equal(op, "incq") or easm_equal(op, "dec") or easm_equal(op, "decq") or easm_equal(op, "call") or easm_equal(op, "callq") or easm_equal(op, "jmp") or easm_equal(op, "jmpq") or easm_equal(op, "ret") or easm_equal(op, "retq") or easm_equal(op, "je") or easm_equal(op, "jz") or easm_equal(op, "jne") or easm_equal(op, "jnz") or easm_equal(op, "jl") or easm_equal(op, "jle") or easm_equal(op, "jg") or easm_equal(op, "jge") or easm_equal(op, "jb") or easm_equal(op, "jbe") or easm_equal(op, "ja") or easm_equal(op, "jae") or easm_equal(op, "cpuid") or easm_equal(op, "cld") or easm_equal(op, "std") or easm_equal(op, "lfence") or easm_equal(op, "rdtsc") or easm_equal(op, "pause") or easm_equal(op, "yield") or easm_equal(op, "mrs") or easm_equal(op, "isb") or easm_equal(op, "fldcw") or easm_equal(op, "fnstcw") or easm_equal(op, "stmxcsr") or easm_equal(op, "ldmxcsr") or easm_equal(op, "emms") or easm_equal(op, "vzeroall") or easm_equal(op, "trap") or easm_equal(op, "compose") or easm_equal(op, "state") or easm_equal(op, "label")

        # Public operation-table probes used by the parity harness and by future backend passes.
        # Keeping these wrappers beside the verifier prevents the parser/emitter from silently
        # drifting from the stage0 operation inventory.
        def operation_is_known(op: sview) -> bool:
            return easm_known_op(op)

        def operation_capability(op: sview) -> sview:
            return easm_required_capability(op)

        def easm_register_operand(operand: sview) -> sview:
            value: sview = easm_trim(operand)
            if sview_len(value) > 0 and sview_at(value, 0) == 37:
                end: mutable usize = 1
                while end < sview_len(value) |end, value|:
                    byte: u8 = sview_at(value, end)
                    break if not ((byte >= 48 and byte <= 57) or (byte >= 65 and byte <= 90) or (byte >= 97 and byte <= 122) or byte == 95)
                    end <- end + 1
                return value[1:end]
            # Contract bindings use bare names (`a = rdi`), while instruction operands use
            # AT&T's `%rdi`.  Both spellings denote the same machine register.
            return value if easm_register_bit(value) != 0 else ""

        def easm_first_operand(text: sview) -> sview:
            start: usize = easm_first_space(text)
            if start >= sview_len(text):
                return ""
            rest: sview = easm_trim(text[start:sview_len(text)])
            comma: usize = easm_find(rest, ",")
            return rest[0:comma]

        def easm_last_operand(text: sview) -> sview:
            comma: mutable usize = sview_len(text)
            for index in 0..<sview_len(text) |comma, text|:
                comma <- index if sview_at(text, index) == 44
            if comma >= sview_len(text):
                start: usize = easm_first_space(text)
                if start >= sview_len(text):
                    return ""
                return easm_trim(text[start:sview_len(text)])
            return easm_trim(text[comma + 1.usize():sview_len(text)])

        def easm_contract_has_register(values: darray[sview], register: sview) -> bool:
            for value in values:
                equals: usize = easm_find(value, "=")
                if equals < sview_len(value):
                    declared: sview = easm_register_operand(value[equals + 1.usize():sview_len(value)])
                    if easm_equal(declared, register):
                        return true
                if easm_find(value, register) < sview_len(value):
                    return true
            return false

        def easm_contract_has_word(values: darray[sview], needle: sview) -> bool:
            for value in values:
                if easm_find(value, needle) < sview_len(value):
                    return true
            return false

        def easm_contract_has_exact(values: darray[sview], needle: sview) -> bool:
            for value in values:
                cursor: mutable usize = 0
                while cursor < sview_len(value) |cursor, value, needle|:
                    while cursor < sview_len(value) and (sview_at(value, cursor) == 32 or sview_at(value, cursor) == 9 or sview_at(value, cursor) == 44):
                        cursor <- cursor + 1
                    break if cursor >= sview_len(value)
                    end: mutable usize = cursor
                    while end < sview_len(value) and sview_at(value, end) != 44 |end, value|:
                        end <- end + 1
                    true return if easm_equal(easm_trim(value[cursor:end]), needle)
                    cursor <- end + 1.usize()
            return false

        def easm_effect_present(effects: darray[sview]&, wanted: sview) -> bool:
            for effect in effects:
                true return if effect == wanted
            return false

        def easm_add_effect(effects: mutable darray[sview]&, wanted: sview) -> void:
            effects.push(wanted) if not easm_effect_present(effects, wanted)

        # Derive the complete caller-facing effect set from the verified EASM contract. This is
        # the stage1 counterpart of stage0's DerivedEffects: raw EASM always carries the unsafe
        # floor, while explicit machine capabilities and final fs ownership add narrower effects.
        def easm_derived_effects(fn: Function) -> darray[sview]:
            effects: mutable darray[sview] = []
            easm_add_effect(effects, "Unsafe.RawExtern")
            for requirement in fn.requires:
                if requirement == "x86_64.segment.write":
                    easm_add_effect(effects, "Unsafe.SegmentMutation")
                elif requirement == "control.indirect" or requirement == "control.target.untyped":
                    easm_add_effect(effects, "Unsafe.IndirectCall")
                elif requirement == "memory.base.untyped":
                    easm_add_effect(effects, "Unsafe.PointerCast")
            owner: mutable sview = ""
            for instruction in fn.instructions:
                continue if instruction.op != "state"
                text: sview = easm_trim(instruction.text)
                continue if not easm_starts(text, "fs:")
                state: sview = easm_trim(text[3:sview_len(text)])
                owner <- "guest" if easm_starts(state, "guest")
                owner <- "host" if easm_starts(state, "host")
            if owner == "guest":
                easm_add_effect(effects, "Unsafe.GuestSegmentInstall")
                easm_add_effect(effects, "Segment.Guest")
            elif owner == "host":
                easm_add_effect(effects, "Segment.Host")
            return effects

        # Select the machine body consumed by native/LLVM lowering: the selected target variant
        # wins, then a primary body, with a reference body as the final fallback for lockstep-only
        # declarations. The copy is intentional so callers can materialize or rewrite it safely.
        def easm_emitted_body(fn: Function) -> darray[Instruction]:
            return fn.targets[0].instructions if fn.targets.count > 0 else fn.reference if fn.instructions.count == 0 and fn.reference.count > 0 else fn.instructions

        def easm_register_contract_atom_valid(atom: sview) -> bool:
            value: mutable sview = easm_trim(atom)
            value <- value[1:sview_len(value)] if sview_len(value) > 0 and sview_at(value, 0) == 37
            true return if value == "memory" or value == "memory.read" or value == "memory.write" or value == "cc" or value == "flags" or value == "callee_saved"
            return easm_register_bit(value) != 0

        def easm_register_contract_values_valid(value: sview) -> bool:
            trimmed: sview = easm_trim(value)
            true return if sview_len(trimmed) == 0
            start: mutable usize = 0
            index: mutable usize = 0
            while index <= sview_len(trimmed) |index, start, trimmed|:
                if index == sview_len(trimmed) or sview_at(trimmed, index) == 44:
                    false return if not easm_register_contract_atom_valid(easm_trim(trimmed[start:index]))
                    start <- index + 1
                index <- index + 1
            return true

        def easm_verify_register_contracts(fn: Function, issues: mutable darray[Issue]&) -> void:
            for clobber in fn.clobbers:
                if not easm_register_contract_values_valid(clobber):
                    issues.push(Issue{severity: Severity.Error, code: "invalid-clobber-register", line: fn.line, message: "clobbers contains an unknown register or machine atom"})
            for preserve in fn.preserves:
                if not easm_register_contract_values_valid(preserve):
                    issues.push(Issue{severity: Severity.Error, code: "invalid-preserve-register", line: fn.line, message: "preserves contains an unknown register or machine atom"})

        def easm_live_has(live: darray[sview], register: sview) -> bool:
            for existing in live:
                if easm_equal(existing, register):
                    return true
            return false

        def easm_memory_operand(operand: sview) -> bool:
            return easm_find(operand, "(") < sview_len(operand) or easm_find(operand, "[") < sview_len(operand)

        def easm_memory_reads(instruction: Instruction) -> bool:
            false return if instruction.pseudo or easm_starts(instruction.op, "lea")
            source: sview = easm_first_operand(instruction.text)
            destination: sview = easm_last_operand(instruction.text)
            source_memory: bool = easm_memory_operand(source)
            destination_memory: bool = easm_memory_operand(destination)
            false return if easm_starts(instruction.op, "fnstcw") or easm_starts(instruction.op, "stmxcsr")
            true return if source_memory
            # AT&T read-modify-write operations have a memory destination but also consume
            # the old memory value. This distinction is part of stage0's memory-direction
            # contract; a write-only clobber must not discharge the read obligation.
            true return if destination_memory and (easm_starts(instruction.op, "add") or easm_starts(instruction.op, "sub") or easm_starts(instruction.op, "and") or easm_starts(instruction.op, "or") or easm_starts(instruction.op, "xor") or easm_starts(instruction.op, "inc") or easm_starts(instruction.op, "dec") or easm_starts(instruction.op, "neg") or easm_starts(instruction.op, "not") or easm_starts(instruction.op, "sh") or easm_starts(instruction.op, "sa") or easm_starts(instruction.op, "cmp") or easm_starts(instruction.op, "test") or easm_starts(instruction.op, "xchg") or easm_starts(instruction.op, "call") or easm_starts(instruction.op, "jmp"))
            return false

        def easm_memory_writes(instruction: Instruction) -> bool:
            false return if instruction.pseudo or easm_starts(instruction.op, "lea")
            destination: sview = easm_last_operand(instruction.text)
            if not easm_memory_operand(destination):
                return false
            true return if easm_starts(instruction.op, "fnstcw") or easm_starts(instruction.op, "stmxcsr")
            true return if easm_starts(instruction.op, "add") or easm_starts(instruction.op, "sub") or easm_starts(instruction.op, "and") or easm_starts(instruction.op, "or") or easm_starts(instruction.op, "xor") or easm_starts(instruction.op, "inc") or easm_starts(instruction.op, "dec") or easm_starts(instruction.op, "neg") or easm_starts(instruction.op, "not") or easm_starts(instruction.op, "sh") or easm_starts(instruction.op, "sa") or easm_starts(instruction.op, "xchg")
            false return if easm_starts(instruction.op, "fldcw") or easm_starts(instruction.op, "ldmxcsr") or easm_starts(instruction.op, "cmp") or easm_starts(instruction.op, "test") or easm_starts(instruction.op, "push") or easm_starts(instruction.op, "call") or easm_starts(instruction.op, "jmp")
            return true

        def easm_reads_destination(instruction: Instruction) -> bool:
            false return if instruction.pseudo
            destination: sview = easm_register_operand(easm_last_operand(instruction.text))
            false return if destination == ""
            false return if easm_self_zeroing(instruction)
            return easm_starts(instruction.op, "add") or easm_starts(instruction.op, "sub") or easm_starts(instruction.op, "and") or easm_starts(instruction.op, "or") or easm_starts(instruction.op, "xor") or easm_starts(instruction.op, "cmp") or easm_starts(instruction.op, "test") or easm_starts(instruction.op, "inc") or easm_starts(instruction.op, "dec") or easm_starts(instruction.op, "neg") or easm_starts(instruction.op, "not") or easm_starts(instruction.op, "sh") or easm_starts(instruction.op, "sa") or easm_starts(instruction.op, "xchg")

        def easm_self_zeroing(instruction: Instruction) -> bool:
            false return if instruction.pseudo
            source: sview = easm_register_operand(easm_first_operand(instruction.text))
            destination: sview = easm_register_operand(easm_last_operand(instruction.text))
            return source != "" and source == destination and (easm_starts(instruction.op, "xor") or easm_starts(instruction.op, "sub"))

        def easm_memory_base_register(operand: sview) -> sview:
            open: usize = easm_find(operand, "(")
            if open >= sview_len(operand):
                return ""
            close: usize = easm_find(operand[open:sview_len(operand)], ")") + open
            if close <= open:
                return ""
            inside: mutable sview = operand[open + 1.usize():close]
            comma: usize = easm_find(inside, ",")
            if comma < sview_len(inside):
                inside <- inside[0:comma]
            return easm_register_operand(inside)

        def easm_memory_index_register(operand: sview) -> sview:
            open: usize = easm_find(operand, "(")
            if open >= sview_len(operand):
                return ""
            close: usize = easm_find(operand[open:sview_len(operand)], ")") + open
            if close <= open:
                return ""
            inside: sview = operand[open + 1.usize():close]
            comma: usize = easm_find(inside, ",")
            if comma >= sview_len(inside):
                return ""
            rest: mutable sview = inside[comma + 1.usize():sview_len(inside)]
            second_comma: usize = easm_find(rest, ",")
            if second_comma < sview_len(rest):
                rest <- rest[0:second_comma]
            return easm_register_operand(rest)

        def easm_raw_scalar_type(type_name: sview) -> bool:
            return easm_equal(type_name, "u8") or easm_equal(type_name, "u16") or easm_equal(type_name, "u32") or easm_equal(type_name, "u64") or easm_equal(type_name, "i8") or easm_equal(type_name, "i16") or easm_equal(type_name, "i32") or easm_equal(type_name, "i64") or easm_equal(type_name, "usize") or easm_equal(type_name, "uintptr")

        def easm_carrier_layout(type_name: sview) -> sview:
            open: usize = easm_find(type_name, "[")
            if open >= sview_len(type_name):
                return ""
            close: usize = easm_find(type_name[open:sview_len(type_name)], "]") + open
            if close <= open:
                return ""
            return easm_trim(type_name[open + 1.usize():close])

        def easm_memory_displacement(operand: sview) -> i64:
            open: usize = easm_find(operand, "(")
            if open >= sview_len(operand):
                return 0
            prefix: sview = easm_trim(operand[0:open])
            if sview_len(prefix) == 0:
                return 0
            return easm_parse_i64(prefix)

        def easm_size_guard_lower_bound(facts: darray[sview]) -> i64:
            greatest: mutable i64 = 0
            for fact in facts:
                marker: usize = easm_find(fact, "size >=")
                continue if marker >= sview_len(fact)
                value: i64 = easm_parse_i64(easm_trim(fact[marker + 7.usize():sview_len(fact)]))
                greatest <- value if value > greatest
            return greatest

        # Coq EASM-TAL's memory-state correspondence.  A refinement raises the known
        # minimum size, while a control-flow join keeps only the weaker (minimum) bound.
        # These small pure operations are also useful to validation clients: they make the
        # proof-side lattice explicit instead of duplicating its arithmetic in a test harness.
        def easm_memstate_join_min(left: i64, right: i64) -> i64:
            return left if left < right else right

        def easm_memstate_read_well_typed(need: i64, known_min: i64) -> bool:
            return need <= known_min

        def easm_memstate_guard_join(left: i64, right: i64, need: i64) -> bool:
            return easm_memstate_read_well_typed(need, easm_memstate_join_min(left, right))

        def easm_access_width(op: sview) -> i64:
            if easm_starts(op, "movb") or easm_equal(op, "xchgb"):
                return 1
            if easm_starts(op, "movw") or easm_equal(op, "xchgw"):
                return 2
            if easm_starts(op, "movl") or easm_equal(op, "xchgl"):
                return 4
            if easm_starts(op, "movq") or easm_equal(op, "xchgq"):
                return 8
            return 0

        def easm_input_type_for_register(fn: Function, register: sview) -> sview:
            for input in fn.inputs:
                equals: usize = easm_find(input, "=")
                if equals < sview_len(input):
                    bound_register: sview = easm_register_operand(input[equals + 1.usize():sview_len(input)])
                    if easm_equal(bound_register, register):
                        return easm_param_type(fn, easm_binding_name(input))
            return ""

        def easm_has_raw_scalar_input(fn: Function) -> bool:
            for parameter in fn.params:
                true return if easm_raw_scalar_type(parameter.type_name)
            return false

        def easm_provenance_type(states: mutable darray[MemoryProvenance]&, register: sview) -> sview:
            for state in states:
                if easm_equal(state.register, register):
                    return state.type_name
            return ""

        def easm_provenance_set_parameter(states: mutable darray[MemoryProvenance]&, register: sview, type_name: sview, parameter: sview) -> void:
            for index in 0..<states.count |index, states, register, type_name|:
                if easm_equal(states[index].register, register):
                    retained_parameter: sview = parameter if parameter != "" else states[index].parameter
                    states[index] <- MemoryProvenance{register: register, type_name: type_name, parameter: retained_parameter}
                    return
            states.push(MemoryProvenance{register: register, type_name: type_name, parameter: parameter})

        def easm_provenance_set(states: mutable darray[MemoryProvenance]&, register: sview, type_name: sview) -> void:
            easm_provenance_set_parameter(states, register, type_name, "")

        def easm_provenance_parameter(states: mutable darray[MemoryProvenance]&, register: sview) -> sview:
            for state in states:
                if easm_equal(state.register, register):
                    return state.parameter
            return ""

        # Carry a pointer carrier through the register-preserving address operations recognized by
        # stage0. A move/lea does not turn a raw scalar into a typed pointer, and add/sub/inc/dec
        # preserve the carrier while changing its displacement. Other register writes erase the
        # proof instead of allowing a stale type to justify a later dereference.
        def easm_update_memory_provenance(states: mutable darray[MemoryProvenance]&, instruction: Instruction) -> void:
            if instruction.pseudo:
                return
            destination: sview = easm_register_operand(easm_last_operand(instruction.text))
            if destination == "":
                return
            op: sview = instruction.op
            source: sview = easm_first_operand(instruction.text)
            inherited: mutable sview = ""
            inherited_parameter: mutable sview = ""
            if easm_starts(op, "mov"):
                source_register: sview = easm_register_operand(source)
                inherited <- easm_provenance_type(states, source_register)
                inherited_parameter <- easm_provenance_parameter(states, source_register)
            elif easm_starts(op, "lea"):
                source_register: sview = easm_memory_base_register(source)
                inherited <- easm_provenance_type(states, source_register)
                inherited_parameter <- easm_provenance_parameter(states, source_register)
            elif easm_starts(op, "add") or easm_starts(op, "sub") or easm_starts(op, "inc") or easm_starts(op, "dec"):
                inherited <- easm_provenance_type(states, destination)
                inherited_parameter <- easm_provenance_parameter(states, destination)
            easm_provenance_set_parameter(states, destination, inherited, inherited_parameter)

        def memory_provenance_type(fn: Function, register: sview) -> sview:
            states: mutable darray[MemoryProvenance] = []
            for input in fn.inputs:
                bound: sview = easm_binding_register(input)
                if bound != "":
                    easm_provenance_set_parameter(states, bound, easm_param_type(fn, easm_binding_name(input)), easm_binding_name(input))
            for instruction in fn.instructions:
                easm_update_memory_provenance(states, instruction)
            return easm_provenance_type(states, register)

        def easm_layout_field_at(layout: Layout, offset: i64) -> LayoutField:
            for field in layout.fields:
                if field.offset == offset:
                    return field
            return LayoutField{offset: -1, name: "", type_name: "", width: 0, requires_size_at_least: 0, line: 0}

        def easm_verify_memory_roles(fn: Function, layouts: darray[Layout], issues: mutable darray[Issue]&) -> void:
            states: mutable darray[MemoryProvenance] = []
            for input in fn.inputs:
                register: sview = easm_binding_register(input)
                if register != "":
                    easm_provenance_set(states, register, easm_param_type(fn, easm_binding_name(input)))
            # Keep the raw-carrier guard in a direct second pass as well as the layout pass below.
            # This makes the safety obligation independent of layout resolution: a raw scalar must
            # never become a dereferenceable base merely because it was copied to another register.
            for instruction_index in 0..<fn.instructions.count |instruction_index, fn, issues|:
                instruction: Instruction = fn.instructions[instruction_index]
                continue if instruction.pseudo or easm_starts(instruction.op, "lea")
                if easm_find(instruction.text, "(") < sview_len(instruction.text):
                    base: sview = easm_memory_base_register(easm_first_operand(instruction.text))
                    carried_type: sview = memory_provenance_type(fn, base)
                    if base != "" and base != "rsp" and base != "rip" and easm_raw_scalar_type(carried_type) and not easm_contract_has_word(fn.requires, "memory.base.untyped"):
                        issues.push(Issue{severity: Severity.Error, code: "raw-memory-base", line: instruction.line, message: "raw scalar register used as a memory base; use a typed pointer carrier or require memory.base.untyped"})
            for instruction in fn.instructions:
                continue if instruction.pseudo
                if not easm_starts(instruction.op, "lea"):
                    for operand_index in 0..<2 |operand_index, instruction, states, fn, layouts, issues|:
                        operand: sview = easm_first_operand(instruction.text) if operand_index == 0 else easm_last_operand(instruction.text)
                        continue if not easm_memory_operand(operand)
                        base: sview = easm_memory_base_register(operand)
                        continue if base == "" or easm_equal(base, "rsp") or easm_equal(base, "rip")
                        type_name: mutable sview = easm_provenance_type(states, base)
                        if type_name == "":
                            type_name <- easm_input_type_for_register(fn, base)
                            # An untraced base in a routine that accepts raw address-sized values
                            # is not safe to treat as an ordinary pointer. This conservative edge
                            # keeps a failed provenance meet from becoming an unchecked dereference.
                            if type_name == "" and easm_has_raw_scalar_input(fn) and not easm_contract_has_word(fn.requires, "memory.base.untyped"):
                                issues.push(Issue{severity: Severity.Error, code: "raw-memory-base", line: instruction.line, message: "memory base provenance was not established from a typed carrier"})
                        if (easm_raw_scalar_type(type_name) or type_name == "uintptr") and not easm_contract_has_word(fn.requires, "memory.base.untyped"):
                            issues.push(Issue{severity: Severity.Error, code: "raw-memory-base", line: instruction.line, message: "raw scalar register used as a memory base; use a typed pointer carrier or require memory.base.untyped"})
                        layout_name: sview = easm_carrier_layout(type_name)
                        if layout_name == "":
                            continue
                        for layout in layouts:
                            if not easm_equal(layout.name, layout_name):
                                continue
                            field: LayoutField = easm_layout_field_at(layout, easm_memory_displacement(operand))
                            if field.offset < 0:
                                issues.push(Issue{severity: Severity.Error, code: "layout-unknown-field", line: instruction.line, message: "memory displacement is not a declared field in the carrier layout"})
                                continue
                            width: i64 = easm_access_width(instruction.op)
                            if width > 0 and field.width > 0 and width != field.width:
                                issues.push(Issue{severity: Severity.Error, code: "layout-field-width-mismatch", line: instruction.line, message: "memory access width does not match the declared layout field width"})
                            if field.requires_size_at_least > 0 and easm_size_guard_lower_bound(fn.facts) < field.requires_size_at_least:
                                issues.push(Issue{severity: Severity.Error, code: "overlay-field-needs-size-guard", line: instruction.line, message: "layout field requires a dominating runtime size guard at least as strong as its declared lower bound"})
                easm_update_memory_provenance(states, instruction)
            easm_verify_provenance_merges(fn, issues)
            easm_verify_simple_provenance_joins(fn, issues)

        def easm_verify_frame_contracts(fn: Function, issues: mutable darray[Issue]&) -> void:
            return if fn.reads.count == 0 and fn.changes.count == 0
            for carrier in fn.reads:
                if easm_param_type(fn, easm_trim(carrier)) == "":
                    issues.push(Issue{severity: Severity.Error, code: "frame-unknown-carrier", line: fn.line, message: "reads names a parameter that is not present in the EASM signature"})
            for carrier in fn.changes:
                if easm_param_type(fn, easm_trim(carrier)) == "":
                    issues.push(Issue{severity: Severity.Error, code: "frame-unknown-carrier", line: fn.line, message: "changes names a parameter that is not present in the EASM signature"})
            states: mutable darray[MemoryProvenance] = []
            for input in fn.inputs:
                bound: sview = easm_binding_register(input)
                if bound != "":
                    easm_provenance_set_parameter(states, bound, easm_param_type(fn, easm_binding_name(input)), easm_binding_name(input))
            for instruction in fn.instructions:
                continue if instruction.pseudo
                source: sview = easm_first_operand(instruction.text)
                destination: sview = easm_last_operand(instruction.text)
                source_is_memory: bool = easm_memory_operand(source)
                destination_is_memory: bool = easm_memory_operand(destination)
                if source_is_memory or destination_is_memory:
                    memory_operand: sview = destination if destination_is_memory else source
                    base: sview = easm_memory_base_register(memory_operand)
                    if base != "" and base != "rsp" and base != "rip":
                        carrier_name: sview = easm_provenance_parameter(states, base)
                        if carrier_name != "":
                            if destination_is_memory and not easm_contract_has_word(fn.changes, carrier_name):
                                issues.push(Issue{severity: Severity.Error, code: "frame-write-outside-changes", line: instruction.line, message: "memory write uses a carrier not listed in changes"})
                            if source_is_memory and not destination_is_memory and not easm_contract_has_word(fn.reads, carrier_name) and not easm_contract_has_word(fn.changes, carrier_name):
                                issues.push(Issue{severity: Severity.Error, code: "frame-read-outside-reads", line: instruction.line, message: "memory read uses a carrier not listed in reads or changes"})
                easm_update_memory_provenance(states, instruction)

        def easm_verify_machine_roles(fn: Function, issues: mutable darray[Issue]&) -> void:
            if easm_contract_has_word(fn.requires, "x86_64.segment.write") and not easm_contract_has_word(fn.requires, "x86_64.segment.selector.untyped"):
                for parameter in fn.params:
                    if easm_find(easm_trim(parameter.name), "selector") < sview_len(easm_trim(parameter.name)) and easm_raw_scalar_type(parameter.type_name):
                        issues.push(Issue{severity: Severity.Error, code: "raw-segment-selector", line: fn.line, message: "segment-mutating EASM requires a typed segment selector or an explicit untyped override"})
            if easm_contract_has_word(fn.requires, "control.indirect") and not easm_contract_has_word(fn.requires, "control.target.untyped"):
                for input in fn.inputs:
                    parameter_name: sview = easm_trim(easm_binding_name(input))
                    if (easm_find(parameter_name, "target") < sview_len(parameter_name) or easm_find(parameter_name, "callee") < sview_len(parameter_name)) and easm_raw_scalar_type(easm_param_type(fn, parameter_name)):
                        issues.push(Issue{severity: Severity.Error, code: "raw-indirect-control-target", line: fn.line, message: "indirect-control target must use a typed callable role or an explicit untyped override"})
            if (easm_contract_has_word(fn.control, "tail_jumps") or easm_contract_has_word(fn.control, "noreturn")) and not easm_contract_has_word(fn.requires, "stack.owner.untyped"):
                for parameter in fn.params:
                    parameter_name: sview = easm_trim(parameter.name)
                    if easm_find(parameter_name, "stack") < sview_len(parameter_name) and easm_find(parameter_name, "top") < sview_len(parameter_name) and easm_raw_scalar_type(parameter.type_name):
                        issues.push(Issue{severity: Severity.Error, code: "raw-stack-handoff", line: fn.line, message: "stack handoff must use a typed stack role or an explicit untyped override"})

        def easm_param_type(fn: Function, name: sview) -> sview:
            for parameter in fn.params:
                if easm_equal(parameter.name, name):
                    return parameter.type_name
            return ""

        def easm_binding_name(binding: sview) -> sview:
            equals: usize = easm_find(binding, "=")
            if equals >= sview_len(binding):
                return ""
            return easm_trim(binding[0:equals])

        def easm_memory_uses_register(text: sview, register: sview) -> bool:
            if easm_equal(register, "rax"):
                return easm_find(text, "%rax)") < sview_len(text)
            if easm_equal(register, "rcx"):
                return easm_find(text, "%rcx)") < sview_len(text)
            if easm_equal(register, "rdx"):
                return easm_find(text, "%rdx)") < sview_len(text)
            if easm_equal(register, "rbx"):
                return easm_find(text, "%rbx)") < sview_len(text)
            if easm_equal(register, "rsi"):
                return easm_find(text, "%rsi)") < sview_len(text)
            if easm_equal(register, "rdi"):
                return easm_find(text, "%rdi)") < sview_len(text)
            if easm_equal(register, "rbp"):
                return easm_find(text, "%rbp)") < sview_len(text)
            if easm_equal(register, "rsp"):
                return easm_find(text, "%rsp)") < sview_len(text)
            if easm_equal(register, "r8"):
                return easm_find(text, "%r8)") < sview_len(text)
            if easm_equal(register, "r9"):
                return easm_find(text, "%r9)") < sview_len(text)
            if easm_equal(register, "r10"):
                return easm_find(text, "%r10)") < sview_len(text)
            if easm_equal(register, "r11"):
                return easm_find(text, "%r11)") < sview_len(text)
            if easm_equal(register, "r12"):
                return easm_find(text, "%r12)") < sview_len(text)
            if easm_equal(register, "r13"):
                return easm_find(text, "%r13)") < sview_len(text)
            if easm_equal(register, "r14"):
                return easm_find(text, "%r14)") < sview_len(text)
            if easm_equal(register, "r15"):
                return easm_find(text, "%r15)") < sview_len(text)
            return false

        def easm_verify_handles(fn: Function, issues: mutable darray[Issue]&) -> void:
            handle_registers: mutable darray[sview] = []
            handle_kinds: mutable darray[sview] = []
            for input in fn.inputs:
                name: sview = easm_binding_name(input)
                typ: sview = easm_param_type(fn, name)
                if easm_starts(typ, "Handle[") and easm_find(typ, "]") < sview_len(typ):
                    equals: usize = easm_find(input, "=")
                    register: sview = easm_register_operand(input[equals + 1.usize():sview_len(input)])
                    if sview_len(register) > 0:
                        handle_registers.push(register)
                        close: usize = easm_find(typ, "]")
                        handle_kinds.push(typ[7:close])
            for instruction in fn.instructions:
                continue if instruction.pseudo
                for handle_index in 0..<handle_registers.count |handle_registers, handle_kinds, instruction, fn, issues|:
                    if easm_memory_uses_register(instruction.text, handle_registers[handle_index]) and easm_memory_operand(instruction.text):
                        issues.push(Issue{severity: Severity.Error, code: "handle-deref-forbidden", line: instruction.line, message: "opaque Handle value cannot be used as a memory base"})

        def easm_callee_saved_unprotected(fn: Function) -> bool:
            if easm_contract_has_word(fn.preserves, "callee_saved") or easm_contract_has_word(fn.requires, "callee_saved.preservation.unchecked"):
                return false
            return (easm_contract_has_word(fn.clobbers, "rbx") or easm_contract_has_word(fn.clobbers, "rbp") or easm_contract_has_word(fn.clobbers, "r12") or easm_contract_has_word(fn.clobbers, "r13") or easm_contract_has_word(fn.clobbers, "r14") or easm_contract_has_word(fn.clobbers, "r15")) and not easm_contract_has_word(fn.preserves, "rbx") and not easm_contract_has_word(fn.preserves, "rbp") and not easm_contract_has_word(fn.preserves, "r12") and not easm_contract_has_word(fn.preserves, "r13") and not easm_contract_has_word(fn.preserves, "r14") and not easm_contract_has_word(fn.preserves, "r15")

        def easm_verify_callee_saved_preservation(fn: Function, issues: mutable darray[Issue]&) -> void:
            registers: darray[sview] = ["rbx", "rbp", "r12", "r13", "r14", "r15"]
            for register in registers:
                if easm_contract_has_exact(fn.preserves, register) and not easm_contract_has_exact(fn.clobbers, register):
                    issues.push(Issue{severity: Severity.Error, code: "preserve-without-clobber", line: fn.line, message: "preserves declares a callee-saved register that is absent from clobbers"})
                preserved: bool = easm_contract_has_exact(fn.preserves, register) or easm_contract_has_exact(fn.preserves, "callee_saved")
                continue if not preserved or not easm_contract_has_exact(fn.clobbers, register) or easm_contract_has_exact(fn.requires, "callee_saved.preservation.unchecked")
                saved: mutable bool = false
                written: mutable bool = false
                restored_after_write: mutable bool = false
                for instruction in fn.instructions:
                    continue if instruction.pseudo
                    source: sview = easm_register_operand(easm_first_operand(instruction.text))
                    destination: sview = easm_register_operand(easm_last_operand(instruction.text))
                    if easm_starts(instruction.op, "push") and source == register:
                        saved <- true
                    if easm_starts(instruction.op, "pop") and destination == register:
                        restored_after_write <- true if written and saved
                    if destination == register and not easm_starts(instruction.op, "pop") and not easm_starts(instruction.op, "push"):
                        written <- true
                    if easm_starts(instruction.op, "mov") and source == register and easm_memory_operand(easm_last_operand(instruction.text)) and easm_memory_base_register(easm_last_operand(instruction.text)) == "rsp":
                        saved <- true
                    if easm_starts(instruction.op, "mov") and destination == register and easm_memory_operand(easm_first_operand(instruction.text)) and easm_memory_base_register(easm_first_operand(instruction.text)) == "rsp":
                        restored_after_write <- true if written and saved
                if written and not restored_after_write:
                    issues.push(Issue{severity: Severity.Error, code: "callee-saved-preservation-unproven", line: fn.line, message: "callee-saved register is clobbered but no save-before-write and restore-after-write proof was found"})

        def easm_required_capability(op: sview) -> sview:
            if easm_equal(op, "xchg") or easm_equal(op, "xchgl") or easm_equal(op, "xchgq"):
                return "x86_64.atomic.rmw"
            if easm_equal(op, "cpuid"):
                return "x86_64.cpuid"
            if easm_equal(op, "rdtsc"):
                return "x86_64.rdtsc"
            if easm_equal(op, "lfence"):
                return "x86_64.sse.lfence"
            if easm_equal(op, "pause"):
                return "x86_64.sse.pause"
            if easm_equal(op, "yield"):
                return "aarch64.yield"
            if easm_equal(op, "mrs") or easm_equal(op, "isb"):
                return "aarch64.cntvct"
            if easm_equal(op, "fldcw") or easm_equal(op, "fnstcw") or easm_equal(op, "stmxcsr") or easm_equal(op, "ldmxcsr") or easm_equal(op, "emms"):
                return "x86_64.fpu_control"
            if easm_equal(op, "vzeroall"):
                return "x86_64.simd_state"
            if easm_equal(op, "trap"):
                return "debug.trap"
            return ""

        def easm_operation_effect(op: sview) -> OperationEffect:
            known: bool = easm_known_op(op)
            capability: sview = easm_required_capability(op)
            flags: bool = easm_equal(op, "add") or easm_equal(op, "addq") or easm_equal(op, "sub") or easm_equal(op, "subq") or easm_equal(op, "and") or easm_equal(op, "andq") or easm_equal(op, "or") or easm_equal(op, "orq") or easm_equal(op, "xor") or easm_equal(op, "xorq") or easm_equal(op, "inc") or easm_equal(op, "incq") or easm_equal(op, "dec") or easm_equal(op, "decq") or easm_equal(op, "neg") or easm_equal(op, "negq") or easm_equal(op, "cmp") or easm_equal(op, "cmpq") or easm_equal(op, "test") or easm_equal(op, "testq") or easm_equal(op, "shl") or easm_equal(op, "shlq") or easm_equal(op, "sal") or easm_equal(op, "salq") or easm_equal(op, "shr") or easm_equal(op, "shrq") or easm_equal(op, "sar") or easm_equal(op, "sarq") or easm_equal(op, "cld") or easm_equal(op, "std")
            implicit_reads: i64 = easm_implicit_read_mask(op)
            implicit_writes: mutable i64 = easm_implicit_write_mask(op)
            if easm_equal(op, "call") or easm_equal(op, "callq"):
                implicit_writes <- 1 | 2 | 4 | 16 | 32 | 256 | 512 | 1024 | 2048
            return OperationEffect{known: known, capability: capability, clobbers_flags: flags, implicit_cc: easm_equal(op, "call") or easm_equal(op, "callq"), implicit_reads: implicit_reads, implicit_writes: implicit_writes, result_defines: easm_equal(op, "cpuid") or easm_equal(op, "rdtsc")}

        def easm_implicit_read_mask(op: sview) -> i64:
            if easm_equal(op, "cpuid"):
                return 1 | 2
            return 0

        def easm_implicit_write_mask(op: sview) -> i64:
            if easm_equal(op, "cpuid"):
                return 1 | 8 | 2 | 4
            if easm_equal(op, "rdtsc"):
                return 1 | 4
            return 0

        def easm_mask_has_register(mask: i64, register: sview) -> bool:
            bit: i64 = easm_register_bit(register)
            return bit != 0 and (mask & bit) != 0

        def easm_immediate_after_dollar(text: sview) -> i64:
            dollar: usize = easm_find(text, "$")
            if dollar >= sview_len(text):
                return 0
            return easm_parse_i64(easm_trim(text[dollar + 1.usize():sview_len(text)]))


        # Lockstep bodies are independently executable implementations.  Stage0 verifies the
        # reference and every target with the complete ordinary-function verifier; keeping only
        # the structural lockstep checks here would let a target bypass capability, clobber,
        # memory, frame, handle, or register-read enforcement.  Build an isolated one-function
        # view with the selected body and send it through verify_module's ordinary path.
        def verify_lockstep_body(module: Module, source: Function, instructions: darray[Instruction]) -> darray[Issue]:
            body: mutable Function = source
            body.instructions <- instructions
            body.reference <- []
            body.targets <- []
            body_module: mutable Module = module
            body_module.functions <- [body]
            body_module.fragments <- []
            body_module.templates <- []
            body_module.issues <- []
            return verify_module(body_module)

        def verify_module_layouts(module: Module, issues: mutable darray[Issue]&):
            for layout in module.layouts:
                total: i64 = layout_size(layout)
                for field in layout.fields:
                    if field.offset < 0:
                        issues.push(Issue{severity: Severity.Error, code: "layout-negative-offset", line: field.line, message: "layout field offset must be non-negative"})
                    if field.width > 0 and total > 0 and field.offset + field.width > total:
                        issues.push(Issue{severity: Severity.Error, code: "layout-field-out-of-bounds", line: field.line, message: "layout field extends past the declared layout size"})


        def verify_module_protocols(module: Module, issues: mutable darray[Issue]&):
            for protocol in module.protocols:
                for method_index in 0..<protocol.methods.count |protocol|:
                    for earlier_method in 0..<method_index |protocol|:
                        if protocol.methods[method_index].name == protocol.methods[earlier_method].name:
                            issues.push(Issue{severity: Severity.Error, code: "duplicate-protocol-method", line: protocol.line, message: "protocol method duplicates an earlier declaration"})


        def verify_function_instructions(fn: Function, issues: mutable darray[Issue]&, stack_delta: mutable i64&, stack_touched: mutable bool&, uses_call: mutable bool&, writes_segment_any: mutable bool&):
            live_registers: mutable darray[sview] = []
            for input in fn.inputs:
                equals: usize = easm_find(input, "=")
                if equals < sview_len(input):
                    input_register: sview = easm_register_operand(input[equals + 1.usize():sview_len(input)])
                    if sview_len(input_register) > 0:
                        live_registers.push(input_register)
            for label_index in 0..<fn.labels.count |fn|:
                for earlier_label in 0..<label_index |fn|:
                    if fn.labels[label_index].name == fn.labels[earlier_label].name:
                        issues.push(Issue{severity: Severity.Error, code: "duplicate-label-contract", line: fn.labels[label_index].line, message: "label contract duplicates an earlier label"})
            for inst in fn.instructions:
                if sview_len(inst.op) == 0 or not easm_known_op(inst.op):
                    issues.push(Issue{severity: Severity.Error, code: "unknown-op", line: inst.line, message: "instruction mnemonic is not in the EASM operation set"})
                capability: sview = easm_required_capability(inst.op)
                if sview_len(capability) > 0 and not easm_contract_has_word(fn.requires, capability):
                    issues.push(Issue{severity: Severity.Error, code: "missing-capability", line: inst.line, message: "instruction requires a capability in the requires contract"})
                implicit_reads: i64 = easm_implicit_read_mask(inst.op)
                if (implicit_reads & 1) != 0 and not easm_live_has(live_registers, "rax"):
                    issues.push(Issue{severity: Severity.Error, code: "implicit-read-uninitialized", line: inst.line, message: "instruction implicitly reads rax, which is not established"})
                if (implicit_reads & 2) != 0 and not easm_live_has(live_registers, "rcx"):
                    issues.push(Issue{severity: Severity.Error, code: "implicit-read-uninitialized", line: inst.line, message: "instruction implicitly reads rcx, which is not established"})
                implicit_writes: i64 = easm_implicit_write_mask(inst.op)
                if (implicit_writes & 1) != 0 and not easm_contract_has_word(fn.clobbers, "rax") and not easm_contract_has_register(fn.outputs, "rax"):
                    issues.push(Issue{severity: Severity.Error, code: "implicit-clobber-missing", line: inst.line, message: "instruction implicitly writes rax without an output or clobber declaration"})
                if (implicit_writes & 2) != 0 and not easm_contract_has_word(fn.clobbers, "rcx") and not easm_contract_has_register(fn.outputs, "rcx"):
                    issues.push(Issue{severity: Severity.Error, code: "implicit-clobber-missing", line: inst.line, message: "instruction implicitly writes rcx without an output or clobber declaration"})
                if (implicit_writes & 4) != 0 and not easm_contract_has_word(fn.clobbers, "rdx") and not easm_contract_has_register(fn.outputs, "rdx"):
                    issues.push(Issue{severity: Severity.Error, code: "implicit-clobber-missing", line: inst.line, message: "instruction implicitly writes rdx without an output or clobber declaration"})
                if (implicit_writes & 8) != 0 and not easm_contract_has_word(fn.clobbers, "rbx") and not easm_contract_has_register(fn.outputs, "rbx"):
                    issues.push(Issue{severity: Severity.Error, code: "implicit-clobber-missing", line: inst.line, message: "instruction implicitly writes rbx without an output or clobber declaration"})
                if implicit_writes != 0 and (easm_equal(inst.op, "cpuid") or easm_equal(inst.op, "rdtsc")):
                    live_registers <- []
                    live_registers.push("rax") if (implicit_writes & 1) != 0
                    live_registers.push("rcx") if (implicit_writes & 2) != 0
                    live_registers.push("rdx") if (implicit_writes & 4) != 0
                    live_registers.push("rbx") if (implicit_writes & 8) != 0
                read_register: sview = easm_register_operand(easm_first_operand(inst.text))
                if sview_len(read_register) > 0 and not easm_self_zeroing(inst) and not easm_live_has(live_registers, read_register) and not easm_contract_has_register(fn.preserves, read_register):
                    issues.push(Issue{severity: Severity.Error, code: "register-read-uninitialized", line: inst.line, message: "instruction reads a register that is not declared as an input or preserved"})
                destination_read_register: sview = easm_register_operand(easm_last_operand(inst.text))
                if easm_reads_destination(inst) and destination_read_register != read_register and not easm_live_has(live_registers, destination_read_register) and not easm_contract_has_register(fn.preserves, destination_read_register):
                    issues.push(Issue{severity: Severity.Error, code: "register-read-uninitialized", line: inst.line, message: "read-modify-write instruction reads a destination register that is not declared as an input or preserved"})
                source_memory_base: sview = easm_memory_base_register(easm_first_operand(inst.text))
                if source_memory_base != "" and source_memory_base != "rsp" and source_memory_base != "rip" and not easm_live_has(live_registers, source_memory_base) and not easm_contract_has_register(fn.preserves, source_memory_base):
                    issues.push(Issue{severity: Severity.Error, code: "register-read-uninitialized", line: inst.line, message: "memory address reads a base register that is not declared as an input or preserved"})
                destination_memory_base: sview = easm_memory_base_register(easm_last_operand(inst.text))
                if destination_memory_base != "" and destination_memory_base != "rsp" and destination_memory_base != "rip" and not easm_live_has(live_registers, destination_memory_base) and not easm_contract_has_register(fn.preserves, destination_memory_base) and destination_memory_base != source_memory_base:
                    issues.push(Issue{severity: Severity.Error, code: "register-read-uninitialized", line: inst.line, message: "memory address reads a base register that is not declared as an input or preserved"})
                source_memory_index: sview = easm_memory_index_register(easm_first_operand(inst.text))
                if source_memory_index != "" and source_memory_index != "rsp" and source_memory_index != "rip" and not easm_live_has(live_registers, source_memory_index) and not easm_contract_has_register(fn.preserves, source_memory_index) and source_memory_index != source_memory_base and source_memory_index != destination_memory_base:
                    issues.push(Issue{severity: Severity.Error, code: "register-read-uninitialized", line: inst.line, message: "memory address reads an index register that is not declared as an input or preserved"})
                destination_memory_index: sview = easm_memory_index_register(easm_last_operand(inst.text))
                if destination_memory_index != "" and destination_memory_index != "rsp" and destination_memory_index != "rip" and not easm_live_has(live_registers, destination_memory_index) and not easm_contract_has_register(fn.preserves, destination_memory_index) and destination_memory_index != source_memory_base and destination_memory_index != destination_memory_base and destination_memory_index != source_memory_index:
                    issues.push(Issue{severity: Severity.Error, code: "register-read-uninitialized", line: inst.line, message: "memory address reads an index register that is not declared as an input or preserved"})
                write_register: sview = easm_register_operand(easm_last_operand(inst.text))
                if sview_len(write_register) > 0 and not easm_contract_has_register(fn.outputs, write_register) and not easm_contract_has_register(fn.clobbers, write_register):
                    issues.push(Issue{severity: Severity.Error, code: "register-write-without-clobber", line: inst.line, message: "instruction writes a register that is not declared as an output or clobber"})
                if sview_len(write_register) > 0 and not easm_live_has(live_registers, write_register):
                    live_registers.push(write_register)
                source_operand: sview = easm_first_operand(inst.text)
                destination_operand: sview = easm_last_operand(inst.text)
                if easm_memory_reads(inst) and not easm_contract_has_exact(fn.clobbers, "memory") and not easm_contract_has_exact(fn.clobbers, "memory.read"):
                    issues.push(Issue{severity: Severity.Error, code: "memory-read-without-clobber", line: inst.line, message: "memory read requires a memory or memory.read clobber"})
                if easm_memory_writes(inst) and not easm_contract_has_exact(fn.clobbers, "memory") and not easm_contract_has_exact(fn.clobbers, "memory.write"):
                    issues.push(Issue{severity: Severity.Error, code: "memory-write-without-clobber", line: inst.line, message: "memory write requires a memory or memory.write clobber"})
                if (easm_find(inst.text, "%fs") < sview_len(inst.text) or easm_find(inst.text, "%gs") < sview_len(inst.text)) and not easm_contract_has_word(fn.requires, "x86_64.segment"):
                    issues.push(Issue{severity: Severity.Error, code: "segment-register-intent-missing", line: inst.line, message: "fs/gs use requires an x86_64.segment capability"})
                last_operand: sview = easm_trim(easm_last_operand(inst.text))
                writes_segment: bool = last_operand == "%fs" or last_operand == "%gs"
                writes_segment_any <- true if writes_segment
                uses_call <- true if easm_starts(inst.op, "call")
                if writes_segment and not easm_contract_has_word(fn.requires, "x86_64.segment.write"):
                    issues.push(Issue{severity: Severity.Error, code: "segment-register-write-intent-missing", line: inst.line, message: "writing fs/gs requires x86_64.segment.write intent"})
                if writes_segment and not easm_contract_has_word(fn.clobbers, "memory") and not easm_contract_has_word(fn.clobbers, "memory.write"):
                    issues.push(Issue{severity: Severity.Error, code: "segment-register-write-without-memory-clobber", line: inst.line, message: "writing fs/gs requires a memory clobber"})
                if (easm_starts(inst.op, "add") or easm_starts(inst.op, "sub") or easm_starts(inst.op, "cmp") or easm_starts(inst.op, "test")) and not easm_contract_has_word(fn.clobbers, "cc") and not easm_contract_has_word(fn.clobbers, "flags"):
                    issues.push(Issue{severity: Severity.Error, code: "cc-clobber-missing", line: inst.line, message: "arithmetic instruction requires a cc or flags clobber"})
                if easm_starts(inst.op, "push"):
                    stack_delta <- stack_delta - 8
                    stack_touched <- true
                if easm_starts(inst.op, "pop"):
                    stack_delta <- stack_delta + 8
                    stack_touched <- true
                if (easm_starts(inst.op, "add") or easm_starts(inst.op, "sub")) and easm_find(inst.text, "%rsp") < sview_len(inst.text):
                    amount: i64 = easm_immediate_after_dollar(inst.text)
                    if easm_starts(inst.op, "add"):
                        stack_delta <- stack_delta + amount
                    else:
                        stack_delta <- stack_delta - amount
                    stack_touched <- true
                if easm_starts(inst.op, "call") and (8 + stack_delta) % 16 != 0 and not easm_contract_has_word(fn.requires, "stack.call_alignment.unchecked"):
                    issues.push(Issue{severity: Severity.Error, code: "call-stack-misaligned", line: inst.line, message: "call executes with stack pointer not aligned to 16 bytes"})
                if easm_starts(inst.op, "call"):
                    live_registers <- []
                if easm_starts(inst.op, "jmp"):
                    target: sview = easm_last_operand(inst.text)
                    if sview_len(target) > 0 and sview_at(target, 0) != 37:
                        known_label: mutable bool = false
                        for label in fn.labels:
                            known_label <- true if easm_equal(label.name, target)
                        for possible in fn.instructions:
                            if possible.op == "label" and easm_find(possible.text, target) < sview_len(possible.text):
                                known_label <- true
                        if not known_label and not easm_contract_has_word(fn.requires, "control.direct") and not easm_contract_has_word(fn.requires, "relocation.symbol"):
                            issues.push(Issue{severity: Severity.Error, code: "unknown-label", line: inst.line, message: "direct jump target is not a declared label"})
                if easm_starts(inst.op, "call") or easm_starts(inst.op, "jmp"):
                    target_operand: sview = easm_trim(easm_last_operand(inst.text))
                    indirect: bool = easm_find(target_operand, "*") < sview_len(target_operand) or easm_memory_operand(target_operand) or (sview_len(target_operand) > 0 and sview_at(target_operand, 0) == 37)
                    if indirect and not easm_contract_has_word(fn.requires, "control.indirect"):
                        issues.push(Issue{severity: Severity.Error, code: "indirect-control-intent-missing", line: inst.line, message: "indirect call/jmp requires control.indirect intent"})
                    if not indirect and not easm_contract_has_word(fn.requires, "control.direct") and not easm_contract_has_word(fn.requires, "relocation.symbol"):
                        local_label: mutable bool = false
                        for label in fn.labels:
                            local_label <- true if easm_equal(label.name, target_operand)
                        if not local_label:
                            issues.push(Issue{severity: Severity.Error, code: "direct-control-intent-missing", line: inst.line, message: "direct symbolic call/jmp requires control.direct or relocation.symbol intent"})



        def verify_function_header(module: Module, outer_index: usize, fn: Function, issues: mutable darray[Issue]&):
            if sview_len(fn.name) == 0:
                issues.push(Issue{severity: Severity.Error, code: "empty-function-name", line: fn.line, message: "function name must not be empty"})
            easm_verify_register_contracts(fn, issues)
            for earlier in 0..<outer_index |module, fn|:
                if fn.name == module.functions[earlier].name and sview_len(fn.name) > 0:
                    issues.push(Issue{severity: Severity.Error, code: "duplicate-export", line: fn.line, message: "EASM export duplicates an earlier export"})
                    break
            if not easm_starts(fn.return_type, "void") and fn.outputs.count == 0:
                issues.push(Issue{severity: Severity.Error, code: "missing-return-output", line: fn.line, message: "non-void EASM export must declare an output binding"})
            for input in fn.inputs:
                if easm_find(input, "=") == sview_len(input):
                    issues.push(Issue{severity: Severity.Error, code: "invalid-input-binding", line: fn.line, message: "input binding must use name = register syntax"})
            for output in fn.outputs:
                if easm_find(output, "=") == sview_len(output):
                    issues.push(Issue{severity: Severity.Error, code: "invalid-output-binding", line: fn.line, message: "output binding must use name = register syntax"})
            if easm_callee_saved_unprotected(fn):
                issues.push(Issue{severity: Severity.Error, code: "callee-saved-not-preserved", line: fn.line, message: "callee-saved register is clobbered without a preservation contract"})
            easm_verify_callee_saved_preservation(fn, issues)
            for protocol in module.protocols:
                for method in protocol.methods:
                    if easm_equal(method.name, fn.name) and method.arity != fn.params.count.i64():
                        issues.push(Issue{severity: Severity.Error, code: "protocol-arity-mismatch", line: fn.line, message: "platform implementation does not match protocol method arity"})

        def verify_function_post(module: Module, fn: Function, stack_delta: i64, stack_touched: bool, uses_call: bool, writes_segment_any: bool, issues: mutable darray[Issue]&):
            if stack_touched and stack_delta != 0 and not easm_contract_has_word(fn.requires, "stack.balance.unchecked"):
                issues.push(Issue{severity: Severity.Error, code: "stack-unbalanced", line: fn.line, message: "stack pointer delta is not restored before function exit"})
            if uses_call and fn.stack_facts.count == 0 and not easm_contract_has_word(fn.requires, "stack.call_alignment.unchecked"):
                issues.push(Issue{severity: Severity.Error, code: "call-without-stack-contract", line: fn.line, message: "call requires an explicit stack contract"})
            if writes_segment_any and easm_contract_has_word(fn.control, "returns") and not easm_contract_has_word(fn.requires, "x86_64.segment.restore") and not easm_contract_has_word(fn.requires, "x86_64.segment.persistent"):
                issues.push(Issue{severity: Severity.Error, code: "segment-register-return-without-lifetime-contract", line: fn.line, message: "returning after writing fs/gs requires restore or persistent segment intent"})
            easm_verify_handles(fn, issues)
            easm_verify_memory_roles(fn, module.layouts, issues)
            easm_verify_frame_contracts(fn, issues)
            easm_verify_machine_roles(fn, issues)


        def verify_module_locksteps(module: Module) -> darray[Issue]:
            issues: mutable darray[Issue] = []
            for fn in module.functions:
                if fn.reference.count > 0 or fn.targets.count > 0:
                    if fn.reference.count == 0:
                        issues.push(Issue{severity: Severity.Error, code: "lockstep-missing-reference", line: fn.line, message: "target lockstep implementation requires a reference body"})
                    for target_body in fn.targets:
                        if not easm_equal(target_body.lockstep, "reference"):
                            issues.push(Issue{severity: Severity.Error, code: "lockstep-unknown-reference", line: target_body.line, message: "lockstep target must name the reference body"})
                        for target_instruction in target_body.instructions:
                            if sview_len(target_instruction.op) == 0 or not easm_known_op(target_instruction.op):
                                issues.push(Issue{severity: Severity.Error, code: "unknown-target-op", line: target_instruction.line, message: "target instruction mnemonic is not in the EASM operation set"})
                        for target_issue in verify_lockstep_body(module, fn, target_body.instructions) |issues|:
                            issues.push(target_issue)
                for inst in fn.reference:
                    if sview_len(inst.op) == 0 or not easm_known_op(inst.op):
                        issues.push(Issue{severity: Severity.Error, code: "unknown-reference-op", line: inst.line, message: "reference instruction mnemonic is not in the EASM operation set"})
                if fn.reference.count > 0:
                    for reference_issue in verify_lockstep_body(module, fn, fn.reference) |issues|:
                        issues.push(reference_issue)

            return issues


        def verify_one_function(module: Module, outer_index: usize, fn: Function, issues: mutable darray[Issue]&):
            return if not easm_target_matches(fn.platform, module.target)
            verify_function_header(module, outer_index, fn, issues)
            stack_delta: mutable i64 = 0
            stack_touched: mutable bool = false
            uses_call: mutable bool = false
            writes_segment_any: mutable bool = false
            verify_function_instructions(fn, issues, stack_delta, stack_touched, uses_call, writes_segment_any)
            verify_function_post(module, fn, stack_delta, stack_touched, uses_call, writes_segment_any, issues)


        def verify_module_functions(module: Module, issues: mutable darray[Issue]&):
            for outer_index in 0..<module.functions.count |module|:
                fn: Function = module.functions[outer_index]
                verify_one_function(module, outer_index, fn, issues)


        def verify_module_fragments(module: Module, issues: mutable darray[Issue]&):
            for fragment in module.fragments:
                for inst in fragment.instructions:
                    if sview_len(inst.op) == 0 or not easm_known_op(inst.op):
                        issues.push(Issue{severity: Severity.Error, code: "unknown-fragment-op", line: inst.line, message: "fragment instruction mnemonic is not in the EASM operation set"})


        def verify_function_compositions(fn: Function, fragments: darray[Function]&, issues: mutable darray[Issue]&):
            for inst in fn.instructions:
                if easm_starts(inst.op, "compose"):
                    open: usize = easm_find(inst.text, "compose ")
                    name_start: usize = open + 8.usize()
                    name_end: mutable usize = easm_first_space(inst.text[name_start:sview_len(inst.text)]) + name_start
                    args_open: usize = easm_find(inst.text, "(")
                    if args_open >= name_start and args_open < name_end:
                        name_end <- args_open
                    name: sview = easm_trim(inst.text[name_start:name_end])
                    found: mutable bool = false
                    for fragment in fragments:
                        if fragment.name == name:
                            found <- true
                            args_close: mutable usize = sview_len(inst.text)
                            if args_open < sview_len(inst.text):
                                args_close <- easm_find(inst.text[args_open:sview_len(inst.text)], ")") + args_open
                            if args_open < sview_len(inst.text) and args_close > args_open:
                                argument_count: i64 = easm_compose_argument_count(inst.text[args_open + 1.usize():args_close])
                                if argument_count != fragment.params.count.i64():
                                    issues.push(Issue{severity: Severity.Error, code: "fragment-arity", line: inst.line, message: "compose argument count does not match fragment parameters"})
                    if not found:
                        issues.push(Issue{severity: Severity.Error, code: "unknown-fragment", line: inst.line, message: "compose references an unknown fragment"})
            verify_control_flow_merges(fn, issues)


        def verify_module_compositions(module: Module, issues: mutable darray[Issue]&):
            for fn in module.functions |module, issues|:
                verify_function_compositions(fn, module.fragments, issues)


        def verify_module(module: Module) -> darray[Issue]:
            issues: mutable darray[Issue] = []
            verify_module_layouts(module, issues)
            verify_module_protocols(module, issues)
            verify_module_functions(module, issues)
            for lockstep_issue in verify_module_locksteps(module) |issues|:
                issues.push(lockstep_issue)
            verify_module_fragments(module, issues)
            verify_module_compositions(module, issues)
            return issues

        def analyze_templates(module: mutable Module&) -> void:
            for template in module.templates |module|:
                referenced: mutable darray[sview] = []
                template.patch_points <- []
                for instruction_index in 0..<template.instructions.count |template, module, referenced|:
                    instruction: Instruction = template.instructions[instruction_index]
                    if instruction.op == "compose":
                        module.issues.push(Issue{severity: Severity.Error, code: "template-compose", line: instruction.line, message: "templates may not compose fragments"})
                    operand_class: sview = easm_template_operand_class(instruction.op)
                    for hole in template.holes |template, module, referenced, instruction, instruction_index, operand_class|:
                        if easm_find(instruction.text, hole.name) >= sview_len(instruction.text):
                            continue
                        referenced.push(hole.name)
                        hole_class: sview = easm_template_hole_class(hole.type_name)
                        if operand_class != "" and hole_class != "" and operand_class != hole_class:
                            module.issues.push(Issue{severity: Severity.Error, code: "template-hole-type-mismatch", line: instruction.line, message: "template hole type does not match the instruction operand width"})
                        template.patch_points.push(PatchPoint{hole: hole.name, type_name: hole.type_name, instruction_index: instruction_index.i64(), class_name: operand_class})
                for hole in template.holes:
                    found: mutable bool = false
                    for used in referenced:
                        found <- true if used == hole.name
                    if not found:
                        module.issues.push(Issue{severity: Severity.Error, code: "unused-template-hole", line: template.line, message: "template hole is declared but never referenced"})

        def easm_template_hole_class(type_name: sview) -> sview:
            "sel16" return if type_name == "u16" or type_name == "i16" or type_name == "GuestFsSelector" or type_name == "HostFsSelector" or type_name == "GuestGsSelector" or type_name == "HostGsSelector"
            return "wide64"

        def easm_template_operand_class(op: sview) -> sview:
            "sel16" return if op == "movw" or op == "fldcw" or op == "fnstcw"
            "wide64" return if op == "movabs" or op == "movq" or op == "lea" or op == "call" or op == "callq" or op == "jmp" or op == "jmpq" or op == "push" or op == "pushq"
            return ""

        def easm_first_space(text: sview) -> usize:
            for index in 0..<sview_len(text) |text|:
                if sview_at(text, index) == 32 or sview_at(text, index) == 9:
                    return index
            return sview_len(text)

        def easm_parse_i64(text: sview) -> i64:
            sign: mutable i64 = 1
            position: mutable usize = 0
            if sview_len(text) > 0 and sview_at(text, 0) == 45:
                sign <- -1
                position <- 1
            value: mutable i64 = 0
            while position < sview_len(text) |position, text, value|:
                byte: u8 = sview_at(text, position)
                break if byte < 48 or byte > 57
                value <- value * 10 + (byte - 48).i64()
                position <- position + 1
            return value * sign

        def easm_type_width(type_name: sview) -> i64:
            return match type_name:
                "u8" | "i8" | "bool": 1
                "u16" | "i16": 2
                "u32" | "i32" | "f32": 4
                "u64" | "i64" | "f64" | "ptr" | "uintptr": 8
                _: 0

        def easm_find(text: sview, needle: sview) -> usize:
            if sview_len(needle) == 0 or sview_len(text) < sview_len(needle):
                return sview_len(text)
            for index in 0..<(sview_len(text) - sview_len(needle) + 1.usize()) |text, needle|:
                if text[index:index + sview_len(needle)] == needle:
                    return index
            return sview_len(text)

        def easm_parse_params(text: sview) -> darray[Param]:
            out: mutable darray[Param] = []
            start: mutable usize = 0
            cursor: mutable usize = 0
            while cursor <= sview_len(text) |cursor, start, text, out|:
                at_end: bool = cursor == sview_len(text)
                if at_end or sview_at(text, cursor) == 44:
                    part: sview = easm_trim(text[start:cursor])
                    if sview_len(part) > 0:
                        colon: usize = easm_find(part, ":")
                        if colon < sview_len(part):
                            out.push(Param{name: easm_trim(part[0:colon]), type_name: easm_trim(part[colon + 1.usize():sview_len(part)])})
                        else:
                            out.push(Param{name: part, type_name: ""})
                    start <- cursor + 1.usize()
                cursor <- cursor + 1
            return out

        def easm_split_values(text: sview) -> darray[sview]:
            out: mutable darray[sview] = []
            start: mutable usize = 0
            cursor: mutable usize = 0
            while cursor <= sview_len(text) |cursor, start, text, out|:
                if cursor == sview_len(text) or sview_at(text, cursor) == 44:
                    value: sview = easm_trim(text[start:cursor])
                    if sview_len(value) > 0:
                        out.push(value)
                    start <- cursor + 1.usize()
                cursor <- cursor + 1
            return out

        def easm_make_function(line_view: sview, line_number: i64, fragment: bool) -> Function:
            prefix_len: mutable usize = 9 if fragment else 11
            if not fragment:
                prefix_len <- 13 if easm_starts(line_view, "template def ") else 11
            open: usize = easm_find(line_view, "(")
            close: usize = easm_find(line_view, ")")
            name: sview = easm_trim(line_view[prefix_len:open])
            params: mutable darray[Param] = []
            if open < close:
                params <- easm_parse_params(line_view[open + 1.usize():close])
            return_type: mutable sview = "void"
            abi: mutable sview = ""
            platform: mutable sview = "any"
            effects: mutable darray[sview] = []
            reqs: mutable darray[sview] = []
            clobber_values: mutable darray[sview] = []
            if not fragment and close < sview_len(line_view):
                arrow: usize = easm_find(line_view[close:sview_len(line_view)], "->")
                if arrow < sview_len(line_view[close:sview_len(line_view)]):
                    return_start: usize = close + arrow + 2.usize()
                    signature_text: sview = easm_trim(line_view[return_start:sview_len(line_view)])
                    return_end: usize = easm_first_space(signature_text)
                    return_type <- easm_trim(signature_text[0:return_end])
                    abi_at: usize = easm_find(signature_text, " abi ")
                    if abi_at < sview_len(signature_text):
                        abi_text: sview = easm_trim(signature_text[abi_at + 5.usize():sview_len(signature_text)])
                        abi_end: usize = easm_first_space(abi_text)
                        abi <- abi_text[0:abi_end]
                    for_at: usize = easm_find(signature_text, " for ")
                    if for_at < sview_len(signature_text):
                        platform_text: sview = easm_trim(signature_text[for_at + 5.usize():sview_len(signature_text)])
                        platform_end: mutable usize = easm_first_space(platform_text)
                        if sview_len(platform_text) > 0 and sview_at(platform_text, 0) == 40:
                            close_platform: usize = easm_find(platform_text, ")")
                            platform_end <- close_platform + 1.usize() if close_platform < sview_len(platform_text)
                        platform <- platform_text[0:platform_end]
                    can_at: usize = easm_find(signature_text, " can ")
                    if can_at < sview_len(signature_text):
                        effect_text: sview = easm_trim(signature_text[can_at + 5.usize():sview_len(signature_text)])
                        effect_end: mutable usize = easm_find(effect_text, " abi ")
                        if effect_end == sview_len(effect_text):
                            effect_end <- easm_find(effect_text, " for ")
                        effects.push(easm_trim(effect_text[0:effect_end]))
                    requires_at: usize = easm_find(signature_text, " requires ")
                    if requires_at < sview_len(signature_text):
                        requires_text: sview = easm_trim(signature_text[requires_at + 10.usize():sview_len(signature_text)])
                        reqs.push(requires_text)
                    clobbers_at: usize = easm_find(signature_text, " clobbers ")
                    if clobbers_at < sview_len(signature_text):
                        clobbers_text: sview = easm_trim(signature_text[clobbers_at + 10.usize():sview_len(signature_text)])
                        clobber_values.push(clobbers_text)
            return Function{name: name, params: params, return_type: return_type, abi: abi, effects: effects, requires: reqs, changes: [], reads: [], clobbers: clobber_values, preserves: [], facts: [], inputs: [], outputs: [], stack_facts: [], control: [], labels: [], instructions: [], reference: [], targets: [], line: line_number, platform: platform}

        def easm_parse_instruction(line_view: sview, line_number: i64) -> Instruction:
            end: usize = easm_first_space(line_view)
            op: mutable sview = line_view[0:end]
            pseudo: mutable bool = sview_len(op) > 0 and sview_at(op, 0) == 46
            if easm_starts(line_view, "compose "):
                op <- "compose"
                pseudo <- true
            if easm_starts(line_view, "state ") or easm_starts(line_view, "fact ") or easm_starts(line_view, "assume "):
                op <- "state"
                pseudo <- true
            if sview_len(line_view) > 0 and sview_at(line_view, sview_len(line_view) - 1.usize()) == 58:
                op <- "label"
                pseudo <- true
            empty_substitution: Substitution = Substitution{from: "", replacement: ""}
            return Instruction{op: op, text: line_view, line: line_number, pseudo: pseudo, substitution_count: 0, substitution0: empty_substitution, substitution1: empty_substitution, substitution2: empty_substitution, substitution3: empty_substitution}

        def easm_issue(module: mutable Module&, code: sview, line: i64, message: sview) -> void:
            module.issues.push(Issue{severity: Severity.Error, code: code, line: line, message: message})

        struct ComposeInfo:
            flag: sview
            name: sview
            argument_count: i64
            valid: bool

        def easm_parse_compose(text: sview) -> ComposeInfo:
            empty: ComposeInfo = ComposeInfo{flag: "", name: "", argument_count: 0, valid: false}
            if not easm_starts(text, "compose "):
                return empty
            rest: sview = easm_trim(text[8:sview_len(text)])
            open: usize = easm_find(rest, "(")
            head: sview = easm_trim(rest[0:open]) if open < sview_len(rest) else rest
            if sview_len(head) == 0:
                return empty
            first_space: usize = easm_first_space(head)
            flag: mutable sview = ""
            name: mutable sview = head
            if first_space < sview_len(head):
                flag <- easm_trim(head[0:first_space])
                name <- easm_trim(head[first_space:sview_len(head)])
            argument_count: mutable i64 = 0
            if open < sview_len(rest):
                close: usize = easm_find(rest[open:sview_len(rest)], ")") + open
                if close <= open:
                    return empty
                argument_count <- easm_compose_argument_count(rest[open + 1.usize():close])
            return ComposeInfo{flag: flag, name: name, argument_count: argument_count, valid: true}

        def easm_compose_argument_count(text: sview) -> i64:
            count: mutable i64 = 0
            trimmed: sview = easm_trim(text)
            if sview_len(trimmed) == 0:
                return 0
            for index in 0..<sview_len(trimmed) |index, trimmed, count|:
                count <- count + 1 if sview_at(trimmed, index) == 44
            return count + 1

        struct ComposeSpan:
            start: usize
            end: usize
            valid: bool

        def easm_compose_span(text: sview, wanted: i64) -> ComposeSpan:
            open: usize = easm_find(text, "(")
            if open >= sview_len(text):
                return ComposeSpan{start: 0, end: 0, valid: false}
            close: usize = easm_find(text[open:sview_len(text)], ")") + open
            if close <= open:
                return ComposeSpan{start: 0, end: 0, valid: false}
            values: sview = text[open + 1.usize():close]
            start: mutable usize = 0
            current: mutable i64 = 0
            cursor: mutable usize = 0
            while cursor <= sview_len(values):
                if cursor == sview_len(values) or sview_at(values, cursor) == 44:
                    if current == wanted:
                        while start < cursor and (sview_at(values, start) == 32 or sview_at(values, start) == 9):
                            start <- start + 1
                        end: mutable usize = cursor
                        while end > start and (sview_at(values, end - 1.usize()) == 32 or sview_at(values, end - 1.usize()) == 9):
                            end <- end - 1
                        return ComposeSpan{start: open + 1.usize() + start, end: open + 1.usize() + end, valid: true}
                    current <- current + 1
                    start <- cursor + 1.usize()
                cursor <- cursor + 1
            return ComposeSpan{start: 0, end: 0, valid: false}

        def easm_binding_register(binding: sview) -> sview:
            equals: usize = easm_find(binding, "=")
            if equals >= sview_len(binding):
                return ""
            return easm_register_operand(binding[equals + 1.usize():sview_len(binding)])

        def easm_instruction_reads_register(instruction: Instruction, wanted: sview) -> bool:
            if instruction.pseudo:
                return false
            wanted_bit: i64 = easm_register_bit(wanted)
            if wanted_bit == 0:
                return false
            source: sview = easm_first_operand(instruction.text)
            if easm_register_bit(easm_register_operand(source)) == wanted_bit:
                return true
            return easm_register_bit(easm_memory_base_register(source)) == wanted_bit

        def easm_function_reads_register(fn: Function, wanted: sview) -> bool:
            for instruction in fn.instructions:
                if easm_instruction_reads_register(instruction, wanted):
                    return true
            return false

        def easm_prune_conditional_inputs[@r](variants: mutable darray[Function] @r) -> void:
            ever_used: mutable i64 = 0
            for variant in variants:
                for input in variant.inputs:
                    register: sview = easm_binding_register(input)
                    if easm_function_reads_register(variant, register):
                        ever_used <- ever_used | easm_register_bit(register)
            for variant_index in 0..<variants.count |variant_index, variants|:
                variant: mutable Function = variants[variant_index]
                kept_inputs: mutable darray[sview] @r = []
                dropped_names: mutable darray[sview] @r = []
                for input in variant.inputs:
                    register: sview = easm_binding_register(input)
                    bit: i64 = easm_register_bit(register)
                    if bit != 0 and (ever_used & bit) != 0 and not easm_function_reads_register(variant, register):
                        dropped_names.push(easm_binding_name(input))
                    else:
                        kept_inputs.push(input)
                kept_params: mutable darray[Param] @r = []
                for parameter in variant.params:
                    drop: mutable bool = false
                    for name in dropped_names:
                        drop <- true if easm_equal(parameter.name, name)
                    if not drop:
                        kept_params.push(parameter)
                variant.inputs <- kept_inputs
                variant.params <- kept_params
                variants[variant_index] <- variant

        def easm_expand_compositions[@r](module: mutable Module& @r) -> void:
            expanded_functions: mutable darray[Function] @r = []
            for function_index in 0..<module.functions.count |module, function_index, expanded_functions|:
                original: Function = module.functions[function_index]
                flags: mutable darray[sview] @r = []
                for instruction in original.instructions:
                    if not easm_starts(instruction.op, "compose"):
                        continue
                    info: ComposeInfo = easm_parse_compose(instruction.text)
                    if info.flag == "":
                        continue
                    seen_flag: mutable bool = false
                    for existing in flags:
                        seen_flag <- true if easm_equal(existing, info.flag)
                    if not seen_flag:
                        flags.push(info.flag)
                variant_count: i64 = 1 << flags.count.i64()
                variant_batch: mutable darray[Function] @r = []
                for variant_mask in 0..<variant_count |variant_mask, flags, module, original, expanded_functions|:
                    variant: mutable Function = original
                    merged_requires: mutable darray[sview] @r = []
                    merged_clobbers: mutable darray[sview] @r = []
                    merged_preserves: mutable darray[sview] @r = []
                    for value in original.requires:
                        merged_requires.push(value)
                    for value in original.clobbers:
                        merged_clobbers.push(value)
                    for value in original.preserves:
                        merged_preserves.push(value)
                    expanded: mutable darray[Instruction] @r = []
                    for instruction in original.instructions:
                        if not easm_starts(instruction.op, "compose"):
                            expanded.push(instruction)
                            continue
                        info: ComposeInfo = easm_parse_compose(instruction.text)
                        active: mutable bool = true
                        if info.flag != "":
                            active <- false
                            for flag_index in 0..<flags.count |flag_index, flags, info, variant_mask, active|:
                                if easm_equal(flags[flag_index], info.flag) and (variant_mask & (1 << flag_index.i64())) != 0:
                                    active <- true
                        continue if not active
                        found: mutable bool = false
                        for fragment in module.fragments:
                            if not easm_equal(fragment.name, info.name):
                                continue
                            found <- true
                            if info.argument_count != fragment.params.count.i64():
                                easm_issue(module, "fragment-arity", instruction.line, "compose argument count does not match fragment parameters")
                                continue
                            if fragment.params.count > 4:
                                easm_issue(module, "compose-too-many-parameters", instruction.line, "stage1 supports at most four materialized fragment bindings per instruction")
                            for fragment_instruction in fragment.instructions:
                                materialized: mutable Instruction = fragment_instruction
                                materialized.line <- instruction.line
                                materialized.substitution_count <- fragment.params.count.i64() if fragment.params.count <= 4
                                for parameter_index in 0..<fragment.params.count |parameter_index, fragment, materialized, instruction|:
                                    span: ComposeSpan = easm_compose_span(instruction.text, parameter_index.i64())
                                    binding: Substitution = Substitution{from: fragment.params[parameter_index].name, replacement: instruction.text[span.start:span.end]}
                                    materialized.substitution0 <- binding if parameter_index == 0
                                    materialized.substitution1 <- binding if parameter_index == 1
                                    materialized.substitution2 <- binding if parameter_index == 2
                                    materialized.substitution3 <- binding if parameter_index == 3
                                expanded.push(materialized)
                            for value in fragment.requires:
                                merged_requires.push(value)
                            for value in fragment.clobbers:
                                merged_clobbers.push(value)
                            for value in fragment.preserves:
                                merged_preserves.push(value)
                        if not found:
                            easm_issue(module, "unknown-fragment", instruction.line, "compose references an unknown fragment")
                    variant.instructions <- expanded
                    variant.requires <- merged_requires
                    variant.clobbers <- merged_clobbers
                    variant.preserves <- merged_preserves
                    if flags.count > 0:
                        name_bytes: mutable darray[u8] @r = []
                        for byte in original.name:
                            name_bytes.push(byte)
                        for flag_index in 0..<flags.count |flag_index, flags, variant_mask, name_bytes|:
                            if (variant_mask & (1 << flag_index.i64())) != 0:
                                easm_append_text(name_bytes, "__")
                                easm_append_text(name_bytes, flags[flag_index])
                        variant.name <- sview((&name_bytes[0]).cast[u8&], 0, name_bytes.count)
                    variant_batch.push(variant)
                easm_prune_conditional_inputs(variant_batch)
                for variant in variant_batch:
                    expanded_functions.push(variant)
            module.functions <- expanded_functions

        # Parse the EASM declaration and body surface. Verification and native assembly consume
        # this lossless-enough model in later slices; keeping parsing separate makes malformed
        # source reportable before any LLVM/native side effects occur.
        def parse_layout_module(source: u8&, length: usize, path: sview) -> Module:
            out: mutable Module = Module{path: path, name: "", target: "any", issues: [], functions: [], fragments: [], protocols: [], templates: [], layouts: []}
            cursor: mutable usize = 0
            line_number: mutable i64 = 0
            active_layout: mutable i64 = -1
            current_kind: mutable i64 = 0
            current_index: mutable i64 = -1
            section: mutable sview = ""
            body_mode: mutable i64 = 0
            active_target: mutable i64 = -1
            while cursor < length |cursor, length, line_number, active_layout, current_kind, current_index, section, body_mode, active_target, out, source|:
                line_start: usize = cursor
                while cursor < length and source[cursor] != 10 |cursor, length, source|:
                    cursor <- cursor + 1
                line_view: mutable sview = source[line_start:cursor]
                line_number <- line_number + 1
                cursor <- cursor + 1 if cursor < length
                line_view <- easm_trim(line_view)
                continue if sview_len(line_view) == 0 or sview_at(line_view, 0) == 35
                is_export: bool = easm_starts(line_view, "export def ")
                is_fragment: bool = easm_starts(line_view, "fragment ")
                is_protocol: bool = easm_starts(line_view, "protocol ")
                is_template: bool = easm_starts(line_view, "template def ")
                is_layout: bool = easm_starts(line_view, "layout ")
                if easm_starts(line_view, "module "):
                    out.name <- easm_trim(line_view[7:sview_len(line_view)])
                    active_layout <- -1
                    current_kind <- 0
                    section <- ""
                    body_mode <- 0
                    active_target <- -1
                    continue
                if (current_kind == 1 or current_kind == 2) and easm_starts(line_view, "target "):
                    target_tail: sview = easm_trim(line_view[7:sview_len(line_view)])
                    lockstep_at: usize = easm_find(target_tail, " lockstep ")
                    if lockstep_at < sview_len(target_tail) and current_kind == 1:
                        arch: sview = easm_trim(target_tail[0:lockstep_at])
                        ref_name: mutable sview = easm_trim(target_tail[lockstep_at + 10.usize():sview_len(target_tail)])
                        if sview_len(ref_name) > 0 and sview_at(ref_name, sview_len(ref_name) - 1.usize()) == 58:
                            ref_name <- easm_trim(ref_name[0:sview_len(ref_name) - 1.usize()])
                        out.functions[current_index.usize()].targets.push(TargetBody{arch: arch, lockstep: ref_name, instructions: [], line: line_number})
                        active_target <- out.functions[current_index.usize()].targets.count.i64() - 1
                        body_mode <- 2
                        section <- "body"
                        continue
                if easm_starts(line_view, "target "):
                    out.target <- easm_trim(line_view[7:sview_len(line_view)])
                    active_layout <- -1
                    current_kind <- 0
                    section <- ""
                    body_mode <- 0
                    active_target <- -1
                    continue
                if is_layout:
                    header: sview = easm_trim(line_view[7:sview_len(line_view)])
                    colon: mutable usize = sview_len(header)
                    for index in 0..<sview_len(header) |colon, header|:
                        colon <- index if sview_at(header, index) == 58
                    name_end: usize = easm_first_space(header[0:colon])
                    layout_name: sview = easm_trim(header[0:name_end])
                    layout_size: mutable i64 = 0
                    layout_stride: mutable i64 = 0
                    attributes: sview = easm_trim(header[name_end:colon])
                    if easm_starts(attributes, "size "):
                        layout_size <- easm_parse_i64(easm_trim(attributes[5:sview_len(attributes)]))
                    if easm_starts(attributes, "stride "):
                        layout_stride <- easm_parse_i64(easm_trim(attributes[7:sview_len(attributes)]))
                    out.layouts.push(Layout{name: layout_name, fields: [], size: layout_size, stride: layout_stride, line: line_number})
                    active_layout <- out.layouts.count.i64() - 1
                    current_kind <- 5
                    section <- ""
                    body_mode <- 0
                    active_target <- -1
                    continue
                if active_layout >= 0:
                    first_end: usize = easm_first_space(line_view)
                    offset_text: sview = line_view[0:first_end]
                    rest: sview = easm_trim(line_view[first_end:sview_len(line_view)])
                    field_end: mutable usize = easm_first_space(rest)
                    field_colon: usize = easm_find(rest[0:field_end + 1.usize()], ":")
                    if field_colon < field_end + 1.usize():
                        field_end <- field_colon
                    field_name: sview = easm_trim(rest[0:field_end])
                    type_start: mutable usize = field_end
                    while type_start < sview_len(rest) and (sview_at(rest, type_start) == 32 or sview_at(rest, type_start) == 9 or sview_at(rest, type_start) == 58) |type_start, rest|:
                        type_start <- type_start + 1
                    type_end: usize = easm_first_space(rest[type_start:sview_len(rest)]) + type_start
                    type_name: sview = rest[type_start:type_end]
                    width: i64 = easm_type_width(type_name)
                    requires_size: mutable i64 = 0
                    guard: usize = easm_find(rest[type_end:sview_len(rest)], "requires size >= ")
                    if guard < sview_len(rest[type_end:sview_len(rest)]):
                        guard_start: usize = type_end + guard + sview_len("requires size >= ")
                        requires_size <- easm_parse_i64(easm_trim(rest[guard_start:sview_len(rest)]))
                    valid_offset: bool = sview_len(offset_text) > 0 and sview_at(offset_text, 0) >= 48 and sview_at(offset_text, 0) <= 57
                    if field_name != "" and type_name != "" and valid_offset:
                        out.layouts[active_layout.usize()].fields.push(LayoutField{offset: easm_parse_i64(offset_text), name: field_name, type_name: type_name, width: width, requires_size_at_least: requires_size, line: line_number})
                        continue
                    active_layout <- -1
                    current_kind <- 0
                if is_protocol:
                    header: sview = easm_trim(line_view[9:sview_len(line_view)])
                    colon: usize = easm_find(header, ":")
                    proto_name: sview = easm_trim(header[0:colon])
                    out.protocols.push(Protocol{name: proto_name, methods: [], line: line_number})
                    current_index <- out.protocols.count.i64() - 1
                    current_kind <- 3
                    section <- ""
                    body_mode <- 0
                    active_target <- -1
                    continue
                if current_kind == 3:
                    open: usize = easm_find(line_view, "(")
                    close: usize = easm_find(line_view, ")")
                    arrow: mutable usize = sview_len(line_view)
                    if close < sview_len(line_view):
                        arrow <- easm_find(line_view[close:sview_len(line_view)], "->")
                    if open < close and arrow < sview_len(line_view[close:sview_len(line_view)]):
                        method_name: sview = easm_trim(line_view[0:open])
                        ret_start: usize = close + arrow + 2.usize()
                        ret_tail: sview = easm_trim(line_view[ret_start:sview_len(line_view)])
                        out.protocols[current_index.usize()].methods.push(ProtocolMethod{name: method_name, arity: easm_parse_params(line_view[open + 1.usize():close]).count.i64(), return_type: ret_tail})
                        continue
                    current_kind <- 0
                if is_export or is_fragment:
                    fn: Function = easm_make_function(line_view, line_number, is_fragment)
                    if is_fragment:
                        out.fragments.push(fn)
                        current_index <- out.fragments.count.i64() - 1
                        current_kind <- 2
                    else:
                        out.functions.push(fn)
                        current_index <- out.functions.count.i64() - 1
                        current_kind <- 1
                    active_layout <- -1
                    section <- ""
                    body_mode <- 0
                    active_target <- -1
                    continue
                if is_template:
                    tpl_fn: Function = easm_make_function(line_view, line_number, false)
                    out.templates.push(Template{name: tpl_fn.name, holes: tpl_fn.params, instructions: [], patch_points: [], line: line_number})
                    current_index <- out.templates.count.i64() - 1
                    current_kind <- 4
                    active_layout <- -1
                    section <- "body"
                    body_mode <- 0
                    active_target <- -1
                    continue
                if current_kind == 4:
                    template_instruction: Instruction = easm_parse_instruction(line_view, line_number)
                    out.templates[current_index.usize()].instructions.push(template_instruction)
                    for hole in out.templates[current_index.usize()].holes:
                        if easm_find(template_instruction.text, hole.name) < sview_len(template_instruction.text):
                            hole_class: mutable sview = "wide64"
                            if easm_equal(hole.type_name, "u16") or easm_equal(hole.type_name, "i16"):
                                hole_class <- "sel16"
                            out.templates[current_index.usize()].patch_points.push(PatchPoint{hole: hole.name, type_name: hole.type_name, instruction_index: out.templates[current_index.usize()].instructions.count.i64() - 1, class_name: hole_class})
                    continue
                if current_kind == 1 or current_kind == 2:
                    if easm_starts(section, "body") and sview_len(line_view) > 0 and sview_at(line_view, 0) == 114:
                        body_mode <- 1
                        section <- "body"
                        continue
                    if easm_starts(line_view, "target "):
                        target_tail: sview = easm_trim(line_view[7:sview_len(line_view)])
                        lockstep_at: usize = easm_find(target_tail, " lockstep ")
                        if lockstep_at < sview_len(target_tail):
                            arch: sview = easm_trim(target_tail[0:lockstep_at])
                            ref_name: mutable sview = easm_trim(target_tail[lockstep_at + 10.usize():sview_len(target_tail)])
                            if sview_len(ref_name) > 0 and sview_at(ref_name, sview_len(ref_name) - 1.usize()) == 58:
                                ref_name <- easm_trim(ref_name[0:sview_len(ref_name) - 1.usize()])
                            if current_kind == 1:
                                out.functions[current_index.usize()].targets.push(TargetBody{arch: arch, lockstep: ref_name, instructions: [], line: line_number})
                                active_target <- out.functions[current_index.usize()].targets.count.i64() - 1
                                body_mode <- 2
                                section <- "body"
                            continue
                    if line_view == "reference:":
                        body_mode <- 1
                        active_target <- -1
                        section <- "body"
                        continue
                    if easm_starts(line_view, "body:"):
                        section <- "body"
                        body_mode <- 0
                        continue
                    colon: usize = easm_find(line_view, ":")
                    if section != "body" and colon < sview_len(line_view) and line_view[colon + 1.usize():sview_len(line_view)] == "":
                        section <- easm_trim(line_view[0:colon])
                        continue
                    if section != "" and section != "body":
                        if current_kind == 1:
                            out.functions[current_index.usize()].facts.push(line_view) if section == "facts"
                            out.functions[current_index.usize()].inputs.push(line_view) if section == "inputs"
                            out.functions[current_index.usize()].outputs.push(line_view) if section == "outputs"
                            out.functions[current_index.usize()].requires.push(line_view) if section == "requires"
                            out.functions[current_index.usize()].changes.push(line_view) if section == "changes"
                            out.functions[current_index.usize()].reads.push(line_view) if section == "reads"
                            out.functions[current_index.usize()].clobbers.push(line_view) if section == "clobbers"
                            out.functions[current_index.usize()].preserves.push(line_view) if section == "preserves"
                            out.functions[current_index.usize()].stack_facts.push(line_view) if section == "stack"
                            out.functions[current_index.usize()].control.push(line_view) if section == "control"
                            if section == "labels":
                                label_colon: usize = easm_find(line_view, ":")
                                label_name: mutable sview = line_view
                                preconditions: mutable darray[sview] = []
                                if label_colon < sview_len(line_view):
                                    label_name <- line_view[0:label_colon]
                                    preconditions <- easm_split_values(line_view[label_colon + 1.usize():sview_len(line_view)])
                                out.functions[current_index.usize()].labels.push(LabelContract{name: easm_trim(label_name), preconditions: preconditions, line: line_number})
                        continue
                    inst: Instruction = easm_parse_instruction(line_view, line_number)
                    if current_kind == 1:
                        if body_mode == 1:
                            out.functions[current_index.usize()].reference.push(inst)
                        elif body_mode == 2 and active_target >= 0:
                            target_body: mutable TargetBody = out.functions[current_index.usize()].targets[active_target.usize()]
                            target_body.instructions.push(inst)
                            out.functions[current_index.usize()].targets[active_target.usize()] <- target_body
                        else:
                            out.functions[current_index.usize()].instructions.push(inst)
                    else:
                        out.fragments[current_index.usize()].instructions.push(inst)
                    continue
                easm_issue(out, "unexpected-top-level", line_number, "expected module, target, export def, fragment, protocol, layout, or template def")
            easm_expand_compositions(out)
            analyze_templates(out)
            for issue in verify_module(out):
                out.issues.push(issue)
            return out

        def parse_module(source: u8&, length: usize, path: sview) -> Module:
            return parse_layout_module(source, length, path)

        def parse_project(sources: darray[ProjectSource], target: sview) -> Project:
            project: mutable Project = Project{target: target, modules: [], issues: []}
            for source in sources |project|:
                length: mutable usize = source.bytes.count
                if length > 0 and source.bytes[length - 1.usize()] == 0:
                    length <- length - 1.usize()
                continue if length == 0
                parsed: Module = parse_module((&source.bytes[0]).cast[u8&], length, source.path)
                for issue in parsed.issues |project|:
                    project.issues.push(issue)
                if not easm_target_matches(parsed.target, target):
                    continue
                duplicate: mutable bool = false
                for earlier in project.modules:
                    if earlier.name == parsed.name and parsed.name != "":
                        duplicate <- true
                if duplicate:
                    project.issues.push(Issue{severity: Severity.Error, code: "duplicate-project-module", line: 0, message: "project contains more than one EASM module with the same name"})
                else:
                    project.modules.push(parsed)
            for module_index in 0..<project.modules.count |project|:
                current: Module = project.modules[module_index]
                for function in current.functions:
                    for earlier_module_index in 0..<module_index |project, function|:
                        for earlier_function in project.modules[earlier_module_index].functions:
                            if function.name == earlier_function.name and function.name != "":
                                project.issues.push(Issue{severity: Severity.Error, code: "duplicate-project-export", line: function.line, message: "project contains duplicate EASM exports across source modules"})
            return project

        def project_has_errors(project: Project) -> bool:
            for issue in project.issues:
                true return if issue.severity == Severity.Error
            return false

        def emit_project_native_assembly(project: Project, out: mutable darray[u8]&) -> bool:
            false return if project_has_errors(project)
            for module in project.modules:
                emit_native_assembly(module, project.target, out)
            return true

        # Stage0's BuildReport surface, kept deliberately textual so the self-hosted driver can
        # stream it without depending on a JSON library.  The host wrapper owns discovery; this
        # function owns the target-filtered module/error report once sources cross the boundary.
        def emit_project_report(project: Project, out: mutable darray[u8]&) -> void:
            easm_append_text(out, "Target: ")
            easm_append_text(out, project.target)
            easm_append_text(out, "\nModules: ")
            for module in project.modules:
                easm_append_text(out, module.name)
                easm_append_text(out, " @")
                easm_append_text(out, module.path)
                easm_append_text(out, "\n")
                for function in module.functions:
                    easm_append_text(out, "  export ")
                    easm_append_text(out, function.name)
                    easm_append_text(out, "\n")
                for template in module.templates:
                    easm_append_text(out, "  template ")
                    easm_append_text(out, template.name)
                    easm_append_text(out, "\n")
            for issue in project.issues:
                easm_append_text(out, "Issue ")
                easm_append_text(out, issue.code)
                easm_append_text(out, " line=")
                easm_append_text(out, "reported")
                easm_append_text(out, " ")
                easm_append_text(out, issue.message)
                easm_append_text(out, "\n")
