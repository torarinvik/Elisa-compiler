# Stage1 EASM model.
#
# This is the first shared layer of the stage0 EASM backend port: typed records used by the
# parser, verifier, and LLVM inline-assembly emitter. Keeping these records separate from the
# ordinary Elisa ValueType model is intentional — EASM has machine registers, stack facts,
# guest overlays, and patchable instruction templates that are not Elisa values.


module Easm:
    public:
        const enum Severity of u8:
            Error
            Warning

        struct Issue:
            severity: Severity
            code: sview
            line: i64
            message: sview

        struct Param:
            name: sview
            type_name: sview

        struct Instruction:
            op: sview
            text: sview
            line: mutable i64
            pseudo: bool
            substitution_count: mutable i64
            substitution0: mutable Substitution
            substitution1: mutable Substitution
            substitution2: mutable Substitution
            substitution3: mutable Substitution

        struct Substitution:
            from: sview
            replacement: sview

        struct TargetBody:
            arch: sview
            lockstep: sview
            instructions: mutable darray[Instruction]
            line: i64

        struct LabelContract:
            name: sview
            preconditions: darray[sview]
            line: i64

        struct LayoutField:
            offset: i64
            name: sview
            type_name: sview
            width: i64
            requires_size_at_least: i64
            line: i64

        struct Layout:
            name: mutable sview
            fields: mutable darray[LayoutField]
            size: mutable i64
            stride: mutable i64
            line: mutable i64

        struct GuestOverlayAccess:
            layout: sview
            field: sview
            offset: i64
            width: i64
            access_width: i64

        # ABI-neutral lowering result for the source-level guest-overlay accessor.  The call is
        # emitted into caller-owned bytes rather than stored as a temporary string, because sview
        # values borrow source storage and Elisa has no implicit string concatenation.
        struct GuestOverlayDesugar:
            access: GuestOverlayAccess
            base: sview
            memory: sview
            value: sview
            is_write: bool
            accessor_name: sview

        struct Function:
            name: mutable sview
            params: mutable darray[Param]
            return_type: sview
            abi: sview
            effects: mutable darray[sview]
            requires: mutable darray[sview]
            changes: mutable darray[sview]
            reads: mutable darray[sview]
            clobbers: mutable darray[sview]
            preserves: mutable darray[sview]
            facts: mutable darray[sview]
            inputs: mutable darray[sview]
            outputs: mutable darray[sview]
            stack_facts: mutable darray[sview]
            control: mutable darray[sview]
            labels: mutable darray[LabelContract]
            instructions: mutable darray[Instruction]
            reference: mutable darray[Instruction]
            targets: mutable darray[TargetBody]
            line: i64
            platform: sview

        # One explicit instruction transition row, corresponding to stage0's opRule.  Masks
        # use the same canonical register bits as the verifier; `result_defines` distinguishes
        # defined implicit results (cpuid/rdtsc) from caller-clobbered values.
        struct OperationEffect:
            capability: sview
            implicit_reads: i64
            implicit_writes: i64
            known: bool
            clobbers_flags: bool
            implicit_cc: bool
            result_defines: bool

        struct ProtocolMethod:
            name: sview
            arity: i64
            return_type: sview

        struct Protocol:
            name: sview
            methods: mutable darray[ProtocolMethod]
            line: i64

        struct PatchPoint:
            hole: sview
            type_name: sview
            instruction_index: i64
            class_name: sview

        struct PatchByte:
            hole: sview
            offset: i64
            width: i64

        struct TemplateImage:
            bytes: darray[u8]
            patches: darray[PatchByte]

        struct PatchValue:
            hole: sview
            value: u64

        struct Template:
            name: sview
            holes: mutable darray[Param]
            instructions: mutable darray[Instruction]
            patch_points: mutable darray[PatchPoint]
            line: i64

        struct Module:
            path: mutable sview
            name: mutable sview
            target: mutable sview
            issues: mutable darray[Issue]
            functions: mutable darray[Function]
            fragments: mutable darray[Function]
            protocols: mutable darray[Protocol]
            templates: mutable darray[Template]
            layouts: mutable darray[Layout]

        # Host-facing project boundary. The self-hosted compiler does not own filesystem
        # discovery yet, so callers provide the configured project/dependency sources. Keeping
        # source bytes alive in this record is important: parsed sviews intentionally borrow
        # those buffers rather than copying every EASM token.
        struct ProjectSource:
            path: sview
            bytes: darray[u8]

        struct Project:
            target: sview
            modules: mutable darray[Module]
            issues: mutable darray[Issue]

        # The stage0 verifier carries these facts through control-flow edges and meets them at
        # labels.  Stage1 uses a fixed register bitset instead of a map: this keeps the analysis
        # allocation-free and, importantly, makes the meet operation explicit (a register is live
        # after a merge only when it is live on every incoming edge).
        struct FlowState:
            live: mutable i64
            stack_delta: mutable i64
            stack_mod16: mutable i64
            stack_known: mutable bool
            flags_live: mutable bool
            valid: mutable bool

        struct MemoryProvenance:
            register: sview
            type_name: sview
            parameter: sview

        # Control-flow provenance state. `types` is indexed by the same register bits used by the
        # liveness analysis. `ambiguous` records a meet where incoming edges disagree (typed vs
        # untyped, or two different carriers); an empty type alone is not enough to distinguish an
        # ordinary raw register from an unsound provenance join.
        struct ProvenanceFlow:
            types: mutable darray[sview]
            ambiguous: mutable i64
            valid: mutable bool

        def easm_register_bit(register: sview) -> i64:
            ensure result == EasmRegisterMasks::register_bit(register)
            return EasmRegisterMasks::register_bit(register)

        def easm_register_mask(text: sview) -> i64:
            mask: mutable i64 = 0
            mask <- mask | EasmRegisterMasks::RAX if easm_find(text, "%rax") < text.len
            mask <- mask | EasmRegisterMasks::RCX if easm_find(text, "%rcx") < text.len
            mask <- mask | EasmRegisterMasks::RDX if easm_find(text, "%rdx") < text.len
            mask <- mask | EasmRegisterMasks::RBX if easm_find(text, "%rbx") < text.len
            mask <- mask | EasmRegisterMasks::RSI if easm_find(text, "%rsi") < text.len
            mask <- mask | EasmRegisterMasks::RDI if easm_find(text, "%rdi") < text.len
            mask <- mask | EasmRegisterMasks::RBP if easm_find(text, "%rbp") < text.len
            mask <- mask | EasmRegisterMasks::RSP if easm_find(text, "%rsp") < text.len
            mask <- mask | EasmRegisterMasks::R8 if easm_find(text, "%r8") < text.len
            mask <- mask | EasmRegisterMasks::R9 if easm_find(text, "%r9") < text.len
            mask <- mask | EasmRegisterMasks::R10 if easm_find(text, "%r10") < text.len
            mask <- mask | EasmRegisterMasks::R11 if easm_find(text, "%r11") < text.len
            mask <- mask | EasmRegisterMasks::R12 if easm_find(text, "%r12") < text.len
            mask <- mask | EasmRegisterMasks::R13 if easm_find(text, "%r13") < text.len
            mask <- mask | EasmRegisterMasks::R14 if easm_find(text, "%r14") < text.len
            mask <- mask | EasmRegisterMasks::R15 if easm_find(text, "%r15") < text.len
            return mask

        def easm_substitution_at(instruction: Instruction, index: i64) -> Substitution:
            if index == 0:
                return instruction.substitution0
            if index == 1:
                return instruction.substitution1
            if index == 2:
                return instruction.substitution2
            return instruction.substitution3

        def easm_substitute_operand(operand: sview, instruction: Instruction) -> sview:
            value: sview = easm_trim(operand)
            for index in 0..<instruction.substitution_count.usize() |index, instruction, value|:
                substitution: Substitution = easm_substitution_at(instruction, index.i64())
                if easm_equal(value, substitution.from):
                    return substitution.replacement
            return value

        def easm_operand_register_mask(operand: sview) -> i64:
            return easm_register_bit(easm_register_operand(operand)) | easm_register_bit(easm_memory_base_register(operand)) | easm_register_bit(easm_memory_index_register(operand))

        def easm_instruction_register_mask(instruction: Instruction) -> i64:
            mask: mutable i64 = easm_register_mask(instruction.text) | easm_operand_register_mask(easm_substitute_operand(easm_first_operand(instruction.text), instruction)) | easm_operand_register_mask(easm_substitute_operand(easm_last_operand(instruction.text), instruction))
            for index in 0..<instruction.substitution_count.usize() |index, instruction, mask|:
                substitution: Substitution = easm_substitution_at(instruction, index.i64())
                if easm_find(instruction.text, substitution.from) < instruction.text.len:
                    mask <- mask | easm_register_mask(substitution.replacement) | easm_operand_register_mask(substitution.replacement)
            return mask

        def easm_written_mask(instruction: Instruction) -> i64:
            if easm_starts(instruction.op, "cmp") or easm_starts(instruction.op, "test") or easm_starts(instruction.op, "push") or easm_starts(instruction.op, "call") or easm_starts(instruction.op, "jmp") or easm_starts(instruction.op, "ret"):
                return 0
            destination: sview = easm_substitute_operand(easm_last_operand(instruction.text), instruction)
            destination_mask: i64 = easm_register_bit(easm_register_operand(destination))
            if easm_starts(instruction.op, "xchg"):
                source: sview = easm_substitute_operand(easm_first_operand(instruction.text), instruction)
                return destination_mask | easm_register_bit(easm_register_operand(source))
            return destination_mask

        def easm_stack_pointer_write_register(instruction: Instruction) -> sview:
            destination: sview = easm_substitute_operand(easm_last_operand(instruction.text), instruction)
            destination_register: sview = easm_register_operand(destination)
            if easm_register_bit(destination_register) == EasmRegisterMasks::RSP:
                return destination_register
            if easm_starts(instruction.op, "xchg"):
                source: sview = easm_substitute_operand(easm_first_operand(instruction.text), instruction)
                source_register: sview = easm_register_operand(source)
                return source_register if easm_register_bit(source_register) == EasmRegisterMasks::RSP
            return ""

        def easm_writes_stack_pointer(instruction: Instruction) -> bool:
            return easm_stack_pointer_write_register(instruction) != ""

        def easm_read_mask(instruction: Instruction) -> i64:
            all_registers: i64 = easm_instruction_register_mask(instruction)
            return 0 if easm_self_zeroing(instruction)
            if easm_starts(instruction.op, "mov") or easm_starts(instruction.op, "lea"):
                source: sview = easm_substitute_operand(easm_first_operand(instruction.text), instruction)
                destination: sview = easm_substitute_operand(easm_last_operand(instruction.text), instruction)
                destination_reads: i64 = 0 if easm_register_operand(destination) != "" else easm_operand_register_mask(destination)
                return easm_operand_register_mask(source) | destination_reads
            if easm_starts(instruction.op, "pop"):
                destination: sview = easm_substitute_operand(easm_last_operand(instruction.text), instruction)
                return 0 if easm_register_operand(destination) != "" else easm_operand_register_mask(destination)
            return all_registers

        def easm_label_name_from_trimmed(text: sview) -> sview:
            ensure result == (easm_trim(text[0:text.len - 1.usize()]) if text.len > 0 and text[text.len - 1.usize()] == 58 else text)
            return easm_trim(text[0:text.len - 1.usize()]) if text.len > 0 and text[text.len - 1.usize()] == 58 else text

        def easm_label_name(instruction: Instruction) -> sview:
            ensure result == (easm_label_name_from_trimmed(easm_trim(instruction.text)) if instruction.op == "label" else "")
            return easm_label_name_from_trimmed(easm_trim(instruction.text)) if instruction.op == "label" else ""

        def easm_label_index(instructions: darray[Instruction], target: sview) -> i64:
            ensure result >= -1
            ensure (instructions.count.i64() < 0 or instructions.count.i64().usize() != instructions.count) implies result == -1
            ensure result >= 0 implies result < instructions.count.i64()
            ensure result >= 0 implies result.usize().i64() == result
            ensure result >= 0 implies easm_equal(easm_label_name(instructions[result.usize()]), target)
            ensure result >= 0 implies (forall prior in 0..<result.usize(): not easm_equal(easm_label_name(instructions[prior]), target))
            ensure (instructions.count.i64() >= 0 and instructions.count.i64().usize() == instructions.count and result == -1) implies (forall candidate in 0..<instructions.count: not easm_equal(easm_label_name(instructions[candidate]), target))
            count: usize = instructions.count
            count_signed: i64 = count.i64()
            return -1 if count_signed < 0 or count_signed.usize() != count
            assert count_signed >= 0
            assert count_signed.usize() == count
            assert count_signed == instructions.count.i64()
            for index in 0..<count |count, instructions, target|:
                invariant index >= 0
                invariant index <= count
                invariant forall prior in 0..<index: not easm_equal(easm_label_name(instructions[prior]), target)
                if easm_equal(easm_label_name(instructions[index]), target):
                    assert index < count
                    found_index: i64 = index.i64()
                    assert found_index >= 0
                    assert found_index < count_signed
                    assert found_index.usize() == index
                    assert found_index.usize().i64() == found_index
                    assert forall prior in 0..<index: not easm_equal(easm_label_name(instructions[prior]), target)
                    return found_index
                assert not easm_equal(easm_label_name(instructions[index]), target)
                assert forall prior in 0..<(index + 1): not easm_equal(easm_label_name(instructions[prior]), target)
            assert forall candidate in 0..<count: not easm_equal(easm_label_name(instructions[candidate]), target)
            return -1

        def easm_is_conditional_jump(op: sview) -> bool:
            ensure result == (easm_starts(op, "j") and not easm_equal(op, "jmp") and not easm_equal(op, "jmpq"))
            return easm_starts(op, "j") and not easm_equal(op, "jmp") and not easm_equal(op, "jmpq")

        def easm_is_terminator(op: sview) -> bool:
            ensure result == (easm_equal(op, "jmp") or easm_equal(op, "jmpq") or easm_equal(op, "ret") or easm_equal(op, "retq"))
            return easm_equal(op, "jmp") or easm_equal(op, "jmpq") or easm_equal(op, "ret") or easm_equal(op, "retq")

        def easm_flow_equal(a: FlowState, b: FlowState) -> bool:
            return a.valid == b.valid and a.live == b.live and a.stack_delta == b.stack_delta and a.stack_mod16 == b.stack_mod16 and a.stack_known == b.stack_known and a.flags_live == b.flags_live

        def easm_propagate_flow(target: i64, incoming: FlowState, entries: mutable darray[FlowState]&, meets: mutable darray[i64]&, counts: mutable darray[i64]&) -> bool:
            if target < 0 or target >= entries.count.i64():
                return false
            changed: mutable bool = false
            if counts[target.usize()] == 0:
                meets[target.usize()] <- incoming.live
                counts[target.usize()] <- 1
            else:
                new_meet: i64 = meets[target.usize()] & incoming.live
                changed <- true if new_meet != meets[target.usize()]
                meets[target.usize()] <- new_meet
                counts[target.usize()] <- counts[target.usize()] + 1
            if not entries[target.usize()].valid:
                entries[target.usize()] <- incoming
                return true
            current: FlowState = entries[target.usize()]
            joined: FlowState = current
            joined.live <- current.live & incoming.live
            joined.flags_live <- current.flags_live and incoming.flags_live
            joined.stack_known <- current.stack_known and incoming.stack_known and current.stack_mod16 == incoming.stack_mod16
            joined.stack_mod16 <- current.stack_mod16 if joined.stack_known else 0
            joined.stack_delta <- current.stack_delta if current.stack_delta == incoming.stack_delta else 0
            changed <- true if not easm_flow_equal(current, joined)
            entries[target.usize()] <- joined
            return changed

        def easm_flow_transfer(instruction: Instruction, incoming: FlowState) -> FlowState:
            out: mutable FlowState = incoming
            written: i64 = easm_written_mask(instruction)
            if written != 0:
                out.live <- out.live | written
            if easm_starts(instruction.op, "call"):
                out.live <- out.live & (~EasmRegisterMasks::call_invalidates_live_mask())
                out.flags_live <- false
            if easm_starts(instruction.op, "cmp") or easm_starts(instruction.op, "test"):
                out.flags_live <- true
            if easm_starts(instruction.op, "add") or easm_starts(instruction.op, "sub"):
                out.flags_live <- false
            if easm_starts(instruction.op, "push"):
                out.stack_delta <- out.stack_delta - 8
                out.stack_mod16 <- (out.stack_mod16 - 8) % 16 if out.stack_known
            stack_write_handled: mutable bool = false
            if easm_starts(instruction.op, "pop"):
                pop_destination: sview = easm_register_operand(easm_substitute_operand(easm_last_operand(instruction.text), instruction))
                stack_write_handled <- true
                if easm_register_bit(pop_destination) == EasmRegisterMasks::RSP:
                    out.stack_known <- false
                    out.stack_mod16 <- 0
                else:
                    out.stack_delta <- out.stack_delta + 8
                    out.stack_mod16 <- (out.stack_mod16 + 8) % 16 if out.stack_known
            if easm_starts(instruction.op, "add") or easm_starts(instruction.op, "sub"):
                stack_destination: sview = easm_register_operand(easm_substitute_operand(easm_last_operand(instruction.text), instruction))
                if easm_register_bit(stack_destination) == EasmRegisterMasks::RSP:
                    stack_write_handled <- true
                    if stack_destination != "rsp":
                        out.stack_known <- false
                        out.stack_mod16 <- 0
                    else:
                        immediate_operand: sview = easm_substitute_operand(easm_first_operand(instruction.text), instruction)
                        immediate: (valid: bool, value: i64) = easm_immediate_operand_after_dollar_checked(immediate_operand)
                        if not immediate.valid:
                            out.stack_known <- false
                            out.stack_mod16 <- 0
                        else:
                            out.stack_delta <- out.stack_delta + immediate.value if easm_starts(instruction.op, "add") else out.stack_delta - immediate.value
                            out.stack_mod16 <- (out.stack_mod16 + immediate.value) % 16 if easm_starts(instruction.op, "add") and out.stack_known
                            out.stack_mod16 <- (out.stack_mod16 - immediate.value) % 16 if easm_starts(instruction.op, "sub") and out.stack_known
            if easm_writes_stack_pointer(instruction) and not stack_write_handled:
                out.stack_known <- false
                out.stack_mod16 <- 0
            return out

        def easm_provenance_slot(register: sview) -> i64:
            bit: i64 = easm_register_bit(register)
            return match bit:
                1: 0
                2: 1
                4: 2
                8: 3
                16: 4
                32: 5
                64: 6
                128: 7
                256: 8
                512: 9
                1024: 10
                2048: 11
                4096: 12
                8192: 13
                16384: 14
                32768: 15
                _: -1

        def easm_empty_provenance_flow() -> ProvenanceFlow:
            types: mutable darray[sview] = []
            for _ in 0..<16 |types|:
                types.push("")
            return ProvenanceFlow{types: types, ambiguous: 0, valid: false}

        def easm_provenance_flow_equal(a: ProvenanceFlow, b: ProvenanceFlow) -> bool:
            return false if a.valid != b.valid or a.ambiguous != b.ambiguous or a.types.count != b.types.count
            for index in 0..<a.types.count |a, b|:
                return false if a.types[index] != b.types[index]
            return true

        def easm_provenance_flow_propagate(target: i64, incoming: ProvenanceFlow, entries: mutable darray[ProvenanceFlow]&, counts: mutable darray[i64]&) -> bool:
            return false if target < 0 or target >= entries.count.i64()
            if not entries[target.usize()].valid:
                entries[target.usize()] <- incoming
                counts[target.usize()] <- 1
                return true
            current: ProvenanceFlow = entries[target.usize()]
            joined: ProvenanceFlow = current
            joined.valid <- true
            for index in 0..<joined.types.count |index, joined, current, incoming|:
                if current.types[index] != incoming.types[index]:
                    joined.ambiguous <- joined.ambiguous | (1 << index.i64())
                    joined.types[index] <- ""
                if (current.ambiguous & (1 << index.i64())) != 0 or (incoming.ambiguous & (1 << index.i64())) != 0:
                    joined.ambiguous <- joined.ambiguous | (1 << index.i64())
            counts[target.usize()] <- counts[target.usize()] + 1
            changed: bool = not easm_provenance_flow_equal(current, joined)
            entries[target.usize()] <- joined
            return changed

        def easm_provenance_flow_transfer(instruction: Instruction, incoming: ProvenanceFlow) -> ProvenanceFlow:
            out: mutable ProvenanceFlow = incoming
            implicit_clobbers: mutable i64 = EasmRegisterMasks::implicit_result_write_mask(instruction.op)
            if easm_starts(instruction.op, "call"):
                implicit_clobbers <- EasmRegisterMasks::call_clobber_mask()
            if implicit_clobbers != 0:
                for slot in 0..<out.types.count |slot, out, implicit_clobbers|:
                    bit: i64 = 1 << slot.i64()
                    if (implicit_clobbers & bit) != 0:
                        out.types[slot] <- ""
                out.ambiguous <- out.ambiguous & (~implicit_clobbers)
                return out
            return out if easm_starts(instruction.op, "cmp") or easm_starts(instruction.op, "test") or easm_starts(instruction.op, "push") or easm_starts(instruction.op, "jmp") or easm_starts(instruction.op, "ret")
            destination_operand: sview = easm_substitute_operand(easm_last_operand(instruction.text), instruction)
            source: sview = easm_substitute_operand(easm_first_operand(instruction.text), instruction)
            destination: sview = easm_register_operand(destination_operand)
            source_register: sview = easm_register_operand(source)
            destination_slot: i64 = easm_provenance_slot(destination)
            source_slot: i64 = easm_provenance_slot(source_register)
            op: sview = instruction.op
            destination_width: i64 = EasmAddressWidthPolicy::address_register_width(destination)
            source_width: i64 = EasmAddressWidthPolicy::address_register_width(source_register)
            if easm_starts(instruction.op, "xchg"):
                full_width_exchange: bool = destination_width == EasmAddressWidthPolicy::ADDRESS_REGISTER_WIDTH_64 and source_width == EasmAddressWidthPolicy::ADDRESS_REGISTER_WIDTH_64 and (op == "xchgq" or op == "xchg")
                if full_width_exchange and source_slot >= 0 and destination_slot >= 0:
                    source_type: sview = out.types[source_slot.usize()]
                    destination_type: sview = out.types[destination_slot.usize()]
                    source_ambiguous: bool = (out.ambiguous & (1 << source_slot)) != 0
                    destination_ambiguous: bool = (out.ambiguous & (1 << destination_slot)) != 0
                    source_mask: i64 = 1 << source_slot
                    destination_mask: i64 = 1 << destination_slot
                    out.types[source_slot.usize()] <- destination_type
                    out.types[destination_slot.usize()] <- source_type
                    out.ambiguous <- out.ambiguous & (~(source_mask | destination_mask))
                    out.ambiguous <- out.ambiguous | source_mask if destination_ambiguous
                    out.ambiguous <- out.ambiguous | destination_mask if source_ambiguous
                else:
                    if source_slot >= 0:
                        out.types[source_slot.usize()] <- ""
                        out.ambiguous <- out.ambiguous & (~(1 << source_slot))
                    if destination_slot >= 0:
                        out.types[destination_slot.usize()] <- ""
                        out.ambiguous <- out.ambiguous & (~(1 << destination_slot))
                return out
            return out if destination_slot < 0
            if (op == "mov" or op == "movq") and destination_width == EasmAddressWidthPolicy::ADDRESS_REGISTER_WIDTH_64 and (source_slot < 0 or source_width == EasmAddressWidthPolicy::ADDRESS_REGISTER_WIDTH_64):
                out.types[destination_slot.usize()] <- out.types[source_slot.usize()] if source_slot >= 0 else ""
                out.ambiguous <- out.ambiguous | (1 << destination_slot) if source_slot >= 0 and (out.ambiguous & (1 << source_slot)) != 0 else out.ambiguous & (~(1 << destination_slot))
            elif (op == "lea" or op == "leaq") and destination_width == EasmAddressWidthPolicy::ADDRESS_REGISTER_WIDTH_64:
                base: sview = easm_memory_base_register(source)
                base_slot: i64 = easm_provenance_slot(base)
                base_width: i64 = EasmAddressWidthPolicy::address_register_width(base)
                out.types[destination_slot.usize()] <- out.types[base_slot.usize()] if base_slot >= 0 and base_width == EasmAddressWidthPolicy::ADDRESS_REGISTER_WIDTH_64 else ""
                out.ambiguous <- out.ambiguous | (1 << destination_slot) if base_slot >= 0 and base_width == EasmAddressWidthPolicy::ADDRESS_REGISTER_WIDTH_64 and (out.ambiguous & (1 << base_slot)) != 0 else out.ambiguous & (~(1 << destination_slot))
            elif (op == "add" or op == "addq" or op == "sub" or op == "subq" or op == "inc" or op == "incq" or op == "dec" or op == "decq") and destination_width == EasmAddressWidthPolicy::ADDRESS_REGISTER_WIDTH_64:
                return out
            else:
                out.types[destination_slot.usize()] <- ""
                out.ambiguous <- out.ambiguous & (~(1 << destination_slot))
            return out

        # Unlike the linear provenance walk, this pass meets carrier facts at labels. A dereference
        # after a branch is rejected only when the base's provenance actually disagrees between
        # incoming edges, avoiding false positives for ordinary raw registers.
        def easm_verify_provenance_merges(fn: Function, issues: mutable darray[Issue]&) -> void:
            count: usize = fn.instructions.count
            return if count == 0
            entries: mutable darray[ProvenanceFlow] = []
            incoming_counts: mutable darray[i64] = []
            for _ in 0..<count |entries, incoming_counts|:
                entries.push(easm_empty_provenance_flow())
                incoming_counts.push(0)
            initial: ProvenanceFlow = easm_empty_provenance_flow()
            initial.valid <- true
            for input in fn.inputs:
                register: sview = easm_binding_register(input)
                slot: i64 = easm_provenance_slot(register)
                if slot >= 0:
                    initial.types[slot.usize()] <- easm_param_type(fn, easm_binding_name(input))
            entries[0] <- initial
            incoming_counts[0] <- 1
            for _ in 0..<(count + 1) |entries, incoming_counts, fn, issues|:
                changed: mutable bool = false
                for index in 0..<count |index, entries, incoming_counts, fn, issues, changed|:
                    continue if not entries[index].valid
                    instruction: Instruction = fn.instructions[index]
                    state: ProvenanceFlow = easm_provenance_flow_transfer(instruction, entries[index])
                    if easm_starts(instruction.op, "j"):
                        target: sview = easm_substitute_operand(easm_last_operand(instruction.text), instruction)
                        if target.len > 0 and target[0] != 37:
                            changed <- easm_provenance_flow_propagate(easm_label_index(fn.instructions, target), state, entries, incoming_counts) or changed
                        continue if easm_is_terminator(instruction.op)
                    if not easm_is_terminator(instruction.op) and index + 1 < count:
                        changed <- easm_provenance_flow_propagate(index.i64() + 1, state, entries, incoming_counts) or changed
                break if not changed
            for index in 0..<count |index, entries, incoming_counts, fn, issues|:
                # The ambiguity is attached to the merged entry state and is propagated through
                # the label itself, so the first instruction after a label may have one textual
                # predecessor even though its state came from multiple incoming edges.
                continue if entries[index].ambiguous == 0
                instruction: Instruction = fn.instructions[index]
                continue if instruction.op == "label"
                operand_scan: EasmOperandScan::InstructionScanResult = EasmOperandScan::scan_instruction(instruction.text)
                operand_count: usize = 1 if operand_scan.valid and operand_scan.count == 1 else 2
                for operand_index in 0..<operand_count |operand_index, instruction, entries, issues|:
                    raw_operand: sview = easm_first_operand(instruction.text) if operand_index == 0 else easm_last_operand(instruction.text)
                    operand: sview = easm_substitute_operand(raw_operand, instruction)
                    continue if not easm_memory_operand(operand)
                    base: sview = easm_memory_base_register(operand)
                    slot: i64 = easm_provenance_slot(base)
                    if slot >= 0 and (entries[index].ambiguous & (1 << slot)) != 0:
                        issues.push(Issue{severity: Severity.Error, code: "provenance-merge-unsound", line: instruction.line, message: "memory base has conflicting typed-carrier provenance at a control-flow merge"})

        # Resolve a register's typed carrier through multi-hop mov/lea chains back to an
        # input parameter. Single-edge lookups miss intermediate copies (`HostPtr -> rcx -> rdx`).
        def easm_resolve_carrier_type(fn: Function, register: sview, limit: i64) -> sview:
            return "" if register == "" or limit <= 0
            direct: sview = easm_input_type_for_register(fn, register)
            return direct if direct != ""
            # Walk instructions in reverse, following the last write that defines `register`.
            probe: mutable i64 = fn.instructions.count.i64() - 1
            while probe >= 0 |probe, fn, register, limit|:
                candidate: Instruction = fn.instructions[probe.usize()]
                if easm_starts(candidate.op, "mov") or easm_starts(candidate.op, "lea"):
                    destination: sview = easm_substitute_operand(easm_last_operand(candidate.text), candidate)
                    source_operand: sview = easm_substitute_operand(easm_first_operand(candidate.text), candidate)
                    if easm_register_operand(destination) == register:
                        source: mutable sview = easm_register_operand(source_operand)
                        source <- easm_memory_base_register(source_operand) if easm_starts(candidate.op, "lea") else source
                        return easm_resolve_carrier_type(fn, source, limit - 1)
                probe <- probe - 1
            return ""
