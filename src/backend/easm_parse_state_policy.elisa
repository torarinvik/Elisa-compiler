# State tags and index-domain policy for the EASM line parser.

extend Easm:
    public:
        const enum EasmBodyMode of u8:
            None
            Reference
            Target

        const enum EasmDeclarationKind of u8:
            None
            Function
            Fragment
            Protocol
            Template
            Layout

        def easm_declaration_index_valid(kind: EasmDeclarationKind, index: i64, function_count: usize, fragment_count: usize, protocol_count: usize, template_count: usize) -> bool:
            ensure (kind == EasmDeclarationKind.Function) implies result == (index >= 0 and index.usize() < function_count)
            ensure (kind == EasmDeclarationKind.Fragment) implies result == (index >= 0 and index.usize() < fragment_count)
            ensure (kind == EasmDeclarationKind.Protocol) implies result == (index >= 0 and index.usize() < protocol_count)
            ensure (kind == EasmDeclarationKind.Template) implies result == (index >= 0 and index.usize() < template_count)
            ensure (kind == EasmDeclarationKind.None or kind == EasmDeclarationKind.Layout) implies result
            match kind:
                EasmDeclarationKind.Function:
                    return index >= 0 and index.usize() < function_count
                EasmDeclarationKind.Fragment:
                    return index >= 0 and index.usize() < fragment_count
                EasmDeclarationKind.Protocol:
                    return index >= 0 and index.usize() < protocol_count
                EasmDeclarationKind.Template:
                    return index >= 0 and index.usize() < template_count
                _:
                    return true

        def easm_body_routing_valid(mode: EasmBodyMode, kind: EasmDeclarationKind, active_target: i64) -> bool:
            ensure result == (
                (mode != EasmBodyMode.Target or (active_target >= 0 and kind == EasmDeclarationKind.Function))
                and (mode != EasmBodyMode.Reference or kind == EasmDeclarationKind.Function or kind == EasmDeclarationKind.Fragment)
            )
            return (mode != EasmBodyMode.Target or (active_target >= 0 and kind == EasmDeclarationKind.Function))
                and (mode != EasmBodyMode.Reference or kind == EasmDeclarationKind.Function or kind == EasmDeclarationKind.Fragment)

        def easm_source_span_valid(start: usize, end: usize, source_length: usize, buffer_count: usize) -> bool:
            requires source_length <= buffer_count
            ensure result == (start <= end and end <= source_length and end <= buffer_count)
            return start <= end and end <= source_length and end <= buffer_count
