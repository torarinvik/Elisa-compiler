# Stage1 backend — the CALL-shaped expression statements, the longest of the statement forms:
# a method call on a container, a store operation, a submitted task, and every other call
# emitted for its effect rather than its value. The chain's last link, so this is where
# `handled <- false` finally declines. Part of `module Backend` (see codegen.elisa).

extend Backend:
    private:
        def emit_statement_expr_calls[@scope_region, @loops_region, @regions_region, @fns_region, @structs_region, @generics_region](statement: Stmt, return_type: ValueType, local_scope: mutable Scope& @scope_region, loops: mutable LoopStack& @loops_region, regions: mutable RegionStack& @regions_region, fns: FnTable& @fns_region, structs: mutable StructTable& @structs_region, generics: mutable GenericTable& @generics_region, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef, handled: mutable bool&) -> EmitStatus can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            match statement:
                Stmt.Expr(statement_expression, statement_expression_line):
                    # `pass` parses to Stmt.Expr(Expr.Invalid) — a deliberate no-op, so emit nothing
                    # and stay open (emitting Expr.Invalid as a value would decline the function).
                    match statement_expression:
                        Expr.Invalid:
                            return EmitStatus.Open
                        _:
                            pass
                    # A discarded helper result can itself hide a pool-lifetime handle inside
                    # an aggregate.
                    # The sole exception is the direct marked-submit shape that the block
                    # emitter adds to the active structured group before returning here.
                    if (local_scope.pool_names.count > 0 or local_scope.group_names.count > 0) and backend_expression_may_contain_pool_lifetime_handle(statement_expression, expression_type(statement_expression, local_scope, fns, structs, generics), local_scope, fns, structs, generics):
                        direct_grouped_submit: mutable bool = false
                        match statement_expression:
                            Expr.Block(submit_statements, _, _, submit_pos):
                                direct_grouped_submit <- submit_statements.count == 0 and submit_marker_at(submit_pos.offset, structs) and local_scope.group_names.count > 0
                            _:
                                pass
                        if not direct_grouped_submit:
                            structs.diagnostics.decline_line <- statement_expression_line.line if structs.diagnostics.decline_line == 0
                            structs.diagnostics.decline_kind <- "Pool-lifetime handle expression discarded inside a lexical pool needs ownership tracking"
                            return EmitStatus.Declined
                    # `try f(x) else return N` in STATEMENT position. The guarded value is
                    # discarded; only the recovery branch carries meaning. emit_expression
                    # deliberately declines a GetElse that carries a recovery (it is control
                    # flow, not a value) and defers to "the statement paths" — but no statement
                    # path owned the BARE form, so a shape stage0 accepts declined here with
                    # "(expression statement)". Route it through the LOCAL-declaration emitter,
                    # which already lowers every GetElse shape, exactly as `return <GetElse>`
                    # does with its own synthetic binding. The annotation is Invalid on purpose:
                    # that branch types the binding from the guarded payload and never reads it.
                    match statement_expression:
                        Expr.GetElse(stmt_get_guarded, stmt_get_recovery, stmt_get_pos):
                            if stmt_get_recovery.count != 0:
                                # A DIRECT call to an error-returning function shares the
                                # propagating-try lowering, which already handles a VOID success
                                # payload. Two-level match: the backend's packed-is binds only
                                # top-level fields, so a nested pattern would decline in self-host.
                                match stmt_get_guarded:
                                    Expr.Call(stmt_get_callee, stmt_get_args, stmt_get_names, stmt_get_call_pos):
                                        match try_callee_as_ident_with_generics(stmt_get_callee, fns, structs, generics):
                                            Expr.Ident(stmt_get_name, stmt_get_name_pos):
                                                return emit_propagating_try(stmt_get_name, stmt_get_args, stmt_get_recovery, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder, try_callee_owner_with_generics(stmt_get_callee, fns, structs, generics)) can Global{Read,Write}
                                            _:
                                                pass
                                    _:
                                        pass
                                # Anything else (a `get OPT else …` over a non-call) still routes
                                # through the LOCAL-declaration emitter, which owns those shapes.
                                return emit_statement((Stmt.VarDecl("__stmt_get", (Expr.Invalid), statement_expression, stmt_get_pos)), return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}
                        _:
                            pass
                    # `f(a) if COND else g(b)` — a TERNARY in STATEMENT position, where both arms
                    # are side-effecting CALLS rather than values (diagnostic_messages/ picks
                    # between two `buffer.extend(...)` calls this way). Emitting it as a VALUE
                    # declines: the arms are void. Lower it as an if/else over the two arms run as
                    # STATEMENTS, which is what it means.
                    match statement_expression:
                        Expr.If(ternary_condition, ternary_then, ternary_else, ternary_line):
                            match ternary_else:
                                Expr.Absent:
                                    pass
                                _:
                                    if (emit_condition(ternary_condition, local_scope, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}) is ternary_bit:
                                        ternary_function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                                        ternary_then_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, ternary_function, "ternary.then")
                                        ternary_else_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, ternary_function, "ternary.else")
                                        ternary_done_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, ternary_function, "ternary.done")
                                        _ = LLVMBuildCondBr(builder, ternary_bit, ternary_then_block, ternary_else_block)
                                        LLVMPositionBuilderAtEnd(builder, ternary_then_block)
                                        ternary_then_status: EmitStatus = emit_statement((Stmt.Expr(ternary_then, ternary_line)), return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}
                                        return EmitStatus.Declined if ternary_then_status == EmitStatus.Declined
                                        branch_if_open(ternary_then_status, builder, ternary_done_block)
                                        LLVMPositionBuilderAtEnd(builder, ternary_else_block)
                                        ternary_else_status: EmitStatus = emit_statement((Stmt.Expr(ternary_else, ternary_line)), return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}
                                        return EmitStatus.Declined if ternary_else_status == EmitStatus.Declined
                                        branch_if_open(ternary_else_status, builder, ternary_done_block)
                                        LLVMPositionBuilderAtEnd(builder, ternary_done_block)
                                        return EmitStatus.Open
                                    return EmitStatus.Declined
                        _:
                            pass
                    # A bare IDENT as a statement is the accumulator yield of a capture-listed loop,
                    # restated per branch: `for d in ds |table| -> table:` whose match arms each end
                    # in `table`. The loop's own `-> table` is already treated as a no-op annotation
                    # below (captures mutate in place), and these per-arm restatements are the same
                    # annotation — evaluating an identifier has no effect, so emit nothing.
                    #
                    # Only when the name is a LOCAL IN SCOPE. That is what keeps this from
                    # resurrecting the THREADING form `|n = 0| -> n + x`, where the yield really does
                    # feed the next iteration and discarding it would be a silent wrong answer:
                    # stage0 gives that form a shadowing loop-local (verified — the outer `n` is
                    # unchanged), stage1 models no such local and declines the whole `for` before
                    # reaching the body. A non-Ident yield is not matched here at all.
                    match statement_expression:
                        Expr.Ident(bare_stmt_name, bare_stmt_line):
                            return EmitStatus.Open if lookup_type(local_scope, bare_stmt_name).kind != TypeKind.Unmodeled
                        _:
                            pass
                    # A bare LITERAL as a statement (`0` on its own line) is a no-op stage0 accepts
                    # and emits nothing for. It reaches here as an ordinary value expression and
                    # declined the whole function — which mattered because it is the natural way to
                    # end a `catch` arm, where stage0 REQUIRES an expression tail.
                    match statement_expression:
                        Expr.IntLit:
                            return EmitStatus.Open
                        Expr.BoolLit:
                            return EmitStatus.Open
                        Expr.FloatLit:
                            return EmitStatus.Open
                        _:
                            pass
                    # A capture-listed loop (`for … |m, total|:`) parses as
                    # Stmt.Expr(Expr.Block([accumulator decls…, the loop], yield, captures)).
                    # In STATEMENT position with no yield the block is just its statements —
                    # captures are annotations, and the accumulator declarations are emitted as
                    # ordinary VarDecls in the ENCLOSING scope. Other yielded values use
                    # the scoped expression emitter below and discard their result.
                    #
                    # WARNING: enclosing-scope emission is only sound for a capture WITHOUT an
                    # initializer (`|acc|`), which names an existing outer local and mutates it in
                    # place. An INITIALIZED capture (`|n = 0|`) is a different thing: stage0 gives
                    # it a SHADOWING loop-local, so the outer `n` is untouched after the loop.
                    # Measured, not assumed — this comment previously claimed "stage0 scopes them
                    # the same way" and that is FALSE: for
                    #     n: mutable i64 = 100
                    #     for x in xs |n = 0|: n <- n + x
                    #     return n
                    # stage0 returns 100, while emitting the decl into the enclosing scope returns
                    # the accumulated 4. The initialized form is kept DECLINING for exactly this
                    # reason (its untyped decl fails to resolve a type, which is what stops it
                    # today); do not "fix" that type inference without also giving the accumulator
                    # its own scope, or the loop silently returns the wrong variable.
                    match statement_expression:
                        Expr.Block(block_statements, block_value, block_captures, block_line):
                            # A submitted task is represented as an empty value block too, but it is
                            # still a STATEMENT semantically. Route it through emit_expression so the
                            # pool submission lowering runs instead of treating the non-invalid tail as
                            # an unsupported value-block statement.
                            if block_statements.count == 0:
                                marker_head: sview = fn_return_head_at_offset(block_line.offset, block_line.line, structs)
                                if marker_head == "__wait_all":
                                    wait_all_arguments: mutable darray[Expr] = [block_value]
                                    if (emit_call(Expr.Ident("task_group_wait_all", block_line), wait_all_arguments, [], local_scope, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}) is waited_all:
                                        _ = waited_all
                                        return EmitStatus.Open
                                    return EmitStatus.Declined
                                if marker_head == "__submit" or marker_head == "__await":
                                    if (emit_expression(statement_expression, ValueType{kind: TypeKind.Void, bits: 0}, local_scope, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}) is wrapped_statement:
                                        _ = wrapped_statement
                                        return EmitStatus.Open
                                    return EmitStatus.Declined
                            # Loop headers `for … |cap| -> cap:` yield the capture back for rebinding.
                            # In statement position lmut/captures already mutate in place, so a yield
                            # that is just the capture Ident is a no-op annotation — emit the body.
                            # (Lexer `for _ in count..>0 |lexer| -> lexer:` is this form.)
                            # In STATEMENT position the yield is a no-op annotation: bare captures
                            # mutate in place, and an initialized accumulator is a block-scoped local
                            # whose value has nowhere to go. Accept a bare capture ident, an accumulator
                            # this block declares, and a TUPLE of those — `for s in xs |a, b| -> a, b:`
                            # is how the semantic layer's multi-accumulator walkers are written, and the
                            # tuple form declined outright.
                            #
                            # Restricted to names this block BINDS. A yield naming anything else would be
                            # a real value being discarded, which is not safe to assume.
                            yield_ok: mutable bool = block_value is Expr.Invalid
                            match block_value:
                                Expr.Ident(yield_name, yield_line):
                                    yield_ok <- block_yield_name_is_bound(yield_name, block_captures, block_statements)
                                _:
                                    pass
                            match block_value:
                                Expr.Tuple(yield_elements, yield_tuple_line):
                                    yield_all_bound: mutable bool = yield_elements.count > 0
                                    for yield_element in yield_elements |yield_all_bound, block_captures, block_statements|:
                                        match yield_element:
                                            Expr.Ident(yield_el_name, _):
                                                yield_all_bound <- false if not block_yield_name_is_bound(yield_el_name, block_captures, block_statements)
                                            _:
                                                yield_all_bound <- false
                                    yield_ok <- yield_all_bound
                                _:
                                    pass
                            if not yield_ok:
                                # A discarded value block still evaluates its branches and
                                # cleanup in its own scope. State threads use this path with
                                # a scalar identity marker instead of an aggregate copy.
                                discarded_type: ValueType = resolve_type(statement_expression, ValueType{kind: TypeKind.Signed, bits: 64}, local_scope, fns, structs, generics)
                                if (emit_expression(statement_expression, discarded_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}) is discarded_value:
                                    _ = discarded_value
                                    return EmitStatus.Open
                                return EmitStatus.Declined
                            # An INITIALIZED capture (`|n = 0|`) desugars to an untyped VarDecl named by
                            # the capture list. stage0 gives it a SHADOWING loop-local, so it must NOT
                            # survive into the enclosing scope — emitting it there makes the loop mutate
                            # the caller's variable of the same name (measured: 4 where stage0 gives 100,
                            # see the WARNING above). Emit the whole block scoped so the accumulator dies
                            # with it.
                            #
                            # Only when such a decl is actually present: an UNINITIALIZED capture
                            # (`|acc|`) names an existing outer local that the body mutates in place, and
                            # scoping that would be wrong in the other direction — the mutation has to
                            # outlive the loop.
                            block_has_accumulator_decl: mutable bool = false
                            for acc_stmt in block_statements |block_has_accumulator_decl, block_captures|:
                                match acc_stmt:
                                    Stmt.VarDecl(acc_name, acc_type, acc_value, acc_line):
                                        # Typed (`|position: usize = 0|`) as well as untyped: an INITIALIZED
                                        # capture shadows either way, so both must be block-scoped.
                                        block_has_accumulator_decl <- true
                                    _:
                                        pass
                            if block_has_accumulator_decl:
                                return emit_statements_scoped(block_statements, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}
                            return emit_statements(&block_statements, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}
                        _:
                            pass
                    match statement_expression:
                        Expr.Call(_, _, _, _):
                            return emit_statement_call_expression(statement_expression, statement, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder, handled) can Global{Read,Write}
                        _:
                            pass
                    # A DISCARDED expression statement — a bare `n + 1`, which stage0 evaluates
                    # and throws the value away. Everything above handles a SHAPE (a call, a
                    # ternary of calls, a capture block); this is the general case, and without
                    # it the whole function DROPPED (measured on
                    # test/fixtures/diagnostics/unused_expression.pos.elisa, which stage0
                    # compiles). Emitting for value and ignoring the result IS the semantics.
                    # A shape whose type cannot be inferred, or that the expression emitter
                    # cannot model, still declines — this widens what compiles, never what is
                    # silently guessed.
                    discard_type: ValueType = expression_type(statement_expression, local_scope, fns, structs, generics)
                    if discard_type.kind != TypeKind.Unmodeled:
                        if (emit_expression(statement_expression, discard_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}) is discarded_statement_value:
                            _ = discarded_statement_value
                            return EmitStatus.Open
                    return EmitStatus.Declined
                _:
                    pass
            handled <- false
            return EmitStatus.Declined
