# Scalar lower-bound domain for EASM memory-size reasoning.
module EasmMemStateDomain:
    public:
        def join_min(left: i64, right: i64) -> i64:
            ensure result == (left if left < right else right)
            return left if left < right else right

        ghost def join_min_obeys_greatest_lower_bound_law(left: i64, right: i64, lower: i64) -> bool:
            requires lower <= left and lower <= right
            ensure result == true
            minimum: i64 = join_min(left, right)
            if left < right:
                assert minimum == left
                return lower <= minimum
            assert minimum == right
            return lower <= minimum

        # Facts about one path accumulate conjunctively, so retain the strongest lower bound.
        def greatest_bound(left: i64, right: i64) -> i64:
            ensure result >= left
            ensure result >= right
            ensure result == (left if left > right else right)
            return left if left > right else right

        ghost def greatest_bound_obeys_least_upper_bound_law(left: i64, right: i64, upper: i64) -> bool:
            requires left <= upper and right <= upper
            ensure result == true
            maximum: i64 = greatest_bound(left, right)
            if left > right:
                assert maximum == left
                return maximum <= upper
            assert maximum == right
            return maximum <= upper

        def read_well_typed(need: i64, known_min: i64) -> bool:
            ensure result == (need <= known_min)
            return need <= known_min

        def guard_join(left: i64, right: i64, need: i64) -> bool:
            ensure result == (need <= (left if left < right else right))
            ensure result == (need <= left and need <= right)
            return read_well_typed(need, join_min(left, right))
