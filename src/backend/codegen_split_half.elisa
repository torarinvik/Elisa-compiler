# Canonicalize the split-half u64 addition idiom before LLVM optimization.
# Resolve only private, ordinary, single-store i64 allocas with bounded work.
# LLVM-C does not expose all alloca flags: require an exact canonical printed
# instruction, and decline on format changes, debug records, or uncertainty.
include "./posix_loader.elisa"

extend Backend:
    public:
        struct SplitPair:
            valid: bool
            left: LLVMValueRef?
            right: LLVMValueRef?

        def split_opcode(value: LLVMValueRef, op: u32, budget: SplitBudget&) -> bool can[Unsafe.PointerCast, Unsafe.PointerArithmetic]:
            return false if LLVMIsAInstruction(value) == null
            return false if LLVMGetInstructionOpcode(value) != op
            return false if (budget.debug_fn.call_as[fn(LLVMValueRef) -> void&?](value) can[Unsafe.PointerCast, Unsafe.PointerArithmetic]) != null
            ty: LLVMTypeRef = LLVMTypeOf(value)
            return false if LLVMGetTypeKind(ty) != 8
            return LLVMGetIntTypeWidth(ty) == 64

        def split_constant(value: LLVMValueRef, expected: u64) -> bool:
            return false if LLVMIsAConstantInt(value) == null
            ty: LLVMTypeRef = LLVMTypeOf(value)
            return false if LLVMGetTypeKind(ty) != 8
            return false if LLVMGetIntTypeWidth(ty) != 64
            return LLVMConstIntGetZExtValue(value) == expected

        def split_mask(value_in: LLVMValueRef, function_size: usize, budget: mutable SplitBudget&) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Unsafe.PointerArithmetic]:
            if (split_resolve(value_in, 0, function_size, budget) can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Unsafe.PointerArithmetic]) is value:
                return null if not (split_opcode(value, 23, budget) can[Unsafe.PointerCast, Unsafe.PointerArithmetic])
                left: LLVMValueRef = LLVMGetOperand(value, 0)
                right: LLVMValueRef = LLVMGetOperand(value, 1)
                return split_resolve(right, 0, function_size, budget) can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Unsafe.PointerArithmetic] if split_constant(left, 4294967295)
                return split_resolve(left, 0, function_size, budget) can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Unsafe.PointerArithmetic] if split_constant(right, 4294967295)
            return null

        def split_shift(value_in: LLVMValueRef, op: u32, input: LLVMValueRef, function_size: usize, budget: mutable SplitBudget&) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Unsafe.PointerArithmetic]:
            if (split_resolve(value_in, 0, function_size, budget) can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Unsafe.PointerArithmetic]) is value:
                return false if not (split_opcode(value, op, budget) can[Unsafe.PointerCast, Unsafe.PointerArithmetic])
                actual_opt: LLVMValueRef? = split_resolve(LLVMGetOperand(value, 0), 0, function_size, budget) can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Unsafe.PointerArithmetic]
                if actual_opt is actual:
                    return false if actual != input
                else:
                    return false
                return false if not split_constant(LLVMGetOperand(value, 1), 32)
                if op == 21:
                    return false if (budget.exact_fn.call_as[fn(LLVMValueRef) -> i32](value) can[Unsafe.PointerCast, Unsafe.PointerArithmetic]) != 0
                if op == 20:
                    return false if (budget.nuw_fn.call_as[fn(LLVMValueRef) -> i32](value) can[Unsafe.PointerCast, Unsafe.PointerArithmetic]) != 0
                    return false if (budget.nsw_fn.call_as[fn(LLVMValueRef) -> i32](value) can[Unsafe.PointerCast, Unsafe.PointerArithmetic]) != 0
                return true

            return false

        def split_low_sum(value: LLVMValueRef, function_size: usize, budget: mutable SplitBudget&) -> SplitPair can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Unsafe.PointerArithmetic]:
            empty: SplitPair = SplitPair{valid: false, left: null, right: null}
            return empty if not (split_opcode(value, 8, budget) can[Unsafe.PointerCast, Unsafe.PointerArithmetic])
            return empty if (budget.nuw_fn.call_as[fn(LLVMValueRef) -> i32](value) can[Unsafe.PointerCast, Unsafe.PointerArithmetic]) != 0 or (budget.nsw_fn.call_as[fn(LLVMValueRef) -> i32](value) can[Unsafe.PointerCast, Unsafe.PointerArithmetic]) != 0
            if (split_mask(LLVMGetOperand(value, 0), function_size, budget) can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Unsafe.PointerArithmetic]) is left:
                if (split_mask(LLVMGetOperand(value, 1), function_size, budget) can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Unsafe.PointerArithmetic]) is right:
                    return SplitPair{valid: true, left: left, right: right}
            empty

        def split_high_sum(value: LLVMValueRef, left: LLVMValueRef, right: LLVMValueRef, low: LLVMValueRef, function_size: usize, budget: mutable SplitBudget&) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Unsafe.PointerArithmetic]:
            pending: mutable darray[LLVMValueRef] = [value]
            terms: mutable darray[LLVMValueRef] = []
            while pending.count > 0 |pending, terms, function_size, budget|:
                term_opt: LLVMValueRef? = split_resolve(pending[pending.count - 1], 0, function_size, budget) can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Unsafe.PointerArithmetic]
                pending.pop()
                return false if term_opt == null
                term: LLVMValueRef = term_opt
                if (split_opcode(term, 8, budget) can[Unsafe.PointerCast, Unsafe.PointerArithmetic]):
                    return false if (budget.nuw_fn.call_as[fn(LLVMValueRef) -> i32](term) can[Unsafe.PointerCast, Unsafe.PointerArithmetic]) != 0 or (budget.nsw_fn.call_as[fn(LLVMValueRef) -> i32](term) can[Unsafe.PointerCast, Unsafe.PointerArithmetic]) != 0
                    return false if pending.count + terms.count + 2 > 3
                    pending.push(LLVMGetOperand(term, 0))
                    pending.push(LLVMGetOperand(term, 1))
                else:
                    terms.push(term)
                    return false if terms.count > 3
            return false if terms.count != 3
            used_left: mutable bool = false
            used_right: mutable bool = false
            used_low: mutable bool = false
            for index in 0..<3 |terms, left, right, low, used_left, used_right, used_low, function_size, budget|:
                term: LLVMValueRef = terms[index]
                if not used_left and (split_shift(term, 21, left, function_size, budget) can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Unsafe.PointerArithmetic]):
                    used_left <- true
                elif not used_right and (split_shift(term, 21, right, function_size, budget) can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Unsafe.PointerArithmetic]):
                    used_right <- true
                elif not used_low and (split_shift(term, 21, low, function_size, budget) can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Unsafe.PointerArithmetic]):
                    used_low <- true
                else:
                    return false
            used_left and used_right and used_low

        def split_match_order(root: LLVMValueRef, order: u32, function_size: usize, budget: mutable SplitBudget&) -> SplitPair can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Unsafe.PointerArithmetic]:
            empty: SplitPair = SplitPair{valid: false, left: null, right: null}
            high: LLVMValueRef = LLVMGetOperand(root, order)
            low_masked: LLVMValueRef = LLVMGetOperand(root, 1 - order)
            return empty if not (split_opcode(high, 20, budget) can[Unsafe.PointerCast, Unsafe.PointerArithmetic])
            return empty if (budget.nuw_fn.call_as[fn(LLVMValueRef) -> i32](high) can[Unsafe.PointerCast, Unsafe.PointerArithmetic]) != 0 or (budget.nsw_fn.call_as[fn(LLVMValueRef) -> i32](high) can[Unsafe.PointerCast, Unsafe.PointerArithmetic]) != 0
            return empty if not split_constant(LLVMGetOperand(high, 1), 32)
            if (split_mask(LLVMGetOperand(high, 0), function_size, budget) can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Unsafe.PointerArithmetic]) is high_sum:
                if (split_mask(low_masked, function_size, budget) can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Unsafe.PointerArithmetic]) is low_sum:
                    pair: SplitPair = split_low_sum(low_sum, function_size, budget) can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Unsafe.PointerArithmetic]
                    if pair.valid:
                        if pair.left is left:
                            if pair.right is right:
                                return pair if (split_high_sum(high_sum, left, right, low_sum, function_size, budget) can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Unsafe.PointerArithmetic])
            empty

        def split_match(root: LLVMValueRef, function_size: usize, budget: mutable SplitBudget&) -> SplitPair can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Unsafe.PointerArithmetic]:
            empty: SplitPair = SplitPair{valid: false, left: null, right: null}
            return empty if not (split_opcode(root, 24, budget) can[Unsafe.PointerCast, Unsafe.PointerArithmetic])
            first: SplitPair = split_match_order(root, 0, function_size, budget) can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Unsafe.PointerArithmetic]
            return first if first.valid
            split_match_order(root, 1, function_size, budget) can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Unsafe.PointerArithmetic]

        # Candidate alloca inspection is expensive for unnamed IR values: LLVM may
        # enumerate the whole function to assign slots. Charge the full function
        # size before each print, in addition to a hard print-count budget.
        struct SplitBudget:
            print_work: mutable usize
            print_count: mutable usize
            use_work: mutable usize
            debug_fn: void&
            nuw_fn: void&
            nsw_fn: void&
            exact_fn: void&

        def split_ordinary_alloca(slot: LLVMValueRef, function_size: usize, budget: mutable SplitBudget&) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Unsafe.PointerArithmetic]:
            return false if LLVMIsAInstruction(slot) == null
            return false if LLVMGetInstructionOpcode(slot) != 26
            return false if (budget.debug_fn.call_as[fn(LLVMValueRef) -> void&?](slot) can[Unsafe.PointerCast, Unsafe.PointerArithmetic]) != null
            return false if LLVMHasMetadata(slot) != 0
            return false if LLVMGetTypeKind(LLVMGetAllocatedType(slot)) != 8
            return false if LLVMGetIntTypeWidth(LLVMGetAllocatedType(slot)) != 64
            name_length: mutable usize = 0
            _ = LLVMGetValueName2(slot, &name_length)
            return false if name_length > 128
            return false if function_size == 0 or function_size > 32768
            return false if budget.print_count == 0 or function_size > budget.print_work
            budget.print_count <- budget.print_count - 1
            budget.print_work <- budget.print_work - function_size
            rendered: cstr = LLVMPrintValueToString(slot)
            defer block:
                LLVMDisposeMessage(rendered)
            length: usize = rendered.len
            return false if length > 1024
            # LLVM escapes quoted SSA names. The final separator must introduce
            # the entire exact instruction, with no flags, array count or metadata.
            ending: cstr = " = alloca i64, align 8"
            return false if length < ending.len
            for index in 0..<ending.len |rendered, length, ending|:
                return false if rendered[length - ending.len + index] != ending[index]
            return true

        # Resolve a stack load only if every alloca use is an ordinary same-block
        # load or the one ordinary store, and that store precedes this load.
        def split_resolve(value: LLVMValueRef, depth: usize, function_size: usize, budget: mutable SplitBudget&) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Unsafe.PointerArithmetic]:
            return null if depth > 8
            if LLVMIsAInstruction(value) is instruction:
                return null if (budget.debug_fn.call_as[fn(LLVMValueRef) -> void&?](instruction) can[Unsafe.PointerCast, Unsafe.PointerArithmetic]) != null
            return value if not (split_opcode(value, 27, budget) can[Unsafe.PointerCast, Unsafe.PointerArithmetic])
            return null if LLVMGetVolatile(value) != 0 or LLVMGetOrdering(value) != 0 or LLVMHasMetadata(value) != 0
            return null if LLVMGetAlignment(value) > 8
            slot: LLVMValueRef = LLVMGetOperand(value, 0)
            return null if not (split_ordinary_alloca(slot, function_size, budget) can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Unsafe.PointerArithmetic])
            block: LLVMBasicBlockRef = LLVMGetInstructionParent(value)
            only_store: mutable LLVMValueRef? = null
            use_opt: mutable LLVMUseRef? = LLVMGetFirstUse(slot)
            use_count: mutable usize = 0
            while use_opt is use |use_opt, only_store, use_count, block, slot, budget|:
                return null if use_count == 256 or budget.use_work == 0
                use_count <- use_count + 1
                budget.use_work <- budget.use_work - 1
                user: LLVMValueRef = LLVMGetUser(use)
                return null if LLVMIsAInstruction(user) == null
                return null if (budget.debug_fn.call_as[fn(LLVMValueRef) -> void&?](user) can[Unsafe.PointerCast, Unsafe.PointerArithmetic]) != null
                op: u32 = LLVMGetInstructionOpcode(user)
                return null if op != 27 and op != 28
                return null if LLVMGetInstructionParent(user) != block
                return null if LLVMGetVolatile(user) != 0 or LLVMGetOrdering(user) != 0
                return null if LLVMHasMetadata(user) != 0 or LLVMGetAlignment(user) > 8
                if op == 27:
                    return null if not (split_opcode(user, 27, budget) can[Unsafe.PointerCast, Unsafe.PointerArithmetic]) or LLVMGetOperand(user, 0) != slot
                else:
                    return null if LLVMGetOperand(user, 1) != slot or only_store != null
                    stored: LLVMValueRef = LLVMGetOperand(user, 0)
                    stored_type: LLVMTypeRef = LLVMTypeOf(stored)
                    return null if LLVMGetTypeKind(stored_type) != 8 or LLVMGetIntTypeWidth(stored_type) != 64
                    only_store <- user
                use_opt <- LLVMGetNextUse(use)
            if only_store is stored:
                cursor: mutable LLVMValueRef? = LLVMGetNextInstruction(stored)
                while cursor is instruction |cursor, value, budget|:
                    return (split_resolve(LLVMGetOperand(stored, 0), depth + 1, function_size, budget) can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Unsafe.PointerArithmetic]) if instruction == value
                    return null if budget.use_work == 0
                    budget.use_work <- budget.use_work - 1
                    cursor <- LLVMGetNextInstruction(instruction)
            null

        static if ELISA_TARGET_OS_POSIX:
            def split_same_llvm_image(anchor: void&, target: void&) -> bool:
                a: mutable ArtifactDlInfo = ArtifactDlInfo{image_path: "", image_base: anchor, symbol_name: "", symbol_address: anchor}
                b: mutable ArtifactDlInfo = ArtifactDlInfo{image_path: "", image_base: target, symbol_name: "", symbol_address: target}
                return false if artifact_identity_dladdr(anchor, &a) == 0 or artifact_identity_dladdr(target, &b) == 0
                return a.image_base == b.image_base

            def split_rewrite_module(m: LLVMModuleRef, ctx: LLVMContextRef) -> usize can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Unsafe.PointerArithmetic, Global.Read]:
                direct_anchor: void& = LLVMContextCreate.cast[void&] can Unsafe.PointerCast
                if artifact_identity_dlopen(null, 2) is handle:
                    defer block:
                        _ = artifact_identity_dlclose(handle)
                    if artifact_identity_dlsym(handle, "LLVMContextCreate") is llvm_base_ptr:
                        return 0 if not (split_same_llvm_image(direct_anchor, llvm_base_ptr) can Global.Read)
                        if artifact_identity_dlsym(handle, "LLVMGetVersion") is version_fn:
                            direct_version: void& = LLVMGetVersion.cast[void&] can Unsafe.PointerCast
                            return 0 if not (split_same_llvm_image(llvm_base_ptr, version_fn) can Global.Read)
                            return 0 if not (split_same_llvm_image(llvm_base_ptr, direct_version) can Global.Read)
                            major: mutable u32 = 0
                            minor: mutable u32 = 0
                            patch: mutable u32 = 0
                            LLVMGetVersion(&major, &minor, &patch)
                            return 0 if major != 23
                            if artifact_identity_dlsym(handle, "LLVMGetFirstDbgRecord") is debug_fn:
                                if artifact_identity_dlsym(handle, "LLVMGetNUW") is nuw_fn:
                                    if artifact_identity_dlsym(handle, "LLVMGetNSW") is nsw_fn:
                                        if artifact_identity_dlsym(handle, "LLVMGetExact") is exact_fn:
                                            return 0 if not (split_same_llvm_image(llvm_base_ptr, debug_fn) can Global.Read)
                                            return 0 if not (split_same_llvm_image(llvm_base_ptr, nuw_fn) can Global.Read)
                                            return 0 if not (split_same_llvm_image(llvm_base_ptr, nsw_fn) can Global.Read)
                                            return 0 if not (split_same_llvm_image(llvm_base_ptr, exact_fn) can Global.Read)
                                            return split_rewrite_impl(m, ctx, debug_fn, nuw_fn, nsw_fn, exact_fn) can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Unsafe.PointerArithmetic]
                0
        static else:
            def split_rewrite_module(m: LLVMModuleRef, ctx: LLVMContextRef) -> usize:
                0

        def split_rewrite_impl(m: LLVMModuleRef, ctx: LLVMContextRef, debug_fn: void&, nuw_fn: void&, nsw_fn: void&, exact_fn: void&) -> usize can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Unsafe.PointerArithmetic]:
            builder: LLVMBuilderRef = LLVMCreateBuilderInContext(ctx)
            defer block:
                LLVMDisposeBuilder(builder)
            budget: mutable SplitBudget = SplitBudget{print_work: 100000, print_count: 32, use_work: 16384, debug_fn: debug_fn, nuw_fn: nuw_fn, nsw_fn: nsw_fn, exact_fn: exact_fn}
            remaining: mutable usize = 262144
            changed: mutable usize = 0
            fn_opt: mutable LLVMValueRef? = LLVMGetFirstFunction(m)
            while fn_opt is fn |fn_opt, budget, remaining, changed, builder|:
                return changed if remaining == 0
                size: mutable usize = 0
                bb_opt: mutable LLVMBasicBlockRef? = LLVMGetFirstBasicBlock(fn)
                while bb_opt is bb |bb_opt, remaining, size|:
                    inst_opt: mutable LLVMValueRef? = LLVMGetFirstInstruction(bb)
                    while inst_opt is inst |inst_opt, remaining, size|:
                        return changed if remaining == 0
                        remaining <- remaining - 1
                        size <- size + 1
                        inst_opt <- LLVMGetNextInstruction(inst)
                    bb_opt <- LLVMGetNextBasicBlock(bb)
                if size <= 32768:
                    bb_opt <- LLVMGetFirstBasicBlock(fn)
                    while bb_opt is bb |bb_opt, remaining, size, budget, changed, builder|:
                        inst_opt: mutable LLVMValueRef? = LLVMGetFirstInstruction(bb)
                        while inst_opt is inst |inst_opt, remaining, size, budget, changed, builder|:
                            return changed if remaining == 0
                            remaining <- remaining - 1
                            next: LLVMValueRef? = LLVMGetNextInstruction(inst)
                            if (split_opcode(inst, 24, budget) can[Unsafe.PointerCast, Unsafe.PointerArithmetic]) and LLVMHasMetadata(inst) == 0 and (budget.debug_fn.call_as[fn(LLVMValueRef) -> void&?](inst) can[Unsafe.PointerCast, Unsafe.PointerArithmetic]) == null:
                                pair: SplitPair = split_match(inst, size, &budget) can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Unsafe.PointerArithmetic]
                                if pair.valid:
                                    if pair.left is left:
                                        if pair.right is right:
                                            LLVMPositionBuilderBefore(builder, inst)
                                            sum: LLVMValueRef = LLVMBuildAdd(builder, left, right, "split.native")
                                            LLVMReplaceAllUsesWith(inst, sum)
                                            LLVMInstructionEraseFromParent(inst)
                                            changed <- changed + 1
                            inst_opt <- next
                        bb_opt <- LLVMGetNextBasicBlock(bb)
                fn_opt <- LLVMGetNextFunction(fn)
            changed
