            while block_opt is block |block_opt, names, constants, attrs, types, edges|:
                return false if not tu_name_budget(LLVMBasicBlockAsValue(block), names)
                inst_opt: mutable LLVMValueRef? = LLVMGetFirstInstruction(block)
                while inst_opt is inst |inst_opt, names, constants, attrs, types, edges|:
                    return false if not tu_name_budget(inst, names)
                    ctx: LLVMContextRef = LLVMGetModuleContext(LLVMGetGlobalParent(function))
                    return false if not (tu_instruction_metadata_budget(inst, ctx, debug_fn, constants, names) can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Unsafe.PointerArithmetic])
                    opcode: u32 = LLVMGetInstructionOpcode(inst)
                    can Global.Read:
                        return false if not (tu_type_budget(LLVMTypeOf(inst), 0, types, names) can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Global.Read])
                    if opcode == 26:
                        can Global.Read:
                            return false if not (tu_type_budget(LLVMGetAllocatedType(inst), 0, types, names) can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Global.Read])
                    elif opcode == 29:
                        can Global.Read:
                            return false if not (tu_type_budget(LLVMGetGEPSourceElementType(inst), 0, types, names) can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Global.Read])
                    elif opcode == 52:
                        # ShuffleVectorInst stores its mask outside the ordinary
                        # operand list. Charge each lane before any module clone.
                        mask_elements: usize = LLVMGetNumMaskElements(inst).usize()
                        return false if mask_elements > constants
                        constants <- constants - mask_elements
                    if opcode == 5 or opcode == 45 or opcode == 67:
                        # LLVM's callsite C accessors cover CallInst and InvokeInst,
                        # but not CallBrInst. Leave those modules untouched.
                        return false if opcode == 67
                        # Operand-bundle tags are copied too and have no bounded
                        # C API accessor, so leave those calls untouched.
                        return false if LLVMGetNumOperandBundles(inst) != 0
                        can Global.Read:
                            return false if not (tu_type_budget(LLVMGetCalledFunctionType(inst), 0, types, names) can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Global.Read])
                        can Global.Read:
                            return false if not (tu_callsite_budget(inst, attrs) can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Global.Read])
