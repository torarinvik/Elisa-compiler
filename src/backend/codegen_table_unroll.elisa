                    return false if operand_count > 256 or operand_count > edges
                    # Local-value operands are clone-owned references too. Bound
                    # their aggregate independently of the constant graph budget.
                    edges <- edges - operand_count
                    for operand_index in 0..<operand_count |inst, constants, types, names|:
                        operand: LLVMValueRef = LLVMGetOperand(inst, operand_index.u32())
                        return false if LLVMGetValueKind(operand) == metadata_value_kind
                        return false if LLVMGetValueKind(operand) == inline_asm_kind
                        if LLVMIsAConstant(operand) != null:
