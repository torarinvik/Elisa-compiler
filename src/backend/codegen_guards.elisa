# Stage1 backend — the RUNTIME GUARDS: the trap intrinsic and its unreachable tail, the opt-in
# null-deref and index-bounds checks, contract guards, and the `ensure` postconditions checked
# against a value on its way out. Part of `module Backend` (see codegen.elisa).

extend Backend:
    private:


            # Emit the LLVM trap intrinsic and terminate the failure block. This is shared by
            # forced dereference guards and the dynamic index watchdog; unlike libc abort it
            # remains a recognizable `llvm.trap` for both LLVM and stage0 parity checks.
        def emit_trap_unreachable(m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> void can[Abort.Panic, Unsafe.PointerCast]:
            trap_name: cstr = "llvm.trap"
            trap_type: LLVMTypeRef = LLVMFunctionType(LLVMVoidTypeInContext(ctx), null, 0, 0)
            # `LLVMAddFunction` does NOT deduplicate by name — a second call with the same
            # name gets a MANGLED symbol (`llvm.trap.1`, `llvm.trap.2`, …), which is no
            # longer the real `llvm.trap` INTRINSIC LLVM recognizes at codegen time; it
            # becomes an ordinary external declaration with no definition anywhere, and the
            # link fails with "undefined symbol _llvm.trap.N". Harmless for callers that
            # trap at most once per function, which is why this went unnoticed — checked
            # arithmetic overflow can trap from many call sites in the SAME function.
            trap_fn: mutable LLVMValueRef = zeroed
            if LLVMGetNamedFunction(m, trap_name) is existing_trap:
                trap_fn <- existing_trap
            else:
                trap_fn <- LLVMAddFunction(m, trap_name, trap_type)
            _ = LLVMBuildCall2(builder, trap_type, trap_fn, null, 0, "")
            _ = LLVMBuildUnreachable(builder)




        # In forced bounds mode, reject null and near-null addresses before they are
        # dereferenced. Runtime-derived pointers are compared directly; this deliberately
        # stays conservative for stack/global addresses, which is safe and keeps the
        # guard independent of LLVM's value-kind introspection API.
        def emit_pointer_deref_guard(pointer: LLVMValueRef, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> void can[Abort.Panic, Unsafe.PointerCast]:
            return if not runtime.force_bounds_check
            return if pointer == zeroed
            int_pointer: LLVMValueRef = LLVMBuildPtrToInt(builder, pointer, LLVMInt64TypeInContext(ctx), "pg.addr")
            limit: LLVMValueRef = LLVMConstInt(LLVMInt64TypeInContext(ctx), 65536, 0)
            valid: LLVMValueRef = LLVMBuildICmp(builder, 35, int_pointer, limit, "pg.valid")
            ok_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder)), "pg.ok")
            fail_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder)), "pg.fail")
            _ = LLVMBuildCondBr(builder, valid, ok_block, fail_block)
            LLVMPositionBuilderAtEnd(builder, fail_block)
            emit_trap_unreachable(m, ctx, builder)
            LLVMPositionBuilderAtEnd(builder, ok_block)




        # Every dynamic container index is checked before its GEP is used, at EVERY
        # optimization level and with or without -fbounds-check: an index past the end
        # traps instead of reading or writing a neighbouring object.
        #
        # This used to be gated on the opt-in flag, mirroring what stage0's watchdog
        # did outside -O0 -- and that gate is how a text copy for widget 64 landed on
        # UiFlat.widget_count (2026-09-09): a wrongly folded array extent (see
        # fold_consts) turned an ordinary store into silent corruption two globals
        # away. A memory-safe language has no build in which that store goes through.
        # The only elision is the sound one: a CONSTANT index inside a fixed extent
        # cannot vary at runtime, so its guard would be `br i1 true` with a dead trap
        # arm. The near-null dereference guard remains -fbounds-check only, as in stage0.
        def emit_index_bounds_guard(array_slot: LLVMValueRef, array_type: ValueType, index: LLVMValueRef, runtime: Runtime&, structs: mutable StructTable&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            emit_pointer_deref_guard(array_slot, runtime, m, ctx, builder)
            count_pointer: mutable LLVMValueRef = zeroed
            count_value: mutable LLVMValueRef = zeroed
            if array_type.kind == TypeKind.DArray:
                count_pointer <- LLVMBuildStructGEP2(builder, darray_llvm_type(structs, ctx), array_slot, 1, "bounds.count.ptr")
                count_value <- LLVMBuildLoad2(builder, darray_size_type(ctx), count_pointer, "bounds.count")
            elif array_type.kind == TypeKind.Array:
                extent: u64 = structs.array_extents[array_type.bits.usize()].u64()
                if LLVMIsAConstantInt(index) is constant_index:
                    return if LLVMConstIntGetZExtValue(constant_index) < extent
                # AT THE INDEX'S OWN WIDTH, not i64. `usize` is 64-bit natively and
                # 32-bit on wasm32, so a hardcoded i64 extent under an i32 index
                # emitted `icmp ult i32, i64` -- invalid wasm the component
                # validator rejects ("expected i32, found i64"), and invisible on
                # a native build where both operands are already 64-bit. Same
                # class as test/fixtures/wasm/component_const_width.elisa, which
                # caught the other direction.
                count_value <- LLVMConstInt(LLVMTypeOf(index), extent, 0)
            else:
                return
            # BOTH OPERANDS AT ONE WIDTH. Darray counts use target-sized usize storage.
            # Widen the narrower unsigned operand so unusually wide source indices remain
            # checked without truncating either the index or the stored count.
            compare_index: mutable LLVMValueRef = index
            compare_count: mutable LLVMValueRef = count_value
            index_type: LLVMTypeRef = LLVMTypeOf(index)
            count_type: LLVMTypeRef = LLVMTypeOf(count_value)
            if index_type != count_type and LLVMGetIntTypeWidth(index_type) < LLVMGetIntTypeWidth(count_type):
                compare_index <- LLVMBuildZExt(builder, index, count_type, "wd.index.wide")
            elif index_type != count_type:
                compare_count <- LLVMBuildZExt(builder, count_value, index_type, "wd.count.wide")
            valid: LLVMValueRef = LLVMBuildICmp(builder, 36, compare_index, compare_count, "wd.in_bounds")
            parent: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
            ok_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, parent, "wd.ok")
            fail_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, parent, "wd.fail")
            _ = LLVMBuildCondBr(builder, valid, ok_block, fail_block)
            LLVMPositionBuilderAtEnd(builder, fail_block)
            emit_trap_unreachable(m, ctx, builder)
            LLVMPositionBuilderAtEnd(builder, ok_block)




        # Emit a runtime contract guard: branch on `condition`, PANIC on false, and leave the
        # builder positioned on the success path. Shared by `requires`/`assert` (checked where
        # they are written), `ensure` (checked at every return) and an extern's `ensure`
        # (checked at every call site — docs/127 D8).
        #
        # The failure path is a full panic report, not a bare `abort()`: stage0 routes every
        # one of these through emitPanicWithBacktrace(cond.Pos(), label), so a violated
        # contract names its file, its line, the PREDICATE'S OWN COLUMN (for `a <= b` that is
        # the operator) and which contract family failed. stage1 used to abort silently, which
        # told the user nothing about which contract had been broken or where.
        def emit_contract_guard(condition: LLVMValueRef, label: cstr, predicate_line: u32, predicate_column: u32, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            guard_fn: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
            guard_ok: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, guard_fn, "contract.ok")
            guard_fail: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, guard_fn, "contract.fail")
            _ = LLVMBuildCondBr(builder, condition, guard_ok, guard_fail)
            LLVMPositionBuilderAtEnd(builder, guard_fail)
            # "str" is the global name stage0 gives the label, which is an ordinary string
            # literal on its side.
            emit_panic_report_text(label, "str", Lexer::source_original_line(predicate_line).u64(), predicate_column.u64(), m, ctx, builder)
            guard_abort_type: LLVMTypeRef = LLVMFunctionType(LLVMVoidTypeInContext(ctx), null, 0, 0)
            guard_abort_fn: LLVMValueRef = declare_or_get_abort(m, guard_abort_type)
            _ = LLVMBuildCall2(builder, guard_abort_type, guard_abort_fn, null, 0, "")
            _ = LLVMBuildUnreachable(builder)
            LLVMPositionBuilderAtEnd(builder, guard_ok)




        # Check the current function's `ensure` postconditions against the value it is about
        # to return. Mirrors stage0's shape: bind the returned value as `result` (stage0
        # allocates a `%result` slot and stores into it), then guard on each predicate.
        # Called on the return path, BEFORE the regions are unwound -- a predicate may read a
        # container the auto region still backs.
        #
        # False = DECLINE (a predicate the expression emitter cannot model). Never silently
        # skips a check: a contract that is not emitted is a contract that is not enforced.
        def emit_ensure_checks(return_value: LLVMValueRef, return_type: ValueType, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            ensure_count: usize = structs.pending_ensures.count
            true return if ensure_count == 0
            false return if return_type.kind == TypeKind.Void
            result_slot: LLVMValueRef = build_entry_alloca(builder, llvm_type_of(return_type, structs, ctx), "result")
            _ = LLVMBuildStore(builder, return_value, result_slot)
            # `result` is an ordinary local from here, so the predicate's `result >= a` needs
            # no special case in the expression emitter.
            declare_local(local_scope, "result", result_slot, return_type)
            ensure_bool: ValueType = ValueType{kind: TypeKind.Bool, bits: 1}
            ensure_index: mutable usize = 0
            while ensure_index < ensure_count |ensure_index, ensure_count, ensure_bool, local_scope, fns, structs, generics, runtime, m, ctx, builder|:
                # Copied OUT of the table: emit_expression takes `structs` mutably, so a
                # borrow held across the call would conflict.
                ensure_pred: Expr = structs.pending_ensures[ensure_index]
                ensure_pos: Ast::Pos = Ast::expr_pos(ensure_pred)
                if emit_expression(ensure_pred, ensure_bool, local_scope, fns, structs, generics, runtime, m, ctx, builder) is ensure_value:
                    emit_contract_guard(ensure_value, "postcondition failed", ensure_pos.line, ensure_pos.column, m, ctx, builder)
                else:
                    return false
                ensure_index <- ensure_index + 1
            return true


include "./codegen_extern_ensure.elisa"
