# Stage1 backend — the RUNTIME GUARDS: the trap intrinsic and its unreachable tail, the opt-in
# null-deref and index-bounds checks, contract guards, and the `ensure` postconditions checked
# against a value on its way out. Part of `module Backend` (see codegen.elisa).

extend Backend:
    private:


            # Emit the LLVM trap intrinsic and terminate the failure block. This is shared by
            # forced dereference guards and the dynamic index watchdog; unlike libc abort it
            # remains a recognizable `llvm.trap` for both LLVM and stage0 parity checks.
        def emit_trap_unreachable(m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> void can[Abort.Panic, Unsafe.PointerCast]:
            trap_name: cstr = "llvm.trap"
            trap_type: LLVMTypeRef = LLVMFunctionType(LLVMVoidTypeInContext(ctx), null, 0, 0)
            # `LLVMAddFunction` does NOT deduplicate by name — a second call with the same
            # name gets a MANGLED symbol (`llvm.trap.1`, `llvm.trap.2`, …), which is no
            # longer the real `llvm.trap` INTRINSIC LLVM recognizes at codegen time; it
            # becomes an ordinary external declaration with no definition anywhere, and the
            # link fails with "undefined symbol _llvm.trap.N". Harmless for callers that
            # trap at most once per function, which is why this went unnoticed — checked
            # arithmetic overflow can trap from many call sites in the SAME function.
            trap_fn: mutable LLVMValueRef = LLVMConstNull(LLVMPointerTypeInContext(ctx, 0))
            if LLVMGetNamedFunction(m, trap_name) is existing_trap:
                trap_fn <- existing_trap
            else:
                trap_fn <- LLVMAddFunction(m, trap_name, trap_type)
            _ = LLVMBuildCall2(builder, trap_type, trap_fn, null, 0, "")
            _ = LLVMBuildUnreachable(builder)




        # `chunks_exact(view, n)` divides the unsigned view length by `n`. Check the
        # divisor before constructing URem so zero never reaches an undefined LLVM
        # remainder, and require signed sizes to be positive (negative sizes must not
        # become enormous unsigned chunks through a signed/unsigned reinterpretation).
        # The exactness branch dominates the later UDiv in the constructor.
        def emit_chunks_exact_validation(chunk_size_source: LLVMValueRef, chunk_size: LLVMValueRef, total: LLVMValueRef, chunk_size_is_signed: bool, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> void can[Abort.Panic, Unsafe.PointerCast]:
            chunk_type: LLVMTypeRef = LLVMTypeOf(chunk_size)
            chunk_source_type: LLVMTypeRef = LLVMTypeOf(chunk_size_source)
            zero: LLVMValueRef = LLVMConstInt(chunk_type, 0, 0)
            source_zero: LLVMValueRef = LLVMConstInt(chunk_source_type, 0, 0)
            source_positive: LLVMValueRef = LLVMBuildICmp(builder, LLVMIntPredicate::SGT, chunk_size_source, source_zero, "chunks.size.positive") if chunk_size_is_signed else LLVMConstInt(LLVMInt1TypeInContext(ctx), 1, 0)
            target_nonzero: LLVMValueRef = LLVMBuildICmp(builder, LLVMIntPredicate::NE, chunk_size, zero, "chunks.size.nonzero")
            fits_target: mutable LLVMValueRef = LLVMConstInt(LLVMInt1TypeInContext(ctx), 1, 0)
            if LLVMGetIntTypeWidth(chunk_source_type) > LLVMGetIntTypeWidth(chunk_type):
                roundtrip: LLVMValueRef = LLVMBuildZExt(builder, chunk_size, chunk_source_type, "chunks.size.roundtrip")
                fits_target <- LLVMBuildICmp(builder, LLVMIntPredicate::EQ, roundtrip, chunk_size_source, "chunks.size.fits")
            size_valid: LLVMValueRef = LLVMBuildAnd(builder, source_positive, LLVMBuildAnd(builder, target_nonzero, fits_target, "chunks.size.target.valid"), "chunks.size.valid")
            parent: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
            nonzero_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, parent, "chunks.size.ok")
            exact_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, parent, "chunks.exact.ok")
            fail_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, parent, "chunks.invalid")
            _ = LLVMBuildCondBr(builder, size_valid, nonzero_block, fail_block)
            LLVMPositionBuilderAtEnd(builder, fail_block)
            emit_trap_unreachable(m, ctx, builder)
            LLVMPositionBuilderAtEnd(builder, nonzero_block)
            remainder: LLVMValueRef = LLVMBuildURem(builder, total, chunk_size, "chunks.remainder")
            exact: LLVMValueRef = LLVMBuildICmp(builder, LLVMIntPredicate::EQ, remainder, zero, "chunks.divisible")
            _ = LLVMBuildCondBr(builder, exact, exact_block, fail_block)
            LLVMPositionBuilderAtEnd(builder, exact_block)




        # Before a loop indexes a source view using another view's count, require that
        # the source has at least that many elements. Callers normalize both usize counts
        # to i64 first, so this comparison is unsigned and has identical operand widths on
        # 32-bit and 64-bit targets.
        def emit_required_count_available_guard(required_count: LLVMValueRef, available_count: LLVMValueRef, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> void can[Abort.Panic, Unsafe.PointerCast]:
            enough: LLVMValueRef = LLVMBuildICmp(builder, LLVMIntPredicate::UGE, available_count, required_count, "view.count.available")
            parent: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
            ok_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, parent, "view.count.ok")
            fail_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, parent, "view.count.short")
            _ = LLVMBuildCondBr(builder, enough, ok_block, fail_block)
            LLVMPositionBuilderAtEnd(builder, fail_block)
            emit_trap_unreachable(m, ctx, builder)
            LLVMPositionBuilderAtEnd(builder, ok_block)




        # In forced bounds mode, reject null and near-null addresses before they are
        # dereferenced. Runtime-derived pointers are compared directly; this deliberately
        # stays conservative for stack/global addresses, which is safe and keeps the
        # guard independent of LLVM's value-kind introspection API.
        def emit_pointer_deref_guard(pointer: LLVMValueRef, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> void can[Abort.Panic, Unsafe.PointerCast]:
            return if not runtime.force_bounds_check
            return if pointer == LLVMConstNull(LLVMPointerTypeInContext(ctx, 0))
            int_pointer: LLVMValueRef = LLVMBuildPtrToInt(builder, pointer, LLVMInt64TypeInContext(ctx), "pg.addr")
            limit: LLVMValueRef = LLVMConstInt(LLVMInt64TypeInContext(ctx), 65536, 0)
            valid: LLVMValueRef = LLVMBuildICmp(builder, 35, int_pointer, limit, "pg.valid")
            ok_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder)), "pg.ok")
            fail_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder)), "pg.fail")
            _ = LLVMBuildCondBr(builder, valid, ok_block, fail_block)
            LLVMPositionBuilderAtEnd(builder, fail_block)
            emit_trap_unreachable(m, ctx, builder)
            LLVMPositionBuilderAtEnd(builder, ok_block)




        # Every dynamic container index is checked before its GEP is used, at EVERY
        # optimization level and with or without -fbounds-check: an index past the end
        # traps instead of reading or writing a neighbouring object.
        #
        # This used to be gated on the opt-in flag, mirroring what stage0's watchdog
        # did outside -O0 -- and that gate is how a text copy for widget 64 landed on
        # UiFlat.widget_count (2026-09-09): a wrongly folded array extent (see
        # fold_consts) turned an ordinary store into silent corruption two globals
        # away. A memory-safe language has no build in which that store goes through.
        # The only elision is the sound one: a CONSTANT index inside a fixed extent
        # cannot vary at runtime, so its guard would be `br i1 true` with a dead trap
        # arm. The near-null dereference guard remains -fbounds-check only, as in stage0.
        def emit_index_bounds_guard(array_slot: LLVMValueRef, array_type: ValueType, index: LLVMValueRef, index_is_signed: bool, runtime: Runtime&, structs: mutable StructTable&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            emit_pointer_deref_guard(array_slot, runtime, m, ctx, builder)
            count_pointer: mutable LLVMValueRef = LLVMConstNull(LLVMPointerTypeInContext(ctx, 0))
            index_width: u32 = LLVMGetIntTypeWidth(LLVMTypeOf(index))
            comparison_type: LLVMTypeRef = LLVMInt64TypeInContext(ctx) if index_width < 64 else LLVMTypeOf(index)
            count_value: mutable LLVMValueRef = LLVMConstInt(comparison_type, 0, 0)
            if array_type.kind == TypeKind.DArray:
                count_pointer <- LLVMBuildStructGEP2(builder, darray_llvm_type(structs, ctx), array_slot, 1, "bounds.count.ptr")
                count_value <- LLVMBuildLoad2(builder, darray_size_type(ctx, structs.target.target_pointer_bits), count_pointer, "bounds.count")
            elif array_type.kind == TypeKind.Array:
                extent: u64 = structs.interned_types.array_extents[array_type.bits.usize()].u64()
                if index_width <= 64 and LLVMIsAConstantInt(index) is constant_index:
                    constant_index_bits: u64 = LLVMConstIntGetZExtValue(constant_index)
                    signed_index_limit: u64 = 9223372036854775808.u64() if index_width == 64 else (1.u64() << (index_width - 1).u64())
                    constant_nonnegative: bool = not index_is_signed or constant_index_bits < signed_index_limit
                    return if constant_nonnegative and constant_index_bits < extent
                # Keep the complete u64 extent; emit_count_bounds_guard widens the
                # narrower source index before comparing, so wasm32 cannot truncate
                # a large fixed-array extent to i32.
                count_value <- LLVMConstInt(comparison_type, extent, 0)
            else:
                return
            emit_count_bounds_guard(index, count_value, index_is_signed, runtime, m, ctx, builder)




        # The compare-and-trap half of the index watchdog, for a count already in hand. A
        # `view[T]` carries its count as field 1 of its `{data, len}` value, so its three index
        # sites (local read, field/returned read, store) pass that here. They had NO guard at
        # all: stage0 guards DArray and View alike (emitDebugIndexBoundsGuard), while stage1
        # read and wrote `v[i]` for any `i` -- an out-of-bounds read or store with no trap.
        # Keep the unsigned count comparison, and add a signed nonnegative check
        # before it whenever the source index was signed. The guard receives the
        # original-width value so narrowing for usize/GEP cannot erase sign or range.
        def emit_count_bounds_guard(index: LLVMValueRef, count_value: LLVMValueRef, index_is_signed: bool, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            # BOTH OPERANDS AT ONE WIDTH. Darray counts use target-sized usize storage.
            # Widen the narrower operand only for the unsigned comparison; the separate
            # signed check below rejects negative values before they can pass that compare.
            compare_index: mutable LLVMValueRef = index
            compare_count: mutable LLVMValueRef = count_value
            index_type: LLVMTypeRef = LLVMTypeOf(index)
            count_type: LLVMTypeRef = LLVMTypeOf(count_value)
            if index_type != count_type and LLVMGetIntTypeWidth(index_type) < LLVMGetIntTypeWidth(count_type):
                compare_index <- LLVMBuildZExt(builder, index, count_type, "wd.index.wide")
            elif index_type != count_type:
                compare_count <- LLVMBuildZExt(builder, count_value, index_type, "wd.count.wide")
            unsigned_valid: LLVMValueRef = LLVMBuildICmp(builder, 36, compare_index, compare_count, "wd.in_bounds.unsigned")
            valid: LLVMValueRef = unsigned_valid
            if index_is_signed:
                index_nonnegative: LLVMValueRef = LLVMBuildICmp(builder, 39, index, LLVMConstInt(index_type, 0, 0), "wd.index.nonnegative")
                valid <- LLVMBuildAnd(builder, index_nonnegative, unsigned_valid, "wd.in_bounds.signed")
            parent: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
            ok_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, parent, "wd.ok")
            # Inside a `get xs[i] else <recovery>` the failure edge is the RECOVERY, not a
            # trap: the access is checked precisely so the out-of-range case has somewhere
            # defined to go. No `wd.fail` block is created then -- the recovery block already
            # exists and the caller terminates it.
            if runtime.index_recovery_active:
                if runtime.index_recovery_block is recovery_block:
                    _ = LLVMBuildCondBr(builder, valid, ok_block, recovery_block)
                    LLVMPositionBuilderAtEnd(builder, ok_block)
                    return
                # A recovery mode without its block is an internal lowering invariant failure.
                # Fail closed on an out-of-range index rather than passing an absent handle to
                # LLVM or accidentally reading the element.
            fail_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, parent, "wd.fail")
            _ = LLVMBuildCondBr(builder, valid, ok_block, fail_block)
            LLVMPositionBuilderAtEnd(builder, fail_block)
            emit_trap_unreachable(m, ctx, builder)
            LLVMPositionBuilderAtEnd(builder, ok_block)

        # S1b: a slice `base[lo:hi]` over storage of known length CLAMPS rather than traps,
        # exactly as stage0 does (emitDenseViewSliceValue / emitFixedArraySliceExpr):
        #   start' = umin(start, len);  end' = umin(end, len);  count = end' >= start' ? end' - start' : 0
        # An unclamped `hi - lo` with lo > hi wrapped the count to 2^64 - k, so the next index
        # read walked off the allocation (a segfault, or silently wrong bytes). The comparison is
        # UNSIGNED: a negative i64 bound is a huge usize and clamps to `len`, as in stage0.
        def emit_slice_clamp_start(start: LLVMValueRef, length: LLVMValueRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef can[Abort.Panic, Memory.Allocate]:
            wide_length: LLVMValueRef = slice_bound_width(length, start, builder)
            start_over: LLVMValueRef = LLVMBuildICmp(builder, 34, start, wide_length, "slice.start.over")
            return LLVMBuildSelect(builder, start_over, wide_length, start, "slice.start.clamped")

        def emit_slice_clamp_count(clamped_start: LLVMValueRef, end: LLVMValueRef, length: LLVMValueRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef can[Abort.Panic, Memory.Allocate]:
            wide_length: LLVMValueRef = slice_bound_width(length, end, builder)
            end_over: LLVMValueRef = LLVMBuildICmp(builder, 34, end, wide_length, "slice.end.over")
            clamped_end: LLVMValueRef = LLVMBuildSelect(builder, end_over, wide_length, end, "slice.end.clamped")
            end_after_start: LLVMValueRef = LLVMBuildICmp(builder, 35, clamped_end, clamped_start, "slice.end.after.start")
            high: LLVMValueRef = LLVMBuildSelect(builder, end_after_start, clamped_end, clamped_start, "slice.hi")
            return LLVMBuildSub(builder, high, clamped_start, "slice.count")

        # The byte-string form (an `sview` receiver) follows stage0's runtime `string_view_slice`
        # instead, which is SIGNED: a negative start is 0 and a negative end means "to the end".
        # Normalising those two cases first leaves bounds the unsigned clamp above handles.
        def emit_string_slice_normalise_start(start: LLVMValueRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef can[Abort.Panic, Memory.Allocate]:
            zero: LLVMValueRef = LLVMConstInt(LLVMTypeOf(start), 0, 0)
            start_positive: LLVMValueRef = LLVMBuildICmp(builder, 38, start, zero, "strslice.start.positive")
            return LLVMBuildSelect(builder, start_positive, start, zero, "strslice.start")

        def emit_string_slice_normalise_end(end: LLVMValueRef, length: LLVMValueRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef can[Abort.Panic, Memory.Allocate]:
            wide_length: LLVMValueRef = slice_bound_width(length, end, builder)
            zero: LLVMValueRef = LLVMConstInt(LLVMTypeOf(end), 0, 0)
            end_given: LLVMValueRef = LLVMBuildICmp(builder, 39, end, zero, "strslice.end.given")
            return LLVMBuildSelect(builder, end_given, end, wide_length, "strslice.end")

        # A length at the bound's integer width (bounds are i64; a count may be narrower).
        def slice_bound_width(length: LLVMValueRef, bound: LLVMValueRef, builder: LLVMBuilderRef) -> LLVMValueRef can[Abort.Panic, Memory.Allocate]:
            length_type: LLVMTypeRef = LLVMTypeOf(length)
            bound_type: LLVMTypeRef = LLVMTypeOf(bound)
            length return if length_type == bound_type
            return LLVMBuildZExt(builder, length, bound_type, "slice.len.wide") if LLVMGetIntTypeWidth(length_type) < LLVMGetIntTypeWidth(bound_type) else LLVMBuildTrunc(builder, length, bound_type, "slice.len.narrow")




        # Emit a runtime contract guard: branch on `condition`, PANIC on false, and leave the
        # builder positioned on the success path. Shared by `requires`/`assert` (checked where
        # they are written), `ensure` (checked at every return) and an extern's `ensure`
        # (checked at every call site — docs/127 D8).
        #
        # The failure path is a full panic report, not a bare `abort()`: stage0 routes every
        # one of these through emitPanicWithBacktrace(cond.Pos(), label), so a violated
        # contract names its file, its line, the PREDICATE'S OWN COLUMN (for `a <= b` that is
        # the operator) and which contract family failed. stage1 used to abort silently, which
        # told the user nothing about which contract had been broken or where.
        def emit_contract_guard(condition: LLVMValueRef, label: cstr, predicate_line: u32, predicate_column: u32, wasm_component: bool, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            guard_fn: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
            guard_ok: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, guard_fn, "contract.ok")
            guard_fail: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, guard_fn, "contract.fail")
            _ = LLVMBuildCondBr(builder, condition, guard_ok, guard_fail)
            LLVMPositionBuilderAtEnd(builder, guard_fail)
            # "str" is the global name stage0 gives the label, which is an ordinary string
            # literal on its side.
            emit_panic_report_text(label, "str", (Lexer::source_original_line(predicate_line) can Global{Read,Write}).u64(), predicate_column.u64(), wasm_component, m, ctx, builder)
            guard_abort_type: LLVMTypeRef = LLVMFunctionType(LLVMVoidTypeInContext(ctx), null, 0, 0)
            guard_abort_fn: LLVMValueRef = declare_or_get_abort(m, guard_abort_type, wasm_component)
            _ = LLVMBuildCall2(builder, guard_abort_type, guard_abort_fn, null, 0, "")
            _ = LLVMBuildUnreachable(builder)
            LLVMPositionBuilderAtEnd(builder, guard_ok)




        # Check the current function's `ensure` postconditions against the value it is about
        # to return. Mirrors stage0's shape: bind the returned value as `result` (stage0
        # allocates a `%result` slot and stores into it), then guard on each predicate.
        # Called on the return path, BEFORE the regions are unwound -- a predicate may read a
        # container the auto region still backs.
        #
        # False = DECLINE (a predicate the expression emitter cannot model). Never silently
        # skips a check: a contract that is not emitted is a contract that is not enforced.
        def emit_ensure_checks(return_value: LLVMValueRef, return_type: ValueType, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            ensure_count: usize = structs.contracts.pending_ensures.count
            true return if ensure_count == 0
            false return if return_type.kind == TypeKind.Void
            result_slot: LLVMValueRef = build_entry_alloca(builder, llvm_type_of(return_type, structs, ctx), "result")
            _ = LLVMBuildStore(builder, return_value, result_slot)
            # `result` is an ordinary local from here, so the predicate's `result >= a` needs
            # no special case in the expression emitter.
            declare_local(local_scope, "result", result_slot, return_type)
            ensure_bool: ValueType = ValueType{kind: TypeKind.Bool, bits: 1}
            ensure_index: mutable usize = 0
            while ensure_index < ensure_count |ensure_index, ensure_count, ensure_bool, local_scope, fns, structs, generics, runtime, m, ctx, builder|:
                # Copied OUT of the table: emit_expression takes `structs` mutably, so a
                # borrow held across the call would conflict.
                ensure_pred: Expr = structs.contracts.pending_ensures[ensure_index]
                ensure_pos: Ast::Pos = Ast::expr_pos(ensure_pred)
                if (emit_expression(ensure_pred, ensure_bool, local_scope, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}) is ensure_value:
                    emit_contract_guard(ensure_value, "postcondition failed", ensure_pos.line, ensure_pos.column, structs.target.wasm_component_types_enabled, m, ctx, builder) can Global{Read,Write}
                else:
                    return false
                ensure_index <- ensure_index + 1
            return true


        # A void function has no `result` value to bind, but its postconditions can still
        # describe arguments and mutable state. Evaluate those predicates at every exit just
        # like non-void ensures, before defers and region cleanup can change or release them.
        # A predicate that needs an unavailable value (such as `result`) still declines.
        def emit_void_ensure_checks(local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            ensure_count: usize = structs.contracts.pending_ensures.count
            true return if ensure_count == 0
            ensure_bool: ValueType = ValueType{kind: TypeKind.Bool, bits: 1}
            ensure_index: mutable usize = 0
            while ensure_index < ensure_count |ensure_index, ensure_count, ensure_bool, local_scope, fns, structs, generics, runtime, m, ctx, builder|:
                ensure_pred: Expr = structs.contracts.pending_ensures[ensure_index]
                ensure_pos: Ast::Pos = Ast::expr_pos(ensure_pred)
                if (emit_expression(ensure_pred, ensure_bool, local_scope, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}) is ensure_value:
                    emit_contract_guard(ensure_value, "postcondition failed", ensure_pos.line, ensure_pos.column, structs.target.wasm_component_types_enabled, m, ctx, builder) can Global{Read,Write}
                else:
                    return false
                ensure_index <- ensure_index + 1
            return true


include "./codegen_extern_ensure.elisa"
