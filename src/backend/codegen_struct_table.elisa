# Stage1 backend — `StructTable`: the one record every emitter threads, holding the module's
# struct types, its enums and packed stores, its consts and globals, and the side tables the
# registration passes fill in. One declaration, so it gets its own file.
# Part of `module Backend` (see codegen.elisa).

extend Backend:
    private:
        # The module's struct types.
        #
        # Field names/types live in FLAT pools with a per-struct span, the same shape as
        # FnTable's parameters — a nested `darray[darray[…]]` would make this
        # region-polymorphic for no benefit.
        struct StructTable:
            # First source construct that made the current function decline.
            # These are reset for each body and survive the normal `Declined`
            # propagation so the module report can identify the leaf failure.
            decline_line: mutable u32 = 0
            decline_kind: mutable sview = ""
            names: mutable darray[sview]
            # The module a struct was declared in, "" for a top-level one. Names used to be
            # keyed by BARE NAME alone, so two modules each declaring `Work` collapsed onto
            # one row and the second overwrote the first -- `struct literal "Work" is
            # missing field "tally"`, for a program stage0 compiles.
            #
            # Defaulted, so the two big StructTable{...} literals (codegen_debug,
            # c_header) need no edit -- but EVERY names.push must still push an owner in
            # the same breath. names/handles/alignments/field_start/field_count/owners are
            # index-parallel; desynchronising them is an out-of-bounds read.
            owners: mutable darray[sview] = []
            handles: mutable darray[LLVMTypeRef]
            alignments: mutable darray[u32]
            field_names: mutable darray[sview]
            field_types: mutable darray[ValueType]
            field_start: mutable darray[usize]
            field_count: mutable darray[usize]
            # Memoized structural fact: 0 unknown, 1 currently visiting, 2 no darray, 3 has
            # one. Recursive records must terminate, and repeated ABI queries should reuse the
            # same result instead of allocating a traversal-local visited vector.
            struct_darray_cache: mutable darray[u8] = []
            # Named-tuple field LABELS recovered from the parser's `__tuple_label` side-table
            # (labels are stripped from the Expr.Tuple node, recorded by line). A named tuple
            # type `(x: i64, y: i64)` is modeled as a synthesized anonymous (empty-named)
            # struct pre-registered by register_tuple_types; these give the `.field` names.
            tuple_label_lines: mutable darray[u32]
            tuple_label_names: mutable darray[sview]
            # Error-returning functions by LINE, with the SET NAME each declares
            # (`error[BackendError]` -> "BackendError"). Index-parallel, drained from
            # Ast::File by register_error_set_names.
            #
            # It lives here rather than being threaded through declare_function's six
            # signatures because `structs` already reaches every site that needs it. The
            # backend consults it to pick an error function's ABI: stage0 returns a plain
            # `i32` for a FIELDLESS set and a `%ErrSet__E` STRUCT for one with a
            # payload-carrying variant.
            error_fn_lines: mutable darray[u32] = []
            error_fn_set_names: mutable darray[sview] = []
            # Names DECLARED as `error Name:` — an `error[...]` clause naming anything else
            # (a generic parameter, an unrelated type) must NOT drive the ABI choice.
            error_set_decl_names: mutable darray[sview] = []
            # Generic EXTERNS: the declared name and its first type parameter, paired by the
            # parser and drained here. An extern with a `[T]` header cannot be declared at
            # declaration time — its parameter types mention `T` — so it is instantiated per
            # CALL instead, mangled `<name>__<typearg>` exactly as stage0 does.
            generic_extern_names: mutable darray[sview] = []
            generic_extern_params: mutable darray[sview] = []
            # Guest-overlay / address-space carriers (docs/107). `guest_layouts[i]` is the
            # layout name for a GuestCarrier ValueType with `bits == i`. Overlay field offsets
            # and widths come from the parser's `__overlay_field` annotations plus the field
            # type width on the layout struct.
            guest_layouts: mutable darray[sview]
            overlay_field_names: mutable darray[sview]
            overlay_field_offsets: mutable darray[u32]
            overlay_field_widths: mutable darray[u32]
            overlay_field_layouts: mutable darray[sview]
            # GENERIC struct templates. A `struct Box[T]:` is NOT a concrete type — it is
            # a template materialized per type-argument tuple into an ordinary registered
            # struct named `Box__i64` (the concrete name doubles as the instantiation memo:
            # struct_index_of finding it means it is already built). The template stores its
            # own Decl so its member types can be re-resolved with the type parameters bound.
            # Param names live in a FLAT pool with a per-template span, like struct fields.
            generic_struct_names: mutable darray[sview]
            generic_struct_decls: mutable darray[Decl]
            generic_struct_param_names: mutable darray[sview]
            generic_struct_param_start: mutable darray[usize]
            generic_struct_param_count: mutable darray[usize]
            # Instantiation memo, keyed by (base, type-argument tuple) — NOT by a mangled
            # name, so no synthetic name sview has to outlive the call that builds it. Args
            # are flattened into a pool with a per-instantiation span; `inst_index` is the
            # resulting entry's slot in `names`/`handles`.
            generic_struct_inst_bases: mutable darray[sview]
            generic_struct_inst_args: mutable darray[ValueType]
            generic_struct_inst_arg_start: mutable darray[usize]
            generic_struct_inst_arg_count: mutable darray[usize]
            generic_struct_inst_index: mutable darray[usize]
            # Whether the corresponding generic instance has a completed LLVM body. A false
            # entry is visible only while its base is in generic_struct_inprogress; this lets
            # pointer-mediated recursion refer to the opaque placeholder without making a
            # declined instance look usable on a later lookup.
            generic_struct_inst_ready: mutable darray[bool]
            # Base names currently mid-instantiation. A self-recursive generic struct that
            # recurses BY VALUE (infinite size) is declined rather than looped on; the valid
            # by-pointer case (`Node[T]: next: Node[T]&?`) is not modeled yet and also
            # declines here, conservatively.
            generic_struct_inprogress: mutable darray[sview]
            # The module's LLVM context, stashed so annotation_value_type — which has no ctx
            # parameter — can LAZILY materialize a `Base[args]` instantiation (create its
            # named struct and set its body) the first time an annotation names it.
            context: LLVMContextRef
            # Target ABI layout supplied by the driver before codegen. Large aggregate
            # classification must use this exact layout, not an unevaluated LLVMSizeOf expr.
            target_data: LLVMTargetDataRef
            # Fixed-array types, interned on demand: `array_elements[i]` is the element
            # type and `array_extents[i]` the length of the array whose ValueType has
            # `bits == i`. Interning (rather than a fresh entry per mention) keeps
            # `i64[3]` one type, so two locals of the same array type compare equal.
            array_elements: mutable darray[ValueType]
            array_extents: mutable darray[u32]
            # `darray[T]` element types, interned the same way.
            darray_elements: mutable darray[ValueType]
            # `view[T]` element types, interned the same way — the phantom element the
            # `DynArrayView` fat pointer carries for type checking / generic inference.
            view_elements: mutable darray[ValueType]
            # `T&` referent types, interned the same way.
            ref_targets: mutable darray[ValueType]
            # Parallel to ref_targets: whether each interned ref is a RAW HEAP pointer (`heap
            # T&`) rather than a safe reference. A heap ref does POINTER arithmetic on `+`/`-`
            # (advance by stride); a safe ref value-adds (deref then add). The `kind` stays Ref
            # for both, so deref / field / index handling is identical — only arithmetic asks.
            ref_is_heap: mutable darray[bool]
            # `T?` payload types, interned the same way.
            optional_targets: mutable darray[ValueType]
            # Value-carrying `T error[E]` types. The value representation is the stage0
            # descriptor `{i32 error_code, ptr payload}`; the side pools retain the
            # payload type and error-set family.
            error_union_values: mutable darray[ValueType] = []
            error_union_families: mutable darray[sview] = []
            # CONST enums. A `const enum Color of u8` IS its backing scalar (stage0 lowers
            # `def code(c: Color)` to `define i64 @code(i8 %0)`), and a variant is its
            # ORDINAL — `match c: Color.Red:` is `icmp eq i8 %c, 0`. So the backend needs
            # only name -> backing type, and (enum, variant) -> ordinal. Flat pools with a
            # per-enum span, same shape as struct fields.
            enum_names: mutable darray[sview]
            enum_backings: mutable darray[ValueType]
            enum_variants: mutable darray[sview]
            # Parallel to enum_variants: the VALUE each const-enum member compiles to.
            # Without it every member compiled to its declaration ORDINAL, so
            # `const enum C of int: Lo = 2; Hi = 5` answered 0 and 1.
            enum_variant_values: mutable darray[i64]
            enum_variant_start: mutable darray[usize]
            enum_variant_count: mutable darray[usize]
            # PAYLOAD-carrying enums, in a side-pool parallel to the const-enum one above.
            # `penum_payloads` is the payload ValueType of each variant (one per variant, in
            # declaration order); a variant with NO payload still takes a slot so that a
            # variant's index within its enum IS its tag.
            penum_names: mutable darray[sview]
            penum_variants: mutable darray[sview]
            # Parallel to penum_variants: the enum that DECLARED each row. Equal to the
            # penum's own name for a plain enum; for an INLINE hierarchy the root's span
            # holds every refinement's leaves, and the owner tells `Child.V` apart from
            # a same-named `Other.V`.
            penum_variant_owners: mutable darray[sview]
            penum_payloads: mutable darray[ValueType]
            penum_has_payload: mutable darray[bool]
            # The payload field's declared NAME (""), used to check a LABELLED constructor
            # argument: `Shape.Circle(r: 42)` is only that constructor if `r` is the field's
            # real name -- otherwise it is a different program and must not be emitted.
            penum_field_names: mutable darray[sview]
            # MULTI-FIELD payload variants (`Rect(i64, i64)`): each variant's field types and
            # declared names in a flat pool, spanned per variant-slot by _start/_count. A
            # single-field variant keeps its proven single-value path (penum_payloads /
            # penum_has_payload above); a variant with COUNT>1 fields is emitted through these
            # pools instead (tuple store on construction, tuple extract on match). Every
            # variant-slot gets a span (0 fields = empty span) so the pools stay index-parallel.
            penum_field_types: mutable darray[ValueType]
            penum_field_flat_names: mutable darray[sview]
            penum_field_type_start: mutable darray[usize]
            penum_field_type_count: mutable darray[usize]
            # PACKED enums (`packed enum Node:`) — the same per-variant pools as penum_*, but
            # a separate table because the REPRESENTATION differs: a packed value is a store
            # row, not inline data. Kept apart so neither path can silently claim the other's
            # enums (which is exactly the bug 5403a62 fixed).
            packed_names: mutable darray[sview]
            packed_variants: mutable darray[sview]
            packed_payloads: mutable darray[ValueType]
            packed_has_payload: mutable darray[bool]
            packed_field_names: mutable darray[sview]
            packed_variant_start: mutable darray[usize]
            packed_variant_count: mutable darray[usize]
            packed_payload_words: mutable darray[u32]
            # Full payload field spans for aggregate packed variants.
            packed_field_types: mutable darray[ValueType]
            packed_field_flat_names: mutable darray[sview]
            packed_field_type_start: mutable darray[usize]
            packed_field_type_count: mutable darray[usize]
            # How many leading fields of each variant are COMMON (shared across variants).
            # The parser PREPENDS them to every variant's field list, so from here a common
            # block just means "the first N fields are shared". They are stored INLINE
            # between the tag and the payload: stage0 lays out `%Expr = {i32, i64, [1 x i64]}`
            # for one common field, vs `{i32, [1 x i64]}` for none.
            packed_common_counts: mutable darray[u32]
            # A packed enum's COMMON field names, each row carrying its OWNING ENUM NAME.
            #
            # Deliberately owner-keyed rather than index-parallel with `packed_names`: FOUR
            # separate paths push a packed_names row (including a placeholder that pushes no
            # metadata), so an index-parallel pool goes out of step and the lookup reads out of
            # bounds -- which segfaulted the compiler when this was first attempted.
            # `new[store] E.V(...)` — the explicit allocation-target selector. The parser
            # CONSUMES the bracket and records only this line-keyed row, so the backend has no
            # other way to see which store the allocation names. Line-keyed on purpose: pools
            # keyed by packed enum INDEX go out of step with `packed_names` (four paths push
            # those rows) and read out of bounds.
            region_use_lines: mutable darray[u32] = []
            region_use_names: mutable darray[sview] = []
            is_variant_alias_lines: mutable darray[i64] = []
            is_variant_alias_names: mutable darray[sview] = []
            # `derive state: Alive when self.health > 0` — the state PREDICATES, so an
            # `x is Type[State]` test can inline the condition the way stage0 does.
            derived_state_owners: mutable darray[sview] = []
            derived_state_names: mutable darray[sview] = []
            derived_state_conditions: mutable darray[Expr] = []
            # `submit[pool] f(x)` — the explicit pool selector, keyed by the `submit` line.
            submit_pool_lines: mutable darray[i64] = []
            submit_pool_names: mutable darray[sview] = []
            # `impl Protocol for Concrete:` — the concrete type of each impl in the unit.
            # Static protocol dispatch through a bound type parameter is only sound while
            # there is exactly one, since an impl body flattens into bare-named functions.
            impl_concrete_names: mutable darray[sview] = []
            # `any index, item in xs.enumerate() where …` — the EXTRA binders of a
            # multi-binder query, keyed by the query head's line. The Comprehension node
            # carries only the first binder.
            query_extra_binder_lines: mutable darray[i64] = []
            query_extra_binder_names: mutable darray[sview] = []
            # `for {left, right: item_right} in xs` — the FIELD name of each brace-pattern
            # member, in pattern order, keyed by the header line. `Stmt.For` carries only the
            # binder, which is not the field name once a member is renamed.
            for_brace_field_lines: mutable darray[i64] = []
            for_brace_field_names: mutable darray[sview] = []
            # `flags: bitset:` / `layout: bitfield:` members — the NAME, its bit OFFSET and its
            # WIDTH inside the group's backing integer. Only two flag names were ever handled
            # (hard-coded); this carries the rest.
            bitgroup_owners: mutable darray[u32] = []
            bitgroup_fields: mutable darray[sview] = []
            bitgroup_members: mutable darray[sview] = []
            bitgroup_offsets: mutable darray[u32] = []
            bitgroup_widths: mutable darray[u32] = []
            # A `bitset:` member is a BOOL; a `bitfield:` member is an integer even when it is
            # one bit wide (`active: u1` is written from `1`, not from `true`).
            bitgroup_is_flag: mutable darray[bool] = []
            soa_layout_owners: mutable darray[sview] = []
            # Names of ordinary structs whose Elisa declaration requests
            # LLVM's packed byte layout (`layout(packed)`).
            packed_layout_owners: mutable darray[sview] = []
            # `for row in s.rows():` — the ROW BINDER in scope for the loop body. A row view is
            # (aggregate address, row index); rather than materialise stage0's `{ptr, i64}`
            # pair, the binder is recorded here and `row.field` resolves to the element address
            # directly. Pushed on loop entry, popped on exit.
            soa_row_binder_names: mutable darray[sview] = []
            soa_row_binder_slots: mutable darray[u32] = []
            soa_row_binder_bases: mutable darray[LLVMValueRef] = []
            soa_row_binder_indexes: mutable darray[LLVMValueRef] = []
            aggregate_state_owners: mutable darray[sview] = []
            packed_common_owners: mutable darray[sview] = []
            packed_common_names: mutable darray[sview] = []
            packed_common_types: mutable darray[ValueType] = []
            # Explicit `@storage(inline|side_table)` on packed common fields. These rows are
            # keyed by owner/name rather than by packed enum index because hierarchy roots and
            # refinements reserve/register rows through several independent paths.
            packed_common_storage_owners: mutable darray[sview] = []
            packed_common_storage_names: mutable darray[sview] = []
            packed_common_storage_modes: mutable darray[u8] = []
            # Names the PARSER marked as members of the sealed Node hierarchy
            # (`__ast_refinement`). Keyed on the declaration's ancestry, not on the bare
            # name, so a program's own `packed enum Expr:` is an ordinary packed enum.
            ast_refinement_names: mutable darray[sview]
            # `enum Child is Parent` edges (docs/77), one row per clause. The backend used to
            # resolve every hierarchy question to the literal name "Node", which worked only
            # for the compiler's own AST; these edges let packed_root_of answer it for ANY
            # sealed hierarchy. Defaulted so the two full-literal StructTable constructions
            # need no change.
            # Declared TYPE of each common field, parallel to packed_common_owners /
            # packed_common_names. Without it the constructor and the reader fell back to a
            # hardcoded i64 word, so a `common:` field of any other type could not be
            # emitted at all -- the compiler's own AST declares only `int` commons, which IS
            # i64, so self-hosting never exercised the other case. Defaulted so the two
            # full-literal StructTable constructions need no change.
            # Same-name exports (`export fn foo(...) = foo`): implementations exported
            # DIRECTLY go external at the end of emission (their body may be emitted
            # after the export declaration and would reset linkage), and an export
            # the backend could not lower is recorded so the unit fails loudly instead
            # of writing an object with the symbol silently missing.
            direct_export_names: mutable darray[sview] = []
            direct_export_handles: mutable darray[LLVMValueRef] = []
            declined_export_names: mutable darray[sview] = []
            hierarchy_child: mutable darray[sview] = []
            hierarchy_parent: mutable darray[sview] = []
            # Packed enums that use the canonical AoS row ABI. This includes the compiler AST,
            # user sealed hierarchies, and plain recursive enums. It is deliberately separate
            # from ast_refinement_names: a recursive enum such as `Tree` is packed/AoS without
            # belonging to the compiler's sealed Node hierarchy.
            aos_dynamic_names: mutable darray[sview] = []
            penum_variant_start: mutable darray[usize]
            penum_variant_count: mutable darray[usize]
            # Payload words (i64 units) of the WIDEST variant — the `[N x i64]` extent.
            penum_payload_words: mutable darray[u32]
            # `alias Num = i64` — a NAME for an existing type, carrying no representation of
            # its own, so it resolves to the target's ValueType and disappears.
            #
            # Resolved to a FIXPOINT at registration rather than by recursing at each
            # mention: `alias A = B` / `alias B = A` would otherwise recurse forever (the
            # same shape as the value-binding cycle that stack-overflows a naive resolver).
            # A cycle simply never resolves, stays Unmodeled, and DECLINES.
            alias_names: mutable darray[sview]
            alias_types: mutable darray[ValueType]
            # `using Mod as M` — the alias name and the module it stands for, parallel.
            # A qualified call through the alias (`M::f()`) resolves its owner here
            # before the FnTable lookup; without it the alias named no module at all.
            module_alias_names: mutable darray[sview]
            module_alias_targets: mutable darray[sview]
            # GLOBAL consts. stage0 INLINES them: `const LIMIT: i64 = 42` emits no `@LIMIT`
            # global and no load — `LIMIT + NAME.i64()` lowers to `sadd(42, 7)` (read from
            # its -emit llvm output). So a const is a compile-time VALUE substituted at the
            # use site, and the backend needs only name -> (type, folded value).
            #
            # Folded to a FIXPOINT, unlike aliases: stage0 ACCEPTS a forward reference here
            # (`const A: i64 = B + 2` before `const B` works — verified), so an in-order pass
            # would decline a program the reference compiler compiles. A CYCLE never folds
            # and stays unresolved, which declines — stage0 rejects it too ("const \"A\"
            # initializer must be a compile-time i64 value").
            const_names: mutable darray[sview]
            # The module a const was declared in, "" for a top-level one. Consts used to be
            # keyed by BARE NAME alone, so two modules each declaring `SIZE` collapsed onto
            # one row and the second silently overwrote the first -- a wrong answer, and one
            # that qualifying the use site did not save you from, because the collision was
            # in the table rather than in the lookup.
            const_owners: mutable darray[sview]
            const_types: mutable darray[ValueType]
            const_values: mutable darray[i64]
            const_resolved: mutable darray[bool]
            # A FLOAT const's source text (`const PI: f64 = 3.0` → "3.0"), inlined at the use
            # site via LLVMConstRealOfString (never re-parse the decimal). "" for non-float.
            const_float_text: mutable darray[sview]
            # A float const whose initializer is an EXPRESSION (`const D: f64 = W - S`) has no
            # source text to inline, so it carries its FOLDED VALUE instead. Keeping this
            # separate from const_values (which is i64) is the point: folding a float const
            # through the INTEGER folder is what made `W - S` silently read back as 0.0.
            # A `const cstr = "..."` carries its literal TEXT: the use site materializes a
            # global string and yields a POINTER to it, the same thing an inline literal
            # emits. Without this the const was simply unresolved and every function that
            # referenced it DECLINED -- which is what kept nw-core's config suite on stage0.
            const_cstr_text: mutable darray[sview]
            const_float_values: mutable darray[f64]
            const_float_ok: mutable darray[bool]
            # A global const AGGREGATE (array) is backed by a real module GLOBAL rather than a
            # folded scalar: `const_globals[i]` is its `@name` handle (indexed by GEP at use)
            # and `const_global_ok[i]` marks the slot as materialized. Scalar consts leave the
            # handle null and stay on the fold path above.
            const_globals: mutable darray[LLVMValueRef]
            const_global_ok: mutable darray[bool]
            # External C globals. Unlike Elisa `const` values these remain addressable LLVM
            # declarations and are loaded/stored at each use site.
            extern_global_names: mutable darray[sview]
            extern_global_types: mutable darray[ValueType]
            extern_global_handles: mutable darray[LLVMValueRef]
            # Mutable Elisa globals have owned module storage and are distinct from
            # immutable folded consts and external C globals.
            # Impl membership, captured before flatten_static_branches erases the Scoped
            # nodes: parallel rows of (method line, interface, receiver) for every function
            # declared inside an `impl I for C:` block. Used to name the emitted symbol
            # `__impl__I__C__method`, as stage0 does.
            # `def` keyword positions, parallel rows keyed by line — a named CONSTRUCTOR's
            # symbol is `N__for__T__L<line>_C<col>` and Decl.Func carries no column.
            decl_line_rows: mutable darray[u32]
            decl_column_rows: mutable darray[u32]
            # `panic` keyword positions, index-parallel. The panic lowering renders
            # stage0's `panic at FILE:LINE:COL: MESSAGE`, and Expr carries only a line.
            panic_line_rows: mutable darray[u32] = []
            panic_column_rows: mutable darray[u32] = []
            impl_member_lines: mutable darray[u32]
            impl_member_ifaces: mutable darray[sview]
            impl_member_types: mutable darray[sview]
            mutable_global_names: mutable darray[sview]
            # The enclosing `module M:` name, "" at top level — the same key consts carry in
            # const_owners. Without it two modules' `global counter` shared ONE row and the
            # last one materialized wrote its handle over the first's (see the lookup).
            mutable_global_owners: mutable darray[sview]
            mutable_global_types: mutable darray[ValueType]
            mutable_global_handles: mutable darray[LLVMValueRef]
            # `static if` selection results, stashed here because StructTable already
            # reaches every emitter: branch head lines (all of them) and the taken subset.
            # A Stmt.Block("static") whose line is a branch line emits only when taken;
            # a bare `static:` block (line in neither) emits unconditionally.
            static_branch_lines: mutable darray[u32]
            static_taken_lines: mutable darray[u32]
            # The `ensure PRED` postconditions of the function CURRENTLY being emitted.
            # Refilled per function by emit_function_body and read at every `return`, which
            # is where stage0 checks them: it allocates `%result`, stores the returned value
            # into it, then branches on each predicate. Threaded on StructTable rather than
            # Runtime because Runtime is COPIED per function (copied_runtime) and this is a
            # container -- the side-table channel static_branch_lines already uses.
            pending_ensures: mutable darray[Expr]
            # Paths proven non-null by an `assert PATH != null` in the function currently
            # being emitted. stage0 NARROWS on that assert: `assert m.items != null` makes
            # the following `items: DictBucket[K,T]& = m.items` legal (it rejects the same
            # assignment WITHOUT the assert -- verified against stage0 both ways). The std
            # dict's find/get/put all depend on it.
            #
            # A path is `owner.field` (field == "" for a bare local). Recorded per function
            # and dropped as soon as anything ASSIGNS to the path, since the proof dies with
            # the value it was about.
            narrowed_owners: mutable darray[sview]
            narrowed_fields: mutable darray[sview]
            # The CURRENT generic instantiation's type-parameter bindings: `binding_names[i]`
            # (e.g. "T") stands for `binding_types[i]` (e.g. i64). Empty outside one.
            #
            # These live in the registry rather than as their own threaded parameter: the
            # registry already reaches every place a type is resolved, and constructing a
            # fresh empty bindings table per call site is REGION-POLYMORPHIC (so illegal in
            # a non-region-inferable context). Set on entry to an instantiation, cleared on
            # exit. `binding_names` are sviews into the source buffer, so nothing dangles.
            binding_names: mutable darray[sview]
            binding_types: mutable darray[ValueType]
            # `fn(…)->R` signature reconstruction. The parser drops fn-type param/return types
            # from the AST, recording only HEAD NAMES on the __lambda_return / __lambda_param
            # annotations keyed by the fn-type's line. Populated ONCE (register_fn_signatures)
            # from file.enum_annotations: `fn_return_lines[i]` -> `fn_return_heads[i]`. A resolved
            # Fn ValueType carries its RETURN type in the `fn_pool_returns` side-pool at `bits`,
            # so a call through a fn value knows its result type even in argument position.
            fn_return_lines: mutable darray[u32]
            fn_return_heads: mutable darray[sview]
            # QUERY heads, keyed by (line, BINDER) rather than line alone. `fn_return_lines`
            # is line-keyed and its lookup returns the FIRST row for a line, so two queries on
            # one line collided: `(count x in xs where …) * 10 + (sum y in xs where …)` read
            # the `sum` as a `count` and answered 33 where stage0 answers 42 — a silent wrong
            # answer. The parser pushes one row in each of these pools per query, in query
            # order, so they stay index-aligned.
            query_lines: mutable darray[u32]
            query_heads: mutable darray[sview]
            query_binders: mutable darray[sview]
            # List comprehensions marked `by par`, keyed by the Comprehension node's source
            # line. The compact AST shares its node with queries, so the execution marker
            # travels through the file annotation side table instead of widening that node.
            parallel_comprehension_lines: mutable darray[u32] = []
            fn_pool_returns: mutable darray[ValueType]
            # Whether each first-class function type returns an error union, and the
            # source family selector (`R` while a generic is being specialized). The
            # return payload remains in fn_pool_returns only for infallible functions;
            # fallible function values carry the complete ErrorUnion ValueType there.
            fn_pool_errors: mutable darray[bool] = []
            fn_pool_error_families: mutable darray[sview] = []
            fn_param_lines: mutable darray[u32]
            fn_param_heads: mutable darray[sview]
            fn_pool_param_start: mutable darray[usize]
            fn_pool_param_count: mutable darray[usize]
            fn_pool_params: mutable darray[ValueType]
            # Function-type error suffix metadata, keyed by the Expr.Lambda line. The
            # parser preserves `fn(...) -> T error[E]` here before annotation resolution.
            fn_error_lines: mutable darray[u32] = []
            fn_error_families: mutable darray[sview] = []
            # Full function-value parameter type expressions copied from Ast::File. These
            # preserve generic arguments that the legacy head-only annotation rows discard.
            fn_type_param_lines: mutable darray[u32]
            fn_type_return_lines: mutable darray[u32]
            fn_type_return_exprs: mutable darray[Ast::Expr]
            fn_type_param_exprs: mutable darray[Expr]
            # Explicit `clone[T error[E]]` targets preserved by the parser side table.
            clone_error_lines: mutable darray[u32] = []
            clone_error_families: mutable darray[sview] = []
            # Local `x: T error[E]` declarations preserved by the parser side table.
            local_error_lines: mutable darray[u32] = []
            local_error_families: mutable darray[sview] = []
            field_error_lines: mutable darray[u32] = []
            field_error_families: mutable darray[sview] = []
            param_error_lines: mutable darray[u32] = []
            param_error_families: mutable darray[sview] = []
            # Error-set bindings are separate from ordinary type bindings: an errorset
            # parameter names a permission/family row, not a runtime value type.
            error_binding_names: mutable darray[sview] = []
            error_binding_families: mutable darray[sview] = []
            branch_hint_lines: mutable darray[u32]
            branch_hint_kinds: mutable darray[sview]
            # docs/126 D1: names of types that declare a `__drop__` destructor. A
            # side table rather than a flag on the struct row because a destructor
            # may be declared after its type, and because extern/alias types never
            # get a struct row at all. Defaulted so the two full-literal
            # constructions of this table need no change.
            drop_hook_types: mutable darray[sview] = []
            # Struct field DEFAULT VALUES (`x: i64 = 42`), as a SIDE TABLE rather than an
            # array parallel to `field_names`: six sites push field rows, and only two of
            # them have a Decl to read defaults from, so a parallel array would have to be
            # kept in lockstep by all six or silently misindex every field after the gap.
            # Keyed by (struct name, field name) and appended only where a default exists,
            # which is a handful of rows for a whole program.
            field_default_owners: mutable darray[sview] = []
            field_default_fields: mutable darray[sview] = []
            field_default_values: mutable darray[Ast::Expr] = []
            # Whole-program facts used by the opt-in disjoint-parameter alias metadata.
            # A mask bit marks a source parameter that is proven distinct from every other
            # eligible darray reference parameter at every observed call site.
            disjoint_function_names: mutable darray[sview] = []
            disjoint_function_masks: mutable darray[u64] = []
            # Lines of functions declared with a REGION PARAMETER (`def f[@r](…)`). Such a
            # function allocates into the CALLER's region -- `xs: darray[T] @r = []` inside it
            # must outlive the call -- so it takes the arena as a hidden trailing parameter
            # even when nothing in its signature is a growable reference. Recorded by the
            # parser as a `__region_param` row in `local_region_annotations`.
            region_param_lines: mutable darray[u32] = []
            # Region selector names paired with region_param_lines. This lets `new[r]` inside
            # a generic body select its hidden caller-region slot without guessing from a bare
            # name that may exist in another function.
            region_param_names: mutable darray[sview] = []
            # Exact hidden-region facts for ordinary function declarations. The flags are flat
            # and parallel to each function's source parameters; they are populated by the
            # module pre-pass after direct body growth is known and after forwarding reaches a
            # fixpoint.
            region_fact_names: mutable darray[sview] = []
            # The owner module for each region-fact row. Bare names are not globally unique:
            # a module member such as `Box::add` may share its spelling with a stdlib generic
            # `add`. Keeping the owner beside the fact lets the forwarding fixpoint resolve a
            # call the same way the ordinary backend resolver does, instead of taking the first
            # same-named row and silently dropping the caller-region ABI slot.
            region_fact_owners: mutable darray[sview] = []
            region_fact_lines: mutable darray[u32] = []
            region_fact_starts: mutable darray[usize] = []
            region_fact_counts: mutable darray[usize] = []
            region_fact_params: mutable darray[bool] = []
            # `x: darray[i64] @host = [...]` — the REGION a local declaration is pinned to,
            # keyed by the declaration's line. Without these the qualifier was dropped
            # entirely and the container was allocated from whatever arena happened to be
            # ambient; a declaration pinned to a LONGER-lived region landed in a shorter-lived
            # one and its data was freed underneath the program (see the fixture in
            # test/breadth: stage0 answers 60, stage1 used to segfault).
            # Lines whose query carries a `where PATTERN: GUARD` filter, so the node's BODY
            # slot holds the GUARD rather than a projection. See __query_guard.
            query_guard_lines: mutable darray[u32] = []
            # Lines whose PROJECTION query carries a guard the node cannot hold. See
            # __query_guard_dropped: these must decline, not emit an unguarded filter.
            query_dropped_guard_lines: mutable darray[u32] = []
            local_region_lines: mutable darray[u32] = []
            local_region_names: mutable darray[sview] = []
            disjoint_candidate_masks: mutable darray[u64] = []
            # CONDITION BINDING SLOTS — one entry-block alloca per name bound anywhere in the
            # condition currently being emitted, shared by every `is` test in it.
            #
            # `a is T(x) or b is U(x)` short-circuits: if the first test matches, the second
            # test's block never runs. Giving each test its own slot and resolving the body's
            # `x` to the LAST one declared then reads a slot nothing ever stored — which is
            # how the gen3 bootstrap died (a garbage AST handle into ctx_aos_store_record).
            # Sharing one slot means whichever alternative matched is the one that wrote it.
            # Mirrors stage0's createConditionBindingScope / `<name>.cond` entry allocas.
            cond_bind_names: mutable darray[sview] = []
            cond_bind_slots: mutable darray[LLVMValueRef] = []
            cond_bind_types: mutable darray[LLVMTypeRef] = []
            # Emission depth of `emit_condition`. The registry is live while > 0 and cleared
            # when the outermost condition finishes, so slots never leak across conditions.
            cond_bind_depth: mutable usize = 0
            # The MODULE that owns the function currently being emitted ("" at file scope).
            # Set by emit_function_body, read by the bare-call resolver so a sibling call
            # inside `module M:` can prefer M's own member over a same-named function in
            # another module. Defaulted, so the two full-literal StructTable constructions
            # (codegen_debug, c_header) do not need to list it.
            current_owner: mutable sview = ""
