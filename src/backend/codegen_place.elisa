# Stage1 backend — PLACE expressions: struct field addresses and chained field access.
# Part of `module Backend` (see codegen.elisa); split out to keep each file short.

extend Backend:
    private:
        # The ADDRESS of a struct-typed local, and the struct's type.
        #
        # For a plain local that is its alloca. For a `P&` parameter the alloca holds a
        # POINTER, so the address is that pointer LOADED — one indirection more. Everything
        # downstream (field GEP, field store) is then identical, which is why field access
        # needs no ref-specific path of its own.
        def struct_address_of(name: sview, local_scope: mutable Scope&, structs: mutable StructTable&, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            declared: ValueType = lookup_type(local_scope, name)
            # A const DICT global IS its address — the global itself. Same narrowing as
            # struct_type_of_name: stage0 rejects an arbitrary const struct, so only the dict
            # is admitted here.
            if declared.kind == TypeKind.Unmodeled:
                const_struct_index: i64 = const_index_of(structs, name)
                if const_struct_index >= 0 and structs.const_global_ok[const_struct_index.usize()]:
                    structs.const_globals[const_struct_index.usize()] return if synthesized_struct_base_is(structs, copied_type(structs.const_types[const_struct_index.usize()]), "DynDict")
            if lookup_slot(local_scope, name) is slot:
                slot return if declared.kind == TypeKind.Struct
                # A `view[T]` local IS its slot (it holds the DynArrayView value inline).
                slot return if declared.kind == TypeKind.View
                if declared.kind == TypeKind.Ref:
                    ref_addr_target: mutable ValueType = ref_target_of(declared, structs)
                    # `a.begin` where `a: mutable Arena&` -- field access through the arena
                    # CARRIER reads the user-declared `struct Arena` (see arena_user_struct).
                    ref_addr_target <- arena_user_struct(structs) if ref_addr_target.kind == TypeKind.Arena
                    null return if ref_addr_target.kind != TypeKind.Struct and ref_addr_target.kind != TypeKind.View
                    return LLVMBuildLoad2(builder, LLVMPointerTypeInContext(ctx, 0), slot, "ref.deref")
                # `cursor.count` where `cursor: heap Node&?` -- field access through an
                # UN-NARROWED optional ref. stage0 represents an optional pointer as a bare
                # ptr and emits the load unconditionally (the null case is guarded by
                # program flow, e.g. `while cursor != null` or an `assert`), so stage1
                # matches by reading the ptr payload out of its `{i1, ptr}` slot.
                #
                # ANY optional ref, not just a heap one: this was scoped to heap refs for
                # want of a stage0 precedent, and stores_rows supplies one —
                # `&variant_rows.rows` on a plain `PackedStoreVariantRows&?`, which stage0
                # compiles.
                if declared.kind == TypeKind.Optional:
                    opt_payload: ValueType = optional_payload_of(declared, structs)
                    if opt_payload.kind == TypeKind.Ref:
                        opt_addr_target: ValueType = ref_target_of(opt_payload, structs)
                        null return if opt_addr_target.kind == TypeKind.Unmodeled
                        opt_llvm: LLVMTypeRef = llvm_type_of(declared, structs, ctx)
                        opt_loaded: LLVMValueRef = LLVMBuildLoad2(builder, opt_llvm, slot, "opt.heap.load")
                        return optional_payload_value_of(opt_loaded, declared, structs, ctx, builder)
            const_global_index: i64 = const_index_of(structs, name)
            if const_global_index >= 0 and structs.const_global_ok[const_global_index.usize()]:
                return structs.const_globals[const_global_index.usize()]
            mutable_global_index: i64 = mutable_global_index_of(structs, name)
            if mutable_global_index >= 0:
                return structs.mutable_global_handles[mutable_global_index.usize()]
            extern_global_index: i64 = extern_global_index_of(structs, name)
            if extern_global_index >= 0:
                return structs.extern_global_handles[extern_global_index.usize()]
            return null


        # The struct type behind a name, looking through one reference.
        def struct_type_of_name(name: sview, local_scope: mutable Scope&, structs: mutable StructTable&) -> ValueType can[Abort.Panic]:
            can Abort.Panic:
                declared: ValueType = lookup_type(local_scope, name)
                declared return if declared.kind == TypeKind.Struct
                # A const DICT global. Only the ARRAY const globals were readable as places, so
                # `NUMBERS.count` found no struct to take a field from.
                #
                # Restricted to a dict on purpose: stage0 REJECTS an arbitrary const struct
                # ("unsupported const kind 7" for `const P: Pair = Pair{…}`), so accepting one
                # here would compile a program the reference compiler refuses. Measured — the
                # first version of this was that wide and was permissive.
                if declared.kind == TypeKind.Unmodeled:
                    const_struct_index: i64 = const_index_of(structs, name)
                    if const_struct_index >= 0 and structs.const_global_ok[const_struct_index.usize()]:
                        const_struct_type: ValueType = copied_type(structs.const_types[const_struct_index.usize()])
                        const_struct_type return if synthesized_struct_base_is(structs, const_struct_type, "DynDict")
                # A `view[T]` accesses fields (`dst.data`, `dst.len`) through its DynArrayView.
                view_struct_type(declared, structs) return if declared.kind == TypeKind.View
                view_struct_type(ref_target_of(declared, structs), structs) return if declared.kind == TypeKind.Ref and ref_target_of(declared, structs).kind == TypeKind.View
                # An optional REF looks through both wrappers (see struct_address_of).
                if declared.kind == TypeKind.Optional:
                    opt_name_payload: ValueType = optional_payload_of(declared, structs)
                    ref_target_of(opt_name_payload, structs) return if opt_name_payload.kind == TypeKind.Ref
                behind_ref: ValueType = ref_target_of(declared, structs)
                # An arena CARRIER's fields read the user-declared `struct Arena`.
                arena_user_struct(structs) return if behind_ref.kind == TypeKind.Arena
                extern_struct_index: i64 = extern_global_index_of(structs, name)
                if extern_struct_index >= 0:
                    return copied_type(structs.extern_global_types[extern_struct_index.usize()])
                return behind_ref


            # The struct type of a field-access CHAIN (`o`, `o.i`, `o.i.j`, ...). Recurses so
            # nested field reads resolve their receiver's type, not just a bare Ident's.
        def struct_chain_type(object: Expr, local_scope: mutable Scope&, structs: mutable StructTable&) -> ValueType can[Abort.Panic]:
            can Abort.Panic, Memory.Allocate:
                match object:
                    Expr.Ident(chain_name, chain_name_line):
                        chain_local_type: ValueType = lookup_type(local_scope, chain_name)
                        chain_local_type return if chain_local_type.kind != TypeKind.Unmodeled
                        chain_const_index: i64 = const_index_of(structs, chain_name)
                        copied_type(structs.const_types[chain_const_index.usize()]) return if chain_const_index >= 0 and structs.const_global_ok[chain_const_index.usize()]
                        chain_mutable_index: i64 = mutable_global_index_of(structs, chain_name)
                        copied_type(structs.mutable_global_types[chain_mutable_index.usize()]) return if chain_mutable_index >= 0
                        return struct_type_of_name(chain_name, local_scope, structs)
                    # Parentheses do not change the place represented by an expression.
                    # Keep them transparent here just as `emit_expression` does. C pointer
                    # arithmetic commonly arrives as `&(table[0][0])[offset]`; the inner
                    # array element is parenthesized by the translator, and without this
                    # unwrap the chain walker cannot recover the array type needed for the
                    # indexed address.
                    Expr.Paren(chain_parenthesized, _):
                        return struct_chain_type(chain_parenthesized, local_scope, structs)
                    _:
                        pass
                # `elisa_nonnull(pointer).field` is a transparent pointer wrapper emitted by
                # the C translator. Its result is the same pointee reference as the argument;
                # retain that type for the chain walker instead of requiring a bare Ident.
                match object:
                    Expr.Call(chain_wrapper, chain_wrapper_args, _, _):
                        if chain_wrapper is Expr.Ident(chain_wrapper_name, _):
                            if chain_wrapper_name == "elisa_nonnull" and chain_wrapper_args.count == 1:
                                wrapped_chain_type: ValueType = struct_chain_type(chain_wrapper_args[0], local_scope, structs)
                                if wrapped_chain_type.kind == TypeKind.Optional:
                                    wrapped_payload_fallback: ValueType = optional_payload_of(wrapped_chain_type, structs)
                                    return wrapped_payload_fallback if wrapped_payload_fallback.kind == TypeKind.Ref
                                return wrapped_chain_type
                        pass
                    _:
                        pass
                # Address-of is transparent to the chain type resolver: `(&array)[i]` is a
                # reference to the array's element container, not an unknown expression.
                match object:
                    Expr.Unary(chain_unary_operator, chain_unary_operand, _):
                        if chain_unary_operator == TokenKind.Ampersand:
                            unary_place_type: ValueType = struct_chain_type(chain_unary_operand, local_scope, structs)
                            if unary_place_type.kind != TypeKind.Unmodeled:
                                return intern_ref_type(unary_place_type, structs)
                    _:
                        pass
                # A cast used directly as a chain receiver (`(p).cast[T&].field`) is also a
                # type-preserving place. The parser stores the type application as Index(Field).
                match object:
                    Expr.Index(chain_cast_base, chain_cast_type, _):
                        if chain_cast_base is Expr.Field(chain_cast_object, chain_cast_name, _):
                            if chain_cast_name == "cast":
                                return annotation_value_type(chain_cast_type, structs)
                    _:
                        pass
                match object:
                    Expr.Field(chain_inner, chain_field, chain_field_line):
                        inner_type: mutable ValueType = struct_chain_type(chain_inner, local_scope, structs)
                        # Member access auto-dereferences references just like expression_type.
                        # This matters for p.field where p: T&: the chain resolver is used by
                        # both field assignment and address formation, so rejecting the ref here
                        # silently strips the whole function body and leaves only a declaration.
                        inner_type <- ref_target_of(inner_type, structs) if inner_type.kind == TypeKind.Ref
                        if inner_type.kind == TypeKind.Optional:
                            inner_payload: ValueType = optional_payload_of(inner_type, structs)
                            inner_type <- ref_target_of(inner_payload, structs) if inner_payload.kind == TypeKind.Ref
                        inner_type <- arena_user_struct(structs) if inner_type.kind == TypeKind.Arena
                        # `xs.items` — the darray header's element-storage POINTER, so
                        # `xs.items[i] <- v` (how stores_core writes its region table through a
                        # borrowed `darray[T]&`) types as a C-style pointer base. A darray is not
                        # a Struct, so without this the chain bailed one step below and the whole
                        # assignment declined. Mirrors the `.items` READ path.
                        if inner_type.kind == TypeKind.DArray and chain_field == "items":
                            return intern_ref_type(copied_type(structs.darray_elements[inner_type.bits.usize()]), structs)
                        unmodeled_type() return if inner_type.kind != TypeKind.Struct
                        inner_slot: usize = inner_type.bits.usize()
                        position: i64 = field_index_of(structs, inner_slot, chain_field)
                        unmodeled_type() return if position < 0
                        return copied_type(structs.field_types[structs.field_start[inner_slot] + position.usize()])
                    _:
                        pass
                # `a[i]` -> the container's element type. Enables `a[i].field`.
                match object:
                    Expr.Index(indexed_container, index_expr, index_line):
                        # A bare local is looked up directly; any OTHER receiver (a nested index
                        # `m[i][j]`, a field chain `s.grid[i]`) resolves recursively.
                        container_type: mutable ValueType = struct_chain_type(indexed_container, local_scope, structs)
                        match indexed_container:
                            Expr.Ident(container_name, container_name_line):
                                local_container_type: ValueType = lookup_type(local_scope, container_name)
                                container_type <- local_container_type if local_container_type.kind != TypeKind.Unmodeled
                                # A global const ARRAY (`const xs: i64[3]`) is not a local: take its type
                                # from the const table so `xs[i]` resolves its element type.
                                if local_container_type.kind == TypeKind.Unmodeled:
                                    const_container_index: i64 = const_index_of(structs, container_name)
                                    container_type <- copied_type(structs.const_types[const_container_index.usize()]) if const_container_index >= 0 and structs.const_global_ok[const_container_index.usize()]
                                    mutable_container_index: i64 = mutable_global_index_of(structs, container_name)
                                    container_type <- copied_type(structs.mutable_global_types[mutable_container_index.usize()]) if mutable_container_index >= 0
                                    extern_container_index: i64 = extern_global_index_of(structs, container_name)
                                    container_type <- copied_type(structs.extern_global_types[extern_container_index.usize()]) if extern_container_index >= 0
                            _:
                                pass
                        darray_element_of(container_type, structs) return if container_type.kind == TypeKind.DArray
                        array_element_of(container_type, structs) return if container_type.kind == TypeKind.Array
                        # `items[i]` where `items: Struct&` — a C-style pointer base. The element is
                        # the referent struct (the std indexes `DictBucket[K,T]&` this way).
                        if container_type.kind == TypeKind.Ref:
                            ref_element: ValueType = ref_target_of(container_type, structs)
                            ref_element return if ref_element.kind == TypeKind.Struct
                            # `p[i]` where `p: T&` is a ref to a NUMERIC scalar (Slice's `p[i] <- v` assign
                            # target): the element IS that scalar, so the write fallback can type its value.
                            ref_element return if ref_element.kind == TypeKind.Signed or ref_element.kind == TypeKind.Unsigned or ref_element.kind == TypeKind.Float
                            # A pointer-to-pointer (`T&&`) indexes to another pointer. This is
                            # the nested shape emitted for C `char **` buffers such as
                            # `nonnull(output)[0][i]`; retaining the Ref is what lets the outer
                            # index perform its second GEP instead of treating the first result
                            # as an opaque scalar.
                            ref_element return if ref_element.kind == TypeKind.Ref or ref_element.kind == TypeKind.CStr
                            # An OPTIONAL element (`darray[heap Region&?]`, which stores_core writes
                            # through `regions.items[i] <- r`). This was reverted once, for a good
                            # reason that no longer holds: stage1 then gave an optional ref a
                            # 16-byte `{i1, ptr}` while the stage0-compiled runtime that ALLOCATES
                            # such a darray strides by 8, so the write corrupted memory. Since the
                            # niche optimization the element IS the pointer and the strides agree.
                            ref_element return if ref_element.kind == TypeKind.Optional
                            # `m[i]` where `m: darray[T]&` is a BORROWED reference to a single
                            # container (not a C-buffer of containers) -- the standard borrowed-
                            # darray-parameter shape, e.g. `m[0]` in `bump(m: darray[darray[i64]]&)`.
                            # struct_chain_address's own Index/Ident branch already resolves this
                            # ADDRESS (its `chain_borrowed_type.kind == TypeKind.DArray` case just
                            # above); this was the missing TYPE half, so a nested chain rooted at a
                            # borrowed darray-of-darray (`m[i][j]`) fell through to Unmodeled and
                            # declined the whole assignment despite the address side working fine.
                            darray_element_of(ref_element, structs) return if ref_element.kind == TypeKind.DArray
                            # `pts[i]` where `pts: T[N]&` is a BORROWED reference to a single
                            # fixed-size array (the standard borrowed-array-parameter shape, e.g.
                            # `pts[0]` in `bump(pts: mutable Point[3]&)`). Mirrors the DArray-behind-
                            # Ref case just above; without it a chain rooted at a borrowed fixed
                            # array (`pts[0].x`) fell through to Unmodeled and declined the whole
                            # statement even though the compound-assign path's own Ref+Array branch
                            # (codegen_stmt_assign_flow.elisa) already resolves this shape.
                            array_element_of(ref_element, structs) return if ref_element.kind == TypeKind.Array
                        # `d.items[i]` where the field `items` is an OPTIONAL ref `T&?` used as a buffer
                        # pointer (Deque). The element is the ref's referent — unwrap the optional first.
                        if container_type.kind == TypeKind.Optional:
                            opt_ref_payload: ValueType = optional_payload_of(container_type, structs)
                            if opt_ref_payload.kind == TypeKind.Ref:
                                opt_ref_element: ValueType = ref_target_of(opt_ref_payload, structs)
                                opt_ref_element return if opt_ref_element.kind == TypeKind.Struct or opt_ref_element.kind == TypeKind.Signed or opt_ref_element.kind == TypeKind.Unsigned or opt_ref_element.kind == TypeKind.Float or opt_ref_element.kind == TypeKind.Ref or opt_ref_element.kind == TypeKind.CStr or opt_ref_element.kind == TypeKind.Optional
                    _:
                        pass
                return unmodeled_type()


            # The ADDRESS of a field-access chain's struct value. A bare Ident is its slot; a
            # nested field GEPs into its receiver's address. This is what makes `o.i.v` work:
            # the receiver `o.i` is itself a Field, addressed recursively rather than requiring
            # an Ident.
        # The element address for `BINDER.field`, where BINDER is a `for row in s.rows():`
        # row binder: the aggregate's address and the loop's current index are both recorded,
        # so this is the same GEP the explicit `s[i].field` form produces.
        def soa_binder_element_address(binder_row: usize, field: sview, structs: mutable StructTable&, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            owner_slot: usize = structs.soa_row_binder_slots[binder_row].usize()
            column: i64 = field_index_of(structs, owner_slot, field)
            null return if column < 0
            column_type: ValueType = copied_type(structs.field_types[structs.field_start[owner_slot] + column.usize()])
            element_type: ValueType = darray_element_of(column_type, structs)
            null return if element_type.kind == TypeKind.Unmodeled
            owner_llvm: LLVMTypeRef = llvm_type_of(ValueType{kind: TypeKind.Struct, bits: owner_slot.u32()}, structs, ctx)
            column_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, owner_llvm, structs.soa_row_binder_bases[binder_row], column.u32(), "soa.bind.col")
            items: LLVMValueRef = LLVMBuildLoad2(builder, LLVMPointerTypeInContext(ctx, 0), LLVMBuildStructGEP2(builder, darray_llvm_type(structs, ctx), column_pointer, 0, "soa.bind.items.ptr"), "soa.bind.items")
            at: LLVMValueRef = LLVMBuildLoad2(builder, LLVMInt64TypeInContext(ctx), structs.soa_row_binder_indexes[binder_row], "soa.bind.at")
            offsets: mutable darray[LLVMValueRef] = [at]
            offsets_pointer: void& = (&offsets[0]).cast[void&] can Unsafe.PointerCast
            return LLVMBuildGEP2(builder, llvm_type_of(element_type, structs, ctx), items, offsets_pointer, 1, "soa.bind.elem")


        # A ROW INDEX widened to i64. A `RowId[S]` is an i32 (stage0 narrows the count on
        # push), and the emitters below all want an i64 offset -- storing the i32 straight into
        # an i64 slot, or GEPing with it, is a type mismatch LLVM does not diagnose here. It
        # cost a SIGSEGV that only appeared UNOPTIMISED: -O2 folded the bad value away and
        # produced stage0's answer, so a value check at -O2 alone would have passed it.
        def soa_row_index_as_i64(value: LLVMValueRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef can[Abort.Panic]:
            value return if LLVMTypeOf(value) == LLVMInt64TypeInContext(ctx)
            return LLVMBuildSExt(builder, value, LLVMInt64TypeInContext(ctx), "soa.row.index.wide")


        # The ELEMENT TYPE behind `BINDER.field` for a row binder, or Unmodeled.
        def soa_binder_element_type(binder_row: usize, field: sview, structs: mutable StructTable&) -> ValueType can[Abort.Panic, Memory.Allocate]:
            owner_slot: usize = structs.soa_row_binder_slots[binder_row].usize()
            column: i64 = field_index_of(structs, owner_slot, field)
            unmodeled_type() return if column < 0
            return darray_element_of(copied_type(structs.field_types[structs.field_start[owner_slot] + column.usize()]), structs)


        def struct_chain_address(object: Expr, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            # A struct VALUE returned by a call has no source-level address, but field
            # projection still needs one for the ordinary GEP/load path. Spill the rvalue
            # into the function entry block and return that stable address. This is the same
            # representation used for returned darrays and views; restricting it to structs
            # keeps the place resolver from inventing writable storage for scalar expressions.
            match object:
                Expr.Call(_, _, _, _):
                    rvalue_type: ValueType = expression_type(object, local_scope, fns, structs, generics)
                    if rvalue_type.kind == TypeKind.Struct:
                        if emit_expression(object, rvalue_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is rvalue:
                            rvalue_slot: LLVMValueRef = build_entry_alloca(builder, llvm_type_of(rvalue_type, structs, ctx), "struct.rvalue")
                            _ = LLVMBuildStore(builder, rvalue, rvalue_slot)
                            return rvalue_slot
                    # A reference-valued call already produces the address needed by a field
                    # or index place. This includes the generic C-translation shape
                    # `elisa_nonnull(optional_pointer).field`: the wrapper turns an optional
                    # reference into a plain reference, but the call result is still an rvalue
                    # rather than a named local for the structural walker to discover.
                    if rvalue_type.kind == TypeKind.Ref:
                        if emit_expression(object, rvalue_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is ref_rvalue:
                            emit_pointer_deref_guard(ref_rvalue, runtime, m, ctx, builder)
                            return ref_rvalue
                    if rvalue_type.kind == TypeKind.Optional:
                        rvalue_payload: ValueType = optional_payload_of(rvalue_type, structs)
                        if rvalue_payload.kind == TypeKind.Ref:
                            if emit_expression(object, rvalue_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is optional_rvalue:
                                optional_pointer: LLVMValueRef = optional_payload_value_of(optional_rvalue, rvalue_type, structs, ctx, builder)
                                emit_pointer_deref_guard(optional_pointer, runtime, m, ctx, builder)
                                return optional_pointer
                    return null
                _:
                    pass
            match object:
                Expr.Ident(chain_name, chain_name_line):
                    if struct_address_of(chain_name, local_scope, structs, ctx, builder) is base_address:
                        emit_pointer_deref_guard(base_address, runtime, m, ctx, builder)
                        return base_address
                    return null
                _:
                    pass
            # Address-of is itself a reference-valued rvalue. When it is used as the
            # receiver of another index, for example
            # `(&(&nonnull(p)[-1])[-64])[0]`, evaluate the address expression once and
            # reuse its pointer value as the place base.
            match object:
                Expr.Unary(address_operator, address_operand, _):
                    if address_operator == TokenKind.Ampersand:
                        address_type: ValueType = expression_type(object, local_scope, fns, structs, generics)
                        if address_type.kind == TypeKind.Ref:
                            if emit_expression(object, address_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is address_value:
                                emit_pointer_deref_guard(address_value, runtime, m, ctx, builder)
                                return address_value
                        if address_type.kind == TypeKind.Optional:
                            address_payload: ValueType = optional_payload_of(address_type, structs)
                            if address_payload.kind == TypeKind.Ref:
                                if emit_expression(object, address_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is optional_address_value:
                                    optional_address_pointer: LLVMValueRef = optional_payload_value_of(optional_address_value, address_type, structs, ctx, builder)
                                    emit_pointer_deref_guard(optional_address_pointer, runtime, m, ctx, builder)
                                    return optional_address_pointer
                        if struct_chain_address(address_operand, local_scope, fns, structs, generics, runtime, m, ctx, builder) is address_place:
                            return address_place
                _:
                    pass
            # Parenthesized lvalues retain the same address. This is needed for the
            # translated C idiom `&(table[0][0])[offset]`: the address resolver is
            # asked to walk the parenthesized inner place while forming the final GEP.
            match object:
                Expr.Paren(chain_parenthesized, _):
                    return struct_chain_address(chain_parenthesized, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                _:
                    pass
            match object:
                Expr.Field(chain_inner, chain_field, chain_field_line):
                    # A pointer-producing call is a valid field receiver too: translated C can
                    # spell `elisa_nonnull(make_item()).value`. The older structural walker only
                    # knows about named locals and fields, so give a reference-valued rvalue its
                    # ordinary expression type and form the GEP directly before falling through
                    # to the slot-aware chain logic below.
                    rvalue_field_receiver_type: mutable ValueType = expression_type(chain_inner, local_scope, fns, structs, generics)
                    rvalue_field_struct_type: mutable ValueType = unmodeled_type()
                    rvalue_field_is_optional: mutable bool = false
                    if rvalue_field_receiver_type.kind == TypeKind.Ref:
                        rvalue_field_struct_type <- ref_target_of(rvalue_field_receiver_type, structs)
                    elif rvalue_field_receiver_type.kind == TypeKind.Optional:
                        rvalue_field_payload: ValueType = optional_payload_of(rvalue_field_receiver_type, structs)
                        if rvalue_field_payload.kind == TypeKind.Ref:
                            rvalue_field_struct_type <- ref_target_of(rvalue_field_payload, structs)
                            rvalue_field_is_optional <- true
                    if rvalue_field_struct_type.kind == TypeKind.Struct:
                        rvalue_field_slot: usize = rvalue_field_struct_type.bits.usize()
                        rvalue_field_position: i64 = field_index_of(structs, rvalue_field_slot, chain_field)
                        if rvalue_field_position >= 0:
                            rvalue_field_base: mutable LLVMValueRef = zeroed
                            if rvalue_field_is_optional:
                                if emit_expression(chain_inner, rvalue_field_receiver_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is rvalue_field_optional_value:
                                    rvalue_field_base <- optional_payload_value_of(rvalue_field_optional_value, rvalue_field_receiver_type, structs, ctx, builder)
                            else:
                                if emit_expression(chain_inner, rvalue_field_receiver_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is rvalue_field_pointer:
                                    rvalue_field_base <- rvalue_field_pointer
                            if rvalue_field_base != zeroed:
                                emit_pointer_deref_guard(rvalue_field_base, runtime, m, ctx, builder)
                                return LLVMBuildStructGEP2(builder, llvm_type_of(rvalue_field_struct_type, structs, ctx), rvalue_field_base, rvalue_field_position.u32(), "rvalue.field.ptr")
                    # `rows[r].field` on a `layout(soa)` aggregate -- the element address inside
                    # that field's COLUMN. Resolved here, in the one lvalue chain resolver, so the
                    # READ and the WRITE (`rows[r].field <- v`) both get it from one place.
                    #
                    # stage0 models the row as a `{ptr, i64}` pair (store pointer + index) and then
                    # GEPs the column and indexes it; the pair is a temporary in its lowering, so
                    # going straight to the element address is the same address by a shorter route.
                    match chain_inner:
                        Expr.Ident(soa_bind_name, soa_bind_line):
                            soa_bind_row: i64 = soa_row_binder_index_of(structs, soa_bind_name)
                            if soa_bind_row >= 0:
                                return soa_binder_element_address(soa_bind_row.usize(), chain_field, structs, ctx, builder)
                        _:
                            pass
                    match chain_inner:
                        Expr.Index(soa_row_object, soa_row_index, soa_row_line):
                            soa_row_type: ValueType = expression_type(soa_row_object, local_scope, fns, structs, generics)
                            if soa_row_type.kind == TypeKind.Struct and struct_declares_soa_layout(structs, structs.names[soa_row_type.bits.usize()]):
                                soa_row_slot: usize = soa_row_type.bits.usize()
                                soa_row_column: i64 = field_index_of(structs, soa_row_slot, chain_field)
                                if soa_row_column >= 0:
                                    if struct_chain_address(soa_row_object, local_scope, fns, structs, generics, runtime, m, ctx, builder) is soa_row_base:
                                        if emit_expression(soa_row_index, ValueType{kind: TypeKind.Signed, bits: 64}, local_scope, fns, structs, generics, runtime, m, ctx, builder) is soa_row_at_raw:
                                            soa_row_at: mutable LLVMValueRef = soa_row_at_raw
                                            soa_row_at <- soa_row_index_as_i64(soa_row_at, ctx, builder)
                                            soa_row_llvm: LLVMTypeRef = llvm_type_of(soa_row_type, structs, ctx)
                                            soa_row_col_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, soa_row_llvm, soa_row_base, soa_row_column.u32(), "soa.row.col")
                                            soa_row_col_type: ValueType = copied_type(structs.field_types[structs.field_start[soa_row_slot] + soa_row_column.usize()])
                                            soa_row_element: ValueType = darray_element_of(soa_row_col_type, structs)
                                            if soa_row_element.kind != TypeKind.Unmodeled:
                                                soa_row_items: LLVMValueRef = LLVMBuildLoad2(builder, LLVMPointerTypeInContext(ctx, 0), LLVMBuildStructGEP2(builder, darray_llvm_type(structs, ctx), soa_row_col_pointer, 0, "soa.row.items.ptr"), "soa.row.items")
                                                soa_row_offsets: mutable darray[LLVMValueRef] = [soa_row_at]
                                                soa_row_offset_pointer: void& = (&soa_row_offsets[0]).cast[void&] can Unsafe.PointerCast
                                                return LLVMBuildGEP2(builder, llvm_type_of(soa_row_element, structs, ctx), soa_row_items, soa_row_offset_pointer, 1, "soa.row.elem")
                                        return null
                                    return null
                        _:
                            pass
                    inner_type: mutable ValueType = struct_chain_type(chain_inner, local_scope, structs)
                    # The side-effect-free chain typer cannot see through a call result. The
                    # full expression typer can, and the address resolver below will spill that
                    # result before applying this field's GEP.
                    inner_type <- expression_type(chain_inner, local_scope, fns, structs, generics) if inner_type.kind == TypeKind.Unmodeled
                    # The inner expression's type BEFORE unwrapping, and whether it is itself a
                    # FIELD. A ref/optional-ref FIELD's slot holds a POINTER, so the GEP below has to
                    # start from the loaded pointer — see the dereference beneath. Only for a field:
                    # for an Ident struct_address_of already resolved the binding to the pointee, and
                    # for an Index the element address is likewise final.
                    chain_inner_declared: ValueType = copied_type(inner_type)
                    chain_inner_is_field: mutable bool = false
                    match chain_inner:
                        Expr.Field(chain_probe_head, chain_probe_name, chain_probe_line):
                            chain_inner_is_field <- true
                        _:
                            pass
                    chain_inner_is_ref: bool = inner_type.kind == TypeKind.Ref and chain_inner_is_field
                    chain_inner_is_optional_ref: mutable bool = false
                    inner_type <- ref_target_of(inner_type, structs) if inner_type.kind == TypeKind.Ref
                    if inner_type.kind == TypeKind.Optional:
                        inner_payload: ValueType = optional_payload_of(inner_type, structs)
                        chain_inner_is_optional_ref <- inner_payload.kind == TypeKind.Ref and chain_inner_is_field
                        inner_type <- ref_target_of(inner_payload, structs) if inner_payload.kind == TypeKind.Ref
                    inner_type <- arena_user_struct(structs) if inner_type.kind == TypeKind.Arena
                    # The ADDRESS of the darray header's `items` pointer (field 0) — the slot
                    # holding the base pointer, which the index step then loads and GEPs.
                    if inner_type.kind == TypeKind.DArray and chain_field == "items":
                        if darray_read_slot(chain_inner, inner_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is items_header_slot:
                            return LLVMBuildStructGEP2(builder, darray_llvm_type(structs, ctx), items_header_slot, 0, "darray.items.ptr")
                        return null
                    null return if inner_type.kind != TypeKind.Struct
                    inner_slot: usize = inner_type.bits.usize()
                    position: i64 = field_index_of(structs, inner_slot, chain_field)
                    null return if position < 0
                    if struct_chain_address(chain_inner, local_scope, fns, structs, generics, runtime, m, ctx, builder) is inner_address:
                        inner_llvm: LLVMTypeRef = llvm_type_of(inner_type, structs, ctx)
                        emit_pointer_deref_guard(inner_address, runtime, m, ctx, builder)
                        # `a.end.next` as a PLACE — the third site of the slot-vs-pointee bug, after
                        # the field READ (codegen_expr_calls) and the field ASSIGN
                        # (codegen_stmt_assign_flow). Reached by the nested chain and by the
                        # `place as & <- v` reborrow form, which is how stores_core installs a new
                        # Region (`a.end.next as & <- new_region_with_owner(...)`).
                        chain_base: mutable LLVMValueRef = inner_address
                        if chain_inner_is_ref:
                            chain_base <- LLVMBuildLoad2(builder, LLVMPointerTypeInContext(ctx, 0), inner_address, "chain.ref.base")
                        elif chain_inner_is_optional_ref:
                            chain_opt_llvm: LLVMTypeRef = llvm_type_of(chain_inner_declared, structs, ctx)
                            chain_opt_value: LLVMValueRef = LLVMBuildLoad2(builder, chain_opt_llvm, inner_address, "chain.opt")
                            chain_base <- optional_payload_value_of(chain_opt_value, chain_inner_declared, structs, ctx, builder)
                        emit_pointer_deref_guard(chain_base, runtime, m, ctx, builder) if chain_inner_is_ref or chain_inner_is_optional_ref
                        return LLVMBuildStructGEP2(builder, inner_llvm, chain_base, position.u32(), "field.chain.ptr")
                    return null
                _:
                    pass
            # `a[i]` -> the element's ADDRESS, so `a[i].field` reads/writes in place rather
            # than spilling a copy. darray and fixed array use their own index-address paths.
            match object:
                Expr.Index(indexed_container, index_expr, index_line):
                    # Prefix `&` binds to the complete postfix expression in the
                    # translated spelling `&(table[0][0])[offset]`. When the base is
                    # parenthesized, this is pointer arithmetic over the address of the
                    # scalar place inside those parentheses, not indexing the fixed array
                    # that contains it. Handle that structural form before the ordinary
                    # nested-array walk below.
                    match indexed_container:
                        Expr.Paren(pointer_base, _):
                            pointer_base_type: ValueType = struct_chain_type(pointer_base, local_scope, structs)
                            if pointer_base_type.kind != TypeKind.Unmodeled and pointer_base_type.kind != TypeKind.Void:
                                if struct_chain_address(pointer_base, local_scope, fns, structs, generics, runtime, m, ctx, builder) is pointer_base_address:
                                    if emit_expression(index_expr, ValueType{kind: TypeKind.Signed, bits: 64}, local_scope, fns, structs, generics, runtime, m, ctx, builder) is pointer_offset:
                                        pointer_offset_indices: mutable darray[LLVMValueRef] = [pointer_offset]
                                        pointer_offset_pointer: void& = (&pointer_offset_indices[0]).cast[void&] can Unsafe.PointerCast
                                        return LLVMBuildGEP2(builder, llvm_type_of(pointer_base_type, structs, ctx), pointer_base_address, pointer_offset_pointer, 1, "pointer.index.paren.ptr")
                        Expr.Unary(pointer_operator, pointer_base_operand, _):
                            if pointer_operator == TokenKind.Ampersand:
                                pointer_base_type: ValueType = struct_chain_type(pointer_base_operand, local_scope, structs)
                                if pointer_base_type.kind != TypeKind.Unmodeled and pointer_base_type.kind != TypeKind.Void:
                                    if struct_chain_address(pointer_base_operand, local_scope, fns, structs, generics, runtime, m, ctx, builder) is pointer_base_address:
                                        if emit_expression(index_expr, ValueType{kind: TypeKind.Signed, bits: 64}, local_scope, fns, structs, generics, runtime, m, ctx, builder) is pointer_offset:
                                            pointer_offset_indices: mutable darray[LLVMValueRef] = [pointer_offset]
                                            pointer_offset_pointer: void& = (&pointer_offset_indices[0]).cast[void&] can Unsafe.PointerCast
                                            return LLVMBuildGEP2(builder, llvm_type_of(pointer_base_type, structs, ctx), pointer_base_address, pointer_offset_pointer, 1, "pointer.index.unary.ptr")
                        _:
                            pass
                    # A protocol index returns the element PLACE directly. Resolve it
                    # before the built-in array/darray/view cases below; those cases
                    # intentionally return null for an arbitrary struct receiver.
                    custom_index_type: mutable ValueType = index_overload_generic_type(indexed_container, index_expr, local_scope, fns, structs, generics)
                    custom_index_type <- index_overload_type(indexed_container, index_expr, local_scope, fns, structs, generics) if custom_index_type.kind == TypeKind.Unmodeled
                    if custom_index_type.kind == TypeKind.Ref:
                        if emit_expression(object, custom_index_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is custom_index_address:
                            emit_pointer_deref_guard(custom_index_address, runtime, m, ctx, builder)
                            return custom_index_address
                    # A reference-valued rvalue (`make_ref()[i]`) and a string
                    # literal have no local slot for the older chain walker to
                    # discover. Their emitted value is already the base pointer;
                    # GEP it directly. This is the shape produced by translated C
                    # for `&nonnull(ptr)[i]` and `&"text"[0]`.
                    rvalue_container_type: ValueType = expression_type(indexed_container, local_scope, fns, structs, generics)
                    rvalue_element_type: mutable ValueType = unmodeled_type()
                    rvalue_pointer: mutable bool = false
                    if rvalue_container_type.kind == TypeKind.Ref:
                        rvalue_element_type <- ref_target_of(rvalue_container_type, structs)
                        # A borrowed darray reference points at the darray HEADER, not at its
                        # first element. The generic ref path below GEPs directly from the
                        # reference value, which is correct for `T&`/`array[T, N]&` but would
                        # make `&da[0]` point at the header itself. Route `darray[T]&` through
                        # the header/items ABI instead; otherwise compiler code such as
                        # `sview_to_cstr(name, storage)` hands LLVM a stack/header address as
                        # the supposed C-string name during stage1 self-hosting.
                        if rvalue_element_type.kind == TypeKind.DArray:
                            if darray_address_of_expr(indexed_container, local_scope, fns, structs, generics, runtime, m, ctx, builder) is rvalue_darray_header:
                                return emit_darray_index_address(rvalue_darray_header, rvalue_element_type, index_expr, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                            return null
                        # A borrowed fixed-array reference points at the ARRAY object, not at
                        # its first element. The generic one-index GEP below is therefore
                        # wrong: `getelementptr [N x T], ptr %base, i64 i` advances by a
                        # whole array for each index. Use the ordinary fixed-array helper,
                        # which emits the required `{0, i}` indexing. This path is reached
                        # before the identifier-specific branch below for `pts[i]`, so leaving
                        # it generic silently corrupted field-chain reads, writes, and address
                        # comparisons for `pts: T[N]&`.
                        if rvalue_element_type.kind == TypeKind.Array:
                            if emit_expression(indexed_container, rvalue_container_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is rvalue_array_base:
                                return emit_index_address(rvalue_array_base, rvalue_element_type, index_expr, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                            return null
                        rvalue_pointer <- rvalue_element_type.kind != TypeKind.Unmodeled
                    elif rvalue_container_type.kind == TypeKind.CStr:
                        rvalue_element_type <- ValueType{kind: TypeKind.Unsigned, bits: 8}
                        rvalue_pointer <- true
                    if rvalue_pointer:
                        if emit_expression(indexed_container, rvalue_container_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is rvalue_base:
                            if emit_expression(index_expr, ValueType{kind: TypeKind.Signed, bits: 64}, local_scope, fns, structs, generics, runtime, m, ctx, builder) is rvalue_index:
                                rvalue_indices: mutable darray[LLVMValueRef] = [rvalue_index]
                                rvalue_indices_pointer: void& = (&rvalue_indices[0]).cast[void&] can Unsafe.PointerCast
                                return LLVMBuildGEP2(builder, llvm_type_of(rvalue_element_type, structs, ctx), rvalue_base, rvalue_indices_pointer, 1, "rvalue.index.ptr")
                        pass
                    # `elisa_nonnull(p)[i]` is a common C-pointer spelling. The generic wrapper
                    # is semantically transparent, but its generic-call lowering may decline in
                    # an lvalue address probe before the call path has inferred the type. Peel
                    # the wrapper for the address operation and use the original pointer value;
                    # this preserves the C address calculation without inventing a temporary.
                    match indexed_container:
                        Expr.Call(nonnull_index_callee, nonnull_index_args, _, _):
                            if nonnull_index_callee is Expr.Ident(nonnull_index_name, _):
                                if nonnull_index_name == "elisa_nonnull" and nonnull_index_args.count == 1:
                                    nonnull_source_type: ValueType = expression_type(nonnull_index_args[0], local_scope, fns, structs, generics)
                                    nonnull_element_type: mutable ValueType = unmodeled_type()
                                    if nonnull_source_type.kind == TypeKind.Ref:
                                        nonnull_element_type <- ref_target_of(nonnull_source_type, structs)
                                    elif nonnull_source_type.kind == TypeKind.Optional:
                                        nonnull_payload_type: ValueType = optional_payload_of(nonnull_source_type, structs)
                                        nonnull_element_type <- ref_target_of(nonnull_payload_type, structs) if nonnull_payload_type.kind == TypeKind.Ref
                                    if nonnull_element_type.kind != TypeKind.Unmodeled:
                                        if emit_expression(nonnull_index_args[0], nonnull_source_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is nonnull_base:
                                            if emit_expression(index_expr, ValueType{kind: TypeKind.Signed, bits: 64}, local_scope, fns, structs, generics, runtime, m, ctx, builder) is nonnull_index:
                                                nonnull_indices: mutable darray[LLVMValueRef] = [nonnull_index]
                                                nonnull_indices_pointer: void& = (&nonnull_indices[0]).cast[void&] can Unsafe.PointerCast
                                                return LLVMBuildGEP2(builder, llvm_type_of(nonnull_element_type, structs, ctx), nonnull_base, nonnull_indices_pointer, 1, "nonnull.index.ptr")
                        _:
                            pass
                    # `(p.cast[T&])[i]` — indexing DIRECTLY into a cast, with no local in between.
                    # `.cast[T]` parses as Index(Field(x, "cast"), T), so the base here is an
                    # Index, and every branch below wants an Ident (or an array literal). The
                    # chain therefore declined, taking the enclosing function with it, while the
                    # same code with the cast bound to a local compiled. stage0 accepts both.
                    #
                    # The cast VALUE is already the pointer we need, so emit it and GEP by the
                    # index at the element stride — the same lowering the named `p: T&` case
                    # below uses once it has loaded the pointer out of the slot.
                    match indexed_container:
                        Expr.Index(cast_base_head, cast_base_arg, cast_base_line):
                            match cast_base_head:
                                Expr.Field(cast_base_source, cast_base_method, cast_base_method_line):
                                    if cast_base_method == "cast":
                                        cast_base_target: ValueType = annotation_value_type(cast_base_arg, structs)
                                        if cast_base_target.kind == TypeKind.Ref:
                                            cast_base_element: ValueType = ref_target_of(cast_base_target, structs)
                                            if cast_base_element.kind != TypeKind.Unmodeled:
                                                if emit_expression(indexed_container, cast_base_target, local_scope, fns, structs, generics, runtime, m, ctx, builder) is cast_base_pointer:
                                                    if emit_expression(index_expr, ValueType{kind: TypeKind.Signed, bits: 64}, local_scope, fns, structs, generics, runtime, m, ctx, builder) is cast_base_index:
                                                        cast_base_llvm: LLVMTypeRef = llvm_type_of(cast_base_element, structs, ctx)
                                                        cast_base_indices: mutable darray[LLVMValueRef] = [cast_base_index]
                                                        cast_base_indices_pointer: void& = (&cast_base_indices[0]).cast[void&] can Unsafe.PointerCast
                                                        return LLVMBuildGEP2(builder, cast_base_llvm, cast_base_pointer, cast_base_indices_pointer, 1, "cast.index.ptr")
                                                return null
                                _:
                                    pass
                        _:
                            pass
                    match indexed_container:
                        Expr.Ident(container_name, container_name_line):
                            container_type: ValueType = lookup_type(local_scope, container_name)
                            # A BORROWED darray param (`da: darray[T]&`) indexed and address-taken
                            # (`&da[i]`, as in Slice's `slice(&da)` → `(&da[0]).cast[uintptr]`): the header
                            # address is loaded out of the parameter slot, then the element is GEP'd like
                            # any darray. Checked before the plain-local and ref-to-struct cases.
                            chain_borrowed_type: ValueType = darray_type_behind(local_scope, container_name, structs)
                            if chain_borrowed_type.kind == TypeKind.DArray and container_type.kind == TypeKind.Ref:
                                if darray_address_of(local_scope, container_name, structs, ctx, builder) is chain_borrowed_slot:
                                    return emit_darray_index_address(chain_borrowed_slot, chain_borrowed_type, index_expr, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                                return null
                            if lookup_slot(local_scope, container_name) is container_slot:
                                if container_type.kind == TypeKind.DArray:
                                    return emit_darray_index_address(container_slot, container_type, index_expr, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                                if container_type.kind == TypeKind.Array:
                                    return emit_index_address(container_slot, container_type, index_expr, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                                # `p[i]` where `p: T&` is a ref used as a C-style pointer base: the slot
                                # holds a pointer to element 0; the element ADDRESS is a GEP by index at the
                                # element stride. Covers a STRUCT element (how the std walks DictBucket rows)
                                # AND a NUMERIC scalar (Slice's `&p[lo]` / `p[i] <- v`, where the assign
                                # target and address-of both resolve here).
                                if container_type.kind == TypeKind.Ref:
                                    ref_element: ValueType = ref_target_of(container_type, structs)
                                    if ref_element.kind == TypeKind.Struct or ref_element.kind == TypeKind.Signed or ref_element.kind == TypeKind.Unsigned or ref_element.kind == TypeKind.Float:
                                        base_pointer: LLVMValueRef = LLVMBuildLoad2(builder, LLVMPointerTypeInContext(ctx, 0), container_slot, "ref.base")
                                        if emit_expression(index_expr, ValueType{kind: TypeKind.Signed, bits: 64}, local_scope, fns, structs, generics, runtime, m, ctx, builder) is index_value:
                                            element_llvm: LLVMTypeRef = llvm_type_of(ref_element, structs, ctx)
                                            ref_indices: mutable darray[LLVMValueRef] = [index_value]
                                            ref_indices_pointer: void& = (&ref_indices[0]).cast[void&] can Unsafe.PointerCast
                                            return LLVMBuildGEP2(builder, element_llvm, base_pointer, ref_indices_pointer, 1, "ref.index.ptr")
                                        return null
                                    # `pts[i]` where `pts: T[N]&` is a borrowed reference to a single
                                    # fixed-size array — the standard borrowed-array-parameter shape
                                    # (mirrors the `chain_borrowed_type.kind == TypeKind.DArray` case
                                    # above, one level down: there the container itself is the darray;
                                    # here it is a fixed array). The slot holds a pointer to the
                                    # underlying N-element buffer, addressed exactly like a local
                                    # fixed array once loaded.
                                    if ref_element.kind == TypeKind.Array:
                                        ref_array_base: LLVMValueRef = LLVMBuildLoad2(builder, LLVMPointerTypeInContext(ctx, 0), container_slot, "chain.arr.ref.base")
                                        return emit_index_address(ref_array_base, ref_element, index_expr, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                                # C pointer declarations are represented as nullable references
                                # (`T&?`). After the translator's `elisa_nonnull`/flow guard, the
                                # nullable value is still the pointer base; load its niche
                                # representation and index by the pointee stride. Treat this the
                                # same as the ordinary `T&` branch above so direct `p[i]` stores
                                # do not require an artificial nonnull wrapper.
                                if container_type.kind == TypeKind.Optional:
                                    optional_container_payload: ValueType = optional_payload_of(container_type, structs)
                                    if optional_container_payload.kind == TypeKind.Ref:
                                        optional_ref_element: ValueType = ref_target_of(optional_container_payload, structs)
                                        if optional_ref_element.kind != TypeKind.Unmodeled:
                                            optional_container_value: LLVMValueRef = LLVMBuildLoad2(builder, llvm_type_of(container_type, structs, ctx), container_slot, "optional.ref.base")
                                            optional_base_pointer: LLVMValueRef = optional_payload_value_of(optional_container_value, container_type, structs, ctx, builder)
                                            if emit_expression(index_expr, ValueType{kind: TypeKind.Signed, bits: 64}, local_scope, fns, structs, generics, runtime, m, ctx, builder) is optional_index_value:
                                                optional_element_llvm: LLVMTypeRef = llvm_type_of(optional_ref_element, structs, ctx)
                                                optional_indices: mutable darray[LLVMValueRef] = [optional_index_value]
                                                optional_indices_pointer: void& = (&optional_indices[0]).cast[void&] can Unsafe.PointerCast
                                                return LLVMBuildGEP2(builder, optional_element_llvm, optional_base_pointer, optional_indices_pointer, 1, "optional.ref.index.ptr")
                                            return null
                            # `xs[i]` where `xs` is a global const ARRAY — the base "slot" is the
                            # `@xs` global itself, GEP'd exactly like a local fixed array.
                            const_array_index: i64 = const_index_of(structs, container_name)
                            if const_array_index >= 0 and structs.const_global_ok[const_array_index.usize()]:
                                const_array_type: ValueType = copied_type(structs.const_types[const_array_index.usize()])
                                return emit_index_address(structs.const_globals[const_array_index.usize()], const_array_type, index_expr, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                            mutable_array_index: i64 = mutable_global_index_of(structs, container_name)
                            if mutable_array_index >= 0:
                                mutable_array_type: ValueType = copied_type(structs.mutable_global_types[mutable_array_index.usize()])
                                return emit_index_address(structs.mutable_global_handles[mutable_array_index.usize()], mutable_array_type, index_expr, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                            extern_array_index: i64 = extern_global_index_of(structs, container_name)
                            if extern_array_index >= 0:
                                extern_array_type: ValueType = copied_type(structs.extern_global_types[extern_array_index.usize()])
                                return emit_index_address(structs.extern_global_handles[extern_array_index.usize()], extern_array_type, index_expr, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                            return null
                        _:
                            pass
                    # A NESTED index (`m[i][j]`): address the inner element recursively, then
                    # index into it.
                    inner_container_type: ValueType = struct_chain_type(indexed_container, local_scope, structs)
                    if struct_chain_address(indexed_container, local_scope, fns, structs, generics, runtime, m, ctx, builder) is inner_container_address:
                        if inner_container_type.kind == TypeKind.DArray:
                            return emit_darray_index_address(inner_container_address, inner_container_type, index_expr, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                        if inner_container_type.kind == TypeKind.Array:
                            return emit_index_address(inner_container_address, inner_container_type, index_expr, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                        # A field such as `d.items` is itself a pointer-valued place. Its
                        # address is the address of the FIELD SLOT, not the address of the
                        # backing element buffer. Keep this case ahead of the generic pointer
                        # fallback below: otherwise `d.items[i] <- value` GEPs from the slot
                        # using the pointer type and stores through adjacent struct fields,
                        # which is the stage1-only Deque corruption/segfault.
                        field_ref_container: mutable bool = false
                        match indexed_container:
                            Expr.Field(field_ref_object, field_ref_name, field_ref_line):
                                field_ref_payload_probe: mutable ValueType = inner_container_type
                                field_ref_payload_probe <- optional_payload_of(field_ref_payload_probe, structs) if field_ref_payload_probe.kind == TypeKind.Optional
                                field_ref_container <- field_ref_payload_probe.kind == TypeKind.Ref
                            _:
                                pass
                        if field_ref_container:
                            field_ref_payload: mutable ValueType = inner_container_type
                            field_ref_is_optional: bool = field_ref_payload.kind == TypeKind.Optional
                            field_ref_payload <- optional_payload_of(field_ref_payload, structs) if field_ref_is_optional
                            field_ref_elem: ValueType = ref_target_of(field_ref_payload, structs)
                            null return if field_ref_elem.kind == TypeKind.Unmodeled
                            field_ref_raw: mutable LLVMValueRef = LLVMBuildLoad2(builder, LLVMPointerTypeInContext(ctx, 0), inner_container_address, "field.ref.ptr")
                            if field_ref_is_optional:
                                field_opt_llvm: LLVMTypeRef = llvm_type_of(inner_container_type, structs, ctx)
                                field_opt_value: LLVMValueRef = LLVMBuildLoad2(builder, field_opt_llvm, inner_container_address, "field.opt")
                                field_ref_raw <- optional_payload_value_of(field_opt_value, inner_container_type, structs, ctx, builder)
                            if emit_expression(index_expr, ValueType{kind: TypeKind.Unsigned, bits: 64}, local_scope, fns, structs, generics, runtime, m, ctx, builder) is field_ref_index:
                                field_ref_elem_llvm: LLVMTypeRef = llvm_type_of(field_ref_elem, structs, ctx)
                                field_ref_gep_indices: mutable darray[LLVMValueRef] = [field_ref_index]
                                field_ref_gep_pointer: void& = (&field_ref_gep_indices[0]).cast[void&] can Unsafe.PointerCast
                                return LLVMBuildGEP2(builder, field_ref_elem_llvm, field_ref_raw, field_ref_gep_pointer, 1, "field.ref.elem.ptr")
                            return null
                        # C also indexes a pointer produced from a scalar place:
                        # `&(table[0][0])[offset]`. The base address is already the
                        # address of one element, so this is a one-index GEP by the
                        # element stride rather than a fixed-array GEP.
                        if not field_ref_container and inner_container_type.kind != TypeKind.Unmodeled and inner_container_type.kind != TypeKind.Void:
                            if emit_expression(index_expr, ValueType{kind: TypeKind.Signed, bits: 64}, local_scope, fns, structs, generics, runtime, m, ctx, builder) is pointer_index:
                                pointer_indices: mutable darray[LLVMValueRef] = [pointer_index]
                                pointer_indices_pointer: void& = (&pointer_indices[0]).cast[void&] can Unsafe.PointerCast
                                return LLVMBuildGEP2(builder, llvm_type_of(inner_container_type, structs, ctx), inner_container_address, pointer_indices_pointer, 1, "pointer.index.ptr")
                    return null
                _:
                    pass
            # A reference-valued call/cast is an addressable C pointer rvalue. It has no local
            # slot for the older chain walker, but its emitted value already IS the address.
            # This covers `elisa_nonnull(p).field`, `make_item().field`, and the same shapes
            # nested under an index without inventing a temporary copy.
            rvalue_chain_type: ValueType = expression_type(object, local_scope, fns, structs, generics)
            if rvalue_chain_type.kind == TypeKind.Ref:
                if emit_expression(object, rvalue_chain_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is rvalue_chain_pointer:
                    emit_pointer_deref_guard(rvalue_chain_pointer, runtime, m, ctx, builder)
                    return rvalue_chain_pointer
            return null


        # Whether an expression threads its `expected` type down to sub-expressions rather
        # than producing a value directly. Such a form must NOT be implicitly wrapped: its
        # ARMS each wrap themselves, which is what makes `42 if flag else null` work.
        def propagates_expected(expression: Expr) -> bool can[Abort.Panic]:
            can Abort.Panic:
                return match expression:
                    Expr.If(condition, then_expression, else_expression, line): true
                    Expr.Match(scrutinee, arms, match_line): true
                    Expr.Paren(inner, paren_line): propagates_expected(inner)
                    _: false


            # Whether two expressions name the SAME assignable place — `d` and `d`, or
            # `table.name_primary` and `table.name_primary`. Syntactic and deliberately narrow:
            # only Ident roots and field chains, so it can never claim two different places are
            # one. Used to recognise the in-place reassignment form `PLACE <- PLACE.method(…)`.
        def same_assign_place(left: Expr, right: Expr) -> bool can[Abort.Panic]:
            can Abort.Panic:
                match left:
                    Expr.Ident(left_name, left_line):
                        return match right:
                            Expr.Ident(right_name, right_line): left_name == right_name
                            _: false
                    Expr.Field(left_object, left_field, left_field_line):
                        match right:
                            Expr.Field(right_object, right_field, right_field_line):
                                return false if left_field != right_field
                                return same_assign_place(left_object, right_object)
                            _:
                                return false
                    _:
                        return false


            # Whether `expression` is a `min`/`max` query — the two folds whose result is ALREADY
            # optional, because an iterable with no qualifying element has no extremum.
            #
            # The implicit optional wrap (emit_expression) re-emits at the PAYLOAD type and wraps,
            # which is right for every value form that produces a payload. min/max produce the
            # optional themselves, absence included, so they must be emitted at the optional type
            # instead — otherwise they arrive at emit_comprehension with `expected` = i64 and
            # decline. Keyed off the same line-keyed `__query` head marker the folds dispatch on.
        def comprehension_is_extremum(expression: Expr, structs: mutable StructTable&) -> bool can[Abort.Panic]:
            can Abort.Panic:
                match expression:
                    Expr.Comprehension(extremum_var, extremum_iterable, extremum_condition, extremum_body, extremum_line):
                        extremum_head: sview = query_head_for(extremum_line.line, extremum_var, structs)
                        # `first` belongs here for the same reason: it produces the optional
                        # itself (absent when nothing matches), so re-emitting at the payload type
                        # hands emit_comprehension `expected` = i64 and it declines.
                        return when extremum_head:
                            "min" | "max" | "first" -> true
                            _ -> false
                    _:
                        pass
                return false


            # Whether an expression is the `null` literal (an IDENT named "null" in the AST).
        def is_null_literal(expression: Expr) -> bool can[Abort.Panic]:
            return match expression:
                Expr.Ident(name, line): name == "null"
                _: false


        # Wrap `value` (of type `payload`) into a `T?` — `{true, value}`.
        #
        # Built through a slot rather than insertvalue: the tag and payload are two plain
        # stores, and SROA collapses it at -O2 exactly the same. An Elisa expression of
        # payload type in an optional context is implicitly wrapped — the language has no
        # `some(x)`, so this is where that happens.
        # `force_null_test` — derive the tag from `value != null` even when the payload type
        # says the reference cannot be null. A REINTERPRET (`heapptr.cast[u8&?]`) is exactly
        # that case: the payload annotation is a plain `u8&`, but the value came from a raw
        # pointer that may well be null, and a constant `true` tag would hand the program a
        # null it believes is a real reference.
        # NICHE-OPTIMIZED: an optional whose payload is a POINTER needs no separate tag,
        # because null already means absent. stage0 lowers `T&?` / `heap T&?` / `cstr?` to a
        # BARE pointer, and stage1 must too — this is not an internal choice. A `{i1, ptr}`
        # differs in SIZE, so every struct with such a field puts its later fields at
        # different offsets than the stage0-compiled runtime expects (measured: `count`
        # after a `heap T&?` sits at 8 in stage0, 16 in stage1). The bootstrap fixpoint
        # cannot see it — it only proves stage1 agrees with itself.
        # THE SWITCH. Returning true here (with the matching early return in
        # llvm_type_of) niche-optimizes optional pointers and fixes the ABI. It is ON:
        # the earlier self-host segfault this comment used to describe was resolved
        # during the 2026-08-02 struct-layout work, and both probe shapes (a struct
        # field after an optional-ref member, and an optional-ref array stride) have
        # matched stage0 since — pinned by test/repro/optional_ref_niche_layout.elisa.
        # Everything else is already routed through optional_tag_of /
        # optional_payload_value_of.
        def optional_is_niche(optional_type: ValueType, structs: mutable StructTable&) -> bool can[Abort.Panic]:
            can Abort.Panic:
                false return if optional_type.kind != TypeKind.Optional
                niche_payload: ValueType = optional_payload_of(optional_type, structs)
                return niche_payload.kind == TypeKind.Ref or niche_payload.kind == TypeKind.CStr or niche_payload.kind == TypeKind.Fn or niche_payload.kind == TypeKind.PyObject


            # The PRESENCE bit of an optional VALUE. Niche form: a null test on the pointer.
        def optional_tag_of(optional_value: LLVMValueRef, optional_type: ValueType, structs: mutable StructTable&, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic:
                if optional_is_niche(optional_type, structs):
                    return LLVMBuildICmp(builder, 33, optional_value, LLVMConstNull(LLVMPointerTypeInContext(ctx, 0)), "opt.present")
                return LLVMBuildExtractValue(builder, optional_value, 0, "opt.tag")


            # The PAYLOAD of an optional VALUE. Niche form: the value IS the payload.
        def optional_payload_value_of(optional_value: LLVMValueRef, optional_type: ValueType, structs: mutable StructTable&, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic:
                optional_value return if optional_is_niche(optional_type, structs)
                return LLVMBuildExtractValue(builder, optional_value, 1, "opt.payload")


        def wrap_optional_tagged(value: LLVMValueRef, optional_type: ValueType, force_null_test: bool, structs: mutable StructTable&, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            # Niche form: the pointer IS the optional. No tag to compute, and the
            # force_null_test / heap-ref distinction disappears with it — absence is
            # exactly null, which is what stage0 emits.
            value return if optional_is_niche(optional_type, structs)
            optional_llvm: LLVMTypeRef = llvm_type_of(optional_type, structs, ctx)
            slot: LLVMValueRef = LLVMBuildAlloca(builder, optional_llvm, "opt")
            tag_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, optional_llvm, slot, 0, "opt.tag.ptr")
            # A HEAP pointer carries its own absence: null IS the empty case, which is how
            # stage0 represents `heap T&?` (a bare `ptr`, tested with `icmp ne ptr, null`).
            # Wrapping one with a hardcoded `true` tag would report a FAILED `malloc` as
            # present and hand the program a null it believes is real. An ordinary `T&` is
            # never null, so it keeps the constant tag.
            payload_type: ValueType = optional_payload_of(optional_type, structs)
            # An opaque extern handle (`LLVMBasicBlockRef`, modeled as CStr) and a `cstr`
            # are BARE pointers whose absence is null — an extern declared `-> T?` returns
            # exactly that. A constant `true` tag turned `LLVMGetFirstBasicBlock` on a
            # body-less function into `Some(null)`, and the caller then handed null to
            # LLVMDeleteBasicBlock.
            if force_null_test or payload_type.kind == TypeKind.CStr or (payload_type.kind == TypeKind.Ref and ref_is_heap_ref(payload_type, structs)):
                null_pointer: LLVMValueRef = LLVMConstNull(LLVMPointerTypeInContext(ctx, 0))
                _ = LLVMBuildStore(builder, LLVMBuildICmp(builder, 33, value, null_pointer, "opt.present"), tag_pointer)
            else:
                _ = LLVMBuildStore(builder, LLVMConstInt(LLVMInt1TypeInContext(ctx), 1, 0), tag_pointer)
            value_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, optional_llvm, slot, 1, "opt.value.ptr")
            _ = LLVMBuildStore(builder, value, value_pointer)
            return LLVMBuildLoad2(builder, optional_llvm, slot, "opt.wrapped")


        # The ordinary wrap: the payload TYPE decides whether the tag is a null test.
        def wrap_optional(value: LLVMValueRef, optional_type: ValueType, structs: mutable StructTable&, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                return wrap_optional_tagged(value, optional_type, false, structs, ctx, builder)


            # Catch a first-class value-carrying error union. Calls have a separate lowering
            # below because their ABI is split into an i32 status plus an out pointer; locals,
            # fields, and parameters already use the stage0 descriptor `{i32 code, ptr payload}`.
        def emit_catch_error_union_value(union_value: LLVMValueRef, value_type: ValueType, catch_arms: darray[MatchArm]&, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            null return if catch_arms.count < 1
            payload_type: ValueType = error_union_payload_of(value_type, structs)
            null return if payload_type.kind == TypeKind.Unmodeled
            union_code: LLVMValueRef = LLVMBuildExtractValue(builder, union_value, 0, "catch.union.code")
            function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
            value_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "catch.union.value")
            dispatch_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "catch.union.dispatch")
            done_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "catch.union.done")
            payload_llvm: LLVMTypeRef = llvm_type_of(payload_type, structs, ctx)
            result_slot: LLVMValueRef = LLVMBuildAlloca(builder, payload_llvm, "catch.union.result")
            ok: LLVMValueRef = LLVMBuildICmp(builder, 32, union_code, LLVMConstInt(LLVMInt32TypeInContext(ctx), 0, 0), "catch.union.ok")
            _ = LLVMBuildCondBr(builder, ok, value_block, dispatch_block)

            LLVMPositionBuilderAtEnd(builder, value_block)
            success_arm: MatchArm = catch_arms[0]
            null return if arm_has_guard(success_arm.guard)
            match success_arm.pattern:
                Pattern.Binding(success_name):
                    success_payload_ptr: LLVMValueRef = LLVMBuildExtractValue(builder, union_value, 1, "catch.union.payload.ptr")
                    declare_local(local_scope, success_name, success_payload_ptr, payload_type)
                _:
                    pass
            if arm_value_expression(success_arm.body) is success_expression:
                if emit_expression(success_expression, payload_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is success_result:
                    _ = LLVMBuildStore(builder, success_result, result_slot)
                    _ = LLVMBuildBr(builder, done_block)
                else:
                    return null
            else:
                return null

            LLVMPositionBuilderAtEnd(builder, dispatch_block)
            error_arm_index: mutable usize = 1
            declined: mutable bool = false
            saw_catch_all: mutable bool = false
            while error_arm_index < catch_arms.count |error_arm_index, declined, saw_catch_all, catch_arms, union_code, payload_type, result_slot, done_block, function, local_scope, fns, structs, generics, runtime, m, ctx, builder|:
                error_arm: MatchArm = catch_arms[error_arm_index]
                error_arm_index <- error_arm_index + 1
                continue if declined or saw_catch_all
                if arm_has_guard(error_arm.guard):
                    declined <- true
                    continue
                if arm_value_expression(error_arm.body) is error_expression:
                    match error_arm.pattern:
                        Pattern.Wildcard:
                            if emit_expression(error_expression, payload_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is wildcard_result:
                                _ = LLVMBuildStore(builder, wildcard_result, result_slot)
                                _ = LLVMBuildBr(builder, done_block)
                                saw_catch_all <- true
                            else:
                                declined <- true
                            continue
                        Pattern.TypeBind(error_type_name, _):
                            if error_type_name != "error":
                                declined <- true
                                continue
                            if emit_expression(error_expression, payload_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is error_bind_result:
                                _ = LLVMBuildStore(builder, error_bind_result, result_slot)
                                _ = LLVMBuildBr(builder, done_block)
                                saw_catch_all <- true
                            else:
                                declined <- true
                            continue
                        Pattern.Variant(error_path, error_fields):
                            if error_fields.count != 0:
                                declined <- true
                                continue
                            ordinal: mutable i64 = penum_variant_index_of_path(error_path, structs)
                            if ordinal < 0:
                                ordinal <- ordinal_of_dotted_path(error_path, structs)
                            if ordinal < 0:
                                declined <- true
                                continue
                            arm_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "catch.union.arm")
                            next_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "catch.union.next")
                            hit: LLVMValueRef = LLVMBuildICmp(builder, 32, union_code, LLVMConstInt(LLVMInt32TypeInContext(ctx), (ordinal + 1).u64(), 0), "catch.union.cmp")
                            _ = LLVMBuildCondBr(builder, hit, arm_block, next_block)
                            LLVMPositionBuilderAtEnd(builder, arm_block)
                            if emit_expression(error_expression, payload_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is arm_result:
                                _ = LLVMBuildStore(builder, arm_result, result_slot)
                                _ = LLVMBuildBr(builder, done_block)
                            else:
                                declined <- true
                            LLVMPositionBuilderAtEnd(builder, next_block)
                            continue
                        _:
                            declined <- true
                else:
                    declined <- true
            null return if declined
            if not saw_catch_all:
                _ = LLVMBuildUnreachable(builder)
            LLVMPositionBuilderAtEnd(builder, done_block)
            return LLVMBuildLoad2(builder, payload_llvm, result_slot, "catch.union.value")
