# Scalar layout rules shared by EASM verification and the proof suite.
module EasmLayoutArithmetic:
    public:
        const I64_MAX: i64 = 9223372036854775807

        def declared_size(size: i64, stride: i64) -> i64:
            ensure result == (size if size > 0 else (stride if stride > 0 else 0))
            return size if size > 0 else (stride if stride > 0 else 0)

        # Return a field end only when the inputs describe a nonnegative extent and
        # the addition is representable. The subtraction guard is evaluated only
        # after offset and width are known nonnegative, so neither it nor the final
        # addition can overflow.
        def field_extent_checked(offset: i64, width: i64) -> (valid: bool, value: i64):
            ensure result.valid implies offset >= 0
            ensure result.valid implies width >= 0
            ensure result.valid implies result.value >= 0
            ensure result.valid implies result.value >= offset
            ensure not result.valid implies result.value == 0
            return (false, 0) if offset < 0 or width < 0
            return (false, 0) if width > I64_MAX - offset
            return (true, offset + width)

        def keep_larger(current: i64, candidate: i64) -> i64:
            ensure result == (candidate if candidate > current else current)
            return candidate if candidate > current else current
