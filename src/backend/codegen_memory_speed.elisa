# Speed-oriented, local proofs. No ownership ABI changes: unknown uses fall back.
extend Backend:
    private:
        def memory_speed_enabled() -> bool can[Unsafe.PointerCast]:
            if getenv("ELISA_DISABLE_MEMORY_SPEED") is value:
                return value.cast[cstr] != "1"
            return true

        # Diagnostic ablations compile the same source/compiler/runtime for paired
        # timing. These do not change language semantics or enable unsafe proofs.
        def memory_policy_enabled(policy: sview) -> bool can[Unsafe.PointerCast]:
            if policy == "helper":
                if getenv("ELISA_DISABLE_MEMORY_HELPER") is value:
                    return value.cast[cstr] != "1"
            elif policy == "reserve":
                if getenv("ELISA_DISABLE_MEMORY_RESERVE") is value:
                    return value.cast[cstr] != "1"
            elif policy == "stack":
                if getenv("ELISA_DISABLE_MEMORY_STACK") is value:
                    return value.cast[cstr] != "1"
            return true

        def memory_is_declaration(statement: Stmt) -> bool:
            return statement is Stmt.VarDecl

        def memory_scalar(value: Expr, buffer: sview, scope: mutable Scope&) -> bool can[Abort.Panic]:
            match value:
                Expr.IntLit(_, _) | Expr.BoolLit(_, _) | Expr.FloatLit(_, _):
                    return true
                Expr.Ident(name, _):
                    return name != buffer and loop_scratch_scalar_type(lookup_type(scope, name))
                Expr.Index(head, index, _):
                    if head is Expr.Ident(name, _):
                        return name == buffer and memory_scalar(index, buffer, scope)
                    return false
                Expr.Field(head, field, _):
                    if head is Expr.Ident(name, _):
                        return name == buffer and field == "count"
                    return false
                Expr.Binary(left, op, right, _):
                    return memory_scalar(left, buffer, scope) and memory_scalar(right, buffer, scope)
                Expr.Unary(op, inner, _):
                    return (op == TokenKind.Minus or op == TokenKind.Plus or op == TokenKind.Not or op == TokenKind.Tilde) and memory_scalar(inner, buffer, scope)
                Expr.Paren(inner, _):
                    return memory_scalar(inner, buffer, scope)
                Expr.If(condition, yes, no, _):
                    return memory_scalar(condition, buffer, scope) and memory_scalar(yes, buffer, scope) and memory_scalar(no, buffer, scope)
                _:
                    return false

        def memory_scope(scope: Scope&) -> Scope can[Abort.Panic, Memory.Allocate]:
            return Scope{names: [name for name in scope.names], types: [kind for kind in scope.types], slots: [], pool_names: [], group_names: [], deferred: []}

        # This proof forbids capacity/data observation, calls, aliases, address taking,
        # writes through the buffer, and all further growth. Loops only read scalars.
        def memory_read_body(body: darray[Stmt]&, buffer: sview, scope: mutable Scope&, allow_return: bool) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            for statement in body |scope|:
                match statement:
                    Stmt.VarDecl(name, kind, value, _):
                        return false if name == buffer or lookup_type(scope, name).kind != TypeKind.Unmodeled
                        return false if not scratch_scalar_annotation(kind) or not memory_scalar(value, buffer, scope)
                        scope.names.push(name)
                        scope.types.push(ValueType{kind: TypeKind.Signed, bits: 64})
                    Stmt.Assign(target, op, value, _):
                        if target is Expr.Ident(name, _):
                            return false if name == buffer or not loop_scratch_scalar_type(lookup_type(scope, name))
                            return false if not memory_scalar(value, buffer, scope)
                        else:
                            return false
                    Stmt.Return(value, _):
                        return false if not allow_return
                        if value is expression:
                            return false if not memory_scalar(expression, buffer, scope)
                        else:
                            return false
                    Stmt.If(condition, yes, no, _):
                        return false if not memory_scalar(condition, buffer, scope)
                        yes_scope: mutable Scope = memory_scope(scope)
                        no_scope: mutable Scope = memory_scope(scope)
                        return false if not memory_read_body(yes, buffer, yes_scope, allow_return) or not memory_read_body(no, buffer, no_scope, allow_return)
                    Stmt.For(binding, names, iterable, nested, _):
                        return false if binding != "" or names.count != 1 or names[0] == buffer
                        return false if lookup_type(scope, names[0]).kind != TypeKind.Unmodeled
                        valid: bool = |scope|
                            if iterable is Expr.Ident(name, _):
                                name == buffer
                            elif iterable is Expr.Binary(low, op, high, _):
                                (op == TokenKind.RangeLt or op == TokenKind.RangeLe) and memory_scalar(low, buffer, scope) and memory_scalar(high, buffer, scope)
                            else:
                                false
                        return false if not valid
                        nested_scope: mutable Scope = memory_scope(scope)
                        nested_scope.names.push(names[0])
                        nested_scope.types.push(ValueType{kind: TypeKind.Signed, bits: 64})
                        return false if not memory_read_body(nested, buffer, nested_scope, false)
                    Stmt.Expr(expression, _):
                        if expression is Expr.Block(nested, value, captures, _):
                            return false if not (value is Expr.Invalid)
                            nested_scope: mutable Scope = memory_scope(scope)
                            return false if not memory_read_body(nested, buffer, nested_scope, allow_return)
                        else:
                            return false
                    _:
                        return false
            return true

        # Capture headers are transparent statement blocks, but declarations/yields
        # in a header are not: only unwrap a single statement and an Invalid result.
        def memory_unwrap(statement: Stmt) -> Stmt can[Abort.Panic]:
            if statement is Stmt.Expr(expression, _):
                if expression is Expr.Block(nested, value, captures, _):
                    if nested.count == 1 and value is Expr.Invalid:
                        return memory_unwrap(nested[0])
            return statement

        def memory_fill_bound(statement: Stmt, buffer: sview, scope: mutable Scope&) -> Expr? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            unwrapped: Stmt = memory_unwrap(statement)
            if unwrapped is Stmt.For(binding, names, iterable, nested, pos):
                return null if binding != "" or names.count != 1 or names[0] == buffer or nested.count != 1
                return null if lookup_type(scope, names[0]).kind != TypeKind.Unmodeled
                if iterable is Expr.Binary(low, op, high, _):
                    return null if op != TokenKind.RangeLt
                    if low is Expr.IntLit(number, _):
                        return null if number != 0
                    else:
                        return null
                    if high is Expr.Ident(name, _):
                        kind: ValueType = lookup_type(scope, name)
                        return null if kind.kind != TypeKind.Signed or kind.bits != 64
                    elif high is Expr.IntLit(number, _):
                        return null if number < 0
                    else:
                        return null
                    if nested[0] is Stmt.Expr(expression, _):
                        if expression is Expr.Call(callee, args, labels, _):
                            return null if args.count != 1
                            for label in labels:
                                return null if label != ""
                            if callee is Expr.Field(head, method, _):
                                if head is Expr.Ident(name, _):
                                    return null if name != buffer or method != "push"
                                    inner: mutable Scope = memory_scope(scope)
                                    inner.names.push(names[0])
                                    inner.types.push(ValueType{kind: TypeKind.Signed, bits: 64})
                                    return high if memory_scalar(args[0], "", inner)
            return null

        def memory_buffer_type(annotation: Expr) -> bool can[Abort.Panic]:
            kind: mutable Expr = annotation
            if kind is Expr.Unary(op, inner, _):
                return false if op != TokenKind.Mutable
                kind <- inner
            if kind is Expr.Index(head, element, _):
                if head is Expr.Ident(name, _) and element is Expr.Ident(element_name, _):
                    return name == "darray" and element_name == "i64"
            return false

        def memory_buffer_bound(body: darray[Stmt]&, row: usize, scope: mutable Scope&, structs: StructTable&) -> Expr? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            if body[row] is Stmt.VarDecl(name, kind, value, pos):
                return null if not memory_buffer_type(kind) or lookup_type(scope, name).kind != TypeKind.Unmodeled
                for line in structs.local_region_lines:
                    return null if line == pos.line
                if value is Expr.Array(elements, _):
                    bound: mutable Expr = Expr.IntLit(elements.count.i64(), pos)
                    start: mutable usize = row + 1
                    if elements.count == 0:
                        return null if start >= body.count
                        if memory_fill_bound(body[start], name, scope) is fill_bound:
                            bound <- fill_bound
                            start <- start + 1
                        else:
                            return null
                    else:
                        for element in elements:
                            return null if not memory_scalar(element, "", scope)
                    rest: darray[Stmt] = [body[index] for index in start..<body.count]
                    read_scope: mutable Scope = memory_scope(scope)
                    return bound if memory_read_body(rest, name, read_scope, true)
            return null

        def memory_emit_buffer(body: darray[Stmt]&, row: usize, return_type: ValueType, scope: mutable Scope&, loops: mutable LoopStack&, regions: mutable RegionStack&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            return 0 if not memory_is_declaration(body[row])
            return 0 if not structs.memory_speed_enabled
            if memory_buffer_bound(body, row, scope, structs) is bound:
                if body[row] is Stmt.VarDecl(name, kind, value, pos):
                    if value is Expr.Array(elements, array_pos):
                        function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                        stack_count: i64 =
                            candidate: mutable i64 = 0
                            if bound is Expr.IntLit(number, _):
                                candidate <- number if number > 0 and number <= 256
                            for previous in structs.memory_stack_functions |candidate|:
                                candidate <- 0 if previous == function
                            candidate if structs.memory_stack_enabled else 0
                        return 0 if stack_count == 0 and not structs.memory_reserve_enabled
                        # Literal initialization only benefits here when placed on stack.
                        return 0 if elements.count > 0 and stack_count == 0
                        empty: Stmt = Stmt.VarDecl(name, kind, Expr.Array([], array_pos), pos)
                        return -1 if emit_statement(empty, return_type, scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder) != EmitStatus.Open
                        if lookup_slot(scope, name) is slot:
                            array_type: ValueType = lookup_type(scope, name)
                            if stack_count > 0:
                                structs.memory_stack_functions.push(function)
                                storage_type: LLVMTypeRef = LLVMArrayType(LLVMInt64TypeInContext(ctx), stack_count.u32())
                                storage: LLVMValueRef = build_entry_alloca(builder, storage_type, "memory.stack.buffer")
                                LLVMSetAlignment(storage, 8)
                                header: LLVMTypeRef = darray_llvm_type(structs, ctx)
                                data_slot: LLVMValueRef = LLVMBuildStructGEP2(builder, header, slot, 0, "memory.stack.data")
                                capacity_slot: LLVMValueRef = LLVMBuildStructGEP2(builder, header, slot, 2, "memory.stack.capacity")
                                _ = LLVMBuildStore(builder, storage, data_slot)
                                _ = LLVMBuildStore(builder, LLVMConstInt(LLVMInt64TypeInContext(ctx), stack_count.u64(), 0), capacity_slot)
                                for element in elements |scope, fns, structs, generics, runtime, m, ctx, builder|:
                                    return -1 if not emit_darray_push(slot, array_type, element, scope, fns, structs, generics, runtime, m, ctx, builder)
                                scratch_memory_report("buffer", name, pos.line, "stack placement; proven bound; at most 2048 bytes per function")
                            else:
                                if emit_expression(bound, ValueType{kind: TypeKind.Signed, bits: 64}, scope, fns, structs, generics, runtime, m, ctx, builder) is size:
                                    zero: LLVMValueRef = LLVMConstInt(LLVMInt64TypeInContext(ctx), 0, 0)
                                    positive: LLVMValueRef = LLVMBuildICmp(builder, 38, size, zero, "memory.reserve.positive")
                                    count: LLVMValueRef = LLVMBuildSelect(builder, positive, size, zero, "memory.reserve.count")
                                    return -1 if not emit_darray_reserve(slot, array_type, count, structs, runtime, m, ctx, builder)
                                    scratch_memory_report("buffer", name, pos.line, "reserve once; proven counted fill")
                                else:
                                    return -1
                            return 1
                        return -1
            return 0

        def memory_find_helper(declarations: darray[Decl]&, name: sview, owner: sview, here: sview) -> Decl? can[Abort.Panic, Memory.Allocate]:
            for declaration in declarations:
                if declaration is Decl.Func(candidate, params, result, body, effects, decorators, pos):
                    return declaration if candidate == name and owner == here
                elif declaration is Decl.Module(module_name, nested, pos):
                    if memory_find_helper(nested, name, owner, module_name) is found:
                        return found
                elif declaration is Decl.Scoped(nested, pos):
                    if memory_find_helper(nested, name, owner, here) is found:
                        return found
            return null

        # Avoid capture without renaming source locals. A collision is a fallback,
        # not an invitation to resolve a helper-local name in the caller's scope.
        def memory_names_free(body: darray[Stmt]&, result: sview, caller: mutable Scope&) -> bool can[Abort.Panic, Memory.Allocate]:
            for statement in body:
                match statement:
                    Stmt.VarDecl(name, kind, value, pos):
                        return false if name == result or name == "__memory_helper_scratch" or lookup_type(caller, name).kind != TypeKind.Unmodeled
                    Stmt.For(binding, names, iterable, nested, pos):
                        for name in names:
                            return false if name == result or name == "__memory_helper_scratch" or lookup_type(caller, name).kind != TypeKind.Unmodeled
                        return false if not memory_names_free(nested, result, caller)
                    Stmt.If(condition, yes, no, pos):
                        return false if not memory_names_free(yes, result, caller) or not memory_names_free(no, result, caller)
                    Stmt.Expr(expression, pos):
                        if expression is Expr.Block(nested, value, captures, block_pos):
                            return false if not memory_names_free(nested, result, caller)
                    _:
                        pass
            return true

        def memory_emit_helper(statement: Stmt, return_type: ValueType, scope: mutable Scope&, loops: mutable LoopStack&, regions: mutable RegionStack&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            return 0 if loops.exits.count == 0 or not memory_is_declaration(statement)
            return 0 if not structs.memory_speed_enabled or not structs.memory_helper_enabled
            return 0 if lookup_type(scope, "__memory_helper_scratch").kind != TypeKind.Unmodeled
            if statement is Stmt.VarDecl(result_name, result_kind, value, pos):
                return 0 if result_name == "_" or result_name == "__memory_helper_scratch" or lookup_type(scope, result_name).kind != TypeKind.Unmodeled
                result_type: ValueType = parameter_value_type(result_kind, structs)
                return 0 if result_type.kind != TypeKind.Signed or result_type.bits != 64
                if value is Expr.Call(callee, args, labels, call_pos):
                    name: mutable sview = ""
                    owner: mutable sview = structs.current_owner
                    if callee is Expr.Ident(callee_name, _):
                        return 0 if lookup_type(scope, callee_name).kind != TypeKind.Unmodeled
                        name <- callee_name
                    elif callee is Expr.Scope(head, callee_name, _):
                        if head is Expr.Ident(module_name, _):
                            return 0 if lookup_type(scope, module_name).kind != TypeKind.Unmodeled
                            owner <- module_name
                            name <- callee_name
                    return 0 if name == ""
                    # Templates are absent from FnTable. Count source declarations too,
                    # so a generic/non-generic name collision cannot select another body.
                    return 0 if scratch_declaration_count(structs.memory_declarations, name) != 1
                    target: i64 = scratch_unique_target(name, owner, fns)
                    return 0 if target < 0
                    row: usize = target.usize()
                    return 0 if fns.is_error[row] or fns.is_variadic[row] or fns.is_extern[row] or fns.needs_store[row]
                    return 0 if fns.returns[row].kind != TypeKind.Signed or fns.returns[row].bits != 64
                    return 0 if args.count != fns.param_count[row] or args.count > 4
                    for label in labels:
                        return 0 if label != ""
                    if memory_find_helper(structs.memory_declarations, name, owner, "") is declaration:
                        if declaration is Decl.Func(helper_name, params, result, body, effects, decorators, helper_pos):
                            return 0 if fns.lines[row] != helper_pos.line
                            return 0 if decorators.count != 0 or body.count < 3 or body.count > 8 or params.count != args.count
                            helper_scope: mutable Scope = Scope{names: [], types: [], slots: [], pool_names: [], group_names: [], deferred: []}
                            bound_params: mutable darray[Stmt] = []
                            for index in 0..<params.count |helper_scope, bound_params|:
                                parameter: ValueType = fns.param_types[fns.param_start[row] + index]
                                return 0 if parameter.kind != TypeKind.Signed or parameter.bits != 64
                                parameter_name: sview = params[index].name
                                return 0 if parameter_name == result_name or parameter_name == "__memory_helper_scratch" or lookup_type(scope, parameter_name).kind != TypeKind.Unmodeled
                                return 0 if not memory_scalar(args[index], "", scope)
                                helper_scope.names.push(parameter_name)
                                helper_scope.types.push(parameter)
                                bound_params.push(Stmt.VarDecl(parameter_name, Expr.Ident("i64", pos), args[index], pos))
                            return 0 if not memory_names_free(body, result_name, scope)
                            if memory_buffer_bound(body, 0, helper_scope, structs) is bound:
                                # A single final return is lowered to a scalar copy before reset.
                                if body[body.count - 1] is Stmt.Return(return_value, return_pos):
                                    if return_value is expression:
                                        inner: darray[Stmt] = [body[index] for index in 2..<(body.count - 1)]
                                        read_scope: mutable Scope = memory_scope(helper_scope)
                                        buffer_name: sview =
                                            if body[0] is Stmt.VarDecl(buffer, kind, initial, _):
                                                buffer
                                            else:
                                                ""
                                        return 0 if not memory_read_body(inner, buffer_name, read_scope, false)
                                        return 0 if not memory_scalar(expression, buffer_name, read_scope)
                                        # Require a counted fill, not an arbitrary second statement.
                                        return 0 if not (memory_fill_bound(body[1], buffer_name, helper_scope) is fill)
                                        output_kind: Expr = Expr.Unary(TokenKind.Mutable, Expr.Ident("i64", pos), pos)
                                        output: Stmt = Stmt.VarDecl(result_name, output_kind, Expr.IntLit(0, pos), pos)
                                        return -1 if emit_statement(output, return_type, scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder) != EmitStatus.Open
                                        expanded: mutable darray[Stmt] = [entry for entry in bound_params]
                                        for index in 0..<(body.count - 1) |expanded|:
                                            expanded.push(body[index])
                                        expanded.push(Stmt.Assign(Expr.Ident(result_name, pos), TokenKind.Assign, expression, return_pos))
                                        wrapper: Stmt = Stmt.Block("region", ["__memory_helper_scratch"], "", expanded, pos)
                                        return -1 if emit_statement(wrapper, return_type, scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder) != EmitStatus.Open
                                        scratch_memory_report("helper", name, pos.line, "inline scalar helper; reuse caller loop scratch")
                                        return 1
            return 0
