# Stage1 backend — what a `try`/`catch` needs to know about its CALLEE before lowering it:
# the base name behind a generic template, its value and parameter types, its target symbol,
# and whether it trails the caller's arena. Part of `module Backend` (see codegen.elisa).

extend Backend:
    private:


        # The index of function `owner::name` in the table, or -1.
        def function_is_error(fns: FnTable&, owner: sview, name: sview) -> bool can[Abort.Panic]:
            index: i64 = function_index_of(fns, owner, name)
            return fns.is_error[index.usize()] if index >= 0
            return false




        # A lexical function with the requested name must shield same-named error functions
        # in other owners, even when the lexical function itself is NOT fallible. Without
        # this distinction, a bare `initial()` inside WasmBrowser::Operations fell through
        # to the unique fallible `WasmBrowser::NetworkOperations::initial` found by the
        # name-only fallback. The backend then lowered the ordinary call as a zero-argument
        # error call to the network function, producing verifier-invalid LLVM IR.
        def function_is_declared(fns: FnTable&, owner: sview, name: sview) -> bool can[Abort.Panic]:
            return function_index_of(fns, owner, name) >= 0




        # `try`/`catch` accept an error callee that is a plain function OR a GENERIC template
        # (the std dict's `catch arena_dict_put(…)` / `try arena_dict_reserve(…)`). These four
        # helpers resolve, uniformly, whichever it is — a generic is inferred from its call
        # arguments and instantiated on demand (with the error ABI its is_error flag forces).
        # The simple NAME under a call's callee, looking through an explicit generic
        # instantiation: `f` -> "f", `f[T]` -> "f", `f[K, V]` -> "f". "" for any other shape.
        def generic_call_base_name(callee: Expr) -> sview can[Abort.Panic]:
            match callee:
                Expr.Ident(base_ident_name, base_ident_line):
                    return base_ident_name
                Expr.Index(base_index_head, base_index_arg, base_index_line):
                    match base_index_head:
                        Expr.Ident(base_index_name, base_index_name_line):
                            return base_index_name
                        _:
                            pass
                Expr.IndexN(base_multi_head, base_multi_args, base_multi_line):
                    match base_multi_head:
                        Expr.Ident(base_multi_name, base_multi_name_line):
                            return base_multi_name
                        _:
                            pass
                _:
                    pass
            return ""




        # A fallible callee written as a BARE name inside `module M:` is stored under owner M,
        # not at top level, so every lookup here resolved nothing and the whole body declined
        # ("call expression") — the shape the WasmBrowser SDK models and UiHandles both use.
        # Prefer the ENCLOSING module when it declares an error-returning function of this
        # name; otherwise the top-level owner, which is what these sites assumed.
        def error_callee_owner(fns: FnTable&, structs: StructTable&, name: sview, owner_hint: sview = "") -> sview can[Abort.Panic]:
            can Abort.Panic:
                # A qualifier the CALL SITE actually wrote outranks every inference below: it
                # is the only thing that can tell `WasmBrowser::Delivery::step` from
                # `WasmBrowser::Permissions::step`, which no name-based rule ever could.
                owner_hint return if owner_hint != "" and function_is_declared(fns, owner_hint, name)
                structs.current_owner return if structs.current_owner != "" and function_is_declared(fns, structs.current_owner, name)
                "" return if function_is_declared(fns, "", name)
                # A QUALIFIED callee (`try M::user(1)` from top level) arrives here as the bare
                # last segment, its module already dropped. When exactly ONE owner declares an
                # error-returning function of that name there is nothing to choose between, so
                # resolve it; anything ambiguous stays "" and declines, as before.
                unique_owner: mutable sview = ""
                owner_hits: mutable i64 = 0
                for owner_index in 0..<fns.names.count |unique_owner, owner_hits, fns, name|:
                    if fns.names[owner_index] == name and fns.is_error[owner_index]:
                        owner_hits <- owner_hits + 1
                        unique_owner <- fns.owners[owner_index]
                return unique_owner if owner_hits == 1 else ""


        # A QUALIFIED try callee (`try Mods::B::step(x)`) reaches the try emitters as a Scope,
        # and every one of their arms matches `Expr.Ident` only. Present its last segment only
        # when try_callee_owner confirms that exact qualified function is fallible. Dropping the
        # owner first and asking error_callee_owner to guess is unsound: a same-named fallible
        # function in an unrelated module can capture an ordinary call (`Application::initialize`
        # must stay ordinary when `RenderScene::initialize` is fallible).
        def try_callee_as_ident(callee: Expr, fns: FnTable&, structs: StructTable&) -> Expr can[Abort.Panic]:
            can Abort.Panic:
                match callee:
                    Expr.Scope(scope_base, scope_name, scope_pos):
                        return (Expr.Ident(scope_name, scope_pos)) if try_callee_owner(callee, fns, structs) != ""
                        return callee
                    _:
                        return callee


        # The registered owner a QUALIFIED try callee names. A module declared with a
        # qualified name is registered VERBATIM ("A::B"), while its USE nests Scope inside
        # Scope, so the two parts are matched against the recorded names rather than joined
        # (the rule codegen_call_receiver already uses for ordinary calls).
        def try_callee_owner(callee: Expr, fns: FnTable&, structs: StructTable&) -> sview can[Abort.Panic]:
            can Abort.Panic:
                match callee:
                    Expr.Scope(scope_base, scope_name, scope_pos):
                        match scope_base:
                            Expr.Ident(single_root, single_root_pos):
                                single_owner: mutable sview = module_alias_target(single_root, structs)
                                # A declared module is already its own owner. The alias
                                # table is populated only for imported aliases, so an empty
                                # lookup must fall back to the source qualifier. Without this
                                # fallback, a qualified catch such as
                                # `catch InspectorView::set_value(...)` loses its owner and
                                # becomes ambiguous when another module exports `set_value`.
                                single_owner <- single_root if single_owner == ""
                                return single_owner if function_is_error(fns, single_owner, scope_name)
                                for relative_owner in fns.owners:
                                    if qualified_owner_matches(relative_owner, structs.current_owner, single_owner):
                                        return relative_owner if function_is_error(fns, relative_owner, scope_name)
                            Expr.Scope(nested_base, nested_mid, nested_pos):
                                match nested_base:
                                    Expr.Ident(nested_root, nested_root_pos):
                                        if qualified_owner_of(fns, nested_root, nested_mid) is nested_owner:
                                            return nested_owner if function_is_error(fns, nested_owner, scope_name)
                                        return ""
                                    _:
                                        return ""
                            _:
                                return ""
                    _:
                        return ""
                return ""


        def error_callee_is(fns: FnTable&, structs: StructTable&, generics: GenericTable&, name: sview, owner_hint: sview = "") -> bool can[Abort.Panic]:
            can Abort.Panic:
                true return if function_is_error(fns, error_callee_owner(fns, structs, name, owner_hint), name)
                generic_index: i64 = generic_index_of(generics, name)
                return generic_index >= 0 and generics.is_error[generic_index.usize()]




        def error_callee_value_type(name: sview, arguments: darray[Expr]&, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, owner_hint: sview = "") -> ValueType can[Abort.Panic, Memory.Allocate]:
            lookup_return_type(fns, error_callee_owner(fns, structs, name, owner_hint), name) return if function_is_error(fns, error_callee_owner(fns, structs, name, owner_hint), name)
            generic_index: i64 = generic_index_of(generics, name)
            unmodeled_type() return if generic_index < 0
            # The inferred type-arg darray is scratch: hold it in an explicit region (the
            # helper is otherwise too small for auto-region inference to place it). The
            # result is a POD ValueType, so it escapes the region cleanly.
            # infer_generic_args is region-polymorphic, so stage0 REQUIRES the explicit
            # region -- but the resolver called with the result must run OUTSIDE it: it
            # pushes into the persistent structs/generics tables, and growth threaded to a
            # block-scoped region is freed with the block (the use-after-free that crashed
            # every propagating `try` to a generic). The copy-out is deliberately SCALAR
            # STORES into pre-declared slots -- plain memory writes, no container growth --
            # so it stays correct even under a compiler that mis-threads in-block growth
            # (the bootstrap seed this fix must survive being compiled by).
            inferred_count: mutable usize = 0
            inferred_slot0: mutable ValueType = unmodeled_type()
            inferred_slot1: mutable ValueType = unmodeled_type()
            inferred_slot2: mutable ValueType = unmodeled_type()
            inferred_slot3: mutable ValueType = unmodeled_type()
            region scratch(4096):
                inferred: darray[ValueType] = infer_generic_args(generic_index.usize(), arguments, local_scope, fns, structs, generics)
                inferred_count <- inferred.count
                inferred_slot0 <- copied_type(inferred[0]) if inferred.count > 0.usize()
                inferred_slot1 <- copied_type(inferred[1]) if inferred.count > 1.usize()
                inferred_slot2 <- copied_type(inferred[2]) if inferred.count > 2.usize()
                inferred_slot3 <- copied_type(inferred[3]) if inferred.count > 3.usize()
            unmodeled_type() return if inferred_count > 4.usize() or inferred_count != generics.param_count[generic_index.usize()]
            inferred_args: mutable darray[ValueType] = []
            inferred_args.push(inferred_slot0) if inferred_count > 0.usize()
            inferred_args.push(inferred_slot1) if inferred_count > 1.usize()
            inferred_args.push(inferred_slot2) if inferred_count > 2.usize()
            inferred_args.push(inferred_slot3) if inferred_count > 3.usize()
            inferred_error_family: sview = infer_generic_error_family(generic_index.usize(), arguments, local_scope, fns, structs, generics)
            unmodeled_type() return if generic_error_param_at(generics, generic_index.usize()) != "" and inferred_error_family == ""
            return generic_return_type(name, inferred_args, generics, structs)




        def error_callee_target(name: sview, arguments: darray[Expr]&, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, m: LLVMModuleRef, ctx: LLVMContextRef, owner_hint: sview = "") -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            if function_is_error(fns, error_callee_owner(fns, structs, name, owner_hint), name):
                return lookup_function(fns, error_callee_owner(fns, structs, name, owner_hint), name)
            generic_index: i64 = generic_index_of(generics, name)
            null return if generic_index < 0
            # Same scalar copy-out as error_callee_value_type (see the comment there).
            inferred_count: mutable usize = 0
            inferred_slot0: mutable ValueType = unmodeled_type()
            inferred_slot1: mutable ValueType = unmodeled_type()
            inferred_slot2: mutable ValueType = unmodeled_type()
            inferred_slot3: mutable ValueType = unmodeled_type()
            region scratch(4096):
                inferred: darray[ValueType] = infer_generic_args(generic_index.usize(), arguments, local_scope, fns, structs, generics)
                inferred_count <- inferred.count
                inferred_slot0 <- copied_type(inferred[0]) if inferred.count > 0.usize()
                inferred_slot1 <- copied_type(inferred[1]) if inferred.count > 1.usize()
                inferred_slot2 <- copied_type(inferred[2]) if inferred.count > 2.usize()
                inferred_slot3 <- copied_type(inferred[3]) if inferred.count > 3.usize()
            null return if inferred_count > 4.usize() or inferred_count != generics.param_count[generic_index.usize()]
            inferred_args: mutable darray[ValueType] = []
            inferred_args.push(inferred_slot0) if inferred_count > 0.usize()
            inferred_args.push(inferred_slot1) if inferred_count > 1.usize()
            inferred_args.push(inferred_slot2) if inferred_count > 2.usize()
            inferred_args.push(inferred_slot3) if inferred_count > 3.usize()
            inferred_error_family: sview = infer_generic_error_family(generic_index.usize(), arguments, local_scope, fns, structs, generics)
            null return if generic_error_param_at(generics, generic_index.usize()) != "" and inferred_error_family == ""
            return instantiate_generic_with_error_family(name, inferred_args, inferred_error_family, generics, structs, m, ctx)




        # Number of caller-region slots the error callee trails. Error calls are lowered by
        # hand (around the hidden out slot), so they must mirror the complete declaration ABI;
        # a boolean is insufficient for functions that grow more than one reference-backed
        # argument. `graph_dfs` is the concrete case: its two mutable darray references each
        # carry a region slot in addition to the payload family's arena.
        #
        # A generic error fn's instantiation can want an arena (`arena_dict_put[K, T]` grows the
        # bucket array), and every call site has to pass one or the callee reads its arena out of
        # a register that was never set. The `catch f(a, …)` / `try f(a, …)` paths build their own
        # argument list around the out-param slot, so they cannot inherit emit_generic_call's push.
        def error_callee_arena_count(name: sview, arguments: darray[Expr]&, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, owner_hint: sview = "") -> usize can[Abort.Panic, Memory.Allocate]:
            # A non-generic error fn's count is already recorded in the FnTable.
            if function_is_error(fns, error_callee_owner(fns, structs, name, owner_hint), name):
                arena_fn_index: i64 = function_index_of(fns, error_callee_owner(fns, structs, name, owner_hint), name)
                0.usize() return if arena_fn_index < 0
                return fns.arena_counts[arena_fn_index.usize()]
            generic_index: i64 = generic_index_of(generics, name)
            0.usize() return if generic_index < 0
            # Same scalar copy-out as error_callee_value_type (see the comment there).
            inferred_count: mutable usize = 0
            inferred_slot0: mutable ValueType = unmodeled_type()
            inferred_slot1: mutable ValueType = unmodeled_type()
            inferred_slot2: mutable ValueType = unmodeled_type()
            inferred_slot3: mutable ValueType = unmodeled_type()
            region scratch(4096):
                inferred: darray[ValueType] = infer_generic_args(generic_index.usize(), arguments, local_scope, fns, structs, generics)
                inferred_count <- inferred.count
                inferred_slot0 <- copied_type(inferred[0]) if inferred.count > 0.usize()
                inferred_slot1 <- copied_type(inferred[1]) if inferred.count > 1.usize()
                inferred_slot2 <- copied_type(inferred[2]) if inferred.count > 2.usize()
                inferred_slot3 <- copied_type(inferred[3]) if inferred.count > 3.usize()
            0.usize() return if inferred_count > 4.usize() or inferred_count != generics.param_count[generic_index.usize()]
            inferred_args: mutable darray[ValueType] = []
            inferred_args.push(inferred_slot0) if inferred_count > 0.usize()
            inferred_args.push(inferred_slot1) if inferred_count > 1.usize()
            inferred_args.push(inferred_slot2) if inferred_count > 2.usize()
            inferred_args.push(inferred_slot3) if inferred_count > 3.usize()
            inferred_error_family: sview = infer_generic_error_family(generic_index.usize(), arguments, local_scope, fns, structs, generics)
            0.usize() return if generic_error_param_at(generics, generic_index.usize()) != "" and inferred_error_family == ""
            return 1.usize() if instantiation_wants_arena(name, inferred_args, generics, structs)
            return 0.usize()




        # Compatibility predicate for callers that only need to know whether at least one
        # caller-region slot exists. New ABI-sensitive paths should use the count above.
        def error_callee_wants_arena(name: sview, arguments: darray[Expr]&, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, owner_hint: sview = "") -> bool can[Abort.Panic, Memory.Allocate]:
            return error_callee_arena_count(name, arguments, local_scope, fns, structs, generics, owner_hint) > 0.usize()




        def error_callee_param_type(name: sview, arguments: darray[Expr]&, position: usize, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, owner_hint: sview = "") -> ValueType can[Abort.Panic, Memory.Allocate]:
            param_type_of(fns, error_callee_owner(fns, structs, name, owner_hint), name, position) return if function_is_error(fns, error_callee_owner(fns, structs, name, owner_hint), name)
            generic_index: i64 = generic_index_of(generics, name)
            unmodeled_type() return if generic_index < 0
            # Same scalar copy-out as error_callee_value_type (see the comment there).
            inferred_count: mutable usize = 0
            inferred_slot0: mutable ValueType = unmodeled_type()
            inferred_slot1: mutable ValueType = unmodeled_type()
            inferred_slot2: mutable ValueType = unmodeled_type()
            inferred_slot3: mutable ValueType = unmodeled_type()
            region scratch(4096):
                inferred: darray[ValueType] = infer_generic_args(generic_index.usize(), arguments, local_scope, fns, structs, generics)
                inferred_count <- inferred.count
                inferred_slot0 <- copied_type(inferred[0]) if inferred.count > 0.usize()
                inferred_slot1 <- copied_type(inferred[1]) if inferred.count > 1.usize()
                inferred_slot2 <- copied_type(inferred[2]) if inferred.count > 2.usize()
                inferred_slot3 <- copied_type(inferred[3]) if inferred.count > 3.usize()
            unmodeled_type() return if inferred_count > 4.usize() or inferred_count != generics.param_count[generic_index.usize()]
            inferred_args: mutable darray[ValueType] = []
            inferred_args.push(inferred_slot0) if inferred_count > 0.usize()
            inferred_args.push(inferred_slot1) if inferred_count > 1.usize()
            inferred_args.push(inferred_slot2) if inferred_count > 2.usize()
            inferred_args.push(inferred_slot3) if inferred_count > 3.usize()
            inferred_error_family: sview = infer_generic_error_family(generic_index.usize(), arguments, local_scope, fns, structs, generics)
            unmodeled_type() return if generic_error_param_at(generics, generic_index.usize()) != "" and inferred_error_family == ""
            return instantiation_param_type(name, inferred_args, position, generics, structs)
