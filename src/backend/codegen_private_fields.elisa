# The semantic pass diagnoses source access; this lowering guard also covers
# types resolved only after generic substitution. Neither changes runtime layout.
extend Backend:
    private:
        def register_private_fields(declarations: darray[Decl]&, owner: sview, structs: mutable StructTable&) -> void can[Abort.Panic, Memory.Allocate]:
            for declaration in declarations |structs|:
                match declaration:
                    Decl.Struct(name, members, _, _, _, _, _):
                        for member in members |structs|:
                            if member.is_private:
                                structs.visibility.private_type_names.push(name)
                                structs.visibility.private_type_owners.push(owner)
                                structs.visibility.private_member_names.push(member.name)
                    Decl.Module(name, body, _):
                        register_private_fields(body, name, structs)
                    Decl.Scoped(body, _):
                        register_private_fields(body, owner, structs)
                    _:
                        pass

        def private_field_scope_allows(current: sview, owner: sview) -> bool can[Abort.Panic]:
            true return if current == owner
            length: usize = sview_len(owner)
            false return if length == 0 or sview_len(current) <= length + 2
            for index in 0..<length:
                false return if sview_at(current, index) != sview_at(owner, index)
            return sview_at(current, length) == 58 and sview_at(current, length + 1) == 58

        def check_lowered_private_field(receiver: ValueType, field: sview, line: u32, structs: mutable StructTable&) -> void can[Abort.Panic, Memory.Allocate]:
            return if structs.visibility.private_member_names.count == 0
            concrete: mutable ValueType = receiver
            concrete <- ref_target_of(concrete, structs) if concrete.kind == TypeKind.Ref
            concrete <- optional_payload_of(concrete, structs) if concrete.kind == TypeKind.Optional
            concrete <- ref_target_of(concrete, structs) if concrete.kind == TypeKind.Ref
            return if concrete.kind != TypeKind.Struct
            slot: usize = concrete.bits.usize()
            return if slot >= structs.records.names.count
            is_generic: bool = any instance in structs.generics.generic_struct_inst_index where instance == slot
            for index in 0..<structs.visibility.private_type_names.count |structs|:
                continue if structs.records.names[slot] != structs.visibility.private_type_names[index]
                continue if field != "" and field != structs.visibility.private_member_names[index]
                owner: sview = structs.visibility.private_type_owners[index]
                # Generic instances have the declaration's base name and an empty
                # backend owner. Ordinary struct slots retain exact module identity.
                continue if structs.records.owners[slot] != owner and not is_generic
                continue if private_field_scope_allows(structs.visibility.current_owner, owner)
                structs.visibility.private_violation_line <- line
                structs.visibility.private_violation_member <- structs.visibility.private_member_names[index]

        # Zeroing an aggregate initializes its storage just like a brace literal.
        # Pointer and empty dynamic-container values do not initialize their targets.
        def check_private_zeroed_type(value: ValueType, line: u32, structs: mutable StructTable&) -> void can[Abort.Panic, Memory.Allocate]:
            return if structs.visibility.private_member_names.count == 0
            if value.kind == TypeKind.Array:
                check_private_zeroed_type(array_element_of(value, structs), line, structs)
            elif value.kind == TypeKind.Struct:
                check_lowered_private_field(value, "", line, structs)
                slot: usize = value.bits.usize()
                for index in 0..<structs.records.field_count[slot] |structs|:
                    member_type: ValueType = copied_type(structs.records.field_types[structs.records.field_start[slot] + index])
                    check_private_zeroed_type(member_type, line, structs)
