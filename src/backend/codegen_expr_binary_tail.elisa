# Stage1 backend — `emit_expression`: the remaining binary operators.
# A group of the expression emitter's branches, called from codegen_expression.elisa.
# `handled` is set TRUE on entry and cleared only if no branch here matched, so a
# branch that DECLINES (returns null) still stops the dispatch — exactly as it did
# when every branch shared one function body.

extend Backend:
    private:
        # POINTER-LIKE for the purposes of `==`/`!=`: a reference, or an optional whose
        # payload is one. Deliberately NOT an optional of a value type — see the comparison
        # site for why comparing those payloads would be wrong rather than declined.
        def ref_eq_is_pointer_like(operand_type: ValueType, structs: mutable StructTable&) -> bool can[Abort.Panic]:
            can Abort.Panic:
                true return if operand_type.kind == TypeKind.Ref
                # An opaque HANDLE (LLVMValueRef et al., modeled CStr with the bits-1 marker):
                # `==` asks whether two handles are the SAME object, never whether the objects
                # they point at happen to hold equal bytes. Without this the reconciliation's
                # `reuse_owner_handle == fns.handles[i]` compiled to ctx_streq over two
                # llvm::Function objects -- which start with the same bytes -- so every library
                # build "matched" the wrong handle. A REAL cstr (bits 0) keeps content compare.
                true return if operand_type.kind == TypeKind.CStr and operand_type.bits != 0
                false return if operand_type.kind != TypeKind.Optional
                return optional_payload_of(operand_type, structs).kind == TypeKind.Ref


            # The raw pointer behind a pointer-like operand: a reference IS one; an optional
            # carries it in payload field 1 of its `{i1, ptr}`.
        def ref_eq_pointer_value(operand: Expr, operand_type: ValueType, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                if emit_expression(operand, operand_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is operand_value:
                    operand_value return if operand_type.kind == TypeKind.Ref
                    # A marked handle is already the raw pointer value.
                    operand_value return if operand_type.kind == TypeKind.CStr
                    return optional_payload_value_of(operand_value, operand_type, structs, ctx, builder)
                return null


        # The protocol dunder method name for a struct-operand binary operator, or "" for
        # any operator with no 1:1 struct-dispatchable protocol method (the four ordering
        # operators derive from `Ord`'s single `__cmp__` instead — see
        # struct_binary_operator_is_ordering).
        def struct_binary_operator_dunder(op: TokenKind) -> sview:
            if op == TokenKind.Plus: return "__add__"
            if op == TokenKind.Minus: return "__sub__"
            if op == TokenKind.Star: return "__mul__"
            if op == TokenKind.Slash: return "__div__"
            if op == TokenKind.EqEq: return "__eq__"
            if op == TokenKind.BangEq: return "__eq__"
            return ""


        # Whether OP is one of the four ordering operators, all derived from `Ord`'s single
        # `__cmp__(self, other) -> i64` (returns <0/0/>0) rather than a 1:1 dunder.
        def struct_binary_operator_is_ordering(op: TokenKind) -> bool:
            return when op:
                TokenKind.Lt | TokenKind.LtEq | TokenKind.Gt | TokenKind.GtEq -> true
                _ -> false


        def emit_expression_binary_tail(expression: Expr, expected: ValueType, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef, handled: mutable bool&) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            handled <- true
            match expression:
                Expr.Binary(binary_left, binary_operator, binary_right, binary_line):
                    # `and`/`or` SHORT-CIRCUIT: the right side must only be emitted on the path
                    # that reaches it, so they cannot go through emit_binary.
                    if binary_operator == TokenKind.And or binary_operator == TokenKind.Or:
                        return emit_short_circuit(binary_left, binary_operator, binary_right, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                    # The OPERANDS' type is not the result type: `a < b` yields bool but must
                    # compare at a's type. Take whichever side is known; a literal defers.
                    operand_type: mutable ValueType = expression_type(binary_left, local_scope, fns, structs, generics)
                    if operand_type.kind == TypeKind.Unmodeled:
                        operand_type <- expression_type(binary_right, local_scope, fns, structs, generics)
                    if operand_type.kind == TypeKind.Unmodeled:
                        # Both sides are literals (`2 + 3`): fall back to the context, which
                        # for a comparison is bool — so use i64 there.
                        operand_type <- expected if is_numeric_type(expected) else ValueType{kind: TypeKind.Signed, bits: 64}
                    # STRUCT operand with a matching `impl Add/Sub/Mul/Div/Eq for T` — rewrite to
                    # the equivalent explicit method call (`left.__add__(right)`, …) and let the
                    # EXISTING UFCS/impl-method call machinery resolve and emit it, rather than
                    # building a second dispatch mechanism. `!=` has no protocol of its own
                    # (only `Eq`'s `__eq__` is declared), so it calls `__eq__` and negates the
                    # bool result, matching how the language derives it everywhere else.
                    # STRUCT ordering (`<`/`>`/`<=`/`>=`) with a matching `impl Ord for T` — all
                    # four derive from the single `__cmp__(self, other) -> i64` (<0/0/>0), so
                    # rewrite to `left.__cmp__(right)` and compare THAT i64 result against 0
                    # with the ordinary integer predicate, rather than a 1:1 method substitution.
                    if operand_type.kind == TypeKind.Struct and struct_binary_operator_is_ordering(binary_operator):
                        struct_cmp_call: Expr = Expr.Call(Expr.Field(binary_left, "__cmp__", binary_line), [binary_right], [""], binary_line)
                        if emit_expression(struct_cmp_call, ValueType{kind: TypeKind.Signed, bits: 64}, local_scope, fns, structs, generics, runtime, m, ctx, builder) is struct_cmp_value:
                            struct_cmp_zero: LLVMValueRef = LLVMConstInt(LLVMInt64TypeInContext(ctx), 0, 0)
                            struct_cmp_result: LLVMValueRef = LLVMBuildICmp(builder, int_predicate_of(binary_operator), struct_cmp_value, struct_cmp_zero, "struct.cmp")
                            return emit_conversion(struct_cmp_result, ValueType{kind: TypeKind.Bool, bits: 1}, expected, structs, ctx, builder) if expected.kind != TypeKind.Unmodeled and (expected.kind != TypeKind.Bool or expected.bits != 1) else struct_cmp_result
                        return null
                    struct_op_dunder: sview = struct_binary_operator_dunder(binary_operator)
                    if operand_type.kind == TypeKind.Struct and struct_op_dunder != "":
                        struct_op_call: Expr = Expr.Call(Expr.Field(binary_left, struct_op_dunder, binary_line), [binary_right], [""], binary_line)
                        if binary_operator == TokenKind.BangEq:
                            if emit_expression(struct_op_call, ValueType{kind: TypeKind.Bool, bits: 1}, local_scope, fns, structs, generics, runtime, m, ctx, builder) is struct_eq_value:
                                struct_ne_value: LLVMValueRef = LLVMBuildXor(builder, struct_eq_value, LLVMConstInt(LLVMInt1TypeInContext(ctx), 1, 0), "struct.ne")
                                return emit_conversion(struct_ne_value, ValueType{kind: TypeKind.Bool, bits: 1}, expected, structs, ctx, builder) if expected.kind != TypeKind.Unmodeled and (expected.kind != TypeKind.Bool or expected.bits != 1) else struct_ne_value
                            return null
                        if emit_expression(struct_op_call, expected, local_scope, fns, structs, generics, runtime, m, ctx, builder) is struct_op_value:
                            return struct_op_value
                        return null
                    # `heap T& + int` / `- int` — RAW-pointer arithmetic: advance by `int` elements
                    # of T (a GEP at T's stride). The heap flag (not the kind) distinguishes this
                    # from a SAFE `T&`, which value-adds below. The arena allocator (arena.elisa)
                    # walks its backing store as `heap u8&`. A void pointee strides by bytes (i8).
                    if ref_is_heap_ref(operand_type, structs) and (binary_operator == TokenKind.Plus or binary_operator == TokenKind.Minus):
                        heap_ptr_pointee: ValueType = ref_target_of(operand_type, structs)
                        heap_ptr_stride: LLVMTypeRef = LLVMInt8TypeInContext(ctx) if heap_ptr_pointee.kind == TypeKind.Void else llvm_type_of(heap_ptr_pointee, structs, ctx)
                        if emit_expression(binary_left, operand_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is heap_ptr_base:
                            if emit_expression(binary_right, ValueType{kind: TypeKind.Signed, bits: 64}, local_scope, fns, structs, generics, runtime, m, ctx, builder) is heap_ptr_offset:
                                heap_ptr_index: LLVMValueRef = heap_ptr_offset if binary_operator == TokenKind.Plus else LLVMBuildNeg(builder, heap_ptr_offset, "heap.ptr.neg")
                                heap_ptr_indices: mutable darray[LLVMValueRef] = [heap_ptr_index]
                                heap_ptr_indices_pointer: void& = (&heap_ptr_indices[0]).cast[void&] can Unsafe.PointerCast
                                return LLVMBuildGEP2(builder, heap_ptr_stride, heap_ptr_base, heap_ptr_indices_pointer, 1, "heap.ptr.arith")
                            return null
                        return null
                    # `ptr + int` / `ptr - int` on a BYTE pointer — `void&` or `u8&` — is pointer
                    # arithmetic (a GEP over i8), NOT a deref-then-add. The std's
                    # collections_void_from_data_at walks raw bytes as `data.cast[u8&] + offset`,
                    # and a `u8& + i8` emitted as an integer `add` is invalid IR that llc rejects
                    # outright (it also truncated the offset to i8, silently capping it at 255).
                    #
                    # `u8&` and `void&` ONLY — verified against stage0 across referents: u8 GEPs,
                    # while i8/u16/i32/u64/f64 all dereference and value-add. `u8&` is stage0's
                    # designated raw-byte-pointer type, and the asymmetry with `i8&` is deliberate,
                    # so this cannot be generalized to "any small integer referent".
                    byte_ptr_target: ValueType = ref_target_of(operand_type, structs)
                    is_byte_pointer: bool = byte_ptr_target.kind == TypeKind.Void or (byte_ptr_target.kind == TypeKind.Unsigned and byte_ptr_target.bits == 8)
                    if operand_type.kind == TypeKind.Ref and is_byte_pointer and (binary_operator == TokenKind.Plus or binary_operator == TokenKind.Minus):
                        if emit_expression(binary_left, operand_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is ptr_arith_base:
                            if emit_expression(binary_right, ValueType{kind: TypeKind.Signed, bits: 64}, local_scope, fns, structs, generics, runtime, m, ctx, builder) is ptr_arith_offset:
                                ptr_arith_index: LLVMValueRef = ptr_arith_offset if binary_operator == TokenKind.Plus else LLVMBuildNeg(builder, ptr_arith_offset, "ptr.neg")
                                ptr_arith_indices: mutable darray[LLVMValueRef] = [ptr_arith_index]
                                ptr_arith_indices_pointer: void& = (&ptr_arith_indices[0]).cast[void&] can Unsafe.PointerCast
                                return LLVMBuildGEP2(builder, LLVMInt8TypeInContext(ctx), ptr_arith_base, ptr_arith_indices_pointer, 1, "ptr.arith")
                            return null
                        return null
                    # C pointers into the same allocation may also be ordered (`p < end`,
                    # `cursor >= limit`). Elisa references are represented as LLVM pointers;
                    # compare their raw addresses with the unsigned pointer predicates instead
                    # of trying to dereference them as numeric values. This is the relational
                    # counterpart of the identity comparison below and applies equally to a
                    # plain reference and an optional reference after its payload is extracted.
                    if binary_operator == TokenKind.Lt or binary_operator == TokenKind.LtEq or binary_operator == TokenKind.Gt or binary_operator == TokenKind.GtEq:
                        ref_order_left_type: ValueType = expression_type(binary_left, local_scope, fns, structs, generics)
                        ref_order_right_type: ValueType = expression_type(binary_right, local_scope, fns, structs, generics)
                        if ref_eq_is_pointer_like(ref_order_left_type, structs) and ref_eq_is_pointer_like(ref_order_right_type, structs):
                            if ref_eq_pointer_value(binary_left, ref_order_left_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is ref_order_left_pointer:
                                if ref_eq_pointer_value(binary_right, ref_order_right_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is ref_order_right_pointer:
                                    ref_order_value: LLVMValueRef = LLVMBuildICmp(builder, int_predicate_of(binary_operator), ref_order_left_pointer, ref_order_right_pointer, "refcmp.order")
                                    ref_order_result: ValueType = ValueType{kind: TypeKind.Bool, bits: 1}
                                    return emit_conversion(ref_order_value, ref_order_result, expected, structs, ctx, builder) if expected.kind != TypeKind.Unmodeled and (expected.kind != ref_order_result.kind or expected.bits != ref_order_result.bits) else ref_order_value
                                return null
                            return null
                    # `p == q` / `p != q` on two REFERENCES is ADDRESS IDENTITY, not a compare of
                    # the pointees — `arena == &perm_arena` asks whether this IS the permanent
                    # arena. Verified against stage0 rather than assumed, because a ref operand
                    # otherwise auto-dereferences (below): two `i64&` holding an equal VALUE at
                    # different addresses answer 0, and the same address answers 1. So the rule
                    # holds for a scalar referent too, not just a struct one.
                    #
                    # Placed BEFORE the deref, and scoped to Ref on BOTH sides: `cstr == cstr` is
                    # a CONTENT compare (see below), and `null` comparisons are handled earlier.
                    if binary_operator == TokenKind.EqEq or binary_operator == TokenKind.BangEq:
                        ref_eq_left_type: ValueType = expression_type(binary_left, local_scope, fns, structs, generics)
                        ref_eq_right_type: ValueType = expression_type(binary_right, local_scope, fns, structs, generics)
                        left_fn_like: bool = ref_eq_left_type.kind == TypeKind.Fn or (ref_eq_left_type.kind == TypeKind.Optional and optional_payload_of(ref_eq_left_type, structs).kind == TypeKind.Fn)
                        right_fn_like: bool = ref_eq_right_type.kind == TypeKind.Fn or (ref_eq_right_type.kind == TypeKind.Optional and optional_payload_of(ref_eq_right_type, structs).kind == TypeKind.Fn)
                        # Function values and optional function values share the
                        # pointer-niche representation. C callback-hook setup
                        # compares these addresses to select a compatible
                        # reallocator; lower that identity comparison directly.
                        # `null` deliberately has no standalone type, however, so a
                        # callback guard such as `if callback != null` arrives with one
                        # Fn operand and one Unmodeled operand. Treat the null side as
                        # the known callback type for this pointer comparison; passing
                        # Unmodeled to emit_expression would otherwise decline the
                        # otherwise ordinary C callback guard.
                        if left_fn_like and is_null_literal(binary_right):
                            if emit_expression(binary_left, ref_eq_left_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is fn_null_left:
                                if emit_expression(binary_right, ref_eq_left_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is fn_null_right:
                                    fn_null_value: LLVMValueRef = LLVMBuildICmp(builder, int_predicate_of(binary_operator), fn_null_left, fn_null_right, "fncmp.null")
                                    fn_null_result: ValueType = ValueType{kind: TypeKind.Bool, bits: 1}
                                    return emit_conversion(fn_null_value, fn_null_result, expected, structs, ctx, builder) if expected.kind != TypeKind.Unmodeled and (expected.kind != fn_null_result.kind or expected.bits != fn_null_result.bits) else fn_null_value
                                return null
                            return null
                        if right_fn_like and is_null_literal(binary_left):
                            if emit_expression(binary_left, ref_eq_right_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is fn_null_left:
                                if emit_expression(binary_right, ref_eq_right_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is fn_null_right:
                                    fn_null_value: LLVMValueRef = LLVMBuildICmp(builder, int_predicate_of(binary_operator), fn_null_left, fn_null_right, "fncmp.null")
                                    fn_null_result: ValueType = ValueType{kind: TypeKind.Bool, bits: 1}
                                    return emit_conversion(fn_null_value, fn_null_result, expected, structs, ctx, builder) if expected.kind != TypeKind.Unmodeled and (expected.kind != fn_null_result.kind or expected.bits != fn_null_result.bits) else fn_null_value
                                return null
                            return null
                        if left_fn_like and right_fn_like:
                            if emit_expression(binary_left, ref_eq_left_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is fn_eq_left:
                                if emit_expression(binary_right, ref_eq_right_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is fn_eq_right:
                                    fn_eq_value: LLVMValueRef = LLVMBuildICmp(builder, int_predicate_of(binary_operator), fn_eq_left, fn_eq_right, "fncmp.ptr")
                                    fn_eq_result: ValueType = ValueType{kind: TypeKind.Bool, bits: 1}
                                    return emit_conversion(fn_eq_value, fn_eq_result, expected, structs, ctx, builder) if expected.kind != TypeKind.Unmodeled and (expected.kind != fn_eq_result.kind or expected.bits != fn_eq_result.bits) else fn_eq_value
                                return null
                            return null
                        # An OPTIONAL ref counts as pointer-like on either side: the arena walks
                        # its region list with `while current != null and current != region`,
                        # comparing a `heap Region&?` cursor against a plain `heap Region&`.
                        # stage0 compares bare pointers there (it niche-optimizes an optional
                        # pointer), so comparing stage1's payload pointer matches it — a VALUE
                        # comparison, with no layout crossing a compilation boundary.
                        #
                        # Scoped to an optional whose PAYLOAD IS A REF: on an `i64?` the payload
                        # is a number, and comparing payloads while ignoring the tags would be
                        # wrong rather than merely declined.
                        if ref_eq_is_pointer_like(ref_eq_left_type, structs) and ref_eq_is_pointer_like(ref_eq_right_type, structs):
                            if ref_eq_pointer_value(binary_left, ref_eq_left_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is ref_eq_left_pointer:
                                if ref_eq_pointer_value(binary_right, ref_eq_right_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is ref_eq_right_pointer:
                                    ref_eq_value: LLVMValueRef = LLVMBuildICmp(builder, int_predicate_of(binary_operator), ref_eq_left_pointer, ref_eq_right_pointer, "refcmp.ptr")
                                    ref_eq_result: ValueType = ValueType{kind: TypeKind.Bool, bits: 1}
                                    return emit_conversion(ref_eq_value, ref_eq_result, expected, structs, ctx, builder) if expected.kind != TypeKind.Unmodeled and (expected.kind != ref_eq_result.kind or expected.bits != ref_eq_result.bits) else ref_eq_value
                                return null
                            return null
                    # A ref operand auto-dereferences: compare/compute at its target type.
                    operand_type <- ref_target_of(operand_type, structs) if operand_type.kind == TypeKind.Ref
                    # `a == C.R` / `a != C.R` — a PAYLOAD-enum value equality. The value is a
                    # `{i32 tag, …}` aggregate, so compare the TAG fields (stage0 compares the
                    # ordinal). A payloadless plain enum is this representation, and equality is the
                    # one operation on it not already covered by match/ctor/return.
                    if operand_type.kind == TypeKind.PayloadEnum and (binary_operator == TokenKind.EqEq or binary_operator == TokenKind.BangEq):
                        if emit_expression(binary_left, operand_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is penum_eq_left:
                            if emit_expression(binary_right, operand_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is penum_eq_right:
                                penum_eq_left_tag: LLVMValueRef = LLVMBuildExtractValue(builder, penum_eq_left, 0, "penum.eq.ltag")
                                penum_eq_right_tag: LLVMValueRef = LLVMBuildExtractValue(builder, penum_eq_right, 0, "penum.eq.rtag")
                                penum_eq_value: LLVMValueRef = LLVMBuildICmp(builder, int_predicate_of(binary_operator), penum_eq_left_tag, penum_eq_right_tag, "penum.eq")
                                penum_eq_result: ValueType = ValueType{kind: TypeKind.Bool, bits: 1}
                                return emit_conversion(penum_eq_value, penum_eq_result, expected, structs, ctx, builder) if expected.kind != TypeKind.Unmodeled and (expected.kind != penum_eq_result.kind or expected.bits != penum_eq_result.bits) else penum_eq_value
                            return null
                        return null
                    # `cstr == cstr` / `cstr != cstr`: stage0 lowers to `ctx_streq(a, b)` (i64,
                    # nonzero = equal) — a CONTENT compare, not a pointer compare. Reduce it to an
                    # i64 `streq_code <op> 0` and reuse the ordinary integer-comparison machinery so
                    # the surrounding-context widening is identical. `==` is `streq != 0`, `!=` is
                    # `streq == 0` (the operator inverts against the zero test).
                    if operand_type.kind == TypeKind.CStr and (binary_operator == TokenKind.EqEq or binary_operator == TokenKind.BangEq):
                        cstr_type: ValueType = ValueType{kind: TypeKind.CStr, bits: 0}
                        if emit_expression(binary_left, cstr_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is streq_left:
                            if emit_expression(binary_right, cstr_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is streq_right:
                                streq_args: mutable darray[LLVMValueRef] = [streq_left, streq_right]
                                streq_args_pointer: void& = (&streq_args[0]).cast[void&] can Unsafe.PointerCast
                                streq_code: LLVMValueRef = LLVMBuildCall2(builder, runtime.streq_type, runtime.streq, streq_args_pointer, 2, "streq")
                                streq_inner_op: TokenKind = TokenKind.BangEq if binary_operator == TokenKind.EqEq else TokenKind.EqEq
                                streq_zero: LLVMValueRef = LLVMConstInt(LLVMInt64TypeInContext(ctx), 0, 0)
                                streq_int64: ValueType = ValueType{kind: TypeKind.Signed, bits: 64}
                                streq_result_type: ValueType = ValueType{kind: TypeKind.Bool, bits: 1}
                                if emit_binary(streq_inner_op, streq_code, streq_zero, streq_int64, structs, runtime.fast_math, m, ctx, builder) is streq_value:
                                    return emit_conversion(streq_value, streq_result_type, expected, structs, ctx, builder) if expected.kind != TypeKind.Unmodeled and (expected.kind != streq_result_type.kind or expected.bits != streq_result_type.bits) else streq_value
                                return null
                            return null
                        return null
                    # `sview == sview` / `!=`: `ctx_string_views_eq(a, b)` (BY VALUE, i64 nonzero =
                    # equal), then the same `code <op> 0` reduction as the cstr path.
                    if operand_type.kind == TypeKind.SView and (binary_operator == TokenKind.EqEq or binary_operator == TokenKind.BangEq):
                        if emit_expression(binary_left, operand_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is sveq_left:
                            if emit_expression(binary_right, operand_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is sveq_right:
                                sveq_args: mutable darray[LLVMValueRef] = [sveq_left, sveq_right]
                                sveq_args_pointer: void& = (&sveq_args[0]).cast[void&] can Unsafe.PointerCast
                                sveq_code: LLVMValueRef = LLVMBuildCall2(builder, runtime.sview_eq_type, runtime.sview_eq, sveq_args_pointer, 2, "sview.eq")
                                sveq_inner_op: TokenKind = TokenKind.BangEq if binary_operator == TokenKind.EqEq else TokenKind.EqEq
                                sveq_zero: LLVMValueRef = LLVMConstInt(LLVMInt64TypeInContext(ctx), 0, 0)
                                sveq_int64: ValueType = ValueType{kind: TypeKind.Signed, bits: 64}
                                sveq_result_type: ValueType = ValueType{kind: TypeKind.Bool, bits: 1}
                                if emit_binary(sveq_inner_op, sveq_code, sveq_zero, sveq_int64, structs, runtime.fast_math, m, ctx, builder) is sveq_value:
                                    return emit_conversion(sveq_value, sveq_result_type, expected, structs, ctx, builder) if expected.kind != TypeKind.Unmodeled and (expected.kind != sveq_result_type.kind or expected.bits != sveq_result_type.bits) else sveq_value
                                return null
                            return null
                        return null
                    # `bool == bool` / `bool != bool` compare as `icmp eq i1` (stage0's shape).
                    # Equality is the only bool operator; ordering/arithmetic on bool stays declined.
                    bool_equality: bool = operand_type.kind == TypeKind.Bool and (binary_operator == TokenKind.EqEq or binary_operator == TokenKind.BangEq)
                    null return if not is_numeric_type(operand_type) and not bool_equality
                    # Elisa's operation type is anchored by the left operand for INTEGER mixed
                    # widths (stage0 converts the right operand to that type, then widens the
                    # result to the surrounding context if needed). This is observable for
                    # `i32 + i64`: the i64 is narrowed to i32 for the arithmetic, and the
                    # resulting i32 is widened at assignment. A REF operand auto-dereferences to
                    # its target, so compare the TARGET's width/kind, not the pointer (`total +
                    # a` where `a: i64&` from a dict `.get` binding must not read as a
                    # mixed-width Ref-vs-i64 mismatch).
                    left_own_raw: ValueType = expression_type(binary_left, local_scope, fns, structs, generics)
                    right_own_raw: ValueType = expression_type(binary_right, local_scope, fns, structs, generics)
                    left_own: ValueType = ref_target_of(left_own_raw, structs) if left_own_raw.kind == TypeKind.Ref else left_own_raw
                    right_own: ValueType = ref_target_of(right_own_raw, structs) if right_own_raw.kind == TypeKind.Ref else right_own_raw
                    # Mixed-width FLOAT operands (`f32 + f64`) follow the OPPOSITE rule from
                    # integers: stage0 widens to the WIDER type (an `fpext` on the narrower
                    # side), never narrows — confirmed from stage0's own `-emit llvm` output for
                    # `a: f32 = 1.5.f32(); b: f64 = 2.5; c: f64 = a + b` (`fpext float %a to
                    # double`, then `fadd double`). The general mixed-width rule below declined
                    # this outright (it assumes operand_type already equals left_own, which the
                    # integer rule guarantees but the float-widen case deliberately breaks) and
                    # took the whole enclosing function with it — a real acceptance gap, not a
                    # narrow-vs-wide judgment call.
                    float_mixed_width: bool = left_own.kind == TypeKind.Float and right_own.kind == TypeKind.Float and left_own.bits != right_own.bits
                    # An INTEGER operand against a FLOAT operand (`f64 + i64`, either order)
                    # promotes to the FLOAT side, same "widen, never narrow" rule as the
                    # float-vs-float case above — confirmed from stage0's own `-emit llvm`
                    # output for `a: f64 = 2.5; b: i64 = 3; c: f64 = a + b` (`sitofp i64 %b to
                    # double`, then `fadd double`); `emit_conversion` already lowers an
                    # integer->float conversion this way, it was only the decline check below
                    # standing in the way.
                    int_float_mixed: bool = (left_own.kind == TypeKind.Float and is_integer_type(right_own)) or (right_own.kind == TypeKind.Float and is_integer_type(left_own))
                    literal_float_mixed: bool = arithmetic_tree_contains_float_literal(expression)
                    # An untyped Elisa float literal is represented as `Unmodeled` by
                    # expression_type, so it cannot participate in int_float_mixed above.
                    # Once such a literal occurs anywhere in this transparent arithmetic
                    # tree, C's usual arithmetic conversions still make the operation f64
                    # (`i + 1.0`, and nested forms such as `(i * 2) + 1.0`). Select that
                    # operation type before emitting either operand; otherwise the right
                    # FloatLit is emitted with the integer context and the whole expression
                    # declines even though emit_conversion already knows how to lower the
                    # integer operand to f64.
                    operand_type <- ValueType{kind: TypeKind.Float, bits: 64} if literal_float_mixed else (left_own if left_own.bits > right_own.bits else right_own) if float_mixed_width else (left_own if left_own.kind == TypeKind.Float else right_own) if int_float_mixed else operand_type
                    # `expression_type` promotes a transparent arithmetic tree containing a
                    # float literal to f64 even when one or both typed leaves are integers.
                    # Do not apply the integer same-width guard to that tree: the integer leaves
                    # are supposed to be converted to the promoted float type below. Without
                    # this exception, `((i * 2) + 1) * 3.14159` inferred f64 but immediately
                    # declined because its left subtree remained i32.
                    if not float_mixed_width and not int_float_mixed and not literal_float_mixed and left_own.kind != TypeKind.Unmodeled and right_own.kind != TypeKind.Unmodeled:
                        null return if left_own.kind != operand_type.kind or left_own.bits != operand_type.bits
                        null return if not is_integer_type(left_own) and (right_own.kind != operand_type.kind or right_own.bits != operand_type.bits)
                    # A comparison/`is` operator yields `bool` regardless of the OPERAND type, so
                    # the value handed to the surrounding-context conversion is a bool, not an
                    # `operand_type`-width int. Widening it as if it were `operand_type` (e.g.
                    # `bool` <- `i64`) declines and strips the whole function.
                    result_type: ValueType = ValueType{kind: TypeKind.Bool, bits: 1} if int_predicate_of(binary_operator) >= 0 else operand_type
                    if emit_expression(binary_left, left_own if left_own.kind != TypeKind.Unmodeled else operand_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is left_raw:
                        if emit_expression(binary_right, right_own if right_own.kind != TypeKind.Unmodeled else operand_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is right_raw:
                            if left_own.kind == TypeKind.Unmodeled:
                                if right_own.kind == TypeKind.Unmodeled:
                                    if emit_binary(binary_operator, left_raw, right_raw, operand_type, structs, runtime.fast_math, m, ctx, builder) is binary_value:
                                        return emit_conversion(binary_value, result_type, expected, structs, ctx, builder) if expected.kind != TypeKind.Unmodeled and (expected.kind != result_type.kind or expected.bits != result_type.bits) else binary_value
                                    return null
                                if emit_conversion(right_raw, right_own, operand_type, structs, ctx, builder) is converted_right:
                                    if emit_binary(binary_operator, left_raw, converted_right, operand_type, structs, runtime.fast_math, m, ctx, builder) is binary_value:
                                        return emit_conversion(binary_value, result_type, expected, structs, ctx, builder) if expected.kind != TypeKind.Unmodeled and (expected.kind != result_type.kind or expected.bits != result_type.bits) else binary_value
                                    return null
                                return null
                            if emit_conversion(left_raw, left_own, operand_type, structs, ctx, builder) is converted_left:
                                if right_own.kind == TypeKind.Unmodeled:
                                    if emit_binary(binary_operator, converted_left, right_raw, operand_type, structs, runtime.fast_math, m, ctx, builder) is binary_value:
                                        return emit_conversion(binary_value, result_type, expected, structs, ctx, builder) if expected.kind != TypeKind.Unmodeled and (expected.kind != result_type.kind or expected.bits != result_type.bits) else binary_value
                                    return null
                                if emit_conversion(right_raw, right_own, operand_type, structs, ctx, builder) is converted_right:
                                    if emit_binary(binary_operator, converted_left, converted_right, operand_type, structs, runtime.fast_math, m, ctx, builder) is binary_value:
                                        return emit_conversion(binary_value, result_type, expected, structs, ctx, builder) if expected.kind != TypeKind.Unmodeled and (expected.kind != result_type.kind or expected.bits != result_type.bits) else binary_value
                                    return null
                            return null
                    return null
                _:
                    pass
            handled <- false
            return null
