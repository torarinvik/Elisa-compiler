# Stage1 backend — STRING literals and bare IDENTIFIERS, the last forms the literal chain tries:
# a string becomes a module constant plus an sview, and an identifier is a local slot, a
# const, a global, or `null`/`zeroed` read at the context's type.
# Part of `module Backend` (see codegen.elisa).

extend Backend:
    private:
        def emit_expression_string_and_ident(expression: Expr, expected: ValueType, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef, handled: mutable bool&) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            match expression:
                Expr.StringLit(string_text, _):
                    # `"hi"` in a `dstr` (= darray[u8]) context — build a byte darray in the arena,
                    # exactly as stage0 does (alloc, store each byte, build the {ptr,count,cap}
                    # header). The surrounding fn threads an arena when it returns/holds a dstr.
                    if expected.kind == TypeKind.DArray and darray_element_of(expected, structs).kind == TypeKind.Unsigned and darray_element_of(expected, structs).bits == 8:
                        # Decoded bytes, so `"a\nb"` is three bytes in a dstr, not four.
                        dstr_bytes: mutable darray[u8] = []
                        dstr_escapes_known: mutable bool = true
                        decode_string_escapes(string_text, dstr_bytes, dstr_escapes_known)
                        dstr_len: usize = dstr_bytes.count
                        dstr_cap: i64 = 256 if dstr_len.i64() < 256 else dstr_len.i64()
                        dstr_header: LLVMTypeRef = darray_llvm_type(structs, ctx)
                        dstr_slot: LLVMValueRef = build_entry_alloca(builder, dstr_header, "dstr.literal")
                        _ = LLVMBuildStore(builder, LLVMConstNull(dstr_header), dstr_slot)
                        dstr_alloc_args: mutable darray[LLVMValueRef] = [runtime.arena, runtime_size_argument(LLVMConstInt(LLVMInt64TypeInContext(ctx), dstr_cap.u64(), 0), ctx, builder)]
                        dstr_alloc_pointer: void& = (&dstr_alloc_args[0]).cast[void&] can Unsafe.PointerCast
                        dstr_buffer: LLVMValueRef = LLVMBuildCall2(builder, runtime.arena_alloc_type, runtime.arena_alloc, dstr_alloc_pointer, 2, "dstr.alloc")
                        for dstr_byte_index in 0..<dstr_len |dstr_buffer, dstr_bytes, ctx, builder|:
                            dstr_byte_offset: mutable darray[LLVMValueRef] = [LLVMConstInt(LLVMInt64TypeInContext(ctx), dstr_byte_index.u64(), 0)]
                            dstr_byte_offset_pointer: void& = (&dstr_byte_offset[0]).cast[void&] can Unsafe.PointerCast
                            dstr_byte_slot: LLVMValueRef = LLVMBuildGEP2(builder, LLVMInt8TypeInContext(ctx), dstr_buffer, dstr_byte_offset_pointer, 1, "dstr.byte.ptr")
                            _ = LLVMBuildStore(builder, LLVMConstInt(LLVMInt8TypeInContext(ctx), dstr_bytes[dstr_byte_index].u64(), 0), dstr_byte_slot)
                        dstr_items_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, dstr_header, dstr_slot, 0, "dstr.items.ptr")
                        _ = LLVMBuildStore(builder, dstr_buffer, dstr_items_pointer)
                        dstr_count_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, dstr_header, dstr_slot, 1, "dstr.count.ptr")
                        _ = LLVMBuildStore(builder, LLVMConstInt(LLVMInt64TypeInContext(ctx), dstr_len.u64(), 0), dstr_count_pointer)
                        dstr_cap_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, dstr_header, dstr_slot, 2, "dstr.cap.ptr")
                        _ = LLVMBuildStore(builder, LLVMConstInt(LLVMInt64TypeInContext(ctx), dstr_cap.u64(), 0), dstr_cap_pointer)
                        return LLVMBuildLoad2(builder, dstr_header, dstr_slot, "dstr.literal.value")
                    # C string literals can initialize fixed byte arrays, including nested
                    # tables such as `char endStrings[9][80]`. The literal carries its bytes
                    # as a pointer in the ordinary string paths, but an ARRAY context needs
                    # an actual aggregate value. Materialize the decoded bytes into a temporary
                    # fixed array; the initial zero fill supplies the C terminator and padding.
                    if expected.kind == TypeKind.Array:
                        fixed_string_slot: usize = expected.bits.usize()
                        fixed_string_element: ValueType = array_element_of(expected, structs)
                        if (fixed_string_element.kind == TypeKind.Unsigned or fixed_string_element.kind == TypeKind.Signed) and fixed_string_element.bits == 8:
                            fixed_string_bytes: mutable darray[u8] = []
                            fixed_string_escapes_known: mutable bool = true
                            decode_string_escapes(string_text, fixed_string_bytes, fixed_string_escapes_known)
                            fixed_string_extent: usize = structs.array_extents[fixed_string_slot].usize()
                            null return if fixed_string_bytes.count > fixed_string_extent
                            fixed_string_llvm: LLVMTypeRef = llvm_type_of(expected, structs, ctx)
                            fixed_string_temporary: LLVMValueRef = build_entry_alloca(builder, fixed_string_llvm, "fixed.string")
                            _ = LLVMBuildStore(builder, LLVMConstNull(fixed_string_llvm), fixed_string_temporary)
                            for fixed_string_position in 0..<fixed_string_bytes.count |fixed_string_bytes, fixed_string_llvm, fixed_string_temporary, ctx, builder|:
                                fixed_string_indices: mutable darray[LLVMValueRef] = [LLVMConstInt(LLVMInt64TypeInContext(ctx), 0, 0), LLVMConstInt(LLVMInt64TypeInContext(ctx), fixed_string_position.u64(), 0)]
                                fixed_string_indices_pointer: void& = (&fixed_string_indices[0]).cast[void&] can Unsafe.PointerCast
                                fixed_string_pointer: LLVMValueRef = LLVMBuildGEP2(builder, fixed_string_llvm, fixed_string_temporary, fixed_string_indices_pointer, 2, "fixed.string.byte.ptr")
                                _ = LLVMBuildStore(builder, LLVMConstInt(LLVMInt8TypeInContext(ctx), fixed_string_bytes[fixed_string_position].u64(), 0), fixed_string_pointer)
                            return LLVMBuildLoad2(builder, fixed_string_llvm, fixed_string_temporary, "fixed.string.value")
                    # A string literal is also a borrowed byte reference (`u8&`) in the
                    # runtime's low-level string helpers.  Treating that form as unsupported
                    # made otherwise ordinary helpers such as `bool_to_string_into` decline
                    # during the gen2 self-host build, even though the LLVM value is the same
                    # global byte pointer as the cstr case.
                    literal_ref_target: ValueType = ref_target_of(expected, structs) if expected.kind == TypeKind.Ref else unmodeled_type()
                    null return if expected.kind != TypeKind.CStr and expected.kind != TypeKind.SView and expected.kind != TypeKind.Ref and expected.kind != TypeKind.Unmodeled
                    if expected.kind == TypeKind.Ref:
                        # A string literal has static storage, so it can satisfy a borrowed
                        # `u8&` but must not be accepted as an owning `heap u8&` result.
                        null return if ref_is_heap_ref(expected, structs)
                        # `void&` is how declare_extern records EVERY provenance-bearing extern
                        # parameter — the `&` is known, the referent is not. So a format string
                        # passed to `extern snprintf(…, fmt: u8&, …)` arrives here expecting
                        # `void&`, and requiring a `u8` referent declined it, taking the whole
                        # calling function with it. The emitted value is the same global byte
                        # pointer either way.
                        literal_ref_is_bytes: bool = literal_ref_target.kind == TypeKind.Unsigned and literal_ref_target.bits == 8
                        null return if not literal_ref_is_bytes and literal_ref_target.kind != TypeKind.Void
                    # DECODED bytes, not the raw source span: the lexer leaves `\"`/`\n` undecoded
                    # and the backend owns decoding (see decode_string_escapes). The length must be
                    # the decoded one too — `storage` minus its NUL — or an sview would report the
                    # source width and read past the string.
                    literal_storage: mutable darray[u8] = []
                    string_global: LLVMValueRef = LLVMBuildGlobalStringPtr(builder, decoded_literal_cstr(string_text, literal_storage), "str")
                    literal_decoded_length: usize = literal_storage.count - 1.usize()
                    # An `sview` context wants the `{ptr, i64 len}` aggregate, not the bare ptr.
                    if expected.kind == TypeKind.SView:
                        sview_llvm: LLVMTypeRef = llvm_type_of(expected, structs, ctx)
                        sview_undef: LLVMValueRef = LLVMGetUndef(sview_llvm)
                        sview_with_ptr: LLVMValueRef = LLVMBuildInsertValue(builder, sview_undef, string_global, 0, "sview.ptr")
                        sview_len_value: LLVMValueRef = LLVMConstInt(LLVMInt64TypeInContext(ctx), literal_decoded_length.u64(), 0)
                        return LLVMBuildInsertValue(builder, sview_with_ptr, sview_len_value, 1, "sview.len")
                    return string_global
                _:
                    pass
            match expression:
                Expr.Ident(null_name, null_line):
                    if null_name == "null":
                        # `null` is the None of an optional, but also a null POINTER when a ref/cstr is
                        # expected (e.g. `LLVMFunctionType(ret, null, 0, 0)` for a `void&?` param that
                        # declare_extern registers as a plain Ref). LLVMConstNull yields a null for any
                        # of these pointer-shaped types, matching stage0's `ptr null`.
                        # Function values are raw pointers too. Extern callback parameters retain
                        # their callable alias as a Fn value but the compact extern parameter table
                        # does not preserve the postfix `?`; stage0 still accepts `null` there as a
                        # null callback pointer. Treat Fn exactly like the other nullable pointer
                        # shaped values so a null callback does not decline its containing function.
                        null return if expected.kind != TypeKind.Optional and expected.kind != TypeKind.Ref and expected.kind != TypeKind.CStr and expected.kind != TypeKind.Fn
                        return LLVMConstNull(llvm_type_of(expected, structs, ctx))
                    # `zeroed` — the all-zero value of the CONTEXT type: 0 for a scalar, a null
                    # pointer for a ref, and `zeroinitializer` for a struct/array. The dict grow
                    # path zero-fills fresh buckets with `zeroed`.
                    if null_name == "zeroed":
                        null return if expected.kind == TypeKind.Unmodeled
                        return LLVMConstNull(llvm_type_of(expected, structs, ctx))
                _:
                    pass
            handled <- false
            return null

