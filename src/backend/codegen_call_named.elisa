# Stage1 backend — a call to a NAMED function: overload selection, named arguments and
# defaults, the generic instantiation it may need, and the hidden arena and store slots its
# signature asks for. codegen_call.elisa tries the shaped callees (dense views, protocol and
# typestate members, explicit type arguments) first.
# Part of `module Backend` (see codegen.elisa).

extend Backend:
    private:
        def emit_call_named(callee: Expr, arguments: darray[Expr]&, argument_names: darray[sview], local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            if callee is Expr.Ident(callee_name, callee_line):
                # UFCS lowering may present `items.pop()` as the normalized free call
                # `pop(items)` rather than retaining the Field callee. Keep the darray
                # fast path on both shapes; otherwise recursive AST containers fall back
                # to a generic `darray_pop[T]` instantiation whose aggregate body may be
                # declined by the self-host backend.
                if callee_name == "pop" and arguments.count == 1:
                    normalized_pop_type: ValueType = darray_type_behind_expr(arguments[0], local_scope, structs)
                    if normalized_pop_type.kind == TypeKind.DArray:
                        if darray_address_of_expr(arguments[0], local_scope, fns, structs, generics, runtime, m, ctx, builder) is normalized_pop_slot:
                            return emit_darray_pop_value(normalized_pop_slot, normalized_pop_type, structs, m, ctx, builder)
                # `ctx_hash_value(key)` — the compiler-emitted hash builtin (no user function
                # of that name exists), lowered per the key's concrete type.
                if callee_name == "ctx_hash_value" and arguments.count == 1:
                    return emit_hash_builtin(arguments[0], local_scope, fns, structs, generics, runtime, m, ctx, builder)
                # `__fstr(pieces…)` — the f-string builder desugared from `f"…"`.
                if callee_name == "__fstr":
                    return emit_fstr_builtin(arguments, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                # `size_of(T)` — the type's byte size as a compile-time constant (its argument
                # is a TYPE, so it resolves as an annotation). The dict grow path sizes its
                # bucket array with `size_of(DictBucket[K, T])`.
                if callee_name == "size_of" and arguments.count == 1:
                    size_of_type: ValueType = annotation_value_type(arguments[0], structs)
                    null return if size_of_type.kind == TypeKind.Unmodeled
                    return LLVMSizeOf(llvm_type_of(size_of_type, structs, ctx))
                # `sview(base, start, end)` — construct a string view `{ptr, len}` (stage0
                # `%StringView`). Used heavily by the self-host frontend (`empty_sview`,
                # token spans). Inline the aggregate rather than calling the runtime helper
                # so the product corpus does not depend on a pre-linked `@sview` when the
                # stage1 backend itself is the code under emission.
                # `readonly(v)` is a TYPE-LEVEL marker with no representation: stage0 stores the
                # operand straight through (`store %DynArrayView %whole2, ptr %ro`), no call and
                # no conversion. Emitting it as the identity is what lets a readonly view be
                # bound, sliced and passed on; without it every function taking one declined.
                # `split_at(v, n)` — the halves `v[0:n]` and `v[n:len]`, as a `{left, right}`
                # pair. Built inline: both halves are ordinary view slices, so there is no
                # runtime helper to call.
                if callee_name == "split_at" and arguments.count == 2:
                    split_view_type: ValueType = expression_type(arguments[0], local_scope, fns, structs, generics)
                    null return if split_view_type.kind != TypeKind.View
                    split_element: ValueType = view_element_of(split_view_type, structs)
                    split_result: ValueType = synthesize_split_view(split_element, structs)
                    null return if split_result.kind != TypeKind.Struct
                    if emit_expression(arguments[0], split_view_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is split_base:
                        if emit_expression(arguments[1], ValueType{kind: TypeKind.Signed, bits: 64}, local_scope, fns, structs, generics, runtime, m, ctx, builder) is split_at_index:
                            split_i64: LLVMTypeRef = LLVMInt64TypeInContext(ctx)
                            split_element_llvm: LLVMTypeRef = llvm_type_of(split_element, structs, ctx)
                            split_view_llvm: LLVMTypeRef = llvm_type_of(split_view_type, structs, ctx)
                            split_data: LLVMValueRef = LLVMBuildExtractValue(builder, split_base, 0, "split.data")
                            split_len: LLVMValueRef = LLVMBuildExtractValue(builder, split_base, 1, "split.len")
                            split_left: mutable LLVMValueRef = LLVMGetUndef(split_view_llvm)
                            split_left <- LLVMBuildInsertValue(builder, split_left, split_data, 0, "split.left.data")
                            split_left <- LLVMBuildInsertValue(builder, split_left, split_at_index, 1, "split.left.len")
                            split_right_offsets: mutable darray[LLVMValueRef] = [split_at_index]
                            split_right_pointer: void& = (&split_right_offsets[0]).cast[void&] can Unsafe.PointerCast
                            split_right_data: LLVMValueRef = LLVMBuildGEP2(builder, split_element_llvm, split_data, split_right_pointer, 1, "split.right.data")
                            split_right: mutable LLVMValueRef = LLVMGetUndef(split_view_llvm)
                            split_right <- LLVMBuildInsertValue(builder, split_right, split_right_data, 0, "split.right.data.ins")
                            split_right <- LLVMBuildInsertValue(builder, split_right, LLVMBuildSub(builder, split_len, split_at_index, "split.right.len"), 1, "split.right.len.ins")
                            split_pair: mutable LLVMValueRef = LLVMGetUndef(llvm_type_of(split_result, structs, ctx))
                            split_pair <- LLVMBuildInsertValue(builder, split_pair, split_left, 0, "split.pair.left")
                            split_pair <- LLVMBuildInsertValue(builder, split_pair, split_right, 1, "split.pair.right")
                            _ = split_i64
                            return split_pair
                    return null
                # `reduce_sum(v, f, extra…)` — fold a view through `f`, summing the results.
                # stage0 emits a plain counted loop with two phis (index and accumulator),
                # calling `f(elem, extra…)` per element; there is no runtime helper.
                if callee_name == "reduce_sum" and arguments.count >= 2:
                    reduce_view_type: ValueType = expression_type(arguments[0], local_scope, fns, structs, generics)
                    null return if reduce_view_type.kind != TypeKind.View
                    reduce_element: ValueType = view_element_of(reduce_view_type, structs)
                    null return if reduce_element.kind == TypeKind.Unmodeled
                    if emit_expression(arguments[0], reduce_view_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is reduce_source:
                        reduce_i64: LLVMTypeRef = LLVMInt64TypeInContext(ctx)
                        reduce_elem_llvm: LLVMTypeRef = llvm_type_of(reduce_element, structs, ctx)
                        reduce_data: LLVMValueRef = LLVMBuildExtractValue(builder, reduce_source, 0, "reduce_sum.src.data")
                        reduce_total: LLVMValueRef = LLVMBuildExtractValue(builder, reduce_source, 1, "reduce_sum.total")
                        reduce_index: LLVMValueRef = LLVMBuildAlloca(builder, reduce_i64, "reduce_sum.i")
                        _ = LLVMBuildStore(builder, LLVMConstInt(reduce_i64, 0, 0), reduce_index)
                        reduce_acc: LLVMValueRef = LLVMBuildAlloca(builder, reduce_elem_llvm, "reduce_sum.acc")
                        _ = LLVMBuildStore(builder, LLVMConstNull(reduce_elem_llvm), reduce_acc)
                        reduce_function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                        reduce_cond: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, reduce_function, "reduce_sum.cond")
                        reduce_body: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, reduce_function, "reduce_sum.body")
                        reduce_end: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, reduce_function, "reduce_sum.end")
                        _ = LLVMBuildBr(builder, reduce_cond)
                        LLVMPositionBuilderAtEnd(builder, reduce_cond)
                        reduce_at: LLVMValueRef = LLVMBuildLoad2(builder, reduce_i64, reduce_index, "reduce_sum.index")
                        # 36 = ULT: a view length is unsigned, as stage0 reads it.
                        _ = LLVMBuildCondBr(builder, LLVMBuildICmp(builder, 36, reduce_at, reduce_total, "reduce_sum.has_more"), reduce_body, reduce_end)
                        LLVMPositionBuilderAtEnd(builder, reduce_body)
                        reduce_offsets: mutable darray[LLVMValueRef] = [reduce_at]
                        reduce_offsets_pointer: void& = (&reduce_offsets[0]).cast[void&] can Unsafe.PointerCast
                        reduce_elem_ptr: LLVMValueRef = LLVMBuildGEP2(builder, reduce_elem_llvm, reduce_data, reduce_offsets_pointer, 1, "reduce_sum.src.ptr")
                        reduce_elem_slot: LLVMValueRef = LLVMBuildAlloca(builder, reduce_elem_llvm, "reduce_sum.elem")
                        _ = LLVMBuildStore(builder, LLVMBuildLoad2(builder, reduce_elem_llvm, reduce_elem_ptr, "reduce_sum.src.elem"), reduce_elem_slot)
                        reduce_scope_mark: usize = scope_mark(local_scope)
                        declare_local(local_scope, "__reduce_elem", reduce_elem_slot, reduce_element)
                        reduce_call_args: mutable darray[Expr] = [(Expr.Ident("__reduce_elem", Ast::pos_at_line(0)))]
                        for reduce_extra in 2..<arguments.count |reduce_call_args, arguments|:
                            reduce_call_args.push(arguments[reduce_extra])
                        reduce_step: LLVMValueRef? = emit_call(arguments[1], reduce_call_args, [], local_scope, fns, structs, generics, runtime, m, ctx, builder)
                        scope_restore(local_scope, reduce_scope_mark)
                        if reduce_step is reduce_step_value:
                            _ = LLVMBuildStore(builder, LLVMBuildAdd(builder, LLVMBuildLoad2(builder, reduce_elem_llvm, reduce_acc, "reduce_sum.acc"), reduce_step_value, "reduce_sum.acc.next"), reduce_acc)
                            _ = LLVMBuildStore(builder, LLVMBuildAdd(builder, LLVMBuildLoad2(builder, reduce_i64, reduce_index, "reduce_sum.index.cur"), LLVMConstInt(reduce_i64, 1, 0), "reduce_sum.index.next"), reduce_index)
                            _ = LLVMBuildBr(builder, reduce_cond)
                            LLVMPositionBuilderAtEnd(builder, reduce_end)
                            return LLVMBuildLoad2(builder, reduce_elem_llvm, reduce_acc, "reduce_sum.result")
                        return null
                    return null
                # `zip_map(dst, a, b, f)` — elementwise `dst[i] = f(a[i], b[i])` over the
                # DESTINATION's length, which is the bound stage0 uses (`zip_map.total` comes
                # off the dst view). Same counted-loop shape as reduce_sum, storing instead of
                # accumulating; there is no runtime helper.
                if callee_name == "zip_map" and arguments.count == 4:
                    zip_dst_type: ValueType = expression_type(arguments[0], local_scope, fns, structs, generics)
                    null return if zip_dst_type.kind != TypeKind.View
                    zip_element: ValueType = view_element_of(zip_dst_type, structs)
                    null return if zip_element.kind == TypeKind.Unmodeled
                    if emit_expression(arguments[0], zip_dst_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is zip_dst:
                        if emit_expression(arguments[1], expression_type(arguments[1], local_scope, fns, structs, generics), local_scope, fns, structs, generics, runtime, m, ctx, builder) is zip_src1:
                            if emit_expression(arguments[2], expression_type(arguments[2], local_scope, fns, structs, generics), local_scope, fns, structs, generics, runtime, m, ctx, builder) is zip_src2:
                                zip_i64: LLVMTypeRef = LLVMInt64TypeInContext(ctx)
                                zip_elem_llvm: LLVMTypeRef = llvm_type_of(zip_element, structs, ctx)
                                zip_dst_data: LLVMValueRef = LLVMBuildExtractValue(builder, zip_dst, 0, "zip_map.dst.data")
                                zip_src1_data: LLVMValueRef = LLVMBuildExtractValue(builder, zip_src1, 0, "zip_map.src1.data")
                                zip_src2_data: LLVMValueRef = LLVMBuildExtractValue(builder, zip_src2, 0, "zip_map.src2.data")
                                zip_total: LLVMValueRef = LLVMBuildExtractValue(builder, zip_dst, 1, "zip_map.total")
                                zip_index: LLVMValueRef = LLVMBuildAlloca(builder, zip_i64, "zip_map.i")
                                _ = LLVMBuildStore(builder, LLVMConstInt(zip_i64, 0, 0), zip_index)
                                zip_function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                                zip_cond: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, zip_function, "zip_map.cond")
                                zip_body: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, zip_function, "zip_map.body")
                                zip_end: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, zip_function, "zip_map.end")
                                _ = LLVMBuildBr(builder, zip_cond)
                                LLVMPositionBuilderAtEnd(builder, zip_cond)
                                zip_at: LLVMValueRef = LLVMBuildLoad2(builder, zip_i64, zip_index, "zip_map.index")
                                # 36 = ULT: a view length is unsigned.
                                _ = LLVMBuildCondBr(builder, LLVMBuildICmp(builder, 36, zip_at, zip_total, "zip_map.has_more"), zip_body, zip_end)
                                LLVMPositionBuilderAtEnd(builder, zip_body)
                                zip_off1: mutable darray[LLVMValueRef] = [zip_at]
                                zip_off1_pointer: void& = (&zip_off1[0]).cast[void&] can Unsafe.PointerCast
                                zip_a_slot: LLVMValueRef = LLVMBuildAlloca(builder, zip_elem_llvm, "zip_map.a")
                                _ = LLVMBuildStore(builder, LLVMBuildLoad2(builder, zip_elem_llvm, LLVMBuildGEP2(builder, zip_elem_llvm, zip_src1_data, zip_off1_pointer, 1, "zip_map.src1.ptr"), "zip_map.src1.elem"), zip_a_slot)
                                zip_off2: mutable darray[LLVMValueRef] = [zip_at]
                                zip_off2_pointer: void& = (&zip_off2[0]).cast[void&] can Unsafe.PointerCast
                                zip_b_slot: LLVMValueRef = LLVMBuildAlloca(builder, zip_elem_llvm, "zip_map.b")
                                _ = LLVMBuildStore(builder, LLVMBuildLoad2(builder, zip_elem_llvm, LLVMBuildGEP2(builder, zip_elem_llvm, zip_src2_data, zip_off2_pointer, 1, "zip_map.src2.ptr"), "zip_map.src2.elem"), zip_b_slot)
                                zip_scope_mark: usize = scope_mark(local_scope)
                                declare_local(local_scope, "__zip_a", zip_a_slot, zip_element)
                                declare_local(local_scope, "__zip_b", zip_b_slot, zip_element)
                                zip_call_args: mutable darray[Expr] = [(Expr.Ident("__zip_a", Ast::pos_at_line(0))), (Expr.Ident("__zip_b", Ast::pos_at_line(0)))]
                                zip_result: LLVMValueRef? = emit_call(arguments[3], zip_call_args, [], local_scope, fns, structs, generics, runtime, m, ctx, builder)
                                scope_restore(local_scope, zip_scope_mark)
                                if zip_result is zip_value:
                                    zip_off3: mutable darray[LLVMValueRef] = [zip_at]
                                    zip_off3_pointer: void& = (&zip_off3[0]).cast[void&] can Unsafe.PointerCast
                                    _ = LLVMBuildStore(builder, zip_value, LLVMBuildGEP2(builder, zip_elem_llvm, zip_dst_data, zip_off3_pointer, 1, "zip_map.dst.ptr"))
                                    _ = LLVMBuildStore(builder, LLVMBuildAdd(builder, LLVMBuildLoad2(builder, zip_i64, zip_index, "zip_map.index.cur"), LLVMConstInt(zip_i64, 1, 0), "zip_map.index.next"), zip_index)
                                    _ = LLVMBuildBr(builder, zip_cond)
                                    LLVMPositionBuilderAtEnd(builder, zip_end)
                                    return LLVMConstInt(LLVMInt64TypeInContext(ctx), 0, 0)
                                return null
                    return null
                # `chunks_exact(v, n)` — the base view, the chunk LENGTH and the number of
                # WHOLE chunks (`len / n`), matching stage0's `{view, i64, i64}`.
                if callee_name == "chunks_exact" and arguments.count == 2:
                    chunks_view_type: ValueType = expression_type(arguments[0], local_scope, fns, structs, generics)
                    null return if chunks_view_type.kind != TypeKind.View
                    chunks_element: ValueType = view_element_of(chunks_view_type, structs)
                    chunks_result: ValueType = synthesize_chunks_exact_view(chunks_element, structs)
                    null return if chunks_result.kind != TypeKind.Struct
                    if emit_expression(arguments[0], chunks_view_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is chunks_base:
                        if emit_expression(arguments[1], ValueType{kind: TypeKind.Signed, bits: 64}, local_scope, fns, structs, generics, runtime, m, ctx, builder) is chunks_len:
                            chunks_total: LLVMValueRef = LLVMBuildExtractValue(builder, chunks_base, 1, "chunks.total")
                            chunks_agg: mutable LLVMValueRef = LLVMGetUndef(llvm_type_of(chunks_result, structs, ctx))
                            chunks_agg <- LLVMBuildInsertValue(builder, chunks_agg, chunks_base, 0, "chunks.base")
                            chunks_agg <- LLVMBuildInsertValue(builder, chunks_agg, chunks_len, 1, "chunks.chunk")
                            chunks_agg <- LLVMBuildInsertValue(builder, chunks_agg, LLVMBuildSDiv(builder, chunks_total, chunks_len, "chunks.count"), 2, "chunks.count.ins")
                            return chunks_agg
                    return null
                if callee_name == "readonly" and arguments.count == 1:
                    return emit_expression(arguments[0], expression_type(arguments[0], local_scope, fns, structs, generics), local_scope, fns, structs, generics, runtime, m, ctx, builder)
                if callee_name == "sview" and arguments.count == 3:
                    sview_type: ValueType = ValueType{kind: TypeKind.SView, bits: 0}
                    sview_llvm: LLVMTypeRef = llvm_type_of(sview_type, structs, ctx)
                    # A nullable `u8&?` is represented as `{i1, ptr}`. The constructor needs
                    # the payload pointer, not that tagged aggregate; unwrap it before the
                    # byte GEP. Plain cstr arguments remain the existing raw-pointer path.
                    sview_source_type: ValueType = expression_type(arguments[0], local_scope, fns, structs, generics)
                    sview_base: mutable LLVMValueRef = zeroed
                    sview_base_ok: mutable bool = false
                    if sview_source_type.kind == TypeKind.Optional and optional_payload_of(sview_source_type, structs).kind == TypeKind.Ref:
                        if emit_expression(arguments[0], sview_source_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is sview_optional_base:
                            sview_base <- optional_payload_value_of(sview_optional_base, sview_source_type, structs, ctx, builder)
                            sview_base_ok <- true
                    elif emit_expression(arguments[0], ValueType{kind: TypeKind.CStr, bits: 0}, local_scope, fns, structs, generics, runtime, m, ctx, builder) is sview_direct_base:
                        sview_base <- sview_direct_base
                        sview_base_ok <- true
                    if sview_base_ok:
                        if emit_expression(arguments[1], ValueType{kind: TypeKind.Signed, bits: 64}, local_scope, fns, structs, generics, runtime, m, ctx, builder) is sview_start:
                            if emit_expression(arguments[2], ValueType{kind: TypeKind.Signed, bits: 64}, local_scope, fns, structs, generics, runtime, m, ctx, builder) is sview_end:
                                return emit_sview_from_parts(sview_base, sview_start, sview_end, sview_llvm, m, ctx, builder)
                            return null
                        return null
                    return null
                # `i64(x)` / `u8(x)` — a prefix value CONVERSION (canonical `T(x)`; postfix
                # `x.i64()` is on the cast path). A scalar type name applied to ONE argument
                # converts it to the target scalar. A user cannot define a function named after a
                # scalar type, so this never shadows a real call. An untyped-literal argument
                # (`i64(5)`) is emitted directly at the target width.
                prefix_convert_target: ValueType = scalar_type_of_name(callee_name)
                if prefix_convert_target.kind != TypeKind.Unmodeled and arguments.count == 1:
                    prefix_convert_from: ValueType = expression_type(arguments[0], local_scope, fns, structs, generics)
                    if prefix_convert_from.kind == TypeKind.Unmodeled:
                        return emit_expression(arguments[0], prefix_convert_target, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                    if emit_expression(arguments[0], prefix_convert_from, local_scope, fns, structs, generics, runtime, m, ctx, builder) is prefix_convert_value:
                        return emit_conversion(prefix_convert_value, prefix_convert_from, prefix_convert_target, structs, ctx, builder)
                    return null
                # ATOMIC PRIMITIVE INTERCEPT: a call to a std atomic op — load/store/exchange/
                # fetch_add/fetch_sub/fetch_and/fetch_or/fetch_xor — whose FIRST argument is an
                # `atomic[T]&` (an integer cell) lowers to a REAL LLVM atomic instruction rather
                # than a plain function call (whose `slot.value` body is non-atomic). SeqCst
                # ordering, matching stage0's default. Gated on the atomic[T]-integer receiver, so
                # a user function of the same name on any other type is unaffected. compare_exchange
                # / fence / non-integer cells fall through to the normal call (sound: single-threaded
                # they behave identically; only true multi-thread atomicity differs).
                atomic_intercept_rmw: i64 = atomic_rmw_op_of(callee_name)
                atomic_intercept_load: bool = callee_name == "load"
                atomic_intercept_store: bool = callee_name == "store"
                if (atomic_intercept_rmw >= 0 or atomic_intercept_load or atomic_intercept_store) and arguments.count >= 1:
                    atomic_first_type: ValueType = expression_type(arguments[0], local_scope, fns, structs, generics)
                    if atomic_first_type.kind == TypeKind.Ref:
                        atomic_cell_type: ValueType = ref_target_of(atomic_first_type, structs)
                        if atomic_cell_type.kind == TypeKind.Struct and structs.names[atomic_cell_type.bits.usize()] == "atomic":
                            atomic_cell_slot: usize = atomic_cell_type.bits.usize()
                            atomic_value_index: i64 = field_index_of(structs, atomic_cell_slot, "value")
                            if atomic_value_index >= 0:
                                atomic_value_type: ValueType = copied_type(structs.field_types[structs.field_start[atomic_cell_slot] + atomic_value_index.usize()])
                                if atomic_value_is_integer(atomic_value_type):
                                    if emit_expression(arguments[0], atomic_first_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is atomic_cell_pointer:
                                        atomic_cell_llvm: LLVMTypeRef = llvm_type_of(atomic_cell_type, structs, ctx)
                                        atomic_value_llvm: LLVMTypeRef = llvm_type_of(atomic_value_type, structs, ctx)
                                        atomic_value_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, atomic_cell_llvm, atomic_cell_pointer, atomic_value_index.u32(), "atomic.value.ptr")
                                        atomic_align: u32 = (atomic_value_type.bits / 8).u32()
                                        if atomic_intercept_load:
                                            atomic_loaded: LLVMValueRef = LLVMBuildLoad2(builder, atomic_value_llvm, atomic_value_pointer, "atomic.load")
                                            LLVMSetOrdering(atomic_loaded, 7)
                                            LLVMSetAlignment(atomic_loaded, atomic_align)
                                            return atomic_loaded
                                        if atomic_intercept_store and arguments.count >= 2:
                                            if emit_expression(arguments[1], atomic_value_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is atomic_store_value:
                                                atomic_stored: LLVMValueRef = LLVMBuildStore(builder, atomic_store_value, atomic_value_pointer)
                                                LLVMSetOrdering(atomic_stored, 7)
                                                LLVMSetAlignment(atomic_stored, atomic_align)
                                                return atomic_stored
                                            return null
                                        if atomic_intercept_rmw >= 0 and arguments.count >= 2:
                                            if emit_expression(arguments[1], atomic_value_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is atomic_rmw_value:
                                                return LLVMBuildAtomicRMW(builder, atomic_intercept_rmw.i32(), atomic_value_pointer, atomic_rmw_value, 7, 0)
                                            return null
                # `arena_alloc(region, nbytes)` — the runtime allocator, callable by name from
                # std code. The region is an `Arena&` (a pointer); nbytes is a usize.
                if callee_name == "arena_alloc" and arguments.count == 2:
                    arena_ref_type: ValueType = intern_ref_type(ValueType{kind: TypeKind.Arena, bits: 0}, structs)
                    if emit_expression(arguments[0], arena_ref_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is alloc_region:
                        if emit_expression(arguments[1], ValueType{kind: TypeKind.Unsigned, bits: 64}, local_scope, fns, structs, generics, runtime, m, ctx, builder) is alloc_size:
                            alloc_args: mutable darray[LLVMValueRef] = [alloc_region, runtime_size_argument(alloc_size, ctx, builder)]
                            alloc_args_pointer: void& = (&alloc_args[0]).cast[void&] can Unsafe.PointerCast
                            return LLVMBuildCall2(builder, runtime.arena_alloc_type, runtime.arena_alloc, alloc_args_pointer, 2, "arena.alloc")
                    return null
                # A GENERIC callee with an INFERRED type argument: `identity(42)`. The first
                # argument's own type supplies it — enough for the single-type-parameter
                # subset. A multi-parameter generic can't be inferred from one argument, so it
                # declines here and requires an explicit `f[K, V](…)`.
                # …unless a NON-GENERIC overload matches the arguments EXACTLY, which wins.
                # See exact_overload_exists.
                # The ENCLOSING module's own member wins over a same-named GENERIC, and is
                # checked BEFORE the generic dispatch below. Inside `module Box:`, `add(s, 7)`
                # means Box's `add`.
                #
                # Without this the generic fired first and the call was emitted as
                # `add__i64` -- the stdlib's `add[T](mutable Flags[T]&, T)`. It TYPE-CHECKED,
                # so the program compiled and returned 0 instead of 7: the stdlib call left
                # the caller's container untouched. A silent wrong answer, which is worse
                # than the hard error stage0 gave for the same program before its own fix.
                #
                # Preferred only on an EXACT arity match in the enclosing module, so this
                # narrows the candidate set rather than guessing inside it -- the same rule
                # the ambiguous-overload scan further down already uses.
                if structs.current_owner != "":
                    own_pre_hits: mutable i64 = 0
                    for own_pre in 0..<fns.names.count |own_pre_hits, callee_name, fns, arguments, structs|:
                        if fns.names[own_pre] == callee_name and fns.owners[own_pre] == structs.current_owner and fns.param_count[own_pre] == arguments.count:
                            own_pre_hits <- own_pre_hits + 1
                    if own_pre_hits == 1:
                        return emit_direct_call(structs.current_owner, callee_name, callee, false, arguments, argument_names, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                if generic_index_of(generics, callee_name) >= 0 and not exact_overload_exists(fns, callee_name, arguments, local_scope, structs, generics):
                    null return if arguments.count == 0
                    inferred_slot: usize = generic_index_of(generics, callee_name).usize()
                    inferred_args: darray[ValueType] = infer_generic_args(inferred_slot, arguments, local_scope, fns, structs, generics)
                    null return if inferred_args.count == 0
                    return emit_generic_call(callee_name, inferred_args, arguments, argument_names, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                # Sibling methods inside `module M:` call each other as bare names; those
                # functions are stored under owner M. Overloads share a name: resolve by
                # arity first, then unique-name owner fallback into emit_direct_call.
                if lookup_function(fns, "", callee_name) is top_level_fn:
                    return emit_direct_call("", callee_name, callee, false, arguments, argument_names, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                bare_arity: usize = arguments.count
                bare_owner: mutable sview = ""
                bare_hits: mutable i64 = 0
                bare_arity_hits: mutable i64 = 0
                for bare_scan in 0..<fns.names.count |bare_owner, bare_hits, bare_arity_hits, callee_name, fns, bare_arity|:
                    if fns.names[bare_scan] == callee_name:
                        bare_hits <- bare_hits + 1
                        bare_owner <- fns.owners[bare_scan]
                        bare_arity_hits <- bare_arity_hits + 1 if fns.param_count[bare_scan] == bare_arity else bare_arity_hits
                # One arity match under some owner, or a unique bare name: emit_direct_call
                # re-selects by arity against that owner.
                if bare_arity_hits == 1 or bare_hits == 1:
                    return emit_direct_call(bare_owner, callee_name, callee, false, arguments, argument_names, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                # Ambiguous ACROSS owners — but not ambiguous from where the call is WRITTEN.
                # A bare call inside `module M:` means M's own member whenever M has one of
                # that name and arity; that is what the comment above ("those functions are
                # stored under owner M") was describing, and the scan never checked it.
                #
                # Without this, `abs(left - right)` inside Std::Math lost to Std::Int::abs --
                # same name, same arity, different owner -- and declined. Because one decline
                # drops every function in the unit, that took the whole namespaced std down
                # with it: approx_equal, file_size, read_all, write_all, the json_* family and
                # the rest of the 465. stage0 resolves the same call correctly.
                #
                # Only the ENCLOSING module is preferred, and only on an exact arity match, so
                # this narrows the ambiguous set rather than guessing within it. Anything still
                # ambiguous after that declines as before -- a wrong callee is worse than a
                # decline.
                if structs.current_owner != "":
                    own_hits: mutable i64 = 0
                    for own_scan in 0..<fns.names.count |own_hits, callee_name, fns, bare_arity, structs|:
                        if fns.names[own_scan] == callee_name and fns.owners[own_scan] == structs.current_owner:
                            own_hits <- own_hits + 1 if fns.param_count[own_scan] == bare_arity else own_hits
                    if own_hits == 1:
                        return emit_direct_call(structs.current_owner, callee_name, callee, false, arguments, argument_names, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                # Multiple overloads across owners with same arity is ambiguous — decline.
                return null
            return emit_call_store_and_constructor(callee, arguments, argument_names, local_scope, fns, structs, generics, runtime, m, ctx, builder)
