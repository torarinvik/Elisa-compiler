extend Backend:
    private:
        def region_mark_forwarded(root: sview, parameter_position: usize, callee_fact_row: usize, params: darray[ParamDecl]&, structs: mutable StructTable&, fact_row: usize, changed: mutable bool&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                return if root == "" or root == "?"
                graph_slot: usize = structs.regions.region_alias_graph_active_slot
                if structs.regions.region_alias_graph_active and graph_slot < structs.regions.region_alias_graph_slot_rows.count and structs.regions.region_alias_graph_slot_rows[graph_slot] >= 0:
                    graph_failed: mutable bool = false
                    structs.regions.region_alias_graph_pending_nodes.truncate(0)
                    graph_row: usize = structs.regions.region_alias_graph_slot_rows[graph_slot].usize()
                    node_start: usize = structs.regions.region_alias_graph_node_starts[graph_row]
                    node_count: usize = structs.regions.region_alias_graph_node_counts[graph_row]
                    edge_start: usize = structs.regions.region_alias_graph_edge_starts[graph_row]
                    edge_count: usize = structs.regions.region_alias_graph_edge_counts[graph_row]
                    root_node: i64 = region_alias_graph_find_node(graph_slot, root, structs)
                    if root_node < 0:
                        # Every alias endpoint and parameter name is interned while the
                        # graph is built. A missing name therefore has no work in the old
                        # linear path either; keep the indexed graph active for later roots.
                        return
                    elif root_node.usize() < node_start or root_node.usize() - node_start >= node_count:
                        graph_failed <- true
                    else:
                        generation: u64 = region_alias_graph_next_generation(graph_slot, structs)
                        if generation == 0:
                            graph_failed <- true
                        else:
                            structs.regions.region_alias_graph_pending_nodes.push(root_node)
                            structs.regions.region_alias_graph_node_seen[root_node.usize()] <- generation
                            node_cursor: mutable usize = 0
                            while node_cursor < structs.regions.region_alias_graph_pending_nodes.count |node_cursor, structs, graph_row, node_start, node_count, edge_start, edge_count, generation, params, parameter_position, callee_fact_row, fact_row, changed, graph_failed|:
                                current_node: i64 = structs.regions.region_alias_graph_pending_nodes[node_cursor]
                                node_cursor <- node_cursor + 1.usize()
                                if current_node < 0 or current_node.usize() < node_start or current_node.usize() - node_start >= node_count:
                                    graph_failed <- true
                                    break
                                current_node_index: usize = current_node.usize()
                                if structs.regions.region_alias_graph_node_names[current_node_index] == "" or structs.regions.region_alias_graph_node_names[current_node_index] == "?":
                                    continue
                                edge_cursor: mutable i64 = structs.regions.region_alias_graph_node_heads[current_node_index]
                                edge_steps: mutable usize = 0
                                while edge_cursor >= 0 and edge_steps < edge_count |edge_cursor, edge_steps, structs, edge_start, edge_count, node_start, node_count, generation, graph_failed|:
                                    edge_index: usize = edge_cursor.usize()
                                    if edge_index < edge_start or edge_index - edge_start >= edge_count:
                                        graph_failed <- true
                                        break
                                    if structs.regions.region_alias_graph_edge_sources[edge_index] != current_node_index.i64():
                                        graph_failed <- true
                                        break
                                    target_node: i64 = structs.regions.region_alias_graph_edge_targets[edge_index]
                                    if target_node < 0 or target_node.usize() < node_start or target_node.usize() - node_start >= node_count:
                                        graph_failed <- true
                                        break
                                    if structs.regions.region_alias_graph_node_seen[target_node.usize()] != generation:
                                        structs.regions.region_alias_graph_node_seen[target_node.usize()] <- generation
                                        structs.regions.region_alias_graph_pending_nodes.push(target_node)
                                    edge_cursor <- structs.regions.region_alias_graph_edge_next[edge_index]
                                    edge_steps <- edge_steps + 1.usize()
                                if edge_cursor != -1:
                                    graph_failed <- true
                                break if graph_failed
                                caller_position: i64 = structs.regions.region_alias_graph_node_params[current_node_index]
                                if caller_position < -1 or (caller_position >= 0 and caller_position.usize() >= params.count):
                                    graph_failed <- true
                                    break
                                if caller_position >= 0:
                                    if params[caller_position.usize()].name != structs.regions.region_alias_graph_node_names[current_node_index]:
                                        graph_failed <- true
                                        break
                                    if fact_row >= structs.regions.region_fact_starts.count or fact_row >= structs.regions.region_fact_counts.count:
                                        graph_failed <- true
                                        break
                                    fact_start: usize = structs.regions.region_fact_starts[fact_row]
                                    fact_count: usize = structs.regions.region_fact_counts[fact_row]
                                    if caller_position.usize() >= fact_count or fact_start > structs.regions.region_fact_params.count or fact_count > structs.regions.region_fact_params.count - fact_start:
                                        graph_failed <- true
                                        break
                                    slot: usize = fact_start + caller_position.usize()
                                    if not structs.regions.region_fact_params[slot] and region_fact_parameter_has_region(callee_fact_row, parameter_position, structs):
                                        structs.regions.region_fact_params[slot] <- true
                                        changed <- true
                            if not graph_failed:
                                return
                    restored: bool = region_alias_graph_restore_linear_aliases(graph_slot, structs)
                    structs.regions.region_alias_graph_active <- false
                    if not restored:
                        region_mark_all_forwarded_parameters(parameter_position, callee_fact_row, params, structs, fact_row, changed)
                        return
                    # The indexed path validates the caller fact row before it mutates
                    # individual slots. If that validation caused the graph walk to fall
                    # back, keep the same fail-closed behavior here: the legacy path below
                    # indexes these rows directly.
                    if fact_row >= structs.regions.region_fact_starts.count or fact_row >= structs.regions.region_fact_counts.count:
                        region_mark_all_forwarded_parameters(parameter_position, callee_fact_row, params, structs, fact_row, changed)
                        return
                    fallback_fact_start: usize = structs.regions.region_fact_starts[fact_row]
                    fallback_fact_count: usize = structs.regions.region_fact_counts[fact_row]
                    if fallback_fact_start > structs.regions.region_fact_params.count or fallback_fact_count != params.count or fallback_fact_count > structs.regions.region_fact_params.count - fallback_fact_start:
                        region_mark_all_forwarded_parameters(parameter_position, callee_fact_row, params, structs, fact_row, changed)
                        return
                elif structs.regions.region_alias_graph_active:
                    structs.regions.region_alias_graph_active <- false
                    region_mark_all_forwarded_parameters(parameter_position, callee_fact_row, params, structs, fact_row, changed)
                    return
                has_alias: mutable bool = false
                for alias_index in 0..<structs.regions.region_alias_names.count |has_alias, structs, root|:
                    has_alias <- true if structs.regions.region_alias_names[alias_index] == root
                if not has_alias:
                    for caller_position in 0..<params.count |params, structs, fact_row, root, changed, callee_fact_row, parameter_position|:
                        continue if params[caller_position].name != root
                        slot: usize = structs.regions.region_fact_starts[fact_row] + caller_position
                        return if:
                            structs.regions.region_fact_params[slot]
                            not region_fact_parameter_has_region(callee_fact_row, parameter_position, structs)
                        structs.regions.region_fact_params[slot] <- true
                        changed <- true
                        return
                    return
                pending: mutable darray[sview @source] = [root]
                visited: mutable darray[sview @source] = []
                cursor: mutable usize = 0
                while cursor < pending.count |pending, visited, cursor, parameter_position, callee_fact_row, params, structs, fact_row, changed|:
                    current_root: sview @source = pending[cursor]
                    cursor <- cursor + 1
                    continue if current_root == "" or current_root == "?"
                    already_visited: mutable bool = false
                    for visited_index in 0..<visited.count |already_visited, visited, current_root|:
                        already_visited <- true if visited[visited_index] == current_root
                    continue if already_visited
                    visited.push(current_root)
                    for alias_index in 0..<structs.regions.region_alias_names.count |pending, structs, current_root|:
                        if structs.regions.region_alias_names[alias_index] == current_root:
                            pending.push(structs.regions.region_alias_roots[alias_index])
                    for caller_position in 0..<params.count |params, structs, fact_row, current_root, changed, callee_fact_row, parameter_position|:
                        continue if params[caller_position].name != current_root
                        slot: usize = structs.regions.region_fact_starts[fact_row] + caller_position
                        continue if structs.regions.region_fact_params[slot]
                        continue if not region_fact_parameter_has_region(callee_fact_row, parameter_position, structs)
                        structs.regions.region_fact_params[slot] <- true
                        changed <- true
                        break




        # Apply one possible callee declaration row. Overloaded declarations are unioned
        # below; each row gets its own labels, parameter count and forwarding facts.
        def region_forward_dependency_reset(structs: mutable StructTable&) -> void can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic, Memory.Allocate:
                structs.regions.region_fact_dependent_heads <- structs.regions.region_fact_dependent_heads.truncate(0)
                structs.regions.region_fact_dependent_next <- structs.regions.region_fact_dependent_next.truncate(0)
                structs.regions.region_fact_dependent_visits <- structs.regions.region_fact_dependent_visits.truncate(0)
                structs.regions.region_fact_dependency_last_visit <- structs.regions.region_fact_dependency_last_visit.truncate(0)
                structs.regions.region_forward_active_visit <- 0.usize()
                structs.regions.region_forward_recording <- false
                for _ in 0..<structs.regions.region_fact_names.count |structs|:
                    structs.regions.region_fact_dependent_heads.push(-1)
                    structs.regions.region_fact_dependency_last_visit.push(-1)


        def region_forward_dependency_record(callee_row: usize, structs: mutable StructTable&) -> void can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic, Memory.Allocate:
                return if:
                    not structs.regions.region_forward_recording
                    callee_row >= structs.regions.region_fact_dependent_heads.count or callee_row >= structs.regions.region_fact_dependency_last_visit.count
                active_visit: usize = structs.regions.region_forward_active_visit
                return if structs.regions.region_fact_dependency_last_visit[callee_row] == active_visit.i64()
                edge: usize = structs.regions.region_fact_dependent_visits.count
                structs.regions.region_fact_dependent_visits.push(active_visit)
                structs.regions.region_fact_dependent_next.push(structs.regions.region_fact_dependent_heads[callee_row])
                structs.regions.region_fact_dependent_heads[callee_row] <- edge.i64()
                structs.regions.region_fact_dependency_last_visit[callee_row] <- active_visit.i64()


        def region_forward_call_row(row: usize, arguments: darray[Expr]&, argument_names: darray[sview]&, receiver_offset: usize, named_call: bool, minimum_position: usize, receiver_root: sview, params: darray[ParamDecl]&, structs: mutable StructTable&, fact_row: usize, changed: mutable bool&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                return if row >= structs.regions.region_fact_starts.count or row >= structs.regions.region_fact_counts.count
                start: usize = structs.regions.region_fact_starts[row]
                count: usize = structs.regions.region_fact_counts[row]
                return if:
                    start > structs.regions.region_fact_params.count or count > structs.regions.region_fact_params.count - start
                    minimum_position >= count
                region_forward_dependency_record(row, structs)
                if receiver_offset == 1 and minimum_position == 0:
                    region_mark_forwarded(receiver_root, 0.usize(), row, params, structs, fact_row, changed)
                positions: mutable darray[i64] = []
                if named_call:
                    positions <- region_forward_argument_positions(argument_names, receiver_offset, row.i64(), structs)
                for argument_index in 0..<arguments.count |arguments, receiver_offset, named_call, positions, minimum_position, count, row, params, structs, fact_row, changed|:
                    root: sview = region_growth_root(arguments[argument_index])
                    position: mutable i64 = (argument_index + receiver_offset).i64()
                    if named_call:
                        position <- positions[argument_index] if argument_index < positions.count else -1
                    if position >= minimum_position.i64() and position < count.i64():
                        region_mark_forwarded(root, position.usize(), row, params, structs, fact_row, changed)
                    elif position < 0:
                        # An unmappable argument may occupy any compatible formal slot.
                        for any_position in minimum_position..<count |root, row, params, structs, fact_row, changed|:
                            region_mark_forwarded(root, any_position, row, params, structs, fact_row, changed)




        def region_scan_forwarding_expression(expression: Expr, params: darray[ParamDecl]&, structs: mutable StructTable&, fact_row: usize, changed: mutable bool&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                if expression is Expr.Call(region_forward_call_callee, region_forward_call_arguments, region_forward_call_names, region_forward_call_line):
                    callee_name: sview = region_callee_name(region_forward_call_callee)
                    receiver_offset: mutable usize = 0.usize()
                    if region_forward_call_callee is Expr.Field(region_forward_arity_receiver, region_forward_arity_method, region_forward_arity_line):
                        receiver_offset <- 1.usize()
                    callee_resolution: (owner: sview, resolved: bool) = region_callee_owner(region_forward_call_callee, region_forward_call_arguments.count + receiver_offset, structs)
                    callee_owner: sview = callee_resolution.owner
                    receiver_root: mutable sview = ""
                    if region_forward_call_callee is Expr.Field(region_forward_receiver, region_forward_method, region_forward_field_line):
                        receiver_root <- region_growth_root(region_forward_receiver)
                    # Named-versus-positional mode is call-wide; determine it once
                    # instead of rescanning the full names array for every argument.
                    named_call: mutable bool = false
                    for argument_name in region_forward_call_names |named_call|:
                        named_call <- true if argument_name != ""
                    indexed: bool = structs.regions.region_fact_buckets.count == REGION_FACT_BUCKET_COUNT and structs.regions.region_fact_next.count == structs.regions.region_fact_names.count
                    first_cursor: mutable i64 = structs.regions.region_fact_buckets[region_fact_name_bucket(callee_name)] if indexed else 0
                    exact_owner_found: mutable bool = false
                    ownerless_found: mutable bool = false
                    exact_owner_max_count: mutable usize = 0
                    while first_cursor >= 0 and first_cursor.usize() < structs.regions.region_fact_names.count |first_cursor, structs, callee_name, callee_owner, callee_resolution, exact_owner_found, ownerless_found, exact_owner_max_count, region_forward_call_arguments, region_forward_call_names, receiver_offset, named_call, receiver_root, params, fact_row, changed, indexed|:
                        candidate_row: usize = first_cursor.usize()
                        first_cursor <- structs.regions.region_fact_next[candidate_row] if indexed else first_cursor + 1
                        continue if structs.regions.region_fact_names[candidate_row] != callee_name
                        candidate_owner: sview = structs.regions.region_fact_owners[candidate_row]
                        if not callee_resolution.resolved:
                            region_forward_call_row(candidate_row, region_forward_call_arguments, region_forward_call_names, receiver_offset, named_call, 0.usize(), receiver_root, params, structs, fact_row, changed)
                        elif candidate_owner == callee_owner:
                            exact_owner_found <- true
                            exact_owner_max_count <- structs.regions.region_fact_counts[candidate_row] if structs.regions.region_fact_counts[candidate_row] > exact_owner_max_count
                            region_forward_call_row(candidate_row, region_forward_call_arguments, region_forward_call_names, receiver_offset, named_call, 0.usize(), receiver_root, params, structs, fact_row, changed)
                        elif callee_owner != "" and candidate_owner == "":
                            ownerless_found <- true
                    if callee_resolution.resolved and ownerless_found:
                        second_cursor: mutable i64 = structs.regions.region_fact_buckets[region_fact_name_bucket(callee_name)] if indexed else 0
                        while second_cursor >= 0 and second_cursor.usize() < structs.regions.region_fact_names.count |second_cursor, structs, callee_name, callee_owner, exact_owner_found, exact_owner_max_count, region_forward_call_arguments, region_forward_call_names, receiver_offset, named_call, receiver_root, params, fact_row, changed, indexed|:
                            candidate_row: usize = second_cursor.usize()
                            second_cursor <- structs.regions.region_fact_next[candidate_row] if indexed else second_cursor + 1
                            continue if structs.regions.region_fact_names[candidate_row] != callee_name or structs.regions.region_fact_owners[candidate_row] != ""
                            # Owner-less facts are the compatibility fallback for formal
                            # positions absent from every exact-owner declaration row.
                            minimum_position: usize = exact_owner_max_count if exact_owner_found else 0.usize()
                            region_forward_call_row(candidate_row, region_forward_call_arguments, region_forward_call_names, receiver_offset, named_call, minimum_position, receiver_root, params, structs, fact_row, changed)
                    elif callee_resolution.resolved and callee_owner != "" and not exact_owner_found:
                        # If owner resolution has no matching or owner-less row, union all
                        # same-name candidates so an ambiguous imported overload cannot hide a fact.
                        second_cursor: mutable i64 = structs.regions.region_fact_buckets[region_fact_name_bucket(callee_name)] if indexed else 0
                        while second_cursor >= 0 and second_cursor.usize() < structs.regions.region_fact_names.count |second_cursor, structs, callee_name, region_forward_call_arguments, region_forward_call_names, receiver_offset, named_call, receiver_root, params, fact_row, changed, indexed|:
                            candidate_row: usize = second_cursor.usize()
                            second_cursor <- structs.regions.region_fact_next[candidate_row] if indexed else second_cursor + 1
                            continue if structs.regions.region_fact_names[candidate_row] != callee_name
                            region_forward_call_row(candidate_row, region_forward_call_arguments, region_forward_call_names, receiver_offset, named_call, 0.usize(), receiver_root, params, structs, fact_row, changed)
                    region_scan_forwarding_expression(region_forward_call_callee, params, structs, fact_row, changed)
                    for region_forward_argument in region_forward_call_arguments |params, structs, fact_row, changed|:
                        region_scan_forwarding_expression(region_forward_argument, params, structs, fact_row, changed)
                    return
                if expression is Expr.Field(region_forward_field_object, region_forward_field_name, region_forward_field_line):
                    region_scan_forwarding_expression(region_forward_field_object, params, structs, fact_row, changed)
                    return
                if expression is Expr.Scope(region_forward_scope_base, region_forward_scope_name, region_forward_scope_line):
                    region_scan_forwarding_expression(region_forward_scope_base, params, structs, fact_row, changed)
                    return
                if expression is Expr.Index(region_forward_index_object, region_forward_index_value, region_forward_index_line):
                    region_scan_forwarding_expression(region_forward_index_object, params, structs, fact_row, changed)
                    region_scan_forwarding_expression(region_forward_index_value, params, structs, fact_row, changed)
                    return
                if expression is Expr.Slice(region_forward_slice_object, region_forward_slice_low, region_forward_slice_high, region_forward_slice_line):
                    region_scan_forwarding_expression(region_forward_slice_object, params, structs, fact_row, changed)
                    region_scan_forwarding_expression(region_forward_slice_low, params, structs, fact_row, changed)
                    region_scan_forwarding_expression(region_forward_slice_high, params, structs, fact_row, changed)
                    return
                if expression is Expr.IndexN(region_forward_indexn_object, region_forward_indexn_arguments, region_forward_indexn_line):
                    region_scan_forwarding_expression(region_forward_indexn_object, params, structs, fact_row, changed)
                    for region_forward_indexn_argument in region_forward_indexn_arguments |params, structs, fact_row, changed|:
                        region_scan_forwarding_expression(region_forward_indexn_argument, params, structs, fact_row, changed)
                    return
                if expression is Expr.Binary(region_forward_binary_left, region_forward_binary_operator, region_forward_binary_right, region_forward_binary_line):
                    region_scan_forwarding_expression(region_forward_binary_left, params, structs, fact_row, changed)
                    region_scan_forwarding_expression(region_forward_binary_right, params, structs, fact_row, changed)
                    return
                if expression is Expr.Unary(region_forward_unary_operator, region_forward_unary_operand, region_forward_unary_line):
                    region_scan_forwarding_expression(region_forward_unary_operand, params, structs, fact_row, changed)
                    return
                if expression is Expr.Move(region_forward_move_operand, region_forward_move_line):
                    region_scan_forwarding_expression(region_forward_move_operand, params, structs, fact_row, changed)
                    return
                if expression is Expr.RegionNew(region_forward_new_operand, region_forward_new_region, region_forward_new_line):
                    region_scan_forwarding_expression(region_forward_new_operand, params, structs, fact_row, changed)
                    return
                if expression is Expr.Paren(region_forward_paren_inner, region_forward_paren_line):
                    region_scan_forwarding_expression(region_forward_paren_inner, params, structs, fact_row, changed)
                    return
                if expression is Expr.Array(region_forward_array_elements, region_forward_array_line) or expression is Expr.Tuple(region_forward_array_elements, region_forward_tuple_line) or expression is Expr.SetLit(region_forward_array_elements, region_forward_set_line):
                    for region_forward_element in region_forward_array_elements |params, structs, fact_row, changed|:
                        region_scan_forwarding_expression(region_forward_element, params, structs, fact_row, changed)
                    return
                if expression is Expr.DictLit(region_forward_dict_entries, region_forward_dict_line):
                    for region_forward_entry in region_forward_dict_entries |params, structs, fact_row, changed|:
                        region_scan_forwarding_expression(region_forward_entry.key, params, structs, fact_row, changed)
                        region_scan_forwarding_expression(region_forward_entry.value, params, structs, fact_row, changed)
                    return
                if expression is Expr.Construct(region_forward_construct_type, region_forward_construct_fields, region_forward_construct_line):
                    region_scan_forwarding_expression(region_forward_construct_type, params, structs, fact_row, changed)
                    for region_forward_field_init in region_forward_construct_fields |params, structs, fact_row, changed|:
                        region_scan_forwarding_expression(region_forward_field_init.value, params, structs, fact_row, changed)
                    return
                if expression is Expr.RecordUpdate(region_forward_update_base, region_forward_update_fields, region_forward_update_line):
                    region_scan_forwarding_expression(region_forward_update_base, params, structs, fact_row, changed)
                    for region_forward_field_init in region_forward_update_fields |params, structs, fact_row, changed|:
                        region_scan_forwarding_expression(region_forward_field_init.value, params, structs, fact_row, changed)
                    return
                if expression is Expr.If(region_forward_if_condition, region_forward_if_then, region_forward_if_else, region_forward_if_line):
                    region_scan_forwarding_expression(region_forward_if_condition, params, structs, fact_row, changed)
                    region_scan_forwarding_expression(region_forward_if_then, params, structs, fact_row, changed)
                    region_scan_forwarding_expression(region_forward_if_else, params, structs, fact_row, changed)
                    return
                if expression is Expr.Match(region_forward_match_scrutinee, region_forward_match_arms, region_forward_match_line) or expression is Expr.Catch(region_forward_match_scrutinee, region_forward_match_arms, region_forward_catch_line):
                    region_scan_forwarding_expression(region_forward_match_scrutinee, params, structs, fact_row, changed)
                    for region_forward_arm in region_forward_match_arms |params, structs, fact_row, changed|:
                        region_scan_forwarding_expression(region_forward_arm.guard, params, structs, fact_row, changed)
                        region_scan_forwarding_statements(region_forward_arm.body, params, structs, fact_row, changed)
                    return
                if expression is Expr.Comprehension(region_forward_comp_var, region_forward_comp_iterable, region_forward_comp_condition, region_forward_comp_body, region_forward_comp_line, _):
                    region_scan_forwarding_expression(region_forward_comp_iterable, params, structs, fact_row, changed)
                    region_scan_forwarding_expression(region_forward_comp_condition, params, structs, fact_row, changed)
                    region_scan_forwarding_expression(region_forward_comp_body, params, structs, fact_row, changed)
                    return
                if expression is Expr.Refinement(region_forward_refinement_base, region_forward_refinement_predicate, region_forward_refinement_line):
                    region_scan_forwarding_expression(region_forward_refinement_base, params, structs, fact_row, changed)
                    region_scan_forwarding_expression(region_forward_refinement_predicate, params, structs, fact_row, changed)
                    return
                if expression is Expr.GetElse(region_forward_get_guarded, region_forward_get_recovery, region_forward_get_line):
                    region_scan_forwarding_expression(region_forward_get_guarded, params, structs, fact_row, changed)
                    region_scan_forwarding_statements(region_forward_get_recovery, params, structs, fact_row, changed)
                    return
                if expression is Expr.Block(region_forward_block_statements, region_forward_block_value, region_forward_block_captures, region_forward_block_line):
                    region_scan_forwarding_statements(region_forward_block_statements, params, structs, fact_row, changed)
                    region_scan_forwarding_expression(region_forward_block_value, params, structs, fact_row, changed)
                    return
                if expression is Expr.StaticEffectCall(region_forward_effect_type, region_forward_effect_operation, region_forward_effect_candidates, region_forward_effect_arguments, region_forward_effect_names, region_forward_effect_line):
                    for region_forward_effect_call in region_static_effect_candidate_calls(expression) |params, structs, fact_row, changed|:
                        region_scan_forwarding_expression(region_forward_effect_call, params, structs, fact_row, changed)
                    return




        def region_scan_forwarding_statements(statements: darray[Stmt], params: darray[ParamDecl]&, structs: mutable StructTable&, fact_row: usize, changed: mutable bool&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                for region_forward_statement in statements |params, structs, fact_row, changed|:
                    if region_forward_statement is Stmt.Expr(region_forward_statement_expression, region_forward_statement_line):
                        region_scan_forwarding_expression(region_forward_statement_expression, params, structs, fact_row, changed)
                    elif region_forward_statement is Stmt.VarDecl(region_forward_var_name, region_forward_var_type, region_forward_var_value, region_forward_var_line):
                        region_scan_forwarding_expression(region_forward_var_value, params, structs, fact_row, changed)
                    elif region_forward_statement is Stmt.Assign(region_forward_assign_target, region_forward_assign_operator, region_forward_assign_value, region_forward_assign_line):
                        region_scan_forwarding_expression(region_forward_assign_target, params, structs, fact_row, changed)
                        region_scan_forwarding_expression(region_forward_assign_value, params, structs, fact_row, changed)
                    elif region_forward_statement is Stmt.Return(region_forward_return_value, region_forward_return_line):
                        if region_forward_return_value is region_forward_returned:
                            region_scan_forwarding_expression(region_forward_returned, params, structs, fact_row, changed)
                    elif region_forward_statement is Stmt.If(region_forward_stmt_if_condition, region_forward_stmt_if_then, region_forward_stmt_if_else, region_forward_stmt_if_line):
                        region_scan_forwarding_expression(region_forward_stmt_if_condition, params, structs, fact_row, changed)
                        region_scan_forwarding_statements(region_forward_stmt_if_then, params, structs, fact_row, changed)
                        region_scan_forwarding_statements(region_forward_stmt_if_else, params, structs, fact_row, changed)
                    elif region_forward_statement is Stmt.While(region_forward_stmt_while_condition, region_forward_stmt_while_body, region_forward_stmt_while_line):
                        region_scan_forwarding_expression(region_forward_stmt_while_condition, params, structs, fact_row, changed)
                        region_scan_forwarding_statements(region_forward_stmt_while_body, params, structs, fact_row, changed)
                    elif region_forward_statement is Stmt.For(region_forward_for_bind, region_forward_for_variables, region_forward_for_iterable, region_forward_for_body, region_forward_for_line):
                        region_scan_forwarding_expression(region_forward_for_iterable, params, structs, fact_row, changed)
                        region_scan_forwarding_statements(region_forward_for_body, params, structs, fact_row, changed)
                    elif region_forward_statement is Stmt.Block(region_forward_stmt_block_kind, region_forward_stmt_block_clause, region_forward_stmt_block_binding, region_forward_stmt_block_body, region_forward_stmt_block_line):
                        region_scan_forwarding_statements(region_forward_stmt_block_body, params, structs, fact_row, changed)
                    elif region_forward_statement is Stmt.Match(region_forward_stmt_match_scrutinee, region_forward_stmt_match_arms, region_forward_stmt_match_line):
                        region_scan_forwarding_expression(region_forward_stmt_match_scrutinee, params, structs, fact_row, changed)
                        for region_forward_stmt_arm in region_forward_stmt_match_arms |params, structs, fact_row, changed|:
                            region_scan_forwarding_expression(region_forward_stmt_arm.guard, params, structs, fact_row, changed)
                            region_scan_forwarding_statements(region_forward_stmt_arm.body, params, structs, fact_row, changed)
                    elif region_forward_statement is Stmt.Contract(region_forward_contract_kind, region_forward_contract_expression, region_forward_contract_line):
                        region_scan_forwarding_expression(region_forward_contract_expression, params, structs, fact_row, changed)




        # A generic TEMPLATE is scanned before any instantiation exists, so its type
        # parameters are unbound and `out: mutable darray[T]&` resolved Unmodeled -- never
        # growable. Its fact row then said "no region" for a parameter the body pushes into:
        # every instantiation took no arena slot and grew the caller's darray in its own auto
        # region, freed on return (a silent 160 where stage0 gives 164). Bind each type
        # parameter to a scalar placeholder for the scan; growability of a container
        # reference does not depend on its element type. Returns the bindings pushed (0 for
        # an ordinary function).
        def region_bind_template_placeholders(name: sview, owner: sview, line: u32, owner_offset: u32, generics: GenericTable&, structs: mutable StructTable&, placeholders: mutable darray[ValueType]&) -> usize can[Abort.Panic, Memory.Allocate]:
            return 0 if:
                generics.names.count != generics.decls.count
                generics.names.count != generics.owners.count
                generics.names.count != generics.param_count.count
            # Use the append-only name chain, preserving declaration order for duplicate
            # templates while avoiding a scan of every generic declaration for each function.
            # Name is only an index; the lexical owner and offset+1 declaration identity
            # must also match because `#line` can give same-name module templates one line.
            template_cursor: mutable i64 = name_chain_first(generics.name_buckets, generics.name_next, generics.names, name)
            while template_cursor >= 0 |generics, structs, name, owner, line, owner_offset, template_cursor|:
                template_slot: usize = template_cursor.usize()
                template_cursor <- name_chain_next(generics.name_buckets, generics.name_next, generics.names, name, template_cursor)
                continue if template_slot >= generics.owners.count or generics.owners[template_slot] != owner
                template_identity_matches: mutable bool = false
                if generics.decls[template_slot] is Decl.Func(template_name, template_params, template_return, template_body, template_effects, template_decorators, template_line):
                    template_identity_matches <- template_name == name and template_line.line == line and template_line.offset + 1 == owner_offset
                continue if not template_identity_matches
                placeholders <- placeholders.truncate(0)
                for _ in 0..<generics.param_count[template_slot] |placeholders|:
                    placeholders.push(scalar_type_of_name("i64", structs.target.target_pointer_bits))
                return push_type_bindings(generics, structs, template_slot, placeholders)
            return 0




        def region_record_declarations(declarations: darray[Decl], owner: sview, structs: mutable StructTable&, generics: GenericTable&, placeholders: mutable darray[ValueType]&, flags: mutable darray[bool]&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                for declaration in declarations |structs, generics, placeholders, flags|:
                    if declaration is Decl.Func(region_fact_name, region_fact_params, region_fact_return, region_fact_body, region_fact_effects, region_fact_decorators, region_fact_line):
                        flags <- flags.truncate(0)
                        graph_slot: usize = structs.regions.region_fact_names.count
                        region_alias_graph_ensure_slot(graph_slot, structs)
                        previous_owner: sview = structs.visibility.current_owner
                        structs.visibility.current_owner <- owner
                        placeholder_bound: usize = region_bind_template_placeholders(region_fact_name, owner, region_fact_line.line, region_fact_line.offset + 1, generics, structs, placeholders)
                        body_region_parameter_flags(region_fact_params, region_fact_body, graph_slot, structs, flags)
                        pop_type_bindings(structs, placeholder_bound)
                        structs.visibility.current_owner <- previous_owner
                        structs.regions.region_fact_names <- structs.regions.region_fact_names.push(region_fact_name)
                        structs.regions.region_fact_owners <- structs.regions.region_fact_owners.push(owner)
                        structs.regions.region_fact_lines <- structs.regions.region_fact_lines.push(region_fact_line.line)
                        # Keep fact keys in the same offset+1 domain as function_offset_of,
                        # FnTable offsets, and signature ABI callers.
                        structs.regions.region_fact_offsets <- structs.regions.region_fact_offsets.push(region_fact_line.offset + 1)
                        line_chain_extend(structs.regions.region_fact_line_buckets, structs.regions.region_fact_line_tails, structs.regions.region_fact_line_next, structs.regions.region_fact_lines)
                        structs.regions.region_fact_starts <- structs.regions.region_fact_starts.push(structs.regions.region_fact_params.count)
                        structs.regions.region_fact_counts <- structs.regions.region_fact_counts.push(region_fact_params.count)
                        for flag in flags |structs|:
                            structs.regions.region_fact_params <- structs.regions.region_fact_params.push(flag)
                        for region_fact_param in region_fact_params |structs|:
                            structs.regions.region_fact_param_names <- structs.regions.region_fact_param_names.push(region_fact_param.name)
                    elif declaration is Decl.Module(region_fact_module_name, region_fact_module_body, region_fact_module_line):
                        region_record_declarations(region_fact_module_body, region_fact_module_name, structs, generics, placeholders, flags)
                    elif declaration is Decl.Scoped(region_fact_scoped_body, region_fact_scoped_line):
                        region_record_declarations(region_fact_scoped_body, owner, structs, generics, placeholders, flags)




        def region_collect_forwarding_visits(declarations: darray[Decl], owner: sview, structs: mutable StructTable&, visits: mutable darray[Decl]&, visit_owners: mutable darray[sview]&, visit_rows: mutable darray[i64]&, managed_by_visit: mutable darray[bool]&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                for declaration in declarations |structs, visits, visit_owners, visit_rows, managed_by_visit|:
                    if declaration is Decl.Func(region_forward_fact_name, region_forward_fact_params, region_forward_fact_return, region_forward_fact_body, region_forward_fact_effects, region_forward_fact_decorators, region_forward_fact_line):
                        row: i64 = region_fact_row(region_forward_fact_name, owner, region_forward_fact_line.line, region_forward_fact_line.offset + 1, structs)
                        visits.push(declaration)
                        visit_owners.push(owner)
                        visit_rows.push(row)
                        managed_by_visit.push(row >= 0 and params_manage_arena(region_forward_fact_params, structs))
                    elif declaration is Decl.Module(region_forward_module_name, region_forward_module_body, region_forward_module_line):
                        region_collect_forwarding_visits(region_forward_module_body, region_forward_module_name, structs, visits, visit_owners, visit_rows, managed_by_visit)
                    elif declaration is Decl.Scoped(region_forward_scoped_body, region_forward_scoped_line):
                        region_collect_forwarding_visits(region_forward_scoped_body, owner, structs, visits, visit_owners, visit_rows, managed_by_visit)



        def region_apply_forwarding_visit(declaration: Decl, owner: sview, row: i64, arena_managed: bool, visit_slot: usize, structs: mutable StructTable&, generics: GenericTable&, alias_starts: mutable darray[usize]&, alias_counts: mutable darray[usize]&, alias_names: mutable darray[sview @source]&, alias_roots: mutable darray[sview @source]&, placeholders: mutable darray[ValueType]&) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                if declaration is Decl.Func(region_forward_fact_name, region_forward_fact_params, region_forward_fact_return, region_forward_fact_body, region_forward_fact_effects, region_forward_fact_decorators, region_forward_fact_line):
                    if row >= 0 and not arena_managed:
                        previous_owner: sview = structs.visibility.current_owner
                        structs.visibility.current_owner <- owner
                        forward_placeholder_bound: usize = region_bind_template_placeholders(region_forward_fact_name, owner, region_forward_fact_line.line, region_forward_fact_line.offset + 1, generics, structs, placeholders)
                        graph_candidate: bool = visit_slot < structs.regions.region_alias_graph_slot_rows.count and structs.regions.region_alias_graph_slot_rows[visit_slot] >= 0
                        graph_ready: bool = graph_candidate and region_alias_graph_row_valid(visit_slot, structs)
                        if graph_ready:
                            region_alias_cache_visit(visit_slot, false, false, structs, alias_starts, alias_counts, alias_names, alias_roots)
                        elif graph_candidate:
                            # The graph is immutable after publication. If its metadata
                            # no longer validates, rebuild the flat collector output from
                            # this in-scope body once and keep using the linear path.
                            if visit_slot == alias_starts.count:
                                region_load_aliases(region_forward_fact_body, structs)
                                region_alias_cache_visit(visit_slot, true, false, structs, alias_starts, alias_counts, alias_names, alias_roots)
                            elif alias_counts[visit_slot] == 0:
                                region_load_aliases(region_forward_fact_body, structs)
                                region_alias_cache_visit(visit_slot, true, false, structs, alias_starts, alias_counts, alias_names, alias_roots)
                            else:
                                region_alias_cache_visit(visit_slot, false, true, structs, alias_starts, alias_counts, alias_names, alias_roots)
                        elif visit_slot == alias_starts.count:
                            region_load_aliases(region_forward_fact_body, structs)
                            region_alias_cache_visit(visit_slot, true, false, structs, alias_starts, alias_counts, alias_names, alias_roots)
                        else:
                            region_alias_cache_visit(visit_slot, false, true, structs, alias_starts, alias_counts, alias_names, alias_roots)
                        structs.regions.region_alias_graph_active_slot <- visit_slot
                        structs.regions.region_alias_graph_active <- graph_ready
                        structs.regions.region_forward_active_visit <- visit_slot
                        structs.regions.region_forward_recording <- true
                        visit_changed: mutable bool = false
                        region_scan_forwarding_statements(region_forward_fact_body, region_forward_fact_params, structs, row.usize(), visit_changed)
                        structs.regions.region_forward_recording <- false
                        structs.regions.region_alias_graph_active <- false
                        pop_type_bindings(structs, forward_placeholder_bound)
                        structs.visibility.current_owner <- previous_owner
                        return visit_changed
                    structs.regions.region_forward_recording <- false
                    structs.regions.region_alias_graph_active <- false
                    region_alias_cache_visit(visit_slot, false, false, structs, alias_starts, alias_counts, alias_names, alias_roots)
                return false




        def register_region_abi_facts(top: darray[Decl], structs: mutable StructTable&, generics: GenericTable&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                # Retain scratch capacity across functions and rounds. Each consumer copies
                # its values into the region fact or binding tables before the next truncate.
                placeholders: mutable darray[ValueType] = []
                flags: mutable darray[bool] = []
                region_record_declarations(top, "", structs, generics, placeholders, flags)
                region_build_name_index(structs)
                # Keep stable declaration-order visits, but scan a body again only when a
                # callee fact row it reads changes. Facts are monotone, so this queue reaches
                # the same fixed point as repeated whole-tree scans.
                visits: mutable darray[Decl] = []
                visit_owners: mutable darray[sview] = []
                visit_rows: mutable darray[i64] = []
                managed_by_visit: mutable darray[bool] = []
                alias_starts: mutable darray[usize] = []
                alias_counts: mutable darray[usize] = []
                alias_names: mutable darray[sview @source] = []
                alias_roots: mutable darray[sview @source] = []
                region_collect_forwarding_visits(top, "", structs, visits, visit_owners, visit_rows, managed_by_visit)
                region_forward_dependency_reset(structs)
                placeholders <- placeholders.truncate(0)
                visit_queue: mutable darray[usize] = []
                visit_queued: mutable darray[bool] = []
                for visit_slot in 0..<visits.count |visit_queue, visit_queued|:
                    visit_queue.push(visit_slot)
                    visit_queued.push(true)
                queue_cursor: mutable usize = 0
                while queue_cursor < visit_queue.count |structs, generics, visits, visit_owners, visit_rows, managed_by_visit, alias_starts, alias_counts, alias_names, alias_roots, placeholders, visit_queue, visit_queued, queue_cursor|:
                    visit_slot: usize = visit_queue[queue_cursor]
                    queue_cursor <- queue_cursor + 1.usize()
                    visit_queued[visit_slot] <- false
                    visit_row: i64 = visit_rows[visit_slot]
                    visit_changed: bool = region_apply_forwarding_visit(visits[visit_slot], visit_owners[visit_slot], visit_row, managed_by_visit[visit_slot], visit_slot, structs, generics, alias_starts, alias_counts, alias_names, alias_roots, placeholders)
                    if visit_changed and visit_row >= 0 and visit_row.usize() < structs.regions.region_fact_dependent_heads.count:
                        dependency_edge: mutable i64 = structs.regions.region_fact_dependent_heads[visit_row.usize()]
                        dependency_steps: mutable usize = 0
                        while dependency_edge >= 0 and dependency_edge.usize() < structs.regions.region_fact_dependent_visits.count and dependency_steps < structs.regions.region_fact_dependent_visits.count |structs, dependency_edge, dependency_steps, visit_queue, visit_queued|:
                            dependency_index: usize = dependency_edge.usize()
                            dependency_edge <- structs.regions.region_fact_dependent_next[dependency_index] if dependency_index < structs.regions.region_fact_dependent_next.count else -1
                            dependent_visit: usize = structs.regions.region_fact_dependent_visits[dependency_index]
                            if dependent_visit < visit_queued.count and not visit_queued[dependent_visit]:
                                visit_queue.push(dependent_visit)
                                visit_queued[dependent_visit] <- true
                            dependency_steps <- dependency_steps + 1.usize()
                    if queue_cursor == visit_queue.count:
                        visit_queue <- visit_queue.truncate(0)
                        queue_cursor <- 0.usize()
                    elif queue_cursor >= visits.count:
                        # Each visit can be pending only once, so the unconsumed suffix is
                        # bounded by visits.count. Compact the consumed prefix periodically
                        # to keep queue storage O(number of declarations), even across many
                        # propagation waves.
                        pending_count: usize = visit_queue.count - queue_cursor
                        for pending_index in 0..<pending_count |visit_queue, queue_cursor, pending_count|:
                            visit_queue[pending_index] <- visit_queue[queue_cursor + pending_index]
                        visit_queue <- visit_queue.truncate(pending_count)
                        queue_cursor <- 0.usize()
                structs.regions.region_forward_recording <- false
