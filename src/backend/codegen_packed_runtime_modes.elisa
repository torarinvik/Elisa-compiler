# Construct a runtime view for one packed ABI, reusing LLVM declarations when
# another store in the same module has already requested that ABI.
extend Backend:
    private:
        def packed_runtime_for_mode[@r](runtime: Runtime& @r, mode: i32, m: LLVMModuleRef, ctx: LLVMContextRef, target_bits: u32) -> Runtime @r can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            return copied_runtime(runtime) if runtime.packed_mode == mode
            types: RuntimeCoreTypes = runtime_core_types(ctx, mode, target_bits)
            inactive: LLVMValueRef = LLVMConstNull(types.pointer)
            state: LLVMValueRef = declare_or_get_named(m, "ctx_aos_store_new" if mode == 2 else ("ctx_packed_store_state_new" if mode == 1 else "ctx_packed_store_state_new_variant_sparse"), types.state_new)
            state_side: LLVMValueRef = declare_or_get_named(m, "ctx_aos_store_new_with_side_words" if mode == 2 else ("ctx_packed_store_state_new_with_side_words" if mode == 1 else "ctx_packed_store_state_new_variant_sparse_with_side_words"), types.state_new_side)
            alloc: LLVMValueRef = declare_or_get_named(m, "ctx_aos_store_alloc" if mode == 2 else ("ctx_packed_store_alloc_fixed_tagged_index_result" if mode == 1 else "ctx_packed_store_alloc_fixed_tagged_variant_sparse_result"), types.packed_alloc)
            tag: LLVMValueRef = declare_or_get_named(m, "ctx_aos_store_record" if mode == 2 else ("ctx_packed_store_read_index_tag" if mode == 1 else "ctx_packed_store_read_variant_sparse_tag"), types.read_tag)
            word: LLVMValueRef = tag if mode == 2 else declare_or_get_named(m, "ctx_packed_store_read_index_word" if mode == 1 else "ctx_packed_store_read_variant_sparse_word", types.read_word)
            prefix: LLVMValueRef = declare_or_get_named(m, "ctx_packed_store_record_prefix_words", types.record_prefix) if mode == 1 else inactive
            side: LLVMValueRef = declare_or_get_named(m, "ctx_aos_store_record_side_words_at" if mode == 2 else "ctx_packed_store_record_side_words_at", types.record_side_words)
            side_word: LLVMValueRef = declare_or_get_named(m, "ctx_aos_store_read_side_word" if mode == 2 else "ctx_packed_store_read_side_word", types.read_side_word)
            result: Runtime = copied_runtime(runtime)
            return result{packed_mode = mode, packed_state_new = state, packed_state_new_type = types.state_new, packed_state_new_side = state_side, packed_state_new_side_type = types.state_new_side, packed_alloc = alloc, packed_alloc_type = types.packed_alloc, packed_alloc_result_type = types.alloc_result, packed_read_tag = tag, packed_read_tag_type = types.read_tag, packed_read_word = word, packed_read_word_type = types.read_word, packed_record_prefix = prefix, packed_record_prefix_type = types.record_prefix, packed_record_side_words = side, packed_record_side_words_type = types.record_side_words, packed_read_side_word = side_word, packed_read_side_word_type = types.read_side_word}

        # build_heavy stores index only common-prefix words. Payload reads fall
        # back to the row; indexing every word would defeat the profile's purpose.
        def packed_state_for_slot(structs: mutable StructTable&, slot: i64, runtime: Runtime&, arena: LLVMValueRef, row_bytes: i64, side_words: u32, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            size_type: LLVMTypeRef = runtime_size_llvm_type(ctx, structs.target.target_pointer_bits)
            args: mutable darray[LLVMValueRef] = [arena, LLVMConstInt(size_type, row_bytes.u64(), 0)]
            fn: mutable LLVMValueRef = runtime.packed_state_new
            fn_type: mutable LLVMTypeRef = runtime.packed_state_new_type
            if runtime.packed_mode == 1 and packed_profile_at_slot(structs, slot) == "build_heavy":
                commons: u32 = packed_aos_common_count(structs, slot)
                prefix: u32 = packed_legacy_payload_word_offset(structs, slot) if commons > 0 else 0
                args.push(LLVMConstInt(size_type, prefix.u64(), 0))
                if side_words > 0:
                    args.push(LLVMConstInt(size_type, side_words.u64(), 0))
                    params: mutable darray[LLVMTypeRef] = [LLVMPointerTypeInContext(ctx, 0), size_type, size_type, size_type]
                    params_pointer: void& = (&params[0]).cast[void&] can Unsafe.PointerCast
                    fn_type <- LLVMFunctionType(LLVMPointerTypeInContext(ctx, 0), params_pointer, 4, 0)
                    fn <- declare_or_get_named(m, "ctx_packed_store_state_new_with_prefix_and_side_words", fn_type)
                else:
                    fn_type <- runtime.packed_state_new_side_type
                    fn <- declare_or_get_named(m, "ctx_packed_store_state_new_with_prefix_words", fn_type)
            elif side_words > 0:
                args.push(LLVMConstInt(size_type, side_words.u64(), 0))
                fn <- runtime.packed_state_new_side
                fn_type <- runtime.packed_state_new_side_type
            args_pointer: void& = (&args[0]).cast[void&] can Unsafe.PointerCast
            return LLVMBuildCall2(builder, fn_type, fn, args_pointer, args.count.u32(), "packed.store.state")
