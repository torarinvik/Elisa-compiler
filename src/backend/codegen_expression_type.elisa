# Stage1 backend — the TYPE an expression yields, computed WITHOUT emitting anything. Every
# emitter asks this before it commits to a shape, so it must model exactly what the emitters
# go on to build. Part of `module Backend` (see codegen.elisa).

extend Backend:
    private:


        # The type an expression yields, WITHOUT emitting anything.
        #
        # Bottom-up, and deliberately partial: an integer LITERAL has no type of its own
        # (Unmodeled) and adopts whatever its context supplies. That is why the emitters
        # thread an `expected` type downward — `a: u8 = 200` must make 200 a u8, not an
        # i64 that is then silently truncated.
        def expression_type(expression: Expr, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&) -> ValueType can[Abort.Panic]:
            can Abort.Panic:
                return expression_type_depth(expression, local_scope, fns, structs, generics, 0)



        # Whether an arithmetic expression tree contains a FLOAT literal. Literals remain
        # context-typed when they stand alone (`x: f32 = 1.5`), so expression_type deliberately
        # answers Unmodeled for a bare FloatLit. That is not enough for an all-literal arithmetic
        # tree, though: `0 / (0.1875 / 2)` has no typed leaf on the left of either binary node,
        # yet C's usual arithmetic conversion requires the whole tree to be floating-point.
        # Keep this helper limited to transparent arithmetic wrappers; a float buried in a call
        # argument or aggregate must not change the type of the enclosing expression.
        def arithmetic_tree_contains_float_literal(expression: Expr) -> bool:
            match expression:
                Expr.FloatLit(_, _):
                    return true
                Expr.Paren(arithmetic_paren_inner, _):
                    return arithmetic_tree_contains_float_literal(arithmetic_paren_inner)
                Expr.Unary(arithmetic_unary_operator, arithmetic_unary_operand, _):
                    return arithmetic_tree_contains_float_literal(arithmetic_unary_operand) if arithmetic_unary_operator == TokenKind.Plus or arithmetic_unary_operator == TokenKind.Minus else false
                Expr.Binary(arithmetic_left, arithmetic_operator, arithmetic_right, _):
                    return arithmetic_tree_contains_float_literal(arithmetic_left) or arithmetic_tree_contains_float_literal(arithmetic_right) if arithmetic_operator == TokenKind.Plus or arithmetic_operator == TokenKind.Minus or arithmetic_operator == TokenKind.Star or arithmetic_operator == TokenKind.Slash or arithmetic_operator == TokenKind.Percent else false
                _:
                    pass
            return false



        # The recursive body of `expression_type`, with an explicit DEPTH so a pathologically
        # left-nested expression (`1 + 1 + 1 + … ` thousands deep — adversarial input, not
        # anything a real program writes) cannot blow up. Every caller OUTSIDE this function
        # goes through the depth=0 wrapper above; every self-recursive call below increments
        # depth by one. Without the cap, a chain of N binary operators cost O(N^2): this
        # function is called once per level of the emitter's own recursion into `binary_left`
        # (see emit_expression_binary_tail), and at EACH of those N levels this function walks
        # the (still O(N)-long) remaining left spine again. Measured: an N=20000 chain took
        # 44s and one nearly 3x deeper N=50000 chain still had not finished after 120s wall
        # time (all CPU, not I/O) — a hang, not a slow-but-bounded compile. A depth-only cap
        # bounds the STACK but not the total WORK: with the cap at 1000, N=300000+ chains still
        # took >90s (still effectively O(N * cap)). 200 keeps the worst case cheap while
        # remaining an order of magnitude past any nesting a hand-written or generated
        # expression plausibly reaches — self-hosting this compiler is the check that it
        # never fires on real code. Past the cap this answers Unmodeled, the same "give up,
        # let the caller fall back to its own context/expected type" answer literals already
        # give — safe because no genuine expression nests anywhere near this deep; only an
        # adversarial one does.
        def expression_type_depth(expression: Expr, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, depth: i64) -> ValueType can[Abort.Panic]:
            unmodeled_type() return if depth > 200
            if expression is Expr.StaticEffectCall(_, _, _, _, _, _):
                can Memory.Allocate, Unsafe.PointerCast:
                    if lower_static_effect_call(expression, structs) is direct_call:
                        return expression_type_depth(direct_call, local_scope, fns, structs, generics, depth + 1)
                    return unmodeled_type()
            match expression:
                Expr.Ident(ident_name, ident_line):
                    # A LOCAL shadows a global const, so the scope is consulted first.
                    local_type: ValueType = lookup_type(local_scope, ident_name)
                    local_type return if local_type.kind != TypeKind.Unmodeled
                    mutable_global_index: i64 = mutable_global_index_of(structs, ident_name)
                    copied_type(structs.mutable_global_types[mutable_global_index.usize()]) return if mutable_global_index >= 0
                    # Definitions win over declaration-only extern rows. In a
                    # multi-translation-unit C project an incomplete `extern
                    # T values[]` must not turn the completed global into a
                    # pointer-shaped type during expression inference.
                    extern_global_index: i64 = extern_global_index_of(structs, ident_name)
                    copied_type(structs.extern_global_types[extern_global_index.usize()]) return if extern_global_index >= 0
                    const_index: i64 = const_index_of(structs, ident_name)
                    copied_type(structs.const_types[const_index.usize()]) return if const_index >= 0 and structs.const_resolved[const_index.usize()]
                    # A global const AGGREGATE is not scalar-folded but still has a known type.
                    copied_type(structs.const_types[const_index.usize()]) return if const_index >= 0 and structs.const_global_ok[const_index.usize()]
                    return unmodeled_type()
                _:
                    pass
            # `Module::NAME` naming a CONST or GLOBAL has that binding's type. Typed the way
            # codegen_expr_idents_binary EMITS it -- the bare name resolved as if inside the
            # named module -- so inference and emission can never disagree about which
            # binding the qualifier means. Without this arm the qualified spelling was
            # Unmodeled while the bare one was typed, and a postfix cast on it took
            # resolve_type's Signed-64 fallback: `UiPaint::HAIRLINE_WIDTH.f64()` on an f32
            # const emitted `sitofp float 1.0 to double`, which LLVM cannot select and
            # aborts the whole build on. A qualifier that names no const or global (an enum
            # or a type path) falls through to the arms below untouched.
            match expression:
                Expr.Scope(scope_base, scope_name, scope_line):
                    if scope_base is Expr.Ident(scope_module, scope_module_line):
                        if lookup_type(local_scope, scope_name).kind == TypeKind.Unmodeled:
                            scoped_saved_owner: sview = structs.current_owner
                            structs.current_owner <- scope_module
                            scoped_type: ValueType = expression_type_depth((Expr.Ident(scope_name, scope_line)), local_scope, fns, structs, generics, depth + 1)
                            structs.current_owner <- scoped_saved_owner
                            scoped_type return if scoped_type.kind != TypeKind.Unmodeled
                _:
                    pass
            match expression:
                Expr.Paren(paren_inner, paren_line):
                    return expression_type_depth(paren_inner, local_scope, fns, structs, generics, depth + 1)
                _:
                    pass
            # A move has the moved value's type: it transfers ownership, not representation.
            match expression:
                Expr.Move(moved_value, move_line):
                    return expression_type_depth(moved_value, local_scope, fns, structs, generics, depth + 1)
                _:
                    pass
            # `new[r] value` is an expression whose result is a reference to the value copied
            # into the named arena.  Most uses already provide an expected `T&` from a typed
            # declaration, but a discarded expression statement has no surrounding type
            # context.  Infer the pointee from the operand (with the same scalar defaults used
            # by a standalone discarded literal), then expose the actual reference result to
            # the statement emitter.  A packed-store allocation uses this AST wrapper as a
            # constructor selector rather than an arena reference, so retain the operand type
            # for non-Arena selectors and let that specialized lowering decide.
            match expression:
                Expr.RegionNew(region_operand, region_name, region_line):
                    if lookup_type(local_scope, region_name).kind == TypeKind.Arena:
                        region_pointee: mutable ValueType = expression_type_depth(region_operand, local_scope, fns, structs, generics, depth + 1)
                        if region_pointee.kind == TypeKind.Unmodeled:
                            match region_operand:
                                Expr.IntLit:
                                    region_pointee <- ValueType{kind: TypeKind.Signed, bits: 64}
                                Expr.FloatLit:
                                    region_pointee <- ValueType{kind: TypeKind.Float, bits: 64}
                                Expr.BoolLit:
                                    region_pointee <- ValueType{kind: TypeKind.Bool, bits: 1}
                                Expr.CharLit:
                                    region_pointee <- ValueType{kind: TypeKind.Signed, bits: 64}
                                _:
                                    pass
                        return intern_ref_type(region_pointee, structs) if region_pointee.kind != TypeKind.Unmodeled
                    return expression_type_depth(region_operand, local_scope, fns, structs, generics, depth + 1)
                _:
                    pass
            match expression:
                Expr.BoolLit(bool_value, _):
                    return ValueType{kind: TypeKind.Bool, bits: 1}
                _:
                    pass
            match expression:
                Expr.CharLit(char_text, _):
                    return ValueType{kind: TypeKind.Signed, bits: 64}
                _:
                    pass
            match expression:
                Expr.Slice(slice_object, slice_start_expr, slice_end_expr, slice_line):
                    # A slice of a CONTAINER is a `view[T]`, not a string view. Typing every slice
                    # as SView was right only for the cstr/sview receivers it was written for: it
                    # made `whole[0:4]` unusable as a GENERIC argument, because T could not be
                    # inferred from an SView (`take[T](a: view[T], …)` declined, while the same
                    # slice bound to a local first, or passed to a NON-generic callee, worked).
                    slice_receiver: mutable ValueType = expression_type_depth(slice_object, local_scope, fns, structs, generics, depth + 1)
                    slice_receiver <- ref_target_of(slice_receiver, structs) if slice_receiver.kind == TypeKind.Ref
                    if slice_receiver.kind == TypeKind.DArray:
                        return intern_view_type(darray_element_of(slice_receiver, structs), structs)
                    if slice_receiver.kind == TypeKind.View:
                        return slice_receiver
                    if slice_receiver.kind == TypeKind.Array:
                        return intern_view_type(copied_type(structs.array_elements[slice_receiver.bits.usize()]), structs)
                    return ValueType{kind: TypeKind.SView, bits: 0}
                _:
                    pass
            # A STRING literal has a type of its own (cstr) — unlike an int literal, which
            # defers to its context. There is no other string type in the subset for it to
            # adopt, and stage0 gives `"hi"` a cstr regardless of context.
            match expression:
                Expr.StringLit(string_text, _):
                    return ValueType{kind: TypeKind.CStr, bits: 0}
                _:
                    pass
            # A FLOAT literal, like an int literal, defers to its context (`x: f32 = 1.5`),
            # so it reports Unmodeled here rather than pinning itself to f64.
            match expression:
                Expr.Unary(unary_operator, unary_operand, unary_line):
                    # `not x` is a bool whatever `x` is; `-x` / `~x` keep the operand's type.
                    ValueType{kind: TypeKind.Bool, bits: 1} return if unary_operator == TokenKind.Not
                    # `!id` yields the handle's BACKING integer, not a bool (see the emit site).
                    expression_type_depth(unary_operand, local_scope, fns, structs, generics, depth + 1) return if unary_operator == TokenKind.Bang
                    # `&place` is a reference to the place's type.
                    if unary_operator == TokenKind.Ampersand:
                        place_type: ValueType = expression_type_depth(unary_operand, local_scope, fns, structs, generics, depth + 1)
                        unmodeled_type() return if place_type.kind == TypeKind.Unmodeled
                        return intern_ref_type(place_type, structs)
                    return expression_type_depth(unary_operand, local_scope, fns, structs, generics, depth + 1)
                _:
                    pass
            # A value `if` has the type of its value branches. Most callers already provide an
            # expected type, so leaving this form unmodeled appeared harmless until it became a
            # postfix cast receiver: `(value if condition else fallback).i64()` resolves the
            # receiver before the cast supplies a target, and the old fallback defaulted the
            # whole conditional to i64 even when its known branch was f64. The emitter then tried
            # to store an f64 branch into an i64 result slot and silently declined the function,
            # leaving an unresolved symbol for stage1's caller. Infer the common branch type;
            # literals remain unmodeled and therefore adopt the other branch's type, matching the
            # existing literal-context rule.
            match expression:
                Expr.If(if_condition, if_then, if_else, if_line):
                    if_then_type: ValueType = expression_type_depth(if_then, local_scope, fns, structs, generics, depth + 1)
                    if_else_type: ValueType = expression_type_depth(if_else, local_scope, fns, structs, generics, depth + 1)
                    if if_then_type.kind != TypeKind.Unmodeled and if_else_type.kind == TypeKind.Unmodeled:
                        return if_then_type
                    if if_else_type.kind != TypeKind.Unmodeled and if_then_type.kind == TypeKind.Unmodeled:
                        return if_else_type
                    if if_then_type.kind == if_else_type.kind and if_then_type.bits == if_else_type.bits:
                        return if_then_type
                    return unmodeled_type()
                _:
                    pass
            match expression:
                Expr.Binary(binary_left, binary_operator, binary_right, binary_line):
                    # A comparison, logical, `is` narrowing, or `in` membership yields bool
                    # regardless of operands.
                    ValueType{kind: TypeKind.Bool, bits: 1} return if binary_operator == TokenKind.Is
                    ValueType{kind: TypeKind.Bool, bits: 1} return if binary_operator == TokenKind.In
                    ValueType{kind: TypeKind.Bool, bits: 1} return if int_predicate_of(binary_operator) >= 0
                    ValueType{kind: TypeKind.Bool, bits: 1} return if binary_operator == TokenKind.And or binary_operator == TokenKind.Or
                    # Arithmetic keeps the operands' type: take whichever side is known, since
                    # a literal contributes nothing.
                    left_type: ValueType = expression_type_depth(binary_left, local_scope, fns, structs, generics, depth + 1)
                    # `+`/`-` on a SCALAR ref is VALUE arithmetic — deref the referent and add —
                    # so the expression's type is the REFERENT, not the ref. The emitter already
                    # lowers it that way (codegen_expr_binary_tail: only `u8&`/`void&` GEP, every
                    # other referent derefs and value-adds); this is the same rule at the TYPE
                    # level, which was missing.
                    #
                    # Without it a generic `p + n` stayed typed `T&` after instantiation, so a
                    # following `.usize()` treated the correctly-computed SUM as an ADDRESS —
                    # `inttoptr` then `load` — and faulted. stage0 answers 45 for `usize& + 5`;
                    # stage1 answered 139. Monomorphization means the instantiated type governs,
                    # so the concrete referent decides this, exactly as for a concrete `usize&`.
                    if binary_operator == TokenKind.Plus or binary_operator == TokenKind.Minus:
                        if left_type.kind == TypeKind.Ref:
                            arith_referent: ValueType = ref_target_of(left_type, structs)
                            arith_is_byte_pointer: bool = arith_referent.kind == TypeKind.Void or (arith_referent.kind == TypeKind.Unsigned and arith_referent.bits == 8)
                            arith_referent return if not arith_is_byte_pointer and (is_integer_type(arith_referent) or arith_referent.kind == TypeKind.Bool or arith_referent.kind == TypeKind.Float)
                    # A typed integer leaf does not settle an arithmetic tree when the other
                    # side contains a context-typed FLOAT literal. For example, C's
                    # `((i * 2) + 1) * 3.14159 / 1024` must be floating-point even though
                    # `i * 2` is already known to be i32. Returning left_type here made the
                    # call argument to sin/cos use integer arithmetic, then the FloatLit could
                    # not be emitted at that integer type and the whole statement declined.
                    # The helper is restricted to transparent arithmetic operators, so this
                    # does not let a float buried in a call or aggregate change its parent type.
                    return ValueType{kind: TypeKind.Float, bits: 64} if arithmetic_tree_contains_float_literal(expression)
                    left_type return if left_type.kind != TypeKind.Unmodeled
                    right_type: ValueType = expression_type_depth(binary_right, local_scope, fns, structs, generics, depth + 1)
                    right_type return if right_type.kind != TypeKind.Unmodeled
                    # Both sides can be context-typed integer literals. Integer-only trees
                    # remain Unmodeled and continue to adopt their assignment/argument context.
                    return right_type
                _:
                    pass
            return expression_type_of_place(expression, local_scope, fns, structs, generics, depth)

include "./codegen_expression_type_place.elisa"
