# Stage1 backend — the whole-program DISJOINTNESS proof behind `noalias`: which parameters a
# function can be shown never to alias, by collecting the freshly-allocated arguments every
# call site passes. Conservative by construction — an unproven parameter simply keeps its
# aliasing rights. Part of `module Backend` (see codegen.elisa).

extend Backend:
    private:

        # Alias-scope names are explicitly defined for parameter positions 0 through 15.
        # Never infer/tag a fact outside that representable range.
        const DISJOINT_SCOPE_COUNT: u32 = 16

            # Conservative whole-program subset of stage0's disjoint-parameter proof. A function is
            # stamped only when this file contains a direct call passing distinct address-of-ident
            # arguments. Any missing or indirect call leaves it unstamped; this can lose an
            # optimization, but cannot assert a false alias fact.
        def disjoint_numeric_darray_ref(type_expression: Expr, structs: mutable StructTable&) -> bool can[Abort.Panic]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                value_type: ValueType = annotation_value_type(type_expression, structs)
                if value_type.kind != TypeKind.Ref or ref_is_heap_ref(value_type, structs):
                    return false
                pointee: ValueType = ref_target_of(value_type, structs)
                return pointee.kind == TypeKind.DArray and is_numeric_type(darray_element_of(pointee, structs)) and type_contains_token(type_expression, TokenKind.Mutable) and type_contains_token(type_expression, TokenKind.Ampersand)




        def disjoint_addr_ident(expression: Expr) -> sview can[Abort.Panic]:
            match expression:
                Expr.Unary(operator, operand, line):
                    match operator:
                        TokenKind.Ampersand:
                            match operand:
                                Expr.Ident(name, ident_line):
                                    return name
                                _:
                                    return ""
                        _:
                            return ""
                _:
                    return ""
            return ""




        def disjoint_expr_mentions_name(expression: Expr, wanted: sview) -> bool can[Abort.Panic]:
            match expression:
                Expr.Ident(name, _):
                    return name == wanted
                Expr.Call(callee, arguments, _, _):
                    true return if disjoint_expr_mentions_name(callee, wanted)
                    for argument in arguments:
                        true return if disjoint_expr_mentions_name(argument, wanted)
                Expr.Field(object, _, _) | Expr.Scope(object, _, _) | Expr.Index(object, _, _) | Expr.Slice(object, _, _, _) | Expr.IndexN(object, _, _):
                    return disjoint_expr_mentions_name(object, wanted)
                Expr.Binary(left, _, right, _):
                    return disjoint_expr_mentions_name(left, wanted) or disjoint_expr_mentions_name(right, wanted)
                Expr.Unary(_, operand, _) | Expr.Move(operand, _) | Expr.RegionNew(operand, _, _) | Expr.Paren(operand, _):
                    return disjoint_expr_mentions_name(operand, wanted)
                Expr.Array(elements, _) | Expr.Tuple(elements, _) | Expr.SetLit(elements, _):
                    for element in elements:
                        true return if disjoint_expr_mentions_name(element, wanted)
                Expr.DictLit(entries, _):
                    for entry in entries:
                        true return if disjoint_expr_mentions_name(entry.key, wanted) or disjoint_expr_mentions_name(entry.value, wanted)
                Expr.Construct(type_expression, fields, _) | Expr.RecordUpdate(type_expression, fields, _):
                    true return if disjoint_expr_mentions_name(type_expression, wanted)
                    for field in fields:
                        true return if disjoint_expr_mentions_name(field.value, wanted)
                Expr.If(condition, then_expr, else_expr, _):
                    return disjoint_expr_mentions_name(condition, wanted) or disjoint_expr_mentions_name(then_expr, wanted) or disjoint_expr_mentions_name(else_expr, wanted)
                Expr.IntLit(_, _) | Expr.FloatLit(_, _) | Expr.StringLit(_, _) | Expr.BoolLit(_, _) | Expr.CharLit(_, _):
                    return false
                Expr.Absent:
                    return false
                Expr.StaticEffectCall(_, _, _, _, _, _) | Expr.Match(_, _, _) | Expr.Catch(_, _, _) | Expr.Comprehension(_, _, _, _, _) | Expr.Refinement(_, _, _) | Expr.GetElse(_, _, _) | Expr.Lambda(_, _, _) | Expr.Block(_, _, _, _) | Expr.ShorthandMember(_, _):
                    return true
                _:
                    return true
            return false


        # Bare mutable darray values can be copied or escape. Indexed numeric elements are
        # scalar accesses and do not expose the descriptor itself. Unknown AST forms fail
        # closed whenever they may contain the tracked name.
        def disjoint_expr_escapes_name(expression: Expr, wanted: sview, trusted_candidate: sview, trusted_mask: u64) -> bool can[Abort.Panic, Memory.Allocate]:
            match expression:
                Expr.Ident(name, _):
                    return name == wanted
                Expr.Call(callee, arguments, argument_names, _):
                    trusted: mutable bool = false
                    match callee:
                        Expr.Ident(callee_name, _):
                            trusted <- callee_name == trusted_candidate and trusted_candidate != "" and argument_names.count == arguments.count
                        _:
                            pass
                    if trusted:
                        for argument_name in argument_names:
                            trusted <- false if argument_name != ""
                    true return if disjoint_expr_escapes_name(callee, wanted, "", 0)
                    argument_index: mutable u32 = 0
                    for argument in arguments |argument_index, trusted, trusted_mask, wanted|:
                        safe_candidate_argument: bool = trusted and argument_index < DISJOINT_SCOPE_COUNT and disjoint_mask_has(trusted_mask, argument_index) and disjoint_addr_ident(argument) == wanted
                        if not safe_candidate_argument:
                            true return if disjoint_expr_escapes_name(argument, wanted, trusted_candidate, trusted_mask)
                        argument_index <- argument_index + 1
                Expr.Index(object, index, _):
                    if object is Expr.Ident(name, _) and name == wanted:
                        return disjoint_expr_escapes_name(index, wanted, trusted_candidate, trusted_mask)
                    return disjoint_expr_escapes_name(object, wanted, trusted_candidate, trusted_mask) or disjoint_expr_escapes_name(index, wanted, trusted_candidate, trusted_mask)
                Expr.Field(object, _, _) | Expr.Scope(object, _, _):
                    return disjoint_expr_escapes_name(object, wanted, trusted_candidate, trusted_mask)
                Expr.Slice(object, low, high, _):
                    return disjoint_expr_escapes_name(object, wanted, trusted_candidate, trusted_mask) or disjoint_expr_escapes_name(low, wanted, trusted_candidate, trusted_mask) or disjoint_expr_escapes_name(high, wanted, trusted_candidate, trusted_mask)
                Expr.IndexN(object, arguments, _):
                    true return if disjoint_expr_escapes_name(object, wanted, trusted_candidate, trusted_mask)
                    for argument in arguments |wanted, trusted_candidate, trusted_mask|:
                        true return if disjoint_expr_escapes_name(argument, wanted, trusted_candidate, trusted_mask)
                Expr.Binary(left, _, right, _):
                    return disjoint_expr_escapes_name(left, wanted, trusted_candidate, trusted_mask) or disjoint_expr_escapes_name(right, wanted, trusted_candidate, trusted_mask)
                Expr.Unary(_, operand, _) | Expr.Move(operand, _) | Expr.RegionNew(operand, _, _) | Expr.Paren(operand, _):
                    return disjoint_expr_escapes_name(operand, wanted, trusted_candidate, trusted_mask)
                Expr.Array(elements, _) | Expr.Tuple(elements, _) | Expr.SetLit(elements, _):
                    for element in elements |wanted, trusted_candidate, trusted_mask|:
                        true return if disjoint_expr_escapes_name(element, wanted, trusted_candidate, trusted_mask)
                Expr.DictLit(entries, _):
                    for entry in entries |wanted, trusted_candidate, trusted_mask|:
                        true return if disjoint_expr_escapes_name(entry.key, wanted, trusted_candidate, trusted_mask) or disjoint_expr_escapes_name(entry.value, wanted, trusted_candidate, trusted_mask)
                Expr.Construct(type_expression, fields, _) | Expr.RecordUpdate(type_expression, fields, _):
                    true return if disjoint_expr_escapes_name(type_expression, wanted, trusted_candidate, trusted_mask)
                    for field in fields |wanted, trusted_candidate, trusted_mask|:
                        true return if disjoint_expr_escapes_name(field.value, wanted, trusted_candidate, trusted_mask)
                Expr.If(condition, then_expr, else_expr, _):
                    return disjoint_expr_escapes_name(condition, wanted, trusted_candidate, trusted_mask) or disjoint_expr_escapes_name(then_expr, wanted, trusted_candidate, trusted_mask) or disjoint_expr_escapes_name(else_expr, wanted, trusted_candidate, trusted_mask)
                Expr.StaticEffectCall(_, _, _, _, _, _) | Expr.Match(_, _, _) | Expr.Catch(_, _, _) | Expr.Comprehension(_, _, _, _, _) | Expr.Refinement(_, _, _) | Expr.GetElse(_, _, _) | Expr.Lambda(_, _, _) | Expr.Block(_, _, _, _):
                    return disjoint_expr_mentions_name(expression, wanted)
                _:
                    pass
            return false


        def disjoint_candidate_parameter_escapes(expression: Expr, candidate_mask: u64, parameters: darray[Ast::ParamDecl]&) -> bool can[Abort.Panic, Memory.Allocate]:
            parameter_index: mutable u32 = 0
            for _ in 0..<DISJOINT_SCOPE_COUNT |parameter_index, candidate_mask, parameters, expression|:
                if disjoint_mask_has(candidate_mask, parameter_index) and parameter_index.usize() < parameters.count:
                    return true if disjoint_expr_escapes_name(expression, parameters[parameter_index.usize()].name, "", 0)
                parameter_index <- parameter_index + 1
            return false


        def disjoint_reject_candidate_escape(expression: Expr, candidate_name: sview, candidate_mask: u64, enclosing_name: sview, parameters: darray[Ast::ParamDecl]&, bad: mutable bool&) -> void can[Abort.Panic, Memory.Allocate]:
            bad <- true if enclosing_name == candidate_name and disjoint_candidate_parameter_escapes(expression, candidate_mask, parameters)


        def disjoint_is_builtin_clone_of(expression: Expr, wanted: sview, clone_builtin_unshadowed: bool) -> bool can[Abort.Panic]:
            return false if not clone_builtin_unshadowed
            match expression:
                Expr.Call(callee, arguments, argument_names, _):
                    return false if arguments.count != 1 or argument_names.count != 1 or argument_names[0] != ""
                    is_clone: mutable bool = false
                    match callee:
                        Expr.Index(object, _, _) | Expr.IndexN(object, _, _):
                            match object:
                                Expr.Ident(name, _):
                                    is_clone <- name == "clone"
                                _:
                                    pass
                        _:
                            pass
                    return false if not is_clone
                    match arguments[0]:
                        Expr.Ident(name, _):
                            return name == wanted
                        _:
                            return false
                _:
                    return false
            return false


        def disjoint_invalidate_escaped_fresh(expression: Expr, candidate_name: sview, candidate_mask: u64, fresh: darray[sview]&, dead: mutable darray[sview]&, clone_builtin_unshadowed: bool) -> void can[Abort.Panic, Memory.Allocate]:
            for name in fresh |expression, candidate_name, candidate_mask, dead|:
                if not disjoint_name_present(dead, name) and not disjoint_is_builtin_clone_of(expression, name, clone_builtin_unshadowed) and disjoint_expr_escapes_name(expression, name, candidate_name, candidate_mask):
                    dead.push(name)


        def disjoint_invalidate_loop_fresh(fresh: darray[sview]&, dead: mutable darray[sview]&) -> void can[Abort.Panic]:
            for name in fresh |dead|:
                dead.push(name) if not disjoint_name_present(dead, name)


        def disjoint_pattern_binds_name(pattern: Ast::Pattern, wanted: sview) -> bool can[Abort.Panic]:
            match pattern:
                Ast::Pattern.Binding(name) | Ast::Pattern.Rest(name):
                    return name == wanted
                Ast::Pattern.TypeBind(_, name):
                    return name == wanted
                Ast::Pattern.As(name, inner):
                    return true if name == wanted
                    for nested in inner:
                        return true if disjoint_pattern_binds_name(nested, wanted)
                Ast::Pattern.Variant(_, fields) | Ast::Pattern.Struct(_, fields) | Ast::Pattern.Field(_, fields) | Ast::Pattern.Tuple(fields) | Ast::Pattern.Or(fields):
                    for nested in fields:
                        return true if disjoint_pattern_binds_name(nested, wanted)
                Ast::Pattern.Other(_):
                    return true
                _:
                    pass
            return false


        def disjoint_pattern_binding_count(pattern: Ast::Pattern, wanted: sview) -> usize can[Abort.Panic]:
            match pattern:
                Ast::Pattern.Binding(name) | Ast::Pattern.Rest(name):
                    return 1 if name == wanted else 0
                Ast::Pattern.TypeBind(_, name):
                    return 1 if name == wanted else 0
                Ast::Pattern.As(name, inner):
                    count: mutable usize = 1 if name == wanted else 0
                    for nested in inner |count, wanted|:
                        count <- count + disjoint_pattern_binding_count(nested, wanted)
                    return count
                Ast::Pattern.Variant(_, fields) | Ast::Pattern.Struct(_, fields) | Ast::Pattern.Field(_, fields) | Ast::Pattern.Tuple(fields) | Ast::Pattern.Or(fields):
                    count: mutable usize = 0
                    for nested in fields |count, wanted|:
                        count <- count + disjoint_pattern_binding_count(nested, wanted)
                    return count
                Ast::Pattern.Other(_):
                    return 1
                _:
                    pass
            return 0


        def disjoint_statements_bind_name(statements: darray[Stmt], wanted: sview) -> bool can[Abort.Panic]:
            for statement in statements:
                match statement:
                    Stmt.VarDecl(name, _, _, _):
                        return true if name == wanted
                    Stmt.Assign(Expr.Ident(name, _), TokenKind.Assign, _, _):
                        return true if name == wanted
                    Stmt.If(_, then_body, else_body, _):
                        return true if disjoint_statements_bind_name(then_body, wanted) or disjoint_statements_bind_name(else_body, wanted)
                    Stmt.While(_, body, _):
                        return true if disjoint_statements_bind_name(body, wanted)
                    Stmt.For(_, variables, _, body, _):
                        for variable in variables:
                            return true if variable == wanted
                        return true if disjoint_statements_bind_name(body, wanted)
                    Stmt.Block(_, _, binding, body, _):
                        return true if binding == wanted
                        return true if disjoint_statements_bind_name(body, wanted)
                    Stmt.Match(_, arms, _):
                        for arm in arms:
                            return true if disjoint_pattern_binds_name(arm.pattern, wanted)
                            return true if disjoint_statements_bind_name(arm.body, wanted)
                    _:
                        pass
            return false


        def disjoint_statement_binding_count(statements: darray[Stmt], wanted: sview) -> usize can[Abort.Panic]:
            count: mutable usize = 0
            for statement in statements |count, wanted|:
                match statement:
                    Stmt.VarDecl(name, _, _, _):
                        count <- count + 1 if name == wanted
                    Stmt.Assign(Expr.Ident(name, _), TokenKind.Assign, _, _):
                        count <- count + 1 if name == wanted
                    Stmt.If(_, then_body, else_body, _):
                        count <- count + disjoint_statement_binding_count(then_body, wanted)
                        count <- count + disjoint_statement_binding_count(else_body, wanted)
                    Stmt.While(_, body, _):
                        count <- count + disjoint_statement_binding_count(body, wanted)
                    Stmt.For(_, variables, _, body, _):
                        for variable in variables |count, wanted|:
                            count <- count + 1 if variable == wanted
                        count <- count + disjoint_statement_binding_count(body, wanted)
                    Stmt.Block(_, _, binding, body, _):
                        count <- count + 1 if binding == wanted
                        count <- count + disjoint_statement_binding_count(body, wanted)
                    Stmt.Match(_, arms, _):
                        for arm in arms |count, wanted|:
                            count <- count + disjoint_pattern_binding_count(arm.pattern, wanted)
                            count <- count + disjoint_statement_binding_count(arm.body, wanted)
                    _:
                        pass
            return count


        def disjoint_function_name_count(declarations: darray[Decl]&, wanted: sview) -> usize can[Abort.Panic]:
            count: mutable usize = 0
            for declaration in declarations:
                match declaration:
                    Decl.Func(name, _, _, _, _, _, _):
                        count <- count + 1 if name == wanted
                    Decl.Extern(name, _, _, _, _, _, _, _):
                        count <- count + 1 if name == wanted
                    Decl.Module(_, body, _):
                        count <- count + disjoint_function_name_count(body, wanted)
                    Decl.Scoped(body, _):
                        count <- count + disjoint_function_name_count(body, wanted)
                    _:
                        pass
            return count


        def disjoint_global_value_name_count(declarations: darray[Decl]&, wanted: sview) -> usize can[Abort.Panic]:
            count: mutable usize = 0
            for declaration in declarations:
                match declaration:
                    Decl.Const(name, _, _, _, _):
                        count <- count + 1 if name == wanted
                    Decl.Extern(name, _, _, _, _, _, _, _):
                        count <- count + 1 if name == wanted
                    Decl.Module(_, body, _):
                        count <- count + disjoint_global_value_name_count(body, wanted)
                    Decl.Scoped(body, _):
                        count <- count + disjoint_global_value_name_count(body, wanted)
                    _:
                        pass
            return count


        def disjoint_export_target_matches_function(target: sview, function_name: sview) -> bool can[Abort.Panic, Memory.Allocate]:
            target_leaf: sview = export_target_leaf(target)
            false return if sview_len(target_leaf) < sview_len(function_name)
            for index in 0..<sview_len(function_name) |target_leaf, function_name|:
                false return if sview_at(target_leaf, index) != sview_at(function_name, index)
            suffix_position: mutable usize = sview_len(function_name)
            suffix_position <- export_target_skip_spaces(target_leaf, suffix_position)
            return true if suffix_position == sview_len(target_leaf)
            return sview_at(target_leaf, suffix_position) == 91


        def disjoint_function_is_exported(function_name: sview, annotations: darray[Ast::EnumAnnotation]&) -> bool can[Abort.Panic, Memory.Allocate]:
            for annotation in annotations |function_name|:
                true return if annotation.owner == function_name and annotation.name == "__export_fn"
                if annotation.name == "__export_target_ref":
                    true return if disjoint_export_target_matches_function(annotation.owner, function_name)
            return false


        def disjoint_name_present(names: darray[sview]&, wanted: sview) -> bool can[Abort.Panic]:
            for name in names |wanted|:
                true return if name == wanted
            return false




        def disjoint_fresh_initializer(expression: Expr, clone_builtin_unshadowed: bool) -> bool can[Abort.Panic]:
            match expression:
                Expr.Array(elements, line):
                    return true
                Expr.Call(callee, arguments, argument_names, line):
                    match callee:
                        Expr.Ident(name, ident_line):
                            return clone_builtin_unshadowed and name == "clone"
                        Expr.Index(object, index, index_line):
                            match object:
                                Expr.Ident(name, object_line):
                                    return clone_builtin_unshadowed and name == "clone"
                                _:
                                    return false
                        Expr.IndexN(object, type_arguments, index_n_line):
                            match object:
                                Expr.Ident(name, object_line):
                                    return clone_builtin_unshadowed and name == "clone"
                                _:
                                    return false
                        _:
                            return false
                Expr.IndexN(callee, arguments, line):
                    match callee:
                        Expr.Ident(name, ident_line):
                            return clone_builtin_unshadowed and name == "clone"
                        _:
                            return false
                _:
                    return false
            return false




        def disjoint_collect_fresh(statements: darray[Stmt], all_statements: darray[Stmt], all_declarations: darray[Decl]&, fresh: mutable darray[sview]&, dead: mutable darray[sview]&, clone_builtin_unshadowed: bool, allow_fresh: bool) -> void can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic, Memory.Allocate:
                for statement in statements |fresh, dead|:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            if allow_fresh and disjoint_fresh_initializer(value, clone_builtin_unshadowed) and disjoint_statement_binding_count(all_statements, name) == 1 and disjoint_global_value_name_count(all_declarations, name) == 0:
                                fresh.push(name) if not disjoint_name_present(fresh, name) and not disjoint_name_present(dead, name)
                            else:
                                dead.push(name) if not disjoint_name_present(dead, name)
                                match value:
                                    Expr.Ident(source, source_line):
                                        dead.push(source) if not disjoint_name_present(dead, source)
                                    _:
                                        pass
                        Stmt.Assign(target, operator, value, line):
                            match target:
                                Expr.Ident(target_name, target_line):
                                    dead.push(target_name) if not disjoint_name_present(dead, target_name)
                                _:
                                    pass
                            match value:
                                Expr.Ident(source, source_line):
                                    dead.push(source) if not disjoint_name_present(dead, source)
                                _:
                                    pass
                        Stmt.If(condition, then_body, else_body, line):
                            disjoint_collect_fresh(then_body, all_statements, all_declarations, fresh, dead, clone_builtin_unshadowed, false)
                            disjoint_collect_fresh(else_body, all_statements, all_declarations, fresh, dead, clone_builtin_unshadowed, false)
                        Stmt.While(condition, body, line):
                            disjoint_collect_fresh(body, all_statements, all_declarations, fresh, dead, clone_builtin_unshadowed, false)
                        Stmt.For(bind, variables, iterable, body, line):
                            disjoint_collect_fresh(body, all_statements, all_declarations, fresh, dead, clone_builtin_unshadowed, false)
                        Stmt.Block(kind, clause, binding, body, line):
                            disjoint_collect_fresh(body, all_statements, all_declarations, fresh, dead, clone_builtin_unshadowed, false)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |fresh, dead|:
                                disjoint_collect_fresh(arm.body, all_statements, all_declarations, fresh, dead, clone_builtin_unshadowed, false)
                        _:
                            pass


        def disjoint_call_proven(expression: Expr, candidate_name: sview, candidate_mask: u64, enclosing_name: sview, enclosing_params: darray[Ast::ParamDecl]&, fresh: darray[sview]&, dead: darray[sview]&, structs: StructTable&) -> bool can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, line):
                        match callee:
                            Expr.Ident(callee_name, _):
                                false return if callee_name != candidate_name
                            _:
                                return false
                        # Defaults, variadic tails, and omitted trailing parameters can
                        # execute expressions that this positional proof does not model.
                        false return if arguments.count != disjoint_function_arity(candidate_name, structs).usize()
                        # The alias mask is indexed by formal position. Until named arguments
                        # are resolved to parameter slots here, positional indexing is unsound.
                        return false if argument_names.count != arguments.count
                        for argument_name in argument_names:
                            return false if argument_name != ""
                        parameter_index: mutable u32 = 0
                        for _ in 0..<DISJOINT_SCOPE_COUNT |parameter_index|:
                            continue if not disjoint_mask_has(candidate_mask, parameter_index)
                            if arguments.count <= parameter_index.usize():
                                return false
                            left_root: sview = disjoint_addr_ident(arguments[parameter_index.usize()])
                            if left_root == "":
                                return false
                            left_param: i64 = disjoint_param_index(left_root, enclosing_params)
                            left_fresh: bool = disjoint_name_present(fresh, left_root) and not disjoint_name_present(dead, left_root)
                            pair_index: mutable u32 = parameter_index + 1
                            for _ in (parameter_index + 1)..<DISJOINT_SCOPE_COUNT |pair_index|:
                                continue if not disjoint_mask_has(candidate_mask, pair_index)
                                if arguments.count <= pair_index.usize():
                                    return false
                                right_root: sview = disjoint_addr_ident(arguments[pair_index.usize()])
                                if right_root == "" or right_root == left_root:
                                    return false
                                right_param: i64 = disjoint_param_index(right_root, enclosing_params)
                                right_fresh: bool = disjoint_name_present(fresh, right_root) and not disjoint_name_present(dead, right_root)
                                base: bool = left_fresh and right_fresh
                                depend: bool = left_param >= 0 and right_param >= 0 and disjoint_mask_has(disjoint_function_mask(enclosing_name, structs), left_param.u32()) and disjoint_mask_has(disjoint_function_mask(enclosing_name, structs), right_param.u32())
                                if not base and not depend:
                                    return false
                                pair_index <- pair_index + 1
                            parameter_index <- parameter_index + 1
                        return true
                    _:
                        pass
                return false




        def disjoint_scan_expr(expression: Expr, candidate_name: sview, candidate_mask: u64, enclosing_name: sview, enclosing_params: darray[Ast::ParamDecl]&, fresh: darray[sview]&, dead: mutable darray[sview]&, structs: StructTable&, seen: mutable bool&, bad: mutable bool&) -> void can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic, Memory.Allocate:
                match expression:
                    Expr.Call(callee, arguments, argument_names, line):
                        direct_candidate_call: mutable bool = false
                        match callee:
                            Expr.Ident(callee_name, _):
                                direct_candidate_call <- callee_name == candidate_name
                            _:
                                pass
                        if enclosing_name == candidate_name:
                            # Calls can mutate a descriptor through an alias, global, or
                            # callback even when the candidate parameter is not syntactically
                            # present in the arguments. Without effect summaries only leaf
                            # functions are eligible for stable parameter-origin scopes.
                            bad <- true
                        if direct_candidate_call:
                            seen <- true
                            bad <- true if not disjoint_call_proven(expression, candidate_name, candidate_mask, enclosing_name, enclosing_params, fresh, dead, structs)
                        else:
                            disjoint_scan_expr(callee, candidate_name, candidate_mask, enclosing_name, enclosing_params, fresh, dead, structs, seen, bad)
                        for argument in arguments |candidate_name, candidate_mask, enclosing_name, enclosing_params, fresh, dead, structs, seen, bad|:
                            disjoint_scan_expr(argument, candidate_name, candidate_mask, enclosing_name, enclosing_params, fresh, dead, structs, seen, bad)
                        # Fresh descriptors are invalidated once for the complete enclosing
                        # statement by `disjoint_invalidate_escaped_fresh`. Repeating a
                        # name-only invalidation here would incorrectly treat the trusted
                        # builtin clone's by-value source as an escaping mutable reference.
                        return
                    Expr.Ident(name, line):
                        bad <- true if name == candidate_name
                        return
                    Expr.Binary(left, operator, right, line):
                        disjoint_scan_expr(left, candidate_name, candidate_mask, enclosing_name, enclosing_params, fresh, dead, structs, seen, bad)
                        disjoint_scan_expr(right, candidate_name, candidate_mask, enclosing_name, enclosing_params, fresh, dead, structs, seen, bad)
                    Expr.Unary(operator, operand, line):
                        disjoint_scan_expr(operand, candidate_name, candidate_mask, enclosing_name, enclosing_params, fresh, dead, structs, seen, bad)
                    Expr.Move(operand, line):
                        disjoint_scan_expr(operand, candidate_name, candidate_mask, enclosing_name, enclosing_params, fresh, dead, structs, seen, bad)
                    Expr.Paren(operand, line):
                        disjoint_scan_expr(operand, candidate_name, candidate_mask, enclosing_name, enclosing_params, fresh, dead, structs, seen, bad)
                    Expr.Field(object, field, line):
                        bad <- true if field == candidate_name
                        disjoint_scan_expr(object, candidate_name, candidate_mask, enclosing_name, enclosing_params, fresh, dead, structs, seen, bad)
                    Expr.Scope(object, field, line):
                        # Qualified references are not represented as bare identifiers, so
                        # counting only Expr.Call(Ident(...)) silently misses an aliasing call.
                        bad <- true if field == candidate_name
                        disjoint_scan_expr(object, candidate_name, candidate_mask, enclosing_name, enclosing_params, fresh, dead, structs, seen, bad)
                    Expr.Index(object, index, line):
                        disjoint_scan_expr(object, candidate_name, candidate_mask, enclosing_name, enclosing_params, fresh, dead, structs, seen, bad)
                        disjoint_scan_expr(index, candidate_name, candidate_mask, enclosing_name, enclosing_params, fresh, dead, structs, seen, bad)
                    Expr.Slice(object, low, high, line):
                        disjoint_scan_expr(object, candidate_name, candidate_mask, enclosing_name, enclosing_params, fresh, dead, structs, seen, bad)
                        disjoint_scan_expr(low, candidate_name, candidate_mask, enclosing_name, enclosing_params, fresh, dead, structs, seen, bad)
                        disjoint_scan_expr(high, candidate_name, candidate_mask, enclosing_name, enclosing_params, fresh, dead, structs, seen, bad)
                    Expr.IndexN(object, arguments, line):
                        disjoint_scan_expr(object, candidate_name, candidate_mask, enclosing_name, enclosing_params, fresh, dead, structs, seen, bad)
                        for argument in arguments |candidate_name, candidate_mask, enclosing_name, enclosing_params, fresh, dead, structs, seen, bad|:
                            disjoint_scan_expr(argument, candidate_name, candidate_mask, enclosing_name, enclosing_params, fresh, dead, structs, seen, bad)
                    Expr.If(condition, then_expr, else_expr, line):
                        disjoint_scan_expr(condition, candidate_name, candidate_mask, enclosing_name, enclosing_params, fresh, dead, structs, seen, bad)
                        disjoint_scan_expr(then_expr, candidate_name, candidate_mask, enclosing_name, enclosing_params, fresh, dead, structs, seen, bad)
                        disjoint_scan_expr(else_expr, candidate_name, candidate_mask, enclosing_name, enclosing_params, fresh, dead, structs, seen, bad)
                    Expr.RegionNew(operand, _, line):
                        disjoint_scan_expr(operand, candidate_name, candidate_mask, enclosing_name, enclosing_params, fresh, dead, structs, seen, bad)
                    Expr.Array(elements, line) | Expr.Tuple(elements, line) | Expr.SetLit(elements, line):
                        for element in elements |candidate_name, candidate_mask, enclosing_name, enclosing_params, fresh, dead, structs, seen, bad|:
                            disjoint_scan_expr(element, candidate_name, candidate_mask, enclosing_name, enclosing_params, fresh, dead, structs, seen, bad)
                    Expr.DictLit(entries, line):
                        for entry in entries |candidate_name, candidate_mask, enclosing_name, enclosing_params, fresh, dead, structs, seen, bad|:
                            disjoint_scan_expr(entry.key, candidate_name, candidate_mask, enclosing_name, enclosing_params, fresh, dead, structs, seen, bad)
                            disjoint_scan_expr(entry.value, candidate_name, candidate_mask, enclosing_name, enclosing_params, fresh, dead, structs, seen, bad)
                    Expr.Construct(type_expression, fields, line) | Expr.RecordUpdate(type_expression, fields, line):
                        disjoint_scan_expr(type_expression, candidate_name, candidate_mask, enclosing_name, enclosing_params, fresh, dead, structs, seen, bad)
                        for field in fields |candidate_name, candidate_mask, enclosing_name, enclosing_params, fresh, dead, structs, seen, bad|:
                            disjoint_scan_expr(field.value, candidate_name, candidate_mask, enclosing_name, enclosing_params, fresh, dead, structs, seen, bad)
                    Expr.StaticEffectCall(_, _, _, _, _, _) | Expr.Match(_, _, _) | Expr.Catch(_, _, _) | Expr.Comprehension(_, _, _, _, _) | Expr.Refinement(_, _, _) | Expr.GetElse(_, _, _) | Expr.Lambda(_, _, _) | Expr.Block(_, _, _, _):
                        # These forms may hide invocations, lexical binders, or deferred
                        # execution. Until their scopes/effects are modeled, lose the
                        # optimization rather than infer a fact from an incomplete walk.
                        bad <- true
                    Expr.IntLit(_, _) | Expr.FloatLit(_, _) | Expr.StringLit(_, _) | Expr.BoolLit(_, _) | Expr.CharLit(_, _):
                        pass
                    Expr.Absent:
                        pass
                    _:
                        # An AST form not understood by this alias analysis may hide a
                        # reference, call, or control effect. Never treat it as an inert leaf.
                        bad <- true
        def disjoint_scan_statements(statements: darray[Stmt], candidate_name: sview, candidate_mask: u64, enclosing_name: sview, enclosing_params: darray[Ast::ParamDecl]&, fresh: darray[sview]&, dead: mutable darray[sview]&, structs: StructTable&, seen: mutable bool&, bad: mutable bool&, clone_builtin_unshadowed: bool) -> void can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic, Memory.Allocate:
                for statement in statements |candidate_name, candidate_mask, enclosing_name, enclosing_params, fresh, dead, structs, seen, bad, clone_builtin_unshadowed|:
                    match statement:
                        Stmt.Expr(expression, line):
                            disjoint_invalidate_escaped_fresh(expression, candidate_name, candidate_mask, fresh, dead, clone_builtin_unshadowed)
                            disjoint_reject_candidate_escape(expression, candidate_name, candidate_mask, enclosing_name, enclosing_params, bad)
                            disjoint_scan_expr(expression, candidate_name, candidate_mask, enclosing_name, enclosing_params, fresh, dead, structs, seen, bad)
                        Stmt.VarDecl(name, type_expression, value, line):
                            disjoint_invalidate_escaped_fresh(value, candidate_name, candidate_mask, fresh, dead, clone_builtin_unshadowed)
                            disjoint_reject_candidate_escape(value, candidate_name, candidate_mask, enclosing_name, enclosing_params, bad)
                            disjoint_scan_expr(value, candidate_name, candidate_mask, enclosing_name, enclosing_params, fresh, dead, structs, seen, bad)
                        Stmt.Assign(target, operator, value, line):
                            disjoint_invalidate_escaped_fresh(target, candidate_name, candidate_mask, fresh, dead, clone_builtin_unshadowed)
                            disjoint_invalidate_escaped_fresh(value, candidate_name, candidate_mask, fresh, dead, clone_builtin_unshadowed)
                            disjoint_reject_candidate_escape(target, candidate_name, candidate_mask, enclosing_name, enclosing_params, bad)
                            disjoint_reject_candidate_escape(value, candidate_name, candidate_mask, enclosing_name, enclosing_params, bad)
                            disjoint_scan_expr(target, candidate_name, candidate_mask, enclosing_name, enclosing_params, fresh, dead, structs, seen, bad)
                            disjoint_scan_expr(value, candidate_name, candidate_mask, enclosing_name, enclosing_params, fresh, dead, structs, seen, bad)
                        Stmt.Return(value, line):
                            if value is returned:
                                disjoint_invalidate_escaped_fresh(returned, candidate_name, candidate_mask, fresh, dead, clone_builtin_unshadowed)
                                disjoint_reject_candidate_escape(returned, candidate_name, candidate_mask, enclosing_name, enclosing_params, bad)
                                disjoint_scan_expr(returned, candidate_name, candidate_mask, enclosing_name, enclosing_params, fresh, dead, structs, seen, bad)
                        Stmt.If(condition, then_body, else_body, line):
                            disjoint_invalidate_escaped_fresh(condition, candidate_name, candidate_mask, fresh, dead, clone_builtin_unshadowed)
                            disjoint_reject_candidate_escape(condition, candidate_name, candidate_mask, enclosing_name, enclosing_params, bad)
                            disjoint_scan_expr(condition, candidate_name, candidate_mask, enclosing_name, enclosing_params, fresh, dead, structs, seen, bad)
                            disjoint_scan_statements(then_body, candidate_name, candidate_mask, enclosing_name, enclosing_params, fresh, dead, structs, seen, bad, clone_builtin_unshadowed)
                            disjoint_scan_statements(else_body, candidate_name, candidate_mask, enclosing_name, enclosing_params, fresh, dead, structs, seen, bad, clone_builtin_unshadowed)
                        Stmt.While(condition, body, line):
                            disjoint_invalidate_escaped_fresh(condition, candidate_name, candidate_mask, fresh, dead, clone_builtin_unshadowed)
                            disjoint_reject_candidate_escape(condition, candidate_name, candidate_mask, enclosing_name, enclosing_params, bad)
                            disjoint_scan_expr(condition, candidate_name, candidate_mask, enclosing_name, enclosing_params, fresh, dead, structs, seen, bad)
                            # The loop body can run again after a later statement has changed
                            # a descriptor. Without a loop-carried alias state, no local-fresh
                            # fact is safe to use inside or after the loop.
                            disjoint_invalidate_loop_fresh(fresh, dead)
                            disjoint_scan_statements(body, candidate_name, candidate_mask, enclosing_name, enclosing_params, fresh, dead, structs, seen, bad, clone_builtin_unshadowed)
                        Stmt.For(bind, variables, iterable, body, line):
                            disjoint_invalidate_escaped_fresh(iterable, candidate_name, candidate_mask, fresh, dead, clone_builtin_unshadowed)
                            disjoint_reject_candidate_escape(iterable, candidate_name, candidate_mask, enclosing_name, enclosing_params, bad)
                            disjoint_scan_expr(iterable, candidate_name, candidate_mask, enclosing_name, enclosing_params, fresh, dead, structs, seen, bad)
                            disjoint_invalidate_loop_fresh(fresh, dead)
                            disjoint_scan_statements(body, candidate_name, candidate_mask, enclosing_name, enclosing_params, fresh, dead, structs, seen, bad, clone_builtin_unshadowed)
                        Stmt.Block(kind, clause, binding, body, line):
                            disjoint_scan_statements(body, candidate_name, candidate_mask, enclosing_name, enclosing_params, fresh, dead, structs, seen, bad, clone_builtin_unshadowed)
                        Stmt.Match(scrutinee, arms, line):
                            disjoint_invalidate_escaped_fresh(scrutinee, candidate_name, candidate_mask, fresh, dead, clone_builtin_unshadowed)
                            disjoint_reject_candidate_escape(scrutinee, candidate_name, candidate_mask, enclosing_name, enclosing_params, bad)
                            disjoint_scan_expr(scrutinee, candidate_name, candidate_mask, enclosing_name, enclosing_params, fresh, dead, structs, seen, bad)
                            for arm in arms |candidate_name, candidate_mask, enclosing_name, enclosing_params, fresh, dead, structs, seen, bad, clone_builtin_unshadowed|:
                                bad <- true if disjoint_pattern_binds_name(arm.pattern, candidate_name)
                                disjoint_invalidate_escaped_fresh(arm.guard, candidate_name, candidate_mask, fresh, dead, clone_builtin_unshadowed)
                                disjoint_reject_candidate_escape(arm.guard, candidate_name, candidate_mask, enclosing_name, enclosing_params, bad)
                                disjoint_scan_expr(arm.guard, candidate_name, candidate_mask, enclosing_name, enclosing_params, fresh, dead, structs, seen, bad)
                                disjoint_scan_statements(arm.body, candidate_name, candidate_mask, enclosing_name, enclosing_params, fresh, dead, structs, seen, bad, clone_builtin_unshadowed)
                        Stmt.Contract(kind, expression, line):
                            disjoint_invalidate_escaped_fresh(expression, candidate_name, candidate_mask, fresh, dead, clone_builtin_unshadowed)
                            disjoint_reject_candidate_escape(expression, candidate_name, candidate_mask, enclosing_name, enclosing_params, bad)
                            disjoint_scan_expr(expression, candidate_name, candidate_mask, enclosing_name, enclosing_params, fresh, dead, structs, seen, bad)
                        Stmt.Break(_, _) | Stmt.Continue(_, _) | Stmt.Invalid:
                            pass
                        _:
                            bad <- true


        def disjoint_scan_declarations(declarations: darray[Decl]&, all_declarations: darray[Decl]&, candidate_name: sview, candidate_mask: u64, structs: StructTable&, seen: mutable bool&, bad: mutable bool&) -> void can[Abort.Panic, Memory.Allocate]:
            for declaration in declarations |all_declarations, candidate_name, candidate_mask, structs, seen, bad|:
                match declaration:
                    Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                        fresh: mutable darray[sview] = []
                        dead: mutable darray[sview] = []
                        # A local/parameter/pattern binding with the callee's spelling changes
                        # what a bare call resolves to. Reject the whole name-keyed fact rather
                        # than guessing that each spelling still names the top-level function.
                        bad <- true if disjoint_statements_bind_name(body, candidate_name)
                        for parameter in parameters |candidate_name, bad|:
                            bad <- true if parameter.name == candidate_name
                        clone_builtin_unshadowed: mutable bool = not disjoint_statements_bind_name(body, "clone") and disjoint_function_name_count(all_declarations, "clone") == 0 and disjoint_global_value_name_count(all_declarations, "clone") == 0
                        for parameter in parameters |clone_builtin_unshadowed|:
                            clone_builtin_unshadowed <- false if parameter.name == "clone"
                        for parameter in parameters |dead|:
                            dead.push(parameter.name) if not disjoint_name_present(dead, parameter.name)
                        disjoint_collect_fresh(body, body, all_declarations, fresh, dead, clone_builtin_unshadowed, true)
                        disjoint_scan_statements(body, candidate_name, candidate_mask, function_name, parameters, fresh, dead, structs, seen, bad, clone_builtin_unshadowed)
                        # Default arguments are evaluated at caller sites, not in the
                        # function body. Walk them too, with no body-local freshness facts.
                        default_fresh: mutable darray[sview] = []
                        default_dead: mutable darray[sview] = []
                        for parameter in parameters |candidate_name, default_dead|:
                            default_dead.push(parameter.name) if not disjoint_name_present(default_dead, parameter.name)
                        for parameter in parameters |candidate_name, candidate_mask, function_name, parameters, default_fresh, default_dead, structs, seen, bad|:
                            if parameter.has_default:
                                disjoint_scan_expr(parameter.default_value, candidate_name, candidate_mask, function_name, parameters, default_fresh, default_dead, structs, seen, bad)
                    _:
                        pass
                match declaration:
                    Decl.Const(_, _, value, _, _):
                        global_fresh: mutable darray[sview] = []
                        global_dead: mutable darray[sview] = []
                        global_parameters: darray[Ast::ParamDecl] = []
                        disjoint_scan_expr(value, candidate_name, candidate_mask, "", global_parameters, global_fresh, global_dead, structs, seen, bad)
                    _:
                        pass
                match declaration:
                    Decl.Module(module_name, body, line):
                        disjoint_scan_declarations(body, all_declarations, candidate_name, candidate_mask, structs, seen, bad)
                    _:
                        pass
                match declaration:
                    Decl.Scoped(body, line):
                        disjoint_scan_declarations(body, all_declarations, candidate_name, candidate_mask, structs, seen, bad)


                    _:
                        pass


        def disjoint_collect_candidates(declarations: darray[Decl]&, all_declarations: darray[Decl]&, annotations: darray[Ast::EnumAnnotation]&, structs: mutable StructTable&) -> void can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                for declaration in declarations |structs|:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            eligible_count: mutable u32 = 0
                            mask: mutable u64 = 0
                            parameter_index: mutable u32 = 0
                            for parameter in parameters |eligible_count, mask, parameter_index, structs|:
                                if parameter_index < DISJOINT_SCOPE_COUNT and disjoint_numeric_darray_ref(parameter.type_expression, structs):
                                    eligible_count <- eligible_count + 1
                                    bit: mutable u64 = 1
                                    for _ in 0..<parameter_index |bit|:
                                        bit <- bit * 2
                                    mask <- mask + bit
                                parameter_index <- parameter_index + 1
                            if eligible_count >= 2 and disjoint_function_name_count(all_declarations, function_name) == 1 and disjoint_global_value_name_count(all_declarations, function_name) == 0 and not disjoint_function_is_exported(function_name, annotations):
                                duplicate_index: mutable i64 = -1
                                for existing in 0..<structs.disjoint_function_names.count |duplicate_index, function_name, structs|:
                                    if structs.disjoint_function_names[existing] == function_name:
                                        duplicate_index <- existing.i64()
                                if duplicate_index >= 0:
                                    structs.disjoint_candidate_masks[duplicate_index.usize()] <- 0
                                    structs.disjoint_function_masks[duplicate_index.usize()] <- 0
                                    structs.disjoint_function_arities[duplicate_index.usize()] <- 0
                                else:
                                    structs.disjoint_function_names <- structs.disjoint_function_names.push(function_name)
                                    structs.disjoint_candidate_masks <- structs.disjoint_candidate_masks.push(mask)
                                    structs.disjoint_function_masks <- structs.disjoint_function_masks.push(0)
                                    structs.disjoint_function_arities <- structs.disjoint_function_arities.push(parameters.count.u32())
                        _:
                            pass
                    match declaration:
                        Decl.Module(module_name, body, line):
                            disjoint_collect_candidates(body, all_declarations, annotations, structs)
                        _:
                            pass
                    match declaration:
                        Decl.Scoped(body, line):
                            disjoint_collect_candidates(body, all_declarations, annotations, structs)


                        _:
                            pass


        def disjoint_finalize_facts(declarations: darray[Decl]&, structs: mutable StructTable&) -> void can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic, Memory.Allocate:
                changed: mutable bool = true
                rounds: mutable u32 = 0
                while changed and rounds < structs.disjoint_function_names.count.u32() + 1 |changed, rounds, structs|:
                    changed <- false
                    for index in 0..<structs.disjoint_function_names.count |index, declarations, structs, changed|:
                        seen: mutable bool = false
                        bad: mutable bool = false
                        candidate_mask: u64 = structs.disjoint_candidate_masks[index]
                        disjoint_scan_declarations(declarations, declarations, structs.disjoint_function_names[index], candidate_mask, structs, seen, bad)
                        # Omitted struct fields evaluate their stored initializers at each
                        # construction site. They are executable expressions too, even
                        # though they do not appear beneath a function's explicit AST body.
                        default_fresh: mutable darray[sview] = []
                        default_dead: mutable darray[sview] = []
                        default_parameters: darray[Ast::ParamDecl] = []
                        for default_expression in structs.field_default_values |candidate_mask, structs, seen, bad, default_fresh, default_dead, default_parameters|:
                            disjoint_scan_expr(default_expression, structs.disjoint_function_names[index], candidate_mask, "", default_parameters, default_fresh, default_dead, structs, seen, bad)
                        desired: u64 = candidate_mask if seen and not bad else 0
                        if structs.disjoint_function_masks[index] != desired:
                            structs.disjoint_function_masks[index] <- desired
                            changed <- true
                    rounds <- rounds + 1
