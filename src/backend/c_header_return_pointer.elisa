# Identify the annotation row that marks an exported function's return as a pointer.
module CHeaderReturnPointer:
    public:
        def matches_marker(annotation_owner: sview, annotation_name: sview, function_name: sview) -> bool:
            ensure result == (annotation_owner == "__extern_return_ptr" and annotation_name == function_name)
            return annotation_owner == "__extern_return_ptr" and annotation_name == function_name
