                    elif region_forward_statement is Stmt.Block(region_forward_stmt_block_kind, region_forward_stmt_block_clause, region_forward_stmt_block_binding, region_forward_stmt_block_body, region_forward_stmt_block_line):
                        region_scan_forwarding_statements(region_forward_stmt_block_body, params, structs, fact_row, changed)
                    elif region_forward_statement is Stmt.Match(region_forward_stmt_match_scrutinee, region_forward_stmt_match_arms, region_forward_stmt_match_line):
                        region_scan_forwarding_expression(region_forward_stmt_match_scrutinee, params, structs, fact_row, changed)
                        for region_forward_stmt_arm in region_forward_stmt_match_arms |params, structs, fact_row, changed|:
                            region_scan_forwarding_expression(region_forward_stmt_arm.guard, params, structs, fact_row, changed)
                            region_scan_forwarding_statements(region_forward_stmt_arm.body, params, structs, fact_row, changed)
                    elif region_forward_statement is Stmt.Contract(region_forward_contract_kind, region_forward_contract_expression, region_forward_contract_line):
                        region_scan_forwarding_expression(region_forward_contract_expression, params, structs, fact_row, changed)


        def region_fact_row(name: sview, line: u32, structs: StructTable&) -> i64 can[Abort.Panic]:
            for function_index in 0..<structs.region_fact_names.count |structs, name, line|:
                return function_index.i64() if structs.region_fact_names[function_index] == name and structs.region_fact_lines[function_index] == line
            return -1


        def region_record_declarations(declarations: darray[Decl], structs: mutable StructTable&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                for declaration in declarations |structs|:
                    if declaration is Decl.Func(region_fact_name, region_fact_params, region_fact_return, region_fact_body, region_fact_effects, region_fact_decorators, region_fact_line):
                        flags: mutable darray[bool] = []
                        body_region_parameter_flags(region_fact_params, region_fact_body, structs, flags)
                        structs.region_fact_names <- structs.region_fact_names.push(region_fact_name)
                        structs.region_fact_lines <- structs.region_fact_lines.push(region_fact_line.line)
                        structs.region_fact_starts <- structs.region_fact_starts.push(structs.region_fact_params.count)
                        structs.region_fact_counts <- structs.region_fact_counts.push(region_fact_params.count)
                        for flag in flags |structs|:
                            structs.region_fact_params <- structs.region_fact_params.push(flag)
                    elif declaration is Decl.Module(region_fact_module_name, region_fact_module_body, region_fact_module_line):
                        region_record_declarations(region_fact_module_body, structs)
                    elif declaration is Decl.Scoped(region_fact_scoped_body, region_fact_scoped_line):
                        region_record_declarations(region_fact_scoped_body, structs)


        def region_apply_forwarding_declarations(declarations: darray[Decl], structs: mutable StructTable&, changed: mutable bool&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                for declaration in declarations |structs, changed|:
                    if declaration is Decl.Func(region_forward_fact_name, region_forward_fact_params, region_forward_fact_return, region_forward_fact_body, region_forward_fact_effects, region_forward_fact_decorators, region_forward_fact_line):
                        row: i64 = region_fact_row(region_forward_fact_name, region_forward_fact_line.line, structs)
                        region_scan_forwarding_statements(region_forward_fact_body, region_forward_fact_params, structs, row.usize(), changed) if row >= 0
                    elif declaration is Decl.Module(region_forward_module_name, region_forward_module_body, region_forward_module_line):
                        region_apply_forwarding_declarations(region_forward_module_body, structs, changed)
                    elif declaration is Decl.Scoped(region_forward_scoped_body, region_forward_scoped_line):
                        region_apply_forwarding_declarations(region_forward_scoped_body, structs, changed)


        def register_region_abi_facts(top: darray[Decl], structs: mutable StructTable&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                region_record_declarations(top, structs)
                changed: mutable bool = true
                rounds: mutable usize = 0
                while changed and rounds <= structs.region_fact_names.count |structs, changed, rounds|:
                    changed <- false
                    region_apply_forwarding_declarations(top, structs, changed)
                    rounds <- rounds + 1


        def region_flags_for_function(params: darray[ParamDecl]&, body: darray[Stmt], line: u32, structs: mutable StructTable&, flags: mutable darray[bool]&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                row: i64 = region_fact_row_from_params(params, line, structs)
                if row >= 0:
                    start: usize = structs.region_fact_starts[row.usize()]
                    for parameter_index in 0..<params.count |flags, structs, start, row|:
                        flags.push(structs.region_fact_params[start + parameter_index])
                    return
                region_flags_for_function(params, body, line, structs, flags)


        def region_fact_row_from_params(params: darray[ParamDecl]&, line: u32, structs: StructTable&) -> i64 can[Abort.Panic]:
            for row in 0..<structs.region_fact_lines.count |structs, params, line|:
                continue if structs.region_fact_lines[row] != line or structs.region_fact_counts[row] != params.count
                return row.i64()
            return -1


        # Number of hidden caller-region parameters required by this function. Return storage and
        # explicit function region parameters remain signature facts; reference-parameter slots
        # come only from `body_region_parameter_flags`, matching stage0's inference pass.
        def signature_arena_count(params: darray[ParamDecl]&, return_value_type: ValueType, body: darray[Stmt], line: u32, structs: mutable StructTable&) -> usize can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                # A returned value has one ownership region even when several structural
                # predicates describe it (Parser is both an AST-bearing value and a struct
                # containing darrays). Counting predicates instead of regions shifted every
                # later hidden ABI parameter while still leaving verifier-valid LLVM.
                # Keep this decision in the same early-return helper used by body lowering.
                # Apart from avoiding two definitions of ownership, this prevents bootstrap
                # generations from disagreeing on the lowering of a long short-circuit chain.
                count: mutable usize = 1 if value_type_returns_caller_region(return_value_type, structs) else 0
                flags: mutable darray[bool] = []
                region_flags_for_function(params, body, line, structs, flags)
                for parameter_index in 0..<flags.count |flags, count|:
                    count <- count + 1.usize() if flags[parameter_index]
                count <- count + 1.usize() if line_has_region_parameter(line, structs)
                return count


        # The std collection helpers own their allocation ABI explicitly. Mutating helpers
        # receive `a: mutable Arena&` as their first declared parameter; read-only helpers do
        # not grow at all. Their generic `dict[K, T]&`/`set[T]&` parameters must therefore NOT
        # acquire a second hidden arena merely because type binding later reveals a growable
        # concrete struct. Stage0 decides the generic template ABI before specialization, so
        # adding that slot here makes the stage1 monomorph disagree with both the runtime symbol
        # and its own callers.
        def generic_helper_uses_explicit_allocator(name: sview) -> bool can[Abort.Panic]:
            return sview_matches_prefix(name, "arena_dict_", 0, 11) or sview_matches_prefix(name, "arena_set_", 0, 10)


        # Whether one explicit parameter contributes a hidden caller-region slot. Kept separate
        # from the aggregate signature counter so direct calls can map each hidden slot back to
        # the actual argument's declaration arena (e.g. table -> caller, var_types -> scratch).
        def value_type_carries_caller_region(value_type: ValueType, structs: mutable StructTable&) -> bool can[Abort.Panic]:
            can Abort.Panic:
                false return if value_type.kind != TypeKind.Ref
                target: ValueType = ref_target_of(value_type, structs)
                true return if target.kind == TypeKind.DArray
                true return if is_growable_container_struct(target, structs)
                true return if target.kind == TypeKind.Struct and struct_contains_darray(target, structs)
                return ast_value_needs_arena(target, structs)


        def function_parameter_has_region(fns: FnTable&, fn_index: i64, parameter_position: usize) -> bool can[Abort.Panic]:
            can Abort.Panic:
                false return if fn_index < 0 or fn_index.usize() >= fns.param_start.count
                flat_index: usize = fns.param_start[fn_index.usize()] + parameter_position
                return flat_index < fns.param_region_slots.count and fns.param_region_slots[flat_index]


        # A returned aggregate owns storage visible to the caller. When this fact is present,
        # the function's ambient allocation region is the hidden caller slot, even if the body
        # also creates temporary darrays. Using a callee-local scratch region here frees the
        # returned backing immediately before the caller can read it.
        def value_type_returns_caller_region(value_type: ValueType, structs: mutable StructTable&) -> bool can[Abort.Panic]:
            true return if value_type.kind == TypeKind.DArray
            true return if is_growable_container_struct(value_type, structs)
            true return if value_type.kind == TypeKind.Struct and struct_contains_darray(value_type, structs)
            return ast_value_needs_arena(value_type, structs)


        def signature_needs_arena(params: darray[ParamDecl]&, return_value_type: ValueType, structs: mutable StructTable&) -> bool can[Abort.Panic]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                # Generic callers that have a body use signature_arena_count directly. This
                # compatibility helper is retained for type-only probes and deliberately does
                # not infer a reference slot from shape alone.
                return ast_value_needs_arena(return_value_type, structs) or return_value_type.kind == TypeKind.DArray or is_growable_container_struct(return_value_type, structs) or (return_value_type.kind == TypeKind.Struct and struct_contains_darray(return_value_type, structs))


        # Stage0's internal ABI returns genuinely large aggregates through a hidden leading
        # destination pointer. This is deliberately a size rule, not a kind-only shortcut:
        # small structs (including the runtime's ordinary three-word headers) remain first-class
        # values, while compiler state such as Ast.File and Backend.StructTable uses sret.
        # Keep the threshold identical to stage0's aggregateMemoryClassThresholdBytes.
        def value_type_uses_sret(value_type: ValueType, structs: mutable StructTable&, ctx: LLVMContextRef) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            aggregate: bool = value_type.kind == TypeKind.Struct or value_type.kind == TypeKind.Array or value_type.kind == TypeKind.PayloadEnum or value_type.kind == TypeKind.Optional
            return false if not aggregate
            # Do not duplicate LLVM's aggregate layout in the ABI decision. The handwritten
            # payload-size helper is intentionally conservative for packed-enum metadata, but
            # it cannot account for every normal struct field (notably recursive/self-hosting
            # compiler state). A missed sret decision changes every following ABI slot and can
            # corrupt the caller before any verifier can diagnose it. LLVMSizeOf is evaluated
            # against the target data passed into StructTable, which is the layout used by the
            # emitted type. `LLVMSizeOf` itself is a ConstantExpr and cannot be read with the
            # ConstantInt accessor.
            aggregate_type: LLVMTypeRef = llvm_type_of(value_type, structs, ctx)
            return LLVMABISizeOfType(structs.target_data, aggregate_type) >= 1024.u64()


            # The recursive AST hierarchy is a compiler-internal packed value. Stage0 threads
            # its shared store through the parser and backend call graph as a hidden trailing
            # parameter. Keep the first ABI slice deliberately explicit here: the semantic
            # implementation later refines this to transitive per-root needs, while the stage1
            # self-host corpus has one compiler AST store (`Ast.Node`).
            # A function which directly invokes the parser/backend must own the shared AST
            # store before the first call. Stage0 computes this transitively from the call graph;
            # stage1 declarations are emitted in one pass, so retain the small structural walk
            # here and let the declaration pass mark the caller before it builds its ABI.
            # A bare AST hierarchy enum name whose CONSTRUCTION allocates into the packed store.
        def is_ast_enum_name(name: sview, structs: StructTable&) -> bool can[Abort.Panic]:
            can Abort.Panic:
                enum_index: i64 = packed_index_of(structs, name)
                # `packed_is_ast_root` answers whether an enum uses the AoS packed-store
                # representation. It is intentionally true for every user packed enum, so it
                # is not an AST-hierarchy predicate. Confusing the two made an ordinary
                # recursive `enum Node` acquire the compiler's hidden AST-store parameter;
                # a helper constructing it then required a store from its caller and stage1
                # declined a program that stage0 lowered with a local store. Only the sealed
                # zero-variant Node row and explicit Node refinements are compiler AST.
                true return if packed_is_ast_refinement(structs, enum_index)
                return packed_is_ast_root_row(structs, enum_index)

            # Syntactic test for a packed-AST CONSTRUCTOR call `Ast::Expr.Ident(…)` /
            # `Stmt.VarDecl(…)`: the callee is `NS::Enum.Variant` or `Enum.Variant` where Enum is
            # an AST hierarchy root. Building the node writes the AoS store, so a global helper
            # that constructs AST (e.g. `machine_from_is_condition`) needs the store threaded even
            # with no AST parameter and no frontend call.
        def callee_is_ast_constructor(callee: Expr, structs: StructTable&) -> bool can[Abort.Panic]:
            can Abort.Panic:
                match callee:
                    Expr.Field(ctor_head, ctor_variant, ctor_field_line):
                        match ctor_head:
                            Expr.Scope(ctor_scope_base, ctor_enum, ctor_scope_line):
                                return is_ast_enum_name(ctor_enum, structs)
                            _:
                                pass
                        match ctor_head:
                            Expr.Ident(ctor_enum_ident, ctor_enum_ident_line):
                                return is_ast_enum_name(ctor_enum_ident, structs)
                            _:
                                pass
                    _:
                        pass
                return false

        def expression_mentions_ast_store_call(expression: Expr, structs: StructTable&) -> bool can[Abort.Panic]:
            can Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, line):
                        match callee:
                            Expr.Ident(name, name_line):
                                true return if name == "frontend_parser_parse_file" or name == "frontend_parse"
                                # Pymodule report helpers traverse packed AST values through
                                # composed helper calls, so the hidden store requirement must
                                # propagate through their complete call chain.
                                true return if sview_len(name) > 14.usize() and sview_matches_prefix(name, "emit_pymodule_", 0, 14)
                            _:
                                pass
                        match callee:
                            Expr.Scope(scope_head, scope_name, scope_line):
                                match scope_head:
                                    Expr.Ident(scope_owner, scope_owner_line):
                                        true return if scope_owner == "Backend" and (scope_name == "emit_module" or scope_name == "emit_module_with_debug_trace")
                                    _:
                                        pass
                            _:
                                pass
                        true return if callee_is_ast_constructor(callee, structs)
                        true return if expression_mentions_ast_store_call(callee, structs)
                        for argument in arguments |expression|:
                            true return if expression_mentions_ast_store_call(argument, structs)
                        return false
                    _:
                        pass
                match expression:
                    Expr.Field(field_object, field_name, field_line):
                        return expression_mentions_ast_store_call(field_object, structs)
                    _:
                        pass
                match expression:
                    Expr.Scope(scope_base, scope_name, scope_line):
                        return expression_mentions_ast_store_call(scope_base, structs)
                    _:
                        pass
                match expression:
                    Expr.Index(index_object, index_value, index_line):
                        return expression_mentions_ast_store_call(index_object, structs) or expression_mentions_ast_store_call(index_value, structs)
                    _:
                        pass
                match expression:
                    Expr.Binary(binary_left, binary_operator, binary_right, binary_line):
                        return expression_mentions_ast_store_call(binary_left, structs) or expression_mentions_ast_store_call(binary_right, structs)
                    _:
                        pass
                match expression:
                    Expr.Unary(unary_operator, unary_operand, unary_line):
                        return expression_mentions_ast_store_call(unary_operand, structs)
                    _:
                        pass
                match expression:
                    Expr.Paren(paren_inner, paren_line):
                        return expression_mentions_ast_store_call(paren_inner, structs)
                    _:
                        pass
                match expression:
                    Expr.If(if_condition, if_then, if_else, if_line):
                        return expression_mentions_ast_store_call(if_condition, structs) or expression_mentions_ast_store_call(if_then, structs) or expression_mentions_ast_store_call(if_else, structs)
                    _:
                        pass
                return false

        def statements_mention_ast_store_call(statements: darray[Stmt]&, structs: StructTable&) -> bool can[Abort.Panic]:
            can Abort.Panic:
                for statement in statements:
                    match statement:
                        Stmt.Expr(expression, line):
                            true return if expression_mentions_ast_store_call(expression, structs)
                        _:
                            pass
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            true return if expression_mentions_ast_store_call(value, structs)
                        _:
                            pass
                    match statement:
                        Stmt.Assign(target, operator, value, line):
                            true return if expression_mentions_ast_store_call(target, structs) or expression_mentions_ast_store_call(value, structs)
                        _:
                            pass
                    match statement:
                        Stmt.Return(value_opt, line):
                            if value_opt is value:
