# Stage1 backend — signature FACTS: which types need an arena or the AST store, error-returning lines, f-strings.
# Part of `module Backend` (see codegen.elisa); split out to keep each file short.

extend Backend:
    private:
        # LLVM represents a null constant with a live opaque handle. `zeroed` only denotes
        # an absent C handle, so callers deciding whether an optional LLVM value is usable
        # must test both states explicitly.
        def llvm_value_is_null(value: LLVMValueRef) -> bool can[Abort.Panic]:
            true return if value == zeroed
            return LLVMIsNull(value) != 0


        # `__fstr(chunk_or_value, …)` — the compiler-emitted f-string builder the parser
        # desugars `f"…{x}…"` into. Each argument is a STRING-LIKE piece (a literal chunk or an
        # interpolated dstr/sview — the checker rejects a non-string interpolant), so lowering
        # is stage0's: sum the byte lengths, `ctx_fstr_alloc(total)` a `%DynArray__u8`, then
        # `ctx_fstr_append(slot, data, len)` each piece in order and load the result dstr.
        def emit_fstr_builtin(arguments: darray[Expr]&, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            int64_type: LLVMTypeRef = LLVMInt64TypeInContext(ctx)
            pointer_type: LLVMTypeRef = LLVMPointerTypeInContext(ctx, 0)
            dstr_header: LLVMTypeRef = darray_llvm_type(structs, ctx)
            datas: mutable darray[LLVMValueRef] = []
            lengths: mutable darray[LLVMValueRef] = []
            declined: mutable bool = false
            for argument in arguments |datas, lengths, declined, local_scope, fns, structs, generics, runtime, m, ctx, builder|:
                continue if declined
                match argument:
                    Expr.StringLit(chunk_text):
                        # Decoded, like every other literal: an f-string's LITERAL chunks carry the
                        # `\"` in `f"… \"{name}\" …"`, which is most of the diagnostic wording.
                        chunk_storage: mutable darray[u8] = []
                        chunk_global: LLVMValueRef = LLVMBuildGlobalStringPtr(builder, decoded_literal_cstr(chunk_text, chunk_storage), "fstr.chunk")
                        datas.push(chunk_global)
                        lengths.push(LLVMConstInt(int64_type, (chunk_storage.count - 1.usize()).u64(), 0))
                    _:
                        argument_type: ValueType = expression_type(argument, local_scope, fns, structs, generics)
                        is_dstr: bool = argument_type.kind == TypeKind.DArray and darray_element_of(argument_type, structs).kind == TypeKind.Unsigned and darray_element_of(argument_type, structs).bits == 8
                        is_sview: bool = argument_type.kind == TypeKind.SView
                        if not is_dstr and not is_sview:
                            declined <- true
                        elif emit_expression(argument, argument_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is piece_value:
                            # dstr `{ptr items, i64 count, i64 cap}` and sview `{ptr, i64 len}` both
                            # carry the data pointer at field 0 and the byte length at field 1.
                            datas.push(LLVMBuildExtractValue(builder, piece_value, 0, "fstr.data"))
                            lengths.push(LLVMBuildExtractValue(builder, piece_value, 1, "fstr.len"))
                        else:
                            declined <- true
            null return if declined
            total: mutable LLVMValueRef = LLVMConstInt(int64_type, 0, 0)
            for piece_length in lengths |total, builder|:
                total <- LLVMBuildAdd(builder, total, piece_length, "fstr.total")
            alloc_params: mutable darray[LLVMTypeRef] = [int64_type]
            alloc_params_pointer: void& = (&alloc_params[0]).cast[void&] can Unsafe.PointerCast
            alloc_type: LLVMTypeRef = LLVMFunctionType(dstr_header, alloc_params_pointer, 1, 0)
            alloc_fn: LLVMValueRef = declare_or_get_named(m, "ctx_fstr_alloc", alloc_type)
            alloc_args: mutable darray[LLVMValueRef] = [total]
            alloc_args_pointer: void& = (&alloc_args[0]).cast[void&] can Unsafe.PointerCast
            dstr_value: LLVMValueRef = LLVMBuildCall2(builder, alloc_type, alloc_fn, alloc_args_pointer, 1, "fstr.alloc")
            fstr_slot: LLVMValueRef = LLVMBuildAlloca(builder, dstr_header, "fstr.slot")
            _ = LLVMBuildStore(builder, dstr_value, fstr_slot)
            append_params: mutable darray[LLVMTypeRef] = [pointer_type, pointer_type, int64_type]
            append_params_pointer: void& = (&append_params[0]).cast[void&] can Unsafe.PointerCast
            append_type: LLVMTypeRef = LLVMFunctionType(LLVMVoidTypeInContext(ctx), append_params_pointer, 3, 0)
            append_fn: LLVMValueRef = declare_or_get_named(m, "ctx_fstr_append", append_type)
            piece_index: mutable usize = 0
            while piece_index < datas.count |piece_index, datas, lengths, fstr_slot, append_type, append_fn, builder|:
                append_args: mutable darray[LLVMValueRef] = [fstr_slot, datas[piece_index], lengths[piece_index]]
                append_args_pointer: void& = (&append_args[0]).cast[void&] can Unsafe.PointerCast
                _ = LLVMBuildCall2(builder, append_type, append_fn, append_args_pointer, 3, "")
                piece_index <- piece_index + 1
            return LLVMBuildLoad2(builder, dstr_header, fstr_slot, "fstr.result")


        # Whether the function declared at `line` returns an error union. The frontend
        # records error-returning functions by LINE in File.error_set_func_lines (the
        # `error[E]` clause is consumed at parse time; only this side table survives).
        def line_is_error_returning(error_lines: darray[u32]&, line: u32) -> bool can[Abort.Panic]:
            for error_line in error_lines |line|:
                true return if error_line == line
            return false


        # The type PARAMETER of a generic extern with this name, or "" when the name is not
        # one. Generic externs are instantiated at the CALL, not at their declaration.
        def generic_extern_param_of(structs: StructTable&, name: sview) -> sview can[Abort.Panic]:
            for index in 0..<structs.generic_extern_names.count |structs, name|:
                continue if structs.generic_extern_names[index] != name
                return structs.generic_extern_params[index]
            return ""


        # stage0's SOURCE-LEVEL spelling of a scalar type, which is what it mangles a generic
        # instantiation with (`push__i64`). "" for anything whose spelling is not reproduced
        # here — the caller then declines rather than guessing a symbol name that would link
        # against the wrong instantiation.
        def stage0_scalar_type_name(value_type: ValueType) -> sview can[Abort.Panic]:
            if value_type.kind == TypeKind.Signed:
                "i8" return if value_type.bits == 8
                "i16" return if value_type.bits == 16
                "i32" return if value_type.bits == 32
                "i64" return if value_type.bits == 64
            if value_type.kind == TypeKind.Unsigned:
                "u8" return if value_type.bits == 8
                "u16" return if value_type.bits == 16
                "u32" return if value_type.bits == 32
                "u64" return if value_type.bits == 64
            if value_type.kind == TypeKind.Float:
                "f32" return if value_type.bits == 32
                "f64" return if value_type.bits == 64
            "bool" return if value_type.kind == TypeKind.Bool
            return ""


        # Whether an error SET declares at least one PAYLOAD-carrying variant. That is the
        # whole ABI switch: stage0 returns a plain `i32` for a fieldless set (which is what
        # stage1 has always emitted) and a `%ErrSet__E` STRUCT for one with payloads. Gating on
        # this keeps every fieldless program — including the compiler's own source, whose error
        # sets are fieldless throughout — on exactly the code path it already used.
        def error_set_has_payload(structs: StructTable&, set_name: sview) -> bool can[Abort.Panic]:
            false return if set_name == ""
            # The name must have been DECLARED `error Name:`. The clause alone is not proof:
            # this compiler's own source writes `error[E]`/`error[R]` for GENERIC PARAMETERS
            # and `error[Ident]` for an unrelated name, and matching those against the
            # payload-enum pool switched the ABI on functions that must return i32 — which
            # broke self-hosting outright (the driver emitted nothing, exit 2).
            declared: mutable bool = false
            for declared_name in structs.error_set_decl_names |declared, set_name|:
                declared <- true if declared_name == set_name
            false return if not declared
            set_index: i64 = penum_index_of(structs, set_name)
            false return if set_index < 0
            variant_start: usize = structs.penum_variant_start[set_index.usize()]
            variant_span: usize = structs.penum_variant_count[set_index.usize()]
            carries: mutable bool = false
            for offset in 0..<variant_span |carries, variant_start, structs|:
                carries <- true if structs.penum_field_type_count[variant_start + offset] > 0.usize()
            return carries


        # Python's stable wrapper exposes error payload storage through one caller-owned pointer.
        # Scalar payloads use the field's native type; structured payloads use the complete error
        # union struct, which lets the C shim inspect the active tag and copy named fields without
        # inventing a second variant-specific ABI.
        def error_set_single_payload_type(structs: StructTable&, set_name: sview) -> ValueType can[Abort.Panic]:
            missing: ValueType = ValueType{kind: TypeKind.Unmodeled, bits: 0}
            missing return if set_name == ""
            declared: mutable bool = false
            for declared_name in structs.error_set_decl_names |declared, set_name|:
                declared <- true if declared_name == set_name
            missing return if not declared
            set_index: i64 = penum_index_of(structs, set_name)
            missing return if set_index < 0
            variant_start: usize = structs.penum_variant_start[set_index.usize()]
            variant_span: usize = structs.penum_variant_count[set_index.usize()]
            field_total: mutable usize = 0
            payload: mutable ValueType = missing
            for offset in 0..<variant_span |field_total, payload, variant_start, structs|:
                field_start: usize = structs.penum_field_type_start[variant_start + offset]
                field_span: usize = structs.penum_field_type_count[variant_start + offset]
                field_total <- field_total + field_span
                if field_span == 1:
                    payload <- copied_type(structs.penum_field_types[field_start])
            return payload if field_total == 1
            return missing


        def error_payload_type_supported(payload: ValueType, structs: mutable StructTable&) -> bool can[Abort.Panic]:
            if payload.kind == TypeKind.Struct:
                # Struct payloads all use the same by-value LLVM representation. The Python
                # bridge chooses the concrete owning copier (named record, dictionary, or set),
                # while the backend must still thread the arena for the struct-shaped ABI.
                return true
            if payload.kind == TypeKind.Optional:
                # Value optionals use stage0's `{i1, T}` representation while pointer/text/object
                # optionals use the niche representation (`T` itself). Keep the backend facts
                # aligned with the Python shim's supported optional spellings.
                optional_payload: ValueType = optional_payload_of(payload, structs)
                return optional_payload.kind == TypeKind.Signed or optional_payload.kind == TypeKind.Unsigned or optional_payload.kind == TypeKind.Bool or optional_payload.kind == TypeKind.Float or optional_payload.kind == TypeKind.SView or optional_payload.kind == TypeKind.CStr or optional_payload.kind == TypeKind.PyObject
            return payload.kind == TypeKind.Signed or payload.kind == TypeKind.Unsigned or payload.kind == TypeKind.Bool or payload.kind == TypeKind.Float or payload.kind == TypeKind.CStr or payload.kind == TypeKind.SView or payload.kind == TypeKind.PyObject or payload.kind == TypeKind.DArray or payload.kind == TypeKind.View


        # Structured Python payloads use the native error-union layout as their source of truth.
        # Every field must be in the bridge's owning-conversion subset (scalar/text/object or a
        # supported aggregate container) so the generated C shim can copy it before arena release.
        def error_set_payload_supported(structs: mutable StructTable&, set_name: sview) -> bool can[Abort.Panic]:
            false return if set_name == ""
            declared: mutable bool = false
            for declared_name in structs.error_set_decl_names |declared, set_name|:
                declared <- true if declared_name == set_name
            false return if not declared
            set_index: i64 = penum_index_of(structs, set_name)
            false return if set_index < 0
            variant_start: usize = structs.penum_variant_start[set_index.usize()]
            variant_span: usize = structs.penum_variant_count[set_index.usize()]
            saw_field: mutable bool = false
            for offset in 0..<variant_span |saw_field, variant_start, structs|:
                field_start: usize = structs.penum_field_type_start[variant_start + offset]
                field_span: usize = structs.penum_field_type_count[variant_start + offset]
                for field_offset in 0..<field_span |saw_field, field_start, structs|:
                    saw_field <- true
                    return false if not error_payload_type_supported(copied_type(structs.penum_field_types[field_start + field_offset]), structs)
            return saw_field


        # A darray carried by an error payload borrows element storage. Thread the caller's
        # arena through every function in that error family so payloads built inside the native
        # function stay alive until the Python shim has copied them into a list/bytes object.
        # Dictionaries and sets share the caller arena with darray/view payloads. The Python
        # bridge copies their bucket tables before releasing that arena.
        def error_set_payload_needs_arena(structs: mutable StructTable&, set_name: sview) -> bool can[Abort.Panic]:
            false return if set_name == ""
            declared: mutable bool = false
            for declared_name in structs.error_set_decl_names |declared, set_name|:
                declared <- true if declared_name == set_name
            false return if not declared
            set_index: i64 = penum_index_of(structs, set_name)
            false return if set_index < 0
            variant_start: usize = structs.penum_variant_start[set_index.usize()]
            variant_span: usize = structs.penum_variant_count[set_index.usize()]
            for offset in 0..<variant_span |variant_start, structs|:
                field_start: usize = structs.penum_field_type_start[variant_start + offset]
                field_span: usize = structs.penum_field_type_count[variant_start + offset]
                for field_offset in 0..<field_span |field_start, structs|:
                    field_kind: TypeKind = copied_type(structs.penum_field_types[field_start + field_offset]).kind
                    true return if field_kind == TypeKind.Struct or field_kind == TypeKind.DArray or field_kind == TypeKind.View
            return false


        # The index of an error set variant's FIRST payload slot in the `%ErrSet__E` struct.
        # Measured from stage0's IR: field 0 is the i32 tag, then every variant's fields
        # CONCATENATED in declaration order — the slots are NOT overlapped, so a variant's
        # field i sits at `1 + (sum of the preceding variants' field counts) + i`, and slots
        # belonging to other variants are left `undef`.
        def error_set_variant_field_base(structs: StructTable&, set_index: i64, variant_offset: usize) -> usize can[Abort.Panic]:
            variant_start: usize = structs.penum_variant_start[set_index.usize()]
            base: mutable usize = 1
            for offset in 0..<variant_offset |base, variant_start, structs|:
                base <- base + structs.penum_field_type_count[variant_start + offset]
            return base


        # `%ErrSet__E = type { i32, <every variant's fields, concatenated> }`.
        def error_set_llvm_type(structs: mutable StructTable&, set_name: sview, ctx: LLVMContextRef) -> LLVMTypeRef can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            set_index: i64 = penum_index_of(structs, set_name)
            variant_start: usize = structs.penum_variant_start[set_index.usize()]
            variant_span: usize = structs.penum_variant_count[set_index.usize()]
            set_fields: mutable darray[LLVMTypeRef] = [LLVMInt32TypeInContext(ctx)]
            for offset in 0..<variant_span |set_fields, variant_start, structs, ctx|:
                field_start: usize = structs.penum_field_type_start[variant_start + offset]
                field_span: usize = structs.penum_field_type_count[variant_start + offset]
                for field_offset in 0..<field_span |set_fields, field_start, structs, ctx|:
                    set_fields.push(llvm_type_of(copied_type(structs.penum_field_types[field_start + field_offset]), structs, ctx))
            set_pointer: void& = (&set_fields[0]).cast[void&] can Unsafe.PointerCast
            return LLVMStructTypeInContext(ctx, set_pointer, set_fields.count.u32(), 0)


        # The value an error function returns on SUCCESS: a bare `i32 0` for a fieldless set,
        # and `{ i32 0, undef... }` for a payload-carrying one, whose signature declares the
        # `%ErrSet__E` struct.
        #
        # This existed as an inline `LLVMConstInt(i32, 0)` at seven return sites. When the
        # struct ABI landed, all seven kept emitting `ret i32 0` from a function declared to
        # return the struct — malformed IR that LLVM did NOT reject: it ran correctly at -O0
        # and MISCOMPILED at -O2 (the success value read back as 0 instead of 3). One helper,
        # so a future ABI change cannot leave six of seven sites behind.
        def error_success_return_value(structs: mutable StructTable&, runtime: Runtime&, ctx: LLVMContextRef) -> LLVMValueRef can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            success_code: LLVMValueRef = LLVMConstInt(LLVMInt32TypeInContext(ctx), 0, 0)
            success_set: sview = line_error_set_name(structs.error_fn_lines, structs.error_fn_set_names, runtime.error_fn_line)
            success_code return if not error_set_has_payload(structs, success_set)
            # A zeroinitializer rather than insertvalue-into-undef: field 0 is the tag and 0 IS
            # success, and the catch path reads no other field on the success branch. It also
            # needs no builder, so every return site can call this.
            return LLVMConstNull(error_set_llvm_type(structs, success_set, ctx))


        # Whether the named function returns a PAYLOAD-carrying error set, i.e. whether its
        # LLVM return value is the `%ErrSet__E` struct rather than a bare i32 code. Every catch
        # site asks this to decide whether the code needs an `extractvalue` first.
        #
        # Resolved through the function's LINE rather than by introspecting the LLVM type,
        # because LLVMGetTypeKind is not bound here — and a magic type-kind ordinal would be a
        # silent breakage the day the enum shifts.
        def function_returns_error_struct(fns: FnTable&, structs: StructTable&, owner: sview, name: sview) -> bool can[Abort.Panic]:
            index: i64 = function_index_of(fns, owner, name)
            false return if index < 0
            false return if not fns.is_error[index.usize()]
            return error_set_has_payload(structs, line_error_set_name(structs.error_fn_lines, structs.error_fn_set_names, fns.lines[index.usize()]))


        # The error SET NAME declared at `line` (`-> i64 error[BackendError]` -> "BackendError"),
        # or "" when the line declares none or the clause was not the plain `error[Ident]` form.
        # Index-parallel with error_lines; a shorter names pool (an older serialized File) reads
        # as "", which keeps the i32 error ABI — the conservative answer.
        def line_error_set_name(error_lines: darray[u32]&, error_names: darray[sview]&, line: u32) -> sview can[Abort.Panic]:
            scan: mutable usize = 0
            while scan < error_lines.count |scan, error_lines, error_names, line|:
                if error_lines[scan] == line:
                    "" return if scan >= error_names.count
                    return error_names[scan]
                scan <- scan + 1
            return ""


        # Whether a struct holds a darray anywhere in its (recursive) fields — such a struct
        # returned by value carries a darray whose BUFFER must outlive the callee, so the
        # function must thread the caller's arena (build the darray there, not in the callee's
        # auto-region which frees on return → a use-after-free when the caller reads it).
        # A `dict`/`set` is a DynDict/DynSet STRUCT instantiation whose buckets hang off a
        # raw `ptr` — there is no DArray field to find, so struct_contains_darray cannot see
        # it. It grows exactly like a darray though, so for ABI purposes it must count:
        # `index_it(h: mutable Holder&) -> h.m.put(...)` allocates buckets that have to
        # outlive the call, and without the caller's arena threaded in they were allocated in
        # the callee's auto-region and FREED on return (use-after-free on the next `.get`).
        def is_growable_container_struct(value_type: ValueType, structs: StructTable&) -> bool can[Abort.Panic]:
            false return if value_type.kind != TypeKind.Struct
            true return if synthesized_struct_base_is(structs, value_type, "DynDict")
            true return if synthesized_struct_base_is(structs, value_type, "DynSet")
            container_name: sview = structs.names[value_type.bits.usize()]
            return when container_name:
                "DynDict" | "DynSet" -> true
                _ -> false


        # This fact is a graph property, not a tree property. Recursive and mutually recursive
        # records are valid; cache 0=unknown, 1=visiting, 2=no darray, 3=contains darray so a
        # recursive ABI query terminates and all later queries are O(1).
        def struct_contains_darray(struct_type: ValueType, structs: mutable StructTable&) -> bool can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic, Memory.Allocate:
                false return if struct_type.kind != TypeKind.Struct
                true return if is_growable_container_struct(struct_type, structs)
                struct_darray_slot: usize = struct_type.bits.usize()
                false return if struct_darray_slot >= structs.names.count
                while structs.struct_darray_cache.count <= struct_darray_slot |structs|:
                    structs.struct_darray_cache <- structs.struct_darray_cache.push(0)
                cached: u8 = structs.struct_darray_cache[struct_darray_slot]
                true return if cached == 3
                false return if cached == 1 or cached == 2
                structs.struct_darray_cache[struct_darray_slot] <- 1
                struct_darray_start: usize = structs.field_start[struct_darray_slot]
                struct_darray_count: usize = structs.field_count[struct_darray_slot]
                for struct_darray_index in 0..<struct_darray_count |structs, struct_darray_start|:
                    struct_darray_field: ValueType = copied_type(structs.field_types[struct_darray_start + struct_darray_index])
                    if struct_darray_field.kind == TypeKind.DArray or is_growable_container_struct(struct_darray_field, structs):
                        structs.struct_darray_cache[struct_darray_slot] <- 3
                        return true
                    if struct_darray_field.kind == TypeKind.Struct and struct_contains_darray(struct_darray_field, structs):
                        structs.struct_darray_cache[struct_darray_slot] <- 3
                        return true
                structs.struct_darray_cache[struct_darray_slot] <- 2
                return false

            # AST handles are packed enums whose payload side tables live outside the
            # value representation. Returning one must keep those nested buffers in a
            # region owned by the caller. Optional AST handles carry the same rule.
        def ast_value_needs_arena(value_type: ValueType, structs: mutable StructTable&) -> bool can[Abort.Panic]:
            can Abort.Panic:
                if value_type.kind == TypeKind.Optional:
                    return ast_value_needs_arena(optional_payload_of(value_type, structs), structs)
                # Packed-enum values are handles into side-table-backed storage. The
                # metadata name is normalized differently across module/extend forms,
                # so key the ABI rule on representation rather than spelling.
                return value_type.kind == TypeKind.PackedEnum

            # `def f[@r](xs: darray[T] @r)` — a REGION PARAMETER. The body's `@r`-annotated locals
            # allocate from the caller's region, and the values they build are written back into
            # caller-visible storage, so the region must be threaded in. Nothing in such a
            # signature need be a reference: `easm_prune_conditional_inputs[@r]` takes a
            # `mutable darray[Function] @r` BY VALUE (the header is copied; the element storage is
            # shared) and rebuilds each element's `inputs`/`params` darrays. With no arena
            # threaded, stage1 gave it an auto region, allocated those darrays there, and
            # `arena_free`d the region on return -- handing the caller freed memory. That is the
            # intermittent (~3%) `easm_lockstep_parse_smoke` segfault: whether the munmap'd block
            # had been remapped by the time `verify_function_header` read it was pure luck.
            #
            # Measured against stage0, which is the same rule: `def prune[@r](boxes: mutable
            # darray[Box] @r)` emits `void @prune(%DynArray__Box, ptr)`; drop the `[@r]` and the
            # trailing `ptr` disappears.
        def line_has_region_parameter(line: u32, structs: StructTable&) -> bool:
            for region_line in structs.region_param_lines |line|:
                true return if region_line == line
            return false

        # The methods whose receiver can allocate into its backing region. A reference parameter
        # only acquires a hidden region slot when the body actually grows that receiver. Counting
        # every reference aggregate from its TYPE was the source of the self-hosting corruption:
        # `check_assigns` has three read-only darray references but only grows `table.diagnostics`,
        # so stage0 gives it one slot, not four.
        def region_growth_method(method: sview) -> bool can[Abort.Panic]:
            return method == "push" or method == "extend" or method == "insert" or method == "resize" or method == "reserve" or method == "put" or method == "add" or method == "append"


        def region_growth_root(expression: Expr) -> sview can[Abort.Panic]:
            if expression is Expr.Ident(region_root_name, region_root_line):
                return region_root_name
            if expression is Expr.Paren(region_root_inner, region_root_paren_line):
                return region_growth_root(region_root_inner)
            if expression is Expr.Move(region_root_moved, region_root_move_line):
                return region_growth_root(region_root_moved)
            if expression is Expr.Unary(region_root_operator, region_root_operand, region_root_unary_line):
                return region_growth_root(region_root_operand)
            if expression is Expr.Field(region_root_object, region_root_field, region_root_field_line):
                return region_growth_root(region_root_object)
            if expression is Expr.Index(region_root_indexed, region_root_index, region_root_index_line):
                return region_growth_root(region_root_indexed)
            if expression is Expr.Slice(region_root_sliced, region_root_low, region_root_high, region_root_slice_line):
                return region_growth_root(region_root_sliced)
            return ""


        def ref_type_can_grow(value_type: ValueType, structs: mutable StructTable&) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                false return if value_type.kind != TypeKind.Ref
                target: ValueType = ref_target_of(value_type, structs)
                true return if target.kind == TypeKind.DArray
                true return if is_growable_container_struct(target, structs)
                true return if target.kind == TypeKind.Struct and struct_contains_darray(target, structs)
                return false


        def region_mark_root(root: sview, params: darray[ParamDecl]&, flags: mutable darray[bool]&, structs: mutable StructTable&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                return if root == ""
                for parameter_index in 0..<params.count |params, flags, root, structs|:
                    continue if params[parameter_index].name != root
                    parameter_type: ValueType = parameter_value_type(params[parameter_index].type_expression, structs)
                    flags[parameter_index] <- true if ref_type_can_grow(parameter_type, structs)
                    return


        def region_scan_expression(expression: Expr, params: darray[ParamDecl]&, flags: mutable darray[bool]&, structs: mutable StructTable&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                if expression is Expr.Call(region_call_callee, region_call_arguments, region_call_names, region_call_line):
                    if region_call_callee is Expr.Field(region_call_receiver, region_call_method, region_call_field_line):
                        region_mark_root(region_growth_root(region_call_receiver), params, flags, structs) if region_growth_method(region_call_method)
                    region_scan_expression(region_call_callee, params, flags, structs)
                    for region_call_argument in region_call_arguments |params, flags, structs|:
                        region_scan_expression(region_call_argument, params, flags, structs)
                    return
