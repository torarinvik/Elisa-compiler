# Stage1 backend — signature FACTS: which types need an arena or the AST store, error-returning lines, f-strings.
# Part of `module Backend` (see codegen.elisa); split out to keep each file short.

extend Backend:
    private:
        # LLVM represents a null constant with a live opaque handle. `zeroed` only denotes
        # an absent C handle, so callers deciding whether an optional LLVM value is usable
        # must test both states explicitly.
        def llvm_value_is_null(value: LLVMValueRef) -> bool can[Abort.Panic]:
            true return if value == zeroed
            return LLVMIsNull(value) != 0




        # `__fstr(chunk_or_value, …)` — the compiler-emitted f-string builder the parser
        # desugars `f"…{x}…"` into. Each argument is a STRING-LIKE piece (a literal chunk or an
        # interpolated dstr/sview — the checker rejects a non-string interpolant), so lowering
        # is stage0's: sum the byte lengths, `ctx_fstr_alloc(total)` a `%DynArray__u8`, then
        # `ctx_fstr_append(slot, data, len)` each piece in order and load the result dstr.
        def emit_fstr_builtin(arguments: darray[Expr]&, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            int64_type: LLVMTypeRef = LLVMInt64TypeInContext(ctx)
            pointer_type: LLVMTypeRef = LLVMPointerTypeInContext(ctx, 0)
            dstr_header: LLVMTypeRef = darray_llvm_type(structs, ctx)
            datas: mutable darray[LLVMValueRef] = []
            lengths: mutable darray[LLVMValueRef] = []
            declined: mutable bool = false
            for argument in arguments |datas, lengths, declined, local_scope, fns, structs, generics, runtime, m, ctx, builder|:
                continue if declined
                match argument:
                    Expr.StringLit(chunk_text, _):
                        # Decoded, like every other literal: an f-string's LITERAL chunks carry the
                        # `\"` in `f"… \"{name}\" …"`, which is most of the diagnostic wording.
                        chunk_storage: mutable darray[u8] = []
                        chunk_global: LLVMValueRef = LLVMBuildGlobalStringPtr(builder, decoded_literal_cstr(chunk_text, chunk_storage), "fstr.chunk")
                        datas.push(chunk_global)
                        lengths.push(LLVMConstInt(int64_type, (chunk_storage.count - 1.usize()).u64(), 0))
                    _:
                        argument_type: ValueType = expression_type(argument, local_scope, fns, structs, generics)
                        is_dstr: bool = argument_type.kind == TypeKind.DArray and darray_element_of(argument_type, structs).kind == TypeKind.Unsigned and darray_element_of(argument_type, structs).bits == 8
                        is_sview: bool = argument_type.kind == TypeKind.SView
                        if not is_dstr and not is_sview:
                            declined <- true
                        elif emit_expression(argument, argument_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is piece_value:
                            # dstr `{ptr items, i64 count, i64 cap}` and sview `{ptr, i64 len}` both
                            # carry the data pointer at field 0 and the byte length at field 1.
                            datas.push(LLVMBuildExtractValue(builder, piece_value, 0, "fstr.data"))
                            lengths.push(LLVMBuildExtractValue(builder, piece_value, 1, "fstr.len"))
                        else:
                            declined <- true
            null return if declined
            total: mutable LLVMValueRef = LLVMConstInt(int64_type, 0, 0)
            for piece_length in lengths |total, builder|:
                total <- LLVMBuildAdd(builder, total, piece_length, "fstr.total")
            alloc_params: mutable darray[LLVMTypeRef] = [int64_type]
            alloc_params_pointer: void& = (&alloc_params[0]).cast[void&] can Unsafe.PointerCast
            alloc_type: LLVMTypeRef = LLVMFunctionType(dstr_header, alloc_params_pointer, 1, 0)
            alloc_fn: LLVMValueRef = declare_or_get_named(m, "ctx_fstr_alloc", alloc_type)
            alloc_args: mutable darray[LLVMValueRef] = [total]
            alloc_args_pointer: void& = (&alloc_args[0]).cast[void&] can Unsafe.PointerCast
            dstr_value: LLVMValueRef = LLVMBuildCall2(builder, alloc_type, alloc_fn, alloc_args_pointer, 1, "fstr.alloc")
            fstr_slot: LLVMValueRef = build_entry_alloca(builder, dstr_header, "fstr.slot")
            _ = LLVMBuildStore(builder, dstr_value, fstr_slot)
            append_params: mutable darray[LLVMTypeRef] = [pointer_type, pointer_type, int64_type]
            append_params_pointer: void& = (&append_params[0]).cast[void&] can Unsafe.PointerCast
            append_type: LLVMTypeRef = LLVMFunctionType(LLVMVoidTypeInContext(ctx), append_params_pointer, 3, 0)
            append_fn: LLVMValueRef = declare_or_get_named(m, "ctx_fstr_append", append_type)
            piece_index: mutable usize = 0
            while piece_index < datas.count |piece_index, datas, lengths, fstr_slot, append_type, append_fn, builder|:
                append_args: mutable darray[LLVMValueRef] = [fstr_slot, datas[piece_index], lengths[piece_index]]
                append_args_pointer: void& = (&append_args[0]).cast[void&] can Unsafe.PointerCast
                _ = LLVMBuildCall2(builder, append_type, append_fn, append_args_pointer, 3, "")
                piece_index <- piece_index + 1
            return LLVMBuildLoad2(builder, dstr_header, fstr_slot, "fstr.result")




        # The type PARAMETER of a generic extern with this name, or "" when the name is not
        # one. Generic externs are instantiated at the CALL, not at their declaration.
        def generic_extern_param_of(structs: StructTable&, name: sview) -> sview can[Abort.Panic]:
            for index in 0..<structs.generic_extern_names.count |structs, name|:
                continue if structs.generic_extern_names[index] != name
                return structs.generic_extern_params[index]
            return ""




        # stage0's SOURCE-LEVEL spelling of a scalar type, which is what it mangles a generic
        # instantiation with (`push__i64`). "" for anything whose spelling is not reproduced
        # here — the caller then declines rather than guessing a symbol name that would link
        # against the wrong instantiation.
        def stage0_scalar_type_name(value_type: ValueType) -> sview can[Abort.Panic]:
            if value_type.kind == TypeKind.Signed:
                "i8" return if value_type.bits == 8
                "i16" return if value_type.bits == 16
                "i32" return if value_type.bits == 32
                "i64" return if value_type.bits == 64
            if value_type.kind == TypeKind.Unsigned:
                "u8" return if value_type.bits == 8
                "u16" return if value_type.bits == 16
                "u32" return if value_type.bits == 32
                "u64" return if value_type.bits == 64
            if value_type.kind == TypeKind.Float:
                "f32" return if value_type.bits == 32
                "f64" return if value_type.bits == 64
            "bool" return if value_type.kind == TypeKind.Bool
            return ""




        # Stage0's internal ABI passes genuinely large aggregates through memory. The same
        # size predicate drives both directions: a return gets a hidden sret destination and
        # an explicit parameter becomes a pointer with an explicit callee-owned copy. Keeping
        # this as one fact prevents a generic specialization from agreeing on its return ABI
        # while disagreeing on one of its bound aggregate parameters.
        def value_type_uses_indirect_aggregate(value_type: ValueType, structs: mutable StructTable&, ctx: LLVMContextRef) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            aggregate: bool = value_type.kind == TypeKind.Struct or value_type.kind == TypeKind.Array or value_type.kind == TypeKind.PayloadEnum or value_type.kind == TypeKind.Optional
            return false if not aggregate
            # Do not duplicate LLVM's aggregate layout in the ABI decision. The handwritten
            # payload-size helper is intentionally conservative for packed-enum metadata, but
            # it cannot account for every normal struct field (notably recursive/self-hosting
            # compiler state). A missed sret decision changes every following ABI slot and can
            # corrupt the caller before any verifier can diagnose it. LLVMSizeOf is evaluated
            # against the target data passed into StructTable, which is the layout used by the
            # emitted type. `LLVMSizeOf` itself is a ConstantExpr and cannot be read with the
            # ConstantInt accessor.
            aggregate_type: LLVMTypeRef = llvm_type_of(value_type, structs, ctx)
            return LLVMABISizeOfType(structs.target_data, aggregate_type) >= 1024.u64()




        # Large source-level aggregate returns use a hidden leading destination pointer and
        # LLVM `void` return. Keep the public helper named after that one-way ABI fact because
        # callers use it specifically when deciding whether to materialize a result slot.
        def value_type_uses_sret(value_type: ValueType, structs: mutable StructTable&, ctx: LLVMContextRef) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            return value_type_uses_indirect_aggregate(value_type, structs, ctx)




        # Materialize the pointer operand required by the internal memory-class aggregate ABI.
        # The source expression still produces a first-class aggregate; only the call boundary
        # changes representation. The alloca is intentionally at the current insertion point,
        # matching stage0's caller-side byval copy and keeping this helper valid in branch arms.
        def materialize_indirect_aggregate_argument(value: LLVMValueRef, value_type: ValueType, structs: mutable StructTable&, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            indirect: bool = value_type_uses_indirect_aggregate(value_type, structs, ctx)
            return value if not indirect
            slot: LLVMValueRef = build_entry_alloca(builder, llvm_type_of(value_type, structs, ctx), "byval.arg")
            _ = LLVMBuildStore(builder, value, slot)
            return slot




        # A local already owns a stable aggregate slot. Passing that slot directly avoids a
        # load/store round trip at an internal Elisa call boundary; the callee still makes its
        # explicit private copy, so this is value semantics rather than an aliasing change.
        # Resolve any addressable source place whose aggregate type matches WANTED. An internal
        # aggregate parameter is a value-semantic copy, so forwarding a field or indexed element
        # through its place is safe: the callee copies from this address into its private slot.
        # Rvalues and extern boundaries still go through materialize_indirect_aggregate_argument.
        def indirect_aggregate_argument_address(expression: Expr, wanted: ValueType, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            null return if not value_type_uses_indirect_aggregate(wanted, structs, ctx)
            match expression:
                Expr.Ident(name, line):
                    if lookup_slot(local_scope, name) is slot:
                        local_type: ValueType = lookup_type(local_scope, name)
                        return slot if value_type_identity_equal(local_type, wanted)
                _:
                    pass
            actual_type: ValueType = expression_type(expression, local_scope, fns, structs, generics)
            # A reference expression used where a value is wanted denotes a copy from its
            # pointee. The callee's private copy preserves that value semantics, so the pointee
            # place is an equally valid source address for the indirect ABI.
            place_type: mutable ValueType = actual_type
            place_type <- ref_target_of(actual_type, structs) if actual_type.kind == TypeKind.Ref
            null return if not value_type_identity_equal(place_type, wanted)
            if struct_chain_address(expression, local_scope, fns, structs, generics, runtime, m, ctx, builder) is place:
                return place
            return null




            # The ADDRESS of the darray header behind an EXPR receiver. For a struct field, the
            # header sits inline, so it is a GEP into the struct's address.
        def darray_address_of_expr(object: Expr, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                match object:
                    Expr.Ident(darray_name, darray_name_line):
                        return darray_address_of(local_scope, darray_name, structs, ctx, builder)
                    _:
                        pass
                match object:
                    Expr.Field(darray_inner, darray_field, darray_field_line):
                        inner_type: mutable ValueType = struct_chain_type(darray_inner, local_scope, structs)
                        # struct_chain_type has no function table and therefore cannot see
                        # through a call result. A darray field of a returned struct is still
                        # an ordinary inline header; use the full typer before resolving its
                        # address so expressions such as make_file().errors.count work.
                        inner_type <- expression_type(darray_inner, local_scope, fns, structs, generics) if inner_type.kind == TypeKind.Unmodeled
                        inner_type <- ref_target_of(inner_type, structs) if inner_type.kind == TypeKind.Ref
                        if inner_type.kind == TypeKind.Optional:
                            inner_payload: ValueType = optional_payload_of(inner_type, structs)
                            inner_type <- ref_target_of(inner_payload, structs) if inner_payload.kind == TypeKind.Ref
                        inner_type <- arena_user_struct(structs) if inner_type.kind == TypeKind.Arena
                        null return if inner_type.kind != TypeKind.Struct
                        inner_slot: usize = inner_type.bits.usize()
                        position: i64 = field_index_of(structs, inner_slot, darray_field)
                        null return if position < 0
                        if struct_chain_address(darray_inner, local_scope, fns, structs, generics, runtime, m, ctx, builder) is inner_address:
                            return LLVMBuildStructGEP2(builder, llvm_type_of(inner_type, structs, ctx), inner_address, position.u32(), "darray.field.ptr")
                        return null
                    _:
                        pass
                # `m[i]` where `m: darray[darray[T]]` — the address of the inner darray header is
                # the address of that element in the outer buffer (nested-index address).
                match object:
                    Expr.Index(indexed_darray, index_darray_expr, index_darray_line):
                        match indexed_darray:
                            Expr.Ident(indexed_optional_name, indexed_optional_line):
                                indexed_optional_type: ValueType = lookup_type(local_scope, indexed_optional_name)
                                if indexed_optional_type.kind == TypeKind.Optional:
                                    indexed_optional_payload: ValueType = optional_payload_of(indexed_optional_type, structs)
                                    if indexed_optional_payload.kind == TypeKind.Ref:
                                        indexed_optional_element: ValueType = ref_target_of(indexed_optional_payload, structs)
                                        if indexed_optional_element.kind == TypeKind.DArray:
                                            if lookup_slot(local_scope, indexed_optional_name) is indexed_optional_slot:
                                                indexed_optional_value: LLVMValueRef = LLVMBuildLoad2(builder, llvm_type_of(indexed_optional_type, structs, ctx), indexed_optional_slot, "darray.opt.ref")
                                                indexed_optional_base: LLVMValueRef = optional_payload_value_of(indexed_optional_value, indexed_optional_type, structs, ctx, builder)
                                                if emit_expression(index_darray_expr, ValueType{kind: TypeKind.Unsigned, bits: 64}, local_scope, fns, structs, generics, runtime, m, ctx, builder) is indexed_optional_index:
                                                    indexed_optional_indices: mutable darray[LLVMValueRef] = [indexed_optional_index]
                                                    indexed_optional_indices_pointer: void& = (&indexed_optional_indices[0]).cast[void&] can Unsafe.PointerCast
                                                    return LLVMBuildGEP2(builder, llvm_type_of(indexed_optional_element, structs, ctx), indexed_optional_base, indexed_optional_indices_pointer, 1, "darray.opt.ref.elem")
                            _:
                                pass
                        return struct_chain_address(object, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                    _:
                        pass
                # `make_array()[1]` — indexing a RETURNED darray. A call is an rvalue with no
                # address of its own, so every shape above missed it and the whole expression
                # declined. stage0 spills the result to a temporary and indexes that
                # (`%addr.tmp = alloca %DynArray__i32`), which is what this does.
                match object:
                    Expr.Call(temp_callee, temp_args, temp_arg_names, temp_call_line):
                        temp_type: ValueType = expression_type(object, local_scope, fns, structs, generics)
                        null return if temp_type.kind != TypeKind.DArray
                        if emit_expression(object, temp_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is temp_value:
                            temp_slot: LLVMValueRef = build_entry_alloca(builder, llvm_type_of(temp_type, structs, ctx), "addr.tmp")
                            _ = LLVMBuildStore(builder, temp_value, temp_slot)
                            return temp_slot
                        return null
                    _:
                        pass
                return null




        def darray_address_of(local_scope: mutable Scope&, name: sview, structs: mutable StructTable&, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic]:
            can Abort.Panic:
                bound: ValueType = lookup_type(local_scope, name)
                if lookup_slot(local_scope, name) is bound_slot:
                    bound_slot return if bound.kind == TypeKind.DArray
                    null return if bound.kind != TypeKind.Ref
                    null return if ref_target_of(bound, structs).kind != TypeKind.DArray
                    return LLVMBuildLoad2(builder, LLVMPointerTypeInContext(ctx, 0), bound_slot, "darray.ref")
                return null




            # `darray.pop()` decrements the header count and returns the now-last element.
            # Keep this as a value lowering rather than relying on a generic runtime symbol:
            # stage0 monomorphizes `darray_pop[T]`, while a self-hosted stage1 build must be able
            # to emit the compiler's own `u8`/Token/ValueType pops without an external generic
            # library object.
        def emit_darray_pop_value(slot: LLVMValueRef, array_type: ValueType, structs: mutable StructTable&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            element_type: ValueType = darray_element_of(array_type, structs)
            header: LLVMTypeRef = darray_llvm_type(structs, ctx)
            count_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, header, slot, 1, "pop.count.ptr")
            count: LLVMValueRef = LLVMBuildLoad2(builder, LLVMInt64TypeInContext(ctx), count_pointer, "pop.count")
            non_empty: LLVMValueRef = LLVMBuildICmp(builder, 34, count, LLVMConstInt(LLVMInt64TypeInContext(ctx), 0, 0), "pop.nonempty")
            parent: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
            pop_ok: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, parent, "pop.ok")
            pop_fail: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, parent, "pop.empty")
            _ = LLVMBuildCondBr(builder, non_empty, pop_ok, pop_fail)
            LLVMPositionBuilderAtEnd(builder, pop_fail)
            emit_trap_unreachable(m, ctx, builder)
            LLVMPositionBuilderAtEnd(builder, pop_ok)
            new_count: LLVMValueRef = LLVMBuildSub(builder, count, LLVMConstInt(LLVMInt64TypeInContext(ctx), 1, 0), "pop.new.count")
            _ = LLVMBuildStore(builder, new_count, count_pointer)
            items_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, header, slot, 0, "pop.items.ptr")
            items: LLVMValueRef = LLVMBuildLoad2(builder, LLVMPointerTypeInContext(ctx, 0), items_pointer, "pop.items")
            indices: mutable darray[LLVMValueRef] = [new_count]
            indices_pointer: void& = (&indices[0]).cast[void&] can Unsafe.PointerCast
            element_pointer: LLVMValueRef = LLVMBuildGEP2(builder, llvm_type_of(element_type, structs, ctx), items, indices_pointer, 1, "pop.element.ptr")
            return LLVMBuildLoad2(builder, llvm_type_of(element_type, structs, ctx), element_pointer, "pop.value")




        def ref_target_of(value_type: ValueType, structs: mutable StructTable&) -> ValueType can[Abort.Panic]:
            unmodeled_type() return if value_type.kind != TypeKind.Ref
            return copied_type(structs.ref_targets[value_type.bits.usize()])

include "./codegen_abi_error_sets.elisa"
include "./codegen_abi_regions.elisa"
include "./codegen_region_forwarding.elisa"
include "./codegen_abi_packed_ast.elisa"
include "./codegen_type_sizes.elisa"
include "./codegen_enum_shorthand.elisa"
