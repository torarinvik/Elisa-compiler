                        _:
                            pass
                    match statement:
                        Stmt.Block(kind, clause, binding, body, line):
                            true return if statements_mention_ast_store_call(body, structs)
                        _:
                            pass
                    match statement:
                        Stmt.Match(scrutinee, arms, line):
                            true return if expression_mentions_ast_store_call(scrutinee, structs)
                            for arm in arms:
                                true return if expression_mentions_ast_store_call(arm.guard, structs) or statements_mention_ast_store_call(arm.body, structs)
                        _:
                            pass
