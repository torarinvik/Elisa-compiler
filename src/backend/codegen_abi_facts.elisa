                        region_scan_forwarding_statements(region_forward_stmt_while_body, params, structs, fact_row, changed)
                    elif region_forward_statement is Stmt.For(region_forward_for_bind, region_forward_for_variables, region_forward_for_iterable, region_forward_for_body, region_forward_for_line):
                        region_scan_forwarding_expression(region_forward_for_iterable, params, structs, fact_row, changed)
