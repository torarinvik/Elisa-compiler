                    region_scan_forwarding_expression(region_forward_paren_inner, params, structs, fact_row, changed)
                    return
                if expression is Expr.Array(region_forward_array_elements, region_forward_array_line) or expression is Expr.Tuple(region_forward_array_elements, region_forward_tuple_line) or expression is Expr.SetLit(region_forward_array_elements, region_forward_set_line):
                    for region_forward_element in region_forward_array_elements |params, structs, fact_row, changed|:
