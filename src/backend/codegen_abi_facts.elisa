                    region_scan_forwarding_expression(region_forward_slice_object, params, structs, fact_row, changed)
                    region_scan_forwarding_expression(region_forward_slice_low, params, structs, fact_row, changed)
                    region_scan_forwarding_expression(region_forward_slice_high, params, structs, fact_row, changed)
                    return
                if expression is Expr.IndexN(region_forward_indexn_object, region_forward_indexn_arguments, region_forward_indexn_line):
                    region_scan_forwarding_expression(region_forward_indexn_object, params, structs, fact_row, changed)
                    for region_forward_indexn_argument in region_forward_indexn_arguments |params, structs, fact_row, changed|:
                        region_scan_forwarding_expression(region_forward_indexn_argument, params, structs, fact_row, changed)
                    return
