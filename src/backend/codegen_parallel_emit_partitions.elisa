extend Backend:
    private:
        # A defined global with exactly one owner: mutable or visible globals, plus
        # local constants whose addresses may be significant. Duplicating such a
        # constant across objects can make pointer equality depend on partitioning.
        def part_global_owned(g: LLVMValueRef) -> bool:
            return false if LLVMIsDeclaration(g) != 0
            linkage: u32 = LLVMGetLinkage(g)
            part_linkage_is_partitioned(linkage)

        # A local symbol becomes a hidden external for references between shards. Its
        # ordinal is deterministic within this module and identical in every shard. After
        # the per-unit merge, localize this reserved prefix so independently compiled units
        # (including duplicate instances of the same source) cannot collide.
        def part_externalize(value: LLVMValueRef, ordinal: i64) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            linkage: u32 = LLVMGetLinkage(value)
            return if not part_linkage_is_local(linkage)
            renamed: mutable darray[u8] = []
            emit_tokens_push_sview_backend(renamed, "elisa.part.")
            part_push_decimal(renamed, ordinal)
            renamed_length: usize = renamed.count
            renamed.push(0)
            LLVMSetValueName2(value, (&renamed[0]).cast[cstr], renamed_length)
            LLVMSetLinkage(value, PART_LINKAGE_EXTERNAL)
            LLVMSetVisibility(value, PART_VISIBILITY_HIDDEN)

        def part_push_decimal(buffer: mutable darray[u8]&, value: i64) -> void can[Abort.Panic, Memory.Allocate]:
            digits: mutable darray[u8] = []
            remaining: mutable i64 = value
            digits.push(48) if remaining == 0
            while remaining > 0 |remaining, digits|:
                digits.push((48 + remaining % 10).u8())
                remaining <- remaining / 10
            index: mutable usize = digits.count
            while index > 0 |index, buffer, digits|:
                index <- index - 1
                buffer.push(digits[index])

        def emit_tokens_push_sview_backend(buffer: mutable darray[u8]&, text: sview) -> void can[Abort.Panic, Memory.Allocate]:
            for text_index in 0..<text.len |buffer, text|:
                buffer.push(text[text_index])

        # Instruction weight (+1) of every function the pass distributes, in module order;
        # -1 for one it leaves alone.
        def part_function_weights(m: LLVMModuleRef) -> darray[i64] can[Abort.Panic, Memory.Allocate]:
            weights: mutable darray[i64] = []
            function_opt: mutable LLVMValueRef? = LLVMGetFirstFunction(m)
            while function_opt is function |weights, function_opt|:
                weight: i64 = part_function_weight(function) + 1 if part_function_owned(function) else -1
                weights.push(weight)
                function_opt <- LLVMGetNextFunction(function)
            weights

        def part_total_weight(weights: darray[i64]&) -> i64 can[Abort.Panic]:
            total: mutable i64 = 0
            for weight in weights |total|:
                total <- total + weight if weight > 0
            total

        # Workers worth forking for TOTAL instructions: each costs a fork, a code generator
        # set-up and a part file for `ld -r` (~1 ms), which dominated small units (a 30-line
        # file spent 26 ms of 50 in 32-way emission, 3 ms serially).
        def part_effective_jobs(total: i64, jobs: i64) -> i64:
            useful: i64 = total / PART_MIN_WEIGHT_PER_JOB
            return 1 if useful < 1
            useful if useful < jobs else jobs

        # Turn a definition into a declaration. strip_function_body erases every
        # instruction of every block before deleting any block: deleting block k while a
        # later block's branch still names it corrupted the heap in every forked child.
        def part_strip_body(f: LLVMValueRef) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            strip_function_body(f)
            elisa_part_clear_personality(f, null) if LLVMHasPersonalityFn(f) != 0

        # Owner of every function, in module order (-1: not partitioned).
        def part_function_owners(weights: darray[i64]&, total: i64, jobs: i64) -> darray[i64] can[Abort.Panic, Memory.Allocate]:
            owners: mutable darray[i64] = []
            prefix: mutable i64 = 0
            for weight in weights |owners, prefix, total, jobs|:
                if weight < 0:
                    owners.push(-1)
                else:
                    owner: mutable i64 = (prefix * jobs) / total if total > 0 else 0
                    owner <- jobs - 1 if owner >= jobs
                    owners.push(owner)
                    prefix <- prefix + weight
            owners

        # Rewrite the module into partition `part` of `jobs` (runs in the forked child).
        def part_restrict_module(m: LLVMModuleRef, owners: darray[i64]&, part: i64, strip: bool) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            ordinal: mutable i64 = 0
            global_opt: mutable LLVMValueRef? = LLVMGetFirstGlobal(m)
            while global_opt is global_value |ordinal, global_opt, part|:
                if part_global_owned(global_value):
                    part_externalize(global_value, ordinal)
                    if part != 0:
                        elisa_part_clear_initializer(global_value, null)
                        LLVMSetLinkage(global_value, PART_LINKAGE_EXTERNAL)
                ordinal <- ordinal + 1
                global_opt <- LLVMGetNextGlobal(global_value)
            function_index: mutable usize = 0
            function_opt: mutable LLVMValueRef? = LLVMGetFirstFunction(m)
            while function_opt is function |ordinal, function_index, function_opt, owners, part|:
                owner: i64 = owners[function_index]
                if owner >= 0:
                    part_externalize(function, ordinal)
                    # Unoptimised: another partition's function stays a body the code
                    # generator skips (MachineFunctionPass never runs on available_externally
                    # functions); erasing it instead touched every page of the module in every
                    # child (copy-on-write) and was most of each worker's time. An optimising
                    # target machine still runs its IR-level passes (CodeGenPrepare, LSR, ...)
                    # over every body, so there the body is erased.
                    if owner != part:
                        if strip:
                            part_strip_body(function)
                        else:
                            LLVMSetLinkage(function, PART_LINKAGE_AVAILABLE_EXTERNALLY)
                ordinal <- ordinal + 1
                function_index <- function_index + 1
                function_opt <- LLVMGetNextFunction(function)
            alias_opt: mutable LLVMValueRef? = LLVMGetFirstGlobalAlias(m)
            while alias_opt is alias |alias_opt|:
                aliasee: LLVMValueRef = LLVMAliasGetAliasee(alias)
                if LLVMIsDeclaration(aliasee) != 0 or LLVMGetLinkage(aliasee) == PART_LINKAGE_AVAILABLE_EXTERNALLY:
                    LLVMReplaceAllUsesWith(alias, aliasee)
                    LLVMSetLinkage(alias, PART_LINKAGE_PRIVATE)
                alias_opt <- LLVMGetNextGlobalAlias(alias)

        # Runs in a forked child and never returns: serve parts [first, stop). While more than
        # one part is left, fork a child for the upper half and keep the lower; then emit
        # the one remaining part and wait for every child this process forked. The exit
        # status is 0 only when this part and every part below it in the tree were written.
        def part_fork_range(machine: void&, m: LLVMModuleRef, path: cstr, owners: darray[i64]&, first: i64, stop: i64, strip: bool) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            low: mutable i64 = first
            high: mutable i64 = stop
            kids: mutable darray[i32] = []
            while high - low > 1 |low, high, kids|:
                middle: i64 = low + (high - low) / 2
                kid: i32 = fork()
                if kid == 0:
                    kids.truncate(0)
                    low <- middle
                else:
                    kids.push(kid)
                    high <- middle
            part_restrict_module(m, owners, low, strip)
            child_path: darray[u8] = part_path(path, low)
            ok: mutable bool = emit_object(machine, m, (&child_path[0]).cast[cstr])
            for kid in kids |ok|:
                if kid < 0:
                    ok <- false
                else:
                    status: mutable i32 = 0
                    waited: i32 = waitpid(kid, &status, 0)
                    ok <- false if waited != kid or status != 0
            _exit(0 if ok else 1)

        def part_path(out_path: cstr, part: i64) -> darray[u8] can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            path: mutable darray[u8] = []
            part_push_cstr(path, out_path)
            emit_tokens_push_sview_backend(path, ".part")
            part_push_decimal(path, part)
            emit_tokens_push_sview_backend(path, ".o")
            path.push(0)
            path

        # Append the bytes of a NUL-terminated string (without the terminator).
        def part_push_cstr(buffer: mutable darray[u8]&, text: cstr) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            bytes: u8& = text.cast[u8&]
            index: mutable usize = 0
            while true |index, bytes, buffer|:
                byte_ref: u8& = bytes + index
                byte_value: u8 = byte_ref
                break if byte_value == 0
                buffer.push(byte_value)
                index <- index + 1

        def part_shell_quote(buffer: mutable darray[u8]&, path: darray[u8]&) -> void can[Abort.Panic, Memory.Allocate]:
            buffer.push(39)
            for path_byte in path |buffer|:
                continue if path_byte == 0
                if path_byte == 39:
                    emit_tokens_push_sview_backend(buffer, "'\\''")
                else:
                    buffer.push(path_byte)
            buffer.push(39)

        def part_llvm_tool(name: cstr, override_name: cstr, buffer: mutable darray[u8]&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            if getenv(override_name) is explicit:
                part_push_cstr(buffer, explicit.cast[cstr] can Unsafe.PointerCast)
                return if buffer.count > 0
            if getenv("ELISA_LLVM_BIN_DIR") is llvm_bin:
                part_push_cstr(buffer, llvm_bin.cast[cstr] can Unsafe.PointerCast)
                if buffer.count > 0:
                    buffer.push(47) if buffer[buffer.count - 1] != 47
                    part_push_cstr(buffer, name)
                    return
            part_push_cstr(buffer, name)

        def part_write_temp_symbols(contents: darray[u8]&, path: mutable darray[u8]&) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            directory: mutable darray[u8] = []
            if getenv("TMPDIR") is tmpdir:
                part_push_cstr(directory, tmpdir.cast[cstr] can Unsafe.PointerCast)
            if directory.count == 0:
                emit_tokens_push_sview_backend(directory, "/tmp")
            directory.pop() if directory.count > 0 and directory[directory.count - 1] == 47
            for byte in directory |path|:
                path.push(byte)
            emit_tokens_push_sview_backend(path, "/elisa-part-expected.XXXXXX")
            path.push(0)
            fd: i32 = part_mkstemp((&path[0]).cast[cstr] can Unsafe.PointerCast)
            return false if fd < 0
            offset: mutable usize = 0
            while offset < contents.count |offset, contents|:
                data: u8& = (&contents[offset]).cast[u8&] can Unsafe.PointerCast
                typed_fd: FileDescriptor = fd.FileDescriptor()
                raw_data: void& = data.cast[void&] can Unsafe.PointerCast
                written: isize = part_write(typed_fd, raw_data, contents.count - offset) can Console.Write
                if written <= 0:
                    _ = part_close(fd)
                    _ = unlink_backend((&path[0]).cast[cstr] can Unsafe.PointerCast)
                    return false
                offset <- offset + written.usize()
            if part_close(fd) != 0:
                _ = unlink_backend((&path[0]).cast[cstr] can Unsafe.PointerCast)
                return false
            return true

    public:
        # Localize the generated bridge definitions after all shards for one translation
        # unit have been merged. `bridge_symbol_names` comes from the original module/prepared
        # set; exact-name validation makes missing tools or an incomplete scan fail closed.
        # The path is NUL-terminated. The caller must do this before linking the unit with
        # another translation unit or publishing its merged object to the shard cache.
        def localize_part_bridges(object_path: darray[u8]&, bridge_symbol_names: darray[u8]&) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Global.Write, Blocking.IO]:
            return true if bridge_symbol_names.count == 0
            return false if object_path.count == 0 or object_path[object_path.count - 1] != 0
            expected_path: mutable darray[u8] = []
            if not part_write_temp_symbols(bridge_symbol_names, expected_path):
                _ = unlink_backend((&object_path[0]).cast[cstr] can Unsafe.PointerCast)
                return false
            defer block:
                _ = unlink_backend((&expected_path[0]).cast[cstr] can Unsafe.PointerCast)
            nm_tool: mutable darray[u8] = []
            objcopy_tool: mutable darray[u8] = []
            part_llvm_tool("llvm-nm", "ELISA_LLVM_NM", nm_tool)
            part_llvm_tool("llvm-objcopy", "ELISA_LLVM_OBJCOPY", objcopy_tool)
            command: mutable darray[u8] = []
            emit_tokens_push_sview_backend(command, "raw=$(mktemp \"${TMPDIR:-/tmp}/elisa-part-raw.XXXXXX\" 2>/dev/null) || exit 1; symbols=$(mktemp \"${TMPDIR:-/tmp}/elisa-part-symbols.XXXXXX\" 2>/dev/null) || { rm -f \"$raw\"; exit 1; }; verify=$(mktemp \"${TMPDIR:-/tmp}/elisa-part-verify.XXXXXX\" 2>/dev/null) || { rm -f \"$raw\" \"$symbols\"; exit 1; }; trap 'rm -f \"$raw\" \"$symbols\" \"$verify\"' 0; ")
            part_shell_quote(command, nm_tool)
            emit_tokens_push_sview_backend(command, " --defined-only -g --format=posix ")
            part_shell_quote(command, object_path)
            emit_tokens_push_sview_backend(command, " > \"$raw\" 2>/dev/null || exit 1; awk 'FNR==NR { expected[$0]=1; next } { name=$1; normalized=name; if (substr(normalized,1,1)==\"_\") normalized=substr(normalized,2); if (index(normalized,\"elisa.part.\")==1) { if (!(normalized in expected) || found[normalized]++) bad=1; print name } } END { for (name in expected) if (!(name in found)) bad=1; if (bad) exit 1 }' ")
            part_shell_quote(command, expected_path)
            emit_tokens_push_sview_backend(command, " \"$raw\" > \"$symbols\" || exit 1; test -s \"$symbols\" || exit 1; ")
            part_shell_quote(command, objcopy_tool)
            emit_tokens_push_sview_backend(command, " --localize-symbols=")
            emit_tokens_push_sview_backend(command, "\"$symbols\" ")
            part_shell_quote(command, object_path)
            emit_tokens_push_sview_backend(command, " >/dev/null 2>&1 || exit 1; ")
            part_shell_quote(command, nm_tool)
            emit_tokens_push_sview_backend(command, " --defined-only -g --format=posix ")
            part_shell_quote(command, object_path)
            emit_tokens_push_sview_backend(command, " > \"$verify\" 2>/dev/null || exit 1; awk '{ name=$1; if (substr(name,1,1)==\"_\") name=substr(name,2); if (index(name,\"elisa.part.\")==1) found=1 } END { exit(found ? 1 : 0) }' \"$verify\" || exit 1 >/dev/null 2>&1")
            command.push(0)
            line_map: mutable darray[u8] = []
            line_map_hidden: bool = Lexer::line_map_suspend(&line_map) can Global{Read,Write}
            localization_ok: bool = system_backend((&command[0]).cast[cstr] can Unsafe.PointerCast) == 0
            Lexer::line_map_resume(&line_map, line_map_hidden) can Global.Write
            if localization_ok:
                return true
            _ = unlink_backend((&object_path[0]).cast[cstr] can Unsafe.PointerCast)
            return false

        # Cache callers merge restored hits and emitted misses before publication. Require
        # the prepared set so the same verified bridge inventory used to write snapshots
        # also gates post-merge localization of the combined object.
        def localize_part_cache_output(object_path: darray[u8]&, prepared: PartCachePreparedSet&) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Global.Write, Blocking.IO]:
            return false if prepared.status != PART_CACHE_PREP_READY
            can Global{Read,Write}:
                return localize_part_bridges(object_path, prepared.bridge_symbol_names)

    public:
        # ELISA_STAGE1_JOBS, clamped to 1..64; 1 when unset or malformed.
        def parallel_emit_jobs() -> i64 can[Abort.Panic, Unsafe.PointerCast]:
            if getenv("ELISA_STAGE1_JOBS") is jobs_text:
                jobs_bytes: u8& = jobs_text.cast[u8&]
                jobs: mutable i64 = 0
                index: mutable usize = 0
                while true |jobs, index, jobs_bytes|:
                    byte_ref: u8& = jobs_bytes + index
                    digit: u8 = byte_ref
                    break if digit < 48 or digit > 57
                    jobs <- jobs * 10 + (digit - 48).i64()
                    break if jobs > 64
                    index <- index + 1
                return 64 if jobs > 64
                return 1 if jobs < 1
                return jobs
            1

        # Emit `m` to `path` with `jobs` forked code generators; serial when jobs <= 1.
        # The module is unchanged in the parent.
        # OPTIMIZED: `machine` was configured above -O0 (see part_restrict_module).
        def emit_object_parallel(machine: void&, m: LLVMModuleRef, path: cstr, requested_jobs: i64, optimized: bool) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Global.Write, Blocking.IO]:
            can Global{Read,Write}:
                status: i64 = emit_object_parallel_status(machine, m, path, requested_jobs, false, optimized)
                return status == 0

        # emit_object_parallel for a module NOT yet verified: the LLVM verifier runs first,
        # before any worker forks (overlapping it with the workers let rejected IR reach
        # instruction selection). 0 = written, 2 = the verifier rejected the module
        # (its diagnostic is printed; no object is written), 4 = emission failed. For an
        # unoptimised machine only. A serial
        # emission verifies first, exactly as before.
        def emit_object_parallel_verifying(machine: void&, m: LLVMModuleRef, path: cstr, requested_jobs: i64) -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Global.Write, Blocking.IO]:
            can Global{Read,Write}:
                return emit_object_parallel_status(machine, m, path, requested_jobs, true, false)

        def emit_object_parallel_status(machine: void&, m: LLVMModuleRef, path: cstr, requested_jobs: i64, verify: bool, optimized: bool) -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Global.Write, Blocking.IO]:
            jobs: mutable i64 = requested_jobs
            weights: mutable darray[i64] = []
            total: mutable i64 = 0
            bridge_symbol_names: mutable darray[u8] = []
            if requested_jobs > 1:
                if part_module_has_reserved_symbol_prefix(m):
                    jobs <- 1
                else:
                    weights <- part_function_weights(m)
                    total <- part_total_weight(weights)
                    jobs <- part_effective_jobs(total, requested_jobs)
                    if jobs > 1:
                        bridge_symbol_names <- part_module_bridge_symbol_names(m)
                        if bridge_symbol_names.count > 0 and part_module_has_inline_asm(m):
                            jobs <- 1
                            bridge_symbol_names.clear()
            # Verify before any worker forks: instruction selection over IR the verifier rejects
            # can crash or hang LLVM, and a hung worker would block the waitpid below.
            return 2 if verify and LLVMVerifyModule(m, PART_VERIFY_PRINT_MESSAGE, null) != 0
            if jobs <= 1:
                return 0 if emit_object(machine, m, path)
                return 4
            owners: darray[i64] = part_function_owners(weights, total, jobs)
            # The workers are forked as a tree (part_fork_range): a fork of the whole compiler
            # copies its page tables (~65 ms for the self-host unit), so 32 forks in a row
            # from the parent put ~2 s before the last worker started.
            children: mutable darray[i32] = []
            root_child: i32 = fork()
            # The worker tree gets its own process group, so a failure can stop every worker,
            # orphans of a dead mid-tree worker included, before the part files are unlinked.
            if root_child == 0:
                _ = setpgid(0, 0)
                part_fork_range(machine, m, path, owners, 0, jobs, optimized)
            if root_child > 0:
                _ = setpgid(root_child, root_child)
            children.push(root_child)
            all_ok: mutable bool = true
            for child in children |all_ok|:
                if child < 0:
                    all_ok <- false
                else:
                    status: mutable i32 = 0
                    waited: i32 = waitpid(child, &status, 0)
                    all_ok <- false if waited != child or status != 0
            if not all_ok and root_child > 0:
                _ = kill_backend(0 - root_child, PART_SIGKILL)
            command: mutable darray[u8] = []
            if getenv("ELISA_LD") is linker_text:
                part_push_cstr(command, linker_text.cast[cstr])
            else:
                emit_tokens_push_sview_backend(command, "ld")
            emit_tokens_push_sview_backend(command, " -r -o ")
            out_storage: mutable darray[u8] = []
            part_push_cstr(out_storage, path)
            out_storage.push(0)
            part_shell_quote(command, out_storage)
            for part in 0..<jobs.usize() |command, path|:
                command.push(32)
                part_file: darray[u8] = part_path(path, part.i64())
                part_shell_quote(command, part_file)
            command.push(0)
            if all_ok:
                # The include line map can outgrow one exec string, and `system` then fails
                # with E2BIG before the shell starts; `ld -r` never reads it.
                line_map: mutable darray[u8] = []
                line_map_hidden: bool = Lexer::line_map_suspend(&line_map) can Global{Read,Write}
                all_ok <- system_backend((&command[0]).cast[cstr]) == 0
                Lexer::line_map_resume(&line_map, line_map_hidden) can Global.Write
            for part in 0..<jobs.usize() |path|:
                part_file: darray[u8] = part_path(path, part.i64())
                _ = unlink_backend((&part_file[0]).cast[cstr])
            if not all_ok:
                _ = unlink_backend(path)
                return 4
            localized: mutable bool = false
            can Global{Read,Write}:
                localized <- localize_part_bridges(out_storage, bridge_symbol_names)
            if not localized:
                # The helper removes a failed or partially localized merged object.
                # Re-emit the original module serially so a missing tool or mismatch
                # cannot expose external bridge symbols to another translation unit.
                if emit_object(machine, m, path):
                    return 0
                _ = unlink_backend(path)
                return 4
            return 0

@link_name("system")
extern system_backend(command: cstr) -> i32
@link_name("unlink")
extern unlink_backend(path: cstr) -> i32
@link_name("mkstemp")
extern part_mkstemp(template: cstr) -> i32
@link_name("write")
extern part_write(fd: FileDescriptor, data: void&, count: usize) -> isize can[Console.Write]
@link_name("close")
extern part_close(fd: i32) -> i32
