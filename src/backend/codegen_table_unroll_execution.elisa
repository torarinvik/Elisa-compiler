extend Backend:
    private:
        def tu_trial_accepts(module: LLVMModuleRef, function: LLVMValueRef, function_index: usize, block_index: usize, ctx: LLVMContextRef, machine: void&?, pass_fn: void&, growth: usize, growth_total: usize) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Unsafe.PointerArithmetic]:
            clone: LLVMModuleRef = LLVMCloneModule(module)
            defer block:
                LLVMDisposeModule(clone)
            original_count: usize = tu_count_function(function)
            if tu_find_function(clone, function_index) is trial:
                if tu_find_block(trial, block_index) is trial_block:
                    if LLVMGetBasicBlockTerminator(trial_block) is trial_branch:
                        tu_tag(trial_branch, ctx) can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]
                        trial_ok: bool = tu_run_function(pass_fn, trial, machine, "simplifycfg,loop-unroll,instcombine<no-verify-fixpoint>,simplifycfg") can[Unsafe.PointerCast, Unsafe.PointerArithmetic]
                        trial_count: usize = tu_count_function(trial)
                        if LLVMGetFirstBasicBlock(trial) is surviving_block:
                            trial_graph_work: mutable usize = 200000
                            return trial_ok and (tu_acyclic(trial, surviving_block, surviving_block, false, trial_graph_work) can[Abort.Panic, Memory.Allocate]) and trial_count <= original_count + growth and trial_count <= original_count + 8192 - growth_total
            false

        def tu_execute(module: LLVMModuleRef, ctx: LLVMContextRef, machine: void&?, debug_fn: void&, pass_fn: void&, trial_attempts: mutable usize&, eligibility_checks: mutable usize&, graph_work: mutable usize&) -> i32 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Unsafe.PointerArithmetic, Global.Read]:
            # Cloning a very large module for an optional profitability trial is
            # counterproductive. Bound the entire scan and decline large modules.
            name_budget: mutable usize = 262144
            type_budget: mutable usize = 65536
            inline_asm_kind: u32 = tu_inline_asm_value_kind()
            return 0 if inline_asm_kind == 0
            metadata_value_kind: u32 = inline_asm_kind - 1.u32()
            can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
                can Global.Read:
                    return 0 if not (tu_module_budget(module, &type_budget, &name_budget) can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Global.Read])
            scan_function: mutable LLVMValueRef? = LLVMGetFirstFunction(module)
            scan_count: mutable usize = 0
            function_count: mutable usize = 0
            attribute_budget: mutable usize = 8192
            constant_budget: mutable usize = 65536
            edge_budget: mutable usize = 65536
            while scan_function is scanned |scan_function, scan_count, function_count, name_budget, attribute_budget, constant_budget, type_budget, edge_budget, inline_asm_kind, metadata_value_kind, debug_fn|:
                function_count <- function_count + 1
                return 0 if function_count > 2048
                scan_count <- scan_count + tu_count_function(scanned)
                return 0 if scan_count > 8192
                can Global.Read:
                    return 0 if not (tu_function_budget(scanned, &name_budget, &attribute_budget, &constant_budget, &type_budget, &edge_budget, inline_asm_kind, metadata_value_kind, debug_fn) can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Global.Read])
                scan_function <- LLVMGetNextFunction(scanned)
            budget: mutable ZFBudget = ZFBudget{work: 1048576, debug_fn: debug_fn, debug_kind: LLVMGetMDKindIDInContext(ctx, "dbg", 3)}
            function_opt: mutable LLVMValueRef? = LLVMGetFirstFunction(module)
            function_index: mutable usize = 0
            candidates: mutable usize = 0
            growth_total: mutable usize = 0
            while function_opt is function |function_opt, function_index, budget, candidates, growth_total, pass_fn, machine, ctx, module, trial_attempts, eligibility_checks, graph_work|:
                next: LLVMValueRef? = LLVMGetNextFunction(function)
                if (tu_function_eligible(function, budget) can[Unsafe.PointerCast, Unsafe.PointerArithmetic]):
                    block_opt: mutable LLVMBasicBlockRef? = LLVMGetFirstBasicBlock(function)
                    block_index: mutable usize = 0
                    while block_opt is block |block_opt, block_index, function_index, candidates, growth_total, pass_fn, machine, ctx, module, function, trial_attempts, eligibility_checks, graph_work|:
                        if LLVMGetBasicBlockTerminator(block) is branch:
                            if LLVMGetInstructionOpcode(branch) == 71 and LLVMGetNumSuccessors(branch) == 2:
                                return 1 if eligibility_checks >= 64 and candidates > 0
                                return 0 if eligibility_checks >= 64
                                eligibility_checks <- eligibility_checks + 1
                                header: LLVMBasicBlockRef = LLVMGetSuccessor(branch, 1)
                                growth: usize = tu_loop_growth(header, block, branch) can Unsafe.PointerArithmetic
                                if growth > 0 and trial_attempts < 4 and growth_total + growth <= 8192 and (tu_acyclic(function, block, header, true, graph_work) can[Abort.Panic, Memory.Allocate]):
                                    # Trial on a clone first: only commit a transformation whose
                                    # actual growth fits the budget, leaving misses untouched.
                                    trial_attempts <- trial_attempts + 1
                                    original_count: usize = tu_count_function(function)
                                    accepted: bool = tu_trial_accepts(module, function, function_index, block_index, ctx, machine, pass_fn, growth, growth_total) can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Unsafe.PointerArithmetic]
                                    if accepted:
                                        tu_tag(branch, ctx) can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]
                                        return 2 if not (tu_run_function(pass_fn, function, machine, "simplifycfg,loop-unroll,instcombine<no-verify-fixpoint>,simplifycfg") can[Unsafe.PointerCast, Unsafe.PointerArithmetic])
                                        final_count: usize = tu_count_function(function)
                                        return 2 if final_count > original_count + growth or final_count > original_count + 8192 - growth_total
                                        if LLVMGetFirstBasicBlock(function) is final_block:
                                            actual_graph_work: mutable usize = 200000
                                            return 2 if not (tu_acyclic(function, final_block, final_block, false, actual_graph_work) can[Abort.Panic, Memory.Allocate])
                                        else:
                                            return 2
                                        candidates <- candidates + 1
                                        growth_total <- growth_total + growth
                                        # The function pass mutates CFG; do not continue iterating
                                        # stale blocks and conservatively process at most one loop.
                                        break
                        block_index <- block_index + 1
                        block_opt <- LLVMGetNextBasicBlock(block)
                function_index <- function_index + 1
                function_opt <- next
            1 if candidates > 0 else 0

        def tu_block_index(blocks: darray[LLVMBasicBlockRef]&, target: LLVMBasicBlockRef, work: mutable usize&) -> usize?:
            for index in 0..<blocks.count |blocks, target, work|:
                return null if work == 0
                work <- work - 1
                return index if blocks[index] == target
            null

        # Kahn's algorithm rejects all cycles, including unreachable ones. Before
        # trial, ignore precisely the selected latch->header edge: a pass means
        # it was the function's only cycle. After trial, no edge is ignored.
        def tu_acyclic(function: LLVMValueRef, latch: LLVMBasicBlockRef, header: LLVMBasicBlockRef, ignore_edge: bool, work: mutable usize&) -> bool can[Abort.Panic, Memory.Allocate]:
            blocks: mutable darray[LLVMBasicBlockRef] = []
            degrees: mutable darray[usize] = []
            removed: mutable darray[bool] = []
            block_opt: mutable LLVMBasicBlockRef? = LLVMGetFirstBasicBlock(function)
            while block_opt is block |block_opt, blocks, degrees, removed, work|:
                return false if work == 0 or blocks.count >= 256
                work <- work - 1
                blocks.push(block)
                degrees.push(0)
                removed.push(false)
                block_opt <- LLVMGetNextBasicBlock(block)
            for index in 0..<blocks.count |blocks, degrees, latch, header, ignore_edge, work|:
                return false if work == 0
                work <- work - 1
                source: LLVMBasicBlockRef = blocks[index]
                if LLVMGetBasicBlockTerminator(source) is term:
                    successors: u32 = LLVMGetNumSuccessors(term)
                    return false if successors > 2
                    for successor_index in 0..<successors |blocks, degrees, latch, header, ignore_edge, source, term, work|:
                        return false if work == 0
                        work <- work - 1
                        destination: LLVMBasicBlockRef = LLVMGetSuccessor(term, successor_index)
                        if ignore_edge and source == latch and destination == header:
                            continue
                        if tu_block_index(blocks, destination, work) is target_index:
                            degrees[target_index] <- degrees[target_index] + 1
                        else:
                            return false
                else:
                    return false
            remaining: mutable usize = blocks.count
            for round in 0..<blocks.count |blocks, degrees, removed, remaining, latch, header, ignore_edge, work|:
                return false if work == 0
                work <- work - 1
                progress: mutable bool = false
                for index in 0..<blocks.count |blocks, degrees, removed, remaining, progress, latch, header, ignore_edge, work|:
                    return false if work == 0
                    work <- work - 1
                    if not removed[index] and degrees[index] == 0:
                        removed[index] <- true
                        remaining <- remaining - 1
                        progress <- true
                        source: LLVMBasicBlockRef = blocks[index]
                        if LLVMGetBasicBlockTerminator(source) is term:
                            for successor_index in 0..<LLVMGetNumSuccessors(term) |blocks, degrees, latch, header, ignore_edge, source, term, work|:
                                return false if work == 0
                                work <- work - 1
                                destination: LLVMBasicBlockRef = LLVMGetSuccessor(term, successor_index)
                                if ignore_edge and source == latch and destination == header:
                                    continue
                                if tu_block_index(blocks, destination, work) is target_index:
                                    return false if degrees[target_index] == 0
                                    degrees[target_index] <- degrees[target_index] - 1
                                else:
                                    return false
                        else:
                            return false
                return true if remaining == 0
                return false if not progress
            remaining == 0

        static if ELISA_TARGET_OS_POSIX:
            def tu_platform(module: LLVMModuleRef, ctx: LLVMContextRef, machine: void&?, trial_attempts: mutable usize&, eligibility_checks: mutable usize&, graph_work: mutable usize&) -> i32 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Unsafe.PointerArithmetic, Global.Read]:
                return 0 if LLVMGetNamedFunction(module, "llvm.dbg.value") != null or LLVMGetNamedFunction(module, "llvm.dbg.declare") != null or LLVMGetNamedFunction(module, "llvm.dbg.assign") != null
                direct_anchor: void& = LLVMContextCreate.cast[void&] can Unsafe.PointerCast
                if artifact_identity_dlopen(null, 2) is handle:
                    defer block:
                        _ = artifact_identity_dlclose(handle)
                    if artifact_identity_dlsym(handle, "LLVMContextCreate") is llvm_base:
                        return 0 if not (split_same_llvm_image(direct_anchor, llvm_base) can Global.Read)
                        if artifact_identity_dlsym(handle, "LLVMGetVersion") is version_fn:
                            return 0 if not (split_same_llvm_image(llvm_base, version_fn) can Global.Read)
                            direct_version: void& = LLVMGetVersion.cast[void&] can Unsafe.PointerCast
                            return 0 if not (split_same_llvm_image(llvm_base, direct_version) can Global.Read)
                            major: mutable u32 = 0
                            minor: mutable u32 = 0
                            patch: mutable u32 = 0
                            LLVMGetVersion(&major, &minor, &patch)
                            return 0 if major != 23
                            if artifact_identity_dlsym(handle, "LLVMGetFirstDbgRecord") is debug_fn:
                                if artifact_identity_dlsym(handle, "LLVMRunPassesOnFunction") is pass_fn:
                                    return 0 if not (split_same_llvm_image(llvm_base, debug_fn) can Global.Read)
                                    return 0 if not (split_same_llvm_image(llvm_base, pass_fn) can Global.Read)
                                    can Global.Read:
                                        return tu_execute(module, ctx, machine, debug_fn, pass_fn, trial_attempts, eligibility_checks, graph_work) can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Unsafe.PointerArithmetic, Global.Read]
                0
        static else:
            def tu_platform(module: LLVMModuleRef, ctx: LLVMContextRef, machine: void&?, trial_attempts: mutable usize&, eligibility_checks: mutable usize&, graph_work: mutable usize&) -> i32:
                0

    public:
        def experimental_table_unroll(module: LLVMModuleRef, ctx: LLVMContextRef, machine: void&?) -> i32 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Unsafe.PointerArithmetic, Global.Read]:
            trial_attempts: mutable usize = 0
            eligibility_checks: mutable usize = 0
            graph_work: mutable usize = 200000
            can Global.Read:
                return tu_platform(module, ctx, machine, trial_attempts, eligibility_checks, graph_work) can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Unsafe.PointerArithmetic, Global.Read]
