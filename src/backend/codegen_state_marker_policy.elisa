# Closed mapping for compiler-only typestate marker identities.
module BackendStateMarkerPolicy:
    public:
        const BUILTIN_STATE_MARKER_UNKNOWN_TAG: u32 = 0
        const BUILTIN_STATE_MARKER_LOCAL_TAG: u32 = 1
        const BUILTIN_STATE_MARKER_FROZEN_TAG: u32 = 2
        const BUILTIN_STATE_MARKER_JOINABLE_TAG: u32 = 3
        const BUILTIN_STATE_MARKER_PENDING_TAG: u32 = 4
        const BUILTIN_STATE_MARKER_HELD_TAG: u32 = 5

        def tag_for_name(name: sview) -> u32:
            ensure result == (when name:
                "Local" -> BUILTIN_STATE_MARKER_LOCAL_TAG
                "Frozen" -> BUILTIN_STATE_MARKER_FROZEN_TAG
                "Joinable" -> BUILTIN_STATE_MARKER_JOINABLE_TAG
                "Pending" -> BUILTIN_STATE_MARKER_PENDING_TAG
                "Held" -> BUILTIN_STATE_MARKER_HELD_TAG
                _ -> BUILTIN_STATE_MARKER_UNKNOWN_TAG
            )
            return match name:
                "Local": BUILTIN_STATE_MARKER_LOCAL_TAG
                "Frozen": BUILTIN_STATE_MARKER_FROZEN_TAG
                "Joinable": BUILTIN_STATE_MARKER_JOINABLE_TAG
                "Pending": BUILTIN_STATE_MARKER_PENDING_TAG
                "Held": BUILTIN_STATE_MARKER_HELD_TAG
                _: BUILTIN_STATE_MARKER_UNKNOWN_TAG

        def name_for_tag(tag: u32) -> sview:
            ensure result == (match tag:
                BUILTIN_STATE_MARKER_LOCAL_TAG: "Local"
                BUILTIN_STATE_MARKER_FROZEN_TAG: "Frozen"
                BUILTIN_STATE_MARKER_JOINABLE_TAG: "Joinable"
                BUILTIN_STATE_MARKER_PENDING_TAG: "Pending"
                BUILTIN_STATE_MARKER_HELD_TAG: "Held"
                _: "unknown"
            )
            return match tag:
                BUILTIN_STATE_MARKER_LOCAL_TAG: "Local"
                BUILTIN_STATE_MARKER_FROZEN_TAG: "Frozen"
                BUILTIN_STATE_MARKER_JOINABLE_TAG: "Joinable"
                BUILTIN_STATE_MARKER_PENDING_TAG: "Pending"
                BUILTIN_STATE_MARKER_HELD_TAG: "Held"
                _: "unknown"
