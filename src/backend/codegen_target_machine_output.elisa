extend Backend:
    public:
        def run_optimization(machine: void&, m: LLVMModuleRef, pipeline: sview) -> bool can[Abort.Panic, Memory.Allocate]:
            pipeline_storage: mutable darray[u8] = []
            options: LLVMPassBuilderOptionsRef = LLVMCreatePassBuilderOptions()
            # Match stage0's pass-builder defaults. LLVM's C API otherwise leaves these
            # policy switches at library defaults, which can silently disable the
            # vectorizer/unroller even with the same `default<O*>` pipeline.
            LLVMPassBuilderOptionsSetLoopInterleaving(options, 1)
            LLVMPassBuilderOptionsSetLoopVectorization(options, 1)
            LLVMPassBuilderOptionsSetSLPVectorization(options, 1)
            LLVMPassBuilderOptionsSetLoopUnrolling(options, 1)
            # stage0 optimizationAAPipeline: LLVM's default AA stack plus scev-aa, which
            # proves `a[i]`/`a[j]` (j in i+1..<n) disjoint so pairwise loops keep a[i]'s
            # fields in registers (AWFY NBody -22% cycles).
            aa_storage: mutable darray[u8] = []
            LLVMPassBuilderOptionsSetAAPipeline(options, sview_to_cstr("scoped-noalias-aa,tbaa,basic-aa,globals-aa,scev-aa", aa_storage))
            # stage0 optimizationInlinerThresholdO3: -O3 inlines up to cost 400 (LLVM default 250).
            if pipeline == "default<O3>":
                LLVMPassBuilderOptionsSetInlinerThreshold(options, 400)
            # Install these process-global LLVM options before the first optimized module,
            # regardless of its level. The aggressive unroll threshold is consumed only by
            # O3, while the optional MachineLICM flag must not depend on whether an O1/O2 module
            # happened to run before the first O3 module in this process.
            can Global{Read,Write}:
                if not llvm_codegen_options_installed:
                    llvm_codegen_options_installed <- true
                    flag_storage: mutable darray[u8] = []
                    hoist_storage: mutable darray[u8] = []
                    name_storage: mutable darray[u8] = []
                    unroll_argv: mutable darray[cstr] = [sview_to_cstr("elisac", name_storage), sview_to_cstr("-unroll-threshold-aggressive=600", flag_storage)]
                    argv_count: mutable i32 = 2
                    if getenv("ELISA_LLVM_HOIST_CHEAP_INSTS") is hoist_flag and hoist_flag.cast[cstr] == "1":
                        unroll_argv.push(sview_to_cstr("--hoist-cheap-insts", hoist_storage))
                        argv_count <- 3
                    unroll_argv_pointer: void& = (&unroll_argv[0]).cast[void&] can Unsafe.PointerCast
                    LLVMParseCommandLineOptions(argv_count, unroll_argv_pointer, null)
            pass_error: void&? = LLVMRunPasses(m, sview_to_cstr(pipeline, pipeline_storage), machine, options)
            LLVMDisposePassBuilderOptions(options)
            if pass_error is real_error:
                return false
            elisacorePeelSmallValidationLoops(m) if pipeline == "default<O3>"
            return true




        # Artifact writers matching stage0's backend entry points. The module must already
        # have been configured and emitted; these functions deliberately report the C API's
        # status instead of hiding a failed write behind a partially-created artifact.
        def write_bitcode(m: LLVMModuleRef, path: sview) -> bool can[Abort.Panic, Memory.Allocate]:
            path_storage: mutable darray[u8] = []
            return LLVMWriteBitcodeToFile(m, sview_to_cstr(path, path_storage)) == 0




        def emit_object(machine: void&, m: LLVMModuleRef, path: cstr) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            # Take a NUL-terminated path (cstr), not sview: stage1 meta-compile does not
            # lower the runtime `sview(cstr?,…)` constructor reliably, and the product
            # driver already holds a terminated path buffer for gen2.
            # LLVM reports a char** allocated with LLVM's allocator. Keep the out-cell
            # ABI-shaped like the other LLVM C bindings and release the message even
            # when object emission fails; snapshot-cache misses can emit many shards.
            error_storage: mutable void&? = null
            error_slot: mutable u8&& = (&error_storage).cast[mutable u8&&] can Unsafe.PointerCast
            error_pointer: void& = (&error_storage).cast[void&] can Unsafe.PointerCast
            emit_status: i32 = LLVMTargetMachineEmitToFile(machine, m, path, 1, error_pointer)
            if error_storage is error_raw:
                error_message: cstr = error_slot[0].cast[cstr] can Unsafe.PointerCast
                LLVMDisposeMessage(error_message)
            return emit_status == 0

include "./codegen_aggregate_copies.elisa"
include "./codegen_parallel_emit.elisa"
