# Stage1 backend — export wrappers and generic instantiation bodies.
# Part of `module Backend` (see codegen.elisa); split out to keep each file short.

extend Backend:
    private:
        # Match a source spelling against the FnTable's `(owner, name)` pair without allocating
        # a joined name. An unqualified target keeps the original convenience behavior and is
        # accepted only when it names one function; `Module::name` selects that module-owned
        # function exactly (including qualified module names such as `Outer::Inner::name`).
        def pymodule_target_path_matches(target_path: sview, owner: sview, name: sview) -> bool can[Abort.Panic]:
            if owner == "":
                false return if sview_len(target_path) != sview_len(name)
                for index in 0..<sview_len(name) |target_path, name|:
                    false return if sview_at(target_path, index) != sview_at(name, index)
                return true
            false return if sview_len(target_path) != sview_len(owner) + 2.usize() + sview_len(name)
            for index in 0..<sview_len(owner) |target_path, owner|:
                false return if sview_at(target_path, index) != sview_at(owner, index)
            false return if sview_at(target_path, sview_len(owner)) != 58
            false return if sview_at(target_path, sview_len(owner) + 1.usize()) != 58
            for index in 0..<sview_len(name) |target_path, name, owner|:
                false return if sview_at(target_path, sview_len(owner) + 2.usize() + index) != sview_at(name, index)
            return true


        def pymodule_target_index(fns: FnTable&, target_path: sview) -> i64 can[Abort.Panic]:
            found: mutable i64 = -1
            matches: mutable i64 = 0
            for index in 0..<fns.names.count |found, matches, fns, target_path|:
                if pymodule_target_path_matches(target_path, fns.owners[index], fns.names[index]):
                    found <- index.i64()
                    matches <- matches + 1
            return found if matches == 1 else -1


        # Constants are registered by their leaf name for ordinary expression lookup. For a
        # qualified pymodule target, match the suffix `::CONST` against that same registry. The
        # declaration/manifest resolver still verifies the module owner, while this backend
        # lookup remains compatible with the existing global table layout. If two module-owned
        # constants share a leaf name, refuse the qualified row rather than silently returning
        # the first registry entry; the module-aware constant table can then be added without
        # changing the source syntax.
        def pymodule_const_path_matches(target_path: sview, leaf: sview) -> bool can[Abort.Panic]:
            return false if sview_len(target_path) < sview_len(leaf)
            if sview_len(target_path) == sview_len(leaf):
                for index in 0..<sview_len(leaf) |target_path, leaf|:
                    false return if sview_at(target_path, index) != sview_at(leaf, index)
                return true
            prefix_end: usize = sview_len(target_path) - sview_len(leaf)
            false return if prefix_end < 2.usize() or sview_at(target_path, prefix_end - 2.usize()) != 58 or sview_at(target_path, prefix_end - 1.usize()) != 58
            for index in 0..<sview_len(leaf) |target_path, leaf, prefix_end|:
                false return if sview_at(target_path, prefix_end + index) != sview_at(leaf, index)
            return true


        def pymodule_const_index(structs: StructTable&, target_path: sview) -> i64 can[Abort.Panic]:
            qualified: mutable bool = false
            for path_index in 0..<sview_len(target_path) |qualified, target_path|:
                qualified <- true if sview_at(target_path, path_index) == 58 and path_index + 1.usize() < sview_len(target_path) and sview_at(target_path, path_index + 1.usize()) == 58
            found: mutable i64 = -1
            matches: mutable i64 = 0
            for index in 0..<structs.const_names.count |structs, target_path|:
                if pymodule_const_path_matches(target_path, structs.const_names[index]):
                    found <- index.i64()
                    matches <- matches + 1
            return found if not qualified or matches == 1 else -1


        def pymodule_mutable_global_index(structs: StructTable&, target_path: sview) -> i64 can[Abort.Panic]:
            qualified: mutable bool = false
            for path_index in 0..<sview_len(target_path) |qualified, target_path|:
                qualified <- true if sview_at(target_path, path_index) == 58 and path_index + 1.usize() < sview_len(target_path) and sview_at(target_path, path_index + 1.usize()) == 58
            found: mutable i64 = -1
            matches: mutable i64 = 0
            for index in 0..<structs.mutable_global_names.count |structs, target_path|:
                if pymodule_const_path_matches(target_path, structs.mutable_global_names[index]):
                    found <- index.i64()
                    matches <- matches + 1
            return found if not qualified or matches == 1 else -1

        # A Python dict bridge is represented by the concrete DynDict generic struct. Keep
        # this test structural: the generated C shim supplies the same five-word header, while
        # ordinary user structs continue to be rejected as unsupported aggregate parameters.
        def pymodule_dict_boundary_type(value_type: ValueType, structs: mutable StructTable&) -> bool can[Abort.Panic, Memory.Allocate]:
            if value_type.kind == TypeKind.Struct:
                return synthesized_struct_base_is(structs, value_type, "DynDict")
            if value_type.kind == TypeKind.Ref:
                referent: ValueType = ref_target_of(value_type, structs)
                return referent.kind == TypeKind.Struct and synthesized_struct_base_is(structs, referent, "DynDict")
            return false

        def pymodule_dict_return_type(value_type: ValueType, structs: mutable StructTable&) -> bool can[Abort.Panic, Memory.Allocate]:
            return value_type.kind == TypeKind.Struct and synthesized_struct_base_is(structs, value_type, "DynDict")

        # A Python set bridge is the one-column sibling of the dictionary bridge.  The
        # generated C shim supplies the same five-word DynSet header and owns its temporary
        # buckets/arena for the duration of the native call.
        def pymodule_set_boundary_type(value_type: ValueType, structs: mutable StructTable&) -> bool can[Abort.Panic, Memory.Allocate]:
            if value_type.kind == TypeKind.Struct:
                return synthesized_struct_base_is(structs, value_type, "DynSet")
            if value_type.kind == TypeKind.Ref:
                referent: ValueType = ref_target_of(value_type, structs)
                return referent.kind == TypeKind.Struct and synthesized_struct_base_is(structs, referent, "DynSet")
            return false

        def pymodule_set_return_type(value_type: ValueType, structs: mutable StructTable&) -> bool can[Abort.Panic, Memory.Allocate]:
            return value_type.kind == TypeKind.Struct and synthesized_struct_base_is(structs, value_type, "DynSet")

        # DArray values and read-only darray references share the same C header.  Keep
        # the reference form explicit so the stable wrapper can pass the pointer through
        # while still loading ordinary by-value darrays into the target aggregate ABI.
        def pymodule_darray_boundary_type(value_type: ValueType, structs: mutable StructTable&) -> bool can[Abort.Panic]:
            return true if value_type.kind == TypeKind.DArray
            if value_type.kind == TypeKind.Ref:
                referent: ValueType = ref_target_of(value_type, structs)
                return referent.kind == TypeKind.DArray
            return false

        # Plain user structs with scalar/text/object fields cross the Python bridge through
        # caller-owned pointers.  This avoids platform-specific aggregate-return rules for
        # nested `sview` fields and boolean members. The driver performs the source-level field
        # audit before emitting `pymodule-c`; the backend only sees the resolved ValueType, so it
        # accepts the named struct here to materialize the matching pointer bridge. Unsupported
        # fields are still rejected by the driver rather than silently receiving a guessed C ABI.
        def pymodule_struct_boundary_type(value_type: ValueType, structs: mutable StructTable&) -> bool can[Abort.Panic]:
            return value_type.kind == TypeKind.Struct and not pymodule_dict_boundary_type(value_type, structs) and not pymodule_set_boundary_type(value_type, structs)

        # A borrowed scalar fixed array (`array[T, N]&`) is passed as the pointer that
        # stage0 already uses for a reference.  The generated CPython shim copies and
        # validates the Python sequence into an exact-size native buffer, so this bridge
        # never exposes LLVM's by-value array aggregate ABI.  Keep the backend predicate
        # in lockstep with the driver's source-level audit: only primitive numeric/bool
        # elements are currently safe to describe in the C shim.
        def pymodule_fixed_array_boundary_type(value_type: ValueType, structs: mutable StructTable&) -> bool can[Abort.Panic]:
            referent: ValueType = ref_target_of(value_type, structs) if value_type.kind == TypeKind.Ref else value_type
            false return if referent.kind != TypeKind.Array
            false return if referent.bits.usize() >= structs.array_extents.count or structs.array_extents[referent.bits.usize()] > 4096
            element: ValueType = array_element_of(referent, structs)
            return element.kind == TypeKind.Signed or element.kind == TypeKind.Unsigned or element.kind == TypeKind.Bool or element.kind == TypeKind.Float

        # Fixed-array returns use the same explicit out-buffer convention as named
        # structs.  The stable symbol therefore never exposes LLVM's platform-dependent
        # aggregate return ABI: it receives `T *out`, stores the native `[N x T]` result,
        # and returns void.  Keep the element subset and extent bound identical to the
        # driver's Python conversion path.
        def pymodule_fixed_array_return_boundary_type(value_type: ValueType, structs: mutable StructTable&) -> bool can[Abort.Panic]:
            false return if value_type.kind != TypeKind.Array
            false return if value_type.bits.usize() >= structs.array_extents.count or structs.array_extents[value_type.bits.usize()] > 4096
            element: ValueType = array_element_of(value_type, structs)
            return element.kind == TypeKind.Signed or element.kind == TypeKind.Unsigned or element.kind == TypeKind.Bool or element.kind == TypeKind.Float

        # Value optionals use stage0's stable `{i1, T}` ABI.  Pointer optionals are
        # niche-optimized and already accepted through `optional_is_niche`; this helper
        # covers the remaining scalar forms that the generated CPython shim mirrors with
        # small C structs.
        def pymodule_optional_scalar_boundary_type(value_type: ValueType, structs: mutable StructTable&) -> bool can[Abort.Panic]:
            false return if value_type.kind != TypeKind.Optional
            payload: ValueType = optional_payload_of(value_type, structs)
            return payload.kind == TypeKind.Signed or payload.kind == TypeKind.Unsigned or payload.kind == TypeKind.Bool or payload.kind == TypeKind.Float or payload.kind == TypeKind.SView

        # `export pymodule ...: const NAME` is surfaced through a zero-argument accessor rather
        # than a raw global symbol. This keeps the generated C shim independent of LLVM global
        # linkage and gives mutable globals a well-defined load at call time. The supported
        # aggregate exception is an immutable byte darray, whose static storage is copied by the
        # CPython shim before it becomes a Python bytes object.
        def emit_pymodule_global_symbol(module_name: sview, public_name: sview, target_name: sview, literal_text: sview, structs: mutable StructTable&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            target_type: mutable ValueType = unmodeled_type()
            target_global: mutable LLVMValueRef = zeroed
            target_is_mutable: mutable bool = false
            const_index: mutable i64 = -1
            const_global_available: mutable bool = false
            mutable_index: i64 = pymodule_mutable_global_index(structs, target_name)
            if mutable_index >= 0:
                target_type <- copied_type(structs.mutable_global_types[mutable_index.usize()])
                target_global <- structs.mutable_global_handles[mutable_index.usize()]
                target_is_mutable <- true
            else:
                const_index <- pymodule_const_index(structs, target_name)
                false return if const_index < 0
                target_type <- copied_type(structs.const_types[const_index.usize()])
                const_global_available <- structs.const_global_ok[const_index.usize()]
                target_global <- structs.const_globals[const_index.usize()] if const_global_available
                false return if not structs.const_resolved[const_index.usize()] and not const_global_available
            byte_darray_supported: bool = target_type.kind == TypeKind.DArray and darray_element_of(target_type, structs).kind == TypeKind.Unsigned and darray_element_of(target_type, structs).bits == 8
            scalar_supported: bool = target_type.kind == TypeKind.Signed or target_type.kind == TypeKind.Unsigned or target_type.kind == TypeKind.Bool or target_type.kind == TypeKind.Float or target_type.kind == TypeKind.CStr or target_type.kind == TypeKind.SView
            false return if not scalar_supported and not byte_darray_supported

            symbol_storage: mutable darray[u8] = []
            prefix: sview = "elisa_pymodule_"
            for index in 0..<sview_len(prefix) |symbol_storage, prefix|:
                symbol_storage.push(sview_at(prefix, index))
            for index in 0..<sview_len(module_name) |symbol_storage, module_name|:
                symbol_storage.push(sview_at(module_name, index))
            symbol_storage.push(95)
            for index in 0..<sview_len(public_name) |symbol_storage, public_name|:
                symbol_storage.push(sview_at(public_name, index))
            symbol_storage.push(0)
            symbol_name: cstr = (&symbol_storage[0]).cast[cstr]
            value_llvm_type: LLVMTypeRef = llvm_type_of(target_type, structs, ctx)
            wrapper_type: mutable LLVMTypeRef = LLVMFunctionType(value_llvm_type, null, 0, 0)
            if byte_darray_supported:
                byte_darray_params: mutable darray[LLVMTypeRef] = [LLVMPointerTypeInContext(ctx, 0)]
                byte_darray_params_pointer: void& = (&byte_darray_params[0]).cast[void&] can Unsafe.PointerCast
                wrapper_type <- LLVMFunctionType(LLVMVoidTypeInContext(ctx), byte_darray_params_pointer, 1, 0)
            wrapper: mutable LLVMValueRef = zeroed
            if LLVMGetNamedFunction(m, symbol_name) is existing_wrapper:
                wrapper <- existing_wrapper
            else:
                wrapper <- LLVMAddFunction(m, symbol_name, wrapper_type)
            return true if LLVMGetFirstBasicBlock(wrapper) is existing_body
            entry: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, wrapper, "entry")
            LLVMPositionBuilderAtEnd(builder, entry)
            value: mutable LLVMValueRef = zeroed
            if target_is_mutable:
                value <- LLVMBuildLoad2(builder, value_llvm_type, target_global, "pymodule.global.load")
            elif const_global_available:
                value <- LLVMBuildLoad2(builder, value_llvm_type, target_global, "pymodule.const.load")
            else:
                if target_type.kind == TypeKind.Float and structs.const_float_text[const_index.usize()] != "":
                    float_storage: mutable darray[u8] = []
                    value <- LLVMConstRealOfString(value_llvm_type, sview_to_cstr(structs.const_float_text[const_index.usize()], float_storage))
                elif target_type.kind == TypeKind.Signed or target_type.kind == TypeKind.Unsigned or target_type.kind == TypeKind.Bool:
                    value <- LLVMConstInt(value_llvm_type, structs.const_values[const_index.usize()].u64(), 0)
                elif (target_type.kind == TypeKind.CStr or target_type.kind == TypeKind.SView or byte_darray_supported) and (literal_text != "" or structs.const_cstr_text[const_index.usize()] != ""):
                    text_storage: mutable darray[u8] = []
                    stable_literal_text: sview = literal_text if literal_text != "" else structs.const_cstr_text[const_index.usize()]
                    text_cstr: cstr = decoded_literal_cstr(stable_literal_text, text_storage)
                    # LLVMBuildGlobalStringPtr measures its input with strlen, so it silently
                    # truncates literals containing `\0`.  Python sview/bytes exports retain an
                    # explicit length and would then read beyond that shortened global.  Build
                    # the array with its explicit decoded length, including any interior NULs.
                    text_array: LLVMValueRef = LLVMConstStringInContext(ctx, text_cstr, (text_storage.count - 1.usize()).u32(), 0)
                    text_global: LLVMValueRef = LLVMAddGlobal(m, LLVMTypeOf(text_array), ".pymodule.const.text")
                    LLVMSetInitializer(text_global, text_array)
                    LLVMSetLinkage(text_global, 9)
                    LLVMSetUnnamedAddress(text_global, 2)
                    LLVMSetGlobalConstant(text_global, 1)
                    text_indices: mutable darray[LLVMValueRef] = [LLVMConstInt(LLVMInt64TypeInContext(ctx), 0, 0), LLVMConstInt(LLVMInt64TypeInContext(ctx), 0, 0)]
                    text_indices_pointer: void& = (&text_indices[0]).cast[void&] can Unsafe.PointerCast
                    text_pointer: LLVMValueRef = LLVMConstInBoundsGEP2(LLVMTypeOf(text_array), text_global, text_indices_pointer, 2)
                    if target_type.kind == TypeKind.CStr:
                        value <- text_pointer
                    elif target_type.kind == TypeKind.SView:
                        text_length: LLVMValueRef = LLVMConstInt(LLVMInt64TypeInContext(ctx), (text_storage.count - 1.usize()).u64(), 0)
                        value <- LLVMGetUndef(value_llvm_type)
                        value <- LLVMBuildInsertValue(builder, value, text_pointer, 0, "pymodule.const.sview.data")
                        value <- LLVMBuildInsertValue(builder, value, text_length, 1, "pymodule.const.sview.len")
                    else:
                        byte_count: LLVMValueRef = LLVMConstInt(LLVMInt64TypeInContext(ctx), (text_storage.count - 1.usize()).u64(), 0)
                        value <- LLVMGetUndef(value_llvm_type)
                        value <- LLVMBuildInsertValue(builder, value, text_pointer, 0, "pymodule.const.bytes.data")
                        value <- LLVMBuildInsertValue(builder, value, byte_count, 1, "pymodule.const.bytes.count")
                        value <- LLVMBuildInsertValue(builder, value, byte_count, 2, "pymodule.const.bytes.capacity")
                else:
                    return false
            if byte_darray_supported:
                _ = LLVMBuildStore(builder, value, LLVMGetParam(wrapper, 0))
                _ = LLVMBuildRetVoid(builder)
            else:
                _ = LLVMBuildRet(builder, value)
            return true

        # `export pymodule NAME:` entries are surfaced to CPython through a small native
        # shim.  Keep the shim ABI deliberately boring: it has exactly the target's LLVM
        # signature and forwards every argument unchanged.  The generated Python wrapper can
        # therefore declare these symbols with ordinary C scalar/string types (or the explicit
        # opaque `py::Object*` escape hatch) without knowing Elisa calling-convention details.
        # Unsupported aggregate signatures remain rejected; silently exposing those here would
        # make a C shim appear callable while passing the wrong ABI. DArray is the one deliberate
        # aggregate exception, lowered through an explicit sret/arena wrapper. Error returns are
        # adapted through the hidden error-out pointer; a single payload field gets a second
        # explicit out pointer so the CPython shim can expose it as ElisaError.payload.
        def emit_pymodule_symbol(module_name: sview, public_name: sview, target_name: sview, fns: FnTable&, structs: mutable StructTable&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            target_index: i64 = pymodule_target_index(fns, target_name)
            false return if target_index < 0
            is_error: bool = fns.is_error[target_index.usize()]
            error_family: sview = line_error_set_name(structs.error_fn_lines, structs.error_fn_set_names, fns.lines[target_index.usize()]) if is_error else ""
            has_payload_error: bool = is_error and error_set_has_payload(structs, error_family)
            payload_type: ValueType = error_set_single_payload_type(structs, error_family) if has_payload_error else ValueType{kind: TypeKind.Unmodeled, bits: 0}
            structured_payload_error: bool = has_payload_error and payload_type.kind == TypeKind.Unmodeled
            payload_supported: bool = error_payload_type_supported(payload_type, structs) if has_payload_error and not structured_payload_error else error_set_payload_supported(structs, error_family) if structured_payload_error else true
            false return if has_payload_error and not payload_supported
            target_return: ValueType = fns.returns[target_index.usize()]
            has_dict_return: bool = pymodule_dict_return_type(target_return, structs)
            has_set_return: bool = pymodule_set_return_type(target_return, structs)
            has_optional_return: bool = pymodule_optional_scalar_boundary_type(target_return, structs)
            has_fixed_array_return: bool = pymodule_fixed_array_return_boundary_type(target_return, structs)
            scalar_return: bool = target_return.kind == TypeKind.Void or target_return.kind == TypeKind.Signed or target_return.kind == TypeKind.Unsigned or target_return.kind == TypeKind.Bool or target_return.kind == TypeKind.Float or target_return.kind == TypeKind.CStr or target_return.kind == TypeKind.SView or target_return.kind == TypeKind.View or target_return.kind == TypeKind.DArray or target_return.kind == TypeKind.PyObject or optional_is_niche(target_return, structs) or pymodule_optional_scalar_boundary_type(target_return, structs) or has_dict_return or has_set_return or pymodule_struct_boundary_type(target_return, structs) or has_fixed_array_return
            false return if not scalar_return
            false return if is_error and has_fixed_array_return
            param_start: usize = fns.param_start[target_index.usize()]
            param_count: usize = fns.param_count[target_index.usize()]
            for param_offset in 0..<param_count |fns, param_start|:
                parameter_type: ValueType = fns.param_types[param_start + param_offset]
                scalar_param: bool = parameter_type.kind == TypeKind.Signed or parameter_type.kind == TypeKind.Unsigned or parameter_type.kind == TypeKind.Bool or parameter_type.kind == TypeKind.Float or parameter_type.kind == TypeKind.CStr or parameter_type.kind == TypeKind.SView or parameter_type.kind == TypeKind.View or pymodule_darray_boundary_type(parameter_type, structs) or parameter_type.kind == TypeKind.PyObject or optional_is_niche(parameter_type, structs) or pymodule_optional_scalar_boundary_type(parameter_type, structs) or pymodule_dict_boundary_type(parameter_type, structs) or pymodule_set_boundary_type(parameter_type, structs) or pymodule_struct_boundary_type(parameter_type, structs) or pymodule_fixed_array_boundary_type(parameter_type, structs)
                false return if not scalar_param

            has_dict_param: mutable bool = false
            for parameter_offset in 0..<param_count |has_dict_param, fns, param_start, structs|:
                has_dict_param <- true if pymodule_dict_boundary_type(fns.param_types[param_start + parameter_offset], structs)
            has_set_param: mutable bool = false
            for parameter_offset in 0..<param_count |has_set_param, fns, param_start, structs|:
                has_set_param <- true if pymodule_set_boundary_type(fns.param_types[param_start + parameter_offset], structs)
            has_view_param: mutable bool = false
            for parameter_offset in 0..<param_count |has_view_param, fns, param_start|:
                has_view_param <- true if fns.param_types[param_start + parameter_offset].kind == TypeKind.View
            has_fixed_array_param: mutable bool = false
            for parameter_offset in 0..<param_count |has_fixed_array_param, fns, param_start, structs|:
                parameter_type: ValueType = fns.param_types[param_start + parameter_offset]
                has_fixed_array_param <- true if parameter_type.kind == TypeKind.Array and pymodule_fixed_array_boundary_type(parameter_type, structs)
            # Prefixing the symbol avoids collisions with Elisa source names while preserving
            # a deterministic spelling that a generated C wrapper can declare directly.
            symbol_storage: mutable darray[u8] = []
            prefix: sview = "elisa_pymodule_"
            for index in 0..<sview_len(prefix) |symbol_storage, prefix|:
                symbol_storage.push(sview_at(prefix, index))
            for index in 0..<sview_len(module_name) |symbol_storage, module_name|:
                symbol_storage.push(sview_at(module_name, index))
            symbol_storage.push(95)
            for index in 0..<sview_len(public_name) |symbol_storage, public_name|:
                symbol_storage.push(sview_at(public_name, index))
            symbol_storage.push(0)
            symbol_name: cstr = (&symbol_storage[0]).cast[cstr]
            has_darray_return: bool = target_return.kind == TypeKind.DArray
            has_struct_return: bool = pymodule_struct_boundary_type(target_return, structs)
            # Error functions with aggregate/view success values already carry their
            # success out-parameter in the ordinary return slot. Only scalar error
            # bridges need a separate hidden error-out pointer in the public wrapper.
            # Keep this fact in one predicate so adding a new aggregate boundary cannot
            # shift every following wrapper argument.
            has_error_result_out: bool = has_struct_return or has_fixed_array_return or has_darray_return or has_dict_return or has_set_return or has_optional_return or (is_error and target_return.kind == TypeKind.View)
            has_darray_param: mutable bool = false
            for parameter_offset in 0..<param_count |has_darray_param, fns, param_start, structs|:
                has_darray_param <- true if pymodule_darray_boundary_type(fns.param_types[param_start + parameter_offset], structs)
            has_struct_param: mutable bool = false
            for parameter_offset in 0..<param_count |has_struct_param, fns, param_start, structs|:
                has_struct_param <- true if pymodule_struct_boundary_type(fns.param_types[param_start + parameter_offset], structs)
            # DArray and dictionary returns use the same caller-owned sret/arena convention as
            # ordinary bridges; when combined with `error[...]`, the sret slot doubles as the
            # target's success out-parameter.
            # The generated CPython shim only owns an arena for byte-array returns. A
            # scalar/string target that happens to need an internal arena would otherwise grow
            # an invisible trailing parameter here and silently disagree with its C declaration.
            false return if fns.needs_arena[target_index.usize()] and not has_struct_return and not has_darray_return and not has_dict_return and not has_set_return and not has_darray_param and not has_payload_error
            wrapper_type: mutable LLVMTypeRef = LLVMGlobalGetValueType(fns.handles[target_index.usize()])
            if has_struct_return or has_fixed_array_return or has_darray_return or has_dict_return or has_set_return or has_optional_return or (is_error and target_return.kind == TypeKind.View) or has_darray_param or has_fixed_array_param or has_struct_param or has_dict_param or has_set_param or has_view_param or fns.needs_arena[target_index.usize()] or has_payload_error:
                wrapper_params: mutable darray[LLVMTypeRef] = []
                wrapper_params.push(LLVMPointerTypeInContext(ctx, 0)) if has_struct_return
                wrapper_params.push(LLVMPointerTypeInContext(ctx, 0)) if has_fixed_array_return
                # C's ABI returns a three-word darray through an sret pointer on arm64. Keep
                # the stable symbol's boundary in that form instead of exposing LLVM's direct
                # aggregate return convention to the generated C shim.
                wrapper_params.push(LLVMPointerTypeInContext(ctx, 0)) if has_darray_return or has_dict_return or has_set_return
                wrapper_params.push(LLVMPointerTypeInContext(ctx, 0)) if has_optional_return
                # Error functions normally receive a hidden status out-parameter. An aggregate
                # return already owns that slot, so do not duplicate it in the public wrapper;
                # the wrapper forwards `result_storage` as the target's error_out argument.
                # Value-optionals already occupy the target's hidden success slot. They do
                # not receive a second error-out pointer; adding one here shifts every declared
                # argument and is especially dangerous for payload-bearing optional returns.
                wrapper_params.push(LLVMPointerTypeInContext(ctx, 0)) if is_error and target_return.kind == TypeKind.View
                wrapper_params.push(LLVMPointerTypeInContext(ctx, 0)) if is_error and not has_error_result_out
                wrapper_params.push(LLVMPointerTypeInContext(ctx, 0)) if has_payload_error
                for parameter_offset in 0..<param_count |wrapper_params, fns, param_start, structs, ctx|:
                    parameter_type: ValueType = fns.param_types[param_start + parameter_offset]
                    if pymodule_struct_boundary_type(parameter_type, structs) or pymodule_darray_boundary_type(parameter_type, structs) or parameter_type.kind == TypeKind.View or pymodule_dict_boundary_type(parameter_type, structs) or pymodule_set_boundary_type(parameter_type, structs) or pymodule_optional_scalar_boundary_type(parameter_type, structs) or (parameter_type.kind == TypeKind.Array and pymodule_fixed_array_boundary_type(parameter_type, structs)):
                        wrapper_params.push(LLVMPointerTypeInContext(ctx, 0))
                    else:
                        wrapper_params.push(llvm_type_of(parameter_type, structs, ctx))
                # A Python-facing wrapper that returns an arena-backed value receives the
                # caller-owned arena as its final ABI argument. The C shim copies the result
                # before releasing that arena; the stable symbol therefore must not free it.
                wrapper_params.push(LLVMPointerTypeInContext(ctx, 0)) if fns.needs_arena[target_index.usize()]
                wrapper_pointer: void& = (&wrapper_params[0]).cast[void&] can Unsafe.PointerCast
                # Aggregate returns use `void` only for ordinary bridges. Error bridges always
                # return their status code (the payload, when present, is copied to its out
                # slot), including the darray+sret combination.
                wrapper_return: LLVMTypeRef = LLVMInt32TypeInContext(ctx) if is_error else LLVMVoidTypeInContext(ctx) if has_struct_return or has_fixed_array_return or has_darray_return or has_dict_return or has_set_return or has_optional_return else llvm_type_of(target_return, structs, ctx)
                wrapper_type <- LLVMFunctionType(wrapper_return, wrapper_pointer, wrapper_params.count.u32(), 0)
            wrapper: mutable LLVMValueRef = zeroed
            if LLVMGetNamedFunction(m, symbol_name) is existing_wrapper:
                wrapper <- existing_wrapper
            else:
                wrapper <- LLVMAddFunction(m, symbol_name, wrapper_type)
            # This helper is called once per metadata row.  Reusing a completed wrapper keeps
            # duplicate metadata harmless and avoids appending a second entry block.
            return true if LLVMGetFirstBasicBlock(wrapper) is existing_body
            entry: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, wrapper, "entry")
            LLVMPositionBuilderAtEnd(builder, entry)
            arguments: mutable darray[LLVMValueRef] = []
            wrapper_position: mutable u32 = 0
            result_storage: mutable LLVMValueRef = zeroed
            payload_storage: mutable LLVMValueRef = zeroed
            if has_struct_return:
                result_storage <- LLVMGetParam(wrapper, 0)
                wrapper_position <- 1
            if has_fixed_array_return:
                result_storage <- LLVMGetParam(wrapper, wrapper_position)
                wrapper_position <- wrapper_position + 1
            if has_darray_return or has_dict_return or has_set_return:
                result_storage <- LLVMGetParam(wrapper, 0)
                wrapper_position <- 1
            if has_optional_return:
                result_storage <- LLVMGetParam(wrapper, wrapper_position)
                wrapper_position <- wrapper_position + 1
            if is_error and target_return.kind == TypeKind.View:
                result_storage <- LLVMGetParam(wrapper, wrapper_position)
                wrapper_position <- wrapper_position + 1
            if is_error:
                # Error functions receive the caller-owned success payload slot before their
                # declared parameters and return only a status code. For darray returns the
                # result slot is that hidden target out-parameter; scalar bridges carry a
                # separate pointer in the wrapper ABI.
                arguments.push(result_storage) if has_error_result_out
                arguments.push(LLVMGetParam(wrapper, wrapper_position)) if not has_error_result_out
                wrapper_position <- wrapper_position + 1 if not has_error_result_out
                payload_storage <- LLVMGetParam(wrapper, wrapper_position) if has_payload_error
                wrapper_position <- wrapper_position + 1 if has_payload_error
            for position in 0..<param_count |arguments, wrapper, wrapper_position, fns, param_start, structs, ctx|:
                parameter_type: ValueType = fns.param_types[param_start + position]
                wrapper_argument: LLVMValueRef = LLVMGetParam(wrapper, wrapper_position)
                if pymodule_struct_boundary_type(parameter_type, structs):
                    arguments.push(LLVMBuildLoad2(builder, llvm_type_of(parameter_type, structs, ctx), wrapper_argument, "pymodule.struct.arg"))
                elif pymodule_darray_boundary_type(parameter_type, structs):
                    arguments.push(wrapper_argument) if parameter_type.kind == TypeKind.Ref
                    arguments.push(LLVMBuildLoad2(builder, llvm_type_of(parameter_type, structs, ctx), wrapper_argument, "pymodule.darray.arg")) if parameter_type.kind != TypeKind.Ref
                elif parameter_type.kind == TypeKind.View:
                    arguments.push(LLVMBuildLoad2(builder, llvm_type_of(parameter_type, structs, ctx), wrapper_argument, "pymodule.view.arg"))
                elif pymodule_dict_boundary_type(parameter_type, structs):
                    arguments.push(wrapper_argument) if parameter_type.kind == TypeKind.Ref
                    arguments.push(LLVMBuildLoad2(builder, llvm_type_of(parameter_type, structs, ctx), wrapper_argument, "pymodule.dict.arg")) if parameter_type.kind != TypeKind.Ref
                elif pymodule_set_boundary_type(parameter_type, structs):
                    arguments.push(wrapper_argument) if parameter_type.kind == TypeKind.Ref
                    arguments.push(LLVMBuildLoad2(builder, llvm_type_of(parameter_type, structs, ctx), wrapper_argument, "pymodule.set.arg")) if parameter_type.kind != TypeKind.Ref
                elif pymodule_fixed_array_boundary_type(parameter_type, structs):
                    arguments.push(wrapper_argument) if parameter_type.kind == TypeKind.Ref
                    arguments.push(LLVMBuildLoad2(builder, llvm_type_of(parameter_type, structs, ctx), wrapper_argument, "pymodule.fixed_array.arg")) if parameter_type.kind != TypeKind.Ref
                elif pymodule_optional_scalar_boundary_type(parameter_type, structs):
                    arguments.push(LLVMBuildLoad2(builder, llvm_type_of(parameter_type, structs, ctx), wrapper_argument, "pymodule.optional.arg"))
                else:
                    arguments.push(wrapper_argument)
                wrapper_position <- wrapper_position + 1
            arguments.push(LLVMGetParam(wrapper, wrapper_position)) if fns.needs_arena[target_index.usize()]
            call_name: mutable cstr = "pymodule.call"
            call_name <- "" if target_return.kind == TypeKind.Void
            call_result: mutable LLVMValueRef = zeroed
            target: LLVMValueRef = fns.handles[target_index.usize()]
            target_type: LLVMTypeRef = LLVMGlobalGetValueType(target)
            if arguments.count == 0:
                call_result <- LLVMBuildCall2(builder, target_type, target, zeroed, 0, call_name)
            else:
                arguments_pointer: void& = (&arguments[0]).cast[void&] can Unsafe.PointerCast
                call_result <- LLVMBuildCall2(builder, target_type, target, arguments_pointer, arguments.count.u32(), call_name)
            # Error functions return a status (or a tagged error-set aggregate carrying
            # the payload); their successful aggregate result was written through the
            # forwarded out-slot above. This branch must precede the ordinary aggregate
            # sret branch: treating an error struct return as an ordinary aggregate used
            # to emit `ret void` from an `i32` wrapper, which the object path tolerated
            # but the verifier correctly rejected.
            if is_error and has_payload_error:
                error_status: LLVMValueRef = LLVMBuildExtractValue(builder, call_result, 0, "pymodule.error.status")
                if structured_payload_error:
                    _ = LLVMBuildStore(builder, call_result, payload_storage)
                else:
                    error_payload: LLVMValueRef = LLVMBuildExtractValue(builder, call_result, 1, "pymodule.error.payload")
                    _ = LLVMBuildStore(builder, error_payload, payload_storage)
                _ = LLVMBuildRet(builder, error_status)
            elif is_error:
                _ = LLVMBuildRet(builder, call_result)
            elif has_struct_return or has_fixed_array_return:
                _ = LLVMBuildStore(builder, call_result, result_storage)
                _ = LLVMBuildRetVoid(builder)
            elif has_darray_return or has_dict_return or has_set_return or has_optional_return:
                _ = LLVMBuildStore(builder, call_result, result_storage)
                _ = LLVMBuildRetVoid(builder)
            elif target_return.kind == TypeKind.Void:
                _ = LLVMBuildRetVoid(builder)
            else:
                _ = LLVMBuildRet(builder, call_result)
            return true

        # Small, target-data-driven C ABI lowering for same-name exports. The ordinary
        # Stage1 export path historically required an Elisa implementation name different
        # from the public name, so it never needed to materialize this boundary. Stage0 now
        # permits `export fn point(...) = point`: scalar/pointer signatures can stay direct,
        # while small aggregates cross the public boundary as an integer of their byte width.
        def export_abi_packs_value(value_type: ValueType, structs: mutable StructTable&, ctx: LLVMContextRef) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            aggregate: bool = value_type.kind == TypeKind.Struct or value_type.kind == TypeKind.Array or value_type.kind == TypeKind.PayloadEnum
            false return if not aggregate
            value_llvm: LLVMTypeRef = llvm_type_of(value_type, structs, ctx)
            value_bytes: u64 = LLVMABISizeOfType(structs.target_data, value_llvm)
            return value_bytes > 0 and value_bytes <= 8

        def export_abi_type(value_type: ValueType, structs: mutable StructTable&, ctx: LLVMContextRef) -> LLVMTypeRef can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            if export_abi_packs_value(value_type, structs, ctx):
                value_bytes: u64 = LLVMABISizeOfType(structs.target_data, llvm_type_of(value_type, structs, ctx))
                return LLVMIntTypeInContext(ctx, value_bytes.u32() * 8)
            return llvm_type_of(value_type, structs, ctx)

        def export_abi_unpack(value: LLVMValueRef, value_type: ValueType, structs: mutable StructTable&, ctx: LLVMContextRef, builder: LLVMBuilderRef, name: cstr) -> LLVMValueRef can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            return value if not export_abi_packs_value(value_type, structs, ctx)
            abi_type: LLVMTypeRef = export_abi_type(value_type, structs, ctx)
            semantic_type: LLVMTypeRef = llvm_type_of(value_type, structs, ctx)
            storage: LLVMValueRef = LLVMBuildAlloca(builder, abi_type, name)
            _ = LLVMBuildStore(builder, value, storage)
            cast_storage: LLVMValueRef = LLVMBuildBitCast(builder, storage, LLVMPointerTypeInContext(ctx, 0), "export.arg.cast")
            return LLVMBuildLoad2(builder, semantic_type, cast_storage, "export.arg.load")

        def export_abi_pack(value: LLVMValueRef, value_type: ValueType, structs: mutable StructTable&, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            return value if not export_abi_packs_value(value_type, structs, ctx)
            semantic_type: LLVMTypeRef = llvm_type_of(value_type, structs, ctx)
            storage: LLVMValueRef = LLVMBuildAlloca(builder, semantic_type, "export.ret.semantic")
            _ = LLVMBuildStore(builder, value, storage)
            cast_storage: LLVMValueRef = LLVMBuildBitCast(builder, storage, LLVMPointerTypeInContext(ctx, 0), "export.ret.cast")
            return LLVMBuildLoad2(builder, export_abi_type(value_type, structs, ctx), cast_storage, "export.ret.load")

        def same_name_implementation_index(fns: FnTable&, name: sview, arity: usize) -> i64 can[Abort.Panic]:
            for index in 0..<fns.names.count |fns, name, arity|:
                return index.i64() if fns.names[index] == name and fns.owners[index] == "" and not fns.is_extern[index] and fns.param_count[index] == arity
            return -1

        # `export fn public(args) -> T = internal` is represented by the parser as an
        # extern-shaped declaration plus side-table metadata. For the scalar/like-for-like
        # ABI, emit the public symbol as a thin LLVM wrapper around the internal function.
        # Aggregate C ABI lowering is intentionally left to the dedicated export/header path;
        # declining here is safer than silently using the language ABI for a C boundary.
        # `export fn foo(...) = foo`: the public name is the implementation's own. DIRECT
        # when the implementation's lowered type already is the export ABI type (scalars,
        # pointers): no wrapper, the implementation keeps `foo`, and goes external at the
        # end of emission. Otherwise the declaration's own `foo.export` handle receives
        # the wrapper body, the implementation is renamed `foo.impl`, and the wrapper takes
        # `foo`. Mirrors stage0's isDirectlyExportedFunction / sameNameExportNeedsWrapper.
        def emit_same_name_export(export_name: sview, fns: FnTable&, structs: mutable StructTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            impl_index: mutable i64 = -1
            wrapper_index: mutable i64 = -1
            for index in 0..<fns.names.count |impl_index, wrapper_index, fns, export_name|:
                continue if fns.names[index] != export_name or fns.owners[index] != ""
                if fns.is_extern[index]:
                    wrapper_index <- index.i64() if wrapper_index < 0
                else:
                    impl_index <- index.i64() if impl_index < 0
            false return if impl_index < 0 or wrapper_index < 0
            false return if fns.is_error[impl_index.usize()] or fns.needs_arena[impl_index.usize()]
            false return if fns.param_count[impl_index.usize()] != fns.param_count[wrapper_index.usize()]
            impl: LLVMValueRef = fns.handles[impl_index.usize()]
            wrapper: LLVMValueRef = fns.handles[wrapper_index.usize()]
            if LLVMGlobalGetValueType(impl) == LLVMGlobalGetValueType(wrapper):
                structs.direct_export_names.push(export_name)
                structs.direct_export_handles.push(impl)
                LLVMSetLinkage(impl, 0)
                return true
            false return if not emit_export_wrapper_to(export_name, impl, false, wrapper, fns, structs, runtime, m, ctx, builder)
            impl_name_storage: mutable darray[u8] = []
            for impl_name_index in 0..<sview_len(export_name) |impl_name_storage, export_name|:
                impl_name_storage.push(sview_at(export_name, impl_name_index))
            impl_name_storage.push(46)
            impl_name_storage.push(105)
            impl_name_storage.push(109)
            impl_name_storage.push(112)
            impl_name_storage.push(108)
            impl_name_storage.push(0)
            impl_name_cstr: cstr = (&impl_name_storage[0]).cast[cstr] can Unsafe.PointerCast
            LLVMSetValueName2(impl, impl_name_cstr, export_name.len + 5)
            wrapper_name_storage: mutable darray[u8] = []
            for wrapper_name_index in 0..<sview_len(export_name) |wrapper_name_storage, export_name|:
                wrapper_name_storage.push(sview_at(export_name, wrapper_name_index))
            wrapper_name_storage.push(0)
            wrapper_name_cstr: cstr = (&wrapper_name_storage[0]).cast[cstr] can Unsafe.PointerCast
            LLVMSetValueName2(wrapper, wrapper_name_cstr, export_name.len)
            LLVMSetLinkage(wrapper, 0)
            return true

        def emit_export_wrapper(export_name: sview, target_name: sview, fn: LLVMValueRef, fns: FnTable&, structs: mutable StructTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            wrapper_index: i64 = function_index_of(fns, "", export_name)
            # An export declaration carries only the source target name. When
            # that name is overloaded, resolve the target using the wrapper's
            # declared arity instead of whichever overload happened to be
            # registered first.
            target_index: mutable i64 = function_index_of_arity(fns, "", target_name, fns.param_count[wrapper_index.usize()]) if wrapper_index >= 0 else -1
            target_index <- function_index_of(fns, "", target_name) if target_index < 0
            false return if wrapper_index < 0 or target_index < 0
            false return if fns.needs_arena[wrapper_index.usize()]
            false return if fns.is_error[wrapper_index.usize()] or fns.is_error[target_index.usize()]
            false return if fns.param_count[wrapper_index.usize()] != fns.param_count[target_index.usize()]
            target: LLVMValueRef = fns.handles[target_index.usize()]
            return emit_export_wrapper_to(export_name, target, fns.needs_arena[target_index.usize()], fn, fns, structs, runtime, m, ctx, builder)


        # The wrapper body, against an explicit target HANDLE. Split out so a GENERIC target
        # (`= keep_left[Vec[i32]]`) can be wrapped too: an instantiation has no FnTable row,
        # so the arena flag comes from the caller rather than from a row lookup.
        def emit_export_wrapper_to(export_name: sview, target: LLVMValueRef, target_needs_arena: bool, fn: LLVMValueRef, fns: FnTable&, structs: mutable StructTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            wrapper_index: i64 = function_index_of(fns, "", export_name)
            false return if wrapper_index < 0
            entry: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, fn, "entry")
            LLVMPositionBuilderAtEnd(builder, entry)
            argument_count: usize = fns.param_count[wrapper_index.usize()]
            arguments: mutable darray[LLVMValueRef] = []
            # Each exported parameter arrives in its C ABI form (cabi_classify_arg) and is
            # rebuilt as the value the implementation takes: register parts are spilled
            # into an aligned slot and read back as the struct (or the slot itself is
            # handed over when the implementation takes the aggregate indirectly); an
            # indirect parameter is loaded through the incoming pointer.
            export_ret_declared: ValueType = copied_type(fns.returns[wrapper_index.usize()])
            export_ret_plan: CabiRetPlan = cabi_classify_ret(export_ret_declared, structs, ctx) if cabi_is_aggregate(export_ret_declared) else CabiRetPlan{direct: true, sret: false, ret_type: LLVMVoidTypeInContext(ctx), value_type: LLVMVoidTypeInContext(ctx)}
            llvm_param_cursor: mutable u32 = 1 if export_ret_plan.sret else 0
            for position in 0..<argument_count |arguments, fn, wrapper_index, fns, structs, ctx, builder, llvm_param_cursor|:
                export_declared: ValueType = copied_type(fns.param_types[fns.param_start[wrapper_index.usize()] + position])
                export_is_aggregate: bool = cabi_is_aggregate(export_declared)
                if export_is_aggregate == false:
                    arguments.push(LLVMGetParam(fn, llvm_param_cursor))
                    llvm_param_cursor <- llvm_param_cursor + 1
                    continue
                export_plan: CabiArgPlan = cabi_classify_arg(export_declared, structs, ctx)
                export_impl_indirect: bool = value_type_uses_indirect_aggregate(export_declared, structs, ctx)
                if export_plan.direct:
                    export_bytes: mutable u64 = LLVMABISizeOfType(structs.target_data, export_plan.value_type)
                    for export_part_index in 0..<export_plan.parts.count |export_bytes, export_plan, structs|:
                        export_part_end: u64 = export_plan.offsets[export_part_index] + LLVMABISizeOfType(structs.target_data, export_plan.parts[export_part_index])
                        export_bytes <- export_part_end if export_part_end > export_bytes
                    export_slot: LLVMValueRef = cabi_slot(export_bytes, ctx, builder)
                    for export_store_index in 0..<export_plan.parts.count |export_plan, export_slot, fn, llvm_param_cursor, ctx, builder|:
                        _ = LLVMBuildStore(builder, LLVMGetParam(fn, llvm_param_cursor), cabi_ptr_at(export_slot, export_plan.offsets[export_store_index], ctx, builder))
                        llvm_param_cursor <- llvm_param_cursor + 1
                    if export_impl_indirect:
                        arguments.push(export_slot)
                    else:
                        arguments.push(LLVMBuildLoad2(builder, export_plan.value_type, export_slot, "export.arg"))
                else:
                    export_incoming: LLVMValueRef = LLVMGetParam(fn, llvm_param_cursor)
                    llvm_param_cursor <- llvm_param_cursor + 1
                    if export_impl_indirect:
                        arguments.push(export_incoming)
                    else:
                        arguments.push(LLVMBuildLoad2(builder, export_plan.value_type, export_incoming, "export.arg"))
            export_arena_slot: mutable LLVMValueRef = zeroed
            export_threads_arena: bool = target_needs_arena
            if export_threads_arena:
                export_arena_type: LLVMTypeRef = arena_llvm_type(ctx)
                export_arena_slot <- LLVMBuildAlloca(builder, export_arena_type, "auto.region")
                _ = LLVMBuildStore(builder, LLVMConstNull(export_arena_type), export_arena_slot)
                _ = LLVMBuildStore(builder, LLVMConstInt(LLVMInt64TypeInContext(ctx), 0, 0), LLVMBuildStructGEP2(builder, export_arena_type, export_arena_slot, 3, "region.strategy"))
                arguments.push(export_arena_slot)
            target_type: LLVMTypeRef = LLVMGlobalGetValueType(target)
            call_result: mutable LLVMValueRef = zeroed
            # LLVM rejects a named instruction whose result type is void. The call still needs
            # to be emitted, but its SSA name must be empty; the wrapper returns void directly
            # below. Scalar export wrappers keep the descriptive name for readable IR.
            call_name: mutable cstr = "export.call"
            call_name <- "" if fns.returns[wrapper_index.usize()].kind == TypeKind.Void
            if arguments.count == 0:
                call_result <- LLVMBuildCall2(builder, target_type, target, zeroed, 0, call_name)
            else:
                arguments_pointer: void& = (&arguments[0]).cast[void&] can Unsafe.PointerCast
                call_result <- LLVMBuildCall2(builder, target_type, target, arguments_pointer, arguments.count.u32(), call_name)
            if export_threads_arena:
                export_free_args: mutable darray[LLVMValueRef] = [export_arena_slot]
                export_free_pointer: void& = (&export_free_args[0]).cast[void&] can Unsafe.PointerCast
                _ = LLVMBuildCall2(builder, runtime.arena_free_type, runtime.arena_free, export_free_pointer, 1, "")
            if fns.returns[wrapper_index.usize()].kind == TypeKind.Void:
                _ = LLVMBuildRetVoid(builder)
            elif export_ret_plan.sret:
                # The implementation's struct result is stored through the leading sret
                # pointer; the wrapper returns nothing.
                _ = LLVMBuildStore(builder, call_result, LLVMGetParam(fn, 0))
                _ = LLVMBuildRetVoid(builder)
            elif cabi_is_aggregate(export_ret_declared) and export_ret_plan.ret_type != export_ret_plan.value_type:
                # Spill the struct and read it back at the ABI return type.
                export_ret_bytes: mutable u64 = LLVMABISizeOfType(structs.target_data, export_ret_plan.value_type)
                export_ret_abi_bytes: u64 = LLVMABISizeOfType(structs.target_data, export_ret_plan.ret_type)
                export_ret_bytes <- export_ret_abi_bytes if export_ret_abi_bytes > export_ret_bytes
                export_ret_slot: LLVMValueRef = cabi_slot(export_ret_bytes, ctx, builder)
                _ = LLVMBuildStore(builder, call_result, export_ret_slot)
                _ = LLVMBuildRet(builder, LLVMBuildLoad2(builder, export_ret_plan.ret_type, export_ret_slot, "export.ret"))
            else:
                _ = LLVMBuildRet(builder, call_result)
            return true

        # Emit the body of one queued instantiation, with its type parameter BOUND for the
        # whole emission — so every `T` inside resolves to the concrete type.
        def emit_instantiation_body(index: usize, generics: mutable GenericTable&, fns: FnTable&, structs: mutable StructTable&, runtime: mutable Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            base: sview = generics.pending_bases[index]
            handle: LLVMValueRef = generics.pending_handles[index]
            # Use the RECORDED slot, not generic_index_of(base): for an overloaded name the latter
            # returns the first overload, whose body would be wrong for this instantiation.
            slot: usize = generics.pending_slots[index]

            # Rebuild this instantiation's type-argument tuple from the pending pool and bind
            # every K/T for the body emission.
            arg_start: usize = generics.pending_arg_start[index]
            arg_count: usize = generics.pending_arg_count[index]
            type_args: mutable darray[ValueType] = []
            for offset in 0..<arg_count |type_args, generics, arg_start|:
                type_args.push(copied_type(generics.pending_args[arg_start + offset]))
            bound: usize = push_type_bindings(generics, structs, slot, type_args)
            pending_error_family: sview = generics.pending_error_families[index] if index < generics.pending_error_families.count else ""
            error_bound: usize = push_error_family_binding(generics, structs, slot, pending_error_family)
            # An error-returning template (`arena_dict_put[K,T] … error[E]`) must emit its body
            # under the error ABI. emit_function_body keys that off `error_lines` by the decl's
            # line, so hand it a one-line list containing the template's line when it is error-
            # returning; empty otherwise.
            template_error_lines: mutable darray[u32] = []
            template_error_lines.push(function_line_of(generics.decls[slot])) if generics.is_error[slot]
            # A generic INSTANTIATION is emitted here, AFTER emit_debug_info ran, so it has no
            # DISubprogram. Attaching a DWARF local/parameter to a subprogram-less function builds
            # metadata with a NULL scope, which segfaults the O2 pipeline. Emit the monomorph's
            # body with debug OFF (no DWARF locals for the instantiation — sound; a crash is not),
            # then restore so ordinary functions keep their debug info.
            saved_debug_active: bool = runtime.debug_active
            runtime.debug_active <- false
            # EMIT UNDER THE TEMPLATE'S OWN MODULE. This body is emitted from the pending
            # queue, long after the module walk that declared it, so the emission context
            # says nothing about where the template was written. Passing "" here made a bare
            # sibling call inside `module M:` resolve against TOP-LEVEL functions: with a
            # same-named function in scope at the instantiation site, the instantiation
            # silently called the wrong one and the program ran with wrong values rather than
            # failing to build.
            template_owner: sview = generics.owners[slot] if slot < generics.owners.count else ""
            emitted: bool = emit_function_body(generics.decls[slot], template_owner, handle, template_error_lines, fns, structs, generics, runtime, m, ctx, builder)
            runtime.debug_active <- saved_debug_active
            pop_error_family_bindings(structs, error_bound)
            pop_type_bindings(structs, bound)
            # Report the MANGLED name: one template has many instantiations, and the base
            # name alone does not say which type arguments failed.
            record_declined_instantiation(handle, generics.pending_bases[index], m, ctx) if not emitted
            # Match ordinary function linkage: O1/O2/O3 internalize non-exported
            # instantiations, while O0 leaves them externally linked.
            set_defined_function_linkage(generics.pending_bases[index], handle, function_index_of(fns, "", "main") >= 0) if emitted
            return emitted

    public:
        # `-emit interpret`: make the module PRINT `main`'s return value.
        #
        # stage0 interprets the program and reports `[ result   ] <value>`. stage1 runs the
        # compiled program instead, which is observably the same — except the value cannot
        # come back through the process exit status (0-255, and stage0 prints 100000 exactly).
        # So `main` is renamed and a new entry point calls it, printfs the result and returns 0.
        # Renaming happens at the MODULE level because `main` is the entry point and cannot be
        # wrapped in source without rewriting the user's text.
        #
        # Answers false when the unit declares no `main`, which the driver reports the way
        # stage0 does.
        def wrap_main_for_interpret(returns_void: bool, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                # The binding must be introduced by a POSITIVE `is`; it does not escape a
                # negated guard.
                if LLVMGetNamedFunction(m, "main") is user_main:
                    return wrap_main_body(user_main, returns_void, m, ctx, builder)
                return false


        def wrap_main_body(user_main: LLVMValueRef, returns_void: bool, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                user_type: LLVMTypeRef = LLVMGlobalGetValueType(user_main)
                LLVMSetValueName2(user_main, "elisa_interpret_user_main", 25)

                int_type: LLVMTypeRef = LLVMInt32TypeInContext(ctx)
                entry_type: LLVMTypeRef = LLVMFunctionType(int_type, zeroed, 0, 0)
                entry_fn: LLVMValueRef = LLVMAddFunction(m, "main", entry_type)
                entry_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, entry_fn, "entry")
                LLVMPositionBuilderAtEnd(builder, entry_block)
                call_result: LLVMValueRef = LLVMBuildCall2(builder, user_type, user_main, zeroed, 0, "" if returns_void else "interpret.result")
                # A void `main` prints NOTHING — measured against stage0, which emits no
                # result line at all for one.
                if not returns_void:
                    printf_params: mutable darray[LLVMTypeRef] = [LLVMPointerTypeInContext(ctx, 0)]
                    printf_params_pointer: void& = (&printf_params[0]).cast[void&] can Unsafe.PointerCast
                    printf_type: LLVMTypeRef = LLVMFunctionType(int_type, printf_params_pointer, 1, 1)
                    printf_fn: mutable LLVMValueRef = zeroed
                    if LLVMGetNamedFunction(m, "printf") is existing_printf:
                        printf_fn <- existing_printf
                    else:
                        printf_fn <- LLVMAddFunction(m, "printf", printf_type)
                    format_string: LLVMValueRef = LLVMBuildGlobalStringPtr(builder, "[ result   ] %lld\n", "interpret.fmt")
                    printf_args: mutable darray[LLVMValueRef] = [format_string, call_result]
                    printf_args_pointer: void& = (&printf_args[0]).cast[void&] can Unsafe.PointerCast
                    _ = LLVMBuildCall2(builder, printf_type, printf_fn, printf_args_pointer, 2, "")
                _ = LLVMBuildRet(builder, LLVMConstInt(int_type, 0, 0))
                return true
