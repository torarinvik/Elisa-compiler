# Stage1 backend — CLEANUP on the way out: unwinding live owned regions innermost first,
# running deferred bodies in reverse registration order, and the compiler-inserted `__drop__`
# calls (docs/126 D1), including the ones `move` suppresses.
# Part of `module Backend` (see codegen.elisa).

extend Backend:
    private:


        # Free every live owned region, innermost FIRST (reverse declaration order), which is
        # the order stage0 emits them in.
        def emit_region_unwind(regions: RegionStack&, runtime: Runtime&, builder: LLVMBuilderRef) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            index: mutable i64 = regions.arenas.count.i64() - 1
            while index >= 0 |index, regions, runtime, builder|:
                arguments: mutable darray[LLVMValueRef] = [regions.arenas[index.usize()]]
                arguments_pointer: void& = (&arguments[0]).cast[void&] can Unsafe.PointerCast
                _ = LLVMBuildCall2(builder, runtime.arena_free_type, runtime.arena_free, arguments_pointer, 1, "")
                index <- index - 1



        # Run function-level deferred bodies in reverse registration order. Each action
        # reconstructs the lexical scope captured at its declaration, so a later shadowing
        # declaration cannot change what the deferred body observes.
        def emit_deferred_actions(local_scope: Scope&, only_scope_exit: bool, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                return emit_deferred_actions_from(local_scope, 0, only_scope_exit, fns, structs, generics, runtime, m, ctx, builder)





            # Capture every piece of lexical scope metadata that can affect emission of a
            # deferred body. Names and LLVM slots alone are insufficient: container growth
            # depends on declaration-region frames and explicit arena pins, while labelled
            # calls and reference assignment depend on the parallel alias/mutability arrays.
        def capture_deferred_scope(deferred_index: usize, local_scope: mutable Scope&) -> void can[Abort.Panic, Memory.Allocate]:
            local_scope.deferred[deferred_index].names.extend(local_scope.names)
            local_scope.deferred[deferred_index].slots.extend(local_scope.slots)
            local_scope.deferred[deferred_index].types.extend(local_scope.types)
            local_scope.deferred[deferred_index].local_is_mutable.extend(local_scope.local_is_mutable)
            local_scope.deferred[deferred_index].local_fn_origins.extend(local_scope.local_fn_origins)
            local_scope.deferred[deferred_index].local_declared_arenas.extend(local_scope.local_declared_arenas)
            local_scope.deferred[deferred_index].local_has_declared_arena.extend(local_scope.local_has_declared_arena)
            local_scope.deferred[deferred_index].local_parameter_arena_indices.extend(local_scope.local_parameter_arena_indices)
            local_scope.deferred[deferred_index].fn_field_alias_locals.extend(local_scope.fn_field_alias_locals)
            local_scope.deferred[deferred_index].fn_field_alias_fields.extend(local_scope.fn_field_alias_fields)
            local_scope.deferred[deferred_index].fn_field_alias_targets.extend(local_scope.fn_field_alias_targets)
            local_scope.deferred[deferred_index].fn_field_alias_declaration_indices.extend(local_scope.fn_field_alias_declaration_indices)
            local_scope.deferred[deferred_index].region_frame_starts.extend(local_scope.region_frame_starts)
            local_scope.deferred[deferred_index].region_frame_arenas.extend(local_scope.region_frame_arenas)
            local_scope.deferred[deferred_index].region_frame_outers.extend(local_scope.region_frame_outers)
            local_scope.deferred[deferred_index].pool_names.extend(local_scope.pool_names)
            local_scope.deferred[deferred_index].group_names.extend(local_scope.group_names)




            # The same walk bounded BELOW by `from_index` — the actions a nested scope itself
            # registered. A `defer block:` runs when the scope that declared it ends, so a block
            # must not unwind the enclosing function's actions on the way out.
        def emit_deferred_actions_from(local_scope: Scope&, from_index: usize, only_scope_exit: bool, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            index: mutable i64 = local_scope.deferred.count.i64() - 1
            while index >= from_index.i64() |index, from_index, local_scope, fns, structs, generics, runtime, m, ctx, builder|:
                action: DeferredAction = local_scope.deferred[index.usize()]
                if only_scope_exit and not action.scope_exit:
                    index <- index - 1
                    continue
                captured: mutable Scope = Scope{names: [], slots: [], types: [], pool_names: [], group_names: [], deferred: []}
                captured.names.extend(action.names)
                captured.slots.extend(action.slots)
                captured.types.extend(action.types)
                captured.local_is_mutable.extend(action.local_is_mutable)
                captured.local_fn_origins.extend(action.local_fn_origins)
                captured.local_declared_arenas.extend(action.local_declared_arenas)
                captured.local_has_declared_arena.extend(action.local_has_declared_arena)
                captured.local_parameter_arena_indices.extend(action.local_parameter_arena_indices)
                captured.fn_field_alias_locals.extend(action.fn_field_alias_locals)
                captured.fn_field_alias_fields.extend(action.fn_field_alias_fields)
                captured.fn_field_alias_targets.extend(action.fn_field_alias_targets)
                captured.fn_field_alias_declaration_indices.extend(action.fn_field_alias_declaration_indices)
                captured.region_frame_starts.extend(action.region_frame_starts)
                captured.region_frame_arenas.extend(action.region_frame_arenas)
                captured.region_frame_outers.extend(action.region_frame_outers)
                captured.pool_names.extend(action.pool_names)
                captured.group_names.extend(action.group_names)
                deferred_loops: mutable LoopStack = LoopStack{exits: [], continues: [], defer_marks: []}
                deferred_regions: mutable RegionStack = RegionStack{arenas: []}
                status: EmitStatus = emit_statements(action.body, ValueType{kind: TypeKind.Void, bits: 0}, captured, deferred_loops, deferred_regions, fns, structs, generics, runtime, m, ctx, builder)
                if status != EmitStatus.Open:
                    return false
                index <- index - 1
            return true




        # docs/126 D1 — compiler-inserted `__drop__` calls.
        #
        # A drop-typed local registers a deferred action at its declaration. That single
        # registration is all the control flow this needs: the deferred machinery already
        # fires on every exit edge — the function epilogue, every `return`,
        # `break`/`continue`, and block exit — and runs in reverse registration order,
        # which for declarations is reverse declaration order. Drops inherit correct
        # placement rather than re-deriving it.
        #
        # Move suppression is dynamic, through a one-bit live flag per value. A static
        # elision would have to trust the affine tracker, which merges consumption across
        # branches by union: a value moved on one arm of an `if` reads as moved on both,
        # and eliding there would skip a drop that is still owed. The flag is an entry
        # alloca with constant stores, so mem2reg folds it and the branch away whenever
        # the move is unconditional; only a genuinely conditional move pays for a branch.
        def register_drop_cleanup(var_name: sview, declared_type: ValueType, slot: LLVMValueRef, line: u32, local_scope: mutable Scope&, structs: mutable StructTable&, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            return if declared_type.kind != TypeKind.Struct
            return if declared_type.bits.usize() >= structs.names.count
            return if not type_has_drop_hook(structs, structs.names[declared_type.bits.usize()])
            flag_type: ValueType = ValueType{kind: TypeKind.Bool, bits: 1}
            flag_llvm: LLVMTypeRef = llvm_type_of(flag_type, structs, ctx)
            # Armed at the declaration itself: the value is live from here. A path that
            # somehow reaches a cleanup without having run the declaration reads the entry
            # alloca's zero and does nothing, so the failure mode is a leak, never a
            # double free.
            flag: LLVMValueRef = build_entry_alloca(builder, flag_llvm, "drop.live")
            _ = LLVMBuildStore(builder, LLVMConstInt(flag_llvm, 1, 0), flag)
            drop_pos: Ast::Pos = Ast::pos_at_line(line)
            # Synthesized as ordinary AST so the destructor call gets the same overload
            # resolution and ABI handling as a hand-written one.
            drop_body: mutable darray[Stmt] = [(Stmt.If((Expr.Ident("__drop_live", drop_pos)), [(Stmt.Expr((Expr.Call((Expr.Ident("__drop__", drop_pos)), [(Expr.Move((Expr.Ident(var_name, drop_pos)), drop_pos))], [], drop_pos)), drop_pos))], [], drop_pos))]
            drop_mark: usize = local_scope.deferred.count
            local_scope.deferred <- local_scope.deferred.push(DeferredAction{body: [], names: [], slots: [], types: [], scope_exit: true})
            local_scope.deferred[drop_mark].body.extend(drop_body)
            capture_deferred_scope(drop_mark, local_scope)
            # The flag rides along as the action's last captured binding, so the body can
            # name it without the scope machinery growing a field for it.
            local_scope.deferred[drop_mark].names.push("__drop_live")
            local_scope.deferred[drop_mark].slots.push(flag)
            local_scope.deferred[drop_mark].types.push(flag_type)
            local_scope.deferred[drop_mark].local_is_mutable.push(false)
            local_scope.deferred[drop_mark].local_fn_origins.push("")
            local_scope.deferred[drop_mark].local_declared_arenas.push(zeroed)
            local_scope.deferred[drop_mark].local_has_declared_arena.push(false)
            local_scope.deferred[drop_mark].local_parameter_arena_indices.push(-1)




        # The local a registered drop is responsible for, read back out of the body this
        # file synthesized. Reading the AST keeps the association in the action itself
        # rather than in a second table that could fall out of step with it.
        def drop_action_target_name(action: DeferredAction&) -> sview can[Abort.Panic]:
            return "" if action.body.count != 1
            return "" if action.names.count == 0
            return "" if action.names[action.names.count - 1] != "__drop_live"
            match action.body[0]:
                Stmt.If(drop_if_condition, drop_if_then, drop_if_else, drop_if_line):
                    return "" if drop_if_then.count != 1
                    match drop_if_then[0]:
                        Stmt.Expr(drop_call_expression, drop_call_line):
                            match drop_call_expression:
                                Expr.Call(drop_callee, drop_arguments, drop_argument_names, drop_call_pos):
                                    return "" if drop_arguments.count != 1
                                    match drop_arguments[0]:
                                        Expr.Move(drop_moved, drop_moved_line):
                                            match drop_moved:
                                                Expr.Ident(drop_moved_name, drop_moved_ident_line):
                                                    return drop_moved_name
                                                _:
                                                    return ""
                                        _:
                                            return ""
                                _:
                                    return ""
                        _:
                            return ""
                _:
                    return ""




        # `move x` hands the obligation to whoever receives the value, so the declaring
        # scope must not also drop it.
        def suppress_drop_for_moved_local(local_scope: Scope&, moved: Expr, structs: mutable StructTable&, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            moved_name: mutable sview = ""
            match moved:
                Expr.Ident(moved_ident_name, moved_ident_line):
                    moved_name <- moved_ident_name
                _:
                    pass
            return if moved_name == ""
            index: mutable i64 = local_scope.deferred.count.i64() - 1
            while index >= 0 |index, local_scope, moved_name, structs, ctx, builder|:
                if drop_action_target_name(local_scope.deferred[index.usize()]) == moved_name:
                    moved_flag_llvm: LLVMTypeRef = llvm_type_of(ValueType{kind: TypeKind.Bool, bits: 1}, structs, ctx)
                    moved_slots: usize = local_scope.deferred[index.usize()].slots.count
                    _ = LLVMBuildStore(builder, LLVMConstInt(moved_flag_llvm, 0, 0), local_scope.deferred[index.usize()].slots[moved_slots - 1])
                    return
                index <- index - 1
