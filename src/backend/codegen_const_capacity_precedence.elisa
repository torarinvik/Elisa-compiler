# Precedence levels for the source-span constant-capacity parser. Keep these
# relative to parser_expr_binary's table; the proof checker binds that table to
# this model and verifies that the shared operators retain the same ordering.
module BackendCapacityPrecedence:
    public:
        const COMPARISON: i32 = 0
        const BITWISE_OR: i32 = 1
        const BITWISE_XOR: i32 = 2
        const BITWISE_AND: i32 = 3
        const SHIFT: i32 = 4
        const ADDITIVE: i32 = 5
        const MULTIPLICATIVE: i32 = 6
        const MAIN_PARSER_OFFSET: i32 = 3
