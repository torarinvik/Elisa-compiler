# Temporary opt-in diagnostics for the integrated Studio event failure.
extend Backend:
    private:
        def dbg_event_type(label: sview, owner: sview, value: ValueType, structs: StructTable&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            return if not dbg_decline_enabled()
            message: mutable darray[u8] = []
            _ = dbg_push_sview(message, label)
            _ = dbg_push_sview(message, " owner=")
            _ = dbg_push_sview(message, owner)
            _ = dbg_push_sview(message, " kind=")
            _ = dbg_push_int(message, value.kind.i64())
            _ = dbg_push_sview(message, " bits=")
            _ = dbg_push_int(message, value.bits.i64())
            _ = dbg_push_sview(message, " enum_id=")
            _ = dbg_push_int(message, value.enum_id.i64())
            _ = dbg_push_sview(message, " UiCore.Event.slot=")
            _ = dbg_push_int(message, penum_index_of_owned(structs, "UiCore", "Event"))
            _ = dbg_push_sview(message, " Suggestion.Event.slot=")
            _ = dbg_push_int(message, enum_index_of_owned(structs, "StudioSuggestionPolicy", "Event"))
            message.extend([10, 0])
            _ = puts((&message[0]).cast[cstr])
