# Stage1 backend — conservative AUTO-region demand analysis.
#
# The function emitter must not manufacture an arena for a scalar-only body: doing so
# creates an otherwise-unused `arena_free` reference in the object and makes a program
# depend on the runtime merely because it returns an integer. Conversely, a body that
# constructs a growable value must have a real carrier before its emitters run. This
# syntactic pass is deliberately conservative: a false positive costs a lazy carrier,
# while a false negative would put a container allocation on a null or caller-owned
# region. Signature threading remains the ABI authority; this pass only decides whether
# a function with no threaded arena needs a local carrier for its body.

extend Backend:
    private:
        def auto_region_function_needs_arena(fns: FnTable&, name: sview) -> bool can[Abort.Panic]:
            for index in 0..<fns.names.count |fns, name|:
                true return if fns.names[index] == name and fns.needs_arena[index]
            return false


        # The store root implied by a declared value type. Packed user values are handles into
        # a caller-owned store just like compiler AST values, but the caller's local store must
        # be rooted at the USER hierarchy (or at a flat recursive enum), not at the compiler's
        # historical `Node` row. The old boolean-only helper lost that identity and made a local
        # `Widget` initialize a 132-byte Node store instead of the 20-byte Widget store.
        def auto_region_type_packed_store_root(value_type: ValueType, depth: i64, structs: mutable StructTable&) -> i64 can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic, Memory.Allocate:
                -1 return if depth > 6
                if value_type.kind == TypeKind.PackedEnum:
                    return packed_root_index_of(structs, value_type.bits.i64())
                if value_type.kind == TypeKind.DArray:
                    return auto_region_type_packed_store_root(darray_element_of(value_type, structs), depth + 1, structs)
                if value_type.kind == TypeKind.Ref:
                    return auto_region_type_packed_store_root(ref_target_of(value_type, structs), depth + 1, structs)
                if value_type.kind == TypeKind.Optional:
                    return auto_region_type_packed_store_root(optional_payload_of(value_type, structs), depth + 1, structs)
                if value_type.kind == TypeKind.Struct and value_type.bits.usize() < structs.field_start.count:
                    base: usize = structs.field_start[value_type.bits.usize()]
                    count: usize = structs.field_count[value_type.bits.usize()]
                    for offset in 0..<count |base, count, depth, structs|:
                        nested_root: i64 = auto_region_type_packed_store_root(copied_type(structs.field_types[base + offset]), depth + 1, structs)
                        return nested_root if nested_root >= 0
                return -1


        def auto_region_callee_name(callee: Expr) -> sview can[Abort.Panic]:
            if callee is Expr.Ident(auto_region_ident_name, auto_region_ident_line):
                return auto_region_ident_name
            if callee is Expr.Field(auto_region_field_object, auto_region_field_name, auto_region_field_line):
                return auto_region_field_name
            if callee is Expr.Scope(auto_region_scope_base, auto_region_scope_name, auto_region_scope_line):
                return auto_region_scope_name
            return ""


        # The value-type table is intentionally conservative while declarations are being
        # registered.  That used to make a local `mutable darray[sview] = []` disappear from
        # the auto-region scan in the self-hosted backend even though its declaration and its
        # later `push` calls plainly allocate.  Stage0's region inference keys this decision on
        # the source annotation, so keep the backend scan equally structural: unwrap the
        # mutability/parenthesis shells and inspect the generic head directly.
        def auto_region_growable_type_head(type_expression: Expr) -> sview can[Abort.Panic]:
            if type_expression is Expr.Unary(auto_region_type_operator, auto_region_type_operand, auto_region_type_line):
                return auto_region_growable_type_head(auto_region_type_operand) if auto_region_type_operator == TokenKind.Mutable else ""
            if type_expression is Expr.Paren(auto_region_type_inner, auto_region_type_paren_line):
                return auto_region_growable_type_head(auto_region_type_inner)
            if type_expression is Expr.Index(auto_region_type_head, auto_region_type_argument, auto_region_type_index_line):
                if auto_region_type_head is Expr.Ident(auto_region_type_name, auto_region_type_name_line):
                    return auto_region_type_name
            if type_expression is Expr.IndexN(auto_region_type_head_n, auto_region_type_arguments, auto_region_type_indexn_line):
                if auto_region_type_head_n is Expr.Ident(auto_region_type_name_n, auto_region_type_name_line_n):
                    return auto_region_type_name_n
            return ""


        # Runtime entry points and mutating container methods whose call itself can create
        # backing storage. A direct known function with a threaded arena is covered below;
        # these names cover methods and declarations synthesized outside FnTable.
        def auto_region_call_allocates(callee: Expr, fns: FnTable&) -> bool can[Abort.Panic]:
            can Abort.Panic:
                call_name: sview = auto_region_callee_name(callee)
                true return if auto_region_function_needs_arena(fns, call_name)
                # Explicit allocator entry points consume a caller-supplied arena (or the
                # permanent allocator for f-strings); they do not need a fresh local carrier.
                # Treating them as local-region demand made helpers such as `ctx_aos_store_new`
                # manufacture a zeroed arena and later pass it to `arena_free`, diverging from
                # stage0 and crashing at the first allocation.
                # `clone[T](x)` is a type-application callee, not a bare name or method. Its
                # aggregate/error-union paths allocate destination storage even when the
                # source itself is scalar, so it must keep the caller's carrier live.
                if callee is Expr.Index(auto_region_clone_head, auto_region_clone_type, auto_region_clone_line):
                    true return if auto_region_clone_head is Expr.Ident(auto_region_clone_name, auto_region_clone_name_line) and auto_region_clone_name == "clone"
                if callee is Expr.IndexN(auto_region_clone_head_n, auto_region_clone_types, auto_region_clone_line_n):
                    true return if auto_region_clone_head_n is Expr.Ident(auto_region_clone_name_n, auto_region_clone_name_line_n) and auto_region_clone_name_n == "clone"
                # These are METHOD names, not global function names: a perfectly ordinary
                # scalar helper may be called `add` or `clone`, and classifying that bare call
                # as a container mutation would recreate the very false positive this pass is
                # meant to remove.
                if callee is Expr.Field(auto_region_method_receiver, auto_region_method_name, auto_region_method_line):
                    true return if auto_region_method_name == "push" or auto_region_method_name == "extend" or auto_region_method_name == "reserve"
                    true return if auto_region_method_name == "resize" or auto_region_method_name == "truncate" or auto_region_method_name == "insert"
                    true return if auto_region_method_name == "put" or auto_region_method_name == "add" or auto_region_method_name == "append"
                    true return if auto_region_method_name == "clone" or auto_region_method_name == "materialize"
                return false


        # A call can require the compiler AST store even when the AST constructor is hidden in
        # the callee. Follow the same FnTable fact used by the ordinary region scan, but only
        # for parser/backend helpers or functions whose return type reaches the AST hierarchy.
        def auto_region_call_needs_packed_store(callee: Expr, fns: FnTable&, structs: mutable StructTable&) -> bool can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic, Memory.Allocate:
                # A field call is a method dispatch. Its bare method name is not enough to
                # identify a store-bearing module member because unrelated modules can reuse
                # names such as `current_char`; for field calls use the return-type evidence
                # below, while bare and qualified calls may use the owning compiler module.
                field_call: mutable bool = false
                if callee is Expr.Field(auto_region_method_receiver, auto_region_method_name, auto_region_method_line):
                    field_call <- true
                call_name: sview = auto_region_callee_name(callee)
                return false if call_name == ""
                for index in 0..<fns.names.count |fns, structs, call_name|:
                    continue if fns.names[index] != call_name or not fns.needs_store[index]
                    # Same collision as function_needs_ast_store: only the COMPILER'S own
                    # Parser/Backend modules thread a store, and ast_refinement_names is
                    # empty for every other program.
                    true return if not field_call and structs.ast_refinement_names.count > 0 and (fns.owners[index] == "Parser" or fns.owners[index] == "Backend")
                    true return if type_is_or_contains_packed_ast(fns.returns[index], 0, structs)
                return false

        # A bare `new E.V(...)` is represented by the parser as an ordinary constructor call
        # after the allocation marker is recorded in its line side table. For a recursive or
        # explicitly packed enum, that allocation is backed by an implicit store in the
        # function's inferred region. It is not a call to a named helper, so the generic call
        # facts above cannot discover the allocation by looking only at `fns`.
        def auto_region_packed_constructor_root(callee: Expr, structs: mutable StructTable&) -> i64 can[Abort.Panic]:
            can Abort.Panic:
                if callee is Expr.Field(auto_region_packed_head, auto_region_packed_variant, auto_region_packed_line):
                    enum_name: sview = packed_constructor_enum_name(auto_region_packed_head)
                    enum_index: i64 = packed_index_of(structs, enum_name)
                    if enum_index >= 0 and packed_variant_local_index(structs, enum_index, auto_region_packed_variant) >= 0:
                        return packed_root_index_of(structs, enum_index)
                return -1


        def auto_region_expression_packed_store_root(expression: Expr, fns: FnTable&, structs: mutable StructTable&) -> i64 can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic, Memory.Allocate:
                direct_constructor_root: i64 = auto_region_packed_constructor_root(expression, structs)
                return direct_constructor_root if direct_constructor_root >= 0
                if expression is Expr.Call(auto_region_root_call_callee, auto_region_root_call_args, auto_region_root_call_names, auto_region_root_call_line):
                    direct_root: i64 = auto_region_packed_constructor_root(auto_region_root_call_callee, structs)
                    return direct_root if direct_root >= 0
                    if auto_region_call_needs_packed_store(auto_region_root_call_callee, fns, structs):
                        call_name: sview = auto_region_callee_name(auto_region_root_call_callee)
                        for call_index in 0..<fns.names.count |fns, call_name, structs|:
                            continue if fns.names[call_index] != call_name
                            call_root: i64 = auto_region_type_packed_store_root(fns.returns[call_index], 0, structs)
                            return call_root if call_root >= 0
                        return packed_index_of(structs, "Node")
                    nested_root: mutable i64 = auto_region_expression_packed_store_root(auto_region_root_call_callee, fns, structs)
                    return nested_root if nested_root >= 0
                    for root_argument in auto_region_root_call_args |fns, structs|:
                        nested_root <- auto_region_expression_packed_store_root(root_argument, fns, structs)
                        return nested_root if nested_root >= 0
                    return -1
                if expression is Expr.RegionNew(auto_region_root_new_operand, auto_region_root_new_region, auto_region_root_new_line):
                    return auto_region_expression_packed_store_root(auto_region_root_new_operand, fns, structs)
                if expression is Expr.Block(auto_region_root_block_statements, auto_region_root_block_value, auto_region_root_block_captures, auto_region_root_block_line):
                    nested_root: mutable i64 = auto_region_statements_packed_store_root(auto_region_root_block_statements, fns, structs)
                    return nested_root if nested_root >= 0
                    return auto_region_expression_packed_store_root(auto_region_root_block_value, fns, structs)
                if expression is Expr.If(auto_region_root_if_condition, auto_region_root_if_then, auto_region_root_if_else, auto_region_root_if_line):
                    nested_root: mutable i64 = auto_region_expression_packed_store_root(auto_region_root_if_condition, fns, structs)
                    nested_root <- auto_region_expression_packed_store_root(auto_region_root_if_then, fns, structs) if nested_root < 0
                    nested_root <- auto_region_expression_packed_store_root(auto_region_root_if_else, fns, structs) if nested_root < 0
                    return nested_root
                if expression is Expr.Binary(auto_region_root_binary_left, auto_region_root_binary_operator, auto_region_root_binary_right, auto_region_root_binary_line):
                    nested_root: mutable i64 = auto_region_expression_packed_store_root(auto_region_root_binary_left, fns, structs)
                    nested_root <- auto_region_expression_packed_store_root(auto_region_root_binary_right, fns, structs) if nested_root < 0
                    return nested_root
                if expression is Expr.Unary(auto_region_root_unary_operator, auto_region_root_unary_operand, auto_region_root_unary_line):
                    return auto_region_expression_packed_store_root(auto_region_root_unary_operand, fns, structs)
                if expression is Expr.Move(auto_region_root_move_operand, auto_region_root_move_line):
                    return auto_region_expression_packed_store_root(auto_region_root_move_operand, fns, structs)
                if expression is Expr.Paren(auto_region_root_paren_operand, auto_region_root_paren_line):
                    return auto_region_expression_packed_store_root(auto_region_root_paren_operand, fns, structs)
                if expression is Expr.Index(auto_region_root_index_object, auto_region_root_index_index, auto_region_root_index_line):
                    nested_root: mutable i64 = auto_region_expression_packed_store_root(auto_region_root_index_object, fns, structs)
                    nested_root <- auto_region_expression_packed_store_root(auto_region_root_index_index, fns, structs) if nested_root < 0
                    return nested_root
                if expression is Expr.IndexN(auto_region_root_indexn_object, auto_region_root_indexn_args, auto_region_root_indexn_line):
                    nested_root: mutable i64 = auto_region_expression_packed_store_root(auto_region_root_indexn_object, fns, structs)
                    for root_argument in auto_region_root_indexn_args |nested_root, fns, structs|:
                        nested_root <- auto_region_expression_packed_store_root(root_argument, fns, structs) if nested_root < 0
                    return nested_root
                if expression is Expr.Slice(auto_region_root_slice_object, auto_region_root_slice_low, auto_region_root_slice_high, auto_region_root_slice_line):
                    nested_root: mutable i64 = auto_region_expression_packed_store_root(auto_region_root_slice_object, fns, structs)
                    nested_root <- auto_region_expression_packed_store_root(auto_region_root_slice_low, fns, structs) if nested_root < 0
                    nested_root <- auto_region_expression_packed_store_root(auto_region_root_slice_high, fns, structs) if nested_root < 0
                    return nested_root
                if expression is Expr.Field(auto_region_root_field_object, auto_region_root_field_name, auto_region_root_field_line):
                    return auto_region_expression_packed_store_root(auto_region_root_field_object, fns, structs)
                if expression is Expr.Scope(auto_region_root_scope_object, auto_region_root_scope_name, auto_region_root_scope_line):
                    return auto_region_expression_packed_store_root(auto_region_root_scope_object, fns, structs)
                if expression is Expr.Tuple(auto_region_root_tuple_elements, auto_region_root_tuple_line):
                    for root_element in auto_region_root_tuple_elements |fns, structs|:
                        nested_root: mutable i64 = auto_region_expression_packed_store_root(root_element, fns, structs)
                        return nested_root if nested_root >= 0
                    return -1
                if expression is Expr.Construct(auto_region_root_construct_type, auto_region_root_construct_fields, auto_region_root_construct_line):
                    nested_root: mutable i64 = auto_region_expression_packed_store_root(auto_region_root_construct_type, fns, structs)
                    for root_field in auto_region_root_construct_fields |nested_root, fns, structs|:
                        nested_root <- auto_region_expression_packed_store_root(root_field.value, fns, structs) if nested_root < 0
                    return nested_root
                if expression is Expr.RecordUpdate(auto_region_root_update_base, auto_region_root_update_fields, auto_region_root_update_line):
                    nested_root: mutable i64 = auto_region_expression_packed_store_root(auto_region_root_update_base, fns, structs)
                    for root_field in auto_region_root_update_fields |nested_root, fns, structs|:
                        nested_root <- auto_region_expression_packed_store_root(root_field.value, fns, structs) if nested_root < 0
                    return nested_root
                if expression is Expr.Match(auto_region_root_match_scrutinee, auto_region_root_match_arms, auto_region_root_match_line):
                    nested_root: mutable i64 = auto_region_expression_packed_store_root(auto_region_root_match_scrutinee, fns, structs)
                    for root_arm in auto_region_root_match_arms |nested_root, fns, structs|:
                        nested_root <- auto_region_expression_packed_store_root(root_arm.guard, fns, structs) if nested_root < 0
                        nested_root <- auto_region_statements_packed_store_root(root_arm.body, fns, structs) if nested_root < 0
                    return nested_root
                if expression is Expr.Catch(auto_region_root_catch_scrutinee, auto_region_root_catch_arms, auto_region_root_catch_line):
                    nested_root: mutable i64 = auto_region_expression_packed_store_root(auto_region_root_catch_scrutinee, fns, structs)
                    for root_arm in auto_region_root_catch_arms |nested_root, fns, structs|:
                        nested_root <- auto_region_expression_packed_store_root(root_arm.guard, fns, structs) if nested_root < 0
                        nested_root <- auto_region_statements_packed_store_root(root_arm.body, fns, structs) if nested_root < 0
                    return nested_root
                if expression is Expr.Refinement(auto_region_root_refinement_base, auto_region_root_refinement_predicate, auto_region_root_refinement_line):
                    nested_root: mutable i64 = auto_region_expression_packed_store_root(auto_region_root_refinement_base, fns, structs)
                    nested_root <- auto_region_expression_packed_store_root(auto_region_root_refinement_predicate, fns, structs) if nested_root < 0
                    return nested_root
                if expression is Expr.GetElse(auto_region_root_get_guarded, auto_region_root_get_recovery, auto_region_root_get_line):
                    nested_root: mutable i64 = auto_region_expression_packed_store_root(auto_region_root_get_guarded, fns, structs)
                    nested_root <- auto_region_statements_packed_store_root(auto_region_root_get_recovery, fns, structs) if nested_root < 0
                    return nested_root
                if expression is Expr.Comprehension(auto_region_root_comp_var, auto_region_root_comp_iterable, auto_region_root_comp_condition, auto_region_root_comp_body, auto_region_root_comp_line):
                    nested_root: mutable i64 = auto_region_expression_packed_store_root(auto_region_root_comp_iterable, fns, structs)
                    nested_root <- auto_region_expression_packed_store_root(auto_region_root_comp_condition, fns, structs) if nested_root < 0
                    nested_root <- auto_region_expression_packed_store_root(auto_region_root_comp_body, fns, structs) if nested_root < 0 and auto_region_root_comp_body is not Expr.Absent
                    return nested_root
                return -1


        def auto_region_statement_packed_store_root(statement: Stmt, fns: FnTable&, structs: mutable StructTable&) -> i64 can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic, Memory.Allocate:
                if statement is Stmt.Expr(auto_region_root_stmt_expression, auto_region_root_stmt_line):
                    return auto_region_expression_packed_store_root(auto_region_root_stmt_expression, fns, structs)
                if statement is Stmt.VarDecl(auto_region_root_decl_name, auto_region_root_decl_type, auto_region_root_decl_value, auto_region_root_decl_line):
                    # A local aggregate can carry the AST hierarchy even when its initializer is
                    # an ordinary helper call.  `file: Ast::File = parse(...)` is the important
                    # shape: the constructor is inside the callee, so expression-only scanning
                    # misses the store root and the caller later declines while trying to pass a
                    # store-less null value.  Stage0 derives this from the declared type.  Keep
                    # the same fact here so test/driver entry points can create one local store
                    # and thread it through parser helpers without adding an ABI parameter to
                    # the entry point itself.
                    declared_type: ValueType = annotation_value_type(auto_region_root_decl_type, structs)
                    declared_root: i64 = auto_region_type_packed_store_root(declared_type, 0, structs)
                    return declared_root if declared_root >= 0
                    return auto_region_expression_packed_store_root(auto_region_root_decl_value, fns, structs)
                if statement is Stmt.Assign(auto_region_root_assign_target, auto_region_root_assign_operator, auto_region_root_assign_value, auto_region_root_assign_line):
                    nested_root: mutable i64 = auto_region_expression_packed_store_root(auto_region_root_assign_target, fns, structs)
                    nested_root <- auto_region_expression_packed_store_root(auto_region_root_assign_value, fns, structs) if nested_root < 0
                    return nested_root
                if statement is Stmt.Block(auto_region_root_stmt_block_kind, auto_region_root_stmt_block_clause, auto_region_root_stmt_block_binding, auto_region_root_stmt_block_body, auto_region_root_stmt_block_line):
                    return auto_region_statements_packed_store_root(auto_region_root_stmt_block_body, fns, structs)
                if statement is Stmt.If(auto_region_root_stmt_if_condition, auto_region_root_stmt_if_then, auto_region_root_stmt_if_else, auto_region_root_stmt_if_line):
                    nested_root: mutable i64 = auto_region_expression_packed_store_root(auto_region_root_stmt_if_condition, fns, structs)
                    nested_root <- auto_region_statements_packed_store_root(auto_region_root_stmt_if_then, fns, structs) if nested_root < 0
                    nested_root <- auto_region_statements_packed_store_root(auto_region_root_stmt_if_else, fns, structs) if nested_root < 0
                    return nested_root
                if statement is Stmt.While(auto_region_root_stmt_while_condition, auto_region_root_stmt_while_body, auto_region_root_stmt_while_line):
                    nested_root: mutable i64 = auto_region_expression_packed_store_root(auto_region_root_stmt_while_condition, fns, structs)
                    nested_root <- auto_region_statements_packed_store_root(auto_region_root_stmt_while_body, fns, structs) if nested_root < 0
                    return nested_root
                if statement is Stmt.For(auto_region_root_for_bind, auto_region_root_for_variables, auto_region_root_for_iterable, auto_region_root_for_body, auto_region_root_for_line):
                    nested_root: mutable i64 = auto_region_expression_packed_store_root(auto_region_root_for_iterable, fns, structs)
                    nested_root <- auto_region_statements_packed_store_root(auto_region_root_for_body, fns, structs) if nested_root < 0
                    return nested_root
                if statement is Stmt.Return(auto_region_root_return_value, auto_region_root_return_line):
                    if auto_region_root_return_value is value:
                        return auto_region_expression_packed_store_root(value, fns, structs)
                    return -1
                if statement is Stmt.Match(auto_region_root_stmt_match_scrutinee, auto_region_root_stmt_match_arms, auto_region_root_stmt_match_line):
                    nested_root: mutable i64 = auto_region_expression_packed_store_root(auto_region_root_stmt_match_scrutinee, fns, structs)
                    for root_arm in auto_region_root_stmt_match_arms |nested_root, fns, structs|:
                        nested_root <- auto_region_expression_packed_store_root(root_arm.guard, fns, structs) if nested_root < 0
                        nested_root <- auto_region_statements_packed_store_root(root_arm.body, fns, structs) if nested_root < 0
                    return nested_root
                if statement is Stmt.Contract(auto_region_root_contract_kind, auto_region_root_contract_expression, auto_region_root_contract_line):
                    return auto_region_expression_packed_store_root(auto_region_root_contract_expression, fns, structs)
                return -1


        def auto_region_statements_packed_store_root(statements: darray[Stmt], fns: FnTable&, structs: mutable StructTable&) -> i64 can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic, Memory.Allocate:
                for root_statement in statements |fns, structs|:
                    nested_root: mutable i64 = auto_region_statement_packed_store_root(root_statement, fns, structs)
                    return nested_root if nested_root >= 0
                return -1


        def auto_region_expression_needs_arena(expression: Expr, fns: FnTable&, structs: mutable StructTable&, generics: GenericTable&) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                true return if auto_region_packed_constructor_root(expression, structs) >= 0
                if expression is Expr.Call(auto_region_call_callee, auto_region_call_args, auto_region_call_names, auto_region_call_line):
                    true return if auto_region_packed_constructor_root(auto_region_call_callee, structs) >= 0
                    true return if auto_region_call_allocates(auto_region_call_callee, fns)
                    true return if auto_region_expression_needs_arena(auto_region_call_callee, fns, structs, generics)
                    for auto_region_call_arg in auto_region_call_args |fns, structs, generics|:
                        true return if auto_region_expression_needs_arena(auto_region_call_arg, fns, structs, generics)
                    return false
                if expression is Expr.RegionNew(auto_region_new_operand, auto_region_new_region, auto_region_new_line):
                    return true
                if expression is Expr.Array(auto_region_array_elements, auto_region_array_line):
                    # The expected type distinguishes fixed arrays from darrays only at
                    # emission time. Keeping this conservative protects an untyped literal
                    # and only adds a lazy carrier for fixed-array bodies.
                    return true
                if expression is Expr.SetLit(auto_region_set_elements, auto_region_set_line):
                    return true
                if expression is Expr.DictLit(auto_region_dict_entries, auto_region_dict_line):
                    return true
                if expression is Expr.Comprehension(auto_region_comp_var, auto_region_comp_iterable, auto_region_comp_condition, auto_region_comp_body, auto_region_comp_line):
                    true return if auto_region_expression_needs_arena(auto_region_comp_iterable, fns, structs, generics)
                    true return if auto_region_expression_needs_arena(auto_region_comp_condition, fns, structs, generics)
                    return auto_region_comp_body is not Expr.Absent or auto_region_expression_needs_arena(auto_region_comp_body, fns, structs, generics)
                if expression is Expr.Block(auto_region_block_statements, auto_region_block_value, auto_region_block_captures, auto_region_block_line):
                    true return if auto_region_statements_need_arena(auto_region_block_statements, fns, structs, generics)
                    return auto_region_expression_needs_arena(auto_region_block_value, fns, structs, generics)
                if expression is Expr.Lambda(auto_region_lambda_params, auto_region_lambda_body, auto_region_lambda_line):
                    # The lambda is emitted as its own function. Its carrier decision is
                    # made when that body is emitted, not on the enclosing function.
                    return false
                if expression is Expr.Binary(auto_region_binary_left, auto_region_binary_operator, auto_region_binary_right, auto_region_binary_line):
                    return auto_region_expression_needs_arena(auto_region_binary_left, fns, structs, generics) or auto_region_expression_needs_arena(auto_region_binary_right, fns, structs, generics)
                if expression is Expr.Unary(auto_region_unary_operator, auto_region_unary_operand, auto_region_unary_line):
                    return auto_region_expression_needs_arena(auto_region_unary_operand, fns, structs, generics)
                if expression is Expr.Move(auto_region_move_operand, auto_region_move_line):
                    return auto_region_expression_needs_arena(auto_region_move_operand, fns, structs, generics)
                if expression is Expr.Paren(auto_region_paren_inner, auto_region_paren_line):
                    return auto_region_expression_needs_arena(auto_region_paren_inner, fns, structs, generics)
                if expression is Expr.Index(auto_region_index_object, auto_region_index_index, auto_region_index_line):
                    return auto_region_expression_needs_arena(auto_region_index_object, fns, structs, generics) or auto_region_expression_needs_arena(auto_region_index_index, fns, structs, generics)
                if expression is Expr.IndexN(auto_region_indexn_object, auto_region_indexn_args, auto_region_indexn_line):
                    true return if auto_region_expression_needs_arena(auto_region_indexn_object, fns, structs, generics)
                    for auto_region_indexn_arg in auto_region_indexn_args |fns, structs, generics|:
                        true return if auto_region_expression_needs_arena(auto_region_indexn_arg, fns, structs, generics)
                    return false
                if expression is Expr.Slice(auto_region_slice_object, auto_region_slice_low, auto_region_slice_high, auto_region_slice_line):
                    return auto_region_expression_needs_arena(auto_region_slice_object, fns, structs, generics) or auto_region_expression_needs_arena(auto_region_slice_low, fns, structs, generics) or auto_region_expression_needs_arena(auto_region_slice_high, fns, structs, generics)
                if expression is Expr.Field(auto_region_field_object2, auto_region_field_name2, auto_region_field_line2):
                    return auto_region_expression_needs_arena(auto_region_field_object2, fns, structs, generics)
                if expression is Expr.Scope(auto_region_scope_base2, auto_region_scope_name2, auto_region_scope_line2):
                    return auto_region_expression_needs_arena(auto_region_scope_base2, fns, structs, generics)
                if expression is Expr.Tuple(auto_region_tuple_elements, auto_region_tuple_line):
                    for auto_region_tuple_element in auto_region_tuple_elements |fns, structs, generics|:
                        true return if auto_region_expression_needs_arena(auto_region_tuple_element, fns, structs, generics)
                    return false
                if expression is Expr.Construct(auto_region_construct_type, auto_region_construct_fields, auto_region_construct_line):
                    true return if auto_region_expression_needs_arena(auto_region_construct_type, fns, structs, generics)
                    for auto_region_construct_field in auto_region_construct_fields |fns, structs, generics|:
                        true return if auto_region_expression_needs_arena(auto_region_construct_field.value, fns, structs, generics)
                    return false
                if expression is Expr.RecordUpdate(auto_region_update_base, auto_region_update_fields, auto_region_update_line):
                    true return if auto_region_expression_needs_arena(auto_region_update_base, fns, structs, generics)
                    for auto_region_update_field in auto_region_update_fields |fns, structs, generics|:
                        true return if auto_region_expression_needs_arena(auto_region_update_field.value, fns, structs, generics)
                    return false
                if expression is Expr.If(auto_region_if_condition, auto_region_if_then, auto_region_if_else, auto_region_if_line):
                    return auto_region_expression_needs_arena(auto_region_if_condition, fns, structs, generics) or auto_region_expression_needs_arena(auto_region_if_then, fns, structs, generics) or auto_region_expression_needs_arena(auto_region_if_else, fns, structs, generics)
                if expression is Expr.Match(auto_region_match_scrutinee, auto_region_match_arms, auto_region_match_line) or expression is Expr.Catch(auto_region_match_scrutinee, auto_region_match_arms, auto_region_match_line):
                    true return if auto_region_expression_needs_arena(auto_region_match_scrutinee, fns, structs, generics)
                    for auto_region_match_arm in auto_region_match_arms |fns, structs, generics|:
                        true return if auto_region_expression_needs_arena(auto_region_match_arm.guard, fns, structs, generics)
                        true return if auto_region_statements_need_arena(auto_region_match_arm.body, fns, structs, generics)
                    return false
                if expression is Expr.Refinement(auto_region_refinement_base, auto_region_refinement_predicate, auto_region_refinement_line):
                    return auto_region_expression_needs_arena(auto_region_refinement_base, fns, structs, generics) or auto_region_expression_needs_arena(auto_region_refinement_predicate, fns, structs, generics)
                if expression is Expr.GetElse(auto_region_get_guarded, auto_region_get_recovery, auto_region_get_line):
                    true return if auto_region_expression_needs_arena(auto_region_get_guarded, fns, structs, generics)
                    return auto_region_statements_need_arena(auto_region_get_recovery, fns, structs, generics)
                return false


        def auto_region_statement_needs_arena(statement: Stmt, fns: FnTable&, structs: mutable StructTable&, generics: GenericTable&) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                if statement is Stmt.Expr(auto_region_stmt_expression, auto_region_stmt_line):
                    return auto_region_expression_needs_arena(auto_region_stmt_expression, fns, structs, generics)
                if statement is Stmt.VarDecl(auto_region_decl_name, auto_region_decl_type, auto_region_decl_value, auto_region_decl_line):
                    declared: ValueType = annotation_value_type(auto_region_decl_type, structs)
                    true return if declared.kind == TypeKind.DArray or declared.kind == TypeKind.View
                    true return if declared.kind == TypeKind.Struct and struct_contains_darray(declared, structs)
                    growable_head: sview = auto_region_growable_type_head(auto_region_decl_type)
                    true return if growable_head == "darray" or growable_head == "dict" or growable_head == "set"
                    return auto_region_expression_needs_arena(auto_region_decl_value, fns, structs, generics)
                if statement is Stmt.Assign(auto_region_assign_target, auto_region_assign_operator, auto_region_assign_value, auto_region_assign_line):
                    return auto_region_expression_needs_arena(auto_region_assign_target, fns, structs, generics) or auto_region_expression_needs_arena(auto_region_assign_value, fns, structs, generics)
                if statement is Stmt.Block(auto_region_block_kind, auto_region_block_clause, auto_region_block_binding, auto_region_block_body, auto_region_block_line):
                    true return if auto_region_block_kind == "region"
                    true return if auto_region_block_kind == "in" and auto_region_block_clause.count > 0 and auto_region_block_clause[0] != "auto"
                    return auto_region_statements_need_arena(auto_region_block_body, fns, structs, generics)
                if statement is Stmt.If(auto_region_stmt_if_condition, auto_region_stmt_if_then, auto_region_stmt_if_else, auto_region_stmt_if_line):
                    return auto_region_expression_needs_arena(auto_region_stmt_if_condition, fns, structs, generics) or auto_region_statements_need_arena(auto_region_stmt_if_then, fns, structs, generics) or auto_region_statements_need_arena(auto_region_stmt_if_else, fns, structs, generics)
                if statement is Stmt.While(auto_region_stmt_while_condition, auto_region_stmt_while_body, auto_region_stmt_while_line):
                    return auto_region_expression_needs_arena(auto_region_stmt_while_condition, fns, structs, generics) or auto_region_statements_need_arena(auto_region_stmt_while_body, fns, structs, generics)
                if statement is Stmt.For(auto_region_for_bind, auto_region_for_variables, auto_region_for_iterable, auto_region_for_body, auto_region_for_line):
                    return auto_region_expression_needs_arena(auto_region_for_iterable, fns, structs, generics) or auto_region_statements_need_arena(auto_region_for_body, fns, structs, generics)
                if statement is Stmt.Return(auto_region_return_value, auto_region_return_line):
                    if auto_region_return_value is value:
                        return auto_region_expression_needs_arena(value, fns, structs, generics)
                    return false
                if statement is Stmt.Match(auto_region_stmt_match_scrutinee, auto_region_stmt_match_arms, auto_region_stmt_match_line):
                    true return if auto_region_expression_needs_arena(auto_region_stmt_match_scrutinee, fns, structs, generics)
                    for auto_region_stmt_match_arm in auto_region_stmt_match_arms |fns, structs, generics|:
                        true return if auto_region_expression_needs_arena(auto_region_stmt_match_arm.guard, fns, structs, generics)
                        true return if auto_region_statements_need_arena(auto_region_stmt_match_arm.body, fns, structs, generics)
                    return false
                if statement is Stmt.Contract(auto_region_contract_kind, auto_region_contract_expression, auto_region_contract_line):
                    return auto_region_expression_needs_arena(auto_region_contract_expression, fns, structs, generics)
                return false


        def auto_region_statements_need_arena(statements: darray[Stmt], fns: FnTable&, structs: mutable StructTable&, generics: GenericTable&) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                for auto_region_statement in statements |fns, structs, generics|:
                    true return if auto_region_statement_needs_arena(auto_region_statement, fns, structs, generics)
                return false
