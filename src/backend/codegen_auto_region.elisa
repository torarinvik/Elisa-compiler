# Stage1 backend — conservative AUTO-region demand analysis.
#
# The function emitter must not manufacture an arena for a scalar-only body: doing so
# creates an otherwise-unused `arena_free` reference in the object and makes a program
# depend on the runtime merely because it returns an integer. Conversely, a body that
# constructs a growable value must have a real carrier before its emitters run. This
# syntactic pass is deliberately conservative: a false positive costs a lazy carrier,
# while a false negative would put a container allocation on a null or caller-owned
# region. Signature threading remains the ABI authority; this pass only decides whether
# a function with no threaded arena needs a local carrier for its body.

extend Backend:
    private:
        def auto_region_function_needs_arena(fns: FnTable&, name: sview) -> bool can[Abort.Panic]:
            for index in 0..<fns.names.count |fns, name|:
                true return if fns.names[index] == name and fns.needs_arena[index]
            return false


        def auto_region_callee_name(callee: Expr) -> sview can[Abort.Panic]:
            if callee is Expr.Ident(auto_region_ident_name, auto_region_ident_line):
                return auto_region_ident_name
            if callee is Expr.Field(auto_region_field_object, auto_region_field_name, auto_region_field_line):
                return auto_region_field_name
            if callee is Expr.Scope(auto_region_scope_base, auto_region_scope_name, auto_region_scope_line):
                return auto_region_scope_name
            return ""


        # The value-type table is intentionally conservative while declarations are being
        # registered.  That used to make a local `mutable darray[sview] = []` disappear from
        # the auto-region scan in the self-hosted backend even though its declaration and its
        # later `push` calls plainly allocate.  Stage0's region inference keys this decision on
        # the source annotation, so keep the backend scan equally structural: unwrap the
        # mutability/parenthesis shells and inspect the generic head directly.
        def auto_region_growable_type_head(type_expression: Expr) -> sview can[Abort.Panic]:
            if type_expression is Expr.Unary(auto_region_type_operator, auto_region_type_operand, auto_region_type_line):
                return auto_region_growable_type_head(auto_region_type_operand) if auto_region_type_operator == TokenKind.Mutable else ""
            if type_expression is Expr.Paren(auto_region_type_inner, auto_region_type_paren_line):
                return auto_region_growable_type_head(auto_region_type_inner)
            if type_expression is Expr.Index(auto_region_type_head, auto_region_type_argument, auto_region_type_index_line):
                if auto_region_type_head is Expr.Ident(auto_region_type_name, auto_region_type_name_line):
                    return auto_region_type_name
            if type_expression is Expr.IndexN(auto_region_type_head_n, auto_region_type_arguments, auto_region_type_indexn_line):
                if auto_region_type_head_n is Expr.Ident(auto_region_type_name_n, auto_region_type_name_line_n):
                    return auto_region_type_name_n
            return ""


        # Runtime entry points and mutating container methods whose call itself can create
        # backing storage. A direct known function with a threaded arena is covered below;
        # these names cover methods and declarations synthesized outside FnTable.
        def auto_region_call_allocates(callee: Expr, fns: FnTable&) -> bool can[Abort.Panic]:
            can Abort.Panic:
                call_name: sview = auto_region_callee_name(callee)
                true return if auto_region_function_needs_arena(fns, call_name)
                # Explicit allocator entry points consume a caller-supplied arena (or the
                # permanent allocator for f-strings); they do not need a fresh local carrier.
                # Treating them as local-region demand made helpers such as `ctx_aos_store_new`
                # manufacture a zeroed arena and later pass it to `arena_free`, diverging from
                # stage0 and crashing at the first allocation.
                # `clone[T](x)` is a type-application callee, not a bare name or method. Its
                # aggregate/error-union paths allocate destination storage even when the
                # source itself is scalar, so it must keep the caller's carrier live.
                if callee is Expr.Index(auto_region_clone_head, auto_region_clone_type, auto_region_clone_line):
                    true return if auto_region_clone_head is Expr.Ident(auto_region_clone_name, auto_region_clone_name_line) and auto_region_clone_name == "clone"
                if callee is Expr.IndexN(auto_region_clone_head_n, auto_region_clone_types, auto_region_clone_line_n):
                    true return if auto_region_clone_head_n is Expr.Ident(auto_region_clone_name_n, auto_region_clone_name_line_n) and auto_region_clone_name_n == "clone"
                # These are METHOD names, not global function names: a perfectly ordinary
                # scalar helper may be called `add` or `clone`, and classifying that bare call
                # as a container mutation would recreate the very false positive this pass is
                # meant to remove.
                if callee is Expr.Field(auto_region_method_receiver, auto_region_method_name, auto_region_method_line):
                    true return if auto_region_method_name == "push" or auto_region_method_name == "extend" or auto_region_method_name == "reserve"
                    true return if auto_region_method_name == "resize" or auto_region_method_name == "truncate" or auto_region_method_name == "insert"
                    true return if auto_region_method_name == "put" or auto_region_method_name == "add" or auto_region_method_name == "append"
                    true return if auto_region_method_name == "clone" or auto_region_method_name == "materialize"
                return false


        # A call can require the compiler AST store even when the AST constructor is hidden in
        # the callee. Follow the same FnTable fact used by the ordinary region scan, but only
        # for parser/backend helpers or functions whose return type reaches the AST hierarchy.
        def auto_region_call_needs_packed_store(callee: Expr, fns: FnTable&, structs: mutable StructTable&) -> bool can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic, Memory.Allocate:
                # A field call is a method dispatch. Its bare method name is not enough to
                # identify a store-bearing module member because unrelated modules can reuse
                # names such as `current_char`; for field calls use the return-type evidence
                # below, while bare and qualified calls may use the owning compiler module.
                field_call: mutable bool = false
                if callee is Expr.Field(auto_region_method_receiver, auto_region_method_name, auto_region_method_line):
                    field_call <- true
                call_name: sview = auto_region_callee_name(callee)
                return false if call_name == ""
                for index in 0..<fns.names.count |fns, structs, call_name|:
                    continue if fns.names[index] != call_name or not fns.needs_store[index]
                    true return if not field_call and (fns.owners[index] == "Parser" or fns.owners[index] == "Backend")
                    true return if type_is_or_contains_packed_ast(fns.returns[index], 0, structs)
                return false

        # A bare `new E.V(...)` is represented by the parser as an ordinary constructor call
        # after the allocation marker is recorded in its line side table. For a recursive or
        # explicitly packed enum, that allocation is backed by an implicit store in the
        # function's inferred region. It is not a call to a named helper, so the generic call
        # facts above cannot discover the allocation by looking only at `fns`.
        def auto_region_packed_constructor_root(callee: Expr, structs: mutable StructTable&) -> i64 can[Abort.Panic]:
            can Abort.Panic:
                if callee is Expr.Field(auto_region_packed_head, auto_region_packed_variant, auto_region_packed_line):
                    enum_name: sview = packed_constructor_enum_name(auto_region_packed_head)
                    enum_index: i64 = packed_index_of(structs, enum_name)
                    if enum_index >= 0 and packed_variant_local_index(structs, enum_index, auto_region_packed_variant) >= 0:
                        return packed_root_index_of(structs, enum_index)
                return -1


        def auto_region_expression_packed_store_root(expression: Expr, fns: FnTable&, structs: mutable StructTable&) -> i64 can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic, Memory.Allocate:
                direct_constructor_root: i64 = auto_region_packed_constructor_root(expression, structs)
                return direct_constructor_root if direct_constructor_root >= 0
                if expression is Expr.Call(auto_region_root_call_callee, auto_region_root_call_args, auto_region_root_call_names, auto_region_root_call_line):
                    direct_root: i64 = auto_region_packed_constructor_root(auto_region_root_call_callee, structs)
                    return direct_root if direct_root >= 0
                    return packed_index_of(structs, "Node") if auto_region_call_needs_packed_store(auto_region_root_call_callee, fns, structs)
                    nested_root: mutable i64 = auto_region_expression_packed_store_root(auto_region_root_call_callee, fns, structs)
                    return nested_root if nested_root >= 0
                    for root_argument in auto_region_root_call_args |fns, structs|:
                        nested_root <- auto_region_expression_packed_store_root(root_argument, fns, structs)
                        return nested_root if nested_root >= 0
                    return -1
                if expression is Expr.RegionNew(auto_region_root_new_operand, auto_region_root_new_region, auto_region_root_new_line):
                    return auto_region_expression_packed_store_root(auto_region_root_new_operand, fns, structs)
                if expression is Expr.Block(auto_region_root_block_statements, auto_region_root_block_value, auto_region_root_block_captures, auto_region_root_block_line):
                    nested_root: mutable i64 = auto_region_statements_packed_store_root(auto_region_root_block_statements, fns, structs)
                    return nested_root if nested_root >= 0
                    return auto_region_expression_packed_store_root(auto_region_root_block_value, fns, structs)
                if expression is Expr.If(auto_region_root_if_condition, auto_region_root_if_then, auto_region_root_if_else, auto_region_root_if_line):
                    nested_root: mutable i64 = auto_region_expression_packed_store_root(auto_region_root_if_condition, fns, structs)
                    nested_root <- auto_region_expression_packed_store_root(auto_region_root_if_then, fns, structs) if nested_root < 0
                    nested_root <- auto_region_expression_packed_store_root(auto_region_root_if_else, fns, structs) if nested_root < 0
                    return nested_root
                if expression is Expr.Binary(auto_region_root_binary_left, auto_region_root_binary_operator, auto_region_root_binary_right, auto_region_root_binary_line):
                    nested_root: mutable i64 = auto_region_expression_packed_store_root(auto_region_root_binary_left, fns, structs)
                    nested_root <- auto_region_expression_packed_store_root(auto_region_root_binary_right, fns, structs) if nested_root < 0
                    return nested_root
                if expression is Expr.Unary(auto_region_root_unary_operator, auto_region_root_unary_operand, auto_region_root_unary_line):
                    return auto_region_expression_packed_store_root(auto_region_root_unary_operand, fns, structs)
                if expression is Expr.Move(auto_region_root_move_operand, auto_region_root_move_line):
                    return auto_region_expression_packed_store_root(auto_region_root_move_operand, fns, structs)
                if expression is Expr.Paren(auto_region_root_paren_operand, auto_region_root_paren_line):
                    return auto_region_expression_packed_store_root(auto_region_root_paren_operand, fns, structs)
                if expression is Expr.Index(auto_region_root_index_object, auto_region_root_index_index, auto_region_root_index_line):
                    nested_root: mutable i64 = auto_region_expression_packed_store_root(auto_region_root_index_object, fns, structs)
                    nested_root <- auto_region_expression_packed_store_root(auto_region_root_index_index, fns, structs) if nested_root < 0
                    return nested_root
                if expression is Expr.IndexN(auto_region_root_indexn_object, auto_region_root_indexn_args, auto_region_root_indexn_line):
                    nested_root: mutable i64 = auto_region_expression_packed_store_root(auto_region_root_indexn_object, fns, structs)
                    for root_argument in auto_region_root_indexn_args |nested_root, fns, structs|:
                        nested_root <- auto_region_expression_packed_store_root(root_argument, fns, structs) if nested_root < 0
                    return nested_root
                if expression is Expr.Slice(auto_region_root_slice_object, auto_region_root_slice_low, auto_region_root_slice_high, auto_region_root_slice_line):
                    nested_root: mutable i64 = auto_region_expression_packed_store_root(auto_region_root_slice_object, fns, structs)
                    nested_root <- auto_region_expression_packed_store_root(auto_region_root_slice_low, fns, structs) if nested_root < 0
                    nested_root <- auto_region_expression_packed_store_root(auto_region_root_slice_high, fns, structs) if nested_root < 0
                    return nested_root
                if expression is Expr.Field(auto_region_root_field_object, auto_region_root_field_name, auto_region_root_field_line):
                    return auto_region_expression_packed_store_root(auto_region_root_field_object, fns, structs)
                if expression is Expr.Scope(auto_region_root_scope_object, auto_region_root_scope_name, auto_region_root_scope_line):
                    return auto_region_expression_packed_store_root(auto_region_root_scope_object, fns, structs)
                if expression is Expr.Tuple(auto_region_root_tuple_elements, auto_region_root_tuple_line):
                    for root_element in auto_region_root_tuple_elements |fns, structs|:
                        nested_root: mutable i64 = auto_region_expression_packed_store_root(root_element, fns, structs)
                        return nested_root if nested_root >= 0
                    return -1
                if expression is Expr.Construct(auto_region_root_construct_type, auto_region_root_construct_fields, auto_region_root_construct_line):
                    nested_root: mutable i64 = auto_region_expression_packed_store_root(auto_region_root_construct_type, fns, structs)
                    for root_field in auto_region_root_construct_fields |nested_root, fns, structs|:
                        nested_root <- auto_region_expression_packed_store_root(root_field.value, fns, structs) if nested_root < 0
                    return nested_root
                if expression is Expr.RecordUpdate(auto_region_root_update_base, auto_region_root_update_fields, auto_region_root_update_line):
                    nested_root: mutable i64 = auto_region_expression_packed_store_root(auto_region_root_update_base, fns, structs)
                    for root_field in auto_region_root_update_fields |nested_root, fns, structs|:
                        nested_root <- auto_region_expression_packed_store_root(root_field.value, fns, structs) if nested_root < 0
                    return nested_root
                if expression is Expr.Match(auto_region_root_match_scrutinee, auto_region_root_match_arms, auto_region_root_match_line):
                    nested_root: mutable i64 = auto_region_expression_packed_store_root(auto_region_root_match_scrutinee, fns, structs)
                    for root_arm in auto_region_root_match_arms |nested_root, fns, structs|:
                        nested_root <- auto_region_expression_packed_store_root(root_arm.guard, fns, structs) if nested_root < 0
                        nested_root <- auto_region_statements_packed_store_root(root_arm.body, fns, structs) if nested_root < 0
                    return nested_root
                if expression is Expr.Catch(auto_region_root_catch_scrutinee, auto_region_root_catch_arms, auto_region_root_catch_line):
                    nested_root: mutable i64 = auto_region_expression_packed_store_root(auto_region_root_catch_scrutinee, fns, structs)
                    for root_arm in auto_region_root_catch_arms |nested_root, fns, structs|:
                        nested_root <- auto_region_expression_packed_store_root(root_arm.guard, fns, structs) if nested_root < 0
                        nested_root <- auto_region_statements_packed_store_root(root_arm.body, fns, structs) if nested_root < 0
                    return nested_root
                if expression is Expr.Refinement(auto_region_root_refinement_base, auto_region_root_refinement_predicate, auto_region_root_refinement_line):
                    nested_root: mutable i64 = auto_region_expression_packed_store_root(auto_region_root_refinement_base, fns, structs)
                    nested_root <- auto_region_expression_packed_store_root(auto_region_root_refinement_predicate, fns, structs) if nested_root < 0
                    return nested_root
                if expression is Expr.GetElse(auto_region_root_get_guarded, auto_region_root_get_recovery, auto_region_root_get_line):
                    nested_root: mutable i64 = auto_region_expression_packed_store_root(auto_region_root_get_guarded, fns, structs)
                    nested_root <- auto_region_statements_packed_store_root(auto_region_root_get_recovery, fns, structs) if nested_root < 0
                    return nested_root
                if expression is Expr.Comprehension(auto_region_root_comp_var, auto_region_root_comp_iterable, auto_region_root_comp_condition, auto_region_root_comp_body, auto_region_root_comp_line):
                    nested_root: mutable i64 = auto_region_expression_packed_store_root(auto_region_root_comp_iterable, fns, structs)
                    nested_root <- auto_region_expression_packed_store_root(auto_region_root_comp_condition, fns, structs) if nested_root < 0
                    nested_root <- auto_region_expression_packed_store_root(auto_region_root_comp_body, fns, structs) if nested_root < 0 and auto_region_root_comp_body is not Expr.Absent
                    return nested_root
                return -1


        def auto_region_statement_packed_store_root(statement: Stmt, fns: FnTable&, structs: mutable StructTable&) -> i64 can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic, Memory.Allocate:
                if statement is Stmt.Expr(auto_region_root_stmt_expression, auto_region_root_stmt_line):
                    return auto_region_expression_packed_store_root(auto_region_root_stmt_expression, fns, structs)
                if statement is Stmt.VarDecl(auto_region_root_decl_name, auto_region_root_decl_type, auto_region_root_decl_value, auto_region_root_decl_line):
                    # A local aggregate can carry the AST hierarchy even when its initializer is
                    # an ordinary helper call.  `file: Ast::File = parse(...)` is the important
                    # shape: the constructor is inside the callee, so expression-only scanning
                    # misses the store root and the caller later declines while trying to pass a
                    # store-less null value.  Stage0 derives this from the declared type.  Keep
                    # the same fact here so test/driver entry points can create one local store
                    # and thread it through parser helpers without adding an ABI parameter to
                    # the entry point itself.
                    declared_type: ValueType = annotation_value_type(auto_region_root_decl_type, structs)
                    if type_is_or_contains_packed_ast(declared_type, 0, structs):
                        return packed_index_of(structs, "Node")
                    return auto_region_expression_packed_store_root(auto_region_root_decl_value, fns, structs)
                if statement is Stmt.Assign(auto_region_root_assign_target, auto_region_root_assign_operator, auto_region_root_assign_value, auto_region_root_assign_line):
                    nested_root: mutable i64 = auto_region_expression_packed_store_root(auto_region_root_assign_target, fns, structs)
                    nested_root <- auto_region_expression_packed_store_root(auto_region_root_assign_value, fns, structs) if nested_root < 0
                    return nested_root
                if statement is Stmt.Block(auto_region_root_stmt_block_kind, auto_region_root_stmt_block_clause, auto_region_root_stmt_block_binding, auto_region_root_stmt_block_body, auto_region_root_stmt_block_line):
                    return auto_region_statements_packed_store_root(auto_region_root_stmt_block_body, fns, structs)
                if statement is Stmt.If(auto_region_root_stmt_if_condition, auto_region_root_stmt_if_then, auto_region_root_stmt_if_else, auto_region_root_stmt_if_line):
                    nested_root: mutable i64 = auto_region_expression_packed_store_root(auto_region_root_stmt_if_condition, fns, structs)
                    nested_root <- auto_region_statements_packed_store_root(auto_region_root_stmt_if_then, fns, structs) if nested_root < 0
                    nested_root <- auto_region_statements_packed_store_root(auto_region_root_stmt_if_else, fns, structs) if nested_root < 0
                    return nested_root
                if statement is Stmt.While(auto_region_root_stmt_while_condition, auto_region_root_stmt_while_body, auto_region_root_stmt_while_line):
                    nested_root: mutable i64 = auto_region_expression_packed_store_root(auto_region_root_stmt_while_condition, fns, structs)
                    nested_root <- auto_region_statements_packed_store_root(auto_region_root_stmt_while_body, fns, structs) if nested_root < 0
                    return nested_root
                if statement is Stmt.For(auto_region_root_for_bind, auto_region_root_for_variables, auto_region_root_for_iterable, auto_region_root_for_body, auto_region_root_for_line):
                    nested_root: mutable i64 = auto_region_expression_packed_store_root(auto_region_root_for_iterable, fns, structs)
                    nested_root <- auto_region_statements_packed_store_root(auto_region_root_for_body, fns, structs) if nested_root < 0
                    return nested_root
                if statement is Stmt.Return(auto_region_root_return_value, auto_region_root_return_line):
                    if auto_region_root_return_value is value:
                        return auto_region_expression_packed_store_root(value, fns, structs)
                    return -1
                if statement is Stmt.Match(auto_region_root_stmt_match_scrutinee, auto_region_root_stmt_match_arms, auto_region_root_stmt_match_line):
                    nested_root: mutable i64 = auto_region_expression_packed_store_root(auto_region_root_stmt_match_scrutinee, fns, structs)
                    for root_arm in auto_region_root_stmt_match_arms |nested_root, fns, structs|:
                        nested_root <- auto_region_expression_packed_store_root(root_arm.guard, fns, structs) if nested_root < 0
                        nested_root <- auto_region_statements_packed_store_root(root_arm.body, fns, structs) if nested_root < 0
                    return nested_root
                if statement is Stmt.Contract(auto_region_root_contract_kind, auto_region_root_contract_expression, auto_region_root_contract_line):
                    return auto_region_expression_packed_store_root(auto_region_root_contract_expression, fns, structs)
                return -1


        def auto_region_statements_packed_store_root(statements: darray[Stmt], fns: FnTable&, structs: mutable StructTable&) -> i64 can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic, Memory.Allocate:
                for root_statement in statements |fns, structs|:
                    nested_root: mutable i64 = auto_region_statement_packed_store_root(root_statement, fns, structs)
                    return nested_root if nested_root >= 0
                return -1


        def auto_region_expression_needs_arena(expression: Expr, fns: FnTable&, structs: mutable StructTable&, generics: GenericTable&) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                true return if auto_region_packed_constructor_root(expression, structs) >= 0
                if expression is Expr.Call(auto_region_call_callee, auto_region_call_args, auto_region_call_names, auto_region_call_line):
                    true return if auto_region_packed_constructor_root(auto_region_call_callee, structs) >= 0
                    true return if auto_region_call_allocates(auto_region_call_callee, fns)
                    true return if auto_region_expression_needs_arena(auto_region_call_callee, fns, structs, generics)
                    for auto_region_call_arg in auto_region_call_args |fns, structs, generics|:
                        true return if auto_region_expression_needs_arena(auto_region_call_arg, fns, structs, generics)
                    return false
                if expression is Expr.RegionNew(auto_region_new_operand, auto_region_new_region, auto_region_new_line):
                    return true
                if expression is Expr.Array(auto_region_array_elements, auto_region_array_line):
                    # The expected type distinguishes fixed arrays from darrays only at
                    # emission time. Keeping this conservative protects an untyped literal
                    # and only adds a lazy carrier for fixed-array bodies.
                    return true
                if expression is Expr.SetLit(auto_region_set_elements, auto_region_set_line):
                    return true
                if expression is Expr.DictLit(auto_region_dict_entries, auto_region_dict_line):
                    return true
                if expression is Expr.Comprehension(auto_region_comp_var, auto_region_comp_iterable, auto_region_comp_condition, auto_region_comp_body, auto_region_comp_line):
                    true return if auto_region_expression_needs_arena(auto_region_comp_iterable, fns, structs, generics)
                    true return if auto_region_expression_needs_arena(auto_region_comp_condition, fns, structs, generics)
                    return auto_region_comp_body is not Expr.Absent or auto_region_expression_needs_arena(auto_region_comp_body, fns, structs, generics)
                if expression is Expr.Block(auto_region_block_statements, auto_region_block_value, auto_region_block_captures, auto_region_block_line):
                    true return if auto_region_statements_need_arena(auto_region_block_statements, fns, structs, generics)
                    return auto_region_expression_needs_arena(auto_region_block_value, fns, structs, generics)
                if expression is Expr.Lambda(auto_region_lambda_params, auto_region_lambda_body, auto_region_lambda_line):
                    # The lambda is emitted as its own function. Its carrier decision is
                    # made when that body is emitted, not on the enclosing function.
                    return false
                if expression is Expr.Binary(auto_region_binary_left, auto_region_binary_operator, auto_region_binary_right, auto_region_binary_line):
                    return auto_region_expression_needs_arena(auto_region_binary_left, fns, structs, generics) or auto_region_expression_needs_arena(auto_region_binary_right, fns, structs, generics)
                if expression is Expr.Unary(auto_region_unary_operator, auto_region_unary_operand, auto_region_unary_line):
                    return auto_region_expression_needs_arena(auto_region_unary_operand, fns, structs, generics)
                if expression is Expr.Move(auto_region_move_operand, auto_region_move_line):
                    return auto_region_expression_needs_arena(auto_region_move_operand, fns, structs, generics)
                if expression is Expr.Paren(auto_region_paren_inner, auto_region_paren_line):
                    return auto_region_expression_needs_arena(auto_region_paren_inner, fns, structs, generics)
                if expression is Expr.Index(auto_region_index_object, auto_region_index_index, auto_region_index_line):
                    return auto_region_expression_needs_arena(auto_region_index_object, fns, structs, generics) or auto_region_expression_needs_arena(auto_region_index_index, fns, structs, generics)
                if expression is Expr.IndexN(auto_region_indexn_object, auto_region_indexn_args, auto_region_indexn_line):
                    true return if auto_region_expression_needs_arena(auto_region_indexn_object, fns, structs, generics)
                    for auto_region_indexn_arg in auto_region_indexn_args |fns, structs, generics|:
                        true return if auto_region_expression_needs_arena(auto_region_indexn_arg, fns, structs, generics)
                    return false
                if expression is Expr.Slice(auto_region_slice_object, auto_region_slice_low, auto_region_slice_high, auto_region_slice_line):
                    return auto_region_expression_needs_arena(auto_region_slice_object, fns, structs, generics) or auto_region_expression_needs_arena(auto_region_slice_low, fns, structs, generics) or auto_region_expression_needs_arena(auto_region_slice_high, fns, structs, generics)
                if expression is Expr.Field(auto_region_field_object2, auto_region_field_name2, auto_region_field_line2):
                    return auto_region_expression_needs_arena(auto_region_field_object2, fns, structs, generics)
                if expression is Expr.Scope(auto_region_scope_base2, auto_region_scope_name2, auto_region_scope_line2):
                    return auto_region_expression_needs_arena(auto_region_scope_base2, fns, structs, generics)
                if expression is Expr.Tuple(auto_region_tuple_elements, auto_region_tuple_line):
                    for auto_region_tuple_element in auto_region_tuple_elements |fns, structs, generics|:
                        true return if auto_region_expression_needs_arena(auto_region_tuple_element, fns, structs, generics)
                    return false
                if expression is Expr.Construct(auto_region_construct_type, auto_region_construct_fields, auto_region_construct_line):
                    true return if auto_region_expression_needs_arena(auto_region_construct_type, fns, structs, generics)
                    for auto_region_construct_field in auto_region_construct_fields |fns, structs, generics|:
                        true return if auto_region_expression_needs_arena(auto_region_construct_field.value, fns, structs, generics)
                    return false
                if expression is Expr.RecordUpdate(auto_region_update_base, auto_region_update_fields, auto_region_update_line):
                    true return if auto_region_expression_needs_arena(auto_region_update_base, fns, structs, generics)
                    for auto_region_update_field in auto_region_update_fields |fns, structs, generics|:
                        true return if auto_region_expression_needs_arena(auto_region_update_field.value, fns, structs, generics)
                    return false
                if expression is Expr.If(auto_region_if_condition, auto_region_if_then, auto_region_if_else, auto_region_if_line):
                    return auto_region_expression_needs_arena(auto_region_if_condition, fns, structs, generics) or auto_region_expression_needs_arena(auto_region_if_then, fns, structs, generics) or auto_region_expression_needs_arena(auto_region_if_else, fns, structs, generics)
                if expression is Expr.Match(auto_region_match_scrutinee, auto_region_match_arms, auto_region_match_line) or expression is Expr.Catch(auto_region_match_scrutinee, auto_region_match_arms, auto_region_match_line):
                    true return if auto_region_expression_needs_arena(auto_region_match_scrutinee, fns, structs, generics)
                    for auto_region_match_arm in auto_region_match_arms |fns, structs, generics|:
                        true return if auto_region_expression_needs_arena(auto_region_match_arm.guard, fns, structs, generics)
                        true return if auto_region_statements_need_arena(auto_region_match_arm.body, fns, structs, generics)
                    return false
                if expression is Expr.Refinement(auto_region_refinement_base, auto_region_refinement_predicate, auto_region_refinement_line):
                    return auto_region_expression_needs_arena(auto_region_refinement_base, fns, structs, generics) or auto_region_expression_needs_arena(auto_region_refinement_predicate, fns, structs, generics)
                if expression is Expr.GetElse(auto_region_get_guarded, auto_region_get_recovery, auto_region_get_line):
                    true return if auto_region_expression_needs_arena(auto_region_get_guarded, fns, structs, generics)
                    return auto_region_statements_need_arena(auto_region_get_recovery, fns, structs, generics)
                return false


        # Add a name once to an escape set. These names are views into the source buffer, so the
        # linear scan is both cheaper and safer than manufacturing a temporary dictionary for a
        # small function-local set.
        def auto_region_append_escape_name(names: mutable darray[sview]&, name: sview) -> void can[Abort.Panic, Memory.Allocate]:
            return if name == ""
            for existing_name in names |names, name|:
                return if existing_name == name
            names <- names.push(name)


        # The escape walk needs just enough type information to distinguish `chunk[index]` (which
        # passes one scalar byte) from `items[index]` where the element itself contains a darray.
        # Unknown locals stay conservative and are treated as escaping.
        def auto_region_collect_local_decl_types(statement_list: darray[Stmt], names: mutable darray[sview]&, types: mutable darray[ValueType]&, structs: mutable StructTable&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            for auto_escape_decl_statement in statement_list |names, types, structs|:
                match auto_escape_decl_statement:
                    Stmt.VarDecl(auto_escape_decl_type_name, auto_escape_decl_type_expr, auto_escape_decl_value, auto_escape_decl_type_line):
                        names <- names.push(auto_escape_decl_type_name)
                        types <- types.push(annotation_value_type(auto_escape_decl_type_expr, structs))
                    Stmt.Block(auto_escape_decl_block_kind, auto_escape_decl_block_clause, auto_escape_decl_block_binding, auto_escape_decl_block_body, auto_escape_decl_block_line):
                        auto_region_collect_local_decl_types(auto_escape_decl_block_body, names, types, structs)
                    Stmt.If(auto_escape_decl_if_condition, auto_escape_decl_if_then, auto_escape_decl_if_else, auto_escape_decl_if_line):
                        auto_region_collect_local_decl_types(auto_escape_decl_if_then, names, types, structs)
                        auto_region_collect_local_decl_types(auto_escape_decl_if_else, names, types, structs)
                    Stmt.While(auto_escape_decl_while_condition, auto_escape_decl_while_body, auto_escape_decl_while_line):
                        auto_region_collect_local_decl_types(auto_escape_decl_while_body, names, types, structs)
                    Stmt.For(auto_escape_decl_for_bind, auto_escape_decl_for_variables, auto_escape_decl_for_iterable, auto_escape_decl_for_body, auto_escape_decl_for_line):
                        auto_region_collect_local_decl_types(auto_escape_decl_for_body, names, types, structs)
                    Stmt.Match(auto_escape_decl_match_scrutinee, auto_escape_decl_match_arms, auto_escape_decl_match_line):
                        for auto_escape_decl_arm in auto_escape_decl_match_arms |names, types, structs|:
                            auto_region_collect_local_decl_types(auto_escape_decl_arm.body, names, types, structs)
                    _:
                        pass


        def auto_region_local_decl_type(name: sview, names: darray[sview]&, types: darray[ValueType]&) -> ValueType can[Abort.Panic]:
            index: mutable i64 = names.count.i64() - 1
            while index >= 0 |index, name, names, types|:
                return copied_type(types[index.usize()]) if names[index.usize()] == name
                index <- index - 1
            return unmodeled_type()


        def auto_region_type_carries_storage(value_type: ValueType, structs: mutable StructTable&) -> bool can[Abort.Panic, Memory.Allocate]:
            return true if value_type.kind == TypeKind.DArray or value_type.kind == TypeKind.View or value_type.kind == TypeKind.Ref or value_type.kind == TypeKind.PackedEnum
            if value_type.kind == TypeKind.Optional:
                return auto_region_type_carries_storage(optional_payload_of(value_type, structs), structs)
            return is_growable_container_struct(value_type, structs) or (value_type.kind == TypeKind.Struct and struct_contains_darray(value_type, structs))


        def auto_region_call_argument_carries_storage(expression: Expr, local_names: darray[sview]&, local_types: darray[ValueType], structs: mutable StructTable&) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            if expression is Expr.Ident(auto_escape_argument_ident, auto_escape_argument_line):
                return auto_region_type_carries_storage(auto_region_local_decl_type(auto_escape_argument_ident, local_names, local_types), structs)
            if expression is Expr.Field(auto_escape_argument_field_object, auto_escape_argument_field_name, auto_escape_argument_field_line):
                return true
            if expression is Expr.Index(auto_escape_argument_index_object, auto_escape_argument_index_index, auto_escape_argument_index_line):
                indexed_type: mutable ValueType = unmodeled_type()
                if auto_escape_argument_index_object is Expr.Ident(auto_escape_index_base_name, auto_escape_index_base_line):
                    indexed_type <- auto_region_local_decl_type(auto_escape_index_base_name, local_names, local_types)
                return true if indexed_type.kind == TypeKind.Unmodeled
                if indexed_type.kind == TypeKind.DArray:
                    return auto_region_type_carries_storage(darray_element_of(indexed_type, structs), structs)
                return true
            return true


        # Collect every identifier in an expression. This is used for values that are returned or
        # copied into another value, where even a nested field/index/constructor reference can
        # carry region-backed storage out of the function.
        def auto_region_collect_all_idents(expression: Expr, names: mutable darray[sview]&) -> void can[Abort.Panic, Memory.Allocate]:
            match expression:
                Expr.Ident(auto_escape_ident_name, auto_escape_ident_line):
                    auto_region_append_escape_name(names, auto_escape_ident_name)
                Expr.Call(auto_escape_call_callee, auto_escape_call_args, auto_escape_call_names, auto_escape_call_line):
                    auto_region_collect_all_idents(auto_escape_call_callee, names)
                    for auto_escape_call_arg in auto_escape_call_args |names|:
                        auto_region_collect_all_idents(auto_escape_call_arg, names)
                Expr.RegionNew(auto_escape_new_operand, auto_escape_new_region, auto_escape_new_line):
                    auto_region_collect_all_idents(auto_escape_new_operand, names)
                Expr.Array(auto_escape_array_elements, auto_escape_array_line):
                    for auto_escape_array_element in auto_escape_array_elements |names|:
                        auto_region_collect_all_idents(auto_escape_array_element, names)
                Expr.SetLit(auto_escape_set_elements, auto_escape_set_line):
                    for auto_escape_set_element in auto_escape_set_elements |names|:
                        auto_region_collect_all_idents(auto_escape_set_element, names)
                Expr.DictLit(auto_escape_dict_entries, auto_escape_dict_line):
                    for auto_escape_dict_entry in auto_escape_dict_entries |names|:
                        auto_region_collect_all_idents(auto_escape_dict_entry.key, names)
                        auto_region_collect_all_idents(auto_escape_dict_entry.value, names)
                Expr.Comprehension(auto_escape_comp_var, auto_escape_comp_iterable, auto_escape_comp_condition, auto_escape_comp_body, auto_escape_comp_line):
                    auto_region_collect_all_idents(auto_escape_comp_iterable, names)
                    auto_region_collect_all_idents(auto_escape_comp_condition, names)
                    auto_region_collect_all_idents(auto_escape_comp_body, names)
                Expr.Block(auto_escape_block_statements, auto_escape_block_value, auto_escape_block_captures, auto_escape_block_line):
                    auto_region_collect_all_statement_idents(auto_escape_block_statements, names)
                    auto_region_collect_all_idents(auto_escape_block_value, names)
                Expr.Lambda(auto_escape_lambda_params, auto_escape_lambda_body, auto_escape_lambda_line):
                    auto_region_collect_all_statement_idents(auto_escape_lambda_body, names)
                Expr.Binary(auto_escape_binary_left, auto_escape_binary_operator, auto_escape_binary_right, auto_escape_binary_line):
                    auto_region_collect_all_idents(auto_escape_binary_left, names)
                    auto_region_collect_all_idents(auto_escape_binary_right, names)
                Expr.Unary(auto_escape_unary_operator, auto_escape_unary_operand, auto_escape_unary_line):
                    auto_region_collect_all_idents(auto_escape_unary_operand, names)
                Expr.Move(auto_escape_move_operand, auto_escape_move_line):
                    auto_region_collect_all_idents(auto_escape_move_operand, names)
                Expr.Paren(auto_escape_paren_inner, auto_escape_paren_line):
                    auto_region_collect_all_idents(auto_escape_paren_inner, names)
                Expr.Index(auto_escape_index_object, auto_escape_index_index, auto_escape_index_line):
                    auto_region_collect_all_idents(auto_escape_index_object, names)
                    auto_region_collect_all_idents(auto_escape_index_index, names)
                Expr.IndexN(auto_escape_indexn_object, auto_escape_indexn_args, auto_escape_indexn_line):
                    auto_region_collect_all_idents(auto_escape_indexn_object, names)
                    for auto_escape_indexn_arg in auto_escape_indexn_args |names|:
                        auto_region_collect_all_idents(auto_escape_indexn_arg, names)
                Expr.Slice(auto_escape_slice_object, auto_escape_slice_low, auto_escape_slice_high, auto_escape_slice_line):
                    auto_region_collect_all_idents(auto_escape_slice_object, names)
                    auto_region_collect_all_idents(auto_escape_slice_low, names)
                    auto_region_collect_all_idents(auto_escape_slice_high, names)
                Expr.Field(auto_escape_field_object, auto_escape_field_name, auto_escape_field_line):
                    auto_region_collect_all_idents(auto_escape_field_object, names)
                Expr.Scope(auto_escape_scope_base, auto_escape_scope_name, auto_escape_scope_line):
                    auto_region_collect_all_idents(auto_escape_scope_base, names)
                Expr.Tuple(auto_escape_tuple_elements, auto_escape_tuple_line):
                    for auto_escape_tuple_element in auto_escape_tuple_elements |names|:
                        auto_region_collect_all_idents(auto_escape_tuple_element, names)
                Expr.Construct(auto_escape_construct_type, auto_escape_construct_fields, auto_escape_construct_line):
                    auto_region_collect_all_idents(auto_escape_construct_type, names)
                    for auto_escape_construct_field in auto_escape_construct_fields |names|:
                        auto_region_collect_all_idents(auto_escape_construct_field.value, names)
                Expr.RecordUpdate(auto_escape_update_base, auto_escape_update_fields, auto_escape_update_line):
                    auto_region_collect_all_idents(auto_escape_update_base, names)
                    for auto_escape_update_field in auto_escape_update_fields |names|:
                        auto_region_collect_all_idents(auto_escape_update_field.value, names)
                Expr.If(auto_escape_if_condition, auto_escape_if_then, auto_escape_if_else, auto_escape_if_line):
                    auto_region_collect_all_idents(auto_escape_if_condition, names)
                    auto_region_collect_all_idents(auto_escape_if_then, names)
                    auto_region_collect_all_idents(auto_escape_if_else, names)
                Expr.Match(auto_escape_match_scrutinee, auto_escape_match_arms, auto_escape_match_line):
                    auto_region_collect_all_idents(auto_escape_match_scrutinee, names)
                    for auto_escape_match_arm in auto_escape_match_arms |names|:
                        auto_region_collect_all_idents(auto_escape_match_arm.guard, names)
                        auto_region_collect_all_statement_idents(auto_escape_match_arm.body, names)
                Expr.Catch(auto_escape_catch_scrutinee, auto_escape_catch_arms, auto_escape_catch_line):
                    auto_region_collect_all_idents(auto_escape_catch_scrutinee, names)
                    for auto_escape_catch_arm in auto_escape_catch_arms |names|:
                        auto_region_collect_all_idents(auto_escape_catch_arm.guard, names)
                        auto_region_collect_all_statement_idents(auto_escape_catch_arm.body, names)
                Expr.Refinement(auto_escape_refinement_base, auto_escape_refinement_predicate, auto_escape_refinement_line):
                    auto_region_collect_all_idents(auto_escape_refinement_base, names)
                    auto_region_collect_all_idents(auto_escape_refinement_predicate, names)
                Expr.GetElse(auto_escape_get_guarded, auto_escape_get_recovery, auto_escape_get_line):
                    auto_region_collect_all_idents(auto_escape_get_guarded, names)
                    auto_region_collect_all_statement_idents(auto_escape_get_recovery, names)
                _:
                    pass


        # Find call arguments that can copy a local container header or aggregate containing one
        # into storage that outlives the local. A method receiver is deliberately not collected:
        # `scratch.resize(n)` and `out.push(v)` mutate the receiver in place, while their ordinary
        # arguments are the values that may escape. Unknown/bare calls are handled conservatively.
        def auto_region_collect_escape_calls(expression: Expr, names: mutable darray[sview]&, local_names: darray[sview]&, local_types: darray[ValueType], structs: mutable StructTable&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            match expression:
                Expr.Call(auto_escape_call_callee2, auto_escape_call_args2, auto_escape_call_names2, auto_escape_call_line2):
                    match auto_escape_call_callee2:
                        Expr.Field(auto_escape_method_receiver2, auto_escape_method_name2, auto_escape_method_line2):
                            auto_region_collect_escape_calls(auto_escape_method_receiver2, names, local_names, local_types, structs)
                        Expr.Scope(auto_escape_scope_receiver2, auto_escape_scope_method2, auto_escape_scope_line2):
                            auto_region_collect_escape_calls(auto_escape_scope_receiver2, names, local_names, local_types, structs)
                        _:
                            auto_region_collect_all_idents(auto_escape_call_callee2, names)
                    for auto_escape_argument2 in auto_escape_call_args2 |names, local_names, local_types, structs|:
                        if auto_region_call_argument_carries_storage(auto_escape_argument2, local_names, local_types, structs):
                            auto_region_collect_all_idents(auto_escape_argument2, names)
                        elif auto_escape_argument2 is Expr.Index(auto_escape_scalar_index_object, auto_escape_scalar_index_index, auto_escape_scalar_index_line):
                            auto_region_collect_all_idents(auto_escape_scalar_index_index, names)
                        auto_region_collect_escape_calls(auto_escape_argument2, names, local_names, local_types, structs)
                Expr.RegionNew(auto_escape_new_operand2, auto_escape_new_region2, auto_escape_new_line2):
                    auto_region_collect_escape_calls(auto_escape_new_operand2, names, local_names, local_types, structs)
                Expr.Array(auto_escape_array_elements2, auto_escape_array_line2):
                    for auto_escape_element2 in auto_escape_array_elements2 |names|:
                        auto_region_collect_escape_calls(auto_escape_element2, names, local_names, local_types, structs)
                Expr.SetLit(auto_escape_set_elements2, auto_escape_set_line2):
                    for auto_escape_element2 in auto_escape_set_elements2 |names|:
                        auto_region_collect_escape_calls(auto_escape_element2, names, local_names, local_types, structs)
                Expr.DictLit(auto_escape_dict_entries2, auto_escape_dict_line2):
                    for auto_escape_entry2 in auto_escape_dict_entries2 |names|:
                        auto_region_collect_escape_calls(auto_escape_entry2.key, names, local_names, local_types, structs)
                        auto_region_collect_escape_calls(auto_escape_entry2.value, names, local_names, local_types, structs)
                Expr.Comprehension(auto_escape_comp_var2, auto_escape_comp_iterable2, auto_escape_comp_condition2, auto_escape_comp_body2, auto_escape_comp_line2):
                    auto_region_collect_escape_calls(auto_escape_comp_iterable2, names, local_names, local_types, structs)
                    auto_region_collect_escape_calls(auto_escape_comp_condition2, names, local_names, local_types, structs)
                    auto_region_collect_escape_calls(auto_escape_comp_body2, names, local_names, local_types, structs)
                Expr.Block(auto_escape_block_statements2, auto_escape_block_value2, auto_escape_block_captures2, auto_escape_block_line2):
                    auto_region_collect_escape_statement_calls(auto_escape_block_statements2, names, local_names, local_types, structs)
                    auto_region_collect_escape_calls(auto_escape_block_value2, names, local_names, local_types, structs)
                Expr.Lambda(auto_escape_lambda_params2, auto_escape_lambda_body2, auto_escape_lambda_line2):
                    auto_region_collect_escape_statement_calls(auto_escape_lambda_body2, names, local_names, local_types, structs)
                Expr.Binary(auto_escape_binary_left2, auto_escape_binary_operator2, auto_escape_binary_right2, auto_escape_binary_line2):
                    auto_region_collect_escape_calls(auto_escape_binary_left2, names, local_names, local_types, structs)
                    auto_region_collect_escape_calls(auto_escape_binary_right2, names, local_names, local_types, structs)
                Expr.Unary(auto_escape_unary_operator2, auto_escape_unary_operand2, auto_escape_unary_line2):
                    auto_region_collect_escape_calls(auto_escape_unary_operand2, names, local_names, local_types, structs)
                Expr.Move(auto_escape_move_operand2, auto_escape_move_line2):
                    auto_region_collect_escape_calls(auto_escape_move_operand2, names, local_names, local_types, structs)
                Expr.Paren(auto_escape_paren_inner2, auto_escape_paren_line2):
                    auto_region_collect_escape_calls(auto_escape_paren_inner2, names, local_names, local_types, structs)
                Expr.Index(auto_escape_index_object2, auto_escape_index_index2, auto_escape_index_line2):
                    auto_region_collect_escape_calls(auto_escape_index_object2, names, local_names, local_types, structs)
                    auto_region_collect_escape_calls(auto_escape_index_index2, names, local_names, local_types, structs)
                Expr.IndexN(auto_escape_indexn_object2, auto_escape_indexn_args2, auto_escape_indexn_line2):
                    auto_region_collect_escape_calls(auto_escape_indexn_object2, names, local_names, local_types, structs)
                    for auto_escape_indexn_arg2 in auto_escape_indexn_args2 |names, local_names, local_types, structs|:
                        auto_region_collect_escape_calls(auto_escape_indexn_arg2, names, local_names, local_types, structs)
                Expr.Slice(auto_escape_slice_object2, auto_escape_slice_low2, auto_escape_slice_high2, auto_escape_slice_line2):
                    auto_region_collect_escape_calls(auto_escape_slice_object2, names, local_names, local_types, structs)
                    auto_region_collect_escape_calls(auto_escape_slice_low2, names, local_names, local_types, structs)
                    auto_region_collect_escape_calls(auto_escape_slice_high2, names, local_names, local_types, structs)
                Expr.Field(auto_escape_field_object2, auto_escape_field_name2, auto_escape_field_line2):
                    auto_region_collect_escape_calls(auto_escape_field_object2, names, local_names, local_types, structs)
                Expr.Scope(auto_escape_scope_base2, auto_escape_scope_name2, auto_escape_scope_line2):
                    auto_region_collect_escape_calls(auto_escape_scope_base2, names, local_names, local_types, structs)
                Expr.Tuple(auto_escape_tuple_elements2, auto_escape_tuple_line2):
                    for auto_escape_tuple_element2 in auto_escape_tuple_elements2 |names|:
                        auto_region_collect_escape_calls(auto_escape_tuple_element2, names, local_names, local_types, structs)
                Expr.Construct(auto_escape_construct_type2, auto_escape_construct_fields2, auto_escape_construct_line2):
                    auto_region_collect_escape_calls(auto_escape_construct_type2, names, local_names, local_types, structs)
                    for auto_escape_field2 in auto_escape_construct_fields2 |names|:
                        auto_region_collect_escape_calls(auto_escape_field2.value, names, local_names, local_types, structs)
                Expr.RecordUpdate(auto_escape_update_base2, auto_escape_update_fields2, auto_escape_update_line2):
                    auto_region_collect_escape_calls(auto_escape_update_base2, names, local_names, local_types, structs)
                    for auto_escape_field2 in auto_escape_update_fields2 |names|:
                        auto_region_collect_escape_calls(auto_escape_field2.value, names, local_names, local_types, structs)
                Expr.If(auto_escape_if_condition2, auto_escape_if_then2, auto_escape_if_else2, auto_escape_if_line2):
                    auto_region_collect_escape_calls(auto_escape_if_condition2, names, local_names, local_types, structs)
                    auto_region_collect_escape_calls(auto_escape_if_then2, names, local_names, local_types, structs)
                    auto_region_collect_escape_calls(auto_escape_if_else2, names, local_names, local_types, structs)
                Expr.Match(auto_escape_match_scrutinee2, auto_escape_match_arms2, auto_escape_match_line2):
                    auto_region_collect_escape_calls(auto_escape_match_scrutinee2, names, local_names, local_types, structs)
                    for auto_escape_arm2 in auto_escape_match_arms2 |names, local_names, local_types, structs|:
                        auto_region_collect_escape_calls(auto_escape_arm2.guard, names, local_names, local_types, structs)
                        auto_region_collect_escape_statement_calls(auto_escape_arm2.body, names, local_names, local_types, structs)
                Expr.Catch(auto_escape_catch_scrutinee2, auto_escape_catch_arms2, auto_escape_catch_line2):
                    auto_region_collect_escape_calls(auto_escape_catch_scrutinee2, names, local_names, local_types, structs)
                    for auto_escape_arm2 in auto_escape_catch_arms2 |names, local_names, local_types, structs|:
                        auto_region_collect_escape_calls(auto_escape_arm2.guard, names, local_names, local_types, structs)
                        auto_region_collect_escape_statement_calls(auto_escape_arm2.body, names, local_names, local_types, structs)
                Expr.Refinement(auto_escape_refinement_base2, auto_escape_refinement_predicate2, auto_escape_refinement_line2):
                    auto_region_collect_escape_calls(auto_escape_refinement_base2, names, local_names, local_types, structs)
                    auto_region_collect_escape_calls(auto_escape_refinement_predicate2, names, local_names, local_types, structs)
                Expr.GetElse(auto_escape_get_guarded2, auto_escape_get_recovery2, auto_escape_get_line2):
                    auto_region_collect_escape_calls(auto_escape_get_guarded2, names, local_names, local_types, structs)
                    auto_region_collect_escape_statement_calls(auto_escape_get_recovery2, names, local_names, local_types, structs)
                _:
                    pass


        def auto_region_collect_all_statement_idents(statement_list: darray[Stmt], names: mutable darray[sview]&) -> void can[Abort.Panic, Memory.Allocate]:
            for auto_escape_statement in statement_list |names|:
                match auto_escape_statement:
                    Stmt.Expr(auto_escape_statement_expression, auto_escape_statement_line):
                        auto_region_collect_all_idents(auto_escape_statement_expression, names)
                    Stmt.VarDecl(auto_escape_decl_name, auto_escape_decl_type, auto_escape_decl_value, auto_escape_decl_line):
                        auto_region_collect_all_idents(auto_escape_decl_value, names)
                    Stmt.Assign(auto_escape_assign_target, auto_escape_assign_operator, auto_escape_assign_value, auto_escape_assign_line):
                        auto_region_collect_all_idents(auto_escape_assign_target, names)
                        auto_region_collect_all_idents(auto_escape_assign_value, names)
                    Stmt.Block(auto_escape_block_kind3, auto_escape_block_clause3, auto_escape_block_binding3, auto_escape_block_body3, auto_escape_block_line3):
                        auto_region_collect_all_statement_idents(auto_escape_block_body3, names)
                    Stmt.If(auto_escape_if_condition3, auto_escape_if_then3, auto_escape_if_else3, auto_escape_if_line3):
                        auto_region_collect_all_idents(auto_escape_if_condition3, names)
                        auto_region_collect_all_statement_idents(auto_escape_if_then3, names)
                        auto_region_collect_all_statement_idents(auto_escape_if_else3, names)
                    Stmt.While(auto_escape_while_condition3, auto_escape_while_body3, auto_escape_while_line3):
                        auto_region_collect_all_idents(auto_escape_while_condition3, names)
                        auto_region_collect_all_statement_idents(auto_escape_while_body3, names)
                    Stmt.For(auto_escape_for_bind3, auto_escape_for_variables3, auto_escape_for_iterable3, auto_escape_for_body3, auto_escape_for_line3):
                        auto_region_collect_all_idents(auto_escape_for_iterable3, names)
                        auto_region_collect_all_statement_idents(auto_escape_for_body3, names)
                    Stmt.Return(auto_escape_return_value3, auto_escape_return_line3):
                        if auto_escape_return_value3 is auto_escape_return_value3_present:
                            auto_region_collect_all_idents(auto_escape_return_value3_present, names)
                    Stmt.Match(auto_escape_match_scrutinee3, auto_escape_match_arms3, auto_escape_match_line3):
                        auto_region_collect_all_idents(auto_escape_match_scrutinee3, names)
                        for auto_escape_arm3 in auto_escape_match_arms3 |names|:
                            auto_region_collect_all_idents(auto_escape_arm3.guard, names)
                            auto_region_collect_all_statement_idents(auto_escape_arm3.body, names)
                    Stmt.Contract(auto_escape_contract_kind3, auto_escape_contract_expression3, auto_escape_contract_line3):
                        auto_region_collect_all_idents(auto_escape_contract_expression3, names)
                    _:
                        pass


        def auto_region_collect_escape_statement_calls(statement_list: darray[Stmt], names: mutable darray[sview]&, local_names: darray[sview]&, local_types: darray[ValueType], structs: mutable StructTable&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            for auto_escape_statement2 in statement_list |names, local_names, local_types, structs|:
                match auto_escape_statement2:
                    Stmt.Expr(auto_escape_statement_expression2, auto_escape_statement_line2):
                        auto_region_collect_escape_calls(auto_escape_statement_expression2, names, local_names, local_types, structs)
                    Stmt.VarDecl(auto_escape_decl_name2, auto_escape_decl_type2, auto_escape_decl_value2, auto_escape_decl_line2):
                        auto_region_collect_escape_calls(auto_escape_decl_value2, names, local_names, local_types, structs)
                    Stmt.Assign(auto_escape_assign_target2, auto_escape_assign_operator2, auto_escape_assign_value2, auto_escape_assign_line2):
                        auto_region_collect_escape_calls(auto_escape_assign_target2, names, local_names, local_types, structs)
                        auto_region_collect_escape_calls(auto_escape_assign_value2, names, local_names, local_types, structs)
                    Stmt.Block(auto_escape_block_kind4, auto_escape_block_clause4, auto_escape_block_binding4, auto_escape_block_body4, auto_escape_block_line4):
                        auto_region_collect_escape_statement_calls(auto_escape_block_body4, names, local_names, local_types, structs)
                    Stmt.If(auto_escape_if_condition4, auto_escape_if_then4, auto_escape_if_else4, auto_escape_if_line4):
                        auto_region_collect_escape_calls(auto_escape_if_condition4, names, local_names, local_types, structs)
                        auto_region_collect_escape_statement_calls(auto_escape_if_then4, names, local_names, local_types, structs)
                        auto_region_collect_escape_statement_calls(auto_escape_if_else4, names, local_names, local_types, structs)
                    Stmt.While(auto_escape_while_condition4, auto_escape_while_body4, auto_escape_while_line4):
                        auto_region_collect_escape_calls(auto_escape_while_condition4, names, local_names, local_types, structs)
                        auto_region_collect_escape_statement_calls(auto_escape_while_body4, names, local_names, local_types, structs)
                    Stmt.For(auto_escape_for_bind4, auto_escape_for_variables4, auto_escape_for_iterable4, auto_escape_for_body4, auto_escape_for_line4):
                        auto_region_collect_escape_calls(auto_escape_for_iterable4, names, local_names, local_types, structs)
                        auto_region_collect_escape_statement_calls(auto_escape_for_body4, names, local_names, local_types, structs)
                    Stmt.Return(auto_escape_return_value4, auto_escape_return_line4):
                        if auto_escape_return_value4 is auto_escape_return_value4_present:
                            auto_region_collect_all_idents(auto_escape_return_value4_present, names)
                            auto_region_collect_escape_calls(auto_escape_return_value4_present, names, local_names, local_types, structs)
                    Stmt.Match(auto_escape_match_scrutinee4, auto_escape_match_arms4, auto_escape_match_line4):
                        auto_region_collect_escape_calls(auto_escape_match_scrutinee4, names, local_names, local_types, structs)
                        for auto_escape_arm4 in auto_escape_match_arms4 |names, local_names, local_types, structs|:
                            auto_region_collect_escape_calls(auto_escape_arm4.guard, names, local_names, local_types, structs)
                            auto_region_collect_escape_statement_calls(auto_escape_arm4.body, names, local_names, local_types, structs)
                    Stmt.Contract(auto_escape_contract_kind4, auto_escape_contract_expression4, auto_escape_contract_line4):
                        auto_region_collect_escape_calls(auto_escape_contract_expression4, names, local_names, local_types, structs)
                    _:
                        pass


        # Record the ownership edges created when a mutating aggregate call copies one value
        # into another.  The ordinary escape scan can see `arms.push(term)`, but it cannot infer
        # that the nested darray inside `term` must live as long as `arms`.  Keep this as a
        # separate data-oriented relation and close it after the syntax walk: if the destination
        # escapes, every source copied into it escapes too.  This is the same fixed-point rule as
        # the stage0 backend and covers chains such as `inner -> term -> arms -> return`.
        def auto_region_mutates_aggregate(method: sview) -> bool:
            return method == "push" or method == "extend" or method == "insert" or method == "put" or method == "add" or method == "append" or method == "set" or method == "update"


        def auto_region_aggregate_root_name(expression: Expr) -> sview can[Abort.Panic]:
            if expression is Expr.Ident(auto_edge_ident_name, auto_edge_ident_line):
                return auto_edge_ident_name
            if expression is Expr.Field(auto_edge_field_object, auto_edge_field_name, auto_edge_field_line):
                return auto_region_aggregate_root_name(auto_edge_field_object)
            if expression is Expr.Index(auto_edge_index_object, auto_edge_index_index, auto_edge_index_line):
                return auto_region_aggregate_root_name(auto_edge_index_object)
            if expression is Expr.Slice(auto_edge_slice_object, auto_edge_slice_low, auto_edge_slice_high, auto_edge_slice_line):
                return auto_region_aggregate_root_name(auto_edge_slice_object)
            if expression is Expr.Paren(auto_edge_paren_inner, auto_edge_paren_line):
                return auto_region_aggregate_root_name(auto_edge_paren_inner)
            return ""


        def auto_region_append_dependency(owner: sview, source: sview, owners: mutable darray[sview]&, sources: mutable darray[sview]&) -> void can[Abort.Panic, Memory.Allocate]:
            return if owner == "" or source == ""
            for dependency_index in 0..<owners.count |dependency_index, owner, source, owners, sources|:
                return if owners[dependency_index] == owner and sources[dependency_index] == source
            owners <- owners.push(owner)
            sources <- sources.push(source)


        # A darray header assignment transfers the backing-storage obligation even when the
        # assignment itself is not a mutating method call. `top <- round_top` and
        # `top <- static_fn_filtered` are the important examples: the returned `top` header
        # aliases whichever source was selected on the last pass. Keep the edge at the named
        # aggregate root; the fixed-point closure below then propagates caller ownership through
        # chains without routing unrelated scalar assignments to the caller arena.
        def auto_region_append_assignment_dependency(target: Expr, value: Expr, owners: mutable darray[sview]&, sources: mutable darray[sview]&) -> void can[Abort.Panic, Memory.Allocate]:
            owner: sview = auto_region_aggregate_root_name(target)
            source: sview = auto_region_aggregate_root_name(value)
            auto_region_append_dependency(owner, source, owners, sources)
            # A record/enum constructor performs a shallow copy of each field.  If the
            # constructed value later escapes, every storage-bearing field must therefore
            # use the same arena as the constructed value.  The mutator-only dependency walk
            # cannot see this edge: `Variant{fields: field_items}` never calls `push` on the
            # destination.  Without it, the nested darray is left in adopted.scratch and the
            # constructor's caller observes a dangling header after that scratch arena is freed.
            if owner == "":
                return
            auto_region_append_construct_dependencies(owner, value, owners, sources)


        def auto_region_append_construct_dependencies(owner: sview, expression: Expr, owners: mutable darray[sview]&, sources: mutable darray[sview]&) -> void can[Abort.Panic, Memory.Allocate]:
            match expression:
                Expr.Construct(auto_dependency_construct_type, auto_dependency_construct_fields, auto_dependency_construct_line):
                    for auto_dependency_field in auto_dependency_construct_fields |owner, owners, sources|:
                        field_names: mutable darray[sview] = []
                        auto_region_collect_all_idents(auto_dependency_field.value, field_names)
                        for field_name in field_names |owner, owners, sources|:
                            auto_region_append_dependency(owner, field_name, owners, sources)
                        auto_region_append_construct_dependencies(owner, auto_dependency_field.value, owners, sources)
                Expr.RecordUpdate(auto_dependency_update_base, auto_dependency_update_fields, auto_dependency_update_line):
                    base_names: mutable darray[sview] = []
                    auto_region_collect_all_idents(auto_dependency_update_base, base_names)
                    for base_name in base_names |owner, owners, sources|:
                        auto_region_append_dependency(owner, base_name, owners, sources)
                    auto_region_append_construct_dependencies(owner, auto_dependency_update_base, owners, sources)
                    for auto_dependency_field in auto_dependency_update_fields |owner, owners, sources|:
                        field_names: mutable darray[sview] = []
                        auto_region_collect_all_idents(auto_dependency_field.value, field_names)
                        for field_name in field_names |owner, owners, sources|:
                            auto_region_append_dependency(owner, field_name, owners, sources)
                        auto_region_append_construct_dependencies(owner, auto_dependency_field.value, owners, sources)
                Expr.If(auto_dependency_if_condition, auto_dependency_if_then, auto_dependency_if_else, auto_dependency_if_line):
                    auto_region_append_construct_dependencies(owner, auto_dependency_if_then, owners, sources)
                    auto_region_append_construct_dependencies(owner, auto_dependency_if_else, owners, sources)
                Expr.Match(auto_dependency_match_scrutinee, auto_dependency_match_arms, auto_dependency_match_line):
                    for auto_dependency_arm in auto_dependency_match_arms |owner, owners, sources|:
                        auto_region_append_construct_dependencies(owner, auto_dependency_arm.guard, owners, sources)
                        auto_region_collect_dependency_statement_edges(auto_dependency_arm.body, owners, sources)
                Expr.Catch(auto_dependency_catch_scrutinee, auto_dependency_catch_arms, auto_dependency_catch_line):
                    for auto_dependency_arm in auto_dependency_catch_arms |owner, owners, sources|:
                        auto_region_append_construct_dependencies(owner, auto_dependency_arm.guard, owners, sources)
                        auto_region_collect_dependency_statement_edges(auto_dependency_arm.body, owners, sources)
                Expr.Block(auto_dependency_block_statements, auto_dependency_block_value, auto_dependency_block_captures, auto_dependency_block_line):
                    auto_region_collect_dependency_statement_edges(auto_dependency_block_statements, owners, sources)
                    auto_region_append_construct_dependencies(owner, auto_dependency_block_value, owners, sources)
                Expr.Paren(auto_dependency_paren_inner, auto_dependency_paren_line):
                    auto_region_append_construct_dependencies(owner, auto_dependency_paren_inner, owners, sources)
                Expr.Move(auto_dependency_move_operand, auto_dependency_move_line):
                    auto_region_append_construct_dependencies(owner, auto_dependency_move_operand, owners, sources)
                _:
                    pass


        def auto_region_collect_dependency_edges(expression: Expr, owners: mutable darray[sview]&, sources: mutable darray[sview]&) -> void can[Abort.Panic, Memory.Allocate]:
            match expression:
                Expr.Call(auto_edge_call_callee, auto_edge_call_args, auto_edge_call_names, auto_edge_call_line):
                    if auto_edge_call_callee is Expr.Field(auto_edge_receiver, auto_edge_method, auto_edge_method_line):
                        owner: sview = auto_region_aggregate_root_name(auto_edge_receiver)
                        if auto_region_mutates_aggregate(auto_edge_method):
                            for auto_edge_argument in auto_edge_call_args |owners, sources|:
                                argument_names: mutable darray[sview] = []
                                auto_region_collect_all_idents(auto_edge_argument, argument_names)
                                for source in argument_names |owner, owners, sources|:
                                    auto_region_append_dependency(owner, source, owners, sources)
                    auto_region_collect_dependency_edges(auto_edge_call_callee, owners, sources)
                    for auto_edge_call_argument in auto_edge_call_args |owners, sources|:
                        auto_region_collect_dependency_edges(auto_edge_call_argument, owners, sources)
                Expr.RegionNew(auto_edge_new_operand, auto_edge_new_region, auto_edge_new_line):
                    auto_region_collect_dependency_edges(auto_edge_new_operand, owners, sources)
                Expr.Array(auto_edge_array_elements, auto_edge_array_line):
                    for auto_edge_element in auto_edge_array_elements |owners, sources|:
                        auto_region_collect_dependency_edges(auto_edge_element, owners, sources)
                Expr.SetLit(auto_edge_set_elements, auto_edge_set_line):
                    for auto_edge_element in auto_edge_set_elements |owners, sources|:
                        auto_region_collect_dependency_edges(auto_edge_element, owners, sources)
                Expr.DictLit(auto_edge_dict_entries, auto_edge_dict_line):
                    for auto_edge_entry in auto_edge_dict_entries |owners, sources|:
                        auto_region_collect_dependency_edges(auto_edge_entry.key, owners, sources)
                        auto_region_collect_dependency_edges(auto_edge_entry.value, owners, sources)
                Expr.Comprehension(auto_edge_comp_var, auto_edge_comp_iterable, auto_edge_comp_condition, auto_edge_comp_body, auto_edge_comp_line):
                    auto_region_collect_dependency_edges(auto_edge_comp_iterable, owners, sources)
                    auto_region_collect_dependency_edges(auto_edge_comp_condition, owners, sources)
                    auto_region_collect_dependency_edges(auto_edge_comp_body, owners, sources)
                Expr.Block(auto_edge_block_statements, auto_edge_block_value, auto_edge_block_captures, auto_edge_block_line):
                    auto_region_collect_dependency_statement_edges(auto_edge_block_statements, owners, sources)
                    auto_region_collect_dependency_edges(auto_edge_block_value, owners, sources)
                Expr.Lambda(auto_edge_lambda_params, auto_edge_lambda_body, auto_edge_lambda_line):
                    auto_region_collect_dependency_statement_edges(auto_edge_lambda_body, owners, sources)
                Expr.Binary(auto_edge_binary_left, auto_edge_binary_operator, auto_edge_binary_right, auto_edge_binary_line):
                    auto_region_collect_dependency_edges(auto_edge_binary_left, owners, sources)
                    auto_region_collect_dependency_edges(auto_edge_binary_right, owners, sources)
                Expr.Unary(auto_edge_unary_operator, auto_edge_unary_operand, auto_edge_unary_line):
                    auto_region_collect_dependency_edges(auto_edge_unary_operand, owners, sources)
                Expr.Move(auto_edge_move_operand, auto_edge_move_line):
                    auto_region_collect_dependency_edges(auto_edge_move_operand, owners, sources)
                Expr.Paren(auto_edge_paren_operand, auto_edge_paren_line):
                    auto_region_collect_dependency_edges(auto_edge_paren_operand, owners, sources)
                Expr.Index(auto_edge_index_object2, auto_edge_index_index2, auto_edge_index_line2):
                    auto_region_collect_dependency_edges(auto_edge_index_object2, owners, sources)
                    auto_region_collect_dependency_edges(auto_edge_index_index2, owners, sources)
                Expr.IndexN(auto_edge_indexn_object, auto_edge_indexn_args, auto_edge_indexn_line):
                    auto_region_collect_dependency_edges(auto_edge_indexn_object, owners, sources)
                    for auto_edge_indexn_arg in auto_edge_indexn_args |owners, sources|:
                        auto_region_collect_dependency_edges(auto_edge_indexn_arg, owners, sources)
                Expr.Slice(auto_edge_slice_object2, auto_edge_slice_low2, auto_edge_slice_high2, auto_edge_slice_line2):
                    auto_region_collect_dependency_edges(auto_edge_slice_object2, owners, sources)
                    auto_region_collect_dependency_edges(auto_edge_slice_low2, owners, sources)
                    auto_region_collect_dependency_edges(auto_edge_slice_high2, owners, sources)
                Expr.Field(auto_edge_field_object2, auto_edge_field_name2, auto_edge_field_line2):
                    auto_region_collect_dependency_edges(auto_edge_field_object2, owners, sources)
                Expr.Scope(auto_edge_scope_base, auto_edge_scope_name, auto_edge_scope_line):
                    auto_region_collect_dependency_edges(auto_edge_scope_base, owners, sources)
                Expr.Tuple(auto_edge_tuple_elements, auto_edge_tuple_line):
                    for auto_edge_tuple_element in auto_edge_tuple_elements |owners, sources|:
                        auto_region_collect_dependency_edges(auto_edge_tuple_element, owners, sources)
                Expr.Construct(auto_edge_construct_type, auto_edge_construct_fields, auto_edge_construct_line):
                    auto_region_collect_dependency_edges(auto_edge_construct_type, owners, sources)
                    for auto_edge_field in auto_edge_construct_fields |owners, sources|:
                        auto_region_collect_dependency_edges(auto_edge_field.value, owners, sources)
                Expr.RecordUpdate(auto_edge_update_base, auto_edge_update_fields, auto_edge_update_line):
                    auto_region_collect_dependency_edges(auto_edge_update_base, owners, sources)
                    for auto_edge_field in auto_edge_update_fields |owners, sources|:
                        auto_region_collect_dependency_edges(auto_edge_field.value, owners, sources)
                Expr.If(auto_edge_if_condition, auto_edge_if_then, auto_edge_if_else, auto_edge_if_line):
                    auto_region_collect_dependency_edges(auto_edge_if_condition, owners, sources)
                    auto_region_collect_dependency_edges(auto_edge_if_then, owners, sources)
                    auto_region_collect_dependency_edges(auto_edge_if_else, owners, sources)
                Expr.Match(auto_edge_match_scrutinee, auto_edge_match_arms, auto_edge_match_line):
                    auto_region_collect_dependency_edges(auto_edge_match_scrutinee, owners, sources)
                    for auto_edge_arm in auto_edge_match_arms |owners, sources|:
                        auto_region_collect_dependency_edges(auto_edge_arm.guard, owners, sources)
                        auto_region_collect_dependency_statement_edges(auto_edge_arm.body, owners, sources)
                Expr.Catch(auto_edge_catch_scrutinee, auto_edge_catch_arms, auto_edge_catch_line):
                    auto_region_collect_dependency_edges(auto_edge_catch_scrutinee, owners, sources)
                    for auto_edge_arm in auto_edge_catch_arms |owners, sources|:
                        auto_region_collect_dependency_edges(auto_edge_arm.guard, owners, sources)
                        auto_region_collect_dependency_statement_edges(auto_edge_arm.body, owners, sources)
                Expr.Refinement(auto_edge_refinement_base, auto_edge_refinement_predicate, auto_edge_refinement_line):
                    auto_region_collect_dependency_edges(auto_edge_refinement_base, owners, sources)
                    auto_region_collect_dependency_edges(auto_edge_refinement_predicate, owners, sources)
                Expr.GetElse(auto_edge_get_guarded, auto_edge_get_recovery, auto_edge_get_line):
                    auto_region_collect_dependency_edges(auto_edge_get_guarded, owners, sources)
                    auto_region_collect_dependency_statement_edges(auto_edge_get_recovery, owners, sources)
                _:
                    pass


        def auto_region_collect_dependency_statement_edges(statement_list: darray[Stmt], owners: mutable darray[sview]&, sources: mutable darray[sview]&) -> void can[Abort.Panic, Memory.Allocate]:
            for auto_edge_statement in statement_list |owners, sources|:
                match auto_edge_statement:
                    Stmt.Expr(auto_edge_statement_expression, auto_edge_statement_line):
                        auto_region_collect_dependency_edges(auto_edge_statement_expression, owners, sources)
                    Stmt.VarDecl(auto_edge_decl_name, auto_edge_decl_type, auto_edge_decl_value, auto_edge_decl_line):
                        auto_region_append_assignment_dependency(Expr.Ident(auto_edge_decl_name, auto_edge_decl_line), auto_edge_decl_value, owners, sources) if auto_edge_decl_value is not Expr.Invalid
                        auto_region_collect_dependency_edges(auto_edge_decl_value, owners, sources)
                    Stmt.Assign(auto_edge_assign_target, auto_edge_assign_operator, auto_edge_assign_value, auto_edge_assign_line):
                        auto_region_append_assignment_dependency(auto_edge_assign_target, auto_edge_assign_value, owners, sources)
                        auto_region_collect_dependency_edges(auto_edge_assign_target, owners, sources)
                        auto_region_collect_dependency_edges(auto_edge_assign_value, owners, sources)
                    Stmt.Block(auto_edge_block_kind, auto_edge_block_clause, auto_edge_block_binding, auto_edge_block_body, auto_edge_block_line):
                        auto_region_collect_dependency_statement_edges(auto_edge_block_body, owners, sources)
                    Stmt.If(auto_edge_if_condition2, auto_edge_if_then2, auto_edge_if_else2, auto_edge_if_line2):
                        auto_region_collect_dependency_edges(auto_edge_if_condition2, owners, sources)
                        auto_region_collect_dependency_statement_edges(auto_edge_if_then2, owners, sources)
                        auto_region_collect_dependency_statement_edges(auto_edge_if_else2, owners, sources)
                    Stmt.While(auto_edge_while_condition, auto_edge_while_body, auto_edge_while_line):
                        auto_region_collect_dependency_edges(auto_edge_while_condition, owners, sources)
                        auto_region_collect_dependency_statement_edges(auto_edge_while_body, owners, sources)
                    Stmt.For(auto_edge_for_bind, auto_edge_for_variables, auto_edge_for_iterable, auto_edge_for_body, auto_edge_for_line):
                        auto_region_collect_dependency_edges(auto_edge_for_iterable, owners, sources)
                        auto_region_collect_dependency_statement_edges(auto_edge_for_body, owners, sources)
                    Stmt.Return(auto_edge_return_value, auto_edge_return_line):
                        if auto_edge_return_value is auto_edge_return_value_present:
                            auto_region_collect_dependency_edges(auto_edge_return_value_present, owners, sources)
                    Stmt.Match(auto_edge_stmt_match_scrutinee, auto_edge_stmt_match_arms, auto_edge_stmt_match_line):
                        auto_region_collect_dependency_edges(auto_edge_stmt_match_scrutinee, owners, sources)
                        for auto_edge_arm2 in auto_edge_stmt_match_arms |owners, sources|:
                            auto_region_collect_dependency_edges(auto_edge_arm2.guard, owners, sources)
                            auto_region_collect_dependency_statement_edges(auto_edge_arm2.body, owners, sources)
                    Stmt.Contract(auto_edge_contract_kind, auto_edge_contract_expression, auto_edge_contract_line):
                        auto_region_collect_dependency_edges(auto_edge_contract_expression, owners, sources)
                    _:
                        pass


        # Record the arena that must own each local aggregate copied into a caller-owned
        # aggregate. This is the source-side counterpart of stage0's callerStorageArenas map.
        # The existing dependency relation is closed to a fixed point, so chains such as
        # `outer.push(wrapper)` after `wrapper.push(result)` preserve the ultimate owner.
        # Keeping this per-name avoids routing every result through caller_arena: unrelated
        # scratch values must remain private or they can split a reserve/fixed caller stack.
        def caller_storage_arenas_for(parameters: darray[ParamDecl]&, statements: darray[Stmt], local_scope: mutable Scope&, runtime: Runtime&, structs: mutable StructTable&) -> CallerStorageArenas can[Abort.Panic, Memory.Allocate]:
            names: mutable darray[sview] = []
            arenas: mutable darray[LLVMValueRef] = []
            for parameter in parameters |local_scope, runtime, structs|:
                parameter_type: ValueType = parameter_value_type(parameter.type_expression, structs)
                continue if not value_type_carries_caller_region(parameter_type, structs)
                parameter_arena: LLVMValueRef = growth_arena_for(Expr.Ident(parameter.name, Ast::pos_at_line(0)), local_scope, runtime)
                continue if llvm_value_is_null(parameter_arena)
                names <- names.push(parameter.name)
                arenas <- arenas.push(parameter_arena)

            dependency_owners: mutable darray[sview] = []
            dependency_sources: mutable darray[sview] = []
            auto_region_collect_dependency_statement_edges(statements, dependency_owners, dependency_sources)
            changed: mutable bool = true
            while changed:
                changed <- false
                for dependency_index in 0..<dependency_owners.count |dependency_index, changed, dependency_owners, dependency_sources, names|:
                    owner: sview = dependency_owners[dependency_index]
                    source: sview = dependency_sources[dependency_index]
                    owner_index: mutable i64 = -1
                    for storage_index in 0..<names.count |owner_index, names, owner|:
                        owner_index <- storage_index.i64() if names[storage_index] == owner
                    continue if owner_index < 0
                    source_seen: mutable bool = false
                    for storage_name in names |source_seen, source|:
                        source_seen <- true if storage_name == source
                    continue if source_seen
                    names <- names.push(source)
                    arenas <- arenas.push(arenas[owner_index.usize()])
                    changed <- true
            return CallerStorageArenas{names: names, arenas: arenas}


        # The caller-owned arena associated with one local aggregate result, or null when that
        # local is not on an ownership path into a region-bearing parameter.
        def caller_storage_arena_for(runtime: Runtime&, name: sview) -> LLVMValueRef? can[Abort.Panic]:
            for storage_index in 0..<runtime.caller_storage_names.count |runtime, name|:
                return runtime.caller_storage_arenas[storage_index] if runtime.caller_storage_names[storage_index] == name
            return null


        def auto_region_adopted_escape_names(statements: darray[Stmt], structs: mutable StructTable&) -> darray[sview] can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            names: mutable darray[sview] = []
            local_names: mutable darray[sview] = []
            local_types: mutable darray[ValueType] = []
            dependency_owners: mutable darray[sview] = []
            dependency_sources: mutable darray[sview] = []
            # These three worklists are populated by one recursive walk and therefore grow
            # interleaved.  The inferred auto region for this helper can be reserve_commit (the
            # same stable-base policy used by the compiler's other inferred regions); allowing
            # one list to grow after another list was appended would then ask arena_realloc to
            # move a non-tail allocation, which is a real ownership violation rather than an
            # allocator fallback case.  Reserve a bounded analysis window before the walk so
            # population is append-only.  A function body in this compiler is far below this
            # bound; the reserve is virtual/lazy on reserve_commit and costs no committed pages.
            analysis_capacity: usize = statements.count * 64 + 64
            names.reserve(analysis_capacity)
            local_names.reserve(analysis_capacity)
            local_types.reserve(analysis_capacity)
            dependency_owners.reserve(analysis_capacity)
            dependency_sources.reserve(analysis_capacity)
            auto_region_collect_local_decl_types(statements, local_names, local_types, structs)
            auto_region_collect_escape_statement_calls(statements, names, local_names, local_types, structs)
            auto_region_collect_dependency_statement_edges(statements, dependency_owners, dependency_sources)
            changed: mutable bool = true
            while changed:
                changed <- false
                for dependency_index in 0..<dependency_owners.count |dependency_index, changed, names, dependency_owners, dependency_sources|:
                    owner: sview = dependency_owners[dependency_index]
                    source: sview = dependency_sources[dependency_index]
                    owner_escapes: mutable bool = false
                    for escaped_name in names |owner, owner_escapes|:
                        owner_escapes <- true if escaped_name == owner
                    continue if not owner_escapes
                    before_count: usize = names.count
                    auto_region_append_escape_name(names, source)
                    changed <- true if names.count > before_count
            return names


        def auto_region_statement_needs_arena(statement: Stmt, fns: FnTable&, structs: mutable StructTable&, generics: GenericTable&) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                if statement is Stmt.Expr(auto_region_stmt_expression, auto_region_stmt_line):
                    return auto_region_expression_needs_arena(auto_region_stmt_expression, fns, structs, generics)
                if statement is Stmt.VarDecl(auto_region_decl_name, auto_region_decl_type, auto_region_decl_value, auto_region_decl_line):
                    declared: ValueType = annotation_value_type(auto_region_decl_type, structs)
                    true return if declared.kind == TypeKind.DArray or declared.kind == TypeKind.View
                    true return if declared.kind == TypeKind.Struct and struct_contains_darray(declared, structs)
                    growable_head: sview = auto_region_growable_type_head(auto_region_decl_type)
                    true return if growable_head == "darray" or growable_head == "dict" or growable_head == "set"
                    return auto_region_expression_needs_arena(auto_region_decl_value, fns, structs, generics)
                if statement is Stmt.Assign(auto_region_assign_target, auto_region_assign_operator, auto_region_assign_value, auto_region_assign_line):
                    return auto_region_expression_needs_arena(auto_region_assign_target, fns, structs, generics) or auto_region_expression_needs_arena(auto_region_assign_value, fns, structs, generics)
                if statement is Stmt.Block(auto_region_block_kind, auto_region_block_clause, auto_region_block_binding, auto_region_block_body, auto_region_block_line):
                    true return if auto_region_block_kind == "region"
                    true return if auto_region_block_kind == "in" and auto_region_block_clause.count > 0 and auto_region_block_clause[0] != "auto"
                    return auto_region_statements_need_arena(auto_region_block_body, fns, structs, generics)
                if statement is Stmt.If(auto_region_stmt_if_condition, auto_region_stmt_if_then, auto_region_stmt_if_else, auto_region_stmt_if_line):
                    return auto_region_expression_needs_arena(auto_region_stmt_if_condition, fns, structs, generics) or auto_region_statements_need_arena(auto_region_stmt_if_then, fns, structs, generics) or auto_region_statements_need_arena(auto_region_stmt_if_else, fns, structs, generics)
                if statement is Stmt.While(auto_region_stmt_while_condition, auto_region_stmt_while_body, auto_region_stmt_while_line):
                    return auto_region_expression_needs_arena(auto_region_stmt_while_condition, fns, structs, generics) or auto_region_statements_need_arena(auto_region_stmt_while_body, fns, structs, generics)
                if statement is Stmt.For(auto_region_for_bind, auto_region_for_variables, auto_region_for_iterable, auto_region_for_body, auto_region_for_line):
                    return auto_region_expression_needs_arena(auto_region_for_iterable, fns, structs, generics) or auto_region_statements_need_arena(auto_region_for_body, fns, structs, generics)
                if statement is Stmt.Return(auto_region_return_value, auto_region_return_line):
                    if auto_region_return_value is value:
                        return auto_region_expression_needs_arena(value, fns, structs, generics)
                    return false
                if statement is Stmt.Match(auto_region_stmt_match_scrutinee, auto_region_stmt_match_arms, auto_region_stmt_match_line):
                    true return if auto_region_expression_needs_arena(auto_region_stmt_match_scrutinee, fns, structs, generics)
                    for auto_region_stmt_match_arm in auto_region_stmt_match_arms |fns, structs, generics|:
                        true return if auto_region_expression_needs_arena(auto_region_stmt_match_arm.guard, fns, structs, generics)
                        true return if auto_region_statements_need_arena(auto_region_stmt_match_arm.body, fns, structs, generics)
                    return false
                if statement is Stmt.Contract(auto_region_contract_kind, auto_region_contract_expression, auto_region_contract_line):
                    return auto_region_expression_needs_arena(auto_region_contract_expression, fns, structs, generics)
                return false


        def auto_region_statements_need_arena(statements: darray[Stmt], fns: FnTable&, structs: mutable StructTable&, generics: GenericTable&) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                for auto_region_statement in statements |fns, structs, generics|:
                    true return if auto_region_statement_needs_arena(auto_region_statement, fns, structs, generics)
                return false
