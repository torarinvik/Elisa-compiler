extend Backend:
    private:
        def auto_region_place_is_global(place: Expr, structs: mutable StructTable&) -> bool can[Abort.Panic, Memory.Allocate]:
            if place is Expr.Array(global_store_places, global_store_places_line):
                for global_store_place in global_store_places |structs|:
                    return true if auto_region_place_is_global(global_store_place, structs)
                return false
            root: sview = auto_region_place_root(place)
            return false if root == ""
            global_index: i64 = auto_region_global_root_index(structs, root)
            return false if global_index < 0
            # Only a global that can hold heap storage needs it to outlive the
            # call; a scalar store keeps the cheap freed scratch arena.
            return value_type_owns_region_storage(copied_type(structs.globals.mutable_global_types[global_index.usize()]), structs, 0)


        # Does this body assign into a heap-holding module global (or anything reachable
        # from one)?
        # Such a store makes the stored value outlive the call, so the body's scratch
        # allocations must not live in a carrier that is `arena_free`d at return: that
        # handed the global freed memory (the Studio's clip/memo read back as zeroes).
        # A parameter that shadows a global is excluded (auto_region_global_root_index);
        # a local that shadows one only costs a false positive: an extra re-home.
        def auto_region_statements_store_global(statements: darray[Stmt], structs: mutable StructTable&) -> bool can[Abort.Panic, Memory.Allocate]:
            for global_store_statement in statements |structs|:
                return true if auto_region_statement_stores_global(global_store_statement, structs)
            return false


        def auto_region_statement_stores_global(statement: Stmt, structs: mutable StructTable&) -> bool can[Abort.Panic, Memory.Allocate]:
            if statement is Stmt.Assign(global_store_target, global_store_operator, global_store_value, global_store_line):
                return auto_region_place_is_global(global_store_target, structs) or auto_region_expression_passes_global(global_store_value, structs)
            if statement is Stmt.Expr(global_store_expression, global_store_expression_line):
                return auto_region_expression_passes_global(global_store_expression, structs)
            if statement is Stmt.VarDecl(global_store_var_name, global_store_var_type, global_store_var_value, global_store_var_line):
                return auto_region_expression_passes_global(global_store_var_value, structs)
            if statement is Stmt.Return(global_store_return_value, global_store_return_line):
                if global_store_return_value is global_store_returned:
                    return auto_region_expression_passes_global(global_store_returned, structs)
                return false
            if statement is Stmt.Block(global_store_block_kind, global_store_block_clause, global_store_block_binding, global_store_block_body, global_store_block_line):
                return auto_region_statements_store_global(global_store_block_body, structs)
            if statement is Stmt.If(global_store_if_condition, global_store_if_then, global_store_if_else, global_store_if_line):
                return true if auto_region_expression_passes_global(global_store_if_condition, structs)
                return auto_region_statements_store_global(global_store_if_then, structs) or auto_region_statements_store_global(global_store_if_else, structs)
            if statement is Stmt.While(global_store_while_condition, global_store_while_body, global_store_while_line):
                return auto_region_statements_store_global(global_store_while_body, structs)
            if statement is Stmt.For(global_store_for_bind, global_store_for_variables, global_store_for_iterable, global_store_for_body, global_store_for_line):
                return auto_region_statements_store_global(global_store_for_body, structs)
            if statement is Stmt.Match(global_store_match_scrutinee, global_store_match_arms, global_store_match_line):
                for global_store_match_arm in global_store_match_arms |structs|:
                    return true if auto_region_statements_store_global(global_store_match_arm.body, structs)
                return false
            return false


        # One process-lifetime region per object file. Never freed: values reachable from
        # module globals live as long as the globals do.
        def auto_region_static_region(arena_type: LLVMTypeRef, m: LLVMModuleRef) -> LLVMValueRef can[Abort.Panic]:
            if LLVMGetNamedGlobal(m, ".elisa.static.region") is existing:
                return existing
            region: LLVMValueRef = LLVMAddGlobal(m, arena_type, ".elisa.static.region")
            LLVMSetInitializer(region, LLVMConstNull(arena_type))
            # LLVMInternalLinkage == 8.
            LLVMSetLinkage(region, 8)
            return region
