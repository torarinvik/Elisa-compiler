# Stage1 backend — the C SPELLING of an Elisa type in a generated header: the builtin name each
# scalar maps to, how many `*` a declarator needs, and the rendering of a named declaration,
# a function pointer and a parameter. Part of `module Backend` (see codegen.elisa).

extend Backend:
    private:
        def header_push(out: mutable darray[u8]&, text: sview) -> void can[Abort.Panic, Memory.Allocate]:
            out.extend(text)




        def header_public_struct_name(file: Ast::File&, internal_name: sview) -> sview can[Abort.Panic]:
            for annotation in file.enum_annotations |internal_name|:
                if annotation.name != "__export_type" and annotation.name == internal_name:
                    return annotation.owner
            return internal_name




        def header_type_name(file: Ast::File&, value_type: ValueType, structs: mutable StructTable&, out: mutable darray[u8]&) -> bool can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic, Memory.Allocate:
                if value_type.kind == TypeKind.Signed:
                    header_push(out, "intptr_t" if value_type.bits == 64 else ("int32_t" if value_type.bits == 32 else ("int16_t" if value_type.bits == 16 else "int8_t")))
                    return true
                if value_type.kind == TypeKind.Unsigned:
                    header_push(out, "uintptr_t" if value_type.bits == 64 else ("uint32_t" if value_type.bits == 32 else ("uint16_t" if value_type.bits == 16 else "uint8_t")))
                    return true
                if value_type.kind == TypeKind.Bool:
                    return false
                if value_type.kind == TypeKind.Void:
                    header_push(out, "void")
                    return true
                if value_type.kind == TypeKind.Float:
                    header_push(out, "float" if value_type.bits == 32 else "double")
                    return true
                if value_type.kind == TypeKind.CStr:
                    # A plain cstr is an immutable NUL-terminated byte pointer. Opaque
                    # extern handles reuse the CStr carrier with bits=1, but their C
                    # spelling is an untyped pointer rather than a string pointer.
                    header_push(out, "void" if value_type.bits != 0 else "const char")
                    return true
                if value_type.kind == TypeKind.Struct:
                    header_push(out, header_public_struct_name(file, structs.names[value_type.bits.usize()]))
                    return true
                if value_type.kind == TypeKind.Ref:
                    # The `*` belongs to the DECLARATOR, not the type: stage0's formatCDecl
                    # prepends it to the name and recurses on the referent, so a pointer
                    # prints `T *name`. Emitting it here produced `T* name`, and for a
                    # pointer-to-array it would drop the parentheses C requires entirely.
                    # header_pointer_depth supplies the stars at the name.
                    target: ValueType = copied_type(structs.ref_targets[value_type.bits.usize()])
                    false return if target.kind == TypeKind.Array
                    return header_type_name(file, target, structs, out)
                if value_type.kind == TypeKind.Optional:
                    # A niche optional reference is represented at the C boundary by the
                    # nullable pointer itself, not by Elisa's `{tag, payload}` pair. The
                    # semantic/backend paths already use the same rule for native externs;
                    # keep header emission in lockstep so a published field has the same
                    # layout as the object ABI (`u8&?` -> `uint8_t *field`).
                    payload: ValueType = copied_type(structs.optional_targets[value_type.bits.usize()])
                    false return if payload.kind != TypeKind.Ref
                    return header_type_name(file, payload, structs, out)
                if value_type.kind == TypeKind.Array:
                    element: ValueType = copied_type(structs.array_elements[value_type.bits.usize()])
                    return header_type_name(file, element, structs, out)
                return false




        # The C spelling for a SOURCE type name, mirroring stage0's cBuiltinTypeName.
        #
        # This exists because ValueType cannot tell `i64` from `isize`: both are Signed/64, and
        # header_type_name therefore printed `intptr_t` for BOTH. That is not merely a spelling
        # difference — an `i64` parameter declared `intptr_t` is 32-bit on a 32-bit target, so
        # the published header would disagree with the object ABI, which is the exact failure
        # this file's own header comment says it must never produce.
        #
        # Only the extern/export signature sites have the source name; struct fields still go
        # through the ValueType path. Answers false when the name is not a builtin scalar, so
        # the caller falls back.
        def header_c_name_for_source_type(type_name: sview, out: mutable darray[u8]&) -> bool can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic, Memory.Allocate:
                if type_name == "void":
                    header_push(out, "void")
                    return true
                if type_name == "char" or type_name == "i64":
                    header_push(out, "int64_t")
                    return true
                if type_name == "int" or type_name == "isize":
                    header_push(out, "intptr_t")
                    return true
                if type_name == "usize" or type_name == "uintptr":
                    header_push(out, "uintptr_t")
                    return true
                if type_name == "u64":
                    header_push(out, "uint64_t")
                    return true
                if type_name == "i8" or type_name == "u8" or type_name == "i16" or type_name == "u16" or type_name == "i32" or type_name == "u32":
                    header_push(out, "uint" if sview_at(type_name, 0) == 117 else "int")
                    header_push(out, "8_t" if sview_len(type_name) == 2 else ("16_t" if sview_at(type_name, 1) == 49 else "32_t"))
                    return true
                if type_name == "f32":
                    header_push(out, "float")
                    return true
                if type_name == "f64":
                    header_push(out, "double")
                    return true
                return false




        # The head name of a type expression: `i64` -> "i64", `mutable T` -> T's head,
        # anything structural -> "". A local copy of Semantic::bare_type_name, which the
        # backend cannot see.
        def header_bare_type_name(expression: Ast::Expr) -> sview can[Abort.Panic]:
            match expression:
                Expr.Unary(hbt_operator, hbt_operand, hbt_line):
                    return header_bare_type_name(hbt_operand) if hbt_operator == TokenKind.Mutable
                    return ""
                Expr.Ident(hbt_name, hbt_ident_line):
                    return hbt_name
                _:
                    return ""




        # The SOURCE type name of a struct field, from the AST, or "" when the struct or
        # field is not found (a synthesized tuple struct, an instantiation, …).
        #
        # This exists for the same reason header_c_name_for_source_type does: ValueType
        # cannot tell `i64` from `isize` — both are Signed/64 — so the ValueType path
        # prints `intptr_t` for both. The signature sites were fixed by consulting the
        # source name; STRUCT FIELDS were left on the ValueType path, so an exported
        # `layout(c)` struct with an `i64` field published `intptr_t left;` where stage0
        # writes `int64_t left;`. On a 32-bit target those are different widths, which is
        # exactly the object-ABI disagreement this file must never publish.
        #
        # The corpus never caught it: none of the 56 fixtures exports a `layout(c)` struct
        # with an i64 field, so `-emit header` measured byte-identical anyway.
        def header_field_source_type(file: Ast::File&, struct_name: sview, field_name: sview) -> sview can[Abort.Panic]:
            return header_field_source_type_in(file.top_decls, struct_name, field_name)




        def header_field_source_type_in(declarations: darray[Ast::Decl]&, struct_name: sview, field_name: sview) -> sview can[Abort.Panic]:
            for declaration in declarations:
                match declaration:
                    Decl.Struct(hfs_name, hfs_members, hfs_affinity, hfs_named_states, hfs_derive, hfs_invariants, hfs_line):
                        continue if hfs_name != struct_name
                        for hfs_member in hfs_members:
                            header_bare_type_name(hfs_member.type_expression) return if hfs_member.name == field_name
                        return ""
                    _:
                        pass
                match declaration:
                    Decl.Module(hfs_m_name, hfs_m_body, hfs_m_line):
                        found: sview = header_field_source_type_in(hfs_m_body, struct_name, field_name)
                        found return if found != ""
                    _:
                        pass
                match declaration:
                    Decl.Scoped(hfs_s_body, hfs_s_line):
                        found: sview = header_field_source_type_in(hfs_s_body, struct_name, field_name)
                        found return if found != ""
                    _:
                        pass
            return ""




        # header_decl, but preferring the field's SOURCE type name when it names a builtin
        # scalar. Falls back to the ValueType path for everything else (structs, refs,
        # arrays), which is where the source spelling carries no extra information.
        def header_field_decl(file: Ast::File&, value_type: ValueType, struct_name: sview, field_name: sview, structs: mutable StructTable&, out: mutable darray[u8]&) -> bool can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic, Memory.Allocate:
                if value_type.kind == TypeKind.Signed or value_type.kind == TypeKind.Unsigned:
                    source_name: sview = header_field_source_type(file, struct_name, field_name)
                    if source_name != "" and header_c_name_for_source_type(source_name, out):
                        out.push(32)
                        header_push(out, field_name)
                        header_push(out, ";")
                        return true
                return header_decl(file, value_type, field_name, structs, out)




        # How many `*` a declarator needs, and the type left underneath them. Kept separate
        # from header_type_name because C binds the star to the NAME (`T *x`), so the two
        # halves are emitted at different points.
        def header_pointer_depth(value_type: ValueType, structs: mutable StructTable&) -> i64 can[Abort.Panic]:
            can Abort.Panic:
                depth: mutable i64 = 0
                cursor: mutable ValueType = copied_type(value_type)
                if cursor.kind == TypeKind.Optional:
                    payload: ValueType = copied_type(structs.optional_targets[cursor.bits.usize()])
                    cursor <- payload
                if cursor.kind == TypeKind.CStr:
                    return 1
                while cursor.kind == TypeKind.Ref |cursor, depth, structs|:
                    depth <- depth + 1
                    cursor <- copied_type(structs.ref_targets[cursor.bits.usize()])
                return depth




        # Render a declaration without its trailing semicolon. Function values are
        # represented as raw function pointers at a layout(c) boundary, so a field such
        # as `cb: fn(void&, i32) -> void` becomes `void (*cb)(void *, int32_t)`.
        def header_named_decl(file: Ast::File&, value_type: ValueType, name: sview, structs: mutable StructTable&, out: mutable darray[u8]&) -> bool can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic, Memory.Allocate:
                if value_type.kind == TypeKind.Fn:
                    return header_function_pointer_decl(file, value_type, name, structs, out)
                false return if not header_type_name(file, value_type, structs, out)
                out.push(32)
                for _star in 0..<header_pointer_depth(value_type, structs) |out|:
                    out.push(42)
                header_push(out, name)
                array_type: mutable ValueType = copied_type(value_type)
                while array_type.kind == TypeKind.Array |array_type, structs, out|:
                    header_push(out, "[")
                    header_push_int(out, structs.array_extents[array_type.bits.usize()].i64())
                    out.push(93)
                    array_type <- copied_type(structs.array_elements[array_type.bits.usize()])
                return true




        def header_function_pointer_decl(file: Ast::File&, value_type: ValueType, name: sview, structs: mutable StructTable&, out: mutable darray[u8]&) -> bool can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic, Memory.Allocate:
                false return if value_type.kind != TypeKind.Fn
                false return if value_type.bits.usize() >= structs.fn_pool_returns.count
                return_type: ValueType = copied_type(structs.fn_pool_returns[value_type.bits.usize()])
                false return if not header_type_name(file, return_type, structs, out)
                for _return_star in 0..<header_pointer_depth(return_type, structs) |out|:
                    out.push(42)
                header_push(out, " (*")
                header_push(out, name)
                header_push(out, ")(")
                param_start: usize = structs.fn_pool_param_start[value_type.bits.usize()]
                param_count: usize = structs.fn_pool_param_count[value_type.bits.usize()]
                for param_index in 0..<param_count |file, value_type, structs, out, param_start, param_count|:
                    header_push(out, ", ") if param_index > 0
                    parameter: ValueType = copied_type(structs.fn_pool_params[param_start + param_index])
                    false return if not header_function_parameter_decl(file, parameter, param_index, structs, out)
                header_push(out, ")")
                return true




        def header_function_parameter_decl(file: Ast::File&, value_type: ValueType, index: usize, structs: mutable StructTable&, out: mutable darray[u8]&) -> bool can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic, Memory.Allocate:
                false return if not header_type_name(file, value_type, structs, out)
                out.push(32)
                for _star in 0..<header_pointer_depth(value_type, structs) |out|:
                    out.push(42)
                header_push(out, "arg")
                header_push_int(out, index.i64())
                array_type: mutable ValueType = copied_type(value_type)
                while array_type.kind == TypeKind.Array |array_type, structs, out|:
                    header_push(out, "[")
                    header_push_int(out, structs.array_extents[array_type.bits.usize()].i64())
                    out.push(93)
                    array_type <- copied_type(structs.array_elements[array_type.bits.usize()])
                return true




        def header_decl(file: Ast::File&, value_type: ValueType, name: sview, structs: mutable StructTable&, out: mutable darray[u8]&) -> bool can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic, Memory.Allocate:
                false return if not header_named_decl(file, value_type, name, structs, out)
                out.push(59)
                return true




        def header_push_int(out: mutable darray[u8]&, value: i64) -> void can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic, Memory.Allocate:
                if value < 0:
                    out.push(45)
                    header_push_int(out, 0 - value)
                    return
                if value >= 10:
                    header_push_int(out, value / 10)
                out.push((48 + (value % 10)).u8())




        def header_type_from_name(type_name: sview, structs: mutable StructTable&) -> ValueType can[Abort.Panic]:
            can Abort.Panic:
                scalar: ValueType = scalar_type_of_name(type_name)
                scalar return if scalar.kind != TypeKind.Unmodeled
                struct_index: i64 = struct_index_of(structs, type_name)
                ValueType{kind: TypeKind.Struct, bits: struct_index.u32()} return if struct_index >= 0
                return unmodeled_type()




        def header_global_type(structs: mutable StructTable&, name: sview) -> ValueType can[Abort.Panic]:
            can Abort.Panic:
                mutable_index: i64 = mutable_global_index_of(structs, name)
                copied_type(structs.mutable_global_types[mutable_index.usize()]) return if mutable_index >= 0
                const_index: i64 = const_index_of(structs, name)
                copied_type(structs.const_types[const_index.usize()]) return if const_index >= 0
                return unmodeled_type()




        # The SOURCE type name of a top-level global, for the same i64-vs-isize reason
        # header_field_source_type exists.
        def header_global_source_type(file: Ast::File&, global_name: sview) -> sview can[Abort.Panic]:
            return header_global_source_type_in(file.top_decls, global_name)




        def header_global_source_type_in(declarations: darray[Ast::Decl]&, global_name: sview) -> sview can[Abort.Panic]:
            for declaration in declarations:
                # A `global` parses to Decl.Const with is_mutable set; there is no separate
                # Global variant.
                match declaration:
                    Decl.Const(hgs_name, hgs_type, hgs_value, hgs_mutable, hgs_line):
                        header_bare_type_name(hgs_type) return if hgs_name == global_name
                    _:
                        pass
                match declaration:
                    Decl.Module(hgs_m_name, hgs_m_body, hgs_m_line):
                        found: sview = header_global_source_type_in(hgs_m_body, global_name)
                        found return if found != ""
                    _:
                        pass
                match declaration:
                    Decl.Scoped(hgs_s_body, hgs_s_line):
                        found: sview = header_global_source_type_in(hgs_s_body, global_name)
                        found return if found != ""
                    _:
                        pass
            return ""


    public:


        def name_in_sview(names: darray[sview]&, name: sview) -> bool can[Abort.Panic]:
            for existing in names |name|:
                true return if existing == name
            return false
