# Opcode-level portion of EASM memory effect classification.
# The verifier supplies parsed operand-shape facts; this module defines how those
# facts and opcode classes determine the explicit memory reads and writes.
module EasmMemoryEffectPolicy:
    public:
        def read_modify_write(op: sview) -> bool:
            ensure result == (
                op == "add" or op == "addq" or op == "sub" or op == "subq" or
                op == "and" or op == "andq" or op == "or" or op == "orq" or
                op == "xor" or op == "xorq" or op == "inc" or op == "incq" or
                op == "dec" or op == "decq" or op == "neg" or op == "negq" or
                op == "not" or op == "notq" or op == "shl" or op == "shlq" or
                op == "sal" or op == "salq" or op == "shr" or op == "shrq" or
                op == "sar" or op == "sarq" or op == "xchg" or op == "xchgl" or op == "xchgq"
            )
            can Abort.Panic:
                return when op:
                    "add" | "addq" | "sub" | "subq" -> true
                    "and" | "andq" | "or" | "orq" -> true
                    "xor" | "xorq" | "inc" | "incq" -> true
                    "dec" | "decq" | "neg" | "negq" -> true
                    "not" | "notq" | "shl" | "shlq" -> true
                    "sal" | "salq" | "shr" | "shrq" -> true
                    "sar" | "sarq" | "xchg" | "xchgl" | "xchgq" -> true
                    _ -> false

        def destination_reads_memory(op: sview) -> bool:
            ensure result == (
                read_modify_write(op) or op == "cmp" or op == "cmpq" or
                op == "test" or op == "testq" or op == "call" or op == "callq" or
                op == "jmp" or op == "jmpq"
            )
            can Abort.Panic:
                return when op:
                    "add" | "addq" | "sub" | "subq" -> true
                    "and" | "andq" | "or" | "orq" -> true
                    "xor" | "xorq" | "inc" | "incq" -> true
                    "dec" | "decq" | "neg" | "negq" -> true
                    "not" | "notq" | "shl" | "shlq" -> true
                    "sal" | "salq" | "shr" | "shrq" -> true
                    "sar" | "sarq" | "xchg" | "xchgl" | "xchgq" -> true
                    "cmp" | "cmpq" | "test" | "testq" -> true
                    "call" | "callq" | "jmp" | "jmpq" -> true
                    _ -> false

        def destination_writes_memory(op: sview) -> bool:
            ensure result == (
                op != "fldcw" and op != "ldmxcsr" and op != "cmp" and op != "cmpq" and
                op != "test" and op != "testq" and op != "push" and op != "pushq" and
                op != "call" and op != "callq" and op != "jmp" and op != "jmpq"
            )
            can Abort.Panic:
                return when op:
                    "fldcw" | "ldmxcsr" | "cmp" | "cmpq" -> false
                    "test" | "testq" | "push" | "pushq" -> false
                    "call" | "callq" | "jmp" | "jmpq" -> false
                    _ -> true

        def exchanges_memory_operand(op: sview) -> bool:
            ensure result == (op == "xchg" or op == "xchgl" or op == "xchgq")
            can Abort.Panic:
                return when op:
                    "xchg" | "xchgl" | "xchgq" -> true
                    _ -> false

        def memory_reads(op: sview, pseudo: bool, source_memory: bool, destination_memory: bool) -> bool:
            ensure result == (
                not pseudo and op != "lea" and op != "leaq" and
                op != "fnstcw" and op != "stmxcsr" and op != "pop" and op != "popq" and
                (source_memory or (destination_memory and destination_reads_memory(op)))
            )
            return false if:
                pseudo
                op == "lea" or op == "leaq"
                op == "fnstcw" or op == "stmxcsr"
            # POP's sole explicit operand is a destination. Its memory read is
            # from the implicit stack source, which stack tracking handles.
            false return if op == "pop" or op == "popq"
            return source_memory or (destination_memory and destination_reads_memory(op))

        def memory_writes(op: sview, pseudo: bool, destination_memory: bool, source_memory: bool = false) -> bool:
            ensure result == (
                not pseudo and op != "lea" and op != "leaq" and (
                    (destination_memory and destination_writes_memory(op)) or
                    (source_memory and exchanges_memory_operand(op))
                )
            )
            return false if:
                pseudo
                op == "lea" or op == "leaq"
            return (
                (destination_memory and destination_writes_memory(op)) or
                (source_memory and exchanges_memory_operand(op))
            )
