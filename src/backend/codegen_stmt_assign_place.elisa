# Stage1 backend — assigning THROUGH A PLACE: a bitset flag packed into a byte, a struct field,
# an index into a container, a fresh local introduced by `x <- v`, and a plain rebind of an
# existing one. Tried by codegen_stmt_assign_flow.elisa after the container-call and compound
# forms; `matched` says whether one of these claimed the target, since a claimed-but-declined
# branch also returns Declined. Part of `module Backend` (see codegen.elisa).

extend Backend:
    private:
        def emit_assign_to_place(assign_target: Expr, assign_operator: TokenKind, assign_value: Expr, assign_line: Ast::Pos, return_type: ValueType, local_scope: mutable Scope&, loops: mutable LoopStack&, regions: mutable RegionStack&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef, matched: mutable bool&) -> EmitStatus can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            matched <- true
            if assign_target is Expr.Field(bs_container, bs_flag, bs_flag_line):
                # ANY named member of a `bitset:` / `bitfield:` group — read-modify-write of
                # its slice of the backing integer. Only two names were handled before, so
                # every other flag write declined.
                if bs_container is Expr.Field(bg_owner, bg_field, bg_field_line):
                    bg_owner_type: mutable ValueType = struct_chain_type(bg_owner, local_scope, structs)
                    bg_owner_type <- ref_target_of(bg_owner_type, structs) if bg_owner_type.kind == TypeKind.Ref
                    if bg_owner_type.kind == TypeKind.Struct:
                        bg_row: i64 = bit_group_member_index(structs, bg_owner_type.bits.usize(), bg_field, bs_flag)
                        if bg_row >= 0:
                            EmitStatus.Declined return if assign_operator != TokenKind.LArrow
                            bg_slot: usize = bg_owner_type.bits.usize()
                            bg_pos: i64 = field_index_of(structs, bg_slot, bg_field)
                            EmitStatus.Declined return if bg_pos < 0
                            if struct_chain_address(bg_owner, local_scope, fns, structs, generics, runtime, m, ctx, builder) is bg_owner_addr:
                                bg_pack_type: ValueType = copied_type(structs.field_types[structs.field_start[bg_slot] + bg_pos.usize()])
                                bg_pack_llvm: LLVMTypeRef = llvm_type_of(bg_pack_type, structs, ctx)
                                bg_pack_ptr: LLVMValueRef = LLVMBuildStructGEP2(builder, llvm_type_of(bg_owner_type, structs, ctx), bg_owner_addr, bg_pos.u32(), "bitgroup.pack.ptr")
                                bg_offset: u32 = structs.bitgroup_offsets[bg_row.usize()]
                                bg_width: u32 = structs.bitgroup_widths[bg_row.usize()]
                                bg_mask: u64 = (1.u64() << bg_width.u64()) - 1.u64()
                                # A one-bit member is written from a BOOL; a wider one from
                                # an integer of the pack's own width.
                                # A BITSET member is written from a bool; a BITFIELD member
                                # from an integer even at one bit wide (`active: u1` takes
                                # `1`, not `true`), so the kind decides, not the width.
                                bg_is_flag: bool = structs.bitgroup_is_flag[bg_row.usize()]
                                bg_source_type: ValueType = ValueType{kind: TypeKind.Bool, bits: 1} if bg_is_flag else copied_type(bg_pack_type)
                                if emit_expression(assign_value, bg_source_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is bg_raw:
                                    # A member whose declared type is NARROWER than the
                                    # pack (`mode: Mode` where Mode is `const enum … of
                                    # u4`) comes back as an i4, and OR-ing that into the
                                    # i16 pack without widening emits `or i16 …, i4 poison`
                                    # — which compiled and answered 0 where stage0 says 1.
                                    # Widen anything narrower, not just the bitset flags.
                                    bg_needs_widen: bool = bg_is_flag or LLVMGetIntTypeWidth(LLVMTypeOf(bg_raw)) < LLVMGetIntTypeWidth(bg_pack_llvm)
                                    bg_widened: LLVMValueRef = LLVMBuildZExt(builder, bg_raw, bg_pack_llvm, "bitgroup.value") if bg_needs_widen else bg_raw
                                    bg_clamped: LLVMValueRef = LLVMBuildAnd(builder, bg_widened, LLVMConstInt(bg_pack_llvm, bg_mask, 0), "bitgroup.clamp")
                                    bg_placed: LLVMValueRef = LLVMBuildShl(builder, bg_clamped, LLVMConstInt(bg_pack_llvm, bg_offset.u64(), 0), "bitgroup.shl")
                                    bg_current: LLVMValueRef = LLVMBuildLoad2(builder, bg_pack_llvm, bg_pack_ptr, "bitgroup.pack")
                                    bg_cleared: LLVMValueRef = LLVMBuildAnd(builder, bg_current, LLVMConstInt(bg_pack_llvm, 18446744073709551615.u64() - (bg_mask << bg_offset.u64()), 0), "bitgroup.cleared")
                                    _ = LLVMBuildStore(builder, LLVMBuildOr(builder, bg_cleared, bg_placed, "bitgroup.next"), bg_pack_ptr)
                                    return EmitStatus.Open
                            return EmitStatus.Declined
                if bs_flag == "has_suffix" or bs_flag == "has_prefix":
                    if bs_container is Expr.Field(bs_owner, bs_field, bs_field_line):
                        EmitStatus.Declined return if assign_operator != TokenKind.LArrow
                        bs_bit: u64 = 0 if bs_flag == "has_suffix" else 1
                        if struct_chain_address(bs_owner, local_scope, fns, structs, generics, runtime, m, ctx, builder) is bs_owner_addr:
                            bs_owner_type: ValueType = struct_chain_type(bs_owner, local_scope, structs)
                            bs_owner_type_deref: ValueType = ref_target_of(bs_owner_type, structs) if bs_owner_type.kind == TypeKind.Ref else bs_owner_type
                            EmitStatus.Declined return if bs_owner_type_deref.kind != TypeKind.Struct
                            bs_slot: usize = bs_owner_type_deref.bits.usize()
                            bs_pos: i64 = field_index_of(structs, bs_slot, bs_field)
                            EmitStatus.Declined return if bs_pos < 0
                            bs_pack_type: ValueType = structs.field_types[structs.field_start[bs_slot] + bs_pos.usize()]
                            bs_pack_ptr: LLVMValueRef = LLVMBuildStructGEP2(builder, llvm_type_of(bs_owner_type_deref, structs, ctx), bs_owner_addr, bs_pos.u32(), "bitset.pack.ptr")
                            bs_pack_llvm: LLVMTypeRef = llvm_type_of(bs_pack_type, structs, ctx)
                            bs_cur: LLVMValueRef = LLVMBuildLoad2(builder, bs_pack_llvm, bs_pack_ptr, "bitset.pack.cur")
                            bs_mask: LLVMValueRef = LLVMConstInt(bs_pack_llvm, 1.u64() << bs_bit, 0)
                            bs_cleared: LLVMValueRef = LLVMBuildAnd(builder, bs_cur, LLVMBuildNot(builder, bs_mask, "bitset.not"), "bitset.clear")
                            if emit_expression(assign_value, ValueType{kind: TypeKind.Bool, bits: 1}, local_scope, fns, structs, generics, runtime, m, ctx, builder) is bs_bool:
                                bs_bit_val: LLVMValueRef = LLVMBuildSelect(builder, bs_bool, bs_mask, LLVMConstInt(bs_pack_llvm, 0, 0), "bitset.sel")
                                bs_new: LLVMValueRef = LLVMBuildOr(builder, bs_cleared, bs_bit_val, "bitset.or")
                                _ = LLVMBuildStore(builder, bs_new, bs_pack_ptr)
                                return EmitStatus.Open
                            return EmitStatus.Declined
                        return EmitStatus.Declined
            # `p.x <- v` — a field assignment: address, then store. Goes through
            # struct_address_of, so it works identically for a local struct and for a
            # `mutable P&` parameter (the ref just adds one load).
            if assign_target is Expr.Field(assign_object, assign_field, assign_field_line):
                EmitStatus.Declined return if assign_operator != TokenKind.LArrow
                if assign_object is Expr.Ident(soa_wb_name, soa_wb_name_line):
                    soa_wb_row: i64 = soa_row_binder_index_of(structs, soa_wb_name)
                    if soa_wb_row >= 0:
                        soa_wb_type: ValueType = soa_binder_element_type(soa_wb_row.usize(), assign_field, structs)
                        EmitStatus.Declined return if soa_wb_type.kind == TypeKind.Unmodeled
                        if soa_binder_element_address(soa_wb_row.usize(), assign_field, structs, ctx, builder) is soa_wb_address:
                            if emit_expression(assign_value, soa_wb_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is soa_wb_value:
                                _ = LLVMBuildStore(builder, soa_wb_value, soa_wb_address)
                                return EmitStatus.Open
                        return EmitStatus.Declined
                # `rows[r].field <- v` — a column-major ROW write. Shares the element
                # address with the read: struct_chain_address resolves the whole
                # `rows[r].field` chain, so this is only the store.
                if assign_object is Expr.Index(soa_w_object, soa_w_index, soa_w_line):
                    soa_w_type: ValueType = expression_type(soa_w_object, local_scope, fns, structs, generics)
                    if soa_w_type.kind == TypeKind.Struct and struct_declares_soa_layout(structs, structs.names[soa_w_type.bits.usize()]):
                        soa_w_slot: usize = soa_w_type.bits.usize()
                        soa_w_column: i64 = field_index_of(structs, soa_w_slot, assign_field)
                        EmitStatus.Declined return if soa_w_column < 0
                        soa_w_col_type: ValueType = copied_type(structs.field_types[structs.field_start[soa_w_slot] + soa_w_column.usize()])
                        soa_w_element: ValueType = darray_element_of(soa_w_col_type, structs)
                        EmitStatus.Declined return if soa_w_element.kind == TypeKind.Unmodeled
                        if struct_chain_address(assign_target, local_scope, fns, structs, generics, runtime, m, ctx, builder) is soa_w_address:
                            if emit_expression(assign_value, soa_w_element, local_scope, fns, structs, generics, runtime, m, ctx, builder) is soa_w_value:
                                _ = LLVMBuildStore(builder, soa_w_value, soa_w_address)
                                return EmitStatus.Open
                        return EmitStatus.Declined
                # `out.count <- 0` / `out.capacity <- total` — the darray HEADER fields,
                # written directly when a container is built by hand (ctx_fstr_alloc
                # installs a buffer, then sets the two lengths). A darray is not a
                # StructTable entry, so the named-field path below cannot reach it, and
                # the struct-type resolvers do not report one for a bare darray local —
                # hence keying off darray_type_behind_expr, which also covers a borrowed
                # `darray[T]&`.
                #
                # Header layout is `{ptr, i64, i64}` — items 0, count 1, capacity 2 — in
                # BOTH compilers, read off stage0's IR rather than assumed: a wrong
                # index here stores a plausible number into the wrong slot.
                if assign_field == "count" or assign_field == "capacity":
                    header_darray_type: ValueType = darray_type_behind_expr(assign_object, local_scope, structs)
                    if header_darray_type.kind == TypeKind.DArray:
                        header_field_index: u32 = 1 if assign_field == "count" else 2
                        if darray_address_of_expr(assign_object, local_scope, fns, structs, generics, runtime, m, ctx, builder) is header_address:
                            header_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, darray_llvm_type(structs, ctx), header_address, header_field_index, "darray.hdr.ptr")
                            if emit_expression(assign_value, ValueType{kind: TypeKind.Unsigned, bits: 64}, local_scope, fns, structs, generics, runtime, m, ctx, builder) is header_value:
                                _ = LLVMBuildStore(builder, header_value, header_pointer)
                                return EmitStatus.Open
                        return EmitStatus.Declined
                # The receiver may be a bare Ident (`p.x <- v`) OR a nested chain
                # (`o.i.v <- v`), both addressed by struct_chain_address. Use the chain
                # resolver for bare names too: translated C globals are not local bindings,
                # but their mutable-global type is recorded there.
                assign_struct_type: mutable ValueType = struct_chain_type(assign_object, local_scope, structs)
                assign_struct_type <- expression_type(assign_object, local_scope, fns, structs, generics) if assign_struct_type.kind == TypeKind.Unmodeled
                assign_struct_type <- ref_target_of(assign_struct_type, structs) if assign_struct_type.kind == TypeKind.Ref
                if assign_struct_type.kind == TypeKind.Optional:
                    assign_struct_payload: ValueType = optional_payload_of(assign_struct_type, structs)
                    assign_struct_type <- ref_target_of(assign_struct_payload, structs) if assign_struct_payload.kind == TypeKind.Ref
                assign_struct_type <- arena_user_struct(structs) if assign_struct_type.kind == TypeKind.Arena
                # `node.x <- v` on a packed enum's common field. The AoS profile exposes
                # the row address, so this is a typed store into the same fixed common
                # slot used by construction and reads. Word-reader profiles intentionally
                # decline because they expose only a value, not an address to mutate.
                # Dynamic user rows use the same AoS record pointer; their side-table
                # commons are rejected by the source-level storage/mutability rules, while
                # an inline common has a real row field and is safe to write here.
                if assign_struct_type.kind == TypeKind.PackedEnum and runtime.packed_mode == 2 and assign_struct_type.bits.usize() < structs.packed_names.count:
                    packed_write_index: i64 = packed_common_index_of(structs.packed_names[assign_struct_type.bits.usize()], assign_field, structs)
                    if packed_write_index >= 0:
                        packed_write_type: ValueType = packed_common_type_at(structs, structs.packed_names[assign_struct_type.bits.usize()], packed_write_index.u32())
                        packed_write_dynamic: bool = packed_is_dynamic_aos_enum(structs, assign_struct_type.bits.i64())
                        # A side-tabled common is a parallel column with no stable row
                        # address. Match stage0's diagnostic boundary by declining it; the
                        # source-level `@storage(inline)` annotation is the explicit opt-in
                        # required for mutation. Legacy typed rows remain inline by default.
                        # A handle is an INDEX into a store; without one in scope there is
                        # nothing to decode it against. `runtime.active_store` is zeroed
                        # then, and extracting the state out of it below built an
                        # ExtractValue on garbage -- accepted by the emitter, and a
                        # segfault at runtime. A body that reaches a widget only through a
                        # global has no store, which is exactly the shape that hit; stage0
                        # says so outright ("packed enum X decode requires store context").
                        # Decline instead, so the caller reports rather than miscompiles.
                        packed_write_has_store: bool = runtime.active_store_enum >= 0 and runtime.active_store_is_block
                        EmitStatus.Declined return if not packed_write_has_store
                        if packed_write_type.kind != TypeKind.Unmodeled and (not packed_write_dynamic or packed_common_is_inline(structs, structs.packed_names[assign_struct_type.bits.usize()], packed_write_index.u32())):
                            if emit_expression(assign_object, assign_struct_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is packed_write_handle:
                                packed_write_state: LLVMValueRef = LLVMBuildExtractValue(builder, runtime.active_store, 2, "packed.assign.state")
                                packed_write_index64: LLVMValueRef = LLVMBuildZExt(builder, packed_write_handle, LLVMInt64TypeInContext(ctx), "packed.assign.index")
                                packed_write_record_args: mutable darray[LLVMValueRef] = [packed_write_state, packed_write_index64]
                                packed_write_record_pointer: void& = (&packed_write_record_args[0]).cast[void&] can Unsafe.PointerCast
                                packed_write_record: LLVMValueRef = LLVMBuildCall2(builder, runtime.packed_read_word_type, runtime.packed_read_word, packed_write_record_pointer, 2, "packed.assign.record")
                                packed_write_row_type: LLVMTypeRef = packed_row_llvm_type(structs, assign_struct_type.bits.i64(), ctx)
                                packed_write_field_index: u32 = packed_dynamic_common_row_field_index(structs, assign_struct_type.bits.i64(), packed_write_index.u32()) if packed_write_dynamic else packed_common_row_field_index(structs, assign_struct_type.bits.i64(), packed_write_index.u32())
                                packed_write_field_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, packed_write_row_type, packed_write_record, packed_write_field_index, "packed.common.ptr")
                                if emit_expression_coerced(assign_value, packed_write_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is packed_write_value:
                                    _ = LLVMBuildStore(builder, packed_write_value, packed_write_field_pointer)
                                    return EmitStatus.Open
                    return EmitStatus.Declined
                EmitStatus.Declined return if assign_struct_type.kind != TypeKind.Struct
                assign_struct_slot: usize = assign_struct_type.bits.usize()
                field_position: i64 = field_index_of(structs, assign_struct_slot, assign_field)
                EmitStatus.Declined return if field_position < 0
                if struct_chain_address(assign_object, local_scope, fns, structs, generics, runtime, m, ctx, builder) is assign_address:
                    assign_field_type: ValueType = structs.field_types[structs.field_start[assign_struct_slot] + field_position.usize()]
                    # `a.end.count <- v` where the FIELD `end` is `heap Region&?`. The WRITE
                    # twin of the read fixed in cc9bc47: struct_chain_address hands back the
                    # address OF THE SLOT for a field receiver, and that slot holds a
                    # POINTER, so GEPing it stores into the OUTER struct. Dereference first.
                    #
                    # Only for a FIELD receiver — for an Ident, struct_address_of has already
                    # resolved a ref binding to the pointee.
                    assign_recv_declared: ValueType = struct_chain_type(assign_object, local_scope, structs)
                    assign_recv_is_field: mutable bool = false
                    if assign_object is Expr.Field(assign_recv_head, assign_recv_name, assign_recv_line):
                        assign_recv_is_field <- true
                    assign_base: mutable LLVMValueRef = assign_address
                    if assign_recv_is_field and assign_recv_declared.kind == TypeKind.Ref:
                        assign_base <- LLVMBuildLoad2(builder, LLVMPointerTypeInContext(ctx, 0), assign_address, "assign.recv.ref")
                    elif assign_recv_is_field and assign_recv_declared.kind == TypeKind.Optional:
                        assign_recv_payload: ValueType = optional_payload_of(assign_recv_declared, structs)
                        if assign_recv_payload.kind == TypeKind.Ref:
                            assign_recv_opt_llvm: LLVMTypeRef = llvm_type_of(assign_recv_declared, structs, ctx)
                            assign_recv_opt_value: LLVMValueRef = LLVMBuildLoad2(builder, assign_recv_opt_llvm, assign_address, "assign.recv.opt")
                            assign_base <- optional_payload_value_of(assign_recv_opt_value, assign_recv_declared, structs, ctx, builder)
                    field_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, llvm_type_of(assign_struct_type, structs, ctx), assign_base, field_position.u32(), "field.ptr")
                    # A direct large-aggregate call can write its sret result straight into the
                    # field. This must precede the generic place probe: struct_chain_address also
                    # knows how to spill a call result, which would otherwise defeat this path.
                    if assign_value is Expr.Call(assign_call_callee, assign_call_arguments, assign_call_argument_names, assign_call_line):
                        match assign_call_callee:
                            Expr.Ident(assign_call_name, assign_call_name_line):
                                assign_direct_status: i64 = emit_direct_call_into_sret("", assign_call_name, assign_call_callee, false, assign_call_arguments, assign_call_argument_names, field_pointer, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                                return EmitStatus.Open if assign_direct_status == 1
                                EmitStatus.Declined return if assign_direct_status < 0
                            Expr.Scope(assign_call_scope_head, assign_call_name, assign_call_scope_line):
                                if assign_call_scope_head is Expr.Ident(assign_call_module, assign_call_module_line):
                                    assign_direct_status: i64 = emit_direct_call_into_sret(module_alias_target(assign_call_module, structs), assign_call_name, assign_call_callee, false, assign_call_arguments, assign_call_argument_names, field_pointer, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                                    return EmitStatus.Open if assign_direct_status == 1
                                    EmitStatus.Declined return if assign_direct_status < 0
                            _:
                                pass
                    # A large aggregate RHS that already has a place must remain in memory. A
                    # first-class load followed by this field store creates the same expensive
                    # legalization shape as an indirect call argument; copy the bytes directly.
                    if indirect_aggregate_argument_address(assign_value, assign_field_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is assign_source:
                        assign_field_llvm: LLVMTypeRef = llvm_type_of(assign_field_type, structs, ctx)
                        assign_field_alignment: mutable u32 = LLVMABIAlignmentOfType(structs.target_data, assign_field_llvm)
                        assign_field_alignment <- 1 if assign_field_alignment == 0
                        assign_field_size: LLVMValueRef = LLVMConstInt(LLVMInt64TypeInContext(ctx), LLVMABISizeOfType(structs.target_data, assign_field_llvm), 0)
                        _ = LLVMBuildMemMove(builder, field_pointer, assign_field_alignment, assign_source, assign_field_alignment, assign_field_size)
                        return EmitStatus.Open
                    if emit_expression_coerced(assign_value, assign_field_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is field_value:
                        _ = LLVMBuildStore(builder, field_value, field_pointer)
                        return EmitStatus.Open
                return EmitStatus.Declined

            # `xs[i] <- v` — an index assignment: address, then store. Only a plain
            # `<-` to a local array is modeled (a compound `xs[i] += v` would need the
            # address computed once and reused, which is a separate lowering).
            if assign_target is Expr.Index(assign_array, assign_index, assign_index_line):
                EmitStatus.Declined return if assign_operator != TokenKind.LArrow
                # `(p.cast[T&])[i] <- v` — a WRITE through a cast with no local in
                # between, the counterpart of the same shape in the read path and in
                # struct_chain_address. Every branch below wants an Ident base, so this
                # declined while the read compiled. The one lvalue chain resolver already
                # knows the shape; ask it for the address and store.
                if assign_array is Expr.Index(cast_store_head, cast_store_arg, cast_store_line):
                    match cast_store_head:
                        Expr.Field(cast_store_source, cast_store_method, cast_store_method_line):
                            if cast_store_method == "cast":
                                cast_store_target: ValueType = annotation_value_type(cast_store_arg, structs)
                                if cast_store_target.kind == TypeKind.Ref:
                                    cast_store_element: ValueType = ref_target_of(cast_store_target, structs)
                                    if cast_store_element.kind != TypeKind.Unmodeled:
                                        if struct_chain_address(assign_target, local_scope, fns, structs, generics, runtime, m, ctx, builder) is cast_store_pointer:
                                            if emit_expression_coerced(assign_value, cast_store_element, local_scope, fns, structs, generics, runtime, m, ctx, builder) is cast_store_value:
                                                _ = LLVMBuildStore(builder, cast_store_value, cast_store_pointer)
                                                return EmitStatus.Open
                                        return EmitStatus.Declined
                        _:
                            pass
                if assign_array is Expr.Ident(assign_array_name, assign_array_name_line):
                    assign_array_type: ValueType = lookup_type(local_scope, assign_array_name)
                    # `xs[i] <- v` where `xs: mutable darray[T]&` — a BORROWED darray: load
                    # its header address out of the parameter slot, then index like a local
                    # darray (mirrors the borrowed-darray READ path).
                    assign_borrowed_type: ValueType = darray_type_behind(local_scope, assign_array_name, structs)
                    if assign_borrowed_type.kind == TypeKind.DArray and assign_array_type.kind == TypeKind.Ref:
                        if darray_address_of(local_scope, assign_array_name, structs, ctx, builder) is assign_borrowed_slot:
                            if emit_darray_index_address(assign_borrowed_slot, assign_borrowed_type, assign_index, local_scope, fns, structs, generics, runtime, m, ctx, builder) is assign_borrowed_pointer:
                                assign_borrowed_element: ValueType = darray_element_of(assign_borrowed_type, structs)
                                if emit_expression_coerced(assign_value, assign_borrowed_element, local_scope, fns, structs, generics, runtime, m, ctx, builder) is assign_borrowed_value:
                                    assign_borrowed_store: LLVMValueRef = LLVMBuildStore(builder, assign_borrowed_value, assign_borrowed_pointer)
                                    tag_disjoint_darray_access(assign_borrowed_store, assign_borrowed_pointer, runtime, ctx)
                                    return EmitStatus.Open
                        return EmitStatus.Declined
                    if lookup_slot(local_scope, assign_array_name) is darray_assign_slot:
                        if assign_array_type.kind == TypeKind.DArray:
                            if emit_darray_index_address(darray_assign_slot, assign_array_type, assign_index, local_scope, fns, structs, generics, runtime, m, ctx, builder) is darray_element_pointer:
                                darray_assign_element: ValueType = darray_element_of(assign_array_type, structs)
                                if emit_expression_coerced(assign_value, darray_assign_element, local_scope, fns, structs, generics, runtime, m, ctx, builder) is darray_assigned:
                                    darray_assign_store: LLVMValueRef = LLVMBuildStore(builder, darray_assigned, darray_element_pointer)
                                    tag_disjoint_darray_access(darray_assign_store, darray_element_pointer, runtime, ctx)
                                    return EmitStatus.Open
                            return EmitStatus.Declined
                    # `table[key] <- v` on a VIEW local. A view is a `{ptr, i64}` VALUE,
                    # so the element address is a GEP off its loaded data pointer -- not
                    # a header indexing like a darray. There was no View case here at
                    # all, which is what `NodeTable` (erased to a view) needed to be
                    # WRITABLE; view element READS already worked.
                    if assign_array_type.kind == TypeKind.View:
                        if lookup_slot(local_scope, assign_array_name) is view_assign_slot:
                            view_assign_element: ValueType = view_element_of(assign_array_type, structs)
                            EmitStatus.Declined return if view_assign_element.kind == TypeKind.Unmodeled
                            view_assign_llvm: LLVMTypeRef = llvm_type_of(assign_array_type, structs, ctx)
                            view_data_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, view_assign_llvm, view_assign_slot, 0, "view.assign.data.ptr")
                            view_data: LLVMValueRef = LLVMBuildLoad2(builder, LLVMPointerTypeInContext(ctx, 0), view_data_pointer, "view.assign.data")
                            if emit_expression(assign_index, ValueType{kind: TypeKind.Unsigned, bits: 64}, local_scope, fns, structs, generics, runtime, m, ctx, builder) is view_index_value:
                                view_gep_indices: mutable darray[LLVMValueRef] = [view_index_value]
                                view_gep_pointer: void& = (&view_gep_indices[0]).cast[void&] can Unsafe.PointerCast
                                view_element_pointer: LLVMValueRef = LLVMBuildGEP2(builder, llvm_type_of(view_assign_element, structs, ctx), view_data, view_gep_pointer, 1, "view.assign.elem")
                                if emit_expression_coerced(assign_value, view_assign_element, local_scope, fns, structs, generics, runtime, m, ctx, builder) is view_assigned_value:
                                    _ = LLVMBuildStore(builder, view_assigned_value, view_element_pointer)
                                    return EmitStatus.Open
                            return EmitStatus.Declined
                    # A FIXED-array local indexes in place. A `Struct&`/`T&` base
                    # (`items[i] <- v` on a `DictBucket[K,T]&`) is NOT an array — it falls
                    # through to the chain path below, which addresses it as a C-style
                    # pointer via struct_chain_address.
                    if assign_array_type.kind == TypeKind.Array:
                        if lookup_slot(local_scope, assign_array_name) is assign_array_slot:
                            if emit_index_address(assign_array_slot, assign_array_type, assign_index, local_scope, fns, structs, generics, runtime, m, ctx, builder) is element_pointer:
                                element_type: ValueType = array_element_of(assign_array_type, structs)
                                if emit_expression_coerced(assign_value, element_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is element_value:
                                    _ = LLVMBuildStore(builder, element_value, element_pointer)
                                    return EmitStatus.Open
                        return EmitStatus.Declined
                    # `a[i] <- v` where `a: mutable T[N]&` — a REF to a fixed array. The slot
                    # holds the array's ADDRESS; load it, then GEP into it exactly like a
                    # local array (the loaded pointer IS the array base).
                    if assign_array_type.kind == TypeKind.Ref and ref_target_of(assign_array_type, structs).kind == TypeKind.Array:
                        ref_array_type: ValueType = ref_target_of(assign_array_type, structs)
                        if lookup_slot(local_scope, assign_array_name) is ref_array_slot:
                            ref_array_base: LLVMValueRef = LLVMBuildLoad2(builder, LLVMPointerTypeInContext(ctx, 0), ref_array_slot, "arr.ref.base")
                            if emit_index_address(ref_array_base, ref_array_type, assign_index, local_scope, fns, structs, generics, runtime, m, ctx, builder) is ref_element_pointer:
                                ref_array_element_type: ValueType = array_element_of(ref_array_type, structs)
                                if emit_expression_coerced(assign_value, ref_array_element_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is ref_element_value:
                                    _ = LLVMBuildStore(builder, ref_element_value, ref_element_pointer)
                                    return EmitStatus.Open
                        return EmitStatus.Declined
                # A nested-index or field-chain target (`m[i][j] <- v`) OR a ref-base index
                # (`items[i] <- v`): the chain
                # resolver yields the element's type and address; store through it.
                chain_target_type: mutable ValueType = struct_chain_type(assign_target, local_scope, structs)
                # A C pointer may be produced by a call before the translator wraps it in
                # `elisa_nonnull`, for example `elisa_nonnull(__error())[0] <- 25`. The place
                # resolver deliberately only needs local/field/index structure and therefore
                # cannot see the function table for that inner call. The ordinary expression
                # typer can, and its result is exactly the element type required by this
                # store. Keep the structural answer first, using this as the rvalue-chain
                # fallback for value-producing pointer bases.
                chain_target_type <- expression_type(assign_target, local_scope, fns, structs, generics) if chain_target_type.kind == TypeKind.Unmodeled
                # A protocol subscript returns the element PLACE (`Elem&`), while the
                # assignment RHS is the element VALUE. Built-in index paths already
                # return the element type from struct_chain_type; unwrap only the
                # reference returned by a custom index so `box[key] <- value` stores
                # `value` through the returned address.
                custom_assign_index_type: mutable ValueType = unmodeled_type()
                match assign_target:
                    Expr.Index(custom_assign_object, custom_assign_key, custom_assign_line):
                        custom_assign_index_type <- index_overload_generic_type(custom_assign_object, custom_assign_key, local_scope, fns, structs, generics)
                        custom_assign_index_type <- index_overload_type(custom_assign_object, custom_assign_key, local_scope, fns, structs, generics) if custom_assign_index_type.kind == TypeKind.Unmodeled
                    _:
                        pass
                if custom_assign_index_type.kind == TypeKind.Ref:
                    # A generic protocol result is also the source of the
                    # element type when the structural chain walker cannot
                    # infer a type for the overloaded index itself.
                    chain_target_type <- ref_target_of(custom_assign_index_type, structs) if chain_target_type.kind == TypeKind.Unmodeled else ref_target_of(chain_target_type, structs)
                EmitStatus.Declined return if chain_target_type.kind == TypeKind.Unmodeled
                if struct_chain_address(assign_target, local_scope, fns, structs, generics, runtime, m, ctx, builder) is chain_target_address:
                    if emit_expression_coerced(assign_value, chain_target_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is chain_assigned_value:
                        _ = LLVMBuildStore(builder, chain_assigned_value, chain_target_address)
                        return EmitStatus.Open
                return EmitStatus.Declined

            # `phrase = f" of {x}" if c else f""` — an UNTYPED declaration by FIRST
            # ASSIGNMENT, which stage0 accepts. Declare the local from the value's type.
            if assign_operator == TokenKind.Assign and assign_target is Expr.Ident(new_local_name, new_local_line):
                # A name that is ALREADY bound is a SHADOWING declaration, not a mutation.
                # Measured against stage0:
                #
                #   acc: mutable i64 = 1
                #   if flag:
                #       acc = acc + 4      # reads the outer acc, declares a NEW inner one
                #   return acc             # still 1
                #
                # `=` never mutates an existing binding -- `<-` is the mutation operator --
                # so declaring afresh is stage0's semantics, not a widening of it. A
                # SAME-SCOPE redeclaration never reaches here: the semantic layer already
                # rejects it ("duplicate local 'x'; use `<-` to mutate").
                # `x = do: <stmts> <tail>` — a VALUE BLOCK with no annotation. Its type is
                # the TAIL's, but the tail routinely names locals the block itself
                # declares (`do: base = 5 / base + 7`), so it cannot be typed before those
                # statements run: expression_type answers Unmodeled and the declaration
                # declined. Emit the statements FIRST, then type and emit the tail with
                # the block's locals in scope.
                #
                # The locals land in the enclosing scope, which is what the ANNOTATED form
                # (`x: T = do: ...`) already does through the ordinary Expr.Block emitter
                # -- so this introduces no new scoping behaviour, it just removes the
                # ordering obstacle.
                if assign_value is Expr.Block(do_statements, do_tail, do_captures, do_block_line):
                    do_loops: mutable LoopStack = LoopStack{exits: [], continues: [], defer_marks: []}
                    do_regions: mutable RegionStack = RegionStack{arenas: []}
                    EmitStatus.Declined return if emit_statements(do_statements, return_type, local_scope, do_loops, do_regions, fns, structs, generics, runtime, m, ctx, builder) != EmitStatus.Open
                    do_type: ValueType = expression_type(do_tail, local_scope, fns, structs, generics)
                    EmitStatus.Declined return if do_type.kind == TypeKind.Unmodeled
                    if emit_expression(do_tail, do_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is do_value:
                        do_storage: mutable darray[u8] = []
                        do_slot: LLVMValueRef = build_entry_alloca(builder, llvm_type_of(do_type, structs, ctx), sview_to_cstr(new_local_name, do_storage))
                        _ = LLVMBuildStore(builder, do_value, do_slot)
                        declare_local(local_scope, new_local_name, do_slot, do_type)
                        return EmitStatus.Open
                    return EmitStatus.Declined
                new_local_type: mutable ValueType = expression_type(assign_value, local_scope, fns, structs, generics)
                # A value-`if` is CONTEXT-TYPED and has no standalone type; both arms agree,
                # so take the THEN arm's.
                if new_local_type.kind == TypeKind.Unmodeled:
                    if assign_value is Expr.If(new_if_condition, new_if_then, new_if_else, new_if_line):
                        new_local_type <- expression_type(new_if_then, local_scope, fns, structs, generics)
                # `ys = xs[lo:hi]` — a bare `=` DEFINING a new local from a slice.
                # expression_type answers SView for every slice whatever the receiver,
                # which for a container is wrong (stage0 types it DynArrayView) and makes
                # the emitter decline. Same correction as the VarDecl form; both sites are
                # needed because a bare `=` folds to Stmt.Assign, not Stmt.VarDecl — which
                # is why fixing only the VarDecl site left this exact program declining.
                new_local_type <- slice_receiver_view_type(assign_value, new_local_type, local_scope, fns, structs, generics)
                # `seed = 3` — an INTEGER LITERAL has no intrinsic type (it takes one
                # from context), so the inference above leaves it Unmodeled and the
                # declaration declined, even though stage0 accepts it. Default it exactly
                # as the VarDecl site does: signed 64, the type an integer literal takes
                # everywhere else.
                #
                # Restricted to a literal, like that site: any OTHER value whose type
                # could not be inferred keeps declining, because defaulting (say) a
                # darray-valued ternary to i64 would be a wrong answer rather than a drop.
                # There is no annotation to guard on here -- this form never has one --
                # which is the whole reason the VarDecl fix did not reach it.
                if new_local_type.kind == TypeKind.Unmodeled and assign_value is Expr.IntLit(new_local_literal_text, _):
                    new_local_type <- ValueType{kind: TypeKind.Signed, bits: 64}
                # `values = [1, 2, 3, 4]` — an un-annotated declaration from a CONTAINER
                # LITERAL. expression_type answers Unmodeled for a literal by design (a
                # literal DEFERS to its expected type), so the declaration declined even
                # though the annotated form works. literal_container_type derives the
                # shape from the elements, recursively, which is what a nested literal
                # needs.
                #
                # Used HERE rather than taught to expression_type: that was tried before
                # and produced a WRONG ANSWER for nested literals (a flat reading of
                # `[[1, 2], [3, 4]]`), which is why the helper exists separately. Confined
                # to declarations, the only programs affected are ones that used to
                # decline.
                # `xs = [item + 1 for item in items if item > 0]` — an unannotated
                # declaration from a COMPREHENSION. Its type is the projection's, which
                # needs the binder in scope; see comprehension_result_type.
                if new_local_type.kind == TypeKind.Unmodeled:
                    if assign_value is Expr.Comprehension(new_comp_var, new_comp_iter, new_comp_cond, new_comp_body, new_comp_line):
                        new_local_type <- comprehension_result_type(new_comp_var, new_comp_iter, new_comp_body, local_scope, fns, structs, generics)
                if new_local_type.kind == TypeKind.Unmodeled:
                    new_local_candidate: ValueType = literal_container_type(assign_value, local_scope, fns, structs, generics)
                    # FLAT literals only. stage0 infers `values = [1, 2, 3, 4]` but
                    # REJECTS a nested one -- "cannot infer element type for empty darray
                    # builder \"m\"" for `m = [[1, 2], [3, 4]]`. literal_container_type
                    # derives the nested shape happily, so taking it unrestricted made
                    # stage1 compile and run a program stage0 refuses (answering 3, the
                    # right value, but PERMISSIVE -- the direction the gate ratchets at
                    # zero). An element type that is ITSELF a container keeps declining.
                    if new_local_candidate.kind == TypeKind.DArray:
                        new_local_type <- new_local_candidate if darray_element_of(new_local_candidate, structs).kind != TypeKind.DArray else new_local_type
                if new_local_type.kind != TypeKind.Unmodeled:
                    if emit_expression(assign_value, new_local_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is new_local_value:
                        new_local_storage: mutable darray[u8] = []
                        new_local_slot: LLVMValueRef = build_entry_alloca(builder, llvm_type_of(new_local_type, structs, ctx), sview_to_cstr(new_local_name, new_local_storage))
                        _ = LLVMBuildStore(builder, new_local_value, new_local_slot)
                        declare_local(local_scope, new_local_name, new_local_slot, new_local_type)
                        return EmitStatus.Open
                    return EmitStatus.Declined
            EmitStatus.Declined return if assign_operator != TokenKind.LArrow
            if assign_target is Expr.Ident(target_name, target_line):
                slot_opt: LLVMValueRef? = lookup_slot(local_scope, target_name)
                target_declared_type: ValueType = lookup_type(local_scope, target_name)
                if slot_opt is slot:
                    # `a <- v` where `a: mutable T&` — store v THROUGH the reference (into
                    # its pointee), NOT overwrite the reference itself. The slot holds a
                    # pointer; load it, then store the value at the pointee type (a ref-typed
                    # `v` auto-dereferences to its value).
                    if target_declared_type.kind == TypeKind.Ref:
                        # `r: mutable T& = v; r <- v2` — the LOCAL BINDING itself was
                        # declared `mutable`, which stage0 treats as REBINDING the
                        # reference (the assignment's target type is `T&` itself, not
                        # its pointee) rather than writing through it. `v2` must
                        # therefore be a T&-typed value; a plain T (e.g. `r <- 99` where
                        # `r: mutable i64&`) correctly DECLINES here exactly as it
                        # should reject at the type-check stage0 performs (`cannot
                        # assign int to mutable i64&`) — emit_expression below simply
                        # cannot produce a Ref-typed value from a plain scalar literal.
                        # A non-mutable-declared local (the overwhelmingly common case,
                        # `r: T& = v`) is UNCHANGED below: local_binding_is_mutable is
                        # false for every local except this one annotation shape.
                        if local_binding_is_mutable(local_scope, target_name):
                            if emit_expression_coerced(assign_value, target_declared_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is rebind_ref_value:
                                _ = LLVMBuildStore(builder, rebind_ref_value, slot)
                                return EmitStatus.Open
                            return EmitStatus.Declined
                        ref_assign_pointee: ValueType = ref_target_of(target_declared_type, structs)
                        # A mutating receiver may be written with the rebind spelling
                        # (`lexer <- lexer.pending_push_back(token)`). The method changes
                        # the pointee in place and returns void; there is no value to store
                        # back through the reference. Otherwise LLVM's void placeholder
                        # can escape into a `store` as `store void <badref>`.
                        ref_assign_value_type: ValueType = expression_type(assign_value, local_scope, fns, structs, generics)
                        ref_assign_is_void: mutable bool = ref_assign_value_type.kind == TypeKind.Void
                        # `Expr.If` has no standalone expression type because ordinary
                        # value-if arms are context-typed. For a reference rebind, inspect
                        # both arms so a void/void conditional is still recognized as a
                        # mutation rather than forced into the pointee type.
                        if assign_value is Expr.If(ref_if_condition, ref_if_then, ref_if_else, ref_if_line):
                            ref_if_then_type: ValueType = expression_type(ref_if_then, local_scope, fns, structs, generics)
                            ref_if_else_type: ValueType = expression_type(ref_if_else, local_scope, fns, structs, generics)
                            ref_assign_is_void <- ref_if_then_type.kind == TypeKind.Void and ref_if_else_type.kind == TypeKind.Void
                        if ref_assign_is_void:
                            if emit_expression(assign_value, ValueType{kind: TypeKind.Void, bits: 0}, local_scope, fns, structs, generics, runtime, m, ctx, builder) is ref_mutation_value:
                                _ = ref_mutation_value
                                return EmitStatus.Open
                            return EmitStatus.Declined
                        if emit_expression(assign_value, ref_assign_pointee, local_scope, fns, structs, generics, runtime, m, ctx, builder) is ref_assign_value:
                            ref_assign_ptr: LLVMValueRef = LLVMBuildLoad2(builder, LLVMPointerTypeInContext(ctx, 0), slot, "ref.assign.ptr")
                            _ = LLVMBuildStore(builder, ref_assign_value, ref_assign_ptr)
                            return EmitStatus.Open
                        return EmitStatus.Declined
                    # An aggregate-returning call assigned to an existing large local can reuse
                    # that local's storage as the sret destination. The callee has already made
                    # its private value copy for aggregate parameters, so aliasing this result
                    # slot with the source local preserves value semantics and removes a giant
                    # aggregate load/store pair.
                    if value_type_uses_sret(target_declared_type, structs, ctx) and assign_value is Expr.Call(assign_call_callee, assign_call_arguments, assign_call_argument_names, assign_call_line):
                        match assign_call_callee:
                            Expr.Ident(assign_call_name, assign_call_name_line):
                                assign_direct_status: i64 = emit_direct_call_into_sret("", assign_call_name, assign_call_callee, false, assign_call_arguments, assign_call_argument_names, slot, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                                return EmitStatus.Open if assign_direct_status == 1
                                EmitStatus.Declined return if assign_direct_status < 0
                            Expr.Scope(assign_call_scope_head, assign_call_name, assign_call_scope_line):
                                if assign_call_scope_head is Expr.Ident(assign_call_module, assign_call_module_line):
                                    assign_direct_status: i64 = emit_direct_call_into_sret(module_alias_target(assign_call_module, structs), assign_call_name, assign_call_callee, false, assign_call_arguments, assign_call_argument_names, slot, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                                    return EmitStatus.Open if assign_direct_status == 1
                                    EmitStatus.Declined return if assign_direct_status < 0
                            _:
                                pass
                    # `out <- v` where `out: mutable T&?` — an OPTIONAL out-parameter,
                    # written THROUGH its payload pointer after a null guard (the system
                    # bridge's `out_ratio <- 1.0`). Same as the ref case above, one
                    # unwrap deeper: the slot holds `{i1, ptr}`, so the pointer is
                    # payload field 1 rather than the slot's whole value.
                    #
                    # The DANGEROUS neighbour is rebinding: `r <- r.next` on a
                    # `heap Node&?` cursor stores a new POINTER into the slot, and the
                    # arena's list walk depends on it. stage0 disambiguates on the
                    # VALUE's type — a pointee-typed value writes through, a
                    # pointer-typed one rebinds — so a null literal, a ref, an optional
                    # or a cstr all stay on the rebind path below.
                    #
                    # Scoped tighter than stage0: only a NUMERIC/bool pointee, which is
                    # the whole out-parameter idiom in the runtime. Anything else keeps
                    # its current behaviour rather than being guessed at, because
                    # choosing wrong here miscompiles silently in both directions.
                    if target_declared_type.kind == TypeKind.Optional:
                        opt_out_payload: ValueType = optional_payload_of(target_declared_type, structs)
                        if opt_out_payload.kind == TypeKind.Ref:
                            opt_out_pointee: ValueType = ref_target_of(opt_out_payload, structs)
                            opt_out_value_type: ValueType = expression_type(assign_value, local_scope, fns, structs, generics)
                            opt_out_value_is_pointer: bool = is_null_literal(assign_value) or opt_out_value_type.kind == TypeKind.Ref or opt_out_value_type.kind == TypeKind.Optional or opt_out_value_type.kind == TypeKind.CStr
                            if not opt_out_value_is_pointer and (is_numeric_type(opt_out_pointee) or opt_out_pointee.kind == TypeKind.Bool):
                                if emit_expression(assign_value, opt_out_pointee, local_scope, fns, structs, generics, runtime, m, ctx, builder) is opt_out_value:
                                    opt_out_llvm: LLVMTypeRef = llvm_type_of(target_declared_type, structs, ctx)
                                    opt_out_loaded: LLVMValueRef = LLVMBuildLoad2(builder, opt_out_llvm, slot, "opt.out.load")
                                    opt_out_ptr: LLVMValueRef = optional_payload_value_of(opt_out_loaded, target_declared_type, structs, ctx, builder)
                                    _ = LLVMBuildStore(builder, opt_out_value, opt_out_ptr)
                                    return EmitStatus.Open
                                return EmitStatus.Declined
                    assignment_value_type: mutable ValueType = expression_type(assign_value, local_scope, fns, structs, generics)
                    if assignment_value_type.kind == TypeKind.Unmodeled and assign_value is Expr.Call(assignment_callee, assignment_method_args, _, _):
                        match assignment_callee:
                            Expr.Field(_, assignment_method_name, _):
                                assignment_method_type: mutable ValueType = lookup_return_type(fns, "Parser", assignment_method_name)
                                assignment_method_type <- lookup_return_type(fns, "", assignment_method_name) if assignment_method_type.kind == TypeKind.Unmodeled
                                assignment_method_index: mutable i64 = function_index_of_arity(fns, "Parser", assignment_method_name, assignment_method_args.count + 1)
                                assignment_method_index <- function_index_of(fns, "Parser", assignment_method_name) if assignment_method_index < 0
                                assignment_method_type <- copied_type(fns.returns[assignment_method_index.usize()]) if assignment_method_index >= 0
                                assignment_method_type <- ValueType{kind: TypeKind.Void, bits: 0} if assignment_method_name == "skip_newlines"
                                assignment_value_type <- assignment_method_type if assignment_method_type.kind != TypeKind.Unmodeled
                            _:
                                pass
                    if assignment_value_type.kind == TypeKind.Void:
                        if emit_expression(assign_value, assignment_value_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is assignment_void_value:
                            _ = assignment_void_value
                            return EmitStatus.Open
                        return EmitStatus.Declined
                    new_value: LLVMValueRef? = emit_expression_coerced(assign_value, target_declared_type, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                    if new_value is assigned:
                        _ = LLVMBuildStore(builder, assigned, slot)
                        emit_trace_value(target_name, target_line.line, assigned, target_declared_type, runtime, ctx, builder)
                        return EmitStatus.Open
                mutable_global_index: i64 = mutable_global_index_of(structs, target_name)
                if mutable_global_index >= 0:
                    mutable_global_type: ValueType = copied_type(structs.mutable_global_types[mutable_global_index.usize()])
                    if emit_expression_coerced(assign_value, mutable_global_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is mutable_global_value:
                        _ = LLVMBuildStore(builder, mutable_global_value, structs.mutable_global_handles[mutable_global_index.usize()])
                        return EmitStatus.Open
                # A definition owns the storage whenever a declaration-only
                # extern with the same C link name is also present.
                extern_global_index: i64 = extern_global_index_of(structs, target_name)
                if extern_global_index >= 0:
                    extern_global_type: ValueType = copied_type(structs.extern_global_types[extern_global_index.usize()])
                    if emit_expression_coerced(assign_value, extern_global_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is extern_global_value:
                        _ = LLVMBuildStore(builder, extern_global_value, structs.extern_global_handles[extern_global_index.usize()])
                        return EmitStatus.Open
            matched <- false
            return EmitStatus.Declined
