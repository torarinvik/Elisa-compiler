extend Backend:
    private:
        # Parameter defaults are evaluated in the declaring module with parameters and
        # caller locals out of scope. Use an empty lexical scope and temporarily restore the
        # callee owner (plus generic bindings when present) while emitting the expression.
        def push_struct_default_type_bindings(struct_slot: i64, structs: mutable StructTable&) -> i64 can[Abort.Panic, Memory.Allocate]:
            return 0 if struct_slot < 0
            return -1 if struct_slot.usize() >= structs.records.names.count or struct_slot.usize() >= structs.records.owners.count
            struct_name: sview = structs.records.names[struct_slot.usize()]
            struct_owner: sview = structs.records.owners[struct_slot.usize()]
            template_index: i64 = generic_struct_index_of_owned(structs, struct_owner, struct_name)
            return 0 if template_index == -1
            return -1 if template_index < 0
            template_row: usize = template_index.usize()
            return -1 if template_row >= structs.generics.generic_struct_param_start.count or template_row >= structs.generics.generic_struct_param_count.count
            template_id: u32 = (template_row + 1.usize()).u32()
            instance: mutable usize = generic_inst_first_row(structs, struct_slot.usize())
            found_instance: mutable i64 = -1
            while instance < structs.generics.generic_struct_inst_index.count |instance, structs, struct_slot, template_id, found_instance|:
                if structs.generics.generic_struct_inst_index[instance] == struct_slot.usize() and generic_instance_template_id(instance, structs) == template_id:
                    found_instance <- instance.i64()
                    break
                instance <- generic_inst_next_row(structs, instance)
            return -1 if found_instance < 0
            instance_row: usize = found_instance.usize()
            return -1 if:
                instance_row >= structs.generics.generic_struct_inst_arg_start.count or instance_row >= structs.generics.generic_struct_inst_arg_count.count or instance_row >= structs.generics.generic_struct_inst_ready.count
                not structs.generics.generic_struct_inst_ready[instance_row]
            param_start: usize = structs.generics.generic_struct_param_start[template_row]
            param_count: usize = structs.generics.generic_struct_param_count[template_row]
            arg_start: usize = structs.generics.generic_struct_inst_arg_start[instance_row]
            arg_count: usize = structs.generics.generic_struct_inst_arg_count[instance_row]
            return -1 if:
                arg_count != param_count or param_start > structs.generics.generic_struct_param_names.count or param_count > structs.generics.generic_struct_param_names.count - param_start
                arg_start > structs.generics.generic_struct_inst_args.count or arg_count > structs.generics.generic_struct_inst_args.count - arg_start
            for position in 0..<param_count |structs, param_start, arg_start|:
                structs.bindings.binding_names <- structs.bindings.binding_names.push(structs.generics.generic_struct_param_names[param_start + position])
                structs.bindings.binding_types <- structs.bindings.binding_types.push(copied_type(structs.generics.generic_struct_inst_args[arg_start + position]))
            return param_count.i64()


        def emit_call_default_argument[@type_args_region, @fns_region, @structs_region, @generics_region, @runtime_region](expression: Expr, wanted: ValueType, owner: sview @source, generic_slot: i64, struct_slot: i64, type_args: darray[ValueType]& @type_args_region, fns: FnTable& @fns_region, structs: mutable StructTable& @structs_region, generics: mutable GenericTable& @generics_region, runtime: Runtime& @runtime_region, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Global{Read,Write}]:
            saved_struct_owner: sview = structs.visibility.current_owner
            saved_source_offset: u32 = structs.visibility.current_source_offset
            saved_generic_owner: sview @source = generics.current_owner
            return null if:
                generic_slot >= 0 and struct_slot >= 0
                structs.bindings.binding_names.count != structs.bindings.binding_types.count
            # Detach the caller's bindings (their storage stays in structs' region) and restore
            # the same arrays afterwards; the default argument is emitted against fresh ones.
            saved_binding_names: darray[sview @source] = structs.bindings.binding_names
            saved_binding_types: darray[ValueType] = structs.bindings.binding_types
            structs.bindings.binding_names <- []
            structs.bindings.binding_types <- []
            structs.visibility.current_owner <- owner
            structs.visibility.current_source_offset <- Ast::expr_pos(expression).offset
            generics.current_owner <- owner
            binding_count: mutable usize = 0
            bindings_valid: mutable bool = true
            if generic_slot >= 0:
                if generic_slot.usize() >= generics.names.count or generic_slot.usize() >= generics.param_start.count or generic_slot.usize() >= generics.param_count.count:
                    bindings_valid <- false
                else:
                    binding_count <- push_type_bindings(generics, structs, generic_slot.usize(), type_args)
                    bindings_valid <- binding_count == generics.param_count[generic_slot.usize()]
            elif struct_slot >= 0:
                struct_binding_count: i64 = push_struct_default_type_bindings(struct_slot, structs)
                if struct_binding_count < 0:
                    bindings_valid <- false
                else:
                    binding_count <- struct_binding_count.usize()
            default_value: mutable LLVMValueRef? = null
            if bindings_valid:
                # The empty scope can feed either independently owned cache table.
                in source:
                    default_scope: mutable Scope = Scope{names: [], slots: [], types: [], pool_names: [], group_names: [], deferred: []}
                    if (indirect_aggregate_argument_address(expression, wanted, &default_scope, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}) is default_address:
                        default_value <- default_address
                    elif (emit_expression_coerced(expression, wanted, &default_scope, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}) is emitted_default:
                        default_value <- materialize_indirect_aggregate_argument(emitted_default, wanted, structs, ctx, builder)
            structs.bindings.binding_names <- saved_binding_names
            structs.bindings.binding_types <- saved_binding_types
            structs.visibility.current_owner <- saved_struct_owner
            structs.visibility.current_source_offset <- saved_source_offset
            generics.current_owner <- saved_generic_owner
            return default_value


        # Resolve a declared program region to its module-level arena global. Its
        # zero initializer is a valid lazy Arena value, and LinkOnceAny makes
        # separately compiled objects share the same process-lived region.
        def program_region_arena(name: sview, structs: mutable StructTable&, m: LLVMModuleRef, ctx: LLVMContextRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            program_region_count: usize = structs.regions.program_region_names.count
            for program_region_index in 0..<program_region_count |program_region_count, program_region_index, name|:
                continue if structs.regions.program_region_names[program_region_index] != name
                symbol_bytes: mutable darray[u8] = []
                _ = dbg_push_sview(symbol_bytes, "__elisa_program_region.")
                _ = dbg_push_sview(symbol_bytes, name)
                symbol: sview = bytes_view_range(symbol_bytes, 0, symbol_bytes.count)
                symbol_storage: mutable darray[u8] = []
                symbol_cstr: cstr = sview_to_cstr(symbol, symbol_storage)
                if LLVMGetNamedGlobal(m, symbol_cstr) is existing_global:
                    return existing_global
                arena_llvm_type: LLVMTypeRef = llvm_type_of(ValueType{kind: TypeKind.Arena, bits: 0}, structs, ctx)
                arena_global: LLVMValueRef = LLVMAddGlobal(m, arena_llvm_type, symbol_cstr)
                LLVMSetInitializer(arena_global, LLVMConstNull(arena_llvm_type))
                LLVMSetLinkage(arena_global, 2) # LLVMLinkOnceAnyLinkage
                return arena_global
            return null


        # Resolve one actual region selector to the arena value passed by its caller.
        # A local region is stored directly in an Arena slot; an Arena reference needs one
        # load; a region parameter is itself one of this function's hidden arena arguments.
        def explicit_region_call_arena(name: sview, local_scope: mutable Scope&, runtime: Runtime&, structs: mutable StructTable&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            local_index: i64 = lookup_index(local_scope, name)
            if local_index >= 0:
                local_type: ValueType = local_scope.types[local_index.usize()]
                if lookup_slot(local_scope, name) is local_slot:
                    if local_type.kind == TypeKind.Arena:
                        return local_slot
                    if local_type.kind == TypeKind.Ref and ref_target_of(local_type, structs).kind == TypeKind.Arena:
                        return LLVMBuildLoad2(builder, LLVMPointerTypeInContext(ctx, 0), local_slot, "region.argument")
                # A parameter may share its region's name (`[@s](s: Sess[s]&)`); a selector then
                # names the region. A body-local value shadows the hidden slot.
                return null if local_index.usize() >= local_scope.source_parameter_count
            parameter_index: i64 = region_parameter_index(runtime.function_line, runtime.function_offset, name, runtime.caller_region_parameter_start, structs)
            if parameter_index >= 0 and parameter_index.usize() < runtime.caller_arenas.count:
                return runtime.caller_arenas[parameter_index.usize()]
            # `perm` without a local binding denotes the process-lifetime arena, matching
            # the existing `in perm:` lowering.
            if name == "perm" and local_index < 0:
                perm_index: i64 = mutable_global_index_of(structs, "perm_arena")
                if perm_index >= 0 and perm_index.usize() < structs.globals.mutable_global_handles.count:
                    return structs.globals.mutable_global_handles[perm_index.usize()]
            if local_index < 0:
                return program_region_arena(name, structs, m, ctx)
            return null



include "./codegen_call_indexed_result.elisa"
include "./codegen_call_indexed_helpers.elisa"
