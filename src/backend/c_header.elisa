# C ABI header generation for the stage1 backend.
#
# This is intentionally driven by the same resolved ValueType/StructTable used by LLVM
# emission. It does not guess from source spelling: an unsupported exported type returns
# false so callers cannot publish a header whose declarations disagree with the object ABI.

extend Backend:
    private:
        def header_push(out: mutable darray[u8]&, text: sview) -> void can[Abort.Panic, Memory.Allocate]:
            out.extend(text)


        def header_public_struct_name(file: Ast::File&, internal_name: sview) -> sview can[Abort.Panic]:
            for annotation in file.enum_annotations |internal_name|:
                if annotation.name != "__export_type" and annotation.name == internal_name:
                    return annotation.owner
            return internal_name


        def header_type_name(file: Ast::File&, value_type: ValueType, structs: mutable StructTable&, out: mutable darray[u8]&) -> bool can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic, Memory.Allocate:
                if value_type.kind == TypeKind.Signed:
                    header_push(out, "intptr_t" if value_type.bits == 64 else ("int32_t" if value_type.bits == 32 else ("int16_t" if value_type.bits == 16 else "int8_t")))
                    return true
                if value_type.kind == TypeKind.Unsigned:
                    header_push(out, "uintptr_t" if value_type.bits == 64 else ("uint32_t" if value_type.bits == 32 else ("uint16_t" if value_type.bits == 16 else "uint8_t")))
                    return true
                if value_type.kind == TypeKind.Bool:
                    return false
                if value_type.kind == TypeKind.Void:
                    header_push(out, "void")
                    return true
                if value_type.kind == TypeKind.Float:
                    header_push(out, "float" if value_type.bits == 32 else "double")
                    return true
                if value_type.kind == TypeKind.Struct:
                    header_push(out, header_public_struct_name(file, structs.names[value_type.bits.usize()]))
                    return true
                if value_type.kind == TypeKind.Ref:
                    # The `*` belongs to the DECLARATOR, not the type: stage0's formatCDecl
                    # prepends it to the name and recurses on the referent, so a pointer
                    # prints `T *name`. Emitting it here produced `T* name`, and for a
                    # pointer-to-array it would drop the parentheses C requires entirely.
                    # header_pointer_depth supplies the stars at the name.
                    target: ValueType = copied_type(structs.ref_targets[value_type.bits.usize()])
                    false return if target.kind == TypeKind.Array
                    return header_type_name(file, target, structs, out)
                if value_type.kind == TypeKind.Optional:
                    # A niche optional reference is represented at the C boundary by the
                    # nullable pointer itself, not by Elisa's `{tag, payload}` pair. The
                    # semantic/backend paths already use the same rule for native externs;
                    # keep header emission in lockstep so a published field has the same
                    # layout as the object ABI (`u8&?` -> `uint8_t *field`).
                    payload: ValueType = copied_type(structs.optional_targets[value_type.bits.usize()])
                    false return if payload.kind != TypeKind.Ref
                    return header_type_name(file, payload, structs, out)
                if value_type.kind == TypeKind.Array:
                    element: ValueType = copied_type(structs.array_elements[value_type.bits.usize()])
                    return header_type_name(file, element, structs, out)
                return false


        # The C spelling for a SOURCE type name, mirroring stage0's cBuiltinTypeName.
        #
        # This exists because ValueType cannot tell `i64` from `isize`: both are Signed/64, and
        # header_type_name therefore printed `intptr_t` for BOTH. That is not merely a spelling
        # difference — an `i64` parameter declared `intptr_t` is 32-bit on a 32-bit target, so
        # the published header would disagree with the object ABI, which is the exact failure
        # this file's own header comment says it must never produce.
        #
        # Only the extern/export signature sites have the source name; struct fields still go
        # through the ValueType path. Answers false when the name is not a builtin scalar, so
        # the caller falls back.
        def header_c_name_for_source_type(type_name: sview, out: mutable darray[u8]&) -> bool can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic, Memory.Allocate:
                if type_name == "void":
                    header_push(out, "void")
                    return true
                if type_name == "char" or type_name == "i64":
                    header_push(out, "int64_t")
                    return true
                if type_name == "int" or type_name == "isize":
                    header_push(out, "intptr_t")
                    return true
                if type_name == "usize" or type_name == "uintptr":
                    header_push(out, "uintptr_t")
                    return true
                if type_name == "u64":
                    header_push(out, "uint64_t")
                    return true
                if type_name == "i8" or type_name == "u8" or type_name == "i16" or type_name == "u16" or type_name == "i32" or type_name == "u32":
                    header_push(out, "uint" if sview_at(type_name, 0) == 117 else "int")
                    header_push(out, "8_t" if sview_len(type_name) == 2 else ("16_t" if sview_at(type_name, 1) == 49 else "32_t"))
                    return true
                if type_name == "f32":
                    header_push(out, "float")
                    return true
                if type_name == "f64":
                    header_push(out, "double")
                    return true
                return false


        # The head name of a type expression: `i64` -> "i64", `mutable T` -> T's head,
        # anything structural -> "". A local copy of Semantic::bare_type_name, which the
        # backend cannot see.
        def header_bare_type_name(expression: Ast::Expr) -> sview can[Abort.Panic]:
            if expression is Expr.Unary(hbt_operator, hbt_operand, hbt_line):
                header_bare_type_name(hbt_operand) return if hbt_operator == TokenKind.Mutable
                return ""
            hbt_name return if expression is Expr.Ident(hbt_name, hbt_ident_line)
            return ""


        # The SOURCE type name of a struct field, from the AST, or "" when the struct or
        # field is not found (a synthesized tuple struct, an instantiation, …).
        #
        # This exists for the same reason header_c_name_for_source_type does: ValueType
        # cannot tell `i64` from `isize` — both are Signed/64 — so the ValueType path
        # prints `intptr_t` for both. The signature sites were fixed by consulting the
        # source name; STRUCT FIELDS were left on the ValueType path, so an exported
        # `layout(c)` struct with an `i64` field published `intptr_t left;` where stage0
        # writes `int64_t left;`. On a 32-bit target those are different widths, which is
        # exactly the object-ABI disagreement this file must never publish.
        #
        # The corpus never caught it: none of the 56 fixtures exports a `layout(c)` struct
        # with an i64 field, so `-emit header` measured byte-identical anyway.
        def header_field_source_type(file: Ast::File&, struct_name: sview, field_name: sview) -> sview can[Abort.Panic]:
            return header_field_source_type_in(file.top_decls, struct_name, field_name)


        def header_field_source_type_in(declarations: darray[Ast::Decl]&, struct_name: sview, field_name: sview) -> sview can[Abort.Panic]:
            for declaration in declarations:
                if declaration is Decl.Struct(hfs_name, hfs_members, hfs_affinity, hfs_named_states, hfs_derive, hfs_invariants, hfs_line):
                    continue if hfs_name != struct_name
                    for hfs_member in hfs_members:
                        header_bare_type_name(hfs_member.type_expression) return if hfs_member.name == field_name
                    return ""
                if declaration is Decl.Module(hfs_m_name, hfs_m_body, hfs_m_line):
                    found: sview = header_field_source_type_in(hfs_m_body, struct_name, field_name)
                    found return if found != ""
                if declaration is Decl.Scoped(hfs_s_body, hfs_s_line):
                    found: sview = header_field_source_type_in(hfs_s_body, struct_name, field_name)
                    found return if found != ""
            return ""


        # header_decl, but preferring the field's SOURCE type name when it names a builtin
        # scalar. Falls back to the ValueType path for everything else (structs, refs,
        # arrays), which is where the source spelling carries no extra information.
        def header_field_decl(file: Ast::File&, value_type: ValueType, struct_name: sview, field_name: sview, structs: mutable StructTable&, out: mutable darray[u8]&) -> bool can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic, Memory.Allocate:
                if value_type.kind == TypeKind.Signed or value_type.kind == TypeKind.Unsigned:
                    source_name: sview = header_field_source_type(file, struct_name, field_name)
                    if source_name != "" and header_c_name_for_source_type(source_name, out):
                        out.push(32)
                        header_push(out, field_name)
                        header_push(out, ";")
                        return true
                return header_decl(file, value_type, field_name, structs, out)


        # How many `*` a declarator needs, and the type left underneath them. Kept separate
        # from header_type_name because C binds the star to the NAME (`T *x`), so the two
        # halves are emitted at different points.
        def header_pointer_depth(value_type: ValueType, structs: mutable StructTable&) -> i64 can[Abort.Panic]:
            can Abort.Panic:
                depth: mutable i64 = 0
                cursor: mutable ValueType = copied_type(value_type)
                if cursor.kind == TypeKind.Optional:
                    payload: ValueType = copied_type(structs.optional_targets[cursor.bits.usize()])
                    cursor <- payload
                while cursor.kind == TypeKind.Ref |cursor, depth, structs|:
                    depth <- depth + 1
                    cursor <- copied_type(structs.ref_targets[cursor.bits.usize()])
                return depth


        # Render a declaration without its trailing semicolon. Function values are
        # represented as raw function pointers at a layout(c) boundary, so a field such
        # as `cb: fn(void&, i32) -> void` becomes `void (*cb)(void *, int32_t)`.
        def header_named_decl(file: Ast::File&, value_type: ValueType, name: sview, structs: mutable StructTable&, out: mutable darray[u8]&) -> bool can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic, Memory.Allocate:
                if value_type.kind == TypeKind.Fn:
                    return header_function_pointer_decl(file, value_type, name, structs, out)
                false return if not header_type_name(file, value_type, structs, out)
                out.push(32)
                for _star in 0..<header_pointer_depth(value_type, structs) |out|:
                    out.push(42)
                header_push(out, name)
                array_type: mutable ValueType = copied_type(value_type)
                while array_type.kind == TypeKind.Array |array_type, structs, out|:
                    header_push(out, "[")
                    header_push_int(out, structs.array_extents[array_type.bits.usize()].i64())
                    out.push(93)
                    array_type <- copied_type(structs.array_elements[array_type.bits.usize()])
                return true


        def header_function_pointer_decl(file: Ast::File&, value_type: ValueType, name: sview, structs: mutable StructTable&, out: mutable darray[u8]&) -> bool can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic, Memory.Allocate:
                false return if value_type.kind != TypeKind.Fn
                false return if value_type.bits.usize() >= structs.fn_pool_returns.count
                return_type: ValueType = copied_type(structs.fn_pool_returns[value_type.bits.usize()])
                false return if not header_type_name(file, return_type, structs, out)
                header_push(out, " (*")
                header_push(out, name)
                header_push(out, ")(")
                param_start: usize = structs.fn_pool_param_start[value_type.bits.usize()]
                param_count: usize = structs.fn_pool_param_count[value_type.bits.usize()]
                for param_index in 0..<param_count |file, value_type, structs, out, param_start, param_count|:
                    header_push(out, ", ") if param_index > 0
                    parameter: ValueType = copied_type(structs.fn_pool_params[param_start + param_index])
                    false return if not header_function_parameter_decl(file, parameter, param_index, structs, out)
                header_push(out, ")")
                return true


        def header_function_parameter_decl(file: Ast::File&, value_type: ValueType, index: usize, structs: mutable StructTable&, out: mutable darray[u8]&) -> bool can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic, Memory.Allocate:
                false return if not header_type_name(file, value_type, structs, out)
                out.push(32)
                for _star in 0..<header_pointer_depth(value_type, structs) |out|:
                    out.push(42)
                header_push(out, "arg")
                header_push_int(out, index.i64())
                array_type: mutable ValueType = copied_type(value_type)
                while array_type.kind == TypeKind.Array |array_type, structs, out|:
                    header_push(out, "[")
                    header_push_int(out, structs.array_extents[array_type.bits.usize()].i64())
                    out.push(93)
                    array_type <- copied_type(structs.array_elements[array_type.bits.usize()])
                return true


        def header_decl(file: Ast::File&, value_type: ValueType, name: sview, structs: mutable StructTable&, out: mutable darray[u8]&) -> bool can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic, Memory.Allocate:
                false return if not header_named_decl(file, value_type, name, structs, out)
                out.push(59)
                return true


        def header_push_int(out: mutable darray[u8]&, value: i64) -> void can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic, Memory.Allocate:
                if value < 0:
                    out.push(45)
                    header_push_int(out, 0 - value)
                    return
                if value >= 10:
                    header_push_int(out, value / 10)
                out.push((48 + (value % 10)).u8())


        def header_exported_struct(file: Ast::File&, struct_name: sview, structs: mutable StructTable&, out: mutable darray[u8]&) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate:
                struct_index: i64 = struct_index_of(structs, struct_name)
                false return if struct_index < 0
                public_name: sview = header_public_struct_name(file, struct_name)
                header_push(out, "struct ")
                header_push(out, public_name)
                header_push(out, " {\n")
                slot: usize = struct_index.usize()
                for field_offset in 0..<structs.field_count[slot] |file, struct_name, structs, out, slot|:
                    field_type: ValueType = copied_type(structs.field_types[structs.field_start[slot] + field_offset])
                    # FOUR spaces, as stage0 writes.
                    for _indent in 0..<4 |out|:
                        out.push(32)
                    false return if not header_field_decl(file, field_type, struct_name, structs.field_names[structs.field_start[slot] + field_offset], structs, out)
                    out.push(10)
                alignment: u32 = struct_alignment(ValueType{kind: TypeKind.Struct, bits: slot.u32()}, structs)
                if alignment != 0:
                    header_push(out, "} __attribute__((aligned(")
                    header_push_int(out, alignment.i64())
                    header_push(out, ")));\n\n")
                else:
                    header_push(out, "};\n\n")
                return true


        def header_forward_struct(file: Ast::File&, struct_name: sview, structs: mutable StructTable&, out: mutable darray[u8]&) -> bool can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic, Memory.Allocate:
                false return if struct_index_of(structs, struct_name) < 0
                public_name: sview = header_public_struct_name(file, struct_name)
                header_push(out, "typedef struct ")
                header_push(out, public_name)
                header_push(out, " ")
                header_push(out, public_name)
                header_push(out, ";\n")
                return true


        def header_type_from_name(type_name: sview, structs: mutable StructTable&) -> ValueType can[Abort.Panic]:
            can Abort.Panic:
                scalar: ValueType = scalar_type_of_name(type_name)
                scalar return if scalar.kind != TypeKind.Unmodeled
                struct_index: i64 = struct_index_of(structs, type_name)
                ValueType{kind: TypeKind.Struct, bits: struct_index.u32()} return if struct_index >= 0
                return unmodeled_type()


        def header_global_type(structs: mutable StructTable&, name: sview) -> ValueType can[Abort.Panic]:
            can Abort.Panic:
                mutable_index: i64 = mutable_global_index_of(structs, name)
                copied_type(structs.mutable_global_types[mutable_index.usize()]) return if mutable_index >= 0
                const_index: i64 = const_index_of(structs, name)
                copied_type(structs.const_types[const_index.usize()]) return if const_index >= 0
                return unmodeled_type()


        # The PUBLIC name an export was given, or the internal name when it has none.
        #
        # The alias is recorded as a SEPARATE annotation from the `__export_*` marker, and
        # the two can appear in either order. Returning `target` as soon as the MARKER was
        # seen therefore answered the internal name whenever the marker came first —
        # `export global seed as ctx_seed` published `extern ... seed;`, a symbol no
        # consumer can link against. Scan for the alias across the whole table before
        # falling back.
        def header_export_alias(file: Ast::File&, target: sview, marker: sview) -> sview can[Abort.Panic]:
            for annotation in file.enum_annotations |target|:
                if annotation.name == target and annotation.owner != target:
                    return annotation.owner
            return target


        # The SOURCE type name of a top-level global, for the same i64-vs-isize reason
        # header_field_source_type exists.
        def header_global_source_type(file: Ast::File&, global_name: sview) -> sview can[Abort.Panic]:
            return header_global_source_type_in(file.top_decls, global_name)


        def header_global_source_type_in(declarations: darray[Ast::Decl]&, global_name: sview) -> sview can[Abort.Panic]:
            for declaration in declarations:
                # A `global` parses to Decl.Const with is_mutable set; there is no separate
                # Global variant.
                if declaration is Decl.Const(hgs_name, hgs_type, hgs_value, hgs_mutable, hgs_line):
                    header_bare_type_name(hgs_type) return if hgs_name == global_name
                if declaration is Decl.Module(hgs_m_name, hgs_m_body, hgs_m_line):
                    found: sview = header_global_source_type_in(hgs_m_body, global_name)
                    found return if found != ""
                if declaration is Decl.Scoped(hgs_s_body, hgs_s_line):
                    found: sview = header_global_source_type_in(hgs_s_body, global_name)
                    found return if found != ""
            return ""


        def header_exported_globals(file: Ast::File&, structs: mutable StructTable&, out: mutable darray[u8]&) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate:
                for annotation in file.enum_annotations |file, structs, out|:
                    continue if annotation.name != "__export_global"
                    target: sview = annotation.owner
                    public_name: sview = header_export_alias(file, target, "__export_global")
                    global_type: ValueType = header_global_type(structs, target)
                    false return if global_type.kind == TypeKind.Unmodeled
                    header_push(out, "extern ")
                    global_source: sview = header_global_source_type(file, target)
                    if global_source != "" and header_c_name_for_source_type(global_source, out):
                        out.push(32)
                        header_push(out, public_name)
                        out.push(59)
                    else:
                        false return if not header_decl(file, global_type, public_name, structs, out)
                    alignment: u32 = struct_alignment(global_type, structs)
                    if alignment != 0:
                        _ = out.pop()
                        header_push(out, " __attribute__((aligned(")
                        header_push_int(out, alignment.i64())
                        header_push(out, ")));" )
                    out.push(10)
                return true


        def header_exported_functions(file: Ast::File&, structs: mutable StructTable, out: mutable darray[u8]&) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate:
                out.reserve(out.count + file.top_decls.count)
                for declaration in file.top_decls |file, structs, out|:
                    if declaration is Decl.Extern(function_name, param_start, arity, variadic, callable, return_type_name, decorators, line):
                        is_export: mutable bool = false
                        for annotation in file.enum_annotations |is_export, function_name|:
                            is_export <- true if annotation.owner == function_name and annotation.name == "__export_fn"
                        continue if not is_export or not callable
                        return_type: ValueType = header_type_from_name(return_type_name, &structs)
                        return_pointer: mutable bool = false
                        for annotation in file.enum_annotations |return_pointer, function_name|:
                            return_pointer <- true if annotation.owner == "__extern_return_ptr" and annotation.name == function_name
                        false return if return_type.kind == TypeKind.Unmodeled
                        if not header_c_name_for_source_type(return_type_name, out):
                            false return if not header_type_name(file, return_type, &structs, out)
                        out.push(32)
                        for _return_star in 0..<header_pointer_depth(return_type, &structs) |out|:
                            out.push(42)
                        out.push(42) if return_pointer
                        header_push(out, function_name)
                        out.push(40)
                        # stage0 writes `void` for an empty parameter list — a bare `()` is an
                        # UNPROTOTYPED declaration in C, which silences argument checking at
                        # every call site in the consuming translation unit.
                        header_push(out, "void") if arity == 0
                        for parameter_index in 0..<arity.usize() |file, structs, out, param_start|:
                            header_push(out, ", ") if parameter_index > 0
                            parameter: ExternParam = file.extern_params[param_start.usize() + parameter_index]
                            parameter_type: ValueType = header_type_from_name(parameter.type_name, &structs)
                            false return if parameter_type.kind == TypeKind.Unmodeled
                            if not header_c_name_for_source_type(parameter.type_name, out):
                                false return if not header_type_name(file, parameter_type, &structs, out)
                            # A provenance-bearing param is a REFERENCE (`T&` / `lmut T`) and
                            # therefore a POINTER — the type_name side table keeps only the bare
                            # base name, dropping the `&` (codegen_declare documents the same
                            # trap). Without this the header declares `Vec2 arg0` where the
                            # object takes `Vec2 *arg0`: a different calling convention, so a
                            # caller compiled against this header corrupts the frame.
                            out.push(32)
                            out.push(42) if parameter.provenance_bearing
                            # stage0 names parameters POSITIONALLY (`arg0`, `arg1`). The Elisa
                            # parameter name is not part of the C ABI and need not be a valid
                            # C identifier.
                            header_push(out, "arg")
                            header_push_int(out, parameter_index.i64())
                        header_push(out, ");\n")
                return true


            # Collect every aggregate reachable from a public declaration. A C forward
            # declaration is enough for a reference, but a by-value field must be defined
            # before the containing struct. The root list and every strong dependency list are
            # sorted by public name, matching stage0's map-plus-topological-sort implementation.
        def header_add_unique_name(names: mutable darray[sview]&, name: sview) -> void can[Abort.Panic]:
            return if name_in_sview(names, name)
            names.push(name)


        def header_collect_reachable_type(file: Ast::File&, value_type: ValueType, structs: mutable StructTable&, roots: mutable darray[sview]&, seen: mutable darray[sview]&) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                if value_type.kind == TypeKind.Fn:
                    false return if value_type.bits.usize() >= structs.fn_pool_returns.count
                    false return if not header_collect_reachable_type(file, structs.fn_pool_returns[value_type.bits.usize()], structs, roots, seen)
                    param_start: usize = structs.fn_pool_param_start[value_type.bits.usize()]
                    param_count: usize = structs.fn_pool_param_count[value_type.bits.usize()]
                    for param_index in 0..<param_count |file, structs, roots, seen, param_start, param_count|:
                        false return if not header_collect_reachable_type(file, structs.fn_pool_params[param_start + param_index], structs, roots, seen)
                    return true
                if value_type.kind == TypeKind.Struct:
                    false return if value_type.bits.usize() >= structs.names.count
                    struct_name: sview = structs.names[value_type.bits.usize()]
                    header_add_unique_name(roots, struct_name)
                    true return if name_in_sview(seen, struct_name)
                    seen.push(struct_name)
                    struct_index: i64 = struct_index_of(structs, struct_name)
                    false return if struct_index < 0
                    field_start: usize = structs.field_start[struct_index.usize()]
                    field_count: usize = structs.field_count[struct_index.usize()]
                    for field_offset in 0..<field_count |file, structs, roots, seen, field_start, field_count|:
                        field_type: ValueType = copied_type(structs.field_types[field_start + field_offset])
                        false return if not header_collect_reachable_type(file, field_type, structs, roots, seen)
                    return true
                if value_type.kind == TypeKind.Array:
                    false return if value_type.bits.usize() >= structs.array_elements.count
                    return header_collect_reachable_type(file, structs.array_elements[value_type.bits.usize()], structs, roots, seen)
                if value_type.kind == TypeKind.Ref:
                    false return if value_type.bits.usize() >= structs.ref_targets.count
                    return header_collect_reachable_type(file, structs.ref_targets[value_type.bits.usize()], structs, roots, seen)
                if value_type.kind == TypeKind.Optional:
                    false return if value_type.bits.usize() >= structs.optional_targets.count
                    payload: ValueType = copied_type(structs.optional_targets[value_type.bits.usize()])
                    false return if payload.kind != TypeKind.Ref
                    return header_collect_reachable_type(file, payload, structs, roots, seen)
                return true


        def header_collect_strong_dependencies(value_type: ValueType, structs: mutable StructTable&, dependencies: mutable darray[sview]&) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                if value_type.kind == TypeKind.Struct:
                    false return if value_type.bits.usize() >= structs.names.count
                    header_add_unique_name(dependencies, structs.names[value_type.bits.usize()])
                    return true
                if value_type.kind == TypeKind.Array:
                    false return if value_type.bits.usize() >= structs.array_elements.count
                    return header_collect_strong_dependencies(structs.array_elements[value_type.bits.usize()], structs, dependencies)
                # References and niche optionals only need a forward declaration; their target
                # remains in the reachable root set, but it is not a definition dependency.
                return true


        def header_sort_by_public_name(file: Ast::File&, names: mutable darray[sview]&) -> void can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic:
                for slot in 0..<names.count |file, names|:
                    best: mutable usize = slot
                    for probe in (slot + 1)..<names.count |best, file, names|:
                        probe_public: sview = header_public_struct_name(file, names[probe])
                        best_public: sview = header_public_struct_name(file, names[best])
                        best <- probe if header_name_less(probe_public, best_public)
                    if best != slot:
                        swap: sview = names[slot]
                        names[slot] <- names[best]
                        names[best] <- swap


        def header_name_less(left: sview, right: sview) -> bool can[Abort.Panic]:
            shorter: usize = sview_len(left) if sview_len(left) < sview_len(right) else sview_len(right)
            for probe in 0..<shorter |left, right|:
                left_byte: u8 = sview_at(left, probe)
                right_byte: u8 = sview_at(right, probe)
                true return if left_byte < right_byte
                false return if left_byte > right_byte
            return sview_len(left) < sview_len(right)


        def header_collect_struct(file: Ast::File&, struct_name: sview, structs: mutable StructTable&, visiting: mutable darray[sview]&, ordered: mutable darray[sview]&) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                true return if name_in_sview(ordered, struct_name)
                false return if name_in_sview(visiting, struct_name)
                struct_index: i64 = struct_index_of(structs, struct_name)
                false return if struct_index < 0
                visiting.push(struct_name)
                dependencies: mutable darray[sview] = []
                field_start: usize = structs.field_start[struct_index.usize()]
                field_count: usize = structs.field_count[struct_index.usize()]
                for field_offset in 0..<field_count |structs, dependencies, field_start, field_count|:
                    field_type: ValueType = copied_type(structs.field_types[field_start + field_offset])
                    false return if not header_collect_strong_dependencies(field_type, structs, dependencies)
                header_sort_by_public_name(file, dependencies)
                for dependency in dependencies |file, structs, visiting, ordered, struct_name|:
                    continue if dependency == struct_name
                    false return if not header_collect_struct(file, dependency, structs, visiting, ordered)
                _ = visiting.pop()
                ordered.push(struct_name)
                return true


        def header_collect_public_aggregates(file: Ast::File&, structs: mutable StructTable&, ordered: mutable darray[sview]&) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            roots: mutable darray[sview] = []
            seen: mutable darray[sview] = []
            for annotation in file.enum_annotations |file, structs, roots, seen|:
                continue if annotation.name != "__export_type"
                exported_type: ValueType = header_type_from_name(annotation.owner, structs)
                false return if exported_type.kind == TypeKind.Unmodeled
                false return if not header_collect_reachable_type(file, exported_type, structs, roots, seen)
            for annotation in file.enum_annotations |file, structs, roots, seen|:
                continue if annotation.name != "__export_global"
                global_type: ValueType = header_global_type(structs, annotation.owner)
                false return if global_type.kind == TypeKind.Unmodeled
                false return if not header_collect_reachable_type(file, global_type, structs, roots, seen)
            for declaration in file.top_decls |file, structs, roots, seen|:
                if declaration is Decl.Extern(function_name, param_start, arity, variadic, callable, return_type_name, decorators, line):
                    is_export: mutable bool = false
                    for annotation in file.enum_annotations |is_export, function_name|:
                        is_export <- true if annotation.owner == function_name and annotation.name == "__export_fn"
                    continue if not is_export or not callable
                    return_type: ValueType = header_type_from_name(return_type_name, structs)
                    false return if return_type.kind == TypeKind.Unmodeled
                    false return if not header_collect_reachable_type(file, return_type, structs, roots, seen)
                    for parameter_index in 0..<arity.usize() |file, structs, roots, seen, param_start|:
                        parameter: ExternParam = file.extern_params[param_start.usize() + parameter_index]
                        parameter_type: ValueType = header_type_from_name(parameter.type_name, structs)
                        false return if parameter_type.kind == TypeKind.Unmodeled
                        false return if not header_collect_reachable_type(file, parameter_type, structs, roots, seen)
            header_sort_by_public_name(file, roots)
            visiting: mutable darray[sview] = []
            for root in roots |file, structs, visiting, ordered|:
                false return if not header_collect_struct(file, root, structs, visiting, ordered)
            return true


        # GenerateCHeader's stage1 counterpart. `guard` is supplied by the driver because the
        # backend library does not own a filesystem filename. The final byte is NUL-terminated
        # so it can be passed directly to a C host or written with the ordinary runtime APIs.
        def generate_c_header(file: Ast::File&, structs: mutable StructTable, guard: sview) -> darray[u8] can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            out: mutable darray[u8] = []
            header_push(out, "#ifndef ")
            header_push(out, guard)
            header_push(out, "\n#define ")
            header_push(out, guard)
            header_push(out, "\n\n#include <stdint.h>\n\n#ifdef __cplusplus\nextern \"C\" {\n#endif\n\n")
            emitted_structs: mutable darray[sview] = []
            [] return if not header_collect_public_aggregates(file, &structs, &emitted_structs)
            # Keep the dependency order produced by header_collect_public_aggregates. Stage0's
            # C header emitter uses the same topological order for both forward declarations and
            # definitions; sorting this list by public name breaks byte parity as soon as an
            # exported aggregate contains another exported aggregate by value.
            for struct_name in emitted_structs |file, structs, out|:
                [] return if not header_forward_struct(file, struct_name, &structs, out)
            out.push(10) if emitted_structs.count > 0
            for struct_name in emitted_structs |file, structs, out|:
                [] return if not header_exported_struct(file, struct_name, &structs, out)
            # stage0 writes the separating blank line only when a section actually emitted
            # something (`if len(result.ExportedGlobals) > 0`), so a unit with NO exports has
            # none. Writing it unconditionally left a stray blank line in every export-free
            # header — 56 of 56 corpus fixtures.
            globals_start: usize = out.count
            [] return if not header_exported_globals(file, &structs, out)
            out.push(10) if out.count > globals_start
            functions_start: usize = out.count
            [] return if not header_exported_functions(file, structs, out)
            out.push(10) if out.count > functions_start
            header_push(out, "#ifdef __cplusplus\n}\n#endif\n\n#endif\n")
            out.push(0)
            return out


    public:
        # The registration sequence both `-emit header` and `-emit c-bind-check` need: struct
        # names and bodies, aliases, enums, consts and tuple types, with declared alignments
        # applied. Extracted so the two modes cannot drift apart — a layout query reading a
        # differently-registered table than the header would report offsets the header does
        # not describe.
        def register_types_for_abi(file: Ast::File&, ctx: LLVMContextRef) -> StructTable can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            structs: mutable StructTable = StructTable{names: [], handles: [], alignments: [], field_names: [], field_types: [], field_start: [], field_count: [], tuple_label_lines: [], tuple_label_names: [], guest_layouts: [], overlay_field_names: [], overlay_field_offsets: [], overlay_field_widths: [], overlay_field_layouts: [], generic_struct_names: [], generic_struct_decls: [], generic_struct_param_names: [], generic_struct_param_start: [], generic_struct_param_count: [], generic_struct_inst_bases: [], generic_struct_inst_args: [], generic_struct_inst_arg_start: [], generic_struct_inst_arg_count: [], generic_struct_inst_index: [], generic_struct_inst_ready: [], generic_struct_inprogress: [], context: ctx, array_elements: [], array_extents: [], darray_elements: [], view_elements: [], ref_targets: [], ref_is_heap: [], optional_targets: [], enum_names: [], enum_backings: [], enum_variants: [], enum_variant_values: [], enum_variant_start: [], enum_variant_count: [], binding_names: [], binding_types: [], penum_names: [], penum_variants: [], penum_payloads: [], penum_has_payload: [], penum_field_names: [], penum_field_types: [], penum_field_flat_names: [], penum_field_type_start: [], penum_field_type_count: [], packed_names: [], packed_variants: [], packed_payloads: [], packed_has_payload: [], packed_field_names: [], packed_variant_start: [], packed_variant_count: [], packed_payload_words: [], packed_field_types: [], packed_field_flat_names: [], packed_field_type_start: [], packed_field_type_count: [], packed_common_counts: [], ast_refinement_names: [], penum_variant_start: [], penum_variant_count: [], penum_payload_words: [], alias_names: [], alias_types: [], module_alias_names: [], module_alias_targets: [], const_names: [], const_types: [], const_values: [], const_resolved: [], const_float_text: [], const_globals: [], const_global_ok: [], extern_global_names: [], extern_global_types: [], extern_global_handles: [], decl_line_rows: [], decl_column_rows: [], impl_member_lines: [], impl_member_ifaces: [], impl_member_types: [], mutable_global_names: [], mutable_global_types: [], mutable_global_handles: [], static_branch_lines: [], static_taken_lines: [], pending_ensures: [], narrowed_owners: [], narrowed_fields: [], fn_return_lines: [], fn_return_heads: [], query_lines: [], query_heads: [], query_binders: [], fn_pool_returns: [], fn_param_lines: [], fn_param_heads: [], fn_pool_param_start: [], fn_pool_param_count: [], fn_pool_params: [], fn_type_param_lines: [], fn_type_param_exprs: [], fn_type_return_lines: [], fn_type_return_exprs: [], branch_hint_lines: [], branch_hint_kinds: []}
            register_fn_signatures(file, &structs)
            top: mutable darray[Decl] = file.top_decls
            register_generic_structs(file, top, &structs)
            register_struct_names(file, &structs, ctx)
            for declaration in top |structs, ctx|:
                register_payload_enum(declaration, file.packed_enum_names, &structs)
                register_packed_enum(declaration, file.packed_enum_names, file.enum_common_owners, file.enum_common_counts, &structs)
            register_aliases(file, &structs)
            register_enums_from_metadata(file, &structs)
            apply_struct_alignments(file.enum_annotations, &structs)
            resolve_aliases(file, &structs)
            for declaration in top |structs|:
                register_const(declaration, file.enum_annotations, &structs)
            fold_consts(file, top, &structs)
            for declaration in top |structs, ctx|:
                _ = set_struct_body(declaration, &structs, ctx)
            register_tuple_types(file.tuple_type_elements, file.tuple_type_starts, file.tuple_type_counts, file.tuple_type_lines, &structs, ctx)
            return structs


        # `-emit c-bind-check`: the ELISA-side layout of every `@c_bind` struct, as a line
        # protocol the driver parses. The driver owns the C half (generate a probe, run `cc`,
        # diff), because it is the side that may touch the filesystem and spawn processes.
        #
        #   S <struct> <size> <align> <field-count>
        #   F <struct> <field> <offset>
        #
        # Sizes come from LLVM's TARGET DATA, not from struct_alignment (which returns the
        # DECLARED alignment) — the point of the mode is to compare real computed layout.
        def c_bind_layout_for_file(file: Ast::File&, m: LLVMModuleRef, ctx: LLVMContextRef, td: LLVMTargetDataRef) -> darray[u8] can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            structs: mutable StructTable = register_types_for_abi(file, ctx)
            out: mutable darray[u8] = []
            for annotation in file.enum_annotations |structs, out, td|:
                continue if annotation.name != "c_bind"
                struct_index: i64 = struct_index_of(&structs, annotation.owner)
                continue if struct_index < 0
                slot: usize = struct_index.usize()
                handle: LLVMTypeRef = structs.handles[slot]
                header_push(out, "S ")
                header_push(out, annotation.owner)
                out.push(32)
                header_push_int(out, LLVMABISizeOfType(td, handle).i64())
                out.push(32)
                header_push_int(out, LLVMABIAlignmentOfType(td, handle).i64())
                out.push(32)
                header_push_int(out, structs.field_count[slot].i64())
                out.push(10)
                for field_offset in 0..<structs.field_count[slot] |out, structs, slot, annotation, handle, td|:
                    header_push(out, "F ")
                    header_push(out, annotation.owner)
                    out.push(32)
                    header_push(out, structs.field_names[structs.field_start[slot] + field_offset])
                    out.push(32)
                    header_push_int(out, LLVMOffsetOfElement(td, handle, field_offset.u32()).i64())
                    out.push(10)
            out.push(0)
            return out


        # The `common:` block's fields for a packed enum, from the AST. Row field 0 is the tag,
        # so common k occupies row field 1 + k in stage1's inline layout.
        def packed_emit_common_fields(top: darray[Decl]&, enum_name: sview, commons: u32, out: mutable darray[u8]&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                for declaration in top |enum_name, commons, out|:
                    if declaration is Decl.Module(pcf_mod_name, pcf_mod_body, pcf_mod_line):
                        packed_emit_common_fields(pcf_mod_body, enum_name, commons, out)
                        continue
                    if declaration is Decl.Scoped(pcf_scoped_body, pcf_scoped_line):
                        packed_emit_common_fields(pcf_scoped_body, enum_name, commons, out)
                        continue
                    if declaration is Decl.Enum(pcf_name, pcf_variants, pcf_const, pcf_storage, pcf_line):
                        continue if pcf_name != enum_name or pcf_variants.count == 0
                        for common_index in 0..<commons.usize() |out, pcf_variants|:
                            break if common_index >= pcf_variants[0].field_names.count
                            header_push(out, "    - ")
                            header_push(out, pcf_variants[0].field_names[common_index])
                            header_push(out, ": ")
                            if pcf_variants[0].fields[common_index] is Expr.Ident(pcf_type_name, pcf_type_line):
                                header_push(out, pcf_type_name)
                            else:
                                header_push(out, "<type>")
                            header_push(out, " inline row_field=")
                            header_push_int(out, (1 + common_index).i64())
                            out.push(10)
                        return


        # Lexicographic `a < b`, for the sorted variant list.
        def packed_name_less(a: sview, b: sview) -> bool can[Abort.Panic]:
            limit: usize = sview_len(a) if sview_len(a) < sview_len(b) else sview_len(b)
            for index in 0..<limit |a, b|:
                left: u8 = sview_at(a, index)
                right: u8 = sview_at(b, index)
                true return if left < right
                false return if left > right
            return sview_len(a) < sview_len(b)


        # An Elisa scalar type NAME (`u32`, `i64`, `f64`) for a ValueType. `-emit packed`
        # prints the declared spelling of a common field's type, not a C one, so
        # header_type_name (which emits `uint32_t`) is not usable here.
        def packed_elisa_type_name(value_type: ValueType, structs: StructTable&, out: mutable darray[u8]&) -> void can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic, Memory.Allocate:
                if value_type.kind == TypeKind.Signed:
                    header_push(out, "i8" if value_type.bits == 8 else ("i16" if value_type.bits == 16 else ("i32" if value_type.bits == 32 else "i64")))
                    return
                if value_type.kind == TypeKind.Unsigned:
                    header_push(out, "u8" if value_type.bits == 8 else ("u16" if value_type.bits == 16 else ("u32" if value_type.bits == 32 else "u64")))
                    return
                if value_type.kind == TypeKind.Float:
                    header_push(out, "f32" if value_type.bits == 32 else "f64")
                    return
                if value_type.kind == TypeKind.Bool:
                    header_push(out, "bool")
                    return
                if value_type.kind == TypeKind.Struct and value_type.bits.usize() < structs.names.count:
                    header_push(out, structs.names[value_type.bits.usize()])
                    return
                header_push(out, "<type>")


        # `-emit packed` — the packed lowering profile, and every packed enum's ROW LAYOUT.
        #
        # Reports stage1's TRUE layout. stage1 places a `common:` block's fields INLINE in the
        # row (between the tag and the payload) where stage0 keeps them in a SIDE TABLE; that
        # choice is deliberate and documented in codegen_stmt_match.elisa. So for an enum with
        # commons this prints `inline row_field=N` and `side-table common words: 0` where
        # stage0 prints `side_table word_offset=N` — the same vocabulary, describing the layout
        # each compiler actually uses. Enums with NO commons, and units with no packed enum at
        # all, are byte-identical to stage0.
        def generate_packed_report(file: Ast::File&, m: LLVMModuleRef, ctx: LLVMContextRef) -> darray[u8] can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            structs: mutable StructTable = register_types_for_abi(file, ctx)
            top: mutable darray[Decl] = file.top_decls
            for declaration in top |structs|:
                register_packed_enum(declaration, file.packed_enum_names, file.enum_common_owners, file.enum_common_counts, &structs)
            out: mutable darray[u8] = []
            header_push(out, "packed lowering\n  contract: canonical-compiler-graph\n  canonical: variant-sparse\n  readonly publication gate: Frozen\n")
            reported: mutable usize = 0
            for slot in 0..<structs.packed_names.count |out, structs, reported|:
                # A placeholder row carries no variants; only a fully registered enum is a
                # packed enum for reporting purposes.
                continue if structs.packed_variant_count[slot] == 0
                reported <- reported + 1
                commons: u32 = structs.packed_common_counts[slot]
                out.push(10)
                header_push(out, structs.packed_names[slot])
                header_push(out, "\n  effective abi: variant-sparse\n  row bytes: ")
                header_push_int(out, packed_row_bytes(structs, slot.i64()))
                header_push(out, "\n  common prefix words: ")
                header_push_int(out, commons.i64())
                # ZERO: stage1's commons live in the ROW, not a side table.
                header_push(out, "\n  side-table common words: 0\n  variants: ")
                # Sorted, as stage0 sorts them.
                emitted_variants: mutable darray[sview] = []
                start: usize = structs.packed_variant_start[slot]
                count: usize = structs.packed_variant_count[slot]
                for _round in 0..<count |out, structs, start, count, emitted_variants|:
                    best: mutable sview = ""
                    found: mutable bool = false
                    for candidate in 0..<count |best, found, structs, start, emitted_variants|:
                        name: sview = structs.packed_variants[start + candidate]
                        already: mutable bool = false
                        for done in emitted_variants |already, name|:
                            already <- true if done == name
                        continue if already
                        if not found or packed_name_less(name, best):
                            best <- name
                            found <- true
                    break if not found
                    header_push(out, ", ") if emitted_variants.count > 0
                    emitted_variants.push(best)
                    header_push(out, best)
                out.push(10)
                if commons == 0:
                    header_push(out, "  common fields: none\n")
                    continue
                header_push(out, "  common fields:\n")
                # Names and types come from the AST, NOT the StructTable's per-variant field
                # pool: the parser PREPENDS commons to every variant's field list, but the
                # registered pool holds only the PAYLOAD fields — reading index 0 there
                # returned the first payload field (`x`) where the common (`t`) was wanted.
                packed_emit_common_fields(top, structs.packed_names[slot], commons, out)
            header_push(out, "  enums: none\n") if reported == 0
            out.push(0)
            return out


        def generate_c_header_for_file(file: Ast::File&, m: LLVMModuleRef, ctx: LLVMContextRef, guard: sview) -> darray[u8] can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            structs: mutable StructTable = register_types_for_abi(file, ctx)
            return generate_c_header(file, structs, guard)


        def name_in_sview(names: darray[sview]&, name: sview) -> bool can[Abort.Panic]:
            for existing in names |name|:
                true return if existing == name
            return false
