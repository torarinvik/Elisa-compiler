# C ABI header generation for the stage1 backend.
#
# This is intentionally driven by the same resolved ValueType/StructTable used by LLVM
# emission. It does not guess from source spelling: an unsupported exported type returns
# false so callers cannot publish a header whose declarations disagree with the object ABI.
include "./c_header_export_alias.elisa"
include "./c_header_parameter_pointer.elisa"
include "./c_header_prototype_marker.elisa"
include "./c_header_return_pointer.elisa"

extend Backend:
    private:


        def header_exported_struct(file: Ast::File&, struct_name: sview, structs: mutable StructTable&, out: mutable darray[u8]&) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate:
                struct_index: i64 = struct_index_of(structs, struct_name)
                false return if struct_index < 0
                public_name: sview = header_public_struct_name(file, struct_name)
                header_push(out, "struct ")
                header_push(out, public_name)
                header_push(out, " {\n")
                slot: usize = struct_index.usize()
                for field_offset in 0..<structs.records.field_count[slot] |file, struct_name, structs, out, slot|:
                    field_type: ValueType = copied_type(structs.records.field_types[structs.records.field_start[slot] + field_offset])
                    # FOUR spaces, as stage0 writes.
                    for _indent in 0..<4 |out|:
                        out.push(32)
                    false return if not header_field_decl(file, field_type, struct_name, structs.records.field_names[structs.records.field_start[slot] + field_offset], structs, out)
                    out.push(10)
                alignment: u32 = struct_alignment(ValueType{kind: TypeKind.Struct, bits: slot.u32()}, structs)
                if alignment != 0:
                    header_push(out, "} __attribute__((aligned(")
                    header_push_int(out, alignment.i64())
                    header_push(out, ")));\n\n")
                else:
                    header_push(out, "};\n\n")
                return true




        def header_forward_struct(file: Ast::File&, struct_name: sview, structs: mutable StructTable&, out: mutable darray[u8]&) -> bool can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic, Memory.Allocate:
                false return if struct_index_of(structs, struct_name) < 0
                public_name: sview = header_public_struct_name(file, struct_name)
                header_push(out, "typedef struct ")
                header_push(out, public_name)
                header_push(out, " ")
                header_push(out, public_name)
                header_push(out, ";\n")
                return true




        # The PUBLIC name an export was given, or the internal name when it has none.
        #
        # The alias is recorded as a SEPARATE annotation from the `__export_*` marker, and
        # the two can appear in either order. Returning `target` as soon as the MARKER was
        # seen therefore answered the internal name whenever the marker came first —
        # `export global seed as ctx_seed` published `extern ... seed;`, a symbol no
        # consumer can link against. Scan for the alias across the whole table before
        # falling back.
        # The public name of `export global target as public` is the marker row's own
        # detail_name. Searching for any row that names the target also matched metadata such
        # as the `__lsp_decl_name` source-span row, so the header declared the global under
        # that name instead of its alias (codegen guards the same pairing:
        # is_export_global_alias_row).
        def header_export_alias(marker: Ast::EnumAnnotation) -> sview:
            ensure result == (marker.detail_name if marker.detail_name != "" else marker.owner)
            return CHeaderExportAlias::public_name(marker.owner, marker.detail_name)




        def header_exported_globals(file: Ast::File&, structs: mutable StructTable&, out: mutable darray[u8]&) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate:
                for annotation in file.enum_annotations |file, structs, out|:
                    continue if annotation.name != "__export_global"
                    target: sview = annotation.owner
                    public_name: sview = header_export_alias(annotation)
                    global_type: ValueType = header_global_type(structs, target)
                    false return if global_type.kind == TypeKind.Unmodeled
                    header_push(out, "extern ")
                    global_source: sview = header_global_source_type(file, target)
                    if global_source != "" and header_c_name_for_source_type(global_source, out):
                        out.push(32)
                        header_push(out, public_name)
                        out.push(59)
                    else:
                        false return if not header_decl(file, global_type, public_name, structs, out)
                    alignment: u32 = struct_alignment(global_type, structs)
                    if alignment != 0:
                        _ = out.pop()
                        header_push(out, " __attribute__((aligned(")
                        header_push_int(out, alignment.i64())
                        header_push(out, ")));" )
                    out.push(10)
                return true




        def header_exported_functions(file: Ast::File&, structs: mutable StructTable, out: mutable darray[u8]&) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate:
                out.reserve(out.count + file.top_decls.count)
                for declaration in file.top_decls |file, structs, out|:
                    match declaration:
                        Decl.Extern(function_name, param_start, arity, variadic, callable, return_type_name, decorators, line):
                            is_export: mutable bool = false
                            for annotation in file.enum_annotations |is_export, function_name|:
                                is_export <- true if annotation.owner == function_name and annotation.name == "__export_fn"
                            continue if not is_export or not callable
                            return_type: ValueType = header_type_from_name(return_type_name, &structs)
                            return_pointer: mutable bool = false
                            for annotation in file.enum_annotations |return_pointer, function_name|:
                                return_pointer <- true if CHeaderReturnPointer::matches_marker(annotation.owner, annotation.name, function_name)
                            false return if return_type.kind == TypeKind.Unmodeled
                            if not header_c_name_for_source_type(return_type_name, out):
                                false return if not header_type_name(file, return_type, &structs, out)
                            out.push(32)
                            for _return_star in 0..<header_pointer_depth(return_type, &structs) |out|:
                                out.push(42)
                            out.push(42) if return_pointer
                            header_push(out, function_name)
                            out.push(40)
                            # stage0 writes `void` for an empty parameter list — a bare `()` is an
                            # UNPROTOTYPED declaration in C, which silences argument checking at
                            # every call site in the consuming translation unit.
                            header_push(out, "void") if CHeaderPrototypeMarker::needs_void_parameter_marker(arity)
                            for parameter_index in 0..<arity.usize() |file, structs, out, param_start|:
                                header_push(out, ", ") if parameter_index > 0
                                parameter: ExternParam = file.extern_params[param_start.usize() + parameter_index]
                                parameter_type: ValueType = header_type_from_name(parameter.type_name, &structs)
                                false return if parameter_type.kind == TypeKind.Unmodeled
                                if not header_c_name_for_source_type(parameter.type_name, out):
                                    false return if not header_type_name(file, parameter_type, &structs, out)
                                # A provenance-bearing param is a REFERENCE (`T&` / `lmut T`) and
                                # therefore a POINTER — the type_name side table keeps only the bare
                                # base name, dropping the `&` (codegen_declare documents the same
                                # trap). Without this the header declares `Vec2 arg0` where the
                                # object takes `Vec2 *arg0`: a different calling convention, so a
                                # caller compiled against this header corrupts the frame.
                                out.push(32)
                                ordinary_pointer_depth: mutable i64 = 0
                                ordinary_pointer_depth <- header_pointer_depth(parameter_type, &structs) if not parameter.provenance_bearing
                                parameter_pointer_depth: i64 = CHeaderParameterPointer::star_count(parameter.provenance_bearing, ordinary_pointer_depth)
                                for _parameter_star in 0..<parameter_pointer_depth |out|:
                                    out.push(42)
                                # stage0 names parameters POSITIONALLY (`arg0`, `arg1`). The Elisa
                                # parameter name is not part of the C ABI and need not be a valid
                                # C identifier.
                                header_push(out, "arg")
                                header_push_int(out, parameter_index.i64())
                            header_push(out, ");\n")
                        _:
                            pass
                return true




        # GenerateCHeader's stage1 counterpart. `guard` is supplied by the driver because the
        # backend library does not own a filesystem filename. The final byte is NUL-terminated
        # so it can be passed directly to a C host or written with the ordinary runtime APIs.
        def generate_c_header(file: Ast::File&, structs: mutable StructTable, guard: sview) -> darray[u8] can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            out: mutable darray[u8] = []
            header_push(out, "#ifndef ")
            header_push(out, guard)
            header_push(out, "\n#define ")
            header_push(out, guard)
            header_push(out, "\n\n#include <stdint.h>\n\n#ifdef __cplusplus\nextern \"C\" {\n#endif\n\n")
            emitted_structs: mutable darray[sview] = []
            [] return if not header_collect_public_aggregates(file, &structs, &emitted_structs)
            # Keep the dependency order produced by header_collect_public_aggregates. Stage0's
            # C header emitter uses the same topological order for both forward declarations and
            # definitions; sorting this list by public name breaks byte parity as soon as an
            # exported aggregate contains another exported aggregate by value.
            for struct_name in emitted_structs |file, structs, out|:
                [] return if not header_forward_struct(file, struct_name, &structs, out)
            out.push(10) if emitted_structs.count > 0
            for struct_name in emitted_structs |file, structs, out|:
                [] return if not header_exported_struct(file, struct_name, &structs, out)
            # stage0 writes the separating blank line only when a section actually emitted
            # something (`if len(result.ExportedGlobals) > 0`), so a unit with NO exports has
            # none. Writing it unconditionally left a stray blank line in every export-free
            # header — 56 of 56 corpus fixtures.
            globals_start: usize = out.count
            [] return if not header_exported_globals(file, &structs, out)
            out.push(10) if out.count > globals_start
            functions_start: usize = out.count
            [] return if not header_exported_functions(file, structs, out)
            out.push(10) if out.count > functions_start
            header_push(out, "#ifdef __cplusplus\n}\n#endif\n\n#endif\n")
            out.push(0)
            return out


    public:
        # The registration sequence both `-emit header` and `-emit c-bind-check` need: struct
        # names and bodies, aliases, enums, consts and tuple types, with declared alignments
        # applied. Extracted so the two modes cannot drift apart — a layout query reading a
        # differently-registered table than the header would report offsets the header does
        # not describe.
        def register_types_for_abi(file: Ast::File&, ctx: LLVMContextRef, target_data: LLVMTargetDataRef) -> StructTable can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            structs: mutable StructTable = new_struct_table(ctx, target_data)
            register_fn_signatures(file, &structs)
            top: mutable darray[Decl] = file.top_decls
            register_generic_structs(file, top, &structs)
            # The ABI/report table is separate from the module table, so copy the same
            # hierarchy and recursive-layout facts before registering packed rows. Without
            # this, `-emit packed` silently falls back to variant-sparse and omits user roots,
            # even while normal module codegen knows that the same source is AoS.
            file_has_ast_refinement: mutable bool = false
            for annotation in file.enum_annotations |structs, file_has_ast_refinement|:
                file_has_ast_refinement <- true if annotation.name == "__compiler_ast_refinement"
                if annotation.name == "__compiler_ast_refinement":
                    structs.packed_layouts.ast_refinement_names <- structs.packed_layouts.ast_refinement_names.push(annotation.owner)
                    structs.packed_layouts.ast_refinement_modules <- structs.packed_layouts.ast_refinement_modules.push(annotation.module)
                    structs.packed_layouts.ast_refinement_epoch <- structs.packed_layouts.ast_refinement_epoch + 1
                if (annotation.name == "__recursive_field" and recursive_enum_selects_aos(file.enum_annotations, annotation.owner, annotation.module)) or ((annotation.name == "__ast_refinement" or annotation.name == "__aos") and hierarchy_is_store_backed(file, annotation.owner, annotation.module)):
                    already_aos: mutable bool = false
                    for existing_aos in 0..<structs.packed_layouts.aos_dynamic_names.count |already_aos, annotation, structs|:
                        existing_module: sview = structs.packed_layouts.aos_dynamic_modules[existing_aos] if existing_aos < structs.packed_layouts.aos_dynamic_modules.count else ""
                        already_aos <- true if structs.packed_layouts.aos_dynamic_names[existing_aos] == annotation.owner and existing_module == annotation.module
                    if not already_aos and annotation.owner != "":
                        structs.packed_layouts.aos_dynamic_names <- structs.packed_layouts.aos_dynamic_names.push(annotation.owner)
                        structs.packed_layouts.aos_dynamic_modules <- structs.packed_layouts.aos_dynamic_modules.push(annotation.module)
                if annotation.line == 3900000008 and hierarchy_is_store_backed(file, annotation.owner, annotation.module):
                    structs.packed_layouts.hierarchy_child <- structs.packed_layouts.hierarchy_child.push(annotation.owner)
                    structs.packed_layouts.hierarchy_parent <- structs.packed_layouts.hierarchy_parent.push(annotation.name)
                    structs.packed_layouts.hierarchy_modules <- structs.packed_layouts.hierarchy_modules.push(annotation.module)
                    # Use the same store-backed test as module codegen so packed reports and
                    # emitted row layouts agree for inline hierarchies.
                    already_child_aos: mutable bool = false
                    for existing_child_aos in 0..<structs.packed_layouts.aos_dynamic_names.count |already_child_aos, annotation, structs|:
                        existing_module: sview = structs.packed_layouts.aos_dynamic_modules[existing_child_aos] if existing_child_aos < structs.packed_layouts.aos_dynamic_modules.count else ""
                        already_child_aos <- true if structs.packed_layouts.aos_dynamic_names[existing_child_aos] == annotation.owner and existing_module == annotation.module
                    if not already_child_aos and annotation.owner != "":
                        structs.packed_layouts.aos_dynamic_names <- structs.packed_layouts.aos_dynamic_names.push(annotation.owner)
                        structs.packed_layouts.aos_dynamic_modules <- structs.packed_layouts.aos_dynamic_modules.push(annotation.module)
                    already_parent_aos: mutable bool = false
                    for existing_parent_aos in 0..<structs.packed_layouts.aos_dynamic_names.count |already_parent_aos, annotation, structs|:
                        existing_module: sview = structs.packed_layouts.aos_dynamic_modules[existing_parent_aos] if existing_parent_aos < structs.packed_layouts.aos_dynamic_modules.count else ""
                        already_parent_aos <- true if structs.packed_layouts.aos_dynamic_names[existing_parent_aos] == annotation.name and existing_module == annotation.module
                    if not already_parent_aos and annotation.name != "":
                        structs.packed_layouts.aos_dynamic_names <- structs.packed_layouts.aos_dynamic_names.push(annotation.name)
                        structs.packed_layouts.aos_dynamic_modules <- structs.packed_layouts.aos_dynamic_modules.push(annotation.module)
            reserve_ast_packed_headers(&structs) if file_has_ast_refinement
            abi_packed_names: mutable darray[sview] = []
            packed_or_ast_enum_names(file, &abi_packed_names)
            abi_packed_membership: PackedOwnerMembership = packed_owner_membership(file, abi_packed_names)
            for abi_enum_index in 0..<file.enum_decl_names.count |abi_enum_index, file, abi_packed_membership, structs|:
                abi_enum_name: sview = file.enum_decl_names[abi_enum_index]
                abi_owner: sview = file.enum_decl_owners[abi_enum_index] if abi_enum_index < file.enum_decl_owners.count else ""
                reserve_packed_placeholder(abi_enum_name, &structs, abi_owner) if abi_enum_index < abi_packed_membership.enum_declarations.count and abi_packed_membership.enum_declarations[abi_enum_index]
            register_struct_names(file, &structs, ctx)
            no_packed_names: darray[sview] = []
            for declaration in top |structs, file, abi_packed_names, abi_packed_membership, no_packed_names|:
                if declaration is Decl.Enum(abi_payload_name, abi_payload_variants, abi_payload_is_const, abi_payload_storage, abi_payload_line):
                    payload_row: i64 = payload_enum_metadata_row_for_owner(file, abi_payload_name, "")
                    continue if payload_row < 0
                    payload_row_index: usize = payload_row.usize()
                    is_packed_payload: mutable bool = false
                    if payload_row_index < abi_packed_membership.payload_enums.count:
                        is_packed_payload <- abi_packed_membership.payload_enums[payload_row_index]
                    else:
                        is_packed_payload <- packed_listed_for_owner(file, abi_packed_names, abi_payload_name, "")
                    continue if is_packed_payload
                    register_payload_enum_decl(abi_payload_name, abi_payload_variants, abi_payload_is_const, no_packed_names, "", structs)
            register_aliases(file, &structs)
            register_enums_from_metadata(file, abi_packed_membership, &structs)
            register_packed_enums_from_metadata(file, abi_packed_names, abi_packed_membership, &structs)
            register_packed_common_names_from_common_metadata(file.enum_common_owners, file.enum_common_modules, file.enum_common_counts, file.enum_common_starts, file.enum_common_fields, file.enum_common_field_names, &structs)
            apply_struct_alignments(file.enum_annotations, &structs)
            resolve_aliases(file, &structs)
            for declaration in top |structs|:
                register_const(declaration, "", file.enum_annotations, &structs)
            fold_consts(file, top, &structs)
            for declaration in top |structs, ctx|:
                _ = set_struct_body(declaration, &structs, ctx)
            register_tuple_types(file.tuple_type_elements, file.tuple_type_starts, file.tuple_type_counts, file.tuple_type_lines, file.tuple_type_label_offsets, &structs, ctx)
            return structs




        # `-emit c-bind-check`: the ELISA-side layout of every `@c_bind` struct, as a line
        # protocol the driver parses. The driver owns the C half (generate a probe, run `cc`,
        # diff), because it is the side that may touch the filesystem and spawn processes.
        #
        #   S <struct> <size> <align> <field-count>
        #   F <struct> <field> <offset>
        #
        # Sizes come from LLVM's TARGET DATA, not from struct_alignment (which returns the
        # DECLARED alignment) — the point of the mode is to compare real computed layout.
        def c_bind_layout_for_file(file: Ast::File&, m: LLVMModuleRef, ctx: LLVMContextRef, td: LLVMTargetDataRef) -> darray[u8] can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            structs: mutable StructTable = register_types_for_abi(file, ctx, td)
            out: mutable darray[u8] = []
            for annotation in file.enum_annotations |structs, out, td|:
                continue if annotation.name != "c_bind"
                struct_index: i64 = struct_index_of(&structs, annotation.owner)
                continue if struct_index < 0
                slot: usize = struct_index.usize()
                handle: LLVMTypeRef = structs.records.handles[slot]
                header_push(out, "S ")
                header_push(out, annotation.owner)
                out.push(32)
                header_push_int(out, LLVMABISizeOfType(td, handle).i64())
                out.push(32)
                header_push_int(out, LLVMABIAlignmentOfType(td, handle).i64())
                out.push(32)
                header_push_int(out, structs.records.field_count[slot].i64())
                out.push(10)
                for field_offset in 0..<structs.records.field_count[slot] |out, structs, slot, annotation, handle, td|:
                    header_push(out, "F ")
                    header_push(out, annotation.owner)
                    out.push(32)
                    header_push(out, structs.records.field_names[structs.records.field_start[slot] + field_offset])
                    out.push(32)
                    header_push_int(out, LLVMOffsetOfElement(td, handle, field_offset.u32()).i64())
                    out.push(10)
            out.push(0)
            return out




        def generate_c_header_for_file(file: Ast::File&, m: LLVMModuleRef, ctx: LLVMContextRef, guard: sview, target_data: LLVMTargetDataRef) -> darray[u8] can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            structs: mutable StructTable = register_types_for_abi(file, ctx, target_data)
            return generate_c_header(file, structs, guard)

include "./c_header_types.elisa"
include "./c_header_reachable.elisa"
include "./packed_report.elisa"
