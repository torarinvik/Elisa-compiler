# Canonical x86-64 register bit assignments shared by EASM parsing and the
# verifier. Keeping ABI masks derived from these bits prevents the analysis
# passes from silently disagreeing about register identity.
module EasmRegisterMasks:
    public:
        const RAX: i64 = 1
        const RCX: i64 = 2
        const RDX: i64 = 4
        const RBX: i64 = 8
        const RSI: i64 = 16
        const RDI: i64 = 32
        const RBP: i64 = 64
        const RSP: i64 = 128
        const R8: i64 = 256
        const R9: i64 = 512
        const R10: i64 = 1024
        const R11: i64 = 2048
        const R12: i64 = 4096
        const R13: i64 = 8192
        const R14: i64 = 16384
        const R15: i64 = 32768

        # Map every register alias currently supported by EASM to its full-width bit.
        # Unmodeled register forms and unknown names deliberately map to zero.
        def register_bit(register: sview) -> i64:
            ensure when register:
                "rax" | "eax" | "ax" | "al" -> result == RAX
                "rcx" | "ecx" | "cx" | "cl" -> result == RCX
                "rdx" | "edx" | "dx" | "dl" -> result == RDX
                "rbx" | "ebx" | "bx" | "bl" -> result == RBX
                "rsi" | "esi" | "si" | "sil" -> result == RSI
                "rdi" | "edi" | "di" | "dil" -> result == RDI
                "rbp" | "ebp" | "bp" | "bpl" -> result == RBP
                "rsp" | "esp" | "sp" | "spl" -> result == RSP
                "r8" | "r8d" | "r8w" | "r8b" -> result == R8
                "r9" | "r9d" | "r9w" | "r9b" -> result == R9
                "r10" | "r10d" | "r10w" | "r10b" -> result == R10
                "r11" | "r11d" | "r11w" | "r11b" -> result == R11
                "r12" | "r12d" | "r12w" | "r12b" -> result == R12
                "r13" | "r13d" | "r13w" | "r13b" -> result == R13
                "r14" | "r14d" | "r14w" | "r14b" -> result == R14
                "r15" | "r15d" | "r15w" | "r15b" -> result == R15
                _ -> result == 0
            return match register:
                "rax" | "eax" | "ax" | "al": RAX
                "rcx" | "ecx" | "cx" | "cl": RCX
                "rdx" | "edx" | "dx" | "dl": RDX
                "rbx" | "ebx" | "bx" | "bl": RBX
                "rsi" | "esi" | "si" | "sil": RSI
                "rdi" | "edi" | "di" | "dil": RDI
                "rbp" | "ebp" | "bp" | "bpl": RBP
                "rsp" | "esp" | "sp" | "spl": RSP
                "r8" | "r8d" | "r8w" | "r8b": R8
                "r9" | "r9d" | "r9w" | "r9b": R9
                "r10" | "r10d" | "r10w" | "r10b": R10
                "r11" | "r11d" | "r11w" | "r11b": R11
                "r12" | "r12d" | "r12w" | "r12b": R12
                "r13" | "r13d" | "r13w" | "r13b": R13
                "r14" | "r14d" | "r14w" | "r14b": R14
                "r15" | "r15d" | "r15w" | "r15b": R15
                _: 0

        # FlowState tracks established values across calls; the return register
        # remains available to the caller's result handling, while other
        # caller-clobbered values are invalidated.
        def call_clobber_mask() -> i64:
            ensure result == (RAX | RCX | RDX | RSI | RDI | R8 | R9 | R10 | R11)
            return RAX | RCX | RDX | RSI | RDI | R8 | R9 | R10 | R11

        def call_invalidates_live_mask() -> i64:
            ensure result == (RCX | RDX | RSI | RDI | R8 | R9 | R10 | R11)
            ensure result + RAX == call_clobber_mask()
            return RCX | RDX | RSI | RDI | R8 | R9 | R10 | R11

        # Callee-saved general-purpose registers. RSP is tracked through the
        # separate stack-delta/alignment state rather than this register mask.
        def callee_saved_gpr_mask() -> i64:
            ensure result == (RBX | RBP | R12 | R13 | R14 | R15)
            return RBX | RBP | R12 | R13 | R14 | R15

        def cpuid_read_mask() -> i64:
            ensure result == (RAX | RCX)
            return RAX | RCX

        def cpuid_write_mask() -> i64:
            ensure result == (RAX | RBX | RCX | RDX)
            return RAX | RBX | RCX | RDX

        def rdtsc_write_mask() -> i64:
            ensure result == (RAX | RDX)
            return RAX | RDX
