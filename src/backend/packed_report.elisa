# Stage1 backend — `-emit packed`: the packed lowering profile and every packed enum's ROW
# LAYOUT, including where each `common:` field physically lives (inline in the row, or in the
# dynamic-AoS side table). Part of `module Backend` (see codegen.elisa).

extend Backend:
    public:


        # The `common:` block's fields for a packed enum, from the ABI metadata. Unannotated
        # commons use the cold side table in every dense packed ABI; explicit inline fields
        # are the only common fields that become row members.
        def packed_emit_common_fields(top: darray[Decl]&, enum_name: sview, target_owner: sview, current_owner: sview, commons: u32, structs: mutable StructTable&, enum_index: i64, out: mutable darray[u8]&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                for declaration in top |enum_name, target_owner, current_owner, commons, out|:
                    match declaration:
                        Decl.Module(pcf_mod_name, pcf_mod_body, pcf_mod_line):
                            packed_emit_common_fields(pcf_mod_body, enum_name, target_owner, pcf_mod_name, commons, structs, enum_index, out)
                            continue
                        _:
                            pass
                    match declaration:
                        Decl.Scoped(pcf_scoped_body, pcf_scoped_line):
                            packed_emit_common_fields(pcf_scoped_body, enum_name, target_owner, current_owner, commons, structs, enum_index, out)
                            continue
                        _:
                            pass
                    match declaration:
                        Decl.Enum(pcf_name, pcf_variants, pcf_const, pcf_storage, pcf_line):
                            continue if pcf_name != enum_name or current_owner != target_owner or pcf_variants.count == 0
                            for common_index in 0..<commons.usize() |out, pcf_variants, structs, enum_index|:
                                break if common_index >= pcf_variants[0].field_names.count
                                header_push(out, "    - ")
                                header_push(out, pcf_variants[0].field_names[common_index])
                                header_push(out, ": ")
                                match pcf_variants[0].fields[common_index]:
                                    Expr.Ident(pcf_type_name, _):
                                        header_push(out, pcf_type_name)
                                    _:
                                        header_push(out, "<type>")
                                if packed_common_is_inline_at_slot(structs, enum_index, common_index.u32()):
                                    header_push(out, " inline row_field=")
                                    header_push_int(out, packed_inline_common_row_field_index_at_slot(structs, enum_index, common_index.u32()).i64())
                                else:
                                    header_push(out, " side_table word_offset=")
                                    header_push_int(out, packed_side_common_word_offset_at_slot(structs, enum_index, common_index.u32()).i64())
                                    header_push(out, " words=")
                                    header_push_int(out, packed_common_side_word_count(packed_common_type_at_slot(structs, enum_index, common_index.u32()), structs).i64())
                                out.push(10)
                            return


                        _:
                            pass




        # One line per common of a dynamic-AoS root. A common is reported where it PHYSICALLY
        # lives: `@storage(inline)` puts it in the row (packed_row_llvm_type pushes exactly
        # those as row fields), everything else in the side table. Reporting every common as
        # side-table — which this did — described a layout the compiler does not use, and
        # disagreed with stage0 on the same input.
        #
        # The side word_offset must skip inline commons, so it comes from
        # packed_common_side_word_offset rather than a running total over ALL commons.
        def packed_emit_common_fields_side_table(enum_name: sview, commons: u32, structs: mutable StructTable&, out: mutable darray[u8]&) -> void can[Abort.Panic, Memory.Allocate]:
            enum_index: i64 = packed_index_of(structs, enum_name)
            enum_module: sview = packed_owner_at(structs, enum_index.usize()) if enum_index >= 0 else ""
            for common_index in 0..<commons.usize() |enum_name, enum_index, structs, out|:
                paired: mutable usize = structs.packed_common_owners.count
                paired <- structs.packed_common_names.count if structs.packed_common_names.count < paired
                paired <- structs.packed_common_modules.count if structs.packed_common_modules.count < paired
                continue if common_index >= paired
                common_name: mutable sview = ""
                seen: mutable u32 = 0
                for probe in 0..<paired |common_name, seen, common_index, enum_name, enum_module, structs|:
                    continue if structs.packed_common_owners[probe] != enum_name or structs.packed_common_modules[probe] != enum_module
                    if seen == common_index:
                        common_name <- structs.packed_common_names[probe]
                        break
                    seen <- seen + 1
                common_type: ValueType = packed_common_type_at(structs, enum_name, common_index.u32())
                header_push(out, "    - ")
                header_push(out, common_name)
                header_push(out, ": ")
                packed_elisa_type_name(common_type, structs, out)
                if packed_common_is_inline(structs, enum_name, common_index.u32()):
                    header_push(out, " inline row_field=")
                    header_push_int(out, packed_dynamic_common_row_field_index(structs, enum_index, common_index.u32()).i64())
                    out.push(10)
                    continue
                header_push(out, " side_table word_offset=")
                header_push_int(out, packed_common_side_word_offset(structs, enum_name, common_index.u32()).i64())
                header_push(out, " words=")
                header_push_int(out, packed_common_side_word_count(common_type, structs).i64())
                out.push(10)



        def packed_report_side_common_words(structs: mutable StructTable&, slot: usize, commons: u32) -> u32 can[Abort.Panic]:
            return packed_side_common_word_count_at_slot(structs, slot.i64(), commons)



        # The flat payload metadata is the source of truth for a packed row's payload width.
        # Do not infer it by walking `Decl`: the self-hosting parser may retain a nested module
        # wrapper or a synthesized declaration shape that is intentionally different from the
        # backend's flattened variant pools. Match the metadata entry by the concrete variant
        # names already registered for this slot; bare enum names alone are ambiguous across
        # modules. Common fields are prepended to every variant, so remove exactly that prefix.
        def packed_report_payload_words_from_metadata(file: Ast::File&, structs: StructTable&, slot: usize, commons: u32) -> i64 can[Abort.Panic]:
            name: sview = structs.packed_names[slot]
            packed_start: usize = structs.packed_variant_start[slot]
            packed_count: usize = structs.packed_variant_count[slot]
            selected: mutable i64 = -1
            selected_score: mutable usize = 0
            selected_ties: mutable usize = 0
            for enum_index in 0..<file.payload_enum_names.count |file, structs, slot, name, packed_start, packed_count, selected, selected_score, selected_ties|:
                continue if file.payload_enum_names[enum_index] != name
                source_start: usize = file.payload_enum_variant_starts[enum_index]
                source_count: usize = file.payload_enum_variant_counts[enum_index]
                score: mutable usize = 0
                for packed_offset in 0..<packed_count |score, file, structs, packed_start, source_start, source_count, packed_offset|:
                    packed_variant: usize = packed_start + packed_offset
                    continue if packed_variant >= structs.packed_variants.count
                    for source_offset in 0..<source_count |score, file, structs, packed_variant, source_start|:
                        source_variant: usize = source_start + source_offset
                        score <- score + 1 if source_variant < file.payload_enum_variant_names.count and structs.packed_variants[packed_variant] == file.payload_enum_variant_names[source_variant]
                continue if score == 0
                if score > selected_score:
                    selected <- enum_index
                    selected_score <- score
                    selected_ties <- 1
                elif score == selected_score:
                    selected_ties <- selected_ties + 1
            return -1 if selected_ties != 1 or selected < 0
            widest: mutable u32 = 0
            variant_start: usize = file.payload_enum_variant_starts[selected.usize()]
            variant_count: usize = file.payload_enum_variant_counts[selected.usize()]
            for variant_offset in 0..<variant_count |file, variant_start, commons, widest|:
                variant_index: usize = variant_start + variant_offset
                continue if variant_index >= file.payload_enum_variant_field_counts.count
                field_count: usize = file.payload_enum_variant_field_counts[variant_index]
                payload_count: u32 = (field_count - commons.usize()).u32() if field_count >= commons.usize() else 0
                widest <- payload_count if payload_count > widest
            return widest.i64()


        # Lexicographic `a < b`, for the sorted variant list.
        def packed_name_less(a: sview, b: sview) -> bool can[Abort.Panic]:
            limit: usize = sview_len(a) if sview_len(a) < sview_len(b) else sview_len(b)
            for index in 0..<limit |a, b|:
                left: u8 = sview_at(a, index)
                right: u8 = sview_at(b, index)
                true return if left < right
                false return if left > right
            return sview_len(a) < sview_len(b)




        # An Elisa scalar type NAME (`u32`, `i64`, `f64`) for a ValueType. `-emit packed`
        # prints the declared spelling of a common field's type, not a C one, so
        # header_type_name (which emits `uint32_t`) is not usable here.
        def packed_elisa_type_name(value_type: ValueType, structs: StructTable&, out: mutable darray[u8]&) -> void can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic, Memory.Allocate:
                if value_type.kind == TypeKind.Signed:
                    header_push(out, "i8" if value_type.bits == 8 else ("i16" if value_type.bits == 16 else ("i32" if value_type.bits == 32 else "i64")))
                    return
                if value_type.kind == TypeKind.Unsigned:
                    header_push(out, "u8" if value_type.bits == 8 else ("u16" if value_type.bits == 16 else ("u32" if value_type.bits == 32 else "u64")))
                    return
                if value_type.kind == TypeKind.Float:
                    header_push(out, "f32" if value_type.bits == 32 else "f64")
                    return
                if value_type.kind == TypeKind.Bool:
                    header_push(out, "bool")
                    return
                if value_type.kind == TypeKind.Struct and value_type.bits.usize() < structs.names.count:
                    header_push(out, structs.names[value_type.bits.usize()])
                    return
                header_push(out, "<type>")




        # `-emit packed` — the packed lowering profile, and every packed enum's ROW LAYOUT.
        #
        # Reports the canonical stage0 layout. Explicit `@storage(inline)` remains an inline
        # common block; unannotated common fields use the side table.
        def generate_packed_report(file: Ast::File&, m: LLVMModuleRef, ctx: LLVMContextRef, target_data: LLVMTargetDataRef) -> darray[u8] can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            structs: mutable StructTable = register_types_for_abi(file, ctx, target_data)
            top: mutable darray[Decl] = file.top_decls
            out: mutable darray[u8] = []
            header_push(out, "packed lowering\n  contract: canonical-compiler-graph\n  canonical: variant-sparse\n  readonly publication gate: Frozen\n")
            reported: mutable usize = 0
            reported_names: mutable darray[sview] = []
            reported_owners: mutable darray[sview] = []
            for slot in 0..<structs.packed_names.count |out, structs, reported, reported_names, reported_owners|:
                # A placeholder row carries no variants; only a fully registered enum is a
                # packed enum for reporting purposes, except for a sealed-hierarchy root whose
                # descendants share its store and therefore make the root ABI observable.
                continue if structs.packed_variant_count[slot] == 0 and not (packed_is_dynamic_aos_enum(structs, slot.i64()) and packed_name_is_hierarchy_root(structs, structs.packed_names[slot]))
                report_owner: mutable sview = packed_owner_at(structs, slot)
                ast_report_row: bool = packed_program_has_ast_refinements(structs) and (structs.packed_names[slot] == "Node" or packed_is_ast_refinement(structs, slot.i64()))
                # The self-hosting metadata pass can leave both the canonical ownerless AST
                # rows and an owner-qualified copy. Stage0 exposes one `Ast.*` row per type;
                # suppress the duplicate and label the canonical row with its source module.
                continue if ast_report_row and report_owner != ""
                report_owner <- "Ast" if ast_report_row
                already_reported: mutable bool = false
                for reported_index in 0..<reported_names.count |already_reported, reported_names, reported_owners, report_owner, slot|:
                    already_reported <- true if reported_names[reported_index] == structs.packed_names[slot] and reported_owners[reported_index] == report_owner
                continue if already_reported
                reported_names.push(structs.packed_names[slot])
                reported_owners.push(report_owner)
                reported <- reported + 1
                dynamic_aos: bool = packed_is_dynamic_aos_enum(structs, slot.i64())
                root_name: sview = packed_hierarchy_root_name(structs, structs.packed_names[slot])
                root_slot: i64 = packed_index_of(structs, root_name)
                # Two different counts, and conflating them is what made the report claim an
                # `@storage(inline)` common lived in the side table: `all_commons` is how many
                # commons the root declares (the per-field loop bound), `side_words` is how
                # many WORDS the side table actually holds, which counts only the commons that
                # are not inline.
                all_commons: u32 = packed_aos_common_count(structs, slot.i64()) if dynamic_aos else 0
                is_dynamic_root: bool = dynamic_aos and root_slot == slot.i64()
                commons: u32 = all_commons if dynamic_aos and is_dynamic_root else (structs.packed_common_counts[slot] if not dynamic_aos else 0)
                if not dynamic_aos:
                    declared_payload_words: i64 = packed_report_payload_words_from_metadata(file, structs, slot, commons)
                    structs.packed_payload_words[slot] <- declared_payload_words.u32() if declared_payload_words >= 0
                side_words: u32 = packed_aos_side_common_count(structs, slot.i64()) if dynamic_aos else packed_report_side_common_words(structs, slot, commons)
                out.push(10)
                header_push(out, report_owner)
                header_push(out, ".") if report_owner != ""
                header_push(out, structs.packed_names[slot])
                header_push(out, "\n  effective abi: aos\n  row bytes: ") if dynamic_aos
                header_push(out, "\n  effective abi: variant-sparse\n  row bytes: ") if not dynamic_aos
                header_push_int(out, packed_row_bytes(structs, slot.i64()))
                header_push(out, "\n  common prefix words: ")
                # Report the physical boundary before the payload. A narrow inline common
                # such as `f32` shares the tag's first machine word, while an aligned `i64`
                # starts at the second; logical common counts cannot express that distinction.
                prefix_words: mutable u32 = packed_legacy_payload_word_offset(structs, slot.i64()) if not dynamic_aos else 0
                if dynamic_aos:
                    prefix_row_type: LLVMTypeRef = packed_row_llvm_type(structs, slot.i64(), structs.context)
                    prefix_field: u32 = packed_dynamic_payload_row_field_index(structs, slot.i64())
                    prefix_words <- (LLVMOffsetOfElement(structs.target_data, prefix_row_type, prefix_field) / PACKED_U32_SIZE_BYTES).u32()
                header_push_int(out, prefix_words.i64() if commons > 0 else 0)
                header_push(out, "\n  side-table common words: ")
                header_push_int(out, side_words.i64())
                header_push(out, "\n  variants: ")
                # Sorted, as stage0 sorts them.
                emitted_variants: mutable darray[sview] = []
                start: usize = structs.packed_variant_start[slot]
                count: usize = structs.packed_variant_count[slot]
                for _round in 0..<count |out, structs, start, count, emitted_variants|:
                    best: mutable sview = ""
                    found: mutable bool = false
                    for candidate in 0..<count |best, found, structs, start, emitted_variants|:
                        name: sview = structs.packed_variants[start + candidate]
                        already: mutable bool = false
                        for done in emitted_variants |already, name|:
                            already <- true if done == name
                        continue if already
                        if not found or packed_name_less(name, best):
                            best <- name
                            found <- true
                    break if not found
                    header_push(out, ", ") if emitted_variants.count > 0
                    emitted_variants.push(best)
                    header_push(out, best)
                out.push(10)
                if commons == 0:
                    header_push(out, "  common fields: none\n")
                    continue
                header_push(out, "  common fields:\n")
                # Names and types come from the AST, NOT the StructTable's per-variant field
                # pool: the parser PREPENDS commons to every variant's field list, but the
                # registered pool holds only the PAYLOAD fields — reading index 0 there
                # returned the first payload field (`x`) where the common (`t`) was wanted.
                packed_emit_common_fields_side_table(root_name, commons, structs, out) if dynamic_aos and is_dynamic_root
                packed_emit_common_fields(top, structs.packed_names[slot], packed_owner_at(structs, slot), "", commons, structs, slot.i64(), out) if not dynamic_aos
            header_push(out, "  enums: none\n") if reported == 0
            out.push(0)
            return out
