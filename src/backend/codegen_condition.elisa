# Stage1 backend — conditions, `assert`-narrowing bookkeeping, and the statement-list driver.
# Part of `module Backend` (see codegen.elisa); split out to keep each file short.

extend Backend:
    private:
        # Emit a branch condition: a modeled `bool` (i1). Elisa requires a bool condition,
        # so this simply emits at bool type — no `!= 0` narrowing, because a comparison
        # already yields i1 and a bool local is stored as i1.
        def emit_condition(condition: Expr, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            bool_type: ValueType = ValueType{kind: TypeKind.Bool, bits: 1}
            condition_type: ValueType = resolve_type(condition, bool_type, local_scope, fns, structs, generics)
            null return if condition_type.kind != TypeKind.Bool
            # Open the condition-binding scope: every `is` test emitted inside this condition
            # shares one slot per bound name (see bind_is_slot). Depth-counted so a nested
            # condition — a ternary inside a guard, say — does not clear the outer registry.
            structs.cond_bind_depth <- structs.cond_bind_depth + 1
            condition_value: LLVMValueRef? = emit_expression(condition, bool_type, local_scope, fns, structs, generics, runtime, m, ctx, builder)
            structs.cond_bind_depth <- structs.cond_bind_depth - 1
            if structs.cond_bind_depth == 0:
                structs.cond_bind_names <- []
                structs.cond_bind_slots <- []
                structs.cond_bind_types <- []
            # `resolve_type` may use the expected type for an unmodeled expression (which is
            # correct for contextually typed literals), so the semantic type check alone is
            # not enough to protect LLVM.  Validate the value emitted by the backend itself:
            # every caller will feed this result to LLVMBuildCondBr, which requires exactly i1.
            if condition_value is emitted_condition:
                null return if LLVMTypeOf(emitted_condition) != LLVMInt1TypeInContext(ctx)
            return condition_value




        # Branch to `dest` only when the just-emitted region left the block OPEN. An arm
        # that already returned must not also get a branch — LLVM rejects a block with two
        # terminators.
        def branch_if_open(status: EmitStatus, builder: LLVMBuilderRef, dest: LLVMBasicBlockRef) -> void can[Abort.Panic]:
            return if status != EmitStatus.Open
            _ = LLVMBuildBr(builder, dest)




        # The source line carried by every statement kind that this backend can lower.
        def trace_line(statement: Stmt) -> u32:
            if statement is Stmt.Block(kind, clause, binding, body, line): return line.line
            if statement is Stmt.Contract(kind, predicate, line): return line.line
            if statement is Stmt.Expr(expression, line): return line.line
            if statement is Stmt.Return(value, line): return line.line
            if statement is Stmt.VarDecl(name, type_expression, value, line): return line.line
            if statement is Stmt.Assign(target, operator, value, line): return line.line
            if statement is Stmt.If(condition, then_body, else_body, line): return line.line
            if statement is Stmt.While(condition, body, line): return line.line
            if statement is Stmt.Break(label, line): return line.line
            if statement is Stmt.Continue(label, line): return line.line
            if statement is Stmt.Match(scrutinee, arms, line): return line.line
            if statement is Stmt.For(bind, variables, iterable, body, line): return line.line
            return 0



        def emit_trace_step(statement: Stmt, runtime: Runtime&, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            return if not runtime.trace_enabled or runtime.trace_functions_only
            line: u32 = trace_line(statement)
            location_id: u64 = trace_location_id(runtime.trace_function_id, line, TRACE_ID_STATEMENT_KIND, "")
            arguments: mutable darray[LLVMValueRef] = [runtime.trace_name, LLVMConstInt(LLVMInt32TypeInContext(ctx), line.u64(), 0), LLVMConstInt(LLVMInt64TypeInContext(ctx), location_id, 0)]
            arguments_pointer: void& = (&arguments[0]).cast[void&] can Unsafe.PointerCast
            _ = LLVMBuildCall2(builder, runtime.trace_record_id_type, runtime.trace_record_id, arguments_pointer, 3, "")



        # Record scalar local values using stage0's five-argument trace ABI. Aggregates and
        # floating-point values intentionally fall back to the ordinary step record: the
        # runtime value slot is an integer word and must never receive a guessed bitcast.
        def emit_trace_value(name: sview, line: u32, value: LLVMValueRef, value_type: ValueType, runtime: Runtime&, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            return if not runtime.trace_enabled or runtime.trace_functions_only or name == "_"
            int64_type: LLVMTypeRef = LLVMInt64TypeInContext(ctx)
            value64: mutable LLVMValueRef? = null
            if value_type.kind == TypeKind.Ref or value_type.kind == TypeKind.CStr:
                value64 <- LLVMBuildPtrToInt(builder, value, int64_type, "trace.ptr")
            if value_type.kind == TypeKind.Bool or value_type.kind == TypeKind.Signed or value_type.kind == TypeKind.Unsigned:
                value64 <- value if value_type.bits == 64 else LLVMBuildSExt(builder, value, int64_type, "trace.sext") if value_type.kind == TypeKind.Signed else LLVMBuildZExt(builder, value, int64_type, "trace.zext")
            if value64 is recorded_value:
                name_storage: mutable darray[u8] = []
                variable_name: LLVMValueRef = LLVMBuildGlobalStringPtr(builder, sview_to_cstr(name, name_storage), "trace.variable")
                signed_flag: LLVMValueRef = LLVMConstInt(LLVMInt32TypeInContext(ctx), 1 if value_type.kind == TypeKind.Signed else 0, 0)
                location_id: u64 = trace_location_id(runtime.trace_function_id, line, TRACE_ID_VALUE_KIND, name)
                arguments: mutable darray[LLVMValueRef] = [runtime.trace_name, LLVMConstInt(LLVMInt32TypeInContext(ctx), line.u64(), 0), variable_name, recorded_value, signed_flag, LLVMConstInt(LLVMInt64TypeInContext(ctx), location_id, 0)]
                arguments_pointer: void& = (&arguments[0]).cast[void&] can Unsafe.PointerCast
                _ = LLVMBuildCall2(builder, runtime.trace_record_value_id_type, runtime.trace_record_value_id, arguments_pointer, 6, "")



        # Lower `for i in LOW ..< HIGH by par:` through the stage0 structured-parallel runtime.
        # The runtime takes a zero-based index callback, so the callback reconstructs the
        # source index by adding LOW. LOW/HIGH are saved in caller locals so the lambda's normal
        # scalar-capture machinery carries non-zero ranges without inventing a new closure ABI.
        # The runtime function is intentionally looked up in `fns`: a source that has not
        # included the concurrency runtime must decline rather than emit an unresolved guess.
        def emit_parallel_range_for(variables: darray[sview]&, iterable: Expr, body: darray[Stmt]&, line: u32, return_type: ValueType, local_scope: mutable Scope&, loops: mutable LoopStack&, regions: mutable RegionStack&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> EmitStatus can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            EmitStatus.Declined return if variables.count != 1
            if iterable is Expr.Binary(range_low, range_operator, range_high, range_line):
                EmitStatus.Declined return if range_operator != TokenKind.RangeLt and range_operator != TokenKind.RangeLe
                usize_type: ValueType = ValueType{kind: TypeKind.Unsigned, bits: 64}
                if emit_expression(range_low, usize_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is low_value:
                    if emit_expression(range_high, usize_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is high_value:
                        low_name: sview = "__parallel_low"
                        high_name: sview = "__parallel_high"
                        low_storage: mutable darray[u8] = []
                        high_storage: mutable darray[u8] = []
                        low_slot: LLVMValueRef = build_entry_alloca(builder, llvm_type_of(usize_type, structs, ctx), sview_to_cstr(low_name, low_storage))
                        high_slot: LLVMValueRef = build_entry_alloca(builder, llvm_type_of(usize_type, structs, ctx), sview_to_cstr(high_name, high_storage))
                        _ = LLVMBuildStore(builder, low_value, low_slot)
                        _ = LLVMBuildStore(builder, high_value, high_slot)
                        declare_local(local_scope, low_name, low_slot, usize_type)
                        declare_local(local_scope, high_name, high_slot, usize_type)

                        callback_name: sview = variables[0]
                        callback_body: mutable darray[Stmt] = []
                        callback_index: Expr = Expr.Ident("__parallel_index", Ast::pos_at_line(line))
                        reconstructed: Expr = Expr.Binary(Expr.Ident(low_name, Ast::pos_at_line(line)), TokenKind.Plus, callback_index, Ast::pos_at_line(line))
                        callback_body.push(Stmt.VarDecl(callback_name, Expr.Ident("usize", Ast::pos_at_line(line)), reconstructed, Ast::pos_at_line(line)))
                        callback_body.extend(body)
                        callback_body.push(Stmt.Return(Expr.IntLit(0, Ast::pos_at_line(0)), Ast::pos_at_line(line)))
                        callback: Expr = Expr.Lambda(["__parallel_index"], callback_body, Ast::pos_at_line(line))

                        width: mutable Expr = Expr.Binary(Expr.Ident(high_name, Ast::pos_at_line(line)), TokenKind.Minus, Expr.Ident(low_name, Ast::pos_at_line(line)), Ast::pos_at_line(line))
                        if range_operator == TokenKind.RangeLe:
                            width <- Expr.Binary(width, TokenKind.Plus, Expr.IntLit(1, Ast::pos_at_line(0)), Ast::pos_at_line(line))
                        arguments: mutable darray[Expr] = [width, callback, Expr.IntLit(0, Ast::pos_at_line(0))]
                        call: Expr = Expr.Ident("for_indices_par", Ast::pos_at_line(line))
                        if emit_call(call, arguments, [], local_scope, fns, structs, generics, runtime, m, ctx, builder) is parallel_result:
                            _ = parallel_result
                            return EmitStatus.Open
            return EmitStatus.Declined




        # Lower `parallel for band in slice:` through the generic `each` combinator. The
        # semantic checker guarantees that the source is a thread-shareable band view and that
        # the body does not mutate an outer binding; the callback therefore needs only its band
        # parameter plus the ordinary scalar captures handled by emit_lambda_value.
        def emit_parallel_band_for(variables: darray[sview]&, iterable: Expr, body: darray[Stmt]&, line: u32, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> EmitStatus can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            EmitStatus.Declined return if variables.count != 1
            callback_body: mutable darray[Stmt] = []
            callback_body.extend(body)
            callback_body.push(Stmt.Return(Expr.IntLit(0, Ast::pos_at_line(0)), Ast::pos_at_line(line)))
            callback: Expr = Expr.Lambda([variables[0]], callback_body, Ast::pos_at_line(line))
            arguments: mutable darray[Expr] = [iterable, callback, Expr.IntLit(0, Ast::pos_at_line(0))]
            if emit_call(Expr.Ident("each", Ast::pos_at_line(line)), arguments, [], local_scope, fns, structs, generics, runtime, m, ctx, builder) is parallel_each_result:
                _ = parallel_each_result
                return EmitStatus.Open
            return EmitStatus.Declined




        # Emit a statement list. Declined if ANY statement declined; Terminated if the
        # Emit one arm's body of a `x = match …` and STORE its yielded value into `result_slot`,
        # then branch to `done_block`. Unlike a match-EXPRESSION arm (a single expression), a
        # statement-position arm may be a BLOCK: leading statements (a `rebind`, a call) followed
        # by a final yield expression. The leading statements are emitted in full statement
        # context; the final `Stmt.Expr` becomes the stored value. A prefix that itself terminates
        # (a `return` in the arm) yields no value and just closes the arm. Returns false to DECLINE.
        # `result_types`/`result_slots` are PARALLEL and usually hold one entry. They hold N when
        # the match feeds a DESTRUCTURING assignment (`a, b, c = match X:`), in which case each
        # arm's yielded value must be an N-element tuple and element i lands in slot i.
        def emit_arm_body_into_slot(body: darray[Stmt]&, result_types: darray[ValueType]&, result_slots: darray[LLVMValueRef]&, done_block: LLVMBasicBlockRef, return_type: ValueType, local_scope: mutable Scope&, loops: mutable LoopStack&, regions: mutable RegionStack&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            false return if body.count == 0
            prefix_open: mutable bool = true
            for prefix_index in 0..<body.count - 1 |prefix_open, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder|:
                continue if not prefix_open
                pre_status: EmitStatus = emit_statement(body[prefix_index], return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)
                false return if pre_status == EmitStatus.Declined
                prefix_open <- false if pre_status != EmitStatus.Open
            # A prefix that already returned/broke leaves no open block to yield into.
            true return if not prefix_open
            final_stmt: Stmt = body[body.count - 1]
            if final_stmt is Stmt.Expr(final_expr, final_line):
                # N slots: the yield must be an N-element tuple, emitted element by element.
                if result_slots.count > 1:
                    if final_expr is Expr.Tuple(final_elements, final_elements_line):
                        false return if final_elements.count != result_slots.count
                        final_tuple_ok: mutable bool = true
                        for final_index in 0..<final_elements.count |final_tuple_ok, final_elements, result_types, result_slots, local_scope, fns, structs, generics, runtime, m, ctx, builder|:
                            continue if not final_tuple_ok
                            if emit_expression(final_elements[final_index], result_types[final_index], local_scope, fns, structs, generics, runtime, m, ctx, builder) is final_element_value:
                                _ = LLVMBuildStore(builder, final_element_value, result_slots[final_index])
                            else:
                                final_tuple_ok <- false
                        false return if not final_tuple_ok
                        _ = LLVMBuildBr(builder, done_block)
                        return true
                    return false
                if emit_expression(final_expr, result_types[0], local_scope, fns, structs, generics, runtime, m, ctx, builder) is final_value:
                    _ = LLVMBuildStore(builder, final_value, result_slots[0])
                    _ = LLVMBuildBr(builder, done_block)
                    return true
                return false
            # An arm body whose last statement is ITSELF a match — `return match type_a:` where
            # each arm is `match type_b:` (symbols.elisa's structural comparisons). It parses as
            # a Stmt.Match, not an expression, so it fell through to the terminator path below,
            # which emits the inner match as a STATEMENT: it stores nothing into this arm's
            # result slot and does not branch to `done`. Recurse through this emitter into a temp
            # local instead, then yield that local like any other arm value.
            #
            # PACKED only, for the same reason as the `return match` split: the match-EXPRESSION
            # emitter models range patterns this one does not, so it stays the default elsewhere.
            if final_stmt is Stmt.Match(fin_m_scrutinee, fin_m_arms, fin_m_line):
                fin_m_type: ValueType = expression_type(fin_m_scrutinee, local_scope, fns, structs, generics)
                if fin_m_type.kind == TypeKind.PackedEnum and result_slots.count == 1:
                    fin_m_names: mutable darray[sview] = ["__arm_match"]
                    false return if emit_match_into_slot(fin_m_scrutinee, fin_m_arms, result_types, fin_m_names, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder) != EmitStatus.Open
                    if emit_expression(Expr.Ident("__arm_match", fin_m_line), result_types[0], local_scope, fns, structs, generics, runtime, m, ctx, builder) is fin_m_value:
                        _ = LLVMBuildStore(builder, fin_m_value, result_slots[0])
                        _ = LLVMBuildBr(builder, done_block)
                        return true
                    return false
            # A non-expression final statement (`return X`, `raise`) must itself terminate.
            fin_status: EmitStatus = emit_statement(final_stmt, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)
            false return if fin_status == EmitStatus.Declined
            return true



        # list ended the block.
        #
        # A statement AFTER a terminator is unreachable; the subset does not model dead
        # code, so it declines rather than emitting into a closed block (which LLVM would
        # reject anyway).
        def emit_statements(body: darray[Stmt]&, return_type: ValueType, local_scope: mutable Scope&, loops: mutable LoopStack&, regions: mutable RegionStack&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> EmitStatus can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                # A `defer block:` runs when the statement list that declared it ends. Owning that
                # HERE rather than at each construct is what makes it uniform: a match arm, an
                # `if` branch, a loop body, a `region` body and the function body are all just
                # statement lists, and patching them one at a time is how the rule kept being
                # missing somewhere (a match arm ran its defer AFTER the statement following the
                # match: stage0 2,1,4 and stage1 2,4,1).
                defer_mark: usize = local_scope.deferred.count
                status: mutable EmitStatus = EmitStatus.Open
                # `store: Expr.Store[Local] = Expr.Store(owner)` ACTIVATES that store for the
                # rest of the statement list, exactly as `in store:` does for its block —
                # stage0 accepts a bare constructor after such a declaration and rejects one
                # with no store in scope ("requires an active in Expr.Store: scope"). stage1
                # bound the active store only from the hidden parameter, an `in store:` clause,
                # or the SYNTHETIC per-function store, so a declared store was never consulted:
                # the constructor allocated its row out of the synthetic store while the handle
                # was matched against the declared one, and every such program aborted in
                # `ctx_packed_store_read_variant_sparse_tag` (index >= tags.count).
                #
                # The runtime is passed by reference into each statement, so a declaration
                # cannot publish itself to its successors through the loop. Thread a copy that
                # the declaration can update instead; nothing outside this list sees it, which
                # is what makes the activation lexically scoped.
                statements_runtime: mutable Runtime = copied_runtime(runtime)
                for statement in body |status, statements_runtime, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder|:
                    # Stage0 accepts unreachable tails after a return/break/terminating nested
                    # block and emits no code for them. Preserve the already-terminated status;
                    # treating the dead tail as a backend decline incorrectly stripped otherwise
                    # valid functions such as packed-store AST helpers.
                    continue if status != EmitStatus.Open
                    status <- emit_statement(statement, return_type, local_scope, loops, regions, fns, structs, generics, statements_runtime, m, ctx, builder)
                    if status == EmitStatus.Declined and dbg_decline_enabled():
                        _ = dbg_decline(statements_runtime.disjoint_function_name, statement)
                    # Read the slot back AFTER the declaration has emitted, so the load sees the
                    # initialized store rather than an undefined alloca.
                    if statement is Stmt.VarDecl(store_decl_name, store_decl_type_expr, store_decl_value, store_decl_line):
                        store_decl_type: ValueType = lookup_type(local_scope, store_decl_name)
                        if store_decl_type.kind == TypeKind.PackedStore and status == EmitStatus.Open:
                            if lookup_slot(local_scope, store_decl_name) is store_decl_slot:
                                statements_runtime.active_store <- LLVMBuildLoad2(builder, llvm_type_of(store_decl_type, structs, ctx), store_decl_slot, "store.active")
                                statements_runtime.active_store_enum <- store_decl_type.bits.i64()
                                statements_runtime.active_store_is_block <- true
                # Only while the block is still OPEN: a `return`/`raise` inside it already unwound
                # EVERYTHING on its way out, and `break`/`continue` unwind to the loop's mark —
                # both leave a terminated LLVM block that must not be appended to.
                if status == EmitStatus.Open and local_scope.deferred.count > defer_mark:
                    EmitStatus.Declined return if not emit_deferred_actions_from(local_scope, defer_mark, true, fns, structs, generics, runtime, m, ctx, builder)
                # Consumed, so a later unwind does not run it twice. The ENTRY stays: a
                # `defer function:` declared in this same list still belongs to the function, and
                # removing entries would shift the indices of the ones that do.
                for consumed_index in defer_mark..<local_scope.deferred.count |local_scope|:
                    local_scope.deferred[consumed_index].body.clear() if local_scope.deferred[consumed_index].scope_exit
                return status




            # Emit a lexical block: the statements, then drop everything they declared.
            #
            # This is the form every STATEMENT body wants (if/else arms, loop bodies, match arm
            # bodies) — the names die with the block, so a later sibling block cannot resolve one
            # of them to a slot its own path never stored (see scope_restore). A VALUE block is
            # the exception: its trailing value expression is still inside the block and must see
            # the block's names, so those sites call `emit_statements` directly and restore once
            # the value has been emitted.
        def emit_statements_scoped(body: darray[Stmt]&, return_type: ValueType, local_scope: mutable Scope&, loops: mutable LoopStack&, regions: mutable RegionStack&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> EmitStatus can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                block_mark: usize = scope_mark(local_scope)
                # SoA row binders (`view = s[row]`) are scoped like locals: one declared inside
                # a block must not outlive it, or a same-named binding in a sibling scope would
                # resolve to the wrong aggregate.
                soa_binder_mark: usize = structs.soa_row_binder_names.count
                # `defer block:` runs when the SCOPE that declared it ends — per loop ITERATION,
                # at the end of a `region` body, at the end of any nested block. Only the pool /
                # nursery path ever unwound them, so everywhere else they either ran once at
                # function exit or not at all: a `defer` in a two-iteration loop body ran ONE
                # time (stage1 2,2,1) where stage0 runs it per iteration (2,1,2,1), and a
                # `defer` in a `region` ran AFTER the statement following the region.
                status: EmitStatus = emit_statements(body, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)
                scope_restore(local_scope, block_mark)
                if structs.soa_row_binder_names.count > soa_binder_mark:
                    structs.soa_row_binder_names <- structs.soa_row_binder_names.truncate(soa_binder_mark)
                    structs.soa_row_binder_slots <- structs.soa_row_binder_slots.truncate(soa_binder_mark)
                    structs.soa_row_binder_bases <- structs.soa_row_binder_bases.truncate(soa_binder_mark)
                    structs.soa_row_binder_indexes <- structs.soa_row_binder_indexes.truncate(soa_binder_mark)
                return status




        # `panic at FILE:LINE:COL: MESSAGE`, then `backtrace:` and the symbolized frames —
        # stage0's panic report, emitted immediately before the `abort()`.
        #
        # The three moving parts and where each comes from:
        #   * FILE  — the module's source filename, stamped by the driver
        #     (stamp_module_source_path). Empty when the module was built without one, in
        #     which case the whole report is skipped rather than printing `panic at :2:5:`.
        #   * LINE  — the panic call's own line, carried by the Expr.
        #   * COL   — the `panic` KEYWORD's column, which Expr does not carry. The parser
        #     records it in a line-keyed side table (panic_line_rows/panic_column_rows),
        #     the same shape func_decl_columns already uses for constructor mangling.
        #
        # The backtrace goes to fd 2 (stderr) while the message goes to stdout, which is
        # stage0's split — `-emit test` replays the two streams separately and they must
        # land in the same ones.
        def emit_panic_report(arguments: darray[Expr]&, structs: mutable StructTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef, line: u32) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                source_length: mutable usize = 0
                source_path: cstr = LLVMGetSourceFileName(m, &source_length)
                return if source_length == 0

                i64_type: LLVMTypeRef = LLVMInt64TypeInContext(ctx)
                ptr_type: LLVMTypeRef = LLVMPointerTypeInContext(ctx, 0)
                printf_params: mutable darray[LLVMTypeRef] = [ptr_type]
                printf_params_pointer: void& = (&printf_params[0]).cast[void&] can Unsafe.PointerCast
                printf_type: LLVMTypeRef = LLVMFunctionType(i64_type, printf_params_pointer, 1, 1)
                printf_fn: LLVMValueRef = declare_or_get_named(m, "printf", printf_type)

                format_global: LLVMValueRef = LLVMBuildGlobalStringPtr(builder, "panic at %s:%d:%d: %s\n", "panic.format")
                file_global: LLVMValueRef = LLVMBuildGlobalStringPtr(builder, source_path, "panic.file")
                message_storage: mutable darray[u8] = []
                message_global: LLVMValueRef = LLVMBuildGlobalStringPtr(builder, panic_message_cstr(arguments, message_storage), "panic.message")

                report_args: mutable darray[LLVMValueRef] = [format_global, file_global, LLVMConstInt(i64_type, Lexer::source_original_line(line).u64(), 0), LLVMConstInt(i64_type, panic_column_for_line(structs, line).u64(), 0), message_global]
                report_args_pointer: void& = (&report_args[0]).cast[void&] can Unsafe.PointerCast
                _ = LLVMBuildCall2(builder, printf_type, printf_fn, report_args_pointer, 5, "")

                # backtrace(3): 64 frames is stage0's depth.
                frame_array: LLVMTypeRef = LLVMArrayType(ptr_type, 64)
                frame_buffer: LLVMValueRef = build_entry_alloca(builder, frame_array, "panic.backtrace.buffer")
                backtrace_params: mutable darray[LLVMTypeRef] = [ptr_type, i64_type]
                backtrace_params_pointer: void& = (&backtrace_params[0]).cast[void&] can Unsafe.PointerCast
                backtrace_type: LLVMTypeRef = LLVMFunctionType(i64_type, backtrace_params_pointer, 2, 0)
                backtrace_fn: LLVMValueRef = declare_or_get_named(m, "backtrace", backtrace_type)
                backtrace_args: mutable darray[LLVMValueRef] = [frame_buffer, LLVMConstInt(i64_type, 64, 0)]
                backtrace_args_pointer: void& = (&backtrace_args[0]).cast[void&] can Unsafe.PointerCast
                frame_count: LLVMValueRef = LLVMBuildCall2(builder, backtrace_type, backtrace_fn, backtrace_args_pointer, 2, "panic.backtrace.count")

                header_global: LLVMValueRef = LLVMBuildGlobalStringPtr(builder, "backtrace:\n", "panic.backtrace.header")
                header_args: mutable darray[LLVMValueRef] = [header_global]
                header_args_pointer: void& = (&header_args[0]).cast[void&] can Unsafe.PointerCast
                _ = LLVMBuildCall2(builder, printf_type, printf_fn, header_args_pointer, 1, "")

                symbols_params: mutable darray[LLVMTypeRef] = [ptr_type, i64_type, i64_type]
                symbols_params_pointer: void& = (&symbols_params[0]).cast[void&] can Unsafe.PointerCast
                symbols_type: LLVMTypeRef = LLVMFunctionType(LLVMVoidTypeInContext(ctx), symbols_params_pointer, 3, 0)
                symbols_fn: LLVMValueRef = declare_or_get_named(m, "backtrace_symbols_fd", symbols_type)
                symbols_args: mutable darray[LLVMValueRef] = [frame_buffer, frame_count, LLVMConstInt(i64_type, 2, 0)]
                symbols_args_pointer: void& = (&symbols_args[0]).cast[void&] can Unsafe.PointerCast
                _ = LLVMBuildCall2(builder, symbols_type, symbols_fn, symbols_args_pointer, 3, "")




        # The panic's message text. A bare `panic()` carries none, and stage0 falls back to
        # the literal "panic" (its @panic.default.message).
        def panic_message_cstr(arguments: darray[Expr]&, storage: mutable darray[u8]&) -> cstr can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                if arguments.count > 0:
                    if arguments[0] is Expr.StringLit(panic_text, _):
                        return decoded_literal_cstr(panic_text, storage)
                return "panic"




        # The recorded column of the `panic` keyword on `line`, or 0 when the line is not in
        # the table (a panic the parser synthesized rather than read from source).
        def panic_column_for_line(structs: StructTable&, line: u32) -> u32 can[Abort.Panic]:
            for index in 0..<structs.panic_line_rows.count |structs, line|:
                structs.panic_column_rows[index] return if structs.panic_line_rows[index] == line and index < structs.panic_column_rows.count
            return 0

include "./codegen_narrowing.elisa"
include "./codegen_guards.elisa"
include "./codegen_match_into_slot.elisa"
