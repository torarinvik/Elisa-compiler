# Stage1 backend — conditions, `assert`-narrowing bookkeeping, and the statement-list driver.
# Part of `module Backend` (see codegen.elisa); split out to keep each file short.

extend Backend:
    private:
        # Emit a branch condition: a modeled `bool` (i1). Elisa requires a bool condition,
        # so this simply emits at bool type — no `!= 0` narrowing, because a comparison
        # already yields i1 and a bool local is stored as i1.
        def emit_condition(condition: Expr, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            bool_type: ValueType = ValueType{kind: TypeKind.Bool, bits: 1}
            condition_type: ValueType = resolve_type(condition, bool_type, local_scope, fns, structs, generics)
            null return if condition_type.kind != TypeKind.Bool
            # Open the condition-binding scope: every `is` test emitted inside this condition
            # shares one slot per bound name (see bind_is_slot). Depth-counted so a nested
            # condition — a ternary inside a guard, say — does not clear the outer registry.
            structs.cond_bind_depth <- structs.cond_bind_depth + 1
            condition_value: LLVMValueRef? = emit_expression(condition, bool_type, local_scope, fns, structs, generics, runtime, m, ctx, builder)
            structs.cond_bind_depth <- structs.cond_bind_depth - 1
            if structs.cond_bind_depth == 0:
                structs.cond_bind_names <- []
                structs.cond_bind_slots <- []
                structs.cond_bind_types <- []
            return condition_value


        # Branch to `dest` only when the just-emitted region left the block OPEN. An arm
        # that already returned must not also get a branch — LLVM rejects a block with two
        # terminators.
        def branch_if_open(status: EmitStatus, builder: LLVMBuilderRef, dest: LLVMBasicBlockRef) -> void can[Abort.Panic]:
            return if status != EmitStatus.Open
            _ = LLVMBuildBr(builder, dest)


        # The `owner` half of a narrowable path: `m.items` -> "m", `p` -> "p". "" = a shape
        # too complex to track (a call result, an index, a nested path), which simply never
        # narrows.
        def narrow_ident_of(path: Expr) -> sview can[Abort.Panic]:
            return match path:
                Expr.Ident(narrow_ident_name, _): narrow_ident_name
                _: ""


        def narrow_owner_of(path: Expr) -> sview can[Abort.Panic]:
            can Abort.Panic:
                return match path:
                    Expr.Field(narrow_head, _, _): narrow_ident_of(narrow_head)
                    Expr.Ident(narrow_ident_name, _): narrow_ident_name
                    _: ""


            # The `field` half: `m.items` -> "items", `p` -> "" (a bare local).
        def narrow_field_of(path: Expr) -> sview can[Abort.Panic]:
            return match path:
                Expr.Field(_, narrow_f_name, _): narrow_f_name
                _: ""


        # Whether `path` has been proven non-null by an earlier `assert PATH != null`.
        def path_is_narrowed(path: Expr, structs: StructTable&) -> bool can[Abort.Panic]:
            can Abort.Panic:
                narrow_owner: sview = narrow_owner_of(path)
                false return if narrow_owner == ""
                narrow_field: sview = narrow_field_of(path)
                narrow_index: mutable usize = 0
                while narrow_index < structs.narrowed_owners.count |narrow_index, narrow_owner, narrow_field, structs|:
                    true return if structs.narrowed_owners[narrow_index] == narrow_owner and structs.narrowed_fields[narrow_index] == narrow_field
                    narrow_index <- narrow_index + 1
                return false


            # Record `assert PATH != null`. Only a `!=` against the null literal narrows; `==
            # null` proves the opposite and must NOT record.
        def record_null_assert(predicate: Expr, structs: mutable StructTable&) -> void can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic:
                if predicate is Expr.Binary(assert_left, assert_operator, assert_right, assert_line):
                    return if assert_operator != TokenKind.BangEq
                    left_null: bool = is_null_literal(assert_left)
                    right_null: bool = is_null_literal(assert_right)
                    return if not (left_null or right_null)
                    asserted_path: Expr = assert_right if left_null else assert_left
                    asserted_owner: sview = narrow_owner_of(asserted_path)
                    return if asserted_owner == ""
                    structs.narrowed_owners <- structs.narrowed_owners.push(asserted_owner)
                    structs.narrowed_fields <- structs.narrowed_fields.push(narrow_field_of(asserted_path))


            # Drop any narrowing proof about `path` -- an assignment replaces the value the
            # proof was about, so a stale proof would unwrap a fresh null.
        def invalidate_narrowing(path: Expr, structs: mutable StructTable&) -> void can[Abort.Panic, Memory.Allocate]:
            invalid_owner: sview = narrow_owner_of(path)
            return if invalid_owner == ""
            # Assigning to `m` invalidates every proof about `m.FIELD` too: the whole struct
            # was replaced. So an owner match alone is enough to drop the row.
            # Collected into LOCALS, then the table is emptied and refilled by PUSH. Binding
            # `structs.narrowed_owners <- kept_owners` instead would hand the caller's field
            # a darray backed by this function's auto region, freed on return -- the
            # callee-rebind use-after-free the region checker rejects outright.
            kept_owners: mutable darray[sview] = []
            kept_fields: mutable darray[sview] = []
            keep_index: mutable usize = 0
            while keep_index < structs.narrowed_owners.count |keep_index, kept_owners, kept_fields, invalid_owner, structs|:
                if structs.narrowed_owners[keep_index] != invalid_owner:
                    kept_owners.push(structs.narrowed_owners[keep_index])
                    kept_fields.push(structs.narrowed_fields[keep_index])
                keep_index <- keep_index + 1
            clear_narrowings(structs)
            refill_index: mutable usize = 0
            while refill_index < kept_owners.count |refill_index, kept_owners, kept_fields, structs|:
                structs.narrowed_owners <- structs.narrowed_owners.push(kept_owners[refill_index])
                structs.narrowed_fields <- structs.narrowed_fields.push(kept_fields[refill_index])
                refill_index <- refill_index + 1


        # Record every `PATH != null` a guard CONDITION proves, walking `and` chains (the std
        # dict writes `if old_items_opt != null and old_capacity > 0:`). Only `and` is walked:
        # under `or` neither side is guaranteed, so nothing is proven.
        def record_null_guards(condition: Expr, structs: mutable StructTable&) -> void can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic, Memory.Allocate:
                if condition is Expr.Binary(guard_left, guard_operator, guard_right, guard_line):
                    if guard_operator == TokenKind.And:
                        record_null_guards(guard_left, structs)
                        record_null_guards(guard_right, structs)
                        return
                record_null_assert(condition, structs)


            # What a FALSE condition proves. An EARLY-RETURN guard (`X return if PATH == null`)
            # only falls through when the condition did NOT hold, so `PATH` is non-null for
            # everything after it — the shape the std's region and fixed-buffer helpers all open
            # with before using PATH as a plain ref. Mirrors stage0, which narrows here too.
            #
            # `or` is the walkable operator for the NEGATED form (both sides must be false), the
            # mirror of `and` in record_null_guards; under `and` neither side is proven.
        def record_null_guard_negation(condition: Expr, structs: mutable StructTable&) -> void can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic, Memory.Allocate:
                if condition is Expr.Binary(neg_left, neg_operator, neg_right, neg_line):
                    if neg_operator == TokenKind.Or:
                        record_null_guard_negation(neg_left, structs)
                        record_null_guard_negation(neg_right, structs)
                        return
                    return if neg_operator != TokenKind.EqEq
                    neg_left_null: bool = is_null_literal(neg_left)
                    neg_right_null: bool = is_null_literal(neg_right)
                    return if not (neg_left_null or neg_right_null)
                    negated_path: Expr = neg_right if neg_left_null else neg_left
                    negated_owner: sview = narrow_owner_of(negated_path)
                    return if negated_owner == ""
                    structs.narrowed_owners <- structs.narrowed_owners.push(negated_owner)
                    structs.narrowed_fields <- structs.narrowed_fields.push(narrow_field_of(negated_path))


            # Save the proof set so a branch's narrowings can be rolled back at the join: a proof
            # that only holds inside the `then` arm must not leak past it.
        def snapshot_narrowings(structs: StructTable&, saved_owners: mutable darray[sview]&, saved_fields: mutable darray[sview]&) -> void can[Abort.Panic, Memory.Allocate]:
            snapshot_index: mutable usize = 0
            while snapshot_index < structs.narrowed_owners.count |snapshot_index, saved_owners, saved_fields, structs|:
                saved_owners.push(structs.narrowed_owners[snapshot_index])
                saved_fields.push(structs.narrowed_fields[snapshot_index])
                snapshot_index <- snapshot_index + 1


        def restore_narrowings(structs: mutable StructTable&, saved_owners: darray[sview]&, saved_fields: darray[sview]&) -> void can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic, Memory.Allocate:
                clear_narrowings(structs)
                restore_index: mutable usize = 0
                while restore_index < saved_owners.count |restore_index, saved_owners, saved_fields, structs|:
                    structs.narrowed_owners <- structs.narrowed_owners.push(saved_owners[restore_index])
                    structs.narrowed_fields <- structs.narrowed_fields.push(saved_fields[restore_index])
                    restore_index <- restore_index + 1


            # Drop every narrowing proof (per-function reset, and the first half of a rebuild).
        def clear_narrowings(structs: mutable StructTable&) -> void can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic:
                while structs.narrowed_owners.count > 0 |structs|:
                    _ = structs.narrowed_owners.pop()
                while structs.narrowed_fields.count > 0 |structs|:
                    _ = structs.narrowed_fields.pop()


            # Emit the LLVM trap intrinsic and terminate the failure block. This is shared by
            # forced dereference guards and the dynamic index watchdog; unlike libc abort it
            # remains a recognizable `llvm.trap` for both LLVM and stage0 parity checks.
        def emit_trap_unreachable(m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> void can[Abort.Panic, Unsafe.PointerCast]:
            trap_name: cstr = "llvm.trap"
            trap_type: LLVMTypeRef = LLVMFunctionType(LLVMVoidTypeInContext(ctx), null, 0, 0)
            # `LLVMAddFunction` does NOT deduplicate by name — a second call with the same
            # name gets a MANGLED symbol (`llvm.trap.1`, `llvm.trap.2`, …), which is no
            # longer the real `llvm.trap` INTRINSIC LLVM recognizes at codegen time; it
            # becomes an ordinary external declaration with no definition anywhere, and the
            # link fails with "undefined symbol _llvm.trap.N". Harmless for callers that
            # trap at most once per function, which is why this went unnoticed — checked
            # arithmetic overflow can trap from many call sites in the SAME function.
            trap_fn: mutable LLVMValueRef = zeroed
            if LLVMGetNamedFunction(m, trap_name) is existing_trap:
                trap_fn <- existing_trap
            else:
                trap_fn <- LLVMAddFunction(m, trap_name, trap_type)
            _ = LLVMBuildCall2(builder, trap_type, trap_fn, null, 0, "")
            _ = LLVMBuildUnreachable(builder)


        # In forced bounds mode, reject null and near-null addresses before they are
        # dereferenced. Runtime-derived pointers are compared directly; this deliberately
        # stays conservative for stack/global addresses, which is safe and keeps the
        # guard independent of LLVM's value-kind introspection API.
        def emit_pointer_deref_guard(pointer: LLVMValueRef, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> void can[Abort.Panic, Unsafe.PointerCast]:
            return if not runtime.force_bounds_check
            return if pointer == zeroed
            int_pointer: LLVMValueRef = LLVMBuildPtrToInt(builder, pointer, LLVMInt64TypeInContext(ctx), "pg.addr")
            limit: LLVMValueRef = LLVMConstInt(LLVMInt64TypeInContext(ctx), 65536, 0)
            valid: LLVMValueRef = LLVMBuildICmp(builder, 35, int_pointer, limit, "pg.valid")
            ok_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder)), "pg.ok")
            fail_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder)), "pg.fail")
            _ = LLVMBuildCondBr(builder, valid, ok_block, fail_block)
            LLVMPositionBuilderAtEnd(builder, fail_block)
            emit_trap_unreachable(m, ctx, builder)
            LLVMPositionBuilderAtEnd(builder, ok_block)


        # Dynamic container indices are checked when the opt-in flag is active. The
        # semantic checker already handles `get ... else` and proven accesses; this
        # backend guard covers unchecked reads/writes before their GEP is used.
        def emit_index_bounds_guard(array_slot: LLVMValueRef, array_type: ValueType, index: LLVMValueRef, runtime: Runtime&, structs: mutable StructTable&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            return if not runtime.force_bounds_check
            emit_pointer_deref_guard(array_slot, runtime, m, ctx, builder)
            count_pointer: mutable LLVMValueRef = zeroed
            count_value: mutable LLVMValueRef = zeroed
            if array_type.kind == TypeKind.DArray:
                count_pointer <- LLVMBuildStructGEP2(builder, darray_llvm_type(structs, ctx), array_slot, 1, "bounds.count.ptr")
                count_value <- LLVMBuildLoad2(builder, LLVMInt64TypeInContext(ctx), count_pointer, "bounds.count")
            elif array_type.kind == TypeKind.Array:
                count_value <- LLVMConstInt(LLVMInt64TypeInContext(ctx), structs.array_extents[array_type.bits.usize()].u64(), 0)
            else:
                return
            valid: LLVMValueRef = LLVMBuildICmp(builder, 36, index, count_value, "wd.in_bounds")
            parent: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
            ok_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, parent, "wd.ok")
            fail_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, parent, "wd.fail")
            _ = LLVMBuildCondBr(builder, valid, ok_block, fail_block)
            LLVMPositionBuilderAtEnd(builder, fail_block)
            emit_trap_unreachable(m, ctx, builder)
            LLVMPositionBuilderAtEnd(builder, ok_block)


        # Emit a runtime contract guard: branch on `condition`, abort on false, and leave
        # the builder positioned on the success path. Shared by `requires`/`assert` (checked
        # where they are written) and `ensure` (checked at every return).
        def emit_contract_guard(condition: LLVMValueRef, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> void can[Abort.Panic]:
            guard_fn: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
            guard_ok: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, guard_fn, "contract.ok")
            guard_fail: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, guard_fn, "contract.fail")
            _ = LLVMBuildCondBr(builder, condition, guard_ok, guard_fail)
            LLVMPositionBuilderAtEnd(builder, guard_fail)
            guard_abort_type: LLVMTypeRef = LLVMFunctionType(LLVMVoidTypeInContext(ctx), null, 0, 0)
            guard_abort_fn: LLVMValueRef = declare_or_get_abort(m, guard_abort_type)
            _ = LLVMBuildCall2(builder, guard_abort_type, guard_abort_fn, null, 0, "")
            _ = LLVMBuildUnreachable(builder)
            LLVMPositionBuilderAtEnd(builder, guard_ok)


        # Check the current function's `ensure` postconditions against the value it is about
        # to return. Mirrors stage0's shape: bind the returned value as `result` (stage0
        # allocates a `%result` slot and stores into it), then guard on each predicate.
        # Called on the return path, BEFORE the regions are unwound -- a predicate may read a
        # container the auto region still backs.
        #
        # False = DECLINE (a predicate the expression emitter cannot model). Never silently
        # skips a check: a contract that is not emitted is a contract that is not enforced.
        def emit_ensure_checks(return_value: LLVMValueRef, return_type: ValueType, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            ensure_count: usize = structs.pending_ensures.count
            true return if ensure_count == 0
            false return if return_type.kind == TypeKind.Void
            result_slot: LLVMValueRef = LLVMBuildAlloca(builder, llvm_type_of(return_type, structs, ctx), "result")
            _ = LLVMBuildStore(builder, return_value, result_slot)
            # `result` is an ordinary local from here, so the predicate's `result >= a` needs
            # no special case in the expression emitter.
            declare_local(local_scope, "result", result_slot, return_type)
            ensure_bool: ValueType = ValueType{kind: TypeKind.Bool, bits: 1}
            ensure_index: mutable usize = 0
            while ensure_index < ensure_count |ensure_index, ensure_count, ensure_bool, local_scope, fns, structs, generics, runtime, m, ctx, builder|:
                # Copied OUT of the table: emit_expression takes `structs` mutably, so a
                # borrow held across the call would conflict.
                ensure_pred: Expr = structs.pending_ensures[ensure_index]
                if emit_expression(ensure_pred, ensure_bool, local_scope, fns, structs, generics, runtime, m, ctx, builder) is ensure_value:
                    emit_contract_guard(ensure_value, m, ctx, builder)
                else:
                    return false
                ensure_index <- ensure_index + 1
            return true


        # The source line carried by every statement kind that this backend can lower.
        def trace_line(statement: Stmt) -> u32:
            if statement is Stmt.Block(kind, clause, binding, body, line): return line.line
            if statement is Stmt.Contract(kind, predicate, line): return line.line
            if statement is Stmt.Expr(expression, line): return line.line
            if statement is Stmt.Return(value, line): return line.line
            if statement is Stmt.VarDecl(name, type_expression, value, line): return line.line
            if statement is Stmt.Assign(target, operator, value, line): return line.line
            if statement is Stmt.If(condition, then_body, else_body, line): return line.line
            if statement is Stmt.While(condition, body, line): return line.line
            if statement is Stmt.Break(label, line): return line.line
            if statement is Stmt.Continue(label, line): return line.line
            if statement is Stmt.Match(scrutinee, arms, line): return line.line
            if statement is Stmt.For(bind, variables, iterable, body, line): return line.line
            return 0

        def emit_trace_step(statement: Stmt, runtime: Runtime&, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            return if not runtime.trace_enabled
            line: u32 = trace_line(statement)
            arguments: mutable darray[LLVMValueRef] = [runtime.trace_name, LLVMConstInt(LLVMInt32TypeInContext(ctx), line.u64(), 0)]
            arguments_pointer: void& = (&arguments[0]).cast[void&] can Unsafe.PointerCast
            _ = LLVMBuildCall2(builder, runtime.trace_record_type, runtime.trace_record, arguments_pointer, 2, "")

        # Record scalar local values using stage0's four-argument trace ABI. Aggregates and
        # floating-point values intentionally fall back to the ordinary step record: the
        # runtime value slot is an integer word and must never receive a guessed bitcast.
        def emit_trace_value(name: sview, line: u32, value: LLVMValueRef, value_type: ValueType, runtime: Runtime&, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            return if not runtime.trace_enabled or name == "_"
            int64_type: LLVMTypeRef = LLVMInt64TypeInContext(ctx)
            value64: mutable LLVMValueRef? = null
            if value_type.kind == TypeKind.Ref or value_type.kind == TypeKind.CStr:
                value64 <- LLVMBuildPtrToInt(builder, value, int64_type, "trace.ptr")
            if value_type.kind == TypeKind.Bool or value_type.kind == TypeKind.Signed or value_type.kind == TypeKind.Unsigned:
                value64 <- value if value_type.bits == 64 else LLVMBuildSExt(builder, value, int64_type, "trace.sext") if value_type.kind == TypeKind.Signed else LLVMBuildZExt(builder, value, int64_type, "trace.zext")
            if value64 is recorded_value:
                name_storage: mutable darray[u8] = []
                variable_name: LLVMValueRef = LLVMBuildGlobalStringPtr(builder, sview_to_cstr(name, name_storage), "trace.variable")
                arguments: mutable darray[LLVMValueRef] = [runtime.trace_name, LLVMConstInt(LLVMInt32TypeInContext(ctx), line.u64(), 0), variable_name, recorded_value]
                arguments_pointer: void& = (&arguments[0]).cast[void&] can Unsafe.PointerCast
                _ = LLVMBuildCall2(builder, runtime.trace_record_value_type, runtime.trace_record_value, arguments_pointer, 4, "")

        # Lower `for i in LOW ..< HIGH by par:` through the stage0 structured-parallel runtime.
        # The runtime takes a zero-based index callback, so the callback reconstructs the
        # source index by adding LOW. LOW/HIGH are saved in caller locals so the lambda's normal
        # scalar-capture machinery carries non-zero ranges without inventing a new closure ABI.
        # The runtime function is intentionally looked up in `fns`: a source that has not
        # included the concurrency runtime must decline rather than emit an unresolved guess.
        def emit_parallel_range_for(variables: darray[sview]&, iterable: Expr, body: darray[Stmt]&, line: u32, return_type: ValueType, local_scope: mutable Scope&, loops: mutable LoopStack&, regions: mutable RegionStack&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> EmitStatus can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            EmitStatus.Declined return if variables.count != 1
            if iterable is Expr.Binary(range_low, range_operator, range_high, range_line):
                EmitStatus.Declined return if range_operator != TokenKind.RangeLt and range_operator != TokenKind.RangeLe
                usize_type: ValueType = ValueType{kind: TypeKind.Unsigned, bits: 64}
                if emit_expression(range_low, usize_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is low_value:
                    if emit_expression(range_high, usize_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is high_value:
                        low_name: sview = "__parallel_low"
                        high_name: sview = "__parallel_high"
                        low_storage: mutable darray[u8] = []
                        high_storage: mutable darray[u8] = []
                        low_slot: LLVMValueRef = LLVMBuildAlloca(builder, llvm_type_of(usize_type, structs, ctx), sview_to_cstr(low_name, low_storage))
                        high_slot: LLVMValueRef = LLVMBuildAlloca(builder, llvm_type_of(usize_type, structs, ctx), sview_to_cstr(high_name, high_storage))
                        _ = LLVMBuildStore(builder, low_value, low_slot)
                        _ = LLVMBuildStore(builder, high_value, high_slot)
                        declare_local(local_scope, low_name, low_slot, usize_type)
                        declare_local(local_scope, high_name, high_slot, usize_type)

                        callback_name: sview = variables[0]
                        callback_body: mutable darray[Stmt] = []
                        callback_index: Expr = Expr.Ident("__parallel_index", Ast::pos_at_line(line))
                        reconstructed: Expr = Expr.Binary(Expr.Ident(low_name, Ast::pos_at_line(line)), TokenKind.Plus, callback_index, Ast::pos_at_line(line))
                        callback_body.push(Stmt.VarDecl(callback_name, Expr.Ident("usize", Ast::pos_at_line(line)), reconstructed, Ast::pos_at_line(line)))
                        callback_body.extend(body)
                        callback_body.push(Stmt.Return(Expr.IntLit(0), Ast::pos_at_line(line)))
                        callback: Expr = Expr.Lambda(["__parallel_index"], callback_body, Ast::pos_at_line(line))

                        width: mutable Expr = Expr.Binary(Expr.Ident(high_name, Ast::pos_at_line(line)), TokenKind.Minus, Expr.Ident(low_name, Ast::pos_at_line(line)), Ast::pos_at_line(line))
                        if range_operator == TokenKind.RangeLe:
                            width <- Expr.Binary(width, TokenKind.Plus, Expr.IntLit(1), Ast::pos_at_line(line))
                        arguments: mutable darray[Expr] = [width, callback, Expr.IntLit(0)]
                        call: Expr = Expr.Ident("for_indices_par", Ast::pos_at_line(line))
                        if emit_call(call, arguments, [], local_scope, fns, structs, generics, runtime, m, ctx, builder) is parallel_result:
                            _ = parallel_result
                            return EmitStatus.Open
            return EmitStatus.Declined


        # Lower `parallel for band in slice:` through the generic `each` combinator. The
        # semantic checker guarantees that the source is a thread-shareable band view and that
        # the body does not mutate an outer binding; the callback therefore needs only its band
        # parameter plus the ordinary scalar captures handled by emit_lambda_value.
        def emit_parallel_band_for(variables: darray[sview]&, iterable: Expr, body: darray[Stmt]&, line: u32, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> EmitStatus can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            EmitStatus.Declined return if variables.count != 1
            callback_body: mutable darray[Stmt] = []
            callback_body.extend(body)
            callback_body.push(Stmt.Return(Expr.IntLit(0), Ast::pos_at_line(line)))
            callback: Expr = Expr.Lambda([variables[0]], callback_body, Ast::pos_at_line(line))
            arguments: mutable darray[Expr] = [iterable, callback, Expr.IntLit(0)]
            if emit_call(Expr.Ident("each", Ast::pos_at_line(line)), arguments, [], local_scope, fns, structs, generics, runtime, m, ctx, builder) is parallel_each_result:
                _ = parallel_each_result
                return EmitStatus.Open
            return EmitStatus.Declined


        # Emit a statement list. Declined if ANY statement declined; Terminated if the
        # Emit one arm's body of a `x = match …` and STORE its yielded value into `result_slot`,
        # then branch to `done_block`. Unlike a match-EXPRESSION arm (a single expression), a
        # statement-position arm may be a BLOCK: leading statements (a `rebind`, a call) followed
        # by a final yield expression. The leading statements are emitted in full statement
        # context; the final `Stmt.Expr` becomes the stored value. A prefix that itself terminates
        # (a `return` in the arm) yields no value and just closes the arm. Returns false to DECLINE.
        # `result_types`/`result_slots` are PARALLEL and usually hold one entry. They hold N when
        # the match feeds a DESTRUCTURING assignment (`a, b, c = match X:`), in which case each
        # arm's yielded value must be an N-element tuple and element i lands in slot i.
        def emit_arm_body_into_slot(body: darray[Stmt]&, result_types: darray[ValueType]&, result_slots: darray[LLVMValueRef]&, done_block: LLVMBasicBlockRef, return_type: ValueType, local_scope: mutable Scope&, loops: mutable LoopStack&, regions: mutable RegionStack&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            false return if body.count == 0
            prefix_open: mutable bool = true
            for prefix_index in 0..<body.count - 1 |prefix_open, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder|:
                continue if not prefix_open
                pre_status: EmitStatus = emit_statement(body[prefix_index], return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)
                false return if pre_status == EmitStatus.Declined
                prefix_open <- false if pre_status != EmitStatus.Open
            # A prefix that already returned/broke leaves no open block to yield into.
            true return if not prefix_open
            final_stmt: Stmt = body[body.count - 1]
            if final_stmt is Stmt.Expr(final_expr, final_line):
                # N slots: the yield must be an N-element tuple, emitted element by element.
                if result_slots.count > 1:
                    if final_expr is Expr.Tuple(final_elements, final_elements_line):
                        false return if final_elements.count != result_slots.count
                        final_tuple_ok: mutable bool = true
                        for final_index in 0..<final_elements.count |final_tuple_ok, final_elements, result_types, result_slots, local_scope, fns, structs, generics, runtime, m, ctx, builder|:
                            continue if not final_tuple_ok
                            if emit_expression(final_elements[final_index], result_types[final_index], local_scope, fns, structs, generics, runtime, m, ctx, builder) is final_element_value:
                                _ = LLVMBuildStore(builder, final_element_value, result_slots[final_index])
                            else:
                                final_tuple_ok <- false
                        false return if not final_tuple_ok
                        _ = LLVMBuildBr(builder, done_block)
                        return true
                    return false
                if emit_expression(final_expr, result_types[0], local_scope, fns, structs, generics, runtime, m, ctx, builder) is final_value:
                    _ = LLVMBuildStore(builder, final_value, result_slots[0])
                    _ = LLVMBuildBr(builder, done_block)
                    return true
                return false
            # An arm body whose last statement is ITSELF a match — `return match type_a:` where
            # each arm is `match type_b:` (symbols.elisa's structural comparisons). It parses as
            # a Stmt.Match, not an expression, so it fell through to the terminator path below,
            # which emits the inner match as a STATEMENT: it stores nothing into this arm's
            # result slot and does not branch to `done`. Recurse through this emitter into a temp
            # local instead, then yield that local like any other arm value.
            #
            # PACKED only, for the same reason as the `return match` split: the match-EXPRESSION
            # emitter models range patterns this one does not, so it stays the default elsewhere.
            if final_stmt is Stmt.Match(fin_m_scrutinee, fin_m_arms, fin_m_line):
                fin_m_type: ValueType = expression_type(fin_m_scrutinee, local_scope, fns, structs, generics)
                if fin_m_type.kind == TypeKind.PackedEnum and result_slots.count == 1:
                    fin_m_names: mutable darray[sview] = ["__arm_match"]
                    false return if emit_match_into_slot(fin_m_scrutinee, fin_m_arms, result_types, fin_m_names, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder) != EmitStatus.Open
                    if emit_expression(Expr.Ident("__arm_match", fin_m_line), result_types[0], local_scope, fns, structs, generics, runtime, m, ctx, builder) is fin_m_value:
                        _ = LLVMBuildStore(builder, fin_m_value, result_slots[0])
                        _ = LLVMBuildBr(builder, done_block)
                        return true
                    return false
            # A non-expression final statement (`return X`, `raise`) must itself terminate.
            fin_status: EmitStatus = emit_statement(final_stmt, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)
            false return if fin_status == EmitStatus.Declined
            return true

        # `x: T = match SCRUT:` — a match in VALUE position whose arms may be BLOCKS (statements
        # then a yield). emit_expression's Expr.Match handles only single-expression arms and
        # lacks the statement context (loops/regions/return_type) a block arm needs; this runs
        # at statement level and routes each arm through emit_arm_body_into_slot. Allocates and
        # declares `var_name`. Mirrors the match-expr's scrutinee dispatch (int/cstr/sview/packed/
        # penum) and its variant-payload binding. Returns Declined for unmodeled shapes.
        def emit_match_into_slot(match_scrutinee: Expr, match_arms: darray[MatchArm]&, result_types: darray[ValueType]&, var_names: darray[sview]&, return_type: ValueType, local_scope: mutable Scope&, loops: mutable LoopStack&, regions: mutable RegionStack&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> EmitStatus can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            scrutinee_type: ValueType = resolve_type(match_scrutinee, ValueType{kind: TypeKind.Signed, bits: 64}, local_scope, fns, structs, generics)
            penum_scrutinee: bool = scrutinee_type.kind == TypeKind.PayloadEnum
            packed_scrutinee: bool = scrutinee_type.kind == TypeKind.PackedEnum
            cstr_scrutinee: bool = scrutinee_type.kind == TypeKind.CStr
            sview_scrutinee: bool = scrutinee_type.kind == TypeKind.SView
            EmitStatus.Declined return if result_types.count == 0 or result_types.count != var_names.count
            mis_type_unmodeled: mutable bool = false
            for mis_type_probe in result_types |mis_type_unmodeled|:
                mis_type_unmodeled <- true if mis_type_probe.kind == TypeKind.Unmodeled
            EmitStatus.Declined return if mis_type_unmodeled
            # A multi-column `when` in VALUE position — `return when a, b:` and `x = when a, b:`,
            # which is every spelling that occurs in practice (the compiler's own sources use
            # `return when …` exclusively). Same first-wins chain as the statement form in
            # codegen_stmt_match_tuple.elisa; the difference is only that each row yields into
            # the result slots instead of running statements. See that file for the lowering.
            if match_scrutinee is Expr.Tuple(mwt_elements, mwt_tuple_line):
                EmitStatus.Declined return if mwt_elements.count < 2 or match_arms.count < 1
                mwt_values: mutable darray[LLVMValueRef] = []
                mwt_types: mutable darray[ValueType] = []
                mwt_compare_types: mutable darray[LLVMTypeRef] = []
                mwt_column_failed: mutable bool = false
                for mwt_element in mwt_elements |mwt_column_failed, mwt_values, mwt_types, mwt_compare_types, local_scope, fns, structs, generics, runtime, m, ctx, builder|:
                    continue if mwt_column_failed
                    mwt_element_type: ValueType = resolve_type(mwt_element, ValueType{kind: TypeKind.Signed, bits: 64}, local_scope, fns, structs, generics)
                    if not is_integer_type(mwt_element_type) and mwt_element_type.kind != TypeKind.Bool:
                        mwt_column_failed <- true
                        continue
                    if emit_expression(mwt_element, mwt_element_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is mwt_element_value:
                        mwt_values.push(mwt_element_value)
                        mwt_compare_types.push(llvm_type_of(mwt_element_type, structs, ctx))
                        mwt_types.push(mwt_element_type)
                    else:
                        mwt_column_failed <- true
                EmitStatus.Declined return if mwt_column_failed
                mwt_function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                mwt_storage: mutable darray[u8] = []
                mwt_slots: mutable darray[LLVMValueRef] = []
                for mwt_slot_index in 0..<result_types.count |mwt_slots, mwt_storage, result_types, var_names, structs, ctx, builder|:
                    mwt_slots.push(LLVMBuildAlloca(builder, llvm_type_of(result_types[mwt_slot_index], structs, ctx), sview_to_cstr(var_names[mwt_slot_index], mwt_storage)))
                mwt_done: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, mwt_function, "mwhen.done")
                mwt_declined: mutable bool = false
                mwt_saw_default: mutable bool = false
                for mwt_arm in match_arms |mwt_declined, mwt_saw_default, mwt_values, mwt_types, mwt_compare_types, mwt_slots, mwt_function, mwt_done, result_types, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder|:
                    continue if mwt_declined or mwt_saw_default
                    if arm_has_guard(mwt_arm.guard):
                        mwt_declined <- true
                        continue
                    mwt_arm_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, mwt_function, "mwhen.row")
                    if is_catch_all_pattern(mwt_arm.pattern):
                        _ = LLVMBuildBr(builder, mwt_arm_block)
                        LLVMPositionBuilderAtEnd(builder, mwt_arm_block)
                        mwt_declined <- true if not emit_arm_body_into_slot(mwt_arm.body, result_types, mwt_slots, mwt_done, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)
                        mwt_saw_default <- true if not mwt_declined
                        continue
                    mwt_columns: mutable darray[Pattern] = []
                    if not when_row_columns(mwt_arm.pattern, mwt_columns):
                        mwt_declined <- true
                        continue
                    if mwt_columns.count != mwt_values.count:
                        mwt_declined <- true
                        continue
                    mwt_next: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, mwt_function, "mwhen.next")
                    if emit_when_row_hit(mwt_columns, mwt_values, mwt_types, mwt_compare_types, structs, ctx, builder) is mwt_hit:
                        _ = LLVMBuildCondBr(builder, mwt_hit, mwt_arm_block, mwt_next)
                        LLVMPositionBuilderAtEnd(builder, mwt_arm_block)
                        mwt_declined <- true if not emit_arm_body_into_slot(mwt_arm.body, result_types, mwt_slots, mwt_done, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)
                        LLVMPositionBuilderAtEnd(builder, mwt_next)
                    else:
                        mwt_declined <- true
                EmitStatus.Declined return if mwt_declined
                # Without a `_` row the fall-through leaves the slots at their alloca'd value.
                # stage0's R2 totality check owns "a table must cover its columns", so this tail
                # is unreachable in a program that got this far.
                if not mwt_saw_default:
                    _ = LLVMBuildBr(builder, mwt_done)
                LLVMPositionBuilderAtEnd(builder, mwt_done)
                for mwt_declare in 0..<result_types.count |local_scope, mwt_slots, result_types, var_names|:
                    declare_local(local_scope, var_names[mwt_declare], mwt_slots[mwt_declare], result_types[mwt_declare])
                return EmitStatus.Open
            # `x: T = match p: Point{x, y}: EXPR / _: EXPR` — a plain STRUCT destructure in
            # VALUE position. Mirrors the statement emitter's struct-pattern arm
            # (codegen_stmt_match.elisa) and the `is`-condition struct narrowing
            # (codegen_expr_idents_binary.elisa): a struct pattern has no discriminant (the
            # scrutinee's STATIC type already names the struct), so the struct arm is
            # unconditionally taken. CONFIRMED against stage0's own `-emit llvm -O0` output:
            # unconditional per-field extractvalue/store into the bound names, then the arm
            # body; the fallback `_` arm's own block is emitted but is dead code ("No
            # predecessors!") — it is only there because value-position match must be
            # exhaustive (stage0 rejects a struct match with no trailing `_`). Since that arm
            # never actually runs, this emitter does not bother replicating its dead block —
            # only its PRESENCE is required, to keep the shape restricted to what was verified.
            #
            # SOUND SUBSET, same restriction as the two sibling fixes: exactly two arms
            # (Struct then a catch-all), and only Binding/Wildcard inner field patterns —
            # a literal or nested sub-pattern field declines, as does any extra arm between
            # them (no example of either shape exists in the corpus to verify against).
            if scrutinee_type.kind == TypeKind.Struct and match_arms.count == 2:
                # `Point{x, y} as whole: …` — same struct destructure, plus the whole matched
                # value bound to `whole` (docs/122 §5.4 as-binding). The parser only ever wraps
                # a Variant or Struct pattern in `Pattern.As`, so unwrapping it here and falling
                # through to the identical Struct handling — with one extra bind — covers the
                # struct case with no new dispatch shape.
                mss_as_name: mutable sview = ""
                mss_pattern: mutable Pattern = match_arms[0].pattern
                if match_arms[0].pattern is Pattern.As(mss_as_outer_name, mss_as_inner):
                    if mss_as_inner.count == 1 and mss_as_inner[0] is Pattern.Struct(_, _):
                        mss_as_name <- mss_as_outer_name
                        mss_pattern <- mss_as_inner[0]
                if mss_pattern is Pattern.Struct(mss_path, mss_fields):
                    if not arm_has_guard(match_arms[0].guard) and is_catch_all_pattern(match_arms[1].pattern) and not arm_has_guard(match_arms[1].guard):
                        mss_slot: i64 = struct_index_of(structs, mss_path)
                        if mss_slot >= 0 and mss_slot.u32() == scrutinee_type.bits:
                            mss_declined: mutable bool = false
                            mss_positions: mutable darray[i64] = []
                            mss_names: mutable darray[sview] = []
                            for mss_field in mss_fields |mss_declined, mss_positions, mss_names, mss_slot, structs|:
                                if mss_field is Pattern.Field(mss_selector, mss_inner):
                                    # A Wildcard field is decided BEFORE any by-name lookup —
                                    # its selector is the literal text "_", not a real field
                                    # name (see the statement emitter's identical note).
                                    if mss_inner.count == 1 and mss_inner[0] is Pattern.Wildcard:
                                        pass
                                    else:
                                        mss_position: i64 = field_index_of(structs, mss_slot.usize(), mss_selector)
                                        if mss_position < 0 or mss_inner.count != 1:
                                            mss_declined <- true
                                        elif mss_inner[0] is Pattern.Binding(mss_bind_name):
                                            mss_positions.push(mss_position)
                                            mss_names.push(mss_bind_name)
                                        else:
                                            mss_declined <- true
                                else:
                                    mss_declined <- true
                            if not mss_declined:
                                if emit_expression(match_scrutinee, scrutinee_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is mss_struct_value:
                                    mss_function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                                    mss_storage: mutable darray[u8] = []
                                    mss_slots: mutable darray[LLVMValueRef] = []
                                    for mss_n in 0..<result_types.count |mss_slots, mss_storage, result_types, var_names, structs, ctx, builder|:
                                        mss_slots.push(LLVMBuildAlloca(builder, llvm_type_of(result_types[mss_n], structs, ctx), sview_to_cstr(var_names[mss_n], mss_storage)))
                                    for mss_bind_index in 0..<mss_positions.count |mss_positions, mss_names, mss_struct_value, mss_slot, structs, local_scope, ctx, builder|:
                                        mss_field_type: ValueType = structs.field_types[structs.field_start[mss_slot.usize()] + mss_positions[mss_bind_index].usize()]
                                        mss_field_value: LLVMValueRef = LLVMBuildExtractValue(builder, mss_struct_value, mss_positions[mss_bind_index].u32(), "mss.struct.field")
                                        mss_bind_slot: LLVMValueRef = LLVMBuildAlloca(builder, llvm_type_of(mss_field_type, structs, ctx), "mss.struct.bind")
                                        _ = LLVMBuildStore(builder, mss_field_value, mss_bind_slot)
                                        declare_local(local_scope, mss_names[mss_bind_index], mss_bind_slot, mss_field_type)
                                    if mss_as_name != "":
                                        mss_whole_slot: LLVMValueRef = LLVMBuildAlloca(builder, llvm_type_of(scrutinee_type, structs, ctx), "mss.struct.whole")
                                        _ = LLVMBuildStore(builder, mss_struct_value, mss_whole_slot)
                                        declare_local(local_scope, mss_as_name, mss_whole_slot, scrutinee_type)
                                    mss_done: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, mss_function, "mss.done")
                                    EmitStatus.Declined return if not emit_arm_body_into_slot(match_arms[0].body, result_types, mss_slots, mss_done, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)
                                    LLVMPositionBuilderAtEnd(builder, mss_done)
                                    for mss_declare in 0..<result_types.count |local_scope, mss_slots, result_types, var_names|:
                                        declare_local(local_scope, var_names[mss_declare], mss_slots[mss_declare], result_types[mss_declare])
                                    return EmitStatus.Open
                                return EmitStatus.Declined

            # `x: T = match OPT: v: EXPR / _: …` — an OPTIONAL scrutinee in VALUE position.
            #
            # A BINDING arm over an optional is a CATCH-ALL: stage0 takes it even when the
            # optional is ABSENT, and the `_` arm is dead. PROBED against stage0:
            #     match pick(n): { v: 5, _: 9 }   -> 5 for an ABSENT optional
            # so there is NO present/absent split here — bind the payload unconditionally and
            # emit the binding arm's body. Mirroring the STATEMENT emitter's tag branch instead
            # is wrong; it routes the absent case to `_`, which stage0 never takes.
            #
            # The payload of an ABSENT optional is UNDEF in stage0, not a defined zero
            # (`v: v + 1` yields 0 there because undef+1 folds to undef, while `v: 5` yields 5).
            # Reading it is undefined behaviour, so it is not a parity-testable path — the
            # frontend proves the name is only read where the tag matches.
            mis_opt_type: ValueType = expression_type(match_scrutinee, local_scope, fns, structs, generics)
            if mis_opt_type.kind == TypeKind.Optional:
                mis_opt_payload: ValueType = optional_payload_of(mis_opt_type, structs)
                EmitStatus.Declined return if mis_opt_payload.kind == TypeKind.Unmodeled
                mis_opt_bind_index: mutable i64 = -1
                mis_opt_bind_name: mutable sview = ""
                for mis_opt_i in 0..<match_arms.count |mis_opt_bind_index, mis_opt_bind_name, match_arms|:
                    if match_arms[mis_opt_i].pattern is Pattern.Binding(mis_opt_pat_name):
                        if mis_opt_bind_index < 0:
                            mis_opt_bind_index <- mis_opt_i.i64()
                            mis_opt_bind_name <- mis_opt_pat_name
                EmitStatus.Declined return if mis_opt_bind_index < 0
                EmitStatus.Declined return if not (match_arms[mis_opt_bind_index.usize()].guard is Expr.Absent)
                if emit_expression(match_scrutinee, mis_opt_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is mis_opt_value:
                    mis_opt_payload_value: LLVMValueRef = optional_payload_value_of(mis_opt_value, mis_opt_type, structs, ctx, builder)
                    mis_opt_function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                    mis_opt_storage: mutable darray[u8] = []
                    mis_opt_slots: mutable darray[LLVMValueRef] = []
                    for mis_opt_n in 0..<result_types.count |mis_opt_slots, mis_opt_storage, result_types, var_names, structs, ctx, builder|:
                        mis_opt_slots.push(LLVMBuildAlloca(builder, llvm_type_of(result_types[mis_opt_n], structs, ctx), sview_to_cstr(var_names[mis_opt_n], mis_opt_storage)))
                    mis_opt_done: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, mis_opt_function, "mis.opt.done")
                    mis_opt_bind_storage: mutable darray[u8] = []
                    mis_opt_bind_slot: LLVMValueRef = LLVMBuildAlloca(builder, llvm_type_of(mis_opt_payload, structs, ctx), sview_to_cstr(mis_opt_bind_name, mis_opt_bind_storage))
                    _ = LLVMBuildStore(builder, mis_opt_payload_value, mis_opt_bind_slot)
                    declare_local(local_scope, mis_opt_bind_name, mis_opt_bind_slot, mis_opt_payload)
                    EmitStatus.Declined return if not emit_arm_body_into_slot(match_arms[mis_opt_bind_index.usize()].body, result_types, mis_opt_slots, mis_opt_done, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)
                    LLVMPositionBuilderAtEnd(builder, mis_opt_done)
                    for mis_opt_d in 0..<result_types.count |local_scope, mis_opt_slots, result_types, var_names|:
                        declare_local(local_scope, var_names[mis_opt_d], mis_opt_slots[mis_opt_d], result_types[mis_opt_d])
                    return EmitStatus.Open
                return EmitStatus.Declined
            # `x: T = match p: Point{x, y}: … _: …` — a plain STRUCT destructure arm in VALUE
            # position. Mirrors the statement-position fix in codegen_stmt_match.elisa: a struct
            # pattern has no discriminant (the scrutinee's static type already proves the match),
            # so the FIRST arm wins unconditionally and later arms (the required `_` fallback —
            # stage0 rejects a struct match with no `_` arm as "non-exhaustive") are never
            # reached. stage0's own `-emit llvm` output for this shape still EMITS the fallback's
            # dead code (an unreachable block, since -O0 runs no DCE); skipping it here instead
            # produces the same runtime answer with less code, matching how the statement-position
            # fix already treats later arms as dead rather than replicating stage0's dead blocks.
            #
            # SOUND SUBSET, matching the statement-position fix exactly: only bare-Ident (fresh
            # binding) or Wildcard (skip) fields are modeled; anything else falls through to the
            # ordinary dispatch below, which declines it.
            mvs_as_name: mutable sview = ""
            mvs_pattern: mutable Pattern = match_arms[0].pattern if match_arms.count >= 1 else Pattern.Wildcard
            if match_arms.count >= 1 and match_arms[0].pattern is Pattern.As(mvs_as_outer_name, mvs_as_inner):
                if mvs_as_inner.count == 1 and mvs_as_inner[0] is Pattern.Struct(_, _):
                    mvs_as_name <- mvs_as_outer_name
                    mvs_pattern <- mvs_as_inner[0]
            if match_arms.count >= 1 and mvs_pattern is Pattern.Struct(mvs_path, mvs_fields) and not arm_has_guard(match_arms[0].guard):
                mvs_slot: i64 = struct_index_of(structs, mvs_path)
                if mvs_slot >= 0 and scrutinee_type.kind == TypeKind.Struct and scrutinee_type.bits == mvs_slot.u32():
                    mvs_declined: mutable bool = false
                    mvs_positions: mutable darray[i64] = []
                    mvs_names: mutable darray[sview] = []
                    for mvs_field in mvs_fields |mvs_declined, mvs_positions, mvs_names, mvs_slot, structs|:
                        if mvs_field is Pattern.Field(mvs_selector, mvs_inner):
                            if mvs_inner.count == 1 and mvs_inner[0] is Pattern.Wildcard:
                                pass
                            else:
                                mvs_position: i64 = field_index_of(structs, mvs_slot.usize(), mvs_selector)
                                if mvs_position < 0 or mvs_inner.count != 1:
                                    mvs_declined <- true
                                elif mvs_inner[0] is Pattern.Binding(mvs_bind_name):
                                    mvs_positions.push(mvs_position)
                                    mvs_names.push(mvs_bind_name)
                                else:
                                    mvs_declined <- true
                        else:
                            mvs_declined <- true
                    if not mvs_declined:
                        if emit_expression(match_scrutinee, scrutinee_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is mvs_struct_value:
                            for mvs_bind_index in 0..<mvs_positions.count |mvs_positions, mvs_names, mvs_struct_value, mvs_slot, structs, local_scope, ctx, builder|:
                                mvs_field_type: ValueType = structs.field_types[structs.field_start[mvs_slot.usize()] + mvs_positions[mvs_bind_index].usize()]
                                mvs_field_value: LLVMValueRef = LLVMBuildExtractValue(builder, mvs_struct_value, mvs_positions[mvs_bind_index].u32(), "match.struct.field")
                                mvs_bind_slot: LLVMValueRef = LLVMBuildAlloca(builder, llvm_type_of(mvs_field_type, structs, ctx), "match.struct.bind")
                                _ = LLVMBuildStore(builder, mvs_field_value, mvs_bind_slot)
                                declare_local(local_scope, mvs_names[mvs_bind_index], mvs_bind_slot, mvs_field_type)
                            if mvs_as_name != "":
                                mvs_whole_slot: LLVMValueRef = LLVMBuildAlloca(builder, llvm_type_of(scrutinee_type, structs, ctx), "match.struct.whole")
                                _ = LLVMBuildStore(builder, mvs_struct_value, mvs_whole_slot)
                                declare_local(local_scope, mvs_as_name, mvs_whole_slot, scrutinee_type)
                            mvs_function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                            mvs_storage: mutable darray[u8] = []
                            mvs_slots: mutable darray[LLVMValueRef] = []
                            for mvs_slot_index in 0..<result_types.count |mvs_slots, mvs_storage, result_types, var_names, structs, ctx, builder|:
                                mvs_slots.push(LLVMBuildAlloca(builder, llvm_type_of(result_types[mvs_slot_index], structs, ctx), sview_to_cstr(var_names[mvs_slot_index], mvs_storage)))
                            mvs_done: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, mvs_function, "match.struct.done")
                            EmitStatus.Declined return if not emit_arm_body_into_slot(match_arms[0].body, result_types, mvs_slots, mvs_done, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)
                            LLVMPositionBuilderAtEnd(builder, mvs_done)
                            for mvs_d in 0..<result_types.count |local_scope, mvs_slots, result_types, var_names|:
                                declare_local(local_scope, var_names[mvs_d], mvs_slots[mvs_d], result_types[mvs_d])
                            return EmitStatus.Open
            EmitStatus.Declined return if packed_scrutinee and runtime.active_store_enum != packed_root_index_of(structs, scrutinee_type.bits.i64())
            EmitStatus.Declined return if not is_integer_type(scrutinee_type) and not penum_scrutinee and not packed_scrutinee and not cstr_scrutinee and not sview_scrutinee
            if emit_expression(match_scrutinee, scrutinee_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is scrutinee_raw:
                mis_function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                mis_scrutinee: mutable LLVMValueRef = scrutinee_raw
                mis_compare_type: mutable LLVMTypeRef = llvm_type_of(scrutinee_type, structs, ctx)
                # Hoisted out of the `if packed_scrutinee` block below: the ARM loop needs the
                # node's record and row type to bind payload fields, and a block-local would
                # not be in scope there.
                mis_record: mutable LLVMValueRef = zeroed
                mis_row_type: mutable LLVMTypeRef = zeroed
                # A payload enum's raw payload is a `[N x i64]` WORD ARRAY shared by every
                # variant, not a per-variant struct — an in-register `extractvalue` cannot
                # reinterpret those words as the variant's actual field types. Spilling the
                # whole scrutinee to a slot once (like `packed_slot`'s single record read
                # above) lets the field-bind block below GEP+load at the variant's real
                # payload type, exactly as the statement emitter does
                # (codegen_stmt_match_scalar.elisa's `sm_penum_slot`).
                mis_penum_slot: mutable LLVMValueRef = zeroed
                if packed_scrutinee:
                    mis_state: LLVMValueRef = LLVMBuildExtractValue(builder, runtime.active_store, 2, "mis.state")
                    mis_index: LLVMValueRef = LLVMBuildZExt(builder, scrutinee_raw, LLVMInt64TypeInContext(ctx), "mis.index")
                    mis_tag_args: mutable darray[LLVMValueRef] = [mis_state, mis_index]
                    mis_tag_pointer: void& = (&mis_tag_args[0]).cast[void&] can Unsafe.PointerCast
                    mis_record <- LLVMBuildCall2(builder, runtime.packed_read_word_type, runtime.packed_read_word, mis_tag_pointer, 2, "mis.record")
                    mis_row_type <- packed_row_llvm_type(structs, scrutinee_type.bits.i64(), ctx)
                    mis_tag_ptr: LLVMValueRef = LLVMBuildStructGEP2(builder, mis_row_type, mis_record, 0, "mis.tag.ptr")
                    mis_scrutinee <- LLVMBuildLoad2(builder, LLVMInt32TypeInContext(ctx), mis_tag_ptr, "mis.tag")
                    mis_compare_type <- LLVMInt32TypeInContext(ctx)
                if penum_scrutinee:
                    mis_scrutinee <- LLVMBuildExtractValue(builder, scrutinee_raw, 0, "mis.penum.tag")
                    mis_compare_type <- LLVMInt32TypeInContext(ctx)
                    mis_penum_slot <- LLVMBuildAlloca(builder, llvm_type_of(scrutinee_type, structs, ctx), "mis.penum.slot")
                    _ = LLVMBuildStore(builder, scrutinee_raw, mis_penum_slot)
                mis_slot_storage: mutable darray[u8] = []
                mis_result_slots: mutable darray[LLVMValueRef] = []
                for mis_slot_n in 0..<result_types.count |mis_result_slots, mis_slot_storage, result_types, var_names, structs, ctx, builder|:
                    mis_result_slots.push(LLVMBuildAlloca(builder, llvm_type_of(result_types[mis_slot_n], structs, ctx), sview_to_cstr(var_names[mis_slot_n], mis_slot_storage)))
                mis_done: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, mis_function, "mis.done")
                mis_declined: mutable bool = false
                mis_saw_default: mutable bool = false
                # This emitter has no OR-arm test, so every `A | B:` arm declines. That was
                # harmless while only `x: T = match …` routed here, but `return match …` does
                # too now, and a returned OR-arm match is common — so expand one into N
                # single-variant arms sharing the body. Arms are tested in order, so N
                # sequential tests are equivalent to one OR'd test, and each alternative then
                # binds through the per-variant path with its OWN field offsets (which is also
                # why differing payload layouts are safe here, unlike a shared-test lowering).
                mis_arms: mutable darray[MatchArm] = []
                for mis_src_arm in match_arms |mis_arms, structs|:
                    mis_expanded: mutable bool = false
                    if mis_src_arm.pattern is Pattern.Or(mis_pre_opts):
                        # Options may be VARIANTS (`Expr.Unary(..) | Expr.Paren(..)`) or plain
                        # LITERALS (`"u8" | "i8" | "bool"` over an sview/cstr/int scrutinee) —
                        # the per-arm paths below handle both, so both expand.
                        mis_pre_ok: mutable bool = mis_pre_opts.count > 0
                        for mis_pre_opt in mis_pre_opts |mis_pre_ok, structs|:
                            if mis_pre_opt is Pattern.Variant(mis_pre_path, mis_pre_fields):
                                mis_pre_ok <- false if packed_slot_of_path(mis_pre_path, structs) < 0
                            elif mis_pre_opt is Pattern.Literal(mis_pre_lit):
                                mis_pre_ok <- mis_pre_ok
                            else:
                                mis_pre_ok <- false
                        if mis_pre_ok:
                            mis_arms.extend([MatchArm{pattern: mis_pre_opt2, body: mis_src_arm.body, guard: mis_src_arm.guard} for mis_pre_opt2 in mis_pre_opts])
                            mis_expanded <- true
                    mis_arms.push(mis_src_arm) if not mis_expanded

                for arm in mis_arms |mis_declined, mis_saw_default, cstr_scrutinee, sview_scrutinee, packed_scrutinee, penum_scrutinee, mis_scrutinee, mis_record, mis_row_type, mis_penum_slot, scrutinee_raw, scrutinee_type, mis_compare_type, result_types, mis_result_slots, mis_done, mis_function, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder|:
                    continue if mis_declined or mis_saw_default
                    mis_arm_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, mis_function, "mis.arm")
                    # Catch-all (`_` / binder): unconditional, closes the chain.
                    if is_catch_all_pattern(arm.pattern):
                        _ = LLVMBuildBr(builder, mis_arm_block)
                        LLVMPositionBuilderAtEnd(builder, mis_arm_block)
                        if arm.pattern is Pattern.Binding(mis_bind_name):
                            mis_bind_storage: mutable darray[u8] = []
                            mis_bind_slot: LLVMValueRef = LLVMBuildAlloca(builder, llvm_type_of(scrutinee_type, structs, ctx), sview_to_cstr(mis_bind_name, mis_bind_storage))
                            _ = LLVMBuildStore(builder, scrutinee_raw, mis_bind_slot)
                            declare_local(local_scope, mis_bind_name, mis_bind_slot, scrutinee_type)
                        if emit_arm_body_into_slot(arm.body, result_types, mis_result_slots, mis_done, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder):
                            mis_saw_default <- true
                        else:
                            mis_declined <- true
                        continue
                    # Compute the arm's hit test into `mis_hit` and (for variants) bind payload.
                    mis_next: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, mis_function, "mis.next")
                    mis_hit: mutable LLVMValueRef = zeroed
                    mis_have_hit: mutable bool = false
                    # `Expr.Unary(op, operand, line) as whole:` — docs/122 §5.4 as-binding on a
                    # packed/payload-enum variant arm (`is`-condition or value-position match).
                    # The parser only ever wraps a single Variant in Pattern.As, so unwrapping it
                    # here — before the Literal/Variant classification below, which then simply
                    # never sees Pattern.As for anything else — covers it with no new dispatch
                    # shape. Binding "whole" to `scrutinee_raw`/`scrutinee_type` mirrors the
                    # catch-all binder just above, an already-proven binding shape in this same
                    # function.
                    mis_as_name: mutable sview = ""
                    mis_pattern: mutable Pattern = arm.pattern
                    if arm.pattern is Pattern.As(mis_as_outer_name, mis_as_inner):
                        if mis_as_inner.count == 1 and mis_as_inner[0] is Pattern.Variant(_, _):
                            mis_as_name <- mis_as_outer_name
                            mis_pattern <- mis_as_inner[0]
                    if mis_pattern is Pattern.Literal(mis_lit_text):
                        if cstr_scrutinee:
                            mis_cstr_storage: mutable darray[u8] = []
                            if string_pattern_content_cstr(mis_lit_text, mis_cstr_storage) is mis_cstr:
                                mis_cstr_global: LLVMValueRef = LLVMBuildGlobalStringPtr(builder, mis_cstr, "mis.strpat")
                                mis_streq_args: mutable darray[LLVMValueRef] = [mis_scrutinee, mis_cstr_global]
                                mis_streq_pointer: void& = (&mis_streq_args[0]).cast[void&] can Unsafe.PointerCast
                                mis_streq_code: LLVMValueRef = LLVMBuildCall2(builder, runtime.streq_type, runtime.streq, mis_streq_pointer, 2, "mis.streq")
                                mis_hit <- LLVMBuildICmp(builder, 33, mis_streq_code, LLVMConstInt(LLVMInt64TypeInContext(ctx), 0, 0), "mis.streq.hit")
                                mis_have_hit <- true
                            else:
                                mis_declined <- true
                        elif sview_scrutinee:
                            mis_sv_storage: mutable darray[u8] = []
                            if string_pattern_content_cstr(mis_lit_text, mis_sv_storage) is mis_sv_cstr:
                                mis_sv_global: LLVMValueRef = LLVMBuildGlobalStringPtr(builder, mis_sv_cstr, "mis.svpat")
                                mis_sv_lit_type: LLVMTypeRef = llvm_type_of(scrutinee_type, structs, ctx)
                                mis_sv_undef: LLVMValueRef = LLVMGetUndef(mis_sv_lit_type)
                                mis_sv_with_ptr: LLVMValueRef = LLVMBuildInsertValue(builder, mis_sv_undef, mis_sv_global, 0, "mis.svpat.ptr")
                                mis_sv_len: LLVMValueRef = LLVMConstInt(LLVMInt64TypeInContext(ctx), (mis_sv_storage.count - 1).u64(), 0)
                                mis_sv_lit: LLVMValueRef = LLVMBuildInsertValue(builder, mis_sv_with_ptr, mis_sv_len, 1, "mis.svpat.len")
                                mis_sv_args: mutable darray[LLVMValueRef] = [scrutinee_raw, mis_sv_lit]
                                mis_sv_pointer: void& = (&mis_sv_args[0]).cast[void&] can Unsafe.PointerCast
                                mis_sv_code: LLVMValueRef = LLVMBuildCall2(builder, runtime.sview_eq_type, runtime.sview_eq, mis_sv_pointer, 2, "mis.sview.eq")
                                mis_hit <- LLVMBuildICmp(builder, 33, mis_sv_code, LLVMConstInt(LLVMInt64TypeInContext(ctx), 0, 0), "mis.sview.hit")
                                mis_have_hit <- true
                            else:
                                mis_declined <- true
                        else:
                            mis_lit_value: mutable i64 = 0
                            if parse_pattern_scalar(mis_lit_text, mis_lit_value):
                                mis_hit <- LLVMBuildICmp(builder, 32, mis_scrutinee, LLVMConstInt(llvm_type_of(scrutinee_type, structs, ctx), mis_lit_value.u64(), 1), "mis.int.hit")
                                mis_have_hit <- true
                            else:
                                mis_declined <- true
                    elif mis_pattern is Pattern.Variant(mis_variant_path, mis_variant_fields):
                        mis_ordinal: mutable i64 = -1
                        if packed_scrutinee:
                            mis_ordinal <- packed_variant_index_of_path(mis_variant_path, structs)
                        if penum_scrutinee:
                            mis_ordinal <- penum_variant_index_of_path(mis_variant_path, structs)
                        # A const-enum variant on an integer scrutinee (`TokenKind.With`) compares
                        # against the variant's ORDINAL value, exactly like an integer literal.
                        if not packed_scrutinee and not penum_scrutinee:
                            mis_ordinal <- ordinal_of_dotted_path(mis_variant_path, structs)
                        if mis_ordinal >= 0:
                            mis_hit <- LLVMBuildICmp(builder, 32, mis_scrutinee, LLVMConstInt(mis_compare_type, mis_ordinal.u64(), 0), "mis.variant.hit")
                            mis_have_hit <- true
                        else:
                            mis_declined <- true
                    elif mis_pattern is Pattern.Range(mis_range_lo, mis_range_hi, mis_range_incl):
                        # `0..<10:` / `0..=127:` in VALUE position — the same two-sided integer
                        # bound test as the statement-position scalar match
                        # (codegen_stmt_match_scalar.elisa) and the plain value-match emitter
                        # (codegen_expr_match_aggregates.elisa). This emitter's own header
                        # comment recorded "no ranges" as a known gap between the three match
                        # emitters; integer-only, so declined for a tag-shaped scrutinee (a
                        # payload/packed enum's ordinal, or a string) exactly like the sibling
                        # emitters decline it.
                        if packed_scrutinee or penum_scrutinee or cstr_scrutinee or sview_scrutinee:
                            mis_declined <- true
                        elif emit_range_test(mis_scrutinee, scrutinee_type, mis_range_lo, mis_range_hi, mis_range_incl, mis_compare_type, ctx, builder) is mis_range_hit:
                            mis_hit <- mis_range_hit
                            mis_have_hit <- true
                        else:
                            mis_declined <- true
                    elif mis_pattern is Pattern.Pin(mis_pin_name):
                        # `^target:` in VALUE position — compare against the CURRENT value of
                        # an already-bound local rather than a constant. Mirrors
                        # codegen_stmt_match_scalar.elisa's Pin arm; declined for a tag-shaped
                        # scrutinee (no established pin semantics for an enum ordinal) or when
                        # the name isn't a local.
                        if packed_scrutinee or penum_scrutinee or cstr_scrutinee or sview_scrutinee:
                            mis_declined <- true
                        elif lookup_slot(local_scope, mis_pin_name) is mis_pin_slot:
                            mis_pin_loaded: LLVMValueRef = LLVMBuildLoad2(builder, mis_compare_type, mis_pin_slot, "mis.pin")
                            mis_hit <- LLVMBuildICmp(builder, 32, mis_scrutinee, mis_pin_loaded, "mis.pin.eq")
                            mis_have_hit <- true
                        else:
                            mis_declined <- true
                    else:
                        mis_declined <- true
                    if mis_declined:
                        LLVMPositionBuilderAtEnd(builder, mis_next)
                        continue
                    if mis_have_hit:
                        _ = LLVMBuildCondBr(builder, mis_hit, mis_arm_block, mis_next)
                        LLVMPositionBuilderAtEnd(builder, mis_arm_block)
                        # Bind the variant's PAYLOAD fields. Without this the arm's tag test was
                        # emitted but its bound names were never declared, so any arm body that
                        # referenced one failed to emit and took the whole function down —
                        # `is_module_qualifier: bool = match base:` / `Expr.Ident(n, l): f(n)` is
                        # the shape, and it is the single largest decline cluster in the semantic
                        # layer. Mirrors the statement emitter's packed binding (codegen_stmt_match).
                        if mis_as_name != "":
                            mis_whole_slot: LLVMValueRef = LLVMBuildAlloca(builder, llvm_type_of(scrutinee_type, structs, ctx), "mis.variant.whole")
                            _ = LLVMBuildStore(builder, scrutinee_raw, mis_whole_slot)
                            declare_local(local_scope, mis_as_name, mis_whole_slot, scrutinee_type)
                        if packed_scrutinee:
                            if mis_pattern is Pattern.Variant(mis_bind_path, mis_bind_fields):
                                mis_bind_slot_index: i64 = packed_slot_of_path(mis_bind_path, structs)
                                # NESTED constructor sub-patterns are handled after the plain
                                # binds below. Only the payloadless form is modeled here
                                # (`Stmt.Expr(Expr.Invalid, line)`); a nested variant that itself
                                # BINDS would need its sub-fields read too, so it still declines
                                # rather than matching without testing — a wrong answer would be
                                # strictly worse than the decline.
                                for mis_nest_field in mis_bind_fields |mis_declined, structs|:
                                    if mis_nest_field is Pattern.Variant(mis_nest_p, mis_nest_f):
                                        mis_declined <- true if mis_nest_f.count > 0 or packed_slot_of_path(mis_nest_p, structs) < 0
                                # The pattern's arity must equal the variant's field count: the
                                # binds below index packed_field_types by POSITION, so a shorter
                                # or longer pattern would read the wrong fields and bind wrong
                                # values — a silent wrong answer. The payload-enum path guards the
                                # same way (`pe_args.count != penum_field_type_count[pe_slot]`).
                                if mis_bind_slot_index >= 0 and mis_bind_fields.count > 0:
                                    mis_declined <- true if mis_bind_fields.count != structs.packed_field_type_count[mis_bind_slot_index.usize()]
                                if mis_bind_slot_index >= 0 and mis_bind_fields.count > 0 and not mis_declined:
                                    if structs.packed_has_payload[mis_bind_slot_index.usize()]:
                                        mis_bind_payload: ValueType = copied_type(structs.packed_payloads[mis_bind_slot_index.usize()])
                                        if mis_bind_payload.kind == TypeKind.Unmodeled:
                                            mis_declined <- true
                                        else:
                                            mis_pay_ptr: LLVMValueRef = LLVMBuildStructGEP2(builder, mis_row_type, mis_record, 1, "mis.payload.ptr")
                                            mis_pay_value: LLVMValueRef = LLVMBuildLoad2(builder, llvm_type_of(mis_bind_payload, structs, ctx), mis_pay_ptr, "mis.payload")
                                            mis_field_start: usize = structs.packed_field_type_start[mis_bind_slot_index.usize()]
                                            # One field: the payload IS the value, no ExtractValue.
                                            if mis_bind_fields.count == 1:
                                                if mis_bind_fields[0] is Pattern.Binding(mis_one_name):
                                                    mis_one_storage: mutable darray[u8] = []
                                                    mis_one_slot: LLVMValueRef = LLVMBuildAlloca(builder, llvm_type_of(mis_bind_payload, structs, ctx), sview_to_cstr(mis_one_name, mis_one_storage))
                                                    _ = LLVMBuildStore(builder, mis_pay_value, mis_one_slot)
                                                    declare_local(local_scope, mis_one_name, mis_one_slot, mis_bind_payload)
                                            if mis_bind_fields.count > 1:
                                                for mis_bi in 0..<mis_bind_fields.count |mis_bind_fields, mis_field_start, mis_pay_value, structs, local_scope, ctx, builder|:
                                                    if mis_bind_fields[mis_bi] is Pattern.Binding(mis_multi_name):
                                                        mis_multi_type: ValueType = copied_type(structs.packed_field_types[mis_field_start + mis_bi])
                                                        mis_multi_field: LLVMValueRef = LLVMBuildExtractValue(builder, mis_pay_value, mis_bi.u32(), "mis.field")
                                                        mis_multi_storage: mutable darray[u8] = []
                                                        mis_multi_slot: LLVMValueRef = LLVMBuildAlloca(builder, llvm_type_of(mis_multi_type, structs, ctx), sview_to_cstr(mis_multi_name, mis_multi_storage))
                                                        _ = LLVMBuildStore(builder, mis_multi_field, mis_multi_slot)
                                                        declare_local(local_scope, mis_multi_name, mis_multi_slot, mis_multi_type)
                                            # NESTED payloadless sub-patterns, after the plain
                                            # binds. Each field holding one is a packed HANDLE:
                                            # read its record, test that node's tag, and fall
                                            # through to mis_next on a mismatch, so the arm only
                                            # runs when every nested test holds. Mirrors the
                                            # statement emitter (codegen_stmt_match).
                                            for mis_ni in 0..<mis_bind_fields.count |mis_bind_fields, mis_pay_value, mis_declined, mis_function, mis_next, structs, runtime, ctx, builder|:
                                                if mis_bind_fields[mis_ni] is Pattern.Variant(mis_ni_path, mis_ni_fields):
                                                    mis_ni_slot: i64 = packed_slot_of_path(mis_ni_path, structs)
                                                    mis_ni_ord: i64 = packed_variant_index_of_path(mis_ni_path, structs)
                                                    if mis_ni_slot < 0 or mis_ni_ord < 0 or runtime.packed_mode != 2:
                                                        mis_declined <- true
                                                    else:
                                                        mis_ni_handle: LLVMValueRef = LLVMBuildExtractValue(builder, mis_pay_value, mis_ni.u32(), "mis.nest.handle")
                                                        mis_ni_state: LLVMValueRef = LLVMBuildExtractValue(builder, runtime.active_store, 2, "mis.nest.state")
                                                        mis_ni_h64: LLVMValueRef = LLVMBuildZExt(builder, mis_ni_handle, LLVMInt64TypeInContext(ctx), "mis.nest.h64")
                                                        mis_ni_args: mutable darray[LLVMValueRef] = [mis_ni_state, mis_ni_h64]
                                                        mis_ni_ptr: void& = (&mis_ni_args[0]).cast[void&] can Unsafe.PointerCast
                                                        mis_ni_record: LLVMValueRef = LLVMBuildCall2(builder, runtime.packed_read_word_type, runtime.packed_read_word, mis_ni_ptr, 2, "mis.nest.record")
                                                        mis_ni_row: LLVMTypeRef = packed_row_llvm_type(structs, mis_ni_slot, ctx)
                                                        mis_ni_tag_ptr: LLVMValueRef = LLVMBuildStructGEP2(builder, mis_ni_row, mis_ni_record, 0, "mis.nest.tag.ptr")
                                                        mis_ni_tag: LLVMValueRef = LLVMBuildLoad2(builder, LLVMInt32TypeInContext(ctx), mis_ni_tag_ptr, "mis.nest.tag")
                                                        mis_ni_hit: LLVMValueRef = LLVMBuildICmp(builder, 32, mis_ni_tag, LLVMConstInt(LLVMInt32TypeInContext(ctx), mis_ni_ord.u64(), 0), "mis.nest.cmp")
                                                        mis_ni_cont: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, mis_function, "mis.nest.cont")
                                                        _ = LLVMBuildCondBr(builder, mis_ni_hit, mis_ni_cont, mis_next)
                                                        LLVMPositionBuilderAtEnd(builder, mis_ni_cont)
                        # `Shape.Circle(r):` in VALUE position — bind the plain payload-enum's
                        # field(s). This dispatcher previously bound fields for `packed_scrutinee`
                        # only; a payload-enum arm's tag test was emitted but its names were never
                        # declared, so any arm body referencing one failed to emit and the whole
                        # value-position match declined (confirmed: the SAME fixture with the
                        # binder names unused still declines, so this is not about `as`-binding —
                        # a real, separate, pre-existing gap). Mirrors the statement emitter's
                        # penum binding (codegen_stmt_match_scalar.elisa): the raw payload is a
                        # shared `[N x i64]` word array, not a per-variant struct, so it must be
                        # read back through the pre-spilled `mis_penum_slot` at the variant's own
                        # payload type — an in-register ExtractValue cannot reinterpret it.
                        if penum_scrutinee:
                            if mis_pattern is Pattern.Variant(mis_pe_path, mis_pe_fields):
                                if mis_pe_fields.count == 1:
                                    mis_pe_payload: ValueType = penum_payload_of_path(mis_pe_path, structs)
                                    if mis_pe_payload.kind == TypeKind.Unmodeled:
                                        mis_declined <- true
                                    elif mis_pe_fields[0] is Pattern.Binding(mis_pe_one_name):
                                        mis_pe_ptr: LLVMValueRef = LLVMBuildStructGEP2(builder, llvm_type_of(scrutinee_type, structs, ctx), mis_penum_slot, 1, "mis.penum.payload.ptr")
                                        mis_pe_value: LLVMValueRef = LLVMBuildLoad2(builder, llvm_type_of(mis_pe_payload, structs, ctx), mis_pe_ptr, "mis.penum.payload")
                                        mis_pe_one_storage: mutable darray[u8] = []
                                        mis_pe_one_slot: LLVMValueRef = LLVMBuildAlloca(builder, llvm_type_of(mis_pe_payload, structs, ctx), sview_to_cstr(mis_pe_one_name, mis_pe_one_storage))
                                        _ = LLVMBuildStore(builder, mis_pe_value, mis_pe_one_slot)
                                        declare_local(local_scope, mis_pe_one_name, mis_pe_one_slot, mis_pe_payload)
                                if mis_pe_fields.count > 1:
                                    mis_pe_slot_index: i64 = penum_slot_of_path(mis_pe_path, structs)
                                    if mis_pe_slot_index < 0 or mis_pe_fields.count != structs.penum_field_type_count[mis_pe_slot_index.usize()]:
                                        mis_declined <- true
                                    else:
                                        mis_pe_tuple: LLVMTypeRef = penum_field_tuple_type(mis_pe_slot_index.usize(), structs, ctx)
                                        mis_pe_multi_ptr: LLVMValueRef = LLVMBuildStructGEP2(builder, llvm_type_of(scrutinee_type, structs, ctx), mis_penum_slot, 1, "mis.penum.payload.ptr")
                                        mis_pe_multi_value: LLVMValueRef = LLVMBuildLoad2(builder, mis_pe_tuple, mis_pe_multi_ptr, "mis.penum.payload")
                                        mis_pe_start: usize = structs.penum_field_type_start[mis_pe_slot_index.usize()]
                                        for mis_pe_i in 0..<mis_pe_fields.count |mis_pe_fields, mis_pe_start, mis_pe_multi_value, structs, local_scope, ctx, builder|:
                                            if mis_pe_fields[mis_pe_i] is Pattern.Binding(mis_pe_multi_name):
                                                mis_pe_field_type: ValueType = copied_type(structs.penum_field_types[mis_pe_start + mis_pe_i])
                                                mis_pe_field_value: LLVMValueRef = LLVMBuildExtractValue(builder, mis_pe_multi_value, mis_pe_i.u32(), "mis.penum.field")
                                                mis_pe_multi_storage: mutable darray[u8] = []
                                                mis_pe_multi_slot: LLVMValueRef = LLVMBuildAlloca(builder, llvm_type_of(mis_pe_field_type, structs, ctx), sview_to_cstr(mis_pe_multi_name, mis_pe_multi_storage))
                                                _ = LLVMBuildStore(builder, mis_pe_field_value, mis_pe_multi_slot)
                                                declare_local(local_scope, mis_pe_multi_name, mis_pe_multi_slot, mis_pe_field_type)
                        if arm_has_guard(arm.guard):
                            if emit_condition(arm.guard, local_scope, fns, structs, generics, runtime, m, ctx, builder) is mis_guard_bit:
                                mis_guard_body: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, mis_function, "mis.guard")
                                _ = LLVMBuildCondBr(builder, mis_guard_bit, mis_guard_body, mis_next)
                                LLVMPositionBuilderAtEnd(builder, mis_guard_body)
                            else:
                                mis_declined <- true
                        if not mis_declined:
                            if not emit_arm_body_into_slot(arm.body, result_types, mis_result_slots, mis_done, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder):
                                mis_declined <- true
                        LLVMPositionBuilderAtEnd(builder, mis_next)
                EmitStatus.Declined return if mis_declined
                if not mis_saw_default:
                    _ = LLVMBuildUnreachable(builder)
                LLVMPositionBuilderAtEnd(builder, mis_done)
                for mis_declare_n in 0..<result_types.count |local_scope, mis_result_slots, result_types, var_names|:
                    declare_local(local_scope, var_names[mis_declare_n], mis_result_slots[mis_declare_n], result_types[mis_declare_n])
                return EmitStatus.Open
            return EmitStatus.Declined

        # list ended the block.
        #
        # A statement AFTER a terminator is unreachable; the subset does not model dead
        # code, so it declines rather than emitting into a closed block (which LLVM would
        # reject anyway).
        def emit_statements(body: darray[Stmt]&, return_type: ValueType, local_scope: mutable Scope&, loops: mutable LoopStack&, regions: mutable RegionStack&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> EmitStatus can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                # A `defer block:` runs when the statement list that declared it ends. Owning that
                # HERE rather than at each construct is what makes it uniform: a match arm, an
                # `if` branch, a loop body, a `region` body and the function body are all just
                # statement lists, and patching them one at a time is how the rule kept being
                # missing somewhere (a match arm ran its defer AFTER the statement following the
                # match: stage0 2,1,4 and stage1 2,4,1).
                defer_mark: usize = local_scope.deferred.count
                status: mutable EmitStatus = EmitStatus.Open
                for statement in body |status, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder|:
                    # Stage0 accepts unreachable tails after a return/break/terminating nested
                    # block and emits no code for them. Preserve the already-terminated status;
                    # treating the dead tail as a backend decline incorrectly stripped otherwise
                    # valid functions such as packed-store AST helpers.
                    continue if status != EmitStatus.Open
                    status <- emit_statement(statement, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)
                    if status == EmitStatus.Declined and dbg_decline_enabled():
                        _ = dbg_decline(runtime.disjoint_function_name, statement)
                # Only while the block is still OPEN: a `return`/`raise` inside it already unwound
                # EVERYTHING on its way out, and `break`/`continue` unwind to the loop's mark —
                # both leave a terminated LLVM block that must not be appended to.
                if status == EmitStatus.Open and local_scope.deferred.count > defer_mark:
                    EmitStatus.Declined return if not emit_deferred_actions_from(local_scope, defer_mark, true, fns, structs, generics, runtime, m, ctx, builder)
                # Consumed, so a later unwind does not run it twice. The ENTRY stays: a
                # `defer function:` declared in this same list still belongs to the function, and
                # removing entries would shift the indices of the ones that do.
                for consumed_index in defer_mark..<local_scope.deferred.count |local_scope|:
                    local_scope.deferred[consumed_index].body.clear() if local_scope.deferred[consumed_index].scope_exit
                return status


            # Emit a lexical block: the statements, then drop everything they declared.
            #
            # This is the form every STATEMENT body wants (if/else arms, loop bodies, match arm
            # bodies) — the names die with the block, so a later sibling block cannot resolve one
            # of them to a slot its own path never stored (see scope_restore). A VALUE block is
            # the exception: its trailing value expression is still inside the block and must see
            # the block's names, so those sites call `emit_statements` directly and restore once
            # the value has been emitted.
        def emit_statements_scoped(body: darray[Stmt]&, return_type: ValueType, local_scope: mutable Scope&, loops: mutable LoopStack&, regions: mutable RegionStack&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> EmitStatus can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                block_mark: usize = scope_mark(local_scope)
                # SoA row binders (`view = s[row]`) are scoped like locals: one declared inside
                # a block must not outlive it, or a same-named binding in a sibling scope would
                # resolve to the wrong aggregate.
                soa_binder_mark: usize = structs.soa_row_binder_names.count
                # `defer block:` runs when the SCOPE that declared it ends — per loop ITERATION,
                # at the end of a `region` body, at the end of any nested block. Only the pool /
                # nursery path ever unwound them, so everywhere else they either ran once at
                # function exit or not at all: a `defer` in a two-iteration loop body ran ONE
                # time (stage1 2,2,1) where stage0 runs it per iteration (2,1,2,1), and a
                # `defer` in a `region` ran AFTER the statement following the region.
                status: EmitStatus = emit_statements(body, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)
                scope_restore(local_scope, block_mark)
                if structs.soa_row_binder_names.count > soa_binder_mark:
                    structs.soa_row_binder_names <- structs.soa_row_binder_names.truncate(soa_binder_mark)
                    structs.soa_row_binder_slots <- structs.soa_row_binder_slots.truncate(soa_binder_mark)
                    structs.soa_row_binder_bases <- structs.soa_row_binder_bases.truncate(soa_binder_mark)
                    structs.soa_row_binder_indexes <- structs.soa_row_binder_indexes.truncate(soa_binder_mark)
                return status


        # `panic at FILE:LINE:COL: MESSAGE`, then `backtrace:` and the symbolized frames —
        # stage0's panic report, emitted immediately before the `abort()`.
        #
        # The three moving parts and where each comes from:
        #   * FILE  — the module's source filename, stamped by the driver
        #     (stamp_module_source_path). Empty when the module was built without one, in
        #     which case the whole report is skipped rather than printing `panic at :2:5:`.
        #   * LINE  — the panic call's own line, carried by the Expr.
        #   * COL   — the `panic` KEYWORD's column, which Expr does not carry. The parser
        #     records it in a line-keyed side table (panic_line_rows/panic_column_rows),
        #     the same shape func_decl_columns already uses for constructor mangling.
        #
        # The backtrace goes to fd 2 (stderr) while the message goes to stdout, which is
        # stage0's split — `-emit test` replays the two streams separately and they must
        # land in the same ones.
        def emit_panic_report(arguments: darray[Expr]&, structs: mutable StructTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef, line: u32) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                source_length: mutable usize = 0
                source_path: cstr = LLVMGetSourceFileName(m, &source_length)
                return if source_length == 0

                i64_type: LLVMTypeRef = LLVMInt64TypeInContext(ctx)
                ptr_type: LLVMTypeRef = LLVMPointerTypeInContext(ctx, 0)
                printf_params: mutable darray[LLVMTypeRef] = [ptr_type]
                printf_params_pointer: void& = (&printf_params[0]).cast[void&] can Unsafe.PointerCast
                printf_type: LLVMTypeRef = LLVMFunctionType(i64_type, printf_params_pointer, 1, 1)
                printf_fn: LLVMValueRef = declare_or_get_named(m, "printf", printf_type)

                format_global: LLVMValueRef = LLVMBuildGlobalStringPtr(builder, "panic at %s:%d:%d: %s\n", "panic.format")
                file_global: LLVMValueRef = LLVMBuildGlobalStringPtr(builder, source_path, "panic.file")
                message_storage: mutable darray[u8] = []
                message_global: LLVMValueRef = LLVMBuildGlobalStringPtr(builder, panic_message_cstr(arguments, message_storage), "panic.message")

                report_args: mutable darray[LLVMValueRef] = [format_global, file_global, LLVMConstInt(i64_type, line.u64(), 0), LLVMConstInt(i64_type, panic_column_for_line(structs, line).u64(), 0), message_global]
                report_args_pointer: void& = (&report_args[0]).cast[void&] can Unsafe.PointerCast
                _ = LLVMBuildCall2(builder, printf_type, printf_fn, report_args_pointer, 5, "")

                # backtrace(3): 64 frames is stage0's depth.
                frame_array: LLVMTypeRef = LLVMArrayType(ptr_type, 64)
                frame_buffer: LLVMValueRef = LLVMBuildAlloca(builder, frame_array, "panic.backtrace.buffer")
                backtrace_params: mutable darray[LLVMTypeRef] = [ptr_type, i64_type]
                backtrace_params_pointer: void& = (&backtrace_params[0]).cast[void&] can Unsafe.PointerCast
                backtrace_type: LLVMTypeRef = LLVMFunctionType(i64_type, backtrace_params_pointer, 2, 0)
                backtrace_fn: LLVMValueRef = declare_or_get_named(m, "backtrace", backtrace_type)
                backtrace_args: mutable darray[LLVMValueRef] = [frame_buffer, LLVMConstInt(i64_type, 64, 0)]
                backtrace_args_pointer: void& = (&backtrace_args[0]).cast[void&] can Unsafe.PointerCast
                frame_count: LLVMValueRef = LLVMBuildCall2(builder, backtrace_type, backtrace_fn, backtrace_args_pointer, 2, "panic.backtrace.count")

                header_global: LLVMValueRef = LLVMBuildGlobalStringPtr(builder, "backtrace:\n", "panic.backtrace.header")
                header_args: mutable darray[LLVMValueRef] = [header_global]
                header_args_pointer: void& = (&header_args[0]).cast[void&] can Unsafe.PointerCast
                _ = LLVMBuildCall2(builder, printf_type, printf_fn, header_args_pointer, 1, "")

                symbols_params: mutable darray[LLVMTypeRef] = [ptr_type, i64_type, i64_type]
                symbols_params_pointer: void& = (&symbols_params[0]).cast[void&] can Unsafe.PointerCast
                symbols_type: LLVMTypeRef = LLVMFunctionType(LLVMVoidTypeInContext(ctx), symbols_params_pointer, 3, 0)
                symbols_fn: LLVMValueRef = declare_or_get_named(m, "backtrace_symbols_fd", symbols_type)
                symbols_args: mutable darray[LLVMValueRef] = [frame_buffer, frame_count, LLVMConstInt(i64_type, 2, 0)]
                symbols_args_pointer: void& = (&symbols_args[0]).cast[void&] can Unsafe.PointerCast
                _ = LLVMBuildCall2(builder, symbols_type, symbols_fn, symbols_args_pointer, 3, "")


        # The panic's message text. A bare `panic()` carries none, and stage0 falls back to
        # the literal "panic" (its @panic.default.message).
        def panic_message_cstr(arguments: darray[Expr]&, storage: mutable darray[u8]&) -> cstr can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                if arguments.count > 0:
                    if arguments[0] is Expr.StringLit(panic_text):
                        return decoded_literal_cstr(panic_text, storage)
                return "panic"


        # The recorded column of the `panic` keyword on `line`, or 0 when the line is not in
        # the table (a panic the parser synthesized rather than read from source).
        def panic_column_for_line(structs: StructTable&, line: u32) -> u32 can[Abort.Panic]:
            for index in 0..<structs.panic_line_rows.count |structs, line|:
                structs.panic_column_rows[index] return if structs.panic_line_rows[index] == line and index < structs.panic_column_rows.count
            return 0
