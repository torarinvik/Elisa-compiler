# Stage1 backend — the BLOCK-shaped expression forms: a `do`-style block value, a list
# comprehension, `get … else`, and a binary operator whose operands are themselves
# expressions. Tried after the literal forms in codegen_expr_literals.elisa and before the
# refinement forms; `handled` keeps the order the single body had.
# Part of `module Backend` (see codegen.elisa).

extend Backend:
    private:
        def emit_expression_block_forms(expression: Expr, expected: ValueType, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef, handled: mutable bool&) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            match expression:
                Expr.Block(block_statements, block_value, block_captures, block_line):
                    # `submit task(args)` is represented by the parser as an empty value block
                    # around the task call. Do not silently turn asynchronous submission into a
                    # synchronous call while the pool/task ABI lowering is incomplete.
                    if block_statements.count == 0:
                        for submit_marker in structs.fn_return_lines |structs, block_line|:
                            if submit_marker == block_line.line:
                                # `submit worker(arg)` lowers to pool_submit1(pool, worker, arg).
                                # The nursery group receives the already-emitted Task value below;
                                # re-emitting the call would enqueue the task twice.
                                null return if local_scope.pool_names.count == 0
                                match block_value:
                                    Expr.Call(submit_callee, submit_arguments, submit_argument_names, submit_line):
                                        null return if submit_arguments.count != 1
                                        # `submit` accepts both a monomorphic worker (`submit f(x)`) and
                                        # an explicitly-instantiated generic worker (`submit f[A](x)` /
                                        # `submit f[A, R](x)`). The latter is an Expr.Index/IndexN rather
                                        # than an Expr.Ident. Ordinary generic function values already
                                        # know how to instantiate themselves when emitted at a `fn`
                                        # expectation; this branch supplies pool_submit1 with the same
                                        # worker signature so it can request that function value without
                                        # guessing from the argument expression.
                                        submit_arg_type: mutable ValueType = unmodeled_type()
                                        submit_ret_type: mutable ValueType = unmodeled_type()
                                        submit_worker_name: mutable sview = ""
                                        match submit_callee:
                                            Expr.Ident(submit_worker, submit_worker_line):
                                                submit_worker_name <- submit_worker
                                                submit_arg_type <- expression_type(submit_arguments[0], local_scope, fns, structs, generics)
                                                # Integer literals are intentionally context-free in
                                                # expression_type; for submit the worker signature is the
                                                # context that supplies their concrete argument type.
                                                submit_arg_type <- param_type_of(fns, "", submit_worker, 0.usize()) if submit_arg_type.kind == TypeKind.Unmodeled
                                                submit_ret_type <- lookup_return_type(fns, "", submit_worker)
                                            Expr.Index(submit_generic_head, submit_generic_argument, submit_generic_line):
                                                match submit_generic_head:
                                                    Expr.Ident(submit_generic_name, submit_generic_name_line):
                                                        if generic_index_of(generics, submit_generic_name) >= 0:
                                                            submit_worker_name <- submit_generic_name
                                                            submit_generic_types: mutable darray[ValueType] = [annotation_value_type(submit_generic_argument, structs)]
                                                            submit_arg_type <- instantiation_param_type(submit_generic_name, submit_generic_types, 0.usize(), generics, structs)
                                                            submit_ret_type <- generic_return_type(submit_generic_name, submit_generic_types, generics, structs)
                                                    _:
                                                        pass
                                            Expr.IndexN(submit_generic_n_head, submit_generic_n_arguments, submit_generic_n_line):
                                                match submit_generic_n_head:
                                                    Expr.Ident(submit_generic_n_name, submit_generic_n_name_line):
                                                        if generic_index_of(generics, submit_generic_n_name) >= 0:
                                                            submit_worker_name <- submit_generic_n_name
                                                            submit_generic_n_types: mutable darray[ValueType] = []
                                                            submit_generic_n_types.extend([annotation_value_type(submit_generic_n_argument, structs) for submit_generic_n_argument in submit_generic_n_arguments])
                                                            submit_arg_type <- instantiation_param_type(submit_generic_n_name, submit_generic_n_types, 0.usize(), generics, structs)
                                                            submit_ret_type <- generic_return_type(submit_generic_n_name, submit_generic_n_types, generics, structs)
                                                    _:
                                                        pass
                                            _:
                                                pass
                                        null return if submit_worker_name == "" or submit_arg_type.kind == TypeKind.Unmodeled or submit_ret_type.kind == TypeKind.Unmodeled
                                        submit_pool: sview = local_scope.pool_names[local_scope.pool_names.count - 1.usize()]
                                        submit_types: mutable darray[ValueType] = [submit_arg_type, submit_ret_type]
                                        submit_call_arguments: mutable darray[Expr] = [Expr.Ident(submit_pool, submit_line), submit_callee, submit_arguments[0]]
                                        if emit_generic_call("pool_submit1", submit_types, submit_call_arguments, [], local_scope, fns, structs, generics, runtime, m, ctx, builder) is submitted_task:
                                            if local_scope.group_names.count > 0:
                                                group_name: sview = local_scope.group_names[local_scope.group_names.count - 1.usize()]
                                                if emit_task_group_add_value(group_name, submitted_task, submit_ret_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is added_task:
                                                    _ = added_task
                                                else:
                                                    return null
                                            return LLVMConstNull(LLVMInt1TypeInContext(ctx))
                                        return null
                                    _:
                                        pass
                                return null
                        await_task_type: ValueType = expression_type(block_value, local_scope, fns, structs, generics)
                        await_base: mutable sview = ""
                        await_arg_start: mutable usize = 0
                        await_arg_count: mutable usize = 0
                        await_is_task: bool = generic_struct_instantiation_of(structs, await_task_type, await_base, await_arg_start, await_arg_count) and await_base == "Task" and await_arg_count >= 1
                        if fn_return_head_at(block_line.line, structs) == "__await" or await_is_task:
                            null return if not await_is_task
                            await_result_type: ValueType = copied_type(structs.generic_struct_inst_args[await_arg_start])
                            await_types: mutable darray[ValueType] = [await_result_type]
                            await_arguments: mutable darray[Expr] = [block_value]
                            return emit_generic_call("pool_await", await_types, await_arguments, [], local_scope, fns, structs, generics, runtime, m, ctx, builder)
                    # A value block may declare its tail slot as `name = zeroed` before
                    # control flow assigns the eventual value. The initializer alone has
                    # no type, but the enclosing expression's EXPECTED type is exact. This
                    # is the natural lowering for `machine from`: every `=> value` writes
                    # the slot, and the block yields it after the state graph terminates.
                    # Infer this one declaration from the block boundary instead of making
                    # the parser invent a source-level type expression from a backend type.
                    block_statement_start: mutable usize = 0
                    if expected.kind != TypeKind.Unmodeled and block_statements.count > 0:
                        match block_value:
                            Expr.Ident(block_result_name, block_result_line):
                                match block_statements[0]:
                                    Stmt.VarDecl(block_decl_name, block_decl_type, block_decl_value, block_decl_line):
                                        same_tail_slot: bool = block_decl_name == block_result_name
                                        untyped_decl: bool = block_decl_type is Expr.Invalid
                                        zero_initializer: mutable bool = false
                                        match block_decl_value:
                                            Expr.Ident(block_zero_name, block_zero_line):
                                                zero_initializer <- block_zero_name == "zeroed"
                                            _:
                                                pass
                                        if same_tail_slot and untyped_decl and zero_initializer:
                                            block_result_storage: mutable darray[u8] = []
                                            block_result_llvm: LLVMTypeRef = llvm_type_of(expected, structs, ctx)
                                            block_result_slot: LLVMValueRef = build_entry_alloca(builder, block_result_llvm, sview_to_cstr(block_decl_name, block_result_storage))
                                            block_result_alignment: u32 = struct_alignment(expected, structs)
                                            LLVMSetAlignment(block_result_slot, block_result_alignment) if block_result_alignment != 0
                                            _ = LLVMBuildStore(builder, LLVMConstNull(block_result_llvm), block_result_slot)
                                            declare_local(local_scope, block_decl_name, block_result_slot, expected)
                                            block_statement_start <- 1
                                    _:
                                        pass
                            _:
                                pass
                    block_runtime_statements: mutable darray[Stmt] = []
                    runtime_index: mutable usize = block_statement_start
                    while runtime_index < block_statements.count |runtime_index, block_runtime_statements|:
                        block_runtime_statements.push(block_statements[runtime_index])
                        runtime_index <- runtime_index + 1
                    block_loops: mutable LoopStack = LoopStack{exits: [], continues: [], defer_marks: []}
                    block_regions: mutable RegionStack = RegionStack{arenas: []}
                    block_status: EmitStatus = emit_statements(block_runtime_statements, expected, local_scope, block_loops, block_regions, fns, structs, generics, runtime, m, ctx, builder)
                    null return if block_status != EmitStatus.Open
                    return emit_expression(block_value, expected, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                _:
                    pass
            match expression:
                Expr.Comprehension(comp_var, comp_iterable, comp_condition, comp_body, comp_line):
                    return emit_comprehension(comp_var, comp_iterable, comp_condition, comp_body, comp_line.line, expected, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                _:
                    pass
            # `get xs[i] else FALLBACK` — a BOUNDS-CHECKED index. NOT a Refinement: the
            # SUBSCRIPT postfix consumes the `else` itself (parser_expr_ops's
            # accept_subscript_else), producing `Binary(Index(xs, i), TokenKind.Else,
            # FALLBACK)`, which `get` then wraps in a GetElse with an EMPTY recovery list.
            # `grep TokenKind.Else src/backend` found nothing at all — the checked-index
            # operator was simply unimplemented in codegen.
            #
            # A GetElse whose recovery is empty carries no control flow of its own, so it is
            # value-transparent: emit the guarded expression. (A NON-empty recovery is a
            # `return`/`break` branch and keeps declining here — the statement paths own it.)
            match expression:
                Expr.GetElse(ge_guarded, ge_recovery, ge_line):
                    null return if ge_recovery.count != 0
                    return emit_expression(ge_guarded, expected, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                _:
                    pass
            # stage0 lowers the checked index exactly as this does, read from its own -emit
            # llvm: compare the index against the header's count, load the element when in
            # range, take the fallback otherwise, and merge.
            #
            # Restricted to a DARRAY receiver — the shape with a runtime count to test. A
            # fixed array's bounds are static and a view/sview carries its length
            # differently; both keep declining rather than guessing at a count field.
            match expression:
                Expr.Binary(gi_indexed, gi_operator, gi_fallback, gi_line):
                    if gi_operator == TokenKind.Else:
                        match gi_indexed:
                            Expr.Index(gi_receiver, gi_index, gi_index_line):
                                gi_container_type: ValueType = iterable_darray_type(gi_receiver, local_scope, fns, structs, generics)
                                null return if gi_container_type.kind != TypeKind.DArray
                                gi_element_type: ValueType = darray_element_of(gi_container_type, structs)
                                null return if gi_element_type.kind == TypeKind.Unmodeled
                                if darray_read_slot(gi_receiver, gi_container_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is gi_slot:
                                    gi_i64: LLVMTypeRef = LLVMInt64TypeInContext(ctx)
                                    gi_header: LLVMTypeRef = darray_llvm_type(structs, ctx)
                                    gi_element_llvm: LLVMTypeRef = llvm_type_of(gi_element_type, structs, ctx)
                                    if emit_expression(gi_index, ValueType{kind: TypeKind.Unsigned, bits: 64}, local_scope, fns, structs, generics, runtime, m, ctx, builder) is gi_index_value:
                                        gi_count_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, gi_header, gi_slot, 1, "safe.index.count.ptr")
                                        gi_count: LLVMValueRef = LLVMBuildLoad2(builder, gi_i64, gi_count_pointer, "safe.index.count")
                                        # 36 = unsigned <. The index is a usize and the count is
                                        # non-negative, so an unsigned compare also rejects a
                                        # wrapped-negative index — matching stage0's `icmp ult`.
                                        gi_in_range: LLVMValueRef = LLVMBuildICmp(builder, 36, gi_index_value, gi_count, "safe.index.in.range")
                                        gi_function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                                        gi_in_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, gi_function, "safe.index.in_range")
                                        gi_fallback_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, gi_function, "safe.index.fallback")
                                        gi_end_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, gi_function, "safe.index.end")
                                        gi_result_slot: LLVMValueRef = LLVMBuildAlloca(builder, gi_element_llvm, "safe.index.result")
                                        _ = LLVMBuildCondBr(builder, gi_in_range, gi_in_block, gi_fallback_block)
                                        LLVMPositionBuilderAtEnd(builder, gi_in_block)
                                        gi_items_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, gi_header, gi_slot, 0, "safe.index.items.ptr")
                                        gi_items: LLVMValueRef = LLVMBuildLoad2(builder, LLVMPointerTypeInContext(ctx, 0), gi_items_pointer, "safe.index.items")
                                        gi_indices: mutable darray[LLVMValueRef] = [gi_index_value]
                                        gi_indices_pointer: void& = (&gi_indices[0]).cast[void&] can Unsafe.PointerCast
                                        gi_element_pointer: LLVMValueRef = LLVMBuildGEP2(builder, gi_element_llvm, gi_items, gi_indices_pointer, 1, "safe.index.elem.ptr")
                                        _ = LLVMBuildStore(builder, LLVMBuildLoad2(builder, gi_element_llvm, gi_element_pointer, "safe.index.value"), gi_result_slot)
                                        _ = LLVMBuildBr(builder, gi_end_block)
                                        LLVMPositionBuilderAtEnd(builder, gi_fallback_block)
                                        if emit_expression(gi_fallback, gi_element_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is gi_fallback_value:
                                            _ = LLVMBuildStore(builder, gi_fallback_value, gi_result_slot)
                                            _ = LLVMBuildBr(builder, gi_end_block)
                                            LLVMPositionBuilderAtEnd(builder, gi_end_block)
                                            return LLVMBuildLoad2(builder, gi_element_llvm, gi_result_slot, "safe.index.result.load")
                                        return null
                                    return null
                                return null
                            _:
                                pass
                _:
                    pass
            # `try CALL else FALLBACK` -> Expr.Refinement(fallback, guarded). Modeled only
            # when the guarded is a call to an ERROR-returning function: call it with a fresh
            # out-slot, and if the returned i32 code is 0 use the out-value, else the
            # fallback. Also: `get OPT else FALLBACK` where OPT is optional (same AST node).
            return emit_expression_refinement_forms(expression, expected, local_scope, fns, structs, generics, runtime, m, ctx, builder, handled)
