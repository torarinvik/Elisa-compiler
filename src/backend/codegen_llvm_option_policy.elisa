# Process-global LLVM options that keep the O3 code layout identical to stage0's emitter.
# Each set is installed once per process, before the module that needs it is optimized;
# the choice follows the platform this compiler was built for, as stage0's does.
include "./llvm_c_api/transforms/elisa_llvm_codegen_options.elisa"

global mutable llvm_bounded_unroll_installed: bool
global mutable llvm_code_layout_installed: bool

extend Backend:
    private:
        # OPTION parsed as if passed on LLVM's command line.
        def parse_llvm_option(option: sview) -> void can[Abort.Panic, Memory.Allocate]:
            name_storage: mutable darray[u8] = []
            option_storage: mutable darray[u8] = []
            arguments: darray[cstr] = [sview_to_cstr("elisac", name_storage), sview_to_cstr(option, option_storage)]
            arguments_pointer: void& = (&arguments[0]).cast[void&] can Unsafe.PointerCast
            LLVMParseCommandLineOptions(2, arguments_pointer, null)

        # Whether the scheduler can be chosen here: the selective scheduler is registered
        # and no `-misched` was given explicitly.
        def selective_scheduler_available() -> bool can[Abort.Panic, Memory.Allocate]:
            storage: mutable darray[u8] = []
            ElisaLLVMOptionOccurrences(sview_to_cstr("misched", storage)) == 0 and ElisaLLVMSelectiveSchedulerRegistered() != 0

    public:
        # Apple ARM unrolls loops with a small known upper bound at most four times; Linux
        # keeps LLVM's bounded-loop policy.
        def configure_bounded_unroll() -> void can[Abort.Panic, Memory.Allocate]:
            static if ELISA_TARGET_OS_MACOS and ELISA_TARGET_ARCH_ARM64:
                can Global{Read,Write}:
                    return if llvm_bounded_unroll_installed
                    llvm_bounded_unroll_installed <- true
                parse_llvm_option("-unroll-max-upperbound=4")

        # ARM code layout: no early if-conversion, and PHI elimination may move exit-only
        # copies onto loop exit edges. Apple also places blocks by ext-TSP; Linux schedules
        # marked functions for ILP unless a scheduler was chosen explicitly.
        def configure_code_layout() -> void can[Abort.Panic, Memory.Allocate]:
            static if ELISA_TARGET_ARCH_ARM64:
                can Global{Read,Write}:
                    return if llvm_code_layout_installed
                    llvm_code_layout_installed <- true
                static if ELISA_TARGET_OS_MACOS:
                    parse_llvm_option("-enable-ext-tsp-block-placement=true")
                parse_llvm_option("-aarch64-enable-early-ifcvt=false")
                static if ELISA_TARGET_OS_LINUX:
                    parse_llvm_option("-misched=elisa-ordered-selective") if selective_scheduler_available()
                parse_llvm_option("-no-phi-elim-live-out-early-exit")
