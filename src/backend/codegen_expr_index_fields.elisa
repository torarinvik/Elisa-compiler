# Stage1 backend — `emit_expression`: indexing, struct construction and field/scope access.
# A group of the expression emitter's branches, called from codegen_expression.elisa.
# `handled` is set TRUE on entry and cleared only if no branch here matched, so a
# branch that DECLINES (returns null) still stops the dispatch — exactly as it did
# when every branch shared one function body.

extend Backend:
    private:
        def emit_expression_index_fields(expression: Expr, expected: ValueType, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef, handled: mutable bool&) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            handled <- true
            # `f: fn(A) -> R = generic_fn[A, R]` — a GENERIC FUNCTION REFERENCE used as a VALUE,
            # not called. The bracket makes it an Index/IndexN, so it fell to the indexing paths
            # below and declined; the bare-Ident form already passes its raw handle at a `fn`
            # expectation (codegen_expr_idents_binary.elisa), and this is that case with explicit
            # type arguments. Instantiating here also DECLARES the instantiation, which is what a
            # later indirect call through the local needs. pool_submit1's body opens with exactly
            # this shape (`ctx_task_from_raw[R, Pending]`).
            if expected.kind == TypeKind.Fn:
                if expression is Expr.Index(gref_head, gref_argument, gref_line):
                    if gref_head is Expr.Ident(gref_name, gref_name_line):
                        if generic_index_of(generics, gref_name) >= 0:
                            gref_args: mutable darray[ValueType] = [annotation_value_type(gref_argument, structs)]
                            return instantiate_generic(gref_name, gref_args, generics, structs, m, ctx)
                if expression is Expr.IndexN(grefn_head, grefn_arguments, grefn_line):
                    if grefn_head is Expr.Ident(grefn_name, grefn_name_line):
                        if generic_index_of(generics, grefn_name) >= 0:
                            # An UNRESOLVED type argument is kept, not rejected: it may name a
                            # PHANTOM type-state, and `Pending` in `ctx_task_from_raw[R, Pending]`
                            # is declared nowhere at all. instantiate_generic_at still declines if
                            # a PARAMETER's type comes out Unmodeled, so a genuinely bad argument
                            # fails one step later — the same trade instantiate_generic_struct
                            # makes for `MutexGuard[Held]`.
                            grefn_args: mutable darray[ValueType] = []
                            grefn_args.extend([annotation_value_type(grefn_argument, structs) for grefn_argument in grefn_arguments])
                            return instantiate_generic(grefn_name, grefn_args, generics, structs, m, ctx)
            # `{}` may also parse as an empty set literal; same zero-aggregate handling.
            if expression is Expr.SetLit(set_elements, set_literal_line):
                null return if expected.kind != TypeKind.Struct
                set_lit_llvm: LLVMTypeRef = llvm_type_of(expected, structs, ctx)
                # An empty set `{}` is a zeroed DynSet (null items, 0 counts) — no allocation.
                if set_elements.count == 0:
                    return LLVMConstNull(set_lit_llvm)
                # `{a, b, …}` — a zeroed DynSet in a slot, then `arena_set_add_or_panic(arena,
                # &set, elem)` per element (the std's frictionless, panic-on-OOM insert; the
                # error-returning `arena_set_add` is avoided so no error out-param is needed).
                # Needs the std + the DynSet element type from `expected`'s instantiation args.
                set_lit_base: mutable sview = ""
                set_lit_arg_start: mutable usize = 0
                set_lit_arg_count: mutable usize = 0
                set_lit_has_inst: bool = generic_struct_instantiation_of(structs, expected, set_lit_base, set_lit_arg_start, set_lit_arg_count)
                null return if not set_lit_has_inst or set_lit_base != "DynSet" or set_lit_arg_count != 1
                set_lit_elem_type: ValueType = copied_type(structs.generic_struct_inst_args[set_lit_arg_start])
                set_lit_type_args: mutable darray[ValueType] = [set_lit_elem_type]
                if instantiate_generic("arena_set_add_or_panic", set_lit_type_args, generics, structs, m, ctx) is set_add_target:
                    set_lit_slot: LLVMValueRef = LLVMBuildAlloca(builder, set_lit_llvm, "set.literal")
                    _ = LLVMBuildStore(builder, LLVMConstNull(set_lit_llvm), set_lit_slot)
                    set_add_fn_type: LLVMTypeRef = LLVMGlobalGetValueType(set_add_target)
                    set_lit_declined: mutable bool = false
                    for set_element in set_elements |set_lit_declined, set_lit_elem_type, set_lit_slot, set_add_target, set_add_fn_type, local_scope, fns, structs, generics, runtime, m, ctx, builder|:
                        continue if set_lit_declined
                        if emit_expression(set_element, set_lit_elem_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is set_element_value:
                            set_add_args: mutable darray[LLVMValueRef] = [runtime.arena, set_lit_slot, set_element_value]
                            # The TRAILING region argument, if THIS instantiation carries one.
                            # The leading arena above is the helper's own declared `a: Arena&`;
                            # the trailing one is stage1's region threading, and it is decided
                            # per instantiation. Hardcoding 3 arguments emitted a call whose
                            # arity disagreed with the callee's own definition — malformed IR
                            # that -O0 carried through to the object and that made the -O1
                            # pass pipeline die with SIGBUS. The same set built by `.add`
                            # (which goes through emit_dict_method_call) passed 4, so a program
                            # with BOTH spellings held two contradictory calls to one symbol.
                            set_add_args.push(runtime.arena) if instantiation_wants_arena("arena_set_add_or_panic", set_lit_type_args, generics, structs)
                            set_add_args_pointer: void& = (&set_add_args[0]).cast[void&] can Unsafe.PointerCast
                            _ = LLVMBuildCall2(builder, set_add_fn_type, set_add_target, set_add_args_pointer, set_add_args.count.u32(), "set.add")
                        else:
                            set_lit_declined <- true
                    null return if set_lit_declined
                    return LLVMBuildLoad2(builder, set_lit_llvm, set_lit_slot, "set.literal.value")
                return null
            if expression is Expr.Array(array_elements, array_literal_line):
                # Darray literals use the same allocation/growth path as `.push(...)`.
                if expected.kind == TypeKind.DArray:
                    if array_elements.count == 0:
                        return LLVMConstNull(darray_llvm_type(structs, ctx))
                    element_type: ValueType = darray_element_of(expected, structs)
                    null return if element_type.kind == TypeKind.Unmodeled
                    header: LLVMTypeRef = darray_llvm_type(structs, ctx)
                    temporary: LLVMValueRef = LLVMBuildAlloca(builder, header, "darray.literal")
                    _ = LLVMBuildStore(builder, LLVMConstNull(header), temporary)
                    declined: mutable bool = false
                    for element_expression in array_elements |declined, temporary, expected, element_type, local_scope, fns, structs, generics, runtime, m, ctx, builder|:
                        # `[first, ...rest]` — a SPREAD element appends every item of another
                        # darray. The `...` arrives as a unary Ellipsis, which the element loop
                        # pushed as if it were one value, so the whole literal declined.
                        #
                        # Lowered as a copy LOOP that reuses emit_darray_push per item: bind the
                        # source and an index to hidden locals, then push `src[i]`. Growth,
                        # element conversion and the header update are then exactly the same code
                        # the ordinary elements take.
                        if element_expression is Expr.Unary(spread_operator, spread_operand, spread_line):
                            if spread_operator == TokenKind.Ellipsis:
                                spread_type: ValueType = expression_type(spread_operand, local_scope, fns, structs, generics)
                                if spread_type.kind != TypeKind.DArray:
                                    declined <- true
                                elif emit_expression(spread_operand, spread_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is spread_value:
                                    spread_header: LLVMTypeRef = darray_llvm_type(structs, ctx)
                                    spread_i64: LLVMTypeRef = LLVMInt64TypeInContext(ctx)
                                    spread_source: LLVMValueRef = LLVMBuildAlloca(builder, spread_header, "spread.src")
                                    _ = LLVMBuildStore(builder, spread_value, spread_source)
                                    declare_local(local_scope, "__spread_src", spread_source, spread_type)
                                    spread_index: LLVMValueRef = LLVMBuildAlloca(builder, spread_i64, "spread.i")
                                    _ = LLVMBuildStore(builder, LLVMConstInt(spread_i64, 0, 0), spread_index)
                                    declare_local(local_scope, "__spread_i", spread_index, ValueType{kind: TypeKind.Signed, bits: 64})
                                    spread_function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                                    spread_cond: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, spread_function, "spread.cond")
                                    spread_body: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, spread_function, "spread.body")
                                    spread_done: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, spread_function, "spread.done")
                                    _ = LLVMBuildBr(builder, spread_cond)
                                    LLVMPositionBuilderAtEnd(builder, spread_cond)
                                    spread_count_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, spread_header, spread_source, 1, "spread.count.ptr")
                                    spread_count: LLVMValueRef = LLVMBuildLoad2(builder, spread_i64, spread_count_pointer, "spread.count")
                                    spread_at: LLVMValueRef = LLVMBuildLoad2(builder, spread_i64, spread_index, "spread.at")
                                    # 40 = SLT.
                                    _ = LLVMBuildCondBr(builder, LLVMBuildICmp(builder, 40, spread_at, spread_count, "spread.more"), spread_body, spread_done)
                                    LLVMPositionBuilderAtEnd(builder, spread_body)
                                    spread_item: Expr = Expr.Index(Expr.Ident("__spread_src", spread_line), Expr.Ident("__spread_i", spread_line), spread_line)
                                    declined <- true if not emit_darray_push(temporary, expected, spread_item, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                                    spread_next: LLVMValueRef = LLVMBuildLoad2(builder, spread_i64, spread_index, "spread.at.next")
                                    _ = LLVMBuildStore(builder, LLVMBuildAdd(builder, spread_next, LLVMConstInt(spread_i64, 1, 0), "spread.inc"), spread_index)
                                    _ = LLVMBuildBr(builder, spread_cond)
                                    LLVMPositionBuilderAtEnd(builder, spread_done)
                                else:
                                    declined <- true
                                continue
                        if emit_darray_push(temporary, expected, element_expression, local_scope, fns, structs, generics, runtime, m, ctx, builder):
                            declined <- declined
                        else:
                            declined <- true
                    null return if declined
                    return LLVMBuildLoad2(builder, header, temporary, "darray.literal.value")
                null return if expected.kind != TypeKind.Array
                slot_index: usize = expected.bits.usize()
                null return if array_elements.count > structs.array_extents[slot_index].usize()
                element_type: ValueType = structs.array_elements[slot_index]
                array_llvm: LLVMTypeRef = llvm_type_of(expected, structs, ctx)
                temporary: LLVMValueRef = LLVMBuildAlloca(builder, array_llvm, "array")
                _ = LLVMBuildStore(builder, LLVMConstNull(array_llvm), temporary)
                declined: mutable bool = false
                position: mutable u32 = 0
                for element_expression in array_elements |declined, position, element_type, array_llvm, temporary, local_scope, fns, structs, generics, runtime, m, ctx, builder|:
                    indices: mutable darray[LLVMValueRef] = [LLVMConstInt(LLVMInt64TypeInContext(ctx), 0, 0), LLVMConstInt(LLVMInt64TypeInContext(ctx), position.u64(), 0)]
                    indices_pointer: void& = (&indices[0]).cast[void&] can Unsafe.PointerCast
                    pointer: LLVMValueRef = LLVMBuildGEP2(builder, array_llvm, temporary, indices_pointer, 2, "init.ptr")
                    if emit_expression(element_expression, element_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is element_value:
                        _ = LLVMBuildStore(builder, element_value, pointer)
                    else:
                        declined <- true
                    position <- position + 1
                null return if declined
                return LLVMBuildLoad2(builder, array_llvm, temporary, "arrayval")

            # Named-tuple VALUE `(a, b, …)` — construct positionally into the EXPECTED tuple
            # struct (a synthesized anonymous struct; register_tuple_types resolved its type).
            if expression is Expr.Tuple(tuple_value_elements, tuple_value_line):
                null return if expected.kind != TypeKind.Struct
                tuple_value_slot: usize = expected.bits.usize()
                null return if structs.field_count[tuple_value_slot] != tuple_value_elements.count
                tuple_value_llvm: LLVMTypeRef = llvm_type_of(expected, structs, ctx)
                tuple_value_temporary: LLVMValueRef = LLVMBuildAlloca(builder, tuple_value_llvm, "tuple")
                tuple_value_field_start: usize = structs.field_start[tuple_value_slot]
                tuple_value_declined: mutable bool = false
                tuple_value_position: mutable u32 = 0
                for tuple_value_element in tuple_value_elements |tuple_value_declined, tuple_value_position, tuple_value_field_start, tuple_value_llvm, tuple_value_temporary, local_scope, fns, structs, generics, runtime, m, ctx, builder|:
                    tuple_value_field_type: ValueType = copied_type(structs.field_types[tuple_value_field_start + tuple_value_position.usize()])
                    tuple_value_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, tuple_value_llvm, tuple_value_temporary, tuple_value_position, "tuple.field.ptr")
                    if emit_expression(tuple_value_element, tuple_value_field_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is tuple_value_field:
                        _ = LLVMBuildStore(builder, tuple_value_field, tuple_value_pointer)
                    else:
                        tuple_value_declined <- true
                    tuple_value_position <- tuple_value_position + 1
                null return if tuple_value_declined
                return LLVMBuildLoad2(builder, tuple_value_llvm, tuple_value_temporary, "tupleval")

            # `x.cast[T]` — a REINTERPRET cast (parsed as Index(Field(x,"cast"), T), no call).
            # Only pointer<->pointer is modeled (a ref/cstr/void& is a `ptr`, and opaque
            # pointers make it a no-op) — that is all the std alloc helpers need
            # (`ptr.cast[mutable T&]`). A non-pointer reinterpret declines.
            if expression is Expr.Index(cast_index_head, cast_index_type, cast_index_line):
                if cast_index_head is Expr.Field(cast_source, cast_method, cast_method_line):
                    if cast_method == "cast":
                        cast_target: ValueType = annotation_value_type(cast_index_type, structs)
                        null return if cast_target.kind == TypeKind.Unmodeled
                        # `ptr.cast[uintptr]` — a POINTER→INTEGER reinterpret (the inverse of the
                        # `int.cast[T&]` case below). A `uintptr`/`usize` stash of a raw address, as
                        # in Slice[T]'s `(&da[0]).cast[uintptr]`; this is a `ptrtoint` to the target
                        # integer width. Handled first so integer targets do not fall to the
                        # pointer-only decline just below.
                        if is_integer_type(cast_target):
                            cast_int_source_type: mutable ValueType = expression_type(cast_source, local_scope, fns, structs, generics)
                            # A bare FUNCTION NAME as the source: `inc.cast[uintptr]`, taking a
                            # top-level function's address as an integer. expression_type answers
                            # Unmodeled for a function name used as a VALUE (it types locals, not
                            # the FnTable), so the Fn branch below never fired -- while the same
                            # cast through a fn-typed LOCAL worked. Only a name with no local
                            # binding is reinterpreted, so a local always shadows.
                            if cast_int_source_type.kind == TypeKind.Unmodeled:
                                if cast_source is Expr.Ident(cast_fn_name, cast_fn_name_line):
                                    cast_int_source_type <- ValueType{kind: TypeKind.Fn, bits: 0} if function_index_of(fns, "", cast_fn_name) >= 0
                            # An OPTIONAL pointer source: `entry.ptr.cast[uintptr]`, how the
                            # string-length cache compares an entry against the key. The
                            # ADDRESS is the payload pointer — stage0 holds an optional
                            # pointer as a BARE pointer, so its ptrtoint reads exactly the
                            # value stage1 gets out of payload field 1, and an absent
                            # optional is a null payload, which converts to 0 on both sides.
                            cast_int_optional: bool = cast_int_source_type.kind == TypeKind.Optional and type_is_pointer(optional_payload_of(cast_int_source_type, structs))
                            # An INTEGER source is a width-preserving reinterpret, not a
                            # ptrtoint: `raw.cast[MyId]` where `type MyId = id[T]` erases to
                            # u32. Only a POINTER source was accepted, so every cast INTO a
                            # handle type declined.
                            if is_integer_type(cast_int_source_type):
                                if emit_expression(cast_source, cast_int_source_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is cast_int_value:
                                    return emit_conversion(cast_int_value, cast_int_source_type, cast_target, structs, ctx, builder)
                                return null
                            # A FN source: `fn.cast[uintptr]`, how a callback's address is stashed
                            # in a work record (ConcurrencyWorkStart1.fn_bits). A fn value is a
                            # pointer at the LLVM level, so this is the same ptrtoint. Allowed
                            # HERE rather than by widening type_is_pointer, for the same reason
                            # the `p.cast[fn(A) -> R]` direction below is: that predicate also
                            # decides the optional NICHE layout.
                            cast_int_fn: bool = cast_int_source_type.kind == TypeKind.Fn
                            null return if not type_is_pointer(cast_int_source_type) and not cast_int_optional and not cast_int_fn
                            if emit_expression(cast_source, cast_int_source_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is cast_ptr_value:
                                cast_ptr_raw: LLVMValueRef = optional_payload_value_of(cast_ptr_value, cast_int_source_type, structs, ctx, builder) if cast_int_optional else cast_ptr_value
                                return LLVMBuildPtrToInt(builder, cast_ptr_raw, llvm_type_of(cast_target, structs, ctx), "ptrtoint")
                            return null
                        # `raw.cast[GuestVAddr[L]]` / `HostPtr[T]` — address-space carriers are
                        # i64 storage; a cast from uintptr is a pure integer bit-cast (identity
                        # at the LLVM level), matching stage0's GuestVAddr local-carrier lowering.
                        if cast_target.kind == TypeKind.GuestCarrier:
                            cast_guest_source_type: ValueType = expression_type(cast_source, local_scope, fns, structs, generics)
                            null return if not is_integer_type(cast_guest_source_type) and cast_guest_source_type.kind != TypeKind.GuestCarrier
                            if emit_expression(cast_source, cast_guest_source_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is cast_guest_value:
                                return cast_guest_value
                            return null
                        # `ptr.cast[T&?]` — an OPTIONAL-of-pointer target. Produce the bare
                        # pointer, then wrap: wrap_optional already derives a heap ref's tag
                        # from a null test, so a null source stays ABSENT rather than being
                        # handed back as a present-but-null reference.
                        cast_wraps_optional: bool = cast_target.kind == TypeKind.Optional and type_is_pointer(optional_payload_of(cast_target, structs))
                        # `p.cast[fn(A) -> R]` — reinterpreting a raw pointer as a FUNCTION value,
                        # how a C callback is called back through. A fn value is a tagged pointer
                        # whose low bit distinguishes a closure from a raw function pointer, and a
                        # real function's address is aligned, so the bit is already 0 and the value
                        # takes emit_fn_value_call's RAW path — a direct `call R %ptr(args)`, which
                        # is exactly what stage0 emits. Allowed HERE rather than by widening
                        # type_is_pointer: that predicate also decides the optional NICHE layout,
                        # so changing it would silently move an ABI other code already agrees on.
                        cast_targets_fn: bool = cast_target.kind == TypeKind.Fn
                        null return if not type_is_pointer(cast_target) and not cast_wraps_optional and not cast_targets_fn
                        cast_source_type: ValueType = expression_type(cast_source, local_scope, fns, structs, generics)
                        # `worker.cast[void&]` — the SOURCE names a FUNCTION, so the cast takes
                        # its ADDRESS. The thread/signal entry points hand a C callback across
                        # (`ctx_thread_create(…, ctx_pool_worker_main.cast[void&], …)`,
                        # `elisa_trace_fault_handler.cast[void&?]`), and a function name is not a
                        # value in scope, so `expression_type` returns Unmodeled and the whole
                        # statement declined. An LLVM function IS a pointer — hand back the
                        # handle itself. Checked only when the name resolves to no local, so a
                        # variable shadowing a function name keeps the value path.
                        if cast_source is Expr.Ident(cast_fn_name, cast_fn_name_line):
                            if cast_source_type.kind == TypeKind.Unmodeled:
                                cast_fn_index: i64 = function_index_of(fns, "", cast_fn_name)
                                if cast_fn_index >= 0:
                                    cast_fn_handle: LLVMValueRef = fns.handles[cast_fn_index.usize()]
                                    return wrap_optional_tagged(cast_fn_handle, cast_target, false, structs, ctx, builder) if cast_wraps_optional else cast_fn_handle
                        # The same, for a GENERIC function reference source:
                        # `ctx_concurrency_work1_entry[A, R].cast[void&]`, how pool_submit_raw is
                        # handed a monomorphized C entry point. The bracket makes it an
                        # Index/IndexN, so the Ident path above cannot see it; instantiating here
                        # both resolves the handle and DECLARES the instantiation the callback
                        # will reach at runtime. Unresolved type arguments are kept for the same
                        # phantom-type-state reason as the fn-value reference path.
                        if cast_source is Expr.IndexN(cast_gn_head, cast_gn_args, cast_gn_line):
                            if cast_gn_head is Expr.Ident(cast_gn_name, cast_gn_name_line):
                                if generic_index_of(generics, cast_gn_name) >= 0:
                                    cast_gn_types: mutable darray[ValueType] = []
                                    cast_gn_types.extend([annotation_value_type(cast_gn_argument, structs) for cast_gn_argument in cast_gn_args])
                                    if instantiate_generic(cast_gn_name, cast_gn_types, generics, structs, m, ctx) is cast_gn_handle:
                                        return wrap_optional_tagged(cast_gn_handle, cast_target, false, structs, ctx, builder) if cast_wraps_optional else cast_gn_handle
                                    return null
                        if cast_source is Expr.Index(cast_g1_head, cast_g1_argument, cast_g1_line):
                            if cast_g1_head is Expr.Ident(cast_g1_name, cast_g1_name_line):
                                if generic_index_of(generics, cast_g1_name) >= 0:
                                    cast_g1_types: mutable darray[ValueType] = [annotation_value_type(cast_g1_argument, structs)]
                                    if instantiate_generic(cast_g1_name, cast_g1_types, generics, structs, m, ctx) is cast_g1_handle:
                                        return wrap_optional_tagged(cast_g1_handle, cast_target, false, structs, ctx, builder) if cast_wraps_optional else cast_g1_handle
                                    return null
                        # An INTEGER source (`raw: uintptr` -> `mutable heap Region&`) is a
                        # real reinterpret and needs an `inttoptr`; pointer<->pointer is free
                        # under opaque pointers. Anything else is not a reinterpret at all.
                        cast_source_is_int: bool = is_integer_type(cast_source_type)
                        # An OPTIONAL-of-pointer source a guard has already proven non-null
                        # (`raw: void&?` / `assert raw != null` / `raw.cast[void&]`, and the std
                        # fixed-buffer family's `a.data.cast[u8&]`) unwraps to its payload.
                        #
                        # Gated on the NARROWING PROOF: stage0 rejects this cast outright until a
                        # guard has narrowed the operand, so unwrapping without the proof would
                        # compile a program stage0 refuses.
                        #
                        # A struct FIELD source was excluded here for several rounds on a
                        # measurement of "wrong answer, 10 vs 20 against stage0". That
                        # measurement was FALSE: the fixture ran through `.cast[u8&].uintptr()`,
                        # and `.uintptr()` on a ref was itself returning the pointee instead of
                        # the address. With that fixed the field shape measures 10 == 10. A
                        # poisoned oracle reads exactly like a broken fix — re-measure any
                        # "known bad" result after fixing anything its fixture depends on.
                        cast_source_optional_pointer: bool = cast_source_type.kind == TypeKind.Optional and type_is_pointer(optional_payload_of(cast_source_type, structs))
                        cast_source_unwraps: bool = cast_source_optional_pointer and path_is_narrowed(cast_source, structs)
                        # `group.handle.cast[heap Node&?]` — an OPTIONAL pointer reinterpreted as
                        # a DIFFERENT optional pointer. This needs NO narrowing proof, unlike the
                        # unwrapping case above: nullability is preserved rather than discarded,
                        # so absent stays absent and no unchecked reference is manufactured.
                        # Both sides are niche-optimized to a bare pointer, so the reinterpret is
                        # an identity — take the value through untouched rather than re-tagging it
                        # (re-wrapping a NON-heap payload would pin a `true` tag and lose absence).
                        cast_optional_to_optional: bool = cast_source_optional_pointer and cast_wraps_optional and optional_is_niche(cast_target, structs) and optional_is_niche(cast_source_type, structs)
                        if cast_optional_to_optional:
                            if emit_expression(cast_source, cast_source_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is cast_optional_value:
                                return cast_optional_value
                            return null
                        # A FLOAT source (`v.cast[heap u8&]`) reinterprets like the integer
                        # case but needs the integer step spelled out -- there is no direct
                        # opcode and `inttoptr double` is invalid IR. stage0 emits `fptoui`
                        # then `inttoptr` (read from its -emit llvm); without this a float
                        # source failed the reinterpret gate below and declined.
                        cast_source_is_float: bool = cast_source_type.kind == TypeKind.Float
                        null return if not type_is_pointer(cast_source_type) and not cast_source_is_int and not cast_source_is_float and not cast_source_unwraps
                        if emit_expression(cast_source, cast_source_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is cast_source_value:
                            cast_pointer: mutable LLVMValueRef = cast_source_value
                            if cast_source_is_int:
                                cast_pointer <- LLVMBuildIntToPtr(builder, cast_source_value, LLVMPointerTypeInContext(ctx, 0), "inttoptr")
                            if cast_source_is_float:
                                cast_pointer <- LLVMBuildIntToPtr(builder, LLVMBuildFPToUI(builder, cast_source_value, LLVMInt64TypeInContext(ctx), "fptoui"), LLVMPointerTypeInContext(ctx, 0), "inttoptr")
                            if cast_source_unwraps:
                                cast_pointer <- optional_payload_value_of(cast_source_value, cast_source_type, structs, ctx, builder)
                            # The SOURCE decides nullability, not the target annotation: an
                            # integer or a raw heap pointer may be null, so the tag is a null
                            # test. A safe `T&` source is never null and keeps the constant.
                            cast_may_be_null: bool = cast_source_is_int or cast_source_is_float or (cast_source_type.kind == TypeKind.Ref and ref_is_heap_ref(cast_source_type, structs))
                            return wrap_optional_tagged(cast_pointer, cast_target, cast_may_be_null, structs, ctx, builder) if cast_wraps_optional else cast_pointer
                        return null
            # `base[lo:hi]` — AST Slice (lexer `source[start:end]`). Byte pointer → sview.
            if expression is Expr.Slice(slice_object, slice_start_expr, slice_end_expr, slice_line):
                # A container slice assigned to `view[T]` is a fat view over the darray's
                # element storage, not a byte `sview`. The old CStr path attempted a GEP of
                # i8 directly on the darray header, producing invalid LLVM (`getelementptr`
                # on `{ptr,i64,i64}`) before clone(view) even ran.
                if expected.kind == TypeKind.View:
                    slice_source_type: ValueType = expression_type(slice_object, local_scope, fns, structs, generics)
                    if slice_source_type.kind == TypeKind.DArray:
                        if emit_expression(slice_object, slice_source_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is slice_source_value:
                            if emit_expression(slice_start_expr, ValueType{kind: TypeKind.Signed, bits: 64}, local_scope, fns, structs, generics, runtime, m, ctx, builder) is view_slice_start:
                                if emit_expression(slice_end_expr, ValueType{kind: TypeKind.Signed, bits: 64}, local_scope, fns, structs, generics, runtime, m, ctx, builder) is view_slice_end:
                                    source_items: LLVMValueRef = LLVMBuildExtractValue(builder, slice_source_value, 0, "view.slice.items")
                                    source_element: ValueType = darray_element_of(slice_source_type, structs)
                                    element_llvm: LLVMTypeRef = llvm_type_of(source_element, structs, ctx)
                                    view_indices: mutable darray[LLVMValueRef] = [view_slice_start]
                                    view_indices_pointer: void& = (&view_indices[0]).cast[void&] can Unsafe.PointerCast
                                    view_data: LLVMValueRef = LLVMBuildGEP2(builder, element_llvm, source_items, view_indices_pointer, 1, "view.slice.data")
                                    view_len: LLVMValueRef = LLVMBuildSub(builder, view_slice_end, view_slice_start, "view.slice.len")
                                    view_llvm: LLVMTypeRef = llvm_type_of(expected, structs, ctx)
                                    view_result: mutable LLVMValueRef = LLVMGetUndef(view_llvm)
                                    view_result <- LLVMBuildInsertValue(builder, view_result, view_data, 0, "view.slice.ins0")
                                    view_result <- LLVMBuildInsertValue(builder, view_result, view_len, 1, "view.slice.ins1")
                                    return view_result
                    # A FIXED ARRAY source (`text[1:3]` on a `u8[4]`). Unlike a darray there is
                    # no items pointer to extract: the array IS the storage, so the view points
                    # into the array's own slot. That is stage0's lowering too -- it GEPs the
                    # parameter's alloca -- so the resulting view has exactly the same lifetime
                    # as stage0 gives it.
                    # A REF to a fixed array (`values: i32[4]&`) is the same slice, but the
                    # value in hand is ALREADY the array's address, so no temp is needed.
                    slice_ref_array: ValueType = ref_target_of(slice_source_type, structs) if slice_source_type.kind == TypeKind.Ref else unmodeled_type()
                    if slice_ref_array.kind == TypeKind.Array:
                        if emit_expression(slice_object, slice_source_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is ref_slice_base:
                            if emit_expression(slice_start_expr, ValueType{kind: TypeKind.Signed, bits: 64}, local_scope, fns, structs, generics, runtime, m, ctx, builder) is ref_slice_start:
                                if emit_expression(slice_end_expr, ValueType{kind: TypeKind.Signed, bits: 64}, local_scope, fns, structs, generics, runtime, m, ctx, builder) is ref_slice_end:
                                    ref_slice_llvm: LLVMTypeRef = llvm_type_of(slice_ref_array, structs, ctx)
                                    ref_slice_indices: mutable darray[LLVMValueRef] = [LLVMConstInt(LLVMInt64TypeInContext(ctx), 0, 0), ref_slice_start]
                                    ref_slice_indices_pointer: void& = (&ref_slice_indices[0]).cast[void&] can Unsafe.PointerCast
                                    ref_slice_data: LLVMValueRef = LLVMBuildGEP2(builder, ref_slice_llvm, ref_slice_base, ref_slice_indices_pointer, 2, "arrayslice.ref.data")
                                    ref_slice_len: LLVMValueRef = LLVMBuildSub(builder, ref_slice_end, ref_slice_start, "arrayslice.ref.len")
                                    ref_slice_view_llvm: LLVMTypeRef = llvm_type_of(expected, structs, ctx)
                                    ref_slice_result: mutable LLVMValueRef = LLVMGetUndef(ref_slice_view_llvm)
                                    ref_slice_result <- LLVMBuildInsertValue(builder, ref_slice_result, ref_slice_data, 0, "arrayslice.ref.ins0")
                                    ref_slice_result <- LLVMBuildInsertValue(builder, ref_slice_result, ref_slice_len, 1, "arrayslice.ref.ins1")
                                    return ref_slice_result
                        return null
                    if slice_source_type.kind == TypeKind.Array:
                        if emit_expression(slice_object, slice_source_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is array_slice_value:
                            if emit_expression(slice_start_expr, ValueType{kind: TypeKind.Signed, bits: 64}, local_scope, fns, structs, generics, runtime, m, ctx, builder) is array_slice_start:
                                if emit_expression(slice_end_expr, ValueType{kind: TypeKind.Signed, bits: 64}, local_scope, fns, structs, generics, runtime, m, ctx, builder) is array_slice_end:
                                    array_slice_llvm: LLVMTypeRef = llvm_type_of(slice_source_type, structs, ctx)
                                    array_slice_slot: LLVMValueRef = LLVMBuildAlloca(builder, array_slice_llvm, "arrayslice.storage")
                                    _ = LLVMBuildStore(builder, array_slice_value, array_slice_slot)
                                    array_slice_element: ValueType = array_element_of(slice_source_type, structs)
                                    array_slice_element_llvm: LLVMTypeRef = llvm_type_of(array_slice_element, structs, ctx)
                                    array_slice_indices: mutable darray[LLVMValueRef] = [LLVMConstInt(LLVMInt64TypeInContext(ctx), 0, 0), array_slice_start]
                                    array_slice_indices_pointer: void& = (&array_slice_indices[0]).cast[void&] can Unsafe.PointerCast
                                    array_slice_data: LLVMValueRef = LLVMBuildGEP2(builder, array_slice_llvm, array_slice_slot, array_slice_indices_pointer, 2, "arrayslice.data")
                                    array_slice_len: LLVMValueRef = LLVMBuildSub(builder, array_slice_end, array_slice_start, "arrayslice.len")
                                    _ = array_slice_element_llvm
                                    array_slice_view_llvm: LLVMTypeRef = llvm_type_of(expected, structs, ctx)
                                    array_slice_result: mutable LLVMValueRef = LLVMGetUndef(array_slice_view_llvm)
                                    array_slice_result <- LLVMBuildInsertValue(builder, array_slice_result, array_slice_data, 0, "arrayslice.ins0")
                                    array_slice_result <- LLVMBuildInsertValue(builder, array_slice_result, array_slice_len, 1, "arrayslice.ins1")
                                    return array_slice_result
                        return null
                # A CONTAINER receiver that did not take the fat-view path above must DECLINE
                # here, not fall through to the cstr byte-slice path below. That fallthrough
                # byte-GEPs the container HEADER — `getelementptr i8, { ptr, i64, i64 } %hdr`
                # — and then inserts the header aggregate into an sview's `ptr` field. LLVM
                # does not reject it; it MISCOMPILES:
                #   `ys = xs[1:3]; return ys[0]`  answered 0 where stage0 answers 20,
                # and with a non-literal start the same IR crashed LLVM's SelectionDAG
                # outright (exit 139). A silent wrong answer is the worst outcome available
                # here, so this declines instead — loud, as an undefined symbol at link.
                #
                # It reaches this point only when the destination is not `view[T]`: an
                # UNANNOTATED `ys = xs[lo:hi]`, because expression_type types every slice as
                # SView regardless of receiver (codegen_scope.elisa). stage0 types a darray
                # slice as DynArrayView instead. Fixing that inference — and supporting
                # `view[T]` indexing, which stage1 also declines today — is what turns this
                # decline back into working code.
                slice_receiver_type: ValueType = expression_type(slice_object, local_scope, fns, structs, generics)
                null return if slice_receiver_type.kind == TypeKind.DArray or slice_receiver_type.kind == TypeKind.Array
                # A BORROWED container (`values: darray[i64]&`) types as a Ref, not a DArray,
                # so it slipped past the guard above and fell into the cstr BYTE-slice path
                # below -- which took the address of the darray HEADER as the data pointer.
                # The resulting view pointed at `{items, count, cap}` and read those three
                # words as ELEMENTS. Nothing consumed such a view before (every other path
                # declined it), so the defect was invisible until a new consumer accepted one.
                # Decline the borrowed forms too, exactly as the by-value forms already do.
                slice_receiver_pointee: ValueType = ref_target_of(slice_receiver_type, structs) if slice_receiver_type.kind == TypeKind.Ref else unmodeled_type()
                null return if slice_receiver_pointee.kind == TypeKind.DArray or slice_receiver_pointee.kind == TypeKind.Array
                # An sview is already a `{data, len}` aggregate, not the raw pointer used by
                # cstr. Extract its data field before doing byte-pointer arithmetic; feeding
                # the aggregate directly to GEP produces `getelementptr i8, {ptr, i64} ...`.
                if slice_receiver_type.kind == TypeKind.SView:
                    if emit_expression(slice_object, ValueType{kind: TypeKind.SView, bits: 0}, local_scope, fns, structs, generics, runtime, m, ctx, builder) is sview_slice_base:
                        sview_slice_data: LLVMValueRef = LLVMBuildExtractValue(builder, sview_slice_base, 0, "sview.slice.data")
                        if emit_expression(slice_start_expr, ValueType{kind: TypeKind.Signed, bits: 64}, local_scope, fns, structs, generics, runtime, m, ctx, builder) is sview_slice_start:
                            if emit_expression(slice_end_expr, ValueType{kind: TypeKind.Signed, bits: 64}, local_scope, fns, structs, generics, runtime, m, ctx, builder) is sview_slice_end:
                                sview_slice_llvm: LLVMTypeRef = llvm_type_of(ValueType{kind: TypeKind.SView, bits: 0}, structs, ctx)
                                sview_slice_len: LLVMValueRef = LLVMBuildSub(builder, sview_slice_end, sview_slice_start, "byteslice.len")
                                sview_slice_indices: mutable darray[LLVMValueRef] = [sview_slice_start]
                                sview_slice_indices_pointer: void& = (&sview_slice_indices[0]).cast[void&] can Unsafe.PointerCast
                                sview_slice_data_at: LLVMValueRef = LLVMBuildGEP2(builder, LLVMInt8TypeInContext(ctx), sview_slice_data, sview_slice_indices_pointer, 1, "byteslice.data")
                                sview_slice_result: mutable LLVMValueRef = LLVMGetUndef(sview_slice_llvm)
                                sview_slice_result <- LLVMBuildInsertValue(builder, sview_slice_result, sview_slice_data_at, 0, "byteslice.ins0")
                                sview_slice_result <- LLVMBuildInsertValue(builder, sview_slice_result, sview_slice_len, 1, "byteslice.ins1")
                                return sview_slice_result
                # A `view[T]` receiver: like the sview case it is a `{data, len}` AGGREGATE, so
                # its data field must be extracted before any pointer arithmetic -- falling
                # through to the cstr path below fed the whole aggregate to GEP and produced
                # `getelementptr i8, %DynArrayView %load, i64 0`, which is malformed IR. It
                # survived at -O0 and became a WRONG ANSWER at -O2 (255 where stage0 says 230).
                #
                # The offset is in ELEMENTS, not bytes: `whole[4:8]` starts four T's along, so
                # the GEP walks the element type. The cstr/sview forms are byte-addressed and
                # keep their i8 walk.
                if slice_receiver_type.kind == TypeKind.View:
                    view_slice_element: ValueType = view_element_of(slice_receiver_type, structs)
                    null return if view_slice_element.kind == TypeKind.Unmodeled
                    if emit_expression(slice_object, slice_receiver_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is view_slice_base:
                        view_slice_data: LLVMValueRef = LLVMBuildExtractValue(builder, view_slice_base, 0, "view.slice.data")
                        if emit_expression(slice_start_expr, ValueType{kind: TypeKind.Signed, bits: 64}, local_scope, fns, structs, generics, runtime, m, ctx, builder) is view_slice_start:
                            if emit_expression(slice_end_expr, ValueType{kind: TypeKind.Signed, bits: 64}, local_scope, fns, structs, generics, runtime, m, ctx, builder) is view_slice_end:
                                view_slice_llvm: LLVMTypeRef = llvm_type_of(slice_receiver_type, structs, ctx)
                                view_slice_len: LLVMValueRef = LLVMBuildSub(builder, view_slice_end, view_slice_start, "view.slice.len")
                                view_slice_indices: mutable darray[LLVMValueRef] = [view_slice_start]
                                view_slice_indices_pointer: void& = (&view_slice_indices[0]).cast[void&] can Unsafe.PointerCast
                                view_slice_data_at: LLVMValueRef = LLVMBuildGEP2(builder, llvm_type_of(view_slice_element, structs, ctx), view_slice_data, view_slice_indices_pointer, 1, "view.slice.data.at")
                                view_slice_result: mutable LLVMValueRef = LLVMGetUndef(view_slice_llvm)
                                view_slice_result <- LLVMBuildInsertValue(builder, view_slice_result, view_slice_data_at, 0, "view.slice.ins0")
                                view_slice_result <- LLVMBuildInsertValue(builder, view_slice_result, view_slice_len, 1, "view.slice.ins1")
                                return view_slice_result
                        return null
                    return null
                if emit_expression(slice_object, ValueType{kind: TypeKind.CStr, bits: 0}, local_scope, fns, structs, generics, runtime, m, ctx, builder) is slice_base:
                    if emit_expression(slice_start_expr, ValueType{kind: TypeKind.Signed, bits: 64}, local_scope, fns, structs, generics, runtime, m, ctx, builder) is slice_start:
                        if emit_expression(slice_end_expr, ValueType{kind: TypeKind.Signed, bits: 64}, local_scope, fns, structs, generics, runtime, m, ctx, builder) is slice_end:
                            sview_type: ValueType = ValueType{kind: TypeKind.SView, bits: 0}
                            sview_llvm: LLVMTypeRef = llvm_type_of(sview_type, structs, ctx)
                            slice_len: LLVMValueRef = LLVMBuildSub(builder, slice_end, slice_start, "byteslice.len")
                            slice_gep_indices: mutable darray[LLVMValueRef] = [slice_start]
                            slice_gep_ptr: void& = (&slice_gep_indices[0]).cast[void&] can Unsafe.PointerCast
                            slice_data: LLVMValueRef = LLVMBuildGEP2(builder, LLVMInt8TypeInContext(ctx), slice_base, slice_gep_ptr, 1, "byteslice.data")
                            slice_agg: mutable LLVMValueRef = LLVMGetUndef(sview_llvm)
                            slice_agg <- LLVMBuildInsertValue(builder, slice_agg, slice_data, 0, "byteslice.ins0")
                            slice_agg <- LLVMBuildInsertValue(builder, slice_agg, slice_len, 1, "byteslice.ins1")
                            return slice_agg
                        return null
                    return null
                return null
            # `xs[i]` — an index READ. Only a local array receiver is modeled: the address
            # comes from the local's slot, so no temporary spill is needed.
            if expression is Expr.Index(indexed_object, index_expression, index_line):
                # `chunks[i]` on a ChunksExactView — the i'th whole chunk, as a view over the
                # base starting at `i * chunk` and `chunk` long. The struct is `{base, chunk,
                # count}` (stage0's layout), so both fields come out of the aggregate.
                # A `Flags[T]` BIT TEST (see flags_bit_test_ordinal for the shape).
                flags_recv: ValueType = expression_type(indexed_object, local_scope, fns, structs, generics)
                flags_ordinal: i64 = flags_bit_test_ordinal(flags_recv, index_expression, structs)
                if flags_ordinal >= 0:
                    flags_struct: mutable ValueType = copied_type(flags_recv)
                    flags_struct <- ref_target_of(flags_struct, structs) if flags_struct.kind == TypeKind.Ref
                    flags_field: ValueType = copied_type(structs.field_types[structs.field_start[flags_struct.bits.usize()]])
                    if emit_expression(indexed_object, flags_struct, local_scope, fns, structs, generics, runtime, m, ctx, builder) is flags_aggregate:
                        flags_bits: LLVMValueRef = LLVMBuildExtractValue(builder, flags_aggregate, 0, "flags.bits")
                        flags_llvm: LLVMTypeRef = llvm_type_of(flags_field, structs, ctx)
                        flags_hit: LLVMValueRef = LLVMBuildAnd(builder, flags_bits, LLVMConstInt(flags_llvm, (1.u64() << flags_ordinal.u32()), 0), "flags.hit")
                        return LLVMBuildICmp(builder, 33, flags_hit, LLVMConstInt(flags_llvm, 0, 0), "flags.has")
                    return null
                chunk_recv: ValueType = expression_type(indexed_object, local_scope, fns, structs, generics)
                if chunk_recv.kind == TypeKind.Struct and synthesized_struct_base_is(structs, chunk_recv, "ChunksExactView"):
                    chunk_view_type: ValueType = copied_type(structs.field_types[structs.field_start[chunk_recv.bits.usize()]])
                    chunk_element: ValueType = view_element_of(chunk_view_type, structs)
                    null return if chunk_element.kind == TypeKind.Unmodeled
                    if emit_expression(indexed_object, chunk_recv, local_scope, fns, structs, generics, runtime, m, ctx, builder) is chunk_agg:
                        if emit_expression(index_expression, ValueType{kind: TypeKind.Signed, bits: 64}, local_scope, fns, structs, generics, runtime, m, ctx, builder) is chunk_index:
                            chunk_base: LLVMValueRef = LLVMBuildExtractValue(builder, chunk_agg, 0, "chunk.base")
                            chunk_len: LLVMValueRef = LLVMBuildExtractValue(builder, chunk_agg, 1, "chunk.len")
                            chunk_data: LLVMValueRef = LLVMBuildExtractValue(builder, chunk_base, 0, "chunk.data")
                            chunk_offsets: mutable darray[LLVMValueRef] = [LLVMBuildMul(builder, chunk_index, chunk_len, "chunk.offset")]
                            chunk_offsets_pointer: void& = (&chunk_offsets[0]).cast[void&] can Unsafe.PointerCast
                            chunk_at: LLVMValueRef = LLVMBuildGEP2(builder, llvm_type_of(chunk_element, structs, ctx), chunk_data, chunk_offsets_pointer, 1, "chunk.at")
                            chunk_result: mutable LLVMValueRef = LLVMGetUndef(llvm_type_of(chunk_view_type, structs, ctx))
                            chunk_result <- LLVMBuildInsertValue(builder, chunk_result, chunk_at, 0, "chunk.view.data")
                            chunk_result <- LLVMBuildInsertValue(builder, chunk_result, chunk_len, 1, "chunk.view.len")
                            return chunk_result
                    return null
                # `values[1:3][0]` — indexing a slice DIRECTLY, with no intermediate `view[T]`
                # local. The slice paths above all key off an EXPECTED view type, and here the
                # expected type is the ELEMENT's, so nothing produced the view and the chain
                # resolver declined. Emit the slice at the view type its receiver implies, then
                # read through it.
                #
                # Only ARRAY receivers (by value or by reference) take this route: a darray or
                # sview slice reaches here with the same shape but is already served by the
                # paths above once a view local is involved, and widening this to them would
                # duplicate the very byte-GEP hazard the guards there exist to prevent.
                if indexed_object is Expr.Slice(chain_slice_object, chain_slice_start, chain_slice_end, chain_slice_line):
                    chain_slice_source: ValueType = expression_type(chain_slice_object, local_scope, fns, structs, generics)
                    chain_slice_array: mutable ValueType = chain_slice_source
                    if chain_slice_source.kind == TypeKind.Ref:
                        chain_slice_array <- ref_target_of(chain_slice_source, structs)
                    if chain_slice_array.kind == TypeKind.Array:
                        chain_slice_element: ValueType = array_element_of(chain_slice_array, structs)
                        if chain_slice_element.kind != TypeKind.Unmodeled:
                            chain_slice_view: ValueType = intern_view_type(chain_slice_element, structs)
                            if emit_expression(indexed_object, chain_slice_view, local_scope, fns, structs, generics, runtime, m, ctx, builder) is chain_slice_view_value:
                                if emit_expression(index_expression, ValueType{kind: TypeKind.Signed, bits: 64}, local_scope, fns, structs, generics, runtime, m, ctx, builder) is chain_slice_index:
                                    chain_slice_data: LLVMValueRef = LLVMBuildExtractValue(builder, chain_slice_view_value, 0, "sliceidx.data")
                                    chain_slice_element_llvm: LLVMTypeRef = llvm_type_of(chain_slice_element, structs, ctx)
                                    chain_slice_gep: mutable darray[LLVMValueRef] = [chain_slice_index]
                                    chain_slice_gep_pointer: void& = (&chain_slice_gep[0]).cast[void&] can Unsafe.PointerCast
                                    chain_slice_pointer: LLVMValueRef = LLVMBuildGEP2(builder, chain_slice_element_llvm, chain_slice_data, chain_slice_gep_pointer, 1, "sliceidx.ptr")
                                    chain_slice_loaded: LLVMValueRef = LLVMBuildLoad2(builder, chain_slice_element_llvm, chain_slice_pointer, "sliceidx.elem")
                                    return emit_conversion(chain_slice_loaded, chain_slice_element, expected, structs, ctx, builder) if expected.kind != TypeKind.Unmodeled and (expected.kind != chain_slice_element.kind or expected.bits != chain_slice_element.bits) else chain_slice_loaded
                            return null
                # Guest-overlay accessor `base.field[mem]` (docs/107): desugars to
                # MemoryManager_ReadU<W>(mem, base + offset), matching stage0's analyzer
                # rewrite. The carrier is a GuestVAddr[L]/HostPtr address integer.
                if indexed_object is Expr.Field(overlay_base, overlay_field, overlay_field_line):
                    overlay_base_type: ValueType = expression_type(overlay_base, local_scope, fns, structs, generics)
                    if overlay_base_type.kind == TypeKind.GuestCarrier:
                        overlay_layout: sview = guest_carrier_layout(overlay_base_type, structs)
                        overlay_info: (offset: i64, width: u32) = overlay_field_info(structs, overlay_layout, overlay_field)
                        if overlay_info.offset >= 0 and (overlay_info.width == 1 or overlay_info.width == 2 or overlay_info.width == 4 or overlay_info.width == 8):
                            if emit_expression(overlay_base, overlay_base_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is overlay_base_value:
                                if emit_expression(index_expression, ValueType{kind: TypeKind.Unsigned, bits: 64}, local_scope, fns, structs, generics, runtime, m, ctx, builder) is overlay_mem_value:
                                    overlay_offset_const: LLVMValueRef = LLVMConstInt(LLVMInt64TypeInContext(ctx), overlay_info.offset.u64(), 0)
                                    overlay_addr: LLVMValueRef = LLVMBuildAdd(builder, overlay_base_value, overlay_offset_const, "overlay.addr")
                                    overlay_ret_bits: u32 = 8 if overlay_info.width == 1 else (16 if overlay_info.width == 2 else (32 if overlay_info.width == 4 else 64))
                                    overlay_ret_llvm: LLVMTypeRef = LLVMInt8TypeInContext(ctx) if overlay_ret_bits == 8 else (LLVMInt16TypeInContext(ctx) if overlay_ret_bits == 16 else (LLVMInt32TypeInContext(ctx) if overlay_ret_bits == 32 else LLVMInt64TypeInContext(ctx)))
                                    overlay_param_types: mutable darray[LLVMTypeRef] = [LLVMInt64TypeInContext(ctx), LLVMInt64TypeInContext(ctx)]
                                    overlay_param_pointer: void& = (&overlay_param_types[0]).cast[void&] can Unsafe.PointerCast
                                    overlay_fn_type: LLVMTypeRef = LLVMFunctionType(overlay_ret_llvm, overlay_param_pointer, 2, 0)
                                    overlay_fn: LLVMValueRef = declare_or_get_named(m, "MemoryManager_ReadU8", overlay_fn_type) if overlay_info.width == 1 else (declare_or_get_named(m, "MemoryManager_ReadU16", overlay_fn_type) if overlay_info.width == 2 else (declare_or_get_named(m, "MemoryManager_ReadU32", overlay_fn_type) if overlay_info.width == 4 else declare_or_get_named(m, "MemoryManager_ReadU64", overlay_fn_type)))
                                    overlay_args: mutable darray[LLVMValueRef] = [overlay_mem_value, overlay_addr]
                                    overlay_args_pointer: void& = (&overlay_args[0]).cast[void&] can Unsafe.PointerCast
                                    overlay_raw: LLVMValueRef = LLVMBuildCall2(builder, overlay_fn_type, overlay_fn, overlay_args_pointer, 2, "overlay.read")
                                    overlay_as_i64: mutable LLVMValueRef = overlay_raw
                                    if overlay_ret_bits < 64:
                                        overlay_as_i64 <- LLVMBuildZExt(builder, overlay_raw, LLVMInt64TypeInContext(ctx), "overlay.zext")
                                    overlay_result_type: ValueType = ValueType{kind: TypeKind.Unsigned, bits: 64}
                                    return emit_conversion(overlay_as_i64, overlay_result_type, expected, structs, ctx, builder) if expected.kind != TypeKind.Unmodeled and (expected.kind != overlay_result_type.kind or expected.bits != overlay_result_type.bits) else overlay_as_i64
                            return null
                # `sv[i]` — a byte read from a string view via `ctx_string_view_index(sv, i)`
                # (the view passed BY VALUE). Returns i64.
                sview_index_recv_type: ValueType = expression_type(indexed_object, local_scope, fns, structs, generics)
                if sview_index_recv_type.kind == TypeKind.SView:
                    if emit_expression(indexed_object, sview_index_recv_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is sview_index_recv:
                        if emit_expression(index_expression, ValueType{kind: TypeKind.Signed, bits: 64}, local_scope, fns, structs, generics, runtime, m, ctx, builder) is sview_index_arg:
                            sview_index_args: mutable darray[LLVMValueRef] = [sview_index_recv, sview_index_arg]
                            sview_index_args_pointer: void& = (&sview_index_args[0]).cast[void&] can Unsafe.PointerCast
                            sview_index_value: LLVMValueRef = LLVMBuildCall2(builder, runtime.sview_index_type, runtime.sview_index, sview_index_args_pointer, 2, "sview.index")
                            sview_index_result: ValueType = ValueType{kind: TypeKind.Signed, bits: 64}
                            return emit_conversion(sview_index_value, sview_index_result, expected, structs, ctx, builder) if expected.kind != TypeKind.Unmodeled and (expected.kind != sview_index_result.kind or expected.bits != sview_index_result.bits) else sview_index_value
                        return null
                    return null
                # `s[i]` — a byte read from a cstr via `ctx_string_index(s, i)` (stage0's
                # lowering), returning i64. The pointer is passed by value.
                if sview_index_recv_type.kind == TypeKind.CStr:
                    if emit_expression(indexed_object, sview_index_recv_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is cstr_index_recv:
                        if emit_expression(index_expression, ValueType{kind: TypeKind.Signed, bits: 64}, local_scope, fns, structs, generics, runtime, m, ctx, builder) is cstr_index_arg:
                            cstr_index_param_types: mutable darray[LLVMTypeRef] = [LLVMPointerTypeInContext(ctx, 0), LLVMInt64TypeInContext(ctx)]
                            cstr_index_param_pointer: void& = (&cstr_index_param_types[0]).cast[void&] can Unsafe.PointerCast
                            cstr_index_fn_type: LLVMTypeRef = LLVMFunctionType(LLVMInt64TypeInContext(ctx), cstr_index_param_pointer, 2, 0)
                            cstr_index_fn: LLVMValueRef = declare_or_get_named(m, "ctx_string_index", cstr_index_fn_type)
                            cstr_index_args: mutable darray[LLVMValueRef] = [cstr_index_recv, cstr_index_arg]
                            cstr_index_args_pointer: void& = (&cstr_index_args[0]).cast[void&] can Unsafe.PointerCast
                            cstr_index_value: LLVMValueRef = LLVMBuildCall2(builder, cstr_index_fn_type, cstr_index_fn, cstr_index_args_pointer, 2, "cstr.index")
                            cstr_index_result: ValueType = ValueType{kind: TypeKind.Signed, bits: 64}
                            return emit_conversion(cstr_index_value, cstr_index_result, expected, structs, ctx, builder) if expected.kind != TypeKind.Unmodeled and (expected.kind != cstr_index_result.kind or expected.bits != cstr_index_result.bits) else cstr_index_value
                        return null
                    return null
                # `view.data[i]` — a byte read through the data pointer field of an sview.
                # This is equivalent to `view[i]`, but some stdlib helpers use the explicit
                # pointer field. Handle the field-backed base directly instead of requiring
                # the pointer to be a bare local identifier.
                if indexed_object is Expr.Field(sview_data_owner, sview_data_field, sview_data_line) and sview_data_field == "data":
                    sview_data_owner_type: ValueType = expression_type(sview_data_owner, local_scope, fns, structs, generics)
                    if sview_data_owner_type.kind == TypeKind.SView:
                        if emit_expression(sview_data_owner, sview_data_owner_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is sview_data_owner_value:
                            sview_data_base: LLVMValueRef = LLVMBuildExtractValue(builder, sview_data_owner_value, 0, "sview.data.base")
                            if emit_expression(index_expression, ValueType{kind: TypeKind.Unsigned, bits: 64}, local_scope, fns, structs, generics, runtime, m, ctx, builder) is sview_data_index:
                                sview_data_indices: mutable darray[LLVMValueRef] = [sview_data_index]
                                sview_data_indices_pointer: void& = (&sview_data_indices[0]).cast[void&] can Unsafe.PointerCast
                                sview_data_pointer: LLVMValueRef = LLVMBuildGEP2(builder, LLVMInt8TypeInContext(ctx), sview_data_base, sview_data_indices_pointer, 1, "sview.data.ptr")
                                sview_data_value: LLVMValueRef = LLVMBuildLoad2(builder, LLVMInt8TypeInContext(ctx), sview_data_pointer, "sview.data.byte")
                                sview_data_result: ValueType = ValueType{kind: TypeKind.Unsigned, bits: 8}
                                return emit_conversion(sview_data_value, sview_data_result, expected, structs, ctx, builder) if expected.kind != TypeKind.Unmodeled and (expected.kind != sview_data_result.kind or expected.bits != sview_data_result.bits) else sview_data_value
                            return null
                        return null
                # An INLINE literal receiver (`[1, 2, 3][1]`) has no name for the locators
                # below to look up, and the literal emitter takes its shape from the EXPECTED
                # type, which an index position supplies none of — so the whole function
                # dropped. Build the expected type from the elements (first known type wins;
                # a bare int literal defaults signed-64 as it does everywhere else), emit the
                # literal into a temporary, and index that — the same shape a named local
                # takes, minus the name. All-untyped or empty elements keep declining.
                # `[[1, 2], [3, 4]][1][0]` — the OUTER index whose receiver is itself an index
                # into an inline literal. The receiver has no name to look up and is not an
                # Expr.Array, so no branch below matched and the whole function declined.
                # Emit the inner index at the ROW type (a darray), spill it, and index that —
                # the same temporary-and-index shape the single-literal branch uses.
                if indexed_object is Expr.Index(chain_inner_object, chain_inner_index, chain_line):
                    if chain_inner_object is Expr.Array(chain_lit_elements, chain_lit_line):
                        chain_container: ValueType = literal_container_type(chain_inner_object, local_scope, fns, structs, generics)
                        if chain_container.kind == TypeKind.DArray:
                            chain_row_type: ValueType = darray_element_of(chain_container, structs)
                            if chain_row_type.kind == TypeKind.DArray:
                                chain_element_type: ValueType = darray_element_of(chain_row_type, structs)
                                if emit_expression(indexed_object, chain_row_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is chain_row_value:
                                    chain_slot: LLVMValueRef = LLVMBuildAlloca(builder, darray_llvm_type(structs, ctx), "darray.chain.index")
                                    _ = LLVMBuildStore(builder, chain_row_value, chain_slot)
                                    if emit_darray_index_address(chain_slot, chain_row_type, index_expression, local_scope, fns, structs, generics, runtime, m, ctx, builder) is chain_pointer:
                                        return LLVMBuildLoad2(builder, llvm_type_of(chain_element_type, structs, ctx), chain_pointer, "darray.chain.elem")
                                return null
                if indexed_object is Expr.Array(idx_lit_elements, idx_lit_line):
                    # literal_container_type derives the shape RECURSIVELY, so a nested
                    # literal (`[[1, 2], [3, 4]][1]`) yields darray[darray[i64]] and its
                    # element is a darray rather than Unmodeled. The old inline derivation
                    # used expression_type, which answers Unmodeled for an inner literal, so
                    # any nesting declined here.
                    idx_lit_container: ValueType = literal_container_type(indexed_object, local_scope, fns, structs, generics)
                    null return if idx_lit_container.kind != TypeKind.DArray
                    idx_lit_elem_type: ValueType = darray_element_of(idx_lit_container, structs)
                    if emit_expression(indexed_object, idx_lit_container, local_scope, fns, structs, generics, runtime, m, ctx, builder) is idx_lit_value:
                        idx_lit_slot: LLVMValueRef = LLVMBuildAlloca(builder, darray_llvm_type(structs, ctx), "darray.literal.index")
                        _ = LLVMBuildStore(builder, idx_lit_value, idx_lit_slot)
                        if emit_darray_index_address(idx_lit_slot, idx_lit_container, index_expression, local_scope, fns, structs, generics, runtime, m, ctx, builder) is idx_lit_pointer:
                            return LLVMBuildLoad2(builder, llvm_type_of(idx_lit_elem_type, structs, ctx), idx_lit_pointer, "darray.literal.elem")
                    return null
                if indexed_object is Expr.Ident(array_name, array_name_line):
                    array_type: ValueType = lookup_type(local_scope, array_name)
                    # A BORROWED darray (`darray[T]&`) indexes exactly like a local one once
                    # its header address is loaded out of the parameter slot.
                    borrowed_type: ValueType = darray_type_behind(local_scope, array_name, structs)
                    if borrowed_type.kind == TypeKind.DArray and array_type.kind == TypeKind.Ref:
                        if darray_address_of(local_scope, array_name, structs, ctx, builder) is borrowed_slot:
                            if emit_darray_index_address(borrowed_slot, borrowed_type, index_expression, local_scope, fns, structs, generics, runtime, m, ctx, builder) is borrowed_pointer:
                                borrowed_element: ValueType = darray_element_of(borrowed_type, structs)
                                borrowed_value: LLVMValueRef = LLVMBuildLoad2(builder, llvm_type_of(borrowed_element, structs, ctx), borrowed_pointer, "darray.elem")
                                tag_disjoint_darray_access(borrowed_value, borrowed_pointer, runtime, ctx)
                                return borrowed_value
                        return null
                    if lookup_slot(local_scope, array_name) is array_slot:
                        # A darray indexes through its `items` pointer; a fixed array
                        # indexes the storage directly.
                        if array_type.kind == TypeKind.DArray:
                            if emit_darray_index_address(array_slot, array_type, index_expression, local_scope, fns, structs, generics, runtime, m, ctx, builder) is darray_pointer:
                                darray_element: ValueType = darray_element_of(array_type, structs)
                                darray_value: LLVMValueRef = LLVMBuildLoad2(builder, llvm_type_of(darray_element, structs, ctx), darray_pointer, "darray.elem")
                                tag_disjoint_darray_access(darray_value, darray_pointer, runtime, ctx)
                                return darray_value
                            return null
                        # `v[i]` where `v: view[T]`. The slot holds a DynArrayView VALUE —
                        # `{data: void&?, len: usize}` (elisacore_std/collections.elisa) — so
                        # the element address is a GEP of ELEMENT stride from field 0, the
                        # same shape a darray gets through `items`.
                        #
                        # There was NO View arm here at all, so `v[0]` declined the whole
                        # enclosing function. That is why even the ANNOTATED
                        # `ys: view[i64] = xs[1:3]; ys[0]` never worked, and why typing
                        # slices by their receiver could not have been enough on its own.
                        if array_type.kind == TypeKind.View:
                            view_index_struct: ValueType = view_struct_type(array_type, structs)
                            if view_index_struct.kind != TypeKind.Unmodeled:
                                view_index_element: ValueType = view_element_of(array_type, structs)
                                view_index_elem_llvm: LLVMTypeRef = llvm_type_of(view_index_element, structs, ctx)
                                view_index_agg: LLVMValueRef = LLVMBuildLoad2(builder, llvm_type_of(view_index_struct, structs, ctx), array_slot, "view.agg")
                                view_index_data: LLVMValueRef = LLVMBuildExtractValue(builder, view_index_agg, 0, "view.data")
                                if emit_expression(index_expression, ValueType{kind: TypeKind.Signed, bits: 64}, local_scope, fns, structs, generics, runtime, m, ctx, builder) is view_index_value:
                                    view_index_indices: mutable darray[LLVMValueRef] = [view_index_value]
                                    view_index_indices_pointer: void& = (&view_index_indices[0]).cast[void&] can Unsafe.PointerCast
                                    view_index_address: LLVMValueRef = LLVMBuildGEP2(builder, view_index_elem_llvm, view_index_data, view_index_indices_pointer, 1, "view.elem.addr")
                                    view_index_loaded: LLVMValueRef = LLVMBuildLoad2(builder, view_index_elem_llvm, view_index_address, "view.elem")
                                    # Convert to the surrounding context's type, exactly as the
                                    # scalar-ref read below does. Returning the element at its
                                    # NATURAL width emitted `add i64 %a, i8 %b` for
                                    # `ys[1] + zs[1].i64()` (a view[i64] and a view[u8] in one
                                    # function) — LLVM accepted the module and died in ISel with
                                    # "Do not know how to promote this operator's operand".
                                    # Each view read is fine alone; only the MIXED-width pair
                                    # exposes it.
                                    return emit_conversion(view_index_loaded, view_index_element, expected, structs, ctx, builder) if expected.kind != TypeKind.Unmodeled and (expected.kind != view_index_element.kind or expected.bits != view_index_element.bits) else view_index_loaded
                                return null
                            return null
                        # `a[i]` where `a: T[N]&` — a REF to a fixed array. The slot holds the
                        # array's ADDRESS; load it and GEP in like a local array.
                        if array_type.kind == TypeKind.Ref and ref_target_of(array_type, structs).kind == TypeKind.Array:
                            ref_read_array_type: ValueType = ref_target_of(array_type, structs)
                            ref_read_base: LLVMValueRef = LLVMBuildLoad2(builder, LLVMPointerTypeInContext(ctx, 0), array_slot, "arr.ref.base")
                            if emit_index_address(ref_read_base, ref_read_array_type, index_expression, local_scope, fns, structs, generics, runtime, m, ctx, builder) is ref_read_pointer:
                                ref_read_element: ValueType = array_element_of(ref_read_array_type, structs)
                                ref_read_loaded: LLVMValueRef = LLVMBuildLoad2(builder, llvm_type_of(ref_read_element, structs, ctx), ref_read_pointer, "arr.ref.elem")
                                # Convert to the surrounding context's type, exactly as the
                                # scalar-ref/opt-ref/view reads below and above do. Returning the
                                # element at its NATURAL width left `ys[1] + zs[1].i64()` (an
                                # i64[3]& and a u8[3]& in one function) building a WIDTH-MISMATCHED
                                # `sadd.with.overflow.i64(i64, i8)` call — LLVM accepted the
                                # module and silently answered 200 where stage0 answers 202. Each
                                # width read alone was fine; only the mixed-width pair exposed it.
                                return emit_conversion(ref_read_loaded, ref_read_element, expected, structs, ctx, builder) if expected.kind != TypeKind.Unmodeled and (expected.kind != ref_read_element.kind or expected.bits != ref_read_element.bits) else ref_read_loaded
                            return null
                        # `p[i]` where `p: T&` is a ref to a NUMERIC scalar — a C-style pointer
                        # base. Slice[T] reads its backing this way (`p: T& = s.base.cast[T&];
                        # p[i]`). Scoped to numeric elements: a ref-to-struct (dict's
                        # `items[i]` on a `DictBucket&`) is handled by the chain fallback below, and
                        # a ref-to-array by the branch above. The loaded value is converted to the
                        # surrounding context's expected type so it composes like any scalar read.
                        if array_type.kind == TypeKind.Ref:
                            scalar_ref_elem: ValueType = ref_target_of(array_type, structs)
                            if scalar_ref_elem.kind == TypeKind.Signed or scalar_ref_elem.kind == TypeKind.Unsigned or scalar_ref_elem.kind == TypeKind.Float:
                                scalar_ref_base: LLVMValueRef = LLVMBuildLoad2(builder, LLVMPointerTypeInContext(ctx, 0), array_slot, "scalar.ref.base")
                                if emit_expression(index_expression, ValueType{kind: TypeKind.Unsigned, bits: 64}, local_scope, fns, structs, generics, runtime, m, ctx, builder) is scalar_ref_index:
                                    scalar_ref_elem_llvm: LLVMTypeRef = llvm_type_of(scalar_ref_elem, structs, ctx)
                                    scalar_ref_gep_indices: mutable darray[LLVMValueRef] = [scalar_ref_index]
                                    scalar_ref_gep_pointer: void& = (&scalar_ref_gep_indices[0]).cast[void&] can Unsafe.PointerCast
                                    scalar_ref_elem_ptr: LLVMValueRef = LLVMBuildGEP2(builder, scalar_ref_elem_llvm, scalar_ref_base, scalar_ref_gep_pointer, 1, "scalar.ref.elem.ptr")
                                    scalar_ref_value: LLVMValueRef = LLVMBuildLoad2(builder, scalar_ref_elem_llvm, scalar_ref_elem_ptr, "scalar.ref.elem")
                                    return emit_conversion(scalar_ref_value, scalar_ref_elem, expected, structs, ctx, builder) if expected.kind != TypeKind.Unmodeled and (expected.kind != scalar_ref_elem.kind or expected.bits != scalar_ref_elem.bits) else scalar_ref_value
                                return null
                        # `found[0]` where `found: T&?` is an OPTIONAL ref to a numeric scalar
                        # (`{i1, ptr}`), narrowed non-null by an earlier `null return if found ==
                        # null`. Extract the payload ptr (field 1) and index it like a scalar ref.
                        # index_map_find_index reads the dict's `usize&?` result this way.
                        if array_type.kind == TypeKind.Optional:
                            opt_ref_payload: ValueType = optional_payload_of(array_type, structs)
                            if opt_ref_payload.kind == TypeKind.Ref:
                                opt_ref_elem: ValueType = ref_target_of(opt_ref_payload, structs)
                                if opt_ref_elem.kind == TypeKind.Signed or opt_ref_elem.kind == TypeKind.Unsigned or opt_ref_elem.kind == TypeKind.Float:
                                    opt_ref_aggregate: LLVMValueRef = LLVMBuildLoad2(builder, llvm_type_of(array_type, structs, ctx), array_slot, "opt.ref.aggr")
                                    opt_ref_base: LLVMValueRef = optional_payload_value_of(opt_ref_aggregate, array_type, structs, ctx, builder)
                                    if emit_expression(index_expression, ValueType{kind: TypeKind.Unsigned, bits: 64}, local_scope, fns, structs, generics, runtime, m, ctx, builder) is opt_ref_index:
                                        opt_ref_elem_llvm: LLVMTypeRef = llvm_type_of(opt_ref_elem, structs, ctx)
                                        opt_ref_gep_indices: mutable darray[LLVMValueRef] = [opt_ref_index]
                                        opt_ref_gep_pointer: void& = (&opt_ref_gep_indices[0]).cast[void&] can Unsafe.PointerCast
                                        opt_ref_elem_ptr: LLVMValueRef = LLVMBuildGEP2(builder, opt_ref_elem_llvm, opt_ref_base, opt_ref_gep_pointer, 1, "opt.ref.elem.ptr")
                                        opt_ref_value: LLVMValueRef = LLVMBuildLoad2(builder, opt_ref_elem_llvm, opt_ref_elem_ptr, "opt.ref.elem")
                                        return emit_conversion(opt_ref_value, opt_ref_elem, expected, structs, ctx, builder) if expected.kind != TypeKind.Unmodeled and (expected.kind != opt_ref_elem.kind or expected.bits != opt_ref_elem.bits) else opt_ref_value
                                    return null
                        null return if array_type.kind != TypeKind.Array
                        if emit_index_address(array_slot, array_type, index_expression, local_scope, fns, structs, generics, runtime, m, ctx, builder) is pointer:
                            element_type: ValueType = array_element_of(array_type, structs)
                            array_element_value: LLVMValueRef = LLVMBuildLoad2(builder, llvm_type_of(element_type, structs, ctx), pointer, "elem")
                            # Widen/narrow to the EXPECTED type, exactly as the optional-ref
                            # read above does. Without it `text[1]` on a `u8[4]` returned an
                            # i8 where the context wanted i64 (`-> char`, or plain `-> i64`),
                            # and the return path's type-identity guard declined the whole
                            # function -- while the same expression with an explicit `.i64()`
                            # compiled fine.
                            return emit_conversion(array_element_value, element_type, expected, structs, ctx, builder) if expected.kind != TypeKind.Unmodeled and (expected.kind != element_type.kind or expected.bits != element_type.bits) else array_element_value
                # `make_array()[1]` — indexing a RETURNED darray. `darray_type_behind_expr`
                # cannot see it: that helper has no FnTable, so a call's return type is out of
                # reach there and every such index declined. Typed here, where it is in hand,
                # and the address comes from the same helper's call-spill branch.
                if indexed_object is Expr.Call(ret_callee, ret_call_args, ret_call_names, ret_call_line):
                    ret_darray_type: ValueType = expression_type(indexed_object, local_scope, fns, structs, generics)
                    if ret_darray_type.kind == TypeKind.DArray:
                        if darray_address_of_expr(indexed_object, local_scope, fns, structs, generics, runtime, m, ctx, builder) is ret_darray_slot:
                            if emit_darray_index_address(ret_darray_slot, ret_darray_type, index_expression, local_scope, fns, structs, generics, runtime, m, ctx, builder) is ret_darray_pointer:
                                ret_darray_element: ValueType = darray_element_of(ret_darray_type, structs)
                                ret_darray_value: LLVMValueRef = LLVMBuildLoad2(builder, llvm_type_of(ret_darray_element, structs, ctx), ret_darray_pointer, "darray.elem")
                                return emit_conversion(ret_darray_value, ret_darray_element, expected, structs, ctx, builder) if expected.kind != TypeKind.Unmodeled and (expected.kind != ret_darray_element.kind or expected.bits != ret_darray_element.bits) else ret_darray_value
                        return null
                # A darray reached through a struct FIELD (`b.items[i]`): resolve the header
                # address via the _expr helper, then index like any darray.
                field_darray_type: ValueType = darray_type_behind_expr(indexed_object, local_scope, structs)
                if field_darray_type.kind == TypeKind.DArray:
                    if darray_address_of_expr(indexed_object, local_scope, fns, structs, generics, runtime, m, ctx, builder) is field_darray_slot:
                        if emit_darray_index_address(field_darray_slot, field_darray_type, index_expression, local_scope, fns, structs, generics, runtime, m, ctx, builder) is field_darray_pointer:
                            field_darray_element: ValueType = darray_element_of(field_darray_type, structs)
                            field_darray_value: LLVMValueRef = LLVMBuildLoad2(builder, llvm_type_of(field_darray_element, structs, ctx), field_darray_pointer, "darray.elem")
                            tag_disjoint_darray_access(field_darray_value, field_darray_pointer, runtime, ctx)
                            return field_darray_value
                    return null
                # Any other receiver chain (`m[i][j]`, `s.grid[i]`): the chain resolver
                # yields the ELEMENT's type and address; load through it.
                chain_element_type: ValueType = struct_chain_type(expression, local_scope, structs)
                if chain_element_type.kind == TypeKind.Unmodeled:
                    return null
                if struct_chain_address(expression, local_scope, fns, structs, generics, runtime, m, ctx, builder) is chain_element_address:
                    return LLVMBuildLoad2(builder, llvm_type_of(chain_element_type, structs, ctx), chain_element_address, "elem")
                return null

            # `Point{x: 40, y: 2}` — build the value in a temporary slot, store each
            # field, then load the whole struct back. mem2reg/SROA turn this into plain
            # registers at -O2, so the temporary costs nothing in the output.
            #
            # Fields may be given by NAME or position (empty name). Start from a zero aggregate so omitted fields have
            # the same deterministic default as stage0's aggregate construction.
            # `base{field = v, ...}` — a RECORD UPDATE: the base value with the named fields
            # overridden, everything else copied. `grep RecordUpdate src/backend` found
            # nothing, so the form was unimplemented in codegen and every use declined.
            #
            # stage0 lowers it as `insertvalue` per overridden field (read from its -emit
            # llvm); this stores the base into a temporary and overwrites those fields
            # through StructGEP, the same shape the Construct branch below uses, which is
            # equivalent and keeps the two paths consistent.
            #
            # The struct comes from the BASE's type, not an annotation -- a record update has
            # no type name of its own to resolve. A field name that is not a member (or a
            # POSITIONAL field, which this form has no meaning for) yields -1 and declines
            # rather than writing to a guessed offset.
            if expression is Expr.RecordUpdate(ru_base, ru_fields, ru_line):
                ru_type: ValueType = expression_type(ru_base, local_scope, fns, structs, generics)
                null return if ru_type.kind != TypeKind.Struct
                ru_slot: usize = ru_type.bits.usize()
                ru_llvm: LLVMTypeRef = llvm_type_of(ru_type, structs, ctx)
                if emit_expression(ru_base, ru_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is ru_base_value:
                    ru_temporary: LLVMValueRef = LLVMBuildAlloca(builder, ru_llvm, "record.update")
                    _ = LLVMBuildStore(builder, ru_base_value, ru_temporary)
                    ru_declined: mutable bool = false
                    for ru_field in ru_fields |ru_declined, ru_slot, ru_llvm, ru_temporary, local_scope, fns, structs, generics, runtime, m, ctx, builder|:
                        ru_position: i64 = field_index_of(structs, ru_slot, ru_field.name)
                        if ru_position < 0:
                            ru_declined <- true
                        else:
                            ru_field_type: ValueType = structs.field_types[structs.field_start[ru_slot] + ru_position.usize()]
                            if emit_expression(ru_field.value, ru_field_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is ru_field_value:
                                _ = LLVMBuildStore(builder, ru_field_value, LLVMBuildStructGEP2(builder, ru_llvm, ru_temporary, ru_position.u32(), "record.update.field.ptr"))
                            else:
                                ru_declined <- true
                    null return if ru_declined
                    return LLVMBuildLoad2(builder, ru_llvm, ru_temporary, "record.update.load")
                return null
            if expression is Expr.Construct(construct_type, construct_fields, construct_line):
                built_type: mutable ValueType = annotation_value_type(construct_type, structs)
                null return if built_type.kind != TypeKind.Struct
                struct_slot: usize = built_type.bits.usize()
                # `StringView` is the named source spelling for the builtin `sview` ABI.
                # Its field registry is useful for labelled construction, but the value must
                # use the same anonymous `{ptr, i64}` LLVM type as every `sview` signature;
                # returning `%StringView` where the function returns `{ptr, i64}` is invalid.
                built_type <- ValueType{kind: TypeKind.SView, bits: 0} if structs.names[struct_slot] == "StringView"

                struct_llvm: LLVMTypeRef = llvm_type_of(built_type, structs, ctx)
                temporary: LLVMValueRef = LLVMBuildAlloca(builder, struct_llvm, "construct")
                _ = LLVMBuildStore(builder, LLVMConstNull(struct_llvm), temporary)
                declined: mutable bool = false
                field_order: mutable u32 = 0
                # Which positions the literal actually supplied — the rest are candidates for
                # a declared `= default`.
                supplied: mutable darray[bool] = []
                for _ in 0..<structs.field_count[struct_slot] |supplied|:
                    supplied.push(false)
                for field_init in construct_fields |declined, field_order, supplied, struct_slot, struct_llvm, temporary, local_scope, fns, structs, generics, runtime, m, ctx, builder|:
                    position: mutable i64 = field_index_of(structs, struct_slot, field_init.name)
                    if field_init.name == "":
                        position <- field_order.i64()
                    field_order <- field_order + 1
                    if position < 0:
                        declined <- true
                    else:
                        field_type: ValueType = structs.field_types[structs.field_start[struct_slot] + position.usize()]
                        supplied[position.usize()] <- true
                        if emit_expression(field_init.value, field_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is field_value:
                            _ = LLVMBuildStore(builder, field_value, LLVMBuildStructGEP2(builder, struct_llvm, temporary, position.u32(), "field.ptr"))
                        else:
                            declined <- true
                null return if declined
                # An OMITTED field that declares `= default` gets the default stored over the
                # zero — `P{}` with `x: i64 = 42` answers 42, not 0. Two deliberate fallbacks
                # to the zero, both of which only preserve today's behavior: a field with no
                # declared default, and a default whose expression this backend cannot emit
                # (declining the whole literal there would turn a wrong answer into a lost
                # one, and StructTable's own literals lean on the omitted-field path).
                if built_type.kind == TypeKind.Struct:
                    for default_position in 0..<supplied.count |supplied, struct_slot, struct_llvm, temporary, local_scope, fns, structs, generics, runtime, m, ctx, builder|:
                        if not supplied[default_position]:
                            default_slot: usize = structs.field_start[struct_slot] + default_position
                            default_row: i64 = field_default_row(structs, structs.names[struct_slot], structs.field_names[default_slot])
                            if default_row >= 0:
                                if emit_expression(structs.field_default_values[default_row.usize()], structs.field_types[default_slot], local_scope, fns, structs, generics, runtime, m, ctx, builder) is default_value:
                                    _ = LLVMBuildStore(builder, default_value, LLVMBuildStructGEP2(builder, struct_llvm, temporary, default_position.u32(), "field.default.ptr"))
                return LLVMBuildLoad2(builder, struct_llvm, temporary, "constructed")

            # Bitset flag read: `token.flags.has_suffix` — outer field is the packed u8,
            # inner name is a 1-bit flag (stage0: load i8, and mask, icmp ne 0). For the
            # self-host Token shape the only flag is bit 0 (`has_suffix`).
            if expression is Expr.Field(flag_container, flag_name, flag_line):
                if flag_container is Expr.Field(flag_owner, flag_field, flag_field_line):
                    # ANY named member of a `bitset:` / `bitfield:` group. Only two names were
                    # handled before (`has_suffix`/`has_prefix`, the ones the self-host Token
                    # struct uses), so every other flag declined. The offset and width come from
                    # the group's recorded member list, so a one-bit bitset flag reads as a bool
                    # and a wider bitfield member reads as its own integer.
                    bg_owner_type: mutable ValueType = expression_type(flag_owner, local_scope, fns, structs, generics)
                    bg_owner_type <- ref_target_of(bg_owner_type, structs) if bg_owner_type.kind == TypeKind.Ref
                    if bg_owner_type.kind == TypeKind.Struct:
                        bg_row: i64 = bit_group_member_index(structs, bg_owner_type.bits.usize(), flag_field, flag_name)
                        if bg_row >= 0:
                            bg_pack_type: ValueType = expression_type(flag_container, local_scope, fns, structs, generics)
                            if bg_pack_type.kind == TypeKind.Unsigned:
                                if emit_expression(flag_container, bg_pack_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is bg_pack:
                                    bg_llvm: LLVMTypeRef = llvm_type_of(bg_pack_type, structs, ctx)
                                    bg_offset: u32 = structs.bitgroup_offsets[bg_row.usize()]
                                    bg_width: u32 = structs.bitgroup_widths[bg_row.usize()]
                                    bg_shifted: LLVMValueRef = LLVMBuildLShr(builder, bg_pack, LLVMConstInt(bg_llvm, bg_offset.u64(), 0), "bitgroup.shr")
                                    bg_mask: u64 = (1.u64() << bg_width.u64()) - 1.u64()
                                    bg_value: LLVMValueRef = LLVMBuildAnd(builder, bg_shifted, LLVMConstInt(bg_llvm, bg_mask, 0), "bitgroup.and")
                                    # A ONE-BIT member is a bool; a wider one keeps its integer
                                    # value and converts to whatever the context wants.
                                    if structs.bitgroup_is_flag[bg_row.usize()] and (expected.kind == TypeKind.Bool or expected.kind == TypeKind.Unmodeled):
                                        return LLVMBuildICmp(builder, 33, bg_value, LLVMConstInt(bg_llvm, 0, 0), "bitgroup.test")
                                    return emit_conversion(bg_value, bg_pack_type, expected, structs, ctx, builder) if expected.kind != TypeKind.Unmodeled and (expected.kind != bg_pack_type.kind or expected.bits != bg_pack_type.bits) else bg_value
                                return null
                    if flag_name == "has_suffix" or flag_name == "has_prefix":
                        flag_bit: u64 = 0 if flag_name == "has_suffix" else 1
                        flag_pack_type: ValueType = expression_type(flag_container, local_scope, fns, structs, generics)
                        if flag_pack_type.kind == TypeKind.Unsigned:
                            if emit_expression(flag_container, flag_pack_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is flag_pack:
                                flag_mask: LLVMValueRef = LLVMConstInt(llvm_type_of(flag_pack_type, structs, ctx), 1.u64() << flag_bit, 0)
                                flag_bits: LLVMValueRef = LLVMBuildAnd(builder, flag_pack, flag_mask, "bitset.and")
                                flag_zero: LLVMValueRef = LLVMConstInt(llvm_type_of(flag_pack_type, structs, ctx), 0, 0)
                                return LLVMBuildICmp(builder, 33, flag_bits, flag_zero, "bitset.test")
                            return null
            # `Color.Green` / `Lexer::TokenKind.Ident` — a CONST ENUM member is a constant of
            # the enum's backing type: its declaration-order ordinal.
            if expression is Expr.Field(enum_object, enum_variant, enum_field_line):
                enum_type_name: mutable sview = ""
                if enum_object is Expr.Ident(enum_ident_name, enum_ident_line):
                    enum_type_name <- enum_ident_name
                if enum_object is Expr.Scope(enum_mod_head, enum_mod_name, enum_mod_line):
                    enum_type_name <- enum_mod_name
                if enum_type_name != "":
                    enum_slot: i64 = enum_index_of(structs, enum_type_name)
                    if enum_slot >= 0:
                        # The member's VALUE, not its ordinal — `Lo = 2` is 2, not 0.
                        member_value: i64 = enum_value_of(structs, enum_slot.usize(), enum_variant)
                        null return if enum_ordinal_of(structs, enum_slot.usize(), enum_variant) < 0
                        backing: ValueType = copied_type(structs.enum_backings[enum_slot.usize()])
                        return LLVMConstInt(llvm_type_of(backing, structs, ctx), member_value.u64(), 0)
                    # `Opt.None` — a PAYLOAD-FREE variant of a payload enum, used as a bare
                    # value rather than called. It is still the tagged union: the tag, with
                    # the payload slot left zeroed.
                    penum_slot_index: i64 = penum_index_of(structs, enum_type_name)
                    if penum_slot_index >= 0:
                        penum_tag: i64 = penum_variant_index(structs, penum_slot_index, enum_variant)
                        null return if penum_tag < 0
                        # A variant WITH a payload is a constructor and must be called; a
                        # bare mention of one is not a value.
                        null return if structs.penum_has_payload[structs.penum_variant_start[penum_slot_index.usize()] + penum_tag.usize()]
                        penum_value_type: ValueType = ValueType{kind: TypeKind.PayloadEnum, bits: penum_slot_index.u32()}
                        penum_llvm: LLVMTypeRef = llvm_type_of(penum_value_type, structs, ctx)
                        penum_ctor_slot: LLVMValueRef = LLVMBuildAlloca(builder, penum_llvm, "enum.ctor")
                        _ = LLVMBuildStore(builder, LLVMConstNull(penum_llvm), penum_ctor_slot)
                        penum_tag_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, penum_llvm, penum_ctor_slot, 0, "enum.tag.ptr")
                        _ = LLVMBuildStore(builder, LLVMConstInt(LLVMInt32TypeInContext(ctx), penum_tag.u64(), 0), penum_tag_pointer)
                        return LLVMBuildLoad2(builder, penum_llvm, penum_ctor_slot, "enum.value")
                    # A payload-free recursive AST refinement variant (`Ast::Pattern.Wildcard`,
                    # `Ast::Expr.Invalid`). Payload-bearing packed variants remain constructors
                    # and must be called with their fields.
                    #
                    # This MUST allocate a store row, exactly as the constructor path does. A
                    # packed value is an AoS row INDEX, and every reader resolves it with
                    # `ctx_aos_store_record(state, handle)` before reading the tag. Returning the
                    # variant's ORDINAL as if it were a handle — which is what this did — made
                    # `Ast::Pattern.Wildcard` evaluate to 57, so readers fetched record #57: a
                    # row that was never written, whose zeroed tag 0 matched no arm. The
                    # exhaustive 14-arm match in `Parser.when_atom_pattern_illegal` then fell off
                    # its end into the `unreachable`, which is why gen2 trapped on ANY `when`.
                    packed_slot_index: i64 = packed_index_of(structs, enum_type_name)
                    if packed_slot_index >= 0:
                        packed_tag: i64 = packed_variant_index(structs, packed_slot_index, enum_variant)
                        null return if packed_tag < 0
                        packed_variant_slot: usize = structs.packed_variant_start[packed_slot_index.usize()] + packed_variant_local_index(structs, packed_slot_index, enum_variant).usize()
                        null return if structs.packed_has_payload[packed_variant_slot]
                        bare_store_index: i64 = packed_root_index_of(structs, packed_slot_index)
                        null return if bare_store_index < 0
                        null return if runtime.active_store_enum != bare_store_index
                        bare_arena: LLVMValueRef = LLVMBuildExtractValue(builder, runtime.active_store, 0, "packed.arena")
                        bare_state: LLVMValueRef = LLVMBuildExtractValue(builder, runtime.active_store, 2, "packed.state")
                        bare_alloc_args: mutable darray[LLVMValueRef] = [bare_arena, bare_state, LLVMConstInt(LLVMInt32TypeInContext(ctx), packed_tag.u64(), 0)]
                        if runtime.packed_mode == 2:
                            bare_alloc_args <- [bare_arena, bare_state]
                        bare_alloc_pointer: void& = (&bare_alloc_args[0]).cast[void&] can Unsafe.PointerCast
                        bare_alloc_result: LLVMValueRef = LLVMBuildCall2(builder, runtime.packed_alloc_type, runtime.packed_alloc, bare_alloc_pointer, 2 if runtime.packed_mode == 2 else 3, "packed.variant.alloc")
                        bare_row: LLVMValueRef = LLVMBuildExtractValue(builder, bare_alloc_result, 0, "packed.alloc.ptr")
                        bare_handle_llvm: LLVMTypeRef = packed_row_llvm_type(structs, packed_slot_index, ctx)
                        _ = LLVMBuildStore(builder, LLVMConstNull(bare_handle_llvm), bare_row)
                        bare_tag_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, bare_handle_llvm, bare_row, 0, "packed.tag.ptr")
                        _ = LLVMBuildStore(builder, LLVMConstInt(LLVMInt32TypeInContext(ctx), packed_tag.u64(), 0), bare_tag_pointer)
                        return LLVMBuildExtractValue(builder, bare_alloc_result, 1, "packed.alloc.index")

            # `xs.count` — read the darray header's count field.
            # `node.left` after `if node is Expr.Pair:` — reading a payload field through the
            # NARROWED variant view, with no binding pattern to introduce the name. stage0
            # lowers it as a plain payload GEP + extract in the proven branch; stage1 had no
            # case for a payload-enum receiver in field position at all.
            #
            # The variant is chosen by FIELD NAME, and only when exactly ONE variant declares
            # it. That is what makes the read safe without re-deriving the narrowing: with two
            # variants sharing a field name the offsets can differ and the branch the read sits
            # in decides which is right — information this emitter does not have, so it
            # declines rather than pick. The semantic layer has already proven the narrowing;
            # a program that reads the wrong variant's field never reaches here.
            # `node.span` — a packed enum's COMMON field. There was no packed common-field read
            # path at all.
            #
            # Read INLINE, at word `1 + commonIndex`: word 0 is the tag and the commons follow
            # it, which is exactly where stage1's own constructor WRITES them
            # (`getelementptr {i32, i64, [N x i64]}, …, 1`). stage0 instead keeps commons in a
            # SIDE TABLE and builds the store with
            # `ctx_packed_store_state_new_variant_sparse_with_side_words` -- a different layout,
            # but not an observable one, since stores never cross compilers. Reading with
            # stage0's convention against stage1's writer is what a first attempt did, and the
            # compiled program segfaulted on an uninitialised side table.
            #
            # Resolved by OWNER NAME rather than by enum index: four separate paths push a
            # `packed_names` row, so an index-parallel pool goes out of step -- that mistake
            # segfaulted the compiler on the first attempt at this.
            if expression is Expr.Field(pcf_object, pcf_field, pcf_field_line):
                pcf_receiver: ValueType = expression_type(pcf_object, local_scope, fns, structs, generics)
                if pcf_receiver.kind == TypeKind.PackedEnum and runtime.active_store_enum >= 0:
                    if pcf_receiver.bits.usize() < structs.packed_names.count:
                        pcf_index: i64 = packed_common_index_of(structs.packed_names[pcf_receiver.bits.usize()], pcf_field, structs)
                        if pcf_index >= 0:
                            # Commons are i64 words in the side table, like the payload words.
                            pcf_word_type: ValueType = ValueType{kind: TypeKind.Signed, bits: 64}
                            if emit_expression(pcf_object, pcf_receiver, local_scope, fns, structs, generics, runtime, m, ctx, builder) is pcf_handle:
                                pcf_state: LLVMValueRef = LLVMBuildExtractValue(builder, runtime.active_store, 2, "packed.state")
                                pcf_word: mutable LLVMValueRef = zeroed
                                if runtime.packed_mode == 2:
                                    # Under the AoS profile there IS no word reader: `packed_read_word`
                                    # is `ctx_aos_store_record`, which takes (state, handle) and hands
                                    # back the ROW POINTER. Calling it with the word-reader's three
                                    # arguments produced a `ptr` where an i64 was wanted -- which is
                                    # why a BARE `return node.span` declined on the return path's
                                    # type-identity check while `node.span + 0` silently accepted the
                                    # pointer as an operand. Read the common out of the row instead,
                                    # at field `1 + commonIndex`, exactly where the constructor
                                    # writes it.
                                    pcf_index64: LLVMValueRef = LLVMBuildZExt(builder, pcf_handle, LLVMInt64TypeInContext(ctx), "packed.common.index")
                                    pcf_record_args: mutable darray[LLVMValueRef] = [pcf_state, pcf_index64]
                                    pcf_record_pointer: void& = (&pcf_record_args[0]).cast[void&] can Unsafe.PointerCast
                                    pcf_record: LLVMValueRef = LLVMBuildCall2(builder, runtime.packed_read_word_type, runtime.packed_read_word, pcf_record_pointer, 2, "packed.common.record")
                                    pcf_row_type: LLVMTypeRef = packed_row_llvm_type(structs, pcf_receiver.bits.i64(), ctx)
                                    pcf_field_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, pcf_row_type, pcf_record, (1 + pcf_index).u32(), "packed.common.ptr")
                                    pcf_word <- LLVMBuildLoad2(builder, LLVMInt64TypeInContext(ctx), pcf_field_pointer, "packed.common.value")
                                else:
                                    pcf_args: mutable darray[LLVMValueRef] = [pcf_handle, pcf_state, LLVMConstInt(LLVMInt64TypeInContext(ctx), 1 + pcf_index.u64(), 0)]
                                    pcf_pointer: void& = (&pcf_args[0]).cast[void&] can Unsafe.PointerCast
                                    pcf_word <- LLVMBuildCall2(builder, runtime.packed_read_word_type, runtime.packed_read_word, pcf_pointer, 3, "packed.common.word")
                                return emit_conversion(pcf_word, pcf_word_type, expected, structs, ctx, builder) if expected.kind != TypeKind.Unmodeled and (expected.kind != pcf_word_type.kind or expected.bits != pcf_word_type.bits) else pcf_word
                            return null
            if expression is Expr.Field(pev_object, pev_field, pev_field_line):
                pev_receiver: ValueType = expression_type(pev_object, local_scope, fns, structs, generics)
                if pev_receiver.kind == TypeKind.PayloadEnum:
                    pev_enum: usize = pev_receiver.bits.usize()
                    pev_match_slot: mutable i64 = -1
                    pev_match_offset: mutable usize = 0
                    pev_matches: mutable i64 = 0
                    for pev_variant in 0..<structs.penum_variant_count[pev_enum] |pev_match_slot, pev_match_offset, pev_matches, pev_enum, pev_field, structs|:
                        pev_slot: usize = structs.penum_variant_start[pev_enum] + pev_variant
                        pev_start: usize = structs.penum_field_type_start[pev_slot]
                        for pev_index in 0..<structs.penum_field_type_count[pev_slot] |pev_match_slot, pev_match_offset, pev_matches, pev_start, pev_slot, pev_field, structs|:
                            if structs.penum_field_flat_names[pev_start + pev_index] == pev_field:
                                pev_match_slot <- pev_slot.i64()
                                pev_match_offset <- pev_index
                                pev_matches <- pev_matches + 1
                    if pev_matches == 1:
                        pev_slot_index: usize = pev_match_slot.usize()
                        pev_field_type: ValueType = copied_type(structs.penum_field_types[structs.penum_field_type_start[pev_slot_index] + pev_match_offset])
                        if pev_field_type.kind != TypeKind.Unmodeled:
                            # A by-value enum LOCAL/param is its own slot; anything else goes
                            # through the chain resolver. Failure FALLS THROUGH to the branches
                            # below rather than declining -- this case must not claim a field
                            # read it cannot serve.
                            pev_slot_opt: mutable LLVMValueRef? = null
                            if pev_object is Expr.Ident(pev_name, pev_name_line):
                                pev_slot_opt <- lookup_slot(local_scope, pev_name)
                            else:
                                pev_slot_opt <- struct_chain_address(pev_object, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                            if pev_slot_opt is pev_address:
                                pev_enum_llvm: LLVMTypeRef = llvm_type_of(pev_receiver, structs, ctx)
                                pev_payload_ptr: LLVMValueRef = LLVMBuildStructGEP2(builder, pev_enum_llvm, pev_address, 1, "enum.payload.ptr")
                                pev_value: mutable LLVMValueRef = zeroed
                                if structs.penum_field_type_count[pev_slot_index] > 1.usize():
                                    pev_tuple: LLVMTypeRef = penum_field_tuple_type(pev_slot_index, structs, ctx)
                                    pev_loaded: LLVMValueRef = LLVMBuildLoad2(builder, pev_tuple, pev_payload_ptr, "enum.payload")
                                    pev_value <- LLVMBuildExtractValue(builder, pev_loaded, pev_match_offset.u32(), "enum.payload.field")
                                else:
                                    pev_value <- LLVMBuildLoad2(builder, llvm_type_of(pev_field_type, structs, ctx), pev_payload_ptr, "enum.payload.field")
                                return emit_conversion(pev_value, pev_field_type, expected, structs, ctx, builder) if expected.kind != TypeKind.Unmodeled and (expected.kind != pev_field_type.kind or expected.bits != pev_field_type.bits) else pev_value
            if expression is Expr.Field(darray_object, darray_field, darray_field_line):
                if true:
                    darray_type: mutable ValueType = darray_type_behind_expr(darray_object, local_scope, structs)
                    # The ordinary expression typer already resolves a darray field through
                    # references and generic-struct bindings. Use it as a fallback for the
                    # header accessor too; this keeps `map.entries.count` aligned with the
                    # working `map.entries.reserve()` path.
                    darray_type <- expression_type(darray_object, local_scope, fns, structs, generics) if darray_type.kind != TypeKind.DArray
                    # `darray_read_slot`, not `darray_address_of_expr`: a header read also has
                    # to work on a CALL RESULT (`easm_parse_params(line).count`), which has no
                    # address and must be spilled. Reads only — a mutator still needs the real
                    # address or its write lands in the spilled copy.
                    if darray_type.kind == TypeKind.DArray and darray_field == "capacity":
                        if darray_read_slot(darray_object, darray_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is darray_cap_slot:
                            capacity_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, darray_llvm_type(structs, ctx), darray_cap_slot, 2, "darray.capacity.ptr")
                            return LLVMBuildLoad2(builder, LLVMInt64TypeInContext(ctx), capacity_pointer, "darray.capacity")
                    if darray_type.kind == TypeKind.DArray and darray_field == "count":
                        if darray_read_slot(darray_object, darray_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is darray_slot:
                            count_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, darray_llvm_type(structs, ctx), darray_slot, 1, "darray.count.ptr")
                            return LLVMBuildLoad2(builder, LLVMInt64TypeInContext(ctx), count_pointer, "darray.count")
                    # `xs.items` — the header's ELEMENT-STORAGE pointer (field 0), which the
                    # std asserts against null before indexing (`assert s.indices.items != null`).
                    # Without it the whole assert declined and took its function with it.
                    if darray_type.kind == TypeKind.DArray and darray_field == "items":
                        if darray_read_slot(darray_object, darray_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is darray_items_slot:
                            items_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, darray_llvm_type(structs, ctx), darray_items_slot, 0, "darray.items.ptr")
                            return LLVMBuildLoad2(builder, LLVMPointerTypeInContext(ctx, 0), items_pointer, "darray.items")

            # `s.len` on a CSTR — a bare pointer has no length field, so stage0 CALLS
            # `ctx_strlen(s)`. Emitted like the `s[i]` -> `ctx_string_index` lowering
            # alongside it: the pointer is passed by value and the result is an i64.
            if expression is Expr.Field(cstr_len_object, cstr_len_field, cstr_len_line):
                if cstr_len_field == "len" and expression_type(cstr_len_object, local_scope, fns, structs, generics).kind == TypeKind.CStr:
                    cstr_len_recv_type: ValueType = ValueType{kind: TypeKind.CStr, bits: 0}
                    if emit_expression(cstr_len_object, cstr_len_recv_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is cstr_len_recv:
                        cstr_len_param_types: mutable darray[LLVMTypeRef] = [LLVMPointerTypeInContext(ctx, 0)]
                        cstr_len_param_pointer: void& = (&cstr_len_param_types[0]).cast[void&] can Unsafe.PointerCast
                        cstr_len_fn_type: LLVMTypeRef = LLVMFunctionType(LLVMInt64TypeInContext(ctx), cstr_len_param_pointer, 1, 0)
                        cstr_len_fn: LLVMValueRef = declare_or_get_named(m, "ctx_strlen", cstr_len_fn_type)
                        cstr_len_args: mutable darray[LLVMValueRef] = [cstr_len_recv]
                        cstr_len_args_pointer: void& = (&cstr_len_args[0]).cast[void&] can Unsafe.PointerCast
                        cstr_len_value: LLVMValueRef = LLVMBuildCall2(builder, cstr_len_fn_type, cstr_len_fn, cstr_len_args_pointer, 1, "cstr.len")
                        cstr_len_result: ValueType = ValueType{kind: TypeKind.Signed, bits: 64}
                        return emit_conversion(cstr_len_value, cstr_len_result, expected, structs, ctx, builder) if expected.kind != TypeKind.Unmodeled and (expected.kind != cstr_len_result.kind or expected.bits != cstr_len_result.bits) else cstr_len_value
                    return null
            # `s.len` on an sview — field 1 of `{ptr, i64}`. (stage0 exposes `.len`, not
            # `.count`, on a string view.)
            if expression is Expr.Field(sview_object, sview_field, sview_field_line):
                sview_recv_type: ValueType = expression_type(sview_object, local_scope, fns, structs, generics)
                if sview_recv_type.kind == TypeKind.SView and (sview_field == "data" or sview_field == "len"):
                    if emit_expression(sview_object, sview_recv_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is sview_value:
                        if sview_field == "data":
                            return LLVMBuildExtractValue(builder, sview_value, 0, "sview.data")
                        return LLVMBuildExtractValue(builder, sview_value, 1, "sview.len")
            handled <- false
            return null
