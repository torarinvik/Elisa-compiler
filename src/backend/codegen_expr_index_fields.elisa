# Stage1 backend — `emit_expression`: indexing, struct construction and field/scope access.
# A group of the expression emitter's branches, called from codegen_expression.elisa.
# `handled` is set TRUE on entry and cleared only if no branch here matched, so a
# branch that DECLINES (returns null) still stops the dispatch — exactly as it did
# when every branch shared one function body.

extend Backend:
    private:
        def emit_expression_index_fields(expression: Expr, expected: ValueType, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef, handled: mutable bool&) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            # This group owns aggregate/index/field forms. Match/value-if/dict forms
            # are handled by codegen_expr_match_aggregates.elisa. Do not claim unrelated
            # expressions: the dispatcher relies on `handled == false` to continue to
            # calls and the other expression groups.
            index_field_expression: mutable bool = false
            if expression is Expr.Field(_, _, _):
                index_field_expression <- true
            if expression is Expr.Index(_, _, _):
                index_field_expression <- true
            if expression is Expr.SetLit(_, _):
                index_field_expression <- true
            if expression is Expr.Array(_, _):
                index_field_expression <- true
            if expression is Expr.Tuple(_, _):
                index_field_expression <- true
            if expression is Expr.Slice(_, _, _, _):
                index_field_expression <- true
            if expression is Expr.RecordUpdate(_, _, _):
                index_field_expression <- true
            if expression is Expr.Construct(_, _, _):
                index_field_expression <- true
            # A generic function used as a VALUE (`f: fn(A) -> R = generic[A]`) is
            # represented by IndexN, but it is not an indexing operation. Claim this
            # narrow shape here so the function-reference branch below can instantiate
            # it; ordinary generic calls remain owned by the call emitter because their
            # expected type is the call result, not TypeKind.Fn.
            if expression is Expr.IndexN(generic_value_head, generic_value_arguments, generic_value_line):
                if expected.kind == TypeKind.Fn:
                    if generic_value_head is Expr.Ident(generic_value_name, generic_value_name_line):
                        if generic_index_of(generics, generic_value_name) >= 0:
                            index_field_expression <- true
            if not index_field_expression:
                handled <- false
                return null
            handled <- true
            # `items[slot].field` where `items` is a reference to a struct element type.
            # This shape must be handled before the generic index branches below: those branches
            # intentionally reserve scalar references for pointer reads, while a struct reference
            # needs an element address followed by a field GEP. Keeping the complete read here
            # also makes it independent of the call-expression group, which is important because
            # this dispatcher owns the outer `Expr.Field` node.
            match expression:
                Expr.Field(pointer_field_object, pointer_field_name, pointer_field_line):
                    match pointer_field_object:
                        Expr.Index(pointer_field_container, pointer_field_index, pointer_field_index_line):
                            pointer_field_container_type: ValueType = expression_type(pointer_field_container, local_scope, fns, structs, generics)
                            if pointer_field_container_type.kind == TypeKind.Ref:
                                pointer_field_element_type: ValueType = ref_target_of(pointer_field_container_type, structs)
                                if pointer_field_element_type.kind == TypeKind.Struct:
                                    pointer_field_position: i64 = field_index_of(structs, pointer_field_element_type.bits.usize(), pointer_field_name)
                                    if pointer_field_position >= 0:
                                        if emit_expression(pointer_field_container, pointer_field_container_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is pointer_field_base:
                                            if emit_expression(pointer_field_index, ValueType{kind: TypeKind.Signed, bits: 64}, local_scope, fns, structs, generics, runtime, m, ctx, builder) is pointer_field_index_value:
                                                pointer_field_indices: mutable darray[LLVMValueRef] = [pointer_field_index_value]
                                                pointer_field_indices_pointer: void& = (&pointer_field_indices[0]).cast[void&] can Unsafe.PointerCast
                                                pointer_field_element_llvm: LLVMTypeRef = llvm_type_of(pointer_field_element_type, structs, ctx)
                                                pointer_field_element_address: LLVMValueRef = LLVMBuildGEP2(builder, pointer_field_element_llvm, pointer_field_base, pointer_field_indices_pointer, 1, "pointer.field.elem")
                                                pointer_field_type: ValueType = structs.field_types[structs.field_start[pointer_field_element_type.bits.usize()] + pointer_field_position.usize()]
                                                pointer_field_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, pointer_field_element_llvm, pointer_field_element_address, pointer_field_position.u32(), "pointer.field.ptr")
                                                pointer_field_value: LLVMValueRef = LLVMBuildLoad2(builder, llvm_type_of(pointer_field_type, structs, ctx), pointer_field_pointer, "pointer.field.value")
                                                return emit_conversion(pointer_field_value, pointer_field_type, expected, structs, ctx, builder) if expected.kind != TypeKind.Unmodeled and (expected.kind != pointer_field_type.kind or expected.bits != pointer_field_type.bits) else pointer_field_value
                                            return null
                        _:
                            pass
                _:
                    pass
            # A field of a struct-valued rvalue (`make_token().kind`) has no local slot
            # for the ordinary place resolver to address. Spill the returned aggregate,
            # then read the selected field from that temporary. This is still zero-cost
            # after the normal LLVM mem2reg/SROA passes, and is required by the compiler's
            # own parser helpers (`peek` reads `parser.cursor().kind`). Keep it here, before
            # the specialized index/field paths below, because this dispatcher owns all
            # `Expr.Field` nodes and can otherwise decline the expression before the call
            # emitter gets a chance to see it.
            match expression:
                Expr.Field(rvalue_struct_object, rvalue_struct_field, rvalue_struct_line):
                    rvalue_struct_is_temporary: mutable bool = false
                    match rvalue_struct_object:
                        Expr.Call(_, _, _, _) | Expr.Index(_, _, _) | Expr.Construct(_, _, _) | Expr.RecordUpdate(_, _, _):
                            rvalue_struct_is_temporary <- true
                        _:
                            pass
                    # `v.value` where `v: Box?` is a VALUE optional PROVEN non-null by an
                    # early-return guard (`return 11 if v == null`, the smart-cast shape). stage0
                    # narrows there and reads the field off the payload; stage1 declined the
                    # whole function ("field expression"). Only a narrowed path reads: the
                    # proof set is what makes extracting the payload without a tag test sound.
                    if not rvalue_struct_is_temporary:
                        narrowed_opt_type: ValueType = expression_type(rvalue_struct_object, local_scope, fns, structs, generics)
                        if narrowed_opt_type.kind == TypeKind.Optional and path_is_narrowed(rvalue_struct_object, structs):
                            narrowed_payload_type: ValueType = optional_payload_of(narrowed_opt_type, structs)
                            if narrowed_payload_type.kind == TypeKind.Struct:
                                narrowed_slot: usize = narrowed_payload_type.bits.usize()
                                narrowed_position: i64 = field_index_of(structs, narrowed_slot, rvalue_struct_field)
                                if narrowed_position >= 0:
                                    if emit_expression(rvalue_struct_object, narrowed_opt_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is narrowed_opt_value:
                                        narrowed_payload: LLVMValueRef = optional_payload_value_of(narrowed_opt_value, narrowed_opt_type, structs, ctx, builder)
                                        narrowed_llvm: LLVMTypeRef = llvm_type_of(narrowed_payload_type, structs, ctx)
                                        narrowed_temp: LLVMValueRef = LLVMBuildAlloca(builder, narrowed_llvm, "field.opt.spill")
                                        _ = LLVMBuildStore(builder, narrowed_payload, narrowed_temp)
                                        narrowed_field_type: ValueType = structs.field_types[structs.field_start[narrowed_slot] + narrowed_position.usize()]
                                        narrowed_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, narrowed_llvm, narrowed_temp, narrowed_position.u32(), "field.ptr")
                                        narrowed_loaded: LLVMValueRef = LLVMBuildLoad2(builder, llvm_type_of(narrowed_field_type, structs, ctx), narrowed_pointer, "field")
                                        return emit_conversion(narrowed_loaded, narrowed_field_type, expected, structs, ctx, builder) if expected.kind != TypeKind.Unmodeled and (expected.kind != narrowed_field_type.kind or expected.bits != narrowed_field_type.bits) else narrowed_loaded
                                    return null
                    if rvalue_struct_is_temporary:
                        rvalue_struct_type: ValueType = expression_type(rvalue_struct_object, local_scope, fns, structs, generics)
                        if rvalue_struct_type.kind == TypeKind.Struct:
                            rvalue_struct_slot: usize = rvalue_struct_type.bits.usize()
                            rvalue_struct_position: i64 = field_index_of(structs, rvalue_struct_slot, rvalue_struct_field)
                            if rvalue_struct_position >= 0:
                                if emit_expression(rvalue_struct_object, rvalue_struct_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is rvalue_struct_value:
                                    rvalue_struct_llvm: LLVMTypeRef = llvm_type_of(rvalue_struct_type, structs, ctx)
                                    rvalue_struct_temp: LLVMValueRef = LLVMBuildAlloca(builder, rvalue_struct_llvm, "field.recv.spill")
                                    _ = LLVMBuildStore(builder, rvalue_struct_value, rvalue_struct_temp)
                                    rvalue_struct_field_type: ValueType = structs.field_types[structs.field_start[rvalue_struct_slot] + rvalue_struct_position.usize()]
                                    rvalue_struct_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, rvalue_struct_llvm, rvalue_struct_temp, rvalue_struct_position.u32(), "field.ptr")
                                    rvalue_struct_loaded: LLVMValueRef = LLVMBuildLoad2(builder, llvm_type_of(rvalue_struct_field_type, structs, ctx), rvalue_struct_pointer, "field")
                                    return emit_conversion(rvalue_struct_loaded, rvalue_struct_field_type, expected, structs, ctx, builder) if expected.kind != TypeKind.Unmodeled and (expected.kind != rvalue_struct_field_type.kind or expected.bits != rvalue_struct_field_type.bits) else rvalue_struct_loaded
                                return null
                _:
                    pass
            # `table.values` — a NodeTable's backing view. NodeTable is ERASED to that
            # view, so this is the identity on a view-typed receiver. Placed first for the
            # same reason as the store-ordinal branch below.
            # `frozen.count` — the number of nodes in a packed store. Same
            # `ctx_packed_store_count(state)` that node_table_fill emits.
            match expression:
                Expr.Field(ps_count_object, ps_count_field, ps_count_line):
                    if ps_count_field == "count":
                        ps_count_recv: ValueType = expression_type(ps_count_object, local_scope, fns, structs, generics)
                        if ps_count_recv.kind == TypeKind.PackedStore and runtime.packed_mode != 2:
                            if emit_expression(ps_count_object, ps_count_recv, local_scope, fns, structs, generics, runtime, m, ctx, builder) is ps_count_store:
                                ps_count_state: LLVMValueRef = LLVMBuildExtractValue(builder, ps_count_store, 2, "packed.store.count.state")
                                ps_count_params: mutable darray[LLVMTypeRef] = [LLVMPointerTypeInContext(ctx, 0)]
                                ps_count_params_ptr: void& = (&ps_count_params[0]).cast[void&] can Unsafe.PointerCast
                                ps_count_type: LLVMTypeRef = LLVMFunctionType(LLVMInt64TypeInContext(ctx), ps_count_params_ptr, 1, 0)
                                ps_count_fn: LLVMValueRef = declare_or_get_named(m, "ctx_packed_store_count", ps_count_type)
                                ps_count_args: mutable darray[LLVMValueRef] = [ps_count_state]
                                ps_count_args_ptr: void& = (&ps_count_args[0]).cast[void&] can Unsafe.PointerCast
                                ps_count_value: LLVMValueRef = LLVMBuildCall2(builder, ps_count_type, ps_count_fn, ps_count_args_ptr, 1, "packed.store.count")
                                ps_count_wanted: ValueType = ValueType{kind: TypeKind.Signed, bits: 64}
                                return emit_conversion(ps_count_value, ps_count_wanted, expected, structs, ctx, builder) if expected.kind != TypeKind.Unmodeled and (expected.kind != ps_count_wanted.kind or expected.bits != ps_count_wanted.bits) else ps_count_value
                            return null
                _:
                    pass
            match expression:
                Expr.Field(nt_values_object, nt_values_field, nt_values_line):
                    if nt_values_field == "values":
                        nt_values_type: ValueType = expression_type(nt_values_object, local_scope, fns, structs, generics)
                        if nt_values_type.kind == TypeKind.View:
                            return emit_expression(nt_values_object, nt_values_type, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                _:
                    pass
            # `frozen[2]` — indexing a packed STORE by ORDINAL. stage0 lowers it to
            # `ctx_packed_store_index_at(state, i64 ordinal)`, mapping an allocation ordinal
            # to the node HANDLE at that position (i32). The helper reads `state.indices` off
            # a PackedStoreState, so it serves the variant-sparse and index profiles; the AoS
            # store is a DIFFERENT struct (`PackedAoSStore`) with no such helper, so that
            # profile declines rather than type-confusing the state.
            #
            # Placed FIRST deliberately. Four later branches also match `Expr.Index`, and one
            # of them claims a PackedStore receiver and returns null -- which silently ate
            # two earlier attempts at this and a decline marker with them.
            match expression:
                Expr.Index(store_ix_object, store_ix_expression, store_ix_line):
                    # C's `sizeof(T)` is emitted by the translator as `size_of[T]`.
                    # The bracket is a type argument, not an array subscript; lower
                    # it directly through LLVM's target DataLayout so structs and
                    # opaque aliases get their real ABI size.
                    if store_ix_object is Expr.Ident(store_ix_size_name, store_ix_size_line):
                        if store_ix_size_name == "size_of":
                            store_ix_size_type: ValueType = annotation_value_type(store_ix_expression, structs)
                            null return if store_ix_size_type.kind == TypeKind.Unmodeled
                            store_ix_size_value: LLVMValueRef = LLVMSizeOf(llvm_type_of(store_ix_size_type, structs, ctx))
                            store_ix_size_result: ValueType = ValueType{kind: TypeKind.Unsigned, bits: 64}
                            return emit_conversion(store_ix_size_value, store_ix_size_result, expected, structs, ctx, builder) if expected.kind != TypeKind.Unmodeled and (expected.kind != store_ix_size_result.kind or expected.bits != store_ix_size_result.bits) else store_ix_size_value
                    store_ix_type: ValueType = expression_type(store_ix_object, local_scope, fns, structs, generics)
                    # An ORDINAL and a NodeKey are indistinguishable by type -- NodeKey is erased
                    # to i32 -- so the two spellings are told apart by the SUBSCRIPT EXPRESSION.
                    # A key is already a HANDLE and must be used directly; only an ordinal goes
                    # through `ctx_packed_store_index_at`. stage0 draws exactly this line
                    # (`frozen[2]` -> index_at, `frozen[key]` -> the store read straight away),
                    # and applying index_at to a key silently reads the WRONG NODE.
                    #
                    # A LITERAL is an ordinal; an i32-typed expression is a key. Anything else
                    # (a runtime usize ordinal, say) matches neither and declines rather than
                    # guessing -- there is no spelling of it in stage0's own packed programs.
                    store_ix_is_ordinal: bool = match store_ix_expression:
                        Expr.IntLit(_, _): true
                        _: false
                    store_ix_key_type: ValueType = expression_type(store_ix_expression, local_scope, fns, structs, generics)
                    store_ix_is_key: bool = store_ix_key_type.kind == TypeKind.Signed and store_ix_key_type.bits == 32
                    if store_ix_type.kind == TypeKind.PackedStore and runtime.packed_mode != 2 and store_ix_is_key and not store_ix_is_ordinal:
                        return emit_expression(store_ix_expression, ValueType{kind: TypeKind.Signed, bits: 32}, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                    if store_ix_type.kind == TypeKind.PackedStore and runtime.packed_mode != 2 and store_ix_is_ordinal:
                        if emit_expression(store_ix_object, store_ix_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is store_ix_value:
                            store_ix_state: LLVMValueRef = LLVMBuildExtractValue(builder, store_ix_value, 2, "packed.store.index.state")
                            if emit_expression(store_ix_expression, ValueType{kind: TypeKind.Unsigned, bits: 64}, local_scope, fns, structs, generics, runtime, m, ctx, builder) is store_ix_ordinal:
                                store_ix_params: mutable darray[LLVMTypeRef] = [LLVMPointerTypeInContext(ctx, 0), LLVMInt64TypeInContext(ctx)]
                                store_ix_params_ptr: void& = (&store_ix_params[0]).cast[void&] can Unsafe.PointerCast
                                store_ix_fn_type: LLVMTypeRef = LLVMFunctionType(LLVMInt32TypeInContext(ctx), store_ix_params_ptr, 2, 0)
                                store_ix_fn: LLVMValueRef = declare_or_get_named(m, "ctx_packed_store_index_at", store_ix_fn_type)
                                store_ix_args: mutable darray[LLVMValueRef] = [store_ix_state, store_ix_ordinal]
                                store_ix_args_ptr: void& = (&store_ix_args[0]).cast[void&] can Unsafe.PointerCast
                                return LLVMBuildCall2(builder, store_ix_fn_type, store_ix_fn, store_ix_args_ptr, 2, "packed.store.index")
                            return null
                        return null
                _:
                    pass
            # `f: fn(A) -> R = generic_fn[A, R]` — a GENERIC FUNCTION REFERENCE used as a VALUE,
            # not called. The bracket makes it an Index/IndexN, so it fell to the indexing paths
            # below and declined; the bare-Ident form already passes its raw handle at a `fn`
            # expectation (codegen_expr_idents_binary.elisa), and this is that case with explicit
            # type arguments. Instantiating here also DECLARES the instantiation, which is what a
            # later indirect call through the local needs. pool_submit1's body opens with exactly
            # this shape (`ctx_task_from_raw[R, Pending]`).
            if expected.kind == TypeKind.Fn:
                match expression:
                    Expr.Index(gref_head, gref_argument, gref_line):
                        match gref_head:
                            Expr.Ident(gref_name, gref_name_line):
                                if generic_index_of(generics, gref_name) >= 0:
                                    gref_args: mutable darray[ValueType] = [annotation_value_type(gref_argument, structs)]
                                    return instantiate_generic(gref_name, gref_args, generics, structs, m, ctx)
                            _:
                                pass
                    _:
                        pass
                match expression:
                    Expr.IndexN(grefn_head, grefn_arguments, grefn_line):
                        match grefn_head:
                            Expr.Ident(grefn_name, grefn_name_line):
                                if generic_index_of(generics, grefn_name) >= 0:
                                    # An UNRESOLVED type argument is kept, not rejected: it may name a
                                    # PHANTOM type-state, and `Pending` in `ctx_task_from_raw[R, Pending]`
                                    # is declared nowhere at all. instantiate_generic_at still declines if
                                    # a PARAMETER's type comes out Unmodeled, so a genuinely bad argument
                                    # fails one step later — the same trade instantiate_generic_struct
                                    # makes for `MutexGuard[Held]`.
                                    grefn_args: mutable darray[ValueType] = []
                                    grefn_args.extend([annotation_value_type(grefn_argument, structs) for grefn_argument in grefn_arguments])
                                    return instantiate_generic(grefn_name, grefn_args, generics, structs, m, ctx)
                            _:
                                pass
                    _:
                        pass
            # `{}` may also parse as an empty set literal; same zero-aggregate handling.
            return emit_expression_aggregate_literals(expression, expected, local_scope, fns, structs, generics, runtime, m, ctx, builder, handled)

include "./codegen_expr_aggregates.elisa"
include "./codegen_expr_cast.elisa"
include "./codegen_expr_slice.elisa"
include "./codegen_expr_index_read.elisa"
include "./codegen_expr_construct.elisa"
include "./codegen_expr_field_read.elisa"
