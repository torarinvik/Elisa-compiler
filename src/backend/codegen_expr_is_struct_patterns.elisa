# Stage1 backend — the STRUCT-SHAPED and CALL-SHAPED right-hand sides of `v is PATTERN`:
# `tok is Token(kind: .INTEGER, value: v)` (which the parser hands over as a labelled CALL,
# not a Construct), the Construct spelling of the same test, and the payload-enum variant
# tests with their nested sub-patterns. Called from codegen_expr_optional_binary.elisa, which
# tries the simpler right-hand sides first; `matched` says whether one of these claimed the
# shape, since a claimed-but-declined branch also returns null.
# Part of `module Backend` (see codegen.elisa).

extend Backend:
    private:
        def emit_is_struct_and_call_patterns(is_left: Expr, is_right: Expr, is_line: Ast::Pos, expected: ValueType, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef, matched: mutable bool&) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            matched <- true
            # `tok is Token(kind: .INTEGER, value: value)` — the PARENTHESISED struct
            # pattern parses as a labelled CALL, not Expr.Construct, so the path below
            # never saw it. Normalise and re-enter so one implementation serves both
            # spellings. NESTED field patterns are normalised too (see below): inside a
            # paren pattern the nested `Span(start: start)` is ALSO a call.
            if is_right is Expr.Call(sp_probe_callee, sp_probe_arguments, sp_probe_names, sp_probe_line):
                sp_normalized: Expr = normalized_struct_pattern(is_right, structs)
                if sp_normalized is Expr.Construct(sp_norm_type, sp_norm_fields, sp_norm_line):
                    return emit_expression((Expr.Binary(is_left, TokenKind.Is, sp_normalized, is_line)), expected, local_scope, fns, structs, generics, runtime, m, ctx, builder)
            if is_right is Expr.Construct(sc_type_expr, sc_fields, sc_construct_line):
                sc_struct_type: ValueType = annotation_value_type(sc_type_expr, structs)
                null return if sc_struct_type.kind != TypeKind.Struct
                sc_scrut_type: ValueType = expression_type(is_left, local_scope, fns, structs, generics)
                null return if sc_scrut_type.kind != TypeKind.Struct or sc_scrut_type.bits != sc_struct_type.bits
                sc_slot: usize = sc_struct_type.bits.usize()
                sc_declined: mutable bool = false
                sc_positions: mutable darray[i64] = []
                sc_names: mutable darray[sview] = []
                # A field whose pattern value is a LITERAL or a const-enum shorthand
                # (`Token(kind: .INTEGER)`) is a TEST, not a binding: the arm only
                # matches when the field equals it. Previously every non-Ident field
                # declined, so the whole named-field form was unusable.
                sc_test_positions: mutable darray[i64] = []
                sc_test_values: mutable darray[Expr] = []
                # ONE level of nesting (`span: Span(start: start)`): the nested
                # pattern's own fields must all be bare Idents, which is the shape the
                # corpus uses. Deeper nesting, or a nested pattern that itself TESTS,
                # declines rather than matching without checking it.
                sc_nest_outer: mutable darray[i64] = []
                sc_nest_inner: mutable darray[i64] = []
                sc_nest_names: mutable darray[sview] = []
                sc_field_order: mutable u32 = 0
                for sc_raw_field in sc_fields |sc_declined, sc_positions, sc_names, sc_test_positions, sc_test_values, sc_nest_outer, sc_nest_inner, sc_nest_names, sc_field_order, sc_slot, structs|:
                    # A nested pattern may itself be the paren spelling.
                    sc_field: Ast::FieldInit = Ast::FieldInit{name: sc_raw_field.name, value: normalized_struct_pattern(sc_raw_field.value, structs)}
                    sc_position: mutable i64 = field_index_of(structs, sc_slot, sc_field.name)
                    sc_position <- sc_field_order.i64() if sc_field.name == ""
                    sc_field_order <- sc_field_order + 1
                    if sc_position < 0:
                        sc_declined <- true
                    elif sc_field.value is Expr.Ident(sc_bind_name, sc_bind_line):
                        sc_positions.push(sc_position)
                        sc_names.push(sc_bind_name)
                    elif sc_field.value is Expr.Construct(sc_nest_type_expr, sc_nest_fields, sc_nest_line):
                        sc_nest_type: ValueType = copied_type(structs.field_types[structs.field_start[sc_slot] + sc_position.usize()])
                        if sc_nest_type.kind != TypeKind.Struct:
                            sc_declined <- true
                        else:
                            sc_nest_slot: usize = sc_nest_type.bits.usize()
                            for sc_nest_field in sc_nest_fields |sc_declined, sc_nest_outer, sc_nest_inner, sc_nest_names, sc_position, sc_nest_slot, structs|:
                                sc_inner_position: i64 = field_index_of(structs, sc_nest_slot, sc_nest_field.name)
                                if sc_inner_position < 0:
                                    sc_declined <- true
                                elif sc_nest_field.value is Expr.Ident(sc_inner_name, sc_inner_line):
                                    sc_nest_outer.push(sc_position)
                                    sc_nest_inner.push(sc_inner_position)
                                    sc_nest_names.push(sc_inner_name)
                                else:
                                    sc_declined <- true
                    else:
                        sc_test_positions.push(sc_position)
                        sc_test_values.push(resolved_shorthand_member(sc_field.value, structs))
                null return if sc_declined
                if emit_expression(is_left, sc_scrut_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is sc_struct_value:
                    for sc_bind_index in 0..<sc_positions.count |sc_positions, sc_names, sc_struct_value, sc_slot, structs, local_scope, ctx, builder|:
                        sc_field_type: ValueType = structs.field_types[structs.field_start[sc_slot] + sc_positions[sc_bind_index].usize()]
                        sc_field_value: LLVMValueRef = LLVMBuildExtractValue(builder, sc_struct_value, sc_positions[sc_bind_index].u32(), "is.struct.field")
                        sc_bind_slot: LLVMValueRef = bind_is_slot(local_scope, structs, sc_names[sc_bind_index], sc_field_type, llvm_type_of(sc_field_type, structs, ctx), builder)
                        _ = LLVMBuildStore(builder, sc_field_value, sc_bind_slot)
                    for sc_nest_index in 0..<sc_nest_outer.count |sc_nest_outer, sc_nest_inner, sc_nest_names, sc_struct_value, sc_slot, structs, local_scope, ctx, builder|:
                        sc_outer_type: ValueType = copied_type(structs.field_types[structs.field_start[sc_slot] + sc_nest_outer[sc_nest_index].usize()])
                        sc_outer_value: LLVMValueRef = LLVMBuildExtractValue(builder, sc_struct_value, sc_nest_outer[sc_nest_index].u32(), "is.struct.nest")
                        sc_inner_type: ValueType = copied_type(structs.field_types[structs.field_start[sc_outer_type.bits.usize()] + sc_nest_inner[sc_nest_index].usize()])
                        sc_inner_value: LLVMValueRef = LLVMBuildExtractValue(builder, sc_outer_value, sc_nest_inner[sc_nest_index].u32(), "is.struct.nest.field")
                        sc_inner_slot: LLVMValueRef = bind_is_slot(local_scope, structs, sc_nest_names[sc_nest_index], sc_inner_type, llvm_type_of(sc_inner_type, structs, ctx), builder)
                        _ = LLVMBuildStore(builder, sc_inner_value, sc_inner_slot)
                    # No TESTS means the pattern only destructures, and the scrutinee's
                    # static type already proves the match — a constant true, as before.
                    sc_hit: mutable LLVMValueRef = LLVMConstInt(LLVMInt1TypeInContext(ctx), 1, 0)
                    sc_test_declined: mutable bool = false
                    for sc_test_index in 0..<sc_test_positions.count |sc_hit, sc_test_declined, sc_test_positions, sc_test_values, sc_struct_value, sc_slot, local_scope, fns, structs, generics, runtime, m, ctx, builder|:
                        sc_test_type: ValueType = copied_type(structs.field_types[structs.field_start[sc_slot] + sc_test_positions[sc_test_index].usize()])
                        if not is_numeric_type(sc_test_type) and sc_test_type.kind != TypeKind.Bool:
                            sc_test_declined <- true
                        else:
                            sc_test_field: LLVMValueRef = LLVMBuildExtractValue(builder, sc_struct_value, sc_test_positions[sc_test_index].u32(), "is.struct.test.field")
                            if emit_expression(sc_test_values[sc_test_index], sc_test_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is sc_test_value:
                                sc_test_cmp: LLVMValueRef = LLVMBuildICmp(builder, 32, sc_test_field, sc_test_value, "is.struct.test.eq")
                                sc_hit <- LLVMBuildAnd(builder, sc_hit, sc_test_cmp, "is.struct.test.and")
                            else:
                                sc_test_declined <- true
                    null return if sc_test_declined
                    return sc_hit
                return null
            # `e is Ast::Expr.Invalid` / `is Ast::Expr.Absent` — a PAYLOADLESS PACKED
            # variant test. The packed narrowing below only matches the CALL form
            # (`Expr.Ident(a, b)`), so a payloadless variant fell through to the
            # payload-enum and const-enum forms above, matched neither, and declined.
            # The semantic layer tests Absent/Invalid/Refinement this way throughout.
            #
            # No binds: there is no payload to name, so this is purely the tag compare
            # the match emitter does.
            if is_right is Expr.Field(pkf_head, pkf_variant, pkf_field_line):
                pkf_enum_name: sview = enum_head_name(pkf_head)
                if pkf_enum_name != "":
                    pkf_enum_index: i64 = packed_index_of(structs, pkf_enum_name)
                    if pkf_enum_index >= 0:
                        pkf_scrut_type: ValueType = expression_type(is_left, local_scope, fns, structs, generics)
                        if pkf_scrut_type.kind == TypeKind.PackedEnum and runtime.packed_mode == 2:
                            pkf_ordinal: i64 = packed_variant_index_of_parts(pkf_enum_name, pkf_variant, structs)
                            null return if pkf_ordinal < 0
                            pkf_root: i64 = packed_root_index_of(structs, pkf_scrut_type.bits.i64())
                            null return if runtime.active_store_enum != pkf_root
                            null return if not packed_is_ast_root(structs, pkf_root) and not packed_is_dynamic_aos_enum(structs, pkf_scrut_type.bits.i64())
                            if emit_expression(is_left, pkf_scrut_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is pkf_index_value:
                                pkf_state: LLVMValueRef = LLVMBuildExtractValue(builder, runtime.active_store, 2, "is.pkf.state")
                                pkf_index64: LLVMValueRef = LLVMBuildZExt(builder, pkf_index_value, LLVMInt64TypeInContext(ctx), "is.pkf.index")
                                pkf_record_args: mutable darray[LLVMValueRef] = [pkf_state, pkf_index64]
                                pkf_record_pointer: void& = (&pkf_record_args[0]).cast[void&] can Unsafe.PointerCast
                                pkf_record: LLVMValueRef = LLVMBuildCall2(builder, runtime.packed_read_word_type, runtime.packed_read_word, pkf_record_pointer, 2, "is.pkf.record")
                                pkf_row_type: LLVMTypeRef = packed_row_llvm_type(structs, pkf_scrut_type.bits.i64(), ctx)
                                pkf_tag_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, pkf_row_type, pkf_record, 0, "is.pkf.tag.ptr")
                                pkf_tag: LLVMValueRef = LLVMBuildLoad2(builder, LLVMInt32TypeInContext(ctx), pkf_tag_pointer, "is.pkf.tag")
                                return LLVMBuildICmp(builder, 32, pkf_tag, LLVMConstInt(LLVMInt32TypeInContext(ctx), pkf_ordinal.u64(), 0), "is.pkf.eq")
                            return null
            # `s is Shape.Rect(w, h)` — payload-enum variant NARROWING. Yields the
            # tag-equals-ordinal test as the bool AND binds each payload field to its
            # name (unconditionally, like the optional case: the frontend proves the
            # names are only read where the tag matches). The RHS parses as a
            # constructor CALL `Enum.Variant(binders…)`.
            if is_right is Expr.Call(pe_callee, pe_args, pe_arg_names, pe_call_line):
                if pe_callee is Expr.Field(pe_head, pe_variant, pe_field_line):
                    pe_enum_name: sview = enum_head_name(pe_head)
                    if pe_enum_name != "":
                        # PACKED narrowing with binders: `x is Expr.Field(a, b, c)` /
                        # `x is Expr.IntLit(v, _)` on a packed AST node. Mirrors the match
                        # emitter's AoS read (record → tag idx0 for the bool, payload idx1,
                        # bind each field). AST-root layout + plain binder idents only.
                        pk_scrut: ValueType = expression_type(is_left, local_scope, fns, structs, generics)
                        pk_enum_idx: i64 = packed_index_of(structs, pe_enum_name)
                        if pk_scrut.kind == TypeKind.PackedEnum and pk_enum_idx >= 0:
                            pk_ordinal: i64 = packed_variant_index_of_parts(pe_enum_name, pe_variant, structs)
                            null return if pk_ordinal < 0
                            pk_root: i64 = packed_root_index_of(structs, pk_scrut.bits.i64())
                            null return if runtime.active_store_enum != pk_root
                            pk_dynamic_aos: bool = runtime.packed_mode == 2 and packed_is_dynamic_aos_enum(structs, pk_scrut.bits.i64())
                            null return if not packed_is_ast_root(structs, pk_root) and not pk_dynamic_aos
                            pk_local: i64 = packed_variant_local_index(structs, pk_enum_idx, pe_variant)
                            null return if pk_local < 0
                            pk_slot: usize = structs.packed_variant_start[pk_enum_idx.usize()] + pk_local.usize()
                            # Each arg is a plain binder (Ident) OR a NESTED payloadless-
                            # variant test (`Expr.If(a, b, Expr.Absent, c)` — the field must
                            # equal that sub-variant). Pre-validate every nested Field's
                            # ordinal here so the guarded branch below never bails mid-emit.
                            pk_args_ok: mutable bool = true
                            pk_has_nested: mutable bool = false
                            for pk_arg in pe_args |pk_args_ok, pk_has_nested, structs|:
                                if pk_arg is Expr.Ident(pk_arg_ident_name, pk_arg_ident_line):
                                    pk_args_ok <- pk_args_ok
                                elif pk_arg is Expr.Field(pk_arg_field_head, pk_arg_field_variant, pk_arg_field_line):
                                    pk_has_nested <- true
                                    if pk_arg_field_head is Expr.Ident(pk_arg_field_enum, pk_arg_field_enum_line):
                                        pk_args_ok <- false if packed_variant_index_of_parts(pk_arg_field_enum, pk_arg_field_variant, structs) < 0
                                    else:
                                        pk_args_ok <- false
                                # A nested variant that itself BINDS:
                                # `e is Expr.Call(Expr.Ident(owner, oline), args, names, line)`.
                                # Parsed as a Call whose callee is Field(Ident(enum), variant).
                                # The payloadless form above is Expr.Field; this is the same
                                # test plus binds for the sub-node's own fields.
                                elif pk_arg is Expr.Call(pk_ac_callee, pk_ac_args, pk_ac_names, pk_ac_line):
                                    pk_has_nested <- true
                                    if pk_ac_callee is Expr.Field(pk_ac_head, pk_ac_variant, pk_ac_fline):
                                        if pk_ac_head is Expr.Ident(pk_ac_enum, pk_ac_eline):
                                            pk_args_ok <- false if packed_variant_index_of_parts(pk_ac_enum, pk_ac_variant, structs) < 0
                                            # Only plain binder idents inside the nested
                                            # variant — a second level of nesting would need
                                            # its own guarded read and is not modeled.
                                            # Inner args may be plain binder idents OR one more
                                            # level of nested variant (handled at depth 2 below).
                                            for pk_ac_sub in pk_ac_args |pk_args_ok, structs|:
                                                if pk_ac_sub is Expr.Ident(pk_ac_sub_name, pk_ac_sub_line):
                                                    pk_args_ok <- pk_args_ok
                                                elif pk_ac_sub is Expr.Call(pk_ac_dc, pk_ac_da, pk_ac_dn, pk_ac_dl):
                                                    pk_args_ok <- false if not (pk_ac_dc is Expr.Field(pk_ac_dh, pk_ac_dv, pk_ac_dfl))
                                                else:
                                                    pk_args_ok <- false
                                        else:
                                            pk_args_ok <- false
                                    else:
                                        pk_args_ok <- false
                                else:
                                    pk_args_ok <- false
                            null return if not pk_args_ok
                            if emit_expression(is_left, pk_scrut, local_scope, fns, structs, generics, runtime, m, ctx, builder) is pk_index_value:
                                pk_state: LLVMValueRef = LLVMBuildExtractValue(builder, runtime.active_store, 2, "is.pk.state")
                                # Only the AoS profile hands back a ROW POINTER to GEP into.
                                # The variant-sparse (0) and index (1) profiles read one WORD
                                # at a time — the shape the STATEMENT-MATCH path has always
                                # used. This branch was gated to mode 2 outright, so
                                # `if tok is Tok.Ident(id):` on any NON-RECURSIVE packed enum
                                # (which selects mode 0) declined, while the `match` spelling
                                # of the same test compiled. Same lag between the two paths
                                # this file has hit before.
                                pk_is_aos: bool = runtime.packed_mode == 2
                                pk_index64: LLVMValueRef = LLVMBuildZExt(builder, pk_index_value, LLVMInt64TypeInContext(ctx), "is.pk.index")
                                pk_record: mutable LLVMValueRef = zeroed
                                pk_row_type: mutable LLVMTypeRef = zeroed
                                if pk_is_aos:
                                    pk_record_args: mutable darray[LLVMValueRef] = [pk_state, pk_index64]
                                    pk_record_pointer: void& = (&pk_record_args[0]).cast[void&] can Unsafe.PointerCast
                                    pk_record <- LLVMBuildCall2(builder, runtime.packed_read_word_type, runtime.packed_read_word, pk_record_pointer, 2, "is.pk.record")
                                    pk_row_type <- packed_row_llvm_type(structs, pk_scrut.bits.i64(), ctx)
                                # A NESTED sub-pattern reads a second row through the pointer
                                # below; without one there is nothing to read, so decline
                                # rather than emit against an absent record.
                                null return if pk_has_nested and not pk_is_aos
                                pk_commons: u32 = packed_aos_common_count(structs, pk_scrut.bits.i64()) if pk_dynamic_aos else structs.packed_common_counts[pk_scrut.bits.usize()]
                                pk_payload_hoisted: mutable LLVMValueRef = zeroed
                                if pe_args.count > 0 and structs.packed_has_payload[pk_slot]:
                                    pk_payload: ValueType = copied_type(structs.packed_payloads[pk_slot])
                                    null return if pk_payload.kind == TypeKind.Unmodeled
                                    # A MULTI-field payload is an aggregate the word readers
                                    # cannot produce (the match path declines it for the same
                                    # reason); keep that shape on the AoS path only.
                                    null return if pe_args.count > 1 and not pk_is_aos
                                    pk_payload_value: mutable LLVMValueRef = zeroed
                                    if pk_is_aos:
                                        # The AoS row is `{i32 tag, <commons x i64>, payload}`, so the
                                        # payload sits at `1 + commons` — index 1 IS the common when
                                        # one is declared, which made a binder read the SPAN. Same
                                        # off-by-commons the statement match had.
                                        if pk_dynamic_aos:
                                            if packed_dynamic_row_load_value(pk_payload, packed_variant_row_slots(structs, pk_slot), structs, pk_scrut.bits.i64(), pk_record, ctx, builder) is pk_dynamic_payload_value:
                                                pk_payload_value <- pk_dynamic_payload_value
                                            else:
                                                return null
                                        else:
                                            pk_payload_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, pk_row_type, pk_record, (1 + pk_commons), "is.pk.payload.ptr")
                                            # A payload that is ITSELF a node is an i32 handle in an i64
                                            # row word: load the word and narrow, rather than loading i32
                                            # straight out of an i64 slot.
                                            pk_payload_value <- LLVMBuildTrunc(builder, LLVMBuildLoad2(builder, LLVMInt64TypeInContext(ctx), pk_payload_pointer, "is.pk.payload.word"), LLVMInt32TypeInContext(ctx), "is.pk.handle") if pk_payload.kind == TypeKind.PackedEnum else LLVMBuildLoad2(builder, llvm_type_of(pk_payload, structs, ctx), pk_payload_pointer, "is.pk.payload")
                                    else:
                                        # Word 0 is the tag and words 1..commons are the commons,
                                        # so the first payload word is `1 + commons`. The INDEX
                                        # profile's reader leads with the ARENA.
                                        pk_word_args: mutable darray[LLVMValueRef] = [pk_index_value, pk_state, LLVMConstInt(LLVMInt64TypeInContext(ctx), (1 + pk_commons).u64(), 0)]
                                        if runtime.packed_mode == 1:
                                            pk_word_arena: LLVMValueRef = LLVMBuildExtractValue(builder, runtime.active_store, 0, "is.pk.arena")
                                            pk_word_args <- [pk_word_arena, pk_index_value, pk_state, LLVMConstInt(LLVMInt64TypeInContext(ctx), (1 + pk_commons).u64(), 0)]
                                        pk_word_pointer: void& = (&pk_word_args[0]).cast[void&] can Unsafe.PointerCast
                                        pk_payload_word: LLVMValueRef = LLVMBuildCall2(builder, runtime.packed_read_word_type, runtime.packed_read_word, pk_word_pointer, pk_word_args.count.u32(), "is.pk.payload.word")
                                        if pk_payload.kind == TypeKind.PackedEnum:
                                            pk_payload_value <- LLVMBuildTrunc(builder, pk_payload_word, LLVMInt32TypeInContext(ctx), "is.pk.handle")
                                        elif emit_conversion(pk_payload_word, ValueType{kind: TypeKind.Signed, bits: 64}, pk_payload, structs, ctx, builder) is pk_payload_converted:
                                            pk_payload_value <- pk_payload_converted
                                        else:
                                            return null
                                    pk_payload_hoisted <- pk_payload_value
                                    pk_field_start: usize = structs.packed_field_type_start[pk_slot]
                                    if pe_args.count == 1:
                                        if pe_args[0] is Expr.Ident(pk_single_name, pk_single_line):
                                            pk_single_slot: LLVMValueRef = bind_is_slot(local_scope, structs, pk_single_name, pk_payload, llvm_type_of(pk_payload, structs, ctx), builder)
                                            _ = LLVMBuildStore(builder, pk_payload_value, pk_single_slot)
                                    if pe_args.count > 1:
                                        for pk_bind_index in 0..<pe_args.count |pe_args, pk_field_start, pk_payload_value, structs, local_scope, ctx, builder|:
                                            if pe_args[pk_bind_index] is Expr.Ident(pk_multi_name, pk_multi_line):
                                                pk_multi_type: ValueType = copied_type(structs.packed_field_types[pk_field_start + pk_bind_index])
                                                pk_multi_field: LLVMValueRef = LLVMBuildExtractValue(builder, pk_payload_value, pk_bind_index.u32(), "is.pk.field")
                                                pk_multi_slot: LLVMValueRef = bind_is_slot(local_scope, structs, pk_multi_name, pk_multi_type, llvm_type_of(pk_multi_type, structs, ctx), builder)
                                                _ = LLVMBuildStore(builder, pk_multi_field, pk_multi_slot)
                                pk_tag: mutable LLVMValueRef = zeroed
                                if pk_is_aos:
                                    pk_tag_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, pk_row_type, pk_record, 0, "is.pk.tag.ptr")
                                    pk_tag <- LLVMBuildLoad2(builder, LLVMInt32TypeInContext(ctx), pk_tag_pointer, "is.pk.tag")
                                else:
                                    # The tag reader takes (STATE, index) while the word
                                    # reader takes (index, state, word) — the two runtime
                                    # helpers disagree on argument order, and passing the
                                    # word reader's order to the tag reader segfaulted.
                                    pk_tag_args: mutable darray[LLVMValueRef] = [pk_state, pk_index_value]
                                    pk_tag_pointer_args: void& = (&pk_tag_args[0]).cast[void&] can Unsafe.PointerCast
                                    pk_tag <- LLVMBuildCall2(builder, runtime.packed_read_tag_type, runtime.packed_read_tag, pk_tag_pointer_args, 2, "is.pk.tag")
                                pk_outer_hit: LLVMValueRef = LLVMBuildICmp(builder, 32, pk_tag, LLVMConstInt(LLVMInt32TypeInContext(ctx), pk_ordinal.u64(), 0), "is.pk.eq")
                                pk_no_nested: bool = not pk_has_nested
                                pk_outer_hit return if pk_no_nested
                                # NESTED field checks: a field's value is a packed HANDLE; read
                                # its tag ONLY when the outer tag matched (else the payload — and
                                # thus the handle — is garbage and the store read could fault).
                                # result = outer_hit AND (each nested field's tag == its ordinal).
                                pk_nested_fn: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                                pk_result_slot: LLVMValueRef = LLVMBuildAlloca(builder, LLVMInt1TypeInContext(ctx), "is.pk.nested.result")
                                _ = LLVMBuildStore(builder, LLVMConstInt(LLVMInt1TypeInContext(ctx), 0, 0), pk_result_slot)
                                pk_nested_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, pk_nested_fn, "is.pk.nested")
                                pk_nested_done: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, pk_nested_fn, "is.pk.nested.done")
                                _ = LLVMBuildCondBr(builder, pk_outer_hit, pk_nested_block, pk_nested_done)
                                LLVMPositionBuilderAtEnd(builder, pk_nested_block)
                                pk_nested_all: mutable LLVMValueRef = LLVMConstInt(LLVMInt1TypeInContext(ctx), 1, 0)
                                for pk_nidx in 0..<pe_args.count |pk_nested_all, pe_args, pk_payload_hoisted, pk_state, pk_row_type, pk_nested_fn, pk_nested_done, structs, local_scope, runtime, ctx, builder|:
                                    if pe_args[pk_nidx] is Expr.Field(pk_nf_head, pk_nf_variant, pk_nf_line):
                                        if pk_nf_head is Expr.Ident(pk_nf_enum, pk_nf_enum_line):
                                            pk_nested_ord: i64 = packed_variant_index_of_parts(pk_nf_enum, pk_nf_variant, structs)
                                            pk_nf_handle: LLVMValueRef = LLVMBuildExtractValue(builder, pk_payload_hoisted, pk_nidx.u32(), "is.pk.nested.handle")
                                            pk_nf_handle64: LLVMValueRef = LLVMBuildZExt(builder, pk_nf_handle, LLVMInt64TypeInContext(ctx), "is.pk.nested.h64")
                                            pk_nf_args: mutable darray[LLVMValueRef] = [pk_state, pk_nf_handle64]
                                            pk_nf_ptr: void& = (&pk_nf_args[0]).cast[void&] can Unsafe.PointerCast
                                            pk_nf_record: LLVMValueRef = LLVMBuildCall2(builder, runtime.packed_read_word_type, runtime.packed_read_word, pk_nf_ptr, 2, "is.pk.nested.record")
                                            pk_nf_tag_ptr: LLVMValueRef = LLVMBuildStructGEP2(builder, pk_row_type, pk_nf_record, 0, "is.pk.nested.tag.ptr")
                                            pk_nf_tag: LLVMValueRef = LLVMBuildLoad2(builder, LLVMInt32TypeInContext(ctx), pk_nf_tag_ptr, "is.pk.nested.tag")
                                            pk_nf_eq: LLVMValueRef = LLVMBuildICmp(builder, 32, pk_nf_tag, LLVMConstInt(LLVMInt32TypeInContext(ctx), pk_nested_ord.u64(), 0), "is.pk.nested.eq")
                                            pk_nested_all <- LLVMBuildAnd(builder, pk_nested_all, pk_nf_eq, "is.pk.nested.and")
                                    # The BINDING nested form. Same guarded read as
                                    # above, plus binds of the sub-node's own fields out
                                    # of its payload. The stores sit in this block, so
                                    # they run only when the outer tag matched — the
                                    # handle is garbage otherwise. Slots come from
                                    # bind_is_slot like every other `is` binding.
                                    if pe_args[pk_nidx] is Expr.Call(pk_nc_callee, pk_nc_args, pk_nc_names, pk_nc_line):
                                        if pk_nc_callee is Expr.Field(pk_nc_head, pk_nc_variant, pk_nc_fline):
                                            if pk_nc_head is Expr.Ident(pk_nc_enum, pk_nc_eline):
                                                pk_nc_ord: i64 = packed_variant_index_of_parts(pk_nc_enum, pk_nc_variant, structs)
                                                pk_nc_handle: LLVMValueRef = LLVMBuildExtractValue(builder, pk_payload_hoisted, pk_nidx.u32(), "is.pk.ncall.handle")
                                                pk_nc_handle64: LLVMValueRef = LLVMBuildZExt(builder, pk_nc_handle, LLVMInt64TypeInContext(ctx), "is.pk.ncall.h64")
                                                pk_nc_rargs: mutable darray[LLVMValueRef] = [pk_state, pk_nc_handle64]
                                                pk_nc_rptr: void& = (&pk_nc_rargs[0]).cast[void&] can Unsafe.PointerCast
                                                pk_nc_record: LLVMValueRef = LLVMBuildCall2(builder, runtime.packed_read_word_type, runtime.packed_read_word, pk_nc_rptr, 2, "is.pk.ncall.record")
                                                pk_nc_tag_ptr: LLVMValueRef = LLVMBuildStructGEP2(builder, pk_row_type, pk_nc_record, 0, "is.pk.ncall.tag.ptr")
                                                pk_nc_tag: LLVMValueRef = LLVMBuildLoad2(builder, LLVMInt32TypeInContext(ctx), pk_nc_tag_ptr, "is.pk.ncall.tag")
                                                pk_nc_eq: LLVMValueRef = LLVMBuildICmp(builder, 32, pk_nc_tag, LLVMConstInt(LLVMInt32TypeInContext(ctx), pk_nc_ord.u64(), 0), "is.pk.ncall.eq")
                                                pk_nested_all <- LLVMBuildAnd(builder, pk_nested_all, pk_nc_eq, "is.pk.ncall.and")
                                                # SHORT-CIRCUIT before reading this sub-node's payload.
                                                # ANDing the tag test was not enough: the payload read and
                                                # every deeper probe below sit in the SAME block, so they
                                                # ran even when the tag did not match — and then a field
                                                # that is not a handle (a name, an index) was used as one.
                                                # `e is Expr.Call(Expr.Field(…), …)` over an ordinary
                                                # direct call `f(x)`, whose callee is an Ident, walked the
                                                # Ident's payload as a node handle: chunk index out of
                                                # range, null chunk pointer, SIGSEGV. Only the semantic
                                                # layer writes a pattern this deep, which is why the
                                                # codegen fixpoint never saw it.
                                                pk_nc_cont: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, pk_nested_fn, "is.pk.ncall.cont")
                                                _ = LLVMBuildCondBr(builder, pk_nc_eq, pk_nc_cont, pk_nested_done)
                                                LLVMPositionBuilderAtEnd(builder, pk_nc_cont)
                                                pk_nc_enum_idx: i64 = packed_index_of(structs, pk_nc_enum)
                                                if pk_nc_enum_idx >= 0 and pk_nc_args.count > 0:
                                                    pk_nc_local: i64 = packed_variant_local_index(structs, pk_nc_enum_idx, pk_nc_variant)
                                                    if pk_nc_local >= 0:
                                                        pk_nc_slot: usize = structs.packed_variant_start[pk_nc_enum_idx.usize()] + pk_nc_local.usize()
                                                        if structs.packed_has_payload[pk_nc_slot]:
                                                            pk_nc_payload: ValueType = copied_type(structs.packed_payloads[pk_nc_slot])
                                                            if pk_nc_payload.kind != TypeKind.Unmodeled:
                                                                pk_nc_pay_ptr: LLVMValueRef = LLVMBuildStructGEP2(builder, pk_row_type, pk_nc_record, 1, "is.pk.ncall.payload.ptr")
                                                                pk_nc_pay: LLVMValueRef = LLVMBuildLoad2(builder, llvm_type_of(pk_nc_payload, structs, ctx), pk_nc_pay_ptr, "is.pk.ncall.payload")
                                                                pk_nc_fstart: usize = structs.packed_field_type_start[pk_nc_slot]
                                                                if pk_nc_args.count == 1:
                                                                    if pk_nc_args[0] is Expr.Ident(pk_nc_one, pk_nc_one_line):
                                                                        pk_nc_one_slot: LLVMValueRef = bind_is_slot(local_scope, structs, pk_nc_one, pk_nc_payload, llvm_type_of(pk_nc_payload, structs, ctx), builder)
                                                                        _ = LLVMBuildStore(builder, pk_nc_pay, pk_nc_one_slot)
                                                                if pk_nc_args.count > 1:
                                                                    for pk_nc_bi in 0..<pk_nc_args.count |pk_nc_args, pk_nc_fstart, pk_nc_pay, structs, local_scope, ctx, builder|:
                                                                        if pk_nc_args[pk_nc_bi] is Expr.Ident(pk_nc_mname, pk_nc_mline):
                                                                            pk_nc_mtype: ValueType = copied_type(structs.packed_field_types[pk_nc_fstart + pk_nc_bi])
                                                                            pk_nc_mfield: LLVMValueRef = LLVMBuildExtractValue(builder, pk_nc_pay, pk_nc_bi.u32(), "is.pk.ncall.field")
                                                                            pk_nc_mslot: LLVMValueRef = bind_is_slot(local_scope, structs, pk_nc_mname, pk_nc_mtype, llvm_type_of(pk_nc_mtype, structs, ctx), builder)
                                                                            _ = LLVMBuildStore(builder, pk_nc_mfield, pk_nc_mslot)
                                                                        # DEPTH 2: the sub-node's own field is itself a nested
                                                                        # variant — `e is Expr.Call(Expr.Field(Expr.Ident(r, _),
                                                                        # m, _), _, _, l)`. Read THAT node's record, AND its tag
                                                                        # test into the result, and bind its fields.
                                                                        #
                                                                        # Written inline rather than as a recursive helper: the
                                                                        # helper version broke whole-program region inference
                                                                        # (emit_statements' Runtime& in untouched files), and the
                                                                        # cause was never established. Inline adds no signature.
                                                                        elif pk_nc_args[pk_nc_bi] is Expr.Call(pk_d_callee, pk_d_args, pk_d_names, pk_d_line):
                                                                            if pk_d_callee is Expr.Field(pk_d_head, pk_d_variant, pk_d_fline):
                                                                                pk_d_enum: sview = enum_head_name(pk_d_head)
                                                                                if pk_d_enum != "":
                                                                                    pk_d_ord: i64 = packed_variant_index_of_parts(pk_d_enum, pk_d_variant, structs)
                                                                                    pk_d_enum_index: i64 = packed_index_of(structs, pk_d_enum)
                                                                                    if pk_d_ord >= 0 and pk_d_enum_index >= 0:
                                                                                        pk_d_handle: LLVMValueRef = LLVMBuildExtractValue(builder, pk_nc_pay, pk_nc_bi.u32(), "is.pk.d.handle")
                                                                                        pk_d_state: LLVMValueRef = LLVMBuildExtractValue(builder, runtime.active_store, 2, "is.pk.d.state")
                                                                                        pk_d_h64: LLVMValueRef = LLVMBuildZExt(builder, pk_d_handle, LLVMInt64TypeInContext(ctx), "is.pk.d.h64")
                                                                                        pk_d_args_v: mutable darray[LLVMValueRef] = [pk_d_state, pk_d_h64]
                                                                                        pk_d_args_pointer: void& = (&pk_d_args_v[0]).cast[void&] can Unsafe.PointerCast
                                                                                        pk_d_record: LLVMValueRef = LLVMBuildCall2(builder, runtime.packed_read_word_type, runtime.packed_read_word, pk_d_args_pointer, 2, "is.pk.d.record")
                                                                                        pk_d_tag_ptr: LLVMValueRef = LLVMBuildStructGEP2(builder, pk_row_type, pk_d_record, 0, "is.pk.d.tag.ptr")
                                                                                        pk_d_tag: LLVMValueRef = LLVMBuildLoad2(builder, LLVMInt32TypeInContext(ctx), pk_d_tag_ptr, "is.pk.d.tag")
                                                                                        pk_d_eq: LLVMValueRef = LLVMBuildICmp(builder, 32, pk_d_tag, LLVMConstInt(LLVMInt32TypeInContext(ctx), pk_d_ord.u64(), 0), "is.pk.d.eq")
                                                                                        pk_nested_all <- LLVMBuildAnd(builder, pk_nested_all, pk_d_eq, "is.pk.d.and")
                                                                                        # Same short-circuit one level deeper: this node's
                                                                                        # payload must not be read unless its tag matched.
                                                                                        pk_d_cont: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, pk_nested_fn, "is.pk.d.cont")
                                                                                        _ = LLVMBuildCondBr(builder, pk_d_eq, pk_d_cont, pk_nested_done)
                                                                                        LLVMPositionBuilderAtEnd(builder, pk_d_cont)
                                                                                        pk_d_local: i64 = packed_variant_local_index(structs, pk_d_enum_index, pk_d_variant)
                                                                                        if pk_d_local >= 0 and pk_d_args.count > 0:
                                                                                            pk_d_slot: usize = structs.packed_variant_start[pk_d_enum_index.usize()] + pk_d_local.usize()
                                                                                            if structs.packed_has_payload[pk_d_slot]:
                                                                                                pk_d_payload: ValueType = copied_type(structs.packed_payloads[pk_d_slot])
                                                                                                if pk_d_payload.kind != TypeKind.Unmodeled:
                                                                                                    pk_d_pay_ptr: LLVMValueRef = LLVMBuildStructGEP2(builder, pk_row_type, pk_d_record, 1, "is.pk.d.payload.ptr")
                                                                                                    pk_d_pay: LLVMValueRef = LLVMBuildLoad2(builder, llvm_type_of(pk_d_payload, structs, ctx), pk_d_pay_ptr, "is.pk.d.payload")
                                                                                                    pk_d_fstart: usize = structs.packed_field_type_start[pk_d_slot]
                                                                                                    if pk_d_args.count == 1:
                                                                                                        if pk_d_args[0] is Expr.Ident(pk_d_one, pk_d_one_line):
                                                                                                            pk_d_one_slot: LLVMValueRef = bind_is_slot(local_scope, structs, pk_d_one, pk_d_payload, llvm_type_of(pk_d_payload, structs, ctx), builder)
                                                                                                            _ = LLVMBuildStore(builder, pk_d_pay, pk_d_one_slot)
                                                                                                    if pk_d_args.count > 1:
                                                                                                        for pk_d_bi in 0..<pk_d_args.count |pk_d_args, pk_d_fstart, pk_d_pay, structs, local_scope, ctx, builder|:
                                                                                                            if pk_d_args[pk_d_bi] is Expr.Ident(pk_d_mname, pk_d_mline):
                                                                                                                pk_d_mtype: ValueType = copied_type(structs.packed_field_types[pk_d_fstart + pk_d_bi])
                                                                                                                pk_d_mfield: LLVMValueRef = LLVMBuildExtractValue(builder, pk_d_pay, pk_d_bi.u32(), "is.pk.d.field")
                                                                                                                pk_d_mslot: LLVMValueRef = bind_is_slot(local_scope, structs, pk_d_mname, pk_d_mtype, llvm_type_of(pk_d_mtype, structs, ctx), builder)
                                                                                                                _ = LLVMBuildStore(builder, pk_d_mfield, pk_d_mslot)
                                _ = LLVMBuildStore(builder, pk_nested_all, pk_result_slot)
                                _ = LLVMBuildBr(builder, pk_nested_done)
                                LLVMPositionBuilderAtEnd(builder, pk_nested_done)
                                return LLVMBuildLoad2(builder, LLVMInt1TypeInContext(ctx), pk_result_slot, "is.pk.nested.load")
                            return null
                        pe_enum_index: i64 = penum_index_of(structs, pe_enum_name)
                        if pe_enum_index >= 0:
                            pe_scrut_type: ValueType = expression_type(is_left, local_scope, fns, structs, generics)
                            null return if pe_scrut_type.kind != TypeKind.PayloadEnum
                            pe_tag: i64 = penum_variant_index(structs, pe_enum_index, pe_variant)
                            null return if pe_tag < 0
                            pe_slot: usize = structs.penum_variant_start[pe_enum_index.usize()] + pe_tag.usize()
                            # A binder ident NARROWS (binds the payload); a LITERAL is a
                            # VALUE TEST -- `node is Expr.Float(3.14)` matches only when
                            # the tag agrees AND the payload equals the literal. Only
                            # binders were modelled, so every literal payload declined.
                            #
                            # The literal form is handled for the SINGLE-field variant
                            # only, which is what a literal payload test means in
                            # practice; a multi-field variant with literals mixed in
                            # keeps declining rather than testing some fields and
                            # silently ignoring others.
                            pe_all_binders: mutable bool = true
                            pe_literal_test: mutable bool = false
                            for pe_arg in pe_args |pe_all_binders|:
                                pe_arg_is_binder: mutable bool = false
                                if pe_arg is Expr.Ident(pe_arg_name, pe_arg_line):
                                    pe_arg_is_binder <- true
                                pe_all_binders <- false if not pe_arg_is_binder
                            if not pe_all_binders:
                                null return if pe_args.count != 1
                                if pe_args[0] is Expr.IntLit(pe_int_literal, _):
                                    pe_literal_test <- true
                                if pe_args[0] is Expr.FloatLit(pe_float_literal, _):
                                    pe_literal_test <- true
                                null return if not pe_literal_test
                            null return if pe_args.count != structs.penum_field_type_count[pe_slot]
                            if emit_expression(is_left, pe_scrut_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is pe_value:
                                pe_llvm: LLVMTypeRef = llvm_type_of(pe_scrut_type, structs, ctx)
                                pe_holder: LLVMValueRef = LLVMBuildAlloca(builder, pe_llvm, "is.penum")
                                _ = LLVMBuildStore(builder, pe_value, pe_holder)
                                pe_field_start: usize = structs.penum_field_type_start[pe_slot]
                                if pe_args.count == 1:
                                    if pe_args[0] is Expr.Ident(pe_single_name, pe_single_line):
                                        pe_single_type: ValueType = copied_type(structs.penum_field_types[pe_field_start])
                                        pe_single_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, pe_llvm, pe_holder, 1, "is.penum.ptr")
                                        pe_single_slot: LLVMValueRef = bind_is_slot(local_scope, structs, pe_single_name, pe_single_type, llvm_type_of(pe_single_type, structs, ctx), builder)
                                        _ = LLVMBuildStore(builder, LLVMBuildLoad2(builder, llvm_type_of(pe_single_type, structs, ctx), pe_single_pointer, "is.penum.val"), pe_single_slot)
                                if pe_args.count > 1:
                                    pe_tuple_llvm: LLVMTypeRef = penum_field_tuple_type(pe_slot, structs, ctx)
                                    pe_tuple_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, pe_llvm, pe_holder, 1, "is.penum.ptr")
                                    pe_tuple_value: LLVMValueRef = LLVMBuildLoad2(builder, pe_tuple_llvm, pe_tuple_pointer, "is.penum.tuple")
                                    for pe_bind_index in 0..<pe_args.count |pe_args, pe_field_start, pe_tuple_value, structs, local_scope, ctx, builder|:
                                        if pe_args[pe_bind_index] is Expr.Ident(pe_multi_name, pe_multi_line):
                                            pe_multi_type: ValueType = copied_type(structs.penum_field_types[pe_field_start + pe_bind_index])
                                            pe_multi_value: LLVMValueRef = LLVMBuildExtractValue(builder, pe_tuple_value, pe_bind_index.u32(), "is.penum.field")
                                            pe_multi_slot: LLVMValueRef = bind_is_slot(local_scope, structs, pe_multi_name, pe_multi_type, llvm_type_of(pe_multi_type, structs, ctx), builder)
                                            _ = LLVMBuildStore(builder, pe_multi_value, pe_multi_slot)
                                pe_tag_value: LLVMValueRef = LLVMBuildExtractValue(builder, pe_value, 0, "is.penum.tag")
                                pe_tag_hit: LLVMValueRef = LLVMBuildICmp(builder, 32, pe_tag_value, LLVMConstInt(LLVMInt32TypeInContext(ctx), pe_tag.u64(), 0), "is.penum.cmp")
                                # A LITERAL payload adds an equality test on the payload
                                # itself. Read at the FIELD's declared type so a float
                                # payload compares as a float (FCmp 1 = ordered-equal)
                                # and an integer as an integer.
                                if pe_literal_test:
                                    pe_lit_type: ValueType = copied_type(structs.penum_field_types[pe_field_start])
                                    null return if pe_lit_type.kind == TypeKind.Unmodeled
                                    pe_lit_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, pe_llvm, pe_holder, 1, "is.penum.lit.ptr")
                                    pe_lit_actual: LLVMValueRef = LLVMBuildLoad2(builder, llvm_type_of(pe_lit_type, structs, ctx), pe_lit_pointer, "is.penum.lit.val")
                                    if emit_expression(pe_args[0], pe_lit_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is pe_lit_expected:
                                        pe_lit_hit: LLVMValueRef = LLVMBuildFCmp(builder, 1, pe_lit_actual, pe_lit_expected, "is.penum.lit.eq") if pe_lit_type.kind == TypeKind.Float else LLVMBuildICmp(builder, 32, pe_lit_actual, pe_lit_expected, "is.penum.lit.eq")
                                        return LLVMBuildAnd(builder, pe_tag_hit, pe_lit_hit, "is.penum.lit.and")
                                    return null
                                return pe_tag_hit
                            return null
            matched <- false
            return null
