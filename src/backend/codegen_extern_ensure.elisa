# Stage1 backend — docs/127 D8: a native extern's `ensure` is CHECKED at every call site, not
# assumed. Part of `module Backend` (see codegen.elisa).
#
# The analyzer lets a caller assume an extern's `ensure` downstream once its `requires` is
# discharged. For a scalar fact that is the right default; for a fact a MEMORY obligation
# rides on (`ensure result <= buf.count` on a read) a lying library turns safe code into
# undefined behaviour with nothing to stop it. So in checked builds every native extern call
# re-evaluates each `ensure` with the parameters bound to the argument values and `result`
# bound to the returned value, and panics on violation — the same guard shape, label and
# position rule as an Elisa function's own postcondition. `@trusted("reason")` is what buys
# the pure assumption, and it is the only thing that does.

extend Backend:
    private:

        # The `ensure` predicates the parser captured for each NATIVE extern, keyed by the
        # exact declaration offset. `@trusted` externs are filtered out here
        # rather than at the call site, so a trusted extern costs nothing per call.
        def collect_extern_ensures(file: Ast::File&, declarations: darray[Decl], structs: mutable StructTable&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                potential_offsets: mutable darray[u32] = []
                collect_checkable_extern_offsets(declarations, potential_offsets)
                return if potential_offsets.count == 0
                has_potential_ensure: mutable bool = false
                for contract_index in 0..<file.signature_contract_exprs.count |potential_offsets, has_potential_ensure, file|:
                    continue if contract_index >= file.signature_contract_lines.count or contract_index >= file.signature_contract_kinds.count
                    continue if file.signature_contract_kinds[contract_index] != "ensure"
                    owner_offset: u32 = backend_signature_contract_owner_offset_at(contract_index, file)
                    continue if owner_offset == 4294967295
                    for extern_offset in potential_offsets |has_potential_ensure, owner_offset|:
                        has_potential_ensure <- true if extern_offset == owner_offset + 1
                return if not has_potential_ensure
                checkable_offsets: mutable darray[u32] = []
                # The caller passes the declaration tree already selected for this exact
                # codegen target. Scoped blocks remain in that tree when they are not static
                # branches, so the recursive collector must still visit them.
                collect_checkable_extern_offsets(declarations, checkable_offsets)
                return if checkable_offsets.count == 0
                return if file.signature_contract_lines.count != file.signature_contract_kinds.count or file.signature_contract_lines.count != file.signature_contract_exprs.count
                contract_count: usize = file.signature_contract_kinds.count
                contract_index: mutable usize = 0
                while contract_index < contract_count |contract_index, contract_count, checkable_offsets, file, structs|:
                    contract_owner_offset: u32 = backend_signature_contract_owner_offset_at(contract_index, file)
                    is_extern_ensure: mutable bool = file.signature_contract_kinds[contract_index] == "ensure"
                    declares_extern: mutable bool = false
                    for checkable_offset in checkable_offsets |declares_extern, contract_owner_offset|:
                        declares_extern <- true if contract_owner_offset != 4294967295 and checkable_offset == contract_owner_offset + 1
                    if is_extern_ensure and declares_extern:
                        structs.contracts.extern_ensure_offsets <- structs.contracts.extern_ensure_offsets.push(contract_owner_offset + 1)
                        structs.contracts.extern_ensure_exprs <- structs.contracts.extern_ensure_exprs.push(file.signature_contract_exprs[contract_index])
                    contract_index <- contract_index + 1



        # Signature rows and AST declarations intentionally carry different representations:
        # the parser marker stores a raw offset, while FnTable.offsets stores offset+1 so zero
        # can represent an unknown legacy location.
        def backend_signature_contract_owner_offset_at(index: usize, file: Ast::File&) -> u32:
            can Abort.Panic:
                return 4294967295 if file.signature_contract_lines.count != file.signature_contract_kinds.count or file.signature_contract_lines.count != file.signature_contract_exprs.count or index >= file.signature_contract_lines.count
                marker_count: mutable usize = 0
                selected_line: mutable u32 = 0
                selected_kind: mutable sview = ""
                selected_offset: mutable u32 = 4294967295
                for annotation in file.enum_annotations |marker_count, index, selected_line, selected_kind, selected_offset|:
                    continue if annotation.owner != "__signature_contract"
                    if marker_count == index:
                        selected_line <- annotation.line
                        selected_kind <- annotation.name
                        selected_offset <- annotation.offset
                    marker_count <- marker_count + 1.usize()
                return 4294967295 if marker_count != file.signature_contract_lines.count
                return selected_offset if selected_offset != 4294967295 and selected_line == file.signature_contract_lines[index] and selected_kind == file.signature_contract_kinds[index]
                return 4294967295


        def collect_checkable_extern_offsets(top: darray[Decl]&, offsets: mutable darray[u32]&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                for declaration in top |offsets|:
                    match declaration:
                        Decl.Module(module_name, module_body, module_line):
                            collect_checkable_extern_offsets(module_body, offsets)
                        Decl.Scoped(scoped_body, scoped_line):
                            collect_checkable_extern_offsets(scoped_body, offsets)
                        _:
                            record_checkable_extern_offset(declaration, offsets)



        def record_checkable_extern_offset(declaration: Decl, offsets: mutable darray[u32]&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                if declaration is Decl.Extern(extern_name, param_start, arity, variadic, callable, return_type_name, decorators, extern_line):
                    return if not callable
                    for decorator in decorators:
                        return if decorator.name == "trusted"
                    offsets.push(extern_line.offset + 1)



        # Whether THIS call needs a boundary check at all: a checked build, a native extern,
        # and at least one `ensure` recorded against its declaration.
        def extern_ensure_applies(fn_index: i64, fns: FnTable&, structs: StructTable&) -> bool can[Abort.Panic]:
            return false if:
                not structs.contracts.checked_contracts
                fn_index < 0
                not fns.is_extern[fn_index.usize()]
            return false if fns.offsets.count <= fn_index.usize()
            extern_offset: u32 = fns.offsets[fn_index.usize()]
            for ensure_offset in structs.contracts.extern_ensure_offsets |extern_offset|:
                return true if ensure_offset == extern_offset
            return false



        # Bind the call's ELISA-LEVEL arguments to the extern's parameter names and its result
        # to `result`, then guard on each recorded predicate. `hidden` is the count of leading
        # slots that are not source parameters (an error-return slot, an sret pointer).
        # False = DECLINE (a predicate the expression emitter cannot model). Never silently
        # skips a check: a contract that is not emitted is a contract that is not enforced,
        # and for a boundary contract that would mean claiming a guarantee that is not there.
        def emit_extern_ensure_checks(fn_index: i64, ensure_arguments: darray[LLVMValueRef]&, hidden: usize, ensure_result: LLVMValueRef, call_return_type: ValueType, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                extern_offset: u32 = fns.offsets[fn_index.usize()]
                scope_start: usize = scope_mark(local_scope)
                param_start: usize = fns.param_start[fn_index.usize()]
                param_count: usize = fns.param_count[fn_index.usize()]
                param_index: mutable usize = 0
                while param_index < param_count |param_index, param_count, param_start, hidden, ensure_arguments, local_scope, fns, structs, ctx, builder|:
                    argument_position: usize = hidden + param_index
                    break if argument_position >= ensure_arguments.count
                    param_name: sview = fns.param_names[param_start + param_index]
                    if param_name != "":
                        param_type: ValueType = copied_type(fns.param_types[param_start + param_index])
                        # The slot carries the PARAMETER'S OWN name, as stage0's does.
                        name_storage: mutable darray[u8] = []
                        # Keep the conversion in a typed local.  The stage0 checker is
                        # deliberately conservative for a borrowed view passed directly
                        # through a native call; the local also makes the storage lifetime
                        # explicit to the backend.
                        param_name_cstr: cstr = sview_to_cstr(param_name, name_storage)
                        param_slot: LLVMValueRef = build_entry_alloca(builder, llvm_type_of(param_type, structs, ctx), param_name_cstr)
                        _ = LLVMBuildStore(builder, ensure_arguments[argument_position], param_slot)
                        declare_local(local_scope, param_name, param_slot, param_type)
                    param_index <- param_index + 1
                if call_return_type.kind != TypeKind.Void:
                    result_slot: LLVMValueRef = build_entry_alloca(builder, llvm_type_of(call_return_type, structs, ctx), "result")
                    _ = LLVMBuildStore(builder, ensure_result, result_slot)
                    declare_local(local_scope, "result", result_slot, call_return_type)
                ensure_bool: ValueType = ValueType{kind: TypeKind.Bool, bits: 1}
                ensure_count: usize = structs.contracts.extern_ensure_offsets.count
                ensure_index: mutable usize = 0
                all_emitted: mutable bool = true
                while ensure_index < ensure_count |ensure_index, ensure_count, extern_offset, ensure_bool, all_emitted, local_scope, fns, structs, generics, runtime, m, ctx, builder|:
                    # Copied OUT of the table: emit_expression takes `structs` mutably, so a
                    # borrow held across the call would conflict.
                    matches_extern: bool = structs.contracts.extern_ensure_offsets[ensure_index] == extern_offset
                    if matches_extern:
                        ensure_pred: Expr = structs.contracts.extern_ensure_exprs[ensure_index]
                        ensure_pos: Ast::Pos = Ast::expr_pos(ensure_pred)
                        if (emit_expression(ensure_pred, ensure_bool, local_scope, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}) is ensure_value:
                            emit_contract_guard(ensure_value, "extern postcondition failed", ensure_pos.line, ensure_pos.column, structs.target.wasm_component_types_enabled, m, ctx, builder) can Global{Read,Write}
                        else:
                            all_emitted <- false
                    ensure_index <- ensure_index + 1
                scope_restore(local_scope, scope_start)
                return all_emitted
