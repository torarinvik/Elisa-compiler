# Stage1 EASM — memory-effect verification: reads, writes, and guest-overlay facts.
# Part of `module Easm` (see easm_model.elisa); split out to keep each file short.

extend Easm:
    public:
        # Recursive specification for the imperative same-path maximum fold below.
        ghost def easm_size_guard_lower_bound_from(facts: darray[sview]&, index: usize, greatest: i64) -> i64:
            requires index <= facts.count and greatest >= 0
            decreases facts.count - index
            ensure result >= greatest
            ensure (forall fact_index in index..<facts.count:
                easm_find(facts[fact_index], "size >=") >= (facts[fact_index]).len
                or result >= easm_parse_i64(easm_trim(facts[fact_index][easm_find(facts[fact_index], "size >=") + 7.usize():(facts[fact_index]).len]))
            )
            return greatest if index == facts.count
            return easm_size_guard_lower_bound_from(facts, index + 1.usize(), EasmMemStateDomain::greatest_bound(greatest, easm_parse_i64(easm_trim(facts[index][easm_find(facts[index], "size >=") + 7.usize():(facts[index]).len])))) if easm_find(facts[index], "size >=") < (facts[index]).len
            return easm_size_guard_lower_bound_from(facts, index + 1.usize(), greatest)

        def easm_memory_reads(instruction: Instruction) -> bool:
            source: sview = easm_substitute_operand(easm_first_operand(instruction.text), instruction)
            destination: sview = easm_substitute_operand(easm_last_operand(instruction.text), instruction)
            source_memory: bool = easm_memory_operand(source)
            destination_memory: bool = easm_memory_operand(destination)
            # AT&T read-modify-write operations have a memory destination but also consume
            # the old memory value. This distinction is part of stage0's memory-direction
            # contract; a write-only clobber must not discharge the read obligation.
            return EasmMemoryEffectPolicy::memory_reads(instruction.op, instruction.pseudo, source_memory, destination_memory)

        def easm_memory_writes(instruction: Instruction) -> bool:
            source: sview = easm_substitute_operand(easm_first_operand(instruction.text), instruction)
            destination: sview = easm_substitute_operand(easm_last_operand(instruction.text), instruction)
            source_memory: bool = easm_memory_operand(source)
            destination_memory: bool = easm_memory_operand(destination)
            return EasmMemoryEffectPolicy::memory_writes(instruction.op, instruction.pseudo, destination_memory, source_memory)

        def easm_reads_destination(instruction: Instruction) -> bool:
            return false if instruction.pseudo
            destination: sview = easm_register_operand(easm_substitute_operand(easm_last_operand(instruction.text), instruction))
            return false if destination == ""
            return EasmRegisterEffectPolicy::reads_register_destination(instruction.op, destination != "", easm_self_zeroing(instruction))

        def easm_self_zeroing(instruction: Instruction) -> bool:
            return false if instruction.pseudo
            source: sview = easm_register_operand(easm_substitute_operand(easm_first_operand(instruction.text), instruction))
            destination: sview = easm_register_operand(easm_substitute_operand(easm_last_operand(instruction.text), instruction))
            return EasmRegisterEffectPolicy::is_self_zeroing(instruction.op, source, destination)

        def easm_memory_base_register(operand: sview) -> sview:
            open: usize = easm_find(operand, "(")
            if open >= operand.len:
                return ""
            close_relative: usize = easm_find(operand[open:operand.len], ")")
            if close_relative >= (operand[open:operand.len]).len:
                return ""
            close: usize = close_relative + open
            if close <= open:
                return ""
            inside: mutable sview = operand[open + 1.usize():close]
            comma: usize = easm_find(inside, ",")
            if comma < inside.len:
                inside <- inside[0:comma]
            return easm_register_operand(inside)

        def easm_memory_index_register(operand: sview) -> sview:
            open: usize = easm_find(operand, "(")
            if open >= operand.len:
                return ""
            close: usize = easm_find(operand[open:operand.len], ")") + open
            if close <= open:
                return ""
            inside: sview = operand[open + 1.usize():close]
            comma: usize = easm_find(inside, ",")
            if comma >= inside.len:
                return ""
            rest: mutable sview = inside[comma + 1.usize():inside.len]
            second_comma: usize = easm_find(rest, ",")
            if second_comma < rest.len:
                rest <- rest[0:second_comma]
            return easm_register_operand(rest)

        def easm_raw_scalar_type(type_name: sview) -> bool:
            return easm_equal(type_name, "u8") or easm_equal(type_name, "u16") or easm_equal(type_name, "u32") or easm_equal(type_name, "u64") or easm_equal(type_name, "i8") or easm_equal(type_name, "i16") or easm_equal(type_name, "i32") or easm_equal(type_name, "i64") or easm_equal(type_name, "usize") or easm_equal(type_name, "uintptr")

        def easm_carrier_layout(type_name: sview) -> sview:
            open: usize = easm_find(type_name, "[")
            if open >= type_name.len:
                return ""
            close: usize = easm_find(type_name[open:type_name.len], "]") + open
            if close <= open:
                return ""
            return easm_trim(type_name[open + 1.usize():close])

        def easm_memory_displacement(operand: sview) -> i64:
            parsed: (valid: bool, value: i64) = easm_memory_displacement_checked(operand)
            return parsed.value if parsed.valid else 0

        def easm_memory_displacement_checked(operand: sview) -> (valid: bool, value: i64):
            ensure not result.valid implies result.value == 0
            open: usize = easm_find(operand, "(")
            if open >= operand.len:
                return (true, 0)
            prefix: sview = easm_trim(operand[0:open])
            if prefix.len == 0:
                return (true, 0)
            return easm_parse_i64_checked(prefix)

        def easm_size_guard_lower_bound(facts: darray[sview]) -> i64:
            ensure result >= 0
            ensure result == easm_size_guard_lower_bound_from(facts, 0.usize(), 0)
            ensure (forall fact_index in 0..<facts.count:
                easm_find(facts[fact_index], "size >=") >= (facts[fact_index]).len
                or result >= easm_parse_i64(easm_trim(facts[fact_index][easm_find(facts[fact_index], "size >=") + 7.usize():(facts[fact_index]).len]))
            )
            greatest: mutable i64 = 0
            index: mutable usize = 0
            while index < facts.count |index, facts, greatest|:
                decreases facts.count - index
                invariant index <= facts.count
                invariant greatest >= 0
                invariant easm_size_guard_lower_bound_from(facts, index, greatest) == easm_size_guard_lower_bound_from(facts, 0.usize(), 0)
                fact: sview = facts[index]
                marker: usize = easm_find(fact, "size >=")
                if marker < fact.len:
                    value: i64 = easm_parse_i64(easm_trim(fact[marker + 7.usize():fact.len]))
                    greatest <- EasmMemStateDomain::greatest_bound(greatest, value)
                index <- index + 1
            return greatest

        # Scalar memory-size domain: predecessor states combine by their weaker minimum bound,
        # same-path conjunctive facts combine by their strongest maximum bound, and a read is
        # well typed when its required size is covered by the known lower bound. The overlay
        # verifier applies the read predicate to the bound extracted from the function's facts.
        def easm_memstate_join_min(left: i64, right: i64) -> i64:
            return EasmMemStateDomain::join_min(left, right)

        def easm_memstate_read_well_typed(need: i64, known_min: i64) -> bool:
            return EasmMemStateDomain::read_well_typed(need, known_min)

        def easm_memstate_guard_join(left: i64, right: i64, need: i64) -> bool:
            return EasmMemStateDomain::guard_join(left, right, need)

        def easm_access_width(op: sview) -> i64:
            return EasmAccessWidth::access_width(op)

        def easm_input_type_for_register(fn: Function, register: sview) -> sview:
            for input in fn.inputs:
                equals: usize = easm_find(input, "=")
                if equals < input.len:
                    bound_register: sview = easm_register_operand(input[equals + 1.usize():input.len])
                    if easm_equal(bound_register, register):
                        return easm_param_type(fn, easm_binding_name(input))
            return ""

        def easm_provenance_registers_equal(left: sview, right: sview) -> bool:
            left_bit: i64 = easm_register_bit(left)
            return left_bit != 0 and left_bit == easm_register_bit(right)

        def easm_provenance_type(states: mutable darray[MemoryProvenance]&, register: sview) -> sview:
            for state in states:
                if easm_provenance_registers_equal(state.register, register):
                    return state.type_name
            return ""

        def easm_provenance_has_register(states: mutable darray[MemoryProvenance]&, register: sview) -> bool:
            for state in states:
                if easm_provenance_registers_equal(state.register, register):
                    return true
            return false

        def easm_provenance_set_parameter(states: mutable darray[MemoryProvenance]&, register: sview, type_name: sview, parameter: sview) -> void:
            for index in 0..<states.count |index, states, register, type_name|:
                if easm_provenance_registers_equal(states[index].register, register):
                    states[index] <- MemoryProvenance{register: register, type_name: type_name, parameter: parameter}
                    return
            states.push(MemoryProvenance{register: register, type_name: type_name, parameter: parameter})

        def easm_provenance_set(states: mutable darray[MemoryProvenance]&, register: sview, type_name: sview) -> void:
            easm_provenance_set_parameter(states, register, type_name, "")

        def easm_provenance_parameter(states: mutable darray[MemoryProvenance]&, register: sview) -> sview:
            for state in states:
                if easm_provenance_registers_equal(state.register, register):
                    return state.parameter
            return ""

        # Carry a pointer carrier through the register-preserving address operations recognized by
        # stage0. A move/lea does not turn a raw scalar into a typed pointer, and add/sub/inc/dec
        # preserve the carrier while changing its displacement. Calls erase caller-saved facts;
        # CPUID/RDTSC erase their implicit result registers. Other register writes erase their
        # destination proof instead of allowing stale provenance to justify a later dereference.
        def easm_update_memory_provenance(states: mutable darray[MemoryProvenance]&, instruction: Instruction) -> void:
            if instruction.pseudo:
                return
            implicit_writes: mutable i64 = easm_implicit_write_mask(instruction.op)
            if easm_starts(instruction.op, "call"):
                implicit_writes <- EasmRegisterMasks::call_clobber_mask()
            if implicit_writes != 0:
                for index in 0..<states.count |index, states, implicit_writes|:
                    bit: i64 = easm_register_bit(states[index].register)
                    if bit != 0 and (implicit_writes & bit) != 0:
                        states[index] <- MemoryProvenance{register: states[index].register, type_name: "", parameter: ""}
                return
            destination_operand: sview = easm_substitute_operand(easm_last_operand(instruction.text), instruction)
            source_operand: sview = easm_substitute_operand(easm_first_operand(instruction.text), instruction)
            destination: sview = easm_register_operand(destination_operand)
            source: sview = easm_register_operand(source_operand)
            op: sview = instruction.op
            destination_width: i64 = EasmAddressWidthPolicy::address_register_width(destination)
            source_width: i64 = EasmAddressWidthPolicy::address_register_width(source)
            if easm_starts(instruction.op, "xchg"):
                full_width_exchange: bool = destination_width == EasmAddressWidthPolicy::ADDRESS_REGISTER_WIDTH_64 and source_width == EasmAddressWidthPolicy::ADDRESS_REGISTER_WIDTH_64 and (op == "xchgq" or op == "xchg")
                if full_width_exchange and source != "" and destination != "":
                    source_type: sview = easm_provenance_type(states, source)
                    source_parameter: sview = easm_provenance_parameter(states, source)
                    destination_type: sview = easm_provenance_type(states, destination)
                    destination_parameter: sview = easm_provenance_parameter(states, destination)
                    easm_provenance_set_parameter(states, source, destination_type, destination_parameter)
                    easm_provenance_set_parameter(states, destination, source_type, source_parameter)
                else:
                    easm_provenance_set_parameter(states, source, "", "") if source != ""
                    easm_provenance_set_parameter(states, destination, "", "") if destination != ""
                return
            if destination == "":
                return
            inherited: mutable sview = ""
            inherited_parameter: mutable sview = ""
            if (op == "mov" or op == "movq") and destination_width == EasmAddressWidthPolicy::ADDRESS_REGISTER_WIDTH_64 and (source == "" or source_width == EasmAddressWidthPolicy::ADDRESS_REGISTER_WIDTH_64):
                inherited <- easm_provenance_type(states, source)
                inherited_parameter <- easm_provenance_parameter(states, source)
            elif (op == "lea" or op == "leaq") and destination_width == EasmAddressWidthPolicy::ADDRESS_REGISTER_WIDTH_64:
                source_register: sview = easm_memory_base_register(source_operand)
                if EasmAddressWidthPolicy::address_register_width(source_register) == EasmAddressWidthPolicy::ADDRESS_REGISTER_WIDTH_64:
                    inherited <- easm_provenance_type(states, source_register)
                    inherited_parameter <- easm_provenance_parameter(states, source_register)
            elif (op == "add" or op == "addq" or op == "sub" or op == "subq" or op == "inc" or op == "incq" or op == "dec" or op == "decq") and destination_width == EasmAddressWidthPolicy::ADDRESS_REGISTER_WIDTH_64:
                inherited <- easm_provenance_type(states, destination)
                inherited_parameter <- easm_provenance_parameter(states, destination)
            easm_provenance_set_parameter(states, destination, inherited, inherited_parameter)

        def memory_provenance_type(fn: Function, register: sview) -> sview:
            states: mutable darray[MemoryProvenance] = []
            for input in fn.inputs:
                bound: sview = easm_binding_register(input)
                if bound != "":
                    easm_provenance_set_parameter(states, bound, easm_param_type(fn, easm_binding_name(input)), easm_binding_name(input))
            for instruction in fn.instructions:
                easm_update_memory_provenance(states, instruction)
            return easm_provenance_type(states, register)

        def easm_layout_field_at(layout: Layout, offset: i64) -> LayoutField:
            for field in layout.fields:
                if field.offset == offset:
                    return field
            return LayoutField{offset: -1, name: "", type_name: "", width: 0, requires_size_at_least: 0, line: 0}

        def easm_verify_memory_roles(fn: Function, layouts: darray[Layout], issues: mutable darray[Issue]&) -> void:
            states: mutable darray[MemoryProvenance] = []
            # Validate every memory operand before the provenance pass skips LEA.
            # Bracket syntax and any address with no extracted base fail closed.
            for instruction in fn.instructions:
                continue if instruction.pseudo
                operand_scan: (start: usize, count: usize, first_separator: usize, last_separator: usize, has_address_group: bool, address_open: usize, address_close: usize, valid: bool) = EasmOperandScan::scan_instruction(instruction.text)
                continue if not operand_scan.valid or EasmOperandScan::needs_arity_rejection(operand_scan.count)
                for operand_index in 0..<operand_scan.count |operand_index, instruction, issues|:
                    raw_operand: sview = easm_first_operand(instruction.text) if operand_index == 0 else easm_last_operand(instruction.text)
                    operand: sview = easm_substitute_operand(raw_operand, instruction)
                    continue if not easm_memory_operand(operand)
                    bracketed: bool = easm_find(operand, "[") < operand.len or easm_find(operand, "]") < operand.len
                    if EasmMemoryBasePolicy::rejects_bracket_address_form(bracketed):
                        issues.push(Issue{severity: Severity.Error, code: "unsupported-bracket-address", line: instruction.line, message: "square-bracket memory operands are not supported by the verified EASM address model"})
                        continue
                    base: sview = easm_memory_base_register(operand)
                    if base == "" and EasmMemoryBasePolicy::rejects_unresolved_memory_base(true, true):
                        issues.push(Issue{severity: Severity.Error, code: "unresolved-memory-base", line: instruction.line, message: "memory operand has no parsed register base"})
            for input in fn.inputs:
                register: sview = easm_binding_register(input)
                if register != "":
                    easm_provenance_set(states, register, easm_param_type(fn, easm_binding_name(input)))
            # Keep the raw-carrier guard in a direct second pass as well as the layout pass below.
            # This makes the safety obligation independent of layout resolution: a raw scalar must
            # never become a dereferenceable base merely because it was copied to another register.
            for instruction_index in 0..<fn.instructions.count |instruction_index, fn, issues|:
                instruction: Instruction = fn.instructions[instruction_index]
                continue if instruction.pseudo or easm_starts(instruction.op, "lea")
                operand_scan: (start: usize, count: usize, first_separator: usize, last_separator: usize, has_address_group: bool, address_open: usize, address_close: usize, valid: bool) = EasmOperandScan::scan_instruction(instruction.text)
                operand_count: usize = 1 if operand_scan.valid and operand_scan.count == 1 else EasmMemoryBasePolicy::MEMORY_ADDRESS_OPERAND_COUNT
                for operand_index in 0..<operand_count |operand_index, instruction, fn, issues|:
                    raw_operand: sview = easm_first_operand(instruction.text) if operand_index == 0 else easm_last_operand(instruction.text)
                    operand: sview = easm_substitute_operand(raw_operand, instruction)
                    continue if not easm_memory_operand(operand)
                    base: sview = easm_memory_base_register(operand)
                    carried_type: sview = memory_provenance_type(fn, base)
                    can Abort.Panic:
                        if EasmMemoryBasePolicy::rejects_direct_raw_base(base, carried_type, easm_contract_has_word(fn.requires, "memory.base.untyped")):
                            issues.push(Issue{severity: Severity.Error, code: "raw-memory-base", line: instruction.line, message: "raw scalar register used as a memory base; use a typed pointer carrier or require memory.base.untyped"})
            issues.reserve(issues.count + fn.instructions.count)
            for instruction in fn.instructions:
                continue if instruction.pseudo
                if not easm_starts(instruction.op, "lea"):
                    operand_scan: (start: usize, count: usize, first_separator: usize, last_separator: usize, has_address_group: bool, address_open: usize, address_close: usize, valid: bool) = EasmOperandScan::scan_instruction(instruction.text)
                    operand_count: usize = 1 if operand_scan.valid and operand_scan.count == 1 else 2
                    for operand_index in 0..<operand_count |operand_index, instruction, states, fn, layouts, issues|:
                        raw_operand: sview = easm_first_operand(instruction.text) if operand_index == 0 else easm_last_operand(instruction.text)
                        operand: sview = easm_substitute_operand(raw_operand, instruction)
                        continue if not easm_memory_operand(operand)
                        base: sview = easm_memory_base_register(operand)
                        continue if base == "" or easm_equal(base, "rsp") or easm_equal(base, "rip")
                        type_name: mutable sview = easm_provenance_type(states, base)
                        if not easm_provenance_has_register(states, base):
                            type_name <- easm_input_type_for_register(fn, base)
                        # A present but empty fact records a prior clobber or untyped write. Do not
                        # recover the original input type for that register: the carrier is no longer
                        # established at this instruction.
                        if EasmMemoryBasePolicy::rejects_untraced_raw_base(type_name != "", easm_contract_has_word(fn.requires, "memory.base.untyped")):
                            issues.push(Issue{severity: Severity.Error, code: "raw-memory-base", line: instruction.line, message: "memory base provenance was not established from a typed carrier"})
                        can Abort.Panic:
                            if EasmMemoryBasePolicy::rejects_raw_address_type_without_opt_in(type_name, easm_contract_has_word(fn.requires, "memory.base.untyped")):
                                issues.push(Issue{severity: Severity.Error, code: "raw-memory-base", line: instruction.line, message: "raw scalar register used as a memory base; use a typed pointer carrier or require memory.base.untyped"})
                        layout_name: sview = easm_carrier_layout(type_name)
                        if layout_name == "":
                            continue
                        for layout in layouts:
                            if not easm_equal(layout.name, layout_name):
                                continue
                            displacement: (valid: bool, value: i64) = easm_memory_displacement_checked(operand)
                            if not displacement.valid:
                                issues.push(Issue{severity: Severity.Error, code: "invalid-memory-displacement", line: instruction.line, message: "layout memory displacement must be a valid signed 64-bit decimal integer"})
                                continue
                            field: LayoutField = easm_layout_field_at(layout, displacement.value)
                            if field.offset < 0:
                                issues.push(Issue{severity: Severity.Error, code: "layout-unknown-field", line: instruction.line, message: "memory displacement is not a declared field in the carrier layout"})
                                continue
                            width: i64 = easm_access_width(instruction.op)
                            if width > 0 and field.width > 0 and width != field.width:
                                issues.push(Issue{severity: Severity.Error, code: "layout-field-width-mismatch", line: instruction.line, message: "memory access width does not match the declared layout field width"})
                            if field.requires_size_at_least > 0 and not easm_memstate_read_well_typed(field.requires_size_at_least, easm_size_guard_lower_bound(fn.facts)):
                                issues.push(Issue{severity: Severity.Error, code: "overlay-field-needs-size-guard", line: instruction.line, message: "layout field requires a dominating runtime size guard at least as strong as its declared lower bound"})
                easm_update_memory_provenance(states, instruction)
            easm_verify_provenance_merges(fn, issues)
            easm_verify_simple_provenance_joins(fn, issues)

        def easm_verify_frame_contracts(fn: Function, issues: mutable darray[Issue]&) -> void:
            return if fn.reads.count == 0 and fn.changes.count == 0
            for carrier in fn.reads:
                if easm_param_type(fn, easm_trim(carrier)) == "":
                    issues.push(Issue{severity: Severity.Error, code: "frame-unknown-carrier", line: fn.line, message: "reads names a parameter that is not present in the EASM signature"})
            for carrier in fn.changes:
                if easm_param_type(fn, easm_trim(carrier)) == "":
                    issues.push(Issue{severity: Severity.Error, code: "frame-unknown-carrier", line: fn.line, message: "changes names a parameter that is not present in the EASM signature"})
            states: mutable darray[MemoryProvenance] = []
            for input in fn.inputs:
                bound: sview = easm_binding_register(input)
                if bound != "":
                    easm_provenance_set_parameter(states, bound, easm_param_type(fn, easm_binding_name(input)), easm_binding_name(input))
            for instruction in fn.instructions:
                continue if instruction.pseudo
                source: sview = easm_substitute_operand(easm_first_operand(instruction.text), instruction)
                destination: sview = easm_substitute_operand(easm_last_operand(instruction.text), instruction)
                source_is_memory: bool = easm_memory_operand(source)
                destination_is_memory: bool = easm_memory_operand(destination)
                if source_is_memory or destination_is_memory:
                    memory_operand: sview = destination if destination_is_memory else source
                    base: sview = easm_memory_base_register(memory_operand)
                    if base != "" and base != "rsp" and base != "rip":
                        carrier_name: sview = easm_provenance_parameter(states, base)
                        if carrier_name != "":
                            if easm_memory_writes(instruction) and not easm_contract_has_word(fn.changes, carrier_name):
                                issues.push(Issue{severity: Severity.Error, code: "frame-write-outside-changes", line: instruction.line, message: "memory write uses a carrier not listed in changes"})
                            if easm_memory_reads(instruction) and not easm_contract_has_word(fn.reads, carrier_name) and not easm_contract_has_word(fn.changes, carrier_name):
                                issues.push(Issue{severity: Severity.Error, code: "frame-read-outside-reads", line: instruction.line, message: "memory read uses a carrier not listed in reads or changes"})
                easm_update_memory_provenance(states, instruction)

        def easm_verify_machine_roles(fn: Function, issues: mutable darray[Issue]&) -> void:
            if easm_contract_has_word(fn.requires, "x86_64.segment.write") and not easm_contract_has_word(fn.requires, "x86_64.segment.selector.untyped"):
                for parameter in fn.params:
                    if easm_find(easm_trim(parameter.name), "selector") < (easm_trim(parameter.name)).len and easm_raw_scalar_type(parameter.type_name):
                        issues.push(Issue{severity: Severity.Error, code: "raw-segment-selector", line: fn.line, message: "segment-mutating EASM requires a typed segment selector or an explicit untyped override"})
            if easm_contract_has_word(fn.requires, "control.indirect") and not easm_contract_has_word(fn.requires, "control.target.untyped"):
                for input in fn.inputs:
                    parameter_name: sview = easm_trim(easm_binding_name(input))
                    if (easm_find(parameter_name, "target") < parameter_name.len or easm_find(parameter_name, "callee") < parameter_name.len) and easm_raw_scalar_type(easm_param_type(fn, parameter_name)):
                        issues.push(Issue{severity: Severity.Error, code: "raw-indirect-control-target", line: fn.line, message: "indirect-control target must use a typed callable role or an explicit untyped override"})
            if (easm_contract_has_word(fn.control, "tail_jumps") or easm_contract_has_word(fn.control, "noreturn")) and not easm_contract_has_word(fn.requires, "stack.owner.untyped"):
                for parameter in fn.params:
                    parameter_name: sview = easm_trim(parameter.name)
                    if easm_find(parameter_name, "stack") < parameter_name.len and easm_find(parameter_name, "top") < parameter_name.len and easm_raw_scalar_type(parameter.type_name):
                        issues.push(Issue{severity: Severity.Error, code: "raw-stack-handoff", line: fn.line, message: "stack handoff must use a typed stack role or an explicit untyped override"})

        def easm_param_type(fn: Function, name: sview) -> sview:
            for parameter in fn.params:
                if easm_equal(parameter.name, name):
                    return parameter.type_name
            return ""

        def easm_binding_name(binding: sview) -> sview:
            equals: usize = easm_find(binding, "=")
            if equals >= binding.len:
                return ""
            return easm_trim(binding[0:equals])

        def easm_verify_handles(fn: Function, issues: mutable darray[Issue]&) -> void:
            handle_registers: mutable darray[sview] = []
            handle_kinds: mutable darray[sview] = []
            for input in fn.inputs:
                name: sview = easm_binding_name(input)
                typ: sview = easm_param_type(fn, name)
                if easm_starts(typ, "Handle[") and easm_find(typ, "]") < typ.len:
                    equals: usize = easm_find(input, "=")
                    register: sview = easm_register_operand(input[equals + 1.usize():input.len])
                    if register.len > 0:
                        handle_registers.push(register)
                        close: usize = easm_find(typ, "]")
                        handle_kinds.push(typ[7:close])
            for instruction in fn.instructions:
                continue if instruction.pseudo
                for handle_index in 0..<handle_registers.count |handle_registers, handle_kinds, instruction, fn, issues|:
                    source_operand: sview = easm_substitute_operand(easm_first_operand(instruction.text), instruction)
                    destination_operand: sview = easm_substitute_operand(easm_last_operand(instruction.text), instruction)
                    source_uses_handle: bool = easm_memory_operand(source_operand) and easm_memory_base_register(source_operand) == handle_registers[handle_index]
                    destination_uses_handle: bool = easm_memory_operand(destination_operand) and easm_memory_base_register(destination_operand) == handle_registers[handle_index]
                    if source_uses_handle or destination_uses_handle:
                        issues.push(Issue{severity: Severity.Error, code: "handle-deref-forbidden", line: instruction.line, message: "opaque Handle value cannot be used as a memory base"})

        def easm_callee_saved_unprotected(fn: Function) -> bool:
            if easm_contract_has_word(fn.preserves, "callee_saved") or easm_contract_has_word(fn.requires, "callee_saved.preservation.unchecked"):
                return false
            return (easm_contract_has_word(fn.clobbers, "rbx") or easm_contract_has_word(fn.clobbers, "rbp") or easm_contract_has_word(fn.clobbers, "r12") or easm_contract_has_word(fn.clobbers, "r13") or easm_contract_has_word(fn.clobbers, "r14") or easm_contract_has_word(fn.clobbers, "r15")) and not easm_contract_has_word(fn.preserves, "rbx") and not easm_contract_has_word(fn.preserves, "rbp") and not easm_contract_has_word(fn.preserves, "r12") and not easm_contract_has_word(fn.preserves, "r13") and not easm_contract_has_word(fn.preserves, "r14") and not easm_contract_has_word(fn.preserves, "r15")

        const EASM_I64_MIN: i64 = -9223372036854775807 - 1
        const EASM_I64_MAX: i64 = 9223372036854775807

        def easm_i64_add_checked(left: i64, right: i64) -> (valid: bool, value: i64):
            if right > 0 and left > EASM_I64_MAX - right:
                return (false, 0)
            if right < 0 and left < EASM_I64_MIN - right:
                return (false, 0)
            return (true, left + right)

        def easm_i64_sub_checked(left: i64, right: i64) -> (valid: bool, value: i64):
            if right > 0 and left < EASM_I64_MIN + right:
                return (false, 0)
            if right < 0 and left > EASM_I64_MAX + right:
                return (false, 0)
            return (true, left - right)

        def easm_rsp_stack_slot(operand: sview, stack_delta: i64, stack_known: bool) -> (valid: bool, offset: i64):
            if not stack_known or not easm_memory_operand(operand) or easm_memory_base_register(operand) != "rsp" or easm_memory_index_register(operand) != "":
                return (false, 0)
            displacement: (valid: bool, value: i64) = easm_memory_displacement_checked(operand)
            return easm_i64_add_checked(stack_delta, displacement.value) if displacement.valid else (false, 0)

        def easm_verify_callee_saved_preservation(fn: Function, issues: mutable darray[Issue]&) -> void:
            registers: darray[sview] = ["rbx", "rbp", "r12", "r13", "r14", "r15"]
            for register in registers:
                if easm_contract_has_exact(fn.preserves, register) and not easm_contract_has_exact(fn.clobbers, register):
                    issues.push(Issue{severity: Severity.Error, code: "preserve-without-clobber", line: fn.line, message: "preserves declares a callee-saved register that is absent from clobbers"})
                preserved: bool = easm_contract_has_exact(fn.preserves, register) or easm_contract_has_exact(fn.preserves, "callee_saved")
                continue if not preserved or not easm_contract_has_exact(fn.clobbers, register) or easm_contract_has_exact(fn.requires, "callee_saved.preservation.unchecked")
                saved: mutable bool = false
                saved_slot: mutable i64 = 0
                stack_delta: mutable i64 = 0
                stack_known: mutable bool = true
                written: mutable bool = false
                restored_after_write: mutable bool = false
                control_flow_unsafe: mutable bool = false
                for instruction in fn.instructions:
                    if instruction.pseudo:
                        if instruction.op == "label":
                            control_flow_unsafe <- true if written and not restored_after_write
                            saved <- false
                        continue
                    operand_scan: (start: usize, count: usize, first_separator: usize, last_separator: usize, has_address_group: bool, address_open: usize, address_close: usize, valid: bool) = EasmOperandScan::scan_instruction(instruction.text)
                    raw_source_operand: mutable sview = ""
                    raw_destination_operand: mutable sview = ""
                    if operand_scan.valid and operand_scan.count > 0:
                        source_end: usize = operand_scan.first_separator if operand_scan.first_separator < instruction.text.len else instruction.text.len
                        destination_start: usize = operand_scan.last_separator + 1.usize() if operand_scan.last_separator < instruction.text.len else operand_scan.start
                        raw_source_operand <- easm_trim(instruction.text[operand_scan.start:source_end])
                        raw_destination_operand <- easm_trim(instruction.text[destination_start:instruction.text.len])
                    source_operand: sview = easm_substitute_operand(raw_source_operand, instruction)
                    destination_operand: sview = easm_substitute_operand(raw_destination_operand, instruction)
                    source: sview = easm_register_operand(source_operand)
                    destination: sview = easm_register_operand(destination_operand)
                    is_push: bool = easm_starts(instruction.op, "push")
                    is_pop: bool = easm_starts(instruction.op, "pop")
                    is_label: bool = instruction.op == "label"
                    is_jump: bool = easm_starts(instruction.op, "j")
                    is_return: bool = easm_starts(instruction.op, "ret")
                    is_full_width_mov: bool = instruction.op == "mov" or instruction.op == "movq"
                    push_slot: (valid: bool, value: i64) = easm_i64_sub_checked(stack_delta, 8)
                    if is_label or is_jump:
                        control_flow_unsafe <- true if written and not restored_after_write
                        saved <- false
                    control_flow_unsafe <- true if is_return and written and not restored_after_write
                    save_slot: (valid: bool, offset: i64) = easm_rsp_stack_slot(destination_operand, stack_delta, stack_known) if is_full_width_mov and source == register else (false, 0)
                    is_register_save: bool = save_slot.valid and (not written or restored_after_write)
                    is_push_save: bool = is_push and source == register and stack_known and push_slot.valid and (not written or restored_after_write)
                    if is_push_save:
                        saved <- true
                        saved_slot <- push_slot.value
                    if is_register_save:
                        saved <- true
                        saved_slot <- save_slot.offset
                    memory_writes: bool = EasmMemoryEffectPolicy::memory_writes(instruction.op, instruction.pseudo, easm_memory_operand(destination_operand), easm_memory_operand(source_operand))
                    if saved and not is_register_save and (memory_writes or instruction.op == "call" or instruction.op == "callq"):
                        saved <- false
                    if saved and is_push and not is_push_save:
                        saved <- false if not stack_known or not push_slot.valid or push_slot.value == saved_slot
                    restore_slot: (valid: bool, offset: i64) = (stack_known, stack_delta) if (instruction.op == "pop" or instruction.op == "popq") and destination == register else easm_rsp_stack_slot(source_operand, stack_delta, stack_known) if is_full_width_mov and destination == register else (false, 0)
                    restores_saved_slot: bool = restore_slot.valid and saved and restore_slot.offset == saved_slot
                    if written and restores_saved_slot:
                        restored_after_write <- true
                    register_bit: i64 = easm_register_bit(register)
                    writes_register: mutable bool = (easm_implicit_write_mask(instruction.op) & register_bit) != 0
                    if not easm_starts(instruction.op, "cmp") and not easm_starts(instruction.op, "test") and not is_push and not easm_starts(instruction.op, "call") and not easm_starts(instruction.op, "jmp") and not is_return:
                        writes_register <- true if (easm_register_bit(destination) & register_bit) != 0
                        writes_register <- true if easm_starts(instruction.op, "xchg") and (easm_register_bit(source) & register_bit) != 0
                    if writes_register and not is_push and not restores_saved_slot:
                        written <- true
                        restored_after_write <- false
                    if is_push:
                        if instruction.op == "push" or instruction.op == "pushq":
                            push_stack: (valid: bool, value: i64) = easm_i64_sub_checked(stack_delta, 8)
                            if stack_known and push_stack.valid:
                                stack_delta <- push_stack.value
                            else:
                                stack_known <- false
                        else:
                            stack_known <- false
                    elif is_pop:
                        if easm_register_bit(destination) == EasmRegisterMasks::RSP:
                            stack_known <- false
                        elif instruction.op == "pop" or instruction.op == "popq":
                            pop_stack: (valid: bool, value: i64) = easm_i64_add_checked(stack_delta, 8)
                            if stack_known and pop_stack.valid:
                                stack_delta <- pop_stack.value
                            else:
                                stack_known <- false
                        else:
                            stack_known <- false
                    elif easm_starts(instruction.op, "add") or easm_starts(instruction.op, "sub"):
                        if easm_register_bit(destination) == EasmRegisterMasks::RSP:
                            immediate: (valid: bool, value: i64) = easm_immediate_operand_after_dollar_checked(source_operand)
                            if destination != "rsp" or not immediate.valid:
                                stack_known <- false
                            else:
                                adjusted_stack: (valid: bool, value: i64) = easm_i64_add_checked(stack_delta, immediate.value) if easm_starts(instruction.op, "add") else easm_i64_sub_checked(stack_delta, immediate.value)
                                if stack_known and adjusted_stack.valid:
                                    stack_delta <- adjusted_stack.value
                                else:
                                    stack_known <- false
                    elif (easm_register_bit(destination) == EasmRegisterMasks::RSP or (easm_starts(instruction.op, "xchg") and easm_register_bit(source) == EasmRegisterMasks::RSP)) or instruction.op == "leave" or instruction.op == "enter":
                        stack_known <- false
                if written and (not restored_after_write or control_flow_unsafe):
                    issues.push(Issue{severity: Severity.Error, code: "callee-saved-preservation-unproven", line: fn.line, message: "callee-saved register is clobbered but no save-before-write and restore-after-write proof was found"})

        def easm_required_capability(op: sview) -> sview:
            if easm_equal(op, "xchg") or easm_equal(op, "xchgl") or easm_equal(op, "xchgq"):
                return "x86_64.atomic.rmw"
            if easm_equal(op, "cpuid"):
                return "x86_64.cpuid"
            if easm_equal(op, "rdtsc"):
                return "x86_64.rdtsc"
            if easm_equal(op, "lfence"):
                return "x86_64.sse.lfence"
            if easm_equal(op, "pause"):
                return "x86_64.sse.pause"
            if easm_equal(op, "yield"):
                return "aarch64.yield"
            if easm_equal(op, "mrs") or easm_equal(op, "isb"):
                return "aarch64.cntvct"
            if easm_equal(op, "fldcw") or easm_equal(op, "fnstcw") or easm_equal(op, "stmxcsr") or easm_equal(op, "ldmxcsr") or easm_equal(op, "emms"):
                return "x86_64.fpu_control"
            if easm_equal(op, "vzeroall"):
                return "x86_64.simd_state"
            if easm_equal(op, "trap"):
                return "debug.trap"
            return ""

        def easm_operation_effect(op: sview) -> OperationEffect:
            known: bool = easm_known_op(op)
            capability: sview = easm_required_capability(op)
            flags: bool = easm_equal(op, "add") or easm_equal(op, "addq") or easm_equal(op, "sub") or easm_equal(op, "subq") or easm_equal(op, "and") or easm_equal(op, "andq") or easm_equal(op, "or") or easm_equal(op, "orq") or easm_equal(op, "xor") or easm_equal(op, "xorq") or easm_equal(op, "inc") or easm_equal(op, "incq") or easm_equal(op, "dec") or easm_equal(op, "decq") or easm_equal(op, "neg") or easm_equal(op, "negq") or easm_equal(op, "cmp") or easm_equal(op, "cmpq") or easm_equal(op, "test") or easm_equal(op, "testq") or easm_equal(op, "shl") or easm_equal(op, "shlq") or easm_equal(op, "sal") or easm_equal(op, "salq") or easm_equal(op, "shr") or easm_equal(op, "shrq") or easm_equal(op, "sar") or easm_equal(op, "sarq") or easm_equal(op, "cld") or easm_equal(op, "std")
            implicit_reads: i64 = easm_implicit_read_mask(op)
            implicit_writes: mutable i64 = easm_implicit_write_mask(op)
            if easm_equal(op, "call") or easm_equal(op, "callq"):
                implicit_writes <- EasmRegisterMasks::call_clobber_mask()
            return OperationEffect{known: known, capability: capability, clobbers_flags: flags, implicit_cc: easm_equal(op, "call") or easm_equal(op, "callq"), implicit_reads: implicit_reads, implicit_writes: implicit_writes, result_defines: easm_equal(op, "cpuid") or easm_equal(op, "rdtsc")}

        def easm_implicit_read_mask(op: sview) -> i64:
            if easm_equal(op, "cpuid"):
                return EasmRegisterMasks::cpuid_read_mask()
            return 0

        def easm_implicit_write_mask(op: sview) -> i64:
            ensure result == EasmRegisterMasks::implicit_result_write_mask(op)
            return EasmRegisterMasks::implicit_result_write_mask(op)

        def easm_immediate_operand_after_dollar_checked(operand: sview) -> (valid: bool, value: i64):
            dollar: usize = easm_find(operand, "$")
            if dollar >= operand.len:
                return (false, 0)
            parsed: (valid: bool, value: i64) = easm_parse_i64_checked(easm_trim(operand[dollar + 1.usize():operand.len]))
            return (false, 0) if not parsed.valid or parsed.value < -2147483648 or parsed.value > 2147483647
            return parsed

        def easm_immediate_after_dollar_checked(text: sview) -> (valid: bool, value: i64):
            return easm_immediate_operand_after_dollar_checked(easm_first_operand(text))

        def easm_immediate_after_dollar(text: sview) -> i64:
            parsed: (valid: bool, value: i64) = easm_immediate_after_dollar_checked(text)
            return parsed.value if parsed.valid else 0


        # Lockstep bodies are independently executable implementations.  Stage0 verifies the
        # reference and every target with the complete ordinary-function verifier; keeping only
        # the structural lockstep checks here would let a target bypass capability, clobber,
        # memory, frame, handle, or register-read enforcement.  Build an isolated one-function
        # view with the selected body and send it through verify_module's ordinary path.
        def verify_lockstep_body(module: Module, source: Function, instructions: darray[Instruction]) -> darray[Issue]:
            body: mutable Function = source
            body.instructions <- instructions
            body.reference <- []
            body.targets <- []
            body_module: mutable Module = module
            body_module.functions <- [body]
            body_module.fragments <- []
            body_module.templates <- []
            body_module.issues <- []
            return verify_module(body_module)

        def verify_module_layouts(module: Module, issues: mutable darray[Issue]&):
            issues.reserve(issues.count + module.layouts.count)
            for layout in module.layouts:
                total: (valid: bool, value: i64) = layout_size_checked(layout)
                for field in layout.fields:
                    if field.offset < 0:
                        issues.push(Issue{severity: Severity.Error, code: "layout-negative-offset", line: field.line, message: "layout field offset must be non-negative"})
                        continue
                    if field.width < 0:
                        issues.push(Issue{severity: Severity.Error, code: "layout-negative-width", line: field.line, message: "layout field width must be non-negative"})
                        continue
                    extent: (valid: bool, value: i64) = EasmLayoutArithmetic::field_extent_checked(field.offset, field.width)
                    if not extent.valid:
                        issues.push(Issue{severity: Severity.Error, code: "layout-field-extent-overflow", line: field.line, message: "layout field extent is not representable as a nonnegative signed 64-bit value"})
                        continue
                    if field.width > 0 and total.valid and total.value > 0 and extent.value > total.value:
                        issues.push(Issue{severity: Severity.Error, code: "layout-field-out-of-bounds", line: field.line, message: "layout field extends past the declared layout size"})


        def verify_module_protocols(module: Module, issues: mutable darray[Issue]&):
            issues.reserve(issues.count + module.protocols.count)
            for protocol in module.protocols:
                for method_index in 0..<protocol.methods.count |protocol|:
                    for earlier_method in 0..<method_index |protocol|:
                        if protocol.methods[method_index].name == protocol.methods[earlier_method].name:
                            issues.push(Issue{severity: Severity.Error, code: "duplicate-protocol-method", line: protocol.line, message: "protocol method duplicates an earlier declaration"})
