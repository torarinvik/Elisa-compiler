# Stage1 backend — the module entry points: `emit_module` and its debug/trace variants.
# Part of `module Backend` (see codegen.elisa); split out to keep each file short.

extend Backend:
    # A declined body is link-blocking only if it is reachable from an externally
    # visible definition. A direct-use check is too conservative for optimized
    # programs: an otherwise valid private helper may call a declined helper even
    # though no exported function can reach either one. At -O2 these private dead
    # chains are removed by LLVM; rejecting them here made target-inapplicable
    # runtime code (for example POSIX synchronization helpers in a WASM module)
    # prevent unrelated exports from being emitted.
    #
    # Walk the reverse use graph from the declined declaration. A defined
    # externally-linked user is a live root; a private/internal user is followed
    # recursively. Unknown non-instruction users remain conservatively live,
    # because their owning global/alias cannot be recovered through this API.
    # Linkage values 8/9 are the backend's LLVMInternalLinkage/LLVMPrivateLinkage.
    def declined_function_has_live_use(handle: LLVMValueRef) -> bool can[Abort.Panic, Memory.Allocate]:
        pending: mutable darray[LLVMValueRef] = [handle]
        visited: mutable darray[LLVMValueRef] = []
        cursor: mutable usize = 0
        while cursor < pending.count |pending, visited, cursor|:
            current_function: LLVMValueRef = pending[cursor]
            cursor <- cursor + 1
            already_visited: mutable bool = false
            for seen_index in 0..<visited.count |already_visited, visited, current_function|:
                already_visited <- true if visited[seen_index] == current_function
            continue if already_visited
            visited.push(current_function)

            current_use: mutable LLVMUseRef? = LLVMGetFirstUse(current_function)
            while current_use is use |pending, visited, current_function, current_use|:
                user: LLVMValueRef = LLVMGetUser(use)
                if LLVMIsAInstruction(user) is user_instruction:
                    user_block: LLVMBasicBlockRef = LLVMGetInstructionParent(user)
                    return true if user_block == zeroed
                    user_function: LLVMValueRef = LLVMGetBasicBlockParent(user_block)
                    if LLVMGetFirstBasicBlock(user_function) is user_body:
                        user_linkage: u32 = LLVMGetLinkage(user_function)
                        return true if user_linkage != 8 and user_linkage != 9
                        pending.push(user_function)
                else:
                    return true
                current_use <- LLVMGetNextUse(use)
        return false

    public:
        # The driver-side safety report must inspect the same target-selected declaration set
        # as native code generation. Keep the StructTable private: this façade exposes only the
        # declarations, while still sharing register_target_consts/fold_consts and therefore
        # cannot drift into reporting inactive static branches.
        def select_declarations_for_report(file: Ast::File&) -> darray[Decl] can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            ctx: LLVMContextRef = LLVMContextCreate()
            module_handle: LLVMModuleRef = LLVMModuleCreateWithNameInContext("elisac_stage1_unsafe", ctx)
            machine: void& = configure_module_target_for(module_handle, "")
            target_data: LLVMTargetDataRef = LLVMCreateTargetDataLayout(machine)
            structs: mutable StructTable = new_struct_table(ctx, target_data)
            return select_module_declarations(file, &structs)


        # The unsafe report also walks statement bodies. Expose the exact branch heads selected
        # by the same target-constant fold used by code generation, so it never audits a dead
        # static branch merely because the parser retained it in the AST.
        def selected_static_offsets_for_report(file: Ast::File&) -> darray[u32] can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            ctx: LLVMContextRef = LLVMContextCreate()
            module_handle: LLVMModuleRef = LLVMModuleCreateWithNameInContext("elisac_stage1_unsafe_offsets", ctx)
            machine: void& = configure_module_target_for(module_handle, "")
            target_data: LLVMTargetDataRef = LLVMCreateTargetDataLayout(machine)
            structs: mutable StructTable = new_struct_table(ctx, target_data)
            _ = select_module_declarations(file, &structs)
            return structs.annotations.static_taken_offsets


        def declaration_is_static_function(annotations: darray[Ast::EnumAnnotation]&, declaration: Decl) -> bool can[Abort.Panic]:
            return match declaration:
                Decl.Func(function_name, params, return_type, body, effects, decorators, position):
                    any annotation in annotations where annotation.owner == "__static_fn" and annotation.name == function_name and annotation.line == position.line and annotation.offset == position.offset
                _:
                    false


        # Static functions can appear inside module and impl scopes. Strip them
        # recursively after static-if flattening, using their declaration-head offset
        # so repeated #line values and same-name functions cannot cross-filter.
        def declaration_without_static_functions(annotations: darray[Ast::EnumAnnotation]&, declaration: Decl) -> Decl can[Abort.Panic, Memory.Allocate]:
            match declaration:
                Decl.Module(module_name, module_body, module_pos):
                    filtered_module: mutable darray[Decl] @source = []
                    for nested in module_body |filtered_module, annotations|:
                        continue if declaration_is_static_function(annotations, nested)
                        filtered_module.push(declaration_without_static_functions(annotations, nested))
                    return Decl.Module(module_name, filtered_module, module_pos)
                Decl.Scoped(scoped_body, scoped_pos):
                    filtered_scope: mutable darray[Decl] @source = []
                    for nested in scoped_body |filtered_scope, annotations|:
                        continue if declaration_is_static_function(annotations, nested)
                        filtered_scope.push(declaration_without_static_functions(annotations, nested))
                    return Decl.Scoped(filtered_scope, scoped_pos)
                _:
                    declaration


        # Alias and target annotations share one token offset. An alias nested
        # inside static branches is visible only when every enclosing row is selected.
        def register_selected_module_aliases(alias_rows: darray[Ast::EnumAnnotation]&, selected_rows: darray[u32]&, structs: mutable StructTable&) -> void can[Abort.Panic, Memory.Allocate]:
            blocked: mutable darray[u32] = []
            for marker in alias_rows |blocked, selected_rows|:
                if marker.name == "__using_alias_static_branch" and not static_branch_is_taken(selected_rows, marker.identity_id):
                    blocked.push(marker.offset)
            structs.aliases.module_alias_names <- structs.aliases.module_alias_names.truncate(0)
            structs.aliases.module_alias_scopes <- structs.aliases.module_alias_scopes.truncate(0)
            structs.aliases.module_alias_offsets <- structs.aliases.module_alias_offsets.truncate(0)
            structs.aliases.module_alias_targets <- structs.aliases.module_alias_targets.truncate(0)
            for annotation in alias_rows |structs, blocked|:
                continue if static_branch_is_taken(blocked, annotation.offset)
                if annotation.name == "__using_alias":
                    structs.aliases.module_alias_names.push(annotation.owner)
                    structs.aliases.module_alias_scopes.push(annotation.module)
                    structs.aliases.module_alias_offsets.push(annotation.offset)
                if annotation.name == "__using_alias_target":
                    structs.aliases.module_alias_targets.push(annotation.owner)

        def same_static_rows(left: darray[u32]&, right: darray[u32]&) -> bool can[Abort.Panic]:
            return false if left.count != right.count
            for index in 0..<left.count:
                return false if left[index] != right[index]
            return true


        def select_module_declarations(file: Ast::File&, structs: mutable StructTable&) -> darray[Decl] can[Abort.Panic, Memory.Allocate]:
            register_target_consts(structs)
            register_fn_signatures(file, structs)
            alias_rows: mutable darray[Ast::EnumAnnotation] = []
            has_static_alias: mutable bool = false
            for annotation in file.enum_annotations |alias_rows, has_static_alias|:
                is_marker: bool = annotation.owner == "__static_if_branch" and annotation.name == "__using_alias_static_branch"
                has_static_alias <- true if is_marker
                alias_rows.push(annotation) if is_marker or annotation.name == "__using_alias" or annotation.name == "__using_alias_target"
            selected_rows: mutable darray[u32] = []
            register_selected_module_aliases(alias_rows, selected_rows, structs)
            static_branch_offsets: darray[u32] = file.static_if_offsets
            # Impl membership must be captured BEFORE flattening erases the Scoped nodes.
            record_impl_member_lines(file.top_decls, file.enum_annotations, structs)
            structs.annotations.decl_line_rows <- file.func_decl_lines
            structs.annotations.decl_column_rows <- file.func_decl_columns
            structs.annotations.panic_line_rows <- file.panic_lines
            structs.annotations.panic_column_rows <- file.panic_columns
            top: mutable darray[Decl] = []
            for _selection_round in 0..<(file.static_if_lines.count + 1) |top, structs, file, static_branch_offsets, alias_rows, selected_rows, has_static_alias|:
                round_rows: darray[u32] = selected_static_if_rows(file, structs)
                rows_changed: bool = not same_static_rows(round_rows, selected_rows)
                register_selected_module_aliases(alias_rows, round_rows, structs) if rows_changed and has_static_alias
                selected_rows <- round_rows
                round_taken_offsets: darray[u32] = static_if_offsets_for_rows(file, selected_rows)
                round_top: mutable darray[Decl] = []
                flatten_static_branches(file.top_decls, static_branch_offsets, round_taken_offsets, round_top)
                hoisted_top: mutable darray[Decl] = []
                hoist_nested_modules(round_top, hoisted_top)
                settled: bool = hoisted_top.count == top.count and not rows_changed
                top <- hoisted_top
                break if settled
                for round_index in 0..<top.count |structs|:
                    round_declaration: Decl = top[round_index]
                    if declaration_is_module(round_declaration):
                        for nested_index in 0..<declaration_module_count(round_declaration) |file, structs, round_declaration|:
                            register_const(declaration_module_at(round_declaration, nested_index), module_name_of(round_declaration), file.enum_annotations, structs)
                    else:
                        register_const(round_declaration, "", file.enum_annotations, structs)
                fold_consts(file, top, structs)
            structs.annotations.static_branch_lines <- file.static_if_lines
            structs.annotations.static_branch_offsets <- file.static_if_offsets
            # `static def` functions are COMPILE-TIME ONLY (evaluated during static
            # execution; stage0 emits no runtime code for them). Dropping them here keeps
            # both the declare and the body pass from seeing them, so an exotic static-only
            # body (reflection, static comprehensions) cannot decline anything. The parser
            # records each as a `__static_fn` annotation (name, line, and declaration offset).
            # The `__static_fn` rows are collected once before recursively filtering the
            # declaration tree; matching only the top-level list missed module/impl bodies.
            static_fn_rows: darray[Ast::EnumAnnotation] = annotations_owned_by(file.enum_annotations, "__static_fn")
            if static_fn_rows.count > 0:
                static_fn_filtered: mutable darray[Decl] = []
                for kept_declaration in top |static_fn_filtered, static_fn_rows|:
                    continue if declaration_is_static_function(static_fn_rows, kept_declaration)
                    static_fn_filtered.push(declaration_without_static_functions(static_fn_rows, kept_declaration))
                top <- static_fn_filtered
            effect_template_annotations: mutable darray[Ast::EnumAnnotation] = []
            for annotation in file.enum_annotations |effect_template_annotations|:
                effect_template_annotations.push(annotation) if annotation.owner == "__effect_template"
            if effect_template_annotations.count > 0:
                effect_template_filtered: mutable darray[Decl] = []
                for kept_declaration in top |effect_template_filtered, effect_template_annotations|:
                    effect_template_filtered.push(declaration_without_effect_templates(effect_template_annotations, kept_declaration)) if not declaration_is_effect_template(effect_template_annotations, kept_declaration)
                top <- effect_template_filtered
            structs.annotations.static_taken_lines <- structs.annotations.static_taken_lines.truncate(0)
            structs.annotations.static_taken_offsets <- structs.annotations.static_taken_offsets.truncate(0)
            for selected_row in selected_rows |structs, file|:
                continue if selected_row.usize() >= file.static_if_lines.count or selected_row.usize() >= file.static_if_offsets.count
                structs.annotations.static_taken_lines <- structs.annotations.static_taken_lines.push(file.static_if_lines[selected_row.usize()])
                structs.annotations.static_taken_offsets <- structs.annotations.static_taken_offsets.push(file.static_if_offsets[selected_row.usize()])
            return top

        def register_caller_view_factories(file: Ast::File&, top: darray[Decl]&, structs: mutable StructTable&) -> void:
            can Abort.Panic, Memory.Allocate:
                names: mutable darray[sview @source] = []
                for declaration in top |structs, names, file|:
                    if Ast::returns_ambient_byte_view(file, declaration):
                        structs.annotations.caller_view_offsets.push(function_offset_of(declaration))
                        names.push(function_name_of(declaration))
                return if names.count == 0
                wrappers: mutable darray[Decl] = []
                targets: mutable darray[sview @source] = []
                for declaration in top |wrappers, targets, file|:
                    target: sview @source = Ast::ambient_view_forward_target(file, declaration)
                    if target != "":
                        wrappers.push(declaration)
                        targets.push(target)
                # Each successful pass grows the known set. A cycle without
                # a known allocator cannot seed caller-arena inference.
                changed: mutable bool = true
                while changed |changed, structs, names, targets, wrappers, top|:
                    changed <- false
                    for row in 0..<targets.count |changed, structs, names, targets, wrappers, top|:
                        target: sview @source = targets[row]
                        continue if target == "" or not (any name in names where name == target)
                        matching_functions: usize = count candidate in top where function_name_of(candidate) == target
                        continue if matching_functions != 1
                        structs.annotations.caller_view_offsets.push(function_offset_of(wrappers[row]))
                        names.push(function_name_of(wrappers[row]))
                        targets[row] <- ""
                        changed <- true

        def register_module_types(file: Ast::File&, top: darray[Decl]&, structs: mutable StructTable&, m: LLVMModuleRef, ctx: LLVMContextRef) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                register_caller_view_factories(file, top, structs)
                register_private_fields(file.top_decls, "", structs)
                register_generic_structs(file, top, structs)
                # Reserve the AST packed-store headers ONLY for a program that actually
                # declares the Node hierarchy. Reserving them unconditionally put `Node`,
                # `Expr`, `Stmt`, `Decl` and `Pattern` into the packed registry for EVERY
                # program, so an ordinary user `enum Expr:` found a packed slot already
                # present and was treated as a packed AoS enum -- every construction and
                # match against it declined, while the byte-identical program with the enum
                # renamed to `Shape` compiled.
                #
                # The parser marks generic user/compiler hierarchies with `__ast_refinement`,
                # but reserves `__compiler_ast_refinement` for the compiler's own Node store.
                # Only the latter should trigger the hidden AST headers.
                file_has_ast_refinement: mutable bool = false
                structs.packed_layouts.ast_refinement_names <- structs.packed_layouts.ast_refinement_names.truncate(0)
                structs.packed_layouts.ast_refinement_modules <- structs.packed_layouts.ast_refinement_modules.truncate(0)
                structs.packed_layouts.ast_refinement_epoch <- structs.packed_layouts.ast_refinement_epoch + 1
                for ast_annotation in file.enum_annotations |file_has_ast_refinement, structs|:
                    if ast_annotation.name == "__compiler_ast_refinement":
                        file_has_ast_refinement <- true
                        structs.packed_layouts.ast_refinement_names.push(ast_annotation.owner) can Memory.Allocate
                        structs.packed_layouts.ast_refinement_modules.push(ast_annotation.module) can Memory.Allocate
                        structs.packed_layouts.ast_refinement_epoch <- structs.packed_layouts.ast_refinement_epoch + 1
                # The `is Parent` edges must be in place BEFORE packed registration, which
                # asks whether an enum is a sealed hierarchy ROOT; the general annotation
                # scan below runs after registration and would answer that with an empty table.
                for hierarchy_annotation in file.enum_annotations |structs|:
                    structs.packed_layouts.hierarchy_child <- structs.packed_layouts.hierarchy_child.push(hierarchy_annotation.owner) if hierarchy_annotation.line == 3900000008
                    structs.packed_layouts.hierarchy_parent <- structs.packed_layouts.hierarchy_parent.push(hierarchy_annotation.name) if hierarchy_annotation.line == 3900000008
                    structs.packed_layouts.hierarchy_modules <- structs.packed_layouts.hierarchy_modules.push(hierarchy_annotation.module) if hierarchy_annotation.line == 3900000008
                reserve_ast_packed_headers(structs) if file_has_ast_refinement
                register_struct_names(file, structs, ctx)
                # Packed AST variants can contain ordinary fieldless enums and aliases
                # such as TokenKind. Resolve those dependencies before inspecting packed
                # payloads; otherwise Expr/Stmt/Decl are conservatively discarded.
                register_aliases(file, structs)
                # This metadata-derived set is read by all three registration passes below.
                # Build it once: each independent packed_or_ast_enum_names call rescans the
                # full annotation table and reconstructs the same list before these enum
                # registration passes mutate their registries.
                module_packed_or_ast: mutable darray[sview] = []
                packed_or_ast_enum_names(file, &module_packed_or_ast)
                packed_membership: PackedOwnerMembership = packed_owner_membership(file, module_packed_or_ast)
                register_enums_from_metadata(file, packed_membership, structs)
                resolve_aliases(file, structs)
                register_error_set_names(file, structs)
                register_packed_enums_from_metadata(file, module_packed_or_ast, packed_membership, structs)
                register_payload_enums_from_metadata(file, module_packed_or_ast, packed_membership, structs)
                register_composite_error_unions(file, structs) can Global{Read,Write}
                apply_struct_alignments(file.enum_annotations, structs)
                # Before struct BODIES are sized: register the `[size x i8]` alias for every
                # inline-storage `@c_opaque` extern (pthread_mutex_t/cond_t), so a struct FIELD of
                # one gets its real C size rather than an 8-byte handle (which would silently
                # race a struct-embedded mutex). The later declaration pass then skips these.
                register_opaque_extern_aliases(top, file.annotation_args, file.enum_annotations, structs)
                set_struct_bodies_from_metadata(file, structs, ctx)
                # AFTER the struct bodies: a payload enum carrying a struct can only be sized
                # once that struct's fields are known (see finalize_payload_enum_words).
                finalize_payload_enum_words(structs)
                penum_name_chain_extend(structs)
                finalize_overlay_field_widths(structs)
                for declaration_index in 0..<top.count |structs|:
                    declaration: Decl = top[declaration_index]
                    if declaration_is_module(declaration):
                        for nested_index in 0..<declaration_module_count(declaration) |file, structs, declaration|:
                            register_const(declaration_module_at(declaration, nested_index), module_name_of(declaration), file.enum_annotations, structs)
                    else:
                        register_const(declaration, "", file.enum_annotations, structs)
                fold_consts(file, top, structs)
                materialize_const_aggregates(file, top, structs, m, ctx)
                materialize_mutable_globals(file, top, structs, m, ctx)
                materialize_export_global_aliases(file.enum_annotations, structs, m, ctx)
                register_tuple_types(file.tuple_type_elements, file.tuple_type_starts, file.tuple_type_counts, file.tuple_type_lines, file.tuple_type_label_offsets, structs, ctx)
                # Only alias-scope metadata consumes these whole-program facts.
                # Keep the default compilation path free of the fixed-point scan
                # when its opt-in metadata consumer is disabled.
                register_disjoint_facts(top, file.enum_annotations, structs) if structs.target.noalias_mutable_refs
                register_drop_hooks(top, file.enum_annotations, structs)



include "./codegen_module_emit.elisa"
