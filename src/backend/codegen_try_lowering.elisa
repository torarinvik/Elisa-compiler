                        else:
                            te_fn_index: i64 = function_index_of(fns, error_callee_owner(fns, structs, te_name, te_owner), te_name)
                            null return if te_fn_index < 0
                            for _ in 0..<fns.arena_counts[te_fn_index.usize()] |te_call_values, te_threaded_arena|:
                                te_call_values.push(te_threaded_arena)
                        te_direct_index: i64 = function_index_of(fns, error_callee_owner(fns, structs, te_name, te_owner), te_name) if not te_generic_error else -1
                        te_family: mutable sview = resolved_error_family(te_error_family, structs) if te_generic_error else ""
                        te_family <- resolved_error_family(line_error_set_name(structs.error_fn_lines, structs.error_fn_set_names, fns.lines[te_direct_index.usize()]), structs) if te_direct_index >= 0
                        te_extern: bool = te_direct_index >= 0 and fns.is_extern[te_direct_index.usize()]
                        te_status: mutable LLVMValueRef = LLVMConstInt(LLVMInt32TypeInContext(ctx), 0, 0)
                        if emit_error_status_call(te_target, te_call_values, te_family, te_extern, structs, ctx, builder) is te_status_value:
