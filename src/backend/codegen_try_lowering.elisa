                    te_generic_slot: i64 = generic_index_of(generics, te_name)
                    te_is_generic: bool = te_generic_slot >= 0
                    if te_is_generic and not te_explicit:
                        te_inferred: darray[ValueType] = infer_generic_args(te_generic_slot.usize(), te_args, local_scope, fns, structs, generics)
                        null return if te_inferred.count != generics.param_count[te_generic_slot.usize()]
                        te_type_args.extend([copied_type(te_inferred_arg) for te_inferred_arg in te_inferred])
