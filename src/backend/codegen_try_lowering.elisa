                        te_declined: mutable bool = false
                        te_position: mutable usize = 0
                        for te_argument in te_args |te_call_values, te_declined, te_position, te_name, te_type_args, te_generic_error, local_scope, fns, structs, generics, runtime, m, ctx, builder|:
                            te_wanted: mutable ValueType = unmodeled_type()
