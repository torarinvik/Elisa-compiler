# Stage1 backend — lowering `try` and `try … else`: the propagating form in statement and value
# position, the error-union descriptor a call can yield instead, and the same pair for a
# GENERIC error-returning callee. Part of `module Backend` (see codegen.elisa).

extend Backend:
    private:


            # Find the same owner/tag in an error set whose merged order may differ from
            # the callee's. Prefer exact source-module provenance; Stage0 also allows a
            # cross-module propagation when exactly one owner/tag row exists in the target.
            # If the target contains several such rows, refusing the ambiguous fallback
            # prevents choosing the wrong payload layout.
        def error_set_variant_offset(set_index: i64, owner: sview, module: sview, variant: sview, structs: StructTable&) -> i64 can[Abort.Panic]:
            return -1 if set_index < 0 or set_index.usize() >= structs.payload_enums.penum_names.count
            start: usize = structs.payload_enums.penum_variant_start[set_index.usize()]
            count: usize = structs.payload_enums.penum_variant_count[set_index.usize()]
            fallback: mutable i64 = -1
            matches: mutable usize = 0
            for offset in 0..<count |start, structs, owner, module, variant, fallback, matches|:
                slot: usize = start + offset
                continue if structs.payload_enums.penum_variants[slot] != variant or structs.payload_enums.penum_variant_owners[slot] != owner
                return offset.i64() if slot < structs.payload_enums.penum_variant_modules.count and structs.payload_enums.penum_variant_modules[slot] == module
                fallback <- offset.i64() if fallback < 0
                matches <- matches + 1
            return fallback if matches == 1
            return -1




            # Fieldless `error Name:` declarations live in the const-enum registry rather
            # than the payload-enum registry. Expose their variants through the same
            # zero-based view used by payload error sets, because both error ABIs encode
            # failures as ordinal + 1.
        def error_status_variant_count(family: sview, structs: mutable StructTable&) -> usize can[Abort.Panic]:
            payload_index: i64 = penum_index_of(structs, family)
            return structs.payload_enums.penum_variant_count[payload_index.usize()] if payload_index >= 0
            plain_index: i64 = enum_index_of(structs, family)
            return structs.const_enums.enum_variant_count[plain_index.usize()] if plain_index >= 0
            return 0




        def error_status_variant_name(family: sview, offset: usize, structs: mutable StructTable&) -> sview can[Abort.Panic]:
            payload_index: i64 = penum_index_of(structs, family)
            if payload_index >= 0:
                return structs.payload_enums.penum_variants[structs.payload_enums.penum_variant_start[payload_index.usize()] + offset]
            plain_index: i64 = enum_index_of(structs, family)
            if plain_index >= 0:
                return structs.const_enums.enum_variants[structs.const_enums.enum_variant_start[plain_index.usize()] + offset]
            return ""




        def error_status_variant_owner(family: sview, offset: usize, structs: StructTable&) -> sview can[Abort.Panic]:
            payload_index: i64 = penum_index_of(structs, family)
            if payload_index >= 0:
                slot: usize = structs.payload_enums.penum_variant_start[payload_index.usize()] + offset
                return structs.payload_enums.penum_variant_owners[slot]
            # append_error_union_plain_family records the declared family as owner.
            return family


        def error_status_variant_module(family: sview, offset: usize, structs: StructTable&) -> sview can[Abort.Panic]:
            payload_index: i64 = penum_index_of(structs, family)
            if payload_index >= 0:
                slot: usize = structs.payload_enums.penum_variant_start[payload_index.usize()] + offset
                return structs.payload_enums.penum_variant_modules[slot] if slot < structs.payload_enums.penum_variant_modules.count
            plain_index: i64 = enum_index_of(structs, family)
            return enum_owner_at(structs, plain_index.usize()) if plain_index >= 0
            return ""
            # A propagating call is sound only when every callee variant and payload field
            # has a matching representation in the caller's error set.
        def error_status_remap_supported(source_family: sview, target_family: sview, structs: mutable StructTable&) -> bool can[Abort.Panic]:
            return true if source_family == target_family
            source_index: i64 = penum_index_of(structs, source_family)
            target_index: i64 = penum_index_of(structs, target_family)
            return false if target_index < 0
            source_count: usize = error_status_variant_count(source_family, structs)
            return false if source_count == 0
            for source_offset in 0..<source_count |source_family, source_index, target_index, structs|:
                target_offset: i64 = error_set_variant_offset(target_index,
                    error_status_variant_owner(source_family, source_offset, structs),
                    error_status_variant_module(source_family, source_offset, structs),
                    error_status_variant_name(source_family, source_offset, structs), structs)
                return false if target_offset < 0
                target_slot: usize = structs.payload_enums.penum_variant_start[target_index.usize()] + target_offset.usize()
                target_field_start: usize = structs.payload_enums.penum_field_type_start[target_slot]
                field_count: mutable usize = 0
                if source_index >= 0:
                    source_slot: usize = structs.payload_enums.penum_variant_start[source_index.usize()] + source_offset
                    field_count <- structs.payload_enums.penum_field_type_count[source_slot]
                    source_field_start: usize = structs.payload_enums.penum_field_type_start[source_slot]
                    return false if field_count != structs.payload_enums.penum_field_type_count[target_slot]
                    for field_offset in 0..<field_count |source_field_start, target_field_start, structs|:
                        source_type: ValueType = copied_type(structs.payload_enums.penum_field_types[source_field_start + field_offset])
                        target_type: ValueType = copied_type(structs.payload_enums.penum_field_types[target_field_start + field_offset])
                        return false if source_type.kind != target_type.kind or source_type.bits != target_type.bits
                return false if field_count != structs.payload_enums.penum_field_type_count[target_slot]
            return false if error_set_has_payload(structs, source_family) and not error_set_has_payload(structs, target_family)
            true




            # Translate both the error tag and (when present) its variant-specific fields.
            # Payload slots are concatenated by set order, so widening a set can move them.
        def remap_error_status(status: LLVMValueRef, source_family: sview, target_family: sview, structs: mutable StructTable&, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            return status if source_family == target_family
            return null if not error_status_remap_supported(source_family, target_family, structs)
            source_index: i64 = penum_index_of(structs, source_family)
            target_index: i64 = penum_index_of(structs, target_family)
            source_count: usize = error_status_variant_count(source_family, structs)
            source_code: LLVMValueRef = error_status_code(status, ctx, builder)
            mapped_code: mutable LLVMValueRef = source_code
            for source_offset in 0..<source_count |source_family, source_index, target_index, structs, source_code, mapped_code, ctx, builder|:
                target_offset: i64 = error_set_variant_offset(target_index,
                    error_status_variant_owner(source_family, source_offset, structs),
                    error_status_variant_module(source_family, source_offset, structs),
                    error_status_variant_name(source_family, source_offset, structs), structs)
                source_tag: LLVMValueRef = LLVMConstInt(LLVMInt32TypeInContext(ctx), (source_offset + 1).u64(), 0)
                target_tag: LLVMValueRef = LLVMConstInt(LLVMInt32TypeInContext(ctx), (target_offset + 1).u64(), 0)
                is_variant: LLVMValueRef = LLVMBuildICmp(builder, 32, source_code, source_tag, "try.error.tag")
                mapped_code <- LLVMBuildSelect(builder, is_variant, target_tag, mapped_code, "try.error.remapped.tag")
            return mapped_code if not error_set_has_payload(structs, target_family)
            target_status_type: LLVMTypeRef = error_set_llvm_type(structs, target_family, ctx)
            mapped_status: mutable LLVMValueRef = LLVMGetUndef(target_status_type)
            mapped_status <- LLVMBuildInsertValue(builder, mapped_status, mapped_code, 0, "try.error.remapped.status")
            if error_set_has_payload(structs, source_family):
                source_start: usize = structs.payload_enums.penum_variant_start[source_index.usize()]
                for source_offset in 0..<source_count |source_start, source_index, target_index, structs, status, mapped_status, builder|:
                    source_slot: usize = source_start + source_offset
                    target_offset: i64 = error_set_variant_offset(target_index,
                        structs.payload_enums.penum_variant_owners[source_slot], structs.payload_enums.penum_variant_modules[source_slot], structs.payload_enums.penum_variants[source_slot], structs)
                    target_slot: usize = structs.payload_enums.penum_variant_start[target_index.usize()] + target_offset.usize()
                    source_field_start: usize = structs.payload_enums.penum_field_type_start[source_slot]
                    target_field_start: usize = structs.payload_enums.penum_field_type_start[target_slot]
                    field_count: usize = structs.payload_enums.penum_field_type_count[source_slot]
                    source_field_base: usize = error_set_variant_field_base(structs, source_index, source_offset)
                    target_field_base: usize = error_set_variant_field_base(structs, target_index, target_offset.usize())
                    for field_offset in 0..<field_count |source_field_base, target_field_base, status, mapped_status, builder|:
                        source_field: LLVMValueRef = LLVMBuildExtractValue(builder, status,
                            (source_field_base + field_offset).u32(), "try.error.payload")
                        mapped_status <- LLVMBuildInsertValue(builder, mapped_status, source_field,
                            (target_field_base + field_offset).u32(), "try.error.remapped.payload")
            return mapped_status




        def current_error_return_family(runtime: Runtime&, structs: StructTable&) -> sview can[Abort.Panic]:
            family: sview @source = runtime.error_fn_family if runtime.error_fn_family != "" else line_error_set_name(structs.errors.error_fn_lines, structs.errors.error_fn_offsets, structs.errors.error_fn_set_names, runtime.error_fn_line, runtime.error_fn_offset)
            resolved_error_family(family, structs)


            # `try f(args)` in statement position — call the error fn with a fresh out-slot; on a
            # nonzero status code PROPAGATE it: unwind live regions and return that code from the
            # (error-returning) caller. On success, fall through. The success value is discarded.
        def emit_propagating_try[@scope_region, @loops_region, @regions_region, @fns_region, @structs_region, @generics_region](name: sview, arguments: darray[Expr], recovery: darray[Stmt], return_type: ValueType, local_scope: mutable Scope& @scope_region, loops: mutable LoopStack& @loops_region, regions: mutable RegionStack& @regions_region, fns: FnTable& @fns_region, structs: mutable StructTable& @structs_region, generics: mutable GenericTable& @generics_region, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef, owner_hint: sview = "") -> EmitStatus can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            propagate_value_type: ValueType = error_callee_value_type(name, arguments, local_scope, fns, structs, generics, owner_hint)
            return EmitStatus.Declined if propagate_value_type.kind == TypeKind.Unmodeled
            if error_callee_target(name, arguments, local_scope, fns, structs, generics, m, ctx, owner_hint) is propagate_target:
                # The out-slot holds the success value; a VOID-success fn writes nothing there
                # (its `raise` still stores an i64 0, so an i64 dummy is the safe minimum).
                propagate_out_llvm: LLVMTypeRef = LLVMInt64TypeInContext(ctx) if propagate_value_type.kind == TypeKind.Void else llvm_type_of(propagate_value_type, structs, ctx)
                propagate_out_slot: LLVMValueRef = build_entry_alloca(builder, propagate_out_llvm, "try.out")
                propagate_args: mutable darray[LLVMValueRef] = [propagate_out_slot]
                propagate_declined: mutable bool = false
                propagate_index: mutable usize = 0
                for propagate_arg in arguments |propagate_args, propagate_declined, propagate_index, name, arguments, local_scope, fns, structs, generics, runtime, m, ctx, builder|:
                    propagate_wanted: ValueType = error_callee_param_type(name, arguments, propagate_index, local_scope, fns, structs, generics, owner_hint)
                    if (emit_expression(propagate_arg, propagate_wanted, local_scope, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}) is propagate_arg_value:
                        propagate_args.push(propagate_arg_value)
                    else:
                        propagate_declined <- true
                    propagate_index <- propagate_index + 1
                return EmitStatus.Declined if:
                    propagate_declined
                    not (emit_error_call_defaults(name, owner_hint, arguments.count, propagate_args, local_scope, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write})
                propagate_arena_count: usize = error_callee_arena_count(name, arguments, local_scope, fns, structs, generics, owner_hint)
                for _ in 0..<propagate_arena_count |propagate_args, arguments, local_scope, runtime, structs|:
                    propagate_args.push(call_site_arena(arguments, local_scope, runtime, structs))
                propagate_fn_index: i64 = function_index_of(fns, error_callee_owner(fns, structs, name, owner_hint), name)
                mutable propagate_family: sview @source = resolved_error_family(line_error_set_name(structs.errors.error_fn_lines, structs.errors.error_fn_offsets, structs.errors.error_fn_set_names, fns.lines[propagate_fn_index.usize()], fns.offsets[propagate_fn_index.usize()]), structs) if propagate_fn_index >= 0 else ""
                if propagate_fn_index < 0:
                    propagate_generic_index: i64 = error_callee_generic_index(generics, name, owner_hint)
                    if propagate_generic_index >= 0:
                        propagate_family <- resolved_error_family(infer_generic_error_family(propagate_generic_index.usize(), arguments, local_scope, fns, structs, generics), structs)
                propagate_return_family: sview @source = current_error_return_family(runtime, structs)
                return EmitStatus.Declined if recovery.count == 0 and not error_status_remap_supported(propagate_family, propagate_return_family, structs)
                propagate_extern: bool = propagate_fn_index >= 0 and fns.is_extern[propagate_fn_index.usize()]
                propagate_status: mutable LLVMValueRef = LLVMConstInt(LLVMInt32TypeInContext(ctx), 0, 0)
                if emit_error_status_call(propagate_target, propagate_args, propagate_family, propagate_extern, structs, ctx, builder) is propagate_status_value:
                    propagate_status <- propagate_status_value
                else:
                    return EmitStatus.Declined
                clear_all_local_callable_aliases(local_scope)
                # See the try.else note: a payload-carrying set returns `%ErrSet__E`.
                propagate_code: LLVMValueRef = error_status_code(propagate_status, ctx, builder)
                propagate_ok: LLVMValueRef = LLVMBuildICmp(builder, 32, propagate_code, LLVMConstInt(LLVMInt32TypeInContext(ctx), 0, 0), "try.ok")
                propagate_function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                propagate_cont_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, propagate_function, "try.cont")
                propagate_fail_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, propagate_function, "try.propagate")
                _ = LLVMBuildCondBr(builder, propagate_ok, propagate_cont_block, propagate_fail_block)
                LLVMPositionBuilderAtEnd(builder, propagate_fail_block)
                # `try f(args) else <recovery>` in STATEMENT position: the recovery OWNS the
                # failure path, so run it here instead of propagating. This shares the whole
                # call-and-test sequence above, which already handles a VOID success payload
                # (an i64 dummy out-slot) -- the reason the statement form is lowered here
                # rather than through a synthetic local, which cannot be declared `void`.
                # The recovery must terminate, exactly as the `get OPT else` path requires:
                # falling through would continue past a call that failed.
                if recovery.count != 0:
                    recovery_status: EmitStatus = emit_statements(&recovery, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}
                    return EmitStatus.Declined if recovery_status != EmitStatus.Terminated
                    LLVMPositionBuilderAtEnd(builder, propagate_cont_block)
                    return EmitStatus.Open
                # A `try` PROPAGATE is a function EXIT, so it unwinds `defer` exactly as
                # `return` and `raise` do. It did not: `defer function:` + `try g(x)`
                # ran the deferred body on the success exit and DROPPED it on the
                # failure exit -- stage0 ran it on both (measured 2 vs stage1's 1).
                # Deferred actions run BEFORE the region unwind, the order every other
                # exit path uses: a deferred body may still read region-backed memory.
                return EmitStatus.Declined if not (emit_deferred_actions(local_scope, false, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write})
                (emit_region_unwind(regions, runtime, builder) can Global{Read,Write})
                mutable propagate_return_status: LLVMValueRef = propagate_status
                if propagate_family != propagate_return_family:
                    if remap_error_status(propagate_status, propagate_family, propagate_return_family, structs, ctx, builder) is remapped_propagate_status:
                        propagate_return_status <- remapped_propagate_status
                    else:
                        return EmitStatus.Declined
                _ = LLVMBuildRet(builder, propagate_return_status)
                LLVMPositionBuilderAtEnd(builder, propagate_cont_block)
                return EmitStatus.Open
            return EmitStatus.Declined




        # Split a first-class `T error[E]` at the propagation boundary. This is shared by
        # function-value calls and a source-marked `try value` whose AST root is an ErrorUnion
        # local. Failure copies the payload to the enclosing error slot, runs defers before
        # region unwind, and forwards the remapped status; success returns the payload.
        def emit_propagating_error_union_value_try(union_value: LLVMValueRef, union_type: ValueType, local_scope: mutable Scope&, regions: mutable RegionStack&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            return null if union_type.kind != TypeKind.ErrorUnion or not runtime.in_error_fn
            union_payload_type: ValueType = error_union_payload_of(union_type, structs)
            union_error_family: sview = resolved_error_family(error_union_family_of(union_type, structs), structs)
            union_return_family: sview = current_error_return_family(runtime, structs)
            return null if union_payload_type.kind == TypeKind.Unmodeled or union_error_family == ""
            return null if not error_status_remap_supported(union_error_family, union_return_family, structs)
            union_payload_llvm: LLVMTypeRef = llvm_type_of(union_payload_type, structs, ctx)
            union_status: LLVMValueRef = LLVMBuildExtractValue(builder, union_value, 0, "try.union.status")
            union_code: LLVMValueRef = error_union_code_of(union_value, union_type, structs, ctx, builder)
            union_payload_pointer: LLVMValueRef = LLVMBuildExtractValue(builder, union_value, 1, "try.union.payload.ptr")
            union_code_ok: LLVMValueRef = LLVMBuildICmp(builder, 32, union_code, LLVMConstInt(LLVMInt32TypeInContext(ctx), 0, 0), "try.union.ok")
            union_enclosing: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
            union_success_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, union_enclosing, "try.union.success")
            union_failure_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, union_enclosing, "try.union.failure")
            union_done_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, union_enclosing, "try.union.done")
            union_result_slot: LLVMValueRef = build_entry_alloca(builder, union_payload_llvm, "try.union.result")
            _ = LLVMBuildCondBr(builder, union_code_ok, union_success_block, union_failure_block)
            LLVMPositionBuilderAtEnd(builder, union_failure_block)
            # A propagating try exits the function. Deferred actions run before the region
            # unwind so deferred bodies can still read region-backed memory.
            return null if not (emit_deferred_actions(local_scope, false, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write})
            (emit_region_unwind(regions, runtime, builder) can Global{Read,Write})
            # The caller's `error_out` stores its own success payload type, which may be
            # narrower than this union's payload. The status alone represents propagation;
            # copying the source payload here can overwrite the caller's result slot.
            mutable forwarded_union_status: LLVMValueRef = union_status
            if union_error_family != union_return_family:
                if remap_error_status(union_status, union_error_family, union_return_family, structs, ctx, builder) is remapped_union_status:
                    forwarded_union_status <- remapped_union_status
                else:
                    return null
            if error_set_has_payload(structs, union_return_family):
                _ = LLVMBuildRet(builder, forwarded_union_status)
            else:
                _ = LLVMBuildRet(builder, error_status_code(forwarded_union_status, ctx, builder))
            LLVMPositionBuilderAtEnd(builder, union_success_block)
            union_success_payload: LLVMValueRef = LLVMBuildLoad2(builder, union_payload_llvm, union_payload_pointer, "try.union.success.payload")
            _ = LLVMBuildStore(builder, union_success_payload, union_result_slot)
            _ = LLVMBuildBr(builder, union_done_block)
            LLVMPositionBuilderAtEnd(builder, union_done_block)
            return LLVMBuildLoad2(builder, union_payload_llvm, union_result_slot, "try.union.value")




        # `try f(args)` where `f` is a function-valued local/parameter. Function values use
        # the tagged raw/closure representation and yield the same first-class ErrorUnion
        # descriptor consumed by the shared propagation helper above.
        def emit_propagating_fn_value_try(callee: Expr, arguments: darray[Expr]&, local_scope: mutable Scope&, loops: mutable LoopStack&, regions: mutable RegionStack&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            fn_value_type: mutable ValueType = expression_type(callee, local_scope, fns, structs, generics)
            fn_value_type <- optional_payload_of(fn_value_type, structs) if fn_value_type.kind == TypeKind.Optional and optional_payload_of(fn_value_type, structs).kind == TypeKind.Fn
            return null if fn_value_type.kind != TypeKind.Fn
            fn_result_payload_type: ValueType = fn_return_type_of(fn_value_type, structs)
            fn_error_family: sview = resolved_error_family(fn_error_family_of(fn_value_type, structs), structs)
            return null if fn_error_family == ""
            fn_return_family: sview = current_error_return_family(runtime, structs)
            return null if not runtime.in_error_fn or not error_status_remap_supported(fn_error_family, fn_return_family, structs)
            fn_result_type: ValueType = intern_error_union_type(fn_result_payload_type, fn_error_family, structs)
            fn_payload_type: ValueType = error_union_payload_of(fn_result_type, structs)
            return null if fn_payload_type.kind == TypeKind.Unmodeled
            if (emit_fn_value_call(callee, arguments, fn_result_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}) is fn_union_value:
                return emit_propagating_error_union_value_try(fn_union_value, fn_result_type, local_scope, regions, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}
            return null



        # Resolve the same lexical owner as ordinary call emission before selecting a row.
        # `selected` distinguishes a chosen owner with an ambiguous/unmatched overload from
        # a generic call which should stay on the generic path below.
        def error_union_monomorphic_call_owner[@structs_region, @fns_region, @generics_region](name: sview, arguments: darray[Expr]&, argument_names: darray[sview @source]&, local_scope: mutable Scope&, fns: FnTable& @fns_region, structs: mutable StructTable& @structs_region, generics: mutable GenericTable& @generics_region, owner_hint: sview) -> (selected: bool, owner_row: i64) can[Abort.Panic, Memory.Allocate]:
            if owner_hint != "":
                scoped_generic: i64 = generic_index_of_owner(generics, owner_hint, name)
                if scoped_generic >= 0 and arguments.count > 0:
                    scoped_inferred: darray[ValueType] = infer_generic_args(scoped_generic.usize(), arguments, local_scope, fns, structs, generics)
                    return (false, -1) if scoped_inferred.count > 0
                return (true, function_index_of(fns, owner_hint, name))
            if structs.visibility.current_owner != "" and function_has_call_shape(fns, structs.visibility.current_owner, name, arguments, argument_names):
                return (true, function_index_of(fns, structs.visibility.current_owner, name))
            if generic_index_of(generics, name) >= 0 and not exact_overload_exists_for_call_args(fns, name, arguments, argument_names, local_scope, structs, generics, 0):
                return (false, -1)
            root_row: i64 = function_index_of(fns, "", name)
            return (true, root_row) if root_row >= 0
            owner_row: i64 = function_index_for_unique_call_owner(fns, name, arguments, argument_names)
            return (true, owner_row) if owner_row >= 0
            return (false, -1)



        # Emit an error-returning call as a first-class `T error[E]` descriptor rather than
        # consuming it with `try`. Concrete calls pass through the selected FnTable row so
        # payload, parameter labels/defaults, arena/store slots, extern ABI and family agree.
        def emit_error_union_call_value[@scope_region, @fns_region, @structs_region, @generics_region](name: sview, arguments: darray[Expr], argument_names: darray[sview @source]&, expected: ValueType, local_scope: mutable Scope& @scope_region, fns: FnTable& @fns_region, structs: mutable StructTable& @structs_region, generics: mutable GenericTable& @generics_region, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef, owner_hint: sview = "") -> (selected: bool, value: LLVMValueRef?) can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            monomorphic_owner: (selected: bool, owner_row: i64) = error_union_monomorphic_call_owner(name, arguments, argument_names, local_scope, fns, structs, generics, owner_hint)
            if monomorphic_owner.selected:
                return (true, null) if monomorphic_owner.owner_row < 0 or monomorphic_owner.owner_row.usize() >= fns.owners.count
                selected_owner: sview = fns.owners[monomorphic_owner.owner_row.usize()]
                selected_value: LLVMValueRef? = emit_direct_call_as_error_union(selected_owner, name, arguments, argument_names, expected, local_scope, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}
                return (true, selected_value)
            return (false, null) if expected.kind != TypeKind.ErrorUnion or not error_callee_is(fns, structs, generics, name, owner_hint)
            payload_type: ValueType = error_callee_value_type(name, arguments, local_scope, fns, structs, generics, owner_hint)
            expected_payload: ValueType = error_union_payload_of(expected, structs)
            return (false, null) if payload_type.kind != expected_payload.kind or payload_type.bits != expected_payload.bits
            if error_callee_target(name, arguments, local_scope, fns, structs, generics, m, ctx, owner_hint) is target:
                payload_llvm: LLVMTypeRef = llvm_type_of(payload_type, structs, ctx)
                out_slot: LLVMValueRef = build_entry_alloca(builder, payload_llvm, "error.union.out")
                call_args: mutable darray[LLVMValueRef] = [out_slot]
                declined: mutable bool = false
                argument_index: mutable usize = 0
                for argument in arguments |call_args, declined, argument_index, name, arguments, local_scope, fns, structs, generics, runtime, m, ctx, builder|:
                    wanted: ValueType = error_callee_param_type(name, arguments, argument_index, local_scope, fns, structs, generics, owner_hint)
                    if (emit_expression(argument, wanted, local_scope, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}) is argument_value:
                        call_args.push(argument_value)
                    else:
                        declined <- true
                    argument_index <- argument_index + 1
                return (false, null) if:
                    declined
                    not (emit_error_call_defaults(name, owner_hint, arguments.count, call_args, local_scope, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write})
                call_arena_count: usize = error_callee_arena_count(name, arguments, local_scope, fns, structs, generics, owner_hint)
                for _ in 0..<call_arena_count |call_args, arguments, local_scope, runtime, structs|:
                    call_args.push(call_site_arena(arguments, local_scope, runtime, structs))
                error_union_family: sview = error_union_family_of(expected, structs)
                error_union_fn_index: i64 = function_index_of(fns, error_callee_owner(fns, structs, name, owner_hint), name)
                error_union_extern: bool = error_union_fn_index >= 0 and fns.is_extern[error_union_fn_index.usize()]
                status: mutable LLVMValueRef = LLVMConstInt(LLVMInt32TypeInContext(ctx), 0, 0)
                if emit_error_status_call(target, call_args, error_union_family, error_union_extern, structs, ctx, builder) is error_union_status:
                    status <- error_union_status
                else:
                    return (false, null)
                clear_all_local_callable_aliases(local_scope)
                result: mutable LLVMValueRef = LLVMGetUndef(llvm_type_of(expected, structs, ctx))
                result <- LLVMBuildInsertValue(builder, result, status, 0, "error.union.status")
                result <- LLVMBuildInsertValue(builder, result, out_slot, 1, "error.union.payload")
                return (false, result)
            return (false, null)

        def emit_error_union_call_value_from_callee[@scope_region, @fns_region, @structs_region, @generics_region, @runtime_region](callee: Expr, arguments: darray[Expr], argument_names: darray[sview @source]&, expected: ValueType, local_scope: mutable Scope& @scope_region, fns: FnTable& @fns_region, structs: mutable StructTable& @structs_region, generics: mutable GenericTable& @generics_region, runtime: Runtime& @runtime_region, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> (selected: bool, value: LLVMValueRef?) can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            match try_callee_as_ident_with_generics(callee, fns, structs, generics):
                Expr.Ident(name, _):
                    return emit_error_union_call_value(name, arguments, argument_names, expected, local_scope, fns, structs, generics, runtime, m, ctx, builder, try_callee_owner_with_generics(callee, fns, structs, generics)) can Global{Read,Write}
                _:
                    return (false, null)




        # `try CALL else FALLBACK` as a VALUE. An error-returning function's ABI is a
        # leading OUT-POINTER plus an i32 status, so the produced value lives in the out
        # slot and the fallback runs on any nonzero status. Handles a plain error fn and a
        # generic one, with inferred (`f(x)`) or explicit (`f[K, V](x)`) type arguments.
        #
        # Without this the guarded call was emitted at its PAYLOAD type, so a `T?`-returning
        # error fn took the optional-unwrap path and `extractvalue`d the i32 status as if it
        # were an optional aggregate -- which crashes LLVM outright.
        def emit_try_else_error_call(guarded: Expr, fallback: Expr, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            match guarded:
                Expr.Call(te_callee, te_args, te_arg_names, te_call_line):
                    te_name: mutable sview = ""
                    te_type_args: mutable darray[ValueType] = []
                    te_explicit: mutable bool = false
                    te_bad_type_arg: mutable bool = false
                    te_owner: sview = try_callee_owner_with_generics(te_callee, fns, structs, generics)
                    match try_callee_as_ident_with_generics(te_callee, fns, structs, generics):
                        Expr.Ident(te_ident_name, te_ident_line):
                            te_name <- te_ident_name
                        _:
                            pass
                    match te_callee:
                        Expr.Index(te_index_head, te_index_arg, te_index_line):
                            match te_index_head:
                                Expr.Ident(te_index_name, te_index_name_line):
                                    te_name <- te_index_name
                                    te_explicit <- true
                                    te_single: ValueType = annotation_value_type(te_index_arg, structs)
                                    te_bad_type_arg <- true if te_single.kind == TypeKind.Unmodeled
                                    te_type_args.push(te_single)
                                _:
                                    pass
                        _:
                            pass
                    match te_callee:
                        Expr.IndexN(te_multi_head, te_multi_arg_exprs, te_multi_line):
                            match te_multi_head:
                                Expr.Ident(te_multi_name, te_multi_name_line):
                                    te_name <- te_multi_name
                                    te_explicit <- true
                                    for te_multi_arg in te_multi_arg_exprs |te_type_args, te_bad_type_arg, structs|:
                                        te_resolved: ValueType = annotation_value_type(te_multi_arg, structs)
                                        te_bad_type_arg <- true if te_resolved.kind == TypeKind.Unmodeled
                                        te_type_args.push(te_resolved)
                                _:
                                    pass
                        _:
                            pass
                    return null if te_name == "" or te_bad_type_arg
                    te_generic_slot: i64 = generic_index_of(generics, te_name)
                    te_is_generic: bool = te_generic_slot >= 0
                    if te_is_generic and not te_explicit:
                        te_inferred: darray[ValueType] = infer_generic_args(te_generic_slot.usize(), te_args, local_scope, fns, structs, generics)
                        return null if te_inferred.count != generics.param_count[te_generic_slot.usize()]
                        te_type_args.extend([copied_type(te_inferred_arg) for te_inferred_arg in te_inferred])
                    te_plain_error: bool = function_is_error(fns, error_callee_owner(fns, structs, te_name, te_owner), te_name)
                    te_generic_error: mutable bool = false
                    if te_is_generic:
                        te_generic_error <- generics.is_error[te_generic_slot.usize()]
                    te_error_family: sview @source = infer_generic_error_family(te_generic_slot.usize(), te_args, local_scope, fns, structs, generics) if te_generic_error else ""
                    return null if:
                        te_generic_error and generic_error_param_at(generics, te_generic_slot.usize()) != "" and te_error_family == ""
                        not te_plain_error and not te_generic_error
                    te_payload: mutable ValueType = unmodeled_type()
                    if te_generic_error:
                        te_payload <- generic_return_type(te_name, te_type_args, generics, structs)
                    else:
                        te_payload <- lookup_return_type(fns, error_callee_owner(fns, structs, te_name, te_owner), te_name)
                    return null if te_payload.kind == TypeKind.Unmodeled
                    te_target_opt: mutable LLVMValueRef? = null
                    if te_generic_error:
                        te_target_opt <- instantiate_generic_with_error_family(te_name, te_type_args, te_error_family, generics, structs, m, ctx)
                    else:
                        te_target_opt <- lookup_function(fns, error_callee_owner(fns, structs, te_name, te_owner), te_name)
                    if te_target_opt is te_target:
                        # Void-success calls retain the out-pointer ABI, but never
                        # write a payload. Supply real storage without alloca void.
                        te_payload_llvm: LLVMTypeRef = LLVMInt64TypeInContext(ctx) if te_payload.kind == TypeKind.Void else llvm_type_of(te_payload, structs, ctx)
                        te_out_slot: LLVMValueRef = build_entry_alloca(builder, te_payload_llvm, "try.else.out")
                        te_call_values: mutable darray[LLVMValueRef] = [te_out_slot]
                        te_declined: mutable bool = false
                        te_position: mutable usize = 0
                        for te_argument in te_args |te_call_values, te_declined, te_position, te_name, te_type_args, te_generic_error, local_scope, fns, structs, generics, runtime, m, ctx, builder|:
                            te_wanted: mutable ValueType = unmodeled_type()
                            if te_generic_error:
                                te_wanted <- instantiation_param_type(te_name, te_type_args, te_position, generics, structs)
                            else:
                                te_wanted <- param_type_of(fns, error_callee_owner(fns, structs, te_name, te_owner), te_name, te_position)
                            if te_wanted.kind == TypeKind.Unmodeled:
                                te_declined <- true
                            elif (emit_expression(te_argument, te_wanted, local_scope, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}) is te_argument_value:
                                te_call_values.push(te_argument_value)
                            else:
                                te_declined <- true
                            te_position <- te_position + 1
                        return null if te_declined
                        te_threaded_arena: LLVMValueRef = call_site_arena(te_args, local_scope, runtime, structs)
                        if te_generic_error:
                            if instantiation_wants_store(te_name, te_type_args, generics):
                                if call_site_store(runtime) is te_store:
                                    te_call_values.push(te_store)
                                else:
                                    return null
                            return null if not push_named_instantiation_arenas(te_call_values, te_name, te_type_args, te_args, local_scope, runtime, generics, structs)
                        else:
                            te_fn_index: i64 = function_index_of(fns, error_callee_owner(fns, structs, te_name, te_owner), te_name)
                            return null if te_fn_index < 0
                            for _ in 0..<fns.arena_counts[te_fn_index.usize()] |te_call_values, te_threaded_arena|:
                                te_call_values.push(te_threaded_arena)
                        te_direct_index: i64 = function_index_of(fns, error_callee_owner(fns, structs, te_name, te_owner), te_name) if not te_generic_error else -1
                        te_family: mutable sview @source = resolved_error_family(te_error_family, structs) if te_generic_error else ""
                        te_family <- resolved_error_family(line_error_set_name(structs.errors.error_fn_lines, structs.errors.error_fn_offsets, structs.errors.error_fn_set_names, fns.lines[te_direct_index.usize()], fns.offsets[te_direct_index.usize()]), structs) if te_direct_index >= 0
                        te_extern: bool = te_direct_index >= 0 and fns.is_extern[te_direct_index.usize()]
                        te_status: mutable LLVMValueRef = LLVMConstInt(LLVMInt32TypeInContext(ctx), 0, 0)
                        if emit_error_status_call(te_target, te_call_values, te_family, te_extern, structs, ctx, builder) is te_status_value:
                            te_status <- te_status_value
                        else:
                            return null
                        clear_all_local_callable_aliases(local_scope)
                        # A PAYLOAD-carrying error set returns `%ErrSet__E`, not a bare i32: the
                        # code is field 0. Comparing the whole struct against `i32 0` is malformed
                        # IR (see the matching note at the catch sites).
                        te_family_is_struct: bool = te_generic_error and error_set_has_payload(structs, resolved_error_family(te_error_family, structs))
                        te_code: LLVMValueRef = error_status_code(te_status, ctx, builder)
                        te_ok: LLVMValueRef = LLVMBuildICmp(builder, 32, te_code, LLVMConstInt(LLVMInt32TypeInContext(ctx), 0, 0), "try.else.ok")
                        te_function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                        te_ok_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, te_function, "try.else.value")
                        te_recover_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, te_function, "try.else.recover")
                        te_done_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, te_function, "try.else.done")
                        if te_payload.kind == TypeKind.Void:
                            # A VOID payload has no value to recover, so a VALUE fallback
                            # (`try void_fn() else 0`) is a TYPE ERROR, not a lowering -- stage0
                            # rejects it with "try fallback expects void, got int". Emitting it
                            # anyway passed the void payload type to LLVMBuildAlloca, which traps
                            # inside LLVM's getPrefTypeAlign: SIGTRAP, no diagnostic, no span.
                            # Decline the shape here so nothing can crash; check_try_fallback_void
                            # reports the literal case up front with stage0's own message.
                            # `else return`/`else raise`/`else err:` never reach this branch --
                            # the parser routes control-flow recovery to Expr.GetElse -- and a
                            # void-typed fallback call (`else noop()`) still lowers as before.
                            te_void_fallback_type: ValueType = expression_type(fallback, local_scope, fns, structs, generics)
                            return null if te_void_fallback_type.kind != TypeKind.Void and te_void_fallback_type.kind != TypeKind.Unmodeled
                            _ = LLVMBuildCondBr(builder, te_ok, te_ok_block, te_recover_block)
                            LLVMPositionBuilderAtEnd(builder, te_ok_block)
                            _ = LLVMBuildBr(builder, te_done_block)
                            LLVMPositionBuilderAtEnd(builder, te_recover_block)
                            te_noop: mutable bool = false
                            match fallback:
                                Expr.Ident(te_fallback_name, te_fallback_pos):
                                    te_noop <- te_fallback_name == "void"
                                _:
                                    pass
                            if not te_noop:
                                if (emit_expression(fallback, te_payload, local_scope, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}) is te_void_fallback:
                                    _ = te_void_fallback
                                else:
                                    return null
                            _ = LLVMBuildBr(builder, te_done_block)
                            LLVMPositionBuilderAtEnd(builder, te_done_block)
                            # Presence signals successful emission; no nonexistent
                            # payload is loaded, stored, or exposed to the caller.
                            return LLVMConstNull(LLVMPointerTypeInContext(ctx, 0))
                        te_result_slot: LLVMValueRef = build_entry_alloca(builder, te_payload_llvm, "try.else.result")
                        _ = LLVMBuildCondBr(builder, te_ok, te_ok_block, te_recover_block)
                        LLVMPositionBuilderAtEnd(builder, te_ok_block)
                        te_loaded: LLVMValueRef = LLVMBuildLoad2(builder, te_payload_llvm, te_out_slot, "try.else.loaded")
                        _ = LLVMBuildStore(builder, te_loaded, te_result_slot)
                        _ = LLVMBuildBr(builder, te_done_block)
                        LLVMPositionBuilderAtEnd(builder, te_recover_block)
                        if (emit_expression(fallback, te_payload, local_scope, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}) is te_fallback_value:
                            _ = LLVMBuildStore(builder, te_fallback_value, te_result_slot)
                            _ = LLVMBuildBr(builder, te_done_block)
                            LLVMPositionBuilderAtEnd(builder, te_done_block)
                            return LLVMBuildLoad2(builder, te_payload_llvm, te_result_slot, "try.else.load")
                        return null
                    return null
                _:
                    pass
            return null




        # `try f[K, V](args) else …` — the error-union VALUE of a GENERIC error-returning
        # call with EXPLICIT type arguments. emit_error_union_call_value only handles a bare
        # Ident callee and infers the type args from argument 0, which the std's
        # `arena_dict_put[K, usize](…)` cannot supply. Without this the call fell through to
        # the plain generic lowering, which returns the i32 STATUS -- and the caller's
        # `extractvalue` on that i32 crashed LLVM.
        def emit_error_union_generic_call_value(base: sview @source, type_args: darray[ValueType]&, arguments: darray[Expr]&, expected: ValueType, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            return null if expected.kind != TypeKind.ErrorUnion
            generic_slot: i64 = generic_index_of(generics, base)
            return null if:
                generic_slot < 0
                not generics.is_error[generic_slot.usize()]
            payload_type: ValueType = generic_return_type(base, type_args, generics, structs)
            expected_payload: ValueType = error_union_payload_of(expected, structs)
            return null if:
                payload_type.kind == TypeKind.Unmodeled
                payload_type.kind != expected_payload.kind or payload_type.bits != expected_payload.bits
            explicit_error_family: sview @source = infer_generic_error_family(generic_slot.usize(), arguments, local_scope, fns, structs, generics)
            return null if generic_error_param_at(generics, generic_slot.usize()) != "" and explicit_error_family == ""
            if instantiate_generic_with_error_family(base, type_args, explicit_error_family, generics, structs, m, ctx) is generic_target:
                generic_out_slot: LLVMValueRef = build_entry_alloca(builder, llvm_type_of(payload_type, structs, ctx), "error.union.generic.out")
                generic_call_args: mutable darray[LLVMValueRef] = [generic_out_slot]
                generic_declined: mutable bool = false
                generic_arg_index: mutable usize = 0
                for generic_argument in arguments |generic_call_args, generic_declined, generic_arg_index, base, type_args, local_scope, fns, structs, generics, runtime, m, ctx, builder|:
                    generic_wanted: ValueType = instantiation_param_type(base, type_args, generic_arg_index, generics, structs)
                    if (emit_expression(generic_argument, generic_wanted, local_scope, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}) is generic_arg_value:
                        generic_call_args.push(generic_arg_value)
                    else:
                        generic_declined <- true
                    generic_arg_index <- generic_arg_index + 1
                return null if generic_declined
                if instantiation_wants_store(base, type_args, generics):
                    if call_site_store(runtime) is generic_store:
                        generic_call_args.push(generic_store)
                    else:
                        return null
                return null if not push_named_instantiation_arenas(generic_call_args, base, type_args, arguments, local_scope, runtime, generics, structs)
                generic_fn_type: LLVMTypeRef = LLVMGlobalGetValueType(generic_target)
                generic_args_pointer: void& = (&generic_call_args[0]).cast[void&] can Unsafe.PointerCast
                generic_status: LLVMValueRef = LLVMBuildCall2(builder, generic_fn_type, generic_target, generic_args_pointer, generic_call_args.count.u32(), "error.union.generic.status")
                clear_all_local_callable_aliases(local_scope)
                generic_result: mutable LLVMValueRef = LLVMGetUndef(llvm_type_of(expected, structs, ctx))
                generic_result <- LLVMBuildInsertValue(builder, generic_result, generic_status, 0, "error.union.generic.status")
                generic_result <- LLVMBuildInsertValue(builder, generic_result, generic_out_slot, 1, "error.union.generic.payload")
                return generic_result
            return null

