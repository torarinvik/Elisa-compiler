                    te_generic_error: mutable bool = false
                    if te_is_generic:
                        te_generic_error <- generics.is_error[te_generic_slot.usize()]
                    te_error_family: sview = infer_generic_error_family(te_generic_slot.usize(), te_args, local_scope, fns, structs, generics) if te_generic_error else ""
                    null return if te_generic_error and generic_error_param_at(generics, te_generic_slot.usize()) != "" and te_error_family == ""
                    null return if not te_plain_error and not te_generic_error
