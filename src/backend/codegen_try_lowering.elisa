# Stage1 backend — lowering `try` and `try … else`: the propagating form in statement and value
# position, the error-union descriptor a call can yield instead, and the same pair for a
# GENERIC error-returning callee. Part of `module Backend` (see codegen.elisa).

extend Backend:
    private:


            # Find the same owning enum variant in an error set whose merged order may
            # differ from the callee's. Error status integers are local to their set.
        def error_set_variant_offset(set_index: i64, owner: sview, variant: sview, structs: StructTable&) -> i64 can[Abort.Panic]:
            return -1 if set_index < 0 or set_index.usize() >= structs.penum_names.count
            start: usize = structs.penum_variant_start[set_index.usize()]
            count: usize = structs.penum_variant_count[set_index.usize()]
            for offset in 0..<count |start, structs, owner, variant|:
                slot: usize = start + offset
                return offset.i64() if structs.penum_variants[slot] == variant and structs.penum_variant_owners[slot] == owner
            return -1




            # Fieldless `error Name:` declarations live in the const-enum registry rather
            # than the payload-enum registry. Expose their variants through the same
            # zero-based view used by payload error sets, because both error ABIs encode
            # failures as ordinal + 1.
        def error_status_variant_count(family: sview, structs: mutable StructTable&) -> usize can[Abort.Panic]:
            payload_index: i64 = penum_index_of(structs, family)
            return structs.penum_variant_count[payload_index.usize()] if payload_index >= 0
            plain_index: i64 = enum_index_of(structs, family)
            return structs.enum_variant_count[plain_index.usize()] if plain_index >= 0
            return 0




        def error_status_variant_name(family: sview, offset: usize, structs: mutable StructTable&) -> sview can[Abort.Panic]:
            payload_index: i64 = penum_index_of(structs, family)
            if payload_index >= 0:
                return structs.penum_variants[structs.penum_variant_start[payload_index.usize()] + offset]
            plain_index: i64 = enum_index_of(structs, family)
            if plain_index >= 0:
                return structs.enum_variants[structs.enum_variant_start[plain_index.usize()] + offset]
            return ""




        def error_status_variant_owner(family: sview, offset: usize, structs: StructTable&) -> sview can[Abort.Panic]:
            payload_index: i64 = penum_index_of(structs, family)
            if payload_index >= 0:
                slot: usize = structs.penum_variant_start[payload_index.usize()] + offset
                return structs.penum_variant_owners[slot]
            # append_error_union_plain_family records the declared family as owner.
            return family
            # A propagating call is sound only when every callee variant and payload field
            # has a matching representation in the caller's error set.
        def error_status_remap_supported(source_family: sview, target_family: sview, structs: mutable StructTable&) -> bool can[Abort.Panic]:
            return true if source_family == target_family
            source_index: i64 = penum_index_of(structs, source_family)
            target_index: i64 = penum_index_of(structs, target_family)
            return false if target_index < 0
            source_count: usize = error_status_variant_count(source_family, structs)
            return false if source_count == 0
            for source_offset in 0..<source_count |source_family, source_index, target_index, structs|:
                target_offset: i64 = error_set_variant_offset(target_index,
                    error_status_variant_owner(source_family, source_offset, structs),
                    error_status_variant_name(source_family, source_offset, structs), structs)
                return false if target_offset < 0
                target_slot: usize = structs.penum_variant_start[target_index.usize()] + target_offset.usize()
                target_field_start: usize = structs.penum_field_type_start[target_slot]
                field_count: mutable usize = 0
                if source_index >= 0:
                    source_slot: usize = structs.penum_variant_start[source_index.usize()] + source_offset
                    field_count <- structs.penum_field_type_count[source_slot]
                    source_field_start: usize = structs.penum_field_type_start[source_slot]
                    return false if field_count != structs.penum_field_type_count[target_slot]
                    for field_offset in 0..<field_count |source_field_start, target_field_start, structs|:
                        source_type: ValueType = copied_type(structs.penum_field_types[source_field_start + field_offset])
                        target_type: ValueType = copied_type(structs.penum_field_types[target_field_start + field_offset])
                        return false if source_type.kind != target_type.kind or source_type.bits != target_type.bits
                return false if field_count != structs.penum_field_type_count[target_slot]
            return false if error_set_has_payload(structs, source_family) and not error_set_has_payload(structs, target_family)
            true




            # Translate both the error tag and (when present) its variant-specific fields.
            # Payload slots are concatenated by set order, so widening a set can move them.
        def remap_error_status(status: LLVMValueRef, source_family: sview, target_family: sview, structs: mutable StructTable&, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            return status if source_family == target_family
            null return if not error_status_remap_supported(source_family, target_family, structs)
            source_index: i64 = penum_index_of(structs, source_family)
            target_index: i64 = penum_index_of(structs, target_family)
            source_count: usize = error_status_variant_count(source_family, structs)
            source_code: LLVMValueRef = error_status_code(status, ctx, builder)
            mapped_code: mutable LLVMValueRef = source_code
            for source_offset in 0..<source_count |source_family, source_index, target_index, structs, source_code, mapped_code, ctx, builder|:
                target_offset: i64 = error_set_variant_offset(target_index,
                    error_status_variant_owner(source_family, source_offset, structs),
                    error_status_variant_name(source_family, source_offset, structs), structs)
                source_tag: LLVMValueRef = LLVMConstInt(LLVMInt32TypeInContext(ctx), (source_offset + 1).u64(), 0)
                target_tag: LLVMValueRef = LLVMConstInt(LLVMInt32TypeInContext(ctx), (target_offset + 1).u64(), 0)
                is_variant: LLVMValueRef = LLVMBuildICmp(builder, 32, source_code, source_tag, "try.error.tag")
                mapped_code <- LLVMBuildSelect(builder, is_variant, target_tag, mapped_code, "try.error.remapped.tag")
            return mapped_code if not error_set_has_payload(structs, target_family)
            target_status_type: LLVMTypeRef = error_set_llvm_type(structs, target_family, ctx)
            mapped_status: mutable LLVMValueRef = LLVMGetUndef(target_status_type)
            mapped_status <- LLVMBuildInsertValue(builder, mapped_status, mapped_code, 0, "try.error.remapped.status")
            if error_set_has_payload(structs, source_family):
                source_start: usize = structs.penum_variant_start[source_index.usize()]
                for source_offset in 0..<source_count |source_start, source_index, target_index, structs, status, mapped_status, builder|:
                    source_slot: usize = source_start + source_offset
                    target_offset: i64 = error_set_variant_offset(target_index,
                        structs.penum_variant_owners[source_slot], structs.penum_variants[source_slot], structs)
                    target_slot: usize = structs.penum_variant_start[target_index.usize()] + target_offset.usize()
                    source_field_start: usize = structs.penum_field_type_start[source_slot]
                    target_field_start: usize = structs.penum_field_type_start[target_slot]
                    field_count: usize = structs.penum_field_type_count[source_slot]
                    source_field_base: usize = error_set_variant_field_base(structs, source_index, source_offset)
                    target_field_base: usize = error_set_variant_field_base(structs, target_index, target_offset.usize())
                    for field_offset in 0..<field_count |source_field_base, target_field_base, status, mapped_status, builder|:
                        source_field: LLVMValueRef = LLVMBuildExtractValue(builder, status,
                            (source_field_base + field_offset).u32(), "try.error.payload")
                        mapped_status <- LLVMBuildInsertValue(builder, mapped_status, source_field,
                            (target_field_base + field_offset).u32(), "try.error.remapped.payload")
            return mapped_status




        def current_error_return_family(runtime: Runtime&, structs: StructTable&) -> sview can[Abort.Panic]:
            family: sview = runtime.error_fn_family if runtime.error_fn_family != "" else line_error_set_name(structs.error_fn_lines, structs.error_fn_set_names, runtime.error_fn_line)
            resolved_error_family(family, structs)


            # `try f(args)` in statement position — call the error fn with a fresh out-slot; on a
            # nonzero status code PROPAGATE it: unwind live regions and return that code from the
            # (error-returning) caller. On success, fall through. The success value is discarded.
        def emit_propagating_try(name: sview, arguments: darray[Expr]&, recovery: darray[Stmt]&, return_type: ValueType, local_scope: mutable Scope&, loops: mutable LoopStack&, regions: mutable RegionStack&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef, owner_hint: sview = "") -> EmitStatus can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            propagate_value_type: ValueType = error_callee_value_type(name, arguments, local_scope, fns, structs, generics, owner_hint)
            EmitStatus.Declined return if propagate_value_type.kind == TypeKind.Unmodeled
            if error_callee_target(name, arguments, local_scope, fns, structs, generics, m, ctx, owner_hint) is propagate_target:
                # The out-slot holds the success value; a VOID-success fn writes nothing there
                # (its `raise` still stores an i64 0, so an i64 dummy is the safe minimum).
                propagate_out_llvm: LLVMTypeRef = LLVMInt64TypeInContext(ctx) if propagate_value_type.kind == TypeKind.Void else llvm_type_of(propagate_value_type, structs, ctx)
                propagate_out_slot: LLVMValueRef = build_entry_alloca(builder, propagate_out_llvm, "try.out")
                propagate_args: mutable darray[LLVMValueRef] = [propagate_out_slot]
                propagate_declined: mutable bool = false
                propagate_index: mutable usize = 0
                for propagate_arg in arguments |propagate_args, propagate_declined, propagate_index, name, arguments, local_scope, fns, structs, generics, runtime, m, ctx, builder|:
                    propagate_wanted: ValueType = error_callee_param_type(name, arguments, propagate_index, local_scope, fns, structs, generics, owner_hint)
                    if emit_expression(propagate_arg, propagate_wanted, local_scope, fns, structs, generics, runtime, m, ctx, builder) is propagate_arg_value:
                        propagate_args.push(propagate_arg_value)
                    else:
                        propagate_declined <- true
                    propagate_index <- propagate_index + 1
                EmitStatus.Declined return if propagate_declined
                propagate_arena_count: usize = error_callee_arena_count(name, arguments, local_scope, fns, structs, generics, owner_hint)
                for _ in 0..<propagate_arena_count |propagate_args, arguments, local_scope, runtime, structs|:
                    propagate_args.push(call_site_arena(arguments, local_scope, runtime, structs))
                propagate_fn_index: i64 = function_index_of(fns, error_callee_owner(fns, structs, name, owner_hint), name)
                mutable propagate_family: sview = resolved_error_family(line_error_set_name(structs.error_fn_lines, structs.error_fn_set_names, fns.lines[propagate_fn_index.usize()]), structs) if propagate_fn_index >= 0 else ""
                if propagate_fn_index < 0:
                    propagate_generic_index: i64 = error_callee_generic_index(generics, name, owner_hint)
                    if propagate_generic_index >= 0:
                        propagate_family <- resolved_error_family(infer_generic_error_family(propagate_generic_index.usize(), arguments, local_scope, fns, structs, generics), structs)
                propagate_return_family: sview = current_error_return_family(runtime, structs)
                EmitStatus.Declined return if recovery.count == 0 and not error_status_remap_supported(propagate_family, propagate_return_family, structs)
                propagate_extern: bool = propagate_fn_index >= 0 and fns.is_extern[propagate_fn_index.usize()]
                propagate_status: mutable LLVMValueRef = LLVMConstInt(LLVMInt32TypeInContext(ctx), 0, 0)
                if emit_error_status_call(propagate_target, propagate_args, propagate_family, propagate_extern, structs, ctx, builder) is propagate_status_value:
                    propagate_status <- propagate_status_value
                else:
                    return EmitStatus.Declined
                # See the try.else note: a payload-carrying set returns `%ErrSet__E`.
                propagate_code: LLVMValueRef = error_status_code(propagate_status, ctx, builder)
                propagate_ok: LLVMValueRef = LLVMBuildICmp(builder, 32, propagate_code, LLVMConstInt(LLVMInt32TypeInContext(ctx), 0, 0), "try.ok")
                propagate_function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                propagate_cont_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, propagate_function, "try.cont")
                propagate_fail_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, propagate_function, "try.propagate")
                _ = LLVMBuildCondBr(builder, propagate_ok, propagate_cont_block, propagate_fail_block)
                LLVMPositionBuilderAtEnd(builder, propagate_fail_block)
                # `try f(args) else <recovery>` in STATEMENT position: the recovery OWNS the
                # failure path, so run it here instead of propagating. This shares the whole
                # call-and-test sequence above, which already handles a VOID success payload
                # (an i64 dummy out-slot) -- the reason the statement form is lowered here
                # rather than through a synthetic local, which cannot be declared `void`.
                # The recovery must terminate, exactly as the `get OPT else` path requires:
                # falling through would continue past a call that failed.
                if recovery.count != 0:
                    recovery_status: EmitStatus = emit_statements(recovery, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)
                    EmitStatus.Declined return if recovery_status != EmitStatus.Terminated
                    LLVMPositionBuilderAtEnd(builder, propagate_cont_block)
                    return EmitStatus.Open
                # A `try` PROPAGATE is a function EXIT, so it unwinds `defer` exactly as
                # `return` and `raise` do. It did not: `defer function:` + `try g(x)`
                # ran the deferred body on the success exit and DROPPED it on the
                # failure exit -- stage0 ran it on both (measured 2 vs stage1's 1).
                # Deferred actions run BEFORE the region unwind, the order every other
                # exit path uses: a deferred body may still read region-backed memory.
                EmitStatus.Declined return if not emit_deferred_actions(local_scope, false, fns, structs, generics, runtime, m, ctx, builder)
                emit_region_unwind(regions, runtime, builder)
                mutable propagate_return_status: LLVMValueRef = propagate_status
                if propagate_family != propagate_return_family:
                    if remap_error_status(propagate_status, propagate_family, propagate_return_family, structs, ctx, builder) is remapped_propagate_status:
                        propagate_return_status <- remapped_propagate_status
                    else:
                        return EmitStatus.Declined
                _ = LLVMBuildRet(builder, propagate_return_status)
                LLVMPositionBuilderAtEnd(builder, propagate_cont_block)
                return EmitStatus.Open
            return EmitStatus.Declined




        # `try f(args)` where `f` is a function-valued local/parameter. Function values use
        # the tagged raw/closure representation, so this cannot reuse the named-callee helper
        # above. `emit_fn_value_call` deliberately returns a first-class error union; split it
        # here at the propagation boundary, copying the failure payload into this function's
        # error slot and returning the status. The success path returns the payload value to
        # the enclosing variable/return emitter. No handler object or dynamic allocation is
        # introduced: this is the same two-way CFG and hidden out-slot ABI as a direct call.
        def emit_propagating_fn_value_try(callee: Expr, arguments: darray[Expr]&, local_scope: mutable Scope&, loops: mutable LoopStack&, regions: mutable RegionStack&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            fn_value_type: mutable ValueType = expression_type(callee, local_scope, fns, structs, generics)
            fn_value_type <- optional_payload_of(fn_value_type, structs) if fn_value_type.kind == TypeKind.Optional and optional_payload_of(fn_value_type, structs).kind == TypeKind.Fn
            null return if fn_value_type.kind != TypeKind.Fn
            fn_result_payload_type: ValueType = fn_return_type_of(fn_value_type, structs)
            fn_error_family: sview = resolved_error_family(fn_error_family_of(fn_value_type, structs), structs)
            null return if fn_error_family == ""
            fn_return_family: sview = current_error_return_family(runtime, structs)
            null return if not error_status_remap_supported(fn_error_family, fn_return_family, structs)
            fn_result_type: ValueType = intern_error_union_type(fn_result_payload_type, fn_error_family, structs)
            fn_payload_type: ValueType = error_union_payload_of(fn_result_type, structs)
            null return if fn_payload_type.kind == TypeKind.Unmodeled or not runtime.in_error_fn
            if emit_fn_value_call(callee, arguments, fn_result_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is fn_union_value:
                fn_status: LLVMValueRef = LLVMBuildExtractValue(builder, fn_union_value, 0, "fn.try.status")
                fn_code: LLVMValueRef = error_union_code_of(fn_union_value, fn_result_type, structs, ctx, builder)
                fn_payload_pointer: LLVMValueRef = LLVMBuildExtractValue(builder, fn_union_value, 1, "fn.try.payload.ptr")
                fn_payload_llvm: LLVMTypeRef = llvm_type_of(fn_payload_type, structs, ctx)
                fn_code_ok: LLVMValueRef = LLVMBuildICmp(builder, 32, fn_code, LLVMConstInt(LLVMInt32TypeInContext(ctx), 0, 0), "fn.try.ok")
                fn_enclosing: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                fn_success_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, fn_enclosing, "fn.try.success")
                fn_failure_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, fn_enclosing, "fn.try.failure")
                fn_done_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, fn_enclosing, "fn.try.done")
                fn_result_slot: LLVMValueRef = build_entry_alloca(builder, fn_payload_llvm, "fn.try.result")
                _ = LLVMBuildCondBr(builder, fn_code_ok, fn_success_block, fn_failure_block)
                LLVMPositionBuilderAtEnd(builder, fn_failure_block)
                # A `try` PROPAGATE is a function EXIT, so it unwinds `defer` exactly as
                # `return` and `raise` do. It did not: `defer function:` + `try g(x)`
                # ran the deferred body on the success exit and DROPPED it on the
                # failure exit -- stage0 ran it on both (measured 2 vs stage1's 1).
                # Deferred actions run BEFORE the region unwind, the order every other
                # exit path uses: a deferred body may still read region-backed memory.
                null return if not emit_deferred_actions(local_scope, false, fns, structs, generics, runtime, m, ctx, builder)
                emit_region_unwind(regions, runtime, builder)
                fn_failed_payload: LLVMValueRef = LLVMBuildLoad2(builder, fn_payload_llvm, fn_payload_pointer, "fn.try.failure.payload")
                _ = LLVMBuildStore(builder, fn_failed_payload, runtime.error_out)
                mutable forwarded_status: LLVMValueRef = fn_status
                if fn_error_family != fn_return_family:
                    if remap_error_status(fn_status, fn_error_family, fn_return_family, structs, ctx, builder) is remapped_fn_status:
                        forwarded_status <- remapped_fn_status
                    else:
                        return null
                if error_set_has_payload(structs, fn_return_family):
                    _ = LLVMBuildRet(builder, forwarded_status)
                else:
                    _ = LLVMBuildRet(builder, error_status_code(forwarded_status, ctx, builder))
                LLVMPositionBuilderAtEnd(builder, fn_success_block)
                fn_success_payload: LLVMValueRef = LLVMBuildLoad2(builder, fn_payload_llvm, fn_payload_pointer, "fn.try.success.payload")
                _ = LLVMBuildStore(builder, fn_success_payload, fn_result_slot)
                _ = LLVMBuildBr(builder, fn_done_block)
                LLVMPositionBuilderAtEnd(builder, fn_done_block)
                return LLVMBuildLoad2(builder, fn_payload_llvm, fn_result_slot, "fn.try.value")
            return null




        # Emit an error-returning call as a first-class `T error[E]` descriptor rather than
        # consuming it with `try`. This is selected when the destination local explicitly has
        # an error-union type; the existing split status/out-payload call ABI remains unchanged.
        def emit_error_union_call_value(name: sview, arguments: darray[Expr]&, expected: ValueType, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef, owner_hint: sview = "") -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            null return if expected.kind != TypeKind.ErrorUnion or not error_callee_is(fns, structs, generics, name)
            payload_type: ValueType = error_callee_value_type(name, arguments, local_scope, fns, structs, generics, owner_hint)
            expected_payload: ValueType = error_union_payload_of(expected, structs)
            null return if payload_type.kind != expected_payload.kind or payload_type.bits != expected_payload.bits
            if error_callee_target(name, arguments, local_scope, fns, structs, generics, m, ctx, owner_hint) is target:
                payload_llvm: LLVMTypeRef = llvm_type_of(payload_type, structs, ctx)
                out_slot: LLVMValueRef = build_entry_alloca(builder, payload_llvm, "error.union.out")
                call_args: mutable darray[LLVMValueRef] = [out_slot]
                declined: mutable bool = false
                argument_index: mutable usize = 0
                for argument in arguments |call_args, declined, argument_index, name, arguments, local_scope, fns, structs, generics, runtime, m, ctx, builder|:
                    wanted: ValueType = error_callee_param_type(name, arguments, argument_index, local_scope, fns, structs, generics, owner_hint)
                    if emit_expression(argument, wanted, local_scope, fns, structs, generics, runtime, m, ctx, builder) is argument_value:
                        call_args.push(argument_value)
                    else:
                        declined <- true
                    argument_index <- argument_index + 1
                null return if declined
                call_arena_count: usize = error_callee_arena_count(name, arguments, local_scope, fns, structs, generics, owner_hint)
                for _ in 0..<call_arena_count |call_args, arguments, local_scope, runtime, structs|:
                    call_args.push(call_site_arena(arguments, local_scope, runtime, structs))
                error_union_family: sview = error_union_family_of(expected, structs)
                error_union_fn_index: i64 = function_index_of(fns, error_callee_owner(fns, structs, name, owner_hint), name)
                error_union_extern: bool = error_union_fn_index >= 0 and fns.is_extern[error_union_fn_index.usize()]
                status: mutable LLVMValueRef = LLVMConstInt(LLVMInt32TypeInContext(ctx), 0, 0)
                if emit_error_status_call(target, call_args, error_union_family, error_union_extern, structs, ctx, builder) is error_union_status:
                    status <- error_union_status
                else:
                    return null
                result: mutable LLVMValueRef = LLVMGetUndef(llvm_type_of(expected, structs, ctx))
                result <- LLVMBuildInsertValue(builder, result, status, 0, "error.union.status")
                result <- LLVMBuildInsertValue(builder, result, out_slot, 1, "error.union.payload")
                return result
            return null




        # `try CALL else FALLBACK` as a VALUE. An error-returning function's ABI is a
        # leading OUT-POINTER plus an i32 status, so the produced value lives in the out
        # slot and the fallback runs on any nonzero status. Handles a plain error fn and a
        # generic one, with inferred (`f(x)`) or explicit (`f[K, V](x)`) type arguments.
        #
        # Without this the guarded call was emitted at its PAYLOAD type, so a `T?`-returning
        # error fn took the optional-unwrap path and `extractvalue`d the i32 status as if it
        # were an optional aggregate -- which crashes LLVM outright.
        def emit_try_else_error_call(guarded: Expr, fallback: Expr, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            match guarded:
                Expr.Call(te_callee, te_args, te_arg_names, te_call_line):
                    te_name: mutable sview = ""
                    te_type_args: mutable darray[ValueType] = []
                    te_explicit: mutable bool = false
                    te_bad_type_arg: mutable bool = false
                    te_owner: sview = try_callee_owner_with_generics(te_callee, fns, structs, generics)
                    match try_callee_as_ident_with_generics(te_callee, fns, structs, generics):
                        Expr.Ident(te_ident_name, te_ident_line):
                            te_name <- te_ident_name
                        _:
                            pass
                    match te_callee:
                        Expr.Index(te_index_head, te_index_arg, te_index_line):
                            match te_index_head:
                                Expr.Ident(te_index_name, te_index_name_line):
                                    te_name <- te_index_name
                                    te_explicit <- true
                                    te_single: ValueType = annotation_value_type(te_index_arg, structs)
                                    te_bad_type_arg <- true if te_single.kind == TypeKind.Unmodeled
                                    te_type_args.push(te_single)
                                _:
                                    pass
                        _:
                            pass
                    match te_callee:
                        Expr.IndexN(te_multi_head, te_multi_arg_exprs, te_multi_line):
                            match te_multi_head:
                                Expr.Ident(te_multi_name, te_multi_name_line):
                                    te_name <- te_multi_name
                                    te_explicit <- true
                                    for te_multi_arg in te_multi_arg_exprs |te_type_args, te_bad_type_arg, structs|:
                                        te_resolved: ValueType = annotation_value_type(te_multi_arg, structs)
                                        te_bad_type_arg <- true if te_resolved.kind == TypeKind.Unmodeled
                                        te_type_args.push(te_resolved)
                                _:
                                    pass
                        _:
                            pass
