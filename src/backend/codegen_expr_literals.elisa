# Stage1 backend — `emit_expression`: literal, lambda, optional-wrap, block, comprehension, refinement and catch forms.
# A group of the expression emitter's branches, called from codegen_expression.elisa.
# `handled` is set TRUE on entry and cleared only if no branch here matched, so a
# branch that DECLINES (returns null) still stops the dispatch — exactly as it did
# when every branch shared one function body.

extend Backend:
    private:
        def emit_expression_literals(expression: Expr, expected: ValueType, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef, handled: mutable bool&) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            handled <- true
            # A lambda VALUE `fn(params) => body` in a `fn(…)` context — lift it to a closure.
            # (An empty-body Expr.Lambda is a fn-TYPE annotation, never emitted as a value.)
            if expected.kind == TypeKind.Fn:
                match expression:
                    Expr.Lambda(lambda_value_params, lambda_value_body, _):
                        lambda_value_ok: bool = lambda_value_body.count > 0
                        emit_lambda_value(lambda_value_params, lambda_value_body, expected, local_scope, fns, structs, generics, runtime, m, ctx, builder) return if lambda_value_ok
                    _:
                        pass
            # IMPLICIT WRAP: Elisa has no `some(x)` — an expression of payload type in an
            # optional context IS the optional. Handled before everything else so each
            # value form stays unaware of optionals: re-emit at the PAYLOAD type, then wrap.
            # `null` is excluded (it is the empty optional, not a payload).
            if expected.kind == TypeKind.Optional:
                payload_type: ValueType = optional_payload_of(expected, structs)
                # A value-`if` / `match` already threads `expected` DOWN to its arms, so
                # each arm wraps itself. Wrapping the whole form instead would push the
                # payload type into the arms and reject `42 if flag else null` — the `null`
                # arm is not an i64.
                # `min`/`max` build the optional themselves (absence is a real answer), so they
                # are emitted AT the optional type rather than re-emitted at the payload type
                # and wrapped.
                if not is_null_literal(expression) and not propagates_expected(expression) and not comprehension_is_extremum(expression, structs):
                    own: ValueType = expression_type(expression, local_scope, fns, structs, generics)
                    if own.kind != TypeKind.Optional:
                        if emit_expression(expression, payload_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is payload_value:
                            return wrap_optional(payload_value, expected, structs, ctx, builder)
                        return null
            match expression:
                Expr.CharLit(char_text):
                    # stage0: char literals lower to i64 code units (e.g. '0' → 48).
                    # Lexer token text is the INTERIOR only (`A`, not `'A'`); quoted form is
                    # also accepted when a pattern/alias re-wraps the content.
                    char_code: mutable i64 = 0
                    if not parse_char_literal_code(char_text, char_code):
                        return null
                    char_ty: ValueType = expected if is_integer_type(expected) else ValueType{kind: TypeKind.Signed, bits: 64}
                    return LLVMConstInt(llvm_type_of(char_ty, structs, ctx), char_code.u64(), 1)
                _:
                    pass
            match expression:
                Expr.IntLit(literal_value):
                    # A literal takes the context's type. sign_extend=1 so a negative literal
                    # fills correctly at any width. C also permits an integer constant in a
                    # floating initializer/argument (`double x = 0;`, and comparisons such as
                    # `number >= 2147483647`). The parser intentionally leaves integer literals
                    # untyped, so this is the point where the destination supplies the implicit
                    # conversion. Rejecting it made otherwise ordinary C functions decline at
                    # their first float local or mixed comparison.
                    # C also converts integer constants to `_Bool`: the translator represents
                    # `true`/`false` fields as `1`/`0` arms of a context-typed conditional, so
                    # accepting the same constant form in a bool destination keeps generated C
                    # assignments faithful without weakening ordinary Elisa expression typing.
                    if expected.kind == TypeKind.Bool:
                        return LLVMConstInt(LLVMInt1TypeInContext(ctx), 1, 0) if literal_value != 0 else LLVMConstInt(LLVMInt1TypeInContext(ctx), 0, 0)
                    if is_integer_type(expected):
                        return LLVMConstInt(llvm_type_of(expected, structs, ctx), literal_value.u64(), 1)
                    if expected.kind == TypeKind.Float:
                        return LLVMConstReal(llvm_type_of(expected, structs, ctx), literal_value.f64())
                    return null
                _:
                    pass
            match expression:
                Expr.BoolLit(bool_value):
                    bool_type: LLVMTypeRef = LLVMInt1TypeInContext(ctx)
                    return LLVMConstInt(bool_type, 1, 0) if bool_value else LLVMConstInt(bool_type, 0, 0)
                _:
                    pass
            # `1.5` — built from the SOURCE TEXT, so LLVM's own parser decides the exact
            # bits rather than the backend re-implementing decimal rounding.
            match expression:
                Expr.FloatLit(float_text):
                    null return if expected.kind != TypeKind.Float
                    text_storage: mutable darray[u8] = []
                    return LLVMConstRealOfString(llvm_type_of(expected, structs, ctx), sview_to_cstr(float_text, text_storage))
                _:
                    pass
            # An ident is a local read: load from its slot, at the slot's own type.
            # `null` is an IDENT named "null" in the AST, not its own node. It is the
            # empty optional: `{false, undef}` — the payload half is never read when the
            # tag is false, so a zeroed struct is the whole value.
            # `move x` — an ownership TRANSFER, which the backend emits as the value itself.
            # Verified against stage0's IR: `freeze(move store)` adds no runtime call and no
            # new instruction, just `%frozen = alloca %Node__Store` + a copy of the store
            # value. The typestate (`Store[Local]` -> `Store[Frozen]`) is enforced by the
            # SEMANTIC checker -- same layout, no runtime effect -- so honouring the marker
            # here would be inventing work stage0 does not do.
            #
            # `freeze` itself never reaches the backend: the parser discards the marker and
            # yields the wrapped value.
            match expression:
                Expr.Move(moved_value, move_line):
                    suppress_drop_for_moved_local(local_scope, moved_value, structs, ctx, builder)
                    return emit_expression(moved_value, expected, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                _:
                    pass
            # `new[r] EXPR` — allocate the operand's value IN region `r` and yield a ref to
            # the allocation. stage0 emits `arena_alloc(ptr %r, i64 sizeof)` + a store of the
            # value; the wrapper cannot be erased the way `move`/`freeze` can, because the
            # expression's type is `T&` while its operand's is `T` — dropping it degrades
            # `v: i32& = new[scratch] x` into an int-to-pointer cast of the VALUE, which
            # then faults on the first dereference.
            match expression:
                Expr.RegionNew(region_new_operand, region_new_name, region_new_line):
                    # `new[NAME] …` selects a REGION only when NAME is an Arena local. The same
                    # syntax also targets a PACKED STORE (`new[store] Node.Empty(zeroed)` where
                    # `store: Node.Store[Local]`), which is a different construct entirely --
                    # the packed-store path builds it from the constructor call, so that shape
                    # keeps the transparent lowering it had before this node existed.
                    if lookup_type(local_scope, region_new_name).kind != TypeKind.Arena:
                        return emit_expression(region_new_operand, expected, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                    # The declared type is the ref; what gets stored is its pointee.
                    region_new_pointee: ValueType = ref_target_of(expected, structs) if expected.kind == TypeKind.Ref else expected
                    if lookup_slot(local_scope, region_new_name) is region_new_slot:
                        if emit_expression(region_new_operand, region_new_pointee, local_scope, fns, structs, generics, runtime, m, ctx, builder) is region_new_value:
                            region_new_arguments: mutable darray[LLVMValueRef] = [region_new_slot, runtime_size_argument(element_stride(region_new_pointee, structs, ctx), ctx, builder)]
                            region_new_pointer: void& = (&region_new_arguments[0]).cast[void&] can Unsafe.PointerCast
                            region_new_allocation: LLVMValueRef = LLVMBuildCall2(builder, runtime.arena_alloc_type, runtime.arena_alloc, region_new_pointer, 2, "region.alloc")
                            _ = LLVMBuildStore(builder, region_new_value, region_new_allocation)
                            return region_new_allocation
                    # An unknown region name or an operand we cannot lower DECLINES rather than
                    # falling through to the transparent path, which would emit the fault.
                    return null
                _:
                    pass
            # Value blocks are ordinary sequential statements followed by a tail value.
            # The parser uses this shape for block expressions and for the value-producing
            # branches of `if`/`match`; treating it as unmodeled made otherwise ordinary
            # local declarations in an expression position disappear from the backend.
            match expression:
                Expr.Block(block_statements, block_value, block_captures, block_line):
                    # `submit task(args)` is represented by the parser as an empty value block
                    # around the task call. Do not silently turn asynchronous submission into a
                    # synchronous call while the pool/task ABI lowering is incomplete.
                    if block_statements.count == 0:
                        for submit_marker in structs.fn_return_lines |structs, block_line|:
                            if submit_marker == block_line.line:
                                # `submit worker(arg)` lowers to pool_submit1(pool, worker, arg).
                                # The nursery group receives the already-emitted Task value below;
                                # re-emitting the call would enqueue the task twice.
                                null return if local_scope.pool_names.count == 0
                                match block_value:
                                    Expr.Call(submit_callee, submit_arguments, submit_argument_names, submit_line):
                                        null return if submit_arguments.count != 1
                                        match submit_callee:
                                            Expr.Ident(submit_worker, submit_worker_line):
                                                submit_arg_type: mutable ValueType = expression_type(submit_arguments[0], local_scope, fns, structs, generics)
                                                # Integer literals are intentionally context-free in
                                                # expression_type; for submit the worker signature is the
                                                # context that supplies their concrete argument type.
                                                submit_arg_type <- param_type_of(fns, "", submit_worker, 0.usize()) if submit_arg_type.kind == TypeKind.Unmodeled
                                                submit_ret_type: ValueType = lookup_return_type(fns, "", submit_worker)
                                                null return if submit_arg_type.kind == TypeKind.Unmodeled or submit_ret_type.kind == TypeKind.Unmodeled
                                                submit_pool: sview = local_scope.pool_names[local_scope.pool_names.count - 1.usize()]
                                                submit_types: mutable darray[ValueType] = [submit_arg_type, submit_ret_type]
                                                submit_call_arguments: mutable darray[Expr] = [Expr.Ident(submit_pool, submit_line), Expr.Ident(submit_worker, submit_worker_line), submit_arguments[0]]
                                                if emit_generic_call("pool_submit1", submit_types, submit_call_arguments, [], local_scope, fns, structs, generics, runtime, m, ctx, builder) is submitted_task:
                                                    if local_scope.group_names.count > 0:
                                                        group_name: sview = local_scope.group_names[local_scope.group_names.count - 1.usize()]
                                                        if emit_task_group_add_value(group_name, submitted_task, submit_ret_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is added_task:
                                                            _ = added_task
                                                        else:
                                                            return null
                                                    return LLVMConstNull(LLVMInt1TypeInContext(ctx))
                                            _:
                                                pass
                                        return null
                                    _:
                                        pass
                                return null
                        await_task_type: ValueType = expression_type(block_value, local_scope, fns, structs, generics)
                        await_base: mutable sview = ""
                        await_arg_start: mutable usize = 0
                        await_arg_count: mutable usize = 0
                        await_is_task: bool = generic_struct_instantiation_of(structs, await_task_type, await_base, await_arg_start, await_arg_count) and await_base == "Task" and await_arg_count >= 1
                        if fn_return_head_at(block_line.line, structs) == "__await" or await_is_task:
                            null return if not await_is_task
                            await_result_type: ValueType = copied_type(structs.generic_struct_inst_args[await_arg_start])
                            await_types: mutable darray[ValueType] = [await_result_type]
                            await_arguments: mutable darray[Expr] = [block_value]
                            return emit_generic_call("pool_await", await_types, await_arguments, [], local_scope, fns, structs, generics, runtime, m, ctx, builder)
                    # A value block may declare its tail slot as `name = zeroed` before
                    # control flow assigns the eventual value. The initializer alone has
                    # no type, but the enclosing expression's EXPECTED type is exact. This
                    # is the natural lowering for `machine from`: every `=> value` writes
                    # the slot, and the block yields it after the state graph terminates.
                    # Infer this one declaration from the block boundary instead of making
                    # the parser invent a source-level type expression from a backend type.
                    block_statement_start: mutable usize = 0
                    if expected.kind != TypeKind.Unmodeled and block_statements.count > 0:
                        match block_value:
                            Expr.Ident(block_result_name, block_result_line):
                                match block_statements[0]:
                                    Stmt.VarDecl(block_decl_name, block_decl_type, block_decl_value, block_decl_line):
                                        same_tail_slot: bool = block_decl_name == block_result_name
                                        untyped_decl: bool = block_decl_type is Expr.Invalid
                                        zero_initializer: mutable bool = false
                                        match block_decl_value:
                                            Expr.Ident(block_zero_name, block_zero_line):
                                                zero_initializer <- block_zero_name == "zeroed"
                                            _:
                                                pass
                                        if same_tail_slot and untyped_decl and zero_initializer:
                                            block_result_storage: mutable darray[u8] = []
                                            block_result_llvm: LLVMTypeRef = llvm_type_of(expected, structs, ctx)
                                            block_result_slot: LLVMValueRef = build_entry_alloca(builder, block_result_llvm, sview_to_cstr(block_decl_name, block_result_storage))
                                            block_result_alignment: u32 = struct_alignment(expected, structs)
                                            LLVMSetAlignment(block_result_slot, block_result_alignment) if block_result_alignment != 0
                                            _ = LLVMBuildStore(builder, LLVMConstNull(block_result_llvm), block_result_slot)
                                            declare_local(local_scope, block_decl_name, block_result_slot, expected)
                                            block_statement_start <- 1
                                    _:
                                        pass
                            _:
                                pass
                    block_runtime_statements: mutable darray[Stmt] = []
                    runtime_index: mutable usize = block_statement_start
                    while runtime_index < block_statements.count |runtime_index, block_runtime_statements|:
                        block_runtime_statements.push(block_statements[runtime_index])
                        runtime_index <- runtime_index + 1
                    block_loops: mutable LoopStack = LoopStack{exits: [], continues: [], defer_marks: []}
                    block_regions: mutable RegionStack = RegionStack{arenas: []}
                    block_status: EmitStatus = emit_statements(block_runtime_statements, expected, local_scope, block_loops, block_regions, fns, structs, generics, runtime, m, ctx, builder)
                    null return if block_status != EmitStatus.Open
                    return emit_expression(block_value, expected, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                _:
                    pass
            match expression:
                Expr.Comprehension(comp_var, comp_iterable, comp_condition, comp_body, comp_line):
                    return emit_comprehension(comp_var, comp_iterable, comp_condition, comp_body, comp_line.line, expected, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                _:
                    pass
            # `get xs[i] else FALLBACK` — a BOUNDS-CHECKED index. NOT a Refinement: the
            # SUBSCRIPT postfix consumes the `else` itself (parser_expr_ops's
            # accept_subscript_else), producing `Binary(Index(xs, i), TokenKind.Else,
            # FALLBACK)`, which `get` then wraps in a GetElse with an EMPTY recovery list.
            # `grep TokenKind.Else src/backend` found nothing at all — the checked-index
            # operator was simply unimplemented in codegen.
            #
            # A GetElse whose recovery is empty carries no control flow of its own, so it is
            # value-transparent: emit the guarded expression. (A NON-empty recovery is a
            # `return`/`break` branch and keeps declining here — the statement paths own it.)
            match expression:
                Expr.GetElse(ge_guarded, ge_recovery, ge_line):
                    null return if ge_recovery.count != 0
                    return emit_expression(ge_guarded, expected, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                _:
                    pass
            # stage0 lowers the checked index exactly as this does, read from its own -emit
            # llvm: compare the index against the header's count, load the element when in
            # range, take the fallback otherwise, and merge.
            #
            # Restricted to a DARRAY receiver — the shape with a runtime count to test. A
            # fixed array's bounds are static and a view/sview carries its length
            # differently; both keep declining rather than guessing at a count field.
            match expression:
                Expr.Binary(gi_indexed, gi_operator, gi_fallback, gi_line):
                    if gi_operator == TokenKind.Else:
                        match gi_indexed:
                            Expr.Index(gi_receiver, gi_index, gi_index_line):
                                gi_container_type: ValueType = iterable_darray_type(gi_receiver, local_scope, fns, structs, generics)
                                null return if gi_container_type.kind != TypeKind.DArray
                                gi_element_type: ValueType = darray_element_of(gi_container_type, structs)
                                null return if gi_element_type.kind == TypeKind.Unmodeled
                                if darray_read_slot(gi_receiver, gi_container_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is gi_slot:
                                    gi_i64: LLVMTypeRef = LLVMInt64TypeInContext(ctx)
                                    gi_header: LLVMTypeRef = darray_llvm_type(structs, ctx)
                                    gi_element_llvm: LLVMTypeRef = llvm_type_of(gi_element_type, structs, ctx)
                                    if emit_expression(gi_index, ValueType{kind: TypeKind.Unsigned, bits: 64}, local_scope, fns, structs, generics, runtime, m, ctx, builder) is gi_index_value:
                                        gi_count_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, gi_header, gi_slot, 1, "safe.index.count.ptr")
                                        gi_count: LLVMValueRef = LLVMBuildLoad2(builder, gi_i64, gi_count_pointer, "safe.index.count")
                                        # 36 = unsigned <. The index is a usize and the count is
                                        # non-negative, so an unsigned compare also rejects a
                                        # wrapped-negative index — matching stage0's `icmp ult`.
                                        gi_in_range: LLVMValueRef = LLVMBuildICmp(builder, 36, gi_index_value, gi_count, "safe.index.in.range")
                                        gi_function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                                        gi_in_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, gi_function, "safe.index.in_range")
                                        gi_fallback_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, gi_function, "safe.index.fallback")
                                        gi_end_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, gi_function, "safe.index.end")
                                        gi_result_slot: LLVMValueRef = LLVMBuildAlloca(builder, gi_element_llvm, "safe.index.result")
                                        _ = LLVMBuildCondBr(builder, gi_in_range, gi_in_block, gi_fallback_block)
                                        LLVMPositionBuilderAtEnd(builder, gi_in_block)
                                        gi_items_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, gi_header, gi_slot, 0, "safe.index.items.ptr")
                                        gi_items: LLVMValueRef = LLVMBuildLoad2(builder, LLVMPointerTypeInContext(ctx, 0), gi_items_pointer, "safe.index.items")
                                        gi_indices: mutable darray[LLVMValueRef] = [gi_index_value]
                                        gi_indices_pointer: void& = (&gi_indices[0]).cast[void&] can Unsafe.PointerCast
                                        gi_element_pointer: LLVMValueRef = LLVMBuildGEP2(builder, gi_element_llvm, gi_items, gi_indices_pointer, 1, "safe.index.elem.ptr")
                                        _ = LLVMBuildStore(builder, LLVMBuildLoad2(builder, gi_element_llvm, gi_element_pointer, "safe.index.value"), gi_result_slot)
                                        _ = LLVMBuildBr(builder, gi_end_block)
                                        LLVMPositionBuilderAtEnd(builder, gi_fallback_block)
                                        if emit_expression(gi_fallback, gi_element_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is gi_fallback_value:
                                            _ = LLVMBuildStore(builder, gi_fallback_value, gi_result_slot)
                                            _ = LLVMBuildBr(builder, gi_end_block)
                                            LLVMPositionBuilderAtEnd(builder, gi_end_block)
                                            return LLVMBuildLoad2(builder, gi_element_llvm, gi_result_slot, "safe.index.result.load")
                                        return null
                                    return null
                                return null
                            _:
                                pass
                _:
                    pass
            # `try CALL else FALLBACK` -> Expr.Refinement(fallback, guarded). Modeled only
            # when the guarded is a call to an ERROR-returning function: call it with a fresh
            # out-slot, and if the returned i32 code is 0 use the out-value, else the
            # fallback. Also: `get OPT else FALLBACK` where OPT is optional (same AST node).
            match expression:
                Expr.Refinement(try_fallback, try_guarded, try_line):
                    # An ERROR-returning callee must be lowered through its out-param ABI FIRST:
                    # its expression_type is the PAYLOAD, so the optional path below would
                    # otherwise treat the i32 status as an optional aggregate.
                    if emit_try_else_error_call(try_guarded, try_fallback, local_scope, fns, structs, generics, runtime, m, ctx, builder) is try_else_error_value:
                        return try_else_error_value
                    # `get OPT else FALLBACK` — optional unwrap to expression value (self-host lexer).
                    get_opt_type: ValueType = expression_type(try_guarded, local_scope, fns, structs, generics)
                    if get_opt_type.kind == TypeKind.Optional:
                        get_payload_type: ValueType = optional_payload_of(get_opt_type, structs)
                        if emit_expression(try_guarded, get_opt_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is get_opt_value:
                            get_tag: LLVMValueRef = optional_tag_of(get_opt_value, get_opt_type, structs, ctx, builder)
                            get_payload: LLVMValueRef = optional_payload_value_of(get_opt_value, get_opt_type, structs, ctx, builder)
                            get_fn: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                            get_present: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, get_fn, "get.expr.present")
                            get_absent: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, get_fn, "get.expr.absent")
                            get_done: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, get_fn, "get.expr.done")
                            result_ty: LLVMTypeRef = llvm_type_of(get_payload_type, structs, ctx)
                            result_slot: LLVMValueRef = LLVMBuildAlloca(builder, result_ty, "get.expr.result")
                            _ = LLVMBuildCondBr(builder, get_tag, get_present, get_absent)
                            LLVMPositionBuilderAtEnd(builder, get_present)
                            _ = LLVMBuildStore(builder, get_payload, result_slot)
                            _ = LLVMBuildBr(builder, get_done)
                            LLVMPositionBuilderAtEnd(builder, get_absent)
                            if emit_expression(try_fallback, get_payload_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is get_fallback_value:
                                _ = LLVMBuildStore(builder, get_fallback_value, result_slot)
                                _ = LLVMBuildBr(builder, get_done)
                                LLVMPositionBuilderAtEnd(builder, get_done)
                                return LLVMBuildLoad2(builder, result_ty, result_slot, "get.expr.load")
                            return null
                        return null
                    # `try VALUE else FALLBACK` also accepts a first-class error-union
                    # value, not only a direct error-returning call. Stage0 extracts the
                    # descriptor's code, keeps the payload on the success path, and runs
                    # the fallback on any nonzero code. This matters for locals and
                    # parameters carrying `T error[E]` values.
                    try_guarded_type: ValueType = expression_type(try_guarded, local_scope, fns, structs, generics)
                    if try_guarded_type.kind == TypeKind.ErrorUnion:
                        try_payload_type: ValueType = error_union_payload_of(try_guarded_type, structs)
                        null return if try_payload_type.kind == TypeKind.Unmodeled
                        if emit_expression(try_guarded, try_guarded_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is try_union_value:
                            try_union_code: LLVMValueRef = error_union_code_of(try_union_value, try_guarded_type, structs, ctx, builder)
                            try_union_ok: LLVMValueRef = LLVMBuildICmp(builder, 32, try_union_code, LLVMConstInt(LLVMInt32TypeInContext(ctx), 0, 0), "try.union.ok")
                            try_union_function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                            try_union_value_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, try_union_function, "try.union.value")
                            try_union_fallback_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, try_union_function, "try.union.fallback")
                            try_union_done_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, try_union_function, "try.union.done")
                            try_union_payload_llvm: LLVMTypeRef = llvm_type_of(try_payload_type, structs, ctx)
                            try_union_result_slot: LLVMValueRef = LLVMBuildAlloca(builder, try_union_payload_llvm, "try.union.result")
                            _ = LLVMBuildCondBr(builder, try_union_ok, try_union_value_block, try_union_fallback_block)
                            LLVMPositionBuilderAtEnd(builder, try_union_value_block)
