# Stage1 backend — `emit_expression`: literal, lambda, optional-wrap, block, comprehension, refinement and catch forms.
# A group of the expression emitter's branches, called from codegen_expression.elisa.
# `handled` is set TRUE on entry and cleared only if no branch here matched, so a
# branch that DECLINES (returns null) still stops the dispatch — exactly as it did
# when every branch shared one function body.

extend Backend:
    private:
        def emit_expression_literals(expression: Expr, expected: ValueType, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef, handled: mutable bool&) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            handled <- true
            # A lambda VALUE `fn(params) => body` in a `fn(…)` context — lift it to a closure.
            # (An empty-body Expr.Lambda is a fn-TYPE annotation, never emitted as a value.)
            if expected.kind == TypeKind.Fn:
                match expression:
                    Expr.Lambda(lambda_value_params, lambda_value_body, _):
                        lambda_value_ok: bool = lambda_value_body.count > 0
                        emit_lambda_value(lambda_value_params, lambda_value_body, expected, local_scope, fns, structs, generics, runtime, m, ctx, builder) return if lambda_value_ok
                    _:
                        pass
            # IMPLICIT WRAP: Elisa has no `some(x)` — an expression of payload type in an
            # optional context IS the optional. Handled before everything else so each
            # value form stays unaware of optionals: re-emit at the PAYLOAD type, then wrap.
            # `null` is excluded (it is the empty optional, not a payload).
            if expected.kind == TypeKind.Optional:
                payload_type: ValueType = optional_payload_of(expected, structs)
                # A value-`if` / `match` already threads `expected` DOWN to its arms, so
                # each arm wraps itself. Wrapping the whole form instead would push the
                # payload type into the arms and reject `42 if flag else null` — the `null`
                # arm is not an i64.
                # `min`/`max` build the optional themselves (absence is a real answer), so they
                # are emitted AT the optional type rather than re-emitted at the payload type
                # and wrapped.
                if not is_null_literal(expression) and not propagates_expected(expression) and not comprehension_is_extremum(expression, structs):
                    own: ValueType = expression_type(expression, local_scope, fns, structs, generics)
                    if own.kind != TypeKind.Optional:
                        if emit_expression(expression, payload_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is payload_value:
                            return wrap_optional(payload_value, expected, structs, ctx, builder)
                        return null
            match expression:
                Expr.CharLit(char_text, _):
                    # stage0: char literals lower to i64 code units (e.g. '0' → 48).
                    # Lexer token text is the INTERIOR only (`A`, not `'A'`); quoted form is
                    # also accepted when a pattern/alias re-wraps the content.
                    char_code: mutable i64 = 0
                    if not parse_char_literal_code(char_text, char_code):
                        return null
                    char_ty: ValueType = expected if is_integer_type(expected) else ValueType{kind: TypeKind.Signed, bits: 64}
                    return LLVMConstInt(llvm_type_of(char_ty, structs, ctx), char_code.u64(), 1)
                _:
                    pass
            match expression:
                Expr.IntLit(literal_value, _):
                    # A literal takes the context's type. sign_extend=1 so a negative literal
                    # fills correctly at any width. C also permits an integer constant in a
                    # floating initializer/argument (`double x = 0;`, and comparisons such as
                    # `number >= 2147483647`). The parser intentionally leaves integer literals
                    # untyped, so this is the point where the destination supplies the implicit
                    # conversion. Rejecting it made otherwise ordinary C functions decline at
                    # their first float local or mixed comparison.
                    # C also converts integer constants to `_Bool`: the translator represents
                    # `true`/`false` fields as `1`/`0` arms of a context-typed conditional, so
                    # accepting the same constant form in a bool destination keeps generated C
                    # assignments faithful without weakening ordinary Elisa expression typing.
                    if expected.kind == TypeKind.Bool:
                        return LLVMConstInt(LLVMInt1TypeInContext(ctx), 1, 0) if literal_value != 0 else LLVMConstInt(LLVMInt1TypeInContext(ctx), 0, 0)
                    if is_integer_type(expected):
                        return LLVMConstInt(llvm_type_of(expected, structs, ctx), literal_value.u64(), 1)
                    if expected.kind == TypeKind.Float:
                        return LLVMConstReal(llvm_type_of(expected, structs, ctx), literal_value.f64())
                    return null
                _:
                    pass
            match expression:
                Expr.BoolLit(bool_value, _):
                    bool_type: LLVMTypeRef = LLVMInt1TypeInContext(ctx)
                    return LLVMConstInt(bool_type, 1, 0) if bool_value else LLVMConstInt(bool_type, 0, 0)
                _:
                    pass
            # `1.5` — built from the SOURCE TEXT, so LLVM's own parser decides the exact
            # bits rather than the backend re-implementing decimal rounding.
            match expression:
                Expr.FloatLit(float_text, _):
                    null return if expected.kind != TypeKind.Float
                    text_storage: mutable darray[u8] = []
                    return LLVMConstRealOfString(llvm_type_of(expected, structs, ctx), sview_to_cstr(float_text, text_storage))
                _:
                    pass
            # An ident is a local read: load from its slot, at the slot's own type.
            # `null` is an IDENT named "null" in the AST, not its own node. It is the
            # empty optional: `{false, undef}` — the payload half is never read when the
            # tag is false, so a zeroed struct is the whole value.
            # `move x` — an ownership TRANSFER, which the backend emits as the value itself.
            # Verified against stage0's IR: `freeze(move store)` adds no runtime call and no
            # new instruction, just `%frozen = alloca %Node__Store` + a copy of the store
            # value. The typestate (`Store[Local]` -> `Store[Frozen]`) is enforced by the
            # SEMANTIC checker -- same layout, no runtime effect -- so honouring the marker
            # here would be inventing work stage0 does not do.
            #
            # `freeze` itself never reaches the backend: the parser discards the marker and
            # yields the wrapped value.
            match expression:
                Expr.Move(moved_value, move_line):
                    suppress_drop_for_moved_local(local_scope, moved_value, structs, ctx, builder)
                    return emit_expression(moved_value, expected, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                _:
                    pass
            # `new[r] EXPR` — allocate the operand's value IN region `r` and yield a ref to
            # the allocation. stage0 emits `arena_alloc(ptr %r, i64 sizeof)` + a store of the
            # value; the wrapper cannot be erased the way `move`/`freeze` can, because the
            # expression's type is `T&` while its operand's is `T` — dropping it degrades
            # `v: i32& = new[scratch] x` into an int-to-pointer cast of the VALUE, which
            # then faults on the first dereference.
            match expression:
                Expr.RegionNew(region_new_operand, region_new_name, region_new_line):
                    # `new[NAME] …` selects a REGION only when NAME is an Arena local. The same
                    # syntax also targets a PACKED STORE (`new[store] Node.Empty(zeroed)` where
                    # `store: Node.Store[Local]`), which is a different construct entirely --
                    # the packed-store path builds it from the constructor call, so that shape
                    # keeps the transparent lowering it had before this node existed.
                    region_new_local: bool = lookup_type(local_scope, region_new_name).kind == TypeKind.Arena
                    region_new_parameter_index: i64 = region_parameter_index(runtime.function_line, region_new_name, structs)
                    if not region_new_local and region_new_parameter_index < 0:
                        return emit_expression(region_new_operand, expected, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                    # The declared type is the ref; what gets stored is its pointee.
                    region_new_pointee: ValueType = ref_target_of(expected, structs) if expected.kind == TypeKind.Ref else expected
                    region_new_target: mutable LLVMValueRef? = null
                    region_new_target <- lookup_slot(local_scope, region_new_name) if region_new_local
                    if not region_new_local and region_new_parameter_index >= 0 and region_new_parameter_index.usize() < runtime.caller_arenas.count:
                        region_new_target <- runtime.caller_arenas[region_new_parameter_index.usize()]
                    if region_new_target is region_new_arena:
                        if emit_expression(region_new_operand, region_new_pointee, local_scope, fns, structs, generics, runtime, m, ctx, builder) is region_new_value:
                            region_new_arguments: mutable darray[LLVMValueRef] = [region_new_arena, runtime_size_argument(element_stride(region_new_pointee, structs, ctx), ctx, builder)]
                            region_new_pointer: void& = (&region_new_arguments[0]).cast[void&] can Unsafe.PointerCast
                            region_new_allocation: LLVMValueRef = LLVMBuildCall2(builder, runtime.arena_alloc_type, runtime.arena_alloc, region_new_pointer, 2, "region.alloc")
                            _ = LLVMBuildStore(builder, region_new_value, region_new_allocation)
                            return region_new_allocation
                    # An unknown region name or an operand we cannot lower DECLINES rather than
                    # falling through to the transparent path, which would emit the fault.
                    return null
                _:
                    pass
            # Value blocks are ordinary sequential statements followed by a tail value.
            # The parser uses this shape for block expressions and for the value-producing
            # branches of `if`/`match`; treating it as unmodeled made otherwise ordinary
            # local declarations in an expression position disappear from the backend.
            return emit_expression_block_forms(expression, expected, local_scope, fns, structs, generics, runtime, m, ctx, builder, handled)

include "./codegen_expr_blocks.elisa"
include "./codegen_expr_refinement.elisa"
include "./codegen_expr_strings.elisa"
