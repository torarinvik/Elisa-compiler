# Stage1 backend -- push-order hash chains over the unit's enum annotations, keyed by owner.
# declare_extern asked half a dozen "is there an annotation with owner X and name Y"
# questions per extern, each a scan of the whole annotation stream. A chain visits only the
# rows whose owner hashes like the key, in stream order, and every caller still
# compares the real fields, so a collision can only cost a comparison.
# Part of `module Backend` (see codegen.elisa).
extend Backend:
    private:
        const ANNOTATION_INDEX_HASH_OFFSET: u64 = 14695981039346656037
        const ANNOTATION_INDEX_HASH_PRIME: u64 = 1099511628211
        const ANNOTATION_INDEX_NONE: i64 = -1

        def annotation_index_hash(text: sview) -> u64 can[Abort.Panic]:
            hash: mutable u64 = ANNOTATION_INDEX_HASH_OFFSET
            for offset in 0..<sview_len(text) |hash, text|:
                hash <- (hash ^ sview_at(text, offset).u64()) * ANNOTATION_INDEX_HASH_PRIME
            return hash

        # (Re)build both chains unless they already cover exactly ANNOTATIONS' rows.
        def ensure_annotation_index(structs: mutable StructTable&, annotations: darray[Ast::EnumAnnotation]&) -> void can[Abort.Panic, Memory.Allocate]:
            return if structs.annotation_owner_next.count == annotations.count and annotations.count > 0
            structs.annotation_owner_heads <- {}
            structs.annotation_owner_tails <- {}
            structs.annotation_owner_next <- []
            for row in 0..<annotations.count |structs, annotations|:
                owner_hash: u64 = annotation_index_hash(annotations[row].owner)
                structs.annotation_owner_next.push(ANNOTATION_INDEX_NONE)
                if structs.annotation_owner_tails.get(owner_hash) is owner_last:
                    structs.annotation_owner_next[owner_last.usize()] <- row.i64()
                else:
                    structs.annotation_owner_heads <- structs.annotation_owner_heads.put(owner_hash, row.i64())
                structs.annotation_owner_tails <- structs.annotation_owner_tails.put(owner_hash, row.i64())

        def annotation_owner_first(structs: StructTable&, owner: sview) -> i64 can[Abort.Panic]:
            return head if structs.annotation_owner_heads.get(annotation_index_hash(owner)) is head else ANNOTATION_INDEX_NONE

        # Is there a row with exactly this OWNER and NAME? (Index must be current.)
        def annotation_pair_present(structs: StructTable&, annotations: darray[Ast::EnumAnnotation]&, owner: sview, name: sview) -> bool can[Abort.Panic]:
            row: mutable i64 = annotation_owner_first(structs, owner)
            while row >= 0 |row, structs, annotations, owner, name|:
                true return if annotations[row.usize()].owner == owner and annotations[row.usize()].name == name
                row <- structs.annotation_owner_next[row.usize()]
            return false
