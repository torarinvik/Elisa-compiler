# Stage1 backend — LLVM codegen (`module Backend`).
#
# The stage0 counterpart is compiler/src/backend/llvm_*.go (~54k lines of cgo). This is
# the growing port of that: it walks the stage1 AST and drives LLVM-C (see llvm_c.elisa).
#
# Sound SUBSET, mirroring how the frontend was ported: only firmly-modeled constructs
# emit. Every emitter returns a "declined" signal for anything it does not model, and
# `emit_module` turns ANY decline into a whole-module decline, so the driver reports an
# honest UNSUPPORTED instead of handing back a module that is quietly missing code.
# Coverage grows one construct at a time, each with a compile-and-run fixture asserting
# real behavior (an exit code), plus a differential against stage0 where the reference
# compiler can compile the same source.
#
# Modeled today: `def f(a: i64, …) -> i64` over signed i64 — int literals, idents,
# `+ - * / %`, unary `+`/`-`, comparisons, parens, locals (`x: i64 = …`), assignment,
# `if`/`else`, `while`, `return`, and direct calls to other modeled functions.

include "../parser/parser.elisa"
include "llvm_c.elisa"
include "c_header.elisa"
include "easm_register_masks.elisa"
include "easm_memstate_domain.elisa"
include "easm_layout_arithmetic.elisa"
include "easm_access_width.elisa"
include "easm_memory_effect_policy.elisa"
include "easm_memory_base_policy.elisa"
include "easm_register_effect_policy.elisa"
include "easm_address_width_policy.elisa"
include "easm_model.elisa"
include "easm_parse_state_policy.elisa"
include "easm_checked_decimal.elisa"
include "easm_text_scan.elisa"
include "easm_compose_text.elisa"
include "easm_operand_scan.elisa"
include "easm_verify_provenance.elisa"
include "easm_verify_memory.elisa"
include "./easm_verify_memory_effects.elisa"
include "easm_verify_function.elisa"
include "./easm_verify_function_conditional_inputs.elisa"
include "easm_parse.elisa"
using Ast

module Backend:
    private:
        def strict_fp_enabled() -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            if getenv("ELISACORE_STRICT_FP") is value:
                return value.cast[cstr] != ""
            return false

        def global_fast_math_enabled() -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            if getenv("ELISACORE_FAST_MATH") is value:
                return value.cast[cstr] != ""
            return false

        def keep_frame_pointer_enabled() -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            if getenv("ELISA_STAGE1_KEEP_FRAME_POINTER") is value:
                return value.cast[cstr] == "1"
            return false


        # Component guests have a freestanding runtime whose counted string helper
        # deliberately avoids libc. Keep the backend's native memcmp fast path out of
        # component modules, where it would become an unsupported `env::memcmp` import.
        # `emit_module_core` samples this once into BackendTarget before any body lowering;
        # hot helpers consume that snapshot instead of probing getenv per expression.
        def wasm_component_codegen_enabled() -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            if getenv("ELISA_STAGE1_WASM_COMPONENT_TYPES") is component_types:
                return component_types.cast[cstr] != ""
            return false


        def trace_functions_only_enabled() -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            flag_storage: mutable darray[u8] = []
            flag_name: cstr = sview_to_cstr("ELISA_STAGE1_TRACE_FUNCTIONS_ONLY", flag_storage)
            if getenv(flag_name) is value:
                return value.cast[cstr] == "1"
            return false


        # The backend is also included directly by the native-emitter driver, without the
        # driver's include helpers. Keep this bounded local length primitive here rather than
        # depending on `driver/elisac_includes.elisa`; otherwise a profiler-enabled standalone
        # backend declines before it can emit any IR.
        def pgo_cstr_length(text: cstr) -> i64 can[Abort.Panic]:
            length: mutable i64 = 0
            for _step in 0..<1048576 |length, text|:
                break if text[length.usize()] == 0
                length <- length + 1
            return length



        # `-fprofile-use` is loaded by the stage1 CLI into a newline-separated environment
        # bridge. Copy it on the first eligible declaration in each module; compare complete
        # records so `parse` cannot accidentally match `parse_bytes`. The backend treats this
        # as a cost hint; no verifier or runtime contract depends on it.
        def pgo_hot_function_enabled(function_name: sview, structs: mutable StructTable&) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            if not structs.target.pgo_hot_profile_loaded:
                structs.target.pgo_hot_profile_loaded <- true
                if getenv("ELISA_STAGE1_PGO_HOT_FUNCTIONS") is profile_bytes:
                    profile_text: cstr = profile_bytes.cast[cstr] can Unsafe.PointerCast
                    profile_length: i64 = pgo_cstr_length(profile_text)
                    structs.target.pgo_hot_profile_bytes.reserve(profile_length.usize() + 1)
                    for profile_index in 0..<profile_length |profile_text, structs|:
                        structs.target.pgo_hot_profile_bytes.push(profile_text[profile_index.usize()])
                    structs.target.pgo_hot_profile_bytes.push(0)
                    # The owned allocation is now complete and will never grow again. Keep
                    # its stable bytes pointer so matching avoids DArray bounds checks.
                    structs.target.pgo_hot_profile_text <- (&structs.target.pgo_hot_profile_bytes[0]).cast[cstr] can Unsafe.PointerCast
                    structs.target.pgo_hot_profile_present <- true
                    structs.target.pgo_hot_profile_length <- profile_length
            if structs.target.pgo_hot_profile_present:
                profile_length: i64 = structs.target.pgo_hot_profile_length
                profile_text: cstr = structs.target.pgo_hot_profile_text
                entry_start: mutable i64 = 0
                while entry_start <= profile_length |entry_start, profile_text, profile_length, function_name|:
                    entry_stop: mutable i64 = entry_start
                    while entry_stop < profile_length and profile_text[entry_stop.usize()] != 10 |entry_stop, profile_text|:
                        entry_stop <- entry_stop + 1
                    candidate_length: i64 = entry_stop - entry_start
                    if candidate_length == function_name.len.i64():
                        matched: mutable bool = true
                        for candidate_index in 0..<candidate_length.usize() |matched, profile_text, entry_start, function_name|:
                            matched <- false if profile_text[(entry_start + candidate_index.i64()).usize()] != function_name[candidate_index]
                        return true if matched
                    break if entry_stop == profile_length
                    entry_start <- entry_stop + 1
                return false
            return false


        # `-fnoalias` is an explicit opt-in in stage0 because an incorrect noalias
        # promise is a silent optimizer miscompile. The stage1 driver is itself a
        # native program, so mirror the CLI's process configuration through libc's
        # environment rather than changing the source-language ABI.
        def noalias_mutable_refs_enabled() -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            flag_storage: mutable darray[u8] = []
            flag_name: cstr = sview_to_cstr("ELISACORE_NOALIAS_MUTABLE_REFS", flag_storage)
            if getenv(flag_name) is real:
                return true
            return false




        # `-fbounds-check` is an opt-in debugging mode in stage0. Keep the switch in
        # the process environment so the self-hosted product and the stage0-seeded
        # driver use the same configuration path.
        def force_bounds_check_enabled() -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            flag_storage: mutable darray[u8] = []
            flag_name: cstr = sview_to_cstr("ELISACORE_FORCE_BOUNDS_CHECK", flag_storage)
            if getenv(flag_name) is real:
                return true
            return false




        # `-foverflow=trap|wrap` (env mirror `ELISACORE_OVERFLOW`). Read by VALUE, unlike the
        # presence flags above: only the exact value `wrap` disables signed-overflow traps, so
        # an empty or misspelled setting keeps the safe default instead of silently wrapping.
        def overflow_wrap_enabled() -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            flag_storage: mutable darray[u8] = []
            flag_name: cstr = sview_to_cstr("ELISACORE_OVERFLOW", flag_storage)
            if getenv(flag_name) is mode_bytes:
                mode_c: cstr = (mode_bytes).cast[cstr] can Unsafe.PointerCast
                return true if mode_c == "wrap"
            return false




        # Is this compile the BUNDLED RUNTIME object itself (scripts/build_runtime_object.sh
        # sets ELISA_STAGE1_RUNTIME_STD=1)? Its definitions are the entry points every program
        # links against, so they keep the -O0 linkage policy at every level: the optimised
        # build must not internalise them and let LLVM delete the whole unit.
        def bundled_runtime_build() -> bool can[Abort.Panic, Unsafe.PointerCast]:
            if getenv("ELISA_STAGE1_RUNTIME_STD") is flag_bytes:
                flag_c: cstr = (flag_bytes).cast[cstr] can Unsafe.PointerCast
                return flag_c == "1"
            return false


        # Stage0 marks non-exported function definitions private before LLVM optimization
        # whenever the requested level is above O0. The stage1 driver communicates that
        # level through the same environment used by its optimization pass; keeping the
        # linkage decision here makes library units and program units follow the reference
        # compiler instead of incorrectly using the presence of `main` as a proxy.
        def prefer_private_linkage_enabled() -> bool can[Abort.Panic, Unsafe.PointerCast]:
            if getenv("ELISA_STAGE1_OPT") is level_bytes:
                level_c: cstr = (level_bytes).cast[cstr] can Unsafe.PointerCast
                return true if level_c == "1" or level_c == "2" or level_c == "3"
            return false




        # The named scalar types the backend models. Anything else (f32/f64, containers,
        # user types) yields Unmodeled and DECLINES rather than being guessed at.
        #
        # `int`, `isize`, and `usize` follow the target pointer width.
        # Fixed-width spellings such as `i32` and `i64` retain their explicit widths.
        # The `is TARGET as NAME` alias recorded at the exact target position, or "".
        def is_variant_alias_at(line: i64, offset: u32, structs: StructTable&) -> sview can[Abort.Panic]:
            return "" if structs.annotations.is_variant_alias_lines.count != structs.annotations.is_variant_alias_offsets.count or structs.annotations.is_variant_alias_lines.count != structs.annotations.is_variant_alias_names.count
            for probe in 0..<structs.annotations.is_variant_alias_lines.count:
                return structs.annotations.is_variant_alias_names[probe] if structs.annotations.is_variant_alias_lines[probe] == line and structs.annotations.is_variant_alias_offsets[probe] == offset
            return ""




        # The `derive state:` predicate for the actual resolved struct owner, or -1 when
        # that type has no such state. Never borrow a unique same-leaf rule from another
        # module: the lexical module may resolve the leaf to a different local or root type.
        def derived_state_rule_index(structs: mutable StructTable&, owner: sview, state: sview, module_name: sview) -> i64 can[Abort.Panic, Memory.Allocate]:
            rule_count: usize = structs.annotations.derived_state_owners.count
            return -1 if:
                rule_count != structs.annotations.derived_state_modules.count
                rule_count != structs.annotations.derived_state_names.count
                rule_count != structs.annotations.derived_state_conditions.count
            saved_owner: sview = structs.visibility.current_owner
            structs.visibility.current_owner <- module_name
            resolved_type: ValueType = resolve_type_head(owner, structs)
            structs.visibility.current_owner <- saved_owner
            return -1 if resolved_type.kind != TypeKind.Struct or resolved_type.bits.usize() >= structs.records.owners.count
            resolved_module: sview = struct_owner_at(structs, resolved_type.bits.usize())
            exact_index: mutable i64 = -1
            exact_count: mutable usize = 0.usize()
            for probe in 0..<rule_count |owner, state, resolved_module, exact_index, exact_count, structs|:
                continue if structs.annotations.derived_state_owners[probe] != owner or structs.annotations.derived_state_names[probe] != state
                if structs.annotations.derived_state_modules[probe] == resolved_module:
                    exact_index <- probe.i64()
                    exact_count <- exact_count + 1.usize()
            return exact_index if exact_count == 1.usize()
            return -1




        # Whether a `submit` marker was recorded at this token offset.
        def submit_marker_at(offset: u32, structs: StructTable&) -> bool can[Abort.Panic]:
            if structs.annotations.submit_offsets_sorted:
                low: mutable usize = 0.usize()
                high: mutable usize = structs.annotations.submit_offsets.count
                while low < high |low, high, offset, structs|:
                    middle: usize = low + (high - low) / 2.usize()
                    if structs.annotations.submit_offsets[middle] < offset:
                        low <- middle + 1.usize()
                    else:
                        high <- middle
                return false if low >= structs.annotations.submit_offsets.count
                return structs.annotations.submit_offsets[low] == offset
            for probe in 0..<structs.annotations.submit_offsets.count:
                return true if structs.annotations.submit_offsets[probe] == offset
            return false




        # The explicit `submit[pool]` selector recorded at the submit keyword's byte offset, or "".
        def submit_pool_name_at(offset: u32, structs: StructTable&) -> sview @source can[Abort.Panic]:
            paired: usize = structs.annotations.submit_pool_offsets.count if structs.annotations.submit_pool_offsets.count < structs.annotations.submit_pool_names.count else structs.annotations.submit_pool_names.count
            for probe in 0..<paired:
                return structs.annotations.submit_pool_names[probe] if structs.annotations.submit_pool_offsets[probe] == offset
            return ""




        # Parser annotations store byte offsets; backend lookups use the same nonzero scope
        # IDs carried by Expr.Comprehension. Mark the reserved-zero sentinel malformed once
        # while building this file's side tables.
        def query_scope_id_for_annotation(offset: u32, structs: mutable StructTable&) -> u32:
            scope_id: u32 = Ast::query_scope_id_from_offset(offset)
            structs.queries.scope_ids_well_formed <- false if scope_id == 0
            return scope_id



        # The number of extra binders recorded for this query head. Codegen currently
        # models only the two-binder enumerate form; callers decline other arities.
        def query_extra_binder_count_at(scope_id: u32, structs: StructTable&, valid: mutable bool&) -> usize can[Abort.Panic]:
            metadata_valid: bool = structs.queries.query_extra_binder_scope_ids.count == structs.queries.query_extra_binder_names.count
            valid <- metadata_valid
            return 0.usize() if not metadata_valid
            count: mutable usize = 0.usize()
            for probe in 0..<structs.queries.query_extra_binder_scope_ids.count |count, scope_id, structs|:
                count <- count + 1.usize() if structs.queries.query_extra_binder_scope_ids[probe] == scope_id
            return count


        # The first extra binder of a query at its head scope, or "".
        def query_extra_binder_at(scope_id: u32, structs: StructTable&) -> sview @source can[Abort.Panic]:
            for probe in 0..<structs.queries.query_extra_binder_scope_ids.count:
                return structs.queries.query_extra_binder_names[probe] if structs.queries.query_extra_binder_scope_ids[probe] == scope_id
            return ""



        # The parallel query-head/line pools are populated once per query. A mismatch is
        # malformed metadata and must not degrade into the empty-head collection fallback.
        def query_scope_metadata_valid(structs: StructTable&) -> bool can[Abort.Panic]:
            return structs.queries.scope_ids_well_formed and structs.queries.query_scope_ids.count == structs.queries.query_heads.count and structs.queries.query_scope_ids.count == structs.queries.query_binders.count and structs.queries.query_scope_ids.count == structs.queries.query_lines.count




        # Whether this comprehension's `for` token carries the list-map `by par` marker.
        def parallel_comprehension_at(scope_id: u32, structs: StructTable&) -> bool can[Abort.Panic]:
            for probe in 0..<structs.queries.parallel_comprehension_scope_ids.count:
                return true if structs.queries.parallel_comprehension_scope_ids[probe] == scope_id
            return false




        # The receiver of an `X.enumerate()` iterable, or Absent when the iterable is not one.
        def query_enumerate_receiver(iterable: Expr) -> Expr can[Abort.Panic]:
            if iterable is Expr.Call(qe_callee, qe_args, qe_arg_names, qe_call_line):
                if qe_callee is Expr.Field(qe_source, qe_method, qe_method_line):
                    return qe_source if qe_method == "enumerate" and qe_args.count == 0
            return (Expr.Absent)




        # The brace-pattern FIELD name at `position` for the exact owning `for` token, or "".
        def for_brace_field_at(for_offset: u32, position: usize, structs: StructTable&) -> sview can[Abort.Panic]:
            return "" if structs.queries.for_brace_field_offsets.count != structs.queries.for_brace_field_names.count
            seen: mutable usize = 0
            for probe in 0..<structs.queries.for_brace_field_offsets.count |seen, for_offset, position, structs|:
                if structs.queries.for_brace_field_offsets[probe] == for_offset:
                    return structs.queries.for_brace_field_names[probe] if seen == position
                    seen <- seen + 1
            return ""




        def scalar_type_of_name(name: sview, target_bits: u32) -> ValueType:
            return when name:
                "cstr" -> ValueType{kind: TypeKind.CStr, bits: 0}
                "sview" -> ValueType{kind: TypeKind.SView, bits: 0}
                "i8" | "s8" -> ValueType{kind: TypeKind.Signed, bits: 8}
                "i16" | "s16" -> ValueType{kind: TypeKind.Signed, bits: 16}
                "i32" | "s32" -> ValueType{kind: TypeKind.Signed, bits: 32}
                # `isize` is the signed pointer-width counterpart of `usize` and is used by
                # the portable runtime's sysconf/ callback seams. `int` also follows the target
                # pointer width, matching stage0; C's `int` must be spelled `i32` separately.
                "isize" | "int" -> ValueType{kind: TypeKind.Signed, bits: target_bits}
                "i64" | "s64" -> ValueType{kind: TypeKind.Signed, bits: 64}
                "u8" -> ValueType{kind: TypeKind.Unsigned, bits: 8}
                "u16" -> ValueType{kind: TypeKind.Unsigned, bits: 16}
                "u32" -> ValueType{kind: TypeKind.Unsigned, bits: 32}
                "usize" | "uintptr" -> ValueType{kind: TypeKind.Unsigned, bits: target_bits}
                "u64" -> ValueType{kind: TypeKind.Unsigned, bits: 64}
                "bool" -> ValueType{kind: TypeKind.Bool, bits: 1}
                # stage0 lowers `char` to i64 (`define i64 @f(i64)`, `icmp eq i64`) — a full-width
                # signed scalar, not a byte. Model it identically so char arithmetic/compares work.
                "char" -> ValueType{kind: TypeKind.Signed, bits: 64}
                "f32" -> ValueType{kind: TypeKind.Float, bits: 32}
                "f64" -> ValueType{kind: TypeKind.Float, bits: 64}
                "void" -> ValueType{kind: TypeKind.Void, bits: 0}
                _ -> unmodeled_type()




        # LLVM-C exposes opaque handle typedefs as pointer-sized values. They are declared
        # as bare extern names in llvm_c.elisa, so resolve them explicitly while registering
        # aggregate fields as well as function parameters; waiting for the extern declaration
        # pass leaves fields such as `Scope.slots: darray[LLVMValueRef]` unmodeled.
        def llvm_opaque_handle_name(name: sview) -> bool:
            return when name:
                "LLVMContextRef" | "LLVMModuleRef" | "LLVMTypeRef" | "LLVMValueRef" | "LLVMBuilderRef" -> true
                "LLVMBasicBlockRef" | "LLVMTargetRef" | "LLVMTargetMachineRef" | "LLVMTargetDataRef" -> true
                "LLVMMetadataRef" | "LLVMAttributeRef" | "LLVMDIBuilderRef" | "LLVMDbgRecordRef" | "LLVMPassBuilderOptionsRef" -> true
                _ -> false




        # What `name` is bound to in the CURRENT instantiation, or Unmodeled if it is not a
        # type parameter (i.e. it is an ordinary type name).
        def bound_type_of(structs: mutable StructTable&, name: sview) -> ValueType can[Abort.Panic]:
            # Scan most-recent-first so an inner instantiation's binding shadows an outer
            # one that reuses the same parameter name (`DictBucket[K, T]` nested inside
            # `DynDict[K, T]`). For a single instantiation there are no duplicates, so this
            # is identical to a forward scan.
            count: usize = structs.bindings.binding_names.count
            for offset in 0..<count |structs, name, count|:
                index: usize = count - 1 - offset
                return copied_type(structs.bindings.binding_types[index]) if structs.bindings.binding_names[index] == name
            return unmodeled_type()




        # Whether a name is bound as a generic parameter in the active instantiation.
        # Keep this separate from bound_type_of: an unmodeled/phantom type argument is
        # still a binding and must shadow a same-named declaration in the user's module.
        def has_bound_type(structs: mutable StructTable&, name: sview) -> bool:
            count: usize = structs.bindings.binding_names.count
            for offset in 0..<count |structs, name, count|:
                index: usize = count - 1 - offset
                return true if structs.bindings.binding_names[index] == name
            return false




        # The return type of generic `base` instantiated at `type_argument`: its return
        # annotation resolved under that binding.
        def generic_return_type(base: sview, type_args: darray[ValueType]&, generics: mutable GenericTable&, structs: mutable StructTable&) -> ValueType can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic, Memory.Allocate:
                index: i64 = generic_index_of(generics, base)
                return unmodeled_type() if index < 0
                return generic_return_type_at(index.usize(), type_args, generics, structs)




        def generic_return_type_at(slot: usize, type_args: darray[ValueType]&, generics: mutable GenericTable&, structs: mutable StructTable&) -> ValueType can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                return unmodeled_type() if:
                    slot >= generics.names.count
                    slot >= generics.param_count.count
                    slot >= generics.decls.count
                    generics.param_count[slot] != type_args.count
                if generics.decls[slot] is Decl.Func(function_name, params, return_type_opt, body, effects, decorators, line):
                    # A missing return annotation is `void` — so a call to it names its result ""
                    # (LLVM rejects a named void instruction).
                    resolved: mutable ValueType = ValueType{kind: TypeKind.Void, bits: 0}
                    if return_type_opt is declared_return:
                        # The annotation belongs to the template's module; its
                        # unqualified types must not resolve in the caller's module.
                        saved_owner: sview = structs.visibility.current_owner
                        structs.visibility.current_owner <- generics.owners[slot] if slot < generics.owners.count else ""
                        bound: usize = push_type_bindings(generics, structs, slot, type_args)
                        resolved <- annotation_value_type(declared_return, structs)
                        pop_type_bindings(structs, bound)
                        structs.visibility.current_owner <- saved_owner
                    return resolved
                return unmodeled_type()





include "./codegen_env_signatures.elisa"
