# Stage1 backend — LLVM codegen (`module Backend`).
#
# The stage0 counterpart is compiler/src/backend/llvm_*.go (~54k lines of cgo). This is
# the growing port of that: it walks the stage1 AST and drives LLVM-C (see llvm_c.elisa).
#
# Sound SUBSET, mirroring how the frontend was ported: only firmly-modeled constructs
# emit. Every emitter returns a "declined" signal for anything it does not model, and
# `emit_module` turns ANY decline into a whole-module decline, so the driver reports an
# honest UNSUPPORTED instead of handing back a module that is quietly missing code.
# Coverage grows one construct at a time, each with a compile-and-run fixture asserting
# real behavior (an exit code), plus a differential against stage0 where the reference
# compiler can compile the same source.
#
# Modeled today: `def f(a: i64, …) -> i64` over signed i64 — int literals, idents,
# `+ - * / %`, unary `+`/`-`, comparisons, parens, locals (`x: i64 = …`), assignment,
# `if`/`else`, `while`, `return`, and direct calls to other modeled functions.

include "../parser/parser.elisa"
include "llvm_c.elisa"
include "c_header.elisa"
include "easm_model.elisa"
include "easm_verify_provenance.elisa"
include "easm_verify_memory.elisa"
include "easm_verify_function.elisa"
include "easm_parse.elisa"
using Ast

module Backend:
    private:
        # LLVM-C takes NUL-terminated `const char*`, but an `sview` is a (ptr, len) view
        # into the source buffer with no terminator — taking `&view[0]` would hand LLVM a
        # string that runs to the end of the FILE. Copy the bytes and terminate.
        # `storage` is caller-owned on purpose: the returned pointer aliases it, so it
        # must outlive the LLVM call that consumes the name.
        def sview_to_cstr(name: sview, storage: mutable darray[u8]&) -> cstr can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            for index in 0..<sview_len(name) |storage|:
                storage.push(sview_at(name, index))
            storage.push(0)
            return (&storage[0]).cast[cstr] can Unsafe.PointerCast


        # `-fnoalias` is an explicit opt-in in stage0 because an incorrect noalias
        # promise is a silent optimizer miscompile. The stage1 driver is itself a
        # native program, so mirror the CLI's process configuration through libc's
        # environment rather than changing the source-language ABI.
        def noalias_mutable_refs_enabled() -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            flag_storage: mutable darray[u8] = []
            flag_name: cstr = sview_to_cstr("ELISACORE_NOALIAS_MUTABLE_REFS", flag_storage)
            if getenv(flag_name) is real:
                return true
            return false


        # `-fbounds-check` is an opt-in debugging mode in stage0. Keep the switch in
        # the process environment so the self-hosted product and the stage0-seeded
        # driver use the same configuration path.
        def force_bounds_check_enabled() -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            flag_storage: mutable darray[u8] = []
            flag_name: cstr = sview_to_cstr("ELISACORE_FORCE_BOUNDS_CHECK", flag_storage)
            if getenv(flag_name) is real:
                return true
            return false


        # TEMP decline tracer (gated on ELISA_DBG_DECLINE): prints "<fn>: <tag>" when a
        # statement declines inside the named function, to locate self-host blockers.
        def dbg_decline_enabled() -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            flag_storage: mutable darray[u8] = []
            flag_name: cstr = sview_to_cstr("ELISA_DBG_DECLINE", flag_storage)
            if getenv(flag_name) is real:
                return true
            return false

        def dbg_stmt_kind(statement: Stmt) -> sview can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            if statement is Stmt.Block(_, _, _, _, _): return "Block"
            if statement is Stmt.VarDecl(_, _, _, _): return "VarDecl"
            if statement is Stmt.Assign(_, _, _, _): return "Assign"
            if statement is Stmt.Expr(_, _): return "Expr"
            if statement is Stmt.Return(_, _): return "Return"
            if statement is Stmt.If(_, _, _, _): return "If"
            if statement is Stmt.While(_, _, _): return "While"
            if statement is Stmt.For(_, _, _, _, _): return "For"
            if statement is Stmt.Match(_, _, _): return "Match"
            if statement is Stmt.Break(_, _): return "Break"
            if statement is Stmt.Continue(_, _): return "Continue"
            if statement is Stmt.Contract(_, _, _): return "Contract"
            # `Invalid` is a PARSER failure, not a backend gap: the statement never got
            # built, so the backend has nothing to emit and declining is correct. Naming it
            # separately keeps a frontend hole from being read as a missing emitter.
            if statement is Stmt.Invalid: return "Invalid(parse)"
            return "?Stmt"

        def dbg_push_sview(storage: mutable darray[u8]&, s: sview) -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            for index in 0..<sview_len(s) |storage|:
                storage.push(sview_at(s, index))
            return 0


        def dbg_stmt_line(statement: Stmt) -> u32 can[Abort.Panic]:
            if statement is Stmt.Block(_, _, _, _, bl): return bl
            if statement is Stmt.VarDecl(_, _, _, vl): return vl
            if statement is Stmt.Assign(_, _, _, al): return al
            if statement is Stmt.Expr(_, el): return el
            if statement is Stmt.Return(_, rl): return rl
            if statement is Stmt.If(_, _, _, il): return il
            if statement is Stmt.While(_, _, wl): return wl
            if statement is Stmt.For(_, _, _, _, fl): return fl
            if statement is Stmt.Match(_, _, ml): return ml
            return 0

        def dbg_push_int(storage: mutable darray[u8]&, value: u32) -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            if value == 0:
                storage.push(48)
                return 0
            digits: mutable darray[u8] = []
            remaining: mutable u32 = value
            while remaining > 0 |digits, remaining|:
                digits.push(48 + (remaining % 10).u8())
                remaining <- remaining / 10
            for rev in 0..<digits.count |storage, digits|:
                storage.push(digits[digits.count - 1 - rev])
            return 0

        def dbg_cond_fail(function: sview, condition: Expr) -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            0 return if function != "declare_or_get_abort" and function != "declare_or_get_named" and function != "tag_disjoint_darray_access"
            msg_storage: mutable darray[u8] = []
            _ = dbg_push_sview(msg_storage, "  COND.FAIL ")
            if condition is Expr.Binary(cf_left, cf_op, cf_right, cf_line):
                _ = dbg_push_sview(msg_storage, "Binary @")
                _ = dbg_push_int(msg_storage, cf_line)
            elif condition is Expr.Call(cf_callee, cf_args, cf_names, cf_cl):
                _ = dbg_push_sview(msg_storage, "Call @")
                _ = dbg_push_int(msg_storage, cf_cl)
            elif condition is Expr.Unary(cf_uop, cf_uoperand, cf_ul):
                _ = dbg_push_sview(msg_storage, "Unary @")
                _ = dbg_push_int(msg_storage, cf_ul)
            elif condition is Expr.Ident(cf_name, cf_il):
                _ = dbg_push_sview(msg_storage, "Ident ")
                _ = dbg_push_sview(msg_storage, cf_name)
            else:
                _ = dbg_push_sview(msg_storage, "other")
            msg_storage.push(0)
            return puts((&msg_storage[0]).cast[cstr] can Unsafe.PointerCast)

        def dbg_decline(function: sview, statement: Stmt) -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            msg_storage: mutable darray[u8] = []
            _ = dbg_push_sview(msg_storage, function)
            _ = dbg_push_sview(msg_storage, ": DECLINE ")
            _ = dbg_push_sview(msg_storage, dbg_stmt_kind(statement))
            _ = dbg_push_sview(msg_storage, " @line ")
            _ = dbg_push_int(msg_storage, dbg_stmt_line(statement))
            msg_storage.push(0)
            return puts((&msg_storage[0]).cast[cstr] can Unsafe.PointerCast)

        # Decode a string literal's source escapes into `storage`.
        #
        # The LEXER deliberately leaves escapes undecoded (tokens.elisa: the token's interior is
        # "escapes and `{EXPR}` spans undecoded"), so the BACKEND owns this. stage1 did not do
        # it at all, and every literal reached LLVM with its backslashes intact: a diagnostic
        # written `f"… \"{name}\" …"` rendered as `\"__rg_state\"` where stage0 renders
        # `"__rg_state"`.
        #
        # The set is stage0's, verified against it byte by byte: \n \t \r \0, and \\ \" \'
        # which stand for themselves. An UNRECOGNISED escape is left exactly as written (both
        # bytes) and clears `all_known`, so a caller that must not guess — the match-pattern
        # path — can still decline rather than risk a mis-encoded compare.
        def decode_string_escapes(text: sview, storage: mutable darray[u8]&, all_known: mutable bool&) -> void can[Abort.Panic, Memory.Allocate]:
            all_known <- true
            length: usize = sview_len(text)
            index: mutable usize = 0
            while index < length |index, storage, all_known|:
                byte: u8 = sview_at(text, index)
                # A trailing lone backslash is not an escape; keep it verbatim.
                if byte != 92 or index + 1.usize() >= length:
                    storage.push(byte)
                    index <- index + 1.usize()
                    continue
                next_byte: u8 = sview_at(text, index + 1.usize())
                known: bool = next_byte == 110 or next_byte == 116 or next_byte == 114 or next_byte == 48 or next_byte == 92 or next_byte == 34 or next_byte == 39
                if not known:
                    all_known <- false
                    storage.push(byte)
                    index <- index + 1.usize()
                    continue
                # `\\`, `\"` and `\'` stand for themselves; the rest are control codes.
                decoded: u8 = when next_byte:
                    110 -> 10
                    116 -> 9
                    114 -> 13
                    48 -> 0
                    _ -> next_byte
                storage.push(decoded)
                index <- index + 2.usize()


        # A literal's decoded bytes as a NUL-terminated cstr. The transient-buffer contract is
        # the same as sview_to_cstr's: LLVM copies the name/contents, so `storage` may die.
        def decoded_literal_cstr(text: sview, storage: mutable darray[u8]&) -> cstr can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate:
                escapes_known: mutable bool = true
                decode_string_escapes(text, storage, escapes_known)
                storage.push(0)
                return (&storage[0]).cast[cstr] can Unsafe.PointerCast


            # The INNER bytes of a string-literal pattern span, which arrives quote-INCLUSIVE
            # (`"yes"`) because a pattern literal keeps its raw source text. Strips the surrounding
            # double quotes and returns a NUL-terminated cstr of the content. Declines (null) on a
            # backslash: escape decoding would have to match stage0's exactly, so a `"a\n"` pattern
            # is left to decline rather than risk a mis-encoded compare.
        def string_pattern_content_cstr(text: sview, storage: mutable darray[u8]&) -> cstr? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate:
                length: usize = sview_len(text)
                # An EMPTY span is the content of a `""` pattern — a legitimate pattern that matches
                # only the empty string, not a decoding failure. Rejecting it dropped every function
                # with a `match s: "": …` arm (semantic_api_message's diagnostic builders test
                # `diagnostic.actual` against "" throughout). Falling through is safe: `quoted` needs
                # length >= 2 so there is no underflow, the copy loop runs zero times, and the result
                # is the NUL-only cstr, which ctx_string_views_eq matches against an empty sview
                # exactly. A backslash still declines below.
                # The span may or may not include the surrounding double quotes depending on how
                # the pattern lexer captured it; strip a matched pair when present.
                quoted: bool = length >= 2 and sview_at(text, 0) == 34 and sview_at(text, length - 1) == 34
                start: usize = 1 if quoted else 0
                stop: usize = length - 1 if quoted else length
                # A backslash used to decline outright. It no longer has to: decode_string_escapes
                # is the SAME decoder the literal-emission path uses, so a `"a\nb"` pattern is
                # compared against exactly the bytes an `"a\nb"` value carries. An escape the
                # decoder does not recognise still declines — matching against a guess would be a
                # silent wrong answer, and declining is loud.
                inner: sview = text[start:stop]
                escapes_known: mutable bool = true
                decode_string_escapes(inner, storage, escapes_known)
                null return if not escapes_known
                storage.push(0)
                return (&storage[0]).cast[cstr] can Unsafe.PointerCast


            # The i1 "this sview equals that string-literal pattern" test, or null when the
            # literal cannot be decoded (see string_pattern_content_cstr). Shared by the plain
            # literal arm and the `"a" | "b"` alternation arm, which ORs several of these — the
            # comparison is a pure call, so emitting them all in one block is sound.
        def sview_literal_hit(pattern_text: sview, scrutinee_raw: LLVMValueRef, scrutinee_type: ValueType, structs: mutable StructTable&, runtime: Runtime&, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            pattern_storage: mutable darray[u8] = []
            if string_pattern_content_cstr(pattern_text, pattern_storage) is pattern_cstr:
                pattern_global: LLVMValueRef = LLVMBuildGlobalStringPtr(builder, pattern_cstr, "svpat")
                literal_type: LLVMTypeRef = llvm_type_of(scrutinee_type, structs, ctx)
                literal_undef: LLVMValueRef = LLVMGetUndef(literal_type)
                literal_with_ptr: LLVMValueRef = LLVMBuildInsertValue(builder, literal_undef, pattern_global, 0, "svpat.ptr")
                literal_len: LLVMValueRef = LLVMConstInt(LLVMInt64TypeInContext(ctx), (pattern_storage.count - 1).u64(), 0)
                literal_value: LLVMValueRef = LLVMBuildInsertValue(builder, literal_with_ptr, literal_len, 1, "svpat.len")
                eq_args: mutable darray[LLVMValueRef] = [scrutinee_raw, literal_value]
                eq_pointer: void& = (&eq_args[0]).cast[void&] can Unsafe.PointerCast
                eq_code: LLVMValueRef = LLVMBuildCall2(builder, runtime.sview_eq_type, runtime.sview_eq, eq_pointer, 2, "match.sview.eq")
                return LLVMBuildICmp(builder, 33, eq_code, LLVMConstInt(LLVMInt64TypeInContext(ctx), 0, 0), "match.sview.hit")
            return null


        # The LLVM SYMBOL name for `owner::name`: stage0 emits `module M: def get()` as
        # `define i64 @M.get` — DOT-separated, even though the call spelling is `M::get()`.
        # An empty owner is a top-level function and keeps its bare name.
        def qualified_name_cstr(owner: sview, name: sview, storage: mutable darray[u8]&) -> cstr can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                sview_to_cstr(name, storage) return if sview_len(owner) == 0
                for index in 0..<sview_len(owner) |storage|:
                    storage.push(sview_at(owner, index))
                storage.push(46)
                for index in 0..<sview_len(name) |storage|:
                    storage.push(sview_at(name, index))
                storage.push(0)
                return (&storage[0]).cast[cstr]


            # A modeled value's type. `bits` is the integer width; `Bool` is i1 (LLVM's
            # natural boolean) and carries no width of its own.
            #
            # Signedness is not cosmetic: stage0 lowers `u8 200 / 3` to `udiv` (66) and
            # `u8 200 >> 1` to `lshr` (100). Reading those as signed gives -56 and 228 — so a
            # backend that ignores signedness silently miscompiles unsigned arithmetic.
        const enum TypeKind of u8:
            Unmodeled
            Signed
            Unsigned
            Bool
            Float
            # `void` — legal ONLY as a return type. It has no values, so nothing can be a
            # `void` local, parameter, or operand; every other position rejects it because
            # `unmodeled_type()` is what those paths test for and Void is not that.
            Void
            # A user struct. `bits` is its index in the StructTable — a ValueType must stay
            # POD (an sview name would be fine, but an index also gives O(1) field lookup).
            Struct
            # A fixed array `T[N]`. `bits` indexes the StructTable's ARRAY side-pool
            # (`array_elements` / `array_extents`) — same reason as Struct: ValueType is
            # POD, so a nested element type cannot live inline.
            Array
            # A `packed enum`'s HANDLE. Same `{i32, [N x i64]}` shape as a payload enum, but
            # the value is a row in an AoS store rather than inline data: the tag and payload
            # are read back through ctx_packed_store_* rather than by extractvalue/GEP.
            # `bits` indexes the PACKED side-pool.
            PackedEnum
            # `Node.Store[Local]` — `{ptr arena, i64 row_bytes, ptr state}`. `bits` indexes
            # the PACKED side-pool of the enum it stores.
            PackedStore
            # `Arena` — the runtime's region carrier, `{ptr, ptr, i64, i64}`, passed BY
            # VALUE (stage0: `define i64 @build(%Arena %0)` and `%r1 = load %Arena, ptr %r`
            # at the call site). Note the asymmetry: `Arena` is legal as a PARAMETER type
            # but rejected as a region ANNOTATION (`-> darray[i64] @owner` is "internal
            # runtime carrier type ... not supported in user-facing code").
            Arena
            # A PAYLOAD-carrying enum (`enum Shape: Circle(r: i64)`). In LLVM a TAGGED UNION
            # `{ i32, [N x i64] }`: field 0 is the variant ORDINAL, field 1 is payload
            # storage sized to the largest variant (stage0's `%Shape = type { i32, [1 x
            # i64] }`, read from its IR). NOT the AoS packed store -- that is `packed enum`,
            # a different subsystem. `bits` indexes the PAYLOAD-ENUM side-pool.
            PayloadEnum
            # `cstr` — a NUL-terminated string constant. In LLVM just a `ptr`: stage0
            # lowers `s: cstr = "hi"` to `@str = private unnamed_addr constant [3 x i8]
            # c"hi\00"` plus `store ptr @str`. Carries no length, so `.count`, indexing and
            # comparison are NOT modeled (they need the runtime) and decline.
            CStr
            # A reference `T&` / `mutable T&`. `bits` indexes the REF side-pool
            # (`ref_targets`). In LLVM it is just a `ptr` — stage0 lowers
            # `def bump(n: mutable i64&)` to `define void @bump(ptr)` and `bump(x)` to
            # `call void @bump(ptr %x)`. Mutability is a FRONTEND concern (it already
            # rejects writes through a `T&`), so the backend models only the referent.
            Ref
            # An optional `T?`. `bits` indexes the OPTIONAL side-pool (`optional_targets`).
            # Represented exactly as stage0 does — `{i1 has_value, T value}` (read from its
            # `-emit llvm`: `%Optional__i64 = type { i1, i64 }`).
            Optional
            # A value-carrying `T error[E]`. `bits` indexes the ERROR-UNION side-pools;
            # LLVM uses stage0's `{i32 error_code, ptr payload}` descriptor.
            ErrorUnion
            # A `darray[T]`. `bits` indexes the DARRAY side-pool (`darray_elements`).
            # Represented exactly as stage0 does — `{ptr items, i64 count, i64 capacity}`,
            # backed by an Arena — because both link the SAME runtime, so the layout is
            # dictated, not chosen.
            DArray
            # A `view[T]` — the runtime's `DynArrayView` fat pointer `{data, len}`. `bits`
            # indexes the VIEW side-pool (`view_elements`), carrying the phantom element T
            # so a generic call like `arena_da_fill(view, …)` can INFER T from the argument.
            # Lowers to the one `DynArrayView` struct regardless of T (like darray).
            View
            # `sview` — a string VIEW, stage0's `%StringView = type { ptr, i64 }` (a byte
            # pointer plus a length). Distinct from `cstr` (bare `ptr`, NUL-terminated) and
            # from `view[T]` (DynArrayView). A literal `s: sview = "hi"` is the aggregate
            # `{ptr @str, i64 2}`; equality goes through `ctx_string_views_eq` BY VALUE.
            SView
            # `fn(A, …) -> R` — a first-class function value. Represented as stage0 does: a
            # low-bit-TAGGED `ptr`. Bit0 clear = a raw function pointer (`@f`), called directly;
            # bit0 set = points (after `& ~1`) at an `%ElisaCoreLambdaClosure = {ptr code, ptr
            # env}`, called `code(env, args…)`. The result type at a call site comes from the
            # EXPECTED type (a `return f(x)` / `y: R = f(x)` supplies it), so `bits` is unused.
            Fn
            # `GuestVAddr[L]` / `HostPtr[T]` address-space carriers (docs/107). ABI storage is
            # `i64`/`uintptr`; `bits` indexes `guest_layouts` with the layout/pointee name so
            # overlay accessors can resolve field offsets. HostPtr uses the same kind because
            # both are raw address integers at the LLVM boundary.
            GuestCarrier
            # A CONST-GENERIC value argument (`InlineVec[T, N: usize]` — the `N`). NOT a real
            # runtime type: it is a phantom carried in a generic's type-arg tuple so a `usize`
            # value like `4` threads through instantiation. `bits` holds the VALUE itself (not a
            # side-pool index). It only ever appears as a type-arg binding — `fold_const_atom`
            # reads it to resolve a `T[N]` extent, and `mangled_name_multi_into` encodes its
            # value so `InlineVec[i64, 4]` and `[i64, 8]` mangle differently. It must never reach
            # llvm_type_of as a real value (no field/local/param is ConstUsize-typed).
            ConstUsize


        struct ValueType:
            kind: TypeKind
            bits: u32

        # The `{value, overflow}` result returned by LLVM's checked integer intrinsics.
        # Stage0 uses these for every allocation-size multiplication and for darray capacity
        # growth; keeping the pair explicit lets the stage1 emitter choose between trapping
        # and the safe-capacity fallback without silently dropping the flag.
        struct OverflowResult:
            value: LLVMValueRef
            overflow: LLVMValueRef


        def unmodeled_type() -> ValueType:
            return ValueType{kind: TypeKind.Unmodeled, bits: 0}


        def is_integer_type(value_type: ValueType) -> bool:
            return value_type.kind == TypeKind.Signed or value_type.kind == TypeKind.Unsigned


        # The i1 test for a `Pattern.Range` arm (`lo..<hi` / `lo..=hi`) over an INTEGER
        # scrutinee: `scrutinee >= lo AND scrutinee </<= hi`. Signed/unsigned drives the
        # predicate (a u8 range must compare with U* predicates). Returns null when either
        # bound is not an integer literal (e.g. a char-literal range) so the caller declines.
        # LLVM IntPredicate: UGE=35 ULT=36 ULE=37 SGE=39 SLT=40 SLE=41.
        def emit_range_test(scrutinee: LLVMValueRef, scrutinee_type: ValueType, lo_text: sview, hi_text: sview, inclusive: bool, compare_type: LLVMTypeRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic]:
            lo_value: mutable i64 = 0
            hi_value: mutable i64 = 0
            null return if not parse_pattern_scalar(lo_text, lo_value)
            null return if not parse_pattern_scalar(hi_text, hi_value)
            unsigned: bool = scrutinee_type.kind == TypeKind.Unsigned
            lo_pred: u32 = 35 if unsigned else 39
            hi_pred: mutable u32 = 40
            hi_pred <- 41 if inclusive
            if unsigned:
                hi_pred <- 37 if inclusive else 36
            lo_hit: LLVMValueRef = LLVMBuildICmp(builder, lo_pred, scrutinee, LLVMConstInt(compare_type, lo_value.u64(), 1), "range.lo")
            hi_hit: LLVMValueRef = LLVMBuildICmp(builder, hi_pred, scrutinee, LLVMConstInt(compare_type, hi_value.u64(), 1), "range.hi")
            return LLVMBuildAnd(builder, lo_hit, hi_hit, "range.in")


        # The i1 test for ONE simple, binding-free arm pattern against an already-lowered
        # `scrutinee` (a raw integer, or a payload-enum's extracted i32 tag when `penum`).
        # Handles integer/const-enum-ordinal literals, field-less variant paths, and integer
        # ranges — the sub-patterns an OR-pattern (`0 | 2 | 4`, `E.A | E.B`) is built from.
        # Returns null for anything with a binding or payload (an OR alternative cannot bind).
        def emit_simple_pattern_hit(pattern: Pattern, scrutinee: LLVMValueRef, scrutinee_type: ValueType, penum: bool, compare_type: LLVMTypeRef, structs: mutable StructTable&, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic]:
            can Abort.Panic:
                if pattern is Pattern.Literal(literal_text):
                    literal_value: mutable i64 = 0
                    null return if not parse_pattern_scalar(literal_text, literal_value)
                    return LLVMBuildICmp(builder, 32, scrutinee, LLVMConstInt(compare_type, literal_value.u64(), 1), "or.cmp")
                if pattern is Pattern.Variant(variant_path, variant_fields):
                    null return if variant_fields.count != 0
                    ordinal: mutable i64 = penum_variant_index_of_path(variant_path, structs) if penum else ordinal_of_dotted_path(variant_path, structs)
                    null return if ordinal < 0
                    return LLVMBuildICmp(builder, 32, scrutinee, LLVMConstInt(compare_type, ordinal.u64(), 1), "or.cmp")
                if pattern is Pattern.Range(range_lo, range_hi, range_inclusive):
                    null return if penum
                    return emit_range_test(scrutinee, scrutinee_type, range_lo, range_hi, range_inclusive, compare_type, ctx, builder)
                return null


            # The combined i1 test for an OR-pattern's option list: hit if ANY option hits.
            # Returns null if any option is not a simple binding-free pattern.
        def emit_or_pattern_hit(options: darray[Pattern], scrutinee: LLVMValueRef, scrutinee_type: ValueType, penum: bool, compare_type: LLVMTypeRef, structs: mutable StructTable&, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic:
                null return if options.count == 0
                combined: mutable LLVMValueRef = zeroed
                have: mutable bool = false
                failed: mutable bool = false
                for option in options |combined, have, failed, scrutinee, scrutinee_type, penum, compare_type, structs, ctx, builder|:
                    continue if failed
                    if emit_simple_pattern_hit(option, scrutinee, scrutinee_type, penum, compare_type, structs, ctx, builder) is option_hit:
                        combined <- option_hit if not have
                        combined <- LLVMBuildOr(builder, combined, option_hit, "or.any") if have
                        have <- true
                    else:
                        failed <- true
                null return if failed or not have
                return combined


            # --- multi-column `when` (docs/125 §4) -------------------------------------------
            #
            # `when a, b:` is a DECISION TABLE. The parser desugars it (parser_stmt_when.elisa)
            # exactly as stage0 does — an `Expr.Tuple` scrutinee whose arms carry `Pattern.Tuple`
            # rows — and nothing downstream may change that shape, because `-emit ast` is held to
            # byte parity with stage0. So the columns are lowered HERE, in the backend.
            #
            # A row hits when EVERY column hits: the table is a conjunction per row, tested in
            # source order, which is the same first-wins chain the scalar emitter already builds.
            # There is no tuple VALUE anywhere in the lowering — each scrutinee column is emitted
            # once as an ordinary scalar and reused across rows, so no tuple ABI is involved.
            # (Elisa has no tuple expressions in the surface language; `Expr.Tuple` exists only
            # as this desugar and the multi-value forms.)

            # One column's i1 test. `_` is "no constraint" and yields a constant true rather than
            # a comparison, so an all-wildcard row folds to `true` and the optimizer drops the
            # branch. Everything else reuses the scalar arm machinery — a column's grammar is a
            # subset of an arm's.
        def emit_when_column_hit(column: Pattern, value: LLVMValueRef, value_type: ValueType, compare_type: LLVMTypeRef, structs: mutable StructTable&, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic, Memory.Allocate:
                LLVMConstInt(LLVMInt1TypeInContext(ctx), 1, 0) return if column is Pattern.Wildcard
                # `true` / `false` columns. parse_pattern_scalar reads integer and CHAR text; the
                # boolean keywords reach it as bare identifiers and would be read as a char code,
                # so they are resolved here before it ever sees them.
                if column is Pattern.Literal(column_literal):
                    if column_literal == "true" or column_literal == "false":
                        column_bool: u64 = 1.u64() if column_literal == "true" else 0.u64()
                        return LLVMBuildICmp(builder, 32, value, LLVMConstInt(compare_type, column_bool, 0), "when.col.bool")
                if column is Pattern.Or(column_options):
                    return emit_or_pattern_hit(column_options, value, value_type, false, compare_type, structs, ctx, builder)
                return emit_simple_pattern_hit(column, value, value_type, false, compare_type, structs, ctx, builder)


            # The whole row's i1: AND across its columns. Null when any column is a shape the
            # scalar machinery cannot test (a binding, a payload variant), so the caller declines
            # the enclosing body rather than emitting a row that silently never hits.
        def emit_when_row_hit(columns: darray[Pattern]&, values: darray[LLVMValueRef]&, value_types: darray[ValueType]&, compare_types: darray[LLVMTypeRef]&, structs: mutable StructTable&, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate]:
            null return if columns.count != values.count
            combined: mutable LLVMValueRef = LLVMConstInt(LLVMInt1TypeInContext(ctx), 1, 0)
            row_failed: mutable bool = false
            for column_index in 0..<columns.count |combined, row_failed, columns, values, value_types, compare_types, structs, ctx, builder|:
                continue if row_failed
                if emit_when_column_hit(columns[column_index], values[column_index], value_types[column_index], compare_types[column_index], structs, ctx, builder) is column_hit:
                    combined <- LLVMBuildAnd(builder, combined, column_hit, "when.row")
                else:
                    row_failed <- true
            null return if row_failed
            return combined


        # A `when`-desugared row: `Pattern.Tuple` columns, or the trailing `_` default the
        # parser emits last. Anything else means this is not a decision table.
        def when_row_columns(pattern: Pattern, out_columns: mutable darray[Pattern]&) -> bool can[Abort.Panic, Memory.Allocate]:
            if pattern is Pattern.Tuple(tuple_columns):
                out_columns.extend(tuple_columns)
                return true
            return false


        def is_numeric_type(value_type: ValueType) -> bool:
            return is_integer_type(value_type) or value_type.kind == TypeKind.Float


        # Whether the type lowers to an LLVM `ptr` — a reference or a cstr. Used to keep a
        # `.cast[T]` reinterpret to the pointer<->pointer no-op the std alloc helpers need.
        def type_is_pointer(value_type: ValueType) -> bool:
            return value_type.kind == TypeKind.Ref or value_type.kind == TypeKind.CStr


        # The named scalar types the backend models. Anything else (f32/f64, containers,
        # user types) yields Unmodeled and DECLINES rather than being guessed at.
        #
        # `int` is stage0's signed 64-bit default; `usize` is pointer-width (64 here — the
        # port targets arm64/x86-64, and a 32-bit target would need this to follow the
        # target triple).
        # The `is TARGET as NAME` alias recorded on `line`, or "" when there is none.
        def is_variant_alias_at(line: i64, structs: StructTable&) -> sview can[Abort.Panic]:
            paired: usize = structs.is_variant_alias_lines.count if structs.is_variant_alias_lines.count < structs.is_variant_alias_names.count else structs.is_variant_alias_names.count
            for probe in 0..<paired:
                structs.is_variant_alias_names[probe] return if structs.is_variant_alias_lines[probe] == line
            return ""


        # The `derive state:` predicate for (owner, state), or -1 when there is none.
        def derived_state_rule_index(structs: StructTable&, owner: sview, state: sview) -> i64 can[Abort.Panic]:
            paired: usize = structs.derived_state_owners.count if structs.derived_state_owners.count < structs.derived_state_names.count else structs.derived_state_names.count
            for probe in 0..<paired:
                continue if structs.derived_state_owners[probe] != owner
                probe.i64() return if structs.derived_state_names[probe] == state
            return -1


        # The explicit `submit[pool]` selector recorded on `line`, or "".
        def submit_pool_name_at(line: i64, structs: StructTable&) -> sview can[Abort.Panic]:
            paired: usize = structs.submit_pool_lines.count if structs.submit_pool_lines.count < structs.submit_pool_names.count else structs.submit_pool_names.count
            for probe in 0..<paired:
                structs.submit_pool_names[probe] return if structs.submit_pool_lines[probe] == line
            return ""


        # The extra binder of a multi-binder query on `line`, or "".
        def query_extra_binder_at(line: i64, structs: StructTable&) -> sview can[Abort.Panic]:
            paired: usize = structs.query_extra_binder_lines.count if structs.query_extra_binder_lines.count < structs.query_extra_binder_names.count else structs.query_extra_binder_names.count
            for probe in 0..<paired:
                structs.query_extra_binder_names[probe] return if structs.query_extra_binder_lines[probe] == line
            return ""


        # The receiver of an `X.enumerate()` iterable, or Absent when the iterable is not one.
        def query_enumerate_receiver(iterable: Expr) -> Expr can[Abort.Panic]:
            if iterable is Expr.Call(qe_callee, qe_args, qe_arg_names, qe_call_line):
                if qe_callee is Expr.Field(qe_source, qe_method, qe_method_line):
                    qe_source return if qe_method == "enumerate" and qe_args.count == 0
            return (Expr.Absent)


        # The brace-pattern FIELD name at `position` for the `for` header on `line`, or "".
        # A `for` opens a block, so at most one brace header sits on any one line.
        def for_brace_field_at(line: i64, position: usize, structs: StructTable&) -> sview can[Abort.Panic]:
            paired: usize = structs.for_brace_field_lines.count if structs.for_brace_field_lines.count < structs.for_brace_field_names.count else structs.for_brace_field_names.count
            seen: mutable usize = 0
            for probe in 0..<paired |seen, line, position, structs|:
                if structs.for_brace_field_lines[probe] == line:
                    structs.for_brace_field_names[probe] return if seen == position
                    seen <- seen + 1
            return ""


        def scalar_type_of_name(name: sview) -> ValueType:
            ValueType{kind: TypeKind.CStr, bits: 0} return if name == "cstr"
            ValueType{kind: TypeKind.SView, bits: 0} return if name == "sview"
            ValueType{kind: TypeKind.Signed, bits: 8} return if name == "i8"
            ValueType{kind: TypeKind.Signed, bits: 16} return if name == "i16"
            ValueType{kind: TypeKind.Signed, bits: 32} return if name == "i32"
            # `isize` is the signed pointer-width counterpart of `usize` and is used by
            # the portable runtime's sysconf/ callback seams.
            ValueType{kind: TypeKind.Signed, bits: 64} return if name == "i64" or name == "int" or name == "isize"
            ValueType{kind: TypeKind.Unsigned, bits: 8} return if name == "u8"
            ValueType{kind: TypeKind.Unsigned, bits: 16} return if name == "u16"
            ValueType{kind: TypeKind.Unsigned, bits: 32} return if name == "u32"
            ValueType{kind: TypeKind.Unsigned, bits: 64} return if name == "u64" or name == "usize" or name == "uintptr"
            ValueType{kind: TypeKind.Bool, bits: 1} return if name == "bool"
            # stage0 lowers `char` to i64 (`define i64 @f(i64)`, `icmp eq i64`) — a full-width
            # signed scalar, not a byte. Model it identically so char arithmetic/compares work.
            ValueType{kind: TypeKind.Signed, bits: 64} return if name == "char"
            ValueType{kind: TypeKind.Float, bits: 32} return if name == "f32"
            ValueType{kind: TypeKind.Float, bits: 64} return if name == "f64"
            ValueType{kind: TypeKind.Void, bits: 0} return if name == "void"
            return unmodeled_type()


        # LLVM-C exposes opaque handle typedefs as pointer-sized values. They are declared
        # as bare extern names in llvm_c.elisa, so resolve them explicitly while registering
        # aggregate fields as well as function parameters; waiting for the extern declaration
        # pass leaves fields such as `Scope.slots: darray[LLVMValueRef]` unmodeled.
        def llvm_opaque_handle_name(name: sview) -> bool:
            return name == "LLVMContextRef" or name == "LLVMModuleRef" or name == "LLVMTypeRef" or name == "LLVMValueRef" or name == "LLVMBuilderRef" or name == "LLVMBasicBlockRef" or name == "LLVMTargetRef" or name == "LLVMTargetMachineRef" or name == "LLVMTargetDataRef" or name == "LLVMMetadataRef" or name == "LLVMAttributeRef" or name == "LLVMDIBuilderRef" or name == "LLVMDbgRecordRef" or name == "LLVMPassBuilderOptionsRef"


        # What `name` is bound to in the CURRENT instantiation, or Unmodeled if it is not a
        # type parameter (i.e. it is an ordinary type name).
        def bound_type_of(structs: mutable StructTable&, name: sview) -> ValueType can[Abort.Panic]:
            # Scan most-recent-first so an inner instantiation's binding shadows an outer
            # one that reuses the same parameter name (`DictBucket[K, T]` nested inside
            # `DynDict[K, T]`). For a single instantiation there are no duplicates, so this
            # is identical to a forward scan.
            count: usize = structs.binding_names.count
            for offset in 0..<count |structs, name, count|:
                index: usize = count - 1 - offset
                copied_type(structs.binding_types[index]) return if structs.binding_names[index] == name
            return unmodeled_type()


        # The return type of generic `base` instantiated at `type_argument`: its return
        # annotation resolved under that binding.
        def generic_return_type(base: sview, type_args: darray[ValueType]&, generics: mutable GenericTable&, structs: mutable StructTable&) -> ValueType can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic, Memory.Allocate:
                index: i64 = generic_index_of(generics, base)
                unmodeled_type() return if index < 0
                return generic_return_type_at(index.usize(), type_args, generics, structs)


        def generic_return_type_at(slot: usize, type_args: darray[ValueType]&, generics: mutable GenericTable&, structs: mutable StructTable&) -> ValueType can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                unmodeled_type() return if slot >= generics.names.count
                unmodeled_type() return if generics.param_count[slot] != type_args.count
                if generics.decls[slot] is Decl.Func(function_name, params, return_type_opt, body, effects, decorators, line):
                    # A missing return annotation is `void` — so a call to it names its result ""
                    # (LLVM rejects a named void instruction).
                    resolved: mutable ValueType = ValueType{kind: TypeKind.Void, bits: 0}
                    if return_type_opt is declared_return:
                        bound: usize = push_type_bindings(generics, structs, slot, type_args)
                        resolved <- annotation_value_type(declared_return, structs)
                        pop_type_bindings(structs, bound)
                    return resolved
                return unmodeled_type()


            # The type an annotation denotes. Only a bare scalar name is modeled.
            #
            # `mutable` is a QUALIFIER on the annotation, not part of the type: `x: mutable
            # i64` denotes i64 and just says the binding can be reassigned. It rides as a
            # Unary node wrapping the type, so it is unwrapped here — mutability is the
            # frontend's business (it already rejects `x <- 1` on an immutable local), and the
            # backend only needs the underlying type.
            # Record every `fn(…)->R` type's RETURN-type head (parser side-table __lambda_return,
            # keyed by the fn-type's line) so a Fn ValueType can carry its result type.
        def register_fn_signatures(file: Ast::File&, structs: mutable StructTable&) -> void can[Abort.Panic, Memory.Allocate]:
            for annotation in file.enum_annotations |structs|:
                if annotation.owner == "__lambda_return":
                    structs.fn_return_lines.push(annotation.line)
                    structs.fn_return_heads.push(annotation.name)
                if annotation.owner == "__lambda_param":
                    structs.fn_param_lines.push(annotation.line)
                    structs.fn_param_heads.push(annotation.name)
                # The QUERY keyword (`count`/`sum`/`any`/…), keyed by the query head's line.
                # Prefixed so it cannot be confused with a fn-type return head sharing a line.
                # The BODY slot of a leading-keyword query holds the GUARD of a
                # `where PATTERN: GUARD` filter, not a projection. Recorded by line so the
                # collection emitter does not push the guard as the collected ELEMENT.
                structs.query_guard_lines <- structs.query_guard_lines.push(annotation.line) if annotation.owner == "__query_guard"
                # A PROJECTION query whose guard the parser could not represent. Recorded so
                # the emitter declines rather than silently ignoring the guard.
                structs.query_dropped_guard_lines <- structs.query_dropped_guard_lines.push(annotation.line) if annotation.owner == "__query_guard_dropped"
                if annotation.name == "__region_use":
                    structs.region_use_lines <- structs.region_use_lines.push(annotation.line)
                    structs.region_use_names <- structs.region_use_names.push(annotation.owner)
                if annotation.owner == "__query":
                    structs.fn_return_lines.push(annotation.line)
                    structs.fn_return_heads.push(annotation.name)
                    # Also into the binder-keyed pools. The line-keyed row above stays for the
                    # consumers that have no binder to offer.
                    structs.query_lines.push(annotation.line)
                    structs.query_heads.push(annotation.name)
                if annotation.owner == "__query_binder_of":
                    structs.query_binders.push(annotation.name)
                # `using Mod as M` — the alias and its target, line-paired by the parser.
                # Recorded as parallel pools so a qualified call through the alias can be
                # rewritten to the real module before the FnTable lookup.
                if annotation.name == "__using_alias":
                    structs.module_alias_names.push(annotation.owner)
                if annotation.name == "__using_alias_target":
                    structs.module_alias_targets.push(annotation.owner)
                if annotation.owner == "__submit":
                    # Reuse the line-keyed return side table as a compact marker; submit
                    # lines never collide with a function-type expression's line.
                    structs.fn_return_lines.push(annotation.line)
                    structs.fn_return_heads.push("__submit")
                if annotation.owner == "__await":
                    structs.fn_return_lines.push(annotation.line)
                    structs.fn_return_heads.push("__await")
                if annotation.owner == "__wait_all":
                    structs.fn_return_lines.push(annotation.line)
                    structs.fn_return_heads.push("__wait_all")
                if annotation.owner == "__clone_error_union":
                    structs.clone_error_lines.push(annotation.line)
                    structs.clone_error_families.push(annotation.name)
                if annotation.owner == "__local_error_union":
                    structs.local_error_lines.push(annotation.line)
                    structs.local_error_families.push(annotation.name)
                if annotation.owner == "__field_error_union":
                    structs.field_error_lines.push(annotation.line)
                    structs.field_error_families.push(annotation.name)
                if annotation.owner == "__param_error_union":
                    structs.param_error_lines.push(annotation.line)
                    structs.param_error_families.push(annotation.name)
                if annotation.owner == "__tuple_label":
                    structs.tuple_label_lines.push(annotation.line)
                    structs.tuple_label_names.push(annotation.name)
                # Guest-overlay field offsets: `__overlay_field` carries the byte offset in
                # `line`; width is filled after struct bodies are registered (see
                # finalize_overlay_field_widths). Layout association uses `__overlay_struct`
                # markers in source order for fields declared under that layout.
                if annotation.owner == "__overlay_field":
                    structs.overlay_field_names.push(annotation.name)
                    structs.overlay_field_offsets.push(annotation.line)
                    structs.overlay_field_widths.push(0)
                    structs.overlay_field_layouts.push(sview("", 0, 0))
            # Associate overlay fields with their layout struct: the parser emits
            # `__overlay_struct` for the layout, then field annotations for its members.
            # Walk annotations in order and bind each field to the most recent overlay struct.
            current_overlay: mutable sview = sview("", 0, 0)
            field_cursor: mutable usize = 0
            for annotation in file.enum_annotations |structs, current_overlay, field_cursor|:
                if annotation.owner == "__overlay_struct":
                    current_overlay <- annotation.name
                elif annotation.owner == "__overlay_field" and field_cursor < structs.overlay_field_names.count:
                    structs.overlay_field_layouts[field_cursor] <- current_overlay
                    field_cursor <- field_cursor + 1
            structs.fn_type_param_lines <- file.fn_type_param_lines
            structs.fn_type_return_lines <- file.fn_type_return_lines
            structs.fn_type_return_exprs <- file.fn_type_return_exprs
            structs.fn_type_param_exprs <- file.fn_type_param_exprs

        # The recorded return-type head for the fn-type declared at `line`, or "".
        # A query's head keyword, disambiguated by its BINDER. `fn_return_head_at` is keyed by
        # line alone and answers with the first row, so two queries on one line both read the
        # first one's keyword — `(count x in xs where …) * 10 + (sum y in xs where …)` computed
        # the sum as a count. Falls back to the line-only answer when no binder matches, which
        # is the previous behaviour and the right one for a single query on the line.
        # Whether the query on `line` carries a `where PATTERN: GUARD` filter -- i.e. its
        # node's BODY slot holds the guard rather than a projection.
        # Whether the query on `line` carries a guard the AST cannot represent (the projection
        # form). Its filter would silently run without the guard, so callers must decline.
        def query_guard_dropped_at(line: u32, structs: mutable StructTable&) -> bool can[Abort.Panic]:
            for probe in 0..<structs.query_dropped_guard_lines.count |line, structs|:
                true return if structs.query_dropped_guard_lines[probe] == line
            return false


        def query_has_guard_at(line: u32, structs: mutable StructTable&) -> bool can[Abort.Panic]:
            for probe in 0..<structs.query_guard_lines.count |line, structs|:
                true return if structs.query_guard_lines[probe] == line
            return false


        # The `new[NAME]` allocation-target selector recorded on `line`, or "".
        def region_use_name_at(line: u32, structs: mutable StructTable&) -> sview can[Abort.Panic]:
            paired: usize = structs.region_use_lines.count if structs.region_use_lines.count < structs.region_use_names.count else structs.region_use_names.count
            for probe in 0..<paired |line, structs|:
                structs.region_use_names[probe] return if structs.region_use_lines[probe] == line
            return ""


        def query_head_for(line: u32, binder: sview, structs: mutable StructTable&) -> sview can[Abort.Panic]:
            can Abort.Panic:
                paired: usize = structs.query_binders.count if structs.query_binders.count < structs.query_heads.count else structs.query_heads.count
                found: mutable sview = ""
                have: mutable bool = false
                ambiguous: mutable bool = false
                for probe in 0..<paired |found, have, ambiguous, line, binder, structs|:
                    continue if structs.query_lines[probe] != line or structs.query_binders[probe] != binder
                    ambiguous <- true if have and structs.query_heads[probe] != found
                    found <- structs.query_heads[probe] if not have
                    have <- true
                # Two queries on one line sharing a binder AND differing in keyword —
                # `(count x in xs where …) + (sum x in xs where …)` — are indistinguishable: the
                # node keeps only the line, so neither the line nor the binder separates them.
                # Answer "unknown" and let every caller DECLINE. They all do: an unrecognised head
                # is already the "do not guess" path, because guessing here is exactly how
                # `all x in [1, 0] where x > 0` once returned TRUE.
                "" return if ambiguous
                found return if have
                return fn_return_head_at(line, structs)


        # The region a local declared on `line` was pinned to with `@region`, or "".
        def local_region_name_at(line: u32, structs: mutable StructTable&) -> sview can[Abort.Panic]:
            paired: usize = structs.local_region_lines.count if structs.local_region_lines.count < structs.local_region_names.count else structs.local_region_names.count
            for probe in 0..<paired |line, structs|:
                structs.local_region_names[probe] return if structs.local_region_lines[probe] == line
            return ""


        def fn_return_head_at(line: u32, structs: mutable StructTable&) -> sview can[Abort.Panic]:
            probe: mutable usize = 0
            while probe < structs.fn_return_lines.count |probe, line, structs|:
                structs.fn_return_heads[probe] return if structs.fn_return_lines[probe] == line
                probe <- probe + 1
            return sview("", 0, 0)


        def error_family_at(lines: darray[u32]&, families: darray[sview]&, line: u32) -> sview can[Abort.Panic]:
            for index in 0..<lines.count |lines, families, line|:
                families[index] return if lines[index] == line
            return sview("", 0, 0)


        def clone_error_family_at(line: u32, structs: mutable StructTable&) -> sview can[Abort.Panic]:
            can Abort.Panic:
                return error_family_at(structs.clone_error_lines, structs.clone_error_families, line)


        def local_error_family_at(line: u32, structs: mutable StructTable&) -> sview can[Abort.Panic]:
            can Abort.Panic:
                return error_family_at(structs.local_error_lines, structs.local_error_families, line)


        def type_expression_line(expression: Expr) -> u32:
            return match expression:
                Expr.Ident(_, ident_line): ident_line
                Expr.Index(_, _, index_line): index_line
                Expr.IndexN(_, _, indexn_line): indexn_line
                Expr.Unary(_, _, unary_line): unary_line
                Expr.Field(_, _, field_line): field_line
                Expr.Scope(_, _, scope_line): scope_line
                Expr.Tuple(_, tuple_line): tuple_line
                Expr.Lambda(_, _, lambda_line): lambda_line
                _: 0


        def field_error_family_for(expression: Expr, structs: mutable StructTable&) -> sview can[Abort.Panic]:
            can Abort.Panic:
                return error_family_at(structs.field_error_lines, structs.field_error_families, type_expression_line(expression))


        def parameter_value_type(expression: Expr, structs: mutable StructTable&) -> ValueType can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                payload: ValueType = annotation_value_type(expression, structs)
                family: sview = error_family_at(structs.param_error_lines, structs.param_error_families, type_expression_line(expression))
                if family != "":
                    return intern_error_union_type(payload, family, structs)
                return payload

            # Resolve a bare type HEAD NAME (`i64`, `dstr`, a struct) to a ValueType. Only the
            # forms a fn return head can name in the modeled subset; Unmodeled otherwise.
        def resolve_type_head(head: sview, structs: mutable StructTable&) -> ValueType can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic, Memory.Allocate:
                scalar: ValueType = scalar_type_of_name(head)
                scalar return if scalar.kind != TypeKind.Unmodeled
                # A head naming the CURRENT instantiation's type PARAMETER. The parser's compact
                # fn-type side table keeps only heads, so `fn(A) -> R` reaches here as the bare
                # names "A"/"R"; without this the interned Fn type carried an Unmodeled return,
                # which nothing noticed (a fn value is a pointer either way) until inference tried
                # to recover R from it. Checked after the scalars so a parameter can never shadow
                # a builtin name.
                bound_head: ValueType = bound_type_of(structs, head)
                bound_head return if bound_head.kind != TypeKind.Unmodeled
                # bits 1 is a MARKER, not a width: it distinguishes an opaque HANDLE from a real
                # C string, because `cstr == cstr` is a CONTENT compare (ctx_streq) while
                # `handle == handle` must be POINTER IDENTITY. Both still lower to `ptr`, and
                # emit_conversion treats ptr->ptr as a no-op whatever the bits, so the marker
                # changes nothing but equality. Compiled as a content compare, the library
                # reconciliation in emit_module_core read two distinct llvm::Function objects as
                # "equal" strings, skipped the repoint, and the stage1-built runtime object
                # exported arena_alloc.2/arena_free.4 instead of the real names.
                ValueType{kind: TypeKind.CStr, bits: 1} return if llvm_opaque_handle_name(head)
                intern_darray_type(ValueType{kind: TypeKind.Unsigned, bits: 8}, structs) return if head == "dstr"
                # `type X = id[T]` resolves by HEAD alone: an `id[T]` handle erases to its u32
                # backing whatever T is, so the referent cannot change the representation.
                ValueType{kind: TypeKind.Unsigned, bits: 32} return if head == "id"
                head_struct: i64 = struct_index_of(structs, head)
                ValueType{kind: TypeKind.Struct, bits: head_struct.u32()} return if head_struct >= 0
                # An alias head (`type A = B` where B is itself an alias). resolve_aliases fills
                # the table in declaration order, so a target declared earlier is already
                # resolved here; a cycle stays Unmodeled and declines, as before.
                head_alias: i64 = alias_index_of(structs, head)
                if head_alias >= 0:
                    aliased: ValueType = copied_type(structs.alias_types[head_alias.usize()])
                    aliased return if aliased.kind != TypeKind.Unmodeled
                # The parser's compact fn-type side table retains only the type HEAD (`Slice`),
                # not its bracket arguments (`Slice[T]`). When the surrounding signature has
                # already resolved the concrete generic field before reaching `fn(Slice[T])`,
                # recover that ready instance by base name. This preserves the parameter's real
                # LLVM aggregate type without guessing when no matching instance exists.
                for instance in 0..<structs.generic_struct_inst_bases.count |structs, head|:
                    continue if structs.generic_struct_inst_bases[instance] != head
                    ValueType{kind: TypeKind.Struct, bits: structs.generic_struct_inst_index[instance].u32()} return if structs.generic_struct_inst_ready[instance]
                return unmodeled_type()
