# Stage1 backend — resolving a written VARIANT PATH (`Shape.Circle`, `Ast::Expr.Ident`) to what
# it denotes: the enum that declares it, its tag, its payload slot and type. Packed and
# payload enums answer the same questions through separate tables, so both sets live here.
# Part of `module Backend` (see codegen.elisa).

extend Backend:
    private:


            # Whether a LABELLED call is a payload-enum constructor whose label is the payload
            # field's real name: `Shape.Circle(r: 42)` where the field is declared `r`. A label
            # that names something else is a different program, so it must not be emitted as
            # this constructor.
        def penum_ctor_labels_match(callee: Expr, argument_names: darray[sview]&, structs: mutable StructTable&) -> bool can[Abort.Panic]:
            can Abort.Panic:
                return false if argument_names.count != 1
                match callee:
                    # Any head penum_index_of_head resolves -- a bare `Shape`, or a module path
                    # `Other::Message` / alias `R::Message`. Only a bare Ident was accepted, so a
                    # qualified labelled constructor declined where its positional form compiled.
                    Expr.Field(label_head, label_variant, label_line):
                        label_enum_index: i64 = penum_index_of_head(structs, label_head)
                        return false if label_enum_index < 0
                        label_tag: i64 = penum_variant_index(structs, label_enum_index, label_variant)
                        return false if label_tag < 0
                        slot: usize = structs.payload_enums.penum_variant_start[label_enum_index.usize()] + label_tag.usize()
                        return false if not structs.payload_enums.penum_has_payload[slot]
                        return structs.payload_enums.penum_field_names[slot] == argument_names[0]
                    _:
                        pass
                return false




        # Whether a call is the single-field payload-enum constructor path guarded by
        # penum_ctor_labels_match. Multi-field payloads use their tuple lowering and keep
        # their existing positional handling; ordinary labelled functions are not constructors.
        def is_penum_single_payload_constructor(callee: Expr, structs: mutable StructTable&) -> bool can[Abort.Panic]:
            can Abort.Panic:
                match callee:
                    Expr.Field(constructor_head, constructor_variant, constructor_line):
                        enum_index: i64 = penum_index_of_head(structs, constructor_head)
                        return false if enum_index < 0
                        variant_index: i64 = penum_variant_index(structs, enum_index, constructor_variant)
                        return false if variant_index < 0
                        variant_slot: usize = structs.payload_enums.penum_variant_start[enum_index.usize()] + variant_index.usize()
                        return structs.payload_enums.penum_has_payload[variant_slot]
                    _:
                        pass
                return false




        def packed_variant_index_of_path(path: sview, structs: mutable StructTable&) -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic:
                # This resolver is security-sensitive: a wrong row is worse than a decline.
                # Keep an opt-in trace for the debugger/audit harness so a compiled program
                # cannot silently hide which lexical owner was used.
                if structs.target.debug_packed_path_enabled:
                    packed_path_message: mutable darray[u8] = []
                    _ = dbg_push_sview(packed_path_message, "PACKED_PATH owner=")
                    _ = dbg_push_sview(packed_path_message, structs.visibility.current_owner)
                    _ = dbg_push_sview(packed_path_message, " path=")
                    _ = dbg_push_sview(packed_path_message, path)
                    packed_path_message.push(0)
                    _ = puts((&packed_path_message[0]).cast[cstr] can Unsafe.PointerCast)
                dot: mutable i64 = -1
                for index in 0..<path.len |dot, path|:
                    dot <- index.i64() if path[index] == 46
                return -1 if dot <= 0
                enum_prefix: usize = name_chain_prefix(structs.packed_enums.packed_name_buckets, structs.packed_enums.packed_name_next, structs.packed_enums.packed_names)
                enum_name_start: mutable usize = 0
                enum_name_start <- packed_path_enum_name_start(path, dot) if enum_prefix > 0
                enum_name_bucket: mutable usize = 0
                enum_name_bucket <- name_chain_bucket_slice(path, enum_name_start, dot.usize(), structs.packed_enums.packed_name_buckets.count) if enum_prefix > 0
                best_rank: i64 = packed_path_best_candidate_rank(path, dot, structs, enum_prefix, enum_name_start, enum_name_bucket)
                return -1 if best_rank < 0
                enum_index: mutable i64 = packed_path_enum_candidate_first(structs, path, dot, enum_prefix, enum_name_start, enum_name_bucket)
                while enum_index >= 0 |structs, path, dot, enum_prefix, enum_name_start, enum_name_bucket, best_rank, enum_index|:
                    candidate_index: usize = enum_index.usize()
                    enum_index <- packed_path_enum_candidate_next(structs, path, dot, enum_prefix, enum_name_start, enum_index)
                    continue if not packed_path_matches_enum_candidate(path, candidate_index.i64(), dot, structs)
                    continue if packed_path_candidate_rank(path, candidate_index, dot, structs) != best_rank
                    for offset in 0..<structs.packed_enums.packed_variant_count[candidate_index] |structs, path, dot, candidate_index|:
                        variant: sview = structs.packed_enums.packed_variants[structs.packed_enums.packed_variant_start[candidate_index] + offset]
                        packed_tag_base: i64 = packed_hierarchy_tag_base(structs, candidate_index.i64())
                        if sview_matches_prefix(path, variant, dot + 1, path.len.i64()):
                            if structs.target.debug_packed_path_enabled:
                                packed_path_match_message: mutable darray[u8] = []
                                _ = dbg_push_sview(packed_path_match_message, "PACKED_MATCH enum=")
                                _ = dbg_push_int(packed_path_match_message, candidate_index.u32())
                                _ = dbg_push_sview(packed_path_match_message, " offset=")
                                _ = dbg_push_int(packed_path_match_message, offset.u32())
                                _ = dbg_push_sview(packed_path_match_message, " tag=")
                                _ = dbg_push_int(packed_path_match_message, (packed_tag_base + offset.i64()).u32())
                                packed_path_match_message.push(0)
                                _ = puts((&packed_path_match_message[0]).cast[cstr] can Unsafe.PointerCast)
                            return packed_tag_base + offset.i64()
                return -1




        # The final type component before the variant dot is the packed-name key. Hashing
        # this slice lets path lookups visit only same-leaf enum rows while the full path
        # matcher below still decides owner and module qualification.
        def packed_path_enum_name_start(path: sview, dot: i64) -> usize can[Abort.Panic]:
            start: mutable usize = 0
            for index in 0..<dot.usize() |start, path, dot|:
                start <- index + 1.usize() if path[index] == 46
                start <- index + 2.usize() if path[index] == 58 and index + 1.usize() < dot.usize() and path[index + 1.usize()] == 58
            return start


        def packed_path_enum_candidate_first(structs: StructTable&, path: sview, dot: i64, prefix: usize, start: usize, bucket: usize) -> i64 can[Abort.Panic]:
            return -1 if dot <= 0 or dot.usize() > path.len
            return 0 if prefix == 0 and structs.packed_enums.packed_names.count > 0
            return -1 if:
                prefix == 0
                start > dot.usize()
            return name_chain_slice_from(structs.packed_enums.packed_name_next, structs.packed_enums.packed_names, path, start, dot.usize(), structs.packed_enums.packed_name_buckets[bucket], prefix)


        def packed_path_enum_candidate_next(structs: StructTable&, path: sview, dot: i64, prefix: usize, start: usize, current: i64) -> i64 can[Abort.Panic]:
            if prefix == 0:
                return current + 1 if current >= 0 and current.usize() + 1 < structs.packed_enums.packed_names.count
                return -1
            return -1 if current < 0 or current.usize() >= structs.packed_enums.packed_names.count
            if current.usize() < prefix:
                return name_chain_slice_from(structs.packed_enums.packed_name_next, structs.packed_enums.packed_names, path, start, dot.usize(), structs.packed_enums.packed_name_next[current.usize()], prefix)
            return name_chain_slice_tail(structs.packed_enums.packed_names, path, start, dot.usize(), current.usize() + 1.usize())



            # Source patterns may spell a refinement as `Ast::Expr.Variant` (or
            # `Ast.Expr.Variant`), while the packed registry intentionally stores the
            # leaf refinement name `Expr`. Accept both forms at the lookup boundary.
        def packed_path_matches_enum_candidate(path: sview, enum_index: i64, dot: i64, structs: StructTable&) -> bool can[Abort.Panic]:
            can Abort.Panic:
                return false if enum_index < 0 or enum_index.usize() >= structs.packed_enums.packed_names.count
                enum_name: sview = structs.packed_enums.packed_names[enum_index.usize()]
                enum_length: i64 = enum_name.len.i64()
                owner: sview = packed_owner_at(structs, enum_index.usize())
                # A bare path is lexical. It may select a module-local row only while the
                # corresponding function is being emitted; outside that owner, a duplicate
                # name must decline instead of binding to whichever registry row came first.
                if dot == enum_length and sview_matches_prefix(path, enum_name, 0, dot):
                    return owner == "" or owner == structs.visibility.current_owner
                # Qualified paths retain their module prefix. Support both spellings accepted
                # by the parser (`M::E.V` and `M.E.V`) without allocating a joined sview.
                if owner != "":
                    return true if variant_qualified_type_matches(path, dot, owner, enum_name, structs)
                    owner_length: i64 = owner.len.i64()
                    qualified_length: i64 = owner_length + 2 + enum_length
                    if dot == qualified_length and sview_matches_prefix(path, owner, 0, owner_length):
                        separator: u8 = path[owner_length.usize()]
                        separator2: u8 = path[owner_length.usize() + 1.usize()]
                        return true if separator == 58 and separator2 == 58 and sview_matches_prefix(path, enum_name, owner_length.usize() + 2.usize(), dot)
                    if dot == owner_length + 1 + enum_length and sview_matches_prefix(path, owner, 0, owner_length):
                        return true if path[owner_length.usize()] == 46 and sview_matches_prefix(path, enum_name, owner_length.usize() + 1.usize(), dot)
                # Compiler AST refinements are source-level members of Ast even though
                # their legacy flat rows have no owner (they are introduced by `extend
                # Ast`). Mirror packed_index_of_head's guarded compatibility at the
                # string-path boundary used by match patterns.
                if owner == "" and packed_is_ast_refinement(structs, enum_index):
                    ast_length: i64 = 5 + enum_length
                    return true if:
                        dot == ast_length and path[3] == 58 and path[4] == 58 and sview_matches_prefix(path, "Ast", 0, 3) and sview_matches_prefix(path, enum_name, 5, dot)
                        dot == 4 + enum_length and path[3] == 46 and sview_matches_prefix(path, "Ast", 0, 3) and sview_matches_prefix(path, enum_name, 4, dot)
                # Legacy compiler-AST paths were recorded as `Ast::Expr.Variant` while some
                # auxiliary tables kept only `Expr`. Keep that compatibility only for the
                # actual Ast owner, never for an arbitrary duplicate user enum.
                if owner == "Ast":
                    ast_length: i64 = 5 + enum_length
                    return true if:
                        dot == ast_length and path[3] == 58 and path[4] == 58 and sview_matches_prefix(path, enum_name, 5, dot)
                        dot == 4 + enum_length and path[3] == 46 and sview_matches_prefix(path, enum_name, 4, dot)
                return false




        def packed_path_candidate_rank(path: sview, enum_index: usize, dot: i64, structs: StructTable&) -> i64 can[Abort.Panic]:
            owner: sview = packed_owner_at(structs, enum_index)
            name: sview = structs.packed_enums.packed_names[enum_index]
            if dot == name.len.i64() and owner != "" and owner == structs.visibility.current_owner:
                return (owner.len + 1.usize()).i64()
            return variant_qualified_type_rank(path, dot, owner, name, structs)

        # Resolve the highest-ranked owner once for all tag/payload/store-slot consumers.
        # Callers then visit matching rows at that rank in source order, retaining first-row
        # tie behavior without having every candidate rescan its same-name competitors.
        def packed_path_best_candidate_rank(path: sview, dot: i64, structs: StructTable&, prefix: usize, start: usize, bucket: usize) -> i64 can[Abort.Panic]:
            best_rank: mutable i64 = -1
            enum_index: mutable i64 = packed_path_enum_candidate_first(structs, path, dot, prefix, start, bucket)
            while enum_index >= 0 |structs, path, dot, prefix, start, bucket, best_rank, enum_index|:
                candidate_index: usize = enum_index.usize()
                enum_index <- packed_path_enum_candidate_next(structs, path, dot, prefix, start, enum_index)
                continue if not packed_path_matches_enum_candidate(path, candidate_index.i64(), dot, structs)
                rank: i64 = packed_path_candidate_rank(path, candidate_index, dot, structs)
                best_rank <- rank if rank > best_rank
            return best_rank

        def packed_variant_index_of_parts(enum_name: sview, variant_name: sview, structs: mutable StructTable&) -> i64 can[Abort.Panic]:
            can Abort.Panic:
                enum_index: i64 = packed_index_of(structs, enum_name)
                return -1 if enum_index < 0
                local_index: i64 = packed_variant_local_index(structs, enum_index, variant_name)
                return -1 if local_index < 0
                packed_tag_base: i64 = packed_hierarchy_tag_base(structs, enum_index)
                return packed_tag_base + local_index




        # The head-aware twin keeps a module qualifier until the registry row is chosen.
        # Callers that already have `Alpha::Result` as an Expr must not reduce it to the leaf
        # `Result`: two modules may use the same enum and assign different variant ordinals.
        def packed_variant_index_of_head(head: Expr, variant_name: sview, structs: mutable StructTable&) -> i64 can[Abort.Panic]:
            can Abort.Panic:
                enum_index: i64 = packed_index_of_head(structs, head)
                return -1 if enum_index < 0
                local_index: i64 = packed_variant_local_index(structs, enum_index, variant_name)
                return -1 if local_index < 0
                packed_tag_base: i64 = packed_hierarchy_tag_base(structs, enum_index)
                return packed_tag_base + local_index




        def packed_payload_of_path(path: sview, structs: mutable StructTable&) -> ValueType can[Abort.Panic]:
            can Abort.Panic:
                dot: mutable i64 = -1
                for index in 0..<path.len |dot, path|:
                    dot <- index.i64() if path[index] == 46
                return unmodeled_type() if dot <= 0
                enum_prefix: usize = name_chain_prefix(structs.packed_enums.packed_name_buckets, structs.packed_enums.packed_name_next, structs.packed_enums.packed_names)
                enum_name_start: mutable usize = 0
                enum_name_start <- packed_path_enum_name_start(path, dot) if enum_prefix > 0
                enum_name_bucket: mutable usize = 0
                enum_name_bucket <- name_chain_bucket_slice(path, enum_name_start, dot.usize(), structs.packed_enums.packed_name_buckets.count) if enum_prefix > 0
                best_rank: i64 = packed_path_best_candidate_rank(path, dot, structs, enum_prefix, enum_name_start, enum_name_bucket)
                return unmodeled_type() if best_rank < 0
                enum_index: mutable i64 = packed_path_enum_candidate_first(structs, path, dot, enum_prefix, enum_name_start, enum_name_bucket)
                while enum_index >= 0 |structs, path, dot, enum_prefix, enum_name_start, enum_name_bucket, best_rank, enum_index|:
                    candidate_index: usize = enum_index.usize()
                    enum_index <- packed_path_enum_candidate_next(structs, path, dot, enum_prefix, enum_name_start, enum_index)
                    continue if not packed_path_matches_enum_candidate(path, candidate_index.i64(), dot, structs)
                    continue if packed_path_candidate_rank(path, candidate_index, dot, structs) != best_rank
                    for offset in 0..<structs.packed_enums.packed_variant_count[candidate_index] |structs, path, dot, candidate_index|:
                        slot: usize = structs.packed_enums.packed_variant_start[candidate_index] + offset
                        continue if not sview_matches_prefix(path, structs.packed_enums.packed_variants[slot], dot + 1, path.len.i64())
                        return unmodeled_type() if not structs.packed_enums.packed_has_payload[slot]
                        return copied_type(structs.packed_enums.packed_payloads[slot])
                return unmodeled_type()




            # Return the packed payload pool slot for `Child.Variant`. The variant tag is
            # hierarchy-global for AST refinements, but payload metadata remains local to the
            # declaring refinement.
        def packed_slot_of_path(path: sview, structs: mutable StructTable&) -> i64 can[Abort.Panic]:
            can Abort.Panic:
                dot: mutable i64 = -1
                for index in 0..<path.len |dot, path|:
                    dot <- index.i64() if path[index] == 46
                return -1 if dot <= 0
                enum_prefix: usize = name_chain_prefix(structs.packed_enums.packed_name_buckets, structs.packed_enums.packed_name_next, structs.packed_enums.packed_names)
                enum_name_start: mutable usize = 0
                enum_name_start <- packed_path_enum_name_start(path, dot) if enum_prefix > 0
                enum_name_bucket: mutable usize = 0
                enum_name_bucket <- name_chain_bucket_slice(path, enum_name_start, dot.usize(), structs.packed_enums.packed_name_buckets.count) if enum_prefix > 0
                best_rank: i64 = packed_path_best_candidate_rank(path, dot, structs, enum_prefix, enum_name_start, enum_name_bucket)
                return -1 if best_rank < 0
                enum_index: mutable i64 = packed_path_enum_candidate_first(structs, path, dot, enum_prefix, enum_name_start, enum_name_bucket)
                while enum_index >= 0 |structs, path, dot, enum_prefix, enum_name_start, enum_name_bucket, best_rank, enum_index|:
                    candidate_index: usize = enum_index.usize()
                    enum_index <- packed_path_enum_candidate_next(structs, path, dot, enum_prefix, enum_name_start, enum_index)
                    continue if not packed_path_matches_enum_candidate(path, candidate_index.i64(), dot, structs)
                    continue if packed_path_candidate_rank(path, candidate_index, dot, structs) != best_rank
                    for offset in 0..<structs.packed_enums.packed_variant_count[candidate_index] |structs, path, dot, candidate_index|:
                        slot: usize = structs.packed_enums.packed_variant_start[candidate_index] + offset
                        return slot.i64() if sview_matches_prefix(path, structs.packed_enums.packed_variants[slot], dot + 1, path.len.i64())
                return -1




            # The ENUM index that declares `Child.Variant` — the sibling of packed_slot_of_path,
            # which returns the payload-pool SLOT.
            #
            # The two index DIFFERENT pools and are not interchangeable: packed_row_llvm_type,
            # packed_payload_words and packed_common_counts are all keyed by ENUM index, while
            # packed_field_type_start / packed_payloads are keyed by variant SLOT. Passing a slot
            # where an enum index belongs silently built the wrong ROW TYPE for a nested
            # sub-pattern, so its payload was read at the wrong offsets and every binder after the
            # first came out garbage.
        def packed_enum_index_of_path(path: sview, structs: mutable StructTable&) -> i64 can[Abort.Panic]:
            can Abort.Panic:
                dot: mutable i64 = -1
                for index in 0..<path.len |dot, path|:
                    dot <- index.i64() if path[index] == 46
                return -1 if dot <= 0
                enum_prefix: usize = name_chain_prefix(structs.packed_enums.packed_name_buckets, structs.packed_enums.packed_name_next, structs.packed_enums.packed_names)
                enum_name_start: mutable usize = 0
                enum_name_start <- packed_path_enum_name_start(path, dot) if enum_prefix > 0
                enum_name_bucket: mutable usize = 0
                enum_name_bucket <- name_chain_bucket_slice(path, enum_name_start, dot.usize(), structs.packed_enums.packed_name_buckets.count) if enum_prefix > 0
                best_rank: i64 = packed_path_best_candidate_rank(path, dot, structs, enum_prefix, enum_name_start, enum_name_bucket)
                return -1 if best_rank < 0
                enum_index: mutable i64 = packed_path_enum_candidate_first(structs, path, dot, enum_prefix, enum_name_start, enum_name_bucket)
                while enum_index >= 0 |structs, path, dot, enum_prefix, enum_name_start, enum_name_bucket, best_rank, enum_index|:
                    candidate_index: usize = enum_index.usize()
                    enum_index <- packed_path_enum_candidate_next(structs, path, dot, enum_prefix, enum_name_start, enum_index)
                    continue if not packed_path_matches_enum_candidate(path, candidate_index.i64(), dot, structs)
                    continue if packed_path_candidate_rank(path, candidate_index, dot, structs) != best_rank
                    for offset in 0..<structs.packed_enums.packed_variant_count[candidate_index] |structs, path, dot, candidate_index|:
                        slot: usize = structs.packed_enums.packed_variant_start[candidate_index] + offset
                        return candidate_index.i64() if sview_matches_prefix(path, structs.packed_enums.packed_variants[slot], dot + 1, path.len.i64())
                return -1




            # The packed twin of penum_ctor_labels_match: `new Node.Leaf(v: 42)` labels the
            # payload field, and the label must be the field's real name.
        def packed_ctor_labels_match(callee: Expr, argument_names: darray[sview]&, structs: mutable StructTable&) -> bool can[Abort.Panic]:
            can Abort.Panic:
                # With a `common:` block a constructor carries commons THEN the payload
                # (`new Expr.Int(span: 1, value: 42)`), so more than one label is legitimate.
                # Only the payload label is checked against its declared name here; the commons
                # are positional-by-construction (the parser prepends them in order).
                return true if argument_names.count > 1
                return false if argument_names.count != 1
                match callee:
                    Expr.Field(packed_label_head, packed_label_variant, packed_label_line):
                        packed_label_index: i64 = packed_index_of_head(structs, packed_label_head)
                        return false if packed_label_index < 0
                        packed_label_tag: i64 = packed_variant_index(structs, packed_label_index, packed_label_variant)
                        return false if packed_label_tag < 0
                        packed_label_slot: usize = structs.packed_enums.packed_variant_start[packed_label_index.usize()] + packed_variant_local_index(structs, packed_label_index, packed_label_variant).usize()
                        return false if not structs.packed_enums.packed_has_payload[packed_label_slot]
                        return structs.packed_enums.packed_field_names[packed_label_slot] == argument_names[0]
                    _:
                        pass
                return false




            # `Shape.Circle` -> the variant's TAG, or -1. Same byte-comparison approach as
            # ordinal_of_dotted_path, against the payload-enum pools.
        # The ordinal of an UNQUALIFIED variant name -- `catch f(x): … NotFound: …`, where the
        # arm names an error variant without its set. The set is implied by the guarded call's
        # error family, which the catch emitter does not carry, so the name is resolved across
        # every registered enum and accepted only when exactly ONE declares it.
        #
        # BOTH pools are scanned: an `error E:` declaration with payload variants registers as
        # a PAYLOAD enum, one without them as a CONST enum. Scanning only the payload pool is
        # why the first attempt at this found nothing.
        #
        # Ambiguity DECLINES rather than taking the first hit: two error sets sharing a variant
        # name would otherwise dispatch on the wrong ordinal, a silent wrong answer.
        def variant_ordinal_of_bare_name(name: sview, structs: mutable StructTable&) -> i64 can[Abort.Panic]:
            can Abort.Panic:
                found: mutable i64 = -1
                matches: mutable i64 = 0
                for penum_index in 0..<structs.payload_enums.penum_names.count |found, matches, name, structs|:
                    # finalize_payload_enum_words tombstones unusable payload enums by
                    # blanking their name while retaining their variant spans. They are no
                    # longer registered and must not make an otherwise unique catch variant
                    # ambiguous.
                    continue if structs.payload_enums.penum_names[penum_index] == ""
                    for penum_offset in 0..<structs.payload_enums.penum_variant_count[penum_index] |found, matches, name, structs, penum_index|:
                        if structs.payload_enums.penum_variants[structs.payload_enums.penum_variant_start[penum_index] + penum_offset] == name:
                            found <- penum_offset.i64()
                            matches <- matches + 1
                            return -1 if matches > 1
                for plain_index in 0..<structs.const_enums.enum_names.count |found, matches, name, structs|:
                    for plain_offset in 0..<structs.const_enums.enum_variant_count[plain_index] |found, matches, name, structs, plain_index|:
                        if structs.const_enums.enum_variants[structs.const_enums.enum_variant_start[plain_index] + plain_offset] == name:
                            found <- plain_offset.i64()
                            matches <- matches + 1
                            return -1 if matches > 1
                return -1 if matches != 1
                return found




        # The payload enum a variant PATH (`Owner.V`) belongs to, resolving `Owner` as a
        # payload enum name or as an alias of one (a refinement of an inline hierarchy),
        # and the ROW inside that enum's span that `Owner` declared under that name.
        # Compare a flattened module path with its declaring owner. Resolve only the
        # root module alias; punctuation is normalized without allocating a new string.
        def variant_module_path_matches_absolute(path: sview, end: usize, owner: sview, structs: StructTable&, resolve_aliases: bool) -> bool can[Abort.Panic]:
            root_end: mutable usize = 0
            while root_end < end |root_end, path, end|:
                break if path[root_end] == 58 or path[root_end] == 46
                root_end <- root_end + 1.usize()
            return false if root_end == 0
            root: sview = string_view_slice(path, 0, root_end.i64())
            target: sview = module_alias_target(root, structs) if resolve_aliases else root
            owner_index: mutable usize = target.len
            return false if owner_index > owner.len or not sview_range_matches(owner, 0, owner_index, target)
            path_index: mutable usize = root_end
            while path_index < end |path_index, owner_index, path, end, owner|:
                if path[path_index] == 46:
                    path_index <- path_index + 1.usize()
                elif path_index + 1.usize() < end and path[path_index] == 58 and path[path_index + 1.usize()] == 58:
                    path_index <- path_index + 2.usize()
                else:
                    return false
                return false if:
                    path_index >= end or owner_index + 1.usize() >= owner.len
                    owner[owner_index] != 58 or owner[owner_index + 1.usize()] != 58
                owner_index <- owner_index + 2.usize()
                while path_index < end |path_index, owner_index, path, end, owner|:
                    break if path[path_index] == 58 or path[path_index] == 46
                    return false if owner_index >= owner.len or path[path_index] != owner[owner_index]
                    path_index <- path_index + 1.usize()
                    owner_index <- owner_index + 1.usize()
            return owner_index == owner.len

        def variant_module_path_matches(path: sview, end: usize, owner: sview, structs: StructTable&) -> bool can[Abort.Panic]:
            enclosing: sview = structs.visibility.current_owner
            prefix: mutable usize = enclosing.len
            while prefix > 0 |prefix, enclosing, path, end, owner, structs|:
                if owner.len > prefix + 2.usize():
                    matches: mutable bool = true
                    for index in 0..<prefix |matches, enclosing, owner|:
                        matches <- false if owner[index] != enclosing[index]
                    if matches and owner[prefix] == 58 and owner[prefix + 1.usize()] == 58:
                        suffix: sview = string_view_slice(owner, (prefix + 2.usize()).i64(), owner.len.i64())
                        return true if variant_module_path_matches_absolute(path, end, suffix, structs, false)
                parent: mutable usize = 0
                for index in 0..<prefix |parent, enclosing|:
                    parent <- index if index + 1.usize() < prefix and enclosing[index] == 58 and enclosing[index + 1.usize()] == 58
                prefix <- parent
            return variant_module_path_matches_absolute(path, end, owner, structs, true)

        def variant_qualified_type_matches(path: sview, dot: i64, owner: sview, name: sview, structs: StructTable&) -> bool can[Abort.Panic]:
            return false if dot <= name.len.i64() or owner == ""
            leaf_start: usize = dot.usize() - name.len
            return false if not sview_matches_prefix(path, name, leaf_start.i64(), dot)
            if leaf_start >= 2.usize() and path[leaf_start - 2.usize()] == 58 and path[leaf_start - 1.usize()] == 58:
                return variant_module_path_matches(path, leaf_start - 2.usize(), owner, structs)
            if leaf_start >= 1.usize() and path[leaf_start - 1.usize()] == 46:
                return variant_module_path_matches(path, leaf_start - 1.usize(), owner, structs)
            return false

        def penum_path_matches_enum(path: sview, dot: i64, enum_index: usize, structs: mutable StructTable&) -> bool can[Abort.Panic]:
            enum_name: sview = structs.payload_enums.penum_names[enum_index]
            enum_length: i64 = enum_name.len.i64()
            owner: sview = penum_owner_at(structs, enum_index)
            if dot == enum_length and sview_matches_prefix(path, enum_name, 0, dot):
                return owner == structs.visibility.current_owner if structs.visibility.current_owner != ""
                return owner == ""
            if owner == "":
                return false
            return true if variant_qualified_type_matches(path, dot, owner, enum_name, structs)
            owner_length: i64 = owner.len.i64()
            qualified_length: i64 = owner_length + 2 + enum_length
            if dot == qualified_length and sview_matches_prefix(path, owner, 0, owner_length):
                return true if path[owner_length.usize()] == 58 and path[owner_length.usize() + 1.usize()] == 58 and sview_matches_prefix(path, enum_name, owner_length.usize() + 2.usize(), dot)
            if dot == owner_length + 1 + enum_length and sview_matches_prefix(path, owner, 0, owner_length):
                return true if path[owner_length.usize()] == 46 and sview_matches_prefix(path, enum_name, owner_length.usize() + 1.usize(), dot)
            return false




        # An INLINE hierarchy refinement is represented by an alias of the root row. Match
        # both `Decl.Variant` in the refinement's lexical module and `Ast::Decl.Variant` when
        # the source keeps the module qualifier. Alias lookup must stay owner-aware: two
        # modules may each define a refinement named `Decl`.
        def penum_path_matches_alias(path: sview, dot: i64, alias_index: usize, structs: StructTable&) -> bool can[Abort.Panic]:
            return false if alias_index >= structs.aliases.alias_names.count or alias_index >= structs.aliases.alias_types.count
            alias_type: ValueType = structs.aliases.alias_types[alias_index]
            return false if alias_type.kind != TypeKind.PayloadEnum or alias_type.bits.usize() >= structs.payload_enums.penum_names.count
            alias_name: sview = structs.aliases.alias_names[alias_index]
            alias_owner: sview = alias_owner_at(structs, alias_index)
            alias_length: i64 = alias_name.len.i64()
            if dot == alias_length and sview_matches_prefix(path, alias_name, 0, dot):
                return alias_owner == structs.visibility.current_owner if structs.visibility.current_owner != ""
                return alias_owner == ""
            return false if alias_owner == ""
            return true if variant_qualified_type_matches(path, dot, alias_owner, alias_name, structs)
            owner_length: i64 = alias_owner.len.i64()
            qualified_length: i64 = owner_length + 2 + alias_length
            return false if:
                dot != qualified_length or not sview_matches_prefix(path, alias_owner, 0, owner_length)
                path[owner_length.usize()] != 58 or path[owner_length.usize() + 1.usize()] != 58
            return sview_matches_prefix(path, alias_name, owner_length.usize() + 2.usize(), dot)




        # The final type component before the variant dot. A qualified path carries its
        # module prefix (`Ast::Decl.V`), while penum_variant_owners intentionally stores the
        # declaration's bare member name (`Decl`). Comparing the entire prefix therefore
        # missed the owner and fell back to the first same-named variant in the hierarchy.
        def penum_path_owner_leaf_matches(path: sview, dot: i64, owner: sview) -> bool can[Abort.Panic]:
            return false if owner == "" or dot <= 0
            leaf_start: mutable usize = 0
            for index in 0..<dot.usize() |leaf_start, path|:
                leaf_start <- index + 2.usize() if index + 1.usize() < dot.usize() and path[index] == 58 and path[index + 1.usize()] == 58
                leaf_start <- index + 1.usize() if path[index] == 46
            leaf_length: usize = dot.usize() - leaf_start
            return false if leaf_length != owner.len
            return sview_matches_prefix(path, owner, leaf_start.i64(), dot)




        def variant_qualified_type_matches_literal(path: sview, dot: i64, owner: sview, name: sview, structs: StructTable&) -> bool can[Abort.Panic]:
            return false if dot <= name.len.i64() or owner == ""
            leaf_start: usize = dot.usize() - name.len
            return false if not sview_matches_prefix(path, name, leaf_start.i64(), dot)
            if leaf_start >= 2.usize() and path[leaf_start - 2.usize()] == 58 and path[leaf_start - 1.usize()] == 58:
                return variant_module_path_matches_absolute(path, leaf_start - 2.usize(), owner, structs, false)
            if leaf_start >= 1.usize() and path[leaf_start - 1.usize()] == 46:
                return variant_module_path_matches_absolute(path, leaf_start - 1.usize(), owner, structs, false)
            return false

        def variant_qualified_type_rank(path: sview, dot: i64, owner: sview, name: sview, structs: StructTable&) -> i64 can[Abort.Panic]:
            enclosing: sview = structs.visibility.current_owner
            prefix: mutable usize = enclosing.len
            while prefix > 0 |prefix, enclosing, path, dot, owner, name, structs|:
                if owner.len > prefix + 2.usize():
                    matches: mutable bool = true
                    for index in 0..<prefix |matches, enclosing, owner|:
                        matches <- false if owner[index] != enclosing[index]
                    if matches and owner[prefix] == 58 and owner[prefix + 1.usize()] == 58:
                        suffix: sview = string_view_slice(owner, (prefix + 2.usize()).i64(), owner.len.i64())
                        return (prefix + 1.usize()).i64() if variant_qualified_type_matches_literal(path, dot, suffix, name, structs)
                parent: mutable usize = 0
                for index in 0..<prefix |parent, enclosing|:
                    parent <- index if index + 1.usize() < prefix and enclosing[index] == 58 and enclosing[index + 1.usize()] == 58
                prefix <- parent
            return 0

        def penum_path_enum_index(path: sview, dot: i64, structs: mutable StructTable&) -> i64 can[Abort.Panic]:
            best: mutable i64 = -1
            best_rank: mutable i64 = -1
            for enum_index in 0..<structs.payload_enums.penum_names.count |structs, path, dot, best, best_rank|:
                continue if not penum_path_matches_enum(path, dot, enum_index, structs)
                rank: i64 = variant_qualified_type_rank(path, dot, penum_owner_at(structs, enum_index), structs.payload_enums.penum_names[enum_index], structs)
                if rank > best_rank:
                    best <- enum_index.i64()
                    best_rank <- rank
            return best if best >= 0
            alias_found: mutable i64 = -1
            alias_matches: mutable i64 = 0
            for alias_slot in 0..<structs.aliases.alias_names.count |structs, path, dot|:
                continue if not penum_path_matches_alias(path, dot, alias_slot, structs)
                aliased: ValueType = structs.aliases.alias_types[alias_slot]
                alias_found <- aliased.bits.i64()
                alias_matches <- alias_matches + 1
            return alias_found if alias_matches == 1
            # A bare path can refer to a globally unique registered row even when code is
            # emitted from a synthetic owner-less helper. Qualified or lexical duplicates
            # never fall through to the first row.
            found: mutable i64 = -1
            matches: mutable i64 = 0
            for enum_index in 0..<structs.payload_enums.penum_names.count |found, matches, structs, path, dot|:
                enum_name: sview = structs.payload_enums.penum_names[enum_index]
                if enum_name.len.i64() == dot and sview_matches_prefix(path, enum_name, 0, dot):
                    found <- enum_index.i64()
                    matches <- matches + 1
            return found if matches == 1
            return -1

include "./codegen_variant_paths_error_sets.elisa"
