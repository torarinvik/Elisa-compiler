# Stage1 backend — inference for value extents in fixed-array parameters.
# Kept separate from the main unifier so its type/value metadata checks stay auditable.

extend Backend:
    private:
        # Return the unique generic parameter position for a declared `N: usize`.
        # Missing or malformed parallel metadata is not evidence that a parameter is a value.
        def generic_usize_value_position(slot: usize, name: sview, generics: GenericTable&) -> i64 can[Abort.Panic]:
            return -1 if slot >= generics.param_start.count or slot >= generics.param_count.count
            return -1 if generics.params.count != generics.param_is_usize_value.count
            start: usize = generics.param_start[slot]
            count: usize = generics.param_count[slot]
            return -1 if start > generics.params.count or count > generics.params.count - start
            mutable found: i64 = -1
            for offset in 0..<count |generics, start, name, found|:
                index: usize = start + offset
                if generics.params[index] == name and generics.param_is_usize_value[index]:
                    return -1 if found >= 0
                    found <- offset.i64()
            return found


        # Preconditions: a usable parameter slot and equal array-element/extent pools.
        # Postconditions: -1 means this annotation has no uniquely declared N: usize;
        # 1 means N is bound to the positive actual extent (or already equals it); 0
        # means a malformed binding or a different repeated extent, without replacing it.
        def unify_fixed_array_extent(annotation: Expr, actual: ValueType, slot: usize, generics: GenericTable&, structs: mutable StructTable&, bindings: mutable darray[ValueType]&, bound_flags: mutable darray[bool]&) -> i64 can[Abort.Panic, Memory.Allocate]:
            match annotation:
                Expr.Unary(qualifier, inner, _) if qualifier == TokenKind.Mutable:
                    return unify_fixed_array_extent(inner, actual, slot, generics, structs, bindings, bound_flags)
                Expr.Unary(qualifier, inner, _) if qualifier == TokenKind.Ampersand:
                    referent: ValueType = copied_type(structs.ref_targets[actual.bits.usize()]) if actual.kind == TypeKind.Ref and actual.bits.usize() < structs.ref_targets.count else copied_type(actual)
                    return unify_fixed_array_extent(inner, referent, slot, generics, structs, bindings, bound_flags)
                Expr.Index(element_annotation, Expr.Ident(extent_name, _), _) if actual.kind == TypeKind.Array:
                    return -1 if structs.array_elements.count != structs.array_extents.count or actual.bits.usize() >= structs.array_elements.count
                    position: i64 = generic_usize_value_position(slot, extent_name, generics)
                    return -1 if position < 0
                    index: usize = position.usize()
                    return 0 if index >= bindings.count or index >= bound_flags.count
                    extent: u32 = structs.array_extents[actual.bits.usize()]
                    return 0 if extent == 0
                    if bound_flags[index]:
                        return 0 if bindings[index].kind != TypeKind.ConstUsize or bindings[index].bits != extent
                    else:
                        bindings[index] <- ValueType{kind: TypeKind.ConstUsize, bits: extent}
                        bound_flags[index] <- true
                    unify_annotation(element_annotation, copied_type(structs.array_elements[actual.bits.usize()]), generics, slot, structs, bindings, bound_flags)
                    return 1
                _:
                    return -1
