                        ps_count_recv_t: ValueType = expression_type_depth(field_object, local_scope, fns, structs, generics, depth + 1)
                        ValueType{kind: TypeKind.Signed, bits: 64} return if ps_count_recv_t.kind == TypeKind.PackedStore
                    if field_name == "values":
                        nt_values_recv: ValueType = expression_type_depth(field_object, local_scope, fns, structs, generics, depth + 1)
                        nt_values_recv return if nt_values_recv.kind == TypeKind.View
                    # Bitset flag names type as bool (`token.flags.has_suffix`).
                    ValueType{kind: TypeKind.Bool, bits: 1} return if field_name == "has_suffix" or field_name == "has_prefix"
                    # `d.entry(k).found` / `.value` — the ENTRY api's READ members. `found` is a
                    # bool; `value` is the cached `T&?` that `arena_dict_get_mut` returns.
                    if field_name == "found" or field_name == "value":
                        match field_object:
                            Expr.Call(read_entry_callee, read_entry_args, read_entry_names, read_entry_line):
                                match read_entry_callee:
                                    Expr.Field(read_entry_recv, read_entry_method, read_entry_method_line):
                                        if read_entry_method == "entry":
                                            read_entry_dict: darray[ValueType] = dict_type_args_of(read_entry_recv, local_scope, fns, structs, generics)
                                            if read_entry_dict.count != 0:
                                                ValueType{kind: TypeKind.Bool, bits: 1} return if field_name == "found"
                                                read_entry_helper: sview = resolved_container_helper("DynDict", "get_mut", generics)
                                                if read_entry_helper != "":
                                                    read_entry_narrowed: darray[ValueType] = container_helper_type_args(read_entry_helper, read_entry_dict, generics)
