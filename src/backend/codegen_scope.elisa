                    # ref (`heap T&?`) is looked through too: stage0 represents it as a bare
                    # ptr and permits flow-guarded access without narrowing.
                    if object_type.kind == TypeKind.Optional:
                        field_opt_payload: ValueType = optional_payload_of(object_type, structs)
                        object_type <- field_opt_payload if field_opt_payload.kind == TypeKind.Ref and ref_is_heap_ref(field_opt_payload, structs)
                    object_type <- ref_target_of(object_type, structs) if object_type.kind == TypeKind.Ref
