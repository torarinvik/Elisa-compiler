# Stage1 backend — the local Scope (lookup/declare) and literal decoding.
# Part of `module Backend` (see codegen.elisa); split out to keep each file short.

extend Backend:
    private:
        # The handle for `owner::name`, or null when there is no such function.
        # When overloads share a bare name, the first registered entry is returned —
        # prefer `lookup_function_arity` at call sites with a known argument count.
        def lookup_function(fns: FnTable&, owner: sview, name: sview) -> LLVMValueRef? can[Abort.Panic]:
            for index in 0..<fns.names.count |fns, owner, name|:
                fns.handles[index] return if fns.names[index] == name and fns.owners[index] == owner
            return null

        # Among several overloads sharing (owner, name, ARITY), the index whose declared
        # parameter types match the arguments — or -1.
        #
        # Arity alone is not enough. `def f(x: i64)` and `def f(x: bool)` are both legal and
        # both arity 1 (stage0 accepts type-based overloads and REJECTS arity-based ones), and
        # emit_direct_call took the FIRST arity match, so `f(true)` called the i64 body:
        # stage0 answered 21 and stage1 answered 11. The symbols were already distinct
        # (`f` and `f.1`, suffixed by arity) — the defect was purely in resolution.
        #
        # A bare numeric literal matches its whole numeric family, since `f(5)` types as
        # Unmodeled: an int literal has no type of its own and adopts its context.
        def overload_index_for_args(fns: FnTable&, owner: sview, name: sview, arguments: darray[Expr]&, local_scope: mutable Scope&, structs: mutable StructTable&, generics: mutable GenericTable&) -> i64 can[Abort.Panic, Memory.Allocate] :
            can Abort.Panic:
                for index in 0..<fns.names.count |fns, owner, name, arguments, local_scope, structs, generics|:
                    continue if fns.names[index] != name or fns.owners[index] != owner
                    continue if fns.param_count[index] != arguments.count
                    matched: mutable bool = arguments.count > 0
                    for position in 0..<arguments.count |matched, index, fns, arguments, local_scope, structs, generics|:
                        continue if not matched
                        declared: ValueType = fns.param_types[fns.param_start[index] + position]
                        actual: ValueType = expression_type(arguments[position], local_scope, fns, structs, generics)
                        if actual.kind == TypeKind.Unmodeled:
                            lit_ok: mutable bool = false
                            match arguments[position]:
                                Expr.IntLit(oia_int_text):
                                    lit_ok <- declared.kind == TypeKind.Signed or declared.kind == TypeKind.Unsigned
                                _:
                                    pass
                            match arguments[position]:
                                Expr.FloatLit(oia_float_text):
                                    lit_ok <- declared.kind == TypeKind.Float
                                _:
                                    pass
                            matched <- lit_ok
                        else:
                            # A `T&` PARAMETER is matched by a plain `T` ARGUMENT. The call
                            # emitter borrows the place implicitly (see the ref-argument path
                            # in emit_direct_call), so `def fail(detail: i64&)` really is a
                            # candidate for `fail(n)` with an i64 local — but comparing Ref
                            # against Signed disqualified it, the candidate set came back
                            # EMPTY, and resolution fell through to "first overload with this
                            # arity".
                            #
                            # That fallback is what made this a real bug rather than a missed
                            # optimisation: elisacore_std's test.elisa declares
                            # `def fail(message: cstr)` and the prelude pulls it into every
                            # program, so any user function named `fail` taking one reference
                            # argument lost the resolution to it, and emitting the argument at
                            # `cstr` then DECLINED — killing every function in the unit. It
                            # cost a long bisect in the project system, where the only symptom
                            # was that routing errors through a shared helper stopped
                            # compiling. stage0 resolves it correctly.
                            #
                            # Only when the argument is not ITSELF a reference: `T&` given a
                            # `T&` already matches on kind, and rewriting that case would let
                            # a `T&&` parameter claim a `T&` argument.
                            expected: mutable ValueType = declared
                            expected <- ref_target_of(declared, structs) if declared.kind == TypeKind.Ref and actual.kind != TypeKind.Ref
                            matched <- false if expected.kind != actual.kind or expected.bits != actual.bits
                    index.i64() return if matched
                return -1

        # How many overloads of `owner::name` overload_index_for_args would accept — i.e. the
        # size of the candidate set it returns the FIRST of. Same predicate, counted instead
        # of short-circuited.
        #
        # A caller that cannot tolerate a guess asks for this first. Static protocol dispatch
        # through a bound type parameter is the case: stage1 models `char`, `int`, `i64` and
        # `isize` as ONE ValueType (Signed/64, see scalar_type_of_name), so the std's
        # `impl Str for char` and `impl Str for i64` are indistinguishable here, and taking
        # the first made `print(42)` answer "*" — chr(42), through the char impl. Measured.
        # A wrong answer is worse than a decline, so an ambiguous set falls through.
        def overload_match_count(fns: FnTable&, owner: sview, name: sview, arguments: darray[Expr]&, local_scope: mutable Scope&, structs: mutable StructTable&, generics: mutable GenericTable&) -> i64 can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic:
                total: mutable i64 = 0
                for index in 0..<fns.names.count |total, fns, owner, name, arguments, local_scope, structs, generics|:
                    continue if fns.names[index] != name or fns.owners[index] != owner
                    continue if fns.param_count[index] != arguments.count
                    matched: mutable bool = arguments.count > 0
                    for position in 0..<arguments.count |matched, index, fns, arguments, local_scope, structs, generics|:
                        continue if not matched
                        declared: ValueType = fns.param_types[fns.param_start[index] + position]
                        actual: ValueType = expression_type(arguments[position], local_scope, fns, structs, generics)
                        if actual.kind == TypeKind.Unmodeled:
                            lit_ok: mutable bool = false
                            match arguments[position]:
                                Expr.IntLit(omc_int_text):
                                    lit_ok <- declared.kind == TypeKind.Signed or declared.kind == TypeKind.Unsigned
                                _:
                                    pass
                            match arguments[position]:
                                Expr.FloatLit(omc_float_text):
                                    lit_ok <- declared.kind == TypeKind.Float
                                _:
                                    pass
                            matched <- lit_ok
                        else:
                            expected: mutable ValueType = declared
                            expected <- ref_target_of(declared, structs) if declared.kind == TypeKind.Ref and actual.kind != TypeKind.Ref
                            matched <- false if expected.kind != actual.kind or expected.bits != actual.bits
                    total <- total + 1 if matched
                return total


            # Does a NON-GENERIC top-level overload of NAME take EXACTLY these argument types?
            #
            # The second half of the overload fix; see decl_line_is_generic for the first. Once
            # the non-generic body is emitted again, calls still have to PREFER it: resolution
            # tries generics first, which is right for `identity(42)` and wrong whenever an
            # exact overload exists. `f(5)` beside `f[T](x: T)` bound to the instantiation and
            # answered 2 where stage0 answers 1.
            #
            # Strict on everything EXCEPT a bare numeric literal: `f(5)` types as Unmodeled (an
            # int literal has no type of its own and adopts its context), so requiring an exact
            # type would disqualify the very call this exists for. A literal therefore matches
            # any parameter of the corresponding numeric family; everything else must match on
            # kind AND bits, and a non-literal argument of unknown type still disqualifies the
            # candidate — a near-match has to fall through to the generic, which is what converts.
        def exact_overload_exists(fns: FnTable&, name: sview, arguments: darray[Expr]&, local_scope: mutable Scope&, structs: mutable StructTable&, generics: mutable GenericTable&) -> bool can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic:
                for index in 0..<fns.names.count |fns, name, arguments, local_scope, structs, generics|:
                    continue if fns.names[index] != name or fns.owners[index] != ""
                    continue if fns.param_count[index] != arguments.count
                    matched: mutable bool = arguments.count > 0
                    for position in 0..<arguments.count |matched, index, fns, arguments, local_scope, structs, generics|:
                        continue if not matched
                        declared: ValueType = fns.param_types[fns.param_start[index] + position]
                        actual: ValueType = expression_type(arguments[position], local_scope, fns, structs, generics)
                        if actual.kind == TypeKind.Unmodeled:
                            literal_ok: mutable bool = false
                            match arguments[position]:
                                Expr.IntLit(ovl_int_text):
                                    literal_ok <- declared.kind == TypeKind.Signed or declared.kind == TypeKind.Unsigned
                                _:
                                    pass
                            match arguments[position]:
                                Expr.FloatLit(ovl_float_text):
                                    literal_ok <- declared.kind == TypeKind.Float
                                _:
                                    pass
                            matched <- literal_ok
                        else:
                            matched <- false if declared.kind != actual.kind or declared.bits != actual.bits
                    true return if matched
                return false

            # Overload-aware lookup: match bare name + owner + declared parameter count
            # (arena / error-out params are not included in `arity`).
        def lookup_function_arity(fns: FnTable&, owner: sview, name: sview, arity: usize) -> LLVMValueRef? can[Abort.Panic]:
            for index in 0..<fns.names.count |fns, owner, name, arity|:
                fns.handles[index] return if fns.names[index] == name and fns.owners[index] == owner and fns.param_count[index] == arity
            return null


        # The index of `name` in the scope, or -1. Scanned back to front so a later
        # (shadowing) declaration wins.
        def lookup_index(local_scope: mutable Scope&, name: sview) -> i64 can[Abort.Panic]:
            index: mutable i64 = local_scope.names.count.i64() - 1
            while index >= 0 |local_scope, name, index|:
                index return if local_scope.names[index.usize()] == name
                index <- index - 1
            return -1


        # The alloca backing `name`, or null when the name is not a local.
        def lookup_slot(local_scope: mutable Scope&, name: sview) -> LLVMValueRef? can[Abort.Panic]:
            can Abort.Panic:
                index: i64 = lookup_index(local_scope, name)
                null return if index < 0
                return local_scope.slots[index.usize()]


            # The declared type of `name`, or Unmodeled when it is not a local.
        def lookup_type(local_scope: mutable Scope&, name: sview) -> ValueType can[Abort.Panic]:
            can Abort.Panic:
                index: i64 = lookup_index(local_scope, name)
                unmodeled_type() return if index < 0
                return copied_type(local_scope.types[index.usize()])


            # Record a local: name, slot and declared type, kept index-parallel.
        def declare_local(local_scope: mutable Scope&, name: sview, slot: LLVMValueRef, value_type: ValueType) -> void can[Abort.Panic, Memory.Allocate]:
            local_scope.names <- local_scope.names.push(name)
            local_scope.slots <- local_scope.slots.push(slot)
            local_scope.types <- local_scope.types.push(value_type)
            local_scope.local_is_mutable <- local_scope.local_is_mutable.push(false)
            local_scope.local_fn_origins <- local_scope.local_fn_origins.push("")
            local_scope.local_declared_arenas <- local_scope.local_declared_arenas.push(zeroed)
            local_scope.local_has_declared_arena <- local_scope.local_has_declared_arena.push(false)
            local_scope.local_parameter_arena_indices <- local_scope.local_parameter_arena_indices.push(-1)


        # Associate the most recently declared parameter with one hidden caller-region slot.
        def mark_last_local_parameter_arena(local_scope: mutable Scope&, arena_index: i64) -> void can[Abort.Panic, Memory.Allocate]:
            return if local_scope.local_parameter_arena_indices.count == 0
            local_scope.local_parameter_arena_indices[local_scope.local_parameter_arena_indices.count - 1.usize()] <- arena_index


        # Pin the most recently declared local to `arena`, the region its `@region` qualifier
        # named. Called from the VarDecl site right after declare_local.
        def mark_last_local_arena(local_scope: mutable Scope&, arena: LLVMValueRef) -> void can[Abort.Panic, Memory.Allocate]:
            return if local_scope.local_has_declared_arena.count == 0
            last_arena_index: usize = local_scope.local_has_declared_arena.count - 1.usize()
            local_scope.local_declared_arenas[last_arena_index] <- arena
            local_scope.local_has_declared_arena[last_arena_index] <- true


        # Record that the most recently declared local ALIASES the named function. Called from
        # the VarDecl site right after declare_local, mirroring mark_last_local_mutable.
        def mark_last_local_fn_origin(local_scope: mutable Scope&, origin: sview) -> void can[Abort.Panic, Memory.Allocate]:
            return if local_scope.local_fn_origins.count == 0
            local_scope.local_fn_origins[local_scope.local_fn_origins.count - 1.usize()] <- origin


        # Record that struct-typed local `local_name`'s fn-typed field `field_name` was
        # initialised from the named function. Called from the VarDecl site, which is the only
        # place that can see a struct literal's field initialisers.
        def mark_local_fn_field_alias(local_scope: mutable Scope&, local_name: sview, field_name: sview, target: sview) -> void can[Abort.Panic, Memory.Allocate]:
            local_scope.fn_field_alias_locals <- local_scope.fn_field_alias_locals.push(local_name)
            local_scope.fn_field_alias_fields <- local_scope.fn_field_alias_fields.push(field_name)
            local_scope.fn_field_alias_targets <- local_scope.fn_field_alias_targets.push(target)


        # The function `local.field` aliases, or "" when none was recorded. Scans BACKWARDS so
        # the most recent declaration of a shadowed local wins, matching local_fn_origin.
        def local_fn_field_alias(local_scope: Scope&, local_name: sview, field_name: sview) -> sview can[Abort.Panic]:
            scan: mutable usize = local_scope.fn_field_alias_locals.count
            while scan > 0.usize() |scan, local_scope, local_name, field_name|:
                scan <- scan - 1
                if local_scope.fn_field_alias_locals[scan] == local_name and local_scope.fn_field_alias_fields[scan] == field_name:
                    return local_scope.fn_field_alias_targets[scan]
            return ""


        # The function a fn-typed local aliases, or "" when it aliases none. Innermost wins,
        # matching lookup_type's shadowing rule.
        def local_fn_origin(local_scope: Scope&, name: sview) -> sview can[Abort.Panic]:
            scan: mutable usize = local_scope.names.count
            while scan > 0.usize() |scan, local_scope, name|:
                scan <- scan - 1
                if local_scope.names[scan] == name:
                    "" return if scan >= local_scope.local_fn_origins.count
                    return local_scope.local_fn_origins[scan]
            return ""


            # Flip the MOST RECENTLY declared local's mutability bit to true. Called once,
            # right after declare_local, only at the VarDecl site whose own type annotation
            # spells `mutable` on a Ref type -- see the Scope.local_is_mutable field comment
            # for why every other declare_local call site is left at the pushed `false`.
        def mark_last_local_mutable(local_scope: mutable Scope&) -> void can[Abort.Panic]:
            last_index: i64 = local_scope.local_is_mutable.count.i64() - 1
            return if last_index < 0
            local_scope.local_is_mutable[last_index.usize()] <- true


            # Whether NAME's local binding was declared with the `mutable` keyword on its own
            # type annotation. False for a name that isn't a local at all (lookup_index < 0).
        def local_binding_is_mutable(local_scope: mutable Scope&, name: sview) -> bool can[Abort.Panic]:
            index: i64 = lookup_index(local_scope, name)
            false return if index < 0
            return local_scope.local_is_mutable[index.usize()]


        # The base VARIABLE a container-mutating chain is rooted at: `xs` for `xs.push`,
        # `structs` for `structs.binding_names.push`, `rows[i]` -> `rows`. "" when the root
        # is not a named local (a call result, a literal), in which case the ambient arena
        # is the only answer available.
        def growth_root_name(expression: Expr) -> sview can[Abort.Panic]:
            can Abort.Panic:
                return match expression:
                    Expr.Ident(gr_name, gr_line): gr_name
                    Expr.Field(gr_object, gr_field, gr_field_line): growth_root_name(gr_object)
                    Expr.Index(gr_head, gr_index, gr_index_line): growth_root_name(gr_head)
                    Expr.Paren(gr_inner, gr_paren_line): growth_root_name(gr_inner)
                    _: ""


            # The arena a container rooted at `expression` GROWS from. stage0's rule, measured:
            # growth allocates from the arena the container was DECLARED under, not the arena
            # that happens to be ambient at the push site. Inside `region scratch(4096):` a push
            # to a darray declared OUTSIDE the block still calls `arena_alloc(ptr %__auto, …)`;
            # using the block's arena instead hands back memory that is freed at the block's
            # end — that use-after-free is what crashed the compiler itself on every propagating
            # `try` to a generic (error_callee_target infers inside `region scratch:` while
            # pushing into the caller's `structs`/`generics` tables).
            #
            # Resolution: the innermost region frame whose `start` the root's declaration index
            # reaches owns it; a root declared before EVERY frame gets the outermost frame's
            # `outer` arena; no frames (or no named root) is the ambient runtime.arena — the
            # pre-existing behavior, and correct outside region blocks.
        def growth_arena_for(expression: Expr, local_scope: mutable Scope&, runtime: Runtime&) -> LLVMValueRef can[Abort.Panic]:
            can Abort.Panic:
                ga_root: sview = growth_root_name(expression)
                runtime.arena return if ga_root == ""
                ga_found: mutable i64 = -1
                for ga_index in 0..<local_scope.names.count |ga_found, local_scope, ga_root|:
                    ga_found <- ga_index.i64() if local_scope.names[ga_index] == ga_root
                runtime.arena return if ga_found < 0
                # A reference parameter aliases storage owned by the caller. Its growth must
                # never fall back to the callee's scratch arena, even when the function also
                # has local region-backed temporaries.
                ga_type: ValueType = lookup_type(local_scope, ga_root)
                if ga_type.kind == TypeKind.Ref:
                    if ga_found.usize() < local_scope.local_parameter_arena_indices.count:
                        parameter_arena_index: i64 = local_scope.local_parameter_arena_indices[ga_found.usize()]
                        if parameter_arena_index >= 0 and parameter_arena_index.usize() < runtime.caller_arenas.count:
                            return runtime.caller_arenas[parameter_arena_index.usize()]
                    return runtime.caller_arena if not llvm_value_is_null(runtime.caller_arena)
                    return runtime.arena
                # An EXPLICIT `@region` pin wins over the lexical frame rule below: the
                # declaration named the arena, so growth must go to the same one the initial
                # allocation did.
                if ga_found.usize() < local_scope.local_has_declared_arena.count:
                    local_scope.local_declared_arenas[ga_found.usize()] return if local_scope.local_has_declared_arena[ga_found.usize()]
                ga_frame: mutable i64 = local_scope.region_frame_starts.count.i64() - 1
                while ga_frame >= 0 |ga_frame, ga_found, local_scope|:
                    local_scope.region_frame_arenas[ga_frame.usize()] return if ga_found >= local_scope.region_frame_starts[ga_frame.usize()].i64()
                    ga_frame <- ga_frame - 1
                local_scope.region_frame_outers[0] return if local_scope.region_frame_outers.count > 0
                return runtime.arena


            # `runtime` with its arena swapped to the declaration arena of `expression`'s root —
            # what a growth site (push/extend/resize) must emit its reallocation against.
        def growth_runtime_for(expression: Expr, local_scope: mutable Scope&, runtime: Runtime&) -> Runtime can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic:
                grown: mutable Runtime = copied_runtime(runtime)
                grown.arena <- growth_arena_for(expression, local_scope, runtime)
                return grown


            # The hidden arena a CALL threads to a callee that grows a container. stage0 passes
            # the arena of the growable REF argument's DECLARATION, not the ambient one:
            # `region scratch: helper(outer)` emits `call @helper(ptr %outer, ptr %__auto)` —
            # measured, -emit llvm. The callee's growth of `outer` must outlive `scratch`.
            #
            # Resolution: the first argument whose root is a named container-carrying local
            # (darray, struct, or a ref to one) decides; a call with no such argument keeps the
            # ambient arena, which is also the correct region for a RETURNED container built
            # inside a `region` block. With no region frames the ambient arena already equals
            # every declaration arena, so this is the pre-existing behavior at zero cost.
            # Among several container arguments the OUTERMOST declaration wins: a callee that
            # grows two tables gets the longer-lived arena, so nothing it stores outlives its
            # backing (the shorter-lived data at worst lives a little longer). Picking the FIRST
            # argument instead handed generic_return_type(name, inferred, generics, structs) the
            # scratch region `inferred` lives in, and every push into `structs` died with it.
        def call_site_arena(arguments: darray[Expr]&, local_scope: mutable Scope&, runtime: Runtime&) -> LLVMValueRef can[Abort.Panic]:
            can Abort.Panic:
                if local_scope.region_frame_starts.count == 0:
                    for no_frame_argument in arguments |local_scope, runtime|:
                        no_frame_root: sview = growth_root_name(no_frame_argument)
                        continue if no_frame_root == ""
                        no_frame_type: ValueType = lookup_type(local_scope, no_frame_root)
                        if no_frame_type.kind == TypeKind.Ref:
                            return growth_arena_for(no_frame_argument, local_scope, runtime)
                    return runtime.arena
                best_level: mutable i64 = 2147483647
                best_arena: mutable LLVMValueRef = zeroed
                have_best: mutable bool = false
                for argument in arguments |local_scope, runtime, best_level, best_arena, have_best|:
                    csa_root: sview = growth_root_name(argument)
                    continue if csa_root == ""
                    csa_type: ValueType = lookup_type(local_scope, csa_root)
                    csa_kind: TypeKind = csa_type.kind
                    continue if csa_kind != TypeKind.DArray and csa_kind != TypeKind.Struct and csa_kind != TypeKind.Ref
                    csa_found: mutable i64 = -1
                    for csa_index in 0..<local_scope.names.count |csa_found, local_scope, csa_root|:
                        csa_found <- csa_index.i64() if local_scope.names[csa_index] == csa_root
                    continue if csa_found < 0
                    # The frame that owns this argument's declaration: -1 = before every frame.
                    csa_level: mutable i64 = -1
                    for csa_frame in 0..<local_scope.region_frame_starts.count |csa_level, csa_found, local_scope|:
                        csa_level <- csa_frame.i64() if csa_found >= local_scope.region_frame_starts[csa_frame].i64()
                    if csa_level < best_level:
                        best_level <- csa_level
                        best_arena <- growth_arena_for(argument, local_scope, runtime)
                        have_best <- true
                best_arena return if have_best
                return runtime.arena


            # The slot an `is` test must store its binding into.
            #
            # Inside a condition, every `is` test binding the same name at the same LLVM type
            # shares ONE entry-block alloca. That is what makes an or-chain correct: only the
            # alternative that actually matched runs, so only it stores — and the body reads the
            # single slot it wrote. Per-test slots would leave the body reading whichever slot
            # was declared last, which for a short-circuited alternative was never written.
            #
            # The slot is always an ENTRY alloca so it dominates the body, and it is always a
            # FRESH slot the first time a name appears in this condition — never an outer local
            # of the same name, so a binding that shadows leaves the shadowed variable intact.
            # Outside a condition (depth 0) each test just gets its own entry slot, as before.
            # The scope is a flat, append-only list scanned BACKWARDS, so a declaration left in
            # place after its block ends makes a LATER use of the same name resolve to that
            # block's slot — which the later path never stored. That is a miscompile, not a
            # lookup nicety: `emit_statement_loops` declares `int64_type` inside the darray-`for`
            # branch, and the range-`for` branch BELOW it then allocated with that undominated
            # slot. gen2 died building the compiler on exactly that (LLVMBuildAlloca on a garbage
            # type). stage0 scopes with a parent chain; the flat list gets the same effect by
            # truncating back to the mark taken when the block opened.
        # The darray type an unannotated COMPREHENSION declaration produces:
        # `xs = [item + 1 for item in items if item > 0]`.
        #
        # expression_type answers Unmodeled for a comprehension (its type comes from context,
        # and here there is none), and literal_container_type only reads Array literals -- so
        # the declaration declined even though the annotated form works. The element type is
        # the PROJECTION's type with the binder in scope, so the binder is bound to the
        # iterable's element type for exactly the length of that query and then popped.
        #
        # The binder's slot is `zeroed`: expression_type reads TYPES only, and the binding is
        # removed before anything can emit against it.
        def comprehension_result_type(comprehension_var: sview, iterable: Expr, body: Expr, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&) -> ValueType can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                unmodeled_type() return if body is Expr.Absent
                element: mutable ValueType = unmodeled_type()
                source: ValueType = iterable_darray_type(iterable, local_scope, fns, structs, generics)
                if source.kind == TypeKind.DArray:
                    element <- darray_element_of(source, structs)
                else:
                    match iterable:
                        Expr.Binary(range_lo, range_operator, range_hi, _):
                            # `[index for index in 1..<count]` — a RANGE source. The binder's type is
                            # the range's, taken from whichever bound has one (a bare literal has none).
                            if range_operator == TokenKind.RangeLt or range_operator == TokenKind.RangeLe:
                                element <- expression_type(range_hi, local_scope, fns, structs, generics)
                                element <- expression_type(range_lo, local_scope, fns, structs, generics) if element.kind == TypeKind.Unmodeled
                                element <- ValueType{kind: TypeKind.Signed, bits: 64} if element.kind == TypeKind.Unmodeled
                        _:
                            pass
                unmodeled_type() return if element.kind == TypeKind.Unmodeled
                probe_mark: usize = scope_mark(local_scope)
                declare_local(local_scope, comprehension_var, zeroed, element)
                projected: ValueType = expression_type(body, local_scope, fns, structs, generics)
                scope_restore(local_scope, probe_mark)
                unmodeled_type() return if projected.kind == TypeKind.Unmodeled
                return intern_darray_type(projected, structs)


        def scope_mark(local_scope: mutable Scope&) -> usize can[Abort.Panic]:
            return local_scope.names.count


        def scope_restore(local_scope: mutable Scope&, mark: usize) -> void can[Abort.Panic]:
            can Abort.Panic:
                while local_scope.names.count > mark |local_scope|:
                    _ = local_scope.names.pop()
                    _ = local_scope.slots.pop()
                    _ = local_scope.types.pop()


            # The slot already opened for `name` at `slot_type` in the current condition, or null.
        def cond_bind_slot_of(structs: mutable StructTable&, name: sview, slot_type: LLVMTypeRef) -> LLVMValueRef? can[Abort.Panic]:
            null return if structs.cond_bind_depth == 0
            for index in 0..<structs.cond_bind_names.count |structs, name, slot_type|:
                structs.cond_bind_slots[index] return if structs.cond_bind_names[index] == name and structs.cond_bind_types[index] == slot_type
            return null


        def bind_is_slot(local_scope: mutable Scope&, structs: mutable StructTable&, name: sview, value_type: ValueType, slot_type: LLVMTypeRef, builder: LLVMBuilderRef) -> LLVMValueRef can[Abort.Panic, Memory.Allocate]:
            if cond_bind_slot_of(structs, name, slot_type) is shared_slot:
                return shared_slot
            storage: mutable darray[u8] = []
            slot: LLVMValueRef = build_entry_alloca(builder, slot_type, sview_to_cstr(name, storage))
            declare_local(local_scope, name, slot, value_type)
            if structs.cond_bind_depth > 0:
                structs.cond_bind_names <- structs.cond_bind_names.push(name)
                structs.cond_bind_slots <- structs.cond_bind_slots.push(slot)
                structs.cond_bind_types <- structs.cond_bind_types.push(slot_type)
            return slot


        # The declared type of function `name`'s parameter `position`, or Unmodeled.
        # Emitting each argument at its parameter's type is what makes a literal argument
        # adopt the parameter type instead of defaulting to i64.
        def param_type_of(fns: FnTable&, owner: sview, name: sview, position: usize) -> ValueType can[Abort.Panic]:
            for index in 0..<fns.names.count |fns, owner, name, position|:
                if fns.names[index] == name and fns.owners[index] == owner:
                    unmodeled_type() return if position >= fns.param_count[index]
                    return copied_type(fns.param_types[fns.param_start[index] + position])
            return unmodeled_type()


        def param_type_count(fns: FnTable&, owner: sview, name: sview) -> usize can[Abort.Panic]:
            for index in 0..<fns.names.count |fns, owner, name|:
                fns.param_count[index] return if fns.names[index] == name and fns.owners[index] == owner
            return 0


        # Return the source-argument index that supplies parameter `wanted`. Positional
        # arguments fill the next unassigned parameter; labelled arguments select by name.
        # `first_position` is 1 for UFCS calls because parameter 0 is the implicit receiver.
        # An entirely empty name vector is the canonical AST representation for an all-positional
        # call built by a lowering pass (for example `machine from`'s enum-state constructor),
        # so it must not be read as an argument-count mismatch. The old loop returned -1 for that
        # shape, making every lowered multi-field constructor decline while the same source-written
        # constructor compiled.
        def named_argument_index(argument_names: darray[sview]&, parameter_names: darray[sview]&, parameter_start: usize, parameter_count: usize, first_position: usize, wanted: usize) -> i64 can[Abort.Panic, Memory.Allocate]:
            -1 return if wanted < first_position or wanted >= parameter_count
            if argument_names.count == 0:
                return (wanted - first_position).i64()
            assigned: mutable darray[bool] = [false for _slot in 0..<parameter_count]
            assigned[0] <- true if first_position == 1 and parameter_count > 0
            next_pos: mutable usize = first_position
            for argument_index in 0..<argument_names.count |assigned, next_pos, argument_names, parameter_names, parameter_start, parameter_count, first_position, wanted|:
                argument_name: sview = argument_names[argument_index]
                selected: mutable usize = parameter_count
                if argument_name != "":
                    for parameter_index in first_position..<parameter_count |selected, argument_name, parameter_names, parameter_start|:
                        if parameter_names[parameter_start + parameter_index] == argument_name:
                            selected <- parameter_index
                            break
                else:
                    while next_pos < parameter_count and assigned[next_pos] |next_pos, assigned|:
                        next_pos <- next_pos + 1
                    selected <- next_pos
                    next_pos <- next_pos + 1 if next_pos < parameter_count
                argument_index.i64() return if selected == wanted and selected < parameter_count and not assigned[selected]
                -1 return if selected >= parameter_count or assigned[selected]
                assigned[selected] <- true
            return -1


        # Generic declarations retain their parameter names in the AST rather than in FnTable.
        # Use the same source-to-parameter assignment rules as ordinary calls.
        def generic_named_argument_index(argument_names: darray[sview]&, parameters: darray[ParamDecl], wanted: usize) -> i64 can[Abort.Panic, Memory.Allocate]:
            assigned: mutable darray[bool] = [false for _slot in 0..<parameters.count]
            next_pos: mutable usize = 0
            for argument_index in 0..<argument_names.count |assigned, next_pos, argument_names, parameters, wanted|:
                argument_name: sview = argument_names[argument_index]
                selected: mutable usize = parameters.count
                if argument_name != "":
                    for parameter_index in 0..<parameters.count |selected, argument_name, parameters|:
                        if parameters[parameter_index].name == argument_name:
                            selected <- parameter_index
                            break
                else:
                    while next_pos < parameters.count and assigned[next_pos] |next_pos, assigned|:
                        next_pos <- next_pos + 1
                    selected <- next_pos
                    next_pos <- next_pos + 1 if next_pos < parameters.count
                argument_index.i64() return if selected == wanted and selected < parameters.count and not assigned[selected]
                -1 return if selected >= parameters.count or assigned[selected]
                assigned[selected] <- true
            return -1


        # C default argument promotions for the unnamed tail of a variadic call.
        def c_variadic_promoted_type(value_type: ValueType) -> ValueType can[Abort.Panic]:
            ValueType{kind: TypeKind.Signed, bits: 32} return if value_type.kind == TypeKind.Bool
            ValueType{kind: TypeKind.Signed, bits: 32} return if (value_type.kind == TypeKind.Signed or value_type.kind == TypeKind.Unsigned) and value_type.bits < 32
            ValueType{kind: TypeKind.Float, bits: 64} return if value_type.kind == TypeKind.Float and value_type.bits == 32
            return copied_type(value_type)


        # The declared return type of `name`, or Unmodeled when the module has no such
        # function.
        def lookup_return_type(fns: FnTable&, owner: sview, name: sview) -> ValueType can[Abort.Panic]:
            for index in 0..<fns.names.count |fns, owner, name|:
                copied_type(fns.returns[index]) return if fns.names[index] == name and fns.owners[index] == owner
            return unmodeled_type()


        # The type an expression yields, WITHOUT emitting anything.
        #
        # Bottom-up, and deliberately partial: an integer LITERAL has no type of its own
        # (Unmodeled) and adopts whatever its context supplies. That is why the emitters
        # thread an `expected` type downward — `a: u8 = 200` must make 200 a u8, not an
        # i64 that is then silently truncated.
        def expression_type(expression: Expr, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&) -> ValueType can[Abort.Panic]:
            can Abort.Panic:
                return expression_type_depth(expression, local_scope, fns, structs, generics, 0)

        # The recursive body of `expression_type`, with an explicit DEPTH so a pathologically
        # left-nested expression (`1 + 1 + 1 + … ` thousands deep — adversarial input, not
        # anything a real program writes) cannot blow up. Every caller OUTSIDE this function
        # goes through the depth=0 wrapper above; every self-recursive call below increments
        # depth by one. Without the cap, a chain of N binary operators cost O(N^2): this
        # function is called once per level of the emitter's own recursion into `binary_left`
        # (see emit_expression_binary_tail), and at EACH of those N levels this function walks
        # the (still O(N)-long) remaining left spine again. Measured: an N=20000 chain took
        # 44s and one nearly 3x deeper N=50000 chain still had not finished after 120s wall
        # time (all CPU, not I/O) — a hang, not a slow-but-bounded compile. A depth-only cap
        # bounds the STACK but not the total WORK: with the cap at 1000, N=300000+ chains still
        # took >90s (still effectively O(N * cap)). 200 keeps the worst case cheap while
        # remaining an order of magnitude past any nesting a hand-written or generated
        # expression plausibly reaches — self-hosting this compiler is the check that it
        # never fires on real code. Past the cap this answers Unmodeled, the same "give up,
        # let the caller fall back to its own context/expected type" answer literals already
        # give — safe because no genuine expression nests anywhere near this deep; only an
        # adversarial one does.
        def expression_type_depth(expression: Expr, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, depth: i64) -> ValueType can[Abort.Panic]:
            unmodeled_type() return if depth > 200
            match expression:
                Expr.Ident(ident_name, ident_line):
                    # A LOCAL shadows a global const, so the scope is consulted first.
                    local_type: ValueType = lookup_type(local_scope, ident_name)
                    local_type return if local_type.kind != TypeKind.Unmodeled
                    extern_global_index: i64 = extern_global_index_of(structs, ident_name)
                    copied_type(structs.extern_global_types[extern_global_index.usize()]) return if extern_global_index >= 0
                    mutable_global_index: i64 = mutable_global_index_of(structs, ident_name)
                    copied_type(structs.mutable_global_types[mutable_global_index.usize()]) return if mutable_global_index >= 0
                    const_index: i64 = const_index_of(structs, ident_name)
                    copied_type(structs.const_types[const_index.usize()]) return if const_index >= 0 and structs.const_resolved[const_index.usize()]
                    # A global const AGGREGATE is not scalar-folded but still has a known type.
                    copied_type(structs.const_types[const_index.usize()]) return if const_index >= 0 and structs.const_global_ok[const_index.usize()]
                    return unmodeled_type()
                _:
                    pass
            match expression:
                Expr.Paren(paren_inner, paren_line):
                    return expression_type_depth(paren_inner, local_scope, fns, structs, generics, depth + 1)
                _:
                    pass
            # A move has the moved value's type: it transfers ownership, not representation.
            match expression:
                Expr.Move(moved_value, move_line):
                    return expression_type_depth(moved_value, local_scope, fns, structs, generics, depth + 1)
                _:
                    pass
            match expression:
                Expr.BoolLit(bool_value):
                    return ValueType{kind: TypeKind.Bool, bits: 1}
                _:
                    pass
            match expression:
                Expr.CharLit(char_text):
                    return ValueType{kind: TypeKind.Signed, bits: 64}
                _:
                    pass
            match expression:
                Expr.Slice(slice_object, slice_start_expr, slice_end_expr, slice_line):
                    # A slice of a CONTAINER is a `view[T]`, not a string view. Typing every slice
                    # as SView was right only for the cstr/sview receivers it was written for: it
                    # made `whole[0:4]` unusable as a GENERIC argument, because T could not be
                    # inferred from an SView (`take[T](a: view[T], …)` declined, while the same
                    # slice bound to a local first, or passed to a NON-generic callee, worked).
                    slice_receiver: mutable ValueType = expression_type_depth(slice_object, local_scope, fns, structs, generics, depth + 1)
                    slice_receiver <- ref_target_of(slice_receiver, structs) if slice_receiver.kind == TypeKind.Ref
                    if slice_receiver.kind == TypeKind.DArray:
                        return intern_view_type(darray_element_of(slice_receiver, structs), structs)
                    if slice_receiver.kind == TypeKind.View:
                        return slice_receiver
                    if slice_receiver.kind == TypeKind.Array:
                        return intern_view_type(copied_type(structs.array_elements[slice_receiver.bits.usize()]), structs)
                    return ValueType{kind: TypeKind.SView, bits: 0}
                _:
                    pass
            # A STRING literal has a type of its own (cstr) — unlike an int literal, which
            # defers to its context. There is no other string type in the subset for it to
            # adopt, and stage0 gives `"hi"` a cstr regardless of context.
            match expression:
                Expr.StringLit(string_text):
                    return ValueType{kind: TypeKind.CStr, bits: 0}
                _:
                    pass
            # A FLOAT literal, like an int literal, defers to its context (`x: f32 = 1.5`),
            # so it reports Unmodeled here rather than pinning itself to f64.
            match expression:
                Expr.Unary(unary_operator, unary_operand, unary_line):
                    # `not x` is a bool whatever `x` is; `-x` / `~x` keep the operand's type.
                    ValueType{kind: TypeKind.Bool, bits: 1} return if unary_operator == TokenKind.Not
                    # `!id` yields the handle's BACKING integer, not a bool (see the emit site).
                    expression_type_depth(unary_operand, local_scope, fns, structs, generics, depth + 1) return if unary_operator == TokenKind.Bang
                    # `&place` is a reference to the place's type.
                    if unary_operator == TokenKind.Ampersand:
                        place_type: ValueType = expression_type_depth(unary_operand, local_scope, fns, structs, generics, depth + 1)
                        unmodeled_type() return if place_type.kind == TypeKind.Unmodeled
                        return intern_ref_type(place_type, structs)
                    return expression_type_depth(unary_operand, local_scope, fns, structs, generics, depth + 1)
                _:
                    pass
            # A value `if` has the type of its value branches. Most callers already provide an
            # expected type, so leaving this form unmodeled appeared harmless until it became a
            # postfix cast receiver: `(value if condition else fallback).i64()` resolves the
            # receiver before the cast supplies a target, and the old fallback defaulted the
            # whole conditional to i64 even when its known branch was f64. The emitter then tried
            # to store an f64 branch into an i64 result slot and silently declined the function,
            # leaving an unresolved symbol for stage1's caller. Infer the common branch type;
            # literals remain unmodeled and therefore adopt the other branch's type, matching the
            # existing literal-context rule.
            match expression:
                Expr.If(if_condition, if_then, if_else, if_line):
                    if_then_type: ValueType = expression_type_depth(if_then, local_scope, fns, structs, generics, depth + 1)
                    if_else_type: ValueType = expression_type_depth(if_else, local_scope, fns, structs, generics, depth + 1)
                    if if_then_type.kind != TypeKind.Unmodeled and if_else_type.kind == TypeKind.Unmodeled:
                        return if_then_type
                    if if_else_type.kind != TypeKind.Unmodeled and if_then_type.kind == TypeKind.Unmodeled:
                        return if_else_type
                    if if_then_type.kind == if_else_type.kind and if_then_type.bits == if_else_type.bits:
                        return if_then_type
                    return unmodeled_type()
                _:
                    pass
            match expression:
                Expr.Binary(binary_left, binary_operator, binary_right, binary_line):
                    # A comparison, logical, `is` narrowing, or `in` membership yields bool
                    # regardless of operands.
                    ValueType{kind: TypeKind.Bool, bits: 1} return if binary_operator == TokenKind.Is
                    ValueType{kind: TypeKind.Bool, bits: 1} return if binary_operator == TokenKind.In
                    ValueType{kind: TypeKind.Bool, bits: 1} return if int_predicate_of(binary_operator) >= 0
                    ValueType{kind: TypeKind.Bool, bits: 1} return if binary_operator == TokenKind.And or binary_operator == TokenKind.Or
                    # Arithmetic keeps the operands' type: take whichever side is known, since
                    # a literal contributes nothing.
                    left_type: ValueType = expression_type_depth(binary_left, local_scope, fns, structs, generics, depth + 1)
                    # `+`/`-` on a SCALAR ref is VALUE arithmetic — deref the referent and add —
                    # so the expression's type is the REFERENT, not the ref. The emitter already
                    # lowers it that way (codegen_expr_binary_tail: only `u8&`/`void&` GEP, every
                    # other referent derefs and value-adds); this is the same rule at the TYPE
                    # level, which was missing.
                    #
                    # Without it a generic `p + n` stayed typed `T&` after instantiation, so a
                    # following `.usize()` treated the correctly-computed SUM as an ADDRESS —
                    # `inttoptr` then `load` — and faulted. stage0 answers 45 for `usize& + 5`;
                    # stage1 answered 139. Monomorphization means the instantiated type governs,
                    # so the concrete referent decides this, exactly as for a concrete `usize&`.
                    if binary_operator == TokenKind.Plus or binary_operator == TokenKind.Minus:
                        if left_type.kind == TypeKind.Ref:
                            arith_referent: ValueType = ref_target_of(left_type, structs)
                            arith_is_byte_pointer: bool = arith_referent.kind == TypeKind.Void or (arith_referent.kind == TypeKind.Unsigned and arith_referent.bits == 8)
                            arith_referent return if not arith_is_byte_pointer and (is_integer_type(arith_referent) or arith_referent.kind == TypeKind.Bool or arith_referent.kind == TypeKind.Float)
                    left_type return if left_type.kind != TypeKind.Unmodeled
                    return expression_type_depth(binary_right, local_scope, fns, structs, generics, depth + 1)
                _:
                    pass
            # `x.cast[T]` — a reinterpret cast has the target type.
            match expression:
                Expr.Index(cast_type_head, cast_type_arg, cast_type_line):
                    match cast_type_head:
                        Expr.Field(cast_type_source, cast_type_method, cast_type_method_line):
                            if cast_type_method == "cast":
                                return annotation_value_type(cast_type_arg, structs)
                        _:
                            pass
                _:
                    pass
            # `p.call_as[fn(A) -> R](args)` has the fn type's RETURN type. Without this the
            # DISCARD path (`_ = entry.call_as[…](arg)`, the runtime's only call site) saw
            # Unmodeled and fell back to i64, which then demanded a bogus pointer→integer
            # conversion of a `void&` result and declined the whole statement.
            match expression:
                Expr.Call(ca_type_callee, ca_type_args, ca_type_names, ca_type_call_line):
                    match ca_type_callee:
                        Expr.Index(ca_type_index_head, ca_type_fn_expr, ca_type_index_line):
                            match ca_type_index_head:
                                Expr.Field(ca_type_object, ca_type_method, ca_type_method_line):
                                    if ca_type_method == "call_as":
                                        return fn_return_type_of(annotation_value_type(ca_type_fn_expr, structs), structs)
                                _:
                                    pass
                        _:
                            pass
                _:
                    pass
            # `xs[i]` — an index READ yields the element type of an array, a darray, OR a
            # `Struct&` used as a C-style pointer base (`items[i]` on a `DictBucket[K,T]&`).
            match expression:
                Expr.Index(indexed_object, index_expression, index_line):
                    indexed_type: ValueType = expression_type_depth(indexed_object, local_scope, fns, structs, generics, depth + 1)
                    # A `Flags[T]` bit test is a BOOL, not the struct or its field. Without this the
                    # value binding typed as the struct and `if value[F.X]:` declined outright,
                    # since emit_condition requires the condition to resolve to Bool.
                    ValueType{kind: TypeKind.Bool, bits: 1} return if flags_bit_test_ordinal(indexed_type, index_expression, structs) >= 0
                    # `frozen[2]` — indexing a packed STORE by ORDINAL yields a node HANDLE of
                    # the store's enum, which is what `ctx_packed_store_index_at` returns.
                    if indexed_type.kind == TypeKind.PackedStore:
                        packed_store_root: usize = indexed_type.bits.usize()
                        ValueType{kind: TypeKind.PackedEnum, bits: packed_store_root.u32()} return if packed_store_root < structs.packed_names.count
                    # A byte read from a string (cstr / view[u8]) is an i64 (the runtime index
                    # helpers return i64), matching stage0.
                    ValueType{kind: TypeKind.Signed, bits: 64} return if indexed_type.kind == TypeKind.CStr or indexed_type.kind == TypeKind.SView
                    darray_element_of(indexed_type, structs) return if indexed_type.kind == TypeKind.DArray
                    # `v[i]` on a VIEW is its ELEMENT. There was no View case here at all, so an
                    # indexed view had no type — which is why `state.tokens[0].kind` could not even
                    # find the element's struct to take a field from.
                    view_element_of(indexed_type, structs) return if indexed_type.kind == TypeKind.View
                    if indexed_type.kind == TypeKind.Ref:
                        ref_indexed_element: ValueType = ref_target_of(indexed_type, structs)
                        ref_indexed_element return if ref_indexed_element.kind == TypeKind.Struct
                        # `p[i]` where `p: T&` is a ref to a NUMERIC scalar used as a pointer base
                        # (Slice's `p: T& = base.cast[T&]; p[i]` / `&p[lo]`): the element IS that scalar.
                        ref_indexed_element return if ref_indexed_element.kind == TypeKind.Signed or ref_indexed_element.kind == TypeKind.Unsigned or ref_indexed_element.kind == TypeKind.Float
                        # `argv[i]` where `argv: cstr&&` — a C `char**`. A POINTER-sized element
                        # indexes exactly like a scalar one (stage0 emits the same `getelementptr
                        # ptr` + `load ptr`), and the element IS that pointer type. Without this the
                        # emitter's matching branch was unreachable and every `T&&` index declined.
                        ref_indexed_element return if ref_indexed_element.kind == TypeKind.Ref or ref_indexed_element.kind == TypeKind.CStr
                        # `da[i]` where `da: darray[T]&` — a borrowed darray param: the element is the
                        # darray's element (so `&da[i]` types as a ref to it, which slice() needs).
                        darray_element_of(ref_indexed_element, structs) return if ref_indexed_element.kind == TypeKind.DArray
                        # `pts[i]` where `pts: T[N]&` — a borrowed reference to a single fixed-size
                        # array (the standard borrowed-array-parameter shape). Without this the
                        # catch-all `array_element_of(indexed_type, ...)` below ran on the RAW Ref
                        # type (not its Array target) and answered Unmodeled — silently, since
                        # array_element_of just declines a non-Array input rather than erroring.
                        # That made every type-dependent use of `pts[i]` (an explicit `.i64()` cast,
                        # in particular) decline, AND meant the codegen-level read of the same
                        # expression (emit_expression_index_fields's sibling Ref+Array branch) had
                        # no correctly-typed `expected` to convert against — the two gaps together
                        # let `ys[1] + zs[1].i64()` (i64[3]& and u8[3]& in one function) build an
                        # LLVM module with a WIDTH-MISMATCHED `sadd.with.overflow.i64(i64, i8)`
                        # call and silently answer wrong (200 instead of 202) rather than crash or
                        # decline. Mirrors the DArray-behind-Ref case just above.
                        array_element_of(ref_indexed_element, structs) return if ref_indexed_element.kind == TypeKind.Array
                    # `found[0]` where `found: T&?` is an optional ref to a numeric scalar (narrowed
                    # non-null): the element is that scalar. index_map_find_index reads it this way.
                    if indexed_type.kind == TypeKind.Optional:
                        opt_indexed_payload: ValueType = optional_payload_of(indexed_type, structs)
                        if opt_indexed_payload.kind == TypeKind.Ref:
                            opt_indexed_elem: ValueType = ref_target_of(opt_indexed_payload, structs)
                            opt_indexed_elem return if opt_indexed_elem.kind == TypeKind.Signed or opt_indexed_elem.kind == TypeKind.Unsigned or opt_indexed_elem.kind == TypeKind.Float
                    return array_element_of(indexed_type, structs)
                _:
                    pass
            # `p.x` — a field READ has the field's declared type. (A cast `x.u8()` is a
            # Field under a Call, handled below, so a bare Field is always a field read.)
            # `Color.Green` / `Lexer::TokenKind.Ident` has the enum's BACKING type.
            match expression:
                Expr.Field(enum_head, enum_member, enum_head_line):
                    enum_head_name: mutable sview = ""
                    match enum_head:
                        Expr.Ident(enum_ident_name, enum_ident_line):
                            enum_head_name <- enum_ident_name
                        _:
                            pass
