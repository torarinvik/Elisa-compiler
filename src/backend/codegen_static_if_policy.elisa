# Pure policy for selecting a static-if row. Kept separate from LLVM/backend state so the
# proof assistant can include and verify the exact policy used by selected_static_if_rows.
module StaticIfPolicy:
    public:
        const enum Action of u8:
            Skip
            SelectFallback
            EvaluateCondition

        def row_action(kind: StaticIfBranch::Kind, previously_satisfied: bool) -> Action:
            ensure kind == StaticIfBranch::Kind.ChainHead implies result == Action.EvaluateCondition
            ensure kind == StaticIfBranch::Kind.ChainContinuation and not previously_satisfied implies result == Action.EvaluateCondition
            ensure kind == StaticIfBranch::Kind.Fallback and not previously_satisfied implies result == Action.SelectFallback
            ensure previously_satisfied and kind != StaticIfBranch::Kind.ChainHead implies result == Action.Skip
            return Action.Skip if previously_satisfied and kind != StaticIfBranch::Kind.ChainHead
            return Action.EvaluateCondition if kind == StaticIfBranch::Kind.ChainHead or kind == StaticIfBranch::Kind.ChainContinuation
            return Action.SelectFallback if kind == StaticIfBranch::Kind.Fallback
            return Action.Skip

        def condition_selects_branch(condition_ok: bool, condition_value: i64) -> bool:
            ensure result == (condition_ok and condition_value != StaticIfBranch::CONDITION_FALSE_VALUE)
            return condition_ok and condition_value != StaticIfBranch::CONDITION_FALSE_VALUE
