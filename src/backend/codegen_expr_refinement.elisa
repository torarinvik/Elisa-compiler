# Stage1 backend — `refine … as …` and `catch` in EXPRESSION position. Both narrow a value and
# both have to produce a result on every path, which is why they are the two longest branches
# of the expression emitter. Part of `module Backend` (see codegen.elisa).

extend Backend:
    private:
        def emit_expression_refinement_forms(expression: Expr, expected: ValueType, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef, handled: mutable bool&) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            match expression:
                Expr.Refinement(try_fallback, try_guarded, try_line):
                    # An ERROR-returning callee must be lowered through its out-param ABI FIRST:
                    # its expression_type is the PAYLOAD, so the optional path below would
                    # otherwise treat the i32 status as an optional aggregate.
                    if emit_try_else_error_call(try_guarded, try_fallback, local_scope, fns, structs, generics, runtime, m, ctx, builder) is try_else_error_value:
                        return try_else_error_value
                    # `get OPT else FALLBACK` — optional unwrap to expression value (self-host lexer).
                    get_opt_type: ValueType = expression_type(try_guarded, local_scope, fns, structs, generics)
                    if get_opt_type.kind == TypeKind.Optional:
                        get_payload_type: ValueType = optional_payload_of(get_opt_type, structs)
                        if emit_expression(try_guarded, get_opt_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is get_opt_value:
                            get_tag: LLVMValueRef = optional_tag_of(get_opt_value, get_opt_type, structs, ctx, builder)
                            get_payload: LLVMValueRef = optional_payload_value_of(get_opt_value, get_opt_type, structs, ctx, builder)
                            get_fn: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                            get_present: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, get_fn, "get.expr.present")
                            get_absent: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, get_fn, "get.expr.absent")
                            get_done: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, get_fn, "get.expr.done")
                            result_ty: LLVMTypeRef = llvm_type_of(get_payload_type, structs, ctx)
                            result_slot: LLVMValueRef = LLVMBuildAlloca(builder, result_ty, "get.expr.result")
                            _ = LLVMBuildCondBr(builder, get_tag, get_present, get_absent)
                            LLVMPositionBuilderAtEnd(builder, get_present)
                            _ = LLVMBuildStore(builder, get_payload, result_slot)
                            _ = LLVMBuildBr(builder, get_done)
                            LLVMPositionBuilderAtEnd(builder, get_absent)
                            if emit_expression(try_fallback, get_payload_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is get_fallback_value:
                                _ = LLVMBuildStore(builder, get_fallback_value, result_slot)
                                _ = LLVMBuildBr(builder, get_done)
                                LLVMPositionBuilderAtEnd(builder, get_done)
                                return LLVMBuildLoad2(builder, result_ty, result_slot, "get.expr.load")
                            return null
                        return null
                    # `try VALUE else FALLBACK` also accepts a first-class error-union
                    # value, not only a direct error-returning call. Stage0 extracts the
                    # descriptor's code, keeps the payload on the success path, and runs
                    # the fallback on any nonzero code. This matters for locals and
                    # parameters carrying `T error[E]` values.
                    try_guarded_type: ValueType = expression_type(try_guarded, local_scope, fns, structs, generics)
                    if try_guarded_type.kind == TypeKind.ErrorUnion:
                        try_payload_type: ValueType = error_union_payload_of(try_guarded_type, structs)
                        null return if try_payload_type.kind == TypeKind.Unmodeled
                        if emit_expression(try_guarded, try_guarded_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is try_union_value:
                            try_union_code: LLVMValueRef = error_union_code_of(try_union_value, try_guarded_type, structs, ctx, builder)
                            try_union_ok: LLVMValueRef = LLVMBuildICmp(builder, 32, try_union_code, LLVMConstInt(LLVMInt32TypeInContext(ctx), 0, 0), "try.union.ok")
                            try_union_function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                            try_union_value_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, try_union_function, "try.union.value")
                            try_union_fallback_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, try_union_function, "try.union.fallback")
                            try_union_done_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, try_union_function, "try.union.done")
                            try_union_payload_llvm: LLVMTypeRef = llvm_type_of(try_payload_type, structs, ctx)
                            try_union_result_slot: LLVMValueRef = LLVMBuildAlloca(builder, try_union_payload_llvm, "try.union.result")
                            _ = LLVMBuildCondBr(builder, try_union_ok, try_union_value_block, try_union_fallback_block)
                            LLVMPositionBuilderAtEnd(builder, try_union_value_block)
                            try_union_payload_ptr: LLVMValueRef = LLVMBuildExtractValue(builder, try_union_value, 1, "try.union.payload.ptr")
                            try_union_payload: LLVMValueRef = LLVMBuildLoad2(builder, try_union_payload_llvm, try_union_payload_ptr, "try.union.payload")
                            _ = LLVMBuildStore(builder, try_union_payload, try_union_result_slot)
                            _ = LLVMBuildBr(builder, try_union_done_block)
                            LLVMPositionBuilderAtEnd(builder, try_union_fallback_block)
                            if emit_expression(try_fallback, try_payload_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is try_union_fallback_value:
                                _ = LLVMBuildStore(builder, try_union_fallback_value, try_union_result_slot)
                                _ = LLVMBuildBr(builder, try_union_done_block)
                                LLVMPositionBuilderAtEnd(builder, try_union_done_block)
                                return LLVMBuildLoad2(builder, try_union_payload_llvm, try_union_result_slot, "try.union.value")
                            return null
                        return null
                    match try_guarded:
                        Expr.Call(try_callee, try_args, try_arg_names, try_call_line):
                            # Callee is a bare name (`f`) OR an explicit generic instantiation
                            # (`f[T]` / `f[K, V]`); base-name both so `try dict_put[K,V](...) else …`
                            # dispatches like `try f(...) else …`. Type args re-inferred from value args.
                            try_name: sview = generic_call_base_name(try_callee)
                            if try_name != "":
                                if error_callee_is(fns, generics, try_name):
                                    try_value_type: ValueType = error_callee_value_type(try_name, try_args, local_scope, fns, structs, generics)
                                    null return if try_value_type.kind == TypeKind.Unmodeled
                                    if error_callee_target(try_name, try_args, local_scope, fns, structs, generics, m, ctx) is try_target:
                                        try_out_slot: LLVMValueRef = LLVMBuildAlloca(builder, llvm_type_of(try_value_type, structs, ctx), "try.out")
                                        try_call_args: mutable darray[LLVMValueRef] = [try_out_slot]
                                        try_declined: mutable bool = false
                                        try_arg_index: mutable usize = 0
                                        for try_arg in try_args |try_call_args, try_declined, try_arg_index, try_name, local_scope, fns, structs, generics, runtime, m, ctx, builder|:
                                            if emit_expression(try_arg, error_callee_param_type(try_name, try_args, try_arg_index, local_scope, fns, structs, generics), local_scope, fns, structs, generics, runtime, m, ctx, builder) is try_arg_value:
                                                try_call_args.push(try_arg_value)
                                            else:
                                                try_declined <- true
                                            try_arg_index <- try_arg_index + 1
                                        null return if try_declined
                                        try_call_args.push(call_site_arena(try_args, local_scope, runtime)) if error_callee_wants_arena(try_name, try_args, local_scope, fns, structs, generics)
                                        try_fn_type: LLVMTypeRef = LLVMGlobalGetValueType(try_target)
                                        try_args_pointer: void& = (&try_call_args[0]).cast[void&] can Unsafe.PointerCast
                                        try_code: LLVMValueRef = LLVMBuildCall2(builder, try_fn_type, try_target, try_args_pointer, try_call_args.count.u32(), "try.code")
                                        # See the catch-site note: a payload-carrying set returns `%ErrSet__E`.
                                        try_status: LLVMValueRef = LLVMBuildExtractValue(builder, try_code, 0, "errset.code") if function_returns_error_struct(fns, structs, "", try_name) else try_code
                                        try_ok: LLVMValueRef = LLVMBuildICmp(builder, 32, try_status, LLVMConstInt(LLVMInt32TypeInContext(ctx), 0, 0), "try.ok")
                                        function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                                        try_value_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "try.value")
                                        try_fallback_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "try.fallback")
                                        try_done_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "try.done")
                                        # alloca+store+load, not phi -- the codebase avoids phi (a
                                        # void phi ICEs stage0, and the two paths merge cleanly here).
                                        try_result_type: LLVMTypeRef = llvm_type_of(try_value_type, structs, ctx)
                                        try_result_slot: LLVMValueRef = LLVMBuildAlloca(builder, try_result_type, "try.result")
                                        _ = LLVMBuildCondBr(builder, try_ok, try_value_block, try_fallback_block)
                                        LLVMPositionBuilderAtEnd(builder, try_value_block)
                                        try_value: LLVMValueRef = LLVMBuildLoad2(builder, try_result_type, try_out_slot, "try.value.load")
                                        _ = LLVMBuildStore(builder, try_value, try_result_slot)
                                        _ = LLVMBuildBr(builder, try_done_block)
                                        LLVMPositionBuilderAtEnd(builder, try_fallback_block)
                                        if emit_expression(try_fallback, try_value_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is try_fallback_value:
                                            _ = LLVMBuildStore(builder, try_fallback_value, try_result_slot)
                                            _ = LLVMBuildBr(builder, try_done_block)
                                        else:
                                            return null
                                        LLVMPositionBuilderAtEnd(builder, try_done_block)
                                        return LLVMBuildLoad2(builder, try_result_type, try_result_slot, "try.value")
                        _:
                            pass
                    # `get OPT else FALLBACK` — the OPTIONAL-unwrap form: evaluate the guarded
                    # optional; if present yield its payload, else the fallback. (The error-call
                    # form above shares this node; a darray-bounds `get arr[i] else f` does not,
                    # since arr[i] is not optional-typed here — it declines.)
                    opt_guarded_type: ValueType = expression_type(try_guarded, local_scope, fns, structs, generics)
                    if opt_guarded_type.kind == TypeKind.Optional:
                        opt_payload_type: ValueType = optional_payload_of(opt_guarded_type, structs)
                        null return if opt_payload_type.kind == TypeKind.Unmodeled
                        if emit_expression(try_guarded, opt_guarded_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is opt_guarded_value:
                            opt_tag: LLVMValueRef = optional_tag_of(opt_guarded_value, opt_guarded_type, structs, ctx, builder)
                            opt_function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                            opt_value_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, opt_function, "get.value")
                            opt_fallback_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, opt_function, "get.fallback")
                            opt_done_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, opt_function, "get.done")
                            opt_payload_llvm: LLVMTypeRef = llvm_type_of(opt_payload_type, structs, ctx)
                            opt_result_slot: LLVMValueRef = LLVMBuildAlloca(builder, opt_payload_llvm, "get.result")
                            _ = LLVMBuildCondBr(builder, opt_tag, opt_value_block, opt_fallback_block)
                            LLVMPositionBuilderAtEnd(builder, opt_value_block)
                            _ = LLVMBuildStore(builder, optional_payload_value_of(opt_guarded_value, opt_guarded_type, structs, ctx, builder), opt_result_slot)
                            _ = LLVMBuildBr(builder, opt_done_block)
                            LLVMPositionBuilderAtEnd(builder, opt_fallback_block)
                            if emit_expression(try_fallback, opt_payload_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is opt_fallback_value:
                                _ = LLVMBuildStore(builder, opt_fallback_value, opt_result_slot)
                                _ = LLVMBuildBr(builder, opt_done_block)
                            else:
                                return null
                            LLVMPositionBuilderAtEnd(builder, opt_done_block)
                            opt_result: LLVMValueRef = LLVMBuildLoad2(builder, opt_payload_llvm, opt_result_slot, "get.value")
                            return emit_conversion(opt_result, opt_payload_type, expected, structs, ctx, builder) if expected.kind != TypeKind.Unmodeled and (expected.kind != opt_payload_type.kind or expected.bits != opt_payload_type.bits) else opt_result
                        return null
                    return null

                _:
                    pass
            # `catch f(args):` with a success arm and error-variant arms. The callee is an
            # ERROR fn (i32 status + out-param, stage0's ABI): call it, `code == 0` takes
            # the SUCCESS arm (arm 0, its Binding pattern names the out-value), a nonzero
            # code is `ordinal + 1` and dispatches down an icmp chain over the error arms.
            # Merged through a result slot, not a phi (the codebase avoids phi).
            match expression:
                Expr.Catch(catch_guarded, catch_arms, catch_line):
                    null return if catch_arms.count < 1
                    catch_guarded_type: ValueType = expression_type(catch_guarded, local_scope, fns, structs, generics)
                    # A named error callee has the split stage0 ABI (status plus an
                    # out-slot), even though its source-level expression type is modeled
                    # as a first-class error union for locals and function values.  Keep
                    # the direct-call lowering below ahead of the descriptor lowering:
                    # aggregate payloads such as `Box error[E]` otherwise enter the
                    # descriptor path, which currently cannot materialize the call's
                    # aggregate result reliably and declines the whole containing body.
                    catch_is_named_error_call: mutable bool = false
                    match catch_guarded:
                        Expr.Call(catch_direct_callee, catch_direct_args, catch_direct_names, catch_direct_line):
                            match catch_direct_callee:
                                Expr.Ident(catch_direct_name, catch_direct_name_line):
                                    catch_is_named_error_call <- error_callee_is(fns, generics, catch_direct_name)
                                _:
                                    pass
                        _:
                            pass
                    if catch_guarded_type.kind == TypeKind.ErrorUnion and not catch_is_named_error_call:
                        if emit_expression(catch_guarded, catch_guarded_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is catch_union_value:
                            return emit_catch_error_union_value(catch_union_value, catch_guarded_type, expected, catch_arms, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                        return null
                    match catch_guarded:
                        Expr.Call(catch_callee, catch_args, catch_arg_names, catch_call_line):
                            match catch_callee:
                                Expr.Ident(catch_name, catch_name_line):
                                    null return if not error_callee_is(fns, generics, catch_name)
                                    catch_value_type: ValueType = error_callee_value_type(catch_name, catch_args, local_scope, fns, structs, generics)
                                    null return if catch_value_type.kind == TypeKind.Unmodeled
                                    # A VOID-success callee has no value for this EXPRESSION-position catch
                                    # to yield, and `alloca void` for its out slot is malformed IR that
                                    # TRAPPED LLVM outright. Decline instead of crashing; the statement form
                                    # (codegen_stmt_match) models the void case.
                                    null return if catch_value_type.kind == TypeKind.Void
                                    if error_callee_target(catch_name, catch_args, local_scope, fns, structs, generics, m, ctx) is catch_target:
                                        catch_value_llvm: LLVMTypeRef = llvm_type_of(catch_value_type, structs, ctx)
                                        # `catch` maps a fallible payload into the type of
                                        # its arm expressions. The payload type is only the
                                        # type of the success binding/out-slot; it need not be
                                        # the type yielded by the whole catch. For example,
                                        # `catch load(): ok: ok.field ...` yields a field,
                                        # not the aggregate payload itself.
                                        catch_result_type: ValueType = expected if expected.kind != TypeKind.Unmodeled else catch_value_type
                                        catch_result_llvm: LLVMTypeRef = llvm_type_of(catch_result_type, structs, ctx)
                                        catch_out_slot: LLVMValueRef = LLVMBuildAlloca(builder, catch_value_llvm, "catch.out")
                                        catch_call_args: mutable darray[LLVMValueRef] = [catch_out_slot]
                                        catch_declined: mutable bool = false
                                        catch_arg_index: mutable usize = 0
                                        for catch_arg in catch_args |catch_call_args, catch_declined, catch_arg_index, catch_name, local_scope, fns, structs, generics, runtime, m, ctx, builder|:
                                            if emit_expression(catch_arg, error_callee_param_type(catch_name, catch_args, catch_arg_index, local_scope, fns, structs, generics), local_scope, fns, structs, generics, runtime, m, ctx, builder) is catch_arg_value:
                                                catch_call_args.push(catch_arg_value)
                                            else:
                                                catch_declined <- true
                                            catch_arg_index <- catch_arg_index + 1
                                        null return if catch_declined
                                        catch_call_args.push(call_site_arena(catch_args, local_scope, runtime)) if error_callee_wants_arena(catch_name, catch_args, local_scope, fns, structs, generics)
                                        catch_fn_type: LLVMTypeRef = LLVMGlobalGetValueType(catch_target)
                                        catch_args_pointer: void& = (&catch_call_args[0]).cast[void&] can Unsafe.PointerCast
                                        catch_call_value: LLVMValueRef = LLVMBuildCall2(builder, catch_fn_type, catch_target, catch_args_pointer, catch_call_args.count.u32(), "catch.code")
                                        # A PAYLOAD-carrying error set returns `%ErrSet__E`, not a bare i32:
                                        # the code is field 0. Comparing the whole struct against `i32 0`
                                        # emitted malformed IR (`icmp eq { i32, i64, i32 } %c, i32 0`).
                                        catch_code: LLVMValueRef = LLVMBuildExtractValue(builder, catch_call_value, 0, "errset.code") if function_returns_error_struct(fns, structs, "", catch_name) else catch_call_value
                                        function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                                        catch_value_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "catch.value")
                                        catch_dispatch_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "catch.dispatch")
                                        catch_done_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "catch.done")
                                        catch_result_slot: LLVMValueRef = LLVMBuildAlloca(builder, catch_result_llvm, "catch.result")
                                        catch_ok: LLVMValueRef = LLVMBuildICmp(builder, 32, catch_code, LLVMConstInt(LLVMInt32TypeInContext(ctx), 0, 0), "catch.ok")
                                        _ = LLVMBuildCondBr(builder, catch_ok, catch_value_block, catch_dispatch_block)

                                        # SUCCESS arm: arm 0. A Binding pattern names the out-slot value
                                        # for the arm's body; a Wildcard uses the value unchanged.
                                        LLVMPositionBuilderAtEnd(builder, catch_value_block)
                                        success_arm: MatchArm = catch_arms[0]
                                        null return if arm_has_guard(success_arm.guard)
                                        # The success binding is scoped to THIS ARM. Declaring it without a
                                        # mark left it live for the rest of the function, and lookup_index
                                        # scans backward, so a same-named outer local was shadowed from
                                        # here on: `value: i64 = 100` with a `catch read(0): value: …` arm
                                        # answered 84 (42+42) where stage0 answers 142 (42+100). The outer
                                        # value was simply unreachable afterwards.
                                        catch_arm_mark: usize = scope_mark(local_scope)
                                        match success_arm.pattern:
                                            Pattern.Binding(success_binding):
                                                declare_local(local_scope, success_binding, catch_out_slot, catch_value_type)
                                            _:
                                                pass
                                        if arm_value_expression(success_arm.body) is success_expression:
                                            if emit_expression(success_expression, catch_result_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is success_value:
                                                scope_restore(local_scope, catch_arm_mark)
                                                _ = LLVMBuildStore(builder, success_value, catch_result_slot)
                                                _ = LLVMBuildBr(builder, catch_done_block)
                                            else:
                                                return null
                                        else:
                                            return null

                                        # ERROR arms: icmp chain over `code == ordinal + 1`. A Wildcard
                                        # arm is the catch-all; without one the chain ends unreachable
                                        # (the checker proved exhaustiveness).
                                        LLVMPositionBuilderAtEnd(builder, catch_dispatch_block)
                                        error_arm_index: mutable usize = 1
                                        error_declined: mutable bool = false
                                        saw_catch_all: mutable bool = false
                                        while error_arm_index < catch_arms.count |error_arm_index, error_declined, saw_catch_all, catch_arms, catch_code, catch_value_type, catch_result_type, catch_result_slot, catch_done_block, function, local_scope, fns, structs, generics, runtime, m, ctx, builder|:
                                            error_arm: MatchArm = catch_arms[error_arm_index]
                                            error_arm_index <- error_arm_index + 1
                                            continue if error_declined or saw_catch_all
                                            if arm_has_guard(error_arm.guard):
                                                error_declined <- true
                                                continue
                                            # An arm that TERMINATES instead of yielding a value:
                                            # `r: i64 = catch f(v): ... error e: return 1`. arm_value_expression
                                            # models only a single `Stmt.Expr`, so a `return` arm answered null
                                            # and the whole catch declined — in declaration position, where
                                            # "on error, leave the function" is the natural way to write it.
                                            # stage0 accepts it.
                                            #
                                            # Such an arm stores nothing and never branches to catch.done: the
                                            # `ret` IS the arm block's terminator. The returned value is emitted
                                            # at runtime.fn_return_type, which the body emitter records because
                                            # an expression emitter has no statement context of its own; an
                                            # ERROR function additionally stores through its out-param and
                                            # returns the success code, exactly as a `return` statement does.
                                            catch_term_ret: mutable Expr? = null
                                            if error_arm.body.count == 1:
                                                match error_arm.body[0]:
                                                    Stmt.Return(catch_term_value_opt, catch_term_ret_line):
                                                        catch_term_ret <- catch_term_value_opt
                                                    _:
                                                        pass
                                            catch_term_catch_all: mutable bool = match error_arm.pattern:
                                                Pattern.Wildcard: true
                                                Pattern.TypeBind(catch_term_type, _): catch_term_type == "error"
                                                _: false
                                            if catch_term_catch_all and (catch_term_ret is catch_term_expression):
                                                if runtime.fn_return_type.kind == TypeKind.Unmodeled:
                                                    error_declined <- true
                                                    continue
                                                if emit_expression(catch_term_expression, runtime.fn_return_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is catch_term_emitted:
                                                    if runtime.in_error_fn:
                                                        _ = LLVMBuildStore(builder, catch_term_emitted, runtime.error_out)
                                                        _ = LLVMBuildRet(builder, error_success_return_value(structs, runtime, ctx))
                                                    else:
                                                        _ = LLVMBuildRet(builder, catch_term_emitted)
                                                    saw_catch_all <- true
                                                else:
                                                    error_declined <- true
                                                continue
                                            if arm_value_expression(error_arm.body) is error_expression:
                                                if error_arm.pattern is Pattern.Wildcard:
                                                    # catch-all: emit straight into the current block.
                                                    if emit_expression(error_expression, catch_result_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is catch_all_value:
                                                        _ = LLVMBuildStore(builder, catch_all_value, catch_result_slot)
                                                        _ = LLVMBuildBr(builder, catch_done_block)
                                                        saw_catch_all <- true
                                                    else:
                                                        error_declined <- true
                                                    continue
                                                if error_arm.pattern is Pattern.TypeBind(error_type_name, error_binder):
                                                    # `error e:` — the CATCH-ALL handler (same as the statement
                                                    # form). The binder is NOT declared: a body that reads `e`
                                                    # declines on the unknown ident rather than seeing a wrong
                                                    # value. Any other TypeBind type is not a catch form.
                                                    if error_type_name != "error":
                                                        error_declined <- true
                                                        continue
                                                    if emit_expression(error_expression, catch_result_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is typebind_value:
                                                        _ = LLVMBuildStore(builder, typebind_value, catch_result_slot)
                                                        _ = LLVMBuildBr(builder, catch_done_block)
                                                        saw_catch_all <- true
                                                    else:
                                                        error_declined <- true
                                                    continue
                                                # A BARE variant name (`NotFound:`) is NOT a Variant pattern:
                                                # parse_pattern_primary returns Pattern.Variant only for a
                                                # DOTTED path and a plain `Pattern.Binding(name)` otherwise
                                                # (parser_stmt_pattern.elisa ~372). In an error arm such a
                                                # name can only be a variant of the guarded call's error set,
                                                # so it is rewritten to the Variant shape and resolved by
                                                # name; a name no enum declares -- or one two enums share --
                                                # keeps declining.
                                                error_arm_pattern: mutable Pattern = error_arm.pattern
                                                if error_arm.pattern is Pattern.Binding(error_bare_name):
                                                    error_arm_pattern <- (Pattern.Variant(error_bare_name, [])) if variant_ordinal_of_bare_name(error_bare_name, structs) >= 0
                                                if error_arm_pattern is Pattern.Variant(error_path, error_fields):
                                                    # An error decl registers as a PAYLOAD enum, so its
                                                    # variant index comes from the penum pools; a const
                                                    # enum path is the fallback.
                                                    error_ordinal: mutable i64 = penum_variant_index_of_path(error_path, structs)
                                                    if error_ordinal < 0:
                                                        error_ordinal <- ordinal_of_dotted_path(error_path, structs)
                                                    if error_ordinal < 0:
                                                        error_ordinal <- variant_ordinal_of_bare_name(error_path, structs)
                                                    if error_ordinal < 0:
                                                        error_declined <- true
                                                        continue
                                                    error_arm_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "catch.arm")
                                                    error_next_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "catch.next")
                                                    error_hit: LLVMValueRef = LLVMBuildICmp(builder, 32, catch_code, LLVMConstInt(LLVMInt32TypeInContext(ctx), (error_ordinal + 1).u64(), 0), "catch.cmp")
                                                    _ = LLVMBuildCondBr(builder, error_hit, error_arm_block, error_next_block)
                                                    LLVMPositionBuilderAtEnd(builder, error_arm_block)
                                                    error_arm_mark: usize = scope_mark(local_scope)
                                                    if error_fields.count > 0:
                                                        error_family: mutable sview = ""
                                                        catch_function_index: i64 = function_index_of(fns, "", catch_name)
                                                        error_family <- line_error_set_name(structs.error_fn_lines, structs.error_fn_set_names, fns.lines[catch_function_index.usize()]) if catch_function_index >= 0
                                                        error_family <- resolved_error_family(error_family, structs)
                                                        error_set_index: i64 = penum_index_of(structs, error_family)
                                                        if error_set_index < 0 or error_ordinal >= structs.penum_variant_count[error_set_index.usize()].i64():
                                                            error_declined <- true
                                                        else:
                                                            error_variant_slot: usize = structs.penum_variant_start[error_set_index.usize()] + error_ordinal.usize()
                                                            error_field_count: usize = structs.penum_field_type_count[error_variant_slot]
                                                            if error_fields.count != error_field_count:
                                                                error_declined <- true
                                                            else:
                                                                error_field_base: usize = error_set_variant_field_base(structs, error_set_index, error_ordinal.usize())
                                                                error_status_value: LLVMValueRef = catch_call_value
                                                                error_field_index: mutable usize = 0
                                                                for error_field in error_fields |error_field_index, error_field_base, error_status_value, error_set_index, error_variant_slot, structs, local_scope, ctx, builder|:
                                                                    match error_field:
                                                                        Pattern.Wildcard:
                                                                            pass
                                                                        Pattern.Binding(error_binding):
                                                                            error_type: ValueType = copied_type(structs.penum_field_types[structs.penum_field_type_start[error_variant_slot] + error_field_index])
                                                                            error_value: LLVMValueRef = LLVMBuildExtractValue(builder, error_status_value, (error_field_base + error_field_index).u32(), "catch.payload")
                                                                            error_storage: mutable darray[u8] = []
                                                                            error_slot: LLVMValueRef = LLVMBuildAlloca(builder, llvm_type_of(error_type, structs, ctx), sview_to_cstr(error_binding, error_storage))
                                                                            _ = LLVMBuildStore(builder, error_value, error_slot)
                                                                            declare_local(local_scope, error_binding, error_slot, error_type)
                                                                        _:
                                                                            error_declined <- true
                                                                    error_field_index <- error_field_index + 1
                                                    if emit_expression(error_expression, catch_result_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is error_value:
                                                        scope_restore(local_scope, error_arm_mark)
                                                        _ = LLVMBuildStore(builder, error_value, catch_result_slot)
                                                        _ = LLVMBuildBr(builder, catch_done_block)
                                                    else:
                                                        scope_restore(local_scope, error_arm_mark)
                                                        error_declined <- true
                                                    LLVMPositionBuilderAtEnd(builder, error_next_block)
                                                    continue
                                                error_declined <- true
                                            else:
                                                error_declined <- true
                                        null return if error_declined
                                        # No catch-all: the residual block is unreachable (stage0's
                                        # catch.fail) -- the checker proved the arms exhaustive.
                                        if not saw_catch_all:
                                            _ = LLVMBuildUnreachable(builder)
                                        LLVMPositionBuilderAtEnd(builder, catch_done_block)
                                        return LLVMBuildLoad2(builder, catch_result_llvm, catch_result_slot, "catch.value")
                                _:
                                    pass
                        _:
                            pass
                    return null
                _:
                    pass
            return emit_expression_string_and_ident(expression, expected, local_scope, fns, structs, generics, runtime, m, ctx, builder, handled)
