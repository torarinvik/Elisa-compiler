# EASM register-destination reads used by the verifier's live-in analysis.
module EasmRegisterEffectPolicy:
    public:
        def compare_or_test_reads_destination(op: sview) -> bool:
            ensure result == (op == "cmp" or op == "cmpq" or op == "test" or op == "testq")
            can Abort.Panic:
                return when op:
                    "cmp" | "cmpq" | "test" | "testq" -> true
                    _ -> false

        def zeroing_alu_opcode(op: sview) -> bool:
            ensure result == (op == "xor" or op == "xorq" or op == "sub" or op == "subq")
            can Abort.Panic:
                return when op:
                    "xor" | "xorq" | "sub" | "subq" -> true
                    _ -> false

        def is_self_zeroing(op: sview, source_register: sview, destination_register: sview) -> bool:
            ensure result == (
                source_register != "" and source_register == destination_register and
                zeroing_alu_opcode(op)
            )
            return false if:
                source_register == ""
                source_register != destination_register
            return zeroing_alu_opcode(op)

        def destination_reads_register(op: sview) -> bool:
            ensure result == (
                EasmMemoryEffectPolicy::read_modify_write(op) or
                compare_or_test_reads_destination(op)
            )
            return EasmMemoryEffectPolicy::read_modify_write(op) or compare_or_test_reads_destination(op)

        def reads_register_destination(op: sview, has_register_destination: bool, self_zeroing: bool) -> bool:
            ensure result == (
                has_register_destination and not self_zeroing and destination_reads_register(op)
            )
            return false if:
                not has_register_destination
                self_zeroing
            return destination_reads_register(op)
