# Stage1 backend — SEALED HIERARCHIES (`enum Child is Parent`): the parent/root relation, which
# hierarchies are store-backed, and the registration of an INLINE hierarchy as one payload
# enum under its root. Part of `module Backend` (see codegen.elisa).

extend Backend:
    private:



        # ---- Hierarchy representation (parity with stage0) ----
        #
        # stage0 lowers a sealed hierarchy INLINE -- an ordinary `{i32 tag, payload}`
        # tagged union sized for the widest leaf, tags numbered in pre-order across the
        # whole tree -- unless it is STORE-backed: the root is a `packed enum`, a member
        # is recursive, or the root declares `common:` fields. Only then do values become
        # handles into a region-backed AoS store. stage1 used to put EVERY `is` edge on
        # the store, so an event-kind taxonomy allocated a row per value (measured: an
        # unbounded leak on the component's monotonic heap).

        def hierarchy_parent_in_file(file: Ast::File&, name: sview, enum_module: sview) -> sview can[Abort.Panic]:
            for annotation in file.enum_annotations |name, enum_module|:
                annotation.name return if annotation.line == 3900000008 and annotation.owner == name and annotation.module == enum_module
            return ""



        def hierarchy_root_in_file(file: Ast::File&, name: sview, enum_module: sview) -> sview can[Abort.Panic]:
            cursor: mutable sview = name
            steps: mutable usize = 0
            while steps < file.enum_annotations.count |cursor, steps, file|:
                parent: sview = hierarchy_parent_in_file(file, cursor, enum_module)
                break if parent == ""
                cursor <- parent
                steps <- steps + 1
            return cursor



        def hierarchy_has_children_in_file(file: Ast::File&, name: sview, enum_module: sview) -> bool can[Abort.Panic]:
            for annotation in file.enum_annotations |name, enum_module|:
                true return if annotation.line == 3900000008 and annotation.name == name and annotation.module == enum_module
            return false


        def enum_decl_owner_in_file(file: Ast::File&, name: sview, enum_module: sview) -> sview can[Abort.Panic]:
            for enum_index in 0..<file.enum_decl_names.count |file, name|:
                # Const enums cannot be sealed hierarchy members. A namesake const
                # declaration must not supply the owner of a payload-bearing root.
                continue if file.enum_decl_is_const[enum_index]
                if file.enum_decl_names[enum_index] == name and enum_index < file.enum_decl_owners.count and file.enum_decl_owners[enum_index] == enum_module:
                    return file.enum_decl_owners[enum_index]
            # Payload-bearing enums live in a separate flat metadata pool. Hierarchy
            # registration uses this helper for every member, so consulting only the
            # fieldless/const pool made a payload member look ownerless and skipped its
            # variants whenever it was nested in a module.
            for payload_index in 0..<file.payload_enum_names.count |file, name|:
                if file.payload_enum_names[payload_index] == name and payload_index < file.payload_enum_owners.count and file.payload_enum_owners[payload_index] == enum_module:
                    return file.payload_enum_owners[payload_index]
            return ""



        # Whether ONE member, on its own, forces its hierarchy onto the store: the `packed`
        # keyword, a recursive member, or the compiler's own AST. That is stage0's rule.
        #
        # `__ast_refinement` and `__aos` do NOT belong here, however store-ish they read.
        # The parser stamps both on EVERY user hierarchy (record_recursive_enum promotes
        # any `is Parent` clause), so counting them made this predicate constantly true,
        # which made hierarchy_is_store_backed constantly true, which left the inline path
        # unreachable and every inline hierarchy declined by the backend. The distinct
        # `__compiler_ast_refinement` mark is the one that means the compiler's own AST.
        def enum_forces_store(file: Ast::File&, name: sview, enum_module: sview) -> bool can[Abort.Panic]:
            for annotation in file.enum_annotations |name, enum_module|:
                true return if annotation.owner == name and annotation.module == enum_module and annotation.name == "__declared_packed"
            for annotation in file.enum_annotations |name, enum_module|:
                continue if annotation.owner != name or annotation.module != enum_module
                true return if annotation.name == "__recursive_field" or annotation.name == "__compiler_ast_refinement"
            for common_index in 0..<file.enum_common_owners.count |file, name, enum_module|:
                common_module: sview = file.enum_common_modules[common_index] if common_index < file.enum_common_modules.count else ""
                true return if file.enum_common_owners[common_index] == name and common_module == enum_module and common_index < file.enum_common_counts.count and file.enum_common_counts[common_index] > 0
            return false



        # Whether the hierarchy that `name` belongs to is store-backed: any member
        # forces it (the root, or any refinement anywhere in the tree).
        def hierarchy_is_store_backed(file: Ast::File&, name: sview, enum_module: sview) -> bool can[Abort.Panic]:
            root: sview = hierarchy_root_in_file(file, name, enum_module)
            true return if enum_forces_store(file, root, enum_module)
            for annotation in file.enum_annotations |file, root, enum_module|:
                continue if annotation.line != 3900000008
                continue if annotation.module != enum_module
                continue if hierarchy_root_in_file(file, annotation.owner, enum_module) != root
                true return if enum_forces_store(file, annotation.owner, enum_module)
            return false



        # Register an INLINE hierarchy as ONE payload enum under its root: every member's
        # leaves in pre-order (a node's own variants, then each refinement's subtree, in
        # declaration order -- stage0's assignHierarchyEnumTags), so the tag of a leaf is
        # its position in that walk. Each refinement becomes a type ALIAS of the root, so a
        # `MouseEvent` value and an `Event` value are the same LLVM type and the upcast is a
        # typed no-op, exactly as docs/77 promises.
        def register_inline_hierarchy(file: Ast::File&, root: sview, root_owner: sview, structs: mutable StructTable&) -> void can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                return if penum_index_of_owned(structs, root_owner, root) >= 0
                members: mutable darray[sview] = []
                collect_hierarchy_members_preorder(file, root, root_owner, members)
                start: usize = structs.payload_enums.penum_variants.count
                flat_start: usize = structs.payload_enums.penum_field_types.count
                declined: mutable bool = false
                widest: mutable u32 = 0
                for member in members |file, structs, declined, widest|:
                    continue if declined
                    member_slot: mutable i64 = -1
                    member_owner: sview = enum_decl_owner_in_file(file, member, root_owner)
                    # Payload annotations are lexical to this member's module.
                    # Global fallback becomes ambiguous when another module declares
                    # a namesake such as Key, and previously discarded the whole tree.
                    saved_owner: sview = structs.visibility.current_owner
                    structs.visibility.current_owner <- member_owner
                    for enum_index in 0..<file.payload_enum_names.count |member_slot, file, member, member_owner|:
                        member_slot <- enum_index.i64() if file.payload_enum_names[enum_index] == member and (enum_index >= file.payload_enum_owners.count or file.payload_enum_owners[enum_index] == member_owner)
                    rows_before: usize = structs.payload_enums.penum_variants.count
                    if member_slot < 0:
                        # A member whose variants ALL lack a payload (often the root) is not in
                        # the payload-enum metadata at all; its leaves come from the plain
                        # declaration tables and register as payload-less rows, so they keep
                        # their pre-order tag positions.
                        register_inline_payloadless_member(file, member, member_owner, structs)
                        structs.visibility.current_owner <- saved_owner
                        for _ in rows_before..<structs.payload_enums.penum_variants.count |structs, member|:
                            structs.payload_enums.penum_variant_owners <- structs.payload_enums.penum_variant_owners.push(member)
                        continue
                    if file.payload_enum_is_const[member_slot.usize()]:
                        structs.visibility.current_owner <- saved_owner
                        continue
                    register_payload_variant_rows_flat(file.payload_enum_variant_names, file.payload_enum_variant_fields, file.payload_enum_variant_field_names, file.payload_enum_variant_field_starts, file.payload_enum_variant_field_counts, file.payload_enum_variant_starts[member_slot.usize()], file.payload_enum_variant_counts[member_slot.usize()], is_declared_error_set(structs, member), declined, widest, structs)
                    structs.visibility.current_owner <- saved_owner
                    for _ in rows_before..<structs.payload_enums.penum_variants.count |structs, member|:
                        structs.payload_enums.penum_variant_owners <- structs.payload_enums.penum_variant_owners.push(member)
                if declined:
                    dbg_event_type("HIERARCHY_DECLINED", root_owner, unmodeled_type(), structs)
                    while structs.payload_enums.penum_variants.count > start |structs|:
                        _ = structs.payload_enums.penum_variants.pop()
                        _ = structs.payload_enums.penum_variant_owners.pop()
                        _ = structs.payload_enums.penum_payloads.pop()
                        _ = structs.payload_enums.penum_has_payload.pop()
                        _ = structs.payload_enums.penum_field_names.pop()
                        _ = structs.payload_enums.penum_field_type_start.pop()
                        _ = structs.payload_enums.penum_field_type_count.pop()
                    while structs.payload_enums.penum_field_types.count > flat_start |structs|:
                        _ = structs.payload_enums.penum_field_types.pop()
                        _ = structs.payload_enums.penum_field_flat_names.pop()
                    return
                root_index: usize = structs.payload_enums.penum_names.count
                structs.payload_enums.penum_names <- structs.payload_enums.penum_names.push(root)
                structs.payload_enums.penum_owners <- structs.payload_enums.penum_owners.push(root_owner)
                structs.payload_enums.penum_variant_start <- structs.payload_enums.penum_variant_start.push(start)
                structs.payload_enums.penum_variant_count <- structs.payload_enums.penum_variant_count.push(structs.payload_enums.penum_variants.count - start)
                structs.payload_enums.penum_payload_words <- structs.payload_enums.penum_payload_words.push(widest)
                for member in members |structs, root, root_index|:
                    continue if member == root
                    continue if alias_index_of_owned(structs, root_owner, member) >= 0
                    structs.aliases.alias_names <- structs.aliases.alias_names.push(member)
                    structs.aliases.alias_owners <- structs.aliases.alias_owners.push(root_owner)
                    structs.aliases.alias_types <- structs.aliases.alias_types.push(ValueType{kind: TypeKind.PayloadEnum, bits: root_index.u32()})




        def register_inline_payloadless_member(file: Ast::File&, member: sview, owner: sview, structs: mutable StructTable&) -> void can[Abort.Panic, Memory.Allocate]:
            for decl_index in 0..<file.enum_decl_names.count |file, member, structs|:
                continue if file.enum_decl_names[decl_index] != member
                continue if decl_index < file.enum_decl_owners.count and file.enum_decl_owners[decl_index] != owner
                continue if file.enum_decl_is_const[decl_index]
                variant_start: usize = file.enum_decl_variant_starts[decl_index]
                variant_count: usize = file.enum_decl_variant_counts[decl_index]
                for variant_index in 0..<variant_count |file, structs, variant_start|:
                    structs.payload_enums.penum_field_type_start <- structs.payload_enums.penum_field_type_start.push(structs.payload_enums.penum_field_types.count)
                    structs.payload_enums.penum_field_type_count <- structs.payload_enums.penum_field_type_count.push(0)
                    structs.payload_enums.penum_variants <- structs.payload_enums.penum_variants.push(file.enum_decl_variant_names[variant_start + variant_index])
                    structs.payload_enums.penum_payloads <- structs.payload_enums.penum_payloads.push(unmodeled_type())
                    structs.payload_enums.penum_has_payload <- structs.payload_enums.penum_has_payload.push(false)
                    structs.payload_enums.penum_field_names <- structs.payload_enums.penum_field_names.push("")
                return



        def collect_hierarchy_members_preorder(file: Ast::File&, node: sview, enum_module: sview, out: mutable darray[sview]&) -> void can[Abort.Panic, Memory.Allocate]:
            out.push(node)
            for annotation in file.enum_annotations |file, node, enum_module, out|:
                continue if annotation.line != 3900000008 or annotation.name != node or annotation.module != enum_module
                collect_hierarchy_members_preorder(file, annotation.owner, enum_module, out)
