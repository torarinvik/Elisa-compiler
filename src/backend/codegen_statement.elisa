# Stage1 backend — `emit_statement` — the statement emitter.
# Part of `module Backend` (see codegen.elisa); split out to keep each file short.

extend Backend:
    private:
        # Emit one statement. Returns false to DECLINE (unmodeled construct).
        def emit_statement(statement: Stmt, return_type: ValueType, local_scope: mutable Scope&, loops: mutable LoopStack&, regions: mutable RegionStack&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> EmitStatus can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            int64_type: LLVMTypeRef = LLVMInt64TypeInContext(ctx)
            emit_trace_step(statement, runtime, ctx, builder)

            # `xs.push(v)` — a statement-position method call on a darray.
            # `region r:` — a NAMED, SCOPED region. stage0 emits `%r = alloca %Arena`,
            # allocates the block's containers from it (`arena_alloc(ptr %r, ...)`), and
            # arena_free's it at scope exit. Structurally the same thing emit_function_body
            # builds for a function's implicit auto region, so it reuses that shape and just
            # swaps which arena the block's statements allocate from.
            #
            # ONLY `region` is handled here. Every other Stmt.Block kind (`can ...:`,
            # `catch ...:`, arms) declines: `kind` is an opaque sview, so quietly treating an
            # unknown block as "just run the body" would silently drop the very semantics the
            # prefix carries. `region NAME(capacity):` likewise declines -- the capacity
            # lands in `clause` alongside the name and is not modeled.
            if statement is Stmt.Block(block_kind, block_clause, block_binding, block_body, block_line):
                declined_status: EmitStatus = EmitStatus.Declined
                if block_kind == "defer" and block_clause.count > 0 and (block_clause[0] == "function" or block_clause[0] == "block"):
                    local_scope.deferred <- local_scope.deferred.push(DeferredAction{body: [], names: [], slots: [], types: [], scope_exit: block_clause[0] == "block"})
                    deferred_index: usize = local_scope.deferred.count - 1
                    local_scope.deferred[deferred_index].body.extend(block_body)
                    local_scope.deferred[deferred_index].names.extend(local_scope.names)
                    local_scope.deferred[deferred_index].slots.extend(local_scope.slots)
                    local_scope.deferred[deferred_index].types.extend(local_scope.types)
                    return EmitStatus.Open
                # `static if/elif/else` in statement position: the parser keeps every
                # branch's body, so an UNTAKEN branch must emit NOTHING -- its body may
                # declare the same locals as the taken one, or call externs that only exist
                # on another target. A taken branch (and a bare `static:` block, whose line
                # is in neither table) emits inline into the enclosing scope, which is
                # stage0's scoping: a local declared in a taken branch is visible after
                # the chain (arena.elisa binds `r` this way).
                if block_kind == "static":
                    is_static_branch: bool = static_branch_is_taken(structs.static_branch_lines, block_line)
                    static_kept: bool = static_branch_is_taken(structs.static_taken_lines, block_line) if is_static_branch else true
                    EmitStatus.Open return if not static_kept
                    return emit_statements(block_body, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)
                # `in owner:` — make an EXISTING arena the active one for the block. stage0
                # requires this before a container can be built from an explicit `Arena`
                # parameter ("darray push requires an active in <arena>: scope"): passing an
                # arena does not make it the allocation target, activating it does.
                #
                # The arena is BORROWED, so owns_arena is false and nothing here frees it --
                # it belongs to whoever opened it.
                if block_kind == "in":
                    declined_status return if block_clause.count != 1
                    in_type: ValueType = lookup_type(local_scope, block_clause[0])
                    # `in store:` — make a packed STORE active. Every packed constructor in
                    # the block allocates its row from this store.
                    if in_type.kind == TypeKind.PackedStore:
                        if lookup_slot(local_scope, block_clause[0]) is store_slot:
                            store_runtime: mutable Runtime = copied_runtime(runtime)
                            store_runtime.active_store <- LLVMBuildLoad2(builder, llvm_type_of(in_type, structs, ctx), store_slot, "store.active")
                            store_runtime.active_store_enum <- in_type.bits.i64()
                            return emit_statements(block_body, return_type, local_scope, loops, regions, fns, structs, generics, store_runtime, m, ctx, builder)
                        return declined_status
                    # `in owner:` where owner is a BORROWED arena (`owner: mutable Arena&`) — the
                    # common case in std container ctors (IndexMap/InlineVec take `owner: Arena&`).
                    # The parameter slot holds a POINTER to the caller's arena, so load it and make
                    # that the active allocation target (vs a direct `Arena` local, whose slot IS
                    # the arena storage).
                    if in_type.kind == TypeKind.Ref and ref_target_of(in_type, structs).kind == TypeKind.Arena:
                        if lookup_slot(local_scope, block_clause[0]) is in_ref_slot:
                            in_ref_runtime: mutable Runtime = copied_runtime(runtime)
                            in_ref_runtime.arena <- LLVMBuildLoad2(builder, LLVMPointerTypeInContext(ctx, 0), in_ref_slot, "in.arena.ref")
                            in_ref_runtime.owns_arena <- false
                            return emit_statements(block_body, return_type, local_scope, loops, regions, fns, structs, generics, in_ref_runtime, m, ctx, builder)
                        return declined_status
                    declined_status return if in_type.kind != TypeKind.Arena
                    if lookup_slot(local_scope, block_clause[0]) is in_slot:
                        in_runtime: mutable Runtime = copied_runtime(runtime)
                        in_runtime.arena <- in_slot
                        in_runtime.owns_arena <- false
                        in_status: EmitStatus = emit_statements(block_body, return_type, local_scope, loops, regions, fns, structs, generics, in_runtime, m, ctx, builder)
                        return in_status
                    return declined_status
                # `trusted X:` / `can X:` — a trust/effect-grant wrapper. The grant is a
                # COMPILE-TIME assertion (the frontend proves it); there is no runtime
                # lowering, so the body simply runs in the current scope. The std dict's
                # probe loops sit inside `trusted Unsafe.AssumeProgress:`.
                if block_kind == "trusted" or block_kind == "can":
                    return emit_statements(block_body, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)
                # `pool workers(N):` and `nursery workers(N):` own a typed ThreadPool for the duration of the
                # block. The frontend keeps the worker-count expression as the first pool
                # clause entry; the source-level runtime functions provide the actual pool
                # implementation, so this lowering stays ABI-compatible with both the
                # std runtime and small backend fixtures.
                if block_kind == "pool" or block_kind == "nursery":
                    pool_binding: sview = block_binding if block_binding != "" else "workers"
                    pool_new_type: ValueType = lookup_return_type(fns, "", "pool_new")
                    pool_shutdown_type: ValueType = lookup_return_type(fns, "", "pool_shutdown")
                    declined_status return if pool_new_type.kind == TypeKind.Unmodeled or pool_shutdown_type.kind == TypeKind.Unmodeled
                    group_new_type: ValueType = lookup_return_type(fns, "", "task_group_new")
                    group_wait_type: ValueType = lookup_return_type(fns, "", "task_group_wait_all")
                    declined_status return if block_kind == "nursery" and (group_new_type.kind == TypeKind.Unmodeled or group_wait_type.kind == TypeKind.Unmodeled)
                    pool_workers: mutable i64 = 0
                    if block_clause.count > 0:
                        declined_status return if not parse_int_literal(block_clause[block_clause.count - 1], pool_workers)
                        declined_status return if pool_workers < 0
                    pool_arguments: mutable darray[Expr] = [Expr.IntLit(pool_workers)]
                    if emit_call(Expr.Ident("pool_new", block_line), pool_arguments, [], local_scope, fns, structs, generics, runtime, m, ctx, builder) is pool_value:
                        pool_storage: mutable darray[u8] = []
                        pool_slot: LLVMValueRef = LLVMBuildAlloca(builder, llvm_type_of(pool_new_type, structs, ctx), sview_to_cstr(pool_binding, pool_storage))
                        _ = LLVMBuildStore(builder, pool_value, pool_slot)
                        declare_local(local_scope, pool_binding, pool_slot, pool_new_type)
                        group_binding: sview = "__nursery_group"
                        if block_kind == "nursery":
                            empty_group_args: darray[Expr] = []
                            if emit_call(Expr.Ident("task_group_new", block_line), empty_group_args, [], local_scope, fns, structs, generics, runtime, m, ctx, builder) is group_value:
                                group_storage: mutable darray[u8] = []
                                group_slot: LLVMValueRef = LLVMBuildAlloca(builder, llvm_type_of(group_new_type, structs, ctx), sview_to_cstr(group_binding, group_storage))
                                _ = LLVMBuildStore(builder, group_value, group_slot)
                                declare_local(local_scope, group_binding, group_slot, group_new_type)
                                local_scope.group_names.push(group_binding)
                            else:
                                return declined_status
                        local_scope.pool_names.push(pool_binding)
                        pool_status: EmitStatus = emit_statements(block_body, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)
                        _ = local_scope.pool_names.pop()
                        declined_status return if pool_status == EmitStatus.Declined
                        # A return path has already terminated the current block. The
                        # complete stage0 cleanup path is handled by the enclosing function's
                        # pool unwind; do not append a call into a closed LLVM block here.
                        pool_status return if pool_status == EmitStatus.Terminated
                        declined_status return if not emit_deferred_actions(local_scope, true, fns, structs, generics, runtime, m, ctx, builder)
                        if block_kind == "nursery":
                            _ = local_scope.group_names.pop()
                            wait_arguments: mutable darray[Expr] = [Expr.Ident(group_binding, block_line)]
                            if emit_call(Expr.Ident("task_group_wait_all", block_line), wait_arguments, [], local_scope, fns, structs, generics, runtime, m, ctx, builder) is wait_value:
                                _ = wait_value
                            else:
                                return declined_status
                        shutdown_arguments: mutable darray[Expr] = [Expr.Ident(pool_binding, block_line)]
                        if emit_call(Expr.Ident("pool_shutdown", block_line), shutdown_arguments, [], local_scope, fns, structs, generics, runtime, m, ctx, builder) is shutdown_value:
                            _ = shutdown_value
                        return EmitStatus.Open
                    return declined_status
                declined_status return if block_kind != "region"
                # `region r:` gives clause ["r"]; `region r(4096):` gives ["r", "4096"] —
                # the parser captures the capacity as a span of the SOURCE text, so it is
                # parsed back out here rather than being an Expr.
                declined_status return if block_clause.count != 1 and block_clause.count != 2
                region_capacity: mutable i64 = 0
                if block_clause.count == 2:
                    declined_status return if not parse_int_literal(block_clause[1], region_capacity)
                    # A non-positive capacity is not a region stage0 would build.
                    declined_status return if region_capacity <= 0
                scoped_runtime: mutable Runtime = copied_runtime(runtime)
                scoped_arena_type: LLVMTypeRef = arena_llvm_type(ctx)
                scoped_name_storage: mutable darray[u8] = []
                scoped_slot: LLVMValueRef = LLVMBuildAlloca(builder, scoped_arena_type, sview_to_cstr(block_clause[0], scoped_name_storage))
                _ = LLVMBuildStore(builder, LLVMConstNull(scoped_arena_type), scoped_slot)
                if region_capacity > 0:
                    # An explicit capacity takes its backing UP FRONT from the runtime, and
                    # `begin` and `end` both start at it (stage0's shape). The lazy strategy
                    # word stays 0: the backing already exists, so there is nothing to
                    # allocate on first use.
                    region_backing_args: mutable darray[LLVMValueRef] = [LLVMConstInt(LLVMInt64TypeInContext(ctx), region_capacity.u64(), 0), LLVMConstInt(LLVMInt64TypeInContext(ctx), 0, 0)]
                    region_backing_pointer: void& = (&region_backing_args[0]).cast[void&] can Unsafe.PointerCast
                    region_backing: LLVMValueRef = LLVMBuildCall2(builder, scoped_runtime.new_region_backend_type, scoped_runtime.new_region_backend, region_backing_pointer, 2, "region.init")
                    region_begin: LLVMValueRef = LLVMBuildStructGEP2(builder, scoped_arena_type, scoped_slot, 0, "region.begin")
                    region_end: LLVMValueRef = LLVMBuildStructGEP2(builder, scoped_arena_type, scoped_slot, 1, "region.end")
                    _ = LLVMBuildStore(builder, region_backing, region_begin)
                    _ = LLVMBuildStore(builder, region_backing, region_end)
                else:
                    scoped_strategy: LLVMValueRef = LLVMBuildStructGEP2(builder, scoped_arena_type, scoped_slot, 3, "region.strategy")
                    _ = LLVMBuildStore(builder, LLVMConstInt(LLVMInt64TypeInContext(ctx), 0, 0), scoped_strategy)
                scoped_runtime.arena <- scoped_slot
                # The region's NAME is a value in scope: `region r(4096): return build(r)`
                # passes it as an Arena. Binding it here means the ordinary Ident path emits
                # the `load %Arena, ptr %r` the call site needs -- no special case.
                declare_local(local_scope, block_clause[0], scoped_slot, ValueType{kind: TypeKind.Arena, bits: 0})
                # The block OWNS this region: unlike a threaded arena, it must be freed when
                # the scope ends.
                scoped_runtime.owns_arena <- true
                # Live for the block's duration, so a `return` inside unwinds it along with
                # every enclosing region -- innermost first, which is the order stage0 emits.
                regions.arenas.push(scoped_slot)
                scoped_status: EmitStatus = emit_statements(block_body, return_type, local_scope, loops, regions, fns, structs, generics, scoped_runtime, m, ctx, builder)
                _ = regions.arenas.pop()
                declined_status return if scoped_status == EmitStatus.Declined
                # A body that RETURNED already unwound this region on its way out; emitting
                # the free here too would double-free it, and would follow a terminator.
                scoped_status return if scoped_status == EmitStatus.Terminated
                emit_region_free(scoped_runtime, builder)
                return scoped_status

            # `requires PRED` / `ensure PRED` — a design-by-contract check. stage0 lowers it
            # to `if not PRED: <panic>`: evaluate the predicate and, on failure, abort. A
            # provably-true predicate is optimized away (stage0's -O2 drops it entirely), so
            # the success path costs nothing after the optimizer runs.
            #
            # `requires` (a PRECONDITION over the parameters) is checked HERE. `ensure` is a
            # postcondition over `result`, which is not bound until the return -- so it is
            # only RECORDED here and checked on every return path (emit_ensure_checks),
            # which is where stage0 checks it too.
            # The fail path calls libc `abort()` rather than reproducing stage0's
            # printf+backtrace panic verbatim -- the SUCCESS path (predicate holds) is then
            # bit-identical to stage0, and a FAILING contract aborts in both.
            if statement is Stmt.Contract(contract_kind, contract_pred, contract_line):
                declined_contract: EmitStatus = EmitStatus.Declined
                # `decreases` is a loop-variant termination obligation the frontend
                # discharges — NO runtime lowering, so skip it. (The std dict probe loops
                # carry `decreases`.)
                EmitStatus.Open return if contract_kind == "decreases" or contract_kind == "decreases*"
                # `ensure` is a POSTCONDITION: record it and check it at every return, where
                # `result` exists. Recording (rather than a pre-scan in emit_function_body)
                # keeps the clause's meaning lexical — a return placed BEFORE it is not
                # governed by it, which is also how stage0 reads the prologue.
                if contract_kind == "ensure":
                    structs.pending_ensures.push(contract_pred)
                    return EmitStatus.Open
                # `requires` (precondition) and `assert` both lower to a runtime check that
                # aborts on a false predicate — bit-identical to stage0 on the success path.
                declined_contract return if contract_kind != "requires" and contract_kind != "assert"
                bool_type_c: ValueType = ValueType{kind: TypeKind.Bool, bits: 1}
                if emit_expression(contract_pred, bool_type_c, local_scope, fns, structs, generics, runtime, m, ctx, builder) is contract_value:
                    emit_contract_guard(contract_value, m, ctx, builder)
                    # Past the guard the predicate HOLDS, so `assert p != null` narrows `p`
                    # for the rest of the function -- stage0's rule, which the std dict
                    # relies on to read `m.items` as a plain ref.
                    record_null_assert(contract_pred, structs)
                    return EmitStatus.Open
                return declined_contract

            # `raise MyErr.Bad` — parses to Call(Ident("raise"), [E.Variant]). It TERMINATES:
            # store a zero into the error out-param (the success value is unused on the error
            # path) and return the i32 code `ordinal + 1` (0 is reserved for success).
            if statement is Stmt.Expr(raise_stmt_expr, raise_stmt_line):
                if raise_stmt_expr is Expr.Call(raise_callee, raise_args, raise_arg_names, raise_call_line):
                    if raise_callee is Expr.Ident(raise_name, raise_name_line):
                        if raise_name == "raise" and runtime.in_error_fn and raise_args.count == 1:
                            raise_ordinal: i64 = ordinal_of_dotted_path_expr(raise_args[0], structs)
                            if raise_ordinal >= 0:
                                emit_region_unwind(regions, runtime, builder)
                                # The out-param slot is a pointer; zero its first word so a
                                # later spurious read is deterministic (stage0 stores 0).
                                _ = LLVMBuildStore(builder, LLVMConstInt(LLVMInt64TypeInContext(ctx), 0, 0), runtime.error_out)
                                _ = LLVMBuildRet(builder, LLVMConstInt(LLVMInt32TypeInContext(ctx), (raise_ordinal + 1).u64(), 0))
                                return EmitStatus.Terminated
                        # `panic(MESSAGE)` — an unconditional abort. stage0 prints a backtrace
                        # first, but the SUCCESS path never reaches a panic, so lowering to
                        # libc `abort()` + unreachable is bit-identical where it matters and
                        # aborts in both compilers where the panic fires. TERMINATES the block.
                        # (The frictionless dict wrappers panic on OOM in their catch arms.)
                        if raise_name == "panic":
                            panic_abort_type: LLVMTypeRef = LLVMFunctionType(LLVMVoidTypeInContext(ctx), null, 0, 0)
                            panic_abort_fn: LLVMValueRef = declare_or_get_abort(m, panic_abort_type)
                            _ = LLVMBuildCall2(builder, panic_abort_type, panic_abort_fn, null, 0, "")
                            _ = LLVMBuildUnreachable(builder)
                            return EmitStatus.Terminated
            if statement is Stmt.Expr(statement_expression, statement_expression_line):
                # `pass` parses to Stmt.Expr(Expr.Invalid) — a deliberate no-op, so emit nothing
                # and stay open (emitting Expr.Invalid as a value would decline the function).
                EmitStatus.Open return if statement_expression is Expr.Invalid
                # A capture-listed loop (`for … |m, total|:`) parses as
                # Stmt.Expr(Expr.Block([accumulator decls…, the loop], yield, captures)).
                # In STATEMENT position with no yield the block is just its statements —
                # captures are annotations, and the accumulator declarations are ordinary
                # VarDecls in the ENCLOSING scope (stage0 scopes them the same way). A
                # block WITH a yield is a value position and stays unmodeled here.
                if statement_expression is Expr.Block(block_statements, block_value, block_captures, block_line):
                    # A submitted task is represented as an empty value block too, but it is
                    # still a STATEMENT semantically. Route it through emit_expression so the
                    # pool submission lowering runs instead of treating the non-invalid tail as
                    # an unsupported value-block statement.
                    if block_statements.count == 0:
                        for submit_marker in structs.fn_return_lines |structs, block_line|:
                            if submit_marker == block_line:
                                if fn_return_head_at(block_line, structs) == "__wait_all":
                                    wait_all_arguments: mutable darray[Expr] = [block_value]
                                    if emit_call(Expr.Ident("task_group_wait_all", block_line), wait_all_arguments, [], local_scope, fns, structs, generics, runtime, m, ctx, builder) is waited_all:
                                        _ = waited_all
                                        return EmitStatus.Open
                                    return EmitStatus.Declined
                                if emit_expression(statement_expression, ValueType{kind: TypeKind.Void, bits: 0}, local_scope, fns, structs, generics, runtime, m, ctx, builder) is submitted_statement:
                                    _ = submitted_statement
                                    return EmitStatus.Open
                                return EmitStatus.Declined
                    # Loop headers `for … |cap| -> cap:` yield the capture back for rebinding.
                    # In statement position lmut/captures already mutate in place, so a yield
                    # that is just the capture Ident is a no-op annotation — emit the body.
                    # (Lexer `for _ in count..>0 |lexer| -> lexer:` is this form.)
                    yield_is_capture_ident: mutable bool = false
                    if block_value is Expr.Ident(yield_name, yield_line):
                        for cap in block_captures |yield_is_capture_ident, yield_name|:
                            yield_is_capture_ident <- true if cap == yield_name
                    EmitStatus.Declined return if not (block_value is Expr.Invalid) and not yield_is_capture_ident
                    return emit_statements(block_statements, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)
                if statement_expression is Expr.Call(push_callee, push_arguments, push_argument_names, push_call_line):
                    if push_callee is Expr.Field(push_object, push_method, push_method_line):
                        # Receiver may be a bare Ident (`xs.push`) or a struct field holding a
                        # darray (`b.items.push`), both resolved by the _expr helpers.
                        push_type: ValueType = darray_type_behind_expr(push_object, local_scope, structs)
                        if push_type.kind == TypeKind.DArray and push_method == "push" and push_arguments.count == 1:
                            if darray_address_of_expr(push_object, local_scope, fns, structs, generics, runtime, m, ctx, builder) is push_slot:
                                if emit_darray_push(push_slot, push_type, push_arguments[0], local_scope, fns, structs, generics, runtime, m, ctx, builder):
                                    return EmitStatus.Open
                            return EmitStatus.Declined
                        # `xs.clear()` — logically empty the darray by zeroing its count (the
                        # backing/capacity are retained, matching stage0). No element teardown is
                        # needed: darray elements are plain values in an arena.
                        if push_type.kind == TypeKind.DArray and push_method == "clear" and push_arguments.count == 0:
                            if darray_address_of_expr(push_object, local_scope, fns, structs, generics, runtime, m, ctx, builder) is clear_slot:
                                clear_header: LLVMTypeRef = darray_llvm_type(structs, ctx)
                                clear_count_ptr: LLVMValueRef = LLVMBuildStructGEP2(builder, clear_header, clear_slot, 1, "clear.cnt.ptr")
                                _ = LLVMBuildStore(builder, LLVMConstInt(LLVMInt64TypeInContext(ctx), 0, 0), clear_count_ptr)
                                return EmitStatus.Open
                            return EmitStatus.Declined
                        # `xs.reserve(n)` — ensure capacity >= n without changing count or
                        # storing an element (see emit_darray_reserve). Works for any element
                        # type, so the IndexMap ctor's `map.entries.reserve(cap)` lowers here.
                        if push_type.kind == TypeKind.DArray and push_method == "reserve" and push_arguments.count == 1:
                            if darray_address_of_expr(push_object, local_scope, fns, structs, generics, runtime, m, ctx, builder) is reserve_slot:
                                if emit_expression(push_arguments[0], ValueType{kind: TypeKind.Unsigned, bits: 64}, local_scope, fns, structs, generics, runtime, m, ctx, builder) is reserve_n:
                                    if emit_darray_reserve(reserve_slot, push_type, reserve_n, structs, runtime, m, ctx, builder):
                                        return EmitStatus.Open
                            return EmitStatus.Declined
                        # `xs.truncate(n)` — SHRINK to at most n elements: count becomes min(count,
                        # n). A no-op when n >= count. Pure count clamp, like clear; the backing is
                        # retained and growth is never triggered (truncate only shrinks).
                        if push_type.kind == TypeKind.DArray and push_method == "truncate" and push_arguments.count == 1:
                            if darray_address_of_expr(push_object, local_scope, fns, structs, generics, runtime, m, ctx, builder) is trunc_slot:
                                trunc_i64: LLVMTypeRef = LLVMInt64TypeInContext(ctx)
                                if emit_expression(push_arguments[0], ValueType{kind: TypeKind.Unsigned, bits: 64}, local_scope, fns, structs, generics, runtime, m, ctx, builder) is trunc_n:
                                    trunc_header: LLVMTypeRef = darray_llvm_type(structs, ctx)
                                    trunc_count_ptr: LLVMValueRef = LLVMBuildStructGEP2(builder, trunc_header, trunc_slot, 1, "trunc.cnt.ptr")
                                    trunc_count: LLVMValueRef = LLVMBuildLoad2(builder, trunc_i64, trunc_count_ptr, "trunc.cnt")
                                    # min(count, n) via an unsigned compare (counts are non-negative).
                                    trunc_smaller: LLVMValueRef = LLVMBuildICmp(builder, 36, trunc_n, trunc_count, "trunc.lt")
                                    trunc_new: LLVMValueRef = LLVMBuildSelect(builder, trunc_smaller, trunc_n, trunc_count, "trunc.new")
                                    _ = LLVMBuildStore(builder, trunc_new, trunc_count_ptr)
                                    return EmitStatus.Open
                            return EmitStatus.Declined
                        # `xs.resize(n)` — set the length to exactly n: zero-fill new tail elements
                        # when growing, drop the tail when shrinking. Lowered by pushing a ZERO
                        # element while count < n (reusing emit_darray_push's growth), then storing
                        # n as the final count (which also performs the shrink case). Restricted to
                        # scalar element types so a `0` literal is a valid fill value.
                        if push_type.kind == TypeKind.DArray and push_method == "resize" and push_arguments.count == 1:
                            rz_elem: ValueType = darray_element_of(push_type, structs)
                            EmitStatus.Declined return if rz_elem.kind != TypeKind.Signed and rz_elem.kind != TypeKind.Unsigned and rz_elem.kind != TypeKind.Float
                            if darray_address_of_expr(push_object, local_scope, fns, structs, generics, runtime, m, ctx, builder) is rz_slot:
                                rz_i64: LLVMTypeRef = LLVMInt64TypeInContext(ctx)
                                rz_header: LLVMTypeRef = darray_llvm_type(structs, ctx)
                                rz_count_ptr: LLVMValueRef = LLVMBuildStructGEP2(builder, rz_header, rz_slot, 1, "resize.cnt.ptr")
                                if emit_expression(push_arguments[0], ValueType{kind: TypeKind.Unsigned, bits: 64}, local_scope, fns, structs, generics, runtime, m, ctx, builder) is rz_n:
                                    rz_function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                                    rz_cond: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, rz_function, "resize.cond")
                                    rz_push_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, rz_function, "resize.push")
                                    rz_after: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, rz_function, "resize.after")
                                    _ = LLVMBuildBr(builder, rz_cond)
                                    LLVMPositionBuilderAtEnd(builder, rz_cond)
                                    # Grow only while count < n; the ULT stops exactly at n. If the
                                    # array is already >= n the loop body never runs.
                                    rz_cur: LLVMValueRef = LLVMBuildLoad2(builder, rz_i64, rz_count_ptr, "resize.cur")
                                    rz_more: LLVMValueRef = LLVMBuildICmp(builder, 36, rz_cur, rz_n, "resize.more")
                                    _ = LLVMBuildCondBr(builder, rz_more, rz_push_block, rz_after)
                                    LLVMPositionBuilderAtEnd(builder, rz_push_block)
                                    if emit_darray_push(rz_slot, push_type, Expr.IntLit(0), local_scope, fns, structs, generics, runtime, m, ctx, builder):
                                        _ = LLVMBuildBr(builder, rz_cond)
                                        LLVMPositionBuilderAtEnd(builder, rz_after)
                                        # Final count is exactly n: a no-op after growth, the shrink
                                        # (drop the tail) when the array started longer than n.
                                        _ = LLVMBuildStore(builder, rz_n, rz_count_ptr)
                                        return EmitStatus.Open
                                    return EmitStatus.Declined
                            return EmitStatus.Declined
                        # `xs.extend(ys)` — append every element of the source darray to the
                        # target. Lowered as a push loop over the source's elements (behaviourally
                        # identical to stage0's grow+copy; exit-code-verified). The per-element
                        # value rides as a synthesized `ys[__extend_idx]` index expression so it
                        # reuses emit_darray_push (which handles growth) and the index-read path.
                        if push_type.kind == TypeKind.DArray and push_method == "extend" and push_arguments.count == 1:
                            ext_source_type: mutable ValueType = darray_type_behind_expr(push_arguments[0], local_scope, structs)
                            ext_source_type <- expression_type(push_arguments[0], local_scope, fns, structs, generics) if ext_source_type.kind == TypeKind.Unmodeled
                            # `darray[u8].extend(sview)` is the byte-copy form used by the
                            # compiler's header/parser tooling (`out.extend(text)`). A string
                            # view is not a darray, so the darray-only path below would decline
                            # every such helper and leave its body as an unresolved declaration.
                            # A STRING-LITERAL source (`domain_storage.extend("elisa.disjoint.")`)
                            # emits as an sview `{ptr, len}` at expected SView, so it reuses this path.
                            ext_source_is_strlit: mutable bool = false
                            if push_arguments[0] is Expr.StringLit(ext_strlit_text):
                                ext_source_is_strlit <- true
                            if (ext_source_type.kind == TypeKind.SView or ext_source_is_strlit) and push_type.kind == TypeKind.DArray:
                                ext_byte_element: ValueType = darray_element_of(push_type, structs)
                                EmitStatus.Declined return if ext_byte_element.kind != TypeKind.Unsigned or ext_byte_element.bits != 8
                                ext_sview_source_type: ValueType = ValueType{kind: TypeKind.SView, bits: 0}
                                if darray_address_of_expr(push_object, local_scope, fns, structs, generics, runtime, m, ctx, builder) is ext_sview_target_slot:
                                    if emit_expression(push_arguments[0], ext_sview_source_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is ext_sview_value:
                                        ext_sview_len: LLVMValueRef = LLVMBuildExtractValue(builder, ext_sview_value, 1, "extend.sview.len")
                                        ext_sview_index_slot: LLVMValueRef = LLVMBuildAlloca(builder, LLVMInt64TypeInContext(ctx), "extend.sview.i")
                                        _ = LLVMBuildStore(builder, LLVMConstInt(LLVMInt64TypeInContext(ctx), 0, 0), ext_sview_index_slot)
                                        declare_local(local_scope, "__extend_sview_idx", ext_sview_index_slot, ValueType{kind: TypeKind.Signed, bits: 64})
                                        ext_sview_function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                                        ext_sview_cond: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, ext_sview_function, "extend.sview.cond")
                                        ext_sview_body: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, ext_sview_function, "extend.sview.body")
                                        ext_sview_done: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, ext_sview_function, "extend.sview.done")
                                        _ = LLVMBuildBr(builder, ext_sview_cond)
                                        LLVMPositionBuilderAtEnd(builder, ext_sview_cond)
                                        ext_sview_index: LLVMValueRef = LLVMBuildLoad2(builder, LLVMInt64TypeInContext(ctx), ext_sview_index_slot, "extend.sview.cur")
                                        ext_sview_more: LLVMValueRef = LLVMBuildICmp(builder, 36, ext_sview_index, ext_sview_len, "extend.sview.more")
                                        _ = LLVMBuildCondBr(builder, ext_sview_more, ext_sview_body, ext_sview_done)
                                        LLVMPositionBuilderAtEnd(builder, ext_sview_body)
                                        ext_sview_index_expr: Expr = Expr.Index(push_arguments[0], Expr.Ident("__extend_sview_idx", push_call_line), push_call_line)
                                        if emit_darray_push(ext_sview_target_slot, push_type, ext_sview_index_expr, local_scope, fns, structs, generics, runtime, m, ctx, builder):
                                            ext_sview_next: LLVMValueRef = LLVMBuildAdd(builder, ext_sview_index, LLVMConstInt(LLVMInt64TypeInContext(ctx), 1, 0), "extend.sview.next")
                                            _ = LLVMBuildStore(builder, ext_sview_next, ext_sview_index_slot)
                                            _ = LLVMBuildBr(builder, ext_sview_cond)
                                            LLVMPositionBuilderAtEnd(builder, ext_sview_done)
                                            return EmitStatus.Open
                                        return EmitStatus.Declined
                                return EmitStatus.Declined
                            EmitStatus.Declined return if ext_source_type.kind != TypeKind.DArray
                            if darray_address_of_expr(push_object, local_scope, fns, structs, generics, runtime, m, ctx, builder) is ext_target_slot:
                                if darray_address_of_expr(push_arguments[0], local_scope, fns, structs, generics, runtime, m, ctx, builder) is ext_source_slot:
                                    ext_i64: LLVMTypeRef = LLVMInt64TypeInContext(ctx)
                                    ext_header: LLVMTypeRef = darray_llvm_type(structs, ctx)
                                    # Snapshot the source count before the loop (a self-extend then
                                    # copies only the original elements, matching a grow+copy).
                                    ext_count_ptr: LLVMValueRef = LLVMBuildStructGEP2(builder, ext_header, ext_source_slot, 1, "extend.src.cnt.ptr")
                                    ext_count: LLVMValueRef = LLVMBuildLoad2(builder, ext_i64, ext_count_ptr, "extend.src.cnt")
                                    ext_idx_slot: LLVMValueRef = LLVMBuildAlloca(builder, ext_i64, "extend.i")
                                    _ = LLVMBuildStore(builder, LLVMConstInt(ext_i64, 0, 0), ext_idx_slot)
                                    declare_local(local_scope, "__extend_idx", ext_idx_slot, ValueType{kind: TypeKind.Signed, bits: 64})
                                    ext_function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                                    ext_cond: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, ext_function, "extend.cond")
                                    ext_bodyb: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, ext_function, "extend.body")
                                    ext_done: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, ext_function, "extend.done")
                                    _ = LLVMBuildBr(builder, ext_cond)
                                    LLVMPositionBuilderAtEnd(builder, ext_cond)
                                    ext_cur: LLVMValueRef = LLVMBuildLoad2(builder, ext_i64, ext_idx_slot, "extend.cur")
                                    ext_more: LLVMValueRef = LLVMBuildICmp(builder, 40, ext_cur, ext_count, "extend.more")
                                    _ = LLVMBuildCondBr(builder, ext_more, ext_bodyb, ext_done)
                                    LLVMPositionBuilderAtEnd(builder, ext_bodyb)
                                    ext_index_expr: Expr = Expr.Index(push_arguments[0], Expr.Ident("__extend_idx", push_call_line), push_call_line)
                                    if emit_darray_push(ext_target_slot, push_type, ext_index_expr, local_scope, fns, structs, generics, runtime, m, ctx, builder):
                                        _ = LLVMBuildStore(builder, LLVMBuildAdd(builder, ext_cur, LLVMConstInt(ext_i64, 1, 0), "extend.next"), ext_idx_slot)
                                        _ = LLVMBuildBr(builder, ext_cond)
                                        LLVMPositionBuilderAtEnd(builder, ext_done)
                                        return EmitStatus.Open
                                    return EmitStatus.Declined
                                return EmitStatus.Declined
                            return EmitStatus.Declined
                    # `try f(args)` (statement, propagating — the parser strips the `try` head,
                    # leaving a bare call to an ERROR fn). It uses the error ABI (out-slot + i32
                    # status), and on a NONZERO status propagates: unwind and return that code
                    # from THIS (error-returning) function. The std dict's `try arena_dict_reserve
                    # (…)` is exactly this. Without it the call omits the out-param and every
                    # later argument shifts left (m gets a scalar → null-deref crash).
                    if push_callee is Expr.Ident(propagate_name, propagate_name_line):
                        if error_callee_is(fns, generics, propagate_name):
                            return emit_propagating_try(propagate_name, push_arguments, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)
                    # Any other call in STATEMENT position — typically a `-> void` call like
                    # `bump(c)`. The result (if any) is simply discarded; `expected` is Void
                    # because a statement wants no value.
                    if emit_call(push_callee, push_arguments, push_argument_names, local_scope, fns, structs, generics, runtime, m, ctx, builder) is discarded_result:
                        return EmitStatus.Open
                return EmitStatus.Declined

            if statement is Stmt.Return(return_value_opt, return_line):
                if return_value_opt is return_value:
                    # `await task` may arrive here as a value-transparent block after the
                    # semantic expression walkers. Lower it directly in return position as a
                    # fallback to the ordinary expression emitter, preserving the task value
                    # and avoiding a synchronous call-through.
                    if fn_return_head_at(return_line, structs) == "__await":
                        await_operand: mutable Expr = return_value
                        if return_value is Expr.Block(await_block_statements, await_block_value, await_block_captures, await_block_line):
                            await_operand <- await_block_value
                        await_task_type: ValueType = expression_type(await_operand, local_scope, fns, structs, generics)
                        await_base: mutable sview = ""
                        await_arg_start: mutable usize = 0
                        await_arg_count: mutable usize = 0
                        if generic_struct_instantiation_of(structs, await_task_type, await_base, await_arg_start, await_arg_count) and await_base == "Task" and await_arg_count >= 1:
                            await_result_type: ValueType = copied_type(structs.generic_struct_inst_args[await_arg_start])
                            await_types: mutable darray[ValueType] = [await_result_type]
                            await_arguments: mutable darray[Expr] = [await_operand]
                            if emit_generic_call("pool_await", await_types, await_arguments, [], local_scope, fns, structs, generics, runtime, m, ctx, builder) is awaited_return_value:
                                EmitStatus.Declined return if not emit_ensure_checks(awaited_return_value, return_type, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                                emit_region_unwind(regions, runtime, builder)
                                if runtime.in_error_fn:
                                    _ = LLVMBuildStore(builder, awaited_return_value, runtime.error_out)
                                    _ = LLVMBuildRet(builder, LLVMConstInt(LLVMInt32TypeInContext(ctx), 0, 0))
                                    return EmitStatus.Terminated
                                _ = LLVMBuildRet(builder, awaited_return_value)
                                return EmitStatus.Terminated
                        return EmitStatus.Declined
                    # `return try f(x)` — the value form of a propagating try in return position.
                    if return_value is Expr.Call(ret_try_callee, ret_try_args, ret_try_arg_names, ret_try_call_line):
                        if ret_try_callee is Expr.Ident(ret_try_name, ret_try_name_line):
                            if error_callee_is(fns, generics, ret_try_name):
                                if emit_propagating_try_value(ret_try_name, ret_try_args, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder) is ret_try_value:
                                    EmitStatus.Declined return if not emit_ensure_checks(ret_try_value, return_type, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                                    emit_region_unwind(regions, runtime, builder)
                                    if runtime.in_error_fn:
                                        _ = LLVMBuildStore(builder, ret_try_value, runtime.error_out)
                                        _ = LLVMBuildRet(builder, LLVMConstInt(LLVMInt32TypeInContext(ctx), 0, 0))
                                        return EmitStatus.Terminated
                                    _ = LLVMBuildRet(builder, ret_try_value)
                                    return EmitStatus.Terminated
                                return EmitStatus.Declined
                    emitted: LLVMValueRef? = emit_expression(return_value, return_type, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                    if emitted is return_constant:
                        # Postconditions run BEFORE the unwind: a predicate may read a
                        # container the auto region still backs.
                        EmitStatus.Declined return if not emit_ensure_checks(return_constant, return_type, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                        # Unwind EVERY live owned region on the way out — the function's auto
                        # region AND any enclosing `region NAME:` scopes. This lives on the
                        # return path rather than at one function exit because a return can
                        # happen from inside any depth of scope.
                        EmitStatus.Declined return if not emit_deferred_actions(local_scope, false, fns, structs, generics, runtime, m, ctx, builder)
                        emit_region_unwind(regions, runtime, builder)
                        # An error fn writes the SUCCESS value through its out-param and
                        # returns the i32 success code 0, rather than returning the value.
                        if runtime.in_error_fn:
                            _ = LLVMBuildStore(builder, return_constant, runtime.error_out)
                            _ = LLVMBuildRet(builder, LLVMConstInt(LLVMInt32TypeInContext(ctx), 0, 0))
                            return EmitStatus.Terminated
                        _ = LLVMBuildRet(builder, return_constant)
                        return EmitStatus.Terminated
                    return EmitStatus.Declined
                # A bare `return` — only valid in a `-> void` function. A `void error[E]` fn
                # still uses the i32-status ABI, so success returns the 0 code, not `ret void`.
                if return_type.kind == TypeKind.Void:
                    # A `-> void` fn with an `ensure` has no `result` to bind. Rather than
                    # drop the check (an unenforced contract), decline the function.
                    EmitStatus.Declined return if structs.pending_ensures.count > 0
                    EmitStatus.Declined return if not emit_deferred_actions(local_scope, false, fns, structs, generics, runtime, m, ctx, builder)
                    emit_region_unwind(regions, runtime, builder)
                    if runtime.in_error_fn:
                        _ = LLVMBuildRet(builder, LLVMConstInt(LLVMInt32TypeInContext(ctx), 0, 0))
                    else:
                        _ = LLVMBuildRetVoid(builder)
                    return EmitStatus.Terminated
                return EmitStatus.Declined

            # `x: i64 = value` — a fresh slot plus the initializing store. The slot is
            # allocated at the CURRENT position rather than hoisted to the entry block;
            # mem2reg still promotes it, and the subset has no loop-allocated locals.
            if statement is Stmt.VarDecl(var_name, var_type, var_value, var_line):
                # `_ = EXPR` — an explicit DISCARD (stage0 lowers a bare `x = v` to a VarDecl,
                # so a `_` target arrives here with no annotation). Emit the value for its side
                # effects at its own type and drop the result; nothing is bound. Without this a
                # discarded call (`_ = fetch_add(&a, 2)`, `_ = helper(5)`) declined at the
                # Unmodeled-annotation gate below.
                if var_name == "_":
                    dr_var_status: i64 = try_discarded_darray_reserve(var_value, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                    EmitStatus.Open return if dr_var_status == 1
                    EmitStatus.Declined return if dr_var_status < 0
                    discard_type: ValueType = expression_type(var_value, local_scope, fns, structs, generics)
                    discard_expected: ValueType = discard_type if discard_type.kind != TypeKind.Unmodeled else ValueType{kind: TypeKind.Signed, bits: 64}
                    if emit_expression(var_value, discard_expected, local_scope, fns, structs, generics, runtime, m, ctx, builder) is discarded_var_value:
                        _ = discarded_var_value
                        return EmitStatus.Open
                    return EmitStatus.Declined
                # `x: T = get OPT` — MONADIC UNWRAP of an optional. Present → bind the payload to
                # `x`; absent → PROPAGATE None: return a null optional from THIS function (which must
                # itself return an optional). The `get X else BODY` form runs BODY on absent instead.
                # index_map_get does `index: usize = get index_map_find_index(...)`.
                if var_value is Expr.GetElse(get_guarded, get_recovery, get_line):
                    get_opt_type: ValueType = expression_type(get_guarded, local_scope, fns, structs, generics)
                    EmitStatus.Declined return if get_opt_type.kind != TypeKind.Optional
                    # Propagation returns a null of THIS function's declared return type (an optional
                    # for the common `-> T?` case; whatever it is, a zero value is the None/empty).
                    EmitStatus.Declined return if get_recovery.count == 0 and return_type.kind == TypeKind.Unmodeled
                    get_payload_type: ValueType = optional_payload_of(get_opt_type, structs)
                    if emit_expression(get_guarded, get_opt_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is get_opt_value:
                        get_tag: LLVMValueRef = LLVMBuildExtractValue(builder, get_opt_value, 0, "get.tag")
                        get_payload: LLVMValueRef = LLVMBuildExtractValue(builder, get_opt_value, 1, "get.payload")
                        get_function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                        get_present: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, get_function, "get.present")
                        get_absent: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, get_function, "get.absent")
                        _ = LLVMBuildCondBr(builder, get_tag, get_present, get_absent)
                        # ABSENT: `get X else BODY` runs BODY; bare `get X` propagates None.
                        LLVMPositionBuilderAtEnd(builder, get_absent)
                        if get_recovery.count == 0:
                            emit_region_unwind(regions, runtime, builder)
                            _ = LLVMBuildRet(builder, LLVMConstNull(llvm_type_of(return_type, structs, ctx)))
                        else:
                            get_recovery_status: EmitStatus = emit_statements(get_recovery, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)
                            EmitStatus.Declined return if get_recovery_status == EmitStatus.Declined
                            # An `else` body that falls through has no value to bind — require it to exit.
                            EmitStatus.Declined return if get_recovery_status == EmitStatus.Open
                        # PRESENT: bind the payload to `x` and continue.
                        LLVMPositionBuilderAtEnd(builder, get_present)
                        get_var_storage: mutable darray[u8] = []
                        get_var_slot: LLVMValueRef = build_entry_alloca(builder, llvm_type_of(get_payload_type, structs, ctx), sview_to_cstr(var_name, get_var_storage))
                        _ = LLVMBuildStore(builder, get_payload, get_var_slot)
                        declare_local(local_scope, var_name, get_var_slot, get_payload_type)
                        return EmitStatus.Open
                    return EmitStatus.Declined
                # The ANNOTATION decides the local's type, and the initializer is emitted
                # at that type — so `a: u8 = 200` stores a real u8.
                # Untyped loop-header binders (`x = expr`, machine mode/input locals) arrive
                # with Expr.Invalid as the annotation. Infer from the initializer so machine
                # desugar (`__machine_mode_0 = Enum.S`, `__machine_input_0 = n`) can emit.
                declared_type: mutable ValueType = annotation_value_type(var_type, structs)
                local_error_family: sview = local_error_family_at(var_line, structs)
                declared_type <- intern_error_union_type(declared_type, local_error_family, structs) if local_error_family != ""
                if declared_type.kind == TypeKind.Unmodeled:
                    declared_type <- expression_type(var_value, local_scope, fns, structs, generics)
                EmitStatus.Declined return if declared_type.kind == TypeKind.Unmodeled
                # `x: T = match SCRUT:` whose arms are BLOCKS (statements then a yield) — the
                # match-EXPRESSION emitter handles only single-expression arms and has no statement
                # context, so route it through the statement-level match-into-slot emitter.
                if var_value is Expr.Match(vm_scrutinee, vm_arms, vm_match_line):
                    return emit_match_into_slot(vm_scrutinee, vm_arms, declared_type, var_name, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)
                # A declaration without an initializer still needs a real storage
                # object.  In particular, fixed-size stack arrays are used as
                # scratch buffers by the runtime string helpers.  Expr.Invalid is
                # the parser's marker for this form, so materialize the language's
                # zero-initialized local rather than trying to emit it as a value.
                if var_value is Expr.Invalid or var_value is Expr.Absent:
                    uninitialized_storage: mutable darray[u8] = []
                    uninitialized_slot: LLVMValueRef = build_entry_alloca(builder, llvm_type_of(declared_type, structs, ctx), sview_to_cstr(var_name, uninitialized_storage))
                    uninitialized_alignment: u32 = struct_alignment(declared_type, structs)
                    LLVMSetAlignment(uninitialized_slot, uninitialized_alignment) if uninitialized_alignment != 0
                    _ = LLVMBuildStore(builder, LLVMConstNull(llvm_type_of(declared_type, structs, ctx)), uninitialized_slot)
                    declare_local(local_scope, var_name, uninitialized_slot, declared_type)
                    return EmitStatus.Open
                # `v: T = try f(x)` — the value form of a propagating try. The parser strips the
                # `try` head, leaving a bare call to an error-returning fn; the semantic checker
                # already required the `try`, so any error-call RHS here IS one. Emit the
                # propagate-on-error path and store the success value into the local.
                if var_value is Expr.Call(try_var_callee, try_var_args, try_var_arg_names, try_var_call_line):
                    if try_var_callee is Expr.Ident(try_var_name, try_var_name_line):
                        if declared_type.kind == TypeKind.ErrorUnion:
                            if emit_error_union_call_value(try_var_name, try_var_args, declared_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is union_var_value:
                                union_var_storage: mutable darray[u8] = []
                                union_var_slot: LLVMValueRef = build_entry_alloca(builder, llvm_type_of(declared_type, structs, ctx), sview_to_cstr(var_name, union_var_storage))
                                _ = LLVMBuildStore(builder, union_var_value, union_var_slot)
                                declare_local(local_scope, var_name, union_var_slot, declared_type)
                                return EmitStatus.Open
                        if error_callee_is(fns, generics, try_var_name):
                            if emit_propagating_try_value(try_var_name, try_var_args, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder) is try_var_value:
                                try_var_storage: mutable darray[u8] = []
                                try_var_slot: LLVMValueRef = build_entry_alloca(builder, llvm_type_of(declared_type, structs, ctx), sview_to_cstr(var_name, try_var_storage))
                                stored_try_value: mutable LLVMValueRef = try_var_value
                                if declared_type.kind == TypeKind.ErrorUnion:
                                    stored_try_value <- build_error_union_success(try_var_value, error_union_payload_of(declared_type, structs), declared_type, structs, runtime, ctx, builder)
                                _ = LLVMBuildStore(builder, stored_try_value, try_var_slot)
                                declare_local(local_scope, var_name, try_var_slot, declared_type)
                                return EmitStatus.Open
                            return EmitStatus.Declined
                # Assigning an OPTIONAL value to a NON-optional local is a type error stage0
                # rejects ("variable expects T, got T?"); DECLINE rather than silently unwrap.
                # Also stops a miscompile: stage1's parser erases the control-flow else of
                # `x: i64 = get f() else return 7`, collapsing it to `x: i64 = f()` (f -> i64?).
                # `v: T = get OPT else return X` — the guarded optional is unwrapped on the
                # PRESENT path; the absent path runs the recovery, which terminates (a
                # `return`/`break`/`continue` is the only recovery form this node carries).
                # The local is therefore a plain `T` wherever it is live.
                if var_value is Expr.GetElse(get_guarded, get_recovery, get_else_line):
                    guarded_type: ValueType = expression_type(get_guarded, local_scope, fns, structs, generics)
                    EmitStatus.Declined return if guarded_type.kind != TypeKind.Optional
                    get_payload: ValueType = optional_payload_of(guarded_type, structs)
                    EmitStatus.Declined return if get_payload.kind != declared_type.kind or get_payload.bits != declared_type.bits
                    if emit_expression(get_guarded, guarded_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is get_optional:
                        get_fn: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                        get_present: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, get_fn, "get.present")
                        get_absent: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, get_fn, "get.absent")
                        get_tag: LLVMValueRef = LLVMBuildExtractValue(builder, get_optional, 0, "get.else.tag")
                        _ = LLVMBuildCondBr(builder, get_tag, get_present, get_absent)
                        # ABSENT: the recovery runs and must leave the block terminated. If it
                        # somehow does not, DECLINE rather than fall through into the present
                        # path, which would read an absent optional's payload.
                        LLVMPositionBuilderAtEnd(builder, get_absent)
                        recovery_status: EmitStatus = emit_statements(get_recovery, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)
                        EmitStatus.Declined return if recovery_status != EmitStatus.Terminated
                        LLVMPositionBuilderAtEnd(builder, get_present)
                        get_value: LLVMValueRef = LLVMBuildExtractValue(builder, get_optional, 1, "get.else.payload")
                        get_storage: mutable darray[u8] = []
                        get_slot: LLVMValueRef = build_entry_alloca(builder, llvm_type_of(declared_type, structs, ctx), sview_to_cstr(var_name, get_storage))
                        _ = LLVMBuildStore(builder, get_value, get_slot)
                        declare_local(local_scope, var_name, get_slot, declared_type)
                        return EmitStatus.Open
                    return EmitStatus.Declined
                var_value_type: ValueType = expression_type(var_value, local_scope, fns, structs, generics)
                if var_value_type.kind == TypeKind.Optional and declared_type.kind != TypeKind.Optional:
                    # BARE `get OPT` — the parser ERASES `get X` (no `else`) to the inner
                    # optional-producing expression plus a `__checked_get` line annotation, so
                    # a get-unwrap arrives here as a plain `x: T = OPT` with OPT: T?. stage0
                    # REJECTS an unnarrowed Optional->non-optional VarDecl outright ("variable
                    # expects T, got T?"), so any such decl that is NOT narrowed and reaches the
                    # backend IS a validated bare `get`: bind the payload on PRESENT, PROPAGATE
                    # None on ABSENT (this fn itself returns the optional the None flows into —
                    # `index_map_get` does `index: usize = get index_map_find_index(...)`).
                    if not path_is_narrowed(var_value, structs):
                        EmitStatus.Declined return if return_type.kind != TypeKind.Optional
                        bare_get_payload: ValueType = optional_payload_of(var_value_type, structs)
                        EmitStatus.Declined return if bare_get_payload.kind != declared_type.kind or bare_get_payload.bits != declared_type.bits
                        if emit_expression(var_value, var_value_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is bare_get_optional:
                            bare_get_fn: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                            bare_get_present: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, bare_get_fn, "get.bare.present")
                            bare_get_absent: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, bare_get_fn, "get.bare.absent")
                            bare_get_tag: LLVMValueRef = LLVMBuildExtractValue(builder, bare_get_optional, 0, "get.bare.tag")
                            _ = LLVMBuildCondBr(builder, bare_get_tag, bare_get_present, bare_get_absent)
                            # ABSENT: unwind live regions, then return this fn's None (a zeroed
                            # optional aggregate — tag 0 = absent — of the declared return type).
                            LLVMPositionBuilderAtEnd(builder, bare_get_absent)
                            emit_region_unwind(regions, runtime, builder)
                            _ = LLVMBuildRet(builder, LLVMConstNull(llvm_type_of(return_type, structs, ctx)))
                            # PRESENT: bind the payload and continue.
                            LLVMPositionBuilderAtEnd(builder, bare_get_present)
                            bare_get_value: LLVMValueRef = LLVMBuildExtractValue(builder, bare_get_optional, 1, "get.bare.payload")
                            bare_get_storage: mutable darray[u8] = []
                            bare_get_slot: LLVMValueRef = build_entry_alloca(builder, llvm_type_of(declared_type, structs, ctx), sview_to_cstr(var_name, bare_get_storage))
                            _ = LLVMBuildStore(builder, bare_get_value, bare_get_slot)
                            declare_local(local_scope, var_name, bare_get_slot, declared_type)
                            return EmitStatus.Open
                        return EmitStatus.Declined
                    # NARROWED by an earlier `assert PATH != null`: stage0 accepts the
                    # assignment (and emits a plain pointer copy, its `T&?` being a bare
                    # ptr). stage1's `{i1, ptr}` needs the payload extracted.
                    narrowed_payload: ValueType = optional_payload_of(var_value_type, structs)
                    EmitStatus.Declined return if narrowed_payload.kind != declared_type.kind or narrowed_payload.bits != declared_type.bits
                    if emit_expression(var_value, var_value_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is narrowed_optional:
                        narrowed_value: LLVMValueRef = LLVMBuildExtractValue(builder, narrowed_optional, 1, "narrow.payload")
                        narrow_storage: mutable darray[u8] = []
                        narrow_slot: LLVMValueRef = build_entry_alloca(builder, llvm_type_of(declared_type, structs, ctx), sview_to_cstr(var_name, narrow_storage))
                        _ = LLVMBuildStore(builder, narrowed_value, narrow_slot)
                        declare_local(local_scope, var_name, narrow_slot, declared_type)
                        return EmitStatus.Open
                    return EmitStatus.Declined
                if emit_expression(var_value, declared_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is initial:
                    name_storage: mutable darray[u8] = []
                    slot: LLVMValueRef = build_entry_alloca(builder, llvm_type_of(declared_type, structs, ctx), sview_to_cstr(var_name, name_storage))
                    local_alignment: u32 = struct_alignment(declared_type, structs)
                    LLVMSetAlignment(slot, local_alignment) if local_alignment != 0
                    _ = LLVMBuildStore(builder, initial, slot)
                    emit_trace_value(var_name, var_line, initial, declared_type, runtime, ctx, builder)
                    declare_local(local_scope, var_name, slot, declared_type)
                    # arg_no 0 = a LOCAL (DW_TAG_variable), not a formal parameter.
                    declare_debug_variable(var_name, slot, declared_type, 0, var_line, LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder)), runtime, structs, ctx, builder)
                    return EmitStatus.Open
                return EmitStatus.Declined

            # `x <- value`. `<-` is Elisa's ASSIGNMENT operator; `=` is DECLARATION
            # (`x: T = v`, or bare `x = v` which stage0 lowers to a fresh VarDeclStmt —
            # `x = 42` after `x: i64 = 1` is "duplicate local", not a store). stage1's
            # parser currently folds BOTH `<-` and `=` into Stmt.Assign, so the operator
            # must be checked here: modeling `=` as a store would silently contradict
            # stage0, where `i = i + 1` in a loop body declares a fresh shadow and the
            # outer `i` never moves (an infinite loop, no diagnostic — observed).
            # Compound assignment (`+=`) and non-ident targets also decline.
            if statement is Stmt.Assign(assign_target, assign_operator, assign_value, assign_line):
                # `_ = EXPR` — an explicit DISCARD (both `=` and `<-` fold to Stmt.Assign).
                # Emit the value for its side effects and drop the result; bind nothing. A
                # discarded call (`_ = helper(5)`, `_ = fetch_add(&a, 2)`) otherwise fell to the
                # non-ident/`=`-target declines below.
                if assign_target is Expr.Ident(assign_discard_name, assign_discard_line):
                    if assign_discard_name == "_":
                        dr_assign_status: i64 = try_discarded_darray_reserve(assign_value, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                        EmitStatus.Open return if dr_assign_status == 1
                        EmitStatus.Declined return if dr_assign_status < 0
                        discard_assign_type: ValueType = expression_type(assign_value, local_scope, fns, structs, generics)
                        discard_assign_expected: ValueType = discard_assign_type if discard_assign_type.kind != TypeKind.Unmodeled else ValueType{kind: TypeKind.Signed, bits: 64}
                        if emit_expression(assign_value, discard_assign_expected, local_scope, fns, structs, generics, runtime, m, ctx, builder) is discarded_assign_value:
                            _ = discarded_assign_value
                            return EmitStatus.Open
                        return EmitStatus.Declined
                # `rebind a: T, lexer = call(...)` / `rebind a, b <- call(...)` — parser lowers
                # rebind to Assign(Array([targets…]), op, value). Stage0: emit the call once,
                # bind the primary result to the first target, and treat trailing targets that
                # name existing lmut/locals as claims (no extra IR — lmut mutation is by ptr).
                # Without this, every lexer/parser `rebind token, lexer = lexer.next_token()`
                # declines and gen2 cannot compile the product frontend.
                if assign_target is Expr.Array(rebind_targets, rebind_array_line):
                    EmitStatus.Declined return if rebind_targets.count == 0
                    # `a, b = while COND |a: T = …, b: U = …| -> a, b:` — a LOOP-EXPRESSION with a
                    # tuple yield. wrap_loop_header lowers it to `Assign(Array([a,b]), =, Block(decls +
                    # loop, yield=(a,b), captures))`. Emit the block's statements (its capture decls
                    # declare a/b as loop-carried locals and the loop runs), then bind each target
                    # from the corresponding yield element (a copy; usually the same-named local).
                    if assign_value is Expr.Block(bv_statements, bv_value, bv_captures, bv_block_line):
                        bv_status: EmitStatus = emit_statements(bv_statements, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)
                        EmitStatus.Declined return if bv_status == EmitStatus.Declined
                        if bv_value is Expr.Tuple(bv_elements, bv_tuple_line):
                            EmitStatus.Declined return if bv_elements.count != rebind_targets.count
                            bv_declined: mutable bool = false
                            for bv_i in 0..<bv_elements.count |bv_declined, rebind_targets, bv_elements, local_scope, fns, structs, generics, runtime, m, ctx, builder|:
                                continue if bv_declined
                                if rebind_targets[bv_i] is Expr.Ident(bv_tname, bv_tline):
                                    bv_el_type: ValueType = expression_type(bv_elements[bv_i], local_scope, fns, structs, generics)
                                    if bv_el_type.kind == TypeKind.Unmodeled:
                                        bv_declined <- true
                                    elif emit_expression(bv_elements[bv_i], bv_el_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is bv_el_value:
                                        bv_slot_storage: mutable darray[u8] = []
                                        bv_slot: LLVMValueRef = LLVMBuildAlloca(builder, llvm_type_of(bv_el_type, structs, ctx), sview_to_cstr(bv_tname, bv_slot_storage))
                                        _ = LLVMBuildStore(builder, bv_el_value, bv_slot)
                                        declare_local(local_scope, bv_tname, bv_slot, bv_el_type)
                                    else:
                                        bv_declined <- true
                                else:
                                    bv_declined <- true
                            EmitStatus.Declined return if bv_declined
                            return EmitStatus.Open
                        return EmitStatus.Declined
                    if rebind_targets[0] is Expr.Ident(rb_name, rb_line):
                        # `rebind X: T, parser = get parser.method()` — value-position BARE `get`:
                        # the guarded method returns an optional (its receiver `parser` is mutated
                        # in place, the trailing target); PROPAGATE None on absent (this fn returns
                        # an optional), bind X's payload on present. emit_expression has no GetElse
                        # value case and the parser does NOT strip a rebind's `get`, so without this
                        # every `rebind X: Ast::Expr = get parser.…()` (pervasive in the parser
                        # dispatchers) declined. Mirrors the VarDecl bare-get path.
                        if assign_value is Expr.GetElse(rb_get_guarded, rb_get_recovery, rb_get_gline):
                            if rb_get_recovery.count == 0 and return_type.kind == TypeKind.Optional:
                                rb_get_opt_type: mutable ValueType = expression_type(rb_get_guarded, local_scope, fns, structs, generics)
                                # Two-level match (NOT a single nested `is Expr.Call(Expr.Field(_,n,_),…)`):
                                # the backend's packed-is binds only TOP-LEVEL fields, so a nested pattern
                                # that binds an inner name would itself decline during self-host.
                                if rb_get_opt_type.kind != TypeKind.Optional and rb_get_guarded is Expr.Call(rb_get_callee, rb_gm_args, _, _):
                                    if rb_get_callee is Expr.Field(_, rb_gm_name, _):
                                        rb_gm_ret: mutable ValueType = lookup_return_type(fns, "Parser", rb_gm_name)
                                        rb_gm_ret <- lookup_return_type(fns, "", rb_gm_name) if rb_gm_ret.kind == TypeKind.Unmodeled
                                        rb_gm_idx: mutable i64 = function_index_of_arity(fns, "Parser", rb_gm_name, rb_gm_args.count + 1)
                                        rb_gm_idx <- function_index_of(fns, "Parser", rb_gm_name) if rb_gm_idx < 0
                                        rb_gm_ret <- copied_type(fns.returns[rb_gm_idx.usize()]) if rb_gm_idx >= 0
                                        rb_get_opt_type <- rb_gm_ret
                                EmitStatus.Declined return if rb_get_opt_type.kind != TypeKind.Optional
                                rb_get_payload: ValueType = optional_payload_of(rb_get_opt_type, structs)
                                EmitStatus.Declined return if rb_get_payload.kind == TypeKind.Unmodeled
                                if emit_expression(rb_get_guarded, rb_get_opt_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is rb_get_optional:
                                    rb_get_fn: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                                    rb_get_present: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, rb_get_fn, "rb.get.present")
                                    rb_get_absent: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, rb_get_fn, "rb.get.absent")
                                    rb_get_tag: LLVMValueRef = LLVMBuildExtractValue(builder, rb_get_optional, 0, "rb.get.tag")
                                    _ = LLVMBuildCondBr(builder, rb_get_tag, rb_get_present, rb_get_absent)
                                    LLVMPositionBuilderAtEnd(builder, rb_get_absent)
                                    emit_region_unwind(regions, runtime, builder)
                                    _ = LLVMBuildRet(builder, LLVMConstNull(llvm_type_of(return_type, structs, ctx)))
                                    LLVMPositionBuilderAtEnd(builder, rb_get_present)
                                    rb_get_value: LLVMValueRef = LLVMBuildExtractValue(builder, rb_get_optional, 1, "rb.get.payload")
                                    rb_get_storage: mutable darray[u8] = []
                                    rb_get_slot: LLVMValueRef = LLVMBuildAlloca(builder, llvm_type_of(rb_get_payload, structs, ctx), sview_to_cstr(rb_name, rb_get_storage))
                                    _ = LLVMBuildStore(builder, rb_get_value, rb_get_slot)
                                    declare_local(local_scope, rb_name, rb_get_slot, rb_get_payload)
                                    return EmitStatus.Open
                                return EmitStatus.Declined
                        # `parser, _ <- parser.advance()` is the lmut thread-claim form:
                        # `parser` names the receiver being mutated and `_` discards the
                        # returned Token. It must not bind that Token over the Parser& slot.
                        # The same shape occurs throughout the self-hosting parser/lexer.
                        if lookup_type(local_scope, rb_name).kind == TypeKind.Ref and assign_value is Expr.Call(rb_claim_callee, rb_claim_args, rb_claim_arg_names, rb_claim_line):
                            if rb_claim_callee is Expr.Field(rb_claim_recv, rb_method_name, rb_method_line):
                                if rb_claim_recv is Expr.Ident(rb_receiver_name, rb_receiver_line):
                                    if rb_receiver_name == rb_name:
                                        rb_claim_type: mutable ValueType = expression_type(assign_value, local_scope, fns, structs, generics)
                                        if rb_claim_type.kind == TypeKind.Unmodeled:
                                            rb_claim_ret: mutable ValueType = lookup_return_type(fns, "Parser", rb_method_name)
                                            rb_claim_ret <- lookup_return_type(fns, "", rb_method_name) if rb_claim_ret.kind == TypeKind.Unmodeled
                                            rb_claim_index: mutable i64 = function_index_of_arity(fns, "Parser", rb_method_name, rb_claim_args.count + 1)
                                            rb_claim_index <- function_index_of(fns, "Parser", rb_method_name) if rb_claim_index < 0
                                            rb_claim_ret <- copied_type(fns.returns[rb_claim_index.usize()]) if rb_claim_index >= 0
                                            rb_claim_type <- rb_claim_ret if rb_claim_ret.kind != TypeKind.Unmodeled
                                        if emit_expression(assign_value, rb_claim_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is rb_claim_value:
                                            # `parser, value <- parser.expression()` — the RECEIVER is
                                            # target 0 (mutated through its pointer, no store needed)
                                            # and the returned value belongs to target 1. Dropping it
                                            # left the second name at its previous value: every
                                            # `Stmt.Return(value, …)` in the self-hosted parser was
                                            # built with `value` still null, so gen2 emitted nothing.
                                            # `parser, _ <- parser.advance()` still discards.
                                            if rebind_targets.count > 1 and rb_claim_type.kind != TypeKind.Void and rb_claim_type.kind != TypeKind.Unmodeled:
                                                if rebind_targets[1] is Expr.Ident(rb_claim_second, rb_claim_second_line):
                                                    if rb_claim_second != "_":
                                                        rb_claim_existing: LLVMValueRef? = lookup_slot(local_scope, rb_claim_second)
                                                        rb_claim_bound: mutable bool = false
                                                        if rb_claim_existing is rb_claim_slot:
                                                            rb_claim_here: LLVMBasicBlockRef = LLVMGetInsertBlock(builder)
                                                            rb_claim_decl_block: LLVMBasicBlockRef = LLVMGetInstructionParent(rb_claim_slot)
                                                            rb_claim_fn: LLVMValueRef = LLVMGetBasicBlockParent(rb_claim_here)
                                                            rb_claim_entry: LLVMBasicBlockRef = LLVMGetEntryBasicBlock(rb_claim_fn)
                                                            rb_claim_prior: ValueType = lookup_type(local_scope, rb_claim_second)
                                                            if (rb_claim_decl_block == rb_claim_here or rb_claim_decl_block == rb_claim_entry) and rb_claim_prior.kind == rb_claim_type.kind and rb_claim_prior.bits == rb_claim_type.bits:
                                                                _ = LLVMBuildStore(builder, rb_claim_value, rb_claim_slot)
                                                                rb_claim_bound <- true
                                                        if not rb_claim_bound:
                                                            rb_claim_alloca: LLVMValueRef = build_entry_alloca(builder, llvm_type_of(rb_claim_type, structs, ctx), "rebind.claim")
                                                            _ = LLVMBuildStore(builder, rb_claim_value, rb_claim_alloca)
                                                            declare_local(local_scope, rb_claim_second, rb_claim_alloca, rb_claim_type)
                                            return EmitStatus.Open
                                        return EmitStatus.Declined
                        rb_type: mutable ValueType = expression_type(assign_value, local_scope, fns, structs, generics)
                        if rb_type.kind == TypeKind.Unmodeled and assign_value is Expr.Call(rb_method_callee, rb_method_args, _, _):
                            if rb_method_callee is Expr.Field(_, rb_method_name, _):
                                parser_method_type: mutable ValueType = lookup_return_type(fns, "Parser", rb_method_name)
                                parser_method_type <- lookup_return_type(fns, "", rb_method_name) if parser_method_type.kind == TypeKind.Unmodeled
                                parser_method_index: mutable i64 = function_index_of_arity(fns, "Parser", rb_method_name, rb_method_args.count + 1)
                                parser_method_index <- function_index_of(fns, "Parser", rb_method_name) if parser_method_index < 0
                                parser_method_type <- copied_type(fns.returns[parser_method_index.usize()]) if parser_method_index >= 0
                                parser_method_type <- ValueType{kind: TypeKind.Void, bits: 0} if rb_method_name == "skip_newlines"
                                rb_type <- parser_method_type if parser_method_type.kind != TypeKind.Unmodeled
                        rb_type <- lookup_type(local_scope, rb_name) if rb_type.kind == TypeKind.Unmodeled else rb_type
                        EmitStatus.Declined return if rb_type.kind == TypeKind.Unmodeled
                        if rb_type.kind == TypeKind.Void:
                            if emit_expression(assign_value, rb_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is rb_void_value:
                                _ = rb_void_value
                                return EmitStatus.Open
                            return EmitStatus.Declined
                        if emit_expression(assign_value, rb_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is rb_value:
                            # Reuse a slot only when its alloca dominates this block (the
                            # usual loop-carried scalar rebind). A same-named declaration from
                            # a sibling arm does not dominate here, so shadow it with a fresh
                            # arm-local slot instead.
                            rb_existing: LLVMValueRef? = lookup_slot(local_scope, rb_name)
                            rb_found_slot: mutable LLVMValueRef = zeroed
                            rb_use_existing: mutable bool = false
                            if rb_existing is rb_slot_value:
                                rb_found_slot <- rb_slot_value
                                rb_current_block: LLVMBasicBlockRef = LLVMGetInsertBlock(builder)
                                rb_existing_block: LLVMBasicBlockRef = LLVMGetInstructionParent(rb_slot_value)
                                rb_function: LLVMValueRef = LLVMGetBasicBlockParent(rb_current_block)
                                rb_entry_block: LLVMBasicBlockRef = LLVMGetEntryBasicBlock(rb_function)
                                rb_use_existing <- rb_existing_block == rb_current_block or rb_existing_block == rb_entry_block
                            if rb_use_existing:
                                _ = LLVMBuildStore(builder, rb_value, rb_found_slot)
                            else:
                                rb_alloca: LLVMValueRef = build_entry_alloca(builder, llvm_type_of(rb_type, structs, ctx), "rebind")
                                _ = LLVMBuildStore(builder, rb_value, rb_alloca)
                                declare_local(local_scope, rb_name, rb_alloca, rb_type)
                            # Trailing targets: lmut claims / existing names — stage0 emits no
                            # extra stores (pointer receivers already mutated in the call).
                            return EmitStatus.Open
                        return EmitStatus.Declined
                    return EmitStatus.Declined
                # Any assignment kills a narrowing proof about the target: the value the
                # `assert PATH != null` was about is gone, and a stale proof would unwrap a
                # fresh null. Done BEFORE the store so no path below can miss it.
                invalidate_narrowing(assign_target, structs)
                # `xs <- xs.push(v)` / `obj.field <- obj.field.push(v)` — stage0's darray push
                # mutates in place and returns the same container. Lower as in-place push on
                # the receiver address (same as the statement form `xs.push(v)`), not as a
                # full value rebuild. Lexer `pending_tokens <- pending_tokens.push(token)`.
                if assign_value is Expr.Call(push_assign_callee, push_assign_args, push_assign_arg_names, push_assign_line):
                    if push_assign_callee is Expr.Field(push_assign_object, push_assign_method, push_assign_method_line):
                        if push_assign_method == "push" and push_assign_args.count == 1:
                            push_assign_type: ValueType = darray_type_behind_expr(push_assign_object, local_scope, structs)
                            if push_assign_type.kind == TypeKind.DArray:
                                if darray_address_of_expr(push_assign_object, local_scope, fns, structs, generics, runtime, m, ctx, builder) is push_assign_slot:
                                    if emit_darray_push(push_assign_slot, push_assign_type, push_assign_args[0], local_scope, fns, structs, generics, runtime, m, ctx, builder):
                                        return EmitStatus.Open
                                return EmitStatus.Declined
                        # `xs <- xs.truncate(n)` — same in-place pattern as push-assign; used by
                        # lexer pop_indent / trim_finished_grouped_block_contexts (docs/120 §10
                        # wants the reassignment form on `lmut` paths).
                        if push_assign_method == "truncate" and push_assign_args.count == 1:
                            trunc_assign_type: ValueType = darray_type_behind_expr(push_assign_object, local_scope, structs)
                            if trunc_assign_type.kind == TypeKind.DArray:
                                if darray_address_of_expr(push_assign_object, local_scope, fns, structs, generics, runtime, m, ctx, builder) is trunc_assign_slot:
                                    trunc_i64: LLVMTypeRef = LLVMInt64TypeInContext(ctx)
                                    if emit_expression(push_assign_args[0], ValueType{kind: TypeKind.Unsigned, bits: 64}, local_scope, fns, structs, generics, runtime, m, ctx, builder) is trunc_n:
                                        trunc_header: LLVMTypeRef = darray_llvm_type(structs, ctx)
                                        trunc_count_ptr: LLVMValueRef = LLVMBuildStructGEP2(builder, trunc_header, trunc_assign_slot, 1, "trunc.assign.cnt.ptr")
                                        trunc_count: LLVMValueRef = LLVMBuildLoad2(builder, trunc_i64, trunc_count_ptr, "trunc.assign.cnt")
                                        trunc_smaller: LLVMValueRef = LLVMBuildICmp(builder, 36, trunc_n, trunc_count, "trunc.assign.lt")
                                        trunc_new: LLVMValueRef = LLVMBuildSelect(builder, trunc_smaller, trunc_n, trunc_count, "trunc.assign.new")
                                        _ = LLVMBuildStore(builder, trunc_new, trunc_count_ptr)
                                        return EmitStatus.Open
                                return EmitStatus.Declined
                # `PLACE as & <- value` — a REBORROW-ASSIGN to an optional-REFERENCE field
                # (`arena: mutable Arena&?`): store `value` (a pointer) as the PRESENT payload.
                # Parsed as an `as`-Binary target; the `&` leaf is the reinterpret marker. The
                # std dict binds `m.arena as & <- owner` to adopt its backing region.
                if assign_target is Expr.Binary(reborrow_place, reborrow_operator, reborrow_leaf, reborrow_line):
                    if reborrow_operator == TokenKind.As and assign_operator == TokenKind.LArrow:
                        reborrow_type: ValueType = struct_chain_type(reborrow_place, local_scope, structs)
                        EmitStatus.Declined return if reborrow_type.kind != TypeKind.Optional
                        reborrow_payload: ValueType = optional_payload_of(reborrow_type, structs)
                        EmitStatus.Declined return if reborrow_payload.kind != TypeKind.Ref
                        if struct_chain_address(reborrow_place, local_scope, fns, structs, generics, runtime, m, ctx, builder) is reborrow_address:
                            reborrow_llvm: LLVMTypeRef = llvm_type_of(reborrow_type, structs, ctx)
                            if emit_expression(assign_value, reborrow_payload, local_scope, fns, structs, generics, runtime, m, ctx, builder) is reborrow_value:
                                reborrow_tag_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, reborrow_llvm, reborrow_address, 0, "reborrow.tag.ptr")
                                _ = LLVMBuildStore(builder, LLVMConstInt(LLVMInt1TypeInContext(ctx), 1, 0), reborrow_tag_pointer)
                                reborrow_payload_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, reborrow_llvm, reborrow_address, 1, "reborrow.value.ptr")
                                _ = LLVMBuildStore(builder, reborrow_value, reborrow_payload_pointer)
                                return EmitStatus.Open
                        return EmitStatus.Declined
                # `x op= v` is exactly `x <- x op v`: load, apply, store.
                compound: TokenKind = compound_operator_of(assign_operator)
                if compound != TokenKind.Eof:
                    if assign_target is Expr.Ident(compound_name, compound_name_line):
                        if lookup_slot(local_scope, compound_name) is compound_slot:
                            target_type: ValueType = lookup_type(local_scope, compound_name)
                            if emit_expression(assign_value, target_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is operand:
                                current: LLVMValueRef = LLVMBuildLoad2(builder, llvm_type_of(target_type, structs, ctx), compound_slot, "aug.load")
                                if emit_binary(compound, current, operand, target_type, structs, runtime.fast_math, ctx, builder) is combined:
                                    _ = LLVMBuildStore(builder, combined, compound_slot)
                                    return EmitStatus.Open
                    return EmitStatus.Declined
                # Bitset flag store: `t.flags.has_suffix <- true` (pack bit into u8).
                if assign_target is Expr.Field(bs_container, bs_flag, bs_flag_line):
                    if bs_flag == "has_suffix" or bs_flag == "has_prefix":
                        if bs_container is Expr.Field(bs_owner, bs_field, bs_field_line):
                            EmitStatus.Declined return if assign_operator != TokenKind.LArrow
                            bs_bit: u64 = 0 if bs_flag == "has_suffix" else 1
                            if struct_chain_address(bs_owner, local_scope, fns, structs, generics, runtime, m, ctx, builder) is bs_owner_addr:
                                bs_owner_type: ValueType = struct_chain_type(bs_owner, local_scope, structs)
                                bs_owner_type_deref: ValueType = ref_target_of(bs_owner_type, structs) if bs_owner_type.kind == TypeKind.Ref else bs_owner_type
                                EmitStatus.Declined return if bs_owner_type_deref.kind != TypeKind.Struct
                                bs_slot: usize = bs_owner_type_deref.bits.usize()
                                bs_pos: i64 = field_index_of(structs, bs_slot, bs_field)
                                EmitStatus.Declined return if bs_pos < 0
                                bs_pack_type: ValueType = structs.field_types[structs.field_start[bs_slot] + bs_pos.usize()]
                                bs_pack_ptr: LLVMValueRef = LLVMBuildStructGEP2(builder, llvm_type_of(bs_owner_type_deref, structs, ctx), bs_owner_addr, bs_pos.u32(), "bitset.pack.ptr")
                                bs_pack_llvm: LLVMTypeRef = llvm_type_of(bs_pack_type, structs, ctx)
                                bs_cur: LLVMValueRef = LLVMBuildLoad2(builder, bs_pack_llvm, bs_pack_ptr, "bitset.pack.cur")
                                bs_mask: LLVMValueRef = LLVMConstInt(bs_pack_llvm, 1.u64() << bs_bit, 0)
                                bs_cleared: LLVMValueRef = LLVMBuildAnd(builder, bs_cur, LLVMBuildNot(builder, bs_mask, "bitset.not"), "bitset.clear")
                                if emit_expression(assign_value, ValueType{kind: TypeKind.Bool, bits: 1}, local_scope, fns, structs, generics, runtime, m, ctx, builder) is bs_bool:
                                    bs_bit_val: LLVMValueRef = LLVMBuildSelect(builder, bs_bool, bs_mask, LLVMConstInt(bs_pack_llvm, 0, 0), "bitset.sel")
                                    bs_new: LLVMValueRef = LLVMBuildOr(builder, bs_cleared, bs_bit_val, "bitset.or")
                                    _ = LLVMBuildStore(builder, bs_new, bs_pack_ptr)
                                    return EmitStatus.Open
                                return EmitStatus.Declined
                            return EmitStatus.Declined
                # `p.x <- v` — a field assignment: address, then store. Goes through
                # struct_address_of, so it works identically for a local struct and for a
                # `mutable P&` parameter (the ref just adds one load).
                if assign_target is Expr.Field(assign_object, assign_field, assign_field_line):
                    EmitStatus.Declined return if assign_operator != TokenKind.LArrow
                    # The receiver may be a bare Ident (`p.x <- v`) OR a nested chain
                    # (`o.i.v <- v`), both addressed by struct_chain_address.
                    assign_struct_type: mutable ValueType = struct_type_of_name(assign_object_name, local_scope, structs) if assign_object is Expr.Ident(assign_object_name, assign_object_line) else struct_chain_type(assign_object, local_scope, structs)
                    assign_struct_type <- ref_target_of(assign_struct_type, structs) if assign_struct_type.kind == TypeKind.Ref
                    if assign_struct_type.kind == TypeKind.Optional:
                        assign_struct_payload: ValueType = optional_payload_of(assign_struct_type, structs)
                        assign_struct_type <- ref_target_of(assign_struct_payload, structs) if assign_struct_payload.kind == TypeKind.Ref and ref_is_heap_ref(assign_struct_payload, structs)
                    assign_struct_type <- arena_user_struct(structs) if assign_struct_type.kind == TypeKind.Arena
                    EmitStatus.Declined return if assign_struct_type.kind != TypeKind.Struct
                    assign_struct_slot: usize = assign_struct_type.bits.usize()
                    field_position: i64 = field_index_of(structs, assign_struct_slot, assign_field)
                    EmitStatus.Declined return if field_position < 0
                    if struct_chain_address(assign_object, local_scope, fns, structs, generics, runtime, m, ctx, builder) is assign_address:
                        assign_field_type: ValueType = structs.field_types[structs.field_start[assign_struct_slot] + field_position.usize()]
                        field_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, llvm_type_of(assign_struct_type, structs, ctx), assign_address, field_position.u32(), "field.ptr")
                        if emit_expression(assign_value, assign_field_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is field_value:
                            _ = LLVMBuildStore(builder, field_value, field_pointer)
                            return EmitStatus.Open
                    return EmitStatus.Declined

                # `xs[i] <- v` — an index assignment: address, then store. Only a plain
                # `<-` to a local array is modeled (a compound `xs[i] += v` would need the
                # address computed once and reused, which is a separate lowering).
                if assign_target is Expr.Index(assign_array, assign_index, assign_index_line):
                    EmitStatus.Declined return if assign_operator != TokenKind.LArrow
                    if assign_array is Expr.Ident(assign_array_name, assign_array_name_line):
                        assign_array_type: ValueType = lookup_type(local_scope, assign_array_name)
                        # `xs[i] <- v` where `xs: mutable darray[T]&` — a BORROWED darray: load
                        # its header address out of the parameter slot, then index like a local
                        # darray (mirrors the borrowed-darray READ path).
                        assign_borrowed_type: ValueType = darray_type_behind(local_scope, assign_array_name, structs)
                        if assign_borrowed_type.kind == TypeKind.DArray and assign_array_type.kind == TypeKind.Ref:
                            if darray_address_of(local_scope, assign_array_name, structs, ctx, builder) is assign_borrowed_slot:
                                if emit_darray_index_address(assign_borrowed_slot, assign_borrowed_type, assign_index, local_scope, fns, structs, generics, runtime, m, ctx, builder) is assign_borrowed_pointer:
                                    assign_borrowed_element: ValueType = darray_element_of(assign_borrowed_type, structs)
                                    if emit_expression(assign_value, assign_borrowed_element, local_scope, fns, structs, generics, runtime, m, ctx, builder) is assign_borrowed_value:
                                        assign_borrowed_store: LLVMValueRef = LLVMBuildStore(builder, assign_borrowed_value, assign_borrowed_pointer)
                                        tag_disjoint_darray_access(assign_borrowed_store, assign_borrowed_pointer, runtime, ctx)
                                        return EmitStatus.Open
                            return EmitStatus.Declined
                        if lookup_slot(local_scope, assign_array_name) is darray_assign_slot:
                            if assign_array_type.kind == TypeKind.DArray:
                                if emit_darray_index_address(darray_assign_slot, assign_array_type, assign_index, local_scope, fns, structs, generics, runtime, m, ctx, builder) is darray_element_pointer:
                                    darray_assign_element: ValueType = darray_element_of(assign_array_type, structs)
                                    if emit_expression(assign_value, darray_assign_element, local_scope, fns, structs, generics, runtime, m, ctx, builder) is darray_assigned:
                                        darray_assign_store: LLVMValueRef = LLVMBuildStore(builder, darray_assigned, darray_element_pointer)
                                        tag_disjoint_darray_access(darray_assign_store, darray_element_pointer, runtime, ctx)
                                        return EmitStatus.Open
                                return EmitStatus.Declined
                        # A FIXED-array local indexes in place. A `Struct&`/`T&` base
                        # (`items[i] <- v` on a `DictBucket[K,T]&`) is NOT an array — it falls
                        # through to the chain path below, which addresses it as a C-style
                        # pointer via struct_chain_address.
                        if assign_array_type.kind == TypeKind.Array:
                            if lookup_slot(local_scope, assign_array_name) is assign_array_slot:
                                if emit_index_address(assign_array_slot, assign_array_type, assign_index, local_scope, fns, structs, generics, runtime, m, ctx, builder) is element_pointer:
                                    element_type: ValueType = array_element_of(assign_array_type, structs)
                                    if emit_expression(assign_value, element_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is element_value:
                                        _ = LLVMBuildStore(builder, element_value, element_pointer)
                                        return EmitStatus.Open
                            return EmitStatus.Declined
                        # `a[i] <- v` where `a: mutable T[N]&` — a REF to a fixed array. The slot
                        # holds the array's ADDRESS; load it, then GEP into it exactly like a
                        # local array (the loaded pointer IS the array base).
                        if assign_array_type.kind == TypeKind.Ref and ref_target_of(assign_array_type, structs).kind == TypeKind.Array:
                            ref_array_type: ValueType = ref_target_of(assign_array_type, structs)
                            if lookup_slot(local_scope, assign_array_name) is ref_array_slot:
                                ref_array_base: LLVMValueRef = LLVMBuildLoad2(builder, LLVMPointerTypeInContext(ctx, 0), ref_array_slot, "arr.ref.base")
                                if emit_index_address(ref_array_base, ref_array_type, assign_index, local_scope, fns, structs, generics, runtime, m, ctx, builder) is ref_element_pointer:
                                    ref_array_element_type: ValueType = array_element_of(ref_array_type, structs)
                                    if emit_expression(assign_value, ref_array_element_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is ref_element_value:
                                        _ = LLVMBuildStore(builder, ref_element_value, ref_element_pointer)
                                        return EmitStatus.Open
                            return EmitStatus.Declined
                    # A nested-index or field-chain target (`m[i][j] <- v`) OR a ref-base index
                    # (`items[i] <- v`): the chain
                    # resolver yields the element's type and address; store through it.
                    chain_target_type: ValueType = struct_chain_type(assign_target, local_scope, structs)
                    EmitStatus.Declined return if chain_target_type.kind == TypeKind.Unmodeled
                    if struct_chain_address(assign_target, local_scope, fns, structs, generics, runtime, m, ctx, builder) is chain_target_address:
                        if emit_expression(assign_value, chain_target_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is chain_assigned_value:
                            _ = LLVMBuildStore(builder, chain_assigned_value, chain_target_address)
                            return EmitStatus.Open
                    return EmitStatus.Declined

                EmitStatus.Declined return if assign_operator != TokenKind.LArrow
                if assign_target is Expr.Ident(target_name, target_line):
                    slot_opt: LLVMValueRef? = lookup_slot(local_scope, target_name)
                    target_declared_type: ValueType = lookup_type(local_scope, target_name)
                    if slot_opt is slot:
                        # `a <- v` where `a: mutable T&` — store v THROUGH the reference (into
                        # its pointee), NOT overwrite the reference itself. The slot holds a
                        # pointer; load it, then store the value at the pointee type (a ref-typed
                        # `v` auto-dereferences to its value).
                        if target_declared_type.kind == TypeKind.Ref:
                            ref_assign_pointee: ValueType = ref_target_of(target_declared_type, structs)
                            # A mutating receiver may be written with the rebind spelling
                            # (`lexer <- lexer.pending_push_back(token)`). The method changes
                            # the pointee in place and returns void; there is no value to store
                            # back through the reference. Otherwise LLVM's void placeholder
                            # can escape into a `store` as `store void <badref>`.
                            ref_assign_value_type: ValueType = expression_type(assign_value, local_scope, fns, structs, generics)
                            ref_assign_is_void: mutable bool = ref_assign_value_type.kind == TypeKind.Void
                            # `Expr.If` has no standalone expression type because ordinary
                            # value-if arms are context-typed. For a reference rebind, inspect
                            # both arms so a void/void conditional is still recognized as a
                            # mutation rather than forced into the pointee type.
                            if assign_value is Expr.If(ref_if_condition, ref_if_then, ref_if_else, ref_if_line):
                                ref_if_then_type: ValueType = expression_type(ref_if_then, local_scope, fns, structs, generics)
                                ref_if_else_type: ValueType = expression_type(ref_if_else, local_scope, fns, structs, generics)
                                ref_assign_is_void <- ref_if_then_type.kind == TypeKind.Void and ref_if_else_type.kind == TypeKind.Void
                            if ref_assign_is_void:
                                if emit_expression(assign_value, ValueType{kind: TypeKind.Void, bits: 0}, local_scope, fns, structs, generics, runtime, m, ctx, builder) is ref_mutation_value:
                                    _ = ref_mutation_value
                                    return EmitStatus.Open
                                return EmitStatus.Declined
                            if emit_expression(assign_value, ref_assign_pointee, local_scope, fns, structs, generics, runtime, m, ctx, builder) is ref_assign_value:
                                ref_assign_ptr: LLVMValueRef = LLVMBuildLoad2(builder, LLVMPointerTypeInContext(ctx, 0), slot, "ref.assign.ptr")
                                _ = LLVMBuildStore(builder, ref_assign_value, ref_assign_ptr)
                                return EmitStatus.Open
                            return EmitStatus.Declined
                        assignment_value_type: mutable ValueType = expression_type(assign_value, local_scope, fns, structs, generics)
                        if assignment_value_type.kind == TypeKind.Unmodeled and assign_value is Expr.Call(assignment_callee, assignment_method_args, _, _):
                            if assignment_callee is Expr.Field(_, assignment_method_name, _):
                                assignment_method_type: mutable ValueType = lookup_return_type(fns, "Parser", assignment_method_name)
                                assignment_method_type <- lookup_return_type(fns, "", assignment_method_name) if assignment_method_type.kind == TypeKind.Unmodeled
                                assignment_method_index: mutable i64 = function_index_of_arity(fns, "Parser", assignment_method_name, assignment_method_args.count + 1)
                                assignment_method_index <- function_index_of(fns, "Parser", assignment_method_name) if assignment_method_index < 0
                                assignment_method_type <- copied_type(fns.returns[assignment_method_index.usize()]) if assignment_method_index >= 0
                                assignment_method_type <- ValueType{kind: TypeKind.Void, bits: 0} if assignment_method_name == "skip_newlines"
                                assignment_value_type <- assignment_method_type if assignment_method_type.kind != TypeKind.Unmodeled
                        if assignment_value_type.kind == TypeKind.Void:
                            if emit_expression(assign_value, assignment_value_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is assignment_void_value:
                                _ = assignment_void_value
                                return EmitStatus.Open
                            return EmitStatus.Declined
                        new_value: LLVMValueRef? = emit_expression(assign_value, target_declared_type, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                        if new_value is assigned:
                            _ = LLVMBuildStore(builder, assigned, slot)
                            emit_trace_value(target_name, target_line, assigned, target_declared_type, runtime, ctx, builder)
                            return EmitStatus.Open
                    extern_global_index: i64 = extern_global_index_of(structs, target_name)
                    if extern_global_index >= 0:
                        extern_global_type: ValueType = copied_type(structs.extern_global_types[extern_global_index.usize()])
                        if emit_expression(assign_value, extern_global_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is extern_global_value:
                            _ = LLVMBuildStore(builder, extern_global_value, structs.extern_global_handles[extern_global_index.usize()])
                            return EmitStatus.Open
                    mutable_global_index: i64 = mutable_global_index_of(structs, target_name)
                    if mutable_global_index >= 0:
                        mutable_global_type: ValueType = copied_type(structs.mutable_global_types[mutable_global_index.usize()])
                        if emit_expression(assign_value, mutable_global_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is mutable_global_value:
                            _ = LLVMBuildStore(builder, mutable_global_value, structs.mutable_global_handles[mutable_global_index.usize()])
                            return EmitStatus.Open
                return EmitStatus.Declined

            if statement is Stmt.If(if_condition, then_body, else_body, if_line):
                condition_opt: LLVMValueRef? = emit_condition(if_condition, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                if condition_opt is condition_bit:
                    function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                    then_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "if.then")
                    else_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "if.else")
                    join_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "if.join")
                    if_branch: LLVMValueRef = LLVMBuildCondBr(builder, condition_bit, then_block, else_block)
                    apply_branch_hint(if_branch, branch_hint_for(structs, if_line), ctx)

                    LLVMPositionBuilderAtEnd(builder, then_block)
                    # Inside the `then` arm the condition HOLDS, so `if p != null:` narrows
                    # `p` there -- stage0's rule, and what the std dict's rehash loop needs.
                    # Snapshotted and rolled back at the join: the proof does not survive
                    # the arm, and must not reach the `else` arm, where it is FALSE.
                    saved_owners: mutable darray[sview] = []
                    saved_fields: mutable darray[sview] = []
                    snapshot_narrowings(structs, saved_owners, saved_fields)
                    record_null_guards(if_condition, structs)
                    then_status: EmitStatus = emit_statements(then_body, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)
                    restore_narrowings(structs, saved_owners, saved_fields)
                    EmitStatus.Declined return if then_status == EmitStatus.Declined
                    branch_if_open(then_status, builder, join_block)

                    LLVMPositionBuilderAtEnd(builder, else_block)
                    else_status: EmitStatus = emit_statements(else_body, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)
                    EmitStatus.Declined return if else_status == EmitStatus.Declined
                    branch_if_open(else_status, builder, join_block)

                    LLVMPositionBuilderAtEnd(builder, join_block)
                    # Both arms returned: the join is unreachable. It still needs a
                    # terminator or the module is invalid, and the `if` as a whole has
                    # ended the block.
                    if then_status == EmitStatus.Terminated and else_status == EmitStatus.Terminated:
                        _ = LLVMBuildUnreachable(builder)
                        return EmitStatus.Terminated
                    return EmitStatus.Open
                if dbg_decline_enabled():
                    _ = dbg_cond_fail(runtime.disjoint_function_name, if_condition)
                return EmitStatus.Declined

            if statement is Stmt.While(while_condition, while_body, while_line):
                function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                head_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "while.head")
                body_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "while.body")
                exit_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "while.exit")

                # The condition is re-evaluated each iteration, so it lives in its own
                # block that the body branches back to.
                _ = LLVMBuildBr(builder, head_block)
                LLVMPositionBuilderAtEnd(builder, head_block)
                condition_opt: LLVMValueRef? = emit_condition(while_condition, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                if condition_opt is condition_bit:
                    while_branch: LLVMValueRef = LLVMBuildCondBr(builder, condition_bit, body_block, exit_block)
                    apply_branch_hint(while_branch, branch_hint_for(structs, while_line), ctx)
                    LLVMPositionBuilderAtEnd(builder, body_block)
                    # A `while` continues to its CONDITION.
                    loops.exits <- loops.exits.push(exit_block)
                    loops.continues <- loops.continues.push(head_block)
                    body_status: EmitStatus = emit_statements(while_body, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)
                    _ = loops.exits.pop()
                    _ = loops.continues.pop()
                    EmitStatus.Declined return if body_status == EmitStatus.Declined
                    # A body that returned does not loop back.
                    branch_if_open(body_status, builder, head_block)
                    # The loop may always exit via the condition, so the exit block is
                    # reachable and OPEN regardless of what the body did.
                    LLVMPositionBuilderAtEnd(builder, exit_block)
                    return EmitStatus.Open
                return EmitStatus.Declined

            # `break` / `continue`. A LABEL is not modeled (the subset has no labelled
            # loops), and neither is a `break` outside any loop — an empty stack declines
            # rather than emitting a branch to nowhere.
            if statement is Stmt.Break(break_label, break_line):
                EmitStatus.Declined return if break_label != ""
                EmitStatus.Declined return if loops.exits.count == 0
                _ = LLVMBuildBr(builder, loops.exits[loops.exits.count - 1])
                return EmitStatus.Terminated

            if statement is Stmt.Continue(continue_label, continue_line):
                EmitStatus.Declined return if continue_label != ""
                EmitStatus.Declined return if loops.continues.count == 0
                _ = LLVMBuildBr(builder, loops.continues[loops.continues.count - 1])
                return EmitStatus.Terminated

            # `for i in a..<b:` / `for i in a..=b:` over an integer range. Only the range
            # forms are modeled: iterating a container needs the container ABI.
            #
            # Lowered as: i = a; head: i < b ? body : exit; body -> step: i = i + 1 -> head.
            # The increment lives in its OWN block so `continue` can target it — jumping
            # straight back to the head would skip the step and spin forever.
            # STATEMENT-position `catch f(args):` — the parser lowers it to Stmt.Match
            # whose scrutinee is the fallible CALL. Modeled when the callee is an ERROR
            # fn: call through the out-param ABI, `code == 0` runs the success arm (a
            # Binding pattern names the out value), a nonzero code is `ordinal + 1` and
            # dispatches down the error arms; `error e:` / `_` is the catch-all. Arm
            # bodies are full statement blocks (usually `return …`), joined at a done
            # block for any arm left open.
            if statement is Stmt.Match(stmt_match_scrutinee, stmt_match_arms, stmt_match_line):
                EmitStatus.Declined return if stmt_match_arms.count < 1
                # `match OPT: null: … binding: …` — a match whose scrutinee is an OPTIONAL value.
                # Two arms: a `null` (or `_`) arm and a BINDING arm that binds the payload. Lowered
                # like `if OPT is v:` but as a match: test the tag (field 0), branch to the binding
                # arm (bind v = payload) or the null arm. IndexMap's put/find use exactly this.
                match_opt_type: ValueType = expression_type(stmt_match_scrutinee, local_scope, fns, structs, generics)
                if match_opt_type.kind == TypeKind.Optional and stmt_match_arms.count == 2:
                    mo_payload_type: ValueType = optional_payload_of(match_opt_type, structs)
                    mo_null_arm_index: mutable i64 = -1
                    mo_bind_arm_index: mutable i64 = -1
                    mo_bind_name: mutable sview = ""
                    for mo_arm_i in 0..<stmt_match_arms.count |mo_null_arm_index, mo_bind_arm_index, mo_bind_name, stmt_match_arms|:
                        mo_arm: MatchArm = stmt_match_arms[mo_arm_i]
                        if mo_arm.pattern is Pattern.Literal(mo_lit_text):
                            mo_null_arm_index <- mo_arm_i.i64() if mo_lit_text == "null"
                        if mo_arm.pattern is Pattern.Wildcard:
                            mo_null_arm_index <- mo_arm_i.i64() if mo_null_arm_index < 0
                        if mo_arm.pattern is Pattern.Binding(mo_pat_name):
                            mo_bind_arm_index <- mo_arm_i.i64()
                            mo_bind_name <- mo_pat_name
                    if mo_null_arm_index >= 0 and mo_bind_arm_index >= 0:
                        # A guarded arm is not the plain null/binding split modeled here.
                        if stmt_match_arms[mo_null_arm_index.usize()].guard is Expr.Absent and stmt_match_arms[mo_bind_arm_index.usize()].guard is Expr.Absent:
                            if emit_expression(stmt_match_scrutinee, match_opt_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is mo_opt_value:
                                mo_opt_llvm: LLVMTypeRef = llvm_type_of(match_opt_type, structs, ctx)
                                mo_tag: LLVMValueRef = LLVMBuildExtractValue(builder, mo_opt_value, 0, "match.opt.tag")
                                mo_payload: LLVMValueRef = LLVMBuildExtractValue(builder, mo_opt_value, 1, "match.opt.payload")
                                mo_function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                                mo_bind_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, mo_function, "match.opt.present")
                                mo_null_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, mo_function, "match.opt.absent")
                                mo_done_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, mo_function, "match.opt.done")
                                _ = LLVMBuildCondBr(builder, mo_tag, mo_bind_block, mo_null_block)
                                # PRESENT: bind the payload to the arm's name, run its body.
                                LLVMPositionBuilderAtEnd(builder, mo_bind_block)
                                mo_bind_storage: mutable darray[u8] = []
                                mo_bind_slot: LLVMValueRef = LLVMBuildAlloca(builder, llvm_type_of(mo_payload_type, structs, ctx), sview_to_cstr(mo_bind_name, mo_bind_storage))
                                _ = LLVMBuildStore(builder, mo_payload, mo_bind_slot)
                                declare_local(local_scope, mo_bind_name, mo_bind_slot, mo_payload_type)
                                mo_bind_status: EmitStatus = emit_statements(stmt_match_arms[mo_bind_arm_index.usize()].body, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)
                                EmitStatus.Declined return if mo_bind_status == EmitStatus.Declined
                                branch_if_open(mo_bind_status, builder, mo_done_block)
                                # ABSENT: run the null arm's body.
                                LLVMPositionBuilderAtEnd(builder, mo_null_block)
                                mo_null_status: EmitStatus = emit_statements(stmt_match_arms[mo_null_arm_index.usize()].body, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)
                                EmitStatus.Declined return if mo_null_status == EmitStatus.Declined
                                branch_if_open(mo_null_status, builder, mo_done_block)
                                LLVMPositionBuilderAtEnd(builder, mo_done_block)
                                return EmitStatus.Open
                            return EmitStatus.Declined
                if stmt_match_scrutinee is Expr.Call(smc_callee, smc_args, smc_arg_names, smc_call_line):
                    if smc_callee is Expr.Ident(smc_name, smc_name_line):
                        EmitStatus.Declined return if not error_callee_is(fns, generics, smc_name)
                        smc_value_type: ValueType = error_callee_value_type(smc_name, smc_args, local_scope, fns, structs, generics)
                        EmitStatus.Declined return if smc_value_type.kind == TypeKind.Unmodeled
                        if error_callee_target(smc_name, smc_args, local_scope, fns, structs, generics, m, ctx) is smc_target:
                            smc_value_llvm: LLVMTypeRef = llvm_type_of(smc_value_type, structs, ctx)
                            smc_out_slot: LLVMValueRef = LLVMBuildAlloca(builder, smc_value_llvm, "catch.out")
                            smc_call_args: mutable darray[LLVMValueRef] = [smc_out_slot]
                            smc_declined: mutable bool = false
                            smc_arg_index: mutable usize = 0
                            for smc_arg in smc_args |smc_call_args, smc_declined, smc_arg_index, smc_name, local_scope, fns, structs, generics, runtime, m, ctx, builder|:
                                if emit_expression(smc_arg, error_callee_param_type(smc_name, smc_args, smc_arg_index, local_scope, fns, structs, generics), local_scope, fns, structs, generics, runtime, m, ctx, builder) is smc_arg_value:
                                    smc_call_args.push(smc_arg_value)
                                else:
                                    smc_declined <- true
                                smc_arg_index <- smc_arg_index + 1
                            EmitStatus.Declined return if smc_declined
                            smc_fn_type: LLVMTypeRef = LLVMGlobalGetValueType(smc_target)
                            smc_args_pointer: void& = (&smc_call_args[0]).cast[void&] can Unsafe.PointerCast
                            smc_code: LLVMValueRef = LLVMBuildCall2(builder, smc_fn_type, smc_target, smc_args_pointer, smc_call_args.count.u32(), "catch.code")
                            function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                            smc_value_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "catch.value")
                            smc_dispatch_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "catch.dispatch")
                            smc_done_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "catch.done")
                            smc_ok: LLVMValueRef = LLVMBuildICmp(builder, 32, smc_code, LLVMConstInt(LLVMInt32TypeInContext(ctx), 0, 0), "catch.ok")
                            _ = LLVMBuildCondBr(builder, smc_ok, smc_value_block, smc_dispatch_block)

                            LLVMPositionBuilderAtEnd(builder, smc_value_block)
                            smc_success: MatchArm = stmt_match_arms[0]
                            EmitStatus.Declined return if arm_has_guard(smc_success.guard)
                            if smc_success.pattern is Pattern.Binding(smc_success_binding):
                                declare_local(local_scope, smc_success_binding, smc_out_slot, smc_value_type)
                            smc_any_open: mutable bool = false
                            smc_success_status: EmitStatus = emit_statements(smc_success.body, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)
                            EmitStatus.Declined return if smc_success_status == EmitStatus.Declined
                            smc_any_open <- true if smc_success_status == EmitStatus.Open
                            branch_if_open(smc_success_status, builder, smc_done_block)

                            LLVMPositionBuilderAtEnd(builder, smc_dispatch_block)
                            smc_arm_index: mutable usize = 1
                            smc_error_declined: mutable bool = false
                            smc_saw_catch_all: mutable bool = false
                            while smc_arm_index < stmt_match_arms.count |smc_arm_index, smc_error_declined, smc_saw_catch_all, smc_any_open, stmt_match_arms, smc_code, smc_done_block, return_type, function, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder|:
                                smc_arm: MatchArm = stmt_match_arms[smc_arm_index]
                                smc_arm_index <- smc_arm_index + 1
                                continue if smc_error_declined or smc_saw_catch_all
                                if arm_has_guard(smc_arm.guard):
                                    smc_error_declined <- true
                                    continue
                                # `error e:` (TypeBind) and `_` are both the CATCH-ALL: run
                                # the body in the current dispatch block. The binder is NOT
                                # declared — a body that reads `e` declines on the unknown
                                # ident rather than seeing a wrong value.
                                smc_is_catch_all: mutable bool = false
                                if smc_arm.pattern is Pattern.Wildcard:
                                    smc_is_catch_all <- true
                                if smc_arm.pattern is Pattern.TypeBind(smc_type_name, smc_binder):
                                    smc_is_catch_all <- true if smc_type_name == "error"
                                if smc_is_catch_all:
                                    smc_all_status: EmitStatus = emit_statements(smc_arm.body, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)
                                    if smc_all_status == EmitStatus.Declined:
                                        smc_error_declined <- true
                                        continue
                                    smc_any_open <- true if smc_all_status == EmitStatus.Open
                                    branch_if_open(smc_all_status, builder, smc_done_block)
                                    smc_saw_catch_all <- true
                                    continue
                                if smc_arm.pattern is Pattern.Variant(smc_path, smc_fields):
                                    if smc_fields.count != 0:
                                        smc_error_declined <- true
                                        continue
                                    smc_ordinal: mutable i64 = penum_variant_index_of_path(smc_path, structs)
                                    if smc_ordinal < 0:
                                        smc_ordinal <- ordinal_of_dotted_path(smc_path, structs)
                                    if smc_ordinal < 0:
                                        smc_error_declined <- true
                                        continue
                                    smc_arm_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "catch.arm")
                                    smc_next_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "catch.next")
                                    smc_hit: LLVMValueRef = LLVMBuildICmp(builder, 32, smc_code, LLVMConstInt(LLVMInt32TypeInContext(ctx), (smc_ordinal + 1).u64(), 0), "catch.cmp")
                                    _ = LLVMBuildCondBr(builder, smc_hit, smc_arm_block, smc_next_block)
                                    LLVMPositionBuilderAtEnd(builder, smc_arm_block)
                                    smc_arm_status: EmitStatus = emit_statements(smc_arm.body, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)
                                    if smc_arm_status == EmitStatus.Declined:
                                        smc_error_declined <- true
                                        continue
                                    smc_any_open <- true if smc_arm_status == EmitStatus.Open
                                    branch_if_open(smc_arm_status, builder, smc_done_block)
                                    LLVMPositionBuilderAtEnd(builder, smc_next_block)
                                    continue
                                smc_error_declined <- true
                            EmitStatus.Declined return if smc_error_declined
                            if not smc_saw_catch_all:
                                _ = LLVMBuildUnreachable(builder)
                            LLVMPositionBuilderAtEnd(builder, smc_done_block)
                            # Every arm returned: the done block has no predecessors, so the
                            # whole catch is a TERMINATOR (terminate the dead block too).
                            if not smc_any_open:
                                _ = LLVMBuildUnreachable(builder)
                                return EmitStatus.Terminated
                            return EmitStatus.Open
                # A `match SCRUTINEE:` STATEMENT over a PACKED AST node (Expr/Stmt/Decl/Pattern over
                # the Node store) — mirrors emit_expression's packed arm reads but with STATEMENT arm
                # bodies. Handles `T.Variant(binders):` and `T.A(b)|T.B(b):` (OR, same payload layout)
                # and `_`; binders may be Binding or Wildcard; guards supported; AST-root only.
                spm_type: ValueType = resolve_type(stmt_match_scrutinee, ValueType{kind: TypeKind.Signed, bits: 64}, local_scope, fns, structs, generics)
                if spm_type.kind == TypeKind.PackedEnum and runtime.packed_mode == 2:
                    spm_root: i64 = packed_root_index_of(structs, spm_type.bits.i64())
                    EmitStatus.Declined return if runtime.active_store_enum != spm_root
                    EmitStatus.Declined return if not packed_is_ast_root(structs, spm_root)
                    if emit_expression(stmt_match_scrutinee, spm_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is spm_index_value:
                        spm_function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                        spm_state: LLVMValueRef = LLVMBuildExtractValue(builder, runtime.active_store, 2, "spm.state")
                        spm_index64: LLVMValueRef = LLVMBuildZExt(builder, spm_index_value, LLVMInt64TypeInContext(ctx), "spm.index")
                        spm_record_args: mutable darray[LLVMValueRef] = [spm_state, spm_index64]
                        spm_record_pointer: void& = (&spm_record_args[0]).cast[void&] can Unsafe.PointerCast
                        spm_record: LLVMValueRef = LLVMBuildCall2(builder, runtime.packed_read_word_type, runtime.packed_read_word, spm_record_pointer, 2, "spm.record")
                        spm_row_type: LLVMTypeRef = packed_row_llvm_type(structs, spm_type.bits.i64(), ctx)
                        spm_tag_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, spm_row_type, spm_record, 0, "spm.tag.ptr")
                        spm_tag: LLVMValueRef = LLVMBuildLoad2(builder, LLVMInt32TypeInContext(ctx), spm_tag_pointer, "spm.tag")
                        spm_done: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, spm_function, "spm.done")
                        spm_declined: mutable bool = false
                        spm_saw_default: mutable bool = false
                        spm_any_open: mutable bool = false
                        for spm_arm in stmt_match_arms |spm_declined, spm_saw_default, spm_any_open, spm_type, spm_record, spm_row_type, spm_tag, spm_function, spm_done, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder|:
                            continue if spm_declined or spm_saw_default
                            if arm_has_guard(spm_arm.guard) and is_catch_all_pattern(spm_arm.pattern):
                                spm_declined <- true
                                continue
                            spm_arm_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, spm_function, "spm.arm")
                            if is_catch_all_pattern(spm_arm.pattern):
                                _ = LLVMBuildBr(builder, spm_arm_block)
                                LLVMPositionBuilderAtEnd(builder, spm_arm_block)
                                spm_default_status: EmitStatus = emit_statements(spm_arm.body, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)
                                spm_declined <- true if spm_default_status == EmitStatus.Declined
                                spm_any_open <- true if spm_default_status == EmitStatus.Open
                                branch_if_open(spm_default_status, builder, spm_done)
                                spm_saw_default <- true if spm_default_status != EmitStatus.Declined
                                continue
                            spm_ordinals: mutable darray[i64] = []
                            spm_slot: mutable i64 = -1
                            spm_fields: mutable darray[Pattern] = []
                            spm_arm_ok: mutable bool = false
                            if spm_arm.pattern is Pattern.Variant(spm_path, spm_v_fields):
                                spm_v_ord: i64 = packed_variant_index_of_path(spm_path, structs)
                                spm_v_slot: i64 = packed_slot_of_path(spm_path, structs)
                                if spm_v_ord >= 0 and spm_v_slot >= 0:
                                    spm_ordinals.push(spm_v_ord)
                                    spm_slot <- spm_v_slot
                                    spm_fields <- spm_v_fields
                                    spm_arm_ok <- true
                            if spm_arm.pattern is Pattern.Or(spm_or_opts):
                                spm_or_ok: mutable bool = spm_or_opts.count > 0
                                spm_ref_payload: mutable ValueType = unmodeled_type()
                                spm_ref_slot: mutable i64 = -1
                                for spm_opt in spm_or_opts |spm_or_ok, spm_ordinals, spm_slot, spm_fields, spm_ref_payload, spm_ref_slot, structs|:
                                    if spm_opt is Pattern.Variant(spm_opt_path, spm_opt_fields):
                                        spm_opt_ord: i64 = packed_variant_index_of_path(spm_opt_path, structs)
                                        spm_opt_slot: i64 = packed_slot_of_path(spm_opt_path, structs)
                                        if spm_opt_ord < 0 or spm_opt_slot < 0 or not structs.packed_has_payload[spm_opt_slot.usize()]:
                                            spm_or_ok <- false
                                        else:
                                            spm_opt_payload: ValueType = copied_type(structs.packed_payloads[spm_opt_slot.usize()])
                                            if spm_ref_payload.kind == TypeKind.Unmodeled:
                                                spm_ref_payload <- spm_opt_payload
                                                spm_ref_slot <- spm_opt_slot
                                                spm_slot <- spm_opt_slot
                                                spm_fields <- spm_opt_fields
                                            else:
                                                spm_or_ok <- false if not packed_slots_same_field_layout(spm_ref_slot, spm_opt_slot, structs)
                                            spm_ordinals.push(spm_opt_ord)
                                    else:
                                        spm_or_ok <- false
                                spm_arm_ok <- true if spm_or_ok and spm_slot >= 0
                            if not spm_arm_ok:
                                spm_declined <- true
                                continue
                            if true:
                                spm_all_binders: mutable bool = true
                                for spm_bf in spm_fields |spm_all_binders|:
                                    spm_all_binders <- false if not (spm_bf is Pattern.Binding(spm_bf_name)) and not (spm_bf is Pattern.Wildcard)
                                if not spm_all_binders:
                                    spm_declined <- true
                                    continue
                                spm_next_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, spm_function, "spm.next")
                                spm_hit: mutable LLVMValueRef = zeroed
                                spm_hit_first: mutable bool = true
                                for spm_ord in spm_ordinals |spm_hit, spm_hit_first, spm_tag, ctx, builder|:
                                    spm_cmp: LLVMValueRef = LLVMBuildICmp(builder, 32, spm_tag, LLVMConstInt(LLVMInt32TypeInContext(ctx), spm_ord.u64(), 0), "spm.cmp")
                                    if spm_hit_first:
                                        spm_hit <- spm_cmp
                                        spm_hit_first <- false
                                    else:
                                        spm_hit <- LLVMBuildOr(builder, spm_hit, spm_cmp, "spm.or")
                                _ = LLVMBuildCondBr(builder, spm_hit, spm_arm_block, spm_next_block)
                                LLVMPositionBuilderAtEnd(builder, spm_arm_block)
                                if spm_fields.count > 0 and structs.packed_has_payload[spm_slot.usize()]:
                                    spm_payload: ValueType = copied_type(structs.packed_payloads[spm_slot.usize()])
                                    if spm_payload.kind == TypeKind.Unmodeled:
                                        spm_declined <- true
                                    else:
                                        spm_payload_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, spm_row_type, spm_record, 1, "spm.payload.ptr")
                                        spm_payload_value: LLVMValueRef = LLVMBuildLoad2(builder, llvm_type_of(spm_payload, structs, ctx), spm_payload_pointer, "spm.payload")
                                        spm_field_start: usize = structs.packed_field_type_start[spm_slot.usize()]
                                        if spm_fields.count == 1:
                                            if spm_fields[0] is Pattern.Binding(spm_single_name):
                                                spm_single_storage: mutable darray[u8] = []
                                                spm_single_slot: LLVMValueRef = LLVMBuildAlloca(builder, llvm_type_of(spm_payload, structs, ctx), sview_to_cstr(spm_single_name, spm_single_storage))
                                                _ = LLVMBuildStore(builder, spm_payload_value, spm_single_slot)
                                                declare_local(local_scope, spm_single_name, spm_single_slot, spm_payload)
                                        if spm_fields.count > 1:
                                            for spm_bind_index in 0..<spm_fields.count |spm_fields, spm_field_start, spm_payload_value, structs, local_scope, ctx, builder|:
                                                if spm_fields[spm_bind_index] is Pattern.Binding(spm_multi_name):
                                                    spm_multi_type: ValueType = copied_type(structs.packed_field_types[spm_field_start + spm_bind_index])
                                                    spm_multi_field: LLVMValueRef = LLVMBuildExtractValue(builder, spm_payload_value, spm_bind_index.u32(), "spm.field")
                                                    spm_multi_storage: mutable darray[u8] = []
                                                    spm_multi_slot: LLVMValueRef = LLVMBuildAlloca(builder, llvm_type_of(spm_multi_type, structs, ctx), sview_to_cstr(spm_multi_name, spm_multi_storage))
                                                    _ = LLVMBuildStore(builder, spm_multi_field, spm_multi_slot)
                                                    declare_local(local_scope, spm_multi_name, spm_multi_slot, spm_multi_type)
                                if not spm_declined and arm_has_guard(spm_arm.guard):
                                    if emit_condition(spm_arm.guard, local_scope, fns, structs, generics, runtime, m, ctx, builder) is spm_guard_bit:
                                        spm_guard_body: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, spm_function, "spm.guard")
                                        _ = LLVMBuildCondBr(builder, spm_guard_bit, spm_guard_body, spm_next_block)
                                        LLVMPositionBuilderAtEnd(builder, spm_guard_body)
                                    else:
                                        spm_declined <- true
                                if spm_declined:
                                    LLVMPositionBuilderAtEnd(builder, spm_next_block)
                                else:
                                    spm_arm_status: EmitStatus = emit_statements(spm_arm.body, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)
                                    spm_declined <- true if spm_arm_status == EmitStatus.Declined
                                    spm_any_open <- true if spm_arm_status == EmitStatus.Open
                                    branch_if_open(spm_arm_status, builder, spm_done)
                                    LLVMPositionBuilderAtEnd(builder, spm_next_block)
                        EmitStatus.Declined return if spm_declined
                        if not spm_saw_default:
                            _ = LLVMBuildUnreachable(builder)
                        LLVMPositionBuilderAtEnd(builder, spm_done)
                        if not spm_any_open:
                            _ = LLVMBuildUnreachable(builder)
                            return EmitStatus.Terminated
                        return EmitStatus.Open
                    return EmitStatus.Declined
                # A plain `match SCRUTINEE:` STATEMENT over an integer / const-enum / payload-enum
                # scrutinee, where each arm is a statement block (the value-position form is handled
                # by emit_expression's Expr.Match; here the arm bodies are statements that may
                # `return`/`break` or fall through to the shared done block).
                sm_scrutinee_type: ValueType = resolve_type(stmt_match_scrutinee, ValueType{kind: TypeKind.Signed, bits: 64}, local_scope, fns, structs, generics)
                # A bare `enum Color:` with variants is a PAYLOAD enum (kind PayloadEnum) even when
                # every variant is field-less: its scrutinee is a `{i32, [N x i64]}` value whose TAG
                # (extractvalue 0) drives the compare and whose payload is spilled to a temp so an
                # arm's `is`-binding can load it. Packed enums (store handles) are NOT handled here.
                # A CSTR scrutinee statement-match: each string-literal arm branches on
                # `ctx_streq(s, "lit") != 0`; `_`/binder is the catch-all. Bodies are statements
                # that may return/break or fall through to the shared done block.
                if sm_scrutinee_type.kind == TypeKind.CStr:
                    if emit_expression(stmt_match_scrutinee, sm_scrutinee_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is scstr_scrutinee:
                        scstr_function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                        scstr_done: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, scstr_function, "scstr.done")
                        scstr_declined: mutable bool = false
                        scstr_saw_default: mutable bool = false
                        scstr_any_open: mutable bool = false
                        for scstr_arm in stmt_match_arms |scstr_declined, scstr_saw_default, scstr_any_open, scstr_scrutinee, sm_scrutinee_type, scstr_function, scstr_done, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder|:
                            continue if scstr_declined or scstr_saw_default
                            scstr_declined <- true if arm_has_guard(scstr_arm.guard)
                            continue if arm_has_guard(scstr_arm.guard)
                            scstr_arm_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, scstr_function, "scstr.arm")
                            if scstr_arm.pattern is Pattern.Literal(scstr_lit_text):
                                scstr_storage: mutable darray[u8] = []
                                if string_pattern_content_cstr(scstr_lit_text, scstr_storage) is scstr_lit_cstr:
                                    scstr_global: LLVMValueRef = LLVMBuildGlobalStringPtr(builder, scstr_lit_cstr, "strpat")
                                    scstr_next: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, scstr_function, "scstr.next")
                                    scstr_args: mutable darray[LLVMValueRef] = [scstr_scrutinee, scstr_global]
                                    scstr_args_pointer: void& = (&scstr_args[0]).cast[void&] can Unsafe.PointerCast
                                    scstr_code: LLVMValueRef = LLVMBuildCall2(builder, runtime.streq_type, runtime.streq, scstr_args_pointer, 2, "scstr.streq")
                                    scstr_hit: LLVMValueRef = LLVMBuildICmp(builder, 33, scstr_code, LLVMConstInt(LLVMInt64TypeInContext(ctx), 0, 0), "scstr.hit")
                                    _ = LLVMBuildCondBr(builder, scstr_hit, scstr_arm_block, scstr_next)
                                    LLVMPositionBuilderAtEnd(builder, scstr_arm_block)
                                    scstr_status: EmitStatus = emit_statements(scstr_arm.body, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)
                                    scstr_declined <- true if scstr_status == EmitStatus.Declined
                                    scstr_any_open <- true if scstr_status == EmitStatus.Open
                                    branch_if_open(scstr_status, builder, scstr_done)
                                    LLVMPositionBuilderAtEnd(builder, scstr_next)
                                else:
                                    scstr_declined <- true
                            elif is_catch_all_pattern(scstr_arm.pattern):
                                _ = LLVMBuildBr(builder, scstr_arm_block)
                                LLVMPositionBuilderAtEnd(builder, scstr_arm_block)
                                if scstr_arm.pattern is Pattern.Binding(scstr_bind_name):
                                    scstr_bind_storage: mutable darray[u8] = []
                                    scstr_bind_slot: LLVMValueRef = LLVMBuildAlloca(builder, llvm_type_of(sm_scrutinee_type, structs, ctx), sview_to_cstr(scstr_bind_name, scstr_bind_storage))
                                    _ = LLVMBuildStore(builder, scstr_scrutinee, scstr_bind_slot)
                                    declare_local(local_scope, scstr_bind_name, scstr_bind_slot, sm_scrutinee_type)
                                scstr_default_status: EmitStatus = emit_statements(scstr_arm.body, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)
                                scstr_declined <- true if scstr_default_status == EmitStatus.Declined
                                scstr_any_open <- true if scstr_default_status == EmitStatus.Open
                                branch_if_open(scstr_default_status, builder, scstr_done)
                                scstr_saw_default <- true if scstr_default_status != EmitStatus.Declined
                            else:
                                scstr_declined <- true
                        EmitStatus.Declined return if scstr_declined
                        if not scstr_saw_default:
                            _ = LLVMBuildUnreachable(builder)
                        LLVMPositionBuilderAtEnd(builder, scstr_done)
                        if not scstr_any_open:
                            _ = LLVMBuildUnreachable(builder)
                            return EmitStatus.Terminated
                        return EmitStatus.Open
                    return EmitStatus.Declined
                # An SVIEW scrutinee statement-match: like the cstr path, but the scrutinee is a
                # `{ptr, i64 len}` value; each literal arm compares via `ctx_string_views_eq(
                # scrutinee, literal_sview)` (i64 nonzero = equal). The parser matches token/keyword
                # sviews this way (machine_statement, primary_identifier).
                if sm_scrutinee_type.kind == TypeKind.SView:
                    if emit_expression(stmt_match_scrutinee, sm_scrutinee_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is sview_scrutinee:
                        sview_function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                        sview_done: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, sview_function, "sview.done")
                        sview_declined: mutable bool = false
                        sview_saw_default: mutable bool = false
                        sview_any_open: mutable bool = false
                        sview_llvm_type: LLVMTypeRef = llvm_type_of(sm_scrutinee_type, structs, ctx)
                        for sview_arm in stmt_match_arms |sview_declined, sview_saw_default, sview_any_open, sview_scrutinee, sview_llvm_type, sm_scrutinee_type, sview_function, sview_done, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder|:
                            continue if sview_declined or sview_saw_default
                            sview_declined <- true if arm_has_guard(sview_arm.guard)
                            continue if arm_has_guard(sview_arm.guard)
                            sview_arm_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, sview_function, "sview.arm")
                            if sview_arm.pattern is Pattern.Literal(sview_lit_text):
                                sview_lit_storage: mutable darray[u8] = []
                                if string_pattern_content_cstr(sview_lit_text, sview_lit_storage) is sview_lit_cstr:
                                    sview_lit_global: LLVMValueRef = LLVMBuildGlobalStringPtr(builder, sview_lit_cstr, "svpat")
                                    sview_lit_len: usize = sview_lit_storage.count - 1
                                    sview_undef: LLVMValueRef = LLVMGetUndef(sview_llvm_type)
                                    sview_with_ptr: LLVMValueRef = LLVMBuildInsertValue(builder, sview_undef, sview_lit_global, 0, "svpat.ptr")
                                    sview_lit_value: LLVMValueRef = LLVMBuildInsertValue(builder, sview_with_ptr, LLVMConstInt(LLVMInt64TypeInContext(ctx), sview_lit_len.u64(), 0), 1, "svpat.len")
                                    sview_next: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, sview_function, "sview.next")
                                    sview_eq_args: mutable darray[LLVMValueRef] = [sview_scrutinee, sview_lit_value]
                                    sview_eq_args_pointer: void& = (&sview_eq_args[0]).cast[void&] can Unsafe.PointerCast
                                    sview_eq_code: LLVMValueRef = LLVMBuildCall2(builder, runtime.sview_eq_type, runtime.sview_eq, sview_eq_args_pointer, 2, "sview.eq")
                                    sview_hit: LLVMValueRef = LLVMBuildICmp(builder, 33, sview_eq_code, LLVMConstInt(LLVMInt64TypeInContext(ctx), 0, 0), "sview.hit")
                                    _ = LLVMBuildCondBr(builder, sview_hit, sview_arm_block, sview_next)
                                    LLVMPositionBuilderAtEnd(builder, sview_arm_block)
                                    sview_status: EmitStatus = emit_statements(sview_arm.body, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)
                                    sview_declined <- true if sview_status == EmitStatus.Declined
                                    sview_any_open <- true if sview_status == EmitStatus.Open
                                    branch_if_open(sview_status, builder, sview_done)
                                    LLVMPositionBuilderAtEnd(builder, sview_next)
                                else:
                                    sview_declined <- true
                            elif is_catch_all_pattern(sview_arm.pattern):
                                _ = LLVMBuildBr(builder, sview_arm_block)
                                LLVMPositionBuilderAtEnd(builder, sview_arm_block)
                                if sview_arm.pattern is Pattern.Binding(sview_bind_name):
                                    sview_bind_storage: mutable darray[u8] = []
                                    sview_bind_slot: LLVMValueRef = LLVMBuildAlloca(builder, sview_llvm_type, sview_to_cstr(sview_bind_name, sview_bind_storage))
                                    _ = LLVMBuildStore(builder, sview_scrutinee, sview_bind_slot)
                                    declare_local(local_scope, sview_bind_name, sview_bind_slot, sm_scrutinee_type)
                                sview_default_status: EmitStatus = emit_statements(sview_arm.body, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)
                                sview_declined <- true if sview_default_status == EmitStatus.Declined
                                sview_any_open <- true if sview_default_status == EmitStatus.Open
                                branch_if_open(sview_default_status, builder, sview_done)
                                sview_saw_default <- true if sview_default_status != EmitStatus.Declined
                            else:
                                sview_declined <- true
                        EmitStatus.Declined return if sview_declined
                        if not sview_saw_default:
                            _ = LLVMBuildUnreachable(builder)
                        LLVMPositionBuilderAtEnd(builder, sview_done)
                        if not sview_any_open:
                            _ = LLVMBuildUnreachable(builder)
                            return EmitStatus.Terminated
                        return EmitStatus.Open
                    return EmitStatus.Declined
                sm_penum: bool = sm_scrutinee_type.kind == TypeKind.PayloadEnum
                EmitStatus.Declined return if not is_integer_type(sm_scrutinee_type) and not sm_penum
                if emit_expression(stmt_match_scrutinee, sm_scrutinee_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is sm_scrutinee_raw:
                    sm_function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                    sm_scrutinee: mutable LLVMValueRef = sm_scrutinee_raw
                    sm_compare_type: mutable LLVMTypeRef = llvm_type_of(sm_scrutinee_type, structs, ctx)
                    sm_penum_slot: mutable LLVMValueRef = sm_scrutinee_raw
                    if sm_penum:
                        sm_scrutinee <- LLVMBuildExtractValue(builder, sm_scrutinee_raw, 0, "smatch.tag")
                        sm_compare_type <- LLVMInt32TypeInContext(ctx)
                        sm_penum_slot <- LLVMBuildAlloca(builder, llvm_type_of(sm_scrutinee_type, structs, ctx), "smatch.payload.tmp")
                        _ = LLVMBuildStore(builder, sm_scrutinee_raw, sm_penum_slot)
                    sm_done: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, sm_function, "smatch.done")
                    sm_declined: mutable bool = false
                    sm_saw_default: mutable bool = false
                    sm_any_open: mutable bool = false
                    for sm_arm in stmt_match_arms |sm_declined, sm_saw_default, sm_any_open, sm_penum, sm_scrutinee, sm_compare_type, sm_penum_slot, sm_scrutinee_type, sm_function, sm_done, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder|:
                        continue if sm_declined or sm_saw_default
                        sm_ordinal: mutable i64 = -1
                        # A NEGATIVE literal (`-1:`) is a valid compare value, so `sm_ordinal < 0`
                        # cannot double as the "no value resolved" sentinel; track it explicitly.
                        sm_has_value: mutable bool = false
                        sm_is_default: mutable bool = false
                        sm_payload_binding: mutable sview = ""
                        sm_payload_multi: mutable darray[sview] = []
                        sm_payload_path: mutable sview = ""
                        sm_is_range: mutable bool = false
                        sm_range_lo: mutable sview = ""
                        sm_range_hi: mutable sview = ""
                        sm_range_inclusive: mutable bool = false
                        sm_is_or: mutable bool = false
                        sm_or_options: mutable darray[Pattern] = []
                        if sm_arm.pattern is Pattern.Literal(sm_literal_text):
                            sm_literal_value: mutable i64 = 0
                            if parse_pattern_scalar(sm_literal_text, sm_literal_value):
                                sm_ordinal <- sm_literal_value
                                sm_has_value <- true
                            else:
                                sm_declined <- true
                        if sm_arm.pattern is Pattern.Variant(sm_path, sm_fields):
                            sm_payload_path <- sm_path
                            if sm_penum:
                                sm_ordinal <- penum_variant_index_of_path(sm_path, structs)
                                if sm_fields.count == 1:
                                    if sm_fields[0] is Pattern.Binding(sm_bound):
                                        sm_payload_binding <- sm_bound
                                    else:
                                        sm_declined <- true
                                if sm_fields.count > 1:
                                    for sm_multi_field in sm_fields |sm_payload_multi, sm_declined|:
                                        if sm_multi_field is Pattern.Binding(sm_multi_bound):
                                            sm_payload_multi.push(sm_multi_bound)
                                        else:
                                            sm_declined <- true
                            else:
                                sm_declined <- true if sm_fields.count != 0
                                sm_ordinal <- ordinal_of_dotted_path(sm_path, structs) if sm_fields.count == 0
                            sm_declined <- true if sm_ordinal < 0
                            sm_has_value <- true if sm_ordinal >= 0
                        if sm_arm.pattern is Pattern.Range(sm_rlo, sm_rhi, sm_rincl):
                            # Range arms are integer-only; a payload-enum tag has no range.
                            sm_declined <- true if sm_penum
                            sm_is_range <- true if not sm_penum
                            sm_range_lo <- sm_rlo
                            sm_range_hi <- sm_rhi
                            sm_range_inclusive <- sm_rincl
                        if sm_arm.pattern is Pattern.Or(sm_opts):
                            sm_is_or <- true
                            sm_or_options <- sm_opts
                        sm_is_default <- true if is_catch_all_pattern(sm_arm.pattern)
                        sm_declined <- true if not sm_has_value and not sm_is_default and not sm_is_range and not sm_is_or
                        continue if sm_declined
                        sm_arm_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, sm_function, "smatch.arm")
                        if arm_has_guard(sm_arm.guard) and sm_is_default:
                            sm_declined <- true
                            continue
                        if sm_is_default:
                            _ = LLVMBuildBr(builder, sm_arm_block)
                            LLVMPositionBuilderAtEnd(builder, sm_arm_block)
                            sm_default_status: EmitStatus = emit_statements(sm_arm.body, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)
                            sm_declined <- true if sm_default_status == EmitStatus.Declined
                            sm_any_open <- true if sm_default_status == EmitStatus.Open
                            branch_if_open(sm_default_status, builder, sm_done)
                            sm_saw_default <- true if sm_default_status != EmitStatus.Declined
                        else:
                            sm_next_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, sm_function, "smatch.next")
                            sm_hit: mutable LLVMValueRef = zeroed
                            if sm_is_range:
                                if emit_range_test(sm_scrutinee, sm_scrutinee_type, sm_range_lo, sm_range_hi, sm_range_inclusive, sm_compare_type, ctx, builder) is sm_range_hit:
                                    sm_hit <- sm_range_hit
                                else:
                                    sm_declined <- true
                            elif sm_is_or:
                                if emit_or_pattern_hit(sm_or_options, sm_scrutinee, sm_scrutinee_type, sm_penum, sm_compare_type, structs, ctx, builder) is sm_or_hit:
                                    sm_hit <- sm_or_hit
                                else:
                                    sm_declined <- true
                            else:
                                sm_hit <- LLVMBuildICmp(builder, 32, sm_scrutinee, LLVMConstInt(sm_compare_type, sm_ordinal.u64(), 1), "smatch.cmp")
                            continue if sm_declined
                            _ = LLVMBuildCondBr(builder, sm_hit, sm_arm_block, sm_next_block)
                            LLVMPositionBuilderAtEnd(builder, sm_arm_block)
                            # `Shape.Circle(r):` — spill-and-load the single payload field so the
                            # arm body can read `r`, exactly as the value-position emitter does.
                            if sm_penum and sm_payload_binding != "":
                                sm_payload_type: ValueType = penum_payload_of_path(sm_payload_path, structs)
                                if sm_payload_type.kind == TypeKind.Unmodeled:
                                    sm_declined <- true
                                else:
                                    sm_payload_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, llvm_type_of(sm_scrutinee_type, structs, ctx), sm_penum_slot, 1, "smatch.payload.ptr")
                                    sm_payload_value: LLVMValueRef = LLVMBuildLoad2(builder, llvm_type_of(sm_payload_type, structs, ctx), sm_payload_pointer, "smatch.payload")
                                    sm_payload_storage: mutable darray[u8] = []
                                    sm_payload_slot: LLVMValueRef = LLVMBuildAlloca(builder, llvm_type_of(sm_payload_type, structs, ctx), sview_to_cstr(sm_payload_binding, sm_payload_storage))
                                    _ = LLVMBuildStore(builder, sm_payload_value, sm_payload_slot)
                                    declare_local(local_scope, sm_payload_binding, sm_payload_slot, sm_payload_type)
                            # `Shape.Rect(w, h):` — load the field tuple and bind each field.
                            if sm_penum and sm_payload_multi.count > 1:
                                sm_multi_slot: i64 = penum_slot_of_path(sm_payload_path, structs)
                                if sm_multi_slot < 0:
                                    sm_declined <- true
                                else:
                                    sm_multi_tuple: LLVMTypeRef = penum_field_tuple_type(sm_multi_slot.usize(), structs, ctx)
                                    sm_multi_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, llvm_type_of(sm_scrutinee_type, structs, ctx), sm_penum_slot, 1, "smatch.payload.ptr")
                                    sm_multi_value: LLVMValueRef = LLVMBuildLoad2(builder, sm_multi_tuple, sm_multi_pointer, "smatch.payload")
                                    sm_multi_start: usize = structs.penum_field_type_start[sm_multi_slot.usize()]
                                    for sm_multi_index in 0..<sm_payload_multi.count |sm_payload_multi, sm_multi_start, sm_multi_value, structs, local_scope, ctx, builder|:
                                        sm_multi_type: ValueType = copied_type(structs.penum_field_types[sm_multi_start + sm_multi_index])
                                        sm_multi_field_value: LLVMValueRef = LLVMBuildExtractValue(builder, sm_multi_value, sm_multi_index.u32(), "smatch.field")
                                        sm_multi_storage: mutable darray[u8] = []
                                        sm_multi_field_slot: LLVMValueRef = LLVMBuildAlloca(builder, llvm_type_of(sm_multi_type, structs, ctx), sview_to_cstr(sm_payload_multi[sm_multi_index], sm_multi_storage))
                                        _ = LLVMBuildStore(builder, sm_multi_field_value, sm_multi_field_slot)
                                        declare_local(local_scope, sm_payload_multi[sm_multi_index], sm_multi_field_slot, sm_multi_type)
                            # A GUARDED arm (`Variant(x) if x > 0:` / `Ident if cond:`): payload bound
                            # above so the guard can read it; on true fall into a guarded body block,
                            # on false continue to the next arm (mirrors the match-expression emitter).
                            if not sm_declined and arm_has_guard(sm_arm.guard):
                                if emit_condition(sm_arm.guard, local_scope, fns, structs, generics, runtime, m, ctx, builder) is sm_guard_bit:
                                    sm_guard_body: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, sm_function, "smatch.guard")
                                    _ = LLVMBuildCondBr(builder, sm_guard_bit, sm_guard_body, sm_next_block)
                                    LLVMPositionBuilderAtEnd(builder, sm_guard_body)
                                else:
                                    sm_declined <- true
                            if sm_declined:
                                LLVMPositionBuilderAtEnd(builder, sm_next_block)
                            else:
                                sm_arm_status: EmitStatus = emit_statements(sm_arm.body, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)
                                sm_declined <- true if sm_arm_status == EmitStatus.Declined
                                sm_any_open <- true if sm_arm_status == EmitStatus.Open
                                branch_if_open(sm_arm_status, builder, sm_done)
                                LLVMPositionBuilderAtEnd(builder, sm_next_block)
                    EmitStatus.Declined return if sm_declined
                    # No `_` arm: the frontend proved exhaustiveness, so a fall-through of the
                    # last arm's next-block is unreachable.
                    if not sm_saw_default:
                        _ = LLVMBuildUnreachable(builder)
                    LLVMPositionBuilderAtEnd(builder, sm_done)
                    # If every arm terminated, the done block is dead — terminate it too.
                    if not sm_any_open:
                        _ = LLVMBuildUnreachable(builder)
                        return EmitStatus.Terminated
                    return EmitStatus.Open
                return EmitStatus.Declined

            if statement is Stmt.For(for_bind, for_variables, for_iterable, for_body, for_line):
                # `bind` is a MODIFIER ("parallel" / "mutable" / ""), NOT the loop
                # variable — the names live in `variables`. Data-parallel range loops are
                    # lowered through the structured runtime combinator; other parallel forms are
                    # still rejected until their source-view lowering is available.
                if for_bind == "parallel":
                    parallel_range_status: EmitStatus = emit_parallel_range_for(for_variables, for_iterable, for_body, for_line, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)
                    parallel_range_status return if parallel_range_status != EmitStatus.Declined
                    parallel_band_status: EmitStatus = emit_parallel_band_for(for_variables, for_iterable, for_body, for_line, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                    parallel_band_status return if parallel_band_status != EmitStatus.Declined
                EmitStatus.Declined return if for_bind != ""
                # `for k, v in d` — DICT ITERATION over the std DynDict (a LIBRARY type; its
                # layout is `items: DictBucket&? , count, used, capacity, arena`, with
                # DictBucket = `key, value, state:u8` (state 1 == occupied)). Walk the raw
                # bucket array 0..<capacity, bind k/v only for occupied slots. Mirrors stage0's
                # two-binder iter loop over dict entries.
                if for_variables.count == 2:
                    # `for i, x in xs.enumerate()` — INDEX + VALUE iteration over a darray. The
                    # first binder is the running index (i64), the second the element. Detected by
                    # the `.enumerate()` receiver before the dict path (its iterable is a call, not
                    # a DynDict value).
                    if for_iterable is Expr.Call(en_callee, en_args, en_arg_names, en_call_line):
                        if en_callee is Expr.Field(en_source, en_method, en_method_line):
                            if en_method == "enumerate" and en_args.count == 0:
                                en_source_type: ValueType = darray_type_behind_expr(en_source, local_scope, structs)
                                EmitStatus.Declined return if en_source_type.kind != TypeKind.DArray
                                if darray_address_of_expr(en_source, local_scope, fns, structs, generics, runtime, m, ctx, builder) is en_source_slot:
                                    en_elem_type: ValueType = darray_element_of(en_source_type, structs)
                                    EmitStatus.Declined return if en_elem_type.kind == TypeKind.Unmodeled
                                    en_i64: LLVMTypeRef = LLVMInt64TypeInContext(ctx)
                                    en_header: LLVMTypeRef = darray_llvm_type(structs, ctx)
                                    en_elem_llvm: LLVMTypeRef = llvm_type_of(en_elem_type, structs, ctx)
                                    en_count_ptr: LLVMValueRef = LLVMBuildStructGEP2(builder, en_header, en_source_slot, 1, "enum.cnt.ptr")
                                    en_count: LLVMValueRef = LLVMBuildLoad2(builder, en_i64, en_count_ptr, "enum.cnt")
                                    en_items_ptr: LLVMValueRef = LLVMBuildStructGEP2(builder, en_header, en_source_slot, 0, "enum.items.ptr")
                                    en_items: LLVMValueRef = LLVMBuildLoad2(builder, LLVMPointerTypeInContext(ctx, 0), en_items_ptr, "enum.items")
                                    en_index_slot: LLVMValueRef = LLVMBuildAlloca(builder, en_i64, "enum.i")
                                    _ = LLVMBuildStore(builder, LLVMConstInt(en_i64, 0, 0), en_index_slot)
                                    en_idx_name_storage: mutable darray[u8] = []
                                    en_idx_slot: LLVMValueRef = LLVMBuildAlloca(builder, en_i64, sview_to_cstr(for_variables[0], en_idx_name_storage))
                                    declare_local(local_scope, for_variables[0], en_idx_slot, ValueType{kind: TypeKind.Signed, bits: 64})
                                    en_val_name_storage: mutable darray[u8] = []
                                    en_val_slot: LLVMValueRef = LLVMBuildAlloca(builder, en_elem_llvm, sview_to_cstr(for_variables[1], en_val_name_storage))
                                    declare_local(local_scope, for_variables[1], en_val_slot, en_elem_type)
                                    en_function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                                    en_cond: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, en_function, "enum.cond")
                                    en_bodyb: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, en_function, "enum.body")
                                    en_step: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, en_function, "enum.step")
                                    en_exit: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, en_function, "enum.exit")
                                    _ = LLVMBuildBr(builder, en_cond)
                                    LLVMPositionBuilderAtEnd(builder, en_cond)
                                    en_cur: LLVMValueRef = LLVMBuildLoad2(builder, en_i64, en_index_slot, "enum.cur")
                                    en_more: LLVMValueRef = LLVMBuildICmp(builder, 40, en_cur, en_count, "enum.more")
                                    _ = LLVMBuildCondBr(builder, en_more, en_bodyb, en_exit)
                                    LLVMPositionBuilderAtEnd(builder, en_bodyb)
                                    # i = cur; x = items[cur].
                                    _ = LLVMBuildStore(builder, en_cur, en_idx_slot)
                                    en_gep_indices: mutable darray[LLVMValueRef] = [en_cur]
                                    en_gep_pointer: void& = (&en_gep_indices[0]).cast[void&] can Unsafe.PointerCast
                                    en_elem_ptr: LLVMValueRef = LLVMBuildGEP2(builder, en_elem_llvm, en_items, en_gep_pointer, 1, "enum.elem.ptr")
                                    _ = LLVMBuildStore(builder, LLVMBuildLoad2(builder, en_elem_llvm, en_elem_ptr, "enum.elem"), en_val_slot)
                                    loops.exits <- loops.exits.push(en_exit)
                                    loops.continues <- loops.continues.push(en_step)
                                    en_body_status: EmitStatus = emit_statements(for_body, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)
                                    _ = loops.exits.pop()
                                    _ = loops.continues.pop()
                                    EmitStatus.Declined return if en_body_status == EmitStatus.Declined
                                    branch_if_open(en_body_status, builder, en_step)
                                    LLVMPositionBuilderAtEnd(builder, en_step)
                                    _ = LLVMBuildStore(builder, LLVMBuildAdd(builder, LLVMBuildLoad2(builder, en_i64, en_index_slot, "enum.next.cur"), LLVMConstInt(en_i64, 1, 0), "enum.next"), en_index_slot)
                                    _ = LLVMBuildBr(builder, en_cond)
                                    LLVMPositionBuilderAtEnd(builder, en_exit)
                                    return EmitStatus.Open
                                return EmitStatus.Declined
                    dict_iter_type: ValueType = expression_type(for_iterable, local_scope, fns, structs, generics)
                    EmitStatus.Declined return if dict_iter_type.kind != TypeKind.Struct
                    dict_slot: usize = dict_iter_type.bits.usize()
                    EmitStatus.Declined return if structs.names[dict_slot] != "DynDict"
                    dict_items_index: i64 = field_index_of(structs, dict_slot, "items")
                    dict_capacity_index: i64 = field_index_of(structs, dict_slot, "capacity")
                    EmitStatus.Declined return if dict_items_index < 0 or dict_capacity_index < 0
                    dict_items_field_type: ValueType = copied_type(structs.field_types[structs.field_start[dict_slot] + dict_items_index.usize()])
                    EmitStatus.Declined return if dict_items_field_type.kind != TypeKind.Optional
                    dict_items_ref_type: ValueType = optional_payload_of(dict_items_field_type, structs)
                    EmitStatus.Declined return if dict_items_ref_type.kind != TypeKind.Ref
                    dict_bucket_type: ValueType = ref_target_of(dict_items_ref_type, structs)
                    EmitStatus.Declined return if dict_bucket_type.kind != TypeKind.Struct
                    dict_bucket_slot: usize = dict_bucket_type.bits.usize()
                    dict_key_index: i64 = field_index_of(structs, dict_bucket_slot, "key")
                    dict_value_index: i64 = field_index_of(structs, dict_bucket_slot, "value")
                    dict_state_index: i64 = field_index_of(structs, dict_bucket_slot, "state")
                    EmitStatus.Declined return if dict_key_index < 0 or dict_value_index < 0 or dict_state_index < 0
                    dict_key_type: ValueType = copied_type(structs.field_types[structs.field_start[dict_bucket_slot] + dict_key_index.usize()])
                    dict_value_type: ValueType = copied_type(structs.field_types[structs.field_start[dict_bucket_slot] + dict_value_index.usize()])
                    if struct_chain_address(for_iterable, local_scope, fns, structs, generics, runtime, m, ctx, builder) is dict_address:
                        dict_llvm: LLVMTypeRef = llvm_type_of(dict_iter_type, structs, ctx)
                        dict_optional_llvm: LLVMTypeRef = llvm_type_of(dict_items_field_type, structs, ctx)
                        dict_bucket_llvm: LLVMTypeRef = llvm_type_of(dict_bucket_type, structs, ctx)
                        dict_i64: LLVMTypeRef = LLVMInt64TypeInContext(ctx)
                        dict_i8: LLVMTypeRef = LLVMInt8TypeInContext(ctx)
                        # items is `DictBucket&?` — a TAGGED optional {i1, ptr}; the raw array
                        # pointer is field 1. Empty dict → null items, but capacity is then 0 so
                        # the loop body never runs.
                        dict_items_opt_ptr: LLVMValueRef = LLVMBuildStructGEP2(builder, dict_llvm, dict_address, dict_items_index.u32(), "dict.items.opt.ptr")
                        dict_items_opt: LLVMValueRef = LLVMBuildLoad2(builder, dict_optional_llvm, dict_items_opt_ptr, "dict.items.opt")
                        dict_items_raw: LLVMValueRef = LLVMBuildExtractValue(builder, dict_items_opt, 1, "dict.items.raw")
                        dict_capacity_ptr: LLVMValueRef = LLVMBuildStructGEP2(builder, dict_llvm, dict_address, dict_capacity_index.u32(), "dict.cap.ptr")
                        dict_capacity: LLVMValueRef = LLVMBuildLoad2(builder, dict_i64, dict_capacity_ptr, "dict.cap")
                        dict_index_slot: LLVMValueRef = LLVMBuildAlloca(builder, dict_i64, "dict.i")
                        _ = LLVMBuildStore(builder, LLVMConstInt(dict_i64, 0, 0), dict_index_slot)
                        dict_key_storage: mutable darray[u8] = []
                        dict_key_slot: LLVMValueRef = LLVMBuildAlloca(builder, llvm_type_of(dict_key_type, structs, ctx), sview_to_cstr(for_variables[0], dict_key_storage))
                        declare_local(local_scope, for_variables[0], dict_key_slot, dict_key_type)
                        dict_value_storage: mutable darray[u8] = []
                        dict_value_slot: LLVMValueRef = LLVMBuildAlloca(builder, llvm_type_of(dict_value_type, structs, ctx), sview_to_cstr(for_variables[1], dict_value_storage))
                        declare_local(local_scope, for_variables[1], dict_value_slot, dict_value_type)
                        dict_function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                        dict_head: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, dict_function, "dict.head")
                        dict_check: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, dict_function, "dict.check")
                        dict_body: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, dict_function, "dict.body")
                        dict_step: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, dict_function, "dict.step")
                        dict_exit: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, dict_function, "dict.exit")
                        _ = LLVMBuildBr(builder, dict_head)
                        LLVMPositionBuilderAtEnd(builder, dict_head)
                        dict_current: LLVMValueRef = LLVMBuildLoad2(builder, dict_i64, dict_index_slot, "dict.cur")
                        dict_keep: LLVMValueRef = LLVMBuildICmp(builder, 36, dict_current, dict_capacity, "dict.cmp")
                        _ = LLVMBuildCondBr(builder, dict_keep, dict_check, dict_exit)
                        # CHECK: load this slot's state; occupied (1) → body, else → step.
                        LLVMPositionBuilderAtEnd(builder, dict_check)
                        dict_slot_indices: mutable darray[LLVMValueRef] = [dict_current]
                        dict_slot_indices_pointer: void& = (&dict_slot_indices[0]).cast[void&] can Unsafe.PointerCast
                        dict_bucket_ptr: LLVMValueRef = LLVMBuildGEP2(builder, dict_bucket_llvm, dict_items_raw, dict_slot_indices_pointer, 1, "dict.bucket.ptr")
                        dict_state_ptr: LLVMValueRef = LLVMBuildStructGEP2(builder, dict_bucket_llvm, dict_bucket_ptr, dict_state_index.u32(), "dict.state.ptr")
                        dict_state: LLVMValueRef = LLVMBuildLoad2(builder, dict_i8, dict_state_ptr, "dict.state")
                        dict_occupied: LLVMValueRef = LLVMBuildICmp(builder, 32, dict_state, LLVMConstInt(dict_i8, 1, 0), "dict.occ")
                        _ = LLVMBuildCondBr(builder, dict_occupied, dict_body, dict_step)
                        # BODY: bind k = bucket.key, v = bucket.value, then run the loop body.
                        LLVMPositionBuilderAtEnd(builder, dict_body)
                        dict_key_ptr: LLVMValueRef = LLVMBuildStructGEP2(builder, dict_bucket_llvm, dict_bucket_ptr, dict_key_index.u32(), "dict.key.ptr")
                        _ = LLVMBuildStore(builder, LLVMBuildLoad2(builder, llvm_type_of(dict_key_type, structs, ctx), dict_key_ptr, "dict.key"), dict_key_slot)
                        dict_value_ptr: LLVMValueRef = LLVMBuildStructGEP2(builder, dict_bucket_llvm, dict_bucket_ptr, dict_value_index.u32(), "dict.value.ptr")
                        _ = LLVMBuildStore(builder, LLVMBuildLoad2(builder, llvm_type_of(dict_value_type, structs, ctx), dict_value_ptr, "dict.value"), dict_value_slot)
                        loops.exits <- loops.exits.push(dict_exit)
                        loops.continues <- loops.continues.push(dict_step)
                        dict_body_status: EmitStatus = emit_statements(for_body, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)
                        _ = loops.exits.pop()
                        _ = loops.continues.pop()
                        EmitStatus.Declined return if dict_body_status == EmitStatus.Declined
                        branch_if_open(dict_body_status, builder, dict_step)
                        LLVMPositionBuilderAtEnd(builder, dict_step)
                        dict_next: LLVMValueRef = LLVMBuildAdd(builder, LLVMBuildLoad2(builder, dict_i64, dict_index_slot, "dict.next.cur"), LLVMConstInt(dict_i64, 1, 0), "dict.next")
                        _ = LLVMBuildStore(builder, dict_next, dict_index_slot)
                        _ = LLVMBuildBr(builder, dict_head)
                        LLVMPositionBuilderAtEnd(builder, dict_exit)
                        return EmitStatus.Open
                    return EmitStatus.Declined
                EmitStatus.Declined return if for_variables.count != 1
                for_variable: sview = for_variables[0]
                # A single-variable darray iteration uses the header's count/items fields
                # and otherwise follows the same CFG shape as integer ranges.
                # The iterable's darray header address — works for a local (`xs`), a borrowed
                # darray param (`xs: darray[T]&`), a struct FIELD (`b.items`, incl. through a
                # `Bag&` ref), and a nested `m[i]` — all via the general darray locators.
                container_type: ValueType = darray_type_behind_expr(for_iterable, local_scope, structs)
                if true:
                    if container_type.kind == TypeKind.DArray:
                        if darray_address_of_expr(for_iterable, local_scope, fns, structs, generics, runtime, m, ctx, builder) is container_slot:
                            element_type: ValueType = darray_element_of(container_type, structs)
                            EmitStatus.Declined return if element_type.kind == TypeKind.Unmodeled
                            header: LLVMTypeRef = darray_llvm_type(structs, ctx)
                            int64_type: LLVMTypeRef = LLVMInt64TypeInContext(ctx)
                            count_ptr: LLVMValueRef = LLVMBuildStructGEP2(builder, header, container_slot, 1, "for.darray.count.ptr")
                            count_value: LLVMValueRef = LLVMBuildLoad2(builder, int64_type, count_ptr, "for.darray.count")
                            items_ptr: LLVMValueRef = LLVMBuildStructGEP2(builder, header, container_slot, 0, "for.darray.items.ptr")
                            items_value: LLVMValueRef = LLVMBuildLoad2(builder, LLVMPointerTypeInContext(ctx, 0), items_ptr, "for.darray.items")
                            index_slot: LLVMValueRef = LLVMBuildAlloca(builder, int64_type, "for.darray.i")
                            _ = LLVMBuildStore(builder, LLVMConstInt(int64_type, 0, 0), index_slot)
                            loop_name_storage: mutable darray[u8] = []
                            element_slot: LLVMValueRef = LLVMBuildAlloca(builder, llvm_type_of(element_type, structs, ctx), sview_to_cstr(for_variable, loop_name_storage))
                            declare_local(local_scope, for_variable, element_slot, element_type)
                            function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                            head_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "for.darray.head")
                            body_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "for.darray.body")
                            step_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "for.darray.step")
                            exit_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "for.darray.exit")
                            _ = LLVMBuildBr(builder, head_block)
                            LLVMPositionBuilderAtEnd(builder, head_block)
                            current: LLVMValueRef = LLVMBuildLoad2(builder, int64_type, index_slot, "for.darray.cur")
                            keep_going: LLVMValueRef = LLVMBuildICmp(builder, 36, current, count_value, "for.darray.cmp")
                            _ = LLVMBuildCondBr(builder, keep_going, body_block, exit_block)
                            LLVMPositionBuilderAtEnd(builder, body_block)
                            indices: mutable darray[LLVMValueRef] = [current]
                            indices_pointer: void& = (&indices[0]).cast[void&] can Unsafe.PointerCast
                            element_pointer: LLVMValueRef = LLVMBuildGEP2(builder, llvm_type_of(element_type, structs, ctx), items_value, indices_pointer, 1, "for.darray.elem.ptr")
                            _ = LLVMBuildStore(builder, LLVMBuildLoad2(builder, llvm_type_of(element_type, structs, ctx), element_pointer, "for.darray.elem"), element_slot)
                            loops.exits <- loops.exits.push(exit_block)
                            loops.continues <- loops.continues.push(step_block)
                            body_status: mutable EmitStatus = EmitStatus.Open
                            body_status <- emit_statements(for_body, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)
                            _ = loops.exits.pop()
                            _ = loops.continues.pop()
                            EmitStatus.Declined return if body_status == EmitStatus.Declined
                            branch_if_open(body_status, builder, step_block)
                            LLVMPositionBuilderAtEnd(builder, step_block)
                            next_index: LLVMValueRef = LLVMBuildAdd(builder, LLVMBuildLoad2(builder, int64_type, index_slot, "for.darray.next.cur"), LLVMConstInt(int64_type, 1, 0), "for.darray.next")
                            _ = LLVMBuildStore(builder, next_index, index_slot)
                            _ = LLVMBuildBr(builder, head_block)
                            LLVMPositionBuilderAtEnd(builder, exit_block)
                            return EmitStatus.Open
                # `for c in s` over a STRING. sview (`{ptr, i64 len}`) iterates its bytes by
                # index < len; cstr (a bare NUL-terminated ptr) iterates until a 0 byte. The
                # loop variable is a u8. Mirrors the darray CFG.
                string_iter_type: ValueType = expression_type(for_iterable, local_scope, fns, structs, generics)
                if string_iter_type.kind == TypeKind.SView or string_iter_type.kind == TypeKind.CStr:
                    if emit_expression(for_iterable, string_iter_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is string_value:
                        is_cstr: bool = string_iter_type.kind == TypeKind.CStr
                        u8_type: ValueType = ValueType{kind: TypeKind.Unsigned, bits: 8}
                        u8_llvm: LLVMTypeRef = LLVMInt8TypeInContext(ctx)
                        int64_type_s: LLVMTypeRef = LLVMInt64TypeInContext(ctx)
                        pointer_type_s: LLVMTypeRef = LLVMPointerTypeInContext(ctx, 0)
                        # cstr IS a bare ptr; sview's data pointer is field 0, length field 1.
                        data_ptr: LLVMValueRef = string_value if is_cstr else LLVMBuildExtractValue(builder, string_value, 0, "for.str.ptr")
                        str_len: LLVMValueRef = LLVMConstInt(int64_type_s, 0, 0) if is_cstr else LLVMBuildExtractValue(builder, string_value, 1, "for.str.len")
                        str_index_slot: LLVMValueRef = LLVMBuildAlloca(builder, int64_type_s, "for.str.i")
                        _ = LLVMBuildStore(builder, LLVMConstInt(int64_type_s, 0, 0), str_index_slot)
                        str_name_storage: mutable darray[u8] = []
                        str_element_slot: LLVMValueRef = LLVMBuildAlloca(builder, u8_llvm, sview_to_cstr(for_variable, str_name_storage))
                        declare_local(local_scope, for_variable, str_element_slot, u8_type)
                        str_function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                        str_head: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, str_function, "for.str.head")
                        str_body: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, str_function, "for.str.body")
                        str_step: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, str_function, "for.str.step")
                        str_exit: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, str_function, "for.str.exit")
                        _ = LLVMBuildBr(builder, str_head)
                        LLVMPositionBuilderAtEnd(builder, str_head)
                        str_cur: LLVMValueRef = LLVMBuildLoad2(builder, int64_type_s, str_index_slot, "for.str.cur")
                        str_byte_indices: mutable darray[LLVMValueRef] = [str_cur]
                        str_byte_indices_pointer: void& = (&str_byte_indices[0]).cast[void&] can Unsafe.PointerCast
                        str_byte_ptr: LLVMValueRef = LLVMBuildGEP2(builder, u8_llvm, data_ptr, str_byte_indices_pointer, 1, "for.str.byte.ptr")
                        str_byte: LLVMValueRef = LLVMBuildLoad2(builder, u8_llvm, str_byte_ptr, "for.str.byte")
                        # cstr: continue while byte != 0. sview: continue while index < len.
                        str_keep: LLVMValueRef = LLVMBuildICmp(builder, 33, str_byte, LLVMConstInt(u8_llvm, 0, 0), "for.str.notnul") if is_cstr else LLVMBuildICmp(builder, 36, str_cur, str_len, "for.str.cmp")
                        _ = LLVMBuildCondBr(builder, str_keep, str_body, str_exit)
                        LLVMPositionBuilderAtEnd(builder, str_body)
                        _ = LLVMBuildStore(builder, str_byte, str_element_slot)
                        loops.exits <- loops.exits.push(str_exit)
                        loops.continues <- loops.continues.push(str_step)
                        str_body_status: EmitStatus = emit_statements(for_body, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)
                        _ = loops.exits.pop()
                        _ = loops.continues.pop()
                        EmitStatus.Declined return if str_body_status == EmitStatus.Declined
                        branch_if_open(str_body_status, builder, str_step)
                        LLVMPositionBuilderAtEnd(builder, str_step)
                        str_next: LLVMValueRef = LLVMBuildAdd(builder, LLVMBuildLoad2(builder, int64_type_s, str_index_slot, "for.str.next.cur"), LLVMConstInt(int64_type_s, 1, 0), "for.str.next")
                        _ = LLVMBuildStore(builder, str_next, str_index_slot)
                        _ = LLVMBuildBr(builder, str_head)
                        LLVMPositionBuilderAtEnd(builder, str_exit)
                        return EmitStatus.Open
                    return EmitStatus.Declined
                if for_iterable is Expr.Binary(range_low, range_operator, range_high, range_line):
                    inclusive: bool = range_operator == TokenKind.RangeLe
                    # `a..>b` is a countdown (stage0: start=a, while i>b, i-=1). Used by
                    # `for _ in count..>0` in lexer advance_chars.
                    descending: bool = range_operator == TokenKind.RangeGt
                    EmitStatus.Declined return if range_operator != TokenKind.RangeLt and not inclusive and not descending

                    # The loop variable's type comes from the range bounds; a bare
                    # `0..<10` is two literals, so it defaults to signed 64.
                    loop_type: ValueType = resolve_type(range_low, resolve_type(range_high, ValueType{kind: TypeKind.Signed, bits: 64}, local_scope, fns, structs, generics), local_scope, fns, structs, generics)
                    EmitStatus.Declined return if not is_integer_type(loop_type)
                    low_opt: LLVMValueRef? = emit_expression(range_low, loop_type, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                    high_opt: LLVMValueRef? = emit_expression(range_high, loop_type, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                    if low_opt is low_value:
                        if high_opt is high_value:
                            name_storage: mutable darray[u8] = []
                            # `_` is a discard binder — still need a counter slot, just no name.
                            slot_name: cstr = "for.i" if for_variable == "_" else sview_to_cstr(for_variable, name_storage)
                            slot: LLVMValueRef = LLVMBuildAlloca(builder, int64_type, slot_name)
                            _ = LLVMBuildStore(builder, low_value, slot)
                            declare_local(local_scope, for_variable, slot, loop_type) if for_variable != "_"

                            function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                            head_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "for.head")
                            body_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "for.body")
                            step_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "for.step")
                            exit_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "for.exit")

                            _ = LLVMBuildBr(builder, head_block)
                            LLVMPositionBuilderAtEnd(builder, head_block)
                            loop_llvm_type: LLVMTypeRef = llvm_type_of(loop_type, structs, ctx)
                            counter: LLVMValueRef = LLVMBuildLoad2(builder, loop_llvm_type, slot, "for.i")
                            # Ascending: 41 = SLE (`..=`), 40 = SLT (`..<`).
                            # Descending `a..>b`: SGT (38) / UGT (34) — stage0 icmp sgt.
                            signed_predicate: mutable i32 = 41 if inclusive else 40
                            signed_predicate <- 38 if descending else signed_predicate
                            predicate: i32 = unsigned_predicate_of(signed_predicate) if loop_type.kind == TypeKind.Unsigned else signed_predicate
                            keep_going: LLVMValueRef = LLVMBuildICmp(builder, predicate, counter, high_value, "for.cmp")
                            _ = LLVMBuildCondBr(builder, keep_going, body_block, exit_block)

                            LLVMPositionBuilderAtEnd(builder, body_block)
                            loops.exits <- loops.exits.push(exit_block)
                            loops.continues <- loops.continues.push(step_block)
                            body_status: EmitStatus = emit_statements(for_body, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)
                            _ = loops.exits.pop()
                            _ = loops.continues.pop()
                            EmitStatus.Declined return if body_status == EmitStatus.Declined
                            branch_if_open(body_status, builder, step_block)

                            LLVMPositionBuilderAtEnd(builder, step_block)
                            cur: LLVMValueRef = LLVMBuildLoad2(builder, loop_llvm_type, slot, "for.cur")
                            stepped: LLVMValueRef = LLVMBuildSub(builder, cur, LLVMConstInt(loop_llvm_type, 1, 0), "for.next") if descending else LLVMBuildAdd(builder, cur, LLVMConstInt(loop_llvm_type, 1, 0), "for.next")
                            _ = LLVMBuildStore(builder, stepped, slot)
                            _ = LLVMBuildBr(builder, head_block)

                            LLVMPositionBuilderAtEnd(builder, exit_block)
                            return EmitStatus.Open
                return EmitStatus.Declined

            return EmitStatus.Declined
