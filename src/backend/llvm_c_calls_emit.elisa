# --- calls / params -------------------------------------------------------
# NOTE: LLVMGetBasicBlockTerminator is deliberately NOT bound (EmitStatus tracks it). But
# LLVMGetNamedFunction IS bound above now: the `-> T?`-always-binds-null bug it was avoiding
# was fixed (verified -- contract abort emits exactly ONE `declare void @abort`).
# Both return a pointer that is NULL-or-not, i.e. they want `-> LLVMValueRef?` — and an
# extern declared to return an optional of an opaque extern type ALWAYS binds null in
# stage0, even when C returns a real pointer (isolated repro filed; it is silent, with no
# diagnostic). The backend therefore tracks both facts itself: `FnTable` for name lookup
# and `EmitStatus` for block termination. That is independently better — both are things
# the emitter already knows and need not ask LLVM to recompute.
extern LLVMGetParam(fn: LLVMValueRef, index: u32) -> LLVMValueRef
extern LLVMCountParams(fn: LLVMValueRef) -> u32
# `args` is an `LLVMValueRef*`; pass null when count is 0.
extern LLVMBuildCall2(b: LLVMBuilderRef, fn_type: LLVMTypeRef, fn: LLVMValueRef, args: void&?, count: u32, name: cstr) -> LLVMValueRef
extern LLVMBuildVAArg(b: LLVMBuilderRef, list: LLVMValueRef, type: LLVMTypeRef, name: cstr) -> LLVMValueRef
extern LLVMGlobalGetValueType(global_value: LLVMValueRef) -> LLVMTypeRef
extern LLVMGetReturnType(function_type: LLVMTypeRef) -> LLVMTypeRef
extern LLVMIsFunctionVarArg(function_type: LLVMTypeRef) -> i32
extern LLVMCountParamTypes(function_type: LLVMTypeRef) -> u32
# dest must hold LLVMCountParamTypes(function_type) LLVMTypeRef slots.
extern LLVMGetParamTypes(function_type: LLVMTypeRef, dest: void&) -> void
# LLVMInlineAsmDialectATT = 0.  The C enum is passed as an i32 because Elisa's extern
# declarations do not need to reproduce LLVM's private enum type.
extern LLVMGetInlineAsm(ty: LLVMTypeRef, asm_text: cstr, asm_length: usize, constraints: cstr, constraints_length: usize, has_side_effects: i32, is_align_stack: i32, dialect: i32, can_throw: i32) -> LLVMValueRef

# --- verify / emit --------------------------------------------------------
# LLVMVerifyModule's action 2 = LLVMReturnStatusAction (report, do not abort).
extern LLVMVerifyModule(m: LLVMModuleRef, action: i32, message: void&?) -> i32
extern LLVMPrintModuleToFile(m: LLVMModuleRef, path: cstr, message: void&?) -> i32

# Type walking for the C ABI classifier at export boundaries (codegen_declare).
extern LLVMGetTypeKind(ty: LLVMTypeRef) -> u32
extern LLVMCountStructElementTypes(ty: LLVMTypeRef) -> u32
extern LLVMStructGetTypeAtIndex(ty: LLVMTypeRef, index: u32) -> LLVMTypeRef
extern LLVMGetElementType(ty: LLVMTypeRef) -> LLVMTypeRef
extern LLVMGetArrayLength2(ty: LLVMTypeRef) -> u64
extern LLVMVectorType(element: LLVMTypeRef, count: u32) -> LLVMTypeRef

# Used to verify that restoring a cached fragment filled an existing declaration.
extern LLVMCountBasicBlocks(fn: LLVMValueRef) -> u32
extern LLVMHasMetadata(value: LLVMValueRef) -> i32
extern LLVMGetAllocatedType(value: LLVMValueRef) -> LLVMTypeRef
extern LLVMPrintValueToString(value: LLVMValueRef) -> cstr
extern LLVMGetOrdering(value: LLVMValueRef) -> u32

# LLVM C++ bridge; the native seed and gen2 link this from llvm_validation_peel.cpp.
extern elisacorePeelSmallValidationLoops(m: LLVMModuleRef) -> u32
extern elisacoreElideBoundedDivisionSums(m: LLVMModuleRef) -> u32
extern elisacorePeelRemainderTail(m: LLVMModuleRef) -> u32

extern elisacoreConfigureBoundedUnroll() -> void
extern elisacoreConfigureAppleCodeLayout() -> void
extern elisacoreLateScalarCleanup(m: LLVMModuleRef, machine: void&) -> u32
extern elisacoreCsscAbsoluteRangeChecks(m: LLVMModuleRef, machine: void&) -> u32

extern elisacoreExpandSmallZeroFills(m: LLVMModuleRef) -> u32
extern elisacoreElideScratchPrefixInitializers(m: LLVMModuleRef) -> u32
extern elisacoreElideArrayRoundTrips(m: LLVMModuleRef) -> u32

extern elisacorePackPrivateBoolArrays(m: LLVMModuleRef, machine: void&) -> u32

extern elisacoreSpecializeShortTrips(m: LLVMModuleRef, machine: void&) -> u32

extern elisacoreInlineSmallRecursiveFunctions(m: LLVMModuleRef, machine: void&) -> u32
