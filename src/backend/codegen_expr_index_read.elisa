# Stage1 backend — `xs[i]`, an index READ, across every receiver the backend models: a local
# array whose address is its own slot, a darray through its header, a dict or set through the
# runtime, and a packed store row. Part of `module Backend` (see codegen.elisa).

extend Backend:
    private:
        # A `darray[T&]` element (or `T&` field) read in a VALUE position (`out[0] - 42`,
        # expected `T`) auto-dereferences like a ref local does; returning the pointer handed an i64
        # arithmetic intrinsic a `ptr` operand and the module failed verification. Only a
        # scalar expected type equal to the ref target loads; everything else keeps the ref.
        def element_ref_auto_deref(value: LLVMValueRef, element: ValueType, expected: ValueType, structs: mutable StructTable&, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef can[Abort.Panic, Memory.Allocate]:
            return value if element.kind != TypeKind.Ref or expected.kind == TypeKind.Ref or not is_numeric_type(expected)
            target: ValueType = ref_target_of(element, structs)
            return value if target.kind != expected.kind or target.bits != expected.bits
            return LLVMBuildLoad2(builder, llvm_type_of(target, structs, ctx), value, "darray.elem.deref")

        # `sv[i]` on a 64-bit target, inline. Exactly the runtime's `string_view_index`:
        # a negative length, a negative index or one at/after the end reads 0, otherwise the
        # byte zero-extended to i64. Emitting the out-of-line `ctx_string_view_index` call cost
        # one opaque call per byte, which kept every byte-scanning loop scalar and call-bound;
        # inline, a loop already bounded by `sv.len` folds the range test away. (On a 32-bit
        # target the runtime's extra usize round-trip checks differ, so the call stays there.)
        def emit_inline_sview_index(view: LLVMValueRef, index: LLVMValueRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            i64_type: LLVMTypeRef = LLVMInt64TypeInContext(ctx)
            data: LLVMValueRef = LLVMBuildExtractValue(builder, view, 0, "sview.idx.data")
            length: LLVMValueRef = LLVMBuildExtractValue(builder, view, 1, "sview.idx.len")
            zero: LLVMValueRef = LLVMConstInt(i64_type, 0, 0)
            length_ok: LLVMValueRef = LLVMBuildICmp(builder, LLVMIntPredicate::SGE, length, zero, "sview.idx.len.ok")
            index_ok: LLVMValueRef = LLVMBuildICmp(builder, LLVMIntPredicate::ULT, index, length, "sview.idx.in")
            in_range: LLVMValueRef = LLVMBuildAnd(builder, length_ok, index_ok, "sview.idx.ok")
            slot: LLVMValueRef = build_entry_alloca(builder, i64_type, "sview.idx.slot")
            _ = LLVMBuildStore(builder, zero, slot)
            parent: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
            read_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, parent, "sview.idx.read")
            join_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, parent, "sview.idx.join")
            _ = LLVMBuildCondBr(builder, in_range, read_block, join_block)
            LLVMPositionBuilderAtEnd(builder, read_block)
            indices: mutable darray[LLVMValueRef] = [index]
            indices_pointer: void& = (&indices[0]).cast[void&] can Unsafe.PointerCast
            byte_pointer: LLVMValueRef = LLVMBuildGEP2(builder, LLVMInt8TypeInContext(ctx), data, indices_pointer, 1, "sview.idx.ptr")
            byte: LLVMValueRef = LLVMBuildLoad2(builder, LLVMInt8TypeInContext(ctx), byte_pointer, "sview.idx.byte")
            _ = LLVMBuildStore(builder, LLVMBuildZExt(builder, byte, i64_type, "sview.idx.wide"), slot)
            _ = LLVMBuildBr(builder, join_block)
            LLVMPositionBuilderAtEnd(builder, join_block)
            return LLVMBuildLoad2(builder, i64_type, slot, "sview.index")


        # `cstr[i]` on 64-bit targets, via the same null-normalized source and strlen
        # lowering as CStr.len. This gives LLVM a chance to share the source length across
        # the loop. Negative indexes are rejected by the existing unsigned bounds check.
        # The caller keeps the runtime path on 32-bit, where usize round-trip differs.
        def emit_inline_cstr_index(base: LLVMValueRef, index: LLVMValueRef, m: LLVMModuleRef, structs: mutable StructTable&, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            i64_type: LLVMTypeRef = LLVMInt64TypeInContext(ctx)
            sview_type: ValueType = ValueType{kind: TypeKind.SView, bits: 0}
            sview_llvm: LLVMTypeRef = llvm_type_of(sview_type, structs, ctx)
            start: LLVMValueRef = LLVMConstInt(i64_type, 0, 0)
            end: LLVMValueRef = LLVMConstInt(i64_type, 18446744073709551615, 1)
            view: LLVMValueRef = emit_sview_from_parts(base, start, end, sview_llvm, m, ctx, builder, structs.target.target_pointer_bits)
            return emit_inline_sview_index(view, index, ctx, builder)
