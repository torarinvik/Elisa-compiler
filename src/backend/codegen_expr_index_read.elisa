# Stage1 backend — `xs[i]`, an index READ, across every receiver the backend models: a local
# array whose address is its own slot, a darray through its header, a dict or set through the
# runtime, and a packed store row. Part of `module Backend` (see codegen.elisa).

extend Backend:
    private:
        def emit_expression_index_read(expression: Expr, expected: ValueType, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef, handled: mutable bool&) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            match expression:
                Expr.Index(indexed_object, index_expression, index_line):
                    # `chunks[i]` on a ChunksExactView — the i'th whole chunk, as a view over the
                    # base starting at `i * chunk` and `chunk` long. The struct is `{base, chunk,
                    # count}` (stage0's layout), so both fields come out of the aggregate.
                    # A `Flags[T]` BIT TEST (see flags_bit_test_ordinal for the shape).
                    flags_recv: ValueType = expression_type(indexed_object, local_scope, fns, structs, generics)
                    flags_ordinal: i64 = flags_bit_test_ordinal(flags_recv, index_expression, structs)
                    if flags_ordinal >= 0:
                        flags_struct: mutable ValueType = copied_type(flags_recv)
                        flags_struct <- ref_target_of(flags_struct, structs) if flags_struct.kind == TypeKind.Ref
                        flags_field: ValueType = copied_type(structs.field_types[structs.field_start[flags_struct.bits.usize()]])
                        if emit_expression(indexed_object, flags_struct, local_scope, fns, structs, generics, runtime, m, ctx, builder) is flags_aggregate:
                            flags_bits: LLVMValueRef = LLVMBuildExtractValue(builder, flags_aggregate, 0, "flags.bits")
                            flags_llvm: LLVMTypeRef = llvm_type_of(flags_field, structs, ctx)
                            flags_hit: LLVMValueRef = LLVMBuildAnd(builder, flags_bits, LLVMConstInt(flags_llvm, (1.u64() << flags_ordinal.u32()), 0), "flags.hit")
                            return LLVMBuildICmp(builder, 33, flags_hit, LLVMConstInt(flags_llvm, 0, 0), "flags.has")
                        return null
                    chunk_recv: ValueType = expression_type(indexed_object, local_scope, fns, structs, generics)
                    if chunk_recv.kind == TypeKind.Struct and synthesized_struct_base_is(structs, chunk_recv, "ChunksExactView"):
                        chunk_view_type: ValueType = copied_type(structs.field_types[structs.field_start[chunk_recv.bits.usize()]])
                        chunk_element: ValueType = view_element_of(chunk_view_type, structs)
                        null return if chunk_element.kind == TypeKind.Unmodeled
                        if emit_expression(indexed_object, chunk_recv, local_scope, fns, structs, generics, runtime, m, ctx, builder) is chunk_agg:
                            if emit_expression(index_expression, ValueType{kind: TypeKind.Signed, bits: 64}, local_scope, fns, structs, generics, runtime, m, ctx, builder) is chunk_index:
                                chunk_base: LLVMValueRef = LLVMBuildExtractValue(builder, chunk_agg, 0, "chunk.base")
                                chunk_len: LLVMValueRef = LLVMBuildExtractValue(builder, chunk_agg, 1, "chunk.len")
                                chunk_data: LLVMValueRef = LLVMBuildExtractValue(builder, chunk_base, 0, "chunk.data")
                                chunk_offsets: mutable darray[LLVMValueRef] = [LLVMBuildMul(builder, chunk_index, chunk_len, "chunk.offset")]
                                chunk_offsets_pointer: void& = (&chunk_offsets[0]).cast[void&] can Unsafe.PointerCast
                                chunk_at: LLVMValueRef = LLVMBuildGEP2(builder, llvm_type_of(chunk_element, structs, ctx), chunk_data, chunk_offsets_pointer, 1, "chunk.at")
                                chunk_result: mutable LLVMValueRef = LLVMGetUndef(llvm_type_of(chunk_view_type, structs, ctx))
                                chunk_result <- LLVMBuildInsertValue(builder, chunk_result, chunk_at, 0, "chunk.view.data")
                                chunk_result <- LLVMBuildInsertValue(builder, chunk_result, chunk_len, 1, "chunk.view.len")
                                return chunk_result
                        return null
                    # `values[1:3][0]` — indexing a slice DIRECTLY, with no intermediate `view[T]`
                    # local. The slice paths above all key off an EXPECTED view type, and here the
                    # expected type is the ELEMENT's, so nothing produced the view and the chain
                    # resolver declined. Emit the slice at the view type its receiver implies, then
                    # read through it.
                    #
                    # Only ARRAY receivers (by value or by reference) take this route: a darray or
                    # sview slice reaches here with the same shape but is already served by the
                    # paths above once a view local is involved, and widening this to them would
                    # duplicate the very byte-GEP hazard the guards there exist to prevent.
                    match indexed_object:
                        Expr.Slice(chain_slice_object, chain_slice_start, chain_slice_end, chain_slice_line):
                            chain_slice_source: ValueType = expression_type(chain_slice_object, local_scope, fns, structs, generics)
                            chain_slice_array: mutable ValueType = chain_slice_source
                            if chain_slice_source.kind == TypeKind.Ref:
                                chain_slice_array <- ref_target_of(chain_slice_source, structs)
                            if chain_slice_array.kind == TypeKind.Array:
                                chain_slice_element: ValueType = array_element_of(chain_slice_array, structs)
                                if chain_slice_element.kind != TypeKind.Unmodeled:
                                    chain_slice_view: ValueType = intern_view_type(chain_slice_element, structs)
                                    if emit_expression(indexed_object, chain_slice_view, local_scope, fns, structs, generics, runtime, m, ctx, builder) is chain_slice_view_value:
                                        if emit_expression(index_expression, ValueType{kind: TypeKind.Signed, bits: 64}, local_scope, fns, structs, generics, runtime, m, ctx, builder) is chain_slice_index:
                                            chain_slice_data: LLVMValueRef = LLVMBuildExtractValue(builder, chain_slice_view_value, 0, "sliceidx.data")
                                            chain_slice_element_llvm: LLVMTypeRef = llvm_type_of(chain_slice_element, structs, ctx)
                                            chain_slice_gep: mutable darray[LLVMValueRef] = [chain_slice_index]
                                            chain_slice_gep_pointer: void& = (&chain_slice_gep[0]).cast[void&] can Unsafe.PointerCast
                                            chain_slice_pointer: LLVMValueRef = LLVMBuildGEP2(builder, chain_slice_element_llvm, chain_slice_data, chain_slice_gep_pointer, 1, "sliceidx.ptr")
                                            chain_slice_loaded: LLVMValueRef = LLVMBuildLoad2(builder, chain_slice_element_llvm, chain_slice_pointer, "sliceidx.elem")
                                            return emit_conversion(chain_slice_loaded, chain_slice_element, expected, structs, ctx, builder) if expected.kind != TypeKind.Unmodeled and (expected.kind != chain_slice_element.kind or expected.bits != chain_slice_element.bits) else chain_slice_loaded
                                    return null
                        _:
                            pass
                    # Guest-overlay accessor `base.field[mem]` (docs/107): desugars to
                    # MemoryManager_ReadU<W>(mem, base + offset), matching stage0's analyzer
                    # rewrite. The carrier is a GuestVAddr[L]/HostPtr address integer.
                    match indexed_object:
                        Expr.Field(overlay_base, overlay_field, overlay_field_line):
                            overlay_base_type: ValueType = expression_type(overlay_base, local_scope, fns, structs, generics)
                            if overlay_base_type.kind == TypeKind.GuestCarrier:
                                overlay_layout: sview = guest_carrier_layout(overlay_base_type, structs)
                                overlay_info: (offset: i64, width: u32) = overlay_field_info(structs, overlay_layout, overlay_field)
                                if overlay_info.offset >= 0 and (overlay_info.width == 1 or overlay_info.width == 2 or overlay_info.width == 4 or overlay_info.width == 8):
                                    if emit_expression(overlay_base, overlay_base_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is overlay_base_value:
                                        if emit_expression(index_expression, ValueType{kind: TypeKind.Unsigned, bits: 64}, local_scope, fns, structs, generics, runtime, m, ctx, builder) is overlay_mem_value:
                                            overlay_offset_const: LLVMValueRef = LLVMConstInt(LLVMInt64TypeInContext(ctx), overlay_info.offset.u64(), 0)
                                            overlay_addr: LLVMValueRef = LLVMBuildAdd(builder, overlay_base_value, overlay_offset_const, "overlay.addr")
                                            overlay_ret_bits: u32 = 8 if overlay_info.width == 1 else (16 if overlay_info.width == 2 else (32 if overlay_info.width == 4 else 64))
                                            overlay_ret_llvm: LLVMTypeRef = LLVMInt8TypeInContext(ctx) if overlay_ret_bits == 8 else (LLVMInt16TypeInContext(ctx) if overlay_ret_bits == 16 else (LLVMInt32TypeInContext(ctx) if overlay_ret_bits == 32 else LLVMInt64TypeInContext(ctx)))
                                            overlay_param_types: mutable darray[LLVMTypeRef] = [LLVMInt64TypeInContext(ctx), LLVMInt64TypeInContext(ctx)]
                                            overlay_param_pointer: void& = (&overlay_param_types[0]).cast[void&] can Unsafe.PointerCast
                                            overlay_fn_type: LLVMTypeRef = LLVMFunctionType(overlay_ret_llvm, overlay_param_pointer, 2, 0)
                                            overlay_fn: LLVMValueRef = declare_or_get_named(m, "MemoryManager_ReadU8", overlay_fn_type) if overlay_info.width == 1 else (declare_or_get_named(m, "MemoryManager_ReadU16", overlay_fn_type) if overlay_info.width == 2 else (declare_or_get_named(m, "MemoryManager_ReadU32", overlay_fn_type) if overlay_info.width == 4 else declare_or_get_named(m, "MemoryManager_ReadU64", overlay_fn_type)))
                                            overlay_args: mutable darray[LLVMValueRef] = [overlay_mem_value, overlay_addr]
                                            overlay_args_pointer: void& = (&overlay_args[0]).cast[void&] can Unsafe.PointerCast
                                            overlay_raw: LLVMValueRef = LLVMBuildCall2(builder, overlay_fn_type, overlay_fn, overlay_args_pointer, 2, "overlay.read")
                                            overlay_as_i64: mutable LLVMValueRef = overlay_raw
                                            if overlay_ret_bits < 64:
                                                overlay_as_i64 <- LLVMBuildZExt(builder, overlay_raw, LLVMInt64TypeInContext(ctx), "overlay.zext")
                                            overlay_result_type: ValueType = ValueType{kind: TypeKind.Unsigned, bits: 64}
                                            return emit_conversion(overlay_as_i64, overlay_result_type, expected, structs, ctx, builder) if expected.kind != TypeKind.Unmodeled and (expected.kind != overlay_result_type.kind or expected.bits != overlay_result_type.bits) else overlay_as_i64
                                    return null
                        _:
                            pass
                    # `sv[i]` — a byte read from a string view via `ctx_string_view_index(sv, i)`
                    # (the view passed BY VALUE). Returns i64.
                    sview_index_recv_type: ValueType = expression_type(indexed_object, local_scope, fns, structs, generics)
                    if sview_index_recv_type.kind == TypeKind.SView:
                        if emit_expression(indexed_object, sview_index_recv_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is sview_index_recv:
                            if emit_expression(index_expression, ValueType{kind: TypeKind.Signed, bits: 64}, local_scope, fns, structs, generics, runtime, m, ctx, builder) is sview_index_arg:
                                sview_index_args: mutable darray[LLVMValueRef] = [sview_index_recv, sview_index_arg]
                                sview_index_args_pointer: void& = (&sview_index_args[0]).cast[void&] can Unsafe.PointerCast
                                sview_index_value: LLVMValueRef = LLVMBuildCall2(builder, runtime.sview_index_type, runtime.sview_index, sview_index_args_pointer, 2, "sview.index")
                                sview_index_result: ValueType = ValueType{kind: TypeKind.Signed, bits: 64}
                                return emit_conversion(sview_index_value, sview_index_result, expected, structs, ctx, builder) if expected.kind != TypeKind.Unmodeled and (expected.kind != sview_index_result.kind or expected.bits != sview_index_result.bits) else sview_index_value
                            return null
                        return null
                    # `s[i]` — a byte read from a cstr via `ctx_string_index(s, i)` (stage0's
                    # lowering), returning i64. The pointer is passed by value.
                    if sview_index_recv_type.kind == TypeKind.CStr:
                        if emit_expression(indexed_object, sview_index_recv_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is cstr_index_recv:
                            if emit_expression(index_expression, ValueType{kind: TypeKind.Signed, bits: 64}, local_scope, fns, structs, generics, runtime, m, ctx, builder) is cstr_index_arg:
                                cstr_index_param_types: mutable darray[LLVMTypeRef] = [LLVMPointerTypeInContext(ctx, 0), LLVMInt64TypeInContext(ctx)]
                                cstr_index_param_pointer: void& = (&cstr_index_param_types[0]).cast[void&] can Unsafe.PointerCast
                                cstr_index_fn_type: LLVMTypeRef = LLVMFunctionType(LLVMInt64TypeInContext(ctx), cstr_index_param_pointer, 2, 0)
                                cstr_index_fn: LLVMValueRef = declare_or_get_named(m, "ctx_string_index", cstr_index_fn_type)
                                cstr_index_args: mutable darray[LLVMValueRef] = [cstr_index_recv, cstr_index_arg]
                                cstr_index_args_pointer: void& = (&cstr_index_args[0]).cast[void&] can Unsafe.PointerCast
                                cstr_index_value: LLVMValueRef = LLVMBuildCall2(builder, cstr_index_fn_type, cstr_index_fn, cstr_index_args_pointer, 2, "cstr.index")
                                cstr_index_result: ValueType = ValueType{kind: TypeKind.Signed, bits: 64}
                                return emit_conversion(cstr_index_value, cstr_index_result, expected, structs, ctx, builder) if expected.kind != TypeKind.Unmodeled and (expected.kind != cstr_index_result.kind or expected.bits != cstr_index_result.bits) else cstr_index_value
                            return null
                        return null
                    # `view.data[i]` — a byte read through the data pointer field of an sview.
                    # This is equivalent to `view[i]`, but some stdlib helpers use the explicit
                    # pointer field. Handle the field-backed base directly instead of requiring
                    # the pointer to be a bare local identifier.
                    match indexed_object:
                        Expr.Field(sview_data_owner, sview_data_field, sview_data_line):
                            if sview_data_field == "data":
                                sview_data_owner_type: ValueType = expression_type(sview_data_owner, local_scope, fns, structs, generics)
                                if sview_data_owner_type.kind == TypeKind.SView:
                                    if emit_expression(sview_data_owner, sview_data_owner_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is sview_data_owner_value:
                                        sview_data_base: LLVMValueRef = LLVMBuildExtractValue(builder, sview_data_owner_value, 0, "sview.data.base")
                                        if emit_expression(index_expression, ValueType{kind: TypeKind.Unsigned, bits: 64}, local_scope, fns, structs, generics, runtime, m, ctx, builder) is sview_data_index:
                                            sview_data_indices: mutable darray[LLVMValueRef] = [sview_data_index]
                                            sview_data_indices_pointer: void& = (&sview_data_indices[0]).cast[void&] can Unsafe.PointerCast
                                            sview_data_pointer: LLVMValueRef = LLVMBuildGEP2(builder, LLVMInt8TypeInContext(ctx), sview_data_base, sview_data_indices_pointer, 1, "sview.data.ptr")
                                            sview_data_value: LLVMValueRef = LLVMBuildLoad2(builder, LLVMInt8TypeInContext(ctx), sview_data_pointer, "sview.data.byte")
                                            sview_data_result: ValueType = ValueType{kind: TypeKind.Unsigned, bits: 8}
                                            return emit_conversion(sview_data_value, sview_data_result, expected, structs, ctx, builder) if expected.kind != TypeKind.Unmodeled and (expected.kind != sview_data_result.kind or expected.bits != sview_data_result.bits) else sview_data_value
                                        return null
                                    return null
                        _:
                            pass
                    # An INLINE literal receiver (`[1, 2, 3][1]`) has no name for the locators
                    # below to look up, and the literal emitter takes its shape from the EXPECTED
                    # type, which an index position supplies none of — so the whole function
                    # dropped. Build the expected type from the elements (first known type wins;
                    # a bare int literal defaults signed-64 as it does everywhere else), emit the
                    # literal into a temporary, and index that — the same shape a named local
                    # takes, minus the name. All-untyped or empty elements keep declining.
                    # `[[1, 2], [3, 4]][1][0]` — the OUTER index whose receiver is itself an index
                    # into an inline literal. The receiver has no name to look up and is not an
                    # Expr.Array, so no branch below matched and the whole function declined.
                    # Emit the inner index at the ROW type (a darray), spill it, and index that —
                    # the same temporary-and-index shape the single-literal branch uses.
                    match indexed_object:
                        Expr.Index(chain_inner_object, chain_inner_index, chain_line):
                            match chain_inner_object:
                                Expr.Array(chain_lit_elements, chain_lit_line):
                                    chain_container: ValueType = literal_container_type(chain_inner_object, local_scope, fns, structs, generics)
                                    if chain_container.kind == TypeKind.DArray:
                                        chain_row_type: ValueType = darray_element_of(chain_container, structs)
                                        if chain_row_type.kind == TypeKind.DArray:
                                            chain_element_type: ValueType = darray_element_of(chain_row_type, structs)
                                            if emit_expression(indexed_object, chain_row_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is chain_row_value:
                                                chain_slot: LLVMValueRef = LLVMBuildAlloca(builder, darray_llvm_type(structs, ctx), "darray.chain.index")
                                                _ = LLVMBuildStore(builder, chain_row_value, chain_slot)
                                                if emit_darray_index_address(chain_slot, chain_row_type, index_expression, local_scope, fns, structs, generics, runtime, m, ctx, builder) is chain_pointer:
                                                    return LLVMBuildLoad2(builder, llvm_type_of(chain_element_type, structs, ctx), chain_pointer, "darray.chain.elem")
                                            return null
                                _:
                                    pass
                        _:
                            pass
                    match indexed_object:
                        Expr.Array(idx_lit_elements, idx_lit_line):
                            # literal_container_type derives the shape RECURSIVELY, so a nested
                            # literal (`[[1, 2], [3, 4]][1]`) yields darray[darray[i64]] and its
                            # element is a darray rather than Unmodeled. The old inline derivation
                            # used expression_type, which answers Unmodeled for an inner literal, so
                            # any nesting declined here.
                            idx_lit_container: ValueType = literal_container_type(indexed_object, local_scope, fns, structs, generics)
                            null return if idx_lit_container.kind != TypeKind.DArray
                            idx_lit_elem_type: ValueType = darray_element_of(idx_lit_container, structs)
                            if emit_expression(indexed_object, idx_lit_container, local_scope, fns, structs, generics, runtime, m, ctx, builder) is idx_lit_value:
                                idx_lit_slot: LLVMValueRef = LLVMBuildAlloca(builder, darray_llvm_type(structs, ctx), "darray.literal.index")
                                _ = LLVMBuildStore(builder, idx_lit_value, idx_lit_slot)
                                if emit_darray_index_address(idx_lit_slot, idx_lit_container, index_expression, local_scope, fns, structs, generics, runtime, m, ctx, builder) is idx_lit_pointer:
                                    return LLVMBuildLoad2(builder, llvm_type_of(idx_lit_elem_type, structs, ctx), idx_lit_pointer, "darray.literal.elem")
                            return null
                        _:
                            pass
                    # `(p.cast[T&])[i]` READ — the value counterpart of the same shape in
                    # struct_chain_address. `.cast[T]` is Index(Field(x,"cast"), T), so the base
                    # is an Index and none of the branches here (Ident, array literal, index into
                    # an array literal) match it. Resolve the element address through the one
                    # lvalue chain resolver and load it, so the read and the write agree.
                    match indexed_object:
                        Expr.Index(cast_read_head, cast_read_arg, cast_read_line):
                            match cast_read_head:
                                Expr.Field(cast_read_source, cast_read_method, cast_read_method_line):
                                    if cast_read_method == "cast":
                                        cast_read_target: ValueType = annotation_value_type(cast_read_arg, structs)
                                        if cast_read_target.kind == TypeKind.Ref:
                                            cast_read_element: ValueType = ref_target_of(cast_read_target, structs)
                                            if cast_read_element.kind != TypeKind.Unmodeled:
                                                if struct_chain_address(expression, local_scope, fns, structs, generics, runtime, m, ctx, builder) is cast_read_pointer:
                                                    return LLVMBuildLoad2(builder, llvm_type_of(cast_read_element, structs, ctx), cast_read_pointer, "cast.index.elem")
                                                return null
                                _:
                                    pass
                        _:
                            pass
                    match indexed_object:
                        Expr.Ident(array_name, array_name_line):
                            array_type: ValueType = lookup_type(local_scope, array_name)
                            # A BORROWED darray (`darray[T]&`) indexes exactly like a local one once
                            # its header address is loaded out of the parameter slot.
                            borrowed_type: ValueType = darray_type_behind(local_scope, array_name, structs)
                            if borrowed_type.kind == TypeKind.DArray and array_type.kind == TypeKind.Ref:
                                if darray_address_of(local_scope, array_name, structs, ctx, builder) is borrowed_slot:
                                    if emit_darray_index_address(borrowed_slot, borrowed_type, index_expression, local_scope, fns, structs, generics, runtime, m, ctx, builder) is borrowed_pointer:
                                        borrowed_element: ValueType = darray_element_of(borrowed_type, structs)
                                        borrowed_value: LLVMValueRef = LLVMBuildLoad2(builder, llvm_type_of(borrowed_element, structs, ctx), borrowed_pointer, "darray.elem")
                                        tag_disjoint_darray_access(borrowed_value, borrowed_pointer, runtime, ctx)
                                        return borrowed_value
                                return null
                            if lookup_slot(local_scope, array_name) is array_slot:
                                # A darray indexes through its `items` pointer; a fixed array
                                # indexes the storage directly.
                                if array_type.kind == TypeKind.DArray:
                                    if emit_darray_index_address(array_slot, array_type, index_expression, local_scope, fns, structs, generics, runtime, m, ctx, builder) is darray_pointer:
                                        darray_element: ValueType = darray_element_of(array_type, structs)
                                        darray_value: LLVMValueRef = LLVMBuildLoad2(builder, llvm_type_of(darray_element, structs, ctx), darray_pointer, "darray.elem")
                                        tag_disjoint_darray_access(darray_value, darray_pointer, runtime, ctx)
                                        return darray_value
                                    return null
                                # `v[i]` where `v: view[T]`. The slot holds a DynArrayView VALUE —
                                # `{data: void&?, len: usize}` (elisacore_std/collections.elisa) — so
                                # the element address is a GEP of ELEMENT stride from field 0, the
                                # same shape a darray gets through `items`.
                                #
                                # There was NO View arm here at all, so `v[0]` declined the whole
                                # enclosing function. That is why even the ANNOTATED
                                # `ys: view[i64] = xs[1:3]; ys[0]` never worked, and why typing
                                # slices by their receiver could not have been enough on its own.
                                if array_type.kind == TypeKind.View:
                                    view_index_struct: ValueType = view_struct_type(array_type, structs)
                                    if view_index_struct.kind != TypeKind.Unmodeled:
                                        view_index_element: ValueType = view_element_of(array_type, structs)
                                        view_index_elem_llvm: LLVMTypeRef = llvm_type_of(view_index_element, structs, ctx)
                                        view_index_agg: LLVMValueRef = LLVMBuildLoad2(builder, llvm_type_of(view_index_struct, structs, ctx), array_slot, "view.agg")
                                        view_index_data: LLVMValueRef = LLVMBuildExtractValue(builder, view_index_agg, 0, "view.data")
                                        if emit_expression(index_expression, ValueType{kind: TypeKind.Signed, bits: 64}, local_scope, fns, structs, generics, runtime, m, ctx, builder) is view_index_value:
                                            view_index_indices: mutable darray[LLVMValueRef] = [view_index_value]
                                            view_index_indices_pointer: void& = (&view_index_indices[0]).cast[void&] can Unsafe.PointerCast
                                            view_index_address: LLVMValueRef = LLVMBuildGEP2(builder, view_index_elem_llvm, view_index_data, view_index_indices_pointer, 1, "view.elem.addr")
                                            view_index_loaded: LLVMValueRef = LLVMBuildLoad2(builder, view_index_elem_llvm, view_index_address, "view.elem")
                                            # Convert to the surrounding context's type, exactly as the
                                            # scalar-ref read below does. Returning the element at its
                                            # NATURAL width emitted `add i64 %a, i8 %b` for
                                            # `ys[1] + zs[1].i64()` (a view[i64] and a view[u8] in one
                                            # function) — LLVM accepted the module and died in ISel with
                                            # "Do not know how to promote this operator's operand".
                                            # Each view read is fine alone; only the MIXED-width pair
                                            # exposes it.
                                            return emit_conversion(view_index_loaded, view_index_element, expected, structs, ctx, builder) if expected.kind != TypeKind.Unmodeled and (expected.kind != view_index_element.kind or expected.bits != view_index_element.bits) else view_index_loaded
                                        return null
                                    return null
                                # `a[i]` where `a: T[N]&` — a REF to a fixed array. The slot holds the
                                # array's ADDRESS; load it and GEP in like a local array.
                                if array_type.kind == TypeKind.Ref and ref_target_of(array_type, structs).kind == TypeKind.Array:
                                    ref_read_array_type: ValueType = ref_target_of(array_type, structs)
                                    ref_read_base: LLVMValueRef = LLVMBuildLoad2(builder, LLVMPointerTypeInContext(ctx, 0), array_slot, "arr.ref.base")
                                    if emit_index_address(ref_read_base, ref_read_array_type, index_expression, local_scope, fns, structs, generics, runtime, m, ctx, builder) is ref_read_pointer:
                                        ref_read_element: ValueType = array_element_of(ref_read_array_type, structs)
                                        ref_read_loaded: LLVMValueRef = LLVMBuildLoad2(builder, llvm_type_of(ref_read_element, structs, ctx), ref_read_pointer, "arr.ref.elem")
                                        # Convert to the surrounding context's type, exactly as the
                                        # scalar-ref/opt-ref/view reads below and above do. Returning the
                                        # element at its NATURAL width left `ys[1] + zs[1].i64()` (an
                                        # i64[3]& and a u8[3]& in one function) building a WIDTH-MISMATCHED
                                        # `sadd.with.overflow.i64(i64, i8)` call — LLVM accepted the
                                        # module and silently answered 200 where stage0 answers 202. Each
                                        # width read alone was fine; only the mixed-width pair exposed it.
                                        return emit_conversion(ref_read_loaded, ref_read_element, expected, structs, ctx, builder) if expected.kind != TypeKind.Unmodeled and (expected.kind != ref_read_element.kind or expected.bits != ref_read_element.bits) else ref_read_loaded
                                    return null
                                # `p[i]` where `p: T&` is a ref to a NUMERIC scalar — a C-style pointer
                                # base. Slice[T] reads its backing this way (`p: T& = s.base.cast[T&];
                                # p[i]`). Scoped to numeric elements: a ref-to-struct (dict's
                                # `items[i]` on a `DictBucket&`) is handled by the chain fallback below, and
                                # a ref-to-array by the branch above. The loaded value is converted to the
                                # surrounding context's expected type so it composes like any scalar read.
                                if array_type.kind == TypeKind.Ref:
                                    scalar_ref_elem: ValueType = ref_target_of(array_type, structs)
                                    # A POINTER-sized element indexes the same way: `argv[i]` where
                                    # `argv: cstr&&` is a C `char**`, the shape argv actually has.
                                    # stage0 lowers it identically — `getelementptr ptr, ptr %base,
                                    # i64 %i` then `load ptr` — so this is the same GEP+load with the
                                    # element's own LLVM type, which is already `ptr` for a ref/cstr.
                                    # Without it every `T&&` index DECLINED, which is what stopped the
                                    # driver from reading argv at all.
                                    scalar_ref_elem_is_pointer: bool = scalar_ref_elem.kind == TypeKind.Ref or scalar_ref_elem.kind == TypeKind.CStr
                                    if scalar_ref_elem.kind == TypeKind.Signed or scalar_ref_elem.kind == TypeKind.Unsigned or scalar_ref_elem.kind == TypeKind.Float or scalar_ref_elem_is_pointer:
                                        scalar_ref_base: LLVMValueRef = LLVMBuildLoad2(builder, LLVMPointerTypeInContext(ctx, 0), array_slot, "scalar.ref.base")
                                        if emit_expression(index_expression, ValueType{kind: TypeKind.Unsigned, bits: 64}, local_scope, fns, structs, generics, runtime, m, ctx, builder) is scalar_ref_index:
                                            scalar_ref_elem_llvm: LLVMTypeRef = llvm_type_of(scalar_ref_elem, structs, ctx)
                                            scalar_ref_gep_indices: mutable darray[LLVMValueRef] = [scalar_ref_index]
                                            scalar_ref_gep_pointer: void& = (&scalar_ref_gep_indices[0]).cast[void&] can Unsafe.PointerCast
                                            scalar_ref_elem_ptr: LLVMValueRef = LLVMBuildGEP2(builder, scalar_ref_elem_llvm, scalar_ref_base, scalar_ref_gep_pointer, 1, "scalar.ref.elem.ptr")
                                            scalar_ref_value: LLVMValueRef = LLVMBuildLoad2(builder, scalar_ref_elem_llvm, scalar_ref_elem_ptr, "scalar.ref.elem")
                                            # A pointer element is already the value the context wants
                                            # (ref/cstr are all `ptr`); running it through the numeric
                                            # conversion would be a category error.
                                            scalar_ref_value return if scalar_ref_elem_is_pointer
                                            return emit_conversion(scalar_ref_value, scalar_ref_elem, expected, structs, ctx, builder) if expected.kind != TypeKind.Unmodeled and (expected.kind != scalar_ref_elem.kind or expected.bits != scalar_ref_elem.bits) else scalar_ref_value
                                        return null
                                # `found[0]` where `found: T&?` is an OPTIONAL ref to a numeric scalar
                                # (`{i1, ptr}`), narrowed non-null by an earlier `null return if found ==
                                # null`. Extract the payload ptr (field 1) and index it like a scalar ref.
                                # index_map_find_index reads the dict's `usize&?` result this way.
                                if array_type.kind == TypeKind.Optional:
                                    opt_ref_payload: ValueType = optional_payload_of(array_type, structs)
                                    if opt_ref_payload.kind == TypeKind.Ref:
                                        opt_ref_elem: ValueType = ref_target_of(opt_ref_payload, structs)
                                        # A nullable pointer-to-pointer (`T&&?`) is a niche
                                        # optional whose payload is itself a raw pointer. The
                                        # outer index therefore reads a pointer-sized element,
                                        # just like `argv[i]` on `cstr&&`; it must not be forced
                                        # through the tagged-optional scalar path.
                                        opt_ref_elem_is_pointer: bool = opt_ref_elem.kind == TypeKind.Ref or opt_ref_elem.kind == TypeKind.CStr or opt_ref_elem.kind == TypeKind.Fn
                                        if opt_ref_elem.kind == TypeKind.Signed or opt_ref_elem.kind == TypeKind.Unsigned or opt_ref_elem.kind == TypeKind.Float or opt_ref_elem_is_pointer:
                                            opt_ref_aggregate: LLVMValueRef = LLVMBuildLoad2(builder, llvm_type_of(array_type, structs, ctx), array_slot, "opt.ref.aggr")
                                            opt_ref_base: LLVMValueRef = optional_payload_value_of(opt_ref_aggregate, array_type, structs, ctx, builder)
                                            if emit_expression(index_expression, ValueType{kind: TypeKind.Unsigned, bits: 64}, local_scope, fns, structs, generics, runtime, m, ctx, builder) is opt_ref_index:
                                                opt_ref_elem_llvm: LLVMTypeRef = llvm_type_of(opt_ref_elem, structs, ctx)
                                                opt_ref_gep_indices: mutable darray[LLVMValueRef] = [opt_ref_index]
                                                opt_ref_gep_pointer: void& = (&opt_ref_gep_indices[0]).cast[void&] can Unsafe.PointerCast
                                                opt_ref_elem_ptr: LLVMValueRef = LLVMBuildGEP2(builder, opt_ref_elem_llvm, opt_ref_base, opt_ref_gep_pointer, 1, "opt.ref.elem.ptr")
                                                opt_ref_value: LLVMValueRef = LLVMBuildLoad2(builder, opt_ref_elem_llvm, opt_ref_elem_ptr, "opt.ref.elem")
                                                return emit_conversion(opt_ref_value, opt_ref_elem, expected, structs, ctx, builder) if expected.kind != TypeKind.Unmodeled and (expected.kind != opt_ref_elem.kind or expected.bits != opt_ref_elem.bits) else opt_ref_value
                                            return null
                                if array_type.kind == TypeKind.Array:
                                    if emit_index_address(array_slot, array_type, index_expression, local_scope, fns, structs, generics, runtime, m, ctx, builder) is pointer:
                                        element_type: ValueType = array_element_of(array_type, structs)
                                        array_element_value: LLVMValueRef = LLVMBuildLoad2(builder, llvm_type_of(element_type, structs, ctx), pointer, "elem")
                                        # Widen/narrow to the EXPECTED type, exactly as the optional-ref
                                        # read above does. Without it `text[1]` on a `u8[4]` returned an
                                        # i8 where the context wanted i64 (`-> char`, or plain `-> i64`),
                                        # and the return path's type-identity guard declined the whole
                                        # function -- while the same expression with an explicit `.i64()`
                                        # compiled fine.
                                        return emit_conversion(array_element_value, element_type, expected, structs, ctx, builder) if expected.kind != TypeKind.Unmodeled and (expected.kind != element_type.kind or expected.bits != element_type.bits) else array_element_value
                            # `xs[i]` where `xs` is a global const ARRAY. The address emitter already
                            # supports this shape for assignments and address-of expressions; mirror
                            # that path here for reads. Without it, a global fixed array (including the
                            # database's `u8&?[N]` string tables) made the whole enclosing function
                            # decline even though stage0 emits a normal global GEP and load.
                            const_read_index: i64 = const_index_of(structs, array_name)
                            if const_read_index >= 0 and structs.const_global_ok[const_read_index.usize()]:
                                const_read_array_type: ValueType = copied_type(structs.const_types[const_read_index.usize()])
                                if const_read_array_type.kind == TypeKind.Array:
                                    if emit_index_address(structs.const_globals[const_read_index.usize()], const_read_array_type, index_expression, local_scope, fns, structs, generics, runtime, m, ctx, builder) is const_read_pointer:
                                        const_read_element_type: ValueType = array_element_of(const_read_array_type, structs)
                                        const_read_value: LLVMValueRef = LLVMBuildLoad2(builder, llvm_type_of(const_read_element_type, structs, ctx), const_read_pointer, "const.elem")
                                        return emit_conversion(const_read_value, const_read_element_type, expected, structs, ctx, builder) if expected.kind != TypeKind.Unmodeled and (expected.kind != const_read_element_type.kind or expected.bits != const_read_element_type.bits) else const_read_value
                                return null
                            # `xs[i]` where `xs` is a mutable global ARRAY. Mutable globals
                            # are loaded by name in the identifier path, but indexing must use
                            # their address directly; loading the whole aggregate first would
                            # lose the lvalue needed for a GEP and made ordinary C tables such
                            # as `grstarts[idx]` decline in otherwise valid functions.
                            mutable_read_index: i64 = mutable_global_index_of(structs, array_name)
                            if mutable_read_index >= 0:
                                mutable_read_array_type: ValueType = copied_type(structs.mutable_global_types[mutable_read_index.usize()])
                                if mutable_read_array_type.kind == TypeKind.Array:
                                    if emit_index_address(structs.mutable_global_handles[mutable_read_index.usize()], mutable_read_array_type, index_expression, local_scope, fns, structs, generics, runtime, m, ctx, builder) is mutable_read_pointer:
                                        mutable_read_element_type: ValueType = array_element_of(mutable_read_array_type, structs)
                                        mutable_read_value: LLVMValueRef = LLVMBuildLoad2(builder, llvm_type_of(mutable_read_element_type, structs, ctx), mutable_read_pointer, "global.elem")
                                        return emit_conversion(mutable_read_value, mutable_read_element_type, expected, structs, ctx, builder) if expected.kind != TypeKind.Unmodeled and (expected.kind != mutable_read_element_type.kind or expected.bits != mutable_read_element_type.bits) else mutable_read_value
                                return null
                            # `xs[i]` where `xs` is an external fixed ARRAY. External globals are
                            # declaration-only in this translation unit, but their LLVM handles still
                            # point at the correctly typed storage. Use the same address-and-load path
                            # as mutable project globals so cross-module C tables remain ordinary lvalues.
                            extern_read_index: i64 = extern_global_index_of(structs, array_name)
                            if extern_read_index >= 0:
                                extern_read_array_type: ValueType = copied_type(structs.extern_global_types[extern_read_index.usize()])
                                if extern_read_array_type.kind == TypeKind.Array:
                                    if emit_index_address(structs.extern_global_handles[extern_read_index.usize()], extern_read_array_type, index_expression, local_scope, fns, structs, generics, runtime, m, ctx, builder) is extern_read_pointer:
                                        extern_read_element_type: ValueType = array_element_of(extern_read_array_type, structs)
                                        extern_read_value: LLVMValueRef = LLVMBuildLoad2(builder, llvm_type_of(extern_read_element_type, structs, ctx), extern_read_pointer, "extern.elem")
                                        return emit_conversion(extern_read_value, extern_read_element_type, expected, structs, ctx, builder) if expected.kind != TypeKind.Unmodeled and (expected.kind != extern_read_element_type.kind or expected.bits != extern_read_element_type.bits) else extern_read_value
                                return null
                        _:
                            pass
                    # `make_array()[1]` — indexing a RETURNED darray. `darray_type_behind_expr`
                    # cannot see it: that helper has no FnTable, so a call's return type is out of
                    # reach there and every such index declined. Typed here, where it is in hand,
                    # and the address comes from the same helper's call-spill branch.
                    # An RVALUE receiver: a CALL result, or a SLICE (`make_array()[1:3][0]`).
                    # Neither has an address, so every address-based shape above misses it.
                    index_object_is_rvalue: mutable bool = false
                    match indexed_object:
                        Expr.Call(ret_callee, ret_call_args, ret_call_names, ret_call_line):
                            index_object_is_rvalue <- true
                        _:
                            pass
                    match indexed_object:
                        Expr.Slice(ret_slice_object, ret_slice_start, ret_slice_end, ret_slice_line):
                            index_object_is_rvalue <- true
                        _:
                            pass
                    # A VIEW held in a struct FIELD (`state.tokens[0]`). The address-based view path
                    # only ever resolved a local, so a view field declined. Read as a value and
                    # indexed off its data pointer, which is what the returned-view case does — and
                    # gated on View so a darray field keeps its own (address) path.
                    match indexed_object:
                        Expr.Field(ret_field_object, ret_field_name, ret_field_line):
                            index_object_is_rvalue <- true if expression_type(indexed_object, local_scope, fns, structs, generics).kind == TypeKind.View
                        _:
                            pass
                    if index_object_is_rvalue:
                        ret_darray_type: ValueType = expression_type(indexed_object, local_scope, fns, structs, generics)
                        # A returned VIEW is the same story: spill the `{ptr, i64}` pair and index
                        # off its data pointer.
                        if ret_darray_type.kind == TypeKind.View:
                            ret_view_struct: ValueType = view_struct_type(ret_darray_type, structs)
                            if ret_view_struct.kind != TypeKind.Unmodeled:
                                ret_view_element: ValueType = view_element_of(ret_darray_type, structs)
                                ret_view_elem_llvm: LLVMTypeRef = llvm_type_of(ret_view_element, structs, ctx)
                                if emit_expression(indexed_object, ret_darray_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is ret_view_value:
                                    ret_view_data: LLVMValueRef = LLVMBuildExtractValue(builder, ret_view_value, 0, "view.data")
                                    if emit_expression(index_expression, ValueType{kind: TypeKind.Signed, bits: 64}, local_scope, fns, structs, generics, runtime, m, ctx, builder) is ret_view_index:
                                        ret_view_indices: mutable darray[LLVMValueRef] = [ret_view_index]
                                        ret_view_pointer: void& = (&ret_view_indices[0]).cast[void&] can Unsafe.PointerCast
                                        ret_view_address: LLVMValueRef = LLVMBuildGEP2(builder, ret_view_elem_llvm, ret_view_data, ret_view_pointer, 1, "view.elem.addr")
                                        ret_view_loaded: LLVMValueRef = LLVMBuildLoad2(builder, ret_view_elem_llvm, ret_view_address, "view.elem")
                                        return emit_conversion(ret_view_loaded, ret_view_element, expected, structs, ctx, builder) if expected.kind != TypeKind.Unmodeled and (expected.kind != ret_view_element.kind or expected.bits != ret_view_element.bits) else ret_view_loaded
                            return null
                        if ret_darray_type.kind == TypeKind.DArray:
                            if darray_address_of_expr(indexed_object, local_scope, fns, structs, generics, runtime, m, ctx, builder) is ret_darray_slot:
                                if emit_darray_index_address(ret_darray_slot, ret_darray_type, index_expression, local_scope, fns, structs, generics, runtime, m, ctx, builder) is ret_darray_pointer:
                                    ret_darray_element: ValueType = darray_element_of(ret_darray_type, structs)
                                    ret_darray_value: LLVMValueRef = LLVMBuildLoad2(builder, llvm_type_of(ret_darray_element, structs, ctx), ret_darray_pointer, "darray.elem")
                                    return emit_conversion(ret_darray_value, ret_darray_element, expected, structs, ctx, builder) if expected.kind != TypeKind.Unmodeled and (expected.kind != ret_darray_element.kind or expected.bits != ret_darray_element.bits) else ret_darray_value
                            return null
                    # Index a reference-valued rvalue (`nonnull(ptr)[i]`). The
                    # call result is already the element-base pointer and has no
                    # local slot for struct_chain_address to discover.
                    rvalue_ref_type: ValueType = expression_type(indexed_object, local_scope, fns, structs, generics)
                    if rvalue_ref_type.kind == TypeKind.Ref:
                        rvalue_ref_element: ValueType = ref_target_of(rvalue_ref_type, structs)
                        if rvalue_ref_element.kind != TypeKind.Unmodeled:
                            if emit_expression(indexed_object, rvalue_ref_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is rvalue_ref_base:
                                if emit_expression(index_expression, ValueType{kind: TypeKind.Signed, bits: 64}, local_scope, fns, structs, generics, runtime, m, ctx, builder) is rvalue_ref_index:
                                    rvalue_ref_indices: mutable darray[LLVMValueRef] = [rvalue_ref_index]
                                    rvalue_ref_indices_pointer: void& = (&rvalue_ref_indices[0]).cast[void&] can Unsafe.PointerCast
                                    rvalue_ref_address: LLVMValueRef = LLVMBuildGEP2(builder, llvm_type_of(rvalue_ref_element, structs, ctx), rvalue_ref_base, rvalue_ref_indices_pointer, 1, "rvalue.ref.elem.ptr")
                                    rvalue_ref_value: LLVMValueRef = LLVMBuildLoad2(builder, llvm_type_of(rvalue_ref_element, structs, ctx), rvalue_ref_address, "rvalue.ref.elem")
                                    return emit_conversion(rvalue_ref_value, rvalue_ref_element, expected, structs, ctx, builder) if expected.kind != TypeKind.Unmodeled and (expected.kind != rvalue_ref_element.kind or expected.bits != rvalue_ref_element.bits) else rvalue_ref_value
                            return null
                    # A darray reached through a struct FIELD (`b.items[i]`): resolve the header
                    # address via the _expr helper, then index like any darray.
                    field_darray_type: mutable ValueType = darray_type_behind_expr(indexed_object, local_scope, structs)
                    # The lightweight chain probe cannot see through a call result. The full
                    # expression typer can resolve `make_file().errors` and keeps this READ
                    # path aligned with darray_address_of_expr, which already has the call spill.
                    field_darray_type <- expression_type(indexed_object, local_scope, fns, structs, generics) if field_darray_type.kind != TypeKind.DArray
                    if field_darray_type.kind == TypeKind.DArray:
                        if darray_address_of_expr(indexed_object, local_scope, fns, structs, generics, runtime, m, ctx, builder) is field_darray_slot:
                            if emit_darray_index_address(field_darray_slot, field_darray_type, index_expression, local_scope, fns, structs, generics, runtime, m, ctx, builder) is field_darray_pointer:
                                field_darray_element: ValueType = darray_element_of(field_darray_type, structs)
                                field_darray_value: LLVMValueRef = LLVMBuildLoad2(builder, llvm_type_of(field_darray_element, structs, ctx), field_darray_pointer, "darray.elem")
                                tag_disjoint_darray_access(field_darray_value, field_darray_pointer, runtime, ctx)
                                return field_darray_value
                        return null
                    # Any other receiver chain (`m[i][j]`, `s.grid[i]`): the chain resolver
                    # yields the ELEMENT's type and address; load through it.
                    chain_element_type: ValueType = struct_chain_type(expression, local_scope, structs)
                    if chain_element_type.kind == TypeKind.Unmodeled:
                        return null
                    if struct_chain_address(expression, local_scope, fns, structs, generics, runtime, m, ctx, builder) is chain_element_address:
                        return LLVMBuildLoad2(builder, llvm_type_of(chain_element_type, structs, ctx), chain_element_address, "elem")
                    return null

                _:
                    pass
            # `Point{x: 40, y: 2}` — build the value in a temporary slot, store each
            # field, then load the whole struct back. mem2reg/SROA turn this into plain
            # registers at -O2, so the temporary costs nothing in the output.
            #
            # Fields may be given by NAME or position (empty name). Start from a zero aggregate so omitted fields have
            # the same deterministic default as stage0's aggregate construction.
            # `base{field = v, ...}` — a RECORD UPDATE: the base value with the named fields
            # overridden, everything else copied. `grep RecordUpdate src/backend` found
            # nothing, so the form was unimplemented in codegen and every use declined.
            #
            # stage0 lowers it as `insertvalue` per overridden field (read from its -emit
            # llvm); this stores the base into a temporary and overwrites those fields
            # through StructGEP, the same shape the Construct branch below uses, which is
            # equivalent and keeps the two paths consistent.
            #
            # The struct comes from the BASE's type, not an annotation -- a record update has
            # no type name of its own to resolve. A field name that is not a member (or a
            # POSITIONAL field, which this form has no meaning for) yields -1 and declines
            # rather than writing to a guessed offset.
            return emit_expression_record_and_construct(expression, expected, local_scope, fns, structs, generics, runtime, m, ctx, builder, handled)
