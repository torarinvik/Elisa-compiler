# Stage1 backend — a value `match` whose scrutinee is an OPTIONAL. Arms are tried in
# source order: `null` tests absence, a binder tests presence and binds the payload,
# `_` always matches; each may carry a guard, and a failed guard falls through to the
# next arm. The scrutinee is evaluated once. Part of `module Backend` (see codegen.elisa).

extend Backend:
    private:
        def emit_optional_value_match(scrutinee_expression: Expr, arms: darray[MatchArm]&, scrutinee_type: ValueType, expected: ValueType, match_type: LLVMTypeRef, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            payload_type: ValueType = optional_payload_of(scrutinee_type, structs)
            null return if payload_type.kind == TypeKind.Unmodeled
            if emit_expression(scrutinee_expression, scrutinee_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is optional_value:
                present: LLVMValueRef = optional_tag_of(optional_value, scrutinee_type, structs, ctx, builder)
                function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                result_slot: LLVMValueRef = build_entry_alloca(builder, match_type, "match.result")
                done_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "match.done")
                saw_default: mutable bool = false
                for arm in arms |saw_default, present, optional_value, payload_type, scrutinee_type, expected, result_slot, done_block, function, local_scope, fns, structs, generics, runtime, m, ctx, builder|:
                    break if saw_default
                    arm_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "match.arm")
                    next_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "match.next")
                    bind_name: mutable sview = ""
                    match arm.pattern:
                        Pattern.Literal(literal_text):
                            null return if literal_text != "null"
                            _ = LLVMBuildCondBr(builder, present, next_block, arm_block)
                        Pattern.Binding(pattern_name):
                            bind_name <- pattern_name
                            _ = LLVMBuildCondBr(builder, present, arm_block, next_block)
                        Pattern.Wildcard:
                            _ = LLVMBuildBr(builder, arm_block)
                            saw_default <- not arm_has_guard(arm.guard)
                        _:
                            return null
                    LLVMPositionBuilderAtEnd(builder, arm_block)
                    scope_before: usize = scope_mark(local_scope)
                    if bind_name != "":
                        payload: LLVMValueRef = optional_payload_value_of(optional_value, scrutinee_type, structs, ctx, builder)
                        name_storage: mutable darray[u8] = []
                        bind_slot: LLVMValueRef = build_entry_alloca(builder, llvm_type_of(payload_type, structs, ctx), sview_to_cstr(bind_name, name_storage))
                        _ = LLVMBuildStore(builder, payload, bind_slot)
                        declare_local(local_scope, bind_name, bind_slot, payload_type)
                    if arm_has_guard(arm.guard):
                        if emit_condition(arm.guard, local_scope, fns, structs, generics, runtime, m, ctx, builder) is guard_bit:
                            guarded_body: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "match.guard")
                            _ = LLVMBuildCondBr(builder, guard_bit, guarded_body, next_block)
                            LLVMPositionBuilderAtEnd(builder, guarded_body)
                        else:
                            return null
                    if arm_value_expression(arm.body) is arm_expression:
                        # A bare `null` arm is the empty optional: the all-zero value in
                        # either representation (a null pointer, or `{false, undef}`).
                        if expected.kind == TypeKind.Optional and is_null_literal(arm_expression):
                            _ = LLVMBuildStore(builder, LLVMConstNull(match_type), result_slot)
                            _ = LLVMBuildBr(builder, done_block)
                        elif emit_expression(arm_expression, expected, local_scope, fns, structs, generics, runtime, m, ctx, builder) is arm_value:
                            _ = LLVMBuildStore(builder, arm_value, result_slot)
                            _ = LLVMBuildBr(builder, done_block)
                        else:
                            return null
                    else:
                        return null
                    scope_restore(local_scope, scope_before)
                    LLVMPositionBuilderAtEnd(builder, next_block)
                # The trailing next-block is dead either way: after an unconditional `_`
                # nothing reaches it, and without one the frontend's coverage proof says
                # no value falls through. Do not invent a default value.
                _ = LLVMBuildUnreachable(builder)
                LLVMPositionBuilderAtEnd(builder, done_block)
                return LLVMBuildLoad2(builder, match_type, result_slot, "match")
            return null

        # The value-match emitter models `null`, a plain binder, and `_` (each optionally
        # guarded). Other payload patterns still route through the statement matcher.
        def optional_value_match_supported(arms: darray[MatchArm]&) -> bool can[Abort.Panic]:
            for arm in arms:
                match arm.pattern:
                    Pattern.Literal(literal_text):
                        return false if literal_text != "null"
                    Pattern.Binding(_):
                        pass
                    Pattern.Wildcard:
                        pass
                    _:
                        return false
            return true
