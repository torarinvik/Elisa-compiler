# Stage1 backend — registering struct types: names, bodies, alignment, and generic struct instantiation.
# Part of `module Backend` (see codegen.elisa); split out to keep each file short.

extend Backend:
    private:


        # The TWO-argument form. A `dict[K, V]` has to record both, or inference over a
        # `dict[cstr, V]&` parameter has nothing to unify V against — the annotation path in
        # unify_annotation already knows how to walk a two-argument instantiation, it just
        # needs the arguments to be there.
        def record_synthesized_instantiation2(base: sview, first_type: ValueType, second_type: ValueType, struct_type: ValueType, structs: mutable StructTable&) -> void can[Abort.Panic, Memory.Allocate]:
            start: usize = structs.generic_struct_inst_args.count
            structs.generic_struct_inst_args <- structs.generic_struct_inst_args.push(copied_type(first_type))
            structs.generic_struct_inst_args <- structs.generic_struct_inst_args.push(copied_type(second_type))
            structs.generic_struct_inst_bases <- structs.generic_struct_inst_bases.push(base)
            structs.generic_struct_inst_arg_start <- structs.generic_struct_inst_arg_start.push(start)
            structs.generic_struct_inst_arg_count <- structs.generic_struct_inst_arg_count.push(2.usize())
            structs.generic_struct_inst_index <- structs.generic_struct_inst_index.push(struct_type.bits.usize())
            structs.generic_struct_inst_ready <- structs.generic_struct_inst_ready.push(true)




        # An already-synthesized (base, [a, b]) instantiation, or -1.
        def synthesized_instantiation2_index_of(base: sview, first_type: ValueType, second_type: ValueType, structs: mutable StructTable&) -> i64 can[Abort.Panic]:
            for inst in 0..<structs.generic_struct_inst_bases.count |structs, base, first_type, second_type|:
                continue if structs.generic_struct_inst_bases[inst] != base
                continue if structs.generic_struct_inst_arg_count[inst] != 2.usize()
                start: usize = structs.generic_struct_inst_arg_start[inst]
                stored_first: ValueType = structs.generic_struct_inst_args[start]
                stored_second: ValueType = structs.generic_struct_inst_args[start + 1.usize()]
                continue if not value_type_identity_equal(stored_first, first_type)
                continue if not value_type_identity_equal(stored_second, second_type)
                return structs.generic_struct_inst_index[inst].i64()
            return -1




        def record_synthesized_instantiation(base: sview, element_type: ValueType, struct_type: ValueType, structs: mutable StructTable&) -> void can[Abort.Panic, Memory.Allocate]:
            structs.generic_struct_inst_args <- structs.generic_struct_inst_args.push(copied_type(element_type))
            structs.generic_struct_inst_bases <- structs.generic_struct_inst_bases.push(base)
            structs.generic_struct_inst_arg_start <- structs.generic_struct_inst_arg_start.push(structs.generic_struct_inst_args.count - 1.usize())
            structs.generic_struct_inst_arg_count <- structs.generic_struct_inst_arg_count.push(1.usize())
            structs.generic_struct_inst_index <- structs.generic_struct_inst_index.push(struct_type.bits.usize())
            structs.generic_struct_inst_ready <- structs.generic_struct_inst_ready.push(true)




        # `Mutex` / `ThreadPool` — BUILT-IN handle types stage0 knows and no unit declares.
        # Both are a single opaque pointer in stage0's IR (`%Mutex = type { ptr }`,
        # `%ThreadPool = type { ptr }`). Without them even a bare parameter of the type
        # declined, with no lock primitive in the file at all — which is what localised the
        # `lock` gap to the TYPES rather than to the block lowering.
        # `dict[K, V]` when the unit does NOT declare `struct DynDict[K, V]`. stage0 has the
        # container built in; stage1 resolved the annotation only through a declared generic
        # struct, so a standalone file taking a `dict[cstr, i32]&` parameter declined outright
        # while stage0 emits `define i1 @size(ptr %0)`. Same class as the implicit
        # `pool_shutdown`: the reference compiler supplies it, so this one must too.
        #
        # The layout is MEASURED off stage0, not invented:
        #   %DynDict__cstr__u8 = type { ptr, i64, i64, i64, ptr }
        #   @NUMBERS = { ptr @buckets, i64 3, i64 3, i64 8, ptr null }   -- 3 entries, 8 buckets
        # and its `.count` read is `getelementptr (%DynDict, ptr @NUMBERS, i32 0, i32 1)`, so
        # field 1 is the entry count. The remaining i64 pair and the trailing pointer are only
        # ever passed through here, so they are named for their measured VALUES rather than for
        # roles this compiler has not verified.
        def synthesize_dyn_dict(key_type: ValueType, value_type: ValueType, structs: mutable StructTable&) -> ValueType can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            marker: ValueType = ValueType{kind: TypeKind.Void, bits: 0}
            # Memoised per (K, V), not globally. The LAYOUT is identical for every
            # instantiation — stage0's `%DynDict__cstr__u8` and `%DynDict__cstr__i32` are the
            # same five fields — but the IDENTITY has to differ, or the recorded type
            # arguments cannot be recovered and a generic `dict[cstr, V]&` parameter never
            # binds V.
            memoized: i64 = synthesized_instantiation2_index_of("DynDict", key_type, value_type, structs)
            ValueType{kind: TypeKind.Struct, bits: memoized.u32()} return if memoized >= 0
            dict_pointer: ValueType = intern_optional_type(intern_ref_type(marker, structs), structs)
            unmodeled_type() return if dict_pointer.kind == TypeKind.Unmodeled
            dict_word: ValueType = ValueType{kind: TypeKind.Signed, bits: 64}
            dict_names: mutable darray[sview] = ["buckets", "count", "live", "capacity", "owner"]
            dict_types: mutable darray[ValueType] = [dict_pointer, dict_word, dict_word, dict_word, dict_pointer]
            dict_struct: ValueType = register_synthesized_struct("DynDict", value_type, dict_names, dict_types, structs)
            unmodeled_type() return if dict_struct.kind != TypeKind.Struct
            record_synthesized_instantiation2("DynDict", key_type, value_type, dict_struct, structs)
            return dict_struct




        def synthesize_opaque_handle_struct(name: sview, structs: mutable StructTable&) -> ValueType can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            marker: ValueType = ValueType{kind: TypeKind.Void, bits: 0}
            memoized: i64 = synthesized_struct_index_of(name, marker, structs)
            ValueType{kind: TypeKind.Struct, bits: memoized.u32()} return if memoized >= 0
            handle_type: ValueType = intern_optional_type(intern_ref_type(marker, structs), structs)
            unmodeled_type() return if handle_type.kind == TypeKind.Unmodeled
            handle_names: mutable darray[sview] = ["handle"]
            handle_types: mutable darray[ValueType] = [handle_type]
            handle_struct: ValueType = register_synthesized_struct(name, marker, handle_names, handle_types, structs)
            unmodeled_type() return if handle_struct.kind != TypeKind.Struct
            record_synthesized_instantiation(name, marker, handle_struct, structs)
            return handle_struct




        # `Task[R, S]` — a submitted task handle. MEASURED across three instantiations
        # (`Task[i64,…]`, `Task[u8,…]`, `Task[bool,…]`): stage0 emits `{ i64, ptr }` for ALL of
        # them, so field 0 is an i64 task id, NOT the result type. Guessing "field 0 is R"
        # would have given `{i8, ptr}` for `Task[u8, …]` and a silently wrong ABI — both type
        # arguments are phantom as far as layout goes, so the memo keys on neither.
        def synthesize_task_handle(structs: mutable StructTable&) -> ValueType can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            marker: ValueType = ValueType{kind: TypeKind.Void, bits: 0}
            memoized: i64 = synthesized_struct_index_of("Task", marker, structs)
            ValueType{kind: TypeKind.Struct, bits: memoized.u32()} return if memoized >= 0
            payload_type: ValueType = intern_optional_type(intern_ref_type(marker, structs), structs)
            unmodeled_type() return if payload_type.kind == TypeKind.Unmodeled
            task_names: mutable darray[sview] = ["id", "payload"]
            task_types: mutable darray[ValueType] = [ValueType{kind: TypeKind.Signed, bits: 64}, payload_type]
            task_struct: ValueType = register_synthesized_struct("Task", marker, task_names, task_types, structs)
            unmodeled_type() return if task_struct.kind != TypeKind.Struct
            record_synthesized_instantiation("Task", marker, task_struct, structs)
            return task_struct




        # `TaskGroup` — the nursery handle, `%TaskGroup = type { ptr, ptr }` in stage0's IR.
        # Only used when the unit does NOT declare its own: the std declares a real
        # `struct TaskGroup` with different fields, and resolving this one ahead of it
        # SHADOWED the std's — which broke every std function touching it and took 15
        # unrelated dict/set/darray/sview programs down with it.
        def synthesize_task_group(structs: mutable StructTable&) -> ValueType can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            marker: ValueType = ValueType{kind: TypeKind.Void, bits: 0}
            memoized: i64 = synthesized_struct_index_of("TaskGroup", marker, structs)
            ValueType{kind: TypeKind.Struct, bits: memoized.u32()} return if memoized >= 0
            slot_type: ValueType = intern_optional_type(intern_ref_type(marker, structs), structs)
            unmodeled_type() return if slot_type.kind == TypeKind.Unmodeled
            group_names: mutable darray[sview] = ["head", "tail"]
            group_types: mutable darray[ValueType] = [slot_type, copied_type(slot_type)]
            group_struct: ValueType = register_synthesized_struct("TaskGroup", marker, group_names, group_types, structs)
            unmodeled_type() return if group_struct.kind != TypeKind.Struct
            record_synthesized_instantiation("TaskGroup", marker, group_struct, structs)
            return group_struct




        # `MutexGuard[S]` — the guard a lock primitive returns; `%MutexGuard__Held = { ptr }`.
        # `S` is a PHANTOM state token (`Held`), never a representation, so it only keys the
        # memo and the field set is the same single handle.
        def synthesize_mutex_guard(state_type: ValueType, structs: mutable StructTable&) -> ValueType can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            memoized: i64 = synthesized_struct_index_of("MutexGuard", state_type, structs)
            ValueType{kind: TypeKind.Struct, bits: memoized.u32()} return if memoized >= 0
            guard_handle: ValueType = intern_optional_type(intern_ref_type(ValueType{kind: TypeKind.Void, bits: 0}, structs), structs)
            unmodeled_type() return if guard_handle.kind == TypeKind.Unmodeled
            guard_names: mutable darray[sview] = ["handle"]
            guard_types: mutable darray[ValueType] = [guard_handle]
            guard_type: ValueType = register_synthesized_struct("MutexGuard", state_type, guard_names, guard_types, structs)
            unmodeled_type() return if guard_type.kind != TypeKind.Struct
            record_synthesized_instantiation("MutexGuard", state_type, guard_type, structs)
            return guard_type




        # `SplitView[T]` — the pair `split_at` yields. stage0's layout, read off its IR:
        # `%SplitView__i32 = type { %DynArrayView, %DynArrayView }`.
        def synthesize_split_view(element_type: ValueType, structs: mutable StructTable&) -> ValueType can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            unmodeled_type() return if element_type.kind == TypeKind.Unmodeled
            memoized: i64 = synthesized_struct_index_of("SplitView", element_type, structs)
            ValueType{kind: TypeKind.Struct, bits: memoized.u32()} return if memoized >= 0
            half_type: ValueType = intern_view_type(element_type, structs)
            unmodeled_type() return if half_type.kind == TypeKind.Unmodeled
            split_names: mutable darray[sview] = ["left", "right"]
            split_types: mutable darray[ValueType] = [half_type, copied_type(half_type)]
            split_type: ValueType = register_synthesized_struct("SplitView", element_type, split_names, split_types, structs)
            unmodeled_type() return if split_type.kind != TypeKind.Struct
            record_synthesized_instantiation("SplitView", element_type, split_type, structs)
            return split_type




        # `ChunksExactView[T]` — what `chunks_exact` yields. stage0's layout:
        # `%ChunksExactView__i32 = type { %DynArrayView, i64, i64 }` — the base view, the chunk
        # LENGTH, and the number of whole chunks.
        def synthesize_chunks_exact_view(element_type: ValueType, structs: mutable StructTable&) -> ValueType can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            unmodeled_type() return if element_type.kind == TypeKind.Unmodeled
            memoized: i64 = synthesized_struct_index_of("ChunksExactView", element_type, structs)
            ValueType{kind: TypeKind.Struct, bits: memoized.u32()} return if memoized >= 0
            base_type: ValueType = intern_view_type(element_type, structs)
            unmodeled_type() return if base_type.kind == TypeKind.Unmodeled
            i64_type: ValueType = ValueType{kind: TypeKind.Signed, bits: 64}
            chunk_names: mutable darray[sview] = ["base", "chunk", "count"]
            chunk_types: mutable darray[ValueType] = [base_type, i64_type, copied_type(i64_type)]
            chunk_type: ValueType = register_synthesized_struct("ChunksExactView", element_type, chunk_names, chunk_types, structs)
            unmodeled_type() return if chunk_type.kind != TypeKind.Struct
            record_synthesized_instantiation("ChunksExactView", element_type, chunk_type, structs)
            return chunk_type




        def synthesize_set_struct(element_type: ValueType, structs: mutable StructTable&) -> ValueType can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            unmodeled_type() return if element_type.kind == TypeKind.Unmodeled
            memoized: i64 = synthesized_struct_index_of("DynSet", element_type, structs)
            ValueType{kind: TypeKind.Struct, bits: memoized.u32()} return if memoized >= 0
            bucket_field_names: mutable darray[sview] = ["key", "state"]
            bucket_field_types: mutable darray[ValueType] = [copied_type(element_type), ValueType{kind: TypeKind.Unsigned, bits: 8}]
            bucket_type: ValueType = register_synthesized_struct("SetBucket", element_type, bucket_field_names, bucket_field_types, structs)
            unmodeled_type() return if bucket_type.kind != TypeKind.Struct
            # `SetBucket[T]` is named DIRECTLY in the std (`arena_set_find_index` walks an
            # `items: SetBucket[T]&`), so it needs a memo row of its own — without one every
            # helper body that mentions it declined, leaving `arena_set_add__T` declared but
            # BODILESS while `arena_set_add_or_panic__T` still called it.
            record_synthesized_instantiation("SetBucket", element_type, bucket_type, structs)
            usize_type: ValueType = ValueType{kind: TypeKind.Unsigned, bits: 64}
            items_type: ValueType = intern_optional_type(intern_ref_type(bucket_type, structs), structs)
            arena_type: ValueType = intern_optional_type(intern_ref_type(ValueType{kind: TypeKind.Arena, bits: 0}, structs), structs)
            unmodeled_type() return if items_type.kind == TypeKind.Unmodeled or arena_type.kind == TypeKind.Unmodeled
            set_field_names: mutable darray[sview] = ["items", "count", "used", "capacity", "arena"]
            set_field_types: mutable darray[ValueType] = [items_type, usize_type, usize_type, usize_type, arena_type]
            set_type: ValueType = register_synthesized_struct("DynSet", element_type, set_field_names, set_field_types, structs)
            unmodeled_type() return if set_type.kind != TypeKind.Struct
            record_synthesized_instantiation("DynSet", element_type, set_type, structs)
            return set_type




        # `view[T]` — the fat pointer is `DynArrayView {data: void&?, len: usize}`. stage0
        # needs no source declaration for it; stage1 read the layout out of the StructTable,
        # which only has it when elisacore_std/collections.elisa is in the unit. So EVERY view
        # program declined WITHOUT the std: view_struct_type answered Unmodeled, the View arm
        # in the index emitter fell through, and `v[0]` took its whole enclosing function with
        # it — silently, because a non-`main` drop is not fatal (exit 0, then an undefined
        # symbol at link).
        #
        # Same situation and same remedy as `set[T]` above. This is NOT parameter-specific: a
        # view LOCAL declined identically, and both answer correctly once the std is included.
        #
        # Registered ONLY when the name is absent. With the std in the unit its own
        # declaration is authoritative and must win — a second `DynArrayView` built here would
        # be a distinct LLVM type that no std function accepts.
        def synthesize_view_struct(structs: mutable StructTable&) -> ValueType can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            existing: i64 = struct_index_of(structs, "DynArrayView")
            ValueType{kind: TypeKind.Struct, bits: existing.u32()} return if existing >= 0
            data_type: ValueType = intern_optional_type(intern_ref_type(ValueType{kind: TypeKind.Void, bits: 0}, structs), structs)
            unmodeled_type() return if data_type.kind == TypeKind.Unmodeled
            name_storage: mutable darray[u8] = []
            handle: LLVMTypeRef = LLVMStructCreateNamed(structs.context, sview_to_cstr("DynArrayView", name_storage))
            slot: usize = structs.names.count
            structs.names <- structs.names.push("DynArrayView")
            structs.owners <- structs.owners.push("")    # the std view struct
            structs.handles <- structs.handles.push(handle)
            structs.alignments <- structs.alignments.push(0)
            structs.field_start <- structs.field_start.push(structs.field_names.count)
            structs.field_count <- structs.field_count.push(2.usize())
            structs.field_names <- structs.field_names.push("data")
            structs.field_types <- structs.field_types.push(data_type)
            structs.field_names <- structs.field_names.push("len")
            structs.field_types <- structs.field_types.push(ValueType{kind: TypeKind.Unsigned, bits: 64})
            view_element_types: mutable darray[LLVMTypeRef] = [llvm_type_of(data_type, structs, structs.context), LLVMInt64TypeInContext(structs.context)]
            view_elements_pointer: void& = (&view_element_types[0]).cast[void&] can Unsafe.PointerCast
            LLVMStructSetBody(handle, view_elements_pointer, 2, 0)
            return ValueType{kind: TypeKind.Struct, bits: slot.u32()}




        # `SetBucket[T]` — resolved through the pair above so the bucket a helper walks is
        # the SAME registered struct the set header points at.
        def synthesize_set_bucket(element_type: ValueType, structs: mutable StructTable&) -> ValueType can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                unmodeled_type() return if synthesize_set_struct(element_type, structs).kind != TypeKind.Struct
                bucket_index: i64 = synthesized_struct_index_of("SetBucket", element_type, structs)
                unmodeled_type() return if bucket_index < 0
                return ValueType{kind: TypeKind.Struct, bits: bucket_index.u32()}




        # `Owner.Name` for a module member, the bare name at top level. This is the LLVM
        # type name, and it has to differ per owner: LLVMGetTypeByName2 is consulted before
        # creating one, so two modules each declaring `Work` would otherwise REUSE the first
        # module's LLVM type for the second -- the same collapse the owner column exists to
        # stop, one level further down.
        def struct_llvm_name(owner: sview, name: sview, storage: mutable darray[u8]&) -> cstr can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            return sview_to_cstr(name, storage) if owner == ""
            for index in 0..<sview_len(owner) |storage, owner|:
                storage.push(sview_at(owner, index))
            storage.push(46)
            for index in 0..<sview_len(name) |storage, name|:
                storage.push(sview_at(name, index))
            storage.push(0)
            return (&storage[0]).cast[cstr] can Unsafe.PointerCast




        # The module recorded for generic template row `index`. Read defensively, as
        # struct_field_module_at is: the column is index-parallel with the names, and a
        # recording site that forgot to grow it would be an out-of-bounds read rather
        # than a missing module.
        def generic_template_owner_at(file: Ast::File&, index: usize) -> sview can[Abort.Panic]:
            return "" if index >= file.generic_struct_decl_owners.count
            return file.generic_struct_decl_owners[index]




        # Does `owner` itself declare a generic template called `name`?
        def generic_template_owned_by(file: Ast::File&, owner: sview, name: sview) -> bool can[Abort.Panic]:
            for index in 0..<file.generic_struct_decl_names.count |file, owner, name|:
                true return if file.generic_struct_decl_names[index] == name and generic_template_owner_at(file, index) == owner
            return false




        def register_struct_names(file: Ast::File&, structs: mutable StructTable&, ctx: LLVMContextRef) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            # Indexed rather than `for struct_name in file.struct_names`, because the owner
            # is a PARALLEL column and only the index pairs them.
            for struct_slot in 0..<file.struct_names.count |file, structs, ctx|:
                struct_name: sview = file.struct_names[struct_slot]
                struct_owner: sview = "" if struct_slot >= file.struct_owners.count else file.struct_owners[struct_slot]
                # A generic template has no concrete type of its own; skip it here --
                # but only THIS module's template. The test was by bare name, so a
                # module's ordinary struct was skipped whenever any template anywhere
                # shared its name: `module Recognition: struct Task` against the
                # runtime's generic `Task[T, S]` registered no type at all, and every
                # function mentioning it was declined. Same bug as the (owner, name)
                # key below, one line earlier.
                continue if generic_template_owned_by(file, struct_owner, struct_name)
                # Idempotent: extend modules re-declare types already registered. Keyed by
                # (owner, name) now -- the bare-name test also skipped a DIFFERENT module's
                # same-named struct, which is precisely the bug.
                continue if struct_index_of_in(structs, struct_owner, struct_name) >= 0
                name_storage: mutable darray[u8] = []
                struct_name_cstr: cstr = struct_llvm_name(struct_owner, struct_name, &name_storage)
                handle: mutable LLVMTypeRef = LLVMGetTypeByName2(ctx, struct_name_cstr)
                handle <- LLVMStructCreateNamed(ctx, struct_name_cstr) if handle == zeroed
                structs.names <- structs.names.push(struct_name)
                structs.owners <- structs.owners.push(struct_owner)
                structs.handles <- structs.handles.push(handle)
                structs.alignments <- structs.alignments.push(0)
                structs.field_start <- structs.field_start.push(0)
                structs.field_count <- structs.field_count.push(0)




        # The `__tuple_label` field names recorded (in source order) for the tuple at `line`.
        def tuple_labels_at(line: u32, structs: mutable StructTable&) -> darray[sview] can[Abort.Panic, Memory.Allocate]:
            result: mutable darray[sview] = []
            probe: mutable usize = 0
            while probe < structs.tuple_label_lines.count |probe, line, result, structs|:
                result.push(structs.tuple_label_names[probe]) if structs.tuple_label_lines[probe] == line
                probe <- probe + 1
            return result




        # Apply struct-level alignment metadata after all named types have been
        # registered. The parser stores `@align(N)` as `__align` with N in the
        # annotation's value-bearing line slot.
        def apply_struct_alignments(annotations: darray[Ast::EnumAnnotation]&, structs: mutable StructTable&) -> void can[Abort.Panic]:
            can Abort.Panic:
                for annotation in annotations |structs|:
                    continue if annotation.name != "__align"
                    index: i64 = struct_index_of(structs, annotation.owner)
                    if index >= 0 and index.usize() < structs.alignments.count:
                        structs.alignments[index.usize()] <- annotation.line




        def struct_alignment(value_type: ValueType, structs: StructTable&) -> u32 can[Abort.Panic]:
            if value_type.kind != TypeKind.Struct or value_type.bits.usize() >= structs.alignments.count:
                return 0
            return structs.alignments[value_type.bits.usize()]

include "./codegen_generic_structs.elisa"
include "./codegen_tuple_types.elisa"
include "./codegen_const_folding.elisa"
include "./codegen_static_if.elisa"
include "./codegen_decl_hoisting.elisa"
