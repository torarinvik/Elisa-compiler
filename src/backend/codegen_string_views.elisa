# Stage1 backend — darray-to-string-view and darray-to-C-string conversions.
# Keep these here rather than beside aggregate cloning: both operations are
# string representation/lifetime bridges with distinct backing requirements.
# Part of `module Backend` (see codegen.elisa).

extend Backend:
    private:
        const DARRAY_ITEMS_FIELD_INDEX: u32 = 0
        const DARRAY_COUNT_FIELD_INDEX: u32 = 1
        const SVIEW_DATA_FIELD_INDEX: u32 = 0
        const SVIEW_LENGTH_FIELD_INDEX: u32 = 1
        const LLVM_INT_PREDICATE_EQ: i32 = 32
        const DARRAY_CSTR_TERMINATOR_EXTRA_BYTES: u64 = 1


        # `bytes.as_sview()` borrows a byte darray without allocation. A zero-count
        # darray may have a null items pointer, but an sview always carries valid,
        # non-null backing. Substitute a static empty string only for the empty
        # view; non-empty views retain the darray pointer and its checked region tie.
        def emit_as_sview_builtin(callee: Expr, arguments: darray[Expr]&, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                null return if arguments.count != 0
                match callee:
                    Expr.Field(sv_receiver, sv_name, sv_line):
                        null return if sv_name != "as_sview"
                        sv_darray_type: ValueType = darray_type_behind_expr(sv_receiver, local_scope, structs)
                        null return if sv_darray_type.kind != TypeKind.DArray
                        sv_element_type: ValueType = darray_element_of(sv_darray_type, structs)
                        null return if sv_element_type.kind != TypeKind.Unsigned or sv_element_type.bits != 8
                        if darray_address_of_expr(sv_receiver, local_scope, fns, structs, generics, runtime, m, ctx, builder) is sv_slot:
                            sv_header_type: LLVMTypeRef = darray_llvm_type(structs, ctx)
                            sv_items_field: LLVMValueRef = LLVMBuildStructGEP2(builder, sv_header_type, sv_slot, DARRAY_ITEMS_FIELD_INDEX, "darray.sview.items.ptr")
                            sv_items: LLVMValueRef = LLVMBuildLoad2(builder, LLVMPointerTypeInContext(ctx, 0), sv_items_field, "darray.sview.items")
                            sv_count_field: LLVMValueRef = LLVMBuildStructGEP2(builder, sv_header_type, sv_slot, DARRAY_COUNT_FIELD_INDEX, "darray.sview.count.ptr")
                            sv_count: LLVMValueRef = darray_load_size_i64(sv_count_field, ctx, builder, "darray.sview.count")
                            sv_empty_test: LLVMValueRef = LLVMBuildICmp(builder, LLVM_INT_PREDICATE_EQ, sv_count, LLVMConstInt(LLVMInt64TypeInContext(ctx), 0, 0), "darray.sview.is.empty")
                            sv_empty_backing: LLVMValueRef = LLVMBuildGlobalStringPtr(builder, "", "darray.sview.empty.backing")
                            sv_data: LLVMValueRef = LLVMBuildSelect(builder, sv_empty_test, sv_empty_backing, sv_items, "darray.sview.data.valid")
                            sv_type: LLVMTypeRef = llvm_type_of(ValueType{kind: TypeKind.SView, bits: 0}, structs, ctx)
                            sv_result: mutable LLVMValueRef = LLVMGetUndef(sv_type)
                            sv_result <- LLVMBuildInsertValue(builder, sv_result, sv_data, SVIEW_DATA_FIELD_INDEX, "darray.sview.insert.data")
                            sv_result <- LLVMBuildInsertValue(builder, sv_result, sv_count, SVIEW_LENGTH_FIELD_INDEX, "darray.sview.insert.len")
                            return sv_result
                        return null
                    _:
                        pass
                return null


        # `bytes.as_cstr()` ensures space for one extra byte, writes a NUL at
        # count without changing count, and returns the items pointer. Unlike
        # as_sview this mutates the darray and therefore needs its region arena.
        def emit_as_cstr_builtin(callee: Expr, arguments: darray[Expr]&, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                null return if arguments.count != 0
                match callee:
                    Expr.Field(ac_receiver, ac_name, ac_name_line):
                        null return if ac_name != "as_cstr"
                        ac_type: ValueType = darray_type_behind_expr(ac_receiver, local_scope, structs)
                        null return if ac_type.kind != TypeKind.DArray
                        ac_element: ValueType = darray_element_of(ac_type, structs)
                        null return if ac_element.kind != TypeKind.Unsigned or ac_element.bits != 8
                        if darray_address_of_expr(ac_receiver, local_scope, fns, structs, generics, runtime, m, ctx, builder) is ac_slot:
                            ac_i64: LLVMTypeRef = LLVMInt64TypeInContext(ctx)
                            ac_header: LLVMTypeRef = darray_llvm_type(structs, ctx)
                            ac_count_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, ac_header, ac_slot, DARRAY_COUNT_FIELD_INDEX, "darray.cstr.count.ptr")
                            ac_count: LLVMValueRef = darray_load_size_i64(ac_count_pointer, ctx, builder, "darray.cstr.count")
                            ac_extra: LLVMValueRef = LLVMConstInt(ac_i64, DARRAY_CSTR_TERMINATOR_EXTRA_BYTES, 0)
                            # Check count + terminator before reserve or pointer arithmetic;
                            # wrapping to zero could otherwise write the NUL out of bounds.
                            if emit_checked_reserve_binary(ac_count, ac_extra, false, m, ctx, builder) is ac_needed:
                                ac_growth_runtime: Runtime = growth_runtime_for(ac_receiver, local_scope, runtime)
                                null return if not emit_darray_reserve(ac_slot, ac_type, ac_needed, structs, ac_growth_runtime, m, ctx, builder)
                                # Re-read items AFTER reserving: growth may have reallocated.
                                ac_items_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, ac_header, ac_slot, DARRAY_ITEMS_FIELD_INDEX, "darray.cstr.items.ptr")
                                ac_items: LLVMValueRef = LLVMBuildLoad2(builder, LLVMPointerTypeInContext(ctx, 0), ac_items_pointer, "darray.cstr.items")
                                ac_indices: mutable darray[LLVMValueRef] = [ac_count]
                                ac_indices_pointer: void& = (&ac_indices[0]).cast[void&] can Unsafe.PointerCast
                                ac_terminator: LLVMValueRef = LLVMBuildGEP2(builder, LLVMInt8TypeInContext(ctx), ac_items, ac_indices_pointer, 1, "darray.cstr.nul.ptr")
                                _ = LLVMBuildStore(builder, LLVMConstInt(LLVMInt8TypeInContext(ctx), 0, 0), ac_terminator)
                                return ac_items
                            return null
                        return null
                    _:
                        pass
                return null
