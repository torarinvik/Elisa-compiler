# Stage1 backend — resolving a NAME to a function: overload selection by argument types and
# arity, `__cast__` hooks, named arguments, and the declared parameter and return types an
# emitter asks about before it emits a call.
# Part of `module Backend` (see codegen.elisa).

extend Backend:
    private:
        # The handle for `owner::name`, or null when there is no such function.
        # When overloads share a bare name, the first registered entry is returned —
        # prefer `lookup_function_arity` at call sites with a known argument count.
        def lookup_function(fns: FnTable&, owner: sview, name: sview) -> LLVMValueRef? can[Abort.Panic]:
            index_cursor: mutable i64 = first_function_named(fns, name)
            while index_cursor >= 0 |index_cursor, fns, owner, name|:
                index: usize = index_cursor.usize()
                index_cursor <- next_function_named(fns, name, index_cursor)
                fns.handles[index] return if fns.names[index] == name and fns.owners[index] == owner
            return null



        # Among several overloads sharing (owner, name, ARITY), the index whose declared
        # parameter types match the arguments — or -1.
        #
        # Arity alone is not enough. `def f(x: i64)` and `def f(x: bool)` are both legal and
        # both arity 1 (stage0 accepts type-based overloads and REJECTS arity-based ones), and
        # emit_direct_call took the FIRST arity match, so `f(true)` called the i64 body:
        # stage0 answered 21 and stage1 answered 11. The symbols were already distinct
        # (`f` and `f.1`, suffixed by arity) — the defect was purely in resolution.
        #
        # A bare numeric literal matches its whole numeric family, since `f(5)` types as
        # Unmodeled: an int literal has no type of its own and adopts its context.
        # The type a receiver-method cast NAMES when it is not a builtin scalar: a packed
        # (hierarchy) or payload enum. Used to recognise `x.Event()` as a `__cast__` hook
        # call rather than a UFCS call to a function named `Event`.
        def cast_hook_target_type(name: sview, structs: mutable StructTable&) -> ValueType can[Abort.Panic]:
            packed_target: i64 = packed_index_of(structs, name)
            ValueType{kind: TypeKind.PackedEnum, bits: packed_target.u32()} return if packed_target >= 0
            payload_target: i64 = penum_index_of(structs, name)
            ValueType{kind: TypeKind.PayloadEnum, bits: payload_target.u32()} return if payload_target >= 0
            return unmodeled_type()



        # The index of a visible `__cast__(source) -> target` overload, or -1. The pair is
        # EXACT on both ends, which is stage0's rule: an untyped literal must be given a
        # type first (`5.i32().Event()`), and a hook is never picked by return type alone.
        def cast_hook_index(fns: FnTable&, source: ValueType, target: ValueType) -> i64 can[Abort.Panic]:
            return -1 if source.kind == TypeKind.Unmodeled or target.kind == TypeKind.Unmodeled
            index_cursor: mutable i64 = first_function_named(fns, "__cast__")
            while index_cursor >= 0 |index_cursor, fns, source, target|:
                index: usize = index_cursor.usize()
                index_cursor <- next_function_named(fns, "__cast__", index_cursor)
                continue if fns.names[index] != "__cast__"
                continue if fns.param_count[index] != 1
                declared: ValueType = fns.param_types[fns.param_start[index]]
                continue if not value_type_identity_equal(declared, source)
                returned: ValueType = fns.returns[index]
                continue if not value_type_identity_equal(returned, target)
                return index.i64()
            return -1



        def overload_candidate_matches_argument(index: usize, position: usize, argument: Expr, actual: ValueType, fns: FnTable&, structs: mutable StructTable&) -> bool can[Abort.Panic]:
            declared: ValueType = fns.param_types[fns.param_start[index] + position]
            if actual.kind == TypeKind.Unmodeled:
                match argument:
                    Expr.IntLit(_, _):
                        return declared.kind == TypeKind.Signed or declared.kind == TypeKind.Unsigned
                    Expr.FloatLit(_, _):
                        return declared.kind == TypeKind.Float
                    _:
                        return false
            # A T& parameter accepts a plain T because the call emitter borrows it
            # implicitly, but a T&& parameter cannot claim an argument already of type T&.
            expected: mutable ValueType = declared
            expected <- ref_target_of(declared, structs) if declared.kind == TypeKind.Ref and actual.kind != TypeKind.Ref
            # Distinct const enums can share this scalar representation, so selection
            # must retain their nominal enum identity as well as kind and width.
            return value_type_identity_equal(expected, actual)


        def overload_candidate_matches_args(index: usize, fns: FnTable&, arguments: darray[Expr]&, local_scope: mutable Scope&, structs: mutable StructTable&, generics: mutable GenericTable&) -> bool can[Abort.Panic, Memory.Allocate]:
            matched: mutable bool = arguments.count > 0
            for position in 0..<arguments.count |matched, index, fns, arguments, local_scope, structs, generics|:
                continue if not matched
                actual: ValueType = expression_type(arguments[position], local_scope, fns, structs, generics)
                matched <- overload_candidate_matches_argument(index, position, arguments[position], actual, fns, structs)
            return matched



        # Whether a declaration can accept the call's labels and argument count. Missing
        # formals must have defaults; extra arguments are accepted only by a variadic row.
        # This shape check is also the safe fallback boundary when no exact type match exists.
        def overload_candidate_matches_call_shape(index: usize, arguments: darray[Expr]&, argument_names: darray[sview]&, fns: FnTable&, has_receiver: bool = false) -> bool can[Abort.Panic, Memory.Allocate]:
            return false if argument_names.count != 0 and argument_names.count != arguments.count
            return false if index >= fns.param_count.count or index >= fns.param_start.count
            fixed_count: usize = fns.param_count[index]
            parameter_start: usize = fns.param_start[index]
            return false if parameter_start > fns.param_names.count or fixed_count > fns.param_names.count - parameter_start
            return false if parameter_start > fns.param_types.count or fixed_count > fns.param_types.count - parameter_start
            return false if parameter_start > fns.param_defaults.count or fixed_count > fns.param_defaults.count - parameter_start
            variadic: bool = index < fns.is_variadic.count and fns.is_variadic[index]
            false return if variadic and (any argument_name in argument_names where argument_name != "")
            return false if has_receiver and fixed_count == 0
            provided_count: usize = arguments.count + (1.usize() if has_receiver else 0.usize())
            return false if provided_count > fixed_count and not variadic
            has_named_argument: bool = any argument_name in argument_names where argument_name != ""
            if not has_named_argument:
                if provided_count < fixed_count:
                    for parameter_position in provided_count..<fixed_count |parameter_position, fns, parameter_start|:
                        return false if fns.param_defaults[parameter_start + parameter_position] is Expr.Invalid
                return true
            assigned: mutable darray[bool] = [false for _slot in 0..<fixed_count]
            next_position: mutable usize = 1.usize() if has_receiver else 0.usize()
            assigned[0] <- true if has_receiver
            for source_position in 0..<arguments.count |assigned, next_position, index, arguments, argument_names, fns, fixed_count, variadic, has_receiver|:
                argument_name: sview = argument_names[source_position] if argument_names.count != 0 else ""
                if source_position + (1.usize() if has_receiver else 0.usize()) >= fixed_count:
                    false return if not variadic or argument_name != ""
                    continue
                selected: mutable usize = fixed_count
                if argument_name != "":
                    for parameter_position in 0..<fixed_count |selected, argument_name, fns, index|:
                        if fns.param_names[parameter_start + parameter_position] == argument_name:
                            selected <- parameter_position
                            break
                else:
                    while next_position < fixed_count and assigned[next_position] |next_position, assigned|:
                        next_position <- next_position + 1
                    selected <- next_position
                    next_position <- next_position + 1 if next_position < fixed_count
                false return if selected >= fixed_count or assigned[selected]
                assigned[selected] <- true
            for parameter_position in 0..<fixed_count |assigned, fns, index, fixed_count|:
                default_slot: usize = parameter_start + parameter_position
                false return if not assigned[parameter_position] and fns.param_defaults[default_slot] is Expr.Invalid
            return true



        # Typed counterpart to overload_candidate_matches_call_shape. Map labels to the
        # candidate's actual parameter order before comparing types, so `f(y: ..., x: ...)`
        # cannot select the overload that only matches source order.
        def overload_candidate_matches_call_args(index: usize, arguments: darray[Expr]&, argument_names: darray[sview]&, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, depth: i64) -> bool can[Abort.Panic, Memory.Allocate]:
            return false if argument_names.count != 0 and argument_names.count != arguments.count
            return false if index >= fns.param_count.count or index >= fns.param_start.count
            fixed_count: usize = fns.param_count[index]
            parameter_start: usize = fns.param_start[index]
            return false if parameter_start > fns.param_names.count or fixed_count > fns.param_names.count - parameter_start
            return false if parameter_start > fns.param_types.count or fixed_count > fns.param_types.count - parameter_start
            return false if parameter_start > fns.param_defaults.count or fixed_count > fns.param_defaults.count - parameter_start
            variadic: bool = index < fns.is_variadic.count and fns.is_variadic[index]
            false return if variadic and (any argument_name in argument_names where argument_name != "")
            return false if arguments.count > fixed_count and not variadic
            has_named_argument: bool = any argument_name in argument_names where argument_name != ""
            if not has_named_argument:
                matched: mutable bool = true
                for parameter_position in 0..<fixed_count |matched, index, arguments, local_scope, fns, structs, generics, parameter_start, depth|:
                    continue if not matched
                    if parameter_position < arguments.count:
                        actual: ValueType = expression_type_depth(arguments[parameter_position], local_scope, fns, structs, generics, depth + 1)
                        matched <- overload_candidate_matches_argument(index, parameter_position, arguments[parameter_position], actual, fns, structs)
                    else:
                        matched <- false if fns.param_defaults[parameter_start + parameter_position] is Expr.Invalid
                return matched
            assigned: mutable darray[bool] = [false for _slot in 0..<fixed_count]
            next_position: mutable usize = 0
            matched: mutable bool = true
            for source_position in 0..<arguments.count |assigned, next_position, matched, index, arguments, argument_names, local_scope, fns, structs, generics, fixed_count, variadic, parameter_start, depth|:
                continue if not matched
                argument_name: sview = argument_names[source_position] if argument_names.count != 0 else ""
                if source_position >= fixed_count:
                    matched <- false if not variadic or argument_name != ""
                    continue
                selected: mutable usize = fixed_count
                if argument_name != "":
                    for parameter_position in 0..<fixed_count |selected, argument_name, fns, index|:
                        if fns.param_names[parameter_start + parameter_position] == argument_name:
                            selected <- parameter_position
                            break
                else:
                    while next_position < fixed_count and assigned[next_position] |next_position, assigned|:
                        next_position <- next_position + 1
                    selected <- next_position
                    next_position <- next_position + 1 if next_position < fixed_count
                continue if selected >= fixed_count or assigned[selected]
                assigned[selected] <- true
                actual: ValueType = expression_type_depth(arguments[source_position], local_scope, fns, structs, generics, depth + 1)
                matched <- overload_candidate_matches_argument(index, selected, arguments[source_position], actual, fns, structs)
            for parameter_position in 0..<fixed_count |matched, assigned, fns, parameter_start|:
                default_slot: usize = parameter_start + parameter_position
                matched <- false if not assigned[parameter_position] and fns.param_defaults[default_slot] is Expr.Invalid
            return matched



        def overload_index_for_call_args_at_depth(fns: FnTable&, owner: sview, name: sview, arguments: darray[Expr]&, argument_names: darray[sview]&, local_scope: mutable Scope&, structs: mutable StructTable&, generics: mutable GenericTable&, depth: i64) -> i64 can[Abort.Panic, Memory.Allocate]:
            index_cursor: mutable i64 = first_function_named(fns, name)
            found: mutable i64 = -1
            while index_cursor >= 0 |index_cursor, found, fns, owner, name, arguments, argument_names, local_scope, structs, generics, depth|:
                index: usize = index_cursor.usize()
                index_cursor <- next_function_named(fns, name, index_cursor)
                continue if fns.names[index] != name or fns.owners[index] != owner
                if overload_candidate_matches_call_args(index, arguments, argument_names, local_scope, fns, structs, generics, depth):
                    return -1 if found >= 0
                    found <- index.i64()
            return found



        def overload_index_for_call_args(fns: FnTable&, owner: sview, name: sview, arguments: darray[Expr]&, argument_names: darray[sview]&, local_scope: mutable Scope&, structs: mutable StructTable&, generics: mutable GenericTable&) -> i64 can[Abort.Panic, Memory.Allocate]:
            return overload_index_for_call_args_at_depth(fns, owner, name, arguments, argument_names, local_scope, structs, generics, 0)



        # Whether any row under OWNER::NAME accepts this call shape. Owner precedence uses
        # this existential check before generic fallback; typed overload selection later
        # resolves same-shape rows or declines if their types remain ambiguous.
        def function_has_call_shape(fns: FnTable&, owner: sview, name: sview, arguments: darray[Expr]&, argument_names: darray[sview]&, has_receiver: bool = false) -> bool can[Abort.Panic, Memory.Allocate]:
            index_cursor: mutable i64 = first_function_named(fns, name)
            while index_cursor >= 0 |index_cursor, fns, owner, name, arguments, argument_names, has_receiver|:
                index: usize = index_cursor.usize()
                index_cursor <- next_function_named(fns, name, index_cursor)
                continue if fns.names[index] != name or fns.owners[index] != owner
                true return if overload_candidate_matches_call_shape(index, arguments, argument_names, fns, has_receiver)
            return false



        # Pick by source call shape only when exactly one row under OWNER::NAME accepts it.
        # This is a type-inference fallback; call emission separately tries typed resolution
        # first and can select among same-shape overloads by argument types.
        def function_index_of_unique_call_shape(fns: FnTable&, owner: sview, name: sview, arguments: darray[Expr]&, argument_names: darray[sview]&, has_receiver: bool = false) -> i64 can[Abort.Panic, Memory.Allocate]:
            index_cursor: mutable i64 = first_function_named(fns, name)
            found: mutable i64 = -1
            while index_cursor >= 0 |index_cursor, found, fns, owner, name, arguments, argument_names, has_receiver|:
                index: usize = index_cursor.usize()
                index_cursor <- next_function_named(fns, name, index_cursor)
                continue if fns.names[index] != name or fns.owners[index] != owner
                continue if not overload_candidate_matches_call_shape(index, arguments, argument_names, fns, has_receiver)
                return -1 if found >= 0
                found <- index.i64()
            return found



        # Pick the owner for an unqualified name only when it is unambiguous. A sole owner
        # keeps the existing name fallback; with multiple owners, exactly one owner must
        # have at least one call-shape-compatible row. Same-owner overload ambiguity is
        # left to typed resolution after the owner is chosen.
        def function_index_for_unique_call_owner(fns: FnTable&, name: sview, arguments: darray[Expr]&, argument_names: darray[sview]&, has_receiver: bool = false) -> i64 can[Abort.Panic, Memory.Allocate]:
            index_cursor: mutable i64 = first_function_named(fns, name)
            first_row: mutable i64 = -1
            first_owner: mutable sview = ""
            multiple_name_owners: mutable bool = false
            shape_row: mutable i64 = -1
            shape_owner: mutable sview = ""
            multiple_shape_owners: mutable bool = false
            while index_cursor >= 0 |index_cursor, first_row, first_owner, multiple_name_owners, shape_row, shape_owner, multiple_shape_owners, fns, name, arguments, argument_names, has_receiver|:
                index: usize = index_cursor.usize()
                index_cursor <- next_function_named(fns, name, index_cursor)
                continue if fns.names[index] != name
                owner: sview = fns.owners[index]
                if first_row < 0:
                    first_row <- index.i64()
                    first_owner <- owner
                elif owner != first_owner:
                    multiple_name_owners <- true
                if overload_candidate_matches_call_shape(index, arguments, argument_names, fns, has_receiver):
                    if shape_row < 0:
                        shape_row <- index.i64()
                        shape_owner <- owner
                    elif owner != shape_owner:
                        multiple_shape_owners <- true
            return first_row if not multiple_name_owners
            return shape_row if shape_row >= 0 and not multiple_shape_owners
            return -1



        def overload_index_for_args(fns: FnTable&, owner: sview, name: sview, arguments: darray[Expr]&, local_scope: mutable Scope&, structs: mutable StructTable&, generics: mutable GenericTable&) -> i64 can[Abort.Panic, Memory.Allocate] :
            can Abort.Panic:
                index_cursor: mutable i64 = first_function_named(fns, name)
                while index_cursor >= 0 |index_cursor, fns, owner, name, arguments, local_scope, structs, generics|:
                    index: usize = index_cursor.usize()
                    index_cursor <- next_function_named(fns, name, index_cursor)
                    continue if fns.names[index] != name or fns.owners[index] != owner
                    continue if fns.param_count[index] != arguments.count
                    index.i64() return if overload_candidate_matches_args(index, fns, arguments, local_scope, structs, generics)
                return -1



        # How many overloads of `owner::name` overload_index_for_args would accept — i.e. the
        # size of the candidate set it returns the FIRST of. Same predicate, counted instead
        # of short-circuited.
        #
        # A caller that cannot tolerate a guess asks for this first. Static protocol dispatch
        # through a bound type parameter is the case: stage1 models `char`, `int`, `i64` and
        # `isize` as ONE ValueType (Signed/64, see scalar_type_of_name), so the std's
        # `impl Str for char` and `impl Str for i64` are indistinguishable here, and taking
        # the first made `print(42)` answer "*" — chr(42), through the char impl. Measured.
        # A wrong answer is worse than a decline, so an ambiguous set falls through.
        def overload_match_count(fns: FnTable&, owner: sview, name: sview, arguments: darray[Expr]&, local_scope: mutable Scope&, structs: mutable StructTable&, generics: mutable GenericTable&) -> i64 can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic:
                total: mutable i64 = 0
                index_cursor: mutable i64 = first_function_named(fns, name)
                while index_cursor >= 0 |index_cursor, total, fns, owner, name, arguments, local_scope, structs, generics|:
                    index: usize = index_cursor.usize()
                    index_cursor <- next_function_named(fns, name, index_cursor)
                    continue if fns.names[index] != name or fns.owners[index] != owner
                    continue if fns.param_count[index] != arguments.count
                    total <- total + 1 if overload_candidate_matches_args(index, fns, arguments, local_scope, structs, generics)
                return total




            # Does a NON-GENERIC top-level overload of NAME take EXACTLY these argument types?
            #
            # The second half of the overload fix; see decl_line_is_generic for the first. Once
            # the non-generic body is emitted again, calls still have to PREFER it: resolution
            # tries generics first, which is right for `identity(42)` and wrong whenever an
            # exact overload exists. `f(5)` beside `f[T](x: T)` bound to the instantiation and
            # answered 2 where stage0 answers 1.
            #
            # Strict on everything EXCEPT a bare numeric literal: `f(5)` types as Unmodeled (an
            # int literal has no type of its own and adopts its context), so requiring an exact
            # type would disqualify the very call this exists for. A literal therefore matches
            # any parameter of the corresponding numeric family; everything else must match on
            # kind AND bits, and a non-literal argument of unknown type still disqualifies the
            # candidate — a near-match has to fall through to the generic, which is what converts.
        def exact_overload_exists(fns: FnTable&, name: sview, arguments: darray[Expr]&, local_scope: mutable Scope&, structs: mutable StructTable&, generics: mutable GenericTable&) -> bool can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic:
                index_cursor: mutable i64 = first_function_named(fns, name)
                while index_cursor >= 0 |index_cursor, fns, name, arguments, local_scope, structs, generics|:
                    index: usize = index_cursor.usize()
                    index_cursor <- next_function_named(fns, name, index_cursor)
                    continue if fns.names[index] != name or fns.owners[index] != ""
                    true return if exact_overload_row_matches(fns, index, arguments, local_scope, structs, generics)
                return false



        # Label-aware top-level counterpart used by ordinary direct calls. This is
        # existential by design: any exact non-generic candidate shadows generic fallback,
        # even if another same-shape row also matches and direct resolution later declines
        # as ambiguous. Keep the positional predicate above for callers without label data.
        def exact_overload_exists_for_call_args(fns: FnTable&, name: sview, arguments: darray[Expr]&, argument_names: darray[sview]&, local_scope: mutable Scope&, structs: mutable StructTable&, generics: mutable GenericTable&, depth: i64) -> bool can[Abort.Panic, Memory.Allocate]:
            index_cursor: mutable i64 = first_function_named(fns, name)
            while index_cursor >= 0 |index_cursor, fns, name, arguments, argument_names, local_scope, structs, generics, depth|:
                index: usize = index_cursor.usize()
                index_cursor <- next_function_named(fns, name, index_cursor)
                continue if fns.names[index] != name or fns.owners[index] != ""
                true return if overload_candidate_matches_call_args(index, arguments, argument_names, local_scope, fns, structs, generics, depth)
            return false



        # As exact_overload_exists, restricted to an ordinary USER definition: externs and
        # declarations whose source is the runtime stdlib are skipped. The runtime's own
        # concrete `fetch_add(AtomicSlot[i64]&, ...)` is the API an intrinsic implements,
        # not an overload that should replace it.
        def user_exact_overload_exists(fns: FnTable&, name: sview, arguments: darray[Expr]&, local_scope: mutable Scope&, structs: mutable StructTable&, generics: mutable GenericTable&) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic:
                index_cursor: mutable i64 = first_function_named(fns, name)
                while index_cursor >= 0 |index_cursor, fns, name, arguments, local_scope, structs, generics|:
                    index: usize = index_cursor.usize()
                    index_cursor <- next_function_named(fns, name, index_cursor)
                    continue if fns.names[index] != name or fns.owners[index] != ""
                    continue if index < fns.is_extern.count and fns.is_extern[index]
                    continue if not exact_overload_row_matches(fns, index, arguments, local_scope, structs, generics)
                    true return if not (Lexer::source_line_is_runtime_std(fns.lines[index]) can Global{Read,Write})
                return false



        def exact_overload_row_matches(fns: FnTable&, index: usize, arguments: darray[Expr]&, local_scope: mutable Scope&, structs: mutable StructTable&, generics: mutable GenericTable&) -> bool can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic:
                false return if fns.param_count[index] != arguments.count
                matched: mutable bool = arguments.count > 0
                for position in 0..<arguments.count |matched, index, fns, arguments, local_scope, structs, generics|:
                    continue if not matched
                    declared: ValueType = fns.param_types[fns.param_start[index] + position]
                    actual: ValueType = expression_type(arguments[position], local_scope, fns, structs, generics)
                    if actual.kind == TypeKind.Unmodeled:
                        literal_ok: mutable bool = false
                        match arguments[position]:
                            Expr.IntLit(ovl_int_text, _):
                                literal_ok <- declared.kind == TypeKind.Signed or declared.kind == TypeKind.Unsigned
                            _:
                                pass
                        match arguments[position]:
                            Expr.FloatLit(ovl_float_text, _):
                                literal_ok <- declared.kind == TypeKind.Float
                            _:
                                pass
                        matched <- literal_ok
                    else:
                        # A `T&` parameter is an exact match for a plain `T` argument: the call
                        # emitter borrows the place implicitly (see overload_index_for_args).
                        # Without this, `def has(m: dict[i64, i64]&, k: i64)` was not "exact"
                        # for `has(m, k)` with a dict local, resolution preferred the std's
                        # generic `has[T](items: Flags[T]&, value: T)`, and the program aborted
                        # inside flags_mask where stage0 calls the user's function.
                        expected: mutable ValueType = declared
                        expected <- ref_target_of(declared, structs) if declared.kind == TypeKind.Ref and actual.kind != TypeKind.Ref
                        # Keep exact-overload checks aligned with ordinary selection for
                        # nominal const-enum types sharing a scalar representation.
                        matched <- false if not value_type_identity_equal(expected, actual)
                return matched



            # Overload-aware lookup: match bare name + owner + declared parameter count
            # (arena / error-out params are not included in `arity`).
        def lookup_function_arity(fns: FnTable&, owner: sview, name: sview, arity: usize) -> LLVMValueRef? can[Abort.Panic]:
            index_cursor: mutable i64 = first_function_named(fns, name)
            while index_cursor >= 0 |index_cursor, fns, owner, name, arity|:
                index: usize = index_cursor.usize()
                index_cursor <- next_function_named(fns, name, index_cursor)
                fns.handles[index] return if fns.names[index] == name and fns.owners[index] == owner and fns.param_count[index] == arity
            return null




        # The declared type of function `name`'s parameter `position`, or Unmodeled.
        # Emitting each argument at its parameter's type is what makes a literal argument
        # adopt the parameter type instead of defaulting to i64.
        def param_type_of(fns: FnTable&, owner: sview, name: sview, position: usize) -> ValueType can[Abort.Panic]:
            index_cursor: mutable i64 = first_function_named(fns, name)
            while index_cursor >= 0 |index_cursor, fns, owner, name, position|:
                index: usize = index_cursor.usize()
                index_cursor <- next_function_named(fns, name, index_cursor)
                if fns.names[index] == name and fns.owners[index] == owner:
                    unmodeled_type() return if position >= fns.param_count[index]
                    return copied_type(fns.param_types[fns.param_start[index] + position])
            return unmodeled_type()




        def param_type_count(fns: FnTable&, owner: sview, name: sview) -> usize can[Abort.Panic]:
            index_cursor: mutable i64 = first_function_named(fns, name)
            while index_cursor >= 0 |index_cursor, fns, owner, name|:
                index: usize = index_cursor.usize()
                index_cursor <- next_function_named(fns, name, index_cursor)
                fns.param_count[index] return if fns.names[index] == name and fns.owners[index] == owner
            return 0




        # Return the source-argument index that supplies parameter `wanted`. Positional
        # arguments fill the next unassigned parameter; labelled arguments select by name.
        # `first_position` is 1 for UFCS calls because parameter 0 is the implicit receiver.
        # An entirely empty name vector is the canonical AST representation for an all-positional
        # call built by a lowering pass (for example `machine from`'s enum-state constructor),
        # so it must not be read as an argument-count mismatch. The old loop returned -1 for that
        # shape, making every lowered multi-field constructor decline while the same source-written
        # constructor compiled.
        def named_argument_index(argument_names: darray[sview]&, parameter_names: darray[sview]&, parameter_start: usize, parameter_count: usize, first_position: usize, wanted: usize) -> i64 can[Abort.Panic, Memory.Allocate]:
            -1 return if wanted < first_position or wanted >= parameter_count
            if argument_names.count == 0:
                return (wanted - first_position).i64()
            assigned: mutable darray[bool] = [false for _slot in 0..<parameter_count]
            assigned[0] <- true if first_position == 1 and parameter_count > 0
            next_pos: mutable usize = first_position
            for argument_index in 0..<argument_names.count |assigned, next_pos, argument_names, parameter_names, parameter_start, parameter_count, first_position, wanted|:
                argument_name: sview = argument_names[argument_index]
                selected: mutable usize = parameter_count
                if argument_name != "":
                    for parameter_index in first_position..<parameter_count |selected, argument_name, parameter_names, parameter_start|:
                        if parameter_names[parameter_start + parameter_index] == argument_name:
                            selected <- parameter_index
                            break
                else:
                    while next_pos < parameter_count and assigned[next_pos] |next_pos, assigned|:
                        next_pos <- next_pos + 1
                    selected <- next_pos
                    next_pos <- next_pos + 1 if next_pos < parameter_count
                argument_index.i64() return if selected == wanted and selected < parameter_count and not assigned[selected]
                -1 return if selected >= parameter_count or assigned[selected]
                assigned[selected] <- true
            return -1




        # Generic declarations retain their parameter names in the AST rather than in FnTable.
        # Use the same source-to-parameter assignment rules as ordinary calls.
        def generic_named_argument_index(argument_names: darray[sview]&, parameters: darray[ParamDecl], wanted: usize) -> i64 can[Abort.Panic, Memory.Allocate]:
            assigned: mutable darray[bool] = [false for _slot in 0..<parameters.count]
            next_pos: mutable usize = 0
            for argument_index in 0..<argument_names.count |assigned, next_pos, argument_names, parameters, wanted|:
                argument_name: sview = argument_names[argument_index]
                selected: mutable usize = parameters.count
                if argument_name != "":
                    for parameter_index in 0..<parameters.count |selected, argument_name, parameters|:
                        if parameters[parameter_index].name == argument_name:
                            selected <- parameter_index
                            break
                else:
                    while next_pos < parameters.count and assigned[next_pos] |next_pos, assigned|:
                        next_pos <- next_pos + 1
                    selected <- next_pos
                    next_pos <- next_pos + 1 if next_pos < parameters.count
                argument_index.i64() return if selected == wanted and selected < parameters.count and not assigned[selected]
                -1 return if selected >= parameters.count or assigned[selected]
                assigned[selected] <- true
            return -1




        # C default argument promotions for the unnamed tail of a variadic call.
        def c_variadic_promoted_type(value_type: ValueType) -> ValueType can[Abort.Panic]:
            ValueType{kind: TypeKind.Signed, bits: 32} return if value_type.kind == TypeKind.Bool
            ValueType{kind: TypeKind.Signed, bits: 32} return if (value_type.kind == TypeKind.Signed or value_type.kind == TypeKind.Unsigned) and value_type.bits < 32
            ValueType{kind: TypeKind.Float, bits: 64} return if value_type.kind == TypeKind.Float and value_type.bits == 32
            return copied_type(value_type)




        # The declared return type of `name`, or Unmodeled when the module has no such
        # function.
        def lookup_return_type(fns: FnTable&, owner: sview, name: sview) -> ValueType can[Abort.Panic]:
            index: i64 = function_index_of(fns, owner, name)
            return copied_type(fns.returns[index.usize()]) if index >= 0
            return unmodeled_type()
