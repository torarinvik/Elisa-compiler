# Compiler-issued profiler identities.
#
# These IDs are emitted by the compiler, not recomputed by the collector. They
# are deterministic for the qualified source declaration and its source line,
# which lets the profiler keep readable names separate from identity. Generic
# specialization and source-map expansion can extend this input later without
# changing the callback ABI.
extend Backend:
    private:
        const TRACE_ID_FNV_OFFSET: u64 = 14695981039346656037
        const TRACE_ID_FNV_PRIME: u64 = 1099511628211
        const TRACE_ID_SEPARATOR: u64 = 0
        const TRACE_ID_STATEMENT_KIND: u64 = 1
        const TRACE_ID_VALUE_KIND: u64 = 2

        def trace_id_hash_text(hash: u64, value: sview) -> u64:
            result: mutable u64 = hash
            for index in 0..<sview_len(value) |result, value|:
                result <- (result ^ sview_at(value, index).u64()) * TRACE_ID_FNV_PRIME
            result <- (result ^ TRACE_ID_SEPARATOR) * TRACE_ID_FNV_PRIME
            return result


        def trace_identity_id(owner: sview, function_name: sview, arity: usize, line: u32) -> u64:
            result: mutable u64 = TRACE_ID_FNV_OFFSET
            result <- trace_id_hash_text(result, owner)
            result <- trace_id_hash_text(result, function_name)
            result <- (result ^ arity.u64()) * TRACE_ID_FNV_PRIME
            result <- (result ^ line.u64()) * TRACE_ID_FNV_PRIME
            return 1 if result == 0 else result


        # A generic body is emitted once for every concrete LLVM specialization. Its AST
        # declaration keeps the source-level base name, while LLVM gives the instantiated
        # function a deterministic `__type_args` suffix. Hash that suffix only when it is
        # actually present; ordinary module members keep the v1 identity they already had.
        # The last dotted component is used because module-qualified LLVM names are
        # `Module.function`, whereas generic names may be `Module.function__i64`.
        def trace_symbol_is_specialization(function_name: sview, symbol: sview) -> bool:
            component_start: mutable usize = 0.usize()
            for index in 0..<sview_len(symbol) |component_start, symbol|:
                component_start <- index + 1.usize() if sview_at(symbol, index) == 46.u8()
            name_length: usize = sview_len(function_name)
            false return if sview_len(symbol) < component_start + name_length + 2.usize()
            for index in 0..<name_length |index, function_name, symbol, component_start|:
                false return if sview_at(symbol, component_start + index) != sview_at(function_name, index)
            return sview_at(symbol, component_start + name_length) == 95.u8() and sview_at(symbol, component_start + name_length + 1.usize()) == 95.u8()


        # Use the LLVM specialization spelling as an identity component for generic bodies.
        # This fixes the previous collision where `work[i64]` and `work[f64]` shared the
        # source declaration line and therefore merged into one profiler function record.
        def trace_identity_id_for_function(owner: sview, function_name: sview, arity: usize, line: u32, function: LLVMValueRef) -> u64 can[Unsafe.PointerCast]:
            symbol_length: mutable usize = 0.usize()
            symbol: cstr = LLVMGetValueName2(function, &symbol_length)
            return trace_identity_id(owner, function_name, arity, line) if symbol_length == 0.usize()
            symbol_bytes: u8& = symbol.cast[u8&] can Unsafe.PointerCast
            symbol_view: sview = sview(symbol_bytes, 0, symbol_length.i64())
            return trace_identity_id(owner, symbol_view, arity, line) if trace_symbol_is_specialization(function_name, symbol_view)
            return trace_identity_id(owner, function_name, arity, line)


        def trace_location_id(function_id: u64, line: u32, kind: u64, variable: sview) -> u64:
            result: mutable u64 = (function_id ^ kind) * TRACE_ID_FNV_PRIME
            result <- (result ^ line.u64()) * TRACE_ID_FNV_PRIME
            result <- trace_id_hash_text(result, variable)
            return 1 if result == 0 else result
