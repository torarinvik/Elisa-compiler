# Stage1 backend — DWARF debug info and module-level declaration selection.
# Part of `module Backend` (see codegen.elisa); split out to keep each file short.

extend Backend:
    public:


        # Declare every ordinary function and extern before any body is emitted. Keeping this
        # pass outside the module driver makes the self-hosted backend's main emission routine
        # small enough for stage1's control-flow lowerer while preserving forward-call support.
        def declare_module_functions(file: Ast::File&, top: darray[Decl], fns: mutable FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, m: LLVMModuleRef, ctx: LLVMContextRef) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                variadic_annotations: mutable darray[Ast::EnumAnnotation] = []
                template_lines: darray[u32] = generic_declaration_lines(file)
                for annotation in file.enum_annotations |variadic_annotations|:
                    variadic_annotations.push(annotation) if annotation.owner == "__variadic"
                for declaration_index in 0..<top.count |fns, structs, generics, m, ctx, file, variadic_annotations, template_lines|:
                    declaration: Decl = top[declaration_index]
                    if declaration_is_module(declaration):
                        module_name: sview = module_name_of(declaration)
                        for nested_index in 0..<declaration_module_count(declaration) |fns, structs, generics, m, ctx, module_name, file, declaration, variadic_annotations, template_lines|:
                            nested: Decl = declaration_module_at(declaration, nested_index)
                            # An `impl P for T:` inside a module is a Decl.Scoped, whose own
                            # function_name_of is "" -- so the guard below skipped it and every
                            # member went undeclared. The specialization then had no body to
                            # call and the whole generic declined.
                            #
                            # At top level this never showed: flatten_static_branches erases
                            # Scoped nodes from file.top_decls before this pass runs, so an
                            # impl's members arrive here as ordinary Decl.Func. A module's body
                            # is NOT flattened, so they stay nested.
                            #
                            # Gated on the `__impl_scope` annotation rather than descending into
                            # every Scoped: a static-if block is also Scoped, and declaring the
                            # functions of an untaken branch is exactly what flattening exists
                            # to prevent.
                            if nested is Decl.Scoped(impl_body, impl_line):
                                impl_is_conformance: mutable bool = false
                                for impl_annotation in file.enum_annotations |impl_is_conformance, impl_line|:
                                    impl_is_conformance <- true if impl_annotation.owner == "__impl_scope" and impl_annotation.line == impl_line.line
                                if impl_is_conformance:
                                    for impl_member_index in 0..<impl_body.count |fns, structs, generics, m, ctx, module_name, file, impl_body, variadic_annotations, template_lines|:
                                        impl_member: Decl = impl_body[impl_member_index]
                                        continue if function_name_of(impl_member) == ""
                                        continue if generic_declaration_line_present(template_lines, function_line_of(impl_member)) and not declaration_is_generated_typestate(file, function_name_of(impl_member), function_line_of(impl_member))
                                        impl_member_handle: LLVMValueRef? = declare_function(impl_member, "", file.error_set_func_lines, file.annotation_args, variadic_annotations, fns, structs, generics, m, ctx)
                                        if impl_member_handle is impl_member_ok:
                                            _ = impl_member_ok
                                        else:
                                            record_declined_function(function_name_of(impl_member), m, ctx)
                                handler_is_scoped: mutable bool = false
                                for handler_annotation in file.enum_annotations |handler_is_scoped, impl_line|:
                                    handler_is_scoped <- true if handler_annotation.owner == "__handler_scope" and handler_annotation.line == impl_line.line
                                if handler_is_scoped:
                                    for handler_member in impl_body |fns, structs, generics, m, ctx, module_name, file, variadic_annotations, template_lines|:
                                        continue if function_name_of(handler_member) == ""
                                        continue if generic_declaration_line_present(template_lines, function_line_of(handler_member)) and not declaration_is_generated_typestate(file, function_name_of(handler_member), function_line_of(handler_member))
                                        handler_member_handle: LLVMValueRef? = declare_function(handler_member, module_name, file.error_set_func_lines, file.annotation_args, variadic_annotations, fns, structs, generics, m, ctx)
                                        if handler_member_handle is handler_member_ok:
                                            _ = handler_member_ok
                                        else:
                                            record_declined_function(function_name_of(handler_member), m, ctx)
                                continue
                            continue if function_name_of(nested) == ""
                            continue if generic_declaration_line_present(template_lines, function_line_of(nested)) and not declaration_is_generated_typestate(file, function_name_of(nested), function_line_of(nested))
                            nested_handle: LLVMValueRef? = declare_function(nested, module_name, file.error_set_func_lines, file.annotation_args, variadic_annotations, fns, structs, generics, m, ctx)
                            if nested_handle is nested_ok:
                                _ = nested_ok
                            else:
                                record_declined_function(function_name_of(nested), m, ctx)
                        continue
                    if declaration_is_extern(declaration):
                        _ = declare_extern(declaration, file.extern_params, file.extern_global_type_names, file.extern_global_type_exprs, file.annotation_args, file.enum_annotations, extern_return_is_pointer(file.enum_annotations, declaration_extern_name(declaration)), fns, structs, m, ctx)
                        continue
                    continue if function_name_of(declaration) == ""
                    continue if function_is_lemma(file.enum_annotations, function_name_of(declaration))
                    continue if generic_declaration_line_present(template_lines, function_line_of(declaration)) and not declaration_is_generated_typestate(file, function_name_of(declaration), function_line_of(declaration))
                    declared_handle: LLVMValueRef? = declare_function(declaration, "", file.error_set_func_lines, file.annotation_args, variadic_annotations, fns, structs, generics, m, ctx)
                    if declared_handle is declared_ok:
                        _ = declared_ok
                    else:
                        record_declined_function(function_name_of(declaration), m, ctx) if function_name_of(declaration) != ""




        def emit_module_bodies(file: Ast::File&, top: darray[Decl], fns: mutable FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: mutable Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef, main_ok: mutable bool&, dangling: mutable darray[LLVMValueRef]&, force_program: bool) -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                emitted_count: mutable i64 = 0
                # Whether this module is a PROGRAM. Read from the declare pass's FnTable rather than
                # threaded through a parameter, so no signature changes and no region reparameterizing.
                module_has_main: bool = force_program or function_index_of(fns, "", "main") >= 0
                # The stage1 test runner uses a C dispatch shim instead of a source-level `main`.
                # Keep program-only runtime stripping and dangling-decline checking above, but
                # leave user functions externally visible so the shim can call them by name.
                # Normal program emission still gives its private functions internal linkage.
                linkage_as_program: bool = module_has_main and not force_program
                source_defines_default_runtime: bool = declarations_define_default_runtime(top)
                for declaration_index in 0..<top.count |emitted_count, main_ok, module_has_main, dangling, source_defines_default_runtime, fns, structs, m, ctx, builder, file, generics, runtime|:
                    declaration: Decl = top[declaration_index]
                    if declaration_is_module(declaration):
                        module_name: sview = module_name_of(declaration)
                        for nested_decl_index in 0..<declaration_module_count(declaration) |emitted_count, dangling, module_has_main, source_defines_default_runtime, fns, structs, m, ctx, builder, module_name, file, generics, runtime, declaration|:
                            nested: Decl = declaration_module_at(declaration, nested_decl_index)
                            # The DEFINITION half of the impl-in-module fix. This walk skips a
                            # nameless declaration exactly as declare_module_functions did, so
                            # an `impl P for T:` inside a module got its members declared but
                            # never DEFINED -- a body-less handle the specialization then
                            # declined against.
                            #
                            # Three passes have to agree for a conformance in a module to work:
                            # record_impl_member_lines gives the method its `__impl__P__T__m`
                            # symbol, declare_module_functions creates the function, and this
                            # emits its body. Any one alone changes nothing observable, which
                            # is what made the first attempt look like a dead end.
                            if nested is Decl.Scoped(impl_body, impl_line):
                                impl_is_conformance: mutable bool = false
                                for impl_annotation in file.enum_annotations |impl_is_conformance, impl_line|:
                                    impl_is_conformance <- true if impl_annotation.owner == "__impl_scope" and impl_annotation.line == impl_line.line
                                if impl_is_conformance:
                                    for impl_body_index in 0..<impl_body.count |emitted_count, dangling, module_has_main, fns, structs, m, ctx, builder, module_name, file, generics, runtime, impl_body|:
                                        impl_member: Decl = impl_body[impl_body_index]
                                        impl_member_name: sview = function_name_of(impl_member)
                                        continue if impl_member_name == ""
                                        impl_member_slot: mutable i64 = function_index_of_line(fns, "", impl_member_name, function_line_of(impl_member))
                                        impl_member_slot <- function_index_of_arity(fns, "", impl_member_name, function_param_count_of(impl_member)) if impl_member_slot < 0
                                        impl_member_slot <- function_index_of(fns, "", impl_member_name) if impl_member_slot < 0
                                        continue if impl_member_slot < 0
                                        impl_member_emitted: bool = emit_function_body(impl_member, "", fns.handles[impl_member_slot.usize()], file.error_set_func_lines, fns, structs, generics, runtime, m, ctx, builder)
                                        emitted_count <- emitted_count + 1 if impl_member_emitted else emitted_count
                                        strip_function_body(fns.handles[impl_member_slot.usize()]) if not impl_member_emitted
                                        record_declined_body(impl_member_name, structs, m, ctx) if not impl_member_emitted
                                        note_dangling_decline(impl_member_name, fns.handles[impl_member_slot.usize()], module_has_main, dangling) if not impl_member_emitted
                                handler_is_scoped: mutable bool = false
                                for handler_annotation in file.enum_annotations |handler_is_scoped, impl_line|:
                                    handler_is_scoped <- true if handler_annotation.owner == "__handler_scope" and handler_annotation.line == impl_line.line
                                if handler_is_scoped:
                                    for handler_member in impl_body |emitted_count, dangling, module_has_main, fns, structs, m, ctx, builder, module_name, file, generics, runtime|:
                                        handler_member_name: sview = function_name_of(handler_member)
                                        continue if handler_member_name == ""
                                        continue if decl_line_is_generic(file, function_line_of(handler_member)) and not declaration_is_generated_typestate(file, handler_member_name, function_line_of(handler_member))
                                        handler_member_slot: mutable i64 = function_index_of_line(fns, module_name, handler_member_name, function_line_of(handler_member))
                                        handler_member_slot <- function_index_of_arity(fns, module_name, handler_member_name, function_param_count_of(handler_member)) if handler_member_slot < 0
                                        handler_member_slot <- function_index_of(fns, module_name, handler_member_name) if handler_member_slot < 0
                                        continue if handler_member_slot < 0
                                        handler_member_emitted: bool = emit_function_body(handler_member, module_name, fns.handles[handler_member_slot.usize()], file.error_set_func_lines, fns, structs, generics, runtime, m, ctx, builder)
                                        emitted_count <- emitted_count + 1 if handler_member_emitted else emitted_count
                                        strip_function_body(fns.handles[handler_member_slot.usize()]) if not handler_member_emitted
                                        record_declined_body(handler_member_name, structs, m, ctx) if not handler_member_emitted
                                        note_dangling_decline(handler_member_name, fns.handles[handler_member_slot.usize()], module_has_main, dangling) if not handler_member_emitted
                                continue
                            nested_name: sview = function_name_of(nested)
                            continue if nested_name == ""
                            continue if decl_line_is_generic(file, function_line_of(nested)) and not declaration_is_generated_typestate(file, function_name_of(nested), function_line_of(nested))
                            nested_index: mutable i64 = function_index_of_line(fns, module_name, nested_name, function_line_of(nested))
                            nested_index <- function_index_of_arity(fns, module_name, nested_name, function_param_count_of(nested)) if nested_index < 0
                            nested_index <- function_index_of(fns, module_name, nested_name) if nested_index < 0
                            continue if nested_index < 0
                            if runtime_external_only(nested_name) and module_has_main and not source_defines_default_runtime:
                                strip_function_body(fns.handles[nested_index.usize()])
                                continue
                            nested_emitted: bool = emit_function_body(nested, module_name, fns.handles[nested_index.usize()], file.error_set_func_lines, fns, structs, generics, runtime, m, ctx, builder)
                            emitted_count <- emitted_count + 1 if nested_emitted else emitted_count
                            strip_function_body(fns.handles[nested_index.usize()]) if not nested_emitted
                            record_declined_body(nested_name, structs, m, ctx) if not nested_emitted
                            note_dangling_decline(nested_name, fns.handles[nested_index.usize()], module_has_main, dangling) if not nested_emitted
                            test_visible: bool = force_program and declaration_is_test(nested)
                            set_defined_function_linkage(nested_name, fns.handles[nested_index.usize()], linkage_as_program and not test_visible) if nested_emitted
                        continue
                    if declaration_is_extern(declaration):
                        export_name: sview = declaration_extern_name(declaration)
                        export_target: sview = export_target_of(file.enum_annotations, export_name)
                        if export_target != "":
                            export_index: i64 = function_index_of(fns, "", export_name)
                            # An export that resolves to NO FnTable entry was skipped in
                            # SILENCE — no wrapper emitted, no decline recorded — so the
                            # object simply lacked the exported symbol while the census
                            # counted the file as covered. `nm` on the two objects shows it:
                            # stage0 exports _vec2i_add and _vec2i_keep_left, stage1 exported
                            # neither. Report it, exactly as the declaration path below already
                            # does for the same blind spot.
                            record_declined_function(export_name, m, ctx) if export_index < 0
                            if export_index >= 0:
                                apply_export_target_decorators(top, export_target, file.annotation_args, fns.handles[export_index.usize()], ctx)
                                # A GENERIC target (`= keep_left[Vec[i32]]`) has no FnTable row:
                                # instantiate it first and wrap the instantiation's handle. The
                                # argument's head was recorded by the parser under 3900000060 and
                                # resolves the same way an export type alias does.
                                exported: mutable bool = false
                                generic_argument_name: mutable sview = ""
                                for generic_annotation in file.enum_annotations |generic_argument_name, export_name|:
                                    generic_argument_name <- generic_annotation.name if generic_annotation.owner == export_name and generic_annotation.line == 3900000060
                                if generic_argument_name != "":
                                    # The argument names a generic STRUCT (`Vec`); its sole
                                    # ready instantiation is the type to specialize on.
                                    generic_argument_type: ValueType = unique_instantiation_of(structs, generic_argument_name)
                                    if generic_argument_type.kind != TypeKind.Unmodeled:
                                        generic_target_args: mutable darray[ValueType] = [copied_type(generic_argument_type)]
                                        if instantiate_generic(export_target, generic_target_args, generics, structs, m, ctx) is generic_target_handle:
                                            exported <- emit_export_wrapper_to(export_name, generic_target_handle, false, fns.handles[export_index.usize()], fns, structs, runtime, m, ctx, builder)
                                exported <- emit_same_name_export(export_name, fns, structs, runtime, m, ctx, builder) if not exported and export_target == export_name
                                exported <- emit_export_wrapper(export_name, export_target, fns.handles[export_index.usize()], fns, structs, runtime, m, ctx, builder) if not exported and export_target != export_name
                                structs.declined_export_names.push(export_name) if not exported
                                emitted_count <- emitted_count + 1 if exported else emitted_count
                                strip_function_body(fns.handles[export_index.usize()]) if not exported
                                record_declined_function(export_name, m, ctx) if not exported
                        continue
                    declaration_name: sview = function_name_of(declaration)
                    continue if declaration_name == ""
                    # Ghost code: no body, and no decline either — an erased lemma is not a
                    # function stage1 failed to lower.
                    continue if function_is_lemma(file.enum_annotations, declaration_name)
                    continue if decl_line_is_generic(file, function_line_of(declaration)) and not declaration_is_generated_typestate(file, function_name_of(declaration), function_line_of(declaration))
                    handle_index: mutable i64 = function_index_of_line(fns, "", declaration_name, function_line_of(declaration))
                    handle_index <- function_index_of_arity(fns, "", declaration_name, function_param_count_of(declaration)) if handle_index < 0
                    handle_index <- function_index_of(fns, "", declaration_name) if handle_index < 0
                    # A declaration that resolves to NO FnTable entry was skipped silently: no body
                    # emitted and no decline recorded, so it fails at LINK with an undefined symbol
                    # while the census shows nothing — the same blind spot the instantiation drain
                    # below had. Report it, so a registration failure is visible as a DROP rather
                    # than as a mystery undefined symbol.
                    if handle_index < 0:
                        record_declined_function(declaration_name, m, ctx)
                        continue
                    # In a LIBRARY this module IS the authoritative implementation, so the body
                    # must be kept — stripping it is only right for a program, where the linked
                    # runtime object provides it.
                    # An explicitly included default runtime otherwise creates
                    # private callback bodies that capture every instrumented
                    # call before the linked profiler can observe it. Keep the
                    # authoritative uninstrumented runtime/collector ABI external.
                    if runtime.trace_enabled and module_has_main and source_defines_default_runtime and name_is_trace_callback(declaration_name):
                        strip_function_body(fns.handles[handle_index.usize()])
                        LLVMSetLinkage(fns.handles[handle_index.usize()], TRACE_CALLBACK_EXTERNAL_LINKAGE)
                        continue
                    if runtime_external_only(declaration_name) and module_has_main and not source_defines_default_runtime:
                        strip_function_body(fns.handles[handle_index.usize()])
                        continue
                    emitted: bool = emit_function_body(declaration, "", fns.handles[handle_index.usize()], file.error_set_func_lines, fns, structs, generics, runtime, m, ctx, builder)
                    emitted_count <- emitted_count + 1 if emitted else emitted_count
                    strip_function_body(fns.handles[handle_index.usize()]) if not emitted
                    record_declined_body(declaration_name, structs, m, ctx) if not emitted
                    note_dangling_decline(declaration_name, fns.handles[handle_index.usize()], module_has_main, dangling) if not emitted
                    test_visible: bool = force_program and declaration_is_test(declaration)
                    set_defined_function_linkage(declaration_name, fns.handles[handle_index.usize()], linkage_as_program and not test_visible) if emitted
                    main_ok <- true if emitted and declaration_name == "main"
                drained: mutable usize = 0
                while drained < generics.pending_bases.count |drained, generics, fns, structs, runtime, m, ctx, builder, emitted_count, dangling, module_has_main|:
                    if emit_instantiation_body(drained, generics, fns, structs, runtime, m, ctx, builder):
                        emitted_count <- emitted_count + 1
                    else:
                        strip_function_body(generics.pending_handles[drained])
                        # Report it, exactly as the top-level path above does. A declined
                        # INSTANTIATION was stripped SILENTLY: its declaration survives, so the
                        # program fails at LINK with an undefined symbol while the DROP CENSUS
                        # shows nothing. That blind spot let a bad `submit` change look like a
                        # census win (see 7bb32a3) — the count improved while the object stopped
                        # linking. The census must see every function that fails to emit.
                        record_declined_function(generics.pending_bases[drained], m, ctx)
                        note_dangling_decline(generics.pending_bases[drained], generics.pending_handles[drained], module_has_main, dangling)
                    drained <- drained + 1
                # Python-module wrappers are emitted AFTER ordinary bodies.  This lets us verify
                # that a target survived lowering before publishing its stable native symbol,
                # while still allowing the metadata declaration to appear before the function in
                # source order.
                for pymodule_declaration in top |emitted_count, file, fns, m, ctx, builder|:
                    continue if not declaration_is_extern(pymodule_declaration)
                    pymodule_name: sview = declaration_extern_name(pymodule_declaration)
                    has_pymodule_marker: mutable bool = false
                    for pymodule_annotation in file.enum_annotations |has_pymodule_marker, pymodule_name|:
                        has_pymodule_marker <- true if pymodule_annotation.owner == pymodule_name and pymodule_annotation.name == "__export_pymodule"
                    continue if not has_pymodule_marker
                    for function_annotation in file.enum_annotations |emitted_count, file, fns, pymodule_name, m, ctx, builder|:
                        continue if function_annotation.name != "__pymodule_fn"
                        target_name: mutable sview = ""
                        for target_annotation in file.enum_annotations |target_name, function_annotation|:
                            target_name <- target_annotation.owner if target_annotation.name == "__pymodule_target_ref" and target_annotation.line == function_annotation.line
                        continue if target_name == ""
                        target_index: i64 = pymodule_target_index(fns, target_name)
                        if target_index >= 0 and LLVMGetFirstBasicBlock(fns.handles[target_index.usize()]) is target_body:
                            emitted_count <- emitted_count + 1 if emit_pymodule_symbol(pymodule_name, function_annotation.owner, target_name, fns, structs, m, ctx, builder)
                    for const_annotation in file.enum_annotations |emitted_count, file, pymodule_name, structs, m, ctx, builder|:
                        continue if const_annotation.name != "__pymodule_const"
                        target_name: mutable sview = ""
                        for target_annotation in file.enum_annotations |target_name, const_annotation|:
                            target_name <- target_annotation.owner if target_annotation.name == "__pymodule_const_target_ref" and target_annotation.line == const_annotation.line
                        continue if target_name == ""
                        pymodule_const_literal_text: mutable sview = ""
                        pymodule_const_found: mutable bool = false
                        pymodule_const_expression: Expr = const_global_expression(file.top_decls, target_name, pymodule_const_found)
                        if pymodule_const_found and pymodule_const_expression is Expr.StringLit(pymodule_const_string, _):
                            pymodule_const_literal_text <- pymodule_const_string
                        emitted_count <- emitted_count + 1 if emit_pymodule_global_symbol(pymodule_name, const_annotation.owner, target_name, pymodule_const_literal_text, structs, m, ctx, builder)
                # Direct same-name exports go external LAST: an implementation body emitted
                # after its export declaration would otherwise have reset the linkage.
                for direct_export_index in 0..<structs.direct_export_handles.count |structs|:
                    LLVMSetLinkage(structs.direct_export_handles[direct_export_index], 0)
                # An export the backend could not lower must not yield an object with the
                # symbol silently missing: report the unit as not linkable (the driver then
                # lists the declined names).
                emitted_count <- -1 if structs.declined_export_names.count > 0
                return emitted_count

include "./codegen_dwarf.elisa"
include "./codegen_target_machine.elisa"
include "./codegen_declines.elisa"
include "./codegen_module_shape.elisa"
