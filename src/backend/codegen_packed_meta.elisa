# Stage1 backend — packed-enum METADATA queries: variant ordinals, payload slots, instantiation arena facts.
# Part of `module Backend` (see codegen.elisa); split out to keep each file short.

extend Backend:
    private:


        # Declare an instantiation of a generic template, and queue its body.
        #
        # The SIGNATURE is built here — cheap, needs no builder, and yields the handle the
        # call site needs immediately. The BODY is queued because emitting it needs the
        # builder, which is currently positioned inside the caller.
        def instantiate_generic(base: sview, type_args: darray[ValueType]&, generics: mutable GenericTable&, structs: mutable StructTable&, m: LLVMModuleRef, ctx: LLVMContextRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            return instantiate_generic_with_error_family(base, type_args, "", generics, structs, m, ctx)




        # Errorset-aware generic instantiation. The ordinary type tuple and the concrete
        # error-family selector are independent dimensions: `[T, errorset R]` must not encode
        # R as a fake runtime type, but two different R bindings still need distinct LLVM
        # symbols, bodies, and cached handles.
        def instantiate_generic_with_error_family(base: sview, type_args: darray[ValueType]&, error_family: sview, generics: mutable GenericTable&, structs: mutable StructTable&, m: LLVMModuleRef, ctx: LLVMContextRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                # Direct-name entry (the common case): resolve the FIRST template with this name. For a
                # unique name that is the only template; an overloaded name is disambiguated only via
                # instantiate_generic_at (the UFCS path), which selects the slot by receiver type.
                index: i64 = generic_index_of(generics, base)
                null return if index < 0
                return instantiate_generic_at_with_error_family(index.usize(), type_args, error_family, generics, structs, m, ctx)




            # Number of generic templates sharing `name` (1 for a unique name, >1 for an overload set).
        def generic_slot_count(generics: GenericTable&, name: sview) -> usize can[Abort.Panic]:
            count: mutable usize = 0.usize()
            for index in 0..<generics.names.count |count, generics, name|:
                count <- count + 1.usize() if generics.names[index] == name
            return count




        # The instantiation cached for (SLOT, args), or null. Keyed on slot rather than base name so
        # two overloads of the same name with the same type args do not alias to one handle.
        def instantiation_of_slot(generics: GenericTable&, slot: usize, type_args: darray[ValueType]&) -> LLVMValueRef? can[Abort.Panic]:
            return instantiation_of_slot_with_error_family(generics, slot, type_args, "")




        def instantiation_of_slot_with_error_family(generics: GenericTable&, slot: usize, type_args: darray[ValueType]&, error_family: sview) -> LLVMValueRef? can[Abort.Panic]:
            for index in 0..<generics.inst_slots.count |generics, slot, type_args|:
                continue if generics.inst_slots[index] != slot
                continue if generics.inst_arg_count[index] != type_args.count
                astart: usize = generics.inst_arg_start[index]
                matched: mutable bool = true
                for k in 0..<type_args.count |generics, matched, astart, type_args|:
                    stored: ValueType = generics.inst_args[astart + k]
                    matched <- false if not value_type_identity_equal(stored, type_args[k])
                matched <- false if index >= generics.inst_error_families.count or generics.inst_error_families[index] != error_family
                generics.inst_handles[index] return if matched
            return null




        # Instantiate template SLOT for `type_args` (declaring the signature + queuing the body).
        # instantiate_generic delegates here after resolving the slot; the UFCS path calls it with an
        # overload-selected slot. The mangled name gets a slot suffix ONLY for overloaded names, so a
        # unique name's instantiation keeps its exact current symbol.
        def instantiate_generic_at(slot: usize, type_args: darray[ValueType]&, generics: mutable GenericTable&, structs: mutable StructTable&, m: LLVMModuleRef, ctx: LLVMContextRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            return instantiate_generic_at_with_error_family(slot, type_args, "", generics, structs, m, ctx)




        def instantiate_generic_at_with_error_family(slot: usize, type_args: darray[ValueType]&, error_family: sview, generics: mutable GenericTable&, structs: mutable StructTable&, m: LLVMModuleRef, ctx: LLVMContextRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            null return if slot >= generics.names.count
            base: sview = generics.names[slot]
            required_error_param: sview = generic_error_param_at(generics, slot)
            # An errorset-param template is never allowed to fall back to its unspecialized
            # base symbol. That was the exact ABI bug this layer fixes.
            null return if required_error_param != "" and error_family == ""
            if instantiation_of_slot_with_error_family(generics, slot, type_args, error_family) is already_declared:
                return already_declared
            # The call must supply exactly one argument per type parameter.
            null return if generics.param_count[slot] != type_args.count

            match generics.decls[slot]:
                Decl.Func(function_name, params, return_type_opt, body, effects, decorators, line):
                    # Bind every K/T for the duration of resolving this signature.
                    bound: usize = push_type_bindings(generics, structs, slot, type_args)
                    error_bound: usize = push_error_family_binding(generics, structs, slot, error_family)
                    # A MISSING return annotation is `void` (std helpers omit `-> void`).
                    return_value_type: mutable ValueType = ValueType{kind: TypeKind.Void, bits: 0}
                    if return_type_opt is return_type:
                        return_value_type <- annotation_value_type(return_type, structs)
                    llvm_params: mutable darray[LLVMTypeRef] = []
                    resolved_param_types: mutable darray[ValueType] = []
                    declined: mutable bool = false
                    for parameter in params |llvm_params, resolved_param_types, declined, structs, ctx|:
                        parameter_type: ValueType = parameter_value_type(parameter.type_expression, structs)
                        resolved_param_types.push(copied_type(parameter_type))
                        if parameter_type.kind == TypeKind.Unmodeled:
                            declined <- true
                        elif value_type_uses_indirect_aggregate(parameter_type, structs, ctx):
                            llvm_params.push(LLVMPointerTypeInContext(ctx, 0))
                        else:
                            llvm_params.push(llvm_type_of(parameter_type, structs, ctx))

                    # The arena/error ABI must match emit_function_body's param layout for the
                    # instantiation body: `[out-param if error], <declared params>, [arena if
                    # the signature grows a container]`, and an error fn returns i32. Large
                    # aggregate results use the same leading sret slot as ordinary functions;
                    # omitting it here leaves the handle with an aggregate return type while
                    # emit_function_body treats param 0 as the destination and returns void.
                    instantiation_is_error: bool = generics.is_error[slot]
                    instantiation_sret: bool = not instantiation_is_error and value_type_uses_sret(return_value_type, structs, ctx)
                    instantiation_needs_arena: bool = signature_needs_arena(params, return_value_type, structs)
                    # The hidden STORE slot, the same predicate declare_function_from_types
                    # applies to an ordinary function. A generic over a store-backed handle
                    # (`def walk[V: Visitor](w: Widget)`) had no slot at all: its body then
                    # either declined every common-field read or, when the body's own
                    # constructors gave it an implicit LOCAL store, read the caller's handles
                    # against an empty store and segfaulted.
                    instantiation_needs_store: bool = params_include_packed_ast(resolved_param_types, structs) or type_is_or_contains_packed_ast(return_value_type, 0, structs)
                    instantiation_param_slots: mutable darray[i64] = []
                    instantiation_arena_count: usize = instantiation_arena_layout(base, params, body, line.line, instantiation_needs_arena, structs, instantiation_param_slots)
                    pop_error_family_bindings(structs, error_bound)
                    pop_type_bindings(structs, bound)
                    null return if declined or return_value_type.kind == TypeKind.Unmodeled

                    name_storage: mutable darray[u8] = []
                    mangled_slot_suffix: i64 = slot.i64() if generic_slot_count(generics, base) > 1.usize() else -1
                    mangled: mutable cstr = mangled_name_multi_into(base, type_args, mangled_slot_suffix, structs, name_storage)
                    if error_family != "":
                        name_storage <- name_storage.truncate(name_storage.count - 1)
                        for error_prefix_index in 0..<sview_len("__error_") |name_storage|:
                            name_storage.push(sview_at("__error_", error_prefix_index))
                        for error_family_index in 0..<sview_len(error_family) |name_storage, error_family|:
                            name_storage.push(sview_at(error_family, error_family_index))
                        name_storage.push(0)
                        # The pushes above may have moved the buffer `mangled` pointed into.
                        mangled <- (&name_storage[0]).cast[cstr] can Unsafe.PointerCast
                    llvm_return: mutable LLVMTypeRef = llvm_type_of(return_value_type, structs, ctx)
                    llvm_return <- error_set_llvm_type(structs, error_family, ctx) if instantiation_is_error and error_set_has_payload(structs, error_family)
                    llvm_return <- LLVMInt32TypeInContext(ctx) if instantiation_is_error and not error_set_has_payload(structs, error_family)
                    llvm_return <- LLVMVoidTypeInContext(ctx) if instantiation_sret
                    full_params: mutable darray[LLVMTypeRef] = []
                    full_params.push(LLVMPointerTypeInContext(ctx, 0)) if instantiation_is_error
                    full_params.push(LLVMPointerTypeInContext(ctx, 0)) if instantiation_sret
                    full_params.extend(llvm_params)
                    full_params.push(llvm_type_of(ValueType{kind: TypeKind.PackedStore, bits: 0}, structs, ctx)) if instantiation_needs_store
                    for _ in 0..<instantiation_arena_count |full_params, ctx|:
                        full_params.push(LLVMPointerTypeInContext(ctx, 0))
                    fn_type: mutable LLVMTypeRef = LLVMFunctionType(llvm_return, null, 0, 0)
                    if full_params.count != 0:
                        params_pointer: void& = (&full_params[0]).cast[void&] can Unsafe.PointerCast
                        fn_type <- LLVMFunctionType(llvm_return, params_pointer, full_params.count.u32(), 0)
                    handle: LLVMValueRef = LLVMAddFunction(m, mangled, fn_type)
                    add_type_parameter_attribute(handle, 1, "sret", llvm_type_of(return_value_type, structs, ctx), ctx) if instantiation_sret
                    inst_arg_start: usize = generics.inst_args.count
                    for argument in type_args |generics|:
                        generics.inst_args <- generics.inst_args.push(copied_type(argument))
                    generics.inst_bases <- generics.inst_bases.push(base)
                    generics.inst_arg_start <- generics.inst_arg_start.push(inst_arg_start)
                    generics.inst_arg_count <- generics.inst_arg_count.push(type_args.count)
                    generics.inst_handles <- generics.inst_handles.push(handle)
                    generics.inst_slots <- generics.inst_slots.push(slot)
                    generics.inst_error_families <- generics.inst_error_families.push(error_family)
                    # The ABI fact this signature was BUILT with. Call sites read it back rather
                    # than recomputing (see GenericTable.inst_needs_arena).
                    generics.inst_needs_arena <- generics.inst_needs_arena.push(instantiation_arena_count > 0)
                    generics.inst_arena_counts <- generics.inst_arena_counts.push(instantiation_arena_count)
                    generics.inst_arena_param_start <- generics.inst_arena_param_start.push(generics.inst_arena_param_slots.count)
                    generics.inst_arena_param_counts <- generics.inst_arena_param_counts.push(instantiation_param_slots.count)
                    for instantiation_param_slot in instantiation_param_slots |generics|:
                        generics.inst_arena_param_slots <- generics.inst_arena_param_slots.push(instantiation_param_slot)
                    generics.inst_needs_store <- generics.inst_needs_store.push(instantiation_needs_store)
                    pending_arg_start: usize = generics.pending_args.count
                    for argument in type_args |generics|:
                        generics.pending_args <- generics.pending_args.push(copied_type(argument))
                    generics.pending_bases <- generics.pending_bases.push(base)
                    generics.pending_arg_start <- generics.pending_arg_start.push(pending_arg_start)
                    generics.pending_arg_count <- generics.pending_arg_count.push(type_args.count)
                    generics.pending_handles <- generics.pending_handles.push(handle)
                    generics.pending_slots <- generics.pending_slots.push(slot)
                    generics.pending_error_families <- generics.pending_error_families.push(error_family)
                    return handle
                _:
                    pass
            return null




        # The declared type of instantiation (base, args)'s parameter `position`, resolved
        # through the template's bindings.
        def instantiation_param_type(base: sview, type_args: darray[ValueType]&, position: usize, generics: mutable GenericTable&, structs: mutable StructTable&) -> ValueType can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic, Memory.Allocate:
                index: i64 = generic_index_of(generics, base)
                unmodeled_type() return if index < 0
                return instantiation_param_type_at(index.usize(), type_args, position, generics, structs)




        def instantiation_param_type_at(slot: usize, type_args: darray[ValueType]&, position: usize, generics: mutable GenericTable&, structs: mutable StructTable&) -> ValueType can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                unmodeled_type() return if slot >= generics.names.count
                match generics.decls[slot]:
                    Decl.Func(function_name, params, return_type_opt, body, effects, decorators, line):
                        unmodeled_type() return if position >= params.count
                        # POP is symmetric via pop_type_bindings — never `<- []`, which would rebind
                        # the caller's darray to callee-region memory AND wipe an outer instantiation's
                        # bindings (the historical nested-generic crash).
                        bound: usize = push_type_bindings(generics, structs, slot, type_args)
                        resolved: ValueType = parameter_value_type(params[position].type_expression, structs)
                        pop_type_bindings(structs, bound)
                        return resolved
                    _:
                        pass
                return unmodeled_type()




            # The IR name for a call's result. A VOID call must be UNNAMED — LLVM rejects
            # "instructions returning void cannot have a name".
        def call_result_name(return_type: ValueType, sret_return: bool) -> cstr:
            # A large aggregate is lowered as `void (ptr sret, ...)`, even though the
            # source-level return type is the aggregate. Passing "call" to LLVMBuildCall2
            # in that case creates a named void instruction. LLVM's textual printer emits
            # invalid IR (`%call = call void ...`), while the object path can silently assign
            # a different ABI register layout between compiler generations. Keep this rule
            # next to the source-level void rule so every call emitter uses the ABI return
            # shape rather than guessing from ValueType alone.
            return "" if sret_return or return_type.kind == TypeKind.Void else "call"



        # Emit a call to a generic function, instantiating on first use.
        # Whether a generic INSTANTIATION threads an arena — the same predicate
        # instantiate_generic uses to build the signature (so the call site matches). Computed
        # under the type-arg bindings so `wrap[i64] -> darray[i64]` (grows a darray) is detected.
        def instantiation_wants_arena(base: sview, type_args: darray[ValueType]&, generics: mutable GenericTable&, structs: mutable StructTable&) -> bool can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic, Memory.Allocate:
                arena_index: i64 = generic_index_of(generics, base)
                false return if arena_index < 0
                return instantiation_wants_arena_at(arena_index.usize(), type_args, generics, structs)




            # The arena flag RECORDED for the already-declared instantiation (slot, args), or -1 when
            # it has not been declared yet. Same key as instantiation_of_slot.
        def recorded_instantiation_arena(generics: GenericTable&, slot: usize, type_args: darray[ValueType]&) -> i64 can[Abort.Panic]:
            for index in 0..<generics.inst_slots.count |generics, slot, type_args|:
                continue if generics.inst_slots[index] != slot
                continue if generics.inst_arg_count[index] != type_args.count
                recorded_start: usize = generics.inst_arg_start[index]
                recorded_match: mutable bool = true
                for k in 0..<type_args.count |generics, recorded_match, recorded_start, type_args|:
                    recorded_arg: ValueType = generics.inst_args[recorded_start + k]
                    recorded_match <- false if not value_type_identity_equal(recorded_arg, type_args[k])
                continue if not recorded_match
                1 return if generics.inst_needs_arena[index]
                return 0
            return -1




        # Whether the DECLARED instantiation (base, args) carries the hidden store slot.
        # Only ever asked after instantiate_generic declared it, so the recorded flag is
        # the answer; an undeclared instantiation has no slot to fill.
        def instantiation_wants_store(base: sview, type_args: darray[ValueType]&, generics: GenericTable&) -> bool can[Abort.Panic]:
            store_slot: i64 = generic_index_of(generics, base)
            false return if store_slot < 0
            return instantiation_wants_store_at(store_slot.usize(), type_args, generics)




        def instantiation_wants_store_at(store_slot: usize, type_args: darray[ValueType]&, generics: GenericTable&) -> bool can[Abort.Panic]:
            false return if store_slot >= generics.names.count
            for index in 0..<generics.inst_slots.count |generics, store_slot, type_args|:
                continue if generics.inst_slots[index] != store_slot
                continue if generics.inst_arg_count[index] != type_args.count
                store_start: usize = generics.inst_arg_start[index]
                store_match: mutable bool = true
                for k in 0..<type_args.count |generics, store_match, store_start, type_args|:
                    store_arg: ValueType = generics.inst_args[store_start + k]
                    store_match <- false if not value_type_identity_equal(store_arg, type_args[k])
                continue if not store_match
                return index < generics.inst_needs_store.count and generics.inst_needs_store[index]
            return false




        # The store a call site hands to a store-carrying instantiation: the ambient one.
        # A caller with no ambient store has nothing to pass, and the call declines --
        # the same rule emit_direct_call_indexed applies to an ordinary store function.
        def call_site_store(runtime: Runtime&) -> LLVMValueRef? can[Abort.Panic]:
            null return if runtime.active_store_enum < 0
            return runtime.active_store




        # The hidden-arena layout of a generic instantiation, in the ORDINARY function order
        # (emit_direct_call_indexed): one slot per reference parameter the body grows or
        # stores into, then the return slot when the result lives in the caller's region.
        # Same body facts as signature_arena_count, which emit_function_body used to recompute
        # while the declaration pushed only the return slot -- the body then read
        # LLVMGetParam past the signature's end and the verifier segfaulted on any generic
        # that grows a reference parameter (stage0 declares fill2__i64(a, b, ..., ptr, ptr)).
        # Must be asked under the instantiation's type bindings. The std collection helpers
        # take their Arena explicitly and get no parameter slots.
        def instantiation_arena_layout(base: sview, params: darray[ParamDecl]&, body: darray[Stmt], line: u32, returns_region: bool, structs: mutable StructTable&, param_slots: mutable darray[i64]&) -> usize can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            flags: mutable darray[bool] = []
            if not generic_helper_uses_explicit_allocator(base):
                region_flags_for_function(params, body, line, structs, flags)
            count: mutable usize = 0
            for parameter_index in 0..<params.count |flags, count, param_slots|:
                if parameter_index < flags.count and flags[parameter_index]:
                    param_slots.push(count.i64())
                    count <- count + 1
                else:
                    param_slots.push(-1)
            return count + (1 if returns_region else 0)




        # The row of the already-declared instantiation (slot, args), or -1.
        def recorded_instantiation_index(generics: GenericTable&, slot: usize, type_args: darray[ValueType]&) -> i64 can[Abort.Panic]:
            for index in 0..<generics.inst_slots.count |generics, slot, type_args|:
                continue if generics.inst_slots[index] != slot
                continue if generics.inst_arg_count[index] != type_args.count
                row_start: usize = generics.inst_arg_start[index]
                row_match: mutable bool = true
                for k in 0..<type_args.count |generics, row_match, row_start, type_args|:
                    row_match <- false if not value_type_identity_equal(generics.inst_args[row_start + k], type_args[k])
                continue if not row_match
                return index.i64()
            return -1




        # The row of the instantiation whose LLVM function IS `handle`, or -1 (an ordinary
        # function). emit_function_body reads its arena layout back through this.
        def instantiation_index_of_handle(generics: GenericTable&, handle: LLVMValueRef) -> i64 can[Abort.Panic]:
            for index in 0..<generics.inst_handles.count |generics, handle|:
                return index.i64() if generics.inst_handles[index] == handle
            return -1




        # How many hidden arena slots a call to the instantiation (slot, args) passes.
        def instantiation_arena_count_at(count_slot: usize, type_args: darray[ValueType]&, generics: mutable GenericTable&, structs: mutable StructTable&) -> usize can[Abort.Panic, Memory.Allocate]:
            row: i64 = recorded_instantiation_index(generics, count_slot, type_args)
            if row >= 0 and row.usize() < generics.inst_arena_counts.count:
                return generics.inst_arena_counts[row.usize()]
            return 1 if instantiation_wants_arena_at(count_slot, type_args, generics, structs) else 0




        # Push the hidden arenas of a call to a generic instantiation, in its RECORDED layout.
        # `sources` holds the source expression bound to each declared parameter, positionally
        # (Expr.Invalid for a defaulted one). A grown reference parameter gets the arena of
        # the storage its argument names -- the rule emit_direct_call_indexed applies to an
        # ordinary call -- and every other slot the call-site arena. False = decline: the
        # argument's owner has no region to grow into (the null no-region placeholder).
        def push_instantiation_arenas(argument_values: mutable darray[LLVMValueRef]&, arena_slot: usize, type_args: darray[ValueType]&, sources: darray[Expr]&, arguments: darray[Expr]&, local_scope: mutable Scope&, runtime: Runtime&, generics: mutable GenericTable&, structs: mutable StructTable&) -> bool can[Abort.Panic, Memory.Allocate]:
            row: i64 = recorded_instantiation_index(generics, arena_slot, type_args)
            if row < 0 or row.usize() >= generics.inst_arena_counts.count:
                argument_values.push(call_site_arena(arguments, local_scope, runtime, structs)) if instantiation_wants_arena_at(arena_slot, type_args, generics, structs)
                return true
            arena_count: usize = generics.inst_arena_counts[row.usize()]
            true return if arena_count == 0
            # Lay the slots out in place (every one OUR arena first), then overwrite each
            # grown reference's slot. Staging them in a local darray and extending would copy
            # pointers out of this call's auto region, which the escape check rejects.
            fallback: LLVMValueRef = call_site_arena(arguments, local_scope, runtime, structs)
            slot_base: usize = argument_values.count
            for _ in 0..<arena_count |argument_values, fallback|:
                argument_values.push(fallback)
            param_start: usize = generics.inst_arena_param_start[row.usize()]
            for position in 0..<generics.inst_arena_param_counts[row.usize()] |argument_values, slot_base, generics, param_start, sources, local_scope, runtime|:
                parameter_slot: i64 = generics.inst_arena_param_slots[param_start + position]
                continue if parameter_slot < 0 or position >= sources.count
                continue if sources[position] is Expr.Invalid
                direct: LLVMValueRef = growth_arena_for(sources[position], local_scope, runtime)
                false return if llvm_value_is_null(direct)
                argument_values[slot_base + parameter_slot.usize()] <- direct
            return true




        # push_instantiation_arenas for a call that names the generic by its base and passes
        # its arguments positionally (the error-call lowerings).
        def push_named_instantiation_arenas(argument_values: mutable darray[LLVMValueRef]&, base: sview, type_args: darray[ValueType]&, arguments: darray[Expr]&, local_scope: mutable Scope&, runtime: Runtime&, generics: mutable GenericTable&, structs: mutable StructTable&) -> bool can[Abort.Panic, Memory.Allocate]:
            named_slot: i64 = generic_index_of(generics, base)
            true return if named_slot < 0
            return push_instantiation_arenas(argument_values, named_slot.usize(), type_args, arguments, arguments, local_scope, runtime, generics, structs)




        def instantiation_wants_arena_at(arena_slot: usize, type_args: darray[ValueType]&, generics: mutable GenericTable&, structs: mutable StructTable&) -> bool can[Abort.Panic, Memory.Allocate]:
            false return if arena_slot >= generics.names.count
            # A DECLARED instantiation answers from its recorded signature. Recomputing here
            # would ask signature_needs_arena a second time, in a different registration state,
            # and a different answer is an ABI mismatch the linker cannot see.
            recorded: i64 = recorded_instantiation_arena(generics, arena_slot, type_args)
            true return if recorded == 1
            false return if recorded == 0
            match generics.decls[arena_slot]:
                Decl.Func(arena_fn_name, arena_params, arena_ret_opt, arena_body, arena_effects, arena_decs, arena_line):
                    arena_bound: usize = push_type_bindings(generics, structs, arena_slot, type_args)
                    arena_ret_type: mutable ValueType = ValueType{kind: TypeKind.Void, bits: 0}
                    if arena_ret_opt is arena_ret:
                        arena_ret_type <- annotation_value_type(arena_ret, structs)
                    arena_wanted: bool = signature_needs_arena(arena_params, arena_ret_type, structs)
                    pop_type_bindings(structs, arena_bound)
                    return arena_wanted
                _:
                    pass
            return false

include "./codegen_variant_paths.elisa"
include "./codegen_match_arm_facts.elisa"
