# Stage1 backend — EXTERN declarations: libc-shaped symbols, LLVM intrinsics, `@c_opaque`
# inline storage, typed non-call externs, and the pointer/optional return rules that follow
# from a declaration with no body. Part of `module Backend` (see codegen.elisa).

extend Backend:
    private:


        # `extern strlen(s: cstr) -> usize` -> `declare i64 @strlen(ptr)`. No body: the
        # symbol is resolved at link time.
        #
        # Param and return types are bare NAMES here, not Exprs: the params live in the
        # `File.extern_params` SIDE TABLE (`param_start`/`arity` index it) and the return
        # type is `return_type_name` on the node. So both resolve through
        # scalar_type_of_name rather than annotation_value_type -- there is no type
        # expression to walk. An empty return name is `-> void`.
        # Whether the parser side-tabled this extern's `-> T` clause as a POINTER
        # return (`__extern_return_ptr` owner, extern name in `name`). The node
        # signature keeps only the bare head name, so this is the only channel.
        def extern_return_is_pointer(annotations: darray[Ast::EnumAnnotation]&, extern_name: sview) -> bool can[Abort.Panic]:
            return (annotation_pair_find(annotations, "__extern_return_ptr", extern_name, -1) can Global{Read,Write}) >= 0



        # The companion of extern_return_is_pointer for `-> heap T&?` (see FnTable.returns_nullable).
        def extern_return_is_optional(annotations: darray[Ast::EnumAnnotation]&, extern_name: sview) -> bool can[Abort.Panic]:
            return (annotation_pair_find(annotations, "__extern_return_optional", extern_name, -1) can Global{Read,Write}) >= 0



        # `@link_name(c_symbol)` changes only the linker spelling. The source-level name
        # remains the key used by parser/semantic tables and call sites.
        # stage0 applyLibcNoreturnAttr (llvm_libc_noreturn.go): the C-standard `_Noreturn`
        # functions, matched on the LINKER symbol and the exact lowered C signature --
        # `void(i32)` for exit/_exit/_Exit/quick_exit, `void()` for abort. Their names are
        # reserved by C, so such an extern IS the libc function and noreturn is a sound fact.
        # UNTESTED in stage1 (unseedable).
        def libc_noreturn_extern(linker_name: sview, fn_type: LLVMTypeRef) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            wants_int: bool = linker_name == "exit" or linker_name == "_exit" or linker_name == "_Exit" or linker_name == "quick_exit"
            return false if not wants_int and linker_name != "abort"
            return false if LLVMIsFunctionVarArg(fn_type) != 0
            return false if LLVMGetTypeKind(LLVMGetReturnType(fn_type)) != 0
            param_count: u32 = LLVMCountParamTypes(fn_type)
            return param_count == 0 if not wants_int
            return false if param_count != 1
            params: mutable darray[LLVMTypeRef] = [LLVMGetReturnType(fn_type)]
            params_pointer: void& = (&params[0]).cast[void&] can Unsafe.PointerCast
            LLVMGetParamTypes(fn_type, params_pointer)
            return LLVMGetTypeKind(params[0]) == 8 and LLVMGetIntTypeWidth(params[0]) == 32

        def extern_link_name(decorators: darray[Ast::Annotation]&, annotation_args: darray[sview]&, source_name: sview) -> sview can[Abort.Panic]:
            for decorator in decorators |annotation_args, source_name|:
                if decorator.name == "link_name" and decorator.arg_count > 0 and decorator.arg_start.usize() < annotation_args.count:
                    return annotation_args[decorator.arg_start.usize()]
            return source_name



        # The host byte size of an INLINE-storage `@c_opaque(header, ctype)` extern type, or -1
        # if it has no @c_opaque or names a ctype whose size this backend does not know. A bare
        # `@c_opaque` extern is otherwise modeled as an 8-byte pointer HANDLE, which is WRONG for
        # a value you allocate inline and pass by address (`m: PthreadMutexT = zeroed; ...(&m)`):
        # the C fn writes the FULL struct, so an 8-byte slot corrupts memory and, embedded in a
        # struct, silently races. stage1 targets only the host triple (cf register_target_consts),
        # so a host size table is exact. ctype is the SECOND @c_opaque arg (arg 0 = header).
        # macOS-arm64 sizeof, cross-checked by the C sizeof probe in thread_real_smoke.
        def c_opaque_host_size(decorators: darray[Ast::Annotation]&, annotation_args: darray[sview]&) -> i64 can[Abort.Panic]:
            for decorator in decorators |annotation_args|:
                if decorator.name == "c_opaque" and decorator.arg_count >= 2 and decorator.arg_start.usize() + 1 < annotation_args.count:
                    ctype: sview = annotation_args[decorator.arg_start.usize() + 1]
                    known_size: i64 = BackendOpaqueTypeSize::c_opaque_host_size_for_type(ctype)
                    return known_size if known_size >= 0
            return -1




        # Typed non-call externs retain only a bare head in Decl.Extern. Resolve the full
        # annotation captured by the parser when one is available, so generic containers and
        # nested fixed arrays get the same ValueType as an ordinary declaration.
        def extern_global_value_type(name: sview, names: darray[sview]&, expressions: darray[Expr]&, structs: mutable StructTable&) -> ValueType can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            for index in 0..<names.count |name, expressions, structs|:
                if names[index] == name and index < expressions.count:
                    return annotation_value_type(expressions[index], structs)
            return unmodeled_type()



        # EARLY pass: register the `[size x i8]` alias for every inline-storage `@c_opaque` extern
        # BEFORE struct bodies resolve (set_struct_bodies_from_metadata), so a struct FIELD of the
        # opaque type gets its real size, not the 8-byte handle. Without this the alias is only
        # registered in the later declaration pass — after fields are sized — and a struct-embedded
        # mutex silently races. Recurses into modules. Idempotent: the declaration pass's
        # `alias_index_of < 0` guard then skips any name registered here.
        def register_one_opaque_extern(declaration: Decl, owner: sview, annotation_args: darray[sview]&, annotations: darray[Ast::EnumAnnotation]&, structs: mutable StructTable&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                if declaration is Decl.Extern(extern_name, param_start, arity, variadic, callable, return_type_name, decorators, extern_line):
                    return if:
                        callable or arity != 0 or return_type_name != ""
                        alias_index_of(structs, extern_name) >= 0
                    opaque_size: i64 = c_opaque_host_size(decorators, annotation_args)
                    if opaque_size <= 0:
                        # A bare `extern Val` is an opaque pointer handle. Register its CStr
                        # bits-1 alias HERE too, before struct bodies are sized: otherwise a
                        # struct field `darray[Val]` sizes against an unknown element and every
                        # function touching it is declined. `export type` / `export pymodule`
                        # rows are not handles (declare_extern skips them the same way).
                        for marker in annotations |extern_name|:
                            return if marker.owner == extern_name and (marker.name == "__export_type" or marker.name == "__export_pymodule")
                        structs.aliases.alias_names <- structs.aliases.alias_names.push(extern_name)
                        structs.aliases.alias_owners <- structs.aliases.alias_owners.push(owner)
                        structs.aliases.alias_types <- structs.aliases.alias_types.push(ValueType{kind: TypeKind.CStr, bits: 1})
                        return
                    structs.aliases.alias_names <- structs.aliases.alias_names.push(extern_name)
                    structs.aliases.alias_owners <- structs.aliases.alias_owners.push(owner)
                    structs.aliases.alias_types <- structs.aliases.alias_types.push(intern_array_type(ValueType{kind: TypeKind.Unsigned, bits: 8}, opaque_size.u32(), structs))



        def register_opaque_extern_aliases(top: darray[Decl]&, annotation_args: darray[sview]&, annotations: darray[Ast::EnumAnnotation]&, structs: mutable StructTable&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                for declaration in top |annotation_args, annotations, structs|:
                    if declaration_is_module(declaration):
                        for nested_index in 0..<declaration_module_count(declaration) |declaration, annotation_args, annotations, structs|:
                            register_one_opaque_extern(declaration_module_at(declaration, nested_index), module_name_of(declaration), annotation_args, annotations, structs)
                    else:
                        register_one_opaque_extern(declaration, "", annotation_args, annotations, structs)



        # Intrinsics are declarations owned by LLVM, not ordinary extern symbols. The
        # frontend stores the requested intrinsic name as the single @intrinsic argument;
        # retain the source name separately in FnTable so Elisa calls still resolve by it.
        def extern_intrinsic_name(decorators: darray[Ast::Annotation]&, annotation_args: darray[sview]&) -> sview can[Abort.Panic]:
            for decorator in decorators |annotation_args|:
                if decorator.name == "intrinsic" and decorator.arg_count > 0 and decorator.arg_start.usize() < annotation_args.count:
                    return annotation_args[decorator.arg_start.usize()]
            return sview("", 0, 0)




        # Overload types for an overloaded LLVM intrinsic: the shortest prefix of the
        # signature's distinct types (return first) whose instantiated intrinsic type is
        # exactly the extern's function type. Passing every parameter type mangled
        # `llvm.umax.i64.i64` (stage0 parity: resolveIntrinsicOverloadTypes).
        def intrinsic_overload_types(ctx: LLVMContextRef, id: u32, fn_type: LLVMTypeRef, llvm_return: LLVMTypeRef, params: darray[LLVMTypeRef]&, out: mutable darray[LLVMTypeRef]&) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Unsafe.RawExtern]:
            return false if LLVMIntrinsicIsOverloaded(id) == 0
            distinct: mutable darray[LLVMTypeRef] = []
            distinct.push(llvm_return) if llvm_return != LLVMVoidTypeInContext(ctx)
            for param in params |distinct|:
                seen: mutable bool = false
                for existing in distinct |seen, param|:
                    seen <- true if existing == param
                distinct.push(param) if not seen
            for k in 1..<distinct.count + 1 |distinct, out, ctx, id, fn_type|:
                candidate_pointer: void& = (&distinct[0]).cast[void&] can Unsafe.PointerCast
                if LLVMIntrinsicGetType(ctx, id, candidate_pointer, k) == fn_type:
                    out.clear()
                    for index in 0..<k |out, distinct|:
                        out.push(distinct[index])
                    return true
            return false

        # Elisa builtin intrinsics (`@intrinsic("elisa.…")`), synthesized as internal
        # always-inline helpers over i128 arithmetic (stage0 parity:
        # elisaBuiltinIntrinsicFunction). null for any other name.
        def elisa_builtin_intrinsic_function(m: LLVMModuleRef, ctx: LLVMContextRef, name: sview, name_cstr: cstr) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Unsafe.RawExtern]:
            is_mul_hi: bool = name == "elisa.mul_hi.u64"
            is_div_wide: bool = name == "elisa.div_wide.u64"
            to_bits: bool = name == "elisa.f64_to_bits"
            from_bits: bool = name == "elisa.f64_from_bits"
            return null if not is_mul_hi and not is_div_wide and not to_bits and not from_bits
            existing: LLVMValueRef? = LLVMGetNamedFunction(m, name_cstr)
            return existing if existing != null
            i64: LLVMTypeRef = LLVMInt64TypeInContext(ctx)
            if to_bits or from_bits:
                # f64 <-> u64 bit pattern: a register bitcast (stage0 parity).
                f64: LLVMTypeRef = LLVMDoubleTypeInContext(ctx)
                source: LLVMTypeRef = f64 if to_bits else i64
                target: LLVMTypeRef = i64 if to_bits else f64
                cast_params: mutable darray[LLVMTypeRef] = [source]
                cast_params_pointer: void& = (&cast_params[0]).cast[void&] can Unsafe.PointerCast
                cast_type: LLVMTypeRef = LLVMFunctionType(target, cast_params_pointer, 1, 0)
                cast_fn: LLVMValueRef = LLVMAddFunction(m, name_cstr, cast_type)
                LLVMSetLinkage(cast_fn, 8)
                add_function_attribute(cast_fn, "alwaysinline", ctx)
                cast_builder: LLVMBuilderRef = LLVMCreateBuilderInContext(ctx)
                LLVMPositionBuilderAtEnd(cast_builder, LLVMAppendBasicBlockInContext(ctx, cast_fn, "entry"))
                LLVMBuildRet(cast_builder, LLVMBuildBitCast(cast_builder, LLVMGetParam(cast_fn, 0), target, "bits"))
                LLVMDisposeBuilder(cast_builder)
                return cast_fn
            i128: LLVMTypeRef = LLVMInt128TypeInContext(ctx)
            params: mutable darray[LLVMTypeRef] = [i64, i64, i64]
            param_count: u32 = 2 if is_mul_hi else 3
            params_pointer: void& = (&params[0]).cast[void&] can Unsafe.PointerCast
            fn_type: LLVMTypeRef = LLVMFunctionType(i64, params_pointer, param_count, 0)
            fn: LLVMValueRef = LLVMAddFunction(m, name_cstr, fn_type)
            LLVMSetLinkage(fn, 8)
            add_function_attribute(fn, "alwaysinline", ctx)
            builder: LLVMBuilderRef = LLVMCreateBuilderInContext(ctx)
            LLVMPositionBuilderAtEnd(builder, LLVMAppendBasicBlockInContext(ctx, fn, "entry"))
            wide_64: LLVMValueRef = LLVMConstInt(i128, 64, 0)
            if is_mul_hi:
                left: LLVMValueRef = LLVMBuildZExt(builder, LLVMGetParam(fn, 0), i128, "a")
                right: LLVMValueRef = LLVMBuildZExt(builder, LLVMGetParam(fn, 1), i128, "b")
                product: LLVMValueRef = LLVMBuildNUWMul(builder, left, right, "p")
                LLVMBuildRet(builder, LLVMBuildTrunc(builder, LLVMBuildLShr(builder, product, wide_64, "hi"), i64, "r"))
            else:
                high: LLVMValueRef = LLVMBuildZExt(builder, LLVMGetParam(fn, 0), i128, "hi")
                low: LLVMValueRef = LLVMBuildZExt(builder, LLVMGetParam(fn, 1), i128, "lo")
                divisor: LLVMValueRef = LLVMBuildZExt(builder, LLVMGetParam(fn, 2), i128, "d")
                joined: LLVMValueRef = LLVMBuildOr(builder, LLVMBuildShl(builder, high, wide_64, "hs"), low, "n")
                LLVMBuildRet(builder, LLVMBuildTrunc(builder, LLVMBuildUDiv(builder, joined, divisor, "q"), i64, "r"))
            LLVMDisposeBuilder(builder)
            return fn

        def intrinsic_is_wasm_only(name: sview) -> bool can[Abort.Panic]:
            return sview_matches_prefix(name, "llvm.wasm.", 0, 10)


        # WebAssembly memory intrinsics have two function parameters (the memory
        # index and the page count), but LLVM overloads them only on the i32
        # result type. `LLVMGetIntrinsicDeclaration` takes overload types, not
        # the function's complete parameter list; passing both parameters makes
        # it manufacture the invalid `.i32.i32` suffix.
        def intrinsic_uses_return_overload(name: sview) -> bool can[Abort.Panic]:
            return sview_matches_prefix(name, "llvm.wasm.memory.grow", 0, 21) or sview_matches_prefix(name, "llvm.wasm.memory.size", 0, 21)




        # The export target of `export <name> as <target>`, or "" when `name` is not exported.
        #
        # The `__export_fn` MARKER must be present. Without that check any OTHER internal
        # annotation on the same owner reads as a target name: an `extern f(...) -> T error[E]`
        # carries `__error_return` on `f`, which made the export path fire on a plain extern,
        # try to build a wrapper for a target named "__error_return", fail, and record `f` as
        # DECLINED even though its declaration lowered correctly.
        # The recorded ELEMENT type of an extern's `-> darray[T]` return, keyed by the extern's
        # own line, or "".
        def resource_struct_declared_indexed(structs: StructTable&, annotations: darray[Ast::EnumAnnotation]&, type_name: sview) -> bool can[Abort.Panic]:
            return annotation_pair_present(structs, annotations, type_name, "__extern_resource")

        def extern_return_optional_at_line(annotations: darray[Ast::EnumAnnotation]&, extern_name: sview, line: u32) -> bool can[Abort.Panic]:
            row: mutable i64 = (annotation_pair_find(annotations, "__extern_return_optional", extern_name, -1) can Global{Read,Write})
            while row >= 0 |row, annotations, extern_name, line|:
                return true if annotations[row.usize()].line == line
                row <- (annotation_pair_find(annotations, "__extern_return_optional", extern_name, row) can Global{Read,Write})
            return false

        # 0 = not a resource return, 1 = owned `Name`, 2 = `Name?`.
        def extern_resource_return_kind(structs: StructTable&, annotations: darray[Ast::EnumAnnotation]&, extern_name: sview, return_type_name: sview, line: u32) -> u32 can[Abort.Panic]:
            return 0 if return_type_name == "" or not resource_struct_declared_indexed(structs, annotations, return_type_name)
            optional: mutable bool = false
            can Global{Read,Write}:
                optional <- extern_return_optional_at_line(annotations, extern_name, line)
            return 2 if optional else 1

        def extern_return_darray_element_of(annotations: darray[Ast::EnumAnnotation]&, line: u32) -> sview can[Abort.Panic]:
            for annotation in annotations |line|:
                return annotation.owner if annotation.name == "__extern_return_darray_elem" and annotation.line == line
            return ""




        # Resolve the element retained by the compact extern scanner. This is intentionally
        # name-based and small: the scanner only records the first application argument, while
        # ordinary declarations retain a full Expr. It covers the scalar/nominal names that can
        # cross the C boundary and lets `view[T]`/`darray[T]` use their normal interned ABI.
        def extern_element_value_type(element_name: sview, annotations: darray[Ast::EnumAnnotation]&, structs: mutable StructTable&) -> ValueType can[Abort.Panic, Memory.Allocate]:
            bound_element: ValueType = bound_type_of(structs, element_name)
            return bound_element if bound_element.kind != TypeKind.Unmodeled
            named_element: mutable ValueType = scalar_type_of_name(element_name, structs.target.target_pointer_bits)
            named_element <- ValueType{kind: TypeKind.CStr, bits: 1} if named_element.kind == TypeKind.Unmodeled and llvm_opaque_handle_name(element_name)
            if named_element.kind == TypeKind.Unmodeled:
                element_struct: i64 = struct_index_of(structs, element_name)
                named_element <- ValueType{kind: TypeKind.Struct, bits: element_struct.u32()} if element_struct >= 0
            if named_element.kind == TypeKind.Unmodeled:
                element_enum: i64 = enum_index_of(structs, element_name)
                named_element <- copied_type(structs.const_enums.enum_backings[element_enum.usize()]) if element_enum >= 0
            if named_element.kind == TypeKind.Unmodeled:
                named_element <- (export_alias_value_type(annotations, structs, element_name) can Global{Read,Write})
            return named_element
