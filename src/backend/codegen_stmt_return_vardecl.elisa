# Stage1 backend — `emit_statement`: `return` and local declarations.
# A group of the statement emitter's branches, called from codegen_statement.elisa.
# `handled` is set TRUE on entry and cleared only if no branch here matched, so a branch
# that DECLINES still stops the dispatch — exactly as it did when every branch shared one
# function body.

extend Backend:
    private:
        # A no-`else` `try` is represented by the semantic layer as the bare
        # error call. That is sufficient when the call is the whole initializer
        # or return operand, where the paths below have loop/region context. It
        # used to decline when the same call appeared directly inside another
        # call's argument list (`outer(try inner())`): emit_expression has no
        # control-flow context, so emit_direct_call could not propagate the
        # inner status and the enclosing function was reported as an unresolved
        # declaration. Materialize one such argument in a typed synthetic
        # local, then re-emit the outer statement through the normal path.
        #
        # Return values: 1 = rewritten, 0 = no direct nested try, -1 = a
        # nested form was found but could not be emitted. More than one nested
        # argument is declined until the synthetic-name allocator can preserve
        # each independent value; silently reusing a local would be unsound.
        def materialize_nested_try_argument(expression: Expr, rewritten: mutable Expr&, return_type: ValueType, local_scope: mutable Scope&, loops: mutable LoopStack&, regions: mutable RegionStack&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            # A first-class error union is also a valid call argument. Only an
            # error-returning function may use the bare-call representation for
            # a no-recovery `try`; a non-error caller must preserve `make()` as
            # the union value passed to `use(make())`.
            return 0 if not runtime.in_error_fn
            outer_callee: mutable Expr = Expr.Invalid
            outer_arguments: mutable darray[Expr] = []
            outer_names: mutable darray[sview @source] @source = []
            outer_line: mutable u32 = 0
            match expression:
                Expr.Call(call_callee, call_arguments, call_argument_names, call_line):
                    outer_callee <- call_callee
                    outer_arguments <- call_arguments
                    outer_names <- call_argument_names
                    outer_line <- call_line.line
                _:
                    return 0
            nested_index: mutable i64 = -1
            nested_count: mutable u32 = 0
            for candidate_index in 0..<outer_arguments.count |nested_index, nested_count, outer_arguments, fns, generics|:
                match outer_arguments[candidate_index]:
                    Expr.Call(callee: candidate_callee, _):
                        match candidate_callee:
                            Expr.Ident(candidate_name, candidate_name_line):
                                if error_callee_is(fns, structs, generics, candidate_name):
                                    nested_index <- candidate_index.i64()
                                    nested_count <- nested_count + 1
                            _:
                                pass
                    _:
                        pass
            return -1 if nested_count > 1
            return 0 if nested_index < 0
            nested_expression: Expr = outer_arguments[nested_index.usize()]
            match nested_expression:
                Expr.Call(nested_callee, nested_arguments, _, nested_line):
                    match nested_callee:
                        Expr.Ident(nested_name, nested_name_line):
                            nested_value_type: ValueType = error_callee_value_type(nested_name, nested_arguments, local_scope, fns, structs, generics)
                            return -1 if nested_value_type.kind == TypeKind.Unmodeled or nested_value_type.kind == TypeKind.Void
                            if (emit_propagating_try_value(nested_name, nested_arguments, null, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}) is nested_value:
                                nested_slot: LLVMValueRef = build_entry_alloca(builder, llvm_type_of(nested_value_type, structs, ctx), "__nested_try_arg")
                                _ = LLVMBuildStore(builder, nested_value, nested_slot)
                                declare_local(local_scope, "__nested_try_arg", nested_slot, nested_value_type)
                                rewritten_arguments: mutable darray[Expr] @source = []
                                rewrite_index: mutable usize = 0
                                for argument in outer_arguments |rewritten_arguments, nested_index, nested_line, rewrite_index|:
                                    rewritten_arguments.push(Expr.Ident("__nested_try_arg", nested_line)) if rewrite_index.i64() == nested_index
                                    rewritten_arguments.push(argument) if rewrite_index.i64() != nested_index
                                    rewrite_index <- rewrite_index + 1
                                rewritten <- Expr.Call(outer_callee, rewritten_arguments, outer_names, Ast::pos_at_line(outer_line))
                                return 1
                            return -1
                        _:
                            pass
                _:
                    pass
            return -1

        # Large internal aggregates use a leading sret destination and a void LLVM return.
        # Return sites are centralized here because returns can be introduced by ordinary
        # return, await/try lowering, optional propagation, and match rewrites.
        def emit_sret_return(value: LLVMValueRef, return_type: ValueType, runtime: Runtime&, structs: mutable StructTable&, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            return false if runtime.in_error_fn or not value_type_uses_sret(return_type, structs, ctx)
            function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
            destination: LLVMValueRef = LLVMGetParam(function, 0)
            _ = LLVMBuildStore(builder, value, destination)
            _ = LLVMBuildRetVoid(builder)
            return true


        # A place already contains the source bytes for a large aggregate. Copy it directly to
        # the caller's sret destination instead of first materializing a first-class aggregate;
        # the latter makes LLVM legalize a multi-kilobyte SSA value and can explode at codegen.
        # Memmove preserves the old load-then-store behavior even if a caller deliberately aliases
        # an input reference with the result destination.
        #
        # The copy is split from the terminator so a return site can copy BEFORE it runs deferred
        # actions and unwinds its regions: the place may live in storage the unwind frees (an
        # element of a darray backed by the function's auto region), and a memmove emitted after
        # arena_free reads freed memory.
        def emit_sret_copy_from_address(source: LLVMValueRef, return_type: ValueType, runtime: Runtime&, structs: mutable StructTable&, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
            destination: LLVMValueRef = runtime.error_out if runtime.in_error_fn else LLVMGetParam(function, 0)
            aggregate_llvm_type: LLVMTypeRef = llvm_type_of(return_type, structs, ctx)
            alignment: mutable u32 = LLVMABIAlignmentOfType(structs.target.target_data, aggregate_llvm_type)
            alignment <- 1 if alignment == 0
            size: LLVMValueRef = LLVMConstInt(LLVMInt64TypeInContext(ctx), LLVMABISizeOfType(structs.target.target_data, aggregate_llvm_type), 0)
            _ = LLVMBuildMemMove(builder, destination, alignment, source, alignment, size)


        def emit_sret_address_return_terminator(runtime: Runtime&, structs: mutable StructTable&, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            if runtime.in_error_fn:
                _ = LLVMBuildRet(builder, error_success_return_value(structs, runtime, ctx))
            else:
                _ = LLVMBuildRetVoid(builder)

include "./codegen_stmt_return_vardecl_emit.elisa"
