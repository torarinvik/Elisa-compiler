# Stage1 backend — `emit_statement`: `return` and local declarations.
# A group of the statement emitter's branches, called from codegen_statement.elisa.
# `handled` is set TRUE on entry and cleared only if no branch here matched, so a branch
# that DECLINES still stops the dispatch — exactly as it did when every branch shared one
# function body.

extend Backend:
    private:
        def emit_statement_return_vardecl(statement: Stmt, return_type: ValueType, local_scope: mutable Scope&, loops: mutable LoopStack&, regions: mutable RegionStack&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef, handled: mutable bool&) -> EmitStatus can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            handled <- true
            if statement is Stmt.Return(return_value_opt, return_line):
                if return_value_opt is return_value:
                    # `await task` may arrive here as a value-transparent block after the
                    # semantic expression walkers. Lower it directly in return position as a
                    # fallback to the ordinary expression emitter, preserving the task value
                    # and avoiding a synchronous call-through.
                    if fn_return_head_at(return_line, structs) == "__await":
                        await_operand: mutable Expr = return_value
                        if return_value is Expr.Block(await_block_statements, await_block_value, await_block_captures, await_block_line):
                            await_operand <- await_block_value
                        await_task_type: ValueType = expression_type(await_operand, local_scope, fns, structs, generics)
                        await_base: mutable sview = ""
                        await_arg_start: mutable usize = 0
                        await_arg_count: mutable usize = 0
                        if generic_struct_instantiation_of(structs, await_task_type, await_base, await_arg_start, await_arg_count) and await_base == "Task" and await_arg_count >= 1:
                            await_result_type: ValueType = copied_type(structs.generic_struct_inst_args[await_arg_start])
                            await_types: mutable darray[ValueType] = [await_result_type]
                            await_arguments: mutable darray[Expr] = [await_operand]
                            if emit_generic_call("pool_await", await_types, await_arguments, [], local_scope, fns, structs, generics, runtime, m, ctx, builder) is awaited_return_value:
                                EmitStatus.Declined return if not emit_ensure_checks(awaited_return_value, return_type, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                                emit_region_unwind(regions, runtime, builder)
                                if runtime.in_error_fn:
                                    _ = LLVMBuildStore(builder, awaited_return_value, runtime.error_out)
                                    _ = LLVMBuildRet(builder, LLVMConstInt(LLVMInt32TypeInContext(ctx), 0, 0))
                                    return EmitStatus.Terminated
                                _ = LLVMBuildRet(builder, awaited_return_value)
                                return EmitStatus.Terminated
                        return EmitStatus.Declined
                    # `return sb.extend([0.u8()])` — `extend` in VALUE position. It mutates the
                    # target IN PLACE and yields it, so the value is simply the target's address
                    # once the append has run. Rather than duplicate the ~70-line append loop,
                    # run the STATEMENT form (which handles darray/sview/string-literal sources
                    # and growth) on the same call node, then hand back the address.
                    # Only a REF-to-darray return type takes this path: that is the shape the
                    # std's builder helpers declare (`-> mutable darray[u8, shape_out]&`), and a
                    # by-value darray return would need a copy rather than an alias.
                    if return_type.kind == TypeKind.Ref:
                        ext_ret_target: ValueType = ref_target_of(return_type, structs)
                        if ext_ret_target.kind == TypeKind.DArray:
                            if return_value is Expr.Call(ext_ret_callee, ext_ret_args, ext_ret_names, ext_ret_line):
                                if ext_ret_callee is Expr.Field(ext_ret_object, ext_ret_method, ext_ret_method_line):
                                    if ext_ret_method == "extend" and ext_ret_args.count == 1:
                                        ext_ret_status: EmitStatus = emit_statement((Stmt.Expr(return_value, ext_ret_line)), return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)
                                        EmitStatus.Declined return if ext_ret_status != EmitStatus.Open
                                        if darray_address_of_expr(ext_ret_object, local_scope, fns, structs, generics, runtime, m, ctx, builder) is ext_ret_address:
                                            EmitStatus.Declined return if not emit_ensure_checks(ext_ret_address, return_type, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                                            emit_region_unwind(regions, runtime, builder)
                                            if runtime.in_error_fn:
                                                _ = LLVMBuildStore(builder, ext_ret_address, runtime.error_out)
                                                _ = LLVMBuildRet(builder, LLVMConstInt(LLVMInt32TypeInContext(ctx), 0, 0))
                                                return EmitStatus.Terminated
                                            _ = LLVMBuildRet(builder, ext_ret_address)
                                            return EmitStatus.Terminated
                                        return EmitStatus.Declined
                    # `return try f(x)` — the value form of a propagating try in return position.
                    if return_value is Expr.Call(ret_try_callee, ret_try_args, ret_try_arg_names, ret_try_call_line):
                        if ret_try_callee is Expr.Ident(ret_try_name, ret_try_name_line):
                            if error_callee_is(fns, generics, ret_try_name):
                                if emit_propagating_try_value(ret_try_name, ret_try_args, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder) is ret_try_value:
                                    EmitStatus.Declined return if not emit_ensure_checks(ret_try_value, return_type, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                                    emit_region_unwind(regions, runtime, builder)
                                    if runtime.in_error_fn:
                                        _ = LLVMBuildStore(builder, ret_try_value, runtime.error_out)
                                        _ = LLVMBuildRet(builder, LLVMConstInt(LLVMInt32TypeInContext(ctx), 0, 0))
                                        return EmitStatus.Terminated
                                    _ = LLVMBuildRet(builder, ret_try_value)
                                    return EmitStatus.Terminated
                                return EmitStatus.Declined
                        # `return try f[K, V](x)` — the same propagating try, but the explicit
                        # type-argument bracket makes the callee an Index/IndexN, not an Ident.
                        ret_gtry_base: mutable sview = ""
                        ret_gtry_ok: mutable bool = false
                        ret_gtry_types: darray[ValueType] = generic_callee_type_args(ret_try_callee, &ret_gtry_base, &ret_gtry_ok, structs)
                        if ret_gtry_ok:
                            if emit_propagating_generic_try_value(ret_gtry_base, ret_gtry_types, ret_try_args, true, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder) is ret_gtry_value:
                                EmitStatus.Declined return if not emit_ensure_checks(ret_gtry_value, return_type, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                                emit_region_unwind(regions, runtime, builder)
                                if runtime.in_error_fn:
                                    _ = LLVMBuildStore(builder, ret_gtry_value, runtime.error_out)
                                    _ = LLVMBuildRet(builder, LLVMConstInt(LLVMInt32TypeInContext(ctx), 0, 0))
                                    return EmitStatus.Terminated
                                _ = LLVMBuildRet(builder, ret_gtry_value)
                                return EmitStatus.Terminated
                    # `return match SCRUT:` — the match-EXPRESSION emitter handles only
                    # single-expression arms and has no statement context, so the semantic
                    # layer's `return match declaration:` shapes declined. Lower it with the
                    # statement-level match-into-slot emitter — the same one `x: T = match …`
                    # routes to — into a synthetic local, then return that local so the
                    # ensure / deferred / region-unwind / error-ABI tail below is shared
                    # verbatim rather than duplicated.
                    #
                    # The two emitters are NOT ordered by capability, so route on what the
                    # match-expression emitter cannot do rather than routing everything:
                    #   - a PACKED (AST-node) scrutinee — only the slot emitter binds payload
                    #     fields;
                    #   - any arm with a BLOCK body (statements then a yield) — the expression
                    #     emitter takes single-expression arms only, which is why
                    #     `return match inferred_type.kind:` with a `TypeKind.Named:` block arm
                    #     declined even though its scrutinee is a plain integer.
                    # Everything else stays on the expression emitter, which models RANGE
                    # patterns (`return when c: '0'..='9' -> …`) the slot emitter does not —
                    # routing those here dropped `classify_number_char`.
                    return_operand: mutable Expr = return_value
                    if return_value is Expr.Match(rm_scrutinee, rm_arms, rm_match_line):
                        rm_scrutinee_type: ValueType = expression_type(rm_scrutinee, local_scope, fns, structs, generics)
                        rm_has_block_arm: mutable bool = false
                        for rm_arm in rm_arms |rm_has_block_arm|:
                            rm_has_block_arm <- true if not (arm_value_expression(rm_arm.body) is rm_arm_single)
                        if rm_scrutinee_type.kind == TypeKind.PackedEnum or rm_has_block_arm:
                            EmitStatus.Declined return if emit_match_into_slot(rm_scrutinee, rm_arms, return_type, "__return_match", return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder) != EmitStatus.Open
                            return_operand <- Expr.Ident("__return_match", return_line)
                    emitted: LLVMValueRef? = emit_expression(return_operand, return_type, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                    if emitted is return_constant:
                        # Postconditions run BEFORE the unwind: a predicate may read a
                        # container the auto region still backs.
                        EmitStatus.Declined return if not emit_ensure_checks(return_constant, return_type, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                        # Unwind EVERY live owned region on the way out — the function's auto
                        # region AND any enclosing `region NAME:` scopes. This lives on the
                        # return path rather than at one function exit because a return can
                        # happen from inside any depth of scope.
                        EmitStatus.Declined return if not emit_deferred_actions(local_scope, false, fns, structs, generics, runtime, m, ctx, builder)
                        emit_region_unwind(regions, runtime, builder)
                        # An error fn writes the SUCCESS value through its out-param and
                        # returns the i32 success code 0, rather than returning the value.
                        if runtime.in_error_fn:
                            _ = LLVMBuildStore(builder, return_constant, runtime.error_out)
                            _ = LLVMBuildRet(builder, LLVMConstInt(LLVMInt32TypeInContext(ctx), 0, 0))
                            return EmitStatus.Terminated
                        _ = LLVMBuildRet(builder, return_constant)
                        return EmitStatus.Terminated
                    return EmitStatus.Declined
                # A bare `return` — only valid in a `-> void` function. A `void error[E]` fn
                # still uses the i32-status ABI, so success returns the 0 code, not `ret void`.
                if return_type.kind == TypeKind.Void:
                    # A `-> void` fn with an `ensure` has no `result` to bind. Rather than
                    # drop the check (an unenforced contract), decline the function.
                    EmitStatus.Declined return if structs.pending_ensures.count > 0
                    EmitStatus.Declined return if not emit_deferred_actions(local_scope, false, fns, structs, generics, runtime, m, ctx, builder)
                    emit_region_unwind(regions, runtime, builder)
                    if runtime.in_error_fn:
                        _ = LLVMBuildRet(builder, LLVMConstInt(LLVMInt32TypeInContext(ctx), 0, 0))
                    else:
                        _ = LLVMBuildRetVoid(builder)
                    return EmitStatus.Terminated
                return EmitStatus.Declined

            # `x: i64 = value` — a fresh slot plus the initializing store. The slot is
            # allocated at the CURRENT position rather than hoisted to the entry block;
            # mem2reg still promotes it, and the subset has no loop-allocated locals.
            if statement is Stmt.VarDecl(var_name, var_type, var_value, var_line):
                # `_ = EXPR` — an explicit DISCARD (stage0 lowers a bare `x = v` to a VarDecl,
                # so a `_` target arrives here with no annotation). Emit the value for its side
                # effects at its own type and drop the result; nothing is bound. Without this a
                # discarded call (`_ = fetch_add(&a, 2)`, `_ = helper(5)`) declined at the
                # Unmodeled-annotation gate below.
                if var_name == "_":
                    dr_var_status: i64 = try_discarded_darray_reserve(var_value, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                    EmitStatus.Open return if dr_var_status == 1
                    EmitStatus.Declined return if dr_var_status < 0
                    discard_type: ValueType = expression_type(var_value, local_scope, fns, structs, generics)
                    discard_expected: ValueType = discard_type if discard_type.kind != TypeKind.Unmodeled else ValueType{kind: TypeKind.Signed, bits: 64}
                    if emit_expression(var_value, discard_expected, local_scope, fns, structs, generics, runtime, m, ctx, builder) is discarded_var_value:
                        _ = discarded_var_value
                        return EmitStatus.Open
                    return EmitStatus.Declined
                # `x: T = get OPT` — MONADIC UNWRAP of an optional. Present → bind the payload to
                # `x`; absent → PROPAGATE None: return a null optional from THIS function (which must
                # itself return an optional). The `get X else BODY` form runs BODY on absent instead.
                # index_map_get does `index: usize = get index_map_find_index(...)`.
                if var_value is Expr.GetElse(get_guarded, get_recovery, get_line):
                    get_opt_type: ValueType = expression_type(get_guarded, local_scope, fns, structs, generics)
                    EmitStatus.Declined return if get_opt_type.kind != TypeKind.Optional
                    # Propagation returns a null of THIS function's declared return type (an optional
                    # for the common `-> T?` case; whatever it is, a zero value is the None/empty).
                    EmitStatus.Declined return if get_recovery.count == 0 and return_type.kind == TypeKind.Unmodeled
                    get_payload_type: ValueType = optional_payload_of(get_opt_type, structs)
                    if emit_expression(get_guarded, get_opt_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is get_opt_value:
                        get_tag: LLVMValueRef = optional_tag_of(get_opt_value, get_opt_type, structs, ctx, builder)
                        get_payload: LLVMValueRef = optional_payload_value_of(get_opt_value, get_opt_type, structs, ctx, builder)
                        get_function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                        get_present: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, get_function, "get.present")
                        get_absent: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, get_function, "get.absent")
                        _ = LLVMBuildCondBr(builder, get_tag, get_present, get_absent)
                        # ABSENT: `get X else BODY` runs BODY; bare `get X` propagates None.
                        LLVMPositionBuilderAtEnd(builder, get_absent)
                        if get_recovery.count == 0:
                            emit_region_unwind(regions, runtime, builder)
                            _ = LLVMBuildRet(builder, LLVMConstNull(llvm_type_of(return_type, structs, ctx)))
                        else:
                            get_recovery_status: EmitStatus = emit_statements(get_recovery, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)
                            EmitStatus.Declined return if get_recovery_status == EmitStatus.Declined
                            # An `else` body that falls through has no value to bind — require it to exit.
                            EmitStatus.Declined return if get_recovery_status == EmitStatus.Open
                        # PRESENT: bind the payload to `x` and continue.
                        LLVMPositionBuilderAtEnd(builder, get_present)
                        get_var_storage: mutable darray[u8] = []
                        get_var_slot: LLVMValueRef = build_entry_alloca(builder, llvm_type_of(get_payload_type, structs, ctx), sview_to_cstr(var_name, get_var_storage))
                        _ = LLVMBuildStore(builder, get_payload, get_var_slot)
                        declare_local(local_scope, var_name, get_var_slot, get_payload_type)
                        return EmitStatus.Open
                    return EmitStatus.Declined
                # The ANNOTATION decides the local's type, and the initializer is emitted
                # at that type — so `a: u8 = 200` stores a real u8.
                # Untyped loop-header binders (`x = expr`, machine mode/input locals) arrive
                # with Expr.Invalid as the annotation. Infer from the initializer so machine
                # desugar (`__machine_mode_0 = Enum.S`, `__machine_input_0 = n`) can emit.
                declared_type: mutable ValueType = annotation_value_type(var_type, structs)
                local_error_family: sview = local_error_family_at(var_line, structs)
                declared_type <- intern_error_union_type(declared_type, local_error_family, structs) if local_error_family != ""
                if declared_type.kind == TypeKind.Unmodeled:
                    declared_type <- expression_type(var_value, local_scope, fns, structs, generics)
                EmitStatus.Declined return if declared_type.kind == TypeKind.Unmodeled
                # `x: T = match SCRUT:` whose arms are BLOCKS (statements then a yield) — the
                # match-EXPRESSION emitter handles only single-expression arms and has no statement
                # context, so route it through the statement-level match-into-slot emitter.
                if var_value is Expr.Match(vm_scrutinee, vm_arms, vm_match_line):
                    return emit_match_into_slot(vm_scrutinee, vm_arms, declared_type, var_name, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)
                # A declaration without an initializer still needs a real storage
                # object.  In particular, fixed-size stack arrays are used as
                # scratch buffers by the runtime string helpers.  Expr.Invalid is
                # the parser's marker for this form, so materialize the language's
                # zero-initialized local rather than trying to emit it as a value.
                if var_value is Expr.Invalid or var_value is Expr.Absent:
                    uninitialized_storage: mutable darray[u8] = []
                    uninitialized_slot: LLVMValueRef = build_entry_alloca(builder, llvm_type_of(declared_type, structs, ctx), sview_to_cstr(var_name, uninitialized_storage))
                    uninitialized_alignment: u32 = struct_alignment(declared_type, structs)
                    LLVMSetAlignment(uninitialized_slot, uninitialized_alignment) if uninitialized_alignment != 0
                    _ = LLVMBuildStore(builder, LLVMConstNull(llvm_type_of(declared_type, structs, ctx)), uninitialized_slot)
                    declare_local(local_scope, var_name, uninitialized_slot, declared_type)
                    return EmitStatus.Open
                # `v: T = try f(x)` — the value form of a propagating try. The parser strips the
                # `try` head, leaving a bare call to an error-returning fn; the semantic checker
                # already required the `try`, so any error-call RHS here IS one. Emit the
                # propagate-on-error path and store the success value into the local.
                if var_value is Expr.Call(try_var_callee, try_var_args, try_var_arg_names, try_var_call_line):
                    if try_var_callee is Expr.Ident(try_var_name, try_var_name_line):
                        if declared_type.kind == TypeKind.ErrorUnion:
                            if emit_error_union_call_value(try_var_name, try_var_args, declared_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is union_var_value:
                                union_var_storage: mutable darray[u8] = []
                                union_var_slot: LLVMValueRef = build_entry_alloca(builder, llvm_type_of(declared_type, structs, ctx), sview_to_cstr(var_name, union_var_storage))
                                _ = LLVMBuildStore(builder, union_var_value, union_var_slot)
                                declare_local(local_scope, var_name, union_var_slot, declared_type)
                                return EmitStatus.Open
                        if error_callee_is(fns, generics, try_var_name):
                            if emit_propagating_try_value(try_var_name, try_var_args, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder) is try_var_value:
                                try_var_storage: mutable darray[u8] = []
                                try_var_slot: LLVMValueRef = build_entry_alloca(builder, llvm_type_of(declared_type, structs, ctx), sview_to_cstr(var_name, try_var_storage))
                                stored_try_value: mutable LLVMValueRef = try_var_value
                                if declared_type.kind == TypeKind.ErrorUnion:
                                    stored_try_value <- build_error_union_success(try_var_value, error_union_payload_of(declared_type, structs), declared_type, structs, runtime, ctx, builder)
                                _ = LLVMBuildStore(builder, stored_try_value, try_var_slot)
                                declare_local(local_scope, var_name, try_var_slot, declared_type)
                                return EmitStatus.Open
                            return EmitStatus.Declined
                # Assigning an OPTIONAL value to a NON-optional local is a type error stage0
                # rejects ("variable expects T, got T?"); DECLINE rather than silently unwrap.
                # Also stops a miscompile: stage1's parser erases the control-flow else of
                # `x: i64 = get f() else return 7`, collapsing it to `x: i64 = f()` (f -> i64?).
                # `v: T = get OPT else return X` — the guarded optional is unwrapped on the
                # PRESENT path; the absent path runs the recovery, which terminates (a
                # `return`/`break`/`continue` is the only recovery form this node carries).
                # The local is therefore a plain `T` wherever it is live.
                if var_value is Expr.GetElse(get_guarded, get_recovery, get_else_line):
                    guarded_type: ValueType = expression_type(get_guarded, local_scope, fns, structs, generics)
                    EmitStatus.Declined return if guarded_type.kind != TypeKind.Optional
                    get_payload: ValueType = optional_payload_of(guarded_type, structs)
                    EmitStatus.Declined return if get_payload.kind != declared_type.kind or get_payload.bits != declared_type.bits
                    if emit_expression(get_guarded, guarded_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is get_optional:
                        get_fn: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                        get_present: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, get_fn, "get.present")
                        get_absent: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, get_fn, "get.absent")
                        get_tag: LLVMValueRef = optional_tag_of(get_optional, guarded_type, structs, ctx, builder)
                        _ = LLVMBuildCondBr(builder, get_tag, get_present, get_absent)
                        # ABSENT: the recovery runs and must leave the block terminated. If it
                        # somehow does not, DECLINE rather than fall through into the present
                        # path, which would read an absent optional's payload.
                        LLVMPositionBuilderAtEnd(builder, get_absent)
                        recovery_status: EmitStatus = emit_statements(get_recovery, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)
                        EmitStatus.Declined return if recovery_status != EmitStatus.Terminated
                        LLVMPositionBuilderAtEnd(builder, get_present)
                        get_value: LLVMValueRef = optional_payload_value_of(get_optional, guarded_type, structs, ctx, builder)
                        get_storage: mutable darray[u8] = []
                        get_slot: LLVMValueRef = build_entry_alloca(builder, llvm_type_of(declared_type, structs, ctx), sview_to_cstr(var_name, get_storage))
                        _ = LLVMBuildStore(builder, get_value, get_slot)
                        declare_local(local_scope, var_name, get_slot, declared_type)
                        return EmitStatus.Open
                    return EmitStatus.Declined
                var_value_type: ValueType = expression_type(var_value, local_scope, fns, structs, generics)
                if var_value_type.kind == TypeKind.Optional and declared_type.kind != TypeKind.Optional:
                    # BARE `get OPT` — the parser ERASES `get X` (no `else`) to the inner
                    # optional-producing expression plus a `__checked_get` line annotation, so
                    # a get-unwrap arrives here as a plain `x: T = OPT` with OPT: T?. stage0
                    # REJECTS an unnarrowed Optional->non-optional VarDecl outright ("variable
                    # expects T, got T?"), so any such decl that is NOT narrowed and reaches the
                    # backend IS a validated bare `get`: bind the payload on PRESENT, PROPAGATE
                    # None on ABSENT (this fn itself returns the optional the None flows into —
                    # `index_map_get` does `index: usize = get index_map_find_index(...)`).
                    if not path_is_narrowed(var_value, structs):
                        EmitStatus.Declined return if return_type.kind != TypeKind.Optional
                        bare_get_payload: ValueType = optional_payload_of(var_value_type, structs)
                        EmitStatus.Declined return if bare_get_payload.kind != declared_type.kind or bare_get_payload.bits != declared_type.bits
                        if emit_expression(var_value, var_value_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is bare_get_optional:
                            bare_get_fn: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                            bare_get_present: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, bare_get_fn, "get.bare.present")
                            bare_get_absent: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, bare_get_fn, "get.bare.absent")
                            bare_get_tag: LLVMValueRef = optional_tag_of(bare_get_optional, var_value_type, structs, ctx, builder)
                            _ = LLVMBuildCondBr(builder, bare_get_tag, bare_get_present, bare_get_absent)
                            # ABSENT: unwind live regions, then return this fn's None (a zeroed
                            # optional aggregate — tag 0 = absent — of the declared return type).
                            LLVMPositionBuilderAtEnd(builder, bare_get_absent)
                            emit_region_unwind(regions, runtime, builder)
                            _ = LLVMBuildRet(builder, LLVMConstNull(llvm_type_of(return_type, structs, ctx)))
                            # PRESENT: bind the payload and continue.
                            LLVMPositionBuilderAtEnd(builder, bare_get_present)
                            bare_get_value: LLVMValueRef = optional_payload_value_of(bare_get_optional, var_value_type, structs, ctx, builder)
                            bare_get_storage: mutable darray[u8] = []
                            bare_get_slot: LLVMValueRef = build_entry_alloca(builder, llvm_type_of(declared_type, structs, ctx), sview_to_cstr(var_name, bare_get_storage))
                            _ = LLVMBuildStore(builder, bare_get_value, bare_get_slot)
                            declare_local(local_scope, var_name, bare_get_slot, declared_type)
                            return EmitStatus.Open
                        return EmitStatus.Declined
                    # NARROWED by an earlier `assert PATH != null`: stage0 accepts the
                    # assignment (and emits a plain pointer copy, its `T&?` being a bare
                    # ptr). stage1's `{i1, ptr}` needs the payload extracted.
                    narrowed_payload: ValueType = optional_payload_of(var_value_type, structs)
                    EmitStatus.Declined return if narrowed_payload.kind != declared_type.kind or narrowed_payload.bits != declared_type.bits
                    if emit_expression(var_value, var_value_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is narrowed_optional:
                        narrowed_value: LLVMValueRef = optional_payload_value_of(narrowed_optional, var_value_type, structs, ctx, builder)
                        narrow_storage: mutable darray[u8] = []
                        narrow_slot: LLVMValueRef = build_entry_alloca(builder, llvm_type_of(declared_type, structs, ctx), sview_to_cstr(var_name, narrow_storage))
                        _ = LLVMBuildStore(builder, narrowed_value, narrow_slot)
                        declare_local(local_scope, var_name, narrow_slot, declared_type)
                        return EmitStatus.Open
                    return EmitStatus.Declined
                if emit_expression(var_value, declared_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is initial:
                    name_storage: mutable darray[u8] = []
                    slot: LLVMValueRef = build_entry_alloca(builder, llvm_type_of(declared_type, structs, ctx), sview_to_cstr(var_name, name_storage))
                    local_alignment: u32 = struct_alignment(declared_type, structs)
                    LLVMSetAlignment(slot, local_alignment) if local_alignment != 0
                    _ = LLVMBuildStore(builder, initial, slot)
                    emit_trace_value(var_name, var_line, initial, declared_type, runtime, ctx, builder)
                    declare_local(local_scope, var_name, slot, declared_type)
                    # arg_no 0 = a LOCAL (DW_TAG_variable), not a formal parameter.
                    declare_debug_variable(var_name, slot, declared_type, 0, var_line, LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder)), runtime, structs, ctx, builder)
                    return EmitStatus.Open
                return EmitStatus.Declined
            handled <- false
            return EmitStatus.Declined
