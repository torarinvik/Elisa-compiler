extend Backend:
    private:
        # Whether `r <- value` on a rebindable (`mutable`-bound) reference WRITES THROUGH
        # it rather than rebinding the slot: stage0's mutableScalarRefTarget. The referent
        # must be a number or bool, and the value a number or bool too -- a reference, a
        # view or a string is never written through, it rebinds. An integer or float
        # LITERAL tree has no type of its own (expression_type answers Unmodeled) and is a
        # scalar wherever it lands, so `r <- 99` and `r <- -1.5` write through.
        def rebindable_ref_assign_writes_through(value: Expr, ref_type: ValueType, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&) -> bool can[Abort.Panic, Memory.Allocate]:
            referent: ValueType = ref_target_of(ref_type, structs)
            return false if not (is_numeric_type(referent) or referent.kind == TypeKind.Bool)
            value_type: ValueType = expression_type(value, local_scope, fns, structs, generics)
            return true if is_numeric_type(value_type) or value_type.kind == TypeKind.Bool
            return false if value_type.kind != TypeKind.Unmodeled
            return untyped_value_is_integer_literal_tree(value) or untyped_value_is_numeric_literal(value)




        # A bare float literal, possibly negated or parenthesised: the other context-typed
        # scalar spelling untyped_value_is_integer_literal_tree does not cover. (A float
        # inside an ARITHMETIC tree already types as f64 through expression_type.)
        def untyped_value_is_numeric_literal(value: Expr) -> bool:
            match value:
                Expr.FloatLit(_, _):
                    return true
                Expr.Paren(numeric_literal_inner, _):
                    return untyped_value_is_numeric_literal(numeric_literal_inner)
                Expr.Unary(numeric_literal_operator, numeric_literal_operand, _):
                    return untyped_value_is_numeric_literal(numeric_literal_operand) if numeric_literal_operator == TokenKind.Minus or numeric_literal_operator == TokenKind.Plus else false
                _:
                    pass
            return false
