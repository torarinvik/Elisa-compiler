# Text-level EASM declaration and fragment-composition parsing.
# Kept separate from instruction verification so source-span contracts stay auditable.

extend Easm:
    public:
        def easm_parse_params(text: sview) -> darray[Param]:
            out: mutable darray[Param] = []
            start: mutable usize = 0
            cursor: mutable usize = 0
            while cursor <= text.len |cursor, start, text, out|:
                at_end: bool = cursor == text.len
                if at_end or text[cursor] == 44:
                    part: sview = EasmTextScan::trim(text[start:cursor])
                    if part.len > 0:
                        colon: usize = EasmTextScan::find(part, ":")
                        if colon < part.len:
                            out.push(Param{name: EasmTextScan::trim(part[0:colon]), type_name: EasmTextScan::trim(part[colon + 1.usize():part.len])})
                        else:
                            out.push(Param{name: part, type_name: ""})
                    start <- cursor + 1.usize()
                cursor <- cursor + 1
            return out

        def easm_split_values(text: sview) -> darray[sview]:
            out: mutable darray[sview] = []
            start: mutable usize = 0
            cursor: mutable usize = 0
            while cursor <= text.len |cursor, start, text, out|:
                if cursor == text.len or text[cursor] == 44:
                    value: sview = EasmTextScan::trim(text[start:cursor])
                    if value.len > 0:
                        out.push(value)
                    start <- cursor + 1.usize()
                cursor <- cursor + 1
            return out

        def easm_make_function(line_view: sview, line_number: i64, fragment: bool) -> Function:
            prefix_len: mutable usize = 9 if fragment else 11
            if not fragment:
                prefix_len <- 13 if EasmTextScan::starts_with(line_view, "template def ") else 11
            open: usize = EasmTextScan::find(line_view, "(")
            close: usize = EasmTextScan::find(line_view, ")")
            name: sview = EasmTextScan::trim(line_view[prefix_len:open])
            params: mutable darray[Param] = []
            if open < close:
                params <- easm_parse_params(line_view[open + 1.usize():close])
            return_type: mutable sview = "void"
            abi: mutable sview = ""
            platform: mutable sview = "any"
            effects: mutable darray[sview] = []
            reqs: mutable darray[sview] = []
            clobber_values: mutable darray[sview] = []
            if not fragment and close < line_view.len:
                arrow: usize = EasmTextScan::find(line_view[close:line_view.len], "->")
                if arrow < (line_view[close:line_view.len]).len:
                    return_start: usize = close + arrow + 2.usize()
                    signature_text: sview = EasmTextScan::trim(line_view[return_start:line_view.len])
                    return_end: usize = EasmTextScan::first_space(signature_text).usize()
                    return_type <- EasmTextScan::trim(signature_text[0:return_end])
                    abi_at: usize = EasmTextScan::find(signature_text, " abi ")
                    if abi_at < signature_text.len:
                        abi_text: sview = EasmTextScan::trim(signature_text[abi_at + 5.usize():signature_text.len])
                        abi_end: usize = EasmTextScan::first_space(abi_text).usize()
                        abi <- abi_text[0:abi_end]
                    for_at: usize = EasmTextScan::find(signature_text, " for ")
                    if for_at < signature_text.len:
                        platform_text: sview = EasmTextScan::trim(signature_text[for_at + 5.usize():signature_text.len])
                        platform_end: mutable usize = EasmTextScan::first_space(platform_text).usize()
                        if platform_text.len > 0 and platform_text[0] == 40:
                            close_platform: usize = EasmTextScan::find(platform_text, ")")
                            platform_end <- close_platform + 1.usize() if close_platform < platform_text.len
                        platform <- platform_text[0:platform_end]
                    can_at: usize = EasmTextScan::find(signature_text, " can ")
                    if can_at < signature_text.len:
                        effect_text: sview = EasmTextScan::trim(signature_text[can_at + 5.usize():signature_text.len])
                        effect_end: mutable usize = EasmTextScan::find(effect_text, " abi ")
                        if effect_end == effect_text.len:
                            effect_end <- EasmTextScan::find(effect_text, " for ")
                        effects.push(EasmTextScan::trim(effect_text[0:effect_end]))
                    requires_at: usize = EasmTextScan::find(signature_text, " requires ")
                    if requires_at < signature_text.len:
                        requires_text: sview = EasmTextScan::trim(signature_text[requires_at + 10.usize():signature_text.len])
                        reqs.push(requires_text)
                    clobbers_at: usize = EasmTextScan::find(signature_text, " clobbers ")
                    if clobbers_at < signature_text.len:
                        clobbers_text: sview = EasmTextScan::trim(signature_text[clobbers_at + 10.usize():signature_text.len])
                        clobber_values.push(clobbers_text)
            return Function{name: name, params: params, return_type: return_type, abi: abi, effects: effects, requires: reqs, changes: [], reads: [], clobbers: clobber_values, preserves: [], facts: [], inputs: [], outputs: [], stack_facts: [], control: [], labels: [], instructions: [], reference: [], targets: [], line: line_number, platform: platform}

        def easm_parse_instruction(line_view: sview, line_number: i64) -> Instruction:
            end: usize = EasmTextScan::first_space(line_view).usize()
            op: mutable sview = line_view[0:end]
            pseudo: mutable bool = op.len > 0 and op[0] == 46
            if EasmTextScan::starts_with(line_view, "compose "):
                op <- "compose"
                pseudo <- true
            if EasmTextScan::starts_with(line_view, "state ") or EasmTextScan::starts_with(line_view, "fact ") or EasmTextScan::starts_with(line_view, "assume "):
                op <- "state"
                pseudo <- true
            if line_view.len > 0 and line_view[line_view.len - 1.usize()] == 58:
                op <- "label"
                pseudo <- true
            empty_substitution: Substitution = Substitution{from: "", replacement: ""}
            return Instruction{op: op, text: line_view, line: line_number, pseudo: pseudo, substitution_count: 0, substitution0: empty_substitution, substitution1: empty_substitution, substitution2: empty_substitution, substitution3: empty_substitution}

        def easm_issue(module: mutable Module&, code: sview, line: i64, message: sview) -> void:
            module.issues.push(Issue{severity: Severity.Error, code: code, line: line, message: message})

        struct ComposeInfo:
            flag: sview
            name: sview
            argument_count: i64
            valid: bool

        def easm_parse_compose(text: sview) -> ComposeInfo:
            ensure result.valid implies result.argument_count == easm_compose_span_argument_count(text)
            if not EasmTextScan::starts_with(text, "compose "):
                return ComposeInfo{flag: "", name: "", argument_count: 0, valid: false}
            rest: sview = EasmTextScan::trim(text[8:text.len])
            open: usize = EasmTextScan::find(rest, "(")
            head: sview = EasmTextScan::trim(rest[0:open]) if open < rest.len else rest
            if head.len == 0:
                return ComposeInfo{flag: "", name: "", argument_count: 0, valid: false}
            first_space: usize = EasmTextScan::first_space(head).usize()
            flag: mutable sview = ""
            name: mutable sview = head
            if first_space < head.len:
                flag <- EasmTextScan::trim(head[0:first_space])
                name <- EasmTextScan::trim(head[first_space:head.len])
            argument_count: mutable i64 = 0
            if open < rest.len:
                close: usize = EasmTextScan::find(rest[open:rest.len], ")") + open
                if close <= open:
                    return ComposeInfo{flag: "", name: "", argument_count: 0, valid: false}
                argument_count <- easm_compose_argument_count(rest[open + 1.usize():close])
            assert argument_count == easm_compose_span_argument_count(text)
            assert ComposeInfo{flag: flag, name: name, argument_count: argument_count, valid: true}.argument_count == easm_compose_span_argument_count(text)
            return ComposeInfo{flag: flag, name: name, argument_count: argument_count, valid: true}

        ghost def easm_compose_comma_count_from(text: sview, cursor: usize) -> i64:
            requires cursor <= text.len
            decreases text.len - cursor
            ensure (cursor < text.len and text[cursor] != 44) implies result == easm_compose_comma_count_from(text, cursor + 1.usize())
            ensure (cursor < text.len and text[cursor] == 44) implies result == 1 + easm_compose_comma_count_from(text, cursor + 1.usize())
            ensure result >= 0
            ensure result <= (text.len - cursor).i64()
            return 0 if cursor == text.len
            if text[cursor] == 44:
                return 1 + easm_compose_comma_count_from(text, cursor + 1.usize())
            return easm_compose_comma_count_from(text, cursor + 1.usize())

        def easm_compose_argument_count(text: sview) -> i64:
            ensure text.len < 0 implies result == 0
            ensure (text.len >= 0 and (EasmTextScan::trim(text)).len == 0) implies result == 0
            ensure (text.len >= 0 and (EasmTextScan::trim(text)).len > 0) implies result == easm_compose_comma_count_from(text, 0.usize()) + 1
            return 0 if text.len < 0
            count: mutable i64 = 0
            if (EasmTextScan::trim(text)).len == 0:
                return 0
            assert count == 0
            assert count + easm_compose_comma_count_from(text, 0.usize()) == easm_compose_comma_count_from(text, 0.usize())
            text_length: usize = text.len.usize()
            index: mutable usize = 0
            while index < text_length |index, text, text_length, count|:
                decreases text_length - index
                invariant index <= text_length
                invariant text_length == text.len
                invariant count >= 0
                invariant count.usize() <= index
                invariant count + easm_compose_comma_count_from(text, index) == easm_compose_comma_count_from(text, 0.usize())
                if text[index] == 44:
                    count <- count + 1
                index <- index + 1.usize()
            return count + 1

        struct ComposeSpan:
            start: usize
            end: usize
            valid: bool

        ghost def easm_compose_argument_count_spec(text: sview) -> i64:
            ensure text.len < 0 implies result == 0
            ensure (text.len >= 0 and (EasmTextScan::trim_spec(text)).len == 0) implies result == 0
            ensure (text.len >= 0 and (EasmTextScan::trim_spec(text)).len > 0) implies result == easm_compose_comma_count_from(text, 0.usize()) + 1
            return 0 if text.len < 0
            return 0 if (EasmTextScan::trim_spec(text)).len == 0
            return easm_compose_comma_count_from(text, 0.usize()) + 1

        ghost def easm_compose_close_offset(text: sview, open: usize) -> usize:
            requires open <= text.len
            ensure result <= text.len - open
            return EasmTextScan::find_byte_spec(text[open:text.len], 41)

        ghost def easm_compose_span_argument_count_at_offset(text: sview, open: usize, close_offset: usize) -> i64:
            requires open <= text.len
            requires close_offset <= text.len - open
            ensure open >= text.len implies result == 0
            ensure close_offset == 0 implies result == 0
            ensure (open < text.len and close_offset > 0) implies result == easm_compose_argument_count_spec(text[open + 1.usize():open + close_offset])
            return 0 if open >= text.len
            return 0 if close_offset == 0
            return easm_compose_argument_count_spec(text[open + 1.usize():open + close_offset])

        ghost def easm_compose_span_argument_count_from_open(text: sview, open: usize) -> i64:
            requires open <= text.len
            ensure open >= text.len implies result == 0
            ensure open < text.len implies result == easm_compose_span_argument_count_at_offset(text, open, easm_compose_close_offset(text, open))
            return 0 if open >= text.len
            return easm_compose_span_argument_count_at_offset(text, open, easm_compose_close_offset(text, open))

        ghost def easm_compose_span_argument_count(text: sview) -> i64:
            ensure text.len < 0 implies result == 0
            ensure text.len >= 0 implies result == easm_compose_span_argument_count_from_open(text, EasmTextScan::find_byte_spec(text, 40))
            return 0 if text.len < 0
            return easm_compose_span_argument_count_from_open(text, EasmTextScan::find_byte_spec(text, 40))

        ghost def easm_compose_span_from_trim_bounds(base: usize, source_end: usize, segment_start: usize, cursor: usize, bounds: (start: usize, end: usize)) -> ComposeSpan:
            requires base <= source_end
            requires segment_start <= cursor
            requires bounds.start <= bounds.end and bounds.end <= cursor - segment_start
            requires cursor <= source_end - base
            ensure result.valid
            ensure result.start <= result.end
            ensure result.end <= source_end
            return ComposeSpan{
                start: base + segment_start + bounds.start,
                end: base + segment_start + bounds.end,
                valid: true
            }

        ghost def easm_compose_trimmed_span(values: sview, base: usize, source_end: usize, segment_start: usize, cursor: usize) -> ComposeSpan:
            requires base <= source_end and values.len == source_end - base
            requires cursor <= values.len and segment_start <= cursor
            requires cursor <= source_end - base
            ensure result.valid
            ensure result.start <= result.end
            ensure result.end <= source_end
            return easm_compose_span_from_trim_bounds(base, source_end, segment_start, cursor, EasmTextScan::trim_bounds_spec(values[segment_start:cursor]))

        # Recursive specification for the imperative fragment-argument scanner. This walks
        # one byte at a time and uses the separately verified trim-bounds function to define
        # the exact source slice selected by `wanted`.
        ghost def easm_compose_span_reference_from(values: sview, base: usize, source_end: usize, segment_start: usize, cursor: usize, current: i64, wanted: i64) -> ComposeSpan:
            requires base <= source_end and values.len == source_end - base
            requires cursor <= values.len and segment_start <= cursor and current >= 0
            requires cursor <= source_end - base
            decreases values.len - cursor
            ensure not result.valid implies result.start == 0 and result.end == 0
            ensure result.valid implies result.start <= result.end
            ensure result.valid implies result.end <= source_end
            ensure (wanted >= current and wanted - current <= easm_compose_comma_count_from(values, cursor)) implies result.valid
            return ComposeSpan{start: 0, end: 0, valid: false} if wanted < current
            return easm_compose_span_reference_from(values, base, source_end, segment_start, cursor + 1.usize(), current, wanted) if cursor < values.len and values[cursor] != 44
            return easm_compose_trimmed_span(values, base, source_end, segment_start, cursor) if current == wanted
            return ComposeSpan{start: 0, end: 0, valid: false} if cursor == values.len
            return easm_compose_span_reference_from(values, base, source_end, cursor + 1.usize(), cursor + 1.usize(), current + 1, wanted)

        ghost def easm_compose_span_reference_at_bounds(text: sview, open: usize, close_offset: usize, wanted: i64) -> ComposeSpan:
            requires open < text.len
            requires close_offset > 0 and close_offset <= text.len - open
            ensure not result.valid implies result.start == 0 and result.end == 0
            ensure result.valid implies result.start <= result.end
            ensure result.valid implies result.end <= text.len
            ensure (wanted >= 0 and wanted < easm_compose_span_argument_count_at_offset(text, open, close_offset)) implies result.valid
            base: usize = open + 1.usize()
            source_end: usize = open + close_offset
            values: sview = text[base:source_end]
            argument_count: i64 = easm_compose_argument_count_spec(values)
            comma_count: i64 = easm_compose_comma_count_from(values, 0.usize())
            assert base <= source_end
            assert source_end <= text.len
            assert values.len == source_end - base
            assert argument_count == easm_compose_span_argument_count_at_offset(text, open, close_offset)
            assert wanted < 0 or wanted >= argument_count or wanted <= comma_count
            return easm_compose_span_reference_from(values, base, source_end, 0, 0, 0, wanted)

        ghost def easm_compose_span_reference_at_offset(text: sview, open: usize, close_offset: usize, wanted: i64) -> ComposeSpan:
            requires open <= text.len
            requires close_offset <= text.len - open
            ensure not result.valid implies result.start == 0 and result.end == 0
            ensure result.valid implies result.start <= result.end
            ensure result.valid implies result.end <= text.len
            ensure (wanted >= 0 and wanted < easm_compose_span_argument_count_at_offset(text, open, close_offset)) implies result.valid
            return ComposeSpan{start: 0, end: 0, valid: false} if open >= text.len
            return ComposeSpan{start: 0, end: 0, valid: false} if close_offset == 0
            return easm_compose_span_reference_at_bounds(text, open, close_offset, wanted)

        ghost def easm_compose_span_reference_from_open(text: sview, open: usize, wanted: i64) -> ComposeSpan:
            requires open <= text.len
            ensure not result.valid implies result.start == 0 and result.end == 0
            ensure result.valid implies result.start <= result.end
            ensure result.valid implies result.end <= text.len
            ensure (wanted >= 0 and wanted < easm_compose_span_argument_count_from_open(text, open)) implies result.valid
            return ComposeSpan{start: 0, end: 0, valid: false} if open >= text.len
            return easm_compose_span_reference_at_offset(
                text,
                open,
                easm_compose_close_offset(text, open),
                wanted
            )

        ghost def easm_compose_span_reference(text: sview, wanted: i64) -> ComposeSpan:
            ensure text.len < 0 implies not result.valid and result.start == 0 and result.end == 0
            ensure not result.valid implies result.start == 0 and result.end == 0
            ensure result.valid implies result.start <= result.end
            ensure result.valid implies result.end <= text.len
            ensure (wanted >= 0 and wanted < easm_compose_span_argument_count(text)) implies result.valid
            return ComposeSpan{start: 0, end: 0, valid: false} if text.len < 0
            return easm_compose_span_reference_from_open(text, EasmTextScan::find_byte_spec(text, 40), wanted)

        def easm_compose_span(text: sview, wanted: i64) -> ComposeSpan:
            ensure (wanted >= 0 and wanted < easm_compose_span_argument_count(text)) implies result.valid
            ensure result.valid == easm_compose_span_reference(text, wanted).valid
            ensure result.start == easm_compose_span_reference(text, wanted).start
            ensure result.end == easm_compose_span_reference(text, wanted).end
            ensure not result.valid implies result.start == 0 and result.end == 0
            ensure result.valid implies result.start <= result.end
            ensure result.valid implies result.end <= text.len
            return ComposeSpan{start: 0, end: 0, valid: false} if text.len < 0
            open: usize = EasmTextScan::find_byte(text, 40)
            if open >= text.len:
                return ComposeSpan{start: 0, end: 0, valid: false}
            close_offset: usize = EasmTextScan::find_byte(text[open:text.len], 41)
            assert close_offset > 0.usize()
            close: usize = close_offset + open
            assert close <= text.len
            base: usize = open + 1.usize()
            assert base <= close
            values: sview = text[base:close]
            value_length: usize = values.len
            assert value_length == close - base
            start: mutable usize = 0
            current: mutable i64 = 0
            cursor: mutable usize = 0
            while cursor <= value_length |cursor, value_length, start, current, values, base, close, wanted, text|:
                decreases value_length - cursor
                invariant cursor <= value_length
                invariant base <= close
                invariant values.len == close - base
                invariant value_length == values.len
                invariant cursor <= close - base
                invariant start <= cursor
                invariant current >= 0
                invariant current.usize() <= cursor
                invariant easm_compose_span_reference_from(values, base, close, start, cursor, current, wanted).valid == easm_compose_span_reference(text, wanted).valid
                invariant easm_compose_span_reference_from(values, base, close, start, cursor, current, wanted).start == easm_compose_span_reference(text, wanted).start
                invariant easm_compose_span_reference_from(values, base, close, start, cursor, current, wanted).end == easm_compose_span_reference(text, wanted).end
                if cursor == value_length or values[cursor] == 44:
                    if current == wanted:
                        bounds: (start: usize, end: usize) = EasmTextScan::trim_bounds(values[start:cursor])
                        assert start <= cursor
                        assert bounds.start <= bounds.end
                        assert bounds.end <= cursor - start
                        assert base + cursor <= close
                        span_start: usize = base + start + bounds.start
                        span_end: usize = base + start + bounds.end
                        assert cursor <= value_length
                        assert span_start <= span_end
                        assert span_end <= close
                        assert easm_compose_span_reference_from(values, base, close, start, cursor, current, wanted).valid
                        assert easm_compose_span_reference_from(values, base, close, start, cursor, current, wanted).start == span_start
                        assert easm_compose_span_reference_from(values, base, close, start, cursor, current, wanted).end == span_end
                        return ComposeSpan{start: span_start, end: span_end, valid: true}
                    if cursor == value_length:
                        break
                    cursor <- cursor + 1.usize()
                    current <- current + 1
                    start <- cursor
                else:
                    cursor <- cursor + 1.usize()
            return ComposeSpan{start: 0, end: 0, valid: false}
