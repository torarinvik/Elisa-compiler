# Stage1 backend — WHICH aggregates a generated header must declare: everything reachable from a
# public declaration, forward-declared where a strong dependency allows it, sorted by public
# name so the output is stable. Part of `module Backend` (see codegen.elisa).

extend Backend:
    private:


            # Collect every aggregate reachable from a public declaration. A C forward
            # declaration is enough for a reference, but a by-value field must be defined
            # before the containing struct. The root list and every strong dependency list are
            # sorted by public name, matching stage0's map-plus-topological-sort implementation.
        def header_add_unique_name(names: mutable darray[sview]&, name: sview) -> void can[Abort.Panic]:
            return if name_in_sview(names, name)
            names.push(name)




        def header_collect_reachable_type(file: Ast::File&, value_type: ValueType, structs: mutable StructTable&, roots: mutable darray[sview]&, seen: mutable darray[sview]&) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                if value_type.kind == TypeKind.Fn:
                    false return if value_type.bits.usize() >= structs.fn_pool_returns.count
                    false return if not header_collect_reachable_type(file, structs.fn_pool_returns[value_type.bits.usize()], structs, roots, seen)
                    param_start: usize = structs.fn_pool_param_start[value_type.bits.usize()]
                    param_count: usize = structs.fn_pool_param_count[value_type.bits.usize()]
                    for param_index in 0..<param_count |file, structs, roots, seen, param_start, param_count|:
                        false return if not header_collect_reachable_type(file, structs.fn_pool_params[param_start + param_index], structs, roots, seen)
                    return true
                if value_type.kind == TypeKind.Struct:
                    false return if value_type.bits.usize() >= structs.names.count
                    struct_name: sview = structs.names[value_type.bits.usize()]
                    header_add_unique_name(roots, struct_name)
                    true return if name_in_sview(seen, struct_name)
                    seen.push(struct_name)
                    struct_index: i64 = struct_index_of(structs, struct_name)
                    false return if struct_index < 0
                    field_start: usize = structs.field_start[struct_index.usize()]
                    field_count: usize = structs.field_count[struct_index.usize()]
                    for field_offset in 0..<field_count |file, structs, roots, seen, field_start, field_count|:
                        field_type: ValueType = copied_type(structs.field_types[field_start + field_offset])
                        false return if not header_collect_reachable_type(file, field_type, structs, roots, seen)
                    return true
                if value_type.kind == TypeKind.Array:
                    false return if value_type.bits.usize() >= structs.array_elements.count
                    return header_collect_reachable_type(file, structs.array_elements[value_type.bits.usize()], structs, roots, seen)
                if value_type.kind == TypeKind.Ref:
                    false return if value_type.bits.usize() >= structs.ref_targets.count
                    return header_collect_reachable_type(file, structs.ref_targets[value_type.bits.usize()], structs, roots, seen)
                if value_type.kind == TypeKind.Optional:
                    false return if value_type.bits.usize() >= structs.optional_targets.count
                    payload: ValueType = copied_type(structs.optional_targets[value_type.bits.usize()])
                    false return if payload.kind != TypeKind.Ref
                    return header_collect_reachable_type(file, payload, structs, roots, seen)
                return true




        def header_collect_strong_dependencies(value_type: ValueType, structs: mutable StructTable&, dependencies: mutable darray[sview]&) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                if value_type.kind == TypeKind.Struct:
                    false return if value_type.bits.usize() >= structs.names.count
                    header_add_unique_name(dependencies, structs.names[value_type.bits.usize()])
                    return true
                if value_type.kind == TypeKind.Array:
                    false return if value_type.bits.usize() >= structs.array_elements.count
                    return header_collect_strong_dependencies(structs.array_elements[value_type.bits.usize()], structs, dependencies)
                # References and niche optionals only need a forward declaration; their target
                # remains in the reachable root set, but it is not a definition dependency.
                return true




        def header_sort_by_public_name(file: Ast::File&, names: mutable darray[sview]&) -> void can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic:
                for slot in 0..<names.count |file, names|:
                    best: mutable usize = slot
                    for probe in (slot + 1)..<names.count |best, file, names|:
                        probe_public: sview = header_public_struct_name(file, names[probe])
                        best_public: sview = header_public_struct_name(file, names[best])
                        best <- probe if header_name_less(probe_public, best_public)
                    if best != slot:
                        swap: sview = names[slot]
                        names[slot] <- names[best]
                        names[best] <- swap




        def header_name_less(left: sview, right: sview) -> bool can[Abort.Panic]:
            shorter: usize = sview_len(left) if sview_len(left) < sview_len(right) else sview_len(right)
            for probe in 0..<shorter |left, right|:
                left_byte: u8 = sview_at(left, probe)
                right_byte: u8 = sview_at(right, probe)
                true return if left_byte < right_byte
                false return if left_byte > right_byte
            return sview_len(left) < sview_len(right)




        def header_collect_struct(file: Ast::File&, struct_name: sview, structs: mutable StructTable&, visiting: mutable darray[sview]&, ordered: mutable darray[sview]&) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                true return if name_in_sview(ordered, struct_name)
                false return if name_in_sview(visiting, struct_name)
                struct_index: i64 = struct_index_of(structs, struct_name)
                false return if struct_index < 0
                visiting.push(struct_name)
                dependencies: mutable darray[sview] = []
                field_start: usize = structs.field_start[struct_index.usize()]
                field_count: usize = structs.field_count[struct_index.usize()]
                for field_offset in 0..<field_count |structs, dependencies, field_start, field_count|:
                    field_type: ValueType = copied_type(structs.field_types[field_start + field_offset])
                    false return if not header_collect_strong_dependencies(field_type, structs, dependencies)
                header_sort_by_public_name(file, dependencies)
                for dependency in dependencies |file, structs, visiting, ordered, struct_name|:
                    continue if dependency == struct_name
                    false return if not header_collect_struct(file, dependency, structs, visiting, ordered)
                _ = visiting.pop()
                ordered.push(struct_name)
                return true




        def header_collect_public_aggregates(file: Ast::File&, structs: mutable StructTable&, ordered: mutable darray[sview]&) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            roots: mutable darray[sview] = []
            seen: mutable darray[sview] = []
            for annotation in file.enum_annotations |file, structs, roots, seen|:
                continue if annotation.name != "__export_type"
                exported_type: ValueType = header_type_from_name(annotation.owner, structs)
                false return if exported_type.kind == TypeKind.Unmodeled
                false return if not header_collect_reachable_type(file, exported_type, structs, roots, seen)
            for annotation in file.enum_annotations |file, structs, roots, seen|:
                continue if annotation.name != "__export_global"
                global_type: ValueType = header_global_type(structs, annotation.owner)
                false return if global_type.kind == TypeKind.Unmodeled
                false return if not header_collect_reachable_type(file, global_type, structs, roots, seen)
            for declaration in file.top_decls |file, structs, roots, seen|:
                match declaration:
                    Decl.Extern(function_name, param_start, arity, variadic, callable, return_type_name, decorators, line):
                        is_export: mutable bool = false
                        for annotation in file.enum_annotations |is_export, function_name|:
                            is_export <- true if annotation.owner == function_name and annotation.name == "__export_fn"
                        continue if not is_export or not callable
                        return_type: ValueType = header_type_from_name(return_type_name, structs)
                        false return if return_type.kind == TypeKind.Unmodeled
                        false return if not header_collect_reachable_type(file, return_type, structs, roots, seen)
                        for parameter_index in 0..<arity.usize() |file, structs, roots, seen, param_start|:
                            parameter: ExternParam = file.extern_params[param_start.usize() + parameter_index]
                            parameter_type: ValueType = header_type_from_name(parameter.type_name, structs)
                            false return if parameter_type.kind == TypeKind.Unmodeled
                            false return if not header_collect_reachable_type(file, parameter_type, structs, roots, seen)
                    _:
                        pass
            header_sort_by_public_name(file, roots)
            visiting: mutable darray[sview] = []
            for root in roots |file, structs, visiting, ordered|:
                false return if not header_collect_struct(file, root, structs, visiting, ordered)
            return true
