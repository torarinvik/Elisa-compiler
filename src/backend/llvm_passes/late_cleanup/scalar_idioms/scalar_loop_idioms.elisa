# Scalar idioms whose result can be computed without iterating, on AArch64.
#
# Per function of at most 48 blocks the loop-pass policy accepts: bit-spread increments
# and nibble population sums first, in block order, then the single-block loops of five,
# seven or eleven instructions (trailing-zero shifts, and in functions of at most 16
# blocks carry additions and threshold searches).
include "../../ir/loop_pass_policy.elisa"
include "../../ir/scalar_loop_patterns.elisa"
include "./bit_count_idioms.elisa"
include "./scalar_loops.elisa"
include "./threshold_searches.elisa"
include "./odd_trailing_zero_selects.elisa"

const module ScalarIdiomLimit:
    FUNCTION_BLOCKS: u32 = 48
    SEARCH_FUNCTION_BLOCKS: u32 = 16

extend Backend:
    private:
        def fold_function_scalar_idioms(function: LLVMValueRef, builder: LLVMBuilderRef, module: LLVMModuleRef) -> u32 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            analyses: ElisaFunctionAnalysesRef = get ElisaLLVMCreateFunctionAnalyses(function) else return 0
            changed: mutable u32 = fold_function_bit_count_idioms(function, analyses, builder, module)
            block_cursor: mutable LLVMBasicBlockRef? = LLVMGetFirstBasicBlock(function)
            while block_cursor is block |block_cursor, changed, function, analyses, builder, module|:
                block_cursor <- LLVMGetNextBasicBlock(block)
                changed <- changed + fold_scalar_loop(block, function, analyses, builder, module)
            ElisaLLVMDisposeFunctionAnalyses(analyses)
            changed

    public:
        def fold_scalar_loop_idioms(module: LLVMModuleRef) -> u32 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            return 0 if not module_targets_aarch64(module)
            builder: LLVMBuilderRef = LLVMCreateBuilderInContext(LLVMGetModuleContext(module))
            changed: mutable u32 = 0
            function_cursor: mutable LLVMValueRef? = LLVMGetFirstFunction(module)
            while function_cursor is function |function_cursor, changed, module, builder|:
                function_cursor <- LLVMGetNextFunction(function)
                if LLVMCountBasicBlocks(function) <= ScalarIdiomLimit::FUNCTION_BLOCKS and not skipped_by_loop_pass_policy(function, module):
                    changed <- changed + fold_function_scalar_idioms(function, builder, module)
            LLVMDisposeBuilder(builder)
            changed
