# Factor and induction loops that can start from a quotient already computed.
#
# A factor-removal loop `while n == d * (n / d): n = n / d` entered with the quotient its
# entry already tested starts from that quotient, or carries it in from the edges that
# divided by the same factor. A loop dividing a stable nonnegative dividend by a cursor
# counting up from a power of two reuses the unsigned quotient its latch compares against.
# The rewrites are tried by edge_division_reuse.elisa.

const module FactorQuotientLimit:
    REDUNDANT_LOOP_INSTRUCTIONS: u32 = 5
    CARRIED_LOOP_INSTRUCTIONS: u32 = 12
    PREDECESSOR_INSTRUCTIONS: u32 = 32

# A quotient computed on an edge into a join, and the block that computes it.
struct EdgeQuotient:
    quotient: LLVMValueRef
    block: LLVMBasicBlockRef

extend Backend:
    private:
        # Whether BLOCK continues to CONTINUE_BLOCK exactly when `DIVIDEND == FACTOR *
        # QUOTIENT` (the product in either order).
        def is_factor_test(block: LLVMBasicBlockRef, dividend: LLVMValueRef, factor: LLVMValueRef, quotient: LLVMValueRef, continue_block: LLVMBasicBlockRef) -> bool:
            branch: LLVMValueRef = get LLVMGetBasicBlockTerminator(block) else return false
            compare: LLVMValueRef = get conditional_guard(branch) else return false
            return false if LLVMGetICmpPredicate(compare) != LLVMIntPredicate::EQ or LLVMGetSuccessor(branch, 0) != continue_block or LLVMGetSuccessor(branch, 1) == continue_block
            return false if LLVMGetOperand(compare, 0) != dividend
            product: LLVMValueRef = LLVMGetOperand(compare, 1)
            return false if not binary_operator_with_opcode(product, LLVMOpcode::MUL)
            (LLVMGetOperand(product, 0) == factor and LLVMGetOperand(product, 1) == quotient) or (LLVMGetOperand(product, 1) == factor and LLVMGetOperand(product, 0) == quotient)

        def is_defined_in_block(value: LLVMValueRef, block: LLVMBasicBlockRef) -> bool:
            LLVMIsAInstruction(value) != null and LLVMGetInstructionParent(value) == block

        # PHINode::setIncomingValueForBlock: every entry of PHI for BLOCK takes VALUE.
        def set_incoming_values_for_block(phi: LLVMValueRef, block: LLVMBasicBlockRef, value: LLVMValueRef) -> void:
            for index in 0..<LLVMCountIncoming(phi) |phi, block, value|:
                LLVMSetOperand(phi, index, value) if LLVMGetIncomingBlock(phi, index) == block

        # Whether OPERATION, reaching ENTRY from PREDECESSOR, divides DIVIDEND by FACTOR as
        # they reach that edge: an unsigned division, or a shift by a power-of-two factor.
        def divides_on_entry_edge(operation: LLVMValueRef, dividend: LLVMValueRef, factor: LLVMValueRef, entry: LLVMBasicBlockRef, predecessor: LLVMBasicBlockRef) -> bool:
            edge_dividend: LLVMValueRef = get division_operand_on_edge(dividend, entry, predecessor) else return false
            edge_factor: LLVMValueRef = get division_operand_on_edge(factor, entry, predecessor) else return false
            return false if LLVMIsABinaryOperator(operation) == null or LLVMGetExact(operation) != 0 or LLVMGetOperand(operation, 0) != edge_dividend
            return true if LLVMGetInstructionOpcode(operation) == LLVMOpcode::UDIV and LLVMGetOperand(operation, 1) == edge_factor
            exponent: i32 = power_of_two_exponent(edge_factor)
            return false if exponent < 0 or LLVMGetInstructionOpcode(operation) != LLVMOpcode::LSHR
            shift: LLVMValueRef = LLVMGetOperand(operation, 1)
            LLVMIsAConstantInt(shift) != null and is_constant_integer(shift, exponent.u64())

        # Whether QUOTIENT, a phi of ENTRY, takes on every edge DIVIDEND divided by FACTOR.
        def joins_entry_quotients(quotient: LLVMValueRef, dividend: LLVMValueRef, factor: LLVMValueRef, entry: LLVMBasicBlockRef) -> bool:
            count: u32 = LLVMCountIncoming(quotient)
            for index in 0..<count |quotient, dividend, factor, entry|:
                return false if not divides_on_entry_edge(LLVMGetIncomingValue(quotient, index), dividend, factor, entry, LLVMGetIncomingBlock(quotient, index))
            count != 0

        # A guarded factor-removal loop can start at the quotient already carried by its
        # caller. The entering equality guarantees its first step continues.
        def skip_redundant_factor_division(loop: LLVMBasicBlockRef) -> bool:
            return false if instruction_count(loop) != FactorQuotientLimit::REDUNDANT_LOOP_INSTRUCTIONS
            remaining: LLVMValueRef = get LLVMGetFirstInstruction(loop) else return false
            return false if not is_llvm_instruction_with_opcode(remaining, LLVMOpcode::PHI)
            division: LLVMValueRef = get LLVMGetNextInstruction(remaining) else return false
            return false if LLVMIsABinaryOperator(division) == null or LLVMCountIncoming(remaining) != 2 or LLVMGetInstructionOpcode(division) != LLVMOpcode::UDIV
            return false if LLVMGetExact(division) != 0 or not is_llvm_integer_type(LLVMTypeOf(division), 64) or LLVMGetOperand(division, 0) != remaining
            backedge: i64 = phi_incoming_index(remaining, loop)
            return false if backedge < 0 or LLVMGetIncomingValue(remaining, backedge.u32()) != division
            factor: LLVMValueRef = LLVMGetOperand(division, 1)
            return false if not is_factor_test(loop, remaining, factor, division, loop) or is_defined_in_block(factor, loop)
            entry: LLVMBasicBlockRef = LLVMGetIncomingBlock(remaining, 1 - backedge.u32())
            dividend: LLVMValueRef = get phi_incoming_for_block(remaining, entry) else return false
            cursor: mutable LLVMValueRef? = leading_phi(LLVMGetFirstInstruction(entry))
            while cursor is quotient |cursor, remaining, division, factor, entry, dividend, loop|:
                cursor <- leading_phi(LLVMGetNextInstruction(quotient))
                if LLVMTypeOf(quotient) == LLVMTypeOf(division) and is_factor_test(entry, dividend, factor, quotient, loop):
                    if joins_entry_quotients(quotient, dividend, factor, entry):
                        set_incoming_values_for_block(remaining, entry, quotient)
                        return true
            false

        # The loop `remaining = phi [dividend, join], [remaining / factor, loop]` ending in
        # `remaining == factor * (remaining / factor)`: its division, or nothing.
        def carried_factor_division(loop: LLVMBasicBlockRef) -> LLVMValueRef? can[Abort.Panic]:
            return null if instruction_count(loop) > FactorQuotientLimit::CARRIED_LOOP_INSTRUCTIONS or ElisaLLVMBlockIsEHPad(loop) != 0 or ElisaLLVMBlockHasAddressTaken(loop) != 0
            division: LLVMValueRef = get plain_i64_division(loop, LLVMOpcode::UDIV) else return null
            remaining: LLVMValueRef = LLVMGetOperand(division, 0)
            branch: LLVMValueRef = get LLVMGetBasicBlockTerminator(loop) else return null
            compare: LLVMValueRef = get conditional_guard(branch) else return null
            return null if not is_llvm_instruction_with_opcode(remaining, LLVMOpcode::PHI) or LLVMGetInstructionParent(remaining) != loop or LLVMCountIncoming(remaining) != 2
            return null if LLVMGetICmpPredicate(compare) != LLVMIntPredicate::EQ or LLVMGetSuccessor(branch, 0) != loop or LLVMGetSuccessor(branch, 1) == loop
            factor: LLVMValueRef = LLVMGetOperand(division, 1)
            return null if is_defined_in_block(factor, loop)
            product: mutable LLVMValueRef = LLVMGetOperand(compare, 0)
            if product == remaining:
                product <- LLVMGetOperand(compare, 1)
            elif LLVMGetOperand(compare, 1) != remaining:
                return null
            return null if not binary_operator_with_opcode(product, LLVMOpcode::MUL)
            return null if not ((LLVMGetOperand(product, 0) == division and LLVMGetOperand(product, 1) == factor) or (LLVMGetOperand(product, 0) == factor and LLVMGetOperand(product, 1) == division))
            back_index: i64 = phi_incoming_index(remaining, loop)
            return null if back_index < 0 or LLVMGetIncomingValue(remaining, back_index.u32()) != division
            division

        # The unsigned division of DIVIDEND by FACTOR in PREDECESSOR, if it has one.
        def entry_division(predecessor: LLVMBasicBlockRef, dividend: LLVMValueRef, factor: LLVMValueRef) -> LLVMValueRef?:
            cursor: mutable LLVMValueRef? = LLVMGetFirstInstruction(predecessor)
            while cursor is instruction |cursor, dividend, factor|:
                if binary_operator_with_opcode(instruction, LLVMOpcode::UDIV) and LLVMGetExact(instruction) == 0:
                    return instruction if LLVMGetOperand(instruction, 0) == dividend and LLVMGetOperand(instruction, 1) == factor
                cursor <- LLVMGetNextInstruction(instruction)
            null

        # When the outer loop has already divided by this factor, reuse that quotient for
        # the first divisibility test. Repeated removals still divide on their backedge,
        # where the original loop would have divided again.
        def carry_factor_quotient(loop: LLVMBasicBlockRef, builder: LLVMBuilderRef) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            division: LLVMValueRef = get carried_factor_division(loop) else return false
            remaining: LLVMValueRef = LLVMGetOperand(division, 0)
            factor: LLVMValueRef = LLVMGetOperand(division, 1)
            entry_index: u32 = 1 - phi_incoming_index(remaining, loop).u32()
            join: LLVMBasicBlockRef = LLVMGetIncomingBlock(remaining, entry_index)
            dividend: LLVMValueRef = LLVMGetIncomingValue(remaining, entry_index)
            jump: LLVMValueRef = get LLVMGetBasicBlockTerminator(join) else return false
            return false if LLVMGetInstructionOpcode(jump) != LLVMOpcode::UNCONDITIONAL_BR or LLVMGetSuccessor(jump, 0) != loop or ElisaLLVMBlockIsEHPad(join) != 0
            predecessors: darray[LLVMBasicBlockRef] = predecessor_edges(join)
            return false if predecessors.count != 2 or predecessors[0] == predecessors[1]
            quotients: mutable darray[LLVMValueRef?] = []
            dividends: mutable darray[LLVMValueRef] = []
            shifts: mutable darray[i32] = []
            reuses_division: mutable bool = false
            for predecessor in predecessors |quotients, dividends, shifts, reuses_division, join, loop, dividend, factor|:
                return false if predecessor == join or predecessor == loop or instruction_count(predecessor) > FactorQuotientLimit::PREDECESSOR_INSTRUCTIONS
                edge_dividend: LLVMValueRef = get division_operand_on_edge(dividend, join, predecessor) else return false
                edge_factor: LLVMValueRef = get division_operand_on_edge(factor, join, predecessor) else return false
                found: LLVMValueRef? = entry_division(predecessor, edge_dividend, edge_factor)
                quotients.push(found)
                dividends.push(edge_dividend)
                if found == null:
                    exponent: i32 = power_of_two_exponent(edge_factor)
                    return false if exponent < 0
                    shifts.push(exponent)
                else:
                    reuses_division <- true
                    shifts.push(-1)
            return false if not reuses_division
            branch: LLVMValueRef = get LLVMGetBasicBlockTerminator(loop) else return false
            backedge_storage: mutable darray[u8] = []
            back: LLVMBasicBlockRef = get ElisaLLVMSplitCriticalEdge(branch, 0, sview_to_cstr("factor.quotient.backedge", backedge_storage)) else return false
            LLVMPositionBuilderBefore(builder, first_non_phi(join))
            LLVMSetCurrentDebugLocation2(builder, null)
            entry_storage: mutable darray[u8] = []
            entry_quotient: LLVMValueRef = LLVMBuildPhi(builder, LLVMTypeOf(division), sview_to_cstr("factor.entry.quotient", entry_storage))
            for index in 0..<2.usize() |quotients, dividends, shifts, predecessors, entry_quotient, builder|:
                incoming: mutable LLVMValueRef = dividends[index]
                if quotients[index] is reused:
                    incoming <- reused
                else:
                    terminator: LLVMValueRef = get LLVMGetBasicBlockTerminator(predecessors[index]) else return false
                    position_builder_before(builder, terminator)
                    shift_storage: mutable darray[u8] = []
                    shift: LLVMValueRef = LLVMConstInt(LLVMTypeOf(dividends[index]), shifts[index].u64(), 0)
                    incoming <- LLVMBuildLShr(builder, dividends[index], shift, sview_to_cstr("factor.initial.quotient", shift_storage))
                add_phi_incoming(entry_quotient, incoming, predecessors[index])
            LLVMPositionBuilderBefore(builder, division)
            LLVMSetCurrentDebugLocation2(builder, null)
            quotient_storage: mutable darray[u8] = []
            quotient: LLVMValueRef = LLVMBuildPhi(builder, LLVMTypeOf(division), sview_to_cstr("factor.quotient", quotient_storage))
            add_phi_incoming(quotient, entry_quotient, join)
            back_terminator: LLVMValueRef = get LLVMGetBasicBlockTerminator(back) else return false
            LLVMPositionBuilderBefore(builder, back_terminator)
            set_builder_debug_location(builder, division)
            next_storage: mutable darray[u8] = []
            add_phi_incoming(quotient, LLVMBuildUDiv(builder, quotient, factor, sview_to_cstr("factor.next.quotient", next_storage)), back)
            LLVMReplaceAllUsesWith(division, quotient)
            LLVMInstructionEraseFromParent(division)
            true

        # The latch's `next <pred> quotient` test of the induction NEXT, normalized so NEXT
        # is on the left and the loop continues when it holds: the quotient, if the test is
        # `<=` or `<` against `dividend /u next`.
        def latch_quotient(latch: LLVMBasicBlockRef, header: LLVMBasicBlockRef, next: LLVMValueRef, dividend: LLVMValueRef) -> LLVMValueRef?:
            back: LLVMValueRef = get LLVMGetBasicBlockTerminator(latch) else return null
            test: LLVMValueRef = get conditional_guard(back) else return null
            continue_true: bool = LLVMGetSuccessor(back, 0) == header
            return null if continue_true == (LLVMGetSuccessor(back, 1) == header)
            predicate: mutable i32 = LLVMGetICmpPredicate(test) if continue_true else inverse_integer_predicate(LLVMGetICmpPredicate(test))
            other: mutable LLVMValueRef = LLVMGetOperand(test, 1)
            if LLVMGetOperand(test, 0) != next:
                return null if other != next
                other <- LLVMGetOperand(test, 0)
                predicate <- swapped_integer_predicate(predicate)
            return null if predicate != LLVMIntPredicate::SLE and predicate != LLVMIntPredicate::SLT and predicate != LLVMIntPredicate::ULE and predicate != LLVMIntPredicate::ULT
            return null if not binary_operator_with_opcode(other, LLVMOpcode::UDIV) or LLVMGetExact(other) != 0
            return null if LLVMGetOperand(other, 0) != dividend or LLVMGetOperand(other, 1) != next
            other

        # The latch has already divided by the next cursor. Reuse its unsigned quotient for
        # the signed division when induction proves a positive cursor and the entry guard
        # proves a stable nonnegative dividend.
        def reuse_unsigned_induction_quotient(header: LLVMBasicBlockRef, builder: LLVMBuilderRef) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            return false if ElisaLLVMBlockIsEHPad(header) != 0 or ElisaLLVMBlockHasAddressTaken(header) != 0
            division: LLVMValueRef = get plain_i64_division(header, LLVMOpcode::SDIV) else return false
            cursor: LLVMValueRef = LLVMGetOperand(division, 1)
            dividend: LLVMValueRef = LLVMGetOperand(division, 0)
            return false if not is_llvm_instruction_with_opcode(cursor, LLVMOpcode::PHI) or LLVMGetInstructionParent(cursor) != header or LLVMCountIncoming(cursor) != 2
            return false if not is_llvm_instruction_with_opcode(dividend, LLVMOpcode::FREEZE)
            initial: u32 = 0 if LLVMIsAConstantInt(LLVMGetIncomingValue(cursor, 0)) != null else 1
            start: LLVMValueRef = LLVMGetIncomingValue(cursor, initial)
            return false if LLVMIsAConstantInt(start) == null or is_negative_constant(start) or is_constant_integer(start, 1)
            exponent: i32 = power_of_two_exponent(start)
            return false if exponent < 0
            entry: LLVMBasicBlockRef = LLVMGetIncomingBlock(cursor, initial)
            latch: LLVMBasicBlockRef = LLVMGetIncomingBlock(cursor, 1 - initial)
            return false if entry == latch or entry == header or latch == header
            entry_branch: LLVMValueRef = get LLVMGetBasicBlockTerminator(entry) else return false
            guard: LLVMValueRef = get conditional_guard(entry_branch) else return false
            bound: LLVMValueRef = get guard_bound(guard) else return false
            return false if LLVMGetICmpSameSign(guard) == 0 or LLVMGetOperand(guard, 0) != dividend or is_negative_constant(bound)
            next: LLVMValueRef = LLVMGetIncomingValue(cursor, 1 - initial)
            return false if not binary_operator_with_opcode(next, LLVMOpcode::ADD) or LLVMGetOperand(next, 0) != cursor
            step: LLVMValueRef = LLVMGetOperand(next, 1)
            return false if LLVMIsAConstantInt(step) == null or not is_constant_integer(step, 1)
            quotient: LLVMValueRef = get latch_quotient(latch, header, next, dividend) else return false
            # The seed is in [2, INT64_MAX), so the increment stays positive. A taken backedge
            # requires next <= dividend / next <= INT64_MAX / 2, restoring the bound on the
            # next iteration.
            position_builder_before(builder, entry_branch)
            first_storage: mutable darray[u8] = []
            first: LLVMValueRef = LLVMBuildLShr(builder, dividend, LLVMConstInt(LLVMTypeOf(dividend), exponent.u64(), 0), sview_to_cstr("initial.induction.quotient", first_storage))
            LLVMPositionBuilderBefore(builder, division)
            LLVMSetCurrentDebugLocation2(builder, null)
            carried_storage: mutable darray[u8] = []
            carried: LLVMValueRef = LLVMBuildPhi(builder, LLVMTypeOf(division), sview_to_cstr("induction.quotient", carried_storage))
            add_phi_incoming(carried, first, entry)
            add_phi_incoming(carried, quotient, latch)
            LLVMReplaceAllUsesWith(division, carried)
            LLVMInstructionEraseFromParent(division)
            true
