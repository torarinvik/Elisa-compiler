# Shares the odd factor in a short-circuit chain of divisibility tests:
#   start:  br (n urem A == 0), exit, middle         ; A = odd * 2^a
#   middle: br (n & (2^b - 1) == 0), last, exit
#   last:   zext (n urem B != 0); br exit             ; B = odd * 2^b, a > b
#   exit:   phi [1, start], [0, middle], [zext, last]; ret
# A multiple of A already passes the low-bits guard, and on that guard testing B only needs
# the shared odd factor, so start computes the result directly and branches to exit.
include "../../ir/ir_editing.elisa"
include "../../ir/loop_pass_policy.elisa"

const module SharedDivisibilityLimit:
    MINIMUM_BLOCKS: u32 = 4
    MAXIMUM_BLOCKS: u32 = 16
    MIDDLE_INSTRUCTIONS: u32 = 3
    LAST_INSTRUCTIONS: u32 = 4
    EXIT_INSTRUCTIONS: u32 = 2

# `numerator OP constant` under a divisibility comparison.
struct DivisibilityOperand:
    numerator: LLVMValueRef
    constant: LLVMValueRef
    operation: LLVMValueRef

# The blocks of the chain and the phi they feed.
struct DivisibilityChain:
    start: LLVMBasicBlockRef
    middle: LLVMBasicBlockRef
    last: LLVMBasicBlockRef
    exit: LLVMBasicBlockRef
    phi: LLVMValueRef
    result: LLVMValueRef

extend Backend:
    private:
        # `value == 0` (or `!= 0`) when VALUE is that comparison under PREDICATE.
        def divisibility_comparison(value: LLVMValueRef, predicate: i32) -> LLVMValueRef?:
            return null if not is_llvm_instruction_with_opcode(value, LLVMOpcode::ICMP) or LLVMGetICmpPredicate(value) != predicate
            zero: LLVMValueRef = LLVMGetOperand(value, 1)
            return null if LLVMIsAConstantInt(zero) == null or ElisaLLVMConstantIntEquals(zero, 0) == 0
            value

        # The single-use `numerator OPCODE constant` the comparison tests.
        def divisibility_operand(compare: LLVMValueRef?, opcode: u32) -> DivisibilityOperand?:
            test: LLVMValueRef = get compare else return null
            operation: LLVMValueRef = LLVMGetOperand(test, 0)
            return null if not is_llvm_instruction_with_opcode(operation, opcode) or not has_one_use(operation)
            constant: LLVMValueRef = LLVMGetOperand(operation, 1)
            return null if LLVMIsAConstantInt(constant) == null
            DivisibilityOperand{numerator: LLVMGetOperand(operation, 0), constant: constant, operation: operation}

        def single_successor(block: LLVMBasicBlockRef) -> LLVMBasicBlockRef?:
            terminator: LLVMValueRef = get LLVMGetBasicBlockTerminator(block) else return null
            return null if LLVMGetNumSuccessors(terminator) != 1
            LLVMGetSuccessor(terminator, 0)

        # `ret phi` as the second of the exit's two instructions.
        def returns_phi(exit: LLVMBasicBlockRef) -> LLVMValueRef?:
            phi: LLVMValueRef = get LLVMGetFirstInstruction(exit) else return null
            return null if not is_llvm_instruction_with_opcode(phi, LLVMOpcode::PHI)
            terminator: LLVMValueRef = get LLVMGetBasicBlockTerminator(exit) else return null
            return null if LLVMGetInstructionOpcode(terminator) != LLVMOpcode::RET or LLVMGetNumOperands(terminator) == 0
            phi if LLVMGetOperand(terminator, 0) == phi else null

        def divisibility_chain(first: LLVMValueRef) -> DivisibilityChain?:
            start: LLVMBasicBlockRef = LLVMGetInstructionParent(first)
            exit: LLVMBasicBlockRef = LLVMGetSuccessor(first, 0)
            middle: LLVMBasicBlockRef = LLVMGetSuccessor(first, 1)
            return null if not same_optional_block(single_predecessor(middle), start) or instruction_count(middle) != SharedDivisibilityLimit::MIDDLE_INSTRUCTIONS
            return null if instruction_count(exit) != SharedDivisibilityLimit::EXIT_INSTRUCTIONS
            phi: LLVMValueRef = get returns_phi(exit) else return null
            second: LLVMValueRef = get conditional_terminator(middle) else return null
            return null if LLVMGetSuccessor(second, 1) != exit
            last: LLVMBasicBlockRef = LLVMGetSuccessor(second, 0)
            return null if not same_optional_block(single_predecessor(last), middle) or instruction_count(last) != SharedDivisibilityLimit::LAST_INSTRUCTIONS
            return null if not same_optional_block(single_successor(last), exit)
            return null if not is_optional_constant_integer(phi_incoming_for_block(phi, start), 1) or not is_optional_constant_integer(phi_incoming_for_block(phi, middle), 0)
            result: LLVMValueRef = get phi_incoming_for_block(phi, last) else return null
            return null if not is_llvm_instruction_with_opcode(result, LLVMOpcode::ZEXT) or LLVMGetInstructionParent(result) != last
            DivisibilityChain{start: start, middle: middle, last: last, exit: exit, phi: phi, result: result}

        # Whether MASK is APInt::getLowBitsSet(width, BITS).
        def is_low_bits(mask: LLVMValueRef, bits: u32) -> bool:
            return ElisaLLVMConstantIntEquals(mask, 0) != 0 if bits == 0
            ElisaLLVMConstantIntMaskWidth(mask) == bits

        def fold_shared_divisibility(first: LLVMValueRef, builder: LLVMBuilderRef) -> bool can[Abort.Panic, Memory.Allocate]:
            chain: DivisibilityChain = get divisibility_chain(first) else return false
            second: LLVMValueRef = get conditional_terminator(chain.middle) else return false
            mask_test: LLVMValueRef? = divisibility_comparison(LLVMGetCondition(second), LLVMIntPredicate::EQ)
            small_test: LLVMValueRef? = divisibility_comparison(LLVMGetOperand(chain.result, 0), LLVMIntPredicate::NE)
            large: DivisibilityOperand = get divisibility_operand(divisibility_comparison(LLVMGetCondition(first), LLVMIntPredicate::EQ), LLVMOpcode::UREM) else return false
            mask: DivisibilityOperand = get divisibility_operand(mask_test, LLVMOpcode::AND) else return false
            small: DivisibilityOperand = get divisibility_operand(small_test, LLVMOpcode::UREM) else return false
            return false if large.numerator != mask.numerator or large.numerator != small.numerator
            return false if not same_optional_block(optional_parent(mask_test), chain.middle) or not same_optional_block(optional_parent(small_test), chain.last)
            return false if LLVMGetInstructionParent(mask.operation) != chain.middle or LLVMGetInstructionParent(small.operation) != chain.last
            return false if ElisaLLVMConstantIntEquals(large.constant, 0) != 0 or ElisaLLVMConstantIntEquals(small.constant, 0) != 0
            large_zeros: u32 = ElisaLLVMConstantIntTrailingZeros(large.constant)
            small_zeros: u32 = ElisaLLVMConstantIntTrailingZeros(small.constant)
            return false if large_zeros <= small_zeros
            odd: LLVMValueRef = ElisaLLVMConstantIntOddPart(small.constant)
            return false if ElisaLLVMConstantIntEquals(odd, 1) != 0 or ElisaLLVMConstantIntOddPart(large.constant) != odd or not is_low_bits(mask.constant, small_zeros)
            position_builder_before(builder, first)
            numerator: LLVMValueRef = LLVMBuildFreeze(builder, large.numerator, "")
            numerator_type: LLVMTypeRef = LLVMTypeOf(numerator)
            zero: LLVMValueRef = LLVMConstNull(numerator_type)
            low: LLVMValueRef = LLVMBuildICmp(builder, LLVMIntPredicate::EQ, LLVMBuildAnd(builder, numerator, mask.constant, ""), zero, "")
            high: LLVMValueRef = LLVMBuildICmp(builder, LLVMIntPredicate::EQ, LLVMBuildAnd(builder, numerator, ElisaLLVMConstantIntLowBits(numerator_type, large_zeros), ""), zero, "")
            odd_remainder: LLVMValueRef = LLVMBuildURem(builder, numerator, odd, "")
            not_multiple: LLVMValueRef = LLVMBuildICmp(builder, LLVMIntPredicate::NE, odd_remainder, LLVMConstNull(LLVMTypeOf(odd_remainder)), "")
            matched: LLVMValueRef = LLVMBuildAnd(builder, low, LLVMBuildOr(builder, high, not_multiple, ""), "")
            # The start has the one edge into the exit: its first branch successor.
            set_phi_incoming_for_block(chain.phi, chain.start, LLVMBuildZExt(builder, matched, LLVMTypeOf(chain.phi), ""))
            _ = LLVMBuildBr(builder, chain.exit)
            LLVMInstructionEraseFromParent(first)
            true

        # The first chain in FUNCTION folded, and the blocks it orphaned removed.
        def fold_first_shared_divisibility(function: LLVMValueRef, builder: LLVMBuilderRef) -> bool can[Abort.Panic, Memory.Allocate]:
            block_cursor: mutable LLVMBasicBlockRef? = LLVMGetFirstBasicBlock(function)
            while block_cursor is block |block_cursor, builder, function|:
                block_cursor <- LLVMGetNextBasicBlock(block)
                if conditional_terminator(block) is first:
                    if fold_shared_divisibility(first, builder):
                        _ = ElisaLLVMRemoveUnreachableBlocks(function)
                        return true
            false

        def optional_parent(instruction: LLVMValueRef?) -> LLVMBasicBlockRef?:
            present: LLVMValueRef = get instruction else return null
            LLVMGetInstructionParent(present)

    public:
        # The divisibility chains folded, at most one per function, on AArch64.
        def fold_shared_divisibility_tests(module: LLVMModuleRef) -> u32 can[Abort.Panic, Memory.Allocate]:
            return 0 if not module_targets_aarch64(module)
            builder: LLVMBuilderRef = LLVMCreateBuilderInContext(LLVMGetModuleContext(module))
            changed: mutable u32 = 0
            function_cursor: mutable LLVMValueRef? = LLVMGetFirstFunction(module)
            while function_cursor is function |function_cursor, changed, module, builder|:
                function_cursor <- LLVMGetNextFunction(function)
                blocks: u32 = function_block_count(function)
                continue if blocks < SharedDivisibilityLimit::MINIMUM_BLOCKS or blocks > SharedDivisibilityLimit::MAXIMUM_BLOCKS or skipped_by_loop_pass_policy(function, module)
                changed <- changed + 1 if fold_first_shared_divisibility(function, builder)
            LLVMDisposeBuilder(builder)
            changed
