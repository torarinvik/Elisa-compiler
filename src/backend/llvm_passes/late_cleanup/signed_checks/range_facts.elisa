# The fact tables and range arithmetic of the signed-check prover: a table maps values to
# the ranges the guards give them (`DenseMap<Value *, ConstantRange>`), and the helpers
# combine ranges the way the C++ prover did.
#
# Ranges are owned handles. A function returning one gives the caller a new range; a
# function documented as consuming its ranges disposes them.
include "../../ir/ir_editing.elisa"
include "../../ir/llvm_ir_queries.elisa"
include "../../../llvm_c_api/constants/elisa_llvm_constant_range.elisa"

# The intrinsic identifiers the prover recognizes.
struct CheckedIntrinsics:
    signed_add: u32
    signed_subtract: u32
    signed_multiply: u32
    unsigned_add: u32
    unsigned_subtract: u32
    unsigned_multiply: u32
    absolute: u32
    trap: u32

# Values and their ranges, in insertion order; a value appears at most once.
struct RangeFacts:
    values: mutable darray[LLVMValueRef]
    ranges: mutable darray[ElisaConstantRangeRef]

extend Backend:
    public:
        def checked_intrinsics() -> CheckedIntrinsics can[Abort.Panic, Memory.Allocate]:
            CheckedIntrinsics{signed_add: intrinsic_identifier("llvm.sadd.with.overflow"), signed_subtract: intrinsic_identifier("llvm.ssub.with.overflow"), signed_multiply: intrinsic_identifier("llvm.smul.with.overflow"), unsigned_add: intrinsic_identifier("llvm.uadd.with.overflow"), unsigned_subtract: intrinsic_identifier("llvm.usub.with.overflow"), unsigned_multiply: intrinsic_identifier("llvm.umul.with.overflow"), absolute: intrinsic_identifier("llvm.abs"), trap: intrinsic_identifier("llvm.trap")}

        def empty_facts() -> RangeFacts:
            RangeFacts{values: [], ranges: []}

        def fact_index(facts: RangeFacts&, value: LLVMValueRef) -> i64:
            for index in 0..<facts.values.count |facts, value|:
                return index.i64() if facts.values[index] == value
            -1

        # A copy of the value's range, when the table has one.
        def fact_range(facts: RangeFacts&, value: LLVMValueRef) -> ElisaConstantRangeRef?:
            index: i64 = fact_index(facts, value)
            return null if index < 0
            ElisaLLVMConstantRangeCopy(facts.ranges[index.usize()])

        def has_facts(facts: RangeFacts&) -> bool:
            facts.values.count > 0

        # `try_emplace(value, range)`, intersecting an existing range with it (preferring the
        # smallest range). Consumes RANGE.
        def add_fact(facts: mutable RangeFacts&, value: LLVMValueRef, range: ElisaConstantRangeRef) -> void can[Memory.Allocate]:
            index: i64 = fact_index(facts, value)
            if index < 0:
                facts.values.push(value)
                facts.ranges.push(range)
                return
            existing: ElisaConstantRangeRef = facts.ranges[index.usize()]
            facts.ranges[index.usize()] <- ElisaLLVMConstantRangeIntersect(existing, range)
            ElisaLLVMDisposeConstantRange(existing)
            ElisaLLVMDisposeConstantRange(range)

        def copied_facts(facts: RangeFacts&) -> RangeFacts can[Memory.Allocate]:
            values: mutable darray[LLVMValueRef] = []
            ranges: mutable darray[ElisaConstantRangeRef] = []
            for index in 0..<facts.values.count |values, ranges, facts|:
                values.push(facts.values[index])
                ranges.push(ElisaLLVMConstantRangeCopy(facts.ranges[index]))
            RangeFacts{values: values, ranges: ranges}

        def dispose_facts(facts: RangeFacts&) -> void:
            for range in facts.ranges:
                ElisaLLVMDisposeConstantRange(range)

        # `intersectWith(second, Signed)`, consuming both ranges.
        def signed_intersection(first: ElisaConstantRangeRef, second: ElisaConstantRangeRef) -> ElisaConstantRangeRef:
            result: ElisaConstantRangeRef = ElisaLLVMConstantRangeIntersectSigned(first, second)
            ElisaLLVMDisposeConstantRange(first)
            ElisaLLVMDisposeConstantRange(second)
            result

        # `unionWith(second, Signed)`, consuming both ranges.
        def signed_union(first: ElisaConstantRangeRef, second: ElisaConstantRangeRef) -> ElisaConstantRangeRef:
            result: ElisaConstantRangeRef = ElisaLLVMConstantRangeUnionSigned(first, second)
            ElisaLLVMDisposeConstantRange(first)
            ElisaLLVMDisposeConstantRange(second)
            result

        # `unionWith(second)`, preferring the smallest range, consuming both ranges.
        def smallest_union(first: ElisaConstantRangeRef, second: ElisaConstantRangeRef) -> ElisaConstantRangeRef:
            result: ElisaConstantRangeRef = ElisaLLVMConstantRangeUnion(first, second)
            ElisaLLVMDisposeConstantRange(first)
            ElisaLLVMDisposeConstantRange(second)
            result

        # `binaryOp(opcode, right)`, consuming both ranges.
        def range_operation(opcode: u32, left: ElisaConstantRangeRef, right: ElisaConstantRangeRef) -> ElisaConstantRangeRef:
            result: ElisaConstantRangeRef = ElisaLLVMConstantRangeBinaryOperation(opcode, left, right)
            ElisaLLVMDisposeConstantRange(left)
            ElisaLLVMDisposeConstantRange(right)
            result

        def is_empty_range(range: ElisaConstantRangeRef) -> bool:
            ElisaLLVMConstantRangeIsEmpty(range) != 0

        def is_full_range(range: ElisaConstantRangeRef) -> bool:
            ElisaLLVMConstantRangeIsFull(range) != 0

        def is_sign_wrapped(range: ElisaConstantRangeRef) -> bool:
            ElisaLLVMConstantRangeIsSignWrapped(range) != 0

        def signed_minimum(range: ElisaConstantRangeRef, context: LLVMContextRef) -> LLVMValueRef:
            ElisaLLVMConstantRangeSignedMinimum(range, context)

        def signed_maximum(range: ElisaConstantRangeRef, context: LLVMContextRef) -> LLVMValueRef:
            ElisaLLVMConstantRangeSignedMaximum(range, context)

        # `getSingleElement()`: the range's one value, when it has exactly one.
        def single_element(range: ElisaConstantRangeRef, context: LLVMContextRef) -> LLVMValueRef?:
            return null if ElisaLLVMConstantRangeIsSingleElement(range) == 0
            ElisaLLVMConstantRangeSignedMinimum(range, context)

        # `ConstantRange::getNonEmpty(lower, upper)`: [lower, upper), full when they are equal.
        def nonempty_range(lower: LLVMValueRef, upper: LLVMValueRef) -> ElisaConstantRangeRef:
            ElisaLLVMConstantRangeNonEmpty(lower, upper)

        def plus_one(value: LLVMValueRef) -> LLVMValueRef:
            LLVMConstAdd(value, LLVMConstInt(LLVMTypeOf(value), 1, 0))

        def compares(predicate: i32, first: LLVMValueRef, second: LLVMValueRef) -> bool:
            ElisaLLVMConstantIntCompare(predicate, first, second) != 0

        # `CmpInst::getInversePredicate`.
        def inverse_predicate(predicate: i32) -> i32:
            return LLVMIntPredicate::NE if predicate == LLVMIntPredicate::EQ
            return LLVMIntPredicate::EQ if predicate == LLVMIntPredicate::NE
            return LLVMIntPredicate::ULE if predicate == LLVMIntPredicate::UGT
            return LLVMIntPredicate::ULT if predicate == LLVMIntPredicate::UGE
            return LLVMIntPredicate::UGE if predicate == LLVMIntPredicate::ULT
            return LLVMIntPredicate::UGT if predicate == LLVMIntPredicate::ULE
            return LLVMIntPredicate::SLE if predicate == LLVMIntPredicate::SGT
            return LLVMIntPredicate::SLT if predicate == LLVMIntPredicate::SGE
            return LLVMIntPredicate::SGE if predicate == LLVMIntPredicate::SLT
            LLVMIntPredicate::SGT

        # `CmpInst::getSwappedPredicate`.
        def swapped_predicate(predicate: i32) -> i32:
            return LLVMIntPredicate::ULT if predicate == LLVMIntPredicate::UGT
            return LLVMIntPredicate::ULE if predicate == LLVMIntPredicate::UGE
            return LLVMIntPredicate::UGT if predicate == LLVMIntPredicate::ULT
            return LLVMIntPredicate::UGE if predicate == LLVMIntPredicate::ULE
            return LLVMIntPredicate::SLT if predicate == LLVMIntPredicate::SGT
            return LLVMIntPredicate::SLE if predicate == LLVMIntPredicate::SGE
            return LLVMIntPredicate::SGT if predicate == LLVMIntPredicate::SLT
            return LLVMIntPredicate::SGE if predicate == LLVMIntPredicate::SLE
            predicate

        # `ExtractValueInst` of the one index 0.
        def is_first_field(value: LLVMValueRef) -> bool can[Abort.Panic]:
            LLVMIsAInstruction(value) != null and is_extract_of_field(value, 0)

        # `WithOverflowInst`: one of the six `llvm.*.with.overflow` calls.
        def is_with_overflow(value: LLVMValueRef, intrinsics: CheckedIntrinsics&) -> bool:
            return false if LLVMIsAIntrinsicInst(value) == null
            identifier: u32 = called_intrinsic_id(value)
            identifier == intrinsics.signed_add or identifier == intrinsics.unsigned_add or identifier == intrinsics.signed_subtract or identifier == intrinsics.unsigned_subtract or identifier == intrinsics.signed_multiply or identifier == intrinsics.unsigned_multiply

        # The `llvm.s{add,sub,mul}.with.overflow` call's plain opcode, when it is one.
        def checked_opcode(call: LLVMValueRef, intrinsics: CheckedIntrinsics&) -> u32?:
            return null if LLVMIsAIntrinsicInst(call) == null
            identifier: u32 = called_intrinsic_id(call)
            return LLVMOpcode::ADD if identifier == intrinsics.signed_add
            return LLVMOpcode::SUB if identifier == intrinsics.signed_subtract
            return LLVMOpcode::MUL if identifier == intrinsics.signed_multiply
            null
