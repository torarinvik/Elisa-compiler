# Ranges of the values of a bisection search (the C++ `ElisaBisectionRanges`). A midpoint
# M = L + (H - L) / c, for a constant c >= 1, or M = (L + H) / 2 lies between L and H
# whichever is larger: a quotient rounded toward zero or down stays between zero and its
# dividend, and between two integers when the exact quotient is. The endpoints and
# midpoints of a search flow into each other through phis and selects, so every value of
# that web stays within the hull of the values that enter it from outside (the initial
# low and high bounds).
include "./loop_steps.elisa"

const module BisectionLimit:
    WEB_VALUES: usize = 24

# The two operands of an operation, or the two ends of a midpoint.
struct OperandPair:
    left: LLVMValueRef
    right: LLVMValueRef

extend Backend:
    public:
        # `nonWrapping`: the operands of an add or sub that cannot wrap, a CHECKED intrinsic
        # read on its no-overflow path (through a freeze) or a PLAIN instruction with `nsw`.
        def non_wrapping(result: LLVMValueRef, checked: u32, plain: u32) -> OperandPair? can[Abort.Panic]:
            if is_first_field(result):
                pair: mutable LLVMValueRef = LLVMGetOperand(result, 0)
                if is_llvm_instruction_with_opcode(pair, LLVMOpcode::FREEZE):
                    pair <- LLVMGetOperand(pair, 0)
                return null if LLVMIsAIntrinsicInst(pair) == null or called_intrinsic_id(pair) != checked
                return OperandPair{left: LLVMGetOperand(pair, 0), right: LLVMGetOperand(pair, 1)}
            return null if LLVMIsABinaryOperator(result) == null or LLVMGetInstructionOpcode(result) != plain or LLVMGetNSW(result) == 0
            OperandPair{left: LLVMGetOperand(result, 0), right: LLVMGetOperand(result, 1)}

        # `shrunkDividend`: the dividend of a division by a positive constant rounding toward
        # zero (sdiv) or down (ashr); HALVING requires the divisor to be exactly two.
        def shrunk_dividend(quotient: LLVMValueRef, halving: bool) -> LLVMValueRef?:
            return null if LLVMIsABinaryOperator(quotient) == null
            divisor: LLVMValueRef = LLVMGetOperand(quotient, 1)
            return null if LLVMIsAConstantInt(divisor) == null
            opcode: u32 = LLVMGetInstructionOpcode(quotient)
            if opcode == LLVMOpcode::SDIV and ElisaLLVMConstantIntIsNegative(divisor) == 0 and ElisaLLVMIsConstantZero(divisor) == 0:
                return LLVMGetOperand(quotient, 0) if not halving or ElisaLLVMConstantIntEquals(divisor, 2) != 0
            if opcode == LLVMOpcode::ASHR:
                width: LLVMValueRef = LLVMConstInt(LLVMTypeOf(divisor), LLVMGetIntTypeWidth(LLVMTypeOf(quotient)).u64(), 0)
                if ElisaLLVMConstantIntUnsignedGreater(width, divisor) != 0:
                    return LLVMGetOperand(quotient, 0) if not halving or ElisaLLVMConstantIntEquals(divisor, 1) != 0
            null

        # `midpointEnds`: the low and high ends whose midpoint CANDIDATE is, when it is one.
        def midpoint_ends(candidate: LLVMValueRef, intrinsics: CheckedIntrinsics&) -> OperandPair? can[Abort.Panic]:
            if non_wrapping(candidate, intrinsics.signed_add, LLVMOpcode::ADD) is sum:
                orders: darray[OperandPair] = [sum, OperandPair{left: sum.right, right: sum.left}]
                for order in orders |intrinsics|:
                    if shrunk_dividend(order.right, false) is span:
                        if non_wrapping(span, intrinsics.signed_subtract, LLVMOpcode::SUB) is difference:
                            return OperandPair{left: order.left, right: difference.left} if difference.right == order.left
                return null
            total: LLVMValueRef = get shrunk_dividend(candidate, true) else return null
            non_wrapping(total, intrinsics.signed_add, LLVMOpcode::ADD)

        def is_bisection_member_kind(value: LLVMValueRef) -> bool:
            is_llvm_instruction_with_opcode(value, LLVMOpcode::PHI) or is_llvm_instruction_with_opcode(value, LLVMOpcode::SELECT) or is_llvm_instruction_with_opcode(value, LLVMOpcode::EXTRACT_VALUE) or LLVMIsABinaryOperator(value) != null or is_llvm_instruction_with_opcode(value, LLVMOpcode::FREEZE)

        # The values entering the bisection web containing START, or null when START is not
        # in one (or the web is too large).
        def bisection_entries(start: LLVMValueRef, intrinsics: CheckedIntrinsics&) -> darray[LLVMValueRef]? can[Abort.Panic, Memory.Allocate]:
            web: mutable darray[LLVMValueRef] = []
            entering: mutable darray[LLVMValueRef] = []
            work: mutable darray[LLVMValueRef] = [start]
            has_midpoint: mutable bool = false
            while work.count > 0 |web, entering, work, has_midpoint, start, intrinsics|:
                member: LLVMValueRef = work.pop()
                if not contains_value(web, member) and not contains_value(entering, member):
                    return null if web.count + entering.count > BisectionLimit::WEB_VALUES
                    if is_llvm_instruction_with_opcode(member, LLVMOpcode::PHI):
                        web.push(member)
                        for incoming in 0..<LLVMCountIncoming(member) |work, member|:
                            work.push(LLVMGetIncomingValue(member, incoming))
                    elif is_llvm_instruction_with_opcode(member, LLVMOpcode::FREEZE):
                        web.push(member)
                        work.push(LLVMGetOperand(member, 0))
                    elif is_llvm_instruction_with_opcode(member, LLVMOpcode::SELECT):
                        web.push(member)
                        work.push(LLVMGetOperand(member, 1))
                        work.push(LLVMGetOperand(member, 2))
                    elif midpoint_ends(member, intrinsics) is ends:
                        web.push(member)
                        has_midpoint <- true
                        work.push(ends.left)
                        work.push(ends.right)
                    else:
                        return null if member == start
                        entering.push(member)
            return null if not has_midpoint or entering.count == 0
            entering

        # `bisectionHull`: the signed hull of the ranges of the values entering START's
        # bisection web, or null when START is not in one.
        def bisection_hull(start: LLVMValueRef, bounds: RangeFacts&, search: mutable RangeSearch&, depth: u32) -> ElisaConstantRangeRef? can[Abort.Panic, Memory.Allocate]:
            return null if not is_bisection_member_kind(start) or LLVMGetTypeKind(LLVMTypeOf(start)) != LLVMTypeKindValue::INTEGER
            entering: darray[LLVMValueRef] = get bisection_entries(start, &search.intrinsics) else return null
            hull: mutable ElisaConstantRangeRef = ElisaLLVMConstantRangeEmpty(LLVMGetIntTypeWidth(LLVMTypeOf(start)))
            for outside in entering |hull, bounds, search, depth|:
                hull <- signed_union(hull, range_of(outside, bounds, search, depth))
                if is_full_range(hull):
                    ElisaLLVMDisposeConstantRange(hull)
                    return null
            hull
