# Count the visits to an unsigned divide-by-ten loop using the input's
# highest set bit and one comparison against the next decimal power, and
# the width loop left by division by a power of two from its highest bit.
#
# For a 64-bit value with highest set bit b, `(b * 1233) >> 12` is the
# number of decimal digits less one, or one less than that; one compare
# with the power of ten at that index decides which (checked for every b
# when this pass was written in C++, by a static assertion).
include "../../ir/ir_editing.elisa"
include "../../ir/loop_pass_policy.elisa"

const module DecimalDigitLimits:
    BLOCK_INSTRUCTIONS: u32 = 6
    MAX_FUNCTION_BLOCKS: u32 = 128
    POWER_COUNT: u64 = 19
    LOG10_2_NUMERATOR: u64 = 1233
    LOG10_2_SHIFT: u64 = 12
    MAX_SHIFT: u64 = 32

# The six instructions of a digit-counting loop body and its entry edge.
struct DigitLoop:
    word: LLVMValueRef
    quotient: LLVMValueRef
    count: LLVMValueRef
    next: LLVMValueRef
    compare: LLVMValueRef
    branch: LLVMValueRef
    entry: LLVMBasicBlockRef
    entry_edge: u32

# The variant a loop is matched as: the branch predicate, the dividing
# opcode and the count's value on entry.
struct DigitLoopShape:
    predicate: i32
    division_opcode: u32
    initial_count: u64

extend Backend:
    private:
        # The loop's branch, when the body is a six-instruction block whose
        # conditional branch tests an `icmp` with the predicate and has no
        # metadata beyond its location.
        def digit_loop_branch(body: LLVMBasicBlockRef, predicate: i32) -> LLVMValueRef?:
            return null if instruction_count(body) != DecimalDigitLimits::BLOCK_INSTRUCTIONS or ElisaLLVMBlockHasAddressTaken(body) != 0
            if conditional_terminator(body) is branch:
                compare: LLVMValueRef = LLVMGetCondition(branch)
                return null if not is_llvm_instruction_with_opcode(compare, LLVMOpcode::ICMP) or LLVMGetICmpPredicate(compare) != predicate
                return null if ElisaLLVMHasMetadataOtherThanDebugLoc(branch) != 0
                return branch
            null

        # The 64-bit two-input word phi the compare tests.
        def digit_loop_word(body: LLVMBasicBlockRef, compare: LLVMValueRef) -> LLVMValueRef?:
            word: LLVMValueRef = LLVMGetOperand(compare, 0)
            return null if not is_llvm_instruction_with_opcode(word, LLVMOpcode::PHI) or LLVMGetInstructionParent(word) != body
            return null if not is_llvm_integer_type(LLVMTypeOf(word), 64) or LLVMCountIncoming(word) != 2
            return null if phi_incoming_index(word, body) < 0
            word

        def digit_loop_with_count(body: LLVMBasicBlockRef, branch: LLVMValueRef, word: LLVMValueRef, quotient: LLVMValueRef, shape: DigitLoopShape) -> DigitLoop?:
            entry_edge: u32 = 1 - phi_incoming_index(word, body).u32()
            entry: LLVMBasicBlockRef = LLVMGetIncomingBlock(word, entry_edge)
            if neighbouring_phi(body, word) is count:
                return null if count == word or not is_llvm_integer_type(LLVMTypeOf(count), 64) or LLVMCountIncoming(count) != 2
                if phi_incoming_for_block(count, entry) is start:
                    return null if not is_constant_integer(start, shape.initial_count)
                    if block_increment_of(body, count) is next:
                        return DigitLoop{word: word, quotient: quotient, count: count, next: next, compare: LLVMGetCondition(branch), branch: branch, entry: entry, entry_edge: entry_edge}
            null

        def match_digit_loop(body: LLVMBasicBlockRef, shape: DigitLoopShape) -> DigitLoop?:
            if digit_loop_branch(body, shape.predicate) is branch:
                if digit_loop_word(body, LLVMGetCondition(branch)) is word:
                    quotient: LLVMValueRef = LLVMGetIncomingValue(word, phi_incoming_index(word, body).u32())
                    return null if not is_llvm_instruction_with_opcode(quotient, shape.division_opcode) or LLVMGetInstructionParent(quotient) != body
                    return null if LLVMGetExact(quotient) != 0 or LLVMGetOperand(quotient, 0) != word
                    return digit_loop_with_count(body, branch, word, quotient, shape)
            null

        def is_digit_loop_member(instruction: LLVMValueRef, loop: DigitLoop&) -> bool:
            instruction == loop.word or instruction == loop.quotient or instruction == loop.count or instruction == loop.next or instruction == loop.compare or instruction == loop.branch

        # Every instruction of the body belongs to the loop, and (except the
        # instructions `allowed` names) is used only inside the body; `next`
        # may also feed `width`.
        def digit_loop_is_closed(body: LLVMBasicBlockRef, loop: DigitLoop&, counts_escape: bool, width: LLVMValueRef?) -> bool:
            cursor: mutable LLVMValueRef? = LLVMGetFirstInstruction(body)
            while cursor is instruction |cursor, body, loop, counts_escape, width|:
                return false if not is_digit_loop_member(instruction, loop)
                escapes: bool = counts_escape and (instruction == loop.count or instruction == loop.next)
                if not escapes:
                    use_cursor: mutable LLVMUseRef? = LLVMGetFirstUse(instruction)
                    while use_cursor is use |use_cursor, instruction, body, loop, width|:
                        user: LLVMValueRef = LLVMGetUser(use)
                        return false if LLVMIsAInstruction(user) == null
                        if LLVMGetInstructionParent(user) != body:
                            return false if instruction != loop.next or not is_optional_value(width, user)
                        use_cursor <- LLVMGetNextUse(use)
                cursor <- LLVMGetNextInstruction(instruction)
            true

        def build_highest_bit(builder: LLVMBuilderRef, module: LLVMModuleRef, input: LLVMValueRef) -> LLVMValueRef can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            i64_type: LLVMTypeRef = LLVMTypeOf(input)
            nonzero: LLVMValueRef = LLVMBuildOr(builder, input, LLVMConstInt(i64_type, 1, 0), "")
            zeros: LLVMValueRef = build_count_leading_zeros(builder, module, nonzero)
            LLVMBuildSub(builder, LLVMConstInt(i64_type, 63, 0), zeros, "")

        # The exit phi that takes `next` from the body and 1 from the entry,
        # when every other exit phi takes the same value from both edges.
        def power_digit_width(exit: LLVMBasicBlockRef, body: LLVMBasicBlockRef, loop: DigitLoop&) -> LLVMValueRef?:
            width: mutable LLVMValueRef? = null
            cursor: mutable LLVMValueRef? = LLVMGetFirstInstruction(exit)
            while cursor is phi |cursor, width, exit, body, loop|:
                break if not is_llvm_instruction_with_opcode(phi, LLVMOpcode::PHI)
                from_body: LLVMValueRef? = phi_incoming_for_block(phi, body)
                from_entry: LLVMValueRef? = phi_incoming_for_block(phi, loop.entry)
                takes_width: bool = is_optional_value(from_body, loop.next) and is_optional_constant_integer(from_entry, 1) and width == null
                if takes_width:
                    width <- phi
                else:
                    return null if not same_optional_value(from_body, from_entry)
                cursor <- LLVMGetNextInstruction(phi)
            width

        # The width loop `while word > 2^(2s) - 1: word >>= s` entered when
        # `input > 2^s - 1`, whose count of shifts plus one is
        # `highest_bit(input) / s + 1`; the entry branch then skips the loop.
        def fold_power_of_two_digit_count(body: LLVMBasicBlockRef, module: LLVMModuleRef, builder: LLVMBuilderRef) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            shape: DigitLoopShape = DigitLoopShape{predicate: LLVMIntPredicate::UGT, division_opcode: LLVMOpcode::LSHR, initial_count: 1}
            if match_digit_loop(body, shape) is loop:
                return false if LLVMGetSuccessor(loop.branch, 0) != body
                exit: LLVMBasicBlockRef = LLVMGetSuccessor(loop.branch, 1)
                return false if exit == body
                shift: LLVMValueRef = LLVMGetOperand(loop.quotient, 1)
                return false if LLVMIsAConstantInt(shift) == null
                bits: u64 = LLVMConstIntGetZExtValue(shift)
                return false if bits == 0 or bits >= DecimalDigitLimits::MAX_SHIFT
                return false if not is_constant_integer(LLVMGetOperand(loop.compare, 1), (1.u64() << (2 * bits)) - 1)
                input: LLVMValueRef = LLVMGetIncomingValue(loop.word, loop.entry_edge)
                if conditional_terminator(loop.entry) is entry_branch:
                    entry_compare: LLVMValueRef = LLVMGetCondition(entry_branch)
                    return false if not is_llvm_instruction_with_opcode(entry_compare, LLVMOpcode::ICMP) or LLVMGetICmpPredicate(entry_compare) != LLVMIntPredicate::UGT
                    return false if LLVMGetSuccessor(entry_branch, 0) != body or LLVMGetSuccessor(entry_branch, 1) != exit
                    return false if LLVMGetOperand(entry_compare, 0) != input or not is_constant_integer(LLVMGetOperand(entry_compare, 1), (1.u64() << bits) - 1)
                    if power_digit_width(exit, body, &loop) is width:
                        return false if not digit_loop_is_closed(body, &loop, false, width)
                        position_builder_before(builder, entry_branch)
                        i64_type: LLVMTypeRef = LLVMTypeOf(input)
                        highest_bit: LLVMValueRef = build_highest_bit(builder, module, LLVMBuildFreeze(builder, input, ""))
                        digits: LLVMValueRef = LLVMBuildAdd(builder, LLVMBuildUDiv(builder, highest_bit, LLVMConstInt(i64_type, bits, 0), ""), LLVMConstInt(i64_type, 1, 0), "")
                        set_phi_incoming_for_block(width, loop.entry, digits)
                        LLVMSetCondition(entry_branch, LLVMConstInt(LLVMInt1TypeInContext(LLVMGetModuleContext(module)), 0, 0))
                        return true
            false

        # The private table of 10^1 .. 10^19 the decimal estimate is checked against.
        def decimal_power_table(module: LLVMModuleRef) -> LLVMValueRef can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            i64_type: LLVMTypeRef = LLVMInt64TypeInContext(LLVMGetModuleContext(module))
            powers: mutable darray[LLVMValueRef] = []
            power: mutable u64 = 10
            for index in 0..<DecimalDigitLimits::POWER_COUNT |powers, power, i64_type|:
                powers.push(LLVMConstInt(i64_type, power, 0))
                power <- power * 10 if index + 1 < DecimalDigitLimits::POWER_COUNT
            table_type: LLVMTypeRef = LLVMArrayType2(i64_type, DecimalDigitLimits::POWER_COUNT)
            name_storage: mutable darray[u8] = []
            table: LLVMValueRef = LLVMAddGlobal(module, table_type, sview_to_cstr("decimal.digit.powers", name_storage))
            power_slots: void& = (&powers[0]).cast[void&] can Unsafe.PointerCast
            LLVMSetInitializer(table, LLVMConstArray2(i64_type, power_slots, DecimalDigitLimits::POWER_COUNT))
            LLVMSetGlobalConstant(table, 1)
            LLVMSetLinkage(table, LLVMLinkageValue::PRIVATE)
            LLVMSetUnnamedAddress(table, LLVMUnnamedAddressValue::GLOBAL)
            table

        def existing_or_new_power_table(module: LLVMModuleRef, table: LLVMValueRef?) -> LLVMValueRef can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            if table is existing:
                return existing
            decimal_power_table(module)

        # `digits - 1 = estimate + (input >= 10^(estimate + 1))`, built at the
        # top of the loop body; the loop then exits after one visit.
        def build_decimal_digit_count(builder: LLVMBuilderRef, module: LLVMModuleRef, input: LLVMValueRef, table: LLVMValueRef) -> LLVMValueRef can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            i64_type: LLVMTypeRef = LLVMTypeOf(input)
            highest_bit: LLVMValueRef = build_highest_bit(builder, module, input)
            scaled: LLVMValueRef = LLVMBuildMul(builder, highest_bit, LLVMConstInt(i64_type, DecimalDigitLimits::LOG10_2_NUMERATOR, 0), "")
            estimate: LLVMValueRef = LLVMBuildLShr(builder, scaled, LLVMConstInt(i64_type, DecimalDigitLimits::LOG10_2_SHIFT, 0), "")
            indices: mutable darray[LLVMValueRef] = [LLVMConstInt(i64_type, 0, 0), estimate]
            index_slots: void& = (&indices[0]).cast[void&] can Unsafe.PointerCast
            address: LLVMValueRef = LLVMBuildInBoundsGEP2(builder, LLVMArrayType2(i64_type, DecimalDigitLimits::POWER_COUNT), table, index_slots, 2, "")
            threshold: LLVMValueRef = LLVMBuildLoad2(builder, i64_type, address, "")
            adjustment: LLVMValueRef = LLVMBuildZExt(builder, LLVMBuildICmp(builder, LLVMIntPredicate::UGE, input, threshold, ""), i64_type, "")
            LLVMBuildAdd(builder, estimate, adjustment, "decimal.last.count")

        # `while word >= 10: word /= 10` counting its visits from 0.
        def fold_decimal_digit_count(body: LLVMBasicBlockRef, module: LLVMModuleRef, builder: LLVMBuilderRef, table: LLVMValueRef?) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            shape: DigitLoopShape = DigitLoopShape{predicate: LLVMIntPredicate::ULT, division_opcode: LLVMOpcode::UDIV, initial_count: 0}
            if match_digit_loop(body, shape) is loop:
                return null if LLVMGetSuccessor(loop.branch, 0) == body or LLVMGetSuccessor(loop.branch, 1) != body
                return null if not is_constant_integer(LLVMGetOperand(loop.compare, 1), 10) or not is_constant_integer(LLVMGetOperand(loop.quotient, 1), 10)
                return null if not digit_loop_is_closed(body, &loop, true, null)
                powers: LLVMValueRef = existing_or_new_power_table(module, table)
                LLVMPositionBuilderBefore(builder, first_non_phi(body))
                set_builder_debug_location(builder, loop.next)
                input: LLVMValueRef = LLVMBuildFreeze(builder, LLVMGetIncomingValue(loop.word, loop.entry_edge), "")
                last_count: LLVMValueRef = build_decimal_digit_count(builder, module, input, powers)
                digits: LLVMValueRef = LLVMBuildAdd(builder, last_count, LLVMConstInt(LLVMTypeOf(input), 1, 0), "decimal.digits")
                replace_uses_outside_block(loop.count, last_count, body)
                replace_uses_outside_block(loop.next, digits, body)
                LLVMSetCondition(loop.branch, LLVMConstInt(LLVMInt1TypeInContext(LLVMGetModuleContext(module)), 1, 0))
                return powers
            null

    public:
        def fold_decimal_digit_counts(module: LLVMModuleRef) -> u32 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Unsafe.PointerArithmetic]:
            return 0 if not module_targets_aarch64(module)
            builder: LLVMBuilderRef = LLVMCreateBuilderInContext(LLVMGetModuleContext(module))
            changed: mutable u32 = 0
            table: mutable LLVMValueRef? = null
            function_cursor: mutable LLVMValueRef? = LLVMGetFirstFunction(module)
            while function_cursor is function |function_cursor, changed, table, builder, module|:
                if not skipped_by_loop_pass_policy(function, module) and function_block_count(function) <= DecimalDigitLimits::MAX_FUNCTION_BLOCKS:
                    block_cursor: mutable LLVMBasicBlockRef? = LLVMGetFirstBasicBlock(function)
                    while block_cursor is block |block_cursor, changed, table, builder, module|:
                        if fold_power_of_two_digit_count(block, module, builder):
                            changed <- changed + 1
                        else:
                            if fold_decimal_digit_count(block, module, builder, table) is powers:
                                table <- powers
                                changed <- changed + 1
                        block_cursor <- LLVMGetNextBasicBlock(block)
                function_cursor <- LLVMGetNextFunction(function)
            LLVMDisposeBuilder(builder)
            changed
