# Replaces consecutive even steps of a counted parity recurrence with one trailing-zero count
# and a variable shift. A single-block loop stepping `word` to `word / 2` when even and
# `3 * word + 1` when odd, counting steps until the word is 1, instead takes the odd step (if
# any) and then every following halving at once. Zero remains a nonterminating state,
# including when the wrapping odd update produces zero: `cttz(0)` masked to 63 shifts nothing.
include "../../ir/ir_editing.elisa"
include "../../ir/loop_pass_policy.elisa"

const module HalvingRunLimit:
    BODY_INSTRUCTIONS: u32 = 11
    FUNCTION_BLOCKS: u32 = 128

# The eleven instructions of one halving-run body.
struct HalvingRun:
    word: LLVMValueRef
    count: LLVMValueRef
    half: LLVMValueRef
    bit: LLVMValueRef
    parity: LLVMValueRef
    triple: LLVMValueRef
    odd: LLVMValueRef
    next: LLVMValueRef
    step: LLVMValueRef
    done: LLVMValueRef
    branch: LLVMValueRef

# The loop-exit test of a halving-run body: its branch, the `next == 1` compare, and `next`.
struct HalvingExit:
    branch: LLVMValueRef
    done: LLVMValueRef
    next: LLVMValueRef

extend Backend:
    private:
        def is_halving_constant(value: LLVMValueRef, expected: u64) -> bool:
            LLVMIsAConstantInt(value) != null and ElisaLLVMConstantIntEquals(value, expected) != 0

        # The operand of `value <opcode> constant` other than the constant; either side for
        # the commutative opcodes (add, mul, and).
        def halving_other_operand(value: LLVMValueRef?, opcode: u32, constant: u64) -> LLVMValueRef?:
            operation: LLVMValueRef = get value else return null
            return null if not is_llvm_instruction_with_opcode(operation, opcode)
            return LLVMGetOperand(operation, 0) if is_halving_constant(LLVMGetOperand(operation, 1), constant)
            commutative: bool = opcode == LLVMOpcode::ADD or opcode == LLVMOpcode::MUL or opcode == LLVMOpcode::AND
            return LLVMGetOperand(operation, 1) if commutative and is_halving_constant(LLVMGetOperand(operation, 0), constant)
            null

        # The operand an `==`/`!=` compare tests against the constant.
        def halving_equality_operand(compare: LLVMValueRef?, constant: u64) -> LLVMValueRef?:
            tested: LLVMValueRef = get compare else return null
            return null if not is_llvm_instruction_with_opcode(tested, LLVMOpcode::ICMP)
            predicate: i32 = LLVMGetICmpPredicate(tested)
            return null if predicate != LLVMIntPredicate::EQ and predicate != LLVMIntPredicate::NE
            return LLVMGetOperand(tested, 0) if is_halving_constant(LLVMGetOperand(tested, 1), constant)
            return LLVMGetOperand(tested, 1) if is_halving_constant(LLVMGetOperand(tested, 0), constant)
            null

        # The loop-exit test `next == 1` of a body that branches back to itself until done.
        def halving_exit(body: LLVMBasicBlockRef) -> HalvingExit? can[Abort.Panic]:
            branch: LLVMValueRef = get conditional_terminator(body) else return null
            done: LLVMValueRef = LLVMGetCondition(branch)
            next: LLVMValueRef = get halving_equality_operand(done, 1) else return null
            return null if not is_llvm_instruction_with_opcode(next, LLVMOpcode::SELECT) or LLVMGetInstructionParent(next) != body
            return null if not is_llvm_integer_type(LLVMTypeOf(next), 64) or ElisaLLVMHasMetadataOtherThanDebugLoc(branch) != 0
            exit_index: u32 = 0 if LLVMGetICmpPredicate(done) == LLVMIntPredicate::EQ else 1
            return null if LLVMGetSuccessor(branch, 1 - exit_index) != body or LLVMGetSuccessor(branch, exit_index) == body
            HalvingExit{branch: branch, done: done, next: next}

        # The recurrence `next = parity ? half : odd` over the word phi, and its step counter.
        def halving_run(body: LLVMBasicBlockRef) -> HalvingRun? can[Abort.Panic]:
            exit: HalvingExit = get halving_exit(body) else return null
            parity: LLVMValueRef = LLVMGetOperand(exit.next, 0)
            bit: LLVMValueRef = get halving_equality_operand(parity, 0) else return null
            word: LLVMValueRef = get halving_other_operand(bit, LLVMOpcode::AND, 1) else return null
            return null if not is_llvm_instruction_with_opcode(word, LLVMOpcode::PHI) or LLVMGetInstructionParent(word) != body or LLVMCountIncoming(word) != 2
            return null if not optional_equals(phi_incoming_for_block(word, body), exit.next)
            even_true: bool = LLVMGetICmpPredicate(parity) == LLVMIntPredicate::EQ
            half: LLVMValueRef = LLVMGetOperand(exit.next, 1 if even_true else 2)
            odd: LLVMValueRef = LLVMGetOperand(exit.next, 2 if even_true else 1)
            triple: LLVMValueRef = get halving_other_operand(odd, LLVMOpcode::ADD, 1) else return null
            return null if not optional_equals(halving_other_operand(triple, LLVMOpcode::MUL, 3), word) or not optional_equals(halving_other_operand(half, LLVMOpcode::LSHR, 1), word)
            count: LLVMValueRef = get halving_counter(body, word) else return null
            step: LLVMValueRef = get phi_incoming_for_block(count, body) else return null
            return null if not optional_equals(halving_other_operand(step, LLVMOpcode::ADD, 1), count)
            HalvingRun{word: word, count: count, half: half, bit: bit, parity: parity, triple: triple, odd: odd, next: exit.next, step: step, done: exit.done, branch: exit.branch}

        # The step-counter phi: the instruction after the word phi, else the block's first.
        def halving_counter(body: LLVMBasicBlockRef, word: LLVMValueRef) -> LLVMValueRef?:
            counter: mutable LLVMValueRef = get LLVMGetNextInstruction(word) else return null
            if not is_llvm_instruction_with_opcode(counter, LLVMOpcode::PHI):
                counter <- get LLVMGetFirstInstruction(body) else return null
            return null if not is_llvm_instruction_with_opcode(counter, LLVMOpcode::PHI) or counter == word or LLVMTypeOf(counter) != LLVMTypeOf(word)
            return null if LLVMCountIncoming(counter) != 2 or phi_incoming_index(counter, body) < 0
            counter

        def is_halving_run_member(run: HalvingRun&, instruction: LLVMValueRef) -> bool:
            instruction == run.word or instruction == run.count or instruction == run.half or instruction == run.bit or instruction == run.parity or instruction == run.triple or instruction == run.odd or instruction == run.next or instruction == run.step or instruction == run.done or instruction == run.branch

        # Every instruction of the body is part of the run, and only the counter's step is
        # used outside it: the state lives in the two phis.
        def halving_run_is_closed(body: LLVMBasicBlockRef, run: HalvingRun&) -> bool:
            instruction_cursor: mutable LLVMValueRef? = LLVMGetFirstInstruction(body)
            while instruction_cursor is instruction |instruction_cursor, body, run|:
                instruction_cursor <- LLVMGetNextInstruction(instruction)
                return false if not is_halving_run_member(run, instruction)
                continue if instruction == run.step
                use_cursor: mutable LLVMUseRef? = LLVMGetFirstUse(instruction)
                while use_cursor is use |use_cursor, body|:
                    use_cursor <- LLVMGetNextUse(use)
                    user: LLVMValueRef = LLVMGetUser(use)
                    return false if LLVMIsAInstruction(user) == null or LLVMGetInstructionParent(user) != body
            true

        # Takes the odd step if the word is odd, then every halving it is followed by.
        def fold_halving_run(run: HalvingRun&, module: LLVMModuleRef, builder: LLVMBuilderRef) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            even_true: bool = LLVMGetICmpPredicate(run.parity) == LLVMIntPredicate::EQ
            position_builder_before(builder, run.next)
            context: LLVMContextRef = LLVMGetModuleContext(module)
            even: LLVMValueRef = LLVMBuildSelect(builder, run.parity, run.word if even_true else run.odd, run.odd if even_true else run.word, "halving.even")
            raw_zeros: LLVMValueRef = build_count_trailing_zeros(builder, module, even)
            zeros: LLVMValueRef = LLVMBuildAnd(builder, raw_zeros, LLVMConstInt(LLVMInt64TypeInContext(context), 63, 0), "halving.count")
            shifted: LLVMValueRef = LLVMBuildLShr(builder, even, zeros, "halving.next")
            delta: LLVMValueRef = LLVMBuildAdd(builder, run.bit, zeros, "")
            steps: LLVMValueRef = LLVMBuildAdd(builder, run.count, delta, "halving.steps")
            LLVMReplaceAllUsesWith(run.next, shifted)
            LLVMReplaceAllUsesWith(run.step, steps)

        def fold_halving_run_in(body: LLVMBasicBlockRef, module: LLVMModuleRef, builder: LLVMBuilderRef) -> u32 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            return 0 if instruction_count(body) != HalvingRunLimit::BODY_INSTRUCTIONS or ElisaLLVMBlockHasAddressTaken(body) != 0
            run: HalvingRun = get halving_run(body) else return 0
            return 0 if not halving_run_is_closed(body, &run)
            fold_halving_run(&run, module, builder)
            1

    public:
        # The halving runs of counted parity recurrences folded, on AArch64.
        def fold_halving_runs(module: LLVMModuleRef) -> u32 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            return 0 if not module_targets_aarch64(module)
            builder: LLVMBuilderRef = LLVMCreateBuilderInContext(LLVMGetModuleContext(module))
            changed: mutable u32 = 0
            function_cursor: mutable LLVMValueRef? = LLVMGetFirstFunction(module)
            while function_cursor is function |changed, function_cursor, module, builder|:
                function_cursor <- LLVMGetNextFunction(function)
                continue if skipped_by_loop_pass_policy(function, module) or function_block_count(function) > HalvingRunLimit::FUNCTION_BLOCKS
                block_cursor: mutable LLVMBasicBlockRef? = LLVMGetFirstBasicBlock(function)
                while block_cursor is block |block_cursor, changed, module, builder|:
                    block_cursor <- LLVMGetNextBasicBlock(block)
                    changed <- changed + fold_halving_run_in(block, module, builder)
            LLVMDisposeBuilder(builder)
            changed
