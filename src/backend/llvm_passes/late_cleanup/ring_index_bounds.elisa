# Folds `index < capacity` to true for a ring index: a zero-seeded loop-header phi whose
# back edge is `next = index + 1; next == limit ? 0 : next`, where the loop-invariant limit
# is proven nonzero and at most the constant capacity on entry to the loop. The index then
# never leaves [0, limit).
include "../ir/ir_editing.elisa"
include "../ir/loop_pass_policy.elisa"

# A bounds check on a ring index, with the facts the structural match found: the phi
# incoming that seeds it and the limit its wrap compares against.
struct RingIndexCheck:
    check: LLVMValueRef
    index: LLVMValueRef
    capacity: LLVMValueRef
    seed_edge: u32
    limit: LLVMValueRef

extend Backend:
    private:
        def is_integer_constant_equal(value: LLVMValueRef, expected: u64) -> bool:
            LLVMIsAConstantInt(value) != null and ElisaLLVMConstantIntEquals(value, expected) != 0

        # `next` is `index + 1`, in either operand order.
        def is_ring_increment(next: LLVMValueRef, index: LLVMValueRef) -> bool:
            return false if not is_llvm_instruction_with_opcode(next, LLVMOpcode::ADD)
            (LLVMGetOperand(next, 0) == index and is_integer_constant_equal(LLVMGetOperand(next, 1), 1)) or (LLVMGetOperand(next, 1) == index and is_integer_constant_equal(LLVMGetOperand(next, 0), 1))

        # The limit of the wrap `next == limit ? 0 : next` feeding INDEX's other edge.
        def ring_wrap_limit(index: LLVMValueRef, seed_edge: u32) -> LLVMValueRef?:
            wrap: LLVMValueRef = LLVMGetIncomingValue(index, 1 - seed_edge)
            return null if not is_llvm_instruction_with_opcode(wrap, LLVMOpcode::SELECT)
            test: LLVMValueRef = LLVMGetOperand(wrap, 0)
            next: LLVMValueRef = LLVMGetOperand(wrap, 2)
            return null if not is_llvm_instruction_with_opcode(test, LLVMOpcode::ICMP) or LLVMGetICmpPredicate(test) != LLVMIntPredicate::EQ
            return null if not is_integer_constant_equal(LLVMGetOperand(wrap, 1), 0) or not is_ring_increment(next, index)
            return LLVMGetOperand(test, 1) if LLVMGetOperand(test, 0) == next
            return LLVMGetOperand(test, 0) if LLVMGetOperand(test, 1) == next
            null

        # The ring-index shape of a block's `index ult capacity` branch condition.
        def ring_index_check(block: LLVMBasicBlockRef) -> RingIndexCheck?:
            branch: LLVMValueRef = get conditional_terminator(block) else return null
            check: LLVMValueRef = LLVMGetCondition(branch)
            return null if not is_llvm_instruction_with_opcode(check, LLVMOpcode::ICMP) or LLVMGetICmpPredicate(check) != LLVMIntPredicate::ULT
            index: LLVMValueRef = LLVMGetOperand(check, 0)
            capacity: LLVMValueRef = LLVMGetOperand(check, 1)
            return null if not is_llvm_instruction_with_opcode(index, LLVMOpcode::PHI) or LLVMIsAConstantInt(capacity) == null
            return null if LLVMCountIncoming(index) != 2 or LLVMGetInstructionParent(index) != LLVMGetInstructionParent(check) or ElisaLLVMConstantIntEquals(capacity, 0) != 0
            seed_edge: u32 = 0 if is_integer_constant_equal(LLVMGetIncomingValue(index, 0), 0) else 1
            return null if not is_integer_constant_equal(LLVMGetIncomingValue(index, seed_edge), 0)
            limit: LLVMValueRef = get ring_wrap_limit(index, seed_edge) else return null
            RingIndexCheck{check: check, index: index, capacity: capacity, seed_edge: seed_edge, limit: limit}

        # On entry to the loop the limit is defined, neither undef nor poison, nonzero and
        # at most the capacity.
        def limit_bounded_on_entry(candidate: RingIndexCheck&, entry_terminator: LLVMValueRef, analyses: ElisaFunctionAnalysesRef) -> bool:
            limit: LLVMValueRef = candidate.limit
            return false if LLVMIsAInstruction(limit) != null and ElisaLLVMInstructionDominates(analyses, limit, entry_terminator) == 0
            return false if ElisaLLVMIsGuaranteedNotToBeUndefOrPoisonAt(analyses, limit, entry_terminator) == 0
            range: ElisaConstantRangeRef = ElisaLLVMLazyValueConstantRange(analyses, limit, entry_terminator, 0)
            bounded: bool = ElisaLLVMConstantRangeIsEmpty(range) == 0 and ElisaLLVMConstantRangeContains(range, 0) == 0 and ElisaLLVMConstantRangeUnsignedMaxAtMost(range, candidate.capacity) != 0
            ElisaLLVMDisposeConstantRange(range)
            bounded

        # The index is the header phi of a loop entered from its seed edge and latched by
        # its wrap edge, and the limit is invariant in that loop and bounded on entry.
        def ring_index_bound_proven(candidate: RingIndexCheck&, analyses: ElisaFunctionAnalysesRef) -> bool:
            header: LLVMBasicBlockRef = LLVMGetInstructionParent(candidate.index)
            entry: LLVMBasicBlockRef = LLVMGetIncomingBlock(candidate.index, candidate.seed_edge)
            loop: ElisaLoopRef = get ElisaLLVMLoopForBlock(analyses, header) else return false
            return false if ElisaLLVMLoopHeader(loop) != header or not same_optional_block(ElisaLLVMLoopPredecessor(loop), entry)
            return false if not same_optional_block(ElisaLLVMLoopLatch(loop), LLVMGetIncomingBlock(candidate.index, 1 - candidate.seed_edge))
            return false if ElisaLLVMLoopIsInvariant(loop, candidate.limit) == 0
            entry_terminator: LLVMValueRef = get LLVMGetBasicBlockTerminator(entry) else return false
            limit_bounded_on_entry(candidate, entry_terminator, analyses)

        def same_optional_block(block: LLVMBasicBlockRef?, expected: LLVMBasicBlockRef) -> bool:
            if block is present:
                return present == expected
            false

        def ring_index_checks(function: LLVMValueRef) -> darray[RingIndexCheck] can[Memory.Allocate]:
            candidates: mutable darray[RingIndexCheck] = []
            block_cursor: mutable LLVMBasicBlockRef? = LLVMGetFirstBasicBlock(function)
            while block_cursor is block |block_cursor, candidates|:
                block_cursor <- LLVMGetNextBasicBlock(block)
                if ring_index_check(block) is candidate:
                    candidates.push(candidate)
            candidates

        # The function's ring-index checks proven in bounds, each replaced by true.
        def fold_function_ring_index_bounds(function: LLVMValueRef) -> u32 can[Abort.Panic, Memory.Allocate]:
            candidates: darray[RingIndexCheck] = ring_index_checks(function)
            return 0 if candidates.count == 0
            proven: mutable darray[LLVMValueRef] = []
            if ElisaLLVMCreateFunctionAnalyses(function) is analyses:
                for candidate_index in 0..<candidates.count |candidates, analyses, proven|:
                    proven.push(candidates[candidate_index].check) if ring_index_bound_proven(&candidates[candidate_index], analyses)
                ElisaLLVMDisposeFunctionAnalyses(analyses)
            for check in proven:
                LLVMReplaceAllUsesWith(check, LLVMConstInt(LLVMTypeOf(check), 1, 0))
            proven.count.u32()

    public:
        # The ring-index bounds checks folded to true.
        def fold_ring_index_bounds(module: LLVMModuleRef) -> u32 can[Abort.Panic, Memory.Allocate]:
            changed: mutable u32 = 0
            function_cursor: mutable LLVMValueRef? = LLVMGetFirstFunction(module)
            while function_cursor is function |changed, function_cursor, module|:
                function_cursor <- LLVMGetNextFunction(function)
                continue if skipped_by_loop_pass_policy(function, module)
                changed <- changed + fold_function_ring_index_bounds(function)
            changed
