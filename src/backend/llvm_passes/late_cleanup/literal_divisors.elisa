# Preserves constant-divisor lowering when a shared helper survives inlining. A local helper
# dividing by one of its i32 arguments at least twice, called with exactly two literal
# divisors, is cloned once per literal so each clone divides by a constant; a clone with one
# call inside a loop is then inlined into its caller.
include "../ir/ir_editing.elisa"
include "../ir/loop_pass_policy.elisa"

const module LiteralDivisorLimit:
    MAXIMUM_FUNCTIONS: u32 = 2048
    GROWTH: u32 = 1024
    MAXIMUM_ARGUMENTS: u32 = 8
    MINIMUM_USES: u32 = 2
    MAXIMUM_USES: u32 = 8
    MINIMUM_COST: u32 = 12
    MAXIMUM_COST: u32 = 320
    MAXIMUM_LITERAL: u64 = 65535
    LITERALS: usize = 2
    DIVISIONS: u32 = 2
    INLINE_COST: u32 = 192
    CALLER_COST: u32 = 512
    MUST_TAIL: u32 = 2

# The helper's calls, each with its literal divisor, and the two distinct literals.
struct LiteralDivisorCalls:
    calls: mutable darray[LLVMValueRef]
    divisors: mutable darray[LLVMValueRef]
    literals: mutable darray[LLVMValueRef]

extend Backend:
    private:
        def call_has_function_attribute(call: LLVMValueRef, name: sview) -> bool can[Abort.Panic, Memory.Allocate]:
            name_storage: mutable darray[u8] = []
            kind: u32 = LLVMGetEnumAttributeKindForName(sview_to_cstr(name, name_storage), name.len)
            kind != 0 and ElisaLLVMCallHasFunctionAttribute(call, kind) != 0

        # A call the helper may keep when cloned: a memory intrinsic or `llvm.trap` without
        # operand bundles that is neither convergent nor non-duplicable.
        def is_duplicable_intrinsic_call(call: LLVMValueRef) -> bool can[Abort.Panic, Memory.Allocate]:
            intrinsic: u32 = called_intrinsic_id(call)
            return false if intrinsic == 0 or LLVMGetNumOperandBundles(call) != 0
            return false if call_has_function_attribute(call, "convergent") or call_has_function_attribute(call, "noduplicate")
            name_storage: mutable darray[u8] = []
            ElisaLLVMIsMemIntrinsic(call) != 0 or intrinsic == LLVMLookupIntrinsicID(sview_to_cstr("llvm.trap", name_storage), 9)

        def argument_number(function: LLVMValueRef, argument: LLVMValueRef) -> i64:
            for index in 0..<LLVMCountParams(function) |function, argument|:
                return index.i64() if LLVMGetParam(function, index) == argument
            -1

        # The i32 argument the helper divides by (`udiv`/`urem`, through a freeze) at least
        # twice; none when the helper has an address-taken or EH block, or a call other
        # than a duplicable intrinsic.
        def literal_divisor_argument(function: LLVMValueRef) -> i64 can[Abort.Panic, Memory.Allocate]:
            block_cursor: mutable LLVMBasicBlockRef? = LLVMGetFirstBasicBlock(function)
            while block_cursor is block |block_cursor|:
                block_cursor <- LLVMGetNextBasicBlock(block)
                return -1 if ElisaLLVMBlockHasAddressTaken(block) != 0 or ElisaLLVMBlockIsEHPad(block) != 0
            counts: mutable darray[u32] = [0, 0, 0, 0, 0, 0, 0, 0]
            block_cursor <- LLVMGetFirstBasicBlock(function)
            while block_cursor is block |block_cursor, counts, function|:
                block_cursor <- LLVMGetNextBasicBlock(block)
                instruction_cursor: mutable LLVMValueRef? = LLVMGetFirstInstruction(block)
                while instruction_cursor is instruction |instruction_cursor, counts, function|:
                    instruction_cursor <- LLVMGetNextInstruction(instruction)
                    return -1 if is_call_base(instruction) and not is_duplicable_intrinsic_call(instruction)
                    opcode: u32 = LLVMGetInstructionOpcode(instruction)
                    continue if opcode != LLVMOpcode::UDIV and opcode != LLVMOpcode::UREM
                    divisor: mutable LLVMValueRef = LLVMGetOperand(instruction, 1)
                    if is_llvm_instruction_with_opcode(divisor, LLVMOpcode::FREEZE):
                        divisor <- LLVMGetOperand(divisor, 0)
                    continue if LLVMIsAArgument(divisor) == null
                    index: i64 = argument_number(function, divisor)
                    counts[index.usize()] <- counts[index.usize()] + 1 if index >= 0
            for index in 0..<LLVMCountParams(function) |counts, function|:
                return index.i64() if counts[index.usize()] >= LiteralDivisorLimit::DIVISIONS and is_llvm_integer_type(LLVMTypeOf(LLVMGetParam(function, index)), 32)
            -1

        def is_specializable_helper(function: LLVMValueRef, module: LLVMModuleRef) -> bool can[Abort.Panic, Memory.Allocate]:
            linkage: u32 = LLVMGetLinkage(function)
            return false if linkage != LLVMLinkageValue::INTERNAL and linkage != LLVMLinkageValue::PRIVATE
            return false if LLVMIsFunctionVarArg(LLVMGlobalGetValueType(function)) != 0 or LLVMCountParams(function) > LiteralDivisorLimit::MAXIMUM_ARGUMENTS or LLVMGetComdat(function) != null
            return false if function_has_attribute(function, "convergent") or function_has_attribute(function, "noduplicate") or function_has_attribute(function, "returns_twice")
            uses: u32 = use_count(function)
            return false if uses < LiteralDivisorLimit::MINIMUM_USES or uses > LiteralDivisorLimit::MAXIMUM_USES
            not skipped_by_loop_pass_policy(function, module)

        # The literal divisor of USE's call of FUNCTION, when the use is a plain direct call
        # from another function.
        def literal_divisor_of(use: LLVMUseRef, function: LLVMValueRef, index: u32) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate]:
            call: LLVMValueRef = LLVMGetUser(use)
            return null if LLVMIsACallInst(call) == null or ElisaLLVMUseOperandNumber(use) != LLVMGetNumOperands(call) - 1
            return null if LLVMGetBasicBlockParent(LLVMGetInstructionParent(call)) == function or LLVMGetCalledFunctionType(call) != LLVMGlobalGetValueType(function)
            return null if LLVMGetTailCallKind(call) == LiteralDivisorLimit::MUST_TAIL or call_has_function_attribute(call, "convergent") or LLVMGetNumOperandBundles(call) != 0
            literal: LLVMValueRef = LLVMGetOperand(call, index)
            return null if LLVMIsAConstantInt(literal) == null or LLVMConstIntGetZExtValue(literal) <= 1 or LLVMConstIntGetZExtValue(literal) > LiteralDivisorLimit::MAXIMUM_LITERAL
            literal

        def contains_value(values: darray[LLVMValueRef]&, wanted: LLVMValueRef) -> bool:
            for value in values |wanted|:
                return true if value == wanted
            false

        # Every use of FUNCTION is such a call, with exactly two distinct literals.
        def literal_divisor_calls(function: LLVMValueRef, index: u32) -> LiteralDivisorCalls? can[Abort.Panic, Memory.Allocate]:
            found: mutable LiteralDivisorCalls = LiteralDivisorCalls{calls: [], divisors: [], literals: []}
            use_cursor: mutable LLVMUseRef? = LLVMGetFirstUse(function)
            while use_cursor is use |use_cursor, found, function, index|:
                use_cursor <- LLVMGetNextUse(use)
                literal: LLVMValueRef = get literal_divisor_of(use, function, index) else return null
                if not contains_value(&found.literals, literal):
                    return null if found.literals.count == LiteralDivisorLimit::LITERALS
                    found.literals.push(literal)
                found.calls.push(LLVMGetUser(use))
                found.divisors.push(literal)
            return null if found.literals.count != LiteralDivisorLimit::LITERALS
            found

        # FUNCTION's name followed by `.literal_divisor`, NUL-terminated.
        def literal_divisor_name(function: LLVMValueRef) -> darray[u8] can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            length: mutable usize = 0
            bytes: u8& = LLVMGetValueName2(function, &length)
            name: sview = unsafe_sview_bounded_bytes(bytes, length)
            text: mutable darray[u8] = []
            for position in 0..<name.len |text, name|:
                text.push(name[position])
            suffix: sview = ".literal_divisor"
            for position in 0..<suffix.len |text, suffix|:
                text.push(suffix[position])
            text.push(0)
            text

        # One clone of FUNCTION per literal, each called by that literal's calls.
        def clone_per_literal(function: LLVMValueRef, index: u32, found: LiteralDivisorCalls&, clones: mutable darray[LLVMValueRef]&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            name: mutable darray[u8] = literal_divisor_name(function)
            name_text: cstr = (&name[0]).cast[cstr] can Unsafe.PointerCast
            for literal in found.literals |function, index, found, clones, name_text, name|:
                clone: LLVMValueRef = ElisaLLVMCloneFunction(function)
                LLVMSetValueName2(clone, name_text, name.count - 1)
                LLVMReplaceAllUsesWith(LLVMGetParam(clone, index), literal)
                for position in 0..<found.calls.count |found, literal, clone|:
                    call: LLVMValueRef = found.calls[position]
                    LLVMSetOperand(call, LLVMGetNumOperands(call) - 1, clone) if found.divisors[position] == literal
                clones.push(clone)

        # `instcombine,simplifycfg` over each function; false when the pipeline fails.
        def simplify_functions(functions: darray[LLVMValueRef]&, target: void&?) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            options: LLVMPassBuilderOptionsRef = LLVMCreatePassBuilderOptions()
            pipeline_storage: mutable darray[u8] = []
            pipeline: cstr = sview_to_cstr("instcombine<no-verify-fixpoint>,simplifycfg", pipeline_storage)
            for function in functions |options, pipeline, target|:
                if LLVMRunPassesOnFunction(function, pipeline, target, options) is pipeline_error:
                    LLVMConsumeError(pipeline_error)
                    LLVMDisposePassBuilderOptions(options)
                    return false
            LLVMDisposePassBuilderOptions(options)
            true

        # CLONE's single call, when it sits in a loop of a small enough caller.
        def inlinable_loop_call(clone: LLVMValueRef, module: LLVMModuleRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate]:
            return null if not has_one_use(clone) or function_instruction_count(clone) > LiteralDivisorLimit::INLINE_COST
            use: LLVMUseRef = get LLVMGetFirstUse(clone) else return null
            call: LLVMValueRef = LLVMGetUser(use)
            return null if LLVMIsACallInst(call) == null or call_has_function_attribute(call, "noinline")
            caller: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInstructionParent(call))
            return null if skipped_by_loop_pass_policy(caller, module) or function_instruction_count(caller) > LiteralDivisorLimit::CALLER_COST
            analyses: ElisaFunctionAnalysesRef = get ElisaLLVMCreateFunctionAnalyses(caller) else return null
            in_loop: bool = ElisaLLVMLoopForBlock(analyses, LLVMGetInstructionParent(call)) != null
            ElisaLLVMDisposeFunctionAnalyses(analyses)
            call if in_loop else null

        # A single caller can absorb the specialized body without duplicating it; only
        # loop calls, where each iteration pays the call overhead, are inlined.
        def inline_loop_clones(clones: darray[LLVMValueRef]&, module: LLVMModuleRef) -> darray[LLVMValueRef] can[Abort.Panic, Memory.Allocate]:
            callers: mutable darray[LLVMValueRef] = []
            for clone in clones |callers, module|:
                if inlinable_loop_call(clone, module) is call:
                    caller: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInstructionParent(call))
                    if ElisaLLVMInlineCall(call) != 0:
                        LLVMDeleteFunction(clone)
                        callers.push(caller) if not contains_value(&callers, caller)
            callers

        # The clones of every specializable helper, the helpers deleted.
        def clone_literal_divisor_helpers(module: LLVMModuleRef) -> darray[LLVMValueRef] can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            clones: mutable darray[LLVMValueRef] = []
            remaining_growth: mutable u32 = LiteralDivisorLimit::GROWTH
            # The next function is taken before a helper is deleted; clones appended after the
            # current function are visited too, as the C++ early-increment walk did.
            function_cursor: mutable LLVMValueRef? = LLVMGetFirstFunction(module)
            while function_cursor is function |function_cursor, clones, remaining_growth, module|:
                function_cursor <- LLVMGetNextFunction(function)
                continue if not is_specializable_helper(function, module)
                cost: u32 = function_instruction_count(function)
                continue if cost < LiteralDivisorLimit::MINIMUM_COST or cost > LiteralDivisorLimit::MAXIMUM_COST or cost > remaining_growth
                index: i64 = literal_divisor_argument(function)
                continue if index < 0
                if literal_divisor_calls(function, index.u32()) is found:
                    clone_per_literal(function, index.u32(), &found, clones)
                    remaining_growth <- remaining_growth - cost
                    LLVMDeleteFunction(function)
            clones

    public:
        # 0 when nothing was specialized, 1 when helpers were cloned, 2 when a cleanup
        # pipeline failed (LateCleanupStatus). Without a target machine (`elisac llvm-pass`)
        # the cleanups run without target information.
        def specialize_literal_divisors(module: LLVMModuleRef, target: void&?) -> u32 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            return 0 if not module_targets_aarch64(module) or module_function_count(module) > LiteralDivisorLimit::MAXIMUM_FUNCTIONS
            clones: darray[LLVMValueRef] = clone_literal_divisor_helpers(module)
            return 0 if clones.count == 0
            return 2 if not simplify_functions(&clones, target)
            callers: darray[LLVMValueRef] = inline_loop_clones(&clones, module)
            return 2 if not simplify_functions(&callers, target)
            1
