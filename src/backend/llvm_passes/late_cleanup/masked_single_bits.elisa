# Fuses a single-bit test: `x > 0 && ctpop(x) < 2 ? (x & M) != 0 : false`, with the mask
# test in its own block, becomes one branch-free expression. A value with at most one bit
# set, selected by a mask that excludes the sign bit, is already positive, so the
# positivity check folds into the mask. The population count is rebuilt as
# `x & (x - 1) == 0` over a frozen `x`: the original `ctpop` may carry a result range
# justified only by the old positive arm.
include "../ir/ir_editing.elisa"
include "../ir/loop_pass_policy.elisa"

const module MaskedSingleBitLimit:
    FUNCTION_BLOCKS: u32 = 16
    MASK_INSTRUCTIONS: u32 = 4
    NARROW_WIDTH: u32 = 32

# The matched shape: `branch` tests `select`; `mask_block` holds `zext((x & mask) != 0)`
# and jumps to the phi `result` in `exit`.
struct MaskedSingleBit:
    branch: LLVMValueRef
    select: LLVMValueRef
    input: LLVMValueRef
    mask: LLVMValueRef
    mask_block: LLVMBasicBlockRef
    exit: LLVMBasicBlockRef
    result: LLVMValueRef

extend Backend:
    private:
        def is_integer_constant(value: LLVMValueRef, expected: u64) -> bool:
            LLVMIsAConstantInt(value) != null and ElisaLLVMConstantIntEquals(value, expected) != 0

        def is_compare_with_constant(value: LLVMValueRef, predicate: i32, limit: u64) -> bool can[Abort.Panic]:
            is_llvm_instruction_with_opcode(value, LLVMOpcode::ICMP) and LLVMGetICmpPredicate(value) == predicate and is_integer_constant(LLVMGetOperand(value, 1), limit)

        # PHINode::getIncomingValueForBlock: the first incoming value from `block`.
        def incoming_value_for_block(phi: LLVMValueRef, block: LLVMBasicBlockRef) -> LLVMValueRef?:
            for incoming in 0..<LLVMCountIncoming(phi) |phi, block|:
                return LLVMGetIncomingValue(phi, incoming) if LLVMGetIncomingBlock(phi, incoming) == block
            null

        # PHINode::setIncomingValueForBlock: every incoming value from `block`.
        def set_incoming_value_for_block(phi: LLVMValueRef, block: LLVMBasicBlockRef, value: LLVMValueRef) -> void:
            for incoming in 0..<LLVMCountIncoming(phi) |phi, block, value|:
                LLVMSetOperand(phi, incoming, value) if LLVMGetIncomingBlock(phi, incoming) == block

        def is_in_block(value: LLVMValueRef, opcode: u32, block: LLVMBasicBlockRef) -> bool:
            is_llvm_instruction_with_opcode(value, opcode) and LLVMGetInstructionParent(value) == block

        # `x > 0 && ctpop(x) < 2`, as `select (x > 0), (ctpop(x) < 2), false`: its `x`.
        def single_bit_select_input(select: LLVMValueRef, ctpop_id: u32) -> LLVMValueRef? can[Abort.Panic]:
            return null if not is_llvm_instruction_with_opcode(select, LLVMOpcode::SELECT) or not has_one_use(select) or not is_integer_constant(LLVMGetOperand(select, 2), 0)
            positive: LLVMValueRef = LLVMGetOperand(select, 0)
            small_count: LLVMValueRef = LLVMGetOperand(select, 1)
            return null if not is_compare_with_constant(positive, LLVMIntPredicate::SGT, 0) or not is_llvm_instruction_with_opcode(small_count, LLVMOpcode::ICMP)
            count: LLVMValueRef = LLVMGetOperand(small_count, 0)
            return null if called_intrinsic_id(count) != ctpop_id or not has_one_use(count) or not has_one_use(small_count) or not is_compare_with_constant(small_count, LLVMIntPredicate::ULT, 2)
            input: LLVMValueRef = LLVMGetOperand(positive, 0)
            input if LLVMGetOperand(count, 0) == input else null

        # Whether `mask_block` only feeds `exit`, entered from `block` alone.
        def is_mask_block(block: LLVMBasicBlockRef, mask_block: LLVMBasicBlockRef, exit: LLVMBasicBlockRef) -> bool can[Abort.Panic]:
            return false if exit == block or mask_block == exit or ElisaLLVMBlockHasAddressTaken(mask_block) != 0
            if single_predecessor(mask_block) is predecessor:
                return false if predecessor != block or instruction_count(mask_block) != MaskedSingleBitLimit::MASK_INSTRUCTIONS
                if LLVMGetBasicBlockTerminator(mask_block) is jump:
                    return LLVMGetInstructionOpcode(jump) == LLVMOpcode::UNCONDITIONAL_BR and LLVMGetSuccessor(jump, 0) == exit and block_has_phis(exit)
            false

        # The mask `M` of `zext((input & M) != 0)` computed in `mask_block`, if non-negative.
        def single_bit_mask(extend: LLVMValueRef, input: LLVMValueRef, mask_block: LLVMBasicBlockRef) -> LLVMValueRef? can[Abort.Panic]:
            return null if not is_in_block(extend, LLVMOpcode::ZEXT, mask_block)
            nonzero: LLVMValueRef = LLVMGetOperand(extend, 0)
            return null if not is_in_block(nonzero, LLVMOpcode::ICMP, mask_block) or not is_compare_with_constant(nonzero, LLVMIntPredicate::NE, 0)
            masked: LLVMValueRef = LLVMGetOperand(nonzero, 0)
            return null if not is_in_block(masked, LLVMOpcode::AND, mask_block) or LLVMGetOperand(masked, 0) != input
            mask: LLVMValueRef = LLVMGetOperand(masked, 1)
            mask if LLVMIsAConstantInt(mask) != null and ElisaLLVMConstantIntIsNegative(mask) == 0 else null

        def match_masked_single_bit(block: LLVMBasicBlockRef, ctpop_id: u32) -> MaskedSingleBit? can[Abort.Panic]:
            if conditional_terminator(block) is branch:
                select: LLVMValueRef = LLVMGetCondition(branch)
                if single_bit_select_input(select, ctpop_id) is input:
                    mask_block: LLVMBasicBlockRef = LLVMGetSuccessor(branch, 0)
                    exit: LLVMBasicBlockRef = LLVMGetSuccessor(branch, 1)
                    return null if not is_mask_block(block, mask_block, exit)
                    if LLVMGetFirstInstruction(exit) is result:
                        if LLVMGetNextInstruction(result) is after_result:
                            return null if is_llvm_instruction_with_opcode(after_result, LLVMOpcode::PHI)
                        if incoming_value_for_block(result, block) is from_block:
                            return null if not is_integer_constant(from_block, 0)
                            if incoming_value_for_block(result, mask_block) is extend:
                                if single_bit_mask(extend, input, mask_block) is mask:
                                    return MaskedSingleBit{branch: branch, select: select, input: input, mask: mask, mask_block: mask_block, exit: exit, result: result}
            null

        # `zext(x & (x - 1) == 0 and (x & M) != 0)` on the edge to `exit`; the mask block goes.
        def fuse_masked_single_bit(builder: LLVMBuilderRef, shape: MaskedSingleBit&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            position_builder_before(builder, shape.branch)
            stable: LLVMValueRef = LLVMBuildFreeze(builder, shape.input, "")
            width_type: LLVMTypeRef = LLVMTypeOf(stable)
            minus_one: LLVMValueRef = LLVMBuildSub(builder, stable, LLVMConstInt(width_type, 1, 0), "")
            cleared: LLVMValueRef = LLVMBuildAnd(builder, stable, minus_one, "")
            single: LLVMValueRef = LLVMBuildICmp(builder, LLVMIntPredicate::EQ, cleared, LLVMConstNull(width_type), "")
            mask_input: mutable LLVMValueRef = stable
            mask: mutable LLVMValueRef = shape.mask
            if LLVMGetIntTypeWidth(width_type) > MaskedSingleBitLimit::NARROW_WIDTH and ElisaLLVMConstantIntActiveBits(shape.mask) <= MaskedSingleBitLimit::NARROW_WIDTH:
                narrow_type: LLVMTypeRef = LLVMInt32TypeInContext(LLVMGetTypeContext(width_type))
                mask_input <- LLVMBuildTrunc(builder, stable, narrow_type, "")
                mask <- LLVMConstInt(narrow_type, LLVMConstIntGetZExtValue(shape.mask), 0)
            selected: LLVMValueRef = LLVMBuildAnd(builder, mask_input, mask, "")
            has_bit: LLVMValueRef = LLVMBuildICmp(builder, LLVMIntPredicate::NE, selected, LLVMConstNull(LLVMTypeOf(mask_input)), "")
            both: LLVMValueRef = LLVMBuildAnd(builder, single, has_bit, "")
            set_incoming_value_for_block(shape.result, LLVMGetInstructionParent(shape.branch), LLVMBuildZExt(builder, both, LLVMTypeOf(shape.result), ""))
            LLVMBuildBr(builder, shape.exit)
            LLVMInstructionEraseFromParent(shape.branch)
            dead_blocks: mutable darray[LLVMBasicBlockRef] = [shape.mask_block]
            ElisaLLVMDeleteDeadBlocks((&dead_blocks[0]).cast[void&], 1) can Unsafe.PointerCast
            ElisaLLVMRecursivelyDeleteTriviallyDeadInstructions(shape.select)

    public:
        # The single-bit tests fused; at most one per function.
        def fold_masked_single_bits(module: LLVMModuleRef) -> u32 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            return 0 if not module_targets_aarch64(module)
            name_storage: mutable darray[u8] = []
            ctpop_name: sview = "llvm.ctpop"
            ctpop_id: u32 = LLVMLookupIntrinsicID(sview_to_cstr(ctpop_name, name_storage), ctpop_name.len.usize())
            builder: LLVMBuilderRef = LLVMCreateBuilderInContext(LLVMGetModuleContext(module))
            changed: mutable u32 = 0
            function_cursor: mutable LLVMValueRef? = LLVMGetFirstFunction(module)
            while function_cursor is function |changed, function_cursor, builder, ctpop_id, module|:
                function_cursor <- LLVMGetNextFunction(function)
                continue if function_block_count(function) > MaskedSingleBitLimit::FUNCTION_BLOCKS or skipped_by_loop_pass_policy(function, module)
                block_cursor: mutable LLVMBasicBlockRef? = LLVMGetFirstBasicBlock(function)
                while block_cursor is block |block_cursor, builder, ctpop_id, changed|:
                    block_cursor <- LLVMGetNextBasicBlock(block)
                    if match_masked_single_bit(block, ctpop_id) is shape:
                        fuse_masked_single_bit(builder, &shape)
                        changed <- changed + 1
                        break
            LLVMDisposeBuilder(builder)
            changed
