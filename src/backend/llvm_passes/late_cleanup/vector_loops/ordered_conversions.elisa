# Ordered integer-to-float reductions and paired loop counters for a small AArch64 module.
#
# Only a module of one defined function and at most 2000 instructions, without debug
# info, is considered, which bounds the extra work for compiler builds. When the ordered
# casts change a function, `instcombine` cleans up after them and that function's loop
# counters are paired. On an AArch64 Linux compiler targeting Linux, such a function is
# marked `elisa.ordered.ilp`.
include "./ordered_casts.elisa"
include "./paired_counters.elisa"

const module OrderedConversionLimit:
    FUNCTIONS: u32 = 1
    INSTRUCTIONS: u32 = 2000

extend Backend:
    private:
        # At most one defined function, of at most 2000 instructions in all.
        def within_ordered_conversion_budget(module: LLVMModuleRef) -> bool can[Abort.Panic, Memory.Allocate]:
            functions: mutable u32 = 0
            instructions: mutable u32 = 0
            function_cursor: mutable LLVMValueRef? = LLVMGetFirstFunction(module)
            while function_cursor is function |function_cursor, functions, instructions|:
                function_cursor <- LLVMGetNextFunction(function)
                continue if LLVMIsDeclaration(function) != 0
                functions <- functions + 1
                return false if functions > OrderedConversionLimit::FUNCTIONS
                instructions <- instructions + function_instruction_count(function)
                return false if instructions > OrderedConversionLimit::INSTRUCTIONS
            true

        def mark_ordered_ilp(function: LLVMValueRef, module: LLVMModuleRef) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            static if ELISA_TARGET_OS_LINUX and ELISA_TARGET_ARCH_ARM64:
                if ElisaLLVMModuleTargetIsLinux(module) != 0:
                    key_storage: mutable darray[u8] = []
                    value_storage: mutable darray[u8] = []
                    marker: LLVMAttributeRef = LLVMCreateStringAttribute(LLVMGetModuleContext(module), sview_to_cstr("elisa.ordered.ilp", key_storage), 17, sview_to_cstr("", value_storage), 0)
                    LLVMAddAttributeAtIndex(function, LLVMAttributeIndexValue::FUNCTION, marker)

    public:
        # 1 when the ordered casts changed the module's function, 2 when the cleanup
        # pipeline failed, otherwise 0.
        def optimize_ordered_conversions(module: LLVMModuleRef, target: void&?) -> u32 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            machine: void& = get target else return 0
            return 0 if ElisaLLVMModuleTargetIsAArch64(module) == 0 or module_has_named_metadata(module, "llvm.dbg.cu")
            return 0 if not within_ordered_conversion_budget(module)
            builder: LLVMBuilderRef = LLVMCreateBuilderInContext(LLVMGetModuleContext(module))
            selected: mutable darray[LLVMValueRef] = []
            function_cursor: mutable LLVMValueRef? = LLVMGetFirstFunction(module)
            while function_cursor is function |function_cursor, selected, builder, module|:
                function_cursor <- LLVMGetNextFunction(function)
                if LLVMIsDeclaration(function) == 0 and order_function_conversions(function, builder):
                    selected.push(function)
                    mark_ordered_ilp(function, module)
            status: mutable u32 = 0
            if selected.count != 0:
                status <- 2
                if run_module_pipeline(module, machine, "function(instcombine<no-verify-fixpoint>)"):
                    for function in selected |builder|:
                        _ = pair_function_counters(function, builder)
                    status <- 1
            LLVMDisposeBuilder(builder)
            status

        # The functions the ordered casts change, counted, for `elisac llvm-pass`.
        def order_module_conversions(module: LLVMModuleRef) -> u32 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            builder: LLVMBuilderRef = LLVMCreateBuilderInContext(LLVMGetModuleContext(module))
            changed: mutable u32 = 0
            function_cursor: mutable LLVMValueRef? = LLVMGetFirstFunction(module)
            while function_cursor is function |function_cursor, changed, builder|:
                function_cursor <- LLVMGetNextFunction(function)
                changed <- changed + 1 if order_function_conversions(function, builder) else changed
            LLVMDisposeBuilder(builder)
            changed

        # The functions whose loop counters are paired, counted, for `elisac llvm-pass`.
        def pair_module_counters(module: LLVMModuleRef) -> u32 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            builder: LLVMBuilderRef = LLVMCreateBuilderInContext(LLVMGetModuleContext(module))
            changed: mutable u32 = 0
            function_cursor: mutable LLVMValueRef? = LLVMGetFirstFunction(module)
            while function_cursor is function |function_cursor, changed, builder|:
                function_cursor <- LLVMGetNextFunction(function)
                changed <- changed + 1 if pair_function_counters(function, builder) else changed
            LLVMDisposeBuilder(builder)
            changed
