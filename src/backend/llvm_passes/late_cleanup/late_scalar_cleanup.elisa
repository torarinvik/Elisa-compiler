# The late scalar cleanup: every rewrite that runs after the main O3
# pipeline, in order, with the follow-up pipelines their changes need.
# Returns 0 when nothing changed, 1 when the module changed (the caller
# then propagates the exposed facts) and 2 when a pipeline failed.
#
# The rewrites are C++ passes reached through llvm_late_cleanup_entries.h,
# until each is ported to Elisa. The host conditions mirror the C++ code
# this replaced: Linux AArch64 and Darwin AArch64 hosts run different
# follow-up pipelines, each qualified by its own measurements.
include "../ir/llvm_ir_queries.elisa"
include "./late_cleanup_externs.elisa"
include "./conditional_doubling.elisa"
include "./decimal_digit_counts.elisa"
include "./power_positions.elisa"
include "./validation_return_layout.elisa"
include "./shared_reciprocals.elisa"
include "./guarded_increments.elisa"
include "./nonnegative_remainders.elisa"
include "./masked_single_bits.elisa"

const module LateCleanupStatus:
    UNCHANGED: u32 = 0
    CHANGED: u32 = 1
    FAILED: u32 = 2

const module LateCleanupPipeline:
    SCAN_CLEANUP: sview = "function(early-cse,instcombine<max-iterations=8;no-verify-fixpoint>,loop-simplify,lcssa,loop(indvars),gvn,instcombine<max-iterations=8;no-verify-fixpoint>,simplifycfg)"
    PROPAGATE: sview = "function(correlated-propagation,instcombine<no-verify-fixpoint>,simplifycfg)"
    FACTORIAL_VECTORIZE: sview = "function(correlated-propagation,instcombine<no-verify-fixpoint>,simplifycfg,loop-simplify,lcssa,indvars,loop-vectorize,instcombine<no-verify-fixpoint>,simplifycfg)"
    COMBINE: sview = "function(instcombine<no-verify-fixpoint>,simplifycfg)"
    PRODUCT_VECTORIZE: sview = "function(correlated-propagation,instcombine<no-verify-fixpoint>,simplifycfg,loop-simplify,lcssa,loop-vectorize,instcombine<no-verify-fixpoint>,simplifycfg)"
    FULL_O3: sview = "default<O3>"
    GUARDED_COUNTERS: sview = "function(instcombine<no-verify-fixpoint>,simplifycfg,loop-simplify,lcssa,loop(indvars),instcombine<no-verify-fixpoint>,simplifycfg)"
    REVECTORIZE: sview = "loop-simplify,lcssa,loop-vectorize,instcombine<no-verify-fixpoint>,simplifycfg"
    SIGNED_CALLER: sview = "function(sccp,instcombine<no-verify-fixpoint>,simplifycfg)"

extend Backend:
    private:
        # Runs a pass pipeline over the module; false when LLVM reports an error.
        def run_module_pipeline(module: LLVMModuleRef, target: void&, pipeline: sview) -> bool can[Abort.Panic, Memory.Allocate]:
            options: LLVMPassBuilderOptionsRef = LLVMCreatePassBuilderOptions()
            text_storage: mutable darray[u8] = []
            pipeline_error: void&? = LLVMRunPasses(module, sview_to_cstr(pipeline, text_storage), target, options)
            LLVMDisposePassBuilderOptions(options)
            if pipeline_error is real_error:
                LLVMConsumeError(real_error)
                return false
            true

        def run_function_pipeline(function: LLVMValueRef, target: void&, pipeline: sview) -> bool can[Abort.Panic, Memory.Allocate]:
            options: LLVMPassBuilderOptionsRef = LLVMCreatePassBuilderOptions()
            text_storage: mutable darray[u8] = []
            pipeline_error: void&? = LLVMRunPassesOnFunction(function, sview_to_cstr(pipeline, text_storage), target, options)
            LLVMDisposePassBuilderOptions(options)
            if pipeline_error is real_error:
                LLVMConsumeError(real_error)
                return false
            true

        def module_function_count(module: LLVMModuleRef) -> u32:
            count: mutable u32 = 0
            cursor: mutable LLVMValueRef? = LLVMGetFirstFunction(module)
            while cursor is function |cursor, count|:
                count <- count + 1
                cursor <- LLVMGetNextFunction(function)
            count

        # A buffer with one slot per function of the module (and one more, so
        # it is never empty), for the entries that report functions back. The
        # slots are not optional: stage0 lays out `darray[T?]` of an extern
        # type with a tag word, so only plain pointers cross to C. Slots past
        # the count an entry reports hold a placeholder and are never read.
        def function_buffer(module: LLVMModuleRef) -> darray[LLVMValueRef] can[Abort.Panic, Memory.Allocate]:
            placeholder: LLVMValueRef = LLVMConstInt(LLVMInt1TypeInContext(LLVMGetModuleContext(module)), 0, 0)
            buffer: mutable darray[LLVMValueRef] = []
            for _ in 0..<(module_function_count(module) + 1) |buffer, placeholder|:
                buffer.push(placeholder)
            buffer

        def combine_status(status: u32, changed: bool) -> u32:
            LateCleanupStatus::CHANGED if changed else status

        # The scan rewrites and the cleanup their changes need on this host.
        def late_scan_rewrites(module: LLVMModuleRef, target: void&) -> bool can[Abort.Panic, Memory.Allocate]:
            elisacoreElideArrayRoundTrips(module)
            scans: u32 = elisacorePredicatePrivateBitUpdates(module) + elisacoreInlineSmallRecursion(module) + elisacoreUnrollNestedScans(module)
            static if ELISA_TARGET_OS_MACOS and ELISA_TARGET_ARCH_ARM64:
                return run_module_pipeline(module, target, LateCleanupPipeline::SCAN_CLEANUP)
            static if ELISA_TARGET_OS_LINUX and ELISA_TARGET_ARCH_ARM64:
                return run_module_pipeline(module, target, LateCleanupPipeline::SCAN_CLEANUP) if scans != 0
            true

        # Arithmetic proofs, each followed by the pipeline its rewrite needs.
        def late_arithmetic_rewrites(module: LLVMModuleRef, target: void&, initial: u32) -> u32 can[Abort.Panic, Memory.Allocate]:
            status: mutable u32 = initial
            if elisacoreUnrollBoundedDivisionLoops(module) != 0:
                return LateCleanupStatus::FAILED if not run_module_pipeline(module, target, LateCleanupPipeline::PROPAGATE)
                status <- LateCleanupStatus::CHANGED
            if elisacoreBoundedFactorials(module) != 0:
                return LateCleanupStatus::FAILED if not run_module_pipeline(module, target, LateCleanupPipeline::FACTORIAL_VECTORIZE)
                status <- LateCleanupStatus::CHANGED
            if elisacoreUnrollLaggedRecurrences(module) != 0:
                return LateCleanupStatus::FAILED if not run_module_pipeline(module, target, LateCleanupPipeline::COMBINE)
                status <- LateCleanupStatus::CHANGED
            if elisacoreBoundedProducts(module) != 0:
                # Revisit reductions made vectorizable by the product proof. The
                # Darwin/ARM64 ordering is qualified; Linux keeps its scalar one.
                darwin_aarch64: bool = module_targets_darwin_aarch64(module)
                cleanup: sview = LateCleanupPipeline::PRODUCT_VECTORIZE if darwin_aarch64 else LateCleanupPipeline::PROPAGATE
                return LateCleanupStatus::FAILED if not run_module_pipeline(module, target, cleanup)
                status <- LateCleanupStatus::CHANGED
            status

        def late_range_rewrites(module: LLVMModuleRef, target: void&, initial: u32) -> u32 can[Abort.Panic, Memory.Allocate]:
            status: mutable u32 = initial
            static if ELISA_TARGET_OS_MACOS and ELISA_TARGET_ARCH_ARM64:
                status <- combine_status(status, elisacoreBoundedLoopUnswitch(module) != 0)
            status <- combine_status(status, elisacoreSinkPrivateInitializations(module) != 0)
            elisacoreEliminateCopiedScratch(module)
            sqrt_status: u32 = elisacoreOptimizeSqrtNonNaN(module, target)
            return LateCleanupStatus::FAILED if sqrt_status == LateCleanupStatus::FAILED
            status <- combine_status(status, sqrt_status != 0)
            sum_status: u32 = elisacoreOptimizeBoundedSums(module, target)
            return LateCleanupStatus::FAILED if sum_status == LateCleanupStatus::FAILED
            status <- combine_status(status, sum_status != 0)
            static if ELISA_TARGET_OS_MACOS and ELISA_TARGET_ARCH_ARM64:
                if module_targets_darwin_aarch64(module):
                    index_status: u32 = elisacoreOptimizeIndexBounds(module, target)
                    return LateCleanupStatus::FAILED if index_status == LateCleanupStatus::FAILED
                    status <- combine_status(status, index_status != 0)
            # A second full O3 pipeline, bounded to small modules, for outer
            # loops around an already vectorized inner loop.
            if elisacoreShouldRevisitNestedVectorLoops(module) != 0:
                return LateCleanupStatus::FAILED if not run_module_pipeline(module, target, LateCleanupPipeline::FULL_O3)
                status <- LateCleanupStatus::CHANGED
            status

        def late_guarded_counter_rewrites(module: LLVMModuleRef, target: void&, initial: u32) -> u32 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            status: mutable u32 = initial
            guarded: mutable u32 = fold_guarded_increments(module)
            vectorizable: mutable darray[LLVMValueRef] = function_buffer(module)
            vectorizable_count: mutable u32 = 0
            vectorizable_slots: void& = (&vectorizable[0]).cast[void&] can Unsafe.PointerCast
            guarded <- guarded + elisacoreFoldGuardedCounters(module, vectorizable_slots, vectorizable.count.u32(), &vectorizable_count)
            guarded <- guarded + fold_nonnegative_remainders(module)
            if guarded != 0:
                return LateCleanupStatus::FAILED if not run_module_pipeline(module, target, LateCleanupPipeline::GUARDED_COUNTERS)
                status <- LateCleanupStatus::CHANGED
            # Removing checked-counter exits can expose reductions to the vectorizer.
            for index in 0..<vectorizable_count.usize() |vectorizable, module, target|:
                return LateCleanupStatus::FAILED if not run_function_pipeline(vectorizable[index], target, LateCleanupPipeline::REVECTORIZE)
            status

        def late_fact_rewrites(module: LLVMModuleRef, target: void&, initial: u32) -> u32 can[Abort.Panic, Memory.Allocate]:
            status: mutable u32 = initial
            ordered: u32 = elisacoreOptimizeOrderedConversionsEntry(module, target)
            return LateCleanupStatus::FAILED if ordered == LateCleanupStatus::FAILED
            status <- combine_status(status, ordered != 0)
            status <- combine_status(status, elisacoreAnnotateArrayValueRangesEntry(module) != 0)
            status <- combine_status(status, elisacoreRemoveDeadTrapExitsEntry(module) != 0)
            status <- combine_status(status, elisacoreRemoveIndexedPrefixFillsOnly(module) != 0)
            status <- combine_status(status, elisacoreShrinkViewFills(module) != 0)
            status <- combine_status(status, elisacoreRemoveProvenChecksEntry(module) != 0)
            simplified: mutable u32 = elisacoreSpecializeValidationEpilogues(module)
            simplified <- simplified + elisacoreFoldBoundedTripChecks(module)
            simplified <- simplified + elisacoreFoldShiftParityLoopsEntry(module)
            simplified <- simplified + elisacoreFoldShiftBitReverseLoopsEntry(module)
            simplified <- simplified + (fold_power_positions(module) can[Unsafe.PointerCast, Unsafe.PointerArithmetic])
            simplified <- simplified + elisacoreFoldRingIndexBoundsEntry(module)
            simplified <- simplified + elisacoreFoldGuardedCounterBoundsEntry(module)
            simplified <- simplified + (fold_decimal_digit_counts(module) can[Unsafe.PointerCast, Unsafe.PointerArithmetic])
            simplified <- simplified + elisacoreFoldHalvingRunsEntry(module)
            simplified <- simplified + elisacoreFoldRangeAndLoopsEntry(module)
            simplified <- simplified + elisacoreFoldScalarLoopIdiomsEntry(module)
            simplified <- simplified + (fold_masked_single_bits(module) can Unsafe.PointerCast)
            simplified <- simplified + elisacoreFoldShiftXorLoopsEntry(module)
            if simplified != 0:
                return LateCleanupStatus::FAILED if not run_module_pipeline(module, target, LateCleanupPipeline::COMBINE)
                status <- LateCleanupStatus::CHANGED
            status

        def late_division_rewrites(module: LLVMModuleRef, target: void&, initial: u32) -> u32 can[Abort.Panic, Memory.Allocate]:
            status: mutable u32 = initial
            status <- combine_status(status, elisacoreCompactEvenRanges(module) != 0)
            status <- combine_status(status, (bias_validation_returns(module) can[Unsafe.PointerCast, Unsafe.PointerArithmetic]) != 0)
            status <- combine_status(status, elisacoreReuseEdgeDivisionsEntry(module) != 0)
            status <- combine_status(status, elisacoreSplitFactoredDivisionsEntry(module) != 0)
            status <- combine_status(status, elisacoreSplitRemainderRecurrencesEntry(module) != 0)
            status <- combine_status(status, elisacoreFoldConstantIntegerPathsEntry(module) != 0)
            status <- combine_status(status, elisacoreNarrowBoundedCarriesEntry(module) != 0)
            status <- combine_status(status, (fold_conditional_doubling(module) can[Unsafe.PointerCast, Unsafe.PointerArithmetic]) != 0)
            specialized: u32 = elisacoreSpecializeLiteralDivisorsEntry(module, target)
            return LateCleanupStatus::FAILED if specialized == LateCleanupStatus::FAILED
            status <- combine_status(status, specialized != 0)
            stack_views: u32 = elisacoreInlineStackViewHelpersEntry(module, target)
            return LateCleanupStatus::FAILED if stack_views == LateCleanupStatus::FAILED
            status <- combine_status(status, stack_views != 0)
            status <- combine_status(status, elisacoreFoldReverseByteReductionsEntry(module) != 0)
            status <- combine_status(status, elisacoreVersionBoundedQuotientSumsEntry(module) != 0)
            status <- combine_status(status, elisacoreFoldBoundedRemainders(module) != 0)
            status <- combine_status(status, elisacoreFoldSignedRangeMasks(module) != 0)
            status <- combine_status(status, elisacoreEliminateFullArrayInitializers(module) != 0)
            status <- combine_status(status, elisacoreForwardLoopLoads(module) != 0)
            elisacoreFoldOddTrailingZeroSelectsEntry(module)
            combine_status(status, elisacoreFoldInterleavedByteStoresEntry(module) != 0)

        def late_signed_check_rewrites(module: LLVMModuleRef, target: void&, initial: u32) -> u32 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            status: mutable u32 = initial
            callers: mutable darray[LLVMValueRef] = function_buffer(module)
            caller_count: mutable u32 = 0
            caller_slots: void& = (&callers[0]).cast[void&] can Unsafe.PointerCast
            status <- combine_status(status, elisacoreFoldProvenSignedChecks(module, target, caller_slots, callers.count.u32(), &caller_count) != 0)
            for index in 0..<caller_count.usize() |callers, module, target|:
                return LateCleanupStatus::FAILED if not run_function_pipeline(callers[index], target, LateCleanupPipeline::SIGNED_CALLER)
                elisacoreRefoldProvenSignedChecks(module, target, callers[index])
            status <- combine_status(status, elisacoreFoldRecursiveArgumentBounds(module) != 0)
            elisacoreFoldGuardedUnsignedComparisons(module)
            elisacoreFoldWideVectorOrAccumulators(module)
            status

    public:
        def late_scalar_cleanup(module: LLVMModuleRef, target: void&) -> u32 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            return LateCleanupStatus::FAILED if not late_scan_rewrites(module, target)
            shared_reciprocals: u32 = share_reciprocals(module)
            status: mutable u32 = elisacoreFastCheckedMul(module, target)
            status <- LateCleanupStatus::CHANGED if shared_reciprocals != 0 and status == LateCleanupStatus::UNCHANGED
            return LateCleanupStatus::FAILED if status == LateCleanupStatus::FAILED
            status <- late_arithmetic_rewrites(module, target, status)
            return status if status == LateCleanupStatus::FAILED
            status <- late_range_rewrites(module, target, status)
            return status if status == LateCleanupStatus::FAILED
            status <- late_guarded_counter_rewrites(module, target, status)
            return status if status == LateCleanupStatus::FAILED
            status <- late_fact_rewrites(module, target, status)
            return status if status == LateCleanupStatus::FAILED
            status <- late_division_rewrites(module, target, status)
            return status if status == LateCleanupStatus::FAILED
            late_signed_check_rewrites(module, target, status)
