# When an earlier unsigned upper bound excludes negative limits, the signed tests
# `value < 0 or value > limit` are one unsigned comparison:
#   select (limit >u upper), true, (value <s 0) | (value >s limit)
# becomes `select (limit >u upper), true, value >u limit` for a nonnegative `upper`.
include "../../ir/ir_editing.elisa"

extend Backend:
    private:
        # `value <s 0` or `0 >s value`.
        def compares_negative(condition: LLVMValueRef, value: LLVMValueRef) -> bool:
            return false if not is_llvm_instruction_with_opcode(condition, LLVMOpcode::ICMP)
            predicate: i32 = LLVMGetICmpPredicate(condition)
            right: LLVMValueRef = LLVMGetOperand(condition, 1)
            if LLVMIsAConstantInt(right) != null and ElisaLLVMConstantIntEquals(right, 0) != 0:
                return predicate == LLVMIntPredicate::SLT and LLVMGetOperand(condition, 0) == value
            left: LLVMValueRef = LLVMGetOperand(condition, 0)
            LLVMIsAConstantInt(left) != null and ElisaLLVMConstantIntEquals(left, 0) != 0 and predicate == LLVMIntPredicate::SGT and right == value

        # The value of `value >s limit` or `limit <s value`.
        def value_above_signed_limit(condition: LLVMValueRef, limit: LLVMValueRef) -> LLVMValueRef?:
            return null if not is_llvm_instruction_with_opcode(condition, LLVMOpcode::ICMP)
            predicate: i32 = LLVMGetICmpPredicate(condition)
            return LLVMGetOperand(condition, 0) if predicate == LLVMIntPredicate::SGT and LLVMGetOperand(condition, 1) == limit
            return LLVMGetOperand(condition, 1) if predicate == LLVMIntPredicate::SLT and LLVMGetOperand(condition, 0) == limit
            null

        def fold_guarded_unsigned_compare(select: LLVMValueRef, builder: LLVMBuilderRef) -> bool:
            return false if not is_llvm_instruction_with_opcode(select, LLVMOpcode::SELECT) or not is_llvm_integer_type(LLVMTypeOf(select), 1)
            guard_compare: LLVMValueRef = LLVMGetOperand(select, 0)
            either: LLVMValueRef = LLVMGetOperand(select, 2)
            reject: LLVMValueRef = LLVMGetOperand(select, 1)
            return false if LLVMIsAConstantInt(reject) == null or ElisaLLVMConstantIntEquals(reject, 1) == 0
            return false if not is_llvm_instruction_with_opcode(guard_compare, LLVMOpcode::ICMP) or LLVMGetICmpPredicate(guard_compare) != LLVMIntPredicate::UGT
            return false if not is_llvm_instruction_with_opcode(either, LLVMOpcode::OR)
            upper: LLVMValueRef = LLVMGetOperand(guard_compare, 1)
            return false if LLVMIsAConstantInt(upper) == null or ElisaLLVMConstantIntIsNegative(upper) != 0
            limit: LLVMValueRef = LLVMGetOperand(guard_compare, 0)
            for index in 0..<2 |either, limit, select, builder|:
                if value_above_signed_limit(LLVMGetOperand(either, index.u32()), limit) is input:
                    continue if not compares_negative(LLVMGetOperand(either, 1 - index.u32()), input)
                    position_builder_before(builder, select)
                    LLVMSetOperand(select, 2, LLVMBuildICmp(builder, LLVMIntPredicate::UGT, input, limit, ""))
                    ElisaLLVMRecursivelyDeleteTriviallyDeadInstructions(either)
                    return true
            false

    public:
        # The guarded signed range tests folded to one unsigned comparison, on AArch64.
        def fold_guarded_unsigned_compares(module: LLVMModuleRef) -> u32:
            return 0 if not module_targets_aarch64(module)
            builder: LLVMBuilderRef = LLVMCreateBuilderInContext(LLVMGetModuleContext(module))
            folded: mutable u32 = 0
            function_cursor: mutable LLVMValueRef? = LLVMGetFirstFunction(module)
            while function_cursor is function |function_cursor, folded, builder|:
                function_cursor <- LLVMGetNextFunction(function)
                block_cursor: mutable LLVMBasicBlockRef? = LLVMGetFirstBasicBlock(function)
                while block_cursor is block |block_cursor, folded, builder|:
                    block_cursor <- LLVMGetNextBasicBlock(block)
                    instruction_cursor: mutable LLVMValueRef? = LLVMGetFirstInstruction(block)
                    while instruction_cursor is instruction |instruction_cursor, folded, builder|:
                        instruction_cursor <- LLVMGetNextInstruction(instruction)
                        folded <- folded + 1 if fold_guarded_unsigned_compare(instruction, builder)
            LLVMDisposeBuilder(builder)
            folded
