# The Elisa-hosted LLVM passes by name, for `elisac llvm-pass`: each name
# runs one pass over a module exactly as the compile pipeline runs it.

extend Backend:
    public:
        # The pass's change count, or -1 when no pass has the name.
        def run_named_llvm_pass(name: cstr, module: LLVMModuleRef) -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Unsafe.PointerArithmetic]:
            return order_bit_test_operands(module).i64() if name == "bit-tests"
            return subtract_remainder_tests(module).i64() if name == "remainder-tests"
            return peel_remainder_tails(module).i64() if name == "remainder-tails"
            return mark_compact_shift_loops(module).i64() if name == "compact-shift-loops"
            return fold_conditional_doubling(module).i64() if name == "conditional-doubling"
            return fold_decimal_digit_counts(module).i64() if name == "decimal-digit-counts"
            return fold_power_positions(module).i64() if name == "power-positions"
            return bias_validation_returns(module).i64() if name == "validation-returns"
            return share_reciprocals(module).i64() if name == "shared-reciprocals"
            return fold_guarded_increments(module).i64() if name == "guarded-increments"
            return fold_nonnegative_remainders(module).i64() if name == "nonnegative-remainders"
            return fold_masked_single_bits(module).i64() if name == "masked-single-bits"
            return fold_interleaved_byte_stores(module).i64() if name == "interleaved-byte-stores"
            -1
