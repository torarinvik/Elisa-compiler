# The Elisa-hosted LLVM passes by name, for `elisac llvm-pass`: each name
# runs one pass over a module exactly as the compile pipeline runs it.

extend Backend:
    public:
        # The pass's change count, or -1 when no pass has the name. TARGET is the target
        # machine a pass that takes one gets.
        def run_named_llvm_pass(name: cstr, module: LLVMModuleRef, target: void&?) -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Unsafe.PointerArithmetic]:
            return order_bit_test_operands(module).i64() if name == "bit-tests"
            return subtract_remainder_tests(module).i64() if name == "remainder-tests"
            return peel_remainder_tails(module).i64() if name == "remainder-tails"
            return mark_compact_shift_loops(module).i64() if name == "compact-shift-loops"
            return fold_conditional_doubling(module).i64() if name == "conditional-doubling"
            return fold_decimal_digit_counts(module).i64() if name == "decimal-digit-counts"
            return fold_power_positions(module).i64() if name == "power-positions"
            return bias_validation_returns(module).i64() if name == "validation-returns"
            return share_reciprocals(module).i64() if name == "shared-reciprocals"
            return fold_guarded_increments(module).i64() if name == "guarded-increments"
            return fold_nonnegative_remainders(module).i64() if name == "nonnegative-remainders"
            return fold_masked_single_bits(module).i64() if name == "masked-single-bits"
            return fold_interleaved_byte_stores(module).i64() if name == "interleaved-byte-stores"
            return narrow_bounded_carries(module).i64() if name == "bounded-carries"
            return fold_ring_index_bounds(module).i64() if name == "ring-index-bounds"
            return (fold_halving_runs(module) can Unsafe.PointerCast).i64() if name == "halving-runs"
            return split_factored_divisions_in(module).i64() if name == "factored-divisions"
            return split_remainder_recurrences(module).i64() if name == "remainder-recurrences"
            return (fold_shift_parity_loops(module) can Unsafe.PointerCast).i64() if name == "shift-parity-loops"
            return fold_masked_split_multiplies(module).i64() if name == "masked-split-multiplies"
            return (connect_trap_exits(module) can Unsafe.PointerCast).i64() if name == "trap-exit-edges"
            return fold_shared_divisibility_tests(module).i64() if name == "shared-divisibility"
            return fold_guarded_counter_bounds(module).i64() if name == "guarded-counter-bounds"
            return (version_bounded_quotient_sums(module) can Unsafe.PointerCast).i64() if name == "bounded-quotient-sums"
            return specialize_literal_divisors(module, target).i64() if name == "literal-divisors"
            return fold_guarded_unsigned_compares(module).i64() if name == "guarded-unsigned-compares"
            return fold_wide_vector_or_accumulators(module).i64() if name == "vector-or-accumulators"
            return remove_exit_dead_stores(module).i64() if name == "exit-dead-stores"
            return fold_cssc_absolute_range_checks(module, target).i64() if name == "cssc-range-checks"
            return expand_small_fills(module).i64() if name == "small-fills"
            return unroll_guarded_reductions(module).i64() if name == "guarded-reductions"
            return (1 if version_first_loop_divisor(module) else 0) if name == "divisor-versioning"
            return fold_shift_bit_reverse_loops(module).i64() if name == "shift-bit-reverse-loops"
            return fold_range_and_loops(module).i64() if name == "range-and-loops"
            return fold_shift_xor_loops(module).i64() if name == "shift-xor-loops"
            return (1 if pair_early_divisions(module, target) else 0) if name == "early-division-pairs"
            return specialize_short_trips(module, target).i64() if name == "short-trips"
            return fold_guarded_counters(module).changed.i64() if name == "guarded-counters"
            return specialize_validation_epilogues(module).i64() if name == "validation-epilogues"
            return pack_private_bool_arrays(module, target).i64() if name == "private-bool-arrays"
            return fold_checked_multiplies(module, target).i64() if name == "checked-multiplies"
            return pool_floating_constants(module, target).i64() if name == "float-constant-pool"
            return prove_sqrt_domains(module).i64() if name == "sqrt-domain-proofs"
            return optimize_sqrt_domains(module, target).i64() if name == "sqrt-domains"
            return compact_even_ranges(module).i64() if name == "even-ranges"
            return unswitch_bounded_loops(module).i64() if name == "bounded-unswitch"
            return fold_signed_range_masks(module).i64() if name == "signed-range-masks"
            return fold_validated_index_bounds(module).i64() if name == "index-bounds"
            return fold_reverse_byte_reductions(module).i64() if name == "reverse-byte-reductions"
            return (1 if revisit_covered_arrays(module, true) else 0) if name == "covered-array-revisit"
            return (1 if (should_revisit_nested_vector_loops(module) can Unsafe.PointerCast) else 0) if name == "nested-vector-loops"
            return (thread_implied_loop_exits(module) can Unsafe.PointerCast).i64() if name == "implied-loop-exits"
            -1
