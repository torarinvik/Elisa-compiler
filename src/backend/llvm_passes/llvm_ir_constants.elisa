# LLVM C API enumerations used by the Elisa-hosted LLVM passes, named so
# pass code never compares an instruction against a bare number.

# `LLVMOpcode` from llvm-c/Core.h.
const module LLVMOpcode:
    RET: u32 = 1
    # LLVM 23 split the branch opcode in two; 2 is no longer used.
    UNCONDITIONAL_BR: u32 = 70
    CONDITIONAL_BR: u32 = 71
    INVOKE: u32 = 5
    UNREACHABLE: u32 = 7
    ADD: u32 = 8
    SUB: u32 = 10
    MUL: u32 = 12
    FMUL: u32 = 13
    UDIV: u32 = 14
    SDIV: u32 = 15
    FDIV: u32 = 16
    UREM: u32 = 17
    SREM: u32 = 18
    SHL: u32 = 20
    LSHR: u32 = 21
    ASHR: u32 = 22
    AND: u32 = 23
    OR: u32 = 24
    XOR: u32 = 25
    ALLOCA: u32 = 26
    LOAD: u32 = 27
    STORE: u32 = 28
    GET_ELEMENT_PTR: u32 = 29
    TRUNC: u32 = 30
    ZEXT: u32 = 31
    SEXT: u32 = 32
    ICMP: u32 = 42
    PHI: u32 = 44
    CALL: u32 = 45
    SELECT: u32 = 46
    EXTRACT_VALUE: u32 = 53
    CALL_BR: u32 = 67
    FREEZE: u32 = 68

# `LLVMIntPredicate` values are in ../llvm_c.elisa.

# `LLVMTailCallKind` from llvm-c/Core.h.
const module LLVMTailCallKindValue:
    TAIL: u32 = 1

# `LLVMLinkage` from llvm-c/Core.h.
const module LLVMLinkageValue:
    INTERNAL: u32 = 8
    PRIVATE: u32 = 9

# `LLVMUnnamedAddr` from llvm-c/Core.h.
const module LLVMUnnamedAddressValue:
    GLOBAL: u32 = 2

# `LLVMAttributeIndex` from llvm-c/Core.h.
const module LLVMAttributeIndexValue:
    FUNCTION: u32 = 4294967295
