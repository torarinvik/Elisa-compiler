# Test a remainder against zero as a subtraction: `X ==/!= Q * D` becomes
# `X - Q * D ==/!= 0`. The optimizer turns `X % D == 0` next to `X / D`
# into the first form (the remainder rebuilt from the quotient), which
# AArch64 selects as `mul`, `cmp` and a conditional branch; the second
# selects as `msub` and `cbz`/`cbnz`, one instruction fewer, and is never
# longer when the result feeds something else. Only a product with no
# other use is folded into the `msub`. It runs after the optimization
# pipeline, whose instruction combiner would turn the subtraction back.
include "./ir/ir_editing.elisa"

extend Backend:
    private:
        # A scalar `icmp eq`/`icmp ne` producing one bit.
        def is_scalar_equality_compare(instruction: LLVMValueRef) -> bool:
            return false if LLVMGetInstructionOpcode(instruction) != LLVMOpcode::ICMP
            predicate: i32 = LLVMGetICmpPredicate(instruction)
            return false if predicate != LLVMIntPredicate::EQ and predicate != LLVMIntPredicate::NE
            is_llvm_integer_type(LLVMTypeOf(instruction), 1)

        # A single-use integer product compared with a non-constant value.
        def is_foldable_product(product: LLVMValueRef, whole: LLVMValueRef) -> bool:
            return false if not is_llvm_instruction_with_opcode(product, LLVMOpcode::MUL)
            return false if not has_one_use(product)
            is_llvm_integer_type(LLVMTypeOf(product), 0) and LLVMIsAConstant(whole) == null

        def subtract_remainder_test(compare: LLVMValueRef, builder: LLVMBuilderRef) -> bool:
            for side in 0..<2 |compare, builder|:
                product: LLVMValueRef = LLVMGetOperand(compare, side.u32())
                whole: LLVMValueRef = LLVMGetOperand(compare, (1 - side).u32())
                if is_foldable_product(product, whole):
                    position_builder_before(builder, compare)
                    remainder: LLVMValueRef = LLVMBuildSub(builder, whole, product, "remainder")
                    LLVMSetOperand(compare, 0, remainder)
                    LLVMSetOperand(compare, 1, LLVMConstNull(LLVMTypeOf(remainder)))
                    return true
            false

        def subtract_block_remainder_tests(block: LLVMBasicBlockRef, builder: LLVMBuilderRef) -> u32:
            changed: mutable u32 = 0
            instruction_cursor: mutable LLVMValueRef? = LLVMGetFirstInstruction(block)
            while instruction_cursor is instruction |instruction_cursor, changed, builder|:
                if is_scalar_equality_compare(instruction) and subtract_remainder_test(instruction, builder):
                    changed <- changed + 1
                instruction_cursor <- LLVMGetNextInstruction(instruction)
            changed

    public:
        def subtract_remainder_tests(module: LLVMModuleRef) -> u32:
            builder: LLVMBuilderRef = LLVMCreateBuilderInContext(LLVMGetModuleContext(module))
            changed: mutable u32 = 0
            function_cursor: mutable LLVMValueRef? = LLVMGetFirstFunction(module)
            while function_cursor is function |function_cursor, changed, builder|:
                block_cursor: mutable LLVMBasicBlockRef? = LLVMGetFirstBasicBlock(function)
                while block_cursor is block |block_cursor, changed, builder|:
                    changed <- changed + subtract_block_remainder_tests(block, builder)
                    block_cursor <- LLVMGetNextBasicBlock(block)
                function_cursor <- LLVMGetNextFunction(function)
            LLVMDisposeBuilder(builder)
            changed
