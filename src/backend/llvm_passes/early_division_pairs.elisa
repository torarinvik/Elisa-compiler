# Pairs quotients with their remainders (LLVM's div-rem-pairs) before the O3 pipeline,
# while loop rotation has not yet separated their operands. It runs on AArch64, over
# every optimized function that computes a remainder, except one whose remainders are
# all scalar `urem`s by a runtime divisor: the default pipeline keeps such a remainder
# test until instruction selection, where it becomes MSUB and CBZ/CBNZ.
include "./ir/llvm_ir_queries.elisa"
include "./ir/loop_pass_policy.elisa"
include "./ir/pass_pipelines.elisa"

# The remainders a function computes.
struct RemainderKinds:
    # A scalar `urem` by a non-constant divisor.
    runtime_unsigned: bool
    # Any other `urem` or `srem`.
    other: bool

extend Backend:
    private:
        def remainder_kinds(function: LLVMValueRef) -> RemainderKinds:
            runtime_unsigned: mutable bool = false
            other: mutable bool = false
            block_cursor: mutable LLVMBasicBlockRef? = LLVMGetFirstBasicBlock(function)
            while block_cursor is block |block_cursor, runtime_unsigned, other|:
                block_cursor <- LLVMGetNextBasicBlock(block)
                cursor: mutable LLVMValueRef? = LLVMGetFirstInstruction(block)
                while cursor is instruction |cursor, runtime_unsigned, other|:
                    cursor <- LLVMGetNextInstruction(instruction)
                    opcode: u32 = LLVMGetInstructionOpcode(instruction)
                    if opcode == LLVMOpcode::UREM and is_llvm_integer_type(LLVMTypeOf(instruction), 0) and LLVMIsAConstantInt(LLVMGetOperand(instruction, 1)) == null:
                        runtime_unsigned <- true
                    elif opcode == LLVMOpcode::UREM or opcode == LLVMOpcode::SREM:
                        other <- true
            RemainderKinds{runtime_unsigned: runtime_unsigned, other: other}

    public:
        # Pairs the module's divisions for TARGET's costs; false off AArch64, where the
        # caller pairs the whole module instead.
        def pair_early_divisions(module: LLVMModuleRef, target: void&?) -> bool can[Abort.Panic, Memory.Allocate]:
            return false if not module_targets_aarch64(module)
            function_cursor: mutable LLVMValueRef? = LLVMGetFirstFunction(module)
            while function_cursor is function |function_cursor, target|:
                function_cursor <- LLVMGetNextFunction(function)
                continue if LLVMIsDeclaration(function) != 0 or function_has_attribute(function, "optnone")
                kinds: RemainderKinds = remainder_kinds(function)
                continue if kinds.runtime_unsigned and not kinds.other
                if kinds.runtime_unsigned or kinds.other:
                    _ = run_function_pipeline(function, target, "div-rem-pairs")
            true
