# Where the validation-loop rewrites run: little-endian 64-bit AArch64 macOS or Linux
# without debug info, in functions that are defined, optimized for speed, without debug
# info and not instrumented by a sanitizer.
include "../ir/llvm_ir_queries.elisa"
include "../ir/ir_editing.elisa"
include "../ir/loop_pass_policy.elisa"

extend Backend:
    public:
        # `getArch() == Triple::aarch64` on macOS or Linux, without `llvm.dbg.cu`.
        def module_qualified_for_validation_rewrites(module: LLVMModuleRef) -> bool can[Abort.Panic, Memory.Allocate]:
            return false if not module_targets_aarch64_architecture(module) or module_has_debug_info(module)
            ElisaLLVMModuleTargetIsMacOSX(module) != 0 or ElisaLLVMModuleTargetIsLinux(module) != 0

        # Declarations, `optnone`/`optsize`/`minsize` and debug-info functions, and those an
        # address, memory, thread, hardware-address or memory-tagging sanitizer instruments.
        def skipped_by_validation_policy(function: LLVMValueRef) -> bool can[Abort.Panic, Memory.Allocate]:
            return true if LLVMIsDeclaration(function) != 0 or function_is_size_optimized(function)
            return true if llvm_function_subprogram_or_null(function) != null
            sanitizers: darray[sview] = ["sanitize_address", "sanitize_memory", "sanitize_thread", "sanitize_hwaddress", "sanitize_memtag"]
            any attribute in sanitizers where function_has_attribute(function, attribute)
