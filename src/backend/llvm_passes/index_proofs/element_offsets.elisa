# Element counts from byte offsets (`ElisaElementOffsets`), shared by the zero-fill
# proofs: a byte offset divided by an element size, when it is a known multiple of it.

extend Backend:
    private:
        # CONSTANT / SIZE as a term when SIZE divides CONSTANT, as signed values.
        def divided_constant_term(analyses: ElisaFunctionAnalysesRef, constant: LLVMValueRef, size: u64) -> ElisaScalarEvolutionExpressionRef?:
            divisor: LLVMValueRef = LLVMConstInt(LLVMTypeOf(constant), size, 0)
            return null if not is_zero_constant(ElisaLLVMConstantIntSignedRemainder(constant, divisor))
            term_of(analyses, ElisaLLVMConstantIntSignedDivide(constant, divisor))

        # A sum whose every term divides, divided term by term.
        def divided_sum_term(analyses: ElisaFunctionAnalysesRef, sum: ElisaScalarEvolutionExpressionRef, size: u64) -> ElisaScalarEvolutionExpressionRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            terms: mutable darray[ElisaScalarEvolutionExpressionRef] = []
            for index in 0..<term_operand_count(sum) |terms, analyses, sum, size|:
                part: ElisaScalarEvolutionExpressionRef = get element_offset_quotient(analyses, term_operand(sum, index), size) else return null
                terms.push(part)
            ElisaLLVMScalarEvolutionAddTerms(analyses, (&terms[0]).cast[void&], terms.count.u32())

        # A product whose first factor divides, with that factor divided.
        def divided_product_term(analyses: ElisaFunctionAnalysesRef, product: ElisaScalarEvolutionExpressionRef, size: u64) -> ElisaScalarEvolutionExpressionRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            factor: ElisaScalarEvolutionExpressionRef = get element_offset_quotient(analyses, term_operand(product, 0), size) else return null
            factors: mutable darray[ElisaScalarEvolutionExpressionRef] = [factor]
            for index in 1..<term_operand_count(product) |factors, product|:
                factors.push(term_operand(product, index))
            ElisaLLVMScalarEvolutionMultiplyTerms(analyses, (&factors[0]).cast[void&], factors.count.u32())

    public:
        # OFFSET / SIZE where OFFSET is known to be a multiple of SIZE: through affine
        # recurrences (start and step must both divide), sums (every term), products (the
        # first factor), and otherwise when scalar evolution divides it exactly (`divide`).
        def element_offset_quotient(analyses: ElisaFunctionAnalysesRef, offset: ElisaScalarEvolutionExpressionRef, size: u64) -> ElisaScalarEvolutionExpressionRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            kind: u32 = term_kind(offset)
            if term_constant(offset) is constant:
                return divided_constant_term(analyses, constant, size)
            if kind == ElisaScalarEvolutionKind::ADD_RECURRENCE:
                return null if term_operand_count(offset) != 2
                start: ElisaScalarEvolutionExpressionRef? = element_offset_quotient(analyses, term_operand(offset, 0), size)
                step: ElisaScalarEvolutionExpressionRef? = element_offset_quotient(analyses, ElisaLLVMScalarEvolutionStepRecurrence(analyses, offset), size)
                first: ElisaScalarEvolutionExpressionRef = get start else return null
                stride: ElisaScalarEvolutionExpressionRef = get step else return null
                loop: ElisaLoopRef = get ElisaLLVMScalarEvolutionRecurrenceLoop(offset) else return null
                return ElisaLLVMScalarEvolutionAddRecurrence(analyses, first, stride, loop, 0)
            return divided_sum_term(analyses, offset, size) if kind == ElisaScalarEvolutionKind::ADD
            if kind == ElisaScalarEvolutionKind::MULTIPLY:
                if divided_product_term(analyses, offset, size) is product:
                    return product
            ElisaLLVMScalarEvolutionUnsignedDivideExact(analyses, offset, ElisaLLVMScalarEvolutionConstantOf(analyses, term_type(offset), size))
