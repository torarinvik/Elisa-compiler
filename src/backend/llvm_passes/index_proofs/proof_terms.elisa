# Scalar evolution terms as the index prover reads them: a term's kind, operands and
# constant, the value an unknown term stands for, and the sums, differences and
# constants a proof builds. Terms are uniqued, so two terms are equal exactly when they
# are the same reference.
include "./index_prover_state.elisa"

extend Backend:
    public:
        def term_kind(term: ElisaScalarEvolutionExpressionRef) -> u32:
            ElisaLLVMScalarEvolutionExpressionKind(term)

        def term_operand_count(term: ElisaScalarEvolutionExpressionRef) -> u32:
            ElisaLLVMScalarEvolutionExpressionOperandCount(term)

        def term_operand(term: ElisaScalarEvolutionExpressionRef, index: u32) -> ElisaScalarEvolutionExpressionRef:
            ElisaLLVMScalarEvolutionExpressionOperandAt(term, index)

        def term_type(term: ElisaScalarEvolutionExpressionRef) -> LLVMTypeRef:
            ElisaLLVMScalarEvolutionExpressionType(term)

        # Whether TERM is a KIND with exactly COUNT operands.
        def is_term_of(term: ElisaScalarEvolutionExpressionRef, kind: u32, count: u32) -> bool:
            term_kind(term) == kind and term_operand_count(term) == count

        # The ConstantInt of a constant term.
        def term_constant(term: ElisaScalarEvolutionExpressionRef) -> LLVMValueRef?:
            return null if term_kind(term) != ElisaScalarEvolutionKind::CONSTANT
            ElisaLLVMScalarEvolutionExpressionValue(term)

        # The value an unknown term stands for.
        def term_value(term: ElisaScalarEvolutionExpressionRef) -> LLVMValueRef?:
            return null if term_kind(term) != ElisaScalarEvolutionKind::UNKNOWN
            ElisaLLVMScalarEvolutionExpressionValue(term)

        # The instruction with OPCODE an unknown term stands for.
        def term_instruction(term: ElisaScalarEvolutionExpressionRef, opcode: u32) -> LLVMValueRef?:
            value: LLVMValueRef = get term_value(term) else return null
            return value if is_llvm_instruction_with_opcode(value, opcode)
            null

        # Whether TERM is the constant VALUE (`isZero`, `isOne`, `getAPInt() == 2`).
        def is_term_constant(term: ElisaScalarEvolutionExpressionRef, value: u64) -> bool:
            constant: LLVMValueRef = get term_constant(term) else return false
            ElisaLLVMConstantIntEquals(constant, value) != 0

        # `isAllOnesValue`: the constant with every bit set (ConstantInts are uniqued).
        def is_term_all_ones(term: ElisaScalarEvolutionExpressionRef) -> bool:
            constant: LLVMValueRef = get term_constant(term) else return false
            constant == LLVMConstAllOnes(LLVMTypeOf(constant))

        # A constant term whose sign bit is set.
        def is_term_negative(term: ElisaScalarEvolutionExpressionRef) -> bool:
            constant: LLVMValueRef = get term_constant(term) else return false
            ElisaLLVMConstantIntIsNegative(constant) != 0

        def term_of(analyses: ElisaFunctionAnalysesRef, value: LLVMValueRef) -> ElisaScalarEvolutionExpressionRef:
            ElisaLLVMScalarEvolutionOfValue(analyses, value)

        # Whether scalar evolution describes VALUE's type.
        def has_term(analyses: ElisaFunctionAnalysesRef, value: LLVMValueRef) -> bool:
            ElisaLLVMScalarEvolutionIsSCEVable(analyses, LLVMTypeOf(value)) != 0

        # The constant VALUE of LIKE's type.
        def term_constant_like(analyses: ElisaFunctionAnalysesRef, like: ElisaScalarEvolutionExpressionRef, value: u64) -> ElisaScalarEvolutionExpressionRef:
            ElisaLLVMScalarEvolutionConstantOf(analyses, term_type(like), value)

        def term_sum(analyses: ElisaFunctionAnalysesRef, left: ElisaScalarEvolutionExpressionRef, right: ElisaScalarEvolutionExpressionRef) -> ElisaScalarEvolutionExpressionRef:
            ElisaLLVMScalarEvolutionAdd(analyses, left, right)

        def term_difference(analyses: ElisaFunctionAnalysesRef, left: ElisaScalarEvolutionExpressionRef, right: ElisaScalarEvolutionExpressionRef) -> ElisaScalarEvolutionExpressionRef:
            ElisaLLVMScalarEvolutionMinus(analyses, left, right)

        def term_negation(analyses: ElisaFunctionAnalysesRef, term: ElisaScalarEvolutionExpressionRef) -> ElisaScalarEvolutionExpressionRef:
            ElisaLLVMScalarEvolutionNegate(analyses, term)

        def is_term_invariant(analyses: ElisaFunctionAnalysesRef, term: ElisaScalarEvolutionExpressionRef, loop: ElisaLoopRef) -> bool:
            ElisaLLVMScalarEvolutionIsLoopInvariant(analyses, term, loop) != 0

        # `APInt::isPowerOf2`: exactly one bit set, the sign bit included.
        def is_power_of_two(constant: LLVMValueRef) -> bool:
            return true if ElisaLLVMConstantIntIsPositivePowerOfTwo(constant) != 0
            ElisaLLVMConstantIntIsNegative(constant) != 0 and ElisaLLVMConstantIntTrailingZeros(constant) + 1 == LLVMGetIntTypeWidth(LLVMTypeOf(constant))

        # Whether the constants compare by PREDICATE.
        def constants_compare(predicate: i32, left: LLVMValueRef, right: LLVMValueRef) -> bool:
            ElisaLLVMConstantIntCompare(predicate, left, right) != 0

        def is_zero_constant(constant: LLVMValueRef) -> bool:
            ElisaLLVMIsConstantZero(constant) != 0

        def has_every_bit_set(constant: LLVMValueRef) -> bool:
            constant == LLVMConstAllOnes(LLVMTypeOf(constant))

        # The unsigned predicate of a signed one (`getUnsignedPredicate`).
        def unsigned_of_signed_predicate(predicate: i32) -> i32:
            when predicate:
                LLVMIntPredicate::SGT -> LLVMIntPredicate::UGT
                LLVMIntPredicate::SGE -> LLVMIntPredicate::UGE
                LLVMIntPredicate::SLT -> LLVMIntPredicate::ULT
                LLVMIntPredicate::SLE -> LLVMIntPredicate::ULE
                _ -> predicate

        def is_signed_integer_predicate(predicate: i32) -> bool:
            predicate >= LLVMIntPredicate::SGT and predicate <= LLVMIntPredicate::SLE

        # The predicate a decided comparison holds with.
        def fact_predicate(fact: CompareFact) -> i32:
            predicate: i32 = LLVMGetICmpPredicate(fact.compare)
            predicate if fact.truth else inverse_integer_predicate(predicate)
