# The functions the loop-rewriting passes leave alone: declarations,
# size-optimized and debug-info functions, and anything a sanitizer
# instruments, whose checks a rewrite could move or drop. Mirrors
# ../llvm_loop_pass_policy.h for the passes still written in C++.
include "./llvm_c_extra.elisa"

extend Backend:
    public:
        def function_has_attribute(function: LLVMValueRef, attribute: sview) -> bool can[Abort.Panic, Memory.Allocate]:
            name_storage: mutable darray[u8] = []
            kind: u32 = LLVMGetEnumAttributeKindForName(sview_to_cstr(attribute, name_storage), attribute.len.usize())
            kind != 0 and LLVMGetEnumAttributeAtIndex(function, LLVMAttributeIndexValue::FUNCTION, kind) != null

        def module_has_named_metadata(module: LLVMModuleRef, name: sview) -> bool can[Abort.Panic, Memory.Allocate]:
            name_storage: mutable darray[u8] = []
            LLVMGetNamedMetadata(module, sview_to_cstr(name, name_storage), name.len.usize()) != null

    public:
        def module_has_flag(module: LLVMModuleRef, key: sview) -> bool can[Abort.Panic, Memory.Allocate]:
            key_storage: mutable darray[u8] = []
            LLVMGetModuleFlag(module, sview_to_cstr(key, key_storage), key.len.usize()) != null

        def function_is_size_optimized(function: LLVMValueRef) -> bool can[Abort.Panic, Memory.Allocate]:
            function_has_attribute(function, "optnone") or function_has_attribute(function, "optsize") or function_has_attribute(function, "minsize")

        def module_has_debug_info(module: LLVMModuleRef) -> bool can[Abort.Panic, Memory.Allocate]:
            module_has_named_metadata(module, "llvm.dbg.cu")

        def skipped_by_loop_pass_policy(function: LLVMValueRef, module: LLVMModuleRef) -> bool can[Abort.Panic, Memory.Allocate]:
            return true if LLVMIsDeclaration(function) != 0 or function_is_size_optimized(function)
            return true if llvm_function_subprogram_or_null(function) != null or module_has_debug_info(module)
            sanitizer_flags: darray[sview] = ["SanitizeAddress", "SanitizeHWAddress", "SanitizeMemory", "SanitizeThread", "SanitizeRealtime"]
            for flag in sanitizer_flags |module|:
                return true if module_has_flag(module, flag)
            sanitizer_attributes: darray[sview] = ["sanitize_address", "sanitize_hwaddress", "sanitize_memory", "sanitize_thread", "sanitize_memtag", "sanitize_realtime", "sanitize_realtime_blocking"]
            for attribute in sanitizer_attributes |function|:
                return true if function_has_attribute(function, attribute)
            false
