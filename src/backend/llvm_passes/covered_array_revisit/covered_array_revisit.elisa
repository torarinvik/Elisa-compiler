# The covered-array revisit: a second full O3 run over small modules in which both the
# array-coverage rewrite (which leaves the `elisa.covered-array-revisit` marker) and the
# guarded-reduction unrolling fired, exposing cleanups created after the first
# pipeline. When it then versions a function on its loop divisor, O3 runs once more
# over the copies. Large modules keep their compile budget: at most 32 defined
# functions and 5000 instructions, none size-optimized, sanitized or with debug info.
include "./divisor_versioning.elisa"
include "../../llvm_c_api/elisa_llvm_pass_pipelines.elisa"

const module CoveredArrayRevisitLimit:
    FUNCTIONS: u32 = 32
    INSTRUCTIONS: u32 = 5000

extend Backend:
    private:
        def covered_array_revisit_is_affordable(module: LLVMModuleRef) -> bool can[Abort.Panic, Memory.Allocate]:
            functions: mutable u32 = 0
            instructions: mutable u32 = 0
            function_cursor: mutable LLVMValueRef? = LLVMGetFirstFunction(module)
            while function_cursor is function |function_cursor, functions, instructions|:
                function_cursor <- LLVMGetNextFunction(function)
                continue if LLVMIsDeclaration(function) != 0
                functions <- functions + 1
                return false if functions > CoveredArrayRevisitLimit::FUNCTIONS or function_is_size_optimized(function)
                return false if llvm_function_subprogram_or_null(function) != null or function_is_sanitized(function)
                instructions <- instructions + function_instruction_count(function)
                return false if instructions > CoveredArrayRevisitLimit::INSTRUCTIONS
            true

    public:
        # Consumes the revisit marker; when the reductions were UNROLLED and the module
        # is small enough, reruns O3 (twice when a divisor gets versioned). Whether O3 ran.
        def revisit_covered_arrays(module: LLVMModuleRef, unrolled: bool) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            name: sview = "elisa.covered-array-revisit"
            name_storage: mutable darray[u8] = []
            marker: void& = get LLVMGetNamedMetadata(module, sview_to_cstr(name, name_storage), name.len.usize()) else return false
            ElisaLLVMEraseNamedMetadata(marker)
            return false if not unrolled or not covered_array_revisit_is_affordable(module)
            ElisaLLVMRunDefaultO3Pipeline(module, null)
            ElisaLLVMRunDefaultO3Pipeline(module, null) if version_first_loop_divisor(module)
            true
