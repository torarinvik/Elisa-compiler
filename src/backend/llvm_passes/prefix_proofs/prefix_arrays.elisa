# The arrays an indexed-prefix proof is about (`ElisaIndexedPrefix::Array`) and the
# context the index prover keeps for them. A prover whose context holds no arrays proves
# exactly what the plain index prover does: its reads of other arrays find no source.
include "../late_cleanup/array_values/array_accesses.elisa"

# A local array and what its prefix proof found: the fill loop's counted exit edge, or
# the copy that writes the prefix, the number of elements written, and that length
# extended by stores of the next elements after the fill (a ring's sentinel).
struct PrefixArray:
    buffer: LLVMValueRef
    element_size: u64
    accesses: mutable ArrayAccesses
    from: mutable LLVMBasicBlockRef?
    target: mutable LLVMBasicBlockRef?
    copied: mutable LLVMValueRef?
    length: mutable ElisaScalarEvolutionExpressionRef?
    covered: mutable ElisaScalarEvolutionExpressionRef?
    # Leading elements the fill must still zero (a stack's folded seeds).
    kept_elements: mutable u64
    # A struct or record element: the stores are only the field stores that complete one,
    # and the residues each field access's byte offset inside its element.
    composite: bool
    # An array whose fill an earlier run removed: a source of loaded values with no fill.
    proved: bool
    # An array of records regrouped from another, which no read of another array finds.
    searchable: mutable bool

# The arrays of the prover's function, those whose loads are being bounded (`visiting`)
# and those whose reads are being proved inside (`proving`).
struct PrefixContext:
    arrays: mutable darray[PrefixArray]
    visiting: mutable darray[LLVMValueRef]
    proving: mutable darray[LLVMValueRef]

extend Backend:
    public:
        def empty_prefix_context() -> PrefixContext:
            PrefixContext{arrays: [], visiting: [], proving: []}

        def new_prefix_array(buffer: LLVMValueRef, element_size: u64, accesses: ArrayAccesses, composite: bool, proved: bool) -> PrefixArray:
            PrefixArray{buffer: buffer, element_size: element_size, accesses: accesses, from: null, target: null, copied: null, length: null, covered: null, kept_elements: 0, composite: composite, proved: proved, searchable: true}

        # A copy of ACCESSES with arrays of its own.
        def copied_array_accesses(accesses: ArrayAccesses&) -> ArrayAccesses can[Memory.Allocate]:
            copy: mutable ArrayAccesses = empty_array_accesses()
            for load in accesses.loads |copy|:
                copy.loads.push(load)
            for load in accesses.vector_loads |copy|:
                copy.vector_loads.push(load)
            for store in accesses.stores |copy|:
                copy.stores.push(store)
            for store in accesses.vector_stores |copy|:
                copy.vector_stores.push(store)
            for copied in accesses.copies |copy|:
                copy.copies.push(copied)
            for write in accesses.writes |copy|:
                copy.writes.push(write)
            for fill in accesses.fills |copy|:
                copy.fills.push(fill)
            for view in accesses.views |copy|:
                copy.views.push(view)
            for residue in accesses.residues |copy|:
                copy.residues.push(residue)
            copy.filled <- accesses.filled
            copy
