# Values a branch edge rules out (`ElisaEdgeExclusion`). An edge taken only when a
# comparison of V with a constant came out one way excludes every value that would have
# sent it the other way (`count < 0` leaving on failure leaves no -1 on the edge into the
# rest). Below V's block, such an edge into a block that dominates a point excludes the
# value at that point: every path from V's latest execution to the point takes the edge,
# so no later execution of V can bring the value back.
include "../ir/decided_compares.elisa"

# A value proved equal on an edge, and the end of that edge.
struct EdgeEquality:
    equal: LLVMValueRef
    end: LLVMValueRef

extend Backend:
    private:
        # FACT's comparison as `VALUE predicate constant`, when it compares VALUE with a
        # constant.
        def excludes_by_fact(fact: CompareFact, value: LLVMValueRef, excluded: LLVMValueRef) -> bool can[Abort.Panic]:
            predicate: mutable i32 = fact_predicate(fact)
            left: mutable LLVMValueRef = LLVMGetOperand(fact.compare, 0)
            right: mutable LLVMValueRef = LLVMGetOperand(fact.compare, 1)
            if right == value:
                right <- left
                left <- value
                predicate <- swapped_predicate(predicate)
            return false if left != value or LLVMIsAConstantInt(right) == null
            return false if LLVMGetIntTypeWidth(LLVMTypeOf(right)) != LLVMGetIntTypeWidth(LLVMTypeOf(excluded))
            region: ElisaConstantRangeRef = ElisaLLVMConstantRangeExactByCompare(predicate, right)
            contains: bool = ElisaLLVMConstantRangeContains(region, LLVMConstIntGetZExtValue(excluded)) != 0
            ElisaLLVMDisposeConstantRange(region)
            not contains

    public:
        # FROM -> TARGET is taken only when VALUE != EXCLUDED, a constant of VALUE's type
        # (`excludesOnEdge`).
        def excludes_on_edge(value: LLVMValueRef, excluded: LLVMValueRef, from: LLVMBasicBlockRef, target: LLVMBasicBlockRef) -> bool can[Abort.Panic, Memory.Allocate]:
            for fact in edge_compares(from, target) |value, excluded|:
                return true if excludes_by_fact(fact, value, excluded)
            false

        # The value FROM -> TARGET proves VALUE equal to: a loop left when its counter reaches
        # a limit VALUE carries the counter's value on that edge (`equalOnEdge`).
        def equal_on_edge(value: LLVMValueRef, from: LLVMBasicBlockRef, target: LLVMBasicBlockRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate]:
            for fact in edge_compares(from, target) |value|:
                continue if fact_predicate(fact) != LLVMIntPredicate::EQ
                return LLVMGetOperand(fact.compare, 1) if LLVMGetOperand(fact.compare, 0) == value
                return LLVMGetOperand(fact.compare, 0) if LLVMGetOperand(fact.compare, 1) == value
            null

        # A W that VALUE equals wherever AT executes, and the end of the edge that proved
        # it: an edge from a block below LIMIT into a block dominating AT, taken only when
        # VALUE == W (`equalAbove`).
        def equal_above(analyses: ElisaFunctionAnalysesRef, value: LLVMValueRef, at: LLVMValueRef, limit: LLVMBasicBlockRef) -> EdgeEquality? can[Abort.Panic, Memory.Allocate]:
            # An unreachable block has no dominator tree node to walk from.
            start: LLVMBasicBlockRef = LLVMGetInstructionParent(at)
            node: mutable LLVMBasicBlockRef? = null
            if ElisaLLVMIsReachableFromEntry(analyses, start) != 0:
                node <- start
            while node is block |node, analyses, value, limit|:
                break if block == limit or ElisaLLVMBlockDominates(analyses, limit, block) == 0
                if single_predecessor(block) is from:
                    if ElisaLLVMBlockDominates(analyses, limit, from) != 0:
                        if equal_on_edge(value, from, block) is equal:
                            return EdgeEquality{equal: equal, end: terminator_of(from)}
                node <- ElisaLLVMImmediateDominator(analyses, block)
            null

        # VALUE != EXCLUDED wherever AT executes, by an edge below VALUE's block into a
        # block dominating AT (`excludedAt`).
        def excluded_at(analyses: ElisaFunctionAnalysesRef, value: LLVMValueRef, excluded: LLVMValueRef, at: LLVMValueRef) -> bool can[Abort.Panic, Memory.Allocate]:
            home: LLVMBasicBlockRef = LLVMGetInstructionParent(value)
            # An unreachable block has no dominator tree node to walk from.
            start: LLVMBasicBlockRef = LLVMGetInstructionParent(at)
            node: mutable LLVMBasicBlockRef? = null
            if ElisaLLVMIsReachableFromEntry(analyses, start) != 0:
                node <- start
            while node is block |node, analyses, value, excluded, home|:
                break if block == home
                return false if ElisaLLVMBlockDominates(analyses, home, block) == 0
                if single_predecessor(block) is from:
                    if ElisaLLVMBlockDominates(analyses, home, from) != 0 and excludes_on_edge(value, excluded, from, block):
                        return true
                node <- ElisaLLVMImmediateDominator(analyses, block)
            false

        # The only values VALUE takes, when they are a few constants (`constantChoices`).
        def constant_choices(value: LLVMValueRef) -> darray[LLVMValueRef] can[Memory.Allocate]:
            type: LLVMTypeRef = LLVMTypeOf(value)
            return [value] if LLVMIsAConstantInt(value) != null
            opcode: u32 = LLVMGetInstructionOpcode(value)
            if opcode == LLVMOpcode::SEXT or opcode == LLVMOpcode::ZEXT:
                return [] if not is_llvm_integer_type(LLVMTypeOf(LLVMGetOperand(value, 0)), 1)
                high: LLVMValueRef = LLVMConstAllOnes(type) if opcode == LLVMOpcode::SEXT else LLVMConstInt(type, 1, 0)
                choices: darray[LLVMValueRef] = [LLVMConstInt(type, 0, 0), high]
                return choices
            return [] if opcode != LLVMOpcode::SELECT
            first: LLVMValueRef = LLVMGetOperand(value, 1)
            second: LLVMValueRef = LLVMGetOperand(value, 2)
            return [] if LLVMIsAConstantInt(first) == null or LLVMIsAConstantInt(second) == null
            arms: darray[LLVMValueRef] = [first, second]
            arms
