# LLVM C API enumerations used by the Elisa-hosted LLVM passes, named so
# pass code never compares an instruction against a bare number.

# `LLVMOpcode` from llvm-c/Core.h.
const module LLVMOpcode:
    RET: u32 = 1
    # LLVM 23 split the branch opcode in two; 2 is no longer used.
    UNCONDITIONAL_BR: u32 = 70
    CONDITIONAL_BR: u32 = 71
    SWITCH: u32 = 3
    INDIRECT_BR: u32 = 4
    INVOKE: u32 = 5
    UNREACHABLE: u32 = 7
    ADD: u32 = 8
    FADD: u32 = 9
    SUB: u32 = 10
    FSUB: u32 = 11
    MUL: u32 = 12
    FMUL: u32 = 13
    UDIV: u32 = 14
    SDIV: u32 = 15
    FDIV: u32 = 16
    UREM: u32 = 17
    SREM: u32 = 18
    SHL: u32 = 20
    LSHR: u32 = 21
    ASHR: u32 = 22
    AND: u32 = 23
    OR: u32 = 24
    XOR: u32 = 25
    ALLOCA: u32 = 26
    LOAD: u32 = 27
    STORE: u32 = 28
    GET_ELEMENT_PTR: u32 = 29
    TRUNC: u32 = 30
    ZEXT: u32 = 31
    SEXT: u32 = 32
    SI_TO_FP: u32 = 36
    PTR_TO_INT: u32 = 39
    ICMP: u32 = 42
    FCMP: u32 = 43
    PHI: u32 = 44
    CALL: u32 = 45
    SELECT: u32 = 46
    VA_ARG: u32 = 49
    INSERT_ELEMENT: u32 = 51
    SHUFFLE_VECTOR: u32 = 52
    EXTRACT_VALUE: u32 = 53
    INSERT_VALUE: u32 = 54
    FENCE: u32 = 55
    ATOMIC_COMPARE_EXCHANGE: u32 = 56
    ATOMIC_RMW: u32 = 57
    CALL_BR: u32 = 67
    FREEZE: u32 = 68
    PTR_TO_ADDR: u32 = 69

# `LLVMValueKind` from llvm-c/Core.h.
const module LLVMValueKind:
    CONSTANT_AGGREGATE_ZERO: u32 = 15

# `LLVMIntPredicate` values are in ../llvm_c.elisa.

# `LLVMTailCallKind` from llvm-c/Core.h.
const module LLVMTailCallKindValue:
    NONE: u32 = 0
    TAIL: u32 = 1
    MUST_TAIL: u32 = 2

# `LLVMLinkage` from llvm-c/Core.h.
const module LLVMLinkageValue:
    INTERNAL: u32 = 8
    PRIVATE: u32 = 9

# `LLVMUnnamedAddr` from llvm-c/Core.h.
const module LLVMUnnamedAddressValue:
    GLOBAL: u32 = 2

# `LLVMAttributeIndex` from llvm-c/Core.h.
const module LLVMAttributeIndexValue:
    FUNCTION: u32 = 4294967295
