# Small IR queries shared by the Elisa-hosted LLVM passes, over the LLVM C
# API: opcode and type tests, use counts and the module's target.
include "./llvm_ir_constants.elisa"
include "../../llvm_c_api/elisa_llvm_analysis.elisa"

# `LLVMTypeKind` value of integer types, from llvm-c/Core.h.
const module LLVMTypeKindValue:
    FLOAT: u32 = 2
    DOUBLE: u32 = 3
    INTEGER: u32 = 8
    VECTOR: u32 = 13
    SCALABLE_VECTOR: u32 = 17

extend Backend:
    public:
        def is_llvm_instruction_with_opcode(value: LLVMValueRef, opcode: u32) -> bool:
            LLVMIsAInstruction(value) != null and LLVMGetInstructionOpcode(value) == opcode

        # CmpInst::getInversePredicate over the integer predicates.
        def inverse_integer_predicate(predicate: i32) -> i32:
            when predicate:
                LLVMIntPredicate::EQ -> LLVMIntPredicate::NE
                LLVMIntPredicate::NE -> LLVMIntPredicate::EQ
                LLVMIntPredicate::UGT -> LLVMIntPredicate::ULE
                LLVMIntPredicate::ULE -> LLVMIntPredicate::UGT
                LLVMIntPredicate::UGE -> LLVMIntPredicate::ULT
                LLVMIntPredicate::ULT -> LLVMIntPredicate::UGE
                LLVMIntPredicate::SGT -> LLVMIntPredicate::SLE
                LLVMIntPredicate::SLE -> LLVMIntPredicate::SGT
                LLVMIntPredicate::SGE -> LLVMIntPredicate::SLT
                _ -> LLVMIntPredicate::SGE

        # The intrinsic a call instruction calls, or 0.
        def called_intrinsic_id(value: LLVMValueRef) -> u32:
            return 0 if not is_llvm_instruction_with_opcode(value, LLVMOpcode::CALL)
            callee: LLVMValueRef = LLVMGetCalledValue(value)
            return 0 if LLVMIsAFunction(callee) == null
            LLVMGetIntrinsicID(callee)

        def has_one_use(value: LLVMValueRef) -> bool:
            if LLVMGetFirstUse(value) is use:
                return LLVMGetNextUse(use) == null
            false

        # Whether the type is a scalar integer, of any width when `width` is 0.
        def is_llvm_integer_type(type: LLVMTypeRef, width: u32) -> bool:
            return false if LLVMGetTypeKind(type) != LLVMTypeKindValue::INTEGER
            width == 0 or LLVMGetIntTypeWidth(type) == width

        # Triple::isAArch64(): any AArch64 target, big-endian and ILP32 included.
        def module_targets_aarch64(module: LLVMModuleRef) -> bool:
            ElisaLLVMModuleTargetIsAArch64(module) != 0

        # Triple::getArch() == Triple::aarch64: little-endian 64-bit AArch64.
        def module_targets_aarch64_architecture(module: LLVMModuleRef) -> bool:
            ElisaLLVMModuleTargetArchIsAArch64(module) != 0

        # Darwin on little-endian 64-bit AArch64.
        def module_targets_darwin_aarch64(module: LLVMModuleRef) -> bool:
            ElisaLLVMModuleTargetIsDarwin(module) != 0 and module_targets_aarch64_architecture(module)
