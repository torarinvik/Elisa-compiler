# The comparisons a branch condition decides, through logical and/or and their select
# forms, and PatternMatch's `m_LogicalAnd` / `m_LogicalOr` that find them.

const module DecidedCompareLimit:
    DEPTH: u32 = 6

# A comparison and the value a taken edge gives it.
struct CompareFact:
    compare: LLVMValueRef
    truth: bool

# The two operands of a logical and/or.
struct LogicalOperands:
    left: LLVMValueRef
    right: LLVMValueRef

extend Backend:
    private:
        # A constant that is null, as `Constant::isNullValue`.
        def is_null_constant(value: LLVMValueRef) -> bool:
            LLVMIsAConstant(value) != null and LLVMIsNull(value) != 0

    public:
        # `m_LogicalAnd` (CONJUNCTION set) or `m_LogicalOr`: an i1 `and`/`or`, or `select c, x, false`
        # / `select c, true, x` whose condition has the select's type.
        def logical_operands(value: LLVMValueRef, conjunction: bool) -> LogicalOperands? can[Abort.Panic, Memory.Allocate]:
            return null if LLVMIsAInstruction(value) == null or not is_llvm_integer_type(LLVMTypeOf(value), 1)
            opcode: u32 = LLVMGetInstructionOpcode(value)
            if opcode == (LLVMOpcode::AND if conjunction else LLVMOpcode::OR):
                return LogicalOperands{left: LLVMGetOperand(value, 0), right: LLVMGetOperand(value, 1)}
            return null if opcode != LLVMOpcode::SELECT
            condition: LLVMValueRef = LLVMGetOperand(value, 0)
            return null if LLVMTypeOf(condition) != LLVMTypeOf(value)
            if conjunction:
                return LogicalOperands{left: condition, right: LLVMGetOperand(value, 1)} if is_null_constant(LLVMGetOperand(value, 2)) else null
            alternative: LLVMValueRef = LLVMGetOperand(value, 1)
            return null if LLVMIsAConstantInt(alternative) == null or ElisaLLVMIsConstantOne(alternative) == 0
            LogicalOperands{left: condition, right: LLVMGetOperand(value, 2)}

        # The comparisons CONDITION decides when it has value TRUTH, appended to FACTS in
        # `ElisaDeadTrapExits::decided` order.
        def decided_compares[@r](condition: LLVMValueRef, truth: bool, facts: mutable darray[CompareFact] @r, depth: u32) -> darray[CompareFact] @r can[Abort.Panic, Memory.Allocate]:
            if is_llvm_instruction_with_opcode(condition, LLVMOpcode::ICMP):
                facts.push(CompareFact{compare: condition, truth: truth})
                return facts
            return facts if depth >= DecidedCompareLimit::DEPTH
            operands: LogicalOperands = get logical_operands(condition, truth) else return facts
            facts <- decided_compares(operands.left, truth, facts, depth + 1)
            decided_compares(operands.right, truth, facts, depth + 1)

        # The comparisons decided on the edge FROM -> TARGET.
        def edge_compares(from: LLVMBasicBlockRef, target: LLVMBasicBlockRef) -> darray[CompareFact] can[Abort.Panic, Memory.Allocate]:
            branch: LLVMValueRef = get conditional_terminator(from) else return []
            return [] if LLVMGetSuccessor(branch, 0) == LLVMGetSuccessor(branch, 1)
            facts: mutable darray[CompareFact] = []
            facts <- decided_compares(LLVMGetCondition(branch), LLVMGetSuccessor(branch, 0) == target, facts, 0)
            facts
