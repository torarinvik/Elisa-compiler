# Blocks that only trap: the checks the Elisa-hosted passes fold or remove branch to them.
include "./ir_editing.elisa"

extend Backend:
    public:
        # A call of `llvm.trap` without operand bundles that is not convergent.
        def is_plain_trap_call(call: LLVMValueRef) -> bool can[Abort.Panic, Memory.Allocate]:
            return false if LLVMIsAIntrinsicInst(call) == null or LLVMGetNumOperandBundles(call) != 0
            name_storage: mutable darray[u8] = []
            trap: u32 = LLVMLookupIntrinsicID(sview_to_cstr("llvm.trap", name_storage), 9)
            convergent_storage: mutable darray[u8] = []
            convergent: u32 = LLVMGetEnumAttributeKindForName(sview_to_cstr("convergent", convergent_storage), 10)
            LLVMGetIntrinsicID(LLVMGetCalledValue(call)) == trap and ElisaLLVMCallHasFunctionAttribute(call, convergent) == 0

        # A block of exactly one plain trap call and `unreachable`, debug intrinsics aside.
        def is_bare_trap_block(block: LLVMBasicBlockRef) -> bool can[Abort.Panic, Memory.Allocate]:
            saw_trap: mutable bool = false
            cursor: mutable LLVMValueRef? = LLVMGetFirstInstruction(block)
            while cursor is instruction |cursor, saw_trap|:
                cursor <- LLVMGetNextInstruction(instruction)
                continue if LLVMIsADbgInfoIntrinsic(instruction) != null
                if is_call_base(instruction):
                    return false if saw_trap or not is_plain_trap_call(instruction)
                    saw_trap <- true
                elif LLVMGetInstructionOpcode(instruction) != LLVMOpcode::UNREACHABLE:
                    return false
            terminator: LLVMValueRef = get LLVMGetBasicBlockTerminator(block) else return false
            saw_trap and LLVMGetInstructionOpcode(terminator) == LLVMOpcode::UNREACHABLE
