# Lookups keyed by up to three object identities: the provers' `DenseMap`s keyed by
# pairs and triples of LLVM objects (values, blocks, scalar evolution expressions). A key
# maps to the index of the owner's entry, which the owner keeps in its own arrays.
#
# Open addressing with linear probing over a power-of-two capacity, at most half full.
# Keys are addresses; LLVM objects are aligned allocations, so the low bits carry no
# information and are shifted out. An unused key part is zero.

const module KeyTableSize:
    INITIAL: u32 = 16

# Each slot holds a key's three parts and its entry index plus one, or zero when empty.
struct KeyTable:
    first: mutable darray[u64]
    second: mutable darray[u64]
    third: mutable darray[u64]
    entries: mutable darray[u32]
    count: mutable u32

# A key of up to three object addresses.
struct TableKey:
    first: u64
    second: u64
    third: u64

extend Backend:
    private:
        def empty_key_table(capacity: u32) -> KeyTable can[Memory.Allocate]:
            first: mutable darray[u64] = []
            second: mutable darray[u64] = []
            third: mutable darray[u64] = []
            entries: mutable darray[u32] = []
            while entries.count < capacity |first, second, third, entries, capacity|:
                first.push(0)
                second.push(0)
                third.push(0)
                entries.push(0)
            KeyTable{first: first, second: second, third: third, entries: entries, count: 0}

        def key_part_hash(part: u64) -> u64:
            (part >> 4) ^ (part >> 13) ^ (part >> 22)

        # The slot holding KEY, or the empty slot where it would go.
        def key_table_slot(table: KeyTable&, key: TableKey) -> u32 can[Abort.Panic]:
            mask: u64 = table.entries.count.u64() - 1
            hash: u64 = key_part_hash(key.first) ^ (key_part_hash(key.second) * 31) ^ (key_part_hash(key.third) * 961)
            slot: mutable u64 = hash & mask
            while table.entries[slot] != 0 |slot, table, key, mask|:
                break if table.first[slot] == key.first and table.second[slot] == key.second and table.third[slot] == key.third
                slot <- (slot + 1) & mask
            slot.u32()

        # TABLE's keys in a table of twice the capacity.
        def grown_key_table(table: KeyTable&) -> KeyTable can[Abort.Panic, Memory.Allocate]:
            grown: mutable KeyTable = empty_key_table(table.entries.count.u32() * 2)
            grown.count <- table.count
            for index in 0..<table.entries.count |grown, table|:
                if table.entries[index] != 0:
                    slot: u32 = key_table_slot(&grown, TableKey{first: table.first[index], second: table.second[index], third: table.third[index]})
                    grown.first[slot] <- table.first[index]
                    grown.second[slot] <- table.second[index]
                    grown.third[slot] <- table.third[index]
                    grown.entries[slot] <- table.entries[index]
            grown

    public:
        def new_key_table() -> KeyTable can[Memory.Allocate]:
            empty_key_table(KeyTableSize::INITIAL)

        # The address of an LLVM object, as a key part.
        def object_key(object: void&) -> u64 can[Unsafe.PointerCast]:
            object.cast[uintptr].u64()

        # The entry index TABLE holds for KEY, if any.
        def key_table_find(table: KeyTable&, key: TableKey) -> u32? can[Abort.Panic]:
            stored: u32 = table.entries[key_table_slot(table, key)]
            return null if stored == 0
            stored - 1

        # TABLE with KEY mapped to ENTRY, replacing an earlier entry for it.
        def key_table_insert(table: mutable KeyTable, key: TableKey, entry: u32) -> KeyTable can[Abort.Panic, Memory.Allocate]:
            current: mutable KeyTable = table
            if (current.count + 1) * 2 > current.entries.count.u32():
                current <- grown_key_table(&current)
            slot: u32 = key_table_slot(&current, key)
            if current.entries[slot] == 0:
                current.first[slot] <- key.first
                current.second[slot] <- key.second
                current.third[slot] <- key.third
                current.count <- current.count + 1
            current.entries[slot] <- entry + 1
            current
