# LLVM values keyed by identity: the passes' `DenseMap<Value *, Value *>`.
#
# Open addressing with linear probing over a power-of-two capacity, at most half full.
# Keys hash by address; LLVM values are aligned allocations, so the low bits carry no
# information and are shifted out.

const module ValueTableSize:
    INITIAL: u32 = 16

# Each slot holds a key and its value, or neither.
struct ValueTable:
    keys: mutable darray[LLVMValueRef?]
    values: mutable darray[LLVMValueRef?]
    count: mutable u32

extend Backend:
    private:
        def empty_value_slots(capacity: u32) -> darray[LLVMValueRef?] can[Memory.Allocate]:
            slots: mutable darray[LLVMValueRef?] = []
            while slots.count < capacity |slots, capacity|:
                slots.push(null)
            slots

        def value_table_hash(key: LLVMValueRef) -> u64 can[Unsafe.PointerCast]:
            bits: u64 = key.cast[void&].cast[uintptr].u64()
            (bits >> 4) ^ (bits >> 13) ^ (bits >> 22)

        # The slot holding KEY, or the empty slot where it would go.
        def value_table_slot(table: ValueTable&, key: LLVMValueRef) -> u32 can[Abort.Panic, Unsafe.PointerCast]:
            mask: u64 = table.keys.count.u64() - 1
            slot: mutable u64 = value_table_hash(key) & mask
            while table.keys[slot] is present |slot, table, key, mask|:
                break if present == key
                slot <- (slot + 1) & mask
            slot.u32()

        # TABLE's entries in a table of twice the capacity.
        def grown_value_table(table: ValueTable&) -> ValueTable can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            capacity: u32 = table.keys.count.u32() * 2
            grown: mutable ValueTable = ValueTable{keys: empty_value_slots(capacity), values: empty_value_slots(capacity), count: table.count}
            for index in 0..<table.keys.count |grown, table|:
                if table.keys[index] is key:
                    slot: u32 = value_table_slot(&grown, key)
                    grown.keys[slot] <- key
                    grown.values[slot] <- table.values[index]
            grown

    public:
        def new_value_table() -> ValueTable can[Memory.Allocate]:
            ValueTable{keys: empty_value_slots(ValueTableSize::INITIAL), values: empty_value_slots(ValueTableSize::INITIAL), count: 0}

        # The value KEY maps to, if any.
        def value_table_get(table: ValueTable&, key: LLVMValueRef) -> LLVMValueRef? can[Abort.Panic, Unsafe.PointerCast]:
            table.values[value_table_slot(table, key)]

        # TABLE with KEY mapped to VALUE, replacing any earlier value.
        def value_table_set(table: mutable ValueTable, key: LLVMValueRef, value: LLVMValueRef) -> ValueTable can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            current: mutable ValueTable = table
            if (current.count + 1) * 2 > current.keys.count.u32():
                current <- grown_value_table(&current)
            slot: u32 = value_table_slot(&current, key)
            if current.keys[slot] == null:
                current.keys[slot] <- key
                current.count <- current.count + 1
            current.values[slot] <- value
            current
