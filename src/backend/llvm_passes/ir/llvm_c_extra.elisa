# LLVM C API functions the Elisa-hosted passes use beyond ../llvm_c.elisa.
# The nullable results are bound under their own names (via @link_name)
# where ../llvm_c.elisa already binds the function with a non-optional
# result, so a missing node reads as null instead of an unusable handle.

extern LLVMGetNSW(arithmetic_instruction: LLVMValueRef) -> i32
# Whether the value is `undef` or `poison` (PoisonValue is an UndefValue).
extern LLVMIsUndef(value: LLVMValueRef) -> i32
extern LLVMGetTypeContext(type: LLVMTypeRef) -> LLVMContextRef
extern LLVMGetNUW(arithmetic_instruction: LLVMValueRef) -> i32
extern LLVMGetNamedMetadata(m: LLVMModuleRef, name: cstr, name_length: usize) -> void&?
extern LLVMGetModuleFlag(m: LLVMModuleRef, key: cstr, key_length: usize) -> void&?

@link_name("LLVMGetSubprogram")
extern llvm_function_subprogram_or_null(function: LLVMValueRef) -> void&?
extern LLVMSetSuccessor(terminator: LLVMValueRef, index: u32, block: LLVMBasicBlockRef) -> void
extern LLVMGetNumSuccessors(terminator: LLVMValueRef) -> u32
extern LLVMGetSwitchDefaultDest(switch_instruction: LLVMValueRef) -> LLVMBasicBlockRef
extern LLVMInsertBasicBlockInContext(context: LLVMContextRef, before: LLVMBasicBlockRef, name: cstr) -> LLVMBasicBlockRef
extern LLVMIsATerminatorInst(value: LLVMValueRef) -> LLVMValueRef?
extern LLVMAddIncoming(phi: LLVMValueRef, values: void&, blocks: void&, count: u32) -> void
extern LLVMConstNeg(constant: LLVMValueRef) -> LLVMValueRef
extern LLVMSetICmpSameSign(compare: LLVMValueRef, same_sign: i32) -> void
extern LLVMGetICmpSameSign(compare: LLVMValueRef) -> i32
extern LLVMSetExact(division_or_shift: LLVMValueRef, exact: i32) -> void
extern LLVMInstructionClone(instruction: LLVMValueRef) -> LLVMValueRef
extern LLVMInsertIntoBuilder(builder: LLVMBuilderRef, instruction: LLVMValueRef) -> void
extern LLVMIsAInlineAsm(value: LLVMValueRef) -> LLVMValueRef?
extern LLVMIsAAllocaInst(value: LLVMValueRef) -> LLVMValueRef?
extern LLVMContextShouldDiscardValueNames(context: LLVMContextRef) -> i32
extern LLVMInstructionSetDebugLoc(instruction: LLVMValueRef, location: LLVMMetadataRef?) -> void
extern LLVMGetCallSiteEnumAttribute(call: LLVMValueRef, index: u32, kind: u32) -> LLVMAttributeRef?
extern LLVMGetEnumAttributeValue(attribute: LLVMAttributeRef) -> u64
extern LLVMGetNamedGlobalAlias(m: LLVMModuleRef, name: cstr, name_length: usize) -> LLVMValueRef?
extern LLVMGetNamedGlobalIFunc(m: LLVMModuleRef, name: cstr, name_length: usize) -> LLVMValueRef?
extern LLVMIsADbgInfoIntrinsic(value: LLVMValueRef) -> LLVMValueRef?
extern LLVMIsAIntrinsicInst(value: LLVMValueRef) -> LLVMValueRef?
extern LLVMIsAConstantPointerNull(value: LLVMValueRef) -> LLVMValueRef?
extern LLVMIsAArgument(value: LLVMValueRef) -> LLVMValueRef?
extern LLVMIsAConstantFP(value: LLVMValueRef) -> LLVMValueRef?
extern LLVMIsALoadInst(value: LLVMValueRef) -> LLVMValueRef?
extern LLVMGetIsDisjoint(instruction: LLVMValueRef) -> i32
extern LLVMIsACallInst(value: LLVMValueRef) -> LLVMValueRef?
# LLVMTailCallKindMustTail = 2.
extern LLVMGetTailCallKind(call: LLVMValueRef) -> u32
extern LLVMIsABinaryOperator(value: LLVMValueRef) -> LLVMValueRef?
extern LLVMGetPoison(type: LLVMTypeRef) -> LLVMValueRef
extern LLVMIsAFenceInst(value: LLVMValueRef) -> LLVMValueRef?
extern LLVMIsAtomic(instruction: LLVMValueRef) -> i32
# ShuffleVectorInst::getMaskValue: the source lane, or -1 for a poison lane.
extern LLVMGetMaskValue(shuffle: LLVMValueRef, element: u32) -> i32
# `LLVMByteOrdering`: 0 big-endian, 1 little-endian.
extern LLVMByteOrder(target_data: LLVMTargetDataRef) -> u32
extern LLVMSetTailCallKind(call: LLVMValueRef, kind: u32) -> void
# A null target machine builds the passes without target information.
extern LLVMRunPassesOnFunction(function: LLVMValueRef, passes: cstr, target: void&?, options: LLVMPassBuilderOptionsRef) -> void&?
extern LLVMGetParamParent(argument: LLVMValueRef) -> LLVMValueRef
extern LLVMConstAllOnes(type: LLVMTypeRef) -> LLVMValueRef
extern LLVMBuildPhi(builder: LLVMBuilderRef, type: LLVMTypeRef, name: cstr) -> LLVMValueRef
extern LLVMSetComdat(global_value: LLVMValueRef, comdat: LLVMComdatRef?) -> void
extern LLVMConstIntOfArbitraryPrecision(type: LLVMTypeRef, word_count: u32, words: void&) -> LLVMValueRef
# The first of an extractvalue's indices (the C API returns the index array).
extern LLVMGetIndices(instruction: LLVMValueRef) -> u32&
extern LLVMBuildNSWAdd(builder: LLVMBuilderRef, left: LLVMValueRef, right: LLVMValueRef, name: cstr) -> LLVMValueRef
extern LLVMBuildNSWMul(builder: LLVMBuilderRef, left: LLVMValueRef, right: LLVMValueRef, name: cstr) -> LLVMValueRef
extern LLVMSetNSW(arithmetic_instruction: LLVMValueRef, has_no_signed_wrap: i32) -> void
extern LLVMValueIsBasicBlock(value: LLVMValueRef) -> i32
# LLVMMDNodeInContext2 with a nullable operand array, for a node without operands.
@link_name("LLVMMDNodeInContext2")
extern llvm_metadata_node_with_optional_operands(context: LLVMContextRef, operands: void&?, count: usize) -> LLVMMetadataRef
extern LLVMGetFCmpPredicate(instruction: LLVMValueRef) -> i32
extern LLVMInitializeAArch64AsmParser() -> void
extern LLVMValueAsBasicBlock(value: LLVMValueRef) -> LLVMBasicBlockRef
extern LLVMIsAConstantExpr(value: LLVMValueRef) -> LLVMValueRef?
extern LLVMGetConstOpcode(constant: LLVMValueRef) -> u32
extern LLVMIsAGetElementPtrInst(value: LLVMValueRef) -> LLVMValueRef?
extern LLVMOperandBundleRef
extern LLVMStoreSizeOfType(layout: LLVMTargetDataRef, type: LLVMTypeRef) -> u64
extern LLVMIsAMemIntrinsic(value: LLVMValueRef) -> LLVMValueRef?
extern LLVMIsAMemCpyInst(value: LLVMValueRef) -> LLVMValueRef?
extern LLVMIsAMemMoveInst(value: LLVMValueRef) -> LLVMValueRef?
extern LLVMIsAMemSetInst(value: LLVMValueRef) -> LLVMValueRef?
extern LLVMIsAStoreInst(value: LLVMValueRef) -> LLVMValueRef?
extern LLVMGetOperandUse(user: LLVMValueRef, index: u32) -> LLVMUseRef
extern LLVMCreateOperandBundle(tag: cstr, tag_length: usize, arguments: void&, argument_count: u32) -> LLVMOperandBundleRef
extern LLVMDisposeOperandBundle(bundle: LLVMOperandBundleRef) -> void
extern LLVMBuildCallWithOperandBundles(builder: LLVMBuilderRef, type: LLVMTypeRef, function: LLVMValueRef, arguments: void&, argument_count: u32, bundles: void&, bundle_count: u32, name: cstr) -> LLVMValueRef
extern LLVMPositionBuilder(builder: LLVMBuilderRef, block: LLVMBasicBlockRef, instruction: LLVMValueRef?) -> void
extern LLVMBuildExtractElement(builder: LLVMBuilderRef, vector: LLVMValueRef, index: LLVMValueRef, name: cstr) -> LLVMValueRef
extern LLVMBuildInsertElement(builder: LLVMBuilderRef, vector: LLVMValueRef, element: LLVMValueRef, index: LLVMValueRef, name: cstr) -> LLVMValueRef
extern LLVMBuildShuffleVector(builder: LLVMBuilderRef, first: LLVMValueRef, second: LLVMValueRef, mask: LLVMValueRef, name: cstr) -> LLVMValueRef
extern LLVMConstVector(values: void&, count: u32) -> LLVMValueRef
extern LLVMIsABlockAddress(value: LLVMValueRef) -> LLVMValueRef?
# Inserts an unparented instruction at the builder's position (with the builder's
# current debug location, so clear it first to keep the instruction's own).
extern LLVMInsertIntoBuilderWithName(builder: LLVMBuilderRef, instruction: LLVMValueRef, name: cstr) -> void
# The sum of two ConstantInts of one width, wrapping.
extern LLVMConstAdd(left: LLVMValueRef, right: LLVMValueRef) -> LLVMValueRef
# `IRBuilder::CreateBinOp`; `opcode` is an LLVMOpcode.
extern LLVMBuildBinOp(builder: LLVMBuilderRef, opcode: u32, left: LLVMValueRef, right: LLVMValueRef, name: cstr) -> LLVMValueRef
extern LLVMSetNUW(arithmetic_instruction: LLVMValueRef, has_no_unsigned_wrap: i32) -> void
extern LLVMBuildNSWSub(builder: LLVMBuilderRef, left: LLVMValueRef, right: LLVMValueRef, name: cstr) -> LLVMValueRef
extern LLVMConstSub(left: LLVMValueRef, right: LLVMValueRef) -> LLVMValueRef
