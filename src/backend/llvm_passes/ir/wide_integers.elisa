# Signed 128-bit integers as two 64-bit words, for passes that reason about 64-bit values
# exactly: every sum, difference and product of two such values fits. Arithmetic wraps
# at 128 bits, as APInt arithmetic at width 128 does.

# The two's-complement 128-bit value `high * 2^64 + low`.
struct WideInteger:
    high: u64
    low: u64

const module WideIntegerLimit:
    HALF_MASK: u64 = 4294967295
    SIGN_SHIFT: u64 = 63

extend Backend:
    public:
        def wide_from_signed(value: i64) -> WideInteger:
            WideInteger{high: (value >> 63).u64(), low: value.u64()}

        def wide_from_unsigned(value: u64) -> WideInteger:
            WideInteger{high: 0, low: value}

        def wide_add(first: WideInteger, second: WideInteger) -> WideInteger:
            low: u64 = first.low + second.low
            carry: u64 = 1 if low < first.low else 0
            WideInteger{high: first.high + second.high + carry, low: low}

        def wide_negate(value: WideInteger) -> WideInteger:
            wide_add(WideInteger{high: ~value.high, low: ~value.low}, wide_from_unsigned(1))

        def wide_subtract(first: WideInteger, second: WideInteger) -> WideInteger:
            wide_add(first, wide_negate(second))

        # The full 128-bit product of two unsigned words.
        def wide_unsigned_product(first: u64, second: u64) -> WideInteger:
            first_low: u64 = first & WideIntegerLimit::HALF_MASK
            first_high: u64 = first >> 32
            second_low: u64 = second & WideIntegerLimit::HALF_MASK
            second_high: u64 = second >> 32
            low_low: u64 = first_low * second_low
            high_low: u64 = first_high * second_low
            low_high: u64 = first_low * second_high
            high_high: u64 = first_high * second_high
            middle: u64 = (low_low >> 32) + (high_low & WideIntegerLimit::HALF_MASK) + low_high
            WideInteger{high: high_high + (high_low >> 32) + (middle >> 32), low: (middle << 32) | (low_low & WideIntegerLimit::HALF_MASK)}

        # The product modulo 2^128.
        def wide_multiply(first: WideInteger, second: WideInteger) -> WideInteger:
            low: WideInteger = wide_unsigned_product(first.low, second.low)
            WideInteger{high: low.high + first.high * second.low + first.low * second.high, low: low.low}

        def wide_shift_left(value: WideInteger, amount: u32) -> WideInteger:
            return value if amount == 0
            return WideInteger{high: value.low << (amount - 64).u64(), low: 0} if amount >= 64
            WideInteger{high: (value.high << amount.u64()) | (value.low >> (64 - amount).u64()), low: value.low << amount.u64()}

        def wide_is_negative(value: WideInteger) -> bool:
            (value.high >> WideIntegerLimit::SIGN_SHIFT) == 1

        def wide_equals(first: WideInteger, second: WideInteger) -> bool:
            first.high == second.high and first.low == second.low

        # Signed `first < second`.
        def wide_less(first: WideInteger, second: WideInteger) -> bool:
            return first.high.i64() < second.high.i64() if first.high != second.high
            first.low < second.low

        def wide_less_or_equal(first: WideInteger, second: WideInteger) -> bool:
            not wide_less(second, first)

        def wide_minimum(first: WideInteger, second: WideInteger) -> WideInteger:
            second if wide_less(second, first) else first

        def wide_maximum(first: WideInteger, second: WideInteger) -> WideInteger:
            second if wide_less(first, second) else first

        # APInt::isSignedIntN: whether the value fits a signed integer of BITS (1 to 64).
        def wide_fits_signed(value: WideInteger, bits: u32) -> bool:
            return false if value.high != (value.low.i64() >> 63).u64()
            return true if bits >= 64
            shifted: i64 = value.low.i64() >> (bits - 1).i64()
            shifted == 0 or shifted == -1

        # The low 64 bits as a signed word, exact when the value fits 64 bits.
        def wide_to_signed(value: WideInteger) -> i64:
            value.low.i64()
