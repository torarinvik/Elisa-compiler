# The ranges a path walk already found, keyed by value and block: `PathRanges`'
# `DenseMap<std::pair<Value *, BasicBlock *>, ConstantRange>`.
#
# Open addressing with linear probing over a power-of-two capacity, at most half full.
# The memo owns its ranges; lookups hand out copies.

const module PathRangeMemoSize:
    INITIAL: u32 = 16

# Each slot holds a value, a block and the range of the value there, or none of them.
struct PathRangeMemo:
    values: mutable darray[LLVMValueRef?]
    blocks: mutable darray[LLVMBasicBlockRef?]
    ranges: mutable darray[ElisaConstantRangeRef?]
    count: mutable u32

extend Backend:
    private:
        def empty_path_range_memo(capacity: u32) -> PathRangeMemo can[Memory.Allocate]:
            values: mutable darray[LLVMValueRef?] = []
            blocks: mutable darray[LLVMBasicBlockRef?] = []
            ranges: mutable darray[ElisaConstantRangeRef?] = []
            while values.count < capacity |values, blocks, ranges, capacity|:
                values.push(null)
                blocks.push(null)
                ranges.push(null)
            PathRangeMemo{values: values, blocks: blocks, ranges: ranges, count: 0}

        # The slot holding VALUE at BLOCK, or the empty slot where it would go.
        def path_range_slot(memo: PathRangeMemo&, value: LLVMValueRef, block: LLVMBasicBlockRef) -> u32 can[Abort.Panic, Unsafe.PointerCast]:
            mask: u64 = memo.values.count.u64() - 1
            hash: u64 = value_table_hash(value) ^ (value_table_hash(LLVMBasicBlockAsValue(block)) * 31)
            slot: mutable u64 = hash & mask
            while memo.values[slot] is present |slot, memo, value, block, mask|:
                if memo.blocks[slot] is present_block:
                    break if present == value and present_block == block
                slot <- (slot + 1) & mask
            slot.u32()

        # MEMO's entries in a memo of twice the capacity.
        def grown_path_range_memo(memo: PathRangeMemo&) -> PathRangeMemo can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            grown: mutable PathRangeMemo = empty_path_range_memo(memo.values.count.u32() * 2)
            grown.count <- memo.count
            for index in 0..<memo.values.count |grown, memo|:
                if memo.values[index] is value:
                    if memo.blocks[index] is block:
                        slot: u32 = path_range_slot(&grown, value, block)
                        grown.values[slot] <- value
                        grown.blocks[slot] <- block
                        grown.ranges[slot] <- memo.ranges[index]
            grown

    public:
        def new_path_range_memo() -> PathRangeMemo can[Memory.Allocate]:
            empty_path_range_memo(PathRangeMemoSize::INITIAL)

        # A copy of the range of VALUE at BLOCK, if the memo has it.
        def path_range_memo_get(memo: PathRangeMemo&, value: LLVMValueRef, block: LLVMBasicBlockRef) -> ElisaConstantRangeRef? can[Abort.Panic, Unsafe.PointerCast]:
            stored: ElisaConstantRangeRef? = memo.ranges[path_range_slot(memo, value, block)]
            range: ElisaConstantRangeRef = get stored else return null
            ElisaLLVMConstantRangeCopy(range)

        # MEMO with a copy of RANGE for VALUE at BLOCK unless it already has one
        # (`try_emplace`).
        def path_range_memo_insert(memo: mutable PathRangeMemo, value: LLVMValueRef, block: LLVMBasicBlockRef, range: ElisaConstantRangeRef) -> PathRangeMemo can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            current: mutable PathRangeMemo = memo
            if (current.count + 1) * 2 > current.values.count.u32():
                current <- grown_path_range_memo(&current)
            slot: u32 = path_range_slot(&current, value, block)
            if current.values[slot] == null:
                current.values[slot] <- value
                current.blocks[slot] <- block
                current.ranges[slot] <- ElisaLLVMConstantRangeCopy(range)
                current.count <- current.count + 1
            current

        # Every range MEMO owns, disposed.
        def dispose_path_range_memo(memo: PathRangeMemo&) -> void:
            for slot in memo.ranges:
                if slot is range:
                    ElisaLLVMDisposeConstantRange(range)
