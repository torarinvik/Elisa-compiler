# Reading loop IDs: the operands of a metadata node and the names of loop properties.

extend Backend:
    public:
        # The operands of the metadata node VALUE (a MetadataAsValue).
        def metadata_node_operands(value: LLVMValueRef) -> darray[LLVMValueRef] can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            count: usize = LLVMGetMDNodeNumOperands(value).usize()
            return [] if count == 0
            # LLVM overwrites every slot; seed with a valid handle.
            operands: mutable darray[LLVMValueRef] = [value for _ in 0..<count]
            LLVMGetMDNodeOperands(value, (&operands[0]).cast[void&] can Unsafe.PointerCast)
            operands

        # The name a loop property node spells in its first operand; none when the
        # property is not a node or its first operand is not a string.
        def loop_property_name(property: LLVMValueRef) -> darray[u8]? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            return null if LLVMIsAMDNode(property) == null
            operands: darray[LLVMValueRef] = metadata_node_operands(property)
            return null if operands.count == 0 or LLVMIsAMDString(operands[0]) == null
            length: mutable u32 = 0
            text: void& = get LLVMGetMDString(operands[0], (&length).cast[void&] can Unsafe.PointerCast) else return null
            bytes: u8& = text.cast[u8&] can Unsafe.PointerCast
            view: sview = unsafe_sview_bounded_bytes(bytes, length.usize())
            name: mutable darray[u8] = []
            for position in 0..<view.len |name, view|:
                name.push(view[position])
            name

        # Whether NAME begins with PREFIX.
        def name_has_prefix(name: darray[u8]&, prefix: sview) -> bool can[Abort.Panic]:
            return false if name.count < prefix.len
            for position in 0..<prefix.len |name, prefix|:
                return false if name[position] != prefix[position]
            true
