# IR inspection and editing helpers shared by the Elisa-hosted passes, over
# the LLVM C API: phi incoming lookups, use rewriting and intrinsic calls.
include "./llvm_ir_queries.elisa"
include "../../llvm_c_api/elisa_llvm_analysis.elisa"
include "../../llvm_c_api/elisa_llvm_ir_edits.elisa"
include "./llvm_c_extra.elisa"

extern LLVMGetExact(division_or_shift: LLVMValueRef) -> i32
extern LLVMBuildFreeze(b: LLVMBuilderRef, value: LLVMValueRef, name: cstr) -> LLVMValueRef
extern LLVMBuildInBoundsGEP2(b: LLVMBuilderRef, type: LLVMTypeRef, pointer: LLVMValueRef, indices: void&, count: u32, name: cstr) -> LLVMValueRef
extern LLVMArrayType2(element: LLVMTypeRef, count: u64) -> LLVMTypeRef
extern LLVMSetCondition(branch: LLVMValueRef, condition: LLVMValueRef) -> void
extern LLVMInstructionGetDebugLoc(instruction: LLVMValueRef) -> LLVMMetadataRef?
extern LLVMGetLastInstruction(block: LLVMBasicBlockRef) -> LLVMValueRef?

extend Backend:
    public:
        def instruction_count(block: LLVMBasicBlockRef) -> u32:
            count: mutable u32 = 0
            cursor: mutable LLVMValueRef? = LLVMGetFirstInstruction(block)
            while cursor is instruction |cursor, count|:
                count <- count + 1
                cursor <- LLVMGetNextInstruction(instruction)
            count

        def function_instruction_count(function: LLVMValueRef) -> u32:
            count: mutable u32 = 0
            cursor: mutable LLVMBasicBlockRef? = LLVMGetFirstBasicBlock(function)
            while cursor is block |cursor, count|:
                count <- count + instruction_count(block)
                cursor <- LLVMGetNextBasicBlock(block)
            count

        def function_block_count(function: LLVMValueRef) -> u32:
            count: mutable u32 = 0
            cursor: mutable LLVMBasicBlockRef? = LLVMGetFirstBasicBlock(function)
            while cursor is block |cursor, count|:
                count <- count + 1
                cursor <- LLVMGetNextBasicBlock(block)
            count

        # The first incoming edge of the phi from the block, as
        # PHINode::getBasicBlockIndex; -1 when there is none.
        def phi_incoming_index(phi: LLVMValueRef, block: LLVMBasicBlockRef) -> i64:
            for index in 0..<LLVMCountIncoming(phi).usize() |phi, block|:
                return index.i64() if LLVMGetIncomingBlock(phi, index.u32()) == block
            -1

        def phi_incoming_for_block(phi: LLVMValueRef, block: LLVMBasicBlockRef) -> LLVMValueRef?:
            index: i64 = phi_incoming_index(phi, block)
            return null if index < 0
            LLVMGetIncomingValue(phi, index.u32())

        def set_phi_incoming_for_block(phi: LLVMValueRef, block: LLVMBasicBlockRef, value: LLVMValueRef) -> void:
            index: i64 = phi_incoming_index(phi, block)
            LLVMSetOperand(phi, index.u32(), value) if index >= 0

        # ConstantInt::equalsInt at any width: a constant wider than 64 bits equals EXPECTED
        # only when its high bits are clear.
        def is_constant_integer(value: LLVMValueRef, expected: u64) -> bool:
            LLVMIsAConstantInt(value) != null and ElisaLLVMConstantIntEquals(value, expected) != 0

        def is_optional_constant_integer(value: LLVMValueRef?, expected: u64) -> bool:
            if value is present:
                return is_constant_integer(present, expected)
            false

        def is_optional_value(value: LLVMValueRef?, expected: LLVMValueRef) -> bool:
            if value is present:
                return present == expected
            false

        # Whether two possibly missing values are the same, or both missing.
        def same_optional_value(first: LLVMValueRef?, second: LLVMValueRef?) -> bool:
            if first is first_value:
                return is_optional_value(second, first_value)
            second == null

        # The first instruction of the block that is not a phi; every block
        # this is asked of ends in a terminator, so one exists.
        def first_non_phi(block: LLVMBasicBlockRef) -> LLVMValueRef can[Abort.Panic]:
            cursor: mutable LLVMValueRef? = LLVMGetFirstInstruction(block)
            while cursor is instruction |cursor|:
                return instruction if not is_llvm_instruction_with_opcode(instruction, LLVMOpcode::PHI)
                cursor <- LLVMGetNextInstruction(instruction)
            panic("block without a terminator")

        # BasicBlock::getSinglePredecessor: the block's only incoming edge's
        # source, when exactly one terminator branches to it.
        def single_predecessor(block: LLVMBasicBlockRef) -> LLVMBasicBlockRef?:
            predecessor: mutable LLVMBasicBlockRef? = null
            edges: mutable u32 = 0
            use_cursor: mutable LLVMUseRef? = LLVMGetFirstUse(LLVMBasicBlockAsValue(block))
            while use_cursor is use |use_cursor, predecessor, edges|:
                user: LLVMValueRef = LLVMGetUser(use)
                if LLVMIsATerminatorInst(user) != null:
                    edges <- edges + 1
                    predecessor <- LLVMGetInstructionParent(user)
                use_cursor <- LLVMGetNextUse(use)
            predecessor if edges == 1 else null

        # The blocks that branch to `block`, once per edge, in use-list order: LLVM's
        # `predecessors(block)`.
        def predecessor_edges(block: LLVMBasicBlockRef) -> darray[LLVMBasicBlockRef] can[Memory.Allocate]:
            sources: mutable darray[LLVMBasicBlockRef] = []
            use_cursor: mutable LLVMUseRef? = LLVMGetFirstUse(LLVMBasicBlockAsValue(block))
            while use_cursor is use |use_cursor, sources|:
                user: LLVMValueRef = LLVMGetUser(use)
                sources.push(LLVMGetInstructionParent(user)) if LLVMIsATerminatorInst(user) != null
                use_cursor <- LLVMGetNextUse(use)
            sources

        def block_has_phis(block: LLVMBasicBlockRef) -> bool:
            if LLVMGetFirstInstruction(block) is head:
                return is_llvm_instruction_with_opcode(head, LLVMOpcode::PHI)
            false

        def has_loop_metadata(instruction: LLVMValueRef, context: LLVMContextRef) -> bool can[Abort.Panic, Memory.Allocate]:
            name_storage: mutable darray[u8] = []
            name: sview = "llvm.loop"
            kind: u32 = LLVMGetMDKindIDInContext(context, sview_to_cstr(name, name_storage), name.len.u32())
            LLVMGetMetadata(instruction, kind) != null

        def is_unconditional_branch_to(instruction: LLVMValueRef?, target: LLVMBasicBlockRef) -> bool:
            if instruction is branch:
                return LLVMGetInstructionOpcode(branch) == LLVMOpcode::UNCONDITIONAL_BR and LLVMGetSuccessor(branch, 0) == target
            false

        # Positions the builder before the instruction and takes its debug
        # location, as `IRBuilder<>(instruction)` does.
        def position_builder_before(builder: LLVMBuilderRef, instruction: LLVMValueRef) -> void:
            LLVMPositionBuilderBefore(builder, instruction)
            set_builder_debug_location(builder, instruction)

        # A conditional branch terminating the block, if it has one.
        def conditional_terminator(block: LLVMBasicBlockRef) -> LLVMValueRef?:
            if LLVMGetLastInstruction(block) is last:
                return last if LLVMGetInstructionOpcode(last) == LLVMOpcode::CONDITIONAL_BR
            null

        # The phi following `phi`, or else the block's first phi: where a
        # loop keeps its second recurrence.
        def neighbouring_phi(block: LLVMBasicBlockRef, phi: LLVMValueRef) -> LLVMValueRef?:
            if LLVMGetNextInstruction(phi) is next:
                return next if is_llvm_instruction_with_opcode(next, LLVMOpcode::PHI)
            if LLVMGetFirstInstruction(block) is head:
                return head if is_llvm_instruction_with_opcode(head, LLVMOpcode::PHI)
            null

        # `phi + 1` computed in the block: the phi's value on the edge from it.
        def block_increment_of(block: LLVMBasicBlockRef, phi: LLVMValueRef) -> LLVMValueRef?:
            if phi_incoming_for_block(phi, block) is next:
                return null if not is_llvm_instruction_with_opcode(next, LLVMOpcode::ADD) or LLVMGetInstructionParent(next) != block
                return null if LLVMGetOperand(next, 0) != phi or not is_constant_integer(LLVMGetOperand(next, 1), 1)
                return next
            null

        # Replaces every use of `original` by an instruction outside `block`
        # with `replacement`.
        def replace_uses_outside_block(original: LLVMValueRef, replacement: LLVMValueRef, block: LLVMBasicBlockRef) -> void can[Abort.Panic, Memory.Allocate]:
            users: mutable darray[LLVMValueRef] = []
            use_cursor: mutable LLVMUseRef? = LLVMGetFirstUse(original)
            while use_cursor is use |use_cursor, users|:
                users.push(LLVMGetUser(use))
                use_cursor <- LLVMGetNextUse(use)
            for user in users |original, replacement, block|:
                if LLVMIsAInstruction(user) != null and LLVMGetInstructionParent(user) != block:
                    for operand in 0..<LLVMGetNumOperands(user).usize() |user, original, replacement|:
                        LLVMSetOperand(user, operand.u32(), replacement) if LLVMGetOperand(user, operand.u32()) == original

        # Replaces every use of `original` by an instruction in `block`.
        def replace_uses_in_block(original: LLVMValueRef, replacement: LLVMValueRef, block: LLVMBasicBlockRef) -> void can[Abort.Panic, Memory.Allocate]:
            users: mutable darray[LLVMValueRef] = []
            use_cursor: mutable LLVMUseRef? = LLVMGetFirstUse(original)
            while use_cursor is use |use_cursor, users|:
                users.push(LLVMGetUser(use))
                use_cursor <- LLVMGetNextUse(use)
            for user in users |original, replacement, block|:
                if LLVMIsAInstruction(user) != null and LLVMGetInstructionParent(user) == block:
                    for operand in 0..<LLVMGetNumOperands(user).usize() |user, original, replacement|:
                        LLVMSetOperand(user, operand.u32(), replacement) if LLVMGetOperand(user, operand.u32()) == original

        def add_phi_incoming(phi: LLVMValueRef, value: LLVMValueRef, block: LLVMBasicBlockRef) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            values: mutable darray[LLVMValueRef] = [value]
            blocks: mutable darray[LLVMBasicBlockRef] = [block]
            value_slots: void& = (&values[0]).cast[void&] can Unsafe.PointerCast
            block_slots: void& = (&blocks[0]).cast[void&] can Unsafe.PointerCast
            LLVMAddIncoming(phi, value_slots, block_slots, 1)

        # PHINode::replaceIncomingBlockWith for every phi of `block`.
        def replace_phi_incoming_blocks(block: LLVMBasicBlockRef, original: LLVMBasicBlockRef, replacement: LLVMBasicBlockRef) -> void:
            cursor: mutable LLVMValueRef? = LLVMGetFirstInstruction(block)
            while cursor is phi |cursor, original, replacement|:
                break if not is_llvm_instruction_with_opcode(phi, LLVMOpcode::PHI)
                for edge in 0..<LLVMCountIncoming(phi).usize() |phi, original, replacement|:
                    ElisaLLVMSetIncomingBlock(phi, edge.u32(), replacement) if LLVMGetIncomingBlock(phi, edge.u32()) == original
                cursor <- LLVMGetNextInstruction(phi)

        # `llvm.ctlz(value, true)`.
        def build_count_leading_zeros(builder: LLVMBuilderRef, module: LLVMModuleRef, value: LLVMValueRef) -> LLVMValueRef can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            build_count_zeros_intrinsic(builder, module, "llvm.ctlz", value, true)

        # `llvm.cttz(value, false)`: the bit width for zero.
        def build_count_trailing_zeros(builder: LLVMBuilderRef, module: LLVMModuleRef, value: LLVMValueRef) -> LLVMValueRef can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            build_count_zeros_intrinsic(builder, module, "llvm.cttz", value, false)

        # A call of the zero-count intrinsic NAME, overloaded on VALUE's type; ZERO_IS_POISON
        # is its second operand.
        def build_count_zeros_intrinsic(builder: LLVMBuilderRef, module: LLVMModuleRef, name: sview, value: LLVMValueRef, zero_is_poison: bool) -> LLVMValueRef can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            flag: LLVMValueRef = LLVMConstInt(LLVMInt1TypeInContext(LLVMGetModuleContext(module)), 1 if zero_is_poison else 0, 0)
            arguments: darray[LLVMValueRef] = [value, flag]
            build_overloaded_intrinsic(builder, module, name, &arguments)

        # `llvm.ctpop` of VALUE, overloaded on its type.
        def build_population_count(builder: LLVMBuilderRef, module: LLVMModuleRef, value: LLVMValueRef) -> LLVMValueRef can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            build_unary_intrinsic(builder, module, "llvm.ctpop", value)

        # A call of the one-operand intrinsic NAME, overloaded on VALUE's type.
        def build_unary_intrinsic(builder: LLVMBuilderRef, module: LLVMModuleRef, name: sview, value: LLVMValueRef) -> LLVMValueRef can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            arguments: darray[LLVMValueRef] = [value]
            build_overloaded_intrinsic(builder, module, name, &arguments)

        # An unnamed call of the intrinsic NAME, overloaded on its first argument's type,
        # as `IRBuilder::CreateIntrinsic(id, {type}, arguments)`.
        def build_overloaded_intrinsic(builder: LLVMBuilderRef, module: LLVMModuleRef, name: sview, arguments: darray[LLVMValueRef]&) -> LLVMValueRef can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            context: LLVMContextRef = LLVMGetModuleContext(module)
            name_storage: mutable darray[u8] = []
            id: u32 = LLVMLookupIntrinsicID(sview_to_cstr(name, name_storage), name.len.usize())
            overloads: mutable darray[LLVMTypeRef] = [LLVMTypeOf(arguments[0])]
            overload_slots: void& = (&overloads[0]).cast[void&] can Unsafe.PointerCast
            declaration: LLVMValueRef = LLVMGetIntrinsicDeclaration(module, id, overload_slots, 1)
            argument_slots: void& = (&arguments[0]).cast[void&] can Unsafe.PointerCast
            LLVMBuildCall2(builder, LLVMIntrinsicGetType(context, id, overload_slots, 1), declaration, argument_slots, arguments.count.u32(), "")

        def optional_equals(value: LLVMValueRef?, expected: LLVMValueRef) -> bool:
            if value is present:
                return present == expected
            false

        # Value::getNumUses.
        def use_count(value: LLVMValueRef) -> u32:
            count: mutable u32 = 0
            use_cursor: mutable LLVMUseRef? = LLVMGetFirstUse(value)
            while use_cursor is use |use_cursor, count|:
                count <- count + 1
                use_cursor <- LLVMGetNextUse(use)
            count

        # A CallBase: a call, invoke or callbr.
        def is_call_base(instruction: LLVMValueRef) -> bool:
            opcode: u32 = LLVMGetInstructionOpcode(instruction)
            opcode == LLVMOpcode::CALL or opcode == LLVMOpcode::INVOKE or opcode == LLVMOpcode::CALL_BR

        def same_optional_block(block: LLVMBasicBlockRef?, expected: LLVMBasicBlockRef) -> bool:
            if block is present:
                return present == expected
            false

        def set_builder_debug_location(builder: LLVMBuilderRef, instruction: LLVMValueRef) -> void:
            LLVMSetCurrentDebugLocation2(builder, LLVMInstructionGetDebugLoc(instruction))

        # `Instruction::copyMetadata`: every attachment of SOURCE and its debug location.
        def copy_instruction_metadata(destination: LLVMValueRef, source: LLVMValueRef) -> void can[Unsafe.PointerCast]:
            context: LLVMContextRef = LLVMGetTypeContext(LLVMTypeOf(source))
            count: mutable usize = 0
            if LLVMInstructionGetAllMetadataOtherThanDebugLoc(source, &count) is entries:
                for index in 0..<count.u32() |entries, destination, context|:
                    node: LLVMValueRef = LLVMMetadataAsValue(context, LLVMValueMetadataEntriesGetMetadata(entries, index))
                    LLVMSetMetadata(destination, LLVMValueMetadataEntriesGetKind(entries, index), node)
                LLVMDisposeValueMetadataEntries(entries)
            LLVMInstructionSetDebugLoc(destination, LLVMInstructionGetDebugLoc(source))
