# Pattern pieces shared by the single-block scalar loop folds: binary operators of a given
# block, operand pairs in either order, and the unsigned range test that keeps a loop going.
include "./ir_editing.elisa"

# The comparison a branch continues on while `lower <u upper`, and its LOWER operand.
struct UnsignedContinueTest:
    compare: LLVMValueRef
    lower: LLVMValueRef

extend Backend:
    public:
        # VALUE when it is a binary operator OPCODE in BLOCK.
        def block_binary_operator(value: LLVMValueRef?, opcode: u32, block: LLVMBasicBlockRef) -> LLVMValueRef?:
            present: LLVMValueRef = get value else return null
            return null if not is_llvm_instruction_with_opcode(present, opcode) or LLVMGetInstructionParent(present) != block
            present

        # Whether BINARY's operands are FIRST and SECOND, in either order.
        def has_operand_pair(binary: LLVMValueRef, first: LLVMValueRef, second: LLVMValueRef) -> bool:
            left: LLVMValueRef = LLVMGetOperand(binary, 0)
            right: LLVMValueRef = LLVMGetOperand(binary, 1)
            (left == first and right == second) or (left == second and right == first)

        # Replaces every operand of INSTRUCTION equal to ORIGINAL (`User::replaceUsesOfWith`).
        def replace_operand_uses(instruction: LLVMValueRef, original: LLVMValueRef, replacement: LLVMValueRef) -> void:
            for index in 0..<LLVMGetNumOperands(instruction) |instruction, original, replacement|:
                if LLVMGetOperand(instruction, index) == original:
                    LLVMSetOperand(instruction, index, replacement)

        # Whether FIRST comes before SECOND in their block.
        def comes_before(first: LLVMValueRef, second: LLVMValueRef) -> bool:
            cursor: mutable LLVMValueRef? = LLVMGetNextInstruction(first)
            while cursor is instruction |cursor, second|:
                return true if instruction == second
                cursor <- LLVMGetNextInstruction(instruction)
            false

        # The single-use comparison on which BRANCH (no metadata beyond a debug location,
        # two distinct successors) continues to CONTINUE_BLOCK exactly when some value is
        # unsigned-below UPPER: `lower <u upper` or `upper >u lower`.
        def unsigned_continue_test(branch: LLVMValueRef, continue_block: LLVMBasicBlockRef, upper: LLVMValueRef) -> UnsignedContinueTest?:
            compare: LLVMValueRef = LLVMGetCondition(branch)
            return null if not is_llvm_instruction_with_opcode(compare, LLVMOpcode::ICMP) or not has_one_use(compare)
            return null if ElisaLLVMHasMetadataOtherThanDebugLoc(branch) != 0 or LLVMGetSuccessor(branch, 0) == LLVMGetSuccessor(branch, 1)
            true_edge: bool = LLVMGetSuccessor(branch, 0) == continue_block
            return null if not true_edge and LLVMGetSuccessor(branch, 1) != continue_block
            predicate: i32 = LLVMGetICmpPredicate(compare) if true_edge else inverse_integer_predicate(LLVMGetICmpPredicate(compare))
            return UnsignedContinueTest{compare: compare, lower: LLVMGetOperand(compare, 0)} if predicate == LLVMIntPredicate::ULT and LLVMGetOperand(compare, 1) == upper
            return UnsignedContinueTest{compare: compare, lower: LLVMGetOperand(compare, 1)} if predicate == LLVMIntPredicate::UGT and LLVMGetOperand(compare, 0) == upper
            null
