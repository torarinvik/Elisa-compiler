# Recover the exponent of the greatest power of two not exceeding a positive
# input from its highest set bit. Recognizes the doubling loop that counts
# the exponent, the loop that finds the power itself, and the fully
# unrolled search that compares against every power in turn.
include "./ir_editing.elisa"
include "./loop_pass_policy.elisa"

const module PowerPositionLimits:
    MAX_FUNCTION_BLOCKS: u32 = 128
    COUNTING_LOOP_INSTRUCTIONS: u32 = 6
    SEARCH_LOOP_INSTRUCTIONS: u32 = 4
    CHAIN_EXPONENTS: u64 = 61
    CHAIN_STEP_INSTRUCTIONS: u32 = 2
    CHAIN_LAST_INSTRUCTIONS: u32 = 3
    HIGHEST_BIT: u64 = 63

# The doubling loop that counts the exponent, `while power <= input / 2`,
# and the conditional branch of the block that enters it.
struct PowerCountingLoop:
    power: LLVMValueRef
    position: LLVMValueRef
    doubled: LLVMValueRef
    next: LLVMValueRef
    done: LLVMValueRef
    back: LLVMValueRef
    small: LLVMValueRef
    enter: LLVMValueRef
    entry: LLVMBasicBlockRef
    exit: LLVMBasicBlockRef

extend Backend:
    private:
        # The latch of a single-block loop of `size` instructions, whose
        # back edge is taken on the second successor while an `icmp` with
        # the predicate holds, and which carries no loop metadata.
        def self_loop_latch(body: LLVMBasicBlockRef, context: LLVMContextRef, predicate: i32, size: u32) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate]:
            return null if instruction_count(body) != size or ElisaLLVMBlockHasAddressTaken(body) != 0
            if conditional_terminator(body) is back:
                done: LLVMValueRef = LLVMGetCondition(back)
                return null if not is_llvm_instruction_with_opcode(done, LLVMOpcode::ICMP) or LLVMGetICmpPredicate(done) != predicate
                return null if LLVMGetSuccessor(back, 1) != body or has_loop_metadata(back, context)
                return back
            null

        # The block the two-input phi enters from, other than the loop body.
        def loop_entry_block(power: LLVMValueRef, body: LLVMBasicBlockRef) -> LLVMBasicBlockRef:
            other_edge: u32 = 1 if LLVMGetIncomingBlock(power, 0) == body else 0
            LLVMGetIncomingBlock(power, other_edge)

        # `trunc(63 - ctlz(input, true))`, the exponent of the highest set bit.
        def build_power_position(builder: LLVMBuilderRef, module: LLVMModuleRef, input: LLVMValueRef, result_type: LLVMTypeRef) -> LLVMValueRef can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            zeros: LLVMValueRef = build_count_leading_zeros(builder, module, input)
            highest_bit: LLVMValueRef = LLVMBuildSub(builder, LLVMConstInt(LLVMTypeOf(input), PowerPositionLimits::HIGHEST_BIT, 0), zeros, "")
            name_storage: mutable darray[u8] = []
            LLVMBuildTrunc(builder, highest_bit, result_type, sview_to_cstr("power.position", name_storage))

        def has_single_predecessor(block: LLVMBasicBlockRef, expected: LLVMBasicBlockRef) -> bool:
            if single_predecessor(block) is predecessor:
                return predecessor == expected
            false

        def is_doubling_in(value: LLVMValueRef, body: LLVMBasicBlockRef) -> bool:
            return false if not is_llvm_instruction_with_opcode(value, LLVMOpcode::SHL) or LLVMGetInstructionParent(value) != body
            is_constant_integer(LLVMGetOperand(value, 1), 1)

        def is_inexact_division(value: LLVMValueRef, opcode: u32, divisor: u64) -> bool:
            return false if not is_llvm_instruction_with_opcode(value, opcode) or LLVMGetExact(value) != 0
            is_constant_integer(LLVMGetOperand(value, 1), divisor)

        # The loop's exit: its own block, entered only from the loop, with no phis.
        def counting_loop_exit(body: LLVMBasicBlockRef, back: LLVMValueRef) -> LLVMBasicBlockRef?:
            exit: LLVMBasicBlockRef = LLVMGetSuccessor(back, 0)
            return null if exit == body or block_has_phis(exit) or not has_single_predecessor(exit, body)
            exit

        # The power phi doubled each visit, starting from 1 on the entry edge.
        def counting_loop_power(body: LLVMBasicBlockRef, doubled: LLVMValueRef, exit: LLVMBasicBlockRef) -> LLVMValueRef?:
            power: LLVMValueRef = LLVMGetOperand(doubled, 0)
            return null if not is_llvm_instruction_with_opcode(power, LLVMOpcode::PHI) or LLVMGetInstructionParent(power) != body
            return null if LLVMCountIncoming(power) != 2 or not is_optional_value(phi_incoming_for_block(power, body), doubled)
            entry: LLVMBasicBlockRef = loop_entry_block(power, body)
            return null if entry == exit or not is_optional_constant_integer(phi_incoming_for_block(power, entry), 1)
            power

        # The entry's branch: into the loop unless `input < 2`, and otherwise
        # to a third block.
        def counting_loop_enter(entry: LLVMBasicBlockRef, body: LLVMBasicBlockRef, exit: LLVMBasicBlockRef, input: LLVMValueRef) -> LLVMValueRef?:
            if conditional_terminator(entry) is enter:
                small: LLVMValueRef = LLVMGetCondition(enter)
                return null if not is_llvm_instruction_with_opcode(small, LLVMOpcode::ICMP) or LLVMGetICmpPredicate(small) != LLVMIntPredicate::SLT
                return null if LLVMGetOperand(small, 0) != input or not is_constant_integer(LLVMGetOperand(small, 1), 2)
                bypass: LLVMBasicBlockRef = LLVMGetSuccessor(enter, 0)
                return null if LLVMGetSuccessor(enter, 1) != body or bypass == body or bypass == exit
                return enter
            null

        # The 32-bit exponent counter, from 0, and its increment.
        def counting_loop_position(body: LLVMBasicBlockRef, power: LLVMValueRef, entry: LLVMBasicBlockRef) -> LLVMValueRef?:
            if neighbouring_phi(body, power) is position:
                return null if position == power or not is_llvm_integer_type(LLVMTypeOf(position), 32) or LLVMCountIncoming(position) != 2
                return position if is_optional_constant_integer(phi_incoming_for_block(position, entry), 0)
            null

        def match_counting_loop(body: LLVMBasicBlockRef, context: LLVMContextRef) -> PowerCountingLoop? can[Abort.Panic, Memory.Allocate]:
            if self_loop_latch(body, context, LLVMIntPredicate::SGT, PowerPositionLimits::COUNTING_LOOP_INSTRUCTIONS) is back:
                done: LLVMValueRef = LLVMGetCondition(back)
                if counting_loop_exit(body, back) is exit:
                    doubled: LLVMValueRef = LLVMGetOperand(done, 0)
                    limit: LLVMValueRef = LLVMGetOperand(done, 1)
                    return null if not is_doubling_in(doubled, body) or not is_llvm_integer_type(LLVMTypeOf(doubled), 64)
                    return null if not is_inexact_division(limit, LLVMOpcode::SDIV, 2)
                    if counting_loop_power(body, doubled, exit) is power:
                        entry: LLVMBasicBlockRef = loop_entry_block(power, body)
                        if counting_loop_enter(entry, body, exit, LLVMGetOperand(limit, 0)) is enter:
                            if counting_loop_position(body, power, entry) is position:
                                if block_increment_of(body, position) is next:
                                    return PowerCountingLoop{power: power, position: position, doubled: doubled, next: next, done: done, back: back, small: LLVMGetCondition(enter), enter: enter, entry: entry, exit: exit}
            null

        def is_counting_loop_member(instruction: LLVMValueRef, loop: PowerCountingLoop&) -> bool:
            instruction == loop.power or instruction == loop.position or instruction == loop.doubled or instruction == loop.next or instruction == loop.done or instruction == loop.back

        # The body holds only the loop, used in the body or, for the counter
        # and its increment, in the exit.
        def counting_loop_is_closed(body: LLVMBasicBlockRef, loop: PowerCountingLoop&) -> bool:
            cursor: mutable LLVMValueRef? = LLVMGetFirstInstruction(body)
            while cursor is instruction |cursor, body, loop|:
                return false if not is_counting_loop_member(instruction, loop)
                counts: bool = instruction == loop.position or instruction == loop.next
                use_cursor: mutable LLVMUseRef? = LLVMGetFirstUse(instruction)
                while use_cursor is use |use_cursor, body, loop, counts|:
                    user: LLVMValueRef = LLVMGetUser(use)
                    return false if LLVMIsAInstruction(user) == null
                    parent: LLVMBasicBlockRef = LLVMGetInstructionParent(user)
                    return false if parent != body and (parent != loop.exit or not counts)
                    use_cursor <- LLVMGetNextUse(use)
                cursor <- LLVMGetNextInstruction(instruction)
            true

        # The signed half-limit is less than 2^62. Starting at one, the first
        # doubling that exceeds it is representable, and the loop runs at
        # most 62 times. The counter after that doubling is floor(log2(input)).
        def fold_power_position_loop(body: LLVMBasicBlockRef, module: LLVMModuleRef, builder: LLVMBuilderRef) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            context: LLVMContextRef = LLVMGetModuleContext(module)
            if match_counting_loop(body, context) is loop:
                return false if not counting_loop_is_closed(body, &loop)
                position_builder_before(builder, loop.enter)
                input: LLVMValueRef = LLVMBuildFreeze(builder, LLVMGetOperand(loop.small, 0), "")
                LLVMSetCondition(loop.enter, LLVMBuildICmp(builder, LLVMIntPredicate::SLT, input, LLVMConstInt(LLVMTypeOf(input), 2, 0), ""))
                position_type: LLVMTypeRef = LLVMTypeOf(loop.position)
                index: LLVMValueRef = build_power_position(builder, module, input, position_type)
                previous: LLVMValueRef = LLVMBuildSub(builder, index, LLVMConstInt(position_type, 1, 0), "")
                replace_uses_in_block(loop.next, index, loop.exit)
                replace_uses_in_block(loop.position, previous, loop.exit)
                LLVMSetSuccessor(loop.enter, 1, loop.exit)
                LLVMDeleteBasicBlock(body)
                return true
            false

        # Only the power leaves the loop, through phis of the exit on the
        # edge from the loop.
        def search_loop_is_closed(body: LLVMBasicBlockRef, power: LLVMValueRef, exit: LLVMBasicBlockRef) -> bool:
            cursor: mutable LLVMValueRef? = LLVMGetFirstInstruction(body)
            while cursor is instruction |cursor, body, power, exit|:
                use_cursor: mutable LLVMUseRef? = LLVMGetFirstUse(instruction)
                while use_cursor is use |use_cursor, instruction, body, power, exit|:
                    user: LLVMValueRef = LLVMGetUser(use)
                    return false if LLVMIsAInstruction(user) == null
                    if LLVMGetInstructionParent(user) != body:
                        return false if instruction != power or not is_llvm_instruction_with_opcode(user, LLVMOpcode::PHI) or LLVMGetInstructionParent(user) != exit
                        for edge in 0..<LLVMCountIncoming(user).usize() |user, power, body|:
                            return false if LLVMGetIncomingValue(user, edge.u32()) == power and LLVMGetIncomingBlock(user, edge.u32()) != body
                    use_cursor <- LLVMGetNextUse(use)
                cursor <- LLVMGetNextInstruction(instruction)
            true

        # The search loop `power = 1; while power <= input >> 1: power <<= 1`.
        # The header tests the power before doubling, and the half-limit keeps
        # every doubling in range, even for the largest unsigned input.
        def match_search_loop(body: LLVMBasicBlockRef, context: LLVMContextRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate]:
            if self_loop_latch(body, context, LLVMIntPredicate::UGT, PowerPositionLimits::SEARCH_LOOP_INSTRUCTIONS) is back:
                done: LLVMValueRef = LLVMGetCondition(back)
                exit: LLVMBasicBlockRef = LLVMGetSuccessor(back, 0)
                power: LLVMValueRef = LLVMGetOperand(done, 0)
                return null if exit == body or not is_llvm_instruction_with_opcode(power, LLVMOpcode::PHI) or LLVMGetInstructionParent(power) != body
                return null if not is_llvm_integer_type(LLVMTypeOf(power), 64) or LLVMCountIncoming(power) != 2
                return null if not is_inexact_division(LLVMGetOperand(done, 1), LLVMOpcode::LSHR, 1)
                if phi_incoming_for_block(power, body) is doubled:
                    return null if not is_doubling_in(doubled, body) or LLVMGetOperand(doubled, 0) != power
                    entry: LLVMBasicBlockRef = loop_entry_block(power, body)
                    return null if entry == exit or not is_unconditional_branch_to(LLVMGetBasicBlockTerminator(entry), body)
                    return null if not is_optional_constant_integer(phi_incoming_for_block(power, entry), 1)
                    return back if search_loop_is_closed(body, power, exit)
            null

        def fold_highest_power_of_two_loop(body: LLVMBasicBlockRef, module: LLVMModuleRef, builder: LLVMBuilderRef) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            if match_search_loop(body, LLVMGetModuleContext(module)) is back:
                done: LLVMValueRef = LLVMGetCondition(back)
                exit: LLVMBasicBlockRef = LLVMGetSuccessor(back, 0)
                power: LLVMValueRef = LLVMGetOperand(done, 0)
                entry: LLVMBasicBlockRef = loop_entry_block(power, body)
                if LLVMGetBasicBlockTerminator(entry) is enter:
                    position_builder_before(builder, enter)
                    input: LLVMValueRef = LLVMBuildFreeze(builder, LLVMGetOperand(LLVMGetOperand(done, 1), 0), "")
                    # The loop returns one for zero as well as one. Setting the
                    # low bit keeps every other highest set bit and makes ctlz
                    # defined.
                    i64_type: LLVMTypeRef = LLVMTypeOf(input)
                    nonzero: LLVMValueRef = LLVMBuildOr(builder, input, LLVMConstInt(i64_type, 1, 0), "")
                    zeros: LLVMValueRef = build_count_leading_zeros(builder, module, nonzero)
                    name_storage: mutable darray[u8] = []
                    top_bit: LLVMValueRef = LLVMConstInt(i64_type, 1.u64() << PowerPositionLimits::HIGHEST_BIT, 0)
                    highest: LLVMValueRef = LLVMBuildLShr(builder, top_bit, zeros, sview_to_cstr("highest.power.of.two", name_storage))
                    cursor: mutable LLVMValueRef? = LLVMGetFirstInstruction(exit)
                    while cursor is phi |cursor, body, power, highest, entry|:
                        break if not is_llvm_instruction_with_opcode(phi, LLVMOpcode::PHI)
                        edge: u32 = phi_incoming_index(phi, body).u32()
                        LLVMSetOperand(phi, edge, highest) if LLVMGetIncomingValue(phi, edge) == power
                        ElisaLLVMSetIncomingBlock(phi, edge, entry)
                        cursor <- LLVMGetNextInstruction(phi)
                    LLVMSetSuccessor(enter, 0, exit)
                    LLVMDeleteBasicBlock(body)
                    return true
            false

        # Step `exponent` of the unrolled search: `input < 2^(exponent + 1)`
        # as the block's first instruction, used once.
        def chain_step_test(current: LLVMBasicBlockRef, input: LLVMValueRef, exponent: u64) -> LLVMValueRef?:
            if LLVMGetFirstInstruction(current) is test:
                return null if not is_llvm_instruction_with_opcode(test, LLVMOpcode::ICMP) or LLVMGetICmpPredicate(test) != LLVMIntPredicate::ULT
                return null if LLVMGetOperand(test, 0) != input or not is_constant_integer(LLVMGetOperand(test, 1), 1.u64() << (exponent + 1))
                return test if has_one_use(test)
            null

        # The last step selects 61 or 62 and jumps to the join.
        def is_chain_last_step(current: LLVMBasicBlockRef, test: LLVMValueRef, selected: LLVMValueRef, join: LLVMBasicBlockRef) -> bool:
            return false if instruction_count(current) != PowerPositionLimits::CHAIN_LAST_INSTRUCTIONS
            return false if not is_llvm_instruction_with_opcode(selected, LLVMOpcode::SELECT) or LLVMGetInstructionParent(selected) != current
            return false if not has_one_use(selected) or LLVMGetOperand(selected, 0) != test
            return false if not is_unconditional_branch_to(LLVMGetBasicBlockTerminator(current), join)
            is_constant_integer(LLVMGetOperand(selected, 1), 61) and is_constant_integer(LLVMGetOperand(selected, 2), 62)

        # Every other step leaves for the join with its exponent when the
        # test holds and otherwise goes on to the next step.
        def chain_next_step(current: LLVMBasicBlockRef, test: LLVMValueRef, selected: LLVMValueRef, join: LLVMBasicBlockRef, exponent: u64, context: LLVMContextRef) -> LLVMBasicBlockRef? can[Abort.Panic, Memory.Allocate]:
            return null if instruction_count(current) != PowerPositionLimits::CHAIN_STEP_INSTRUCTIONS
            if conditional_terminator(current) is branch:
                return null if LLVMGetCondition(branch) != test or LLVMGetSuccessor(branch, 0) != join or has_loop_metadata(branch, context)
                return null if not is_constant_integer(selected, exponent)
                return LLVMGetSuccessor(branch, 1)
            null

        # The 61 steps after the entry, in order, when they form the search.
        def match_position_chain(entry: LLVMBasicBlockRef, first_step: LLVMBasicBlockRef, input: LLVMValueRef, position: LLVMValueRef, context: LLVMContextRef) -> darray[LLVMBasicBlockRef] can[Abort.Panic, Memory.Allocate]:
            join: LLVMBasicBlockRef = LLVMGetInstructionParent(position)
            chain: mutable darray[LLVMBasicBlockRef] = []
            previous: mutable LLVMBasicBlockRef = entry
            current: mutable LLVMBasicBlockRef = first_step
            for exponent in 1..<(PowerPositionLimits::CHAIN_EXPONENTS + 1) |chain, previous, current, join, input, position, context|:
                return [] if current == join or ElisaLLVMBlockHasAddressTaken(current) != 0
                return [] if not has_single_predecessor(current, previous)
                if chain_step_test(current, input, exponent) is test:
                    edge: i64 = phi_incoming_index(position, current)
                    return [] if edge < 0
                    selected: LLVMValueRef = LLVMGetIncomingValue(position, edge.u32())
                    chain.push(current)
                    if exponent == PowerPositionLimits::CHAIN_EXPONENTS:
                        return [] if not is_chain_last_step(current, test, selected, join)
                    else:
                        if chain_next_step(current, test, selected, join, exponent, context) is next_step:
                            previous <- current
                            current <- next_step
                        else:
                            return []
                else:
                    return []
            chain

        # The join of the unrolled search: a block whose only phi, first,
        # takes one of 61 exponents.
        def position_chain_join(first: LLVMValueRef, bypass: LLVMBasicBlockRef) -> LLVMValueRef?:
            join: LLVMBasicBlockRef = LLVMGetSuccessor(first, 0)
            return null if join == bypass
            if LLVMGetFirstInstruction(join) is position:
                return null if not is_llvm_instruction_with_opcode(position, LLVMOpcode::PHI)
                if LLVMGetNextInstruction(position) is after:
                    return null if is_llvm_instruction_with_opcode(after, LLVMOpcode::PHI)
                return null if not is_llvm_integer_type(LLVMTypeOf(position), 32) or LLVMCountIncoming(position) != PowerPositionLimits::CHAIN_EXPONENTS.u32()
                return position
            null

        def fold_power_position_chain(entry: LLVMBasicBlockRef, module: LLVMModuleRef, builder: LLVMBuilderRef) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            if conditional_terminator(entry) is enter:
                small: LLVMValueRef = LLVMGetCondition(enter)
                return false if not is_llvm_instruction_with_opcode(small, LLVMOpcode::ICMP) or LLVMGetICmpPredicate(small) != LLVMIntPredicate::SLT
                input: LLVMValueRef = LLVMGetOperand(small, 0)
                return false if not is_llvm_integer_type(LLVMTypeOf(input), 64) or not is_constant_integer(LLVMGetOperand(small, 1), 2)
                first_step: LLVMBasicBlockRef = LLVMGetSuccessor(enter, 1)
                if conditional_terminator(first_step) is first:
                    if position_chain_join(first, LLVMGetSuccessor(enter, 0)) is position:
                        context: LLVMContextRef = LLVMGetModuleContext(module)
                        chain: darray[LLVMBasicBlockRef] = match_position_chain(entry, first_step, input, position, context)
                        return false if chain.count == 0
                        rewrite_position_chain(enter, first, position, chain, module, builder)
                        return true
            false

        def rewrite_position_chain(enter: LLVMValueRef, first: LLVMValueRef, position: LLVMValueRef, chain: darray[LLVMBasicBlockRef], module: LLVMModuleRef, builder: LLVMBuilderRef) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            position_builder_before(builder, enter)
            stable: LLVMValueRef = LLVMBuildFreeze(builder, LLVMGetOperand(LLVMGetCondition(enter), 0), "")
            LLVMSetCondition(enter, LLVMBuildICmp(builder, LLVMIntPredicate::SLT, stable, LLVMConstInt(LLVMTypeOf(stable), 2, 0), ""))
            # Keep the first comparison, so inputs 2 and 3 keep the constant path.
            LLVMSetOperand(LLVMGetCondition(first), 0, stable)
            name_storage: mutable darray[u8] = []
            compute: LLVMBasicBlockRef = LLVMInsertBasicBlockInContext(LLVMGetModuleContext(module), LLVMGetInstructionParent(position), sview_to_cstr("power.position.compute", name_storage))
            LLVMPositionBuilderAtEnd(builder, compute)
            add_phi_incoming(position, build_power_position(builder, module, stable, LLVMTypeOf(position)), compute)
            LLVMBuildBr(builder, LLVMGetInstructionParent(position))
            LLVMSetSuccessor(first, 1, compute)
            dead: mutable darray[LLVMBasicBlockRef] = []
            for index in 1..<chain.count |dead, chain|:
                dead.push(chain[index])
            dead_slots: void& = (&dead[0]).cast[void&] can Unsafe.PointerCast
            ElisaLLVMDeleteDeadBlocks(dead_slots, dead.count.u32())

    public:
        def fold_power_positions(module: LLVMModuleRef) -> u32 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Unsafe.PointerArithmetic]:
            return 0 if not module_targets_aarch64(module)
            builder: LLVMBuilderRef = LLVMCreateBuilderInContext(LLVMGetModuleContext(module))
            changed: mutable u32 = 0
            function_cursor: mutable LLVMValueRef? = LLVMGetFirstFunction(module)
            while function_cursor is function |function_cursor, changed, builder, module|:
                if not skipped_by_loop_pass_policy(function, module) and function_block_count(function) <= PowerPositionLimits::MAX_FUNCTION_BLOCKS:
                    block_cursor: mutable LLVMBasicBlockRef? = LLVMGetFirstBasicBlock(function)
                    while block_cursor is block |block_cursor, changed, builder, module|:
                        folded: bool = fold_highest_power_of_two_loop(block, module, builder) or fold_power_position_loop(block, module, builder) or fold_power_position_chain(block, module, builder)
                        if folded:
                            changed <- changed + 1
                            break
                        block_cursor <- LLVMGetNextBasicBlock(block)
                function_cursor <- LLVMGetNextFunction(function)
            LLVMDisposeBuilder(builder)
            changed
