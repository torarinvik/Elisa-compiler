# Checked-accumulator recursion as loops: `return x op f(..., x, ...)`, with `op` an
# overflow-checked add, sub or mul that traps, becomes a descent loop that counts the
# calls and an ascent loop that replays the operations innermost-first; after the
# recursive-inline cleanup, the ascent's provable overflow checks are removed.
include "./accumulator_shapes.elisa"
include "./accumulator_rewrite.elisa"
include "./accumulator_proofs.elisa"

extend Backend:
    public:
        # `loopCheckedAccumulatorRecursion`: how many functions were rewritten.
        def loop_checked_accumulator_recursion(module: LLVMModuleRef) -> u32 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            changed: mutable u32 = 0
            cursor: mutable LLVMValueRef? = LLVMGetFirstFunction(module)
            while cursor is function |cursor, changed|:
                cursor <- LLVMGetNextFunction(function)
                if match_checked_accumulator(function) is shape:
                    rewrite_checked_accumulator(function, &shape)
                    changed <- changed + 1
            changed
