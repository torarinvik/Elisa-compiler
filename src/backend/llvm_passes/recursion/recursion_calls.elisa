# Calls, callees and copies of the private recursive functions the recursion passes
# rewrite: which function a call names, whether it may be duplicated or inlined, and
# snapshots whose self-calls go back to the original.

const module RecursionCallKind:
    CONVERGENT: sview = "convergent"
    NO_DUPLICATE: sview = "noduplicate"
    RETURNS_TWICE: sview = "returns_twice"

extend Backend:
    private:
        # `CallBase::getCalledFunction`: the callee when it is a function of the call's type.
        def direct_callee(call: LLVMValueRef) -> LLVMValueRef?:
            callee: LLVMValueRef = LLVMGetCalledValue(call)
            return null if LLVMIsAFunction(callee) == null
            return null if LLVMGlobalGetValueType(callee) != LLVMGetCalledFunctionType(call)
            callee

        # Whether CALL names FUNCTION directly.
        def calls_function(call: LLVMValueRef, function: LLVMValueRef) -> bool:
            if direct_callee(call) is callee:
                return callee == function
            false

        # `CallBase::setCalledFunction` for a function of the call's own type.
        def set_called_function(call: LLVMValueRef, function: LLVMValueRef) -> void:
            LLVMSetOperand(call, LLVMGetNumOperands(call) - 1, function)

        # `CallBase::hasFnAttr`: the call site or its callee has the attribute NAME.
        def call_has_attribute(call: LLVMValueRef, name: sview) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            ElisaLLVMCallHasFunctionAttribute(call, attribute_kind(name)) != 0

        def is_must_tail_call(call: LLVMValueRef) -> bool:
            LLVMGetTailCallKind(call) == LLVMTailCallKindValue::MUST_TAIL

        # Convergent, unduplicable, `returns_twice` or carrying operand bundles: a call
        # no clone or inlined copy may repeat.
        def call_resists_duplication(call: LLVMValueRef) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            return true if call_has_attribute(call, RecursionCallKind::CONVERGENT) or call_has_attribute(call, RecursionCallKind::NO_DUPLICATE)
            call_has_attribute(call, RecursionCallKind::RETURNS_TWICE) or LLVMGetNumOperandBundles(call) != 0

        # `Argument::getArgNo`.
        def argument_position(argument: LLVMValueRef) -> u32:
            function: LLVMValueRef = LLVMGetParamParent(argument)
            for position in 0..<LLVMCountParams(function) |function, argument|:
                return position if LLVMGetParam(function, position) == argument
            0

        # The function whose body holds INSTRUCTION.
        def enclosing_function(instruction: LLVMValueRef) -> LLVMValueRef:
            LLVMGetBasicBlockParent(LLVMGetInstructionParent(instruction))

        # The calls in FUNCTION that name TARGET, in program order.
        def calls_to(function: LLVMValueRef, target: LLVMValueRef) -> darray[LLVMValueRef] can[Abort.Panic, Memory.Allocate]:
            calls: mutable darray[LLVMValueRef] = []
            for instruction in function_instructions(function) |calls, target|:
                calls.push(instruction) if is_call_base(instruction) and calls_function(instruction, target)
            calls

        # Whether FUNCTION carries no attribute that rules out cloning or growing it:
        # local, defined, fixed-argument, without a personality, not size-optimized,
        # inlinable, not convergent and not sanitized. (Taking its address is checked
        # where it matters: specializing redirects every call.)
        def is_expandable_private_function(function: LLVMValueRef) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            return false if not has_local_linkage(function) or LLVMIsDeclaration(function) != 0 or LLVMIsFunctionVarArg(LLVMGlobalGetValueType(function)) != 0
            return false if LLVMHasPersonalityFn(function) != 0 or function_is_size_optimized(function) or function_is_sanitized(function)
            not function_has_attribute(function, "noinline") and not function_has_attribute(function, "convergent")

        # FUNCTION's name followed by SUFFIX, NUL-terminated.
        def suffixed_name(function: LLVMValueRef, suffix: sview) -> darray[u8] can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            length: mutable usize = 0
            bytes: u8& = LLVMGetValueName2(function, &length)
            name: sview = unsafe_sview_bounded_bytes(bytes, length)
            text: mutable darray[u8] = []
            for position in 0..<name.len |text, name|:
                text.push(name[position])
            for position in 0..<suffix.len |text, suffix|:
                text.push(suffix[position])
            text.push(0)
            text

        # `CloneFunction` of FUNCTION named with SUFFIX, its calls to ITSELF sent back to
        # FUNCTION: one more level of the recursion that then continues in the original.
        def recursion_snapshot(function: LLVMValueRef, suffix: sview) -> LLVMValueRef can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            snapshot: LLVMValueRef = ElisaLLVMCloneFunction(function)
            name: mutable darray[u8] = suffixed_name(function, suffix)
            LLVMSetValueName2(snapshot, (&name[0]).cast[cstr], name.count - 1)
            for call in calls_to(snapshot, snapshot) |function|:
                set_called_function(call, function)
            snapshot

        # Adds the string function attribute KEY with an empty value.
        def add_function_marker(function: LLVMValueRef, key: sview) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            key_storage: mutable darray[u8] = []
            value_storage: mutable darray[u8] = []
            context: LLVMContextRef = LLVMGetTypeContext(LLVMTypeOf(function))
            marker: LLVMAttributeRef = LLVMCreateStringAttribute(context, sview_to_cstr(key, key_storage), key.len.u32(), sview_to_cstr("", value_storage), 0)
            LLVMAddAttributeAtIndex(function, LLVMAttributeIndexValue::FUNCTION, marker)
