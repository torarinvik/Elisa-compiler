# The scratch-prefix sequence, run before O3 on modules without debug info. Its C++
# phase (src/backend/llvm_scratch_prefix.cpp) prepares covered, counted and stack prefix
# arrays; the last phase drops the memsets of byte scratch arrays whose every read
# follows a write (scratch_prefix_elision.elisa). Between them run passes that need
# loops still in source shape (a countdown scan the unroller later splits into a
# prologue and a stride -4 body is a guarded `n - 1` loop here): indexed prefix fills,
# validated reads, bisection checks and view fills.
include "./bisection_check_versioning.elisa"
include "./validated_reads.elisa"
include "./view_bounded_fills.elisa"
include "./scratch_prefix_elision.elisa"
include "../ir/loop_pass_policy.elisa"
include "../prefix_proofs/indexed_prefix_fills.elisa"

extern elisacoreScratchPrefixSupported() -> u32
extern elisacorePrepareScratchPrefixArrays(m: LLVMModuleRef) -> u32

extend Backend:
    public:
        # The whole sequence over MODULE; how many changes it made.
        def elide_scratch_prefix_initializers(module: LLVMModuleRef) -> u32 can[Abort.Panic, Memory.Allocate]:
            return 0 if elisacoreScratchPrefixSupported() == 0 or module_has_named_metadata(module, "llvm.dbg.cu")
            removed: mutable u32 = elisacorePrepareScratchPrefixArrays(module)
            removed <- removed + (remove_indexed_prefix_fills(module) can Unsafe.PointerCast)
            removed <- removed + (annotate_validated_reads(module) can Unsafe.PointerCast)
            removed <- removed + version_bisection_checks(module)
            removed <- removed + (shrink_view_fills(module) can Unsafe.PointerCast)
            removed + (elide_scratch_prefix_arrays(module) can Unsafe.PointerCast)
