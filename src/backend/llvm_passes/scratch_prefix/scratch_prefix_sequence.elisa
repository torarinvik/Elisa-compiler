# The scratch-prefix sequence, run before O3 on modules without debug info. On AArch64
# macOS and Linux it first drops the zero fills of double arrays that counted loops
# cover (covered_array_initializers.elisa); on AArch64 the fills of counted, linked and
# bucket prefix arrays go next (../counted_prefix/); then go the
# fills a later prefix fill covers (covered_prefix_zeros.elisa) and the zero fills of
# push/pop stacks (stack_prefix_zeros.elisa); the last phase drops the memsets of byte
# scratch arrays whose every read follows a write (scratch_prefix_elision.elisa).
# Between them run passes that need loops still in source shape (a countdown scan the
# unroller later splits into a prologue and a stride -4 body is a guarded `n - 1` loop
# here): indexed prefix fills, validated reads, bisection checks and view fills.
include "./bisection_check_versioning.elisa"
include "./validated_reads.elisa"
include "./view_bounded_fills.elisa"
include "./scratch_prefix_elision.elisa"
include "./covered_array_initializers.elisa"
include "./covered_prefix_zeros.elisa"
include "../ir/loop_pass_policy.elisa"
include "../prefix_proofs/indexed_prefix_fills.elisa"
include "../counted_prefix/counted_prefix_initializers.elisa"

extend Backend:
    public:
        # The whole sequence over MODULE; how many changes it made.
        def elide_scratch_prefix_initializers(module: LLVMModuleRef) -> u32 can[Abort.Panic, Memory.Allocate]:
            return 0 if module_has_named_metadata(module, "llvm.dbg.cu")
            removed: mutable u32 = (prepare_covered_array_initializers(module) can Unsafe.PointerCast)
            removed <- removed + (remove_counted_prefix_initializers(module) can Unsafe.PointerCast)
            removed <- removed + (prepare_covered_prefix_zeros(module) can Unsafe.PointerCast)
            if (ElisaLLVMModuleTargetIsMacOSX(module) != 0 or ElisaLLVMModuleTargetIsLinux(module) != 0) and module_targets_aarch64_architecture(module):
                removed <- removed + (remove_stack_prefix_zeros(module) can Unsafe.PointerCast)
            removed <- removed + (remove_indexed_prefix_fills(module) can Unsafe.PointerCast)
            removed <- removed + (annotate_validated_reads(module) can Unsafe.PointerCast)
            removed <- removed + version_bisection_checks(module)
            removed <- removed + (shrink_view_fills(module) can Unsafe.PointerCast)
            removed + (elide_scratch_prefix_arrays(module) can Unsafe.PointerCast)
