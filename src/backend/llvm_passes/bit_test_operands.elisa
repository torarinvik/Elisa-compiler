# Put the shifted one first in single-bit tests `(X & (1 << Y)) ==/!= 0`.
# AArch64 instruction selection turns `((1 << Y) & X) != 0` into a shift of
# X and a `tbz`/`tbnz` on bit 0, but only in that operand order: with X
# first it materializes the mask and compares, which the conditional-compare
# pass then merges with neighbouring tests into a longer `ccmp` chain. The
# `and` is commutative, so the swap is free; it runs after the optimization
# pipeline, which would otherwise reorder the operands again.
include "./ir/llvm_ir_queries.elisa"
include "../llvm_c_api/analysis/elisa_llvm_analysis.elisa"

extend Backend:
    private:
        # `1 << Y`, the one possibly a vector splat.
        def is_shifted_one(value: LLVMValueRef) -> bool:
            is_llvm_instruction_with_opcode(value, LLVMOpcode::SHL) and ElisaLLVMIsConstantOne(LLVMGetOperand(value, 0)) != 0

        # The value has users, and every one compares it with zero for equality.
        def only_tested_against_zero(mask: LLVMValueRef) -> bool:
            first_use: LLVMUseRef? = LLVMGetFirstUse(mask)
            return false if first_use == null
            use_cursor: mutable LLVMUseRef? = first_use
            while use_cursor is use |use_cursor|:
                user: LLVMValueRef = LLVMGetUser(use)
                return false if not is_llvm_instruction_with_opcode(user, LLVMOpcode::ICMP)
                predicate: i32 = LLVMGetICmpPredicate(user)
                return false if predicate != LLVMIntPredicate::EQ and predicate != LLVMIntPredicate::NE
                return false if ElisaLLVMIsConstantZero(LLVMGetOperand(user, 1)) == 0
                use_cursor <- LLVMGetNextUse(use)
            true

        def is_reorderable_bit_test(instruction: LLVMValueRef) -> bool:
            return false if LLVMGetInstructionOpcode(instruction) != LLVMOpcode::AND
            return false if is_shifted_one(LLVMGetOperand(instruction, 0))
            is_shifted_one(LLVMGetOperand(instruction, 1)) and only_tested_against_zero(instruction)

        def order_block_bit_tests(block: LLVMBasicBlockRef) -> u32:
            changed: mutable u32 = 0
            instruction_cursor: mutable LLVMValueRef? = LLVMGetFirstInstruction(block)
            while instruction_cursor is instruction |instruction_cursor, changed|:
                if is_reorderable_bit_test(instruction):
                    variable_operand: LLVMValueRef = LLVMGetOperand(instruction, 0)
                    LLVMSetOperand(instruction, 0, LLVMGetOperand(instruction, 1))
                    LLVMSetOperand(instruction, 1, variable_operand)
                    changed <- changed + 1
                instruction_cursor <- LLVMGetNextInstruction(instruction)
            changed

    public:
        def order_bit_test_operands(module: LLVMModuleRef) -> u32:
            changed: mutable u32 = 0
            function_cursor: mutable LLVMValueRef? = LLVMGetFirstFunction(module)
            while function_cursor is function |function_cursor, changed|:
                block_cursor: mutable LLVMBasicBlockRef? = LLVMGetFirstBasicBlock(function)
                while block_cursor is block |block_cursor, changed|:
                    changed <- changed + order_block_bit_tests(block)
                    block_cursor <- LLVMGetNextBasicBlock(block)
                function_cursor <- LLVMGetNextFunction(function)
            changed
