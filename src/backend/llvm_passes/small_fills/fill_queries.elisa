# Queries over memory-fill intrinsic calls (`llvm.memset`, `llvm.memset.inline` and
# `llvm.experimental.memset.pattern`), whose operands are destination, value, length and
# the volatile flag.
include "../ir/ir_editing.elisa"

# The intrinsics LLVM's MemSetInst covers.
struct MemsetIntrinsics:
    memset: u32
    memset_inline: u32

# A pointer as a base plus a constant byte offset.
struct PointerBase:
    base: LLVMValueRef
    offset: i64

extend Backend:
    public:
        # `GetPointerBaseWithConstantOffset` under the module's data layout.
        def pointer_base(pointer: LLVMValueRef, module: LLVMModuleRef) -> PointerBase can[Unsafe.PointerCast]:
            offset: mutable i64 = 0
            base: LLVMValueRef = ElisaLLVMPointerBaseWithConstantOffset(pointer, module, (&offset).cast[void&])
            PointerBase{base: base, offset: offset}

        def memset_intrinsics() -> MemsetIntrinsics can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            memset_storage: mutable darray[u8] = []
            inline_storage: mutable darray[u8] = []
            memset: u32 = LLVMLookupIntrinsicID(sview_to_cstr("llvm.memset", memset_storage), 11)
            memset_inline: u32 = LLVMLookupIntrinsicID(sview_to_cstr("llvm.memset.inline", inline_storage), 18)
            MemsetIntrinsics{memset: memset, memset_inline: memset_inline}

        # `isa<MemSetInst>`: a call of `llvm.memset` or `llvm.memset.inline`.
        def is_memset(instruction: LLVMValueRef, intrinsics: MemsetIntrinsics&) -> bool:
            intrinsic: u32 = called_intrinsic_id(instruction)
            intrinsic != 0 and (intrinsic == intrinsics.memset or intrinsic == intrinsics.memset_inline)

        def call_is_volatile(fill: LLVMValueRef) -> bool:
            ElisaLLVMConstantIntEquals(LLVMGetOperand(fill, 3), 0) == 0

        # The enum attribute kind NAME spells.
        def attribute_kind(name: sview) -> u32 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            name_storage: mutable darray[u8] = []
            LLVMGetEnumAttributeKindForName(sview_to_cstr(name, name_storage), name.len.usize())

        # `getDestAlign().valueOrOne()`: the call site's alignment of its destination.
        def destination_alignment(fill: LLVMValueRef, align_kind: u32) -> u64:
            if LLVMGetCallSiteEnumAttribute(fill, 1, align_kind) is alignment:
                return LLVMGetEnumAttributeValue(alignment)
            1

        def destination_address_space(fill: LLVMValueRef) -> u32:
            LLVMGetPointerAddressSpace(LLVMTypeOf(LLVMGetOperand(fill, 0)))
