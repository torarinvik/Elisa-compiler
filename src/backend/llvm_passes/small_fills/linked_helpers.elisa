# Helper functions written in textual IR, linked into a module and inlined at each site a
# pass expands: the fill expansions keep their code shape in one readable routine.
include "../ir/ir_editing.elisa"

extend Backend:
    private:
        # The module whose IR is HELPER_LINES, one line each, or null when it does not parse.
        def parse_helper_module(context: LLVMContextRef, helper_lines: darray[sview]&) -> LLVMModuleRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            text: mutable darray[u8] = []
            for line in helper_lines |text|:
                for index in 0..<line.len |text, line|:
                    text.push(line[index])
                text.push(10)
            length: usize = text.count
            text.push(0)
            name_storage: mutable darray[u8] = []
            buffer: LLVMMemoryBufferRef = LLVMCreateMemoryBufferWithMemoryRangeCopy(&text[0], length, sview_to_cstr("elisa-helper", name_storage))
            module_storage: mutable void&? = null
            message_storage: mutable void&? = null
            message_slot: u8&& = (&message_storage).cast[u8&&]
            # LLVMParseIRInContext takes ownership of the buffer.
            status: i32 = LLVMParseIRInContext(context, buffer, (&module_storage).cast[void&], (&message_storage).cast[void&])
            if message_storage is present:
                LLVMDisposeMessage(message_slot[0].cast[cstr])
            raw_module: void& = get module_storage else return null
            module: LLVMModuleRef = raw_module.cast[LLVMModuleRef]
            if status != 0:
                LLVMDisposeModule(module)
                return null
            module

    public:
        # Links the function NAME that HELPER_LINES define into MODULE as an internal
        # function. The IR is parsed with value names kept, as the assembly parser resolves
        # local operands by name, and takes the module's data layout and triple. Null when
        # the IR does not parse, linking fails or the function is missing.
        def link_internal_helper(module: LLVMModuleRef, helper_lines: darray[sview]&, name: sview) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            context: LLVMContextRef = LLVMGetModuleContext(module)
            discard_names: i32 = LLVMContextShouldDiscardValueNames(context)
            LLVMContextSetDiscardValueNames(context, 0)
            parsed: LLVMModuleRef? = parse_helper_module(context, helper_lines)
            LLVMContextSetDiscardValueNames(context, discard_names)
            helper: LLVMModuleRef = get parsed else return null
            LLVMSetDataLayout(helper, LLVMGetDataLayoutStr(module))
            if LLVMGetTarget(module) is triple:
                LLVMSetTarget(helper, triple.cast[cstr])
            # LLVMLinkModules2 consumes the helper module whether or not it links.
            return null if LLVMLinkModules2(module, helper) != 0
            name_storage: mutable darray[u8] = []
            routine: LLVMValueRef = get LLVMGetNamedFunction(module, sview_to_cstr(name, name_storage)) else return null
            LLVMSetLinkage(routine, LLVMLinkageValue::INTERNAL)
            routine

        # Replaces SITE by an inlined call of ROUTINE with ARGUMENTS, built before SITE
        # with its debug location. False, leaving SITE, when the call does not inline.
        def inline_helper_at(site: LLVMValueRef, routine: LLVMValueRef, arguments: darray[LLVMValueRef]&, builder: LLVMBuilderRef) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            position_builder_before(builder, site)
            argument_slots: void& = (&arguments[0]).cast[void&]
            name_storage: mutable darray[u8] = []
            call: LLVMValueRef = LLVMBuildCall2(builder, LLVMGlobalGetValueType(routine), routine, argument_slots, arguments.count.u32(), sview_to_cstr("", name_storage))
            LLVMInstructionSetDebugLoc(call, LLVMInstructionGetDebugLoc(site))
            if ElisaLLVMInlineCall(call) != 0:
                LLVMInstructionEraseFromParent(site)
                return true
            LLVMInstructionEraseFromParent(call)
            false

        # Deletes ROUTINE once no inlined site uses it.
        def delete_unused_helper(routine: LLVMValueRef) -> void:
            LLVMDeleteFunction(routine) if LLVMGetFirstUse(routine) == null
