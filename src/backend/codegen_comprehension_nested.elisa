# Stage1 backend — NESTED COMPREHENSIONS: `[x + y for x in xs for y in ys]`, with an optional
# filter after any clause (`[x + y for x in xs if x > 0 for y in ys if y != x]`), and the dict
# and set twins (`{x: y for x in xs for y in ys}`). Part of `module Backend`.
#
# The parser keeps every clause after the first in the BODY, as a spread of the inner
# comprehension: `[...[x + y for y in ys] for x in xs]` — "append every element of the inner
# list" — which is also exactly its meaning. The lowering is the statement loop a reader
# would write by hand, built as AST and emitted through the ordinary statement emitter:
#
#     __comp_out = zeroed            # the empty darray/dict/set, typed by `expected`
#     for x in xs:
#         if x > 0:
#             for y in ys:
#                 if y != x:
#                     __comp_out.push(x + y)          # .put(k, v) / .add(v)
#     __comp_out
#
# so every iterable the `for` statement takes (ranges, darrays, views, strings, dicts) works
# in any clause, and the machine code is the hand-written loop's. No reserve: the total count
# is a sum over the outer clause, which is not known before the loops run.

extend Backend:
    private:


        # The inner comprehension of a nested clause — the body `...[BODY for y in ys]` —
        # or Absent when `body` is an ordinary element expression.
        def nested_comprehension_inner(body: Expr) -> Expr:
            match body:
                Expr.Unary(spread_operator, spread_inner, _):
                    if spread_operator == TokenKind.Ellipsis:
                        match spread_inner:
                            Expr.Comprehension(_, _, _, _, _):
                                return spread_inner
                            _:
                                pass
                _:
                    pass
            return (Expr.Absent)



        # The statement loop for one clause `for VAR in ITERABLE (if CONDITION)?` whose body is
        # either the next clause or, innermost, the call that stores BODY into `sink`.
        # `method` is "push" (darray), "put" (dict: BODY is the `(key, value)` pair) or "add"
        # (set). Null when a dict element is not a key/value pair.
        def nested_comprehension_loop(comprehension_var: sview, iterable: Expr, condition: Expr, body: Expr, sink: sview, method: sview, pos: Ast::Pos) -> Stmt? can[Abort.Panic, Memory.Allocate]:
            inner_statement: mutable Stmt = Stmt.Invalid
            inner: Expr = nested_comprehension_inner(body)
            match inner:
                Expr.Comprehension(inner_var, inner_iterable, inner_condition, inner_body, inner_pos):
                    if nested_comprehension_loop(inner_var, inner_iterable, inner_condition, inner_body, sink, method, inner_pos) is inner_loop:
                        inner_statement <- inner_loop
                    else:
                        return null
                _:
                    store_arguments: mutable darray[Expr] = [body]
                    if method == "put":
                        match body:
                            Expr.Tuple(pair, _):
                                null return if pair.count != 2
                                store_arguments <- [pair[0], pair[1]]
                            _:
                                return null
                    argument_names: mutable darray[sview] = []
                    for _ in store_arguments |argument_names|:
                        argument_names.push("")
                    store_call: Expr = Expr.Call((Expr.Field((Expr.Ident(sink, pos)), method, pos)), store_arguments, argument_names, pos)
                    inner_statement <- (Stmt.Expr(store_call, pos))
            loop_body: mutable darray[Stmt] = [inner_statement]
            match condition:
                Expr.Absent:
                    pass
                _:
                    loop_body <- [(Stmt.If(condition, [inner_statement], [], pos))]
            return (Stmt.For("", [comprehension_var], iterable, loop_body, pos))



        # `[BODY for VAR in ITERABLE (if CONDITION)? for …]` into `expected` (a darray, or the
        # DynDict/DynSet struct of a dict/set comprehension): the loop above, emitted as a value
        # block whose tail is the filled container.
        def emit_nested_comprehension(comprehension_var: sview, iterable: Expr, condition: Expr, body: Expr, comprehension_line: u32, expected: ValueType, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            method: mutable sview = ""
            if expected.kind == TypeKind.DArray:
                method <- "push"
            elif expected.kind == TypeKind.Struct:
                nc_base: mutable sview = ""
                nc_arg_start: mutable usize = 0
                nc_arg_count: mutable usize = 0
                if generic_struct_instantiation_of(structs, expected, nc_base, nc_arg_start, nc_arg_count):
                    method <- "put" if nc_base == "DynDict"
                    method <- "add" if nc_base == "DynSet"
            null return if method == ""
            pos: Ast::Pos = Ast::pos_at_line(comprehension_line)
            sink: sview = "__comprehension_out"
            if nested_comprehension_loop(comprehension_var, iterable, condition, body, sink, method, pos) is outer_loop:
                block_statements: darray[Stmt] = [(Stmt.VarDecl(sink, Expr.Invalid, (Expr.Ident("zeroed", pos)), pos)), outer_loop]
                block_expected: mutable ValueType = copied_type(expected)
                return emit_scoped_value_block(block_statements, (Expr.Ident(sink, pos)), block_expected, local_scope, fns, structs, generics, runtime, m, ctx, builder) can Global{Read,Write}
            return null
