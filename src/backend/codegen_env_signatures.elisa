extend Backend:
    private:
            # The type an annotation denotes. Only a bare scalar name is modeled.
            #
            # `mutable` is a QUALIFIER on the annotation, not part of the type: `x: mutable
            # i64` denotes i64 and just says the binding can be reassigned. It rides as a
            # Unary node wrapping the type, so it is unwrapped here — mutability is the
            # frontend's business (it already rejects `x <- 1` on an immutable local), and the
            # backend only needs the underlying type.
            # Record every `fn(…)->R` type's RETURN-type head (parser side-table __lambda_return,
            # keyed by the fn token offset) so a Fn ValueType can carry its result type.
        def register_fn_signatures(file: Ast::File&, structs: mutable StructTable&) -> void can[Abort.Panic, Memory.Allocate]:
            for annotation in file.enum_annotations |structs|:
                if annotation.owner == "__try_propagating_expr":
                    structs.annotations.propagating_try_call_offsets.push(annotation.offset)
                if annotation.owner == "__lambda_return":
                    structs.function_types.fn_return_lines.push(annotation.line)
                    structs.function_types.fn_return_heads.push(annotation.name)
                    structs.function_types.fn_return_offsets.push(annotation.offset)
                if annotation.owner == "__lambda_param":
                    structs.function_types.fn_param_lines.push(annotation.line)
                    structs.function_types.fn_param_offsets.push(annotation.offset)
                    structs.function_types.fn_param_heads.push(annotation.name)
                # The QUERY keyword (`count`/`sum`/`any`/…), keyed by the query scope ID in
                # comprehension lookups. Prefixed so it cannot be confused with a fn-type
                # return head sharing the same token location.
                # The BODY slot of a leading-keyword query holds the GUARD of a
                # `where PATTERN: GUARD` filter, not a projection. Key it to the head token so
                # the collection emitter does not push the guard as the collected ELEMENT.
                structs.queries.query_guard_scope_ids <- structs.queries.query_guard_scope_ids.push(query_scope_id_for_annotation(annotation.offset, structs)) if annotation.owner == "__query_guard"
                # A PROJECTION query whose guard the parser could not represent. Recorded so
                # the emitter declines rather than silently ignoring the guard.
                structs.queries.query_dropped_guard_scope_ids <- structs.queries.query_dropped_guard_scope_ids.push(query_scope_id_for_annotation(annotation.offset, structs)) if annotation.owner == "__query_guard_dropped"
                if annotation.name == "__region_use":
                    structs.annotations.region_use_lines <- structs.annotations.region_use_lines.push(annotation.line)
                    structs.annotations.region_use_offsets <- structs.annotations.region_use_offsets.push(annotation.offset)
                    structs.annotations.region_use_names <- structs.annotations.region_use_names.push(annotation.owner)
                if annotation.owner == "__contract_quantifier":
                    structs.queries.query_lines.push(annotation.line)
                    structs.queries.query_scope_ids.push(query_scope_id_for_annotation(annotation.offset, structs))
                    structs.queries.query_heads.push(annotation.name)
                    structs.queries.query_binders.push("")
                if annotation.owner == "__query":
                    structs.function_types.fn_return_lines.push(annotation.line)
                    structs.function_types.fn_return_heads.push(annotation.name)
                    structs.function_types.fn_return_offsets.push(annotation.offset)
                    # Also into the binder-keyed pools. The line-keyed row above stays for the
                    # consumers that have no binder to offer.
                    structs.queries.query_lines.push(annotation.line)
                    structs.queries.query_scope_ids.push(query_scope_id_for_annotation(annotation.offset, structs))
                    structs.queries.query_heads.push(annotation.name)
                if annotation.owner == "__query_binder_of":
                    structs.queries.query_binders.push(annotation.name)
                if annotation.owner == "__submit":
                    # Keep the line-keyed return head for older expression-type queries and
                    # separately retain the unique token offset for submit lowering.
                    structs.function_types.fn_return_lines.push(annotation.line)
                    structs.function_types.fn_return_heads.push("__submit")
                    structs.function_types.fn_return_offsets.push(annotation.offset)
                    if structs.annotations.submit_offsets.count > 0.usize():
                        previous_submit_offset: usize = structs.annotations.submit_offsets.count - 1.usize()
                        structs.annotations.submit_offsets_sorted <- false if structs.annotations.submit_offsets[previous_submit_offset] > annotation.offset
                    structs.annotations.submit_offsets.push(annotation.offset)
                if annotation.owner == "__await":
                    structs.function_types.fn_return_lines.push(annotation.line)
                    structs.function_types.fn_return_heads.push("__await")
                    structs.function_types.fn_return_offsets.push(annotation.offset)
                if annotation.owner == "__wait_all":
                    structs.function_types.fn_return_lines.push(annotation.line)
                    structs.function_types.fn_return_heads.push("__wait_all")
                    structs.function_types.fn_return_offsets.push(annotation.offset)
                if annotation.owner == "__clone_error_union":
                    structs.errors.clone_error_lines.push(annotation.line)
                    structs.errors.clone_error_families.push(annotation.name)
                if annotation.owner == "__local_error_union":
                    structs.errors.local_error_lines.push(annotation.line)
                    structs.errors.local_error_offsets.push(annotation.offset)
                    structs.errors.local_error_families.push(annotation.name)
                if annotation.owner == "__field_error_union":
                    structs.errors.field_error_lines.push(annotation.line)
                    structs.errors.field_error_families.push(annotation.name)
                if annotation.owner == "__param_error_union":
                    structs.errors.param_error_lines.push(annotation.line)
                    structs.errors.param_error_offsets.push(annotation.offset)
                    structs.errors.param_error_families.push(annotation.name)
                if annotation.owner == "__fn_error_union":
                    structs.function_types.fn_error_lines.push(annotation.line)
                    structs.function_types.fn_error_offsets.push(annotation.offset)
                    structs.function_types.fn_error_occurrence_offsets.push(annotation.occurrence_offset)
                    structs.function_types.fn_error_families.push(annotation.name)
                if annotation.owner == "__tuple_label":
                    structs.records.tuple_label_lines.push(annotation.line)
                    structs.records.tuple_label_names.push(annotation.name)
                # Guest-overlay field offsets: `__overlay_field` carries the byte offset in
                # `line`; width is filled after struct bodies are registered (see
                # finalize_overlay_field_widths). Layout association uses `__overlay_struct`
                # markers in source order for fields declared under that layout.
                if annotation.owner == "__overlay_field":
                    structs.storage_layouts.overlay_field_names.push(annotation.name)
                    structs.storage_layouts.overlay_field_offsets.push(annotation.line)
                    structs.storage_layouts.overlay_field_widths.push(0)
                    structs.storage_layouts.overlay_field_layouts.push(sview("", 0, 0))
            # Associate overlay fields with their layout struct: the parser emits
            # `__overlay_struct` for the layout, then field annotations for its members.
            # Walk annotations in order and bind each field to the most recent overlay struct.
            current_overlay: mutable sview = sview("", 0, 0)
            field_cursor: mutable usize = 0
            for annotation in file.enum_annotations |structs, current_overlay, field_cursor|:
                if annotation.owner == "__overlay_struct":
                    current_overlay <- annotation.name
                elif annotation.owner == "__overlay_field" and field_cursor < structs.storage_layouts.overlay_field_names.count:
                    structs.storage_layouts.overlay_field_layouts[field_cursor] <- current_overlay
                    field_cursor <- field_cursor + 1
            structs.function_types.fn_type_param_lines <- file.fn_type_param_lines
            structs.function_types.fn_type_param_offsets <- file.fn_type_param_offsets
            structs.function_types.fn_type_return_lines <- file.fn_type_return_lines
            structs.function_types.fn_type_return_offsets <- file.fn_type_return_offsets
            structs.function_types.fn_type_return_exprs <- file.fn_type_return_exprs
            structs.function_types.fn_type_param_exprs <- file.fn_type_param_exprs



        # Whether the query at `scope_id` carries a guard the AST cannot represent (the projection
        # form). Its filter would silently run without the guard, so callers must decline.
        def query_guard_dropped_at(scope_id: u32, structs: mutable StructTable&) -> bool can[Abort.Panic]:
            for probe in 0..<structs.queries.query_dropped_guard_scope_ids.count |scope_id, structs|:
                return true if structs.queries.query_dropped_guard_scope_ids[probe] == scope_id
            return false

        # Whether the leading query at `scope_id` stores a pattern guard in its body slot.
        def query_has_guard_at(scope_id: u32, structs: mutable StructTable&) -> bool can[Abort.Panic]:
            for probe in 0..<structs.queries.query_guard_scope_ids.count |scope_id, structs|:
                return true if structs.queries.query_guard_scope_ids[probe] == scope_id
            return false




        # The `new[NAME]` allocation-target selector recorded at the exact constructor position.
        def region_use_name_at(line: u32, offset: u32, structs: mutable StructTable&) -> sview can[Abort.Panic]:
            return "" if structs.annotations.region_use_lines.count != structs.annotations.region_use_offsets.count or structs.annotations.region_use_lines.count != structs.annotations.region_use_names.count
            for probe in 0..<structs.annotations.region_use_lines.count |line, offset, structs|:
                return structs.annotations.region_use_names[probe] if structs.annotations.region_use_lines[probe] == line and structs.annotations.region_use_offsets[probe] == offset
            return ""




        # A query's head keyword at its parse-local scope ID, disambiguated by its BINDER.
        def query_head_for[@r](scope_id: u32, binder: sview, structs: mutable StructTable& @r) -> sview @r can[Abort.Panic]:
            can Abort.Panic:
                return "" if not query_scope_metadata_valid(structs)
                paired: usize = structs.queries.query_scope_ids.count
                found: mutable sview = ""
                have: mutable bool = false
                ambiguous: mutable bool = false
                for probe in 0..<paired |found, have, ambiguous, scope_id, binder, structs|:
                    continue if structs.queries.query_scope_ids[probe] != scope_id or structs.queries.query_binders[probe] != binder
                    ambiguous <- true if have and structs.queries.query_heads[probe] != found
                    found <- structs.queries.query_heads[probe] if not have
                    have <- true
                # A malformed duplicate annotation at this offset is ambiguous; let every caller
                # decline rather than guessing a query head.
                return "" if ambiguous
                return found if have
                return ""

include "./codegen_env_source_queries.elisa"
