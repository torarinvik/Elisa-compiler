# Stage1 backend — the ALIAS-SCOPE metadata stamped on darray header and element accesses, so
# LLVM can move loads across a store the disjointness proof has ruled out.
# Part of `module Backend` (see codegen.elisa).

extend Backend:
    private:


        def set_metadata_list(inst: LLVMValueRef, kind_name: cstr, kind_length: u32, metadata: darray[LLVMMetadataRef], ctx: LLVMContextRef) -> void can[Abort.Panic, Unsafe.PointerCast]:
            return if inst == zeroed or metadata.count == 0
            pointer: void& = (&metadata[0]).cast[void&] can Unsafe.PointerCast
            node: LLVMMetadataRef = LLVMMDNodeInContext2(ctx, pointer, metadata.count)
            LLVMSetMetadata(inst, LLVMGetMDKindIDInContext(ctx, kind_name, kind_length), LLVMMetadataAsValue(ctx, node))




        # Build an identity-bearing metadata node. Metadata values made only from strings
        # are uniqued by LLVM; the self-reference keeps per-function alias scopes distinct
        # even when two functions use the same parameter position.
        def distinct_metadata_node(ctx: LLVMContextRef, remaining_operands: darray[LLVMMetadataRef]) -> LLVMMetadataRef can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            temporary: LLVMMetadataRef = LLVMTemporaryMDNode(ctx, null, 0)
            operands: mutable darray[LLVMMetadataRef] = [temporary]
            for operand in remaining_operands |operands|:
                operands.push(operand)
            pointer: void& = (&operands[0]).cast[void&] can Unsafe.PointerCast
            result: LLVMMetadataRef = LLVMMDNodeInContext2(ctx, pointer, operands.count)
            LLVMMetadataReplaceAllUsesWith(temporary, result)
            LLVMDisposeTemporaryMDNode(temporary)
            return result




        # Scope declaration intrinsics give LLVM a dynamic identity for each function
        # activation. The inliner clones declared scopes when it duplicates a call site,
        # preserving the proof without allowing two inlined activations to share a scope.
        def build_disjoint_scopes(module: LLVMModuleRef, param_indices: darray[u32], ctx: LLVMContextRef, builder: LLVMBuilderRef) -> darray[LLVMMetadataRef] can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            return [] if param_indices.count < 2
            domain_label: LLVMMetadataRef = LLVMMDStringInContext2(ctx, "elisa.disjoint.params", 21)
            # LLVM's alias-scope domain tuple is {name, i1 scopesAreDisjoint, description?}.
            # These scopes are disjoint only through the explicit reciprocal !noalias
            # attachments below, so leave the domain-wide flag false.
            domain_scopes_disjoint: LLVMMetadataRef = LLVMValueAsMetadata(LLVMConstInt(LLVMInt1TypeInContext(ctx), 0, 0))
            domain_operands: mutable darray[LLVMMetadataRef] = [domain_scopes_disjoint, domain_label]
            domain_pointer: void& = (&domain_operands[0]).cast[void&] can Unsafe.PointerCast
            domain: LLVMMetadataRef = LLVMMDNodeInContext2(ctx, domain_pointer, domain_operands.count)
            intrinsic_name: sview = "llvm.experimental.noalias.scope.decl"
            intrinsic_name_storage: mutable darray[u8] = []
            intrinsic_id: u32 = LLVMLookupIntrinsicID(sview_to_cstr(intrinsic_name, intrinsic_name_storage), intrinsic_name.len)
            intrinsic: LLVMValueRef = LLVMGetIntrinsicDeclaration(module, intrinsic_id, null, 0)
            intrinsic_type: LLVMTypeRef = LLVMGlobalGetValueType(intrinsic)
            scope_refs: mutable darray[LLVMMetadataRef] = []
            for param_index in param_indices |scope_refs, ctx, builder, intrinsic, intrinsic_type, domain|:
                scope_label: sview = disjoint_scope_name(param_index)
                scope_label_storage: mutable darray[u8] = []
                scope_name: LLVMMetadataRef = LLVMMDStringInContext2(ctx, sview_to_cstr(scope_label, scope_label_storage), scope_label.len)
                scope_operands: mutable darray[LLVMMetadataRef] = [domain, scope_name]
                scope_node: LLVMMetadataRef = distinct_metadata_node(ctx, scope_operands)
                scope_list_values: mutable darray[LLVMMetadataRef] = [scope_node]
                scope_list_pointer: void& = (&scope_list_values[0]).cast[void&] can Unsafe.PointerCast
                scope_list: LLVMMetadataRef = LLVMMDNodeInContext2(ctx, scope_list_pointer, 1)
                scope_refs.push(scope_node)
                declaration_arguments: mutable darray[LLVMValueRef] = [LLVMMetadataAsValue(ctx, scope_list)]
                declaration_arguments_pointer: void& = (&declaration_arguments[0]).cast[void&] can Unsafe.PointerCast
                _ = LLVMBuildCall2(builder, intrinsic_type, intrinsic, declaration_arguments_pointer, 1, "")
            return scope_refs




        # Combine the shared darray header/element domain with the per-function
        # disjoint-parameter domain. LLVM permits only one attachment per metadata kind,
        # so setting either domain separately would silently discard the other.
        def tag_disjoint_darray_access(inst: LLVMValueRef, pointer: LLVMValueRef, runtime: Runtime&, ctx: LLVMContextRef) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            return if inst == zeroed or runtime.disjoint_scope_refs.count < 2
            parameter_index: i64 = disjoint_element_index_for_pointer(pointer, runtime)
            return if parameter_index < 0
            own_scope_slot: mutable i64 = -1
            for slot in 0..<runtime.disjoint_param_indices.count |parameter_index, own_scope_slot, runtime|:
                own_scope_slot <- slot.i64() if runtime.disjoint_param_indices[slot] == parameter_index.u32()
            return if own_scope_slot < 0 or own_scope_slot.usize() >= runtime.disjoint_scope_refs.count
            alias_metadata: mutable darray[LLVMMetadataRef] = [runtime.disjoint_scope_refs[own_scope_slot.usize()]]
            noalias_metadata: mutable darray[LLVMMetadataRef] = []
            for scope_slot in 0..<runtime.disjoint_scope_refs.count |scope_slot, own_scope_slot, noalias_metadata, runtime|:
                noalias_metadata.push(runtime.disjoint_scope_refs[scope_slot]) if scope_slot != own_scope_slot.usize()
            set_metadata_list(inst, "alias.scope", 11, alias_metadata, ctx)
            set_metadata_list(inst, "noalias", 7, noalias_metadata, ctx)




        def tag_darray_header_access(inst: LLVMValueRef, ctx: LLVMContextRef) -> void can[Abort.Panic, Unsafe.PointerCast]:
            return if inst == zeroed
            one: usize = 1
            two: usize = 2
            three: usize = 3
            domain_string: LLVMMetadataRef = LLVMMDStringInContext2(ctx, "elisa.darray.aa", 15.usize())
            domain_ops: mutable darray[LLVMMetadataRef] = [domain_string]
            domain_pointer: void& = (&domain_ops[0]).cast[void&] can Unsafe.PointerCast
            domain: LLVMMetadataRef = LLVMMDNodeInContext2(ctx, domain_pointer, one)
            own_string: LLVMMetadataRef = LLVMMDStringInContext2(ctx, "hdr", three)
            own_ops: mutable darray[LLVMMetadataRef] = [own_string, domain]
            own_pointer: void& = (&own_ops[0]).cast[void&] can Unsafe.PointerCast
            own: LLVMMetadataRef = LLVMMDNodeInContext2(ctx, own_pointer, two)
            sibling_string: LLVMMetadataRef = LLVMMDStringInContext2(ctx, "elt", three)
            sibling_ops: mutable darray[LLVMMetadataRef] = [sibling_string, domain]
            sibling_pointer: void& = (&sibling_ops[0]).cast[void&] can Unsafe.PointerCast
            sibling: LLVMMetadataRef = LLVMMDNodeInContext2(ctx, sibling_pointer, two)
            alias_metadata: mutable darray[LLVMMetadataRef] = [own]
            noalias_metadata: mutable darray[LLVMMetadataRef] = [sibling]
            set_metadata_list(inst, "alias.scope", 11, alias_metadata, ctx)
            set_metadata_list(inst, "noalias", 7, noalias_metadata, ctx)
