# Stage1 backend — the BRANCHING statements: `if`/`elif`/`else` and `while`, each of which has
# to place its blocks, thread the narrowing proofs through the arms, and roll them back at the
# join. Reached from codegen_stmt_assign_flow.elisa after the assignment forms.
# Part of `module Backend` (see codegen.elisa).

extend Backend:
    private:
        def emit_statement_branching(statement: Stmt, return_type: ValueType, local_scope: mutable Scope&, loops: mutable LoopStack&, regions: mutable RegionStack&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef, handled: mutable bool&) -> EmitStatus can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:

            if statement is Stmt.If(if_condition, then_body, else_body, if_line):
                # The mark is taken BEFORE the condition, not just around each arm. An `is`
                # test binds its payload while the CONDITION is emitted, so the binding landed
                # outside both arms' scopes and survived to the end of the function — where
                # lookup_index, which scans backward, then found it instead of a same-named
                # outer local. `v: i64 = 100` followed by `if e is E.A(v): pass` and
                # `return v` answered 3 where stage0 answers 100: a silent wrong answer, and
                # the outer value was simply gone.
                #
                # stage0 scopes an `is` binding to its statement. A MATCH ARM binding is a
                # different rule — measured, it survives the match carrying the taken arm's
                # value — and is handled by sharing one slot across the arms instead.
                if_scope_mark: usize = scope_mark(local_scope)
                condition_opt: LLVMValueRef? = emit_condition(if_condition, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                if condition_opt is condition_bit:
                    function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                    then_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "if.then")
                    else_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "if.else")
                    join_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "if.join")
                    if_branch: LLVMValueRef = LLVMBuildCondBr(builder, condition_bit, then_block, else_block)
                    apply_branch_hint(if_branch, branch_hint_for(structs, if_line.line), ctx)

                    LLVMPositionBuilderAtEnd(builder, then_block)
                    # Inside the `then` arm the condition HOLDS, so `if p != null:` narrows
                    # `p` there -- stage0's rule, and what the std dict's rehash loop needs.
                    # Snapshotted and rolled back at the join: the proof does not survive
                    # the arm, and must not reach the `else` arm, where it is FALSE.
                    saved_owners: mutable darray[sview] = []
                    saved_fields: mutable darray[sview] = []
                    snapshot_narrowings(structs, saved_owners, saved_fields)
                    record_null_guards(if_condition, structs)
                    # `if node in STORE is Expr.Variant(binder):` — the store stays ACTIVE for
                    # the guarded body. Without this the condition activated it only for its own
                    # emission, so `binder.span` in the body had no store to read a common from.
                    if_then_runtime: mutable Runtime = copied_runtime(runtime)
                    if_store_name: sview = condition_in_store_name(if_condition)
                    if if_store_name != "":
                        if_store_type: ValueType = lookup_type(local_scope, if_store_name)
                        if if_store_type.kind == TypeKind.PackedStore:
                            if lookup_slot(local_scope, if_store_name) is if_store_slot:
                                if_then_runtime.active_store <- LLVMBuildLoad2(builder, llvm_type_of(if_store_type, structs, ctx), if_store_slot, "store.active")
                                if_then_runtime.active_store_enum <- if_store_type.bits.i64()
                                if_then_runtime.active_store_is_block <- true
                    # `if node is Expr.Pair as pair:` -- bind the alias to the SCRUTINEE inside
                    # the arm. The narrowed view IS the same value; every payload-field read
                    # (`pair.left`) then goes through the ordinary narrowed-variant field path,
                    # which resolves by unique field name.
                    match if_condition:
                        Expr.Binary(alias_scrutinee, alias_operator, alias_target, alias_line):
                            if alias_operator == TokenKind.Is and alias_target is Expr.Field(alias_head, alias_variant, alias_variant_line):
                                _ = alias_head
                                _ = alias_variant
                                alias_bound: sview = is_variant_alias_at(alias_variant_line.line, structs)
                                if alias_bound != "" and alias_scrutinee is Expr.Ident(alias_source, alias_source_line):
                                    if lookup_slot(local_scope, alias_source) is alias_slot:
                                        declare_local(local_scope, alias_bound, alias_slot, lookup_type(local_scope, alias_source))
                        _:
                            pass
                    then_status: EmitStatus = emit_statements_scoped(then_body, return_type, local_scope, loops, regions, fns, structs, generics, if_then_runtime, m, ctx, builder)
                    restore_narrowings(structs, saved_owners, saved_fields)
                    EmitStatus.Declined return if then_status == EmitStatus.Declined
                    branch_if_open(then_status, builder, join_block)

                    LLVMPositionBuilderAtEnd(builder, else_block)
                    else_status: EmitStatus = emit_statements_scoped(else_body, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)
                    # The else arm has its own flow facts. Restore the facts that existed
                    # before this `if` before reaching the join; otherwise a nested `assert`
                    # or early guard in the else arm can make a nullable place appear proven
                    # on the path after the conditional. The then arm already performs the
                    # same rollback above.
                    restore_narrowings(structs, saved_owners, saved_fields)
                    EmitStatus.Declined return if else_status == EmitStatus.Declined
                    branch_if_open(else_status, builder, join_block)
                    # Past the join the condition's own bindings are out of scope.
                    scope_restore(local_scope, if_scope_mark)

                    LLVMPositionBuilderAtEnd(builder, join_block)
                    # Both arms returned: the join is unreachable. It still needs a
                    # terminator or the module is invalid, and the `if` as a whole has
                    # ended the block.
                    if then_status == EmitStatus.Terminated and else_status == EmitStatus.Terminated:
                        _ = LLVMBuildUnreachable(builder)
                        return EmitStatus.Terminated
                    # An EARLY-RETURN guard narrows for the REST of the function: reaching
                    # here means the condition was false, so `return if PATH == null` proves
                    # PATH non-null from now on. Only when the `then` arm actually left and
                    # there is no `else` — otherwise the fall-through is also reachable with
                    # the condition true, and nothing is proven.
                    if then_status == EmitStatus.Terminated and else_body.count == 0:
                        record_null_guard_negation(if_condition, structs)
                    return EmitStatus.Open
                if dbg_decline_enabled():
                    _ = dbg_cond_fail(runtime.disjoint_function_name, if_condition)
                return EmitStatus.Declined

            if statement is Stmt.While(while_condition, while_body, while_line):
                function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                head_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "while.head")
                body_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "while.body")
                exit_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "while.exit")

                # The condition is re-evaluated each iteration, so it lives in its own
                # block that the body branches back to.
                _ = LLVMBuildBr(builder, head_block)
                LLVMPositionBuilderAtEnd(builder, head_block)
                condition_opt: LLVMValueRef? = emit_condition(while_condition, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                if condition_opt is condition_bit:
                    while_branch: LLVMValueRef = LLVMBuildCondBr(builder, condition_bit, body_block, exit_block)
                    apply_branch_hint(while_branch, branch_hint_for(structs, while_line.line), ctx)
                    LLVMPositionBuilderAtEnd(builder, body_block)
                    # A `while` continues to its CONDITION.
                    loops.exits <- loops.exits.push(exit_block)
                    loops.defer_marks <- loops.defer_marks.push(local_scope.deferred.count)
                    loops.continues <- loops.continues.push(head_block)
                    # The condition HOLDS inside the body, exactly as in an `if`'s then-arm,
                    # so `while r != null:` narrows `r` there — the std's region walks take
                    # the loop-carried optional as a plain ref on the first line of the body.
                    # Snapshotted and rolled back: the proof does not survive the loop, where
                    # the condition is false.
                    while_saved_owners: mutable darray[sview] = []
                    while_saved_fields: mutable darray[sview] = []
                    snapshot_narrowings(structs, while_saved_owners, while_saved_fields)
                    record_null_guards(while_condition, structs)
                    body_status: EmitStatus = emit_statements_scoped(while_body, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)
                    restore_narrowings(structs, while_saved_owners, while_saved_fields)
                    _ = loops.exits.pop()
                    _ = loops.defer_marks.pop()
                    _ = loops.continues.pop()
                    EmitStatus.Declined return if body_status == EmitStatus.Declined
                    # A body that returned does not loop back.
                    branch_if_open(body_status, builder, head_block)
                    # The loop may always exit via the condition, so the exit block is
                    # reachable and OPEN regardless of what the body did.
                    LLVMPositionBuilderAtEnd(builder, exit_block)
                    return EmitStatus.Open
                return EmitStatus.Declined
            handled <- false
            return EmitStatus.Declined
