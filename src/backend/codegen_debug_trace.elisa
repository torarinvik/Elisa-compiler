# Stage1 backend — the DECLINE TRACER (`ELISA_DBG_DECLINE`): when a branch refuses to emit,
# print which function and which shape refused. A compiler that declines must say what it
# declined. Part of `module Backend` (see codegen.elisa).

using Ast

extend Backend:
    private:


        # TEMP decline tracer (gated on ELISA_DBG_DECLINE): prints "<fn>: <tag>" when a
        # statement declines inside the named function, to locate self-host blockers.
        def dbg_decline_enabled() -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            flag_storage: mutable darray[u8] = []
            flag_name: cstr = sview_to_cstr("ELISA_DBG_DECLINE", flag_storage)
            if getenv(flag_name) is real:
                return true
            return false



        def dbg_stmt_kind(statement: Stmt) -> sview can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            if statement is Stmt.Block(_, _, _, _, _): return "Block"
            if statement is Stmt.VarDecl(_, _, _, _): return "VarDecl"
            if statement is Stmt.Assign(_, _, _, _): return "Assign"
            if statement is Stmt.Expr(_, _): return "Expr"
            if statement is Stmt.Return(_, _): return "Return"
            if statement is Stmt.If(_, _, _, _): return "If"
            if statement is Stmt.While(_, _, _): return "While"
            if statement is Stmt.For(_, _, _, _, _): return "For"
            if statement is Stmt.Match(_, _, _): return "Match"
            if statement is Stmt.Break(_, _): return "Break"
            if statement is Stmt.Continue(_, _): return "Continue"
            if statement is Stmt.Contract(_, _, _): return "Contract"
            # `Invalid` is a PARSER failure, not a backend gap: the statement never got
            # built, so the backend has nothing to emit and declining is correct. Naming it
            # separately keeps a frontend hole from being read as a missing emitter.
            if statement is Stmt.Invalid: return "Invalid(parse)"
            return "?Stmt"



        def dbg_push_sview(storage: mutable darray[u8]&, s: sview) -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            for index in 0..<sview_len(s) |storage|:
                storage.push(sview_at(s, index))
            return 0




        def dbg_stmt_line(statement: Stmt) -> u32 can[Abort.Panic]:
            if statement is Stmt.Block(_, _, _, _, bl): return bl.line
            if statement is Stmt.VarDecl(_, _, _, vl): return vl.line
            if statement is Stmt.Assign(_, _, _, al): return al.line
            if statement is Stmt.Expr(_, el): return el.line
            if statement is Stmt.Return(_, rl): return rl.line
            if statement is Stmt.If(_, _, _, il): return il.line
            if statement is Stmt.While(_, _, wl): return wl.line
            if statement is Stmt.For(_, _, _, _, fl): return fl.line
            if statement is Stmt.Match(_, _, ml): return ml.line
            return 0



        def dbg_push_int(storage: mutable darray[u8]&, value: u32) -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            if value == 0:
                storage.push(48)
                return 0
            digits: mutable darray[u8] = []
            remaining: mutable u32 = value
            while remaining > 0 |digits, remaining|:
                digits.push(48 + (remaining % 10).u8())
                remaining <- remaining / 10
            for rev in 0..<digits.count |storage, digits|:
                storage.push(digits[digits.count - 1 - rev])
            return 0



        # A decline report that says only "field expression" is useful for a small fixture,
        # but not for a self-hosted unit whose source has been flattened through hundreds of
        # includes. Keep the diagnostic deliberately structural: it identifies the receiver
        # shape without pretending that a backend trace is a source renderer. This is gated by
        # the existing debug flag and is emitted only for the first leaf decline per function.
        def dbg_expr_shape(expression: Expr, storage: mutable darray[u8]&) -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            match expression:
                Expr.Field(object, field, _):
                    _ = dbg_push_sview(storage, "Field(")
                    _ = dbg_expr_shape(object, storage)
                    _ = dbg_push_sview(storage, ".")
                    _ = dbg_push_sview(storage, field)
                    storage.push(41)
                Expr.Scope(base, name, _):
                    _ = dbg_push_sview(storage, "Scope(")
                    _ = dbg_expr_shape(base, storage)
                    _ = dbg_push_sview(storage, "::")
                    _ = dbg_push_sview(storage, name)
                    storage.push(41)
                Expr.Ident(name, _):
                    _ = dbg_push_sview(storage, "Ident(")
                    _ = dbg_push_sview(storage, name)
                    storage.push(41)
                Expr.Call(callee, _, _, _):
                    _ = dbg_push_sview(storage, "Call(")
                    _ = dbg_expr_shape(callee, storage)
                    storage.push(41)
                Expr.Index(object, index, _):
                    _ = dbg_push_sview(storage, "Index(")
                    _ = dbg_expr_shape(object, storage)
                    _ = dbg_push_sview(storage, ")")
                    _ = dbg_expr_shape(index, storage)
                    storage.push(41)
                Expr.IndexN(object, _, _):
                    _ = dbg_push_sview(storage, "IndexN(")
                    _ = dbg_expr_shape(object, storage)
                    storage.push(41)
                Expr.Paren(inner, _):
                    _ = dbg_push_sview(storage, "Paren(")
                    _ = dbg_expr_shape(inner, storage)
                    storage.push(41)
                Expr.IntLit(_, _):
                    _ = dbg_push_sview(storage, "Int")
                Expr.StringLit(_, _):
                    _ = dbg_push_sview(storage, "String")
                Expr.BoolLit(_, _):
                    _ = dbg_push_sview(storage, "Bool")
                Expr.FloatLit(_, _):
                    _ = dbg_push_sview(storage, "Float")
                Expr.CharLit(_, _):
                    _ = dbg_push_sview(storage, "Char")
                _:
                    _ = dbg_push_sview(storage, "Expr")
            return 0



        def dbg_expression_decline(expression: Expr, line: u32, kind: sview) -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            return 0 if not dbg_decline_enabled()
            msg_storage: mutable darray[u8] = []
            _ = dbg_push_sview(msg_storage, "  EXPR.DECLINE @")
            _ = dbg_push_int(msg_storage, line)
            _ = dbg_push_sview(msg_storage, " (")
            _ = dbg_push_sview(msg_storage, kind)
            _ = dbg_push_sview(msg_storage, "): ")
            _ = dbg_expr_shape(expression, msg_storage)
            msg_storage.push(10)
            msg_storage.push(0)
            return puts((&msg_storage[0]).cast[cstr] can Unsafe.PointerCast)



        def dbg_cond_fail(function: sview, condition: Expr) -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            0 return if function != "declare_or_get_abort" and function != "declare_or_get_named" and function != "tag_disjoint_darray_access"
            msg_storage: mutable darray[u8] = []
            _ = dbg_push_sview(msg_storage, "  COND.FAIL ")
            if condition is Expr.Binary(cf_left, cf_op, cf_right, cf_line):
                _ = dbg_push_sview(msg_storage, "Binary @")
                _ = dbg_push_int(msg_storage, cf_line.line)
            elif condition is Expr.Call(cf_callee, cf_args, cf_names, cf_cl):
                _ = dbg_push_sview(msg_storage, "Call @")
                _ = dbg_push_int(msg_storage, cf_cl.line)
            elif condition is Expr.Unary(cf_uop, cf_uoperand, cf_ul):
                _ = dbg_push_sview(msg_storage, "Unary @")
                _ = dbg_push_int(msg_storage, cf_ul.line)
            elif condition is Expr.Ident(cf_name, cf_il):
                _ = dbg_push_sview(msg_storage, "Ident ")
                _ = dbg_push_sview(msg_storage, cf_name)
            else:
                _ = dbg_push_sview(msg_storage, "other")
            msg_storage.push(0)
            return puts((&msg_storage[0]).cast[cstr] can Unsafe.PointerCast)



        def dbg_decline(function: sview, statement: Stmt) -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            msg_storage: mutable darray[u8] = []
            _ = dbg_push_sview(msg_storage, function)
            _ = dbg_push_sview(msg_storage, ": DECLINE ")
            _ = dbg_push_sview(msg_storage, dbg_stmt_kind(statement))
            _ = dbg_push_sview(msg_storage, " @line ")
            _ = dbg_push_int(msg_storage, dbg_stmt_line(statement))
            if statement is Stmt.Assign(dbg_assign_target, dbg_assign_operator, dbg_assign_value, dbg_assign_line):
                if dbg_assign_target is Expr.Ident(dbg_assign_name, dbg_assign_name_line):
                    _ = dbg_push_sview(msg_storage, " target=")
                    _ = dbg_push_sview(msg_storage, dbg_assign_name)
            msg_storage.push(0)
            return puts((&msg_storage[0]).cast[cstr] can Unsafe.PointerCast)
