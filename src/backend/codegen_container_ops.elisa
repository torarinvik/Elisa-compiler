# Stage1 backend — container operations: dict/set comprehensions, darray push, checked arithmetic.
# Part of `module Backend` (see codegen.elisa); split out to keep each file short.

extend Backend:
    private:
        # `{k: v for VAR in LOW..<HIGH (where COND)?}` — a DICT comprehension. Unlike the darray
        # comprehension there is no presize/vectorize: a dict is built the way stage0 lowers it,
        # a zeroed DynDict plus one `arena_dict_put_or_panic(arena, &d, key, value)` per iteration
        # that passes the optional filter. `expected` is the DynDict[K, V] struct; the key/value
        # pair rides in `body` as a two-element Tuple. Only an integer-range iterable is modeled.
        def emit_dict_comprehension(comprehension_var: sview, iterable: Expr, condition: Expr, body: Expr, expected: ValueType, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            dc_base: mutable sview = ""
            dc_arg_start: mutable usize = 0
            dc_arg_count: mutable usize = 0
            dc_has: bool = generic_struct_instantiation_of(structs, expected, dc_base, dc_arg_start, dc_arg_count)
            null return if not dc_has or dc_base != "DynDict" or dc_arg_count != 2
            match body:
                Expr.Absent:
                    return null
                _:
                    pass
            # The key/value pair rides in `body` as a two-element Tuple.
            dc_key_expr: mutable Expr = Expr.Absent
            dc_value_expr: mutable Expr = Expr.Absent
            dc_pair_ok: mutable bool = false
            match body:
                Expr.Tuple(dc_pair_read, dc_pair_read_line):
                    if dc_pair_read.count == 2:
                        dc_key_expr <- dc_pair_read[0]
                        dc_value_expr <- dc_pair_read[1]
                        dc_pair_ok <- true
                _:
                    pass
            null return if not dc_pair_ok
            dc_key_type: ValueType = copied_type(structs.generic_struct_inst_args[dc_arg_start])
            dc_value_type: ValueType = copied_type(structs.generic_struct_inst_args[dc_arg_start + 1.usize()])
            # A constant-false filter yields the empty dict; a constant-true or absent filter
            # runs every iteration; a dynamic filter branches per element.
            match condition:
                Expr.BoolLit(dc_filter_value):
                    if not dc_filter_value:
                        return LLVMConstNull(llvm_type_of(expected, structs, ctx))
                _:
                    pass
            # `{k: v for VAR in XS (if COND)?}` over an existing DARRAY source: walk the backing,
            # bind VAR = source[i], put each key/value that passes the filter. Handled before the
            # integer-range path below; leaves that path untouched.
            dc_src_type: ValueType = darray_type_behind_expr(iterable, local_scope, structs)
            if dc_src_type.kind == TypeKind.DArray:
                if darray_address_of_expr(iterable, local_scope, fns, structs, generics, runtime, m, ctx, builder) is dc_src_slot:
                    dc_src_elem: ValueType = darray_element_of(dc_src_type, structs)
                    null return if dc_src_elem.kind == TypeKind.Unmodeled
                    dc_dtype_args: mutable darray[ValueType] = [dc_key_type, dc_value_type]
                    if instantiate_generic("arena_dict_put_or_panic", dc_dtype_args, generics, structs, m, ctx) is dc_dput:
                        dc_di64: LLVMTypeRef = LLVMInt64TypeInContext(ctx)
                        dc_dheader: LLVMTypeRef = darray_llvm_type(structs, ctx)
                        dc_delem_llvm: LLVMTypeRef = llvm_type_of(dc_src_elem, structs, ctx)
                        dc_dllvm: LLVMTypeRef = llvm_type_of(expected, structs, ctx)
                        dc_dput_fn_type: LLVMTypeRef = LLVMGlobalGetValueType(dc_dput)
                        dc_dslot: LLVMValueRef = LLVMBuildAlloca(builder, dc_dllvm, "dict.comp.d")
                        _ = LLVMBuildStore(builder, LLVMConstNull(dc_dllvm), dc_dslot)
                        dc_dcount_ptr: LLVMValueRef = LLVMBuildStructGEP2(builder, dc_dheader, dc_src_slot, 1, "dict.comp.d.cnt.ptr")
                        dc_dcount: LLVMValueRef = LLVMBuildLoad2(builder, dc_di64, dc_dcount_ptr, "dict.comp.d.cnt")
                        dc_ditems_ptr: LLVMValueRef = LLVMBuildStructGEP2(builder, dc_dheader, dc_src_slot, 0, "dict.comp.d.items.ptr")
                        dc_ditems: LLVMValueRef = LLVMBuildLoad2(builder, LLVMPointerTypeInContext(ctx, 0), dc_ditems_ptr, "dict.comp.d.items")
                        dc_didx_slot: LLVMValueRef = LLVMBuildAlloca(builder, dc_di64, "dict.comp.d.i")
                        _ = LLVMBuildStore(builder, LLVMConstInt(dc_di64, 0, 0), dc_didx_slot)
                        dc_dvar_slot: LLVMValueRef = LLVMBuildAlloca(builder, dc_delem_llvm, "dict.comp.d.var")
                        declare_local(local_scope, comprehension_var, dc_dvar_slot, dc_src_elem)
                        dc_dfiltered: bool = match condition:
                            Expr.Absent: false
                            Expr.BoolLit: false
                            _: true
                        dc_dfunction: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                        dc_dcond: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, dc_dfunction, "dict.comp.d.cond")
                        dc_dbody: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, dc_dfunction, "dict.comp.d.body")
                        dc_dput_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, dc_dfunction, "dict.comp.d.put")
                        dc_dstep: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, dc_dfunction, "dict.comp.d.step")
                        dc_ddone: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, dc_dfunction, "dict.comp.d.done")
                        _ = LLVMBuildBr(builder, dc_dcond)
                        LLVMPositionBuilderAtEnd(builder, dc_dcond)
                        dc_dcur: LLVMValueRef = LLVMBuildLoad2(builder, dc_di64, dc_didx_slot, "dict.comp.d.cur")
                        dc_dmore: LLVMValueRef = LLVMBuildICmp(builder, 40, dc_dcur, dc_dcount, "dict.comp.d.more")
                        _ = LLVMBuildCondBr(builder, dc_dmore, dc_dbody, dc_ddone)
                        LLVMPositionBuilderAtEnd(builder, dc_dbody)
                        dc_dgep_indices: mutable darray[LLVMValueRef] = [dc_dcur]
                        dc_dgep_pointer: void& = (&dc_dgep_indices[0]).cast[void&] can Unsafe.PointerCast
                        dc_delem_ptr: LLVMValueRef = LLVMBuildGEP2(builder, dc_delem_llvm, dc_ditems, dc_dgep_pointer, 1, "dict.comp.d.elem.ptr")
                        _ = LLVMBuildStore(builder, LLVMBuildLoad2(builder, dc_delem_llvm, dc_delem_ptr, "dict.comp.d.elem"), dc_dvar_slot)
                        dc_dbody_ok: mutable bool = true
                        if dc_dfiltered:
                            if emit_condition(condition, local_scope, fns, structs, generics, runtime, m, ctx, builder) is dc_dpred:
                                _ = LLVMBuildCondBr(builder, dc_dpred, dc_dput_block, dc_dstep)
                            else:
                                dc_dbody_ok <- false
                        else:
                            _ = LLVMBuildBr(builder, dc_dput_block)
                        null return if not dc_dbody_ok
                        LLVMPositionBuilderAtEnd(builder, dc_dput_block)
                        if emit_expression(dc_key_expr, dc_key_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is dc_dkv:
                            if emit_expression(dc_value_expr, dc_value_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is dc_dvv:
                                dc_dput_args: mutable darray[LLVMValueRef] = [runtime.arena, dc_dslot, dc_dkv, dc_dvv]
                                dc_dput_args_pointer: void& = (&dc_dput_args[0]).cast[void&] can Unsafe.PointerCast
                                _ = LLVMBuildCall2(builder, dc_dput_fn_type, dc_dput, dc_dput_args_pointer, 4, "dict.comp.d.put.call")
                                _ = LLVMBuildBr(builder, dc_dstep)
                                LLVMPositionBuilderAtEnd(builder, dc_dstep)
                                _ = LLVMBuildStore(builder, LLVMBuildAdd(builder, dc_dcur, LLVMConstInt(dc_di64, 1, 0), "dict.comp.d.next"), dc_didx_slot)
                                _ = LLVMBuildBr(builder, dc_dcond)
                                LLVMPositionBuilderAtEnd(builder, dc_ddone)
                                return LLVMBuildLoad2(builder, dc_dllvm, dc_dslot, "dict.comp.d.value")
                            return null
                        return null
                    return null
                return null
            # Only an integer-range iterable is modeled (its bounds are known before the loop).
            dc_low_expr: mutable Expr = Expr.Absent
            dc_high_expr: mutable Expr = Expr.Absent
            dc_inclusive: mutable bool = false
            dc_range_ok: mutable bool = false
            match iterable:
                Expr.Binary(dc_low_read, dc_op_read, dc_high_read, dc_range_read_line):
                    if dc_op_read == TokenKind.RangeLt or dc_op_read == TokenKind.RangeLe:
                        dc_low_expr <- dc_low_read
                        dc_high_expr <- dc_high_read
                        dc_inclusive <- dc_op_read == TokenKind.RangeLe
                        dc_range_ok <- true
                _:
                    pass
            null return if not dc_range_ok
            dc_type_args: mutable darray[ValueType] = [dc_key_type, dc_value_type]
            if instantiate_generic("arena_dict_put_or_panic", dc_type_args, generics, structs, m, ctx) is dc_put:
                dc_i64: LLVMTypeRef = LLVMInt64TypeInContext(ctx)
                dc_index_type: ValueType = ValueType{kind: TypeKind.Signed, bits: 64}
                if emit_expression(dc_low_expr, dc_index_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is dc_low_value:
                    if emit_expression(dc_high_expr, dc_index_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is dc_high_value:
                        dc_llvm: LLVMTypeRef = llvm_type_of(expected, structs, ctx)
                        dc_put_fn_type: LLVMTypeRef = LLVMGlobalGetValueType(dc_put)
                        dc_slot: LLVMValueRef = LLVMBuildAlloca(builder, dc_llvm, "dict.comp")
                        _ = LLVMBuildStore(builder, LLVMConstNull(dc_llvm), dc_slot)
                        # Upper bound as a `<` limit: an inclusive `..=` adds one.
                        dc_limit: mutable LLVMValueRef = dc_high_value
                        dc_limit <- LLVMBuildAdd(builder, dc_high_value, LLVMConstInt(dc_i64, 1, 0), "dict.comp.limit") if dc_inclusive
                        dc_index_slot: LLVMValueRef = LLVMBuildAlloca(builder, dc_i64, "dict.comp.i")
                        _ = LLVMBuildStore(builder, dc_low_value, dc_index_slot)
                        dc_var_slot: LLVMValueRef = LLVMBuildAlloca(builder, llvm_type_of(dc_index_type, structs, ctx), "dict.comp.var")
                        declare_local(local_scope, comprehension_var, dc_var_slot, dc_index_type)
                        dc_filtered: bool = match condition:
                            Expr.Absent: false
                            Expr.BoolLit: false
                            _: true
                        dc_function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                        dc_cond: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, dc_function, "dict.comp.cond")
                        dc_bodyb: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, dc_function, "dict.comp.body")
                        dc_put_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, dc_function, "dict.comp.put")
                        dc_step: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, dc_function, "dict.comp.step")
                        dc_done: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, dc_function, "dict.comp.done")
                        _ = LLVMBuildBr(builder, dc_cond)
                        LLVMPositionBuilderAtEnd(builder, dc_cond)
                        dc_cur: LLVMValueRef = LLVMBuildLoad2(builder, dc_i64, dc_index_slot, "dict.comp.cur")
                        dc_more: LLVMValueRef = LLVMBuildICmp(builder, 40, dc_cur, dc_limit, "dict.comp.more")
                        _ = LLVMBuildCondBr(builder, dc_more, dc_bodyb, dc_done)
                        LLVMPositionBuilderAtEnd(builder, dc_bodyb)
                        _ = LLVMBuildStore(builder, dc_cur, dc_var_slot)
                        dc_body_ok: mutable bool = true
                        if dc_filtered:
                            if emit_condition(condition, local_scope, fns, structs, generics, runtime, m, ctx, builder) is dc_pred:
                                _ = LLVMBuildCondBr(builder, dc_pred, dc_put_block, dc_step)
                            else:
                                dc_body_ok <- false
                        else:
                            _ = LLVMBuildBr(builder, dc_put_block)
                        null return if not dc_body_ok
                        LLVMPositionBuilderAtEnd(builder, dc_put_block)
                        if emit_expression(dc_key_expr, dc_key_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is dc_kv:
                            if emit_expression(dc_value_expr, dc_value_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is dc_vv:
                                dc_put_args: mutable darray[LLVMValueRef] = [runtime.arena, dc_slot, dc_kv, dc_vv]
                                dc_put_args_pointer: void& = (&dc_put_args[0]).cast[void&] can Unsafe.PointerCast
                                _ = LLVMBuildCall2(builder, dc_put_fn_type, dc_put, dc_put_args_pointer, 4, "dict.comp.put.call")
                                _ = LLVMBuildBr(builder, dc_step)
                                LLVMPositionBuilderAtEnd(builder, dc_step)
                                _ = LLVMBuildStore(builder, LLVMBuildAdd(builder, dc_cur, LLVMConstInt(dc_i64, 1, 0), "dict.comp.next"), dc_index_slot)
                                _ = LLVMBuildBr(builder, dc_cond)
                                LLVMPositionBuilderAtEnd(builder, dc_done)
                                return LLVMBuildLoad2(builder, dc_llvm, dc_slot, "dict.comp.value")
                            return null
                        return null
                    return null
                return null
            return null


        # `{x for VAR in LOW..<HIGH (if COND)?}` — a SET comprehension. The single-column analogue
        # of the dict comprehension: a zeroed DynSet plus one `arena_set_add_or_panic(arena, &s,
        # elem)` per iteration that passes the optional filter. `expected` is the DynSet[T] struct;
        # `body` is the element expression. Only an integer-range iterable is modeled.
        def emit_set_comprehension(comprehension_var: sview, iterable: Expr, condition: Expr, body: Expr, expected: ValueType, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            sc_base: mutable sview = ""
            sc_arg_start: mutable usize = 0
            sc_arg_count: mutable usize = 0
            sc_has: bool = generic_struct_instantiation_of(structs, expected, sc_base, sc_arg_start, sc_arg_count)
            null return if not sc_has or sc_base != "DynSet" or sc_arg_count != 1
            match body:
                Expr.Absent:
                    return null
                _:
                    pass
            sc_elem_type: ValueType = copied_type(structs.generic_struct_inst_args[sc_arg_start])
            # A constant-false filter yields the empty set; other filters loop.
            match condition:
                Expr.BoolLit(sc_filter_value):
                    if not sc_filter_value:
                        return LLVMConstNull(llvm_type_of(expected, structs, ctx))
                _:
                    pass
            # `{x for VAR in XS (if COND)?}` over an existing DARRAY source: walk the backing, add
            # each element that passes the filter. Handled before the range path; leaves it intact.
            sc_src_type: ValueType = darray_type_behind_expr(iterable, local_scope, structs)
            if sc_src_type.kind == TypeKind.DArray:
                if darray_address_of_expr(iterable, local_scope, fns, structs, generics, runtime, m, ctx, builder) is sc_src_slot:
                    sc_src_elem: ValueType = darray_element_of(sc_src_type, structs)
                    null return if sc_src_elem.kind == TypeKind.Unmodeled
                    sc_dtype_args: mutable darray[ValueType] = [sc_elem_type]
                    if instantiate_generic("arena_set_add_or_panic", sc_dtype_args, generics, structs, m, ctx) is sc_dadd:
                        sc_di64: LLVMTypeRef = LLVMInt64TypeInContext(ctx)
                        sc_dheader: LLVMTypeRef = darray_llvm_type(structs, ctx)
                        sc_delem_llvm: LLVMTypeRef = llvm_type_of(sc_src_elem, structs, ctx)
                        sc_dllvm: LLVMTypeRef = llvm_type_of(expected, structs, ctx)
                        sc_dadd_fn_type: LLVMTypeRef = LLVMGlobalGetValueType(sc_dadd)
                        sc_dslot: LLVMValueRef = LLVMBuildAlloca(builder, sc_dllvm, "set.comp.d")
                        _ = LLVMBuildStore(builder, LLVMConstNull(sc_dllvm), sc_dslot)
                        sc_dcount_ptr: LLVMValueRef = LLVMBuildStructGEP2(builder, sc_dheader, sc_src_slot, 1, "set.comp.d.cnt.ptr")
                        sc_dcount: LLVMValueRef = LLVMBuildLoad2(builder, sc_di64, sc_dcount_ptr, "set.comp.d.cnt")
                        sc_ditems_ptr: LLVMValueRef = LLVMBuildStructGEP2(builder, sc_dheader, sc_src_slot, 0, "set.comp.d.items.ptr")
                        sc_ditems: LLVMValueRef = LLVMBuildLoad2(builder, LLVMPointerTypeInContext(ctx, 0), sc_ditems_ptr, "set.comp.d.items")
                        sc_didx_slot: LLVMValueRef = LLVMBuildAlloca(builder, sc_di64, "set.comp.d.i")
                        _ = LLVMBuildStore(builder, LLVMConstInt(sc_di64, 0, 0), sc_didx_slot)
                        sc_dvar_slot: LLVMValueRef = LLVMBuildAlloca(builder, sc_delem_llvm, "set.comp.d.var")
                        declare_local(local_scope, comprehension_var, sc_dvar_slot, sc_src_elem)
                        sc_dfiltered: bool = match condition:
                            Expr.Absent: false
                            Expr.BoolLit: false
                            _: true
                        sc_dfunction: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                        sc_dcond: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, sc_dfunction, "set.comp.d.cond")
                        sc_dbody: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, sc_dfunction, "set.comp.d.body")
                        sc_dadd_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, sc_dfunction, "set.comp.d.add")
                        sc_dstep: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, sc_dfunction, "set.comp.d.step")
                        sc_ddone: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, sc_dfunction, "set.comp.d.done")
                        _ = LLVMBuildBr(builder, sc_dcond)
                        LLVMPositionBuilderAtEnd(builder, sc_dcond)
                        sc_dcur: LLVMValueRef = LLVMBuildLoad2(builder, sc_di64, sc_didx_slot, "set.comp.d.cur")
                        sc_dmore: LLVMValueRef = LLVMBuildICmp(builder, 40, sc_dcur, sc_dcount, "set.comp.d.more")
                        _ = LLVMBuildCondBr(builder, sc_dmore, sc_dbody, sc_ddone)
                        LLVMPositionBuilderAtEnd(builder, sc_dbody)
                        sc_dgep_indices: mutable darray[LLVMValueRef] = [sc_dcur]
                        sc_dgep_pointer: void& = (&sc_dgep_indices[0]).cast[void&] can Unsafe.PointerCast
                        sc_delem_ptr: LLVMValueRef = LLVMBuildGEP2(builder, sc_delem_llvm, sc_ditems, sc_dgep_pointer, 1, "set.comp.d.elem.ptr")
                        _ = LLVMBuildStore(builder, LLVMBuildLoad2(builder, sc_delem_llvm, sc_delem_ptr, "set.comp.d.elem"), sc_dvar_slot)
                        sc_dbody_ok: mutable bool = true
                        if sc_dfiltered:
                            if emit_condition(condition, local_scope, fns, structs, generics, runtime, m, ctx, builder) is sc_dpred:
                                _ = LLVMBuildCondBr(builder, sc_dpred, sc_dadd_block, sc_dstep)
                            else:
                                sc_dbody_ok <- false
                        else:
                            _ = LLVMBuildBr(builder, sc_dadd_block)
                        null return if not sc_dbody_ok
                        LLVMPositionBuilderAtEnd(builder, sc_dadd_block)
                        if emit_expression(body, sc_elem_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is sc_delem_value:
                            sc_dadd_args: mutable darray[LLVMValueRef] = [runtime.arena, sc_dslot, sc_delem_value]
                            sc_dadd_args_pointer: void& = (&sc_dadd_args[0]).cast[void&] can Unsafe.PointerCast
                            _ = LLVMBuildCall2(builder, sc_dadd_fn_type, sc_dadd, sc_dadd_args_pointer, 3, "set.comp.d.add.call")
                            _ = LLVMBuildBr(builder, sc_dstep)
                            LLVMPositionBuilderAtEnd(builder, sc_dstep)
                            _ = LLVMBuildStore(builder, LLVMBuildAdd(builder, sc_dcur, LLVMConstInt(sc_di64, 1, 0), "set.comp.d.next"), sc_didx_slot)
                            _ = LLVMBuildBr(builder, sc_dcond)
                            LLVMPositionBuilderAtEnd(builder, sc_ddone)
                            return LLVMBuildLoad2(builder, sc_dllvm, sc_dslot, "set.comp.d.value")
                        return null
                    return null
                return null
            # Only an integer-range iterable is modeled.
            sc_low_expr: mutable Expr = Expr.Absent
            sc_high_expr: mutable Expr = Expr.Absent
            sc_inclusive: mutable bool = false
            sc_range_ok: mutable bool = false
            match iterable:
                Expr.Binary(sc_low_read, sc_op_read, sc_high_read, sc_range_read_line):
                    if sc_op_read == TokenKind.RangeLt or sc_op_read == TokenKind.RangeLe:
                        sc_low_expr <- sc_low_read
                        sc_high_expr <- sc_high_read
                        sc_inclusive <- sc_op_read == TokenKind.RangeLe
                        sc_range_ok <- true
                _:
                    pass
            null return if not sc_range_ok
            sc_type_args: mutable darray[ValueType] = [sc_elem_type]
            if instantiate_generic("arena_set_add_or_panic", sc_type_args, generics, structs, m, ctx) is sc_add:
                sc_i64: LLVMTypeRef = LLVMInt64TypeInContext(ctx)
                sc_index_type: ValueType = ValueType{kind: TypeKind.Signed, bits: 64}
                if emit_expression(sc_low_expr, sc_index_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is sc_low_value:
                    if emit_expression(sc_high_expr, sc_index_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is sc_high_value:
                        sc_llvm: LLVMTypeRef = llvm_type_of(expected, structs, ctx)
                        sc_add_fn_type: LLVMTypeRef = LLVMGlobalGetValueType(sc_add)
                        sc_slot: LLVMValueRef = LLVMBuildAlloca(builder, sc_llvm, "set.comp")
                        _ = LLVMBuildStore(builder, LLVMConstNull(sc_llvm), sc_slot)
                        sc_limit: mutable LLVMValueRef = sc_high_value
                        sc_limit <- LLVMBuildAdd(builder, sc_high_value, LLVMConstInt(sc_i64, 1, 0), "set.comp.limit") if sc_inclusive
                        sc_index_slot: LLVMValueRef = LLVMBuildAlloca(builder, sc_i64, "set.comp.i")
                        _ = LLVMBuildStore(builder, sc_low_value, sc_index_slot)
                        sc_var_slot: LLVMValueRef = LLVMBuildAlloca(builder, llvm_type_of(sc_index_type, structs, ctx), "set.comp.var")
                        declare_local(local_scope, comprehension_var, sc_var_slot, sc_index_type)
                        sc_filtered: bool = match condition:
                            Expr.Absent: false
                            Expr.BoolLit: false
                            _: true
                        sc_function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                        sc_cond: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, sc_function, "set.comp.cond")
                        sc_bodyb: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, sc_function, "set.comp.body")
                        sc_add_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, sc_function, "set.comp.add")
                        sc_step: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, sc_function, "set.comp.step")
                        sc_done: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, sc_function, "set.comp.done")
                        _ = LLVMBuildBr(builder, sc_cond)
                        LLVMPositionBuilderAtEnd(builder, sc_cond)
                        sc_cur: LLVMValueRef = LLVMBuildLoad2(builder, sc_i64, sc_index_slot, "set.comp.cur")
                        sc_more: LLVMValueRef = LLVMBuildICmp(builder, 40, sc_cur, sc_limit, "set.comp.more")
                        _ = LLVMBuildCondBr(builder, sc_more, sc_bodyb, sc_done)
                        LLVMPositionBuilderAtEnd(builder, sc_bodyb)
                        _ = LLVMBuildStore(builder, sc_cur, sc_var_slot)
                        sc_body_ok: mutable bool = true
                        if sc_filtered:
                            if emit_condition(condition, local_scope, fns, structs, generics, runtime, m, ctx, builder) is sc_pred:
                                _ = LLVMBuildCondBr(builder, sc_pred, sc_add_block, sc_step)
                            else:
                                sc_body_ok <- false
                        else:
                            _ = LLVMBuildBr(builder, sc_add_block)
                        null return if not sc_body_ok
                        LLVMPositionBuilderAtEnd(builder, sc_add_block)
                        if emit_expression(body, sc_elem_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is sc_elem_value:
                            sc_add_args: mutable darray[LLVMValueRef] = [runtime.arena, sc_slot, sc_elem_value]
                            sc_add_args_pointer: void& = (&sc_add_args[0]).cast[void&] can Unsafe.PointerCast
                            _ = LLVMBuildCall2(builder, sc_add_fn_type, sc_add, sc_add_args_pointer, 3, "set.comp.add.call")
                            _ = LLVMBuildBr(builder, sc_step)
                            LLVMPositionBuilderAtEnd(builder, sc_step)
                            _ = LLVMBuildStore(builder, LLVMBuildAdd(builder, sc_cur, LLVMConstInt(sc_i64, 1, 0), "set.comp.next"), sc_index_slot)
                            _ = LLVMBuildBr(builder, sc_cond)
                            LLVMPositionBuilderAtEnd(builder, sc_done)
                            return LLVMBuildLoad2(builder, sc_llvm, sc_slot, "set.comp.value")
                        return null
                    return null
                return null
            return null


        def emit_darray_push(array_slot: LLVMValueRef, array_type: ValueType, value_expression: Expr, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            element_type: ValueType = darray_element_of(array_type, structs)
            false return if element_type.kind == TypeKind.Unmodeled
            int64_type: LLVMTypeRef = LLVMInt64TypeInContext(ctx)
            header: LLVMTypeRef = darray_llvm_type(structs, ctx)
            stride: LLVMValueRef = element_stride(element_type, structs, ctx)

            items_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, header, array_slot, 0, "darray.items.ptr")
            count_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, header, array_slot, 1, "darray.count.ptr")
            capacity_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, header, array_slot, 2, "darray.cap.ptr")

            count: LLVMValueRef = LLVMBuildLoad2(builder, int64_type, count_pointer, "push.count")
            needed: LLVMValueRef = LLVMBuildAdd(builder, count, LLVMConstInt(int64_type, 1, 0), "push.needed")
            capacity: LLVMValueRef = LLVMBuildLoad2(builder, int64_type, capacity_pointer, "push.cap")

            function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
            grow_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "push.grow")
            store_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "push.store")
            # 35 = UGE: capacities are unsigned.
            enough: LLVMValueRef = LLVMBuildICmp(builder, 35, capacity, needed, "push.cap.ok")
            _ = LLVMBuildCondBr(builder, enough, store_block, grow_block)

            LLVMPositionBuilderAtEnd(builder, grow_block)
            doubled: mutable LLVMValueRef = zeroed
            if emit_overflow_binary(capacity, LLVMConstInt(int64_type, 2, 0), true, m, ctx, builder) is doubled_result:
                doubled <- LLVMBuildSelect(builder, doubled_result.overflow, needed, doubled_result.value, "push.cap.double.safe")
            else:
                return false
            # 32 = EQ.
            is_empty: LLVMValueRef = LLVMBuildICmp(builder, 32, capacity, LLVMConstInt(int64_type, 0, 0), "push.cap.zero")
            # Keep stage1's builtin push lowering in lockstep with
            # elisacore_std.collections' ARENA_DA_INIT_CAP. This is part of
            # the ABI-visible runtime policy, not an independent heuristic.
            base: LLVMValueRef = LLVMBuildSelect(builder, is_empty, LLVMConstInt(int64_type, 8, 0), doubled, "push.cap.base")
            # 36 = ULT.
            too_small: LLVMValueRef = LLVMBuildICmp(builder, 36, base, needed, "push.cap.lt")
            new_capacity: LLVMValueRef = LLVMBuildSelect(builder, too_small, needed, base, "push.cap.new")
            if emit_checked_reserve_binary(capacity, stride, true, m, ctx, builder) is push_old_bytes:
                if emit_checked_reserve_binary(new_capacity, stride, true, m, ctx, builder) is push_new_bytes:
                    old_bytes: LLVMValueRef = push_old_bytes
                    new_bytes: LLVMValueRef = push_new_bytes
                    old_items: LLVMValueRef = LLVMBuildLoad2(builder, LLVMPointerTypeInContext(ctx, 0), items_pointer, "push.items")
                    is_null: LLVMValueRef = LLVMBuildICmp(builder, 32, old_items, LLVMConstNull(LLVMPointerTypeInContext(ctx, 0)), "push.items.null")
                    alloc_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "push.alloc")
                    realloc_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "push.realloc")
                    grown_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "push.grown")
                    _ = LLVMBuildCondBr(builder, is_null, alloc_block, realloc_block)

                    LLVMPositionBuilderAtEnd(builder, alloc_block)
                    alloc_arguments: mutable darray[LLVMValueRef] = [runtime.arena, runtime_size_argument(new_bytes, ctx, builder)]
                    alloc_pointer: void& = (&alloc_arguments[0]).cast[void&] can Unsafe.PointerCast
                    allocated: LLVMValueRef = LLVMBuildCall2(builder, runtime.arena_alloc_type, runtime.arena_alloc, alloc_pointer, 2, "push.alloc")
                    _ = LLVMBuildStore(builder, allocated, items_pointer)
                    _ = LLVMBuildBr(builder, grown_block)

                    LLVMPositionBuilderAtEnd(builder, realloc_block)
                    realloc_arguments: mutable darray[LLVMValueRef] = [runtime.arena, old_items, runtime_size_argument(old_bytes, ctx, builder), runtime_size_argument(new_bytes, ctx, builder)]
                    realloc_pointer: void& = (&realloc_arguments[0]).cast[void&] can Unsafe.PointerCast
                    reallocated: LLVMValueRef = LLVMBuildCall2(builder, runtime.arena_realloc_type, runtime.arena_realloc, realloc_pointer, 4, "push.realloc")
                    _ = LLVMBuildStore(builder, reallocated, items_pointer)
                    _ = LLVMBuildBr(builder, grown_block)

                    LLVMPositionBuilderAtEnd(builder, grown_block)
                else:
                    return false
            else:
                return false
            _ = LLVMBuildStore(builder, new_capacity, capacity_pointer)
            _ = LLVMBuildBr(builder, store_block)

            LLVMPositionBuilderAtEnd(builder, store_block)
            if emit_expression(value_expression, element_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is pushed_value:
                # `xs.push(g())` where `g` returns void: a void value cannot be stored, and
                # storing it crashed the object path inside LLVM rather than declining.
                false return if LLVMTypeOf(pushed_value) == LLVMVoidTypeInContext(ctx)
                items: LLVMValueRef = LLVMBuildLoad2(builder, LLVMPointerTypeInContext(ctx, 0), items_pointer, "push.items.cur")
                indices: mutable darray[LLVMValueRef] = [count]
                indices_pointer: void& = (&indices[0]).cast[void&] can Unsafe.PointerCast
                # ONE index: `items` is already a T*, not a pointer-to-array, so there is
                # no leading 0 to step over (unlike a fixed array's two-index GEP).
                slot: LLVMValueRef = LLVMBuildGEP2(builder, llvm_type_of(element_type, structs, ctx), items, indices_pointer, 1, "push.slot")
                _ = LLVMBuildStore(builder, pushed_value, slot)
                _ = LLVMBuildStore(builder, needed, count_pointer)
                return true
            return false


        # Emit a width-preserving LLVM overflow intrinsic for usize (i64 on the current
        # targets). The caller decides whether overflow traps or selects a fallback value.
        def emit_overflow_binary(left: LLVMValueRef, right: LLVMValueRef, multiply: bool, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> OverflowResult? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            intrinsic_name: sview = "llvm.umul.with.overflow" if multiply else "llvm.uadd.with.overflow"
            intrinsic_storage: mutable darray[u8] = []
            intrinsic_cstr: cstr = sview_to_cstr(intrinsic_name, intrinsic_storage)
            intrinsic_id: u32 = LLVMLookupIntrinsicID(intrinsic_cstr, sview_len(intrinsic_name))
            null return if intrinsic_id == 0
            int_type: LLVMTypeRef = LLVMInt64TypeInContext(ctx)
            parameter_types: mutable darray[LLVMTypeRef] = [int_type]
            parameter_pointer: void& = (&parameter_types[0]).cast[void&] can Unsafe.PointerCast
            intrinsic_fn: LLVMValueRef = LLVMGetIntrinsicDeclaration(m, intrinsic_id, parameter_pointer, 1)
            null return if intrinsic_fn == zeroed
            arguments: mutable darray[LLVMValueRef] = [left, right]
            arguments_pointer: void& = (&arguments[0]).cast[void&] can Unsafe.PointerCast
            call: LLVMValueRef = LLVMBuildCall2(builder, LLVMGlobalGetValueType(intrinsic_fn), intrinsic_fn, arguments_pointer, 2, "checked.binary")
            return OverflowResult{value: LLVMBuildExtractValue(builder, call, 0, "checked.value"), overflow: LLVMBuildExtractValue(builder, call, 1, "checked.overflow")}


        # Checked reserve-bound arithmetic traps on overflow, matching stage0's
        # `llvm.uadd/umul.with.overflow` lowering instead of allowing a wrapped byte count.
        def emit_checked_reserve_binary(left: LLVMValueRef, right: LLVMValueRef, multiply: bool, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            if emit_overflow_binary(left, right, multiply, m, ctx, builder) is result:
                function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                trap_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "reserve.overflow")
                continue_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "reserve.checked")
                _ = LLVMBuildCondBr(builder, result.overflow, trap_block, continue_block)
                LLVMPositionBuilderAtEnd(builder, trap_block)
                _ = LLVMBuildUnreachable(builder)
                LLVMPositionBuilderAtEnd(builder, continue_block)
                return result.value
            return null


        # Re-emit `+` and `*` trees used as reserve bounds through checked intrinsics.
        # Other expressions use the ordinary expression emitter unchanged.
        def emit_reserve_bound(expression: Expr, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                match expression:
                    Expr.Paren(inner_expression, inner_line):
                        return emit_reserve_bound(inner_expression, local_scope, fns, structs, generics, runtime, m, ctx, builder)
                    _:
                        pass
                match expression:
                    Expr.Binary(bound_left, bound_operator, bound_right, bound_line):
                        if bound_operator == TokenKind.Plus or bound_operator == TokenKind.Star:
                            if emit_reserve_bound(bound_left, local_scope, fns, structs, generics, runtime, m, ctx, builder) is left_value:
                                if emit_reserve_bound(bound_right, local_scope, fns, structs, generics, runtime, m, ctx, builder) is right_value:
                                    return emit_checked_reserve_binary(left_value, right_value, bound_operator == TokenKind.Star, m, ctx, builder)
                                return null
                            return null
                    _:
                        pass
                return emit_expression(expression, ValueType{kind: TypeKind.Unsigned, bits: 64}, local_scope, fns, structs, generics, runtime, m, ctx, builder)


            # `xs.reserve(n)` — ensure capacity >= n WITHOUT changing count or storing any
            # element. The grow half of push (alloc-or-realloc to n*stride, then seal the new
            # capacity), guarded by the same `capacity UGE needed` skip. Unlike resize (which
            # push-fills zeros and so is scalar-only), reserve never materializes an element, so
            # it works for ANY element type — including a darray of structs (IndexMap.entries).
        def emit_darray_reserve(array_slot: LLVMValueRef, array_type: ValueType, needed: LLVMValueRef, structs: mutable StructTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            element_type: ValueType = darray_element_of(array_type, structs)
            false return if element_type.kind == TypeKind.Unmodeled
            int64_type: LLVMTypeRef = LLVMInt64TypeInContext(ctx)
            header: LLVMTypeRef = darray_llvm_type(structs, ctx)
            stride: LLVMValueRef = element_stride(element_type, structs, ctx)

            items_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, header, array_slot, 0, "reserve.items.ptr")
            capacity_pointer: LLVMValueRef = LLVMBuildStructGEP2(builder, header, array_slot, 2, "reserve.cap.ptr")
            capacity: LLVMValueRef = LLVMBuildLoad2(builder, int64_type, capacity_pointer, "reserve.cap")

            function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
            grow_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "reserve.grow")
            done_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "reserve.done")
            # 35 = UGE: already big enough → nothing to do.
            enough: LLVMValueRef = LLVMBuildICmp(builder, 35, capacity, needed, "reserve.cap.ok")
            _ = LLVMBuildCondBr(builder, enough, done_block, grow_block)

            LLVMPositionBuilderAtEnd(builder, grow_block)
            # Grow to exactly `needed` (>= old capacity here, so never shrinks the backing).
            if emit_checked_reserve_binary(capacity, stride, true, m, ctx, builder) is old_bytes_checked:
                if emit_checked_reserve_binary(needed, stride, true, m, ctx, builder) is new_bytes_checked:
                    old_bytes: LLVMValueRef = old_bytes_checked
                    new_bytes: LLVMValueRef = new_bytes_checked
                    old_items: LLVMValueRef = LLVMBuildLoad2(builder, LLVMPointerTypeInContext(ctx, 0), items_pointer, "reserve.items")
                    is_null: LLVMValueRef = LLVMBuildICmp(builder, 32, old_items, LLVMConstNull(LLVMPointerTypeInContext(ctx, 0)), "reserve.items.null")
                    alloc_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "reserve.alloc")
                    realloc_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "reserve.realloc")
                    _ = LLVMBuildCondBr(builder, is_null, alloc_block, realloc_block)

                    LLVMPositionBuilderAtEnd(builder, alloc_block)
                    alloc_arguments: mutable darray[LLVMValueRef] = [runtime.arena, runtime_size_argument(new_bytes, ctx, builder)]
                    alloc_pointer: void& = (&alloc_arguments[0]).cast[void&] can Unsafe.PointerCast
                    allocated: LLVMValueRef = LLVMBuildCall2(builder, runtime.arena_alloc_type, runtime.arena_alloc, alloc_pointer, 2, "reserve.alloc")
                    _ = LLVMBuildStore(builder, allocated, items_pointer)
                    _ = LLVMBuildStore(builder, needed, capacity_pointer)
                    _ = LLVMBuildBr(builder, done_block)

                    LLVMPositionBuilderAtEnd(builder, realloc_block)
                    realloc_arguments: mutable darray[LLVMValueRef] = [runtime.arena, old_items, runtime_size_argument(old_bytes, ctx, builder), runtime_size_argument(new_bytes, ctx, builder)]
                    realloc_pointer: void& = (&realloc_arguments[0]).cast[void&] can Unsafe.PointerCast
                    reallocated: LLVMValueRef = LLVMBuildCall2(builder, runtime.arena_realloc_type, runtime.arena_realloc, realloc_pointer, 4, "reserve.realloc")
                    _ = LLVMBuildStore(builder, reallocated, items_pointer)
                    _ = LLVMBuildStore(builder, needed, capacity_pointer)
                    _ = LLVMBuildBr(builder, done_block)

                    LLVMPositionBuilderAtEnd(builder, done_block)
                    return true
                return false
            return false


        # `_ = xs.reserve(n)` — reserve returns `mutable darray&` (for chaining), so it is
        # DISCARDED via `_ =` rather than appearing as a bare statement (unlike void `push`).
        # Both discard sites (`_` VarDecl and `_` Assign) route through emit_expression, which
        # does not model the darray growth method — intercept it here first. Returns 1 = handled
        # (Open), -1 = recognized-but-declined, 0 = not a darray reserve (fall through).
        def try_discarded_darray_reserve(value_expression: Expr, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                match value_expression:
                    Expr.Call(dr_callee, dr_arguments, dr_argument_names, dr_call_line):
                        match dr_callee:
                            Expr.Field(dr_object, dr_method, dr_method_line):
                                if dr_method == "reserve" and dr_arguments.count == 1:
                                    dr_type: ValueType = darray_type_behind_expr(dr_object, local_scope, structs)
                                    if dr_type.kind == TypeKind.DArray:
                                        if darray_address_of_expr(dr_object, local_scope, fns, structs, generics, runtime, m, ctx, builder) is dr_slot:
                                            if emit_reserve_bound(dr_arguments[0], local_scope, fns, structs, generics, runtime, m, ctx, builder) is dr_n:
                                                if emit_darray_reserve(dr_slot, dr_type, dr_n, structs, runtime, m, ctx, builder):
                                                    return 1
                                        return -1
                            _:
                                pass
                    _:
                        pass
                return 0


            # The user-defined `struct Arena`, when the program declares one. The NAME `Arena`
            # always annotates as TypeKind.Arena (the runtime carrier -- `in` blocks and arena
            # threading key on it), but the std DEFINES the struct itself, with fields the
            # allocator walks (`a.begin`). The two are layout-identical by construction (the
            # backend's auto-region {ptr,ptr,i64,i64} IS the std's {begin,end,end_index,
            # strategy}), so FIELD ACCESS resolves through the declared struct while the type
            # stays Arena everywhere else. Without this, every std function touching an arena
            # field declined -- arena_used_slots was the observable casualty.
        def arena_user_struct(structs: mutable StructTable&) -> ValueType can[Abort.Panic]:
            for index in 0..<structs.names.count |structs|:
                ValueType{kind: TypeKind.Struct, bits: index.u32()} return if structs.names[index] == "Arena"
            return unmodeled_type()
