# Stage1 backend — a `match` used as a VALUE: every arm writes into one slot, so the arms are
# lowered against a shared destination and the join reads it back.
# Part of `module Backend` (see codegen.elisa).

extend Backend:
    private:

        # `x: T = match SCRUT:` — a match in VALUE position whose arms may be BLOCKS (statements
        # then a yield). emit_expression's Expr.Match handles only single-expression arms and
        # lacks the statement context (loops/regions/return_type) a block arm needs; this runs
        # at statement level and routes each arm through emit_arm_body_into_slot. Allocates and
        # declares `var_name`. Mirrors the match-expr's scrutinee dispatch (int/cstr/sview/packed/
        # penum) and its variant-payload binding. Returns Declined for unmodeled shapes.
        def emit_match_into_slot(match_scrutinee: Expr, match_arms: darray[MatchArm]&, result_types: darray[ValueType]&, var_names: darray[sview]&, return_type: ValueType, local_scope: mutable Scope&, loops: mutable LoopStack&, regions: mutable RegionStack&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> EmitStatus can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            scrutinee_type: ValueType = resolve_type(match_scrutinee, ValueType{kind: TypeKind.Signed, bits: 64}, local_scope, fns, structs, generics)
            penum_scrutinee: bool = scrutinee_type.kind == TypeKind.PayloadEnum
            packed_scrutinee: bool = scrutinee_type.kind == TypeKind.PackedEnum
            cstr_scrutinee: bool = scrutinee_type.kind == TypeKind.CStr
            sview_scrutinee: bool = scrutinee_type.kind == TypeKind.SView
            EmitStatus.Declined return if result_types.count == 0 or result_types.count != var_names.count
            mis_type_unmodeled: mutable bool = false
            for mis_type_probe in result_types |mis_type_unmodeled|:
                mis_type_unmodeled <- true if mis_type_probe.kind == TypeKind.Unmodeled
            EmitStatus.Declined return if mis_type_unmodeled
            # A multi-column `when` in VALUE position — `return when a, b:` and `x = when a, b:`,
            # which is every spelling that occurs in practice (the compiler's own sources use
            # `return when …` exclusively). Same first-wins chain as the statement form in
            # codegen_stmt_match_tuple.elisa; the difference is only that each row yields into
            # the result slots instead of running statements. See that file for the lowering.
            if match_scrutinee is Expr.Tuple(mwt_elements, mwt_tuple_line):
                EmitStatus.Declined return if mwt_elements.count < 2 or match_arms.count < 1
                mwt_values: mutable darray[LLVMValueRef] = []
                mwt_types: mutable darray[ValueType] = []
                mwt_compare_types: mutable darray[LLVMTypeRef] = []
                mwt_column_failed: mutable bool = false
                for mwt_element in mwt_elements |mwt_column_failed, mwt_values, mwt_types, mwt_compare_types, local_scope, fns, structs, generics, runtime, m, ctx, builder|:
                    continue if mwt_column_failed
                    mwt_element_type: ValueType = resolve_type(mwt_element, ValueType{kind: TypeKind.Signed, bits: 64}, local_scope, fns, structs, generics)
                    if not is_integer_type(mwt_element_type) and mwt_element_type.kind != TypeKind.Bool and mwt_element_type.kind != TypeKind.CStr and mwt_element_type.kind != TypeKind.SView:
                        mwt_column_failed <- true
                        continue
                    if emit_expression(mwt_element, mwt_element_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is mwt_element_value:
                        mwt_values.push(mwt_element_value)
                        mwt_compare_types.push(llvm_type_of(mwt_element_type, structs, ctx))
                        mwt_types.push(mwt_element_type)
                    else:
                        mwt_column_failed <- true
                EmitStatus.Declined return if mwt_column_failed
                mwt_function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                mwt_storage: mutable darray[u8] = []
                mwt_slots: mutable darray[LLVMValueRef] = []
                for mwt_slot_index in 0..<result_types.count |mwt_slots, mwt_storage, result_types, var_names, structs, ctx, builder|:
                    mwt_slots.push(LLVMBuildAlloca(builder, llvm_type_of(result_types[mwt_slot_index], structs, ctx), sview_to_cstr(var_names[mwt_slot_index], mwt_storage)))
                mwt_done: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, mwt_function, "mwhen.done")
                mwt_declined: mutable bool = false
                mwt_saw_default: mutable bool = false
                for mwt_arm in match_arms |mwt_declined, mwt_saw_default, mwt_values, mwt_types, mwt_compare_types, mwt_slots, mwt_function, mwt_done, result_types, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder|:
                    continue if mwt_declined or mwt_saw_default
                    if arm_has_guard(mwt_arm.guard):
                        mwt_declined <- true
                        continue
                    mwt_arm_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, mwt_function, "mwhen.row")
                    if is_catch_all_pattern(mwt_arm.pattern):
                        _ = LLVMBuildBr(builder, mwt_arm_block)
                        LLVMPositionBuilderAtEnd(builder, mwt_arm_block)
                        mwt_declined <- true if not emit_arm_body_into_slot(mwt_arm.body, result_types, mwt_slots, mwt_done, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)
                        mwt_saw_default <- true if not mwt_declined
                        continue
                    mwt_columns: mutable darray[Pattern] = []
                    if not when_row_columns(mwt_arm.pattern, mwt_columns):
                        mwt_declined <- true
                        continue
                    if mwt_columns.count != mwt_values.count:
                        mwt_declined <- true
                        continue
                    mwt_next: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, mwt_function, "mwhen.next")
                    if emit_when_row_hit(mwt_columns, mwt_values, mwt_types, mwt_compare_types, structs, runtime, ctx, builder) is mwt_hit:
                        _ = LLVMBuildCondBr(builder, mwt_hit, mwt_arm_block, mwt_next)
                        LLVMPositionBuilderAtEnd(builder, mwt_arm_block)
                        mwt_declined <- true if not emit_arm_body_into_slot(mwt_arm.body, result_types, mwt_slots, mwt_done, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)
                        LLVMPositionBuilderAtEnd(builder, mwt_next)
                    else:
                        mwt_declined <- true
                EmitStatus.Declined return if mwt_declined
                # Without a `_` row the fall-through leaves the slots at their alloca'd value.
                # stage0's R2 totality check owns "a table must cover its columns", so this tail
                # is unreachable in a program that got this far.
                if not mwt_saw_default:
                    _ = LLVMBuildBr(builder, mwt_done)
                LLVMPositionBuilderAtEnd(builder, mwt_done)
                for mwt_declare in 0..<result_types.count |local_scope, mwt_slots, result_types, var_names|:
                    declare_local(local_scope, var_names[mwt_declare], mwt_slots[mwt_declare], result_types[mwt_declare])
                return EmitStatus.Open
            # `x: T = match p: Point{x, y}: EXPR / _: EXPR` — a plain STRUCT destructure in
            # VALUE position. Mirrors the statement emitter's struct-pattern arm
            # (codegen_stmt_match.elisa) and the `is`-condition struct narrowing
            # (codegen_expr_idents_binary.elisa): a struct pattern has no discriminant (the
            # scrutinee's STATIC type already names the struct), so the struct arm is
            # unconditionally taken. CONFIRMED against stage0's own `-emit llvm -O0` output:
            # unconditional per-field extractvalue/store into the bound names, then the arm
            # body; the fallback `_` arm's own block is emitted but is dead code ("No
            # predecessors!") — it is only there because value-position match must be
            # exhaustive (stage0 rejects a struct match with no trailing `_`). Since that arm
            # never actually runs, this emitter does not bother replicating its dead block —
            # only its PRESENCE is required, to keep the shape restricted to what was verified.
            #
            # SOUND SUBSET, same restriction as the two sibling fixes: exactly two arms
            # (Struct then a catch-all), and only Binding/Wildcard inner field patterns —
            # a literal or nested sub-pattern field declines, as does any extra arm between
            # them (no example of either shape exists in the corpus to verify against).
            if scrutinee_type.kind == TypeKind.Struct and match_arms.count == 2:
                # `Point{x, y} as whole: …` — same struct destructure, plus the whole matched
                # value bound to `whole` (docs/122 §5.4 as-binding). The parser only ever wraps
                # a Variant or Struct pattern in `Pattern.As`, so unwrapping it here and falling
                # through to the identical Struct handling — with one extra bind — covers the
                # struct case with no new dispatch shape.
                mss_as_name: mutable sview = ""
                mss_pattern: mutable Pattern = match_arms[0].pattern
                if match_arms[0].pattern is Pattern.As(mss_as_outer_name, mss_as_inner):
                    if mss_as_inner.count == 1 and mss_as_inner[0] is Pattern.Struct(_, _):
                        mss_as_name <- mss_as_outer_name
                        mss_pattern <- mss_as_inner[0]
                if mss_pattern is Pattern.Struct(mss_path, mss_fields):
                    if not arm_has_guard(match_arms[0].guard) and is_catch_all_pattern(match_arms[1].pattern) and not arm_has_guard(match_arms[1].guard):
                        mss_slot: i64 = struct_index_of(structs, mss_path)
                        if mss_slot >= 0 and mss_slot.u32() == scrutinee_type.bits:
                            mss_declined: mutable bool = false
                            mss_positions: mutable darray[i64] = []
                            mss_names: mutable darray[sview] = []
                            for mss_field in mss_fields |mss_declined, mss_positions, mss_names, mss_slot, structs|:
                                if mss_field is Pattern.Field(mss_selector, mss_inner):
                                    # A Wildcard field is decided BEFORE any by-name lookup —
                                    # its selector is the literal text "_", not a real field
                                    # name (see the statement emitter's identical note).
                                    if mss_inner.count == 1 and mss_inner[0] is Pattern.Wildcard:
                                        pass
                                    else:
                                        mss_position: i64 = field_index_of(structs, mss_slot.usize(), mss_selector)
                                        if mss_position < 0 or mss_inner.count != 1:
                                            mss_declined <- true
                                        elif mss_inner[0] is Pattern.Binding(mss_bind_name):
                                            mss_positions.push(mss_position)
                                            mss_names.push(mss_bind_name)
                                        else:
                                            mss_declined <- true
                                else:
                                    mss_declined <- true
                            if not mss_declined:
                                if emit_expression(match_scrutinee, scrutinee_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is mss_struct_value:
                                    mss_function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                                    mss_storage: mutable darray[u8] = []
                                    mss_slots: mutable darray[LLVMValueRef] = []
                                    for mss_n in 0..<result_types.count |mss_slots, mss_storage, result_types, var_names, structs, ctx, builder|:
                                        mss_slots.push(LLVMBuildAlloca(builder, llvm_type_of(result_types[mss_n], structs, ctx), sview_to_cstr(var_names[mss_n], mss_storage)))
                                    for mss_bind_index in 0..<mss_positions.count |mss_positions, mss_names, mss_struct_value, mss_slot, structs, local_scope, ctx, builder|:
                                        mss_field_type: ValueType = structs.field_types[structs.field_start[mss_slot.usize()] + mss_positions[mss_bind_index].usize()]
                                        mss_field_value: LLVMValueRef = LLVMBuildExtractValue(builder, mss_struct_value, mss_positions[mss_bind_index].u32(), "mss.struct.field")
                                        mss_bind_slot: LLVMValueRef = LLVMBuildAlloca(builder, llvm_type_of(mss_field_type, structs, ctx), "mss.struct.bind")
                                        _ = LLVMBuildStore(builder, mss_field_value, mss_bind_slot)
                                        declare_local(local_scope, mss_names[mss_bind_index], mss_bind_slot, mss_field_type)
                                    if mss_as_name != "":
                                        mss_whole_slot: LLVMValueRef = LLVMBuildAlloca(builder, llvm_type_of(scrutinee_type, structs, ctx), "mss.struct.whole")
                                        _ = LLVMBuildStore(builder, mss_struct_value, mss_whole_slot)
                                        declare_local(local_scope, mss_as_name, mss_whole_slot, scrutinee_type)
                                    mss_done: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, mss_function, "mss.done")
                                    EmitStatus.Declined return if not emit_arm_body_into_slot(match_arms[0].body, result_types, mss_slots, mss_done, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)
                                    LLVMPositionBuilderAtEnd(builder, mss_done)
                                    for mss_declare in 0..<result_types.count |local_scope, mss_slots, result_types, var_names|:
                                        declare_local(local_scope, var_names[mss_declare], mss_slots[mss_declare], result_types[mss_declare])
                                    return EmitStatus.Open
                                return EmitStatus.Declined

            # `x: T = match OPT: v: EXPR / _: …` — an OPTIONAL scrutinee in VALUE position.
            #
            # A BINDING arm over an optional is a CATCH-ALL: stage0 takes it even when the
            # optional is ABSENT, and the `_` arm is dead. PROBED against stage0:
            #     match pick(n): { v: 5, _: 9 }   -> 5 for an ABSENT optional
            # so there is NO present/absent split here — bind the payload unconditionally and
            # emit the binding arm's body. Mirroring the STATEMENT emitter's tag branch instead
            # is wrong; it routes the absent case to `_`, which stage0 never takes.
            #
            # The payload of an ABSENT optional is UNDEF in stage0, not a defined zero
            # (`v: v + 1` yields 0 there because undef+1 folds to undef, while `v: 5` yields 5).
            # Reading it is undefined behaviour, so it is not a parity-testable path — the
            # frontend proves the name is only read where the tag matches.
            mis_opt_type: ValueType = expression_type(match_scrutinee, local_scope, fns, structs, generics)
            if mis_opt_type.kind == TypeKind.Optional:
                mis_opt_payload: ValueType = optional_payload_of(mis_opt_type, structs)
                EmitStatus.Declined return if mis_opt_payload.kind == TypeKind.Unmodeled
                mis_opt_bind_index: mutable i64 = -1
                mis_opt_bind_name: mutable sview = ""
                for mis_opt_i in 0..<match_arms.count |mis_opt_bind_index, mis_opt_bind_name, match_arms|:
                    if match_arms[mis_opt_i].pattern is Pattern.Binding(mis_opt_pat_name):
                        if mis_opt_bind_index < 0:
                            mis_opt_bind_index <- mis_opt_i.i64()
                            mis_opt_bind_name <- mis_opt_pat_name
                EmitStatus.Declined return if mis_opt_bind_index < 0
                EmitStatus.Declined return if not (match_arms[mis_opt_bind_index.usize()].guard is Expr.Absent)
                if emit_expression(match_scrutinee, mis_opt_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is mis_opt_value:
                    mis_opt_payload_value: LLVMValueRef = optional_payload_value_of(mis_opt_value, mis_opt_type, structs, ctx, builder)
                    mis_opt_function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                    mis_opt_storage: mutable darray[u8] = []
                    mis_opt_slots: mutable darray[LLVMValueRef] = []
                    for mis_opt_n in 0..<result_types.count |mis_opt_slots, mis_opt_storage, result_types, var_names, structs, ctx, builder|:
                        mis_opt_slots.push(LLVMBuildAlloca(builder, llvm_type_of(result_types[mis_opt_n], structs, ctx), sview_to_cstr(var_names[mis_opt_n], mis_opt_storage)))
                    mis_opt_done: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, mis_opt_function, "mis.opt.done")
                    mis_opt_bind_storage: mutable darray[u8] = []
                    mis_opt_bind_slot: LLVMValueRef = LLVMBuildAlloca(builder, llvm_type_of(mis_opt_payload, structs, ctx), sview_to_cstr(mis_opt_bind_name, mis_opt_bind_storage))
                    _ = LLVMBuildStore(builder, mis_opt_payload_value, mis_opt_bind_slot)
                    declare_local(local_scope, mis_opt_bind_name, mis_opt_bind_slot, mis_opt_payload)
                    EmitStatus.Declined return if not emit_arm_body_into_slot(match_arms[mis_opt_bind_index.usize()].body, result_types, mis_opt_slots, mis_opt_done, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)
                    LLVMPositionBuilderAtEnd(builder, mis_opt_done)
                    for mis_opt_d in 0..<result_types.count |local_scope, mis_opt_slots, result_types, var_names|:
                        declare_local(local_scope, var_names[mis_opt_d], mis_opt_slots[mis_opt_d], result_types[mis_opt_d])
                    return EmitStatus.Open
                return EmitStatus.Declined
            # `x: T = match p: Point{x, y}: … _: …` — a plain STRUCT destructure arm in VALUE
            # position. Mirrors the statement-position fix in codegen_stmt_match.elisa: a struct
            # pattern has no discriminant (the scrutinee's static type already proves the match),
            # so the FIRST arm wins unconditionally and later arms (the required `_` fallback —
            # stage0 rejects a struct match with no `_` arm as "non-exhaustive") are never
            # reached. stage0's own `-emit llvm` output for this shape still EMITS the fallback's
            # dead code (an unreachable block, since -O0 runs no DCE); skipping it here instead
            # produces the same runtime answer with less code, matching how the statement-position
            # fix already treats later arms as dead rather than replicating stage0's dead blocks.
            #
            # SOUND SUBSET, matching the statement-position fix exactly: only bare-Ident (fresh
            # binding) or Wildcard (skip) fields are modeled; anything else falls through to the
            # ordinary dispatch below, which declines it.
            mvs_as_name: mutable sview = ""
            mvs_pattern: mutable Pattern = match_arms[0].pattern if match_arms.count >= 1 else Pattern.Wildcard
            if match_arms.count >= 1 and match_arms[0].pattern is Pattern.As(mvs_as_outer_name, mvs_as_inner):
                if mvs_as_inner.count == 1 and mvs_as_inner[0] is Pattern.Struct(_, _):
                    mvs_as_name <- mvs_as_outer_name
                    mvs_pattern <- mvs_as_inner[0]
            if match_arms.count >= 1 and mvs_pattern is Pattern.Struct(mvs_path, mvs_fields) and not arm_has_guard(match_arms[0].guard):
                mvs_slot: i64 = struct_index_of(structs, mvs_path)
                if mvs_slot >= 0 and scrutinee_type.kind == TypeKind.Struct and scrutinee_type.bits == mvs_slot.u32():
                    mvs_declined: mutable bool = false
                    mvs_positions: mutable darray[i64] = []
                    mvs_names: mutable darray[sview] = []
                    for mvs_field in mvs_fields |mvs_declined, mvs_positions, mvs_names, mvs_slot, structs|:
                        if mvs_field is Pattern.Field(mvs_selector, mvs_inner):
                            if mvs_inner.count == 1 and mvs_inner[0] is Pattern.Wildcard:
                                pass
                            else:
                                mvs_position: i64 = field_index_of(structs, mvs_slot.usize(), mvs_selector)
                                if mvs_position < 0 or mvs_inner.count != 1:
                                    mvs_declined <- true
                                elif mvs_inner[0] is Pattern.Binding(mvs_bind_name):
                                    mvs_positions.push(mvs_position)
                                    mvs_names.push(mvs_bind_name)
                                else:
                                    mvs_declined <- true
                        else:
                            mvs_declined <- true
                    if not mvs_declined:
                        if emit_expression(match_scrutinee, scrutinee_type, local_scope, fns, structs, generics, runtime, m, ctx, builder) is mvs_struct_value:
                            for mvs_bind_index in 0..<mvs_positions.count |mvs_positions, mvs_names, mvs_struct_value, mvs_slot, structs, local_scope, ctx, builder|:
                                mvs_field_type: ValueType = structs.field_types[structs.field_start[mvs_slot.usize()] + mvs_positions[mvs_bind_index].usize()]
                                mvs_field_value: LLVMValueRef = LLVMBuildExtractValue(builder, mvs_struct_value, mvs_positions[mvs_bind_index].u32(), "match.struct.field")
                                mvs_bind_slot: LLVMValueRef = LLVMBuildAlloca(builder, llvm_type_of(mvs_field_type, structs, ctx), "match.struct.bind")
                                _ = LLVMBuildStore(builder, mvs_field_value, mvs_bind_slot)
                                declare_local(local_scope, mvs_names[mvs_bind_index], mvs_bind_slot, mvs_field_type)
                            if mvs_as_name != "":
                                mvs_whole_slot: LLVMValueRef = LLVMBuildAlloca(builder, llvm_type_of(scrutinee_type, structs, ctx), "match.struct.whole")
                                _ = LLVMBuildStore(builder, mvs_struct_value, mvs_whole_slot)
                                declare_local(local_scope, mvs_as_name, mvs_whole_slot, scrutinee_type)
                            mvs_function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(builder))
                            mvs_storage: mutable darray[u8] = []
                            mvs_slots: mutable darray[LLVMValueRef] = []
                            for mvs_slot_index in 0..<result_types.count |mvs_slots, mvs_storage, result_types, var_names, structs, ctx, builder|:
                                mvs_slots.push(LLVMBuildAlloca(builder, llvm_type_of(result_types[mvs_slot_index], structs, ctx), sview_to_cstr(var_names[mvs_slot_index], mvs_storage)))
                            mvs_done: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, mvs_function, "match.struct.done")
                            EmitStatus.Declined return if not emit_arm_body_into_slot(match_arms[0].body, result_types, mvs_slots, mvs_done, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)
                            LLVMPositionBuilderAtEnd(builder, mvs_done)
                            for mvs_d in 0..<result_types.count |local_scope, mvs_slots, result_types, var_names|:
                                declare_local(local_scope, var_names[mvs_d], mvs_slots[mvs_d], result_types[mvs_d])
                            return EmitStatus.Open
            return emit_match_into_slot_scalar(match_scrutinee, match_arms, result_types, var_names, return_type, local_scope, loops, regions, fns, structs, generics, runtime, m, ctx, builder)

include "./codegen_match_scalar_slot.elisa"
