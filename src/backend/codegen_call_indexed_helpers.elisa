extend Backend:
    private:
        def emit_direct_call_indexed[@scope_region, @fns_region, @structs_region, @generics_region, @runtime_region](fn_index: i64, receiver: Expr, has_receiver: bool, arguments: darray[Expr]&, argument_names: darray[sview @source]&, local_scope: mutable Scope& @scope_region, fns: FnTable& @fns_region, structs: mutable StructTable& @structs_region, generics: mutable GenericTable& @generics_region, runtime: Runtime& @runtime_region, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef, sret_destination: LLVMValueRef?) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            return emit_direct_call_indexed_result(fn_index, receiver, has_receiver, arguments, argument_names, local_scope, fns, structs, generics, runtime, m, ctx, builder, sret_destination, null) can Global{Read,Write}


        def emit_direct_call_indexed_as_error_union[@scope_region, @fns_region, @structs_region, @generics_region, @runtime_region](fn_index: i64, arguments: darray[Expr]&, argument_names: darray[sview @source]&, expected: ValueType, local_scope: mutable Scope& @scope_region, fns: FnTable& @fns_region, structs: mutable StructTable& @structs_region, generics: mutable GenericTable& @generics_region, runtime: Runtime& @runtime_region, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> LLVMValueRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            return emit_direct_call_indexed_result(fn_index, Expr.Absent, false, arguments, argument_names, local_scope, fns, structs, generics, runtime, m, ctx, builder, null, expected) can Global{Read,Write}


        def resource_return_kind_of(fns: FnTable&, name: sview) -> u32 can[Abort.Panic]:
            for index in 0..<fns.resource_return_names.count:
                return fns.resource_return_kinds[index] if fns.resource_return_names[index] == name
            return 0

        # The plan row of a C-ABI extern by name, or -1.
        def c_plan_index_of(fns: FnTable&, name: sview) -> i64 can[Abort.Panic]:
            for index in 0..<fns.c_plan_names.count:
                return index.i64() if fns.c_plan_names[index] == name
            return -1

        # The C position of an Elisa parameter's whole value (or its pointer, for a split
        # view) under plan `c_plan`; the parameter's own index when there is no plan.
        def c_plan_position_of(fns: FnTable&, c_plan: i64, param_index: usize) -> usize can[Abort.Panic]:
            return param_index if c_plan < 0
            for code_index in 0..<fns.c_plan_count[c_plan.usize()]:
                code: u32 = fns.c_plan_codes[fns.c_plan_start[c_plan.usize()] + code_index]
                return code_index if (code / 8).usize() == param_index and code % 8 != 2
            return param_index


        # Direct-call twin for assignments whose destination is already an aggregate place. The
        # ordinary expression path must return a first-class value; this variant hands the field
        # slot to the callee's sret parameter so a large result never becomes an SSA aggregate.
        # 0 means that the call was not a recognized large aggregate call. -1 means that it
        # was recognized but argument lowering declined after emitting part of the call. That
        # distinction matters: callers must not fall back to ordinary expression lowering after
        # side effects have already been emitted, or the source call could execute twice.
        def emit_direct_call_into_sret(callee_owner: sview, callee_name: sview, receiver: Expr, has_receiver: bool, arguments: darray[Expr]&, argument_names: darray[sview @source]&, destination: LLVMValueRef, local_scope: mutable Scope&, fns: FnTable&, structs: mutable StructTable&, generics: mutable GenericTable&, runtime: Runtime&, m: LLVMModuleRef, ctx: LLVMContextRef, builder: LLVMBuilderRef) -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            return -1 if direct_call_has_untrusted_pool_lifetime_argument(receiver, has_receiver, arguments, local_scope, fns, structs, generics)
            return 0 if not direct_call_argument_names_are_well_formed(arguments, argument_names)
            fn_index: mutable i64 = -1
            if has_receiver:
                receiver_first: mutable darray[Expr] = [receiver]
                for ufcs_argument in arguments |receiver_first|:
                    receiver_first.push(ufcs_argument)
                receiver_names: mutable darray[sview] = [""]
                for explicit_position in 0..<arguments.count |receiver_names, explicit_position, argument_names, arguments|:
                    receiver_names.push(argument_names[explicit_position]) if argument_names.count == arguments.count
                    receiver_names.push("") if argument_names.count != arguments.count
                fn_index <- overload_index_for_call_args(fns, callee_owner, callee_name, receiver_first, receiver_names, local_scope, structs, generics)
                fn_index <- function_index_of_unique_call_shape(fns, callee_owner, callee_name, receiver_first, receiver_names) if fn_index < 0
            else:
                fn_index <- overload_index_for_call_args(fns, callee_owner, callee_name, arguments, argument_names, local_scope, structs, generics)
                fn_index <- function_index_of_unique_call_shape(fns, callee_owner, callee_name, arguments, argument_names) if fn_index < 0
            # Bare calls written inside a module are owned by that enclosing module even
            # though their AST callee is only an Ident. Mirror emit_call_named's lexical lookup
            # here; otherwise a large aggregate `updated <- writer_put_byte(...)` falls back to
            # a first-class sret load/store simply because the destination-aware resolver lost
            # the current owner.
            if fn_index < 0 and callee_owner == "" and structs.visibility.current_owner != "" and function_index_of(fns, "", callee_name) < 0:
                if has_receiver:
                    owner_receiver_first: mutable darray[Expr] = [receiver]
                    for owner_ufcs_argument in arguments |owner_receiver_first|:
                        owner_receiver_first.push(owner_ufcs_argument)
                    owner_receiver_names: mutable darray[sview] = [""]
                    for explicit_position in 0..<arguments.count |owner_receiver_names, explicit_position, argument_names, arguments|:
                        owner_receiver_names.push(argument_names[explicit_position]) if argument_names.count == arguments.count
                        owner_receiver_names.push("") if argument_names.count != arguments.count
                    fn_index <- overload_index_for_call_args(fns, structs.visibility.current_owner, callee_name, owner_receiver_first, owner_receiver_names, local_scope, structs, generics)
                    fn_index <- function_index_of_unique_call_shape(fns, structs.visibility.current_owner, callee_name, owner_receiver_first, owner_receiver_names) if fn_index < 0
                else:
                    fn_index <- overload_index_for_call_args(fns, structs.visibility.current_owner, callee_name, arguments, argument_names, local_scope, structs, generics)
                    fn_index <- function_index_of_unique_call_shape(fns, structs.visibility.current_owner, callee_name, arguments, argument_names) if fn_index < 0
            return 0 if:
                fn_index < 0
                fns.is_error[fn_index.usize()]
                not value_type_uses_sret(fns.returns[fn_index.usize()], structs, ctx)
            if (emit_direct_call_indexed(fn_index, receiver, has_receiver, arguments, argument_names, local_scope, fns, structs, generics, runtime, m, ctx, builder, destination) can Global{Read,Write}) is emitted_call:
                _ = emitted_call
                return 1
            return -1

include "./codegen_atomic.elisa"
include "./codegen_call_named.elisa"
include "./codegen_call_store.elisa"
include "./codegen_call_receiver.elisa"
