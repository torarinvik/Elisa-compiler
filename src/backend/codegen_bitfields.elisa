# Stage1 backend — `bitset:` / `bitfield:` groups: each member's bit offset and width, and the
# sub-byte integer type (`u4`, `i3`) that backs it.
# Part of `module Backend` (see codegen.elisa).

extend Backend:
    private:


        # Record every member of a `bitset:` / `bitfield:` group with its bit offset and width.
        # A bitset member is one bit; a bitfield member is as wide as its declared type, and
        # offsets accumulate in declaration order — the layout stage0 uses.
        # The backing integer a bit group needs: the SUM of its members' widths, not the COUNT
        # of members. Counting members is right for a bitset (one bit each) and wrong for a
        # bitfield -- `tag: u4, mode: Mode, active: u1` is 9 bits and needs an i16, while a
        # member count of 3 picks an i8 and silently drops the top of the group.
        #
        # The per-member width is computed exactly as `record_bit_group_members` does below;
        # the two must agree, or an offset would land outside the pack.
        def bit_group_pack_bits(member: Ast::StructMember&, structs: mutable StructTable&) -> u32 can[Abort.Panic, Memory.Allocate]:
            total: mutable u32 = 0
            for flag in member.bit_group_members |total, member, structs|:
                width: mutable u32 = 1
                if member.bit_group_kind == "bitfield":
                    declared: ValueType = annotation_value_type(flag.type_expression, structs)
                    width <- declared.bits if declared.bits > 0
                    if declared.kind == TypeKind.Unmodeled or declared.bits == 0:
                        match flag.type_expression:
                            Expr.Ident(flag_type_name, flag_type_line):
                                flag_enum: i64 = enum_index_of(structs, flag_type_name)
                                if flag_enum >= 0:
                                    width <- copied_type(structs.enum_backings[flag_enum.usize()]).bits
                                else:
                                    sub_byte: mutable u32 = 0
                                    if sview_len(flag_type_name) >= 2 and sview_at(flag_type_name, 0) == 117:
                                        scan: mutable usize = 1
                                        parsed_ok: mutable bool = true
                                        while scan < sview_len(flag_type_name) |scan, sub_byte, parsed_ok, flag_type_name|:
                                            digit: u8 = sview_at(flag_type_name, scan)
                                            if digit < 48 or digit > 57:
                                                parsed_ok <- false
                                            else:
                                                sub_byte <- sub_byte * 10 + (digit - 48).u32()
                                            scan <- scan + 1
                                        sub_byte <- 0 if not parsed_ok
                                    width <- sub_byte if sub_byte > 0 and sub_byte <= 64
                            _:
                                pass
                total <- total + width
            return 8 if total <= 8 else (16 if total <= 16 else (32 if total <= 32 else 64))




        # `u4` / `i3` — a SUB-BYTE integer type NAME as an Unsigned/Signed of that width.
        # Used ONLY for a const enum's backing: modeling these as general type names would let
        # stage1 accept a `u4` PARAMETER, which stage0 rejects ("unsupported semantic type
        # *semantic.BitIntType"). Unmodeled for anything that is not `uN`/`iN`, 1 <= N < 8.
        def sub_byte_backing_type(name: sview) -> ValueType can[Abort.Panic]:
            unmodeled_type() return if sview_len(name) < 2.usize()
            head: u8 = sview_at(name, 0)
            unmodeled_type() return if head != 117 and head != 105
            width: mutable u32 = 0
            digits_ok: mutable bool = true
            for scan in 1..<sview_len(name) |width, digits_ok, name|:
                digit: u8 = sview_at(name, scan)
                if digit < 48 or digit > 57:
                    digits_ok <- false
                else:
                    width <- width * 10 + (digit - 48).u32()
            unmodeled_type() return if not digits_ok or width == 0 or width >= 8
            return ValueType{kind: TypeKind.Unsigned, bits: width} if head == 117 else ValueType{kind: TypeKind.Signed, bits: width}




        def record_bit_group_members(owner_slot: usize, field_name: sview, member: Ast::StructMember&, structs: mutable StructTable&) -> void can[Abort.Panic, Memory.Allocate]:
            offset: mutable u32 = 0
            for flag in member.bit_group_members |offset, owner_slot, field_name, structs|:
                width: mutable u32 = 1
                if member.bit_group_kind == "bitfield":
                    declared: ValueType = annotation_value_type(flag.type_expression, structs)
                    width <- declared.bits if declared.bits > 0
                    # A bitfield member is routinely a SUB-BYTE type (`tag: u4`, `active: u1`)
                    # that the scalar resolver does not model, or a CONST ENUM whose width is
                    # its backing type (`mode: Mode` where `Mode` is `const enum … of u4`).
                    # Falling back to one bit silently packs `tag` into a single bit, so the
                    # width is read off the declared NAME instead.
                    if declared.kind == TypeKind.Unmodeled or declared.bits == 0:
                        match flag.type_expression:
                            Expr.Ident(flag_type_name, flag_type_line):
                                flag_enum: i64 = enum_index_of(structs, flag_type_name)
                                if flag_enum >= 0:
                                    width <- copied_type(structs.enum_backings[flag_enum.usize()]).bits
                                else:
                                    sub_byte: mutable u32 = 0
                                    if sview_len(flag_type_name) >= 2 and sview_at(flag_type_name, 0) == 117:
                                        scan: mutable usize = 1
                                        parsed_ok: mutable bool = true
                                        while scan < sview_len(flag_type_name) |scan, sub_byte, parsed_ok, flag_type_name|:
                                            digit: u8 = sview_at(flag_type_name, scan)
                                            if digit < 48 or digit > 57:
                                                parsed_ok <- false
                                            else:
                                                sub_byte <- sub_byte * 10 + (digit - 48).u32()
                                            scan <- scan + 1
                                        sub_byte <- 0 if not parsed_ok
                                    width <- sub_byte if sub_byte > 0 and sub_byte <= 64
                            _:
                                pass
                structs.bitgroup_owners <- structs.bitgroup_owners.push(owner_slot.u32())
                structs.bitgroup_fields <- structs.bitgroup_fields.push(field_name)
                structs.bitgroup_members <- structs.bitgroup_members.push(flag.name)
                structs.bitgroup_offsets <- structs.bitgroup_offsets.push(offset)
                structs.bitgroup_widths <- structs.bitgroup_widths.push(width)
                structs.bitgroup_is_flag <- structs.bitgroup_is_flag.push(member.bit_group_kind == "bitset")
                offset <- offset + width




        # The row for `OWNER.field.member`, or -1.
        def bit_group_member_index(structs: StructTable&, owner_slot: usize, field_name: sview, member_name: sview) -> i64 can[Abort.Panic]:
            for probe in 0..<structs.bitgroup_members.count:
                continue if structs.bitgroup_owners[probe] != owner_slot.u32()
                continue if structs.bitgroup_fields[probe] != field_name
                probe.i64() return if structs.bitgroup_members[probe] == member_name
            return -1




        # True when `struct NAME layout(soa)` declared a column-major aggregate.
        def struct_declares_soa_layout(structs: StructTable&, name: sview) -> bool can[Abort.Panic]:
            for probe in 0..<structs.soa_layout_owners.count:
                true return if structs.soa_layout_owners[probe] == name
            return false



        # True when `struct NAME layout(packed)` requests byte-packed LLVM
        # storage. This applies to ordinary structs, not packed enums.
        def struct_declares_packed_layout(structs: StructTable&, name: sview) -> bool can[Abort.Panic]:
            for probe in 0..<structs.packed_layout_owners.count:
                true return if structs.packed_layout_owners[probe] == name
            return false




        # True when `struct NAME[?]` declared a TYPESTATE header. The parser records the
        # marker; only these structs may have a state bracket erased.
        def struct_declares_aggregate_state(structs: StructTable&, name: sview) -> bool can[Abort.Panic]:
            for probe in 0..<structs.aggregate_state_owners.count:
                true return if structs.aggregate_state_owners[probe] == name
            return false
