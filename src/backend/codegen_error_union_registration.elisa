extend Backend:
    private:
        # Return the canonical error-set owner only when Core's visible lookup selects an
        # error set. A same-name struct/enum ahead of an import leaves the variant fallback
        # available, while imported families retain the module that declared them.
        def error_union_error_set_declared_at(file: Ast::File&, family: sview @source, lexical_module: sview @source, before_offset: u32) -> (found: bool, module: sview @source, family: sview @source) can[Abort.Panic, Memory.Allocate]:
            candidate: (found: bool, is_error_set: bool, module: sview @source, family: sview @source) = error_union_visible_type_candidate_at(file, family, lexical_module, before_offset) can Global{Read,Write}
            return (true, candidate.module, candidate.family) if candidate.found and candidate.is_error_set
            return (false, "", "")


        def error_union_error_set_has_variant(structs: StructTable&, family: sview, module: sview, variant: sview) -> bool can[Abort.Panic]:
            payload_index: i64 = penum_index_of_owned(structs, module, family)
            if payload_index >= 0:
                start: usize = structs.payload_enums.penum_variant_start[payload_index.usize()]
                count: usize = structs.payload_enums.penum_variant_count[payload_index.usize()]
                for offset in 0..<count |start, structs, variant|:
                    slot: usize = start + offset
                    return true if structs.payload_enums.penum_variants[slot] == variant and slot < structs.payload_enums.penum_variant_owners.count and structs.payload_enums.penum_variant_owners[slot] == family and slot < structs.payload_enums.penum_variant_modules.count and structs.payload_enums.penum_variant_modules[slot] == module
            enum_index: i64 = enum_index_of_owned(structs, module, family)
            if enum_index >= 0:
                start: usize = structs.const_enums.enum_variant_start[enum_index.usize()]
                count: usize = structs.const_enums.enum_variant_count[enum_index.usize()]
                for offset in 0..<count |start, structs, variant|:
                    return true if structs.const_enums.enum_variants[start + offset] == variant
            return false


        # Return a declared error-set owner only when the short variant is unique across
        # the error sets represented in this compilation unit. Ordinary enum members are
        # deliberately excluded by walking __error_set_decl rows first.
        def error_union_unique_bare_variant_owner(file: Ast::File&, variant: sview, structs: StructTable&) -> (count: usize, family: sview @source, module: sview @source) can[Abort.Panic]:
            count: mutable usize = 0
            selected_family: mutable sview @source = ""
            selected_module: mutable sview @source = ""
            for declaration_index in 0..<file.enum_annotations.count |count, selected_family, selected_module, declaration_index, file, variant, structs|:
                declaration: Ast::EnumAnnotation = file.enum_annotations[declaration_index]
                continue if declaration.owner != "__error_set_decl"
                duplicate: mutable bool = false
                for prior_index in 0..<declaration_index |duplicate, prior_index, file, declaration|:
                    prior: Ast::EnumAnnotation = file.enum_annotations[prior_index]
                    duplicate <- true if prior.owner == "__error_set_decl" and prior.name == declaration.name and prior.module == declaration.module
                continue if duplicate
                continue if not error_union_error_set_has_variant(structs, declaration.name, declaration.module, variant)
                count <- count + 1.usize()
                if count == 1.usize():
                    selected_family <- declaration.name
                    selected_module <- declaration.module
            return (count, selected_family, selected_module)


        def error_union_family_occurrence(file: Ast::File&, family_row_index: usize, declaration_module: sview @source, structs: StructTable&) -> ErrorUnionFamilyOccurrence can[Abort.Panic, Memory.Allocate]:
            family_row: Ast::EnumAnnotation = file.enum_annotations[family_row_index]
            family_path: mutable sview @source = family_row.name
            family_order_key: mutable sview @source = family_row.family_order_key
            variant_override: mutable sview @source = ""
            found_family_path: mutable bool = false
            if family_row_index + 1.usize() < file.enum_annotations.count:
                path_row: Ast::EnumAnnotation = file.enum_annotations[family_row_index + 1.usize()]
                if path_row.owner == "__error_set_family_path" and path_row.line == family_row.line and path_row.offset == family_row.offset and path_row.identity_id == family_row.identity_id and path_row.occurrence_offset == family_row.occurrence_offset:
                    family_path <- path_row.name
                    family_order_key <- path_row.name if family_order_key == ""
                    found_family_path <- true
            return ErrorUnionFamilyOccurrence{annotation_index: family_row_index, family: family_row.name, family_path: family_path, family_order_key: family_order_key, module: declaration_module, variant_override: variant_override, error_set_parameter: false, qualified: true, resolved: false} if not found_family_path
            path_info: (valid: bool, qualified: bool, module_end: usize) = error_union_family_path_info(family_path, family_row.name)
            if not path_info.valid:
                return ErrorUnionFamilyOccurrence{annotation_index: family_row_index, family: family_row.name, family_path: family_path, family_order_key: family_order_key, module: declaration_module, variant_override: variant_override, error_set_parameter: false, qualified: true, resolved: false}
            if not path_info.qualified:
                if error_union_error_set_param_shadows_family(file, family_row):
                    return ErrorUnionFamilyOccurrence{annotation_index: family_row_index, family: family_row.name, family_path: family_path, family_order_key: family_order_key, module: declaration_module, variant_override: "", error_set_parameter: true, qualified: false, resolved: true}
                visible_family: (found: bool, module: sview @source, family: sview @source) = error_union_error_set_declared_at(file, family_row.name, declaration_module, family_row.offset) can Global{Read,Write}
                if visible_family.found:
                    order_key: sview @source = error_union_error_set_order_key(visible_family.module, visible_family.family) can Global{Read,Write}
                    return ErrorUnionFamilyOccurrence{annotation_index: family_row_index, family: visible_family.family, family_path: family_path, family_order_key: order_key, module: visible_family.module, variant_override: "", error_set_parameter: false, qualified: false, resolved: true}
                variant_owner: (count: usize, family: sview @source, module: sview @source) = error_union_unique_bare_variant_owner(file, family_row.name, structs)
                if variant_owner.count == 1.usize():
                    order_key: sview @source = error_union_error_set_order_key(variant_owner.module, variant_owner.family) can Global{Read,Write}
                    return ErrorUnionFamilyOccurrence{annotation_index: family_row_index, family: variant_owner.family, family_path: family_path, family_order_key: order_key, module: variant_owner.module, variant_override: family_row.name, error_set_parameter: false, qualified: false, resolved: true}
                return ErrorUnionFamilyOccurrence{annotation_index: family_row_index, family: family_row.name, family_path: family_path, family_order_key: family_order_key, module: declaration_module, variant_override: variant_override, error_set_parameter: false, qualified: false, resolved: true}
            qualified_alias: (found: bool, is_error_set: bool, module: sview @source, family: sview @source, rank: i64) = error_union_alias_candidate_for_family_path(file, file.top_decls, family_row.name, family_path, path_info.module_end, declaration_module, family_row.offset, "") can Global{Read,Write}
            if qualified_alias.found:
                if qualified_alias.is_error_set:
                    alias_order_key: sview @source = error_union_error_set_order_key(qualified_alias.module, qualified_alias.family) can Global{Read,Write}
                    return ErrorUnionFamilyOccurrence{annotation_index: family_row_index, family: qualified_alias.family, family_path: family_path, family_order_key: alias_order_key, module: qualified_alias.module, variant_override: "", error_set_parameter: false, qualified: true, resolved: true}
                return ErrorUnionFamilyOccurrence{annotation_index: family_row_index, family: family_row.name, family_path: family_path, family_order_key: family_order_key, module: qualified_alias.module, variant_override: "", error_set_parameter: false, qualified: true, resolved: false}
            best_module: mutable sview @source = ""
            best_rank: mutable i64 = -1
            for index in 0..<file.payload_enum_names.count |best_module, best_rank, structs, family_row, family_path, path_info, declaration_module, file|:
                continue if file.payload_enum_names[index] != family_row.name or index >= file.payload_enum_owners.count
                candidate_owner: sview @source = file.payload_enum_owners[index]
                continue if penum_index_of_owned(structs, candidate_owner, family_row.name) < 0
                rank: i64 = error_union_family_path_rank(candidate_owner, family_path, path_info.module_end, declaration_module, family_row.offset, file)
                if rank > best_rank:
                    best_module <- candidate_owner
                    best_rank <- rank
            for index in 0..<file.enum_decl_names.count |best_module, best_rank, structs, family_row, family_path, path_info, declaration_module, file|:
                continue if file.enum_decl_names[index] != family_row.name or index >= file.enum_decl_owners.count
                candidate_owner: sview @source = file.enum_decl_owners[index]
                continue if enum_index_of_owned(structs, candidate_owner, family_row.name) < 0
                rank: i64 = error_union_family_path_rank(candidate_owner, family_path, path_info.module_end, declaration_module, family_row.offset, file)
                if rank > best_rank:
                    best_module <- candidate_owner
                    best_rank <- rank
            return ErrorUnionFamilyOccurrence{annotation_index: family_row_index, family: family_row.name, family_path: family_path, family_order_key: family_order_key, module: best_module, variant_override: variant_override, error_set_parameter: false, qualified: true, resolved: best_rank >= 0}




        # Repeated subset spellings can refer to one declaration. Compare the resolved
        # declaration owner so aliases and unqualified references coalesce with its
        # qualified spelling, while same-leaf families from different modules stay apart.
        def error_union_family_occurrence_same_declaration(left: ErrorUnionFamilyOccurrence, right: ErrorUnionFamilyOccurrence, structs: mutable StructTable&) -> bool can[Abort.Panic]:
            return false if left.error_set_parameter or right.error_set_parameter
            return false if left.family != right.family
            left_payload: mutable i64 = penum_index_of_owned(structs, left.module, left.family)
            right_payload: mutable i64 = penum_index_of_owned(structs, right.module, right.family)
            left_payload <- penum_index_of(structs, left.family) if left_payload < 0 and not left.qualified
            right_payload <- penum_index_of(structs, right.family) if right_payload < 0 and not right.qualified
            if left_payload >= 0 or right_payload >= 0:
                return false if left_payload < 0 or right_payload < 0
                return penum_owner_at(structs, left_payload.usize()) == penum_owner_at(structs, right_payload.usize())
            left_plain: mutable i64 = enum_index_of_owned(structs, left.module, left.family)
            right_plain: mutable i64 = enum_index_of_owned(structs, right.module, right.family)
            left_plain <- enum_index_of(structs, left.family) if left_plain < 0 and not left.qualified
            right_plain <- enum_index_of(structs, right.family) if right_plain < 0 and not right.qualified
            if left_plain >= 0 or right_plain >= 0:
                return false if left_plain < 0 or right_plain < 0
                return enum_owner_at(structs, left_plain.usize()) == enum_owner_at(structs, right_plain.usize())
            return left.module == right.module and left.qualified == right.qualified


        def error_union_family_variant_allowed(file: Ast::File&, families: darray[ErrorUnionFamilyOccurrence], declaration: ErrorUnionFamilyOccurrence, variant: sview, structs: mutable StructTable&) -> bool can[Abort.Panic]:
            for index in 0..<families.count |index, file, families, declaration, variant, structs|:
                occurrence: ErrorUnionFamilyOccurrence = families[index]
                continue if not error_union_family_occurrence_same_declaration(declaration, occurrence, structs)
                return true if occurrence.variant_override != "" and occurrence.variant_override == variant
                continue if occurrence.variant_override != ""
                return true if error_union_variant_allowed(file, occurrence.annotation_index, variant)
            return false


        # A fieldless error declaration is stored in the ordinary enum table, not the
        # payload-enum table. Copy its selected variants into the combined row as zero-field
        # entries so they still receive their canonical union tag.
        def append_error_union_plain_family(file: Ast::File&, occurrence: ErrorUnionFamilyOccurrence, families: darray[ErrorUnionFamilyOccurrence], structs: mutable StructTable&) -> void can[Abort.Panic, Memory.Allocate]:
            return if occurrence.error_set_parameter
            return if occurrence.qualified and not occurrence.resolved
            enum_index: mutable i64 = enum_index_of_owned(structs, occurrence.module, occurrence.family)
            enum_index <- enum_index_of(structs, occurrence.family) if enum_index < 0 and not occurrence.qualified
            return if enum_index < 0
            enum_start: usize = structs.const_enums.enum_variant_start[enum_index.usize()]
            enum_count: usize = structs.const_enums.enum_variant_count[enum_index.usize()]
            for enum_offset in 0..<enum_count |enum_start, enum_index, structs, file, occurrence, families|:
                variant: sview = structs.const_enums.enum_variants[enum_start + enum_offset]
                continue if not error_union_family_variant_allowed(file, families, occurrence, variant, structs)
                structs.payload_enums.penum_variants <- structs.payload_enums.penum_variants.push(variant)
                structs.payload_enums.penum_variant_owners <- structs.payload_enums.penum_variant_owners.push(occurrence.family)
                structs.payload_enums.penum_variant_modules <- structs.payload_enums.penum_variant_modules.push(occurrence.module)
                structs.payload_enums.penum_payloads <- structs.payload_enums.penum_payloads.push(unmodeled_type())
                structs.payload_enums.penum_has_payload <- structs.payload_enums.penum_has_payload.push(false)
                structs.payload_enums.penum_field_names <- structs.payload_enums.penum_field_names.push("")
                structs.payload_enums.penum_field_type_start <- structs.payload_enums.penum_field_type_start.push(structs.payload_enums.penum_field_types.count)
                structs.payload_enums.penum_field_type_count <- structs.payload_enums.penum_field_type_count.push(0)




        # Copy one source enum's selected rows into the synthetic error-set payload table.
        # Keeping the source owner lets `FirstError.Missing` and `SecondError.Missing` remain
        # distinguishable even when their leaf variant names happen to match.
        def append_error_union_family(file: Ast::File&, occurrence: ErrorUnionFamilyOccurrence, families: darray[ErrorUnionFamilyOccurrence], structs: mutable StructTable&, widest: mutable u32&) -> void can[Abort.Panic, Memory.Allocate]:
            return if occurrence.error_set_parameter
            return if occurrence.qualified and not occurrence.resolved
            family_index: mutable i64 = penum_index_of_owned(structs, occurrence.module, occurrence.family)
            family_index <- penum_index_of(structs, occurrence.family) if family_index < 0 and not occurrence.qualified
            if family_index < 0:
                append_error_union_plain_family(file, occurrence, families, structs)
                return
            family_start: usize = structs.payload_enums.penum_variant_start[family_index.usize()]
            family_count: usize = structs.payload_enums.penum_variant_count[family_index.usize()]
            for family_offset in 0..<family_count |family_offset, family_start, family_index, widest, file, occurrence, families, structs|:
                source_slot: usize = family_start + family_offset
                variant: sview = structs.payload_enums.penum_variants[source_slot]
                continue if not error_union_family_variant_allowed(file, families, occurrence, variant, structs)
                field_start: usize = structs.payload_enums.penum_field_type_start[source_slot]
                field_count: usize = structs.payload_enums.penum_field_type_count[source_slot]
                variant_owner: sview = structs.payload_enums.penum_variant_owners[source_slot]
                variant_module: sview = structs.payload_enums.penum_variant_modules[source_slot] if source_slot < structs.payload_enums.penum_variant_modules.count else penum_owner_at(structs, family_index.usize())
                variant_payload: ValueType = copied_type(structs.payload_enums.penum_payloads[source_slot])
                variant_has_payload: bool = structs.payload_enums.penum_has_payload[source_slot]
                variant_field_name: sview = structs.payload_enums.penum_field_names[source_slot]
                variant_widest: mutable u32 = field_count.u32()
                structs.payload_enums.penum_variants <- structs.payload_enums.penum_variants.push(variant)
                structs.payload_enums.penum_variant_owners <- structs.payload_enums.penum_variant_owners.push(variant_owner)
                structs.payload_enums.penum_variant_modules <- structs.payload_enums.penum_variant_modules.push(variant_module)
                structs.payload_enums.penum_payloads <- structs.payload_enums.penum_payloads.push(variant_payload)
                structs.payload_enums.penum_has_payload <- structs.payload_enums.penum_has_payload.push(variant_has_payload)
                structs.payload_enums.penum_field_names <- structs.payload_enums.penum_field_names.push(variant_field_name)
                structs.payload_enums.penum_field_type_start <- structs.payload_enums.penum_field_type_start.push(structs.payload_enums.penum_field_types.count)
                structs.payload_enums.penum_field_type_count <- structs.payload_enums.penum_field_type_count.push(field_count)
                for field_offset in 0..<field_count |structs, field_start|:
                    field_type: ValueType = copied_type(structs.payload_enums.penum_field_types[field_start + field_offset])
                    field_words: u32 = payload_variant_field_words(field_type, structs)
                    variant_widest <- variant_widest + field_words - 1 if field_words > 1
                    structs.payload_enums.penum_field_types <- structs.payload_enums.penum_field_types.push(field_type)
                    structs.payload_enums.penum_field_flat_names <- structs.payload_enums.penum_field_flat_names.push(structs.payload_enums.penum_field_flat_names[field_start + field_offset])
                widest <- variant_widest if variant_widest > widest




        def error_union_family_occurrence_precedes(left: ErrorUnionFamilyOccurrence, right: ErrorUnionFamilyOccurrence) -> bool:
            # Stage0 keys family sets by the complete tag.SetName, so duplicate leaves
            # from different modules must retain their qualifier in ABI ordering.
            return error_family_precedes(left.family_order_key, right.family_order_key)


        # Keep the source spelling when it is unique, but give a later occurrence a stable
        # internal key when the same spelling appears again in the same module. The returned
        # view is compiler-lived because it becomes a registry key.
        def error_union_occurrence_key(key: sview, occurrence_offset: u32) -> sview @source can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic, Memory.Allocate:
                bytes: mutable darray[u8] = []
                for index in 0..<key.len |bytes, key|:
                    bytes.push(key[index])
                bytes.push(35)
                append_usize_decimal(occurrence_offset.usize(), bytes)
                return Parser::persist_name_bytes(&bytes, 0) can Global{Read,Write}


        # Synthetic singleton rows use a key derived from the canonical owner and tag. This
        # lets repeated `error[Tag]` signatures share one backend type even when declared in
        # different modules, while the reserved punctuation cannot collide with source names.
        def error_union_bare_variant_key(module: sview, family: sview, variant: sview) -> sview @source can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic, Memory.Allocate:
                bytes: mutable darray[u8] = []
                prefix: sview = "__error_bare_variant__::"
                for index in 0..<prefix.len |bytes, prefix|:
                    bytes.push(prefix[index])
                for index in 0..<module.len |bytes, module|:
                    bytes.push(module[index])
                if module != "":
                    bytes.push(58)
                    bytes.push(58)
                for index in 0..<family.len |bytes, family|:
                    bytes.push(family[index])
                bytes.push(46)
                for index in 0..<variant.len |bytes, variant|:
                    bytes.push(variant[index])
                return Parser::persist_name_bytes(&bytes, 0) can Global{Read,Write}


        def error_union_imported_family_key(module: sview, family: sview) -> sview @source can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic, Memory.Allocate:
                bytes: mutable darray[u8] = []
                prefix: sview = "__error_imported_family__::"
                for index in 0..<prefix.len |bytes, prefix|:
                    bytes.push(prefix[index])
                for index in 0..<module.len |bytes, module|:
                    bytes.push(module[index])
                if module != "":
                    bytes.push(58)
                    bytes.push(58)
                for index in 0..<family.len |bytes, family|:
                    bytes.push(family[index])
                return Parser::persist_name_bytes(&bytes, 0) can Global{Read,Write}


        def register_error_union_row(file: Ast::File&, key: sview @source, module: sview @source, line: u32, offset: u32, identity_id: u32, occurrence_offset: u32, structs: mutable StructTable&) -> sview @source can[Abort.Panic, Memory.Allocate]:
            families: mutable darray[ErrorUnionFamilyOccurrence] = []
            for annotation_index in 0..<file.enum_annotations.count |families, file, line, offset, identity_id, module, structs|:
                annotation: Ast::EnumAnnotation = file.enum_annotations[annotation_index]
                continue if annotation.owner != "__error_set_family" or annotation.line != line or annotation.offset != offset or annotation.occurrence_offset != occurrence_offset
                continue if identity_id != 0 and annotation.identity_id != identity_id
                families.push(error_union_family_occurrence(file, annotation_index, module, structs) can Global{Read,Write})
            return "" if families.count == 0
            # Stage0's error-union ABI orders families by name, regardless of signature order.
            for index in 1..<families.count |families|:
                selected: ErrorUnionFamilyOccurrence = families[index]
                cursor: mutable usize = index
                while cursor > 0 and error_union_family_occurrence_precedes(selected, families[cursor - 1.usize()]) |cursor, families, selected|:
                    families[cursor] <- families[cursor - 1.usize()]
                    cursor <- cursor - 1.usize()
                families[cursor] <- selected
            for index in 0..<families.count |families|:
                occurrence: ErrorUnionFamilyOccurrence = families[index]
                return "" if occurrence.qualified and not occurrence.resolved
            # References to a registered ABI can cross lexical owners (for example
            # a catch in a different module). Give colliding synthetic rows globally
            # distinct keys so an unqualified ABI lookup stays unambiguous.
            row_key: mutable sview @source = key
            if name_chain_first(structs.payload_enums.penum_name_buckets, structs.payload_enums.penum_name_next, structs.payload_enums.penum_names, key) >= 0:
                row_key <- error_union_occurrence_key(key, occurrence_offset) can Global{Read,Write}
                collision: mutable u32 = 0
                while name_chain_first(structs.payload_enums.penum_name_buckets, structs.payload_enums.penum_name_next, structs.payload_enums.penum_names, row_key) >= 0 |collision, row_key, key, occurrence_offset, structs|:
                    collision <- collision + 1
                    row_key <- error_union_occurrence_key(key, occurrence_offset + collision) can Global{Read,Write}
            start: usize = structs.payload_enums.penum_variants.count
            widest: mutable u32 = 0
            for family_index in 0..<families.count |family_index, families, file, structs, widest|:
                occurrence: ErrorUnionFamilyOccurrence = families[family_index]
                repeated: mutable bool = false
                for prior_index in 0..<family_index |prior_index, repeated, families, occurrence, structs|:
                    prior: ErrorUnionFamilyOccurrence = families[prior_index]
                    repeated <- true if error_union_family_occurrence_same_declaration(occurrence, prior, structs)
                    break if repeated
                continue if repeated
                append_error_union_family(file, occurrence, families, structs, widest)
            count: usize = structs.payload_enums.penum_variants.count - start
            return "" if count == 0
            structs.payload_enums.penum_names <- structs.payload_enums.penum_names.push(row_key)
            structs.payload_enums.penum_owners <- structs.payload_enums.penum_owners.push(module)
            structs.payload_enums.penum_variant_start <- structs.payload_enums.penum_variant_start.push(start)
            structs.payload_enums.penum_variant_count <- structs.payload_enums.penum_variant_count.push(count)
            structs.payload_enums.penum_payload_words <- structs.payload_enums.penum_payload_words.push(widest)
            structs.errors.error_set_decl_names <- structs.errors.error_set_decl_names.push(row_key)
            return row_key


        def register_unkeyed_bare_variant_error_union_occurrence(file: Ast::File&, family_annotation_index: usize, lexical_module: sview @source, structs: mutable StructTable&) -> sview @source can[Abort.Panic, Memory.Allocate]:
            return "" if family_annotation_index >= file.enum_annotations.count
            family_annotation: Ast::EnumAnnotation = file.enum_annotations[family_annotation_index]
            return "" if family_annotation.owner != "__error_set_family"
            family_count: mutable usize = 0
            keyed: mutable bool = false
            for annotation in file.enum_annotations |family_count, keyed, family_annotation|:
                same_occurrence: bool = annotation.line == family_annotation.line and annotation.offset == family_annotation.offset and annotation.identity_id == family_annotation.identity_id and annotation.occurrence_offset == family_annotation.occurrence_offset
                family_count <- family_count + 1.usize() if annotation.owner == "__error_set_family" and same_occurrence
                keyed <- true if annotation.owner == "__error_set_key" and same_occurrence
            return "" if family_count != 1.usize() or keyed
            return "" if error_union_error_set_param_shadows_family(file, family_annotation)
            source_name: sview @source = family_annotation.name
            visible_family: (found: bool, module: sview @source, family: sview @source) = error_union_error_set_declared_at(file, source_name, lexical_module, family_annotation.offset) can Global{Read,Write}
            path: mutable sview @source = source_name
            if family_annotation_index + 1.usize() < file.enum_annotations.count:
                path_row: Ast::EnumAnnotation = file.enum_annotations[family_annotation_index + 1.usize()]
                path <- path_row.name if path_row.owner == "__error_set_family_path" and path_row.line == family_annotation.line and path_row.offset == family_annotation.offset and path_row.identity_id == family_annotation.identity_id and path_row.occurrence_offset == family_annotation.occurrence_offset
            path_info: (valid: bool, qualified: bool, module_end: usize) = error_union_family_path_info(path, source_name)
            return "" if not path_info.valid or path_info.qualified
            if visible_family.found:
                structs.errors.visible_family_names.push(source_name)
                structs.errors.visible_family_scopes.push(lexical_module)
                structs.errors.visible_family_owners.push(visible_family.module)
                structs.errors.visible_family_targets.push(visible_family.family)
                # The body can spell an imported family by its original name
                # even when the return signature uses a local alias.
                if source_name != visible_family.family:
                    original: (found: bool, module: sview @source, family: sview @source) = error_union_error_set_declared_at(file, visible_family.family, lexical_module, family_annotation.offset) can Global{Read,Write}
                    if original.found and original.module == visible_family.module and original.family == visible_family.family:
                        structs.errors.visible_family_names.push(original.family)
                        structs.errors.visible_family_scopes.push(lexical_module)
                        structs.errors.visible_family_owners.push(original.module)
                        structs.errors.visible_family_targets.push(original.family)
                # Local and root families already have a backend lookup path. Imported or
                # ancestor families need a private owner-qualified row so equal leaves in
                # different modules cannot share their ABI metadata.
                return "" if visible_family.module == lexical_module or visible_family.module == ""
                key: sview @source = error_union_imported_family_key(visible_family.module, visible_family.family) can Global{Read,Write}
                return key if penum_index_of(structs, key) >= 0
                return register_error_union_row(file, key, lexical_module, family_annotation.line, family_annotation.offset, family_annotation.identity_id, family_annotation.occurrence_offset, structs) can Global{Read,Write}
            variant_owner: (count: usize, family: sview @source, module: sview @source) = error_union_unique_bare_variant_owner(file, source_name, structs)
            return "" if variant_owner.count != 1.usize()
            key: sview @source = error_union_bare_variant_key(variant_owner.module, variant_owner.family, source_name) can Global{Read,Write}
            if penum_index_of(structs, key) >= 0:
                return key
            return register_error_union_row(file, key, lexical_module, family_annotation.line, family_annotation.offset, family_annotation.identity_id, family_annotation.occurrence_offset, structs) can Global{Read,Write}


        # Simple `error[Tag]` return and callback signatures have no __error_set_key row
        # because the parser normally handles one family without a synthetic union. Once enum
        # metadata exists, canonicalize each unique bare tag into its owning family and
        # register the one-tag ABI row used by raises, calls, try propagation, and catches.
        def register_unkeyed_bare_variant_error_unions(file: Ast::File&, structs: mutable StructTable&) -> void can[Abort.Panic, Memory.Allocate]:
            # Keep original row indices because each family is followed by its path.
            family_rows: mutable darray[usize] = []
            module_rows: mutable darray[Ast::EnumAnnotation] = []
            for row in 0..<file.enum_annotations.count |file, family_rows, module_rows|:
                marker: Ast::EnumAnnotation = file.enum_annotations[row]
                family_rows.push(row) if marker.owner == "__error_set_family"
                module_rows.push(marker) if marker.owner == "__fn_module"
            for return_marker in file.enum_annotations |file, structs, family_rows, module_rows|:
                continue if return_marker.name != "__error_return"
                family_annotation_index: mutable usize = file.enum_annotations.count
                family_count: mutable usize = 0
                function_module: mutable sview @source = ""
                for annotation_index in family_rows |family_annotation_index, family_count, file, return_marker|:
                    annotation: Ast::EnumAnnotation = file.enum_annotations[annotation_index]
                    same_occurrence: bool = annotation.line == return_marker.line and annotation.offset == return_marker.offset and annotation.identity_id == return_marker.identity_id and annotation.occurrence_offset == return_marker.occurrence_offset
                    family_annotation_index <- annotation_index if same_occurrence
                    family_count <- family_count + 1.usize() if same_occurrence
                continue if family_count != 1.usize()
                family_annotation: Ast::EnumAnnotation = file.enum_annotations[family_annotation_index]
                if family_annotation.module == "":
                    for annotation in module_rows |function_module, return_marker|:
                        function_module <- annotation.name if annotation.line == return_marker.line and annotation.offset == return_marker.offset and annotation.identity_id == return_marker.identity_id
                lexical_module: sview @source = family_annotation.module if family_annotation.module != "" else function_module
                row_key: sview @source = register_unkeyed_bare_variant_error_union_occurrence(file, family_annotation_index, lexical_module, structs) can Global{Read,Write}
                if row_key != "":
                    for error_index in 0..<structs.errors.error_fn_lines.count |structs, return_marker, row_key|:
                        if structs.errors.error_fn_lines[error_index] == return_marker.line and error_index < structs.errors.error_fn_offsets.count and structs.errors.error_fn_offsets[error_index] == return_marker.offset + 1 and error_index < structs.errors.error_fn_set_names.count:
                            structs.errors.error_fn_set_names[error_index] <- row_key

            # First-class `fn(...) -> T error[Tag]` types use their own line/offset key. The
            # parser now carries the exact `error` token offset on __fn_error_union so multiple
            # callbacks on one header line cannot borrow one another's canonical family.
            for fn_error_marker in file.enum_annotations |file, structs, family_rows|:
                continue if fn_error_marker.owner != "__fn_error_union" or fn_error_marker.occurrence_offset == 0
                family_annotation_index: mutable usize = file.enum_annotations.count
                family_count: mutable usize = 0
                for annotation_index in family_rows |family_annotation_index, family_count, file, fn_error_marker|:
                    annotation: Ast::EnumAnnotation = file.enum_annotations[annotation_index]
                    if annotation.occurrence_offset == fn_error_marker.occurrence_offset:
                        family_annotation_index <- annotation_index
                        family_count <- family_count + 1.usize()
                continue if family_count != 1.usize()
                family_annotation: Ast::EnumAnnotation = file.enum_annotations[family_annotation_index]
                row_key: sview @source = register_unkeyed_bare_variant_error_union_occurrence(file, family_annotation_index, family_annotation.module, structs) can Global{Read,Write}
                if row_key != "":
                    for fn_error_index in 0..<structs.function_types.fn_error_lines.count |structs, fn_error_marker, row_key|:
                        if structs.function_types.fn_error_lines[fn_error_index] == fn_error_marker.line and fn_error_index < structs.function_types.fn_error_offsets.count and structs.function_types.fn_error_offsets[fn_error_index] == fn_error_marker.offset and fn_error_index < structs.function_types.fn_error_occurrence_offsets.count and structs.function_types.fn_error_occurrence_offsets[fn_error_index] == fn_error_marker.occurrence_offset and fn_error_index < structs.function_types.fn_error_families.count:
                            structs.function_types.fn_error_families[fn_error_index] <- row_key




        # Function signatures retain their source slice as a private key. Repeated composite
        # spellings in one module are separated by their occurrence before ABI registration.
        def register_composite_error_unions(file: Ast::File&, structs: mutable StructTable&) -> void can[Abort.Panic, Memory.Allocate]:
            for key_annotation in file.enum_annotations |file, structs|:
                continue if key_annotation.owner != "__error_set_key"
                module: mutable sview @source = ""
                for module_annotation in file.enum_annotations |module, key_annotation|:
                    module <- module_annotation.name if module_annotation.owner == "__error_set_module" and module_annotation.line == key_annotation.line and module_annotation.offset == key_annotation.offset and module_annotation.occurrence_offset == key_annotation.occurrence_offset and (key_annotation.identity_id == 0 or module_annotation.identity_id == key_annotation.identity_id)
                row_key: sview @source = register_error_union_row(file, key_annotation.name, module, key_annotation.line, key_annotation.offset, key_annotation.identity_id, key_annotation.occurrence_offset, structs) can Global{Read,Write}
                if row_key != "":
                    for local_index in 0..<structs.errors.local_error_lines.count |structs, key_annotation, row_key|:
                        if structs.errors.local_error_lines[local_index] == key_annotation.line and structs.errors.local_error_offsets[local_index] == key_annotation.offset:
                            structs.errors.local_error_families[local_index] <- row_key
                if row_key != "" and payload_error_set_key_is_return_occurrence(file, key_annotation):
                    for error_index in 0..<structs.errors.error_fn_lines.count |structs, key_annotation, row_key|:
                        if structs.errors.error_fn_lines[error_index] == key_annotation.line and error_index < structs.errors.error_fn_offsets.count and structs.errors.error_fn_offsets[error_index] == key_annotation.offset + 1 and error_index < structs.errors.error_fn_set_names.count:
                            structs.errors.error_fn_set_names[error_index] <- row_key
            register_unkeyed_bare_variant_error_unions(file, structs) can Global{Read,Write}
