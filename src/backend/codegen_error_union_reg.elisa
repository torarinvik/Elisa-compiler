# Stage1 backend — register composite/restricted error families from the parser's line rows.
# Their ABI is the ordered union of the declared families, with each source payload kept
# attached to its original owner. Part of `module Backend` (see codegen.elisa).

extend Backend:
    private:


        def error_family_precedes(left: sview, right: sview) -> bool:
            left_length: usize = sview_len(left)
            right_length: usize = sview_len(right)
            shared_length: usize = left_length if left_length < right_length else right_length
            for index in 0..<shared_length |left, right|:
                return sview_at(left, index) < sview_at(right, index) if sview_at(left, index) != sview_at(right, index)
            return left_length < right_length




        def error_union_variant_allowed(file: Ast::File&, line: u32, family: sview, variant: sview) -> bool can[Abort.Panic]:
            restricted: mutable bool = false
            for annotation in file.enum_annotations |restricted, line, family|:
                restricted <- true if annotation.owner == "__error_variant_family" and annotation.line == line and annotation.name == family
            return true if not restricted
            for annotation_index in 0..<file.enum_annotations.count |file, line, family, variant|:
                annotation: Ast::EnumAnnotation = file.enum_annotations[annotation_index]
                continue if annotation.owner != "__error_variant_family" or annotation.line != line or annotation.name != family
                continue if annotation_index + 1 >= file.enum_annotations.count
                allowed: Ast::EnumAnnotation = file.enum_annotations[annotation_index + 1]
                return true if allowed.owner == "__error_variant_allow" and allowed.line == line and allowed.name == variant
            return false




        # A fieldless error declaration is stored in the ordinary enum table, not the
        # payload-enum table. Copy its selected variants into the combined row as zero-field
        # entries so they still receive their canonical union tag.
        def append_error_union_plain_family(file: Ast::File&, line: u32, family: sview, module: sview, structs: mutable StructTable&) -> void can[Abort.Panic, Memory.Allocate]:
            enum_index: mutable i64 = enum_index_of_owned(structs, module, family)
            enum_index <- enum_index_of(structs, family) if enum_index < 0
            return if enum_index < 0
            enum_start: usize = structs.enum_variant_start[enum_index.usize()]
            enum_count: usize = structs.enum_variant_count[enum_index.usize()]
            for enum_offset in 0..<enum_count |enum_start, enum_index, structs, file, line, family|:
                variant: sview = structs.enum_variants[enum_start + enum_offset]
                continue if not error_union_variant_allowed(file, line, family, variant)
                structs.penum_variants <- structs.penum_variants.push(variant)
                structs.penum_variant_owners <- structs.penum_variant_owners.push(family)
                structs.penum_payloads <- structs.penum_payloads.push(unmodeled_type())
                structs.penum_has_payload <- structs.penum_has_payload.push(false)
                structs.penum_field_names <- structs.penum_field_names.push("")
                structs.penum_field_type_start <- structs.penum_field_type_start.push(structs.penum_field_types.count)
                structs.penum_field_type_count <- structs.penum_field_type_count.push(0)




        # Copy one source enum's selected rows into the synthetic error-set payload table.
        # Keeping the source owner lets `FirstError.Missing` and `SecondError.Missing` remain
        # distinguishable even when their leaf variant names happen to match.
        def append_error_union_family(file: Ast::File&, line: u32, family: sview, module: sview, structs: mutable StructTable&, widest: mutable u32&) -> void can[Abort.Panic, Memory.Allocate]:
            family_index: mutable i64 = penum_index_of_owned(structs, module, family)
            family_index <- penum_index_of(structs, family) if family_index < 0
            if family_index < 0:
                append_error_union_plain_family(file, line, family, module, structs)
                return
            family_start: usize = structs.penum_variant_start[family_index.usize()]
            family_count: usize = structs.penum_variant_count[family_index.usize()]
            for family_offset in 0..<family_count |family_offset, family_start, family_index, widest, file, line, family, structs|:
                source_slot: usize = family_start + family_offset
                variant: sview = structs.penum_variants[source_slot]
                continue if not error_union_variant_allowed(file, line, family, variant)
                field_start: usize = structs.penum_field_type_start[source_slot]
                field_count: usize = structs.penum_field_type_count[source_slot]
                variant_owner: sview = structs.penum_variant_owners[source_slot]
                variant_payload: ValueType = copied_type(structs.penum_payloads[source_slot])
                variant_has_payload: bool = structs.penum_has_payload[source_slot]
                variant_field_name: sview = structs.penum_field_names[source_slot]
                variant_widest: mutable u32 = field_count.u32()
                structs.penum_variants <- structs.penum_variants.push(variant)
                structs.penum_variant_owners <- structs.penum_variant_owners.push(variant_owner)
                structs.penum_payloads <- structs.penum_payloads.push(variant_payload)
                structs.penum_has_payload <- structs.penum_has_payload.push(variant_has_payload)
                structs.penum_field_names <- structs.penum_field_names.push(variant_field_name)
                structs.penum_field_type_start <- structs.penum_field_type_start.push(structs.penum_field_types.count)
                structs.penum_field_type_count <- structs.penum_field_type_count.push(field_count)
                for field_offset in 0..<field_count |structs, field_start|:
                    field_type: ValueType = copied_type(structs.penum_field_types[field_start + field_offset])
                    field_words: u32 = payload_variant_field_words(field_type, structs)
                    variant_widest <- variant_widest + field_words - 1 if field_words > 1
                    structs.penum_field_types <- structs.penum_field_types.push(field_type)
                    structs.penum_field_flat_names <- structs.penum_field_flat_names.push(structs.penum_field_flat_names[field_start + field_offset])
                widest <- variant_widest if variant_widest > widest




        def register_error_union_row(file: Ast::File&, key: sview, module: sview, line: u32, structs: mutable StructTable&) -> void can[Abort.Panic, Memory.Allocate]:
            return if penum_index_of_owned(structs, module, key) >= 0
            families: mutable darray[sview] = []
            for annotation in file.enum_annotations |families, line|:
                continue if annotation.owner != "__error_set_family" or annotation.line != line
                families.push(annotation.name)
            return if families.count == 0
            # Stage0's error-union ABI orders families by name, regardless of signature order.
            for index in 1..<families.count |families|:
                selected: sview = families[index]
                cursor: mutable usize = index
                while cursor > 0 and error_family_precedes(selected, families[cursor - 1.usize()]) |cursor, families, selected|:
                    families[cursor] <- families[cursor - 1.usize()]
                    cursor <- cursor - 1.usize()
                families[cursor] <- selected
            start: usize = structs.penum_variants.count
            widest: mutable u32 = 0
            for family in families |file, line, module, structs, widest|:
                append_error_union_family(file, line, family, module, structs, widest)
            count: usize = structs.penum_variants.count - start
            return if count == 0
            structs.penum_names <- structs.penum_names.push(key)
            structs.penum_owners <- structs.penum_owners.push(module)
            structs.penum_variant_start <- structs.penum_variant_start.push(start)
            structs.penum_variant_count <- structs.penum_variant_count.push(count)
            structs.penum_payload_words <- structs.penum_payload_words.push(widest)
            structs.error_set_decl_names <- structs.error_set_decl_names.push(key)




        # Function signatures retain their source slice as a stable private key, so repeated
        # identical unions share one row while different restricted unions never collide.
        def register_composite_error_unions(file: Ast::File&, structs: mutable StructTable&) -> void can[Abort.Panic, Memory.Allocate]:
            for key_annotation in file.enum_annotations |file, structs|:
                continue if key_annotation.owner != "__error_set_key"
                module: mutable sview = ""
                for module_annotation in file.enum_annotations |module, key_annotation|:
                    module <- module_annotation.name if module_annotation.owner == "__error_set_module" and module_annotation.line == key_annotation.line
                register_error_union_row(file, key_annotation.name, module, key_annotation.line, structs)
