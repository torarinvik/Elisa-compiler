# Stage1 backend — NAMED TUPLES: the labels a tuple type carries, and its registration as an
# anonymous struct so `(x: T, y: U)` has one LLVM type wherever it is written.
# Part of `module Backend` (see codegen.elisa).

extend Backend:
    private:


        # How many labels the annotation `element` itself consumes from its line's label list.
        # The parser pushes a label BEFORE parsing the element it names, so a NESTED named
        # tuple interleaves its labels into the middle of the outer one's — the layout is
        # PRE-ORDER, not a flat concatenation. Anything that is not a tuple consumes none.
        def tuple_label_span(element: Ast::Expr) -> usize can[Abort.Panic]:
            can Abort.Panic:
                if element is Expr.Tuple(inner_elements, inner_line):
                    span: mutable usize = inner_elements.count
                    for inner_element in inner_elements |span|:
                        span <- span + tuple_label_span(inner_element)
                    return span
                return 0




            # The labels naming `elements`, for the tuple whose first label sits at `offset` among
            # the labels recorded for `line`. Empty when the line does not carry them — two tuple
            # types on one line share a label list, so one tuple's labels are a slice of it.
        def tuple_labels_window(line: u32, offset: usize, elements: darray[Ast::Expr], structs: mutable StructTable&) -> darray[sview] can[Abort.Panic, Memory.Allocate]:
            all_labels: darray[sview] = tuple_labels_at(line, structs)
            empty: mutable darray[sview] = []
            empty return if elements.count == 0
            window: mutable darray[sview] = []
            cursor: mutable usize = offset
            for element in elements |window, cursor, all_labels|:
                break if cursor >= all_labels.count
                window.push(all_labels[cursor])
                cursor <- cursor + 1 + tuple_label_span(element)
            empty return if window.count != elements.count
            return window




        # The index of an already-registered anonymous tuple struct whose field NAMES and field
        # TYPES match (structural memo — an empty struct name marks a synthesized tuple), or -1.
        def tuple_struct_lookup(labels: darray[sview]&, element_types: darray[ValueType]&, structs: mutable StructTable&) -> i64 can[Abort.Panic]:
            si: mutable usize = 0
            while si < structs.names.count |si, labels, element_types, structs|:
                if structs.names[si] == "" and structs.field_count[si] == labels.count and labels.count > 0:
                    start: usize = structs.field_start[si]
                    matched: mutable bool = true
                    k: mutable usize = 0
                    while k < labels.count |k, matched, start, si, labels, element_types, structs|:
                        if structs.field_names[start + k] != labels[k] or structs.field_types[start + k].kind != element_types[k].kind or structs.field_types[start + k].bits != element_types[k].bits:
                            matched <- false
                        k <- k + 1
                    si.i64() return if matched
                si <- si + 1
            return -1




        # Register ONE named-tuple type `(x: T, y: U)` as an anonymous (empty-named) struct, if
        # not already registered. Its field labels come from the __tuple_label side-table; its
        # element types resolve like any annotation. Structurally memoized so a tuple return
        # type and a same-shape local resolve to the SAME struct.
        def register_one_tuple_type(elements: darray[Ast::Expr], line: u32, label_offset: usize, structs: mutable StructTable&, ctx: LLVMContextRef) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            labels: darray[sview] = tuple_labels_window(line, label_offset, elements, structs)
            return if elements.count == 0 or labels.count != elements.count
            element_types: mutable darray[ValueType] = []
            declined: mutable bool = false
            for element in elements |element_types, declined, structs|:
                element_type: ValueType = annotation_value_type(element, structs)
                declined <- true if element_type.kind == TypeKind.Unmodeled
                element_types.push(element_type)
            return if declined
            return if tuple_struct_lookup(labels, element_types, structs) >= 0
            name_storage: mutable darray[u8] = []
            handle: LLVMTypeRef = LLVMStructCreateNamed(ctx, sview_to_cstr("tuple", name_storage))
            llvm_fields: mutable darray[LLVMTypeRef] = []
            llvm_fields.extend([llvm_type_of(element_type_slot, structs, ctx) for element_type_slot in element_types])
            llvm_fields_pointer: void& = (&llvm_fields[0]).cast[void&] can Unsafe.PointerCast
            LLVMStructSetBody(handle, llvm_fields_pointer, element_types.count.u32(), 0)
            field_start: usize = structs.field_names.count
            fi: mutable usize = 0
            while fi < labels.count |fi, labels, element_types, structs|:
                structs.field_names <- structs.field_names.push(labels[fi])
                structs.field_types <- structs.field_types.push(element_types[fi])
                fi <- fi + 1
            structs.names <- structs.names.push(sview("", 0, 0))
            structs.owners <- structs.owners.push("")    # anonymous named-tuple struct
            structs.handles <- structs.handles.push(handle)
            structs.alignments <- structs.alignments.push(0)
            structs.field_start <- structs.field_start.push(field_start)
            structs.field_count <- structs.field_count.push(labels.count)




        # If `type_expression` is a named-tuple TYPE, pre-register its anonymous struct.
        # Pre-pass: register every named-tuple TYPE that appears in a function signature
        # (params, return) or a local declaration, BEFORE any body is emitted — annotation_value_type
        # then resolves a tuple annotation by structural lookup (it has no ctx to build a handle).
        def register_tuple_types(elements: darray[Ast::Expr], starts: darray[usize], counts: darray[usize], lines: darray[u32], structs: mutable StructTable&, ctx: LLVMContextRef) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            for tuple_index in 0..<starts.count |elements, starts, counts, lines, structs, ctx|:
                tuple_elements: mutable darray[Ast::Expr] = []
                element_start: usize = starts[tuple_index]
                element_count: usize = counts[tuple_index]
                for element_index in 0..<element_count |tuple_elements, elements, element_start|:
                    tuple_elements.push(elements[element_start + element_index])
                # `__tuple_label` annotations are pushed in source order and the tuple pools
                # are in source order too, so this tuple's labels begin after every label an
                # earlier tuple on the same line consumed — its own, plus any nested tuple's.
                label_offset: mutable usize = 0
                for earlier_index in 0..<tuple_index |label_offset, elements, starts, counts, lines, tuple_index|:
                    continue if lines[earlier_index] != lines[tuple_index]
                    label_offset <- label_offset + counts[earlier_index]
                    for earlier_element_index in 0..<counts[earlier_index] |label_offset, elements, starts, earlier_index|:
                        label_offset <- label_offset + tuple_label_span(elements[starts[earlier_index] + earlier_element_index])
                register_one_tuple_type(tuple_elements, lines[tuple_index], label_offset, structs, ctx)
