# Shared, typed scalar lowering consumed by both the portable EDIR writer and
# the native LLVM backend. This first slice covers explicit i64 entry points
# with a literal return or one initialized scalar local and literal arithmetic.

const module ElisaCoreIRShape:
    TOP_LEVEL_DECLARATION_COUNT: usize = 1
    ENTRY_PARAMETER_COUNT: usize = 0
    SINGLE_STATEMENT_COUNT: usize = 1
    LOCAL_STATEMENT_COUNT: usize = 2
    EMPTY_COLLECTION_COUNT: usize = 0
    EMPTY_LENGTH: i64 = 0
    SINGLE_NAME_LENGTH: i64 = 1
    ANONYMOUS_LOCAL_MARKER: u8 = 95


const module ElisaCoreIRArithmetic:
    ZERO: i64 = 0
    SIGNED_I64_MAXIMUM: i64 = 9223372036854775807


module ElisaCoreIR:
    public:
        enum I64BinaryOperator:
            Add
            Subtract
            Multiply
            Divide


        struct Program:
            has_local: bool
            local_value: i64
            local_declaration_position: Ast::Pos
            local_initializer_position: Ast::Pos
            has_binary_operator: bool
            operator: I64BinaryOperator
            left: i64
            right: i64
            left_position: Ast::Pos
            right_position: Ast::Pos
            expression_position: Ast::Pos
            return_position: Ast::Pos


    private:
        def lower_operator(operator: Lexer::TokenKind) -> I64BinaryOperator?:
            return I64BinaryOperator.Add if operator == Lexer::TokenKind.Plus
            return I64BinaryOperator.Subtract if operator == Lexer::TokenKind.Minus
            return I64BinaryOperator.Multiply if operator == Lexer::TokenKind.Star
            return I64BinaryOperator.Divide if operator == Lexer::TokenKind.Slash
            return null


        def lower_return_expression(expression: Ast::Expr, return_position: Ast::Pos) -> Program?:
            match expression:
                Ast::Expr.IntLit(value, value_position):
                    return Program{
                        has_local: false,
                        local_value: ElisaCoreIRArithmetic::ZERO,
                        local_declaration_position: return_position,
                        local_initializer_position: value_position,
                        has_binary_operator: false,
                        operator: I64BinaryOperator.Add,
                        left: value,
                        right: ElisaCoreIRArithmetic::ZERO,
                        left_position: value_position,
                        right_position: value_position,
                        expression_position: value_position,
                        return_position: Ast::pos_span(return_position, value_position)
                    }
                Ast::Expr.Binary(left, source_operator, right, _):
                    if lower_operator(source_operator) is core_operator:
                        match left:
                            Ast::Expr.IntLit(left_value, left_position):
                                match right:
                                    Ast::Expr.IntLit(right_value, right_position):
                                        return Program{
                                            has_local: false,
                                            local_value: ElisaCoreIRArithmetic::ZERO,
                                            local_declaration_position: return_position,
                                            local_initializer_position: left_position,
                                            has_binary_operator: true,
                                            operator: core_operator,
                                            left: left_value,
                                            right: right_value,
                                            left_position: left_position,
                                            right_position: right_position,
                                            expression_position: Ast::pos_span(left_position, right_position),
                                            return_position: Ast::pos_span(return_position, right_position)
                                        }
                                    _:
                                        pass
                            _:
                                pass
                _:
                    pass
            return null


        def lower_local_return(local_name: sview, local_value: i64, declaration_position: Ast::Pos, initializer_position: Ast::Pos, returned_expression: Ast::Expr, return_position: Ast::Pos) -> Program?:
            match returned_expression:
                Ast::Expr.Ident(returned_name, returned_position):
                    return null if returned_name != local_name
                    return Program{
                        has_local: true,
                        local_value: local_value,
                        local_declaration_position: declaration_position,
                        local_initializer_position: initializer_position,
                        has_binary_operator: false,
                        operator: I64BinaryOperator.Add,
                        left: local_value,
                        right: ElisaCoreIRArithmetic::ZERO,
                        left_position: returned_position,
                        right_position: returned_position,
                        expression_position: returned_position,
                        return_position: Ast::pos_span(return_position, returned_position)
                    }
                Ast::Expr.Binary(left, source_operator, right, _):
                    if lower_operator(source_operator) is core_operator:
                        match left:
                            Ast::Expr.Ident(returned_name, left_position):
                                return null if returned_name != local_name
                                match right:
                                    Ast::Expr.IntLit(right_value, right_position):
                                        return Program{
                                            has_local: true,
                                            local_value: local_value,
                                            local_declaration_position: declaration_position,
                                            local_initializer_position: initializer_position,
                                            has_binary_operator: true,
                                            operator: core_operator,
                                            left: local_value,
                                            right: right_value,
                                            left_position: left_position,
                                            right_position: right_position,
                                            expression_position: Ast::pos_span(left_position, right_position),
                                            return_position: Ast::pos_span(return_position, right_position)
                                        }
                                    _:
                                        pass
                            _:
                                pass
                _:
                    pass
            return null


        def function_body_program(declaration: Ast::Decl, owner: sview) -> Program?:
            return null if owner.len != ElisaCoreIRShape::EMPTY_LENGTH
            if declaration is Ast::Decl.Func(function_name, parameters, return_type, body, effects, decorators, _):
                return null if function_name != "main"
                return null if parameters.count != ElisaCoreIRShape::ENTRY_PARAMETER_COUNT
                return null if effects.count != ElisaCoreIRShape::EMPTY_COLLECTION_COUNT or decorators.count != ElisaCoreIRShape::EMPTY_COLLECTION_COUNT
                if return_type is return_type_expression:
                    match return_type_expression:
                        Ast::Expr.Ident(type_name, _):
                            return null if type_name != "i64"
                        _:
                            return null
                else:
                    return null
                if body.count == ElisaCoreIRShape::SINGLE_STATEMENT_COUNT:
                    if body[0] is Ast::Stmt.Return(return_value, return_position):
                        if return_value is returned_expression:
                            return lower_return_expression(returned_expression, return_position)
                    return null
                return null if body.count != ElisaCoreIRShape::LOCAL_STATEMENT_COUNT
                if body[0] is Ast::Stmt.VarDecl(local_name, local_type, initializer, declaration_position):
                    return null if local_name.len == ElisaCoreIRShape::EMPTY_LENGTH
                    return null if local_name.len == ElisaCoreIRShape::SINGLE_NAME_LENGTH and local_name.data[0] == ElisaCoreIRShape::ANONYMOUS_LOCAL_MARKER
                    if local_type is Ast::Expr.Ident(local_type_name, _):
                        return null if local_type_name != "i64"
                    else:
                        return null
                    if initializer is Ast::Expr.IntLit(local_value, initializer_position):
                        if body[1] is Ast::Stmt.Return(return_value, return_position):
                            if return_value is returned_expression:
                                return lower_local_return(local_name, local_value, declaration_position, initializer_position, returned_expression, return_position)
                return null
            return null


    public:
        def lower_main(file: Ast::File&) -> Program?:
            return null if file.top_decls.count != ElisaCoreIRShape::TOP_LEVEL_DECLARATION_COUNT
            return function_body_program(file.top_decls[0], StringView{data: "", len: ElisaCoreIRShape::EMPTY_LENGTH})


        def lower_function(declaration: Ast::Decl, owner: sview) -> Program?:
            return function_body_program(declaration, owner)


        def scalar_expression_is_defined(program: Program) -> bool:
            return true if not program.has_binary_operator
            return false if program.left < ElisaCoreIRArithmetic::ZERO or program.right < ElisaCoreIRArithmetic::ZERO
            if program.operator == I64BinaryOperator.Add:
                return program.left <= ElisaCoreIRArithmetic::SIGNED_I64_MAXIMUM - program.right
            if program.operator == I64BinaryOperator.Subtract:
                return true
            if program.operator == I64BinaryOperator.Multiply:
                return true if program.right == ElisaCoreIRArithmetic::ZERO
                return program.left <= ElisaCoreIRArithmetic::SIGNED_I64_MAXIMUM / program.right
            if program.operator == I64BinaryOperator.Divide:
                return program.right != ElisaCoreIRArithmetic::ZERO
            return false
