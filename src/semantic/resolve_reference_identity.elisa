extend Semantic:
    private:
        # Allocate a lexical identity owned by the current function. The serial is
        # table-local and monotonic, so branch copies preserve identity while new
        # declarations, including same-named shadows, receive distinct values.
        def fresh_binding_id(owner: DeclId, serial: mutable u64&) -> BindingId:
            can Abort.Panic:
                id: BindingId = BindingId{owner: owner, serial: serial}
                serial <- serial + 1
                return id


        # Recover the identifier span for binders held only as names in Stmt.For.
        # Older/synthesized patterns without a source annotation retain a line-only
        # sentinel and are explicitly distinguishable from exact source occurrences.
        def source_binder_position(table: SymbolTable&, name: sview, line: u32, ordinal: usize, binder_kind: sview) -> Ast::Pos:
            if table.binder_annotations_indexed:
                can Abort.Panic:
                    # The chain is newest-first, so the ORDINAL-th match in stream order is the
                    # (matches - 1 - ordinal)-th one met walking it.
                    head: u32 = binder_annotation_head(table, local_binding_exact_hash(name, line, 0))
                    matches: mutable usize = 0
                    row: mutable u32 = head
                    while row != SYMBOL_INDEX_ROW_NONE |row, matches, table, name, line, binder_kind|:
                        candidate: Ast::EnumAnnotation = table.binder_annotations[row.usize()]
                        matches <- matches + 1 if candidate.owner == binder_kind and candidate.line == line and candidate.name == name
                        row <- table.binder_annotation_next[row.usize()]
                    if ordinal < matches:
                        wanted: usize = matches - 1 - ordinal
                        met: mutable usize = 0
                        row <- head
                        while row != SYMBOL_INDEX_ROW_NONE |row, met, table, name, line, binder_kind, wanted|:
                            candidate: Ast::EnumAnnotation = table.binder_annotations[row.usize()]
                            if candidate.owner == binder_kind and candidate.line == line and candidate.name == name:
                                return candidate.pos if met == wanted
                                met <- met + 1
                            row <- table.binder_annotation_next[row.usize()]
                    return Ast::Pos{line: 0, column: 0, offset: 0, end_line: 0, end_column: 0, end_offset: 0}
            seen: mutable usize = 0
            for annotation in table.protocol_annotations:
                if annotation.owner == binder_kind and annotation.line == line and (binder_kind == "__for_binder" or annotation.name == name) and annotation.pos.end_offset > annotation.pos.offset:
                    if seen == ordinal:
                        return Ast::pos_at_line(0) if annotation.name != name
                        return annotation.pos
                    seen <- seen + 1
            return Ast::Pos{line: 0, column: 0, offset: 0, end_line: 0, end_column: 0, end_offset: 0}


        # Record one param/local occurrence for tooling (the LSP's semantic-token
        # highlighter reads these). `is_param` selects kind 1 (parameter) over 2
        # (local); the ID links each use back to the resolved lexical declaration.
        def record_reference(table: lmut SymbolTable, position: Ast::Pos, name: sview @source, is_param: bool, binding_id: BindingId) -> void:
            can Memory.Allocate, Abort.Panic:
                reference_index: usize = table.ref_binding_ids.count
                table.ref_line <- table.ref_line.push(position.line)
                table.ref_name <- table.ref_name.push(name)
                table.ref_kind <- table.ref_kind.push(1 if is_param else 2)
                table.ref_pos <- table.ref_pos.push(position)
                table.ref_binding_ids <- table.ref_binding_ids.push(binding_id)
                table.ref_owner_next <- table.ref_owner_next.push(SYMBOL_INDEX_ROW_NONE)
                owner_index: usize = binding_id.owner.value.usize()
                if reference_index >= SYMBOL_INDEX_ROW_NONE.usize():
                    table.ref_owner_index_valid <- false
                elif owner_index < table.symbols.count:
                    while table.ref_owner_heads.count <= owner_index |owner_index, table|:
                        table.ref_owner_heads <- table.ref_owner_heads.push(SYMBOL_INDEX_ROW_NONE)
                        table.ref_owner_tails <- table.ref_owner_tails.push(SYMBOL_INDEX_ROW_NONE)
                        table.ref_owner_counts <- table.ref_owner_counts.push(0.u32())
                        table.ref_owner_observed_counts <- table.ref_owner_observed_counts.push(0.usize())
                    if table.ref_owner_heads[owner_index] == SYMBOL_INDEX_ROW_NONE:
                        table.ref_owner_tails[owner_index] <- reference_index.u32()
                    table.ref_owner_next[reference_index] <- table.ref_owner_heads[owner_index]
                    table.ref_owner_heads[owner_index] <- reference_index.u32()
                    table.ref_owner_counts[owner_index] <- table.ref_owner_counts[owner_index] + 1.u32()
                    table.ref_owner_observed_counts[owner_index] <- table.ref_owner_observed_counts[owner_index] + 1.usize()
                else:
                    # An owner row that is not present cannot be represented in this
                    # table's bucket array. Keep every consumer on its canonical scan
                    # rather than letting an incomplete index omit this occurrence.
                    table.ref_owner_index_valid <- false


        # Exact-name rows chained under a numeric hash keep these short-lived indexes
        # collision-safe without using runtime-backed dictionaries with sview keys.
        struct PatternBinderNameIndex:
            heads: mutable dict[u64, u32]
            names: mutable darray[sview]
            values: mutable darray[usize]
            next: mutable darray[u32]
