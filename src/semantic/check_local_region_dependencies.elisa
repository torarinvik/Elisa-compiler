extend Semantic:
    private:
        # Whether a direct callee has a reference-carrying declared return type. Unknown
        # callees stay false here; the ordinary unresolved-call diagnostics handle those
        # separately, while a known reference-returning callee is enough to preserve the
        # temporary's region dependency through the call.
        def region_callee_returns_reference(callee: Ast::Expr, declarations: darray[Ast::Decl]) -> bool:
            can Memory.Allocate, Abort.Panic:
                callee_name: sview = ident_name_of(callee)
                return false if callee_name == ""
                for declaration in declarations:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            continue if function_name != callee_name
                            if return_type is declared_return:
                                return region_return_can_carry_reference(declared_return)
                        Decl.Module(module_name, module_body, module_line):
                            return true if region_callee_returns_reference(callee, module_body)
                        Decl.Scoped(scoped_body, scoped_line):
                            return true if region_callee_returns_reference(callee, scoped_body)
                        _:
                            pass
                return false


        # Whether a value contains a region allocation flowing through a known
        # reference-returning call. The recorded call span still captures the allocation token
        # when parser call-argument lowering erases the `RegionNew` wrapper.
        def region_expression_contains_reference_call_allocation(expression: Ast::Expr, region: sview, declarations: darray[Ast::Decl], allocation_regions: darray[sview @source]&, allocation_lines: darray[u32]&, allocation_offsets: darray[u32]&, call_spans: CallSourceSpanIndex&) -> bool:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, call_line):
                        call_returns_reference: bool = region_callee_returns_reference(callee, declarations)
                        if call_returns_reference:
                            has_wrapped_allocation: bool = any argument in arguments where region_expression_contains_allocation(argument, region)
                            has_recorded_allocation: bool = region_expression_has_recorded_allocation(expression, region, allocation_regions, allocation_lines, allocation_offsets, call_spans)
                            return true if has_wrapped_allocation or has_recorded_allocation
                        return true if region_expression_contains_reference_call_allocation(callee, region, declarations, allocation_regions, allocation_lines, allocation_offsets, call_spans)
                        for argument in arguments:
                            return true if region_expression_contains_reference_call_allocation(argument, region, declarations, allocation_regions, allocation_lines, allocation_offsets, call_spans)
                        return false
                    Expr.Field(object, field, line) | Expr.Scope(object, field, line):
                        return region_expression_contains_reference_call_allocation(object, region, declarations, allocation_regions, allocation_lines, allocation_offsets, call_spans)
                    Expr.Index(object, index, line):
                        return region_expression_contains_reference_call_allocation(object, region, declarations, allocation_regions, allocation_lines, allocation_offsets, call_spans) or region_expression_contains_reference_call_allocation(index, region, declarations, allocation_regions, allocation_lines, allocation_offsets, call_spans)
                    Expr.Slice(object, low, high, line):
                        return region_expression_contains_reference_call_allocation(object, region, declarations, allocation_regions, allocation_lines, allocation_offsets, call_spans) or region_expression_contains_reference_call_allocation(low, region, declarations, allocation_regions, allocation_lines, allocation_offsets, call_spans) or region_expression_contains_reference_call_allocation(high, region, declarations, allocation_regions, allocation_lines, allocation_offsets, call_spans)
                    Expr.IndexN(object, arguments, line):
                        return true if region_expression_contains_reference_call_allocation(object, region, declarations, allocation_regions, allocation_lines, allocation_offsets, call_spans)
                        for argument in arguments:
                            return true if region_expression_contains_reference_call_allocation(argument, region, declarations, allocation_regions, allocation_lines, allocation_offsets, call_spans)
                        return false
                    Expr.Unary(operator, operand, line) | Expr.Move(operand, line) | Expr.Paren(operand, line):
                        return region_expression_contains_reference_call_allocation(operand, region, declarations, allocation_regions, allocation_lines, allocation_offsets, call_spans)
                    Expr.Binary(left, operator, right, line) | Expr.Refinement(left, right, line):
                        return region_expression_contains_reference_call_allocation(left, region, declarations, allocation_regions, allocation_lines, allocation_offsets, call_spans) or region_expression_contains_reference_call_allocation(right, region, declarations, allocation_regions, allocation_lines, allocation_offsets, call_spans)
                    Expr.Array(elements, line) | Expr.Tuple(elements, line) | Expr.SetLit(elements, line):
                        for element in elements:
                            return true if region_expression_contains_reference_call_allocation(element, region, declarations, allocation_regions, allocation_lines, allocation_offsets, call_spans)
                        return false
                    Expr.DictLit(entries, line):
                        for entry in entries:
                            return true if region_expression_contains_reference_call_allocation(entry.key, region, declarations, allocation_regions, allocation_lines, allocation_offsets, call_spans)
                            return true if region_expression_contains_reference_call_allocation(entry.value, region, declarations, allocation_regions, allocation_lines, allocation_offsets, call_spans)
                        return false
                    Expr.Construct(type_expression, fields, line) | Expr.RecordUpdate(type_expression, fields, line):
                        return true if region_expression_contains_reference_call_allocation(type_expression, region, declarations, allocation_regions, allocation_lines, allocation_offsets, call_spans)
                        for field in fields:
                            return true if region_expression_contains_reference_call_allocation(field.value, region, declarations, allocation_regions, allocation_lines, allocation_offsets, call_spans)
                        return false
                    Expr.If(condition, then_expression, else_expression, line):
                        return region_expression_contains_reference_call_allocation(condition, region, declarations, allocation_regions, allocation_lines, allocation_offsets, call_spans) or region_expression_contains_reference_call_allocation(then_expression, region, declarations, allocation_regions, allocation_lines, allocation_offsets, call_spans) or region_expression_contains_reference_call_allocation(else_expression, region, declarations, allocation_regions, allocation_lines, allocation_offsets, call_spans)
                    Expr.Comprehension(_, iterable, condition, body, _, _):
                        return region_expression_contains_reference_call_allocation(iterable, region, declarations, allocation_regions, allocation_lines, allocation_offsets, call_spans) or region_expression_contains_reference_call_allocation(condition, region, declarations, allocation_regions, allocation_lines, allocation_offsets, call_spans) or region_expression_contains_reference_call_allocation(body, region, declarations, allocation_regions, allocation_lines, allocation_offsets, call_spans)
                    Expr.GetElse(guarded, _, _) | Expr.Block(_, guarded, _, _):
                        return region_expression_contains_reference_call_allocation(guarded, region, declarations, allocation_regions, allocation_lines, allocation_offsets, call_spans)
                    _:
                        return false


        def taint_move_bindings(body: darray[Ast::Stmt]&, tainted: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                return if body.count == 0
                match body[0]:
                    Stmt.Match(scrutinee, arms, line):
                        return if not region_expression_depends_on(scrutinee, tainted)
                        for statement in body |tainted|:
                            match statement:
                                Stmt.VarDecl(name, type_expression, value, decl_line):
                                    tainted.push(name) if not region_tainted_name(tainted, name)
                                _:
                                    pass
                    _:
                        pass


        def walk_local_region_dependencies(statements: darray[Ast::Stmt], region: sview @source, return_carries_reference: bool, declarations: darray[Ast::Decl], allocation_regions: darray[sview @source]&, allocation_lines: darray[u32]&, allocation_offsets: darray[u32]&, call_spans: CallSourceSpanIndex&, tainted: mutable darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |tainted, table|:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            allocated_here: bool = region_expression_is_direct_allocation(value, region)
                            value_end_offset: u32 = allocation_expression_end_offset(value, call_spans)
                            # The parser's call-argument path can lower `new[r]` to the
                            # operand while retaining its exact token offset and call span.
                            # In a reference-returning function that record is enough to
                            # conservatively preserve the lifetime dependency; scalar-returning
                            # functions stay exempt, so a consumed temporary remains legal.
                            call_allocation: bool = return_carries_reference and region_expression_contains_reference_call_allocation(value, region, declarations, allocation_regions, allocation_lines, allocation_offsets, call_spans)
                            # A binding whose initializer CONTAINS a `new[region]` anywhere —
                            # inside an array literal, a struct construction, a tuple — holds a
                            # reference into the region just as a direct `new` does, and every
                            # alias derived from it (a slice, an element, a field) inherits the
                            # dependency. stage0 rejects
                            #     items: array[Holder, 2] = [Holder{value: new[scratch] 1, …}]
                            #     window: view[Holder] = items[0:2]
                            #     alias: i32& = window[0].value
                            #     return alias
                            # with "region dependency facts include local region"; here only a
                            # bare `new` tainted the name, so `items` was never tainted and the
                            # alias chain escaped unnoticed (17 stage0 acceptance tests, all
                            # `…AliasEscapingRegion`). The taint is name-only and the diagnostic
                            # still requires a reference-returning function, so a scalar result
                            # computed from such a binding stays legal.
                            nested_allocation: bool = region_expression_contains_allocation(value, region)
                            # A `new` inside a struct-literal field can disappear from the child
                            # AST after lowering. Query the declaration interval as well as
                            # expression spans so the exact token row still taints this binding.
                            recorded_allocation: bool = return_carries_reference and region_expression_or_statement_has_recorded_allocation(value, region, line.offset, value_end_offset, allocation_regions, allocation_lines, allocation_offsets, call_spans)
                            tainted.push(name) if (allocated_here or nested_allocation or recorded_allocation or call_allocation or region_expression_depends_on(value, tainted)) and not region_tainted_name(tainted, name)
                        Stmt.Assign(target, operator, value, line):
                            target_name: sview = region_return_source_name(target)
                            tainted.push(target_name) if target_name != "" and region_expression_depends_on(value, tainted) and not region_tainted_name(tainted, target_name)
                        Stmt.Return(value, line):
                            if value is returned:
                                contains_allocation: bool = region_expression_contains_allocation(returned, region)
                                through_reference_call: bool = region_expression_contains_reference_call_allocation(returned, region, declarations, allocation_regions, allocation_lines, allocation_offsets, call_spans)
                                return_end_offset: u32 = allocation_expression_end_offset(returned, call_spans)
                                recorded_allocation: bool = region_expression_or_statement_has_recorded_allocation(returned, region, line.offset, return_end_offset, allocation_regions, allocation_lines, allocation_offsets, call_spans)
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.LocalRegionReferenceEscape, name: region_return_source_name(returned), line: line.line, expected: "", actual: region}) if return_carries_reference and (region_expression_depends_on(returned, tainted) or contains_allocation or through_reference_call or recorded_allocation)
                        Stmt.Block("move", clause, binding, body, line):
                            taint_move_bindings(body, tainted)
                            table <- walk_local_region_dependencies(body, region, return_carries_reference, declarations, allocation_regions, allocation_lines, allocation_offsets, call_spans, tainted, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- walk_local_region_dependencies(body, region, return_carries_reference, declarations, allocation_regions, allocation_lines, allocation_offsets, call_spans, tainted, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- walk_local_region_dependencies(then_body, region, return_carries_reference, declarations, allocation_regions, allocation_lines, allocation_offsets, call_spans, tainted, table)
                            table <- walk_local_region_dependencies(else_body, region, return_carries_reference, declarations, allocation_regions, allocation_lines, allocation_offsets, call_spans, tainted, table)
                        Stmt.While(condition, body, line) | Stmt.For(_, _, condition, body, line):
                            table <- walk_local_region_dependencies(body, region, return_carries_reference, declarations, allocation_regions, allocation_lines, allocation_offsets, call_spans, tainted, table)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |tainted, table|:
                                table <- walk_local_region_dependencies(arm.body, region, return_carries_reference, declarations, allocation_regions, allocation_lines, allocation_offsets, call_spans, tainted, table)
                        _:
                            pass


        def check_local_region_dependencies(statements: darray[Ast::Stmt], return_type: Ast::Expr, declarations: darray[Ast::Decl], allocation_regions: darray[sview @source]&, allocation_lines: darray[u32]&, allocation_offsets: darray[u32]&, call_spans: CallSourceSpanIndex&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table|:
                    match statement:
                        Stmt.Block("region", clause, binding, body, line):
                            tainted: mutable darray[sview] = []
                            # The region's NAME is clause[0] (`region scratch(1024):` parses the
                            # name into the clause; see the `__region_local` annotation the
                            # parser records from the same slot). `binding` is only the
                            # optional `as NAME` handle. Keying on `binding` made this walk look
                            # for region "" whenever there was no `as`, so it tainted nothing
                            # and every alias-escape through a plain region block went
                            # unreported (17 stage0 acceptance tests).
                            walked_region: mutable sview = binding
                            walked_region <- clause[0] if walked_region == "" and clause.count > 0 and clause[0] != "using"
                            table <- walk_local_region_dependencies(body, walked_region, region_return_can_carry_reference(return_type), declarations, allocation_regions, allocation_lines, allocation_offsets, call_spans, tainted, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- check_local_region_dependencies(body, return_type, declarations, allocation_regions, allocation_lines, allocation_offsets, call_spans, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- check_local_region_dependencies(then_body, return_type, declarations, allocation_regions, allocation_lines, allocation_offsets, call_spans, table)
                            table <- check_local_region_dependencies(else_body, return_type, declarations, allocation_regions, allocation_lines, allocation_offsets, call_spans, table)
                        _:
                            pass


        def check_region_assignment_statements(statements: darray[Ast::Stmt], declarations: darray[Ast::Decl]&, annotations: darray[Ast::LocalRegionAnnotation]&, allocation_regions: darray[sview @source]&, allocation_lines: darray[u32]&, allocation_offsets: darray[u32]&, call_spans: CallSourceSpanIndex&, function_line: u32, function_offset: u32, return_type: Ast::Expr, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table|:
                    match statement:
                        Stmt.VarDecl(name, type_expression, Expr.Ident(source_name, source_line), line):
                            if local_region_annotation_of(annotations, name, line.line, line.offset, true) is target_annotation and local_region_annotation_of(annotations, source_name, line.line, line.offset, true) is source_annotation:
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.RegionQualifierMismatch, name: name, line: line.line, expected: target_annotation.region, actual: source_annotation.region, detail: region_reference_base(target_annotation.type_expression)}) if target_annotation.region != source_annotation.region
                        Stmt.VarDecl(name, type_expression, value, line):
                            # A reference-typed local allocated from a function-local region is
                            # NOT an escape by itself; stage0 reports only where the value leaves
                            # (`return v`), and the return sites below do that. Reporting here as
                            # well printed the same escape twice (`v: i32& = new[scratch] 1` at
                            # line 3, then `return v` at line 4) where stage0 prints once.
                            pass
                        Stmt.Return(value, line):
                            if value is return_value:
                                return_end_offset: u32 = allocation_expression_end_offset(return_value, call_spans)
                                return_allocations: mutable darray[sview @source] = []
                                region_expression_recorded_allocations(return_value, line.offset, return_end_offset, allocation_regions, allocation_lines, allocation_offsets, call_spans, return_allocations)
                                for temporary_region in return_allocations |annotations, function_line, line, return_type, return_value, table|:
                                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.LocalRegionReferenceEscape, name: region_return_source_name(return_value), line: line.line, expected: "", actual: temporary_region}) if region_is_function_local(annotations, temporary_region, function_line, line.line, line.offset) and region_return_can_carry_reference(return_type)
                                uninferred_region: sview = region_call_result_is_uninferable(return_value, declarations, annotations, function_line)
                                caller_return_region: sview = function_return_region(annotations, function_line, function_offset)
                                # stage0 names the region after the CALLER-side binding it
                                # was inferred from ("__rg_value" for identity(value)); the
                                # renderer adds the __rg_ prefix around this recorded name.
                                inferred_source_name: mutable sview = ""
                                match return_value:
                                    Expr.Call(region_callee, region_arguments, region_argument_names, region_call_line):
                                        inferred_source_name <- ident_name_of(region_arguments[0]) if region_arguments.count > 0
                                    _:
                                        pass
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.RegionParamInferenceFailure, name: inferred_source_name, pos: Ast::expr_pos(return_value), line: line.line, expected: "", actual: uninferred_region}) if uninferred_region != "" and caller_return_region == ""
                                return_name: sview = region_return_source_name(return_value)
                                if return_name != "":
                                    if local_region_annotation_of(annotations, return_name, line.line, line.offset, true) is return_annotation:
                                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.LocalRegionReferenceEscape, name: return_name, line: line.line, expected: "", actual: return_annotation.region}) if region_is_function_local(annotations, return_annotation.region, function_line, line.line, line.offset)
                                    allocation_region: sview = allocated_local_region(statements, return_name, line.line, line.offset, true)
                                    has_explicit_region: bool = any annotation in annotations where annotation.name == return_name and annotation.owner_offset <= line.offset and (line.offset < annotation.end_offset if annotation.end_offset != 0 else annotation.end_line == 0 or line.line <= annotation.end_line)
                                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.LocalRegionReferenceEscape, name: return_name, line: line.line, expected: "", actual: allocation_region}) if not has_explicit_region and allocation_region != "" and region_is_function_local(annotations, allocation_region, function_line, line.line, line.offset)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- check_region_assignment_statements(body, declarations, annotations, allocation_regions, allocation_lines, allocation_offsets, call_spans, function_line, function_offset, return_type, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- check_region_assignment_statements(then_body, declarations, annotations, allocation_regions, allocation_lines, allocation_offsets, call_spans, function_line, function_offset, return_type, table)
                            table <- check_region_assignment_statements(else_body, declarations, annotations, allocation_regions, allocation_lines, allocation_offsets, call_spans, function_line, function_offset, return_type, table)
                        Stmt.While(condition, body, line):
                            table <- check_region_assignment_statements(body, declarations, annotations, allocation_regions, allocation_lines, allocation_offsets, call_spans, function_line, function_offset, return_type, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- check_region_assignment_statements(body, declarations, annotations, allocation_regions, allocation_lines, allocation_offsets, call_spans, function_line, function_offset, return_type, table)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |table|:
                                table <- check_region_assignment_statements(arm.body, declarations, annotations, allocation_regions, allocation_lines, allocation_offsets, call_spans, function_line, function_offset, return_type, table)
                        _:
                            pass


        def check_region_assignment_declarations(declarations: darray[Ast::Decl], annotations: darray[Ast::LocalRegionAnnotation]&, allocation_regions: darray[sview @source]&, allocation_lines: darray[u32]&, allocation_offsets: darray[u32]&, call_spans: CallSourceSpanIndex&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table|:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            if return_type is function_return_type:
                                table <- check_region_assignment_statements(body, declarations, annotations, allocation_regions, allocation_lines, allocation_offsets, call_spans, line.line, line.offset, function_return_type, table)
                                table <- check_local_region_dependencies(body, function_return_type, declarations, allocation_regions, allocation_lines, allocation_offsets, call_spans, table)
                            else:
                                table <- check_region_assignment_statements(body, declarations, annotations, allocation_regions, allocation_lines, allocation_offsets, call_spans, line.line, line.offset, (Ast::Expr.Invalid), table)
                        Decl.Module(name, body, line) | Decl.Scoped(body, line):
                            table <- check_region_assignment_declarations(body, annotations, allocation_regions, allocation_lines, allocation_offsets, call_spans, table)
                        _:
                            pass

        # Names bound as `owned Arena` (locals or parameters) anywhere in the file: an
        # owned linear region is a legal `@name` qualifier and `new[name]` target
        # (`r: owned Arena = new_arena(64); n: Node[r]& @r = new[r] ...`).
        def collect_owned_region_names(declarations: darray[Ast::Decl], out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |out|:
                    match declaration:
                        Decl.Func(name, parameters, return_type, body, effects, decorators, line):
                            out.extend([parameter.name for parameter in parameters if annotation_is_owned(parameter.type_expression)])
                            collect_owned_region_locals(body, out)
                        Decl.Module(module_name, module_body, module_line):
                            collect_owned_region_names(module_body, out)
                        Decl.Scoped(scoped_body, scoped_line):
                            collect_owned_region_names(scoped_body, out)
                        _:
                            pass


        def collect_owned_region_locals(statements: darray[Ast::Stmt], out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |out|:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            out.push(name) if annotation_is_owned(type_expression)
                        Stmt.If(condition, then_body, else_body, if_line):
                            collect_owned_region_locals(then_body, out)
                            collect_owned_region_locals(else_body, out)
                        Stmt.While(condition, while_body, while_line):
                            collect_owned_region_locals(while_body, out)
                        Stmt.Block(kind, clause, binding, block_body, block_line):
                            collect_owned_region_locals(block_body, out)
                        _:
                            pass
