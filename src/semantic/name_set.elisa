# Stage1 semantic layer — an insertion-ordered set of names. `names` holds each distinct name
# once, in first-insertion order (exactly what `out.push(name) if not any existing in out where
# existing == name` builds), and an open-addressed slot table over name_hash makes the
# membership test O(1) instead of a rescan of every name collected so far. Continues
# symbols.elisa.

extend Semantic:
    private:
        struct NameSet:
            names: mutable darray[sview]
            slots: mutable darray[u32] = []

        const NAME_SET_SLOT_EMPTY: u32 = 4294967295

        def empty_name_set() -> NameSet:
            can Memory.Allocate, Abort.Panic:
                return NameSet{names: []}

        # The slot holding `name`, or the empty slot its probe ends at (slots must be non-empty).
        def name_set_slot(set: NameSet&, name: sview) -> usize:
            can Abort.Panic:
                mask: usize = set.slots.count - 1
                slot: mutable usize = name_hash(name).usize() & mask
                while set.slots[slot] != NAME_SET_SLOT_EMPTY |slot, set, name, mask|:
                    return slot if set.names[set.slots[slot].usize()] == name
                    slot <- (slot + 1) & mask
                return slot

        # Rebuild the slot table with room for twice the current names.
        def name_set_grow(set: mutable NameSet&) -> void:
            can Memory.Allocate, Abort.Panic:
                capacity: mutable usize = 16
                while capacity < (set.names.count + 1) * 2 |capacity, set|:
                    capacity <- capacity * 2
                set.slots.truncate(0)
                set.slots.reserve(capacity)
                for slot_index in 0..<capacity |set|:
                    set.slots.push(NAME_SET_SLOT_EMPTY)
                for row in 0..<set.names.count |set|:
                    slot: usize = name_set_slot(set, set.names[row])
                    set.slots[slot] <- row.u32()

        def name_set_contains(set: NameSet&, name: sview) -> bool:
            can Abort.Panic:
                false return if set.slots.count == 0
                return set.slots[name_set_slot(set, name)] != NAME_SET_SLOT_EMPTY

        # The insertion index of `name`, or -1 when absent.
        def name_set_index(set: NameSet&, name: sview) -> i64:
            can Abort.Panic:
                -1 return if set.slots.count == 0
                row: u32 = set.slots[name_set_slot(set, name)]
                -1 return if row == NAME_SET_SLOT_EMPTY
                return row.i64()

        # Append `name` unless it is already present.
        def name_set_add(set: mutable NameSet&, name: sview) -> void:
            can Memory.Allocate, Abort.Panic:
                name_set_grow(set) if set.slots.count < (set.names.count + 1) * 2
                slot: usize = name_set_slot(set, name)
                return if set.slots[slot] != NAME_SET_SLOT_EMPTY
                set.slots[slot] <- set.names.count.u32()
                set.names.push(name)

        # Rows of an annotation array chained by `line`, in ascending row order: a lookup by
        # line visits exactly the rows a full scan for that line matches, in the same order.
        # Built over a caller-owned array and read beside it.
        struct AnnotationLineIndex:
            heads: mutable dict[u64, u32] = {}
            tails: mutable dict[u64, u32] = {}
            next: mutable darray[u32] = []

        def build_annotation_line_index(annotations: darray[Ast::EnumAnnotation]&, index: mutable AnnotationLineIndex&) -> void:
            can Memory.Allocate, Abort.Panic:
                for row in 0..<annotations.count |index, annotations|:
                    key: u64 = annotations[row].line.u64()
                    index.next.push(NAME_SET_SLOT_EMPTY)
                    if index.tails.get(key) is tail_row:
                        index.next[tail_row.usize()] <- row.u32()
                    else:
                        index.heads <- index.heads.put(key, row.u32()) can Global{Read,Write}
                    index.tails <- index.tails.put(key, row.u32()) can Global{Read,Write}

        # The first row at `line`, or NAME_SET_SLOT_EMPTY; follow `next` from there.
        def annotation_line_head(index: AnnotationLineIndex&, line: u32) -> u32:
            can Abort.Panic:
                return head if index.heads.get(line.u64()) is head else NAME_SET_SLOT_EMPTY
