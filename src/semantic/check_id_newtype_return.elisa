# Id-newtype return identity. An `id[Role]` (also `ID[...]`/`ptrid[...]`) is a distinct handle
# newtype: a function returning one may not `return` a value of a different role or a plain
# integer:
#
#   type NameId = id[Name]
#   def bad(raw: u32) -> NameId: return raw        # error: expects id[Name], got u32
#   def bad(s: id[Symbol]) -> NameId: return s     # error: expects id[Name], got id[Symbol]
#
# SOUND subset: only a `return <param>` whose declared type resolves (through `type` aliases)
# to a concrete non-matching type is flagged. A returned call/constructor/local, or an
# unresolved type, is a conservative miss. Reuses the `Decl.Alias` registry.
extend Semantic:
    private:
        def idr_is_id_family(head: sview) -> bool:
            can Abort.Panic:
                return head == "id" or head == "ID" or head == "ptrid"

        def idr_alias_target(alias_names: darray[sview]&, alias_targets: darray[Ast::Expr]&, name: sview) -> (found: bool, target: Ast::Expr):
            can Memory.Allocate, Abort.Panic:
                index: mutable usize = 0
                while index < alias_names.count |index|:
                    (true, alias_targets[index]) return if alias_names[index] == name
                    index <- index + 1
                return (false, (Ast::Expr.Invalid))

        # Resolve a type expression (through `mutable`/paren wrappers and `type` aliases) to
        # (is_id, role, bare-non-id-name). `depth` guards alias cycles.
        def idr_resolve(type_expression: Ast::Expr, alias_names: darray[sview]&, alias_targets: darray[Ast::Expr]&, depth: u32) -> (is_id: bool, role: sview, bare: sview):
            can Memory.Allocate, Abort.Panic:
                (false, sview("", 0, 0), sview("", 0, 0)) return if depth > 8
                match type_expression:
                    Expr.Index(head, argument, index_line):
                        (true, ident_name_of(argument), sview("", 0, 0)) return if idr_is_id_family(ident_name_of(head))
                        return (false, sview("", 0, 0), ident_name_of(head))
                    Expr.IndexN(head_n, arguments, index_n_line):
                        first_argument: sview = ident_name_of(arguments[0]) if arguments.count > 0 else sview("", 0, 0)
                        (true, first_argument, sview("", 0, 0)) return if idr_is_id_family(ident_name_of(head_n))
                        return (false, sview("", 0, 0), ident_name_of(head_n))
                    Expr.Unary(operator, operand, unary_line):
                        return idr_resolve(operand, alias_names, alias_targets, depth)
                    Expr.Paren(inner, paren_line):
                        return idr_resolve(inner, alias_names, alias_targets, depth)
                    Expr.Ident(name, ident_line):
                        located: (found: bool, target: Ast::Expr) = idr_alias_target(alias_names, alias_targets, name)
                        idr_resolve(located.target, alias_names, alias_targets, depth + 1) return if located.found
                        return (false, sview("", 0, 0), name)
                    _:
                        return (false, sview("", 0, 0), sview("", 0, 0))

        def idr_param_type(parameters: darray[Ast::ParamDecl]&, name: sview) -> (found: bool, type_expression: Ast::Expr):
            can Memory.Allocate, Abort.Panic:
                for parameter in parameters:
                    (true, parameter.type_expression) return if parameter.name == name
                return (false, (Ast::Expr.Invalid))

        def idr_check_returns(statements: darray[Ast::Stmt], parameters: darray[Ast::ParamDecl]&, return_role: sview, alias_names: darray[sview]&, alias_targets: darray[Ast::Expr]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Return(value, line):
                            if value is returned:
                                if returned is Expr.Ident(returned_name, returned_line):
                                    located: (found: bool, type_expression: Ast::Expr) = idr_param_type(parameters, returned_name)
                                    if located.found:
                                        got: (is_id: bool, role: sview, bare: sview) = idr_resolve(located.type_expression, alias_names, alias_targets, 0)
                                        matches: bool = got.is_id and got.role == return_role
                                        if not matches:
                                            got_count: u32 = 1 if got.is_id else 0
                                            got_text: sview = got.role if got.is_id else got.bare
                                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.IdNewtypeReturnMismatch, name: "", line: line, expected: return_role, actual: got_text, expected_count: got_count}) if got_text != ""
                        Stmt.If(condition, then_body, else_body, if_line):
                            table <- idr_check_returns(then_body, parameters, return_role, alias_names, alias_targets, table)
                            table <- idr_check_returns(else_body, parameters, return_role, alias_names, alias_targets, table)
                        Stmt.While(condition, while_body, while_line):
                            table <- idr_check_returns(while_body, parameters, return_role, alias_names, alias_targets, table)
                        Stmt.For(bind, variables, iterable, for_body, for_line):
                            table <- idr_check_returns(for_body, parameters, return_role, alias_names, alias_targets, table)
                        Stmt.Block(kind, clause, binding, body, block_line):
                            table <- idr_check_returns(body, parameters, return_role, alias_names, alias_targets, table)
                        Stmt.Match(scrutinee, arms, match_line):
                            for arm in arms |table| -> table:
                                table <- idr_check_returns(arm.body, parameters, return_role, alias_names, alias_targets, table)
                        _:
                            pass

        def idr_check_declarations(declarations: darray[Ast::Decl], alias_names: darray[sview]&, alias_targets: darray[Ast::Expr]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            if return_type is return_type_expression:
                                return_id: (is_id: bool, role: sview, bare: sview) = idr_resolve(return_type_expression, alias_names, alias_targets, 0)
                                table <- idr_check_returns(body, parameters, return_id.role, alias_names, alias_targets, table) if return_id.is_id
                        Decl.Module(module_name, module_body, module_line):
                            table <- idr_check_declarations(module_body, alias_names, alias_targets, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- idr_check_declarations(scoped_body, alias_names, alias_targets, table)
                        _:
                            pass

    public:
        def check_id_newtype_return(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                alias_names: mutable darray[sview] = []
                alias_targets: mutable darray[Ast::Expr] = []
                for declaration in file.top_decls |alias_names, alias_targets|:
                    match declaration:
                        Decl.Alias(alias_name, alias_target, alias_line):
                            alias_names.push(alias_name)
                            alias_targets.push(alias_target)
                        _:
                            pass
                table <- idr_check_declarations(file.top_decls, alias_names, alias_targets, table)
