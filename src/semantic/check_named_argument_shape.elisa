# Invalid labels prevent the direct-call argument binder from producing ordered
# arguments. Other passes diagnose the shape; type checks must not add cascades.
extend Semantic:
    private:
        def named_argument_shape_valid(table: SymbolTable&, function_name: sview, argument_names: darray[sview @source]) -> bool:
            can Abort.Panic:
                return true if not (any name in argument_names where name != "")
                saw_named: mutable bool = false
                for index in 0..<argument_names.count |saw_named, table, function_name, argument_names|:
                    name: sview = argument_names[index]
                    if name == "":
                        return false if saw_named
                    else:
                        saw_named <- true
                        position: int = function_parameter_index(table, function_name, name)
                        return false if position < 0 or position.usize() < index and argument_names[position.usize()] == ""
                        for earlier in 0..<index |argument_names, name|:
                            return false if argument_names[earlier] == name
                return true
