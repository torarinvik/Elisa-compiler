# Removed `dview[T]` type. The dynamic-view type was renamed to `view[T]`; any use of `dview`
# in a type position is a hard error ("`dview[T]` has been removed; use `view[T]`"). Pure
# syntactic: the head identifier `dview` of a type expression (bare or `dview[...]`, through
# mutable/&/paren/optional wrappers) at a parameter, return, field, or local-declaration type.
extend Semantic:
    private:
        # Whether TYPE names `dview` at its head (through wrappers), and its line.
        def type_names_dview(type_expression: Ast::Expr) -> (found: bool, line: u32):
            can Memory.Allocate, Abort.Panic:
                match type_expression:
                    Expr.Ident(name, line):
                        return (name == "dview", line)
                    Expr.Index(head, argument, index_line):
                        head_found: (found: bool, line: u32) = type_names_dview(head)
                        return (true, index_line) if head_found.found else (false, 0)
                    Expr.IndexN(head, arguments, indexn_line):
                        headn_found: (found: bool, line: u32) = type_names_dview(head)
                        return (true, indexn_line) if headn_found.found else (false, 0)
                    Expr.Unary(operator, operand, unary_line):
                        return type_names_dview(operand)
                    Expr.Paren(inner, paren_line):
                        return type_names_dview(inner)
                    Expr.Refinement(base, predicate, refinement_line):
                        return type_names_dview(base)
                    _:
                        return (false, 0)

        def dview_flag_type(type_expression: Ast::Expr, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                verdict: (found: bool, line: u32) = type_names_dview(type_expression)
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.DviewRemoved, name: "", line: verdict.line, expected: "", actual: ""}) if verdict.found

        def dview_check_statements(statements: darray[Ast::Stmt], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- dview_flag_type(type_expression, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- dview_check_statements(then_body, table)
                            table <- dview_check_statements(else_body, table)
                        Stmt.While(condition, while_body, line):
                            table <- dview_check_statements(while_body, table)
                        Stmt.For(bind, variables, iterable, for_body, line):
                            table <- dview_check_statements(for_body, table)
                        Stmt.Block(kind, clause, binding, block_body, block_line):
                            table <- dview_check_statements(block_body, table)
                        _:
                            pass

        def check_dview_removed(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            for parameter in parameters |table| -> table:
                                table <- dview_flag_type(parameter.type_expression, table)
                            if return_type is declared_return:
                                table <- dview_flag_type(declared_return, table)
                            table <- dview_check_statements(body, table)
                        Decl.Struct(struct_name, members, affinity, has_named_states, has_derive, invariants, struct_line):
                            for member in members |table| -> table:
                                table <- dview_flag_type(member.type_expression, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- check_dview_removed(module_body, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- check_dview_removed(scoped_body, table)
                        _:
                            pass
