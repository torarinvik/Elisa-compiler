# A field-backed typed pointer erased to `void&` is an unsafe pointer reinterpretation.
# Keep this deliberately structural: numeric conversions and pointer casts encapsulated
# inside trusted/runtime wrappers are outside this check's ownership.
extend Semantic:
    private:
        def pointer_erasure_target(expression: Ast::Expr) -> bool:
            can Abort.Panic:
                return bare_type_name_through_ref(expression) == "void"


        def pointer_erasure_field_receiver(expression: Ast::Expr) -> bool:
            can Abort.Panic:
                match expression:
                    Expr.Field(_, _, _):
                        return true
                    _:
                        return false


        # Whether a `.cast[T]` target spelling is pointer-like (any ref wrapper).
        # A bare non-ref target (`value.cast[SymbolTableId]`, numeric/id value casts)
        # is NOT a pointer cast — stage0 requires no Unsafe grant for it.
        def cast_target_is_pointer(expression: Ast::Expr) -> bool:
            can Abort.Panic:
                match expression:
                    # ANY unary type wrapper (`&`, mutable, lmut, heap, ...) marks a
                    # pointer-ish target; a value cast target is a bare (possibly
                    # generic) type name with no wrapper.
                    Expr.Unary(operator, operand, unary_line):
                        return true
                    Expr.Paren(inner, paren_line):
                        return cast_target_is_pointer(inner)
                    _:
                        return false

        # Whether a cast TARGET spells a MUTABLE reference (`mutable T&`) — the
        # default-mode warning shape: reinterpreting an address as a mutable
        # borrow. A shared-ref target (`T&`) is accepted silently by stage0.
        def cast_target_is_mutable_ref(expression: Ast::Expr) -> bool:
            can Abort.Panic:
                match expression:
                    Expr.Unary(operator, operand, unary_line):
                        true return if operator == TokenKind.Mutable
                        return cast_target_is_mutable_ref(operand)
                    Expr.Paren(inner, paren_line):
                        return cast_target_is_mutable_ref(inner)
                    _:
                        return false

        # The bare ident under a visible address-of receiver (`(&x)` -> "x"; "" otherwise).
        def address_of_base_name(expression: Ast::Expr) -> sview:
            can Abort.Panic:
                match expression:
                    Expr.Unary(operator, operand, unary_line):
                        ident_name_of(operand) return if operator == TokenKind.Ampersand
                        return address_of_base_name(operand)
                    Expr.Paren(inner, paren_line):
                        return address_of_base_name(inner)
                    _:
                        return sview("", 0, 0)

        # Whether the cast RECEIVER is visibly an address-of (`(&x).cast[usize]`) —
        # a ref-to-integer erasure that stays a pointer cast even with a scalar target.
        def cast_receiver_is_address(expression: Ast::Expr) -> bool:
            can Abort.Panic:
                match expression:
                    Expr.Unary(operator, operand, unary_line):
                        return operator == TokenKind.Ampersand or cast_receiver_is_address(operand)
                    Expr.Paren(inner, paren_line):
                        return cast_receiver_is_address(inner)
                    _:
                        return false

        # `static u8&` / `mutable static u8&` — an UNBOUNDED string target. Casting an
        # interior pointer to one erases the container's length, so a C-string scan can run
        # off the end. Distinct from the ungranted-effect diagnostic: stage0 reports this
        # even INSIDE a `can`/`trusted` block (verified for both), because the grant says
        # "I accept the pointer cast", not "I accept losing the bound".
        def unbounded_string_target(target: Ast::Expr) -> sview:
            can Memory.Allocate, Abort.Panic:
                is_static: bool = type_marker_present_here(target, TokenKind.Static)
                is_ref: bool = type_marker_present_here(target, TokenKind.Ampersand)
                # NOT bare_type_name_through_ref: that returns "" the moment it meets a
                # marker outside {mutable, &, lmut}, and `static` is exactly such a marker,
                # so it reports "" for every `static u8&` and the check never fired.
                base: sview = erasure_base_type_name(target)
                empty_target: sview = sview("", 0, 0)
                empty_target return if not (is_static and is_ref and base == "u8")
                return "static mutable u8&" if type_marker_present_here(target, TokenKind.Mutable) else "static u8&"


        # The base type name, walking through EVERY unary type marker (`static`, `mutable`,
        # `&`, `lmut`).
        def erasure_base_type_name(type_expression: Ast::Expr) -> sview:
            can Memory.Allocate, Abort.Panic:
                match type_expression:
                    Expr.Unary(operator, operand, line):
                        return erasure_base_type_name(operand)
                    Expr.Paren(inner, paren_line):
                        return erasure_base_type_name(inner)
                    Expr.Ident(name, ident_line):
                        return name
                    _:
                        return sview("", 0, 0)


        def type_marker_present_here(type_expression: Ast::Expr, marker: TokenKind) -> bool:
            can Memory.Allocate, Abort.Panic:
                match type_expression:
                    Expr.Unary(operator, operand, line):
                        true return if operator == marker
                        return type_marker_present_here(operand, marker)
                    _:
                        return false

        # Whether RECEIVER is an address-of an INDEX (`&self.data[off]`) -- an interior
        # pointer into a container, which is what makes the length meaningful to lose.
        def receiver_is_interior_pointer(receiver: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                match receiver:
                    Expr.Unary(operator, operand, line):
                        false return if operator != TokenKind.Ampersand
                        return match operand:
                            Expr.Index(object, index, index_line): true
                            _: false
                    Expr.Paren(inner, paren_line):
                        return receiver_is_interior_pointer(inner)
                    _:
                        return false


        def pec_zero_index(expression: Ast::Expr) -> bool:
            can Abort.Panic:
                match expression:
                    Expr.IntLit(value, _):
                        return value == 0
                    Expr.Paren(inner, paren_line):
                        return pec_zero_index(inner)
                    _:
                        return false


        # The bare buffer name for `&buffer[0]`, the only starting position where a prior
        # in-buffer NUL proves that an unbounded string scan terminates. An empty result means
        # either a non-zero/unknown index or a non-identifier receiver.
        def pec_nul_scan_base_name(receiver: Ast::Expr) -> sview:
            can Memory.Allocate, Abort.Panic:
                match receiver:
                    Expr.Unary(operator, operand, line):
                        return sview("", 0, 0) if operator != TokenKind.Ampersand
                        match operand:
                            Expr.Index(object, index, index_line):
                                return ident_name_of(object) if pec_zero_index(index)
                            _:
                                pass
                        return sview("", 0, 0)
                    Expr.Paren(inner, paren_line):
                        return pec_nul_scan_base_name(inner)
                    _:
                        return sview("", 0, 0)


        # Keep the stage0 NUL-termination fact during the sequential statement walk. This
        # prevents a false warning for the common `bytes.push(0); (&bytes[0]).cast[static u8&]`
        # idiom while still warning for a cast that happens before the terminator is appended.
        def pec_nul_update(expression: Ast::Expr, nul_names: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, line):
                        match callee:
                            Expr.Field(object, method, field_line):
                                name: sview = ident_name_of(object)
                                if method == "push" and arguments.count == 1:
                                    match arguments[0]:
                                        Expr.IntLit(value, _):
                                            if value == 0 and name != "" and not (any known in nul_names where known == name):
                                                nul_names.push(name)
                                        _:
                                            pass
                                elif method == "clear" or method == "truncate" or method == "pop" or method == "resize":
                                    # A shrink may remove the terminator. Forget all tracked
                                    # buffers conservatively; this avoids allocating a filtered
                                    # side table in the borrower's region.
                                    nul_names.truncate(0)
                            _:
                                pass
                    _:
                        pass


        def pec_record_unsafe_effect(owner: sview, effect: sview, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                already: mutable bool = false
                for row_index in 0..<table.function_unsafe_owner.count |already, owner, effect, table|:
                    already <- true if table.function_unsafe_owner[row_index] == owner and table.function_unsafe_name[row_index] == effect
                if not already:
                    table.function_unsafe_owner <- table.function_unsafe_owner.push(owner)
                    table.function_unsafe_name <- table.function_unsafe_name.push(effect)


        def check_pointer_erasure_expression(expression: Ast::Expr, owner: sview, function_line: u32, parameters: darray[Ast::ParamDecl], signature_effects: darray[sview]&, local_grants: darray[sview]&, trusted_grants: darray[sview]&, enforce_unsafe_permissions: bool, legacy_walk: bool, immutable_params: darray[sview]&, numeric_locals: darray[sview]&, pointer_locals: darray[sview]&, buffer_locals: darray[sview]&, nul_names: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                pointer_signature_granted: bool = strict_unsafe_grant_covers(signature_effects, "Unsafe.PointerCast")
                pointer_local_granted: bool = strict_unsafe_grant_covers(local_grants, "Unsafe.PointerCast") or strict_unsafe_grant_covers(trusted_grants, "Unsafe.PointerCast")
                buffer_local_granted: bool = strict_unsafe_grant_covers(local_grants, "Unsafe.BufferReinterpret") or strict_unsafe_grant_covers(trusted_grants, "Unsafe.BufferReinterpret")
                match expression:
                    Expr.Index(Expr.Field(receiver, selector, field_line), target, line):
                        field_receiver: bool = pointer_erasure_field_receiver(receiver)
                        safe_generic_ref_cast: bool = match receiver:
                            Expr.Ident(receiver_name, receiver_line): (any parameter in parameters where parameter.name == receiver_name and type_marker_present_here(parameter.type_expression, TokenKind.Mutable) and type_marker_present_here(parameter.type_expression, TokenKind.Ampersand) and not type_marker_present_here(parameter.type_expression, TokenKind.Heap) and not type_marker_present_here(parameter.type_expression, TokenKind.Static) and not type_marker_present_here(parameter.type_expression, TokenKind.Lmut) and not type_marker_present_here(parameter.type_expression, TokenKind.Stack) and not type_marker_present_here(parameter.type_expression, TokenKind.Tail) and not type_marker_present_here(parameter.type_expression, TokenKind.Question) and type_marker_present_here(target, TokenKind.Ampersand) and not type_marker_present_here(target, TokenKind.Mutable) and not type_marker_present_here(target, TokenKind.Heap) and not type_marker_present_here(target, TokenKind.Static) and not type_marker_present_here(target, TokenKind.Lmut) and not type_marker_present_here(target, TokenKind.Stack) and not type_marker_present_here(target, TokenKind.Tail) and not type_marker_present_here(target, TokenKind.Question) and erasure_base_type_name(parameter.type_expression) == erasure_base_type_name(target))
                            _: false
                        # Pointer casts require their own local grant. A function effect row
                        # suppresses the default-mode warning, but does not replace the local
                        # grant required in strict mode. Buffer reinterpretation has a separate
                        # capability because one source operation can require both.
                        strict_pointer_cast: bool = enforce_unsafe_permissions and not pointer_local_granted and not safe_generic_ref_cast and (cast_target_is_pointer(target) or cast_receiver_is_address(receiver) or field_receiver)
                        function_is_generic: bool = pointer_erasure_generic_line(table.generic_param_lines, function_line)
                        # A `.cast[...]` in a generic function cannot assume the runtime
                        # representation or provenance of an unconstrained type parameter,
                        # including when it has first been copied into a local. The one safe
                        # exception is weakening the same mutable borrow to a shared borrow.
                        generic_reinterpret: bool = selector == "cast" and function_is_generic and not safe_generic_ref_cast and not pointer_local_granted and (enforce_unsafe_permissions or not pointer_signature_granted)
                        # Default (non-strict) mode still WARNS on a visible
                        # pointer reinterpretation: a ref-typed cast target over an
                        # address-of receiver (`(&x).cast[mutable T&]`).
                        address_base: sview = address_of_base_name(receiver)
                        default_pointer_cast: bool = not enforce_unsafe_permissions and not pointer_local_granted and not pointer_signature_granted and cast_target_is_mutable_ref(target) and address_base != "" and (any p in immutable_params where p == address_base)
                        # General numeric -> reference reinterpret (`addr.cast[T&]`, addr a numeric
                        # local/param): stage0's `IsNumericType(src) && isPointerLikeCastType(dst)`
                        # rule. A numeric value is never SameType/AssignableTo a ref, so this has
                        # no region/state subtlety — fire in default mode whenever ungranted.
                        receiver_numeric: bool = match receiver:
                            Expr.Ident(receiver_name, receiver_line): (any local_name in numeric_locals where local_name == receiver_name)
                            _: false
                        numeric_pointer_cast: bool = not pointer_local_granted and not pointer_signature_granted and receiver_numeric and type_marker_present_here(target, TokenKind.Ampersand)
                        # Erasing a typed reference param to `void&` (`p.cast[void&]`, p a ref
                        # param) is an unsafe pointer reinterpretation stage0 warns on in ANY mode.
                        # The field-receiver form is handled by the legacy branch below; this covers
                        # a bare ref-param ident receiver. Interior-pointer/syscall-buffer void& casts
                        # have field/index receivers (not bare idents) and are unaffected.
                        receiver_ref_param: bool = match receiver:
                            Expr.Ident(receiver_ident_name, receiver_ident_line): (any p in immutable_params where p == receiver_ident_name)
                            _: false
                        default_void_erasure: bool = not pointer_local_granted and not pointer_signature_granted and receiver_ref_param and pointer_erasure_target(target)
                        # The length-erasure warning, INDEPENDENT of any grant.
                        erasure_target: sview = unbounded_string_target(target)
                        nul_base: sview = pec_nul_scan_base_name(receiver)
                        erases_length: bool = selector == "cast" and erasure_target != "" and receiver_is_interior_pointer(receiver) and not (any known in nul_names where known == nul_base)
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UnboundedStringErasure, name: "", line: line.line, expected: "", actual: erasure_target}) if erases_length
                        # A DIFFERENT interior-pointer hazard, also grant-INDEPENDENT: casting the
                        # interior pointer of a byte darray to a ref of a concretely WIDER TYPED
                        # value (`(&self.data[off]).cast[Header&]`) reads more bytes than the index
                        # bounds guarantee. Excludes byte targets (u8/i8 — same width) and `void&`
                        # (an opaque erasure, not a wider typed read — the runtime uses it for
                        # syscall buffers, which stage0 accepts).
                        widen_base: sview = erasure_base_type_name(target)
                        reinterprets_wider: bool = selector == "cast" and receiver_is_interior_pointer(receiver) and type_marker_present_here(target, TokenKind.Ampersand) and widen_base != "" and widen_base != "u8" and widen_base != "i8" and widen_base != "void" and not erases_length
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.InteriorPointerWiden, name: "", line: line.line, expected: "", actual: widen_base}) if reinterprets_wider
                        # stage0 records Unsafe.BufferReinterpret at BOTH shapes, and at the
                        # unbounded-string one even when the buffer is known NUL-terminated
                        # (`recordUnsafeBufferReinterpret` runs before that early return) --
                        # so this predicate is `erasure_target != ""`, not `erases_length`.
                        # The buffer-root gate is stage0's `castOperandRootsAtBufferIndex`:
                        # `(&path[i]).cast[static u8&]` on a `static u8&` PARAM indexes a raw
                        # pointer, not a sized buffer, and stage0 says nothing there.
                        # Unlike the two warnings above, a `can`/`trusted` block DOES grant it.
                        buffer_reinterpret_site: bool = selector == "cast" and (erasure_target != "" or reinterprets_wider) and pec_receiver_roots_at_buffer(receiver, buffer_locals, table)
                        table <- pec_record_unsafe_effect(owner, "Unsafe.BufferReinterpret", table) if not buffer_local_granted and buffer_reinterpret_site
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UngrantedBufferReinterpret, name: "", line: line.line, expected: "", actual: "", detail: "warn" if not enforce_unsafe_permissions else ""}) if not buffer_local_granted and buffer_reinterpret_site
                        pointer_numeric_cast: bool = not pointer_local_granted and not pointer_signature_granted and (any pointer_name in pointer_locals where pointer_name == ident_name_of(receiver)) and pec_numeric_name(erasure_base_type_name(target)) and not type_marker_present_here(target, TokenKind.Ampersand)
                        # A buffer reinterpret is ALSO a pointer cast. `&buf[i]` is an `elem&`
                        # and the target is a differently-typed reference, so stage0's
                        # `isPointerLikeCastType(src) && isPointerLikeCastType(dst)` holds and
                        # BOTH permissions are recorded at the one site -- in default mode as
                        # two warnings, under enforcement as two errors. Same site condition as
                        # `buffer_reinterpret_site`, so the buffer-root gate covers this too.
                        buffer_pointer_cast: bool = not pointer_local_granted and buffer_reinterpret_site
                        # `x.ref[T]` in its REINTERPRET form. stage0 reports the removed
                        # shorthand and then still records Unsafe.PointerCast at that site --
                        # the borrow form (`use &x`) records nothing, which is why this reads
                        # the line list check_redundant_cast filled rather than re-typing here.
                        ref_reinterpret_cast: bool = not pointer_local_granted and selector == "ref" and (any shorthand_line in table.ref_reinterpret_lines where shorthand_line == line.line)
                        needs_pointer_cast: bool = strict_pointer_cast or generic_reinterpret or default_pointer_cast or numeric_pointer_cast or default_void_erasure or pointer_numeric_cast or buffer_pointer_cast or ref_reinterpret_cast or (legacy_walk and not pointer_local_granted and field_receiver and pointer_erasure_target(target))
                        cast_site: bool = selector == "cast" or ref_reinterpret_cast
                        table <- pec_record_unsafe_effect(owner, "Unsafe.PointerCast", table) if cast_site and needs_pointer_cast
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UngrantedPointerCast, name: "", line: line.line, expected: "", actual: "", detail: "warn" if default_pointer_cast or default_void_erasure or (generic_reinterpret and not enforce_unsafe_permissions) or ((numeric_pointer_cast or buffer_pointer_cast or ref_reinterpret_cast) and not enforce_unsafe_permissions) else ""}) if cast_site and needs_pointer_cast
                        table <- check_pointer_erasure_expression(receiver, owner, function_line, parameters, signature_effects, local_grants, trusted_grants, enforce_unsafe_permissions, legacy_walk, immutable_params, numeric_locals, pointer_locals, buffer_locals, nul_names, table)
                    Expr.Call(callee, arguments, argument_names, line):
                        # Calling a generic type parameter as a conversion target has the
                        # same representation uncertainty as `.cast[T]`. Check it in both
                        # strict mode and the legacy generic walk; a local unsafe grant is
                        # required under `# strict`, while a function effect suppresses the
                        # default-mode warning.
                        generic_conversion: bool = match callee:
                            Expr.Field(receiver, target_name, target_line): legacy_walk and arguments.count == 0 and function_generic_param_named(table, function_line, target_name) and not pointer_local_granted and (enforce_unsafe_permissions or not pointer_signature_granted)
                            _: false
                        table <- pec_record_unsafe_effect(owner, "Unsafe.PointerCast", table) if generic_conversion
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UngrantedPointerCast, name: "", line: line.line, expected: "", actual: "", detail: "warn" if not enforce_unsafe_permissions else ""}) if generic_conversion
                        table <- check_pointer_erasure_expression(callee, owner, function_line, parameters, signature_effects, local_grants, trusted_grants, enforce_unsafe_permissions, legacy_walk, immutable_params, numeric_locals, pointer_locals, buffer_locals, nul_names, table)
                        for argument in arguments |table|:
                            table <- check_pointer_erasure_expression(argument, owner, function_line, parameters, signature_effects, local_grants, trusted_grants, enforce_unsafe_permissions, legacy_walk, immutable_params, numeric_locals, pointer_locals, buffer_locals, nul_names, table)
                    Expr.Binary(left, operator, right, line):
                        table <- check_pointer_erasure_expression(left, owner, function_line, parameters, signature_effects, local_grants, trusted_grants, enforce_unsafe_permissions, legacy_walk, immutable_params, numeric_locals, pointer_locals, buffer_locals, nul_names, table)
                        table <- check_pointer_erasure_expression(right, owner, function_line, parameters, signature_effects, local_grants, trusted_grants, enforce_unsafe_permissions, legacy_walk, immutable_params, numeric_locals, pointer_locals, buffer_locals, nul_names, table)
                    Expr.Paren(inner, line) | Expr.Unary(_, inner, line):
                        table <- check_pointer_erasure_expression(inner, owner, function_line, parameters, signature_effects, local_grants, trusted_grants, enforce_unsafe_permissions, legacy_walk, immutable_params, numeric_locals, pointer_locals, buffer_locals, nul_names, table)
                    Expr.Construct(type_expression, fields, line) | Expr.RecordUpdate(type_expression, fields, line):
                        for field in fields |table|:
                            table <- check_pointer_erasure_expression(field.value, owner, function_line, parameters, signature_effects, local_grants, trusted_grants, enforce_unsafe_permissions, legacy_walk, immutable_params, numeric_locals, pointer_locals, buffer_locals, nul_names, table)
                    _:
                        pass


        def check_pointer_erasure_statements(statements: darray[Ast::Stmt], owner: sview, function_line: u32, parameters: darray[Ast::ParamDecl], signature_effects: darray[sview]&, local_grants: darray[sview]&, trusted_grants: darray[sview]&, enforce_unsafe_permissions: bool, legacy_walk: bool, immutable_params: darray[sview]&, numeric_locals: darray[sview]&, pointer_locals: darray[sview]&, buffer_locals: darray[sview]&, nul_names: mutable darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table|:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line) | Stmt.Assign(type_expression, _, value, line):
                            table <- check_pointer_erasure_expression(value, owner, function_line, parameters, signature_effects, local_grants, trusted_grants, enforce_unsafe_permissions, legacy_walk, immutable_params, numeric_locals, pointer_locals, buffer_locals, nul_names, table)
                        Stmt.Expr(expression, line):
                            table <- check_pointer_erasure_expression(expression, owner, function_line, parameters, signature_effects, local_grants, trusted_grants, enforce_unsafe_permissions, legacy_walk, immutable_params, numeric_locals, pointer_locals, buffer_locals, nul_names, table)
                            pec_nul_update(expression, nul_names)
                        Stmt.Return(value, line):
                                table <- check_pointer_erasure_expression(returned, owner, function_line, parameters, signature_effects, local_grants, trusted_grants, enforce_unsafe_permissions, legacy_walk, immutable_params, numeric_locals, pointer_locals, buffer_locals, nul_names, table) if value is returned
                        Stmt.If(condition, then_body, else_body, line):
                            table <- check_pointer_erasure_expression(condition, owner, function_line, parameters, signature_effects, local_grants, trusted_grants, enforce_unsafe_permissions, legacy_walk, immutable_params, numeric_locals, pointer_locals, buffer_locals, nul_names, table)
                            table <- check_pointer_erasure_statements(then_body, owner, function_line, parameters, signature_effects, local_grants, trusted_grants, enforce_unsafe_permissions, legacy_walk, immutable_params, numeric_locals, pointer_locals, buffer_locals, nul_names, table)
                            table <- check_pointer_erasure_statements(else_body, owner, function_line, parameters, signature_effects, local_grants, trusted_grants, enforce_unsafe_permissions, legacy_walk, immutable_params, numeric_locals, pointer_locals, buffer_locals, nul_names, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            nested_local_grants: mutable darray[sview] = []
                            nested_local_grants.extend(local_grants)
                            nested_local_grants.extend(clause) if kind == "can"
                            nested_trusted_grants: mutable darray[sview] = []
                            nested_trusted_grants.extend(trusted_grants)
                            nested_trusted_grants.extend(clause) if kind == "trusted"
                            table <- check_pointer_erasure_statements(body, owner, function_line, parameters, signature_effects, nested_local_grants, nested_trusted_grants, enforce_unsafe_permissions, legacy_walk, immutable_params, numeric_locals, pointer_locals, buffer_locals, nul_names, table)
                        Stmt.While(_, body, line) | Stmt.For(_, _, _, body, line):
                            table <- check_pointer_erasure_statements(body, owner, function_line, parameters, signature_effects, local_grants, trusted_grants, enforce_unsafe_permissions, legacy_walk, immutable_params, numeric_locals, pointer_locals, buffer_locals, nul_names, table)
                        _:
                            pass


        def pointer_erasure_generic_line(lines: darray[u32]&, line: u32) -> bool:
            can Abort.Panic:
                for generic_line in lines:
                    true return if generic_line == line
                return false


        # A bare primitive numeric type name — the `IsNumericType` side of stage0's pointer-cast
        # rule. Excludes bool/cstr/void (non-numeric) and every non-primitive.
        def pec_numeric_name(name: sview) -> bool:
            can Abort.Panic:
                return when name:
                    "i8" | "i16" | "i32" | "i64" | "u8" | "u16" | "u32" | "u64" | "usize" | "isize" | "uintptr" | "int" | "uint" | "f16" | "f32" | "f64" | "byte" -> true
                    _ -> false

        # Whether a local/param TYPE spelling is a plain numeric value (walks through `mutable`/
        # `lmut` value markers but NOT through `&` — a ref type is pointer-like, not numeric).
        def pec_type_is_numeric(type_expression: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                match type_expression:
                    Expr.Unary(operator, operand, unary_line):
                        false return if operator == TokenKind.Ampersand
                        return pec_type_is_numeric(operand)
                    Expr.Paren(inner, paren_line):
                        return pec_type_is_numeric(inner)
                    Expr.Ident(name, ident_line):
                        return pec_numeric_name(name)
                    _:
                        return false

        # Collect the names of every numeric-typed local declared anywhere in a function body,
        # so a `name.cast[T&]` receiver can be classified as a numeric->ref pointer cast.
        def pec_collect_numeric_locals(statements: darray[Ast::Stmt], numeric_locals: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |numeric_locals|:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            numeric_locals.push(name) if pec_type_is_numeric(type_expression)
                        Stmt.If(condition, then_body, else_body, line):
                            pec_collect_numeric_locals(then_body, numeric_locals)
                            pec_collect_numeric_locals(else_body, numeric_locals)
                        Stmt.Block(kind, clause, binding, body, line):
                            pec_collect_numeric_locals(body, numeric_locals)
                        Stmt.While(condition, while_body, while_line) | Stmt.For(_, _, _, while_body, while_line):
                            pec_collect_numeric_locals(while_body, numeric_locals)
                        Stmt.Match(scrutinee, arms, match_line):
                            for arm in arms |numeric_locals|:
                                pec_collect_numeric_locals(arm.body, numeric_locals)
                        _:
                            pass

        # Only a darray, fixed array, or view has a known buffer extent. Reference and
        # mutability wrappers preserve that underlying extent (`mutable darray[T]&` is still
        # a sized buffer); a bare reference such as `static u8&` remains an unsized raw pointer.
        def pec_type_is_sized_buffer(type_expression: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                match type_expression:
                    Expr.Unary(operator, operand, unary_line):
                        return pec_type_is_sized_buffer(operand)
                    Expr.Paren(inner, paren_line):
                        return pec_type_is_sized_buffer(inner)
                    Expr.Index(head, argument, index_line):
                        head_name: sview = ident_name_of(head)
                        true return if head_name == "darray" or head_name == "view"
                        return match argument:
                            Expr.IntLit(extent_value, extent_line): head_name != ""
                            _: false
                    Expr.IndexN(head_n, arguments, index_n_line):
                        head_n_name: sview = ident_name_of(head_n)
                        return head_n_name == "darray" or head_n_name == "view"
                    _:
                        return false


        def pec_collect_buffer_locals(statements: darray[Ast::Stmt], buffer_locals: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |buffer_locals|:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            buffer_locals.push(name) if pec_type_is_sized_buffer(type_expression)
                        Stmt.If(condition, then_body, else_body, line):
                            pec_collect_buffer_locals(then_body, buffer_locals)
                            pec_collect_buffer_locals(else_body, buffer_locals)
                        Stmt.Block(kind, clause, binding, body, line):
                            pec_collect_buffer_locals(body, buffer_locals)
                        Stmt.While(_, body, while_line) | Stmt.For(_, _, _, body, while_line):
                            pec_collect_buffer_locals(body, buffer_locals)
                        Stmt.Match(scrutinee, arms, match_line):
                            for arm in arms |buffer_locals|:
                                pec_collect_buffer_locals(arm.body, buffer_locals)
                        _:
                            pass


        # A struct FIELD that is itself a sized buffer (`data: mutable darray[u8]`), read off
        # the interned field rows. Resolved by field NAME across every struct: the semantic
        # phase keeps type names bare, so the receiver's own struct is not always recoverable
        # here, and a field of this name that is a buffer somewhere is the closest sound
        # answer -- the alternative (never firing on a field receiver) drops the whole family.
        def pec_field_is_sized_buffer(table: SymbolTable&, field_name: sview) -> bool:
            can Abort.Panic:
                false return if field_name == ""
                paired: mutable usize = table.struct_field_name.count
                paired <- table.struct_field_type_id.count if paired > table.struct_field_type_id.count
                for row_index in 0..<paired |table, field_name|:
                    continue if table.struct_field_name[row_index] != field_name
                    row_id: u32 = table.struct_field_type_id[row_index]
                    continue if interned_kind(row_id, table) != SemTypeKind.Container
                    head: sview = interned_name(row_id, table)
                    true return if head == "darray" or head == "array" or head == "view"
                return false


        # stage0's `castOperandRootsAtBufferIndex`: walk through parens / address-of / casts
        # to the INDEX at the root, and ask whether the thing being indexed is a sized buffer.
        def pec_indexed_object_is_buffer(indexed_object: Ast::Expr, buffer_locals: darray[sview]&, table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                match indexed_object:
                    Expr.Paren(inner, paren_line):
                        return pec_indexed_object_is_buffer(inner, buffer_locals, table)
                    Expr.Ident(object_name, object_line):
                        return any known in buffer_locals where known == object_name
                    Expr.Field(field_object, field_name, field_line):
                        return pec_field_is_sized_buffer(table, field_name)
                    _:
                        return false


        def pec_receiver_roots_at_buffer(receiver: Ast::Expr, buffer_locals: darray[sview]&, table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                match receiver:
                    Expr.Paren(inner, paren_line):
                        return pec_receiver_roots_at_buffer(inner, buffer_locals, table)
                    Expr.Unary(operator, operand, unary_line):
                        return pec_receiver_roots_at_buffer(operand, buffer_locals, table) if operator == TokenKind.Ampersand
                        return false
                    Expr.Index(indexed_object, index_expression, index_line):
                        return pec_indexed_object_is_buffer(indexed_object, buffer_locals, table)
                    _:
                        return false


        def pec_collect_pointer_locals(statements: darray[Ast::Stmt], pointer_locals: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |pointer_locals|:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            pointer_locals.push(name) if type_marker_present_here(type_expression, TokenKind.Ampersand)
                        Stmt.If(condition, then_body, else_body, line):
                            pec_collect_pointer_locals(then_body, pointer_locals)
                            pec_collect_pointer_locals(else_body, pointer_locals)
                        Stmt.Block(kind, clause, binding, body, line):
                            pec_collect_pointer_locals(body, pointer_locals)
                        Stmt.While(_, body, while_line) | Stmt.For(_, _, _, body, while_line):
                            pec_collect_pointer_locals(body, pointer_locals)
                        Stmt.Match(scrutinee, arms, match_line):
                            for arm in arms |pointer_locals|:
                                pec_collect_pointer_locals(arm.body, pointer_locals)
                        _:
                            pass

        def check_pointer_erasure_declarations(declarations: darray[Ast::Decl], generic_lines: darray[u32]&, enforce_unsafe_permissions: bool, runtime_std: bool, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table|:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            immutable_params: mutable darray[sview] = []
                            # The runtime stdlib is a trusted implementation boundary in both
                            # compiler generations. Suppress source-level cast diagnostics for
                            # it as a whole, not just the numeric->ref subset: profiler hooks
                            # and arena internals intentionally use typed erasure, widening, and
                            # pointer casts that are audited once at the trusted boundary.
                            numeric_locals: mutable darray[sview] = []
                            pointer_locals: mutable darray[sview] = []
                            buffer_locals: mutable darray[sview] = []
                            for parameter in params |immutable_params, numeric_locals|:
                                is_mutable_binding: bool = parameter.is_mutable or type_marker_present_here(parameter.type_expression, TokenKind.Mutable)
                                immutable_params.push(parameter.name) if not is_mutable_binding
                                numeric_locals.push(parameter.name) if pec_type_is_numeric(parameter.type_expression) and not runtime_std
                                pointer_locals.push(parameter.name) if type_marker_present_here(parameter.type_expression, TokenKind.Ampersand)
                                buffer_locals.push(parameter.name) if pec_type_is_sized_buffer(parameter.type_expression)
                            pec_collect_numeric_locals(body, numeric_locals) if not runtime_std
                            pec_collect_pointer_locals(body, pointer_locals)
                            pec_collect_buffer_locals(body, buffer_locals)
                            nul_names: mutable darray[sview] = []
                            no_pointer_grants: darray[sview] = []
                            no_trusted_grants: darray[sview] = []
                            table <- check_pointer_erasure_statements(body, name, line.line, params, effects, no_pointer_grants, no_trusted_grants, enforce_unsafe_permissions, enforce_unsafe_permissions or pointer_erasure_generic_line(generic_lines, line.line), immutable_params, numeric_locals, pointer_locals, buffer_locals, nul_names, table)
                        Decl.Module(name, body, line) | Decl.Scoped(body, line):
                            table <- check_pointer_erasure_declarations(body, generic_lines, enforce_unsafe_permissions, runtime_std, table)
                        _:
                            pass

    public:
        def check_pointer_erasure_cast(file: Ast::File&, enforce_unsafe_permissions: bool, runtime_std: bool, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- check_pointer_erasure_declarations(file.top_decls, file.generic_param_lines, enforce_unsafe_permissions, runtime_std, table)
