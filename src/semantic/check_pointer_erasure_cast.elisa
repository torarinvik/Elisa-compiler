# A field-backed typed pointer erased to `void&` is an unsafe pointer reinterpretation.
# Keep this deliberately structural: numeric conversions and pointer casts encapsulated
# inside trusted/runtime wrappers are outside this check's ownership.
extend Semantic:
    private:
        def pointer_erasure_target(expression: Ast::Expr) -> bool:
            can Abort.Panic:
                return bare_type_name_through_ref(expression) == "void"


        def pointer_erasure_field_receiver(expression: Ast::Expr) -> bool:
            can Abort.Panic:
                match expression:
                    Expr.Field(_, _, _):
                        return true
                    _:
                        return false


        def check_pointer_erasure_expression(expression: Ast::Expr, in_trusted: bool, enforce_unsafe_permissions: bool, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Index(Expr.Field(receiver, selector, field_line), target, line):
                        field_receiver: bool = pointer_erasure_field_receiver(receiver)
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UngrantedPointerCast, name: "", line: line, expected: "", actual: ""}) if not in_trusted and selector == "cast" and (enforce_unsafe_permissions or (field_receiver and pointer_erasure_target(target)))
                        table <- check_pointer_erasure_expression(receiver, in_trusted, enforce_unsafe_permissions, table)
                    Expr.Call(callee, arguments, argument_names, line):
                        for argument in arguments |table|:
                            table <- check_pointer_erasure_expression(argument, in_trusted, enforce_unsafe_permissions, table)
                    Expr.Binary(left, operator, right, line):
                        table <- check_pointer_erasure_expression(left, in_trusted, enforce_unsafe_permissions, table)
                        table <- check_pointer_erasure_expression(right, in_trusted, enforce_unsafe_permissions, table)
                    Expr.Paren(inner, line) | Expr.Unary(_, inner, line):
                        table <- check_pointer_erasure_expression(inner, in_trusted, enforce_unsafe_permissions, table)
                    Expr.Construct(type_expression, fields, line) | Expr.RecordUpdate(type_expression, fields, line):
                        for field in fields |table|:
                            table <- check_pointer_erasure_expression(field.value, in_trusted, enforce_unsafe_permissions, table)
                    _:
                        pass


        def check_pointer_erasure_statements(statements: darray[Ast::Stmt], in_trusted: bool, enforce_unsafe_permissions: bool, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table|:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line) | Stmt.Assign(type_expression, _, value, line):
                            table <- check_pointer_erasure_expression(value, in_trusted, enforce_unsafe_permissions, table)
                        Stmt.Expr(expression, line):
                            table <- check_pointer_erasure_expression(expression, in_trusted, enforce_unsafe_permissions, table)
                        Stmt.Return(value, line):
                            table <- check_pointer_erasure_expression(returned, in_trusted, enforce_unsafe_permissions, table) if value is returned
                        Stmt.If(condition, then_body, else_body, line):
                            table <- check_pointer_erasure_expression(condition, in_trusted, enforce_unsafe_permissions, table)
                            table <- check_pointer_erasure_statements(then_body, in_trusted, enforce_unsafe_permissions, table)
                            table <- check_pointer_erasure_statements(else_body, in_trusted, enforce_unsafe_permissions, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- check_pointer_erasure_statements(body, in_trusted or kind == "trusted", enforce_unsafe_permissions, table)
                        Stmt.While(_, body, line) | Stmt.For(_, _, _, body, line):
                            table <- check_pointer_erasure_statements(body, in_trusted, enforce_unsafe_permissions, table)
                        _:
                            pass


        def pointer_erasure_generic_line(lines: darray[u32]&, line: u32) -> bool:
            can Abort.Panic:
                for generic_line in lines:
                    true return if generic_line == line
                return false


        def check_pointer_erasure_declarations(declarations: darray[Ast::Decl], generic_lines: darray[u32]&, enforce_unsafe_permissions: bool, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table|:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            table <- check_pointer_erasure_statements(body, false, enforce_unsafe_permissions, table) if enforce_unsafe_permissions or pointer_erasure_generic_line(generic_lines, line)
                        Decl.Module(name, body, line) | Decl.Scoped(body, line):
                            table <- check_pointer_erasure_declarations(body, generic_lines, enforce_unsafe_permissions, table)
                        _:
                            pass

    public:
        def check_pointer_erasure_cast(file: Ast::File&, enforce_unsafe_permissions: bool, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- check_pointer_erasure_declarations(file.top_decls, file.generic_param_lines, enforce_unsafe_permissions, table)
