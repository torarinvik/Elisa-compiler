# A field-backed typed pointer erased to `void&` is an unsafe pointer reinterpretation.
# Keep this deliberately structural: numeric conversions and pointer casts encapsulated
# inside trusted/runtime wrappers are outside this check's ownership.
extend Semantic:
    private:
        def pointer_erasure_target(expression: Ast::Expr) -> bool:
            can Abort.Panic:
                return bare_type_name_through_ref(expression) == "void"


        def pointer_erasure_field_receiver(expression: Ast::Expr) -> bool:
            can Abort.Panic:
                match expression:
                    Expr.Field(_, _, _):
                        return true
                    _:
                        return false


        # Whether a `.cast[T]` target spelling is pointer-like (any ref wrapper).
        # A bare non-ref target (`value.cast[SymbolTableId]`, numeric/id value casts)
        # is NOT a pointer cast — stage0 requires no Unsafe grant for it.
        def cast_target_is_pointer(expression: Ast::Expr) -> bool:
            can Abort.Panic:
                match expression:
                    # ANY unary type wrapper (`&`, mutable, lmut, heap, ...) marks a
                    # pointer-ish target; a value cast target is a bare (possibly
                    # generic) type name with no wrapper.
                    Expr.Unary(operator, operand, unary_line):
                        return true
                    Expr.Paren(inner, paren_line):
                        return cast_target_is_pointer(inner)
                    _:
                        return false

        # Whether a cast TARGET spells a MUTABLE reference (`mutable T&`) — the
        # default-mode warning shape: reinterpreting an address as a mutable
        # borrow. A shared-ref target (`T&`) is accepted silently by stage0.
        def cast_target_is_mutable_ref(expression: Ast::Expr) -> bool:
            can Abort.Panic:
                match expression:
                    Expr.Unary(operator, operand, unary_line):
                        true return if operator == TokenKind.Mutable
                        return cast_target_is_mutable_ref(operand)
                    Expr.Paren(inner, paren_line):
                        return cast_target_is_mutable_ref(inner)
                    _:
                        return false

        # The bare ident under a visible address-of receiver (`(&x)` -> "x"; "" otherwise).
        def address_of_base_name(expression: Ast::Expr) -> sview:
            can Abort.Panic:
                match expression:
                    Expr.Unary(operator, operand, unary_line):
                        ident_name_of(operand) return if operator == TokenKind.Ampersand
                        return address_of_base_name(operand)
                    Expr.Paren(inner, paren_line):
                        return address_of_base_name(inner)
                    _:
                        return sview("", 0, 0)

        # Whether the cast RECEIVER is visibly an address-of (`(&x).cast[usize]`) —
        # a ref-to-integer erasure that stays a pointer cast even with a scalar target.
        def cast_receiver_is_address(expression: Ast::Expr) -> bool:
            can Abort.Panic:
                match expression:
                    Expr.Unary(operator, operand, unary_line):
                        return operator == TokenKind.Ampersand or cast_receiver_is_address(operand)
                    Expr.Paren(inner, paren_line):
                        return cast_receiver_is_address(inner)
                    _:
                        return false

        def check_pointer_erasure_expression(expression: Ast::Expr, in_trusted: bool, enforce_unsafe_permissions: bool, signature_granted: bool, legacy_walk: bool, immutable_params: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Index(Expr.Field(receiver, selector, field_line), target, line):
                        field_receiver: bool = pointer_erasure_field_receiver(receiver)
                        strict_pointer_cast: bool = enforce_unsafe_permissions and (cast_target_is_pointer(target) or cast_receiver_is_address(receiver) or field_receiver)
                        # Default (non-strict) mode still WARNS on a visible
                        # pointer reinterpretation: a ref-typed cast target over an
                        # address-of receiver (`(&x).cast[mutable T&]`).
                        address_base: sview = address_of_base_name(receiver)
                        default_pointer_cast: bool = not enforce_unsafe_permissions and not signature_granted and cast_target_is_mutable_ref(target) and address_base != "" and (any p in immutable_params where p == address_base)
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UngrantedPointerCast, name: "", line: line, expected: "", actual: "", detail: "warn" if default_pointer_cast else ""}) if not in_trusted and selector == "cast" and (strict_pointer_cast or default_pointer_cast or (legacy_walk and field_receiver and pointer_erasure_target(target)))
                        table <- check_pointer_erasure_expression(receiver, in_trusted, enforce_unsafe_permissions, signature_granted, legacy_walk, immutable_params, table)
                    Expr.Call(callee, arguments, argument_names, line):
                        for argument in arguments |table|:
                            table <- check_pointer_erasure_expression(argument, in_trusted, enforce_unsafe_permissions, signature_granted, legacy_walk, immutable_params, table)
                    Expr.Binary(left, operator, right, line):
                        table <- check_pointer_erasure_expression(left, in_trusted, enforce_unsafe_permissions, signature_granted, legacy_walk, immutable_params, table)
                        table <- check_pointer_erasure_expression(right, in_trusted, enforce_unsafe_permissions, signature_granted, legacy_walk, immutable_params, table)
                    Expr.Paren(inner, line) | Expr.Unary(_, inner, line):
                        table <- check_pointer_erasure_expression(inner, in_trusted, enforce_unsafe_permissions, signature_granted, legacy_walk, immutable_params, table)
                    Expr.Construct(type_expression, fields, line) | Expr.RecordUpdate(type_expression, fields, line):
                        for field in fields |table|:
                            table <- check_pointer_erasure_expression(field.value, in_trusted, enforce_unsafe_permissions, signature_granted, legacy_walk, immutable_params, table)
                    _:
                        pass


        def check_pointer_erasure_statements(statements: darray[Ast::Stmt], in_trusted: bool, enforce_unsafe_permissions: bool, signature_granted: bool, legacy_walk: bool, immutable_params: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table|:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line) | Stmt.Assign(type_expression, _, value, line):
                            table <- check_pointer_erasure_expression(value, in_trusted, enforce_unsafe_permissions, signature_granted, legacy_walk, immutable_params, table)
                        Stmt.Expr(expression, line):
                            table <- check_pointer_erasure_expression(expression, in_trusted, enforce_unsafe_permissions, signature_granted, legacy_walk, immutable_params, table)
                        Stmt.Return(value, line):
                            table <- check_pointer_erasure_expression(returned, in_trusted, enforce_unsafe_permissions, signature_granted, legacy_walk, immutable_params, table) if value is returned
                        Stmt.If(condition, then_body, else_body, line):
                            table <- check_pointer_erasure_expression(condition, in_trusted, enforce_unsafe_permissions, signature_granted, legacy_walk, immutable_params, table)
                            table <- check_pointer_erasure_statements(then_body, in_trusted, enforce_unsafe_permissions, signature_granted, legacy_walk, immutable_params, table)
                            table <- check_pointer_erasure_statements(else_body, in_trusted, enforce_unsafe_permissions, signature_granted, legacy_walk, immutable_params, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- check_pointer_erasure_statements(body, in_trusted or kind == "trusted", enforce_unsafe_permissions, signature_granted or kind == "can" or kind == "trusted", legacy_walk, immutable_params, table)
                        Stmt.While(_, body, line) | Stmt.For(_, _, _, body, line):
                            table <- check_pointer_erasure_statements(body, in_trusted, enforce_unsafe_permissions, signature_granted, legacy_walk, immutable_params, table)
                        _:
                            pass


        def pointer_erasure_generic_line(lines: darray[u32]&, line: u32) -> bool:
            can Abort.Panic:
                for generic_line in lines:
                    true return if generic_line == line
                return false


        def check_pointer_erasure_declarations(declarations: darray[Ast::Decl], generic_lines: darray[u32]&, enforce_unsafe_permissions: bool, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table|:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            immutable_params: mutable darray[sview] = []
                            for parameter in params |immutable_params|:
                                is_mutable_binding: bool = parameter.is_mutable or type_marker_present(parameter.type_expression, TokenKind.Mutable)
                                immutable_params.push(parameter.name) if not is_mutable_binding
                            table <- check_pointer_erasure_statements(body, false, enforce_unsafe_permissions, effects.count > 0, enforce_unsafe_permissions or pointer_erasure_generic_line(generic_lines, line), immutable_params, table)
                        Decl.Module(name, body, line) | Decl.Scoped(body, line):
                            table <- check_pointer_erasure_declarations(body, generic_lines, enforce_unsafe_permissions, table)
                        _:
                            pass

    public:
        def check_pointer_erasure_cast(file: Ast::File&, enforce_unsafe_permissions: bool, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- check_pointer_erasure_declarations(file.top_decls, file.generic_param_lines, enforce_unsafe_permissions, table)
