# Closed set of named container types whose indices cannot be negative.
module NegativeIndexSequenceType:
    public:
        def is_sequence_type_name(type_name: sview) -> bool:
            ensure result == (
                when type_name:
                    "darray" | "view" | "sview" -> true
                    _ -> false
            )
            can Abort.Panic:
                return when type_name:
                    "darray" | "view" | "sview" -> true
                    _ -> false
