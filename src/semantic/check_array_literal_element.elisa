# Fixed-array element type mismatch: a fixed-size array VarDecl (`xs: i64[2] = [1, "s"]`)
# whose annotated element type is a bare primitive, where an element of the array-literal
# value (literal or firm) can NEVER fit that element type. E.g. `xs: i64[2] = [1, "s"]`
# fires because "s" is a string literal and string literals never fit i64.
# Sound subset: only bare-primitive fixed-array annotations (`i64[2]`, not `darray[T]` or
# generics); only literal/firm elements whose family is provably incompatible (same oracle
# as TypeMismatch's check_value_against — literal_never_fits / firm_never_fits). Unknown-
# family elements (calls, constructs, Named-typed locals, ...) never fire.

extend Semantic:
    private:
        # Extract the bare element-type name from a fixed-size array TYPE annotation
        # `ElemType[Size]` — i.e. `Expr.Index(object: Expr.Ident(elem_type_name), index: IntLit)`.
        # Returns "" if the annotation is not a fixed-size-array-of-Ident shape (darray[T],
        # generics, non-Ident element base, ... all skip).
        def extract_array_element_type_name(type_expr: Ast::Expr) -> sview:
            can Memory.Allocate, Abort.Panic:
                match type_expr:
                    Expr.Index(object, index, line):
                        match index:
                            Expr.IntLit(size_value):
                                match object:
                                    Expr.Ident(elem_name, ident_line):
                                        return elem_name
                                    _:
                                        return ""
                            _:
                                return ""
                    _:
                        return ""

        # Whether `type_name` is a bare primitive eligible for this check (mirrors the
        # gate used by TypeMismatch/check_value_against: integer/float/string types plus
        # bool/char).
        def is_array_element_primitive(type_name: sview) -> bool:
            can Abort.Panic:
                true return if is_integer_type_name(type_name) or is_float_type_name(type_name) or is_string_type_name(type_name)
                return type_name == "bool" or type_name == "char"

        # Check one array-literal element against the declared element type; push a
        # diagnostic if its literal kind or inferred family can never fit.
        def check_array_element_against(element: Ast::Expr, elem_type_name: sview, line: u32, var_types: darray[sview]&, type_names: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                literal_kind: sview = literal_kind_of(element)
                if literal_kind != "":
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ArrayLiteralElementTypeMismatch, name: "", line: line, expected: elem_type_name, actual: stage0_literal_spelling(literal_kind)}) if literal_never_fits(literal_kind, elem_type_name)
                else:
                    element_type: InferType = infer_expression_type(element, var_types, type_names, table)
                    element_family: sview = family_of_kind(element_type)
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ArrayLiteralElementTypeMismatch, name: "", line: line, expected: elem_type_name, actual: stage0_value_spelling(element_type)}) if element_family != "" and firm_never_fits(element_family, elem_type_name)

        # Walk through expressions, recursing into nested constructs so array literals in
        # nested positions (not just direct VarDecl values) are still walked for their
        # OWN sub-expressions (this check only fires at the VarDecl site itself, but the
        # recursive walk must still visit every expression so other nested VarDecls are
        # reached via the statement walk below).
        def walk_expression_for_array_literal_element(expression: Ast::Expr, table: lmut SymbolTable, var_types: mutable darray[sview]&, type_names: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Binary(left, operator, right, line):
                        table <- walk_expression_for_array_literal_element(left, table, var_types, type_names)
                        table <- walk_expression_for_array_literal_element(right, table, var_types, type_names) if operator != TokenKind.Is and operator != TokenKind.As
                    Expr.Call(callee, arguments, argument_names, line):
                        table <- walk_expression_for_array_literal_element(callee, table, var_types, type_names)
                        for argument in arguments |table|:
                            table <- walk_expression_for_array_literal_element(argument, table, var_types, type_names)
                    Expr.Field(object, field, line):
                        table <- walk_expression_for_array_literal_element(object, table, var_types, type_names)
                    Expr.Scope(base, name, line):
                        table <- walk_expression_for_array_literal_element(base, table, var_types, type_names)
                    Expr.Index(object, index, line):
                        table <- walk_expression_for_array_literal_element(object, table, var_types, type_names)
                        table <- walk_expression_for_array_literal_element(index, table, var_types, type_names) if not index_receiver_is_type_application(object)
                    Expr.Unary(operator, operand, line):
                        table <- walk_expression_for_array_literal_element(operand, table, var_types, type_names)
                    Expr.Paren(inner, line):
                        table <- walk_expression_for_array_literal_element(inner, table, var_types, type_names)
                    Expr.Array(elements, line):
                        for element in elements |table|:
                            table <- walk_expression_for_array_literal_element(element, table, var_types, type_names)
                    Expr.Tuple(elements, line):
                        for element in elements |table|:
                            table <- walk_expression_for_array_literal_element(element, table, var_types, type_names)
                    Expr.Slice(object, low, high, line):
                        table <- walk_expression_for_array_literal_element(object, table, var_types, type_names)
                        table <- walk_expression_for_array_literal_element(low, table, var_types, type_names)
                        table <- walk_expression_for_array_literal_element(high, table, var_types, type_names)
                    Expr.IndexN(object, arguments, line):
                        table <- walk_expression_for_array_literal_element(object, table, var_types, type_names)
                        for argument in arguments |table|:
                            table <- walk_expression_for_array_literal_element(argument, table, var_types, type_names) if not index_receiver_is_type_application(object)
                    Expr.SetLit(elements, line):
                        for element in elements |table|:
                            table <- walk_expression_for_array_literal_element(element, table, var_types, type_names)
                    Expr.DictLit(entries, line):
                        for entry in entries |table|:
                            table <- walk_expression_for_array_literal_element(entry.key, table, var_types, type_names)
                            table <- walk_expression_for_array_literal_element(entry.value, table, var_types, type_names)
                    Expr.Construct(type_expression, fields, line):
                        table <- walk_expression_for_array_literal_element(type_expression, table, var_types, type_names)
                        for field in fields |table|:
                            table <- walk_expression_for_array_literal_element(field.value, table, var_types, type_names)
                    Expr.RecordUpdate(base, fields, line):
                        table <- walk_expression_for_array_literal_element(base, table, var_types, type_names)
                        for field in fields |table|:
                            table <- walk_expression_for_array_literal_element(field.value, table, var_types, type_names)
                    Expr.If(condition, then_expr, else_expr, line):
                        table <- walk_expression_for_array_literal_element(condition, table, var_types, type_names)
                        table <- walk_expression_for_array_literal_element(then_expr, table, var_types, type_names)
                        table <- walk_expression_for_array_literal_element(else_expr, table, var_types, type_names)
                    Expr.Comprehension(loop_variable, iterable, condition, body, line):
                        table <- walk_expression_for_array_literal_element(iterable, table, var_types, type_names)
                        table <- walk_expression_for_array_literal_element(condition, table, var_types, type_names)
                        table <- walk_expression_for_array_literal_element(body, table, var_types, type_names)
                    Expr.Lambda(parameters, body, line):
                        table <- walk_statements_for_array_literal_element(body, table, var_types, type_names)
                    Expr.Block(statements, value, captures, line):
                        table <- walk_statements_for_array_literal_element(statements, table, var_types, type_names)
                        table <- walk_expression_for_array_literal_element(value, table, var_types, type_names)
                    Expr.Match(scrutinee, arms, line):
                        table <- walk_expression_for_array_literal_element(scrutinee, table, var_types, type_names)
                        for arm in arms |table|:
                            table <- walk_statements_for_array_literal_element(arm.body, table, var_types, type_names)
                    # Literals and other expressions don't contain relevant sub-expressions
                    _:
                        pass

        # Walk through statements, tracking variable types and checking fixed-array
        # VarDecls whose value is an array literal.
        def walk_statements_for_array_literal_element(statements: darray[Ast::Stmt], table: lmut SymbolTable, var_types: mutable darray[sview]&, type_names: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table|:
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- walk_expression_for_array_literal_element(expression, table, var_types, type_names)
                        Stmt.VarDecl(name, type_expression, value, line):
                            elem_type_name: sview = extract_array_element_type_name(type_expression)
                            if elem_type_name != "" and is_array_element_primitive(elem_type_name):
                                match value:
                                    Expr.Array(elements, array_line):
                                        for element in elements |table|:
                                            table <- check_array_element_against(element, elem_type_name, line.line, var_types, type_names, table)
                                    _:
                                        pass
                            # Record the local's own type and recurse into the value.
                            type_name: sview = bare_type_name(type_expression)
                            note_local_type(var_types, type_names, name, type_name)
                            table <- walk_expression_for_array_literal_element(value, table, var_types, type_names)
                        Stmt.Assign(target, operator, value, line):
                            table <- walk_expression_for_array_literal_element(target, table, var_types, type_names)
                            table <- walk_expression_for_array_literal_element(value, table, var_types, type_names)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- walk_expression_for_array_literal_element(condition, table, var_types, type_names)
                            table <- walk_statements_for_array_literal_element(then_body, table, var_types, type_names)
                            table <- walk_statements_for_array_literal_element(else_body, table, var_types, type_names)
                        Stmt.While(condition, body, line):
                            table <- walk_expression_for_array_literal_element(condition, table, var_types, type_names)
                            table <- walk_statements_for_array_literal_element(body, table, var_types, type_names)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- walk_expression_for_array_literal_element(iterable, table, var_types, type_names)
                            table <- walk_statements_for_array_literal_element(body, table, var_types, type_names)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- walk_statements_for_array_literal_element(body, table, var_types, type_names)
                        Stmt.Match(scrutinee, arms, line):
                            table <- walk_expression_for_array_literal_element(scrutinee, table, var_types, type_names)
                            for arm in arms |table|:
                                table <- walk_expression_for_array_literal_element(arm.guard, table, var_types, type_names)
                                table <- walk_statements_for_array_literal_element(arm.body, table, var_types, type_names)
                        Stmt.Return(value, line):
                            table <- walk_expression_for_array_literal_element(return_value, table, var_types, type_names) if value is return_value
                        Stmt.Contract(kind, expression, line):
                            table <- walk_expression_for_array_literal_element(expression, table, var_types, type_names)
                        Stmt.Invalid:
                            pass
                        Stmt.Break(label, line):
                            pass
                        Stmt.Continue(label, line):
                            pass

        # Walk through function declarations.
        def check_array_literal_element_declarations(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table|:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            var_types: mutable darray[sview] = []
                            type_names: mutable darray[sview] = []
                            for param in params |table|:
                                param_type: sview = bare_type_name(param.type_expression)
                                note_local_type(var_types, type_names, param.name, param_type)
                            table <- walk_statements_for_array_literal_element(body, table, var_types, type_names)
                        Decl.Module(module_name, body, line):
                            table <- check_array_literal_element_declarations(body, table)
                        Decl.Scoped(body, line):
                            table <- check_array_literal_element_declarations(body, table)
                        _:
                            pass

    public:
        # Public entry point for the check.
        def check_array_literal_element(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- check_array_literal_element_declarations(declarations, table)
