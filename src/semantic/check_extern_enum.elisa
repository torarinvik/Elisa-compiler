# docs/127 D9 — `extern enum Name of T:` mirrors a C enum, whose value set is open at the ABI.
#
# `match` exhaustiveness over an enum is only a sound proof for a value the LANGUAGE built. A
# value reinterpreted from a foreign integer carries no such guarantee, and the optimizer is
# entitled to assume the arms cover it — measured, the same program returned 12 from stage0,
# trapped in stage1, and produced a third answer at -O2. So the reinterpretation is refused:
# `Name.from_c(raw)` validates instead and hands back an error union the caller must handle.
#
# The check is SYNTACTIC on purpose. `x.Name()` and `Name(x)` are the only two spellings that
# produce a `Name` from something else, and both are visible without type information — which
# keeps this identical to stage0's rule without needing stage0's inference. The synthesized
# validator `Name__from_c` is exempt: its whole job is the one legitimate reinterpretation.
# Mirrors stage0's semantic/analyzer_foreign_enum.go.
extend Semantic:
    private:
        def foreign_enum_is_closed(table: SymbolTable&, type_name: sview) -> bool:
            can Abort.Panic:
                declared: bool = any name in table.foreign_enum_names where name == type_name
                is_open: bool = any name in table.open_foreign_enum_names where name == type_name
                return declared and not is_open

        # The two reinterpreting call shapes, reported at the call's own position.
        def check_foreign_enum_expression(expression: Ast::Expr, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, call_pos):
                        match callee:
                            # `raw.Name()` — the postfix conversion.
                            Expr.Field(object, field, field_pos):
                                table <- check_foreign_enum_expression(object, table)
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ForeignEnumReinterpret, name: field, pos: call_pos, line: call_pos.line, expected: "", actual: ""}) if arguments.count == 0 and foreign_enum_is_closed(table, field)
                            # `Name(raw)` — the constructor conversion.
                            Expr.Ident(callee_name, callee_pos):
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ForeignEnumReinterpret, name: callee_name, pos: call_pos, line: call_pos.line, expected: "", actual: ""}) if arguments.count == 1 and foreign_enum_is_closed(table, callee_name)
                            _:
                                table <- check_foreign_enum_expression(callee, table)
                        for argument in arguments |table|:
                            table <- check_foreign_enum_expression(argument, table)
                    Expr.Binary(left, operator, right, binary_pos):
                        table <- check_foreign_enum_expression(left, table)
                        table <- check_foreign_enum_expression(right, table)
                    Expr.Unary(operator, operand, unary_pos):
                        table <- check_foreign_enum_expression(operand, table)
                    Expr.Field(object, field, field_pos):
                        table <- check_foreign_enum_expression(object, table)
                    Expr.Index(object, index, index_pos):
                        table <- check_foreign_enum_expression(object, table)
                        table <- check_foreign_enum_expression(index, table)
                    Expr.If(condition, then_expr, else_expr, if_pos):
                        table <- check_foreign_enum_expression(condition, table)
                        table <- check_foreign_enum_expression(then_expr, table)
                        table <- check_foreign_enum_expression(else_expr, table)
                    _:
                        pass

        def check_foreign_enum_statements(statements: darray[Ast::Stmt], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table|:
                    match statement:
                        Stmt.Expr(expression, stmt_pos):
                            table <- check_foreign_enum_expression(expression, table)
                        Stmt.VarDecl(name, type_expression, value, stmt_pos):
                            table <- check_foreign_enum_expression(value, table)
                        Stmt.Assign(target, operator, value, stmt_pos):
                            table <- check_foreign_enum_expression(value, table)
                        Stmt.If(condition, then_body, else_body, stmt_pos):
                            table <- check_foreign_enum_expression(condition, table)
                            table <- check_foreign_enum_statements(then_body, table)
                            table <- check_foreign_enum_statements(else_body, table)
                        Stmt.While(condition, body, stmt_pos):
                            table <- check_foreign_enum_expression(condition, table)
                            table <- check_foreign_enum_statements(body, table)
                        Stmt.For(bind, variables, iterable, body, stmt_pos):
                            table <- check_foreign_enum_expression(iterable, table)
                            table <- check_foreign_enum_statements(body, table)
                        Stmt.Block(kind, clause, binding, body, stmt_pos):
                            table <- check_foreign_enum_statements(body, table)
                        Stmt.Match(scrutinee, arms, stmt_pos):
                            table <- check_foreign_enum_expression(scrutinee, table)
                            for arm in arms |table|:
                                table <- check_foreign_enum_statements(arm.body, table)
                        Stmt.Return(value, stmt_pos):
                            if value is returned_value:
                                table <- check_foreign_enum_expression(returned_value, table)
                        _:
                            pass

        def check_extern_enum(declarations: darray[Ast::Decl], annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for annotation in annotations |table|:
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ExternEnumStorageRequired, name: annotation.owner, pos: annotation.pos, line: annotation.pos.line, expected: "", actual: ""}) if annotation.name == "__extern_enum_no_storage"
                return if table.foreign_enum_names.count == 0
                for declaration in declarations |table|:
                    match declaration:
                        Decl.Func(function_name, params, return_type, body, effects, decorators, func_pos):
                            # The synthesized validator is the one legitimate reinterpretation.
                            is_validator: bool = any name in table.foreign_enum_names where Semantic::name_is_validator_of(function_name, name)
                            table <- check_foreign_enum_statements(body, table) if not is_validator
                        Decl.Scoped(body, scoped_pos):
                            table <- check_extern_enum(body, annotations, table)
                        _:
                            pass

        # True when `function_name` is exactly `enum_name` + "__from_c".
        def name_is_validator_of(function_name: sview, enum_name: sview) -> bool:
            can Abort.Panic:
                suffix: sview = "__from_c"
                return false if function_name.len != enum_name.len + suffix.len
                index: mutable usize = 0
                while index < enum_name.len |index|:
                    false return if function_name[index] != enum_name[index]
                    index <- index + 1
                suffix_index: mutable usize = 0
                while suffix_index < suffix.len |suffix_index|:
                    false return if function_name[enum_name.len + suffix_index] != suffix[suffix_index]
                    suffix_index <- suffix_index + 1
                return true
