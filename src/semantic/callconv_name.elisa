# Case-insensitive name handling mirrors stage0's normalizeExternCallConvAnnotationArg.
const module CallConvAscii:
    UPPER_A: u8 = 65
    UPPER_Z: u8 = 90
    CASE_FOLD_DELTA: u8 = 32

module CallConvName:
    public:
        const SINGLE_ARGUMENT_COUNT: u32 = 1

        def ascii_lower(value: u8) -> u8:
            ensure result == (value + CallConvAscii::CASE_FOLD_DELTA if value >= CallConvAscii::UPPER_A and value <= CallConvAscii::UPPER_Z else value)
            return value + CallConvAscii::CASE_FOLD_DELTA if value >= CallConvAscii::UPPER_A and value <= CallConvAscii::UPPER_Z else value

        def equals_ascii_case_insensitive(value: sview, expected: sview) -> bool can[Abort.Panic]:
            ensure result == (
                value.len == expected.len
                and (forall index in 0..<expected.len: index >= value.len or ascii_lower(sview_at(value, index)) == sview_at(expected, index))
            )
            can Abort.Panic:
                return false if value.len != expected.len
                index: mutable usize = 0
                while index < expected.len |index, value, expected|:
                    decreases expected.len - index
                    invariant forall prefix_index in 0..<index: ascii_lower(sview_at(value, prefix_index)) == sview_at(expected, prefix_index)
                    invariant index <= expected.len
                    return false if ascii_lower(sview_at(value, index)) != sview_at(expected, index)
                    index <- index + 1
                return true

        def matches_supported_ascii_case(name: sview) -> bool can[Abort.Panic]:
            ensure result == (
                equals_ascii_case_insensitive(name, "c")
                or equals_ascii_case_insensitive(name, "cdecl")
                or equals_ascii_case_insensitive(name, "default")
                or equals_ascii_case_insensitive(name, "fast")
                or equals_ascii_case_insensitive(name, "fastcall")
                or equals_ascii_case_insensitive(name, "cold")
                or equals_ascii_case_insensitive(name, "coldcc")
                or equals_ascii_case_insensitive(name, "stdcall")
                or equals_ascii_case_insensitive(name, "x86_stdcall")
                or equals_ascii_case_insensitive(name, "x86-stdcall")
                or equals_ascii_case_insensitive(name, "winapi")
                or equals_ascii_case_insensitive(name, "windows")
            )
            can Abort.Panic:
                return (
                    equals_ascii_case_insensitive(name, "c")
                    or equals_ascii_case_insensitive(name, "cdecl")
                    or equals_ascii_case_insensitive(name, "default")
                    or equals_ascii_case_insensitive(name, "fast")
                    or equals_ascii_case_insensitive(name, "fastcall")
                    or equals_ascii_case_insensitive(name, "cold")
                    or equals_ascii_case_insensitive(name, "coldcc")
                    or equals_ascii_case_insensitive(name, "stdcall")
                    or equals_ascii_case_insensitive(name, "x86_stdcall")
                    or equals_ascii_case_insensitive(name, "x86-stdcall")
                    or equals_ascii_case_insensitive(name, "winapi")
                    or equals_ascii_case_insensitive(name, "windows")
                )

        def matches_c_abi_ascii_case(name: sview) -> bool can[Abort.Panic]:
            ensure result == (
                equals_ascii_case_insensitive(name, "c")
                or equals_ascii_case_insensitive(name, "cdecl")
                or equals_ascii_case_insensitive(name, "default")
            )
            can Abort.Panic:
                return (
                    equals_ascii_case_insensitive(name, "c")
                    or equals_ascii_case_insensitive(name, "cdecl")
                    or equals_ascii_case_insensitive(name, "default")
                )

        def is_exact_lowercase_supported(name: sview) -> bool:
            ensure result == (
                when name:
                    "c" | "cdecl" | "default" | "fast" | "fastcall" | "cold" | "coldcc" | "stdcall" | "x86_stdcall" | "x86-stdcall" | "winapi" | "windows" -> true
                    _ -> false
            )
            return when name:
                    "c" | "cdecl" | "default" | "fast" | "fastcall" | "cold" | "coldcc" | "stdcall" | "x86_stdcall" | "x86-stdcall" | "winapi" | "windows" -> true
                    _ -> false

        def is_exact_lowercase_c_abi(name: sview) -> bool:
            ensure result == (
                when name:
                    "c" | "cdecl" | "default" -> true
                    _ -> false
            )
            return when name:
                    "c" | "cdecl" | "default" -> true
                    _ -> false

        def is_supported(name: sview) -> bool can[Abort.Panic]:
            ensure result == (matches_supported_ascii_case(name) or is_exact_lowercase_supported(name))
            can Abort.Panic:
                return matches_supported_ascii_case(name) or is_exact_lowercase_supported(name)

        def is_c_abi(name: sview) -> bool can[Abort.Panic]:
            ensure result == (matches_c_abi_ascii_case(name) or is_exact_lowercase_c_abi(name))
            can Abort.Panic:
                return matches_c_abi_ascii_case(name) or is_exact_lowercase_c_abi(name)
