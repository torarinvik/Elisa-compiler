# Independent portable operations captured by GA; no production include or cache enable.
extend Semantic:
    public:
        const INCREMENTAL_AUTHORITY_TRACE_VERSION: u32 = 1
        struct AuthorityByteSpan:
            start: usize
            length: usize
        # Four LE-u32 length-prefixed fields: source, module components, name, header.
        # Module components: LE-u32 count followed by length-prefixed names; root count zero.
        struct AuthorityDeclarationKey:
            bytes: AuthorityByteSpan
        struct AuthorityPositionAnchor:
            start_token: u32
            start_delta: u32
            end_token: u32
            end_delta: u32
        struct AuthorityPositionResult:
            valid: bool
            position: Ast::Pos
        const enum AuthorityEventKind of u8:
            GlobalRead
            GlobalWrite
            CallSite
            CanEntry
        const enum AuthorityGrantKind of u8:
            Can
            UnsafeFirewall
        # Unsafe firewalls contain expanded canonical Unsafe.* leaves only;
        # alias expansion occurs before capture. Unsupported Unicode stays cold.
        struct AuthorityTraceGrant:
            kind: AuthorityGrantKind
            name: AuthorityByteSpan
            scope: AuthorityByteSpan
        # Candidates retain authoritative order; one site produces one Global diagnostic.
        # Each CanEntry is one canonical entered ref in display_name and its
        # entered_scope; grant_start/count is the active OUTER stack immediately
        # before the clause is added. Emit clause refs in cold-walker order using
        # that same outer stack, then add the clause for following operations. Entries survive even without body operations.
        struct AuthorityTraceEvent:
            kind: AuthorityEventKind
            position: AuthorityPositionAnchor
            subject: AuthorityDeclarationKey
            display_name: AuthorityByteSpan
            entered_scope: AuthorityByteSpan
            candidate_start: usize
            candidate_count: usize
            grant_start: usize
            grant_count: usize
            declared_read: bool
            declared_write: bool
        # Owned exact canonical body token bytes; fingerprints never replace equality.
        struct AuthorityFunctionTrace:
            owner: AuthorityDeclarationKey
            body_tokens: AuthorityByteSpan
            events: darray[AuthorityTraceEvent]
            candidates: darray[AuthorityDeclarationKey]
            grants: darray[AuthorityTraceGrant]
            bytes: darray[u8]

        # Invocation-local lookup proof. Prepare once per body, then keep tokens and
        # their source immutable until capture completes; never persist this proof.
        struct AuthorityAnchorLookup:
            valid: bool
            body_start: usize
            body_end: usize
            token_count: usize
            source_length: usize

        struct AuthorityAnchorResult:
            valid: bool
            anchor: AuthorityPositionAnchor

        def authority_prepare_anchor_lookup(body_start: usize, body_end: usize, tokens: darray[Token]&, source: u8&, source_length: usize) -> AuthorityAnchorLookup:
            can Abort.Panic:
                miss: AuthorityAnchorLookup = AuthorityAnchorLookup{valid: false, body_start: body_start, body_end: body_end, token_count: tokens.count, source_length: source_length}
                return miss if body_start > body_end or body_end > tokens.count or body_end - body_start > 1000000
                return miss if source == null and source_length > 0
                previous_end: mutable u32 = 0
                for index in body_start..<body_end |previous_end|:
                    token: Token = tokens[index]
                    return miss if not authority_token_valid(token, source_length)
                    return miss if index != body_start and token.start < previous_end
                    previous_end <- token.start + token.length
                return AuthorityAnchorLookup{valid: true, body_start: body_start, body_end: body_end, token_count: tokens.count, source_length: source_length}

        # Two binary searches plus bounded endpoint-token scans, never a whole-source
        # scan. Exact reconstruction is the final acceptance condition. Quote spans,
        # whitespace gaps, line-only positions, and ambiguous synthetic-token runs
        # which this token/delta schema cannot express remain a cold capture miss.
        def authority_create_position_anchor(position: Ast::Pos, lookup: AuthorityAnchorLookup, tokens: darray[Token]&, source: u8&, source_length: usize) -> AuthorityAnchorResult:
            can Abort.Panic:
                miss: AuthorityAnchorResult = AuthorityAnchorResult{valid: false, anchor: AuthorityPositionAnchor{start_token: 0, start_delta: 0, end_token: 0, end_delta: 0}}
                return miss if not lookup.valid or lookup.token_count != tokens.count or lookup.source_length != source_length
                return miss if lookup.body_start > lookup.body_end or lookup.body_end > tokens.count or lookup.body_end - lookup.body_start > 1000000
                return miss if source == null and source_length > 0
                return miss if position.offset > position.end_offset or position.line == 0 or position.column == 0 or position.end_line == 0 or position.end_column == 0
                first: AuthorityAnchorResult = authority_find_anchor_point(position.offset, position.line, position.column, lookup, tokens, source, source_length)
                return miss if not first.valid
                last: AuthorityAnchorResult = authority_find_anchor_point(position.end_offset, position.end_line, position.end_column, lookup, tokens, source, source_length)
                return miss if not last.valid
                anchor: AuthorityPositionAnchor = AuthorityPositionAnchor{start_token: first.anchor.start_token, start_delta: first.anchor.start_delta, end_token: last.anchor.start_token, end_delta: last.anchor.start_delta}
                reconstructed: AuthorityPositionResult = authority_reconstruct_position_source(anchor, lookup.body_start, lookup.body_end, tokens, source, source_length)
                return miss if not reconstructed.valid
                at: Ast::Pos = reconstructed.position
                return miss if at.line != position.line or at.column != position.column or at.offset != position.offset or at.end_line != position.end_line or at.end_column != position.end_column or at.end_offset != position.end_offset
                return AuthorityAnchorResult{valid: true, anchor: anchor}

        struct AuthorityTraceBuilder:
            bytes: mutable darray[u8] = []
            events: mutable darray[AuthorityTraceEvent] = []
            candidates: mutable darray[AuthorityDeclarationKey] = []
            grants: mutable darray[AuthorityTraceGrant] = []
            owner: mutable AuthorityDeclarationKey = AuthorityDeclarationKey{bytes: AuthorityByteSpan{start: 0, length: 0}}
            body_tokens: mutable AuthorityByteSpan = AuthorityByteSpan{start: 0, length: 0}
            generation: mutable u64 = 0
            active: mutable bool = false
            valid: mutable bool = false

        struct AuthorityTraceCheckpoint:
            generation: u64
            byte_count: usize
            event_count: usize
            candidate_count: usize
            grant_count: usize
            owner: AuthorityDeclarationKey
            body_tokens: AuthorityByteSpan
            valid: bool

        struct AuthorityAppendResult:
            valid: bool
            span: AuthorityByteSpan

        struct AuthorityTraceFinish:
            valid: bool
            trace: AuthorityFunctionTrace

        def authority_builder_begin(builder: mutable AuthorityTraceBuilder&) -> bool:
            can Abort.Panic:
                return false if builder.active or builder.generation == 18446744073709551615
                builder.bytes.clear()
                builder.events.clear()
                builder.candidates.clear()
                builder.grants.clear()
                builder.owner <- AuthorityDeclarationKey{bytes: AuthorityByteSpan{start: 0, length: 0}}
                builder.body_tokens <- AuthorityByteSpan{start: 0, length: 0}
                builder.generation <- builder.generation + 1
                builder.active <- true
                builder.valid <- true
                return true

        def authority_builder_checkpoint(builder: AuthorityTraceBuilder&) -> AuthorityTraceCheckpoint:
            return AuthorityTraceCheckpoint{generation: builder.generation, byte_count: builder.bytes.count, event_count: builder.events.count, candidate_count: builder.candidates.count, grant_count: builder.grants.count, owner: builder.owner, body_tokens: builder.body_tokens, valid: builder.active and builder.valid}

        def authority_builder_rollback(builder: mutable AuthorityTraceBuilder&, trace_mark: AuthorityTraceCheckpoint) -> bool:
            can Abort.Panic:
                return false if not builder.active or trace_mark.generation != builder.generation
                return false if trace_mark.byte_count > builder.bytes.count or trace_mark.event_count > builder.events.count or trace_mark.candidate_count > builder.candidates.count or trace_mark.grant_count > builder.grants.count
                builder.bytes.truncate(trace_mark.byte_count)
                builder.events.truncate(trace_mark.event_count)
                builder.candidates.truncate(trace_mark.candidate_count)
                builder.grants.truncate(trace_mark.grant_count)
                builder.owner <- trace_mark.owner
                builder.body_tokens <- trace_mark.body_tokens
                builder.valid <- trace_mark.valid
                return true

        # Unsupported functions abort the whole transaction, never publish partial facts.
        def authority_builder_abort(builder: mutable AuthorityTraceBuilder&) -> void:
            can Abort.Panic:
                builder.bytes.clear()
                builder.events.clear()
                builder.candidates.clear()
                builder.grants.clear()
                builder.owner <- AuthorityDeclarationKey{bytes: AuthorityByteSpan{start: 0, length: 0}}
                builder.body_tokens <- AuthorityByteSpan{start: 0, length: 0}
                builder.active <- false
                builder.valid <- false

        # Input views borrow caller storage only for this call, never builder storage.
        # The builder copies with extend; no borrowed view survives in trace metadata.
        def authority_builder_append_view(builder: mutable AuthorityTraceBuilder&, value: sview) -> AuthorityAppendResult:
            can Memory.Allocate, Abort.Panic:
                miss: AuthorityAppendResult = AuthorityAppendResult{valid: false, span: AuthorityByteSpan{start: 0, length: 0}}
                return miss if not builder.active or not builder.valid
                length: usize = sview_len(value)
                if builder.bytes.count > 67108864 or length > 67108864 - builder.bytes.count:
                    builder.valid <- false
                    return miss
                start: usize = builder.bytes.count
                builder.bytes.reserve(start + length)
                builder.bytes.extend(value)
                return AuthorityAppendResult{valid: true, span: AuthorityByteSpan{start: start, length: length}}

        # Existing collector canonical encoding: LE-u32 token kind, LE-u32
        # token.length + suffix_length, exact source bytes. Positions are excluded.
        def authority_builder_append_tokens(builder: mutable AuthorityTraceBuilder&, source: u8&, source_length: usize, tokens: darray[Token]&, start: usize, end: usize) -> AuthorityAppendResult:
            can Memory.Allocate, Abort.Panic:
                miss: AuthorityAppendResult = AuthorityAppendResult{valid: false, span: AuthorityByteSpan{start: 0, length: 0}}
                return miss if not builder.active or not builder.valid
                size: AuthorityAppendResult = authority_token_bytes_size(source, source_length, tokens, start, end)
                if not size.valid or builder.bytes.count > 67108864 or size.span.length > 67108864 - builder.bytes.count:
                    builder.valid <- false
                    return miss
                begin: usize = builder.bytes.count
                builder.bytes.reserve(begin + size.span.length)
                for index in start..<end |builder|:
                    token: Token = tokens[index]
                    length: usize = token.length.usize() + token.suffix_length.usize()
                    authority_builder_u32(builder, token.kind.u32())
                    authority_builder_u32(builder, length.u32())
                    if length != 0:
                        if Lexer::make_source_view(source, source_length, token.start.usize(), token.start.usize() + length) is text:
                            builder.bytes.extend(text)
                        else:
                            builder.bytes.truncate(begin)
                            builder.valid <- false
                            return miss
                return AuthorityAppendResult{valid: true, span: AuthorityByteSpan{start: begin, length: builder.bytes.count - begin}}

        # source_identity MUST be the declaration's canonical ORIGINAL source path,
        # obtained from the current expansion line map. Never use only the root
        # entry/cache bucket path; duplicate or unresolved declaration keys stay cold.
        # The caller supplies that identity; this helper does no second file walk.
        def authority_builder_append_key(builder: mutable AuthorityTraceBuilder&, source_identity: sview, modules: darray[sview]&, name: sview, source: u8&, source_length: usize, tokens: darray[Token]&, header_start: usize, header_end: usize) -> AuthorityAppendResult:
            can Memory.Allocate, Abort.Panic:
                miss: AuthorityAppendResult = AuthorityAppendResult{valid: false, span: AuthorityByteSpan{start: 0, length: 0}}
                return miss if not builder.active or not builder.valid
                header: AuthorityAppendResult = authority_token_bytes_size(source, source_length, tokens, header_start, header_end)
                if not header.valid or header.span.length == 0 or modules.count > 1000000:
                    builder.valid <- false
                    return miss
                total: mutable usize = 20
                source_identity_length: usize = sview_len(source_identity)
                if source_identity_length > 67108864 - total:
                    builder.valid <- false
                    return miss
                total <- total + source_identity_length
                name_length: usize = sview_len(name)
                if name_length > 67108864 - total:
                    builder.valid <- false
                    return miss
                total <- total + name_length
                if header.span.length > 67108864 - total:
                    builder.valid <- false
                    return miss
                total <- total + header.span.length
                module_length: mutable usize = 4
                for module in modules |total, module_length|:
                    length: usize = sview_len(module)
                    if total > 67108860 or length > 67108860 - total:
                        builder.valid <- false
                        return miss
                    total <- total + 4 + length
                    module_length <- module_length + 4 + length
                if builder.bytes.count > 67108864 or total > 67108864 - builder.bytes.count:
                    builder.valid <- false
                    return miss
                begin: usize = builder.bytes.count
                builder.bytes.reserve(begin + total)
                authority_builder_u32(builder, sview_len(source_identity).u32())
                builder.bytes.extend(source_identity)
                authority_builder_u32(builder, module_length.u32())
                authority_builder_u32(builder, modules.count.u32())
                for module in modules |builder|:
                    authority_builder_u32(builder, sview_len(module).u32())
                    builder.bytes.extend(module)
                authority_builder_u32(builder, sview_len(name).u32())
                builder.bytes.extend(name)
                authority_builder_u32(builder, header.span.length.u32())
                appended: AuthorityAppendResult = authority_builder_append_tokens(builder, source, source_length, tokens, header_start, header_end)
                span: AuthorityByteSpan = AuthorityByteSpan{start: begin, length: builder.bytes.count - begin}
                if not appended.valid or not authority_key_valid(builder.bytes, AuthorityDeclarationKey{bytes: span}):
                    builder.bytes.truncate(begin)
                    builder.valid <- false
                    return miss
                return AuthorityAppendResult{valid: true, span: span}

        def authority_builder_append_events(builder: mutable AuthorityTraceBuilder&, values: darray[AuthorityTraceEvent]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                return false if not builder.active or not builder.valid
                if builder.events.count > 1000000 or values.count > 1000000 - builder.events.count:
                    builder.valid <- false
                    return false
                builder.events.reserve(builder.events.count + values.count)
                builder.events.extend(values)
                return true

        def authority_builder_append_candidates(builder: mutable AuthorityTraceBuilder&, values: darray[AuthorityDeclarationKey]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                return false if not builder.active or not builder.valid
                if builder.candidates.count > 1000000 or values.count > 1000000 - builder.candidates.count:
                    builder.valid <- false
                    return false
                builder.candidates.reserve(builder.candidates.count + values.count)
                builder.candidates.extend(values)
                return true

        def authority_builder_append_grants(builder: mutable AuthorityTraceBuilder&, values: darray[AuthorityTraceGrant]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                return false if not builder.active or not builder.valid
                if builder.grants.count > 1000000 or values.count > 1000000 - builder.grants.count:
                    builder.valid <- false
                    return false
                builder.grants.reserve(builder.grants.count + values.count)
                builder.grants.extend(values)
                return true

        # On success detach all arrays: a later begin cannot overwrite published bytes.
        # The result owns its array metadata and pool; no source views or AST handles.
        def authority_builder_finish(builder: mutable AuthorityTraceBuilder&, body_start: usize, body_end: usize, tokens: darray[Token]&, source: u8&, source_length: usize) -> AuthorityTraceFinish:
            can Abort.Panic:
                trace: AuthorityFunctionTrace = AuthorityFunctionTrace{owner: builder.owner, body_tokens: builder.body_tokens, events: builder.events, candidates: builder.candidates, grants: builder.grants, bytes: builder.bytes}
                valid: bool = builder.active and builder.valid and authority_trace_valid_source(trace, body_start, body_end, tokens, source, source_length)
                if valid:
                    builder.bytes <- []
                    builder.events <- []
                    builder.candidates <- []
                    builder.grants <- []
                    builder.active <- false
                    builder.valid <- false
                    return AuthorityTraceFinish{valid: true, trace: trace}
                authority_builder_abort(builder)
                return AuthorityTraceFinish{valid: false, trace: AuthorityFunctionTrace{owner: AuthorityDeclarationKey{bytes: AuthorityByteSpan{start: 0, length: 0}}, body_tokens: AuthorityByteSpan{start: 0, length: 0}, events: [], candidates: [], grants: [], bytes: []}}

        def authority_span_valid(span: AuthorityByteSpan, limit: usize) -> bool:
            return span.start <= limit and span.length <= limit - span.start

        def authority_scope_key_valid(bytes: darray[u8]&, scope: AuthorityByteSpan) -> bool:
            can Abort.Panic:
                return authority_module_key_valid(bytes, scope)

        def authority_key_valid(bytes: darray[u8]&, key: AuthorityDeclarationKey) -> bool:
            can Abort.Panic:
                return false if not authority_span_valid(key.bytes, bytes.count)
                end: usize = key.bytes.start + key.bytes.length
                cursor: mutable usize = key.bytes.start
                for field in 0..<4 |cursor|:
                    return false if cursor > end or end - cursor < 4
                    length: usize = authority_read_u32(bytes, cursor).usize()
                    cursor <- cursor + 4
                    return false if length > end - cursor
                    return false if field != 1 and length == 0
                    return false if field == 1 and not authority_module_key_valid(bytes, AuthorityByteSpan{start: cursor, length: length})
                    if field != 1 and field != 3:
                        for index in cursor..<cursor + length:
                            return false if bytes[index] == 0
                    cursor <- cursor + length
                return cursor == end

        # Validate the complete portable trace before a caller applies any row,
        # edge, or diagnostic. Structural validity does not resolve declaration
        # identities: the caller must also preflight every key against current GA.
        def authority_trace_valid_source(trace: AuthorityFunctionTrace&, body_start: usize, body_end: usize, tokens: darray[Token]&, source: u8&, source_length: usize) -> bool:
            can Abort.Panic:
                return false if source == null and source_length > 0
                return false if trace.bytes.count > 67108864 or trace.events.count > 1000000 or trace.candidates.count > 1000000 or trace.grants.count > 1000000
                return false if not authority_span_valid(trace.body_tokens, trace.bytes.count) or trace.body_tokens.length == 0
                return false if trace.owner.bytes.length > 67108864 - trace.body_tokens.length
                budget: mutable usize = 67108864 - trace.body_tokens.length - trace.owner.bytes.length
                return false if not authority_key_valid(trace.bytes, trace.owner)
                for candidate in trace.candidates |budget|:
                    return false if candidate.bytes.length > budget
                    budget <- budget - candidate.bytes.length
                    return false if not authority_key_valid(trace.bytes, candidate)
                for grant in trace.grants |budget|:
                    return false if grant.kind.u8() > AuthorityGrantKind.UnsafeFirewall.u8()
                    return false if not authority_span_valid(grant.name, trace.bytes.count) or not authority_span_valid(grant.scope, trace.bytes.count)
                    return false if grant.name.length > budget
                    budget <- budget - grant.name.length
                    return false if grant.scope.length > budget
                    budget <- budget - grant.scope.length
                    return false if not authority_effect_name_valid(trace.bytes, grant.name) or not authority_scope_key_valid(trace.bytes, grant.scope)
                    if grant.kind == AuthorityGrantKind.UnsafeFirewall:
                        return false if grant.name.length < 8
                        return false if trace.bytes[grant.name.start] != 85 or trace.bytes[grant.name.start + 1] != 110 or trace.bytes[grant.name.start + 2] != 115 or trace.bytes[grant.name.start + 3] != 97 or trace.bytes[grant.name.start + 4] != 102 or trace.bytes[grant.name.start + 5] != 101 or trace.bytes[grant.name.start + 6] != 46
                for event in trace.events |budget|:
                    return false if event.kind.u8() > AuthorityEventKind.CanEntry.u8()
                    return false if not authority_span_valid(AuthorityByteSpan{start: event.candidate_start, length: event.candidate_count}, trace.candidates.count)
                    return false if not authority_span_valid(AuthorityByteSpan{start: event.grant_start, length: event.grant_count}, trace.grants.count)
                    return false if not authority_span_valid(event.display_name, trace.bytes.count) or not authority_span_valid(event.entered_scope, trace.bytes.count)
                    return false if event.entered_scope.length > budget
                    budget <- budget - event.entered_scope.length
                    return false if event.candidate_count > budget
                    budget <- budget - event.candidate_count
                    return false if event.grant_count > budget
                    budget <- budget - event.grant_count
                    return false if event.display_name.length > budget
                    budget <- budget - event.display_name.length
                    return false if event.subject.bytes.length > budget
                    budget <- budget - event.subject.bytes.length
                    return false if event.position.start_delta.usize() > budget
                    budget <- budget - event.position.start_delta.usize()
                    return false if event.position.end_delta.usize() > budget
                    budget <- budget - event.position.end_delta.usize()
                    return false if not authority_reconstruct_position_source(event.position, body_start, body_end, tokens, source, source_length).valid
                    match event.kind:
                        AuthorityEventKind.GlobalRead | AuthorityEventKind.GlobalWrite:
                            return false if event.entered_scope.start != 0 or event.entered_scope.length != 0
                            return false if event.candidate_count != 0 or event.display_name.length != 0 or event.declared_read or event.declared_write
                            return false if not authority_key_valid(trace.bytes, event.subject)
                        AuthorityEventKind.CallSite:
                            return false if event.entered_scope.start != 0 or event.entered_scope.length != 0
                            return false if event.subject.bytes.start != 0 or event.subject.bytes.length != 0 or event.candidate_count == 0 or event.display_name.length == 0
                            for index in event.display_name.start..<event.display_name.start + event.display_name.length:
                                return false if trace.bytes[index] == 0
                        AuthorityEventKind.CanEntry:
                            return false if not authority_scope_key_valid(trace.bytes, event.entered_scope)
                            return false if event.subject.bytes.start != 0 or event.subject.bytes.length != 0 or event.candidate_count != 0 or event.declared_read or event.declared_write
                            return false if not authority_effect_name_valid(trace.bytes, event.display_name)
                        _:
                            return false
                return true

        # The caller supplies the authoritative current AST source and its extent.
        # Both complete token extents and intra-token deltas are checked before
        # authority_token_point reads any source byte. No copy, relex, or AST node.
        def authority_reconstruct_position_source(anchor: AuthorityPositionAnchor, body_start: usize, body_end: usize, tokens: darray[Token]&, source: u8&, source_length: usize) -> AuthorityPositionResult:
            can Abort.Panic:
                miss: AuthorityPositionResult = AuthorityPositionResult{valid: false, position: Ast::Pos{line: 0, column: 0, offset: 0, end_line: 0, end_column: 0, end_offset: 0}}
                return miss if source == null and source_length > 0
                return miss if body_start > body_end or body_end > tokens.count
                count: usize = body_end - body_start
                return miss if anchor.start_token.usize() >= count or anchor.end_token.usize() >= count
                first: Token = tokens[body_start + anchor.start_token.usize()]
                last: Token = tokens[body_start + anchor.end_token.usize()]
                return miss if not authority_token_valid(first, source_length) or not authority_token_valid(last, source_length)
                return miss if anchor.start_delta > first.length or anchor.end_delta > last.length
                return miss if first.line > 4294967295 - anchor.start_delta or first.column > 4294967295 - anchor.start_delta
                return miss if last.line > 4294967295 - anchor.end_delta or last.column > 4294967295 - anchor.end_delta
                start: u32 = first.start + anchor.start_delta
                end: u32 = last.start + anchor.end_delta
                return miss if anchor.start_token > anchor.end_token or start > end
                begin: Ast::Pos = authority_token_point(first, anchor.start_delta, source)
                finish: Ast::Pos = authority_token_point(last, anchor.end_delta, source)
                return miss if finish.line < begin.line or (finish.line == begin.line and finish.column < begin.column)
                return AuthorityPositionResult{valid: true, position: Ast::Pos{line: begin.line, column: begin.column, offset: start, end_line: finish.line, end_column: finish.column, end_offset: end}}

        # Compatibility wrappers borrow the existing array backing; no source copy.
        def authority_trace_valid(trace: AuthorityFunctionTrace&, body_start: usize, body_end: usize, tokens: darray[Token]&, source: darray[u8]&) -> bool:
            can Abort.Panic:
                if source.items is source_bytes:
                    return authority_trace_valid_source(trace, body_start, body_end, tokens, source_bytes, source.count)
                return false if source.count != 0
                return authority_trace_valid_source(trace, body_start, body_end, tokens, "", 0)

        def authority_reconstruct_position(anchor: AuthorityPositionAnchor, body_start: usize, body_end: usize, tokens: darray[Token]&, source: darray[u8]&) -> AuthorityPositionResult:
            can Abort.Panic:
                if source.items is source_bytes:
                    return authority_reconstruct_position_source(anchor, body_start, body_end, tokens, source_bytes, source.count)
                if source.count == 0:
                    return authority_reconstruct_position_source(anchor, body_start, body_end, tokens, "", 0)
                return AuthorityPositionResult{valid: false, position: Ast::Pos{line: 0, column: 0, offset: 0, end_line: 0, end_column: 0, end_offset: 0}}

    private:
        def authority_effect_name_valid(bytes: darray[u8]&, name: AuthorityByteSpan) -> bool:
            can Abort.Panic:
                return false if name.length == 0 or not authority_span_valid(name, bytes.count)
                segment_start: mutable bool = true
                for index in name.start..<name.start + name.length |segment_start|:
                    byte: u8 = bytes[index]
                    if byte == 46:
                        return false if segment_start
                        segment_start <- true
                    else:
                        letter: bool = (byte >= 65 and byte <= 90) or (byte >= 97 and byte <= 122) or byte == 95
                        return false if not letter and (segment_start or byte < 48 or byte > 57)
                        segment_start <- false
                return not segment_start

        def authority_read_u32(bytes: darray[u8]&, at: usize) -> u32:
            can Abort.Panic:
                return bytes[at].u32() | (bytes[at + 1].u32() << 8) | (bytes[at + 2].u32() << 16) | (bytes[at + 3].u32() << 24)

        def authority_module_key_valid(bytes: darray[u8]&, span: AuthorityByteSpan) -> bool:
            can Abort.Panic:
                return false if span.length < 4 or not authority_span_valid(span, bytes.count)
                end: usize = span.start + span.length
                count: usize = authority_read_u32(bytes, span.start).usize()
                cursor: mutable usize = span.start + 4
                return false if count > (span.length - 4) / 5
                for component in 0..<count |cursor|:
                    return false if end - cursor < 4
                    length: usize = authority_read_u32(bytes, cursor).usize()
                    cursor <- cursor + 4
                    return false if length == 0 or length > end - cursor
                    for index in cursor..<cursor + length:
                        byte: u8 = bytes[index]
                        letter: bool = (byte >= 65 and byte <= 90) or (byte >= 97 and byte <= 122) or byte == 95
                        return false if not letter and (index == cursor or byte < 48 or byte > 57)
                    cursor <- cursor + length
                return cursor == end

        def authority_token_valid(token: Token, source_length: usize) -> bool:
            return token.line > 0 and token.column > 0 and token.start.usize() <= source_length and token.length.usize() <= source_length - token.start.usize() and token.length <= 4294967295 - token.start

        def authority_token_point(token: Token, delta: u32, source: u8&) -> Ast::Pos:
            can Abort.Panic:
                line: mutable u32 = token.line
                column: mutable u32 = token.column
                for index in 0..<delta.usize() |line, column|:
                    if authority_source_byte(source, token.start.usize() + index) == 10:
                        line <- line + 1
                        column <- 1
                    else:
                        column <- column + 1
                return Ast::Pos{line: line, column: column, offset: token.start + delta, end_line: line, end_column: column, end_offset: token.start + delta}

        # Only authority_token_point calls this helper, after public reconstruction
        # proves token.start + token.length <= source_length and delta <= length.
        # Its loop has index < delta, so every raw read is within that exact extent.
        def authority_source_byte(source: u8&, index: usize) -> u8:
            trusted Unsafe.UncheckedIndex:
                return source[index]

        def authority_builder_u32(builder: mutable AuthorityTraceBuilder&, value: u32) -> void:
            can Memory.Allocate, Abort.Panic:
                encoded: u8[4]
                encoded[0] <- (value & 255).u8()
                encoded[1] <- ((value >> 8) & 255).u8()
                encoded[2] <- ((value >> 16) & 255).u8()
                encoded[3] <- ((value >> 24) & 255).u8()
                if Lexer::make_source_view(&encoded[0], 4, 0, 4) is view:
                    builder.bytes.extend(view)

        def authority_token_bytes_size(source: u8&, source_length: usize, tokens: darray[Token]&, start: usize, end: usize) -> AuthorityAppendResult:
            can Abort.Panic:
                miss: AuthorityAppendResult = AuthorityAppendResult{valid: false, span: AuthorityByteSpan{start: 0, length: 0}}
                return miss if start > end or end > tokens.count or end - start > 1000000
                return miss if source == null and source_length > 0
                total: mutable usize = 0
                for index in start..<end |total|:
                    token: Token = tokens[index]
                    return miss if token.length > 67108864
                    length: usize = token.length.usize() + token.suffix_length.usize()
                    return miss if token.start.usize() > source_length or length > source_length - token.start.usize()
                    return miss if total > 67108856 or length > 67108856 - total
                    total <- total + 8 + length
                return AuthorityAppendResult{valid: true, span: AuthorityByteSpan{start: 0, length: total}}

        def authority_find_anchor_point(offset: u32, line: u32, column: u32, lookup: AuthorityAnchorLookup, tokens: darray[Token]&, source: u8&, source_length: usize) -> AuthorityAnchorResult:
            can Abort.Panic:
                miss: AuthorityAnchorResult = AuthorityAnchorResult{valid: false, anchor: AuthorityPositionAnchor{start_token: 0, start_delta: 0, end_token: 0, end_delta: 0}}
                lower: mutable usize = lookup.body_start
                upper: mutable usize = lookup.body_end
                while lower < upper |lower, upper|:
                    middle: usize = lower + (upper - lower) / 2
                    if tokens[middle].start <= offset:
                        lower <- middle + 1
                    else:
                        upper <- middle
                next: mutable usize = lower
                probes: mutable usize = 0
                while next > lookup.body_start and probes < 64 |next, probes|:
                    next <- next - 1
                    probes <- probes + 1
                    token: Token = tokens[next]
                    return miss if not authority_token_valid(token, source_length)
                    break if token.start > offset or token.length < offset - token.start
                    delta: u32 = offset - token.start
                    return miss if delta > 67108864
                    if token.line <= 4294967295 - delta and token.column <= 4294967295 - delta:
                        at: Ast::Pos = authority_token_point(token, delta, source)
                        if at.line == line and at.column == column:
                            relative: u32 = (next - lookup.body_start).u32()
                            return AuthorityAnchorResult{valid: true, anchor: AuthorityPositionAnchor{start_token: relative, start_delta: delta, end_token: relative, end_delta: delta}}
                return miss
