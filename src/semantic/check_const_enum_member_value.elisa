# Const-enum-family diagnostic (structural). A `const enum X of T:` member's explicit integer
# value must fit its storage type T. stage0 rejects out-of-range members. Reads the storage
# type (Decl.Enum.storage_type) and each member's decoded value (EnumVariant.value_expr).
#
# SOUND SUBSET: fires only when the member value is a literal integer (Expr.IntLit, already
# decoded to i64) AND the storage type is one of the ranges we model. Non-literal values,
# unmodeled storage types (u64/i64/usize/isize/bit-ints/unknown), and non-const enums stay
# silent — so we never false-fire.
extend Semantic:
    private:
        # Whether `value` is representable in the named integer storage type. Unmodeled types
        # (wide/bit-int/unknown) conservatively return true (no diagnostic).
        def int_fits_storage(value: i64, storage_name: sview) -> bool:
            can Abort.Panic:
                return when storage_name:
                    "u8" -> value >= 0 and value <= 255
                    "u16" -> value >= 0 and value <= 65535
                    "u32" -> value >= 0 and value <= 4294967295
                    "i8" -> value >= -128 and value <= 127
                    "i16" -> value >= -32768 and value <= 32767
                    "i32" -> value >= -2147483648 and value <= 2147483647
                    _ -> true


        def check_const_enum_member_value(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Enum(name, variants, is_const, storage_type, line):
                            if is_const:
                                storage_name: sview = bare_type_name(storage_type)
                                for variant in variants |table| -> table:
                                    member_value_expr: Ast::Expr = variant.value_expr
                                    match member_value_expr:
                                        Expr.IntLit(member_value):
                                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ConstEnumValueOutOfRange, name: name, line: line, expected: variant.name, actual: storage_name}) if not int_fits_storage(member_value, storage_name)
                                        _:
                                            pass
                        Decl.Module(module_name, body, module_line):
                            table <- check_const_enum_member_value(body, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- check_const_enum_member_value(scoped_body, table)
                        _:
                            pass
