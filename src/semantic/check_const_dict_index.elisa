# Const-dict missing-key index. A `const D: dict[...] = {...}` has a fixed, compile-time
# key set. Indexing it with a STRING literal key that is not present is a compile error:
#
#   const NUMBERS: dict[cstr, u8] = {"one": 1}
#   def bad() -> u8:
#       return NUMBERS["missing"]   # no key "missing" -> error
#
# Only const dicts with string-literal keys are modelled here; a non-literal index or a
# runtime dict is never flagged, so there are no false positives.
extend Semantic:
    private:
        def cdi_string_key(key: Ast::Expr) -> (found: bool, text: sview):
            can Memory.Allocate, Abort.Panic:
                if key is Expr.StringLit(text):
                    return (true, text)
                return (false, sview("", 0, 0))

        # Collect const dicts (name) and their string keys (name-parallel).
        def cdi_collect(declarations: darray[Ast::Decl], dict_names: mutable darray[sview]&, key_owners: mutable darray[sview]&, key_texts: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |dict_names, key_owners, key_texts|:
                    match declaration:
                        Decl.Const(name, type_expression, value, is_mutable, line):
                            if not is_mutable and value is Expr.DictLit(entries, dict_line):
                                dict_names.push(name)
                                for entry in entries |key_owners, key_texts, name|:
                                    key: (found: bool, text: sview) = cdi_string_key(entry.key)
                                    if key.found:
                                        key_owners.push(name)
                                        key_texts.push(key.text)
                        Decl.Module(module_name, module_body, module_line):
                            cdi_collect(module_body, dict_names, key_owners, key_texts)
                        Decl.Scoped(scoped_body, scoped_line):
                            cdi_collect(scoped_body, dict_names, key_owners, key_texts)
                        _:
                            pass

        def cdi_name_in(names: darray[sview]&, wanted: sview) -> bool:
            can Abort.Panic:
                for entry in names:
                    true return if entry == wanted
                return false

        def cdi_has_key(key_owners: darray[sview]&, key_texts: darray[sview]&, owner: sview, text: sview) -> bool:
            can Abort.Panic:
                index: mutable usize = 0
                while index < key_owners.count |index|:
                    true return if key_owners[index] == owner and key_texts[index] == text
                    index <- index + 1
                return false

        def cdi_walk_expr(expression: Ast::Expr, dict_names: darray[sview]&, key_owners: darray[sview]&, key_texts: darray[sview]&, line: u32, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Index(object, index_argument, index_line):
                        if object is Expr.Ident(dict_name, ident_line):
                            key: (found: bool, text: sview) = cdi_string_key(index_argument)
                            missing: bool = key.found and cdi_name_in(dict_names, dict_name) and not cdi_has_key(key_owners, key_texts, dict_name, key.text)
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ConstDictNoKey, name: key.text, line: line, expected: "", actual: ""}) if missing
                        table <- cdi_walk_expr(object, dict_names, key_owners, key_texts, line, table)
                        table <- cdi_walk_expr(index_argument, dict_names, key_owners, key_texts, line, table)
                    Expr.Binary(left, operator, right, binary_line):
                        table <- cdi_walk_expr(left, dict_names, key_owners, key_texts, line, table)
                        table <- cdi_walk_expr(right, dict_names, key_owners, key_texts, line, table)
                    Expr.Unary(operator, operand, unary_line):
                        table <- cdi_walk_expr(operand, dict_names, key_owners, key_texts, line, table)
                    Expr.Paren(inner, paren_line):
                        table <- cdi_walk_expr(inner, dict_names, key_owners, key_texts, line, table)
                    Expr.Call(callee, arguments, argument_names, call_line):
                        for argument in arguments |table| -> table:
                            table <- cdi_walk_expr(argument, dict_names, key_owners, key_texts, line, table)
                    _:
                        pass

        def cdi_walk_stmts(statements: darray[Ast::Stmt], dict_names: darray[sview]&, key_owners: darray[sview]&, key_texts: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Return(value, line):
                            table <- cdi_walk_expr(returned, dict_names, key_owners, key_texts, line.line, table) if value is returned
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- cdi_walk_expr(value, dict_names, key_owners, key_texts, line.line, table)
                        Stmt.Assign(target, operator, value, line):
                            table <- cdi_walk_expr(value, dict_names, key_owners, key_texts, line.line, table)
                        Stmt.Expr(expression, line):
                            table <- cdi_walk_expr(expression, dict_names, key_owners, key_texts, line.line, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- cdi_walk_expr(condition, dict_names, key_owners, key_texts, line.line, table)
                            table <- cdi_walk_stmts(then_body, dict_names, key_owners, key_texts, table)
                            table <- cdi_walk_stmts(else_body, dict_names, key_owners, key_texts, table)
                        Stmt.While(condition, while_body, while_line):
                            table <- cdi_walk_stmts(while_body, dict_names, key_owners, key_texts, table)
                        Stmt.For(bind, variables, iterable, for_body, for_line):
                            table <- cdi_walk_stmts(for_body, dict_names, key_owners, key_texts, table)
                        Stmt.Block(kind, clause, binding, body, block_line):
                            table <- cdi_walk_stmts(body, dict_names, key_owners, key_texts, table)
                        Stmt.Match(scrutinee, arms, match_line):
                            for arm in arms |table| -> table:
                                table <- cdi_walk_stmts(arm.body, dict_names, key_owners, key_texts, table)
                        _:
                            pass

        def cdi_check_declarations(declarations: darray[Ast::Decl], dict_names: darray[sview]&, key_owners: darray[sview]&, key_texts: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            table <- cdi_walk_stmts(body, dict_names, key_owners, key_texts, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- cdi_check_declarations(module_body, dict_names, key_owners, key_texts, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- cdi_check_declarations(scoped_body, dict_names, key_owners, key_texts, table)
                        _:
                            pass

    public:
        def check_const_dict_index(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                dict_names: mutable darray[sview] = []
                key_owners: mutable darray[sview] = []
                key_texts: mutable darray[sview] = []
                cdi_collect(file.top_decls, dict_names, key_owners, key_texts)
                table <- cdi_check_declarations(file.top_decls, dict_names, key_owners, key_texts, table) if dict_names.count > 0
