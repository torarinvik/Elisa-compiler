# Parameter `where` refinement scope. A `where` predicate on parameter N may only reference
# that parameter and earlier parameters (plus literals and named types) — stage0 rejects a
# reference to anything else with "parameter where refinement may only reference its parameter
# and earlier parameters: NAME is not available here". SOUND decidable subset: a predicate that
# CALLS a global function names an identifier that is provably neither the parameter nor an
# earlier parameter (a call to a user function is also impure), so it always violates. We emit
# on the first such call callee, matching stage0's per-name diagnostic. Type-constructor calls
# (`Foo(x)` where Foo is a named type) are excluded by requiring the callee to resolve to a
# Func symbol; a callee shadowed by a parameter of the same function is excluded too.
extend Semantic:
    private:
        def global_func_name_exists(names: darray[sview]&, wanted: sview) -> bool:
            can Abort.Panic:
                return any name in names where name == wanted

        def collect_global_func_names(declarations: darray[Ast::Decl], names: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            names.push(function_name)
                        Decl.Module(module_name, module_body, module_line):
                            collect_global_func_names(module_body, names)
                        Decl.Scoped(scoped_body, scoped_line):
                            collect_global_func_names(scoped_body, names)
                        _:
                            pass

        # Type/enum names are the ONLY non-parameter identifiers a parameter `where` predicate may
        # name — a type-qualified path like `Color.Red` is legal, but a global const or variable is
        # NOT (stage0: "may only reference its parameter and earlier parameters"). So we collect
        # struct/enum names to whitelist path receivers, but deliberately NOT const names.
        def collect_type_names(declarations: darray[Ast::Decl], names: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations:
                    match declaration:
                        Decl.Struct(struct_name, fields, affinity, has_named_states, has_derive, invariants, struct_line):
                            names.push(struct_name)
                        Decl.Enum(enum_name, variants, enum_is_const, enum_storage, enum_line):
                            names.push(enum_name)
                        Decl.Module(module_name, module_body, module_line):
                            collect_type_names(module_body, names)
                        Decl.Scoped(scoped_body, scoped_line):
                            collect_type_names(scoped_body, names)
                        _:
                            pass

        # The name of the first predicate identifier that is a call to a global function and is
        # not one of `param_names` (this function's parameters), or "" if none. Sound: only a
        # provable out-of-scope reference is reported.
        def where_ident_is_in_scope(name: sview, param_names: darray[sview]&, type_names: darray[sview]&) -> bool:
            can Abort.Panic:
                true return if name == "null" or name == "self" or name == "result"
                true return if global_func_name_exists(param_names, name)
                return global_func_name_exists(type_names, name)

        def where_scope_offender(predicate: Ast::Expr, func_names: darray[sview]&, param_names: darray[sview]&, type_names: darray[sview]&) -> sview:
            can Memory.Allocate, Abort.Panic:
                match predicate:
                    Expr.Ident(name, line):
                        # A bare identifier in a parameter `where` must be the parameter or an earlier
                        # one (paths through a type name are handled by the Field arm below). Anything
                        # else — a global const, a ghost, an undefined name — is provably out of scope.
                        name return if not where_ident_is_in_scope(name, param_names, type_names)
                        return sview("", 0, 0)
                    Expr.Call(callee, arguments, argument_names, line):
                        callee_name: sview = ident_name_of(callee)
                        offending: bool = callee_name != "" and global_func_name_exists(func_names, callee_name) and not global_func_name_exists(param_names, callee_name)
                        callee_name return if offending
                        callee_found: sview = where_scope_offender(callee, func_names, param_names, type_names)
                        callee_found return if callee_found != ""
                        for argument in arguments:
                            found: sview = where_scope_offender(argument, func_names, param_names, type_names)
                            found return if found != ""
                        return sview("", 0, 0)
                    Expr.Field(object, field, line):
                        # `Color.Red` / `self.model` — only the receiver can be an out-of-scope name; a
                        # field label is not an identifier reference. `ident_name_of` returns "" for a
                        # non-Ident receiver so the recursion still descends nested paths.
                        object_name: sview = ident_name_of(object)
                        object_name return if object_name != "" and not where_ident_is_in_scope(object_name, param_names, type_names)
                        return where_scope_offender(object, func_names, param_names, type_names)
                    Expr.Index(object, index, line):
                        object_found: sview = where_scope_offender(object, func_names, param_names, type_names)
                        object_found return if object_found != ""
                        return where_scope_offender(index, func_names, param_names, type_names)
                    Expr.If(condition, then_expr, else_expr, line):
                        condition_found: sview = where_scope_offender(condition, func_names, param_names, type_names)
                        condition_found return if condition_found != ""
                        then_found: sview = where_scope_offender(then_expr, func_names, param_names, type_names)
                        then_found return if then_found != ""
                        return where_scope_offender(else_expr, func_names, param_names, type_names)
                    Expr.Binary(left, operator, right, line):
                        left_found: sview = where_scope_offender(left, func_names, param_names, type_names)
                        left_found return if left_found != ""
                        return where_scope_offender(right, func_names, param_names, type_names)
                    Expr.Unary(operator, operand, line):
                        return where_scope_offender(operand, func_names, param_names, type_names)
                    Expr.Paren(inner, line):
                        return where_scope_offender(inner, func_names, param_names, type_names)
                    _:
                        return sview("", 0, 0)

        def where_scope_check_function(parameters: darray[Ast::ParamDecl], func_names: darray[sview]&, type_names: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                param_names: mutable darray[sview] = []
                param_names.extend([parameter.name for parameter in parameters])
                for parameter in parameters |table| -> table:
                    predicate: Ast::Expr = where_predicate_of_type(parameter.type_expression)
                    offender: sview = where_scope_offender(predicate, func_names, param_names, type_names)
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ParameterWhereRefScope, name: offender, line: expr_line(predicate), expected: "", actual: ""}) if offender != ""

        def where_scope_walk(declarations: darray[Ast::Decl], func_names: darray[sview]&, type_names: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            table <- where_scope_check_function(parameters, func_names, type_names, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- where_scope_walk(module_body, func_names, type_names, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- where_scope_walk(scoped_body, func_names, type_names, table)
                        _:
                            pass

        def check_where_scope(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                func_names: mutable darray[sview] = []
                collect_global_func_names(declarations, func_names)
                type_names: mutable darray[sview] = []
                collect_type_names(declarations, type_names)
                table <- where_scope_walk(declarations, func_names, type_names, table)
