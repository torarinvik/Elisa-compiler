# Parameter `where` refinement scope. A `where` predicate on parameter N may only reference
# that parameter and earlier parameters (plus literals and named types) — stage0 rejects a
# reference to anything else with "parameter where refinement may only reference its parameter
# and earlier parameters: NAME is not available here". SOUND decidable subset: a predicate that
# CALLS a global function names an identifier that is provably neither the parameter nor an
# earlier parameter (a call to a user function is also impure), so it always violates. We emit
# on the first such call callee, matching stage0's per-name diagnostic. Type-constructor calls
# (`Foo(x)` where Foo is a named type) are excluded by requiring the callee to resolve to a
# Func symbol; a callee shadowed by a parameter of the same function is excluded too.
extend Semantic:
    private:
        def global_func_name_exists(names: darray[sview]&, wanted: sview) -> bool:
            can Abort.Panic:
                return any name in names where name == wanted

        def collect_global_func_names(declarations: darray[Ast::Decl], names: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            names.push(function_name)
                        Decl.Module(module_name, module_body, module_line):
                            collect_global_func_names(module_body, names)
                        Decl.Scoped(scoped_body, scoped_line):
                            collect_global_func_names(scoped_body, names)
                        _:
                            pass

        # The name of the first predicate identifier that is a call to a global function and is
        # not one of `param_names` (this function's parameters), or "" if none. Sound: only a
        # provable out-of-scope reference is reported.
        def where_scope_offender(predicate: Ast::Expr, func_names: darray[sview]&, param_names: darray[sview]&) -> sview:
            can Memory.Allocate, Abort.Panic:
                match predicate:
                    Expr.Call(callee, arguments, argument_names, line):
                        callee_name: sview = ident_name_of(callee)
                        offending: bool = callee_name != "" and global_func_name_exists(func_names, callee_name) and not global_func_name_exists(param_names, callee_name)
                        callee_name return if offending
                        for argument in arguments:
                            found: sview = where_scope_offender(argument, func_names, param_names)
                            found return if found != ""
                        return sview("", 0, 0)
                    Expr.Binary(left, operator, right, line):
                        left_found: sview = where_scope_offender(left, func_names, param_names)
                        left_found return if left_found != ""
                        return where_scope_offender(right, func_names, param_names)
                    Expr.Unary(operator, operand, line):
                        return where_scope_offender(operand, func_names, param_names)
                    Expr.Paren(inner, line):
                        return where_scope_offender(inner, func_names, param_names)
                    _:
                        return sview("", 0, 0)

        def where_scope_check_function(parameters: darray[Ast::ParamDecl], func_names: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                param_names: mutable darray[sview] = []
                for parameter in parameters:
                    param_names.push(parameter.name)
                for parameter in parameters |table| -> table:
                    predicate: Ast::Expr = where_predicate_of_type(parameter.type_expression)
                    offender: sview = where_scope_offender(predicate, func_names, param_names)
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ParameterWhereRefScope, name: offender, line: expr_line(predicate), expected: "", actual: ""}) if offender != ""

        def where_scope_walk(declarations: darray[Ast::Decl], func_names: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            table <- where_scope_check_function(parameters, func_names, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- where_scope_walk(module_body, func_names, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- where_scope_walk(scoped_body, func_names, table)
                        _:
                            pass

        def check_where_scope(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                func_names: mutable darray[sview] = []
                collect_global_func_names(declarations, func_names)
                table <- where_scope_walk(declarations, func_names, table)
