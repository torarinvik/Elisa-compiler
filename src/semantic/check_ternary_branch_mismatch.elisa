# Check for ternary expressions (`A if C else B`) whose two branches infer to
# firmly-incompatible comparison groups (bool vs string vs numeric). Sound SUBSET:
# only fires when BOTH branches are firm (comparison_group != 0) and their groups
# differ; numeric width/int-float-char mixes share group 3 and never fire, and any
# Unknown/Named/Void branch (group 0) never fires. Mirrors IncompatibleComparison's
# firmness gate but applied to the ternary's then/else pair instead of a binary `==`.

extend Semantic:
    private:
        # A string literal is a static u8 reference.  Stage0 merges it with a
        # non-static u8 reference (the common `u8&` parameter spelling), while
        # the coarse inference table otherwise sees the parameter as plain `u8`
        # and reports a false ternary mismatch.  Keep this exception narrow:
        # only a direct identifier recorded as `u8&` adapts, never an arbitrary
        # numeric expression or a cstr/sview value.
        def ternary_byte_ref_literal_adapts(expression: Ast::Expr, other: Ast::Expr, names: darray[sview]&, types: darray[sview]&) -> bool:
            can Abort.Panic:
                false return if literal_kind_of(expression) != "string"
                match other:
                    Expr.Ident(other_name, other_line):
                        return local_type_of(names, types, other_name) == "u8&"
                    _:
                        return false

        def ternary_is_byte_ref_annotation(expression: Ast::Expr) -> bool:
            can Abort.Panic:
                match expression:
                    Expr.Unary(operator, operand, unary_line):
                        return operator == TokenKind.Ampersand and bare_type_name(operand) == "u8"
                    _:
                        return false

        # stage0 types an unsuffixed int-literal branch at its DESTINATION's type when that
        # destination is an integer (`x: i64 = 1 if b else "s"`, a `-> i64` return, `x <- …`
        # onto an i64 local: `i64`), and leaves the builtin literal type `int` otherwise —
        # an untyped `v =` (inline or block tail), an operand, `x: bool =`, `x: f64 =`
        # (MEASURED, 19 contexts). "" = a context this walker does not model (call arguments,
        # fields); stage0 spells the literal `int` there too (measured 2026-09-19), which is
        # what the shared helper now returns, so the unmodelled case needs no special casing.
        def ternary_literal_spelling(branch: Ast::Expr, branch_type: InferType, literal_context: sview) -> sview:
            can Memory.Allocate, Abort.Panic:
                spelled: sview = stage0_expr_spelling(branch, branch_type)
                spelled return if literal_context == "" or literal_kind_of(branch) != "int"
                literal_context return if is_integer_type_name(literal_context)
                return "int"

        # `v = …` is untyped; `local <- …` takes the local's recorded type ("" when unknown).
        def ternary_assign_context(target: Ast::Expr, operator: TokenKind, var_types: darray[sview]&, type_names: darray[sview]&) -> sview:
            can Abort.Panic:
                "int" return if operator == TokenKind.Assign
                if operator == TokenKind.LArrow and target is Expr.Ident(assign_target_name, _):
                    return local_type_of(var_types, type_names, assign_target_name)
                return ""

        # Walk through expressions, checking for ternary branch mismatches.
        def walk_expression_for_ternary_branch_mismatch(expression: Ast::Expr, table: lmut SymbolTable, var_types: mutable darray[sview]&, type_names: mutable darray[sview]&, literal_context: sview) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Binary(left, operator, right, line):
                        table <- walk_expression_for_ternary_branch_mismatch(left, table, var_types, type_names, "int")
                        table <- walk_expression_for_ternary_branch_mismatch(right, table, var_types, type_names, "int") if operator != TokenKind.Is and operator != TokenKind.As
                    Expr.Call(callee, arguments, argument_names, line):
                        table <- walk_expression_for_ternary_branch_mismatch(callee, table, var_types, type_names, "")
                        for argument in arguments |table|:
                            table <- walk_expression_for_ternary_branch_mismatch(argument, table, var_types, type_names, "")
                    Expr.Field(object, field, line):
                        table <- walk_expression_for_ternary_branch_mismatch(object, table, var_types, type_names, "")
                    Expr.Scope(base, name, line):
                        table <- walk_expression_for_ternary_branch_mismatch(base, table, var_types, type_names, "")
                    Expr.Index(object, index, line):
                        table <- walk_expression_for_ternary_branch_mismatch(object, table, var_types, type_names, "")
                        table <- walk_expression_for_ternary_branch_mismatch(index, table, var_types, type_names, "") if not index_receiver_is_type_application(object)
                    Expr.Unary(operator, operand, line):
                        table <- walk_expression_for_ternary_branch_mismatch(operand, table, var_types, type_names, "int")
                    Expr.Paren(inner, line):
                        table <- walk_expression_for_ternary_branch_mismatch(inner, table, var_types, type_names, literal_context)
                    Expr.Array(elements, line):
                        for element in elements |table|:
                            table <- walk_expression_for_ternary_branch_mismatch(element, table, var_types, type_names, "int")
                    Expr.Tuple(elements, line):
                        for element in elements |table|:
                            table <- walk_expression_for_ternary_branch_mismatch(element, table, var_types, type_names, "")
                    Expr.Slice(object, low, high, line):
                        table <- walk_expression_for_ternary_branch_mismatch(object, table, var_types, type_names, "")
                        table <- walk_expression_for_ternary_branch_mismatch(low, table, var_types, type_names, "")
                        table <- walk_expression_for_ternary_branch_mismatch(high, table, var_types, type_names, "")
                    Expr.IndexN(object, arguments, line):
                        table <- walk_expression_for_ternary_branch_mismatch(object, table, var_types, type_names, "")
                        for argument in arguments |table|:
                            table <- walk_expression_for_ternary_branch_mismatch(argument, table, var_types, type_names, "") if not index_receiver_is_type_application(object)
                    Expr.SetLit(elements, line):
                        for element in elements |table|:
                            table <- walk_expression_for_ternary_branch_mismatch(element, table, var_types, type_names, "")
                    Expr.DictLit(entries, line):
                        for entry in entries |table|:
                            table <- walk_expression_for_ternary_branch_mismatch(entry.key, table, var_types, type_names, "")
                            table <- walk_expression_for_ternary_branch_mismatch(entry.value, table, var_types, type_names, "")
                    Expr.Construct(type_expression, fields, line):
                        table <- walk_expression_for_ternary_branch_mismatch(type_expression, table, var_types, type_names, "")
                        for field in fields |table|:
                            table <- walk_expression_for_ternary_branch_mismatch(field.value, table, var_types, type_names, "")
                    Expr.RecordUpdate(base, fields, line):
                        table <- walk_expression_for_ternary_branch_mismatch(base, table, var_types, type_names, "")
                        for field in fields |table|:
                            table <- walk_expression_for_ternary_branch_mismatch(field.value, table, var_types, type_names, "")
                    Expr.If(condition, then_expr, else_expr, line):
                        table <- walk_expression_for_ternary_branch_mismatch(condition, table, var_types, type_names, "")
                        table <- walk_expression_for_ternary_branch_mismatch(then_expr, table, var_types, type_names, literal_context)
                        table <- walk_expression_for_ternary_branch_mismatch(else_expr, table, var_types, type_names, literal_context)
                        then_type: InferType = infer_expression_type(then_expr, var_types, type_names, table)
                        else_type: InferType = infer_expression_type(else_expr, var_types, type_names, table)
                        then_group: u8 = comparison_group(then_type)
                        else_group: u8 = comparison_group(else_type)
                        adapts: bool = ternary_byte_ref_literal_adapts(then_expr, else_expr, var_types, type_names) or ternary_byte_ref_literal_adapts(else_expr, then_expr, var_types, type_names)
                        then_spelling: sview = ternary_literal_spelling(then_expr, then_type, literal_context)
                        else_spelling: sview = ternary_literal_spelling(else_expr, else_type, literal_context)
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.TernaryBranchMismatch, name: "", pos: line, line: line.line, expected: then_spelling, actual: else_spelling}) if then_group != 0 and else_group != 0 and then_group != else_group and not adapts
                        # S1g: two firm string branches of DIFFERENT representations (cstr vs
                        # sview vs dstr) share comparison group 3 but have no common type.
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.TernaryBranchMismatch, name: "", pos: line, line: line.line, expected: stage0_index_spelling(then_type), actual: stage0_index_spelling(else_type)}) if then_type.kind == SemTypeKind.String and string_member_never_fits(else_type, then_type.name)
                    Expr.Comprehension(loop_variable, iterable, condition, body, line):
                        table <- walk_expression_for_ternary_branch_mismatch(iterable, table, var_types, type_names, "")
                        table <- walk_expression_for_ternary_branch_mismatch(condition, table, var_types, type_names, "")
                        table <- walk_expression_for_ternary_branch_mismatch(body, table, var_types, type_names, "")
                    Expr.Lambda(parameters, body, line):
                        table <- walk_statements_for_ternary_branch_mismatch(body, table, var_types, type_names, "")
                    Expr.Block(statements, value, captures, line):
                        table <- walk_statements_for_ternary_branch_mismatch(statements, table, var_types, type_names, "")
                        table <- walk_expression_for_ternary_branch_mismatch(value, table, var_types, type_names, literal_context)
                    Expr.Match(scrutinee, arms, line):
                        table <- walk_expression_for_ternary_branch_mismatch(scrutinee, table, var_types, type_names, "")
                        for arm in arms |table|:
                            table <- walk_statements_for_ternary_branch_mismatch(arm.body, table, var_types, type_names, "")
                        # Match-EXPRESSION arm-value compatibility: an arm whose body is a single tail
                        # expression yields a value; if two such arms land in DIFFERENT non-zero
                        # comparison groups (a `static u8&` and a `sview`), the arms are incompatible.
                        ref_group: mutable u8 = 0
                        ref_expr: mutable Ast::Expr = (Ast::Expr.Absent)
                        ref_type: mutable InferType = zeroed
                        for arm in arms |ref_group, ref_expr, ref_type, table| -> table:
                            if arm.body.count == 1:
                                match arm.body[0]:
                                    Stmt.Expr(arm_value, arm_value_line):
                                        arm_type: InferType = infer_expression_type(arm_value, var_types, type_names, table)
                                        arm_group: u8 = comparison_group(arm_type)
                                        if arm_group != 0:
                                            if ref_group == 0:
                                                ref_group <- arm_group
                                                ref_expr <- arm_value
                                                ref_type <- arm_type
                                            elif arm_group != ref_group:
                                                # check_match_literal_arms owns a literal-vs-literal
                                                # pair: it spells the family stage0 spells ("int",
                                                # not "i64") and reports it at the conflicting arm.
                                                if literal_kind_of(ref_expr) == "" or literal_kind_of(arm_value) == "":
                                                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.MatchArmsIncompatible, name: "", line: line.line, expected: stage0_expr_spelling(ref_expr, ref_type), actual: stage0_expr_spelling(arm_value, arm_type), expected_count: 1})
                                    _:
                                        pass
                    # Literals and other expressions don't contain relevant sub-expressions
                    _:
                        pass

        # Walk through statements, tracking variable types and checking for ternary branch mismatches.
        def walk_statements_for_ternary_branch_mismatch(statements: darray[Ast::Stmt], table: lmut SymbolTable, var_types: mutable darray[sview]&, type_names: mutable darray[sview]&, return_context: sview) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table|:
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- walk_expression_for_ternary_branch_mismatch(expression, table, var_types, type_names, "")
                        Stmt.VarDecl(name, type_expression, value, line):
                            # Record the type for this variable
                            type_name: mutable sview = bare_type_name_through_ref(type_expression)
                            type_name <- "u8&" if type_name == "u8" and ternary_is_byte_ref_annotation(type_expression)
                            note_local_type(var_types, type_names, name, type_name)
                            table <- walk_expression_for_ternary_branch_mismatch(value, table, var_types, type_names, type_name if type_name != "" else "int")
                        Stmt.Assign(target, operator, value, line):
                            table <- walk_expression_for_ternary_branch_mismatch(target, table, var_types, type_names, "")
                            table <- walk_expression_for_ternary_branch_mismatch(value, table, var_types, type_names, ternary_assign_context(target, operator, var_types, type_names))
                        Stmt.If(condition, then_body, else_body, line):
                            table <- walk_expression_for_ternary_branch_mismatch(condition, table, var_types, type_names, "")
                            table <- walk_statements_for_ternary_branch_mismatch(then_body, table, var_types, type_names, return_context)
                            table <- walk_statements_for_ternary_branch_mismatch(else_body, table, var_types, type_names, return_context)
                        Stmt.While(condition, body, line):
                            table <- walk_expression_for_ternary_branch_mismatch(condition, table, var_types, type_names, "")
                            table <- walk_statements_for_ternary_branch_mismatch(body, table, var_types, type_names, return_context)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- walk_expression_for_ternary_branch_mismatch(iterable, table, var_types, type_names, "")
                            table <- walk_statements_for_ternary_branch_mismatch(body, table, var_types, type_names, return_context)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- walk_statements_for_ternary_branch_mismatch(body, table, var_types, type_names, return_context)
                        Stmt.Match(scrutinee, arms, line):
                            table <- walk_expression_for_ternary_branch_mismatch(scrutinee, table, var_types, type_names, "")
                            for arm in arms |table|:
                                table <- walk_expression_for_ternary_branch_mismatch(arm.guard, table, var_types, type_names, "")
                                table <- walk_statements_for_ternary_branch_mismatch(arm.body, table, var_types, type_names, return_context)
                        Stmt.Return(value, line):
                            table <- walk_expression_for_ternary_branch_mismatch(return_value, table, var_types, type_names, return_context) if value is return_value
                        Stmt.Contract(kind, expression, line):
                            table <- walk_expression_for_ternary_branch_mismatch(expression, table, var_types, type_names, "")
                        Stmt.Invalid:
                            pass
                        Stmt.Break(label, line):
                            pass
                        Stmt.Continue(label, line):
                            pass

        # Walk through function declarations.
        def check_ternary_branch_mismatch_declarations(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table|:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            # Create fresh type tracking for this function
                            var_types: mutable darray[sview] = []
                            type_names: mutable darray[sview] = []
                            # Record parameter types
                            for param in params |table|:
                                param_type: mutable sview = bare_type_name_through_ref(param.type_expression)
                                param_type <- "u8&" if param_type == "u8" and ternary_is_byte_ref_annotation(param.type_expression)
                                note_local_type(var_types, type_names, param.name, param_type)
                            # Walk the function body
                            return_type_name: sview = bare_type_name(declared_return) if return_type is declared_return else ""
                            table <- walk_statements_for_ternary_branch_mismatch(body, table, var_types, type_names, return_type_name if return_type_name != "void" else "")
                        Decl.Module(module_name, body, line):
                            table <- check_ternary_branch_mismatch_declarations(body, table)
                        Decl.Scoped(body, line):
                            table <- check_ternary_branch_mismatch_declarations(body, table)
                        _:
                            pass

    public:
        # Public entry point for the check.
        def check_ternary_branch_mismatch(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- check_ternary_branch_mismatch_declarations(declarations, table)
