# stage0's INFERENCE-BY-DEFAULT region wrap, mirrored structurally.
#
# `maybeWrapFunctionBodyInAutoRegion` (stage0 parser) wraps a function body in one
# synthesized lazy `region __auto_N:` when the body allocates region-lessly — a container
# local with no `@r`, a named-struct local holding a container field, a constructed local
# forwarded to a call, or a returned list-literal local — unless the function threads an
# explicit `Arena` parameter. The wrap is invisible in the surface syntax but it is REAL
# structure for two consumers:
#
#   * `-emit ast` / `-emit doc` print such a body as ONE statement (the driver).
#   * the semantic `defer function` rule: stage0 tests `currentNonGlobalScopeDepth() != 1`,
#     and the synthesized region is a scope, so `defer function:` written at the top of a
#     wrapped body is REJECTED ("only supported in the outermost function scope"). Before
#     this predicate was shared, stage1's rule was purely syntactic and accepted it — a
#     PERMISSIVE divergence (memory: defer-function-cleanup-scope-gap).
#
# The functions keep their historical `emit_ast_` names: the driver's emitters call them
# unchanged, and the emit_ast parity gate (byte parity over 135 fixtures) is what pins the
# predicate to stage0's behaviour.

# stage0's `hasArenaParam`: a function that receives an `Arena` manages allocation itself
# and is never wrapped, whatever its locals look like.
def auto_region_type_mentions_arena(type_expression: Ast::Expr) -> bool:
    match type_expression:
        Expr.Ident(arena_name, arena_line):
            return arena_name == "Arena"
        Expr.Unary(arena_operator, arena_operand, arena_unary_line):
            return auto_region_type_mentions_arena(arena_operand)
        Expr.Paren(arena_inner, arena_paren_line):
            return auto_region_type_mentions_arena(arena_inner)
        Expr.Index(arena_object, arena_argument, arena_index_line):
            true return if auto_region_type_mentions_arena(arena_object)
            return auto_region_type_mentions_arena(arena_argument)
        Expr.IndexN(arena_object_n, arena_arguments_n, arena_index_n_line):
            true return if auto_region_type_mentions_arena(arena_object_n)
            for arena_argument_n in arena_arguments_n:
                true return if auto_region_type_mentions_arena(arena_argument_n)
            return false
        _:
            return false


def auto_region_params_mention_arena(parameters: darray[Ast::ParamDecl]&) -> bool:
    for parameter in parameters:
        true return if auto_region_type_mentions_arena(parameter.type_expression)
    return false


# Whether stage0 wraps FUNCTION's body: the allocation predicate below, gated by the Arena
# exemption. This is the entry the semantic layer uses.
def auto_region_function_body_is_wrapped(file: Ast::File&, parameters: darray[Ast::ParamDecl]&, body: darray[Ast::Stmt]&, function_line: u32) -> bool can[Abort.Panic, Memory.Allocate]:
    can Abort.Panic, Memory.Allocate:
        false return if auto_region_params_mention_arena(parameters)
        return emit_ast_body_declares_container(body, file.local_region_annotations, function_line, file.struct_names, file.struct_member_rows, file.struct_member_starts, file.struct_member_counts)


    # Whether a type annotation names a CONTAINER (darray/dict/set/dstr head): the shapes
    # whose locals make stage0's region inference wrap the whole body in one `in auto:`
    # block — which is why its ast dump prints such a body as "(1 stmts)".
def emit_ast_expr_head_is_container(expression: Ast::Expr) -> bool can[Abort.Panic, Memory.Allocate]:
    can Abort.Panic, Memory.Allocate:
        if expression is Expr.Ident(head_name, head_line):
            return when head_name:
                "darray" | "dict" | "set" | "dstr" -> true
                _ -> false
        if expression is Expr.Index(head_object, head_arg, head_index_line):
            return emit_ast_expr_head_is_container(head_object)
        if expression is Expr.IndexN(head_object_n, head_args_n, head_line_n):
            return emit_ast_expr_head_is_container(head_object_n)
        if expression is Expr.Paren(head_inner, head_paren_line):
            return emit_ast_expr_head_is_container(head_inner)
        if expression is Expr.Unary(head_operator, head_operand, head_unary_line):
            return emit_ast_expr_head_is_container(head_operand)
        return false


    # A local whose declared type is a named STRUCT holding a container FIELD wraps too.
    # Measured against stage0: `struct Grid: cells: array[i64, 4]` then `g: Grid = …` prints
    # "(1 stmts)" under stage0 while a struct of plain scalars, and a BARE `array[i64, 3]`
    # local, both print their real count. Looking only at the declared type HEAD missed the
    # whole family — the head is `Grid`, not a container name.
    #
    # `array` counts here even though a fixed array allocates nothing on its own: the rule is
    # stage0's, read off its output, not a claim about where the storage lives.
def emit_ast_struct_field_is_container(field_type: Ast::Expr) -> bool can[Abort.Panic, Memory.Allocate]:
    can Abort.Panic, Memory.Allocate:
        if field_type is Expr.Ident(field_head_name, field_head_line):
            return when field_head_name:
                "darray" | "dict" | "set" | "dstr" | "array" -> true
                _ -> false
        if field_type is Expr.Index(field_object, field_arg, field_index_line):
            return emit_ast_struct_field_is_container(field_object)
        if field_type is Expr.IndexN(field_object_n, field_args_n, field_line_n):
            return emit_ast_struct_field_is_container(field_object_n)
        return false


def emit_ast_named_struct_holds_container(type_expression: Ast::Expr, struct_names: darray[sview]&, struct_member_rows: darray[Ast::StructMember]&, struct_member_starts: darray[usize]&, struct_member_counts: darray[usize]&) -> bool can[Abort.Panic, Memory.Allocate]:
    can Abort.Panic, Memory.Allocate:
        if type_expression is Expr.Ident(struct_type_name, struct_type_line):
            for struct_index in 0..<struct_names.count |struct_type_name, struct_names, struct_member_rows, struct_member_starts, struct_member_counts|:
                continue if struct_names[struct_index] != struct_type_name
                member_start: usize = struct_member_starts[struct_index]
                member_count: usize = struct_member_counts[struct_index]
                for member_offset in 0..<member_count |member_start, struct_member_rows|:
                    true return if emit_ast_struct_field_is_container(struct_member_rows[member_start + member_offset].type_expression)
            return false
        return false


    # A container local with an explicit `@region` annotation allocates from THAT region,
    # not the auto one, so it does not trigger the wrap (region_statement_form prints its
    # real statement count under stage0). The annotations are line+name keyed.
def emit_ast_local_has_region(annotations: darray[Ast::LocalRegionAnnotation]&, name: sview, line: u32) -> bool can[Abort.Panic, Memory.Allocate]:
    for region_row in annotations |name, line|:
        true return if region_row.name == name and region_row.line == line and region_row.region != ""
    return false


def emit_ast_is_container_literal_value(value: Ast::Expr) -> bool:
    if value is Expr.Array(container_elements, container_literal_pos):
        return true
    if value is Expr.Paren(container_inner, container_paren_pos):
        return emit_ast_is_container_literal_value(container_inner)
    return false


def emit_ast_collect_container_literal_names(statements: darray[Ast::Stmt]&, names: mutable darray[sview]&) -> void:
    for statement in statements:
        match statement:
            Stmt.VarDecl(container_name, container_type, container_value, container_decl_pos):
                names.push(container_name) if emit_ast_is_container_literal_value(container_value)
                if container_value is Expr.Block(container_block_stmts, container_block_value, container_block_captures, container_block_pos):
                    emit_ast_collect_container_literal_names(container_block_stmts, names)
            Stmt.Block(container_kind, container_clause, container_binding, container_body, container_block_pos):
                emit_ast_collect_container_literal_names(container_body, names)
            Stmt.If(container_condition, container_then, container_else, container_if_pos):
                emit_ast_collect_container_literal_names(container_then, names)
                emit_ast_collect_container_literal_names(container_else, names)
            Stmt.While(container_while_condition, container_while_body, container_while_pos):
                emit_ast_collect_container_literal_names(container_while_body, names)
            Stmt.For(container_bind, container_variables, container_iterable, container_for_body, container_for_pos):
                emit_ast_collect_container_literal_names(container_for_body, names)
            Stmt.Match(container_match_value, container_match_arms, container_match_pos):
                for container_arm in container_match_arms:
                    emit_ast_collect_container_literal_names(container_arm.body, names)
            _:
                pass


def emit_ast_expr_returns_container_literal_name(value: Ast::Expr, names: darray[sview]&) -> bool:
    if value is Expr.Ident(return_name, return_pos):
        return emit_ast_name_is_constructed(names, return_name)
    if value is Expr.Paren(return_inner, return_paren_pos):
        return emit_ast_expr_returns_container_literal_name(return_inner, names)
    return false


def emit_ast_stmts_return_container_literal_name(statements: darray[Ast::Stmt]&, names: darray[sview]&) -> bool:
    for statement in statements:
        match statement:
            Stmt.Return(return_value, return_pos):
                if return_value is returned:
                    true return if emit_ast_expr_returns_container_literal_name(returned, names)
            Stmt.Block(return_kind, return_clause, return_binding, return_body, return_block_pos):
                true return if emit_ast_stmts_return_container_literal_name(return_body, names)
            Stmt.If(return_condition, return_then, return_else, return_if_pos):
                true return if emit_ast_stmts_return_container_literal_name(return_then, names)
                true return if emit_ast_stmts_return_container_literal_name(return_else, names)
            Stmt.While(return_while_condition, return_while_body, return_while_pos):
                true return if emit_ast_stmts_return_container_literal_name(return_while_body, names)
            Stmt.For(return_bind, return_variables, return_iterable, return_for_body, return_for_pos):
                true return if emit_ast_stmts_return_container_literal_name(return_for_body, names)
            Stmt.Match(return_match_value, return_match_arms, return_match_pos):
                for return_arm in return_match_arms:
                    true return if emit_ast_stmts_return_container_literal_name(return_arm.body, names)
            _:
                pass
    return false


def emit_ast_body_returns_container_literal_local(statements: darray[Ast::Stmt]&) -> bool:
    literal_names: mutable darray[sview] = []
    emit_ast_collect_container_literal_names(statements, &literal_names)
    return false if literal_names.count == 0
    return emit_ast_stmts_return_container_literal_name(statements, literal_names)


def emit_ast_body_declares_container(statements: darray[Ast::Stmt]&, annotations: darray[Ast::LocalRegionAnnotation]&, function_line: u32, struct_names: darray[sview]&, struct_member_rows: darray[Ast::StructMember]&, struct_member_starts: darray[usize]&, struct_member_counts: darray[usize]&) -> bool can[Abort.Panic, Memory.Allocate]:
    can Abort.Panic, Memory.Allocate:
        # The AST mode runs the same diagnostic pass as stage0 before printing. That pass
        # classifies a function returning a local list literal as region-polymorphic even
        # when the local and return are explicitly tied to a region, then wraps the body
        # so the inferred list allocation has an adoptable scope. The parser AST itself
        # still contains the original statements, so reproduce the semantic shape here.
        true return if emit_ast_local_has_region(annotations, "__region_return", function_line) and emit_ast_body_returns_container_literal_local(statements)
        # stage0 also wraps a body when a constructed local is forwarded to a call: a
        # region-less container field can be grown by that callee, so the call needs an
        # ambient owner even when the local's declared type is an ordinary struct.
        true return if emit_ast_body_forwards_constructed_local(statements, annotations)
        for wrap_statement in statements |annotations, struct_names, struct_member_rows, struct_member_starts, struct_member_counts|:
            if wrap_statement is Stmt.VarDecl(wrap_name, wrap_type, wrap_value, wrap_line):
                wrap_is_container: bool = emit_ast_expr_head_is_container(wrap_type) or emit_ast_named_struct_holds_container(wrap_type, struct_names, struct_member_rows, struct_member_starts, struct_member_counts)
                true return if wrap_is_container and not emit_ast_local_has_region(annotations, wrap_name, wrap_line.line)
            if wrap_statement is Stmt.If(wrap_cond, wrap_then, wrap_else, wrap_if_line):
                true return if emit_ast_body_declares_container(wrap_then, annotations, function_line, struct_names, struct_member_rows, struct_member_starts, struct_member_counts)
                true return if emit_ast_body_declares_container(wrap_else, annotations, function_line, struct_names, struct_member_rows, struct_member_starts, struct_member_counts)
            if wrap_statement is Stmt.While(wrap_wcond, wrap_wbody, wrap_while_line):
                true return if emit_ast_body_declares_container(wrap_wbody, annotations, function_line, struct_names, struct_member_rows, struct_member_starts, struct_member_counts)
            if wrap_statement is Stmt.For(wrap_bind, wrap_vars, wrap_iter, wrap_fbody, wrap_for_line):
                true return if emit_ast_body_declares_container(wrap_fbody, annotations, function_line, struct_names, struct_member_rows, struct_member_starts, struct_member_counts)
            if wrap_statement is Stmt.Block(wrap_kind, wrap_clause, wrap_binding, wrap_bbody, wrap_block_line):
                # An explicit `region r(...):` already owns the allocation scope. Looking
                # through it and requesting another synthetic wrapper changed a two-statement
                # body (`region ...` plus the following statement) into a one-statement body in
                # the AST summary, and falsely marked region-generic machine code as inferred.
                continue if wrap_kind == "region"
                true return if emit_ast_body_declares_container(wrap_bbody, annotations, function_line, struct_names, struct_member_rows, struct_member_starts, struct_member_counts)
            if wrap_statement is Stmt.Match(wrap_scrutinee, wrap_arms, wrap_match_line):
                for wrap_arm in wrap_arms |annotations, struct_names, struct_member_rows, struct_member_starts, struct_member_counts|:
                    true return if emit_ast_body_declares_container(wrap_arm.body, annotations, function_line, struct_names, struct_member_rows, struct_member_starts, struct_member_counts)
        return false


# The parser AST keeps the same structural distinction as stage0's StructLitExpr: a
# brace construction is a constructed local, while a plain identifier/call is not. Keep
# this scan explicit and data-oriented so the AST report does not need a source-text
# heuristic (which would mis-handle nested calls and parenthesized arguments).
def emit_ast_is_constructed_value(value: Ast::Expr) -> bool:
    if value is Expr.Construct(constructed_type, constructed_fields, constructed_pos):
        return true
    if value is Expr.Paren(constructed_inner, constructed_paren_pos):
        return emit_ast_is_constructed_value(constructed_inner)
    return false


def emit_ast_name_is_constructed(names: darray[sview]&, name: sview) -> bool:
    for constructed_name in names:
        true return if constructed_name == name
    return false


# `&local` is represented as a unary expression in the stage1 AST. Parentheses and
# `move local` are transparent for the same forwarding decision stage0 makes.
def emit_ast_is_constructed_ref(value: Ast::Expr, names: darray[sview]&) -> bool:
    if value is Expr.Ident(forward_name, forward_pos):
        return emit_ast_name_is_constructed(names, forward_name)
    if value is Expr.Paren(forward_inner, forward_paren_pos):
        return emit_ast_is_constructed_ref(forward_inner, names)
    if value is Expr.Unary(forward_operator, forward_operand, forward_unary_pos):
        return emit_ast_is_constructed_ref(forward_operand, names)
    if value is Expr.Move(forward_moved, forward_move_pos):
        return emit_ast_is_constructed_ref(forward_moved, names)
    return false


def emit_ast_optional_expr_forwards_constructed(expression: Ast::Expr?, names: darray[sview]&) -> bool:
    if expression == null:
        return false
    return emit_ast_expr_forwards_constructed(expression, names)


def emit_ast_expr_forwards_constructed(expression: Ast::Expr, names: darray[sview]&) -> bool:
    match expression:
        Expr.Call(forward_func, forward_args, forward_argument_names, forward_call_pos):
            for forward_arg in forward_args:
                true return if emit_ast_is_constructed_ref(forward_arg, names)
            true return if emit_ast_expr_forwards_constructed(forward_func, names)
            for forward_arg in forward_args:
                true return if emit_ast_expr_forwards_constructed(forward_arg, names)
        Expr.Field(forward_object, forward_field, forward_field_pos):
            return emit_ast_expr_forwards_constructed(forward_object, names)
        Expr.Scope(forward_scope, forward_member, forward_scope_pos):
            return emit_ast_expr_forwards_constructed(forward_scope, names)
        Expr.Index(forward_object, forward_index, forward_index_pos):
            true return if emit_ast_expr_forwards_constructed(forward_object, names)
            return emit_ast_expr_forwards_constructed(forward_index, names)
        Expr.Slice(forward_slice_object, forward_slice_start, forward_slice_end, forward_slice_pos):
            true return if emit_ast_expr_forwards_constructed(forward_slice_object, names)
            true return if emit_ast_expr_forwards_constructed(forward_slice_start, names)
            return emit_ast_expr_forwards_constructed(forward_slice_end, names)
        Expr.IndexN(forward_object_n, forward_indices_n, forward_index_n_pos):
            true return if emit_ast_expr_forwards_constructed(forward_object_n, names)
            for forward_index_n in forward_indices_n:
                true return if emit_ast_expr_forwards_constructed(forward_index_n, names)
        Expr.Binary(forward_left, forward_operator, forward_right, forward_binary_pos):
            true return if emit_ast_expr_forwards_constructed(forward_left, names)
            return emit_ast_expr_forwards_constructed(forward_right, names)
        Expr.Unary(forward_unary_operator, forward_operand, forward_unary_pos):
            return emit_ast_expr_forwards_constructed(forward_operand, names)
        Expr.Move(forward_moved_value, forward_move_value_pos):
            return emit_ast_expr_forwards_constructed(forward_moved_value, names)
        Expr.RegionNew(forward_region_operand, forward_region_name, forward_region_pos):
            return emit_ast_expr_forwards_constructed(forward_region_operand, names)
        Expr.Paren(forward_paren_inner, forward_paren_expr_pos):
            return emit_ast_expr_forwards_constructed(forward_paren_inner, names)
        Expr.Array(forward_elements, forward_array_pos):
            for forward_element in forward_elements:
                true return if emit_ast_expr_forwards_constructed(forward_element, names)
        Expr.Tuple(forward_tuple_elements, forward_tuple_pos):
            for forward_tuple_element in forward_tuple_elements:
                true return if emit_ast_expr_forwards_constructed(forward_tuple_element, names)
        Expr.SetLit(forward_set_elements, forward_set_pos):
            for forward_set_element in forward_set_elements:
                true return if emit_ast_expr_forwards_constructed(forward_set_element, names)
        Expr.DictLit(forward_entries, forward_dict_pos):
            for forward_entry in forward_entries:
                true return if emit_ast_expr_forwards_constructed(forward_entry.key, names)
                true return if emit_ast_expr_forwards_constructed(forward_entry.value, names)
        Expr.Construct(forward_construct_type, forward_fields, forward_construct_pos):
            true return if emit_ast_expr_forwards_constructed(forward_construct_type, names)
            for forward_field in forward_fields:
                true return if emit_ast_expr_forwards_constructed(forward_field.value, names)
        Expr.RecordUpdate(forward_record_base, forward_record_fields, forward_record_pos):
            true return if emit_ast_expr_forwards_constructed(forward_record_base, names)
            for forward_field in forward_record_fields:
                true return if emit_ast_expr_forwards_constructed(forward_field.value, names)
        Expr.If(forward_if_condition, forward_if_then, forward_if_else, forward_if_pos):
            true return if emit_ast_expr_forwards_constructed(forward_if_condition, names)
            true return if emit_ast_expr_forwards_constructed(forward_if_then, names)
            return emit_ast_expr_forwards_constructed(forward_if_else, names)
        Expr.Match(forward_match_scrutinee, forward_match_arms, forward_match_pos):
            true return if emit_ast_expr_forwards_constructed(forward_match_scrutinee, names)
            for forward_match_arm in forward_match_arms:
                true return if emit_ast_stmts_forwards_constructed(forward_match_arm.body, names)
                true return if emit_ast_expr_forwards_constructed(forward_match_arm.guard, names)
        Expr.Catch(forward_catch_guarded, forward_catch_arms, forward_catch_pos):
            true return if emit_ast_expr_forwards_constructed(forward_catch_guarded, names)
            for forward_catch_arm in forward_catch_arms:
                true return if emit_ast_stmts_forwards_constructed(forward_catch_arm.body, names)
                true return if emit_ast_expr_forwards_constructed(forward_catch_arm.guard, names)
        Expr.Comprehension(forward_comp_var, forward_comp_iterable, forward_comp_condition, forward_comp_body, forward_comp_pos):
            true return if emit_ast_expr_forwards_constructed(forward_comp_iterable, names)
            true return if emit_ast_expr_forwards_constructed(forward_comp_condition, names)
            return emit_ast_expr_forwards_constructed(forward_comp_body, names)
        Expr.Refinement(forward_refinement_base, forward_refinement_predicate, forward_refinement_pos):
            true return if emit_ast_expr_forwards_constructed(forward_refinement_base, names)
            return emit_ast_expr_forwards_constructed(forward_refinement_predicate, names)
        Expr.GetElse(forward_get_guarded, forward_get_recovery, forward_get_pos):
            true return if emit_ast_expr_forwards_constructed(forward_get_guarded, names)
            return emit_ast_stmts_forwards_constructed(forward_get_recovery, names)
        Expr.Lambda(forward_lambda_params, forward_lambda_body, forward_lambda_pos):
            return emit_ast_stmts_forwards_constructed(forward_lambda_body, names)
        Expr.Block(forward_block_stmts, forward_block_value, forward_block_captures, forward_block_pos):
            true return if emit_ast_stmts_forwards_constructed(forward_block_stmts, names)
            return emit_ast_expr_forwards_constructed(forward_block_value, names)
        _:
            pass
    return false


def emit_ast_stmts_forwards_constructed(statements: darray[Ast::Stmt]&, names: darray[sview]&) -> bool:
    for statement in statements:
        match statement:
            Stmt.Expr(forward_expr, forward_expr_pos):
                true return if emit_ast_expr_forwards_constructed(forward_expr, names)
            Stmt.Block(forward_kind, forward_clause, forward_binding, forward_body, forward_block_pos):
                true return if emit_ast_stmts_forwards_constructed(forward_body, names)
            Stmt.VarDecl(forward_var_name, forward_var_type, forward_var_value, forward_var_pos):
                true return if emit_ast_expr_forwards_constructed(forward_var_value, names)
            Stmt.Assign(forward_target, forward_assign_operator, forward_value, forward_assign_pos):
                true return if emit_ast_expr_forwards_constructed(forward_target, names)
                true return if emit_ast_expr_forwards_constructed(forward_value, names)
            Stmt.If(forward_condition, forward_then, forward_else, forward_if_pos):
                true return if emit_ast_expr_forwards_constructed(forward_condition, names)
                true return if emit_ast_stmts_forwards_constructed(forward_then, names)
                true return if emit_ast_stmts_forwards_constructed(forward_else, names)
            Stmt.While(forward_while_condition, forward_while_body, forward_while_pos):
                true return if emit_ast_expr_forwards_constructed(forward_while_condition, names)
                true return if emit_ast_stmts_forwards_constructed(forward_while_body, names)
            Stmt.For(forward_bind, forward_variables, forward_iterable, forward_for_body, forward_for_pos):
                true return if emit_ast_expr_forwards_constructed(forward_iterable, names)
                true return if emit_ast_stmts_forwards_constructed(forward_for_body, names)
            Stmt.Return(forward_return_value, forward_return_pos):
                true return if emit_ast_optional_expr_forwards_constructed(forward_return_value, names)
            Stmt.Match(forward_match_value, forward_match_arms, forward_match_pos):
                true return if emit_ast_expr_forwards_constructed(forward_match_value, names)
                for forward_match_arm in forward_match_arms:
                    true return if emit_ast_stmts_forwards_constructed(forward_match_arm.body, names)
                    true return if emit_ast_expr_forwards_constructed(forward_match_arm.guard, names)
            Stmt.Contract(forward_contract_kind, forward_contract_expression, forward_contract_pos):
                true return if emit_ast_expr_forwards_constructed(forward_contract_expression, names)
            _:
                pass
    return false


def emit_ast_collect_constructed_names(statements: darray[Ast::Stmt]&,
        annotations: darray[Ast::LocalRegionAnnotation]&,
        names: mutable darray[sview]&) -> void:
    for statement in statements:
        match statement:
            Stmt.VarDecl(constructed_name, constructed_type, constructed_value, constructed_decl_pos):
                names.push(constructed_name) if emit_ast_is_constructed_value(constructed_value) and not emit_ast_local_has_region(annotations, constructed_name, constructed_decl_pos.line)
                if constructed_value is Expr.Block(constructed_block_stmts, constructed_block_value, constructed_block_captures, constructed_block_pos):
                    emit_ast_collect_constructed_names(constructed_block_stmts, annotations, names)
            Stmt.Block(constructed_kind, constructed_clause, constructed_binding, constructed_body, constructed_block_pos):
                emit_ast_collect_constructed_names(constructed_body, annotations, names)
            Stmt.If(constructed_condition, constructed_then, constructed_else, constructed_if_pos):
                emit_ast_collect_constructed_names(constructed_then, annotations, names)
                emit_ast_collect_constructed_names(constructed_else, annotations, names)
            Stmt.While(constructed_while_condition, constructed_while_body, constructed_while_pos):
                emit_ast_collect_constructed_names(constructed_while_body, annotations, names)
            Stmt.For(constructed_bind, constructed_variables, constructed_iterable, constructed_for_body, constructed_for_pos):
                emit_ast_collect_constructed_names(constructed_for_body, annotations, names)
            Stmt.Match(constructed_match_value, constructed_match_arms, constructed_match_pos):
                for constructed_arm in constructed_match_arms:
                    emit_ast_collect_constructed_names(constructed_arm.body, annotations, names)
            _:
                pass


def emit_ast_body_forwards_constructed_local(statements: darray[Ast::Stmt]&,
        annotations: darray[Ast::LocalRegionAnnotation]&) -> bool:
    constructed_names: mutable darray[sview] = []
    emit_ast_collect_constructed_names(statements, annotations, &constructed_names)
    return false if constructed_names.count == 0
    return emit_ast_stmts_forwards_constructed(statements, constructed_names)
