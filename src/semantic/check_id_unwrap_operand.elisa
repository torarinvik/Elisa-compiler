# The id-unwrap prefix `!x` (distinct from boolean `not`) requires an `id[T]` operand — it turns
# a typed id handle back into its underlying value. Applying it to a non-id value (`!raw` where
# `raw: u32`) is rejected. SOUND subset: fires only when the operand is a bare Ident whose declared
# param/local type is a primitive (definitely not an id[T]); an id-typed or unknown operand is left
# alone.
extend Semantic:
    private:
        # The primitive base name of a param/local annotation (looking through mutable/&), else ""
        # — an `id[T]` annotation is an Index/IndexN, never a bare primitive, so it returns "".
        def idunwrap_primitive_type(type_expression: Ast::Expr) -> sview:
            can Memory.Allocate, Abort.Panic:
                match type_expression:
                    Expr.Ident(name, ident_line):
                        name return if is_primitive_type_name(name)
                        return sview("", 0, 0)
                    Expr.Unary(operator, operand, unary_line):
                        return idunwrap_primitive_type(operand)
                    Expr.Paren(inner, paren_line):
                        return idunwrap_primitive_type(inner)
                    _:
                        return sview("", 0, 0)

        def idunwrap_collect_locals(statements: darray[Ast::Stmt], names: mutable darray[sview]&, types: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |names, types|:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            primitive: sview = idunwrap_primitive_type(type_expression)
                            if primitive != "":
                                names.push(name)
                                types.push(primitive)
                        Stmt.If(condition, then_body, else_body, line):
                            idunwrap_collect_locals(then_body, names, types)
                            idunwrap_collect_locals(else_body, names, types)
                        Stmt.While(condition, while_body, line):
                            idunwrap_collect_locals(while_body, names, types)
                        Stmt.For(bind, variables, iterable, for_body, line):
                            idunwrap_collect_locals(for_body, names, types)
                        Stmt.Block(kind, clause, binding, body, line):
                            idunwrap_collect_locals(body, names, types)
                        _:
                            pass

        def idunwrap_type_of(names: darray[sview]&, types: darray[sview]&, name: sview) -> sview:
            can Abort.Panic:
                index: mutable usize = 0
                found: mutable sview = sview("", 0, 0)
                while index < names.count |found, index|:
                    found <- types[index] if names[index] == name and found == ""
                    index <- index + 1
                return found

        def idunwrap_check_expression(expression: Ast::Expr, names: darray[sview]&, types: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Unary(operator, operand, line):
                        if operator == TokenKind.Bang:
                            operand_type: sview = idunwrap_type_of(names, types, ident_name_of(operand))
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.IdUnwrapNonId, name: "", line: line, expected: "", actual: operand_type}) if operand_type != ""
                        table <- idunwrap_check_expression(operand, names, types, table)
                    Expr.Binary(left, binary_operator, right, binary_line):
                        table <- idunwrap_check_expression(left, names, types, table)
                        table <- idunwrap_check_expression(right, names, types, table)
                    Expr.Paren(inner, paren_line):
                        table <- idunwrap_check_expression(inner, names, types, table)
                    Expr.Call(callee, arguments, argument_names, call_line):
                        for argument in arguments |table| -> table:
                            table <- idunwrap_check_expression(argument, names, types, table)
                    _:
                        pass

        def idunwrap_check_statements(statements: darray[Ast::Stmt], names: darray[sview]&, types: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- idunwrap_check_expression(expression, names, types, table)
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- idunwrap_check_expression(value, names, types, table)
                        Stmt.Assign(target, operator, value, line):
                            table <- idunwrap_check_expression(value, names, types, table)
                        Stmt.Return(value, line):
                            table <- idunwrap_check_expression(returned, names, types, table) if value is returned
                        Stmt.If(condition, then_body, else_body, line):
                            table <- idunwrap_check_expression(condition, names, types, table)
                            table <- idunwrap_check_statements(then_body, names, types, table)
                            table <- idunwrap_check_statements(else_body, names, types, table)
                        Stmt.While(condition, while_body, line):
                            table <- idunwrap_check_expression(condition, names, types, table)
                            table <- idunwrap_check_statements(while_body, names, types, table)
                        Stmt.For(bind, variables, iterable, for_body, line):
                            table <- idunwrap_check_statements(for_body, names, types, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- idunwrap_check_statements(body, names, types, table)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |table| -> table:
                                table <- idunwrap_check_statements(arm.body, names, types, table)
                        _:
                            pass

        def idunwrap_walk(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            names: mutable darray[sview] = []
                            types: mutable darray[sview] = []
                            for parameter in parameters |names, types|:
                                parameter_primitive: sview = idunwrap_primitive_type(parameter.type_expression)
                                if parameter_primitive != "":
                                    names.push(parameter.name)
                                    types.push(parameter_primitive)
                            idunwrap_collect_locals(body, names, types)
                            table <- idunwrap_check_statements(body, names, types, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- idunwrap_walk(module_body, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- idunwrap_walk(scoped_body, table)
                        _:
                            pass

    public:
        def check_id_unwrap_operand(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- idunwrap_walk(file.top_decls, table)
