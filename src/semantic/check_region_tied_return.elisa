# Region-tied returns (docs/74/75). A borrowed value derived from a parameter (a field
# container, a view/slice of it, a reference into it, or an explicitly region-tied sview) lives
# in the caller's region for that parameter; returning it with a REGION-LESS type erases the tie:
#
#     def leak(m: mutable Mod&) -> view[u8]:        # -> flagged (__rg_m tie erased)
#         return m.bits[0:1]
#     def ok[@r](m: mutable Mod& @r) -> view[u8] @r:  # -> silent (tie declared)
#         return m.bits[0:1]
#
# The parser records `-> T @r` as a "__region_return" annotation on the function's
# line; a region-kind return type without one, returning a param-rooted value, is the
# stage0 diagnostic ported here.
extend Semantic:
    private:
        # Whether a return TYPE names a region-carrying kind: a view family, a growable
        # container, or a reference.
        def rtr_type_is_region_kind(type_expression: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                return true if:
                    return_type_is_view(type_expression)
                    annotation_is_container(type_expression)
                match type_expression:
                    Expr.Unary(operator, operand, line):
                        return (true) if operator == TokenKind.Ampersand
                        return rtr_type_is_region_kind(operand)
                    Expr.Paren(inner, paren_line):
                        return rtr_type_is_region_kind(inner)
                    _:
                        return false


        # `void&` and its optional/mutable forms are opaque untyped pointers at
        # foreign-function boundaries, not region-borrow types. Stage0 permits a
        # callback such as `def worker(arg: mutable void&?) -> mutable void&?:
        # return arg`; tying that opaque pointer to the caller's inferred argument
        # region would reject the callback despite there being no typed region fact
        # to preserve. Walk every unary wrapper (including `?`) to identify only
        # the void pointee; typed references remain subject to the normal rule.
        def rtr_type_has_void_pointee(type_expression: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                match type_expression:
                    Expr.Unary(operator, operand, line):
                        return rtr_type_has_void_pointee(operand)
                    Expr.Paren(inner, line):
                        return rtr_type_has_void_pointee(inner)
                    Expr.Ident(name, line):
                        return name == "void"
                    _:
                        return false


        # These methods return a view into their receiver, so a returned call retains
        # the receiver's region just like an explicit slice or field borrow.
        def rtr_is_view_method(method: sview) -> bool:
            can Abort.Panic:
                return when method:
                    "as_sview" | "as_cstr" | "as_view" | "as_slice" -> true
                    _ -> false


        # The borrowed PARAM a returned value roots at (through fields/slices/indexes and
        # `&` borrows), or "".
        def rtr_return_root(expression: Ast::Expr, ref_params: darray[sview]&, include_direct: bool) -> sview:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Ident(name, ident_line):
                        return name if include_direct and any p in ref_params where p == name
                        return sview("", 0, 0)
                    # Returning the PARAM ITSELF — or a direct slice/element of a
                    # CONTAINER param — is reference forwarding (the view still names
                    # the caller's own container). Only a STRUCT-FIELD hop erases the
                    # tie (`m.bits[0:1]` hides which region backs the bits).
                    Expr.Field(object, field, field_line):
                        return rtr_derived_base(object, ref_params)
                    Expr.Index(object, index_argument, index_line):
                        # `recv.cast[T]` is a TYPE APPLICATION (reinterpret), not a
                        # container-element access: returning a ref-cast of a ref param
                        # forwards the borrow (the tie rides the reference return type),
                        # exactly like returning the param itself. Recurse into the cast
                        # receiver as forwarding rather than treating `.cast` as a field hop.
                        match object:
                            Expr.Field(cast_receiver, cast_field, cast_field_line):
                                return rtr_return_root(cast_receiver, ref_params, include_direct) if cast_field == "cast"
                            _:
                                pass
                        return rtr_field_hopped_base(object, ref_params)
                    Expr.Slice(object, low, high, slice_line):
                        return rtr_field_hopped_base(object, ref_params)
                    Expr.Unary(operator, operand, unary_line):
                        return rtr_return_root(operand, ref_params, include_direct)
                    Expr.Paren(inner, paren_line):
                        return rtr_return_root(inner, ref_params, include_direct)
                    Expr.Call(callee, arguments, argument_names, call_line):
                        match callee:
                            Expr.Field(receiver, method, field_line):
                                return rtr_return_root(receiver, ref_params, include_direct) if rtr_is_view_method(method)
                            _:
                                pass
                        return sview("", 0, 0)
                    _:
                        return sview("", 0, 0)


        # The ref param a DERIVED chain bottoms out at (the ident itself, or deeper
        # field/slice/index hops).
        def rtr_derived_base(expression: Ast::Expr, ref_params: darray[sview]&) -> sview:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Ident(name, line):
                        return name if any p in ref_params where p == name
                        return sview("", 0, 0)
                    Expr.Field(object, field, field_line):
                        return rtr_derived_base(object, ref_params)
                    Expr.Index(object, index_argument, index_line):
                        return rtr_derived_base(object, ref_params)
                    Expr.Slice(object, low, high, slice_line):
                        return rtr_derived_base(object, ref_params)
                    Expr.Paren(inner, paren_line):
                        return rtr_derived_base(inner, ref_params)
                    Expr.Unary(operator, operand, unary_line):
                        return rtr_derived_base(operand, ref_params)
                    _:
                        return sview("", 0, 0)


        # A base that reaches the param THROUGH at least one field hop.
        def rtr_field_hopped_base(expression: Ast::Expr, ref_params: darray[sview]&) -> sview:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Field(object, field, field_line):
                        return rtr_derived_base(object, ref_params)
                    Expr.Paren(inner, paren_line):
                        return rtr_field_hopped_base(inner, ref_params)
                    Expr.Index(object, index_argument, index_line):
                        return rtr_field_hopped_base(object, ref_params)
                    Expr.Slice(object, low, high, slice_line):
                        return rtr_field_hopped_base(object, ref_params)
                    _:
                        return sview("", 0, 0)


        # A parameter is a direct reference parameter only when the reference operator is
        # outside its container/aggregate type. This matters for `darray[T]&`: the pointee
        # itself is a heap-backed type, but the parameter still borrows the caller's value.
        def rtr_type_has_outer_reference(type_expression: Ast::Expr) -> bool:
            can Abort.Panic:
                match type_expression:
                    Expr.Unary(operator, operand, line):
                        return true if operator == TokenKind.Ampersand
                        return rtr_type_has_outer_reference(operand) if operator == TokenKind.Mutable or operator == TokenKind.Question
                        return false
                    Expr.Paren(inner, line):
                        return rtr_type_has_outer_reference(inner)
                    _:
                        return false


        # True when a container's ELEMENT type can retain a reference. Peel only wrappers
        # around the container itself; a reference to a scalar darray (`darray[i64]&`) is
        # not confused with a darray whose elements are references (`darray[i64&]`).
        def rtr_type_contains_reference(type_expression: Ast::Expr) -> bool:
            can Abort.Panic:
                match type_expression:
                    Expr.Unary(operator, operand, line):
                        return operator == TokenKind.Ampersand or rtr_type_contains_reference(operand)
                    Expr.Index(object, argument, line):
                        return rtr_type_contains_reference(argument)
                    Expr.IndexN(object, arguments, line):
                        return any argument in arguments where rtr_type_contains_reference(argument)
                    Expr.Paren(inner, line):
                        return rtr_type_contains_reference(inner)
                    _:
                        return false


        def rtr_type_has_reference_element(type_expression: Ast::Expr) -> bool:
            can Abort.Panic:
                match type_expression:
                    Expr.Unary(operator, operand, line):
                        if operator == TokenKind.Ampersand:
                            return rtr_type_contains_reference(operand)
                        return rtr_type_has_reference_element(operand) if operator == TokenKind.Mutable or operator == TokenKind.Question
                        return false
                    Expr.Index(object, argument, line):
                        return rtr_type_contains_reference(argument)
                    Expr.IndexN(object, arguments, line):
                        return any argument in arguments where rtr_type_contains_reference(argument)
                    Expr.Paren(inner, line):
                        return rtr_type_has_reference_element(inner)
                    _:
                        return false


        def rtr_expression_root(expression: Ast::Expr) -> sview:
            can Abort.Panic:
                match expression:
                    Expr.Ident(name, line):
                        return name
                    Expr.Field(object, field, line) | Expr.Index(object, index, line) | Expr.Slice(object, low, high, line):
                        return rtr_expression_root(object)
                    Expr.Unary(operator, operand, line) | Expr.Move(operand, line) | Expr.Paren(operand, line):
                        return rtr_expression_root(operand)
                    _:
                        return sview("", 0, 0)


        def rtr_param_has_reference_element(parameters: darray[Ast::ParamDecl]&, name: sview) -> bool:
            can Abort.Panic:
                for parameter in parameters:
                    return rtr_type_has_reference_element(parameter.type_expression) if parameter.name == name
                return false


        def rtr_mutator_stores_argument(method: sview, argument_index: usize, argument_count: usize) -> bool:
            can Abort.Panic:
                return when method:
                    "push" | "push_back" | "push_front" | "extend" | "append" | "append_many" | "add" -> argument_index == 0
                    "insert" | "set" -> argument_count > 0 and argument_index + 1 == argument_count
                    "put" | "get_or_insert" -> true
                    _ -> false


        def rtr_record_stored_borrow(target: sview, source: sview, targets: mutable darray[sview]&, sources: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                return if target == "" or source == ""
                for index in 0..<targets.count:
                    return if targets[index] == target and sources[index] == source
                targets.push(target)
                sources.push(source)


        def rtr_collect_stored_borrows_expr(expression: Ast::Expr, parameters: darray[Ast::ParamDecl]&, ref_params: darray[sview]&, targets: mutable darray[sview]&, sources: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, line):
                        match callee:
                            Expr.Field(receiver, method, field_line):
                                target: sview = rtr_expression_root(receiver)
                                if rtr_param_has_reference_element(parameters, target):
                                    for argument_index in 0..<arguments.count:
                                        continue if not rtr_mutator_stores_argument(method, argument_index, arguments.count)
                                        source: sview = rtr_return_root(arguments[argument_index], ref_params, true)
                                        rtr_record_stored_borrow(target, source, targets, sources)
                            _:
                                pass
                        rtr_collect_stored_borrows_expr(callee, parameters, ref_params, targets, sources)
                        for argument in arguments |targets, sources|:
                            rtr_collect_stored_borrows_expr(argument, parameters, ref_params, targets, sources)
                    Expr.StaticEffectCall(effect_type, operation, candidates, arguments, argument_names, line):
                        for argument in arguments |targets, sources|:
                            rtr_collect_stored_borrows_expr(argument, parameters, ref_params, targets, sources)
                    Expr.Unary(operator, operand, line) | Expr.Move(operand, line) | Expr.Paren(operand, line) | Expr.RegionNew(operand, region, line):
                        rtr_collect_stored_borrows_expr(operand, parameters, ref_params, targets, sources)
                    Expr.Binary(left, operator, right, line):
                        rtr_collect_stored_borrows_expr(left, parameters, ref_params, targets, sources)
                        rtr_collect_stored_borrows_expr(right, parameters, ref_params, targets, sources)
                    Expr.Field(object, field, line):
                        rtr_collect_stored_borrows_expr(object, parameters, ref_params, targets, sources)
                    Expr.Index(object, index, line):
                        rtr_collect_stored_borrows_expr(object, parameters, ref_params, targets, sources)
                        rtr_collect_stored_borrows_expr(index, parameters, ref_params, targets, sources)
                    Expr.Slice(object, low, high, line):
                        rtr_collect_stored_borrows_expr(object, parameters, ref_params, targets, sources)
                        rtr_collect_stored_borrows_expr(low, parameters, ref_params, targets, sources)
                        rtr_collect_stored_borrows_expr(high, parameters, ref_params, targets, sources)
                    Expr.IndexN(object, indices, line):
                        rtr_collect_stored_borrows_expr(object, parameters, ref_params, targets, sources)
                        for index in indices |targets, sources|:
                            rtr_collect_stored_borrows_expr(index, parameters, ref_params, targets, sources)
                    Expr.Array(elements, line) | Expr.Tuple(elements, line) | Expr.SetLit(elements, line):
                        for element in elements |targets, sources|:
                            rtr_collect_stored_borrows_expr(element, parameters, ref_params, targets, sources)
                    Expr.DictLit(entries, line):
                        for entry in entries |targets, sources|:
                            rtr_collect_stored_borrows_expr(entry.key, parameters, ref_params, targets, sources)
                            rtr_collect_stored_borrows_expr(entry.value, parameters, ref_params, targets, sources)
                    Expr.Construct(head, fields, line) | Expr.RecordUpdate(head, fields, line):
                        rtr_collect_stored_borrows_expr(head, parameters, ref_params, targets, sources)
                        for field in fields |targets, sources|:
                            rtr_collect_stored_borrows_expr(field.value, parameters, ref_params, targets, sources)
                    Expr.If(condition, then_value, else_value, line):
                        rtr_collect_stored_borrows_expr(condition, parameters, ref_params, targets, sources)
                        rtr_collect_stored_borrows_expr(then_value, parameters, ref_params, targets, sources)
                        rtr_collect_stored_borrows_expr(else_value, parameters, ref_params, targets, sources)
                    Expr.Match(scrutinee, arms, line) | Expr.Catch(scrutinee, arms, line):
                        rtr_collect_stored_borrows_expr(scrutinee, parameters, ref_params, targets, sources)
                        for arm in arms |targets, sources|:
                            rtr_collect_stored_borrows_expr(arm.guard, parameters, ref_params, targets, sources)
                            rtr_collect_stored_borrows_statements(arm.body, parameters, ref_params, targets, sources)
                    Expr.Block(block_statements, value, captures, line):
                        rtr_collect_stored_borrows_statements(block_statements, parameters, ref_params, targets, sources)
                        rtr_collect_stored_borrows_expr(value, parameters, ref_params, targets, sources)
                    Expr.Comprehension(variable, iterable, condition, body, line, _):
                        rtr_collect_stored_borrows_expr(iterable, parameters, ref_params, targets, sources)
                        rtr_collect_stored_borrows_expr(condition, parameters, ref_params, targets, sources)
                        rtr_collect_stored_borrows_expr(body, parameters, ref_params, targets, sources)
                    _:
                        pass


        def rtr_collect_stored_borrows_statements(statements: darray[Ast::Stmt], parameters: darray[Ast::ParamDecl]&, ref_params: darray[sview]&, targets: mutable darray[sview]&, sources: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |targets, sources|:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            rtr_collect_stored_borrows_expr(value, parameters, ref_params, targets, sources)
                        Stmt.Assign(target, operator, value, line):
                            rtr_collect_stored_borrows_expr(target, parameters, ref_params, targets, sources)
                            rtr_collect_stored_borrows_expr(value, parameters, ref_params, targets, sources)
                        Stmt.Expr(expression, line):
                            rtr_collect_stored_borrows_expr(expression, parameters, ref_params, targets, sources)
                        Stmt.Return(value, line):
                            if value is returned:
                                rtr_collect_stored_borrows_expr(returned, parameters, ref_params, targets, sources)
                        Stmt.If(condition, then_body, else_body, line):
                            rtr_collect_stored_borrows_expr(condition, parameters, ref_params, targets, sources)
                            rtr_collect_stored_borrows_statements(then_body, parameters, ref_params, targets, sources)
                            rtr_collect_stored_borrows_statements(else_body, parameters, ref_params, targets, sources)
                        Stmt.While(condition, body, line):
                            rtr_collect_stored_borrows_expr(condition, parameters, ref_params, targets, sources)
                            rtr_collect_stored_borrows_statements(body, parameters, ref_params, targets, sources)
                        Stmt.For(bind, variables, iterable, body, line):
                            rtr_collect_stored_borrows_expr(iterable, parameters, ref_params, targets, sources)
                            rtr_collect_stored_borrows_statements(body, parameters, ref_params, targets, sources)
                        Stmt.Block(kind, clause, binding, body, line):
                            rtr_collect_stored_borrows_statements(body, parameters, ref_params, targets, sources)
                        Stmt.Match(scrutinee, arms, line):
                            rtr_collect_stored_borrows_expr(scrutinee, parameters, ref_params, targets, sources)
                            for arm in arms |targets, sources|:
                                rtr_collect_stored_borrows_statements(arm.body, parameters, ref_params, targets, sources)
                        _:
                            pass


        # ---- stage0's inferred region for GROWN parameters ----------------------------
        # stage0 (inferRegionParamsForGrownContainerParamsIn) gives a by-ref, region-less
        # parameter the implicit region `__rg_<param>` once a growth method runs on a path
        # rooted at it (`p.f.push(x)`, `buf.push(x)`, `p.f <- p.f.push(x)`), outside an
        # explicit `in X:` store or user `region:` block. checkRegionParamReturnEscape then
        # rejects returning ANY borrow-like value rooted at it with a region-less return type
        # -- the param itself, a field, a slice, an `as_sview()`, or a local alias of those --
        # at the returned expression. The one exemption (inferReturnViewRegion) is a `view`
        # return of `param[a:b]` when exactly one parameter was inferred: stage0 stamps the
        # return type with that region itself.
        def rtr_is_growth_method(method: sview) -> bool:
            can Abort.Panic:
                return when method:
                    "push" | "extend" | "insert" | "resize" | "reserve" | "append" | "put" | "add" -> true
                    _ -> false


        # The root identifier of a borrow-like value: through field/index/slice hops, `&`,
        # parens, and receiver-view method calls (`x.as_sview()`, `x.view()`).
        def rtr_borrow_root(expression: Ast::Expr) -> sview:
            can Abort.Panic:
                match expression:
                    Expr.Ident(name, line):
                        return name
                    Expr.Field(object, field, line) | Expr.Index(object, index, line) | Expr.Slice(object, low, high, line):
                        return rtr_borrow_root(object)
                    Expr.Unary(operator, operand, line) | Expr.Paren(operand, line):
                        return rtr_borrow_root(operand)
                    Expr.Call(callee, arguments, argument_names, line):
                        match callee:
                            Expr.Field(receiver, method, field_line):
                                return rtr_borrow_root(receiver) if rtr_is_view_method(method) or method == "view"
                            _:
                                pass
                        return sview("", 0, 0)
                    _:
                        return sview("", 0, 0)


        def rtr_note_name(name: sview, names: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                return if name == "" or any existing in names where existing == name
                names.push(name)


        def rtr_grown_expr(expression: Ast::Expr, candidates: darray[sview]&, grown: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, line):
                        match callee:
                            Expr.Field(receiver, method, field_line):
                                if rtr_is_growth_method(method):
                                    root: sview = rtr_expression_root(receiver)
                                    rtr_note_name(root, grown) if any c in candidates where c == root
                            _:
                                pass
                        rtr_grown_expr(callee, candidates, grown)
                        for argument in arguments |grown|:
                            rtr_grown_expr(argument, candidates, grown)
                    Expr.Unary(operator, operand, line) | Expr.Move(operand, line) | Expr.Paren(operand, line):
                        rtr_grown_expr(operand, candidates, grown)
                    Expr.Binary(left, operator, right, line):
                        rtr_grown_expr(left, candidates, grown)
                        rtr_grown_expr(right, candidates, grown)
                    Expr.Field(object, field, line):
                        rtr_grown_expr(object, candidates, grown)
                    Expr.Index(object, index, line):
                        rtr_grown_expr(object, candidates, grown)
                        rtr_grown_expr(index, candidates, grown)
                    Expr.If(condition, then_value, else_value, line):
                        rtr_grown_expr(condition, candidates, grown)
                        rtr_grown_expr(then_value, candidates, grown)
                        rtr_grown_expr(else_value, candidates, grown)
                    Expr.Block(block_statements, value, captures, line):
                        rtr_grown_statements(block_statements, candidates, grown)
                        rtr_grown_expr(value, candidates, grown)
                    Expr.Match(scrutinee, arms, line) | Expr.Catch(scrutinee, arms, line):
                        rtr_grown_expr(scrutinee, candidates, grown)
                        for arm in arms |grown|:
                            rtr_grown_statements(arm.body, candidates, grown)
                    _:
                        pass


        def rtr_grown_statements(statements: darray[Ast::Stmt], candidates: darray[sview]&, grown: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |grown|:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            rtr_grown_expr(value, candidates, grown)
                        Stmt.Assign(target, operator, value, line):
                            rtr_grown_expr(value, candidates, grown)
                        Stmt.Expr(expression, line):
                            rtr_grown_expr(expression, candidates, grown)
                        Stmt.Return(value, line):
                            if value is returned:
                                rtr_grown_expr(returned, candidates, grown)
                        Stmt.If(condition, then_body, else_body, line):
                            rtr_grown_expr(condition, candidates, grown)
                            rtr_grown_statements(then_body, candidates, grown)
                            rtr_grown_statements(else_body, candidates, grown)
                        Stmt.While(condition, body, line):
                            rtr_grown_statements(body, candidates, grown)
                        Stmt.For(bind, variables, iterable, body, line):
                            rtr_grown_statements(body, candidates, grown)
                        Stmt.Block(kind, clause, binding, body, line):
                            # Growth into an explicit store region (`in X:`) or a user
                            # `region:` block does not infer the parameter's region.
                            rtr_grown_statements(body, candidates, grown) if kind != "in" and kind != "region"
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |grown|:
                                rtr_grown_statements(arm.body, candidates, grown)
                        _:
                            pass


        # Locals bound (unconditionally) to a borrow of a grown param: `v: sview =
        # table.text.as_sview()`. A conditional initializer is a different stage0 rule.
        # Records NAME as an alias of a grown param when VALUE borrows one (directly or through
        # an earlier alias). A conditional value (`p.name if c else "x"`) or an alias of a
        # conditional alias is also listed in `cond_aliases`.
        def rtr_note_alias(name: sview, value: Ast::Expr, grown: darray[sview]&, alias_names: mutable darray[sview]&, alias_roots: mutable darray[sview]&, cond_aliases: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                root: mutable sview = sview("", 0, 0)
                conditional: mutable bool = false
                match value:
                    Expr.If(condition, then_value, else_value, if_pos):
                        root <- rtr_grown_return_root(then_value, grown, alias_names, alias_roots)
                        root <- rtr_grown_return_root(else_value, grown, alias_names, alias_roots) if root == ""
                        conditional <- true
                    Expr.Paren(inner, paren_pos):
                        rtr_note_alias(name, inner, grown, alias_names, alias_roots, cond_aliases)
                        return
                    _:
                        root <- rtr_grown_return_root(value, grown, alias_names, alias_roots)
                        source: sview = rtr_borrow_root(value)
                        conditional <- any c in cond_aliases where c == source
                return if root == ""
                alias_names.push(name)
                alias_roots.push(root)
                cond_aliases.push(name) if conditional

        # stage0 tracks a `<-` reassignment only for a conditional value; a plain `v <- p.name`
        # leaves the binding untied.
        def rtr_is_conditional(value: Ast::Expr) -> bool:
            match value:
                Expr.If(condition, then_value, else_value, if_pos):
                    return true
                Expr.Paren(inner, paren_pos):
                    return rtr_is_conditional(inner)
                _:
                    return false

        def rtr_grown_aliases(statements: darray[Ast::Stmt], grown: darray[sview]&, alias_names: mutable darray[sview]&, alias_roots: mutable darray[sview]&, cond_aliases: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |alias_names, alias_roots, cond_aliases|:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            rtr_note_alias(name, value, grown, alias_names, alias_roots, cond_aliases)
                        Stmt.Assign(target, operator, value, line):
                            assigned: sview = ident_name_of(target)
                            rtr_note_alias(assigned, value, grown, alias_names, alias_roots, cond_aliases) if operator == TokenKind.LArrow and assigned != "" and rtr_is_conditional(value)
                        Stmt.If(condition, then_body, else_body, line):
                            rtr_grown_aliases(then_body, grown, alias_names, alias_roots, cond_aliases)
                            rtr_grown_aliases(else_body, grown, alias_names, alias_roots, cond_aliases)
                        Stmt.While(condition, body, line):
                            rtr_grown_aliases(body, grown, alias_names, alias_roots, cond_aliases)
                        Stmt.For(bind, variables, iterable, body, line):
                            rtr_grown_aliases(body, grown, alias_names, alias_roots, cond_aliases)
                        Stmt.Block(kind, clause, binding, body, line):
                            rtr_grown_aliases(body, grown, alias_names, alias_roots, cond_aliases)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |alias_names, alias_roots, cond_aliases|:
                                rtr_grown_aliases(arm.body, grown, alias_names, alias_roots, cond_aliases)
                        _:
                            pass


        # The grown param a returned value is tied to, or "".
        def rtr_grown_return_root(returned: Ast::Expr, grown: darray[sview]&, alias_names: darray[sview]&, alias_roots: darray[sview]&) -> sview:
            can Abort.Panic:
                root: sview = rtr_borrow_root(returned)
                return sview("", 0, 0) if root == ""
                return root if any g in grown where g == root
                for index in 0..<alias_names.count:
                    return alias_roots[index] if alias_names[index] == root
                return sview("", 0, 0)


        def rtr_is_view_slice_of(returned: Ast::Expr, root: sview) -> bool:
            can Abort.Panic:
                match returned:
                    Expr.Slice(object, low, high, line):
                        return ident_name_of(object) == root
                    Expr.Paren(inner, line):
                        return rtr_is_view_slice_of(inner, root)
                    _:
                        return false


        def rtr_type_is_view_family(type_expression: Ast::Expr) -> bool:
            can Abort.Panic:
                match type_expression:
                    Expr.Index(object, element, line):
                        return ident_name_of(object) == "view"
                    Expr.Paren(inner, line):
                        return rtr_type_is_view_family(inner)
                    _:
                        return false


        # Report a return tied to a grown param; true when it was handled here.
        def rtr_check_grown_return(returned: Ast::Expr, line: u32, grown: darray[sview]&, alias_names: darray[sview]&, alias_roots: darray[sview @source]&, cond_aliases: darray[sview]&, view_return: bool, table: lmut SymbolTable) -> bool:
            can Memory.Allocate, Abort.Panic:
                root: sview = rtr_grown_return_root(returned, grown, alias_names, alias_roots)
                return false if root == ""
                return true if view_return and grown.count == 1 and rtr_is_view_slice_of(returned, root)
                returned_name: sview = rtr_borrow_root(returned)
                if any c in cond_aliases where c == returned_name:
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ScopeOwnedRegionReturnEscape, name: root, pos: Ast::expr_pos(returned), line: line, expected: "", actual: ""})
                    return true
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.RegionParamInferenceFailure, name: root, pos: Ast::expr_pos(returned), line: line, expected: "", actual: ""})
                return true
