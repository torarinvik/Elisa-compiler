# Extern effect declarations and module lookup.
extend Semantic:
    private:
        def extern_effect_ref_at(annotations: darray[Ast::EnumAnnotation]&, module: sview, line: u32, offset: u32) -> sview:
            can Abort.Panic:
                while probe < annotations.count |probe: mutable usize = 0|:
                    return annotations[probe].name if annotations[probe].owner == "__extern_effect_ref" and annotations[probe].module == module and annotations[probe].line == line and annotations[probe].offset == offset
                    probe <- probe + 1
                return ""

        # The complete can-row slice is keyed by the extern's exact token position. An empty
        # slice with a complete marker means an explicitly pure `can[]` row; an absent or
        # incomplete pair leaves the legacy first-ref path below as a conservative fallback.
        def extern_effect_row_at(annotations: darray[Ast::EnumAnnotation]&, owner: sview, module: sview, line: u32, offset: u32) -> (complete: bool, text: sview):
            can Abort.Panic:
                complete_count: mutable usize = 0
                text_count: mutable usize = 0
                text: mutable sview = ""
                for annotation in annotations |complete_count, text_count, text, owner, line, offset|:
                    continue if annotation.module != module or annotation.line != line or annotation.offset != offset
                    if annotation.owner == owner and annotation.name == "__extern_effect_row_complete":
                        complete_count <- complete_count + 1
                    elif annotation.owner == "__extern_effect_row_text":
                        text <- annotation.name
                        text_count <- text_count + 1
                return (complete_count == 1 and text_count == 1, text)

        def extern_effect_index_declare(module: sview @source, owner: sview @source, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for row in 0..<min(table.extern_effect_modules.count, table.extern_effect_owners.count) |table, module, owner|:
                    return if table.extern_effect_modules[row] == module and table.extern_effect_owners[row] == owner
                table.extern_effect_modules <- table.extern_effect_modules.push(module)
                table.extern_effect_owners <- table.extern_effect_owners.push(owner)

        def extern_declaration_index_add(module: sview @source, owner: sview @source, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for row in 0..<min(table.extern_declaration_modules.count, min(table.extern_declaration_owners.count, table.extern_declaration_counts.count)) |table, module, owner|:
                    if table.extern_declaration_modules[row] == module and table.extern_declaration_owners[row] == owner:
                        table.extern_declaration_counts[row] <- table.extern_declaration_counts[row] + 1.usize()
                        return
                table.extern_declaration_modules <- table.extern_declaration_modules.push(module)
                table.extern_declaration_owners <- table.extern_declaration_owners.push(owner)
                table.extern_declaration_counts <- table.extern_declaration_counts.push(1.usize())

        def extern_effect_index_add_ref(module: sview @source, owner: sview @source, effect_ref: sview @source, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- extern_effect_index_declare(module, owner, table) can Global{Read,Write}
                return if effect_ref == ""
                for row in 0..<min(table.extern_effect_row_modules.count, table.extern_effect_row_names.count) |table, module, owner, effect_ref|:
                    return if table.extern_effect_row_modules[row] == module and table.extern_effect_row_owners[row] == owner and table.extern_effect_row_names[row] == effect_ref
                table.extern_effect_row_modules <- table.extern_effect_row_modules.push(module)
                table.extern_effect_row_owners <- table.extern_effect_row_owners.push(owner)
                table.extern_effect_row_names <- table.extern_effect_row_names.push(effect_ref)

        def extern_effect_index_has_declaration(module: sview, owner: sview, table: SymbolTable&) -> bool:
            can Abort.Panic:
                for row in 0..<min(table.extern_effect_modules.count, table.extern_effect_owners.count) |table, module, owner|:
                    return true if table.extern_effect_modules[row] == module and table.extern_effect_owners[row] == owner
                return false

        def extern_declaration_index_has(module: sview, owner: sview, table: SymbolTable&) -> bool:
            can Abort.Panic:
                for row in 0..<min(table.extern_declaration_modules.count, table.extern_declaration_owners.count) |table, module, owner|:
                    return true if table.extern_declaration_modules[row] == module and table.extern_declaration_owners[row] == owner
                return false

        def extern_regular_function_owner_is_unique(module: sview, owner: sview, table: SymbolTable&) -> bool:
            can Abort.Panic:
                count: mutable usize = 0
                if table.symbol_name_index_valid and table.symbol_name_indexed_rows == table.symbols.count and table.symbol_name_next.count == table.symbols.count:
                    cursor: mutable u32 = symbol_chain_head(table, owner)
                    while cursor != 4294967295 |cursor, count, module, owner, table|:
                        symbol: Symbol = table.symbols[cursor.usize()]
                        cursor <- table.symbol_name_next[cursor.usize()]
                        count <- count + 1.usize() if symbol.kind == SymbolKind.Func and symbol.name == owner and symbol.module_owner == module
                        return false if count > 1.usize()
                    return count == 1.usize()
                for symbol in table.symbols |count, module, owner|:
                    count <- count + 1.usize() if symbol.kind == SymbolKind.Func and symbol.name == owner and symbol.module_owner == module
                    return false if count > 1.usize()
                return count == 1.usize()

        # The scoped index is keyed by module and leaf, so it selects a declaration only
        # when exactly one callable function owns that key and that function is an extern.
        # Same-module extern overloads and mixed extern/regular declarations cannot be
        # distinguished by this projection and must fail closed at scoped call sites.
        def extern_module_owner_is_extern_only(module: sview, owner: sview, table: SymbolTable&) -> bool:
            can Abort.Panic:
                function_count: mutable usize = 0
                if table.symbol_name_index_valid and table.symbol_name_indexed_rows == table.symbols.count and table.symbol_name_next.count == table.symbols.count:
                    cursor: mutable u32 = symbol_chain_head(table, owner)
                    while cursor != 4294967295 |cursor, function_count, module, owner, table|:
                        symbol: Symbol = table.symbols[cursor.usize()]
                        cursor <- table.symbol_name_next[cursor.usize()]
                        function_count <- function_count + 1.usize() if symbol.kind == SymbolKind.Func and symbol.name == owner and symbol.module_owner == module
                else:
                    for symbol in table.symbols |function_count, module, owner|:
                        function_count <- function_count + 1.usize() if symbol.kind == SymbolKind.Func and symbol.name == owner and symbol.module_owner == module
                declaration_count: mutable usize = 0
                for row in 0..<min(table.extern_declaration_modules.count, min(table.extern_declaration_owners.count, table.extern_declaration_counts.count)) |declaration_count, module, owner, table|:
                    declaration_count <- table.extern_declaration_counts[row] if table.extern_declaration_modules[row] == module and table.extern_declaration_owners[row] == owner
                return function_count == 1.usize() and declaration_count == 1.usize()

        def extern_effect_index_refs(module: sview, owner: sview, table: SymbolTable&) -> darray[sview]:
            can Memory.Allocate, Abort.Panic:
                refs: mutable darray[sview] = []
                for row in 0..<min(table.extern_effect_row_modules.count, min(table.extern_effect_row_owners.count, table.extern_effect_row_names.count)) |refs, table, module, owner|:
                    if table.extern_effect_row_modules[row] == module and table.extern_effect_row_owners[row] == owner:
                        seen: mutable bool = false
                        for known in refs |seen, table|:
                            seen <- true if known == table.extern_effect_row_names[row]
                        refs.push(table.extern_effect_row_names[row]) if not seen
                return refs

        # Find the lexical module for a function from its exact symbol position. A line-zero
        # or same-name sibling must not select another declaration's module.
        def extern_join_module_scope(parent: sview @source, child: sview @source, table: lmut SymbolTable) -> sview @source:
            can Memory.Allocate, Abort.Panic:
                for cursor in 0..<child.len |parent, child, table|:
                    return child if cursor + 1.usize() < child.len and child[cursor] == 58 and child[cursor + 1.usize()] == 58
                if parent != "":
                    joined: mutable sview @source = ""
                    trusted Unsafe{PointerArithmetic,RawExtern}:
                        rebind joined, table = errorset_join_module_path(parent, child, table)
                    return joined
                return child

        def extern_module_path_exists(module_path: sview, table: SymbolTable&) -> bool:
            can Abort.Panic:
                return errorset_module_symbol_exists(module_path, table)

        # Resolve qualified module paths in source order: a concrete lexical candidate,
        # then an unambiguous alias registered before the call, then a concrete root path.
        # Unknown or ambiguous aliases fail closed instead of borrowing a same-leaf extern row.
        def extern_qualified_module(qualifier: sview @source, caller_module: sview @source, requester: Ast::EnumAnnotation, table: lmut SymbolTable) -> (resolved: bool, module: sview @source):
            can Memory.Allocate, Abort.Panic:
                return (false, "") if qualifier == ""
                module_scope: mutable sview = caller_module
                while module_scope != "" |module_scope, qualifier, caller_module, table|:
                    candidate: mutable sview @source = ""
                    trusted Unsafe{PointerArithmetic,RawExtern}:
                        rebind candidate, table = errorset_join_module_path(module_scope, qualifier, table)
                    return (true, candidate) if extern_module_path_exists(candidate, table)
                    module_scope <- errorset_module_parent(module_scope)
                alias_end: mutable usize = qualifier.len
                for cursor in 0..<qualifier.len |alias_end, qualifier|:
                    if cursor + 1.usize() < qualifier.len and qualifier[cursor] == 58 and qualifier[cursor + 1.usize()] == 58:
                        alias_end <- cursor
                        break
                    elif qualifier[cursor] == 46:
                        alias_end <- cursor
                        break
                alias_head: sview = qualifier[0:alias_end]
                alias_row: u32 = binding_module_alias_row_before(alias_head, requester, table)
                return (false, "") if alias_row == BINDING_MODULE_ALIAS_ROW_AMBIGUOUS
                if alias_row != SYMBOL_INDEX_ROW_NONE:
                    canonical: mutable sview @source = ""
                    trusted Unsafe{PointerArithmetic,RawExtern}:
                        rebind canonical, table = binding_resolve_module_alias_target(qualifier, requester, table)
                    return (true, canonical) if canonical != "" and extern_module_path_exists(canonical, table)
                    return (false, "")
                return (true, qualifier) if extern_module_path_exists(qualifier, table)
                return (false, "")

        def extern_call_target(expression: Ast::Expr, table: lmut SymbolTable) -> (name: sview @source, qualifier: sview @source):
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, call_line):
                        target: mutable (name: sview @source, module_path: sview @source) = ("", "")
                        trusted Unsafe{PointerArithmetic,RawExtern}:
                            rebind target, table = errorset_call_target(callee, table)
                        return (target.name, target.module_path)
                    _:
                        return ("", "")

        # Select a bare callee module only when the source's direct lexical/import bindings
        # identify one module. Import precedence uses the exact call position; a possible
        # import keeps this resolver closed because it could change the selected owner.
        def extern_bare_module_for_call(name: sview, caller_module: sview, requester: Ast::EnumAnnotation, table: SymbolTable&) -> (resolved: bool, module: sview):
            can Memory.Allocate, Abort.Panic:
                return (false, "") if name == ""
                call_offset_present: bool = requester.offset != 0 or requester.pos.end_offset > requester.pos.offset
                selected: mutable sview = ""
                best_rank: mutable usize = 0
                found: mutable bool = false
                ambiguous: mutable bool = false
                selected_direct: mutable bool = false
                # Walk NAME's symbol chain (ascending rows, the order a full scan visits) when
                # the index covers every symbol; otherwise scan all rows.
                indexed: bool = table.symbol_name_index_valid and table.symbol_name_indexed_rows == table.symbols.count and table.symbol_name_next.count == table.symbols.count
                cursor: mutable u32 = symbol_chain_head(table, name) if indexed else 0
                while (cursor != SYMBOL_INDEX_ROW_NONE if indexed else cursor.usize() < table.symbols.count) |cursor, indexed, selected, best_rank, found, ambiguous, selected_direct, name, caller_module, requester, call_offset_present, table|:
                    symbol: Symbol = table.symbols[cursor.usize()]
                    cursor <- table.symbol_name_next[cursor.usize()] if indexed else cursor + 1
                    continue if symbol.kind != SymbolKind.Func or symbol.name != name
                    candidate_module: sview = symbol.module_owner
                    direct: bool = errorset_module_is_lexical_ancestor(candidate_module, caller_module)
                    imported: (visible: bool, scope_length: usize) = errorset_import_scope(table.definite_import_annotations, candidate_module, name, caller_module, requester.line, requester.offset, call_offset_present) if not direct else (false, 0.usize())
                    continue if not direct and not imported.visible
                    rank: usize = candidate_module.len if direct else imported.scope_length
                    if not found or rank > best_rank or rank == best_rank and direct and not selected_direct:
                        selected <- candidate_module
                        best_rank <- rank
                        found <- true
                        ambiguous <- false
                        selected_direct <- direct
                    elif rank == best_rank and direct == selected_direct and selected != candidate_module:
                        ambiguous <- true
                return (false, "") if ambiguous
                cursor <- symbol_chain_head(table, name) if indexed else 0
                while (cursor != SYMBOL_INDEX_ROW_NONE if indexed else cursor.usize() < table.symbols.count) |cursor, indexed, selected, best_rank, found, selected_direct, name, caller_module, requester, call_offset_present, table|:
                    symbol: Symbol = table.symbols[cursor.usize()]
                    cursor <- table.symbol_name_next[cursor.usize()] if indexed else cursor + 1
                    continue if symbol.kind != SymbolKind.Func or symbol.name != name or symbol.module_owner == selected
                    candidate_module: sview = symbol.module_owner
                    direct: bool = errorset_module_is_lexical_ancestor(candidate_module, caller_module)
                    continue if direct
                    possible_import: (visible: bool, scope_length: usize) = errorset_import_scope(table.possible_import_annotations, candidate_module, name, caller_module, requester.line, requester.offset, call_offset_present)
                    continue if not possible_import.visible
                    possible_rank: usize = possible_import.scope_length
                    return (false, "") if not found or possible_rank > best_rank or (possible_rank == best_rank and not selected_direct)
                return (true, selected) if found
                return (false, "")

        def extern_effect_add_ref(module: sview @source, owner: sview @source, effect_ref: sview @source, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                return if effect_ref == ""
                while row < table.function_effect_owner.count |row: mutable usize = 0, module, owner, effect_ref, table|:
                    return if table.function_effect_owner[row] == owner and row < table.function_effect_module.count and table.function_effect_module[row] == module and table.function_effect_name[row] == effect_ref
                    row <- row + 1
                table.function_effect_owner <- table.function_effect_owner.push(owner)
                table.function_effect_name <- table.function_effect_name.push(effect_ref)
                table.function_effect_module <- table.function_effect_module.push(module)
                table <- index_effect_owner_rows(table) can Global{Read,Write}

        def extern_effect_add_declared_ref(module: sview @source, owner: sview @source, effect_ref: sview @source, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                return if effect_ref == ""
                table <- extern_effect_add_ref(module, owner, effect_ref, table) can Global{Read,Write}
                table <- extern_effect_index_add_ref(module, owner, effect_ref, table) can Global{Read,Write}
                via_ref: sview = effect_ref_via(effect_ref)
                table <- extern_effect_add_ref(module, owner, via_ref, table) can Global{Read,Write} if via_ref != ""
                table <- extern_effect_index_add_ref(module, owner, via_ref, table) can Global{Read,Write} if via_ref != ""

        # Split only top-level commas so permission arguments such as Effect[A, B] and
        # grouped refs retain their own punctuation. The source slice is backed by the parser.
        def collect_extern_effect_row(module: sview @source, owner: sview @source, row: sview @source, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                start: mutable usize = 0
                depth: mutable int = 0
                for index in 0..<row.len |start, depth, owner, row, table|:
                    byte: u8 = row[index]
                    if depth == 0 and byte == 44:
                        effect_ref: sview = effect_ref_trim_layout(row[start:index])
                        table <- extern_effect_add_declared_ref(module, owner, effect_ref, table) can Global{Read,Write}
                        start <- index + 1.usize()
                    depth <- depth + 1 if byte == 91 or byte == 40 or byte == 123
                    depth <- depth - 1 if depth > 0 and (byte == 93 or byte == 41 or byte == 125)
                final_ref: sview = effect_ref_trim_layout(row[start:row.len])
                table <- extern_effect_add_declared_ref(module, owner, final_ref, table) can Global{Read,Write}

        def collect_extern_effects(annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table.extern_effect_modules <- table.extern_effect_modules.clear()
                table.extern_effect_owners <- table.extern_effect_owners.clear()
                table.extern_effect_row_modules <- table.extern_effect_row_modules.clear()
                table.extern_effect_row_owners <- table.extern_effect_row_owners.clear()
                table.extern_effect_row_names <- table.extern_effect_row_names.clear()
                table.extern_declaration_modules <- table.extern_declaration_modules.clear()
                table.extern_declaration_owners <- table.extern_declaration_owners.clear()
                table.extern_declaration_counts <- table.extern_declaration_counts.clear()
                while annotation_index < annotations.count |annotation_index: mutable usize = 0|:
                    annotation: Ast::EnumAnnotation = annotations[annotation_index]
                    if annotation.name == "__extern_decl":
                        table <- extern_declaration_index_add(annotation.module, annotation.owner, table) can Global{Read,Write}
                    elif annotation.name == "__extern_effect_blocking":
                        table <- extern_effect_index_declare(annotation.module, annotation.owner, table) can Global{Read,Write}
                        table <- extern_effect_add_ref(annotation.module, annotation.owner, "Blocking.RawExtern", table) can Global{Read,Write}
                        table <- extern_effect_index_add_ref(annotation.module, annotation.owner, "Blocking.RawExtern", table) can Global{Read,Write}
                    elif annotation.name == "__extern_effect":
                        table <- extern_effect_index_declare(annotation.module, annotation.owner, table) can Global{Read,Write}
                        complete_row: (complete: bool, text: sview) = extern_effect_row_at(annotations, annotation.owner, annotation.module, annotation.line, annotation.offset)
                        if complete_row.complete:
                            table <- collect_extern_effect_row(annotation.module, annotation.owner, complete_row.text, table) can Global{Read,Write}
                        else:
                            first_ref: sview = extern_effect_ref_at(annotations, annotation.module, annotation.line, annotation.offset)
                            table <- extern_effect_add_declared_ref(annotation.module, annotation.owner, first_ref if first_ref != "" else "Permission", table) can Global{Read,Write}
                    annotation_index <- annotation_index + 1
