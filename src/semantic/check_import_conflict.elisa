# A selectively-imported name (`from Mod import x`) may come from only ONE module: importing
# the same name from two different modules (`from A import thing` then `from B import thing`)
# is a conflict — the unqualified `thing` would be ambiguous. The parser records a
# `__from_member` marker (name=member) plus a position-paired `__from_src` marker (name=module)
# per brought-in member. Flag the LATER member whose module differs from an earlier import of
# the same name (matching stage0, which reports the second `from` line).
extend Semantic:
    private:
        # Branch rows in one static-if chain share a depth and the nearest preceding
        # ChainHead. Return the sentinel when the row metadata cannot prove that identity.
        def ic_static_if_chain_head(file: Ast::File&, branch_row: u32) -> u32:
            can Abort.Panic:
                selected: usize = branch_row.usize()
                return 4294967295 if selected >= file.static_if_kinds.count or selected >= file.static_if_depths.count or selected >= file.static_if_lines.count
                branch_depth: u32 = file.static_if_depths[selected]
                row: mutable usize = selected + 1.usize()
                while row > 0 |row, branch_depth, file|:
                    row <- row - 1.usize()
                    continue if row >= file.static_if_depths.count or file.static_if_depths[row] != branch_depth
                    if file.static_if_kinds[row] == StaticIfBranch::Kind.ChainHead:
                        return row.u32()
                return 4294967295

        # An unresolved pair conflicts only when both imports occupy distinct arms of the
        # same chain. Imports from an unconditional row or another chain remain competing
        # candidates and must still produce a conflict.
        def ic_unknown_import_rows_are_siblings(file: Ast::File&, annotations: darray[Ast::EnumAnnotation]&, left: Ast::EnumAnnotation, right: Ast::EnumAnnotation) -> bool:
            can Memory.Allocate, Abort.Panic:
                return false if left.owner != "__from_member" or right.owner != "__from_member" or left.name != right.name
                return false if not pma_import_row_branch_uncertain(annotations, "__from_member", left.name, left.module, left.line, left.offset)
                return false if not pma_import_row_branch_uncertain(annotations, "__from_member", right.name, right.module, right.line, right.offset)
                left_branch_rows: mutable darray[u32] = []
                left_chain_rows: mutable darray[u32] = []
                for left_marker in annotations |left_branch_rows, left_chain_rows, file, left|:
                    continue if left_marker.owner != "__static_if_branch" or left_marker.name != "__from_member_static_branch" or left_marker.detail_name != left.name or left_marker.module != left.module or left_marker.line != left.line or left_marker.offset != left.offset or left_marker.identity_id == 4294967295
                    left_chain: u32 = ic_static_if_chain_head(file, left_marker.identity_id)
                    if left_chain != 4294967295:
                        left_branch_rows <- left_branch_rows.push(left_marker.identity_id)
                        left_chain_rows <- left_chain_rows.push(left_chain)
                for right_marker in annotations |left_branch_rows, left_chain_rows, file, right|:
                    continue if right_marker.owner != "__static_if_branch" or right_marker.name != "__from_member_static_branch" or right_marker.detail_name != right.name or right_marker.module != right.module or right_marker.line != right.line or right_marker.offset != right.offset or right_marker.identity_id == 4294967295
                    right_chain: u32 = ic_static_if_chain_head(file, right_marker.identity_id)
                    continue if right_chain == 4294967295
                    for branch_index in 0..<left_branch_rows.count |left_branch_rows, left_chain_rows, right_marker, right_chain|:
                        return true if left_branch_rows[branch_index] != right_marker.identity_id and left_chain_rows[branch_index] == right_chain
                return false

        # The source module recorded for this exact imported member ("" if none).
        def from_import_source_of_position(annotations: darray[Ast::EnumAnnotation]&, module: sview @source, line: u32, offset: u32) -> sview @source:
            can Abort.Panic:
                for annotation in annotations:
                    return annotation.name if annotation.owner == "__from_src" and annotation.module == module and annotation.line == line and annotation.offset == offset
                return sview("", 0, 0)


        # The binding import view stores each alias target after resolving its spelling
        # from the declaration scope. Keep the conflict check on this canonical identity
        # so `Nested as Shared` and `Parent::Nested as Shared` count as the same target.
        def ic_module_alias_canonical_target(alias: Ast::EnumAnnotation, table: SymbolTable&) -> (known: bool, target: sview @source):
            can Abort.Panic:
                pair: (known: bool, target: sview) = semantic_import_alias_pair_target(alias, table)
                return (false, "") if not pair.known
                canonical: mutable sview @source = ""
                count: mutable usize = 0
                for annotation in table.binding_import_annotations |canonical, count, alias|:
                    if annotation.name == "__using_alias_target" and annotation.module == alias.module and annotation.line == alias.line and annotation.offset == alias.offset:
                        canonical <- annotation.owner
                        count <- count + 1.usize()
                return (count == 1.usize() and canonical != "", canonical)


        # Resolve conflicts only when one definite alias is known to be the global
        # registration winner and the later definite row has a different canonical
        # target. Possible/inactive static branches and unordered registrations remain
        # conservative, while same-target repetitions stay idempotent.
        def check_module_alias_conflicts(table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for winner in table.definite_import_annotations |table|:
                    continue if winner.name != "__using_alias" or not semantic_import_alias_is_global_winner(winner, table)
                    winner_target: (known: bool, target: sview @source) = ic_module_alias_canonical_target(winner, table)
                    continue if not winner_target.known
                    for current_alias in table.definite_import_annotations |table, winner, winner_target|:
                        continue if current_alias.name != "__using_alias" or current_alias.owner != winner.owner
                        continue if current_alias.module == winner.module and current_alias.line == winner.line and current_alias.offset == winner.offset
                        registration: (known: bool, precedes: bool) = semantic_possible_import_alias_precedes(winner, current_alias, table)
                        continue if not registration.known or not registration.precedes
                        current_target: (known: bool, target: sview @source) = ic_module_alias_canonical_target(current_alias, table)
                        continue if not current_target.known or current_target.target == winner_target.target
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ConflictingModuleAlias, name: current_alias.owner, line: current_alias.line, pos: current_alias.pos, expected: winner_target.target, actual: current_target.target})

    public:
        def check_import_conflict(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- check_module_alias_conflicts(table)
                annotations: darray[Ast::EnumAnnotation] = pma_active_import_annotations(file, table)
                index: mutable usize = 0
                while index < annotations.count |index, table| -> table:
                    current: Ast::EnumAnnotation = annotations[index]
                    if current.owner == "__from_member":
                        current_module: sview @source = from_import_source_of_position(annotations, current.module, current.line, current.offset)
                        earlier_module: mutable sview @source = ""
                        earlier: mutable usize = 0
                        while earlier < index |earlier_module, earlier|:
                            other: Ast::EnumAnnotation = annotations[earlier]
                            if other.owner == "__from_member" and other.name == current.name and earlier_module == "" and not ic_unknown_import_rows_are_siblings(file, annotations, other, current):
                                other_module: sview = from_import_source_of_position(annotations, other.module, other.line, other.offset)
                                earlier_module <- other_module if other_module != "" and current_module != "" and other_module != current_module
                            earlier <- earlier + 1
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ConflictingImport, name: current.name, line: current.line, expected: earlier_module, actual: current_module, expected_count: 1}) if earlier_module != ""
                    index <- index + 1
