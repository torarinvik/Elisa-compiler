# Duplicate decorator check: detects when a function declares the same decorator
# more than once (e.g. `@hot` appearing twice in `@hot @hot fn f(): ...`).
# Flags the SECOND and subsequent duplicates of each decorator name.

extend Semantic:
    private:
        # Entry point: check all function declarations for duplicate decorators.
        # Recurse into Module and Scoped declarations to check nested functions.
        def check_duplicate_decorator(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table|:
                    match declaration:
                        Decl.Func(name, parameters, return_type, body, effects, decorators, line):
                            # Track which decorator names we've seen for this function.
                            # Use a darray to store seen decorator names so we can check membership.
                            seen: mutable darray[sview] = []
                            for decorator in decorators |table|:
                                # Check if we've already seen this decorator name.
                                already_seen: mutable bool = false
                                for seen_decorator in seen:
                                    if seen_decorator == decorator.name:
                                        already_seen <- true
                                        break

                                # This is a duplicate; flag it with the same line as the function.
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.DuplicateDecorator, name: decorator.name, line: line, expected: "", actual: ""}) if already_seen
                                # First time seeing this decorator; add it to our seen list.
                                seen <- seen.push(decorator.name) if not already_seen
                        Decl.Module(name, body, line):
                            table <- check_duplicate_decorator(body, table)
                        Decl.Scoped(body, line):
                            table <- check_duplicate_decorator(body, table)
                        _:
                            pass
