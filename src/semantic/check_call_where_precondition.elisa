# A call `f(arg)` to a function whose parameter carries a `where` precondition (`x: i64 where
# x > 0`), where `arg` cannot establish it, is unproven under the non-SMT prover — stage0 warns
# "where precondition of f could not be proven". Conservative sound subset: fire only when `arg`
# is a POISONED variable (reassigned after its facts — including a conditional reassignment, which
# over-approximates like stage0) or a call/field/arithmetic expression (never a compile-time
# constant). A plain unrefined identifier is NOT flagged (a guard may discharge it). Region-safe:
# cross-function (name,position) registry in sview/u32 arrays, flat Decl walk, poisoned threaded.
extend Semantic:
    private:
        def cwp_param_where_refined(parameter: Ast::ParamDecl) -> bool:
            can Memory.Allocate, Abort.Panic:
                return match where_predicate_of_type(parameter.type_expression):
                    Expr.Absent: false
                    _: true

        def cwp_collect_refined(declarations: darray[Ast::Decl], func_out: mutable darray[sview]&, pos_out: mutable darray[u32]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |func_out, pos_out|:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, func_line):
                            position: mutable u32 = 0
                            for parameter in parameters |func_out, pos_out, position, function_name|:
                                if cwp_param_where_refined(parameter):
                                    func_out.push(function_name)
                                    pos_out.push(position)
                                position <- position + 1
                        Decl.Module(module_name, module_body, module_line):
                            cwp_collect_refined(module_body, func_out, pos_out)
                        Decl.Scoped(scoped_body, scoped_line):
                            cwp_collect_refined(scoped_body, func_out, pos_out)
                        _:
                            pass

        def cwp_position_refined(fname: sview, position: u32, func_names: darray[sview]&, positions: darray[u32]&) -> bool:
            can Abort.Panic:
                index: mutable usize = 0
                while index < func_names.count |index, fname, position, func_names, positions|:
                    true return if func_names[index] == fname and positions[index] == position
                    index <- index + 1
                return false

        def cwp_arg_unprovable(argument: Ast::Expr, poisoned: darray[sview]&) -> bool:
            can Abort.Panic:
                match argument:
                    Expr.Ident(name, ident_line):
                        return any p in poisoned where p == name
                    Expr.Call(callee, arguments, argument_names, call_line):
                        return true
                    Expr.Field(object, field, field_line):
                        return true
                    Expr.Binary(left, operator, right, binary_line):
                        return true
                    Expr.Unary(operator, operand, unary_line):
                        return true
                    _:
                        return false

        def cwp_check_expr(expression: Ast::Expr, func_names: darray[sview]&, positions: darray[u32]&, poisoned: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, call_line):
                        fname: sview = ident_name_of(callee)
                        arg_index: mutable u32 = 0
                        for argument in arguments |arg_index, table| -> table:
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.PreconditionUnproven, name: fname, line: call_line, expected: "", actual: ""}) if fname != "" and cwp_position_refined(fname, arg_index, func_names, positions) and cwp_arg_unprovable(argument, poisoned)
                            table <- cwp_check_expr(argument, func_names, positions, poisoned, table)
                            arg_index <- arg_index + 1
                    Expr.Binary(left, operator, right, binary_line):
                        table <- cwp_check_expr(left, func_names, positions, poisoned, table)
                        table <- cwp_check_expr(right, func_names, positions, poisoned, table)
                    Expr.Paren(inner, paren_line):
                        table <- cwp_check_expr(inner, func_names, positions, poisoned, table)
                    _:
                        pass

        def cwp_walk_stmts(statements: darray[Ast::Stmt], func_names: darray[sview]&, positions: darray[u32]&, poisoned: mutable darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |poisoned, table| -> table:
                    match statement:
                        Stmt.Assign(target, operator, value, assign_line):
                            table <- cwp_check_expr(value, func_names, positions, poisoned, table)
                            reassigned: sview = ident_name_of(target)
                            poisoned.push(reassigned) if operator == TokenKind.LArrow and reassigned != "" and not (any p in poisoned where p == reassigned)
                        Stmt.Expr(expression, expr_line):
                            table <- cwp_check_expr(expression, func_names, positions, poisoned, table)
                        Stmt.VarDecl(name, type_expression, value, decl_line):
                            table <- cwp_check_expr(value, func_names, positions, poisoned, table)
                        Stmt.Return(value, return_line):
                            if value is returned_value:
                                table <- cwp_check_expr(returned_value, func_names, positions, poisoned, table)
                        Stmt.If(condition, then_body, else_body, if_line):
                            table <- cwp_walk_stmts(then_body, func_names, positions, poisoned, table)
                            table <- cwp_walk_stmts(else_body, func_names, positions, poisoned, table)
                        Stmt.While(while_condition, while_body, while_line):
                            table <- cwp_walk_stmts(while_body, func_names, positions, poisoned, table)
                        Stmt.For(bind, variables, iterable, for_body, for_line):
                            table <- cwp_walk_stmts(for_body, func_names, positions, poisoned, table)
                        Stmt.Block(kind, clause, binding, block_body, block_line):
                            table <- cwp_walk_stmts(block_body, func_names, positions, poisoned, table)
                        _:
                            pass

        def cwp_walk_decls(declarations: darray[Ast::Decl], func_names: darray[sview]&, positions: darray[u32]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, func_line):
                            poisoned: mutable darray[sview] = []
                            table <- cwp_walk_stmts(body, func_names, positions, poisoned, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- cwp_walk_decls(module_body, func_names, positions, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- cwp_walk_decls(scoped_body, func_names, positions, table)
                        _:
                            pass

        def check_call_where_precondition(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                func_names: mutable darray[sview] = []
                positions: mutable darray[u32] = []
                cwp_collect_refined(declarations, func_names, positions)
                return if func_names.count == 0
                table <- cwp_walk_decls(declarations, func_names, positions, table)
