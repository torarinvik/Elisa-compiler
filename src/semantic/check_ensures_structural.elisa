# Structural validation of `ensures EXPR is LAW[args]` signature contracts (independent of the
# prover): the subject EXPR must name a declared parameter (or `result`), and when the law is an
# in-file `law` its argument count must match the law's value-parameter count. Both are decidable
# from the parsed AST — no proving. Only in-file laws are arity-checked (a stdlib law's arity is
# not recoverable here, so it is a sound skip).
extend Semantic:
    private:
        def ens_return_bool_annotation(annotation: Ast::EnumAnnotation&) -> bool:
            can Abort.Panic:
                return annotation.name == "__ensures_return_bool"

        # Distinct free value-parameter names of a law predicate: its free identifiers minus
        # `self`, in first-appearance order (mirrors qr_free_value_params).
        def ens_law_value_params(predicate: Ast::Expr, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match predicate:
                    Expr.Ident(name, line):
                        return if name == "self"
                        already: mutable bool = false
                        probe: mutable usize = 0
                        while probe < out.count |probe, already, name, out|:
                            already <- true if out[probe] == name
                            probe <- probe + 1
                        out.push(name) if not already
                    Expr.Binary(left, operator, right, binary_line):
                        ens_law_value_params(left, out)
                        ens_law_value_params(right, out)
                    Expr.Unary(operator, operand, unary_line):
                        ens_law_value_params(operand, out)
                    Expr.Paren(inner, paren_line):
                        ens_law_value_params(inner, out)
                    _:
                        pass

        # The argument count a refinement application supplies: `Law[a, b]` -> 2, `Law[a]` -> 1,
        # bare `Law` -> -1 (no bracket; not arity-checked).
        # A single RANGE argument `[lo..=hi]` supplies TWO values (lo and hi) to a two-bound
        # law like Bounded/InRange — stage0 accepts `Bounded[0..=500]` for `(self, lo, hi)`.
        def ens_arg_is_range(argument: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                match argument:
                    Expr.Binary(left, operator, right, line):
                        return is_range_operator(operator)
                    Expr.Paren(inner, line):
                        return ens_arg_is_range(inner)
                    _:
                        return false

        def ens_applied_arg_count(application: Ast::Expr) -> i64:
            can Memory.Allocate, Abort.Panic:
                match application:
                    Expr.IndexN(object, arguments, line):
                        return 2 if arguments.count == 1 and ens_arg_is_range(arguments[0]) else arguments.count.i64()
                    Expr.Index(object, index, line):
                        return 2 if ens_arg_is_range(index) else 1
                    Expr.Paren(inner, line):
                        return ens_applied_arg_count(inner)
                    _:
                        return 0 - 1

        # The in-file law's value-parameter count, or -1 if `name` is not an in-file law.
        def ens_law_arity(name: sview, law_names: darray[sview]&, law_predicates: darray[Ast::Expr]&) -> i64:
            can Memory.Allocate, Abort.Panic:
                index: mutable usize = 0
                while index < law_names.count |index, name, law_names, law_predicates|:
                    if law_names[index] == name:
                        params: mutable darray[sview] = []
                        ens_law_value_params(law_predicates[index], params)
                        return params.count.i64()
                    index <- index + 1
                return 0 - 1

        # Whether `subject` names a parameter of the function declared at `func_line`.
        def ens_subject_is_param(declarations: darray[Ast::Decl], func_line: u32, subject: sview) -> bool:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations:
                    match declaration:
                        Decl.Func(name, parameters, return_type, body, effects, decorators, line):
                            any parameter in parameters where parameter.name == subject return if line.line == func_line
                        Decl.Module(module_name, module_body, module_line):
                            true return if ens_subject_is_param(module_body, func_line, subject)
                        Decl.Scoped(scoped_body, scoped_line):
                            true return if ens_subject_is_param(scoped_body, func_line, subject)
                        _:
                            pass
                return false

        # The name of the function declared at `func_line` (for the diagnostic).
        def ens_func_name_at(declarations: darray[Ast::Decl], func_line: u32) -> sview:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations:
                    match declaration:
                        Decl.Func(name, parameters, return_type, body, effects, decorators, line):
                            name return if line.line == func_line
                        Decl.Module(module_name, module_body, module_line):
                            found: sview = ens_func_name_at(module_body, func_line)
                            found return if found != ""
                        Decl.Scoped(scoped_body, scoped_line):
                            found2: sview = ens_func_name_at(scoped_body, func_line)
                            found2 return if found2 != ""
                        _:
                            pass
                return sview("", 0, 0)

        # A `ensures return true => …` conditional (marked `__ensures_return_bool` by the parser)
        # predicates on the boolean return value, so the function must return `bool`.
        def ens_check_return_bool(declarations: darray[Ast::Decl], annotations: darray[Ast::EnumAnnotation], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(name, parameters, return_type, body, effects, decorators, line):
                            marked: bool = any annotation in annotations where annotation.name == "__ensures_return_bool" and annotation.owner == name and annotation.line == line.line
                            if marked:
                                return_name: mutable sview = "void"
                                if return_type is present_return_type:
                                    return_name <- else_void_type_name(present_return_type)
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.EnsuresReturnNeedsBool, name: name, line: line.line, expected: return_name, actual: ""}) if return_name != "bool"
                        Decl.Module(module_name, module_body, module_line):
                            table <- ens_check_return_bool(module_body, annotations, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- ens_check_return_bool(scoped_body, annotations, table)
                        _:
                            pass

        # A refstate consume `ensures X => !` on a non-ref param X (parser marks it
        # `__ensures_nonref` at 3900000076, owner=function, name=param).
        #
        # The annotation's `line` is that SENTINEL, not a source position, and this check
        # used to hand it straight to the Diagnostic: every one of these printed
        # `file.elisa:3900000075:` where stage0 prints `4:39-42`. The real line now travels
        # in `detail_line`. stage0 also names the offending type (`, got Job`), which the
        # renderer appends whenever the parameter's type resolves to a bare name here.
        def ens_check_ref_target(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for annotation in file.enum_annotations |table| -> table:
                    if annotation.line == 3900000076:
                        consumed_type: mutable Ast::Expr = (Ast::Expr.Invalid)
                        resolved_consumed: bool = ens_param_type_at(file.top_decls, annotation.detail_line, annotation.name, consumed_type)
                        consumed_name: sview = else_void_type_name(consumed_type) if resolved_consumed else sview("", 0, 0)
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.EnsuresRefTarget, name: annotation.name, pos: annotation.pos, line: annotation.detail_line, expected: annotation.owner, actual: consumed_name})

        # Every struct this file declares, and whether it carries named states. A `typestate
        # X:` declaration lowers to a Decl.Struct with has_named_states set, so both
        # spellings land here.
        def ens_struct_state_flags(declarations: darray[Ast::Decl], names: mutable darray[sview]&, stateful: mutable darray[bool]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |names, stateful|:
                    match declaration:
                        Decl.Struct(struct_name, members, affinity, has_named_states, has_derive, invariants, struct_line):
                            names.push(struct_name)
                            stateful.push(has_named_states)
                        Decl.Module(module_name, module_body, module_line):
                            ens_struct_state_flags(module_body, names, stateful)
                        Decl.Scoped(scoped_body, scoped_line):
                            ens_struct_state_flags(scoped_body, names, stateful)
                        _:
                            pass

        # The declared type of `parameter_name` on the function declared at `func_line`,
        # into `out_type`. False when this file declares no such function or parameter.
        def ens_param_type_at(declarations: darray[Ast::Decl], func_line: u32, parameter_name: sview, out_type: mutable Ast::Expr&) -> bool:
            can Memory.Allocate, Abort.Panic:
                resolved: mutable bool = false
                for declaration in declarations |resolved, out_type|:
                    match declaration:
                        Decl.Func(name, parameters, return_type, body, effects, decorators, line):
                            if line.line == func_line and not resolved:
                                for parameter in parameters |resolved, out_type|:
                                    if parameter.name == parameter_name and not resolved:
                                        out_type <- parameter.type_expression
                                        resolved <- true
                        Decl.Module(module_name, module_body, module_line):
                            resolved <- ens_param_type_at(module_body, func_line, parameter_name, out_type) if not resolved
                        Decl.Scoped(scoped_body, scoped_line):
                            resolved <- ens_param_type_at(scoped_body, func_line, parameter_name, out_type) if not resolved
                        _:
                            pass
                return resolved

        # stage0 (analyzer_func_types.go) requires an `ensures <param> => <State>`
        # postcondition to resolve to a NAMED-STATE-BEARING target. stage1 recorded the
        # postcondition -- the typestate flow checks already read it -- but never checked the
        # target's type, so `def finish(job: mutable ParseJob&) -> bool ensures job => Ready`
        # was accepted silently for a plain struct.
        #
        # SOUND SUBSET: fire only when the target parameter's type reduces to a bare name that
        # IS a struct declared in this file, and that struct carries no named states. A type
        # declared in another file is invisible to a single-file check (treating an unknown
        # capitalized name as an error measured 5556 false positives the one time it was
        # tried), and an alias, a generic parameter or a bracketed `T[State]` never reduces to
        # a plain declared struct name -- all of those stay silent rather than guess.
        def ens_check_state_target(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                struct_names: mutable darray[sview] = []
                struct_stateful: mutable darray[bool] = []
                ens_struct_state_flags(file.top_decls, struct_names, struct_stateful)
                return if struct_names.count == 0
                for postcondition in file.typestate_postconditions |table| -> table:
                    target_type: mutable Ast::Expr = (Ast::Expr.Invalid)
                    resolved: bool = ens_param_type_at(file.top_decls, postcondition.line, postcondition.parameter_name, target_type)
                    base: sview = else_void_type_name(target_type) if resolved else sview("", 0, 0)
                    declared: mutable bool = false
                    bears_states: mutable bool = false
                    for index in 0..<struct_names.count |declared, bears_states|:
                        if struct_names[index] == base and not declared and base != "":
                            declared <- true
                            bears_states <- struct_stateful[index]
                    if declared and not bears_states:
                        function_name: sview = ens_func_name_at(file.top_decls, postcondition.line)
                        mutable_marker: u32 = 1 if type_marker_present_here(target_type, TokenKind.Mutable) else 0
                        ref_marker: u32 = 1 if type_marker_present_here(target_type, TokenKind.Ampersand) else 0
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.EnsuresStateTarget, name: postcondition.parameter_name, pos: postcondition.target_pos, line: postcondition.line, expected: function_name, actual: base, expected_count: mutable_marker, actual_count: ref_marker})

        # `ensures <name> => <state>` naming something that is not a parameter (tag
        # 3900000096, owner=function, name=the unresolved target). stage0 reports this from
        # analyzer_func_types.go before it ever looks at the target's type; the kind and its
        # sentence already existed here for the `<subject> is <Law>` contract form.
        def ens_check_unknown_state_target(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for annotation in file.enum_annotations |table| -> table:
                    if annotation.line == 3900000096:
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.EnsuresUnknownParam, name: annotation.name, pos: annotation.pos, line: annotation.detail_line, expected: annotation.owner, actual: ""})

        def check_ensures_structural(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- ens_check_unknown_state_target(file, table)
                table <- ens_check_state_target(file, table)
                table <- ens_check_ref_target(file, table)
                return_bool_annotations: mutable darray[Ast::EnumAnnotation] = []
                for annotation in file.enum_annotations |return_bool_annotations|:
                    return_bool_annotations.push(annotation) if ens_return_bool_annotation(annotation)
                table <- ens_check_return_bool(file.top_decls, return_bool_annotations, table)
                law_names: mutable darray[sview] = []
                law_predicates: mutable darray[Ast::Expr] = []
                collect_laws(file.top_decls, law_names, law_predicates)
                index: mutable usize = 0
                while index < file.signature_contract_exprs.count |index, table| -> table:
                    kind: sview = file.signature_contract_kinds[index]
                    contract_line: u32 = file.signature_contract_lines[index]
                    if kind == "ensure" or kind == "ensures":
                        match file.signature_contract_exprs[index]:
                            Expr.Binary(base, operator, right, _):
                                if operator == TokenKind.Is:
                                    subject: sview = ident_name_of(base)
                                    law_name: sview = refinement_predicate_name(right)
                                    # Unknown-subject: a bare ident subject must be a parameter or `result`.
                                    if subject != "" and subject != "result" and subject != "self" and not ens_subject_is_param(file.top_decls, contract_line, subject):
                                        func_name: sview = ens_func_name_at(file.top_decls, contract_line)
                                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.EnsuresUnknownParam, name: subject, line: contract_line, expected: func_name, actual: ""})
                                    # Arg-count: only when the law is in-file and the application brackets args.
                                    arity: i64 = ens_law_arity(law_name, law_names, law_predicates)
                                    provided: i64 = ens_applied_arg_count(right)
                                    if arity >= 0 and provided >= 0 and provided != arity:
                                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.EnsuresArgCount, name: law_name, line: contract_line, expected: "", actual: "", expected_count: arity.u32(), actual_count: provided.u32()})
                            _:
                                pass
                    index <- index + 1
