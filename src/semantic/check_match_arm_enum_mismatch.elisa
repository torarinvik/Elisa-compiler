# Check for a `match` arm whose variant pattern names a DIFFERENT registered enum than
# the scrutinee's known enum type — parity with stage0's `match arm expects enum "E", got "G"`.
# SOUND SUBSET: fires only when the scrutinee is a plain identifier whose local type is a
# registered enum AND the arm pattern's path is qualified with a DIFFERENT registered enum.
# A bare/unqualified variant path, a qualifier that isn't a known enum, or a matching enum
# never fires. Wildcard/binding/literal/struct/tuple/etc. arms are skipped (not variants).

extend Semantic:
    private:
        # Whether `path` is qualified by `prefix` — i.e. spells `prefix` followed immediately
        # by a '.'. Compares bytes directly (no sub-sview construction); requires the '.' so a
        # name that is a proper prefix of another (`Color` vs `ColorScheme`) never false-matches.
        def path_qualified_by(path: sview, prefix: sview) -> bool:
            can Abort.Panic:
                prefix_length: usize = sview_len(prefix)
                path_length: usize = sview_len(path)
                false return if path_length <= prefix_length
                false return if sview_at(path, prefix_length) != '.'
                for char_index in 0..<prefix_length:
                    false return if sview_at(path, char_index) != sview_at(prefix, char_index)
                return true

        # The first registered enum (other than `exclude`) whose name qualifies `path`, or ""
        # when none. Returns a registry sview directly, so no substring of `path` is built.
        def find_mismatched_enum_qualifier(path: sview, exclude: sview, table: SymbolTable&) -> sview:
            can Abort.Panic:
                while owner_index < table.enum_variant_owner.count |owner_index: usize = 0|:
                    owner: sview = table.enum_variant_owner[owner_index]
                    owner return if owner != exclude and path_qualified_by(path, owner)
                    owner_index <- owner_index + 1
                return ""

        # Collect every Pattern.Variant path reachable from `pattern`, descending through
        # Pattern.Or and Pattern.As (the only wrappers that can carry a variant pattern).
        # Other pattern kinds (Wildcard/Binding/Literal/Struct/Tuple/TypeBind/Range/Other)
        # contribute nothing — they are not variant patterns.
        def collect_variant_paths_for_mismatch(pattern: Ast::Pattern, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match pattern:
                    Pattern.Variant(path, fields):
                        out.push(path)
                    Pattern.Or(options):
                        for option in options |out|:
                            collect_variant_paths_for_mismatch(option, out)
                    Pattern.As(as_name, as_inner):
                        for inner_pattern in as_inner |out|:
                            collect_variant_paths_for_mismatch(inner_pattern, out)
                    _:
                        pass

        # Shared logic for both Stmt.Match and Expr.Match: if the scrutinee is a plain
        # identifier with a known-enum local type, flag any arm variant path whose enum
        # qualifier is a DIFFERENT registered enum.
        def check_match_arm_enum_mismatch_arms(scrutinee: Ast::Expr, arms: darray[Ast::MatchArm], line: u32, var_types: darray[sview]&, type_names: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                scrutinee_name: sview = match scrutinee:
                    Expr.Ident(name, ident_line): name
                    _:                            ""
                return if scrutinee_name == ""
                enum_name: sview = local_type_of(var_types, type_names, scrutinee_name)
                return if enum_name == "" or not enum_is_known(enum_name, table)
                for arm in arms |table|:
                    paths: mutable darray[sview] = []
                    collect_variant_paths_for_mismatch(arm.pattern, paths)
                    for path in paths |table|:
                        qualifier: sview = find_mismatched_enum_qualifier(path, enum_name, table)
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.MatchArmEnumMismatch, name: enum_name, line: line, expected: qualifier, actual: ""}) if qualifier != ""

        # Walk through expressions, checking `match` expressions for arm/scrutinee enum mismatch.
        def walk_expression_for_match_arm_enum_mismatch(expression: Ast::Expr, table: lmut SymbolTable, var_types: mutable darray[sview]&, type_names: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Binary(left, operator, right, line):
                        table <- walk_expression_for_match_arm_enum_mismatch(left, table, var_types, type_names)
                        table <- walk_expression_for_match_arm_enum_mismatch(right, table, var_types, type_names) if operator != TokenKind.Is and operator != TokenKind.As
                    Expr.Call(callee, arguments, argument_names, line):
                        table <- walk_expression_for_match_arm_enum_mismatch(callee, table, var_types, type_names)
                        for argument in arguments |table|:
                            table <- walk_expression_for_match_arm_enum_mismatch(argument, table, var_types, type_names)
                    Expr.Field(object, field, line):
                        table <- walk_expression_for_match_arm_enum_mismatch(object, table, var_types, type_names)
                    Expr.Scope(base, name, line):
                        table <- walk_expression_for_match_arm_enum_mismatch(base, table, var_types, type_names)
                    Expr.Index(object, index, line):
                        table <- walk_expression_for_match_arm_enum_mismatch(object, table, var_types, type_names)
                        table <- walk_expression_for_match_arm_enum_mismatch(index, table, var_types, type_names) if not index_receiver_is_type_application(object)
                    Expr.Unary(operator, operand, line):
                        table <- walk_expression_for_match_arm_enum_mismatch(operand, table, var_types, type_names)
                    Expr.Paren(inner, line):
                        table <- walk_expression_for_match_arm_enum_mismatch(inner, table, var_types, type_names)
                    Expr.Array(elements, line):
                        for element in elements |table|:
                            table <- walk_expression_for_match_arm_enum_mismatch(element, table, var_types, type_names)
                    Expr.Tuple(elements, line):
                        for element in elements |table|:
                            table <- walk_expression_for_match_arm_enum_mismatch(element, table, var_types, type_names)
                    Expr.Slice(object, low, high, line):
                        table <- walk_expression_for_match_arm_enum_mismatch(object, table, var_types, type_names)
                        table <- walk_expression_for_match_arm_enum_mismatch(low, table, var_types, type_names)
                        table <- walk_expression_for_match_arm_enum_mismatch(high, table, var_types, type_names)
                    Expr.IndexN(object, arguments, line):
                        table <- walk_expression_for_match_arm_enum_mismatch(object, table, var_types, type_names)
                        for argument in arguments |table|:
                            table <- walk_expression_for_match_arm_enum_mismatch(argument, table, var_types, type_names) if not index_receiver_is_type_application(object)
                    Expr.SetLit(elements, line):
                        for element in elements |table|:
                            table <- walk_expression_for_match_arm_enum_mismatch(element, table, var_types, type_names)
                    Expr.DictLit(entries, line):
                        for entry in entries |table|:
                            table <- walk_expression_for_match_arm_enum_mismatch(entry.key, table, var_types, type_names)
                            table <- walk_expression_for_match_arm_enum_mismatch(entry.value, table, var_types, type_names)
                    Expr.Construct(type_expression, fields, line):
                        table <- walk_expression_for_match_arm_enum_mismatch(type_expression, table, var_types, type_names)
                        for field in fields |table|:
                            table <- walk_expression_for_match_arm_enum_mismatch(field.value, table, var_types, type_names)
                    Expr.RecordUpdate(base, fields, line):
                        table <- walk_expression_for_match_arm_enum_mismatch(base, table, var_types, type_names)
                        for field in fields |table|:
                            table <- walk_expression_for_match_arm_enum_mismatch(field.value, table, var_types, type_names)
                    Expr.If(condition, then_expr, else_expr, line):
                        table <- walk_expression_for_match_arm_enum_mismatch(condition, table, var_types, type_names)
                        table <- walk_expression_for_match_arm_enum_mismatch(then_expr, table, var_types, type_names)
                        table <- walk_expression_for_match_arm_enum_mismatch(else_expr, table, var_types, type_names)
                    Expr.Comprehension(loop_variable, iterable, condition, body, line):
                        table <- walk_expression_for_match_arm_enum_mismatch(iterable, table, var_types, type_names)
                        table <- walk_expression_for_match_arm_enum_mismatch(condition, table, var_types, type_names)
                        table <- walk_expression_for_match_arm_enum_mismatch(body, table, var_types, type_names)
                    Expr.Lambda(parameters, body, line):
                        table <- walk_statements_for_match_arm_enum_mismatch(body, table, var_types, type_names)
                    Expr.Block(statements, value, captures, line):
                        table <- walk_statements_for_match_arm_enum_mismatch(statements, table, var_types, type_names)
                        table <- walk_expression_for_match_arm_enum_mismatch(value, table, var_types, type_names)
                    Expr.Match(scrutinee, arms, line):
                        table <- walk_expression_for_match_arm_enum_mismatch(scrutinee, table, var_types, type_names)
                        table <- check_match_arm_enum_mismatch_arms(scrutinee, arms, line, var_types, type_names, table)
                        for arm in arms |table|:
                            table <- walk_statements_for_match_arm_enum_mismatch(arm.body, table, var_types, type_names)
                    # Literals and other expressions don't contain relevant sub-expressions
                    _:
                        pass

        # Walk through statements, tracking variable types and checking `match` statements.
        def walk_statements_for_match_arm_enum_mismatch(statements: darray[Ast::Stmt], table: lmut SymbolTable, var_types: mutable darray[sview]&, type_names: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table|:
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- walk_expression_for_match_arm_enum_mismatch(expression, table, var_types, type_names)
                        Stmt.VarDecl(name, type_expression, value, line):
                            type_name: sview = bare_type_name(type_expression)
                            note_local_type(var_types, type_names, name, type_name)
                            table <- walk_expression_for_match_arm_enum_mismatch(value, table, var_types, type_names)
                        Stmt.Assign(target, operator, value, line):
                            table <- walk_expression_for_match_arm_enum_mismatch(target, table, var_types, type_names)
                            table <- walk_expression_for_match_arm_enum_mismatch(value, table, var_types, type_names)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- walk_expression_for_match_arm_enum_mismatch(condition, table, var_types, type_names)
                            table <- walk_statements_for_match_arm_enum_mismatch(then_body, table, var_types, type_names)
                            table <- walk_statements_for_match_arm_enum_mismatch(else_body, table, var_types, type_names)
                        Stmt.While(condition, body, line):
                            table <- walk_expression_for_match_arm_enum_mismatch(condition, table, var_types, type_names)
                            table <- walk_statements_for_match_arm_enum_mismatch(body, table, var_types, type_names)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- walk_expression_for_match_arm_enum_mismatch(iterable, table, var_types, type_names)
                            table <- walk_statements_for_match_arm_enum_mismatch(body, table, var_types, type_names)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- walk_statements_for_match_arm_enum_mismatch(body, table, var_types, type_names)
                        Stmt.Match(scrutinee, arms, line):
                            table <- walk_expression_for_match_arm_enum_mismatch(scrutinee, table, var_types, type_names)
                            table <- check_match_arm_enum_mismatch_arms(scrutinee, arms, line, var_types, type_names, table)
                            for arm in arms |table|:
                                table <- walk_expression_for_match_arm_enum_mismatch(arm.guard, table, var_types, type_names)
                                table <- walk_statements_for_match_arm_enum_mismatch(arm.body, table, var_types, type_names)
                        Stmt.Return(value, line):
                            table <- walk_expression_for_match_arm_enum_mismatch(return_value, table, var_types, type_names) if value is return_value
                        Stmt.Contract(kind, expression, line):
                            table <- walk_expression_for_match_arm_enum_mismatch(expression, table, var_types, type_names)
                        Stmt.Invalid:
                            pass
                        Stmt.Break(label, line):
                            pass
                        Stmt.Continue(label, line):
                            pass

        # Walk through function declarations.
        def check_match_arm_enum_mismatch_declarations(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table|:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            var_types: mutable darray[sview] = []
                            type_names: mutable darray[sview] = []
                            for param in params |table|:
                                param_type: sview = bare_type_name(param.type_expression)
                                note_local_type(var_types, type_names, param.name, param_type)
                            table <- walk_statements_for_match_arm_enum_mismatch(body, table, var_types, type_names)
                        Decl.Module(module_name, body, line):
                            table <- check_match_arm_enum_mismatch_declarations(body, table)
                        Decl.Scoped(body, line):
                            table <- check_match_arm_enum_mismatch_declarations(body, table)
                        _:
                            pass

    public:
        # Public entry point for the check.
        def check_match_arm_enum_mismatch(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- check_match_arm_enum_mismatch_declarations(declarations, table)
