# Canonical identities shared by symbol collection, lexical resolution and flow.
module Semantic:
    public:
        # Stable only for the lifetime of one collected table. Persistent caches
        # additionally need a source/module fingerprint.
        struct DeclId:
            value: u32

        # Serial zero is valid: the resolver allocates it to the first binding.
        # Owner identity separates equal local ordinals in different functions.
        struct BindingId:
            owner: DeclId
            serial: u64

        # Liveness only, not affine ownership, borrow freedom, or state legality.
        struct OwnershipBindingFact:
            binding_id: BindingId
            reachable: bool
            known: bool
            may_live: bool
            may_consumed: bool
