extend Semantic:
    private:
        def variance_type_is_optional(expression: Ast::Expr) -> bool:
            can Abort.Panic:
                match expression:
                    Expr.Unary(operator, operand, line):
                        true return if operator == TokenKind.Question
                        return variance_type_is_optional(operand)
                    Expr.Paren(inner, line):
                        return variance_type_is_optional(inner)
                    _:
                        return false

        def variance_type_root(expression: Ast::Expr) -> sview:
            can Abort.Panic:
                match expression:
                    Expr.Ident(name, line):
                        return name
                    Expr.Unary(operator, operand, line):
                        return variance_type_root(operand)
                    Expr.Paren(inner, line):
                        return variance_type_root(inner)
                    _:
                        return ""

        def callback_parameter_is_narrower(expected: Ast::Expr, actual: Ast::Expr) -> bool:
            can Abort.Panic:
                expected_root: sview = variance_type_root(expected)
                actual_root: sview = variance_type_root(actual)
                return expected_root != "" and expected_root == actual_root and variance_type_is_optional(expected) and not variance_type_is_optional(actual)

        def check_function_variance_candidate(variable_name: sview, expected_parameters: darray[Ast::Expr]&, function_name: sview, declarations: darray[Ast::Decl]&, line: u32, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table|:
                    match declaration:
                        Decl.Func(name, parameters, return_type, body, effects, decorators, function_line):
                            if name == function_name and parameters.count == expected_parameters.count:
                                while parameter_index < parameters.count |parameter_index: usize = 0, table|:
                                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.FunctionParameterVariance, name: variable_name, line: line, expected: function_name, actual: ""}) if callback_parameter_is_narrower(expected_parameters[parameter_index], parameters[parameter_index].type_expression)
                                    parameter_index <- parameter_index + 1
                        Decl.Module(name, body, module_line):
                            table <- check_function_variance_candidate(variable_name, expected_parameters, function_name, body, line, table)
                        Decl.Scoped(body, scope_line):
                            table <- check_function_variance_candidate(variable_name, expected_parameters, function_name, body, line, table)
                        _:
                            pass

        def check_function_variance_declaration(variable_name: sview, type_expression: Ast::Expr, value: Ast::Expr, declarations: darray[Ast::Decl]&, line: u32, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                function_name: sview = ident_name_of(value)
                return if function_name == ""
                match type_expression:
                    Expr.Binary(signature, operator, result, signature_line):
                        if operator == TokenKind.Arrow:
                            match signature:
                                Expr.Call(callee, arguments, argument_names, call_line):
                                    if ident_name_of(callee) == "fn":
                                        expected_parameters: mutable darray[Ast::Expr] = []
                                        expected_parameters.extend(arguments)
                                        table <- check_function_variance_candidate(variable_name, expected_parameters, function_name, declarations, line, table)
                                _:
                                    pass
                    _:
                        pass

        def check_function_variance_statements(statements: darray[Ast::Stmt], declarations: darray[Ast::Decl]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table|:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- check_function_variance_declaration(name, type_expression, value, declarations, line, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- check_function_variance_statements(then_body, declarations, table)
                            table <- check_function_variance_statements(else_body, declarations, table)
                        Stmt.While(condition, body, line):
                            table <- check_function_variance_statements(body, declarations, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- check_function_variance_statements(body, declarations, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- check_function_variance_statements(body, declarations, table)
                        _:
                            pass

        def check_function_variance_declarations(declarations: darray[Ast::Decl], all_declarations: darray[Ast::Decl]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table|:
                    match declaration:
                        Decl.Func(name, parameters, return_type, body, effects, decorators, line):
                            table <- check_function_variance_statements(body, all_declarations, table)
                        Decl.Module(name, body, line):
                            table <- check_function_variance_declarations(body, all_declarations, table)
                        Decl.Scoped(body, line):
                            table <- check_function_variance_declarations(body, all_declarations, table)
                        _:
                            pass

    public:
        def check_function_variance(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- check_function_variance_declarations(declarations, declarations, table)
