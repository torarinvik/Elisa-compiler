# `@noalloc` is a marker decorator that takes no arguments; `@noalloc(x)` is a hard error
# ("@noalloc on function X does not take arguments"). Pure syntactic: a function decorator named
# "noalloc" whose captured argument count is non-zero.
extend Semantic:
    private:
        def check_noalloc_arguments(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            for decorator in decorators |table| -> table:
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.NoallocArguments, name: function_name, line: decorator.line, expected: "", actual: ""}) if decorator.name == "noalloc" and decorator.arg_count > 0
                        Decl.Module(module_name, module_body, module_line):
                            table <- check_noalloc_arguments(module_body, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- check_noalloc_arguments(scoped_body, table)
                        _:
                            pass
