# `@noalloc` is a marker decorator that takes no arguments; `@noalloc(x)` is a hard error
# ("@noalloc on function X does not take arguments"). Pure syntactic: a function decorator named
# "noalloc" whose captured argument count is non-zero.
include "./noalloc_argument_policy.elisa"

extend Semantic:
    private:
        def check_noalloc_arguments(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            for decorator in decorators |table| -> table:
                                # Same span rule as @callconv: the decorator name alone, so
                                # `@noalloc(1)` is cited as `1:2-9`.
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.NoallocArguments, name: function_name, line: decorator.line, pos: Ast::Pos{line: decorator.line, column: decorator.column, offset: 0, end_line: decorator.line, end_column: decorator.column + sview_len(decorator.name).u32(), end_offset: 0}, expected: "", actual: ""}) if NoallocArgumentPolicy::rejects_decorator(decorator.name, decorator.arg_count)
                        Decl.Module(module_name, module_body, module_line):
                            table <- check_noalloc_arguments(module_body, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- check_noalloc_arguments(scoped_body, table)
                        _:
                            pass
