# Law-refinement violation on a struct field at construction. A field `f: T is Law[bounds]`
# (a LAW refinement, distinct from a `where` predicate) constructed with a constant that breaks
# Law — `struct Dst: op: u32 is UB[0,127]` then `Dst{op: 999}` — is rejected ("refinement UB is
# violated: the struct field value does not satisfy it"). Reuses refinement_bound_spec (bounded)
# and bare_law_violated_by (bare/bool); a non-constant field value is a sound miss.
extend Semantic:
    private:
        # Struct field LAW-refined types as parallel (struct, field, type-expression) rows.
        def collect_field_law_types(declarations: darray[Ast::Decl], structs: mutable darray[sview]&, fields: mutable darray[sview]&, types: mutable darray[Ast::Expr]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |structs, fields, types|:
                    match declaration:
                        Decl.Struct(struct_name, members, affinity, has_named_states, has_derive, invariants, struct_line):
                            for member in members |structs, fields, types|:
                                structs.push(struct_name)
                                fields.push(member.name)
                                types.push(member.type_expression)
                        Decl.Module(module_name, module_body, module_line):
                            collect_field_law_types(module_body, structs, fields, types)
                        Decl.Scoped(scoped_body, scoped_line):
                            collect_field_law_types(scoped_body, structs, fields, types)
                        _:
                            pass

        # The declared type of (struct, field), or Absent.
        def struct_law_field_type_of(struct_name: sview, field: sview, structs: darray[sview]&, fields: darray[sview]&, types: darray[Ast::Expr]&) -> Ast::Expr:
            can Abort.Panic:
                probe: mutable usize = 0
                result: mutable Ast::Expr = (Ast::Expr.Absent)
                while probe < structs.count |probe, result|:
                    result <- types[probe] if structs[probe] == struct_name and fields[probe] == field
                    probe <- probe + 1
                return result

        # Whether constant VALUE violates the field TYPE's law refinement.
        def field_law_violated(field_type: Ast::Expr, value: i64, law_names: darray[sview]&, law_predicates: darray[Ast::Expr]&) -> (found: bool, law_name: sview):
            can Memory.Allocate, Abort.Panic:
                spec: (found: bool, law_name: sview, lo: i64, hi: i64) = refinement_bound_spec(field_type, law_names, law_predicates)
                (true, spec.law_name) return if spec.found and (value < spec.lo or value > spec.hi)
                (false, sview("", 0, 0)) return if spec.found
                bare_law: sview = bare_law_of_type(field_type)
                bare_predicate: Ast::Expr = law_predicate_by_name(bare_law, law_names, law_predicates) if bare_law != "" else (Ast::Expr.Absent)
                bare_has: bool = match bare_predicate:
                    Expr.Absent: false
                    _: true
                return (bare_has and bare_law_violated_by(bare_predicate, value), bare_law)

        # The refined-field window a value denotes when it is `base.fname` and `base` is a param
        # of a struct type whose field `fname` is law-refined (`s.v` with `Src.v: u32 is UB[0,1000]`
        # -> [0, 1000]). found=false otherwise — an exact interval, so `escape ⇒ emit` stays sound.
        def field_value_source_window(value: Ast::Expr, param_names: darray[sview]&, param_structs: darray[sview]&, structs: darray[sview]&, fields: darray[sview]&, types: darray[Ast::Expr]&, law_names: darray[sview]&, law_predicates: darray[Ast::Expr]&) -> (found: bool, lo: i64, hi: i64):
            can Memory.Allocate, Abort.Panic:
                match value:
                    Expr.Field(object, field_name, field_line):
                        base: sview = ident_name_of(object)
                        (false, 0, 0) return if base == ""
                        base_struct: mutable sview = sview("", 0, 0)
                        probe: mutable usize = 0
                        while probe < param_names.count |probe, base_struct, base, param_names, param_structs|:
                            base_struct <- param_structs[probe] if param_names[probe] == base and base_struct == ""
                            probe <- probe + 1
                        (false, 0, 0) return if base_struct == ""
                        source_type: Ast::Expr = struct_law_field_type_of(base_struct, field_name, structs, fields, types)
                        spec: (found: bool, law_name: sview, lo: i64, hi: i64) = refinement_bound_spec(source_type, law_names, law_predicates)
                        return (spec.found, spec.lo, spec.hi)
                    _:
                        return (false, 0, 0)

        def field_law_check_expression(expression: Ast::Expr, param_names: darray[sview]&, param_structs: darray[sview]&, structs: darray[sview]&, fields: darray[sview]&, types: darray[Ast::Expr]&, law_names: darray[sview]&, law_predicates: darray[Ast::Expr]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Construct(type_expression, construct_fields, construct_line):
                        struct_name: sview = bare_struct_type(type_expression)
                        for field in construct_fields |table| -> table:
                            field_constant: (found: bool, value: i64) = fold_const_int(field.value)
                            field_type: Ast::Expr = struct_law_field_type_of(struct_name, field.name, structs, fields, types) if struct_name != "" and field_constant.found else (Ast::Expr.Absent)
                            verdict: (found: bool, law_name: sview) = field_law_violated(field_type, field_constant.value, law_names, law_predicates) if field_constant.found else (false, sview("", 0, 0))
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.RefinementBoundViolated, name: verdict.law_name, line: construct_line.line, expected: "field", actual: ""}) if verdict.found
                        # UNPROVEN dual: a NON-const field value whose source refined-field interval
                        # provably ESCAPES the target field window (wider `s.v: UB[0,1000]` routed into
                        # narrower `op: UB[0,127]`). Warning (severity 2), so never rejects.
                        for field in construct_fields |table| -> table:
                            target_type: Ast::Expr = struct_law_field_type_of(struct_name, field.name, structs, fields, types) if struct_name != "" else (Ast::Expr.Absent)
                            target_spec: (found: bool, law_name: sview, lo: i64, hi: i64) = refinement_bound_spec(target_type, law_names, law_predicates)
                            source_window: (found: bool, lo: i64, hi: i64) = field_value_source_window(field.value, param_names, param_structs, structs, fields, types, law_names, law_predicates) if target_spec.found else (false, 0, 0)
                            escapes: bool = target_spec.found and source_window.found and (source_window.lo < target_spec.lo or source_window.hi > target_spec.hi)
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.RefinementReturnNotProven, name: target_spec.law_name, line: construct_line.line, expected: "", actual: ""}) if escapes
                        for field in construct_fields |table| -> table:
                            table <- field_law_check_expression(field.value, param_names, param_structs, structs, fields, types, law_names, law_predicates, table)
                    Expr.Paren(inner, paren_line):
                        table <- field_law_check_expression(inner, param_names, param_structs, structs, fields, types, law_names, law_predicates, table)
                    Expr.Call(callee, arguments, argument_names, call_line):
                        for argument in arguments |table| -> table:
                            table <- field_law_check_expression(argument, param_names, param_structs, structs, fields, types, law_names, law_predicates, table)
                    _:
                        pass

        def field_law_check_statements(statements: darray[Ast::Stmt], param_names: darray[sview]&, param_structs: darray[sview]&, structs: darray[sview]&, fields: darray[sview]&, types: darray[Ast::Expr]&, law_names: darray[sview]&, law_predicates: darray[Ast::Expr]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- field_law_check_expression(value, param_names, param_structs, structs, fields, types, law_names, law_predicates, table)
                        Stmt.Assign(target, operator, value, line):
                            table <- field_law_check_expression(value, param_names, param_structs, structs, fields, types, law_names, law_predicates, table)
                        Stmt.Expr(expression, line):
                            table <- field_law_check_expression(expression, param_names, param_structs, structs, fields, types, law_names, law_predicates, table)
                        Stmt.Return(value, line):
                            if value is returned:
                                table <- field_law_check_expression(returned, param_names, param_structs, structs, fields, types, law_names, law_predicates, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- field_law_check_statements(then_body, param_names, param_structs, structs, fields, types, law_names, law_predicates, table)
                            table <- field_law_check_statements(else_body, param_names, param_structs, structs, fields, types, law_names, law_predicates, table)
                        Stmt.While(condition, while_body, line):
                            table <- field_law_check_statements(while_body, param_names, param_structs, structs, fields, types, law_names, law_predicates, table)
                        Stmt.For(bind, variables, iterable, for_body, line):
                            table <- field_law_check_statements(for_body, param_names, param_structs, structs, fields, types, law_names, law_predicates, table)
                        Stmt.Block(kind, clause, binding, block_body, block_line):
                            table <- field_law_check_statements(block_body, param_names, param_structs, structs, fields, types, law_names, law_predicates, table)
                        _:
                            pass

        def field_law_violated_walk(declarations: darray[Ast::Decl], structs: darray[sview]&, fields: darray[sview]&, types: darray[Ast::Expr]&, law_names: darray[sview]&, law_predicates: darray[Ast::Expr]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            param_names: mutable darray[sview] = []
                            param_structs: mutable darray[sview] = []
                            for parameter in parameters |param_names, param_structs|:
                                param_names.push(parameter.name)
                                param_structs.push(bare_type_name_through_ref(parameter.type_expression))
                            table <- field_law_check_statements(body, param_names, param_structs, structs, fields, types, law_names, law_predicates, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- field_law_violated_walk(module_body, structs, fields, types, law_names, law_predicates, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- field_law_violated_walk(scoped_body, structs, fields, types, law_names, law_predicates, table)
                        _:
                            pass

        def check_struct_field_law_violated(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                structs: mutable darray[sview] = []
                fields: mutable darray[sview] = []
                types: mutable darray[Ast::Expr] = []
                collect_field_law_types(declarations, structs, fields, types)
                law_names: mutable darray[sview] = []
                law_predicates: mutable darray[Ast::Expr] = []
                collect_laws(declarations, law_names, law_predicates)
                table <- field_law_violated_walk(declarations, structs, fields, types, law_names, law_predicates, table) if structs.count > 0
