extend Semantic:
    private:
        # `table.enum_variant_*` flattens every declaration, including inactive static-if
        # arms, and does not retain declaration identity. Rewalk the AST to classify the
        # matching ErrorSet declaration by its exact keyword/name metadata join. A missing
        # or unresolved join is uncertainty, not evidence that a branch is inactive.
        def catch_error_set_variant_branch_state(declarations: darray[Ast::Decl], lexical_module: sview @source, family: sview, family_module: sview, variant_filter: sview, annotations: darray[Ast::EnumAnnotation]&, file: Ast::File&, table: SymbolTable&) -> (found: bool, active: bool, uncertain: bool):
            can Abort.Panic:
                found: mutable bool = false
                active: mutable bool = false
                uncertain: mutable bool = false
                for declaration in declarations |found, active, uncertain, lexical_module, family, family_module, variant_filter, annotations, file, table|:
                    match declaration:
                        Decl.Module(module_name, body, _):
                            nested: (found: bool, active: bool, uncertain: bool) = catch_error_set_variant_branch_state(body, module_name, family, family_module, variant_filter, annotations, file, table)
                            found <- true if nested.found
                            active <- true if nested.active
                            uncertain <- true if nested.uncertain
                        Decl.Scoped(body, _):
                            nested: (found: bool, active: bool, uncertain: bool) = catch_error_set_variant_branch_state(body, lexical_module, family, family_module, variant_filter, annotations, file, table)
                            found <- true if nested.found
                            active <- true if nested.active
                            uncertain <- true if nested.uncertain
                        Decl.Enum(name, variants, _, _, declaration_pos):
                            continue if name != family or lexical_module != family_module
                            variant_found: mutable bool = variant_filter == ""
                            for enum_variant in variants |variant_found, variant_filter|:
                                variant_found <- true if enum_variant.name == variant_filter
                            continue if not variant_found
                            synthetic_marker_count: mutable usize = 0.usize()
                            for marker in annotations |synthetic_marker_count, name, lexical_module, declaration_pos|:
                                continue if marker.owner != "__error_set_synthetic" or marker.name != name or marker.module != lexical_module or marker.line != declaration_pos.line or marker.offset != declaration_pos.offset
                                synthetic_marker_count <- synthetic_marker_count + 1.usize()
                            name_row_count: mutable usize = 0.usize()
                            name_offset: mutable u32 = 0
                            for name_row in annotations |name_row_count, name_offset, name, declaration_pos|:
                                continue if name_row.owner != "__lsp_decl_name" or name_row.name != name or name_row.line != declaration_pos.line or name_row.offset != declaration_pos.offset
                                name_row_count <- name_row_count + 1.usize()
                                name_offset <- name_row.pos.offset
                            if name_row_count == 0.usize() and synthetic_marker_count == 1.usize():
                                # Generated ForeignEnum has an exact synthetic-provenance marker
                                # at the Decl position rather than a source name token.
                                name_offset <- declaration_pos.offset
                            elif name_row_count == 1.usize() and synthetic_marker_count == 0.usize():
                                continue if not any row in annotations where row.owner == "__error_set_decl" and row.name == name and row.module == lexical_module and row.line == declaration_pos.line and row.offset == name_offset
                            else:
                                found <- true
                                uncertain <- true
                                continue
                            continue if not any row in annotations where row.owner == "__error_set_decl" and row.name == name and row.module == lexical_module and row.line == declaration_pos.line and row.offset == name_offset
                            found <- true
                            if synthetic_marker_count != 0.usize() and (name_row_count != 0.usize() or synthetic_marker_count != 1.usize()):
                                uncertain <- true
                                continue
                            declaration_rows: mutable usize = 0.usize()
                            selected_declaration: mutable Ast::EnumAnnotation = Ast::EnumAnnotation{owner: "", name: "", line: 0}
                            for row in annotations |declaration_rows, selected_declaration, name, lexical_module, declaration_pos, name_offset|:
                                continue if row.owner != "__error_set_decl" or row.name != name or row.module != lexical_module or row.line != declaration_pos.line or row.offset != name_offset
                                selected_declaration <- row
                                declaration_rows <- declaration_rows + 1.usize()
                            if declaration_rows != 1.usize():
                                uncertain <- true
                                continue
                            branch: (known: bool, active: bool) = catch_error_set_declaration_branch_selection(selected_declaration, annotations, file, table)
                            active <- true if branch.known and branch.active
                            uncertain <- true if not branch.known
                        _:
                            pass
                return (found, active, uncertain)

        # Branches can contribute duplicate flattened rows for the same canonical tag.
        # Count that tag once, even when an inactive declaration precedes an active one.
        def catch_error_variant_table_row_is_first(table: SymbolTable&, row: usize, family: sview, family_module: sview, variant: sview) -> bool:
            can Abort.Panic:
                return false if row >= table.enum_variant_owner.count or row >= table.enum_variant_name.count or row >= table.enum_variant_module.count
                for previous in 0..<row |table, row, family, family_module, variant|:
                    return false if table.enum_variant_owner[previous] == family and table.enum_variant_module[previous] == family_module and table.enum_variant_name[previous] == variant
                return true

        def catch_path_has_variant(path: sview @source, catch_module: sview @source, catch_line: u32, catch_offset: u32, function_module: sview @source, declaration_line: u32, declaration_offset: u32, declaration_identity_id: u32, occurrence_offset: u32, family: sview @source, variant: sview, family_module: sview, include_only_caught_variants: bool, annotations: darray[Ast::EnumAnnotation]&, file: Ast::File&, table: SymbolTable&) -> bool:
            can Abort.Panic:
                target_state: (found: bool, active: bool, uncertain: bool) = catch_error_set_variant_branch_state(file.top_decls, "", family, family_module, variant, file.enum_annotations, file, table)
                return false if target_state.uncertain or (target_state.found and not target_state.active)
                return true if catch_variant_path_is_exact(path, family, variant, family_module)
                # Resolve a qualified arm in the catch's lexical module. The raw
                # spelling may start with an alias rather than the canonical owner.
                suffix_length: usize = family.len + variant.len + 1.usize()
                if path.len > suffix_length and path[path.len - variant.len - 1.usize()] == 46:
                    family_path: sview @source = path[0:path.len - variant.len - 1.usize()]
                    resolved: (found: bool, uncertain: bool, module: sview @source) = catch_explicit_error_family_module(family_path, catch_line, catch_offset, 0, catch_module, family, annotations, table)
                    return resolved.module == family_module if resolved.found and path[path.len - variant.len:path.len] == variant
                return false if not catch_variant_path_matches(path, family, variant, family_module)
                matching_union_tags: mutable usize = 0.usize()
                matched_target: mutable bool = false
                for family_index in 0..<annotations.count |matching_union_tags, matched_target, annotations, family_index, function_module, declaration_line, declaration_offset, declaration_identity_id, occurrence_offset, family, variant, family_module, table, path|:
                    family_annotation: Ast::EnumAnnotation = annotations[family_index]
                    continue if family_annotation.owner != "__error_set_family" or family_annotation.line != declaration_line
                    continue if family_annotation.offset != declaration_offset
                    continue if family_annotation.identity_id != declaration_identity_id
                    continue if family_annotation.occurrence_offset != occurrence_offset
                    continue if family_index + 1.usize() >= annotations.count
                    family_path_annotation: Ast::EnumAnnotation = annotations[family_index + 1.usize()]
                    continue if family_path_annotation.owner != "__error_set_family_path" or family_path_annotation.line != family_annotation.line or family_path_annotation.offset != family_annotation.offset or family_path_annotation.identity_id != family_annotation.identity_id or family_path_annotation.occurrence_offset != occurrence_offset
                    candidate_family: sview = family_annotation.name
                    candidate_module: (known: bool, module: sview @source) = catch_error_family_module_for_declaration(annotations, declaration_line, declaration_offset, declaration_identity_id, candidate_family, family_path_annotation.name, true, function_module, table)
                    continue if not candidate_module.known
                    for candidate_index in 0..<table.enum_variant_owner.count |matching_union_tags, matched_target, table|:
                        candidate_variant: sview = table.enum_variant_name[candidate_index]
                        continue if table.enum_variant_owner[candidate_index] != candidate_family
                        continue if candidate_index >= table.enum_variant_module.count or table.enum_variant_module[candidate_index] != candidate_module.module
                        continue if not catch_error_variant_table_row_is_first(table, candidate_index, candidate_family, candidate_module.module, candidate_variant)
                        candidate_state: (found: bool, active: bool, uncertain: bool) = catch_error_set_variant_branch_state(file.top_decls, "", candidate_family, candidate_module.module, candidate_variant, file.enum_annotations, file, table)
                        continue if candidate_state.uncertain or (candidate_state.found and not candidate_state.active)
                        continue if include_only_caught_variants and not catch_family_row_allows_variant(annotations, family_index, declaration_line, declaration_offset, declaration_identity_id, occurrence_offset, candidate_family, candidate_variant)
                        if catch_variant_path_matches(path, candidate_family, candidate_variant, candidate_module.module):
                            matching_union_tags <- matching_union_tags + 1.usize()
                            matched_target <- true if candidate_family == family and candidate_variant == variant and candidate_module.module == family_module
                return matching_union_tags == 1.usize() and matched_target

        def catch_line_has_variant(annotations: darray[Ast::EnumAnnotation]&, callee: sview, catch_line: u32, catch_offset: u32, catch_module: sview @source, function_module: sview @source, declaration_line: u32, declaration_offset: u32, declaration_identity_id: u32, occurrence_offset: u32, family: sview @source, variant: sview, family_module: sview, file: Ast::File&, table: SymbolTable&) -> bool:
            can Abort.Panic:
                for annotation in annotations:
                    continue if annotation.owner != callee or annotation.line != catch_line or annotation.offset != catch_offset or annotation.module != catch_module
                    return true if catch_path_has_variant(annotation.name, catch_module, catch_line, catch_offset, function_module, declaration_line, declaration_offset, declaration_identity_id, occurrence_offset, family, variant, family_module, true, annotations, file, table)
                return false

        # Lexicographic `a < b` over sviews, byte by byte. stage0 runs the missing tags through
        # `sort.Strings` before joining them (analyzer_flow_match_core.go:610), so "the first
        # missing variant" means the alphabetically first one, NOT the declaration-order first.
        # Without this the two compilers name different variants the moment an enum declares its
        # members out of alphabetical order -- a divergence no probe with an already-sorted enum
        # can show. Go's sort compares raw bytes and so does this, so the orders agree for every
        # byte string rather than only for ASCII.
        def catch_name_before(a: sview, b: sview) -> bool:
            can Abort.Panic:
                limit: usize = a.len if a.len < b.len else b.len
                verdict: mutable i32 = 0
                for index in 0..<limit |verdict, a, b|:
                    verdict <- 1 if verdict == 0 and a[index] < b[index]
                    verdict <- 2 if verdict == 0 and a[index] > b[index]
                return true if verdict == 1
                return false if verdict == 2
                return a.len < b.len

        def catch_error_tag_before(left_module: sview, left_family: sview, left_variant: sview, right_module: sview, right_family: sview, right_variant: sview) -> bool:
            can Abort.Panic:
                return catch_name_before(left_module, right_module) if left_module != right_module
                return catch_name_before(left_family, right_family) if left_family != right_family
                return catch_name_before(left_variant, right_variant)

        # The caught error set may contain several families. Return the first missing tag
        # from one family; the caller selects the first across the full union.
        def catch_family_first_missing(annotations: darray[Ast::EnumAnnotation]&, callee: sview @source, catch_line: u32, catch_offset: u32, catch_module: sview @source, declaration_line: u32, declaration_offset: u32, declaration_identity_id: u32, occurrence_offset: u32, family: sview @source, family_path: sview @source, function_module: sview @source, file: Ast::File&, table: SymbolTable&) -> (known: bool, module: sview @source, variant: sview @source):
            can Abort.Panic:
                return (false, family, "") if family == "" or catch_family_is_subset(annotations, declaration_line, declaration_offset, declaration_identity_id, occurrence_offset, family, family_path)
                family_module: (known: bool, module: sview @source) = catch_error_family_module_for_declaration(annotations, declaration_line, declaration_offset, declaration_identity_id, family, family_path, true, function_module, table)
                return (false, family, "") if not family_module.known
                family_branch: (found: bool, active: bool, uncertain: bool) = catch_error_set_variant_branch_state(file.top_decls, "", family, family_module.module, "", file.enum_annotations, file, table)
                return (false, family, "") if not family_branch.found or family_branch.uncertain or not family_branch.active
                missing_first: mutable sview @source = ""
                while variant_index < table.enum_variant_owner.count |variant_index: usize = 0, table, missing_first, annotations, callee, catch_line, catch_offset, catch_module, function_module, declaration_line, declaration_offset, declaration_identity_id, occurrence_offset, family, family_module, family_branch, file|:
                    variant: sview = table.enum_variant_name[variant_index]
                    belongs_to_family: bool = table.enum_variant_owner[variant_index] == family and variant_index < table.enum_variant_module.count and table.enum_variant_module[variant_index] == family_module.module
                    variant_branch: (found: bool, active: bool, uncertain: bool) = catch_error_set_variant_branch_state(file.top_decls, "", family, family_module.module, variant, file.enum_annotations, file, table) if belongs_to_family else (false, false, false)
                    unique_tag: bool = catch_error_variant_table_row_is_first(table, variant_index, family, family_module.module, variant) if belongs_to_family else false
                    variant_active: bool = variant_branch.found and variant_branch.active and not variant_branch.uncertain
                    missing_first <- variant if belongs_to_family and unique_tag and variant_active and not catch_line_has_variant(annotations, callee, catch_line, catch_offset, catch_module, function_module, declaration_line, declaration_offset, declaration_identity_id, occurrence_offset, family, variant, family_module.module, file, table) and (missing_first == "" or catch_name_before(variant, missing_first))
                    variant_index <- variant_index + 1
                return (true, family_module.module, missing_first)

        def check_catch_exhaustive_rows(annotations: darray[Ast::EnumAnnotation]&, file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for tail_annotation in annotations |table|:
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.CatchArmTail, name: "", line: tail_annotation.line, expected: "", actual: ""}) if tail_annotation.name == "__catch_arm_tail"
                for annotation in annotations |table|:
                    if annotation.name == "__catch_expr" and not catch_line_has(annotations, annotation.owner, annotation.line, annotation.offset, annotation.module, "__catch_all"):
                        callee_module: (found: bool, qualifier: sview @source, offset: u32) = catch_callee_module_qualifier(annotations, annotation.owner, annotation.line, annotation.offset, annotation.module)
                        continue if not callee_module.found
                        function_declaration: (known: bool, module: sview @source, line: u32, offset: u32, identity_id: u32, occurrence_offset: u32) = catch_error_declaration_with_occurrence(annotations, annotation.owner, annotation.module, callee_module.qualifier, annotation.line, callee_module.offset)
                        continue if not function_declaration.known
                        missing_variant: mutable sview = ""
                        missing_family: mutable sview = ""
                        missing_module: mutable sview = ""
                        family_row_count: mutable usize = 0.usize()
                        for family_index in 0..<annotations.count |table, missing_variant, missing_family, missing_module, family_row_count, annotation, function_declaration, file, family_index|:
                            family_annotation: Ast::EnumAnnotation = annotations[family_index]
                            continue if family_annotation.owner != "__error_set_family" or family_annotation.line != function_declaration.line
                            continue if family_annotation.offset != function_declaration.offset
                            continue if family_annotation.identity_id != function_declaration.identity_id
                            continue if family_annotation.occurrence_offset != function_declaration.occurrence_offset
                            continue if family_index + 1.usize() >= annotations.count
                            family_path_annotation: Ast::EnumAnnotation = annotations[family_index + 1.usize()]
                            continue if family_path_annotation.owner != "__error_set_family_path" or family_path_annotation.line != family_annotation.line or family_path_annotation.offset != family_annotation.offset or family_path_annotation.identity_id != family_annotation.identity_id or family_path_annotation.occurrence_offset != function_declaration.occurrence_offset
                            family_row_count <- family_row_count + 1.usize()
                            family: sview = family_annotation.name
                            first: (known: bool, module: sview @source, variant: sview @source) = catch_family_first_missing(annotations, annotation.owner, annotation.line, annotation.offset, annotation.module, function_declaration.line, function_declaration.offset, function_declaration.identity_id, function_declaration.occurrence_offset, family, family_path_annotation.name, function_declaration.module, file, table)
                            if first.known and first.variant != "" and (missing_variant == "" or catch_error_tag_before(first.module, family, first.variant, missing_module, missing_family, missing_variant)):
                                missing_variant <- first.variant
                                missing_family <- family
                                missing_module <- first.module
                        # Older declaration producers may only have the family on their
                        # `__error_return` annotation. Keep a conservative single-family fallback.
                        if family_row_count == 0.usize():
                            family: sview = catch_error_family(annotations, annotation.owner, function_declaration.line)
                            first: (known: bool, module: sview @source, variant: sview @source) = catch_family_first_missing(annotations, annotation.owner, annotation.line, annotation.offset, annotation.module, function_declaration.line, function_declaration.offset, function_declaration.identity_id, function_declaration.occurrence_offset, family, "", function_declaration.module, file, table)
                            missing_variant <- first.variant if first.known
                            missing_family <- family if first.known
                        # Stage0 combines every missing tag into one error. Diagnostic stores
                        # source-backed pieces only, so report the first missing tag in sorted order
                        # while still checking every family in the caught union.
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.NonExhaustiveCatch, name: missing_variant, line: annotation.line, expected: missing_family, actual: ""}) if missing_variant != ""

        # Catch's parser markers retain branch identity at the catch token. Remove a
        # marker only when one enclosing branch is proven inactive; unresolved branches
        # remain visible to the conservative annotation pass.
        def catch_annotation_branch_selection(annotation: Ast::EnumAnnotation, annotations: darray[Ast::EnumAnnotation]&, file: Ast::File&, table: SymbolTable&) -> (known: bool, selected: bool):
            can Abort.Panic:
                marker_name: mutable sview = ""
                marker_detail: mutable sview = ""
                if annotation.name == "__catch_expr":
                    marker_name <- "__catch_expr_static_branch"
                    marker_detail <- annotation.owner
                elif annotation.name == "__catch_arm_tail":
                    marker_name <- "__catch_arm_tail_static_branch"
                    marker_detail <- "__catch_arm_tail"
                else:
                    return (true, true)
                found_marker: mutable bool = false
                unknown: mutable bool = false
                for marker in annotations |found_marker, unknown, annotation, file, table, marker_name, marker_detail|:
                    continue if marker.owner != "__static_if_branch" or marker.name != marker_name or marker.detail_name != marker_detail
                    continue if marker.module != annotation.module or marker.line != annotation.line or marker.offset != annotation.offset
                    found_marker <- true
                    branch: mutable (known: bool, selected: bool) = (false, false)
                    branch <- ewr_static_if_row_selection(file, marker.identity_id.usize(), annotation.module, table) if marker.identity_id != 4294967295
                    return (true, false) if branch.known and not branch.selected
                    unknown <- true if marker.identity_id == 4294967295 or not branch.known
                return (false, false) if found_marker and unknown
                return (true, true)

        # Empty ErrorSets still need their declaration to resolve a qualified family
        # path. Like enum metadata consumers, ignore a declaration only when an exact
        # metadata marker proves one enclosing static-if branch inactive. Unknown marker
        # rows remain candidates, but are projected as an uncertainty barrier below.
        # The file-shared ForeignEnum family instead reduces the branch states of every
        # closed extern-enum origin; one active producer is enough to keep the family.
        def catch_synthetic_error_set_origin_branch_selection(origin: Ast::EnumAnnotation, annotations: darray[Ast::EnumAnnotation]&, file: Ast::File&, table: SymbolTable&) -> (known: bool, active: bool):
            can Abort.Panic:
                # `offset` on both the declaration-name row and branch marker is the
                # `enum` keyword; the identifier token is kept separately in `pos.offset`.
                origin_name_rows: mutable usize = 0.usize()
                for name_row in annotations |origin_name_rows, origin|:
                    continue if name_row.owner != "__lsp_decl_name" or name_row.name != origin.detail_name or name_row.line != origin.line or name_row.offset != origin.offset
                    origin_name_rows <- origin_name_rows + 1.usize()
                return (false, false) if origin_name_rows != 1.usize()
                found_marker: mutable bool = false
                unknown: mutable bool = false
                for marker in annotations |found_marker, unknown, origin, file, table|:
                    continue if marker.owner != "__static_if_branch" or marker.name != "__nominal_type_static_branch" or marker.detail_name != origin.detail_name or marker.module != origin.module or marker.line != origin.line or marker.offset != origin.offset
                    found_marker <- true
                    if marker.identity_id == 4294967295:
                        unknown <- true
                        continue
                    branch: (known: bool, selected: bool) = ewr_static_if_row_selection(file, marker.identity_id.usize(), marker.module, table)
                    return (true, false) if branch.known and not branch.selected
                    unknown <- true if not branch.known
                return (false, false) if found_marker and unknown
                return (true, true)

        def catch_error_set_declaration_branch_selection(annotation: Ast::EnumAnnotation, annotations: darray[Ast::EnumAnnotation]&, file: Ast::File&, table: SymbolTable&) -> (known: bool, active: bool):
            can Abort.Panic:
                synthetic_marker_count: mutable usize = 0.usize()
                for marker in annotations |synthetic_marker_count, annotation|:
                    continue if marker.owner != "__error_set_synthetic" or marker.name != annotation.name or marker.module != annotation.module or marker.line != annotation.line or marker.offset != annotation.offset
                    synthetic_marker_count <- synthetic_marker_count + 1.usize()
                if synthetic_marker_count > 0.usize():
                    return (false, false) if annotation.owner != "__error_set_decl" or annotation.name != "ForeignEnum" or synthetic_marker_count != 1.usize()
                    origin_count: mutable usize = 0.usize()
                    unknown_origin: mutable bool = false
                    active_origin: mutable bool = false
                    for origin in annotations |origin_count, unknown_origin, active_origin, annotations, file, table, annotation|:
                        continue if origin.owner != "__error_set_synthetic_origin" or origin.name != annotation.name
                        origin_count <- origin_count + 1.usize()
                        origin_branch: (known: bool, active: bool) = catch_synthetic_error_set_origin_branch_selection(origin, annotations, file, table)
                        active_origin <- true if origin_branch.known and origin_branch.active
                        unknown_origin <- true if not origin_branch.known
                    return (true, true) if active_origin
                    return (false, false) if origin_count == 0.usize() or unknown_origin
                    return (true, false)
                found_marker: mutable bool = false
                unknown: mutable bool = false
                declaration_keyword_offset: mutable u32 = 0
                declaration_name_rows: mutable usize = 0
                for name_row in annotations |declaration_keyword_offset, declaration_name_rows, annotation|:
                    continue if name_row.owner != "__lsp_decl_name" or name_row.name != annotation.name or name_row.line != annotation.line or name_row.pos.offset != annotation.offset
                    declaration_keyword_offset <- name_row.offset
                    declaration_name_rows <- declaration_name_rows + 1.usize()
                return (false, false) if declaration_name_rows != 1.usize()
                for marker in annotations |found_marker, unknown, annotation, file, table, declaration_keyword_offset|:
                    continue if marker.owner != "__static_if_branch" or marker.name != "__nominal_type_static_branch" or marker.detail_name != annotation.name or marker.module != annotation.module or marker.line != annotation.line or marker.offset != declaration_keyword_offset
                    found_marker <- true
                    if marker.identity_id == 4294967295:
                        unknown <- true
                        continue
                    branch: (known: bool, selected: bool) = ewr_static_if_row_selection(file, marker.identity_id.usize(), marker.module, table)
                    return (true, false) if branch.known and not branch.selected
                    unknown <- true if not branch.known
                return (false, false) if found_marker and unknown
                return (true, true)

        # Remove aliases whose static-if arm is definitely inactive. Retain an explicit
        # barrier for unresolved arms so they cannot supply a speculative module path.
        def catch_active_alias_annotations(file: Ast::File&, table: SymbolTable&) -> darray[Ast::EnumAnnotation]:
            can Memory.Allocate, Abort.Panic:
                active: mutable darray[Ast::EnumAnnotation] = []
                for annotation in file.enum_annotations |active, file, table|:
                    if annotation.name == "__catch_expr" or annotation.name == "__catch_arm_tail":
                        branch: (known: bool, selected: bool) = catch_annotation_branch_selection(annotation, file.enum_annotations, file, table)
                        continue if branch.known and not branch.selected
                    if annotation.owner == "__error_set_decl":
                        branch: (known: bool, active: bool) = catch_error_set_declaration_branch_selection(annotation, file.enum_annotations, file, table)
                        continue if branch.known and not branch.active
                        if not branch.known:
                            active.push(Ast::EnumAnnotation{owner: "__catch_unknown_error_set_decl", name: annotation.name, module: annotation.module, line: annotation.line, offset: annotation.offset, identity_id: annotation.identity_id})
                            continue
                    if annotation.name == "__using_alias":
                        branch: (known: bool, active: bool) = ewr_static_import_annotation_selection(annotation, file.enum_annotations, file, table)
                        continue if branch.known and not branch.active
                        if not branch.known:
                            active.push(Ast::EnumAnnotation{owner: "__catch_unknown_static_alias", name: annotation.owner, module: annotation.module, line: annotation.line, offset: annotation.offset})
                    active.push(annotation)
                return active

    public:
        def check_catch_exhaustive(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                annotations: mutable darray[Ast::EnumAnnotation] = catch_active_alias_annotations(file, table)
                table <- check_catch_exhaustive_rows(annotations, file, table)
