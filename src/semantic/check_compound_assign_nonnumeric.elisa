# Check for augmented (compound) assignments (`+=`, `-=`, `*=`, `/=`, `%=`, `<<=`, `>>=`,
# `&=`, `|=`, `^=`) where the target or the value is firmly non-numeric (Bool or String).
# Sound: only fires on firm Bool/String (kind_is_firm_non_numeric); Int/Float/Char/Unknown/Named
# never fire — Unknown is bottom, Named may have an operator overload.

extend Semantic:
    private:
        def collection_append_element_id(target: Ast::Expr, operator: TokenKind, names: darray[sview]&, types: darray[sview]&, table: SymbolTable&) -> u32:
            can Abort.Panic, Memory.Allocate:
                return 0 if operator != TokenKind.PlusEq
                target_id: mutable u32 = structural_type_id_of(target, names, types, table)
                while interned_kind(target_id, table) == SemTypeKind.Ref:
                    target_id <- interned_elem(target_id, 0, table)
                return interned_elem(target_id, 0, table) if interned_kind(target_id, table) == SemTypeKind.Container and interned_name(target_id, table) == "darray"
                return 0

        # Growth/lifetime analyses share the existing push semantics. This is an
        # analysis expression only: the backend evaluates the target just once.
        def collection_append_call(target: Ast::Expr, value: Ast::Expr, pos: Ast::Pos) -> Ast::Expr:
            return Ast::Expr.Call(Ast::Expr.Field(target, "push", pos), [value], [], pos)

        # Whether an operator token is one of the arithmetic compound-assignment operators.
        def is_compound_assign_operator(operator: TokenKind) -> bool:
            can Abort.Panic:
                return when operator:
                    TokenKind.PlusEq | TokenKind.MinusEq | TokenKind.StarEq | TokenKind.SlashEq | TokenKind.PercentEq | TokenKind.LShiftEq | TokenKind.RShiftEq | TokenKind.AmpEq | TokenKind.PipeEq | TokenKind.CaretEq -> true
                    _ -> false

        # Walk through expressions, recursing into sub-expressions (this check has no
        # expression-level logic of its own — the compound-assign check lives in the
        # statement walker — but we still need a full expression walk for nested blocks/
        # lambdas/matches that may themselves contain compound assignments).
        def walk_expression_for_compound_assign(expression: Ast::Expr, table: lmut SymbolTable, var_types: mutable darray[sview]&, type_names: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Binary(left, operator, right, line):
                        table <- walk_expression_for_compound_assign(left, table, var_types, type_names)
                        table <- walk_expression_for_compound_assign(right, table, var_types, type_names) if operator != TokenKind.Is and operator != TokenKind.As
                    Expr.Call(callee, arguments, argument_names, line):
                        table <- walk_expression_for_compound_assign(callee, table, var_types, type_names)
                        for argument in arguments |table|:
                            table <- walk_expression_for_compound_assign(argument, table, var_types, type_names)
                    Expr.Field(object, field, line):
                        table <- walk_expression_for_compound_assign(object, table, var_types, type_names)
                    Expr.Scope(base, name, line):
                        table <- walk_expression_for_compound_assign(base, table, var_types, type_names)
                    Expr.Index(object, index, line):
                        table <- walk_expression_for_compound_assign(object, table, var_types, type_names)
                        table <- walk_expression_for_compound_assign(index, table, var_types, type_names) if not index_receiver_is_type_application(object)
                    Expr.Unary(operator, operand, line):
                        table <- walk_expression_for_compound_assign(operand, table, var_types, type_names)
                    Expr.Paren(inner, line):
                        table <- walk_expression_for_compound_assign(inner, table, var_types, type_names)
                    Expr.Array(elements, line):
                        for element in elements |table|:
                            table <- walk_expression_for_compound_assign(element, table, var_types, type_names)
                    Expr.Tuple(elements, line):
                        for element in elements |table|:
                            table <- walk_expression_for_compound_assign(element, table, var_types, type_names)
                    Expr.Slice(object, low, high, line):
                        table <- walk_expression_for_compound_assign(object, table, var_types, type_names)
                        table <- walk_expression_for_compound_assign(low, table, var_types, type_names)
                        table <- walk_expression_for_compound_assign(high, table, var_types, type_names)
                    Expr.IndexN(object, arguments, line):
                        table <- walk_expression_for_compound_assign(object, table, var_types, type_names)
                        for argument in arguments |table|:
                            table <- walk_expression_for_compound_assign(argument, table, var_types, type_names) if not index_receiver_is_type_application(object)
                    Expr.SetLit(elements, line):
                        for element in elements |table|:
                            table <- walk_expression_for_compound_assign(element, table, var_types, type_names)
                    Expr.DictLit(entries, line):
                        for entry in entries |table|:
                            table <- walk_expression_for_compound_assign(entry.key, table, var_types, type_names)
                            table <- walk_expression_for_compound_assign(entry.value, table, var_types, type_names)
                    Expr.Construct(type_expression, fields, line):
                        table <- walk_expression_for_compound_assign(type_expression, table, var_types, type_names)
                        for field in fields |table|:
                            table <- walk_expression_for_compound_assign(field.value, table, var_types, type_names)
                    Expr.RecordUpdate(base, fields, line):
                        table <- walk_expression_for_compound_assign(base, table, var_types, type_names)
                        for field in fields |table|:
                            table <- walk_expression_for_compound_assign(field.value, table, var_types, type_names)
                    Expr.If(condition, then_expr, else_expr, line):
                        table <- walk_expression_for_compound_assign(condition, table, var_types, type_names)
                        table <- walk_expression_for_compound_assign(then_expr, table, var_types, type_names)
                        table <- walk_expression_for_compound_assign(else_expr, table, var_types, type_names)
                    Expr.Comprehension(loop_variable, iterable, condition, body, line):
                        table <- walk_expression_for_compound_assign(iterable, table, var_types, type_names)
                        table <- walk_expression_for_compound_assign(condition, table, var_types, type_names)
                        table <- walk_expression_for_compound_assign(body, table, var_types, type_names)
                    Expr.Lambda(parameters, body, line):
                        table <- walk_statements_for_compound_assign(body, table, var_types, type_names)
                    Expr.Block(statements, value, captures, line):
                        table <- walk_statements_for_compound_assign(statements, table, var_types, type_names)
                        table <- walk_expression_for_compound_assign(value, table, var_types, type_names)
                    Expr.Match(scrutinee, arms, line):
                        table <- walk_expression_for_compound_assign(scrutinee, table, var_types, type_names)
                        for arm in arms |table|:
                            table <- walk_statements_for_compound_assign(arm.body, table, var_types, type_names)
                    # Literals and other expressions don't contain relevant sub-expressions
                    _:
                        pass

        # Walk through statements, tracking variable types and checking compound assignments.
        def walk_statements_for_compound_assign(statements: darray[Ast::Stmt], table: lmut SymbolTable, var_types: mutable darray[sview]&, type_names: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table|:
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- walk_expression_for_compound_assign(expression, table, var_types, type_names)
                        Stmt.VarDecl(name, type_expression, value, line):
                            type_name: sview = region_escape_type_head_name(type_expression)
                            note_local_type(var_types, type_names, name, type_name)
                            note_local_type_id(name, type_expression, table)
                            table <- walk_expression_for_compound_assign(value, table, var_types, type_names)
                        Stmt.Assign(target, operator, value, line):
                            # A Named target may have an overloaded operator (e.g. __add__)
                            # that legitimately accepts a non-numeric RHS — never flag either
                            # side of a compound assign whose target is a user type.
                            target_type: Semantic::InferType = infer_expression_type(target, var_types, type_names, table)
                            value_type: Semantic::InferType = infer_expression_type(value, var_types, type_names, table)
                            append_element: u32 = collection_append_element_id(target, operator, var_types, type_names, table)
                            collection_append: bool = append_element != 0
                            if collection_append:
                                append_value_id: u32 = structural_type_id_of(value, var_types, type_names, table)
                                append_bad_literal: bool = literal_never_fits(literal_kind_of(value), interned_name(append_element, table))
                                append_bad_shape: bool = (value is Expr.Array) and interned_kind(append_element, table) != SemTypeKind.Container
                                append_bad_type: bool = append_value_id != 0 and not type_ids_compatible(append_element, append_value_id, table)
                                if append_bad_literal or append_bad_shape or append_bad_type:
                                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.NamedTypeMismatch, name: "darray += element", pos: line, line: line.line, expected: interned_name(append_element, table), actual: interned_name(append_value_id, table)})
                            known_overload_free_target: bool = target_type.kind != SemTypeKind.Unknown and target_type.kind != SemTypeKind.Named
                            # ONE report per operator: a non-numeric VALUE assigned into a
                            # non-numeric TARGET is one error, and stage0 reports it once.
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.CompoundAssignNonNumeric, name: "", pos: Ast::expr_pos(target), line: line.line, expected: "", actual: ""}) if not collection_append and known_overload_free_target and is_compound_assign_operator(operator) and (kind_is_firm_non_numeric(value_type) or kind_is_firm_non_numeric(target_type))
                            table <- walk_expression_for_compound_assign(target, table, var_types, type_names)
                            table <- walk_expression_for_compound_assign(value, table, var_types, type_names)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- walk_expression_for_compound_assign(condition, table, var_types, type_names)
                            table <- walk_statements_for_compound_assign(then_body, table, var_types, type_names)
                            table <- walk_statements_for_compound_assign(else_body, table, var_types, type_names)
                        Stmt.While(condition, body, line):
                            table <- walk_expression_for_compound_assign(condition, table, var_types, type_names)
                            table <- walk_statements_for_compound_assign(body, table, var_types, type_names)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- walk_expression_for_compound_assign(iterable, table, var_types, type_names)
                            table <- walk_statements_for_compound_assign(body, table, var_types, type_names)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- walk_statements_for_compound_assign(body, table, var_types, type_names)
                        Stmt.Match(scrutinee, arms, line):
                            table <- walk_expression_for_compound_assign(scrutinee, table, var_types, type_names)
                            for arm in arms |table|:
                                table <- walk_expression_for_compound_assign(arm.guard, table, var_types, type_names)
                                table <- walk_statements_for_compound_assign(arm.body, table, var_types, type_names)
                        Stmt.Return(value, line):
                            table <- walk_expression_for_compound_assign(return_value, table, var_types, type_names) if value is return_value
                        Stmt.Contract(kind, expression, line):
                            table <- walk_expression_for_compound_assign(expression, table, var_types, type_names)
                        Stmt.Invalid:
                            pass
                        Stmt.Break(label, line):
                            pass
                        Stmt.Continue(label, line):
                            pass

        # Walk through function declarations.
        def check_compound_assign_nonnumeric_declarations(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table|:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            # The structural channel is per-function and resolve left it
                            # holding the LAST function's locals; without this re-seed
                            # `collection_append_element_id` cannot see that `values` is a
                            # darray and a plain append reads as arithmetic on a container.
                            seed_local_type_ids(params, table)
                            var_types: mutable darray[sview] = []
                            type_names: mutable darray[sview] = []
                            for param in params |table|:
                                param_type: sview = region_escape_type_head_name(param.type_expression)
                                note_local_type(var_types, type_names, param.name, param_type)
                            table <- walk_statements_for_compound_assign(body, table, var_types, type_names)
                        Decl.Module(module_name, body, line):
                            table <- check_compound_assign_nonnumeric_declarations(body, table)
                        Decl.Scoped(body, line):
                            table <- check_compound_assign_nonnumeric_declarations(body, table)
                        _:
                            pass

    public:
        # Public entry point for the check.
        def check_compound_assign_nonnumeric(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- check_compound_assign_nonnumeric_declarations(declarations, table)
