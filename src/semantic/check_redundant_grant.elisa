# Redundant effect grant (stage0 warnOnRedundantLocalGrant). A `can E1, E2:` block whose every
# effect is already granted by an enclosing `can` block (or the function signature) is redundant.
# SOUND syntactic subset: thread the set of granted effect names (seeded from the signature
# `can[...]` list, grown at each `can` block); a `can` block whose whole clause is already in the
# set is flagged. Effect names are compared verbatim, so a family-level grant covering a member
# (`Atomics` vs `Atomics.Load`) or a `can[any]` grant is a sound miss, never a false positive.
extend Semantic:
    private:
        def granted_effect_present(granted: darray[sview]&, wanted: sview) -> bool:
            can Abort.Panic:
                return any effect in granted where effect == wanted

        # Whether every effect in CLAUSE is already in GRANTED (and the clause is non-empty).
        def clause_fully_granted(clause: darray[sview]&, granted: darray[sview]&) -> bool:
            can Abort.Panic:
                false return if clause.count == 0
                while index < clause.count |index: usize = 0|:
                    false return if not granted_effect_present(granted, clause[index])
                    index <- index + 1
                return true

        def redundant_grant_walk(statements: darray[Ast::Stmt], granted: darray[sview], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Block(kind, clause, binding, body, line):
                            if kind == "can":
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.RedundantEffectGrant, name: clause[0] if clause.count > 0 else sview("", 0, 0), line: line.line, expected: "", actual: ""}) if clause_fully_granted(clause, granted)
                                inner_granted: mutable darray[sview] = []
                                inner_granted.extend(granted)
                                inner_granted.extend(clause)
                                table <- redundant_grant_walk(body, inner_granted, table)
                            else:
                                table <- redundant_grant_walk(body, granted, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- redundant_grant_walk(then_body, granted, table)
                            table <- redundant_grant_walk(else_body, granted, table)
                        Stmt.While(condition, body, line):
                            table <- redundant_grant_walk(body, granted, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- redundant_grant_walk(body, granted, table)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |table| -> table:
                                table <- redundant_grant_walk(arm.body, granted, table)
                        _:
                            pass

        def check_redundant_grant(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            # stage0 seeds the granted set EMPTY (a signature grant is not counted
                            # for block-redundancy — only enclosing `can` blocks are).
                            empty_granted: darray[sview] = []
                            table <- redundant_grant_walk(body, empty_granted, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- check_redundant_grant(module_body, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- check_redundant_grant(scoped_body, table)
                        _:
                            pass
