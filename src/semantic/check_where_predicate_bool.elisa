# A `where` refinement predicate must be a bool expression. `n: i64 where 1` — a predicate that
# is a numeric literal or a bare arithmetic expression is definitely not bool and is rejected:
# "where refinement predicate must be bool, got int (subject type is i64); …". SOUND subset: fires
# only on an IntLit/FloatLit/arithmetic predicate; a comparison, logical op, `is` test, call, or
# any non-literal reference is bool-or-unknown (a conservative miss). Scans every type position
# (param, return, local, struct field), descending into nested type applications.
extend Semantic:
    private:
        # Descend a type expression, flagging any `where` refinement whose predicate is non-bool.
        def where_scan_type(type_expression: Ast::Expr, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match type_expression:
                    Expr.Refinement(base, predicate, line):
                        family: sview = assert_nonbool_family(predicate)
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.WhereRefinementNonBool, name: "", line: line.line, expected: bare_type_name(base), actual: family}) if family != ""
                        table <- where_scan_type(base, table)
                    Expr.Index(head, argument, index_line):
                        table <- where_scan_type(head, table)
                        table <- where_scan_type(argument, table)
                    Expr.IndexN(head, arguments, index_n_line):
                        table <- where_scan_type(head, table)
                        for argument in arguments |table| -> table:
                            table <- where_scan_type(argument, table)
                    Expr.Unary(operator, operand, unary_line):
                        table <- where_scan_type(operand, table)
                    Expr.Paren(inner, paren_line):
                        table <- where_scan_type(inner, table)
                    _:
                        pass

        def where_scan_statements(statements: darray[Ast::Stmt], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- where_scan_type(type_expression, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- where_scan_statements(then_body, table)
                            table <- where_scan_statements(else_body, table)
                        Stmt.While(condition, body, line):
                            table <- where_scan_statements(body, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- where_scan_statements(body, table)
                        Stmt.Block(block_kind, clause, binding, body, line):
                            table <- where_scan_statements(body, table)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |table| -> table:
                                table <- where_scan_statements(arm.body, table)
                        _:
                            pass

        def check_where_predicate_bool_decls(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            for parameter in params |table| -> table:
                                table <- where_scan_type(parameter.type_expression, table)
                            if return_type is declared_return:
                                table <- where_scan_type(declared_return, table)
                            table <- where_scan_statements(body, table)
                        Decl.Struct(struct_name, members, affinity, has_named_states, has_derive, invariants, struct_line):
                            for member in members |table| -> table:
                                table <- where_scan_type(member.type_expression, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- check_where_predicate_bool_decls(module_body, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- check_where_predicate_bool_decls(scoped_body, table)
                        _:
                            pass

    public:
        def check_where_predicate_bool(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- check_where_predicate_bool_decls(declarations, table)
