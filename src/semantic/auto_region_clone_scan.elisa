# A clone call anywhere in a function body makes stage0 wrap that body in its automatic region
# (parserregionscan.isCloneCallSyntax): clone allocates its copy region-lessly, like a container
# literal. Every spelling counts -- `clone[T](x)`, `clone(x)` and `x.clone()` -- because the scan
# is syntactic and runs before any name resolution. auto_region_function_body_is_wrapped calls
# this so `-emit ast` statement counts and the literal-region checks see the same wrap.

def auto_region_is_clone_call(callee: Ast::Expr, argument_count: usize) -> bool:
    match callee:
        Expr.Index(clone_head, clone_type, clone_pos):
            return auto_region_is_clone_call(clone_head, argument_count)
        Expr.IndexN(clone_head_n, clone_types, clone_pos_n):
            return auto_region_is_clone_call(clone_head_n, argument_count)
        Expr.Ident(clone_name, clone_name_pos):
            return clone_name == "clone" and argument_count == 1
        Expr.Field(clone_receiver, clone_field, clone_field_pos):
            return clone_field == "clone" and argument_count == 0
        _:
            return false

def auto_region_expr_has_clone(expression: Ast::Expr) -> bool:
    match expression:
        Expr.Call(callee, arguments, argument_names, call_pos):
            return true if auto_region_is_clone_call(callee, arguments.count)
            return true if auto_region_expr_has_clone(callee)
            return any argument in arguments where auto_region_expr_has_clone(argument)
        Expr.Field(object, field, field_pos):
            return auto_region_expr_has_clone(object)
        Expr.Index(object, index, index_pos):
            return auto_region_expr_has_clone(object) or auto_region_expr_has_clone(index)
        Expr.Binary(left, binary_operator, right, binary_pos):
            return auto_region_expr_has_clone(left) or auto_region_expr_has_clone(right)
        Expr.Unary(unary_operator, operand, unary_pos):
            return auto_region_expr_has_clone(operand)
        Expr.Paren(inner, paren_pos):
            return auto_region_expr_has_clone(inner)
        Expr.Move(operand, move_pos):
            return auto_region_expr_has_clone(operand)
        Expr.If(condition, then_value, else_value, if_pos):
            return auto_region_expr_has_clone(condition) or auto_region_expr_has_clone(then_value) or auto_region_expr_has_clone(else_value)
        Expr.Array(elements, array_pos) | Expr.Tuple(elements, array_pos):
            return any element in elements where auto_region_expr_has_clone(element)
        Expr.Construct(type_expression, fields, construct_pos):
            return any field in fields where auto_region_expr_has_clone(field.value)
        Expr.Block(statements, value, captures, block_pos):
            return auto_region_statements_have_clone(statements) or auto_region_expr_has_clone(value)
        _:
            return false

def auto_region_statements_have_clone(statements: darray[Ast::Stmt]&) -> bool:
    for statement in statements:
        match statement:
            Stmt.Expr(expression, line):
                return true if auto_region_expr_has_clone(expression)
            Stmt.VarDecl(_, _, value, _):
                return true if auto_region_expr_has_clone(value)
            Stmt.Assign(target, assign_operator, value, line):
                return true if auto_region_expr_has_clone(value)
            Stmt.Return(value, line):
                return true if value is returned and auto_region_expr_has_clone(returned)
            Stmt.If(condition, then_body, else_body, if_line):
                return true if auto_region_expr_has_clone(condition) or auto_region_statements_have_clone(then_body) or auto_region_statements_have_clone(else_body)
            Stmt.While(condition, while_body, while_line):
                return true if auto_region_expr_has_clone(condition) or auto_region_statements_have_clone(while_body)
            Stmt.For(bind, variables, iterable, for_body, for_line):
                return true if auto_region_expr_has_clone(iterable) or auto_region_statements_have_clone(for_body)
            Stmt.Block(block_kind, clause, binding, body, block_line):
                return true if auto_region_statements_have_clone(body)
            Stmt.Match(scrutinee, arms, match_line):
                return true if auto_region_expr_has_clone(scrutinee)
                return true if any arm in arms where auto_region_statements_have_clone(arm.body)
            _:
                pass
    return false
