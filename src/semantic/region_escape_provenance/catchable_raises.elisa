extend Semantic:
    private:
        def region_escape_provenance_catchable_raise(expression: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                empty_catch_lines: darray[u32] @source = []
                region_escape_provenance_catchable_raise_with_metadata(expression, empty_catch_lines)


        def region_escape_provenance_catchable_raise_with_metadata(expression: Ast::Expr, catch_match_lines: darray[u32]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                return match expression:
                    Expr.Call(callee, arguments, _, _):
                        direct_raise_callee: bool = region_escape_provenance_catchable_raise_callee(callee)
                        return true if region_escape_provenance_catchable_raise_with_metadata(callee, catch_match_lines)
                        return false if not region_escape_provenance_abort_callee(callee) and region_escape_provenance_expression_terminates(callee)
                        argument_facts: (reaches_end: bool, found_raise: bool) = region_escape_provenance_catchable_raise_sequence_with_metadata(arguments, catch_match_lines)
                        argument_facts.found_raise or (argument_facts.reaches_end and direct_raise_callee)
                    Expr.StaticEffectCall(_, _, candidates, arguments, _, _):
                        runtime_children: darray[Ast::Expr] = Ast::effect_runtime_children(candidates, arguments)
                        region_escape_provenance_catchable_raise_sequence_with_metadata(runtime_children, catch_match_lines).found_raise
                    Expr.If(condition, then_value, else_value, _):
                        return true if region_escape_provenance_catchable_raise_with_metadata(condition, catch_match_lines)
                        return false if region_escape_provenance_expression_terminates(condition)
                        literal: (known: bool, value: bool) = region_escape_provenance_literal_bool(condition)
                        if literal.known:
                            return region_escape_provenance_catchable_raise_with_metadata(then_value, catch_match_lines) if literal.value
                            return region_escape_provenance_catchable_raise_with_metadata(else_value, catch_match_lines)
                        region_escape_provenance_catchable_raise_with_metadata(then_value, catch_match_lines) or region_escape_provenance_catchable_raise_with_metadata(else_value, catch_match_lines)
                    Expr.Match(scrutinee, arms, _):
                        return true if region_escape_provenance_catchable_raise_with_metadata(scrutinee, catch_match_lines)
                        return false if region_escape_provenance_expression_terminates(scrutinee)
                        region_escape_provenance_catchable_raise_match_arms_with_metadata(scrutinee, arms, catch_match_lines)
                    Expr.Block(statements, value, _, _):
                        return true if region_escape_provenance_catchable_raise_statements_with_metadata(statements, catch_match_lines)
                        return false if region_escape_provenance_statements_terminate_with_metadata(statements, catch_match_lines)
                        region_escape_provenance_catchable_raise_with_metadata(value, catch_match_lines)
                    Expr.Paren(inner, _) | Expr.Unary(_, inner, _) | Expr.Move(inner, _) | Expr.RegionNew(inner, _, _):
                        region_escape_provenance_catchable_raise_with_metadata(inner, catch_match_lines)
                    Expr.Binary(left, operator, right, _):
                        return true if region_escape_provenance_catchable_raise_with_metadata(left, catch_match_lines)
                        return false if region_escape_provenance_expression_terminates(left)
                        right_required: mutable bool = operator != TokenKind.And and operator != TokenKind.Or
                        literal: (known: bool, value: bool) = region_escape_provenance_literal_bool(left)
                        right_required <- not literal.known or literal.value if operator == TokenKind.And
                        right_required <- not literal.known or not literal.value if operator == TokenKind.Or
                        right_required and region_escape_provenance_catchable_raise_with_metadata(right, catch_match_lines)
                    Expr.Field(object, _, _) | Expr.Scope(object, _, _):
                        region_escape_provenance_catchable_raise_with_metadata(object, catch_match_lines)
                    Expr.Index(object, index, _):
                        return true if region_escape_provenance_catchable_raise_with_metadata(object, catch_match_lines)
                        return false if region_escape_provenance_expression_terminates(object)
                        region_escape_provenance_catchable_raise_with_metadata(index, catch_match_lines)
                    Expr.IndexN(object, indices, _):
                        return true if region_escape_provenance_catchable_raise_with_metadata(object, catch_match_lines)
                        return false if region_escape_provenance_expression_terminates(object)
                        region_escape_provenance_catchable_raise_sequence_with_metadata(indices, catch_match_lines).found_raise
                    Expr.Slice(object, low, high, _):
                        return true if region_escape_provenance_catchable_raise_with_metadata(object, catch_match_lines)
                        return false if region_escape_provenance_expression_terminates(object)
                        return true if region_escape_provenance_catchable_raise_with_metadata(low, catch_match_lines)
                        return false if region_escape_provenance_expression_terminates(low)
                        region_escape_provenance_catchable_raise_with_metadata(high, catch_match_lines)
                    Expr.Array(elements, _) | Expr.Tuple(elements, _) | Expr.SetLit(elements, _):
                        region_escape_provenance_catchable_raise_sequence_with_metadata(elements, catch_match_lines).found_raise
                    Expr.DictLit(entries, _):
                        for entry in entries:
                            return true if region_escape_provenance_catchable_raise_with_metadata(entry.key, catch_match_lines)
                            return false if region_escape_provenance_expression_terminates(entry.key)
                            return true if region_escape_provenance_catchable_raise_with_metadata(entry.value, catch_match_lines)
                            return false if region_escape_provenance_expression_terminates(entry.value)
                        return false
                    Expr.Construct(_, fields, _):
                        region_escape_provenance_catchable_raise_field_values_with_metadata(fields, catch_match_lines)
                    Expr.RecordUpdate(base, fields, _):
                        return true if region_escape_provenance_catchable_raise_with_metadata(base, catch_match_lines)
                        return false if region_escape_provenance_expression_terminates(base)
                        region_escape_provenance_catchable_raise_field_values_with_metadata(fields, catch_match_lines)
                    Expr.GetElse(guarded, recovery, _):
                        return true if region_escape_provenance_catchable_raise_with_metadata(guarded, catch_match_lines)
                        return false if region_escape_provenance_expression_terminates(guarded)
                        region_escape_provenance_catchable_raise_statements_with_metadata(recovery, catch_match_lines)
                    Expr.Catch(guarded, arms, _):
                        guarded_aborts: bool = region_escape_provenance_expression_terminates(guarded)
                        guarded_may_raise: bool = region_escape_provenance_catchable_raise_with_metadata(guarded, catch_match_lines)
                        return false if guarded_aborts and not guarded_may_raise
                        errors_handled: mutable bool = false
                        arm_index: mutable usize = 0.usize()
                        while arm_index < arms.count |arm_index, arms, guarded_aborts, guarded_may_raise, errors_handled|:
                            arm: Ast::MatchArm = arms[arm_index]
                            arm_reachable: mutable bool = region_escape_provenance_catch_arm_reachable(arms, arm_index)
                            arm_reachable <- false if guarded_aborts and arm_index == 0
                            arm_reachable <- false if arm_index > 0 and not guarded_may_raise
                            if arm_reachable:
                                return true if region_escape_provenance_catchable_raise_with_metadata(arm.guard, catch_match_lines)
                                guard_bool: (known: bool, value: bool) = region_escape_provenance_literal_bool(arm.guard)
                                if not (arm.guard is Ast::Expr.Absent):
                                    if (guard_bool.known and not guard_bool.value) or region_escape_provenance_expression_terminates(arm.guard):
                                        arm_index <- arm_index + 1.usize()
                                        continue
                                return true if region_escape_provenance_catchable_raise_statements_with_metadata(arm.body, catch_match_lines)
                                errors_handled <- true if arm_index > 0 and (arm.guard is Ast::Expr.Absent or (guard_bool.known and guard_bool.value)) and region_escape_provenance_pattern_is_error_catchall(arm.pattern)
                            arm_index <- arm_index + 1.usize()
                        guarded_may_raise and not errors_handled
                    Expr.Comprehension(_, iterable, condition, body, _, _):
                        return true if region_escape_provenance_catchable_raise_with_metadata(iterable, catch_match_lines)
                        return false if region_escape_provenance_expression_terminates(iterable)
                        return true if region_escape_provenance_catchable_raise_with_metadata(condition, catch_match_lines)
                        return false if region_escape_provenance_expression_terminates(condition)
                        condition_bool: (known: bool, value: bool) = region_escape_provenance_literal_bool(condition)
                        return false if condition_bool.known and not condition_bool.value
                        region_escape_provenance_catchable_raise_with_metadata(body, catch_match_lines)
                    Expr.Refinement(base, predicate, _):
                        return true if region_escape_provenance_catchable_raise_with_metadata(base, catch_match_lines)
                        return false if region_escape_provenance_expression_terminates(base)
                        region_escape_provenance_catchable_raise_with_metadata(predicate, catch_match_lines)
                    _:
                        false


        def region_escape_provenance_pattern_is_error_catchall(pattern: Ast::Pattern) -> bool:
            can Abort.Panic:
                match pattern:
                    Pattern.Wildcard:
                        return true
                    Pattern.TypeBind(type_name, _):
                        return type_name == "error"
                    Pattern.Or(options):
                        return any option in options where region_escape_provenance_pattern_is_error_catchall(option)
                    Pattern.As(_, inner):
                        return any wrapped in inner where region_escape_provenance_pattern_is_error_catchall(wrapped)
                    _:
                        return false


        def region_escape_provenance_catch_error_arms_terminate(arms: darray[Ast::MatchArm]) -> bool:
            can Memory.Allocate, Abort.Panic:
                return false if arms.count < 2
                for arm_index in 1..<arms.count:
                    arm: Ast::MatchArm = arms[arm_index]
                    guard: (known: bool, value: bool) = region_escape_provenance_literal_bool(arm.guard)
                    continue if guard.known and not guard.value
                    return false if not region_escape_provenance_statements_terminate(arm.body)
                    unconditional: bool = arm.guard is Ast::Expr.Absent or (guard.known and guard.value)
                    return true if unconditional and region_escape_provenance_pattern_is_error_catchall(arm.pattern)
                return false



        # Whether an expression or statement must leave its current block/function before
        # normal continuation. This syntax-level walk follows eager children and literal
        # branches; unknown calls remain fallthrough because their callee may be shadowed.
        def region_escape_provenance_expression_terminates(expression: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                return match expression:
                    Expr.Ident(_, _): false
                    Expr.Paren(inner, _) | Expr.Unary(_, inner, _) | Expr.Move(inner, _) | Expr.RegionNew(inner, _, _):
                        region_escape_provenance_expression_terminates(inner)
                    Expr.Call(callee, arguments, _, _):
                        region_escape_provenance_abort_callee(callee) or region_escape_provenance_expression_terminates(callee) or any argument in arguments where region_escape_provenance_expression_terminates(argument)
                    Expr.StaticEffectCall(_, _, candidates, arguments, _, _):
                        runtime_children: darray[Ast::Expr] = Ast::effect_runtime_children(candidates, arguments)
                        any child in runtime_children where region_escape_provenance_expression_terminates(child)
                    Expr.Binary(left, operator, right, _):
                        left_terminates: bool = region_escape_provenance_expression_terminates(left)
                        return true if left_terminates
                        right_required: mutable bool = operator != TokenKind.And and operator != TokenKind.Or
                        literal: (known: bool, value: bool) = region_escape_provenance_literal_bool(left)
                        right_required <- literal.known and ((operator == TokenKind.And and literal.value) or (operator == TokenKind.Or and not literal.value)) if operator == TokenKind.And or operator == TokenKind.Or
                        right_required and region_escape_provenance_expression_terminates(right)
                    Expr.Block(statements, value, _, _):
                        region_escape_provenance_statements_terminate(statements) or region_escape_provenance_expression_terminates(value)
                    Expr.If(condition, then_value, else_value, _):
                        return true if region_escape_provenance_expression_terminates(condition)
                        literal: (known: bool, value: bool) = region_escape_provenance_literal_bool(condition)
                        if literal.known:
                            return region_escape_provenance_expression_terminates(then_value) if literal.value
                            return region_escape_provenance_expression_terminates(else_value)
                        region_escape_provenance_expression_terminates(then_value) and region_escape_provenance_expression_terminates(else_value)
                    Expr.Match(scrutinee, arms, _):
                        region_escape_provenance_expression_terminates(scrutinee) or region_escape_provenance_match_arms_terminate(scrutinee, arms)
                    Expr.Field(object, _, _) | Expr.Scope(object, _, _):
                        region_escape_provenance_expression_terminates(object)
                    Expr.Index(object, index, _):
                        region_escape_provenance_expression_terminates(object) or region_escape_provenance_expression_terminates(index)
                    Expr.IndexN(object, indices, _):
                        region_escape_provenance_expression_terminates(object) or any index in indices where region_escape_provenance_expression_terminates(index)
                    Expr.Slice(object, low, high, _):
                        region_escape_provenance_expression_terminates(object) or region_escape_provenance_expression_terminates(low) or region_escape_provenance_expression_terminates(high)
                    Expr.Array(elements, _) | Expr.Tuple(elements, _) | Expr.SetLit(elements, _):
                        any element in elements where region_escape_provenance_expression_terminates(element)
                    Expr.DictLit(entries, _):
                        any entry in entries where region_escape_provenance_expression_terminates(entry.key) or region_escape_provenance_expression_terminates(entry.value)
                    Expr.Construct(_, fields, _):
                        any field in fields where region_escape_provenance_expression_terminates(field.value)
                    Expr.RecordUpdate(base, fields, _):
                        region_escape_provenance_expression_terminates(base) or any field in fields where region_escape_provenance_expression_terminates(field.value)
                    Expr.GetElse(guarded, _, _):
                        region_escape_provenance_expression_terminates(guarded)
                    Expr.Catch(guarded, arms, _):
                        guarded_terminates: bool = region_escape_provenance_expression_terminates(guarded)
                        catchable_raise: bool = region_escape_provenance_catchable_raise(guarded)
                        if guarded_terminates:
                            return true if not catchable_raise
                            region_escape_provenance_catch_error_arms_terminate(arms)
                        arms.count > 0 and region_escape_provenance_statements_terminate(arms[0].body) and region_escape_provenance_catch_error_arms_terminate(arms)
                    Expr.Comprehension(_, iterable, _, _, _, _):
                        region_escape_provenance_expression_terminates(iterable)
                    Expr.Refinement(left, right, _):
                        region_escape_provenance_expression_terminates(left) or region_escape_provenance_expression_terminates(right)
                    _:
                        false


        def region_escape_provenance_statement_terminates(statement: Ast::Stmt) -> bool:
            can Memory.Allocate, Abort.Panic:
                return match statement:
                    Stmt.Return(_, _) | Stmt.Break(_, _) | Stmt.Continue(_, _): true
                    Stmt.Expr(expression, _): region_escape_provenance_expression_terminates(expression)
                    Stmt.VarDecl(_, _, value, _): region_escape_provenance_expression_terminates(value)
                    Stmt.Assign(target, _, value, _): region_escape_provenance_expression_terminates(target) or region_escape_provenance_expression_terminates(value)
                    Stmt.If(condition, then_body, else_body, _):
                        return true if region_escape_provenance_expression_terminates(condition)
                        literal: (known: bool, value: bool) = region_escape_provenance_literal_bool(condition)
                        if literal.known:
                            return region_escape_provenance_statements_terminate(then_body) if literal.value
                            return region_escape_provenance_statements_terminate(else_body)
                        region_escape_provenance_statements_terminate(then_body) and region_escape_provenance_statements_terminate(else_body)
                    Stmt.Block(_, _, _, body, _): region_escape_provenance_statements_terminate(body)
                    Stmt.While(condition, body, _):
                        return true if region_escape_provenance_expression_terminates(condition)
                        condition_literal: (known: bool, value: bool) = region_escape_provenance_literal_bool(condition)
                        empty_catch_lines: darray[u32] @source = []
                        condition_literal.known and condition_literal.value and not region_escape_provenance_statements_have_break(body, empty_catch_lines)
                    Stmt.For(_, _, iterable, _, _): region_escape_provenance_expression_terminates(iterable)
                    Stmt.Match(scrutinee, arms, _): region_escape_provenance_expression_terminates(scrutinee) or region_escape_provenance_match_arms_terminate(scrutinee, arms)
                    _:
                        false


        def region_escape_provenance_statements_terminate(statements: darray[Ast::Stmt]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                for statement in statements:
                    return true if region_escape_provenance_statement_terminates(statement)
                return false


        def region_escape_provenance_catch_error_arms_terminate_with_metadata(arms: darray[Ast::MatchArm], catch_match_lines: darray[u32]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                return false if arms.count < 2
                for arm_index in 1..<arms.count:
                    arm: Ast::MatchArm = arms[arm_index]
                    guard: (known: bool, value: bool) = region_escape_provenance_literal_bool(arm.guard)
                    continue if guard.known and not guard.value
                    return false if not region_escape_provenance_statements_terminate_with_metadata(arm.body, catch_match_lines)
                    unconditional: bool = arm.guard is Ast::Expr.Absent or (guard.known and guard.value)
                    return true if unconditional and region_escape_provenance_pattern_is_error_catchall(arm.pattern)
                return false


        def region_escape_provenance_statement_terminates_with_metadata(statement: Ast::Stmt, catch_match_lines: darray[u32]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                match statement:
                    Stmt.Match(scrutinee, arms, line):
                        is_catch_match: bool = any catch_line in catch_match_lines where catch_line == line.line
                        if is_catch_match:
                            scrutinee_aborts: bool = region_escape_provenance_expression_terminates(scrutinee)
                            scrutinee_may_raise: bool = region_escape_provenance_catchable_raise_with_metadata(scrutinee, catch_match_lines)
                            if scrutinee_aborts:
                                return not scrutinee_may_raise or region_escape_provenance_catch_error_arms_terminate_with_metadata(arms, catch_match_lines)
                            return arms.count > 0 and region_escape_provenance_statements_terminate_with_metadata(arms[0].body, catch_match_lines) and region_escape_provenance_catch_error_arms_terminate_with_metadata(arms, catch_match_lines)
                        region_escape_provenance_expression_terminates(scrutinee) or region_escape_provenance_match_arms_terminate(scrutinee, arms)
                    Stmt.If(condition, then_body, else_body, _):
                        return true if region_escape_provenance_expression_terminates(condition)
                        literal: (known: bool, value: bool) = region_escape_provenance_literal_bool(condition)
                        return region_escape_provenance_statements_terminate_with_metadata(then_body, catch_match_lines) if literal.known and literal.value
                        return region_escape_provenance_statements_terminate_with_metadata(else_body, catch_match_lines) if literal.known
                        return region_escape_provenance_statements_terminate_with_metadata(then_body, catch_match_lines) and region_escape_provenance_statements_terminate_with_metadata(else_body, catch_match_lines)
                    Stmt.Block(_, _, _, body, _):
                        region_escape_provenance_statements_terminate_with_metadata(body, catch_match_lines)
                    Stmt.While(condition, body, _):
                        return true if region_escape_provenance_expression_terminates(condition)
                        condition_literal: (known: bool, value: bool) = region_escape_provenance_literal_bool(condition)
                        condition_literal.known and condition_literal.value and not region_escape_provenance_statements_have_break(body, catch_match_lines)
                    _:
                        region_escape_provenance_statement_terminates(statement)


        def region_escape_provenance_statements_terminate_with_metadata(statements: darray[Ast::Stmt]&, catch_match_lines: darray[u32]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                for statement in statements:
                    return true if region_escape_provenance_statement_terminates_with_metadata(statement, catch_match_lines)
                return false


        # Loop transfers leave the body but still affect the state after the loop.
        # Preserve writes that can reach a break, continue, or ordinary body fallthrough;
        # discard only paths that return or abort before leaving the loop.
        def region_escape_provenance_statement_reaches_after_loop(statement: Ast::Stmt, catch_match_lines: darray[u32]) -> bool:
            can Memory.Allocate, Abort.Panic:
                return match statement:
                    Stmt.Break(_, _) | Stmt.Continue(_, _): true
                    Stmt.Return(_, _): false
                    Stmt.If(condition, then_body, else_body, _):
                        return false if region_escape_provenance_expression_terminates(condition)
                        literal: (known: bool, value: bool) = region_escape_provenance_literal_bool(condition)
                        return region_escape_provenance_statements_reach_after_loop(then_body, catch_match_lines) if literal.known and literal.value
                        return region_escape_provenance_statements_reach_after_loop(else_body, catch_match_lines) if literal.known
                        region_escape_provenance_statements_reach_after_loop(then_body, catch_match_lines) or region_escape_provenance_statements_reach_after_loop(else_body, catch_match_lines)
                    Stmt.Block(_, _, _, body, _):
                        region_escape_provenance_statements_reach_after_loop(body, catch_match_lines)
                    Stmt.Match(scrutinee, arms, line):
                        is_catch_match: bool = any catch_line in catch_match_lines where catch_line == line.line
                        scrutinee_aborts: bool = region_escape_provenance_expression_terminates(scrutinee)
                        scrutinee_may_raise: bool = region_escape_provenance_catchable_raise_with_metadata(scrutinee, catch_match_lines) if is_catch_match else false
                        return false if scrutinee_aborts and (not is_catch_match or not scrutinee_may_raise)
                        arm_index: mutable usize = 0.usize()
                        while arm_index < arms.count |arm_index, arms|:
                            arm: Ast::MatchArm = arms[arm_index]
                            arm_reachable: mutable bool = region_escape_provenance_catch_arm_reachable(arms, arm_index) if is_catch_match else region_escape_provenance_match_arm_reachable(scrutinee, arms, arm_index)
                            arm_reachable <- false if is_catch_match and scrutinee_aborts and arm_index == 0
                            arm_reachable <- false if is_catch_match and scrutinee_aborts and arm_index > 0 and not scrutinee_may_raise
                            guard_literal: (known: bool, value: bool) = region_escape_provenance_literal_bool(arm.guard)
                            if arm_reachable and not (guard_literal.known and not guard_literal.value) and not region_escape_provenance_expression_terminates(arm.guard):
                                return true if region_escape_provenance_statements_reach_after_loop(arm.body, catch_match_lines)
                            arm_index <- arm_index + 1.usize()
                        if is_catch_match:
                            return not region_escape_provenance_statement_terminates_with_metadata(statement, catch_match_lines)
                        return not region_escape_provenance_match_covers_values(scrutinee, arms)
                    _:
                        false


        def region_escape_provenance_statements_reach_after_loop(statements: darray[Ast::Stmt]&, catch_match_lines: darray[u32]) -> bool:
            can Memory.Allocate, Abort.Panic:
                for statement in statements:
                    return true if region_escape_provenance_statement_reaches_after_loop(statement, catch_match_lines)
                    return false if region_escape_provenance_statement_terminates_with_metadata(statement, catch_match_lines)
                return true


        # A literal-true loop can finish only through a reachable break. Unlabelled
        # breaks in nested loops exit those loops; labels declared by child label blocks
        # also stay inside those blocks. Unknown labels remain conservative.
        def region_escape_provenance_statement_has_break_for_loop(statement: Ast::Stmt, catch_match_lines: darray[u32]&, nested_loop_depth: usize, local_labels: darray[sview @source] = []) -> bool:
            can Memory.Allocate, Abort.Panic:
                return match statement:
                    Stmt.Break(label, _):
                        if label == "":
                            nested_loop_depth == 0.usize()
                        else:
                            not any local_label in local_labels where local_label == label
                    Stmt.If(condition, then_body, else_body, _):
                        return false if region_escape_provenance_expression_terminates(condition)
                        literal: (known: bool, value: bool) = region_escape_provenance_literal_bool(condition)
                        if literal.known:
                            return region_escape_provenance_statements_have_break_for_loop(then_body, catch_match_lines, nested_loop_depth, local_labels) if literal.value
                            return region_escape_provenance_statements_have_break_for_loop(else_body, catch_match_lines, nested_loop_depth, local_labels)
                        region_escape_provenance_statements_have_break_for_loop(then_body, catch_match_lines, nested_loop_depth, local_labels) or region_escape_provenance_statements_have_break_for_loop(else_body, catch_match_lines, nested_loop_depth, local_labels)
                    Stmt.Block(kind, clause, _, body, _):
                        if kind == "label":
                            child_labels: mutable darray[sview @source] = [name for name in local_labels]
                            child_labels.extend([name for name in clause])
                            region_escape_provenance_statements_have_break_for_loop(body, catch_match_lines, nested_loop_depth, child_labels)
                        else:
                            region_escape_provenance_statements_have_break_for_loop(body, catch_match_lines, nested_loop_depth, local_labels)
                    Stmt.Match(scrutinee, arms, line):
                        is_catch_match: bool = any catch_line in catch_match_lines where catch_line == line.line
                        arm_index: mutable usize = 0.usize()
                        while arm_index < arms.count |arm_index, arms, local_labels|:
                            arm: Ast::MatchArm = arms[arm_index]
                            reachable: bool = region_escape_provenance_catch_arm_reachable(arms, arm_index) if is_catch_match else region_escape_provenance_match_arm_reachable(scrutinee, arms, arm_index)
                            guard_literal: (known: bool, value: bool) = region_escape_provenance_literal_bool(arm.guard)
                            if reachable and not (guard_literal.known and not guard_literal.value) and not region_escape_provenance_expression_terminates(arm.guard):
                                return true if region_escape_provenance_statements_have_break_for_loop(arm.body, catch_match_lines, nested_loop_depth, local_labels)
                            arm_index <- arm_index + 1.usize()
                        false
                    Stmt.While(condition, body, _):
                        return false if region_escape_provenance_expression_terminates(condition)
                        literal: (known: bool, value: bool) = region_escape_provenance_literal_bool(condition)
                        return false if literal.known and not literal.value
                        region_escape_provenance_statements_have_break_for_loop(body, catch_match_lines, nested_loop_depth + 1.usize(), local_labels)
                    Stmt.For(_, _, iterable, body, _):
                        return false if region_escape_provenance_expression_terminates(iterable)
                        region_escape_provenance_statements_have_break_for_loop(body, catch_match_lines, nested_loop_depth + 1.usize(), local_labels)
                    _:
                        false


        def region_escape_provenance_statements_have_break_for_loop(statements: darray[Ast::Stmt]&, catch_match_lines: darray[u32]&, nested_loop_depth: usize, local_labels: darray[sview @source] = []) -> bool:
            can Memory.Allocate, Abort.Panic:
                for statement in statements:
                    return true if region_escape_provenance_statement_has_break_for_loop(statement, catch_match_lines, nested_loop_depth, local_labels)
                    return false if region_escape_provenance_statement_terminates_with_metadata(statement, catch_match_lines)
                return false


        def region_escape_provenance_statements_have_break(statements: darray[Ast::Stmt]&, catch_match_lines: darray[u32]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                region_escape_provenance_statements_have_break_for_loop(statements, catch_match_lines, 0.usize())


        # A labeled continue inside a child loop may target an enclosing loop. Labels
        # declared inside the scanned body stay local; unknown outer labels stay conservative.
        def region_escape_provenance_statement_has_labeled_continue(statement: Ast::Stmt, catch_match_lines: darray[u32]&, local_labels: darray[sview @source] = []) -> bool:
            can Memory.Allocate, Abort.Panic:
                return match statement:
                    Stmt.Continue(label, _): label != "" and not any local_label in local_labels where local_label == label
                    Stmt.If(condition, then_body, else_body, _):
                        return false if region_escape_provenance_expression_terminates(condition)
                        literal: (known: bool, value: bool) = region_escape_provenance_literal_bool(condition)
                        if literal.known:
                            return region_escape_provenance_statements_have_labeled_continue(then_body, catch_match_lines, local_labels) if literal.value
                            return region_escape_provenance_statements_have_labeled_continue(else_body, catch_match_lines, local_labels)
                        region_escape_provenance_statements_have_labeled_continue(then_body, catch_match_lines, local_labels) or region_escape_provenance_statements_have_labeled_continue(else_body, catch_match_lines, local_labels)
                    Stmt.Block(kind, clause, _, body, _):
                        if kind == "label":
                            child_labels: mutable darray[sview @source] = [name for name in local_labels]
                            child_labels.extend([name for name in clause])
                            region_escape_provenance_statements_have_labeled_continue(body, catch_match_lines, child_labels)
                        else:
                            region_escape_provenance_statements_have_labeled_continue(body, catch_match_lines, local_labels)
                    Stmt.Match(scrutinee, arms, line):
                        is_catch_match: bool = any catch_line in catch_match_lines where catch_line == line.line
                        arm_index: mutable usize = 0.usize()
                        while arm_index < arms.count |arm_index, arms, local_labels|:
                            arm: Ast::MatchArm = arms[arm_index]
                            reachable: bool = region_escape_provenance_catch_arm_reachable(arms, arm_index) if is_catch_match else region_escape_provenance_match_arm_reachable(scrutinee, arms, arm_index)
                            guard_literal: (known: bool, value: bool) = region_escape_provenance_literal_bool(arm.guard)
                            if reachable and not (guard_literal.known and not guard_literal.value) and not region_escape_provenance_expression_terminates(arm.guard):
                                return true if region_escape_provenance_statements_have_labeled_continue(arm.body, catch_match_lines, local_labels)
                            arm_index <- arm_index + 1.usize()
                        false
                    Stmt.While(condition, body, _):
                        return false if region_escape_provenance_expression_terminates(condition)
                        condition_literal: (known: bool, value: bool) = region_escape_provenance_literal_bool(condition)
                        return false if condition_literal.known and not condition_literal.value
                        region_escape_provenance_statements_have_labeled_continue(body, catch_match_lines, local_labels)
                    Stmt.For(_, _, iterable, body, _):
                        return false if region_escape_provenance_expression_terminates(iterable)
                        region_escape_provenance_statements_have_labeled_continue(body, catch_match_lines, local_labels)
                    _:
                        false


        def region_escape_provenance_statements_have_labeled_continue(statements: darray[Ast::Stmt]&, catch_match_lines: darray[u32]&, local_labels: darray[sview @source] = []) -> bool:
            can Memory.Allocate, Abort.Panic:
                for statement in statements:
                    return true if region_escape_provenance_statement_has_labeled_continue(statement, catch_match_lines, local_labels)
                    return false if region_escape_provenance_statement_terminates_with_metadata(statement, catch_match_lines)
                return false


        def region_escape_loop_capture_scalar(accumulator_names: mutable darray[sview @source]&, accumulator_regions: mutable darray[sview @source]&, tracked_names: darray[sview @source]&, source_names: darray[sview @source]&, source_regions: darray[sview @source]&, has_state: mutable bool&, nesting: darray[sview @source]&) -> void:
            can Abort.Panic:
                for name in tracked_names |accumulator_names, accumulator_regions, has_state|:
                    source_region: sview @source = region_escape_region_stabilize(region_taint_lookup(source_names, source_regions, name), nesting)
                    prior_region: sview @source = region_escape_region_stabilize(region_taint_lookup(accumulator_names, accumulator_regions, name), nesting)
                    joined_region: sview @source = source_region if has_state == false else region_escape_region_stabilize(region_escape_deeper_region(prior_region, source_region, nesting), nesting)
                    region_escape_taint_replace(accumulator_names, accumulator_regions, name, joined_region, nesting)
                has_state <- true


        def region_escape_loop_capture_elements(accumulator_names: mutable darray[sview @source]&, accumulator_regions: mutable darray[sview @source]&, tracked_names: darray[sview @source]&, source_names: darray[sview @source]&, source_regions: darray[sview @source]&, has_state: mutable bool&, nesting: darray[sview @source]&) -> void:
            can Abort.Panic:
                for name in tracked_names |accumulator_names, accumulator_regions, has_state|:
                    source_region: sview @source = region_escape_element_region_stabilize(region_escape_element_taint_lookup(source_names, source_regions, name), nesting)
                    prior_region: sview @source = region_escape_element_region_stabilize(region_escape_element_taint_lookup(accumulator_names, accumulator_regions, name), nesting)
                    joined_region: sview @source = source_region if has_state == false else region_escape_element_region_stabilize(region_escape_element_region_join(prior_region, source_region, nesting), nesting)
                    region_escape_element_taint_replace(accumulator_names, accumulator_regions, name, joined_region, nesting)
                has_state <- true


        def region_escape_loop_states_equal(tracked_names: darray[sview @source]&, base_names: darray[sview @source]&, base_regions: darray[sview @source]&, base_element_names: darray[sview @source]&, base_element_regions: darray[sview @source]&, candidate_names: darray[sview @source]&, candidate_regions: darray[sview @source]&, candidate_element_names: darray[sview @source]&, candidate_element_regions: darray[sview @source]&) -> bool:
            can Abort.Panic:
                for name in tracked_names:
                    return false if region_taint_lookup(base_names, base_regions, name) != region_taint_lookup(candidate_names, candidate_regions, name)
                for name in base_element_names:
                    return false if region_escape_element_taint_lookup(base_element_names, base_element_regions, name) != region_escape_element_taint_lookup(candidate_element_names, candidate_element_regions, name)
                return true
        # A value block can assign an outer local from a nested branch. Track those
        # assignments in a private environment so a later tail expression sees the
        # provenance from every branch that can fall through.
        def region_escape_body_merge_falling_branch(base_names: darray[sview @source]&, base_regions: darray[sview @source]&, branch_names: darray[sview @source]&, branch_regions: darray[sview @source]&, joined_names: mutable darray[sview @source]&, joined_regions: mutable darray[sview @source]&, has_joined: mutable bool&, nesting: darray[sview @source]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for name in base_names |joined_names, joined_regions, has_joined|:
                    branch_region: sview @source = region_taint_lookup(branch_names, branch_regions, name)
                    if has_joined == true:
                        joined_region: sview @source = region_taint_lookup(joined_names, joined_regions, name)
                        joined_names.push(name)
                        joined_regions.push(region_escape_deeper_region(joined_region, branch_region, nesting))
                    else:
                        joined_names.push(name)
                        joined_regions.push(branch_region)
                has_joined <- true


        def region_escape_body_apply_assignment(target: Ast::Expr, value: Ast::Expr, operator: TokenKind, annotations: darray[Ast::LocalRegionAnnotation]&, view_fns: darray[sview @source]&, container_fns: darray[sview @source]&, nesting: darray[sview @source]&, taint_names: mutable darray[sview @source]&, taint_regions: mutable darray[sview @source]&, source_taint_names: darray[sview @source]&, source_taint_regions: darray[sview @source]&, line: u32, catch_match_lines: darray[u32]) -> void:
            can Memory.Allocate, Abort.Panic:
                match target:
                    Expr.Paren(inner, _):
                        region_escape_body_apply_assignment(inner, value, operator, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, source_taint_names, source_taint_regions, line, catch_match_lines)
                        return
                    Expr.Tuple(targets, _) | Expr.Array(targets, _):
                        match value:
                            Expr.Paren(inner, _):
                                region_escape_body_apply_assignment(target, inner, operator, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, source_taint_names, source_taint_regions, line, catch_match_lines)
                            Expr.Tuple(values, _) | Expr.Array(values, _):
                                index: mutable usize = 0.usize()
                                while index < targets.count |index, targets, values|:
                                    if index < values.count:
                                        region_escape_body_apply_assignment(targets[index], values[index], operator, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, source_taint_names, source_taint_regions, line, catch_match_lines)
                                    else:
                                        region_escape_body_apply_assignment(targets[index], value, operator, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, source_taint_names, source_taint_regions, line, catch_match_lines)
                                    index <- index + 1.usize()
                            _:
                                for target_element in targets:
                                    region_escape_body_apply_assignment(target_element, value, operator, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, source_taint_names, source_taint_regions, line, catch_match_lines)
                        return
                    _:
                        pass
                target_root: sview @source = region_escape_assign_target_root(target)
                return if target_root == ""
                value_region: mutable sview @source = region_escape_stored_or_call_region(value, annotations, view_fns, container_fns, nesting, source_taint_names, source_taint_regions, line, catch_match_lines)
                # Selector stores preserve the rest of an aggregate; compound stores
                # preserve the old binding value. Whole-binding `=` and `<-` replace it.
                if not region_escape_assign_target_is_whole_binding(target) or (operator != TokenKind.Assign and operator != TokenKind.LArrow):
                    value_region <- region_escape_deeper_region(region_taint_lookup(taint_names, taint_regions, target_root), value_region, nesting)
                taint_names.push(target_root)
                taint_regions.push(value_region)
