extend Semantic:
    private:
        def region_escape_body_apply_statements(body: darray[Ast::Stmt]&, annotations: darray[Ast::LocalRegionAnnotation]&, view_fns: darray[sview @source]&, container_fns: darray[sview @source]&, nesting: darray[sview @source]&, taint_names: mutable darray[sview @source]&, taint_regions: mutable darray[sview @source]&, catch_context: RegionEscapeCatchContext = RegionEscapeCatchContext{markers: [], lexical_module: ""}) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in body |taint_names, taint_regions|:
                    return if region_escape_provenance_statement_terminates_with_metadata(statement, catch_context)
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, statement_line):
                            value_region: mutable sview @source = region_escape_stored_or_call_region(value, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, statement_line.line, catch_context)
                            if value_region == "" and nesting.count > 0 and member_type_is_owned_container(type_expression) and region_escape_is_fresh_container_value(value):
                                value_region <- nesting[nesting.count - 1]
                            taint_names.push(name)
                            taint_regions.push(value_region)
                        Stmt.Assign(target, operator, value, statement_line):
                            source_taint_names: darray[sview @source] = [name for name in taint_names]
                            source_taint_regions: darray[sview @source] = [region for region in taint_regions]
                            region_escape_body_apply_assignment(target, value, operator, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, source_taint_names, source_taint_regions, statement_line.line, catch_context)
                        Stmt.While(_, _, _) | Stmt.For(_, _, _, _, _):
                            one_statement: darray[Ast::Stmt] @source = [statement]
                            empty_element_names: mutable darray[sview @source] = []
                            empty_element_regions: mutable darray[sview @source] = []
                            region_escape_body_apply_statements_with_elements(one_statement, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, empty_element_names, empty_element_regions, catch_context)
                        Stmt.Block(_, _, _, nested_body, _):
                            base_names: darray[sview @source] = [name for name in taint_names]
                            base_regions: darray[sview @source] = [region for region in taint_regions]
                            nested_declared_names: mutable darray[sview @source] = []
                            collect_level_local_names(nested_body, nested_declared_names)
                            nested_names: mutable darray[sview @source] = [name for name in taint_names]
                            nested_regions: mutable darray[sview @source] = [region for region in taint_regions]
                            region_escape_body_apply_statements(nested_body, annotations, view_fns, container_fns, nesting, nested_names, nested_regions, catch_context)
                            joined_names: mutable darray[sview @source] = []
                            joined_regions: mutable darray[sview @source] = []
                            has_joined: mutable bool = false
                            region_escape_body_merge_falling_branch(base_names, base_regions, nested_names, nested_regions, joined_names, joined_regions, has_joined, nesting)
                            for name in base_names |taint_names, taint_regions|:
                                continue if any declared_name in nested_declared_names where declared_name == name
                                taint_names.push(name)
                                taint_regions.push(region_taint_lookup(joined_names, joined_regions, name))
                        Stmt.If(condition, then_body, else_body, _):
                            condition_terminates: bool = region_escape_provenance_expression_terminates_with_metadata(condition, catch_context)
                            return if condition_terminates
                            condition_literal: (known: bool, value: bool) = region_escape_provenance_literal_bool(condition)
                            base_names: darray[sview @source] = [name for name in taint_names]
                            base_regions: darray[sview @source] = [region for region in taint_regions]
                            joined_names: mutable darray[sview @source] = []
                            joined_regions: mutable darray[sview @source] = []
                            has_joined: mutable bool = false
                            if not condition_literal.known or condition_literal.value:
                                then_names: mutable darray[sview @source] = [name for name in base_names]
                                then_regions: mutable darray[sview @source] = [region for region in base_regions]
                                region_escape_body_apply_statements(then_body, annotations, view_fns, container_fns, nesting, then_names, then_regions, catch_context)
                                if not region_escape_provenance_statements_terminate_with_metadata(then_body, catch_context):
                                    region_escape_body_merge_falling_branch(base_names, base_regions, then_names, then_regions, joined_names, joined_regions, has_joined, nesting)
                            if not condition_literal.known or not condition_literal.value:
                                else_names: mutable darray[sview @source] = [name for name in base_names]
                                else_regions: mutable darray[sview @source] = [region for region in base_regions]
                                region_escape_body_apply_statements(else_body, annotations, view_fns, container_fns, nesting, else_names, else_regions, catch_context)
                                if not region_escape_provenance_statements_terminate_with_metadata(else_body, catch_context):
                                    region_escape_body_merge_falling_branch(base_names, base_regions, else_names, else_regions, joined_names, joined_regions, has_joined, nesting)
                            if has_joined:
                                for name in base_names |taint_names, taint_regions, joined_names, joined_regions|:
                                    taint_names.push(name)
                                    taint_regions.push(region_taint_lookup(joined_names, joined_regions, name))
                        Stmt.Match(scrutinee, arms, match_line):
                            is_catch_match: bool = region_escape_catch_marker_matches(match_line, catch_context)
                            scrutinee_aborts: bool = region_escape_provenance_expression_terminates_with_metadata(scrutinee, catch_context)
                            scrutinee_may_raise: bool = region_escape_provenance_catchable_raise_with_metadata(scrutinee, catch_context) if is_catch_match else false
                            return if scrutinee_aborts and (not is_catch_match or not scrutinee_may_raise)
                            base_names: darray[sview @source] = [name for name in taint_names]
                            base_regions: darray[sview @source] = [region for region in taint_regions]
                            joined_names: mutable darray[sview @source] = []
                            joined_regions: mutable darray[sview @source] = []
                            has_joined: mutable bool = false
                            scrutinee_literal: (known: bool, value: bool) = region_escape_provenance_literal_bool(scrutinee)
                            scrutinee_region: sview @source = region_escape_stored_or_call_region(scrutinee, annotations, view_fns, container_fns, nesting, base_names, base_regions, match_line.line, catch_context)
                            arm_index: mutable usize = 0.usize()
                            while arm_index < arms.count |joined_names, joined_regions, has_joined, arm_index|:
                                arm: Ast::MatchArm = arms[arm_index]
                                arm_reachable: mutable bool = region_escape_provenance_catch_arm_reachable(arms, arm_index) if is_catch_match else region_escape_provenance_match_arm_reachable(scrutinee, arms, arm_index)
                                arm_reachable <- false if is_catch_match and scrutinee_aborts and arm_index == 0
                                arm_reachable <- false if is_catch_match and scrutinee_aborts and arm_index > 0 and not scrutinee_may_raise
                                pattern_reachability: (known: bool, matches: bool, catchall: bool) = region_escape_provenance_bool_pattern(arm.pattern, scrutinee_literal.value)
                                arm_reachable <- false if not is_catch_match and scrutinee_literal.known and pattern_reachability.known and not pattern_reachability.matches
                                guard_terminates: bool = region_escape_provenance_expression_terminates_with_metadata(arm.guard, catch_context)
                                guard_literal: (known: bool, value: bool) = region_escape_provenance_literal_bool(arm.guard)
                                if arm_reachable and not guard_terminates and not (guard_literal.known and not guard_literal.value):
                                    arm_names: mutable darray[sview @source] @source = [name for name in base_names]
                                    arm_regions: mutable darray[sview @source] @source = [region for region in base_regions]
                                    bound_names: mutable darray[sview @source] @source = []
                                    collect_pattern_binding_names(arm.pattern, bound_names)
                                    for bound_name in bound_names |arm_names, arm_regions|:
                                        arm_names.push(bound_name)
                                        arm_regions.push(scrutinee_region)
                                    region_escape_body_apply_statements(arm.body, annotations, view_fns, container_fns, nesting, arm_names, arm_regions, catch_context)
                                    if not region_escape_provenance_statements_terminate_with_metadata(arm.body, catch_context):
                                        region_escape_body_merge_falling_branch(base_names, base_regions, arm_names, arm_regions, joined_names, joined_regions, has_joined, nesting)
                                arm_index <- arm_index + 1.usize()
                            total_match: mutable bool = false if is_catch_match else arms.count > 0 and (arms[arms.count - 1].pattern is Ast::Pattern.Wildcard or arms[arms.count - 1].pattern is Ast::Pattern.Binding(_)) and all arm in arms where arm.guard is Ast::Expr.Absent
                            total_match <- true if not is_catch_match and scrutinee_literal.known and any arm in arms where arm.guard is Ast::Expr.Absent and (region_escape_provenance_bool_pattern(arm.pattern, scrutinee_literal.value)).matches
                            total_match <- region_escape_provenance_catch_error_arms_terminate_with_metadata(arms, catch_context) if is_catch_match and scrutinee_aborts and scrutinee_may_raise
                            total_match <- true if is_catch_match and not scrutinee_aborts and arms.count > 0 and region_escape_provenance_pattern_is_match_catchall(arms[0].pattern) and arms[0].guard is Ast::Expr.Absent
                            region_escape_body_merge_falling_branch(base_names, base_regions, base_names, base_regions, joined_names, joined_regions, has_joined, nesting) if not total_match
                            if has_joined == true:
                                for name in base_names |taint_names, taint_regions, joined_names, joined_regions|:
                                    taint_names.push(name)
                                    taint_regions.push(region_taint_lookup(joined_names, joined_regions, name))
                        _:
                            pass


        # Evaluate a value-producing statement block with a private taint environment.
        # This is used for both `match` arms and ML-style block expressions: locals created
        # by one arm/block must contribute provenance to its tail, but must not leak into a
        # sibling arm or the surrounding scope. Return a caller-stack index, never a view
        # whose inferred lifetime is tied to these temporary environment arrays.
        def region_escape_body_value_region(body: darray[Ast::Stmt]&, explicit_value: Ast::Expr?, annotations: darray[Ast::LocalRegionAnnotation]&, view_fns: darray[sview @source]&, container_fns: darray[sview @source]&, nesting: darray[sview @source]&, taint_names: darray[sview @source]&, taint_regions: darray[sview @source]&, line: u32, catch_context: RegionEscapeCatchContext = RegionEscapeCatchContext{markers: [], lexical_module: ""}) -> (found: bool, position: usize):
            can Memory.Allocate, Abort.Panic:
                return (false, 0) if region_escape_provenance_statements_terminate_with_metadata(body, catch_context)
                body_taint_names: mutable darray[sview @source] = [name for name in taint_names]
                body_taint_regions: mutable darray[sview @source] = [region for region in taint_regions]
                region_escape_body_apply_statements(body, annotations, view_fns, container_fns, nesting, body_taint_names, body_taint_regions, catch_context)
                if explicit_value is value:
                    value_region: sview @source = region_escape_stored_or_call_region(value, annotations, view_fns, container_fns, nesting, body_taint_names, body_taint_regions, line, catch_context)
                    return region_stack_position(nesting, value_region)
                return (false, 0) if body.count == 0
                match body[body.count - 1]:
                    Stmt.Expr(tail_value, tail_line):
                        value_region: sview @source = region_escape_stored_or_call_region(tail_value, annotations, view_fns, container_fns, nesting, body_taint_names, body_taint_regions, tail_line.line, catch_context)
                        return region_stack_position(nesting, value_region)
                    _:
                        return (false, 0)


        def region_escape_provenance_match_covers_values(scrutinee: Ast::Expr, arms: darray[Ast::MatchArm]) -> bool:
            can Memory.Allocate, Abort.Panic:
                literal: (known: bool, value: bool) = region_escape_provenance_literal_bool(scrutinee)
                integer_literal: (known: bool, value: i64) = progress_literal_int(scrutinee)
                for arm_index in 0..<arms.count |arms, arm_index, literal, integer_literal|:
                    arm: Ast::MatchArm = arms[arm_index]
                    guard: (known: bool, value: bool) = region_escape_provenance_literal_bool(arm.guard)
                    unconditional: bool = arm.guard is Ast::Expr.Absent or (guard.known and guard.value)
                    continue if not unconditional or not region_escape_provenance_match_arm_reachable(scrutinee, arms, arm_index)
                    if literal.known:
                        pattern_match: (known: bool, matches: bool, catchall: bool) = region_escape_provenance_bool_pattern(arm.pattern, literal.value)
                        return true if pattern_match.known and pattern_match.matches
                    elif integer_literal.known:
                        integer_match: (known: bool, matches: bool) = progress_int_pattern_matches(arm.pattern, integer_literal.value)
                        return true if integer_match.known and integer_match.matches
                    else:
                        return true if region_escape_provenance_pattern_is_match_catchall(arm.pattern)
                return false


        # Replay element provenance alongside the ordinary block-local taints. Branches
        # get private environments, and only reachable paths that can fall through join.
        def region_escape_body_apply_assignment_elements(target: Ast::Expr, value: Ast::Expr, operator: TokenKind, annotations: darray[Ast::LocalRegionAnnotation]&, view_fns: darray[sview @source]&, container_fns: darray[sview @source]&, nesting: darray[sview @source]&, taint_names: darray[sview @source]&, taint_regions: darray[sview @source]&, element_taint_names: mutable darray[sview @source]&, element_taint_regions: mutable darray[sview @source]&, source_taint_names: darray[sview @source]&, source_taint_regions: darray[sview @source]&, source_element_taint_names: darray[sview @source]&, source_element_taint_regions: darray[sview @source]&, line: u32, catch_context: RegionEscapeCatchContext) -> void:
            can Memory.Allocate, Abort.Panic:
                match target:
                    Expr.Paren(inner, _):
                        region_escape_body_apply_assignment_elements(inner, value, operator, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, element_taint_names, element_taint_regions, source_taint_names, source_taint_regions, source_element_taint_names, source_element_taint_regions, line, catch_context)
                        return
                    Expr.Tuple(targets, _) | Expr.Array(targets, _):
                        match value:
                            Expr.Paren(inner, _):
                                region_escape_body_apply_assignment_elements(target, inner, operator, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, element_taint_names, element_taint_regions, source_taint_names, source_taint_regions, source_element_taint_names, source_element_taint_regions, line, catch_context)
                            Expr.Tuple(values, _) | Expr.Array(values, _):
                                index: mutable usize = 0.usize()
                                while index < targets.count |index, targets, values|:
                                    if index < values.count:
                                        region_escape_body_apply_assignment_elements(targets[index], values[index], operator, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, element_taint_names, element_taint_regions, source_taint_names, source_taint_regions, source_element_taint_names, source_element_taint_regions, line, catch_context)
                                    else:
                                        region_escape_body_apply_assignment_elements(targets[index], value, operator, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, element_taint_names, element_taint_regions, source_taint_names, source_taint_regions, source_element_taint_names, source_element_taint_regions, line, catch_context)
                                    index <- index + 1.usize()
                            _:
                                for target_element in targets:
                                    region_escape_body_apply_assignment_elements(target_element, value, operator, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, element_taint_names, element_taint_regions, source_taint_names, source_taint_regions, source_element_taint_names, source_element_taint_regions, line, catch_context)
                        return
                    _:
                        pass
                match target:
                    Expr.Ident(target_name, _):
                        assigned_region: mutable sview @source = region_escape_comprehension_element_region(value, annotations, view_fns, container_fns, nesting, source_taint_names, source_taint_regions, source_element_taint_names, source_element_taint_regions, line, catch_context)
                        if operator == TokenKind.PlusEq:
                            assigned_region <- region_escape_element_region_join(region_escape_element_taint_lookup(element_taint_names, element_taint_regions, target_name), assigned_region, nesting)
                        region_escape_element_taint_set(element_taint_names, element_taint_regions, target_name, assigned_region)
                    Expr.Field(_, _, _):
                        target_name: sview @source = region_escape_assign_target_root(target)
                        if target_name != "":
                            assigned_region: sview @source = region_escape_comprehension_element_region(value, annotations, view_fns, container_fns, nesting, source_taint_names, source_taint_regions, source_element_taint_names, source_element_taint_regions, line, catch_context)
                            prior_region: sview @source = region_escape_element_taint_lookup(element_taint_names, element_taint_regions, target_name)
                            region_escape_element_taint_set(element_taint_names, element_taint_regions, target_name, region_escape_element_region_join(prior_region, assigned_region, nesting))
                    Expr.Index(_, _, _) | Expr.IndexN(_, _, _):
                        target_name: sview @source = region_escape_assign_target_root(target)
                        if target_name != "":
                            assigned_region: sview @source = region_escape_stored_or_call_region_with_elements(value, annotations, view_fns, container_fns, nesting, source_taint_names, source_taint_regions, source_element_taint_names, source_element_taint_regions, line, catch_context)
                            prior_region: sview @source = region_escape_element_taint_lookup(element_taint_names, element_taint_regions, target_name)
                            region_escape_element_taint_set(element_taint_names, element_taint_regions, target_name, region_escape_element_region_join(prior_region, assigned_region, nesting))
                    _:
                        pass


