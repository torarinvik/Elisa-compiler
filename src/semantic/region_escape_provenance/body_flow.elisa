                                next_element_regions: mutable darray[sview @source] = [region for region in base_element_regions]
                                next_scalar_seen: mutable bool = true
                                next_element_seen: mutable bool = true
                                if continue_seen:
                                    region_escape_loop_capture_scalar(next_names, next_regions, base_taint_names, continue_names, continue_regions, next_scalar_seen, nesting)
                                if continue_element_seen:
                                    region_escape_loop_capture_elements(next_element_names, next_element_regions, base_element_names, continue_element_names, continue_element_regions, next_element_seen, nesting)
                                if body_falls_through:
                                    region_escape_loop_capture_scalar(next_names, next_regions, base_taint_names, candidate_names, candidate_regions, next_scalar_seen, nesting)
                                    region_escape_loop_capture_elements(next_element_names, next_element_regions, base_element_names, candidate_element_names, candidate_element_regions, next_element_seen, nesting)
                                done <- region_escape_loop_states_equal(base_taint_names, head_names, head_regions, head_element_names, head_element_regions, next_names, next_regions, next_element_names, next_element_regions)
                                final_candidate_names <- candidate_names
                                final_candidate_regions <- candidate_regions
                                final_candidate_element_names <- candidate_element_names
                                final_candidate_element_regions <- candidate_element_regions
                                head_names <- next_names
                                head_regions <- next_regions
                                head_element_names <- next_element_names
                                head_element_regions <- next_element_regions
                                iteration <- iteration + 1.usize()
                            exit_names: mutable darray[sview @source] = [name for name in base_taint_names]
                            exit_regions: mutable darray[sview @source] = [region for region in base_taint_regions]
                            exit_element_names: mutable darray[sview @source] = [name for name in base_element_names]
                            exit_element_regions: mutable darray[sview @source] = [region for region in base_element_regions]
                            exit_seen: mutable bool = true
                            exit_element_seen: mutable bool = true
                            if continue_seen:
                                region_escape_loop_capture_scalar(exit_names, exit_regions, base_taint_names, continue_names, continue_regions, exit_seen, nesting)
                            if continue_element_seen:
                                region_escape_loop_capture_elements(exit_element_names, exit_element_regions, base_element_names, continue_element_names, continue_element_regions, exit_element_seen, nesting)
                            if not region_escape_provenance_statements_terminate_with_metadata(for_body, catch_match_lines):
                                region_escape_loop_capture_scalar(exit_names, exit_regions, base_taint_names, final_candidate_names, final_candidate_regions, exit_seen, nesting)
                                region_escape_loop_capture_elements(exit_element_names, exit_element_regions, base_element_names, final_candidate_element_names, final_candidate_element_regions, exit_element_seen, nesting)
                            if break_seen:
                                region_escape_loop_capture_scalar(exit_names, exit_regions, base_taint_names, break_names, break_regions, exit_seen, nesting)
                            if break_element_seen:
                                region_escape_loop_capture_elements(exit_element_names, exit_element_regions, base_element_names, break_element_names, break_element_regions, exit_element_seen, nesting)
                            for name in base_taint_names |taint_names, taint_regions|:
                                region_escape_taint_replace(taint_names, taint_regions, name, region_taint_lookup(exit_names, exit_regions, name), nesting)
                            for name in base_element_names |element_taint_names, element_taint_regions|:
                                region_escape_element_taint_replace(element_taint_names, element_taint_regions, name, region_escape_element_taint_lookup(exit_element_names, exit_element_regions, name), nesting)
                            if loop_active and region_escape_provenance_statements_have_break_for_loop(for_body, catch_match_lines, 1.usize(), current_loop_labels):
                                region_escape_loop_capture_scalar(loop_break_names, loop_break_regions, loop_break_names, taint_names, taint_regions, loop_break_seen, nesting)
                                region_escape_loop_capture_elements(loop_break_element_names, loop_break_element_regions, loop_break_element_names, element_taint_names, element_taint_regions, loop_break_element_seen, nesting)
                            if loop_active and region_escape_provenance_statements_have_labeled_continue(for_body, catch_match_lines, current_loop_labels):
                                region_escape_loop_capture_scalar(loop_continue_names, loop_continue_regions, loop_continue_names, taint_names, taint_regions, loop_continue_seen, nesting)
                                region_escape_loop_capture_elements(loop_continue_element_names, loop_continue_element_regions, loop_continue_element_names, element_taint_names, element_taint_regions, loop_continue_element_seen, nesting)
                        Stmt.Contract(_, expression, line):
                            region_escape_record_collection_element_mutation(expression, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, element_taint_names, element_taint_regions, line.line, [catch_line for catch_line in catch_match_lines])
                        _:
                            pass
                    one_statement: darray[Ast::Stmt] @source = [statement]
                    match statement:
                        Stmt.While(_, _, _) | Stmt.For(_, _, _, _, _):
                            pass
                        _:
                            region_escape_body_apply_statements(one_statement, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, [catch_line for catch_line in catch_match_lines])


        def region_escape_body_value_region_with_elements(body: darray[Ast::Stmt]&, explicit_value: Ast::Expr?, annotations: darray[Ast::LocalRegionAnnotation]&, view_fns: darray[sview @source]&, container_fns: darray[sview @source]&, nesting: darray[sview @source]&, taint_names: darray[sview @source]&, taint_regions: darray[sview @source]&, element_taint_names: darray[sview @source]&, element_taint_regions: darray[sview @source]&, line: u32, catch_match_lines: darray[u32]&) -> (found: bool, position: usize):
            can Memory.Allocate, Abort.Panic:
                return (false, 0) if region_escape_provenance_statements_terminate_with_metadata(body, catch_match_lines)
                body_taint_names: mutable darray[sview @source] = [name for name in taint_names]
                body_taint_regions: mutable darray[sview @source] = [region for region in taint_regions]
                body_element_taint_names: mutable darray[sview @source] = [name for name in element_taint_names]
                body_element_taint_regions: mutable darray[sview @source] = [region for region in element_taint_regions]
                region_escape_body_apply_statements_with_elements(body, annotations, view_fns, container_fns, nesting, body_taint_names, body_taint_regions, body_element_taint_names, body_element_taint_regions, catch_match_lines)
                if explicit_value is value:
                    value_region: sview @source = region_escape_stored_or_call_region_with_elements(value, annotations, view_fns, container_fns, nesting, body_taint_names, body_taint_regions, body_element_taint_names, body_element_taint_regions, line, [catch_line for catch_line in catch_match_lines])
                    return region_stack_position(nesting, value_region)
                return (false, 0) if body.count == 0
                match body[body.count - 1]:
                    Stmt.Expr(tail_value, tail_line):
                        value_region: sview @source = region_escape_stored_or_call_region_with_elements(tail_value, annotations, view_fns, container_fns, nesting, body_taint_names, body_taint_regions, body_element_taint_names, body_element_taint_regions, tail_line.line, [catch_line for catch_line in catch_match_lines])
                        return region_stack_position(nesting, value_region)
                    _:
                        return (false, 0)


        def region_escape_value_arms_region_with_elements(is_catch: bool, scrutinee: Ast::Expr, arms: darray[Ast::MatchArm], annotations: darray[Ast::LocalRegionAnnotation]&, view_fns: darray[sview @source]&, container_fns: darray[sview @source]&, nesting: darray[sview @source]&, taint_names: darray[sview @source]&, taint_regions: darray[sview @source]&, element_taint_names: darray[sview @source]&, element_taint_regions: darray[sview @source]&, line: u32, catch_match_lines: darray[u32]) -> sview @source:
            can Memory.Allocate, Abort.Panic:
                guarded_aborts: bool = region_escape_provenance_expression_terminates(scrutinee)
                guarded_may_raise: bool = region_escape_provenance_catchable_raise_with_metadata(scrutinee, catch_match_lines) if is_catch else false
                if guarded_aborts and not guarded_may_raise:
                    return ""
                result_region: mutable sview @source = ""
                if is_catch and not guarded_aborts:
                    result_region <- region_escape_stored_or_call_region_with_elements(scrutinee, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, element_taint_names, element_taint_regions, line, [catch_line for catch_line in catch_match_lines])
                scrutinee_region: sview @source = region_escape_stored_or_call_region_with_elements(scrutinee, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, element_taint_names, element_taint_regions, line, [catch_line for catch_line in catch_match_lines])
                arm_index: mutable usize = 0.usize()
                while arm_index < arms.count |result_region, taint_names, taint_regions, element_taint_names, element_taint_regions, arm_index|:
                    arm: Ast::MatchArm = arms[arm_index]
                    guard_literal: (known: bool, value: bool) = region_escape_provenance_literal_bool(arm.guard)
                    reachable: mutable bool = region_escape_provenance_catch_arm_reachable(arms, arm_index) if is_catch else region_escape_provenance_match_arm_reachable(scrutinee, arms, arm_index)
                    reachable <- false if is_catch and arm_index == 0 and guarded_aborts
                    reachable <- false if is_catch and guarded_aborts and arm_index > 0 and not guarded_may_raise
                    reachable <- false if not reachable or (guard_literal.known and not guard_literal.value) or region_escape_provenance_expression_terminates(arm.guard)
                    if reachable:
                        arm_names: mutable darray[sview @source] @source = [name for name in taint_names]
                        arm_regions: mutable darray[sview @source] @source = [region for region in taint_regions]
                        arm_element_names: mutable darray[sview @source] @source = [name for name in element_taint_names]
                        arm_element_regions: mutable darray[sview @source] @source = [region for region in element_taint_regions]
                        bound_names: mutable darray[sview @source] @source = []
                        collect_pattern_binding_names(arm.pattern, bound_names)
                        for bound_name in bound_names |arm_names, arm_regions, arm_element_names, arm_element_regions|:
                            arm_names.push(bound_name)
                            arm_regions.push(scrutinee_region)
                            region_escape_element_taint_set(arm_element_names, arm_element_regions, bound_name, REGION_ESCAPE_UNKNOWN_ELEMENT_REGION)
                        region_escape_record_collection_element_mutation(arm.guard, annotations, view_fns, container_fns, nesting, arm_names, arm_regions, arm_element_names, arm_element_regions, line)
                        arm_result: (found: bool, position: usize) = region_escape_body_value_region_with_elements(arm.body, null, annotations, view_fns, container_fns, nesting, arm_names, arm_regions, arm_element_names, arm_element_regions, line, catch_match_lines)
                        candidate: sview @source = nesting[arm_result.position] if arm_result.found else ""
                        result_region <- region_escape_deeper_region(result_region, candidate, nesting)
                    arm_index <- arm_index + 1.usize()
                return result_region
