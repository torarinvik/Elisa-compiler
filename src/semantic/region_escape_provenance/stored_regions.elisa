extend Semantic:
    private:
        # The taint region a value contributes: its own @region/taint, OR — for a call to an
        # ambient-allocating container-returning function made INSIDE a region block — the innermost
        # region (the call allocates its owned result in the current block's region).
        def region_escape_stored_or_call_region(value: Ast::Expr, annotations: darray[Ast::LocalRegionAnnotation]&, view_fns: darray[sview @source]&, container_fns: darray[sview @source]&, nesting: darray[sview @source]&, taint_names: darray[sview @source]&, taint_regions: darray[sview @source]&, line: u32, catch_context: RegionEscapeCatchContext = RegionEscapeCatchContext{markers: [], lexical_module: ""}) -> sview @source:
            can Memory.Allocate, Abort.Panic:
                match value:
                    Expr.Ident(name, ident_line):
                        while index > 0 |index: usize = taint_names.count|:
                            index <- index - 1
                            return taint_regions[index] if index < taint_regions.count and taint_names[index] == name
                        return local_region_name(annotations, name, line, ident_line.offset, true)
                    Expr.RegionNew(_, region, _):
                        return region if region != ""
                        return nesting[nesting.count - 1] if nesting.count > 0 else ""
                    Expr.Block(statements, tail_value, _, block_pos):
                        result: (found: bool, position: usize) = region_escape_body_value_region(statements, tail_value, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, line, catch_context)
                        return nesting[result.position] if result.found else ""
                    Expr.Match(scrutinee, arms, _):
                        empty_element_names: mutable darray[sview @source] = []
                        empty_element_regions: mutable darray[sview @source] = []
                        return region_escape_value_arms_region_with_elements(false, scrutinee, arms, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, empty_element_names, empty_element_regions, line, catch_context)
                    Expr.Catch(guarded, arms, _):
                        empty_element_names: mutable darray[sview @source] = []
                        empty_element_regions: mutable darray[sview @source] = []
                        return region_escape_value_arms_region_with_elements(true, guarded, arms, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, empty_element_names, empty_element_regions, line, catch_context)
                    Expr.Paren(inner, _) | Expr.Move(inner, _):
                        return region_escape_stored_or_call_region(inner, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, line, catch_context)
                    Expr.Field(object, _, _) | Expr.Index(object, _, _) | Expr.Slice(object, _, _, _):
                        return region_escape_stored_or_call_region(object, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, line, catch_context)
                    Expr.Tuple(elements, _) | Expr.Array(elements, _):
                        result_region: mutable sview @source = ""
                        for element in elements |result_region|:
                            candidate: sview @source = region_escape_stored_or_call_region(element, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, line, catch_context)
                            result_region <- region_escape_deeper_region(result_region, candidate, nesting)
                        return result_region
                    Expr.Construct(_, fields, _):
                        result_region: mutable sview @source = ""
                        for field in fields |result_region|:
                            candidate: sview @source = region_escape_stored_or_call_region(field.value, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, line, catch_context)
                            result_region <- region_escape_deeper_region(result_region, candidate, nesting)
                        return result_region
                    Expr.RecordUpdate(base, fields, _):
                        result_region: mutable sview @source = region_escape_stored_or_call_region(base, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, line, catch_context)
                        for field in fields |result_region|:
                            candidate: sview @source = region_escape_stored_or_call_region(field.value, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, line, catch_context)
                            result_region <- region_escape_deeper_region(result_region, candidate, nesting)
                        return result_region
                    Expr.If(condition, then_value, else_value, _):
                        literal: (known: bool, value: bool) = region_escape_provenance_literal_bool(condition)
                        if literal.known:
                            return region_escape_stored_or_call_region(then_value, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, line, catch_context) if literal.value
                            return region_escape_stored_or_call_region(else_value, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, line, catch_context)
                        then_region: sview @source = region_escape_stored_or_call_region(then_value, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, line, catch_context)
                        else_region: sview @source = region_escape_stored_or_call_region(else_value, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, line, catch_context)
                        return region_escape_deeper_region(then_region, else_region, nesting)
                    # GetElse's recovery is a terminating control-flow path; only its success
                    # expression can become the value stored or returned by the caller.
                    Expr.GetElse(guarded, _, _):
                        return region_escape_stored_or_call_region(guarded, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, line, catch_context)
                    Expr.Call(callee, arguments, argument_names, call_line):
                        direct: sview @source = effective_value_region(value, annotations, view_fns, nesting, taint_names, taint_regions, line, catch_context)
                        callee_name: sview @source = ident_name_of(callee)
                        return nesting[nesting.count - 1] if nesting.count > 0 and callee_name != "" and (any container_fn in container_fns where container_fn == callee_name)
                        return direct
                    _:
                        return effective_value_region(value, annotations, view_fns, nesting, taint_names, taint_regions, line, catch_context)


        # A branch mentioning an outer/parameter region cannot hide a shorter-lived
        # local dependency from another branch.
        def region_escape_deeper_region(left: sview, right: sview, nesting: darray[sview @source]&) -> sview:
            can Abort.Panic:
                left_position: (found: bool, position: usize) = region_stack_position(nesting, left)
                right_position: (found: bool, position: usize) = region_stack_position(nesting, right)
                return nesting[right_position.position] if right_position.found and (not left_position.found or right_position.position > left_position.position)
                return nesting[left_position.position] if left_position.found
                # Preserve caller-owned provenance when no local region is present. It is
                # needed to compare distinct region parameters after aggregate/enum joins;
                # local escape checks still ignore it because it is absent from `nesting`.
                return REGION_ESCAPE_UNKNOWN_WITH_LOCAL_ELEMENT_REGION if left == REGION_ESCAPE_UNKNOWN_WITH_LOCAL_ELEMENT_REGION or right == REGION_ESCAPE_UNKNOWN_WITH_LOCAL_ELEMENT_REGION
                return REGION_ESCAPE_UNKNOWN_ELEMENT_REGION if left == REGION_ESCAPE_UNKNOWN_ELEMENT_REGION or right == REGION_ESCAPE_UNKNOWN_ELEMENT_REGION
                return REGION_ESCAPE_MULTIPLE_EXTERNAL_REGION if left == REGION_ESCAPE_MULTIPLE_EXTERNAL_REGION or right == REGION_ESCAPE_MULTIPLE_EXTERNAL_REGION
                return right if left == ""
                return left if right == "" or left == right
                return REGION_ESCAPE_MULTIPLE_EXTERNAL_REGION
