extend Semantic:
    private:
        # A loop exit may be nested in an expression, especially a get-else
        # recovery or a value block. Lambda bodies have their own control flow.
        def region_escape_provenance_expression_has_break_for_loop(expression: Ast::Expr, catch_context: RegionEscapeCatchContext, nested_loop_depth: usize, local_labels: darray[sview @source]) -> bool:
            can Memory.Allocate, Abort.Panic:
                return match expression:
                    Expr.GetElse(guarded, recovery, _):
                        region_escape_provenance_expression_has_break_for_loop(guarded, catch_context, nested_loop_depth, local_labels) or region_escape_provenance_statements_have_break_for_loop(recovery, catch_context, nested_loop_depth, local_labels)
                    Expr.Block(statements, value, _, _):
                        region_escape_provenance_statements_have_break_for_loop(statements, catch_context, nested_loop_depth, local_labels) or region_escape_provenance_expression_has_break_for_loop(value, catch_context, nested_loop_depth, local_labels)
                    Expr.Match(scrutinee, arms, _) | Expr.Catch(scrutinee, arms, _):
                        return true if region_escape_provenance_expression_has_break_for_loop(scrutinee, catch_context, nested_loop_depth, local_labels)
                        for arm in arms:
                            return true if region_escape_provenance_expression_has_break_for_loop(arm.guard, catch_context, nested_loop_depth, local_labels) or region_escape_provenance_statements_have_break_for_loop(arm.body, catch_context, nested_loop_depth, local_labels)
                        false
                    Expr.If(condition, then_value, else_value, _) | Expr.Slice(condition, then_value, else_value, _):
                        region_escape_provenance_expression_has_break_for_loop(condition, catch_context, nested_loop_depth, local_labels) or region_escape_provenance_expression_has_break_for_loop(then_value, catch_context, nested_loop_depth, local_labels) or region_escape_provenance_expression_has_break_for_loop(else_value, catch_context, nested_loop_depth, local_labels)
                    Expr.Binary(left, _, right, _) | Expr.Index(left, right, _) | Expr.Refinement(left, right, _):
                        region_escape_provenance_expression_has_break_for_loop(left, catch_context, nested_loop_depth, local_labels) or region_escape_provenance_expression_has_break_for_loop(right, catch_context, nested_loop_depth, local_labels)
                    Expr.Call(head, arguments, _, _) | Expr.IndexN(head, arguments, _) | Expr.StaticEffectCall(head, _, _, arguments, _, _):
                        region_escape_provenance_expression_has_break_for_loop(head, catch_context, nested_loop_depth, local_labels) or any argument in arguments where region_escape_provenance_expression_has_break_for_loop(argument, catch_context, nested_loop_depth, local_labels)
                    Expr.Field(inner, _, _) | Expr.Scope(inner, _, _) | Expr.Unary(_, inner, _) | Expr.Move(inner, _) | Expr.Paren(inner, _) | Expr.RegionNew(inner, _, _):
                        region_escape_provenance_expression_has_break_for_loop(inner, catch_context, nested_loop_depth, local_labels)
                    Expr.Array(elements, _) | Expr.Tuple(elements, _) | Expr.SetLit(elements, _):
                        any element in elements where region_escape_provenance_expression_has_break_for_loop(element, catch_context, nested_loop_depth, local_labels)
                    Expr.DictLit(entries, _):
                        any entry in entries where region_escape_provenance_expression_has_break_for_loop(entry.key, catch_context, nested_loop_depth, local_labels) or region_escape_provenance_expression_has_break_for_loop(entry.value, catch_context, nested_loop_depth, local_labels)
                    Expr.Construct(base, fields, _) | Expr.RecordUpdate(base, fields, _):
                        region_escape_provenance_expression_has_break_for_loop(base, catch_context, nested_loop_depth, local_labels) or any field in fields where region_escape_provenance_expression_has_break_for_loop(field.value, catch_context, nested_loop_depth, local_labels)
                    Expr.Comprehension(_, iterable, condition, value, _, _):
                        region_escape_provenance_expression_has_break_for_loop(iterable, catch_context, nested_loop_depth, local_labels) or region_escape_provenance_expression_has_break_for_loop(condition, catch_context, nested_loop_depth, local_labels) or region_escape_provenance_expression_has_break_for_loop(value, catch_context, nested_loop_depth, local_labels)
                    _:
                        false


        # A literal-true loop can finish only through a reachable break. Unlabelled
        # breaks in nested loops exit those loops; labels declared by child label blocks
        # also stay inside those blocks. Unknown labels remain conservative.
        def region_escape_provenance_statement_has_break_for_loop(statement: Ast::Stmt, catch_context: RegionEscapeCatchContext, nested_loop_depth: usize, local_labels: darray[sview @source] = []) -> bool:
            can Memory.Allocate, Abort.Panic:
                return match statement:
                    Stmt.Break(label, _):
                        if label == "":
                            nested_loop_depth == 0.usize()
                        else:
                            not any local_label in local_labels where local_label == label
                    Stmt.Expr(value, _) | Stmt.VarDecl(_, _, value, _) | Stmt.Contract(_, value, _):
                        region_escape_provenance_expression_has_break_for_loop(value, catch_context, nested_loop_depth, local_labels)
                    Stmt.Assign(target, _, value, _):
                        region_escape_provenance_expression_has_break_for_loop(target, catch_context, nested_loop_depth, local_labels) or region_escape_provenance_expression_has_break_for_loop(value, catch_context, nested_loop_depth, local_labels)
                    Stmt.Return(value, _):
                        if value is returned:
                            return region_escape_provenance_expression_has_break_for_loop(returned, catch_context, nested_loop_depth, local_labels)
                        false
                    Stmt.If(condition, then_body, else_body, _):
                        return true if region_escape_provenance_expression_has_break_for_loop(condition, catch_context, nested_loop_depth, local_labels)
                        return false if region_escape_provenance_expression_terminates_with_metadata(condition, catch_context)
                        literal: (known: bool, value: bool) = region_escape_provenance_literal_bool(condition)
                        if literal.known:
                            return region_escape_provenance_statements_have_break_for_loop(then_body, catch_context, nested_loop_depth, local_labels) if literal.value
                            return region_escape_provenance_statements_have_break_for_loop(else_body, catch_context, nested_loop_depth, local_labels)
                        region_escape_provenance_statements_have_break_for_loop(then_body, catch_context, nested_loop_depth, local_labels) or region_escape_provenance_statements_have_break_for_loop(else_body, catch_context, nested_loop_depth, local_labels)
                    Stmt.Block(kind, clause, _, body, _):
                        if kind == "label":
                            child_labels: mutable darray[sview @source] = [name for name in local_labels]
                            child_labels.extend([name for name in clause])
                            region_escape_provenance_statements_have_break_for_loop(body, catch_context, nested_loop_depth, child_labels)
                        else:
                            region_escape_provenance_statements_have_break_for_loop(body, catch_context, nested_loop_depth, local_labels)
                    Stmt.Match(scrutinee, arms, line):
                        return true if region_escape_provenance_expression_has_break_for_loop(scrutinee, catch_context, nested_loop_depth, local_labels)
                        is_catch_match: bool = region_escape_catch_marker_matches(line, catch_context)
                        scrutinee_aborts: bool = region_escape_provenance_expression_terminates_with_metadata(scrutinee, catch_context)
                        scrutinee_may_raise: bool = region_escape_provenance_catchable_raise_with_metadata(scrutinee, catch_context) if is_catch_match else false
                        return false if scrutinee_aborts and (not is_catch_match or not scrutinee_may_raise)
                        arm_index: mutable usize = 0.usize()
                        while arm_index < arms.count |arm_index, arms, local_labels|:
                            arm: Ast::MatchArm = arms[arm_index]
                            reachable: mutable bool = region_escape_provenance_catch_arm_reachable(arms, arm_index) if is_catch_match else region_escape_provenance_match_arm_reachable(scrutinee, arms, arm_index)
                            reachable <- false if is_catch_match and scrutinee_aborts and arm_index == 0
                            reachable <- false if is_catch_match and scrutinee_aborts and arm_index > 0 and not scrutinee_may_raise
                            guard_literal: (known: bool, value: bool) = region_escape_provenance_literal_bool(arm.guard)
                            return true if reachable and region_escape_provenance_expression_has_break_for_loop(arm.guard, catch_context, nested_loop_depth, local_labels)
                            if reachable and not (guard_literal.known and not guard_literal.value) and not region_escape_provenance_expression_terminates_with_metadata(arm.guard, catch_context):
                                return true if region_escape_provenance_statements_have_break_for_loop(arm.body, catch_context, nested_loop_depth, local_labels)
                            arm_index <- arm_index + 1.usize()
                        false
                    Stmt.While(condition, body, _):
                        return true if region_escape_provenance_expression_has_break_for_loop(condition, catch_context, nested_loop_depth, local_labels)
                        return false if region_escape_provenance_expression_terminates_with_metadata(condition, catch_context)
                        literal: (known: bool, value: bool) = region_escape_provenance_literal_bool(condition)
                        return false if literal.known and not literal.value
                        region_escape_provenance_statements_have_break_for_loop(body, catch_context, nested_loop_depth + 1.usize(), local_labels)
                    Stmt.For(_, _, iterable, body, _):
                        return true if region_escape_provenance_expression_has_break_for_loop(iterable, catch_context, nested_loop_depth, local_labels)
                        return false if region_escape_provenance_expression_terminates_with_metadata(iterable, catch_context)
                        region_escape_provenance_statements_have_break_for_loop(body, catch_context, nested_loop_depth + 1.usize(), local_labels)
                    _:
                        false


        def region_escape_provenance_statements_have_break_for_loop(statements: darray[Ast::Stmt]&, catch_context: RegionEscapeCatchContext, nested_loop_depth: usize, local_labels: darray[sview @source] = []) -> bool:
            can Memory.Allocate, Abort.Panic:
                for statement in statements:
                    return true if region_escape_provenance_statement_has_break_for_loop(statement, catch_context, nested_loop_depth, local_labels)
                    return false if region_escape_provenance_statement_terminates_with_metadata(statement, catch_context)
                return false


        def region_escape_provenance_statements_have_break(statements: darray[Ast::Stmt]&, catch_context: RegionEscapeCatchContext) -> bool:
            can Memory.Allocate, Abort.Panic:
                region_escape_provenance_statements_have_break_for_loop(statements, catch_context, 0.usize())


        # A labeled continue inside a child loop may target an enclosing loop. Labels
        # declared inside the scanned body stay local; unknown outer labels stay conservative.
        def region_escape_provenance_statement_has_labeled_continue(statement: Ast::Stmt, catch_context: RegionEscapeCatchContext, local_labels: darray[sview @source] = []) -> bool:
            can Memory.Allocate, Abort.Panic:
                return match statement:
                    Stmt.Continue(label, _): label != "" and not any local_label in local_labels where local_label == label
                    Stmt.If(condition, then_body, else_body, _):
                        return false if region_escape_provenance_expression_terminates_with_metadata(condition, catch_context)
                        literal: (known: bool, value: bool) = region_escape_provenance_literal_bool(condition)
                        if literal.known:
                            return region_escape_provenance_statements_have_labeled_continue(then_body, catch_context, local_labels) if literal.value
                            return region_escape_provenance_statements_have_labeled_continue(else_body, catch_context, local_labels)
                        region_escape_provenance_statements_have_labeled_continue(then_body, catch_context, local_labels) or region_escape_provenance_statements_have_labeled_continue(else_body, catch_context, local_labels)
                    Stmt.Block(kind, clause, _, body, _):
                        if kind == "label":
                            child_labels: mutable darray[sview @source] = [name for name in local_labels]
                            child_labels.extend([name for name in clause])
                            region_escape_provenance_statements_have_labeled_continue(body, catch_context, child_labels)
                        else:
                            region_escape_provenance_statements_have_labeled_continue(body, catch_context, local_labels)
                    Stmt.Match(scrutinee, arms, line):
                        is_catch_match: bool = region_escape_catch_marker_matches(line, catch_context)
                        scrutinee_aborts: bool = region_escape_provenance_expression_terminates_with_metadata(scrutinee, catch_context)
                        scrutinee_may_raise: bool = region_escape_provenance_catchable_raise_with_metadata(scrutinee, catch_context) if is_catch_match else false
                        return false if scrutinee_aborts and (not is_catch_match or not scrutinee_may_raise)
                        arm_index: mutable usize = 0.usize()
                        while arm_index < arms.count |arm_index, arms, local_labels|:
                            arm: Ast::MatchArm = arms[arm_index]
                            reachable: mutable bool = region_escape_provenance_catch_arm_reachable(arms, arm_index) if is_catch_match else region_escape_provenance_match_arm_reachable(scrutinee, arms, arm_index)
                            reachable <- false if is_catch_match and scrutinee_aborts and arm_index == 0
                            reachable <- false if is_catch_match and scrutinee_aborts and arm_index > 0 and not scrutinee_may_raise
                            guard_literal: (known: bool, value: bool) = region_escape_provenance_literal_bool(arm.guard)
                            if reachable and not (guard_literal.known and not guard_literal.value) and not region_escape_provenance_expression_terminates_with_metadata(arm.guard, catch_context):
                                return true if region_escape_provenance_statements_have_labeled_continue(arm.body, catch_context, local_labels)
                            arm_index <- arm_index + 1.usize()
                        false
                    Stmt.While(condition, body, _):
                        return false if region_escape_provenance_expression_terminates_with_metadata(condition, catch_context)
                        condition_literal: (known: bool, value: bool) = region_escape_provenance_literal_bool(condition)
                        return false if condition_literal.known and not condition_literal.value
                        region_escape_provenance_statements_have_labeled_continue(body, catch_context, local_labels)
                    Stmt.For(_, _, iterable, body, _):
                        return false if region_escape_provenance_expression_terminates_with_metadata(iterable, catch_context)
                        region_escape_provenance_statements_have_labeled_continue(body, catch_context, local_labels)
                    _:
                        false


        def region_escape_provenance_statements_have_labeled_continue(statements: darray[Ast::Stmt]&, catch_context: RegionEscapeCatchContext, local_labels: darray[sview @source] = []) -> bool:
            can Memory.Allocate, Abort.Panic:
                for statement in statements:
                    return true if region_escape_provenance_statement_has_labeled_continue(statement, catch_context, local_labels)
                    return false if region_escape_provenance_statement_terminates_with_metadata(statement, catch_context)
                return false


        def region_escape_loop_capture_scalar(accumulator_names: mutable darray[sview @source]&, accumulator_regions: mutable darray[sview @source]&, tracked_names: darray[sview @source]&, source_names: darray[sview @source]&, source_regions: darray[sview @source]&, has_state: mutable bool&, nesting: darray[sview @source]&) -> void:
            can Abort.Panic:
                for name in tracked_names |accumulator_names, accumulator_regions, has_state|:
                    source_region: sview @source = region_escape_region_stabilize(region_taint_lookup(source_names, source_regions, name), nesting)
                    prior_region: sview @source = region_escape_region_stabilize(region_taint_lookup(accumulator_names, accumulator_regions, name), nesting)
                    joined_region: sview @source = source_region if has_state == false else region_escape_region_stabilize(region_escape_deeper_region(prior_region, source_region, nesting), nesting)
                    region_escape_taint_replace(accumulator_names, accumulator_regions, name, joined_region, nesting)
                has_state <- true


        def region_escape_loop_capture_elements(accumulator_names: mutable darray[sview @source]&, accumulator_regions: mutable darray[sview @source]&, tracked_names: darray[sview @source]&, source_names: darray[sview @source]&, source_regions: darray[sview @source]&, has_state: mutable bool&, nesting: darray[sview @source]&) -> void:
            can Abort.Panic:
                for name in tracked_names |accumulator_names, accumulator_regions, has_state|:
                    source_region: sview @source = region_escape_element_region_stabilize(region_escape_element_taint_lookup(source_names, source_regions, name), nesting)
                    prior_region: sview @source = region_escape_element_region_stabilize(region_escape_element_taint_lookup(accumulator_names, accumulator_regions, name), nesting)
                    joined_region: sview @source = source_region if has_state == false else region_escape_element_region_stabilize(region_escape_element_region_join(prior_region, source_region, nesting), nesting)
                    region_escape_element_taint_replace(accumulator_names, accumulator_regions, name, joined_region, nesting)
                has_state <- true


        def region_escape_loop_states_equal(tracked_names: darray[sview @source]&, base_names: darray[sview @source]&, base_regions: darray[sview @source]&, base_element_names: darray[sview @source]&, base_element_regions: darray[sview @source]&, candidate_names: darray[sview @source]&, candidate_regions: darray[sview @source]&, candidate_element_names: darray[sview @source]&, candidate_element_regions: darray[sview @source]&) -> bool:
            can Abort.Panic:
                for name in tracked_names:
                    return false if region_taint_lookup(base_names, base_regions, name) != region_taint_lookup(candidate_names, candidate_regions, name)
                for name in base_element_names:
                    return false if region_escape_element_taint_lookup(base_element_names, base_element_regions, name) != region_escape_element_taint_lookup(candidate_element_names, candidate_element_regions, name)
                return true
        # A value block can assign an outer local from a nested branch. Track those
        # assignments in a private environment so a later tail expression sees the
        # provenance from every branch that can fall through.
        def region_escape_body_merge_falling_branch(base_names: darray[sview @source]&, base_regions: darray[sview @source]&, branch_names: darray[sview @source]&, branch_regions: darray[sview @source]&, joined_names: mutable darray[sview @source]&, joined_regions: mutable darray[sview @source]&, has_joined: mutable bool&, nesting: darray[sview @source]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for name in base_names |joined_names, joined_regions, has_joined|:
                    branch_region: sview @source = region_taint_lookup(branch_names, branch_regions, name)
                    if has_joined == true:
                        joined_region: sview @source = region_taint_lookup(joined_names, joined_regions, name)
                        joined_names.push(name)
                        joined_regions.push(region_escape_deeper_region(joined_region, branch_region, nesting))
                    else:
                        joined_names.push(name)
                        joined_regions.push(branch_region)
                has_joined <- true


        def region_escape_body_apply_assignment(target: Ast::Expr, value: Ast::Expr, operator: TokenKind, annotations: darray[Ast::LocalRegionAnnotation]&, view_fns: darray[sview @source]&, container_fns: darray[sview @source]&, nesting: darray[sview @source]&, taint_names: mutable darray[sview @source]&, taint_regions: mutable darray[sview @source]&, source_taint_names: darray[sview @source]&, source_taint_regions: darray[sview @source]&, line: u32, catch_context: RegionEscapeCatchContext) -> void:
            can Memory.Allocate, Abort.Panic:
                match target:
                    Expr.Paren(inner, _):
                        region_escape_body_apply_assignment(inner, value, operator, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, source_taint_names, source_taint_regions, line, catch_context)
                        return
                    Expr.Tuple(targets, _) | Expr.Array(targets, _):
                        match value:
                            Expr.Paren(inner, _):
                                region_escape_body_apply_assignment(target, inner, operator, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, source_taint_names, source_taint_regions, line, catch_context)
                            Expr.Tuple(values, _) | Expr.Array(values, _):
                                index: mutable usize = 0.usize()
                                while index < targets.count |index, targets, values|:
                                    if index < values.count:
                                        region_escape_body_apply_assignment(targets[index], values[index], operator, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, source_taint_names, source_taint_regions, line, catch_context)
                                    else:
                                        region_escape_body_apply_assignment(targets[index], value, operator, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, source_taint_names, source_taint_regions, line, catch_context)
                                    index <- index + 1.usize()
                            _:
                                for target_element in targets:
                                    region_escape_body_apply_assignment(target_element, value, operator, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, source_taint_names, source_taint_regions, line, catch_context)
                        return
                    _:
                        pass
                target_root: sview @source = region_escape_assign_target_root(target)
                return if target_root == ""
                value_region: mutable sview @source = region_escape_stored_or_call_region(value, annotations, view_fns, container_fns, nesting, source_taint_names, source_taint_regions, line, catch_context)
                # Selector stores preserve the rest of an aggregate; compound stores
                # preserve the old binding value. Whole-binding `=` and `<-` replace it.
                if not region_escape_assign_target_is_whole_binding(target) or (operator != TokenKind.Assign and operator != TokenKind.LArrow):
                    value_region <- region_escape_deeper_region(region_taint_lookup(taint_names, taint_regions, target_root), value_region, nesting)
                taint_names.push(target_root)
                taint_regions.push(value_region)
