# Stage1 semantic — `diagnostic_message` part 4 of 4 (`extend Semantic: private:`):
# the wording for the remaining kinds, ending at the parser-error wrappers.
#
# One `match diagnostic.kind:` arm per kind does not fit in a 600-line file, so the arms
# are split across parts and each part reports through `handled`. A part that matches no
# arm leaves `handled` false and the dispatcher in semantic_api.elisa tries the next one,
# so an unmatched kind still reaches every part exactly as one flat match would.

extend Semantic:
    private:
        def diagnostic_message_part4(diagnostic: Diagnostic, buffer: mutable darray[u8]&, handled: mutable bool&) -> void:
            can Memory.Allocate, Abort.Panic:
                handled <- true
                match diagnostic.kind:
                    DiagnosticKind.ParametricIndexViolated:
                        buffer.extend(f"where precondition of {diagnostic.name} is violated")

                    DiagnosticKind.HotKernelNotDisjoint:
                        buffer.extend(f"@hot kernel \"{diagnostic.name}\" will not vectorize: its buffers for {diagnostic.expected}/{diagnostic.actual} are not provably disjoint, so LLVM keeps the runtime alias-guard around the element loop. Ensure every caller passes distinct buffers (the analyzer proves this for fresh `[]`/`clone` locals, but not for forwarded or header-copied darrays), or use `Slice.split` for the parallel / dynamic-index case. Once proven, build with `-fnoalias` to enable the vectorization")

                    DiagnosticKind.IntegerLiteralOverflow:
                        push_str(buffer, "integer literal ")
                        push_str(buffer, "-") if diagnostic.expected == "neg"
                        push_int(buffer, diagnostic.expected_count.i64())
                        push_str(buffer, " does not fit in ")
                        push_sview(buffer, diagnostic.actual)

                    DiagnosticKind.ConstEnumValueOverflow:
                        push_str(buffer, "const enum member \"")
                        push_sview(buffer, diagnostic.expected)
                        push_str(buffer, "\".\"")
                        push_sview(buffer, diagnostic.name)
                        push_str(buffer, "\" value ")
                        push_int(buffer, diagnostic.expected_count.i64())
                        push_str(buffer, " does not fit storage type ")
                        push_sview(buffer, diagnostic.actual)

                    DiagnosticKind.RefinementBoundViolated:
                        param_subject = f"parameter \"{diagnostic.actual}\"" if diagnostic.expected == "param" else f"\"{diagnostic.actual}\""
                        return_or_param = f"the returned value" if diagnostic.expected == "return" else param_subject
                        subject = f"the struct field value" if diagnostic.expected == "field" else return_or_param
                        buffer.extend(f"refinement \"{diagnostic.name}\" is violated: {subject} does not satisfy it")

                    DiagnosticKind.RawConcurrencySurfaceRemoved:
                        match diagnostic.name:
                            "cond_wait":
                                buffer.extend("raw concurrency surface removed: `cond_wait` is legacy raw condition-variable surface; use `predicate_wait(cv, move guard, predicate)` or a domain-specific typed predicate wait over protected state")
                            "notify_one" | "notify_all":
                                buffer.extend(f"raw concurrency surface removed: `{diagnostic.name}` is legacy raw notification surface; use `predicate_notify_one` / `predicate_notify_all` or a domain-specific notifier tied to the protected-state predicate")
                            "spawn_raw" | "join_raw" | "detach_raw":
                                buffer.extend(f"raw concurrency surface removed: `{diagnostic.name}` is legacy raw thread surface; use `nursery:` / `nursery workers(N):`, a `pool` scope, or a linear typed Thread handle that is joined at a clear boundary")
                            "spawn1":
                                buffer.extend("raw concurrency surface removed: `spawn1` is low-level escaped-task surface; prefer `nursery:` / `nursery workers(N):`, the data-parallel `each(slice, worker)` / `reduce(slice, identity, op)` combinators, or a pool/task-group batch unless the linear Thread handle intentionally escapes")
                            "pool_submit1":
                                buffer.extend("raw concurrency surface removed: `pool_submit1` is low-level pool submission surface; prefer `nursery:`, a `pool` scope, the data-parallel `each(slice, worker)` / `reduce(slice, identity, op)` combinators, or task-group structure unless the Pending task handle is intentionally managed")
                            "detach":
                                buffer.extend("raw concurrency surface removed: `detach` is a detached-task escape hatch; keep work in `nursery:` / pool scope or prove captured state is static/share-safe before using a detached escape")
                            _:
                                buffer.extend(f"raw concurrency surface removed: `{diagnostic.name}` is legacy raw atomic surface; use `AtomicCell[T]` helpers or a named protocol type that owns the memory-ordering invariant")

                    DiagnosticKind.ParameterWhereRefScope:
                        buffer.extend(f"parameter where refinement may only reference its parameter and earlier parameters: \"{diagnostic.name}\" is not available here")

                    DiagnosticKind.FuncShadowsBuiltinType:
                        buffer.extend(f"function \"{diagnostic.name}\" shadows the builtin type name \"{diagnostic.name}\"; a call `{diagnostic.name}(...)` resolves to the type cast, not this function, so this function can never be called")

                    DiagnosticKind.AsyncEntryAnnotation:
                        buffer.extend(f"@async_entry function \"{diagnostic.name}\" enters with unknown segment owner; add @segment_agnostic or @segment_establishing so host/guest %fs assumptions are explicit" if diagnostic.expected == "segment" else f"@async_entry function \"{diagnostic.name}\" can interrupt arbitrary code; add @reentrant_safe so the async path is transitively lock-free/reentrant")

                    DiagnosticKind.ReentrantSafeCall:
                        buffer.extend(f"@reentrant_safe code cannot call \"{diagnostic.name}\" because it is not marked @reentrant_safe")

                    DiagnosticKind.DuplicateExportName:
                        buffer.extend(f"duplicate export name \"{diagnostic.name}\"")

                    DiagnosticKind.ExportTargetUndefined:
                        buffer.extend(f"export target \"{diagnostic.name}\" is undefined")

                    DiagnosticKind.MutableGlobalUngranted:
                        buffer.extend(f"mutable global access requires can[Unsafe] and has no explicit local effect grant; add can Unsafe.MutableGlobal or a surrounding can ...: block; missing required effect facts")

                    DiagnosticKind.PointerArithmeticUngranted:
                        buffer.extend(f"pointer arithmetic requires can[Unsafe] and has no explicit local effect grant; add can Unsafe.PointerArithmetic or a surrounding can ...: block; missing required effect facts")

                    DiagnosticKind.PushLoopExtendable:
                        buffer.extend(f"loop pushes onto \"{diagnostic.name}\" one element per iteration; prefer the declarative fill `{diagnostic.name}.extend([...])`, which fuses into a single presize-and-fill (no repeated reallocation, and the filter-free form auto-vectorizes). If the accumulation is genuinely incremental (early exit, interleaved writes, stateful), keep the push loop")

                    DiagnosticKind.CharClassifierGuard:
                        buffer.extend(f"char classifier \"{diagnostic.name}\" is not foldable to a lookup table because an arm carries a guard; a guardless total classifier over literal/range/tag patterns compiles to a single 256-byte indexed load (docs/125 §9)")

                    DiagnosticKind.ContractImpureGlobalRead:
                        buffer.extend(f"{diagnostic.expected} clause must be pure but uses the `Global.Read` effect; a contract may not perform effects (no IO, allocation, mutation, time, or randomness) — an effectful or non-deterministic clause is unsound because the verifier treats a spec-position call as a single deterministic value")

                    DiagnosticKind.UninitializedZeroedRead:
                        buffer.extend(f"use of uninitialized variable \"{diagnostic.name}\": it was declared `= zeroed` and never assigned before this read; assign it (or a field of it) first")

                    DiagnosticKind.RedundantEffectGrant:
                        buffer.extend(f"can block grants can {diagnostic.name} redundantly; a surrounding can ...: block already grants these effects")

                    DiagnosticKind.FlowElifLadder:
                        push_str(buffer, "flow warning [-Wflow]: ")
                        push_int(buffer, diagnostic.expected_count.i64())
                        buffer.extend(f"-arm elif ladder testing `{diagnostic.name}` for equality against literals — this is a decision table; `when {diagnostic.name}:` declares the disjointness and totality the ladder only implies (docs/125 §4). To keep the ladder, wrap it in `can ComplexFlow:`")

                    DiagnosticKind.FlowCursorDoubleAdvance:
                        buffer.extend(f"flow warning [-Wflow]: loop cursor `{diagnostic.name}` is advanced twice via `{diagnostic.actual}` in one block with no guard between the advances — a double-skip that drops input silently. Decide the step first (pure lookahead), then advance once by a computed width; if the second advance is intentional, separate it with the guard that makes it so, or wrap the loop in `can ComplexFlow:`.")

                    DiagnosticKind.FlowNestingDepth:
                        push_str(buffer, "flow warning [-Wflow]: conditional nesting deeper than 3 levels in this loop body — a decision tree hiding a state machine. Either name the states and dispatch once (`match mode:` with a single guard per arm), or extract the inner decision into a named function so each level reads as one step. To keep the nesting, wrap the loop in `can ComplexFlow:`")

                    DiagnosticKind.FlowRetestLadder:
                        push_str(buffer, "flow warning [-Wflow]: ")
                        push_int(buffer, diagnostic.expected_count.i64())
                        push_str(buffer, " nested `if … is PATTERN:` probes, each re-probing a value bound by the previous pattern — this is one deep pattern; write it as a single `match` arm (docs/122 nested patterns: `Expr.Unary(TokenKind.Minus, Expr.IntLit(v), _)`). To keep the ladder, wrap it in `can ComplexFlow:`")

                    DiagnosticKind.FlowStateFlag:
                        buffer.extend(f"flow warning [-Wflow]: loop-carried flag `{diagnostic.name}` encodes an untyped state machine — it is compared against literals and reassigned in multiple branches. Name the states in an enum and dispatch on them. To keep it as-is, wrap the loop in `can ComplexFlow:`")

                    DiagnosticKind.FlowSingleMutation:
                        buffer.extend(f"flow warning [-Wflow]: loop-carried `{diagnostic.name}` is mutated by two or more separate branches in sequence — on the path where both fire it changes twice, and the outcome is coupled to the order the branches were written. Compute the whole delta in one place and apply it once. (R6 is advisory — it never fails a build. To silence it, wrap the loop in `can ComplexFlow:`.)")

                    DiagnosticKind.FlowExitBudget:
                        buffer.extend(f"flow warning [-Wflow]: this loop exits with more than two structurally different results — an untyped sum type the caller must decode from the value's shape. Make the cases explicit so every exit builds one result or raises a typed error. To keep the multiple shapes, wrap the loop in `can ComplexFlow:`.")

                    DiagnosticKind.FlowProgress:
                        buffer.extend(f"flow warning [-Wflow]: this loop branch neither advances a cursor, changes loop state, nor exits — the loop can spin forever on this path. Advance the cursor, transition the mode, or exit (`return`/`break`/`raise`) on every branch. If the branch is deliberately a no-op that another path will make progress from, wrap the loop in `can Unsafe.AssumeProgress:`.")

                    DiagnosticKind.FrameConditionConformance:
                        buffer.extend(f"impl method \"{diagnostic.name}\" writes \"{diagnostic.expected}\", which is outside the declared changes set of the interface method it implements — an impl may not change more than the interface permits (docs/87)")

                    DiagnosticKind.WritesOutsideChanges:
                        frame_place = f"{diagnostic.name}.{diagnostic.actual}" if diagnostic.actual != "" else f"{diagnostic.name}"
                        buffer.extend(f"may write {frame_place}, which is outside the `changes` set of \"{diagnostic.expected}\"" if diagnostic.expected_count == 1 else f"writes to {frame_place}, which is outside the `changes` set of \"{diagnostic.expected}\"")

                    DiagnosticKind.PreservesChangesConflict:
                        buffer.extend(f"`preserves {diagnostic.name}.{diagnostic.actual}` conflicts with `changes {diagnostic.name}`: a place cannot be both preserved and changed")

                    DiagnosticKind.WritesPreservedPlace:
                        buffer.extend(f"writes to {diagnostic.name}.{diagnostic.actual}, which \"{diagnostic.expected}\" `preserves`")

                    DiagnosticKind.RefineAliasNonBinder:
                        buffer.extend(f"refine alias \"{diagnostic.name}\" may only be used in a binder position (parameter, return, or local declaration), not as an ordinary type")

                    DiagnosticKind.RefineAliasImpureArg:
                        push_str(buffer, "refine alias argument must be a pure value expression (identifier or field path), not an impure or complex type expression")

                    DiagnosticKind.UnknownInterface:
                        buffer.extend(f"unknown interface \"{diagnostic.name}\"")

                    DiagnosticKind.LmutValueArg:
                        push_str(buffer, "argument ")
                        push_int(buffer, diagnostic.expected_count.i64())
                        push_str(buffer, " to \"")
                        push_sview(buffer, diagnostic.name)
                        push_str(buffer, "\" expects mutable ")
                        push_sview(buffer, diagnostic.expected)
                        push_str(buffer, "&, got ")
                        push_sview(buffer, diagnostic.expected)

                    DiagnosticKind.MatchArmEnumType:
                        buffer.extend(f"match arm expects enum \"{diagnostic.expected}\" or a refinement of it, got \"{diagnostic.name}\"")

                    DiagnosticKind.IsUnrelatedEnum:
                        buffer.extend(f"is expects \"{diagnostic.expected}\" or a refinement of it, got unrelated enum \"{diagnostic.name}\"")

                    DiagnosticKind.StaticCallContext:
                        buffer.extend(f"static function \"{diagnostic.name}\" can only be called from a static context")

                    DiagnosticKind.EffectLawViolation:
                        buffer.extend(f"function \"{diagnostic.name}\" `fulfills {diagnostic.expected}` but uses the `{diagnostic.actual}` effect, which {diagnostic.expected} forbids")

                    DiagnosticKind.CompositeLawCyclic:
                        buffer.extend(f"composite law \"{diagnostic.name}\" is cyclic: it transitively includes itself")

                    DiagnosticKind.CompositeLawBadMember:
                        buffer.extend(f"composite law \"{diagnostic.name}\" includes \"{diagnostic.expected}\", which is a {diagnostic.actual} law; `includes` composes only function-level laws (effect, shape)")

                    DiagnosticKind.EffectLawSubject:
                        buffer.extend(f"\"{diagnostic.name}\" constrains the whole function; write `fulfills {diagnostic.name}`, not `fulfills SUBJECT is {diagnostic.name}`")

                    DiagnosticKind.EffectLawValueIs:
                        buffer.extend(f"\"{diagnostic.name}\" is an effect law; apply it to a function with `fulfills {diagnostic.name}`, not with `is` in a value position")

                    DiagnosticKind.FulfillsRequiresFrame:
                        buffer.extend(f"`fulfills` requires a frame law (a `changes`/`preserves` law); \"{diagnostic.name}\" is a value law — use it with `is` in a refinement position instead")

                    DiagnosticKind.FrameLawPreserveWrite:
                        buffer.extend(f"writes to {diagnostic.name}.{diagnostic.actual}, which \"{diagnostic.expected}\" `preserves`")

                    DiagnosticKind.FrameLawValueIs:
                        buffer.extend(f"\"{diagnostic.name}\" is a frame law; apply it to a function with `fulfills SUBJECT is {diagnostic.name}`, not with `is` in a value position")

                    DiagnosticKind.FrameLawSelfNonRef:
                        buffer.extend(f"`changes/preserves {diagnostic.expected}` has no effect: \"self\" in law \"{diagnostic.name}\" is not a mutable reference parameter (only writes through a ref reach the caller)")

                    DiagnosticKind.RecursiveProofDeclined:
                        buffer.extend(f"recursive proof declined: callee requires for \"{diagnostic.name}\" could not be proven at this recursive call")

                    DiagnosticKind.StaticAssertFailed:
                        buffer.extend(f"static assert failed: {diagnostic.name}" if diagnostic.name != "" else f"static assert failed")

                    DiagnosticKind.AssertConditionNonBool:
                        buffer.extend(f"assert condition must be bool, got {diagnostic.actual}")

                    DiagnosticKind.SetElementUnsupported:
                        buffer.extend(f"runtime-backed set elements must be cstr, an integer type, bool, or a const enum (any type with value equality); floats and aggregates are unsupported; got element type in set[{diagnostic.actual}]")

                    DiagnosticKind.ErrorUnionUnhandled:
                        buffer.extend(f"error union result must be handled with `try`, `match`, or `catch`; discarding it with `_ =` swallows the error" if diagnostic.actual == "discard" else f"error union result must be handled with `try`, `match`, or `catch`, or propagated with `return`; it cannot be silently dropped")

                    DiagnosticKind.WhereRefinementNonBool:
                        buffer.extend(f"where refinement predicate must be bool, got {diagnostic.actual} (subject type is {diagnostic.expected}); write a bool expression such as `n where n > 0`")

                    DiagnosticKind.TryWithoutElseNonErrorFunction:
                        push_str(buffer, "try without else requires the current function to return an error union")

                    DiagnosticKind.FlagsConstEnumArg:
                        buffer.extend(f"Flags[T] expects a const enum type argument, got {diagnostic.actual}")

                    DiagnosticKind.InboundsUnproven:
                        buffer.extend(f"@inbounds function \"{diagnostic.name}\" has an index access that is not statically proven in-bounds, so a runtime bounds check would be emitted; prove the index (iterate with `for x in coll`, or guard with a bound the prover understands, e.g. `if i < coll.count:` or a `requires` refinement)")

                    DiagnosticKind.InteriorRefConsumed:
                        buffer.extend(f"interior reference \"{diagnostic.name}\" cannot be used: usage facts were consumed by argument to call \"{diagnostic.expected}\"")

                    DiagnosticKind.BoundaryPointerArgsType:
                        buffer.extend(f"@boundary_pointer_args on function \"{diagnostic.name}\" marks \"{diagnostic.expected}\" as an address-space pointer, but its type is {diagnostic.actual}; use a typed address-space carrier such as GuestVAddr[T], HostPtr[T], or NativeMappedGuestPtr[T] at the unsafe boundary and resolve before host dereference")

                    DiagnosticKind.ErrorSetParamUninferable:
                        buffer.extend(f"cannot infer error-set parameter \"{diagnostic.expected}\" for call to \"{diagnostic.name}\"; pass a fallible callback whose error set it can bind to")

                    DiagnosticKind.FulfillsWholeFunction:
                        buffer.extend(f"\"{diagnostic.name}\" constrains the whole function; write `fulfills {diagnostic.name}`, not `fulfills {diagnostic.expected} is {diagnostic.name}`")

                    DiagnosticKind.PermissionUnknownFamily:
                        buffer.extend(f"permission \"{diagnostic.name}\" includes unknown family \"{diagnostic.expected}\"")

                    DiagnosticKind.PermissionCycle:
                        buffer.extend(f"permission \"{diagnostic.name}\" has a cyclic `includes` chain through \"{diagnostic.expected}\"")

                    DiagnosticKind.CanCastUnsound:
                        buffer.extend(f"`as {diagnostic.name}` is unsound: \"{diagnostic.name}\" does not subsume \"{diagnostic.expected}\"; declare `permission {diagnostic.name}: includes {diagnostic.actual}` (or add it to the `alias {diagnostic.name}` set) or use `trusted`")

                    DiagnosticKind.ChangesTargetNotParam:
                        buffer.extend(f"`changes` target \"{diagnostic.name}\" is not a parameter")

                    DiagnosticKind.RefinementNotALaw:
                        buffer.extend(f"ensures \"{diagnostic.name}\" is not a law" if diagnostic.expected == "ensures" else f"refinement predicate \"{diagnostic.name}\" is not a law")

                    DiagnosticKind.SegmentAgnosticGrant:
                        push_str(buffer, "@segment_agnostic code cannot grant Segment.Host, Segment.Guest, or Unsafe.SegmentMutation; route segment establishment through a @segment_establishing entry thunk")

                    DiagnosticKind.OptionalLiteralCompare:
                        buffer.extend(f"cannot compare {diagnostic.name}? and {diagnostic.expected}: unwrap the optional first (compare against null, or bind the value with `if EXPR is NAME:`)" if diagnostic.actual == "L" else f"cannot compare {diagnostic.expected} and {diagnostic.name}?: unwrap the optional first (compare against null, or bind the value with `if EXPR is NAME:`)")

                    DiagnosticKind.UnsupportedCallConv:
                        buffer.extend(f"unsupported calling convention \"{diagnostic.name}\" on function \"{diagnostic.expected}\"")

                    DiagnosticKind.ExternSegmentTransition:
                        buffer.extend(f"extern function \"{diagnostic.name}\" mutates the active segment; add @segment_transition(host) or @segment_transition(guest) so the resulting owner is a typed contract, not inferred from permissions")

                    DiagnosticKind.SegmentOwnerMismatch:
                        buffer.extend(f"segment owner mismatch: call to \"{diagnostic.name}\" requires Segment.{diagnostic.expected} but current ambient segment is Segment.{diagnostic.actual}")

                    DiagnosticKind.SegmentOwnerUnknown:
                        buffer.extend(f"segment owner unknown: call to \"{diagnostic.name}\" requires Segment.{diagnostic.expected}; establish Segment.{diagnostic.expected} before crossing this boundary")

                    DiagnosticKind.ContractNoSubject:
                        buffer.extend(f"contract `{diagnostic.name}` must declare at least one parameter (the subject its clauses constrain)")

                    DiagnosticKind.TypestateArgMismatch:
                        buffer.extend(f"argument 1 to \"{diagnostic.name}\" expects the subject in typestate {diagnostic.expected}, but its tracked state does not match (typestate transition called out of order)")

                    DiagnosticKind.NamedArgError:
                        buffer.extend(f"function \"{diagnostic.name}\" has no parameter \"{diagnostic.actual}\"") if diagnostic.expected == "unknown" else buffer.extend(f"function \"{diagnostic.name}\" cannot use positional arguments after named arguments")

                    DiagnosticKind.ImplErrorExtra:
                        buffer.extend(f"impl method \"{diagnostic.expected}\" for interface \"{diagnostic.actual}\" raises error `{diagnostic.name}` not declared in the protocol")

                    DiagnosticKind.ImplEffectExtra:
                        buffer.extend(f"impl method \"{diagnostic.expected}\" for interface \"{diagnostic.actual}\" uses capability `{diagnostic.name}` not granted by the protocol")

                    DiagnosticKind.ImplSignatureMismatch:
                        buffer.extend(f"impl method \"{diagnostic.name}\" for interface \"{diagnostic.actual}\" return type mismatch: expected {diagnostic.expected}, got {diagnostic.detail}")

                    DiagnosticKind.ImplMissingMember:
                        buffer.extend(f"impl of interface \"{diagnostic.actual}\" for {diagnostic.detail} is missing {diagnostic.expected} \"{diagnostic.name}\"")

                    DiagnosticKind.DarrayLinearDrop:
                        buffer.extend(f"{diagnostic.expected} would drop must-consume element(s) of type {diagnostic.name} without consuming them; drain the container with `for x in move c:` and consume each element instead")

                    DiagnosticKind.DrainBodyLeak:
                        buffer.extend("a `for ... in move` drain must consume every element; `break`/`return` inside the drain body would leak the remaining un-consumed elements")

                    DiagnosticKind.DrainSourceNotDarray:
                        buffer.extend(f"`for ... in move` (drain) currently requires a darray source, got {diagnostic.actual}[{diagnostic.expected}]") if diagnostic.expected != ""
                        buffer.extend(f"`for ... in move` (drain) currently requires a darray source, got {diagnostic.actual}") if diagnostic.expected == ""

                    DiagnosticKind.DrainElementNotConsumed:
                        buffer.extend(f"linear element \"{diagnostic.name}\" moved out by `for ... in move` must be consumed in each iteration")

                    DiagnosticKind.IterAffineNonborrowable:
                        buffer.extend(f"iteration over affine element type {diagnostic.name} cannot copy or borrow the elements; use `for x in move c` to drain and consume each element")

                    DiagnosticKind.NolockBlocking:
                        buffer.extend(f"@nolock function \"{diagnostic.name}\" acquires a lock or waits on a condition (via the `{diagnostic.actual}` effect); restructure to avoid the lock/blocking wait on this path, or drop @nolock")

                    DiagnosticKind.SegmentTransitionBadTarget:
                        buffer.extend(f"@segment_transition on extern function \"{diagnostic.name}\" uses unsupported target \"{diagnostic.actual}\" (expected host or guest)")

                    DiagnosticKind.CatchArmOutOfSet:
                        buffer.extend(f"catch arm \"{diagnostic.name}\" does not match the caught call's declared error set")

                    DiagnosticKind.CatchSubsetNonExhaustive:
                        buffer.extend(f"non-exhaustive catch over the caught call's error set; missing {diagnostic.name}.{diagnostic.actual}")

                    DiagnosticKind.CatchArmTail:
                        push_str(buffer, "match expression arm must end with an expression")

                    DiagnosticKind.FieldDefaultTypeMismatch:
                        buffer.extend(f"default value for struct field \"{diagnostic.name}\" expects {diagnostic.expected}, got {diagnostic.actual}")

                    DiagnosticKind.StaticRuntimeStatement:
                        buffer.extend("static expression statement must evaluate at compile time")

                    DiagnosticKind.IdNewtypeReturnMismatch:
                        buffer.extend(f"return type expects id[{diagnostic.expected}], got id[{diagnostic.actual}]") if diagnostic.expected_count == 1
                        buffer.extend(f"return type expects id[{diagnostic.expected}], got {diagnostic.actual}") if diagnostic.expected_count == 0

                    DiagnosticKind.LambdaReturnTypeMismatch:
                        buffer.extend(f"return type expects {diagnostic.expected}, got {diagnostic.actual}")

                    DiagnosticKind.BraceShorthandNoContext:
                        buffer.extend(f"shorthand member \".{diagnostic.name}\" requires an expected const enum type")

                    DiagnosticKind.FlagsIndexType:
                        buffer.extend(f"flags index expects {diagnostic.expected}, got {diagnostic.actual}")

                    DiagnosticKind.EnumerateIndexVariant:
                        buffer.extend(f"nested variant pattern \"{diagnostic.name}.{diagnostic.actual}\" requires an enum or const enum payload, got usize")

                    DiagnosticKind.CatchParamPlainBinder:
                        buffer.extend(f"catch arm \"{diagnostic.name}\" does not match {diagnostic.actual}; use `error e:` to catch the opaque error-set parameter component")

                    DiagnosticKind.VoidNotBindable:
                        buffer.extend(f"variable \"{diagnostic.name}\": void is not a bindable type")

                    DiagnosticKind.AliasPermissionFamilyConflict:
                        buffer.extend(f"alias \"{diagnostic.name}\" conflicts with a permission family of the same name")

                    DiagnosticKind.OverlayTableIndexInvalid:
                        push_str(buffer, "overlay-table-index-invalid: two-operand index `obj[a, b]` is only valid as a fixed-stride guest table read `table.field[mem, i]` over a GuestVAddr[L] carrier whose layout declares a stride")

                    DiagnosticKind.RedundantInlineGrant:
                        buffer.extend(f"inline can grants can {diagnostic.name} redundantly; a surrounding can ...: block already grants these effects")

                    DiagnosticKind.AssignRefToAggregate:
                        buffer.extend(f"cannot assign mutable {diagnostic.actual}& to {diagnostic.expected}")

                    DiagnosticKind.NarrowedArgEnumMismatch:
                        buffer.extend(f"argument 1 to \"{diagnostic.name}\" expects {diagnostic.expected}, got {diagnostic.actual}")

                    DiagnosticKind.OverlayFieldExceedsStride:
                        buffer.extend(f"overlay-field-exceeds-stride: field {diagnostic.expected}.{diagnostic.name} ends past the ")
                        push_int(buffer, diagnostic.expected_count.i64())
                        buffer.extend(f"-byte stride of table layout {diagnostic.expected}; the indexed read would run into the next entry")

                    DiagnosticKind.IndexElseFallbackRemoved:
                        push_str(buffer, "implicit `else` index fallback has been removed; write `get <expr>[<index>] else ...` to make the bounds check explicit")

                    DiagnosticKind.LinearReferenceUnsupported:
                        buffer.extend(f"references to values containing linear handles are not supported; got {diagnostic.actual}[{diagnostic.expected}]&") if diagnostic.expected != ""
                        buffer.extend(f"references to values containing linear handles are not supported; got {diagnostic.actual}&") if diagnostic.expected == ""

                    DiagnosticKind.CloneRefRejected:
                        buffer.extend(f"clone cannot clone {diagnostic.actual}& into {diagnostic.actual}& in v1")

                    DiagnosticKind.CloneElemMismatch:
                        buffer.extend(f"clone cannot clone sview into darray[{diagnostic.actual}] in v1")

                    DiagnosticKind.LawImpure:
                        buffer.extend(f"law \"{diagnostic.name}\" must be pure but uses the `{diagnostic.actual}` effect; a predicate may not perform effects (no IO, allocation, mutation, time, or randomness)")

                    DiagnosticKind.CloneOwnerRequired:
                        buffer.extend(f"clone of \"{diagnostic.actual}[{diagnostic.expected}]\" requires an active in <owner>: scope") if diagnostic.expected != ""
                        buffer.extend(f"clone of \"{diagnostic.actual}\" requires an active in <owner>: scope") if diagnostic.expected == ""

                    DiagnosticKind.RegionOwnerLeak:
                        buffer.extend(f"region owner \"{diagnostic.name}\" must be consumed before scope exit")

                    DiagnosticKind.LocalArenaEscape:
                        buffer.extend(f"cannot {diagnostic.expected} \"{diagnostic.name}\": its backing was allocated in local arena \"{diagnostic.actual}\", which is freed when the function returns (use-after-free). Build it in a persistent arena instead (a global Arena, or an Arena& parameter owned by the caller)")

                    DiagnosticKind.RegionInterleaveDisjoint:
                        buffer.extend(f"interleaved object lifetimes in an inferred region: \"{diagnostic.name}\" is created while \"{diagnostic.actual}\" is still live, but \"{diagnostic.actual}\" is last used before \"{diagnostic.name}\" is first used — their lifetimes cross and the region's stack budget (4) is exhausted, so they cannot share a bump-stack. Move \"{diagnostic.name}\"'s declaration below \"{diagnostic.actual}\"'s last use (their live ranges are disjoint, so this makes the lifetimes nest), or put one in an explicit region (`in r:` / `region r(...)`), or reserve() one of them.")

                    DiagnosticKind.RegionInterleaveOverlap:
                        buffer.extend(f"interleaved object lifetimes in an inferred region: \"{diagnostic.name}\" is created while \"{diagnostic.actual}\" is still live and their live ranges overlap, and the region's stack budget (4) is exhausted, so they cannot share a bump-stack. Put one in an explicit region (`in r:` / `region r(...)`) so the lifetimes nest, or reserve() one of them (a reserved container is fixed-footprint and shares the base stack).")

                    DiagnosticKind.RegionGrowthRealloc:
                        buffer.extend(f"warning: growing \"{diagnostic.name}\" after \"{diagnostic.actual}\" was allocated on top of it in the same inferred region forces a reallocation: \"{diagnostic.name}\" is no longer the arena tail, so this relocates its buffer (a dead hole under the default region, or a panic under an interior-pointer-stable one). reserve() \"{diagnostic.name}\"'s capacity up front, finish growing it before \"{diagnostic.actual}\" is created, or give one its own region.")

                    DiagnosticKind.ExternImplMismatch:
                        buffer.extend(f"extern function \"{diagnostic.name}\" declaration does not match implementation")

                    DiagnosticKind.DarrayLinearMustConsume:
                        buffer.extend(f"darray of must-consume elements (drain with `for x in move c:`) \"{diagnostic.name}\" must be consumed before scope exit")

                    DiagnosticKind.TypestateNonTerminal:
                        buffer.extend(f"typestate value left in non-terminal state \"{diagnostic.name}\" must be consumed before scope exit — drive it to a terminal state (or move it out) so its protocol completes")

                    DiagnosticKind.LinearScopeExit:
                        buffer.extend(f"linear value \"{diagnostic.name}\" must be consumed before scope exit — `move` it out or pass it to a consuming call on every path")

                    DiagnosticKind.TupleValueMismatch:
                        buffer.extend(f"darray literal element expects {diagnostic.expected}" if diagnostic.name == "element" else (f"return type expects {diagnostic.expected}" if diagnostic.name == "return" else f"variable \"{diagnostic.name}\" expects {diagnostic.expected}")) if diagnostic.expected_count == 0
                        if diagnostic.expected_count != 0:
                            push_str(buffer, "argument ")
                            push_int(buffer, diagnostic.expected_count.i64())
                            buffer.extend(f" to \"{diagnostic.name}\" expects {diagnostic.expected}")
                        buffer.extend(f", got ({diagnostic.actual}: {diagnostic.detail}, {diagnostic.detail2}: {diagnostic.detail3})")

                    DiagnosticKind.BlockValueStringArrayMismatch:
                        buffer.extend(f"variable \"{diagnostic.name}\" expects darray[{diagnostic.detail}], got static u8&[")
                        push_int(buffer, diagnostic.actual_count.i64())
                        push_str(buffer, "]")

                    DiagnosticKind.AssignScalarToContainer:
                        buffer.extend(f"cannot assign {diagnostic.actual} to {diagnostic.expected}")
                        buffer.extend(f"[{diagnostic.detail}]") if diagnostic.detail != ""

                    DiagnosticKind.NumericLiteralSuffix:
                        buffer.extend(f"numeric literal suffix \"{diagnostic.name}\" is discouraged; prefer contextual typing or an explicit constructor")

                    DiagnosticKind.ByValueGrownContainer:
                        buffer.extend(f"by-value {diagnostic.name} parameter \"{diagnostic.expected}\" is grown but the growth is not visible to the caller (a by-value container copies its header); pass it by reference (`mutable {diagnostic.name}&`, region inferred) or return it")

                    DiagnosticKind.PreconditionUnproven:
                        buffer.extend(f"precondition of \"{diagnostic.name}\" could not be proven statically at this call")

                    DiagnosticKind.LoopInvariantNotEstablished:
                        push_str(buffer, "loop invariant could not be established on entry; it is only checked at runtime")

                    DiagnosticKind.NoallocAllocates:
                        buffer.extend(f"@noalloc function \"{diagnostic.name}\" allocates or frees on the heap (via the `Memory.Allocate` effect); allocate from a region/arena/stack instead (e.g. `new[auto] T(...)`, or preallocate with `reserve`), or drop @noalloc")

                    DiagnosticKind.StructPadding:
                        buffer.extend(f"struct \"{diagnostic.name}\" has ")
                        push_int(buffer, (diagnostic.expected_count - diagnostic.actual_count).i64())
                        buffer.extend(" bytes of avoidable padding in declared field order (current estimated size ")
                        push_int(buffer, diagnostic.expected_count.i64())
                        buffer.extend(" bytes, reordered estimate ")
                        push_int(buffer, diagnostic.actual_count.i64())
                        buffer.extend(f" bytes); consider ordering fields as \"{diagnostic.expected}\", \"{diagnostic.actual}\"")
                        buffer.extend(f", \"{diagnostic.detail}\"") if diagnostic.detail != ""

                    DiagnosticKind.SubmitOutsidePool:
                        buffer.extend("submit requires an active pool scope")
                    _:
                        handled <- false
