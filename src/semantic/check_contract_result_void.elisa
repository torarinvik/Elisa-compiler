# Contract-family diagnostic (structural). An `ensure` postcondition may name `result` (the
# function's return value) — but a `-> void` function has no return value, so `result` there is
# unbound. stage0 rejects it (as a generic "undefined identifier result"); stage1 emits a
# dedicated, clearer message.
#
# SOUNDNESS: `result` in a LEADING `ensure` can only bind to (a) the return value, (b) a
# parameter named `result`, or (c) a top-level symbol named `result` — a local cannot, because
# locals are declared AFTER the contract prologue (a non-leading ensure is a different
# diagnostic, ContractNotFirst). So we fire only when the function is explicitly `-> void`, no
# parameter is named `result`, and no top-level symbol is named `result`. Any other case leaves
# `result` legitimately bound, so we stay silent — zero false positives.
extend Semantic:
    private:
        # Partial "does this expression mention the identifier `result`" walk. Handles the
        # common expression shapes; any unhandled shape returns false (a sound miss — we may
        # under-report, never over-report).
        def expression_mentions_result(expression: Ast::Expr) -> bool:
            match expression:
                Expr.Ident(name, line):
                    identifier_name: sview = name
                    return identifier_name == "result"
                Expr.Binary(left, operator, right, line):
                    return expression_mentions_result(left) or expression_mentions_result(right)
                Expr.Unary(operator, operand, line):
                    return expression_mentions_result(operand)
                Expr.Paren(inner, line):
                    return expression_mentions_result(inner)
                Expr.Field(object, field, line):
                    return expression_mentions_result(object)
                Expr.Index(object, index, line):
                    return expression_mentions_result(object) or expression_mentions_result(index)
                Expr.Call(callee, arguments, argument_names, line):
                    true return if expression_mentions_result(callee)
                    for argument in arguments:
                        true return if expression_mentions_result(argument)
                    return false
                _:
                    return false


        # Whether the function declares a parameter named `result`.
        def has_result_parameter(parameters: darray[Ast::ParamDecl]&) -> bool:
            can Abort.Panic:
                while parameter_index < parameters.count |parameter_index: usize = 0|:
                    parameter_name: sview = parameters[parameter_index].name
                    true return if parameter_name == "result"
                    parameter_index <- parameter_index + 1
                return false


        # Whether any collected top-level symbol is named `result` (a global/const/function that
        # would legitimately bind `result`). `table.symbols` is populated ONLY through
        # add_symbol/seed_builtins (symbols.elisa), the same funnel that maintains
        # name_primary/name_overflow — an O(1)-expected existence index over the exact same
        # name set — so this is equivalent to (and replaces) an O(symbols.count) scan of every
        # declaration in the whole program for one fixed name.
        def result_symbol_defined(table: SymbolTable&) -> bool:
            can Abort.Panic:
                return name_indexed(table, "result")


        # Flag a leading `ensure` that mentions `result` (in a void function with no other
        # `result` binding). Scans only the contract prologue.
        def check_contract_result_void_body(statements: darray[Ast::Stmt], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                prologue_length: usize = leading_contract_count(statements)
                while statement_index < prologue_length |statement_index: usize = 0|:
                    match statements[statement_index]:
                        Stmt.Contract(kind, expression, line):
                            contract_kind: sview = kind
                            if contract_kind == "ensure" and expression_mentions_result(expression):
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ContractEnsureResultVoid, name: "", line: line.line, expected: "", actual: ""})
                                # stage0 has no dedicated message here — `result` simply
                                # fails to resolve in a void function and the comparison
                                # wall follows. Reproduce both companion diagnostics.
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UndefinedName, name: "result", line: line.line, expected: "", actual: ""})
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.OrderingNonNumeric, name: "", line: line.line, expected: "", actual: ""})
                        _:
                            pass
                    statement_index <- statement_index + 1


        # Whether any leading `requires` clause mentions `name` (a constrained
        # param can discharge simple ensure goals — stay silent then).
        def requires_mentions(statements: darray[Ast::Stmt], name: sview) -> bool:
            can Memory.Allocate, Abort.Panic:
                for statement in statements:
                    match statement:
                        Stmt.Contract(kind, expression, line):
                            contract_kind: sview = kind
                            true return if contract_kind == "requires" and ensure_expression_mentions_name(expression, name)
                        _:
                            pass
                return false

        def ensure_expression_mentions_name(expression: Ast::Expr, name: sview) -> bool:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Ident(mention_name, mention_line):
                        return mention_name == name
                    Expr.Binary(left, operator, right, line):
                        return ensure_expression_mentions_name(left, name) or ensure_expression_mentions_name(right, name)
                    Expr.Unary(operator, operand, line):
                        return ensure_expression_mentions_name(operand, name)
                    Expr.Paren(inner, line):
                        return ensure_expression_mentions_name(inner, name)
                    Expr.Call(callee, arguments, argument_names, line):
                        true return if ensure_expression_mentions_name(callee, name)
                        for argument in arguments |name|:
                            true return if ensure_expression_mentions_name(argument, name)
                        return false
                    Expr.Field(object, field, line):
                        return ensure_expression_mentions_name(object, name)
                    Expr.Index(object, index, line):
                        return ensure_expression_mentions_name(object, name) or ensure_expression_mentions_name(index, name)
                    _:
                        return false

        # `when`-table default helper: mark the fold unknown and yield 0.
        def fold_unknown(known: mutable bool&) -> i64:
            can Abort.Panic:
                known <- false
                return 0

        # The integer value of an `Expr.IntLit` (KNOWN set false otherwise).
        def int_literal_value(expression: Ast::Expr, known: mutable bool&) -> i64:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.IntLit(value):
                        known <- true
                        return value
                    Expr.Unary(operator, operand, line):
                        if operator == TokenKind.Minus:
                            inner: i64 = int_literal_value(operand, known)
                            return 0 - inner
                        known <- false
                        return 0
                    Expr.Paren(inner_expression, paren_line):
                        return int_literal_value(inner_expression, known)
                    Expr.Binary(left, operator, right, binary_line):
                        left_known: mutable bool = false
                        left_value: i64 = int_literal_value(left, left_known)
                        right_known: mutable bool = false
                        right_value: i64 = int_literal_value(right, right_known)
                        if left_known and right_known:
                            known <- true
                            return when operator:
                                TokenKind.Plus -> left_value + right_value
                                TokenKind.Minus -> left_value - right_value
                                TokenKind.Star -> left_value * right_value
                                _ -> fold_unknown(known)
                        known <- false
                        return 0
                    _:
                        known <- false
                        return 0

        # Whether `LEFT OP RIGHT` holds for integer constants; unknown operators
        # conservatively hold (so we never flag what we cannot evaluate).
        def integer_comparison_holds(left: i64, operator: TokenKind, right: i64) -> bool:
            can Abort.Panic:
                return when operator:
                    TokenKind.Gt -> left > right
                    TokenKind.GtEq -> left >= right
                    TokenKind.Lt -> left < right
                    TokenKind.LtEq -> left <= right
                    TokenKind.EqEq -> left == right
                    TokenKind.BangEq -> left != right
                    _ -> true

        # Whether a constant return value RETURNED provably VIOLATES the ensure goal
        # `result CMP INTLIT` (or the mirrored `INTLIT CMP result`). Any other goal
        # shape is not evaluable here — treat as satisfiable (sound miss).
        def ensure_goal_violated_by_constant(goal: Ast::Expr, returned: i64) -> bool:
            can Memory.Allocate, Abort.Panic:
                match goal:
                    Expr.Binary(left, operator, right, line):
                        left_is_result: bool = ident_name_of(left) == "result"
                        right_is_result: bool = ident_name_of(right) == "result"
                        right_known: mutable bool = false
                        right_value: i64 = int_literal_value(right, right_known)
                        (not integer_comparison_holds(returned, operator, right_value)) return if left_is_result and right_known
                        left_known: mutable bool = false
                        left_value: i64 = int_literal_value(left, left_known)
                        (not integer_comparison_holds(left_value, operator, returned)) return if right_is_result and left_known
                        return false
                    Expr.Paren(inner, paren_line):
                        return ensure_goal_violated_by_constant(inner, returned)
                    _:
                        return false

        # Whether an expression is the literal `true` (BoolLit or the ident `true`, through parens).
        def crv_is_true_literal(expression: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.BoolLit(value):
                        return value
                    Expr.Ident(name, ident_line):
                        return name == "true"
                    Expr.Paren(inner, paren_line):
                        return crv_is_true_literal(inner)
                    _:
                        return false

        # Whether an ensure goal is a syntactic TAUTOLOGY (`X or true` / `true`, nested through
        # or/parens) — stage0's prover discharges it trivially, so it is never unprovable. Sound.
        def crv_ensure_is_tautology(expression: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                true return if crv_is_true_literal(expression)
                match expression:
                    Expr.Paren(inner, paren_line):
                        return crv_ensure_is_tautology(inner)
                    Expr.Binary(left, operator, right, binary_line):
                        crv_is_true_literal(left) or crv_is_true_literal(right) or crv_ensure_is_tautology(left) or crv_ensure_is_tautology(right) return if operator == TokenKind.Or
                        return false
                    _:
                        return false

        # Strip a top-level additive identity (`E + 0`, `E - 0`, `0 + E`) so that
        # `result + 0` normalizes to `result`. Existing node, no allocation.
        def crv_strip_ident0(expression: Ast::Expr) -> Ast::Expr:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Paren(inner, paren_line):
                        return crv_strip_ident0(inner)
                    Expr.Binary(left, operator, right, binary_line):
                        crv_strip_ident0(left) return if (operator == TokenKind.Plus or operator == TokenKind.Minus) and crv_int_lit_is(right, 0)
                        crv_strip_ident0(right) return if operator == TokenKind.Plus and crv_int_lit_is(left, 0)
                        return expression
                    _:
                        return expression

        def crv_int_lit_is(expression: Ast::Expr, value: i64) -> bool:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.IntLit(literal_value):
                        return literal_value == value
                    Expr.Paren(inner, paren_line):
                        return crv_int_lit_is(inner, value)
                    _:
                        return false

        # Structural equality where `result` and the returned parameter name are
        # INTERCHANGEABLE (they denote the same value on a `return PARAM`), folding
        # additive identities at every level. Decides `result == a` (given `return a`)
        # and `result + 0 >= result` are reflexively true without any facts.
        def crv_reflexive_equal(a: Ast::Expr, b: Ast::Expr, param: sview, depth: u32) -> bool:
            can Memory.Allocate, Abort.Panic:
                false return if depth > 12
                a_normalized: Ast::Expr = crv_strip_ident0(a)
                b_normalized: Ast::Expr = crv_strip_ident0(b)
                match a_normalized:
                    Expr.Ident(a_name, a_line):
                        b_name: sview = ident_name_of(b_normalized)
                        false return if b_name == ""
                        # `result` and the returned param name denote the same value.
                        a_is_returned: bool = a_name == param or a_name == "result"
                        b_is_returned: bool = b_name == param or b_name == "result"
                        true return if a_is_returned and b_is_returned
                        return a_name == b_name
                    Expr.IntLit(a_value):
                        return match b_normalized:
                            Expr.IntLit(b_value): a_value == b_value
                            _: false
                    Expr.Binary(a_left, a_operator, a_right, a_line):
                        return match b_normalized:
                            Expr.Binary(b_left, b_operator, b_right, b_line): a_operator == b_operator and crv_reflexive_equal(a_left, b_left, param, depth + 1) and crv_reflexive_equal(a_right, b_right, param, depth + 1)
                            _: false
                    Expr.Field(a_object, a_field, a_line):
                        return match b_normalized:
                            Expr.Field(b_object, b_field, b_line): a_field == b_field and crv_reflexive_equal(a_object, b_object, param, depth + 1)
                            _: false
                    _:
                        return false

        # A `result != null` postcondition on a RETURN of a reference-typed parameter:
        # references are never null in Elisa, so stage0 discharges it with no facts.
        def crv_goal_is_result_nonnull(goal: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                match goal:
                    Expr.Paren(inner, paren_line):
                        return crv_goal_is_result_nonnull(inner)
                    Expr.Binary(left, operator, right, binary_line):
                        return operator == TokenKind.BangEq and ident_name_of(left) == "result" and ident_name_of(right) == "null"
                    _:
                        return false

        # A result-mentioning ensure goal that is REFLEXIVELY true given `result == PARAM`:
        # `result CMP result` for a reflexive comparison (`==`, `<=`, `>=`), after
        # substituting the returned param for result. stage0 discharges these with no facts,
        # so flagging them "could not be proven" is a false positive.
        def crv_ensure_reflexive(goal: Ast::Expr, param: sview) -> bool:
            can Memory.Allocate, Abort.Panic:
                match goal:
                    Expr.Paren(inner, paren_line):
                        return crv_ensure_reflexive(inner, param)
                    Expr.Binary(left, operator, right, binary_line):
                        reflexive_operator: bool = operator == TokenKind.EqEq or operator == TokenKind.LtEq or operator == TokenKind.GtEq
                        return reflexive_operator and crv_reflexive_equal(left, right, param, 0)
                    _:
                        return false

        # A sound SUBSET of stage0's ensure prover: `ensure result CMP ...` with a
        # `return PARAM` that no requires-clause constrains cannot be discharged,
        # and `ensure result CMP INTLIT` with a constant return that evaluates
        # false is provably violated.
        def flag_unproven_ensures(function_name: sview, parameters: darray[Ast::ParamDecl], body: darray[Ast::Stmt], proofs_active: bool, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                has_result_ensure: mutable bool = false
                ensure_line: mutable u32 = 0
                for statement in body |has_result_ensure, ensure_line|:
                    match statement:
                        Stmt.Contract(kind, expression, line):
                            contract_kind: sview = kind
                            # A tautological ensure (`… or true`) is trivially discharged — it does
                            # not make the function must-prove.
                            if contract_kind == "ensure" and expression_mentions_result(expression) and not crv_ensure_is_tautology(expression):
                                has_result_ensure <- true
                                ensure_line <- line.line if ensure_line == 0
                        _:
                            pass
                return if not has_result_ensure
                # Only the trivial shape is decidably unprovable here: a body whose
                # sole non-contract statement is one unconditional `return PARAM`.
                # Any branching (guards, ifs) may establish the goal via flow facts.
                non_contract_count: mutable usize = 0
                branchy: mutable bool = false
                for statement in body |non_contract_count, branchy|:
                    match statement:
                        Stmt.Contract(kind, expression, line):
                            pass
                        Stmt.If(condition, then_body, else_body, line):
                            branchy <- true
                        Stmt.While(condition, body_statements, line):
                            branchy <- true
                        Stmt.Match(scrutinee, arms, line):
                            branchy <- true
                        _:
                            non_contract_count <- non_contract_count + 1
                return if branchy or non_contract_count != 1
                # A constant return lets the goal be EVALUATED: scan for `return INTLIT`
                # first, then judge each ensure goal against it inside the contract arm
                # (the goal Expr never leaves its match scope).
                returned_constant: mutable i64 = 0
                has_constant_return: mutable bool = false
                for statement in body |returned_constant, has_constant_return|:
                    match statement:
                        Stmt.Return(value, line):
                            if value is returned:
                                found: mutable bool = false
                                candidate: i64 = int_literal_value(returned, found)
                                returned_constant <- candidate if found
                                has_constant_return <- true if found
                        _:
                            pass
                if has_constant_return:
                    for statement in body |table|:
                        match statement:
                            Stmt.Contract(kind, expression, line):
                                contract_kind: sview = kind
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.EnsureNotProven, name: function_name, line: ensure_line, expected: "", actual: "", detail: "violated"}) if contract_kind == "ensure" and ensure_goal_violated_by_constant(expression, returned_constant)
                            _:
                                pass
                    return
                for statement in body |table|:
                    match statement:
                        Stmt.Return(value, line):
                            if value is returned:
                                returned_name: sview = ident_name_of(returned)
                                continue if returned_name == ""
                                # Whether the returned parameter is a reference type (`Foo&`):
                                # references are never null, so `ensure result != null` holds.
                                returned_is_ref: mutable bool = false
                                for reference_parameter in parameters |returned_is_ref, returned_name|:
                                    returned_is_ref <- true if reference_parameter.name == returned_name and type_marker_present_here(reference_parameter.type_expression, TokenKind.Ampersand) and not type_marker_present_here(reference_parameter.type_expression, TokenKind.Question)
                                # Every result-mentioning ensure that is reflexively true
                                # given `result == returned_name` (`ensure result == a`,
                                # `ensure result + 0 >= result`), or a `result != null` on a
                                # reference return, is discharged by stage0 with no facts.
                                # Suppress only when ALL such ensures are discharged.
                                all_reflexive: mutable bool = true
                                for ensure_statement in body |all_reflexive, returned_name, returned_is_ref|:
                                    match ensure_statement:
                                        Stmt.Contract(ensure_kind, ensure_expression, ensure_stmt_line):
                                            if ensure_kind == "ensure" and expression_mentions_result(ensure_expression) and not crv_ensure_is_tautology(ensure_expression):
                                                discharged: bool = crv_ensure_reflexive(ensure_expression, returned_name) or (returned_is_ref and crv_goal_is_result_nonnull(ensure_expression))
                                                all_reflexive <- false if not discharged
                                        _:
                                            pass
                                continue if all_reflexive
                                is_param: mutable bool = false
                                # A `where` refinement on the returned parameter's own type
                                # (`n: i64 where n >= 0`) is a fact about it, exactly like a
                                # `requires` clause naming it — stage0's prover consumes both.
                                where_refined: mutable bool = false
                                for parameter in parameters |is_param, where_refined, returned_name|:
                                    if parameter.name == returned_name:
                                        is_param <- true
                                        where_refined <- true if parameter.type_expression is Ast::Expr.Refinement
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.EnsureNotProven, name: function_name, line: ensure_line, expected: "", actual: ""}) if proofs_active and is_param and not where_refined and not requires_mentions(body, returned_name)
                        _:
                            pass

        def check_contract_result_void(declarations: darray[Ast::Decl], proofs_active: bool, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(name, parameters, return_type, body, effects, decorators, line):
                            returns_void: mutable bool = false
                            if return_type is return_type_expr:
                                return_type_name: sview = bare_type_name(return_type_expr)
                                returns_void <- true if return_type_name == "void"
                            table <- check_contract_result_void_body(body, table) if returns_void and not has_result_parameter(parameters) and not result_symbol_defined(table)
                            table <- flag_unproven_ensures(name, parameters, body, proofs_active, table) if not returns_void
                        Decl.Module(name, body, line):
                            table <- check_contract_result_void(body, proofs_active, table)
                        Decl.Scoped(body, line):
                            table <- check_contract_result_void(body, proofs_active, table)
                        _:
                            pass
