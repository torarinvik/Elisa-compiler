# A machine `decreases MEASURE` measure must be integer-typed (stage0 rejects a bool
# measure: "loop `decreases` measure must be an integer, got bool"). Stage1 now retains the
# measure as a generated loop contract; it also records a BARE-IDENT measure as a
# `__machine_decreases_measure` annotation (owner = the measure identifier, line = the
# machine head) so the precise bool-parameter diagnostic remains available in the frontend.
#
# SOUND SUBSET: only a bare-ident measure resolving to a `bool` param fires. A complex
# measure (arithmetic, call) is left to stage0's prover, and a non-bool param is silent.
extend Semantic:
    private:
        # The largest line number reachable in a statement list (its span end), recursing
        # into nested bodies so a machine desugared deep in the function still falls inside
        # the enclosing function's range.
        def stmt_list_max_line(statements: darray[Ast::Stmt]) -> u32:
            can Memory.Allocate, Abort.Panic:
                best: mutable u32 = 0
                for statement in statements |best|:
                    line: u32 = stmt_max_line(statement)
                    best <- line if line > best
                return best

        def max_u32(a: u32, b: u32) -> u32:
            can Abort.Panic:
                return a if a > b else b

        def match_arms_max_line(arms: darray[Ast::MatchArm], seed: u32) -> u32:
            can Memory.Allocate, Abort.Panic:
                best: mutable u32 = seed
                for arm in arms |best|:
                    best <- max_u32(best, stmt_list_max_line(arm.body))
                return best

        def stmt_max_line(statement: Ast::Stmt) -> u32:
            can Memory.Allocate, Abort.Panic:
                return match statement:
                    Stmt.VarDecl(name, type_expression, value, line): line.line
                    Stmt.Assign(target, operator, value, line): line.line
                    Stmt.Expr(expression, line): line.line
                    Stmt.Return(value, line): line.line
                    Stmt.If(condition, then_body, else_body, line): max_u32(line.line, max_u32(stmt_list_max_line(then_body), stmt_list_max_line(else_body)))
                    Stmt.While(condition, body, line): max_u32(line.line, stmt_list_max_line(body))
                    Stmt.For(bind, variables, iterable, body, line): max_u32(line.line, stmt_list_max_line(body))
                    Stmt.Block(kind, clause, binding, body, line): max_u32(line.line, stmt_list_max_line(body))
                    Stmt.Match(scrutinee, arms, line): match_arms_max_line(arms, line.line)
                    _: 0

        def machine_decreases_type_walk(declarations: darray[Ast::Decl], measure_names: darray[sview]&, measure_lines: darray[u32]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            bool_params: mutable darray[sview] = []
                            for parameter in parameters |bool_params|:
                                bool_params.push(parameter.name) if bare_type_name(parameter.type_expression) == "bool"
                            if bool_params.count > 0:
                                span_end: u32 = stmt_list_max_line(body)
                                probe: mutable usize = 0
                                while probe < measure_names.count |probe, table| -> table:
                                    at: u32 = measure_lines[probe]
                                    in_range: bool = at >= line.line and at <= span_end
                                    is_bool: bool = any b in bool_params where b == measure_names[probe]
                                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.MachineDecreasesType, name: "", line: at, expected: "", actual: "bool"}) if in_range and is_bool
                                    probe <- probe + 1
                        Decl.Module(module_name, module_body, module_line):
                            table <- machine_decreases_type_walk(module_body, measure_names, measure_lines, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- machine_decreases_type_walk(scoped_body, measure_names, measure_lines, table)
                        _:
                            pass

        def check_machine_decreases_type(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                measure_names: mutable darray[sview] = []
                measure_lines: mutable darray[u32] = []
                for annotation in file.enum_annotations |measure_names, measure_lines|:
                    if annotation.name == "__machine_decreases_measure":
                        measure_names.push(annotation.owner)
                        measure_lines.push(annotation.line)
                return if measure_names.count == 0
                table <- machine_decreases_type_walk(file.top_decls, measure_names, measure_lines, table)
