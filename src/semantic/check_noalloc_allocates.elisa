# `@noalloc` heap-allocation rejection. A function marked `@noalloc` must not use the
# `Memory.Allocate` effect — neither DIRECTLY (a `can Memory.Allocate:` block in its body) nor
# TRANSITIVELY (calling a function that does). stage0 errors: "@noalloc function X allocates or
# frees on the heap (via the Memory.Allocate effect)". Decidable + sound: allocating functions
# are those with an explicit `can Memory.Allocate:` block or a signature `Memory.Allocate`
# effect; a `@noalloc` function that has such a block, or calls such a function, is rejected.
extend Semantic:
    private:
        def has_noalloc_decorator(decorators: darray[Ast::Annotation]) -> bool:
            can Abort.Panic:
                return any decorator in decorators where decorator.name == "noalloc"

        def effects_grant_allocate(effects: darray[sview]) -> bool:
            can Abort.Panic:
                return any effect in effects where effect == "Memory.Allocate"

        # Whether a statement tree contains a `can Memory.Allocate:` block.
        def statements_grant_allocate(statements: darray[Ast::Stmt]) -> bool:
            can Memory.Allocate, Abort.Panic:
                found: mutable bool = false
                for statement in statements |found|:
                    continue if found
                    found <- true if statement_grants_allocate(statement)
                return found

        def statement_grants_allocate(statement: Ast::Stmt) -> bool:
            can Memory.Allocate, Abort.Panic:
                match statement:
                    Stmt.Block(kind, clause, binding, body, line):
                        true return if kind == "can" and any effect_name in clause where effect_name == "Memory.Allocate"
                        return statements_grant_allocate(body)
                    Stmt.If(condition, then_body, else_body, line):
                        return statements_grant_allocate(then_body) or statements_grant_allocate(else_body)
                    Stmt.While(condition, while_body, line):
                        return statements_grant_allocate(while_body)
                    Stmt.For(bind, variables, iterable, for_body, line):
                        return statements_grant_allocate(for_body)
                    Stmt.Match(scrutinee, arms, line):
                        any_arm: mutable bool = false
                        for arm in arms |any_arm|:
                            any_arm <- true if statements_grant_allocate(arm.body)
                        return any_arm
                    _:
                        return false

        def collect_allocating_functions(declarations: darray[Ast::Decl], out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |out|:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            out.push(function_name) if effects_grant_allocate(effects) or statements_grant_allocate(body)
                        Decl.Module(module_name, module_body, module_line):
                            collect_allocating_functions(module_body, out)
                        Decl.Scoped(scoped_body, scoped_line):
                            collect_allocating_functions(scoped_body, out)
                        _:
                            pass

        # Whether a statement tree calls any function named in `allocating` (transitive alloc).
        def statements_call_allocating(statements: darray[Ast::Stmt], allocating: darray[sview]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                found: mutable bool = false
                for statement in statements |found, allocating|:
                    continue if found
                    found <- true if statement_calls_allocating(statement, allocating)
                return found

        def statement_calls_allocating(statement: Ast::Stmt, allocating: darray[sview]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                match statement:
                    Stmt.Expr(expression, line):
                        return expression_calls_allocating(expression, allocating)
                    Stmt.Return(value, line):
                        if value is returned:
                            return expression_calls_allocating(returned, allocating)
                        return false
                    Stmt.VarDecl(name, type_expression, value, line):
                        return expression_calls_allocating(value, allocating)
                    Stmt.Assign(target, operator, value, line):
                        return expression_calls_allocating(value, allocating)
                    Stmt.Block(kind, clause, binding, body, line):
                        return statements_call_allocating(body, allocating)
                    Stmt.If(condition, then_body, else_body, line):
                        return statements_call_allocating(then_body, allocating) or statements_call_allocating(else_body, allocating)
                    Stmt.While(condition, while_body, line):
                        return statements_call_allocating(while_body, allocating)
                    Stmt.For(bind, variables, iterable, for_body, line):
                        return statements_call_allocating(for_body, allocating)
                    _:
                        return false

        def expression_calls_allocating(expression: Ast::Expr, allocating: darray[sview]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, line):
                        callee_name: sview = ident_name_of(callee)
                        true return if callee_name != "" and any allocating_name in allocating where allocating_name == callee_name
                        any_arg: mutable bool = false
                        for argument in arguments |any_arg, allocating|:
                            any_arg <- true if expression_calls_allocating(argument, allocating)
                        return any_arg
                    Expr.Binary(left, operator, right, line):
                        return expression_calls_allocating(left, allocating) or expression_calls_allocating(right, allocating)
                    Expr.Paren(inner, line):
                        return expression_calls_allocating(inner, allocating)
                    _:
                        return false

        def check_noalloc_allocates_decls(declarations: darray[Ast::Decl], allocating: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            direct: bool = statements_grant_allocate(body)
                            transitive: bool = statements_call_allocating(body, allocating)
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.NoallocAllocates, name: function_name, line: line, expected: "", actual: ""}) if has_noalloc_decorator(decorators) and (direct or transitive)
                        Decl.Module(module_name, module_body, module_line):
                            table <- check_noalloc_allocates_decls(module_body, allocating, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- check_noalloc_allocates_decls(scoped_body, allocating, table)
                        _:
                            pass

        def check_noalloc_allocates(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                allocating: mutable darray[sview] = []
                collect_allocating_functions(file.top_decls, allocating)
                table <- check_noalloc_allocates_decls(file.top_decls, allocating, table)
