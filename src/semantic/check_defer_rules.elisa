# Two structural constraints on `defer` blocks (parsed as `Stmt.Block(kind="defer")`, with the
# `block`/`function` form word captured in the clause):
#   1. A `defer block:` body may not `return` from the enclosing function — the deferred code
#      runs during unwind, so a return there is meaningless ("defer body cannot return ...").
#   2. A `defer function:` is only allowed at the OUTERMOST function scope, not nested inside an
#      `if`/loop/other block ("defer function is currently only supported in the outermost ...").
#      stage0 measures this as scope DEPTH (`currentNonGlobalScopeDepth() != 1`), and its
#      parser wraps a region-lessly allocating body in a synthesized `region __auto_N:` scope
#      (auto_region_wrap.elisa) — so in such a function even a top-level `defer function:` is
#      one scope too deep and is rejected. The wrap predicate is the shared one the `-emit ast`
#      parity gate pins; a purely syntactic walk silently ACCEPTED these (permissive gap).
extend Semantic:
    private:
        def clause_contains(clause: darray[sview]&, word: sview) -> bool:
            can Abort.Panic:
                return any entry in clause where entry == word

        # Whether BODY (a defer-block body) `return`s from the enclosing function. Recurses
        # control flow but NOT into a nested `defer function:` (its returns are its own).
        def defer_body_returns(statements: darray[Ast::Stmt]) -> bool:
            can Memory.Allocate, Abort.Panic:
                for statement in statements:
                    match statement:
                        Stmt.Return(value, line):
                            return true
                        Stmt.If(condition, then_body, else_body, line):
                            true return if defer_body_returns(then_body) or defer_body_returns(else_body)
                        Stmt.While(condition, while_body, line):
                            true return if defer_body_returns(while_body)
                        Stmt.For(bind, variables, iterable, for_body, line):
                            true return if defer_body_returns(for_body)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms:
                                true return if defer_body_returns(arm.body)
                        Stmt.Block(block_kind, clause, binding, block_body, line):
                            continue if block_kind == "defer" and clause_contains(clause, "function")
                            true return if defer_body_returns(block_body)
                        _:
                            pass
                return false

        # Walk statements; `outermost` is true only for the function body's direct statements.
        def defer_rules_walk(statements: darray[Ast::Stmt], outermost: bool, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Block(block_kind, clause, binding, block_body, line):
                            if block_kind == "defer":
                                is_function: bool = clause_contains(clause, "function")
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.DeferFunctionNotOutermost, name: "", line: line.line, expected: "", actual: ""}) if is_function and not outermost
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.DeferBodyReturns, name: "", line: line.line, expected: "", actual: ""}) if not is_function and defer_body_returns(block_body)
                            table <- defer_rules_walk(block_body, false, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- defer_rules_walk(then_body, false, table)
                            table <- defer_rules_walk(else_body, false, table)
                        Stmt.While(condition, while_body, line):
                            table <- defer_rules_walk(while_body, false, table)
                        Stmt.For(bind, variables, iterable, for_body, line):
                            table <- defer_rules_walk(for_body, false, table)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |table| -> table:
                                table <- defer_rules_walk(arm.body, false, table)
                        _:
                            pass

        def defer_rules_decls(file: Ast::File&, declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            body_wrapped: bool = auto_region_function_body_is_wrapped(file, parameters, body, line.line)
                            table <- defer_rules_walk(body, not body_wrapped, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- defer_rules_decls(file, module_body, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- defer_rules_decls(file, scoped_body, table)
                        _:
                            pass

    public:
        def check_defer_rules(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- defer_rules_decls(file, file.top_decls, table)
