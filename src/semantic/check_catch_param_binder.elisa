# Plain-binder catch arm over an error-set parameter. In a function with an errorset parameter
# `R`, a caught call's error component is the opaque `R`; it must be caught with `error e:`,
# not a bare binder — the first bare binder is the success value, a second is an invalid
# attempt to bind the error:
#
#   def logged[errorset R](f: fn() -> i64 error[R]) -> i64 error[R]:
#       catch f():
#           n:            # success value
#           e:            # error: does not match R; use `error e:`
#               raise e
#
# The errorset parameter is recorded on `__errorset_param` (keyed by function line); a catch
# lowers to `Stmt.Match` tagged `__catch_match`. A SECOND `Pattern.Binding` arm (the first is
# the success binder) in such a function is the flagged error-binder.
extend Semantic:
    private:
        def cpb_errorset_param(annotations: darray[Ast::EnumAnnotation]&, function_line: u32) -> sview:
            can Abort.Panic:
                for annotation in annotations:
                    annotation.name return if annotation.owner == "__errorset_param" and annotation.line == function_line
                return sview("", 0, 0)

        def cpb_is_catch(annotations: darray[Ast::EnumAnnotation]&, match_line: u32) -> bool:
            can Abort.Panic:
                return any annotation in annotations where annotation.name == "__catch_match" and annotation.line == match_line

        # The binder of the SECOND `Pattern.Binding` arm (the first is the success value), else "".
        def cpb_second_binder(arms: darray[Ast::MatchArm]&) -> sview:
            can Memory.Allocate, Abort.Panic:
                seen: mutable u32 = 0
                found: mutable sview = ""
                for arm in arms |seen, found|:
                    match arm.pattern:
                        Ast::Pattern.Binding(binder_name):
                            found <- binder_name if seen == 1 and found == ""
                            seen <- seen + 1
                        _:
                            pass
                return found

        def cpb_check_statements(statements: darray[Ast::Stmt], errorset_name: sview, annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Match(scrutinee, arms, match_line):
                            if cpb_is_catch(annotations, match_line):
                                binder: sview = cpb_second_binder(arms)
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.CatchParamPlainBinder, name: binder, line: match_line, expected: "", actual: errorset_name}) if binder != ""
                            for arm in arms |table| -> table:
                                table <- cpb_check_statements(arm.body, errorset_name, annotations, table)
                        Stmt.If(condition, then_body, else_body, if_line):
                            table <- cpb_check_statements(then_body, errorset_name, annotations, table)
                            table <- cpb_check_statements(else_body, errorset_name, annotations, table)
                        Stmt.While(condition, while_body, while_line):
                            table <- cpb_check_statements(while_body, errorset_name, annotations, table)
                        Stmt.For(bind, variables, iterable, for_body, for_line):
                            table <- cpb_check_statements(for_body, errorset_name, annotations, table)
                        Stmt.Block(kind, clause, binding, body, block_line):
                            table <- cpb_check_statements(body, errorset_name, annotations, table)
                        _:
                            pass

        def cpb_check_declarations(declarations: darray[Ast::Decl], annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            errorset_name: sview = cpb_errorset_param(annotations, line)
                            table <- cpb_check_statements(body, errorset_name, annotations, table) if errorset_name != ""
                        Decl.Module(module_name, module_body, module_line):
                            table <- cpb_check_declarations(module_body, annotations, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- cpb_check_declarations(scoped_body, annotations, table)
                        _:
                            pass

    public:
        def check_catch_param_binder(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- cpb_check_declarations(file.top_decls, file.enum_annotations, table)
