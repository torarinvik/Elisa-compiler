# Plain-binder catch arm over an error-set parameter. In a function with an errorset parameter
# `R`, a caught call's error component is the opaque `R`; it must be caught with `error e:`,
# not a bare binder — the first bare binder is the success value, a second is an invalid
# attempt to bind the error:
#
#   def logged[errorset R](f: fn() -> i64 error[R]) -> i64 error[R]:
#       catch f():
#           n:            # success value
#           e:            # error: does not match R; use `error e:`
#               raise e
#
# The errorset parameter is recorded on `__errorset_param` (keyed by declaration line and
# source offset); a catch
# lowers to `Stmt.Match` tagged `__catch_match`. A SECOND `Pattern.Binding` arm (the first is
# the success binder) in such a function is the flagged error-binder.
extend Semantic:
    private:
        # The errorset-parameter name at (FUNCTION_LINE, FUNCTION_OFFSET), else "". Callers
        # pass the compact parallel index built once by check_catch_param_binder instead of
        # rescanning every annotation emitted by the parser for each function. Legacy
        # offsetless rows are accepted only when they are unique on that line.
        def cpb_errorset_param(lines: darray[u32]&, offsets: darray[u32]&, names: darray[sview]&, modules: darray[sview]&, function_line: u32, function_offset: u32, function_module: sview) -> sview:
            can Abort.Panic:
                exact_count: mutable usize = 0.usize()
                exact_name: mutable sview = ""
                line_count: mutable usize = 0.usize()
                legacy_count: mutable usize = 0.usize()
                legacy_name: mutable sview = ""
                paired: mutable usize = lines.count if lines.count < offsets.count else offsets.count
                paired <- names.count if names.count < paired
                for index in 0..<paired:
                    continue if lines[index] != function_line or index >= offsets.count or index >= names.count or index >= modules.count or modules[index] != function_module
                    line_count <- line_count + 1.usize()
                    if offsets[index] == function_offset:
                        exact_count <- exact_count + 1.usize()
                        exact_name <- names[index]
                    elif offsets[index] == 0:
                        legacy_count <- legacy_count + 1.usize()
                        legacy_name <- names[index]
                return exact_name if exact_count == 1.usize()
                return "" if exact_count > 1.usize()
                return legacy_name if line_count == 1.usize() and legacy_count == 1.usize()
                return ""

        # Build the only annotation index this checker needs. Keeping source views preserves
        # the parser's ownership model while turning each function lookup into a short scan of
        # errorset rows rather than the complete annotation table.
        def cpb_collect_errorset_params(annotations: darray[Ast::EnumAnnotation]&, lines: mutable darray[u32]&, offsets: mutable darray[u32]&, names: mutable darray[sview]&, modules: mutable darray[sview]&) -> void:
            can Abort.Panic, Memory.Allocate:
                for annotation in annotations |lines, offsets, names|:
                    if annotation.owner == "__errorset_param":
                        lines.push(annotation.line)
                        offsets.push(annotation.offset)
                        names.push(annotation.name)
                        modules.push(annotation.module)

        def cpb_is_catch(annotations: darray[Ast::EnumAnnotation]&, match_line: u32, match_offset: u32, lexical_module: sview) -> bool:
            can Abort.Panic:
                exact_count: mutable usize = 0.usize()
                line_count: mutable usize = 0.usize()
                legacy_count: mutable usize = 0.usize()
                for annotation in annotations |exact_count, line_count, legacy_count, match_line, match_offset|:
                    continue if annotation.owner != "__catch_match" or annotation.name != "__catch_match" or annotation.line != match_line or annotation.module != lexical_module
                    line_count <- line_count + 1.usize()
                    if annotation.offset == match_offset:
                        exact_count <- exact_count + 1.usize()
                    elif annotation.offset == 0:
                        legacy_count <- legacy_count + 1.usize()
                return exact_count == 1.usize() if exact_count > 0.usize()
                return line_count == 1.usize() and legacy_count == 1.usize()

        # The binder of the SECOND `Pattern.Binding` arm (the first is the success value), else "".
        def cpb_second_binder(arms: darray[Ast::MatchArm]&) -> sview:
            can Abort.Panic:
                seen: mutable u32 = 0
                found: mutable sview = ""
                for arm in arms |seen, found|:
                    match arm.pattern:
                        Ast::Pattern.Binding(binder_name):
                            found <- binder_name if seen == 1 and found == ""
                            seen <- seen + 1
                        _:
                            pass
                return found

        def cpb_check_statements(statements: darray[Ast::Stmt], errorset_name: sview @source, lexical_module: sview, annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Match(scrutinee, arms, match_pos):
                            if cpb_is_catch(annotations, match_pos.line, match_pos.offset, lexical_module):
                                binder: sview = cpb_second_binder(arms)
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.CatchParamPlainBinder, name: binder, line: match_pos.line, expected: "", actual: errorset_name}) if binder != ""
                            for arm in arms |table| -> table:
                                table <- cpb_check_statements(arm.body, errorset_name, lexical_module, annotations, table)
                        Stmt.If(condition, then_body, else_body, if_line):
                            table <- cpb_check_statements(then_body, errorset_name, lexical_module, annotations, table)
                            table <- cpb_check_statements(else_body, errorset_name, lexical_module, annotations, table)
                        Stmt.While(condition, while_body, while_line):
                            table <- cpb_check_statements(while_body, errorset_name, lexical_module, annotations, table)
                        Stmt.For(bind, variables, iterable, for_body, for_line):
                            table <- cpb_check_statements(for_body, errorset_name, lexical_module, annotations, table)
                        Stmt.Block(kind, clause, binding, body, block_line):
                            table <- cpb_check_statements(body, errorset_name, lexical_module, annotations, table)
                        _:
                            pass

        def cpb_check_declarations(declarations: darray[Ast::Decl], lexical_module: sview, annotations: darray[Ast::EnumAnnotation]&, errorset_lines: darray[u32]&, errorset_offsets: darray[u32]&, errorset_names: darray[sview @source]&, errorset_modules: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            errorset_name: sview = cpb_errorset_param(errorset_lines, errorset_offsets, errorset_names, errorset_modules, line.line, line.offset, lexical_module)
                            table <- cpb_check_statements(body, errorset_name, lexical_module, annotations, table) if errorset_name != ""
                        Decl.Module(module_name, module_body, module_line):
                            table <- cpb_check_declarations(module_body, module_name, annotations, errorset_lines, errorset_offsets, errorset_names, errorset_modules, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- cpb_check_declarations(scoped_body, lexical_module, annotations, errorset_lines, errorset_offsets, errorset_names, errorset_modules, table)
                        _:
                            pass

    public:
        def check_catch_param_binder(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                errorset_lines: mutable darray[u32] = []
                errorset_offsets: mutable darray[u32] = []
                errorset_names: mutable darray[sview @source] = []
                errorset_modules: mutable darray[sview] = []
                cpb_collect_errorset_params(file.enum_annotations, errorset_lines, errorset_offsets, errorset_names, errorset_modules)
                table <- cpb_check_declarations(file.top_decls, "", file.enum_annotations, errorset_lines, errorset_offsets, errorset_names, errorset_modules, table)
