# Check for shifts by zero: x << 0, x >> 0.
# A shift by zero is a no-op and likely indicates a mistake.

extend Semantic:
    private:
        # Walk through all expressions, checking for Binary operations with zero shift counts.
        def walk_expression_for_shift_by_zero(expression: Ast::Expr, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Binary(left, operator, right, line):
                        # Check for shift by zero: only flag LShift or RShift with IntLit(0).
                        # OversizedShift handles >= 64 and NegativeShift handles < 0, so this
                        # is disjoint — flag only when the shift count is exactly 0.
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ShiftByZero, name: "", line: line, expected: "", actual: ""}) if (operator == TokenKind.LShift or operator == TokenKind.RShift) and right is Expr.IntLit(shift_count) and shift_count == 0
                        # Recursively walk left and right operands
                        table <- walk_expression_for_shift_by_zero(left, table)
                        if operator != TokenKind.Is and operator != TokenKind.As:
                            table <- walk_expression_for_shift_by_zero(right, table)
                    Expr.Call(callee, arguments, argument_names, line):
                        table <- walk_expression_for_shift_by_zero(callee, table)
                        for argument in arguments |table| -> table:
                            table <- walk_expression_for_shift_by_zero(argument, table)
                    Expr.Field(object, field, line):
                        table <- walk_expression_for_shift_by_zero(object, table)
                    Expr.Scope(base, name, line):
                        table <- walk_expression_for_shift_by_zero(base, table)
                    Expr.Index(object, index, line):
                        table <- walk_expression_for_shift_by_zero(object, table)
                        table <- walk_expression_for_shift_by_zero(index, table) if not index_receiver_is_type_application(object)
                    Expr.Unary(operator, operand, line):
                        table <- walk_expression_for_shift_by_zero(operand, table)
                    Expr.Paren(inner, line):
                        table <- walk_expression_for_shift_by_zero(inner, table)
                    Expr.Array(elements, line):
                        for element in elements |table| -> table:
                            table <- walk_expression_for_shift_by_zero(element, table)
                    Expr.Tuple(elements, line):
                        for element in elements |table| -> table:
                            table <- walk_expression_for_shift_by_zero(element, table)
                    Expr.Slice(object, low, high, line):
                        table <- walk_expression_for_shift_by_zero(object, table)
                        table <- walk_expression_for_shift_by_zero(low, table)
                        table <- walk_expression_for_shift_by_zero(high, table)
                    Expr.IndexN(object, arguments, line):
                        table <- walk_expression_for_shift_by_zero(object, table)
                        for argument in arguments |table| -> table:
                            table <- walk_expression_for_shift_by_zero(argument, table) if not index_receiver_is_type_application(object)
                    Expr.SetLit(elements, line):
                        for element in elements |table| -> table:
                            table <- walk_expression_for_shift_by_zero(element, table)
                    Expr.DictLit(entries, line):
                        for entry in entries |table| -> table:
                            table <- walk_expression_for_shift_by_zero(entry.key, table)
                            table <- walk_expression_for_shift_by_zero(entry.value, table)
                    Expr.Construct(type_expression, fields, line):
                        table <- walk_expression_for_shift_by_zero(type_expression, table)
                        for field in fields |table| -> table:
                            table <- walk_expression_for_shift_by_zero(field.value, table)
                    Expr.RecordUpdate(base, fields, line):
                        table <- walk_expression_for_shift_by_zero(base, table)
                        for field in fields |table| -> table:
                            table <- walk_expression_for_shift_by_zero(field.value, table)
                    Expr.If(condition, then_expr, else_expr, line):
                        table <- walk_expression_for_shift_by_zero(condition, table)
                        table <- walk_expression_for_shift_by_zero(then_expr, table)
                        table <- walk_expression_for_shift_by_zero(else_expr, table)
                    Expr.Comprehension(loop_variable, iterable, condition, body, line):
                        table <- walk_expression_for_shift_by_zero(iterable, table)
                        table <- walk_expression_for_shift_by_zero(condition, table)
                        table <- walk_expression_for_shift_by_zero(body, table)
                    Expr.Lambda(parameters, body, line):
                        table <- walk_statements_for_shift_by_zero(body, table)
                    Expr.Block(statements, value, captures, line):
                        table <- walk_statements_for_shift_by_zero(statements, table)
                        table <- walk_expression_for_shift_by_zero(value, table)
                    Expr.Match(scrutinee, arms, line):
                        table <- walk_expression_for_shift_by_zero(scrutinee, table)
                        for arm in arms |table| -> table:
                            table <- walk_statements_for_shift_by_zero(arm.body, table)
                    # Literals and other expression forms don't contain sub-expressions
                    _:
                        pass


        # Walk through statements, checking for shift-by-zero in expressions.
        def walk_statements_for_shift_by_zero(statements: darray[Ast::Stmt], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table|:
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- walk_expression_for_shift_by_zero(expression, table)
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- walk_expression_for_shift_by_zero(value, table)
                        Stmt.Assign(target, operator, value, line):
                            table <- walk_expression_for_shift_by_zero(target, table)
                            table <- walk_expression_for_shift_by_zero(value, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- walk_expression_for_shift_by_zero(condition, table)
                            table <- walk_statements_for_shift_by_zero(then_body, table)
                            table <- walk_statements_for_shift_by_zero(else_body, table)
                        Stmt.While(condition, body, line):
                            table <- walk_expression_for_shift_by_zero(condition, table)
                            table <- walk_statements_for_shift_by_zero(body, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- walk_expression_for_shift_by_zero(iterable, table)
                            table <- walk_statements_for_shift_by_zero(body, table)
                        Stmt.Return(value, line):
                            table <- walk_expression_for_shift_by_zero(return_value, table) if value is return_value
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- walk_statements_for_shift_by_zero(body, table)
                        Stmt.Match(scrutinee, arms, line):
                            table <- walk_expression_for_shift_by_zero(scrutinee, table)
                            for arm in arms |table|:
                                table <- walk_statements_for_shift_by_zero(arm.body, table)
                        Stmt.Contract(kind, expression, line):
                            table <- walk_expression_for_shift_by_zero(expression, table)
                        # No expressions in these statements
                        Stmt.Break(label, line):
                            pass
                        Stmt.Continue(label, line):
                            pass
                        Stmt.Invalid:
                            pass


        # Walk through function declarations, checking expressions in their bodies.
        def check_shift_by_zero(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table|:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            table <- walk_statements_for_shift_by_zero(body, table)
                        Decl.Module(module_name, body, line):
                            table <- check_shift_by_zero(body, table)
                        Decl.Scoped(body, line):
                            table <- check_shift_by_zero(body, table)
                        # Other declarations don't have bodies to check
                        _:
                            pass
