            # Effect-row registry (parallel arrays): entry i records that function
            # `function_effect_owner[i]` declares effect ref `function_effect_name[i]` in its
            # signature `can[...]` clause, one row per declared ref (dotted source text, e.g.
            # "Abort.Panic"; the parser keeps each comma-separated entry whole — NOT dot-split,
            # unlike the `can X:` block clause). Feeds call-site effect-requirement checking.
            function_effect_owner: mutable darray[sview @source]
            function_effect_name: mutable darray[sview @source]
            # Module for every row in function_effect_owner/name. Owner hashes remain
            # leaf-keyed; selected call paths filter rows through this parallel identity.
            function_effect_module: mutable darray[sview @source] = []
            # Module-scoped projection of extern signature effect rows. The declaration
            # arrays preserve even explicit empty `can[]` rows; the row arrays carry each
            # concrete ref under its exact module and extern leaf. Legacy owner-only rows
            # above remain available to consumers that do not resolve qualified calls.
            extern_effect_modules: mutable darray[sview @source] = []
            extern_effect_owners: mutable darray[sview @source] = []
            extern_effect_row_modules: mutable darray[sview @source] = []
            extern_effect_row_owners: mutable darray[sview @source] = []
            extern_effect_row_names: mutable darray[sview @source] = []
            extern_declaration_modules: mutable darray[sview @source] = []
            extern_declaration_owners: mutable darray[sview @source] = []
            extern_declaration_counts: mutable darray[usize] = []
            # Effect-source registry: names of functions whose body performs a `panic(...)`
            # NOT enclosed by a `trusted` block — i.e. functions that INFER the Abort effect
            # even without declaring it (a `can` block discharges locally but still propagates
            # the effect to the row; only `trusted` drops it — verified against stage0). One
            # hop of transitive inference: a call to such a function requires a local grant.
            function_effect_source_owner: mutable darray[sview @source]
            # Lexical module for each inferred source row. The owner hash remains leaf-keyed;
            # selected call lookups filter source rows by this exact module path.
            function_effect_source_module: mutable darray[sview @source]
            # function_effect_owner / function_effect_source_owner rows chained per owner hash
            # in ascending row order (effect_owner_* / effect_source_* in symbols_hash_index);
            # each chain is valid while its *_indexed count equals its array's count.
            effect_owner_heads: mutable dict[u64, u32] = {}
            effect_owner_tails: mutable dict[u64, u32] = {}
            effect_owner_next: mutable darray[u32] = []
            effect_owner_indexed: mutable usize = 0
            effect_source_heads: mutable dict[u64, u32] = {}
            effect_source_tails: mutable dict[u64, u32] = {}
            effect_source_next: mutable darray[u32] = []
            effect_source_indexed: mutable usize = 0
            # The effect ref inferred for that owner ("Console.Write" from a forwarded
            # call, "Abort.Panic" from an untrusted panic) — parallel to source_owner.
            function_effect_source_ref: mutable darray[sview @source]
            # Canonical inferred rows: exact declaration identity and member refs.
            # Spellings have owned permanent backing; all cross-links are numeric.
            effect_canonical_module_parent: mutable darray[usize] = []
            effect_canonical_module_name: mutable darray[sview @source] = []
            effect_canonical_function_name: mutable darray[sview @source] = []
            effect_canonical_function_scope: mutable darray[usize] = []
            effect_canonical_function_offset: mutable darray[u32] = []
            effect_canonical_offset_heads: mutable dict[u32, usize] = {}
            effect_canonical_offset_next: mutable darray[usize] = []
            effect_canonical_function_row_start: mutable darray[usize] = []
            effect_canonical_function_row_count: mutable darray[usize] = []
            effect_canonical_refs: mutable darray[sview @source] = []
            effect_canonical_row_function: mutable darray[usize] = []
            effect_canonical_row_ref: mutable darray[usize] = []
            effect_canonical_row_mandatory: mutable darray[bool] = []
            effect_canonical_row_scope: mutable darray[usize] = []
            effect_canonical_row_offset: mutable darray[u32] = []
            # Effect-row memo for function VALUES (check_fn_value_effect_row): one row per
            # (function, effect ref) pair as stage0's FuncType.Permissions would list it —
            # declared `can[...]`, body `can` blocks, Global, and every direct callee's row,
            # closed over the call graph. `fn_value_effect_done` lists the functions whose
            # rows are complete. Filled lazily, only for functions reachable from a site
            # where a function value meets a `fn(...)` type.
            fn_value_effect_owner: mutable darray[sview @source] = []
            fn_value_effect_ref: mutable darray[sview @source] = []
            fn_value_effect_done: mutable darray[sview @source] = []
            # Supplemental extern rows retain the declaration namespace while a
            # function-value site is checked against its canonical lambda row.
            fn_value_extern_collect: mutable bool = false
            fn_value_extern_ref: mutable darray[sview @source] = []
            fn_value_extern_scope: mutable darray[usize] = []
            fn_value_extern_offset: mutable darray[u32] = []
            # Exact name index over the whole unit's declarations for check_fn_value_effect_row,
            # built once per pass: per name, how many free functions / callable externs and
            # how many structs declare it, and the first such function declaration. The pass
            # asked these per call site by rescanning every declaration.
            fver_decl_names: mutable darray[sview @source] = []
            fver_decl_function_counts: mutable darray[u32] = []
            fver_decl_struct_counts: mutable darray[u32] = []
            fver_decl_function: mutable darray[Ast::Decl] = []
            # The first struct declaration of the name (a placeholder while struct_counts is 0).
            fver_decl_struct: mutable darray[Ast::Decl] = []
            fver_decl_has_function: mutable darray[bool] = []
            fver_decl_next: mutable darray[u32] = []
            fver_decl_heads: mutable dict[u64, u32] = {}
            # Concrete unsafe operations inferred from typed expressions. These are kept
            # separate from function_effect_*: the latter is the call/effect contract table,
            # while this registry is the lossless source for the unsafe audit (for example a
            # typed reference-to-integer cast has no explicit AST permission clause).
            function_unsafe_owner: mutable darray[sview @source] = []
            function_unsafe_name: mutable darray[sview @source] = []
            # Function-scoped generic declarations copied from Ast::File. Parallel
            # owner-line/name rows are consulted only when entering that function.
            protocol_annotations: mutable darray[Ast::EnumAnnotation] = []
            scoped_catch_annotations: mutable darray[Ast::EnumAnnotation] = []
            scoped_catch_annotations_active: mutable bool = false
            unknown_nominal_markers: mutable darray[Ast::EnumAnnotation] = []
            unknown_nominal_markers_active: mutable bool = false
            # The `__using_alias` / `__using_alias_target` rows of protocol_annotations, in
            # table order (set beside it): alias expansion pairs them per type path.
            using_alias_rows: mutable darray[Ast::EnumAnnotation] = []
            # Sparse scoped import records for binding capability lookup. Never scan
            # fields/effects/generic metadata once for every declared binding type.
            binding_import_annotations: mutable darray[Ast::EnumAnnotation] = []
            # The declaration-only projection of protocol_annotations. Unknown-interface
            # and protocol-constraint checks must not rescan the full annotation stream
            # (which also contains fields, effects, bindings, and generic metadata).
            protocol_declarations: mutable darray[Ast::EnumAnnotation] = []
            # Parser-recorded function-name spans. Symbol collection looks up one row for
            # every function declaration; keep this sparse projection separate from the
            # complete annotation stream so that lookup is proportional to function markers.
            function_name_annotations: mutable darray[Ast::EnumAnnotation] = []
            # Chains over function_name_annotations keyed by the declaration's byte offset
            # (newest row first). function_name_position reads one chain per declaration
            # instead of the whole projection: that scan was O(functions x markers).
            function_name_annotation_heads: mutable dict[u64, u32] = {}
            function_name_annotation_next: mutable darray[u32] = []
            # `@append_only` stores and the structs that hold one by value: induced borrowable
            # affine owners (symbols_append_only_affinity.elisa).
            append_only_holders: mutable darray[sview @source] = []
            # Names of generic externs, filtered once from protocol_annotations. Index
            # receiver classification is on a hot resolver path; retaining this sparse
            # projection avoids rescanning every parser annotation for every `f[T]`.
            generic_extern_names: mutable darray[sview @source] = []
            # The `__using` (wildcard import) rows of `protocol_annotations`, in order, and the
            # modules holding two or more of them with distinct owners -- the only modules
            # where a bare `Name.Member` can be ambiguous. Built once by
            # index_wildcard_imports; rew_ambiguous_wildcard_type_name runs for every bare
            # `Name.Member` expression and used to rescan every symbol each time.
            wildcard_import_rows: mutable darray[Ast::EnumAnnotation] = []
            wildcard_ambiguous_modules: mutable darray[sview @source] = []
            wildcard_imports_indexed: mutable bool = false
            # (function, position, field) rows from param_growth_summary.elisa.
            param_growth_rows: mutable darray[sview @source] = []
            # Populated by the serial lexical type resolver before parallel reporting.
            # These exact OR-pattern handles contain verified integer constant selectors.
            scalar_constant_or_patterns: mutable darray[Ast::Pattern] = []
            # Hash chains over published param-growth triples. Region-storage call sites
            # query these rows once per argument; keeping the projection here avoids a full
            # summary scan for every lookup. Links preserve source row order and hash
            # collisions are resolved against the original callee/tag strings.
            param_growth_index_heads: mutable dict[u64, u32] = {}
            param_growth_index_tails: mutable dict[u64, u32] = {}
            param_growth_index_next: mutable darray[u32] = []
            param_growth_indexed_triples: mutable usize = 0
            # Just the `__local_binding_mutable` / `__local_binding_immutable` /
            # `__loop_header_accumulator` rows of `protocol_annotations`. Those three names
            # are the only ones local_binding_is_mutable can ever match, so the filtered copy
            # answers identically -- but it is one row per QUALIFIED binding instead of one
            # per annotation in the unit. Walking the whole stream once per local binding is
            # O(bindings x annotations), and `sample` put 45% of stage1 compiling its own
            # source inside that loop.
            binding_annotations: mutable darray[Ast::EnumAnnotation] = []
            binding_annotation_exact_heads: mutable dict[u64, u32] = {}
            binding_annotation_exact_next: mutable darray[u32] = []
            binding_annotation_line_heads: mutable dict[u64, u32] = {}
            binding_annotation_line_next: mutable darray[u32] = []
            # check_firm_arg_type_mismatch: name_hash chains (push order) over its flattened
            # extern declaration list, so a call reads only the externs of its own name.
            firm_extern_heads: mutable dict[u64, u32] = {}
            firm_extern_tails: mutable dict[u64, u32] = {}
            firm_extern_next: mutable darray[u32] = []
            # The `__pattern_binder` / `__for_binder` rows of `protocol_annotations` that carry a
            # real source span, hashed by (name, line). source_binder_position runs once per local
            # declaration and loop binder; scanning the whole annotation stream there was
            # O(bindings x annotations) and a fifth of stage1 checking its own source.
            binder_annotations: mutable darray[Ast::EnumAnnotation] = []
            binder_annotation_heads: mutable dict[u64, u32] = {}
            binder_annotation_next: mutable darray[u32] = []
            binder_annotations_indexed: mutable bool = false
            # (struct_field_owner, struct_field_name) rows chained in row order, so
            # struct_field_row_for_type follows one chain instead of the whole field table.
            struct_field_pair_heads: mutable dict[u64, u32] = {}
            # struct_field rows chained by field name alone (ascending), for
            # check_private_fields' per-access lookup; ignored once stale.
            struct_field_by_name_heads: mutable dict[u64, u32] = {}
            struct_field_by_name_tails: mutable dict[u64, u32] = {}
            struct_field_by_name_next: mutable darray[u32] = []
            struct_field_by_name_indexed: mutable usize = 0
            struct_field_by_name_built: mutable bool = false
            struct_field_pair_tails: mutable dict[u64, u32] = {}
            struct_field_pair_next: mutable darray[u32] = []
            # struct_field_owner rows chained by OWNER name in row order, so "the fields of
            # struct S" and "does S declare any field" read one chain, not the whole table.
            struct_field_owner_heads: mutable dict[u64, u32] = {}
            struct_field_owner_tails: mutable dict[u64, u32] = {}
            struct_field_owner_next: mutable darray[u32] = []
            # Number of rows in each owner-name hash bucket. Independent of heads/tails so
            # readers can detect a missing or truncated chain before trusting it.
            struct_field_owner_counts: mutable dict[u64, u32] = {}
            # const_int_names rows chained by name (newest first) for the extent test that
            # runs once per bracketed type annotation.
            const_int_name_heads: mutable dict[u64, u32] = {}
            const_int_name_next: mutable darray[u32] = []
            # The `symbols` rows of kind Enum / Module, in strictly increasing row order
            # (appended by add_symbol).
            # check_variant_path and type_path_prefix_is_module visit only those kinds, and
            # a `for symbol in table.symbols` copied every Symbol of the unit per call.
            enum_symbol_rows: mutable darray[u32] = []
            module_symbol_rows: mutable darray[u32] = []
            # Independent count for detecting a missing/truncated module-row side index.
            module_symbol_rows_expected: mutable usize = 0
            # lmut_param_owner rows chained by owner name in row order, for the call-site
            # lmut aliasing lookups (one chain walk instead of a whole-table scan).
            lmut_param_heads: mutable dict[u64, u32] = {}
            lmut_param_tails: mutable dict[u64, u32] = {}
            lmut_param_next: mutable darray[u32] = []
            # Region-only function templates have no runtime type parameter rows; keep
            # their declaration identity in parallel line/offset vectors.
            region_generic_function_lines: mutable darray[u32] = []
            region_generic_function_offsets: mutable darray[u32] = []
            generic_param_lines: mutable darray[u32]
            generic_param_names: mutable darray[sview @source]
            generic_param_owner_offsets: mutable darray[u32]
            # generic_param_names rows chained per name hash (index_generic_param_names), valid
            # while generic_param_name_index_count equals generic_param_names.count.
            generic_param_name_heads: mutable dict[u64, u32] = {}
            generic_param_name_next: mutable darray[u32] = []
            generic_param_name_index_count: mutable usize = 0
            # Generic-bound checker indexes, rebuilt after source symbols and parser rows
            # are installed together. Source rows remain authoritative; count stamps make
            # incomplete indexes fail closed if either table grows later.
            generic_owner_line_counts: mutable dict[u32, u32] = {}
            # Counts source Func/Struct symbols, the only rows represented in the
            # generic owner index. Module aliases may be appended after indexing.
            generic_owner_source_symbol_count: mutable usize = 0
            generic_owner_index_symbol_count: mutable usize = 0
            generic_owner_index_built: mutable bool = false
            generic_bound_owner_lines: mutable dict[u32, bool] = {}
            generic_bound_index_param_count: mutable usize = 0
            generic_bound_index_built: mutable bool = false
            generic_bound_index_empty: mutable bool = false
            packed_enum_names: mutable darray[sview @source]
            # Enums written `packed enum X:` EXPLICITLY, as opposed to auto-promoted by
            # record_recursive_enum. Only a DECLARED packed enum carries the store-clause
            # requirement — the parser's own note on __declared_packed says an
            # auto-promoted recursive enum "must not inherit the explicit store-clause
            # requirement (stage0 accepts `match t:` on one)", and the same holds for its
            # CONSTRUCTORS. packed_enum_names holds both kinds, so it cannot answer this.
            declared_packed_names: mutable darray[sview @source]
            # docs/127 D9: `extern enum` names, and the subset marked `@open`. An extern enum
            # mirrors a C enum, whose value set is open at the ABI, so a raw integer may not be
            # reinterpreted as one (`Name.from_c` validates instead); an @open one additionally
            # cannot be matched exhaustively by naming its members.
            foreign_enum_names: mutable darray[sview @source] = []
            open_foreign_enum_names: mutable darray[sview @source] = []
            no_storage_foreign_enum_names: mutable darray[sview @source] = []
            # Module-qualified spelling (`Outer::Right::Message`) of every declared packed
            # enum declared inside a module; see packed_enum_of_scope_chain.
            qualified_packed_names: mutable darray[sview @source] = []
            # `const enum` names. stage0's non-exhaustive sentence says "missing members:" for a
            # const enum and "missing variants:" for a payload enum; this is how that is decided.
            const_enum_names: mutable darray[sview @source] = []
            # Enums marked `__ast_refinement` by record_recursive_enum: members of a
            # SEALED Node hierarchy. stage0 exempts these from the packed store-clause
            # requirement (it compiles the compiler's own bare `(Ast::Expr.Ident(...))`),
            # but NOT a plain user recursive enum — measured, one probe each.
            ast_refinement_names: mutable darray[sview @source]
            # Parameters carrying a DECLARED region tie (`def f[@r](m: mutable Mod& @r)`).
            # Storage reached through one is CALLER-provided, so nothing stored into it
            # escapes — stage0 returns early on exactly this
            # (region_containers.go: `if a.lookupRegionParam(region) { return }`).
            region_tied_param_names: mutable darray[sview @source]
            # Names introduced by `type X = fn(A) -> R`. SemTypeKind has no Fn variant, so the
            # alias resolves to `Named` and every call through it was reported as "cannot call
            # non-function value"; stage0 accepts. A fn TYPE parses to an Expr.Lambda — the
            # alias RHS is marked a type position precisely so it does (parser_decl_dispatch).
            fn_alias_names: mutable darray[sview @source]
            # Names of structs declared with an affinity discipline (`linear`/`affine`) — i.e.
            # single-use "linear handle" types. Feeds the affine-collection check: such a type
            # may not be a dict key or set element.
            struct_affine_owner: mutable darray[sview @source]
            # The declaring module for each struct_affine_owner row. Affinity checks use bare
            # type heads, so this parallel owner is needed to resolve imported module members
            # without accidentally treating a same-named type from another module as affine.
            struct_affine_module: mutable darray[sview @source] = []
            # User structs whose fields transitively contain an affine owner. Unlike
            # direct runtime handles, references to these aggregates are unsupported.
            struct_affine_container_owner: mutable darray[sview @source]
            # Structs DECLARED `linear`/`affine` — the subset of struct_affine_owner that is a
            # borrowable owner in stage0 (isBorrowableAffineOwnerType), so `T&` and `&value`
            # are accepted. A struct that is affine only because a field is stays unborrowable.
            struct_declared_affine_owner: mutable darray[sview @source] = []
            # Declaring module for each struct_declared_affine_owner row.
            struct_declared_affine_module: mutable darray[sview @source] = []
            # Structs with named derived states (`struct Player[state Alive | Dead]`).
            # Their bracketed state is a phantom qualifier, not a generic type argument;
            # the reference-initializer checker uses this registry to allow the stage0
            # widening `Player[Alive]& -> Player&` without weakening nominal generic checks.
            typestate_struct_names: mutable darray[sview @source] = []
            # Names of immutable `const` declarations (NOT `global`s). A `<-`/compound
            # assignment to one of these is rejected (cannot assign to immutable const).
            immutable_const_names: mutable darray[sview @source]
            immutable_const_rows: mutable darray[u32] = []
            immutable_const_values: mutable darray[Ast::Expr] = []
            # Name chain over immutable_const_names (the const_int chain's shape): every row
            # named X is reachable in O(X's own count). Appended in lockstep with the push.
            immutable_const_name_heads: mutable dict[u64, u32] = {}
            immutable_const_name_next: mutable darray[u32] = []
            const_int_names: mutable darray[sview @source]
            const_int_values: mutable darray[i64]
            # Per-occurrence resolution log for tooling (the LSP's semantic-token
            # highlighter): each referenced or declared param/local name is
            # recorded as parallel arrays — occurrence i is at line `ref_line[i]`,
            # spells `ref_name[i]`, and resolves to kind `ref_kind[i]`
            # (1 = parameter, 2 = local). Looked up by (line, name): the AST keeps
            # only line per identifier, but two distinct resolutions of one name
            # on one line is vanishingly rare (fields are handled separately).
            ref_line: mutable darray[u32]
            ref_name: mutable darray[sview @source]
            ref_kind: mutable darray[u8]
            # Exact source span for each tooling occurrence. All-zero positions are
            # reserved for synthesized binders or AST shapes whose source token span
            # is not retained; source-backed expressions and ordinary declarations
            # carry their token span.
            ref_pos: mutable darray[Ast::Pos] = []
            # Transient: how many leading `bound` entries are the current
            # function's parameters (indices below it are params, the rest
            # locals). Set per function before its body is resolved.
            current_param_count: mutable usize
            # Transient: enclosing `for`/`while` nesting depth during resolution.
            # >0 inside a loop body; a `break`/`continue` at depth 0 is outside any
            # loop. Reset to 0 at each function entry.
            current_loop_depth: mutable usize
            # --- The flat interned TYPE TABLE (Phase C; stage0 typeid.go analogue) ---
            # Structural types (tuples/optionals/refs/generic instances) as parallel
            # rows: row i (TypeId i+1; id 0 = "no type"/Unknown) has kind
            # `type_row_kind[i]`, head spelling `type_row_name[i]` (Named/Container
            # only, "" otherwise), and element TypeIds
            # `type_elem_pool[type_row_elem_start[i] .. +type_row_elem_count[i]]`.
            # Rows are DEDUPED on insert (intern_type), so TypeId equality IS type
            # equality. This keeps `InferType` POD (see its DESIGN NOTE): structure
            # lives here, reached through the SymbolTable& every check already has.
            type_row_kind: mutable darray[SemTypeKind]
            type_row_name: mutable darray[sview @source]
            type_row_elem_start: mutable darray[u32]
            type_row_elem_count: mutable darray[u32]
            type_elem_pool: mutable darray[u32]
            # Parallel identity slot for region type rows; all other type rows carry
            # RegionId{0}. A source name alone is never a lifetime identity.
            type_row_region_ids: mutable darray[u32] = []
            # Type rows chained by type_row_hash(name, elems), newest row first. The
            # intern functions walk one chain and keep the LAST match (the earliest row), which
            # is the row the former front-to-back scan of every type row returned. The region
            # id is deliberately not part of the key: the unscoped matchers ignore it.
            type_row_heads: mutable dict[u64, u32] = {}
            type_row_next: mutable darray[u32] = []
            # Transient (reset per function): the current function's local bindings'
            # STRUCTURAL types — parallel arrays mapping a local's name to its
            # annotation's interned TypeId (0 = unannotated/unmodeled; a name
            # re-declared with a different id degrades to 0, mirroring the flat
            # name/type-name table's shadowing conservatism). Lets
            # infer_expression_type see container/optional/ref locals without
            # threading a third parallel array through every check signature.
            # Two-field tuple ANNOTATION spellings per binding (stage0-parity type
            # text): binding name -> (label1, type1, label2, type2). Populated from
            # the parser's __tuple_label rows before the tuple sidecar runs.
            tuple_binding_names: mutable darray[sview @source]
            tuple_binding_offsets: mutable darray[usize]
            tuple_binding_l1: mutable darray[sview @source]
            tuple_binding_t1: mutable darray[sview @source]
            tuple_binding_l2: mutable darray[sview @source]
            tuple_binding_t2: mutable darray[sview @source]
            local_type_names: mutable darray[sview @source]
            local_type_ids: mutable darray[u32]
            # Nominal const-enum owner for each transient local type row. The ordinary
            # InferType channel intentionally keeps only bare names; these parallel slots
            # retain the module identity written in parameter/local annotations.
            local_const_enum_owner_names: mutable darray[sview @source] = []
            local_const_enum_owner_modules: mutable darray[sview @source] = []
            # Transient: AST-walk recursion depth. A pathological deeply left-nested
            # expression (`a.b.b.b…`, `a()()()…`, `a+a+a+…` — parsed by a loop, so
            # the parser's own depth guard never sees it) is bounded here so the
            # recursive resolver walkers stop instead of overflowing the stack.
            walk_depth: mutable u32
            # Backing bytes for names a diagnostic SYNTHESISES (a module path re-joined
            # with `::`). Reserved once, never reallocated while in use, so the sviews the
            # diagnostics hold into it stay valid -- the same discipline as the parser's
            # module_name_store.
            text_storage: mutable darray[u8]
            # Joined names a check synthesises (`a.b` field keys, `M::T` paths), interned once
            # into an append-only program-region store: the views are `sview @source` and stay
            # valid by construction (a full buffer is retired, never moved). Equal texts share
            # one row through the FNV chain below, so re-joining a key costs no memory.
            joined_text: mutable NameStore::Store
            joined_text_heads: mutable dict[u64, u32]
            joined_text_rows: mutable darray[sview @source] = []
            joined_text_next: mutable darray[u32] = []
            # Source-lifetime views backing diagnostic text copied from parallel jobs.
            # The bytes are appended to the existing append-only joined-text store.
            parallel_diagnostic_text: mutable darray[sview @source] = []
            # Externs rewritten by `@bounds`: the extern name and the length parameter it
            # removed, so an arity mismatch can say where the length now comes from (D6).
            extern_bounds_owner: mutable darray[sview @source]
            extern_bounds_length: mutable darray[sview @source]
            # Binding identity parallel to the tooling reference rows above. Declaration
            # occurrences and resolved reads share the same BindingId; equal spellings in
            # nested scopes do not. `owner` is the enclosing function DeclId.
            ref_binding_ids: mutable darray[BindingId]
            # Owner-keyed linked index into the parallel reference arrays above. Each head
            # is a Symbol row; each next entry is keyed by reference row. Per-owner counts
            # and tails let consumers detect a truncated but otherwise well-formed chain.
            # `valid` stays false if a reference row cannot be represented by its u32 links.
            ref_owner_heads: mutable darray[u32] = []
            ref_owner_tails: mutable darray[u32] = []
            ref_owner_counts: mutable darray[u32] = []
            # Canonical per-owner row totals, maintained beside (not from) the
            # linked buckets so consumers can detect a bucket that falsely says empty.
            ref_owner_observed_counts: mutable darray[usize] = []
            ref_owner_next: mutable darray[u32] = []
            ref_owner_index_valid: mutable bool = true
            next_binding_serial: mutable u64
            current_function_decl_id: mutable DeclId
