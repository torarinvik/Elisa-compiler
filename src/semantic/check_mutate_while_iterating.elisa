# Iterator invalidation: a `for v in xs:` loop that grows `xs` inside the body (`xs.push(...)`,
# `xs.extend(...)`, `xs.insert(...)`) can reallocate the darray's buffer out from under the live
# iterator. stage0 rejects it. SOUND, structural: the iterable is a bare Ident or an
# Ident-rooted field chain (`s.items`, `o.s.items`) and the body calls a relocating method on
# that place (including through a local reference alias), replaces it, or passes it by `mutable&`.
# Reads and mutations of a DIFFERENT container are fine; `for v in move xs:` (a drain) is a
# separate consuming construct.
include "./iterator_alias_resolution.elisa"
include "./iterator_mutation_policy.elisa"

extend Semantic:
    private:
        # Whether EXPRESSION names the iterated PLACE. A bare-Ident place compares by name
        # (`container`); a field-chain place compares structurally, so `s.items` matches
        # `s.items` but neither `s.other` nor `t.items`.
        def iter_place_hit(expression: Ast::Expr, place: Ast::Expr, container: sview) -> bool:
            can Abort.Panic:
                false return if container == ""
                match place:
                    Expr.Ident(place_name, place_line):
                        return ident_name_of(expression) == container
                    _:
                        return storage_view_same_place(storage_view_strip_paren_move(expression), place)

        # The iterable's quoted spelling, as stage0 prints it: the identifier itself, or the
        # field chain re-joined with `.` into text_storage (a stable Diagnostic sview). "" for
        # any other iterable — a call, an index, a `::` path — which this check leaves alone.
        def iter_place_text(iterable: Ast::Expr, table: lmut SymbolTable) -> sview @source:
            can Memory.Allocate, Abort.Panic:
                match iterable:
                    Expr.Ident(iterable_name, iterable_line):
                        return iterable_name
                    Expr.Field(iterable_object, iterable_field, iterable_field_line):
                        names: mutable darray[sview] = []
                        dotted: mutable darray[bool] = []
                        return sview("", 0, 0) if:
                            not type_path_collect(iterable, names, dotted)
                            any was_dotted in dotted where not was_dotted
                        rebind joined: sview @source, table = type_path_text(names, 0, names.count, dotted, 0, table)
                        return joined
                    _:
                        return sview("", 0, 0)

        # The mutation-policy method name a statement expression calls on the iterated place
        # (`container.push(..)` -> "push"), else "". Resolve a bare receiver through local
        # reference aliases too (`alias = &container; alias.push(..)`).
        def iter_direct_mutation_method(expression: Ast::Expr, place: Ast::Expr, container: sview, alias_names: darray[sview]&, alias_targets: darray[sview]&) -> sview:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, line):
                        match callee:
                            Expr.Field(receiver, method_name, field_line):
                                # Use the proved policy for buffer-changing growth and
                                # count-changing operations that stage0 rejects during iteration.
                                # `resize` can grow through emit_darray_push, so it belongs here.
                                forbidden: bool = SemanticIteratorMutationPolicy::forbidden_during_iteration(method_name)
                                receiver_is_place: mutable bool = iter_place_hit(receiver, place, container)
                                receiver_name: sview = ident_name_of(receiver)
                                if receiver_name != "":
                                    resolved_receiver: sview = SemanticIteratorAliasResolution::resolve(alias_names, alias_targets, receiver_name)
                                    receiver_is_place <- SemanticIteratorAliasResolution::may_name(resolved_receiver, container)
                                method_name return if forbidden and receiver_is_place
                            _:
                                pass
                        return sview("", 0, 0)
                    _:
                        return sview("", 0, 0)

        # Return the first forbidden method call anywhere in an evaluated expression. A push
        # hidden in a condition, initializer, call argument, or value block invalidates the same
        # iterator as a top-level `xs.push(...)` statement.
        def iter_mutation_method(expression: Ast::Expr, place: Ast::Expr, container: sview, alias_names: darray[sview]&, alias_targets: darray[sview]&) -> sview:
            can Memory.Allocate, Abort.Panic:
                direct: sview = iter_direct_mutation_method(expression, place, container, alias_names, alias_targets)
                return direct if direct != ""
                match expression:
                    Expr.Call(callee, arguments, argument_names, line):
                        match callee:
                            Expr.Lambda(lambda_params, lambda_body, lambda_line):
                                lambda_alias_names: mutable darray[sview] = []
                                lambda_alias_names.extend(alias_names)
                                lambda_alias_targets: mutable darray[sview] = []
                                lambda_alias_targets.extend(alias_targets)
                                iter_collect_aliases(lambda_body, lambda_alias_names, lambda_alias_targets)
                                nested_lambda: sview = iter_statement_mutation_method(lambda_body, place, container, lambda_alias_names, lambda_alias_targets)
                                return nested_lambda if nested_lambda != ""
                            _:
                                nested_callee: sview = iter_mutation_method(callee, place, container, alias_names, alias_targets)
                                return nested_callee if nested_callee != ""
                        for argument in arguments |place, container, alias_names, alias_targets|:
                            nested_argument: sview = iter_mutation_method(argument, place, container, alias_names, alias_targets)
                            return nested_argument if nested_argument != ""
                    Expr.StaticEffectCall(effect_type, operation, candidates, arguments, argument_names, line):
                        nested_type: sview = iter_mutation_method(effect_type, place, container, alias_names, alias_targets)
                        return nested_type if nested_type != ""
                        for candidate in candidates |place, container, alias_names, alias_targets|:
                            for capture in candidate.captures |place, container, alias_names, alias_targets|:
                                nested_capture: sview = iter_mutation_method(capture, place, container, alias_names, alias_targets)
                                return nested_capture if nested_capture != ""
                        for argument in arguments |place, container, alias_names, alias_targets|:
                            nested_argument: sview = iter_mutation_method(argument, place, container, alias_names, alias_targets)
                            return nested_argument if nested_argument != ""
                    Expr.Field(object, field, line) | Expr.Scope(object, field, line):
                        return iter_mutation_method(object, place, container, alias_names, alias_targets)
                    Expr.Index(object, index, line):
                        nested_object: sview = iter_mutation_method(object, place, container, alias_names, alias_targets)
                        return nested_object if nested_object != ""
                        return iter_mutation_method(index, place, container, alias_names, alias_targets)
                    Expr.Slice(object, low, high, line):
                        nested_object: sview = iter_mutation_method(object, place, container, alias_names, alias_targets)
                        return nested_object if nested_object != ""
                        nested_low: sview = iter_mutation_method(low, place, container, alias_names, alias_targets)
                        return nested_low if nested_low != ""
                        return iter_mutation_method(high, place, container, alias_names, alias_targets)
                    Expr.IndexN(object, arguments, line):
                        nested_object: sview = iter_mutation_method(object, place, container, alias_names, alias_targets)
                        return nested_object if nested_object != ""
                        for argument in arguments |place, container, alias_names, alias_targets|:
                            nested_argument: sview = iter_mutation_method(argument, place, container, alias_names, alias_targets)
                            return nested_argument if nested_argument != ""
                    Expr.Binary(left, operator, right, line):
                        nested_left: sview = iter_mutation_method(left, place, container, alias_names, alias_targets)
                        return nested_left if nested_left != ""
                        return iter_mutation_method(right, place, container, alias_names, alias_targets)
                    Expr.Unary(operator, operand, line) | Expr.Move(operand, line) | Expr.RegionNew(operand, _, line) | Expr.Paren(operand, line):
                        return iter_mutation_method(operand, place, container, alias_names, alias_targets)
                    Expr.Array(elements, line) | Expr.Tuple(elements, line) | Expr.SetLit(elements, line):
                        for element in elements |place, container, alias_names, alias_targets|:
                            nested_element: sview = iter_mutation_method(element, place, container, alias_names, alias_targets)
                            return nested_element if nested_element != ""
                    Expr.DictLit(entries, line):
                        for entry in entries |place, container, alias_names, alias_targets|:
                            nested_key: sview = iter_mutation_method(entry.key, place, container, alias_names, alias_targets)
                            return nested_key if nested_key != ""
                            nested_value: sview = iter_mutation_method(entry.value, place, container, alias_names, alias_targets)
                            return nested_value if nested_value != ""
                    Expr.Construct(type_expression, fields, line) | Expr.RecordUpdate(type_expression, fields, line):
                        nested_base: sview = iter_mutation_method(type_expression, place, container, alias_names, alias_targets)
                        return nested_base if nested_base != ""
                        for field in fields |place, container, alias_names, alias_targets|:
                            nested_value: sview = iter_mutation_method(field.value, place, container, alias_names, alias_targets)
                            return nested_value if nested_value != ""
                    Expr.If(condition, then_value, else_value, line):
                        nested_condition: sview = iter_mutation_method(condition, place, container, alias_names, alias_targets)
                        return nested_condition if nested_condition != ""
                        nested_then: sview = iter_mutation_method(then_value, place, container, alias_names, alias_targets)
                        return nested_then if nested_then != ""
                        return iter_mutation_method(else_value, place, container, alias_names, alias_targets)
                    Expr.Match(scrutinee, arms, line) | Expr.Catch(scrutinee, arms, line):
                        nested_scrutinee: sview = iter_mutation_method(scrutinee, place, container, alias_names, alias_targets)
                        return nested_scrutinee if nested_scrutinee != ""
                        for arm in arms |place, container, alias_names, alias_targets|:
                            arm_alias_names: mutable darray[sview] = []
                            arm_alias_names.extend(alias_names)
                            arm_alias_targets: mutable darray[sview] = []
                            arm_alias_targets.extend(alias_targets)
                            iter_collect_aliases(arm.body, arm_alias_names, arm_alias_targets)
                            nested_guard: sview = iter_mutation_method(arm.guard, place, container, arm_alias_names, arm_alias_targets)
                            return nested_guard if nested_guard != ""
                            nested_body: sview = iter_statement_mutation_method(arm.body, place, container, arm_alias_names, arm_alias_targets)
                            return nested_body if nested_body != ""
                    Expr.Comprehension(variable, iterable, condition, body, line):
                        nested_iterable: sview = iter_mutation_method(iterable, place, container, alias_names, alias_targets)
                        return nested_iterable if nested_iterable != ""
                        nested_condition: sview = iter_mutation_method(condition, place, container, alias_names, alias_targets)
                        return nested_condition if nested_condition != ""
                        return iter_mutation_method(body, place, container, alias_names, alias_targets)
                    Expr.Refinement(base, predicate, line):
                        nested_base: sview = iter_mutation_method(base, place, container, alias_names, alias_targets)
                        return nested_base if nested_base != ""
                        return iter_mutation_method(predicate, place, container, alias_names, alias_targets)
                    Expr.GetElse(guarded, recovery, line):
                        nested_guarded: sview = iter_mutation_method(guarded, place, container, alias_names, alias_targets)
                        return nested_guarded if nested_guarded != ""
                        recovery_alias_names: mutable darray[sview] = []
                        recovery_alias_names.extend(alias_names)
                        recovery_alias_targets: mutable darray[sview] = []
                        recovery_alias_targets.extend(alias_targets)
                        iter_collect_aliases(recovery, recovery_alias_names, recovery_alias_targets)
                        return iter_statement_mutation_method(recovery, place, container, recovery_alias_names, recovery_alias_targets)
                    Expr.Block(statements, value, captures, line):
                        block_alias_names: mutable darray[sview] = []
                        block_alias_names.extend(alias_names)
                        block_alias_targets: mutable darray[sview] = []
                        block_alias_targets.extend(alias_targets)
                        iter_collect_aliases(statements, block_alias_names, block_alias_targets)
                        nested_statements: sview = iter_statement_mutation_method(statements, place, container, block_alias_names, block_alias_targets)
                        return nested_statements if nested_statements != ""
                        return iter_mutation_method(value, place, container, block_alias_names, block_alias_targets)
                    _:
                        pass
                return sview("", 0, 0)

        def iter_statement_mutation_method(statements: darray[Ast::Stmt], place: Ast::Expr, container: sview, alias_names: darray[sview]&, alias_targets: darray[sview]&) -> sview:
            can Memory.Allocate, Abort.Panic:
                for statement in statements:
                    match statement:
                        Stmt.Expr(expression, line):
                            nested: sview = iter_mutation_method(expression, place, container, alias_names, alias_targets)
                            return nested if nested != ""
                        Stmt.Block(kind, clause, binding, body, line):
                            nested: sview = iter_statement_mutation_method(body, place, container, alias_names, alias_targets)
                            return nested if nested != ""
                        Stmt.VarDecl(name, type_expression, value, line):
                            nested: sview = iter_mutation_method(value, place, container, alias_names, alias_targets)
                            return nested if nested != ""
                        Stmt.Assign(target, operator, value, line):
                            nested_target: sview = iter_mutation_method(target, place, container, alias_names, alias_targets)
                            return nested_target if nested_target != ""
                            nested_value: sview = iter_mutation_method(value, place, container, alias_names, alias_targets)
                            return nested_value if nested_value != ""
                        Stmt.If(condition, then_body, else_body, line):
                            nested_condition: sview = iter_mutation_method(condition, place, container, alias_names, alias_targets)
                            return nested_condition if nested_condition != ""
                            nested_then: sview = iter_statement_mutation_method(then_body, place, container, alias_names, alias_targets)
                            return nested_then if nested_then != ""
                            nested_else: sview = iter_statement_mutation_method(else_body, place, container, alias_names, alias_targets)
                            return nested_else if nested_else != ""
                        Stmt.While(condition, body, line):
                            nested_condition: sview = iter_mutation_method(condition, place, container, alias_names, alias_targets)
                            return nested_condition if nested_condition != ""
                            return iter_statement_mutation_method(body, place, container, alias_names, alias_targets)
                        Stmt.For(bind, variables, iterable, body, line):
                            nested_iterable: sview = iter_mutation_method(iterable, place, container, alias_names, alias_targets)
                            return nested_iterable if nested_iterable != ""
                            return iter_statement_mutation_method(body, place, container, alias_names, alias_targets)
                        Stmt.Return(value, line):
                            if value is returned:
                                nested: sview = iter_mutation_method(returned, place, container, alias_names, alias_targets)
                                return nested if nested != ""
                        Stmt.Match(scrutinee, arms, line):
                            nested_scrutinee: sview = iter_mutation_method(scrutinee, place, container, alias_names, alias_targets)
                            return nested_scrutinee if nested_scrutinee != ""
                            for arm in arms:
                                nested_guard: sview = iter_mutation_method(arm.guard, place, container, alias_names, alias_targets)
                                return nested_guard if nested_guard != ""
                                nested_body: sview = iter_statement_mutation_method(arm.body, place, container, alias_names, alias_targets)
                                return nested_body if nested_body != ""
                        Stmt.Contract(kind, expression, line):
                            nested: sview = iter_mutation_method(expression, place, container, alias_names, alias_targets)
                            return nested if nested != ""
                        _:
                            pass
                return sview("", 0, 0)

        # Collect reference-alias locals: `ys: T& = &xs` binds `ys` to container `xs`, so passing
        # `ys` by mutable ref is passing `xs`. Bare identifier copies and rebinding assignments are
        # included as possible aliases too. Duplicate names become unknown in the resolver, which
        # is conservative across branches and shadowed scopes. Parallel (names, targets).
        def iter_alias_value_target(value: Ast::Expr) -> sview:
            can Abort.Panic:
                stripped: Ast::Expr = storage_view_strip_paren_move(value)
                return match stripped:
                    Expr.Unary(operator, operand, unary_line):
                        ident_name_of(operand) if operator == TokenKind.Ampersand else sview("", 0, 0)
                    Expr.Ident(_, _):
                        ident_name_of(stripped)
                    _:
                        sview("", 0, 0)

        def iter_collect_alias_binding(name: sview, value: Ast::Expr, names: mutable darray[sview]&, targets: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                target: sview = iter_alias_value_target(value)
                if target != "" and name != "":
                    names.push(name)
                    targets.push(target)

        def iter_collect_aliases(statements: darray[Ast::Stmt], names: mutable darray[sview]&, targets: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |names, targets|:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            iter_collect_alias_binding(name, value, names, targets)
                        Stmt.Assign(target, operator, value, line):
                            alias_name: sview = ident_name_of(storage_view_strip_paren_move(target))
                            iter_collect_alias_binding(alias_name, value, names, targets) if operator == TokenKind.Assign or operator == TokenKind.LArrow
                        Stmt.If(condition, then_body, else_body, if_line):
                            iter_collect_aliases(then_body, names, targets)
                            iter_collect_aliases(else_body, names, targets)
                        Stmt.While(condition, while_body, while_line):
                            iter_collect_aliases(while_body, names, targets)
                        Stmt.For(bind, variables, iterable, for_body, for_line):
                            iter_collect_aliases(for_body, names, targets)
                        Stmt.Block(block_kind, clause, binding, block_body, block_line):
                            iter_collect_aliases(block_body, names, targets)
                        Stmt.Match(scrutinee, arms, match_line):
                            for arm in arms |names, targets|:
                                iter_collect_aliases(arm.body, names, targets)
                        _:
                            pass

        # The container ident an argument names, seeing through a leading `&` (`&xs` -> "xs") and a
        # reference-alias local (`ys` where `ys = &xs` -> "xs").
        def iter_arg_reference_name(argument: Ast::Expr) -> sview:
            can Abort.Panic:
                return match argument:
                    Expr.Unary(operator, operand, unary_line):
                        ident_name_of(operand) if operator == TokenKind.Ampersand else ident_name_of(argument)
                    _:
                        ident_name_of(argument)

        def iter_arg_container_name(argument: Ast::Expr, alias_names: darray[sview]&, alias_targets: darray[sview]&) -> sview:
            can Memory.Allocate, Abort.Panic:
                raw: sview = iter_arg_reference_name(argument)
                return SemanticIteratorAliasResolution::resolve(alias_names, alias_targets, raw)

        # A cycle resolves to the empty sentinel. A mutable-reference call through that alias is
        # conservatively treated as potentially reaching the active iterator source.
        def iter_arg_has_unresolved_alias(argument: Ast::Expr, alias_names: darray[sview]&, alias_targets: darray[sview]&) -> bool:
            can Abort.Panic:
                raw: sview = iter_arg_reference_name(argument)
                return false if raw == ""
                resolved: sview = SemanticIteratorAliasResolution::resolve(alias_names, alias_targets, raw)
                return resolved == "" and SemanticIteratorAliasResolution::direct_target_found(alias_names, alias_targets, raw)

        # Whether ARGUMENT names the active iterator place, through parens, move, a leading
        # `&`, or a local reference alias. Field-chain places compare structurally.
        def iter_call_argument_hits_place(argument: Ast::Expr, place: Ast::Expr, container: sview, alias_names: darray[sview]&, alias_targets: darray[sview]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                normalized: mutable Ast::Expr = storage_view_strip_paren_move(argument)
                match normalized:
                    Expr.Unary(operator, operand, line):
                        normalized <- storage_view_strip_paren_move(operand) if operator == TokenKind.Ampersand
                    _:
                        pass
                if ident_name_of(place) != "":
                    argument_root: sview = iter_arg_container_name(normalized, alias_names, alias_targets)
                    return argument_root == container or iter_arg_has_unresolved_alias(normalized, alias_names, alias_targets)
                return iter_place_hit(normalized, place, container)

        # Resolve named arguments to their actual formal slot before reading the parameter's
        # mutability. Positional indices count only preceding positional arguments, matching
        # the call resolver's treatment of mixed/named calls.
        def iter_call_argument_is_mutable_ref(table: SymbolTable&, callee: sview, positional_index: u32, argument_name: sview) -> bool:
            can Abort.Panic:
                parameter_row: u32 = function_param_row_for_call(table, callee, positional_index, argument_name)
                return false if parameter_row == GENERIC_CALL_NO_ROW
                return table.function_param_mutable_ref[parameter_row.usize()]

        # The call-node case shared by ordinary, UFCS, and static-effect expressions.
        # A mutable-reference parameter can replace/grow the exact iterated container; for
        # a field-chain source, the same structural comparison also catches `&owner.items`.
        def iter_direct_call_passes_container_by_ref(expression: Ast::Expr, place: Ast::Expr, container: sview, alias_names: darray[sview]&, alias_targets: darray[sview]&, table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, line):
                        found: mutable bool = false
                        match callee:
                            Expr.Ident(callee_name, ident_line):
                                positional_index: mutable u32 = 0
                                for argument_index in 0..<arguments.count |found, positional_index, arguments, argument_names, callee_name, table, place, container, alias_names, alias_targets|:
                                    argument_name: sview = argument_names[argument_index] if argument_index < argument_names.count else ""
                                    argument: Ast::Expr = arguments[argument_index]
                                    found <- true if container != "" and iter_call_argument_is_mutable_ref(table, callee_name, positional_index, argument_name) and iter_call_argument_hits_place(argument, place, container, alias_names, alias_targets)
                                    positional_index <- positional_index + 1.u32() if argument_name == ""
                            Expr.Scope(scope_base, callee_name, scope_line):
                                positional_index: mutable u32 = 0
                                for argument_index in 0..<arguments.count |found, positional_index, arguments, argument_names, callee_name, table, place, container, alias_names, alias_targets|:
                                    argument_name: sview = argument_names[argument_index] if argument_index < argument_names.count else ""
                                    argument: Ast::Expr = arguments[argument_index]
                                    found <- true if container != "" and iter_call_argument_is_mutable_ref(table, callee_name, positional_index, argument_name) and iter_call_argument_hits_place(argument, place, container, alias_names, alias_targets)
                                    positional_index <- positional_index + 1.u32() if argument_name == ""
                            Expr.Field(receiver, method_name, field_line):
                                positional_index: mutable u32 = 1
                                found <- true if container != "" and iter_call_argument_is_mutable_ref(table, method_name, 0, "") and iter_call_argument_hits_place(receiver, place, container, alias_names, alias_targets)
                                for argument_index in 0..<arguments.count |found, positional_index, arguments, argument_names, method_name, table, place, container, alias_names, alias_targets|:
                                    argument_name: sview = argument_names[argument_index] if argument_index < argument_names.count else ""
                                    argument: Ast::Expr = arguments[argument_index]
                                    found <- true if container != "" and iter_call_argument_is_mutable_ref(table, method_name, positional_index, argument_name) and iter_call_argument_hits_place(argument, place, container, alias_names, alias_targets)
                                    positional_index <- positional_index + 1.u32() if argument_name == ""
                            _:
                                pass
                        return found
                    Expr.StaticEffectCall(effect_type, operation, candidates, arguments, argument_names, line):
                        found: mutable bool = false
                        for candidate in candidates |found, arguments, alias_names, alias_targets, table, place, container|:
                            positional_index: mutable u32 = 0
                            for capture in candidate.captures |found, positional_index, candidate, arguments, alias_names, alias_targets, table, place, container|:
                                found <- true if container != "" and iter_call_argument_is_mutable_ref(table, candidate.callee, positional_index, "") and iter_call_argument_hits_place(capture, place, container, alias_names, alias_targets)
                                positional_index <- positional_index + 1.u32()
                            for argument_index in 0..<arguments.count |found, positional_index, candidate, arguments, argument_names, alias_names, alias_targets, table, place, container|:
                                argument_name: sview = argument_names[argument_index] if argument_index < argument_names.count else ""
                                argument: Ast::Expr = arguments[argument_index]
                                found <- true if container != "" and iter_call_argument_is_mutable_ref(table, candidate.callee, positional_index, argument_name) and iter_call_argument_hits_place(argument, place, container, alias_names, alias_targets)
                                positional_index <- positional_index + 1.u32() if argument_name == ""
                        return found
                    _:
                        return false

        # Search every expression evaluated while the loop is active. In particular, calls
        # can be nested under conditions, initializers, match/catch arms, blocks and the
        # recovery side of `get`; checking only a bare Stmt.Expr misses those calls.
        def iter_call_passes_container_by_ref(expression: Ast::Expr, place: Ast::Expr, container: sview, alias_names: darray[sview]&, alias_targets: darray[sview]&, table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                found: mutable bool = iter_direct_call_passes_container_by_ref(expression, place, container, alias_names, alias_targets, table)
                match expression:
                    Expr.Call(callee, arguments, argument_names, line):
                        match callee:
                            Expr.Lambda(lambda_params, lambda_body, lambda_line):
                                lambda_alias_names: mutable darray[sview] = []
                                lambda_alias_names.extend(alias_names)
                                lambda_alias_targets: mutable darray[sview] = []
                                lambda_alias_targets.extend(alias_targets)
                                iter_collect_aliases(lambda_body, lambda_alias_names, lambda_alias_targets)
                                found <- true if not found and iter_statement_call_passes_container_by_ref(lambda_body, place, container, lambda_alias_names, lambda_alias_targets, table)
                            _:
                                found <- true if not found and iter_call_passes_container_by_ref(callee, place, container, alias_names, alias_targets, table)
                        for argument in arguments |found, callee, place, container, alias_names, alias_targets, table|:
                            found <- true if not found and iter_call_passes_container_by_ref(argument, place, container, alias_names, alias_targets, table)
                    Expr.StaticEffectCall(effect_type, operation, candidates, arguments, argument_names, line):
                        found <- true if not found and iter_call_passes_container_by_ref(effect_type, place, container, alias_names, alias_targets, table)
                        for candidate in candidates |found, arguments, place, container, alias_names, alias_targets, table|:
                            for capture in candidate.captures |found, place, container, alias_names, alias_targets, table|:
                                found <- true if not found and iter_call_passes_container_by_ref(capture, place, container, alias_names, alias_targets, table)
                        for argument in arguments |found, place, container, alias_names, alias_targets, table|:
                            found <- true if not found and iter_call_passes_container_by_ref(argument, place, container, alias_names, alias_targets, table)
                    Expr.Field(object, field, line) | Expr.Scope(object, field, line):
                        found <- true if not found and iter_call_passes_container_by_ref(object, place, container, alias_names, alias_targets, table)
                    Expr.Index(object, index, line):
                        found <- true if not found and iter_call_passes_container_by_ref(object, place, container, alias_names, alias_targets, table)
                        found <- true if not found and iter_call_passes_container_by_ref(index, place, container, alias_names, alias_targets, table)
                    Expr.Slice(object, low, high, line):
                        found <- true if not found and iter_call_passes_container_by_ref(object, place, container, alias_names, alias_targets, table)
                        found <- true if not found and iter_call_passes_container_by_ref(low, place, container, alias_names, alias_targets, table)
                        found <- true if not found and iter_call_passes_container_by_ref(high, place, container, alias_names, alias_targets, table)
                    Expr.IndexN(object, arguments, line):
                        found <- true if not found and iter_call_passes_container_by_ref(object, place, container, alias_names, alias_targets, table)
                        for argument in arguments |found, place, container, alias_names, alias_targets, table|:
                            found <- true if not found and iter_call_passes_container_by_ref(argument, place, container, alias_names, alias_targets, table)
                    Expr.Binary(left, operator, right, line):
                        found <- true if not found and iter_call_passes_container_by_ref(left, place, container, alias_names, alias_targets, table)
                        found <- true if not found and iter_call_passes_container_by_ref(right, place, container, alias_names, alias_targets, table)
                    Expr.Unary(operator, operand, line) | Expr.Move(operand, line) | Expr.RegionNew(operand, _, line) | Expr.Paren(operand, line):
                        found <- true if not found and iter_call_passes_container_by_ref(operand, place, container, alias_names, alias_targets, table)
                    Expr.Array(elements, line) | Expr.Tuple(elements, line) | Expr.SetLit(elements, line):
                        for element in elements |found, place, container, alias_names, alias_targets, table|:
                            found <- true if not found and iter_call_passes_container_by_ref(element, place, container, alias_names, alias_targets, table)
                    Expr.DictLit(entries, line):
                        for entry in entries |found, place, container, alias_names, alias_targets, table|:
                            found <- true if not found and iter_call_passes_container_by_ref(entry.key, place, container, alias_names, alias_targets, table)
                            found <- true if not found and iter_call_passes_container_by_ref(entry.value, place, container, alias_names, alias_targets, table)
                    Expr.Construct(type_expression, fields, line) | Expr.RecordUpdate(type_expression, fields, line):
                        found <- true if not found and iter_call_passes_container_by_ref(type_expression, place, container, alias_names, alias_targets, table)
                        for field in fields |found, place, container, alias_names, alias_targets, table|:
                            found <- true if not found and iter_call_passes_container_by_ref(field.value, place, container, alias_names, alias_targets, table)
                    Expr.If(condition, then_value, else_value, line):
                        found <- true if not found and iter_call_passes_container_by_ref(condition, place, container, alias_names, alias_targets, table)
                        found <- true if not found and iter_call_passes_container_by_ref(then_value, place, container, alias_names, alias_targets, table)
                        found <- true if not found and iter_call_passes_container_by_ref(else_value, place, container, alias_names, alias_targets, table)
                    Expr.Match(scrutinee, arms, line) | Expr.Catch(scrutinee, arms, line):
                        found <- true if not found and iter_call_passes_container_by_ref(scrutinee, place, container, alias_names, alias_targets, table)
                        for arm in arms |found, place, container, alias_names, alias_targets, table|:
                            arm_alias_names: mutable darray[sview] = []
                            arm_alias_names.extend(alias_names)
                            arm_alias_targets: mutable darray[sview] = []
                            arm_alias_targets.extend(alias_targets)
                            iter_collect_aliases(arm.body, arm_alias_names, arm_alias_targets)
                            found <- true if not found and iter_call_passes_container_by_ref(arm.guard, place, container, arm_alias_names, arm_alias_targets, table)
                            found <- true if not found and iter_statement_call_passes_container_by_ref(arm.body, place, container, arm_alias_names, arm_alias_targets, table)
                    Expr.Comprehension(variable, iterable, condition, body, line):
                        found <- true if not found and iter_call_passes_container_by_ref(iterable, place, container, alias_names, alias_targets, table)
                        found <- true if not found and iter_call_passes_container_by_ref(condition, place, container, alias_names, alias_targets, table)
                        found <- true if not found and iter_call_passes_container_by_ref(body, place, container, alias_names, alias_targets, table)
                    Expr.Refinement(base, predicate, line):
                        found <- true if not found and iter_call_passes_container_by_ref(base, place, container, alias_names, alias_targets, table)
                        found <- true if not found and iter_call_passes_container_by_ref(predicate, place, container, alias_names, alias_targets, table)
                    Expr.GetElse(guarded, recovery, line):
                        found <- true if not found and iter_call_passes_container_by_ref(guarded, place, container, alias_names, alias_targets, table)
                        recovery_alias_names: mutable darray[sview] = []
                        recovery_alias_names.extend(alias_names)
                        recovery_alias_targets: mutable darray[sview] = []
                        recovery_alias_targets.extend(alias_targets)
                        iter_collect_aliases(recovery, recovery_alias_names, recovery_alias_targets)
                        found <- true if not found and iter_statement_call_passes_container_by_ref(recovery, place, container, recovery_alias_names, recovery_alias_targets, table)
                    Expr.Block(statements, value, captures, line):
                        block_alias_names: mutable darray[sview] = []
                        block_alias_names.extend(alias_names)
                        block_alias_targets: mutable darray[sview] = []
                        block_alias_targets.extend(alias_targets)
                        iter_collect_aliases(statements, block_alias_names, block_alias_targets)
                        found <- true if not found and iter_statement_call_passes_container_by_ref(statements, place, container, block_alias_names, block_alias_targets, table)
                        found <- true if not found and iter_call_passes_container_by_ref(value, place, container, block_alias_names, block_alias_targets, table)
                    _:
                        pass
                return found

        def iter_statement_call_passes_container_by_ref(statements: darray[Ast::Stmt], place: Ast::Expr, container: sview, alias_names: darray[sview]&, alias_targets: darray[sview]&, table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                found: mutable bool = false
                for statement in statements |found, place, container, alias_names, alias_targets, table|:
                    match statement:
                        Stmt.Expr(expression, line):
                            found <- true if not found and iter_call_passes_container_by_ref(expression, place, container, alias_names, alias_targets, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            found <- true if not found and iter_statement_call_passes_container_by_ref(body, place, container, alias_names, alias_targets, table)
                        Stmt.VarDecl(name, type_expression, value, line):
                            found <- true if not found and iter_call_passes_container_by_ref(value, place, container, alias_names, alias_targets, table)
                        Stmt.Assign(target, operator, value, line):
                            found <- true if not found and iter_call_passes_container_by_ref(target, place, container, alias_names, alias_targets, table)
                            found <- true if not found and iter_call_passes_container_by_ref(value, place, container, alias_names, alias_targets, table)
                        Stmt.If(condition, then_body, else_body, line):
                            found <- true if not found and iter_call_passes_container_by_ref(condition, place, container, alias_names, alias_targets, table)
                            found <- true if not found and iter_statement_call_passes_container_by_ref(then_body, place, container, alias_names, alias_targets, table)
                            found <- true if not found and iter_statement_call_passes_container_by_ref(else_body, place, container, alias_names, alias_targets, table)
                        Stmt.While(condition, body, line):
                            found <- true if not found and iter_call_passes_container_by_ref(condition, place, container, alias_names, alias_targets, table)
                            found <- true if not found and iter_statement_call_passes_container_by_ref(body, place, container, alias_names, alias_targets, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            found <- true if not found and iter_call_passes_container_by_ref(iterable, place, container, alias_names, alias_targets, table)
                            found <- true if not found and iter_statement_call_passes_container_by_ref(body, place, container, alias_names, alias_targets, table)
                        Stmt.Return(value, line):
                            if value is return_value:
                                found <- true if not found and iter_call_passes_container_by_ref(return_value, place, container, alias_names, alias_targets, table)
                        Stmt.Match(scrutinee, arms, line):
                            found <- true if not found and iter_call_passes_container_by_ref(scrutinee, place, container, alias_names, alias_targets, table)
                            for arm in arms |found, place, container, alias_names, alias_targets, table|:
                                found <- true if not found and iter_call_passes_container_by_ref(arm.guard, place, container, alias_names, alias_targets, table)
                                found <- true if not found and iter_statement_call_passes_container_by_ref(arm.body, place, container, alias_names, alias_targets, table)
                        Stmt.Contract(kind, expression, line):
                            found <- true if not found and iter_call_passes_container_by_ref(expression, place, container, alias_names, alias_targets, table)
                        _:
                            pass
                return found

        # `xs <- [..]` inside `for v in xs:` releases the buffer the iterator walks, exactly like
        # a growth (stage0 treats the whole assignment as a mutation of the iterable). A `&`
        # value rebinds a reference binding and a binary value is a range or arithmetic, never a
        # container replacement, so both stay out (sound miss, no false fire on scalars).
        def iter_whole_assignment_replaces(target: Ast::Expr, operator: TokenKind, value: Ast::Expr, place: Ast::Expr, container: sview) -> bool:
            can Abort.Panic:
                return false if not iter_place_hit(target, place, container)
                return iter_assignment_replaces_value(operator, value)

        def iter_assignment_replaces_value(operator: TokenKind, value: Ast::Expr) -> bool:
            can Abort.Panic:
                return false if operator != TokenKind.Assign and operator != TokenKind.LArrow
                return match value:
                    Expr.Unary(unary_operator, operand, line):
                        unary_operator != TokenKind.Ampersand
                    Expr.Binary(left, binary_operator, right, line):
                        false
                    _:
                        true

        # `s <- S{..}` (or `o.s <- ..`, `o <- ..`) inside `for v in s.items:` replaces the owner
        # of the iterated field and so releases its buffer too (stage0 7611ee2b). TARGET must
        # STRICTLY enclose the field-chain PLACE; the exact place is the whole-assignment case.
        # `parser <- parser.step(..)` with an `lmut` receiver is an lmut THREADING call: the
        # callee mutates the value in place and nothing is replaced (stage0 accepts it).
        def iter_enclosing_replacement(target: Ast::Expr, operator: TokenKind, value: Ast::Expr, place: Ast::Expr, table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                match place:
                    Expr.Field(place_object, place_field, place_line):
                        stripped: Ast::Expr = storage_view_strip_paren_move(target)
                        return false if:
                            storage_view_same_place(stripped, place)
                            not storage_view_place_encloses(stripped, place)
                        threaded: sview = lmut_threaded_arg_name(value, table)
                        return false if threaded != "" and threaded == ident_name_of(stripped)
                        return iter_assignment_replaces_value(operator, value)
                    _:
                        return false

        # ARGUMENT seen through parens, `move` and a leading `&` (`&o.s` -> `o.s`).
        def iter_owner_argument_place(argument: Ast::Expr) -> Ast::Expr:
            can Memory.Allocate, Abort.Panic:
                stripped: Ast::Expr = storage_view_strip_paren_move(argument)
                match stripped:
                    Expr.Unary(operator, operand, unary_line):
                        return storage_view_strip_paren_move(operand) if operator == TokenKind.Ampersand
                    _:
                        pass
                return stripped

        # Whether ARGUMENT_PLACE STRICTLY encloses the iterated field-chain PLACE: `p` or `o.s`
        # over `p.items` / `o.s.items`. The exact place is iter_call_passes_container_by_ref's case.
        def iter_owner_encloses(argument_place: Ast::Expr, place: Ast::Expr) -> bool:
            can Abort.Panic:
                return false if storage_view_same_place(argument_place, place)
                return storage_view_place_encloses(argument_place, place)

        # Whether position POSITION of CALLEE lets the callee write the argument: a `mutable T&`
        # parameter or an `lmut` one (threading, `p <- p.step()`).
        def iter_owner_position_writes(table: SymbolTable&, callee: sview, positional_index: u32, argument_name: sview) -> bool:
            can Abort.Panic:
                parameter_row: u32 = function_param_row_for_call(table, callee, positional_index, argument_name)
                return false if parameter_row == GENERIC_CALL_NO_ROW
                formal_position: u32 = function_parameter_index(table, callee, argument_name).u32() if argument_name != "" else positional_index
                return table.function_param_mutable_ref[parameter_row.usize()] or lmut_threads_position(table, callee, formal_position)

        def iter_owner_report(argument: Ast::Expr, place: Ast::Expr, container: sview @source, line: u32, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                owner_place: Ast::Expr = iter_owner_argument_place(argument)
                if iter_owner_encloses(owner_place, place):
                    rebind owner: sview @source, table = iter_place_text(owner_place, table)
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.IterCalleeMutableRef, name: container, line: line, expected: owner, actual: ""}) if owner != ""

        # Passing an OWNER of the iterated field chain into a writing parameter (`step(p)`,
        # `p <- p.step()`, `grow(&o.s)` inside `for v in p.items:`) lets the callee
        # push/clear/replace the field through it and relocate the buffer the loop walks (stage0
        # checkIteratorInvalidationForEnclosingMutableRefArg). Walks every call in EXPRESSION.
        def iter_owner_call_walk(expression: Ast::Expr, place: Ast::Expr, container: sview, line: u32, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, call_line):
                        match callee:
                            Expr.Ident(callee_name, ident_line) | Expr.Scope(scope_base, callee_name, scope_line):
                                positional_index: mutable u32 = 0
                                for argument_index in 0..<arguments.count |table, positional_index| -> table:
                                    argument_name: sview = argument_names[argument_index] if argument_index < argument_names.count else ""
                                    argument: Ast::Expr = arguments[argument_index]
                                    table <- iter_owner_report(argument, place, container, line, table) if iter_owner_position_writes(table, callee_name, positional_index, argument_name)
                                    positional_index <- positional_index + 1.u32() if argument_name == ""
                            Expr.Field(receiver, method_name, field_line):
                                # UFCS `recv.m(a)`: the receiver is position 0, written arguments 1+.
                                table <- iter_owner_report(receiver, place, container, line, table) if iter_owner_position_writes(table, method_name, 0, "")
                                table <- iter_owner_call_walk(receiver, place, container, line, table)
                                positional_index: mutable u32 = 1
                                for argument_index in 0..<arguments.count |table, positional_index| -> table:
                                    argument_name: sview = argument_names[argument_index] if argument_index < argument_names.count else ""
                                    argument: Ast::Expr = arguments[argument_index]
                                    table <- iter_owner_report(argument, place, container, line, table) if iter_owner_position_writes(table, method_name, positional_index, argument_name)
                                    positional_index <- positional_index + 1.u32() if argument_name == ""
                            Expr.Lambda(lambda_params, lambda_body, lambda_line):
                                table <- iter_owner_call_walk_statements(lambda_body, place, container, line, table)
                            _:
                                table <- iter_owner_call_walk(callee, place, container, line, table)
                        for argument in arguments |table| -> table:
                            table <- iter_owner_call_walk(argument, place, container, line, table)
                    Expr.StaticEffectCall(effect_type, operation, candidates, arguments, argument_names, call_line):
                        table <- iter_owner_call_walk(effect_type, place, container, line, table)
                        for candidate in candidates |table| -> table:
                            positional_index: mutable u32 = 0
                            for capture in candidate.captures |table, positional_index| -> table:
                                table <- iter_owner_report(capture, place, container, line, table) if iter_owner_position_writes(table, candidate.callee, positional_index, "")
                                positional_index <- positional_index + 1.u32()
                                table <- iter_owner_call_walk(capture, place, container, line, table)
                            for argument_index in 0..<arguments.count |table, positional_index| -> table:
                                argument_name: sview = argument_names[argument_index] if argument_index < argument_names.count else ""
                                argument: Ast::Expr = arguments[argument_index]
                                table <- iter_owner_report(argument, place, container, line, table) if iter_owner_position_writes(table, candidate.callee, positional_index, argument_name)
                                positional_index <- positional_index + 1.u32() if argument_name == ""
                                table <- iter_owner_call_walk(argument, place, container, line, table)
                        for argument in arguments |table| -> table:
                            table <- iter_owner_call_walk(argument, place, container, line, table)
                    Expr.Binary(left, operator, right, binary_line):
                        table <- iter_owner_call_walk(left, place, container, line, table)
                        table <- iter_owner_call_walk(right, place, container, line, table)
                    Expr.Unary(operator, operand, unary_line) | Expr.Move(operand, unary_line) | Expr.RegionNew(operand, _, unary_line) | Expr.Paren(operand, unary_line):
                        table <- iter_owner_call_walk(operand, place, container, line, table)
                    Expr.If(condition, then_value, else_value, if_line):
                        table <- iter_owner_call_walk(condition, place, container, line, table)
                        table <- iter_owner_call_walk(then_value, place, container, line, table)
                        table <- iter_owner_call_walk(else_value, place, container, line, table)
                    Expr.Field(object, field, field_line) | Expr.Scope(object, field, field_line):
                        table <- iter_owner_call_walk(object, place, container, line, table)
                    Expr.Index(object, index, index_line):
                        table <- iter_owner_call_walk(object, place, container, line, table)
                        table <- iter_owner_call_walk(index, place, container, line, table)
                    Expr.Slice(object, low, high, slice_line):
                        table <- iter_owner_call_walk(object, place, container, line, table)
                        table <- iter_owner_call_walk(low, place, container, line, table)
                        table <- iter_owner_call_walk(high, place, container, line, table)
                    Expr.IndexN(object, arguments, indexn_line):
                        table <- iter_owner_call_walk(object, place, container, line, table)
                        for argument in arguments |table| -> table:
                            table <- iter_owner_call_walk(argument, place, container, line, table)
                    Expr.Array(elements, array_line) | Expr.Tuple(elements, array_line) | Expr.SetLit(elements, array_line):
                        for element in elements |table| -> table:
                            table <- iter_owner_call_walk(element, place, container, line, table)
                    Expr.DictLit(entries, dict_line):
                        for entry in entries |table| -> table:
                            table <- iter_owner_call_walk(entry.key, place, container, line, table)
                            table <- iter_owner_call_walk(entry.value, place, container, line, table)
                    Expr.Construct(type_expression, fields, construct_line) | Expr.RecordUpdate(type_expression, fields, construct_line):
                        table <- iter_owner_call_walk(type_expression, place, container, line, table)
                        for field in fields |table| -> table:
                            table <- iter_owner_call_walk(field.value, place, container, line, table)
                    Expr.Match(scrutinee, arms, match_line) | Expr.Catch(scrutinee, arms, match_line):
                        table <- iter_owner_call_walk(scrutinee, place, container, line, table)
                        for arm in arms |table| -> table:
                            table <- iter_owner_call_walk(arm.guard, place, container, line, table)
                            table <- iter_owner_call_walk_statements(arm.body, place, container, line, table)
                    Expr.Comprehension(variable, iterable, condition, body, comprehension_line):
                        table <- iter_owner_call_walk(iterable, place, container, line, table)
                        table <- iter_owner_call_walk(condition, place, container, line, table)
                        table <- iter_owner_call_walk(body, place, container, line, table)
                    Expr.Refinement(base, predicate, refinement_line):
                        table <- iter_owner_call_walk(base, place, container, line, table)
                        table <- iter_owner_call_walk(predicate, place, container, line, table)
                    Expr.GetElse(guarded, recovery, getelse_line):
                        table <- iter_owner_call_walk(guarded, place, container, line, table)
                        table <- iter_owner_call_walk_statements(recovery, place, container, line, table)
                    Expr.Block(statements, value, captures, block_line):
                        table <- iter_owner_call_walk_statements(statements, place, container, line, table)
                        table <- iter_owner_call_walk(value, place, container, line, table)
                    Expr.Lambda(lambda_params, lambda_body, lambda_line):
                        pass
                    _:
                        pass

        def iter_owner_call_walk_statements(statements: darray[Ast::Stmt], place: Ast::Expr, container: sview, line: u32, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Expr(expression, _):
                            table <- iter_owner_call_walk(expression, place, container, line, table)
                        Stmt.Block(_, _, _, body, _):
                            table <- iter_owner_call_walk_statements(body, place, container, line, table)
                        Stmt.VarDecl(_, _, value, _):
                            table <- iter_owner_call_walk(value, place, container, line, table)
                        Stmt.Assign(target, _, value, _):
                            table <- iter_owner_call_walk(target, place, container, line, table)
                            table <- iter_owner_call_walk(value, place, container, line, table)
                        Stmt.If(condition, then_body, else_body, _):
                            table <- iter_owner_call_walk(condition, place, container, line, table)
                            table <- iter_owner_call_walk_statements(then_body, place, container, line, table)
                            table <- iter_owner_call_walk_statements(else_body, place, container, line, table)
                        Stmt.While(condition, body, _):
                            table <- iter_owner_call_walk(condition, place, container, line, table)
                            table <- iter_owner_call_walk_statements(body, place, container, line, table)
                        Stmt.For(_, _, iterable, body, _):
                            table <- iter_owner_call_walk(iterable, place, container, line, table)
                            table <- iter_owner_call_walk_statements(body, place, container, line, table)
                        Stmt.Return(value, _):
                            if value is returned:
                                table <- iter_owner_call_walk(returned, place, container, line, table)
                        Stmt.Match(scrutinee, arms, _):
                            table <- iter_owner_call_walk(scrutinee, place, container, line, table)
                            for arm in arms |table| -> table:
                                table <- iter_owner_call_walk(arm.guard, place, container, line, table)
                                table <- iter_owner_call_walk_statements(arm.body, place, container, line, table)
                        Stmt.Contract(_, expression, _):
                            table <- iter_owner_call_walk(expression, place, container, line, table)
                        _:
                            pass

        # Walk a loop body for a growing mutation of `container`; recurses control flow but NOT a
        # nested `for ... in container` (that inner loop owns its own iterator check).
        def iter_body_mutates(statements: darray[Ast::Stmt], place: Ast::Expr, container: sview @source, alias_names: darray[sview]&, alias_targets: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Expr(expression, line):
                            method: sview = iter_mutation_method(expression, place, container, alias_names, alias_targets)
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.MutateWhileIterating, name: container, line: line.line, expected: "", actual: method}) if method != ""
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.IterCalleeMutableRef, name: container, line: line.line, expected: "", actual: ""}) if method == "" and iter_call_passes_container_by_ref(expression, place, container, alias_names, alias_targets, table)
                            table <- iter_owner_call_walk(expression, place, container, line.line, table)
                        Stmt.Assign(target, operator, value, line):
                            method: mutable sview = iter_mutation_method(target, place, container, alias_names, alias_targets)
                            method <- iter_mutation_method(value, place, container, alias_names, alias_targets) if method == ""
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.MutateWhileIterating, name: container, line: line.line, expected: "", actual: method}) if method != ""
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.IterCalleeMutableRef, name: container, line: line.line, expected: "", actual: ""}) if method == "" and (iter_call_passes_container_by_ref(target, place, container, alias_names, alias_targets, table) or iter_call_passes_container_by_ref(value, place, container, alias_names, alias_targets, table))
                            table <- iter_owner_call_walk(target, place, container, line.line, table)
                            table <- iter_owner_call_walk(value, place, container, line.line, table)
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.MutateWhileIterating, name: container, line: line.line, expected: "", actual: "reassignment"}) if iter_whole_assignment_replaces(target, operator, value, place, container)
                            if container != "" and iter_enclosing_replacement(target, operator, value, place, table):
                                rebind owner: sview @source, table = iter_place_text(storage_view_strip_paren_move(target), table)
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.MutateWhileIterating, name: container, line: line.line, expected: owner, actual: "reassignment"}) if owner != ""
                            # `xs += e` is the append spelling of `xs.push(e)`: stage0 reports any `+=`
                            # on the iterated name as a push, whatever the iterable's type.
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.MutateWhileIterating, name: container, line: line.line, expected: "", actual: "push"}) if operator == TokenKind.PlusEq and iter_place_hit(target, place, container)
                        Stmt.VarDecl(name, type_expression, value, line):
                            method: sview = iter_mutation_method(value, place, container, alias_names, alias_targets)
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.MutateWhileIterating, name: container, line: line.line, expected: "", actual: method}) if method != ""
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.IterCalleeMutableRef, name: container, line: line.line, expected: "", actual: ""}) if method == "" and iter_call_passes_container_by_ref(value, place, container, alias_names, alias_targets, table)
                            table <- iter_owner_call_walk(value, place, container, line.line, table)
                        Stmt.If(condition, then_body, else_body, line):
                            method: sview = iter_mutation_method(condition, place, container, alias_names, alias_targets)
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.MutateWhileIterating, name: container, line: line.line, expected: "", actual: method}) if method != ""
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.IterCalleeMutableRef, name: container, line: line.line, expected: "", actual: ""}) if method == "" and iter_call_passes_container_by_ref(condition, place, container, alias_names, alias_targets, table)
                            table <- iter_owner_call_walk(condition, place, container, line.line, table)
                            table <- iter_body_mutates(then_body, place, container, alias_names, alias_targets, table)
                            table <- iter_body_mutates(else_body, place, container, alias_names, alias_targets, table)
                        Stmt.While(condition, while_body, line):
                            method: sview = iter_mutation_method(condition, place, container, alias_names, alias_targets)
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.MutateWhileIterating, name: container, line: line.line, expected: "", actual: method}) if method != ""
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.IterCalleeMutableRef, name: container, line: line.line, expected: "", actual: ""}) if method == "" and iter_call_passes_container_by_ref(condition, place, container, alias_names, alias_targets, table)
                            table <- iter_owner_call_walk(condition, place, container, line.line, table)
                            table <- iter_body_mutates(while_body, place, container, alias_names, alias_targets, table)
                        Stmt.For(bind, variables, iterable, for_body, line):
                            method: sview = iter_mutation_method(iterable, place, container, alias_names, alias_targets)
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.MutateWhileIterating, name: container, line: line.line, expected: "", actual: method}) if method != ""
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.IterCalleeMutableRef, name: container, line: line.line, expected: "", actual: ""}) if method == "" and iter_call_passes_container_by_ref(iterable, place, container, alias_names, alias_targets, table)
                            table <- iter_owner_call_walk(iterable, place, container, line.line, table)
                            table <- iter_body_mutates(for_body, place, container, alias_names, alias_targets, table) if not iter_place_hit(iterable, place, container)
                        Stmt.Block(block_kind, clause, binding, block_body, block_line):
                            table <- iter_body_mutates(block_body, place, container, alias_names, alias_targets, table)
                        Stmt.Match(scrutinee, arms, line):
                            table <- iter_owner_call_walk(scrutinee, place, container, line.line, table)
                            has_mutref_call: mutable bool = iter_call_passes_container_by_ref(scrutinee, place, container, alias_names, alias_targets, table)
                            method: mutable sview = iter_mutation_method(scrutinee, place, container, alias_names, alias_targets)
                            for arm in arms |table, has_mutref_call, method| -> table:
                                arm_method: sview = iter_mutation_method(arm.guard, place, container, alias_names, alias_targets)
                                method <- arm_method if method == "" and arm_method != ""
                                has_mutref_call <- true if not has_mutref_call and method == "" and iter_call_passes_container_by_ref(arm.guard, place, container, alias_names, alias_targets, table)
                                table <- iter_owner_call_walk(arm.guard, place, container, line.line, table)
                                table <- iter_body_mutates(arm.body, place, container, alias_names, alias_targets, table)
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.MutateWhileIterating, name: container, line: line.line, expected: "", actual: method}) if method != ""
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.IterCalleeMutableRef, name: container, line: line.line, expected: "", actual: ""}) if method == "" and has_mutref_call
                        Stmt.Return(value, line):
                            if value is returned_expression:
                                method: sview = iter_mutation_method(returned_expression, place, container, alias_names, alias_targets)
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.MutateWhileIterating, name: container, line: line.line, expected: "", actual: method}) if method != ""
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.IterCalleeMutableRef, name: container, line: line.line, expected: "", actual: ""}) if method == "" and iter_call_passes_container_by_ref(returned_expression, place, container, alias_names, alias_targets, table)
                                table <- iter_owner_call_walk(returned_expression, place, container, line.line, table)
                        Stmt.Contract(kind, expression, line):
                            method: sview = iter_mutation_method(expression, place, container, alias_names, alias_targets)
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.MutateWhileIterating, name: container, line: line.line, expected: "", actual: method}) if method != ""
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.IterCalleeMutableRef, name: container, line: line.line, expected: "", actual: ""}) if method == "" and iter_call_passes_container_by_ref(expression, place, container, alias_names, alias_targets, table)
                            table <- iter_owner_call_walk(expression, place, container, line.line, table)
                        _:
                            pass

        # Whether NAME is a region-backed local (`xs: darray[T] @buf`). A region-backed darray
        # may be stable (`reserve_commit`/`fixed` — its buffer never moves), which stage0 allows
        # to grow mid-iteration, so leave ALL region-backed containers to the region checker
        # (conservative: never a false positive on a stable buffer).
        def container_is_region_backed(region_annotations: darray[Ast::LocalRegionAnnotation]&, name: sview) -> bool:
            can Abort.Panic:
                return any annotation in region_annotations where annotation.name == name

        def drain_iterated_place(iterable: Ast::Expr) -> Ast::Expr:
            can Abort.Panic:
                match iterable:
                    Expr.Move(moved, move_pos):
                        return moved
                    _:
                        return iterable

        def iter_check_statements(statements: darray[Ast::Stmt], region_annotations: darray[Ast::LocalRegionAnnotation]&, alias_names: darray[sview]&, alias_targets: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.For(bind, variables, iterable, body, line):
                            # A drain `for x in move xs` walks xs's buffer just like a plain
                            # loop, so `xs.clear()` / `xs.push(..)` in its body frees or moves
                            # that buffer under the loop (fuzz F13). The iterable is
                            # `Expr.Move(xs)`, which has no place text, so look through it.
                            iterated_place: Ast::Expr = drain_iterated_place(iterable)
                            rebind container: sview, table = iter_place_text(iterated_place, table)
                            table <- iter_body_mutates(body, iterated_place, container, alias_names, alias_targets, table) if container != "" and bind != "move" and not container_is_region_backed(region_annotations, container)
                            table <- iter_check_statements(body, region_annotations, alias_names, alias_targets, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- iter_check_statements(then_body, region_annotations, alias_names, alias_targets, table)
                            table <- iter_check_statements(else_body, region_annotations, alias_names, alias_targets, table)
                        Stmt.While(condition, while_body, line):
                            table <- iter_check_statements(while_body, region_annotations, alias_names, alias_targets, table)
                        Stmt.Block(block_kind, clause, binding, block_body, block_line):
                            table <- iter_check_statements(block_body, region_annotations, alias_names, alias_targets, table)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |table| -> table:
                                table <- iter_check_statements(arm.body, region_annotations, alias_names, alias_targets, table)
                        _:
                            pass

        def iter_check_walk(declarations: darray[Ast::Decl], region_annotations: darray[Ast::LocalRegionAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            alias_names: mutable darray[sview] = []
                            alias_targets: mutable darray[sview] = []
                            iter_collect_aliases(body, alias_names, alias_targets)
                            table <- iter_check_statements(body, region_annotations, alias_names, alias_targets, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- iter_check_walk(module_body, region_annotations, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- iter_check_walk(scoped_body, region_annotations, table)
                        _:
                            pass

    public:
        def check_mutate_while_iterating(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- iter_check_walk(file.top_decls, file.local_region_annotations, table)
