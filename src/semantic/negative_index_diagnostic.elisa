# Safe numeric payloads for the negative-index diagnostic.
module NegativeIndexDiagnostic:
    public:
        const MAX_REPORTED_MAGNITUDE: i64 = 4294967295

        # The diagnostic stores its displayed magnitude in a u32. Preserve every
        # representable value and saturate larger magnitudes without negating i64 min.
        def reported_magnitude(index: i64) -> u32:
            requires index < 0
            ensure result.i64() == (MAX_REPORTED_MAGNITUDE if index < (0 - MAX_REPORTED_MAGNITUDE) else (0 - index))
            if index < (0 - MAX_REPORTED_MAGNITUDE):
                return MAX_REPORTED_MAGNITUDE.u32()
            return (0 - index).u32()

        # Let the renderer distinguish an exact u32-max magnitude from a saturated one.
        def magnitude_exceeds_reported_range(index: i64) -> bool:
            requires index < 0
            ensure result == (index < (0 - MAX_REPORTED_MAGNITUDE))
            return index < (0 - MAX_REPORTED_MAGNITUDE)

        # In the AST shape `-(integer literal)`, zero is not a negative index.
        def unary_minus_has_negative_index(magnitude: i64) -> bool:
            ensure result == (magnitude > 0)
            return magnitude > 0
