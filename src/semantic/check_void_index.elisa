# Check for indexing (`obj[i]`) applied to a VOID-typed receiver (a call to a
# uniquely-named `-> void` function), which can never be indexed. Disjoint from
# IndexNonIndexable (which owns firm scalar receivers int/float/bool/char);
# Unknown/String/Named receivers are excluded. Type-application brackets
# (`.cast[T]`, generics) are always excluded.

extend Semantic:
    private:
        # Walk through expressions, checking for indexing of a void-typed receiver.
        def walk_expression_for_void_index(expression: Ast::Expr, table: lmut SymbolTable, var_types: mutable darray[sview]&, type_names: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Binary(left, operator, right, line):
                        table <- walk_expression_for_void_index(left, table, var_types, type_names)
                        table <- walk_expression_for_void_index(right, table, var_types, type_names) if operator != TokenKind.Is and operator != TokenKind.As
                    Expr.Call(callee, arguments, argument_names, line):
                        table <- walk_expression_for_void_index(callee, table, var_types, type_names)
                        for argument in arguments |table|:
                            table <- walk_expression_for_void_index(argument, table, var_types, type_names)
                    Expr.Field(object, field, line):
                        table <- walk_expression_for_void_index(object, table, var_types, type_names)
                    Expr.Scope(base, name, line):
                        table <- walk_expression_for_void_index(base, table, var_types, type_names)
                    Expr.Index(object, index, line):
                        object_type: InferType = infer_expression_type(object, var_types, type_names, table)
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.VoidIndex, name: "", line: line.line, expected: "", actual: ""}) if not index_receiver_is_type_application(object) and object_type.kind == SemTypeKind.Void
                        table <- walk_expression_for_void_index(object, table, var_types, type_names)
                        table <- walk_expression_for_void_index(index, table, var_types, type_names) if not index_receiver_is_type_application(object)
                    Expr.Unary(operator, operand, line):
                        table <- walk_expression_for_void_index(operand, table, var_types, type_names)
                    Expr.Paren(inner, line):
                        table <- walk_expression_for_void_index(inner, table, var_types, type_names)
                    Expr.Array(elements, line):
                        for element in elements |table|:
                            table <- walk_expression_for_void_index(element, table, var_types, type_names)
                    Expr.Tuple(elements, line):
                        for element in elements |table|:
                            table <- walk_expression_for_void_index(element, table, var_types, type_names)
                    Expr.Slice(object, low, high, line):
                        table <- walk_expression_for_void_index(object, table, var_types, type_names)
                        table <- walk_expression_for_void_index(low, table, var_types, type_names)
                        table <- walk_expression_for_void_index(high, table, var_types, type_names)
                    Expr.IndexN(object, arguments, line):
                        object_type: InferType = infer_expression_type(object, var_types, type_names, table)
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.VoidIndex, name: "", line: line.line, expected: "", actual: ""}) if not index_receiver_is_type_application(object) and object_type.kind == SemTypeKind.Void
                        table <- walk_expression_for_void_index(object, table, var_types, type_names)
                        for argument in arguments |table|:
                            table <- walk_expression_for_void_index(argument, table, var_types, type_names) if not index_receiver_is_type_application(object)
                    Expr.SetLit(elements, line):
                        for element in elements |table|:
                            table <- walk_expression_for_void_index(element, table, var_types, type_names)
                    Expr.DictLit(entries, line):
                        for entry in entries |table|:
                            table <- walk_expression_for_void_index(entry.key, table, var_types, type_names)
                            table <- walk_expression_for_void_index(entry.value, table, var_types, type_names)
                    Expr.Construct(type_expression, fields, line):
                        table <- walk_expression_for_void_index(type_expression, table, var_types, type_names)
                        for field in fields |table|:
                            table <- walk_expression_for_void_index(field.value, table, var_types, type_names)
                    Expr.RecordUpdate(base, fields, line):
                        table <- walk_expression_for_void_index(base, table, var_types, type_names)
                        for field in fields |table|:
                            table <- walk_expression_for_void_index(field.value, table, var_types, type_names)
                    Expr.If(condition, then_expr, else_expr, line):
                        table <- walk_expression_for_void_index(condition, table, var_types, type_names)
                        table <- walk_expression_for_void_index(then_expr, table, var_types, type_names)
                        table <- walk_expression_for_void_index(else_expr, table, var_types, type_names)
                    Expr.Comprehension(loop_variable, iterable, condition, body, line):
                        table <- walk_expression_for_void_index(iterable, table, var_types, type_names)
                        table <- walk_expression_for_void_index(condition, table, var_types, type_names)
                        table <- walk_expression_for_void_index(body, table, var_types, type_names)
                    Expr.Lambda(parameters, body, line):
                        table <- walk_statements_for_void_index(body, table, var_types, type_names)
                    Expr.Block(statements, value, captures, line):
                        table <- walk_statements_for_void_index(statements, table, var_types, type_names)
                        table <- walk_expression_for_void_index(value, table, var_types, type_names)
                    Expr.Match(scrutinee, arms, line):
                        table <- walk_expression_for_void_index(scrutinee, table, var_types, type_names)
                        for arm in arms |table|:
                            table <- walk_statements_for_void_index(arm.body, table, var_types, type_names)
                    # Literals and other expressions don't contain relevant sub-expressions
                    _:
                        pass

        # Walk through statements, tracking variable types and checking for void indexing.
        def walk_statements_for_void_index(statements: darray[Ast::Stmt], table: lmut SymbolTable, var_types: mutable darray[sview]&, type_names: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table|:
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- walk_expression_for_void_index(expression, table, var_types, type_names)
                        Stmt.VarDecl(name, type_expression, value, line):
                            # Record the type for this variable
                            type_name: sview = bare_type_name(type_expression)
                            note_local_type(var_types, type_names, name, type_name)
                            table <- walk_expression_for_void_index(value, table, var_types, type_names)
                        Stmt.Assign(target, operator, value, line):
                            table <- walk_expression_for_void_index(target, table, var_types, type_names)
                            table <- walk_expression_for_void_index(value, table, var_types, type_names)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- walk_expression_for_void_index(condition, table, var_types, type_names)
                            table <- walk_statements_for_void_index(then_body, table, var_types, type_names)
                            table <- walk_statements_for_void_index(else_body, table, var_types, type_names)
                        Stmt.While(condition, body, line):
                            table <- walk_expression_for_void_index(condition, table, var_types, type_names)
                            table <- walk_statements_for_void_index(body, table, var_types, type_names)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- walk_expression_for_void_index(iterable, table, var_types, type_names)
                            table <- walk_statements_for_void_index(body, table, var_types, type_names)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- walk_statements_for_void_index(body, table, var_types, type_names)
                        Stmt.Match(scrutinee, arms, line):
                            table <- walk_expression_for_void_index(scrutinee, table, var_types, type_names)
                            for arm in arms |table|:
                                table <- walk_expression_for_void_index(arm.guard, table, var_types, type_names)
                                table <- walk_statements_for_void_index(arm.body, table, var_types, type_names)
                        Stmt.Return(value, line):
                            table <- walk_expression_for_void_index(return_value, table, var_types, type_names) if value is return_value
                        Stmt.Contract(kind, expression, line):
                            table <- walk_expression_for_void_index(expression, table, var_types, type_names)
                        Stmt.Invalid:
                            pass
                        Stmt.Break(label, line):
                            pass
                        Stmt.Continue(label, line):
                            pass

        # Walk through function declarations.
        def check_void_index_declarations(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table|:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            # Create fresh type tracking for this function
                            var_types: mutable darray[sview] = []
                            type_names: mutable darray[sview] = []
                            # Record parameter types
                            for param in params |table|:
                                param_type: sview = bare_type_name(param.type_expression)
                                note_local_type(var_types, type_names, param.name, param_type)
                            # Walk the function body
                            table <- walk_statements_for_void_index(body, table, var_types, type_names)
                        Decl.Module(module_name, body, line):
                            table <- check_void_index_declarations(body, table)
                        Decl.Scoped(body, line):
                            table <- check_void_index_declarations(body, table)
                        _:
                            pass

    public:
        # Public entry point for the check.
        def check_void_index(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- check_void_index_declarations(declarations, table)
