# Dict-literal VALUE type mismatch: a `dict[K, V]` VarDecl (`d: dict[i64, i64] = {1: "s"}`)
# whose annotated VALUE type is a bare primitive, where an entry's value (literal or firm)
# can NEVER fit that value type. E.g. `d: dict[i64, i64] = {1: "s"}` fires because "s" is a
# string literal and string literals never fit i64.
# Sound subset: only `dict[K, <bare primitive V>]` annotations (`Expr.IndexN(object:
# Ident("dict"), arguments: [K, V])`); only the VALUE side of each entry (the KEY side is a
# sibling check's job — never touched here); only literal/firm values whose family is
# provably incompatible (same oracle as TypeMismatch's check_value_against —
# literal_never_fits / firm_never_fits). Unknown-family values (calls, constructs,
# Named-typed locals, ...) never fire. Void values are not this check's job.

extend Semantic:
    private:
        # Extract the bare VALUE-type name from a `dict[K, V]` TYPE annotation — i.e.
        # `Expr.IndexN(object: Expr.Ident("dict"), arguments: [K, V])`. Returns "" if the
        # annotation is not that exact shape (not a dict application, wrong arg count, or a
        # non-Ident value-type base — generics/darray/set/etc. all skip).
        def extract_dict_value_type_name(type_expr: Ast::Expr) -> sview:
            can Memory.Allocate, Abort.Panic:
                match type_expr:
                    Expr.IndexN(object, arguments, line):
                        match object:
                            Expr.Ident(head_name, head_line):
                                if head_name == "dict" and arguments.count == 2:
                                    match arguments[1]:
                                        Expr.Ident(value_type_name, value_type_line):
                                            return value_type_name
                                        _:
                                            return ""
                                return ""
                            _:
                                return ""
                    _:
                        return ""

        # Whether `type_name` is a bare primitive eligible for this check (mirrors the
        # gate used by TypeMismatch/check_value_against and ArrayLiteralElementTypeMismatch:
        # integer/float/string types plus bool/char).
        def is_dict_value_primitive(type_name: sview) -> bool:
            can Abort.Panic:
                true return if is_integer_type_name(type_name) or is_float_type_name(type_name) or is_string_type_name(type_name)
                return type_name == "bool" or type_name == "char"

        # Check one dict-entry VALUE against the declared value type; push a diagnostic if
        # its literal kind or inferred family can never fit. The KEY is never inspected here.
        def check_dict_value_against(entry_value: Ast::Expr, entry_index: usize, value_type_name: sview, line: u32, var_types: darray[sview]&, type_names: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                literal_kind: sview = literal_kind_of(entry_value)
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.DictValueTypeMismatch, name: "", line: line, expected: value_type_name, actual: stage0_literal_spelling(literal_kind), actual_count: entry_index.u32()}) if literal_kind != "" and literal_never_fits(literal_kind, value_type_name)
                value_type: InferType = infer_expression_type(entry_value, var_types, type_names, table)
                value_family: sview = family_of_kind(value_type)
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.DictValueTypeMismatch, name: "", line: line, expected: value_type_name, actual: stage0_value_spelling(value_type), actual_count: entry_index.u32()}) if literal_kind == "" and value_family != "" and firm_never_fits(value_family, value_type_name)

        # Walk through expressions, recursing into nested constructs so dict literals in
        # nested positions (not just direct VarDecl values) are still walked for their OWN
        # sub-expressions (this check only fires at the VarDecl site itself, but the
        # recursive walk must still visit every expression so other nested VarDecls are
        # reached via the statement walk below).
        def walk_expression_for_dict_value_mismatch(expression: Ast::Expr, table: lmut SymbolTable, var_types: mutable darray[sview]&, type_names: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Binary(left, operator, right, line):
                        table <- walk_expression_for_dict_value_mismatch(left, table, var_types, type_names)
                        table <- walk_expression_for_dict_value_mismatch(right, table, var_types, type_names) if operator != TokenKind.Is and operator != TokenKind.As
                    Expr.Call(callee, arguments, argument_names, line):
                        table <- walk_expression_for_dict_value_mismatch(callee, table, var_types, type_names)
                        for argument in arguments |table|:
                            table <- walk_expression_for_dict_value_mismatch(argument, table, var_types, type_names)
                    Expr.Field(object, field, line):
                        table <- walk_expression_for_dict_value_mismatch(object, table, var_types, type_names)
                    Expr.Scope(base, name, line):
                        table <- walk_expression_for_dict_value_mismatch(base, table, var_types, type_names)
                    Expr.Index(object, index, line):
                        table <- walk_expression_for_dict_value_mismatch(object, table, var_types, type_names)
                        table <- walk_expression_for_dict_value_mismatch(index, table, var_types, type_names) if not index_receiver_is_type_application(object)
                    Expr.Unary(operator, operand, line):
                        table <- walk_expression_for_dict_value_mismatch(operand, table, var_types, type_names)
                    Expr.Paren(inner, line):
                        table <- walk_expression_for_dict_value_mismatch(inner, table, var_types, type_names)
                    Expr.Array(elements, line):
                        for element in elements |table|:
                            table <- walk_expression_for_dict_value_mismatch(element, table, var_types, type_names)
                    Expr.Tuple(elements, line):
                        for element in elements |table|:
                            table <- walk_expression_for_dict_value_mismatch(element, table, var_types, type_names)
                    Expr.Slice(object, low, high, line):
                        table <- walk_expression_for_dict_value_mismatch(object, table, var_types, type_names)
                        table <- walk_expression_for_dict_value_mismatch(low, table, var_types, type_names)
                        table <- walk_expression_for_dict_value_mismatch(high, table, var_types, type_names)
                    Expr.IndexN(object, arguments, line):
                        table <- walk_expression_for_dict_value_mismatch(object, table, var_types, type_names)
                        for argument in arguments |table|:
                            table <- walk_expression_for_dict_value_mismatch(argument, table, var_types, type_names) if not index_receiver_is_type_application(object)
                    Expr.SetLit(elements, line):
                        for element in elements |table|:
                            table <- walk_expression_for_dict_value_mismatch(element, table, var_types, type_names)
                    Expr.DictLit(entries, line):
                        for entry in entries |table|:
                            table <- walk_expression_for_dict_value_mismatch(entry.key, table, var_types, type_names)
                            table <- walk_expression_for_dict_value_mismatch(entry.value, table, var_types, type_names)
                    Expr.Construct(type_expression, fields, line):
                        table <- walk_expression_for_dict_value_mismatch(type_expression, table, var_types, type_names)
                        for field in fields |table|:
                            table <- walk_expression_for_dict_value_mismatch(field.value, table, var_types, type_names)
                    Expr.RecordUpdate(base, fields, line):
                        table <- walk_expression_for_dict_value_mismatch(base, table, var_types, type_names)
                        for field in fields |table|:
                            table <- walk_expression_for_dict_value_mismatch(field.value, table, var_types, type_names)
                    Expr.If(condition, then_expr, else_expr, line):
                        table <- walk_expression_for_dict_value_mismatch(condition, table, var_types, type_names)
                        table <- walk_expression_for_dict_value_mismatch(then_expr, table, var_types, type_names)
                        table <- walk_expression_for_dict_value_mismatch(else_expr, table, var_types, type_names)
                    Expr.Comprehension(loop_variable, iterable, condition, body, line):
                        table <- walk_expression_for_dict_value_mismatch(iterable, table, var_types, type_names)
                        table <- walk_expression_for_dict_value_mismatch(condition, table, var_types, type_names)
                        table <- walk_expression_for_dict_value_mismatch(body, table, var_types, type_names)
                    Expr.Lambda(parameters, body, line):
                        table <- walk_statements_for_dict_value_mismatch(body, table, var_types, type_names)
                    Expr.Block(statements, value, captures, line):
                        table <- walk_statements_for_dict_value_mismatch(statements, table, var_types, type_names)
                        table <- walk_expression_for_dict_value_mismatch(value, table, var_types, type_names)
                    Expr.Match(scrutinee, arms, line):
                        table <- walk_expression_for_dict_value_mismatch(scrutinee, table, var_types, type_names)
                        for arm in arms |table|:
                            table <- walk_statements_for_dict_value_mismatch(arm.body, table, var_types, type_names)
                    # Literals and other expressions don't contain relevant sub-expressions
                    _:
                        pass

        # Walk through statements, tracking variable types and checking `dict[K, V]`
        # VarDecls whose value is a dict literal.
        def walk_statements_for_dict_value_mismatch(statements: darray[Ast::Stmt], table: lmut SymbolTable, var_types: mutable darray[sview]&, type_names: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table|:
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- walk_expression_for_dict_value_mismatch(expression, table, var_types, type_names)
                        Stmt.VarDecl(name, type_expression, value, line):
                            value_type_name: sview = extract_dict_value_type_name(type_expression)
                            if value_type_name != "" and is_dict_value_primitive(value_type_name):
                                match value:
                                    Expr.DictLit(entries, dict_line):
                                        entry_index: mutable usize = 0
                                        for entry in entries |table, entry_index|:
                                            table <- check_dict_value_against(entry.value, entry_index, value_type_name, line, var_types, type_names, table)
                                            entry_index <- entry_index + 1
                                    _:
                                        pass
                            # Record the local's own type and recurse into the value.
                            type_name: sview = bare_type_name(type_expression)
                            note_local_type(var_types, type_names, name, type_name)
                            table <- walk_expression_for_dict_value_mismatch(value, table, var_types, type_names)
                        Stmt.Assign(target, operator, value, line):
                            table <- walk_expression_for_dict_value_mismatch(target, table, var_types, type_names)
                            table <- walk_expression_for_dict_value_mismatch(value, table, var_types, type_names)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- walk_expression_for_dict_value_mismatch(condition, table, var_types, type_names)
                            table <- walk_statements_for_dict_value_mismatch(then_body, table, var_types, type_names)
                            table <- walk_statements_for_dict_value_mismatch(else_body, table, var_types, type_names)
                        Stmt.While(condition, body, line):
                            table <- walk_expression_for_dict_value_mismatch(condition, table, var_types, type_names)
                            table <- walk_statements_for_dict_value_mismatch(body, table, var_types, type_names)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- walk_expression_for_dict_value_mismatch(iterable, table, var_types, type_names)
                            table <- walk_statements_for_dict_value_mismatch(body, table, var_types, type_names)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- walk_statements_for_dict_value_mismatch(body, table, var_types, type_names)
                        Stmt.Match(scrutinee, arms, line):
                            table <- walk_expression_for_dict_value_mismatch(scrutinee, table, var_types, type_names)
                            for arm in arms |table|:
                                table <- walk_expression_for_dict_value_mismatch(arm.guard, table, var_types, type_names)
                                table <- walk_statements_for_dict_value_mismatch(arm.body, table, var_types, type_names)
                        Stmt.Return(value, line):
                            table <- walk_expression_for_dict_value_mismatch(return_value, table, var_types, type_names) if value is return_value
                        Stmt.Contract(kind, expression, line):
                            table <- walk_expression_for_dict_value_mismatch(expression, table, var_types, type_names)
                        Stmt.Invalid:
                            pass
                        Stmt.Break(label, line):
                            pass
                        Stmt.Continue(label, line):
                            pass

        # Walk through function declarations.
        def check_dict_value_mismatch_declarations(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table|:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            var_types: mutable darray[sview] = []
                            type_names: mutable darray[sview] = []
                            for param in params |table|:
                                param_type: sview = bare_type_name(param.type_expression)
                                note_local_type(var_types, type_names, param.name, param_type)
                            table <- walk_statements_for_dict_value_mismatch(body, table, var_types, type_names)
                        Decl.Module(module_name, body, line):
                            table <- check_dict_value_mismatch_declarations(body, table)
                        Decl.Scoped(body, line):
                            table <- check_dict_value_mismatch_declarations(body, table)
                        _:
                            pass

    public:
        # Public entry point for the check.
        def check_dict_value_mismatch(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- check_dict_value_mismatch_declarations(declarations, table)
