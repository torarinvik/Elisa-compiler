extend Semantic:
    public:
        # The extent stage0 spans for a region-qualifier complaint: the type's HEAD TOKEN.
        # MEASURED one type shape at a time -- `darray` in `darray[i32] @r` (3:13-19), `dict`
        # in `dict[i64, i64] @r` (3:12-16), `Box` in `Box @r` (5:12-15). Never the qualifier
        # itself, and never the whole generic application.
        #
        # Anything this does not recognise returns a ZEROED pos, which the renderer degrades
        # to `PATH:LINE:` -- the shape these two diagnostics already print. Saying nothing
        # about a column beats guessing one.
        def region_type_head_pos(expression: Ast::Expr) -> Ast::Pos:
            can Abort.Panic:
                match expression:
                    Expr.Ident(head_name, head_pos):
                        return head_pos
                    Expr.Unary(head_operator, head_operand, head_unary_pos):
                        return region_type_head_pos(head_operand) if head_operator == TokenKind.Mutable
                    Expr.Index(head_object, head_index, head_index_pos):
                        return region_type_head_pos(head_object)
                    Expr.IndexN(head_object_n, head_arguments, head_index_n_pos):
                        return region_type_head_pos(head_object_n)
                    _:
                        pass
                return Ast::Pos{line: 0, column: 0, offset: 0, end_line: 0, end_column: 0, end_offset: 0}


        def check_local_region_annotation(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                owned_regions: mutable darray[sview] = []
                collect_owned_region_names(file.top_decls, owned_regions)
                call_spans: mutable CallSourceSpanIndex = CallSourceSpanIndex{}
                can Global{Read,Write}:
                    allocation_fill_call_source_spans(file.enum_annotations, file.allocation_region_offsets, call_spans)
                global_region_rows: mutable darray[Ast::EnumAnnotation] = []
                for row in file.enum_annotations |global_region_rows|:
                    global_region_rows.push(row) if row.owner == "__global_region"
                for annotation in file.local_region_annotations |owned_regions, global_region_rows, table|:
                    # One `x: T @r = ...` records TWO rows: the declaration row keyed by the
                    # local's own name, and a reserved `__region_pin` marker carrying the same
                    # fact for the backend. Both are pushed under the same condition, so they
                    # always come in pairs, and reporting per ROW emitted
                    # `unknown region qualifier "r"` TWICE where stage0 says it once.
                    #
                    # Only that message doubled: the pin row's type_expression is Invalid, so
                    # `local_type_cannot_carry_region` is false for it and the
                    # RegionAnnotationOnNonRegionLocal arm never fired on the marker.
                    # Marker rows are not user-written annotations and must not be diagnosed;
                    # the declaration row beside them already is.
                    #
                    # The `__region_return` marker is the one that IS a user-written annotation:
                    # a function's return type is where stage0 wants a region, so the named-type
                    # sentence cannot apply there, but a fixed array has no region to carry
                    # anywhere (`-> array[i64, 4] @r`).
                    table.diagnostics <- table.diagnostics.push(fixed_array_region_diagnostic(annotation.type_expression, "", annotation.region, annotation.line)) if annotation.name == "__region_return" and region_type_is_fixed_array(annotation.type_expression)
                    continue if annotation.name in {"__region_local", "__region_param", "__region_pin", "__region_arena_local", "__region_return"}
                    # An `owned Arena` binding is itself a region qualifier.
                    continue if any owned_name in owned_regions where owned_name == annotation.region
                    # docs/128: a program-lived `global region` is in scope everywhere.
                    continue if names_global_region(global_region_rows, annotation.region)
                    rejected: bool = region_annotation_rejected(annotation.type_expression, table)
                    fixed_array: bool = region_type_is_fixed_array(annotation.type_expression)
                    table.diagnostics <- table.diagnostics.push(fixed_array_region_diagnostic(annotation.type_expression, annotation.name, annotation.region, annotation.line)) if rejected and fixed_array
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.RegionAnnotationOnScalarField, name: annotation.name, pos: region_type_head_pos(annotation.type_expression), line: annotation.line, expected: "", actual: annotation.region}) if rejected and not fixed_array
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UnknownRegionQualifier, name: annotation.name, pos: region_type_head_pos(annotation.type_expression), line: annotation.line, expected: "", actual: annotation.region}) if not local_type_cannot_carry_region(annotation.type_expression) and not local_region_is_in_scope(file.local_region_annotations, annotation.region, annotation.line, annotation.owner_offset)
                table <- check_region_assignment_declarations(file.top_decls, file.local_region_annotations, file.allocation_region_names, file.allocation_region_lines, file.allocation_region_offsets, call_spans, table)
