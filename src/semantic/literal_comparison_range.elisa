# Named integer endpoints used when checking comparisons against integer literals.
module LiteralComparisonRange:
    public:
        const U8_MIN: i64 = 0
        const U8_MAX: i64 = 255
        const U16_MIN: i64 = 0
        const U16_MAX: i64 = 65535
        const U32_MIN: i64 = 0
        const U32_MAX: i64 = 4294967295
        const I8_MIN: i64 = -128
        const I8_MAX: i64 = 127
        const I16_MIN: i64 = -32768
        const I16_MAX: i64 = 32767
        const I32_MIN: i64 = -2147483648
        const I32_MAX: i64 = 2147483647

        def is_supported_integer_type(type_name: sview) -> bool:
            ensure result == (
                when type_name:
                    "u8" | "u16" | "u32" | "i8" | "i16" | "i32" -> true
                    _ -> false
            )
            can Abort.Panic:
                return when type_name:
                    "u8" | "u16" | "u32" | "i8" | "i16" | "i32" -> true
                    _ -> false

        def is_outside(type_name: sview, value: i64) -> bool:
            outside: bool = when type_name:
                "u8" -> value < U8_MIN or value > U8_MAX
                "u16" -> value < U16_MIN or value > U16_MAX
                "u32" -> value < U32_MIN or value > U32_MAX
                "i8" -> value < I8_MIN or value > I8_MAX
                "i16" -> value < I16_MIN or value > I16_MAX
                "i32" -> value < I32_MIN or value > I32_MAX
                _ -> false
            assert(outside == (
                when type_name:
                    "u8" -> value < U8_MIN or value > U8_MAX
                    "u16" -> value < U16_MIN or value > U16_MAX
                    "u32" -> value < U32_MIN or value > U32_MAX
                    "i8" -> value < I8_MIN or value > I8_MAX
                    "i16" -> value < I16_MIN or value > I16_MAX
                    "i32" -> value < I32_MIN or value > I32_MAX
                    _ -> false
            ))
            can Abort.Panic:
                return outside
