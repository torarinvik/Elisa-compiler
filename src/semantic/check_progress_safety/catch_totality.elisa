extend Semantic:
    private:
        def progress_catch_error_arms_total_at_offset(arms: darray[Ast::MatchArm], table: SymbolTable&, line: u32, offset: u32, line_known: bool, offset_known: bool) -> bool:
            can Memory.Allocate, Abort.Panic:
                return false if arms.count < 2
                arm_index: mutable usize = 0
                while arm_index + 1.usize() < arms.count |arm_index, arms, table|:
                    arm: Ast::MatchArm = arms[arm_index + 1.usize()]
                    guard: (known: bool, value: bool) = progress_literal_bool(arm.guard)
                    unconditional: bool = arm.guard is Ast::Expr.Absent or (guard.known and guard.value)
                    if unconditional and progress_catch_pattern_is_irrefutable(arm.pattern):
                        return true
                    arm_index <- arm_index + 1
                # Line and offset presence are explicit: zero and u32::MAX can both be
                # real source positions after a #line directive or in a large source.
                return false if not line_known
                catch_callee: mutable sview = ""
                catch_module: mutable sview = ""
                catch_offset: mutable u32 = 0
                catch_rows: mutable usize = 0.usize()
                for annotation in table.protocol_annotations |catch_callee, catch_module, catch_offset, catch_rows, table, line, offset|:
                    if annotation.name == "__catch_expr" and annotation.line == line and annotation.module == table.current_module and (not offset_known or annotation.offset == offset):
                        catch_callee <- annotation.owner
                        catch_module <- annotation.module
                        catch_offset <- annotation.offset
                        catch_rows <- catch_rows + 1.usize()
                return false if catch_rows != 1.usize() or catch_callee == ""
                callee_module: (found: bool, qualifier: sview @source, offset: u32) = catch_callee_module_qualifier(table.protocol_annotations, catch_callee, line, catch_offset, catch_module)
                return false if not callee_module.found
                declaration: (known: bool, module: sview @source, line: u32, offset: u32, identity_id: u32) = catch_error_declaration(table.protocol_annotations, catch_callee, catch_module, callee_module.qualifier, line, callee_module.offset)
                return false if not declaration.known
                return_error_occurrence_offset: mutable u32 = 0
                return_error_occurrence_count: mutable usize = 0.usize()
                for annotation in table.protocol_annotations |return_error_occurrence_offset, return_error_occurrence_count, catch_callee, declaration, table|:
                    if annotation.owner == catch_callee and annotation.name == "__error_return" and annotation.line == declaration.line and annotation.offset == declaration.offset and (declaration.identity_id == 0 or annotation.identity_id == declaration.identity_id):
                        return_error_occurrence_offset <- annotation.occurrence_offset
                        return_error_occurrence_count <- return_error_occurrence_count + 1.usize()
                return false if return_error_occurrence_count != 1.usize()
                return progress_catch_declared_error_families_total(arms, table, catch_callee, declaration.module, declaration.line, declaration.offset, declaration.identity_id, return_error_occurrence_offset)

        # Preserve the line-only helper for synthetic callers that have no AST offset.
        # Source-backed callers provide both coordinates and mark them present.
        def progress_catch_error_arms_total_at(arms: darray[Ast::MatchArm], table: SymbolTable&, line: u32) -> bool:
            can Memory.Allocate, Abort.Panic:
                return progress_catch_error_arms_total_at_offset(arms, table, line, 0, true, false)

        # Keep line-free callers conservative. Progress callsites pass the Catch line
        # so this helper can consult the guarded function's declared error families.
        def progress_catch_error_arms_total(arms: darray[Ast::MatchArm], table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                return progress_catch_error_arms_total_at_offset(arms, table, 0, 0, false, false)

        # Only a previous wildcard or `error name` pattern can shadow later
        # Catch handlers; `first_prior_index` distinguishes the sliced error-arm
        # view used by the totality helper from the full Catch arm list.
        def progress_catch_arms_range_reachable(arms: darray[Ast::MatchArm], target_index: usize, first_prior_index: usize) -> bool:
            can Memory.Allocate, Abort.Panic:
                prior: mutable usize = first_prior_index
                while prior < target_index |prior, arms|:
                    arm: Ast::MatchArm = arms[prior]
                    guard: (known: bool, value: bool) = progress_literal_bool(arm.guard)
                    unconditional: bool = arm.guard is Ast::Expr.Absent or (guard.known and guard.value)
                    return false if unconditional and progress_catch_pattern_is_irrefutable(arm.pattern)
                    prior <- prior + 1
                return true

        # Catch arm zero handles successful values; error handlers are ordered from arm one.
        # A prior guarded catch-all only hides later handlers when its guard is literal true.
        def progress_catch_arm_reachable(arms: darray[Ast::MatchArm], target_index: usize) -> bool:
            can Memory.Allocate, Abort.Panic:
                return true if target_index == 0
                progress_catch_arms_range_reachable(arms, target_index, 1.usize())

        # A literal bool scrutinee can be total even though the shared enum helper does not
        # prove bool-literal exhaustiveness. Guards count only when absent or literal-true.
        def progress_match_is_total(scrutinee: Ast::Expr, arms: darray[Ast::MatchArm], table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                literal: (known: bool, value: bool) = progress_literal_bool(scrutinee)
                if literal.known:
                    arm_index: mutable usize = 0
                    while arm_index < arms.count |arm_index, arms, scrutinee, literal, table|:
                        arm: Ast::MatchArm = arms[arm_index]
                        guard: (known: bool, value: bool) = progress_literal_bool(arm.guard)
                        pattern_match: (known: bool, matches: bool) = progress_bool_pattern_matches(arm.pattern, literal.value)
                        unconditional: bool = arm.guard is Ast::Expr.Absent or (guard.known and guard.value)
                        if progress_match_arm_reachable(scrutinee, arms, arm_index) and pattern_match.known and pattern_match.matches and unconditional:
                            return true
                        arm_index <- arm_index + 1
                    return false
                integer_literal: (known: bool, value: i64) = progress_literal_int(scrutinee)
                if integer_literal.known:
                    arm_index: mutable usize = 0
                    while arm_index < arms.count |arm_index, arms, scrutinee, integer_literal, table|:
                        arm: Ast::MatchArm = arms[arm_index]
                        guard: (known: bool, value: bool) = progress_literal_bool(arm.guard)
                        pattern_match: (known: bool, matches: bool) = progress_int_pattern_matches(arm.pattern, integer_literal.value)
                        unconditional: bool = arm.guard is Ast::Expr.Absent or (guard.known and guard.value)
                        if progress_match_arm_reachable(scrutinee, arms, arm_index) and pattern_match.known and pattern_match.matches and unconditional:
                            return true
                        arm_index <- arm_index + 1
                    return false
                arm_index: mutable usize = 0
                while arm_index < arms.count |arm_index, arms, table|:
                    arm: Ast::MatchArm = arms[arm_index]
                    guard: (known: bool, value: bool) = progress_literal_bool(arm.guard)
                    unconditional: bool = arm.guard is Ast::Expr.Absent or (guard.known and guard.value)
                    if unconditional and progress_match_arm_reachable(scrutinee, arms, arm_index) and progress_pattern_is_irrefutable(arm.pattern):
                        return true
                    arm_index <- arm_index + 1
                return match_arms_exhaustive(arms, table)

        # Track only paths that break the current loop, preserving hatch state through
        # conditional blocks. Nested loops own their breaks and are deliberately opaque.
        def progress_current_break_paths(statements: darray[Ast::Stmt], table: SymbolTable&, starts_uncovered: bool, starts_covered: bool) -> (uncovered: bool, covered: bool, break_uncovered: bool, break_covered: bool):
            can Memory.Allocate, Abort.Panic:
                uncovered: mutable bool = starts_uncovered
                covered: mutable bool = starts_covered
                break_uncovered: mutable bool = false
                break_covered: mutable bool = false
                for statement in statements |uncovered, covered, break_uncovered, break_covered, table|:
                    match statement:
                        Stmt.Break(_, _):
                            break_uncovered <- break_uncovered or uncovered
                            break_covered <- break_covered or covered
                            uncovered <- false
                            covered <- false
                        Stmt.Return(_, _) | Stmt.Continue(_, _):
                            uncovered <- false
                            covered <- false
                        Stmt.Block(kind, clause, binding, body, block_line):
                            grants_progress: bool = (kind == "can" or kind == "trusted") and (any grant in clause where progress_grant_is_evidence(grant))
                            block_uncovered: bool = false if grants_progress else uncovered
                            block_covered: bool = true if grants_progress and (uncovered or covered) else covered
                            nested: (uncovered: bool, covered: bool, break_uncovered: bool, break_covered: bool) = progress_current_break_paths(body, table, block_uncovered, block_covered)
                            uncovered <- nested.uncovered
                            covered <- nested.covered
                            break_uncovered <- break_uncovered or nested.break_uncovered
                            break_covered <- break_covered or nested.break_covered
                        Stmt.If(condition, then_body, else_body, _):
                            if expression_evaluation_aborts(condition, table):
                                uncovered <- false
                                covered <- false
                            else:
                                literal: (known: bool, value: bool) = progress_literal_bool(condition)
                                if literal.known:
                                    selected: darray[Ast::Stmt] = then_body if literal.value else else_body
                                    nested: (uncovered: bool, covered: bool, break_uncovered: bool, break_covered: bool) = progress_current_break_paths(selected, table, uncovered, covered)
                                    uncovered <- nested.uncovered
                                    covered <- nested.covered
                                    break_uncovered <- break_uncovered or nested.break_uncovered
                                    break_covered <- break_covered or nested.break_covered
                                else:
                                    then_paths: (uncovered: bool, covered: bool, break_uncovered: bool, break_covered: bool) = progress_current_break_paths(then_body, table, uncovered, covered)
                                    else_paths: (uncovered: bool, covered: bool, break_uncovered: bool, break_covered: bool) = progress_current_break_paths(else_body, table, uncovered, covered)
                                    uncovered <- then_paths.uncovered or else_paths.uncovered
                                    covered <- then_paths.covered or else_paths.covered
                                    break_uncovered <- break_uncovered or then_paths.break_uncovered or else_paths.break_uncovered
                                    break_covered <- break_covered or then_paths.break_covered or else_paths.break_covered
                        Stmt.Match(scrutinee, arms, line):
                            is_catch: bool = progress_is_catch_match(table, line)
                            scrutinee_aborts: bool = expression_evaluation_aborts(scrutinee, table)
                            scrutinee_raises: bool = expression_may_raise_catchably(scrutinee, table)
                            if scrutinee_aborts and not (is_catch and scrutinee_raises):
                                uncovered <- false
                                covered <- false
                            else:
                                before_uncovered: bool = uncovered
                                before_covered: bool = covered
                                is_total: bool = progress_catch_error_arms_total_at_offset(arms, table, line.line, line.offset, true, true) if is_catch else progress_match_is_total(scrutinee, arms, table)
                                uncovered <- before_uncovered if not is_total
                                covered <- before_covered if not is_total
                                uncovered <- false if is_total
                                covered <- false if is_total
                                arm_index: mutable usize = 0
                                while arm_index < arms.count |arm_index, arms, is_catch, scrutinee, before_uncovered, before_covered, uncovered, covered, break_uncovered, break_covered, table|:
                                    arm: Ast::MatchArm = arms[arm_index]
                                    guard: (known: bool, value: bool) = progress_literal_bool(arm.guard)
                                    reachable: bool = not (guard.known and not guard.value) and (progress_catch_arm_reachable(arms, arm_index) if is_catch else progress_match_arm_reachable(scrutinee, arms, arm_index)) and not (is_catch and scrutinee_aborts and arm_index == 0)
                                    if reachable:
                                        arm_paths: (uncovered: bool, covered: bool, break_uncovered: bool, break_covered: bool) = progress_current_break_paths(arm.body, table, before_uncovered, before_covered)
                                        if not expression_evaluation_aborts(arm.guard, table):
                                            uncovered <- uncovered or arm_paths.uncovered
                                            covered <- covered or arm_paths.covered
                                            break_uncovered <- break_uncovered or arm_paths.break_uncovered
                                            break_covered <- break_covered or arm_paths.break_covered
                                    arm_index <- arm_index + 1
                        Stmt.While(_, _, _) | Stmt.For(_, _, _, _, _):
                            pass
                        _:
                            pass
                    if statement_terminates(statement, table):
                        uncovered <- false
                        covered <- false
                return (uncovered, covered, break_uncovered, break_covered)

        # A `break` that can leave the current loop. Do not count breaks owned by nested loops,
        # and stop looking through an earlier unconditional exit.
        def progress_body_has_current_break(statements: darray[Ast::Stmt], table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                for statement in statements:
                    match statement:
                        Stmt.Break(_, _):
                            return true
                        Stmt.If(condition, then_body, else_body, _):
                            if not expression_evaluation_aborts(condition, table):
                                literal: (known: bool, value: bool) = progress_literal_bool(condition)
                                if literal.known:
                                    selected: darray[Ast::Stmt] = then_body if literal.value else else_body
                                    return true if progress_body_has_current_break(selected, table)
                                else:
                                    return true if progress_body_has_current_break(then_body, table) or progress_body_has_current_break(else_body, table)
                        Stmt.Match(scrutinee, arms, _):
                            if not expression_evaluation_aborts(scrutinee, table):
                                arm_index: mutable usize = 0
                                while arm_index < arms.count |arm_index, arms, scrutinee, table|:
                                    arm: Ast::MatchArm = arms[arm_index]
                                    guard: (known: bool, value: bool) = progress_literal_bool(arm.guard)
                                    if progress_match_arm_reachable(scrutinee, arms, arm_index) and not (guard.known and not guard.value) and not expression_evaluation_aborts(arm.guard, table):
                                        return true if progress_body_has_current_break(arm.body, table)
                                    arm_index <- arm_index + 1
                        Stmt.Block(_, _, _, body, _):
                            return true if progress_body_has_current_break(body, table)
                        Stmt.While(_, _, _) | Stmt.For(_, _, _, _, _):
                            pass
                        _:
                            pass
                    return false if statement_terminates(statement, table)
                return false

        # Resolve zero-argument direct callees only when their name is unambiguous in this local
        # declaration graph. A one-segment module scope equal to current_module is local; other
        # qualified leaf names can belong to another module. The path bits keep hatches branch-local.
        def progress_zero_arg_direct_callee_name(callee: Ast::Expr, table: SymbolTable&) -> sview:
            can Abort.Panic:
                return match callee:
                    Expr.Ident(name, _): name
                    Expr.Scope(Expr.Ident(module_name, _), name, _) if table.current_module == module_name: name
                    Expr.Paren(inner, _): progress_zero_arg_direct_callee_name(inner, table)
                    _: ""

        def progress_collect_zero_arg_calls_expr(expression: Ast::Expr, out: mutable darray[sview]&, protected_edges: mutable darray[bool]&, uncovered: mutable bool&, covered: mutable bool&, table: SymbolTable&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, line):
                        progress_collect_zero_arg_calls_expr(callee, out, protected_edges, uncovered, covered, table)
                        if expression_evaluation_aborts(callee, table):
                            uncovered <- false
                            covered <- false
                        else:
                            if arguments.count == 0:
                                direct_name: sview = progress_zero_arg_direct_callee_name(callee, table)
                                if direct_name != "":
                                    out.push(direct_name)
                                    protected_edges.push(covered == true and uncovered == false)
                            for argument in arguments |out|:
                                progress_collect_zero_arg_calls_expr(argument, out, protected_edges, uncovered, covered, table)
                                break if expression_evaluation_aborts(argument, table)
                    Expr.Binary(left, operator, right, line):
                        progress_collect_zero_arg_calls_expr(left, out, protected_edges, uncovered, covered, table)
                        short_circuit: (known: bool, value: bool) = progress_literal_bool(left)
                        if not expression_evaluation_aborts(left, table) and not (operator == TokenKind.And and short_circuit.known and not short_circuit.value) and not (operator == TokenKind.Or and short_circuit.known and short_circuit.value):
                            progress_collect_zero_arg_calls_expr(right, out, protected_edges, uncovered, covered, table)
                    Expr.Unary(operator, operand, line):
                        progress_collect_zero_arg_calls_expr(operand, out, protected_edges, uncovered, covered, table)
                    Expr.Paren(inner, line):
                        progress_collect_zero_arg_calls_expr(inner, out, protected_edges, uncovered, covered, table)
                    Expr.Field(object, field, line):
                        progress_collect_zero_arg_calls_expr(object, out, protected_edges, uncovered, covered, table)
                    Expr.Index(object, index, line):
                        progress_collect_zero_arg_calls_expr(object, out, protected_edges, uncovered, covered, table)
                        if expression_evaluation_aborts(object, table):
                            uncovered <- false
                            covered <- false
                        else:
                            progress_collect_zero_arg_calls_expr(index, out, protected_edges, uncovered, covered, table)
                    Expr.IndexN(object, indices, line):
                        progress_collect_zero_arg_calls_expr(object, out, protected_edges, uncovered, covered, table)
                        if expression_evaluation_aborts(object, table):
                            uncovered <- false
                            covered <- false
                        else:
                            for index in indices |out|:
                                progress_collect_zero_arg_calls_expr(index, out, protected_edges, uncovered, covered, table)
                                break if expression_evaluation_aborts(index, table)
                    Expr.Scope(base, name, line):
                        progress_collect_zero_arg_calls_expr(base, out, protected_edges, uncovered, covered, table)
                    Expr.Slice(object, low, high, line):
                        progress_collect_zero_arg_calls_expr(object, out, protected_edges, uncovered, covered, table)
                        if not expression_evaluation_aborts(object, table):
                            progress_collect_zero_arg_calls_expr(low, out, protected_edges, uncovered, covered, table)
                            progress_collect_zero_arg_calls_expr(high, out, protected_edges, uncovered, covered, table) if not expression_evaluation_aborts(low, table)
                    Expr.If(condition, then_value, else_value, line):
                        progress_collect_zero_arg_calls_expr(condition, out, protected_edges, uncovered, covered, table)
                        if expression_evaluation_aborts(condition, table):
                            uncovered <- false
                            covered <- false
                        else:
                            before_uncovered: bool = uncovered == true
                            before_covered: bool = covered == true
                            literal: (known: bool, value: bool) = progress_literal_bool(condition)
                            if literal.known:
                                selected_uncovered: mutable bool = before_uncovered
                                selected_covered: mutable bool = before_covered
                                selected_value: Ast::Expr = then_value if literal.value else else_value
                                progress_collect_zero_arg_calls_expr(selected_value, out, protected_edges, selected_uncovered, selected_covered, table)
                                uncovered <- selected_uncovered
                                covered <- selected_covered
                            else:
                                then_uncovered: mutable bool = before_uncovered
                                then_covered: mutable bool = before_covered
                                else_uncovered: mutable bool = before_uncovered
                                else_covered: mutable bool = before_covered
                                progress_collect_zero_arg_calls_expr(then_value, out, protected_edges, then_uncovered, then_covered, table)
                                progress_collect_zero_arg_calls_expr(else_value, out, protected_edges, else_uncovered, else_covered, table)
                                uncovered <- then_uncovered or else_uncovered
                                covered <- then_covered or else_covered
                    Expr.Array(elements, line) | Expr.Tuple(elements, line) | Expr.SetLit(elements, line):
                        for element in elements |out|:
                            progress_collect_zero_arg_calls_expr(element, out, protected_edges, uncovered, covered, table)
                            break if expression_evaluation_aborts(element, table)
                    Expr.DictLit(entries, line):
                        for entry in entries |out|:
                            progress_collect_zero_arg_calls_expr(entry.key, out, protected_edges, uncovered, covered, table)
                            progress_collect_zero_arg_calls_expr(entry.value, out, protected_edges, uncovered, covered, table) if not expression_evaluation_aborts(entry.key, table)
                            break if expression_evaluation_aborts(entry.key, table) or expression_evaluation_aborts(entry.value, table)
                    Expr.Construct(type_expression, fields, line):
                        progress_collect_zero_arg_calls_expr(type_expression, out, protected_edges, uncovered, covered, table)
                        for field in fields |out|:
                            progress_collect_zero_arg_calls_expr(field.value, out, protected_edges, uncovered, covered, table)
                            break if expression_evaluation_aborts(field.value, table)
                    Expr.RecordUpdate(base, fields, line):
                        progress_collect_zero_arg_calls_expr(base, out, protected_edges, uncovered, covered, table)
                        for field in fields |out|:
                            progress_collect_zero_arg_calls_expr(field.value, out, protected_edges, uncovered, covered, table) if not expression_evaluation_aborts(base, table)
                            break if expression_evaluation_aborts(base, table) or expression_evaluation_aborts(field.value, table)
                    Expr.Match(scrutinee, arms, line):
                        progress_collect_zero_arg_calls_expr(scrutinee, out, protected_edges, uncovered, covered, table)
                        if expression_evaluation_aborts(scrutinee, table):
                            uncovered <- false
                            covered <- false
                        else:
                            start_uncovered: bool = uncovered == true
                            start_covered: bool = covered == true
                            match_is_total: bool = progress_match_is_total(scrutinee, arms, table)
                            uncovered <- start_uncovered if not match_is_total
                            covered <- start_covered if not match_is_total
                            uncovered <- false if match_is_total
                            covered <- false if match_is_total
                            arm_index: mutable usize = 0
                            while arm_index < arms.count |arm_index, arms, out, protected_edges, uncovered, covered, start_uncovered, start_covered, table|:
                                arm: Ast::MatchArm = arms[arm_index]
                                guard: (known: bool, value: bool) = progress_literal_bool(arm.guard)
                                if progress_match_arm_reachable(scrutinee, arms, arm_index) and not (guard.known and not guard.value):
                                    arm_uncovered: mutable bool = start_uncovered
                                    arm_covered: mutable bool = start_covered
                                    progress_collect_zero_arg_calls_expr(arm.guard, out, protected_edges, arm_uncovered, arm_covered, table)
                                    if not expression_evaluation_aborts(arm.guard, table):
                                        progress_collect_zero_arg_calls_body(arm.body, out, protected_edges, arm_uncovered, arm_covered, table)
                                        uncovered <- (uncovered == true) or arm_uncovered
                                        covered <- (covered == true) or arm_covered
                                arm_index <- arm_index + 1
                    Expr.Catch(guarded, arms, line):
                        progress_collect_zero_arg_calls_expr(guarded, out, protected_edges, uncovered, covered, table)
                        start_uncovered: bool = uncovered == true
                        start_covered: bool = covered == true
                        guarded_aborts: bool = expression_evaluation_aborts(guarded, table)
                        guarded_may_raise: bool = expression_may_raise_catchably(guarded, table)
                        if guarded_aborts and not guarded_may_raise:
                            uncovered <- false
                            covered <- false
                        else:
                            error_arms_total: bool = progress_catch_error_arms_total_at_offset(arms, table, line.line, line.offset, true, true)
                            has_unmatched_path: bool = not error_arms_total or (not guarded_aborts and arms.count == 0)
                            uncovered <- start_uncovered if has_unmatched_path
                            covered <- start_covered if has_unmatched_path
                            uncovered <- false if not has_unmatched_path
                            covered <- false if not has_unmatched_path
                            arm_index: mutable usize = 0
                            while arm_index < arms.count |arm_index, arms, out, protected_edges, uncovered, covered, start_uncovered, start_covered, table|:
                                arm: Ast::MatchArm = arms[arm_index]
                                guard: (known: bool, value: bool) = progress_literal_bool(arm.guard)
                                arm_reachable: bool = not (guard.known and not guard.value) and progress_catch_arm_reachable(arms, arm_index) and not (guarded_aborts and arm_index == 0)
                                if arm_reachable:
                                    arm_uncovered: mutable bool = start_uncovered
                                    arm_covered: mutable bool = start_covered
                                    progress_collect_zero_arg_calls_expr(arm.guard, out, protected_edges, arm_uncovered, arm_covered, table)
                                    if not expression_evaluation_aborts(arm.guard, table):
                                        progress_collect_zero_arg_calls_body(arm.body, out, protected_edges, arm_uncovered, arm_covered, table)
                                        uncovered <- (uncovered == true) or arm_uncovered
                                        covered <- (covered == true) or arm_covered
                                arm_index <- arm_index + 1
                    Expr.GetElse(guarded, recovery, line):
                        progress_collect_zero_arg_calls_expr(guarded, out, protected_edges, uncovered, covered, table)
                        if expression_evaluation_aborts(guarded, table):
                            uncovered <- false
                            covered <- false
                        else:
                            success_uncovered: bool = uncovered == true
                            success_covered: bool = covered == true
                            recovery_uncovered: mutable bool = success_uncovered
                            recovery_covered: mutable bool = success_covered
                            progress_collect_zero_arg_calls_body(recovery, out, protected_edges, recovery_uncovered, recovery_covered, table)
                            uncovered <- success_uncovered or recovery_uncovered
                            covered <- success_covered or recovery_covered
                    Expr.Comprehension(variable, iterable, condition, body, line, _):
                        progress_collect_zero_arg_calls_expr(iterable, out, protected_edges, uncovered, covered, table)
                        if not progress_empty_iterable(iterable) and not expression_evaluation_aborts(iterable, table):
                            loop_uncovered: mutable bool = uncovered == true
                            loop_covered: mutable bool = covered == true
                            progress_collect_zero_arg_calls_expr(condition, out, protected_edges, loop_uncovered, loop_covered, table)
                            condition_literal: (known: bool, value: bool) = progress_literal_bool(condition)
                            if not expression_evaluation_aborts(condition, table) and not (condition_literal.known and not condition_literal.value):
                                progress_collect_zero_arg_calls_expr(body, out, protected_edges, loop_uncovered, loop_covered, table)
                    Expr.Block(statements, value, captures, line):
                        progress_collect_zero_arg_calls_body(statements, out, protected_edges, uncovered, covered, table)
                        progress_collect_zero_arg_calls_expr(value, out, protected_edges, uncovered, covered, table) if uncovered == true or covered == true
                    Expr.Move(operand, line) | Expr.RegionNew(operand, _, line):
                        progress_collect_zero_arg_calls_expr(operand, out, protected_edges, uncovered, covered, table)
                    Expr.Refinement(base, predicate, line):
                        progress_collect_zero_arg_calls_expr(base, out, protected_edges, uncovered, covered, table)
                        progress_collect_zero_arg_calls_expr(predicate, out, protected_edges, uncovered, covered, table) if not expression_evaluation_aborts(base, table)
                    Expr.StaticEffectCall(effect_type, operation, candidates, arguments, argument_names, line):
                        for child in Ast::effect_runtime_children(candidates, arguments) |out|:
                            progress_collect_zero_arg_calls_expr(child, out, protected_edges, uncovered, covered, table)
                            break if expression_evaluation_aborts(child, table)
                    _:
                        pass

        # Collect call edges while carrying covered and uncovered paths through statement flow.
        def progress_collect_zero_arg_calls_body(statements: darray[Ast::Stmt], out: mutable darray[sview]&, protected_edges: mutable darray[bool]&, uncovered: mutable bool&, covered: mutable bool&, table: SymbolTable&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |out, protected_edges, uncovered, covered, table|:
                    return if uncovered == false and covered == false
                    match statement:
                        Stmt.Expr(expression, expr_line):
                            progress_collect_zero_arg_calls_expr(expression, out, protected_edges, uncovered, covered, table)
                            if expression_aborts(expression, table):
                                uncovered <- false
                                covered <- false
                        Stmt.Return(value, return_line):
                            if value is present_value:
                                progress_collect_zero_arg_calls_expr(present_value, out, protected_edges, uncovered, covered, table)
                            uncovered <- false
                            covered <- false
                            return
                        Stmt.VarDecl(name, type_expression, value, decl_line):
                            progress_collect_zero_arg_calls_expr(type_expression, out, protected_edges, uncovered, covered, table)
                            progress_collect_zero_arg_calls_expr(value, out, protected_edges, uncovered, covered, table) if not expression_evaluation_aborts(type_expression, table)
                            if expression_evaluation_aborts(type_expression, table) or expression_evaluation_aborts(value, table):
                                uncovered <- false
                                covered <- false
                        Stmt.Assign(target, operator, value, assign_line):
                            progress_collect_zero_arg_calls_expr(target, out, protected_edges, uncovered, covered, table)
                            progress_collect_zero_arg_calls_expr(value, out, protected_edges, uncovered, covered, table) if not expression_evaluation_aborts(target, table)
                            if expression_evaluation_aborts(target, table) or expression_evaluation_aborts(value, table):
                                uncovered <- false
                                covered <- false
                        Stmt.If(condition, then_body, else_body, if_line):
                            progress_collect_zero_arg_calls_expr(condition, out, protected_edges, uncovered, covered, table)
                            if expression_evaluation_aborts(condition, table):
                                uncovered <- false
                                covered <- false
                            else:
                                before_uncovered: bool = uncovered
                                before_covered: bool = covered
                                literal: (known: bool, value: bool) = progress_literal_bool(condition)
                                if literal.known:
                                    selected_uncovered: mutable bool = before_uncovered
                                    selected_covered: mutable bool = before_covered
                                    selected_body: darray[Ast::Stmt] = then_body if literal.value else else_body
                                    progress_collect_zero_arg_calls_body(selected_body, out, protected_edges, selected_uncovered, selected_covered, table)
                                    uncovered <- selected_uncovered
                                    covered <- selected_covered
                                else:
                                    then_uncovered: mutable bool = before_uncovered
                                    then_covered: mutable bool = before_covered
                                    else_uncovered: mutable bool = before_uncovered
                                    else_covered: mutable bool = before_covered
                                    progress_collect_zero_arg_calls_body(then_body, out, protected_edges, then_uncovered, then_covered, table)
                                    progress_collect_zero_arg_calls_body(else_body, out, protected_edges, else_uncovered, else_covered, table)
                                    uncovered <- then_uncovered or else_uncovered
                                    covered <- then_covered or else_covered
                        Stmt.While(condition, while_body, while_line):
                            progress_collect_zero_arg_calls_expr(condition, out, protected_edges, uncovered, covered, table)
                            literal: (known: bool, value: bool) = progress_literal_bool(condition)
                            if expression_evaluation_aborts(condition, table):
                                uncovered <- false
                                covered <- false
                            elif not (literal.known and not literal.value):
                                before_uncovered: bool = uncovered
                                before_covered: bool = covered
                                body_uncovered: mutable bool = before_uncovered
                                body_covered: mutable bool = before_covered
                                progress_collect_zero_arg_calls_body(while_body, out, protected_edges, body_uncovered, body_covered, table)
                                breaks: (uncovered: bool, covered: bool, break_uncovered: bool, break_covered: bool) = progress_current_break_paths(while_body, table, before_uncovered, before_covered)
                                if literal.known and literal.value:
                                    uncovered <- breaks.break_uncovered
                                    covered <- breaks.break_covered
                                else:
                                    uncovered <- before_uncovered or breaks.break_uncovered
                                    covered <- before_covered or breaks.break_covered
                        Stmt.For(bind, variables, iterable, for_body, for_line):
                            progress_collect_zero_arg_calls_expr(iterable, out, protected_edges, uncovered, covered, table)
                            if expression_evaluation_aborts(iterable, table):
                                uncovered <- false
                                covered <- false
                            elif not progress_empty_iterable(iterable):
                                body_uncovered: mutable bool = uncovered
                                body_covered: mutable bool = covered
                                progress_collect_zero_arg_calls_body(for_body, out, protected_edges, body_uncovered, body_covered, table)
                        Stmt.Match(scrutinee, arms, match_line):
                            is_catch: bool = progress_is_catch_match(table, match_line)
                            scrutinee_aborts: bool = expression_evaluation_aborts(scrutinee, table)
                            scrutinee_raises: bool = expression_may_raise_catchably(scrutinee, table)
                            progress_collect_zero_arg_calls_expr(scrutinee, out, protected_edges, uncovered, covered, table)
                            if scrutinee_aborts and not (is_catch and scrutinee_raises):
                                uncovered <- false
                                covered <- false
                            else:
                                before_uncovered: bool = uncovered
                                before_covered: bool = covered
                                is_total: bool = progress_catch_error_arms_total_at_offset(arms, table, match_line.line, match_line.offset, true, true) if is_catch else progress_match_is_total(scrutinee, arms, table)
                                uncovered <- before_uncovered if not is_total
                                covered <- before_covered if not is_total
                                uncovered <- false if is_total
                                covered <- false if is_total
                                arm_index: mutable usize = 0
                                while arm_index < arms.count |arm_index, arms, uncovered, covered, before_uncovered, before_covered, out, protected_edges, table|:
                                    arm: Ast::MatchArm = arms[arm_index]
                                    guard: (known: bool, value: bool) = progress_literal_bool(arm.guard)
                                    arm_reachable: bool = not (guard.known and not guard.value) and (progress_catch_arm_reachable(arms, arm_index) if is_catch else progress_match_arm_reachable(scrutinee, arms, arm_index)) and not (is_catch and scrutinee_aborts and arm_index == 0)
                                    if arm_reachable:
                                        arm_uncovered: mutable bool = before_uncovered
                                        arm_covered: mutable bool = before_covered
                                        progress_collect_zero_arg_calls_expr(arm.guard, out, protected_edges, arm_uncovered, arm_covered, table)
                                        if not expression_evaluation_aborts(arm.guard, table):
                                            progress_collect_zero_arg_calls_body(arm.body, out, protected_edges, arm_uncovered, arm_covered, table)
                                            uncovered <- uncovered or arm_uncovered
                                            covered <- covered or arm_covered
                                    arm_index <- arm_index + 1
                        Stmt.Contract(kind, expression, contract_line):
                            progress_collect_zero_arg_calls_expr(expression, out, protected_edges, uncovered, covered, table)
                            if expression_evaluation_aborts(expression, table):
                                uncovered <- false
                                covered <- false
                        Stmt.Block(kind, clause, binding, block_body, block_line):
                            before_uncovered: bool = uncovered
                            before_covered: bool = covered
                            grants_progress: bool = (kind == "can" or kind == "trusted") and (any grant in clause where progress_grant_is_evidence(grant))
                            block_uncovered: mutable bool = false if grants_progress else before_uncovered
                            block_covered: mutable bool = true if grants_progress and (before_uncovered or before_covered) else before_covered
                            progress_collect_zero_arg_calls_body(block_body, out, protected_edges, block_uncovered, block_covered, table)
                            block_terminates: bool = statements_terminate(block_body, table)
                            uncovered <- false if block_terminates else block_uncovered
                            covered <- false if block_terminates else block_covered
                        Stmt.Break(_, _) | Stmt.Continue(_, _):
                            uncovered <- false
                            covered <- false
                            return
                        _:
                            pass
                    if statement_terminates(statement, table):
                        uncovered <- false
                        covered <- false
                        return

        # Compatibility helper used by semantic atom probes that only inspect callee names.
        def progress_zero_arg_calls_body(statements: darray[Ast::Stmt], out: mutable darray[sview]&, table: SymbolTable&) -> void:
            can Memory.Allocate, Abort.Panic:
                protected_edges: mutable darray[bool] = []
                uncovered: mutable bool = true
                covered: mutable bool = false
                progress_collect_zero_arg_calls_body(statements, out, protected_edges, uncovered, covered, table)

        # Whether zero-arg-call node `origin` can reach itself following zero-arg-call edges
        # (a non-progressing recursive cycle). `visited` tracks nodes already expanded.
        def progress_reaches_self(origin: usize, current: usize, names: darray[sview]&, has_evidence: darray[bool]&, callee_start: darray[usize]&, callee_count: darray[usize]&, all_callees: darray[sview]&, visited: mutable darray[bool]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                edge: mutable usize = 0
                while edge < callee_count[current] |edge, origin, current, names, has_evidence, callee_start, callee_count, all_callees, visited|:
                    callee_name: sview = all_callees[callee_start[current] + edge]
                    target: mutable i64 = -1
                    probe: mutable usize = 0
                    while probe < names.count |target, probe, callee_name, names|:
                        target <- probe.i64() if names[probe] == callee_name and target < 0
                        probe <- probe + 1
                    if target >= 0:
                        # A closed cycle back to the origin: non-progressing (origin has no
                        # evidence, checked by the caller).
                        return true if target.usize() == origin
                        # A function-level `decreases` contract discharges cycles through it.
                        if not visited[target.usize()] and not has_evidence[target.usize()]:
                            visited[target.usize()] <- true
                            return true if progress_reaches_self(origin, target.usize(), names, has_evidence, callee_start, callee_count, all_callees, visited)
                    edge <- edge + 1
                return false
