# Keep declaration identity in this check: bare names alone conflate modules.
extend Semantic:
    private:
        const PRIVATE_FIELD_ALIAS_LIMIT: usize = 128

        struct PrivateFieldType:
            expression: Ast::Expr
            owner: sview

        struct PrivateFieldBinding:
            name: sview
            value_type: PrivateFieldType

        def pft_unknown() -> PrivateFieldType:
            PrivateFieldType{expression: Expr.Absent, owner: ""}

        def pft_unwrap(value: PrivateFieldType) -> PrivateFieldType:
            can Memory.Allocate, Abort.Panic:
                match value.expression:
                    Expr.Unary(_, operand, _):
                        return pft_unwrap(PrivateFieldType{expression: operand, owner: value.owner})
                    Expr.Paren(inner, _):
                        return pft_unwrap(PrivateFieldType{expression: inner, owner: value.owner})
                    Expr.Refinement(base, _, _):
                        return pft_unwrap(PrivateFieldType{expression: base, owner: value.owner})
                    _:
                        return value

        def pft_owner_matches(head: Ast::Expr, name: sview, owner: sview, scope: sview, table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                return match head:
                    Expr.Ident(bare, _):
                        bare == name and (pma_within_module(scope, owner) or owner == "" or any imported in table.imported_modules where imported == owner)
                    Expr.Scope(base, member_name, _):
                        member_name == name and pma_chain_ends_at(base, owner, sview_len(owner))
                    Expr.Index(base, _, _):
                        pft_owner_matches(base, name, owner, scope, table)
                    Expr.IndexN(base, _, _):
                        pft_owner_matches(base, name, owner, scope, table)
                    _:
                        false

        def pft_alias(value: PrivateFieldType, items: darray[Ast::Decl]&, module_name: sview, table: SymbolTable&) -> PrivateFieldType:
            can Memory.Allocate, Abort.Panic:
                for item in items:
                    match item:
                        Decl.Alias(name, target, _):
                            if pft_owner_matches(value.expression, name, module_name, value.owner, table):
                                return PrivateFieldType{expression: target, owner: module_name}
                        Decl.Module(name, body, _):
                            found: PrivateFieldType = pft_alias(value, body, name, table)
                            return found if not (found.expression is Expr.Absent)
                        Decl.Scoped(body, _):
                            found: PrivateFieldType = pft_alias(value, body, module_name, table)
                            return found if not (found.expression is Expr.Absent)
                        _:
                            pass
                return pft_unknown()

        def pft_resolve(value: PrivateFieldType, declarations: darray[Ast::Decl]&, table: SymbolTable&) -> PrivateFieldType:
            can Memory.Allocate, Abort.Panic:
                resolved: mutable PrivateFieldType = pft_unwrap(value)
                # Recursive aliases are rejected by the type checker; keep this walk bounded.
                for _ in 0..<PRIVATE_FIELD_ALIAS_LIMIT |resolved|:
                    alias_value: PrivateFieldType = pft_alias(resolved, declarations, "", table)
                    return resolved if alias_value.expression is Expr.Absent
                    resolved <- pft_unwrap(alias_value)
                return pft_unknown()

        def pft_field(value: PrivateFieldType, field: sview, declarations: darray[Ast::Decl]&, table: SymbolTable&) -> i64:
            can Memory.Allocate, Abort.Panic:
                unwrapped: PrivateFieldType = pft_resolve(value, declarations, table)
                for index in 0..<table.struct_field_owner.count:
                    continue if table.struct_field_name[index] != field
                    if pft_owner_matches(unwrapped.expression, table.struct_field_owner[index], struct_field_module_at(table, index), unwrapped.owner, table):
                        return index.i64()
                return -1

        def pft_element(value: PrivateFieldType) -> PrivateFieldType:
            can Memory.Allocate, Abort.Panic:
                unwrapped: PrivateFieldType = pft_unwrap(value)
                return match unwrapped.expression:
                    Expr.Index(head, element, _):
                        if element is Expr.IntLit(_, _):
                            PrivateFieldType{expression: head, owner: value.owner}
                        else:
                            PrivateFieldType{expression: element, owner: value.owner}
                    Expr.IndexN(_, elements, _):
                        if elements.count > 0:
                            PrivateFieldType{expression: elements[elements.count - 1], owner: value.owner}
                        else:
                            return pft_unknown()
                    _:
                        return pft_unknown()

        def pft_call_type(callee: Ast::Expr, declarations: darray[Ast::Decl]&, module_name: sview, scope: sview, table: SymbolTable&) -> PrivateFieldType:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations:
                    match declaration:
                        Decl.Func(name, _, result, _, _, _, _):
                            if pft_owner_matches(callee, name, module_name, scope, table):
                                if result is result_type:
                                    return PrivateFieldType{expression: result_type, owner: module_name}
                        Decl.Module(name, body, _):
                            found: PrivateFieldType = pft_call_type(callee, body, name, scope, table)
                            return found if not (found.expression is Expr.Absent)
                        Decl.Scoped(body, _):
                            found: PrivateFieldType = pft_call_type(callee, body, module_name, scope, table)
                            return found if not (found.expression is Expr.Absent)
                        _:
                            pass
                return pft_unknown()

        def pft_value(expression: Ast::Expr, bindings: mutable darray[PrivateFieldBinding]&, scope: sview, declarations: darray[Ast::Decl]&, table: SymbolTable&) -> PrivateFieldType:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Ident(name, _):
                        while index > 0 |index: usize = bindings.count|:
                            index <- index - 1
                            return bindings[index].value_type if bindings[index].name == name
                    Expr.Construct(head, _, _):
                        return PrivateFieldType{expression: head, owner: scope}
                    Expr.Call(callee, _, _, _):
                        return pft_call_type(callee, declarations, "", scope, table)
                    Expr.Unary(_, operand, _) | Expr.Paren(operand, _) | Expr.Move(operand, _) | Expr.RegionNew(operand, _, _):
                        return pft_value(operand, bindings, scope, declarations, table)
                    Expr.Field(object, field, _):
                        row: i64 = pft_field(pft_value(object, bindings, scope, declarations, table), field, declarations, table)
                        return PrivateFieldType{expression: table.private_field_types[row.usize()], owner: struct_field_module_at(table, row.usize())} if row >= 0
                    Expr.Index(object, _, _) | Expr.IndexN(object, _, _):
                        return pft_element(pft_value(object, bindings, scope, declarations, table))
                    Expr.Block(statements, result, _, _):
                        mark: usize = bindings.count
                        for statement in statements |bindings|:
                            match statement:
                                Stmt.VarDecl(name, annotation, initializer, _):
                                    inferred: PrivateFieldType = pft_value(initializer, bindings, scope, declarations, table) if annotation is Expr.Absent or annotation is Expr.Invalid else PrivateFieldType{expression: annotation, owner: scope}
                                    bindings.push(PrivateFieldBinding{name: name, value_type: inferred})
                                Stmt.Assign(Expr.Ident(name, _), TokenKind.Assign, initializer, _):
                                    inferred: PrivateFieldType = pft_value(initializer, bindings, scope, declarations, table)
                                    bindings.push(PrivateFieldBinding{name: name, value_type: inferred})
                                _:
                                    pass
                        result_type: PrivateFieldType = pft_value(result, bindings, scope, declarations, table)
                        bindings <- bindings.truncate(mark)
                        return result_type
                    Expr.Catch(guarded, _, _):
                        return pft_value(guarded, bindings, scope, declarations, table)
                    Expr.If(_, then_value, _, _):
                        return pft_value(then_value, bindings, scope, declarations, table)
                    _:
                        pass
                return pft_unknown()

        def pft_report(row: i64, position: Ast::Pos, scope: sview, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                return if row < 0 or row.usize() >= table.struct_field_private.count
                return if not table.struct_field_private[row.usize()]
                owner: sview = struct_field_module_at(table, row.usize())
                return if pma_within_module(scope, owner)
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.PrivateMemberAccess, name: table.struct_field_name[row.usize()], pos: position, line: position.line, expected: "", actual: owner})
