extend Semantic:
    private:
        # Compare an alias with a declaration cutoff. Alias-to-alias cutoffs use the
        # registration comparator above, including ancestor pre-registration. Other
        # declaration cutoffs use global source order, with the same direct-ancestor
        # prepass rule. The max offset is the post-registration lookup used by bodies.
        def semantic_possible_import_alias_precedes_position(alias: Ast::EnumAnnotation, scope: sview, before_offset: u32, table: SymbolTable&) -> (known: bool, precedes: bool):
            can Abort.Panic:
                return (true, true) if before_offset == 4294967295
                for requester in table.definite_import_annotations:
                    if requester.name == "__using_alias" and requester.module == scope and requester.offset == before_offset:
                        return semantic_possible_import_alias_precedes(alias, requester, table)
                for requester in table.possible_import_annotations:
                    if requester.name == "__using_alias" and requester.module == scope and requester.offset == before_offset:
                        return semantic_possible_import_alias_precedes(alias, requester, table)
                alias_is_branch: bool = semantic_import_alias_is_static_branch(alias, table)
                if alias.module == scope:
                    return (true, alias.offset < before_offset) if alias_is_branch
                    return (true, true)
                if named_type_owner_is_lexical(alias.module, scope):
                    return (false, false) if alias_is_branch
                    return (true, true)
                return (false, false) if alias.offset == before_offset
                return (true, alias.offset < before_offset)


        # An unresolved branch alias matters only if it can still win the global alias
        # map at this declaration. A definite alias registered earlier always shadows it.
        def semantic_possible_import_alias_can_win(alias: Ast::EnumAnnotation, import_scope: sview, before_offset: u32, table: SymbolTable&) -> bool:
            can Abort.Panic:
                candidate_before: (known: bool, precedes: bool) = semantic_possible_import_alias_precedes_position(alias, import_scope, before_offset, table)
                return false if candidate_before.known and not candidate_before.precedes
                selected_found: mutable bool = false
                found_prior: mutable bool = false
                winner_ambiguous: mutable bool = false
                selected: mutable Ast::EnumAnnotation = alias
                for candidate in table.definite_import_annotations |selected_found, selected, alias, import_scope, before_offset, table|:
                    continue if candidate.name != "__using_alias" or candidate.owner != alias.owner
                    before_position: (known: bool, precedes: bool) = semantic_possible_import_alias_precedes_position(candidate, import_scope, before_offset, table)
                    continue if not before_position.known or not before_position.precedes
                    found_prior <- true
                    candidate_wins: mutable bool = true
                    for other in table.definite_import_annotations |candidate_wins, candidate, alias, import_scope, before_offset, table|:
                        continue if other.name != "__using_alias" or other.owner != alias.owner
                        continue if other.module == candidate.module and other.line == candidate.line and other.offset == candidate.offset
                        other_before_position: (known: bool, precedes: bool) = semantic_possible_import_alias_precedes_position(other, import_scope, before_offset, table)
                        continue if other_before_position.known and not other_before_position.precedes
                        order: (known: bool, precedes: bool) = semantic_possible_import_alias_precedes(other, candidate, table)
                        candidate_wins <- false if not order.known or order.precedes
                    if candidate_wins:
                        winner_ambiguous <- true if selected_found
                        selected <- candidate
                        selected_found <- true
                return true if found_prior and (not selected_found or winner_ambiguous)
                if selected_found:
                    for candidate in table.definite_import_annotations |selected, alias, import_scope, before_offset, table|:
                        continue if candidate.name != "__using_alias" or candidate.owner != alias.owner
                        continue if candidate.module == selected.module and candidate.line == selected.line and candidate.offset == selected.offset
                        before_position: (known: bool, precedes: bool) = semantic_possible_import_alias_precedes_position(candidate, import_scope, before_offset, table)
                        continue if before_position.known and not before_position.precedes
                        order: (known: bool, precedes: bool) = semantic_possible_import_alias_precedes(candidate, selected, table)
                        return true if not order.known or order.precedes
                    order: (known: bool, precedes: bool) = semantic_possible_import_alias_precedes(alias, selected, table)
                    return true if not order.known or order.precedes
                    return false
                return not candidate_before.known or candidate_before.precedes


        # Binding metadata may store an empty/canonical fallback when a prior alias
        # head is branch-unknown. Consult the source target before trusting that fallback.
        def semantic_possible_import_alias_dependency_exists(target_path: sview @source, import_scope: sview, before_offset: u32, table: SymbolTable&, depth: u32 = 0) -> bool:
            can Abort.Panic:
                return true if depth >= 64
                head_length: mutable usize = target_path.len
                for index in 0..<target_path.len:
                    if index + 1.usize() < target_path.len and target_path[index] == 58 and target_path[index + 1.usize()] == 58:
                        head_length <- index
                        break
                alias_name: sview = string_view_slice(target_path, 0, head_length.i64())
                alias: (known: bool, found: bool, target: sview, raw_target: sview, scope: sview, offset: u32) = semantic_possible_import_alias_head_target(alias_name, import_scope, before_offset, table)
                return true if not alias.known
                return false if not alias.found
                return semantic_possible_import_alias_dependency_exists(alias.raw_target, alias.scope, alias.offset, table, depth + 1.u32())


        def semantic_possible_import_alias_module_path_matches(candidate_owner: sview, target: sview, import_scope: sview, before_offset: u32, table: SymbolTable&) -> bool:
            can Abort.Panic:
                head_length: mutable usize = target.len
                for index in 0..<target.len:
                    if index + 1.usize() < target.len and target[index] == 58 and target[index + 1.usize()] == 58:
                        head_length <- index
                        break
                alias_name: sview = string_view_slice(target, 0, head_length.i64())
                suffix: sview = string_view_slice(target, (head_length + 2.usize()).i64(), target.len.i64()) if head_length < target.len else ""
                for alias in table.possible_import_annotations |candidate_owner, alias_name, suffix, import_scope, before_offset, table|:
                    continue if alias.name != "__using_alias" or alias.owner != alias_name
                    continue if not semantic_possible_import_alias_can_win(alias, import_scope, before_offset, table)
                    for target_row in table.possible_import_annotations:
                        continue if target_row.name != "__using_alias_target" or target_row.module != alias.module or target_row.line != alias.line or target_row.offset != alias.offset
                        return true if semantic_possible_import_alias_target_matches(candidate_owner, target_row.owner, suffix, target_row.module, target_row.offset, table)
                for alias in table.binding_import_annotations |candidate_owner, alias_name, suffix, import_scope, before_offset, table|:
                    continue if alias.name != "__using_alias" or alias.owner != alias_name
                    continue if not semantic_possible_import_alias_can_win(alias, import_scope, before_offset, table)
                    for raw_target_row in table.definite_import_annotations:
                        continue if raw_target_row.name != "__using_alias_target" or raw_target_row.module != alias.module or raw_target_row.line != alias.line or raw_target_row.offset != alias.offset
                        return true if semantic_possible_import_alias_dependency_exists(raw_target_row.owner, alias.module, alias.offset, table)
                        return true if semantic_possible_import_alias_target_matches(candidate_owner, raw_target_row.owner, suffix, raw_target_row.module, raw_target_row.offset, table)
                return false


        def semantic_possible_import_module_visible(table: SymbolTable&, owner: sview, current_scope: sview) -> bool:
            can Abort.Panic:
                for annotation in table.possible_import_annotations |owner, current_scope, table|:
                    continue if not semantic_import_scope_visible(annotation.module, current_scope)
                    if annotation.name == "__using_alias_target":
                        continue if not semantic_possible_import_alias_target_row_can_win(annotation, current_scope, table)
                        return true if semantic_possible_import_module_path_module_candidate_matches(table, owner, annotation.owner, annotation.module, annotation.offset)
                    elif annotation.name == "__using":
                        continue if semantic_import_using_row_has_alias_pair(annotation, table)
                        return true if semantic_possible_import_module_path_module_candidate_matches(table, owner, annotation.owner, annotation.module, annotation.offset)
                    elif annotation.name == "__binding_wildcard_import":
                        return true if semantic_possible_import_module_path_module_candidate_matches(table, owner, annotation.owner, annotation.module, annotation.offset)
                return false


        def semantic_possible_import_member_visible(table: SymbolTable&, name: sview, current_scope: sview) -> bool:
            can Abort.Panic:
                return any annotation in table.possible_import_annotations where annotation.owner == "__from_member" and annotation.name == name and semantic_import_scope_visible(annotation.module, current_scope)


        def semantic_possible_import_module_alias(table: SymbolTable&, alias_name: sview, current_scope: sview) -> bool:
            can Abort.Panic:
                return any annotation in table.possible_import_annotations where annotation.name == "__using_alias" and annotation.owner == alias_name and semantic_possible_import_alias_can_win(annotation, current_scope, 4294967295, table)


        def semantic_possible_import_member_owner_visible(table: SymbolTable&, owner: sview, name: sview, current_scope: sview) -> bool:
            can Abort.Panic:
                for annotation in table.possible_import_annotations |owner, name, current_scope, table|:
                    continue if annotation.owner != "__from_member" or annotation.name != name or not semantic_import_scope_visible(annotation.module, current_scope)
                    for source in table.possible_import_annotations:
                        continue if source.owner != "__from_src" or source.module != annotation.module or source.line != annotation.line or source.offset != annotation.offset
                        return true if semantic_possible_import_module_path_candidate_matches(table, owner, source.name, name, source.module, source.offset)
                return false


        # Match a module's member with Core's candidate-level fallback: use the alias
        # target when it supplies this queried member, then try the written raw path only
        # when no matching member exists under the selected alias target.
        def semantic_possible_import_module_path_alias_member_visible(table: SymbolTable&, target_path: sview @source, name: sview, import_scope: sview, before_offset: u32) -> bool:
            can Abort.Panic:
                return true if any symbol in table.symbols where symbol.name == name and symbol.kind != SymbolKind.Module and semantic_possible_import_alias_target_alias_matches(symbol.module_owner, target_path, import_scope, before_offset, table)
                member_row: mutable u32 = member_chain_head(table, name)
                while member_row != SYMBOL_INDEX_ROW_NONE |member_row, target_path, name, import_scope, before_offset, table|:
                    member_index: usize = member_row.usize()
                    return true if table.module_member_name[member_index] == name and semantic_possible_import_alias_target_alias_matches(table.module_member_owner[member_index], target_path, import_scope, before_offset, table)
                    member_row <- table.member_name_next[member_index]
                return false


        def semantic_possible_import_module_path_member_visible(table: SymbolTable&, target_path: sview @source, name: sview, import_scope: sview, before_offset: u32) -> bool:
            can Abort.Panic:
                alias_head: (known: bool, found: bool) = semantic_possible_import_alias_target_head_status(target_path, import_scope, before_offset, table)
                return true if not alias_head.known
                if alias_head.found:
                    return true if semantic_possible_import_module_path_alias_member_visible(table, target_path, name, import_scope, before_offset)
                return true if any symbol in table.symbols where symbol.name == name and symbol.kind != SymbolKind.Module and semantic_import_module_path_matches(symbol.module_owner, target_path, import_scope)
                member_row: mutable u32 = member_chain_head(table, name)
                while member_row != SYMBOL_INDEX_ROW_NONE |member_row, target_path, name, import_scope, before_offset|:
                    member_index: usize = member_row.usize()
                    return true if table.module_member_name[member_index] == name and semantic_import_module_path_matches(table.module_member_owner[member_index], target_path, import_scope)
                    member_row <- table.member_name_next[member_index]
                return false


        # For one candidate, first ask whether Core would find any same-name candidate
        # under the selected alias target. Only if that search is empty can the raw path
        # select this candidate. Unknown alias resolution stays possible for this candidate.
        def semantic_possible_import_module_path_candidate_matches(table: SymbolTable&, candidate_owner: sview, target_path: sview @source, name: sview, import_scope: sview, before_offset: u32) -> bool:
            can Abort.Panic:
                alias_head: (known: bool, found: bool) = semantic_possible_import_alias_target_head_status(target_path, import_scope, before_offset, table)
                return true if not alias_head.known
                if alias_head.found and semantic_possible_import_module_path_alias_member_visible(table, target_path, name, import_scope, before_offset):
                    return semantic_possible_import_alias_target_alias_matches(candidate_owner, target_path, import_scope, before_offset, table)
                return semantic_import_module_path_matches(candidate_owner, target_path, import_scope)


        def semantic_possible_import_module_symbol_is_using_alias(symbol: Symbol, table: SymbolTable&) -> bool:
            can Abort.Panic:
                return any alias in table.definite_import_annotations where alias.name == "__using_alias" and alias.owner == symbol.name and alias.line == symbol.line and alias.offset == symbol.offset


        def semantic_possible_import_module_path_alias_module_visible(table: SymbolTable&, target_path: sview @source, import_scope: sview, before_offset: u32) -> bool:
            can Abort.Panic:
                for module_row in table.module_symbol_rows:
                    symbol: Symbol = table.symbols[module_row.usize()]
                    continue if semantic_possible_import_module_symbol_is_using_alias(symbol, table)
                    return true if semantic_possible_import_alias_target_alias_matches(symbol.name, target_path, import_scope, before_offset, table)
                return false


        def semantic_possible_import_module_path_module_candidate_matches(table: SymbolTable&, candidate_owner: sview, target_path: sview @source, import_scope: sview, before_offset: u32) -> bool:
            can Abort.Panic:
                alias_head: (known: bool, found: bool) = semantic_possible_import_alias_target_head_status(target_path, import_scope, before_offset, table)
                return true if not alias_head.known
                if alias_head.found and semantic_possible_import_module_path_alias_module_visible(table, target_path, import_scope, before_offset):
                    return semantic_possible_import_alias_target_alias_matches(candidate_owner, target_path, import_scope, before_offset, table)
                return semantic_import_module_path_matches(candidate_owner, target_path, import_scope)


        def semantic_possible_import_type_path_candidate_matches(table: SymbolTable&, candidate_owner: sview, target_path: sview @source, name: sview, kind: SymbolKind, include_constants: bool, import_scope: sview, before_offset: u32) -> bool:
            can Abort.Panic:
                alias_head: (known: bool, found: bool) = semantic_possible_import_alias_target_head_status(target_path, import_scope, before_offset, table)
                return true if not alias_head.known
                if alias_head.found:
                    alias_candidate_exists: bool = any symbol in table.symbols where symbol.name == name and (symbol.kind == kind or include_constants and symbol.kind == SymbolKind.Const) and semantic_possible_import_alias_target_alias_matches(symbol.module_owner, target_path, import_scope, before_offset, table)
                    if alias_candidate_exists:
                        return semantic_possible_import_alias_target_alias_matches(candidate_owner, target_path, import_scope, before_offset, table)
                return semantic_import_module_path_matches(candidate_owner, target_path, import_scope)


        def semantic_possible_import_import_row_member_visible(table: SymbolTable&, import_row: Ast::EnumAnnotation, name: sview, current_scope: sview) -> bool:
            can Abort.Panic:
                if import_row.name == "__using_alias_target":
                    return false if not semantic_possible_import_alias_target_row_can_win(import_row, current_scope, table)
                elif import_row.name == "__using":
                    return false if semantic_import_using_row_has_alias_pair(import_row, table)
                else:
                    return false if import_row.name != "__binding_wildcard_import"
                return semantic_possible_import_module_path_member_visible(table, import_row.owner, name, import_row.module, import_row.offset)


        def semantic_possible_import_module_member_visible(table: SymbolTable&, owner: sview @source, name: sview, current_scope: sview) -> bool:
            can Abort.Panic:
                if semantic_possible_import_module_visible(table, owner, current_scope):
                    return true if semantic_possible_import_module_path_member_visible(table, owner, name, current_scope, 4294967295)
                for alias in table.possible_import_annotations |owner, name, current_scope, table|:
                    continue if alias.name != "__using_alias" or alias.owner != owner or not semantic_possible_import_alias_can_win(alias, current_scope, 4294967295, table)
                    for target in table.possible_import_annotations:
                        continue if target.name != "__using_alias_target" or target.module != alias.module or target.line != alias.line or target.offset != alias.offset
                        return true if semantic_possible_import_alias_target_row_can_win(target, current_scope, table) and semantic_possible_import_module_path_member_visible(table, target.owner, name, target.module, target.offset)
                return false


        # A possible import makes the bare name unresolved in the semantic sense: it may
        # become visible, but it cannot establish module-only classification or an owner.
        def semantic_possible_import_name_visible(table: SymbolTable&, name: sview, current_scope: sview) -> bool:
            can Abort.Panic:
                return true if semantic_possible_import_member_visible(table, name, current_scope)
                return true if semantic_possible_import_module_alias(table, name, current_scope)
                for annotation in table.possible_import_annotations:
                    module_import: bool = annotation.name == "__using" or annotation.name == "__using_alias_target" or annotation.name == "__binding_wildcard_import"
                    if module_import and semantic_import_scope_visible(annotation.module, current_scope):
                        return true if semantic_possible_import_import_row_member_visible(table, annotation, name, current_scope)
                return false


        # Used by exact nominal-owner selectors: if a possible import names a candidate
        # declaration, callers must decline instead of selecting that owner as definite.
        def semantic_possible_import_may_select_type(table: SymbolTable&, name: sview, kind: SymbolKind, current_scope: sview, include_constants: bool = false) -> bool:
            can Abort.Panic:
                for annotation in table.possible_import_annotations |name, kind, current_scope, include_constants, table|:
                    continue if not semantic_import_scope_visible(annotation.module, current_scope)
                    if annotation.owner == "__from_member" and annotation.name == name:
                        for source in table.possible_import_annotations:
                            continue if source.owner != "__from_src" or source.module != annotation.module or source.line != annotation.line or source.offset != annotation.offset
                            return true if any symbol in table.symbols where symbol.name == name and (symbol.kind == kind or include_constants and symbol.kind == SymbolKind.Const) and semantic_possible_import_type_path_candidate_matches(table, symbol.module_owner, source.name, name, kind, include_constants, source.module, source.offset)
                    module_import: bool = annotation.name == "__using" or annotation.name == "__using_alias_target" or annotation.name == "__binding_wildcard_import"
                    if module_import:
                        continue if annotation.name == "__using_alias_target" and not semantic_possible_import_alias_target_row_can_win(annotation, current_scope, table)
                        continue if annotation.name == "__using" and semantic_import_using_row_has_alias_pair(annotation, table)
                        return true if any symbol in table.symbols where symbol.name == name and (symbol.kind == kind or include_constants and symbol.kind == SymbolKind.Const) and semantic_possible_import_type_path_candidate_matches(table, symbol.module_owner, annotation.owner, name, kind, include_constants, annotation.module, annotation.offset)
                return false
