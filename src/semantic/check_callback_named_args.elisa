# Named arguments through a function-valued local are sound only when every direct
# function that can flow into the local exposes the same parameter names.
extend Semantic:
    private:
        def callback_slot(names: darray[sview]&, wanted: sview) -> int:
            can Abort.Panic:
                while index > 0 |index: usize = names.count|:
                    index <- index - 1
                    index.int() return if names[index] == wanted
                return -1


        def function_parameter_names_agree(table: SymbolTable&, left: sview, right: sview) -> bool:
            can Abort.Panic:
                left_count: usize = function_parameter_count(table, left)
                false return if left_count != function_parameter_count(table, right)
                for position in 0..<left_count:
                    false return if function_parameter_name_at(table, left, position) != function_parameter_name_at(table, right, position)
                return true


        def direct_function_value(expression: Ast::Expr, table: SymbolTable&) -> sview:
            can Abort.Panic:
                match expression:
                    Expr.Ident(name, line):
                        return name if direct_function_count(table, name) == 1 else ""
                    Expr.Paren(inner, line):
                        return direct_function_value(inner, table)
                    _:
                        return ""


        def note_callback_source(local_name: sview, source: sview, callback_names: mutable darray[sview]&, callback_sources: mutable darray[sview]&, callback_conflicts: mutable darray[bool]&, callback_effects: mutable darray[bool]&, table: SymbolTable&) -> void:
            can Memory.Allocate, Abort.Panic:
                return if source == ""
                slot: int = callback_slot(callback_names, local_name)
                if slot < 0:
                    callback_names.push(local_name)
                    callback_sources.push(source)
                    callback_conflicts.push(false)
                    callback_effects.push(function_has_effect(table, source))
                    return
                position: usize = slot.usize()
                callback_conflicts[position] <- true if not function_parameter_names_agree(table, callback_sources[position], source)
                callback_effects[position] <- true if function_has_effect(table, source)


        def check_callback_named_call(expression: Ast::Expr, callback_names: darray[sview]&, callback_conflicts: darray[bool]&, callback_effects: darray[bool]&, in_grant: bool, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(Expr.Ident(name, ident_line), arguments, argument_names, line):
                        slot: int = callback_slot(callback_names, name)
                        has_named: bool = any argument_name in argument_names where argument_name != ""
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.CallArgumentError, name: "func", line: line, expected: "no_names", actual: ""}) if slot >= 0 and callback_conflicts[slot.usize()] and has_named
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UngrantedEffectCall, name: "func", line: line, expected: "", actual: ""}) if slot >= 0 and callback_effects[slot.usize()] and not in_grant
                    _:
                        pass


        def walk_callback_named_statements(statements: darray[Ast::Stmt], callback_names: mutable darray[sview]&, callback_sources: mutable darray[sview]&, callback_conflicts: mutable darray[bool]&, callback_effects: mutable darray[bool]&, in_grant: bool, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |callback_names, callback_sources, callback_conflicts, callback_effects, table| -> table:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            source: sview = direct_function_value(value, table)
                            note_callback_source(name, source, callback_names, callback_sources, callback_conflicts, callback_effects, table)
                            table <- check_callback_named_call(value, callback_names, callback_conflicts, callback_effects, in_grant, table)
                        Stmt.Assign(target, operator, value, line):
                            if target is Expr.Ident(name, target_line):
                                source: sview = direct_function_value(value, table)
                                note_callback_source(name, source, callback_names, callback_sources, callback_conflicts, callback_effects, table) if callback_slot(callback_names, name) >= 0
                            table <- check_callback_named_call(value, callback_names, callback_conflicts, callback_effects, in_grant, table)
                        Stmt.Expr(expression, line):
                            table <- check_callback_named_call(expression, callback_names, callback_conflicts, callback_effects, in_grant, table)
                        Stmt.Return(value, line):
                            table <- check_callback_named_call(returned, callback_names, callback_conflicts, callback_effects, in_grant, table) if value is returned
                        Stmt.If(condition, then_body, else_body, line):
                            table <- walk_callback_named_statements(then_body, callback_names, callback_sources, callback_conflicts, callback_effects, in_grant, table)
                            table <- walk_callback_named_statements(else_body, callback_names, callback_sources, callback_conflicts, callback_effects, in_grant, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            nested_grant: bool = in_grant or kind == "can" or kind == "trusted"
                            table <- walk_callback_named_statements(body, callback_names, callback_sources, callback_conflicts, callback_effects, nested_grant, table)
                        Stmt.While(_, body, line) | Stmt.For(_, _, _, body, line):
                            table <- walk_callback_named_statements(body, callback_names, callback_sources, callback_conflicts, callback_effects, in_grant, table)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |table| -> table:
                                table <- walk_callback_named_statements(arm.body, callback_names, callback_sources, callback_conflicts, callback_effects, in_grant, table)
                        _:
                            pass


        def check_callback_named_declarations(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            callback_names: mutable darray[sview] = []
                            callback_sources: mutable darray[sview] = []
                            callback_conflicts: mutable darray[bool] = []
                            callback_effects: mutable darray[bool] = []
                            table <- walk_callback_named_statements(body, callback_names, callback_sources, callback_conflicts, callback_effects, false, table)
                        Decl.Module(name, body, line) | Decl.Scoped(body, line):
                            table <- check_callback_named_declarations(body, table)
                        _:
                            pass

    public:
        def check_callback_named_args(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- check_callback_named_declarations(declarations, table)
