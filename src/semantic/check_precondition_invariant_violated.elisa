# Precondition violated by a STRUCT-INVARIANT-derived argument interval. A call
# `needs_neg(b.idx)` where `b: Box&`, `struct Box: invariant self.idx >= 0`, and
# `needs_neg` requires `s < 0` provably violates the precondition — every value the
# invariant admits ([0, +inf)) fails `s < 0`. stage0 emits "precondition of X is
# violated: the argument provably does not satisfy". SOUND decidable subset: the field's
# invariant is a single `self.FIELD <cmp> CONST` interval, the argument is exactly
# `recv.FIELD` with recv a parameter of that struct type, and the callee's requires is a
# single `PARAM <cmp> CONST` — the violation holds when the requires is FALSE across the
# WHOLE invariant interval. Exact intervals ⇒ never overfires.
extend Semantic:
    private:
        # (struct, field) -> integer interval [lo, hi] from a `self.FIELD <cmp> CONST`
        # struct invariant. Parallel side-tables.
        def pv_collect_field_intervals(declarations: darray[Ast::Decl], structs: mutable darray[sview]&, fields: mutable darray[sview]&, los: mutable darray[i64]&, his: mutable darray[i64]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |structs, fields, los, his|:
                    match declaration:
                        Decl.Struct(name, members, affinity, has_named_states, has_derive, invariants, line):
                            for invariant_predicate in invariants |structs, fields, los, his, name|:
                                pv_record_invariant(name, invariant_predicate, structs, fields, los, his)
                        Decl.Module(module_name, module_body, module_line):
                            pv_collect_field_intervals(module_body, structs, fields, los, his)
                        Decl.Scoped(scoped_body, scoped_line):
                            pv_collect_field_intervals(scoped_body, structs, fields, los, his)
                        _:
                            pass

        # Record one `self.FIELD <cmp> CONST` invariant as a struct/field interval bound.
        def pv_record_invariant(struct_name: sview, predicate: Ast::Expr, structs: mutable darray[sview]&, fields: mutable darray[sview]&, los: mutable darray[i64]&, his: mutable darray[i64]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match predicate:
                    Expr.Paren(inner, paren_line):
                        pv_record_invariant(struct_name, inner, structs, fields, los, his)
                    Expr.Binary(left, operator, right, line):
                        field_name: sview = pv_self_field(left)
                        return if field_name == ""
                        literal: (found: bool, value: i64) = where_signed_literal(right)
                        return if not literal.found
                        lo: mutable i64 = 0 - 4000000000000000000
                        hi: mutable i64 = 4000000000000000000
                        lo <- literal.value + 1 if operator == TokenKind.Gt
                        lo <- literal.value if operator == TokenKind.GtEq
                        hi <- literal.value - 1 if operator == TokenKind.Lt
                        hi <- literal.value if operator == TokenKind.LtEq
                        has_bound: bool = operator == TokenKind.Gt or operator == TokenKind.GtEq or operator == TokenKind.Lt or operator == TokenKind.LtEq
                        if has_bound:
                            structs.push(struct_name)
                            fields.push(field_name)
                            los.push(lo)
                            his.push(hi)
                    _:
                        pass

        # The FIELD name of a `self.FIELD` access, or "".
        def pv_self_field(expression: Ast::Expr) -> sview:
            can Abort.Panic:
                match expression:
                    Expr.Field(object, field, field_line):
                        if object is Expr.Ident(object_name, object_line):
                            return field if object_name == "self" else sview("", 0, 0)
                        return sview("", 0, 0)
                    Expr.Paren(inner, paren_line):
                        return pv_self_field(inner)
                    _:
                        return sview("", 0, 0)

        # Whether `predicate` (a `VAR <cmp> CONST` requires) is FALSE for EVERY value in
        # [lo, hi] — i.e. the argument provably violates it.
        def pv_false_over_interval(predicate: Ast::Expr, variable: sview, lo: i64, hi: i64) -> bool:
            can Memory.Allocate, Abort.Panic:
                match predicate:
                    Expr.Paren(inner, paren_line):
                        return pv_false_over_interval(inner, variable, lo, hi)
                    Expr.Binary(left, operator, right, line):
                        pv_false_over_interval(left, variable, lo, hi) or pv_false_over_interval(right, variable, lo, hi) return if operator == TokenKind.And
                        pv_false_over_interval(left, variable, lo, hi) and pv_false_over_interval(right, variable, lo, hi) return if operator == TokenKind.Or
                        # `VAR <cmp> CONST`
                        names_var: mutable bool = false
                        if left is Expr.Ident(left_name, left_line):
                            names_var <- left_name == variable
                        false return if not names_var
                        literal: (found: bool, value: i64) = where_signed_literal(right)
                        false return if not literal.found
                        c: i64 = literal.value
                        return when operator:
                            TokenKind.Lt -> lo >= c
                            TokenKind.LtEq -> lo > c
                            TokenKind.Gt -> hi <= c
                            TokenKind.GtEq -> hi < c
                            TokenKind.EqEq -> c < lo or c > hi
                            _ -> false
                    _:
                        return false

        # Param name -> its struct type (via erasure_base_type_name), restricted to structs
        # that actually declare a field interval.
        def pv_check_body(statements: darray[Ast::Stmt], param_names: darray[sview]&, param_structs: darray[sview]&, pre_functions: darray[sview]&, pre_variables: darray[sview]&, pre_indices: darray[usize]&, pre_predicates: darray[Ast::Expr]&, structs: darray[sview]&, fields: darray[sview]&, los: darray[i64]&, his: darray[i64]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- pv_check_expr(expression, line, param_names, param_structs, pre_functions, pre_variables, pre_indices, pre_predicates, structs, fields, los, his, table)
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- pv_check_expr(value, line, param_names, param_structs, pre_functions, pre_variables, pre_indices, pre_predicates, structs, fields, los, his, table)
                        Stmt.Assign(target, operator, value, line):
                            table <- pv_check_expr(value, line, param_names, param_structs, pre_functions, pre_variables, pre_indices, pre_predicates, structs, fields, los, his, table)
                        Stmt.Return(value, line):
                            if value is returned:
                                table <- pv_check_expr(returned, line, param_names, param_structs, pre_functions, pre_variables, pre_indices, pre_predicates, structs, fields, los, his, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- pv_check_body(then_body, param_names, param_structs, pre_functions, pre_variables, pre_indices, pre_predicates, structs, fields, los, his, table)
                            table <- pv_check_body(else_body, param_names, param_structs, pre_functions, pre_variables, pre_indices, pre_predicates, structs, fields, los, his, table)
                        Stmt.While(condition, while_body, line):
                            table <- pv_check_body(while_body, param_names, param_structs, pre_functions, pre_variables, pre_indices, pre_predicates, structs, fields, los, his, table)
                        Stmt.Block(kind, clause, binding, block_body, line):
                            table <- pv_check_body(block_body, param_names, param_structs, pre_functions, pre_variables, pre_indices, pre_predicates, structs, fields, los, his, table)
                        Stmt.For(bind, variables, iterable, for_body, line):
                            table <- pv_check_body(for_body, param_names, param_structs, pre_functions, pre_variables, pre_indices, pre_predicates, structs, fields, los, his, table)
                        _:
                            pass

        def pv_check_expr(expression: Ast::Expr, line: u32, param_names: darray[sview]&, param_structs: darray[sview]&, pre_functions: darray[sview]&, pre_variables: darray[sview]&, pre_indices: darray[usize]&, pre_predicates: darray[Ast::Expr]&, structs: darray[sview]&, fields: darray[sview]&, los: darray[i64]&, his: darray[i64]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, call_line):
                        callee_name: sview = ident_name_of(callee)
                        pre_probe: mutable usize = 0
                        while pre_probe < pre_functions.count |pre_probe, table| -> table:
                            if callee_name != "" and pre_functions[pre_probe] == callee_name and pre_indices[pre_probe] < arguments.count:
                                interval: (found: bool, lo: i64, hi: i64) = pv_argument_interval(arguments[pre_indices[pre_probe]], param_names, param_structs, structs, fields, los, his)
                                violates: bool = interval.found and pv_false_over_interval(pre_predicates[pre_probe], pre_variables[pre_probe], interval.lo, interval.hi)
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.PreconditionViolated, name: callee_name, line: line, expected: "", actual: ""}) if violates
                            pre_probe <- pre_probe + 1
                        for argument in arguments |table| -> table:
                            table <- pv_check_expr(argument, line, param_names, param_structs, pre_functions, pre_variables, pre_indices, pre_predicates, structs, fields, los, his, table)
                    Expr.Binary(left, operator, right, binary_line):
                        table <- pv_check_expr(left, line, param_names, param_structs, pre_functions, pre_variables, pre_indices, pre_predicates, structs, fields, los, his, table)
                        table <- pv_check_expr(right, line, param_names, param_structs, pre_functions, pre_variables, pre_indices, pre_predicates, structs, fields, los, his, table)
                    Expr.Paren(inner, paren_line):
                        table <- pv_check_expr(inner, line, param_names, param_structs, pre_functions, pre_variables, pre_indices, pre_predicates, structs, fields, los, his, table)
                    _:
                        pass

        # The interval of an argument that is exactly `recv.FIELD` where recv is a parameter
        # of a struct type carrying a `self.FIELD` invariant interval.
        def pv_argument_interval(argument: Ast::Expr, param_names: darray[sview]&, param_structs: darray[sview]&, structs: darray[sview]&, fields: darray[sview]&, los: darray[i64]&, his: darray[i64]&) -> (found: bool, lo: i64, hi: i64):
            can Memory.Allocate, Abort.Panic:
                match argument:
                    Expr.Field(object, field, field_line):
                        if object is Expr.Ident(receiver_name, receiver_line):
                            struct_name: sview = pv_param_struct(receiver_name, param_names, param_structs)
                            (false, 0, 0) return if struct_name == ""
                            probe: mutable usize = 0
                            while probe < structs.count |probe, struct_name, field, structs, fields, los, his|:
                                (true, los[probe], his[probe]) return if structs[probe] == struct_name and fields[probe] == field
                                probe <- probe + 1
                        return (false, 0, 0)
                    Expr.Paren(inner, paren_line):
                        return pv_argument_interval(inner, param_names, param_structs, structs, fields, los, his)
                    _:
                        return (false, 0, 0)

        def pv_param_struct(receiver_name: sview, param_names: darray[sview]&, param_structs: darray[sview]&) -> sview:
            can Abort.Panic:
                probe: mutable usize = 0
                while probe < param_names.count |probe, receiver_name, param_names, param_structs|:
                    param_structs[probe] return if param_names[probe] == receiver_name
                    probe <- probe + 1
                return sview("", 0, 0)

        def pv_walk(declarations: darray[Ast::Decl], pre_functions: darray[sview]&, pre_variables: darray[sview]&, pre_indices: darray[usize]&, pre_predicates: darray[Ast::Expr]&, structs: darray[sview]&, fields: darray[sview]&, los: darray[i64]&, his: darray[i64]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            param_names: mutable darray[sview] = []
                            param_structs: mutable darray[sview] = []
                            for parameter in parameters |param_names, param_structs|:
                                param_names.push(parameter.name)
                                param_structs.push(erasure_base_type_name(parameter.type_expression))
                            table <- pv_check_body(body, param_names, param_structs, pre_functions, pre_variables, pre_indices, pre_predicates, structs, fields, los, his, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- pv_walk(module_body, pre_functions, pre_variables, pre_indices, pre_predicates, structs, fields, los, his, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- pv_walk(scoped_body, pre_functions, pre_variables, pre_indices, pre_predicates, structs, fields, los, his, table)
                        _:
                            pass

    public:
        def check_precondition_invariant_violated(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                structs: mutable darray[sview] = []
                fields: mutable darray[sview] = []
                los: mutable darray[i64] = []
                his: mutable darray[i64] = []
                pv_collect_field_intervals(declarations, structs, fields, los, his)
                return if structs.count == 0
                pre_functions: mutable darray[sview] = []
                pre_variables: mutable darray[sview] = []
                pre_indices: mutable darray[usize] = []
                pre_predicates: mutable darray[Ast::Expr] = []
                no_contract_lines: darray[u32] = []
                no_contract_kinds: darray[sview] = []
                no_contract_exprs: darray[Ast::Expr] = []
                no_extern_params: darray[Ast::ExternParam] = []
                collect_preconditions(declarations, no_contract_lines, no_contract_kinds, no_contract_exprs, no_extern_params, pre_functions, pre_variables, pre_indices, pre_predicates)
                table <- pv_walk(declarations, pre_functions, pre_variables, pre_indices, pre_predicates, structs, fields, los, his, table)
