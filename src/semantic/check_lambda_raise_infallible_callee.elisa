# Callback contracts still apply when their enclosing callee returns no error.
extend Semantic:
    private:
        def lrc_check_unique_infallible_call(file: Ast::File&, callee: Ast::Expr, arguments: darray[Ast::Expr], argument_names: darray[sview @source], call_pos: Ast::Pos, caller_params: darray[Ast::ParamDecl], caller_name: sview @source, caller_pos: Ast::Pos, bound: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                return if not (any argument in arguments where lrc_argument_is_lambda(argument))
                callable: (known: bool, qualifier: sview @source, name: sview @source) = ewr_callable_parts(callee, table)
                return if not callable.known
                root_end: usize = catch_first_module_separator_start(callable.qualifier)
                root: sview = callable.qualifier[0:root_end] if callable.qualifier != "" else callable.name
                return if any local_name in bound where local_name == root
                lexical_module: sview @source = table.current_module
                return if ewr_unknown_static_import_affects_call(table.protocol_annotations, file.top_decls, callable.name, callable.qualifier, lexical_module, table)
                rebind owner: (found: bool, owner: sview), table = typestate_resolve_callable_owner(callable.name, lexical_module, callable.qualifier, call_pos, file, table)
                return if not owner.found
                selected: mutable u32 = SYMBOL_INDEX_ROW_NONE
                row: mutable u32 = symbol_chain_head(table, callable.name)
                while row != SYMBOL_INDEX_ROW_NONE |row, selected|:
                    symbol: Symbol = table.symbols[row.usize()]
                    if symbol.kind == SymbolKind.Func and symbol.name == callable.name and symbol.module_owner == owner.owner:
                        branch: (known: bool, active: bool) = pma_static_if_function_branch_selection(file, callable.name, symbol, table, 0)
                        return if not branch.known
                        if branch.active:
                            return if selected != SYMBOL_INDEX_ROW_NONE
                            selected <- row
                    row <- table.symbol_name_next[row.usize()]
                return if selected == SYMBOL_INDEX_ROW_NONE
                winner: Symbol = table.symbols[selected.usize()]
                return if not ewr_callable_name_visible(table.protocol_annotations, callable.name, winner.module_owner, lexical_module, winner.line, winner.offset)
                has_return_error: bool = any marker in file.enum_annotations where marker.owner == callable.name and marker.name == "__error_return" and marker.line == winner.line and marker.offset == winner.offset
                return if has_return_error
                arity: (found: bool, accepts: bool) = ewr_declaration_accepts_arity(file.top_decls, winner.line, winner.offset, arguments.count)
                return if not arity.found or not arity.accepts
                locals: mutable darray[sview] = []
                for index in caller_params.count..<bound.count |locals, bound|:
                    locals.push(bound[index])
                resolution: (found: bool, resolvable: bool) = ewr_declaration_call_arguments_resolvable(file.top_decls, winner.line, winner.offset, arguments, argument_names, false, caller_params, locals)
                return if not resolution.found or not resolution.resolvable
                identity: mutable u32 = 0
                for marker in file.enum_annotations |identity, winner|:
                    identity <- marker.identity_id if marker.owner == "__error_set_family" and marker.line == winner.line and marker.offset == winner.offset
                caller_identity: (identity: u32, occurrence: u32) = raise_function_identity_occurrence(file.enum_annotations, caller_name, caller_pos)
                caller_module: mutable (known: bool, module: sview @source) = raise_function_module(file.enum_annotations, caller_pos, caller_identity.identity, caller_identity.occurrence)
                caller_module <- (true, lexical_module) if not caller_module.known
                target: (known: bool, module: sview @source, line: u32, offset: u32, identity_id: u32, function_name: sview @source, occurrence_offset: u32) = (true, winner.module_owner, winner.line, winner.offset, identity, callable.name, 0)
                for argument_index in 0..<arguments.count |table| -> table:
                    argument_target: (known: bool, module: sview @source, line: u32, offset: u32, identity_id: u32, function_name: sview @source, occurrence_offset: u32) = lrc_argument_target(target, argument_index, argument_names, file.enum_annotations, table)
                    table <- lrc_check_lambda_argument(arguments[argument_index], argument_target, caller_name, caller_pos, caller_identity.identity, caller_module.known, caller_module.module, file.enum_annotations, table) if argument_target.known
