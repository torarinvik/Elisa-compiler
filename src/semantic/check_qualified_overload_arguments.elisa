# Check arguments after a qualified overload has been selected by its
# first argument. Parameter rows are read by declaration identity, not by name.
extend Semantic:
    private:
        def qualified_overload_argument_check(file: Ast::File&, qualifier: sview @source, name: sview @source, arguments: darray[Ast::Expr], argument_names: darray[sview @source], call_pos: Ast::Pos, caller_params: darray[Ast::ParamDecl], bound: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                return if arguments.count < 2
                return if any argument_name in argument_names where argument_name != ""
                qualifier_end: usize = catch_first_module_separator_start(qualifier)
                qualifier_head: sview = qualifier[0:qualifier_end]
                return if any local_name in bound where local_name == qualifier_head
                return if ewr_unknown_static_import_affects_call(table.protocol_annotations, file.top_decls, name, qualifier, table.current_module, table)
                locals: mutable darray[sview] = []
                for index in caller_params.count..<bound.count |locals, bound|:
                    locals.push(bound[index])
                receiver: (known: bool, kind: u8, name: sview) = ewr_actual_primitive_type(arguments[0], caller_params, locals)
                return if not receiver.known
                selected: mutable u32 = SYMBOL_INDEX_ROW_NONE
                best: mutable usize = 0
                best_count: mutable usize = 0
                candidate_count: mutable usize = 0
                module_rank: mutable usize = 0
                module_owner: mutable sview @source = ""
                ambiguous_module: mutable bool = false
                row: mutable u32 = symbol_chain_head(table, name)
                while row != SYMBOL_INDEX_ROW_NONE:
                    symbol: Symbol = table.symbols[row.usize()]
                    if symbol.kind == SymbolKind.Func and symbol.name == name:
                        rank: usize = ewr_qualified_module_rank(symbol.module_owner, qualifier, table.current_module, table.protocol_annotations, table)
                        if rank == 0 or rank < module_rank:
                            row <- table.symbol_name_next[row.usize()]
                            continue
                        branch: (known: bool, active: bool) = pma_static_if_function_branch_selection(file, name, symbol, table, 0)
                        return if not branch.known
                        if branch.active:
                            if rank > module_rank:
                                module_rank <- rank
                                module_owner <- symbol.module_owner
                                selected <- SYMBOL_INDEX_ROW_NONE
                                best <- 0
                                best_count <- 0
                                candidate_count <- 0
                                ambiguous_module <- false
                            ambiguous_module <- true if symbol.module_owner != module_owner
                            candidate_count <- candidate_count + 1
                            arity: (found: bool, accepts: bool) = ewr_declaration_accepts_arity(file.top_decls, symbol.line, symbol.offset, arguments.count)
                            return if not arity.found
                            if arity.accepts:
                                matched: (known: bool, viable: bool, specificity: usize) = ewr_declaration_call_match(file.top_decls, symbol.line, symbol.offset, symbol.module_owner, arguments, argument_names, file.extern_params, table.protocol_annotations, caller_params, locals)
                                return if not matched.known
                                if matched.viable:
                                    if selected == SYMBOL_INDEX_ROW_NONE or matched.specificity > best:
                                        selected <- row
                                        best <- matched.specificity
                                        best_count <- 1
                                    elif matched.specificity == best:
                                        best_count <- best_count + 1
                    row <- table.symbol_name_next[row.usize()]
                return if candidate_count < 2 or selected == SYMBOL_INDEX_ROW_NONE or best_count != 1 or ambiguous_module
                winner: Symbol = table.symbols[selected.usize()]
                return if not ewr_callable_name_visible(table.protocol_annotations, name, winner.module_owner, table.current_module, winner.line, winner.offset)
                bytes: mutable darray[u8] = []
                for index in 0..<winner.module_owner.len |bytes, winner|:
                    byte: u8 = winner.module_owner[index]
                    bytes.push(46.u8()) if byte == 58 and (index == 0 or winner.module_owner[index - 1] != 58)
                    bytes.push(byte) if byte != 58
                bytes.push(46.u8())
                for index in 0..<name.len |bytes, name|:
                    bytes.push(name[index])
                diagnostic_name: sview @source = intern_joined_text(bytes, table)
                parameter_position: mutable usize = 0
                parameter_row: mutable u32 = function_param_chain_head(table, name)
                while parameter_row != SYMBOL_INDEX_ROW_NONE and parameter_position < arguments.count:
                    index: usize = parameter_row.usize()
                    if table.function_param_owner[index] == name and index < table.function_param_declaration_id.count and table.function_param_declaration_id[index].value == winner.id.value:
                        if parameter_position > 0:
                            argument: Ast::Expr = arguments[parameter_position]
                            actual: sview = literal_kind_of(argument)
                            expected: sview = table.function_param_type[index]
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.LiteralArgTypeMismatch, name: diagnostic_name, pos: Ast::expr_pos(argument), line: call_pos.line, expected: expected, actual: stage0_literal_spelling(actual), expected_count: (parameter_position + 1).u32()}) if actual != "" and expected != "" and literal_never_fits(actual, expected)
                            argument_type: (known: bool, kind: u8, name: sview) = ewr_actual_primitive_type(argument, caller_params, locals) if actual == "" else (false, 0, "")
                            argument_family: sview = family_of_type_name(argument_type.name) if argument_type.known and argument_type.kind == 5 else ""
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.FirmArgTypeMismatch, name: diagnostic_name, pos: Ast::expr_pos(argument), line: call_pos.line, expected: expected, actual: argument_type.name, expected_count: (parameter_position + 1).u32()}) if expected != "" and argument_family != "" and firm_never_fits(argument_family, expected)
                        parameter_position <- parameter_position + 1
                    parameter_row <- table.function_param_name_next[index]
