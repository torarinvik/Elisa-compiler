# Flatten only identifier, value-field, and namespace-scope paths into ordered segments.
module SemanticTypePathCollectPolicy:
    public:
        def collect(expression: Ast::Expr, names: mutable darray[sview]&, dotted: mutable darray[bool]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Ast::Expr.Ident(ident_name, ident_pos):
                        names.push(ident_name)
                        return true
                    Ast::Expr.Field(field_object, field_name, field_pos):
                        false return if not collect(field_object, names, dotted)
                        names.push(field_name)
                        dotted.push(true)
                        return true
                    Ast::Expr.Scope(scope_base, scope_name, scope_pos):
                        false return if not collect(scope_base, names, dotted)
                        names.push(scope_name)
                        dotted.push(false)
                        return true
                    _:
                        return false
