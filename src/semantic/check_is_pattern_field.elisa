# Unknown field in an `is` struct-pattern test. `EXPR is Struct(field: sub, ...)` parses its
# RHS as a named-argument call whose argument names ARE the pattern's field names (an `is`-RHS
# has no value-call meaning, so a registered-struct callee there is always a pattern-test). A
# named field that the struct does not declare is rejected ("struct 'S' has no field 'f'"), the
# same as a struct literal. SOUND subset: fire only for a registered struct with a KNOWN closed
# field set; positional pattern args (no name) and unregistered callees are skipped. Nested
# patterns (`span: Span(missing: start)`) recurse through the argument values.
extend Semantic:
    private:
        # Validate an `is`-RHS pattern expression: a struct/variant call whose named arguments
        # must be declared fields of a registered struct callee, recursing into sub-patterns.
        def validate_is_pattern(pattern: Ast::Expr, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match pattern:
                    Expr.Call(callee, arguments, argument_names, line):
                        struct_name: sview = ident_name_of(callee)
                        if struct_name != "" and struct_is_registered(table, struct_name):
                            argument_index: mutable usize = 0
                            for field_name in argument_names |table, argument_index| -> table:
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UnknownFieldAccess, name: field_name, line: line, expected: struct_name, actual: ""}) if field_name != "" and not struct_has_field(table, struct_name, field_name)
                                argument_index <- argument_index + 1
                        for argument in arguments |table| -> table:
                            table <- validate_is_pattern(argument, table)
                    Expr.Paren(inner, line):
                        table <- validate_is_pattern(inner, table)
                    _:
                        pass

        def is_pattern_walk_expression(expression: Ast::Expr, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Binary(left, operator, right, line):
                        table <- is_pattern_walk_expression(left, table)
                        table <- validate_is_pattern(right, table) if operator == TokenKind.Is
                        table <- is_pattern_walk_expression(right, table) if operator != TokenKind.As and operator != TokenKind.Is
                    Expr.Unary(operator, operand, line):
                        table <- is_pattern_walk_expression(operand, table)
                    Expr.Paren(inner, line):
                        table <- is_pattern_walk_expression(inner, table)
                    Expr.Call(callee, arguments, argument_names, line):
                        for argument in arguments |table| -> table:
                            table <- is_pattern_walk_expression(argument, table)
                    Expr.If(condition, then_expr, else_expr, line):
                        table <- is_pattern_walk_expression(condition, table)
                        table <- is_pattern_walk_expression(then_expr, table)
                        table <- is_pattern_walk_expression(else_expr, table)
                    Expr.Block(statements, value, captures, line):
                        table <- is_pattern_walk_statements(statements, table)
                        table <- is_pattern_walk_expression(value, table)
                    Expr.Match(scrutinee, arms, line):
                        table <- is_pattern_walk_expression(scrutinee, table)
                        for arm in arms |table| -> table:
                            table <- is_pattern_walk_expression(arm.guard, table)
                            table <- is_pattern_walk_statements(arm.body, table)
                    _:
                        pass

        def is_pattern_walk_statements(statements: darray[Ast::Stmt], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- is_pattern_walk_expression(expression, table)
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- is_pattern_walk_expression(value, table)
                        Stmt.Assign(target, operator, value, line):
                            table <- is_pattern_walk_expression(value, table)
                        Stmt.Return(value, line):
                            if value is returned:
                                table <- is_pattern_walk_expression(returned, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- is_pattern_walk_expression(condition, table)
                            table <- is_pattern_walk_statements(then_body, table)
                            table <- is_pattern_walk_statements(else_body, table)
                        Stmt.While(condition, body, line):
                            table <- is_pattern_walk_expression(condition, table)
                            table <- is_pattern_walk_statements(body, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- is_pattern_walk_expression(iterable, table)
                            table <- is_pattern_walk_statements(body, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- is_pattern_walk_statements(body, table)
                        Stmt.Match(scrutinee, arms, line):
                            table <- is_pattern_walk_expression(scrutinee, table)
                            for arm in arms |table| -> table:
                                table <- is_pattern_walk_expression(arm.guard, table)
                                table <- is_pattern_walk_statements(arm.body, table)
                        Stmt.Contract(kind, expression, line):
                            table <- is_pattern_walk_expression(expression, table)
                        _:
                            pass

        def check_is_pattern_field_declarations(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            table <- is_pattern_walk_statements(body, table)
                        Decl.Module(module_name, body, line):
                            table <- check_is_pattern_field_declarations(body, table)
                        Decl.Scoped(body, line):
                            table <- check_is_pattern_field_declarations(body, table)
                        _:
                            pass

    public:
        def check_is_pattern_field(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- check_is_pattern_field_declarations(declarations, table)
