extend Semantic:
    private:
        def vp_pass(all_decls: VpCounts&, declarations: darray[Ast::Decl], fr: darray[sview]&, facts: mutable VpFacts&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |facts, table| -> table:
                    match declaration:
                        Decl.Func(fname, parameters, return_type, body, effects, decorators, line):
                            cur: sview = fname if vp_count_names(all_decls, fname) == 1 else ""
                            cs: sview = fname if vp_count_arity(all_decls, fname, parameters.count) == 1 else ""
                            pn: mutable darray[sview] = []
                            sn: mutable darray[sview] = []
                            sf: mutable darray[u32] = []
                            sp: mutable darray[u32] = []
                            sa: mutable darray[sview] = []
                            for parameter in parameters |pn, sn, sf, sp, sa, table|:
                                flags: mutable u32 = 32
                                flags <- flags | 1024 if chv_type_is_builtin_darray(parameter.type_expression, facts.scalar_type_mask)
                                if param_is_mutable_ref(parameter) and annotation_is_container(parameter.type_expression):
                                    region_tied: bool = any tied_name in table.region_tied_param_names where tied_name == parameter.name
                                    if not region_tied:
                                        flags <- flags | 16
                                        flags <- flags | 128 if not annotation_is_scalar_darray(parameter.type_expression)
                                bit: u32 = (1.u32() << pn.count.u32()) if pn.count < 15 else 0.u32()
                                pn.push(parameter.name)
                                vp_set(sn, sf, sp, sa, parameter.name, flags, bit)
                            vp_collect_decls(body, sn, sf, sp, sa, facts.scalar_type_mask)
                            scoped_binders: mutable BorrowBinders = BorrowBinders{names: []}
                            has_scalar_target: bool = any parameter_name in pn where (vp_flags(sn, sf, parameter_name) & 16) != 0 and (vp_flags(sn, sf, parameter_name) & 128) == 0
                            has_count_receiver: bool = any flags in sf where (flags & 3072) != 0
                            borrow_binders_statements(body, scoped_binders) if has_scalar_target or has_count_receiver
                            unknown_binder: bool = any scoped_binder in scoped_binders.names where scoped_binder == "*"
                            if unknown_binder:
                                for row in 0..<sf.count |sf|:
                                    # Keep store checking, but remove every type-based copy proof.
                                    sf[row] <- sf[row] | 512
                            for scoped_binder in scoped_binders.names |sn, sf, sp, sa|:
                                # A same-named binder anywhere invalidates the parameter proof.
                                vp_set(sn, sf, sp, sa, scoped_binder, 8, 0) if (vp_flags(sn, sf, scoped_binder) & 32) != 0
                            if has_count_receiver:
                                for row in 0..<sn.count |sn, sf, sp, sa, scoped_binders|:
                                    continue if (sf[row] & 2048) == 0
                                    occurrences: mutable usize = 0
                                    for binder in scoped_binders.names |occurrences, sn, row|:
                                        occurrences <- occurrences + 1 if binder == sn[row]
                                    sf[row] <- sf[row] | 8 if occurrences > 1
                            table <- vp_walk(body, cur, cs, pn, fr, sn, sf, sp, sa, facts, table) can Global{Read,Write}
                        Decl.Module(module_name, module_body, module_line):
                            table <- vp_pass(all_decls, module_body, fr, facts, table) can Global{Read,Write}
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- vp_pass(all_decls, scoped_body, fr, facts, table) can Global{Read,Write}
                        _:
                            pass

    public:
        def check_view_provenance(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                fr: mutable darray[sview] = []
                scalar_type_mask: u64 = chv_scalar_mask_without_import_aliases(chv_scalar_mask_without_import_aliases(chv_unshadowed_scalar_types(table), table.protocol_annotations), table.possible_import_annotations)
                facts: mutable VpFacts = VpFacts{scalar_type_mask: scalar_type_mask, filln: [], filli: [], stn: [], sti: [], stj: [], retn: [], retf: []}
                counts: mutable VpCounts = VpCounts{heads: {}, tails: {}, next: [], names: [], arities: [], counts: []}
                vp_counts_build(declarations, counts) can Global{Read,Write}
                vp_collect_fresh(counts, declarations, fr)
                round: mutable u32 = 0
                while round < 6 |round, facts, table| -> table:
                    before: mutable u32 = facts.filln.count.u32() + facts.stn.count.u32()
                    for flag in facts.retf |before|:
                        before <- before + flag + 1
                    table <- vp_pass(counts, declarations, fr, facts, table) can Global{Read,Write}
                    after: mutable u32 = facts.filln.count.u32() + facts.stn.count.u32()
                    for flag in facts.retf |after|:
                        after <- after + flag + 1
                    round <- 6 if after == before else round + 1
