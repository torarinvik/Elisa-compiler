# A struct construction `Box{v: n}` whose field `v` carries a `where v > 0` refinement and whose
# supplied value cannot establish it (a call/field/arithmetic expression, or a bare parameter that
# is not itself refined) is unproven under the non-SMT prover — stage0 warns "where refinement on
# field could not be proven". A literal value (`Box{v: 5}`) is discharged/violated elsewhere and a
# refined-parameter value carries the fact, so both stay silent. Region-safe: leaf extractors for
# StructMember/ParamDecl bindings, flat Decl walk (mirrors check_local_where_violated).
extend Semantic:
    private:
        def sfcu_member_where_refined(member: Ast::StructMember) -> bool:
            can Memory.Allocate, Abort.Panic:
                return match where_predicate_of_type(member.type_expression):
                    Expr.Absent: false
                    _: true

        def sfcu_member_name(member: Ast::StructMember) -> sview:
            can Memory.Allocate, Abort.Panic:
                return member.name

        def sfcu_collect_refined_members(members: darray[Ast::StructMember], struct_name: sview, struct_out: mutable darray[sview]&, field_out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                index: mutable usize = 0
                while index < members.count |index, struct_name, struct_out, field_out, members|:
                    if sfcu_member_where_refined(members[index]):
                        struct_out.push(struct_name)
                        field_out.push(sfcu_member_name(members[index]))
                    index <- index + 1

        def sfcu_collect_refined_fields(declarations: darray[Ast::Decl], struct_out: mutable darray[sview]&, field_out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations:
                    match declaration:
                        Decl.Struct(struct_name, members, affinity, has_named_states, has_derive, invariants, struct_line):
                            sfcu_collect_refined_members(members, struct_name, struct_out, field_out)
                        Decl.Module(module_name, module_body, module_line):
                            sfcu_collect_refined_fields(module_body, struct_out, field_out)
                        Decl.Scoped(scoped_body, scoped_line):
                            sfcu_collect_refined_fields(scoped_body, struct_out, field_out)
                        _:
                            pass

        def sfcu_field_refined(struct_name: sview, field: sview, struct_names: darray[sview]&, field_names: darray[sview]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                index: mutable usize = 0
                while index < struct_names.count |index, struct_name, field, struct_names, field_names|:
                    true return if struct_names[index] == struct_name and field_names[index] == field
                    index <- index + 1
                return false

        # A parameter type carries a refinement fact (a `where` predicate or an is-Law).
        def sfcu_param_is_refined(type_expression: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                true return if local_refinement_law_name(type_expression) != ""
                return match where_predicate_of_type(type_expression):
                    Expr.Absent: false
                    _: true

        # Whether a construction value provably cannot establish a field refinement.
        def sfcu_value_unprovable(value: Ast::Expr, param_names: darray[sview]&, param_refined: darray[bool]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                match value:
                    Expr.Call(callee, arguments, argument_names, call_line):
                        return true
                    Expr.Field(object, field, field_line):
                        return true
                    Expr.Binary(left, operator, right, binary_line):
                        return true
                    Expr.Unary(operator, operand, unary_line):
                        return true
                    Expr.Ident(name, ident_line):
                        slot: mutable i64 = -1
                        probe: mutable usize = 0
                        while probe < param_names.count |slot, probe, name, param_names|:
                            slot <- probe.i64() if param_names[probe] == name and slot < 0
                            probe <- probe + 1
                        return not param_refined[slot.usize()] if slot >= 0 else false
                    _:
                        return false

        def sfcu_walk_expr(expression: Ast::Expr, struct_names: darray[sview]&, field_names: darray[sview]&, param_names: darray[sview]&, param_refined: darray[bool]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Construct(type_expression, fields, construct_line):
                        struct_name: sview = bare_type_name(type_expression)
                        for field_init in fields |table| -> table:
                            fire: bool = sfcu_field_refined(struct_name, field_init.name, struct_names, field_names) and sfcu_value_unprovable(field_init.value, param_names, param_refined)
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.PreconditionUnproven, name: "where refinement on field", line: construct_line, expected: "", actual: ""}) if fire
                            table <- sfcu_walk_expr(field_init.value, struct_names, field_names, param_names, param_refined, table)
                    Expr.Binary(left, operator, right, binary_line):
                        table <- sfcu_walk_expr(left, struct_names, field_names, param_names, param_refined, table)
                        table <- sfcu_walk_expr(right, struct_names, field_names, param_names, param_refined, table)
                    Expr.Paren(inner, paren_line):
                        table <- sfcu_walk_expr(inner, struct_names, field_names, param_names, param_refined, table)
                    Expr.Call(callee, arguments, argument_names, call_line):
                        for argument in arguments |table| -> table:
                            table <- sfcu_walk_expr(argument, struct_names, field_names, param_names, param_refined, table)
                    _:
                        pass

        def sfcu_walk_stmts(statements: darray[Ast::Stmt], struct_names: darray[sview]&, field_names: darray[sview]&, param_names: darray[sview]&, param_refined: darray[bool]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Expr(expression, expr_line):
                            table <- sfcu_walk_expr(expression, struct_names, field_names, param_names, param_refined, table)
                        Stmt.VarDecl(name, type_expression, value, decl_line):
                            table <- sfcu_walk_expr(value, struct_names, field_names, param_names, param_refined, table)
                        Stmt.Assign(target, operator, value, assign_line):
                            table <- sfcu_walk_expr(value, struct_names, field_names, param_names, param_refined, table)
                        Stmt.Return(value, return_line):
                            if value is returned_value:
                                table <- sfcu_walk_expr(returned_value, struct_names, field_names, param_names, param_refined, table)
                        Stmt.If(condition, then_body, else_body, if_line):
                            table <- sfcu_walk_stmts(then_body, struct_names, field_names, param_names, param_refined, table)
                            table <- sfcu_walk_stmts(else_body, struct_names, field_names, param_names, param_refined, table)
                        Stmt.While(while_condition, while_body, while_line):
                            table <- sfcu_walk_stmts(while_body, struct_names, field_names, param_names, param_refined, table)
                        Stmt.For(bind, variables, iterable, for_body, for_line):
                            table <- sfcu_walk_stmts(for_body, struct_names, field_names, param_names, param_refined, table)
                        Stmt.Block(kind, clause, binding, block_body, block_line):
                            table <- sfcu_walk_stmts(block_body, struct_names, field_names, param_names, param_refined, table)
                        _:
                            pass

        def sfcu_param_name(parameter: Ast::ParamDecl) -> sview:
            can Memory.Allocate, Abort.Panic:
                return parameter.name

        def sfcu_walk_decls(declarations: darray[Ast::Decl], struct_names: darray[sview]&, field_names: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, func_line):
                            param_names: mutable darray[sview] = []
                            param_refined: mutable darray[bool] = []
                            for parameter in parameters |param_names, param_refined|:
                                param_names.push(sfcu_param_name(parameter))
                                param_refined.push(sfcu_param_is_refined(parameter.type_expression))
                            table <- sfcu_walk_stmts(body, struct_names, field_names, param_names, param_refined, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- sfcu_walk_decls(module_body, struct_names, field_names, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- sfcu_walk_decls(scoped_body, struct_names, field_names, table)
                        _:
                            pass

        def check_struct_field_construct_unproven(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                struct_names: mutable darray[sview] = []
                field_names: mutable darray[sview] = []
                sfcu_collect_refined_fields(declarations, struct_names, field_names)
                return if struct_names.count == 0
                table <- sfcu_walk_decls(declarations, struct_names, field_names, table)
