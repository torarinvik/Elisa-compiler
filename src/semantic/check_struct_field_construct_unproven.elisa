# Values enter refined fields through constructions, record updates, and mutable stores. If the
# checker cannot prove a supplied value satisfies the field's `where` invariant, Stage1 rejects
# the program rather than emitting code that can violate the promised representation invariant.
# This pass is deliberately a sound subset: interval facts and constants are recognized, while
# unsupported proof shapes or operations that may invalidate facts fail closed.
# Region-safe: leaf extractors for StructMember/ParamDecl bindings, flat Decl walk.
extend Semantic:
    private:
        def sfcu_member_where_refined(member: Ast::StructMember) -> bool:
            can Memory.Allocate, Abort.Panic:
                return match where_predicate_of_type(member.type_expression):
                    Expr.Absent: false
                    _: true

        def sfcu_member_name(member: Ast::StructMember) -> sview:
            can Abort.Panic:
                return member.name

        def sfcu_collect_refined_members(members: darray[Ast::StructMember], struct_name: sview, struct_out: mutable darray[sview]&, field_out: mutable darray[sview]&, lo_out: mutable darray[i64]&, hi_out: mutable darray[i64]&) -> void:
            can Memory.Allocate, Abort.Panic:
                index: mutable usize = 0
                while index < members.count |index, struct_name, struct_out, field_out, lo_out, hi_out, members|:
                    if sfcu_member_where_refined(members[index]):
                        struct_out.push(struct_name)
                        field_out.push(sfcu_member_name(members[index]))
                        window: (found: bool, lo: i64, hi: i64) = subject_interval(where_predicate_of_type(members[index].type_expression), members[index].name)
                        # An unknown predicate is not the full integer range. The inverted
                        # interval is a sentinel that prevents unrelated assertions from
                        # accidentally discharging a non-interval invariant.
                        lo_out.push(window.lo if window.found else 1)
                        hi_out.push(window.hi if window.found else 0)
                    index <- index + 1

        def sfcu_collect_refined_fields(declarations: darray[Ast::Decl], struct_out: mutable darray[sview]&, field_out: mutable darray[sview]&, lo_out: mutable darray[i64]&, hi_out: mutable darray[i64]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations:
                    match declaration:
                        Decl.Struct(struct_name, members, affinity, has_named_states, has_derive, invariants, struct_line):
                            sfcu_collect_refined_members(members, struct_name, struct_out, field_out, lo_out, hi_out)
                        Decl.Module(module_name, module_body, module_line):
                            sfcu_collect_refined_fields(module_body, struct_out, field_out, lo_out, hi_out)
                        Decl.Scoped(scoped_body, scoped_line):
                            sfcu_collect_refined_fields(scoped_body, struct_out, field_out, lo_out, hi_out)
                        _:
                            pass

        def sfcu_field_refined(struct_name: sview, field: sview, struct_names: darray[sview]&, field_names: darray[sview]&) -> bool:
            can Abort.Panic:
                index: mutable usize = 0
                while index < struct_names.count |index, struct_name, field, struct_names, field_names|:
                    true return if struct_names[index] == struct_name and field_names[index] == field
                    index <- index + 1
                return false

        # The where-window [lo, hi] recorded for (struct, field), or a full i64 range if none.
        def sfcu_field_window(struct_name: sview, field: sview, struct_names: darray[sview]&, field_names: darray[sview]&, field_lo: darray[i64]&, field_hi: darray[i64]&) -> (lo: i64, hi: i64):
            can Abort.Panic:
                index: mutable usize = 0
                while index < struct_names.count |index, struct_name, field, struct_names, field_names, field_lo, field_hi|:
                    (field_lo[index], field_hi[index]) return if struct_names[index] == struct_name and field_names[index] == field
                    index <- index + 1
                return (0 - 9223372036854775807 - 1, 9223372036854775807)

        def sfcu_is_zeroed(value: Ast::Expr) -> bool:
            can Abort.Panic:
                match value:
                    Expr.Ident(name, ident_line):
                        return name == "zeroed"
                    Expr.Paren(inner, _):
                        return sfcu_is_zeroed(inner)
                    Expr.Move(inner, _):
                        return sfcu_is_zeroed(inner)
                    Expr.If(_, then_value, else_value, _):
                        return sfcu_is_zeroed(then_value) or sfcu_is_zeroed(else_value)
                    Expr.Block(_, result, _, _):
                        return sfcu_is_zeroed(result)
                    _:
                        return false

        # Check the all-zero representation against every directly refined field. A field with
        # an unknown/non-interval invariant has the inverted interval sentinel and fails closed.
        def sfcu_check_zeroed_struct(struct_name: sview, pos: Ast::Pos, struct_names: darray[sview]&, field_names: darray[sview]&, field_lo: darray[i64]&, field_hi: darray[i64]&, table: lmut SymbolTable, alias_depth: usize) -> void:
            can Memory.Allocate, Abort.Panic:
                index: mutable usize = 0
                while index < struct_names.count |index, struct_name, pos, struct_names, field_names, field_lo, field_hi, table|:
                    if struct_names[index] == struct_name and (field_lo[index] > 0 or field_hi[index] < 0):
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.StructFieldRefinementUnproven, name: field_names[index], pos: pos, line: pos.line, expected: struct_name, actual: "zeroed"})
                    index <- index + 1
                alias_index: mutable usize = 0
                alias_limit: usize = table.type_alias_name.count
                return if alias_depth > alias_limit
                while alias_index < alias_limit and alias_index < table.type_alias_target.count |alias_index, alias_limit, struct_name, pos, struct_names, field_names, field_lo, field_hi, table, alias_depth|:
                    if table.type_alias_name[alias_index] == struct_name:
                        alias_target: sview = table.type_alias_target[alias_index]
                        sfcu_check_zeroed_struct(alias_target, pos, struct_names, field_names, field_lo, field_hi, table, alias_depth + 1) if alias_target != struct_name
                    alias_index <- alias_index + 1

        # Structural equality of two value expressions (ident / field-path / paren), so an
        # asserted subject `source.n` matches a construction value `source.n`.
        def sfcu_expr_same(a: Ast::Expr, b: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                match a:
                    Expr.Paren(a_inner, a_paren_line):
                        return sfcu_expr_same(a_inner, b)
                    Expr.Ident(a_name, a_ident_line):
                        match b:
                            Expr.Ident(b_name, b_ident_line):
                                return a_name == b_name
                            _:
                                pass
                    Expr.Field(a_object, a_field, a_field_line):
                        match b:
                            Expr.Field(b_object, b_field, b_field_line):
                                return a_field == b_field and sfcu_expr_same(a_object, b_object)
                            _:
                                pass
                    _:
                        pass
                match b:
                    Expr.Paren(b_inner, b_paren_line):
                        return sfcu_expr_same(a, b_inner)
                    _:
                        pass
                return false

        # Accumulate the interval an established predicate asserts on `value` (structural
        # subject match), e.g. `assert source.n >= 1 and source.n <= 8` -> [1, 8].
        def sfcu_accumulate_value_bounds(predicate: Ast::Expr, value: Ast::Expr, lo_ref: mutable i64&, hi_ref: mutable i64&, any_ref: mutable bool&) -> void:
            can Memory.Allocate, Abort.Panic:
                match predicate:
                    Expr.Paren(inner, paren_line):
                        sfcu_accumulate_value_bounds(inner, value, lo_ref, hi_ref, any_ref)
                    Expr.Binary(left, operator, right, binary_line):
                        if operator == TokenKind.And:
                            sfcu_accumulate_value_bounds(left, value, lo_ref, hi_ref, any_ref)
                            sfcu_accumulate_value_bounds(right, value, lo_ref, hi_ref, any_ref)
                        else:
                            right_literal: (found: bool, value: i64) = fold_const_int(right)
                            left_literal: (found: bool, value: i64) = fold_const_int(left)
                            apply_bound_comparison(operator, right_literal.value, lo_ref, hi_ref, any_ref) if sfcu_expr_same(left, value) and right_literal.found
                            apply_bound_comparison(flip_comparison(operator), left_literal.value, lo_ref, hi_ref, any_ref) if sfcu_expr_same(right, value) and left_literal.found
                    _:
                        pass

        # Whether the established predicates prove `value` lies within [window_lo, window_hi].
        def sfcu_value_within_window(value: Ast::Expr, window_lo: i64, window_hi: i64, established: darray[Ast::Expr]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                false return if window_lo > window_hi
                constant: (found: bool, value: i64) = fold_const_int(value)
                return constant.found and constant.value >= window_lo and constant.value <= window_hi if constant.found
                lo: mutable i64 = 0 - 9223372036854775807 - 1
                hi: mutable i64 = 9223372036854775807
                any_bound: mutable bool = false
                for predicate in established |lo, hi, any_bound, value|:
                    sfcu_accumulate_value_bounds(predicate, value, lo, hi, any_bound)
                return any_bound and lo >= window_lo and hi <= window_hi

        # A parameter type carries a refinement fact (a `where` predicate or an is-Law).
        def sfcu_param_is_refined(type_expression: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                true return if local_refinement_law_name(type_expression) != ""
                return match where_predicate_of_type(type_expression):
                    Expr.Absent: false
                    _: true

        # Whether a construction value provably cannot establish a field refinement.
        def sfcu_value_unprovable(value: Ast::Expr, param_names: darray[sview]&, param_refined: darray[bool]&) -> bool:
            can Abort.Panic:
                match value:
                    Expr.Ident(name, ident_line):
                        # Even an annotated refined binding must be checked against the
                        # destination field's predicate; an unrelated refinement is not enough.
                        # `param_refined` remains in the walker's lexical rows for future
                        # predicate entailment, but this interval-only proof does not trust it.
                        return true
                    _:
                        # This pass proves only constants, established interval facts, and
                        # already-refined bindings. Unsupported expressions must fail closed.
                        return true

        # Facts are expressions over lexical names. A declaration or loop binder that shadows
        # a name invalidates outer facts mentioning that name for the duration of that scope.
        def sfcu_expr_mentions_name(expression: Ast::Expr, name: sview) -> bool:
            can Abort.Panic:
                match expression:
                    Expr.Ident(ident, line):
                        return ident == name
                    Expr.Paren(inner, line):
                        return sfcu_expr_mentions_name(inner, name)
                    Expr.Unary(operator, operand, line):
                        return sfcu_expr_mentions_name(operand, name)
                    Expr.Binary(left, operator, right, line):
                        return sfcu_expr_mentions_name(left, name) or sfcu_expr_mentions_name(right, name)
                    Expr.Field(object, field, line):
                        return sfcu_expr_mentions_name(object, name)
                    _:
                        # Unknown predicate shapes are dropped conservatively when a binding
                        # shadows a name; keeping a potentially name-dependent fact is unsafe.
                        return true

        def sfcu_drop_facts_for_name(name: sview, established: mutable darray[Ast::Expr]&) -> void:
            can Memory.Allocate, Abort.Panic:
                snapshot: mutable darray[Ast::Expr] = [predicate for predicate in established]
                established.truncate(0)
                for predicate in snapshot |established|:
                    established.push(predicate) if not sfcu_expr_mentions_name(predicate, name)

        # Resolve the struct represented by a record-update base. Keep lexical parameter/local
        # bindings ahead of inference so wrappers and shadowing use the same type rows as stores.
        def sfcu_expr_struct_type(expression: Ast::Expr, param_names: darray[sview]&, param_types: darray[sview]&, table: SymbolTable&) -> sview:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Ident(name, ident_line):
                        return sfcu_param_type(name, param_names, param_types)
                    Expr.Construct(type_expression, fields, construct_line):
                        return bare_type_name_through_ref(type_expression)
                    Expr.RecordUpdate(base, fields, update_line):
                        return sfcu_expr_struct_type(base, param_names, param_types, table)
                    Expr.Paren(inner, paren_line):
                        return sfcu_expr_struct_type(inner, param_names, param_types, table)
                    _:
                        pass
                inferred: InferType = infer_expression_type(expression, param_names, param_types, table)
                return inferred.name if inferred.kind == SemTypeKind.Named
                return ""

        def sfcu_push_pattern_bindings(pattern: Ast::Pattern, param_names: mutable darray[sview]&, param_types: mutable darray[sview]&, param_refined: mutable darray[bool]&, established: mutable darray[Ast::Expr]&) -> void:
            can Memory.Allocate, Abort.Panic:
                names: mutable darray[sview] = []
                collect_pattern_binding_names(pattern, names)
                for name in names |param_names, param_types, param_refined, established|:
                    sfcu_drop_facts_for_name(name, established)
                    param_names.push(name)
                    param_types.push("")
                    param_refined.push(false)

        def sfcu_walk_expr(expression: Ast::Expr, struct_names: darray[sview]&, field_names: darray[sview]&, field_lo: darray[i64]&, field_hi: darray[i64]&, param_names: mutable darray[sview]&, param_types: mutable darray[sview]&, param_refined: mutable darray[bool]&, established: mutable darray[Ast::Expr]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Construct(type_expression, fields, construct_line):
                        struct_name: sview = bare_type_name(type_expression)
                        for field_init in fields |table, param_names, param_types, param_refined, established| -> table:
                            window: (lo: i64, hi: i64) = sfcu_field_window(struct_name, field_init.name, struct_names, field_names, field_lo, field_hi)
                            # An established fact (a preceding `assert`/`requires`) that pins the
                            # supplied value into the field's where-window discharges the obligation.
                            proven_by_fact: bool = sfcu_value_within_window(field_init.value, window.lo, window.hi, established)
                            fire: bool = sfcu_field_refined(struct_name, field_init.name, struct_names, field_names) and sfcu_value_unprovable(field_init.value, param_names, param_refined) and not proven_by_fact
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.StructFieldRefinementUnproven, name: field_init.name, pos: construct_line, line: construct_line.line, expected: struct_name, actual: ""}) if fire
                            sfcu_check_zeroed_struct(field_type_of(table, struct_name, field_init.name), construct_line, struct_names, field_names, field_lo, field_hi, table, 0) if sfcu_is_zeroed(field_init.value)
                            table <- sfcu_walk_expr(field_init.value, struct_names, field_names, field_lo, field_hi, param_names, param_types, param_refined, established, table)
                    Expr.RecordUpdate(base, fields, update_line):
                        struct_name: sview = sfcu_expr_struct_type(base, param_names, param_types, table)
                        table <- sfcu_walk_expr(base, struct_names, field_names, field_lo, field_hi, param_names, param_types, param_refined, established, table)
                        for field_init in fields |table, param_names, param_types, param_refined, established| -> table:
                            window: (lo: i64, hi: i64) = sfcu_field_window(struct_name, field_init.name, struct_names, field_names, field_lo, field_hi)
                            proven_by_fact: bool = sfcu_value_within_window(field_init.value, window.lo, window.hi, established)
                            fire: bool = struct_name != "" and sfcu_field_refined(struct_name, field_init.name, struct_names, field_names) and sfcu_value_unprovable(field_init.value, param_names, param_refined) and not proven_by_fact
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.StructFieldRefinementUnproven, name: field_init.name, pos: update_line, line: update_line.line, expected: struct_name, actual: ""}) if fire
                            sfcu_check_zeroed_struct(field_type_of(table, struct_name, field_init.name), update_line, struct_names, field_names, field_lo, field_hi, table, 0) if sfcu_is_zeroed(field_init.value)
                            table <- sfcu_walk_expr(field_init.value, struct_names, field_names, field_lo, field_hi, param_names, param_types, param_refined, established, table)
                    Expr.StaticEffectCall(effect_type, operation, candidates, arguments, argument_names, call_line):
                        table <- sfcu_walk_expr(effect_type, struct_names, field_names, field_lo, field_hi, param_names, param_types, param_refined, established, table)
                        for candidate in candidates |table, param_names, param_types, param_refined, established| -> table:
                            table <- sfcu_walk_expr(candidate.effect_type, struct_names, field_names, field_lo, field_hi, param_names, param_types, param_refined, established, table)
                            for capture in candidate.captures |table, param_names, param_types, param_refined, established| -> table:
                                table <- sfcu_walk_expr(capture, struct_names, field_names, field_lo, field_hi, param_names, param_types, param_refined, established, table)
                        for argument in arguments |table, param_names, param_types, param_refined, established| -> table:
                            table <- sfcu_walk_expr(argument, struct_names, field_names, field_lo, field_hi, param_names, param_types, param_refined, established, table)
                        established.truncate(0)
                    # Capture-header loops are parsed as `Stmt.Expr(Expr.Block([decls…, loop], …))`.
                    # Visit both the block's statements and value so the ordinary statement
                    # visitor sees the actual loop binders and their lexical shadowing.
                    Expr.Block(block_statements, block_value, block_captures, block_line):
                        name_mark: usize = param_names.count
                        type_mark: usize = param_types.count
                        refined_mark: usize = param_refined.count
                        block_established: mutable darray[Ast::Expr] = [p6 for p6 in established]
                        table <- sfcu_walk_stmts(block_statements, struct_names, field_names, field_lo, field_hi, param_names, param_types, param_refined, block_established, table, true)
                        table <- sfcu_walk_expr(block_value, struct_names, field_names, field_lo, field_hi, param_names, param_types, param_refined, block_established, table)
                        param_names.truncate(name_mark)
                        param_types.truncate(type_mark)
                        param_refined.truncate(refined_mark)
                        established.truncate(0)
                    Expr.Binary(left, operator, right, binary_line):
                        table <- sfcu_walk_expr(left, struct_names, field_names, field_lo, field_hi, param_names, param_types, param_refined, established, table)
                        table <- sfcu_walk_expr(right, struct_names, field_names, field_lo, field_hi, param_names, param_types, param_refined, established, table)
                    Expr.Unary(operator, operand, unary_line) | Expr.Move(operand, unary_line) | Expr.RegionNew(operand, _, unary_line):
                        table <- sfcu_walk_expr(operand, struct_names, field_names, field_lo, field_hi, param_names, param_types, param_refined, established, table)
                    Expr.Refinement(base, predicate, refinement_line):
                        table <- sfcu_walk_expr(base, struct_names, field_names, field_lo, field_hi, param_names, param_types, param_refined, established, table)
                        table <- sfcu_walk_expr(predicate, struct_names, field_names, field_lo, field_hi, param_names, param_types, param_refined, established, table)
                    Expr.Paren(inner, paren_line):
                        table <- sfcu_walk_expr(inner, struct_names, field_names, field_lo, field_hi, param_names, param_types, param_refined, established, table)
                    Expr.Field(object, field, field_line) | Expr.Scope(object, field, field_line):
                        table <- sfcu_walk_expr(object, struct_names, field_names, field_lo, field_hi, param_names, param_types, param_refined, established, table)
                    Expr.Index(object, index, index_line):
                        table <- sfcu_walk_expr(object, struct_names, field_names, field_lo, field_hi, param_names, param_types, param_refined, established, table)
                        table <- sfcu_walk_expr(index, struct_names, field_names, field_lo, field_hi, param_names, param_types, param_refined, established, table)
                    Expr.Slice(object, low, high, slice_line):
                        table <- sfcu_walk_expr(object, struct_names, field_names, field_lo, field_hi, param_names, param_types, param_refined, established, table)
                        table <- sfcu_walk_expr(low, struct_names, field_names, field_lo, field_hi, param_names, param_types, param_refined, established, table)
                        table <- sfcu_walk_expr(high, struct_names, field_names, field_lo, field_hi, param_names, param_types, param_refined, established, table)
                    Expr.IndexN(object, arguments, index_n_line):
                        table <- sfcu_walk_expr(object, struct_names, field_names, field_lo, field_hi, param_names, param_types, param_refined, established, table)
                        for argument in arguments |table, param_names, param_types, param_refined, established| -> table:
                            table <- sfcu_walk_expr(argument, struct_names, field_names, field_lo, field_hi, param_names, param_types, param_refined, established, table)
                    Expr.Array(elements, array_line) | Expr.Tuple(elements, array_line) | Expr.SetLit(elements, array_line):
                        for element in elements |table, param_names, param_types, param_refined, established| -> table:
                            table <- sfcu_walk_expr(element, struct_names, field_names, field_lo, field_hi, param_names, param_types, param_refined, established, table)
                    Expr.DictLit(entries, dict_line):
                        for entry in entries |table, param_names, param_types, param_refined, established| -> table:
                            table <- sfcu_walk_expr(entry.key, struct_names, field_names, field_lo, field_hi, param_names, param_types, param_refined, established, table)
                            table <- sfcu_walk_expr(entry.value, struct_names, field_names, field_lo, field_hi, param_names, param_types, param_refined, established, table)
                    Expr.If(condition, then_expr, else_expr, if_expr_line):
                        table <- sfcu_walk_expr(condition, struct_names, field_names, field_lo, field_hi, param_names, param_types, param_refined, established, table)
                        then_established: mutable darray[Ast::Expr] = [p8 for p8 in established]
                        else_established: mutable darray[Ast::Expr] = [p9 for p9 in established]
                        table <- sfcu_walk_expr(then_expr, struct_names, field_names, field_lo, field_hi, param_names, param_types, param_refined, then_established, table)
                        table <- sfcu_walk_expr(else_expr, struct_names, field_names, field_lo, field_hi, param_names, param_types, param_refined, else_established, table)
                        established.truncate(0)
                    Expr.Comprehension(variable, iterable, condition, body, comprehension_line):
                        table <- sfcu_walk_expr(iterable, struct_names, field_names, field_lo, field_hi, param_names, param_types, param_refined, established, table)
                        name_mark: usize = param_names.count
                        type_mark: usize = param_types.count
                        refined_mark: usize = param_refined.count
                        param_names.push(variable)
                        param_types.push("")
                        param_refined.push(false)
                        comprehension_established: mutable darray[Ast::Expr] = [p10 for p10 in established]
                        sfcu_drop_facts_for_name(variable, comprehension_established)
                        table <- sfcu_walk_expr(condition, struct_names, field_names, field_lo, field_hi, param_names, param_types, param_refined, comprehension_established, table)
                        table <- sfcu_walk_expr(body, struct_names, field_names, field_lo, field_hi, param_names, param_types, param_refined, comprehension_established, table)
                        param_names.truncate(name_mark)
                        param_types.truncate(type_mark)
                        param_refined.truncate(refined_mark)
                        established.truncate(0)
                    Expr.Match(scrutinee, arms, match_line) | Expr.Catch(scrutinee, arms, match_line):
                        table <- sfcu_walk_expr(scrutinee, struct_names, field_names, field_lo, field_hi, param_names, param_types, param_refined, established, table)
                        for arm in arms |table, param_names, param_types, param_refined, established| -> table:
                            name_mark: usize = param_names.count
                            type_mark: usize = param_types.count
                            refined_mark: usize = param_refined.count
                            arm_established: mutable darray[Ast::Expr] = [p11 for p11 in established]
                            sfcu_push_pattern_bindings(arm.pattern, param_names, param_types, param_refined, arm_established)
                            table <- sfcu_walk_expr(arm.guard, struct_names, field_names, field_lo, field_hi, param_names, param_types, param_refined, arm_established, table)
                            table <- sfcu_walk_stmts(arm.body, struct_names, field_names, field_lo, field_hi, param_names, param_types, param_refined, arm_established, table, false)
                            param_names.truncate(name_mark)
                            param_types.truncate(type_mark)
                            param_refined.truncate(refined_mark)
                        established.truncate(0)
                    Expr.GetElse(guarded, recovery, get_else_line):
                        table <- sfcu_walk_expr(guarded, struct_names, field_names, field_lo, field_hi, param_names, param_types, param_refined, established, table)
                        recovery_established: mutable darray[Ast::Expr] = [p12 for p12 in established]
                        table <- sfcu_walk_stmts(recovery, struct_names, field_names, field_lo, field_hi, param_names, param_types, param_refined, recovery_established, table, false)
                        established.truncate(0)
                    Expr.Call(callee, arguments, argument_names, call_line):
                        table <- sfcu_walk_expr(callee, struct_names, field_names, field_lo, field_hi, param_names, param_types, param_refined, established, table)
                        for argument in arguments |table, param_names, param_types, param_refined, established| -> table:
                            table <- sfcu_walk_expr(argument, struct_names, field_names, field_lo, field_hi, param_names, param_types, param_refined, established, table)
                        # An arbitrary call may mutate a value through an alias, invalidating
                        # assertions about field paths and references.
                        established.truncate(0)
                    Expr.Lambda(parameters, body, lambda_line):
                        name_mark: usize = param_names.count
                        type_mark: usize = param_types.count
                        refined_mark: usize = param_refined.count
                        for parameter in parameters |param_names, param_types, param_refined|:
                            param_names.push(parameter)
                            param_types.push("")
                            param_refined.push(false)
                        # A closure may run after any captured binding has changed. Outer
                        # assertions therefore do not cross the closure boundary.
                        lambda_established: mutable darray[Ast::Expr] = []
                        table <- sfcu_walk_stmts(body, struct_names, field_names, field_lo, field_hi, param_names, param_types, param_refined, lambda_established, table, false)
                        param_names.truncate(name_mark)
                        param_types.truncate(type_mark)
                        param_refined.truncate(refined_mark)
                        established.truncate(0)
                    _:
                        pass

        # The parameter's bare struct type name (`p: mutable Pos` -> "Pos"), or "".
        def sfcu_param_type(name: sview, param_names: darray[sview]&, param_types: darray[sview]&) -> sview:
            can Abort.Panic:
                index: mutable usize = 0
                result: mutable sview = ""
                while index < param_names.count |index, result, name, param_names, param_types|:
                    result <- param_types[index] if param_names[index] == name
                    index <- index + 1
                return result

        # The (object ident, field) of a `p.x` store target, else ("", "").
        def sfcu_store_field(target: Ast::Expr) -> sview:
            can Memory.Allocate, Abort.Panic:
                match target:
                    Expr.Field(object, field, field_line):
                        return field
                    _:
                        return sview("", 0, 0)

        def sfcu_store_struct(target: Ast::Expr, param_names: darray[sview]&, param_types: darray[sview]&, table: SymbolTable&) -> sview:
            can Memory.Allocate, Abort.Panic:
                match target:
                    Expr.Field(object, field, field_line):
                        return sfcu_expr_struct_type(object, param_names, param_types, table)
                    _:
                        return ""

        def sfcu_zeroed_target_type(target: Ast::Expr, param_names: darray[sview]&, param_types: darray[sview]&, table: SymbolTable&) -> sview:
            can Memory.Allocate, Abort.Panic:
                match target:
                    Expr.Ident(name, ident_line):
                        return sfcu_param_type(name, param_names, param_types)
                    Expr.Field(object, field, field_line):
                        owner: sview = sfcu_expr_struct_type(object, param_names, param_types, table)
                        return field_type_of(table, owner, field)
                    Expr.Paren(inner, paren_line):
                        return sfcu_zeroed_target_type(inner, param_names, param_types, table)
                    _:
                        return ""

        def sfcu_push_assignment_bindings(target: Ast::Expr, value: Ast::Expr, param_names: mutable darray[sview]&, param_types: mutable darray[sview]&, param_refined: mutable darray[bool]&, established: mutable darray[Ast::Expr]&, table: SymbolTable&) -> void:
            can Memory.Allocate, Abort.Panic:
                match target:
                    Expr.Ident(name, ident_line):
                        sfcu_drop_facts_for_name(name, established)
                        inferred_struct: sview = sfcu_expr_struct_type(value, param_names, param_types, table)
                        param_names.push(name)
                        param_types.push(inferred_struct)
                        param_refined.push(false)
                    Expr.Paren(inner, paren_line):
                        sfcu_push_assignment_bindings(inner, value, param_names, param_types, param_refined, established, table)
                    Expr.Tuple(elements, tuple_line) | Expr.Array(elements, tuple_line):
                        for element in elements |param_names, param_types, param_refined, established, table|:
                            sfcu_push_assignment_bindings(element, value, param_names, param_types, param_refined, established, table)
                    _:
                        pass

        def sfcu_walk_stmts(statements: darray[Ast::Stmt], struct_names: darray[sview]&, field_names: darray[sview]&, field_lo: darray[i64]&, field_hi: darray[i64]&, param_names: mutable darray[sview]&, param_types: mutable darray[sview]&, param_refined: mutable darray[bool]&, established: mutable darray[Ast::Expr]&, table: lmut SymbolTable, preserve_bindings: bool) -> void:
            can Memory.Allocate, Abort.Panic:
                name_mark: usize = param_names.count
                type_mark: usize = param_types.count
                refined_mark: usize = param_refined.count
                for statement in statements |established, table, param_names, param_types, param_refined| -> table:
                    match statement:
                        # Only runtime assertions and preconditions establish facts. Walk their
                        # expressions first so nested operations still receive the same checks.
                        Stmt.Contract(contract_kind, contract_expression, contract_line):
                            table <- sfcu_walk_expr(contract_expression, struct_names, field_names, field_lo, field_hi, param_names, param_types, param_refined, established, table)
                            established.push(contract_expression) if contract_kind == "assert" or contract_kind == "requires"
                        Stmt.Expr(expression, expr_line):
                            table <- sfcu_walk_expr(expression, struct_names, field_names, field_lo, field_hi, param_names, param_types, param_refined, established, table)
                        Stmt.VarDecl(name, type_expression, value, decl_line):
                            table <- sfcu_walk_expr(value, struct_names, field_names, field_lo, field_hi, param_names, param_types, param_refined, established, table)
                            sfcu_check_zeroed_struct(bare_type_name_through_ref(type_expression), decl_line, struct_names, field_names, field_lo, field_hi, table, 0) if sfcu_is_zeroed(value)
                            # A local shadows parameters from its declaration onward. Its
                            # refinement is deliberately not assumed here: its initializer
                            # must be proved before that fact can safely flow onward.
                            sfcu_drop_facts_for_name(name, established)
                            param_names.push(name)
                            param_types.push(bare_type_name_through_ref(type_expression))
                            param_refined.push(false)
                        Stmt.Assign(target, operator, value, assign_line):
                            # A field STORE `p.x <- v` where p's struct field x is where-refined
                            # and v cannot establish it — same unprovable rule as construction.
                            table <- sfcu_walk_expr(target, struct_names, field_names, field_lo, field_hi, param_names, param_types, param_refined, established, table)
                            store_field: sview = sfcu_store_field(target)
                            store_struct: sview = sfcu_store_struct(target, param_names, param_types, table)
                            store_window: (lo: i64, hi: i64) = sfcu_field_window(store_struct, store_field, struct_names, field_names, field_lo, field_hi)
                            store_proven: bool = sfcu_value_within_window(value, store_window.lo, store_window.hi, established)
                            store_refined: bool = store_struct != "" and sfcu_field_refined(store_struct, store_field, struct_names, field_names)
                            compound_mutation: bool = operator == TokenKind.PlusEq or operator == TokenKind.MinusEq or operator == TokenKind.StarEq or operator == TokenKind.SlashEq or operator == TokenKind.PercentEq or operator == TokenKind.LShiftEq or operator == TokenKind.RShiftEq or operator == TokenKind.AmpEq or operator == TokenKind.PipeEq or operator == TokenKind.CaretEq
                            store_fire: bool = store_refined and ((operator == TokenKind.LArrow and sfcu_value_unprovable(value, param_names, param_refined) and not store_proven) or compound_mutation)
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.StructFieldRefinementUnproven, name: store_field, line: assign_line.line, expected: store_struct, actual: ""}) if store_fire
                            zeroed_target_struct: sview = sfcu_zeroed_target_type(target, param_names, param_types, table)
                            sfcu_check_zeroed_struct(zeroed_target_struct, assign_line, struct_names, field_names, field_lo, field_hi, table, 0) if sfcu_is_zeroed(value)
                            table <- sfcu_walk_expr(value, struct_names, field_names, field_lo, field_hi, param_names, param_types, param_refined, established, table)
                            # Without alias-aware places/loans, every write can invalidate any
                            # asserted subject (including through another reference), so no
                            # interval fact survives a mutation.
                            established.truncate(0)
                            sfcu_push_assignment_bindings(target, value, param_names, param_types, param_refined, established, table) if operator == TokenKind.Assign
                        Stmt.Return(value, return_line):
                            if value is returned_value:
                                table <- sfcu_walk_expr(returned_value, struct_names, field_names, field_lo, field_hi, param_names, param_types, param_refined, established, table)
                        Stmt.If(condition, then_body, else_body, if_line):
                            table <- sfcu_walk_expr(condition, struct_names, field_names, field_lo, field_hi, param_names, param_types, param_refined, established, table)
                            then_established: mutable darray[Ast::Expr] = [p for p in established]
                            else_established: mutable darray[Ast::Expr] = [p2 for p2 in established]
                            table <- sfcu_walk_stmts(then_body, struct_names, field_names, field_lo, field_hi, param_names, param_types, param_refined, then_established, table, false)
                            table <- sfcu_walk_stmts(else_body, struct_names, field_names, field_lo, field_hi, param_names, param_types, param_refined, else_established, table, false)
                            # Either branch may mutate an aliased subject. Until we merge a
                            # binding-aware CFG fact set, no pre-branch assertion survives.
                            established.truncate(0)
                        Stmt.While(while_condition, while_body, while_line):
                            table <- sfcu_walk_expr(while_condition, struct_names, field_names, field_lo, field_hi, param_names, param_types, param_refined, established, table)
                            while_established: mutable darray[Ast::Expr] = [p3 for p3 in established]
                            table <- sfcu_walk_stmts(while_body, struct_names, field_names, field_lo, field_hi, param_names, param_types, param_refined, while_established, table, false)
                            established.truncate(0)
                        Stmt.For(bind, variables, iterable, for_body, for_line):
                            # A for-loop variable is a fresh, unrefined binding, even when
                            # it reuses the name of a refined function parameter. `bind`
                            # records iteration mode (for example `mutable`), not a name;
                            # `variables` contains the loop's actual lexical binders.
                            table <- sfcu_walk_expr(iterable, struct_names, field_names, field_lo, field_hi, param_names, param_types, param_refined, established, table)
                            name_mark: usize = param_names.count
                            type_mark: usize = param_types.count
                            refined_mark: usize = param_refined.count
                            for variable in variables |param_names, param_types, param_refined|:
                                param_names.push(variable)
                                param_types.push("")
                                param_refined.push(false)
                            for_established: mutable darray[Ast::Expr] = [p4 for p4 in established]
                            for variable in variables |for_established|:
                                sfcu_drop_facts_for_name(variable, for_established)
                            table <- sfcu_walk_stmts(for_body, struct_names, field_names, field_lo, field_hi, param_names, param_types, param_refined, for_established, table, false)
                            param_names.truncate(name_mark)
                            param_types.truncate(type_mark)
                            param_refined.truncate(refined_mark)
                            established.truncate(0)
                        Stmt.Block(kind, clause, binding, block_body, block_line):
                            name_mark: usize = param_names.count
                            type_mark: usize = param_types.count
                            refined_mark: usize = param_refined.count
                            block_established: mutable darray[Ast::Expr] = [p5 for p5 in established]
                            if binding != "":
                                param_names.push(binding)
                                param_types.push("")
                                param_refined.push(false)
                                sfcu_drop_facts_for_name(binding, block_established)
                            table <- sfcu_walk_stmts(block_body, struct_names, field_names, field_lo, field_hi, param_names, param_types, param_refined, block_established, table, false)
                            param_names.truncate(name_mark)
                            param_types.truncate(type_mark)
                            param_refined.truncate(refined_mark)
                            established.truncate(0)
                        Stmt.Match(scrutinee, arms, match_line):
                            table <- sfcu_walk_expr(scrutinee, struct_names, field_names, field_lo, field_hi, param_names, param_types, param_refined, established, table)
                            for arm in arms |table, param_names, param_types, param_refined, established| -> table:
                                name_mark: usize = param_names.count
                                type_mark: usize = param_types.count
                                refined_mark: usize = param_refined.count
                                arm_established: mutable darray[Ast::Expr] = [p13 for p13 in established]
                                sfcu_push_pattern_bindings(arm.pattern, param_names, param_types, param_refined, arm_established)
                                table <- sfcu_walk_expr(arm.guard, struct_names, field_names, field_lo, field_hi, param_names, param_types, param_refined, arm_established, table)
                                table <- sfcu_walk_stmts(arm.body, struct_names, field_names, field_lo, field_hi, param_names, param_types, param_refined, arm_established, table, false)
                                param_names.truncate(name_mark)
                                param_types.truncate(type_mark)
                                param_refined.truncate(refined_mark)
                            established.truncate(0)
                        _:
                            pass
                if not preserve_bindings:
                    param_names.truncate(name_mark)
                    param_types.truncate(type_mark)
                    param_refined.truncate(refined_mark)

        def sfcu_param_name(parameter: Ast::ParamDecl) -> sview:
            can Abort.Panic:
                return parameter.name

        def sfcu_walk_decls(declarations: darray[Ast::Decl], struct_names: darray[sview]&, field_names: darray[sview]&, field_lo: darray[i64]&, field_hi: darray[i64]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, func_line):
                            param_names: mutable darray[sview] = []
                            param_types: mutable darray[sview] = []
                            param_refined: mutable darray[bool] = []
                            for parameter in parameters |param_names, param_types, param_refined|:
                                param_names.push(sfcu_param_name(parameter))
                                param_types.push(bare_type_name_through_ref(parameter.type_expression))
                                param_refined.push(sfcu_param_is_refined(parameter.type_expression))
                            established: mutable darray[Ast::Expr] = []
                            for parameter in parameters |established|:
                                predicate: Ast::Expr = where_predicate_of_type(parameter.type_expression)
                                match predicate:
                                    Expr.Absent:
                                        pass
                                    _:
                                        established.push(predicate)
                            table <- sfcu_walk_stmts(body, struct_names, field_names, field_lo, field_hi, param_names, param_types, param_refined, established, table, false)
                        Decl.Const(const_name, type_expression, value, is_mutable, const_line):
                            sfcu_check_zeroed_struct(bare_type_name_through_ref(type_expression), const_line, struct_names, field_names, field_lo, field_hi, table, 0) if sfcu_is_zeroed(value)
                            const_names: mutable darray[sview] = []
                            const_types: mutable darray[sview] = []
                            const_refined: mutable darray[bool] = []
                            const_established: mutable darray[Ast::Expr] = []
                            table <- sfcu_walk_expr(value, struct_names, field_names, field_lo, field_hi, const_names, const_types, const_refined, const_established, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- sfcu_walk_decls(module_body, struct_names, field_names, field_lo, field_hi, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- sfcu_walk_decls(scoped_body, struct_names, field_names, field_lo, field_hi, table)
                        _:
                            pass

        def check_struct_field_construct_unproven(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                struct_names: mutable darray[sview] = []
                field_names: mutable darray[sview] = []
                field_lo: mutable darray[i64] = []
                field_hi: mutable darray[i64] = []
                sfcu_collect_refined_fields(declarations, struct_names, field_names, field_lo, field_hi)
                return if struct_names.count == 0
                table <- sfcu_walk_decls(declarations, struct_names, field_names, field_lo, field_hi, table)
