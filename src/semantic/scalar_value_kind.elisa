# Closed source-level set of scalar value kinds used by container assignment and returns.
module ScalarValueKind:
    public:
        def is_scalar_value_kind(kind: sview) -> bool:
            ensure when kind:
                "int" | "float" | "bool" | "char" | "string" -> result == (true)
                _ -> result == (false)
            can Abort.Panic:
                return when kind:
                    "int" | "float" | "bool" | "char" | "string" -> true
                    _ -> false
