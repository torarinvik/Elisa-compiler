# Check for redundant arithmetic: operations with literal operands that are no-ops or constants.

extend Semantic:
    private:
        # Walk through all expressions, checking for Binary operations with redundant literal operands.
        def walk_expression_for_redundant_arithmetic(expression: Ast::Expr, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Binary(left, operator, right, line):
                        # Check for redundant arithmetic: only right operand (literal forms like x * 1).
                        # Each `is`-binding is used only inside a nested body — stage1's
                        # resolver does not carry an `is`-binding into the rest of the SAME
                        # boolean condition, so `right is IntLit(v) and v == 1` would leave
                        # `v` unresolved. Nest instead.
                        if operator == TokenKind.Star:
                            if right is Expr.IntLit(value):
                                if value == 1 or value == 0:
                                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.RedundantArithmetic, name: "", line: line, expected: "", actual: ""})
                        elif operator == TokenKind.Slash:
                            if right is Expr.IntLit(value):
                                if value == 1:
                                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.RedundantArithmetic, name: "", line: line, expected: "", actual: ""})
                        elif operator == TokenKind.Percent:
                            if right is Expr.IntLit(value):
                                if value == 1:
                                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.RedundantArithmetic, name: "", line: line, expected: "", actual: ""})
                        elif operator == TokenKind.Plus:
                            if right is Expr.IntLit(value):
                                if value == 0:
                                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.RedundantArithmetic, name: "", line: line, expected: "", actual: ""})
                        elif operator == TokenKind.Minus:
                            if right is Expr.IntLit(value):
                                if value == 0:
                                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.RedundantArithmetic, name: "", line: line, expected: "", actual: ""})
                        # Recursively walk left and right operands
                        table <- walk_expression_for_redundant_arithmetic(left, table)
                        if operator != TokenKind.Is and operator != TokenKind.As:
                            table <- walk_expression_for_redundant_arithmetic(right, table)
                    Expr.Call(callee, arguments, argument_names, line):
                        table <- walk_expression_for_redundant_arithmetic(callee, table)
                        for argument in arguments |table| -> table:
                            table <- walk_expression_for_redundant_arithmetic(argument, table)
                    Expr.Field(object, field, line):
                        table <- walk_expression_for_redundant_arithmetic(object, table)
                    Expr.Scope(base, name, line):
                        table <- walk_expression_for_redundant_arithmetic(base, table)
                    Expr.Index(object, index, line):
                        table <- walk_expression_for_redundant_arithmetic(object, table)
                        if not index_receiver_is_type_application(object):
                            table <- walk_expression_for_redundant_arithmetic(index, table)
                    Expr.Unary(operator, operand, line):
                        table <- walk_expression_for_redundant_arithmetic(operand, table)
                    Expr.Paren(inner, line):
                        table <- walk_expression_for_redundant_arithmetic(inner, table)
                    Expr.Array(elements, line):
                        for element in elements |table| -> table:
                            table <- walk_expression_for_redundant_arithmetic(element, table)
                    Expr.Tuple(elements, line):
                        for element in elements |table| -> table:
                            table <- walk_expression_for_redundant_arithmetic(element, table)
                    Expr.Slice(object, low, high, line):
                        table <- walk_expression_for_redundant_arithmetic(object, table)
                        table <- walk_expression_for_redundant_arithmetic(low, table)
                        table <- walk_expression_for_redundant_arithmetic(high, table)
                    Expr.IndexN(object, arguments, line):
                        table <- walk_expression_for_redundant_arithmetic(object, table)
                        if not index_receiver_is_type_application(object):
                            for argument in arguments |table| -> table:
                                table <- walk_expression_for_redundant_arithmetic(argument, table)
                    Expr.SetLit(elements, line):
                        for element in elements |table| -> table:
                            table <- walk_expression_for_redundant_arithmetic(element, table)
                    Expr.DictLit(entries, line):
                        for entry in entries |table| -> table:
                            table <- walk_expression_for_redundant_arithmetic(entry.key, table)
                            table <- walk_expression_for_redundant_arithmetic(entry.value, table)
                    Expr.Construct(type_expression, fields, line):
                        table <- walk_expression_for_redundant_arithmetic(type_expression, table)
                        for field in fields |table| -> table:
                            table <- walk_expression_for_redundant_arithmetic(field.value, table)
                    Expr.RecordUpdate(base, fields, line):
                        table <- walk_expression_for_redundant_arithmetic(base, table)
                        for field in fields |table| -> table:
                            table <- walk_expression_for_redundant_arithmetic(field.value, table)
                    Expr.If(condition, then_expr, else_expr, line):
                        table <- walk_expression_for_redundant_arithmetic(condition, table)
                        table <- walk_expression_for_redundant_arithmetic(then_expr, table)
                        table <- walk_expression_for_redundant_arithmetic(else_expr, table)
                    Expr.Comprehension(loop_variable, iterable, condition, body, line):
                        table <- walk_expression_for_redundant_arithmetic(iterable, table)
                        table <- walk_expression_for_redundant_arithmetic(condition, table)
                        table <- walk_expression_for_redundant_arithmetic(body, table)
                    Expr.Lambda(parameters, body, line):
                        table <- walk_statements_for_redundant_arithmetic(body, table)
                    Expr.Block(statements, value, captures, line):
                        table <- walk_statements_for_redundant_arithmetic(statements, table)
                        table <- walk_expression_for_redundant_arithmetic(value, table)
                    Expr.Match(scrutinee, arms, line):
                        table <- walk_expression_for_redundant_arithmetic(scrutinee, table)
                        for arm in arms |table| -> table:
                            table <- walk_statements_for_redundant_arithmetic(arm.body, table)
                    # Literals and other expression forms don't contain sub-expressions
                    _:
                        pass


        # Walk through statements, checking for redundant arithmetic in expressions.
        def walk_statements_for_redundant_arithmetic(statements: darray[Ast::Stmt], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table|:
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- walk_expression_for_redundant_arithmetic(expression, table)
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- walk_expression_for_redundant_arithmetic(value, table)
                        Stmt.Assign(target, operator, value, line):
                            table <- walk_expression_for_redundant_arithmetic(target, table)
                            table <- walk_expression_for_redundant_arithmetic(value, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- walk_expression_for_redundant_arithmetic(condition, table)
                            table <- walk_statements_for_redundant_arithmetic(then_body, table)
                            table <- walk_statements_for_redundant_arithmetic(else_body, table)
                        Stmt.While(condition, body, line):
                            table <- walk_expression_for_redundant_arithmetic(condition, table)
                            table <- walk_statements_for_redundant_arithmetic(body, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- walk_expression_for_redundant_arithmetic(iterable, table)
                            table <- walk_statements_for_redundant_arithmetic(body, table)
                        Stmt.Return(value, line):
                            if value is return_value:
                                table <- walk_expression_for_redundant_arithmetic(return_value, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- walk_statements_for_redundant_arithmetic(body, table)
                        Stmt.Match(scrutinee, arms, line):
                            table <- walk_expression_for_redundant_arithmetic(scrutinee, table)
                            for arm in arms |table|:
                                table <- walk_statements_for_redundant_arithmetic(arm.body, table)
                        Stmt.Contract(kind, expression, line):
                            table <- walk_expression_for_redundant_arithmetic(expression, table)
                        # No expressions in these statements
                        Stmt.Break(label, line):
                            pass
                        Stmt.Continue(label, line):
                            pass
                        Stmt.Invalid:
                            pass


        # Walk through function declarations, checking expressions in their bodies.
        def check_redundant_arithmetic(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table|:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            table <- walk_statements_for_redundant_arithmetic(body, table)
                        Decl.Module(module_name, body, line):
                            table <- check_redundant_arithmetic(body, table)
                        Decl.Scoped(body, line):
                            table <- check_redundant_arithmetic(body, table)
                        # Other declarations don't have bodies to check
                        _:
                            pass
