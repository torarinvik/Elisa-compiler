# Exact effect rows indexed by canonical declaration slots. Ref spellings are
# interned once; function rows and recursive graph propagation use numeric links.
extend Semantic:
    private:
        # Bodiless protocol methods have authentic scoped contracts but no Func
        # declaration. Keep their authority separate from ordinary overload names.
        def ga_protocol_contracts(state: mutable GlobalAuthority&) -> void:
            can Memory.Allocate, Abort.Panic:
                annotation_count: usize = state.annotations.count
                for member_index in 0..<annotation_count |state|:
                    member: Ast::EnumAnnotation = state.annotations[member_index]
                    continue if member.owner != "__protocol_method_scope"
                    contract_scope: usize = ga_module_text(member.module, state)
                    is_cast: mutable bool = false
                    for name in state.annotations |is_cast|:
                        is_cast <- true if name.line == 3900000060 and name.name == "__cast__" and name.offset == member.offset and ga_module_text(name.module, state) == contract_scope and name.owner == member.name
                    continue if not is_cast
                    slot: usize = state.functions.count
                    state.function_next.push(GLOBAL_AUTHORITY_NONE)
                    state.functions.push("")
                    state.effect_row_heads.push(GLOBAL_AUTHORITY_NONE)
                    state.function_scopes.push(contract_scope)
                    state.function_offsets.push(member.offset)
                    state.function_lines.push(member.line)
                    state.function_variadic.push(true)
                    state.function_return_types.push(null)
                    state.parameter_starts.push(state.parameter_types.count)
                    state.parameter_counts.push(0)
                    state.parameter_minimum.push(0)
                    state.reads.push(false)
                    state.writes.push(false)
                    state.protocol_contract_slots.push(slot)
                    state.protocol_contract_offsets.push(member.offset)
                    state.protocol_contract_scopes.push(contract_scope)
                    for effect_index in 0..<annotation_count |state|:
                        contract_effect: Ast::EnumAnnotation = state.annotations[effect_index]
                        continue if contract_effect.line != 3900000063 or contract_effect.owner != "__cast__" or contract_effect.offset != member.offset or ga_module_text(contract_effect.module, state) != contract_scope
                        _ = ga_row_add(slot, contract_effect.name, true, state, contract_scope) can Global{Read,Write}
                        state.reads[slot] <- state.reads[slot] or ga_ref_covers(contract_effect.name, "Global.Read", contract_scope, 0, state, 0)
                        state.writes[slot] <- state.writes[slot] or ga_ref_covers(contract_effect.name, "Global.Write", contract_scope, 0, state, 0)

        def ga_ref_intern(ref: sview, state: mutable GlobalAuthority&) -> usize:
            can Memory.Allocate, Abort.Panic:
                key: u64 = name_hash(ref)
                previous: usize = head if state.effect_ref_heads.get(key) is head else GLOBAL_AUTHORITY_NONE
                probe: mutable usize = previous
                while probe < state.effect_refs.count |probe|:
                    probe return if state.effect_refs[probe] == ref
                    probe <- state.effect_ref_next[probe]
                index: usize = state.effect_refs.count
                state.effect_refs.push(ref)
                state.effect_ref_next.push(previous)
                state.effect_ref_heads <- state.effect_ref_heads.put(key, index) can Global{Read,Write}
                return index

        # Expand in the reference's declaration namespace before propagation or
        # suppression. A trusted member must remove only that member of an alias.
        def ga_row_add(function: usize, ref: sview, mandatory: bool, state: mutable GlobalAuthority&, origin_scope: usize = GLOBAL_AUTHORITY_NONE, depth: u32 = 0) -> bool:
            can Memory.Allocate, Abort.Panic:
                lexical_scope: usize = state.module_scope if origin_scope == GLOBAL_AUTHORITY_NONE else origin_scope
                alias: usize = ga_capability_slot(ref, lexical_scope, state)
                if alias < state.capability_names.count and depth < 32:
                    changed: mutable bool = false
                    for row in 0..<state.capability_names.count |changed, state|:
                        if state.capability_names[row] == state.capability_names[alias] and state.capability_scopes[row] == state.capability_scopes[alias]:
                            changed <- ga_row_add(function, state.capability_refs[row], mandatory, state, state.capability_scopes[row], depth + 1) or changed can Global{Read,Write}
                    return changed
                global_permission: usize = ga_permission_slot(ref, lexical_scope, state)
                if ref == "Global" and state.capabilities_indexed and (global_permission >= state.permission_names.count or state.permission_scopes[global_permission] == 0):
                    read_changed: bool = ga_row_add(function, "Global.Read", mandatory, state, 0, depth + 1) can Global{Read,Write}
                    write_changed: bool = ga_row_add(function, "Global.Write", mandatory, state, 0, depth + 1) can Global{Read,Write}
                    return read_changed or write_changed
                false return if ga_refs_cover(state.firewalls, state.firewall_scopes, ref, lexical_scope, state)
                return ga_row_add_leaf(function, ref, mandatory, state, lexical_scope) can Global{Read,Write}

        # Signature rows are collected before capability indexing is available.
        # Reinsert them once, preserving their origins and expanding the aliases.
        def ga_resolve_initial_rows(state: mutable GlobalAuthority&) -> void:
            can Memory.Allocate, Abort.Panic:
                previous_heads: darray[usize] = [head for head in state.effect_row_heads]
                for function in 0..<state.effect_row_heads.count |state|:
                    state.effect_row_heads[function] <- GLOBAL_AUTHORITY_NONE
                for function in 0..<previous_heads.count |state|:
                    row: mutable usize = previous_heads[function]
                    while row < state.effect_row_refs.count |row, state|:
                        next_row: usize = state.effect_row_next[row]
                        ref: sview = state.effect_refs[state.effect_row_refs[row]]
                        _ = ga_row_add(function, ref, state.effect_row_mandatory[row], state, state.effect_row_scopes[row]) can Global{Read,Write}
                        row <- next_row

        def ga_row_add_leaf(function: usize, ref: sview, mandatory: bool, state: mutable GlobalAuthority&, origin_scope: usize) -> bool:
            can Memory.Allocate, Abort.Panic:
                false return if function >= state.effect_row_heads.count or ref == ""
                lexical_scope: usize = state.module_scope if origin_scope == GLOBAL_AUTHORITY_NONE else origin_scope
                interned: usize = ga_ref_intern(ref, state) can Global{Read,Write}
                probe: mutable usize = state.effect_row_heads[function]
                while probe < state.effect_row_refs.count |probe, state|:
                    if state.effect_row_refs[probe] == interned and state.effect_row_scopes[probe] == lexical_scope:
                        changed: bool = mandatory and not state.effect_row_mandatory[probe]
                        state.effect_row_mandatory[probe] <- state.effect_row_mandatory[probe] or mandatory
                        return changed
                    probe <- state.effect_row_next[probe]
                row: usize = state.effect_row_refs.count
                state.effect_row_refs.push(interned)
                state.effect_row_mandatory.push(mandatory)
                state.effect_row_scopes.push(lexical_scope)
                state.effect_row_next.push(state.effect_row_heads[function])
                state.effect_row_heads[function] <- row
                return true

        def ga_edge_rows(caller: usize, callee: usize, state: mutable GlobalAuthority&, suppress: bool = true) -> void:
            can Memory.Allocate, Abort.Panic:
                state.row_edge_from.push(caller)
                state.row_edge_to.push(callee)
                state.row_edge_filter_starts.push(state.row_edge_filter_refs.count)
                state.row_edge_filter_counts.push(state.firewalls.count if suppress else 0)
                if suppress:
                    for index in 0..<state.firewalls.count |state|:
                        state.row_edge_filter_refs.push(ga_ref_intern(state.firewalls[index], state)) can Global{Read,Write}
                        state.row_edge_filter_scopes.push(state.firewall_scopes[index])

        def ga_edge_ref_suppressed(edge: usize, ref: sview, required_scope: usize, state: GlobalAuthority&) -> bool:
            can Memory.Allocate, Abort.Panic:
                start: usize = state.row_edge_filter_starts[edge]
                end: usize = start + state.row_edge_filter_counts[edge]
                for filter in start..<end:
                    true return if ga_ref_covers(state.effect_refs[state.row_edge_filter_refs[filter]], ref, state.row_edge_filter_scopes[filter], required_scope, state, 0)
                return false

        def ga_close_rows(state: mutable GlobalAuthority&) -> void:
            can Memory.Allocate, Abort.Panic:
                changed: mutable bool = true
                progress_rounds: mutable u64 = 0
                while changed |changed, state, progress_rounds|:
                    progress_rounds <- progress_rounds + 1 if state.progress_enabled
                    if state.progress_enabled and progress_rounds % 256 == 0:
                        PhaseTimer::counter("authority:effect_row_rounds_progress", progress_rounds) can Global{Read,Write}
                        PhaseTimer::counter("authority:effect_row_edge_visits_progress", (progress_rounds - 1) * state.row_edge_from.count.u64()) can Global{Read,Write}
                    changed <- false
                    for edge in 0..<state.row_edge_from.count |changed, state|:
                        caller: usize = state.row_edge_from[edge]
                        callee: usize = state.row_edge_to[edge]
                        continue if caller >= state.effect_row_heads.count or callee >= state.effect_row_heads.count
                        row: mutable usize = state.effect_row_heads[callee]
                        while row < state.effect_row_refs.count |row, changed, state|:
                            ref: sview = state.effect_refs[state.effect_row_refs[row]]
                            next_row: usize = state.effect_row_next[row]
                            if not ga_edge_ref_suppressed(edge, ref, state.effect_row_scopes[row], state):
                                changed <- ga_row_add(caller, ref, state.effect_row_mandatory[row], state, state.effect_row_scopes[row]) or changed can Global{Read,Write}
                            row <- next_row

        def ga_publish_rows(state: GlobalAuthority&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table.effect_canonical_module_parent <- table.effect_canonical_module_parent.clear()
                for parent in state.parents |table| -> table:
                    table.effect_canonical_module_parent <- table.effect_canonical_module_parent.push(parent)
                table.effect_canonical_module_name <- table.effect_canonical_module_name.clear()
                for module in 0..<state.modules.count |table| -> table:
                    bytes: mutable darray[u8] = []
                    for index in 0..<state.module_lengths[module] |bytes|:
                        bytes.push(sview_at(state.modules[module], state.module_starts[module] + index))
                    owned: sview = Parser::persist_name_bytes(&bytes, 0) can Global{Read,Write}
                    table.effect_canonical_module_name <- table.effect_canonical_module_name.push(owned)
                table.effect_canonical_function_name <- table.effect_canonical_function_name.clear()
                for name in state.functions |table| -> table:
                    bytes: mutable darray[u8] = []
                    for index in 0..<sview_len(name) |bytes|:
                        bytes.push(sview_at(name, index))
                    owned: sview = Parser::persist_name_bytes(&bytes, 0) can Global{Read,Write}
                    table.effect_canonical_function_name <- table.effect_canonical_function_name.push(owned)
                table.effect_canonical_function_scope <- table.effect_canonical_function_scope.clear()
                table.effect_canonical_function_offset <- table.effect_canonical_function_offset.clear()
                table.effect_canonical_offset_heads <- {}
                table.effect_canonical_offset_next <- table.effect_canonical_offset_next.clear()
                for function in 0..<state.functions.count |table| -> table:
                    table.effect_canonical_function_scope <- table.effect_canonical_function_scope.push(state.function_scopes[function])
                    table.effect_canonical_function_offset <- table.effect_canonical_function_offset.push(state.function_offsets[function])
                    previous: usize = head if table.effect_canonical_offset_heads.get(state.function_offsets[function]) is head else GLOBAL_AUTHORITY_NONE
                    table.effect_canonical_offset_next <- table.effect_canonical_offset_next.push(previous)
                    table.effect_canonical_offset_heads <- table.effect_canonical_offset_heads.put(state.function_offsets[function], function) can Global{Read,Write}
                table.effect_canonical_refs <- table.effect_canonical_refs.clear()
                for ref in state.effect_refs |table| -> table:
                    bytes: mutable darray[u8] = []
                    for index in 0..<sview_len(ref) |bytes|:
                        bytes.push(sview_at(ref, index))
                    owned: sview = Parser::persist_name_bytes(&bytes, 0) can Global{Read,Write}
                    table.effect_canonical_refs <- table.effect_canonical_refs.push(owned)
                table.effect_canonical_row_function <- table.effect_canonical_row_function.clear()
                table.effect_canonical_row_ref <- table.effect_canonical_row_ref.clear()
                table.effect_canonical_row_mandatory <- table.effect_canonical_row_mandatory.clear()
                table.effect_canonical_row_scope <- table.effect_canonical_row_scope.clear()
                table.effect_canonical_function_row_start <- table.effect_canonical_function_row_start.clear()
                table.effect_canonical_function_row_count <- table.effect_canonical_function_row_count.clear()
                for function in 0..<state.effect_row_heads.count |table| -> table:
                    start: usize = table.effect_canonical_row_function.count
                    table.effect_canonical_function_row_start <- table.effect_canonical_function_row_start.push(start)
                    row: mutable usize = state.effect_row_heads[function]
                    while row < state.effect_row_refs.count |row, table| -> table:
                        table.effect_canonical_row_function <- table.effect_canonical_row_function.push(function)
                        table.effect_canonical_row_ref <- table.effect_canonical_row_ref.push(state.effect_row_refs[row])
                        table.effect_canonical_row_mandatory <- table.effect_canonical_row_mandatory.push(state.effect_row_mandatory[row])
                        table.effect_canonical_row_scope <- table.effect_canonical_row_scope.push(state.effect_row_scopes[row])
                        row <- state.effect_row_next[row]
                    table.effect_canonical_function_row_count <- table.effect_canonical_function_row_count.push(table.effect_canonical_row_function.count - start)

        # Cache the unchanged file-wide predicate once per unique canonical effect ref.
        # state.annotations is this invocation's File annotation slice and stays immutable
        # from preparation through the report walk. The count guard detects mismatched
        # snapshots within that lifetime; it is not a checksum for same-count mutation.
        # This replaces an annotation-table scan on every call-row report while keeping
        # the old exact scanner available whenever the snapshot is incomplete or stale.
        def ga_prepare_permission_param_ref_flags(state: mutable GlobalAuthority&, table: SymbolTable&) -> void:
            can Memory.Allocate, Abort.Panic:
                state.permission_param_ref_flags_ready <- false
                state.permission_param_ref_flags <- state.permission_param_ref_flags.clear()
                state.permission_param_ref_names <- state.permission_param_ref_names.clear()
                state.permission_param_ref_lengths <- state.permission_param_ref_lengths.clear()
                state.permission_param_ref_count <- 0
                state.permission_param_annotation_count <- 0
                ref_count: usize = table.effect_canonical_refs.count
                return if state.effect_refs.count != ref_count
                for ref_index in 0..<ref_count |state|:
                    ref: sview = table.effect_canonical_refs[ref_index]
                    return if state.effect_refs[ref_index] != ref
                    family: sview = effect_ref_family(ref)
                    state.permission_param_ref_flags.push(cov_is_permission_param(state.annotations, family))
                    state.permission_param_ref_names.push(ref)
                    state.permission_param_ref_lengths.push(sview_len(ref))
                state.permission_param_ref_count <- ref_count
                state.permission_param_annotation_count <- state.annotations.count
                state.permission_param_ref_flags_ready <- state.permission_param_ref_flags.count == ref_count and state.permission_param_ref_names.count == ref_count and state.permission_param_ref_lengths.count == ref_count

        # 0/1 are valid cached false/true values; the sentinel means callers must use
        # cov_is_permission_param directly. Exact name checks prevent a same-sized ref
        # replacement from reusing another row's classification.
        def ga_permission_param_ref_cache_value(ref_index: usize, ref: sview, state: GlobalAuthority&, table: SymbolTable&) -> u8:
            can Abort.Panic:
                return GLOBAL_AUTHORITY_PERMISSION_PARAM_CACHE_MISS if not state.permission_param_ref_flags_ready
                return GLOBAL_AUTHORITY_PERMISSION_PARAM_CACHE_MISS if state.permission_param_annotation_count != state.annotations.count
                ref_count: usize = table.effect_canonical_refs.count
                return GLOBAL_AUTHORITY_PERMISSION_PARAM_CACHE_MISS if state.permission_param_ref_count != ref_count or state.permission_param_ref_flags.count != ref_count or state.permission_param_ref_names.count != ref_count or state.permission_param_ref_lengths.count != ref_count
                return GLOBAL_AUTHORITY_PERMISSION_PARAM_CACHE_MISS if state.effect_refs.count != ref_count or ref_index >= ref_count
                current: sview = table.effect_canonical_refs[ref_index]
                cached_name: sview = state.permission_param_ref_names[ref_index]
                return GLOBAL_AUTHORITY_PERMISSION_PARAM_CACHE_MISS if state.permission_param_ref_lengths[ref_index] != sview_len(current) or cached_name != current or current != ref or state.effect_refs[ref_index] != current
                return 1 if state.permission_param_ref_flags[ref_index]
                return 0

        def ga_permission_param_ref_is_param(ref_index: usize, ref: sview, state: GlobalAuthority&, table: SymbolTable&) -> bool:
            can Abort.Panic:
                cached: u8 = ga_permission_param_ref_cache_value(ref_index, ref, state, table)
                return cached == 1 if cached != GLOBAL_AUTHORITY_PERMISSION_PARAM_CACHE_MISS
                return cov_is_permission_param(state.annotations, effect_ref_family(ref))

        def canonical_effect_module(parent_scope: usize, path: sview, table: SymbolTable&) -> usize:
            can Abort.Panic:
                qualified: mutable bool = false
                for index in 0..<sview_len(path) |qualified|:
                    qualified <- true if sview_at(path, index) == 58
                parent: mutable usize = 0 if qualified else parent_scope
                start: mutable usize = 0
                while start < sview_len(path) |start, parent|:
                    end: mutable usize = start
                    while end < sview_len(path) and sview_at(path, end) != 58 |end|:
                        end <- end + 1
                    found: mutable usize = table.effect_canonical_module_name.count
                    for slot in 1..<table.effect_canonical_module_name.count |found|:
                        found <- slot if table.effect_canonical_module_parent[slot] == parent and table.effect_canonical_module_name[slot] == path[start:end]
                    parent <- found
                    start <- end + 2
                return parent

        def canonical_effect_function(name: sview, module_scope: usize, offset: u32, table: SymbolTable&) -> usize:
            can Abort.Panic:
                probe: mutable usize = head if table.effect_canonical_offset_heads.get(offset) is head else GLOBAL_AUTHORITY_NONE
                while probe < table.effect_canonical_function_name.count |probe|:
                    probe return if table.effect_canonical_function_offset[probe] == offset and table.effect_canonical_function_scope[probe] == module_scope and table.effect_canonical_function_name[probe] == name
                    probe <- table.effect_canonical_offset_next[probe]
                return GLOBAL_AUTHORITY_NONE

        def canonical_effect_context(table: SymbolTable&, state: mutable GlobalAuthority&) -> void:
            can Memory.Allocate, Abort.Panic:
                for parent in table.effect_canonical_module_parent |state|:
                    state.parents.push(parent)
                for name in table.effect_canonical_module_name |state|:
                    state.modules.push(name)
                    state.module_starts.push(0)
                    state.module_lengths.push(sview_len(name))
                for slot in 0..<table.effect_canonical_function_name.count |state|:
                    name: sview = table.effect_canonical_function_name[slot]
                    state.functions.push(name)
                    state.function_scopes.push(table.effect_canonical_function_scope[slot])
                    state.function_offsets.push(table.effect_canonical_function_offset[slot])
                    state.function_lines.push(0)
                    state.function_variadic.push(false)
                    hash: u64 = name_hash(name)
                    head: usize = present if state.function_heads.get(hash) is present else GLOBAL_AUTHORITY_NONE
                    state.function_next.push(head)
                    state.function_heads <- state.function_heads.put(hash, slot) can Global{Read,Write}
                ga_index_capabilities(state) can Global{Read,Write}

        def canonical_named_slot(ref: sview, lexical_scope: usize, names: darray[sview]&, scopes: darray[usize]&, state: GlobalAuthority&) -> usize:
            can Abort.Panic:
                head: sview = ga_ref_head(ref)
                last_scope: mutable usize = sview_len(head)
                for index in 0..<sview_len(head) |last_scope|:
                    last_scope <- index if sview_at(head, index) == 58 and index + 1 < sview_len(head) and sview_at(head, index + 1) == 58
                if last_scope < sview_len(head):
                    parent: usize = ga_text_module(head[0:last_scope], lexical_scope, state)
                    return ga_resolve(head[last_scope + 2:sview_len(head)], parent, true, names, scopes, state)
                return ga_resolve(head, lexical_scope, false, names, scopes, state)

        def ga_generic_call_rows_at(slot: usize, at: Ast::Pos, state: GlobalAuthority&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                return if slot >= table.effect_canonical_function_row_start.count
                start: usize = table.effect_canonical_function_row_start[slot]
                end: usize = start + table.effect_canonical_function_row_count[slot]
                for row in start..<end |table| -> table:
                    ref_index: usize = table.effect_canonical_row_ref[row]
                    ref: sview = table.effect_canonical_refs[ref_index]
                    family: sview = effect_ref_family(ref)
                    continue if family == "Global" or (family == "Unsafe" and not state.strict_unsafe)
                    continue if ga_permission_param_ref_is_param(ref_index, ref, state, table)
                    if not ga_granted(ref, at, state, table.effect_canonical_row_scope[row]):
                        name: sview = table.effect_canonical_function_name[slot]
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UngrantedEffectCall, name: name, expected: ref, actual: family, detail: "canonical-unsafe" if family == "Unsafe" and state.strict_unsafe else "canonical-row", line: at.line, pos: ga_position_value(at.line, at.column, at.offset, at.end_line, at.end_column, at.end_offset)})

        # Keep the AST-facing entry point for existing callers; replay can pass an
        # exact current-source position without manufacturing a callee expression.
        def ga_generic_call_rows(slot: usize, callee: Ast::Expr, state: GlobalAuthority&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- ga_generic_call_rows_at(slot, Ast::expr_pos(callee), state, table) can Global{Read,Write}
