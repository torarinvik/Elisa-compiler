extend Semantic:
    private:
        struct StorageOwnedCandidate:
            name: sview
            parameters: darray[Ast::ParamDecl]
            fresh: bool

        # Named types whose values can NEVER carry a borrow, transitively: every field (and every
        # enum payload field) is a builtin scalar, another such type, or a `darray[...]` of one.
        # A least fixpoint over the file's struct/enum declarations, so a self-recursive or
        # generic type, an sview/cstr/slice/ref field at any depth, or a name declared twice with
        # one view-carrying declaration all stay OUT (conservative). Used to tell an owned
        # by-value return (`args: darray[ValueType] = infer(scope)`) from one that may hold a
        # view of its arguments.
        def storage_owned_type_names(file: Ast::File&) -> darray[sview]:
            can Memory.Allocate, Abort.Panic:
                names: mutable darray[sview] = []
                fields: mutable darray[Ast::Expr] = []
                starts: mutable darray[usize] = []
                generic: mutable darray[bool] = []
                storage_owned_collect(file.top_decls, file.generic_param_lines, names, fields, starts, generic)
                owned: mutable darray[sview] = []
                changed: mutable bool = true
                while changed |changed, owned, names, fields, starts, generic|:
                    changed <- false
                    for index in 0..<names.count |changed, owned, names, fields, starts, generic|:
                        continue if hce_contains(&owned, names[index])
                        same_ok: bool =
                            for other in 0..<names.count |same_ok: bool = true, owned, names, fields, starts, generic| -> same_ok:
                                if names[other] == names[index]:
                                    same_ok <- false if generic[other] or not storage_owned_fields_free(fields, starts[other], starts[other + 1], &owned)
                        if same_ok:
                            owned.push(names[index])
                            changed <- true
                return owned

        def storage_owned_collect(declarations: darray[Ast::Decl]&, generic_lines: darray[u32]&, names: mutable darray[sview]&, fields: mutable darray[Ast::Expr]&, starts: mutable darray[usize]&, generic: mutable darray[bool]&) -> void:
            can Memory.Allocate, Abort.Panic:
                starts.push(0) if starts.count == 0
                for declaration in declarations |generic_lines, names, fields, starts, generic|:
                    match declaration:
                        Decl.Struct(name, members, _, _, _, _, pos):
                            names.push(name)
                            generic.push(any line in generic_lines where line == pos.line)
                            for member in members |fields|:
                                fields.push(member.type_expression)
                            starts.push(fields.count)
                        Decl.Enum(name, variants, is_const, _, pos):
                            names.push(name)
                            generic.push(any line in generic_lines where line == pos.line)
                            if not is_const:
                                for variant in variants |fields|:
                                    for field_type in variant.fields |fields|:
                                        fields.push(field_type)
                            starts.push(fields.count)
                        Decl.Module(_, body, _):
                            storage_owned_collect(body, generic_lines, names, fields, starts, generic)
                        Decl.Scoped(body, _):
                            storage_owned_collect(body, generic_lines, names, fields, starts, generic)
                        _:
                            pass

        def storage_owned_fields_free(fields: darray[Ast::Expr]&, first: usize, last: usize, owned: darray[sview]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                for index in first..<last |fields, owned|:
                    false return if not storage_owned_type_free(fields[index], owned)
                return true

        # Whether a TYPE expression is borrow-free under OWNED: a builtin scalar, an owned named
        # type, or `darray[T]` of one (an optional `mutable` binding qualifier is ignored).
        def storage_owned_type_free(type_expression: Ast::Expr, owned: darray[sview]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                match type_expression:
                    Expr.Unary(TokenKind.Mutable, operand, _) | Expr.Paren(operand, _):
                        return storage_owned_type_free(operand, owned)
                    Expr.Ident(name, _):
                        return storage_view_type_is_scalar_copy(type_expression) or hce_contains(owned, name)
                    Expr.Index(head, argument, _):
                        return ident_name_of(head) == "darray" and storage_owned_type_free(argument, owned)
                    # `Geometry::Transform`: OWNED holds bare names, and a name stays out of it
                    # while any same-named declaration may carry a borrow, so the last segment
                    # is enough.
                    Expr.Scope(_, name, _):
                        return hce_contains(owned, name)
                    _:
                        return false

        # Append one `[owned-fn]` row (vro row width, so view-summary lookups skip it) per
        # function whose result is a FRESH borrow-free value: a declared return type that is
        # borrow-free under storage_owned_type_names, no `-> T @r` return-region tie, not generic.
        # A by-value return cannot be a parameter's storage without such a tie (a region-less
        # return of `p.items` is rejected), so the caller's local owns it. Every declaration of
        # the name (overloads, externs) must qualify. A GLOBAL's field returned by value DOES
        # share the global's buffer, so a body mentioning a global -- or, to a fixpoint, another
        # candidate that does (`return g()`) -- is excluded.
        def storage_owned_fn_rows(file: Ast::File&, rows: mutable darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                owned: darray[sview] = storage_owned_type_names(file)
                good: mutable darray[sview] = []
                bad: mutable darray[sview] = []
                bodies: mutable darray[darray[Ast::Stmt]] = []
                tainted: mutable darray[sview] = []
                good_modules: mutable darray[sview] = []
                flat: darray[sview] = storage_bufferless_type_names(file)
                storage_owned_fn_collect(file.top_decls, file.generic_param_lines, file.local_region_annotations, &owned, &flat, "", good, good_modules, bad, bodies, tainted)
                none: darray[sview] = []
                changed: mutable bool = tainted.count > 0
                while changed |changed, good, bad, bodies, tainted, none|:
                    changed <- false
                    for index in 0..<good.count |changed, good, bad, bodies, tainted, none|:
                        continue if hce_contains(&tainted, good[index])
                        if lvre_stmts_mention(&bodies[index], &tainted, &none) != "":
                            tainted.push(good[index])
                            bad.push(good[index])
                            changed <- true
                table.storage_owned_candidates <- table.storage_owned_candidates.truncate(0)
                # Only global functions participate in the bounded overload fallback.
                # Module/local/value calls remain on the conservative legacy path.
                for declaration in file.top_decls |table, owned, tainted, file|:
                    match declaration:
                        Decl.Func(name, parameters, return_type, _, _, _, pos):
                            fresh: mutable bool = false
                            if return_type is declared:
                                fresh <- storage_owned_type_free(declared, &owned) and function_return_region(file.local_region_annotations, pos.line) == "" and not (any line in file.generic_param_lines where line == pos.line) and not hce_contains(&tainted, name)
                            table.storage_owned_candidates <- table.storage_owned_candidates.push(StorageOwnedCandidate{name: name, parameters: parameters, fresh: fresh})
                        _:
                            pass
                table <- storage_owned_block_nested(file.top_decls, false, table)
                storage_owned_scope_rows(file, &owned, &flat, rows)
                # Row field 3 is the declaring module ("" at top level), so a qualified call
                # `M::f(...)` is recognised for exactly M's declaration.
                for index in 0..<good.count |rows, bad, good, good_modules|:
                    continue if hce_contains(&bad, good[index])
                    rows.push("[owned-fn]")
                    rows.push(good[index])
                    rows.push(good_modules[index])
                    rows.push("")
                    rows.push("")

        # One `[owned-scope]` row (vro row width) per function or extern: (marker, function,
        # module, "1" when its result is fresh and borrow-free else "0", ""). The `[owned-fn]`
        # rows key by bare name, so one unrelated same-named function in another module (an
        # engine's `read` returning a struct) took the exemption from every `read`. MODULE is
        # the innermost module name, "" at top level; two modules sharing an innermost name
        # both match a call, which can only make it stricter.
        #
        # The global taint is scoped the same way: a bare mention of `n` inside module M means
        # M's own `n` when M declares one, so M's untainted `n` shadows every other module's
        # tainted `n` (`LongClip::slot` is not `PerfCache::slot`). A name M does not declare
        # still counts if ANY declaration of it is tainted.
        def storage_owned_scope_rows(file: Ast::File&, owned: darray[sview]&, flat: darray[sview]&, rows: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                names: mutable darray[sview] = []
                modules: mutable darray[sview] = []
                # Only functions have a body; BODY_OF indexes BODIES for them.
                bodies: mutable darray[darray[Ast::Stmt]] = []
                body_of: mutable darray[usize] = []
                callable: mutable darray[bool] = []
                fresh: mutable darray[bool] = []
                tainted: mutable darray[bool] = []
                storage_owned_scope_collect(file.top_decls, "", file.generic_param_lines, file.local_region_annotations, owned, flat, names, modules, bodies, body_of, callable, fresh, tainted)
                changed: mutable bool = true
                while changed |changed, names, modules, bodies, body_of, fresh, tainted|:
                    changed <- false
                    tainted_names: mutable darray[sview] = []
                    for index in 0..<names.count |tainted_names, names, tainted|:
                        tainted_names.push(names[index]) if tainted[index] and not hce_contains(&tainted_names, names[index])
                    shadowed: mutable darray[sview] = []
                    shadow_module: mutable sview = ""
                    shadow_ready: mutable bool = false
                    for index in 0..<names.count |changed, names, modules, bodies, body_of, fresh, tainted, tainted_names, shadowed, shadow_module, shadow_ready|:
                        continue if tainted_names.count == 0 or not fresh[index] or tainted[index]
                        if not shadow_ready or modules[index] != shadow_module:
                            shadow_module <- modules[index]
                            shadow_ready <- true
                            shadowed <- storage_owned_module_shadows(shadow_module, &tainted_names, &names, &modules, &tainted)
                        if lvre_stmts_mention(&bodies[body_of[index]], &tainted_names, &shadowed) != "":
                            tainted[index] <- true
                            changed <- true
                for index in 0..<names.count |rows, names, modules, callable, fresh, tainted|:
                    continue if not callable[index]
                    clean: bool = fresh[index] and not tainted[index]
                    rows.push("[owned-scope]")
                    rows.push(names[index])
                    rows.push(modules[index])
                    rows.push("1" if clean else "0")
                    rows.push("")

        # The tainted names that MODULE itself declares, with none of its own declarations of
        # the name tainted: inside MODULE a bare mention of one of them is that clean local one.
        def storage_owned_module_shadows(module: sview, tainted_names: darray[sview]&, names: darray[sview]&, modules: darray[sview]&, tainted: darray[bool]&) -> darray[sview]:
            can Memory.Allocate, Abort.Panic:
                clean: mutable darray[sview] = []
                dirty: mutable darray[sview] = []
                for index in 0..<names.count |clean, dirty, module, tainted_names, names, modules, tainted|:
                    continue if modules[index] != module or not hce_contains(tainted_names, names[index])
                    if tainted[index]:
                        dirty.push(names[index])
                    else:
                        clean.push(names[index])
                shadowed: mutable darray[sview] = []
                for name in clean |shadowed, dirty|:
                    shadowed.push(name) if not hce_contains(&dirty, name) and not hce_contains(&shadowed, name)
                return shadowed

        def storage_owned_scope_collect(declarations: darray[Ast::Decl]&, module: sview, generic_lines: darray[u32]&, annotations: darray[Ast::LocalRegionAnnotation]&, owned: darray[sview]&, flat: darray[sview]&, names: mutable darray[sview]&, modules: mutable darray[sview]&, bodies: mutable darray[darray[Ast::Stmt]]&, body_of: mutable darray[usize]&, callable: mutable darray[bool]&, fresh: mutable darray[bool]&, tainted: mutable darray[bool]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |module, generic_lines, annotations, owned, flat, names, modules, bodies, body_of, callable, fresh, tainted|:
                    match declaration:
                        Decl.Func(name, _, return_type, body, _, _, pos):
                            is_fresh: mutable bool = false
                            if return_type is declared:
                                is_fresh <- storage_owned_type_free(declared, owned) and function_return_region(annotations, pos.line) == "" and not (any line in generic_lines where line == pos.line)
                            names.push(name)
                            modules.push(module)
                            body_of.push(bodies.count)
                            bodies.push(body)
                            callable.push(true)
                            fresh.push(is_fresh)
                            tainted.push(false)
                        Decl.Extern(name, _, _, _, _, _, _, _):
                            names.push(name)
                            modules.push(module)
                            body_of.push(0)
                            callable.push(true)
                            fresh.push(false)
                            tainted.push(false)
                        # A global with a buffer taints its readers (see storage_owned_fn_collect).
                        Decl.Const(name, type_expression, value, _, _):
                            names.push(name)
                            modules.push(module)
                            body_of.push(0)
                            callable.push(false)
                            fresh.push(false)
                            tainted.push(not storage_global_bufferless(type_expression, value, flat))
                        Decl.Module(inner, body, _):
                            storage_owned_scope_collect(body, module_last_segment(inner), generic_lines, annotations, owned, flat, names, modules, bodies, body_of, callable, fresh, tainted)
                        Decl.Scoped(body, _):
                            storage_owned_scope_collect(body, module, generic_lines, annotations, owned, flat, names, modules, bodies, body_of, callable, fresh, tainted)
                        _:
                            pass

        # `x: T = f(...)` / `x: T = M::f(...)` whose callee, resolved by module, returns a fresh
        # borrow-free value. A bare call resolves to the caller's own module and a qualified
        # one to the module it names; when neither declares the function (a `using` import, a
        # parent module, a type's associated function) this says nothing and the bare-name
        # `[owned-fn]` rule stays in charge.
        def storage_view_owned_scoped_call(value: Ast::Expr, view_fns: darray[sview]&, table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                match value:
                    Expr.Paren(inner, _):
                        return storage_view_owned_scoped_call(inner, view_fns, table)
                    Expr.Call(callee, _, _, _):
                        called: mutable sview = ""
                        module: mutable sview = table.storage_owned_module
                        bare: mutable bool = false
                        callee_pos: mutable Ast::Pos = Ast::expr_pos(callee)
                        match callee:
                            Expr.Ident(name, _):
                                called <- name
                                bare <- true
                            Expr.Scope(qualifier, name, _):
                                called <- name
                                module <- storage_owned_qualifier(qualifier)
                            _:
                                pass
                        false return if called == "" or (not bare and module == "")
                        found: mutable bool = false
                        row: mutable usize = vro_scan_start(view_fns, "[owned-scope]", called)
                        while vro_scan_live(view_fns, row, "[owned-scope]", called) |row, found, view_fns, called, module|:
                            if view_fns[row] == "[owned-scope]" and view_fns[row + 1] == called and view_fns[row + 2] == module:
                                false return if view_fns[row + 3] != "1"
                                found <- true
                            row <- row + 5
                        false return if not found
                        true return if not bare
                        # A function-valued local/parameter shadows a bare file function. Checked
                        # last: it scans every lexical reference.
                        return not storage_ref_pos_has_span(table, callee_pos)
                    _:
                        return false

        # The module a qualifier names: `Ops` in `Ops::f`, `Inner` in `Outer::Inner::f`.
        def storage_owned_qualifier(qualifier: Ast::Expr) -> sview:
            match qualifier:
                Expr.Ident(name, _):
                    return name
                Expr.Scope(_, name, _):
                    return name
                _:
                    return sview("", 0, 0)

        # Unmodelled declarations must block the fallback, never disappear from
        # its candidate set. A zero-parameter sentinel also blocks arity changes.
        def storage_owned_block_nested(declarations: darray[Ast::Decl]&, nested: bool, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table, nested|:
                    match declaration:
                        Decl.Func(name, _, _, _, _, _, _):
                            if nested:
                                table.storage_owned_candidates <- table.storage_owned_candidates.push(StorageOwnedCandidate{name: name, parameters: [], fresh: false})
                        Decl.Extern(name, _, _, _, _, _, _, _):
                            table.storage_owned_candidates <- table.storage_owned_candidates.push(StorageOwnedCandidate{name: name, parameters: [], fresh: false})
                        Decl.Module(_, body, _) | Decl.Scoped(body, _):
                            table <- storage_owned_block_nested(body, true, table)
                        _:
                            pass

        def storage_owned_fn_collect(declarations: darray[Ast::Decl]&, generic_lines: darray[u32]&, annotations: darray[Ast::LocalRegionAnnotation]&, owned: darray[sview]&, flat: darray[sview]&, module_name: sview, good: mutable darray[sview]&, good_modules: mutable darray[sview]&, bad: mutable darray[sview]&, bodies: mutable darray[darray[Ast::Stmt]]&, globals: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |generic_lines, annotations, owned, flat, module_name, good, good_modules, bad, bodies, globals|:
                    match declaration:
                        Decl.Func(name, _, return_type, body, _, _, pos):
                            fresh: mutable bool = false
                            if return_type is declared:
                                fresh <- storage_owned_type_free(declared, owned) and function_return_region(annotations, pos.line) == "" and not (any line in generic_lines where line == pos.line)
                            if fresh:
                                good.push(name)
                                good_modules.push(module_name)
                                bodies.push(body)
                            else:
                                bad.push(name)
                        Decl.Extern(name, _, _, _, _, _, _, _):
                            bad.push(name)
                        # A global with no buffer -- a scalar, a struct/enum of scalars, an
                        # untyped numeric literal, a string-literal sview (static bytes) --
                        # cannot make a by-value result share growable storage; any other
                        # global taints.
                        Decl.Const(name, type_expression, value, _, _):
                            globals.push(name) if not storage_global_bufferless(type_expression, value, flat)
                        Decl.Module(declared_module, body, _):
                            storage_owned_fn_collect(body, generic_lines, annotations, owned, flat, declared_module, good, good_modules, bad, bodies, globals)
                        Decl.Scoped(body, _):
                            storage_owned_fn_collect(body, generic_lines, annotations, owned, flat, module_name, good, good_modules, bad, bodies, globals)
                        _:
                            pass

        # `x: T = f(...)` where f is an `[owned-fn]`: the local owns a fresh value.
        def storage_view_owned_call(value: Ast::Expr, view_fns: darray[sview]&) -> bool:
            can Abort.Panic:
                match value:
                    Expr.Paren(inner, _):
                        return storage_view_owned_call(inner, view_fns)
                    Expr.Call(Expr.Ident(called, _), _, _, _):
                        row: mutable usize = vro_scan_start(view_fns, "[owned-fn]", called)
                        while vro_scan_live(view_fns, row, "[owned-fn]", called) |row, view_fns, called|:
                            true return if view_fns[row] == "[owned-fn]" and view_fns[row + 1] == called
                            row <- row + 5
                        return false
                    # `M::f(...)`: only a row declared directly in module M (a nested or
                    # non-module qualifier stays on the conservative path).
                    Expr.Call(Expr.Scope(Expr.Ident(qualifier, _), called, _), _, _, _):
                        row: mutable usize = vro_scan_start(view_fns, "[owned-fn]", called)
                        while vro_scan_live(view_fns, row, "[owned-fn]", called) |row, view_fns, called, qualifier|:
                            true return if view_fns[row] == "[owned-fn]" and view_fns[row + 1] == called and view_fns[row + 2] == qualifier
                            row <- row + 5
                        return false
                    _:
                        return false

        # Recover the exact lexical type of a borrowed identifier. No file-wide
        # spelling lookup is allowed: shadowed bindings have independent IDs.
        def storage_owned_argument_type(argument: Ast::Expr, table: SymbolTable&) -> u32:
            can Memory.Allocate, Abort.Panic:
                match argument:
                    Expr.Paren(inner, _) | Expr.Unary(TokenKind.Ampersand, inner, _):
                        return storage_owned_argument_type(inner, table)
                    Expr.Ident(_, pos):
                        return 0 if pos.end_offset <= pos.offset
                        for index in 0..<table.ref_pos.count:
                            return 0 if index >= table.ref_binding_ids.count
                            continue if table.ref_pos[index].offset != pos.offset or table.ref_pos[index].end_offset != pos.end_offset
                            for declared in table.binding_declared_types:
                                continue if declared.binding_id.owner.value != table.ref_binding_ids[index].owner.value or declared.binding_id.serial != table.ref_binding_ids[index].serial
                                return 0 if declared.module_owner != ""
                                type_id: mutable u32 = declared.type_id
                                while type_id != 0 and interned_kind(type_id, table) == SemTypeKind.Ref and interned_elem_count(type_id, table) == 1 |type_id|:
                                    type_id <- interned_elem(type_id, 0, table)
                                return type_id
                        return 0
                    _:
                        return 0

        # A known builtin container cannot bind a nominal struct parameter.
        # Aliases, unknown types and same-shaped candidates are NOT excluded.
        def storage_owned_argument_incompatible(argument: Ast::Expr, parameter: Ast::Expr, table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                actual: u32 = storage_owned_argument_type(argument, table)
                return false if actual == 0 or interned_kind(actual, table) != SemTypeKind.Container
                return false if interned_name(actual, table) != "darray" and interned_name(actual, table) != "array"
                formal: Ast::Expr = zeroed_strip_binding_modifiers(parameter)
                head: mutable Ast::Expr = formal
                if rvc_ref_pointee(formal) is referent:
                    head <- referent if not rvc_is_absent(referent)
                match head:
                    Expr.Index(base, _, _) | Expr.IndexN(base, _, _):
                        head <- base
                    _:
                        pass
                # Builtin array declarations also have Struct symbol rows. They
                # are the compatible container itself, not a distinct nominal.
                return false if ident_name_of(head) == "darray" or ident_name_of(head) == "array"
                nominal: u32 = binding_nominal_declaration(head, "", table)
                return nominal != SYMBOL_INDEX_ROW_NONE and table.symbols[nominal.usize()].kind == SymbolKind.Struct

        # Candidate rows named NAME, ascending: through the name chains when they are current,
        # otherwise every row (callers still compare names). `count` means "no more rows".
        def storage_owned_candidate_first(table: SymbolTable&, name: sview) -> usize:
            can Abort.Panic:
                0 return if not storage_owned_candidates_current(table)
                return head.usize() if table.storage_owned_candidate_heads.get(name_hash(name)) is head else table.storage_owned_candidates.count

        def storage_owned_candidate_after(table: SymbolTable&, row: usize) -> usize:
            can Abort.Panic:
                row + 1 return if not storage_owned_candidates_current(table)
                following: u32 = table.storage_owned_candidate_next[row]
                table.storage_owned_candidates.count return if following == SYMBOL_INDEX_ROW_NONE
                return following.usize()

        def storage_owned_candidates_current(table: SymbolTable&) -> bool:
            can Abort.Panic:
                return table.storage_owned_candidates_index_built and table.storage_owned_candidates_indexed == table.storage_owned_candidates.count

        # `any pos in table.ref_pos where pos.offset == SPAN.offset and pos.end_offset ==
        # SPAN.end_offset`, through the offset chains while they are current.
        def storage_ref_pos_has_span(table: SymbolTable&, span: Ast::Pos) -> bool:
            can Abort.Panic:
                if table.storage_ref_pos_index_built and table.storage_ref_pos_indexed == table.ref_pos.count:
                    row: mutable u32 = head if table.storage_ref_pos_heads.get(span.offset.u64()) is head else SYMBOL_INDEX_ROW_NONE
                    while row != SYMBOL_INDEX_ROW_NONE |row, table, span|:
                        candidate: Ast::Pos = table.ref_pos[row.usize()]
                        true return if candidate.offset == span.offset and candidate.end_offset == span.end_offset
                        row <- table.storage_ref_pos_next[row.usize()]
                    return false
                return any pos in table.ref_pos where pos.offset == span.offset and pos.end_offset == span.end_offset

        def storage_index_ref_pos(table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table.storage_ref_pos_heads <- {}
                table.storage_ref_pos_next <- []
                for row in 0..<table.ref_pos.count |table|:
                    key: u64 = table.ref_pos[row].offset.u64()
                    previous: u32 = head if table.storage_ref_pos_heads.get(key) is head else SYMBOL_INDEX_ROW_NONE
                    table.storage_ref_pos_next <- table.storage_ref_pos_next.push(previous)
                    table.storage_ref_pos_heads <- table.storage_ref_pos_heads.put(key, row.u32())
                table.storage_ref_pos_indexed <- table.ref_pos.count
                table.storage_ref_pos_index_built <- true

        def storage_owned_index_candidates(table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table.storage_owned_candidate_heads <- {}
                table.storage_owned_candidate_tails <- {}
                table.storage_owned_candidate_next <- []
                for row in 0..<table.storage_owned_candidates.count |table|:
                    hash: u64 = name_hash(table.storage_owned_candidates[row].name)
                    table.storage_owned_candidate_next <- table.storage_owned_candidate_next.push(SYMBOL_INDEX_ROW_NONE)
                    tail_row: u32 = found_tail if table.storage_owned_candidate_tails.get(hash) is found_tail else SYMBOL_INDEX_ROW_NONE
                    if tail_row != SYMBOL_INDEX_ROW_NONE:
                        table.storage_owned_candidate_next[tail_row.usize()] <- row.u32()
                    else:
                        table.storage_owned_candidate_heads <- table.storage_owned_candidate_heads.put(hash, row.u32())
                    table.storage_owned_candidate_tails <- table.storage_owned_candidate_tails.put(hash, row.u32())
                table.storage_owned_candidates_indexed <- table.storage_owned_candidates.count
                table.storage_owned_candidates_index_built <- true

        def storage_view_owned_overload_call(value: Ast::Expr, table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                match value:
                    Expr.Paren(inner, _):
                        return storage_view_owned_overload_call(inner, table)
                    Expr.Call(Expr.Ident(called, callee_pos), arguments, argument_names, _):
                        return false if arguments.count == 0 or any label in argument_names where label != ""
                        # Most calls already use the cheap legacy summary. Avoid
                        # whole lexical-reference scans unless an owned overload
                        # could actually benefit from disambiguation.
                        possible: mutable bool = false
                        matches: mutable usize = 0
                        candidate_row: mutable usize = storage_owned_candidate_first(table, called)
                        while candidate_row < table.storage_owned_candidates.count |candidate_row, possible, matches, table, called|:
                            candidate: StorageOwnedCandidate = table.storage_owned_candidates[candidate_row]
                            if candidate.name == called:
                                matches <- matches + 1
                                possible <- true if candidate.fresh
                            candidate_row <- storage_owned_candidate_after(table, candidate_row)
                        return false if not possible or matches < 2
                        return false if storage_owned_argument_type(arguments[0], table) == 0
                        # A function-valued local/parameter shadows file functions.
                        return false if storage_ref_pos_has_span(table, callee_pos)
                        found: mutable bool = false
                        match_row: mutable usize = storage_owned_candidate_first(table, called)
                        while match_row < table.storage_owned_candidates.count |match_row, found, table, called, arguments|:
                            candidate: StorageOwnedCandidate = table.storage_owned_candidates[match_row]
                            match_row <- storage_owned_candidate_after(table, match_row)
                            continue if candidate.name != called
                            return false if candidate.parameters.count != arguments.count
                            incompatible: mutable bool = false
                            for index in 0..<arguments.count |incompatible|:
                                incompatible <- true if storage_owned_argument_incompatible(arguments[index], candidate.parameters[index].type_expression, table)
                            continue if incompatible
                            return false if not candidate.fresh
                            found <- true
                        return found
                    _:
                        return false

        # Named struct/enum types every field (and payload field) of which is a builtin scalar:
        # non-generic, declared once. Their values hold no buffer at all.
        def storage_bufferless_type_names(file: Ast::File&) -> darray[sview]:
            can Memory.Allocate, Abort.Panic:
                names: mutable darray[sview] = []
                fields: mutable darray[Ast::Expr] = []
                starts: mutable darray[usize] = []
                generic: mutable darray[bool] = []
                storage_owned_collect(file.top_decls, file.generic_param_lines, names, fields, starts, generic)
                flat: mutable darray[sview] = []
                for index in 0..<names.count |flat, names, fields, starts, generic|:
                    duplicate: mutable bool = false
                    for other in 0..<names.count |duplicate, names|:
                        duplicate <- true if other != index and names[other] == names[index]
                    continue if duplicate or generic[index]
                    scalar_only: mutable bool = true
                    for position in starts[index]..<starts[index + 1] |scalar_only, fields|:
                        scalar_only <- false if not storage_view_type_is_scalar_copy(storage_owned_strip_mutable(fields[position]))
                    flat.push(names[index]) if scalar_only
                return flat

        def storage_owned_strip_mutable(type_expression: Ast::Expr) -> Ast::Expr:
            match type_expression:
                Expr.Unary(TokenKind.Mutable, operand, _) | Expr.Paren(operand, _):
                    return storage_owned_strip_mutable(operand)
                _:
                    return type_expression

        def storage_global_bufferless(type_expression: Ast::Expr, value: Ast::Expr, flat: darray[sview]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                stripped: Ast::Expr = storage_owned_strip_mutable(type_expression)
                true return if storage_view_type_is_scalar_copy(stripped)
                type_name: sview = ident_name_of(stripped)
                true return if type_name != "" and hce_contains(flat, type_name)
                match value:
                    Expr.IntLit(_, _) | Expr.FloatLit(_, _) | Expr.BoolLit(_, _) | Expr.CharLit(_, _):
                        return type_name == ""
                    Expr.StringLit(_, _):
                        return type_name == "" or type_name == "sview"
                    _:
                        return false
