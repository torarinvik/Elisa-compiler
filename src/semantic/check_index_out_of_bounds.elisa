# Check for index out of bounds: a constant integer index into a fixed-size array
# that is provably out of range. Example: `xs: i64[3]` then `xs[5]` raises an error.

extend Semantic:
    private:
        # Extract the expected array size from a type expression representing a fixed-size array.
        # For `i64[3]`, this should return 3 if the type is Index(i64, IntLit(3)).
        # Returns -1 if the type does not represent a fixed-size array.
        def extract_array_size_index(type_expr: Ast::Expr) -> i64:
            can Memory.Allocate, Abort.Panic:
                match type_expr:
                    Expr.Index(object, index, line):
                        # Fixed-size array syntax: BaseType[Size]
                        # The index should be an IntLit
                        match index:
                            Expr.IntLit(size_value):
                                return size_value
                            _:
                                return (-1)
                    _:
                        return (-1)

        # Walk through all expressions, checking for Index expressions with out-of-bounds
        # constant integer indexes.
        def walk_expression_for_index_out_of_bounds(expression: Ast::Expr, names: mutable darray[sview]&, sizes: mutable darray[i64]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Index(object, index, line):
                        # Check for index out of bounds: only flag if object is an Ident
                        # that matches a tracked fixed-array local AND index is IntLit.
                        if object is Expr.Ident(arr_name, _):
                            # Find the array name in our tracking lists
                            found_index: mutable i64 = (-1)
                            for i in 0..<names.count |found_index|:
                                if names[i] == arr_name:
                                    found_index <- i.i64()
                                    break
                            if found_index >= 0:
                                # Found a tracked fixed-array local
                                expected_size: i64 = sizes[found_index.usize()]
                                if index is Expr.IntLit(actual_index):
                                    # Index is a literal constant
                                    if actual_index >= expected_size or actual_index < 0:
                                        # Out of bounds: push diagnostic
                                        # For negative indexes, report 0 as the actual_count (conservative)
                                        actual_count: mutable u32 = 0
                                        actual_count <- actual_index.u32() if actual_index >= 0
                                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.IndexOutOfBounds, name: arr_name, line: line, expected: "", actual: "", expected_count: expected_size.u32(), actual_count: actual_count})
                        # Recursively walk the object and index expressions
                        table <- walk_expression_for_index_out_of_bounds(object, names, sizes, table)
                        table <- walk_expression_for_index_out_of_bounds(index, names, sizes, table)
                    Expr.Binary(left, operator, right, line):
                        table <- walk_expression_for_index_out_of_bounds(left, names, sizes, table)
                        if operator != TokenKind.Is and operator != TokenKind.As:
                            table <- walk_expression_for_index_out_of_bounds(right, names, sizes, table)
                    Expr.Call(callee, arguments, argument_names, line):
                        table <- walk_expression_for_index_out_of_bounds(callee, names, sizes, table)
                        for argument in arguments:
                            table <- walk_expression_for_index_out_of_bounds(argument, names, sizes, table)
                    Expr.Field(object, field, line):
                        table <- walk_expression_for_index_out_of_bounds(object, names, sizes, table)
                    Expr.Scope(base, name, line):
                        table <- walk_expression_for_index_out_of_bounds(base, names, sizes, table)
                    Expr.Unary(operator, operand, line):
                        table <- walk_expression_for_index_out_of_bounds(operand, names, sizes, table)
                    Expr.Paren(inner, line):
                        table <- walk_expression_for_index_out_of_bounds(inner, names, sizes, table)
                    Expr.Array(elements, line):
                        for element in elements:
                            table <- walk_expression_for_index_out_of_bounds(element, names, sizes, table)
                    Expr.Tuple(elements, line):
                        for element in elements:
                            table <- walk_expression_for_index_out_of_bounds(element, names, sizes, table)
                    Expr.Slice(object, low, high, line):
                        table <- walk_expression_for_index_out_of_bounds(object, names, sizes, table)
                        table <- walk_expression_for_index_out_of_bounds(low, names, sizes, table)
                        table <- walk_expression_for_index_out_of_bounds(high, names, sizes, table)
                    Expr.IndexN(object, arguments, line):
                        table <- walk_expression_for_index_out_of_bounds(object, names, sizes, table)
                        if not index_receiver_is_type_application(object):
                            for argument in arguments:
                                table <- walk_expression_for_index_out_of_bounds(argument, names, sizes, table)
                    Expr.SetLit(elements, line):
                        for element in elements:
                            table <- walk_expression_for_index_out_of_bounds(element, names, sizes, table)
                    Expr.DictLit(entries, line):
                        for entry in entries:
                            table <- walk_expression_for_index_out_of_bounds(entry.key, names, sizes, table)
                            table <- walk_expression_for_index_out_of_bounds(entry.value, names, sizes, table)
                    Expr.Construct(type_expression, fields, line):
                        table <- walk_expression_for_index_out_of_bounds(type_expression, names, sizes, table)
                        for field in fields:
                            table <- walk_expression_for_index_out_of_bounds(field.value, names, sizes, table)
                    Expr.RecordUpdate(base, fields, line):
                        table <- walk_expression_for_index_out_of_bounds(base, names, sizes, table)
                        for field in fields:
                            table <- walk_expression_for_index_out_of_bounds(field.value, names, sizes, table)
                    Expr.If(condition, then_expr, else_expr, line):
                        table <- walk_expression_for_index_out_of_bounds(condition, names, sizes, table)
                        table <- walk_expression_for_index_out_of_bounds(then_expr, names, sizes, table)
                        table <- walk_expression_for_index_out_of_bounds(else_expr, names, sizes, table)
                    Expr.Comprehension(loop_variable, iterable, condition, body, line):
                        table <- walk_expression_for_index_out_of_bounds(iterable, names, sizes, table)
                        table <- walk_expression_for_index_out_of_bounds(condition, names, sizes, table)
                        table <- walk_expression_for_index_out_of_bounds(body, names, sizes, table)
                    Expr.Lambda(parameters, body, line):
                        table <- walk_statements_for_index_out_of_bounds(body, names, sizes, table)
                    Expr.Block(statements, value, captures, line):
                        table <- walk_statements_for_index_out_of_bounds(statements, names, sizes, table)
                        table <- walk_expression_for_index_out_of_bounds(value, names, sizes, table)
                    Expr.Match(scrutinee, arms, line):
                        table <- walk_expression_for_index_out_of_bounds(scrutinee, names, sizes, table)
                        for arm in arms:
                            table <- walk_statements_for_index_out_of_bounds(arm.body, names, sizes, table)
                    # Literals and other expression forms don't contain sub-expressions
                    _:
                        pass


        # Walk through statements, checking for index out of bounds in expressions and
        # tracking fixed-size array declarations.
        def walk_statements_for_index_out_of_bounds(statements: darray[Ast::Stmt], names: mutable darray[sview]&, sizes: mutable darray[i64]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            # Check if this is a fixed-size array declaration
                            array_size: i64 = extract_array_size_index(type_expression)
                            if array_size > 0:
                                # Check if this name is already tracked
                                found_index: mutable i64 = (-1)
                                for i in 0..<names.count:
                                    if names[i] == name:
                                        found_index <- i.i64()
                                        break
                                if found_index >= 0:
                                    # Update existing entry
                                    sizes[found_index.usize()] <- array_size
                                else:
                                    # Add new entry
                                    names.push(name)
                                    sizes.push(array_size)
                            # Check expressions in the value
                            table <- walk_expression_for_index_out_of_bounds(value, names, sizes, table)
                        Stmt.Expr(expression, line):
                            table <- walk_expression_for_index_out_of_bounds(expression, names, sizes, table)
                        Stmt.Assign(target, operator, value, line):
                            table <- walk_expression_for_index_out_of_bounds(target, names, sizes, table)
                            table <- walk_expression_for_index_out_of_bounds(value, names, sizes, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- walk_expression_for_index_out_of_bounds(condition, names, sizes, table)
                            table <- walk_statements_for_index_out_of_bounds(then_body, names, sizes, table)
                            table <- walk_statements_for_index_out_of_bounds(else_body, names, sizes, table)
                        Stmt.While(condition, body, line):
                            table <- walk_expression_for_index_out_of_bounds(condition, names, sizes, table)
                            table <- walk_statements_for_index_out_of_bounds(body, names, sizes, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- walk_expression_for_index_out_of_bounds(iterable, names, sizes, table)
                            table <- walk_statements_for_index_out_of_bounds(body, names, sizes, table)
                        Stmt.Return(value, line):
                            table <- walk_expression_for_index_out_of_bounds(return_value, names, sizes, table) if value is return_value
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- walk_statements_for_index_out_of_bounds(body, names, sizes, table)
                        Stmt.Match(scrutinee, arms, line):
                            table <- walk_expression_for_index_out_of_bounds(scrutinee, names, sizes, table)
                            for arm in arms:
                                table <- walk_statements_for_index_out_of_bounds(arm.body, names, sizes, table)
                        Stmt.Contract(kind, expression, line):
                            table <- walk_expression_for_index_out_of_bounds(expression, names, sizes, table)
                        # No expressions in these statements
                        Stmt.Break(label, line):
                            pass
                        Stmt.Continue(label, line):
                            pass
                        Stmt.Invalid:
                            pass


        # Walk through function declarations, checking for index out of bounds.
        def check_index_out_of_bounds(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table|:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            # Track fixed-array locals and check for index out of bounds
                            names: mutable darray[sview] = []
                            sizes: mutable darray[i64] = []
                            table <- walk_statements_for_index_out_of_bounds(body, names, sizes, table)
                        Decl.Module(module_name, body, line):
                            table <- check_index_out_of_bounds(body, table)
                        Decl.Scoped(body, line):
                            table <- check_index_out_of_bounds(body, table)
                        # Other declarations don't have bodies to check
                        _:
                            pass

