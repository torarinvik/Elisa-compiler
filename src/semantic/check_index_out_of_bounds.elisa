# Check for index out of bounds: a constant integer index into a fixed-size array
# that is provably out of range. Example: `xs: i64[3]` then `xs[5]` raises an error.

extend Semantic:
    private:
        # Extract the expected array size from a type expression representing a fixed-size array.
        # For `i64[3]`, this should return 3 if the type is Index(i64, IntLit(3)).
        # Returns -1 if the type does not represent a fixed-size array.
        def extract_array_size_index(type_expr: Ast::Expr) -> i64:
            can Memory.Allocate, Abort.Panic:
                match type_expr:
                    Expr.Index(object, index, line):
                        # Fixed-size array syntax: BaseType[Size]
                        # The index should be an IntLit
                        match index:
                            Expr.IntLit(size_value):
                                return size_value
                            _:
                                return (-1)
                    _:
                        return (-1)

        def resolve_known_int(expression: Ast::Expr, table: SymbolTable&, found: mutable bool&, value: mutable i64&) -> void:
            match expression:
                Expr.IntLit(literal):
                    found <- true
                    value <- literal
                Expr.Ident(name, line):
                    for index in 0..<table.const_int_names.count |found, value|:
                        if table.const_int_names[index] == name:
                            found <- true
                            value <- table.const_int_values[index]
                            break
                Expr.Binary(left, operator, right, line):
                    left_found: mutable bool = false
                    right_found: mutable bool = false
                    left_value: mutable i64 = 0
                    right_value: mutable i64 = 0
                    resolve_known_int(left, table, left_found, left_value)
                    resolve_known_int(right, table, right_found, right_value)
                    supported: bool = operator in {TokenKind.Plus, TokenKind.Minus, TokenKind.Star, TokenKind.Slash, TokenKind.Percent}
                    safe_divisor: bool = operator not in {TokenKind.Slash, TokenKind.Percent} or right_value != 0
                    found <- left_found and right_found and supported and safe_divisor
                    value <- match operator:
                        TokenKind.Plus: left_value + right_value
                        TokenKind.Minus: left_value - right_value
                        TokenKind.Star: left_value * right_value
                        TokenKind.Slash if right_value != 0: left_value / right_value
                        TokenKind.Percent if right_value != 0: left_value % right_value
                        _: 0
                _:
                    pass

        def tracked_array_index(name: sview, names: mutable darray[sview]&) -> i64:
            for index in 0..<names.count:
                index.i64() return if names[index] == name
            return (-1)

        # Walk through all expressions, checking for Index expressions with out-of-bounds
        # constant integer indexes.
        def walk_expression_for_index_out_of_bounds(expression: Ast::Expr, names: mutable darray[sview]&, sizes: mutable darray[i64]&, checked_get_lines: darray[u32]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Index(object, index, line):
                        # Check for index out of bounds: only flag if object is an Ident
                        # that matches a tracked fixed-array local AND index is IntLit.
                        if object is Expr.Ident(arr_name, _):
                            # Find the array name in our tracking lists
                            found_index: i64 = tracked_array_index(arr_name, names)
                            has_index: mutable bool = false
                            actual_index: mutable i64 = 0
                            resolve_known_int(index, table, has_index, actual_index)
                            if found_index >= 0 and has_index:
                                # A tracked fixed-array local indexed by a literal constant.
                                expected_size: i64 = sizes[found_index.usize()]
                                # For negative indexes, report 0 as the actual_count (conservative).
                                actual_count: mutable u32 = 0
                                actual_count <- actual_index.u32() if actual_index >= 0
                                # A `get arr[i] else …` / `arr[i] else …` CHECKED access
                                # (the parser marks its line `__checked_get`) returns the
                                # fallback when out of range, so a constant OOB index there is
                                # not an error — stage0 stays silent.
                                checked: bool = any g in checked_get_lines where g == line
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.IndexOutOfBounds, name: arr_name, line: line, expected: type_name_of_row(interned_elem(local_type_id_of(arr_name, table), 0, table), table), actual: "", expected_count: expected_size.u32(), actual_count: actual_count}) if (actual_index >= expected_size or actual_index < 0) and not checked
                        # Recursively walk the object and index expressions
                        table <- walk_expression_for_index_out_of_bounds(object, names, sizes, checked_get_lines, table)
                        table <- walk_expression_for_index_out_of_bounds(index, names, sizes, checked_get_lines, table)
                    Expr.Binary(left, operator, right, line):
                        table <- walk_expression_for_index_out_of_bounds(left, names, sizes, checked_get_lines, table)
                        table <- walk_expression_for_index_out_of_bounds(right, names, sizes, checked_get_lines, table) if operator != TokenKind.Is and operator != TokenKind.As
                    Expr.Call(callee, arguments, argument_names, line):
                        table <- walk_expression_for_index_out_of_bounds(callee, names, sizes, checked_get_lines, table)
                        for argument in arguments:
                            table <- walk_expression_for_index_out_of_bounds(argument, names, sizes, checked_get_lines, table)
                    Expr.Field(object, field, line):
                        table <- walk_expression_for_index_out_of_bounds(object, names, sizes, checked_get_lines, table)
                    Expr.Scope(base, name, line):
                        table <- walk_expression_for_index_out_of_bounds(base, names, sizes, checked_get_lines, table)
                    Expr.Unary(operator, operand, line):
                        table <- walk_expression_for_index_out_of_bounds(operand, names, sizes, checked_get_lines, table)
                    Expr.Paren(inner, line):
                        table <- walk_expression_for_index_out_of_bounds(inner, names, sizes, checked_get_lines, table)
                    Expr.Array(elements, line):
                        for element in elements:
                            table <- walk_expression_for_index_out_of_bounds(element, names, sizes, checked_get_lines, table)
                    Expr.Tuple(elements, line):
                        for element in elements:
                            table <- walk_expression_for_index_out_of_bounds(element, names, sizes, checked_get_lines, table)
                    Expr.Slice(object, low, high, line):
                        if object is Expr.Ident(arr_name, _):
                            found_index: i64 = tracked_array_index(arr_name, names)
                            low_found: mutable bool = false
                            high_found: mutable bool = false
                            low_value: mutable i64 = 0
                            high_value: mutable i64 = 0
                            resolve_known_int(low, table, low_found, low_value)
                            resolve_known_int(high, table, high_found, high_value)
                            if found_index >= 0:
                                expected_size: i64 = sizes[found_index.usize()]
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ArraySliceEndOutOfBounds, name: arr_name, line: line, expected: "", actual: "", expected_count: expected_size.u32(), actual_count: high_value.u32()}) if high_found and (high_value > expected_size or high_value < 0)
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ArraySliceReversed, name: arr_name, line: line, expected: "", actual: "", expected_count: low_value.u32(), actual_count: high_value.u32()}) if low_found and high_found and low_value > high_value
                        table <- walk_expression_for_index_out_of_bounds(object, names, sizes, checked_get_lines, table)
                        table <- walk_expression_for_index_out_of_bounds(low, names, sizes, checked_get_lines, table)
                        table <- walk_expression_for_index_out_of_bounds(high, names, sizes, checked_get_lines, table)
                    Expr.IndexN(object, arguments, line):
                        table <- walk_expression_for_index_out_of_bounds(object, names, sizes, checked_get_lines, table)
                        for argument in arguments:
                            table <- walk_expression_for_index_out_of_bounds(argument, names, sizes, checked_get_lines, table) if not index_receiver_is_type_application(object)
                    Expr.SetLit(elements, line):
                        for element in elements:
                            table <- walk_expression_for_index_out_of_bounds(element, names, sizes, checked_get_lines, table)
                    Expr.DictLit(entries, line):
                        for entry in entries:
                            table <- walk_expression_for_index_out_of_bounds(entry.key, names, sizes, checked_get_lines, table)
                            table <- walk_expression_for_index_out_of_bounds(entry.value, names, sizes, checked_get_lines, table)
                    Expr.Construct(type_expression, fields, line):
                        table <- walk_expression_for_index_out_of_bounds(type_expression, names, sizes, checked_get_lines, table)
                        for field in fields:
                            table <- walk_expression_for_index_out_of_bounds(field.value, names, sizes, checked_get_lines, table)
                    Expr.RecordUpdate(base, fields, line):
                        table <- walk_expression_for_index_out_of_bounds(base, names, sizes, checked_get_lines, table)
                        for field in fields:
                            table <- walk_expression_for_index_out_of_bounds(field.value, names, sizes, checked_get_lines, table)
                    Expr.If(condition, then_expr, else_expr, line):
                        table <- walk_expression_for_index_out_of_bounds(condition, names, sizes, checked_get_lines, table)
                        table <- walk_expression_for_index_out_of_bounds(then_expr, names, sizes, checked_get_lines, table)
                        table <- walk_expression_for_index_out_of_bounds(else_expr, names, sizes, checked_get_lines, table)
                    Expr.Comprehension(loop_variable, iterable, condition, body, line):
                        table <- walk_expression_for_index_out_of_bounds(iterable, names, sizes, checked_get_lines, table)
                        table <- walk_expression_for_index_out_of_bounds(condition, names, sizes, checked_get_lines, table)
                        table <- walk_expression_for_index_out_of_bounds(body, names, sizes, checked_get_lines, table)
                    Expr.Lambda(parameters, body, line):
                        table <- walk_statements_for_index_out_of_bounds(body, names, sizes, checked_get_lines, table)
                    Expr.Block(statements, value, captures, line):
                        table <- walk_statements_for_index_out_of_bounds(statements, names, sizes, checked_get_lines, table)
                        table <- walk_expression_for_index_out_of_bounds(value, names, sizes, checked_get_lines, table)
                    Expr.Match(scrutinee, arms, line):
                        table <- walk_expression_for_index_out_of_bounds(scrutinee, names, sizes, checked_get_lines, table)
                        for arm in arms:
                            table <- walk_statements_for_index_out_of_bounds(arm.body, names, sizes, checked_get_lines, table)
                    # Literals and other expression forms don't contain sub-expressions
                    _:
                        pass


        # Record a fixed-size array declaration `name` with `array_size` slots: update the size
        # of an already-tracked name, else append a new (name, size) row. Extracted so the decl
        # arm's guard is a single postfix-guarded call rather than a block `if` wrapping the
        # find-then-update/add decision.
        def track_fixed_size_array(name: sview, array_size: i64, names: mutable darray[sview]&, sizes: mutable darray[i64]&) -> void:
            can Memory.Allocate, Abort.Panic:
                found_index: mutable i64 = (-1)
                for i in 0..<names.count:
                    if names[i] == name:
                        found_index <- i.i64()
                        break
                if found_index >= 0:
                    # Update existing entry
                    sizes[found_index.usize()] <- array_size
                else:
                    # Add new entry
                    names.push(name)
                    sizes.push(array_size)


        # Walk through statements, checking for index out of bounds in expressions and
        # tracking fixed-size array declarations.
        def walk_statements_for_index_out_of_bounds(statements: darray[Ast::Stmt], names: mutable darray[sview]&, sizes: mutable darray[i64]&, checked_get_lines: darray[u32]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            # Track a fixed-size array declaration (updates or appends).
                            array_size: i64 = extract_array_size_index(type_expression)
                            track_fixed_size_array(name, array_size, names, sizes) if array_size > 0
                            # Check expressions in the value
                            table <- walk_expression_for_index_out_of_bounds(value, names, sizes, checked_get_lines, table)
                        Stmt.Expr(expression, line):
                            table <- walk_expression_for_index_out_of_bounds(expression, names, sizes, checked_get_lines, table)
                        Stmt.Assign(target, operator, value, line):
                            table <- walk_expression_for_index_out_of_bounds(target, names, sizes, checked_get_lines, table)
                            table <- walk_expression_for_index_out_of_bounds(value, names, sizes, checked_get_lines, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- walk_expression_for_index_out_of_bounds(condition, names, sizes, checked_get_lines, table)
                            table <- walk_statements_for_index_out_of_bounds(then_body, names, sizes, checked_get_lines, table)
                            table <- walk_statements_for_index_out_of_bounds(else_body, names, sizes, checked_get_lines, table)
                        Stmt.While(condition, body, line):
                            table <- walk_expression_for_index_out_of_bounds(condition, names, sizes, checked_get_lines, table)
                            table <- walk_statements_for_index_out_of_bounds(body, names, sizes, checked_get_lines, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- walk_expression_for_index_out_of_bounds(iterable, names, sizes, checked_get_lines, table)
                            table <- walk_statements_for_index_out_of_bounds(body, names, sizes, checked_get_lines, table)
                        Stmt.Return(value, line):
                            table <- walk_expression_for_index_out_of_bounds(return_value, names, sizes, checked_get_lines, table) if value is return_value
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- walk_statements_for_index_out_of_bounds(body, names, sizes, checked_get_lines, table)
                        Stmt.Match(scrutinee, arms, line):
                            table <- walk_expression_for_index_out_of_bounds(scrutinee, names, sizes, checked_get_lines, table)
                            for arm in arms:
                                table <- walk_statements_for_index_out_of_bounds(arm.body, names, sizes, checked_get_lines, table)
                        Stmt.Contract(kind, expression, line):
                            table <- walk_expression_for_index_out_of_bounds(expression, names, sizes, checked_get_lines, table)
                        # No expressions in these statements
                        Stmt.Break(label, line):
                            pass
                        Stmt.Continue(label, line):
                            pass
                        Stmt.Invalid:
                            pass


        # Walk through function declarations, checking for index out of bounds.
        def index_out_of_bounds_walk(declarations: darray[Ast::Decl], checked_get_lines: darray[u32]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table|:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            # Track fixed-array locals and check for index out of bounds
                            names: mutable darray[sview] = []
                            sizes: mutable darray[i64] = []
                            table <- walk_statements_for_index_out_of_bounds(body, names, sizes, checked_get_lines, table)
                        Decl.Module(module_name, body, line):
                            table <- index_out_of_bounds_walk(body, checked_get_lines, table)
                        Decl.Scoped(body, line):
                            table <- index_out_of_bounds_walk(body, checked_get_lines, table)
                        # Other declarations don't have bodies to check
                        _:
                            pass

        def check_index_out_of_bounds(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                checked_get_lines: mutable darray[u32] = [annotation.line for annotation in file.enum_annotations if annotation.owner == "__checked_get"]
                table <- index_out_of_bounds_walk(file.top_decls, checked_get_lines, table)
