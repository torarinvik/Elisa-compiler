# Named-contract well-formedness (stage0 validateContractDecl). A `contract NAME(...)`
# declaration must declare at least one parameter — the subject its requires/ensure
# clauses are written against. `contract Empty():` with no parameters is rejected.
#
# The parser lowers `contract NAME(params):` to a `Decl.Func` and records the name on the
# `__contract_decl` side-table (owner = contract name), so contract decls are told apart
# from ordinary functions.
extend Semantic:
    private:
        def cwf_is_contract(annotations: darray[Ast::EnumAnnotation]&, name: sview) -> bool:
            can Abort.Panic:
                for annotation in annotations:
                    true return if annotation.name == "__contract_decl" and annotation.owner == name
                return false

        def cwf_check_declarations(declarations: darray[Ast::Decl], annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(name, parameters, return_type, body, effects, decorators, line):
                            if parameters.count == 0 and cwf_is_contract(annotations, name):
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ContractNoSubject, name: name, line: line.line, expected: "", actual: ""})
                        Decl.Module(module_name, module_body, module_line):
                            table <- cwf_check_declarations(module_body, annotations, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- cwf_check_declarations(scoped_body, annotations, table)
                        _:
                            pass

    public:
        def check_contract_wellformed(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- cwf_check_declarations(file.top_decls, file.enum_annotations, table)
