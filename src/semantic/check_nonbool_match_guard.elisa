# Check for `match` arm guards whose inferred type is not bool.
# `_ if n:` where n is i64/f64/string/char is unsound as a guard condition;
# mirrors the existing NonBoolCondition diagnostic for if/while conditions.

extend Semantic:
    private:
        # Walk through expressions, checking any nested match arm guards.
        def walk_expression_for_nonbool_match_guard(expression: Ast::Expr, table: lmut SymbolTable, var_types: mutable darray[sview]&, type_names: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Binary(left, operator, right, line):
                        table <- walk_expression_for_nonbool_match_guard(left, table, var_types, type_names)
                        table <- walk_expression_for_nonbool_match_guard(right, table, var_types, type_names) if operator != TokenKind.Is and operator != TokenKind.As
                    Expr.Call(callee, arguments, argument_names, line):
                        table <- walk_expression_for_nonbool_match_guard(callee, table, var_types, type_names)
                        for argument in arguments |table|:
                            table <- walk_expression_for_nonbool_match_guard(argument, table, var_types, type_names)
                    Expr.Field(object, field, line):
                        table <- walk_expression_for_nonbool_match_guard(object, table, var_types, type_names)
                    Expr.Scope(base, name, line):
                        table <- walk_expression_for_nonbool_match_guard(base, table, var_types, type_names)
                    Expr.Index(object, index, line):
                        table <- walk_expression_for_nonbool_match_guard(object, table, var_types, type_names)
                        table <- walk_expression_for_nonbool_match_guard(index, table, var_types, type_names) if not index_receiver_is_type_application(object)
                    Expr.Unary(operator, operand, line):
                        table <- walk_expression_for_nonbool_match_guard(operand, table, var_types, type_names)
                    Expr.Paren(inner, line):
                        table <- walk_expression_for_nonbool_match_guard(inner, table, var_types, type_names)
                    Expr.Array(elements, line):
                        for element in elements |table|:
                            table <- walk_expression_for_nonbool_match_guard(element, table, var_types, type_names)
                    Expr.Tuple(elements, line):
                        for element in elements |table|:
                            table <- walk_expression_for_nonbool_match_guard(element, table, var_types, type_names)
                    Expr.Slice(object, low, high, line):
                        table <- walk_expression_for_nonbool_match_guard(object, table, var_types, type_names)
                        table <- walk_expression_for_nonbool_match_guard(low, table, var_types, type_names)
                        table <- walk_expression_for_nonbool_match_guard(high, table, var_types, type_names)
                    Expr.IndexN(object, arguments, line):
                        table <- walk_expression_for_nonbool_match_guard(object, table, var_types, type_names)
                        for argument in arguments |table|:
                            table <- walk_expression_for_nonbool_match_guard(argument, table, var_types, type_names) if not index_receiver_is_type_application(object)
                    Expr.SetLit(elements, line):
                        for element in elements |table|:
                            table <- walk_expression_for_nonbool_match_guard(element, table, var_types, type_names)
                    Expr.DictLit(entries, line):
                        for entry in entries |table|:
                            table <- walk_expression_for_nonbool_match_guard(entry.key, table, var_types, type_names)
                            table <- walk_expression_for_nonbool_match_guard(entry.value, table, var_types, type_names)
                    Expr.Construct(type_expression, fields, line):
                        table <- walk_expression_for_nonbool_match_guard(type_expression, table, var_types, type_names)
                        for field in fields |table|:
                            table <- walk_expression_for_nonbool_match_guard(field.value, table, var_types, type_names)
                    Expr.RecordUpdate(base, fields, line):
                        table <- walk_expression_for_nonbool_match_guard(base, table, var_types, type_names)
                        for field in fields |table|:
                            table <- walk_expression_for_nonbool_match_guard(field.value, table, var_types, type_names)
                    Expr.If(condition, then_expr, else_expr, line):
                        table <- walk_expression_for_nonbool_match_guard(condition, table, var_types, type_names)
                        table <- walk_expression_for_nonbool_match_guard(then_expr, table, var_types, type_names)
                        table <- walk_expression_for_nonbool_match_guard(else_expr, table, var_types, type_names)
                    Expr.Comprehension(loop_variable, iterable, condition, body, line):
                        table <- walk_expression_for_nonbool_match_guard(iterable, table, var_types, type_names)
                        table <- walk_expression_for_nonbool_match_guard(condition, table, var_types, type_names)
                        table <- walk_expression_for_nonbool_match_guard(body, table, var_types, type_names)
                    Expr.Lambda(parameters, body, line):
                        table <- walk_statements_for_nonbool_match_guard(body, table, var_types, type_names)
                    Expr.Block(statements, value, captures, line):
                        table <- walk_statements_for_nonbool_match_guard(statements, table, var_types, type_names)
                        table <- walk_expression_for_nonbool_match_guard(value, table, var_types, type_names)
                    Expr.Match(scrutinee, arms, line):
                        table <- walk_expression_for_nonbool_match_guard(scrutinee, table, var_types, type_names)
                        for arm in arms |table|:
                            has_guard: bool = match arm.guard:
                                Expr.Invalid: false
                                Expr.Absent: false
                                _:            true
                            guard_type: InferType = infer_expression_type(arm.guard, var_types, type_names, table)
                            guard_family: sview = family_of_kind(guard_type)
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.NonBoolMatchGuard, name: "", line: expr_line(arm.guard), expected: "bool", actual: stage0_value_spelling(guard_type)}) if has_guard and guard_family != "" and guard_family != "bool"
                            table <- walk_expression_for_nonbool_match_guard(arm.guard, table, var_types, type_names)
                            table <- walk_statements_for_nonbool_match_guard(arm.body, table, var_types, type_names)
                    # Literals and other expressions don't contain relevant sub-expressions
                    _:
                        pass

        # Walk through statements, tracking variable types and checking match arm guards.
        def walk_statements_for_nonbool_match_guard(statements: darray[Ast::Stmt], table: lmut SymbolTable, var_types: mutable darray[sview]&, type_names: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table|:
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- walk_expression_for_nonbool_match_guard(expression, table, var_types, type_names)
                        Stmt.VarDecl(name, type_expression, value, line):
                            # Record the type for this variable
                            type_name: sview = bare_type_name(type_expression)
                            note_local_type(var_types, type_names, name, type_name)
                            table <- walk_expression_for_nonbool_match_guard(value, table, var_types, type_names)
                        Stmt.Assign(target, operator, value, line):
                            table <- walk_expression_for_nonbool_match_guard(target, table, var_types, type_names)
                            table <- walk_expression_for_nonbool_match_guard(value, table, var_types, type_names)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- walk_expression_for_nonbool_match_guard(condition, table, var_types, type_names)
                            table <- walk_statements_for_nonbool_match_guard(then_body, table, var_types, type_names)
                            table <- walk_statements_for_nonbool_match_guard(else_body, table, var_types, type_names)
                        Stmt.While(condition, body, line):
                            table <- walk_expression_for_nonbool_match_guard(condition, table, var_types, type_names)
                            table <- walk_statements_for_nonbool_match_guard(body, table, var_types, type_names)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- walk_expression_for_nonbool_match_guard(iterable, table, var_types, type_names)
                            table <- walk_statements_for_nonbool_match_guard(body, table, var_types, type_names)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- walk_statements_for_nonbool_match_guard(body, table, var_types, type_names)
                        Stmt.Match(scrutinee, arms, line):
                            table <- walk_expression_for_nonbool_match_guard(scrutinee, table, var_types, type_names)
                            for arm in arms |table|:
                                has_guard: bool = match arm.guard:
                                    Expr.Invalid: false
                                    Expr.Absent: false
                                    _:            true
                                guard_type: InferType = infer_expression_type(arm.guard, var_types, type_names, table)
                                guard_family: sview = family_of_kind(guard_type)
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.NonBoolMatchGuard, name: "", line: expr_line(arm.guard), expected: "bool", actual: stage0_value_spelling(guard_type)}) if has_guard and guard_family != "" and guard_family != "bool"
                                table <- walk_expression_for_nonbool_match_guard(arm.guard, table, var_types, type_names)
                                table <- walk_statements_for_nonbool_match_guard(arm.body, table, var_types, type_names)
                        Stmt.Return(value, line):
                            table <- walk_expression_for_nonbool_match_guard(return_value, table, var_types, type_names) if value is return_value
                        Stmt.Contract(kind, expression, line):
                            table <- walk_expression_for_nonbool_match_guard(expression, table, var_types, type_names)
                        Stmt.Invalid:
                            pass
                        Stmt.Break(label, line):
                            pass
                        Stmt.Continue(label, line):
                            pass

        # Walk through function declarations.
        def check_nonbool_match_guard_declarations(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table|:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            # Create fresh type tracking for this function
                            var_types: mutable darray[sview] = []
                            type_names: mutable darray[sview] = []
                            # Record parameter types
                            for param in params |table|:
                                param_type: sview = bare_type_name(param.type_expression)
                                note_local_type(var_types, type_names, param.name, param_type)
                            # Walk the function body
                            table <- walk_statements_for_nonbool_match_guard(body, table, var_types, type_names)
                        Decl.Module(module_name, body, line):
                            table <- check_nonbool_match_guard_declarations(body, table)
                        Decl.Scoped(body, line):
                            table <- check_nonbool_match_guard_declarations(body, table)
                        _:
                            pass

    public:
        # Public entry point for the check.
        def check_nonbool_match_guard(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- check_nonbool_match_guard_declarations(declarations, table)
