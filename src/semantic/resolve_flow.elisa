# ORDERED, SCOPED resolution over a function body: statements are walked in
# source order, a binding becomes visible only AFTER the statement that
# introduces it (its initializer resolves against the names before it —
# stage0 errors on local use-before-declaration), and a nested block's
# bindings vanish at the block's end (truncate back to the scope mark;
# stage0 block scoping is real, see the DuplicateLocal probes). Refinement
# bindings gathered from a condition scope the guarded body only. `result`
# (from an `ensure` contract) persists for the whole function.

extend Semantic:
    private:


        # Pad the mutability pool up to `bound`'s length, CARRYING FORWARD each padded
        # name's existing mutability instead of defaulting it to `false`.
        #
        # The names needing padding were appended by gather_expression_bindings — chiefly
        # a value block's captures (`Expr.Block: bound.extend(captures)`), which it adds to
        # the ENCLOSING pool purely to flatten scope so names resolve. Those are not
        # declarations; padding them `false` invented an immutable entry that shadowed the
        # real one, so `while … |cursor|` twice over one mutable local reported E10 on every
        # capture after the first.
        #
        # A genuine shadowing declaration is unaffected: a VarDecl pushes its own mutability
        # explicitly (resolve_flow's Stmt.VarDecl), so `total: mutable i64` then an inner
        # `total: i64` still leaves `false` as the last entry and E10 still fires — the
        # `capture shadow probe` in resolve_smoke.sh pins exactly that.
        def pad_bound_mutability(bound: darray[sview]&, bound_mutability: mutable darray[bool]&, bound_ids: mutable darray[BindingId]&, owner: DeclId, binding_serial: mutable u64&) -> void:
            can Memory.Allocate, Abort.Panic:
                while bound_mutability.count < bound.count:
                    carried: mutable bool = false
                    scan: mutable usize = bound_mutability.count
                    while scan > 0 |scan, carried|:
                        scan <- scan - 1
                        if bound[scan] == bound[bound_mutability.count] and bound_mutability[scan]:
                            carried <- true
                            scan <- 0
                    bound_mutability.push(carried)
                while bound_ids.count < bound.count:
                    bound_ids.push(fresh_binding_id(owner, binding_serial))


        # The condition of an `if`/`while` statement or a value-position `if`
        # (`A if COND else B`) scopes like stage0's analyzeCondExpr: the RIGHT operand of an
        # `and` sees the bindings its left operand's truth introduces
        # (`2 if p is q and q.cast[i64] != 0 else 0`). `or` and `not` recurse into their
        # operands but add nothing, because a false operand binds nothing; every other form is
        # walked as a plain expression. So `if p is q or q…` leaves `q` undefined, as in stage0.
        # Each connective this unwraps counts against the walk depth, as walk_expression would;
        # past the limit walk_expression reports the overflow itself.
        def walk_condition_expression(expression: Ast::Expr, table: lmut SymbolTable, bound: darray[sview]&, bound_mutability: darray[bool]&, bound_ids: darray[BindingId]&) -> void:
            can Memory.Allocate, Abort.Panic:
                connective: bool = match expression:
                    Expr.Paren(_, _): true
                    Expr.Binary(_, binary_operator, _, _): binary_operator == TokenKind.And or binary_operator == TokenKind.Or
                    Expr.Unary(unary_operator, _, _): unary_operator == TokenKind.Not
                    _: false
                table.walk_depth <- table.walk_depth + 1 if connective
                if not connective or table.walk_depth > EXPRESSION_ANALYSIS_DEPTH_LIMIT:
                    table <- walk_expression(expression, table, bound, bound_mutability, bound_ids)
                else:
                    match expression:
                        Expr.Paren(inner, paren_line):
                            table <- walk_condition_expression(inner, table, bound, bound_mutability, bound_ids)
                        Expr.Unary(operator, operand, unary_line):
                            table <- walk_condition_expression(operand, table, bound, bound_mutability, bound_ids)
                        Expr.Binary(left, operator, right, binary_line):
                            table <- walk_condition_expression(left, table, bound, bound_mutability, bound_ids)
                            right_scope: mutable darray[sview] = [bound_name for bound_name in bound]
                            right_mutability: mutable darray[bool] = [is_mutable for is_mutable in bound_mutability]
                            right_ids: mutable darray[BindingId] = [id for id in bound_ids]
                            gather_truthy_condition_bindings(left, table, right_scope) if operator == TokenKind.And
                            pad_bound_mutability(right_scope, right_mutability, right_ids, table.current_function_decl_id, table.next_binding_serial)
                            table <- walk_condition_expression(right, table, right_scope, right_mutability, right_ids)
                        _:
                            pass
                table.walk_depth <- table.walk_depth - 1 if connective


        # The names a condition binds when it is TRUE. This mirrors stage0's
        # bindConditionPatternLocals with truthy set:
        #   - an `is`/`as` test binds its pattern, plus a recorded variant alias;
        #   - `and` binds both sides;
        #   - `or` binds only a name that EVERY alternative binds (`e is A(x) or e is B(x)`);
        #   - `not` binds nothing, because stage0 binds nothing under a false polarity, even
        #     under `not not`.
        def gather_truthy_condition_bindings(expression: Ast::Expr, table: SymbolTable&, bound: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Paren(inner, paren_line):
                        gather_truthy_condition_bindings(inner, table, bound)
                    Expr.Binary(left, operator, right, binary_line):
                        match operator:
                            TokenKind.And:
                                gather_truthy_condition_bindings(left, table, bound)
                                gather_truthy_condition_bindings(right, table, bound)
                            TokenKind.Or:
                                left_names: mutable darray[sview] = []
                                right_names: mutable darray[sview] = []
                                gather_truthy_condition_bindings(left, table, left_names)
                                gather_truthy_condition_bindings(right, table, right_names)
                                bound.extend([candidate for candidate in left_names if any other in right_names where other == candidate])
                            TokenKind.Is | TokenKind.As:
                                gather_is_target(right, bound)
                                gather_is_variant_aliases(expression, table.is_variant_alias_lines, table.is_variant_alias_names, bound)
                            _:
                                pass
                    _:
                        pass




        # Resolve an `Expr.Ident` assignment target. `=` introduces a fresh binding; any other
        # operator requires an EXISTING target, reported as a specific diagnostic. Modelled as a
        # split on the operator plus ordered guarded early-exits (name_known / const_is_immutable
        # are pure, so re-testing them in the return guards is behaviour-identical).
        def resolve_ident_assign_target(operator: TokenKind, target: Ast::Expr, target_name: sview, target_line: u32, line: u32, bound: mutable darray[sview]&, bound_mutability: mutable darray[bool]&, bound_ids: mutable darray[BindingId]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match operator:
                    TokenKind.Assign:
                        bound.push(target_name)
                        bound_mutability.push(false)
                        binding_id: BindingId = fresh_binding_id(table.current_function_decl_id, table.next_binding_serial)
                        bound_ids.push(binding_id)
                        table <- record_reference(table, target_line, target_name, false, binding_id)
                    _:
                        # A NON-`=` assign (`<-` or a compound `+=`/…) requires an EXISTING
                        # target; a bare undeclared name is a distinct error from a plain
                        # undefined reference (points the user at `=` to introduce it).
                        # `_` names no binding: it discards only as one slot of a multi-place
                        # target (`parser, _ <- …`); alone it is an undefined target, as in stage0.
                        target_missing: bool = target_name == "_" or not name_known(table, bound, target_name)
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AssignUndefinedTarget, name: target_name, pos: Ast::expr_pos(target), line: line, expected: "", actual: ""}) if target_missing
                        return if target_missing
                        # Writing to an immutable global `const` (not shadowed by a local). A
                        # local's immutability is handled by the mutation pass.
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AssignImmutable, name: target_name, line: line, expected: "", actual: ""}) if bound_last_index(bound, target_name) < 0 and const_is_immutable(table, target_name)
                        return if bound_last_index(bound, target_name) < 0 and const_is_immutable(table, target_name)
                        table <- walk_expression(target, table, bound, bound_mutability, bound_ids)




        def resolve_body(statements: darray[Ast::Stmt], table: lmut SymbolTable, bound: mutable darray[sview]&, bound_mutability: mutable darray[bool]&, bound_ids: mutable darray[BindingId]&) -> void:
            can Memory.Allocate, Abort.Panic:
                # Unreachable-code tracking: once a statement in THIS list unconditionally
                # exits it (`return`/`break`/`continue`), every following statement is dead.
                # Flag only the first such statement (a whole dead tail is one finding).
                terminated: mutable bool = false
                reported: mutable bool = false
                for statement in statements |table, bound, bound_mutability, bound_ids, terminated, reported|:
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UnreachableCode, name: "", line: statement_line(statement), expected: "", actual: ""}) if terminated and not reported and not statement_is_invalid(statement)
                    reported <- true if terminated and not reported and not statement_is_invalid(statement)
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- walk_expression(expression, table, bound, bound_mutability, bound_ids)
                            # An `is` refinement in a bare expression statement (e.g.
                            # `assert x is n`) keeps its binding for later statements —
                            # over-permissive, never a false unresolved.
                            gather_expression_bindings(expression, bound)
                            pad_bound_mutability(bound, bound_mutability, bound_ids, table.current_function_decl_id, table.next_binding_serial)
                        Stmt.VarDecl(name, type_expression, value, line):
                            # The initializer resolves BEFORE the name binds (`x: T = x`
                            # is use-before-declaration, as in stage0).
                            table <- walk_expression(value, table, bound, bound_mutability, bound_ids)
                            gather_expression_bindings(value, bound)
                            pad_bound_mutability(bound, bound_mutability, bound_ids, table.current_function_decl_id, table.next_binding_serial)
                            bound.push(name)
                            bound_mutability.push(local_binding_is_mutable(name, line.line, line.offset, type_expression, table))
                            binding_id: BindingId = fresh_binding_id(table.current_function_decl_id, table.next_binding_serial)
                            bound_ids.push(binding_id)
                            table <- record_reference(table, line.line, name, false, binding_id)
                        Stmt.Assign(target, operator, value, line):
                            table <- walk_expression(value, table, bound, bound_mutability, bound_ids)
                            gather_expression_bindings(value, bound)
                            pad_bound_mutability(bound, bound_mutability, bound_ids, table.current_function_decl_id, table.next_binding_serial)
                            match target:
                                Expr.Array(elements, array_line):
                                    # Multi-target: `=` defines fresh idents; `<-`/compound
                                    # targets are references that must already resolve.
                                    for element in elements |table, bound, bound_mutability, bound_ids|:
                                        match element:
                                            Expr.Ident(element_name, ident_line):
                                                match operator:
                                                    TokenKind.Assign:
                                                        # A multi-target `=` is also what `rebind X: T, recv = …`
                                                        # lowers to (parser_stmt_control.elisa: any colon in the
                                                        # group selects `Assign`). Its colon-LESS targets RE-BIND
                                                        # an existing name — they claim a threaded `lmut` slot —
                                                        # so pushing them as fresh IMMUTABLE bindings shadowed the
                                                        # real entry, and `bound_name_is_mutable` (which scans
                                                        # backwards) then read the shadow. That reported E10 on
                                                        # every `while … |lexer|` after a `rebind`: 2855 false
                                                        # positives on the compiler's own source, where stage0
                                                        # reports none. Carry an existing binding's mutability
                                                        # forward; a genuinely fresh name is immutable as before.
                                                        # Computed BEFORE the push: bound_name_is_mutable
                                                        # indexes bound_mutability by bound's index, so
                                                        # reading after pushing only one of the two pools
                                                        # is an out-of-range read.
                                                        rebound_mutability: bool = bound_name_is_mutable(element_name, bound, bound_mutability) if name_known(table, bound, element_name) else false
                                                        prior_binding_index: int = bound_last_index(bound, element_name) if name_known(table, bound, element_name) else -1
                                                        binding_id: BindingId = bound_ids[prior_binding_index.usize()] if prior_binding_index >= 0 else fresh_binding_id(table.current_function_decl_id, table.next_binding_serial)
                                                        bound.push(element_name)
                                                        bound_mutability.push(rebound_mutability)
                                                        bound_ids.push(binding_id)
                                                        table <- record_reference(table, ident_line.line, element_name, false, binding_id)
                                                    _:
                                                        table <- walk_expression(element, table, bound, bound_mutability, bound_ids)
                                            _:
                                                table <- walk_expression(element, table, bound, bound_mutability, bound_ids)
                                Expr.Ident(target_name, target_line):
                                    table <- resolve_ident_assign_target(operator, target, target_name, target_line.line, line.line, bound, bound_mutability, bound_ids, table)
                                Expr.Call(callee, call_arguments, call_argument_names, call_line):
                                    # Assigning to a call result is never valid (stage0:
                                    # `invalid assignment target`). Still walk the call so
                                    # its own references resolve.
                                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.InvalidAssignTarget, name: "", line: line.line, expected: "", actual: ""})
                                    table <- walk_expression(target, table, bound, bound_mutability, bound_ids)
                                _:
                                    table <- walk_expression(target, table, bound, bound_mutability, bound_ids)
                        Stmt.If(condition, then_body, else_body, line):
                            # The condition scopes as a ternary's does: a later `and` conjunct
                            # sees an earlier conjunct's `is`-bindings (`a is E.A(m) and m == n`);
                            # an `or` alternative, a `not` operand and an earlier conjunct see
                            # none. The then-body sees what the condition binds when TRUE, the
                            # else-body nothing. A postfix guard `STMT if COND` desugars to this
                            # If, so it follows the same rule. This used to gather every binding
                            # in the condition up front, which silently accepted
                            # `if p is q or q…` and read `q` when `p` was null.
                            mark: usize = bound.count
                            mutability_mark: usize = bound_mutability.count
                            binding_id_mark: usize = bound_ids.count
                            table <- walk_condition_expression(condition, table, bound, bound_mutability, bound_ids)
                            gather_truthy_condition_bindings(condition, table, bound)
                            pad_bound_mutability(bound, bound_mutability, bound_ids, table.current_function_decl_id, table.next_binding_serial)
                            table <- resolve_body(then_body, table, bound, bound_mutability, bound_ids)
                            bound.truncate(mark)
                            bound_mutability.truncate(mutability_mark)
                            bound_ids.truncate(binding_id_mark)
                            table <- resolve_body(else_body, table, bound, bound_mutability, bound_ids)
                            bound.truncate(mark)
                            bound_mutability.truncate(mutability_mark)
                            bound_ids.truncate(binding_id_mark)
                        Stmt.While(condition, body, line):
                            while_mark: usize = bound.count
                            while_mutability_mark: usize = bound_mutability.count
                            while_binding_id_mark: usize = bound_ids.count
                            # Scoped exactly as Stmt.If: the loop body is the TRUE branch.
                            table <- walk_condition_expression(condition, table, bound, bound_mutability, bound_ids)
                            gather_truthy_condition_bindings(condition, table, bound)
                            pad_bound_mutability(bound, bound_mutability, bound_ids, table.current_function_decl_id, table.next_binding_serial)
                            table.current_loop_depth <- table.current_loop_depth + 1
                            table <- resolve_body(body, table, bound, bound_mutability, bound_ids)
                            table.current_loop_depth <- table.current_loop_depth - 1
                            bound.truncate(while_mark)
                            bound_mutability.truncate(while_mutability_mark)
                            bound_ids.truncate(while_binding_id_mark)
                        Stmt.For(bind, variables, iterable, body, line):
                            # `where PATTERN: GUARD` layers TWO Refinements over the iterable:
                            # the PATTERN inside, the GUARD outside. Peel both, so the base
                            # that gets walked as an expression is the real iterable -- walking
                            # a Refinement as one reported the loop variable undefined.
                            filter_expression: mutable Ast::Expr? = null
                            filter_guard: mutable Ast::Expr? = null
                            match iterable:
                                Expr.Refinement(filter_base, filter_predicate, filter_line):
                                    match filter_base:
                                        Expr.Refinement(inner_base, inner_predicate, inner_line):
                                            table <- walk_expression(inner_base, table, bound, bound_mutability, bound_ids)
                                            filter_expression <- inner_predicate
                                            filter_guard <- filter_predicate
                                        _:
                                            table <- walk_expression(filter_base, table, bound, bound_mutability, bound_ids)
                                            filter_expression <- filter_predicate
                                _:
                                    table <- walk_expression(iterable, table, bound, bound_mutability, bound_ids)
                            for_mark: usize = bound.count
                            for_mutability_mark: usize = bound_mutability.count
                            for_binding_id_mark: usize = bound_ids.count
                            for variable in variables |table, bound, bound_mutability, bound_ids|:
                                bound.push(variable)
                                bound_mutability.push(bind == "mutable")
                                binding_id: BindingId = fresh_binding_id(table.current_function_decl_id, table.next_binding_serial)
                                bound_ids.push(binding_id)
                                table <- record_reference(table, line.line, variable, false, binding_id)
                            # A `where` filter may refine a loop variable with an `is`-pattern
                            # (`for item in xs where item is Expr.Int(value):`) — its payload
                            # bindings (`value`) are in scope for the loop body. Walk the filter,
                            # then gather its `is`/pattern bindings and keep bound_mutability in
                            # lockstep (pattern bindings are immutable).
                            filter_value: Ast::Expr = get filter_expression else (Ast::Expr.Invalid)
                            # A BARE pattern filter (`for x in xs where Enum.Variant(payload):`,
                            # no `x is` in front) is a PATTERN, not a predicate: `payload` is a
                            # binder it introduces, not a reference. Walking it as an ordinary
                            # expression reported `payload` undefined at the filter, and
                            # gather_expression_bindings then treated a Call's arguments as USES
                            # too -- so the body's `payload` was undefined as well and the whole
                            # function was rejected. Bind first and skip the walk for this shape.
                            #
                            # See is_bare_pattern_filter for why the shape test is narrow.
                            # The comprehension/query walker shares that same helper.
                            if is_bare_pattern_filter(filter_value):
                                gather_is_target(filter_value, bound)
                            else:
                                table <- walk_expression(filter_value, table, bound, bound_mutability, bound_ids)
                                gather_expression_bindings(filter_value, bound)
                            pad_bound_mutability(bound, bound_mutability, bound_ids, table.current_function_decl_id, table.next_binding_serial)
                            # The GUARD resolves in the PATTERN's scope -- `value > 2` after
                            # `item is Expr.Int(value)` -- so it is walked only now, with the
                            # pattern's bindings already in `bound`.
                            table <- walk_expression(guard_value, table, bound, bound_mutability, bound_ids) if filter_guard is guard_value
                            table.current_loop_depth <- table.current_loop_depth + 1
                            table <- resolve_body(body, table, bound, bound_mutability, bound_ids)
                            table.current_loop_depth <- table.current_loop_depth - 1
                            bound.truncate(for_mark)
                            bound_mutability.truncate(for_mutability_mark)
                            bound_ids.truncate(for_binding_id_mark)
                        Stmt.Block(kind, clause, binding, body, line):
                            # Prefix blocks are NOT value scopes: a `static if/elif/else`
                            # branch is compile-time INCLUSION (exactly one branch's
                            # locals continue into the surrounding scope — see
                            # arena.elisa's per-backend `r:` declarations), and
                            # `can`/`trusted`/… are effect-grant wrappers. Bindings flow
                            # through un-truncated.
                            bound.push(binding) if binding != ""
                            bound_mutability.push(false) if binding != ""
                            # Allocating an unused serial for an unnamed block is harmless; a
                            # binding identity is consumed only when the declaration is named.
                            block_binding_id: BindingId = fresh_binding_id(table.current_function_decl_id, table.next_binding_serial)
                            bound_ids.push(block_binding_id) if binding != ""
                            table <- record_reference(table, line.line, binding, false, block_binding_id) if binding != ""
                            for consumed_name in clause |table| -> table:
                                table <- walk_expression((Ast::Expr.Ident(consumed_name, line)), table, bound, bound_mutability, bound_ids) if kind == "destroy"
                            table <- resolve_body(body, table, bound, bound_mutability, bound_ids)
                        Stmt.Match(scrutinee, arms, line):
                            table <- walk_expression(scrutinee, table, bound, bound_mutability, bound_ids)
                            table <- check_unreachable_arms(arms, table, line.line)
                            for arm in arms |table, bound, bound_mutability, bound_ids|:
                                table <- check_pattern_variants(arm.pattern, table, line.line, arm_report_pos(arm, line.line))
                                arm_mark: usize = bound.count
                                arm_mutability_mark: usize = bound_mutability.count
                                arm_binding_id_mark: usize = bound_ids.count
                                gather_arm_pattern(arm.pattern, bound)
                                pad_bound_mutability(bound, bound_mutability, bound_ids, table.current_function_decl_id, table.next_binding_serial)
                                # docs/122 §5.1: the arm guard resolves in the arm's
                                # pattern scope (walk_expression is a no-op on Invalid).
                                table <- walk_expression(arm.guard, table, bound, bound_mutability, bound_ids)
                                table <- resolve_body(arm.body, table, bound, bound_mutability, bound_ids)
                                bound.truncate(arm_mark)
                                bound_mutability.truncate(arm_mutability_mark)
                                bound_ids.truncate(arm_binding_id_mark)
                        Stmt.Return(value, line):
                            # `return get X else return Y`: the get-else recovery is itself a return,
                            # so stage0's flow analysis does NOT treat the outer return as an
                            # unconditional block terminator — following statements are not flagged
                            # unreachable. Mirror that by suppressing termination for this shape.
                            getelse_recovery_returns: mutable bool = false
                            if value is return_value:
                                table <- walk_expression(return_value, table, bound, bound_mutability, bound_ids)
                                match return_value:
                                    Expr.GetElse(guarded, recovery, getelse_line):
                                        getelse_recovery_returns <- flow_recovery_returns(recovery)
                                    _:
                                        pass
                            terminated <- true if not getelse_recovery_returns
                        Stmt.Contract(kind, expression, line):
                            # `result` is in scope for an `ensure` predicate and, via the
                            # higher-order `ensures(f, PRED)` builtin, inside PRED under any
                            # contract kind (`requires ensures(f, result >= 5)`).
                            binds_result: bool = kind == "ensure" or kind == "ensures" or expression_mentions_ensures(expression)
                            bound.push("result") if binds_result
                            bound_mutability.push(false) if binds_result
                            bound_ids.push(fresh_binding_id(table.current_function_decl_id, table.next_binding_serial)) if binds_result
                            table <- walk_expression(expression, table, bound, bound_mutability, bound_ids)
                        Stmt.Invalid:
                            pass
                        Stmt.Break(label, line):
                            # A bare `break` at loop depth 0 is outside any loop.
                            # (`break if COND` desugars to `if COND: break` in the
                            # parser, so its Break is resolved at the current depth too.)
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.BreakOutsideLoop, name: "break", line: line.line, expected: "", actual: ""}) if table.current_loop_depth == 0
                            terminated <- true
                        Stmt.Continue(label, line):
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ContinueOutsideLoop, name: "continue", line: line.line, expected: "", actual: ""}) if table.current_loop_depth == 0
                            terminated <- true

include "./resolve_flow_termination.elisa"
include "./resolve_flow_exhaustiveness.elisa"
