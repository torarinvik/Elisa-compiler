extend Semantic:
    private:
        # ORDERED, SCOPED resolution over a function body: statements are walked in
        # source order, a binding becomes visible only AFTER the statement that
        # introduces it (its initializer resolves against the names before it —
        # stage0 errors on local use-before-declaration), and a nested block's
        # bindings vanish at the block's end (truncate back to the scope mark;
        # stage0 block scoping is real, see the DuplicateLocal probes). Refinement
        # bindings gathered from a condition scope the guarded body only. `result`
        # (from an `ensure` contract) persists for the whole function.
        # The source line of a statement (for locating a finding whose statement variant
        # is not otherwise destructured — e.g. the first unreachable statement).
        # Whether a statement is the parser's Invalid placeholder (a parse-error artifact,
        # never real code — so it must not be flagged as unreachable).
        def statement_is_invalid(statement: Ast::Stmt) -> bool:
            can Abort.Panic:
                return match statement:
                    Stmt.Invalid: true
                    _:            false


        def statement_line(statement: Ast::Stmt) -> u32:
            can Abort.Panic:
                return match statement:
                    Stmt.Expr(expression, line):                 line.line
                    Stmt.Block(block_kind, block_clause, block_binding, block_body, line):   line.line
                    Stmt.VarDecl(declaration_name, declaration_type, declaration_value, line):     line.line
                    Stmt.Assign(assign_target, assign_operator, assign_value, line):      line.line
                    Stmt.If(if_condition, if_then_body, if_else_body, line):          line.line
                    Stmt.While(while_condition, while_body, line):           line.line
                    Stmt.For(for_bind, for_variables, for_iterable, for_body, line):    line.line
                    Stmt.Return(return_value, line):              line.line
                    Stmt.Break(break_label, line):               line.line
                    Stmt.Continue(continue_label, line):            line.line
                    Stmt.Match(match_scrutinee, match_arms, line):           line.line
                    Stmt.Contract(contract_kind, contract_expression, line):        line.line
                    Stmt.Invalid:                       0


        # Whether a statement unconditionally terminates execution (returns/breaks/continues/raises).
        # Used to determine if a function with non-void return type necessarily returns before
        # exiting, and to track which statement ends a block for unreachable code detection.
        # Conservative: loops and conditionals that don't cover all cases are NOT treated as
        # terminators, so code after them is never falsely flagged as unreachable. Only explicit
        # control-flow statements (return/break/continue) and match expressions that provably
        # terminate all arms are considered terminators.
        # Whether a `get … else …` recovery block itself returns/raises (so the enclosing
        # `return get X else <recovery>` is not a clean block terminator for unreachable detection).
        def flow_recovery_returns(recovery: darray[Ast::Stmt]) -> bool:
            can Abort.Panic:
                for statement in recovery:
                    match statement:
                        Stmt.Return(recovery_value, recovery_line):
                            return true
                        _:
                            pass
                return false

        def statement_terminates(statement: Ast::Stmt, table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                return match statement:
                    Stmt.Return(_, _):           true
                    Stmt.Break(_, _):            true
                    Stmt.Continue(_, _):         true
                    Stmt.Match(_, arms, _):      arms_all_terminate(arms, table)
                    Stmt.If(_, then_body, else_body, _):
                        # Both branches must terminate for the if to be a terminator
                        statements_terminate(then_body, table) and statements_terminate(else_body, table)
                    Stmt.Block(_, _, _, body, _):
                        statements_terminate(body, table)
                    Stmt.Expr(expression, _):             expression_aborts(expression)
                    Stmt.While(condition, body, _):
                        # `while true:` with no break escaping THIS loop never falls
                        # through — treat as a terminator (matches stage0).
                        condition_is_true(condition) and not statements_break_out(body)
                    _:                           false


        # Whether an expression statement unconditionally aborts: a call to (or bare
        # mention of) `panic`/`raise`. Both parse as Ident heads in stage1.
        def expression_aborts(expression: Ast::Expr) -> bool:
            can Abort.Panic:
                return match expression:
                    Ast::Expr.Ident(name, _):       name == "panic" or name == "raise" or name == "error"
                    Ast::Expr.Call(callee, _, _, _):  expression_aborts(callee)
                    _:                              false


        def condition_is_true(expression: Ast::Expr) -> bool:
            can Abort.Panic:
                return match expression:
                    Ast::Expr.BoolLit(value):  value
                    _:                     false


        # Whether a statement list contains a `break` that would exit the ENCLOSING
        # loop: descends into if/match/block bodies but not into nested loops (their
        # breaks target themselves).
        def statements_break_out(statements: darray[Ast::Stmt]) -> bool:
            can Abort.Panic:
                for statement in statements:
                    hit: bool = match statement:
                        Stmt.Break(_, _):  true
                        Stmt.If(_, then_body, else_body, _):
                            statements_break_out(then_body) or statements_break_out(else_body)
                        Stmt.Match(_, arms, _):
                            any arm in arms where statements_break_out(arm.body)
                        Stmt.Block(_, _, _, body, _):
                            statements_break_out(body)
                        _:                 false
                    true return if hit
                return false


        # Whether all arms of a match terminate AND the match is exhaustive — parity with
        # stage0, which only treats a `match` as a terminator when every reachable case is
        # covered (see `match_arms_exhaustive`). A match whose arms all return but that
        # still has an uncovered case can fall through at runtime, so stage0 rejects the
        # enclosing function with "may fall through without returning a value".
        def arms_all_terminate(arms: darray[Ast::MatchArm], table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                false return if arms.count == 0
                false return if not (all arm in arms where statements_terminate(arm.body, table))
                return match_arms_exhaustive(arms, table)


        # Whether `arms` provably covers every value the scrutinee can take, mirroring
        # stage0's codegen-level exhaustiveness test (docs/122): an unguarded catch-all
        # (`_`/bare binding, or an all-wildcard tuple row) makes any match total; failing
        # that, an enum/hierarchy match is total only when every variant is individually
        # named across the (unguarded) arms. SOUND SUBSET, same philosophy as
        # `check_match_exhaustive`: any arm that is not a pure variant/or-of-variants cover
        # (a literal, struct, range, …) makes the whole match unprovable, so it's treated
        # as non-exhaustive — never a false claim of totality. Stage0 never treats literal
        # coverage (e.g. both `true:`/`false:` of a bool, or every value of a small int) as
        # exhaustive, so this deliberately does not attempt that either.
        def match_arms_exhaustive(arms: darray[Ast::MatchArm], table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                true return if match_has_catch_all(arms)
                # A struct scrutinee has exactly one shape, so an unguarded struct-destructure
                # arm (`Row{...}:`) is irrefutable — stage0's emitStructMatch treats it as
                # exhaustive with no `_` arm needed (oracle: TestAnalyzeBraceStructErgonomics).
                true return if any arm in arms where match_arm_is_unguarded_struct(arm)
                covered: mutable darray[sview] = []
                for arm in arms:
                    guarded: bool = match arm.guard:
                        Expr.Invalid: false
                        Expr.Absent:  false
                        _:            true
                    continue if guarded
                    false return if not collect_arm_variant_paths(arm.pattern, covered)
                false return if covered.count == 0
                anchor_owner: sview = enum_owner_of_path(covered[0], table)
                false return if anchor_owner == ""
                # Judge the arms against their own LEAST UPPER BOUND in the hierarchy, not
                # blindly against the first arm's PARENT. A match on a mid-tier category
                # (`match c:` over a `Control` refined by `Button`) names Control and Button;
                # jumping to Control's parent demanded coverage of every OTHER branch of the
                # tree, so a genuinely exhaustive function read as falling through and was
                # reported "must return a value". The compiler's own AST never exposed this:
                # every Ast refinement is a DIRECT child of Node, where the parent hop and
                # the least upper bound are the same node.
                anchor_node: sview = covering_hierarchy_node(anchor_owner, covered, table)
                if enum_is_hierarchy_member(anchor_node, table):
                    return hierarchy_subtree_all_covered(anchor_node, covered, table)
                return flat_enum_variants_all_covered(anchor_node, covered, table)


        # The lowest hierarchy node whose subtree contains every enum the arms name. Walks
        # the anchor up until each arm's owner is the anchor itself or one of its
        # descendants. A flat enum has no edges, so the anchor returns unchanged.
        def covering_hierarchy_node(start: sview, covered: darray[sview]&, table: SymbolTable&) -> sview:
            can Memory.Allocate, Abort.Panic:
                anchor: mutable sview = start
                for path in covered |anchor|:
                    owner: sview = enum_owner_of_path(path, table)
                    continue if owner == ""
                    steps: mutable usize = 0
                    while steps < table.enum_hierarchy_child.count |anchor, steps|:
                        break if owner == anchor or enum_in_hierarchy(owner, anchor, table)
                        parent: sview = enum_hierarchy_root_of(anchor, table)
                        break if parent == ""
                        anchor <- parent
                        steps <- steps + 1
                return anchor


        # Whether `enum_name` participates in a sealed hierarchy at all — it refines another
        # enum, or something refines it.
        def enum_is_hierarchy_member(enum_name: sview, table: SymbolTable&) -> bool:
            can Abort.Panic:
                false return if enum_name == ""
                for edge_index in 0..<table.enum_hierarchy_child.count:
                    true return if table.enum_hierarchy_child[edge_index] == enum_name
                    true return if table.enum_hierarchy_parent[edge_index] == enum_name
                return false


        # Every variant of `node` AND of all its refinements is named among `covered`
        # (leaves flow up, docs/77 §1) — exactly the case-set a match on `node` must cover.
        def hierarchy_subtree_all_covered(node: sview, covered: darray[sview]&, table: SymbolTable&) -> bool:
            can Abort.Panic:
                for variant_index in 0..<table.enum_variant_owner.count:
                    owner: sview = table.enum_variant_owner[variant_index]
                    if owner == node or enum_in_hierarchy(owner, node, table):
                        false return if not paths_cover_variant(covered, table.enum_variant_name[variant_index])
                return true


        # Whether ARM is an unguarded struct-destructure pattern (`Row{...}:`).
        def match_arm_is_unguarded_struct(arm: Ast::MatchArm) -> bool:
            can Abort.Panic:
                guarded: bool = match arm.guard:
                    Expr.Invalid: false
                    Expr.Absent:  false
                    _:            true
                false return if guarded
                return match arm.pattern:
                    Pattern.Struct(struct_path, struct_fields): true
                    _:                                          false


        # The enum name that owns the qualified variant path (`"TokenKind.IntLit"` ->
        # `"TokenKind"`), or "" when `path` isn't qualified by any known enum (e.g. the
        # `.Ready` leading-dot shorthand, which stores an unqualified path).
        def enum_owner_of_path(path: sview, table: SymbolTable&) -> sview:
            can Abort.Panic:
                for owner_index in 0..<table.enum_variant_owner.count:
                    candidate: sview = table.enum_variant_owner[owner_index]
                    candidate return if path_names_enum(path, candidate)
                return ""


        # The hierarchy root that `enum_name` is a registered child of, or "" when
        # `enum_name` isn't a hierarchy child (a plain flat enum).
        def enum_hierarchy_root_of(enum_name: sview, table: SymbolTable&) -> sview:
            can Abort.Panic:
                for child_index in 0..<table.enum_hierarchy_child.count:
                    table.enum_hierarchy_parent[child_index] return if table.enum_hierarchy_child[child_index] == enum_name
                return ""


        # Whether every variant of every child enum in the hierarchy rooted at `root` is
        # named among `covered` (mirrors `check_hierarchy_exhaustive`'s coverage test).
        def hierarchy_variants_all_covered(root: sview, covered: darray[sview]&, table: SymbolTable&) -> bool:
            can Abort.Panic:
                for variant_index in 0..<table.enum_variant_owner.count:
                    child: sview = table.enum_variant_owner[variant_index]
                    if enum_in_hierarchy(child, root, table):
                        false return if not paths_cover_variant(covered, table.enum_variant_name[variant_index])
                return true


        # Whether every declared variant of the flat enum `enum_name` is named among
        # `covered` (mirrors `check_match_exhaustive`'s coverage test).
        def flat_enum_variants_all_covered(enum_name: sview, covered: darray[sview]&, table: SymbolTable&) -> bool:
            can Abort.Panic:
                false return if not enum_is_known(enum_name, table)
                for variant_index in 0..<table.enum_variant_owner.count:
                    if table.enum_variant_owner[variant_index] == enum_name:
                        false return if not paths_cover_variant(covered, table.enum_variant_name[variant_index])
                return true


        # Whether a statement list necessarily terminates (every path leads to return/break/continue).
        # A list terminates if it's non-empty and the last statement terminates.
        def statements_terminate(statements: darray[Ast::Stmt], table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                false return if statements.count == 0
                return statement_terminates(statements[statements.count - 1], table)


        # Check that a non-void function body guarantees a return on all paths.
        # If the body can fall through without returning, report MissingReturnValue
        # on the last statement (or the function line if body is empty).
        def check_missing_return(body: darray[Ast::Stmt], is_void: bool, function_name: sview, table: lmut SymbolTable, line: u32) -> void:
            can Memory.Allocate, Abort.Panic:
                if is_void or body.count == 0:
                    # Void functions never need a return, and empty bodies are handled elsewhere
                    return if is_void
                    # Empty non-void body is missing a return
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.MissingReturnValue, name: function_name, line: line, expected: "", actual: ""})
                    return
                if not statements_terminate(body, table):
                    # Body doesn't guarantee a return; flag the last statement
                    last_line: mutable u32 = statement_line(body[body.count - 1])
                    last_line <- line if last_line == 0
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.MissingReturnValue, name: function_name, line: last_line, expected: "", actual: ""})


        # Pad the mutability pool up to `bound`'s length, CARRYING FORWARD each padded
        # name's existing mutability instead of defaulting it to `false`.
        #
        # The names needing padding were appended by gather_expression_bindings — chiefly
        # a value block's captures (`Expr.Block: bound.extend(captures)`), which it adds to
        # the ENCLOSING pool purely to flatten scope so names resolve. Those are not
        # declarations; padding them `false` invented an immutable entry that shadowed the
        # real one, so `while … |cursor|` twice over one mutable local reported E10 on every
        # capture after the first.
        #
        # A genuine shadowing declaration is unaffected: a VarDecl pushes its own mutability
        # explicitly (resolve_flow's Stmt.VarDecl), so `total: mutable i64` then an inner
        # `total: i64` still leaves `false` as the last entry and E10 still fires — the
        # `capture shadow probe` in resolve_smoke.sh pins exactly that.
        def pad_bound_mutability(bound: darray[sview]&, bound_mutability: mutable darray[bool]&) -> void:
            can Memory.Allocate, Abort.Panic:
                while bound_mutability.count < bound.count:
                    carried: mutable bool = false
                    scan: mutable usize = bound_mutability.count
                    while scan > 0 |scan, carried|:
                        scan <- scan - 1
                        if bound[scan] == bound[bound_mutability.count] and bound_mutability[scan]:
                            carried <- true
                            scan <- 0
                    bound_mutability.push(carried)


        # Resolve an `Expr.Ident` assignment target. `=` introduces a fresh binding; any other
        # operator requires an EXISTING target, reported as a specific diagnostic. Modelled as a
        # split on the operator plus ordered guarded early-exits (name_known / const_is_immutable
        # are pure, so re-testing them in the return guards is behaviour-identical).
        def resolve_ident_assign_target(operator: TokenKind, target: Ast::Expr, target_name: sview, target_line: u32, line: u32, bound: mutable darray[sview]&, bound_mutability: mutable darray[bool]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match operator:
                    TokenKind.Assign:
                        bound.push(target_name)
                        bound_mutability.push(false)
                        table <- record_reference(table, target_line, target_name, false)
                    _:
                        # A NON-`=` assign (`<-` or a compound `+=`/…) requires an EXISTING
                        # target; a bare undeclared name is a distinct error from a plain
                        # undefined reference (points the user at `=` to introduce it).
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AssignUndefinedTarget, name: target_name, line: line, expected: "", actual: ""}) if not name_known(table, bound, target_name)
                        return if not name_known(table, bound, target_name)
                        # Writing to an immutable global `const` (not shadowed by a local). A
                        # local's immutability is handled by the mutation pass.
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AssignImmutable, name: target_name, line: line, expected: "", actual: ""}) if bound_last_index(bound, target_name) < 0 and const_is_immutable(table, target_name)
                        return if bound_last_index(bound, target_name) < 0 and const_is_immutable(table, target_name)
                        table <- walk_expression(target, table, bound, bound_mutability)


        def resolve_body(statements: darray[Ast::Stmt], table: lmut SymbolTable, bound: mutable darray[sview]&, bound_mutability: mutable darray[bool]&) -> void:
            can Memory.Allocate, Abort.Panic:
                # Unreachable-code tracking: once a statement in THIS list unconditionally
                # exits it (`return`/`break`/`continue`), every following statement is dead.
                # Flag only the first such statement (a whole dead tail is one finding).
                terminated: mutable bool = false
                reported: mutable bool = false
                for statement in statements |table, bound, bound_mutability, terminated, reported|:
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UnreachableCode, name: "", line: statement_line(statement), expected: "", actual: ""}) if terminated and not reported and not statement_is_invalid(statement)
                    reported <- true if terminated and not reported and not statement_is_invalid(statement)
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- walk_expression(expression, table, bound, bound_mutability)
                            # An `is` refinement in a bare expression statement (e.g.
                            # `assert x is n`) keeps its binding for later statements —
                            # over-permissive, never a false unresolved.
                            gather_expression_bindings(expression, bound)
                            pad_bound_mutability(bound, bound_mutability)
                        Stmt.VarDecl(name, type_expression, value, line):
                            # The initializer resolves BEFORE the name binds (`x: T = x`
                            # is use-before-declaration, as in stage0).
                            table <- walk_expression(value, table, bound, bound_mutability)
                            gather_expression_bindings(value, bound)
                            pad_bound_mutability(bound, bound_mutability)
                            bound.push(name)
                            bound_mutability.push(type_is_mutable(type_expression))
                            table <- record_reference(table, line.line, name, false)
                        Stmt.Assign(target, operator, value, line):
                            table <- walk_expression(value, table, bound, bound_mutability)
                            gather_expression_bindings(value, bound)
                            pad_bound_mutability(bound, bound_mutability)
                            match target:
                                Expr.Array(elements, array_line):
                                    # Multi-target: `=` defines fresh idents; `<-`/compound
                                    # targets are references that must already resolve.
                                    for element in elements |table, bound, bound_mutability|:
                                        match element:
                                            Expr.Ident(element_name, ident_line):
                                                match operator:
                                                    TokenKind.Assign:
                                                        # A multi-target `=` is also what `rebind X: T, recv = …`
                                                        # lowers to (parser_stmt_control.elisa: any colon in the
                                                        # group selects `Assign`). Its colon-LESS targets RE-BIND
                                                        # an existing name — they claim a threaded `lmut` slot —
                                                        # so pushing them as fresh IMMUTABLE bindings shadowed the
                                                        # real entry, and `bound_name_is_mutable` (which scans
                                                        # backwards) then read the shadow. That reported E10 on
                                                        # every `while … |lexer|` after a `rebind`: 2855 false
                                                        # positives on the compiler's own source, where stage0
                                                        # reports none. Carry an existing binding's mutability
                                                        # forward; a genuinely fresh name is immutable as before.
                                                        # Computed BEFORE the push: bound_name_is_mutable
                                                        # indexes bound_mutability by bound's index, so
                                                        # reading after pushing only one of the two pools
                                                        # is an out-of-range read.
                                                        rebound_mutability: bool = bound_name_is_mutable(element_name, bound, bound_mutability) if name_known(table, bound, element_name) else false
                                                        bound.push(element_name)
                                                        bound_mutability.push(rebound_mutability)
                                                        table <- record_reference(table, ident_line.line, element_name, false)
                                                    _:
                                                        table <- walk_expression(element, table, bound, bound_mutability)
                                            _:
                                                table <- walk_expression(element, table, bound, bound_mutability)
                                Expr.Ident(target_name, target_line):
                                    table <- resolve_ident_assign_target(operator, target, target_name, target_line.line, line.line, bound, bound_mutability, table)
                                Expr.Call(callee, call_arguments, call_argument_names, call_line):
                                    # Assigning to a call result is never valid (stage0:
                                    # `invalid assignment target`). Still walk the call so
                                    # its own references resolve.
                                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.InvalidAssignTarget, name: "", line: line.line, expected: "", actual: ""})
                                    table <- walk_expression(target, table, bound, bound_mutability)
                                _:
                                    table <- walk_expression(target, table, bound, bound_mutability)
                        Stmt.If(condition, then_body, else_body, line):
                            # Gather the condition's `is`-bindings into scope BEFORE walking
                            # it, so a later conjunct of an `and`-chain can use a binding an
                            # earlier conjunct introduced (`a is E.A(m) and m == n`) — and so
                            # the same holds for a postfix guard `STMT if …is P(m)… and …m…`,
                            # which desugars to this If. The bindings stay scoped to the
                            # condition + then-body and are truncated before the else-body.
                            mark: usize = bound.count
                            mutability_mark: usize = bound_mutability.count
                            gather_expression_bindings(condition, bound)
                            gather_is_variant_aliases(condition, table.is_variant_alias_lines, table.is_variant_alias_names, bound)
                            pad_bound_mutability(bound, bound_mutability)
                            table <- walk_expression(condition, table, bound, bound_mutability)
                            table <- resolve_body(then_body, table, bound, bound_mutability)
                            bound.truncate(mark)
                            bound_mutability.truncate(mutability_mark)
                            table <- resolve_body(else_body, table, bound, bound_mutability)
                            bound.truncate(mark)
                            bound_mutability.truncate(mutability_mark)
                        Stmt.While(condition, body, line):
                            while_mark: usize = bound.count
                            while_mutability_mark: usize = bound_mutability.count
                            # As with `if`, bindings from an earlier `is` conjunct are
                            # visible to later conjuncts as well as the loop body.
                            gather_expression_bindings(condition, bound)
                            pad_bound_mutability(bound, bound_mutability)
                            table <- walk_expression(condition, table, bound, bound_mutability)
                            table.current_loop_depth <- table.current_loop_depth + 1
                            table <- resolve_body(body, table, bound, bound_mutability)
                            table.current_loop_depth <- table.current_loop_depth - 1
                            bound.truncate(while_mark)
                            bound_mutability.truncate(while_mutability_mark)
                        Stmt.For(bind, variables, iterable, body, line):
                            # `where PATTERN: GUARD` layers TWO Refinements over the iterable:
                            # the PATTERN inside, the GUARD outside. Peel both, so the base
                            # that gets walked as an expression is the real iterable -- walking
                            # a Refinement as one reported the loop variable undefined.
                            filter_expression: mutable Ast::Expr? = null
                            filter_guard: mutable Ast::Expr? = null
                            match iterable:
                                Expr.Refinement(filter_base, filter_predicate, filter_line):
                                    match filter_base:
                                        Expr.Refinement(inner_base, inner_predicate, inner_line):
                                            table <- walk_expression(inner_base, table, bound, bound_mutability)
                                            filter_expression <- inner_predicate
                                            filter_guard <- filter_predicate
                                        _:
                                            table <- walk_expression(filter_base, table, bound, bound_mutability)
                                            filter_expression <- filter_predicate
                                _:
                                    table <- walk_expression(iterable, table, bound, bound_mutability)
                            for_mark: usize = bound.count
                            for_mutability_mark: usize = bound_mutability.count
                            for variable in variables |table, bound, bound_mutability|:
                                bound.push(variable)
                                bound_mutability.push(bind == "mutable")
                                table <- record_reference(table, line.line, variable, false)
                            # A `where` filter may refine a loop variable with an `is`-pattern
                            # (`for item in xs where item is Expr.Int(value):`) — its payload
                            # bindings (`value`) are in scope for the loop body. Walk the filter,
                            # then gather its `is`/pattern bindings and keep bound_mutability in
                            # lockstep (pattern bindings are immutable).
                            filter_value: Ast::Expr = get filter_expression else (Ast::Expr.Invalid)
                            # A BARE pattern filter (`for x in xs where Enum.Variant(payload):`,
                            # no `x is` in front) is a PATTERN, not a predicate: `payload` is a
                            # binder it introduces, not a reference. Walking it as an ordinary
                            # expression reported `payload` undefined at the filter, and
                            # gather_expression_bindings then treated a Call's arguments as USES
                            # too -- so the body's `payload` was undefined as well and the whole
                            # function was rejected. Bind first and skip the walk for this shape.
                            #
                            # See is_bare_pattern_filter for why the shape test is narrow.
                            # The comprehension/query walker shares that same helper.
                            if is_bare_pattern_filter(filter_value):
                                gather_is_target(filter_value, bound)
                            else:
                                table <- walk_expression(filter_value, table, bound, bound_mutability)
                                gather_expression_bindings(filter_value, bound)
                            while bound_mutability.count < bound.count |bound_mutability|:
                                bound_mutability.push(false)
                            # The GUARD resolves in the PATTERN's scope -- `value > 2` after
                            # `item is Expr.Int(value)` -- so it is walked only now, with the
                            # pattern's bindings already in `bound`.
                            table <- walk_expression(guard_value, table, bound, bound_mutability) if filter_guard is guard_value
                            table.current_loop_depth <- table.current_loop_depth + 1
                            table <- resolve_body(body, table, bound, bound_mutability)
                            table.current_loop_depth <- table.current_loop_depth - 1
                            bound.truncate(for_mark)
                            bound_mutability.truncate(for_mutability_mark)
                        Stmt.Block(kind, clause, binding, body, line):
                            # Prefix blocks are NOT value scopes: a `static if/elif/else`
                            # branch is compile-time INCLUSION (exactly one branch's
                            # locals continue into the surrounding scope — see
                            # arena.elisa's per-backend `r:` declarations), and
                            # `can`/`trusted`/… are effect-grant wrappers. Bindings flow
                            # through un-truncated.
                            bound.push(binding) if binding != ""
                            bound_mutability.push(false) if binding != ""
                            table <- record_reference(table, line.line, binding, false) if binding != ""
                            for consumed_name in clause |table| -> table:
                                table <- walk_expression((Ast::Expr.Ident(consumed_name, line)), table, bound, bound_mutability) if kind == "destroy"
                            table <- resolve_body(body, table, bound, bound_mutability)
                        Stmt.Match(scrutinee, arms, line):
                            table <- walk_expression(scrutinee, table, bound, bound_mutability)
                            table <- check_unreachable_arms(arms, table, line.line)
                            for arm in arms |table, bound, bound_mutability|:
                                table <- check_pattern_variants(arm.pattern, table, line.line)
                                arm_mark: usize = bound.count
                                arm_mutability_mark: usize = bound_mutability.count
                                gather_pattern(arm.pattern, bound)
                                pad_bound_mutability(bound, bound_mutability)
                                # docs/122 §5.1: the arm guard resolves in the arm's
                                # pattern scope (walk_expression is a no-op on Invalid).
                                table <- walk_expression(arm.guard, table, bound, bound_mutability)
                                table <- resolve_body(arm.body, table, bound, bound_mutability)
                                bound.truncate(arm_mark)
                                bound_mutability.truncate(arm_mutability_mark)
                        Stmt.Return(value, line):
                            # `return get X else return Y`: the get-else recovery is itself a return,
                            # so stage0's flow analysis does NOT treat the outer return as an
                            # unconditional block terminator — following statements are not flagged
                            # unreachable. Mirror that by suppressing termination for this shape.
                            getelse_recovery_returns: mutable bool = false
                            if value is return_value:
                                table <- walk_expression(return_value, table, bound, bound_mutability)
                                match return_value:
                                    Expr.GetElse(guarded, recovery, getelse_line):
                                        getelse_recovery_returns <- flow_recovery_returns(recovery)
                                    _:
                                        pass
                            terminated <- true if not getelse_recovery_returns
                        Stmt.Contract(kind, expression, line):
                            # `result` is in scope for an `ensure` predicate and, via the
                            # higher-order `ensures(f, PRED)` builtin, inside PRED under any
                            # contract kind (`requires ensures(f, result >= 5)`).
                            binds_result: bool = kind == "ensure" or kind == "ensures" or expression_mentions_ensures(expression)
                            bound.push("result") if binds_result
                            bound_mutability.push(false) if binds_result
                            table <- walk_expression(expression, table, bound, bound_mutability)
                        Stmt.Invalid:
                            pass
                        Stmt.Break(label, line):
                            # A bare `break` at loop depth 0 is outside any loop.
                            # (`break if COND` desugars to `if COND: break` in the
                            # parser, so its Break is resolved at the current depth too.)
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.BreakOutsideLoop, name: "break", line: line.line, expected: "", actual: ""}) if table.current_loop_depth == 0
                            terminated <- true
                        Stmt.Continue(label, line):
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ContinueOutsideLoop, name: "continue", line: line.line, expected: "", actual: ""}) if table.current_loop_depth == 0
                            terminated <- true


        # Resolve identifiers in the VALUE positions of each statement (type annotations are
        # skipped). Recurses nested blocks and match arms. FLATTENED variant — used for
        # lambda bodies and expression-position match arms (small, pre-gathered scopes);
        # function bodies use the ordered `resolve_body` above.
        def walk_statements(statements: darray[Ast::Stmt], table: lmut SymbolTable, bound: darray[sview]&, bound_mutability: darray[bool]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table|:
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- walk_expression(expression, table, bound, bound_mutability)
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- walk_expression(value, table, bound, bound_mutability)
                        Stmt.Assign(target, operator, value, line):
                            # `<-` on a bare undeclared name is a distinct error from a
                            # plain undefined reference: it requires an EXISTING target.
                            # Report it specifically (and skip walking the target so the
                            # generic UndefinedName isn't also raised for the same token).
                            handled: mutable bool = false
                            if operator == TokenKind.LArrow:
                                match target:
                                    Expr.Ident(target_name, target_line):
                                        if not name_known(table, bound, target_name):
                                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AssignUndefinedTarget, name: target_name, line: line.line, expected: "", actual: ""})
                                            handled <- true
                                    _:
                                        pass
                            table <- walk_expression(target, table, bound, bound_mutability) if not handled
                            table <- walk_expression(value, table, bound, bound_mutability)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- walk_expression(condition, table, bound, bound_mutability)
                            table <- walk_statements(then_body, table, bound, bound_mutability)
                            table <- walk_statements(else_body, table, bound, bound_mutability)
                        Stmt.While(condition, body, line):
                            table <- walk_expression(condition, table, bound, bound_mutability)
                            table <- walk_statements(body, table, bound, bound_mutability)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- walk_expression(iterable, table, bound, bound_mutability)
                            table <- walk_statements(body, table, bound, bound_mutability)
                        Stmt.Return(value, line):
                            table <- walk_expression(return_value, table, bound, bound_mutability) if value is return_value
                        Stmt.Block(kind, clause, binding, body, line):
                            for consumed_name in clause |table| -> table:
                                table <- walk_expression((Ast::Expr.Ident(consumed_name, line)), table, bound, bound_mutability) if kind == "destroy"
                            # A block that introduces a handle binding (`with … as owner:`,
                            # `lock m as guard:`, `pool workers(N):`) makes it visible in the body.
                            block_scope: mutable darray[sview] = [scoped_name for scoped_name in bound]
                            block_mutability: mutable darray[bool] = [scoped_mut for scoped_mut in bound_mutability]
                            if binding != "":
                                block_scope.push(binding)
                                block_mutability.push(false)
                            table <- walk_statements(body, table, block_scope, block_mutability)
                        Stmt.Match(scrutinee, arms, line):
                            table <- walk_expression(scrutinee, table, bound, bound_mutability)
                            for arm in arms |table|:
                                table <- walk_statements(arm.body, table, bound, bound_mutability)
                        Stmt.Contract(kind, expression, line):
                            table <- walk_expression(expression, table, bound, bound_mutability)
                        # No value references to resolve. Explicit (no wildcard) so a new Stmt
                        # variant forces a decision here.
                        Stmt.Invalid:
                            pass
                        Stmt.Break(label, line):
                            pass
                        Stmt.Continue(label, line):
                            pass
