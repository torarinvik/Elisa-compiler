# Slicing a raw scalar reference (`p[a:b]` with `p: i64&`) has no bounds to build a view from.
# Stage0 rejects it; without this check stage1 lowers it to invalid LLVM IR. `u8&` has its own
# trusted-slice rule. Declared references only: anything else stays with the backend.

extend Semantic:
    private:
        # The element name of a declared `T&` / `mutable T&` over a builtin scalar, else "".
        def slice_raw_ref_element(expression: Ast::Expr) -> sview:
            can Abort.Panic:
                match expression:
                    Expr.Unary(operator, operand, unary_line):
                        return slice_raw_ref_element(operand) if operator == TokenKind.Mutable
                        if operator == TokenKind.Ampersand:
                            element: sview = bare_type_name(operand)
                            return element if element != "u8" and SemanticPrimitiveTypeName::is_builtin_scalar_type_name(element) else ""
                    _:
                        pass
                return ""

        def slice_raw_ref_is_mutable(expression: Ast::Expr) -> bool:
            can Abort.Panic:
                match expression:
                    Expr.Unary(operator, operand, unary_line):
                        return operator == TokenKind.Mutable
                    _:
                        return false

        # Record NAME, marking a mutable reference with a preceding "mutable" row.
        def note_slice_raw_ref(names: mutable darray[sview]&, types: mutable darray[sview @source]&, name: sview @source, type_expression: Ast::Expr) -> void:
            can Memory.Allocate, Abort.Panic:
                element: sview @source = slice_raw_ref_element(type_expression)
                note_local_type(names, types, name, "mutable") if element != "" and slice_raw_ref_is_mutable(type_expression)
                note_local_type(names, types, name, element)

        # Walk through expressions, checking for indexing of raw-reference scalar types.
        def walk_expression_for_slice_raw_ref(expression: Ast::Expr, table: lmut SymbolTable, var_types: mutable darray[sview]&, type_names: mutable darray[sview @source]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Binary(left, operator, right, line):
                        table <- walk_expression_for_slice_raw_ref(left, table, var_types, type_names)
                        table <- walk_expression_for_slice_raw_ref(right, table, var_types, type_names) if operator != TokenKind.Is and operator != TokenKind.As
                    Expr.Call(callee, arguments, argument_names, line):
                        table <- walk_expression_for_slice_raw_ref(callee, table, var_types, type_names)
                        for argument in arguments |table|:
                            table <- walk_expression_for_slice_raw_ref(argument, table, var_types, type_names)
                    Expr.Field(object, field, line):
                        table <- walk_expression_for_slice_raw_ref(object, table, var_types, type_names)
                    Expr.Scope(base, name, line):
                        table <- walk_expression_for_slice_raw_ref(base, table, var_types, type_names)
                    Expr.Index(object, index, line):
                        table <- walk_expression_for_slice_raw_ref(object, table, var_types, type_names)
                        table <- walk_expression_for_slice_raw_ref(index, table, var_types, type_names) if not index_receiver_is_type_application(object)
                    Expr.Unary(operator, operand, line):
                        table <- walk_expression_for_slice_raw_ref(operand, table, var_types, type_names)
                    Expr.Paren(inner, line):
                        table <- walk_expression_for_slice_raw_ref(inner, table, var_types, type_names)
                    Expr.Array(elements, line):
                        for element in elements |table|:
                            table <- walk_expression_for_slice_raw_ref(element, table, var_types, type_names)
                    Expr.Tuple(elements, line):
                        for element in elements |table|:
                            table <- walk_expression_for_slice_raw_ref(element, table, var_types, type_names)
                    Expr.Slice(object, low, high, line):
                        object_name: sview = ident_name_of(object)
                        last: mutable isize = var_types.count.isize() - 1
                        while last >= 0 and var_types[last.usize()] != object_name:
                            last <- last - 1
                        if object_name != "" and last >= 0 and type_names[last.usize()] != "":
                            mutable_ref: bool = last > 0 and var_types[(last - 1).usize()] == object_name and type_names[(last - 1).usize()] == "mutable"
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.SliceRawReference, name: "", pos: line, line: line.line, expected: "mutable " if mutable_ref else "", actual: type_names[last.usize()]})
                        table <- walk_expression_for_slice_raw_ref(object, table, var_types, type_names)
                        table <- walk_expression_for_slice_raw_ref(low, table, var_types, type_names)
                        table <- walk_expression_for_slice_raw_ref(high, table, var_types, type_names)
                    Expr.IndexN(object, arguments, line):
                        table <- walk_expression_for_slice_raw_ref(object, table, var_types, type_names)
                        for argument in arguments |table|:
                            table <- walk_expression_for_slice_raw_ref(argument, table, var_types, type_names) if not index_receiver_is_type_application(object)
                    Expr.SetLit(elements, line):
                        for element in elements |table|:
                            table <- walk_expression_for_slice_raw_ref(element, table, var_types, type_names)
                    Expr.DictLit(entries, line):
                        for entry in entries |table|:
                            table <- walk_expression_for_slice_raw_ref(entry.key, table, var_types, type_names)
                            table <- walk_expression_for_slice_raw_ref(entry.value, table, var_types, type_names)
                    Expr.Construct(type_expression, fields, line):
                        table <- walk_expression_for_slice_raw_ref(type_expression, table, var_types, type_names)
                        for field in fields |table|:
                            table <- walk_expression_for_slice_raw_ref(field.value, table, var_types, type_names)
                    Expr.RecordUpdate(base, fields, line):
                        table <- walk_expression_for_slice_raw_ref(base, table, var_types, type_names)
                        for field in fields |table|:
                            table <- walk_expression_for_slice_raw_ref(field.value, table, var_types, type_names)
                    Expr.If(condition, then_expr, else_expr, line):
                        table <- walk_expression_for_slice_raw_ref(condition, table, var_types, type_names)
                        table <- walk_expression_for_slice_raw_ref(then_expr, table, var_types, type_names)
                        table <- walk_expression_for_slice_raw_ref(else_expr, table, var_types, type_names)
                    Expr.Comprehension(loop_variable, iterable, condition, body, line, _):
                        table <- walk_expression_for_slice_raw_ref(iterable, table, var_types, type_names)
                        table <- walk_expression_for_slice_raw_ref(condition, table, var_types, type_names)
                        table <- walk_expression_for_slice_raw_ref(body, table, var_types, type_names)
                    Expr.Lambda(parameters, body, line):
                        table <- walk_statements_for_slice_raw_ref(body, table, var_types, type_names)
                    Expr.Block(statements, value, captures, line):
                        table <- walk_statements_for_slice_raw_ref(statements, table, var_types, type_names)
                        table <- walk_expression_for_slice_raw_ref(value, table, var_types, type_names)
                    Expr.Match(scrutinee, arms, line):
                        table <- walk_expression_for_slice_raw_ref(scrutinee, table, var_types, type_names)
                        for arm in arms |table|:
                            table <- walk_statements_for_slice_raw_ref(arm.body, table, var_types, type_names)
                    # Literals and other expressions don't contain relevant sub-expressions
                    _:
                        pass

        # Walk through statements, tracking variable types and checking for raw-reference indexing.
        def walk_statements_for_slice_raw_ref(statements: darray[Ast::Stmt], table: lmut SymbolTable, var_types: mutable darray[sview]&, type_names: mutable darray[sview @source]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table|:
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- walk_expression_for_slice_raw_ref(expression, table, var_types, type_names)
                        Stmt.VarDecl(name, type_expression, value, line):
                            # Record the type for this variable
                            note_slice_raw_ref(var_types, type_names, name, type_expression)
                            table <- walk_expression_for_slice_raw_ref(value, table, var_types, type_names)
                        Stmt.Assign(target, operator, value, line):
                            table <- walk_expression_for_slice_raw_ref(target, table, var_types, type_names)
                            table <- walk_expression_for_slice_raw_ref(value, table, var_types, type_names)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- walk_expression_for_slice_raw_ref(condition, table, var_types, type_names)
                            table <- walk_statements_for_slice_raw_ref(then_body, table, var_types, type_names)
                            table <- walk_statements_for_slice_raw_ref(else_body, table, var_types, type_names)
                        Stmt.While(condition, body, line):
                            table <- walk_expression_for_slice_raw_ref(condition, table, var_types, type_names)
                            table <- walk_statements_for_slice_raw_ref(body, table, var_types, type_names)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- walk_expression_for_slice_raw_ref(iterable, table, var_types, type_names)
                            table <- walk_statements_for_slice_raw_ref(body, table, var_types, type_names)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- walk_statements_for_slice_raw_ref(body, table, var_types, type_names)
                        Stmt.Match(scrutinee, arms, line):
                            table <- walk_expression_for_slice_raw_ref(scrutinee, table, var_types, type_names)
                            for arm in arms |table|:
                                table <- walk_expression_for_slice_raw_ref(arm.guard, table, var_types, type_names)
                                table <- walk_statements_for_slice_raw_ref(arm.body, table, var_types, type_names)
                        Stmt.Return(value, line):
                            table <- walk_expression_for_slice_raw_ref(return_value, table, var_types, type_names) if value is return_value
                        Stmt.Contract(kind, expression, line):
                            table <- walk_expression_for_slice_raw_ref(expression, table, var_types, type_names)
                        Stmt.Invalid:
                            pass
                        Stmt.Break(label, line):
                            pass
                        Stmt.Continue(label, line):
                            pass

        # Walk through function declarations.
        def check_slice_raw_ref_declarations(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table|:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            # Create fresh type tracking for this function
                            var_types: mutable darray[sview] = []
                            type_names: mutable darray[sview @source] = []
                            # Record parameter types
                            for param in params |table|:
                                note_slice_raw_ref(var_types, type_names, param.name, param.type_expression)
                            # Walk the function body
                            table <- walk_statements_for_slice_raw_ref(body, table, var_types, type_names)
                        Decl.Module(module_name, body, line):
                            table <- check_slice_raw_ref_declarations(body, table)
                        Decl.Scoped(body, line):
                            table <- check_slice_raw_ref_declarations(body, table)
                        _:
                            pass

    public:
        # Public entry point for the check.
        def check_slice_raw_ref(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- check_slice_raw_ref_declarations(declarations, table)
