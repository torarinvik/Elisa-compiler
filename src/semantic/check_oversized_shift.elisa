# Check for oversized shifts: x << 64, x >> 100, x << -1.
# A shift by a constant >= 64 or < 0 is always invalid (Elisa's widest integer is 64 bits).

extend Semantic:
    private:
        # Walk through all expressions, checking for Binary operations with oversized shift counts.
        def walk_expression_for_oversized_shift(expression: Ast::Expr, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Binary(left, operator, right, line):
                        # Check for oversized shifts: only flag LShift or RShift with IntLit(v) where v >= 64.
                        # Negative counts (Unary(Minus, IntLit)) belong to NegativeShift — one
                        # diagnostic per site, not two.
                        # Each `is`-binding is used only inside a nested body — stage1's
                        # resolver does not carry an `is`-binding into the rest of the SAME
                        # boolean condition, so `right is IntLit(v) and v >= 64` would leave
                        # `v` unresolved. Nest instead.
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.OversizedShift, name: "", line: line, expected: "", actual: ""}) if (operator == TokenKind.LShift or operator == TokenKind.RShift) and right is Expr.IntLit(shift_count) and (shift_count >= 64 or shift_count < 0)
                        # Recursively walk left and right operands
                        table <- walk_expression_for_oversized_shift(left, table)
                        table <- walk_expression_for_oversized_shift(right, table) if operator != TokenKind.Is and operator != TokenKind.As
                    Expr.Call(callee, arguments, argument_names, line):
                        table <- walk_expression_for_oversized_shift(callee, table)
                        for argument in arguments |table| -> table:
                            table <- walk_expression_for_oversized_shift(argument, table)
                    Expr.Field(object, field, line):
                        table <- walk_expression_for_oversized_shift(object, table)
                    Expr.Scope(base, name, line):
                        table <- walk_expression_for_oversized_shift(base, table)
                    Expr.Index(object, index, line):
                        table <- walk_expression_for_oversized_shift(object, table)
                        table <- walk_expression_for_oversized_shift(index, table) if not index_receiver_is_type_application(object)
                    Expr.Unary(operator, operand, line):
                        table <- walk_expression_for_oversized_shift(operand, table)
                    Expr.Paren(inner, line):
                        table <- walk_expression_for_oversized_shift(inner, table)
                    Expr.Array(elements, line):
                        for element in elements |table| -> table:
                            table <- walk_expression_for_oversized_shift(element, table)
                    Expr.Tuple(elements, line):
                        for element in elements |table| -> table:
                            table <- walk_expression_for_oversized_shift(element, table)
                    Expr.Slice(object, low, high, line):
                        table <- walk_expression_for_oversized_shift(object, table)
                        table <- walk_expression_for_oversized_shift(low, table)
                        table <- walk_expression_for_oversized_shift(high, table)
                    Expr.IndexN(object, arguments, line):
                        table <- walk_expression_for_oversized_shift(object, table)
                        if not index_receiver_is_type_application(object):
                            for argument in arguments |table| -> table:
                                table <- walk_expression_for_oversized_shift(argument, table)
                    Expr.SetLit(elements, line):
                        for element in elements |table| -> table:
                            table <- walk_expression_for_oversized_shift(element, table)
                    Expr.DictLit(entries, line):
                        for entry in entries |table| -> table:
                            table <- walk_expression_for_oversized_shift(entry.key, table)
                            table <- walk_expression_for_oversized_shift(entry.value, table)
                    Expr.Construct(type_expression, fields, line):
                        table <- walk_expression_for_oversized_shift(type_expression, table)
                        for field in fields |table| -> table:
                            table <- walk_expression_for_oversized_shift(field.value, table)
                    Expr.RecordUpdate(base, fields, line):
                        table <- walk_expression_for_oversized_shift(base, table)
                        for field in fields |table| -> table:
                            table <- walk_expression_for_oversized_shift(field.value, table)
                    Expr.If(condition, then_expr, else_expr, line):
                        table <- walk_expression_for_oversized_shift(condition, table)
                        table <- walk_expression_for_oversized_shift(then_expr, table)
                        table <- walk_expression_for_oversized_shift(else_expr, table)
                    Expr.Comprehension(loop_variable, iterable, condition, body, line):
                        table <- walk_expression_for_oversized_shift(iterable, table)
                        table <- walk_expression_for_oversized_shift(condition, table)
                        table <- walk_expression_for_oversized_shift(body, table)
                    Expr.Lambda(parameters, body, line):
                        table <- walk_statements_for_oversized_shift(body, table)
                    Expr.Block(statements, value, captures, line):
                        table <- walk_statements_for_oversized_shift(statements, table)
                        table <- walk_expression_for_oversized_shift(value, table)
                    Expr.Match(scrutinee, arms, line):
                        table <- walk_expression_for_oversized_shift(scrutinee, table)
                        for arm in arms |table| -> table:
                            table <- walk_statements_for_oversized_shift(arm.body, table)
                    # Literals and other expression forms don't contain sub-expressions
                    _:
                        pass


        # Walk through statements, checking for oversized shifts in expressions.
        def walk_statements_for_oversized_shift(statements: darray[Ast::Stmt], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table|:
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- walk_expression_for_oversized_shift(expression, table)
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- walk_expression_for_oversized_shift(value, table)
                        Stmt.Assign(target, operator, value, line):
                            table <- walk_expression_for_oversized_shift(target, table)
                            table <- walk_expression_for_oversized_shift(value, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- walk_expression_for_oversized_shift(condition, table)
                            table <- walk_statements_for_oversized_shift(then_body, table)
                            table <- walk_statements_for_oversized_shift(else_body, table)
                        Stmt.While(condition, body, line):
                            table <- walk_expression_for_oversized_shift(condition, table)
                            table <- walk_statements_for_oversized_shift(body, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- walk_expression_for_oversized_shift(iterable, table)
                            table <- walk_statements_for_oversized_shift(body, table)
                        Stmt.Return(value, line):
                            table <- walk_expression_for_oversized_shift(return_value, table) if value is return_value
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- walk_statements_for_oversized_shift(body, table)
                        Stmt.Match(scrutinee, arms, line):
                            table <- walk_expression_for_oversized_shift(scrutinee, table)
                            for arm in arms |table|:
                                table <- walk_statements_for_oversized_shift(arm.body, table)
                        Stmt.Contract(kind, expression, line):
                            table <- walk_expression_for_oversized_shift(expression, table)
                        # No expressions in these statements
                        Stmt.Break(label, line):
                            pass
                        Stmt.Continue(label, line):
                            pass
                        Stmt.Invalid:
                            pass


        # Walk through function declarations, checking expressions in their bodies.
        def check_oversized_shift(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table|:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            table <- walk_statements_for_oversized_shift(body, table)
                        Decl.Module(module_name, body, line):
                            table <- check_oversized_shift(body, table)
                        Decl.Scoped(body, line):
                            table <- check_oversized_shift(body, table)
                        # Other declarations don't have bodies to check
                        _:
                            pass
