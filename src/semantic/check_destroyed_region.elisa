extend Semantic:
    private:
        const NO_REGION_BINDING: u32 = 0
        const DESTROYED_REGION_ALL: u32 = 0
        const NO_ARENA_SUMMARY_PARAM: u32 = 4294967295
        const NO_ARENA_SUMMARY_EFFECT: u32 = 4294967294
        const UNKNOWN_REGION_DEPENDENCY: u32 = 4294967293
        const UNKNOWN_LAMBDA_DEPENDENCY: u32 = 4294967294
        const DESTROYED_REFERENCE_NAME_SET_THRESHOLD: usize = 8

        # RegionBindingId is the one-based row of its lexical binder in the parser side table.
        # Region spelling is for diagnostics only: two simultaneously-live binders named `r`
        # must not share invalidation facts.
        def destroyed_region_id_contains(regions: darray[u32]&, candidate: u32) -> bool:
            return false if candidate == NO_REGION_BINDING
            return true if candidate == UNKNOWN_REGION_DEPENDENCY and regions.count > 0
            for region in regions:
                return true if region == candidate or region == DESTROYED_REGION_ALL
            return false

        # Storage-stability analysis still uses strategy/source-name sets; its binder-ID
        # migration is separate from destroyed-region invalidation.
        def destroyed_region_contains(regions: darray[sview]&, candidate: sview) -> bool:
            for region in regions:
                return true if region == candidate
            return false

        def region_binding_id_at(annotations: darray[Ast::LocalRegionAnnotation]&, region: sview, function_line: u32, use_line: u32, use_offset: u32 = 0, use_offset_known: bool = false) -> u32:
            can Abort.Panic:
                found: mutable u32 = NO_REGION_BINDING
                found_offset: mutable u32 = 0
                # Exact source intervals are authoritative across #line resets. The
                # explicit presence bit keeps a valid byte-zero owner distinct from a
                # legacy query that has no source position.
                window_high: u32 = use_line if use_line > function_line else function_line
                window_start: usize = 0 if use_offset_known else (region_annotation_window_start(annotations, function_line) can Global{Read,Write})
                window_end: usize = annotations.count if use_offset_known else (region_annotation_window_end(annotations, window_high) can Global{Read,Write})
                for annotation_index in window_start..<window_end |found, found_offset, annotations, region, function_line, use_line, use_offset, use_offset_known|:
                    annotation: Ast::LocalRegionAnnotation = annotations[annotation_index]
                    has_source_interval: bool = use_offset_known and annotation.owner_offset <= use_offset and (annotation.end_offset == 0 or use_offset < annotation.end_offset)
                    is_function_param: bool = annotation.name == "__region_param" and (has_source_interval or (not use_offset_known and annotation.line == function_line))
                    is_open_region: bool = annotation.name == "__region_local" and (has_source_interval or (not use_offset_known and annotation.line >= function_line and annotation.line <= use_line and (annotation.end_line == 0 or use_line <= annotation.end_line)))
                    # Arena-local aliases are bounded to their containing parser block,
                    # just like region-block binders are bounded to the block they own.
                    # Source intervals remain ordered across #line resets, and choosing
                    # the latest active binder keeps a closed inner owner from masking a
                    # still-live outer owner with the same spelling.
                    is_arena_owner: bool = annotation.name == "__region_arena_local" and (has_source_interval or (not use_offset_known and annotation.line >= function_line and annotation.line <= use_line and annotation.end_line > 0 and use_line <= annotation.end_line))
                    candidate_offset: u32 = annotation.owner_offset if use_offset_known else annotation.line
                    if annotation.region == region and (is_function_param or is_open_region or is_arena_owner) and candidate_offset >= found_offset:
                        found_offset <- candidate_offset
                        found <- (annotation_index + 1).u32()
                return found


        # Arena handles are copyable references to the same backing arena. Keep one
        # binder-to-root row per possible owner for simple local aliases, so reset/free
        # through any alias invalidates views tied to every possible backing arena.
        def destroyed_collect_owner_alias_roots(binding_id: u32, alias_ids: darray[u32]&, alias_roots: darray[u32]&, out: mutable darray[u32]&) -> void:
            can Memory.Allocate, Abort.Panic:
                if alias_ids.count != alias_roots.count:
                    out.push(DESTROYED_REGION_ALL) if not any existing in out where existing == DESTROYED_REGION_ALL
                    return
                found: mutable bool = false
                for alias_index in 0..<alias_ids.count |alias_ids, alias_roots, binding_id, out, found|:
                    if alias_ids[alias_index] == binding_id:
                        found <- true
                        if alias_index >= alias_roots.count:
                            out.push(DESTROYED_REGION_ALL) if not any existing in out where existing == DESTROYED_REGION_ALL
                            return
                        candidate: u32 = alias_roots[alias_index]
                        out.push(candidate) if not any existing in out where existing == candidate
                if not found:
                    out.push(binding_id) if not any existing in out where existing == binding_id


        def destroyed_append_owner_alias_root(binding_id: u32, root_id: u32, destroyed: mutable darray[u32]&, alias_ids: mutable darray[u32]&, alias_roots: mutable darray[u32]&) -> void:
            can Memory.Allocate, Abort.Panic:
                if alias_ids.count != alias_roots.count:
                    destroyed_push_all(destroyed)
                    return
                for alias_index in 0..<alias_ids.count |alias_ids, alias_roots, binding_id, root_id|:
                    return if alias_ids[alias_index] == binding_id and alias_roots[alias_index] == root_id
                alias_ids.push(binding_id)
                alias_roots.push(root_id)


        def destroyed_copy_owner_alias_roots(source_ids: darray[u32]&, source_roots: darray[u32]&, destroyed: mutable darray[u32]&, out_ids: mutable darray[u32]&, out_roots: mutable darray[u32]&) -> void:
            can Memory.Allocate, Abort.Panic:
                if source_ids.count != source_roots.count:
                    destroyed_push_all(destroyed)
                    for binding_id in source_ids:
                        destroyed_append_owner_alias_root(binding_id, DESTROYED_REGION_ALL, destroyed, out_ids, out_roots)
                    return
                for alias_index in 0..<source_ids.count |source_ids, source_roots, destroyed, out_ids, out_roots|:
                    destroyed_append_owner_alias_root(source_ids[alias_index], source_roots[alias_index], destroyed, out_ids, out_roots)


        def destroyed_match_arm_is_unguarded_catchall(arm: Ast::MatchArm) -> bool:
            can Memory.Allocate, Abort.Panic:
                return false if not (arm.guard is Ast::Expr.Absent)
                return match arm.pattern:
                    Pattern.Wildcard: true
                    Pattern.Binding(_): true
                    _: false

        # A state mutation in an arm that cannot reach the join must not leak into
        # the continuation after the match. Keep this deliberately conservative:
        # only an explicit return (possibly after a nested block) proves that an arm
        # does not fall through. Conditional termination is left as fall-through so
        # this helper cannot hide a real destroyed-region use.
        def destroyed_statements_terminate(statements: darray[Ast::Stmt]) -> bool:
            can Abort.Panic:
                for statement in statements:
                    match statement:
                        Stmt.Return(value, line):
                            return true
                        Stmt.Block(kind, clause, binding, body, line):
                            return true if destroyed_statements_terminate(body)
                        _:
                            pass
                return false


        def destroyed_arena_owner_source_name(expression: Ast::Expr) -> sview:
            can Memory.Allocate, Abort.Panic:
                return match expression:
                    Expr.Ident(name, line): name
                    Expr.Paren(inner, line) | Expr.Move(inner, line): destroyed_arena_owner_source_name(inner)
                    Expr.Unary(operator, operand, line):
                        return destroyed_arena_owner_source_name(operand) if operator == TokenKind.Ampersand
                        sview("", 0, 0)
                    Expr.Call(callee, arguments, argument_names, line):
                        match callee:
                            Expr.Field(receiver, method, field_line):
                                if method == "cast":
                                    return destroyed_arena_owner_source_name(receiver)
                                return sview("", 0, 0)
                            _:
                                sview("", 0, 0)
                    _:
                        sview("", 0, 0)


        def destroyed_type_is_arena_reference(type_expression: Ast::Expr) -> bool:
            can Abort.Panic:
                return match type_expression:
                    Expr.Unary(operator, operand, line):
                        return destroyed_type_is_arena_reference(operand) if operator == TokenKind.Mutable or operator == TokenKind.Lmut
                        return false if operator != TokenKind.Ampersand
                        return match operand:
                            Expr.Ident(name, type_line): name == "Arena"
                            Expr.Paren(inner, paren_line): destroyed_type_is_arena_reference(inner)
                            _: false
                    Expr.Paren(inner, line): destroyed_type_is_arena_reference(inner)
                    _: false


        def destroyed_type_is_callable_value(type_expression: Ast::Expr) -> bool:
            can Abort.Panic:
                return match type_expression:
                    # A function type is represented by a Lambda with no body; a lambda
                    # value has a nonempty body after expression-body normalization.
                    Expr.Lambda(parameters, body, line): body.count == 0
                    Expr.Paren(inner, line) | Expr.Refinement(inner, _, line) | Expr.Unary(_, inner, line): destroyed_type_is_callable_value(inner)
                    _: false


        def destroyed_type_is_callable_binding(type_expression: Ast::Expr, table: SymbolTable&) -> bool:
            can Abort.Panic:
                return match type_expression:
                    Expr.Ident(name, line): destroyed_type_is_callable_value(type_expression) or any alias_name in table.fn_alias_names where alias_name == name
                    Expr.Scope(_, name, line): any alias_name in table.fn_alias_names where alias_name == name
                    Expr.Paren(inner, line) | Expr.Refinement(inner, _, line) | Expr.Unary(_, inner, line): destroyed_type_is_callable_binding(inner, table)
                    _: destroyed_type_is_callable_value(type_expression)


        def destroyed_is_generated_effect_call(name: sview) -> bool:
            can Abort.Panic:
                return true if:
                    name.len >= 10.usize() and name[0:10] == "__effect__"
                    name.len >= 11.usize() and name[0:11] == "__handler__"
                return false


        # Generic direct calls retain their type application in the callee AST
        # (`reset[T](...)` is IndexN(Ident("reset"), ...)). Recover only the
        # statically named direct-call forms used by the summary table. Generated
        # handler clones may be qualified Scope nodes, so admit those private names
        # as well; ordinary qualified methods remain outside this summary namespace.
        def destroyed_direct_call_name(callee: Ast::Expr) -> sview:
            can Abort.Panic:
                match callee:
                    Expr.Ident(name, line): return name
                    Expr.Index(base, _, line) | Expr.IndexN(base, _, line) | Expr.Paren(base, line) | Expr.Move(base, line): return destroyed_direct_call_name(base)
                    Expr.Scope(_, name, line):
                        return name
                    _:
                        return ""


        # The module path a qualified call names, or false when the call must stay opaque.
        # Callers match it against the full module owner recorded on a summary with
        # module_symbol_matches. Do not reduce paths to a basename: aliases and same-leaf
        # modules must not share effects; unresolved aliases fail that comparison and remain
        # opaque. The path depends only on the callee, so a caller testing many summary rows
        # computes it once (the alias scan below walks every row; doing it per row was
        # quadratic in the summary count). A statement `match` (not `return match`): the
        # arm's local path arrays need a region, which an expression arm cannot give them.
        def destroyed_direct_call_module_path(callee: Ast::Expr, summary_names: darray[sview]&, summary_formals: darray[sview]&, summary_row_heads: dict[u64, u32]&, summary_row_next: darray[u32]&, module_names: mutable darray[sview]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                match callee:
                    Expr.Scope(scope_base, _, _):
                        module_dotted: mutable darray[bool] = []
                        return false if not type_path_collect(scope_base, module_names, module_dotted) or module_names.count == 0 or (any separator_is_dot in module_dotted where separator_is_dot)
                        # Alias facts are represented as reserved rows in the summary table.
                        # The AST keeps the source spelling (for example `Quiet::touch`),
                        # while a summary owner uses its declared target (`Other`). Never
                        # let an alias spelling borrow an unrelated same-named module's
                        # summary. Until this pass carries lexical alias resolution, keep
                        # such calls opaque rather than guessing their target.
                        if summary_row_next.count == summary_names.count:
                            # Only the alias rows can answer: walk their chain.
                            chain_row: mutable u32 = destroyed_summary_first_row(summary_row_heads, "__destroyed_region_module_alias__")
                            while chain_row != SYMBOL_INDEX_ROW_NONE |chain_row, module_names, summary_names, summary_formals, summary_row_next|:
                                alias_row: usize = chain_row.usize()
                                chain_row <- summary_row_next[alias_row]
                                if summary_names[alias_row] == "__destroyed_region_module_alias__" and alias_row * 2 < summary_formals.count and summary_formals[alias_row * 2] == module_names[0]:
                                    return false
                            return true
                        for alias_row in 0..<summary_names.count |module_names, summary_names, summary_formals|:
                            if summary_names[alias_row] == "__destroyed_region_module_alias__" and alias_row * 2 < summary_formals.count and summary_formals[alias_row * 2] == module_names[0]:
                                return false
                        return true
                    Expr.Index(base, _, _) | Expr.IndexN(base, _, _) | Expr.Paren(base, _) | Expr.Move(base, _):
                        return destroyed_direct_call_module_path(base, summary_names, summary_formals, summary_row_heads, summary_row_next, module_names)
                    _:
                        return false


        # Summary rows by name: (name hash -> first/last row) plus a per-row next link, so
        # each chain lists its rows in ascending order. Every summary consumer used to scan
        # all rows per call site (rows ~ functions in the unit, so quadratic per pass);
        # following the chain visits exactly the rows a full scan would act on, in the same
        # order. A chain may hold other names with the same hash: callers still compare names.
        def destroyed_summary_index_push(name: sview, row: usize, summary_row_heads: mutable dict[u64, u32]&, summary_row_tails: mutable dict[u64, u32]&, summary_row_next: mutable darray[u32]&) -> void:
            can Memory.Allocate, Abort.Panic:
                hash: u64 = name_hash(name)
                summary_row_next.push(SYMBOL_INDEX_ROW_NONE)
                tail_row: u32 = found_tail if summary_row_tails.get(hash) is found_tail else SYMBOL_INDEX_ROW_NONE
                if tail_row != SYMBOL_INDEX_ROW_NONE:
                    summary_row_next[tail_row.usize()] <- row.u32()
                else:
                    summary_row_heads <- summary_row_heads.put(hash, row.u32()) can Global{Read,Write}
                summary_row_tails <- summary_row_tails.put(hash, row.u32()) can Global{Read,Write}

        def destroyed_summary_first_row(summary_row_heads: dict[u64, u32]&, name: sview) -> u32:
            can Abort.Panic:
                return head if summary_row_heads.get(name_hash(name)) is head else SYMBOL_INDEX_ROW_NONE


        def destroyed_direct_call_is_qualified(callee: Ast::Expr) -> bool:
            can Abort.Panic:
                return match callee:
                    Expr.Scope(_, _, _): true
                    Expr.Index(base, _, _) | Expr.IndexN(base, _, _) | Expr.Paren(base, _) | Expr.Move(base, _):
                        destroyed_direct_call_is_qualified(base)
                    _: false


        def destroyed_push_region_id(destroyed: mutable darray[u32]&, region_id: u32) -> void:
            can Memory.Allocate, Abort.Panic:
                destroyed.push(region_id) if not any existing in destroyed where existing == region_id


        def destroyed_region_binding_is_generic(binding_id: u32, annotations: darray[Ast::LocalRegionAnnotation]&) -> bool can[Abort.Panic]:
            return binding_id > 0 and binding_id.usize() <= annotations.count and annotations[(binding_id - 1).usize()].name == "__region_param"


        def destroyed_mark_function_generic_regions(destroyed: mutable darray[u32]&, annotations: darray[Ast::LocalRegionAnnotation]&, function_offset: u32) -> void:
            can Memory.Allocate, Abort.Panic:
                for annotation_index in 0..<annotations.count |destroyed, annotations, function_offset|:
                    annotation: Ast::LocalRegionAnnotation = annotations[annotation_index]
                    if annotation.name == "__region_param" and annotation.owner_offset == function_offset:
                        destroyed_push_region_id(destroyed, (annotation_index + 1).u32())


        def destroyed_mark_region_binding(destroyed: mutable darray[u32]&, binding_id: u32, alias_ids: darray[u32]&, alias_roots: darray[u32]&, annotations: darray[Ast::LocalRegionAnnotation]&, function_line: u32) -> void:
            can Memory.Allocate, Abort.Panic:
                if alias_ids.count != alias_roots.count:
                    destroyed_push_all(destroyed)
                    return
                if binding_id == NO_REGION_BINDING:
                    destroyed_push_all(destroyed)
                    return
                found_alias: mutable bool = false
                aliases_generic_region: mutable bool = destroyed_region_binding_is_generic(binding_id, annotations)
                generic_owner_offset: mutable u32 = annotations[(binding_id - 1).usize()].owner_offset if aliases_generic_region else 0
                for alias_index in 0..<alias_ids.count |destroyed, alias_ids, alias_roots, binding_id, found_alias|:
                    if alias_ids[alias_index] == binding_id:
                        found_alias <- true
                        if alias_index >= alias_roots.count:
                            destroyed_push_all(destroyed)
                            return
                        root_id: u32 = alias_roots[alias_index]
                        if root_id == DESTROYED_REGION_ALL:
                            destroyed_push_all(destroyed)
                            return
                        if destroyed_region_binding_is_generic(root_id, annotations):
                            aliases_generic_region <- true
                            generic_owner_offset <- annotations[(root_id - 1).usize()].owner_offset
                        else:
                            destroyed_push_region_id(destroyed, root_id)
                        for related_alias_index in 0..<alias_ids.count |destroyed, alias_ids, alias_roots, root_id|:
                            if related_alias_index < alias_roots.count and alias_roots[related_alias_index] == root_id:
                                destroyed_push_region_id(destroyed, alias_ids[related_alias_index])
                if aliases_generic_region:
                    can Global{Read,Write}:
                        destroyed_mark_function_generic_regions(destroyed, annotations, generic_owner_offset)
                destroyed_push_region_id(destroyed, binding_id) if not found_alias


        def destroyed_push_all(destroyed: mutable darray[u32]&) -> void:
            can Memory.Allocate, Abort.Panic:
                destroyed.push(DESTROYED_REGION_ALL) if not any existing in destroyed where existing == DESTROYED_REGION_ALL


        # Mutable Arena& locals can change which arena they designate. Replace the
        # binding's summary row on assignment; retaining its initializer root makes a
        # later reset invalidate the old arena and miss the actual target.
        def destroyed_set_arena_owner_alias(binding_id: u32, root_id: u32, destroyed: mutable darray[u32]&, alias_ids: mutable darray[u32]&, alias_roots: mutable darray[u32]&) -> void:
            can Memory.Allocate, Abort.Panic:
                if alias_ids.count != alias_roots.count:
                    destroyed_push_all(destroyed)
                    return
                found: mutable bool = false
                for alias_index in 0..<alias_ids.count |alias_ids, alias_roots, binding_id, root_id, destroyed|:
                    if alias_ids[alias_index] == binding_id:
                        found <- true
                        if alias_index < alias_roots.count:
                            alias_roots[alias_index] <- root_id
                        else:
                            # The parallel summary tables lost their structural
                            # correspondence. Do not trust any owner-specific result.
                            destroyed_push_all(destroyed)
                            return
                if not found:
                    alias_ids.push(binding_id)
                    alias_roots.push(root_id)


        def destroyed_add_arena_owner_alias_root(binding_id: u32, root_id: u32, destroyed: mutable darray[u32]&, alias_ids: mutable darray[u32]&, alias_roots: mutable darray[u32]&) -> void:
            can Memory.Allocate, Abort.Panic:
                if alias_ids.count != alias_roots.count:
                    destroyed_push_all(destroyed)
                    return
                for alias_index in 0..<alias_ids.count |alias_ids, alias_roots, binding_id, root_id, destroyed|:
                    if alias_ids[alias_index] == binding_id:
                        if alias_index >= alias_roots.count:
                            destroyed_push_all(destroyed)
                            return
                        return if alias_roots[alias_index] == root_id
                alias_ids.push(binding_id)
                alias_roots.push(root_id)


        def destroyed_rebind_arena_owner_alias(name: sview, value: Ast::Expr, annotations: darray[Ast::LocalRegionAnnotation]&, function_line: u32, position: Ast::Pos, branch_sensitive: bool, destroyed: mutable darray[u32]&, alias_ids: mutable darray[u32]&, alias_roots: mutable darray[u32]&) -> void:
            can Memory.Allocate, Abort.Panic:
                binding_id: u32 = region_binding_id_at(annotations, name, function_line, position.line, position.offset, true) can Global{Read,Write}
                return if binding_id == NO_REGION_BINDING or binding_id.usize() > annotations.count
                owner_annotation: Ast::LocalRegionAnnotation = annotations[(binding_id - 1).usize()]
                return if owner_annotation.name != "__region_arena_local" or owner_annotation.owner_offset >= position.offset
                source_name: sview = destroyed_arena_owner_source_name(value)
                roots: mutable darray[u32] = []
                if source_name != "":
                    target_id: mutable u32 = region_binding_id_at(annotations, source_name, function_line, position.line, position.offset, true) can Global{Read,Write}
                    if target_id == NO_REGION_BINDING:
                        target_annotation: Ast::LocalRegionAnnotation? = local_region_annotation_of(annotations, source_name, position.line, position.offset, true)
                        if target_annotation is target_region and target_region.region != "":
                            target_id <- region_binding_id_at(annotations, target_region.region, function_line, position.line, position.offset, true) can Global{Read,Write}
                    if target_id != NO_REGION_BINDING:
                        destroyed_collect_owner_alias_roots(target_id, alias_ids, alias_roots, roots)
                if roots.count == 0:
                    roots.push(DESTROYED_REGION_ALL)
                if branch_sensitive:
                    for root_id in roots:
                        destroyed_add_arena_owner_alias_root(binding_id, root_id, destroyed, alias_ids, alias_roots)
                else:
                    destroyed_set_arena_owner_alias(binding_id, roots[0], destroyed, alias_ids, alias_roots)
                    for root_index in 1..<roots.count |binding_id, roots, destroyed, alias_ids, alias_roots|:
                        destroyed_add_arena_owner_alias_root(binding_id, roots[root_index], destroyed, alias_ids, alias_roots)
                for root_id in roots:
                    if root_id == DESTROYED_REGION_ALL:
                        destroyed_push_all(destroyed) if destroyed.count > 0
                    elif destroyed_region_id_contains(destroyed, root_id):
                        destroyed_push_region_id(destroyed, binding_id)


        def destroyed_register_arena_owner_alias(name: sview, value: Ast::Expr, annotations: darray[Ast::LocalRegionAnnotation]&, params: darray[Ast::ParamDecl]&, function_line: u32, position: Ast::Pos, destroyed: mutable darray[u32]&, alias_ids: mutable darray[u32]&, alias_roots: mutable darray[u32]&) -> void:
            can Memory.Allocate, Abort.Panic:
                binding_id: u32 = region_binding_id_at(annotations, name, function_line, position.line, position.offset, true) can Global{Read,Write}
                return if binding_id == NO_REGION_BINDING or binding_id.usize() > annotations.count
                owner_annotation: Ast::LocalRegionAnnotation = annotations[(binding_id - 1).usize()]
                return if owner_annotation.name != "__region_arena_local" or owner_annotation.owner_offset > position.offset
                source_name: sview = destroyed_arena_owner_source_name(value)
                roots: mutable darray[u32] = []
                if source_name != "":
                    target_id: mutable u32 = region_binding_id_at(annotations, source_name, function_line, position.line, position.offset, true) can Global{Read,Write}
                    if target_id == NO_REGION_BINDING:
                        target_annotation: Ast::LocalRegionAnnotation? = local_region_annotation_of(annotations, source_name, position.line, position.offset, true)
                        if target_annotation is target_region and target_region.region != "":
                            target_id <- region_binding_id_at(annotations, target_region.region, function_line, position.line, position.offset, true) can Global{Read,Write}
                    if target_id != NO_REGION_BINDING:
                        destroyed_collect_owner_alias_roots(target_id, alias_ids, alias_roots, roots)
                    elif any parameter in params where parameter.name == source_name and destroyed_type_is_arena_reference(parameter.type_expression):
                        # A reference parameter without a region tie may alias any caller
                        # arena. A later reset through it must conservatively invalidate all.
                        roots.push(DESTROYED_REGION_ALL)
                    else:
                        roots.push(binding_id)
                else:
                    roots.push(DESTROYED_REGION_ALL)
                for root_id in roots:
                    destroyed_add_arena_owner_alias_root(binding_id, root_id, destroyed, alias_ids, alias_roots)
                    if root_id == DESTROYED_REGION_ALL:
                        # An unknown owner that follows an already-invalidated region
                        # may designate that storage; retain the uncertainty.
                        destroyed_push_all(destroyed) if destroyed.count > 0
                    elif destroyed_region_id_contains(destroyed, root_id):
                        destroyed_push_region_id(destroyed, binding_id)


        def region_binding_name(binding_id: u32, annotations: darray[Ast::LocalRegionAnnotation]&) -> sview:
            can Abort.Panic:
                return annotations[(binding_id - 1).usize()].region if binding_id > 0 and binding_id.usize() <= annotations.count
                return ""

        def function_regions_of_name(annotations: darray[Ast::LocalRegionAnnotation]&, name: sview, function_line: u32, use_line: u32, out: mutable darray[u32]&, use_offset: u32 = 0, use_offset_known: bool = false) -> void:
            can Memory.Allocate, Abort.Panic:
                # Only rows on lines function_line..use_line can match.
                window_start: usize = 0 if use_offset_known else (region_annotation_window_start(annotations, function_line) can Global{Read,Write})
                window_end: usize = annotations.count if use_offset_known else (region_annotation_window_end(annotations, use_line) can Global{Read,Write})
                for annotation_index in window_start..<(window_end if window_end > window_start else window_start) |out, annotations, name, function_line, use_line, use_offset, use_offset_known|:
                    annotation: Ast::LocalRegionAnnotation = annotations[annotation_index]
                    # A type with no region of its own depends on none (see local_region_annotation_of).
                    is_visible_local: bool = annotation.owner_offset <= use_offset and (annotation.end_offset == 0 or use_offset < annotation.end_offset) if use_offset_known else annotation.line >= function_line and annotation.line <= use_line
                    is_local_value: bool = annotation.name == name and is_visible_local and not local_type_cannot_carry_region(annotation.type_expression)
                    binding_id: u32 = region_binding_id_at(annotations, annotation.region, function_line, annotation.line, annotation.owner_offset, true) can Global{Read,Write} if is_local_value and annotation.region != "" else NO_REGION_BINDING
                    if binding_id != NO_REGION_BINDING and not any existing in out where existing == binding_id:
                        out.push(binding_id)

        # Legacy spelling query for check_region_storage_stability, which has not moved its
        # backing-strategy facts to region binder identities yet.
        def function_region_of_name(annotations: darray[Ast::LocalRegionAnnotation]&, name: sview, function_line: u32, use_line: u32) -> sview:
            can Abort.Panic:
                found: mutable sview = ""
                window_start: usize = region_annotation_window_start(annotations, function_line) can Global{Read,Write}
                window_end: usize = region_annotation_window_end(annotations, use_line) can Global{Read,Write}
                for annotation_index in window_start..<(window_end if window_end > window_start else window_start) |found, annotations, name, function_line, use_line|:
                    annotation: Ast::LocalRegionAnnotation = annotations[annotation_index]
                    is_local_value: bool = annotation.name == name and annotation.line >= function_line and annotation.line <= use_line and not local_type_cannot_carry_region(annotation.type_expression)
                    found <- annotation.region if is_local_value
                return found

        def destroyed_annotation_region_id_of_name(annotations: darray[Ast::LocalRegionAnnotation]&, name: sview, destroyed: darray[u32]&, function_line: u32, use_line: u32, use_offset: u32 = 0, use_offset_known: bool = false) -> u32:
            can Memory.Allocate, Abort.Panic:
                regions: mutable darray[u32] = []
                function_regions_of_name(annotations, name, function_line, use_line, regions, use_offset, use_offset_known) can Global{Read,Write}
                for region in regions:
                    return region if destroyed_region_id_contains(destroyed, region)
                return NO_REGION_BINDING

        def destroyed_type_is_pool_owner_or_handle(type_expression: Ast::Expr) -> bool:
            can Abort.Panic:
                return match type_expression:
                    Expr.Index(object, _, line): ident_name_of(object) == "RegionPool" or ident_name_of(object) == "Pooled"
                    Expr.IndexN(object, _, line): ident_name_of(object) == "RegionPool" or ident_name_of(object) == "Pooled"
                    Expr.Unary(operator, operand, line):
                        return destroyed_type_is_pool_owner_or_handle(operand) if operator == TokenKind.Mutable or operator == TokenKind.Lmut or operator == TokenKind.Question or operator == TokenKind.Ampersand or operator == TokenKind.Heap or operator == TokenKind.Static or operator == TokenKind.Stack or operator == TokenKind.Tail
                        return false
                    Expr.Paren(inner, line): destroyed_type_is_pool_owner_or_handle(inner)
                    _: false

        def destroyed_type_is_view(type_expression: Ast::Expr) -> bool:
            can Abort.Panic:
                return match type_expression:
                    Expr.Ident(name, line): name == "sview"
                    Expr.Index(object, element, line): ident_name_of(object) == "view" or destroyed_type_is_pool_owner_or_handle(type_expression)
                    Expr.IndexN(object, arguments, line): ident_name_of(object) == "view" or destroyed_type_is_pool_owner_or_handle(type_expression)
                    Expr.Unary(operator, operand, line):
                        return match operator:
                            # Storage qualifiers do not erase a value's region provenance. In
                            # particular, `heap T&` returned by a region-backed owner can still
                            # point into that owner's region; keep tracking it when copied to a
                            # local so a later destroy invalidates the alias too.
                            TokenKind.Mutable | TokenKind.Lmut | TokenKind.Question | TokenKind.Heap | TokenKind.Static | TokenKind.Stack | TokenKind.Tail: destroyed_type_is_view(operand)
                            TokenKind.Ampersand: true
                            _: false
                    Expr.Paren(inner, line): destroyed_type_is_view(inner)
                    _: false


        def destroyed_collect_view_block_statement(statement: Ast::Stmt, annotations: darray[Ast::LocalRegionAnnotation]&, view_fns: darray[sview]&, borrow_names: mutable darray[sview]&, borrow_regions: mutable darray[u32]&, function_line: u32, use_line: u32, out: mutable darray[u32]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match statement:
                    Stmt.VarDecl(name, type_expression, value, line):
                        local_regions: mutable darray[u32] = []
                        destroyed_collect_view_regions(value, annotations, view_fns, borrow_names, borrow_regions, function_line, line.line, local_regions) can Global{Read,Write}
                        for region_id in local_regions:
                            borrow_names.push(name)
                            borrow_regions.push(region_id)
                    Stmt.Assign(target, operator, value, line):
                        target_name: sview = destroyed_use_root_name(target)
                        local_regions: mutable darray[u32] = []
                        destroyed_collect_view_regions(value, annotations, view_fns, borrow_names, borrow_regions, function_line, line.line, local_regions) can Global{Read,Write}
                        for region_id in local_regions:
                            borrow_names.push(target_name)
                            borrow_regions.push(region_id)
                    Stmt.Return(value, line):
                        destroyed_collect_view_regions(returned, annotations, view_fns, borrow_names, borrow_regions, function_line, line.line, out) can Global{Read,Write} if value is returned
                    Stmt.Expr(expression, line):
                        destroyed_collect_view_regions(expression, annotations, view_fns, borrow_names, borrow_regions, function_line, line.line, out) can Global{Read,Write}
                    Stmt.Block(kind, clause, binding, body, line):
                        for nested in body |annotations, view_fns, borrow_names, borrow_regions, function_line, use_line, out|:
                            destroyed_collect_view_block_statement(nested, annotations, view_fns, borrow_names, borrow_regions, function_line, line.line, out) can Global{Read,Write}
                    Stmt.If(condition, then_body, else_body, line):
                        destroyed_collect_view_regions(condition, annotations, view_fns, borrow_names, borrow_regions, function_line, line.line, out) can Global{Read,Write}
                        for nested_then in then_body |annotations, view_fns, borrow_names, borrow_regions, function_line, use_line, out|:
                            destroyed_collect_view_block_statement(nested_then, annotations, view_fns, borrow_names, borrow_regions, function_line, line.line, out) can Global{Read,Write}
                        for nested_else in else_body |annotations, view_fns, borrow_names, borrow_regions, function_line, use_line, out|:
                            destroyed_collect_view_block_statement(nested_else, annotations, view_fns, borrow_names, borrow_regions, function_line, line.line, out) can Global{Read,Write}
                    Stmt.While(condition, body, line):
                        destroyed_collect_view_regions(condition, annotations, view_fns, borrow_names, borrow_regions, function_line, line.line, out) can Global{Read,Write}
                        for nested_while in body |annotations, view_fns, borrow_names, borrow_regions, function_line, use_line, out|:
                            destroyed_collect_view_block_statement(nested_while, annotations, view_fns, borrow_names, borrow_regions, function_line, line.line, out) can Global{Read,Write}
                    Stmt.For(bind, variables, iterable, body, line):
                        destroyed_collect_view_regions(iterable, annotations, view_fns, borrow_names, borrow_regions, function_line, line.line, out) can Global{Read,Write}
                        for nested_for in body |annotations, view_fns, borrow_names, borrow_regions, function_line, use_line, out|:
                            destroyed_collect_view_block_statement(nested_for, annotations, view_fns, borrow_names, borrow_regions, function_line, line.line, out) can Global{Read,Write}
                    Stmt.Match(scrutinee, arms, line):
                        destroyed_collect_view_regions(scrutinee, annotations, view_fns, borrow_names, borrow_regions, function_line, line.line, out) can Global{Read,Write}
                        for arm in arms |annotations, view_fns, borrow_names, borrow_regions, function_line, use_line, out|:
                            destroyed_collect_view_regions(arm.guard, annotations, view_fns, borrow_names, borrow_regions, function_line, line.line, out) can Global{Read,Write}
                            for nested_arm in arm.body |annotations, view_fns, borrow_names, borrow_regions, function_line, use_line, out|:
                                destroyed_collect_view_block_statement(nested_arm, annotations, view_fns, borrow_names, borrow_regions, function_line, line.line, out) can Global{Read,Write}
                    Stmt.Contract(kind, expression, line):
                        destroyed_collect_view_regions(expression, annotations, view_fns, borrow_names, borrow_regions, function_line, line.line, out) can Global{Read,Write}
                    _:
                        pass
