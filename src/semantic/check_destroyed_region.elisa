extend Semantic:
    private:
        const NO_REGION_BINDING: u32 = 0
        const DESTROYED_REGION_ALL: u32 = 0
        const NO_ARENA_SUMMARY_PARAM: u32 = 4294967295
        const UNKNOWN_LAMBDA_DEPENDENCY: u32 = 4294967294

        # RegionBindingId is the one-based row of its lexical binder in the parser side table.
        # Region spelling is for diagnostics only: two simultaneously-live binders named `r`
        # must not share invalidation facts.
        def destroyed_region_id_contains(regions: darray[u32]&, candidate: u32) -> bool:
            false return if candidate == NO_REGION_BINDING
            for region in regions:
                true return if region == candidate or region == DESTROYED_REGION_ALL
            return false

        # Storage-stability analysis still uses strategy/source-name sets; its binder-ID
        # migration is separate from destroyed-region invalidation.
        def destroyed_region_contains(regions: darray[sview]&, candidate: sview) -> bool:
            for region in regions:
                true return if region == candidate
            return false

        def region_binding_id_at(annotations: darray[Ast::LocalRegionAnnotation]&, region: sview, function_line: u32, use_line: u32) -> u32:
            can Abort.Panic:
                found: mutable u32 = NO_REGION_BINDING
                found_line: mutable u32 = 0
                for annotation_index in 0..<annotations.count |found, found_line, annotations, region, function_line, use_line|:
                    annotation: Ast::LocalRegionAnnotation = annotations[annotation_index]
                    is_function_param: bool = annotation.name == "__region_param" and annotation.line == function_line
                    is_open_region: bool = annotation.name == "__region_local" and annotation.line >= function_line and annotation.line <= use_line and (annotation.end_line == 0 or use_line <= annotation.end_line)
                    # Arena-local aliases are bounded to their containing parser block,
                    # just like region-block binders are bounded to the block they own.
                    # Ignoring end_line lets a closed same-name inner owner mask the still
                    # live outer owner at a later reset, so invalidation is attached to the
                    # wrong RegionBindingId and a stale outer view can escape this check.
                    is_arena_owner: bool = annotation.name == "__region_arena_local" and annotation.line >= function_line and annotation.line <= use_line and annotation.end_line > 0 and use_line <= annotation.end_line
                    if annotation.region == region and (is_function_param or is_open_region or is_arena_owner) and annotation.line >= found_line:
                        found_line <- annotation.line
                        found <- (annotation_index + 1).u32()
                return found


        # Arena handles are copyable references to the same backing arena. Keep one
        # binder-to-root row per possible owner for simple local aliases, so reset/free
        # through any alias invalidates views tied to every possible backing arena.
        def destroyed_collect_owner_alias_roots(binding_id: u32, alias_ids: darray[u32]&, alias_roots: darray[u32]&, out: mutable darray[u32]&) -> void:
            can Memory.Allocate, Abort.Panic:
                if alias_ids.count != alias_roots.count:
                    out.push(DESTROYED_REGION_ALL) if not any existing in out where existing == DESTROYED_REGION_ALL
                    return
                found: mutable bool = false
                for alias_index in 0..<alias_ids.count |alias_ids, alias_roots, binding_id, out, found|:
                    if alias_ids[alias_index] == binding_id:
                        found <- true
                        if alias_index >= alias_roots.count:
                            out.push(DESTROYED_REGION_ALL) if not any existing in out where existing == DESTROYED_REGION_ALL
                            return
                        candidate: u32 = alias_roots[alias_index]
                        out.push(candidate) if not any existing in out where existing == candidate
                if not found:
                    out.push(binding_id) if not any existing in out where existing == binding_id


        def destroyed_append_owner_alias_root(binding_id: u32, root_id: u32, destroyed: mutable darray[u32]&, alias_ids: mutable darray[u32]&, alias_roots: mutable darray[u32]&) -> void:
            can Memory.Allocate, Abort.Panic:
                if alias_ids.count != alias_roots.count:
                    destroyed_push_all(destroyed)
                    return
                for alias_index in 0..<alias_ids.count |alias_ids, alias_roots, binding_id, root_id|:
                    return if alias_ids[alias_index] == binding_id and alias_roots[alias_index] == root_id
                alias_ids.push(binding_id)
                alias_roots.push(root_id)


        def destroyed_copy_owner_alias_roots(source_ids: darray[u32]&, source_roots: darray[u32]&, destroyed: mutable darray[u32]&, out_ids: mutable darray[u32]&, out_roots: mutable darray[u32]&) -> void:
            can Memory.Allocate, Abort.Panic:
                if source_ids.count != source_roots.count:
                    destroyed_push_all(destroyed)
                    for binding_id in source_ids:
                        destroyed_append_owner_alias_root(binding_id, DESTROYED_REGION_ALL, destroyed, out_ids, out_roots)
                    return
                for alias_index in 0..<source_ids.count |source_ids, source_roots, destroyed, out_ids, out_roots|:
                    destroyed_append_owner_alias_root(source_ids[alias_index], source_roots[alias_index], destroyed, out_ids, out_roots)


        def destroyed_match_arm_is_unguarded_catchall(arm: Ast::MatchArm) -> bool:
            can Memory.Allocate, Abort.Panic:
                return false if not (arm.guard is Ast::Expr.Absent)
                return match arm.pattern:
                    Pattern.Wildcard: true
                    Pattern.Binding(_): true
                    _: false


        def destroyed_arena_owner_source_name(expression: Ast::Expr) -> sview:
            can Memory.Allocate, Abort.Panic:
                return match expression:
                    Expr.Ident(name, line): name
                    Expr.Paren(inner, line) | Expr.Move(inner, line): destroyed_arena_owner_source_name(inner)
                    Expr.Unary(operator, operand, line):
                        return destroyed_arena_owner_source_name(operand) if operator == TokenKind.Ampersand
                        sview("", 0, 0)
                    Expr.Call(callee, arguments, argument_names, line):
                        match callee:
                            Expr.Field(receiver, method, field_line):
                                if method == "cast":
                                    return destroyed_arena_owner_source_name(receiver)
                                return sview("", 0, 0)
                            _:
                                sview("", 0, 0)
                    _:
                        sview("", 0, 0)


        def destroyed_type_is_arena_reference(type_expression: Ast::Expr) -> bool:
            can Abort.Panic:
                return match type_expression:
                    Expr.Unary(operator, operand, line):
                        return destroyed_type_is_arena_reference(operand) if operator == TokenKind.Mutable or operator == TokenKind.Lmut
                        false return if operator != TokenKind.Ampersand
                        return match operand:
                            Expr.Ident(name, type_line): name == "Arena"
                            Expr.Paren(inner, paren_line): destroyed_type_is_arena_reference(inner)
                            _: false
                    Expr.Paren(inner, line): destroyed_type_is_arena_reference(inner)
                    _: false


        def destroyed_type_is_callable_value(type_expression: Ast::Expr) -> bool:
            can Abort.Panic:
                return match type_expression:
                    # A function type is represented by a Lambda with no body; a lambda
                    # value has a nonempty body after expression-body normalization.
                    Expr.Lambda(parameters, body, line): body.count == 0
                    Expr.Paren(inner, line) | Expr.Refinement(inner, _, line) | Expr.Unary(_, inner, line): destroyed_type_is_callable_value(inner)
                    _: false


        def destroyed_type_is_callable_binding(type_expression: Ast::Expr, table: SymbolTable&) -> bool:
            can Abort.Panic:
                return match type_expression:
                    Expr.Ident(name, line): destroyed_type_is_callable_value(type_expression) or any alias_name in table.fn_alias_names where alias_name == name
                    Expr.Scope(_, name, line): any alias_name in table.fn_alias_names where alias_name == name
                    Expr.Paren(inner, line) | Expr.Refinement(inner, _, line) | Expr.Unary(_, inner, line): destroyed_type_is_callable_binding(inner, table)
                    _: destroyed_type_is_callable_value(type_expression)


        def destroyed_is_generated_effect_call(name: sview) -> bool:
            can Abort.Panic:
                return true if sview_len(name) >= 10.usize() and name[0:10] == "__effect__"
                return true if sview_len(name) >= 11.usize() and name[0:11] == "__handler__"
                return false


        # Generic direct calls retain their type application in the callee AST
        # (`reset[T](...)` is IndexN(Ident("reset"), ...)). Recover only the
        # statically named direct-call forms used by the summary table. Generated
        # handler clones may be qualified Scope nodes, so admit those private names
        # as well; ordinary qualified methods remain outside this summary namespace.
        def destroyed_direct_call_name(callee: Ast::Expr) -> sview:
            can Abort.Panic:
                match callee:
                    Expr.Ident(name, line): return name
                    Expr.Index(base, _, line) | Expr.IndexN(base, _, line) | Expr.Paren(base, line) | Expr.Move(base, line): return destroyed_direct_call_name(base)
                    Expr.Scope(_, name, line):
                        return name if destroyed_is_generated_effect_call(name)
                        return ""
                    _:
                        return ""


        def destroyed_push_region_id(destroyed: mutable darray[u32]&, region_id: u32) -> void:
            can Memory.Allocate, Abort.Panic:
                destroyed.push(region_id) if not any existing in destroyed where existing == region_id


        def destroyed_mark_region_binding(destroyed: mutable darray[u32]&, binding_id: u32, alias_ids: darray[u32]&, alias_roots: darray[u32]&) -> void:
            can Memory.Allocate, Abort.Panic:
                if alias_ids.count != alias_roots.count:
                    destroyed_push_all(destroyed)
                    return
                if binding_id == NO_REGION_BINDING:
                    destroyed_push_all(destroyed)
                    return
                found_alias: mutable bool = false
                for alias_index in 0..<alias_ids.count |destroyed, alias_ids, alias_roots, binding_id, found_alias|:
                    if alias_ids[alias_index] == binding_id:
                        found_alias <- true
                        if alias_index >= alias_roots.count:
                            destroyed_push_all(destroyed)
                            return
                        root_id: u32 = alias_roots[alias_index]
                        if root_id == DESTROYED_REGION_ALL:
                            destroyed_push_all(destroyed)
                            return
                        destroyed_push_region_id(destroyed, root_id)
                        for related_alias_index in 0..<alias_ids.count |destroyed, alias_ids, alias_roots, root_id|:
                            if related_alias_index < alias_roots.count and alias_roots[related_alias_index] == root_id:
                                destroyed_push_region_id(destroyed, alias_ids[related_alias_index])
                destroyed_push_region_id(destroyed, binding_id) if not found_alias


        def destroyed_push_all(destroyed: mutable darray[u32]&) -> void:
            can Memory.Allocate, Abort.Panic:
                destroyed.push(DESTROYED_REGION_ALL) if not any existing in destroyed where existing == DESTROYED_REGION_ALL


        # Mutable Arena& locals can change which arena they designate. Replace the
        # binding's summary row on assignment; retaining its initializer root makes a
        # later reset invalidate the old arena and miss the actual target.
        def destroyed_set_arena_owner_alias(binding_id: u32, root_id: u32, destroyed: mutable darray[u32]&, alias_ids: mutable darray[u32]&, alias_roots: mutable darray[u32]&) -> void:
            can Memory.Allocate, Abort.Panic:
                if alias_ids.count != alias_roots.count:
                    destroyed_push_all(destroyed)
                    return
                found: mutable bool = false
                for alias_index in 0..<alias_ids.count |alias_ids, alias_roots, binding_id, root_id, destroyed|:
                    if alias_ids[alias_index] == binding_id:
                        found <- true
                        if alias_index < alias_roots.count:
                            alias_roots[alias_index] <- root_id
                        else:
                            # The parallel summary tables lost their structural
                            # correspondence. Do not trust any owner-specific result.
                            destroyed_push_all(destroyed)
                            return
                if not found:
                    alias_ids.push(binding_id)
                    alias_roots.push(root_id)


        def destroyed_add_arena_owner_alias_root(binding_id: u32, root_id: u32, destroyed: mutable darray[u32]&, alias_ids: mutable darray[u32]&, alias_roots: mutable darray[u32]&) -> void:
            can Memory.Allocate, Abort.Panic:
                if alias_ids.count != alias_roots.count:
                    destroyed_push_all(destroyed)
                    return
                for alias_index in 0..<alias_ids.count |alias_ids, alias_roots, binding_id, root_id, destroyed|:
                    if alias_ids[alias_index] == binding_id:
                        if alias_index >= alias_roots.count:
                            destroyed_push_all(destroyed)
                            return
                        return if alias_roots[alias_index] == root_id
                alias_ids.push(binding_id)
                alias_roots.push(root_id)


        def destroyed_rebind_arena_owner_alias(name: sview, value: Ast::Expr, annotations: darray[Ast::LocalRegionAnnotation]&, function_line: u32, line: u32, branch_sensitive: bool, destroyed: mutable darray[u32]&, alias_ids: mutable darray[u32]&, alias_roots: mutable darray[u32]&) -> void:
            can Memory.Allocate, Abort.Panic:
                binding_id: u32 = region_binding_id_at(annotations, name, function_line, line)
                return if binding_id == NO_REGION_BINDING or binding_id.usize() > annotations.count
                owner_annotation: Ast::LocalRegionAnnotation = annotations[(binding_id - 1).usize()]
                return if owner_annotation.name != "__region_arena_local" or owner_annotation.line >= line
                source_name: sview = destroyed_arena_owner_source_name(value)
                roots: mutable darray[u32] = []
                if source_name != "":
                    target_id: mutable u32 = region_binding_id_at(annotations, source_name, function_line, line)
                    if target_id == NO_REGION_BINDING:
                        target_annotation: Ast::LocalRegionAnnotation? = local_region_annotation_of(annotations, source_name, line)
                        if target_annotation is target_region and target_region.region != "":
                            target_id <- region_binding_id_at(annotations, target_region.region, function_line, line)
                    if target_id != NO_REGION_BINDING:
                        destroyed_collect_owner_alias_roots(target_id, alias_ids, alias_roots, roots)
                if roots.count == 0:
                    roots.push(DESTROYED_REGION_ALL)
                if branch_sensitive:
                    for root_id in roots:
                        destroyed_add_arena_owner_alias_root(binding_id, root_id, destroyed, alias_ids, alias_roots)
                else:
                    destroyed_set_arena_owner_alias(binding_id, roots[0], destroyed, alias_ids, alias_roots)
                    for root_index in 1..<roots.count |binding_id, roots, destroyed, alias_ids, alias_roots|:
                        destroyed_add_arena_owner_alias_root(binding_id, roots[root_index], destroyed, alias_ids, alias_roots)
                for root_id in roots:
                    if root_id == DESTROYED_REGION_ALL:
                        destroyed_push_all(destroyed) if destroyed.count > 0
                    elif destroyed_region_id_contains(destroyed, root_id):
                        destroyed_push_region_id(destroyed, binding_id)


        def destroyed_register_arena_owner_alias(name: sview, value: Ast::Expr, annotations: darray[Ast::LocalRegionAnnotation]&, params: darray[Ast::ParamDecl]&, function_line: u32, line: u32, destroyed: mutable darray[u32]&, alias_ids: mutable darray[u32]&, alias_roots: mutable darray[u32]&) -> void:
            can Memory.Allocate, Abort.Panic:
                binding_id: u32 = region_binding_id_at(annotations, name, function_line, line)
                return if binding_id == NO_REGION_BINDING or binding_id.usize() > annotations.count
                owner_annotation: Ast::LocalRegionAnnotation = annotations[(binding_id - 1).usize()]
                return if owner_annotation.name != "__region_arena_local" or owner_annotation.line != line
                source_name: sview = destroyed_arena_owner_source_name(value)
                roots: mutable darray[u32] = []
                if source_name != "":
                    target_id: mutable u32 = region_binding_id_at(annotations, source_name, function_line, line)
                    if target_id == NO_REGION_BINDING:
                        target_annotation: Ast::LocalRegionAnnotation? = local_region_annotation_of(annotations, source_name, line)
                        if target_annotation is target_region and target_region.region != "":
                            target_id <- region_binding_id_at(annotations, target_region.region, function_line, line)
                    if target_id != NO_REGION_BINDING:
                        destroyed_collect_owner_alias_roots(target_id, alias_ids, alias_roots, roots)
                    elif any parameter in params where parameter.name == source_name and destroyed_type_is_arena_reference(parameter.type_expression):
                        # A reference parameter without a region tie may alias any caller
                        # arena. A later reset through it must conservatively invalidate all.
                        roots.push(DESTROYED_REGION_ALL)
                    else:
                        roots.push(binding_id)
                else:
                    roots.push(DESTROYED_REGION_ALL)
                for root_id in roots:
                    destroyed_add_arena_owner_alias_root(binding_id, root_id, destroyed, alias_ids, alias_roots)
                    if root_id == DESTROYED_REGION_ALL:
                        # An unknown owner that follows an already-invalidated region
                        # may designate that storage; retain the uncertainty.
                        destroyed_push_all(destroyed) if destroyed.count > 0
                    elif destroyed_region_id_contains(destroyed, root_id):
                        destroyed_push_region_id(destroyed, binding_id)


        def region_binding_name(binding_id: u32, annotations: darray[Ast::LocalRegionAnnotation]&) -> sview:
            can Abort.Panic:
                return annotations[(binding_id - 1).usize()].region if binding_id > 0 and binding_id.usize() <= annotations.count
                return ""

        def function_regions_of_name(annotations: darray[Ast::LocalRegionAnnotation]&, name: sview, function_line: u32, use_line: u32, out: mutable darray[u32]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for annotation in annotations |out|:
                    # A type with no region of its own depends on none (see local_region_annotation_of).
                    is_local_value: bool = annotation.name == name and annotation.line >= function_line and annotation.line <= use_line and not local_type_cannot_carry_region(annotation.type_expression)
                    binding_id: u32 = region_binding_id_at(annotations, annotation.region, function_line, annotation.line) if is_local_value and annotation.region != "" else NO_REGION_BINDING
                    if binding_id != NO_REGION_BINDING and not any existing in out where existing == binding_id:
                        out.push(binding_id)

        # Legacy spelling query for check_region_storage_stability, which has not moved its
        # backing-strategy facts to region binder identities yet.
        def function_region_of_name(annotations: darray[Ast::LocalRegionAnnotation]&, name: sview, function_line: u32, use_line: u32) -> sview:
            can Abort.Panic:
                found: mutable sview = ""
                for annotation in annotations |found|:
                    is_local_value: bool = annotation.name == name and annotation.line >= function_line and annotation.line <= use_line and not local_type_cannot_carry_region(annotation.type_expression)
                    found <- annotation.region if is_local_value
                return found

        def destroyed_annotation_region_id_of_name(annotations: darray[Ast::LocalRegionAnnotation]&, name: sview, destroyed: darray[u32]&, function_line: u32, use_line: u32) -> u32:
            can Memory.Allocate, Abort.Panic:
                regions: mutable darray[u32] = []
                function_regions_of_name(annotations, name, function_line, use_line, regions)
                for region in regions:
                    return region if destroyed_region_id_contains(destroyed, region)
                return NO_REGION_BINDING

        def destroyed_type_is_view(type_expression: Ast::Expr) -> bool:
            can Abort.Panic:
                return match type_expression:
                    Expr.Ident(name, line): name == "sview"
                    Expr.Index(object, element, line): ident_name_of(object) == "view"
                    Expr.IndexN(object, arguments, line): ident_name_of(object) == "view"
                    Expr.Unary(operator, operand, line):
                        return match operator:
                            TokenKind.Mutable | TokenKind.Lmut | TokenKind.Question: destroyed_type_is_view(operand)
                            TokenKind.Ampersand: true
                            _: false
                    Expr.Paren(inner, line): destroyed_type_is_view(inner)
                    _: false


        def destroyed_collect_view_block_statement(statement: Ast::Stmt, annotations: darray[Ast::LocalRegionAnnotation]&, view_fns: darray[sview]&, borrow_names: mutable darray[sview]&, borrow_regions: mutable darray[u32]&, function_line: u32, use_line: u32, out: mutable darray[u32]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match statement:
                    Stmt.VarDecl(name, type_expression, value, line):
                        local_regions: mutable darray[u32] = []
                        destroyed_collect_view_regions(value, annotations, view_fns, borrow_names, borrow_regions, function_line, line.line, local_regions)
                        for region_id in local_regions:
                            borrow_names.push(name)
                            borrow_regions.push(region_id)
                    Stmt.Assign(target, operator, value, line):
                        target_name: sview = destroyed_use_root_name(target)
                        local_regions: mutable darray[u32] = []
                        destroyed_collect_view_regions(value, annotations, view_fns, borrow_names, borrow_regions, function_line, line.line, local_regions)
                        for region_id in local_regions:
                            borrow_names.push(target_name)
                            borrow_regions.push(region_id)
                    Stmt.Return(value, line):
                        destroyed_collect_view_regions(returned, annotations, view_fns, borrow_names, borrow_regions, function_line, line.line, out) if value is returned
                    Stmt.Expr(expression, line):
                        destroyed_collect_view_regions(expression, annotations, view_fns, borrow_names, borrow_regions, function_line, line.line, out)
                    Stmt.Block(kind, clause, binding, body, line):
                        for nested in body |annotations, view_fns, borrow_names, borrow_regions, function_line, use_line, out|:
                            destroyed_collect_view_block_statement(nested, annotations, view_fns, borrow_names, borrow_regions, function_line, line.line, out)
                    Stmt.If(condition, then_body, else_body, line):
                        destroyed_collect_view_regions(condition, annotations, view_fns, borrow_names, borrow_regions, function_line, line.line, out)
                        for nested_then in then_body |annotations, view_fns, borrow_names, borrow_regions, function_line, use_line, out|:
                            destroyed_collect_view_block_statement(nested_then, annotations, view_fns, borrow_names, borrow_regions, function_line, line.line, out)
                        for nested_else in else_body |annotations, view_fns, borrow_names, borrow_regions, function_line, use_line, out|:
                            destroyed_collect_view_block_statement(nested_else, annotations, view_fns, borrow_names, borrow_regions, function_line, line.line, out)
                    Stmt.While(condition, body, line):
                        destroyed_collect_view_regions(condition, annotations, view_fns, borrow_names, borrow_regions, function_line, line.line, out)
                        for nested_while in body |annotations, view_fns, borrow_names, borrow_regions, function_line, use_line, out|:
                            destroyed_collect_view_block_statement(nested_while, annotations, view_fns, borrow_names, borrow_regions, function_line, line.line, out)
                    Stmt.For(bind, variables, iterable, body, line):
                        destroyed_collect_view_regions(iterable, annotations, view_fns, borrow_names, borrow_regions, function_line, line.line, out)
                        for nested_for in body |annotations, view_fns, borrow_names, borrow_regions, function_line, use_line, out|:
                            destroyed_collect_view_block_statement(nested_for, annotations, view_fns, borrow_names, borrow_regions, function_line, line.line, out)
                    Stmt.Match(scrutinee, arms, line):
                        destroyed_collect_view_regions(scrutinee, annotations, view_fns, borrow_names, borrow_regions, function_line, line.line, out)
                        for arm in arms |annotations, view_fns, borrow_names, borrow_regions, function_line, use_line, out|:
                            destroyed_collect_view_regions(arm.guard, annotations, view_fns, borrow_names, borrow_regions, function_line, line.line, out)
                            for nested_arm in arm.body |annotations, view_fns, borrow_names, borrow_regions, function_line, use_line, out|:
                                destroyed_collect_view_block_statement(nested_arm, annotations, view_fns, borrow_names, borrow_regions, function_line, line.line, out)
                    Stmt.Contract(kind, expression, line):
                        destroyed_collect_view_regions(expression, annotations, view_fns, borrow_names, borrow_regions, function_line, line.line, out)
                    _:
                        pass

        # Collect backing-region provenance through view constructors, copies, slices, and
        # functions whose declared result is a view. Conservatively retaining every possible
        # source argument makes conditional view-returning helpers safe without trusting body
        # shape or choosing one branch's region.
        def destroyed_collect_view_regions(expression: Ast::Expr, annotations: darray[Ast::LocalRegionAnnotation]&, view_fns: darray[sview]&, borrow_names: mutable darray[sview]&, borrow_regions: mutable darray[u32]&, function_line: u32, use_line: u32, out: mutable darray[u32]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Ident(name, line):
                        function_regions_of_name(annotations, name, function_line, use_line, out)
                        for index in 0..<borrow_names.count |out, borrow_names, borrow_regions, name|:
                            if borrow_names[index] == name and index < borrow_regions.count:
                                alias_region: u32 = borrow_regions[index]
                                out.push(alias_region) if alias_region != NO_REGION_BINDING and not any existing in out where existing == alias_region
                    Expr.Paren(inner, line) | Expr.Move(inner, line):
                        destroyed_collect_view_regions(inner, annotations, view_fns, borrow_names, borrow_regions, function_line, use_line, out)
                    Expr.Field(object, field, line) | Expr.Index(object, index, line) | Expr.IndexN(object, indices, line) | Expr.Slice(object, start, end, line):
                        destroyed_collect_view_regions(object, annotations, view_fns, borrow_names, borrow_regions, function_line, use_line, out)
                    Expr.Unary(operator, operand, line):
                        destroyed_collect_view_regions(operand, annotations, view_fns, borrow_names, borrow_regions, function_line, use_line, out)
                    Expr.Call(callee, arguments, argument_names, line):
                        called: sview = ident_name_of(callee)
                        if called == "sview" or any view_fn in view_fns where view_fn == called:
                            for argument in arguments |out|:
                                destroyed_collect_view_regions(argument, annotations, view_fns, borrow_names, borrow_regions, function_line, use_line, out)
                        match callee:
                            Expr.Field(receiver, method, field_line):
                                is_view_method: bool = method == "sview" or method == "as_sview" or method == "as_view" or method == "as_slice" or method == "as_str"
                                destroyed_collect_view_regions(receiver, annotations, view_fns, borrow_names, borrow_regions, function_line, use_line, out) if is_view_method
                            _:
                                pass
                    Expr.Catch(guarded, arms, line):
                        destroyed_collect_view_regions(guarded, annotations, view_fns, borrow_names, borrow_regions, function_line, use_line, out)
                        for arm in arms |out|:
                            destroyed_collect_view_regions(arm.guard, annotations, view_fns, borrow_names, borrow_regions, function_line, use_line, out)
                            for arm_statement in arm.body |annotations, view_fns, borrow_names, borrow_regions, function_line, use_line, out|:
                                destroyed_collect_view_block_statement(arm_statement, annotations, view_fns, borrow_names, borrow_regions, function_line, use_line, out)
                    Expr.GetElse(guarded, recovery, line):
                        destroyed_collect_view_regions(guarded, annotations, view_fns, borrow_names, borrow_regions, function_line, use_line, out)
                        for recovery_statement in recovery |annotations, view_fns, borrow_names, borrow_regions, function_line, use_line, out|:
                            destroyed_collect_view_block_statement(recovery_statement, annotations, view_fns, borrow_names, borrow_regions, function_line, use_line, out)
                    Expr.Binary(left, operator, right, line):
                        destroyed_collect_view_regions(left, annotations, view_fns, borrow_names, borrow_regions, function_line, use_line, out)
                        destroyed_collect_view_regions(right, annotations, view_fns, borrow_names, borrow_regions, function_line, use_line, out)
                    Expr.If(condition, then_value, else_value, line):
                        destroyed_collect_view_regions(then_value, annotations, view_fns, borrow_names, borrow_regions, function_line, use_line, out)
                        destroyed_collect_view_regions(else_value, annotations, view_fns, borrow_names, borrow_regions, function_line, use_line, out)
                    Expr.Refinement(base, predicate, line):
                        destroyed_collect_view_regions(base, annotations, view_fns, borrow_names, borrow_regions, function_line, use_line, out)
                        destroyed_collect_view_regions(predicate, annotations, view_fns, borrow_names, borrow_regions, function_line, use_line, out)
                    Expr.Block(statements, value, captures, line):
                        block_borrow_names: mutable darray[sview] = []
                        block_borrow_regions: mutable darray[u32] = []
                        for borrow_index in 0..<borrow_names.count |block_borrow_names, block_borrow_regions, borrow_regions|:
                            block_borrow_names.push(borrow_names[borrow_index])
                            block_borrow_regions.push(borrow_regions[borrow_index]) if borrow_index < borrow_regions.count
                        for block_statement in statements |annotations, view_fns, block_borrow_names, block_borrow_regions, function_line, use_line, out|:
                            destroyed_collect_view_block_statement(block_statement, annotations, view_fns, block_borrow_names, block_borrow_regions, function_line, use_line, out)
                        destroyed_collect_view_regions(value, annotations, view_fns, block_borrow_names, block_borrow_regions, function_line, use_line, out)
                    Expr.Match(scrutinee, arms, line):
                        destroyed_collect_view_regions(scrutinee, annotations, view_fns, borrow_names, borrow_regions, function_line, use_line, out)
                        for arm in arms |out|:
                            destroyed_collect_view_regions(arm.guard, annotations, view_fns, borrow_names, borrow_regions, function_line, use_line, out)
                            for arm_statement in arm.body |annotations, view_fns, borrow_names, borrow_regions, function_line, use_line, out|:
                                destroyed_collect_view_block_statement(arm_statement, annotations, view_fns, borrow_names, borrow_regions, function_line, use_line, out)
                    Expr.Comprehension(variable, iterable, condition, body, line):
                        destroyed_collect_view_regions(iterable, annotations, view_fns, borrow_names, borrow_regions, function_line, use_line, out)
                        destroyed_collect_view_regions(condition, annotations, view_fns, borrow_names, borrow_regions, function_line, use_line, out)
                        destroyed_collect_view_regions(body, annotations, view_fns, borrow_names, borrow_regions, function_line, use_line, out)
                    Expr.StaticEffectCall(effect_type, operation, candidates, arguments, argument_names, line):
                        destroyed_collect_view_regions(effect_type, annotations, view_fns, borrow_names, borrow_regions, function_line, use_line, out)
                        for candidate in candidates |out|:
                            for capture in candidate.captures |annotations, view_fns, borrow_names, borrow_regions, function_line, use_line, out|:
                                destroyed_collect_view_regions(capture, annotations, view_fns, borrow_names, borrow_regions, function_line, use_line, out)
                        for argument in arguments |out|:
                            destroyed_collect_view_regions(argument, annotations, view_fns, borrow_names, borrow_regions, function_line, use_line, out)
                    Expr.Tuple(elements, line) | Expr.Array(elements, line):
                        for element in elements |out|:
                            destroyed_collect_view_regions(element, annotations, view_fns, borrow_names, borrow_regions, function_line, use_line, out)
                    Expr.Construct(type_expression, fields, line):
                        for field in fields |out|:
                            destroyed_collect_view_regions(field.value, annotations, view_fns, borrow_names, borrow_regions, function_line, use_line, out)
                    Expr.RecordUpdate(base, fields, line):
                        destroyed_collect_view_regions(base, annotations, view_fns, borrow_names, borrow_regions, function_line, use_line, out)
                        for field in fields |out|:
                            destroyed_collect_view_regions(field.value, annotations, view_fns, borrow_names, borrow_regions, function_line, use_line, out)
                    _:
                        pass

        def destroyed_alias_region(name: sview, borrow_names: darray[sview]&, borrow_regions: darray[u32]&, destroyed: darray[u32]&) -> u32:
            can Abort.Panic:
                while index > 0 |index: usize = borrow_names.count|:
                    index <- index - 1
                    if borrow_names[index] == name and index < borrow_regions.count:
                        region: u32 = borrow_regions[index]
                        return region if destroyed_region_id_contains(destroyed, region)
                return NO_REGION_BINDING

        def destroyed_region_of_statement(statement: Ast::Stmt, annotations: darray[Ast::LocalRegionAnnotation]&, destroyed: darray[u32]&, borrow_names: darray[sview]&, borrow_regions: darray[u32]&, function_line: u32, use_line: u32) -> u32:
            can Memory.Allocate, Abort.Panic:
                match statement:
                    Stmt.VarDecl(name, type_expression, value, line):
                        return destroyed_region_of_expression(value, annotations, destroyed, borrow_names, borrow_regions, function_line, line.line)
                    Stmt.Assign(target, operator, value, line):
                        target_region: u32 = destroyed_region_of_expression(target, annotations, destroyed, borrow_names, borrow_regions, function_line, line.line)
                        return target_region if target_region != NO_REGION_BINDING
                        return destroyed_region_of_expression(value, annotations, destroyed, borrow_names, borrow_regions, function_line, line.line)
                    Stmt.Expr(expression, line) | Stmt.Contract(_, expression, line):
                        return destroyed_region_of_expression(expression, annotations, destroyed, borrow_names, borrow_regions, function_line, line.line)
                    Stmt.Return(value, line):
                        if value is returned:
                            return destroyed_region_of_expression(returned, annotations, destroyed, borrow_names, borrow_regions, function_line, line.line)
                        return NO_REGION_BINDING
                    Stmt.Block(kind, clause, binding, body, line):
                        for nested in body:
                            region_id: u32 = destroyed_region_of_statement(nested, annotations, destroyed, borrow_names, borrow_regions, function_line, line.line)
                            return region_id if region_id != NO_REGION_BINDING
                        return NO_REGION_BINDING
                    Stmt.If(condition, then_body, else_body, line):
                        condition_region: u32 = destroyed_region_of_expression(condition, annotations, destroyed, borrow_names, borrow_regions, function_line, line.line)
                        return condition_region if condition_region != NO_REGION_BINDING
                        for nested_then in then_body:
                            region_id: u32 = destroyed_region_of_statement(nested_then, annotations, destroyed, borrow_names, borrow_regions, function_line, line.line)
                            return region_id if region_id != NO_REGION_BINDING
                        for nested_else in else_body:
                            region_id: u32 = destroyed_region_of_statement(nested_else, annotations, destroyed, borrow_names, borrow_regions, function_line, line.line)
                            return region_id if region_id != NO_REGION_BINDING
                        return NO_REGION_BINDING
                    Stmt.While(condition, body, line):
                        condition_region: u32 = destroyed_region_of_expression(condition, annotations, destroyed, borrow_names, borrow_regions, function_line, line.line)
                        return condition_region if condition_region != NO_REGION_BINDING
                        for nested_while in body:
                            region_id: u32 = destroyed_region_of_statement(nested_while, annotations, destroyed, borrow_names, borrow_regions, function_line, line.line)
                            return region_id if region_id != NO_REGION_BINDING
                        return NO_REGION_BINDING
                    Stmt.For(bind, variables, iterable, body, line):
                        iterable_region: u32 = destroyed_region_of_expression(iterable, annotations, destroyed, borrow_names, borrow_regions, function_line, line.line)
                        return iterable_region if iterable_region != NO_REGION_BINDING
                        for nested_for in body:
                            region_id: u32 = destroyed_region_of_statement(nested_for, annotations, destroyed, borrow_names, borrow_regions, function_line, line.line)
                            return region_id if region_id != NO_REGION_BINDING
                        return NO_REGION_BINDING
                    Stmt.Match(scrutinee, arms, line):
                        scrutinee_region: u32 = destroyed_region_of_expression(scrutinee, annotations, destroyed, borrow_names, borrow_regions, function_line, line.line)
                        return scrutinee_region if scrutinee_region != NO_REGION_BINDING
                        for arm in arms:
                            guard_region: u32 = destroyed_region_of_expression(arm.guard, annotations, destroyed, borrow_names, borrow_regions, function_line, line.line)
                            return guard_region if guard_region != NO_REGION_BINDING
                            for nested_arm in arm.body:
                                region_id: u32 = destroyed_region_of_statement(nested_arm, annotations, destroyed, borrow_names, borrow_regions, function_line, line.line)
                                return region_id if region_id != NO_REGION_BINDING
                        return NO_REGION_BINDING
                    _:
                        return NO_REGION_BINDING


        def destroyed_region_of_expression(expression: Ast::Expr, annotations: darray[Ast::LocalRegionAnnotation]&, destroyed: darray[u32]&, borrow_names: darray[sview]&, borrow_regions: darray[u32]&, function_line: u32, use_line: u32) -> u32:
            can Abort.Panic:
                match expression:
                    Expr.Ident(name, line):
                        region: u32 = destroyed_annotation_region_id_of_name(annotations, name, destroyed, function_line, use_line)
                        return region if region != NO_REGION_BINDING else destroyed_alias_region(name, borrow_names, borrow_regions, destroyed)
                    Expr.Field(receiver, field, line):
                        return destroyed_region_of_expression(receiver, annotations, destroyed, borrow_names, borrow_regions, function_line, use_line)
                    Expr.Scope(base, name, line):
                        return destroyed_region_of_expression(base, annotations, destroyed, borrow_names, borrow_regions, function_line, use_line)
                    Expr.Index(object, index, line):
                        object_region: u32 = destroyed_region_of_expression(object, annotations, destroyed, borrow_names, borrow_regions, function_line, use_line)
                        return object_region if object_region != NO_REGION_BINDING
                        return destroyed_region_of_expression(index, annotations, destroyed, borrow_names, borrow_regions, function_line, use_line)
                    Expr.IndexN(object, arguments, line):
                        object_region: u32 = destroyed_region_of_expression(object, annotations, destroyed, borrow_names, borrow_regions, function_line, use_line)
                        return object_region if object_region != NO_REGION_BINDING
                        for argument in arguments:
                            argument_region: u32 = destroyed_region_of_expression(argument, annotations, destroyed, borrow_names, borrow_regions, function_line, use_line)
                            return argument_region if argument_region != NO_REGION_BINDING
                        return NO_REGION_BINDING
                    Expr.Slice(object, start, end, line):
                        object_region: u32 = destroyed_region_of_expression(object, annotations, destroyed, borrow_names, borrow_regions, function_line, use_line)
                        return object_region if object_region != NO_REGION_BINDING
                        start_region: u32 = destroyed_region_of_expression(start, annotations, destroyed, borrow_names, borrow_regions, function_line, use_line)
                        return start_region if start_region != NO_REGION_BINDING
                        return destroyed_region_of_expression(end, annotations, destroyed, borrow_names, borrow_regions, function_line, use_line)
                    Expr.Unary(operator, operand, line) | Expr.Move(operand, line) | Expr.RegionNew(operand, _, line):
                        return destroyed_region_of_expression(operand, annotations, destroyed, borrow_names, borrow_regions, function_line, use_line)
                    Expr.Paren(inner, line):
                        return destroyed_region_of_expression(inner, annotations, destroyed, borrow_names, borrow_regions, function_line, use_line)
                    Expr.Call(callee, arguments, argument_names, line):
                        callee_region: u32 = destroyed_region_of_expression(callee, annotations, destroyed, borrow_names, borrow_regions, function_line, use_line)
                        return callee_region if callee_region != NO_REGION_BINDING
                        for argument in arguments:
                            argument_region: u32 = destroyed_region_of_expression(argument, annotations, destroyed, borrow_names, borrow_regions, function_line, use_line)
                            return argument_region if argument_region != NO_REGION_BINDING
                        return NO_REGION_BINDING
                    Expr.Catch(guarded, arms, line):
                        guarded_region: u32 = destroyed_region_of_expression(guarded, annotations, destroyed, borrow_names, borrow_regions, function_line, use_line)
                        return guarded_region if guarded_region != NO_REGION_BINDING
                        for arm in arms:
                            guard_region: u32 = destroyed_region_of_expression(arm.guard, annotations, destroyed, borrow_names, borrow_regions, function_line, use_line)
                            return guard_region if guard_region != NO_REGION_BINDING
                            for statement in arm.body:
                                region_id: u32 = destroyed_region_of_statement(statement, annotations, destroyed, borrow_names, borrow_regions, function_line, use_line)
                                return region_id if region_id != NO_REGION_BINDING
                        return NO_REGION_BINDING
                    Expr.GetElse(guarded, recovery, line):
                        guarded_region: u32 = destroyed_region_of_expression(guarded, annotations, destroyed, borrow_names, borrow_regions, function_line, use_line)
                        return guarded_region if guarded_region != NO_REGION_BINDING
                        for statement in recovery:
                            region_id: u32 = destroyed_region_of_statement(statement, annotations, destroyed, borrow_names, borrow_regions, function_line, use_line)
                            return region_id if region_id != NO_REGION_BINDING
                        return NO_REGION_BINDING
                    Expr.Binary(left, operator, right, line):
                        left_region: u32 = destroyed_region_of_expression(left, annotations, destroyed, borrow_names, borrow_regions, function_line, use_line)
                        return left_region if left_region != NO_REGION_BINDING
                        return destroyed_region_of_expression(right, annotations, destroyed, borrow_names, borrow_regions, function_line, use_line)
                    Expr.If(condition, then_value, else_value, line):
                        condition_region: u32 = destroyed_region_of_expression(condition, annotations, destroyed, borrow_names, borrow_regions, function_line, use_line)
                        return condition_region if condition_region != NO_REGION_BINDING
                        then_region: u32 = destroyed_region_of_expression(then_value, annotations, destroyed, borrow_names, borrow_regions, function_line, use_line)
                        return then_region if then_region != NO_REGION_BINDING
                        return destroyed_region_of_expression(else_value, annotations, destroyed, borrow_names, borrow_regions, function_line, use_line)
                    Expr.Refinement(base, predicate, line):
                        base_region: u32 = destroyed_region_of_expression(base, annotations, destroyed, borrow_names, borrow_regions, function_line, use_line)
                        return base_region if base_region != NO_REGION_BINDING
                        return destroyed_region_of_expression(predicate, annotations, destroyed, borrow_names, borrow_regions, function_line, use_line)
                    Expr.Tuple(elements, line) | Expr.Array(elements, line) | Expr.SetLit(elements, line):
                        for element in elements:
                            region: u32 = destroyed_region_of_expression(element, annotations, destroyed, borrow_names, borrow_regions, function_line, use_line)
                            return region if region != NO_REGION_BINDING
                        return NO_REGION_BINDING
                    Expr.DictLit(entries, line):
                        for entry in entries:
                            key_region: u32 = destroyed_region_of_expression(entry.key, annotations, destroyed, borrow_names, borrow_regions, function_line, use_line)
                            return key_region if key_region != NO_REGION_BINDING
                            value_region: u32 = destroyed_region_of_expression(entry.value, annotations, destroyed, borrow_names, borrow_regions, function_line, use_line)
                            return value_region if value_region != NO_REGION_BINDING
                        return NO_REGION_BINDING
                    Expr.Construct(type_expression, fields, line):
                        for field in fields:
                            region: u32 = destroyed_region_of_expression(field.value, annotations, destroyed, borrow_names, borrow_regions, function_line, use_line)
                            return region if region != NO_REGION_BINDING
                        return NO_REGION_BINDING
                    Expr.RecordUpdate(base, fields, line):
                        base_region: u32 = destroyed_region_of_expression(base, annotations, destroyed, borrow_names, borrow_regions, function_line, use_line)
                        return base_region if base_region != NO_REGION_BINDING
                        for field in fields:
                            region: u32 = destroyed_region_of_expression(field.value, annotations, destroyed, borrow_names, borrow_regions, function_line, use_line)
                            return region if region != NO_REGION_BINDING
                        return NO_REGION_BINDING
                    Expr.Block(statements, value, captures, line):
                        for statement in statements:
                            region_id: u32 = destroyed_region_of_statement(statement, annotations, destroyed, borrow_names, borrow_regions, function_line, use_line)
                            return region_id if region_id != NO_REGION_BINDING
                        return destroyed_region_of_expression(value, annotations, destroyed, borrow_names, borrow_regions, function_line, use_line)
                    Expr.Match(scrutinee, arms, line):
                        scrutinee_region: u32 = destroyed_region_of_expression(scrutinee, annotations, destroyed, borrow_names, borrow_regions, function_line, use_line)
                        return scrutinee_region if scrutinee_region != NO_REGION_BINDING
                        for arm in arms:
                            guard_region: u32 = destroyed_region_of_expression(arm.guard, annotations, destroyed, borrow_names, borrow_regions, function_line, use_line)
                            return guard_region if guard_region != NO_REGION_BINDING
                            for statement in arm.body:
                                region_id: u32 = destroyed_region_of_statement(statement, annotations, destroyed, borrow_names, borrow_regions, function_line, use_line)
                                return region_id if region_id != NO_REGION_BINDING
                        return NO_REGION_BINDING
                    Expr.Comprehension(variable, iterable, condition, body, line):
                        iterable_region: u32 = destroyed_region_of_expression(iterable, annotations, destroyed, borrow_names, borrow_regions, function_line, use_line)
                        return iterable_region if iterable_region != NO_REGION_BINDING
                        condition_region: u32 = destroyed_region_of_expression(condition, annotations, destroyed, borrow_names, borrow_regions, function_line, use_line)
                        return condition_region if condition_region != NO_REGION_BINDING
                        return destroyed_region_of_expression(body, annotations, destroyed, borrow_names, borrow_regions, function_line, use_line)
                    Expr.StaticEffectCall(effect_type, operation, candidates, arguments, argument_names, line):
                        effect_region: u32 = destroyed_region_of_expression(effect_type, annotations, destroyed, borrow_names, borrow_regions, function_line, use_line)
                        return effect_region if effect_region != NO_REGION_BINDING
                        for candidate in candidates:
                            for capture in candidate.captures:
                                region_id: u32 = destroyed_region_of_expression(capture, annotations, destroyed, borrow_names, borrow_regions, function_line, use_line)
                                return region_id if region_id != NO_REGION_BINDING
                        for argument in arguments:
                            region_id: u32 = destroyed_region_of_expression(argument, annotations, destroyed, borrow_names, borrow_regions, function_line, use_line)
                            return region_id if region_id != NO_REGION_BINDING
                        return NO_REGION_BINDING
                    Expr.Lambda(parameters, body, line):
                        for statement in body:
                            region_id: u32 = destroyed_region_of_statement(statement, annotations, destroyed, borrow_names, borrow_regions, function_line, use_line)
                            return region_id if region_id != NO_REGION_BINDING
                        return NO_REGION_BINDING
                    _:
                        return NO_REGION_BINDING

        # The root VALUE name of a use expression (`values[0]` -> "values"), for
        # stage0's cannot-be-used message.
        def destroyed_use_root_name(expression: Ast::Expr) -> sview:
            can Memory.Allocate, Abort.Panic:
                return match expression:
                    Expr.Ident(root_name, root_line): root_name
                    Expr.Field(object, field, field_line): destroyed_use_root_name(object)
                    Expr.Index(object, index, index_line): destroyed_use_root_name(object)
                    Expr.IndexN(object, arguments, indexn_line): destroyed_use_root_name(object)
                    Expr.Slice(object, start, end, slice_line): destroyed_use_root_name(object)
                    Expr.Unary(operator, operand, unary_line): destroyed_use_root_name(operand)
                    Expr.Paren(inner, paren_line): destroyed_use_root_name(inner)
                    Expr.Call(callee, arguments, argument_names, call_line):
                        for argument in arguments:
                            root: sview = destroyed_use_root_name(argument)
                            return root if root != ""
                        return destroyed_use_root_name(callee)
                    Expr.Refinement(base, predicate, line):
                        base_root: sview = destroyed_use_root_name(base)
                        return base_root if base_root != ""
                        return destroyed_use_root_name(predicate)
                    Expr.Catch(guarded, _, line) | Expr.GetElse(guarded, _, line):
                        return destroyed_use_root_name(guarded)
                    _: ""

        # Explicit arena teardown invalidates values carrying that arena's region just
        # like leaving a lexical `region` block does. Rewind is conservatively treated
        # as invalidating the whole arena because this pass does not track allocation
        # epochs or the rewind mark's position.
        def destroyed_arena_invalidation(expression: Ast::Expr) -> sview:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, line):
                        operation: sview = destroyed_direct_call_name(callee)
                        invalidates_all: bool = operation == "arena_free" or operation == "arena_reset" or operation == "arena_rewind"
                        if invalidates_all and arguments.count > 0:
                            return destroyed_use_root_name(arguments[0])
                        return ""
                    Expr.Paren(inner, line) | Expr.Move(inner, line):
                        return destroyed_arena_invalidation(inner)
                    _:
                        return ""

        # Named arguments retain source order in the AST, so the formal index is not
        # necessarily the source argument index (`f(target: a, keep: b)`). Positional
        # arguments fill the leading unassigned formals; labels select by formal name.
        def destroyed_summary_source_parameters(source_name: sview, params: darray[Ast::ParamDecl]&, alias_names: darray[sview]&, alias_params: darray[u32]&, out: mutable darray[u32]&) -> void:
            can Memory.Allocate, Abort.Panic:
                return if source_name == ""
                for parameter_index in 0..<params.count |out, params, source_name|:
                    if params[parameter_index].name == source_name and destroyed_type_is_arena_reference(params[parameter_index].type_expression):
                        index: u32 = parameter_index.u32()
                        out.push(index) if not any existing in out where existing == index
                for alias_index in 0..<alias_names.count |out, alias_names, alias_params, source_name|:
                    if alias_names[alias_index] == source_name and alias_index < alias_params.count:
                        index: u32 = alias_params[alias_index]
                        out.push(index) if index < params.count.u32() and destroyed_type_is_arena_reference(params[index.usize()].type_expression) and not any existing in out where existing == index

        def destroyed_summary_add_source_parameters(expression: Ast::Expr, params: darray[Ast::ParamDecl]&, alias_names: darray[sview]&, alias_params: darray[u32]&, out: mutable darray[u32]&) -> void:
            can Memory.Allocate, Abort.Panic:
                source_name: sview = destroyed_arena_owner_source_name(expression)
                source_count: usize = out.count
                destroyed_summary_source_parameters(source_name, params, alias_names, alias_params, out)
                return if source_name != ""
                could_be_reference: bool = match expression:
                    Expr.Call(_, _, _, _) | Expr.Field(_, _, _) | Expr.Scope(_, _, _) | Expr.Index(_, _, _) | Expr.IndexN(_, _, _) | Expr.Slice(_, _, _, _) | Expr.RegionNew(_, _, _) | Expr.If(_, _, _, _) | Expr.Match(_, _, _) | Expr.Catch(_, _, _) | Expr.GetElse(_, _, _) | Expr.Block(_, _, _, _) | Expr.Refinement(_, _, _) | Expr.Construct(_, _, _) | Expr.RecordUpdate(_, _, _): true
                    Expr.Unary(operator, _, _): operator == TokenKind.Ampersand
                    Expr.Move(_, _) | Expr.Paren(_, _): true
                    Expr.Binary(_, _, _, _): true
                    _: false
                return if not could_be_reference or out.count > source_count
                for parameter_index in 0..<params.count |out, params|:
                    index: u32 = parameter_index.u32()
                    out.push(index) if destroyed_type_is_arena_reference(params[parameter_index].type_expression) and not any existing in out where existing == index


        def destroyed_summary_add_alias(name: sview, parameter_index: u32, alias_names: mutable darray[sview]&, alias_params: mutable darray[u32]&, changed: mutable bool&) -> void:
            can Memory.Allocate, Abort.Panic:
                exists: mutable bool = false
                for index in 0..<alias_names.count |exists, alias_names, alias_params, name, parameter_index|:
                    exists <- true if alias_names[index] == name and index < alias_params.count and alias_params[index] == parameter_index
                return if exists
                alias_names.push(name)
                alias_params.push(parameter_index)
                changed <- true


        def destroyed_summary_argument_index(parameter_name: sview, positional_index: u32, arguments: darray[Ast::Expr], argument_names: darray[sview]) -> u32:
            can Abort.Panic:
                for argument_index in 0..<argument_names.count:
                    return argument_index.u32() if argument_names[argument_index] == parameter_name
                named_seen: mutable bool = false
                for argument_name in argument_names |named_seen|:
                    named_seen <- true if argument_name != ""
                return NO_ARENA_SUMMARY_PARAM if named_seen
                return positional_index


        def destroyed_collect_local_function_names(declarations: darray[Ast::Decl], out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |out|:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            out.push(name) if not any existing in out where existing == name
                        Decl.Module(name, body, line) | Decl.Scoped(body, line):
                            destroyed_collect_local_function_names(body, out)
                        _:
                            pass


        # Resolver references carry a BindingId owner, so local callable values are
        # recognized in the current function without mistaking an identically named
        # top-level function in another scope for an indirect call.
        def destroyed_collect_local_reference_names(function_name: sview, function_position: Ast::Pos, table: SymbolTable&, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                function_owner: mutable DeclId = DeclId{value: 0}
                owner_found: mutable bool = false
                for symbol_index in 0..<table.symbols.count |function_name, function_position, table, function_owner, owner_found|:
                    symbol: Symbol& = &table.symbols[symbol_index]
                    if symbol.kind == SymbolKind.Func and symbol.name == function_name and symbol.offset == function_position.offset:
                        function_owner <- symbol.id
                        owner_found <- true
                return if not owner_found
                for reference_index in 0..<table.ref_binding_ids.count |function_owner, table, out|:
                    binding: BindingId = table.ref_binding_ids[reference_index]
                    if binding.owner.value == function_owner.value and reference_index < table.ref_name.count:
                        name: sview = table.ref_name[reference_index]
                        out.push(name) if not any existing in out where existing == name


        def destroyed_collect_opaque_function_signatures(declarations: darray[Ast::Decl], names: mutable darray[sview]&, starts: mutable darray[usize]&, arities: mutable darray[u32]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |names, starts, arities|:
                    match declaration:
                        Decl.Extern(name, param_start, arity, variadic, callable, return_type_name, decorators, line):
                            names.push(name)
                            starts.push(param_start.usize())
                            arities.push(arity)
                        Decl.Module(name, body, line) | Decl.Scoped(body, line):
                            destroyed_collect_opaque_function_signatures(body, names, starts, arities)
                        _:
                            pass


        def destroyed_apply_opaque_external_invalidation(operation: sview, arguments: darray[Ast::Expr], argument_names: darray[sview], external_names: darray[sview]&, external_starts: darray[usize]&, external_arities: darray[u32]&, extern_params: darray[Ast::ExternParam]&, annotations: darray[Ast::LocalRegionAnnotation]&, function_line: u32, use_line: u32, destroyed: mutable darray[u32]&, alias_ids: darray[u32]&, alias_roots: darray[u32]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for signature_index in 0..<external_names.count |operation, arguments, argument_names, external_names, external_starts, external_arities, extern_params, annotations, function_line, use_line, destroyed, alias_ids, alias_roots|:
                    if external_names[signature_index] == operation and signature_index < external_starts.count and signature_index < external_arities.count:
                        for formal_index in 0..<external_arities[signature_index].usize() |formal_index, arguments, argument_names, external_starts, extern_params, annotations, function_line, use_line, destroyed, alias_ids, alias_roots|:
                            param_slot: usize = external_starts[signature_index] + formal_index
                            if param_slot < extern_params.count:
                                external_param: Ast::ExternParam = extern_params[param_slot]
                                if external_param.is_ref and external_param.type_name == "Arena":
                                    argument_index: u32 = destroyed_summary_argument_index(external_param.name, formal_index.u32(), arguments, argument_names)
                                    if argument_index != NO_ARENA_SUMMARY_PARAM and argument_index.usize() < arguments.count:
                                        actual_name: sview = destroyed_arena_owner_source_name(arguments[argument_index.usize()])
                                        binding_id: u32 = region_binding_id_at(annotations, actual_name, function_line, use_line) if actual_name != "" else NO_REGION_BINDING
                                        if binding_id != NO_REGION_BINDING:
                                            destroyed_mark_region_binding(destroyed, binding_id, alias_ids, alias_roots)
                                        else:
                                            destroyed_push_all(destroyed)
                                    else:
                                        destroyed_push_all(destroyed)
                            else:
                                destroyed_push_all(destroyed)


        # If a call target is not a local definition or declared extern, it may be a
        # function-valued local/parameter. Its body is opaque at this call site, so passing
        # a known Arena owner is an invalidation boundary even when the callback name itself
        # is not statically tied to a reset helper.
        def destroyed_apply_unresolved_owner_call(operation: sview, callee: Ast::Expr, arguments: darray[Ast::Expr], local_function_names: darray[sview]&, external_names: darray[sview]&, annotations: darray[Ast::LocalRegionAnnotation]&, function_line: u32, use_line: u32, destroyed: mutable darray[u32]&, alias_ids: darray[u32]&, alias_roots: darray[u32]&) -> void:
            can Memory.Allocate, Abort.Panic:
                is_known_definition: bool = any local_name in local_function_names where local_name == operation
                is_known_external: bool = any external_name in external_names where external_name == operation
                is_builtin_arena_operation: bool = operation == "arena_free" or operation == "arena_reset" or operation == "arena_rewind"
                return if is_known_definition or is_known_external or is_builtin_arena_operation
                match callee:
                    Expr.Field(receiver, _, line) | Expr.Scope(receiver, _, line):
                        receiver_name: sview = destroyed_arena_owner_source_name(receiver)
                        receiver_id: u32 = region_binding_id_at(annotations, receiver_name, function_line, use_line) if receiver_name != "" else NO_REGION_BINDING
                        destroyed_mark_region_binding(destroyed, receiver_id, alias_ids, alias_roots) if receiver_id != NO_REGION_BINDING
                    _:
                        pass
                for argument in arguments |annotations, function_line, use_line, destroyed, alias_ids, alias_roots|:
                    actual_name: sview = destroyed_arena_owner_source_name(argument)
                    binding_id: u32 = region_binding_id_at(annotations, actual_name, function_line, use_line) if actual_name != "" else NO_REGION_BINDING
                    destroyed_mark_region_binding(destroyed, binding_id, alias_ids, alias_roots) if binding_id != NO_REGION_BINDING


        def destroyed_summary_collect_aliases(statements: darray[Ast::Stmt], params: darray[Ast::ParamDecl]&, alias_names: mutable darray[sview]&, alias_params: mutable darray[u32]&, changed: mutable bool&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |params, alias_names, alias_params, changed|:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            source_params: mutable darray[u32] = []
                            destroyed_summary_source_parameters(destroyed_arena_owner_source_name(value), params, alias_names, alias_params, source_params)
                            for parameter_index in source_params |alias_names, alias_params, name, changed|:
                                destroyed_summary_add_alias(name, parameter_index, alias_names, alias_params, changed)
                        Stmt.Assign(target, operator, value, line):
                            target_name: sview = destroyed_use_root_name(target)
                            source_params: mutable darray[u32] = []
                            destroyed_summary_source_parameters(destroyed_arena_owner_source_name(value), params, alias_names, alias_params, source_params)
                            for parameter_index in source_params |alias_names, alias_params, target_name, changed|:
                                destroyed_summary_add_alias(target_name, parameter_index, alias_names, alias_params, changed) if target_name != ""
                        Stmt.Block(kind, clause, binding, body, line):
                            destroyed_summary_collect_aliases(body, params, alias_names, alias_params, changed)
                        Stmt.If(condition, then_body, else_body, line):
                            destroyed_summary_collect_aliases(then_body, params, alias_names, alias_params, changed)
                            destroyed_summary_collect_aliases(else_body, params, alias_names, alias_params, changed)
                        Stmt.While(condition, body, line):
                            destroyed_summary_collect_aliases(body, params, alias_names, alias_params, changed)
                        Stmt.For(bind, variables, iterable, body, line):
                            destroyed_summary_collect_aliases(body, params, alias_names, alias_params, changed)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms:
                                destroyed_summary_collect_aliases(arm.body, params, alias_names, alias_params, changed)
                        _:
                            pass


        def destroyed_summary_collect_expression(expression: Ast::Expr, params: darray[Ast::ParamDecl]&, alias_names: darray[sview]&, alias_params: darray[u32]&, summary_names: darray[sview]&, summary_params: darray[u32]&, summary_formals: darray[sview]&, local_function_names: darray[sview]&, opaque_function_names: darray[sview]&, out: mutable darray[u32]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, line):
                        operation: sview = destroyed_direct_call_name(callee)
                        # Generic handler specialization lowers abstract operations to
                        # generated direct calls. Their capture parameters are not present
                        # in the source call's ordinary argument list.
                        out.push(NO_ARENA_SUMMARY_PARAM) if destroyed_is_generated_effect_call(operation) and not any existing in out where existing == NO_ARENA_SUMMARY_PARAM
                        if operation == "arena_free" or operation == "arena_reset" or operation == "arena_rewind":
                            if arguments.count > 0:
                                sources: mutable darray[u32] = []
                                destroyed_summary_source_parameters(destroyed_arena_owner_source_name(arguments[0]), params, alias_names, alias_params, sources)
                                for parameter_index in sources |out|:
                                    out.push(parameter_index) if not any existing in out where existing == parameter_index
                                if sources.count == 0:
                                    for parameter_index in 0..<params.count |out, params|:
                                        out.push(parameter_index.u32()) if destroyed_type_is_arena_reference(params[parameter_index].type_expression) and not any existing in out where existing == parameter_index.u32()
                        for summary_index in 0..<summary_names.count |out, summary_names, summary_params, summary_formals, operation, arguments, argument_names, params, alias_names, alias_params|:
                            if summary_names[summary_index] == operation and summary_index < summary_params.count and summary_index < summary_formals.count:
                                if summary_params[summary_index] == NO_ARENA_SUMMARY_PARAM:
                                    out.push(NO_ARENA_SUMMARY_PARAM) if not any existing in out where existing == NO_ARENA_SUMMARY_PARAM
                                else:
                                    argument_index: u32 = destroyed_summary_argument_index(summary_formals[summary_index], summary_params[summary_index], arguments, argument_names)
                                    if argument_index != NO_ARENA_SUMMARY_PARAM and argument_index.usize() < arguments.count:
                                        sources: mutable darray[u32] = []
                                        destroyed_summary_source_parameters(destroyed_arena_owner_source_name(arguments[argument_index.usize()]), params, alias_names, alias_params, sources)
                                        for parameter_index in sources |out|:
                                            out.push(parameter_index) if not any existing in out where existing == parameter_index
                                        if sources.count == 0:
                                            for parameter_index in 0..<params.count |out, params|:
                                                out.push(parameter_index.u32()) if destroyed_type_is_arena_reference(params[parameter_index].type_expression) and not any existing in out where existing == parameter_index.u32()
                                    else:
                                        for parameter_index in 0..<params.count |out, params|:
                                            out.push(parameter_index.u32()) if destroyed_type_is_arena_reference(params[parameter_index].type_expression) and not any existing in out where existing == parameter_index.u32()
                        # A bare parameter name in callee position is a callable by the time
                        # this pass runs. Do not re-parse its fn type here: parser type nodes
                        # have multiple legal wrappers, and missing this effect would let a
                        # wrapper call a reset-capable callback without exporting the summary.
                        is_parameter_call: bool = any parameter in params where parameter.name == operation
                        if is_parameter_call:
                            out.push(NO_ARENA_SUMMARY_PARAM) if not any existing in out where existing == NO_ARENA_SUMMARY_PARAM
                            for parameter_index in 0..<params.count |out, params|:
                                out.push(parameter_index.u32()) if destroyed_type_is_arena_reference(params[parameter_index].type_expression) and not any existing in out where existing == parameter_index.u32()
                        is_arena_primitive: bool = operation == "arena_free" or operation == "arena_reset" or operation == "arena_rewind"
                        is_known_local: bool = any function_name in local_function_names where function_name == operation
                        is_known_external: bool = any external_name in opaque_function_names where external_name == operation
                        # Handler rewrites and compiler-generated adapters may call a
                        # non-declaration target while forwarding a captured Arena&. Carry
                        # that explicit owner through this summary just as call-site
                        # invalidation does; otherwise the hidden callee breaks the effect
                        # chain between the specialized clone and its caller.
                        if not is_arena_primitive and not is_known_local and not is_known_external:
                            for argument in arguments |params, alias_names, alias_params, out|:
                                sources: mutable darray[u32] = []
                                destroyed_summary_source_parameters(destroyed_arena_owner_source_name(argument), params, alias_names, alias_params, sources)
                                for parameter_index in sources |out|:
                                    out.push(parameter_index) if not any existing in out where existing == parameter_index
                        destroyed_summary_collect_expression(callee, params, alias_names, alias_params, summary_names, summary_params, summary_formals, local_function_names, opaque_function_names, out)
                        for argument in arguments |params, alias_names, alias_params, summary_names, summary_params, summary_formals, local_function_names, opaque_function_names, out|:
                            destroyed_summary_collect_expression(argument, params, alias_names, alias_params, summary_names, summary_params, summary_formals, local_function_names, opaque_function_names, out)
                    Expr.StaticEffectCall(effect_type, operation, candidates, arguments, argument_names, line):
                        # Candidate handler bodies are not yet represented in the local
                        # function-summary table. They may mutate an arena captured by the
                        # installed handler even when the operation has no Arena& arguments.
                        out.push(NO_ARENA_SUMMARY_PARAM) if not any existing in out where existing == NO_ARENA_SUMMARY_PARAM
                        for argument in arguments |out, params, alias_names, alias_params|:
                            sources: mutable darray[u32] = []
                            destroyed_summary_source_parameters(destroyed_arena_owner_source_name(argument), params, alias_names, alias_params, sources)
                            for parameter_index in sources |out|:
                                out.push(parameter_index) if not any existing in out where existing == parameter_index
                        destroyed_summary_collect_expression(effect_type, params, alias_names, alias_params, summary_names, summary_params, summary_formals, local_function_names, opaque_function_names, out)
                        for argument in arguments |params, alias_names, alias_params, summary_names, summary_params, summary_formals, local_function_names, opaque_function_names, out|:
                            destroyed_summary_collect_expression(argument, params, alias_names, alias_params, summary_names, summary_params, summary_formals, local_function_names, opaque_function_names, out)
                    Expr.Slice(object, low, high, line):
                        destroyed_summary_collect_expression(object, params, alias_names, alias_params, summary_names, summary_params, summary_formals, local_function_names, opaque_function_names, out)
                        destroyed_summary_collect_expression(low, params, alias_names, alias_params, summary_names, summary_params, summary_formals, local_function_names, opaque_function_names, out)
                        destroyed_summary_collect_expression(high, params, alias_names, alias_params, summary_names, summary_params, summary_formals, local_function_names, opaque_function_names, out)
                    Expr.IndexN(object, arguments, line):
                        destroyed_summary_collect_expression(object, params, alias_names, alias_params, summary_names, summary_params, summary_formals, local_function_names, opaque_function_names, out)
                        for argument in arguments |params, alias_names, alias_params, summary_names, summary_params, summary_formals, local_function_names, opaque_function_names, out|:
                            destroyed_summary_collect_expression(argument, params, alias_names, alias_params, summary_names, summary_params, summary_formals, local_function_names, opaque_function_names, out)
                    Expr.RegionNew(inner, _, line):
                        destroyed_summary_collect_expression(inner, params, alias_names, alias_params, summary_names, summary_params, summary_formals, local_function_names, opaque_function_names, out)
                    Expr.Paren(inner, line) | Expr.Move(inner, line) | Expr.Unary(operator, inner, line):
                        destroyed_summary_collect_expression(inner, params, alias_names, alias_params, summary_names, summary_params, summary_formals, local_function_names, opaque_function_names, out)
                    Expr.Array(elements, line) | Expr.Tuple(elements, line) | Expr.SetLit(elements, line):
                        for element in elements |params, alias_names, alias_params, summary_names, summary_params, summary_formals, local_function_names, opaque_function_names, out|:
                            destroyed_summary_collect_expression(element, params, alias_names, alias_params, summary_names, summary_params, summary_formals, local_function_names, opaque_function_names, out)
                    Expr.DictLit(entries, line):
                        for entry in entries |params, alias_names, alias_params, summary_names, summary_params, summary_formals, local_function_names, opaque_function_names, out|:
                            destroyed_summary_collect_expression(entry.key, params, alias_names, alias_params, summary_names, summary_params, summary_formals, local_function_names, opaque_function_names, out)
                            destroyed_summary_collect_expression(entry.value, params, alias_names, alias_params, summary_names, summary_params, summary_formals, local_function_names, opaque_function_names, out)
                    Expr.Construct(type_expression, fields, line):
                        destroyed_summary_collect_expression(type_expression, params, alias_names, alias_params, summary_names, summary_params, summary_formals, local_function_names, opaque_function_names, out)
                        for field in fields |params, alias_names, alias_params, summary_names, summary_params, summary_formals, local_function_names, opaque_function_names, out|:
                            destroyed_summary_collect_expression(field.value, params, alias_names, alias_params, summary_names, summary_params, summary_formals, local_function_names, opaque_function_names, out)
                    Expr.RecordUpdate(base, fields, line):
                        destroyed_summary_collect_expression(base, params, alias_names, alias_params, summary_names, summary_params, summary_formals, local_function_names, opaque_function_names, out)
                        for field in fields |params, alias_names, alias_params, summary_names, summary_params, summary_formals, local_function_names, opaque_function_names, out|:
                            destroyed_summary_collect_expression(field.value, params, alias_names, alias_params, summary_names, summary_params, summary_formals, local_function_names, opaque_function_names, out)
                    Expr.If(condition, then_value, else_value, line):
                        destroyed_summary_collect_expression(condition, params, alias_names, alias_params, summary_names, summary_params, summary_formals, local_function_names, opaque_function_names, out)
                        destroyed_summary_collect_expression(then_value, params, alias_names, alias_params, summary_names, summary_params, summary_formals, local_function_names, opaque_function_names, out)
                        destroyed_summary_collect_expression(else_value, params, alias_names, alias_params, summary_names, summary_params, summary_formals, local_function_names, opaque_function_names, out)
                    Expr.Match(scrutinee, arms, line) | Expr.Catch(scrutinee, arms, line):
                        destroyed_summary_collect_expression(scrutinee, params, alias_names, alias_params, summary_names, summary_params, summary_formals, local_function_names, opaque_function_names, out)
                        for arm in arms |params, alias_names, alias_params, summary_names, summary_params, summary_formals, local_function_names, opaque_function_names, out|:
                            destroyed_summary_collect_expression(arm.guard, params, alias_names, alias_params, summary_names, summary_params, summary_formals, local_function_names, opaque_function_names, out)
                            destroyed_summary_collect_statements(arm.body, params, alias_names, alias_params, summary_names, summary_params, summary_formals, local_function_names, opaque_function_names, out)
                    Expr.Comprehension(variable, iterable, condition, body, line):
                        destroyed_summary_collect_expression(iterable, params, alias_names, alias_params, summary_names, summary_params, summary_formals, local_function_names, opaque_function_names, out)
                        destroyed_summary_collect_expression(condition, params, alias_names, alias_params, summary_names, summary_params, summary_formals, local_function_names, opaque_function_names, out)
                        destroyed_summary_collect_expression(body, params, alias_names, alias_params, summary_names, summary_params, summary_formals, local_function_names, opaque_function_names, out)
                    Expr.Refinement(base, predicate, line):
                        destroyed_summary_collect_expression(base, params, alias_names, alias_params, summary_names, summary_params, summary_formals, local_function_names, opaque_function_names, out)
                        destroyed_summary_collect_expression(predicate, params, alias_names, alias_params, summary_names, summary_params, summary_formals, local_function_names, opaque_function_names, out)
                    Expr.GetElse(guarded, recovery, line):
                        destroyed_summary_collect_expression(guarded, params, alias_names, alias_params, summary_names, summary_params, summary_formals, local_function_names, opaque_function_names, out)
                        destroyed_summary_collect_statements(recovery, params, alias_names, alias_params, summary_names, summary_params, summary_formals, local_function_names, opaque_function_names, out)
                    Expr.Block(statements, value, captures, line):
                        destroyed_summary_collect_statements(statements, params, alias_names, alias_params, summary_names, summary_params, summary_formals, local_function_names, opaque_function_names, out)
                        destroyed_summary_collect_expression(value, params, alias_names, alias_params, summary_names, summary_params, summary_formals, local_function_names, opaque_function_names, out)
                    Expr.Binary(left, operator, right, line) | Expr.Index(left, right, line):
                        destroyed_summary_collect_expression(left, params, alias_names, alias_params, summary_names, summary_params, summary_formals, local_function_names, opaque_function_names, out)
                        destroyed_summary_collect_expression(right, params, alias_names, alias_params, summary_names, summary_params, summary_formals, local_function_names, opaque_function_names, out)
                    Expr.Field(object, field, line) | Expr.Scope(object, field, line):
                        destroyed_summary_collect_expression(object, params, alias_names, alias_params, summary_names, summary_params, summary_formals, local_function_names, opaque_function_names, out)
                    _:
                        pass


        def destroyed_summary_collect_statements(statements: darray[Ast::Stmt], params: darray[Ast::ParamDecl]&, alias_names: darray[sview]&, alias_params: darray[u32]&, summary_names: darray[sview]&, summary_params: darray[u32]&, summary_formals: darray[sview]&, local_function_names: darray[sview]&, opaque_function_names: darray[sview]&, out: mutable darray[u32]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |params, alias_names, alias_params, summary_names, summary_params, summary_formals, local_function_names, opaque_function_names, out|:
                    match statement:
                        Stmt.Expr(expression, line):
                            destroyed_summary_collect_expression(expression, params, alias_names, alias_params, summary_names, summary_params, summary_formals, local_function_names, opaque_function_names, out)
                        Stmt.Block(kind, clause, binding, body, line):
                            destroyed_summary_collect_statements(body, params, alias_names, alias_params, summary_names, summary_params, summary_formals, local_function_names, opaque_function_names, out)
                        Stmt.VarDecl(name, type_expression, value, line):
                            destroyed_summary_collect_expression(value, params, alias_names, alias_params, summary_names, summary_params, summary_formals, local_function_names, opaque_function_names, out)
                        Stmt.Assign(target, operator, value, line):
                            destroyed_summary_collect_expression(target, params, alias_names, alias_params, summary_names, summary_params, summary_formals, local_function_names, opaque_function_names, out)
                            destroyed_summary_collect_expression(value, params, alias_names, alias_params, summary_names, summary_params, summary_formals, local_function_names, opaque_function_names, out)
                        Stmt.If(condition, then_body, else_body, line):
                            destroyed_summary_collect_expression(condition, params, alias_names, alias_params, summary_names, summary_params, summary_formals, local_function_names, opaque_function_names, out)
                            destroyed_summary_collect_statements(then_body, params, alias_names, alias_params, summary_names, summary_params, summary_formals, local_function_names, opaque_function_names, out)
                            destroyed_summary_collect_statements(else_body, params, alias_names, alias_params, summary_names, summary_params, summary_formals, local_function_names, opaque_function_names, out)
                        Stmt.While(condition, body, line):
                            destroyed_summary_collect_expression(condition, params, alias_names, alias_params, summary_names, summary_params, summary_formals, local_function_names, opaque_function_names, out)
                            destroyed_summary_collect_statements(body, params, alias_names, alias_params, summary_names, summary_params, summary_formals, local_function_names, opaque_function_names, out)
                        Stmt.For(bind, variables, iterable, body, line):
                            destroyed_summary_collect_expression(iterable, params, alias_names, alias_params, summary_names, summary_params, summary_formals, local_function_names, opaque_function_names, out)
                            destroyed_summary_collect_statements(body, params, alias_names, alias_params, summary_names, summary_params, summary_formals, local_function_names, opaque_function_names, out)
                        Stmt.Return(value, line):
                            destroyed_summary_collect_expression(returned, params, alias_names, alias_params, summary_names, summary_params, summary_formals, local_function_names, opaque_function_names, out) if value is returned
                        Stmt.Match(scrutinee, arms, line):
                            destroyed_summary_collect_expression(scrutinee, params, alias_names, alias_params, summary_names, summary_params, summary_formals, local_function_names, opaque_function_names, out)
                            for arm in arms |params, alias_names, alias_params, summary_names, summary_params, summary_formals, local_function_names, opaque_function_names, out|:
                                destroyed_summary_collect_statements(arm.body, params, alias_names, alias_params, summary_names, summary_params, summary_formals, local_function_names, opaque_function_names, out)
                        Stmt.Contract(kind, expression, line):
                            destroyed_summary_collect_expression(expression, params, alias_names, alias_params, summary_names, summary_params, summary_formals, local_function_names, opaque_function_names, out)
                        _:
                            pass


        def destroyed_collect_arena_invalidation_summaries(declarations: darray[Ast::Decl], summary_names: mutable darray[sview]&, summary_params: mutable darray[u32]&, summary_formals: mutable darray[sview]&, local_function_names: darray[sview]&, opaque_function_names: darray[sview]&, changed: mutable bool&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |summary_names, summary_params, summary_formals, local_function_names, opaque_function_names, changed|:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            # Scan every body. Function type aliases and wrappers may hide a
                            # callable parameter from the compact AST shape, but the call site
                            # itself still reveals a parameter invocation. Effect rows remain
                            # empty unless the body actually resets an arena or invokes one.
                            aliases: mutable darray[sview] = []
                            alias_params: mutable darray[u32] = []
                            collect_aliases: mutable bool = true
                            while collect_aliases |collect_aliases, body, params, aliases, alias_params|:
                                collect_aliases <- false
                                destroyed_summary_collect_aliases(body, params, aliases, alias_params, collect_aliases)
                            invalidated: mutable darray[u32] = []
                            destroyed_summary_collect_statements(body, params, aliases, alias_params, summary_names, summary_params, summary_formals, local_function_names, opaque_function_names, invalidated)
                            for parameter_index in invalidated |summary_names, summary_params, name, changed|:
                                exists: mutable bool = false
                                for row in 0..<summary_names.count |exists, summary_names, summary_params, name, parameter_index|:
                                    exists <- true if summary_names[row] == name and row < summary_params.count and summary_params[row] == parameter_index
                                if not exists:
                                    summary_names.push(name)
                                    summary_params.push(parameter_index)
                                    summary_formals.push("") if parameter_index == NO_ARENA_SUMMARY_PARAM else summary_formals.push(params[parameter_index.usize()].name)
                                    changed <- true
                        Decl.Module(name, body, line) | Decl.Scoped(body, line):
                            destroyed_collect_arena_invalidation_summaries(body, summary_names, summary_params, summary_formals, local_function_names, opaque_function_names, changed)
                        _:
                            pass


        def destroyed_apply_arena_invalidation(expression: Ast::Expr, annotations: darray[Ast::LocalRegionAnnotation]&, function_line: u32, use_line: u32, destroyed: mutable darray[u32]&, alias_ids: darray[u32]&, alias_roots: darray[u32]&, summary_names: darray[sview]&, summary_params: darray[u32]&, summary_formals: darray[sview]&, local_function_names: darray[sview]&, local_reference_names: darray[sview]&, opaque_function_names: darray[sview]&, opaque_function_starts: darray[usize]&, opaque_function_arities: darray[u32]&, extern_params: darray[Ast::ExternParam]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, line):
                        arena_region: sview = destroyed_arena_invalidation(expression)
                        if arena_region != "":
                            binding_id: u32 = region_binding_id_at(annotations, arena_region, function_line, use_line)
                            destroyed_mark_region_binding(destroyed, binding_id, alias_ids, alias_roots)
                        operation: sview = destroyed_direct_call_name(callee)
                        # Static handler clones use private generated call targets. The
                        # current AST side tables do not attach candidate capture effects
                        # to those edges, so fail closed across helper boundaries.
                        destroyed_push_all(destroyed) if destroyed_is_generated_effect_call(operation)
                        callable_name: sview = destroyed_lambda_alias_source(callee)
                        is_local_callable_call: bool = any local_reference in local_reference_names where local_reference == callable_name
                        if is_local_callable_call:
                            # A function-valued local may be a closure with additional captured
                            # owners beyond its explicit arguments. Without a callable effect
                            # proof, invalidate all tracked regions conservatively.
                            destroyed_push_all(destroyed)
                        for summary_index in 0..<summary_names.count |summary_names, summary_params, summary_formals, operation, arguments, argument_names, annotations, function_line, use_line, destroyed, alias_ids, alias_roots|:
                            if summary_names[summary_index] == operation and summary_index < summary_params.count and summary_index < summary_formals.count:
                                if summary_params[summary_index] == NO_ARENA_SUMMARY_PARAM:
                                    # The callee invokes an unknown function parameter. Its
                                    # closure may mutate any captured Arena, not just an
                                    # explicit Arena& argument; preserve that effect at callers.
                                    destroyed_push_all(destroyed)
                                else:
                                    argument_index: u32 = destroyed_summary_argument_index(summary_formals[summary_index], summary_params[summary_index], arguments, argument_names)
                                    if argument_index != NO_ARENA_SUMMARY_PARAM and argument_index.usize() < arguments.count:
                                        actual_name: sview = destroyed_arena_owner_source_name(arguments[argument_index.usize()])
                                        binding_id: u32 = region_binding_id_at(annotations, actual_name, function_line, use_line) if actual_name != "" else NO_REGION_BINDING
                                        if binding_id != NO_REGION_BINDING:
                                            destroyed_mark_region_binding(destroyed, binding_id, alias_ids, alias_roots)
                                        else:
                                            destroyed_push_all(destroyed)
                                    else:
                                        destroyed_push_all(destroyed)
                        destroyed_apply_opaque_external_invalidation(operation, arguments, argument_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params, annotations, function_line, use_line, destroyed, alias_ids, alias_roots)
                        destroyed_apply_unresolved_owner_call(operation, callee, arguments, local_function_names, opaque_function_names, annotations, function_line, use_line, destroyed, alias_ids, alias_roots)
                        destroyed_apply_arena_invalidation(callee, annotations, function_line, use_line, destroyed, alias_ids, alias_roots, summary_names, summary_params, summary_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params)
                        for argument in arguments |annotations, function_line, use_line, destroyed, alias_ids, alias_roots, summary_names, summary_params, summary_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params|:
                            destroyed_apply_arena_invalidation(argument, annotations, function_line, use_line, destroyed, alias_ids, alias_roots, summary_names, summary_params, summary_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params)
                    Expr.StaticEffectCall(effect_type, operation, candidates, arguments, argument_names, line):
                        # The selected handler can reset storage through an installation
                        # capture, which is invisible among the operation's explicit args.
                        # Until candidate effect summaries are part of the semantic facts,
                        # fail closed for all tracked arena dependencies.
                        destroyed_push_all(destroyed)
                        destroyed_apply_arena_invalidation(effect_type, annotations, function_line, use_line, destroyed, alias_ids, alias_roots, summary_names, summary_params, summary_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params)
                        for argument in arguments |annotations, function_line, use_line, destroyed, alias_ids, alias_roots, summary_names, summary_params, summary_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params|:
                            destroyed_apply_arena_invalidation(argument, annotations, function_line, use_line, destroyed, alias_ids, alias_roots, summary_names, summary_params, summary_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params)
                    Expr.Slice(object, low, high, line):
                        destroyed_apply_arena_invalidation(object, annotations, function_line, use_line, destroyed, alias_ids, alias_roots, summary_names, summary_params, summary_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params)
                        destroyed_apply_arena_invalidation(low, annotations, function_line, use_line, destroyed, alias_ids, alias_roots, summary_names, summary_params, summary_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params)
                        destroyed_apply_arena_invalidation(high, annotations, function_line, use_line, destroyed, alias_ids, alias_roots, summary_names, summary_params, summary_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params)
                    Expr.IndexN(object, arguments, line):
                        destroyed_apply_arena_invalidation(object, annotations, function_line, use_line, destroyed, alias_ids, alias_roots, summary_names, summary_params, summary_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params)
                        for argument in arguments |annotations, function_line, use_line, destroyed, alias_ids, alias_roots, summary_names, summary_params, summary_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params|:
                            destroyed_apply_arena_invalidation(argument, annotations, function_line, use_line, destroyed, alias_ids, alias_roots, summary_names, summary_params, summary_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params)
                    Expr.RegionNew(inner, _, line):
                        destroyed_apply_arena_invalidation(inner, annotations, function_line, use_line, destroyed, alias_ids, alias_roots, summary_names, summary_params, summary_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params)
                    Expr.Paren(inner, line) | Expr.Move(inner, line) | Expr.Unary(operator, inner, line):
                        destroyed_apply_arena_invalidation(inner, annotations, function_line, use_line, destroyed, alias_ids, alias_roots, summary_names, summary_params, summary_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params)
                    Expr.Array(elements, line) | Expr.Tuple(elements, line) | Expr.SetLit(elements, line):
                        for element in elements |annotations, function_line, use_line, destroyed, alias_ids, alias_roots, summary_names, summary_params, summary_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params|:
                            destroyed_apply_arena_invalidation(element, annotations, function_line, use_line, destroyed, alias_ids, alias_roots, summary_names, summary_params, summary_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params)
                    Expr.DictLit(entries, line):
                        for entry in entries |annotations, function_line, use_line, destroyed, alias_ids, alias_roots, summary_names, summary_params, summary_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params|:
                            destroyed_apply_arena_invalidation(entry.key, annotations, function_line, use_line, destroyed, alias_ids, alias_roots, summary_names, summary_params, summary_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params)
                            destroyed_apply_arena_invalidation(entry.value, annotations, function_line, use_line, destroyed, alias_ids, alias_roots, summary_names, summary_params, summary_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params)
                    Expr.Construct(type_expression, fields, line):
                        destroyed_apply_arena_invalidation(type_expression, annotations, function_line, use_line, destroyed, alias_ids, alias_roots, summary_names, summary_params, summary_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params)
                        for field in fields |annotations, function_line, use_line, destroyed, alias_ids, alias_roots, summary_names, summary_params, summary_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params|:
                            destroyed_apply_arena_invalidation(field.value, annotations, function_line, use_line, destroyed, alias_ids, alias_roots, summary_names, summary_params, summary_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params)
                    Expr.RecordUpdate(base, fields, line):
                        destroyed_apply_arena_invalidation(base, annotations, function_line, use_line, destroyed, alias_ids, alias_roots, summary_names, summary_params, summary_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params)
                        for field in fields |annotations, function_line, use_line, destroyed, alias_ids, alias_roots, summary_names, summary_params, summary_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params|:
                            destroyed_apply_arena_invalidation(field.value, annotations, function_line, use_line, destroyed, alias_ids, alias_roots, summary_names, summary_params, summary_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params)
                    Expr.If(condition, then_value, else_value, line):
                        destroyed_apply_arena_invalidation(condition, annotations, function_line, use_line, destroyed, alias_ids, alias_roots, summary_names, summary_params, summary_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params)
                        destroyed_apply_arena_invalidation(then_value, annotations, function_line, use_line, destroyed, alias_ids, alias_roots, summary_names, summary_params, summary_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params)
                        destroyed_apply_arena_invalidation(else_value, annotations, function_line, use_line, destroyed, alias_ids, alias_roots, summary_names, summary_params, summary_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params)
                    Expr.Match(scrutinee, arms, line) | Expr.Catch(scrutinee, arms, line):
                        destroyed_apply_arena_invalidation(scrutinee, annotations, function_line, use_line, destroyed, alias_ids, alias_roots, summary_names, summary_params, summary_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params)
                        for arm in arms |annotations, function_line, use_line, destroyed, alias_ids, alias_roots, summary_names, summary_params, summary_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params|:
                            destroyed_apply_arena_invalidation(arm.guard, annotations, function_line, use_line, destroyed, alias_ids, alias_roots, summary_names, summary_params, summary_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params)
                            destroyed_apply_arena_invalidation_statements(arm.body, annotations, function_line, destroyed, alias_ids, alias_roots, summary_names, summary_params, summary_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params)
                    Expr.Comprehension(variable, iterable, condition, body, line):
                        destroyed_apply_arena_invalidation(iterable, annotations, function_line, use_line, destroyed, alias_ids, alias_roots, summary_names, summary_params, summary_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params)
                        destroyed_apply_arena_invalidation(condition, annotations, function_line, use_line, destroyed, alias_ids, alias_roots, summary_names, summary_params, summary_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params)
                        destroyed_apply_arena_invalidation(body, annotations, function_line, use_line, destroyed, alias_ids, alias_roots, summary_names, summary_params, summary_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params)
                    Expr.Refinement(base, predicate, line):
                        destroyed_apply_arena_invalidation(base, annotations, function_line, use_line, destroyed, alias_ids, alias_roots, summary_names, summary_params, summary_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params)
                        destroyed_apply_arena_invalidation(predicate, annotations, function_line, use_line, destroyed, alias_ids, alias_roots, summary_names, summary_params, summary_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params)
                    Expr.GetElse(guarded, recovery, line):
                        destroyed_apply_arena_invalidation(guarded, annotations, function_line, use_line, destroyed, alias_ids, alias_roots, summary_names, summary_params, summary_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params)
                        destroyed_apply_arena_invalidation_statements(recovery, annotations, function_line, destroyed, alias_ids, alias_roots, summary_names, summary_params, summary_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params)
                    Expr.Block(statements, value, captures, line):
