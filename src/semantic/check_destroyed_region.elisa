                        destroyed_apply_arena_invalidation(value, annotations, function_line, use_line, destroyed, alias_ids, alias_roots, summary_names, summary_params, summary_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params)
                    Expr.Binary(left, operator, right, line) | Expr.Index(left, right, line):
                        destroyed_apply_arena_invalidation(left, annotations, function_line, use_line, destroyed, alias_ids, alias_roots, summary_names, summary_params, summary_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params)
                        destroyed_apply_arena_invalidation(right, annotations, function_line, use_line, destroyed, alias_ids, alias_roots, summary_names, summary_params, summary_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params)
                    Expr.Field(object, field, line) | Expr.Scope(object, field, line):
                        destroyed_apply_arena_invalidation(object, annotations, function_line, use_line, destroyed, alias_ids, alias_roots, summary_names, summary_params, summary_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params)
                    _:
                        pass


        def destroyed_apply_arena_invalidation_statements(statements: darray[Ast::Stmt], annotations: darray[Ast::LocalRegionAnnotation]&, function_line: u32, destroyed: mutable darray[u32]&, alias_ids: darray[u32]&, alias_roots: darray[u32]&, summary_names: darray[sview]&, summary_params: darray[u32]&, summary_formals: darray[sview]&, local_function_names: darray[sview]&, local_reference_names: darray[sview]&, opaque_function_names: darray[sview]&, opaque_function_starts: darray[usize]&, opaque_function_arities: darray[u32]&, extern_params: darray[Ast::ExternParam]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |annotations, function_line, destroyed, alias_ids, alias_roots, summary_names, summary_params, summary_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params|:
                    match statement:
                        Stmt.Block("destroy", clause, binding, body, position):
                            binding_id: u32 = region_binding_id_at(annotations, clause[0], function_line, position.line) if clause.count > 0 else NO_REGION_BINDING
                            destroyed_mark_region_binding(destroyed, binding_id, alias_ids, alias_roots) if clause.count > 0
                            destroyed_apply_arena_invalidation_statements(body, annotations, function_line, destroyed, alias_ids, alias_roots, summary_names, summary_params, summary_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params)
                        Stmt.Block(kind, clause, binding, body, position):
                            destroyed_apply_arena_invalidation_statements(body, annotations, function_line, destroyed, alias_ids, alias_roots, summary_names, summary_params, summary_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params)
                        Stmt.Expr(expression, position) | Stmt.VarDecl(_, _, expression, position):
                            destroyed_apply_arena_invalidation(expression, annotations, function_line, position.line, destroyed, alias_ids, alias_roots, summary_names, summary_params, summary_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params)
                        Stmt.Assign(target, operator, value, position):
                            destroyed_apply_arena_invalidation(target, annotations, function_line, position.line, destroyed, alias_ids, alias_roots, summary_names, summary_params, summary_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params)
                            destroyed_apply_arena_invalidation(value, annotations, function_line, position.line, destroyed, alias_ids, alias_roots, summary_names, summary_params, summary_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params)
                        Stmt.If(condition, then_body, else_body, position):
                            destroyed_apply_arena_invalidation(condition, annotations, function_line, position.line, destroyed, alias_ids, alias_roots, summary_names, summary_params, summary_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params)
                            destroyed_apply_arena_invalidation_statements(then_body, annotations, function_line, destroyed, alias_ids, alias_roots, summary_names, summary_params, summary_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params)
                            destroyed_apply_arena_invalidation_statements(else_body, annotations, function_line, destroyed, alias_ids, alias_roots, summary_names, summary_params, summary_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params)
                        Stmt.While(condition, body, position):
                            destroyed_apply_arena_invalidation(condition, annotations, function_line, position.line, destroyed, alias_ids, alias_roots, summary_names, summary_params, summary_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params)
                            destroyed_apply_arena_invalidation_statements(body, annotations, function_line, destroyed, alias_ids, alias_roots, summary_names, summary_params, summary_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params)
                        Stmt.For(bind, variables, iterable, body, position):
                            destroyed_apply_arena_invalidation(iterable, annotations, function_line, position.line, destroyed, alias_ids, alias_roots, summary_names, summary_params, summary_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params)
                            destroyed_apply_arena_invalidation_statements(body, annotations, function_line, destroyed, alias_ids, alias_roots, summary_names, summary_params, summary_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params)
                        Stmt.Return(value, position):
                            destroyed_apply_arena_invalidation(returned, annotations, function_line, position.line, destroyed, alias_ids, alias_roots, summary_names, summary_params, summary_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params) if value is returned
                        Stmt.Match(scrutinee, arms, position):
                            destroyed_apply_arena_invalidation(scrutinee, annotations, function_line, position.line, destroyed, alias_ids, alias_roots, summary_names, summary_params, summary_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params)
                            for arm in arms |annotations, function_line, destroyed, alias_ids, alias_roots, summary_names, summary_params, summary_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params|:
                                destroyed_apply_arena_invalidation(arm.guard, annotations, function_line, position.line, destroyed, alias_ids, alias_roots, summary_names, summary_params, summary_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params)
                                destroyed_apply_arena_invalidation_statements(arm.body, annotations, function_line, destroyed, alias_ids, alias_roots, summary_names, summary_params, summary_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params)
                        Stmt.Contract(kind, expression, position):
                            destroyed_apply_arena_invalidation(expression, annotations, function_line, position.line, destroyed, alias_ids, alias_roots, summary_names, summary_params, summary_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params)
                        _:
                            pass


        def collect_lambda_statement_idents(statement: Ast::Stmt, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match statement:
                    Stmt.Return(value, line):
                        collect_lambda_expression_idents(returned, out) if value is returned
                    Stmt.Expr(expression, line):
                        collect_lambda_expression_idents(expression, out)
                    Stmt.VarDecl(name, type_expression, value, line):
                        collect_lambda_expression_idents(value, out)
                    Stmt.Assign(target, operator, value, line):
                        collect_lambda_expression_idents(target, out)
                        collect_lambda_expression_idents(value, out)
                    Stmt.Block(kind, clause, binding, body, line):
                        for nested in body |out|:
                            collect_lambda_statement_idents(nested, out)
                    Stmt.If(condition, then_body, else_body, line):
                        collect_lambda_expression_idents(condition, out)
                        for nested_then in then_body |out|:
                            collect_lambda_statement_idents(nested_then, out)
                        for nested_else in else_body |out|:
                            collect_lambda_statement_idents(nested_else, out)
                    Stmt.While(condition, body, line):
                        collect_lambda_expression_idents(condition, out)
                        for nested_while in body |out|:
                            collect_lambda_statement_idents(nested_while, out)
                    Stmt.For(bind, variables, iterable, body, line):
                        collect_lambda_expression_idents(iterable, out)
                        for nested_for in body |out|:
                            collect_lambda_statement_idents(nested_for, out)
                    Stmt.Match(scrutinee, arms, line):
                        collect_lambda_expression_idents(scrutinee, out)
                        for arm in arms |out|:
                            collect_lambda_expression_idents(arm.guard, out)
                            for nested_arm in arm.body |out|:
                                collect_lambda_statement_idents(nested_arm, out)
                    Stmt.Contract(kind, expression, line):
                        collect_lambda_expression_idents(expression, out)
                    _:
                        pass


        # Walk every expression variant that can contain a value reference. An omitted
        # subtree here would silently drop closure capture provenance, so keep this in sync
        # with the sealed Expr declaration in parser/ast_nodes.elisa.
        def collect_lambda_expression_idents(expression: Ast::Expr, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Ident(name, line):
                        out.push(name) if not any existing in out where existing == name
                    Expr.Call(callee, arguments, argument_names, line):
                        collect_lambda_expression_idents(callee, out)
                        for argument in arguments |out|:
                            collect_lambda_expression_idents(argument, out)
                    Expr.StaticEffectCall(effect_type, operation, candidates, arguments, argument_names, line):
                        for candidate in candidates |out|:
                            for capture in candidate.captures |out|:
                                collect_lambda_expression_idents(capture, out)
                        for argument in arguments |out|:
                            collect_lambda_expression_idents(argument, out)
                    Expr.Field(object, field, line) | Expr.Scope(object, field, line):
                        collect_lambda_expression_idents(object, out)
                    Expr.Index(object, index, line):
                        collect_lambda_expression_idents(object, out)
                        collect_lambda_expression_idents(index, out)
                    Expr.IndexN(object, arguments, line):
                        collect_lambda_expression_idents(object, out)
                        for argument in arguments |out|:
                            collect_lambda_expression_idents(argument, out)
                    Expr.Slice(object, low, high, line):
                        collect_lambda_expression_idents(object, out)
                        collect_lambda_expression_idents(low, out)
                        collect_lambda_expression_idents(high, out)
                    Expr.Binary(left, operator, right, line):
                        collect_lambda_expression_idents(left, out)
                        collect_lambda_expression_idents(right, out)
                    Expr.Unary(operator, operand, line) | Expr.Move(operand, line) | Expr.RegionNew(operand, _, line) | Expr.Paren(operand, line):
                        collect_lambda_expression_idents(operand, out)
                    Expr.Array(elements, line) | Expr.Tuple(elements, line) | Expr.SetLit(elements, line):
                        for element in elements |out|:
                            collect_lambda_expression_idents(element, out)
                    Expr.DictLit(entries, line):
                        for entry in entries |out|:
                            collect_lambda_expression_idents(entry.key, out)
                            collect_lambda_expression_idents(entry.value, out)
                    Expr.Construct(type_expression, fields, line):
                        for field in fields |out|:
                            collect_lambda_expression_idents(field.value, out)
                    Expr.RecordUpdate(base, fields, line):
                        collect_lambda_expression_idents(base, out)
                        for field in fields |out|:
                            collect_lambda_expression_idents(field.value, out)
                    Expr.If(condition, then_value, else_value, line):
                        collect_lambda_expression_idents(condition, out)
                        collect_lambda_expression_idents(then_value, out)
                        collect_lambda_expression_idents(else_value, out)
                    Expr.Match(scrutinee, arms, line) | Expr.Catch(scrutinee, arms, line):
                        collect_lambda_expression_idents(scrutinee, out)
                        for arm in arms |out|:
                            collect_lambda_expression_idents(arm.guard, out)
                            for nested in arm.body |out|:
                                collect_lambda_statement_idents(nested, out)
                    Expr.Comprehension(variable, iterable, condition, body, line):
                        collect_lambda_expression_idents(iterable, out)
                        collect_lambda_expression_idents(condition, out)
                        collect_lambda_expression_idents(body, out)
                    Expr.Refinement(base, predicate, line):
                        collect_lambda_expression_idents(base, out)
                        collect_lambda_expression_idents(predicate, out)
                    Expr.GetElse(guarded, recovery, line):
                        collect_lambda_expression_idents(guarded, out)
                        for nested_recovery in recovery |out|:
                            collect_lambda_statement_idents(nested_recovery, out)
                    Expr.Lambda(parameters, body, line):
                        for nested_lambda in body |out|:
                            collect_lambda_statement_idents(nested_lambda, out)
                    Expr.Block(statements, value, captures, line):
                        for capture_name in captures:
                            out.push(capture_name) if not any existing in out where existing == capture_name
                        for nested_block in statements |out|:
                            collect_lambda_statement_idents(nested_block, out)
                        collect_lambda_expression_idents(value, out)
                    _:
                        pass


        def destroyed_register_lambda_dependencies(target_name: sview, lambda_params: darray[sview], lambda_body: darray[Ast::Stmt], annotations: darray[Ast::LocalRegionAnnotation]&, borrow_names: darray[sview]&, borrow_regions: darray[u32]&, destroyed: darray[u32]&, function_line: u32, line: u32, lambda_dep_names: mutable darray[sview]&, lambda_dep_regions: mutable darray[u32]&) -> void:
            can Memory.Allocate, Abort.Panic:
                captured_names: mutable darray[sview] = []
                for lambda_statement in lambda_body |captured_names|:
                    collect_lambda_statement_idents(lambda_statement, captured_names)
                for captured in captured_names |lambda_params, annotations, borrow_names, borrow_regions, destroyed, function_line, line, lambda_dep_names, lambda_dep_regions, target_name|:
                    continue if any lambda_parameter in lambda_params where lambda_parameter == captured
                    captured_regions: mutable darray[u32] = []
                    function_regions_of_name(annotations, captured, function_line, line, captured_regions)
                    if captured_regions.count == 0:
                        alias_region: u32 = destroyed_alias_region(captured, borrow_names, borrow_regions, destroyed)
                        captured_regions.push(alias_region) if alias_region != NO_REGION_BINDING
                    for captured_region in captured_regions |lambda_dep_names, lambda_dep_regions, target_name|:
                        exists: mutable bool = false
                        for dependency_index in 0..<lambda_dep_names.count |exists, lambda_dep_names, lambda_dep_regions, target_name, captured_region|:
                            exists <- true if lambda_dep_names[dependency_index] == target_name and dependency_index < lambda_dep_regions.count and lambda_dep_regions[dependency_index] == captured_region
                        if not exists:
                            lambda_dep_names.push(target_name)
                            lambda_dep_regions.push(captured_region)
                if not any dependency_name in lambda_dep_names where dependency_name == target_name:
                    # Preserve a row for capture-free closures so local aliases can
                    # distinguish them from function values with unknown provenance.
                    lambda_dep_names.push(target_name)
                    lambda_dep_regions.push(NO_REGION_BINDING)


        # Analyze a lambda body as a deferred execution path with a fresh invalidation
        # state. Its captured locals keep their enclosing provenance, while lambda
        # parameters shadow same-named enclosing locals. Effects inside the body must be
        # ordered against reads there; they must not be applied at closure construction.
        def destroyed_validate_lambda_body(lambda_params: darray[sview]&, lambda_body: darray[Ast::Stmt]&, annotations: darray[Ast::LocalRegionAnnotation]&, allocation_regions: darray[sview]&, allocation_lines: darray[u32]&, view_fns: darray[sview]&, params: darray[Ast::ParamDecl]&, function_line: u32, borrow_names: darray[sview]&, borrow_regions: darray[u32]&, lambda_dep_names: darray[sview]&, lambda_dep_regions: darray[u32]&, arena_owner_alias_ids: darray[u32]&, arena_owner_alias_roots: darray[u32]&, arena_invalidation_names: darray[sview]&, arena_invalidation_params: darray[u32]&, arena_invalidation_formals: darray[sview]&, local_function_names: darray[sview]&, local_reference_names: darray[sview]&, opaque_function_names: darray[sview]&, opaque_function_starts: darray[usize]&, opaque_function_arities: darray[u32]&, extern_params: darray[Ast::ExternParam]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                scoped_annotations: mutable darray[Ast::LocalRegionAnnotation] = []
                for annotation in annotations:
                    scoped_annotations.push(annotation) if not any parameter_name in lambda_params where parameter_name == annotation.name
                scoped_params: mutable darray[Ast::ParamDecl] = []
                for parameter in params:
                    scoped_params.push(parameter) if not any parameter_name in lambda_params where parameter_name == parameter.name
                scoped_borrow_names: mutable darray[sview] = []
                scoped_borrow_regions: mutable darray[u32] = []
                for borrow_index in 0..<borrow_names.count |scoped_borrow_names, scoped_borrow_regions, borrow_regions, lambda_params|:
                    if not any parameter_name in lambda_params where parameter_name == borrow_names[borrow_index]:
                        scoped_borrow_names.push(borrow_names[borrow_index])
                        scoped_borrow_regions.push(borrow_regions[borrow_index]) if borrow_index < borrow_regions.count
                scoped_lambda_dep_names: mutable darray[sview] = []
                scoped_lambda_dep_regions: mutable darray[u32] = []
                for dependency_index in 0..<lambda_dep_names.count |scoped_lambda_dep_names, scoped_lambda_dep_regions, lambda_dep_regions, lambda_params|:
                    if not any parameter_name in lambda_params where parameter_name == lambda_dep_names[dependency_index]:
                        scoped_lambda_dep_names.push(lambda_dep_names[dependency_index])
                        scoped_lambda_dep_regions.push(lambda_dep_regions[dependency_index]) if dependency_index < lambda_dep_regions.count
                scoped_alias_ids: mutable darray[u32] = []
                scoped_alias_roots: mutable darray[u32] = []
                for alias_index in 0..<arena_owner_alias_ids.count |scoped_alias_ids, scoped_alias_roots, annotations|:
                    alias_id: u32 = arena_owner_alias_ids[alias_index]
                    alias_name: sview = annotations[(alias_id - 1).usize()].name if alias_id > 0 and alias_id.usize() <= annotations.count else ""
                    if not any parameter_name in lambda_params where parameter_name == alias_name:
                        scoped_alias_ids.push(alias_id)
                        scoped_alias_roots.push(arena_owner_alias_roots[alias_index]) if alias_index < arena_owner_alias_roots.count
                scoped_destroyed: mutable darray[u32] = []
                table <- walk_destroyed_region_statements(lambda_body, scoped_annotations, allocation_regions, allocation_lines, view_fns, scoped_params, function_line, scoped_destroyed, scoped_borrow_names, scoped_borrow_regions, scoped_lambda_dep_names, scoped_lambda_dep_regions, scoped_alias_ids, scoped_alias_roots, arena_invalidation_names, arena_invalidation_params, arena_invalidation_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params, false, table)

        def diagnose_destroyed_expression(expression: Ast::Expr, annotations: darray[Ast::LocalRegionAnnotation]&, destroyed: darray[u32]&, borrow_names: darray[sview]&, borrow_regions: darray[u32]&, lambda_dep_names: darray[sview]&, lambda_dep_regions: darray[u32]&, function_line: u32, line: u32, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                region_id: u32 = destroyed_region_of_expression(expression, annotations, destroyed, borrow_names, borrow_regions, function_line, line)
                region_name: sview = region_binding_name(region_id, annotations)
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.DestroyedRegionUse, name: destroyed_use_root_name(expression), pos: ident_extent_or_line(expression, line), line: line, expected: "use", actual: region_name}) if region_id != 0
                return if region_id != 0
                # A LAMBDA that captured a region-dependent binding inherits its
                # dependence: calling it after the destroy is the same stale use.
                root: sview = destroyed_use_root_name(expression)
                lambda_root: sview = root if root != "" else (lambda_call_root(expression))
                probe: mutable usize = 0
                while probe < lambda_dep_names.count |probe, table| -> table:
                    unknown_callable: bool = probe < lambda_dep_regions.count and lambda_dep_regions[probe] == UNKNOWN_LAMBDA_DEPENDENCY
                    stale_unknown: bool = unknown_callable and destroyed.count > 0
                    stale_known: bool = probe < lambda_dep_regions.count and lambda_dep_regions[probe] != NO_REGION_BINDING and lambda_dep_regions[probe] != UNKNOWN_LAMBDA_DEPENDENCY and destroyed_region_id_contains(destroyed, lambda_dep_regions[probe])
                    stale: bool = lambda_dep_names[probe] == lambda_root and (stale_unknown or stale_known)
                    region_name: sview = destroyed_first_invalidated_name(destroyed, annotations) if unknown_callable else region_binding_name(lambda_dep_regions[probe], annotations)
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.DestroyedRegionUse, name: lambda_root, line: line, expected: "use", actual: region_name}) if stale
                    probe <- probe + 1


        # The callee root of `g()` (destroyed_use_root_name does not descend calls).
        def lambda_call_root(expression: Ast::Expr) -> sview:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, line):
                        return destroyed_lambda_alias_source(callee)
                    Expr.Paren(inner, paren_line):
                        return lambda_call_root(inner)
                    Expr.Catch(guarded, arms, line) | Expr.GetElse(guarded, recovery, line):
                        return lambda_call_root(guarded)
                    _:
                        return sview("", 0, 0)


        def destroyed_is_local_callable_invocation(expression: Ast::Expr, local_reference_names: darray[sview]&) -> bool:
            can Abort.Panic:
                callable_name: sview = lambda_call_root(expression)
                return callable_name != "" and any local_reference in local_reference_names where local_reference == callable_name


        # A copied function value carries the lifetime dependencies of its closure.
        # Keep this limited to transparent local aliases until typed callable/provenance
        # facts cover field projections, calls, and casts.
        def destroyed_lambda_alias_source(expression: Ast::Expr) -> sview:
            can Abort.Panic:
                match expression:
                    Expr.Ident(name, line): return name
                    Expr.Paren(inner, line) | Expr.Move(inner, line) | Expr.Index(inner, _, line) | Expr.IndexN(inner, _, line): return destroyed_lambda_alias_source(inner)
                    Expr.Field(receiver, method, line):
                        return destroyed_lambda_alias_source(receiver) if method == "cast"
                        return ""
                    _: return ""


        def destroyed_copy_lambda_dependencies(target_name: sview, source: Ast::Expr, lambda_dep_names: mutable darray[sview]&, lambda_dep_regions: mutable darray[u32]&) -> void:
            can Memory.Allocate, Abort.Panic:
                source_name: sview = destroyed_lambda_alias_source(source)
                return if target_name == "" or source_name == "" or target_name == source_name
                original_count: usize = lambda_dep_names.count
                dependency_index: mutable usize = 0
                while dependency_index < original_count |dependency_index, lambda_dep_names, lambda_dep_regions, target_name, source_name|:
                    if lambda_dep_names[dependency_index] == source_name and dependency_index < lambda_dep_regions.count:
                        region_id: u32 = lambda_dep_regions[dependency_index]
                        exists: mutable bool = false
                        for existing_index in 0..<original_count |exists, lambda_dep_names, lambda_dep_regions, target_name, region_id|:
                            exists <- true if lambda_dep_names[existing_index] == target_name and existing_index < lambda_dep_regions.count and lambda_dep_regions[existing_index] == region_id
                        if not exists:
                            lambda_dep_names.push(target_name)
                            lambda_dep_regions.push(region_id)
                    dependency_index <- dependency_index + 1.usize()


        def destroyed_add_lambda_dependency(name: sview, region_id: u32, lambda_dep_names: mutable darray[sview]&, lambda_dep_regions: mutable darray[u32]&) -> void:
            can Memory.Allocate, Abort.Panic:
                exists: mutable bool = false
                for dependency_index in 0..<lambda_dep_names.count |exists, lambda_dep_names, lambda_dep_regions, name, region_id|:
                    exists <- true if lambda_dep_names[dependency_index] == name and dependency_index < lambda_dep_regions.count and lambda_dep_regions[dependency_index] == region_id
                if not exists:
                    lambda_dep_names.push(name)
                    lambda_dep_regions.push(region_id)


        def destroyed_first_invalidated_name(destroyed: darray[u32]&, annotations: darray[Ast::LocalRegionAnnotation]&) -> sview:
            can Abort.Panic:
                for region_id in destroyed:
                    return region_binding_name(region_id, annotations) if region_id != DESTROYED_REGION_ALL
                return "unknown"

        def walk_destroyed_region_statements(statements: darray[Ast::Stmt]&, annotations: darray[Ast::LocalRegionAnnotation]&, allocation_regions: darray[sview]&, allocation_lines: darray[u32]&, view_fns: darray[sview]&, params: darray[Ast::ParamDecl]&, function_line: u32, destroyed: mutable darray[u32]&, borrow_names: mutable darray[sview]&, borrow_regions: mutable darray[u32]&, lambda_dep_names: mutable darray[sview]&, lambda_dep_regions: mutable darray[u32]&, arena_owner_alias_ids: mutable darray[u32]&, arena_owner_alias_roots: mutable darray[u32]&, arena_invalidation_names: darray[sview]&, arena_invalidation_params: darray[u32]&, arena_invalidation_formals: darray[sview]&, local_function_names: darray[sview]&, local_reference_names: darray[sview]&, opaque_function_names: darray[sview]&, opaque_function_starts: darray[usize]&, opaque_function_arities: darray[u32]&, extern_params: darray[Ast::ExternParam]&, branch_sensitive: bool, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |destroyed, lambda_dep_names, lambda_dep_regions, arena_owner_alias_ids, arena_owner_alias_roots, table|:
                    match statement:
                        Stmt.Block("destroy", clause, binding, body, line):
                            binding_id: u32 = region_binding_id_at(annotations, clause[0], function_line, line.line) if clause.count > 0 else NO_REGION_BINDING
                            destroyed_mark_region_binding(destroyed, binding_id, arena_owner_alias_ids, arena_owner_alias_roots) if clause.count > 0
                        Stmt.VarDecl(name, type_expression, value, line):
                            destroyed_register_arena_owner_alias(name, value, annotations, params, function_line, line.line, destroyed, arena_owner_alias_ids, arena_owner_alias_roots)
                            local_callable_invocation: bool = destroyed_is_local_callable_invocation(value, local_reference_names)
                            table <- diagnose_destroyed_expression(value, annotations, destroyed, borrow_names, borrow_regions, lambda_dep_names, lambda_dep_regions, function_line, line.line, table) if local_callable_invocation
                            destroyed_apply_arena_invalidation(value, annotations, function_line, line.line, destroyed, arena_owner_alias_ids, arena_owner_alias_roots, arena_invalidation_names, arena_invalidation_params, arena_invalidation_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params)
                            allocation_region: sview = allocation_region_at(allocation_regions, allocation_lines, line.line)
                            allocation_region_id: u32 = region_binding_id_at(annotations, allocation_region, function_line, line.line) if allocation_region != "" else NO_REGION_BINDING
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.DestroyedRegionUse, name: name, pos: Ast::expr_pos(value), line: line.line, expected: "allocate", actual: region_binding_name(allocation_region_id, annotations)}) if allocation_region_id != NO_REGION_BINDING and destroyed_region_id_contains(destroyed, allocation_region_id)
                            table <- diagnose_destroyed_expression(value, annotations, destroyed, borrow_names, borrow_regions, lambda_dep_names, lambda_dep_regions, function_line, line.line, table) if not local_callable_invocation
                            if destroyed_type_is_view(type_expression):
                                regions: mutable darray[u32] = []
                                destroyed_collect_view_regions(value, annotations, view_fns, borrow_names, borrow_regions, function_line, line.line, regions)
                                borrow_names.push(name)
                                borrow_regions.push(NO_REGION_BINDING)
                                for region in regions:
                                    borrow_names.push(name)
                                    borrow_regions.push(region)
                            match value:
                                Expr.Lambda(lambda_params, lambda_body, lambda_line):
                                    destroyed_register_lambda_dependencies(name, lambda_params, lambda_body, annotations, borrow_names, borrow_regions, destroyed, function_line, line.line, lambda_dep_names, lambda_dep_regions)
                                    table <- destroyed_validate_lambda_body(lambda_params, lambda_body, annotations, allocation_regions, allocation_lines, view_fns, params, function_line, borrow_names, borrow_regions, lambda_dep_names, lambda_dep_regions, arena_owner_alias_ids, arena_owner_alias_roots, arena_invalidation_names, arena_invalidation_params, arena_invalidation_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params, table)
                                _:
                                    destroyed_copy_lambda_dependencies(name, value, lambda_dep_names, lambda_dep_regions)
                            if destroyed_type_is_callable_binding(type_expression, table) and not any dependency_name in lambda_dep_names where dependency_name == name:
                                source_name: sview = destroyed_lambda_alias_source(value)
                                is_known_function: bool = any function_name in local_function_names where function_name == source_name
                                is_known_external: bool = any external_name in opaque_function_names where external_name == source_name
                                unknown_region: u32 = UNKNOWN_LAMBDA_DEPENDENCY if source_name == "" or not is_known_function and not is_known_external else NO_REGION_BINDING
                                destroyed_add_lambda_dependency(name, unknown_region, lambda_dep_names, lambda_dep_regions)
                        Stmt.Assign(target, operator, value, line):
                            destroyed_apply_arena_invalidation(target, annotations, function_line, line.line, destroyed, arena_owner_alias_ids, arena_owner_alias_roots, arena_invalidation_names, arena_invalidation_params, arena_invalidation_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params)
                            local_callable_invocation: bool = destroyed_is_local_callable_invocation(value, local_reference_names)
                            table <- diagnose_destroyed_expression(value, annotations, destroyed, borrow_names, borrow_regions, lambda_dep_names, lambda_dep_regions, function_line, line.line, table) if local_callable_invocation
                            destroyed_apply_arena_invalidation(value, annotations, function_line, line.line, destroyed, arena_owner_alias_ids, arena_owner_alias_roots, arena_invalidation_names, arena_invalidation_params, arena_invalidation_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params)
                            destroyed_rebind_arena_owner_alias(destroyed_use_root_name(target), value, annotations, function_line, line.line, branch_sensitive, destroyed, arena_owner_alias_ids, arena_owner_alias_roots) if operator == TokenKind.LArrow
                            table <- diagnose_destroyed_expression(value, annotations, destroyed, borrow_names, borrow_regions, lambda_dep_names, lambda_dep_regions, function_line, line.line, table) if not local_callable_invocation
                            target_name: sview = destroyed_use_root_name(target)
                            match value:
                                Expr.Lambda(lambda_params, lambda_body, lambda_line):
                                    destroyed_register_lambda_dependencies(target_name, lambda_params, lambda_body, annotations, borrow_names, borrow_regions, destroyed, function_line, line.line, lambda_dep_names, lambda_dep_regions)
                                    table <- destroyed_validate_lambda_body(lambda_params, lambda_body, annotations, allocation_regions, allocation_lines, view_fns, params, function_line, borrow_names, borrow_regions, lambda_dep_names, lambda_dep_regions, arena_owner_alias_ids, arena_owner_alias_roots, arena_invalidation_names, arena_invalidation_params, arena_invalidation_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params, table)
                                _:
                                    destroyed_copy_lambda_dependencies(target_name, value, lambda_dep_names, lambda_dep_regions)
                            source_name: sview = destroyed_lambda_alias_source(value)
                            is_lambda_value: bool = match value:
                                Expr.Lambda(_, _, _): true
                                _: false
                            target_tracked: bool = any dependency_name in lambda_dep_names where dependency_name == target_name
                            source_tracked: bool = any dependency_name in lambda_dep_names where dependency_name == source_name
                            if target_tracked and not is_lambda_value and (source_name == "" or not source_tracked):
                                destroyed_add_lambda_dependency(target_name, UNKNOWN_LAMBDA_DEPENDENCY, lambda_dep_names, lambda_dep_regions)
                            if any borrow_name in borrow_names where borrow_name == target_name:
                                regions: mutable darray[u32] = []
                                destroyed_collect_view_regions(value, annotations, view_fns, borrow_names, borrow_regions, function_line, line.line, regions)
                                borrow_names.push(target_name)
                                borrow_regions.push(NO_REGION_BINDING)
                                for region in regions:
                                    borrow_names.push(target_name)
                                    borrow_regions.push(region)
                        Stmt.Expr(expression, line):
                            local_callable_invocation: bool = destroyed_is_local_callable_invocation(expression, local_reference_names)
                            table <- diagnose_destroyed_expression(expression, annotations, destroyed, borrow_names, borrow_regions, lambda_dep_names, lambda_dep_regions, function_line, line.line, table) if local_callable_invocation
                            destroyed_apply_arena_invalidation(expression, annotations, function_line, line.line, destroyed, arena_owner_alias_ids, arena_owner_alias_roots, arena_invalidation_names, arena_invalidation_params, arena_invalidation_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params)
                            table <- diagnose_destroyed_expression(expression, annotations, destroyed, borrow_names, borrow_regions, lambda_dep_names, lambda_dep_regions, function_line, line.line, table) if not local_callable_invocation
                        Stmt.Return(value, line):
                            local_callable_invocation: bool = destroyed_is_local_callable_invocation(returned, local_reference_names) if value is returned else false
                            table <- diagnose_destroyed_expression(returned, annotations, destroyed, borrow_names, borrow_regions, lambda_dep_names, lambda_dep_regions, function_line, line.line, table) if value is returned and local_callable_invocation
                            destroyed_apply_arena_invalidation(returned, annotations, function_line, line.line, destroyed, arena_owner_alias_ids, arena_owner_alias_roots, arena_invalidation_names, arena_invalidation_params, arena_invalidation_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params) if value is returned
                            table <- diagnose_destroyed_expression(returned, annotations, destroyed, borrow_names, borrow_regions, lambda_dep_names, lambda_dep_regions, function_line, line.line, table) if value is returned and not local_callable_invocation
                        Stmt.If(condition, then_body, else_body, line):
                            table <- diagnose_destroyed_expression(condition, annotations, destroyed, borrow_names, borrow_regions, lambda_dep_names, lambda_dep_regions, function_line, line.line, table)
                            destroyed_apply_arena_invalidation(condition, annotations, function_line, line.line, destroyed, arena_owner_alias_ids, arena_owner_alias_roots, arena_invalidation_names, arena_invalidation_params, arena_invalidation_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params)
                            if arena_owner_alias_ids.count != arena_owner_alias_roots.count:
                                destroyed_push_all(destroyed)
                                table <- walk_destroyed_region_statements(then_body, annotations, allocation_regions, allocation_lines, view_fns, params, function_line, destroyed, borrow_names, borrow_regions, lambda_dep_names, lambda_dep_regions, arena_owner_alias_ids, arena_owner_alias_roots, arena_invalidation_names, arena_invalidation_params, arena_invalidation_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params, true, table)
                                table <- walk_destroyed_region_statements(else_body, annotations, allocation_regions, allocation_lines, view_fns, params, function_line, destroyed, borrow_names, borrow_regions, lambda_dep_names, lambda_dep_regions, arena_owner_alias_ids, arena_owner_alias_roots, arena_invalidation_names, arena_invalidation_params, arena_invalidation_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params, true, table)
                            else:
                                base_alias_ids: mutable darray[u32] = []
                                base_alias_roots: mutable darray[u32] = []
                                destroyed_copy_owner_alias_roots(arena_owner_alias_ids, arena_owner_alias_roots, destroyed, base_alias_ids, base_alias_roots)
                                table <- walk_destroyed_region_statements(then_body, annotations, allocation_regions, allocation_lines, view_fns, params, function_line, destroyed, borrow_names, borrow_regions, lambda_dep_names, lambda_dep_regions, arena_owner_alias_ids, arena_owner_alias_roots, arena_invalidation_names, arena_invalidation_params, arena_invalidation_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params, false, table)
                                then_result_ids: mutable darray[u32] = []
                                then_result_roots: mutable darray[u32] = []
                                destroyed_copy_owner_alias_roots(arena_owner_alias_ids, arena_owner_alias_roots, destroyed, then_result_ids, then_result_roots)
                                arena_owner_alias_ids.clear()
                                arena_owner_alias_roots.clear()
                                for base_index in 0..<base_alias_ids.count |base_alias_ids, base_alias_roots, arena_owner_alias_ids, arena_owner_alias_roots|:
                                    arena_owner_alias_ids.push(base_alias_ids[base_index])
                                    arena_owner_alias_roots.push(base_alias_roots[base_index]) if base_index < base_alias_roots.count
                                table <- walk_destroyed_region_statements(else_body, annotations, allocation_regions, allocation_lines, view_fns, params, function_line, destroyed, borrow_names, borrow_regions, lambda_dep_names, lambda_dep_regions, arena_owner_alias_ids, arena_owner_alias_roots, arena_invalidation_names, arena_invalidation_params, arena_invalidation_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params, false, table)
                                for then_index in 0..<then_result_ids.count |then_result_ids, then_result_roots, destroyed, arena_owner_alias_ids, arena_owner_alias_roots|:
                                    if then_index < then_result_roots.count:
                                        destroyed_add_arena_owner_alias_root(then_result_ids[then_index], then_result_roots[then_index], destroyed, arena_owner_alias_ids, arena_owner_alias_roots)
                                    else:
                                        destroyed_push_all(destroyed)
                                if branch_sensitive:
                                    for base_index in 0..<base_alias_ids.count |base_alias_ids, base_alias_roots, destroyed, arena_owner_alias_ids, arena_owner_alias_roots|:
                                        if base_index < base_alias_roots.count:
                                            destroyed_add_arena_owner_alias_root(base_alias_ids[base_index], base_alias_roots[base_index], destroyed, arena_owner_alias_ids, arena_owner_alias_roots)
                                        else:
                                            destroyed_push_all(destroyed)
                        Stmt.While(condition, body, line):
                            table <- diagnose_destroyed_expression(condition, annotations, destroyed, borrow_names, borrow_regions, lambda_dep_names, lambda_dep_regions, function_line, line.line, table)
                            destroyed_apply_arena_invalidation(condition, annotations, function_line, line.line, destroyed, arena_owner_alias_ids, arena_owner_alias_roots, arena_invalidation_names, arena_invalidation_params, arena_invalidation_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params)
                            table <- walk_destroyed_region_statements(body, annotations, allocation_regions, allocation_lines, view_fns, params, function_line, destroyed, borrow_names, borrow_regions, lambda_dep_names, lambda_dep_regions, arena_owner_alias_ids, arena_owner_alias_roots, arena_invalidation_names, arena_invalidation_params, arena_invalidation_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params, true, table)
                            # The next loop test occurs after a body execution and may read
                            # through a view invalidated in that body.
                            table <- diagnose_destroyed_expression(condition, annotations, destroyed, borrow_names, borrow_regions, lambda_dep_names, lambda_dep_regions, function_line, line.line, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- diagnose_destroyed_expression(iterable, annotations, destroyed, borrow_names, borrow_regions, lambda_dep_names, lambda_dep_regions, function_line, line.line, table)
                            destroyed_apply_arena_invalidation(iterable, annotations, function_line, line.line, destroyed, arena_owner_alias_ids, arena_owner_alias_roots, arena_invalidation_names, arena_invalidation_params, arena_invalidation_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params)
                            table <- walk_destroyed_region_statements(body, annotations, allocation_regions, allocation_lines, view_fns, params, function_line, destroyed, borrow_names, borrow_regions, lambda_dep_names, lambda_dep_regions, arena_owner_alias_ids, arena_owner_alias_roots, arena_invalidation_names, arena_invalidation_params, arena_invalidation_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params, true, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- walk_destroyed_region_statements(body, annotations, allocation_regions, allocation_lines, view_fns, params, function_line, destroyed, borrow_names, borrow_regions, lambda_dep_names, lambda_dep_regions, arena_owner_alias_ids, arena_owner_alias_roots, arena_invalidation_names, arena_invalidation_params, arena_invalidation_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params, branch_sensitive, table)
                        Stmt.Match(scrutinee, arms, line):
                            table <- diagnose_destroyed_expression(scrutinee, annotations, destroyed, borrow_names, borrow_regions, lambda_dep_names, lambda_dep_regions, function_line, line.line, table)
                            destroyed_apply_arena_invalidation(scrutinee, annotations, function_line, line.line, destroyed, arena_owner_alias_ids, arena_owner_alias_roots, arena_invalidation_names, arena_invalidation_params, arena_invalidation_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params)
                            base_alias_ids: mutable darray[u32] = []
                            base_alias_roots: mutable darray[u32] = []
                            merged_alias_ids: mutable darray[u32] = []
                            merged_alias_roots: mutable darray[u32] = []
                            destroyed_copy_owner_alias_roots(arena_owner_alias_ids, arena_owner_alias_roots, destroyed, base_alias_ids, base_alias_roots)
                            has_unguarded_catchall: mutable bool = false
                            for arm in arms |destroyed, table, base_alias_ids, base_alias_roots, merged_alias_ids, merged_alias_roots, has_unguarded_catchall, arena_owner_alias_ids, arena_owner_alias_roots|:
                                if not has_unguarded_catchall:
                                    arena_owner_alias_ids.clear()
                                    arena_owner_alias_roots.clear()
                                    destroyed_copy_owner_alias_roots(base_alias_ids, base_alias_roots, destroyed, arena_owner_alias_ids, arena_owner_alias_roots)
                                    table <- diagnose_destroyed_expression(arm.guard, annotations, destroyed, borrow_names, borrow_regions, lambda_dep_names, lambda_dep_regions, function_line, line.line, table)
                                    destroyed_apply_arena_invalidation(arm.guard, annotations, function_line, line.line, destroyed, arena_owner_alias_ids, arena_owner_alias_roots, arena_invalidation_names, arena_invalidation_params, arena_invalidation_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params)
                                    table <- walk_destroyed_region_statements(arm.body, annotations, allocation_regions, allocation_lines, view_fns, params, function_line, destroyed, borrow_names, borrow_regions, lambda_dep_names, lambda_dep_regions, arena_owner_alias_ids, arena_owner_alias_roots, arena_invalidation_names, arena_invalidation_params, arena_invalidation_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params, branch_sensitive, table)
                                    destroyed_copy_owner_alias_roots(arena_owner_alias_ids, arena_owner_alias_roots, destroyed, merged_alias_ids, merged_alias_roots)
                                    has_unguarded_catchall <- true if destroyed_match_arm_is_unguarded_catchall(arm)
                            arena_owner_alias_ids.clear()
                            arena_owner_alias_roots.clear()
                            destroyed_copy_owner_alias_roots(merged_alias_ids, merged_alias_roots, destroyed, arena_owner_alias_ids, arena_owner_alias_roots)
                            if not has_unguarded_catchall:
                                for base_index in 0..<base_alias_ids.count |base_alias_ids, base_alias_roots, destroyed, arena_owner_alias_ids, arena_owner_alias_roots|:
                                    if base_index < base_alias_roots.count:
                                        destroyed_add_arena_owner_alias_root(base_alias_ids[base_index], base_alias_roots[base_index], destroyed, arena_owner_alias_ids, arena_owner_alias_roots)
                                    else:
                                        destroyed_push_all(destroyed)
                        Stmt.Contract(kind, expression, line):
                            destroyed_apply_arena_invalidation(expression, annotations, function_line, line.line, destroyed, arena_owner_alias_ids, arena_owner_alias_roots, arena_invalidation_names, arena_invalidation_params, arena_invalidation_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params)
                            table <- diagnose_destroyed_expression(expression, annotations, destroyed, borrow_names, borrow_regions, lambda_dep_names, lambda_dep_regions, function_line, line.line, table)
                        _:
                            pass

        def check_destroyed_region_declarations(declarations: darray[Ast::Decl], file: Ast::File&, arena_invalidation_names: darray[sview]&, arena_invalidation_params: darray[u32]&, arena_invalidation_formals: darray[sview]&, local_function_names: darray[sview]&, opaque_function_names: darray[sview]&, opaque_function_starts: darray[usize]&, opaque_function_arities: darray[u32]&, extern_params: darray[Ast::ExternParam]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table|:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            destroyed: mutable darray[u32] = []
                            borrow_names: mutable darray[sview] = []
                            borrow_regions: mutable darray[u32] = []
                            lambda_dep_names: mutable darray[sview] = []
                            lambda_dep_regions: mutable darray[u32] = []
                            arena_owner_alias_ids: mutable darray[u32] = []
                            arena_owner_alias_roots: mutable darray[u32] = []
                            local_reference_names: mutable darray[sview] = []
                            destroyed_collect_local_reference_names(name, line, table, local_reference_names)
                            view_fns: mutable darray[sview] = []
                            collect_view_returning_fns(file.top_decls, view_fns)
                            for parameter in params:
                                if destroyed_type_is_view(parameter.type_expression):
                                    borrow_names.push(parameter.name)
                                    borrow_regions.push(NO_REGION_BINDING)
                                    parameter_regions: mutable darray[u32] = []
                                    function_regions_of_name(file.local_region_annotations, parameter.name, line.line, line.line, parameter_regions)
                                    for parameter_region in parameter_regions:
                                        borrow_names.push(parameter.name)
                                        borrow_regions.push(parameter_region)
                            table <- walk_destroyed_region_statements(body, file.local_region_annotations, file.allocation_region_names, file.allocation_region_lines, view_fns, params, line.line, destroyed, borrow_names, borrow_regions, lambda_dep_names, lambda_dep_regions, arena_owner_alias_ids, arena_owner_alias_roots, arena_invalidation_names, arena_invalidation_params, arena_invalidation_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params, false, table)
                        Decl.Module(name, body, line):
                            table <- check_destroyed_region_declarations(body, file, arena_invalidation_names, arena_invalidation_params, arena_invalidation_formals, local_function_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params, table)
                        Decl.Scoped(body, line):
                            table <- check_destroyed_region_declarations(body, file, arena_invalidation_names, arena_invalidation_params, arena_invalidation_formals, local_function_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params, table)
                        _:
                            pass

    public:
        def check_destroyed_region(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                arena_invalidation_names: mutable darray[sview] = []
                arena_invalidation_params: mutable darray[u32] = []
                arena_invalidation_formals: mutable darray[sview] = []
                local_function_names: mutable darray[sview] = []
                opaque_function_names: mutable darray[sview] = []
                opaque_function_starts: mutable darray[usize] = []
                opaque_function_arities: mutable darray[u32] = []
                destroyed_collect_local_function_names(file.top_decls, local_function_names)
                destroyed_collect_opaque_function_signatures(file.top_decls, opaque_function_names, opaque_function_starts, opaque_function_arities)
                summaries_changed: mutable bool = true
                while summaries_changed |summaries_changed, file, arena_invalidation_names, arena_invalidation_params, arena_invalidation_formals, local_function_names, opaque_function_names, opaque_function_starts, opaque_function_arities|:
                    summaries_changed <- false
                    destroyed_collect_arena_invalidation_summaries(file.top_decls, arena_invalidation_names, arena_invalidation_params, arena_invalidation_formals, local_function_names, opaque_function_names, summaries_changed)
                table <- check_destroyed_region_declarations(file.top_decls, file, arena_invalidation_names, arena_invalidation_params, arena_invalidation_formals, local_function_names, opaque_function_names, opaque_function_starts, opaque_function_arities, file.extern_params, table)
