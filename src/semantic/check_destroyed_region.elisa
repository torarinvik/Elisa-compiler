extend Semantic:
    private:
        const NO_REGION_BINDING: u32 = 0
        const DESTROYED_REGION_ALL: u32 = 0

        # RegionBindingId is the one-based row of its lexical binder in the parser side table.
        # Region spelling is for diagnostics only: two simultaneously-live binders named `r`
        # must not share invalidation facts.
        def destroyed_region_id_contains(regions: darray[u32]&, candidate: u32) -> bool:
            false return if candidate == NO_REGION_BINDING
            for region in regions:
                true return if region == candidate or region == DESTROYED_REGION_ALL
            return false

        # Storage-stability analysis still uses strategy/source-name sets; its binder-ID
        # migration is separate from destroyed-region invalidation.
        def destroyed_region_contains(regions: darray[sview]&, candidate: sview) -> bool:
            for region in regions:
                true return if region == candidate
            return false

        def region_binding_id_at(annotations: darray[Ast::LocalRegionAnnotation]&, region: sview, function_line: u32, use_line: u32) -> u32:
            can Abort.Panic:
                found: mutable u32 = NO_REGION_BINDING
                found_line: mutable u32 = 0
                for annotation_index in 0..<annotations.count |found, found_line, annotations, region, function_line, use_line|:
                    annotation: Ast::LocalRegionAnnotation = annotations[annotation_index]
                    is_function_param: bool = annotation.name == "__region_param" and annotation.line == function_line
                    is_open_region: bool = annotation.name == "__region_local" and annotation.line >= function_line and annotation.line <= use_line and (annotation.end_line == 0 or use_line <= annotation.end_line)
                    # Arena-local aliases are bounded to their containing parser block,
                    # just like region-block binders are bounded to the block they own.
                    # Ignoring end_line lets a closed same-name inner owner mask the still
                    # live outer owner at a later reset, so invalidation is attached to the
                    # wrong RegionBindingId and a stale outer view can escape this check.
                    is_arena_owner: bool = annotation.name == "__region_arena_local" and annotation.line >= function_line and annotation.line <= use_line and annotation.end_line > 0 and use_line <= annotation.end_line
                    if annotation.region == region and (is_function_param or is_open_region or is_arena_owner) and annotation.line >= found_line:
                        found_line <- annotation.line
                        found <- (annotation_index + 1).u32()
                return found


        # Arena handles are copyable references to the same backing arena. Keep a canonical
        # binder row for simple local aliases so reset/free through any alias invalidates
        # views tied to the original owner. The root is stored at declaration time, after
        # resolving the initializer in its lexical scope; it is never recovered from spelling
        # alone at the later invalidation site.
        def destroyed_owner_alias_root(binding_id: u32, alias_ids: darray[u32]&, alias_roots: darray[u32]&) -> u32:
            can Abort.Panic:
                for alias_index in 0..<alias_ids.count |alias_ids, alias_roots, binding_id|:
                    if alias_ids[alias_index] == binding_id and alias_index < alias_roots.count:
                        return alias_roots[alias_index]
                return binding_id


        def destroyed_arena_owner_source_name(expression: Ast::Expr) -> sview:
            can Memory.Allocate, Abort.Panic:
                return match expression:
                    Expr.Ident(name, line): name
                    Expr.Paren(inner, line) | Expr.Move(inner, line): destroyed_arena_owner_source_name(inner)
                    Expr.Unary(operator, operand, line):
                        return destroyed_arena_owner_source_name(operand) if operator == TokenKind.Ampersand
                        sview("", 0, 0)
                    Expr.Call(callee, arguments, argument_names, line):
                        match callee:
                            Expr.Field(receiver, method, field_line):
                                if method == "cast":
                                    return destroyed_arena_owner_source_name(receiver)
                                return sview("", 0, 0)
                            _:
                                sview("", 0, 0)
                    _:
                        sview("", 0, 0)


        def destroyed_type_is_arena_reference(type_expression: Ast::Expr) -> bool:
            can Abort.Panic:
                return match type_expression:
                    Expr.Unary(operator, operand, line):
                        return destroyed_type_is_arena_reference(operand) if operator == TokenKind.Mutable or operator == TokenKind.Lmut
                        false return if operator != TokenKind.Ampersand
                        return match operand:
                            Expr.Ident(name, type_line): name == "Arena"
                            Expr.Paren(inner, paren_line): destroyed_type_is_arena_reference(inner)
                            _: false
                    Expr.Paren(inner, line): destroyed_type_is_arena_reference(inner)
                    _: false


        def destroyed_push_region_id(destroyed: mutable darray[u32]&, region_id: u32) -> void:
            can Memory.Allocate, Abort.Panic:
                destroyed.push(region_id) if not any existing in destroyed where existing == region_id


        def destroyed_mark_region_binding(destroyed: mutable darray[u32]&, binding_id: u32, alias_ids: darray[u32]&, alias_roots: darray[u32]&) -> void:
            can Memory.Allocate, Abort.Panic:
                root_id: u32 = destroyed_owner_alias_root(binding_id, alias_ids, alias_roots) if binding_id != NO_REGION_BINDING else DESTROYED_REGION_ALL
                if root_id == NO_REGION_BINDING:
                    destroyed_push_all(destroyed)
                    return
                destroyed_push_region_id(destroyed, root_id)
                for alias_index in 0..<alias_ids.count |destroyed, alias_ids, alias_roots, root_id|:
                    if alias_index < alias_roots.count and alias_roots[alias_index] == root_id:
                        destroyed_push_region_id(destroyed, alias_ids[alias_index])


        def destroyed_push_all(destroyed: mutable darray[u32]&) -> void:
            can Memory.Allocate, Abort.Panic:
                destroyed.push(DESTROYED_REGION_ALL) if not any existing in destroyed where existing == DESTROYED_REGION_ALL


        def destroyed_register_arena_owner_alias(name: sview, value: Ast::Expr, annotations: darray[Ast::LocalRegionAnnotation]&, params: darray[Ast::ParamDecl]&, function_line: u32, line: u32, destroyed: mutable darray[u32]&, alias_ids: mutable darray[u32]&, alias_roots: mutable darray[u32]&) -> void:
            can Memory.Allocate, Abort.Panic:
                binding_id: u32 = region_binding_id_at(annotations, name, function_line, line)
                return if binding_id == NO_REGION_BINDING or binding_id.usize() > annotations.count
                owner_annotation: Ast::LocalRegionAnnotation = annotations[(binding_id - 1).usize()]
                return if owner_annotation.name != "__region_arena_local" or owner_annotation.line != line
                source_name: sview = destroyed_arena_owner_source_name(value)
                root_id: mutable u32 = binding_id if source_name != "" else NO_REGION_BINDING
                if source_name != "":
                    target_id: mutable u32 = region_binding_id_at(annotations, source_name, function_line, line)
                    if target_id == NO_REGION_BINDING:
                        target_annotation: Ast::LocalRegionAnnotation? = local_region_annotation_of(annotations, source_name, line)
                        if target_annotation is target_region and target_region.region != "":
                            target_id <- region_binding_id_at(annotations, target_region.region, function_line, line)
                    if target_id != NO_REGION_BINDING:
                        root_id <- destroyed_owner_alias_root(target_id, alias_ids, alias_roots)
                    elif any parameter in params where parameter.name == source_name and destroyed_type_is_arena_reference(parameter.type_expression):
                        # A reference parameter without a region tie may alias any caller
                        # arena. A later reset through it must conservatively invalidate all.
                        root_id <- DESTROYED_REGION_ALL
                alias_ids.push(binding_id)
                alias_roots.push(root_id)
                if root_id == NO_REGION_BINDING:
                    # This is a known Arena& declaration with an initializer shape we cannot
                    # relate to an owner. If anything has already been invalidated, it may be
                    # one of those owners; retain that uncertainty rather than guess.
                    destroyed_push_all(destroyed) if destroyed.count > 0
                elif root_id != DESTROYED_REGION_ALL and destroyed_region_id_contains(destroyed, root_id):
                    destroyed_push_region_id(destroyed, binding_id)


        def region_binding_name(binding_id: u32, annotations: darray[Ast::LocalRegionAnnotation]&) -> sview:
            can Abort.Panic:
                return annotations[(binding_id - 1).usize()].region if binding_id > 0 and binding_id.usize() <= annotations.count
                return ""

        def function_regions_of_name(annotations: darray[Ast::LocalRegionAnnotation]&, name: sview, function_line: u32, use_line: u32, out: mutable darray[u32]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for annotation in annotations |out|:
                    # A type with no region of its own depends on none (see local_region_annotation_of).
                    is_local_value: bool = annotation.name == name and annotation.line >= function_line and annotation.line <= use_line and not local_type_cannot_carry_region(annotation.type_expression)
                    binding_id: u32 = region_binding_id_at(annotations, annotation.region, function_line, annotation.line) if is_local_value and annotation.region != "" else NO_REGION_BINDING
                    if binding_id != NO_REGION_BINDING and not any existing in out where existing == binding_id:
                        out.push(binding_id)

        # Legacy spelling query for check_region_storage_stability, which has not moved its
        # backing-strategy facts to region binder identities yet.
        def function_region_of_name(annotations: darray[Ast::LocalRegionAnnotation]&, name: sview, function_line: u32, use_line: u32) -> sview:
            can Abort.Panic:
                found: mutable sview = ""
                for annotation in annotations |found|:
                    is_local_value: bool = annotation.name == name and annotation.line >= function_line and annotation.line <= use_line and not local_type_cannot_carry_region(annotation.type_expression)
                    found <- annotation.region if is_local_value
                return found

        def destroyed_annotation_region_id_of_name(annotations: darray[Ast::LocalRegionAnnotation]&, name: sview, destroyed: darray[u32]&, function_line: u32, use_line: u32) -> u32:
            can Memory.Allocate, Abort.Panic:
                regions: mutable darray[u32] = []
                function_regions_of_name(annotations, name, function_line, use_line, regions)
                for region in regions:
                    return region if destroyed_region_id_contains(destroyed, region)
                return NO_REGION_BINDING

        def destroyed_type_is_view(type_expression: Ast::Expr) -> bool:
            can Abort.Panic:
                return match type_expression:
                    Expr.Ident(name, line): name == "sview"
                    Expr.Index(object, element, line): ident_name_of(object) == "view"
                    Expr.IndexN(object, arguments, line): ident_name_of(object) == "view"
                    Expr.Unary(operator, operand, line):
                        return match operator:
                            TokenKind.Mutable | TokenKind.Lmut | TokenKind.Question: destroyed_type_is_view(operand)
                            TokenKind.Ampersand: true
                            _: false
                    Expr.Paren(inner, line): destroyed_type_is_view(inner)
                    _: false

        # Collect backing-region provenance through view constructors, copies, slices, and
        # functions whose declared result is a view. Conservatively retaining every possible
        # source argument makes conditional view-returning helpers safe without trusting body
        # shape or choosing one branch's region.
        def destroyed_collect_view_regions(expression: Ast::Expr, annotations: darray[Ast::LocalRegionAnnotation]&, view_fns: darray[sview]&, borrow_names: darray[sview]&, borrow_regions: darray[u32]&, function_line: u32, use_line: u32, out: mutable darray[u32]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Ident(name, line):
                        function_regions_of_name(annotations, name, function_line, use_line, out)
                        for index in 0..<borrow_names.count |out, borrow_names, borrow_regions, name|:
                            if borrow_names[index] == name and index < borrow_regions.count:
                                alias_region: u32 = borrow_regions[index]
                                out.push(alias_region) if alias_region != NO_REGION_BINDING and not any existing in out where existing == alias_region
                    Expr.Paren(inner, line) | Expr.Move(inner, line):
                        destroyed_collect_view_regions(inner, annotations, view_fns, borrow_names, borrow_regions, function_line, use_line, out)
                    Expr.Field(object, field, line) | Expr.Index(object, index, line) | Expr.IndexN(object, indices, line) | Expr.Slice(object, start, end, line):
                        destroyed_collect_view_regions(object, annotations, view_fns, borrow_names, borrow_regions, function_line, use_line, out)
                    Expr.Unary(operator, operand, line):
                        destroyed_collect_view_regions(operand, annotations, view_fns, borrow_names, borrow_regions, function_line, use_line, out)
                    Expr.Call(callee, arguments, argument_names, line):
                        called: sview = ident_name_of(callee)
                        if any view_fn in view_fns where view_fn == called:
                            for argument in arguments |out|:
                                destroyed_collect_view_regions(argument, annotations, view_fns, borrow_names, borrow_regions, function_line, use_line, out)
                        match callee:
                            Expr.Field(receiver, method, field_line):
                                is_view_method: bool = method == "sview" or method == "as_sview" or method == "as_view" or method == "as_slice" or method == "as_str"
                                destroyed_collect_view_regions(receiver, annotations, view_fns, borrow_names, borrow_regions, function_line, use_line, out) if is_view_method
                            _:
                                pass
                    Expr.Catch(guarded, _, line) | Expr.GetElse(guarded, _, line):
                        destroyed_collect_view_regions(guarded, annotations, view_fns, borrow_names, borrow_regions, function_line, use_line, out)
                    Expr.Binary(left, operator, right, line):
                        destroyed_collect_view_regions(left, annotations, view_fns, borrow_names, borrow_regions, function_line, use_line, out)
                        destroyed_collect_view_regions(right, annotations, view_fns, borrow_names, borrow_regions, function_line, use_line, out)
                    Expr.If(condition, then_value, else_value, line):
                        destroyed_collect_view_regions(then_value, annotations, view_fns, borrow_names, borrow_regions, function_line, use_line, out)
                        destroyed_collect_view_regions(else_value, annotations, view_fns, borrow_names, borrow_regions, function_line, use_line, out)
                    Expr.Refinement(base, predicate, line):
                        destroyed_collect_view_regions(base, annotations, view_fns, borrow_names, borrow_regions, function_line, use_line, out)
                        destroyed_collect_view_regions(predicate, annotations, view_fns, borrow_names, borrow_regions, function_line, use_line, out)
                    Expr.Tuple(elements, line) | Expr.Array(elements, line):
                        for element in elements |out|:
                            destroyed_collect_view_regions(element, annotations, view_fns, borrow_names, borrow_regions, function_line, use_line, out)
                    Expr.Construct(type_expression, fields, line):
                        for field in fields |out|:
                            destroyed_collect_view_regions(field.value, annotations, view_fns, borrow_names, borrow_regions, function_line, use_line, out)
                    Expr.RecordUpdate(base, fields, line):
                        destroyed_collect_view_regions(base, annotations, view_fns, borrow_names, borrow_regions, function_line, use_line, out)
                        for field in fields |out|:
                            destroyed_collect_view_regions(field.value, annotations, view_fns, borrow_names, borrow_regions, function_line, use_line, out)
                    _:
                        pass

        def destroyed_alias_region(name: sview, borrow_names: darray[sview]&, borrow_regions: darray[u32]&, destroyed: darray[u32]&) -> u32:
            can Abort.Panic:
                while index > 0 |index: usize = borrow_names.count|:
                    index <- index - 1
                    if borrow_names[index] == name and index < borrow_regions.count:
                        region: u32 = borrow_regions[index]
                        return region if destroyed_region_id_contains(destroyed, region)
                return NO_REGION_BINDING

        def destroyed_region_of_expression(expression: Ast::Expr, annotations: darray[Ast::LocalRegionAnnotation]&, destroyed: darray[u32]&, borrow_names: darray[sview]&, borrow_regions: darray[u32]&, function_line: u32, use_line: u32) -> u32:
            can Abort.Panic:
                match expression:
                    Expr.Ident(name, line):
                        region: u32 = destroyed_annotation_region_id_of_name(annotations, name, destroyed, function_line, use_line)
                        return region if region != NO_REGION_BINDING else destroyed_alias_region(name, borrow_names, borrow_regions, destroyed)
                    Expr.Field(receiver, field, line):
                        return destroyed_region_of_expression(receiver, annotations, destroyed, borrow_names, borrow_regions, function_line, use_line)
                    Expr.Index(object, index, line):
                        return destroyed_region_of_expression(object, annotations, destroyed, borrow_names, borrow_regions, function_line, use_line)
                    Expr.IndexN(object, arguments, line):
                        return destroyed_region_of_expression(object, annotations, destroyed, borrow_names, borrow_regions, function_line, use_line)
                    Expr.Slice(object, start, end, line):
                        return destroyed_region_of_expression(object, annotations, destroyed, borrow_names, borrow_regions, function_line, use_line)
                    Expr.Unary(operator, operand, line):
                        return destroyed_region_of_expression(operand, annotations, destroyed, borrow_names, borrow_regions, function_line, use_line)
                    Expr.Paren(inner, line):
                        return destroyed_region_of_expression(inner, annotations, destroyed, borrow_names, borrow_regions, function_line, use_line)
                    Expr.Call(callee, arguments, argument_names, line):
                        callee_region: u32 = destroyed_region_of_expression(callee, annotations, destroyed, borrow_names, borrow_regions, function_line, use_line)
                        return callee_region if callee_region != NO_REGION_BINDING
                        for argument in arguments:
                            argument_region: u32 = destroyed_region_of_expression(argument, annotations, destroyed, borrow_names, borrow_regions, function_line, use_line)
                            return argument_region if argument_region != NO_REGION_BINDING
                        return NO_REGION_BINDING
                    Expr.Catch(guarded, _, line) | Expr.GetElse(guarded, _, line):
                        return destroyed_region_of_expression(guarded, annotations, destroyed, borrow_names, borrow_regions, function_line, use_line)
                    Expr.Binary(left, operator, right, line):
                        left_region: u32 = destroyed_region_of_expression(left, annotations, destroyed, borrow_names, borrow_regions, function_line, use_line)
                        return left_region if left_region != NO_REGION_BINDING
                        return destroyed_region_of_expression(right, annotations, destroyed, borrow_names, borrow_regions, function_line, use_line)
                    Expr.If(condition, then_value, else_value, line):
                        condition_region: u32 = destroyed_region_of_expression(condition, annotations, destroyed, borrow_names, borrow_regions, function_line, use_line)
                        return condition_region if condition_region != NO_REGION_BINDING
                        then_region: u32 = destroyed_region_of_expression(then_value, annotations, destroyed, borrow_names, borrow_regions, function_line, use_line)
                        return then_region if then_region != NO_REGION_BINDING
                        return destroyed_region_of_expression(else_value, annotations, destroyed, borrow_names, borrow_regions, function_line, use_line)
                    Expr.Refinement(base, predicate, line):
                        base_region: u32 = destroyed_region_of_expression(base, annotations, destroyed, borrow_names, borrow_regions, function_line, use_line)
                        return base_region if base_region != NO_REGION_BINDING
                        return destroyed_region_of_expression(predicate, annotations, destroyed, borrow_names, borrow_regions, function_line, use_line)
                    Expr.Tuple(elements, line) | Expr.Array(elements, line):
                        for element in elements:
                            region: u32 = destroyed_region_of_expression(element, annotations, destroyed, borrow_names, borrow_regions, function_line, use_line)
                            return region if region != NO_REGION_BINDING
                        return NO_REGION_BINDING
                    Expr.Construct(type_expression, fields, line):
                        for field in fields:
                            region: u32 = destroyed_region_of_expression(field.value, annotations, destroyed, borrow_names, borrow_regions, function_line, use_line)
                            return region if region != NO_REGION_BINDING
                        return NO_REGION_BINDING
                    Expr.RecordUpdate(base, fields, line):
                        base_region: u32 = destroyed_region_of_expression(base, annotations, destroyed, borrow_names, borrow_regions, function_line, use_line)
                        return base_region if base_region != NO_REGION_BINDING
                        for field in fields:
                            region: u32 = destroyed_region_of_expression(field.value, annotations, destroyed, borrow_names, borrow_regions, function_line, use_line)
                            return region if region != NO_REGION_BINDING
                        return NO_REGION_BINDING
                    _:
                        return NO_REGION_BINDING

        # The root VALUE name of a use expression (`values[0]` -> "values"), for
        # stage0's cannot-be-used message.
        def destroyed_use_root_name(expression: Ast::Expr) -> sview:
            can Memory.Allocate, Abort.Panic:
                return match expression:
                    Expr.Ident(root_name, root_line): root_name
                    Expr.Field(object, field, field_line): destroyed_use_root_name(object)
                    Expr.Index(object, index, index_line): destroyed_use_root_name(object)
                    Expr.IndexN(object, arguments, indexn_line): destroyed_use_root_name(object)
                    Expr.Slice(object, start, end, slice_line): destroyed_use_root_name(object)
                    Expr.Unary(operator, operand, unary_line): destroyed_use_root_name(operand)
                    Expr.Paren(inner, paren_line): destroyed_use_root_name(inner)
                    Expr.Call(callee, arguments, argument_names, call_line):
                        for argument in arguments:
                            root: sview = destroyed_use_root_name(argument)
                            return root if root != ""
                        return destroyed_use_root_name(callee)
                    Expr.Refinement(base, predicate, line):
                        base_root: sview = destroyed_use_root_name(base)
                        return base_root if base_root != ""
                        return destroyed_use_root_name(predicate)
                    Expr.Catch(guarded, _, line) | Expr.GetElse(guarded, _, line):
                        return destroyed_use_root_name(guarded)
                    _: ""

        # Explicit arena teardown invalidates values carrying that arena's region just
        # like leaving a lexical `region` block does. Rewind is conservatively treated
        # as invalidating the whole arena because this pass does not track allocation
        # epochs or the rewind mark's position.
        def destroyed_arena_invalidation(expression: Ast::Expr) -> sview:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, line):
                        operation: sview = ident_name_of(callee)
                        invalidates_all: bool = operation == "arena_free" or operation == "arena_reset" or operation == "arena_rewind"
                        if invalidates_all and arguments.count > 0:
                            return destroyed_use_root_name(arguments[0])
                        return ""
                    Expr.Paren(inner, line) | Expr.Move(inner, line):
                        return destroyed_arena_invalidation(inner)
                    _:
                        return ""

        def destroyed_apply_arena_invalidation(expression: Ast::Expr, annotations: darray[Ast::LocalRegionAnnotation]&, function_line: u32, use_line: u32, destroyed: mutable darray[u32]&, alias_ids: darray[u32]&, alias_roots: darray[u32]&) -> void:
            can Memory.Allocate, Abort.Panic:
                arena_region: sview = destroyed_arena_invalidation(expression)
                return if arena_region == ""
                binding_id: u32 = region_binding_id_at(annotations, arena_region, function_line, use_line)
                destroyed_mark_region_binding(destroyed, binding_id, alias_ids, alias_roots)

        def collect_lambda_statement_idents(statement: Ast::Stmt, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match statement:
                    Stmt.Return(value, line):
                        collect_lambda_expression_idents(returned, out) if value is returned
                    Stmt.Expr(expression, line):
                        collect_lambda_expression_idents(expression, out)
                    Stmt.VarDecl(name, type_expression, value, line):
                        collect_lambda_expression_idents(value, out)
                    _:
                        pass


        # Ident collection that descends FIELD receivers (`first.value` mentions "first").
        def collect_lambda_expression_idents(expression: Ast::Expr, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Ident(name, line):
                        out.push(name)
                    Expr.Field(object, field, line):
                        collect_lambda_expression_idents(object, out)
                    Expr.Binary(left, operator, right, line):
                        collect_lambda_expression_idents(left, out)
                        collect_lambda_expression_idents(right, out)
                    Expr.Unary(operator, operand, line):
                        collect_lambda_expression_idents(operand, out)
                    Expr.Paren(inner, line):
                        collect_lambda_expression_idents(inner, out)
                    Expr.Index(object, index, line):
                        collect_lambda_expression_idents(object, out)
                        collect_lambda_expression_idents(index, out)
                    Expr.Call(callee, arguments, argument_names, line):
                        collect_lambda_expression_idents(callee, out)
                        for argument in arguments |out|:
                            collect_lambda_expression_idents(argument, out)
                    _:
                        pass

        def diagnose_destroyed_expression(expression: Ast::Expr, annotations: darray[Ast::LocalRegionAnnotation]&, destroyed: darray[u32]&, borrow_names: darray[sview]&, borrow_regions: darray[u32]&, lambda_dep_names: darray[sview]&, lambda_dep_regions: darray[u32]&, function_line: u32, line: u32, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                region_id: u32 = destroyed_region_of_expression(expression, annotations, destroyed, borrow_names, borrow_regions, function_line, line)
                region_name: sview = region_binding_name(region_id, annotations)
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.DestroyedRegionUse, name: destroyed_use_root_name(expression), pos: ident_extent_or_line(expression, line), line: line, expected: "use", actual: region_name}) if region_id != 0
                return if region_id != 0
                # A LAMBDA that captured a region-dependent binding inherits its
                # dependence: calling it after the destroy is the same stale use.
                root: sview = destroyed_use_root_name(expression)
                lambda_root: sview = root if root != "" else (lambda_call_root(expression))
                probe: mutable usize = 0
                while probe < lambda_dep_names.count |probe, table| -> table:
                    stale: bool = lambda_dep_names[probe] == lambda_root and destroyed_region_id_contains(destroyed, lambda_dep_regions[probe])
                    region_name: sview = region_binding_name(lambda_dep_regions[probe], annotations)
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.DestroyedRegionUse, name: lambda_root, line: line, expected: "use", actual: region_name}) if stale
                    probe <- probe + 1


        # The callee root of `g()` (destroyed_use_root_name does not descend calls).
        def lambda_call_root(expression: Ast::Expr) -> sview:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, line):
                        return ident_name_of(callee)
                    Expr.Paren(inner, paren_line):
                        return lambda_call_root(inner)
                    Expr.Catch(guarded, arms, line) | Expr.GetElse(guarded, recovery, line):
                        return lambda_call_root(guarded)
                    _:
                        return sview("", 0, 0)

        def walk_destroyed_region_statements(statements: darray[Ast::Stmt], annotations: darray[Ast::LocalRegionAnnotation]&, allocation_regions: darray[sview]&, allocation_lines: darray[u32]&, view_fns: darray[sview]&, params: darray[Ast::ParamDecl]&, function_line: u32, destroyed: mutable darray[u32]&, borrow_names: mutable darray[sview]&, borrow_regions: mutable darray[u32]&, lambda_dep_names: mutable darray[sview]&, lambda_dep_regions: mutable darray[u32]&, arena_owner_alias_ids: mutable darray[u32]&, arena_owner_alias_roots: mutable darray[u32]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |destroyed, lambda_dep_names, lambda_dep_regions, arena_owner_alias_ids, arena_owner_alias_roots, table|:
                    match statement:
                        Stmt.Block("destroy", clause, binding, body, line):
                            binding_id: u32 = region_binding_id_at(annotations, clause[0], function_line, line.line) if clause.count > 0 else NO_REGION_BINDING
                            destroyed_mark_region_binding(destroyed, binding_id, arena_owner_alias_ids, arena_owner_alias_roots) if clause.count > 0
                        Stmt.VarDecl(name, type_expression, value, line):
                            destroyed_register_arena_owner_alias(name, value, annotations, params, function_line, line.line, destroyed, arena_owner_alias_ids, arena_owner_alias_roots)
                            allocation_region: sview = allocation_region_at(allocation_regions, allocation_lines, line.line)
                            allocation_region_id: u32 = region_binding_id_at(annotations, allocation_region, function_line, line.line) if allocation_region != "" else NO_REGION_BINDING
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.DestroyedRegionUse, name: name, pos: Ast::expr_pos(value), line: line.line, expected: "allocate", actual: region_binding_name(allocation_region_id, annotations)}) if allocation_region_id != NO_REGION_BINDING and destroyed_region_id_contains(destroyed, allocation_region_id)
                            table <- diagnose_destroyed_expression(value, annotations, destroyed, borrow_names, borrow_regions, lambda_dep_names, lambda_dep_regions, function_line, line.line, table)
                            if destroyed_type_is_view(type_expression):
                                regions: mutable darray[u32] = []
                                destroyed_collect_view_regions(value, annotations, view_fns, borrow_names, borrow_regions, function_line, line.line, regions)
                                borrow_names.push(name)
                                borrow_regions.push(NO_REGION_BINDING)
                                for region in regions:
                                    borrow_names.push(name)
                                    borrow_regions.push(region)
                            match value:
                                Expr.Lambda(lambda_params, lambda_body, lambda_line):
                                    captured_names: mutable darray[sview] = []
                                    for lambda_statement in lambda_body |captured_names|:
                                        collect_lambda_statement_idents(lambda_statement, captured_names)
                                    for captured in captured_names |lambda_dep_names, lambda_dep_regions, name, line|:
                                        captured_regions: mutable darray[u32] = []
                                        function_regions_of_name(annotations, captured, function_line, line.line, captured_regions)
                                        if captured_regions.count == 0:
                                            alias_region: u32 = destroyed_alias_region(captured, borrow_names, borrow_regions, destroyed)
                                            captured_regions.push(alias_region) if alias_region != NO_REGION_BINDING
                                        for captured_region in captured_regions |lambda_dep_names, lambda_dep_regions, name|:
                                            exists: mutable bool = false
                                            for dependency_index in 0..<lambda_dep_names.count |exists, lambda_dep_names, lambda_dep_regions, name, captured_region|:
                                                exists <- true if lambda_dep_names[dependency_index] == name and lambda_dep_regions[dependency_index] == captured_region
                                            if not exists:
                                                lambda_dep_names.push(name)
                                                lambda_dep_regions.push(captured_region)
                                _:
                                    pass
                        Stmt.Assign(target, operator, value, line):
                            table <- diagnose_destroyed_expression(value, annotations, destroyed, borrow_names, borrow_regions, lambda_dep_names, lambda_dep_regions, function_line, line.line, table)
                            target_name: sview = destroyed_use_root_name(target)
                            if any borrow_name in borrow_names where borrow_name == target_name:
                                regions: mutable darray[u32] = []
                                destroyed_collect_view_regions(value, annotations, view_fns, borrow_names, borrow_regions, function_line, line.line, regions)
                                borrow_names.push(target_name)
                                borrow_regions.push(NO_REGION_BINDING)
                                for region in regions:
                                    borrow_names.push(target_name)
                                    borrow_regions.push(region)
                            destroyed_apply_arena_invalidation(value, annotations, function_line, line.line, destroyed, arena_owner_alias_ids, arena_owner_alias_roots)
                        Stmt.Expr(expression, line):
                            table <- diagnose_destroyed_expression(expression, annotations, destroyed, borrow_names, borrow_regions, lambda_dep_names, lambda_dep_regions, function_line, line.line, table)
                            destroyed_apply_arena_invalidation(expression, annotations, function_line, line.line, destroyed, arena_owner_alias_ids, arena_owner_alias_roots)
                        Stmt.Return(value, line):
                            table <- diagnose_destroyed_expression(returned, annotations, destroyed, borrow_names, borrow_regions, lambda_dep_names, lambda_dep_regions, function_line, line.line, table) if value is returned
                        Stmt.If(condition, then_body, else_body, line):
                            table <- walk_destroyed_region_statements(then_body, annotations, allocation_regions, allocation_lines, view_fns, params, function_line, destroyed, borrow_names, borrow_regions, lambda_dep_names, lambda_dep_regions, arena_owner_alias_ids, arena_owner_alias_roots, table)
                            table <- walk_destroyed_region_statements(else_body, annotations, allocation_regions, allocation_lines, view_fns, params, function_line, destroyed, borrow_names, borrow_regions, lambda_dep_names, lambda_dep_regions, arena_owner_alias_ids, arena_owner_alias_roots, table)
                        Stmt.While(condition, body, line):
                            table <- walk_destroyed_region_statements(body, annotations, allocation_regions, allocation_lines, view_fns, params, function_line, destroyed, borrow_names, borrow_regions, lambda_dep_names, lambda_dep_regions, arena_owner_alias_ids, arena_owner_alias_roots, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- walk_destroyed_region_statements(body, annotations, allocation_regions, allocation_lines, view_fns, params, function_line, destroyed, borrow_names, borrow_regions, lambda_dep_names, lambda_dep_regions, arena_owner_alias_ids, arena_owner_alias_roots, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- walk_destroyed_region_statements(body, annotations, allocation_regions, allocation_lines, view_fns, params, function_line, destroyed, borrow_names, borrow_regions, lambda_dep_names, lambda_dep_regions, arena_owner_alias_ids, arena_owner_alias_roots, table)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |destroyed, table|:
                                table <- walk_destroyed_region_statements(arm.body, annotations, allocation_regions, allocation_lines, view_fns, params, function_line, destroyed, borrow_names, borrow_regions, lambda_dep_names, lambda_dep_regions, arena_owner_alias_ids, arena_owner_alias_roots, table)
                        _:
                            pass

        def check_destroyed_region_declarations(declarations: darray[Ast::Decl], file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table|:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            destroyed: mutable darray[u32] = []
                            borrow_names: mutable darray[sview] = []
                            borrow_regions: mutable darray[u32] = []
                            lambda_dep_names: mutable darray[sview] = []
                            lambda_dep_regions: mutable darray[u32] = []
                            arena_owner_alias_ids: mutable darray[u32] = []
                            arena_owner_alias_roots: mutable darray[u32] = []
                            view_fns: mutable darray[sview] = []
                            collect_view_returning_fns(file.top_decls, view_fns)
                            for parameter in params:
                                if destroyed_type_is_view(parameter.type_expression):
                                    borrow_names.push(parameter.name)
                                    borrow_regions.push(NO_REGION_BINDING)
                                    parameter_regions: mutable darray[u32] = []
                                    function_regions_of_name(file.local_region_annotations, parameter.name, line.line, line.line, parameter_regions)
                                    for parameter_region in parameter_regions:
                                        borrow_names.push(parameter.name)
                                        borrow_regions.push(parameter_region)
                            table <- walk_destroyed_region_statements(body, file.local_region_annotations, file.allocation_region_names, file.allocation_region_lines, view_fns, params, line.line, destroyed, borrow_names, borrow_regions, lambda_dep_names, lambda_dep_regions, arena_owner_alias_ids, arena_owner_alias_roots, table)
                        Decl.Module(name, body, line):
                            table <- check_destroyed_region_declarations(body, file, table)
                        Decl.Scoped(body, line):
                            table <- check_destroyed_region_declarations(body, file, table)
                        _:
                            pass

    public:
        def check_destroyed_region(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- check_destroyed_region_declarations(file.top_decls, file, table)
