                        destroyed_apply_arena_invalidation(value, annotations, function_line, use_line, destroyed, alias_ids, alias_roots, summary_names, summary_params, summary_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params)
                    Expr.Binary(left, operator, right, line) | Expr.Index(left, right, line):
                        destroyed_apply_arena_invalidation(left, annotations, function_line, use_line, destroyed, alias_ids, alias_roots, summary_names, summary_params, summary_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params)
                        destroyed_apply_arena_invalidation(right, annotations, function_line, use_line, destroyed, alias_ids, alias_roots, summary_names, summary_params, summary_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params)
                    Expr.Field(object, field, line) | Expr.Scope(object, field, line):
                        destroyed_apply_arena_invalidation(object, annotations, function_line, use_line, destroyed, alias_ids, alias_roots, summary_names, summary_params, summary_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params)
                    _:
                        pass


        def destroyed_apply_arena_invalidation_statements(statements: darray[Ast::Stmt], annotations: darray[Ast::LocalRegionAnnotation]&, function_line: u32, destroyed: mutable darray[u32]&, alias_ids: darray[u32]&, alias_roots: darray[u32]&, summary_names: darray[sview]&, summary_params: darray[u32]&, summary_formals: darray[sview]&, local_function_names: darray[sview]&, local_reference_names: darray[sview]&, opaque_function_names: darray[sview]&, opaque_function_starts: darray[usize]&, opaque_function_arities: darray[u32]&, extern_params: darray[Ast::ExternParam]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |annotations, function_line, destroyed, alias_ids, alias_roots, summary_names, summary_params, summary_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params|:
                    match statement:
                        Stmt.Block("destroy", clause, binding, body, position):
                            binding_id: u32 = region_binding_id_at(annotations, clause[0], function_line, position.line) if clause.count > 0 else NO_REGION_BINDING
                            destroyed_mark_region_binding(destroyed, binding_id, alias_ids, alias_roots) if clause.count > 0
                            destroyed_apply_arena_invalidation_statements(body, annotations, function_line, destroyed, alias_ids, alias_roots, summary_names, summary_params, summary_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params)
                        Stmt.Block(kind, clause, binding, body, position):
                            destroyed_apply_arena_invalidation_statements(body, annotations, function_line, destroyed, alias_ids, alias_roots, summary_names, summary_params, summary_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params)
                        Stmt.Expr(expression, position) | Stmt.VarDecl(_, _, expression, position):
                            destroyed_apply_arena_invalidation(expression, annotations, function_line, position.line, destroyed, alias_ids, alias_roots, summary_names, summary_params, summary_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params)
                        Stmt.Assign(target, operator, value, position):
                            destroyed_apply_arena_invalidation(target, annotations, function_line, position.line, destroyed, alias_ids, alias_roots, summary_names, summary_params, summary_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params)
                            destroyed_apply_arena_invalidation(value, annotations, function_line, position.line, destroyed, alias_ids, alias_roots, summary_names, summary_params, summary_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params)
                        Stmt.If(condition, then_body, else_body, position):
                            destroyed_apply_arena_invalidation(condition, annotations, function_line, position.line, destroyed, alias_ids, alias_roots, summary_names, summary_params, summary_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params)
                            destroyed_apply_arena_invalidation_statements(then_body, annotations, function_line, destroyed, alias_ids, alias_roots, summary_names, summary_params, summary_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params)
                            destroyed_apply_arena_invalidation_statements(else_body, annotations, function_line, destroyed, alias_ids, alias_roots, summary_names, summary_params, summary_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params)
                        Stmt.While(condition, body, position):
                            destroyed_apply_arena_invalidation(condition, annotations, function_line, position.line, destroyed, alias_ids, alias_roots, summary_names, summary_params, summary_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params)
                            destroyed_apply_arena_invalidation_statements(body, annotations, function_line, destroyed, alias_ids, alias_roots, summary_names, summary_params, summary_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params)
                        Stmt.For(bind, variables, iterable, body, position):
                            destroyed_apply_arena_invalidation(iterable, annotations, function_line, position.line, destroyed, alias_ids, alias_roots, summary_names, summary_params, summary_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params)
                            destroyed_apply_arena_invalidation_statements(body, annotations, function_line, destroyed, alias_ids, alias_roots, summary_names, summary_params, summary_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params)
                        Stmt.Return(value, position):
                            destroyed_apply_arena_invalidation(returned, annotations, function_line, position.line, destroyed, alias_ids, alias_roots, summary_names, summary_params, summary_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params) if value is returned
                        Stmt.Match(scrutinee, arms, position):
                            destroyed_apply_arena_invalidation(scrutinee, annotations, function_line, position.line, destroyed, alias_ids, alias_roots, summary_names, summary_params, summary_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params)
                            for arm in arms |annotations, function_line, destroyed, alias_ids, alias_roots, summary_names, summary_params, summary_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params|:
                                destroyed_apply_arena_invalidation(arm.guard, annotations, function_line, position.line, destroyed, alias_ids, alias_roots, summary_names, summary_params, summary_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params)
                                destroyed_apply_arena_invalidation_statements(arm.body, annotations, function_line, destroyed, alias_ids, alias_roots, summary_names, summary_params, summary_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params)
                        Stmt.Contract(kind, expression, position):
                            destroyed_apply_arena_invalidation(expression, annotations, function_line, position.line, destroyed, alias_ids, alias_roots, summary_names, summary_params, summary_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params)
                        _:
                            pass


        def collect_lambda_statement_idents(statement: Ast::Stmt, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match statement:
                    Stmt.Return(value, line):
                        collect_lambda_expression_idents(returned, out) if value is returned
                    Stmt.Expr(expression, line):
                        collect_lambda_expression_idents(expression, out)
                    Stmt.VarDecl(name, type_expression, value, line):
                        collect_lambda_expression_idents(value, out)
                    _:
                        pass


        # Ident collection that descends FIELD receivers (`first.value` mentions "first").
        def collect_lambda_expression_idents(expression: Ast::Expr, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Ident(name, line):
                        out.push(name)
                    Expr.Field(object, field, line):
                        collect_lambda_expression_idents(object, out)
                    Expr.Binary(left, operator, right, line):
                        collect_lambda_expression_idents(left, out)
                        collect_lambda_expression_idents(right, out)
                    Expr.Unary(operator, operand, line):
                        collect_lambda_expression_idents(operand, out)
                    Expr.Paren(inner, line):
                        collect_lambda_expression_idents(inner, out)
                    Expr.Index(object, index, line):
                        collect_lambda_expression_idents(object, out)
                        collect_lambda_expression_idents(index, out)
                    Expr.Call(callee, arguments, argument_names, line):
                        collect_lambda_expression_idents(callee, out)
                        for argument in arguments |out|:
                            collect_lambda_expression_idents(argument, out)
                    _:
                        pass

        def diagnose_destroyed_expression(expression: Ast::Expr, annotations: darray[Ast::LocalRegionAnnotation]&, destroyed: darray[u32]&, borrow_names: darray[sview]&, borrow_regions: darray[u32]&, lambda_dep_names: darray[sview]&, lambda_dep_regions: darray[u32]&, function_line: u32, line: u32, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                region_id: u32 = destroyed_region_of_expression(expression, annotations, destroyed, borrow_names, borrow_regions, function_line, line)
                region_name: sview = region_binding_name(region_id, annotations)
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.DestroyedRegionUse, name: destroyed_use_root_name(expression), pos: ident_extent_or_line(expression, line), line: line, expected: "use", actual: region_name}) if region_id != 0
                return if region_id != 0
                # A LAMBDA that captured a region-dependent binding inherits its
                # dependence: calling it after the destroy is the same stale use.
                root: sview = destroyed_use_root_name(expression)
                lambda_root: sview = root if root != "" else (lambda_call_root(expression))
                probe: mutable usize = 0
                while probe < lambda_dep_names.count |probe, table| -> table:
                    stale: bool = lambda_dep_names[probe] == lambda_root and destroyed_region_id_contains(destroyed, lambda_dep_regions[probe])
                    region_name: sview = region_binding_name(lambda_dep_regions[probe], annotations)
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.DestroyedRegionUse, name: lambda_root, line: line, expected: "use", actual: region_name}) if stale
                    probe <- probe + 1


        # The callee root of `g()` (destroyed_use_root_name does not descend calls).
        def lambda_call_root(expression: Ast::Expr) -> sview:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, line):
                        return ident_name_of(callee)
                    Expr.Paren(inner, paren_line):
                        return lambda_call_root(inner)
                    Expr.Catch(guarded, arms, line) | Expr.GetElse(guarded, recovery, line):
                        return lambda_call_root(guarded)
                    _:
                        return sview("", 0, 0)

        def walk_destroyed_region_statements(statements: darray[Ast::Stmt], annotations: darray[Ast::LocalRegionAnnotation]&, allocation_regions: darray[sview]&, allocation_lines: darray[u32]&, view_fns: darray[sview]&, params: darray[Ast::ParamDecl]&, function_line: u32, destroyed: mutable darray[u32]&, borrow_names: mutable darray[sview]&, borrow_regions: mutable darray[u32]&, lambda_dep_names: mutable darray[sview]&, lambda_dep_regions: mutable darray[u32]&, arena_owner_alias_ids: mutable darray[u32]&, arena_owner_alias_roots: mutable darray[u32]&, arena_invalidation_names: darray[sview]&, arena_invalidation_params: darray[u32]&, arena_invalidation_formals: darray[sview]&, local_function_names: darray[sview]&, local_reference_names: darray[sview]&, opaque_function_names: darray[sview]&, opaque_function_starts: darray[usize]&, opaque_function_arities: darray[u32]&, extern_params: darray[Ast::ExternParam]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |destroyed, lambda_dep_names, lambda_dep_regions, arena_owner_alias_ids, arena_owner_alias_roots, table|:
                    match statement:
                        Stmt.Block("destroy", clause, binding, body, line):
                            binding_id: u32 = region_binding_id_at(annotations, clause[0], function_line, line.line) if clause.count > 0 else NO_REGION_BINDING
                            destroyed_mark_region_binding(destroyed, binding_id, arena_owner_alias_ids, arena_owner_alias_roots) if clause.count > 0
                        Stmt.VarDecl(name, type_expression, value, line):
                            destroyed_register_arena_owner_alias(name, value, annotations, params, function_line, line.line, destroyed, arena_owner_alias_ids, arena_owner_alias_roots)
                            destroyed_apply_arena_invalidation(value, annotations, function_line, line.line, destroyed, arena_owner_alias_ids, arena_owner_alias_roots, arena_invalidation_names, arena_invalidation_params, arena_invalidation_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params)
                            allocation_region: sview = allocation_region_at(allocation_regions, allocation_lines, line.line)
                            allocation_region_id: u32 = region_binding_id_at(annotations, allocation_region, function_line, line.line) if allocation_region != "" else NO_REGION_BINDING
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.DestroyedRegionUse, name: name, pos: Ast::expr_pos(value), line: line.line, expected: "allocate", actual: region_binding_name(allocation_region_id, annotations)}) if allocation_region_id != NO_REGION_BINDING and destroyed_region_id_contains(destroyed, allocation_region_id)
                            table <- diagnose_destroyed_expression(value, annotations, destroyed, borrow_names, borrow_regions, lambda_dep_names, lambda_dep_regions, function_line, line.line, table)
                            if destroyed_type_is_view(type_expression):
                                regions: mutable darray[u32] = []
                                destroyed_collect_view_regions(value, annotations, view_fns, borrow_names, borrow_regions, function_line, line.line, regions)
                                borrow_names.push(name)
                                borrow_regions.push(NO_REGION_BINDING)
                                for region in regions:
                                    borrow_names.push(name)
                                    borrow_regions.push(region)
                            match value:
                                Expr.Lambda(lambda_params, lambda_body, lambda_line):
                                    captured_names: mutable darray[sview] = []
                                    for lambda_statement in lambda_body |captured_names|:
                                        collect_lambda_statement_idents(lambda_statement, captured_names)
                                    for captured in captured_names |lambda_dep_names, lambda_dep_regions, name, line|:
                                        captured_regions: mutable darray[u32] = []
                                        function_regions_of_name(annotations, captured, function_line, line.line, captured_regions)
                                        if captured_regions.count == 0:
                                            alias_region: u32 = destroyed_alias_region(captured, borrow_names, borrow_regions, destroyed)
                                            captured_regions.push(alias_region) if alias_region != NO_REGION_BINDING
                                        for captured_region in captured_regions |lambda_dep_names, lambda_dep_regions, name|:
                                            exists: mutable bool = false
                                            for dependency_index in 0..<lambda_dep_names.count |exists, lambda_dep_names, lambda_dep_regions, name, captured_region|:
                                                exists <- true if lambda_dep_names[dependency_index] == name and lambda_dep_regions[dependency_index] == captured_region
                                            if not exists:
                                                lambda_dep_names.push(name)
                                                lambda_dep_regions.push(captured_region)
                                _:
                                    pass
                        Stmt.Assign(target, operator, value, line):
                            destroyed_apply_arena_invalidation(target, annotations, function_line, line.line, destroyed, arena_owner_alias_ids, arena_owner_alias_roots, arena_invalidation_names, arena_invalidation_params, arena_invalidation_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params)
                            destroyed_apply_arena_invalidation(value, annotations, function_line, line.line, destroyed, arena_owner_alias_ids, arena_owner_alias_roots, arena_invalidation_names, arena_invalidation_params, arena_invalidation_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params)
                            table <- diagnose_destroyed_expression(value, annotations, destroyed, borrow_names, borrow_regions, lambda_dep_names, lambda_dep_regions, function_line, line.line, table)
                            target_name: sview = destroyed_use_root_name(target)
                            if any borrow_name in borrow_names where borrow_name == target_name:
                                regions: mutable darray[u32] = []
                                destroyed_collect_view_regions(value, annotations, view_fns, borrow_names, borrow_regions, function_line, line.line, regions)
                                borrow_names.push(target_name)
                                borrow_regions.push(NO_REGION_BINDING)
                                for region in regions:
                                    borrow_names.push(target_name)
                                    borrow_regions.push(region)
                        Stmt.Expr(expression, line):
                            destroyed_apply_arena_invalidation(expression, annotations, function_line, line.line, destroyed, arena_owner_alias_ids, arena_owner_alias_roots, arena_invalidation_names, arena_invalidation_params, arena_invalidation_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params)
                            table <- diagnose_destroyed_expression(expression, annotations, destroyed, borrow_names, borrow_regions, lambda_dep_names, lambda_dep_regions, function_line, line.line, table)
                        Stmt.Return(value, line):
                            destroyed_apply_arena_invalidation(returned, annotations, function_line, line.line, destroyed, arena_owner_alias_ids, arena_owner_alias_roots, arena_invalidation_names, arena_invalidation_params, arena_invalidation_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params) if value is returned
                            table <- diagnose_destroyed_expression(returned, annotations, destroyed, borrow_names, borrow_regions, lambda_dep_names, lambda_dep_regions, function_line, line.line, table) if value is returned
                        Stmt.If(condition, then_body, else_body, line):
                            destroyed_apply_arena_invalidation(condition, annotations, function_line, line.line, destroyed, arena_owner_alias_ids, arena_owner_alias_roots, arena_invalidation_names, arena_invalidation_params, arena_invalidation_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params)
                            table <- walk_destroyed_region_statements(then_body, annotations, allocation_regions, allocation_lines, view_fns, params, function_line, destroyed, borrow_names, borrow_regions, lambda_dep_names, lambda_dep_regions, arena_owner_alias_ids, arena_owner_alias_roots, arena_invalidation_names, arena_invalidation_params, arena_invalidation_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params, table)
                            table <- walk_destroyed_region_statements(else_body, annotations, allocation_regions, allocation_lines, view_fns, params, function_line, destroyed, borrow_names, borrow_regions, lambda_dep_names, lambda_dep_regions, arena_owner_alias_ids, arena_owner_alias_roots, arena_invalidation_names, arena_invalidation_params, arena_invalidation_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params, table)
                        Stmt.While(condition, body, line):
                            destroyed_apply_arena_invalidation(condition, annotations, function_line, line.line, destroyed, arena_owner_alias_ids, arena_owner_alias_roots, arena_invalidation_names, arena_invalidation_params, arena_invalidation_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params)
                            table <- walk_destroyed_region_statements(body, annotations, allocation_regions, allocation_lines, view_fns, params, function_line, destroyed, borrow_names, borrow_regions, lambda_dep_names, lambda_dep_regions, arena_owner_alias_ids, arena_owner_alias_roots, arena_invalidation_names, arena_invalidation_params, arena_invalidation_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            destroyed_apply_arena_invalidation(iterable, annotations, function_line, line.line, destroyed, arena_owner_alias_ids, arena_owner_alias_roots, arena_invalidation_names, arena_invalidation_params, arena_invalidation_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params)
                            table <- walk_destroyed_region_statements(body, annotations, allocation_regions, allocation_lines, view_fns, params, function_line, destroyed, borrow_names, borrow_regions, lambda_dep_names, lambda_dep_regions, arena_owner_alias_ids, arena_owner_alias_roots, arena_invalidation_names, arena_invalidation_params, arena_invalidation_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- walk_destroyed_region_statements(body, annotations, allocation_regions, allocation_lines, view_fns, params, function_line, destroyed, borrow_names, borrow_regions, lambda_dep_names, lambda_dep_regions, arena_owner_alias_ids, arena_owner_alias_roots, arena_invalidation_names, arena_invalidation_params, arena_invalidation_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params, table)
                        Stmt.Match(scrutinee, arms, line):
                            destroyed_apply_arena_invalidation(scrutinee, annotations, function_line, line.line, destroyed, arena_owner_alias_ids, arena_owner_alias_roots, arena_invalidation_names, arena_invalidation_params, arena_invalidation_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params)
                            for arm in arms |destroyed, table|:
                                destroyed_apply_arena_invalidation(arm.guard, annotations, function_line, line.line, destroyed, arena_owner_alias_ids, arena_owner_alias_roots, arena_invalidation_names, arena_invalidation_params, arena_invalidation_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params)
                                table <- walk_destroyed_region_statements(arm.body, annotations, allocation_regions, allocation_lines, view_fns, params, function_line, destroyed, borrow_names, borrow_regions, lambda_dep_names, lambda_dep_regions, arena_owner_alias_ids, arena_owner_alias_roots, arena_invalidation_names, arena_invalidation_params, arena_invalidation_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params, table)
                        Stmt.Contract(kind, expression, line):
                            destroyed_apply_arena_invalidation(expression, annotations, function_line, line.line, destroyed, arena_owner_alias_ids, arena_owner_alias_roots, arena_invalidation_names, arena_invalidation_params, arena_invalidation_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params)
                            table <- diagnose_destroyed_expression(expression, annotations, destroyed, borrow_names, borrow_regions, lambda_dep_names, lambda_dep_regions, function_line, line.line, table)
                        _:
                            pass

        def check_destroyed_region_declarations(declarations: darray[Ast::Decl], file: Ast::File&, arena_invalidation_names: darray[sview]&, arena_invalidation_params: darray[u32]&, arena_invalidation_formals: darray[sview]&, local_function_names: darray[sview]&, opaque_function_names: darray[sview]&, opaque_function_starts: darray[usize]&, opaque_function_arities: darray[u32]&, extern_params: darray[Ast::ExternParam]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table|:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            destroyed: mutable darray[u32] = []
                            borrow_names: mutable darray[sview] = []
                            borrow_regions: mutable darray[u32] = []
                            lambda_dep_names: mutable darray[sview] = []
                            lambda_dep_regions: mutable darray[u32] = []
                            arena_owner_alias_ids: mutable darray[u32] = []
                            arena_owner_alias_roots: mutable darray[u32] = []
                            local_reference_names: mutable darray[sview] = []
                            destroyed_collect_local_reference_names(name, line, table, local_reference_names)
                            view_fns: mutable darray[sview] = []
                            collect_view_returning_fns(file.top_decls, view_fns)
                            for parameter in params:
                                if destroyed_type_is_view(parameter.type_expression):
                                    borrow_names.push(parameter.name)
                                    borrow_regions.push(NO_REGION_BINDING)
                                    parameter_regions: mutable darray[u32] = []
                                    function_regions_of_name(file.local_region_annotations, parameter.name, line.line, line.line, parameter_regions)
                                    for parameter_region in parameter_regions:
                                        borrow_names.push(parameter.name)
                                        borrow_regions.push(parameter_region)
                            table <- walk_destroyed_region_statements(body, file.local_region_annotations, file.allocation_region_names, file.allocation_region_lines, view_fns, params, line.line, destroyed, borrow_names, borrow_regions, lambda_dep_names, lambda_dep_regions, arena_owner_alias_ids, arena_owner_alias_roots, arena_invalidation_names, arena_invalidation_params, arena_invalidation_formals, local_function_names, local_reference_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params, table)
                        Decl.Module(name, body, line):
                            table <- check_destroyed_region_declarations(body, file, arena_invalidation_names, arena_invalidation_params, arena_invalidation_formals, local_function_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params, table)
                        Decl.Scoped(body, line):
                            table <- check_destroyed_region_declarations(body, file, arena_invalidation_names, arena_invalidation_params, arena_invalidation_formals, local_function_names, opaque_function_names, opaque_function_starts, opaque_function_arities, extern_params, table)
                        _:
                            pass

    public:
        def check_destroyed_region(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                arena_invalidation_names: mutable darray[sview] = []
                arena_invalidation_params: mutable darray[u32] = []
                arena_invalidation_formals: mutable darray[sview] = []
                local_function_names: mutable darray[sview] = []
                opaque_function_names: mutable darray[sview] = []
                opaque_function_starts: mutable darray[usize] = []
                opaque_function_arities: mutable darray[u32] = []
                destroyed_collect_local_function_names(file.top_decls, local_function_names)
                destroyed_collect_opaque_function_signatures(file.top_decls, opaque_function_names, opaque_function_starts, opaque_function_arities)
                summaries_changed: mutable bool = true
                while summaries_changed |summaries_changed, file, arena_invalidation_names, arena_invalidation_params, arena_invalidation_formals, local_function_names, opaque_function_names, opaque_function_starts, opaque_function_arities|:
                    summaries_changed <- false
                    destroyed_collect_arena_invalidation_summaries(file.top_decls, arena_invalidation_names, arena_invalidation_params, arena_invalidation_formals, local_function_names, opaque_function_names, summaries_changed)
                table <- check_destroyed_region_declarations(file.top_decls, file, arena_invalidation_names, arena_invalidation_params, arena_invalidation_formals, local_function_names, opaque_function_names, opaque_function_starts, opaque_function_arities, file.extern_params, table)
