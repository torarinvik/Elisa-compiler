extend Semantic:
    private:
        def destroyed_region_contains(regions: darray[sview]&, candidate: sview) -> bool:
            for region in regions:
                true return if region == candidate
            return false

        def function_region_of_name(annotations: darray[Ast::LocalRegionAnnotation]&, name: sview, function_line: u32, use_line: u32) -> sview:
            can Abort.Panic:
                found: mutable sview = ""
                for annotation in annotations |found|:
                    is_local_value: bool = annotation.name == name and annotation.line >= function_line and annotation.line <= use_line
                    found <- annotation.region if is_local_value
                return found

        def destroyed_region_of_expression(expression: Ast::Expr, annotations: darray[Ast::LocalRegionAnnotation]&, destroyed: darray[sview]&, function_line: u32, use_line: u32) -> sview:
            can Abort.Panic:
                if expression is Expr.Ident(name, line):
                    region: sview = function_region_of_name(annotations, name, function_line, use_line)
                    return region if destroyed_region_contains(destroyed, region) else ""
                if expression is Expr.Field(receiver, field, line):
                    return destroyed_region_of_expression(receiver, annotations, destroyed, function_line, use_line)
                if expression is Expr.Index(object, index, line):
                    return destroyed_region_of_expression(object, annotations, destroyed, function_line, use_line)
                if expression is Expr.IndexN(object, arguments, line):
                    return destroyed_region_of_expression(object, annotations, destroyed, function_line, use_line)
                if expression is Expr.Slice(object, start, end, line):
                    return destroyed_region_of_expression(object, annotations, destroyed, function_line, use_line)
                if expression is Expr.Unary(operator, operand, line):
                    return destroyed_region_of_expression(operand, annotations, destroyed, function_line, use_line)
                if expression is Expr.Paren(inner, line):
                    return destroyed_region_of_expression(inner, annotations, destroyed, function_line, use_line)
                return ""

        # The root VALUE name of a use expression (`values[0]` -> "values"), for
        # stage0's cannot-be-used message.
        def destroyed_use_root_name(expression: Ast::Expr) -> sview:
            can Memory.Allocate, Abort.Panic:
                return match expression:
                    Expr.Ident(root_name, root_line): root_name
                    Expr.Field(object, field, field_line): destroyed_use_root_name(object)
                    Expr.Index(object, index, index_line): destroyed_use_root_name(object)
                    Expr.IndexN(object, arguments, indexn_line): destroyed_use_root_name(object)
                    Expr.Slice(object, start, end, slice_line): destroyed_use_root_name(object)
                    Expr.Unary(operator, operand, unary_line): destroyed_use_root_name(operand)
                    Expr.Paren(inner, paren_line): destroyed_use_root_name(inner)
                    _: ""

        def diagnose_destroyed_expression(expression: Ast::Expr, annotations: darray[Ast::LocalRegionAnnotation]&, destroyed: darray[sview]&, function_line: u32, line: u32, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                region: sview = destroyed_region_of_expression(expression, annotations, destroyed, function_line, line)
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.DestroyedRegionUse, name: destroyed_use_root_name(expression), line: line, expected: "use", actual: region}) if region != ""

        def walk_destroyed_region_statements(statements: darray[Ast::Stmt], annotations: darray[Ast::LocalRegionAnnotation]&, allocation_regions: darray[sview]&, allocation_lines: darray[u32]&, function_line: u32, destroyed: mutable darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |destroyed, table|:
                    match statement:
                        Stmt.Block("destroy", clause, binding, body, line):
                            destroyed.push(clause[0]) if clause.count > 0 and not destroyed_region_contains(destroyed, clause[0])
                        Stmt.VarDecl(name, type_expression, value, line):
                            allocation_region: sview = allocation_region_at(allocation_regions, allocation_lines, line)
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.DestroyedRegionUse, name: name, line: line, expected: "allocate", actual: allocation_region}) if allocation_region != "" and destroyed_region_contains(destroyed, allocation_region)
                            table <- diagnose_destroyed_expression(value, annotations, destroyed, function_line, line, table)
                        Stmt.Assign(target, operator, value, line):
                            table <- diagnose_destroyed_expression(value, annotations, destroyed, function_line, line, table)
                        Stmt.Expr(expression, line):
                            table <- diagnose_destroyed_expression(expression, annotations, destroyed, function_line, line, table)
                        Stmt.Return(value, line):
                            table <- diagnose_destroyed_expression(returned, annotations, destroyed, function_line, line, table) if value is returned
                        Stmt.If(condition, then_body, else_body, line):
                            table <- walk_destroyed_region_statements(then_body, annotations, allocation_regions, allocation_lines, function_line, destroyed, table)
                            table <- walk_destroyed_region_statements(else_body, annotations, allocation_regions, allocation_lines, function_line, destroyed, table)
                        Stmt.While(condition, body, line):
                            table <- walk_destroyed_region_statements(body, annotations, allocation_regions, allocation_lines, function_line, destroyed, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- walk_destroyed_region_statements(body, annotations, allocation_regions, allocation_lines, function_line, destroyed, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- walk_destroyed_region_statements(body, annotations, allocation_regions, allocation_lines, function_line, destroyed, table)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |destroyed, table|:
                                table <- walk_destroyed_region_statements(arm.body, annotations, allocation_regions, allocation_lines, function_line, destroyed, table)
                        _:
                            pass

        def check_destroyed_region_declarations(declarations: darray[Ast::Decl], file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table|:
                    if declaration is Decl.Func(name, params, return_type, body, effects, decorators, line):
                        destroyed: mutable darray[sview] = []
                        table <- walk_destroyed_region_statements(body, file.local_region_annotations, file.allocation_region_names, file.allocation_region_lines, line, destroyed, table)
                    elif declaration is Decl.Module(name, body, line):
                        table <- check_destroyed_region_declarations(body, file, table)
                    elif declaration is Decl.Scoped(body, line):
                        table <- check_destroyed_region_declarations(body, file, table)

    public:
        def check_destroyed_region(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- check_destroyed_region_declarations(file.top_decls, file, table)
