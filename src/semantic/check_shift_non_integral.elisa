# Check for non-integral (firm Float) operands to shift binary operators: << >>.

extend Semantic:
    private:
        # Whether an operator is one of the shift binary operators we cover.
        def is_shift_operator(operator: TokenKind) -> bool:
            can Abort.Panic:
                return operator == TokenKind.LShift or operator == TokenKind.RShift

        # Walk through expressions, checking for non-integral (Float) shift operands.
        def walk_expression_for_shift_non_integral(expression: Ast::Expr, table: lmut SymbolTable, var_types: mutable darray[sview]&, type_names: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Binary(left, operator, right, line):
                        left_type: InferType = infer_expression_type(left, var_types, type_names, table)
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ShiftOperandNonIntegral, name: "", line: line, expected: "", actual: ""}) if is_shift_operator(operator) and left_type.kind == SemTypeKind.Float
                        right_type: InferType = infer_expression_type(right, var_types, type_names, table)
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ShiftOperandNonIntegral, name: "", line: line, expected: "", actual: ""}) if is_shift_operator(operator) and right_type.kind == SemTypeKind.Float
                        modulo_has_float: bool = operator == TokenKind.Percent and (left_type.kind == SemTypeKind.Float or right_type.kind == SemTypeKind.Float)
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ModuloOperandNonIntegral, name: "", line: line, expected: "", actual: ""}) if modulo_has_float
                        # Recursively walk both sides
                        table <- walk_expression_for_shift_non_integral(left, table, var_types, type_names)
                        table <- walk_expression_for_shift_non_integral(right, table, var_types, type_names) if operator != TokenKind.Is and operator != TokenKind.As
                    Expr.Call(callee, arguments, argument_names, line):
                        table <- walk_expression_for_shift_non_integral(callee, table, var_types, type_names)
                        for argument in arguments |table|:
                            table <- walk_expression_for_shift_non_integral(argument, table, var_types, type_names)
                    Expr.Field(object, field, line):
                        table <- walk_expression_for_shift_non_integral(object, table, var_types, type_names)
                    Expr.Scope(base, name, line):
                        table <- walk_expression_for_shift_non_integral(base, table, var_types, type_names)
                    Expr.Index(object, index, line):
                        object_type: InferType = infer_expression_type(object, var_types, type_names, table)
                        index_type: InferType = infer_expression_type(index, var_types, type_names, table)
                        # `darray` joins `array` here: both are positional, both reject a
                        # float index at stage0 ("index must be integral, got f64"), and the
                        # darray half was silent. index_receiver_is_positional owns the pair.
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ArrayIndexNonIntegral, name: "", line: line, expected: "", actual: stage0_value_spelling(index_type)}) if index_receiver_is_positional(object_type) and index_type.kind == SemTypeKind.Float
                        table <- walk_expression_for_shift_non_integral(object, table, var_types, type_names)
                        table <- walk_expression_for_shift_non_integral(index, table, var_types, type_names) if not index_receiver_is_type_application(object)
                    Expr.Unary(operator, operand, line):
                        table <- walk_expression_for_shift_non_integral(operand, table, var_types, type_names)
                    Expr.Paren(inner, line):
                        table <- walk_expression_for_shift_non_integral(inner, table, var_types, type_names)
                    Expr.Array(elements, line):
                        for element in elements |table|:
                            table <- walk_expression_for_shift_non_integral(element, table, var_types, type_names)
                    Expr.Tuple(elements, line):
                        for element in elements |table|:
                            table <- walk_expression_for_shift_non_integral(element, table, var_types, type_names)
                    Expr.Slice(object, low, high, line):
                        table <- walk_expression_for_shift_non_integral(object, table, var_types, type_names)
                        table <- walk_expression_for_shift_non_integral(low, table, var_types, type_names)
                        table <- walk_expression_for_shift_non_integral(high, table, var_types, type_names)
                    Expr.IndexN(object, arguments, line):
                        table <- walk_expression_for_shift_non_integral(object, table, var_types, type_names)
                        for argument in arguments |table|:
                            table <- walk_expression_for_shift_non_integral(argument, table, var_types, type_names) if not index_receiver_is_type_application(object)
                    Expr.SetLit(elements, line):
                        for element in elements |table|:
                            table <- walk_expression_for_shift_non_integral(element, table, var_types, type_names)
                    Expr.DictLit(entries, line):
                        for entry in entries |table|:
                            table <- walk_expression_for_shift_non_integral(entry.key, table, var_types, type_names)
                            table <- walk_expression_for_shift_non_integral(entry.value, table, var_types, type_names)
                    Expr.Construct(type_expression, fields, line):
                        table <- walk_expression_for_shift_non_integral(type_expression, table, var_types, type_names)
                        for field in fields |table|:
                            table <- walk_expression_for_shift_non_integral(field.value, table, var_types, type_names)
                    Expr.RecordUpdate(base, fields, line):
                        table <- walk_expression_for_shift_non_integral(base, table, var_types, type_names)
                        for field in fields |table|:
                            table <- walk_expression_for_shift_non_integral(field.value, table, var_types, type_names)
                    Expr.If(condition, then_expr, else_expr, line):
                        table <- walk_expression_for_shift_non_integral(condition, table, var_types, type_names)
                        table <- walk_expression_for_shift_non_integral(then_expr, table, var_types, type_names)
                        table <- walk_expression_for_shift_non_integral(else_expr, table, var_types, type_names)
                    Expr.Comprehension(loop_variable, iterable, condition, body, line):
                        table <- walk_expression_for_shift_non_integral(iterable, table, var_types, type_names)
                        table <- walk_expression_for_shift_non_integral(condition, table, var_types, type_names)
                        table <- walk_expression_for_shift_non_integral(body, table, var_types, type_names)
                    Expr.Lambda(parameters, body, line):
                        table <- walk_statements_for_shift_non_integral(body, table, var_types, type_names)
                    Expr.Block(statements, value, captures, line):
                        table <- walk_statements_for_shift_non_integral(statements, table, var_types, type_names)
                        table <- walk_expression_for_shift_non_integral(value, table, var_types, type_names)
                    Expr.Match(scrutinee, arms, line):
                        table <- walk_expression_for_shift_non_integral(scrutinee, table, var_types, type_names)
                        for arm in arms |table|:
                            table <- walk_statements_for_shift_non_integral(arm.body, table, var_types, type_names)
                    # Literals and other expressions don't contain relevant sub-expressions
                    _:
                        pass

        # Walk through statements, tracking variable types and checking for non-numeric shift operands.
        def walk_statements_for_shift_non_integral(statements: darray[Ast::Stmt], table: lmut SymbolTable, var_types: mutable darray[sview]&, type_names: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table|:
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- walk_expression_for_shift_non_integral(expression, table, var_types, type_names)
                        Stmt.VarDecl(name, type_expression, value, line):
                            # Record the type for this variable
                            type_name: sview = bare_type_name(type_expression)
                            note_local_type(var_types, type_names, name, type_name)
                            table <- walk_expression_for_shift_non_integral(value, table, var_types, type_names)
                        Stmt.Assign(target, operator, value, line):
                            table <- walk_expression_for_shift_non_integral(target, table, var_types, type_names)
                            table <- walk_expression_for_shift_non_integral(value, table, var_types, type_names)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- walk_expression_for_shift_non_integral(condition, table, var_types, type_names)
                            table <- walk_statements_for_shift_non_integral(then_body, table, var_types, type_names)
                            table <- walk_statements_for_shift_non_integral(else_body, table, var_types, type_names)
                        Stmt.While(condition, body, line):
                            table <- walk_expression_for_shift_non_integral(condition, table, var_types, type_names)
                            table <- walk_statements_for_shift_non_integral(body, table, var_types, type_names)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- walk_expression_for_shift_non_integral(iterable, table, var_types, type_names)
                            table <- walk_statements_for_shift_non_integral(body, table, var_types, type_names)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- walk_statements_for_shift_non_integral(body, table, var_types, type_names)
                        Stmt.Match(scrutinee, arms, line):
                            table <- walk_expression_for_shift_non_integral(scrutinee, table, var_types, type_names)
                            for arm in arms |table|:
                                table <- walk_expression_for_shift_non_integral(arm.guard, table, var_types, type_names)
                                table <- walk_statements_for_shift_non_integral(arm.body, table, var_types, type_names)
                        Stmt.Return(value, line):
                            table <- walk_expression_for_shift_non_integral(return_value, table, var_types, type_names) if value is return_value
                        Stmt.Contract(kind, expression, line):
                            table <- walk_expression_for_shift_non_integral(expression, table, var_types, type_names)
                        Stmt.Invalid:
                            pass
                        Stmt.Break(label, line):
                            pass
                        Stmt.Continue(label, line):
                            pass

        # Walk through function declarations.
        def check_shift_non_integral_declarations(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table|:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            # Create fresh type tracking for this function
                            var_types: mutable darray[sview] = []
                            type_names: mutable darray[sview] = []
                            # Record parameter types
                            for param in params |table|:
                                param_type: sview = bare_type_name(param.type_expression)
                                note_local_type(var_types, type_names, param.name, param_type)
                            # Walk the function body
                            table <- walk_statements_for_shift_non_integral(body, table, var_types, type_names)
                        Decl.Module(module_name, body, line):
                            table <- check_shift_non_integral_declarations(body, table)
                        Decl.Scoped(body, line):
                            table <- check_shift_non_integral_declarations(body, table)
                        _:
                            pass

    public:
        # Public entry point for the check.
        def check_shift_non_integral(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- check_shift_non_integral_declarations(declarations, table)
