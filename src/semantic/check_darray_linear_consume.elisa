# A `darray` (or `set`) whose element type holds a linear handle (an affine, linear or `__drop__`
# struct, a builtin handle, or anything containing one) holds must-consume values; the container
# itself must be consumed before scope exit — drained with `for x in move c:`, moved, or
# returned. An un-consumed such local or by-value param leaks its elements. stage0:
# "darray of must-consume elements (drain with `for x in move c:`) 'gs' must be consumed before
# scope exit". SOUND subset: flag a darray/set-of-linear local or param that is NEVER the operand of a
# `move` (which covers `for x in move c`, `f(move c)`, `x <- move c`, `return move c`). Any
# move anywhere is treated as possible consumption (a conservative miss), so a drained or
# handed-off container is never falsely flagged.
extend Semantic:
    private:
        def darray_linear_type_names(declarations: darray[Ast::Decl], out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |out|:
                    match declaration:
                        Decl.Struct(struct_name, members, affinity, has_named_states, has_derive, invariants, struct_line):
                            out.push(struct_name) if affinity == "linear"
                        Decl.Module(module_name, module_body, module_line):
                            darray_linear_type_names(module_body, out)
                        Decl.Scoped(scoped_body, scoped_line):
                            darray_linear_type_names(scoped_body, out)
                        _:
                            pass

        def darray_linear_name_present(names: darray[sview]&, wanted: sview) -> bool:
            can Abort.Panic:
                return any name in names where name == wanted

        # Name-based linear-element test, used by the drain-discipline and linear-reference
        # checks: a `darray`/`set` whose element is a declared `linear` struct or a nested one.
        def darray_linear_element(type_expression: Ast::Expr, linear_names: darray[sview]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                match type_expression:
                    Expr.Index(head, argument, index_line):
                        head_name: sview = ident_name_of(head)
                        # The element is must-consume if it is a linear struct OR itself a
                        # `darray`/`set` of a must-consume element (nested containers).
                        return (head_name == "darray" or head_name == "set") and (darray_linear_name_present(linear_names, ident_name_of(argument)) or darray_linear_element(argument, linear_names))
                    Expr.IndexN(head, arguments, index_n_line):
                        head_name_n: sview = ident_name_of(head)
                        element_n: sview = ident_name_of(arguments[0]) if arguments.count > 0 else sview("", 0, 0)
                        nested_n: bool = arguments.count > 0 and darray_linear_element(arguments[0], linear_names)
                        return (head_name_n == "darray" or head_name_n == "set") and (darray_linear_name_present(linear_names, element_n) or nested_n)
                    Expr.Unary(operator, operand, unary_line):
                        return darray_linear_element(operand, linear_names)
                    Expr.Paren(inner, paren_line):
                        return darray_linear_element(inner, linear_names)
                    _:
                        return false

        # Whether TYPE_EXPRESSION is `darray[E]` (optionally mutable-wrapped) whose element E holds
        # a linear handle: stage0's `containsAffineHandleValues(elem)` — an affine, linear or
        # `__drop__` struct, a builtin handle, an aggregate holding one, or an optional, fixed
        # array or nested container of those. A reference (`darray[Handle]&`) borrows: it owns
        # nothing to consume. A `set[E]` of one is rejected outright (check_affine_collection_type).
        def darray_holds_linear(type_expression: Ast::Expr, table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                match type_expression:
                    Expr.Index(head, argument, index_line):
                        head_name: sview = ident_name_of(head)
                        return head_name == "darray" and affine_type_contains_handles(argument, table)
                    Expr.IndexN(head, arguments, index_n_line):
                        head_name_n: sview = ident_name_of(head)
                        return head_name_n == "darray" and arguments.count > 0 and affine_type_contains_handles(arguments[0], table)
                    Expr.Unary(operator, operand, unary_line):
                        false return if operator == TokenKind.Ampersand
                        return darray_holds_linear(operand, table)
                    Expr.Paren(inner, paren_line):
                        return darray_holds_linear(inner, table)
                    _:
                        return false

        # Whether NAME is the operand of any `move` in an expression (covers `for x in move c`,
        # `f(move c)`, `x <- move c`, `return move c`).
        def darray_expr_moves_name(expression: Ast::Expr, name: sview) -> bool:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Move(operand, move_line):
                        return ident_name_of(operand) == name or darray_expr_moves_name(operand, name)
                    Expr.Call(callee, arguments, argument_names, call_line):
                        # The callee holds a chained receiver: `drain(move c).i32()`.
                        return darray_expr_moves_name(callee, name) or (any argument in arguments where darray_expr_moves_name(argument, name))
                    Expr.Field(object, field, field_line):
                        return darray_expr_moves_name(object, name)
                    Expr.Binary(left, operator, right, binary_line):
                        return darray_expr_moves_name(left, name) or darray_expr_moves_name(right, name)
                    Expr.Array(elements, array_line):
                        return any element in elements where darray_expr_moves_name(element, name)
                    Expr.Tuple(elements, tuple_line):
                        return any element in elements where darray_expr_moves_name(element, name)
                    Expr.Construct(type_expression, fields, construct_line):
                        return any field in fields where darray_expr_moves_name(field.value, name)
                    Expr.RecordUpdate(base, fields, update_line):
                        return darray_expr_moves_name(base, name) or (any field in fields where darray_expr_moves_name(field.value, name))
                    Expr.Comprehension(variable, iterable, condition, body, comprehension_line):
                        return darray_expr_moves_name(iterable, name) or darray_expr_moves_name(body, name)
                    Expr.Block(statements, value, captures, block_line):
                        return darray_name_consumed(statements, name) or darray_expr_moves_name(value, name)
                    Expr.Unary(operator, operand, unary_line):
                        return darray_expr_moves_name(operand, name)
                    Expr.Paren(inner, paren_line):
                        return darray_expr_moves_name(inner, name)
                    Expr.Refinement(filtered, filter_condition, filter_line):
                        # A filtered drain `for x in move c if p:` still drains all of `c`.
                        return darray_expr_moves_name(filtered, name) or darray_expr_moves_name(filter_condition, name)
                    Expr.Index(object, index, index_line):
                        return darray_expr_moves_name(object, name) or darray_expr_moves_name(index, name)
                    _:
                        return false

        # Whether NAME is moved or (bare/`move`) returned anywhere in the statement list — the
        # consumption avenues for a container owner.
        def darray_name_consumed(statements: darray[Ast::Stmt], name: sview) -> bool:
            can Memory.Allocate, Abort.Panic:
                return any statement in statements where darray_statement_consumes(statement, name)

        def darray_return_consumes(value: Ast::Expr?, name: sview) -> bool:
            can Memory.Allocate, Abort.Panic:
                returned: Ast::Expr = get value else return false
                # A bare `return c` does not consume: stage0 wants `return move c` (see
                # darray_bare_returns), so only a move counts.
                return darray_expr_moves_name(returned, name)

        # `return c` of a container holding handles must be `return move c`. stage0: "value
        # containing linear handles "c" must be moved explicitly before return", reported
        # with the must-consume line at the declaration.
        def darray_bare_returns(statements: darray[Ast::Stmt], name: sview, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Return(value, line):
                            if value is returned:
                                if returned is Expr.Ident(returned_name, returned_pos):
                                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AffineMoveRequired, name: returned_name, pos: returned_pos, line: returned_pos.line, expected: "Return", actual: "", detail: "container"}) if returned_name == name
                        Stmt.If(condition, then_body, else_body, line):
                            table <- darray_bare_returns(then_body, name, table)
                            table <- darray_bare_returns(else_body, name, table)
                        Stmt.While(condition, body, line):
                            table <- darray_bare_returns(body, name, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- darray_bare_returns(body, name, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- darray_bare_returns(body, name, table)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |table| -> table:
                                table <- darray_bare_returns(arm.body, name, table)
                        _:
                            pass

        def darray_statement_consumes(statement: Ast::Stmt, name: sview) -> bool:
            can Memory.Allocate, Abort.Panic:
                return match statement:
                    Stmt.Expr(expression, line): darray_expr_moves_name(expression, name)
                    Stmt.VarDecl(decl_name, type_expression, value, line): darray_expr_moves_name(value, name)
                    Stmt.Assign(target, operator, value, line): darray_expr_moves_name(value, name)
                    Stmt.Return(value, line): darray_return_consumes(value, name)
                    Stmt.If(condition, then_body, else_body, line): darray_expr_moves_name(condition, name) or darray_name_consumed(then_body, name) or darray_name_consumed(else_body, name)
                    Stmt.While(condition, body, line): darray_expr_moves_name(condition, name) or darray_name_consumed(body, name)
                    Stmt.For(bind, variables, iterable, body, line): darray_expr_moves_name(iterable, name) or darray_name_consumed(body, name)
                    Stmt.Block(kind, clause, binding, body, line): darray_name_consumed(body, name)
                    Stmt.Match(scrutinee, arms, line): darray_expr_moves_name(scrutinee, name) or (any arm in arms where darray_name_consumed(arm.body, name))
                    _: false

        # Name-based twin of darray_collect_holding_locals, used by the drain-discipline check.
        def darray_collect_linear_locals(statements: darray[Ast::Stmt], linear_names: darray[sview]&, out_names: mutable darray[sview]&, out_lines: mutable darray[u32]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |out_names, out_lines|:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            if darray_linear_element(type_expression, linear_names):
                                out_names.push(name)
                                out_lines.push(line.line)
                        Stmt.If(condition, then_body, else_body, line):
                            darray_collect_linear_locals(then_body, linear_names, out_names, out_lines)
                            darray_collect_linear_locals(else_body, linear_names, out_names, out_lines)
                        Stmt.While(condition, body, line):
                            darray_collect_linear_locals(body, linear_names, out_names, out_lines)
                        Stmt.For(bind, variables, iterable, body, line):
                            darray_collect_linear_locals(body, linear_names, out_names, out_lines)
                        Stmt.Block(kind, clause, binding, body, line):
                            darray_collect_linear_locals(body, linear_names, out_names, out_lines)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |out_names, out_lines|:
                                darray_collect_linear_locals(arm.body, linear_names, out_names, out_lines)
                        _:
                            pass

        # Collect (darray-of-linear local name, decl line) declared in a statement list.
        def darray_collect_holding_locals(statements: darray[Ast::Stmt], table: SymbolTable&, out_names: mutable darray[sview]&, out_lines: mutable darray[u32]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |out_names, out_lines|:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            if darray_holds_linear(type_expression, table):
                                out_names.push(name)
                                out_lines.push(line.line)
                        Stmt.If(condition, then_body, else_body, line):
                            darray_collect_holding_locals(then_body, table, out_names, out_lines)
                            darray_collect_holding_locals(else_body, table, out_names, out_lines)
                        Stmt.While(condition, body, line):
                            darray_collect_holding_locals(body, table, out_names, out_lines)
                        Stmt.For(bind, variables, iterable, body, line):
                            darray_collect_holding_locals(body, table, out_names, out_lines)
                        Stmt.Block(kind, clause, binding, body, line):
                            darray_collect_holding_locals(body, table, out_names, out_lines)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |out_names, out_lines|:
                                darray_collect_holding_locals(arm.body, table, out_names, out_lines)
                        _:
                            pass

        def darray_linear_consume_funcs(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            local_names: mutable darray[sview] = []
                            local_lines: mutable darray[u32] = []
                            # A by-value param owns its elements like a local; stage0 names it at
                            # the `def` line.
                            for param in params |local_names, local_lines|:
                                if darray_holds_linear(param.type_expression, table):
                                    local_names.push(param.name)
                                    local_lines.push(line.line)
                            darray_collect_holding_locals(body, table, local_names, local_lines)
                            for probe in 0..<local_names.count |table| -> table:
                                table <- darray_bare_returns(body, local_names[probe], table)
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.DarrayLinearMustConsume, name: local_names[probe], line: local_lines[probe], expected: "", actual: ""}) if not darray_name_consumed(body, local_names[probe])
                        Decl.Module(module_name, module_body, module_line):
                            table <- darray_linear_consume_funcs(module_body, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- darray_linear_consume_funcs(scoped_body, table)
                        _:
                            pass

        # The linear element type name of a `darray[E]`/`set[E]` (mutable-wrapped ok), or "".
        def darray_linear_element_name(type_expression: Ast::Expr, table: SymbolTable&) -> sview:
            can Memory.Allocate, Abort.Panic:
                match type_expression:
                    Expr.Index(head, argument, index_line):
                        head_name: sview = ident_name_of(head)
                        element: sview = ident_name_of(argument)
                        return element if (head_name == "darray" or head_name == "set") and struct_is_affine(table, element) else sview("", 0, 0)
                    Expr.IndexN(head, arguments, indexn_line):
                        head_name_n: sview = ident_name_of(head)
                        element_n: sview = ident_name_of(arguments[0]) if arguments.count > 0 else sview("", 0, 0)
                        return element_n if (head_name_n == "darray" or head_name_n == "set") and struct_is_affine(table, element_n) else sview("", 0, 0)
                    Expr.Unary(operator, operand, unary_line):
                        return darray_linear_element_name(operand, table)
                    Expr.Paren(inner, paren_line):
                        return darray_linear_element_name(inner, table)
                    _:
                        return sview("", 0, 0)

        def darray_collect_drop_locals(statements: darray[Ast::Stmt], table: SymbolTable&, out_names: mutable darray[sview]&, out_elems: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |out_names, out_elems|:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            element: sview = darray_linear_element_name(type_expression, table)
                            if element != "":
                                out_names.push(name)
                                out_elems.push(element)
                        Stmt.If(condition, then_body, else_body, line):
                            darray_collect_drop_locals(then_body, table, out_names, out_elems)
                            darray_collect_drop_locals(else_body, table, out_names, out_elems)
                        Stmt.While(condition, while_body, while_line):
                            darray_collect_drop_locals(while_body, table, out_names, out_elems)
                        Stmt.For(bind, variables, iterable, for_body, for_line):
                            darray_collect_drop_locals(for_body, table, out_names, out_elems)
                        Stmt.Block(kind, clause, binding, body, block_line):
                            darray_collect_drop_locals(body, table, out_names, out_elems)
                        Stmt.Match(scrutinee, arms, match_line):
                            for arm in arms |out_names, out_elems|:
                                darray_collect_drop_locals(arm.body, table, out_names, out_elems)
                        _:
                            pass

        # The op string for a drop-method, or "" if not a dropping method.
        def darray_drop_op_for_method(method: sview) -> sview:
            return when method:
                "clear" -> "darray clear"
                "resize" -> "darray resize"
                "truncate" -> "darray truncate"
                _ -> sview("", 0, 0)

        # The root ident of an index-assignment target `g[i]` (through paren), or "".
        def darray_index_assign_root(target: Ast::Expr) -> sview:
            can Memory.Allocate, Abort.Panic:
                return match target:
                    Expr.Index(object, index_argument, index_line): ident_name_of(object)
                    Expr.IndexN(object, arguments, indexn_line): ident_name_of(object)
                    Expr.Paren(inner, paren_line): darray_index_assign_root(inner)
                    _: sview("", 0, 0)

        # Find a dropping method call `g.clear()/resize()/truncate()` on a tracked local in
        # an expression, returning (root, op) of the first match.
        def darray_find_drop_call(expression: Ast::Expr, names: darray[sview]&) -> (found: bool, root: sview, op: sview):
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, call_line):
                        match callee:
                            Expr.Field(receiver, method, field_line):
                                match receiver:
                                    Expr.Ident(receiver_name, ident_line):
                                        op: sview = darray_drop_op_for_method(method)
                                        (true, receiver_name, op) return if op != "" and darray_linear_name_present(names, receiver_name)
                                    _:
                                        pass
                            _:
                                pass
                        return (false, sview("", 0, 0), sview("", 0, 0))
                    Expr.Paren(inner, paren_line):
                        return darray_find_drop_call(inner, names)
                    _:
                        return (false, sview("", 0, 0), sview("", 0, 0))

        def darray_elem_of(names: darray[sview]&, elems: darray[sview]&, root: sview) -> sview:
            can Abort.Panic:
                probe: mutable usize = 0
                while probe < names.count |probe|:
                    elems[probe] return if names[probe] == root
                    probe <- probe + 1
                return sview("", 0, 0)

        def darray_drop_walk(statements: darray[Ast::Stmt], names: darray[sview]&, elems: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Assign(target, operator, value, line):
                            root: sview = darray_index_assign_root(target)
                            if root != "" and darray_linear_name_present(names, root):
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.DarrayLinearDrop, name: darray_elem_of(names, elems, root), line: line.line, expected: "indexed assignment", actual: ""})
                            drop_a: (found: bool, root: sview, op: sview) = darray_find_drop_call(value, names)
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.DarrayLinearDrop, name: darray_elem_of(names, elems, drop_a.root), line: line.line, expected: drop_a.op, actual: ""}) if drop_a.found
                        Stmt.VarDecl(name, type_expression, value, line):
                            drop_v: (found: bool, root: sview, op: sview) = darray_find_drop_call(value, names)
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.DarrayLinearDrop, name: darray_elem_of(names, elems, drop_v.root), line: line.line, expected: drop_v.op, actual: ""}) if drop_v.found
                        Stmt.Expr(expression, line):
                            drop_e: (found: bool, root: sview, op: sview) = darray_find_drop_call(expression, names)
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.DarrayLinearDrop, name: darray_elem_of(names, elems, drop_e.root), line: line.line, expected: drop_e.op, actual: ""}) if drop_e.found
                        Stmt.If(condition, then_body, else_body, line):
                            table <- darray_drop_walk(then_body, names, elems, table)
                            table <- darray_drop_walk(else_body, names, elems, table)
                        Stmt.While(condition, while_body, while_line):
                            table <- darray_drop_walk(while_body, names, elems, table)
                        Stmt.For(bind, variables, iterable, for_body, for_line):
                            table <- darray_drop_walk(for_body, names, elems, table)
                        Stmt.Block(kind, clause, binding, body, block_line):
                            table <- darray_drop_walk(body, names, elems, table)
                        Stmt.Match(scrutinee, arms, match_line):
                            for arm in arms |table| -> table:
                                table <- darray_drop_walk(arm.body, names, elems, table)
                        _:
                            pass

        def darray_drop_funcs(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            drop_names: mutable darray[sview] = []
                            drop_elems: mutable darray[sview] = []
                            darray_collect_drop_locals(body, table, drop_names, drop_elems)
                            if drop_names.count > 0:
                                table <- darray_drop_walk(body, drop_names, drop_elems, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- darray_drop_funcs(module_body, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- darray_drop_funcs(scoped_body, table)
                        _:
                            pass

    public:
        def check_darray_linear_consume(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- darray_linear_consume_funcs(declarations, table)
                table <- darray_drop_funcs(declarations, table)
                row_structs: mutable darray[sview] = []
                row_fields: mutable darray[sview] = []
                row_types: mutable darray[Ast::Expr] = []
                collect_field_law_types(declarations, row_structs, row_fields, row_types)
                rows: BulkFieldRows = BulkFieldRows{structs: row_structs, fields: row_fields, types: row_types}
                table <- bulk_copy_funcs(declarations, rows, table) can Global{Read,Write}
