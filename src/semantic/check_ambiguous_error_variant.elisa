# Ambiguous bare error-variant reference. An `error[X]` set-position name that is not a
# declared error set but is a VARIANT appearing in two or more error sets is ambiguous:
#
#   error LexError: Shared
#   error ParseError: Shared
#   def f() -> i64 error[Shared]: ...   # Shared is in both -> ambiguous
#
# `error NAME:` declarations lower to enums, so their variants populate enum_variant_owner/
# name. Each `error[...]` set name is captured by the parser as __error_set_family. A name
# that is itself a declared set (an enum owner) is a family reference and fine; a bare
# variant in >= 2 sets must be qualified.
extend Semantic:
    private:
        def aev_is_set_name(table: SymbolTable&, name: sview) -> bool:
            can Abort.Panic:
                for owner in table.enum_variant_owner:
                    true return if owner == name
                return false

        # Distinct error-set owners declaring a variant `name`, as (count, first, second).
        def aev_owners_of_variant(table: SymbolTable&, variant: sview) -> (count: usize, first: sview, second: sview):
            can Memory.Allocate, Abort.Panic:
                seen: mutable darray[sview] = []
                index: mutable usize = 0
                while index < table.enum_variant_name.count |index, seen|:
                    if table.enum_variant_name[index] == variant:
                        owner: sview = table.enum_variant_owner[index]
                        seen.push(owner) if not (any entry in seen where entry == owner)
                    index <- index + 1
                first: sview = seen[0] if seen.count > 0 else sview("", 0, 0)
                second: sview = seen[1] if seen.count > 1 else sview("", 0, 0)
                return (seen.count, first, second)

    public:
        def check_ambiguous_error_variant(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                reported: mutable darray[sview] = []
                for annotation in file.enum_annotations |reported, table| -> table:
                    if annotation.owner == "__error_set_family":
                        referenced: sview = annotation.name
                        already: bool = any entry in reported where entry == referenced
                        if not already and not aev_is_set_name(table, referenced):
                            owners: (count: usize, first: sview, second: sview) = aev_owners_of_variant(table, referenced)
                            if owners.count >= 2:
                                reported.push(referenced)
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AmbiguousErrorVariant, name: referenced, line: annotation.line, expected: owners.first, actual: owners.second})
