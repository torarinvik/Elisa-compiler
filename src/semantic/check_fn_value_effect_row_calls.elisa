extend Semantic:
    private:
        def fver_external_expr_calls(file: Ast::File&, expression: Ast::Expr, locals: darray[sview]&, current_module: sview, target: sview @source, context: GlobalAuthority&, annotations: darray[Ast::EnumAnnotation]&, firewalls: darray[sview]&, table: lmut SymbolTable) -> usize:
            can Memory.Allocate, Abort.Panic:
                resolved: mutable usize = 0
                match expression:
                    Expr.Call(callee, arguments, _, call_pos):
                        rebind external_call_found: bool, table = fver_external_call_effects(file, callee, call_pos, current_module, locals, target, context, annotations, firewalls, table)
                        resolved <- 1.usize() if external_call_found
                        match callee:
                            Expr.Lambda(parameters, body, _):
                                lambda_locals: mutable darray[sview] = []
                                gp_call_locals_copy(locals, lambda_locals)
                                lambda_locals.extend(parameters)
                                rebind lambda_count: usize, table = fver_external_body_calls(file, body, lambda_locals, current_module, target, context, annotations, firewalls, table)
                                resolved <- resolved + lambda_count
                            _:
                                rebind callee_count: usize, table = fver_external_expr_calls(file, callee, locals, current_module, target, context, annotations, firewalls, table)
                                resolved <- resolved + callee_count
                        for argument in arguments |resolved, locals, table|:
                            rebind argument_count: usize, table = fver_external_callback_argument_calls(file, argument, locals, current_module, target, context, annotations, firewalls, table)
                            resolved <- resolved + argument_count
                    Expr.StaticEffectCall(candidates: candidates, arguments: arguments, _):
                        for candidate in candidates |resolved, locals, table|:
                            for capture in candidate.captures |resolved, locals, table|:
                                rebind capture_count: usize, table = fver_external_expr_calls(file, capture, locals, current_module, target, context, annotations, firewalls, table)
                                resolved <- resolved + capture_count
                        for argument in arguments |resolved, locals, table|:
                            rebind argument_count: usize, table = fver_external_callback_argument_calls(file, argument, locals, current_module, target, context, annotations, firewalls, table)
                            resolved <- resolved + argument_count
                    Expr.Field(object, _, _) | Expr.Scope(object, _, _) | Expr.Paren(object, _) | Expr.Unary(_, object, _) | Expr.Move(object, _) | Expr.RegionNew(object, _, _):
                        rebind child_count: usize, table = fver_external_expr_calls(file, object, locals, current_module, target, context, annotations, firewalls, table)
                        resolved <- resolved + child_count
                    Expr.Binary(left, _, right, _) | Expr.Index(left, right, _):
                        rebind left_count: usize, table = fver_external_expr_calls(file, left, locals, current_module, target, context, annotations, firewalls, table)
                        resolved <- resolved + left_count
                        rebind right_count: usize, table = fver_external_expr_calls(file, right, locals, current_module, target, context, annotations, firewalls, table)
                        resolved <- resolved + right_count
                    Expr.Refinement(base, predicate, _):
                        rebind base_count: usize, table = fver_external_expr_calls(file, base, locals, current_module, target, context, annotations, firewalls, table)
                        resolved <- resolved + base_count
                        predicate_locals: mutable darray[sview] = []
                        gp_call_locals_copy(locals, predicate_locals)
                        rebind predicate_count: usize, table = fver_external_condition_calls(file, predicate, predicate_locals, current_module, target, context, annotations, firewalls, table)
                        resolved <- resolved + predicate_count
                    Expr.Slice(object, low, high, _):
                        rebind object_count: usize, table = fver_external_expr_calls(file, object, locals, current_module, target, context, annotations, firewalls, table)
                        resolved <- resolved + object_count
                        rebind low_count: usize, table = fver_external_expr_calls(file, low, locals, current_module, target, context, annotations, firewalls, table)
                        resolved <- resolved + low_count
                        rebind high_count: usize, table = fver_external_expr_calls(file, high, locals, current_module, target, context, annotations, firewalls, table)
                        resolved <- resolved + high_count
                    Expr.IndexN(object, arguments, _):
                        rebind object_count: usize, table = fver_external_expr_calls(file, object, locals, current_module, target, context, annotations, firewalls, table)
                        resolved <- resolved + object_count
                        for argument in arguments |resolved, locals, table|:
                            rebind argument_count: usize, table = fver_external_expr_calls(file, argument, locals, current_module, target, context, annotations, firewalls, table)
                            resolved <- resolved + argument_count
                    Expr.Array(elements, _) | Expr.Tuple(elements, _) | Expr.SetLit(elements, _):
                        for element in elements |resolved, locals, table|:
                            rebind element_count: usize, table = fver_external_expr_calls(file, element, locals, current_module, target, context, annotations, firewalls, table)
                            resolved <- resolved + element_count
                    Expr.DictLit(entries, _):
                        for entry in entries |resolved, locals, table|:
                            rebind key_count: usize, table = fver_external_expr_calls(file, entry.key, locals, current_module, target, context, annotations, firewalls, table)
                            resolved <- resolved + key_count
                            rebind value_count: usize, table = fver_external_expr_calls(file, entry.value, locals, current_module, target, context, annotations, firewalls, table)
                            resolved <- resolved + value_count
                    Expr.Construct(_, fields, _) | Expr.RecordUpdate(_, fields, _):
                        match expression:
                            Expr.RecordUpdate(base, _, _):
                                rebind base_count: usize, table = fver_external_expr_calls(file, base, locals, current_module, target, context, annotations, firewalls, table)
                                resolved <- resolved + base_count
                            _:
                                pass
                        for field in fields |resolved, locals, table|:
                            rebind field_count: usize, table = fver_external_expr_calls(file, field.value, locals, current_module, target, context, annotations, firewalls, table)
                            resolved <- resolved + field_count
                    Expr.If(condition, yes, no, _):
                        branch_locals: mutable darray[sview] = []
                        gp_call_locals_copy(locals, branch_locals)
                        rebind condition_count: usize, table = fver_external_condition_calls(file, condition, branch_locals, current_module, target, context, annotations, firewalls, table)
                        resolved <- resolved + condition_count
                        gp_condition_bindings(condition, branch_locals)
                        rebind yes_count: usize, table = fver_external_expr_calls(file, yes, branch_locals, current_module, target, context, annotations, firewalls, table)
                        resolved <- resolved + yes_count
                        else_locals: mutable darray[sview] = []
                        gp_call_locals_copy(locals, else_locals)
                        rebind no_count: usize, table = fver_external_expr_calls(file, no, else_locals, current_module, target, context, annotations, firewalls, table)
                        resolved <- resolved + no_count
                    Expr.Match(scrutinee, arms, _) | Expr.Catch(scrutinee, arms, _):
                        rebind scrutinee_count: usize, table = fver_external_expr_calls(file, scrutinee, locals, current_module, target, context, annotations, firewalls, table)
                        resolved <- resolved + scrutinee_count
                        for arm in arms |resolved, locals, table|:
                            arm_locals: mutable darray[sview] = []
                            gp_call_locals_copy(locals, arm_locals)
                            arm_names: mutable darray[sview] = []
                            collect_pattern_binding_names(arm.pattern, arm_names)
                            arm_locals.extend(arm_names)
                            rebind guard_count: usize, table = fver_external_condition_calls(file, arm.guard, arm_locals, current_module, target, context, annotations, firewalls, table)
                            resolved <- resolved + guard_count
                            gp_condition_bindings(arm.guard, arm_locals)
                            rebind arm_count: usize, table = fver_external_body_calls(file, arm.body, arm_locals, current_module, target, context, annotations, firewalls, table)
                            resolved <- resolved + arm_count
                    Expr.GetElse(guarded, recovery, _):
                        rebind guarded_count: usize, table = fver_external_expr_calls(file, guarded, locals, current_module, target, context, annotations, firewalls, table)
                        resolved <- resolved + guarded_count
                        recovery_locals: mutable darray[sview] = []
                        gp_call_locals_copy(locals, recovery_locals)
                        rebind recovery_count: usize, table = fver_external_body_calls(file, recovery, recovery_locals, current_module, target, context, annotations, firewalls, table)
                        resolved <- resolved + recovery_count
                    Expr.Comprehension(variable, iterable, condition, body, _, query_scope_id):
                        rebind iterable_count: usize, table = fver_external_expr_calls(file, iterable, locals, current_module, target, context, annotations, firewalls, table)
                        resolved <- resolved + iterable_count
                        query_locals: mutable darray[sview] = []
                        gp_call_locals_copy(locals, query_locals)
                        query_locals.push(variable)
                        gp_query_binders_add(query_scope_id, table, query_locals)
                        rebind condition_count: usize, table = fver_external_filter_calls(file, condition, query_locals, current_module, target, context, annotations, firewalls, table)
                        resolved <- resolved + condition_count
                        rebind body_count: usize, table = fver_external_expr_calls(file, body, query_locals, current_module, target, context, annotations, firewalls, table)
                        resolved <- resolved + body_count
                    Expr.Block(statements, value, _, _):
                        block_locals: mutable darray[sview] = []
                        gp_call_locals_copy(locals, block_locals)
                        rebind statements_count: usize, table = fver_external_body_calls(file, statements, block_locals, current_module, target, context, annotations, firewalls, table)
                        resolved <- resolved + statements_count
                        rebind value_count: usize, table = fver_external_expr_calls(file, value, block_locals, current_module, target, context, annotations, firewalls, table)
                        resolved <- resolved + value_count
                    Expr.Lambda(_, _, _) | Expr.IntLit(_, _) | Expr.FloatLit(_, _) | Expr.StringLit(_, _) | Expr.CharLit(_, _) | Expr.BoolLit(_, _) | Expr.Ident(_, _) | Expr.ShorthandMember(_, _) | Expr.Absent | Expr.Invalid:
                        pass
                    _:
                        pass
                return resolved

        # Count only the calls represented in this statement's current GP edge list.
        # Nested statement bodies are walked separately by fver_body_rows; match guards
        # are the exception because that pass adds them to the scrutinee's edge list.
        def fver_external_statement_calls(file: Ast::File&, statement: Ast::Stmt, locals: mutable darray[sview]&, current_module: sview, target: sview @source, context: GlobalAuthority&, annotations: darray[Ast::EnumAnnotation]&, firewalls: darray[sview]&, table: lmut SymbolTable) -> usize:
            can Memory.Allocate, Abort.Panic:
                resolved: mutable usize = 0
                match statement:
                    Stmt.If(condition, _, _, _ ) | Stmt.While(condition, _, _):
                        rebind condition_count: usize, table = fver_external_condition_calls(file, condition, locals, current_module, target, context, annotations, firewalls, table)
                        resolved <- condition_count
                    Stmt.For(_, variables, iterable, _, _):
                        rebind iterable_count: usize, table = fver_external_for_calls(file, iterable, variables, locals, current_module, target, context, annotations, firewalls, table)
                        resolved <- iterable_count
                    Stmt.Match(scrutinee, arms, _):
                        rebind scrutinee_count: usize, table = fver_external_expr_calls(file, scrutinee, locals, current_module, target, context, annotations, firewalls, table)
                        resolved <- scrutinee_count
                        for arm in arms |resolved, locals, table|:
                            arm_locals: mutable darray[sview] = []
                            gp_call_locals_copy(locals, arm_locals)
                            arm_names: mutable darray[sview] = []
                            collect_pattern_binding_names(arm.pattern, arm_names)
                            arm_locals.extend(arm_names)
                            rebind guard_count: usize, table = fver_external_condition_calls(file, arm.guard, arm_locals, current_module, target, context, annotations, firewalls, table)
                            resolved <- resolved + guard_count
                    Stmt.Block(_, _, _, _, _):
                        pass
                    _:
                        single: darray[Ast::Stmt] = [statement]
                        rebind body_count: usize, table = fver_external_body_calls(file, single, locals, current_module, target, context, annotations, firewalls, table)
                        resolved <- body_count
                return resolved

        # TARGET's rows from one BODY: Global when it reads or writes a global, and every
        # unique direct callee's row. (The declared `can[...]` and the `can` block clauses
        # are recorded by the caller, which holds them rooted at the AST.)
        def fver_body_rows(file: Ast::File&, body: darray[Ast::Stmt], locals: darray[sview]&, target: sview @source, declarations: darray[Ast::Decl]&, globals: darray[sview]&, annotations: darray[Ast::EnumAnnotation]&, inline_index: InlineEffectIndex&, firewalls: darray[sview]&, table: lmut SymbolTable, module_scope: usize, context: mutable GlobalAuthority&) -> void:
            can Memory.Allocate, Abort.Panic:
                context.module_scope <- module_scope
                caller_slot: usize = ga_resolve_function(target, module_scope, false, context)
                rebind current_module: sview @source, table = fver_module_scope_path(module_scope, context, table)
                read_locals: mutable darray[sview] = []
                read_locals.extend(locals)
                write_locals: mutable darray[sview] = []
                write_locals.extend(locals)
                call_locals: mutable darray[sview] = []
                call_locals.extend(locals)
                for statement in body |table, read_locals, write_locals, call_locals, context| -> table:
                    callees: mutable darray[usize] = []
                    call_edges_from: mutable darray[usize] = []
                    statement_locals: mutable darray[sview] = []
                    gp_call_locals_copy(call_locals, statement_locals)
                    rebind resolved_extern_call_count: usize, table = fver_external_statement_calls(file, statement, statement_locals, current_module, target, context, annotations, firewalls, table)
                    resolved_extern_calls: mutable usize = resolved_extern_call_count
                    direct: mutable darray[Ast::Stmt] = []
                    match statement:
                        Stmt.Block(_, _, _, _, _):
                            pass
                        Stmt.If(condition, _, _, at) | Stmt.While(condition, _, at):
                            direct.push(Stmt.Expr(condition, at))
                        Stmt.For(bind, variables, iterable, _, at):
                            # Keep the iterable/filter in a synthetic empty-body loop so
                            # their binding scopes match GP without rescanning the body.
                            direct.push(Stmt.For(bind, variables, iterable, [], at))
                        Stmt.Match(value, arms, at):
                            direct.push(Stmt.Expr(value, at))
                        _:
                            direct.push(statement)
                    if globals.count > 0:
                        table <- fver_add_memo(target, "Global.Read", table) if gp_body_reads(direct, context, read_locals, table) and not fver_trusted_covers_unsafe(annotations, firewalls, "Global.Read")
                        table <- fver_add_memo(target, "Global.Write", table) if gp_body_writes(direct, context, write_locals, table) and not fver_trusted_covers_unsafe(annotations, firewalls, "Global.Write")
                    match statement:
                        Stmt.Block(kind, clause, binding, nested_body, _):
                            nested_firewalls: mutable darray[sview] = []
                            nested_firewalls.extend(firewalls)
                            nested_firewalls.extend(clause) if kind == "trusted"
                            block_locals: mutable darray[sview] = []
                            gp_call_locals_copy(call_locals, block_locals)
                            block_locals.push(binding) if binding != ""
                            table <- fver_body_rows(file, nested_body, block_locals, target, declarations, globals, annotations, inline_index, nested_firewalls, table, module_scope, context)
                        Stmt.If(condition, then_body, else_body, _):
                            then_locals: mutable darray[sview] = []
                            gp_call_locals_copy(call_locals, then_locals)
                            gp_condition_calls(condition, caller_slot, context, then_locals, call_edges_from, callees, table)
                            else_locals: mutable darray[sview] = []
                            gp_call_locals_copy(call_locals, else_locals)
                            table <- fver_body_rows(file, then_body, then_locals, target, declarations, globals, annotations, inline_index, firewalls, table, module_scope, context)
                            table <- fver_body_rows(file, else_body, else_locals, target, declarations, globals, annotations, inline_index, firewalls, table, module_scope, context)
                        Stmt.While(condition, nested_body, _):
                            while_locals: mutable darray[sview] = []
                            gp_call_locals_copy(call_locals, while_locals)
                            gp_condition_calls(condition, caller_slot, context, while_locals, call_edges_from, callees, table)
                            table <- fver_body_rows(file, nested_body, while_locals, target, declarations, globals, annotations, inline_index, firewalls, table, module_scope, context)
                        Stmt.For(_, variables, iterable, nested_body, _):
                            base_expression: mutable Ast::Expr = iterable
                            filter_expression: mutable Ast::Expr? = null
                            filter_guard: mutable Ast::Expr? = null
                            match iterable:
                                Expr.Refinement(filter_base, filter_predicate, _):
                                    match filter_base:
                                        Expr.Refinement(inner_base, inner_predicate, _):
                                            base_expression <- inner_base
                                            filter_expression <- inner_predicate
                                            filter_guard <- filter_predicate
                                        _:
                                            base_expression <- filter_base
                                            filter_expression <- filter_predicate
                                _:
                                    pass
                            iterable_call_locals: mutable darray[sview] = []
                            gp_call_locals_copy(call_locals, iterable_call_locals)
                            gp_expression_calls(base_expression, caller_slot, context, iterable_call_locals, call_edges_from, callees, table)
                            loop_locals: mutable darray[sview] = []
                            gp_call_locals_copy(call_locals, loop_locals)
                            loop_locals.extend(variables)
                            gp_filter_calls(filter_value, caller_slot, context, loop_locals, call_edges_from, callees, table) if filter_expression is filter_value
                            if filter_guard is guard_value:
                                guard_locals: mutable darray[sview] = []
                                guard_locals.extend(loop_locals)
                                gp_condition_calls(guard_value, caller_slot, context, guard_locals, call_edges_from, callees, table)
                            table <- fver_body_rows(file, nested_body, loop_locals, target, declarations, globals, annotations, inline_index, firewalls, table, module_scope, context)
                        Stmt.Match(scrutinee, arms, _):
                            scrutinee_call_locals: mutable darray[sview] = []
                            gp_call_locals_copy(call_locals, scrutinee_call_locals)
                            gp_expression_calls(scrutinee, caller_slot, context, scrutinee_call_locals, call_edges_from, callees, table)
                            for arm in arms |table, callees, call_edges_from, context| -> table:
                                arm_locals: mutable darray[sview] = []
                                gp_call_locals_copy(call_locals, arm_locals)
                                arm_names: mutable darray[sview] = []
                                collect_pattern_binding_names(arm.pattern, arm_names)
                                arm_locals.extend(arm_names)
                                if globals.count > 0:
                                    guard_read_locals: mutable darray[sview] = []
                                    guard_read_locals.extend(arm_locals)
                                    guard_write_locals: mutable darray[sview] = []
                                    guard_write_locals.extend(arm_locals)
                                    table <- fver_add_memo(target, "Global.Read", table) if gp_condition_reads(arm.guard, context, guard_read_locals, table) and not fver_trusted_covers_unsafe(annotations, firewalls, "Global.Read")
                                    table <- fver_add_memo(target, "Global.Write", table) if gp_condition_writes(arm.guard, context, guard_write_locals, table) and not fver_trusted_covers_unsafe(annotations, firewalls, "Global.Write")
                                guard_callees: mutable darray[usize] = []
                                guard_call_locals: mutable darray[sview] = []
                                guard_call_locals.extend(arm_locals)
                                gp_condition_calls(arm.guard, caller_slot, context, guard_call_locals, call_edges_from, guard_callees, table)
                                for callee_slot in guard_callees:
                                    callees.push(callee_slot)
                                body_locals: mutable darray[sview] = []
                                body_locals.extend(arm_locals)
                                gp_condition_bindings(arm.guard, body_locals)
                                table <- fver_body_rows(file, arm.body, body_locals, target, declarations, globals, annotations, inline_index, firewalls, table, module_scope, context)
                        _:
                            single_statement: darray[Ast::Stmt] = [statement]
                            gp_body_calls(single_statement, caller_slot, context, call_locals, call_edges_from, callees, table)
                    for callee_slot in callees |table, context, resolved_extern_calls| -> table:
                        if callee_slot < context.functions.count:
                            start: usize = table.effect_canonical_function_row_start[callee_slot]
                            end: usize = start + table.effect_canonical_function_row_count[callee_slot]
                            for row in start..<end |table| -> table:
                                effect: sview = table.effect_canonical_refs[table.effect_canonical_row_ref[row]]
                                table <- fver_add_memo(target, effect, table) if not fver_trusted_covers_unsafe(annotations, firewalls, effect)
                        elif callee_slot == GLOBAL_AUTHORITY_NONE:
                            if resolved_extern_calls > 0:
                                resolved_extern_calls <- resolved_extern_calls - 1
                            else:
                                for candidate in 0..<context.functions.count |table| -> table:
                                    start: usize = table.effect_canonical_function_row_start[candidate]
                                    end: usize = start + table.effect_canonical_function_row_count[candidate]
                                    for row in start..<end |table| -> table:
                                        effect: sview = table.effect_canonical_refs[table.effect_canonical_row_ref[row]]
                                        table <- fver_add_memo(target, effect, table) if not fver_trusted_covers_unsafe(annotations, firewalls, effect)

        # Complete the rows of the function NAME (a free function or callable extern
        # declared exactly once) and merge them into TARGET's. An ambiguous or unknown name
        # contributes nothing. A function is marked done BEFORE its body is read, so a
        # recursive call graph terminates (a cycle member sees the partial row — never a
        # wider one than stage0's).
        def fver_function_rows(file: Ast::File&, name: sview, target: sview @source, declarations: darray[Ast::Decl]&, globals: darray[sview]&, annotations: darray[Ast::EnumAnnotation]&, inline_index: InlineEffectIndex&, table: lmut SymbolTable, module_scope: usize, context: mutable GlobalAuthority&) -> void:
            can Memory.Allocate, Abort.Panic:
                return if name == ""
                finished: bool = any done in table.fn_value_effect_done where done == name
                if not finished:
                    return if fver_function_count(table, name) != 1
                    table <- fver_declared_rows(file, name, declarations, globals, annotations, inline_index, table, module_scope, context)
                return if target == "" or target == name
                # The memo grows while it is read (TARGET's rows), so the scan is bounded by
                # the count at entry.
                limit: usize = table.fn_value_effect_owner.count
                while row < limit |row: usize = 0, table| -> table:
                    if table.fn_value_effect_owner[row] == name:
                        merged_ref: sview = table.fn_value_effect_ref[row]
                        table <- fver_add_memo(target, merged_ref, table)
                    row <- row + 1

        # NAME's own rows from its declaration (the memo stores the DECLARATION's name).
        def fver_declared_rows(file: Ast::File&, name: sview, declarations: darray[Ast::Decl]&, globals: darray[sview]&, annotations: darray[Ast::EnumAnnotation]&, inline_index: InlineEffectIndex&, table: lmut SymbolTable, module_scope: usize, context: mutable GlobalAuthority&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table, context| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            if function_name == name:
                                canonical_slot: usize = canonical_effect_function(function_name, module_scope, line.offset, table)
                                if canonical_slot < table.effect_canonical_function_name.count:
                                    table.fn_value_effect_done <- table.fn_value_effect_done.push(function_name)
                                    start: usize = table.effect_canonical_function_row_start[canonical_slot]
                                    end: usize = start + table.effect_canonical_function_row_count[canonical_slot]
                                    for row in start..<end |table| -> table:
                                        effect_ref: sview = table.effect_canonical_refs[table.effect_canonical_row_ref[row]]
                                        table <- fver_add_memo(function_name, effect_ref, table)
                                    continue
                                firewalls: darray[sview] = []
                                table.fn_value_effect_done <- table.fn_value_effect_done.push(function_name)
                                while index < effects.count |index: usize = 0, table| -> table:
                                    table <- fver_add_memo(function_name, effects[index], table)
                                    index <- index + 1
                                table <- fver_block_grants(&body, function_name, annotations, inline_index, firewalls, table)
                                locals: mutable darray[sview] = []
                                for parameter in parameters |locals|:
                                    locals.push(parameter.name)
                                table <- fver_body_rows(file, body, locals, function_name, declarations, globals, annotations, inline_index, firewalls, table, module_scope, context)
                        Decl.Extern(extern_name, param_start, arity, variadic, callable, return_type_name, decorators, line):
                            if extern_name == name:
                                table.fn_value_effect_done <- table.fn_value_effect_done.push(extern_name)
                                # An extern's `can[...]` lives in the table's declared-effect rows
                                # (collect_extern_effects); "Permission" is its unknown placeholder.
                                while row < table.function_effect_owner.count |row: usize = 0, table| -> table:
                                    if table.function_effect_owner[row] == extern_name:
                                        extern_ref: sview = table.function_effect_name[row]
                                        table <- fver_add_memo(extern_name, extern_ref, table) if extern_ref != "Permission"
                                    row <- row + 1
                        Decl.Module(module_name, module_body, module_line):
                            table <- fver_declared_rows(file, name, module_body, globals, annotations, inline_index, table, canonical_effect_module(module_scope, module_name, table), context)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- fver_declared_rows(file, name, scoped_body, globals, annotations, inline_index, table, module_scope, context)
                        _:
                            pass

        # ---- fn TYPES ------------------------------------------------------------------

        # The `Expr.Lambda` a type position denotes, through `mutable` and parentheses.
        def fver_type_lambda(type_expression: Ast::Expr) -> Ast::Expr?:
            can Abort.Panic:
                match type_expression:
                    Expr.Lambda(params, body, pos):
                        return type_expression
                    Expr.Unary(operator, operand, pos):
                        if operator == TokenKind.Mutable:
                            return fver_type_lambda(operand)
                        return null
                    Expr.Paren(inner, pos):
                        return fver_type_lambda(inner)
                    _:
                        return null

        # The declared row of a fn TYPE: the `__fn_type_effect` rows the parser recorded at
        # the lambda token's offset.
        def fver_fn_type_families(lambda_pos: Ast::Pos, annotations: darray[Ast::EnumAnnotation]&, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                while index < annotations.count |index: usize = 0, out|:
                    fver_add_family(out, annotations[index].name) if annotations[index].owner == "__fn_type_effect" and annotations[index].offset == lambda_pos.offset and annotations[index].line == lambda_pos.line
                    index <- index + 1

        def fver_push_expected_row(families: darray[sview]&, out: mutable darray[u8]&) -> void:
            can Memory.Allocate, Abort.Panic:
                return if families.count == 0
                push_str(out, " can[")
                for index in 0..<families.count |out|:
                    push_str(out, ", ") if index > 0
                    push_sview(out, effect_ref_family(families[index]))
                push_str(out, "]")

        def fver_push_actual_row(rows: darray[usize]&, table: SymbolTable&, out: mutable darray[u8]&) -> void:
            can Memory.Allocate, Abort.Panic:
                return if rows.count == 0
                push_str(out, " can[")
                for index in 0..<rows.count |out|:
                    push_str(out, ", ") if index > 0
                    push_sview(out, effect_ref_family(table.fn_value_effect_ref[rows[index]]))
                push_str(out, "]")

        # Spell a fn TYPE node as stage0 does (`fn(i64, u8&) -> void`), from the parser's
        # token-keyed side tables; the bare parameter heads stand in when type expressions
        # are unavailable for that exact token. False when a parameter type cannot be rendered.
        def fver_render_fn_type(lambda_params: darray[sview]&, lambda_pos: Ast::Pos, file: Ast::File&, out: mutable darray[u8]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                rows: mutable darray[usize] = []
                while row < file.fn_type_param_lines.count |row: usize = 0, rows|:
                    rows.push(row) if file.fn_type_param_lines[row] == lambda_pos.line and file.fn_type_param_offsets[row] == lambda_pos.offset
                    row <- row + 1
                push_str(out, "fn(")
                for index in 0..<lambda_params.count |out|:
                    push_str(out, ", ") if index > 0
                    if rows.count == lambda_params.count:
                        return false if not affine_type_render(file.fn_type_param_exprs[rows[index]], out)
                    else:
                        push_sview(out, lambda_params[index])
                push_str(out, ") -> ")
                return_rows: mutable usize = 0
                return_row: mutable usize = 0
                while row2 < file.fn_type_return_lines.count |row2: usize = 0, return_rows, return_row|:
                    if file.fn_type_return_lines[row2] == lambda_pos.line and file.fn_type_return_offsets[row2] == lambda_pos.offset:
                        return_rows <- return_rows + 1
                        return_row <- row2
                    row2 <- row2 + 1
                if return_rows == 1:
                    return false if not affine_type_render(file.fn_type_return_exprs[return_row], out)
                else:
                    head: mutable sview = ""
                    while index2 < file.enum_annotations.count |index2: usize = 0, head|:
                        head <- file.enum_annotations[index2].name if head == "" and file.enum_annotations[index2].owner == "__lambda_return" and file.enum_annotations[index2].line == lambda_pos.line and file.enum_annotations[index2].offset == lambda_pos.offset
                        index2 <- index2 + 1
                    push_sview(out, head) if head != ""
                    push_str(out, "void") if head == ""
                return true
