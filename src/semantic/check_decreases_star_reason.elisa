# `decreases *` (unbounded-termination escape hatch) must carry a non-empty reason string
# documenting why the loop/recursion cannot be given a decreasing measure. `decreases *` with no
# reason (or an empty string) is rejected. Pure syntactic: a `Stmt.Contract` of kind "decreases*"
# whose payload expression is an empty string literal.
extend Semantic:
    private:
        def decreases_star_statements(statements: darray[Ast::Stmt], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Contract(kind, expression, contract_line):
                            empty_reason: bool = match expression:
                                Expr.StringLit(text): text == ""
                                _: true
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.DecreasesStarReason, name: "", line: contract_line, expected: "", actual: ""}) if kind == "decreases*" and empty_reason
                        Stmt.If(condition, then_body, else_body, line):
                            table <- decreases_star_statements(then_body, table)
                            table <- decreases_star_statements(else_body, table)
                        Stmt.While(condition, while_body, line):
                            table <- decreases_star_statements(while_body, table)
                        Stmt.For(bind, variables, iterable, for_body, line):
                            table <- decreases_star_statements(for_body, table)
                        Stmt.Block(kind, clause, binding, block_body, block_line):
                            table <- decreases_star_statements(block_body, table)
                        _:
                            pass

        def check_decreases_star_reason(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            table <- decreases_star_statements(body, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- check_decreases_star_reason(module_body, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- check_decreases_star_reason(scoped_body, table)
                        _:
                            pass
