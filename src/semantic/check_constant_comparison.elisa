extend Semantic:
    private:
        # Walk all statements in a function body, checking for constant comparison expressions.
        def walk_constant_comparison_statements(statements: darray[Ast::Stmt], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table|:
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- walk_constant_comparison_expression(expression, table)
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- walk_constant_comparison_expression(value, table)
                        Stmt.Assign(target, operator, value, line):
                            table <- walk_constant_comparison_expression(target, table)
                            table <- walk_constant_comparison_expression(value, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- walk_constant_comparison_expression(condition, table)
                            table <- walk_constant_comparison_statements(then_body, table)
                            table <- walk_constant_comparison_statements(else_body, table)
                        Stmt.While(condition, body, line):
                            table <- walk_constant_comparison_expression(condition, table)
                            table <- walk_constant_comparison_statements(body, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- walk_constant_comparison_expression(iterable, table)
                            table <- walk_constant_comparison_statements(body, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            # `static:` blocks hold compile-time constant comparisons by design;
                            # suppress the constant-comparison lint inside them (stage0 parity).
                            table <- walk_constant_comparison_statements(body, table) if kind != "static"
                        Stmt.Match(scrutinee, arms, line):
                            table <- walk_constant_comparison_expression(scrutinee, table)
                            for arm in arms |table|:
                                table <- walk_constant_comparison_expression(arm.guard, table)
                                table <- walk_constant_comparison_statements(arm.body, table)
                        Stmt.Return(value, line):
                            if value is return_value:
                                table <- walk_constant_comparison_expression(return_value, table)
                        Stmt.Contract(kind, expression, line):
                            # Contract/assert conditions (`assert 5 > 3`, `requires ...`) are
                            # deliberate assertions — a constant one is legitimate (esp.
                            # `static assert`), so stage0 does not lint them. Do not walk.
                            pass
                        Stmt.Invalid:
                            pass
                        Stmt.Break(label, line):
                            pass
                        Stmt.Continue(label, line):
                            pass


        # Walk all expressions, checking for constant comparison binary expressions.
        def walk_constant_comparison_expression(expression: Ast::Expr, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Invalid:
                        pass
                    Expr.Absent:
                        pass
                        pass
                    Expr.IntLit(value):
                        pass
                    Expr.FloatLit(text):
                        pass
                    Expr.StringLit(text):
                        pass
                    Expr.CharLit(text):
                        pass
                    Expr.BoolLit(value):
                        pass
                    Expr.Ident(name, line):
                        pass
                    Expr.Call(callee, arguments, argument_names, line):
                        table <- walk_constant_comparison_expression(callee, table)
                        for argument in arguments |table|:
                            table <- walk_constant_comparison_expression(argument, table)
                    Expr.Field(object, field, line):
                        table <- walk_constant_comparison_expression(object, table)
                    Expr.Scope(base, name, line):
                        table <- walk_constant_comparison_expression(base, table)
                    Expr.ShorthandMember(parts, line):
                        pass
                    Expr.Index(object, index, line):
                        table <- walk_constant_comparison_expression(object, table)
                        table <- walk_constant_comparison_expression(index, table)
                    Expr.Slice(object, low, high, line):
                        table <- walk_constant_comparison_expression(object, table)
                        table <- walk_constant_comparison_expression(low, table)
                        table <- walk_constant_comparison_expression(high, table)
                    Expr.IndexN(object, arguments, line):
                        table <- walk_constant_comparison_expression(object, table)
                        for argument in arguments |table|:
                            table <- walk_constant_comparison_expression(argument, table)
                    Expr.Binary(left, operator, right, line):
                        # Check for constant comparison: both left and right are IntLit,
                        # and operator is a comparison operator (==, !=, <, >, <=, >=).
                        is_comparison_op: bool = operator == TokenKind.EqEq or operator == TokenKind.BangEq or operator == TokenKind.Lt or operator == TokenKind.Gt or operator == TokenKind.LtEq or operator == TokenKind.GtEq
                        if left is Expr.IntLit(left_value):
                            if right is Expr.IntLit(right_value):
                                # Compute the actual result based on the operator
                                result: bool = when operator:
                                    TokenKind.EqEq -> left_value == right_value
                                    TokenKind.BangEq -> left_value != right_value
                                    TokenKind.Lt -> left_value < right_value
                                    TokenKind.Gt -> left_value > right_value
                                    TokenKind.LtEq -> left_value <= right_value
                                    _ -> left_value >= right_value
                                result_text: sview = "true" if result else "false"
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ConstantComparison, name: "", line: line, expected: "", actual: result_text}) if is_comparison_op
                        table <- walk_constant_comparison_expression(left, table)
                        table <- walk_constant_comparison_expression(right, table)
                    Expr.Refinement(base, predicate, line):
                        table <- walk_constant_comparison_expression(base, table)
                        table <- walk_constant_comparison_expression(predicate, table)
                    # `get EXPR else return …` — walk the GUARDED expression; the recovery is a
                    # statement list, which this expression walker does not descend into.
                    Expr.GetElse(guarded, recovery, line):
                        table <- walk_constant_comparison_expression(guarded, table)
                    Expr.Unary(operator, operand, line):
                        table <- walk_constant_comparison_expression(operand, table)
                    Expr.Move(operand, line):
                        table <- walk_constant_comparison_expression(operand, table)
                    Expr.Paren(inner, line):
                        table <- walk_constant_comparison_expression(inner, table)
                    Expr.Array(elements, line):
                        for element in elements |table|:
                            table <- walk_constant_comparison_expression(element, table)
                    Expr.Tuple(elements, line):
                        for element in elements |table|:
                            table <- walk_constant_comparison_expression(element, table)
                    Expr.SetLit(elements, line):
                        for element in elements |table|:
                            table <- walk_constant_comparison_expression(element, table)
                    Expr.DictLit(entries, line):
                        for entry in entries |table|:
                            table <- walk_constant_comparison_expression(entry.key, table)
                            table <- walk_constant_comparison_expression(entry.value, table)
                    Expr.Construct(type_expression, fields, line):
                        table <- walk_constant_comparison_expression(type_expression, table)
                        for field in fields |table|:
                            table <- walk_constant_comparison_expression(field.value, table)
                    Expr.RecordUpdate(base, fields, line):
                        table <- walk_constant_comparison_expression(base, table)
                        for field in fields |table|:
                            table <- walk_constant_comparison_expression(field.value, table)
                    Expr.If(condition, then_expr, else_expr, line):
                        table <- walk_constant_comparison_expression(condition, table)
                        table <- walk_constant_comparison_expression(then_expr, table)
                        table <- walk_constant_comparison_expression(else_expr, table)
                    Expr.Match(scrutinee, arms, line):
                        table <- walk_constant_comparison_expression(scrutinee, table)
                        for arm in arms |table|:
                            table <- walk_constant_comparison_expression(arm.guard, table)
                            table <- walk_constant_comparison_statements(arm.body, table)
                    # `catch EXPR:` — positionally identical to Match (guarded, arms, line);
                    # the guarded call is the scrutinee and the arms walk the same way.
                    Expr.Catch(scrutinee, arms, line):
                        table <- walk_constant_comparison_expression(scrutinee, table)
                        for arm in arms |table|:
                            table <- walk_constant_comparison_expression(arm.guard, table)
                            table <- walk_constant_comparison_statements(arm.body, table)
                    Expr.Comprehension(loop_variable, iterable, condition, body, line):
                        table <- walk_constant_comparison_expression(iterable, table)
                        table <- walk_constant_comparison_expression(condition, table)
                        table <- walk_constant_comparison_expression(body, table)
                    Expr.Lambda(parameters, body, line):
                        table <- walk_constant_comparison_statements(body, table)
                    Expr.Block(statements, value, captures, line):
                        table <- walk_constant_comparison_statements(statements, table)
                        table <- walk_constant_comparison_expression(value, table)


        # Entry point: check all declarations for constant comparison expressions.
        def check_declarations_for_constant_comparison(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table|:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            table <- walk_constant_comparison_statements(body, table)
                        Decl.Module(name, body, line):
                            table <- check_declarations_for_constant_comparison(body, table)
                        Decl.Scoped(body, line):
                            table <- check_declarations_for_constant_comparison(body, table)
                        _:
                            pass


    public:
        # Public check function that can be called from semantic_api.
        def check_constant_comparison(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- check_declarations_for_constant_comparison(declarations, table)
