# Reject an explicitly empty error-variant group. The parser keeps a marker-only row for
# recovery, but Stage0's resolver requires at least one qualified error tag in each `error[...]`.
extend Semantic:
    public:
        def check_empty_error_set_subset(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                annotations: darray[Ast::EnumAnnotation] = file.enum_annotations
                index: mutable usize = 0
                while index < annotations.count |index, annotations, table|:
                    marker: Ast::EnumAnnotation = annotations[index]
                    if marker.owner == "__empty_error_set":
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.EmptyErrorSetSubset, name: "", line: marker.line, expected: "", actual: ""})
                    elif marker.owner == "__error_variant_family":
                        has_allow_row: mutable bool = false
                        if index + 1.usize() < annotations.count:
                            next: Ast::EnumAnnotation = annotations[index + 1.usize()]
                            has_allow_row <- next.owner == "__error_variant_allow" and next.line == marker.line and next.offset == marker.offset and next.identity_id == marker.identity_id and next.occurrence_offset == marker.occurrence_offset
                        if not has_allow_row and index >= 2.usize():
                            family: Ast::EnumAnnotation = annotations[index - 2.usize()]
                            path: Ast::EnumAnnotation = annotations[index - 1.usize()]
                            family_matches: bool = family.owner == "__error_set_family" and family.name == marker.name and family.line == marker.line and family.offset == marker.offset and family.identity_id == marker.identity_id and family.occurrence_offset == marker.occurrence_offset
                            path_matches: bool = path.owner == "__error_set_family_path" and path.line == family.line and path.offset == family.offset and path.identity_id == family.identity_id and path.occurrence_offset == family.occurrence_offset
                            if family_matches and path_matches:
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.EmptyErrorSetSubset, name: "", line: marker.line, expected: "", actual: ""})
                    elif marker.owner == "__protocol_error_variant_family" and marker.line == 3900000146:
                        has_allow_row: mutable bool = false
                        if index + 1.usize() < annotations.count:
                            next: Ast::EnumAnnotation = annotations[index + 1.usize()]
                            has_allow_row <- next.owner == marker.name and next.line == 3900000147 and next.module == marker.module and next.offset == marker.offset and next.occurrence_offset == marker.occurrence_offset
                        if not has_allow_row and index >= 2.usize():
                            family: Ast::EnumAnnotation = annotations[index - 2.usize()]
                            path: Ast::EnumAnnotation = annotations[index - 1.usize()]
                            family_matches: bool = family.line == 3900000064 and family.name == marker.name and family.module == marker.module and family.offset == marker.offset and family.occurrence_offset == marker.occurrence_offset
                            path_matches: bool = path.owner == "__protocol_error_family_path" and path.line == 3900000067 and path.module == marker.module and path.offset == marker.offset and path.occurrence_offset == marker.occurrence_offset
                            method_line: mutable u32 = 0
                            for scope in annotations |method_line, annotations, marker|:
                                method_line <- scope.line if scope.owner == "__protocol_method_scope" and scope.module == marker.module and scope.offset == marker.offset
                            if family_matches and path_matches and method_line != 0:
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.EmptyErrorSetSubset, name: "", line: method_line, expected: "", actual: ""})
                    index <- index + 1.usize()
