# `@inbounds` promises every index access is statically proven in-bounds (no runtime check). A
# TOP-LEVEL index `arr[i]` whose index is a plain integer parameter — no refinement, not bounded by
# a `requires` — is provably NOT proven, so stage0 rejects it ("@inbounds function X has an index
# access that is not statically proven in-bounds …"). SOUND subset: fire only for a plain-integer
# parameter index used at the top level of the body (an index inside an `if`/`for` might be guarded
# or a loop variable — a conservative miss); a refined/requires-bounded index is the prover's job.
extend Semantic:
    private:
        def inbounds_has_decorator(decorators: darray[Ast::Annotation]&) -> bool:
            can Abort.Panic:
                return any decorator in decorators where decorator.name == "inbounds"

        # A parameter whose type is a BARE integer Ident (no refinement/wrapper) — the index form
        # the prover has no bound for.
        def inbounds_plain_integer_param(type_expression: Ast::Expr) -> bool:
            can Abort.Panic:
                return match type_expression:
                    Expr.Ident(name, line): is_integer_type_name(name)
                    _: false

        def inbounds_name_present(names: darray[sview]&, wanted: sview) -> bool:
            can Abort.Panic:
                return any name in names where name == wanted

        # Whether EXPRESSION contains an index `arr[i]` whose index operand names a plain-integer
        # parameter (recursing through the usual value shapes).
        def inbounds_expr_indexes_plain(expression: Ast::Expr, plain_params: darray[sview]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Index(object, index, index_line):
                        true return if inbounds_name_present(plain_params, ident_name_of(index))
                        return inbounds_expr_indexes_plain(object, plain_params) or inbounds_expr_indexes_plain(index, plain_params)
                    Expr.Binary(left, operator, right, line):
                        return inbounds_expr_indexes_plain(left, plain_params) or inbounds_expr_indexes_plain(right, plain_params)
                    Expr.Unary(operator, operand, line):
                        return inbounds_expr_indexes_plain(operand, plain_params)
                    Expr.Paren(inner, line):
                        return inbounds_expr_indexes_plain(inner, plain_params)
                    Expr.Call(callee, arguments, argument_names, line):
                        return any argument in arguments where inbounds_expr_indexes_plain(argument, plain_params)
                    _:
                        return false

        # Whether any TOP-LEVEL statement (not descending into if/for/while — those may guard the
        # index) contains a plain-parameter index.
        def inbounds_body_indexes_plain(statements: darray[Ast::Stmt], plain_params: darray[sview]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                return any statement in statements where inbounds_statement_indexes_plain(statement, plain_params)

        def inbounds_statement_indexes_plain(statement: Ast::Stmt, plain_params: darray[sview]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                return match statement:
                    Stmt.Return(value, line): inbounds_return_indexes_plain(value, plain_params)
                    Stmt.Expr(expression, line): inbounds_expr_indexes_plain(expression, plain_params)
                    Stmt.VarDecl(name, type_expression, value, line): inbounds_expr_indexes_plain(value, plain_params)
                    Stmt.Assign(target, operator, value, line): inbounds_expr_indexes_plain(target, plain_params) or inbounds_expr_indexes_plain(value, plain_params)
                    _: false

        def inbounds_return_indexes_plain(value: Ast::Expr?, plain_params: darray[sview]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                returned: Ast::Expr = get value else return false
                return inbounds_expr_indexes_plain(returned, plain_params)

        def check_inbounds_index_decls(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            if inbounds_has_decorator(decorators):
                                requires_names: mutable darray[sview] = []
                                for statement in body |requires_names|:
                                    match statement:
                                        Stmt.Contract(kind, expression, contract_line):
                                            collect_expression_idents(expression, requires_names) if kind == "requires"
                                        _:
                                            pass
                                plain_params: mutable darray[sview] = []
                                for parameter in params |plain_params|:
                                    plain_params.push(parameter.name) if inbounds_plain_integer_param(parameter.type_expression) and not inbounds_name_present(requires_names, parameter.name)
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.InboundsUnproven, name: name, line: line, expected: "", actual: ""}) if plain_params.count > 0 and inbounds_body_indexes_plain(body, plain_params)
                        Decl.Module(module_name, module_body, module_line):
                            table <- check_inbounds_index_decls(module_body, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- check_inbounds_index_decls(scoped_body, table)
                        _:
                            pass

    public:
        def check_inbounds_index(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- check_inbounds_index_decls(declarations, table)
