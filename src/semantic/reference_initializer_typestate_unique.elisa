# A saturating cardinality and membership proof for the narrow typestate-widening gate.
module SemanticReferenceInitializerTypestate:
    public:
        # 0 means no matching struct, 1 means exactly one, and 2 means at least two.
        # Saturation keeps the uniqueness decision exact without a wrapping counter.
        ghost def matching_struct_count_class_prefix(table: Semantic::SymbolTable&, name: sview, end: usize) -> u8:
            requires end <= table.symbols.count
            decreases end
            return 0 if end == 0
            prior_end: usize = end - 1
            prior_count: u8 = matching_struct_count_class_prefix(table, name, prior_end)
            matches_name: bool = table.symbols[prior_end].kind == Semantic::SymbolKind::Struct and table.symbols[prior_end].name == name
            return 2 if:
                prior_count == 2
                prior_count == 1 and matches_name
            return 1 if matches_name
            return prior_count

        ghost def typestate_name_member_prefix(table: Semantic::SymbolTable&, name: sview, end: usize) -> bool:
            requires end <= table.typestate_struct_names.count
            decreases end
            return false if end == 0
            prior_end: usize = end - 1
            return true if table.typestate_struct_names[prior_end] == name
            return typestate_name_member_prefix(table, name, prior_end)

        ghost def unique_named_typestate_struct_spec(table: Semantic::SymbolTable&, name: sview) -> bool:
            return matching_struct_count_class_prefix(table, name, table.symbols.count) == 1 and typestate_name_member_prefix(table, name, table.typestate_struct_names.count)

        def unique_named_typestate_struct(table: Semantic::SymbolTable&, name: sview) -> bool:
            ensure result == unique_named_typestate_struct_spec(table, name)
            can Abort.Panic:
                declarations: mutable u8 = 0
                for index in 0..<table.symbols.count |declarations, table, name|:
                    invariant index <= table.symbols.count
                    invariant declarations == matching_struct_count_class_prefix(table, name, index)
                    symbol_matches: bool = table.symbols[index].kind == Semantic::SymbolKind::Struct and table.symbols[index].name == name
                    if symbol_matches:
                        if declarations == 0:
                            declarations <- 1
                        else:
                            declarations <- 2
                registered: mutable bool = false
                for index in 0..<table.typestate_struct_names.count |registered, table, name|:
                    invariant index <= table.typestate_struct_names.count
                    invariant registered == typestate_name_member_prefix(table, name, index)
                    registered <- true if table.typestate_struct_names[index] == name
                return declarations == 1 and registered
