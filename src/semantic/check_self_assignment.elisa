# Self-assignment check: detects mutations like `x <- x` that have no effect.
# Only flags `<-` (mutation arrow), not `=` (new binding).

include "./self_assignment_policy.elisa"

extend Semantic:
    private:
        # Current-parse data consumed by the incremental fact collector. These Pos values
        # never leave the invocation that produced them.
        struct SelfAssignmentFinding:
            name: sview
            target_position: Ast::Pos
            statement_position: Ast::Pos

        # The incremental fact collector is opt-in and bounded. Cold checking below
        # remains a streaming walk so the default path does not allocate a findings list.
        def collect_self_assignment_findings_bounded(statements: darray[Ast::Stmt], limit: usize, findings: mutable darray[SelfAssignmentFinding]&, complete: mutable bool&) -> void:
            can Memory.Allocate, Abort.Panic:
                return if not complete
                for statement in statements |findings, complete|:
                    return if not complete
                    match statement:
                        Stmt.Assign(target, operator, value, line):
                            match target:
                                Expr.Ident(target_name, target_position):
                                    match value:
                                        Expr.Ident(value_name, _):
                                            if SelfAssignmentPolicy::should_report(operator, target_name, value_name):
                                                if findings.count >= limit:
                                                    complete <- false
                                                else:
                                                    findings.push(SelfAssignmentFinding{name: target_name, target_position: target_position, statement_position: line})
                                        _:
                                            pass
                                _:
                                    pass
                        Stmt.Expr(_, _):
                            pass
                        Stmt.If(condition, then_body, else_body, _):
                            collect_self_assignment_findings_bounded(then_body, limit, &findings, &complete)
                            collect_self_assignment_findings_bounded(else_body, limit, &findings, &complete)
                        Stmt.While(condition, body, _):
                            collect_self_assignment_findings_bounded(body, limit, &findings, &complete)
                        Stmt.For(bind, variables, iterable, body, _):
                            collect_self_assignment_findings_bounded(body, limit, &findings, &complete)
                        Stmt.Block(kind, clause, binding, body, _):
                            collect_self_assignment_findings_bounded(body, limit, &findings, &complete)
                        Stmt.Match(scrutinee, arms, _):
                            for arm in arms |findings, complete|:
                                collect_self_assignment_findings_bounded(arm.body, limit, &findings, &complete)
                        Stmt.VarDecl(_, _, _, _) | Stmt.Return(_, _) | Stmt.Contract(_, _, _) | Stmt.Invalid | Stmt.Break(_, _) | Stmt.Continue(_, _):
                            pass

        def check_self_assignment_statements(statements: darray[Ast::Stmt], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table|:
                    match statement:
                        Stmt.Assign(target, operator, value, line):
                            match target:
                                Expr.Ident(target_name, target_position):
                                    match value:
                                        Expr.Ident(value_name, _):
                                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.SelfAssignment, name: target_name, pos: target_position, line: line.line, expected: "", actual: ""}) if SelfAssignmentPolicy::should_report(operator, target_name, value_name)
                                        _:
                                            pass
                                _:
                                    pass
                        Stmt.Expr(_, _):
                            pass
                        Stmt.If(condition, then_body, else_body, _):
                            table <- check_self_assignment_statements(then_body, table)
                            table <- check_self_assignment_statements(else_body, table)
                        Stmt.While(condition, body, _):
                            table <- check_self_assignment_statements(body, table)
                        Stmt.For(bind, variables, iterable, body, _):
                            table <- check_self_assignment_statements(body, table)
                        Stmt.Block(kind, clause, binding, body, _):
                            table <- check_self_assignment_statements(body, table)
                        Stmt.Match(scrutinee, arms, _):
                            for arm in arms |table|:
                                table <- check_self_assignment_statements(arm.body, table)
                        Stmt.VarDecl(_, _, _, _) | Stmt.Return(_, _) | Stmt.Contract(_, _, _) | Stmt.Invalid | Stmt.Break(_, _) | Stmt.Continue(_, _):
                            pass


        # Entry point: check all declarations for self-assignments in function bodies.
        def check_self_assignment(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(name, parameters, return_type, body, effects, decorators, line):
                            table <- check_self_assignment_statements(body, table)
                        Decl.Module(name, body, line):
                            table <- check_self_assignment(body, table)
                        Decl.Scoped(body, line):
                            table <- check_self_assignment(body, table)
                        _:
                            table
