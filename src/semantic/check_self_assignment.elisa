# Self-assignment check: detects mutations like `x <- x` that have no effect.
# Only flags `<-` (mutation arrow), not `=` (new binding).

extend Semantic:
    private:
        # Check a single statement for self-assignments and recurse into nested bodies.
        def check_self_assignment_statements(statements: darray[Ast::Stmt], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Assign(target, operator, value, line):
                            # Flag only `<-` (mutation arrow) where both target and value
                            # are identical identifiers.
                            if operator == TokenKind.LArrow and target is Expr.Ident(target_name, tl) and value is Expr.Ident(value_name, vl) and target_name == value_name:
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.SelfAssignment, name: target_name, line: line.line, expected: "", actual: ""})
                                table
                            else:
                                table
                        Stmt.Expr(expression, line):
                            table
                        Stmt.If(condition, then_body, else_body, line):
                            table <- check_self_assignment_statements(then_body, table)
                            table <- check_self_assignment_statements(else_body, table)
                        Stmt.While(condition, body, line):
                            table <- check_self_assignment_statements(body, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- check_self_assignment_statements(body, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- check_self_assignment_statements(body, table)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |table| -> table:
                                table <- check_self_assignment_statements(arm.body, table)
                        Stmt.VarDecl(name, type_expression, value, line):
                            table
                        Stmt.Return(value, line):
                            table
                        Stmt.Contract(kind, expression, line):
                            table
                        Stmt.Invalid:
                            table
                        Stmt.Break(label, line):
                            table
                        Stmt.Continue(label, line):
                            table


        # Entry point: check all declarations for self-assignments in function bodies.
        def check_self_assignment(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(name, parameters, return_type, body, effects, decorators, line):
                            table <- check_self_assignment_statements(body, table)
                        Decl.Module(name, body, line):
                            table <- check_self_assignment(body, table)
                        Decl.Scoped(body, line):
                            table <- check_self_assignment(body, table)
                        _:
                            table
