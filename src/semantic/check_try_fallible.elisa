                        continue if not try_error_alias_module_path_matches(target_path, target_family, alias_module, alias_pos.line, declaration.module, annotations)
                        if direct_count == 0.usize():
                            selected_family <- declaration.name
                            selected_module <- declaration.module
                            direct_count <- 1.usize()
                        elif declaration.module != selected_module:
                            direct_count <- direct_count + 1.usize()
                    for index in 0..<table.type_alias_name.count |selected_alias, alias_count, target_path, target_family, alias_module, alias_pos, table, annotations|:
                        continue if table.type_alias_name[index] != target_family or index >= table.type_alias_declarations.count
                        alias_declaration: TypeAliasDeclaration = table.type_alias_declarations[index]
                        continue if not try_error_alias_module_path_matches(target_path, target_family, alias_module, alias_pos.line, alias_declaration.module_owner, annotations)
                        continue if not try_error_alias_name_visible(annotations, target_family, alias_declaration.module_owner, alias_module)
                        selected_alias <- index
                        alias_count <- alias_count + 1.usize()
                    return (true, selected_family, selected_module, false) if direct_count == 1.usize() and alias_count == 0.usize()
                    return (false, "", "", true) if direct_count > 1.usize() or alias_count > 1.usize() or (direct_count > 0.usize() and alias_count > 0.usize())
                    return try_error_alias_declaration_identity(annotations, selected_alias, table, visited) if alias_count == 1.usize()
                    return (false, "", "", false)
                # Core checks the exact root type before lexical and imported candidates.
                return (true, target_family, "", false) if try_error_set_decl_has_owner(annotations, target_family, "")
                root_alias: (found: bool, index: usize) = try_error_alias_index(target_family, "", table)
                if root_alias.found:
                    return try_error_alias_declaration_identity(annotations, root_alias.index, table, visited)
                return (false, "", "", false) if try_error_alias_local_non_error_type_exists(target_family, "", table)
                lexical_module: mutable sview @source = alias_module
                lexical_alias_index: mutable usize = 0.usize()
                lexical_alias_found: mutable bool = false
                while true |lexical_module, annotations, target_family, alias_module, table|:
                    return (true, target_family, lexical_module, false) if try_error_set_decl_has_owner(annotations, target_family, lexical_module)
                    lexical_alias: (found: bool, index: usize) = try_error_alias_index(target_family, lexical_module, table)
                    if lexical_alias.found:
                        lexical_alias_index <- lexical_alias.index
                        lexical_alias_found <- true
                        break
                    return (false, "", "", false) if try_error_alias_local_non_error_type_exists(target_family, lexical_module, table)
                    break if lexical_module == ""
                    lexical_module <- try_noncall_module_parent(lexical_module)
                return try_error_alias_declaration_identity(annotations, lexical_alias_index, table, visited) if lexical_alias_found
                import_scope: mutable sview @source = alias_module
                selected_imported_module: mutable sview @source = ""
                selected_imported_family: mutable sview @source = ""
                selected_imported_alias_index: mutable usize = 0.usize()
                selected_imported_count: mutable usize = 0.usize()
                selected_imported_alias_count: mutable usize = 0.usize()
                selected_imported_ambiguous: mutable bool = false
                while true |import_scope, annotations, target_family, alias_module, table, selected_imported_module, selected_imported_family, selected_imported_alias_index, selected_imported_count, selected_imported_alias_count, selected_imported_ambiguous|:
                    imported_module: mutable sview @source = ""
                    imported_family: mutable sview @source = ""
                    imported_count: mutable usize = 0.usize()
                    imported_alias_index: mutable usize = 0.usize()
                    imported_alias_count: mutable usize = 0.usize()
                    for declaration in annotations |annotations, target_family, import_scope, alias_module, table|:
                        continue if declaration.owner != "__error_set_decl" or declaration.name != target_family or esh_error_set_decl_is_private(annotations, declaration)
                        if try_error_set_decl_imported_at_scope(annotations, declaration, import_scope, alias_module):
                            if imported_count == 0.usize():
                                imported_module <- declaration.module
                                imported_family <- declaration.name
                                imported_count <- 1.usize()
                            elif declaration.module != imported_module:
                                imported_count <- imported_count + 1.usize()
                    for index in 0..<table.type_alias_name.count |imported_alias_index, imported_alias_count, target_family, import_scope, alias_module, table, annotations|:
                        continue if table.type_alias_name[index] != target_family or index >= table.type_alias_declarations.count
                        alias_declaration: TypeAliasDeclaration = table.type_alias_declarations[index]
                        continue if not try_error_alias_imported_at_scope(annotations, target_family, alias_declaration.module_owner, import_scope, alias_module)
                        imported_alias_index <- index
                        imported_alias_count <- imported_alias_count + 1.usize()
                    if imported_count > 0.usize() or imported_alias_count > 0.usize():
                        selected_imported_module <- imported_module
                        selected_imported_family <- imported_family
                        selected_imported_alias_index <- imported_alias_index
                        selected_imported_count <- imported_count
                        selected_imported_alias_count <- imported_alias_count
                        selected_imported_ambiguous <- imported_count > 1.usize() or imported_alias_count > 1.usize() or (imported_count > 0.usize() and imported_alias_count > 0.usize())
                        break
                    break if import_scope == ""
                    import_scope <- try_noncall_module_parent(import_scope)
                return (false, "", "", true) if selected_imported_ambiguous
                return try_error_alias_declaration_identity(annotations, selected_imported_alias_index, table, visited) if selected_imported_alias_count == 1.usize()
                return (true, selected_imported_family, selected_imported_module, false) if selected_imported_count == 1.usize()
                return (false, "", "", false)

        def try_error_alias_declaration_is_error_set(annotations: darray[Ast::EnumAnnotation]&, alias_index: usize, table: mutable SymbolTable&, visited: mutable darray[u32]&) -> bool can[Memory.Allocate, Abort.Panic]:
            can Memory.Allocate, Abort.Panic:
                return try_error_alias_declaration_identity(annotations, alias_index, table, visited).found

        def try_error_alias_target_is_error_set(annotations: darray[Ast::EnumAnnotation]&, target: Ast::Expr, alias_module: sview @source, alias_pos: Ast::Pos, table: mutable SymbolTable&, visited: mutable darray[u32]&) -> bool can[Memory.Allocate, Abort.Panic]:
            can Memory.Allocate, Abort.Panic:
                return try_error_alias_target_identity(annotations, target, alias_module, alias_pos, table, visited).found

        def try_error_local_alias_targets_error_set(annotations: darray[Ast::EnumAnnotation]&, alias_name: sview, alias_module: sview @source, table: mutable SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                alias: (found: bool, index: usize) = try_error_alias_index(alias_name, alias_module, table)
                return false if not alias.found
                visited: mutable darray[u32] = []
                return try_error_alias_declaration_is_error_set(annotations, alias.index, table, visited)

        def try_error_alias_identity_for_name(annotations: darray[Ast::EnumAnnotation]&, alias_name: sview, alias_module: sview @source, table: mutable SymbolTable&) -> (found: bool, family: sview @source, module: sview @source, ambiguous: bool):
            can Memory.Allocate, Abort.Panic:
                alias: (found: bool, index: usize) = try_error_alias_index(alias_name, alias_module, table)
                return (false, "", "", false) if not alias.found
                visited: mutable darray[u32] = []
                return try_error_alias_declaration_identity(annotations, alias.index, table, visited)

        def try_error_alias_identity_for_index(annotations: darray[Ast::EnumAnnotation]&, alias_index: usize, table: mutable SymbolTable&) -> (found: bool, family: sview @source, module: sview @source, ambiguous: bool):
            can Memory.Allocate, Abort.Panic:
                visited: mutable darray[u32] = []
                return try_error_alias_declaration_identity(annotations, alias_index, table, visited)

        def try_error_alias_identity_for_imported_name(annotations: darray[Ast::EnumAnnotation]&, alias_name: sview @source, scope_module: sview @source, function_module: sview @source, table: mutable SymbolTable&) -> (found: bool, family: sview @source, module: sview @source, ambiguous: bool):
            can Memory.Allocate, Abort.Panic:
                selected_index: mutable usize = 0.usize()
                count: mutable usize = 0.usize()
                for index in 0..<table.type_alias_name.count |selected_index, count, annotations, alias_name, scope_module, function_module, table|:
                    continue if table.type_alias_name[index] != alias_name or index >= table.type_alias_declarations.count
                    declaration: TypeAliasDeclaration = table.type_alias_declarations[index]
                    continue if not try_error_alias_imported_at_scope(annotations, alias_name, declaration.module_owner, scope_module, function_module)
                    selected_index <- index
                    count <- count + 1.usize()
                return (false, "", "", true) if count > 1.usize()
                return (false, "", "", false) if count == 0.usize()
                return try_error_alias_identity_for_index(annotations, selected_index, table)

        def try_error_set_param_shadows_family(annotations: darray[Ast::EnumAnnotation]&, family_annotation: Ast::EnumAnnotation) -> bool:
            can Abort.Panic:
                return any row in annotations where row.owner == "__errorset_param" and row.name == family_annotation.name and row.line == family_annotation.line and row.offset == family_annotation.offset and row.identity_id == family_annotation.identity_id

        # Resolve a declared family through its declaration discriminator. Bare names
        # prefer the closest lexical declaration; qualified paths use the same alias-aware
        # module resolver as Catch. The unique-owner fallback keeps legacy top-level
        # references working when parser provenance is incomplete.
        def try_error_set_decl_module_for_annotation(annotations: darray[Ast::EnumAnnotation]&, family_annotation: Ast::EnumAnnotation, family_path: sview @source, function_module_known: bool, function_module: sview @source, table: mutable SymbolTable&) -> (known: bool, family: sview @source, module: sview @source, ambiguous: bool):
            can Abort.Panic:
                selected_module: mutable sview @source = ""
                selected_length: mutable usize = 0.usize()
                selected_line: mutable u32 = 0
                selected_offset: mutable u32 = 0
                selected: mutable bool = false
                ambiguous: mutable bool = false
                qualified_module: mutable sview @source = ""
                qualified_line: mutable u32 = 0
                qualified_offset: mutable u32 = 0
                qualified_found: mutable bool = false
                qualified_ambiguous: mutable bool = false
                qualified: bool = catch_first_module_separator_start(family_path) != family_path.len
                explicit_module: (found: bool, module: sview @source) = catch_explicit_error_family_module(family_path, family_annotation.line, family_annotation.offset, family_annotation.identity_id, function_module, family_annotation.name, annotations, table) if qualified else (false, "")
                # Core's errorSetTypeQuiet checks the exact root spelling before
                # consulting lexical or imported candidates.
                return (true, family_annotation.name, "", false) if not qualified and try_error_set_decl_has_owner(annotations, family_annotation.name, "")
                return (false, family_annotation.name, "", false) if not qualified and function_module_known and try_error_local_nominal_type_shadows_family(annotations, family_annotation.name, function_module, table)
                if not qualified:
                    root_alias: (found: bool, index: usize) = try_error_alias_index(family_annotation.name, "", table)
                    if root_alias.found:
                        root_identity: (found: bool, family: sview @source, module: sview @source, ambiguous: bool) = try_error_alias_identity_for_name(annotations, family_annotation.name, "", table)
                        return (true, root_identity.family, root_identity.module, false) if root_identity.found and not root_identity.ambiguous
                        return (false, family_annotation.name, "", root_identity.ambiguous)
                    if function_module_known:
                        lexical_alias_module: mutable sview @source = function_module
                        while true |lexical_alias_module, annotations, family_annotation, function_module, table|:
                            break if try_error_set_decl_has_owner(annotations, family_annotation.name, lexical_alias_module)
                            local_alias: (found: bool, index: usize) = try_error_alias_index(family_annotation.name, lexical_alias_module, table)
                            if local_alias.found:
                                local_identity: (found: bool, family: sview @source, module: sview @source, ambiguous: bool) = try_error_alias_identity_for_name(annotations, family_annotation.name, lexical_alias_module, table)
                                return (true, local_identity.family, local_identity.module, false) if local_identity.found and not local_identity.ambiguous
                                return (false, family_annotation.name, "", local_identity.ambiguous)
                            return (false, family_annotation.name, "", false) if try_error_alias_local_non_error_type_exists(family_annotation.name, lexical_alias_module, table)
                            break if lexical_alias_module == ""
                            lexical_alias_module <- try_noncall_module_parent(lexical_alias_module)
                else:
                    selected_alias_index: mutable usize = 0.usize()
                    selected_alias_count: mutable usize = 0.usize()
                    for index in 0..<table.type_alias_name.count |selected_alias_index, selected_alias_count, family_path, family_annotation, function_module, table, annotations|:
                        continue if table.type_alias_name[index] != family_annotation.name or index >= table.type_alias_declarations.count
                        alias_declaration: TypeAliasDeclaration = table.type_alias_declarations[index]
                        continue if not try_error_alias_module_path_matches(family_path, family_annotation.name, function_module, family_annotation.line, alias_declaration.module_owner, annotations)
                        continue if not try_error_alias_name_visible(annotations, family_annotation.name, alias_declaration.module_owner, function_module)
                        selected_alias_index <- index
                        selected_alias_count <- selected_alias_count + 1.usize()
                    if selected_alias_count == 1.usize():
                        qualified_alias: (found: bool, family: sview @source, module: sview @source, ambiguous: bool) = try_error_alias_identity_for_index(annotations, selected_alias_index, table)
                        return (true, qualified_alias.family, qualified_alias.module, false) if qualified_alias.found and not qualified_alias.ambiguous
                        return (false, family_annotation.name, "", qualified_alias.ambiguous)
                    return (false, family_annotation.name, "", true) if selected_alias_count > 1.usize()
                for declaration in annotations |selected_module, selected_length, selected_line, selected_offset, selected, ambiguous, qualified_module, qualified_line, qualified_offset, qualified_found, qualified_ambiguous, annotations, family_annotation, function_module_known, function_module, qualified, explicit_module|:
                    continue if declaration.owner != "__error_set_decl" or declaration.name != family_annotation.name
                    if qualified:
                        continue if not explicit_module.found or declaration.module != explicit_module.module
                        if not qualified_found:
                            qualified_module <- declaration.module
                            qualified_line <- declaration.line
                            qualified_offset <- declaration.offset
                            qualified_found <- true
                        elif declaration.module != qualified_module or declaration.line != qualified_line or declaration.offset != qualified_offset:
                            qualified_ambiguous <- true
                    else:
                        continue if not catch_module_path_matches(family_path, family_annotation.name)
                        if function_module_known:
                            private_decl: bool = esh_error_set_decl_is_private(annotations, declaration)
                            lexical_visible: mutable bool = declaration.module == function_module
                            lexical_visible <- true if not lexical_visible and catch_module_is_ancestor(declaration.module, function_module) and (declaration.module != "" or not private_decl)
                            if lexical_visible:
                                if not selected or declaration.module.len > selected_length:
                                    selected_module <- declaration.module
                                    selected_length <- declaration.module.len
                                    selected_line <- declaration.line
                                    selected_offset <- declaration.offset
                                    selected <- true
                                    ambiguous <- false
                                elif declaration.module.len == selected_length and (declaration.module != selected_module or declaration.line != selected_line or declaration.offset != selected_offset):
                                    ambiguous <- true
                if qualified:
                    return (true, family_annotation.name, qualified_module, false) if qualified_found and not qualified_ambiguous
                    return (false, family_annotation.name, family_annotation.name, qualified_ambiguous)
                return (true, family_annotation.name, selected_module, false) if selected and not ambiguous
                return (false, family_annotation.name, family_annotation.name, ambiguous) if selected
                if function_module_known:
                    import_scope: mutable sview @source = function_module
                    while true |import_scope, family_annotation, annotations, function_module, function_module_known|:
                        imported_alias: (found: bool, family: sview @source, module: sview @source, ambiguous: bool) = try_error_alias_identity_for_imported_name(annotations, family_annotation.name, import_scope, function_module, table)
                        return (true, imported_alias.family, imported_alias.module, false) if imported_alias.found and not imported_alias.ambiguous
                        return (false, family_annotation.name, "", true) if imported_alias.ambiguous
                        imported_module: mutable sview @source = ""
                        imported_line: mutable u32 = 0
                        imported_offset: mutable u32 = 0
                        imported_count: mutable usize = 0.usize()
                        import_ambiguous: mutable bool = false
                        for declaration in annotations |imported_module, imported_line, imported_offset, imported_count, import_ambiguous, annotations, family_annotation, import_scope, function_module|:
                            continue if declaration.owner != "__error_set_decl" or declaration.name != family_annotation.name
                            continue if esh_error_set_decl_is_private(annotations, declaration)
                            continue if not catch_module_path_matches(family_path, family_annotation.name)
                            continue if not try_error_set_decl_imported_at_scope(annotations, declaration, import_scope, function_module)
                            if imported_count == 0.usize():
                                imported_module <- declaration.module
                                imported_line <- declaration.line
                                imported_offset <- declaration.offset
                                imported_count <- 1.usize()
                            elif declaration.module != imported_module or declaration.line != imported_line or declaration.offset != imported_offset:
                                imported_count <- imported_count + 1.usize()
                                import_ambiguous <- true
                        return (true, family_annotation.name, imported_module, false) if imported_count == 1.usize() and not import_ambiguous
                        return (false, family_annotation.name, family_annotation.name, true) if imported_count > 1.usize() or import_ambiguous
                        break if import_scope == ""
                        import_scope <- try_noncall_module_parent(import_scope)
                    return (false, family_annotation.name, family_annotation.name, false)
                fallback_module: mutable sview @source = ""
                fallback_line: mutable u32 = 0
                fallback_offset: mutable u32 = 0
                fallback_count: mutable usize = 0.usize()
                fallback_ambiguous: mutable bool = false
                for declaration in annotations |fallback_module, fallback_line, fallback_offset, fallback_count, fallback_ambiguous, family_annotation|:
                    continue if declaration.owner != "__error_set_decl" or declaration.name != family_annotation.name
                    continue if not catch_module_path_matches(family_path, family_annotation.name)
                    if fallback_count == 0.usize():
                        fallback_module <- declaration.module
                        fallback_line <- declaration.line
                        fallback_offset <- declaration.offset
                        fallback_count <- 1.usize()
                    elif declaration.module != fallback_module or declaration.line != fallback_line or declaration.offset != fallback_offset:
                        fallback_count <- fallback_count + 1.usize()
                        fallback_ambiguous <- true
                return (true, family_annotation.name, fallback_module, false) if fallback_count == 1.usize() and not fallback_ambiguous
                return (false, family_annotation.name, family_annotation.name, fallback_ambiguous)

        # A bare error[...] item first names a declared error set (or a same-spelled
        # errorset parameter); otherwise it may be a variant. Search only owners that
        # have the parser's explicit error-set declaration marker, excluding ordinary enums.
        def try_error_variant_owner_for_annotation(annotations: darray[Ast::EnumAnnotation]&, variant: sview, table: SymbolTable&) -> (count: usize, family: sview @source, module: sview @source):
            can Abort.Panic:
                count: mutable usize = 0.usize()
                selected_family: mutable sview @source = ""
                selected_module: mutable sview @source = ""
                for variant_index in 0..<table.enum_variant_name.count |count, selected_family, selected_module, annotations, variant, table|:
                    continue if table.enum_variant_name[variant_index] != variant or variant_index >= table.enum_variant_owner.count or variant_index >= table.enum_variant_module.count
                    owner: sview = table.enum_variant_owner[variant_index]
                    module: sview = table.enum_variant_module[variant_index]
                    continue if not try_error_set_decl_has_owner(annotations, owner, module)
                    duplicate: bool = count > 0 and selected_family == owner and selected_module == module
                    if not duplicate:
                        count <- count + 1.usize()
                        selected_family <- owner if count == 1.usize()
                        selected_module <- module if count == 1.usize()
                return (count, selected_family, selected_module)

        def try_error_family_ref_for_annotation(annotations: darray[Ast::EnumAnnotation]&, family_annotation: Ast::EnumAnnotation, family_path: sview @source, function_module_known: bool, function_module: sview @source, table: mutable SymbolTable&) -> TryErrorFamilyRef:
            can Abort.Panic:
                family: sview @source = family_annotation.name
                parameter_shadow: bool = try_error_set_param_shadows_family(annotations, family_annotation)
                is_unqualified: bool = catch_first_module_separator_start(family_path) == family_path.len and catch_module_path_matches(family_path, family)
                local_type_shadow: bool = try_error_local_nominal_type_shadows_family(annotations, family, function_module, table) if function_module_known and is_unqualified else false
                if parameter_shadow and is_unqualified:
                    return TryErrorFamilyRef{family: family, module: "", module_known: false, family_path: family_path, source_name: family, variant_override: "", declaration_line: family_annotation.line, declaration_offset: family_annotation.offset, declaration_identity_id: family_annotation.identity_id, occurrence_offset: family_annotation.occurrence_offset}
                declaration_module: (known: bool, family: sview @source, module: sview @source, ambiguous: bool) = try_error_set_decl_module_for_annotation(annotations, family_annotation, family_path, function_module_known, function_module, table)
                if declaration_module.known:
                    return TryErrorFamilyRef{family: declaration_module.family, module: declaration_module.module, module_known: true, family_path: family_path, source_name: family, variant_override: "", declaration_line: family_annotation.line, declaration_offset: family_annotation.offset, declaration_identity_id: family_annotation.identity_id, occurrence_offset: family_annotation.occurrence_offset}
                return TryErrorFamilyRef{family: "", module: "", module_known: false, family_path: family_path, source_name: family, variant_override: "", declaration_line: family_annotation.line, declaration_offset: family_annotation.offset, declaration_identity_id: family_annotation.identity_id, occurrence_offset: family_annotation.occurrence_offset} if declaration_module.ambiguous
                visible_decl_exists: bool = esh_is_error_set_visible(annotations, family, function_module, family_annotation.offset, table) if function_module_known and is_unqualified and not local_type_shadow else false
                can_resolve_bare_variant: bool = is_unqualified and (local_type_shadow or not visible_decl_exists) and (function_module_known or not try_error_set_decl_exists(annotations, family))
                if can_resolve_bare_variant:
                    variant_owner: (count: usize, family: sview @source, module: sview @source) = try_error_variant_owner_for_annotation(annotations, family, table)
                    if variant_owner.count == 1.usize():
                        return TryErrorFamilyRef{family: variant_owner.family, module: variant_owner.module, module_known: true, family_path: family_path, source_name: family, variant_override: family, declaration_line: family_annotation.line, declaration_offset: family_annotation.offset, declaration_identity_id: family_annotation.identity_id, occurrence_offset: family_annotation.occurrence_offset}
                    # Unknown or ambiguous bare items already have a type diagnostic. Do
                    # not add a second, unrelated Try coverage mismatch for the same name.
                    return TryErrorFamilyRef{family: "", module: "", module_known: false, family_path: family_path, source_name: family, variant_override: "", declaration_line: family_annotation.line, declaration_offset: family_annotation.offset, declaration_identity_id: family_annotation.identity_id, occurrence_offset: family_annotation.occurrence_offset} if variant_owner.count != 0 or any row in annotations where row.owner == "__error_set_decl"
                # A declared family name with no resolvable declaration path is already
                # invalid at the type-resolution layer. Suppress a secondary Try mismatch.
                return TryErrorFamilyRef{family: "", module: "", module_known: false, family_path: family_path, source_name: family, variant_override: "", declaration_line: family_annotation.line, declaration_offset: family_annotation.offset, declaration_identity_id: family_annotation.identity_id, occurrence_offset: family_annotation.occurrence_offset} if try_error_set_decl_exists(annotations, family)
                path_resolves: bool = try_error_family_path_resolves(family_path, family, family_annotation.line, family_annotation.offset, family_annotation.identity_id, function_module, annotations, table)
                resolved: (known: bool, module: sview @source) = catch_error_family_module_for_declaration(annotations, family_annotation.line, family_annotation.offset, family_annotation.identity_id, family, family_path, function_module_known, function_module, table)
                return TryErrorFamilyRef{family: family, module: resolved.module, module_known: resolved.known, family_path: family_path if path_resolves else "", source_name: family, variant_override: "", declaration_line: family_annotation.line, declaration_offset: family_annotation.offset, declaration_identity_id: family_annotation.identity_id, occurrence_offset: family_annotation.occurrence_offset}

        def try_error_family_path_resolves(path: sview @source, family: sview @source, declaration_line: u32, declaration_offset: u32, declaration_identity_id: u32, declaration_module: sview @source, annotations: darray[Ast::EnumAnnotation]&, table: SymbolTable&) -> bool:
            can Abort.Panic:
                return false if path == ""
                return catch_module_path_matches(path, family) if catch_first_module_separator_start(path) == path.len
                resolved: (found: bool, module: sview @source) = catch_explicit_error_family_module(path, declaration_line, declaration_offset, declaration_identity_id, declaration_module, family, annotations, table)
                return resolved.found

        # The callable index points at the compact __error_return/name pair, while the
        # source-backed family path is emitted later by capture_header_error_families.
        # Join the rows by declaration identity and family leaf, then keep the adjacent path.
        def try_error_family_path_for_declaration(annotations: darray[Ast::EnumAnnotation]&, family: sview, declaration_line: u32, declaration_offset: u32, declaration_identity_id: u32, occurrence_offset: u32) -> sview @source:
            can Abort.Panic:
                selected: mutable sview @source = ""
                found: mutable bool = false
                ambiguous: mutable bool = false
                for family_index in 0..<annotations.count |annotations, family, declaration_line, declaration_offset, declaration_identity_id, occurrence_offset|:
                    family_annotation: Ast::EnumAnnotation = annotations[family_index]
                    continue if family_annotation.owner != "__error_set_family" or family_annotation.name != family or family_annotation.line != declaration_line
                    continue if declaration_offset != 0 and family_annotation.offset != declaration_offset
                    continue if declaration_identity_id != 0 and family_annotation.identity_id != declaration_identity_id
                    continue if family_annotation.occurrence_offset != occurrence_offset
                    continue if family_index + 1.usize() >= annotations.count
                    path_annotation: Ast::EnumAnnotation = annotations[family_index + 1.usize()]
                    if path_annotation.owner == "__error_set_family_path" and path_annotation.line == family_annotation.line and path_annotation.offset == family_annotation.offset and path_annotation.identity_id == family_annotation.identity_id and path_annotation.occurrence_offset == family_annotation.occurrence_offset:
                        ambiguous <- true if found
                        selected <- path_annotation.name if not found
                        found <- true
                return selected if found and not ambiguous
                return ""

        def try_error_family_path_for_row(annotations: darray[Ast::EnumAnnotation]&, family_index: usize) -> sview @source:
            can Abort.Panic:
                return "" if family_index >= annotations.count or family_index + 1.usize() >= annotations.count
                family_annotation: Ast::EnumAnnotation = annotations[family_index]
                path_annotation: Ast::EnumAnnotation = annotations[family_index + 1.usize()]
                return path_annotation.name if family_annotation.owner == "__error_set_family" and path_annotation.owner == "__error_set_family_path" and path_annotation.line == family_annotation.line and path_annotation.offset == family_annotation.offset and path_annotation.identity_id == family_annotation.identity_id and path_annotation.occurrence_offset == family_annotation.occurrence_offset
                return ""

        # The LAST `::` segment of a module path (`WasmBrowser::Delivery` -> `Delivery`), so a
        # qualified call's written qualifier can be compared without rebuilding the spelling.
        def module_last_segment(module_name: sview) -> sview:
            can Abort.Panic:
                cut: mutable usize = 0
                start: mutable usize = 0
                while cut + 1.usize() < module_name.len |cut, start|:
                    start <- cut + 2.usize() if module_name[cut] == 58 and module_name[cut + 1.usize()] == 58
                    cut <- cut + 1.usize()
                return module_name[start:module_name.len]

        def try_noncall_module_path(parent: sview, child: sview @source, table: mutable SymbolTable&) -> sview @source:
            can Memory.Allocate, Abort.Panic:
                return child if parent == ""
                bytes: mutable darray[u8] = []
                bytes.reserve(parent.len + 2.usize() + child.len)
                for offset in 0..<parent.len |bytes, parent|:
                    bytes.push(parent[offset])
                bytes.push(58)
                bytes.push(58)
                for offset in 0..<child.len |bytes, child|:
                    bytes.push(child[offset])
                return intern_joined_text(bytes, table)

        def try_noncall_module_parent(module_path: sview) -> sview:
            can Abort.Panic:
                separator: mutable usize = module_path.len
                offset: mutable usize = 0
                while offset + 1.usize() < module_path.len |separator, offset|:
                    separator <- offset if module_path[offset] == 58 and module_path[offset + 1.usize()] == 58
                    offset <- offset + 1.usize()
                return "" if separator == module_path.len
                return module_path[0:separator]

        def try_noncall_module_is_ancestor(ancestor: sview, module_path: sview) -> bool:
            can Abort.Panic:
                return true if ancestor == "" or ancestor == module_path
                return false if module_path.len <= ancestor.len + 1.usize()
                return false if module_path[0:ancestor.len] != ancestor
                return module_path[ancestor.len] == 58 and module_path[ancestor.len + 1.usize()] == 58

        # Does this candidate row belong to the module the call resolves to? An explicit
        # qualifier (`Mods::B::step`) names it; a bare call means the ENCLOSING module.
        def callable_row_in_scope(module_annotations: darray[Ast::EnumAnnotation]&, declaration_offset: u32, declaration_line: u32, enclosing_module: sview, callee_qualifier: sview) -> bool:
            can Abort.Panic:
                candidate_module: sview = fallible_fn_module(module_annotations, declaration_offset, declaration_line)
                return module_last_segment(candidate_module) == callee_qualifier if callee_qualifier != ""
                return candidate_module == enclosing_module

        def callable_using_alias_target_count(annotations: darray[Ast::EnumAnnotation]&, alias_module: sview, alias_line: u32, alias_offset: u32, alias_name: sview) -> (count: usize, target: sview):
            can Abort.Panic:
                count: mutable usize = 0
                target: mutable sview = ""
                for row in annotations |count, target, alias_module, alias_line, alias_offset, alias_name|:
                    if row.name == "__using_alias_target" and row.module == alias_module and row.line == alias_line and row.offset == alias_offset:
                        paired_alias: mutable bool = false
                        for alias in annotations |paired_alias, alias_module, alias_line, alias_offset, alias_name, row|:
                            paired_alias <- true if alias.name == "__using_alias" and alias.owner == alias_name and alias.module == alias_module and alias.line == alias_line and alias.offset == alias_offset
                        if paired_alias:
                            count <- count + 1.usize()
                            target <- row.owner
                return (count, target)

        def callable_using_alias_visible_target(annotations: darray[Ast::EnumAnnotation]&, enclosing_module: sview, alias_name: sview) -> (count: usize, target: sview, scope: sview):
            can Abort.Panic:
                scope_module: mutable sview = enclosing_module
                while true |scope_module, annotations, alias_name|:
                    count: mutable usize = 0
                    target: mutable sview = ""
                    alias_scope: mutable sview = ""
                    for alias in annotations |count, target, scope_module, alias_name, annotations|:
                        if alias.name == "__using_alias" and alias.owner == alias_name and alias.module == scope_module:
                            pair: (count: usize, target: sview) = callable_using_alias_target_count(annotations, alias.module, alias.line, alias.offset, alias.owner)
                            count <- count + 1.usize()
                            target <- pair.target if pair.count == 1.usize()
                            alias_scope <- alias.module if pair.count == 1.usize()
                    return (count, target, alias_scope) if count > 0.usize()
                    return (0, "", "") if scope_module == ""
                    scope_module <- try_noncall_module_parent(scope_module)
