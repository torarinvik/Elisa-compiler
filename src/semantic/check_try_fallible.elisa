extend Semantic:
    private:
        const CALLABLE_ERROR_ROW_NONE: u32 = 4294967295
        const FALLIBLE_FUNCTION_NO_OFFSET: u32 = 0
        const FALLIBLE_FUNCTION_NO_LINE: u32 = 0
        const FALLIBLE_FUNCTION_FIRST_POSITION: usize = 0
        const FALLIBLE_FUNCTION_POSITION_STEP: usize = 1
        const FALLIBLE_FUNCTION_SEARCH_DIVISOR: usize = 2

        # A source-order projection of fallible declarations. The generic annotation table is
        # shared by every semantic check; looking up a callee here avoids rescanning unrelated
        # rows for every try or fallback site.
        struct CallableErrorAnnotationIndex:
            heads: mutable dict[u64, u32]
            tails: mutable dict[u64, u32]
            next: mutable darray[u32]
            source_rows: mutable darray[usize]
            extern_line_heads: mutable dict[u64, u32]
            extern_line_tails: mutable dict[u64, u32]
            extern_line_next: mutable darray[u32]
            extern_source_rows: mutable darray[usize]
            ready: mutable bool

        struct TryFallbackExternReturnInfo:
            name: mutable sview @source
            element: mutable sview @source
            has_pointer: mutable bool
            has_optional: mutable bool

        struct FallibleFunctionPosition:
            offset: u32
            line: u32

        # Lazily built only when this file contains a try site. The normal declaration
        # walk emits function symbols in source order; verify that invariant before using
        # predecessor lookup, and retain the linear implementation as a correctness fallback.
        struct FallibleFunctionPositionIndex:
            positions: mutable darray[FallibleFunctionPosition]
            offsets_ordered: mutable bool
            ready: mutable bool

        struct FallibleFunctionModuleIndex:
            by_line: mutable dict[u64, u32]
            by_offset: mutable dict[u64, u32]
            zero_offset_by_line: mutable dict[u64, u32]
            ready: mutable bool

        const TRY_ERROR_SET_ROW_NONE: u32 = 0
        const TRY_ERROR_SET_INDEX_MIN_WORK: usize = 1024

        struct TryErrorSetIndex:
            by_offset_heads: mutable dict[u64, u32]
            by_offset_tails: mutable dict[u64, u32]
            zero_offset_line_heads: mutable dict[u64, u32]
            zero_offset_line_tails: mutable dict[u64, u32]
            next: mutable darray[u32]
            ready: mutable bool

        struct TryErrorFamilyRef:
            family: sview @source
            module: sview @source
            module_known: bool

        struct FallibleTryAnnotationProjection:
            module_annotations: mutable darray[Ast::EnumAnnotation]
            error_set_annotations: mutable darray[Ast::EnumAnnotation]
            error_set_family_paths: mutable darray[Ast::EnumAnnotation]
            try_qualifiers: mutable dict[u64, sview]

        # Error-family facts for lexical bindings while locating a non-call try.
        # The scanner updates assignments in source order and clones this small
        # environment at branch boundaries so sibling scopes cannot leak facts.
        struct TryNonCallErrorFamilyEnv:
            names: mutable darray[sview] = []
            families: mutable darray[sview @source] = []
            catch_payload_families: mutable darray[sview @source] = []
            catch_payload_known_nonfallible: mutable darray[bool] = []
            catch_payload_numeric: mutable darray[bool] = []
            catch_payload_integer: mutable darray[bool] = []
            known_nonfallible: mutable darray[bool] = []
            numeric: mutable darray[bool] = []
            integer: mutable darray[bool] = []
            origins: mutable darray[usize] = []
            type_alias_names: mutable darray[sview] = []
            type_alias_modules: mutable darray[sview] = []
            type_alias_target_names: mutable darray[sview] = []
            type_alias_known_nonfallible: mutable darray[bool] = []
            type_alias_numeric: mutable darray[bool] = []
            type_alias_integer: mutable darray[bool] = []
            non_alias_type_names: mutable darray[sview] = []
            non_alias_type_modules: mutable darray[sview] = []
            callable_names: mutable darray[sview] = []
            callable_modules: mutable darray[sview] = []
            callable_families: mutable darray[sview @source] = []
            callable_facts_known: mutable darray[bool] = []
            callable_return_nonfallible: mutable darray[bool] = []
            callable_numeric: mutable darray[bool] = []
            callable_integer: mutable darray[bool] = []
            callable_generic_return_formal_names: mutable darray[sview @source] = []
            callable_generic_return_formal_indices: mutable darray[usize] = []
            using_alias_names: mutable darray[sview] = []
            using_alias_modules: mutable darray[sview] = []
            using_alias_targets: mutable darray[sview] = []
            callable_wildcard_import_modules: mutable darray[sview] = []
            callable_wildcard_import_scopes: mutable darray[sview] = []
            callable_imported_member_names: mutable darray[sview] = []
            callable_imported_member_modules: mutable darray[sview] = []
            callable_imported_member_scopes: mutable darray[sview] = []
            current_module: sview = ""

        # Assignment snapshots keep only indexes into the pre-assignment environment.
        # This avoids carrying a borrowed family view through a temporary while writing
        # into the longer-lived lexical environment.
        struct TryNonCallAssignmentUpdates:
            names: mutable darray[sview @source] = []
            families: mutable darray[sview @source] = []
            catch_payload_families: mutable darray[sview @source] = []
            catch_payload_known_nonfallible: mutable darray[bool] = []
            catch_payload_numeric: mutable darray[bool] = []
            catch_payload_integer: mutable darray[bool] = []
            known_nonfallible: mutable darray[bool] = []
            numeric: mutable darray[bool] = []
            integer: mutable darray[bool] = []
            origins: mutable darray[usize] = []

        def try_noncall_family_index(environment: TryNonCallErrorFamilyEnv&, name: sview) -> usize:
            can Abort.Panic:
                index: mutable usize = environment.names.count
                while index > 0 |index, environment|:
                    index <- index - 1
                    return index if environment.names[index] == name
                return environment.names.count

        def try_noncall_family_lookup(environment: TryNonCallErrorFamilyEnv&, name: sview) -> sview @source:
            can Abort.Panic:
                index: usize = try_noncall_family_index(environment, name)
                return environment.families[index] if index < environment.names.count
                return ""

        def try_noncall_family_known_nonfallible(environment: TryNonCallErrorFamilyEnv&, name: sview) -> bool:
            can Abort.Panic:
                index: mutable usize = environment.names.count
                while index > 0 |index, environment|:
                    index <- index - 1
                    return environment.known_nonfallible[index] if environment.names[index] == name
                return false

        def try_noncall_family_known_numeric(environment: TryNonCallErrorFamilyEnv&, name: sview) -> bool:
            can Abort.Panic:
                index: usize = try_noncall_family_index(environment, name)
                return environment.numeric[index] if index < environment.names.count
                return false

        def try_noncall_family_known_integer(environment: TryNonCallErrorFamilyEnv&, name: sview) -> bool:
            can Abort.Panic:
                index: usize = try_noncall_family_index(environment, name)
                return environment.integer[index] if index < environment.names.count
                return false

        def try_noncall_family_bind(environment: mutable TryNonCallErrorFamilyEnv&, name: sview, family: sview @source, known_nonfallible: bool = false, numeric: bool = false, integer: bool = false, catch_payload_family: sview @source = "", catch_payload_known_nonfallible: bool = false, catch_payload_numeric: bool = false, catch_payload_integer: bool = false) -> void:
            can Memory.Allocate, Abort.Panic:
                environment.names.push(name)
                environment.families.push(family)
                environment.catch_payload_families.push(catch_payload_family)
                environment.catch_payload_known_nonfallible.push(catch_payload_known_nonfallible)
                environment.catch_payload_numeric.push(catch_payload_numeric)
                environment.catch_payload_integer.push(catch_payload_integer)
                environment.known_nonfallible.push(known_nonfallible)
                environment.numeric.push(numeric)
                environment.integer.push(integer)
                environment.origins.push(environment.names.count - 1)

        def try_noncall_family_bind_with_origin(environment: mutable TryNonCallErrorFamilyEnv&, name: sview, family: sview @source, known_nonfallible: bool, origin: usize, numeric: bool = false, integer: bool = false, catch_payload_family: sview @source = "", catch_payload_known_nonfallible: bool = false, catch_payload_numeric: bool = false, catch_payload_integer: bool = false) -> void:
            can Memory.Allocate, Abort.Panic:
                environment.names.push(name)
                environment.families.push(family)
                environment.catch_payload_families.push(catch_payload_family)
                environment.catch_payload_known_nonfallible.push(catch_payload_known_nonfallible)
                environment.catch_payload_numeric.push(catch_payload_numeric)
                environment.catch_payload_integer.push(catch_payload_integer)
                environment.known_nonfallible.push(known_nonfallible)
                environment.numeric.push(numeric)
                environment.integer.push(integer)
                environment.origins.push(origin)

        def try_noncall_family_clone(environment: TryNonCallErrorFamilyEnv&) -> TryNonCallErrorFamilyEnv:
            can Memory.Allocate, Abort.Panic:
                clone: mutable TryNonCallErrorFamilyEnv = TryNonCallErrorFamilyEnv{current_module: environment.current_module}
                clone.names.extend(environment.names)
                clone.families.extend(environment.families)
                clone.catch_payload_families.extend(environment.catch_payload_families)
                clone.catch_payload_known_nonfallible.extend(environment.catch_payload_known_nonfallible)
                clone.catch_payload_numeric.extend(environment.catch_payload_numeric)
                clone.catch_payload_integer.extend(environment.catch_payload_integer)
                clone.known_nonfallible.extend(environment.known_nonfallible)
                clone.numeric.extend(environment.numeric)
                clone.integer.extend(environment.integer)
                clone.origins.extend(environment.origins)
                clone.type_alias_names.extend(environment.type_alias_names)
                clone.type_alias_modules.extend(environment.type_alias_modules)
                clone.type_alias_target_names.extend(environment.type_alias_target_names)
                clone.type_alias_known_nonfallible.extend(environment.type_alias_known_nonfallible)
                clone.type_alias_numeric.extend(environment.type_alias_numeric)
                clone.type_alias_integer.extend(environment.type_alias_integer)
                clone.non_alias_type_names.extend(environment.non_alias_type_names)
                clone.non_alias_type_modules.extend(environment.non_alias_type_modules)
                clone.callable_names.extend(environment.callable_names)
                clone.callable_modules.extend(environment.callable_modules)
                clone.callable_families.extend(environment.callable_families)
                clone.callable_facts_known.extend(environment.callable_facts_known)
                clone.callable_return_nonfallible.extend(environment.callable_return_nonfallible)
                clone.callable_numeric.extend(environment.callable_numeric)
                clone.callable_integer.extend(environment.callable_integer)
                clone.callable_generic_return_formal_names.extend(environment.callable_generic_return_formal_names)
                clone.callable_generic_return_formal_indices.extend(environment.callable_generic_return_formal_indices)
                clone.using_alias_names.extend(environment.using_alias_names)
                clone.using_alias_modules.extend(environment.using_alias_modules)
                clone.using_alias_targets.extend(environment.using_alias_targets)
                clone.callable_wildcard_import_modules.extend(environment.callable_wildcard_import_modules)
                clone.callable_wildcard_import_scopes.extend(environment.callable_wildcard_import_scopes)
                clone.callable_imported_member_names.extend(environment.callable_imported_member_names)
                clone.callable_imported_member_modules.extend(environment.callable_imported_member_modules)
                clone.callable_imported_member_scopes.extend(environment.callable_imported_member_scopes)
                return clone

        # Branch scans retain the base facts for outer bindings. The only write that
        # preserves an origin is an explicit rebind, and that also preserves its declared
        # family; ordinary `=` creates a branch-local origin. So joining these snapshots
        # only copied borrowed strings back into the outer environment without changing
        # any visible family fact.
        def try_noncall_family_join_into(target: mutable TryNonCallErrorFamilyEnv&, base: TryNonCallErrorFamilyEnv&, left: TryNonCallErrorFamilyEnv&, right: TryNonCallErrorFamilyEnv&, visible_count: usize) -> void:
            can Abort.Panic:
                pass

        def try_noncall_family_branch_wrote(base: TryNonCallErrorFamilyEnv&, branch: TryNonCallErrorFamilyEnv&, name: sview) -> bool:
            can Abort.Panic:
                base_index: usize = try_noncall_family_index(base, name)
                branch_index: usize = try_noncall_family_index(branch, name)
                return false if base_index >= base.names.count or branch_index >= branch.names.count
                return branch_index != base_index and branch.origins[branch_index] == base.origins[base_index]

        def fallible_try_projection_add(projection: mutable FallibleTryAnnotationProjection&, annotation: Ast::EnumAnnotation) -> void:
            can Memory.Allocate, Abort.Panic:
                projection.module_annotations.push(annotation) if annotation.owner == "__fn_module"
                projection.error_set_annotations.push(annotation) if annotation.owner == "__error_set_family"
                projection.error_set_family_paths.push(annotation) if annotation.owner == "__error_set_family_path"
                if annotation.owner == "__try_callee_module":
                    if projection.try_qualifiers.get(annotation.offset.u64()) is existing_qualifier:
                        pass
                    else:
                        projection.try_qualifiers <- projection.try_qualifiers.put(annotation.offset.u64(), annotation.name) can Global{Read,Write}

        def fallible_function_module_index_add(index: mutable FallibleFunctionModuleIndex&, annotation: Ast::EnumAnnotation, row: u32) -> void:
            can Abort.Panic:
                line_key: u64 = annotation.line.u64()
                if index.by_line.get(line_key) is existing_line:
                    pass
                else:
                    index.by_line <- index.by_line.put(line_key, row) can Global{Read,Write}
                if annotation.offset != 0:
                    if index.by_offset.get(annotation.offset.u64()) is existing_offset:
                        pass
                    else:
                        index.by_offset <- index.by_offset.put(annotation.offset.u64(), row) can Global{Read,Write}
                else:
                    if index.zero_offset_by_line.get(line_key) is existing_zero_offset_line:
                        pass
                    else:
                        index.zero_offset_by_line <- index.zero_offset_by_line.put(line_key, row) can Global{Read,Write}

        def fallible_function_module_index_build(index: mutable FallibleFunctionModuleIndex&, module_annotations: darray[Ast::EnumAnnotation]&) -> void:
            can Memory.Allocate, Abort.Panic:
                return if index.ready
                for row in 0..<module_annotations.count |row, index, module_annotations|:
                    fallible_function_module_index_add(index, module_annotations[row], row.u32()) can Global{Read,Write}
                index.ready <- true

        def try_error_set_index_build(index: mutable TryErrorSetIndex&, error_set_annotations: darray[Ast::EnumAnnotation]&) -> void:
            can Memory.Allocate, Abort.Panic:
                return if index.ready
                for row in 0..<error_set_annotations.count |row, index, error_set_annotations|:
                    annotation: Ast::EnumAnnotation = error_set_annotations[row]
                    row_id: u32 = (row + 1.usize()).u32()
                    index.next <- index.next.push(TRY_ERROR_SET_ROW_NONE)
                    line_key: u64 = annotation.line.u64()
                    if annotation.offset != 0:
                        offset_key: u64 = annotation.offset.u64()
                        if index.by_offset_tails.get(offset_key) is previous_offset_row:
                            index.next[previous_offset_row.usize() - 1.usize()] <- row_id
                        else:
                            index.by_offset_heads <- index.by_offset_heads.put(offset_key, row_id) can Global{Read,Write}
                        index.by_offset_tails <- index.by_offset_tails.put(offset_key, row_id) can Global{Read,Write}
                    else:
                        if index.zero_offset_line_tails.get(line_key) is previous_zero_line_row:
                            index.next[previous_zero_line_row.usize() - 1.usize()] <- row_id
                        else:
                            index.zero_offset_line_heads <- index.zero_offset_line_heads.put(line_key, row_id) can Global{Read,Write}
                        index.zero_offset_line_tails <- index.zero_offset_line_tails.put(line_key, row_id) can Global{Read,Write}
                index.ready <- true

        # Return projected row indices so callers can keep each family paired with its
        # adjacent source-backed __error_set_family_path row.
        def try_error_set_destinations(index: TryErrorSetIndex&, error_set_annotations: darray[Ast::EnumAnnotation]&, declaration_offset: u32, declaration_line: u32) -> darray[usize]:
            can Memory.Allocate, Abort.Panic, Global.Read:
                destinations: mutable darray[usize] = []
                if declaration_offset == 0:
                    for row_index in 0..<error_set_annotations.count |destinations, error_set_annotations|:
                        destinations.push(row_index) if error_set_annotations[row_index].line == declaration_line
                    return destinations
                offset_row: mutable u32 = TRY_ERROR_SET_ROW_NONE
                zero_offset_line_row: mutable u32 = TRY_ERROR_SET_ROW_NONE
                if index.by_offset_heads.get(declaration_offset.u64()) is first_offset_row:
                    offset_row <- first_offset_row
                if index.zero_offset_line_heads.get(declaration_line.u64()) is first_zero_line_row:
                    zero_offset_line_row <- first_zero_line_row
                while offset_row != TRY_ERROR_SET_ROW_NONE or zero_offset_line_row != TRY_ERROR_SET_ROW_NONE |offset_row, zero_offset_line_row, index, error_set_annotations, destinations|:
                    if zero_offset_line_row == TRY_ERROR_SET_ROW_NONE or (offset_row != TRY_ERROR_SET_ROW_NONE and offset_row < zero_offset_line_row):
                        row_index: usize = offset_row.usize() - 1.usize()
                        destinations <- destinations.push(row_index)
                        offset_row <- (index.next can Global.Read)[row_index]
                    else:
                        row_index: usize = zero_offset_line_row.usize() - 1.usize()
                        destinations <- destinations.push(row_index)
                        zero_offset_line_row <- (index.next can Global.Read)[row_index]
                return destinations

        def callable_error_extern_line_head(index: CallableErrorAnnotationIndex&, line: u32) -> u32:
            can Abort.Panic:
                return head if index.extern_line_heads.get(line.u64()) is head else CALLABLE_ERROR_ROW_NONE

        def callable_error_extern_line_tail(index: CallableErrorAnnotationIndex&, line: u32) -> u32:
            can Abort.Panic:
                return tail_row if index.extern_line_tails.get(line.u64()) is tail_row else CALLABLE_ERROR_ROW_NONE

        def callable_error_index_head(index: CallableErrorAnnotationIndex&, owner: sview) -> u32:
            can Abort.Panic:
                return head if index.heads.get(name_hash(owner)) is head else CALLABLE_ERROR_ROW_NONE

        def callable_error_index_tail(index: CallableErrorAnnotationIndex&, owner: sview) -> u32:
            can Abort.Panic:
                return tail_row if index.tails.get(name_hash(owner)) is tail_row else CALLABLE_ERROR_ROW_NONE

        # The parser emits a fallible family row immediately after its marker.
        # The projection needs only those rows, not every annotation owned by a
        # fallible callable.
        def callable_error_family_row(annotations: darray[Ast::EnumAnnotation]&, source_row: usize) -> bool can[Abort.Panic]:
            return false if source_row == 0 or source_row >= annotations.count
            family: Ast::EnumAnnotation = annotations[source_row]
            marker: Ast::EnumAnnotation = annotations[source_row - 1]
            return marker.name == "__error_return" and marker.owner == family.owner and marker.line == family.line and marker.offset == family.offset and marker.identity_id == family.identity_id

        def callable_error_index_build(annotations: darray[Ast::EnumAnnotation]&, index: mutable CallableErrorAnnotationIndex&, include_extern_rows: bool) -> void:
            can Memory.Allocate, Abort.Panic:
                for source_row in 0..<annotations.count |source_row, annotations, index|:
                    annotation: Ast::EnumAnnotation = annotations[source_row]
                    if include_extern_rows and (annotation.owner == "__extern_return" or annotation.name == "__extern_return_darray_elem" or annotation.owner == "__extern_return_ptr" or annotation.owner == "__extern_return_optional"):
                        extern_row: u32 = index.extern_source_rows.count.u32()
                        index.extern_source_rows <- index.extern_source_rows.push(source_row)
                        index.extern_line_next <- index.extern_line_next.push(CALLABLE_ERROR_ROW_NONE)
                        previous_extern_row: u32 = callable_error_extern_line_tail(index, annotation.line)
                        if previous_extern_row != CALLABLE_ERROR_ROW_NONE:
                            index.extern_line_next[previous_extern_row.usize()] <- extern_row
                        else:
                            index.extern_line_heads <- index.extern_line_heads.put(annotation.line.u64(), extern_row) can Global{Read,Write}
                        index.extern_line_tails <- index.extern_line_tails.put(annotation.line.u64(), extern_row) can Global{Read,Write}
                    owner: sview = annotation.owner
                    continue if owner == ""
                    if annotation.name != "__error_return":
                        continue if not callable_error_family_row(annotations, source_row)
                    previous: u32 = callable_error_index_tail(index, owner)
                    row: u32 = index.next.count.u32()
                    index.next <- index.next.push(CALLABLE_ERROR_ROW_NONE)
                    index.source_rows <- index.source_rows.push(source_row)
                    if previous != CALLABLE_ERROR_ROW_NONE:
                        index.next[previous.usize()] <- row
                    else:
                        index.heads <- index.heads.put(name_hash(owner), row) can Global{Read,Write}
                    index.tails <- index.tails.put(name_hash(owner), row) can Global{Read,Write}
                index.ready <- true

        def callable_error_indexed_returns_error(index: CallableErrorAnnotationIndex&, annotations: darray[Ast::EnumAnnotation]&, module_index: FallibleFunctionModuleIndex&, module_annotations: darray[Ast::EnumAnnotation]&, name: sview, enclosing_module: sview, callee_qualifier: sview, scope_known: bool) -> bool:
            can Abort.Panic:
                saw_error_return: mutable bool = false
                row: mutable u32 = callable_error_index_head(index, name)
                while row != CALLABLE_ERROR_ROW_NONE |row, saw_error_return, annotations, module_annotations, name, enclosing_module, callee_qualifier|:
                    annotation: Ast::EnumAnnotation = annotations[index.source_rows[row.usize()]]
                    if annotation.owner == name and annotation.name == "__error_return":
                        saw_error_return <- true
                        return true if:
                            not scope_known
                            callable_row_in_scope_indexed(module_index, module_annotations, annotations, annotation.offset, annotation.line, enclosing_module, callee_qualifier)
                    row <- index.next[row.usize()]
                return false if scope_known
                return saw_error_return

        # Parser producers emit the declared family immediately after its
        # __error_return row, with the same declaration identity. Other rows
        # owned by a callable (contracts, try sites) are not error families.
        def callable_error_indexed_family(index: CallableErrorAnnotationIndex&, annotations: darray[Ast::EnumAnnotation]&, module_index: FallibleFunctionModuleIndex&, module_annotations: darray[Ast::EnumAnnotation]&, name: sview, enclosing_module: sview, callee_qualifier: sview, scope_known: bool) -> sview @source:
            can Abort.Panic:
                fallback: mutable sview @source = ""
                fallback_found: mutable bool = false
                row: mutable u32 = callable_error_index_head(index, name)
                while row != CALLABLE_ERROR_ROW_NONE |row, annotations, module_annotations, name, enclosing_module, callee_qualifier, fallback, fallback_found|:
                    annotation: Ast::EnumAnnotation = annotations[index.source_rows[row.usize()]]
                    if annotation.owner == name and callable_error_family_row(annotations, index.source_rows[row.usize()]):
                        if not fallback_found and not scope_known:
                            fallback <- annotation.name
                            fallback_found <- true
                        return annotation.name if callable_row_in_scope_indexed(module_index, module_annotations, annotations, annotation.offset, annotation.line, enclosing_module, callee_qualifier)
                    row <- index.next[row.usize()]
                return "" if scope_known
                return fallback

        def callable_error_indexed_family_ref(index: CallableErrorAnnotationIndex&, annotations: darray[Ast::EnumAnnotation]&, module_index: FallibleFunctionModuleIndex&, module_annotations: darray[Ast::EnumAnnotation]&, name: sview, enclosing_module: sview, callee_qualifier: sview, scope_known: bool, table: SymbolTable&) -> TryErrorFamilyRef:
            can Abort.Panic:
                fallback: mutable TryErrorFamilyRef = TryErrorFamilyRef{family: "", module: "", module_known: false}
                fallback_found: mutable bool = false
                row: mutable u32 = callable_error_index_head(index, name)
                while row != CALLABLE_ERROR_ROW_NONE |row, fallback, fallback_found, annotations, module_annotations, module_index, table, name, enclosing_module, callee_qualifier|:
                    source_row: usize = index.source_rows[row.usize()]
                    annotation: Ast::EnumAnnotation = annotations[source_row]
                    if annotation.owner == name and callable_error_family_row(annotations, source_row):
                        family_path: sview = try_error_family_path_for_declaration(annotations, annotation.name, annotation.line, annotation.offset, annotation.identity_id)
                        candidate_module: sview = fallible_fn_module_indexed(module_index, module_annotations, annotation.offset, annotation.line)
                        candidate_module_known: bool = fallible_fn_module_known(module_annotations, annotation.offset, annotation.line)
                        family_ref: TryErrorFamilyRef = try_error_family_ref_for_annotation(annotations, annotation, family_path, candidate_module_known, candidate_module, table)
                        if not fallback_found:
                            fallback <- family_ref
                            fallback_found <- true
                        if callable_row_in_scope_indexed(module_index, module_annotations, annotations, annotation.offset, annotation.line, enclosing_module, callee_qualifier):
                            return family_ref
                    row <- index.next[row.usize()]
                return TryErrorFamilyRef{family: "", module: "", module_known: false} if scope_known
                return fallback

        # The module a fallible function was declared in, keyed by the declaration's byte
        # offset (the same key the destination side already uses).
        # Matched by OFFSET when both sides carry one and by LINE otherwise — the same rule
        # the destination (`__error_set_family`) lookup uses. Offset alone silently missed
        # every enclosing function the symbol table recorded without one.
        def fallible_fn_module(annotations: darray[Ast::EnumAnnotation]&, declaration_offset: u32, declaration_line: u32) -> sview:
            for module_annotation in annotations |declaration_offset, declaration_line|:
                if module_annotation.owner == "__fn_module":
                    matched: bool = module_annotation.offset == declaration_offset if declaration_offset != 0 and module_annotation.offset != 0 else module_annotation.line == declaration_line
                    return module_annotation.name if matched
            return ""

        def fallible_fn_module_indexed(index: FallibleFunctionModuleIndex&, module_annotations: darray[Ast::EnumAnnotation]&, declaration_offset: u32, declaration_line: u32) -> sview:
            can Abort.Panic:
                if declaration_offset == 0:
                    return module_annotations[row.usize()].name if index.by_line.get(declaration_line.u64()) is row
                    return ""
                offset_row: mutable u32 = CALLABLE_ERROR_ROW_NONE
                zero_offset_line_row: mutable u32 = CALLABLE_ERROR_ROW_NONE
                if index.by_offset.get(declaration_offset.u64()) is found_offset_row:
                    offset_row <- found_offset_row
                if index.zero_offset_by_line.get(declaration_line.u64()) is found_zero_line_row:
                    zero_offset_line_row <- found_zero_line_row
                if offset_row == CALLABLE_ERROR_ROW_NONE:
                    return module_annotations[zero_offset_line_row.usize()].name if zero_offset_line_row != CALLABLE_ERROR_ROW_NONE
                    return ""
                if zero_offset_line_row == CALLABLE_ERROR_ROW_NONE or offset_row < zero_offset_line_row:
                    return module_annotations[offset_row.usize()].name
                return module_annotations[zero_offset_line_row.usize()].name

        def fallible_fn_module_known(module_annotations: darray[Ast::EnumAnnotation]&, declaration_offset: u32, declaration_line: u32) -> bool:
            can Abort.Panic:
                for module_annotation in module_annotations |declaration_offset, declaration_line|:
                    continue if module_annotation.owner != "__fn_module"
                    matched: bool = module_annotation.offset == declaration_offset if declaration_offset != 0 and module_annotation.offset != 0 else module_annotation.line == declaration_line
                    return true if matched
                return false

        def try_error_family_ref_for_annotation(annotations: darray[Ast::EnumAnnotation]&, family_annotation: Ast::EnumAnnotation, family_path: sview @source, function_module_known: bool, function_module: sview @source, table: SymbolTable&) -> TryErrorFamilyRef:
            can Abort.Panic:
                resolved: (known: bool, module: sview @source) = catch_error_family_module_for_declaration(annotations, family_annotation.line, family_annotation.offset, family_annotation.identity_id, family_annotation.name, family_path, function_module_known, function_module, table)
                return TryErrorFamilyRef{family: family_annotation.name, module: resolved.module, module_known: resolved.known}

        # The callable index points at the compact __error_return/name pair, while the
        # source-backed family path is emitted later by capture_header_error_families.
        # Join the rows by declaration identity and family leaf, then keep the adjacent path.
        def try_error_family_path_for_declaration(annotations: darray[Ast::EnumAnnotation]&, family: sview, declaration_line: u32, declaration_offset: u32, declaration_identity_id: u32) -> sview @source:
            can Abort.Panic:
                for family_index in 0..<annotations.count |annotations, family, declaration_line, declaration_offset, declaration_identity_id|:
                    family_annotation: Ast::EnumAnnotation = annotations[family_index]
                    continue if family_annotation.owner != "__error_set_family" or family_annotation.name != family or family_annotation.line != declaration_line
                    continue if declaration_offset != 0 and family_annotation.offset != declaration_offset
                    continue if declaration_identity_id != 0 and family_annotation.identity_id != declaration_identity_id
                    continue if family_index + 1.usize() >= annotations.count
                    path_annotation: Ast::EnumAnnotation = annotations[family_index + 1.usize()]
                    return path_annotation.name if path_annotation.owner == "__error_set_family_path" and path_annotation.line == family_annotation.line and path_annotation.offset == family_annotation.offset and path_annotation.identity_id == family_annotation.identity_id
                return ""

        # The LAST `::` segment of a module path (`WasmBrowser::Delivery` -> `Delivery`), so a
        # qualified call's written qualifier can be compared without rebuilding the spelling.
        def module_last_segment(module_name: sview) -> sview:
            can Abort.Panic:
                cut: mutable usize = 0
                start: mutable usize = 0
                while cut + 1.usize() < module_name.len |cut, start|:
                    start <- cut + 2.usize() if module_name[cut] == 58 and module_name[cut + 1.usize()] == 58
                    cut <- cut + 1.usize()
                return module_name[start:module_name.len]

        def try_noncall_module_path(parent: sview, child: sview @source, table: mutable SymbolTable&) -> sview @source:
            can Memory.Allocate, Abort.Panic:
                return child if parent == "" or module_path_has_scope_separator(child)
                bytes: mutable darray[u8] = []
                bytes.reserve(parent.len + 2.usize() + child.len)
                for offset in 0..<parent.len |bytes, parent|:
                    bytes.push(parent[offset])
                bytes.push(58)
                bytes.push(58)
                for offset in 0..<child.len |bytes, child|:
                    bytes.push(child[offset])
                return intern_joined_text(bytes, table)

        def try_noncall_module_parent(module_path: sview) -> sview:
            can Abort.Panic:
                separator: mutable usize = module_path.len
                offset: mutable usize = 0
                while offset + 1.usize() < module_path.len |separator, offset|:
                    separator <- offset if module_path[offset] == 58 and module_path[offset + 1.usize()] == 58
                    offset <- offset + 1.usize()
                return "" if separator == module_path.len
                return module_path[0:separator]

        def try_noncall_module_is_ancestor(ancestor: sview, module_path: sview) -> bool:
            can Abort.Panic:
                return true if ancestor == "" or ancestor == module_path
                return false if module_path.len <= ancestor.len + 1.usize()
                return false if module_path[0:ancestor.len] != ancestor
                return module_path[ancestor.len] == 58 and module_path[ancestor.len + 1.usize()] == 58

        def module_path_has_scope_separator(module_name: sview) -> bool:
            for offset in 0..<module_name.len:
                return true if offset + 1.usize() < module_name.len and module_name[offset] == 58 and module_name[offset + 1.usize()] == 58
            return false

        # Does this candidate row belong to the module the call resolves to? An explicit
        # qualifier (`Mods::B::step`) names it; a bare call means the ENCLOSING module.
        def callable_row_in_scope(module_annotations: darray[Ast::EnumAnnotation]&, declaration_offset: u32, declaration_line: u32, enclosing_module: sview, callee_qualifier: sview) -> bool:
            can Abort.Panic:
                candidate_module: sview = fallible_fn_module(module_annotations, declaration_offset, declaration_line)
                return module_last_segment(candidate_module) == callee_qualifier if callee_qualifier != ""
                return candidate_module == enclosing_module

        def callable_using_alias_target_count(annotations: darray[Ast::EnumAnnotation]&, alias_module: sview, alias_line: u32, alias_offset: u32, alias_name: sview) -> (count: usize, target: sview):
            can Abort.Panic:
                count: mutable usize = 0
                target: mutable sview = ""
                for row in annotations |count, target, alias_module, alias_line, alias_offset, alias_name|:
                    if row.name == "__using_alias_target" and row.module == alias_module and row.line == alias_line and row.offset == alias_offset:
                        paired_alias: mutable bool = false
                        for alias in annotations |paired_alias, alias_module, alias_line, alias_offset, alias_name, row|:
                            paired_alias <- true if alias.name == "__using_alias" and alias.owner == alias_name and alias.module == alias_module and alias.line == alias_line and alias.offset == alias_offset
                        if paired_alias:
                            count <- count + 1.usize()
                            target <- row.owner
                return (count, target)

        def callable_using_alias_visible_target(annotations: darray[Ast::EnumAnnotation]&, enclosing_module: sview, alias_name: sview) -> (count: usize, target: sview):
            can Abort.Panic:
                scope_module: mutable sview = enclosing_module
                while true |scope_module, annotations, alias_name|:
                    count: mutable usize = 0
                    target: mutable sview = ""
                    for alias in annotations |count, target, scope_module, alias_name, annotations|:
                        if alias.name == "__using_alias" and alias.owner == alias_name and alias.module == scope_module:
                            pair: (count: usize, target: sview) = callable_using_alias_target_count(annotations, alias.module, alias.line, alias.offset, alias.owner)
                            count <- count + 1.usize()
                            target <- pair.target if pair.count == 1.usize()
                    return (count, target) if count > 0.usize()
                    return (0, "") if scope_module == ""
                    scope_module <- try_noncall_module_parent(scope_module)
