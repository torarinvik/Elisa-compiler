extend Semantic:
    private:
        def callable_returns_error(annotations: darray[Ast::EnumAnnotation]&, name: sview) -> bool:
            for annotation in annotations:
                true return if annotation.owner == name and annotation.name == "__error_return"
            return false

        def check_try_fallible_rows(annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for annotation in annotations |table|:
                    if annotation.name == "__try_without_else" and annotation.owner != "__unknown_call" and not callable_returns_error(annotations, annotation.owner):
                        return_type_id: u32 = function_return_type_id(table, annotation.owner)
                        reason: sview = "optional" if interned_kind(return_type_id, table) == TypeKind.Optional else "nonfallible"
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.TryRequiresFallible, name: annotation.owner, line: annotation.line, expected: reason, actual: ""})

    public:
        def check_try_fallible(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- check_try_fallible_rows(file.enum_annotations, table)
