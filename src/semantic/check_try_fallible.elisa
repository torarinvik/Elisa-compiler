extend Semantic:
    private:
        const CALLABLE_ERROR_ROW_NONE: u32 = 4294967295
        const FALLIBLE_FUNCTION_NO_OFFSET: u32 = 0
        const FALLIBLE_FUNCTION_NO_LINE: u32 = 0
        const FALLIBLE_FUNCTION_FIRST_POSITION: usize = 0
        const FALLIBLE_FUNCTION_POSITION_STEP: usize = 1
        const FALLIBLE_FUNCTION_SEARCH_DIVISOR: usize = 2

        # A source-order projection of fallible declarations. The generic annotation table is
        # shared by every semantic check; looking up a callee here avoids rescanning unrelated
        # rows for every try or fallback site.
        struct CallableErrorAnnotationIndex:
            heads: mutable dict[u64, u32]
            tails: mutable dict[u64, u32]
            next: mutable darray[u32]
            source_rows: mutable darray[usize]
            extern_line_heads: mutable dict[u64, u32]
            extern_line_tails: mutable dict[u64, u32]
            extern_line_next: mutable darray[u32]
            extern_source_rows: mutable darray[usize]
            ready: mutable bool

        struct TryFallbackExternReturnInfo:
            name: mutable sview @source
            element: mutable sview @source
            has_pointer: mutable bool
            has_optional: mutable bool

        struct FallibleFunctionPosition:
            offset: u32
            line: u32

        # Lazily built only when this file contains a try site. The normal declaration
        # walk emits function symbols in source order; verify that invariant before using
        # predecessor lookup, and retain the linear implementation as a correctness fallback.
        struct FallibleFunctionPositionIndex:
            positions: mutable darray[FallibleFunctionPosition]
            offsets_ordered: mutable bool
            ready: mutable bool

        struct FallibleFunctionModuleIndex:
            by_line: mutable dict[u64, u32]
            by_offset: mutable dict[u64, u32]
            zero_offset_by_line: mutable dict[u64, u32]
            ready: mutable bool

        const TRY_ERROR_SET_ROW_NONE: u32 = 0
        const TRY_ERROR_SET_INDEX_MIN_WORK: usize = 1024

        struct TryErrorSetIndex:
            by_offset_heads: mutable dict[u64, u32]
            by_offset_tails: mutable dict[u64, u32]
            zero_offset_line_heads: mutable dict[u64, u32]
            zero_offset_line_tails: mutable dict[u64, u32]
            next: mutable darray[u32]
            ready: mutable bool

        struct FallibleTryAnnotationProjection:
            module_annotations: mutable darray[Ast::EnumAnnotation]
            error_set_annotations: mutable darray[Ast::EnumAnnotation]
            try_qualifiers: mutable dict[u64, sview]

        # Error-family facts for lexical bindings while locating a non-call try.
        # The scanner updates assignments in source order and clones this small
        # environment at branch boundaries so sibling scopes cannot leak facts.
        struct TryNonCallErrorFamilyEnv:
            names: mutable darray[sview] = []
            families: mutable darray[sview @source] = []
            known_nonfallible: mutable darray[bool] = []
            numeric: mutable darray[bool] = []
            integer: mutable darray[bool] = []
            origins: mutable darray[usize] = []
            type_alias_names: mutable darray[sview] = []
            type_alias_modules: mutable darray[sview] = []
            type_alias_target_names: mutable darray[sview] = []
            type_alias_known_nonfallible: mutable darray[bool] = []
            type_alias_numeric: mutable darray[bool] = []
            type_alias_integer: mutable darray[bool] = []
            non_alias_type_names: mutable darray[sview] = []
            non_alias_type_modules: mutable darray[sview] = []
            callable_names: mutable darray[sview] = []
            callable_modules: mutable darray[sview] = []
            callable_families: mutable darray[sview @source] = []
            callable_facts_known: mutable darray[bool] = []
            callable_numeric: mutable darray[bool] = []
            callable_integer: mutable darray[bool] = []
            using_alias_names: mutable darray[sview] = []
            using_alias_modules: mutable darray[sview] = []
            using_alias_targets: mutable darray[sview] = []
            current_module: sview = ""

        def try_noncall_family_index(environment: TryNonCallErrorFamilyEnv&, name: sview) -> usize:
            can Abort.Panic:
                index: mutable usize = environment.names.count
                while index > 0 |index, environment|:
                    index <- index - 1
                    return index if environment.names[index] == name
                return environment.names.count

        def try_noncall_family_lookup(environment: TryNonCallErrorFamilyEnv&, name: sview) -> sview @source:
            can Abort.Panic:
                index: usize = try_noncall_family_index(environment, name)
                return environment.families[index] if index < environment.names.count
                return ""

        def try_noncall_family_known_nonfallible(environment: TryNonCallErrorFamilyEnv&, name: sview) -> bool:
            can Abort.Panic:
                index: mutable usize = environment.names.count
                while index > 0 |index, environment|:
                    index <- index - 1
                    return environment.known_nonfallible[index] if environment.names[index] == name
                return false

        def try_noncall_family_known_numeric(environment: TryNonCallErrorFamilyEnv&, name: sview) -> bool:
            can Abort.Panic:
                index: usize = try_noncall_family_index(environment, name)
                return environment.numeric[index] if index < environment.names.count
                return false

        def try_noncall_family_known_integer(environment: TryNonCallErrorFamilyEnv&, name: sview) -> bool:
            can Abort.Panic:
                index: usize = try_noncall_family_index(environment, name)
                return environment.integer[index] if index < environment.names.count
                return false

        def try_noncall_family_bind(environment: mutable TryNonCallErrorFamilyEnv&, name: sview, family: sview @source, known_nonfallible: bool = false, numeric: bool = false, integer: bool = false) -> void:
            can Memory.Allocate, Abort.Panic:
                environment.names.push(name)
                environment.families.push(family)
                environment.known_nonfallible.push(known_nonfallible)
                environment.numeric.push(numeric)
                environment.integer.push(integer)
                environment.origins.push(environment.names.count - 1)

        def try_noncall_family_bind_with_origin(environment: mutable TryNonCallErrorFamilyEnv&, name: sview, family: sview @source, known_nonfallible: bool, origin: usize, numeric: bool = false, integer: bool = false) -> void:
            can Memory.Allocate, Abort.Panic:
                environment.names.push(name)
                environment.families.push(family)
                environment.known_nonfallible.push(known_nonfallible)
                environment.numeric.push(numeric)
                environment.integer.push(integer)
                environment.origins.push(origin)

        def try_noncall_family_clone(environment: TryNonCallErrorFamilyEnv&) -> TryNonCallErrorFamilyEnv:
            can Memory.Allocate, Abort.Panic:
                clone: mutable TryNonCallErrorFamilyEnv = TryNonCallErrorFamilyEnv{current_module: environment.current_module}
                clone.names.extend(environment.names)
                clone.families.extend(environment.families)
                clone.known_nonfallible.extend(environment.known_nonfallible)
                clone.numeric.extend(environment.numeric)
                clone.integer.extend(environment.integer)
                clone.origins.extend(environment.origins)
                clone.type_alias_names.extend(environment.type_alias_names)
                clone.type_alias_modules.extend(environment.type_alias_modules)
                clone.type_alias_target_names.extend(environment.type_alias_target_names)
                clone.type_alias_known_nonfallible.extend(environment.type_alias_known_nonfallible)
                clone.type_alias_numeric.extend(environment.type_alias_numeric)
                clone.type_alias_integer.extend(environment.type_alias_integer)
                clone.non_alias_type_names.extend(environment.non_alias_type_names)
                clone.non_alias_type_modules.extend(environment.non_alias_type_modules)
                clone.callable_names.extend(environment.callable_names)
                clone.callable_modules.extend(environment.callable_modules)
                clone.callable_families.extend(environment.callable_families)
                clone.callable_facts_known.extend(environment.callable_facts_known)
                clone.callable_numeric.extend(environment.callable_numeric)
                clone.callable_integer.extend(environment.callable_integer)
                clone.using_alias_names.extend(environment.using_alias_names)
                clone.using_alias_modules.extend(environment.using_alias_modules)
                clone.using_alias_targets.extend(environment.using_alias_targets)
                return clone

        # Branch scans retain the base facts for outer bindings. The only write that
        # preserves an origin is an explicit rebind, and that also preserves its declared
        # family; ordinary `=` creates a branch-local origin. So joining these snapshots
        # only copied borrowed strings back into the outer environment without changing
        # any visible family fact.
        def try_noncall_family_join_into(target: mutable TryNonCallErrorFamilyEnv&, base: TryNonCallErrorFamilyEnv&, left: TryNonCallErrorFamilyEnv&, right: TryNonCallErrorFamilyEnv&, visible_count: usize) -> void:
            can Abort.Panic:
                pass

        def try_noncall_family_branch_wrote(base: TryNonCallErrorFamilyEnv&, branch: TryNonCallErrorFamilyEnv&, name: sview) -> bool:
            can Abort.Panic:
                base_index: usize = try_noncall_family_index(base, name)
                branch_index: usize = try_noncall_family_index(branch, name)
                return false if base_index >= base.names.count or branch_index >= branch.names.count
                return branch_index != base_index and branch.origins[branch_index] == base.origins[base_index]

        def fallible_try_projection_add(projection: mutable FallibleTryAnnotationProjection&, annotation: Ast::EnumAnnotation) -> void:
            can Memory.Allocate, Abort.Panic:
                projection.module_annotations.push(annotation) if annotation.owner == "__fn_module"
                projection.error_set_annotations.push(annotation) if annotation.owner == "__error_set_family"
                if annotation.owner == "__try_callee_module":
                    if projection.try_qualifiers.get(annotation.offset.u64()) is existing_qualifier:
                        pass
                    else:
                        projection.try_qualifiers <- projection.try_qualifiers.put(annotation.offset.u64(), annotation.name) can Global{Read,Write}

        def fallible_function_module_index_add(index: mutable FallibleFunctionModuleIndex&, annotation: Ast::EnumAnnotation, row: u32) -> void:
            can Abort.Panic:
                line_key: u64 = annotation.line.u64()
                if index.by_line.get(line_key) is existing_line:
                    pass
                else:
                    index.by_line <- index.by_line.put(line_key, row) can Global{Read,Write}
                if annotation.offset != 0:
                    if index.by_offset.get(annotation.offset.u64()) is existing_offset:
                        pass
                    else:
                        index.by_offset <- index.by_offset.put(annotation.offset.u64(), row) can Global{Read,Write}
                else:
                    if index.zero_offset_by_line.get(line_key) is existing_zero_offset_line:
                        pass
                    else:
                        index.zero_offset_by_line <- index.zero_offset_by_line.put(line_key, row) can Global{Read,Write}

        def fallible_function_module_index_build(index: mutable FallibleFunctionModuleIndex&, module_annotations: darray[Ast::EnumAnnotation]&) -> void:
            can Memory.Allocate, Abort.Panic:
                return if index.ready
                for row in 0..<module_annotations.count |row, index, module_annotations|:
                    fallible_function_module_index_add(index, module_annotations[row], row.u32()) can Global{Read,Write}
                index.ready <- true

        def try_error_set_index_build(index: mutable TryErrorSetIndex&, error_set_annotations: darray[Ast::EnumAnnotation]&) -> void:
            can Memory.Allocate, Abort.Panic:
                return if index.ready
                for row in 0..<error_set_annotations.count |row, index, error_set_annotations|:
                    annotation: Ast::EnumAnnotation = error_set_annotations[row]
                    row_id: u32 = (row + 1.usize()).u32()
                    index.next <- index.next.push(TRY_ERROR_SET_ROW_NONE)
                    line_key: u64 = annotation.line.u64()
                    if annotation.offset != 0:
                        offset_key: u64 = annotation.offset.u64()
                        if index.by_offset_tails.get(offset_key) is previous_offset_row:
                            index.next[previous_offset_row.usize() - 1.usize()] <- row_id
                        else:
                            index.by_offset_heads <- index.by_offset_heads.put(offset_key, row_id) can Global{Read,Write}
                        index.by_offset_tails <- index.by_offset_tails.put(offset_key, row_id) can Global{Read,Write}
                    else:
                        if index.zero_offset_line_tails.get(line_key) is previous_zero_line_row:
                            index.next[previous_zero_line_row.usize() - 1.usize()] <- row_id
                        else:
                            index.zero_offset_line_heads <- index.zero_offset_line_heads.put(line_key, row_id) can Global{Read,Write}
                        index.zero_offset_line_tails <- index.zero_offset_line_tails.put(line_key, row_id) can Global{Read,Write}
                index.ready <- true

        def try_error_set_destinations(index: TryErrorSetIndex&, error_set_annotations: darray[Ast::EnumAnnotation]&, declaration_offset: u32, declaration_line: u32) -> darray[sview]:
            can Memory.Allocate, Abort.Panic, Global.Read:
                destinations: mutable darray[sview] = []
                if declaration_offset == 0:
                    destinations.extend([destination_row.name for destination_row in error_set_annotations if destination_row.line == declaration_line])
                    return destinations
                offset_row: mutable u32 = TRY_ERROR_SET_ROW_NONE
                zero_offset_line_row: mutable u32 = TRY_ERROR_SET_ROW_NONE
                if index.by_offset_heads.get(declaration_offset.u64()) is first_offset_row:
                    offset_row <- first_offset_row
                if index.zero_offset_line_heads.get(declaration_line.u64()) is first_zero_line_row:
                    zero_offset_line_row <- first_zero_line_row
                while offset_row != TRY_ERROR_SET_ROW_NONE or zero_offset_line_row != TRY_ERROR_SET_ROW_NONE |offset_row, zero_offset_line_row, index, error_set_annotations, destinations|:
                    if zero_offset_line_row == TRY_ERROR_SET_ROW_NONE or (offset_row != TRY_ERROR_SET_ROW_NONE and offset_row < zero_offset_line_row):
                        row_index: usize = offset_row.usize() - 1.usize()
                        destinations <- destinations.push(error_set_annotations[row_index].name)
                        offset_row <- (index.next can Global.Read)[row_index]
                    else:
                        row_index: usize = zero_offset_line_row.usize() - 1.usize()
                        destinations <- destinations.push(error_set_annotations[row_index].name)
                        zero_offset_line_row <- (index.next can Global.Read)[row_index]
                return destinations

        def callable_error_extern_line_head(index: CallableErrorAnnotationIndex&, line: u32) -> u32:
            can Abort.Panic:
                return head if index.extern_line_heads.get(line.u64()) is head else CALLABLE_ERROR_ROW_NONE

        def callable_error_extern_line_tail(index: CallableErrorAnnotationIndex&, line: u32) -> u32:
            can Abort.Panic:
                return tail_row if index.extern_line_tails.get(line.u64()) is tail_row else CALLABLE_ERROR_ROW_NONE

        def callable_error_index_head(index: CallableErrorAnnotationIndex&, owner: sview) -> u32:
            can Abort.Panic:
                return head if index.heads.get(name_hash(owner)) is head else CALLABLE_ERROR_ROW_NONE

        def callable_error_index_tail(index: CallableErrorAnnotationIndex&, owner: sview) -> u32:
            can Abort.Panic:
                return tail_row if index.tails.get(name_hash(owner)) is tail_row else CALLABLE_ERROR_ROW_NONE

        # The parser emits a fallible family row immediately after its marker.
        # The projection needs only those rows, not every annotation owned by a
        # fallible callable.
        def callable_error_family_row(annotations: darray[Ast::EnumAnnotation]&, source_row: usize) -> bool can[Abort.Panic]:
            return false if source_row == 0 or source_row >= annotations.count
            family: Ast::EnumAnnotation = annotations[source_row]
            marker: Ast::EnumAnnotation = annotations[source_row - 1]
            return marker.name == "__error_return" and marker.owner == family.owner and marker.line == family.line and marker.offset == family.offset and marker.identity_id == family.identity_id

        def callable_error_index_build(annotations: darray[Ast::EnumAnnotation]&, index: mutable CallableErrorAnnotationIndex&, include_extern_rows: bool) -> void:
            can Memory.Allocate, Abort.Panic:
                for source_row in 0..<annotations.count |source_row, annotations, index|:
                    annotation: Ast::EnumAnnotation = annotations[source_row]
                    if include_extern_rows and (annotation.owner == "__extern_return" or annotation.name == "__extern_return_darray_elem" or annotation.owner == "__extern_return_ptr" or annotation.owner == "__extern_return_optional"):
                        extern_row: u32 = index.extern_source_rows.count.u32()
                        index.extern_source_rows <- index.extern_source_rows.push(source_row)
                        index.extern_line_next <- index.extern_line_next.push(CALLABLE_ERROR_ROW_NONE)
                        previous_extern_row: u32 = callable_error_extern_line_tail(index, annotation.line)
                        if previous_extern_row != CALLABLE_ERROR_ROW_NONE:
                            index.extern_line_next[previous_extern_row.usize()] <- extern_row
                        else:
                            index.extern_line_heads <- index.extern_line_heads.put(annotation.line.u64(), extern_row) can Global{Read,Write}
                        index.extern_line_tails <- index.extern_line_tails.put(annotation.line.u64(), extern_row) can Global{Read,Write}
                    owner: sview = annotation.owner
                    continue if owner == ""
                    if annotation.name != "__error_return":
                        continue if not callable_error_family_row(annotations, source_row)
                    previous: u32 = callable_error_index_tail(index, owner)
                    row: u32 = index.next.count.u32()
                    index.next <- index.next.push(CALLABLE_ERROR_ROW_NONE)
                    index.source_rows <- index.source_rows.push(source_row)
                    if previous != CALLABLE_ERROR_ROW_NONE:
                        index.next[previous.usize()] <- row
                    else:
                        index.heads <- index.heads.put(name_hash(owner), row) can Global{Read,Write}
                    index.tails <- index.tails.put(name_hash(owner), row) can Global{Read,Write}
                index.ready <- true

        def callable_error_indexed_returns_error(index: CallableErrorAnnotationIndex&, annotations: darray[Ast::EnumAnnotation]&, module_index: FallibleFunctionModuleIndex&, module_annotations: darray[Ast::EnumAnnotation]&, name: sview, enclosing_module: sview, callee_qualifier: sview, scope_known: bool) -> bool:
            can Abort.Panic:
                saw_error_return: mutable bool = false
                row: mutable u32 = callable_error_index_head(index, name)
                while row != CALLABLE_ERROR_ROW_NONE |row, saw_error_return, annotations, module_annotations, name, enclosing_module, callee_qualifier|:
                    annotation: Ast::EnumAnnotation = annotations[index.source_rows[row.usize()]]
                    if annotation.owner == name and annotation.name == "__error_return":
                        saw_error_return <- true
                        return true if:
                            not scope_known
                            callable_row_in_scope_indexed(module_index, module_annotations, annotations, annotation.offset, annotation.line, enclosing_module, callee_qualifier)
                    row <- index.next[row.usize()]
                return false if scope_known
                return saw_error_return

        # Parser producers emit the declared family immediately after its
        # __error_return row, with the same declaration identity. Other rows
        # owned by a callable (contracts, try sites) are not error families.
        def callable_error_indexed_family(index: CallableErrorAnnotationIndex&, annotations: darray[Ast::EnumAnnotation]&, module_index: FallibleFunctionModuleIndex&, module_annotations: darray[Ast::EnumAnnotation]&, name: sview, enclosing_module: sview, callee_qualifier: sview, scope_known: bool) -> sview @source:
            can Abort.Panic:
                fallback: mutable sview @source = ""
                fallback_found: mutable bool = false
                row: mutable u32 = callable_error_index_head(index, name)
                while row != CALLABLE_ERROR_ROW_NONE |row, annotations, module_annotations, name, enclosing_module, callee_qualifier, fallback, fallback_found|:
                    annotation: Ast::EnumAnnotation = annotations[index.source_rows[row.usize()]]
                    if annotation.owner == name and callable_error_family_row(annotations, index.source_rows[row.usize()]):
                        if not fallback_found and not scope_known:
                            fallback <- annotation.name
                            fallback_found <- true
                        return annotation.name if callable_row_in_scope_indexed(module_index, module_annotations, annotations, annotation.offset, annotation.line, enclosing_module, callee_qualifier)
                    row <- index.next[row.usize()]
                return "" if scope_known
                return fallback

        # The module a fallible function was declared in, keyed by the declaration's byte
        # offset (the same key the destination side already uses).
        # Matched by OFFSET when both sides carry one and by LINE otherwise — the same rule
        # the destination (`__error_set_family`) lookup uses. Offset alone silently missed
        # every enclosing function the symbol table recorded without one.
        def fallible_fn_module(annotations: darray[Ast::EnumAnnotation]&, declaration_offset: u32, declaration_line: u32) -> sview:
            for module_annotation in annotations |declaration_offset, declaration_line|:
                if module_annotation.owner == "__fn_module":
                    matched: bool = module_annotation.offset == declaration_offset if declaration_offset != 0 and module_annotation.offset != 0 else module_annotation.line == declaration_line
                    return module_annotation.name if matched
            return ""

        def fallible_fn_module_indexed(index: FallibleFunctionModuleIndex&, module_annotations: darray[Ast::EnumAnnotation]&, declaration_offset: u32, declaration_line: u32) -> sview:
            can Abort.Panic:
                if declaration_offset == 0:
                    return module_annotations[row.usize()].name if index.by_line.get(declaration_line.u64()) is row
                    return ""
                offset_row: mutable u32 = CALLABLE_ERROR_ROW_NONE
                zero_offset_line_row: mutable u32 = CALLABLE_ERROR_ROW_NONE
                if index.by_offset.get(declaration_offset.u64()) is found_offset_row:
                    offset_row <- found_offset_row
                if index.zero_offset_by_line.get(declaration_line.u64()) is found_zero_line_row:
                    zero_offset_line_row <- found_zero_line_row
                if offset_row == CALLABLE_ERROR_ROW_NONE:
                    return module_annotations[zero_offset_line_row.usize()].name if zero_offset_line_row != CALLABLE_ERROR_ROW_NONE
                    return ""
                if zero_offset_line_row == CALLABLE_ERROR_ROW_NONE or offset_row < zero_offset_line_row:
                    return module_annotations[offset_row.usize()].name
                return module_annotations[zero_offset_line_row.usize()].name

        # The LAST `::` segment of a module path (`WasmBrowser::Delivery` -> `Delivery`), so a
        # qualified call's written qualifier can be compared without rebuilding the spelling.
        def module_last_segment(module_name: sview) -> sview:
            can Abort.Panic:
                cut: mutable usize = 0
                start: mutable usize = 0
                while cut + 1.usize() < module_name.len |cut, start|:
                    start <- cut + 2.usize() if module_name[cut] == 58 and module_name[cut + 1.usize()] == 58
                    cut <- cut + 1.usize()
                return module_name[start:module_name.len]

        def module_path_has_scope_separator(module_name: sview) -> bool:
            for offset in 0..<module_name.len:
                return true if offset + 1.usize() < module_name.len and module_name[offset] == 58 and module_name[offset + 1.usize()] == 58
            return false

        # Does this candidate row belong to the module the call resolves to? An explicit
        # qualifier (`Mods::B::step`) names it; a bare call means the ENCLOSING module.
        def callable_row_in_scope(module_annotations: darray[Ast::EnumAnnotation]&, declaration_offset: u32, declaration_line: u32, enclosing_module: sview, callee_qualifier: sview) -> bool:
            can Abort.Panic:
                candidate_module: sview = fallible_fn_module(module_annotations, declaration_offset, declaration_line)
                return module_last_segment(candidate_module) == callee_qualifier if callee_qualifier != ""
                return candidate_module == enclosing_module

        def callable_using_alias_target_count(annotations: darray[Ast::EnumAnnotation]&, alias_module: sview, alias_line: u32, alias_offset: u32, alias_name: sview) -> (count: usize, target: sview):
            can Abort.Panic:
                count: mutable usize = 0
                target: mutable sview = ""
                for row in annotations |count, target, alias_module, alias_line, alias_offset, alias_name|:
                    if row.name == "__using_alias_target" and row.module == alias_module and row.line == alias_line and row.offset == alias_offset:
                        paired_alias: mutable bool = false
                        for alias in annotations |paired_alias, alias_module, alias_line, alias_offset, alias_name, row|:
                            paired_alias <- true if alias.name == "__using_alias" and alias.owner == alias_name and alias.module == alias_module and alias.line == alias_line and alias.offset == alias_offset
                        if paired_alias:
                            count <- count + 1.usize()
                            target <- row.owner
                return (count, target)

        def callable_row_in_scope_indexed(module_index: FallibleFunctionModuleIndex&, module_annotations: darray[Ast::EnumAnnotation]&, annotations: darray[Ast::EnumAnnotation]&, declaration_offset: u32, declaration_line: u32, enclosing_module: sview, callee_qualifier: sview) -> bool:
            can Abort.Panic:
                candidate_module: sview = fallible_fn_module_indexed(module_index, module_annotations, declaration_offset, declaration_line)
                if callee_qualifier != "":
                    return true if candidate_module == callee_qualifier
                    alias_name: sview = module_last_segment(callee_qualifier)
                    alias_module: mutable sview = enclosing_module
                    separator: mutable usize = callee_qualifier.len
                    for offset in 0..<callee_qualifier.len |separator|:
                        separator <- offset if offset + 1.usize() < callee_qualifier.len and callee_qualifier[offset] == 58 and callee_qualifier[offset + 1.usize()] == 58
                    alias_module <- callee_qualifier[0:separator] if separator < callee_qualifier.len
                    alias_count: mutable usize = 0
                    alias_target: mutable sview = ""
                    for alias in annotations |alias_count, alias_target, annotations, alias_module, alias_name|:
                        if alias.name == "__using_alias" and alias.owner == alias_name and alias.module == alias_module:
                            pair: (count: usize, target: sview) = callable_using_alias_target_count(annotations, alias.module, alias.line, alias.offset, alias.owner)
                            alias_count <- alias_count + pair.count
                            alias_target <- pair.target if pair.count == 1.usize()
                    return alias_count == 1.usize() and candidate_module == alias_target if alias_count != 0.usize()
                    return false if module_path_has_scope_separator(callee_qualifier)
                    return module_last_segment(candidate_module) == callee_qualifier
                return candidate_module == enclosing_module

        def callable_error_family(annotations: darray[Ast::EnumAnnotation]&, module_annotations: darray[Ast::EnumAnnotation]&, name: sview, enclosing_module: sview, callee_qualifier: sview) -> sview:
            fallback: mutable sview = ""
            fallback_found: mutable bool = false
            for source_row in 0..<annotations.count |name, enclosing_module, callee_qualifier, annotations, module_annotations, fallback, fallback_found|:
                scoped_annotation: Ast::EnumAnnotation = annotations[source_row]
                if scoped_annotation.owner == name and callable_error_family_row(annotations, source_row):
                    if not fallback_found:
                        fallback <- scoped_annotation.name
                        fallback_found <- true
                    return scoped_annotation.name if callable_row_in_scope(module_annotations, scoped_annotation.offset, scoped_annotation.line, enclosing_module, callee_qualifier)
            return fallback

        # The module qualifier written at a `try` call site, "" for a bare call.
        def try_callee_qualifier(index: dict[u64, sview]&, try_offset: u32) -> sview:
            can Abort.Panic:
                if index.get(try_offset.u64()) is qualifier:
                    # Re-wrap the stored view by value: the same data and length, so no new
                    # extent is claimed.
                    trusted Unsafe.PointerCast:
                        return StringView{data: qualifier.data, len: qualifier.len}
                return ""

        # The function enclosing a `try`: by BYTE OFFSET when both sides carry one — lines
        # restart per included file once `#line` directives are spliced, so the largest
        # function line at or before the try's line is not the enclosing function — and by
        # line for producers that recorded no offset (extern callables), as before.
        def enclosing_try_function(table: SymbolTable&, try_line: u32, try_offset: u32) -> (line: u32, offset: u32):
            best_line: mutable u32 = FALLIBLE_FUNCTION_NO_LINE
            best_offset_line: mutable u32 = FALLIBLE_FUNCTION_NO_LINE
            best_offset: mutable u32 = FALLIBLE_FUNCTION_NO_OFFSET
            for symbol in table.symbols |best_line, best_offset_line, best_offset|:
                if symbol.kind == SymbolKind.Func:
                    best_line <- symbol.line if symbol.line <= try_line and symbol.line >= best_line
                    if try_offset != FALLIBLE_FUNCTION_NO_OFFSET and symbol.offset != FALLIBLE_FUNCTION_NO_OFFSET and symbol.offset <= try_offset and symbol.offset >= best_offset:
                        best_offset <- symbol.offset
                        best_offset_line <- symbol.line
            # Named tuples are constructed positionally; `(line: …)` is only the type spelling.
            return (best_offset_line, best_offset) if best_offset != FALLIBLE_FUNCTION_NO_OFFSET
            return (best_line, FALLIBLE_FUNCTION_NO_OFFSET)

        def fallible_function_position_index_build(index: mutable FallibleFunctionPositionIndex&, table: SymbolTable&) -> void:
            can Memory.Allocate, Abort.Panic:
                positions: mutable darray[FallibleFunctionPosition] = []
                offsets_ordered: mutable bool = true
                saw_previous: mutable bool = false
                previous_offset: mutable u32 = FALLIBLE_FUNCTION_NO_OFFSET
                for symbol in table.symbols |positions, offsets_ordered, saw_previous, previous_offset|:
                    if symbol.kind == SymbolKind.Func and symbol.offset != FALLIBLE_FUNCTION_NO_OFFSET:
                        offsets_ordered <- false if saw_previous and symbol.offset < previous_offset
                        positions <- positions.push(FallibleFunctionPosition{offset: symbol.offset, line: symbol.line})
                        previous_offset <- symbol.offset
                        saw_previous <- true
                index.positions <- positions
                index.offsets_ordered <- offsets_ordered
                index.ready <- true

        def enclosing_try_function_indexed(index: mutable FallibleFunctionPositionIndex&, table: SymbolTable&, try_line: u32, try_offset: u32) -> (line: u32, offset: u32):
            can Memory.Allocate, Abort.Panic:
                if not index.ready:
                    fallible_function_position_index_build(index, table)
                if try_offset != FALLIBLE_FUNCTION_NO_OFFSET and index.offsets_ordered:
                    low: mutable usize = FALLIBLE_FUNCTION_FIRST_POSITION
                    high: mutable usize = index.positions.count
                    while low < high |low, high, index, try_offset|:
                        middle: usize = low + (high - low) / FALLIBLE_FUNCTION_SEARCH_DIVISOR
                        if index.positions[middle].offset <= try_offset:
                            low <- middle + FALLIBLE_FUNCTION_POSITION_STEP
                        else:
                            high <- middle
                    if low > FALLIBLE_FUNCTION_FIRST_POSITION:
                        position: FallibleFunctionPosition = index.positions[low - FALLIBLE_FUNCTION_POSITION_STEP]
                        return (position.line, position.offset)
                return enclosing_try_function(table, try_line, try_offset)

        def error_family_covers(source: sview, destination: sview, table: SymbolTable&) -> bool:
            can Abort.Panic:
                saw_source_tag: mutable bool = false
                for variant_index in 0..<table.enum_variant_owner.count |saw_source_tag|:
                    if table.enum_variant_owner[variant_index] == source:
                        saw_source_tag <- true
                        return false if not enum_has_variant(table, destination, table.enum_variant_name[variant_index])
                return saw_source_tag

        def check_try_propagation_row(annotation: Ast::EnumAnnotation&, enclosing: (line: u32, offset: u32), enclosing_module: sview, callee_qualifier: sview, annotations: darray[Ast::EnumAnnotation]&, error_set_annotations: darray[Ast::EnumAnnotation]&, error_set_index: mutable TryErrorSetIndex&, propagation_site_count: usize, module_index: FallibleFunctionModuleIndex&, module_annotations: darray[Ast::EnumAnnotation]&, error_index: CallableErrorAnnotationIndex&, table: lmut SymbolTable, first_class_error_family: sview @source = "", lambda_error_family: sview @source = "", inside_lambda: bool = false) -> void:
            can Memory.Allocate, Abort.Panic, Global.Read:
                scope_known: bool = enclosing.line != 0 or enclosing.offset != 0 or enclosing_module != "" or callee_qualifier != ""
                source: sview @source = first_class_error_family if first_class_error_family != "" else callable_error_indexed_family(error_index, annotations, module_index, module_annotations, annotation.owner, enclosing_module, callee_qualifier, scope_known)
                return if source == ""
                function_line: u32 = enclosing.line
                destinations: mutable darray[sview @source] = []
                if inside_lambda:
                    destinations.push(lambda_error_family) if lambda_error_family != ""
                else:
                    if propagation_site_count > 1 and propagation_site_count * error_set_annotations.count > TRY_ERROR_SET_INDEX_MIN_WORK:
                        try_error_set_index_build(error_set_index, error_set_annotations) can Global{Read,Write}
                        can Global.Read:
                            destinations <- try_error_set_destinations(error_set_index, error_set_annotations, enclosing.offset, function_line)
                    else:
                        destinations.extend([destination_row.name for destination_row in error_set_annotations if destination_row.owner == "__error_set_family" and (destination_row.offset == enclosing.offset if enclosing.offset != 0 and destination_row.offset != 0 else destination_row.line == function_line)])
                # A fallible callee (`source != ""`) whose enclosing function declares NO error set
                # cannot propagate the `try` — stage0 requires the current function to return an
                # error union. (A function WITH an error set proceeds to the set-coverage check.)
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.TryWithoutElseNonErrorFunction, name: "", line: annotation.line, expected: "", actual: ""}) if destinations.count == 0 and function_line != 0
                return if destinations.count == 0
                covered: bool = any destination in destinations where destination == source or error_family_covers(source, destination, table)
                return if covered
                first: mutable sview @source = destinations[0]
                second: mutable sview @source = ""
                second <- destinations[1] if destinations.count > 1
                swap: bool = second != "" and error_family_symbol_position(table, second) < error_family_symbol_position(table, first)
                first, second <- second, first if swap
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.TryPropagationMismatch, name: source, pos: annotation.pos, line: annotation.line, expected: first, actual: "", detail: second})

        # The compact AST erases the `try` head and records `__noncall` when its operand
        # is not a Call. Recover the narrow `try parameter` form from the function body and
        # the parser's `__param_error_union` metadata. A parameter marker is line-keyed, so
        # accept it only when every parameter on that source line is marked; otherwise the
        # parser metadata cannot unambiguously associate the errorset with a parameter.
        def try_noncall_parameter_name(expression: Ast::Expr) -> sview @source:
            can Abort.Panic:
                match expression:
                    Expr.Ident(name, _):
                        return name
                    Expr.Paren(inner, _):
                        return try_noncall_parameter_name(inner)
                    _:
                        return ""

        def try_noncall_record_expression(expression: Ast::Expr, annotation: Ast::EnumAnnotation, nearest_offset: mutable u32&, nearest_name: mutable sview& @source) -> void:
            can Abort.Panic:
                position: Ast::Pos = Ast::expr_pos(expression)
                if position.line == annotation.line and position.offset > annotation.offset and nearest_offset == 4294967295:
                    nearest_offset <- position.offset
                    nearest_name <- try_noncall_parameter_name(expression)
                    # The first AST expression beginning after the erased try token is
                    # its operand root. Descending from a binary/member root and choosing
                    # the first identifier would incorrectly borrow that child's family.
                    return
                # The parser erases the `try` wrapper and records its token offset separately.
                # When `try value` is nested as a call argument, the statement's Call node
                # starts before the annotation, so search its children for the closest node
                # that begins after the token.
                match expression:
                    Expr.Call(callee, arguments, _, _):
                        try_noncall_record_expression(callee, annotation, nearest_offset, nearest_name)
                        for argument in arguments |annotation, nearest_offset, nearest_name|:
                            try_noncall_record_expression(argument, annotation, nearest_offset, nearest_name)
                    Expr.StaticEffectCall(_, _, candidates, arguments, _, _):
                        for candidate in candidates |annotation, nearest_offset, nearest_name|:
                            for capture in candidate.captures |annotation, nearest_offset, nearest_name|:
                                try_noncall_record_expression(capture, annotation, nearest_offset, nearest_name)
                        for argument in arguments |annotation, nearest_offset, nearest_name|:
                            try_noncall_record_expression(argument, annotation, nearest_offset, nearest_name)
                    Expr.Binary(left, _, right, _):
                        try_noncall_record_expression(left, annotation, nearest_offset, nearest_name)
                        try_noncall_record_expression(right, annotation, nearest_offset, nearest_name)
                    Expr.Paren(inner, _):
                        try_noncall_record_expression(inner, annotation, nearest_offset, nearest_name)
                    Expr.Field(object, _, _):
                        try_noncall_record_expression(object, annotation, nearest_offset, nearest_name)
                    Expr.Scope(base, _, _):
                        try_noncall_record_expression(base, annotation, nearest_offset, nearest_name)
                    Expr.Index(object, index, _):
                        try_noncall_record_expression(object, annotation, nearest_offset, nearest_name)
                        try_noncall_record_expression(index, annotation, nearest_offset, nearest_name)
                    Expr.IndexN(object, arguments, _):
                        try_noncall_record_expression(object, annotation, nearest_offset, nearest_name)
                        for argument in arguments |annotation, nearest_offset, nearest_name|:
                            try_noncall_record_expression(argument, annotation, nearest_offset, nearest_name)
                    Expr.Slice(object, low, high, _):
                        try_noncall_record_expression(object, annotation, nearest_offset, nearest_name)
                        try_noncall_record_expression(low, annotation, nearest_offset, nearest_name)
                        try_noncall_record_expression(high, annotation, nearest_offset, nearest_name)
                    Expr.Unary(_, operand, _):
                        try_noncall_record_expression(operand, annotation, nearest_offset, nearest_name)
                    Expr.Move(operand, _) | Expr.RegionNew(operand, _, _):
                        try_noncall_record_expression(operand, annotation, nearest_offset, nearest_name)
                    Expr.Array(elements, _) | Expr.Tuple(elements, _) | Expr.SetLit(elements, _):
                        for element in elements |annotation, nearest_offset, nearest_name|:
                            try_noncall_record_expression(element, annotation, nearest_offset, nearest_name)
                    Expr.DictLit(entries, _):
                        for entry in entries |annotation, nearest_offset, nearest_name|:
                            try_noncall_record_expression(entry.key, annotation, nearest_offset, nearest_name)
                            try_noncall_record_expression(entry.value, annotation, nearest_offset, nearest_name)
                    Expr.Construct(type_expression, fields, _) | Expr.RecordUpdate(type_expression, fields, _):
                        try_noncall_record_expression(type_expression, annotation, nearest_offset, nearest_name)
                        for field in fields |annotation, nearest_offset, nearest_name|:
                            try_noncall_record_expression(field.value, annotation, nearest_offset, nearest_name)
                    Expr.If(condition, then_value, else_value, _):
                        try_noncall_record_expression(condition, annotation, nearest_offset, nearest_name)
                        try_noncall_record_expression(then_value, annotation, nearest_offset, nearest_name)
                        try_noncall_record_expression(else_value, annotation, nearest_offset, nearest_name)
                    Expr.Match(scrutinee, arms, _) | Expr.Catch(scrutinee, arms, _):
                        try_noncall_record_expression(scrutinee, annotation, nearest_offset, nearest_name)
                        for arm in arms |annotation, nearest_offset, nearest_name|:
                            try_noncall_record_expression(arm.guard, annotation, nearest_offset, nearest_name)
                            try_noncall_record_statements(arm.body, annotation, nearest_offset, nearest_name)
                    Expr.Comprehension(_, iterable, condition, body, _, _):
                        try_noncall_record_expression(iterable, annotation, nearest_offset, nearest_name)
                        try_noncall_record_expression(condition, annotation, nearest_offset, nearest_name)
                        try_noncall_record_expression(body, annotation, nearest_offset, nearest_name)
                    Expr.Refinement(base, predicate, _):
                        try_noncall_record_expression(base, annotation, nearest_offset, nearest_name)
                        try_noncall_record_expression(predicate, annotation, nearest_offset, nearest_name)
                    Expr.GetElse(guarded, recovery, _):
                        try_noncall_record_expression(guarded, annotation, nearest_offset, nearest_name)
                        try_noncall_record_statements(recovery, annotation, nearest_offset, nearest_name)
                    Expr.Block(block_statements, value, _, _):
                        try_noncall_record_statements(block_statements, annotation, nearest_offset, nearest_name)
                        try_noncall_record_expression(value, annotation, nearest_offset, nearest_name)
                    Expr.Lambda(_, lambda_body, _):
                        try_noncall_record_statements(lambda_body, annotation, nearest_offset, nearest_name)
                    _:
                        pass

        def try_noncall_record_statements(statements: darray[Ast::Stmt], annotation: Ast::EnumAnnotation, nearest_offset: mutable u32&, nearest_name: mutable sview& @source) -> void:
            can Abort.Panic:
                for statement in statements |annotation, nearest_offset, nearest_name|:
                    match statement:
                        Stmt.Expr(expression, _):
                            try_noncall_record_expression(expression, annotation, nearest_offset, nearest_name)
                        Stmt.Assign(target, _, value, _):
                            try_noncall_record_expression(target, annotation, nearest_offset, nearest_name)
                            try_noncall_record_expression(value, annotation, nearest_offset, nearest_name)
                        Stmt.VarDecl(_, _, value, _):
                            try_noncall_record_expression(value, annotation, nearest_offset, nearest_name)
                        Stmt.Return(value, _):
                            if value is returned:
                                try_noncall_record_expression(returned, annotation, nearest_offset, nearest_name)
                        Stmt.If(condition, then_body, else_body, _):
                            try_noncall_record_expression(condition, annotation, nearest_offset, nearest_name)
                            try_noncall_record_statements(then_body, annotation, nearest_offset, nearest_name)
                            try_noncall_record_statements(else_body, annotation, nearest_offset, nearest_name)
                        Stmt.While(condition, body, _):
                            try_noncall_record_expression(condition, annotation, nearest_offset, nearest_name)
                            try_noncall_record_statements(body, annotation, nearest_offset, nearest_name)
                        Stmt.For(_, _, iterable, body, _):
                            try_noncall_record_expression(iterable, annotation, nearest_offset, nearest_name)
                            try_noncall_record_statements(body, annotation, nearest_offset, nearest_name)
                        Stmt.Block(_, _, _, body, _):
                            try_noncall_record_statements(body, annotation, nearest_offset, nearest_name)
                        Stmt.Match(scrutinee, arms, _):
                            try_noncall_record_expression(scrutinee, annotation, nearest_offset, nearest_name)
                            for arm in arms |annotation, nearest_offset, nearest_name|:
                                try_noncall_record_expression(arm.guard, annotation, nearest_offset, nearest_name)
                                try_noncall_record_statements(arm.body, annotation, nearest_offset, nearest_name)
                        Stmt.Contract(_, expression, _):
                            try_noncall_record_expression(expression, annotation, nearest_offset, nearest_name)
                        _:
                            pass

        def try_parameter_error_family(params: darray[Ast::ParamDecl], parameter_name: sview @source, annotations: darray[Ast::EnumAnnotation]&) -> (known: bool, family: sview @source):
            can Abort.Panic:
                parameter_line: mutable u32 = 0
                parameter_offset: mutable u32 = 0
                for parameter in params |parameter_line, parameter_name|:
                    if parameter.name == parameter_name:
                        parameter_line <- parameter.name_pos.line
                        parameter_offset <- parameter.name_pos.offset
                return (false, "") if parameter_line == 0
                if parameter_offset != 0:
                    invalid_exact: bool = any annotation in annotations where annotation.owner == "__param_error_union_invalid" and annotation.offset == parameter_offset
                    return (false, "") if invalid_exact
                    exact_family: mutable sview @source = ""
                    exact_count: mutable usize = 0
                    for annotation in annotations |exact_family, exact_count, parameter_offset|:
                        if annotation.owner == "__param_error_union" and annotation.offset == parameter_offset:
                            exact_family <- annotation.name if exact_count == 0
                            exact_count <- exact_count + 1.usize()
                    return (true, exact_family) if exact_count == 1
                    return (false, "") if exact_count > 1
                    # A legacy parser row can carry only its line, not the parameter's
                    # identifier offset. Let the line-based path below recover it only
                    # when it can pair every row with one parameter unambiguously.
                invalid_line: bool = any annotation in annotations where annotation.owner == "__param_error_union_invalid" and annotation.line == parameter_line
                return (false, "") if invalid_line
                params_on_line: mutable usize = 0
                for parameter in params |params_on_line, parameter_line|:
                    params_on_line <- params_on_line + 1.usize() if parameter.name_pos.line == parameter_line
                family: mutable sview @source = ""
                family_count: mutable usize = 0
                conflicting_families: mutable bool = false
                for annotation in annotations |family, family_count, conflicting_families, parameter_line|:
                    if annotation.owner == "__param_error_union" and annotation.line == parameter_line:
                        family <- annotation.name if family_count == 0
                        conflicting_families <- true if annotation.name != family
                        family_count <- family_count + 1.usize()
                return (true, "") if family_count == 0
                return (false, "") if family_count != params_on_line or conflicting_families
                return (true, family)

        def try_noncall_rebind_claimed_target(annotations: darray[Ast::EnumAnnotation]&, line: u32, name: sview) -> bool:
            can Abort.Panic:
                return any annotation in annotations where annotation.owner == "__lmut_rebind_claim" and annotation.line == line and annotation.name == name

        def try_noncall_pattern_shadows_name(pattern: Ast::Pattern, candidate: sview) -> bool:
            can Memory.Allocate, Abort.Panic:
                binders: mutable darray[sview @source] = []
                gather_arm_pattern(pattern, binders)
                return any binder in binders where binder == candidate

        # A deliberately narrow type projection for bindings whose scalar type is
        # explicit in the pattern or recoverable from a typed sequence parameter. The
        # non-call try scan must not keep an outer error family after a pattern shadows
        # that name, but it should still recognize `try` on a known primitive as invalid.
        def try_noncall_type_name_facts(type_name: sview) -> (known_nonfallible: bool, numeric: bool, integer: bool):
            can Abort.Panic:
                numeric: bool = type_name in {"i8", "i16", "i32", "i64", "int", "isize", "u8", "u16", "u32", "u64", "usize", "uintptr", "f32", "f64", "char"}
                integer: bool = type_name in {"i8", "i16", "i32", "i64", "int", "isize", "u8", "u16", "u32", "u64", "usize", "uintptr"}
                known_nonfallible: bool = numeric or type_name in {"bool", "string", "cstr", "dstr", "sview"}
                return (known_nonfallible, numeric, integer)

        # The source scan resolves lexically unique aliases whose target is a primitive
        # scalar name or a chain of aliases visible from the current module, optionally
        # under transparent paren or mutability/storage wrappers. Qualified, generic,
        # duplicate, and cyclic aliases stay unknown rather than borrowing another module's
        # spelling.
        def try_noncall_declared_type_facts(type_expression: Ast::Expr) -> (known_nonfallible: bool, numeric: bool, integer: bool):
            can Abort.Panic:
                match type_expression:
                    Expr.Ident(name, _):
                        return try_noncall_type_name_facts(name)
                    Expr.Unary(operator, inner, _) if operator == TokenKind.Mutable or operator == TokenKind.Static or operator == TokenKind.Heap or operator == TokenKind.Stack or operator == TokenKind.Tail:
                        return try_noncall_declared_type_facts(inner)
                    Expr.Paren(inner, _):
                        return try_noncall_declared_type_facts(inner)
                    _:
                        return (false, false, false)

        def try_noncall_declared_type_alias_target(type_expression: Ast::Expr) -> sview @source:
            can Abort.Panic:
                match type_expression:
                    Expr.Ident(name, _):
                        return name
                    Expr.Unary(operator, inner, _) if operator == TokenKind.Mutable or operator == TokenKind.Static or operator == TokenKind.Heap or operator == TokenKind.Stack or operator == TokenKind.Tail:
                        return try_noncall_declared_type_alias_target(inner)
                    Expr.Paren(inner, _):
                        return try_noncall_declared_type_alias_target(inner)
                    _:
                        return ""

        def try_noncall_type_alias_facts_add(declarations: darray[Ast::Decl], environment: mutable TryNonCallErrorFamilyEnv&, current_module: sview) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |environment, current_module|:
                    match declaration:
                        Decl.Alias(alias_name, target, _) if target is not Expr.Invalid:
                            target_facts: (known_nonfallible: bool, numeric: bool, integer: bool) = try_noncall_declared_type_facts(target)
                            environment.type_alias_names.push(alias_name)
                            environment.type_alias_modules.push(current_module)
                            environment.type_alias_target_names.push(try_noncall_declared_type_alias_target(target))
                            environment.type_alias_known_nonfallible.push(target_facts.known_nonfallible)
                            environment.type_alias_numeric.push(target_facts.numeric)
                            environment.type_alias_integer.push(target_facts.integer)
                        Decl.Struct(type_name, _, _, _, _, _, _):
                            environment.non_alias_type_names.push(type_name)
                            environment.non_alias_type_modules.push(current_module)
                        Decl.Enum(type_name, _, _, _, _):
                            environment.non_alias_type_names.push(type_name)
                            environment.non_alias_type_modules.push(current_module)
                        Decl.Module(module_name, module_body, _):
                            try_noncall_type_alias_facts_add(module_body, environment, module_name)
                        Decl.Scoped(scoped_body, _):
                            try_noncall_type_alias_facts_add(scoped_body, environment, current_module)
                        _:
                            pass

        def try_noncall_type_alias_facts(alias_name: sview, environment: TryNonCallErrorFamilyEnv&, depth: u32) -> (known_nonfallible: bool, numeric: bool, integer: bool):
            can Abort.Panic:
                return (false, false, false) if depth > 64
                match_count: mutable usize = 0
                alias_index: mutable usize = 0
                local_type_shadows_name: mutable bool = false
                for index in 0..<environment.type_alias_names.count |match_count, alias_index, environment, alias_name|:
                    if environment.type_alias_names[index] == alias_name and environment.type_alias_modules[index] == environment.current_module:
                        match_count <- match_count + 1.usize()
                        alias_index <- index
                if match_count == 0.usize() and environment.current_module != "":
                    for index in 0..<environment.non_alias_type_names.count |local_type_shadows_name, environment, alias_name|:
                        local_type_shadows_name <- true if environment.non_alias_type_names[index] == alias_name and environment.non_alias_type_modules[index] == environment.current_module
                    return (false, false, false) if local_type_shadows_name
                    for index in 0..<environment.type_alias_names.count |match_count, alias_index, environment, alias_name|:
                        if environment.type_alias_names[index] == alias_name and environment.type_alias_modules[index] == "":
                            match_count <- match_count + 1.usize()
                            alias_index <- index
                return (false, false, false) if match_count != 1.usize()
                alias_facts: (known_nonfallible: bool, numeric: bool, integer: bool) = (environment.type_alias_known_nonfallible[alias_index], environment.type_alias_numeric[alias_index], environment.type_alias_integer[alias_index])
                return alias_facts if alias_facts.known_nonfallible or alias_facts.numeric or alias_facts.integer
                target_name: sview = environment.type_alias_target_names[alias_index] if alias_index < environment.type_alias_target_names.count else ""
                return try_noncall_type_alias_facts(target_name, environment, depth + 1) if target_name != ""
                return alias_facts

        def try_noncall_type_facts_with_aliases(type_expression: Ast::Expr, environment: TryNonCallErrorFamilyEnv&) -> (known_nonfallible: bool, numeric: bool, integer: bool):
            can Abort.Panic:
                direct_facts: (known_nonfallible: bool, numeric: bool, integer: bool) = try_noncall_declared_type_facts(type_expression)
                return direct_facts if direct_facts.known_nonfallible
                match type_expression:
                    Expr.Ident(alias_name, _):
                        return try_noncall_type_alias_facts(alias_name, environment, 0)
                    Expr.Unary(operator, inner, _) if operator == TokenKind.Mutable or operator == TokenKind.Static or operator == TokenKind.Heap or operator == TokenKind.Stack or operator == TokenKind.Tail:
                        return try_noncall_type_facts_with_aliases(inner, environment)
                    Expr.Paren(inner, _):
                        return try_noncall_type_facts_with_aliases(inner, environment)
                    _:
                        pass
                return (false, false, false)

        def try_noncall_callable_facts_add(declarations: darray[Ast::Decl], annotations: darray[Ast::EnumAnnotation]&, environment: mutable TryNonCallErrorFamilyEnv&, current_module: sview) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |annotations, environment, current_module|:
                    match declaration:
                        Decl.Func(name, _, return_type, _, _, _, function_position):
                            family: mutable sview @source = ""
                            family_rows: mutable usize = 0
                            for row in 0..<annotations.count |family, family_rows, annotations, name, function_position|:
                                marker: Ast::EnumAnnotation = annotations[row]
                                same_declaration: bool = marker.offset == function_position.offset if marker.offset != 0 and function_position.offset != 0 else marker.line == function_position.line
                                if marker.owner == name and marker.name == "__error_return" and same_declaration and row + 1.usize() < annotations.count and callable_error_family_row(annotations, row + 1.usize()):
                                    family <- annotations[row + 1.usize()].name if family_rows == 0
                                    family_rows <- family_rows + 1.usize()
                            return_facts: mutable (known_nonfallible: bool, numeric: bool, integer: bool) = (false, false, false)
                            if return_type is function_return_type:
                                return_facts <- try_noncall_type_facts_with_aliases(function_return_type, environment)
                            environment.callable_names.push(name)
                            environment.callable_modules.push(current_module)
                            environment.callable_families.push(family)
                            environment.callable_facts_known.push(family_rows <= 1.usize())
                            environment.callable_numeric.push(return_facts.numeric)
                            environment.callable_integer.push(return_facts.integer)
                        Decl.Module(module_name, module_body, _):
                            try_noncall_callable_facts_add(module_body, annotations, environment, module_name)
                        Decl.Scoped(scoped_body, _):
                            try_noncall_callable_facts_add(scoped_body, annotations, environment, current_module)
                        _:
                            pass

        # A qualified callee keeps its AST path so `OuterA::Common::pure` is
        # distinguished from `OuterB::Common::pure`. A one-segment qualifier still
        # matches the final segment, preserving module aliases and relative names.
        def try_noncall_qualifier_path_matches_module(qualifier: Ast::Expr, module_path: sview) -> bool:
            can Abort.Panic:
                match qualifier:
                    Expr.Ident(name, _):
                        return module_last_segment(module_path) == name
                    Expr.Scope(base, name, _):
                        separator: mutable usize = module_path.len
                        offset: mutable usize = 0
                        while offset + 1.usize() < module_path.len |separator, offset|:
                            separator <- offset if module_path[offset] == 58 and module_path[offset + 1.usize()] == 58
                            offset <- offset + 1.usize()
                        return false if separator == module_path.len
                        return false if module_path[separator + 2.usize():module_path.len] != name
                        return try_noncall_qualifier_path_matches_module(base, module_path[0:separator])
                    Expr.Paren(inner, _):
                        return try_noncall_qualifier_path_matches_module(inner, module_path)
                    _:
                        return false

        def try_noncall_qualified_module_matches(callee: Ast::Expr, module_path: sview) -> bool:
            can Abort.Panic:
                match callee:
                    Expr.Scope(qualifier, _, _):
                        return try_noncall_qualifier_path_matches_module(qualifier, module_path)
                    Expr.Paren(inner, _):
                        return try_noncall_qualified_module_matches(inner, module_path)
                    _:
                        return false

        def try_noncall_qualifier_matches_alias(qualifier: Ast::Expr, alias_module: sview, alias_name: sview, current_module: sview) -> bool:
            can Abort.Panic:
                match qualifier:
                    Expr.Ident(name, _):
                        return alias_module == current_module and name == alias_name
                    Expr.Scope(base, name, _):
                        return name == alias_name and try_noncall_qualifier_path_matches_module(base, alias_module)
                    Expr.Paren(inner, _):
                        return try_noncall_qualifier_matches_alias(inner, alias_module, alias_name, current_module)
                    _:
                        return false

        def try_noncall_qualified_module_matches_alias(callee: Ast::Expr, alias_module: sview, alias_name: sview, current_module: sview) -> bool:
            can Abort.Panic:
                match callee:
                    Expr.Scope(qualifier, _, _):
                        return try_noncall_qualifier_matches_alias(qualifier, alias_module, alias_name, current_module)
                    Expr.Paren(inner, _):
                        return try_noncall_qualified_module_matches_alias(inner, alias_module, alias_name, current_module)
                    _:
                        return false

        def try_noncall_callable_cached_facts(callee_name: sview, callee_qualifier: sview, callee: Ast::Expr, environment: TryNonCallErrorFamilyEnv&) -> (known: bool, family: sview @source, numeric: bool, integer: bool, ambiguous: bool):
            can Abort.Panic:
                match_count: mutable usize = 0
                callable_index: mutable usize = 0
                for index in 0..<environment.callable_names.count |match_count, callable_index, environment, callee_name, callee_qualifier, callee|:
                    module_matches: mutable bool = try_noncall_qualified_module_matches(callee, environment.callable_modules[index]) if callee_qualifier != "" else true
                    if callee_qualifier != "" and not module_matches:
                        for alias_index in 0..<environment.using_alias_names.count |module_matches, environment, callee|:
                            alias_path_matches: bool = try_noncall_qualified_module_matches_alias(callee, environment.using_alias_modules[alias_index], environment.using_alias_names[alias_index], environment.current_module)
                            if alias_path_matches and try_noncall_qualified_module_matches(callee, environment.using_alias_targets[alias_index]):
                                module_matches <- true
                    if environment.callable_names[index] == callee_name and module_matches:
                        match_count <- match_count + 1.usize()
                        callable_index <- index
                if match_count == 1.usize():
                    return (false, "", false, false, true) if not environment.callable_facts_known[callable_index]
                    return (true, environment.callable_families[callable_index], environment.callable_numeric[callable_index], environment.callable_integer[callable_index], false)
                return (false, "", false, false, match_count > 1.usize())

        def try_noncall_callable_source_facts(callee_name: sview @source, callee_qualifier: sview, callee: Ast::Expr, environment: TryNonCallErrorFamilyEnv&, annotations: darray[Ast::EnumAnnotation]&) -> (known: bool, family: sview @source, numeric: bool, integer: bool):
            can Abort.Panic:
                cached_facts: (known: bool, family: sview @source, numeric: bool, integer: bool, ambiguous: bool) = try_noncall_callable_cached_facts(callee_name, callee_qualifier, callee, environment)
                return (cached_facts.known, cached_facts.family, cached_facts.numeric, cached_facts.integer) if cached_facts.known or cached_facts.ambiguous or callee_qualifier != ""
                legacy_facts: (known: bool, family: sview @source) = try_noncall_callable_error_family(callee_name, annotations)
                return (legacy_facts.known, legacy_facts.family, false, false)

        def try_noncall_pattern_binding_facts(pattern: Ast::Pattern, candidate: sview) -> (known_nonfallible: bool, numeric: bool, integer: bool):
            can Abort.Panic:
                match pattern:
                    Pattern.TypeBind(type_name, binder) if binder == candidate:
                        return try_noncall_type_name_facts(type_name)
                    Pattern.As(name, inner):
                        return (false, false, false) if name == candidate
                        for nested in inner:
                            facts: (known_nonfallible: bool, numeric: bool, integer: bool) = try_noncall_pattern_binding_facts(nested, candidate)
                            return facts if facts.known_nonfallible or facts.numeric or facts.integer
                    Pattern.Variant(_, fields) | Pattern.Struct(_, fields) | Pattern.Tuple(fields) | Pattern.Or(fields) | Pattern.Field(_, fields):
                        for nested in fields:
                            facts: (known_nonfallible: bool, numeric: bool, integer: bool) = try_noncall_pattern_binding_facts(nested, candidate)
                            return facts if facts.known_nonfallible or facts.numeric or facts.integer
                    _:
                        pass
                return (false, false, false)

        def try_noncall_expression_value_facts(expression: Ast::Expr, params: darray[Ast::ParamDecl], environment: TryNonCallErrorFamilyEnv&) -> (known_nonfallible: bool, numeric: bool, integer: bool):
            can Abort.Panic:
                match expression:
                    Expr.Ident(name, _):
                        index: usize = try_noncall_family_index(environment, name)
                        if index < environment.names.count:
                            return (false, false, false) if environment.families[index] != ""
                            return (environment.known_nonfallible[index], environment.numeric[index], environment.integer[index])
                        for parameter in params:
                            if parameter.name == name:
                                return try_noncall_type_facts_with_aliases(parameter.type_expression, environment)
                    Expr.Paren(inner, _):
                        return try_noncall_expression_value_facts(inner, params, environment)
                    Expr.IntLit(_, _):
                        return try_noncall_type_name_facts("i64")
                    Expr.FloatLit(_, _):
                        return try_noncall_type_name_facts("f64")
                    Expr.CharLit(_, _):
                        return try_noncall_type_name_facts("char")
                    Expr.BoolLit(_, _):
                        return try_noncall_type_name_facts("bool")
                    Expr.StringLit(_, _):
                        return try_noncall_type_name_facts("string")
                    _:
                        pass
                return (false, false, false)

        # Catch's plain success binding receives the payload after the guarded expression's
        # error family has been removed. The source-level scan doesn't need the concrete
        # return type to know that this payload isn't itself the caught error union; numeric
        # metadata is preserved only when it is already available for an identifier.
        # A Match binder is different: it receives the complete scrutinee value.
        def try_noncall_catch_success_payload_facts(expression: Ast::Expr, params: darray[Ast::ParamDecl], environment: TryNonCallErrorFamilyEnv&, annotations: darray[Ast::EnumAnnotation]&) -> (known_nonfallible: bool, numeric: bool, integer: bool):
            can Abort.Panic:
                guarded_facts: (family: sview @source, known_nonfallible: bool) = try_noncall_assignment_source_facts(expression, params, environment, annotations)
                return (false, false, false) if guarded_facts.family == ""
                match expression:
                    Expr.Ident(name, _):
                        index: usize = try_noncall_family_index(environment, name)
                        if index < environment.names.count and environment.families[index] != "":
                            return (true, environment.numeric[index], environment.integer[index])
                    Expr.Call(callee, _, _, _):
                        callee_name: sview @source = try_noncall_unqualified_callable_name(callee)
                        callee_qualifier: sview @source = try_noncall_callable_qualifier(callee)
                        call_facts: (known: bool, family: sview @source, numeric: bool, integer: bool) = try_noncall_callable_source_facts(callee_name, callee_qualifier, callee, environment, annotations)
                        return (true, call_facts.numeric, call_facts.integer) if call_facts.known and call_facts.family != "" and call_facts.family == guarded_facts.family
                    Expr.Paren(inner, _):
                        return try_noncall_catch_success_payload_facts(inner, params, environment, annotations)
                    _:
                        pass
                return (true, false, false)

        def try_noncall_target_binds_name(target: Ast::Expr, candidate: sview) -> bool:
            can Abort.Panic:
                match target:
                    Expr.Ident(name, _):
                        return name == candidate
                    Expr.Paren(inner, _):
                        return try_noncall_target_binds_name(inner, candidate)
                    Expr.Tuple(elements, _) | Expr.Array(elements, _):
                        for element in elements:
                            return true if try_noncall_target_binds_name(element, candidate)
                    _:
                        pass
                return false

        def try_noncall_target_source_facts(target: Ast::Expr, value: Ast::Expr, candidate: sview, params: darray[Ast::ParamDecl], environment: TryNonCallErrorFamilyEnv&, annotations: darray[Ast::EnumAnnotation]&) -> (found: bool, family: sview @source, known_nonfallible: bool):
            can Abort.Panic:
                match target:
                    Expr.Ident(name, _):
                        return (false, "", false) if name != candidate
                        source_facts: (family: sview @source, known_nonfallible: bool) = try_noncall_assignment_source_facts(value, params, environment, annotations)
                        return (true, source_facts.family, source_facts.known_nonfallible)
                    Expr.Paren(inner, _):
                        return try_noncall_target_source_facts(inner, value, candidate, params, environment, annotations)
                    Expr.Tuple(targets, _) | Expr.Array(targets, _):
                        match value:
                            Expr.Tuple(values, _) | Expr.Array(values, _):
                                return (true, "", false) if targets.count != values.count and try_noncall_target_binds_name(target, candidate)
                                for index in 0..<targets.count:
                                    if try_noncall_target_binds_name(targets[index], candidate):
                                        return try_noncall_target_source_facts(targets[index], values[index], candidate, params, environment, annotations) if index < values.count
                                        return (true, "", false)
                            _:
                                pass
                        return (true, "", false) if try_noncall_target_binds_name(target, candidate)
                    _:
                        pass
                return (false, "", false)

        def try_noncall_expression_is_name(expression: Ast::Expr, candidate: sview) -> bool:
            can Abort.Panic:
                match expression:
                    Expr.Ident(name, _):
                        return name == candidate
                    Expr.Paren(inner, _):
                        return try_noncall_expression_is_name(inner, candidate)
                    _:
                        return false

        def try_noncall_callable_error_family(callee_name: sview, annotations: darray[Ast::EnumAnnotation]&) -> (known: bool, family: sview @source):
            can Abort.Panic:
                return (false, "") if callee_name == ""
                declarations: mutable usize = 0
                for declaration in annotations:
                    # This source-only alias scan does not carry the caller module,
                    # unlike the direct-call checker below. A duplicate bare name may
                    # resolve to a different declaration (or to a nonfallible overload),
                    # so refuse to borrow any family when the name is not globally unique.
                    declarations <- declarations + 1.usize() if declaration.name == "__lsp_func_name" and declaration.owner == callee_name
                return (false, "") if declarations > 1.usize()
                found: mutable bool = false
                conflicting: mutable bool = false
                family: mutable sview @source = ""
                for row in 0..<annotations.count |found, conflicting, family, annotations, callee_name|:
                    marker: Ast::EnumAnnotation = annotations[row]
                    if marker.owner == callee_name and marker.name == "__error_return" and row + 1 < annotations.count and callable_error_family_row(annotations, row + 1):
                        next_family: sview @source = annotations[row + 1].name
                        family <- next_family if not found
                        conflicting <- true if found and family != next_family
                        found <- true
                return (true, family) if found and not conflicting
                # A unique parser declaration marker with no error-return row is a
                # declared nonfallible function. Keep optional's more specific message
                # available on direct calls; through this noncall alias path the owner is
                # erased, but rejecting `try` on the returned value is still sound.
                return (true, "") if declarations == 1.usize() and not found
                return (false, "")

        def try_noncall_unqualified_callable_name(expression: Ast::Expr) -> sview @source:
            can Abort.Panic:
                match expression:
                    Expr.Ident(name, _):
                        return name
                    Expr.Scope(_, name, _):
                        return name
                    Expr.Paren(inner, _):
                        return try_noncall_unqualified_callable_name(inner)
                    _:
                        return ""

        def try_noncall_callable_qualifier(expression: Ast::Expr) -> sview @source:
            can Abort.Panic:
                match expression:
                    Expr.Scope(base, _, _):
                        match base:
                            Expr.Ident(name, _):
                                return name
                            Expr.Scope(_, name, _):
                                return name
                            _:
                                return ""
                    Expr.Paren(inner, _):
                        return try_noncall_callable_qualifier(inner)
                    _:
                        return ""

        def try_noncall_assignment_source_facts(expression: Ast::Expr, params: darray[Ast::ParamDecl], environment: TryNonCallErrorFamilyEnv&, annotations: darray[Ast::EnumAnnotation]&) -> (family: sview @source, known_nonfallible: bool):
            can Abort.Panic:
                match expression:
                    Expr.Ident(name, _):
                        return (try_noncall_family_lookup(environment, name), try_noncall_family_known_nonfallible(environment, name))
                    Expr.Paren(inner, _):
                        return try_noncall_assignment_source_facts(inner, params, environment, annotations)
                    Expr.Call(callee, _, _, _):
                        callee_name: sview @source = try_noncall_unqualified_callable_name(callee)
                        callee_qualifier: sview @source = try_noncall_callable_qualifier(callee)
                        return ("", false) if callee_name == ""
                        if callee_qualifier == "":
                            return ("", false) if try_noncall_family_index(environment, callee_name) < environment.names.count
                            for parameter in params:
                                return ("", false) if parameter.name == callee_name
                        call_facts: (known: bool, family: sview @source, numeric: bool, integer: bool) = try_noncall_callable_source_facts(callee_name, callee_qualifier, callee, environment, annotations)
                        return (call_facts.family, call_facts.family == "") if call_facts.known
                        return ("", false)
                    Expr.If(condition, then_value, else_value, _):
                        then_environment: mutable TryNonCallErrorFamilyEnv = try_noncall_family_clone(environment)
                        for outer_name in environment.names |then_environment|:
                            # Pattern bindings established by the condition are visible in
                            # the true value and shadow any same-named outer fact.
                            if try_noncall_truthy_condition_binds_name(condition, outer_name, annotations):
                                condition_facts: (known_nonfallible: bool, numeric: bool, integer: bool) = try_noncall_condition_binding_facts(condition, outer_name, params, annotations)
                                try_noncall_family_bind(&then_environment, outer_name, "", condition_facts.known_nonfallible, condition_facts.numeric, condition_facts.integer)
                        then_facts: mutable (family: sview @source, known_nonfallible: bool) = try_noncall_assignment_source_facts(then_value, params, then_environment, annotations)
                        if not then_facts.known_nonfallible and then_facts.family == "" and then_value is Expr.Ident(then_binder, _) and try_noncall_truthy_condition_binds_name(condition, then_binder, annotations):
                            condition_facts: (known_nonfallible: bool, numeric: bool, integer: bool) = try_noncall_condition_binding_facts(condition, then_binder, params, annotations)
                            then_facts <- ("", condition_facts.known_nonfallible)
                        else_facts: (family: sview @source, known_nonfallible: bool) = try_noncall_assignment_source_facts(else_value, params, environment, annotations)
                        return (then_facts.family, false) if then_facts.family != "" and then_facts.family == else_facts.family
                        return (then_facts.family, false) if then_facts.family != "" and else_facts.family == "" and else_facts.known_nonfallible
                        return (else_facts.family, false) if else_facts.family != "" and then_facts.family == "" and then_facts.known_nonfallible
                        return ("", true) if then_facts.family == "" and else_facts.family == "" and then_facts.known_nonfallible and else_facts.known_nonfallible
                    Expr.Match(scrutinee, arms, _):
                        common_family: mutable sview @source = ""
                        saw_nonfallible: mutable bool = false
                        conflicting: mutable bool = false
                        unknown: mutable bool = false
                        scrutinee_facts: (known_nonfallible: bool, numeric: bool, integer: bool) = try_noncall_expression_value_facts(scrutinee, params, environment)
                        for arm in arms |common_family, saw_nonfallible, conflicting, unknown, scrutinee_facts, params, environment, annotations|:
                            if arm.body.count == 0:
                                unknown <- true
                            else:
                                arm_environment: mutable TryNonCallErrorFamilyEnv = try_noncall_family_clone(environment)
                                arm_binders: mutable darray[sview @source] = []
                                gather_arm_pattern(arm.pattern, arm_binders)
                                for arm_binder in arm_binders |arm_environment|:
                                    # A pattern binder shadows any same-named outer local.
                                    # Its value may come from the scrutinee, whose error
                                    # family isn't represented in this lightweight scan.
                                    pattern_facts: (known_nonfallible: bool, numeric: bool, integer: bool) = try_noncall_pattern_binding_facts(arm.pattern, arm_binder)
                                    binder_facts: mutable (known_nonfallible: bool, numeric: bool, integer: bool) = pattern_facts
                                    binder_facts <- scrutinee_facts if not pattern_facts.known_nonfallible and not pattern_facts.numeric and not pattern_facts.integer
                                    try_noncall_family_bind(&arm_environment, arm_binder, "", binder_facts.known_nonfallible, binder_facts.numeric, binder_facts.integer)
                                for outer_name in environment.names |arm_environment|:
                                    # Successful `is`/`as` bindings in a guard are visible
                                    # through the arm body and shadow same-named outer facts.
                                    if try_noncall_truthy_condition_binds_name(arm.guard, outer_name, annotations):
                                        guard_facts: (known_nonfallible: bool, numeric: bool, integer: bool) = try_noncall_condition_binding_facts(arm.guard, outer_name, params, annotations)
                                        try_noncall_family_bind(&arm_environment, outer_name, "", guard_facts.known_nonfallible, guard_facts.numeric, guard_facts.integer)
                                arm_facts: (family: sview @source, known_nonfallible: bool) = try_noncall_block_source_facts(arm.body, params, arm_environment, annotations)
                                if arm_facts.family != "":
                                    common_family <- arm_facts.family if common_family == ""
                                    conflicting <- true if common_family != arm_facts.family
                                elif arm_facts.known_nonfallible:
                                    saw_nonfallible <- true
                                else:
                                    unknown <- true
                        return (common_family, false) if not conflicting and not unknown and common_family != ""
                        return ("", true) if not conflicting and not unknown and common_family == "" and saw_nonfallible and arms.count > 0
                    Expr.Block(statements, value, _, _):
                        return try_noncall_block_source_facts(statements, params, environment, annotations, value)
                    Expr.Refinement(fallback, guarded, _):
                        if try_noncall_expression_is_try_fallback(expression, annotations):
                            guarded_facts: (family: sview @source, known_nonfallible: bool) = try_noncall_assignment_source_facts(guarded, params, environment, annotations)
                            fallback_facts: (family: sview @source, known_nonfallible: bool) = try_noncall_assignment_source_facts(fallback, params, environment, annotations)
                            return ("", true) if guarded_facts.family != "" and fallback_facts.known_nonfallible
                            return (fallback_facts.family, false) if guarded_facts.family != "" and fallback_facts.family != ""
                            return ("", false)
                        return try_noncall_assignment_source_facts(fallback, params, environment, annotations)
                    Expr.GetElse(guarded, _, _):
                        guarded_facts: (family: sview @source, known_nonfallible: bool) = try_noncall_assignment_source_facts(guarded, params, environment, annotations)
                        return ("", true) if guarded_facts.family != ""
                    Expr.Catch(guarded, arms, _):
                        common_family: mutable sview @source = ""
                        saw_nonfallible: mutable bool = false
                        conflicting: mutable bool = false
                        unknown: mutable bool = false
                        payload_facts: (known_nonfallible: bool, numeric: bool, integer: bool) = try_noncall_catch_success_payload_facts(guarded, params, environment, annotations)
                        for arm in arms |common_family, saw_nonfallible, conflicting, unknown, params, environment, annotations|:
                            if arm.body.count == 0:
                                unknown <- true
                            else:
                                arm_environment: mutable TryNonCallErrorFamilyEnv = try_noncall_family_clone(environment)
                                arm_binders: mutable darray[sview @source] = []
                                gather_arm_pattern(arm.pattern, arm_binders)
                                for arm_binder in arm_binders |arm_environment|:
                                    pattern_facts: (known_nonfallible: bool, numeric: bool, integer: bool) = try_noncall_pattern_binding_facts(arm.pattern, arm_binder)
                                    binder_facts: mutable (known_nonfallible: bool, numeric: bool, integer: bool) = pattern_facts
                                    binder_facts <- payload_facts if arm.pattern is Pattern.Binding(success_name) and success_name == arm_binder and payload_facts.known_nonfallible
                                    try_noncall_family_bind(&arm_environment, arm_binder, "", binder_facts.known_nonfallible, binder_facts.numeric, binder_facts.integer)
                                for outer_name in environment.names |arm_environment|:
                                    if try_noncall_truthy_condition_binds_name(arm.guard, outer_name, annotations):
                                        guard_facts: (known_nonfallible: bool, numeric: bool, integer: bool) = try_noncall_condition_binding_facts(arm.guard, outer_name, params, annotations)
                                        try_noncall_family_bind(&arm_environment, outer_name, "", guard_facts.known_nonfallible, guard_facts.numeric, guard_facts.integer)
                                arm_facts: (family: sview @source, known_nonfallible: bool) = try_noncall_block_source_facts(arm.body, params, arm_environment, annotations)
                                if arm_facts.family != "":
                                    common_family <- arm_facts.family if common_family == ""
                                    conflicting <- true if common_family != arm_facts.family
                                elif arm_facts.known_nonfallible:
                                    saw_nonfallible <- true
                                else:
                                    unknown <- true
                        return (common_family, false) if not conflicting and not unknown and common_family != ""
                        return ("", true) if not conflicting and not unknown and common_family == "" and saw_nonfallible and arms.count > 0
                    Expr.IntLit(_, _) | Expr.FloatLit(_, _) | Expr.StringLit(_, _) | Expr.CharLit(_, _) | Expr.BoolLit(_, _):
                        return ("", true)
                    Expr.Unary(TokenKind.Not, _, _):
                        return ("", true)
                    Expr.Unary(TokenKind.Minus, _, _) | Expr.Unary(TokenKind.Plus, _, _):
                        # Primitive numeric unary operators are nonfallible. A struct's
                        # overloaded `__neg__` can return an error union, so don't inherit
                        # its operand's nonfallible fact.
                        return ("", true) if try_noncall_numeric_value(expression, params, environment)
                    Expr.Binary(_, operator, _, _) if operator in {TokenKind.Plus, TokenKind.Minus, TokenKind.Star, TokenKind.Slash, TokenKind.Percent}:
                        return ("", true) if try_noncall_expression_is_known_nonfallible(expression, params, environment)
                    Expr.Binary(_, operator, _, _) if operator in {TokenKind.Ampersand, TokenKind.Pipe, TokenKind.Caret, TokenKind.LShift, TokenKind.RShift}:
                        return ("", true) if try_noncall_integer_value(expression, params, environment)
                    _:
                        pass
                return ("", false)

        # A match-expression arm may compute its value through a local alias (`copied =
        # load(); copied`). Analyze those statements in an arm-local snapshot before reading
        # the final expression, so its source family is available without escaping the arm.
        def try_noncall_block_source_facts(statements: darray[Ast::Stmt], params: darray[Ast::ParamDecl], environment: TryNonCallErrorFamilyEnv&, annotations: darray[Ast::EnumAnnotation]&, block_value: Ast::Expr? = null) -> (family: sview @source, known_nonfallible: bool):
            can Memory.Allocate, Abort.Panic:
                arm_environment: mutable TryNonCallErrorFamilyEnv = try_noncall_family_clone(environment)
                last_facts: mutable (family: sview @source, known_nonfallible: bool) = ("", false)
                for statement in statements |arm_environment, params, annotations, last_facts|:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, position):
                            declared_family: mutable sview @source = try_noncall_local_error_family(annotations, position.offset)
                            source_facts: (family: sview @source, known_nonfallible: bool) = try_noncall_assignment_source_facts(value, params, arm_environment, annotations)
                            declared_known_nonfallible: mutable bool = declared_family == "" and type_expression is not Expr.Absent
                            declared_type_facts: (known_nonfallible: bool, numeric: bool, integer: bool) = try_noncall_type_facts_with_aliases(type_expression, arm_environment)
                            declared_numeric: mutable bool = declared_type_facts.numeric
                            declared_integer: mutable bool = declared_type_facts.integer
                            if declared_family == "" and type_expression is Expr.Absent:
                                declared_family <- source_facts.family
                                declared_known_nonfallible <- source_facts.known_nonfallible
                                declared_numeric <- try_noncall_numeric_value(value, params, arm_environment)
                                declared_integer <- try_noncall_integer_value(value, params, arm_environment)
                            try_noncall_family_bind(&arm_environment, name, declared_family, declared_known_nonfallible, declared_numeric, declared_integer)
                        Stmt.Assign(target, operator, value, position) if operator == TokenKind.Assign:
                            source_environment: mutable TryNonCallErrorFamilyEnv = try_noncall_family_clone(arm_environment)
                            try_noncall_record_assignment_targets(target, value, "", params, &arm_environment, source_environment, annotations, position.line)
                        Stmt.Expr(value, _):
                            last_facts <- try_noncall_assignment_source_facts(value, params, arm_environment, annotations)
                        _:
                            last_facts <- ("", false)
                return try_noncall_assignment_source_facts(present_block_value, params, arm_environment, annotations) if block_value is present_block_value
                return last_facts if statements.count > 0 and statements[statements.count - 1] is Stmt.Expr(_, _)
                return ("", false)

        # Names introduced by a successful `is`/`as` test are visible only on the true
        # path, and the right operand of `and` sees bindings from its left operand.
        # `or` contributes only names bound by both alternatives; negation contributes
        # none. Keep this syntactic and conservative, matching resolve_flow's scope rules.
        def try_noncall_pattern_expression_binds_name(expression: Ast::Expr, candidate: sview) -> bool:
            can Abort.Panic:
                match expression:
                    Expr.Ident(name, _):
                        return name == candidate
                    Expr.Paren(inner, _):
                        return try_noncall_pattern_expression_binds_name(inner, candidate)
                    Expr.Call(_, arguments, _, _):
                        for argument in arguments:
                            return true if try_noncall_pattern_expression_binds_name(argument, candidate)
                    Expr.Array(elements, _) | Expr.Tuple(elements, _):
                        for element in elements:
                            return true if try_noncall_pattern_expression_binds_name(element, candidate)
                    Expr.Construct(_, fields, _):
                        for field in fields:
                            return true if try_noncall_pattern_expression_binds_name(field.value, candidate)
                    _:
                        pass
                return false

        def try_noncall_expression_is_try_fallback(expression: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&) -> bool:
            can Abort.Panic:
                position: Ast::Pos = Ast::expr_pos(expression)
                return any annotation in annotations where annotation.owner == "__try_fallback_expression" and annotation.line == position.line and annotation.offset == position.offset

        def try_noncall_variant_alias_binds_name(condition: Ast::Expr, candidate: sview, annotations: darray[Ast::EnumAnnotation]&) -> bool:
            can Abort.Panic:
                match condition:
                    Expr.Binary(_, TokenKind.Is, Expr.Field(_, _, variant_line), _):
                        return any annotation in annotations where annotation.owner == candidate and annotation.name == "__is_variant_alias" and annotation.line == variant_line.line
                    _:
                        return false

        def try_noncall_truthy_condition_binds_name(condition: Ast::Expr, candidate: sview, annotations: darray[Ast::EnumAnnotation]&) -> bool:
            can Abort.Panic:
                match condition:
                    Expr.Paren(inner, _):
                        return try_noncall_truthy_condition_binds_name(inner, candidate, annotations)
                    Expr.Binary(left, operator, right, _):
                        match operator:
                            TokenKind.And:
                                return try_noncall_truthy_condition_binds_name(left, candidate, annotations) or try_noncall_truthy_condition_binds_name(right, candidate, annotations)
                            TokenKind.Or:
                                return try_noncall_truthy_condition_binds_name(left, candidate, annotations) and try_noncall_truthy_condition_binds_name(right, candidate, annotations)
                            TokenKind.Is:
                                return try_noncall_pattern_expression_binds_name(right, candidate) or try_noncall_variant_alias_binds_name(condition, candidate, annotations)
                            TokenKind.As:
                                return try_noncall_pattern_expression_binds_name(right, candidate)
                            _:
                                pass
                    _:
                        pass
                return false

        def try_noncall_sequence_element_type_name(type_expression: Ast::Expr) -> sview @source:
            can Abort.Panic:
                match type_expression:
                    Expr.Unary(operator, inner, _) if operator in {TokenKind.Mutable, TokenKind.Ampersand, TokenKind.Static, TokenKind.Heap, TokenKind.Stack, TokenKind.Tail}:
                        return try_noncall_sequence_element_type_name(inner)
                    Expr.Paren(inner, _):
                        return try_noncall_sequence_element_type_name(inner)
                    Expr.Index(head, element, _):
                        if head is Expr.Ident(container, _) and container in {"darray", "view"}:
                            return ident_name_of(element)
                    _:
                        pass
                return ""

        def try_noncall_parameter_sequence_element_type_name(expression: Ast::Expr, params: darray[Ast::ParamDecl]) -> sview @source:
            can Abort.Panic:
                match expression:
                    Expr.Ident(name, _):
                        for parameter in params:
                            if parameter.name == name:
                                return try_noncall_sequence_element_type_name(parameter.type_expression)
                    Expr.Paren(inner, _):
                        return try_noncall_parameter_sequence_element_type_name(inner, params)
                    _:
                        pass
                return ""

        def try_noncall_condition_binding_facts(condition: Ast::Expr, candidate: sview, params: darray[Ast::ParamDecl], annotations: darray[Ast::EnumAnnotation]&) -> (known_nonfallible: bool, numeric: bool, integer: bool):
            can Abort.Panic:
                match condition:
                    Expr.Paren(inner, _):
                        return try_noncall_condition_binding_facts(inner, candidate, params, annotations)
                    Expr.Binary(left, TokenKind.And, right, _):
                        return try_noncall_condition_binding_facts(left, candidate, params, annotations) if try_noncall_truthy_condition_binds_name(left, candidate, annotations)
                        return try_noncall_condition_binding_facts(right, candidate, params, annotations)
                    Expr.Binary(left, TokenKind.Or, right, _):
                        return (false, false, false) if not try_noncall_truthy_condition_binds_name(left, candidate, annotations) or not try_noncall_truthy_condition_binds_name(right, candidate, annotations)
                        left_facts: (known_nonfallible: bool, numeric: bool, integer: bool) = try_noncall_condition_binding_facts(left, candidate, params, annotations)
                        right_facts: (known_nonfallible: bool, numeric: bool, integer: bool) = try_noncall_condition_binding_facts(right, candidate, params, annotations)
                        return left_facts if left_facts.known_nonfallible == right_facts.known_nonfallible and left_facts.numeric == right_facts.numeric and left_facts.integer == right_facts.integer
                    Expr.Binary(left, operator, right, _) if operator in {TokenKind.Is, TokenKind.As}:
                        return (false, false, false) if not try_noncall_pattern_expression_binds_name(right, candidate)
                        match right:
                            Expr.Array(_, _):
                                element_type: sview @source = try_noncall_parameter_sequence_element_type_name(left, params)
                                return try_noncall_type_name_facts(element_type) if element_type != ""
                            _:
                                pass
                    _:
                        pass
                return (false, false, false)

        def try_noncall_local_error_family(annotations: darray[Ast::EnumAnnotation]&, declaration_offset: u32) -> sview @source:
            can Abort.Panic:
                family: mutable sview @source = ""
                count: mutable usize = 0
                for candidate in annotations |family, count, declaration_offset|:
                    if candidate.owner == "__local_error_union" and candidate.offset == declaration_offset:
                        family <- candidate.name
                        count <- count + 1.usize()
                return family if count == 1
                return ""

        def try_noncall_lambda_error_family(annotations: darray[Ast::EnumAnnotation]&, lambda_offset: u32) -> sview @source:
            can Abort.Panic:
                family: mutable sview @source = ""
                count: mutable usize = 0
                for annotation in annotations |family, count, lambda_offset|:
                    if annotation.owner == "__fn_error_union" and annotation.offset == lambda_offset:
                        family <- annotation.name
                        count <- count + 1.usize()
                return family if count == 1
                return ""

        # Keep these sets aligned with resolve_types and scalar codegen. The parser's
        # lexical iN/uN policy is broader, but i128/u128 are not lowered, and uint/byte
        # are not recognized scalar names; treating them as numeric here would be unsound.
        def try_noncall_numeric_type(type_expression: Ast::Expr) -> bool:
            can Abort.Panic:
                match type_expression:
                    Expr.Ident(name, _):
                        return name in {"i8", "i16", "i32", "i64", "int", "isize", "u8", "u16", "u32", "u64", "usize", "uintptr", "f32", "f64", "char"}
                    Expr.Unary(operator, inner, _) if operator == TokenKind.Mutable or operator == TokenKind.Static or operator == TokenKind.Heap or operator == TokenKind.Stack or operator == TokenKind.Tail:
                        return try_noncall_numeric_type(inner)
                    Expr.Paren(inner, _):
                        return try_noncall_numeric_type(inner)
                    _:
                        return false

        def try_noncall_integer_type(type_expression: Ast::Expr) -> bool:
            can Abort.Panic:
                match type_expression:
                    Expr.Ident(name, _):
                        return name in {"i8", "i16", "i32", "i64", "int", "isize", "u8", "u16", "u32", "u64", "usize", "uintptr"}
                    Expr.Unary(operator, inner, _) if operator == TokenKind.Mutable or operator == TokenKind.Static or operator == TokenKind.Heap or operator == TokenKind.Stack or operator == TokenKind.Tail:
                        return try_noncall_integer_type(inner)
                    Expr.Paren(inner, _):
                        return try_noncall_integer_type(inner)
                    _:
                        return false

        def try_noncall_numeric_value(expression: Ast::Expr, params: darray[Ast::ParamDecl], environment: TryNonCallErrorFamilyEnv&) -> bool:
            can Abort.Panic:
                match expression:
                    Expr.IntLit(_, _) | Expr.FloatLit(_, _) | Expr.CharLit(_, _):
                        return true
                    Expr.Paren(inner, _):
                        return try_noncall_numeric_value(inner, params, environment)
                    Expr.Unary(TokenKind.Minus, inner, _) | Expr.Unary(TokenKind.Plus, inner, _):
                        return try_noncall_numeric_value(inner, params, environment)
                    Expr.Binary(left, operator, right, _) if operator in {TokenKind.Plus, TokenKind.Minus, TokenKind.Star, TokenKind.Slash, TokenKind.Percent}:
                        return try_noncall_numeric_value(left, params, environment) and try_noncall_numeric_value(right, params, environment)
                    Expr.Ident(name, _):
                        index: usize = try_noncall_family_index(environment, name)
                        return try_noncall_family_known_numeric(environment, name) if index < environment.names.count
                        for parameter in params:
                            if parameter.name == name:
                                parameter_type_facts: (known_nonfallible: bool, numeric: bool, integer: bool) = try_noncall_type_facts_with_aliases(parameter.type_expression, environment)
                                return parameter_type_facts.numeric
                    Expr.Call(callee, _, _, _):
                        callee_name: sview @source = try_noncall_unqualified_callable_name(callee)
                        callee_qualifier: sview @source = try_noncall_callable_qualifier(callee)
                        call_facts: (known: bool, family: sview @source, numeric: bool, integer: bool, ambiguous: bool) = try_noncall_callable_cached_facts(callee_name, callee_qualifier, callee, environment)
                        return call_facts.numeric if call_facts.known and call_facts.family == ""
                    Expr.Catch(guarded, arms, _):
                        catch_facts: (numeric: bool, integer: bool) = try_noncall_catch_result_facts(guarded, arms, params, environment)
                        return catch_facts.numeric
                    _:
                        pass
                return false

        def try_noncall_integer_value(expression: Ast::Expr, params: darray[Ast::ParamDecl], environment: TryNonCallErrorFamilyEnv&) -> bool:
            can Abort.Panic:
                match expression:
                    Expr.IntLit(_, _):
                        return true
                    Expr.Paren(inner, _):
                        return try_noncall_integer_value(inner, params, environment)
                    Expr.Unary(TokenKind.Minus, inner, _) | Expr.Unary(TokenKind.Plus, inner, _):
                        return try_noncall_integer_value(inner, params, environment)
                    Expr.Binary(left, operator, right, _) if operator in {TokenKind.Plus, TokenKind.Minus, TokenKind.Star, TokenKind.Slash, TokenKind.Percent, TokenKind.Ampersand, TokenKind.Pipe, TokenKind.Caret, TokenKind.LShift, TokenKind.RShift}:
                        return try_noncall_integer_value(left, params, environment) and try_noncall_integer_value(right, params, environment)
                    Expr.Ident(name, _):
                        index: usize = try_noncall_family_index(environment, name)
                        return environment.integer[index] if index < environment.names.count
                        for parameter in params:
                            if parameter.name == name:
                                parameter_type_facts: (known_nonfallible: bool, numeric: bool, integer: bool) = try_noncall_type_facts_with_aliases(parameter.type_expression, environment)
                                return parameter_type_facts.integer
                    Expr.Call(callee, _, _, _):
                        callee_name: sview @source = try_noncall_unqualified_callable_name(callee)
                        callee_qualifier: sview @source = try_noncall_callable_qualifier(callee)
                        call_facts: (known: bool, family: sview @source, numeric: bool, integer: bool, ambiguous: bool) = try_noncall_callable_cached_facts(callee_name, callee_qualifier, callee, environment)
                        return call_facts.integer if call_facts.known and call_facts.family == ""
                    Expr.Catch(guarded, arms, _):
                        catch_facts: (numeric: bool, integer: bool) = try_noncall_catch_result_facts(guarded, arms, params, environment)
                        return catch_facts.integer
                    _:
                        pass
                return false

        def try_noncall_catch_cached_payload_facts(expression: Ast::Expr, environment: TryNonCallErrorFamilyEnv&) -> (known: bool, numeric: bool, integer: bool):
            can Abort.Panic:
                match expression:
                    Expr.Ident(name, _):
                        index: usize = try_noncall_family_index(environment, name)
                        return (true, environment.numeric[index], environment.integer[index]) if index < environment.names.count and environment.families[index] != ""
                    Expr.Call(callee, _, _, _):
                        callee_name: sview @source = try_noncall_unqualified_callable_name(callee)
                        callee_qualifier: sview @source = try_noncall_callable_qualifier(callee)
                        call_facts: (known: bool, family: sview @source, numeric: bool, integer: bool, ambiguous: bool) = try_noncall_callable_cached_facts(callee_name, callee_qualifier, callee, environment)
                        return (true, call_facts.numeric, call_facts.integer) if call_facts.known and call_facts.family != ""
                    Expr.Paren(inner, _):
                        return try_noncall_catch_cached_payload_facts(inner, environment)
                    _:
                        pass
                return (false, false, false)

        def try_noncall_catch_result_facts(guarded: Ast::Expr, arms: darray[Ast::MatchArm], params: darray[Ast::ParamDecl], environment: TryNonCallErrorFamilyEnv&) -> (numeric: bool, integer: bool):
            can Memory.Allocate, Abort.Panic:
                payload_facts: (known: bool, numeric: bool, integer: bool) = try_noncall_catch_cached_payload_facts(guarded, environment)
                all_numeric: mutable bool = true
                all_integer: mutable bool = true
                has_continuing_arm: mutable bool = false
                for arm in arms |all_numeric, all_integer, has_continuing_arm, payload_facts, params, environment|:
                    arm_environment: mutable TryNonCallErrorFamilyEnv = try_noncall_family_clone(environment)
                    arm_binders: mutable darray[sview @source] = []
                    gather_arm_pattern(arm.pattern, arm_binders)
                    for arm_binder in arm_binders |arm_environment, arm, payload_facts|:
                        if arm.pattern is Pattern.Binding(success_name) and success_name == arm_binder and payload_facts.known:
                            try_noncall_family_bind(&arm_environment, arm_binder, "", payload_facts.known, payload_facts.numeric, payload_facts.integer)
                        else:
                            try_noncall_family_bind(&arm_environment, arm_binder, "")
                    arm_result: mutable Ast::Expr = Ast::Expr.Invalid
                    arm_continues: mutable bool = true
                    for statement in arm.body |arm_environment, params, arm_result, arm_continues|:
                        match statement:
                            Stmt.VarDecl(name, type_expression, value, _):
                                type_facts: (known_nonfallible: bool, numeric: bool, integer: bool) = try_noncall_type_facts_with_aliases(type_expression, arm_environment)
                                local_numeric: bool = type_facts.numeric if type_facts.known_nonfallible else try_noncall_numeric_value(value, params, arm_environment)
                                local_integer: bool = type_facts.integer if type_facts.known_nonfallible else try_noncall_integer_value(value, params, arm_environment)
                                try_noncall_family_bind(&arm_environment, name, "", local_numeric or local_integer, local_numeric, local_integer)
                                arm_result <- Ast::Expr.Invalid
                            Stmt.Assign(target, operator, value, _):
                                match target:
                                    Expr.Ident(name, _) if operator == TokenKind.Assign:
                                        local_numeric: bool = try_noncall_numeric_value(value, params, arm_environment)
                                        local_integer: bool = try_noncall_integer_value(value, params, arm_environment)
                                        try_noncall_family_bind(&arm_environment, name, "", local_numeric or local_integer, local_numeric, local_integer)
                                    _:
                                        pass
                                arm_result <- Ast::Expr.Invalid
                            Stmt.Expr(value, _):
                                arm_result <- value
                            Stmt.Return(value, _):
                                arm_result <- Ast::Expr.Invalid
                                arm_continues <- false
                            _:
                                arm_result <- Ast::Expr.Invalid
                    if arm_continues:
                        has_continuing_arm <- true
                        all_numeric <- false if arm_result is Ast::Expr.Invalid or not try_noncall_numeric_value(arm_result, params, arm_environment)
                        all_integer <- false if arm_result is Ast::Expr.Invalid or not try_noncall_integer_value(arm_result, params, arm_environment)
                return (has_continuing_arm and all_numeric, has_continuing_arm and all_integer)

        def try_noncall_record_unknown_assignment_target(target: Ast::Expr, candidate: sview, environment: mutable TryNonCallErrorFamilyEnv&, source_environment: TryNonCallErrorFamilyEnv&, annotations: darray[Ast::EnumAnnotation]&, line: u32) -> void:
            can Memory.Allocate, Abort.Panic:
                match target:
                    Expr.Ident(name, _) if name != candidate:
                        source_index: usize = try_noncall_family_index(source_environment, name)
                        preserve_existing: bool = try_noncall_rebind_claimed_target(annotations, line, name) and source_index < source_environment.names.count
                        if preserve_existing:
                            try_noncall_family_bind_with_origin(environment, name, source_environment.families[source_index], source_environment.known_nonfallible[source_index], source_environment.origins[source_index], source_environment.numeric[source_index], source_environment.integer[source_index])
                        else:
                            try_noncall_family_bind_with_origin(environment, name, "", false, environment.names.count, false)
                    Expr.Paren(inner, _):
                        try_noncall_record_unknown_assignment_target(inner, candidate, environment, source_environment, annotations, line)
                    Expr.Tuple(targets, _) | Expr.Array(targets, _):
                        for element in targets:
                            try_noncall_record_unknown_assignment_target(element, candidate, environment, source_environment, annotations, line)
                    _:
                        pass

        # Update ordinary assignment facts for every lexical target. The candidate-specific
        # path below also tracks shadow/family diagnostics; these sibling bindings still need
        # fresh numeric and family facts so a later alias cannot inherit a stale type.
        def try_noncall_record_assignment_targets(target: Ast::Expr, value: Ast::Expr, candidate: sview, params: darray[Ast::ParamDecl], environment: mutable TryNonCallErrorFamilyEnv&, source_environment: TryNonCallErrorFamilyEnv&, annotations: darray[Ast::EnumAnnotation]&, line: u32) -> void:
            can Memory.Allocate, Abort.Panic:
                match target:
                    Expr.Ident(name, _) if name != candidate:
                        source_index: usize = try_noncall_family_index(source_environment, name)
                        preserve_existing: bool = try_noncall_rebind_claimed_target(annotations, line, name) and source_index < source_environment.names.count
                        if preserve_existing:
                            try_noncall_family_bind_with_origin(environment, name, source_environment.families[source_index], source_environment.known_nonfallible[source_index], source_environment.origins[source_index], source_environment.numeric[source_index], source_environment.integer[source_index])
                        else:
                            # Read every RHS against the pre-assignment snapshot. Elisa
                            # destructuring evaluates its values before storing any target.
                            source_facts: (family: sview @source, known_nonfallible: bool) = try_noncall_assignment_source_facts(value, params, source_environment, annotations)
                            assigned_numeric: bool = try_noncall_numeric_value(value, params, source_environment)
                            assigned_integer: bool = try_noncall_integer_value(value, params, source_environment)
                            try_noncall_family_bind_with_origin(environment, name, source_facts.family, source_facts.known_nonfallible, environment.names.count, assigned_numeric, assigned_integer)
                    Expr.Paren(inner, _):
                        try_noncall_record_assignment_targets(inner, value, candidate, params, environment, source_environment, annotations, line)
                    Expr.Tuple(targets, _) | Expr.Array(targets, _):
                        match value:
                            Expr.Tuple(values, _) | Expr.Array(values, _):
                                if targets.count == values.count:
                                    for index in 0..<targets.count:
                                        try_noncall_record_assignment_targets(targets[index], values[index], candidate, params, environment, source_environment, annotations, line)
                                else:
                                    try_noncall_record_unknown_assignment_target(target, candidate, environment, source_environment, annotations, line)
                            _:
                                try_noncall_record_unknown_assignment_target(target, candidate, environment, source_environment, annotations, line)
                    _:
                        pass

        def try_noncall_target_numeric_value(target: Ast::Expr, value: Ast::Expr, candidate: sview, params: darray[Ast::ParamDecl], environment: TryNonCallErrorFamilyEnv&) -> (found: bool, numeric: bool):
            can Abort.Panic:
                match target:
                    Expr.Ident(name, _):
                        return (false, false) if name != candidate
                        return (true, try_noncall_numeric_value(value, params, environment))
                    Expr.Paren(inner, _):
                        return try_noncall_target_numeric_value(inner, value, candidate, params, environment)
                    Expr.Tuple(targets, _) | Expr.Array(targets, _):
                        match value:
                            Expr.Tuple(values, _) | Expr.Array(values, _):
                                return (true, false) if targets.count != values.count and try_noncall_target_binds_name(target, candidate)
                                for index in 0..<targets.count:
                                    if try_noncall_target_binds_name(targets[index], candidate):
                                        return try_noncall_target_numeric_value(targets[index], values[index], candidate, params, environment) if index < values.count
                                        return (true, false)
                            _:
                                pass
                        return (true, false) if try_noncall_target_binds_name(target, candidate)
                    _:
                        pass
                return (false, false)

        def try_noncall_target_integer_value(target: Ast::Expr, value: Ast::Expr, candidate: sview, params: darray[Ast::ParamDecl], environment: TryNonCallErrorFamilyEnv&) -> (found: bool, integer: bool):
            can Abort.Panic:
                match target:
                    Expr.Ident(name, _):
                        return (false, false) if name != candidate
                        return (true, try_noncall_integer_value(value, params, environment))
                    Expr.Paren(inner, _):
                        return try_noncall_target_integer_value(inner, value, candidate, params, environment)
                    Expr.Tuple(targets, _) | Expr.Array(targets, _):
                        match value:
                            Expr.Tuple(values, _) | Expr.Array(values, _):
                                return (true, false) if targets.count != values.count and try_noncall_target_binds_name(target, candidate)
                                for index in 0..<targets.count:
                                    if try_noncall_target_binds_name(targets[index], candidate):
                                        return try_noncall_target_integer_value(targets[index], values[index], candidate, params, environment) if index < values.count
                                        return (true, false)
                            _:
                                pass
                        return (true, false) if try_noncall_target_binds_name(target, candidate)
                    _:
                        pass
                return (false, false)

        def try_noncall_expression_is_known_nonfallible(expression: Ast::Expr, params: darray[Ast::ParamDecl], environment: TryNonCallErrorFamilyEnv&) -> bool:
            can Abort.Panic:
                match expression:
                    Expr.IntLit(_, _):
                        return true
                    Expr.FloatLit(_, _):
                        return true
                    Expr.StringLit(_, _):
                        return true
                    Expr.CharLit(_, _):
                        return true
                    Expr.BoolLit(_, _):
                        return true
                    Expr.Unary(TokenKind.Minus, _, _) | Expr.Unary(TokenKind.Plus, _, _):
                        return try_noncall_numeric_value(expression, params, environment)
                    Expr.Unary(TokenKind.Not, _, _):
                        return true
                    Expr.Paren(inner, _):
                        return try_noncall_expression_is_known_nonfallible(inner, params, environment)
                    Expr.Binary(left, operator, right, _) if operator in {TokenKind.Plus, TokenKind.Minus, TokenKind.Star, TokenKind.Slash, TokenKind.Percent}:
                        # Built-in arithmetic on primitive numeric operands cannot return an
                        # error union. Keep user-defined operator overloads unknown.
                        return try_noncall_numeric_value(left, params, environment) and try_noncall_numeric_value(right, params, environment)
                    Expr.Binary(left, operator, right, _) if operator in {TokenKind.Ampersand, TokenKind.Pipe, TokenKind.Caret, TokenKind.LShift, TokenKind.RShift}:
                        # Bitwise and shift operations are built-in only for integer
                        # operands; do not classify floating or overloaded expressions here.
                        return try_noncall_integer_value(left, params, environment) and try_noncall_integer_value(right, params, environment)
                    Expr.If(_, then_value, else_value, _):
                        # The conditional expression's result comes from its value branches;
                        # any nested `try` in the condition has its own annotation and is
                        # checked independently.
                        return try_noncall_expression_is_known_nonfallible(then_value, params, environment) and try_noncall_expression_is_known_nonfallible(else_value, params, environment)
                    _:
                        return false

        def try_noncall_scan_expression(expression: Ast::Expr, candidate: sview, params: darray[Ast::ParamDecl], environment: mutable TryNonCallErrorFamilyEnv&, annotations: darray[Ast::EnumAnnotation]&, annotation: Ast::EnumAnnotation, site_offset: u32, current_shadow: bool, current_local_error_family: sview @source, found: mutable bool&, shadowed_at_site: mutable bool&, local_error_family_at_site: mutable sview& @source, lambda_error_family_at_site: mutable sview& @source, inside_lambda_at_site: mutable bool&, known_nonfallible_at_site: mutable bool&) -> void:
            can Memory.Allocate, Abort.Panic:
                return if found == true
                local_shadow: mutable bool = current_shadow
                local_error_family: mutable sview @source = current_local_error_family
                position: Ast::Pos = Ast::expr_pos(expression)
                if position.line == annotation.line and position.offset == site_offset:
                    found <- true
                    shadowed_at_site <- local_shadow
                    local_error_family_at_site <- local_error_family
                    known_nonfallible_at_site <- try_noncall_family_known_nonfallible(environment, candidate) if candidate != ""
                    if candidate == "":
                        source_facts: (family: sview @source, known_nonfallible: bool) = try_noncall_assignment_source_facts(expression, params, environment, annotations)
                        local_error_family_at_site <- source_facts.family
                        known_nonfallible_at_site <- source_facts.known_nonfallible
                    return
                match expression:
                    Expr.Call(callee, arguments, _, _):
                        try_noncall_scan_expression(callee, candidate, params, environment, annotations, annotation, site_offset, current_shadow, current_local_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                        for argument in arguments |found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site|:
                            return if found == true
                            try_noncall_scan_expression(argument, candidate, params, environment, annotations, annotation, site_offset, current_shadow, current_local_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                    Expr.StaticEffectCall(_, _, candidates, arguments, _, _):
                        for effect_candidate in candidates |found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site|:
                            return if found == true
                            for capture in effect_candidate.captures |found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site|:
                                return if found == true
                                try_noncall_scan_expression(capture, candidate, params, environment, annotations, annotation, site_offset, current_shadow, current_local_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                        for argument in arguments |found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site|:
                            return if found == true
                            try_noncall_scan_expression(argument, candidate, params, environment, annotations, annotation, site_offset, current_shadow, current_local_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                    Expr.Binary(left, operator, right, _):
                        try_noncall_scan_expression(left, candidate, params, environment, annotations, annotation, site_offset, current_shadow, current_local_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                        right_shadow: mutable bool = local_shadow
                        right_error_family: mutable sview = local_error_family
                        visible_count: usize = environment.names.count
                        base_environment: mutable TryNonCallErrorFamilyEnv = try_noncall_family_clone(environment)
                        right_environment: mutable TryNonCallErrorFamilyEnv = try_noncall_family_clone(base_environment)
                        if operator == TokenKind.And and try_noncall_truthy_condition_binds_name(left, candidate, annotations):
                            right_shadow <- true
                            right_error_family <- ""
                            condition_facts: (known_nonfallible: bool, numeric: bool, integer: bool) = try_noncall_condition_binding_facts(left, candidate, params, annotations)
                            try_noncall_family_bind(right_environment, candidate, "", condition_facts.known_nonfallible, condition_facts.numeric, condition_facts.integer)
                        try_noncall_scan_expression(right, candidate, params, right_environment, annotations, annotation, site_offset, right_shadow, right_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                        if operator == TokenKind.And or operator == TokenKind.Or:
                            try_noncall_family_join_into(environment, base_environment, base_environment, right_environment, visible_count)
                        else:
                            try_noncall_family_join_into(environment, base_environment, right_environment, right_environment, visible_count)
                        if try_noncall_family_branch_wrote(base_environment, right_environment, candidate):
                            local_shadow <- true
                            local_error_family <- try_noncall_family_lookup(environment, candidate)
                    Expr.Paren(inner, _):
                        try_noncall_scan_expression(inner, candidate, params, environment, annotations, annotation, site_offset, current_shadow, current_local_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                    Expr.Field(object, _, _) | Expr.Scope(object, _, _):
                        try_noncall_scan_expression(object, candidate, params, environment, annotations, annotation, site_offset, current_shadow, current_local_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                    Expr.Index(object, index, _):
                        try_noncall_scan_expression(object, candidate, params, environment, annotations, annotation, site_offset, current_shadow, current_local_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                        try_noncall_scan_expression(index, candidate, params, environment, annotations, annotation, site_offset, current_shadow, current_local_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                    Expr.IndexN(object, arguments, _):
                        try_noncall_scan_expression(object, candidate, params, environment, annotations, annotation, site_offset, current_shadow, current_local_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                        for argument in arguments |found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site|:
                            return if found == true
                            try_noncall_scan_expression(argument, candidate, params, environment, annotations, annotation, site_offset, current_shadow, current_local_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                    Expr.Slice(object, low, high, _):
                        try_noncall_scan_expression(object, candidate, params, environment, annotations, annotation, site_offset, current_shadow, current_local_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                        try_noncall_scan_expression(low, candidate, params, environment, annotations, annotation, site_offset, current_shadow, current_local_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                        try_noncall_scan_expression(high, candidate, params, environment, annotations, annotation, site_offset, current_shadow, current_local_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                    Expr.Unary(_, operand, _) | Expr.Move(operand, _) | Expr.RegionNew(operand, _, _):
                        try_noncall_scan_expression(operand, candidate, params, environment, annotations, annotation, site_offset, current_shadow, current_local_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                    Expr.Array(elements, _) | Expr.Tuple(elements, _) | Expr.SetLit(elements, _):
                        for element in elements |found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site|:
                            return if found == true
                            try_noncall_scan_expression(element, candidate, params, environment, annotations, annotation, site_offset, current_shadow, current_local_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                    Expr.DictLit(entries, _):
                        for entry in entries |found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site|:
                            return if found == true
                            try_noncall_scan_expression(entry.key, candidate, params, environment, annotations, annotation, site_offset, current_shadow, current_local_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                            try_noncall_scan_expression(entry.value, candidate, params, environment, annotations, annotation, site_offset, current_shadow, current_local_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                    Expr.Construct(type_expression, fields, _) | Expr.RecordUpdate(type_expression, fields, _):
                        try_noncall_scan_expression(type_expression, candidate, params, environment, annotations, annotation, site_offset, current_shadow, current_local_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                        for field in fields |found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site|:
                            return if found == true
                            try_noncall_scan_expression(field.value, candidate, params, environment, annotations, annotation, site_offset, current_shadow, current_local_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                    Expr.If(condition, then_value, else_value, _):
                        try_noncall_scan_expression(condition, candidate, params, environment, annotations, annotation, site_offset, current_shadow, current_local_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                        visible_count: usize = environment.names.count
                        base_environment: mutable TryNonCallErrorFamilyEnv = try_noncall_family_clone(environment)
                        then_shadow: mutable bool = current_shadow
                        then_error_family: mutable sview = current_local_error_family
                        then_environment: mutable TryNonCallErrorFamilyEnv = try_noncall_family_clone(base_environment)
                        else_environment: mutable TryNonCallErrorFamilyEnv = try_noncall_family_clone(base_environment)
                        if try_noncall_truthy_condition_binds_name(condition, candidate, annotations):
                            then_shadow <- true
                            then_error_family <- ""
                            condition_facts: (known_nonfallible: bool, numeric: bool, integer: bool) = try_noncall_condition_binding_facts(condition, candidate, params, annotations)
                            try_noncall_family_bind(then_environment, candidate, "", condition_facts.known_nonfallible, condition_facts.numeric, condition_facts.integer)
                        try_noncall_scan_expression(then_value, candidate, params, then_environment, annotations, annotation, site_offset, then_shadow, then_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                        try_noncall_scan_expression(else_value, candidate, params, else_environment, annotations, annotation, site_offset, current_shadow, current_local_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                        try_noncall_family_join_into(environment, base_environment, then_environment, else_environment, visible_count)
                        if try_noncall_family_branch_wrote(base_environment, then_environment, candidate) or try_noncall_family_branch_wrote(base_environment, else_environment, candidate):
                            local_shadow <- true
                            local_error_family <- try_noncall_family_lookup(environment, candidate)
                    Expr.Match(scrutinee, arms, _):
                        try_noncall_scan_expression(scrutinee, candidate, params, environment, annotations, annotation, site_offset, current_shadow, current_local_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                        visible_count: usize = environment.names.count
                        base_environment: mutable TryNonCallErrorFamilyEnv = try_noncall_family_clone(environment)
                        scrutinee_facts: (known_nonfallible: bool, numeric: bool, integer: bool) = try_noncall_expression_value_facts(scrutinee, params, base_environment)
                        merged_arms: mutable TryNonCallErrorFamilyEnv = TryNonCallErrorFamilyEnv{}
                        merged_ready: mutable bool = false
                        candidate_wrote: mutable bool = false
                        for arm in arms |found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site, scrutinee_facts|:
                            return if found == true
                            binds_candidate: bool = try_noncall_pattern_shadows_name(arm.pattern, candidate)
                            arm_shadow: bool = current_shadow or binds_candidate
                            arm_error_family: sview = "" if binds_candidate else current_local_error_family
                            arm_environment: mutable TryNonCallErrorFamilyEnv = try_noncall_family_clone(base_environment)
                            if binds_candidate:
                                pattern_facts: (known_nonfallible: bool, numeric: bool, integer: bool) = try_noncall_pattern_binding_facts(arm.pattern, candidate)
                                binder_facts: mutable (known_nonfallible: bool, numeric: bool, integer: bool) = pattern_facts
                                binder_facts <- scrutinee_facts if not pattern_facts.known_nonfallible and not pattern_facts.numeric and not pattern_facts.integer
                                try_noncall_family_bind(arm_environment, candidate, "", binder_facts.known_nonfallible, binder_facts.numeric, binder_facts.integer)
                            try_noncall_scan_expression(arm.guard, candidate, params, arm_environment, annotations, annotation, site_offset, arm_shadow, arm_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                            guard_binds_candidate: bool = try_noncall_truthy_condition_binds_name(arm.guard, candidate, annotations)
                            body_shadow: bool = arm_shadow or guard_binds_candidate
                            body_error_family: sview = "" if guard_binds_candidate else arm_error_family
                            if guard_binds_candidate:
                                guard_facts: (known_nonfallible: bool, numeric: bool, integer: bool) = try_noncall_condition_binding_facts(arm.guard, candidate, params, annotations)
                                try_noncall_family_bind(arm_environment, candidate, "", guard_facts.known_nonfallible, guard_facts.numeric, guard_facts.integer)
                            try_noncall_scan_statements(arm.body, candidate, params, arm_environment, annotations, annotation, site_offset, body_shadow, body_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                            candidate_wrote <- true if try_noncall_family_branch_wrote(base_environment, arm_environment, candidate)
                            if not merged_ready:
                                merged_arms <- try_noncall_family_clone(arm_environment)
                                merged_ready <- true
                            else:
                                prior_merged: mutable TryNonCallErrorFamilyEnv = try_noncall_family_clone(merged_arms)
                                merged_arms <- try_noncall_family_clone(base_environment)
                                try_noncall_family_join_into(merged_arms, base_environment, prior_merged, arm_environment, visible_count)
                        if merged_ready:
                            try_noncall_family_join_into(environment, base_environment, base_environment, merged_arms, visible_count)
                            if candidate_wrote:
                                local_shadow <- true
                                local_error_family <- try_noncall_family_lookup(environment, candidate)
                    Expr.Catch(guarded, arms, _):
                        try_noncall_scan_expression(guarded, candidate, params, environment, annotations, annotation, site_offset, current_shadow, current_local_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                        visible_count: usize = environment.names.count
                        base_environment: mutable TryNonCallErrorFamilyEnv = try_noncall_family_clone(environment)
                        payload_facts: (known_nonfallible: bool, numeric: bool, integer: bool) = try_noncall_catch_success_payload_facts(guarded, params, base_environment, annotations)
                        merged_arms: mutable TryNonCallErrorFamilyEnv = try_noncall_family_clone(base_environment)
                        candidate_wrote: mutable bool = false
                        for arm in arms |found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site|:
                            return if found == true
                            binds_candidate: bool = try_noncall_pattern_shadows_name(arm.pattern, candidate)
                            arm_shadow: bool = current_shadow or binds_candidate
                            arm_error_family: sview = "" if binds_candidate else current_local_error_family
                            arm_environment: mutable TryNonCallErrorFamilyEnv = try_noncall_family_clone(base_environment)
                            if binds_candidate:
                                pattern_facts: (known_nonfallible: bool, numeric: bool, integer: bool) = try_noncall_pattern_binding_facts(arm.pattern, candidate)
                                binder_facts: mutable (known_nonfallible: bool, numeric: bool, integer: bool) = pattern_facts
                                binder_facts <- payload_facts if arm.pattern is Pattern.Binding(success_name) and success_name == candidate and payload_facts.known_nonfallible
                                try_noncall_family_bind(arm_environment, candidate, "", binder_facts.known_nonfallible, binder_facts.numeric, binder_facts.integer)
                            try_noncall_scan_expression(arm.guard, candidate, params, arm_environment, annotations, annotation, site_offset, arm_shadow, arm_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                            guard_binds_candidate: bool = try_noncall_truthy_condition_binds_name(arm.guard, candidate, annotations)
                            body_shadow: bool = arm_shadow or guard_binds_candidate
                            body_error_family: sview = "" if guard_binds_candidate else arm_error_family
                            if guard_binds_candidate:
                                guard_facts: (known_nonfallible: bool, numeric: bool, integer: bool) = try_noncall_condition_binding_facts(arm.guard, candidate, params, annotations)
                                try_noncall_family_bind(arm_environment, candidate, "", guard_facts.known_nonfallible, guard_facts.numeric, guard_facts.integer)
                            try_noncall_scan_statements(arm.body, candidate, params, arm_environment, annotations, annotation, site_offset, body_shadow, body_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                            candidate_wrote <- true if try_noncall_family_branch_wrote(base_environment, arm_environment, candidate)
                            prior_merged: mutable TryNonCallErrorFamilyEnv = try_noncall_family_clone(merged_arms)
                            merged_arms <- try_noncall_family_clone(base_environment)
                            try_noncall_family_join_into(merged_arms, base_environment, prior_merged, arm_environment, visible_count)
                        if arms.count > 0:
                            try_noncall_family_join_into(environment, base_environment, base_environment, merged_arms, visible_count)
                            if candidate_wrote:
                                local_shadow <- true
                                local_error_family <- try_noncall_family_lookup(environment, candidate)
                    Expr.Comprehension(variable, iterable, condition, body, _, _):
                        try_noncall_scan_expression(iterable, candidate, params, environment, annotations, annotation, site_offset, current_shadow, current_local_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                        comprehension_binds_candidate: bool = variable == candidate
                        comprehension_shadow: bool = current_shadow or comprehension_binds_candidate
                        comprehension_error_family: sview = "" if comprehension_binds_candidate else current_local_error_family
                        comprehension_environment: mutable TryNonCallErrorFamilyEnv = try_noncall_family_clone(environment)
                        try_noncall_family_bind(comprehension_environment, variable, "", false) if variable != ""
                        try_noncall_scan_expression(condition, candidate, params, comprehension_environment, annotations, annotation, site_offset, comprehension_shadow, comprehension_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                        try_noncall_scan_expression(body, candidate, params, comprehension_environment, annotations, annotation, site_offset, comprehension_shadow, comprehension_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                    Expr.Refinement(base, predicate, _):
                        try_noncall_scan_expression(base, candidate, params, environment, annotations, annotation, site_offset, current_shadow, current_local_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                        try_noncall_scan_expression(predicate, candidate, params, environment, annotations, annotation, site_offset, current_shadow, current_local_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                    Expr.GetElse(guarded, recovery, _):
                        visible_count: usize = environment.names.count
                        base_environment: mutable TryNonCallErrorFamilyEnv = try_noncall_family_clone(environment)
                        guarded_environment: mutable TryNonCallErrorFamilyEnv = try_noncall_family_clone(base_environment)
                        recovery_environment: mutable TryNonCallErrorFamilyEnv = try_noncall_family_clone(environment)
                        try_noncall_scan_expression(guarded, candidate, params, guarded_environment, annotations, annotation, site_offset, current_shadow, current_local_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                        try_noncall_scan_statements(recovery, candidate, params, recovery_environment, annotations, annotation, site_offset, current_shadow, current_local_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                        try_noncall_family_join_into(environment, base_environment, guarded_environment, recovery_environment, visible_count)
                        if try_noncall_family_branch_wrote(base_environment, guarded_environment, candidate) or try_noncall_family_branch_wrote(base_environment, recovery_environment, candidate):
                            local_shadow <- true
                            local_error_family <- try_noncall_family_lookup(environment, candidate)
                    Expr.Block(block_statements, value, _, _):
                        visible_count: usize = environment.names.count
                        base_environment: mutable TryNonCallErrorFamilyEnv = try_noncall_family_clone(environment)
                        block_families: mutable TryNonCallErrorFamilyEnv = try_noncall_family_clone(environment)
                        block_environment: (shadow: bool, local_error_family: sview) = try_noncall_scan_statements(block_statements, candidate, params, block_families, annotations, annotation, site_offset, local_shadow, local_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                        try_noncall_scan_expression(value, candidate, params, block_families, annotations, annotation, site_offset, block_environment.shadow, block_environment.local_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                        try_noncall_family_join_into(environment, base_environment, block_families, block_families, visible_count)
                        if try_noncall_family_branch_wrote(base_environment, block_families, candidate):
                            local_shadow <- true
                            local_error_family <- try_noncall_family_lookup(environment, candidate)
                    Expr.Lambda(lambda_parameters, lambda_body, _):
                        lambda_shadow: mutable bool = current_shadow
                        lambda_error_family: mutable sview @source = local_error_family
                        lambda_environment: mutable TryNonCallErrorFamilyEnv = try_noncall_family_clone(environment)
                        lambda_position: Ast::Pos = Ast::expr_pos(expression)
                        lambda_destination_family: sview @source = try_noncall_lambda_error_family(annotations, lambda_position.offset)
                        for parameter in lambda_parameters |lambda_shadow, lambda_error_family, lambda_environment, candidate, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site|:
                            # Lambda parameters have names but no parameter type rows in
                            # this AST. Contextual typing may make them fallible, so do not
                            # classify an unknown parameter as a known scalar.
                            try_noncall_family_bind(lambda_environment, parameter, "", false)
                            if parameter == candidate:
                                lambda_shadow <- true
                                lambda_error_family <- ""
                        try_noncall_scan_statements(lambda_body, candidate, params, lambda_environment, annotations, annotation, site_offset, lambda_shadow, lambda_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                        if found == true and inside_lambda_at_site == false:
                            inside_lambda_at_site <- true
                            lambda_error_family_at_site <- lambda_destination_family
                    _:
                        pass

        # Scan statements in order and pass only bindings active along the path containing
        # the operand. Later declarations and sibling blocks do not shadow an earlier use.
        def try_noncall_scan_statements(statements: darray[Ast::Stmt], candidate: sview, params: darray[Ast::ParamDecl], environment: mutable TryNonCallErrorFamilyEnv&, annotations: darray[Ast::EnumAnnotation]&, annotation: Ast::EnumAnnotation, site_offset: u32, inherited_shadow: bool, inherited_local_error_family: sview @source, found: mutable bool&, shadowed_at_site: mutable bool&, local_error_family_at_site: mutable sview& @source, lambda_error_family_at_site: mutable sview& @source, inside_lambda_at_site: mutable bool&, known_nonfallible_at_site: mutable bool&) -> (shadow: bool, local_error_family: sview @source):
            can Memory.Allocate, Abort.Panic:
                local_shadow: mutable bool = inherited_shadow
                local_error_family: mutable sview @source = inherited_local_error_family
                for statement in statements |local_shadow, local_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site|:
                    return (local_shadow, local_error_family) if found == true
                    match statement:
                        Stmt.Expr(expression, _):
                            expression_base: mutable TryNonCallErrorFamilyEnv = try_noncall_family_clone(environment)
                            try_noncall_scan_expression(expression, candidate, params, environment, annotations, annotation, site_offset, local_shadow, local_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                            if try_noncall_family_branch_wrote(expression_base, environment, candidate):
                                local_shadow <- true
                                local_error_family <- try_noncall_family_lookup(environment, candidate)
                        Stmt.VarDecl(name, type_expression, value, position):
                            try_noncall_scan_expression(value, candidate, params, environment, annotations, annotation, site_offset, local_shadow, local_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                            declared_family: mutable sview @source = try_noncall_local_error_family(annotations, position.offset)
                            declared_known_nonfallible: mutable bool = declared_family == "" and type_expression is not Expr.Absent
                            declared_type_facts: (known_nonfallible: bool, numeric: bool, integer: bool) = try_noncall_type_facts_with_aliases(type_expression, environment)
                            declared_numeric: mutable bool = declared_type_facts.numeric
                            declared_integer: mutable bool = declared_type_facts.integer
                            if declared_family == "" and type_expression is Expr.Absent:
                                source_facts: (family: sview @source, known_nonfallible: bool) = try_noncall_assignment_source_facts(value, params, environment, annotations)
                                declared_family <- source_facts.family
                                declared_known_nonfallible <- source_facts.known_nonfallible
                                declared_numeric <- try_noncall_numeric_value(value, params, environment)
                                declared_integer <- try_noncall_integer_value(value, params, environment)
                            try_noncall_family_bind(environment, name, declared_family, declared_known_nonfallible, declared_numeric, declared_integer)
                            if name == candidate:
                                local_shadow <- true
                                local_error_family <- declared_family
                        Stmt.Assign(target, operator, value, assignment_position):
                            try_noncall_scan_expression(value, candidate, params, environment, annotations, annotation, site_offset, local_shadow, local_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                            assignment_source_environment: mutable TryNonCallErrorFamilyEnv = try_noncall_family_clone(environment)
                            assigned_facts: (found: bool, family: sview, known_nonfallible: bool) = try_noncall_target_source_facts(target, value, candidate, params, assignment_source_environment, annotations) if operator == TokenKind.Assign else (false, "", false)
                            assigned_numeric_facts: (found: bool, numeric: bool) = try_noncall_target_numeric_value(target, value, candidate, params, assignment_source_environment) if operator == TokenKind.Assign else (false, false)
                            assigned_integer_facts: (found: bool, integer: bool) = try_noncall_target_integer_value(target, value, candidate, params, assignment_source_environment) if operator == TokenKind.Assign else (false, false)
                            try_noncall_record_assignment_targets(target, value, candidate, params, environment, assignment_source_environment, annotations, assignment_position.line) if operator == TokenKind.Assign
                            try_noncall_scan_expression(target, candidate, params, environment, annotations, annotation, site_offset, local_shadow, local_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                            if assigned_facts.found:
                                existing_index: usize = try_noncall_family_index(environment, candidate)
                                rebind_claim: bool = try_noncall_rebind_claimed_target(annotations, assignment_position.line, candidate)
                                preserve_existing: bool = rebind_claim and existing_index < environment.names.count
                                assigned_family: sview @source = environment.families[existing_index] if preserve_existing else assigned_facts.family
                                assigned_known_nonfallible: bool = environment.known_nonfallible[existing_index] if preserve_existing else assigned_facts.known_nonfallible
                                assigned_origin: usize = environment.origins[existing_index] if preserve_existing else environment.names.count
                                assigned_numeric: bool = environment.numeric[existing_index] if preserve_existing else assigned_numeric_facts.numeric
                                assigned_integer: bool = environment.integer[existing_index] if preserve_existing else assigned_integer_facts.integer
                                try_noncall_family_bind_with_origin(environment, candidate, assigned_family, assigned_known_nonfallible, assigned_origin, assigned_numeric, assigned_integer)
                                if not preserve_existing:
                                    local_shadow <- true
                                    local_error_family <- assigned_family
                        Stmt.Return(value, _):
                            if value is returned:
                                try_noncall_scan_expression(returned, candidate, params, environment, annotations, annotation, site_offset, local_shadow, local_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                        Stmt.If(condition, then_body, else_body, _):
                            try_noncall_scan_expression(condition, candidate, params, environment, annotations, annotation, site_offset, local_shadow, local_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                            visible_count: usize = environment.names.count
                            base_environment: mutable TryNonCallErrorFamilyEnv = try_noncall_family_clone(environment)
                            then_shadow: mutable bool = local_shadow
                            then_error_family: mutable sview = local_error_family
                            then_environment: mutable TryNonCallErrorFamilyEnv = try_noncall_family_clone(base_environment)
                            else_environment: mutable TryNonCallErrorFamilyEnv = try_noncall_family_clone(base_environment)
                            if try_noncall_truthy_condition_binds_name(condition, candidate, annotations):
                                then_shadow <- true
                                then_error_family <- ""
                                condition_facts: (known_nonfallible: bool, numeric: bool, integer: bool) = try_noncall_condition_binding_facts(condition, candidate, params, annotations)
                                try_noncall_family_bind(then_environment, candidate, "", condition_facts.known_nonfallible, condition_facts.numeric, condition_facts.integer)
                            try_noncall_scan_statements(then_body, candidate, params, then_environment, annotations, annotation, site_offset, then_shadow, then_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                            try_noncall_scan_statements(else_body, candidate, params, else_environment, annotations, annotation, site_offset, local_shadow, local_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                            try_noncall_family_join_into(environment, base_environment, then_environment, else_environment, visible_count)
                            if try_noncall_family_branch_wrote(base_environment, then_environment, candidate) or try_noncall_family_branch_wrote(base_environment, else_environment, candidate):
                                local_shadow <- true
                                local_error_family <- try_noncall_family_lookup(environment, candidate)
                        Stmt.While(condition, body, _):
                            try_noncall_scan_expression(condition, candidate, params, environment, annotations, annotation, site_offset, local_shadow, local_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                            visible_count: usize = environment.names.count
                            base_environment: mutable TryNonCallErrorFamilyEnv = try_noncall_family_clone(environment)
                            body_shadow: mutable bool = local_shadow
                            body_error_family: mutable sview = local_error_family
                            loop_environment: mutable TryNonCallErrorFamilyEnv = try_noncall_family_clone(base_environment)
                            if try_noncall_truthy_condition_binds_name(condition, candidate, annotations):
                                body_shadow <- true
                                body_error_family <- ""
                                condition_facts: (known_nonfallible: bool, numeric: bool, integer: bool) = try_noncall_condition_binding_facts(condition, candidate, params, annotations)
                                try_noncall_family_bind(loop_environment, candidate, "", condition_facts.known_nonfallible, condition_facts.numeric, condition_facts.integer)
                            try_noncall_scan_statements(body, candidate, params, loop_environment, annotations, annotation, site_offset, body_shadow, body_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                            try_noncall_family_join_into(environment, base_environment, base_environment, loop_environment, visible_count)
                            if try_noncall_family_branch_wrote(base_environment, loop_environment, candidate):
                                local_shadow <- true
                                local_error_family <- try_noncall_family_lookup(environment, candidate)
                        Stmt.For(_, variables, iterable, body, _):
                            try_noncall_scan_expression(iterable, candidate, params, environment, annotations, annotation, site_offset, local_shadow, local_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                            visible_count: usize = environment.names.count
                            base_environment: mutable TryNonCallErrorFamilyEnv = try_noncall_family_clone(environment)
                            loop_binds_name: bool = any variable in variables where variable == candidate
                            loop_shadow: bool = local_shadow or loop_binds_name
                            loop_error_family: mutable sview = local_error_family
                            loop_error_family <- "" if loop_binds_name
                            loop_environment: mutable TryNonCallErrorFamilyEnv = try_noncall_family_clone(base_environment)
                            for variable in variables |loop_environment|:
                                try_noncall_family_bind(loop_environment, variable, "")
                            try_noncall_scan_statements(body, candidate, params, loop_environment, annotations, annotation, site_offset, loop_shadow, loop_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                            try_noncall_family_join_into(environment, base_environment, base_environment, loop_environment, visible_count)
                            if not loop_binds_name and try_noncall_family_branch_wrote(base_environment, loop_environment, candidate):
                                local_shadow <- true
                                local_error_family <- try_noncall_family_lookup(environment, candidate)
                        Stmt.Block(kind, _, binding, body, _):
                            visible_count: usize = environment.names.count
                            base_environment: mutable TryNonCallErrorFamilyEnv = try_noncall_family_clone(environment)
                            block_shadow: bool = local_shadow or binding == candidate
                            block_error_family: mutable sview = local_error_family
                            block_error_family <- "" if binding == candidate
                            block_environment: mutable TryNonCallErrorFamilyEnv = try_noncall_family_clone(base_environment)
                            try_noncall_family_bind(block_environment, binding, "") if binding != ""
                            try_noncall_scan_statements(body, candidate, params, block_environment, annotations, annotation, site_offset, block_shadow, block_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                            # Ordinary scoped blocks execute in sequence, so writes to
                            # bindings visible on entry flow back. Static blocks may be
                            # static-if alternatives; do not let one syntactic branch
                            # become unconditional source-order state.
                            if kind != "static":
                                try_noncall_family_join_into(environment, base_environment, block_environment, block_environment, visible_count)
                                if try_noncall_family_branch_wrote(base_environment, block_environment, candidate):
                                    local_shadow <- true
                                    local_error_family <- try_noncall_family_lookup(environment, candidate)
                        Stmt.Match(scrutinee, arms, _):
                            try_noncall_scan_expression(scrutinee, candidate, params, environment, annotations, annotation, site_offset, local_shadow, local_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                            visible_count: usize = environment.names.count
                            base_environment: mutable TryNonCallErrorFamilyEnv = try_noncall_family_clone(environment)
                            scrutinee_facts: (known_nonfallible: bool, numeric: bool, integer: bool) = try_noncall_expression_value_facts(scrutinee, params, base_environment)
                            merged_arms: mutable TryNonCallErrorFamilyEnv = TryNonCallErrorFamilyEnv{}
                            merged_ready: mutable bool = false
                            candidate_wrote: mutable bool = false
                            for arm in arms |local_shadow, local_error_family, candidate, annotations, annotation, site_offset, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site, merged_arms, merged_ready, candidate_wrote, scrutinee_facts|:
                                return (local_shadow, local_error_family) if found == true
                                pattern_binds_candidate: bool = try_noncall_pattern_shadows_name(arm.pattern, candidate)
                                arm_shadow: bool = local_shadow or pattern_binds_candidate
                                arm_error_family: sview = "" if pattern_binds_candidate else local_error_family
                                arm_environment: mutable TryNonCallErrorFamilyEnv = try_noncall_family_clone(base_environment)
                                if pattern_binds_candidate:
                                    pattern_facts: (known_nonfallible: bool, numeric: bool, integer: bool) = try_noncall_pattern_binding_facts(arm.pattern, candidate)
                                    binder_facts: mutable (known_nonfallible: bool, numeric: bool, integer: bool) = pattern_facts
                                    binder_facts <- scrutinee_facts if not pattern_facts.known_nonfallible and not pattern_facts.numeric and not pattern_facts.integer
                                    try_noncall_family_bind(arm_environment, candidate, "", binder_facts.known_nonfallible, binder_facts.numeric, binder_facts.integer)
                                try_noncall_scan_expression(arm.guard, candidate, params, arm_environment, annotations, annotation, site_offset, arm_shadow, arm_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                                guard_binds_candidate: bool = try_noncall_truthy_condition_binds_name(arm.guard, candidate, annotations)
                                body_shadow: bool = arm_shadow or guard_binds_candidate
                                body_error_family: sview = "" if guard_binds_candidate else arm_error_family
                                if guard_binds_candidate:
                                    guard_facts: (known_nonfallible: bool, numeric: bool, integer: bool) = try_noncall_condition_binding_facts(arm.guard, candidate, params, annotations)
                                    try_noncall_family_bind(arm_environment, candidate, "", guard_facts.known_nonfallible, guard_facts.numeric, guard_facts.integer)
                                try_noncall_scan_statements(arm.body, candidate, params, arm_environment, annotations, annotation, site_offset, body_shadow, body_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                                candidate_wrote <- true if try_noncall_family_branch_wrote(base_environment, arm_environment, candidate)
                                if not merged_ready:
                                    merged_arms <- try_noncall_family_clone(arm_environment)
                                    merged_ready <- true
                                else:
                                    prior_merged: mutable TryNonCallErrorFamilyEnv = try_noncall_family_clone(merged_arms)
                                    merged_arms <- try_noncall_family_clone(base_environment)
                                    try_noncall_family_join_into(merged_arms, base_environment, prior_merged, arm_environment, visible_count)
                            if merged_ready:
                                try_noncall_family_join_into(environment, base_environment, base_environment, merged_arms, visible_count)
                                if candidate_wrote:
                                    local_shadow <- true
                                    local_error_family <- try_noncall_family_lookup(environment, candidate)
                        Stmt.Contract(_, expression, _):
                            try_noncall_scan_expression(expression, candidate, params, environment, annotations, annotation, site_offset, local_shadow, local_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                        _:
                            pass
                return (local_shadow, local_error_family)

        def try_noncall_binding_at_site(body: darray[Ast::Stmt], candidate: sview, params: darray[Ast::ParamDecl], declarations: darray[Ast::Decl], annotations: darray[Ast::EnumAnnotation]&, annotation: Ast::EnumAnnotation, site_offset: u32, parameter_error_family: sview @source, current_module: sview) -> (found: bool, shadowed: bool, local_error_family: sview @source, lambda_error_family: sview @source, inside_lambda: bool, known_nonfallible: bool):
            can Memory.Allocate, Abort.Panic:
                found: mutable bool = false
                shadowed_at_site: mutable bool = false
                local_error_family_at_site: mutable sview @source = ""
                lambda_error_family_at_site: mutable sview @source = ""
                inside_lambda_at_site: mutable bool = false
                known_nonfallible_at_site: mutable bool = false
                environment: mutable TryNonCallErrorFamilyEnv = TryNonCallErrorFamilyEnv{current_module: current_module}
                for alias in annotations |environment, annotations|:
                    if alias.name == "__using_alias":
                        alias_target: (count: usize, target: sview) = callable_using_alias_target_count(annotations, alias.module, alias.line, alias.offset, alias.owner)
                        if alias_target.count == 1.usize():
                            environment.using_alias_names.push(alias.owner)
                            environment.using_alias_modules.push(alias.module)
                            environment.using_alias_targets.push(alias_target.target)
                try_noncall_type_alias_facts_add(declarations, environment, current_module)
                try_noncall_callable_facts_add(declarations, annotations, environment, "")
                for parameter in params |environment, params, annotations|:
                    parameter_facts: (known: bool, family: sview @source) = try_parameter_error_family(params, parameter.name, annotations)
                    type_facts: (known_nonfallible: bool, numeric: bool, integer: bool) = try_noncall_type_facts_with_aliases(parameter.type_expression, environment)
                    try_noncall_family_bind(environment, parameter.name, parameter_facts.family, parameter_facts.known and parameter_facts.family == "", type_facts.numeric, type_facts.integer)
                try_noncall_scan_statements(body, candidate, params, environment, annotations, annotation, site_offset, false, parameter_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                return (found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)

        def try_noncall_parameter_error_family(declarations: darray[Ast::Decl], annotations: darray[Ast::EnumAnnotation]&, annotation: Ast::EnumAnnotation, enclosing: (line: u32, offset: u32), current_module: sview) -> (binding_known: bool, error_family: sview @source, lambda_error_family: sview @source, inside_lambda: bool):
            can Abort.Panic:
                for declaration in declarations:
                    match declaration:
                        Decl.Func(_, params, _, body, _, _, function_pos):
                            if (function_pos.line == enclosing.line and function_pos.offset == enclosing.offset) or (function_pos.offset != 0 and function_pos.offset < enclosing.offset):
                                nearest_offset: mutable u32 = 4294967295
                                nearest_name: mutable sview @source = ""
                                try_noncall_record_statements(body, annotation, nearest_offset, nearest_name)
                                continue if nearest_offset == 4294967295
                                parameter_facts: (known: bool, family: sview @source) = try_parameter_error_family(params, nearest_name, annotations)
                                binding: (found: bool, shadowed: bool, local_error_family: sview @source, lambda_error_family: sview @source, inside_lambda: bool, known_nonfallible: bool) = try_noncall_binding_at_site(body, nearest_name, params, declarations, annotations, annotation, nearest_offset, parameter_facts.family, current_module)
                                return (true, binding.local_error_family, binding.lambda_error_family, binding.inside_lambda) if nearest_name == "" and binding.found and binding.local_error_family != ""
                                return (binding.found and binding.known_nonfallible, "", binding.lambda_error_family, binding.inside_lambda) if nearest_name == ""
                                return (true, binding.local_error_family, binding.lambda_error_family, binding.inside_lambda) if binding.found and binding.local_error_family != ""
                                return (true, "", binding.lambda_error_family, binding.inside_lambda) if binding.found and binding.shadowed and binding.known_nonfallible
                                return (false, "", binding.lambda_error_family, binding.inside_lambda) if binding.found and binding.shadowed
                                return (parameter_facts.known, parameter_facts.family, binding.lambda_error_family, binding.inside_lambda)
                        Decl.Module(module_name, module_body, _):
                            module_binding: (binding_known: bool, error_family: sview @source, lambda_error_family: sview @source, inside_lambda: bool) = try_noncall_parameter_error_family(module_body, annotations, annotation, enclosing, module_name)
                            return module_binding if module_binding.binding_known or module_binding.inside_lambda
                        Decl.Scoped(scoped_body, _):
                            scoped_binding: (binding_known: bool, error_family: sview @source, lambda_error_family: sview @source, inside_lambda: bool) = try_noncall_parameter_error_family(scoped_body, annotations, annotation, enclosing, current_module)
                            return scoped_binding if scoped_binding.binding_known or scoped_binding.inside_lambda
                        _:
                            pass
                return (false, "", "", false)

        def check_try_fallible_rows(declarations: darray[Ast::Decl], annotations: darray[Ast::EnumAnnotation]&, error_set_annotations: darray[Ast::EnumAnnotation]&, module_index: FallibleFunctionModuleIndex&, module_annotations: darray[Ast::EnumAnnotation]&, try_qualifiers: dict[u64, sview]&, error_index: CallableErrorAnnotationIndex&, try_site_count: usize, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic, Global.Read:
                function_positions: mutable FallibleFunctionPositionIndex = FallibleFunctionPositionIndex{positions: [], offsets_ordered: true, ready: false}
                error_set_index: mutable TryErrorSetIndex = TryErrorSetIndex{by_offset_heads: {}, by_offset_tails: {}, zero_offset_line_heads: {}, zero_offset_line_tails: {}, next: [], ready: false}
                propagation_site_count: mutable usize = 0
                for annotation in annotations |table, annotations, function_positions, error_set_index, propagation_site_count|:
                    # Only these rows can produce either diagnostic below.
                    # Resolving scope for unrelated annotation rows turned the
                    # common no-try case into repeated whole-table scans.
                    continue if annotation.name != "__try_without_else" or annotation.owner == "__unknown_call"
                    # Resolve the callee ONCE per row: which module the call lands in decides
                    # both whether it is fallible and which family it propagates.
                    row_enclosing: mutable (line: u32, offset: u32) = (0, 0)
                    if try_site_count > 1:
                        row_enclosing <- enclosing_try_function_indexed(function_positions, table, annotation.line, annotation.offset)
                    else:
                        row_enclosing <- enclosing_try_function(table, annotation.line, annotation.offset)
                    row_module: sview = fallible_fn_module_indexed(module_index, module_annotations, row_enclosing.offset, row_enclosing.line)
                    row_qualifier: sview = try_callee_qualifier(try_qualifiers, annotation.offset)
                    row_scope_known: bool = row_enclosing.line != 0 or row_enclosing.offset != 0 or row_module != "" or row_qualifier != ""
                    noncall_binding: (binding_known: bool, error_family: sview @source, lambda_error_family: sview @source, inside_lambda: bool) = try_noncall_parameter_error_family(declarations, annotations, annotation, row_enclosing, "") if annotation.owner != "__unknown_call" else (false, "", "", false)
                    first_class_error_family: sview @source = noncall_binding.error_family
                    row_is_fallible: bool = first_class_error_family != "" or callable_error_indexed_returns_error(error_index, annotations, module_index, module_annotations, annotation.owner, row_module, row_qualifier, row_scope_known)
                    # A callee that is not a declared function (a fn-typed parameter or
                    # local, e.g. `try f(x)` with `f: fn(...) -> T error[R]`) may be
                    # fallible through its TYPE — unknowable here, so stay silent.
                    if annotation.name == "__try_without_else" and annotation.owner != "__unknown_call" and (annotation.owner != "__noncall" or noncall_binding.binding_known) and (annotation.owner == "__noncall" or direct_function_count(table, annotation.owner) > 0) and not row_is_fallible:
                        return_type_id: u32 = function_return_type_id(table, annotation.owner)
                        reason: sview = "optional" if interned_kind(return_type_id, table) == SemTypeKind.Optional else "nonfallible"
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.TryRequiresFallible, name: annotation.owner, line: annotation.line, expected: reason, actual: ""})
                    if annotation.name == "__try_without_else" and annotation.owner != "__unknown_call" and row_is_fallible:
                        propagation_site_count <- propagation_site_count + 1.usize()
                        can Global{Read,Write}:
                            table <- check_try_propagation_row(annotation, row_enclosing, row_module, row_qualifier, annotations, error_set_annotations, error_set_index, propagation_site_count, module_index, module_annotations, error_index, table, first_class_error_family, noncall_binding.lambda_error_family, noncall_binding.inside_lambda)

        # The bare callee name of `try f(...) else …`, "" for anything else. Deliberately
        # bare-ident only: a qualified callee would need the module-resolution dance above,
        # and the shape this check exists for (`try void_fn() else 0`) is always a bare call.
        def try_fallback_callee_name(guarded: Ast::Expr) -> sview @source:
            can Abort.Panic:
                match guarded:
                    Expr.Call(callee, arguments, argument_names, call_line):
                        return ident_name_of(callee)
                    _:
                        pass
                return sview("", 0, 0)

        # `try VOID_CALL else <literal>` — the guarded call succeeds with NO value, so a
        # literal fallback has nothing to inhabit. stage0: "try fallback expects void, got int".
        # SOUND subset, in the manner of check_index_fallback_type: fires only for a bare call
        # to a DECLARED, FALLIBLE function whose return type interns as Void, with a LITERAL
        # fallback. A void-typed call fallback (`else noop()`) and every control-flow recovery
        # (`else return` / `else raise` / `else err:`, which the parser routes to Expr.GetElse,
        # not Expr.Refinement) are untouched.
        def check_try_fallback_void_site(fallback: Ast::Expr, site_pos: Ast::Pos, callee_name: sview @source, callee_is_fallible: bool, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                fallback_kind: sview = literal_kind_of(fallback)
                return if:
                    fallback_kind == ""
                    callee_name == ""
                    not callee_is_fallible
                    interned_kind(function_return_type_id(table, callee_name), table) != SemTypeKind.Void
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.TryFallbackVoid, name: callee_name, pos: site_pos, line: site_pos.line, expected: "void", actual: fallback_kind})

        # The cast form is the first concrete fallback shape for which Stage1 can recover
        # both sides' structural types without threading a second local-type environment
        # through this checker. It covers the source form that previously escaped analysis:
        # `try read_file(path) else "".cast[u8&]`. Unknown fallback shapes remain silent
        # rather than manufacturing a type from a literal or an overloaded call.
        def try_fallback_cast_target_id(expression: Ast::Expr, table: mutable SymbolTable&) -> u32:
            can Abort.Panic:
                match expression:
                    Expr.Index(Expr.Field(receiver, selector, field_line), target, target_line):
                        return annotation_type_id(target, table) can Global{Read,Write} if selector == "cast"
                    Expr.Paren(inner, paren_line):
                        return try_fallback_cast_target_id(inner, table) can Global{Read,Write}
                    _:
                        pass
                return 0

        # Recover the borrowed source spelling without allocating a new sview. The AST's
        # identifier slices already point into the source buffer; the wrapper punctuation is
        # carried separately in Diagnostic.detail so the renderer can print `u8&` without
        # manufacturing a dangling view into a temporary darray.
        def try_fallback_cast_target_base(expression: Ast::Expr) -> sview @source:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Ident(name, ident_line):
                        return name
                    Expr.Paren(inner, paren_line):
                        return try_fallback_cast_target_base(inner)
                    Expr.Unary(operator, operand, unary_line):
                        return try_fallback_cast_target_base(operand)
                    Expr.Index(indexed_head, index_argument, index_line):
                        return ident_name_of(indexed_head)
                    _:
                        return sview("", 0, 0)

        def try_fallback_cast_target_has_ref(expression: Ast::Expr) -> bool:
            can Abort.Panic:
                match expression:
                    Expr.Index(Expr.Field(receiver, selector, field_line), target, target_line):
                        if selector == "cast":
                            return try_fallback_cast_target_has_ref(target)
                    Expr.Unary(operator, operand, unary_line):
                        return true if operator == TokenKind.Ampersand
                        return try_fallback_cast_target_has_ref(operand)
                    Expr.Paren(inner, paren_line):
                        return try_fallback_cast_target_has_ref(inner)
                    _:
                        pass
                return false

        def try_fallback_cast_target_spelling(expression: Ast::Expr) -> sview @source:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Index(Expr.Field(receiver, selector, field_line), target, target_line):
                        return try_fallback_cast_target_base(target) if selector == "cast"
                    Expr.Paren(inner, paren_line):
                        return try_fallback_cast_target_spelling(inner)
                    _:
                        pass
                return sview("", 0, 0)

        # Compare the compact spelling available for an extern return with the compact
        # spelling recovered from a cast fallback. A pointer target is kept as `base` plus
        # `detail` because the target expression itself is a borrowed AST view and the
        # diagnostic renderer appends the reference marker separately.
        def try_fallback_declared_name_matches(expected: sview, actual: sview, actual_detail: sview) -> bool:
            can Abort.Panic:
                return false if expected == "" or actual == ""
                if actual_detail == "&":
                    expected_length: usize = expected.len
                    return false if expected_length < 2.usize() or expected[expected_length - 1.usize()] != 38
                    return expected[0:expected_length - 1.usize()] == actual
                return expected == actual

        # Callable extern declarations keep their return head in a parser annotation rather
        # than in Symbol.return_type: the compact AST intentionally leaves that symbol field
        # empty because the backend reconstructs pointer/heap/optional ABI shape from the
        # parallel extern rows. Use the declaration line to pair the anonymous
        # `__extern_return` row with the named callable. This helper is only a fallback for
        # this compact checker; ordinary call inference must continue using its existing ABI
        # path.
        # The name chain is in symbol insertion order, matching the former full scan's choice
        # when same-name functions are overloaded. Keep the canonical scan for an incomplete
        # index so a partial chain cannot hide an earlier declaration.
        def try_fallback_extern_declaration_line(table: SymbolTable&, name: sview) -> u32:
            can Abort.Panic:
                if table.symbol_name_index_valid and table.symbol_name_indexed_rows == table.symbols.count and table.symbol_name_next.count == table.symbols.count:
                    hash: u64 = name_hash(name)
                    if table.symbol_name_count.get(hash) is indexed_count:
                        declaration_line: mutable u32 = 0
                        found_function: mutable bool = false
                        chain_valid: mutable bool = true
                        previous_row: mutable u32 = 0
                        has_previous: mutable bool = false
                        row: mutable u32 = symbol_chain_head(table, name)
                        steps: mutable usize = 0
                        while row != SYMBOL_INDEX_ROW_NONE and chain_valid and steps < table.symbols.count |row, steps, chain_valid, previous_row, has_previous, declaration_line, found_function, table, name, hash|:
                            if row.usize() >= table.symbols.count or row.usize() >= table.symbol_name_next.count or (has_previous and row <= previous_row):
                                chain_valid <- false
                            else:
                                symbol: Symbol& = &table.symbols[row.usize()]
                                chain_valid <- false if name_hash(symbol.name) != hash
                                if chain_valid and symbol.name == name and symbol.kind == SymbolKind.Func and not found_function:
                                    declaration_line <- symbol.line
                                    found_function <- true
                                previous_row <- row
                                has_previous <- true
                                row <- table.symbol_name_next[row.usize()]
                                steps <- steps + 1.usize()
                        if chain_valid and row == SYMBOL_INDEX_ROW_NONE and steps == indexed_count.usize():
                            return declaration_line if found_function
                            return 0
                for symbol in table.symbols:
                    return symbol.line if symbol.name == name and symbol.kind == SymbolKind.Func
                return 0

        # Recover all side-tabled extern return shape in one pass over only the indexed
        # rows at this declaration line. Preserve the original first-row behavior for the
        # head and darray element, and `any` behavior for ptr/optional flags.
        def try_fallback_extern_return_info(index: CallableErrorAnnotationIndex&, annotations: darray[Ast::EnumAnnotation]&, table: SymbolTable&, name: sview) -> TryFallbackExternReturnInfo:
            can Abort.Panic:
                declaration_line: u32 = try_fallback_extern_declaration_line(table, name)
                info: mutable TryFallbackExternReturnInfo = TryFallbackExternReturnInfo{name: "", element: "", has_pointer: false, has_optional: false}
                return info if declaration_line == 0
                return_type_found: mutable bool = false
                element_found: mutable bool = false
                row: mutable u32 = callable_error_extern_line_head(index, declaration_line)
                while row != CALLABLE_ERROR_ROW_NONE |row, index, annotations, declaration_line, name, info, return_type_found, element_found|:
                    annotation: Ast::EnumAnnotation = annotations[index.extern_source_rows[row.usize()]]
                    if annotation.owner == "__extern_return" and not return_type_found:
                        info.name <- annotation.name
                        return_type_found <- true
                    if annotation.name == "__extern_return_darray_elem" and not element_found:
                        # The parser's row names only the first identifier after darray[.
                        # Preserve the old empty result for non-primitive element types.
                        info.element <- annotation.owner if is_bare_primitive_type(annotation.owner)
                        element_found <- true
                    info.has_pointer <- true if annotation.owner == "__extern_return_ptr" and annotation.name == name
                    info.has_optional <- true if annotation.owner == "__extern_return_optional" and annotation.name == name
                    row <- index.extern_line_next[row.usize()]
                return info

        # The element of a `.cast[darray[E]]` fallback target, when it is a plain name.
        def try_fallback_cast_target_element(expression: Ast::Expr) -> sview @source:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Index(Expr.Field(receiver, selector, field_line), target, target_line):
                        if selector == "cast":
                            match target:
                                Expr.Index(indexed_head, index_argument, index_line):
                                    return ident_name_of(index_argument)
                                _:
                                    pass
                    Expr.Paren(inner, paren_line):
                        return try_fallback_cast_target_element(inner)
                    _:
                        pass
                return sview("", 0, 0)

        def check_try_fallback_type_site(fallback: Ast::Expr, site_pos: Ast::Pos, callee_name: sview @source, callee_is_fallible: bool, annotations: darray[Ast::EnumAnnotation]&, error_index: CallableErrorAnnotationIndex&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                return if:
                    callee_name == ""
                    not callee_is_fallible
                expected_name: mutable sview @source = function_return_type(table, callee_name)
                expected_id: u32 = function_return_type_id(table, callee_name)
                extern_info: mutable TryFallbackExternReturnInfo = TryFallbackExternReturnInfo{name: "", element: "", has_pointer: false, has_optional: false}
                if expected_name == "" or expected_id == 0:
                    extern_info <- try_fallback_extern_return_info(error_index, annotations, table, callee_name)
                    expected_name <- extern_info.name if expected_name == ""
                return if:
                    expected_name == "" or expected_name == "void"
                    expected_id != 0 and interned_kind(expected_id, table) == SemTypeKind.Void
                actual_id: u32 = try_fallback_cast_target_id(fallback, table) can Global{Read,Write}
                actual_name: sview @source = try_fallback_cast_target_spelling(fallback)
                return if expected_name == "" or actual_name == ""
                actual_detail: sview @source = "&" if try_fallback_cast_target_has_ref(fallback) else ""
                if expected_id != 0:
                    return if actual_id == 0 or type_ids_compatible(expected_id, actual_id, table)
                else:
                    # A pointer or optional extern return has no source spelling for its expected
                    # side: the message can carry the fallback's `&` (detail) but not the
                    # expected one, so a mismatch would print `expects u8` where stage0 prints
                    # `expects u8&`. Stay silent rather than reject `-> u8&` met by `.cast[u8&]`.
                    return if:
                        extern_info.has_pointer
                        extern_info.has_optional
                # An extern `-> darray[u8]` side-tables only the `darray` head; its element rides
                # on a companion row, so stage0's `expects darray[u8]` (and an element mismatch
                # such as `got darray[i32]`) is spelled from the two element names.
                expected_element: sview @source = extern_info.element if expected_id == 0 and expected_name == "darray" else ""
                actual_element: sview @source = try_fallback_cast_target_element(fallback) if expected_element != "" and actual_name == "darray" else ""
                elements_agree: bool = expected_element == "" or actual_element == "" or expected_element == actual_element
                return if elements_agree and try_fallback_declared_name_matches(expected_name, actual_name, actual_detail)
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.TryFallbackTypeMismatch, name: callee_name, pos: site_pos, line: site_pos.line, expected: expected_name, actual: actual_name, detail: actual_detail, detail2: expected_element, detail3: actual_element})

        def try_fallback_void_expression(expression: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&, module_index: mutable FallibleFunctionModuleIndex&, module_annotations: darray[Ast::EnumAnnotation]&, error_index: mutable CallableErrorAnnotationIndex&, function_positions: mutable FallibleFunctionPositionIndex&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    # `try CALL else FALLBACK` parses to Refinement(FALLBACK, CALL) — the
                    # fallback is the FIRST child. (`refine X where P` reuses the node with
                    # the opposite sense; the literal-plus-fallible-void-call conjunction
                    # below is what keeps this from firing on one.)
                    Expr.Refinement(fallback, guarded, refinement_pos):
                        callee_name: sview @source = try_fallback_callee_name(guarded)
                        has_direct_callee: bool = direct_function_count(table, callee_name) > 0 if callee_name != "" else false
                        callable_error_index_build(annotations, error_index, true) can Global{Read,Write} if has_direct_callee and not error_index.ready
                        callee_is_fallible: mutable bool = false
                        if has_direct_callee:
                            fallback_enclosing: (line: u32, offset: u32) = enclosing_try_function_indexed(function_positions, table, refinement_pos.line, refinement_pos.offset)
                            fallback_module: sview = fallible_fn_module_indexed(module_index, module_annotations, fallback_enclosing.offset, fallback_enclosing.line)
                            fallback_scope_known: bool = fallback_enclosing.line != 0 or fallback_enclosing.offset != 0
                            callee_is_fallible <- callable_error_indexed_returns_error(error_index, annotations, module_index, module_annotations, callee_name, fallback_module, "", fallback_scope_known)
                        table <- check_try_fallback_void_site(fallback, refinement_pos, callee_name, callee_is_fallible, table)
                        table <- check_try_fallback_type_site(fallback, refinement_pos, callee_name, callee_is_fallible, annotations, error_index, table) can Global{Read,Write}
                        table <- try_fallback_void_expression(fallback, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                        table <- try_fallback_void_expression(guarded, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                    Expr.StaticEffectCall(effect_type, _, candidates, arguments, _, _):
                        table <- try_fallback_void_expression(effect_type, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                        for candidate in candidates |table, module_index, error_index, function_positions| -> table:
                            table <- try_fallback_void_expression(candidate.effect_type, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                            for capture in candidate.captures |table, module_index, error_index, function_positions| -> table:
                                table <- try_fallback_void_expression(capture, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                        for argument in arguments |table, module_index, error_index, function_positions| -> table:
                            table <- try_fallback_void_expression(argument, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                    Expr.Call(callee, arguments, _, _):
                        table <- try_fallback_void_expression(callee, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                        for argument in arguments |table, module_index, error_index, function_positions| -> table:
                            table <- try_fallback_void_expression(argument, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                    Expr.Field(object, _, _) | Expr.Scope(object, _, _):
                        table <- try_fallback_void_expression(object, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                    Expr.Index(object, index, _):
                        table <- try_fallback_void_expression(object, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                        table <- try_fallback_void_expression(index, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                    Expr.IndexN(object, arguments, _):
                        table <- try_fallback_void_expression(object, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                        for argument in arguments |table, module_index, error_index, function_positions| -> table:
                            table <- try_fallback_void_expression(argument, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                    Expr.Slice(object, low, high, _):
                        table <- try_fallback_void_expression(object, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                        table <- try_fallback_void_expression(low, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                        table <- try_fallback_void_expression(high, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                    Expr.Binary(left, operator, right, binary_pos):
                        table <- try_fallback_void_expression(left, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                        table <- try_fallback_void_expression(right, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                    Expr.Unary(operator, operand, unary_pos):
                        table <- try_fallback_void_expression(operand, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                    Expr.Move(operand, _) | Expr.RegionNew(operand, _, _):
                        table <- try_fallback_void_expression(operand, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                    Expr.Paren(inner, paren_pos):
                        table <- try_fallback_void_expression(inner, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                    Expr.Array(elements, _) | Expr.Tuple(elements, _) | Expr.SetLit(elements, _):
                        for element in elements |table, module_index, error_index, function_positions| -> table:
                            table <- try_fallback_void_expression(element, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                    Expr.DictLit(entries, _):
                        for entry in entries |table, module_index, error_index, function_positions| -> table:
                            table <- try_fallback_void_expression(entry.key, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                            table <- try_fallback_void_expression(entry.value, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                    Expr.Construct(type_expression, fields, _):
                        table <- try_fallback_void_expression(type_expression, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                        for field in fields |table, module_index, error_index, function_positions| -> table:
                            table <- try_fallback_void_expression(field.value, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                    Expr.RecordUpdate(base, fields, _):
                        table <- try_fallback_void_expression(base, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                        for field in fields |table, module_index, error_index, function_positions| -> table:
                            table <- try_fallback_void_expression(field.value, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                    Expr.If(condition, then_value, else_value, _):
                        table <- try_fallback_void_expression(condition, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                        table <- try_fallback_void_expression(then_value, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                        table <- try_fallback_void_expression(else_value, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                    Expr.Match(scrutinee, arms, _):
                        table <- try_fallback_void_expression(scrutinee, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                        for arm in arms |table, module_index, error_index, function_positions| -> table:
                            table <- try_fallback_void_expression(arm.guard, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                            table <- try_fallback_void_statements(arm.body, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                    Expr.Catch(guarded, arms, _):
                        table <- try_fallback_void_expression(guarded, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                        for arm in arms |table, module_index, error_index, function_positions| -> table:
                            table <- try_fallback_void_expression(arm.guard, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                            table <- try_fallback_void_statements(arm.body, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                    Expr.Comprehension(_, iterable, condition, body, _, _):
                        table <- try_fallback_void_expression(iterable, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                        table <- try_fallback_void_expression(condition, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                        table <- try_fallback_void_expression(body, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                    Expr.Refinement(base, predicate, _):
                        table <- try_fallback_void_expression(base, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                        table <- try_fallback_void_expression(predicate, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                    Expr.GetElse(guarded, recovery, _):
                        table <- try_fallback_void_expression(guarded, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                        table <- try_fallback_void_statements(recovery, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                    Expr.Lambda(_, body, _):
                        table <- try_fallback_void_statements(body, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                    Expr.Block(statements, value, _, _):
                        table <- try_fallback_void_statements(statements, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                        table <- try_fallback_void_expression(value, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                    _:
                        pass

        def try_fallback_void_statements(statements: darray[Ast::Stmt], annotations: darray[Ast::EnumAnnotation]&, module_index: mutable FallibleFunctionModuleIndex&, module_annotations: darray[Ast::EnumAnnotation]&, error_index: mutable CallableErrorAnnotationIndex&, function_positions: mutable FallibleFunctionPositionIndex&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table, module_index, error_index, function_positions| -> table:
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- try_fallback_void_expression(expression, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                        Stmt.Block(_, _, _, body, _):
                            table <- try_fallback_void_statements(body, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- try_fallback_void_expression(type_expression, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                            table <- try_fallback_void_expression(value, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                        Stmt.Assign(target, operator, value, line):
                            table <- try_fallback_void_expression(target, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                            table <- try_fallback_void_expression(value, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                        Stmt.Return(value, line):
                            table <- try_fallback_void_expression(returned, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write} if value is returned
                        Stmt.If(condition, then_body, else_body, line):
                            table <- try_fallback_void_expression(condition, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                            table <- try_fallback_void_statements(then_body, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                            table <- try_fallback_void_statements(else_body, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                        Stmt.While(condition, while_body, line):
                            table <- try_fallback_void_expression(condition, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                            table <- try_fallback_void_statements(while_body, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                        Stmt.For(bind, variables, iterable, for_body, line):
                            table <- try_fallback_void_expression(iterable, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                            table <- try_fallback_void_statements(for_body, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                        Stmt.Match(scrutinee, arms, line):
                            table <- try_fallback_void_expression(scrutinee, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                            for arm in arms |table, module_index, error_index, function_positions| -> table:
                                table <- try_fallback_void_expression(arm.guard, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                                table <- try_fallback_void_statements(arm.body, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                        Stmt.Contract(_, expression, _):
                            table <- try_fallback_void_expression(expression, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                        _:
                            pass

        def try_fallback_void_decls(declarations: darray[Ast::Decl], annotations: darray[Ast::EnumAnnotation]&, module_index: mutable FallibleFunctionModuleIndex&, module_annotations: darray[Ast::EnumAnnotation]&, error_index: mutable CallableErrorAnnotationIndex&, function_positions: mutable FallibleFunctionPositionIndex&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table, module_index, error_index, function_positions| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            table <- try_fallback_void_statements(body, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                        Decl.Struct(_, members, _, _, _, invariants, _):
                            for member in members |table, module_index, error_index, function_positions| -> table:
                                table <- try_fallback_void_expression(member.type_expression, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                                table <- try_fallback_void_expression(member.default_value, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                                for bit_member in member.bit_group_members |table, module_index, error_index, function_positions| -> table:
                                    table <- try_fallback_void_expression(bit_member.type_expression, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                            for invariant in invariants |table, module_index, error_index, function_positions| -> table:
                                table <- try_fallback_void_expression(invariant, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                        Decl.Enum(_, variants, _, storage_type, _):
                            table <- try_fallback_void_expression(storage_type, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                            for variant in variants |table, module_index, error_index, function_positions| -> table:
                                for field_type in variant.fields |table, module_index, error_index, function_positions| -> table:
                                    table <- try_fallback_void_expression(field_type, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                                table <- try_fallback_void_expression(variant.value_expr, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                        Decl.Alias(_, target, _):
                            table <- try_fallback_void_expression(target, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                        Decl.Law(_, predicate, _):
                            table <- try_fallback_void_expression(predicate, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                        Decl.Const(_, type_expression, value, _, _):
                            table <- try_fallback_void_expression(type_expression, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                            table <- try_fallback_void_expression(value, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                        Decl.Module(module_name, module_body, module_line):
                            table <- try_fallback_void_decls(module_body, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- try_fallback_void_decls(scoped_body, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                        _:
                            pass

    public:
        def check_try_fallible(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                projection: mutable FallibleTryAnnotationProjection = FallibleTryAnnotationProjection{module_annotations: [], error_set_annotations: [], try_qualifiers: {}}
                module_index: mutable FallibleFunctionModuleIndex = FallibleFunctionModuleIndex{by_line: {}, by_offset: {}, zero_offset_by_line: {}, ready: false}
                fallback_function_positions: mutable FallibleFunctionPositionIndex = FallibleFunctionPositionIndex{positions: [], offsets_ordered: true, ready: false}
                try_site_count: mutable usize = 0
                fallback_site_count: mutable usize = 0
                error_index: mutable CallableErrorAnnotationIndex = CallableErrorAnnotationIndex{heads: {}, tails: {}, next: [], source_rows: [], extern_line_heads: {}, extern_line_tails: {}, extern_line_next: [], extern_source_rows: [], ready: false}
                projection_ready: mutable bool = false
                for row in 0..<file.enum_annotations.count |projection, try_site_count, fallback_site_count, projection_ready, file|:
                    annotation: Ast::EnumAnnotation = file.enum_annotations[row]
                    if annotation.name == "__try_without_else" and annotation.owner != "__unknown_call":
                        try_site_count <- try_site_count + 1.usize()
                        if not projection_ready:
                            for prefix_row in 0..<row |projection, file|:
                                fallible_try_projection_add(projection, file.enum_annotations[prefix_row]) can Global{Read,Write}
                            projection_ready <- true
                    if annotation.owner == "__try_fallback_expression":
                        fallback_site_count <- fallback_site_count + 1.usize()
                        if not projection_ready:
                            for prefix_row in 0..<row |projection, file|:
                                fallible_try_projection_add(projection, file.enum_annotations[prefix_row]) can Global{Read,Write}
                            projection_ready <- true
                    fallible_try_projection_add(projection, annotation) can Global{Read,Write} if projection_ready
                fallible_function_module_index_build(module_index, projection.module_annotations) can Global{Read,Write} if try_site_count > 0 or fallback_site_count > 0
                callable_error_index_build(file.enum_annotations, error_index, true) can Global{Read,Write} if try_site_count > 0
                table <- check_try_fallible_rows(file.top_decls, file.enum_annotations, projection.error_set_annotations, module_index, projection.module_annotations, projection.try_qualifiers, error_index, try_site_count, table) can Global{Read,Write} if try_site_count > 0
                table <- try_fallback_void_decls(file.top_decls, file.enum_annotations, module_index, projection.module_annotations, error_index, fallback_function_positions, table) can Global{Read,Write} if fallback_site_count > 0
