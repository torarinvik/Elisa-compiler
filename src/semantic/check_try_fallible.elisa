extend Semantic:
    private:
        def callable_returns_error(annotations: darray[Ast::EnumAnnotation]&, name: sview) -> bool:
            for annotation in annotations:
                true return if annotation.owner == name and annotation.name == "__error_return"
            return false

        def callable_error_family(annotations: darray[Ast::EnumAnnotation]&, name: sview) -> sview:
            for annotation in annotations:
                annotation.name return if annotation.owner == name and annotation.name != "__error_return" and annotation.name != "__export_array"
            return ""

        def enclosing_try_function_line(table: SymbolTable&, try_line: u32) -> u32:
            best: mutable u32 = 0
            for symbol in table.symbols |best|:
                best <- symbol.line if symbol.kind == SymbolKind.Func and symbol.line <= try_line and symbol.line >= best
            return best

        def error_family_covers(source: sview, destination: sview, table: SymbolTable&) -> bool:
            can Abort.Panic:
                saw_source_tag: mutable bool = false
                for variant_index in 0..<table.enum_variant_owner.count |saw_source_tag|:
                    if table.enum_variant_owner[variant_index] == source:
                        saw_source_tag <- true
                        false return if not enum_has_variant(table, destination, table.enum_variant_name[variant_index])
                return saw_source_tag

        def check_try_propagation_row(annotation: Ast::EnumAnnotation&, annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                source: sview = callable_error_family(annotations, annotation.owner)
                return if source == ""
                function_line: u32 = enclosing_try_function_line(table, annotation.line)
                destinations: mutable darray[sview] = []
                for destination_row in annotations |destinations|:
                    destinations.push(destination_row.name) if destination_row.owner == "__error_set_family" and destination_row.line == function_line
                return if destinations.count == 0
                covered: bool = any destination in destinations where destination == source or error_family_covers(source, destination, table)
                return if covered
                first: mutable sview = destinations[0]
                second: mutable sview = ""
                second <- destinations[1] if destinations.count > 1
                swap: bool = second != "" and error_family_symbol_position(table, second) < error_family_symbol_position(table, first)
                first, second <- second, first if swap
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.TryPropagationMismatch, name: source, line: annotation.line, expected: first, actual: "", detail: second})

        def check_try_fallible_rows(annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for annotation in annotations |table|:
                    # A callee that is not a declared function (a fn-typed parameter or
                    # local, e.g. `try f(x)` with `f: fn(...) -> T error[R]`) may be
                    # fallible through its TYPE — unknowable here, so stay silent.
                    if annotation.name == "__try_without_else" and annotation.owner != "__unknown_call" and (annotation.owner == "__noncall" or direct_function_count(table, annotation.owner) > 0) and not callable_returns_error(annotations, annotation.owner):
                        return_type_id: u32 = function_return_type_id(table, annotation.owner)
                        reason: sview = "optional" if interned_kind(return_type_id, table) == TypeKind.Optional else "nonfallible"
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.TryRequiresFallible, name: annotation.owner, line: annotation.line, expected: reason, actual: ""})
                    table <- check_try_propagation_row(annotation, annotations, table) if annotation.name == "__try_without_else" and annotation.owner != "__unknown_call" and callable_returns_error(annotations, annotation.owner)

    public:
        def check_try_fallible(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- check_try_fallible_rows(file.enum_annotations, table)
