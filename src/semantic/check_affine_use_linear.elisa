# Stage1 semantic — the affine-use walk and linear types (`extend Semantic:
# private+public:`). Walks a body tracking which affine locals have been consumed,
# collects the linear type names and the locals holding them, and `check_affine_use_flow`
# drives the whole check. Continues check_affine_use.elisa; split out to keep each part
# file under 600 lines.

extend Semantic:
    private:
        def walk_affine_expression(expression: Ast::Expr, names: darray[sview]&, flags: darray[bool]&, consumed: mutable darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Unary(operator, operand, line):
                        table <- walk_affine_expression(operand, names, flags, consumed, table)
                    Expr.Move(operand, line):
                        root: sview = affine_root(operand)
                        table <- report_affine_consumed(root, line.line, consumed, table)
                        consumed.push(root) if root != "" and affine_local(names, flags, root) and not affine_consumed(consumed, root)
                    Expr.Ident(name, line):
                        table <- report_affine_consumed(name, line.line, consumed, table)
                        one_shot_used: sview = one_shot_capture_of(names, name)
                        table <- one_shot_report("use", name, one_shot_used, line, table) if one_shot_used != ""
                    # `x.field` reports on x itself. `f(move h).field` has no affine root of its
                    # own, and the consumption is INSIDE the object — so descend there instead.
                    # Without this, `sink(move h).i64()` recorded no consumption at all and a
                    # second `sink(move h)` was accepted silently, while the identical code
                    # without the postfix conversion was correctly rejected. That is also why
                    # docs/127 D4 never fired: the fixture returns `fgetc(file).i64()`.
                    # The two cases are exclusive, so nothing is reported twice.
                    Expr.Field(object, field, line):
                        field_object_root: sview = affine_root(object)
                        table <- report_affine_consumed(field_object_root, line.line, consumed, table)
                        table <- walk_affine_expression(object, names, flags, consumed, table) if field_object_root == ""
                    Expr.Index(object, index, line):
                        index_object_root: sview = affine_root(object)
                        table <- report_affine_consumed(index_object_root, line.line, consumed, table)
                        table <- walk_affine_expression(object, names, flags, consumed, table) if index_object_root == ""
                        table <- walk_affine_expression(index, names, flags, consumed, table)
                    Expr.Call(callee, arguments, argument_names, line):
                        for argument in arguments |table, consumed| -> table:
                            table <- walk_affine_expression(argument, names, flags, consumed, table)
                        # Calling a one-shot closure local consumes it (check_affine_one_shot).
                        one_shot_callee: sview = ident_name_of(callee)
                        if one_shot_callee != "" and one_shot_capture_of(names, one_shot_callee) != "":
                            table <- one_shot_report("call", one_shot_callee, "", line, table) if affine_consumed(consumed, one_shot_callee)
                            consumed.push(one_shot_callee) if not affine_consumed(consumed, one_shot_callee)
                        else:
                            table <- walk_affine_expression(callee, names, flags, consumed, table)
                    # A lambda VALUE (a declaration's lambda is walked by one_shot_walk_bound).
                    Expr.Lambda(lambda_params, lambda_body, lambda_line):
                        unbound_moved: mutable darray[sview] = []
                        table <- one_shot_walk_lambda(lambda_params, lambda_body, lambda_line, false, names, flags, consumed, unbound_moved, table)
                    Expr.Construct(type_expression, fields, line) | Expr.RecordUpdate(type_expression, fields, line):
                        for field in fields |table, consumed| -> table:
                            table <- walk_affine_expression(field.value, names, flags, consumed, table)
                    Expr.Array(elements, line) | Expr.Tuple(elements, line) | Expr.SetLit(elements, line):
                        for element in elements |table, consumed| -> table:
                            table <- walk_affine_expression(element, names, flags, consumed, table)
                    Expr.Binary(left, operator, right, line):
                        table <- walk_affine_expression(left, names, flags, consumed, table)
                        table <- walk_affine_expression(right, names, flags, consumed, table) if operator != TokenKind.Is and operator != TokenKind.As
                    Expr.Paren(inner, line):
                        table <- walk_affine_expression(inner, names, flags, consumed, table)
                    # `await EXPR` / value-transparent blocks: walk the payload so a moved
                    # task handle used after `task_group_add(..., move task)` is flagged.
                    Expr.Block(statements, value, captures, line):
                        table <- walk_affine_expression(value, names, flags, consumed, table)
                    # The iterable runs once; the filter and the element run once PER ELEMENT, so
                    # `[move g for i in 0..<n]` moves the outer `g` n times (stage0 counts it
                    # once). Walk them against a copy and report an outer local they consume, as
                    # walk_affine_loop_body does for a statement loop.
                    Expr.Comprehension(loop_variable, iterable, condition, body, comprehension_line):
                        table <- walk_affine_expression(iterable, names, flags, consumed, table)
                        repeated: mutable darray[sview] = []
                        repeated.extend(consumed)
                        table <- walk_affine_expression(condition, names, flags, repeated, table)
                        table <- walk_affine_expression(body, names, flags, repeated, table)
                        for repeated_name in repeated |consumed, table| -> table:
                            if repeated_name != loop_variable and not affine_consumed(consumed, repeated_name):
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AffineUseAfterConsume, name: repeated_name, pos: comprehension_line, line: comprehension_line.line, expected: "loop", actual: ""})
                                consumed.push(repeated_name)
                    # `try X else ...` nested inside a larger expression: the guarded call runs;
                    # a statement-level recovery is walked by walk_affine_statement_value.
                    Expr.GetElse(guarded, recovery, get_else_line):
                        table <- walk_affine_expression(guarded, names, flags, consumed, table)
                    # `try X else FALLBACK` is Refinement(fallback, guarded): the guarded call runs
                    # first, and the fallback's moves happen on the error path.
                    Expr.Refinement(fallback, guarded, refinement_line):
                        table <- walk_affine_expression(guarded, names, flags, consumed, table)
                        table <- walk_affine_expression(fallback, names, flags, consumed, table)
                    _:
                        pass


        def walk_affine_statements(statements: darray[Ast::Stmt], names: mutable darray[sview]&, flags: mutable darray[bool]&, consumed: mutable darray[sview]&, partial: mutable darray[sview]&, broken: mutable darray[sview]&, continued: mutable darray[sview]&, in_scope: mutable darray[sview]&, leaked: mutable darray[sview]&, linear_names: darray[sview]&, consuming_fns: darray[sview]&, consuming_positions: darray[usize]&, try_lines: darray[u32]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |names, flags, consumed, partial, broken, continued, in_scope, leaked, table| -> table:
                    match statement:
                        Stmt.Break(_, _):
                            # The state at a `break` skips the back edge but reaches the code after
                            # the loop: the enclosing walk_affine_loop_body folds it in there.
                            for broken_name in consumed |broken|:
                                broken.push(broken_name) if not affine_consumed(broken, broken_name)
                            # A `break` leaves the loop body's scope: a linear local declared in
                            # it and still live here is dropped without being consumed.
                            linear_exit_leaks(in_scope, consumed, leaked, true)
                        Stmt.Continue(_, _):
                            # The state at a `continue` skips the rest of the body (a reinitialization
                            # after it does not happen on this path) and starts the next iteration.
                            for continued_name in consumed |continued|:
                                continued.push(continued_name) if not affine_consumed(continued, continued_name)
                            linear_exit_leaks(in_scope, consumed, leaked, true)
                        Stmt.VarDecl(name, type_expression, value, line):
                            bound_moved: mutable darray[sview] = []
                            if one_shot_value_is_lambda(value):
                                table <- one_shot_walk_bound(value, names, flags, consumed, bound_moved, table)
                            else:
                                table <- walk_affine_statement_value(value, names, flags, consumed, partial, broken, continued, in_scope, leaked, linear_names, consuming_fns, consuming_positions, try_lines, table)
                            try_exit_leaks(line, in_scope, consumed, leaked, try_lines)
                            # A declaration binds a fresh value: an earlier binding's consumption
                            # (say, in a sibling branch) says nothing about it.
                            consumed <- [held for held in consumed if held != name]
                            partial <- [held for held in partial if held != name]
                            names.push(name)
                            flags.push(affine_type_expression(type_expression, table))
                            in_scope.push(name) if linear_local_type(type_expression, value, linear_names, table) != ""
                            one_shot_register(name, bound_moved, names, flags)
                        Stmt.Assign(target, operator, value, line):
                            assign_bound_moved: mutable darray[sview] = []
                            if operator == TokenKind.Assign and one_shot_value_is_lambda(value):
                                table <- one_shot_walk_bound(value, names, flags, consumed, assign_bound_moved, table)
                            else:
                                table <- walk_affine_statement_value(value, names, flags, consumed, partial, broken, continued, in_scope, leaked, linear_names, consuming_fns, consuming_positions, try_lines, table)
                            try_exit_leaks(line, in_scope, consumed, leaked, try_lines)
                            # `o <- K{...}` RE-INITIALISES `o`: its consumption is discharged and a
                            # later move is legal again, exactly as stage0 accepts.
                            reinit_name: sview = ident_name_of(target)
                            consumed <- [held for held in consumed if held != reinit_name] if operator == TokenKind.LArrow and reinit_name != ""
                            partial <- [held for held in partial if held != reinit_name] if operator == TokenKind.LArrow and reinit_name != ""
                            # An un-annotated `t = Ticket.new(...)` binds a fresh linear local (parsed
                            # as Assign, not VarDecl); register it so a later `move t` is tracked.
                            assign_name: sview = ident_name_of(target)
                            assign_is_linear: bool = assign_name != "" and linear_local_type((Ast::Expr.Absent), value, linear_names, table) != ""
                            names.push(assign_name) if assign_is_linear
                            flags.push(true) if assign_is_linear
                            in_scope.push(assign_name) if assign_is_linear
                            one_shot_register(assign_name, assign_bound_moved, names, flags) if assign_name != ""
                        Stmt.Expr(expression, line):
                            table <- walk_affine_statement_value(expression, names, flags, consumed, partial, broken, continued, in_scope, leaked, linear_names, consuming_fns, consuming_positions, try_lines, table)
                            try_exit_leaks(line, in_scope, consumed, leaked, try_lines)
                            # `raise E.X` leaves the function like a `return`: every linear local
                            # still live here is dropped on the error path.
                            linear_exit_leaks(in_scope, consumed, leaked, false) if affine_is_raise(expression)
                            # A consuming call `f(x)` (f drives x to a terminal typestate)
                            # completes x's protocol — mark the linear-local argument consumed.
                            match expression:
                                Expr.Call(consume_callee, consume_args, consume_arg_names, consume_line):
                                    match consume_callee:
                                        Expr.Ident(consume_fn, consume_fn_line):
                                            cc_probe: mutable usize = 0
                                            while cc_probe < consuming_fns.count |cc_probe, consumed, consume_fn, consume_args, consuming_fns, consuming_positions, names, flags|:
                                                if consuming_fns[cc_probe] == consume_fn and consuming_positions[cc_probe] < consume_args.count:
                                                    consume_root: sview = affine_root(consume_args[consuming_positions[cc_probe]])
                                                    consumed.push(consume_root) if consume_root != "" and affine_local(names, flags, consume_root) and not affine_consumed(consumed, consume_root)
                                                cc_probe <- cc_probe + 1
                                        _:
                                            pass
                                _:
                                    pass
                        Stmt.Return(value, line):
                            match value:
                                returned:
                                    table <- walk_affine_statement_value(returned, names, flags, consumed, partial, broken, continued, in_scope, leaked, linear_names, consuming_fns, consuming_positions, try_lines, table)
                                    returned_root: sview = affine_root(returned)
                                    consumed.push(returned_root) if returned_root != "" and affine_local(names, flags, returned_root) and not affine_consumed(consumed, returned_root)
                                _:
                                    pass
                            # Every linear local in scope that this path has not consumed is
                            # dropped by the `return` (the value's own moves count first).
                            linear_exit_leaks(in_scope, consumed, leaked, false)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- walk_affine_expression(condition, names, flags, consumed, table)
                            try_exit_leaks(line, in_scope, consumed, leaked, try_lines)
                            then_consumed: mutable darray[sview] = []
                            else_consumed: mutable darray[sview] = []
                            then_consumed.extend(consumed)
                            else_consumed.extend(consumed)
                            if_scope_mark: usize = in_scope.count
                            table <- walk_affine_statements(then_body, names, flags, then_consumed, partial, broken, continued, in_scope, leaked, linear_names, consuming_fns, consuming_positions, try_lines, table)
                            in_scope.truncate(if_scope_mark)
                            table <- walk_affine_statements(else_body, names, flags, else_consumed, partial, broken, continued, in_scope, leaked, linear_names, consuming_fns, consuming_positions, try_lines, table)
                            in_scope.truncate(if_scope_mark)
                            # MAY-consumed, as stage0: a value either branch consumed is gone after the
                            # `if` (a one-branch `sink(move t)` then `sink(move t)` is a double move). A
                            # branch that always leaves (`return`/`break`) contributes nothing.
                            then_exits: bool = affine_body_exits(then_body)
                            else_exits: bool = affine_body_exits(else_body)
                            if not (then_exits and else_exits):
                                # MUST-consumed is what the scope-exit leak check needs: a value
                                # newly consumed on one fall-through branch but not the other is
                                # only PARTIALLY consumed (`if c: release(move g)` leaks g on the
                                # else path). Recorded before the merge below widens `consumed`.
                                for then_new in then_consumed |partial|:
                                    partial.push(then_new) if not then_exits and not else_exits and not affine_consumed(consumed, then_new) and not affine_consumed(else_consumed, then_new) and not affine_consumed(partial, then_new)
                                for else_new in else_consumed |partial|:
                                    partial.push(else_new) if not then_exits and not else_exits and not affine_consumed(consumed, else_new) and not affine_consumed(then_consumed, else_new) and not affine_consumed(partial, else_new)
                                # Both branch snapshots begin with the pre-if consumed state.
                                # Add the names from every branch that can fall through; the
                                # destination already retains all earlier consumptions, so no
                                # destructive filter or temporary region-backed darray is needed.
                                for then_name in then_consumed |consumed|:
                                    consumed.push(then_name) if not then_exits and not affine_consumed(consumed, then_name)
                                for else_name in else_consumed |consumed|:
                                    consumed.push(else_name) if not else_exits and not affine_consumed(consumed, else_name)
                        Stmt.Block(kind, clause, binding, body, line):
                            moved_root: sview = move_block_root(kind, body)
                            block_scope_mark: usize = in_scope.count
                            table <- walk_affine_statements(body, names, flags, consumed, partial, broken, continued, in_scope, leaked, linear_names, consuming_fns, consuming_positions, try_lines, table)
                            in_scope.truncate(block_scope_mark)
                            consumed.push(moved_root) if moved_root != "" and affine_local(names, flags, moved_root) and not affine_consumed(consumed, moved_root)
                        Stmt.While(condition, body, line):
                            table <- walk_affine_expression(condition, names, flags, consumed, table)
                            try_exit_leaks(line, in_scope, consumed, leaked, try_lines)
                            no_loop_variables: darray[sview] = []
                            table <- walk_affine_loop_body(body, no_loop_variables, line, names, flags, consumed, partial, broken, continued, in_scope, leaked, linear_names, consuming_fns, consuming_positions, try_lines, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- walk_affine_expression(iterable, names, flags, consumed, table)
                            try_exit_leaks(line, in_scope, consumed, leaked, try_lines)
                            table <- walk_affine_loop_body(body, variables, line, names, flags, consumed, partial, broken, continued, in_scope, leaked, linear_names, consuming_fns, consuming_positions, try_lines, table)
                        Stmt.Match(scrutinee, arms, line):
                            matched_root: sview = affine_match_root(scrutinee)
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AffineUseAfterConsume, name: matched_root, line: line.line, expected: "match", actual: ""}) if matched_root != "" and affine_consumed(consumed, matched_root)
                            table <- walk_affine_expression(scrutinee, names, flags, consumed, table)
                            try_exit_leaks(line, in_scope, consumed, leaked, try_lines)
                            # Each arm starts from the state before the `match` (arm B does not see arm
                            # A's move); afterwards a value is consumed if any arm that falls through
                            # consumed it.
                            arms_merged: mutable darray[sview] = []
                            # For each merged name, how many fall-through arms consumed it; one
                            # consumed by fewer than all of them is only PARTIALLY consumed.
                            arms_merged_counts: mutable darray[usize] = []
                            falling_arms: mutable usize = 0
                            any_arm_falls_through: mutable bool = false
                            for arm in arms |table, consumed, partial, arms_merged, arms_merged_counts, falling_arms, any_arm_falls_through| -> table:
                                arm_consumed: mutable darray[sview] = []
                                arm_consumed.extend(consumed)
                                arm_scope_mark: usize = in_scope.count
                                table <- walk_affine_statements(arm.body, names, flags, arm_consumed, partial, broken, continued, in_scope, leaked, linear_names, consuming_fns, consuming_positions, try_lines, table)
                                in_scope.truncate(arm_scope_mark)
                                if not affine_body_exits(arm.body):
                                    any_arm_falls_through <- true
                                    falling_arms <- falling_arms + 1
                                    for arm_name in arm_consumed |arms_merged, arms_merged_counts|:
                                        merged_index: mutable usize = arms_merged.count
                                        for probe_index in 0..<arms_merged.count |merged_index|:
                                            merged_index <- probe_index if arms_merged[probe_index] == arm_name
                                        if merged_index < arms_merged.count:
                                            arms_merged_counts[merged_index] <- arms_merged_counts[merged_index] + 1
                                        else:
                                            arms_merged.push(arm_name)
                                            arms_merged_counts.push(1)
                            for count_index in 0..<arms_merged.count |partial|:
                                partial_name: sview = arms_merged[count_index]
                                partial.push(partial_name) if arms_merged_counts[count_index] < falling_arms and not affine_consumed(consumed, partial_name) and not affine_consumed(partial, partial_name)
                            if any_arm_falls_through:
                                # Add the union of the arms that fall through to the existing
                                # consumed state; every arm snapshot began from that state.
                                for arm_merged_name in arms_merged |consumed|:
                                    consumed.push(arm_merged_name) if not affine_consumed(consumed, arm_merged_name)
                            consumed.push(matched_root) if matched_root != "" and affine_local(names, flags, matched_root) and not affine_consumed(consumed, matched_root)
                        _:
                            pass


        # A loop with a `|...|` header, and any value-position block, parses as
        # `Expr.Block(statements, value, captures)`. walk_affine_expression sees only the
        # value, so the statements are walked here, ahead of it. Without this every move
        # inside a captured loop escaped tracking (`while c |c|: sink(move t)` was a silent
        # double move while the capture-less loop was rejected).
        def walk_affine_block_statements(expression: Ast::Expr, names: mutable darray[sview]&, flags: mutable darray[bool]&, consumed: mutable darray[sview]&, partial: mutable darray[sview]&, broken: mutable darray[sview]&, continued: mutable darray[sview]&, in_scope: mutable darray[sview]&, leaked: mutable darray[sview]&, linear_names: darray[sview]&, consuming_fns: darray[sview]&, consuming_positions: darray[usize]&, try_lines: darray[u32]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Block(block_statements, block_value, block_captures, block_line):
                        value_block_mark: usize = in_scope.count
                        table <- walk_affine_statements(block_statements, names, flags, consumed, partial, broken, continued, in_scope, leaked, linear_names, consuming_fns, consuming_positions, try_lines, table)
                        in_scope.truncate(value_block_mark)
                    _:
                        pass

        # A statement value: a `try X else <return|raise|break|continue|err: BLOCK>` walks the
        # guarded call, then its recovery as a branch taken on the error path; anything else
        # walks its value-block statements and then the expression.
        def walk_affine_statement_value(expression: Ast::Expr, names: mutable darray[sview]&, flags: mutable darray[bool]&, consumed: mutable darray[sview]&, partial: mutable darray[sview]&, broken: mutable darray[sview]&, continued: mutable darray[sview]&, in_scope: mutable darray[sview]&, leaked: mutable darray[sview]&, linear_names: darray[sview]&, consuming_fns: darray[sview]&, consuming_positions: darray[usize]&, try_lines: darray[u32]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.GetElse(guarded, recovery, get_else_line):
                        table <- walk_affine_statement_value(guarded, names, flags, consumed, partial, broken, continued, in_scope, leaked, linear_names, consuming_fns, consuming_positions, try_lines, table)
                        recovery_consumed: mutable darray[sview] = []
                        recovery_consumed.extend(consumed)
                        recovery_scope_mark: usize = in_scope.count
                        table <- walk_affine_statements(recovery, names, flags, recovery_consumed, partial, broken, continued, in_scope, leaked, linear_names, consuming_fns, consuming_positions, try_lines, table)
                        in_scope.truncate(recovery_scope_mark)
                        # A recovery that leaves (`return`, `raise`, `break`, `continue`) hands
                        # nothing to the code after the statement; one that falls through is a
                        # branch the success path skips: its moves are MAY-consumed and, being
                        # on one path only, PARTIAL.
                        if not affine_body_exits(recovery):
                            for recovery_name in recovery_consumed |consumed, partial|:
                                partial.push(recovery_name) if not affine_consumed(consumed, recovery_name) and not affine_consumed(partial, recovery_name)
                                consumed.push(recovery_name) if not affine_consumed(consumed, recovery_name)
                    _:
                        table <- walk_affine_block_statements(expression, names, flags, consumed, partial, broken, continued, in_scope, leaked, linear_names, consuming_fns, consuming_positions, try_lines, table)
                        table <- walk_affine_expression(expression, names, flags, consumed, table)

        # A propagating `try` on the statement at `pos` leaves the function on error: every
        # linear local live after the statement's value is walked is dropped there.
        def try_exit_leaks(pos: Ast::Pos, in_scope: darray[sview]&, consumed: darray[sview]&, leaked: mutable darray[sview]&, try_lines: darray[u32]&) -> void:
            can Memory.Allocate, Abort.Panic:
                linear_exit_leaks(in_scope, consumed, leaked, false) if any try_line in try_lines where try_line == pos.line

        def affine_is_raise(expression: Ast::Expr) -> bool:
            can Abort.Panic:
                match expression:
                    Expr.Call(raise_callee, raise_arguments, raise_argument_names, raise_line):
                        match raise_callee:
                            Expr.Ident(raise_name, raise_name_line):
                                return raise_name == "raise"
                            _:
                                return false
                    _:
                        return false

        # Records in `leaked` every linear local in `in_scope` that `consumed` does not hold:
        # the ones a `return` (all of them) or a `break`/`continue` (those above the innermost
        # loop sentinel "") drops at this point.
        def linear_exit_leaks(in_scope: darray[sview]&, consumed: darray[sview]&, leaked: mutable darray[sview]&, loop_only: bool) -> void:
            can Memory.Allocate, Abort.Panic:
                stopped: mutable bool = false
                scope_index: mutable usize = in_scope.count
                while scope_index > 0 |scope_index, stopped, leaked, in_scope, consumed, loop_only|:
                    scope_index <- scope_index - 1
                    scope_name: sview = in_scope[scope_index]
                    stopped <- true if scope_name == "" and loop_only
                    leaked.push(scope_name) if not stopped and scope_name != "" and not affine_consumed(consumed, scope_name) and not affine_consumed(leaked, scope_name)

        # Whether control never reaches the end of `statements`: it ends in `return`,
        # `break` or `continue`, or in an `if` whose branches both do. After a `continue`
        # the rest of the body does not run on that path, so it counts as leaving.
        def affine_body_exits(statements: darray[Ast::Stmt]&) -> bool:
            can Abort.Panic:
                return false if statements.count == 0
                return match statements[statements.count - 1]:
                    Stmt.Return(_, _): true
                    Stmt.Break(_, _): true
                    Stmt.Continue(_, _): true
                    Stmt.Expr(exit_expression, _): affine_is_raise(exit_expression)
                    Stmt.If(_, then_body, else_body, _): affine_body_exits(then_body) and affine_body_exits(else_body)
                    Stmt.Block(_, _, _, block_body, _): affine_body_exits(block_body)
                    _: false

        # A loop body runs once per iteration, so walk it against a copy of the state. An
        # outer affine local still consumed when the iteration ends is consumed AGAIN by the
        # next one (a double move: two `__drop__`s, two `fclose`s) unless the body always
        # leaves the loop. Stage0 accepts that; this reports it. What the body consumed stays
        # consumed after the loop, as stage0 does (`while ...: sink(move t)` then `t.v`).
        # Names the body or the loop header declares are per-iteration and never leak out.
        def walk_affine_loop_body(body: darray[Ast::Stmt], loop_variables: darray[sview]&, loop_pos: Ast::Pos, names: mutable darray[sview]&, flags: mutable darray[bool]&, consumed: mutable darray[sview]&, partial: mutable darray[sview]&, broken: mutable darray[sview]&, continued: mutable darray[sview]&, in_scope: mutable darray[sview]&, leaked: mutable darray[sview]&, linear_names: darray[sview]&, consuming_fns: darray[sview]&, consuming_positions: darray[usize]&, try_lines: darray[u32]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                outer_count: usize = names.count
                for loop_variable in loop_variables |names, flags|:
                    names.push(loop_variable)
                    flags.push(false)
                body_consumed: mutable darray[sview] = []
                body_consumed.extend(consumed)
                # States at this loop's own `break`s (a nested loop collects its own).
                body_broken: mutable darray[sview] = []
                body_continued: mutable darray[sview] = []
                # The sentinel "" marks where this body's scope starts: `break`/`continue`
                # leave only the linear locals above it.
                loop_scope_mark: usize = in_scope.count
                in_scope.push("")
                table <- walk_affine_statements(body, names, flags, body_consumed, partial, body_broken, body_continued, in_scope, leaked, linear_names, consuming_fns, consuming_positions, try_lines, table)
                in_scope.truncate(loop_scope_mark)
                body_exits: bool = affine_body_exits(body)
                # After the loop a value is consumed if the fall-through end of the body (when
                # it has one; `continue` paths merge into it) or any `break` consumed it. A body
                # that always leaves by `return` contributes nothing to the code after the loop.
                for consumed_name in body_consumed |consumed, table| -> table:
                    declared_inside: mutable bool = false
                    for inner_index in outer_count..<names.count:
                        declared_inside <- true if names[inner_index] == consumed_name
                    if not declared_inside and not affine_consumed(consumed, consumed_name) and not body_exits:
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AffineUseAfterConsume, name: consumed_name, pos: loop_pos, line: loop_pos.line, expected: "loop", actual: ""})
                        consumed.push(consumed_name)
                    # A linear local the body declares AND consumes was discharged within its
                    # own iteration; record it so the scope-exit leak check (keyed by name over
                    # the whole function) sees it. It is out of scope after the loop, so no
                    # later use can observe this; one the body leaves unconsumed stays a leak.
                    consumed.push(consumed_name) if declared_inside and not affine_consumed(consumed, consumed_name)
                # A `continue` state is a second back edge: consumed there and live on entry is
                # consumed again by the next iteration, and it also reaches the code after the
                # loop when that iteration is the last.
                for continued_name in body_continued |consumed, table| -> table:
                    continued_inside: mutable bool = false
                    for continued_index in outer_count..<names.count:
                        continued_inside <- true if names[continued_index] == continued_name
                    if not continued_inside and not affine_consumed(consumed, continued_name):
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AffineUseAfterConsume, name: continued_name, pos: loop_pos, line: loop_pos.line, expected: "loop", actual: ""})
                        consumed.push(continued_name)
                    # Discharged within its own iteration on this path (see body_consumed).
                    consumed.push(continued_name) if continued_inside and not affine_consumed(consumed, continued_name)
                # A body-declared name consumed at a `break` was discharged in its iteration.
                for broken_name in body_broken |consumed|:
                    consumed.push(broken_name) if not affine_consumed(consumed, broken_name)

        # Names of `linear struct`/`linear typestate` types (affinity "linear"): a value of such
        # a type must be consumed exactly once, so an unconsumed local is a leak.
        def collect_linear_type_names(declarations: darray[Ast::Decl], out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations:
                    match declaration:
                        Decl.Struct(struct_name, members, affinity, has_named_states, has_derive, invariants, struct_line):
                            out.push(struct_name) if affinity == "linear"
                        Decl.Module(module_name, module_body, module_line):
                            collect_linear_type_names(module_body, out)
                        Decl.Scoped(scoped_body, scoped_line):
                            collect_linear_type_names(scoped_body, out)
                        _:
                            pass

        def linear_type_name_present(names: darray[sview]&, wanted: sview) -> bool:
            can Abort.Panic:
                return any name in names where name == wanted

        # The linear type name of a local (from its `: Linear` / `: Linear[State]` annotation or a
        # `Linear.new(...)` initializer), or "" when the local is not linear-typed.
        # Whether WHOLE equals PREFIX ++ MIDDLE ++ SUFFIX byte-for-byte.
        def linear_sview_wrapped(whole: sview, prefix: sview, middle: sview, suffix: sview) -> bool:
            can Abort.Panic:
                prefix_len: usize = sview_len(prefix)
                middle_len: usize = sview_len(middle)
                suffix_len: usize = sview_len(suffix)
                false return if sview_len(whole) != prefix_len + middle_len + suffix_len
                prefix_ok: bool =
                    for probe in 0..<prefix_len |ok: bool = true| -> ok:
                        ok <- false if sview_at(whole, probe) != sview_at(prefix, probe)
                false return if not prefix_ok
                middle_ok: bool =
                    for probe in 0..<middle_len |ok: bool = true| -> ok:
                        ok <- false if sview_at(whole, prefix_len + probe) != sview_at(middle, probe)
                false return if not middle_ok
                result: bool =
                    for probe in 0..<suffix_len |ok: bool = true| -> ok:
                        ok <- false if sview_at(whole, prefix_len + middle_len + probe) != sview_at(suffix, probe)
                return result

        # The linear type T of a synthesized typestate constructor call `__typestate_T_new(...)`
        # (the lowering of `T.new(...)` for a `linear typestate T`), else "". T must be a known
        # linear type name.
        def linear_typestate_new_type(callee_name: sview, linear_names: darray[sview]&) -> sview:
            can Memory.Allocate, Abort.Panic:
                prefix: sview = sview("__typestate_", 0, -1)
                suffix: sview = sview("_new", 0, -1)
                found: mutable sview = sview("", 0, 0)
                for candidate in linear_names |found|:
                    found <- candidate if found == "" and linear_sview_wrapped(callee_name, prefix, candidate, suffix)
                return found

        def linear_local_type(type_expression: Ast::Expr, value: Ast::Expr, linear_names: darray[sview]&, table: SymbolTable&) -> sview:
            can Memory.Allocate, Abort.Panic:
                head_name: sview = match type_expression:
                    Expr.Index(head, argument, index_line): ident_name_of(head)
                    Expr.IndexN(head, arguments, index_n_line): ident_name_of(head)
                    _: bare_type_name(type_expression)
                head_name return if head_name != "" and linear_type_name_present(linear_names, head_name)
                match value:
                    Expr.Call(callee, arguments, argument_names, call_line):
                        match callee:
                            Expr.Field(object, field, field_line):
                                ctor_type: sview = ident_name_of(object)
                                return ctor_type if field == "new" and linear_type_name_present(linear_names, ctor_type) else sview("", 0, 0)
                            _:
                                return linear_typestate_new_type(ident_name_of(callee), linear_names)
                    _:
                        return sview("", 0, 0)

        # Collect (linear-local name, decl line) declared in a statement list (recursively).
        def collect_linear_locals(statements: darray[Ast::Stmt], linear_names: darray[sview]&, table: SymbolTable&, out_names: mutable darray[sview]&, out_lines: mutable darray[u32]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |out_names, out_lines|:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            linear_type: sview = linear_local_type(type_expression, value, linear_names, table)
                            out_names.push(name) if linear_type != ""
                            out_lines.push(line.line) if linear_type != ""
                        Stmt.Assign(target, operator, value, line):
                            # An un-annotated first binding `t = Ticket.new(...)` parses as Assign,
                            # not VarDecl; detect a linear-valued one by its target ident.
                            assign_name: sview = ident_name_of(target)
                            assign_type: sview = linear_local_type((Ast::Expr.Absent), value, linear_names, table) if assign_name != "" else sview("", 0, 0)
                            out_names.push(assign_name) if assign_type != ""
                            out_lines.push(line.line) if assign_type != ""
                        Stmt.If(condition, then_body, else_body, line):
                            collect_linear_locals(then_body, linear_names, table, out_names, out_lines)
                            collect_linear_locals(else_body, linear_names, table, out_names, out_lines)
                        Stmt.While(condition, body, line):
                            collect_linear_locals(body, linear_names, table, out_names, out_lines)
                        Stmt.For(bind, variables, iterable, body, line):
                            collect_linear_locals(body, linear_names, table, out_names, out_lines)
                        Stmt.Block(kind, clause, binding, body, line):
                            collect_linear_locals(body, linear_names, table, out_names, out_lines)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |out_names, out_lines|:
                                collect_linear_locals(arm.body, linear_names, table, out_names, out_lines)
                        _:
                            pass

        # A BARE `return g` of a linear local returns it by COPY; a linear value must be moved
        # out (`return move g`). `move` wraps the value in Expr.Move, so only a plain-ident
        # return of a known linear local is flagged. Self-contained (own linear-local set),
        # so it needs no threading through the affine walk.
        def linear_return_walk(statements: darray[Ast::Stmt], linear_local_names: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Return(value, line):
                            if value is returned:
                                match returned:
                                    Expr.Ident(returned_name, returned_line):
                                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AffineMoveRequired, name: returned_name, line: line.line, expected: "Return", actual: ""}) if any linear_name in linear_local_names where linear_name == returned_name
                                    _:
                                        pass
                        Stmt.If(condition, then_body, else_body, if_line):
                            table <- linear_return_walk(then_body, linear_local_names, table)
                            table <- linear_return_walk(else_body, linear_local_names, table)
                        Stmt.While(while_condition, while_body, while_line):
                            table <- linear_return_walk(while_body, linear_local_names, table)
                        Stmt.For(bind, variables, iterable, for_body, for_line):
                            table <- linear_return_walk(for_body, linear_local_names, table)
                        Stmt.Block(block_kind, block_clause, block_binding, block_body, block_stmt_line):
                            table <- linear_return_walk(block_body, linear_local_names, table)
                        Stmt.Match(scrutinee, arms, match_line):
                            for arm in arms |table| -> table:
                                table <- linear_return_walk(arm.body, linear_local_names, table)
                        _:
                            pass

        def check_affine_uses(declarations: darray[Ast::Decl], linear_names: darray[sview]&, consuming_fns: darray[sview]&, consuming_positions: darray[usize]&, try_lines: darray[u32]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            names: mutable darray[sview] = []
                            flags: mutable darray[bool] = []
                            consumed: mutable darray[sview] = []
                            partial: mutable darray[sview] = []
                            # A `break` outside any loop is rejected elsewhere; its state goes nowhere.
                            broken: mutable darray[sview] = []
                            continued: mutable darray[sview] = []
                            # Linear locals in lexical scope, and those an early exit dropped live.
                            in_scope: mutable darray[sview] = []
                            leaked: mutable darray[sview] = []
                            alias_names: mutable darray[sview] = []
                            alias_roots: mutable darray[sview] = []
                            shutdown_names: mutable darray[sview] = []
                            shutdown_flags: mutable darray[bool] = []
                            for param in params |names, flags|:
                                names.push(param.name)
                                flags.push(affine_type_expression(param.type_expression, table))
                            table <- walk_affine_statements(body, names, flags, consumed, partial, broken, continued, in_scope, leaked, linear_names, consuming_fns, consuming_positions, try_lines, table)
                            # Linear locals must be consumed on every path. The affine `consumed`
                            # set (built above, with branch-merge) is MAY-consumed; a linear local
                            # absent from it, or consumed on only some paths (`partial`), is
                            # leaked at scope exit, as is one an early `return`/`break`/`continue`
                            # dropped while still live (`leaked`).
                            linear_local_names: mutable darray[sview] = []
                            linear_local_lines: mutable darray[u32] = []
                            collect_linear_locals(body, linear_names, table, linear_local_names, linear_local_lines)
                            while linear_probe < linear_local_names.count |linear_probe: usize = 0, table| -> table:
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.LinearScopeExit, name: linear_local_names[linear_probe], line: linear_local_lines[linear_probe], expected: "", actual: ""}) if not affine_consumed(consumed, linear_local_names[linear_probe]) or affine_consumed(partial, linear_local_names[linear_probe]) or affine_consumed(leaked, linear_local_names[linear_probe])
                                linear_probe <- linear_probe + 1
                            table <- linear_return_walk(body, linear_local_names, table)
                            lifecycle: u32 = lifecycle_statement_flags(body)
                            table <- walk_thread_pool_lifecycle(body, alias_names, alias_roots, shutdown_names, shutdown_flags, table) if (lifecycle & 8) != 0
                            for param in params |table| -> table:
                                obligation: sview = exit_obligation(param.type_expression, table)
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AffineScopeExit, name: param.name, line: line.line, expected: obligation, actual: ""}) if obligation != "" and body_is_empty_pass(body)
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AffineScopeExit, name: "group", line: line.line, expected: "task group with pending tasks", actual: ""}) if (lifecycle & 1) != 0 and (lifecycle & 2) == 0
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AffineScopeExit, name: "pool", line: line.line, expected: "thread pool requiring shutdown", actual: ""}) if (lifecycle & 4) != 0 and (lifecycle & 8) == 0
                        Decl.Module(name, body, line):
                            table <- check_affine_uses(body, linear_names, consuming_fns, consuming_positions, try_lines, table)
                        Decl.Scoped(body, line):
                            table <- check_affine_uses(body, linear_names, consuming_fns, consuming_positions, try_lines, table)
                        _:
                            pass

    public:
        def check_affine_use_flow(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                linear_names: mutable darray[sview] = []
                collect_linear_type_names(file.top_decls, linear_names)
                # A call `f(x)` where f declares a typestate postcondition `x => S` drives x's
                # protocol forward via the callee — so passing a linear local there COMPLETES
                # its obligation for the caller (the callee owns the transition). Collect the
                # (fn, position) pairs that carry a typestate postcondition.
                consuming_fns: mutable darray[sview] = []
                consuming_positions: mutable darray[usize] = []
                for postcondition in file.typestate_postconditions |consuming_fns, consuming_positions|:
                    consuming_fns.push(postcondition.function_name)
                    consuming_positions.push(postcondition.position.usize())
                # The lines of each propagating `try` (no `else`): the parser erases the node
                # and leaves only this annotation, so the statement on that line is the exit.
                try_lines: mutable darray[u32] = []
                for try_annotation in file.enum_annotations |try_lines|:
                    try_lines.push(try_annotation.line) if try_annotation.name == "__try_without_else"
                table <- check_affine_uses(file.top_decls, linear_names, consuming_fns, consuming_positions, try_lines, table)
