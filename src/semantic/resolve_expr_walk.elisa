# Stage1 semantic — the expression resolution walk (`extend Semantic: private:`).
# `walk_expression_inner` visits every expression form, resolving names against the
# bound set and running the per-form checks; the helpers above it recognize type
# applications and reduce callbacks. Continues resolve_expr.elisa; split out to keep
# each part file under 600 lines.

extend Semantic:
    private:
        # Resolve every identifier in a value expression, recursing into children. Field names
        # (`object.field`) are member selectors, not references, so only the object is walked.
        #
        # Depth-guarded wrapper: every recursive re-entry (Call/Field/Index/Binary/…
        # inside `walk_expression_inner` calls `walk_expression`) passes through here. A
        # pathologically deep AST must produce a hard diagnostic rather than overflowing
        # the stack or silently skipping the unvisited suffix.
        # Whether an `Index`/`IndexN` receiver is a type-application field operator — `.cast`,
        # `.ref`, `.specialize`, `.call_as`. For these the bracket holds a TYPE argument
        # (`x.cast[i64]`, `p.ref[T]`, `f.specialize[T]`), not a value to resolve; walking
        # it as a value reference falsely reports the type name as an undefined name.
        def index_receiver_is_type_application(object: Ast::Expr) -> bool:
            can Abort.Panic:
                match object:
                    Expr.Field(field_object, field_name, field_line):
                        return field_name == "cast" or field_name == "ref" or field_name == "specialize" or field_name == "call_as"
                    _:
                        return false


        # Generic externs are retained as declaration annotations because their parameter
        # types cannot be resolved until the call supplies the concrete type. Keep this
        # semantic predicate in terms of that shared annotation contract rather than naming
        # individual compiler primitives (`va_arg`, etc.).
        def index_receiver_is_generic_extern(object: Ast::Expr, table: SymbolTable&) -> bool:
            can Abort.Panic:
                match object:
                    Expr.Ident(extern_name, extern_line):
                        for generic_name in table.generic_extern_names:
                            return true if generic_name == extern_name
                    _:
                        pass
                return false


        # Resolver-only extension of the syntactic cast/ref/specialize classifier:
        # an unshadowed declared function/type followed by `[...]` is a generic
        # specialization, so its bracket contents are type/shape arguments rather
        # than value-position references. Local `xs[i]` remains an ordinary index.
        def index_receiver_is_semantic_type_application(object: Ast::Expr, table: SymbolTable&, bound: darray[sview]&) -> bool:
            can Abort.Panic:
                true return if index_receiver_is_type_application(object)
                true return if index_receiver_is_generic_extern(object, table)
                match object:
                    Expr.Ident(base_name, base_line):
                        false return if any bound_name in bound where bound_name == base_name
                        for symbol in table.symbols:
                            true return if symbol.name == base_name and symbol.kind in {SymbolKind.Func, SymbolKind.Struct, SymbolKind.Enum, SymbolKind.Alias}
                    _:
                        pass
                return false


        # Diagnose `f[T]` when `f` is a uniquely declared, unshadowed ordinary
        # function. Function generic parameters are already recorded by declaration
        # line, so specialization validity needs no additional parser metadata.
        def check_non_generic_specialization(object: Ast::Expr, line: u32, table: lmut SymbolTable, bound: darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match object:
                    Expr.Ident(function_name, function_line):
                        return if any bound_name in bound where bound_name == function_name
                        return if direct_function_count(table, function_name) != 1
                        if find_symbol(table, function_name) is symbol:
                            return if symbol.kind != SymbolKind.Func
                            generic: mutable bool = any generic_line in table.generic_param_lines where generic_line == symbol.line
                            generic <- true if index_receiver_is_generic_extern(object, table)
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.NonGenericSpecialization, name: function_name, line: line, expected: "", actual: ""}) if not generic
                    _:
                        pass


        def numeric_accumulator_name(name: sview) -> bool:
            return name in {"i8", "i16", "i32", "i64", "int", "isize", "u8", "u16", "u32", "u64", "usize", "uintptr", "f32", "f64"}


        # `reduce_sum(source, callback)` is a numeric reduction even when the source
        # itself is numeric; a named callback returning bool/void/aggregate is invalid.
        # Restrict this to a unique direct callback declaration so overloads and local
        # callable values remain conservative until function-value typing is complete.
        def check_reduce_sum_callback(callee: Ast::Expr, arguments: darray[Ast::Expr]&, line: u32, table: lmut SymbolTable, bound: darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match callee:
                    Expr.Ident(callee_name, callee_line):
                        return if callee_name != "reduce_sum"
                    _:
                        return
                return if arguments.count < 2
                match arguments[1]:
                    Expr.Ident(callback_name, callback_line):
                        return if any bound_name in bound where bound_name == callback_name
                        return if direct_function_count(table, callback_name) != 1
                        if find_symbol(table, callback_name) is callback:
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ReduceSumNonNumericCallback, name: callback_name, line: line, expected: "", actual: callback.return_type}) if callback.kind == SymbolKind.Func and callback.return_type != "" and not numeric_accumulator_name(callback.return_type)
                    _:
                        pass


        # Whether an operator constructs a range (`a..b`, `a..<b`, `a..>b`, `a..=b`).
        def is_range_operator(operator: TokenKind) -> bool:
            can Abort.Panic:
                return when operator:
                    TokenKind.Range | TokenKind.RangeLt | TokenKind.RangeGt | TokenKind.RangeLe -> true
                    _ -> false

        def expr_is_shorthand_member(expression: Ast::Expr) -> bool:
            can Abort.Panic:
                return match expression:
                    Expr.ShorthandMember(parts, line): true
                    _: false

        def expr_is_bare_ident(expression: Ast::Expr) -> bool:
            can Abort.Panic:
                return match expression:
                    Expr.Ident(name, line): true
                    _: false

        # stage0 reads a Capitalised head as a TYPE name wherever a constructor can stand.
        # A byte range, not a locale rule: stage0 tests the first rune and every type name
        # the corpus spells is ASCII. Same predicate as emit_ast_ident_is_capitalized, which
        # the fmt/ast emitters already use for stage0's auto-region wrap rule.
        def rew_name_is_capitalized(name: sview) -> bool:
            can Abort.Panic:
                false return if sview_len(name) == 0
                head: u8 = sview_at(name, 0)
                return head >= 65 and head <= 90

        # Does any symbol named `name` carry `kind`? A chain walk over this name's own hash
        # bucket rather than a scan of every declaration (see name_known, which pays the
        # same attention): this runs once per Capitalised callee.
        def rew_name_has_kind(table: SymbolTable&, name: sview, kind: SymbolKind) -> bool:
            can Abort.Panic:
                row: mutable u32 = symbol_chain_head(table, name)
                while row != 4294967295 |row, table, name, kind|:
                    chain_symbol: Symbol& = &table.symbols[row.usize()]
                    true return if chain_symbol.name == name and chain_symbol.kind == kind
                    row <- table.symbol_name_next[row.usize()]
                return false

        def walk_expression(expression: Ast::Expr, table: lmut SymbolTable, bound: darray[sview]&, bound_mutability: darray[bool]&, bound_ids: darray[BindingId]&) -> void:
            can Memory.Allocate, Abort.Panic:
                table.walk_depth <- table.walk_depth + 1
                if table.walk_depth <= EXPRESSION_ANALYSIS_DEPTH_LIMIT:
                    table <- walk_expression_inner(expression, table, bound, bound_mutability, bound_ids)
                else:
                    already_reported: bool = any existing in table.diagnostics where existing.kind == DiagnosticKind.ExpressionAnalysisDepthExceeded
                    position: Ast::Pos = Ast::expr_pos(expression)
                    if not already_reported:
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ExpressionAnalysisDepthExceeded, name: "", pos: position, line: position.line, expected: "", actual: ""})
                table.walk_depth <- table.walk_depth - 1


        def walk_expression_inner(expression: Ast::Expr, table: lmut SymbolTable, bound: darray[sview]&, bound_mutability: darray[bool]&, bound_ids: darray[BindingId]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.StaticEffectCall(effect_type, operation, candidates, arguments, argument_names, line):
                        for child in Ast::effect_runtime_children(candidates, arguments) |table|:
                            table <- walk_expression(child, table, bound, bound_mutability, bound_ids)
                    Expr.Ident(name, line):
                        known: bool = name_known(table, bound, name)
                        # stage0 underlines the NAME (`nosuch + 1` -> `2:12-18`), which is
                        # exactly this Ident node's own extent.
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UndefinedName, name: name, line: line.line, pos: line, expected: "", actual: ""}) if not known
                        # A namespace in VALUE position (`x = M`, `M.member`) —
                        # stage0 parity (`::` accesses namespaces, `.` values).
                        module_only: bool = known and name_is_module_only(table, bound, name)
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.NamespaceUsedAsValue, name: name, line: line.line, pos: line, expected: "", actual: ""}) if module_only
                        # A resolved reference to a param/local: log it for
                        # tooling (globals are left to the symbol table).
                        reference_index: int = bound_last_index(bound, name) if known and not module_only else -1
                        table <- record_reference(table, line.line, name, reference_index.usize() < table.current_param_count, bound_ids[reference_index.usize()]) if reference_index >= 0
                        if known and not module_only and reference_index < 0 and line.end_offset > line.offset:
                            target_index: i64 = unique_top_level_function_index(table, name)
                            table.definition_references <- table.definition_references.push(DefinitionReference{pos: line, declaration_id: table.symbols[target_index.usize()].id}) if target_index >= 0
                    Expr.Call(callee, arguments, argument_names, line):
                        # `argument_names` are field/parameter labels (selectors), not value
                        # references — walk only the argument values. A module-only CALLEE
                        # ident is exempt from the namespace-as-value check: under
                        # per-file isolation a cross-file struct's paren ctor (`Parser(...)`
                        # with `struct Parser` in another part of `module Parser`) is
                        # indistinguishable from calling a namespace — a sound miss.
                        skip_namespace_callee: mutable bool = false
                        match callee:
                            Expr.Ident(namespace_callee_ident, namespace_callee_line):
                                skip_namespace_callee <- name_is_module_only(table, bound, namespace_callee_ident)
                            _:
                                pass
                        # stage0 reports the CALL form of the namespace hint beside the field
                        # form: `write M::geti(...)` as well as `write M::geti`. stage1 raised
                        # only the field one, because the bare-Ident walk beneath it has no
                        # member name and rendered the placeholder `M::member`. A callee is
                        # exactly the shape where the member IS known, so report it from here.
                        # It is raised BEFORE the callee is walked: stage0 emits the call form
                        # first, ahead of the field form and the undefined-identifier row that
                        # the walk beneath produces.
                        match callee:
                            Expr.Field(namespace_call_object, namespace_call_field, namespace_call_line):
                                if value_chain_is_module(table, bound, namespace_call_object):
                                    rebind namespace_call_text: sview, table = value_chain_text(namespace_call_object, table)
                                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.NamespaceUsedAsValue, name: namespace_call_text, pos: line, line: line.line, expected: namespace_call_field, actual: "call"})
                            _:
                                pass
                        # stage0's CAPITALISED-callee rule. `Widget(3)` with no `Widget` in
                        # scope is ONE sentence -- `unknown struct "Widget"` at the name's
                        # extent -- because a Capitalised callee is a struct constructor to
                        # stage0. stage1 spelled the value-position sentence instead and then
                        # cascaded `cannot call non-function value of type <invalid>` on top,
                        # since UndefinedName is in check_call_of_invalid's poison set. The
                        # KIND is what suppresses that cascade.
                        #
                        # The TRIGGER is unchanged: this fires on exactly the names the walk
                        # beneath would have called undefined (`not name_known`), so it adds no
                        # rejection stage1 did not already make -- only stage0's wording. That
                        # matters here, because a Capitalised name is the one shape per-file
                        # isolation could misjudge; the module-only escape hatch above
                        # (`skip_namespace_callee`) still runs first and still wins.
                        unknown_struct_callee: mutable bool = false
                        match callee:
                            Expr.Ident(struct_callee_name, struct_callee_pos):
                                # What stage0 says about a Capitalised callee, MEASURED case by
                                # case, in the order it decides:
                                #   a FUNCTION of that name exists  -> an ordinary call
                                #   a STRUCT                        -> `positional construction …`
                                #   an ENUM                         -> `type "X" is not a struct`
                                #   an alias/const, or nothing      -> `unknown struct "X"`
                                # The STRUCT case is not handled here: check_positional_construction
                                # already owns it, spells stage0's sentence and now carries its span.
                                # The other three were silent or mis-spelled.
                                #
                                # `Extern`/`Import` join `Func` on the callable side -- both name
                                # something defined ELSEWHERE, which is exactly what per-file
                                # isolation cannot see. A locally BOUND name and a module
                                # qualifier are skipped for the same reason: the callee is then
                                # not a type reference at all.
                                if rew_name_is_capitalized(struct_callee_name) and not skip_namespace_callee:
                                    callable_symbol: bool = rew_name_has_kind(table, struct_callee_name, SymbolKind.Func) or rew_name_has_kind(table, struct_callee_name, SymbolKind.Extern) or rew_name_has_kind(table, struct_callee_name, SymbolKind.Import)
                                    shadowed_callee: bool = any bound_name in bound where bound_name == struct_callee_name
                                    callee_is_struct: bool = rew_name_has_kind(table, struct_callee_name, SymbolKind.Struct)
                                    if not callable_symbol and not shadowed_callee and not callee_is_struct:
                                        # NO ENUM CASE. `Col(1)` on a plain enum is `type "Col" is
                                        # not a struct` in stage0 -- but `Event(x)` on an enum with
                                        # a `__cast__` hook is a legal HIERARCHY WIDENING CAST, and
                                        # test/differential/cases/hierarchy_arm_widening_and_casts
                                        # exists to pin exactly that ("the prefix form on a
                                        # non-struct target USED TO report type Event is not a
                                        # struct"). Telling the two apart needs the hook table, so
                                        # the enum case stays unimplemented rather than wrong.
                                        # An alias or a const is not a struct and does not resolve
                                        # as one, so stage0 falls back to `unknown struct` for it
                                        # exactly as it does for a name it never saw.
                                        callee_is_type_shaped: bool = rew_name_has_kind(table, struct_callee_name, SymbolKind.Alias) or rew_name_has_kind(table, struct_callee_name, SymbolKind.Const)
                                        callee_unresolved: bool = not name_known(table, bound, struct_callee_name)
                                        unknown_struct_callee <- callee_is_type_shaped or callee_unresolved
                                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UnknownStruct, name: struct_callee_name, pos: struct_callee_pos, line: struct_callee_pos.line, expected: "", actual: ""}) if callee_is_type_shaped or callee_unresolved
                            # NO QUALIFIED (`Shapes::Widget(3)`) ARM. It was here, keyed on the
                            # head segment being Capitalised and unknown, and cycle H measured it
                            # firing on `Inner::run()`, `Plain::a`, `Parser::parse_file()` -- a
                            # MODULE-qualified call, which is not a struct construction at all.
                            # The bare-Ident arm is exempted by `skip_namespace_callee`; there is
                            # no equivalent test for a qualifier under per-file isolation, and a
                            # nested `module Inner:` is not reachable by name from this table.
                            # The qualified sentence stays unimplemented rather than wrong.
                            _:
                                pass
                        table <- walk_expression(callee, table, bound, bound_mutability, bound_ids) if not skip_namespace_callee and not unknown_struct_callee
                        # `offset_of(Struct, FIELD)`: the second argument is a FIELD SELECTOR of
                        # the struct, not a value reference, so it must not be resolved as an
                        # identifier (it would be reported undefined). check_offset_of_field
                        # validates that the field exists instead.
                        callee_is_offsetof: mutable bool = false
                        match callee:
                            Expr.Ident(offsetof_callee_ident, offsetof_callee_line):
                                callee_is_offsetof <- offsetof_callee_ident == "offset_of" or offsetof_callee_ident == "offsetof"
                            _:
                                pass
                        argument_position: mutable usize = 0
                        for argument in arguments |table, argument_position, callee_is_offsetof| -> table:
                            table <- walk_expression(argument, table, bound, bound_mutability, bound_ids) if not (callee_is_offsetof and argument_position == 1)
                            argument_position <- argument_position + 1
                        table <- check_reduce_sum_callback(callee, arguments, line.line, table, bound)
                        # Arity check for a direct unshadowed call: `f(a, b)` with a bare
                        # callee name that is not a local/param. UFCS (`recv.f(a)`),
                        # qualified (`Mod::f(...)`), specialized (`f[T](...)`), and
                        # labeled-argument calls are skipped (shapes not modeled).
                        match callee:
                            Expr.Ident(function_name, function_line):
                                labeled: bool = any argument_name in argument_names where argument_name != ""
                                shadowed: bool = any bound_name in bound where bound_name == function_name
                                # `f(..)` forwards the caller's matching parameters, so the written
                                # argument count is not the callee's arity; check_arg_forwarding
                                # validates coverage instead.
                                call_forwards_args: bool = any forward_line in table.forward_arg_lines where forward_line == line.line
                                table <- check_call_arity_at(table, function_name, arguments, function_line, line.line) if not labeled and not shadowed and not call_forwards_args
                                # lmut single-live-binding rule: no argument bound to an
                                # `lmut` parameter may alias another argument of this call.
                                table <- check_call_lmut_aliasing(table, function_name, arguments, line.line) if not labeled and not shadowed
                                table <- check_named_call_arguments(table, function_name, argument_names, line.line) if labeled and not shadowed and not call_forwards_args
                            _:
                                pass
                        # Enum-constructor arity: `Enum.Variant(v1, …)` must supply
                        # exactly the declared payload count (labels allowed — the
                        # count is positional either way).
                        match callee:
                            Expr.Field(constructor_object, constructor_field, constructor_line):
                                match constructor_object:
                                    Expr.Ident(constructor_enum_name, constructor_enum_line):
                                        constructor_shadowed: bool = any bound_name in bound where bound_name == constructor_enum_name
                                        if not constructor_shadowed and is_enum_name(table, constructor_enum_name):
                                            constructor_variant_index: int = enum_variant_index(table, constructor_enum_name, constructor_field)
                                            constructor_total_arity: u32 = table.enum_variant_arity[constructor_variant_index.usize()] if constructor_variant_index >= 0 else 0
                                            constructor_arity: u32 = constructor_total_arity - enum_common_payload_count(table, constructor_enum_name).u32() if constructor_variant_index >= 0 else 0
                                            constructor_count_invalid: bool = arguments.count.u32() < constructor_arity or arguments.count.u32() > constructor_total_arity
                                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.VariantArity, name: constructor_field, line: line.line, expected: constructor_enum_name, actual: "", expected_count: constructor_arity, actual_count: arguments.count.u32()}) if constructor_variant_index >= 0 and constructor_count_invalid
                                            table <- check_named_enum_constructor_arguments(table, constructor_enum_name, constructor_field, argument_names, line.line) if constructor_variant_index >= 0
                                    _:
                                        pass
                            _:
                                pass
                    Expr.Field(object, field, line):
                        # A module reached with `.` -- a bare module-only name (`M.f`) or a
                        # `::` path (`Pack::Sub.f`). stage0 reports the field form once, at the
                        # `.` (the Field node's own position), with the concrete member
                        # spelling, and stops: the module name is not walked as a value and
                        # no undefined-identifier row follows (analyzer rejectDotModulePathExpr).
                        namespace_object: bool = value_chain_is_module(table, bound, object)
                        if namespace_object:
                            rebind namespace_text: sview, table = value_chain_text(object, table)
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.NamespaceUsedAsValue, name: namespace_text, pos: line, line: line.line, expected: field, actual: ""})
                        table <- walk_expression(object, table, bound, bound_mutability, bound_ids) if not namespace_object
                        match object:
                            Expr.Ident(namespace_name, namespace_line):
                                # `Enum.Variant` in value position: when the object is a bare
                                # unshadowed enum-type name, the member must be a variant.
                                packed_store_type: bool = field_is_packed_store_type(object, field, table)
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UnknownVariant, name: field, line: line.line, expected: namespace_name, actual: ""}) if not packed_store_type and not (any bound_name in bound where bound_name == namespace_name) and is_enum_name(table, namespace_name) and not enum_has_variant(table, namespace_name, field)
                            _:
                                pass
                    Expr.Scope(base, name, line):
                        # `base::name` is a namespace/type path; the leading name is
                        # resolved like any reference, `::name` is a selector. A bare
                        # module qualifier is EXACTLY where a namespace name is legal,
                        # so it must not be walked as a value (NamespaceUsedAsValue
                        # owns value positions); only non-module bases resolve here.
                        # A module declared with a QUALIFIED name (`module Outer::Inner:`) is
                        # recorded verbatim, so a use of it nests: `Outer::Inner::f` is
                        # Scope(Scope(Ident, "Inner"), "f"). Recognise that chain too, or the
                        # head gets walked as a value and reported undefined.
                        # Written as `if … is` STATEMENTS, not a match with a nested
                        # constructor arm: `Expr.Scope(Expr.Ident(h, _), m, _)` is a two-level
                        # pattern, and stage1 declines those — which drops this whole function
                        # and breaks the self-host link. The statement form is the spelling
                        # that survives being compiled by the compiler it is part of.
                        is_module_qualifier: mutable bool = false
                        match base:
                            Expr.Ident(base_name, base_line):
                                is_module_qualifier <- name_is_module(table, bound, base_name)
                                # `Inner::f()` written INSIDE `module Outer:`: the nested module
                                # is registered as `Outer::Inner`, so a bare head resolves
                                # against the enclosing module (stage0 scopes it the same way).
                                enclosing_qualifier: bool = not is_module_qualifier and table.current_module != "" and ancestor_names_module(table, base_name)
                                is_module_qualifier <- true if enclosing_qualifier
                                # The module exists; does it declare `name`? stage0 answers
                                # `undefined identifier "M.Unknown"`; stage1 said nothing and the
                                # backend later declined the whole function. A nested module is
                                # recorded verbatim as `Outer::Inner`, never as a member of
                                # `Outer`, so that spelling is excluded rather than reported.
                                # The span is the MODULE NAME token, not the `::` that follows it: stage0 reports
                                # `M::Unknown` at columns 12-13 of `    return M::Unknown` (the one-character
                                # `M`), and pointing at the separator instead read as 13-15.
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UndefinedModuleMember, name: base_name, line: base_line.line, pos: base_line, expected: name, actual: ""}) if is_module_qualifier and not enclosing_qualifier and not module_declares_member(table, base_name, name) and not two_part_names_module(table, base_name, name)
                            Expr.Scope(inner_base, mid_name, mid_line):
                                match inner_base:
                                    Expr.Ident(head_name, head_line):
                                        is_module_qualifier <- two_part_names_module(table, head_name, mid_name)
                                    _:
                                        pass
                            _:
                                pass
                        table <- walk_expression(base, table, bound, bound_mutability, bound_ids) if not is_module_qualifier
                    Expr.Index(object, index, line):
                        table <- walk_expression(object, table, bound, bound_mutability, bound_ids)
                        table <- check_non_generic_specialization(object, line.line, table, bound)
                        # `x.cast[T]` / `.ref[T]` / `.specialize[T]`: the bracket is a type
                        # argument, not a value — don't resolve it as a value reference.
                        table <- walk_expression(index, table, bound, bound_mutability, bound_ids) if not index_receiver_is_semantic_type_application(object, table, bound)
                    Expr.Binary(left, operator, right, line):
                        # An enum-member RANGE (`.IF..=LET`): when one endpoint is the
                        # leading-dot shorthand `.IF`, the enclosing enum is established,
                        # so a bare-ident endpoint (`LET`) is that enum's member — NOT a
                        # value reference. Skip resolving it (stage0 parity).
                        enum_range: bool = is_range_operator(operator) and (expr_is_shorthand_member(left) or expr_is_shorthand_member(right))
                        skip_left: bool = enum_range and expr_is_bare_ident(left)
                        skip_right: bool = enum_range and expr_is_bare_ident(right)
                        table <- walk_expression(left, table, bound, bound_mutability, bound_ids) if not skip_left
                        # The right operand of `is` (a refinement target/binding) and `as`
                        # (a type) is not a value reference, so it isn't resolved here.
                        table <- walk_expression(right, table, bound, bound_mutability, bound_ids) if operator != TokenKind.Is and operator != TokenKind.As and not skip_right
                        # The `is` / `as` target is a TYPE or PATTERN path; the module-path
                        # separator rule applies to it (check_type_path_separator).
                        table <- check_is_target_path(right, operator == TokenKind.As, table) if operator == TokenKind.Is or operator == TokenKind.As
                    Expr.Unary(operator, operand, line):
                        table <- walk_expression(operand, table, bound, bound_mutability, bound_ids)
                    Expr.Move(operand, line):
                        table <- walk_expression(operand, table, bound, bound_mutability, bound_ids)
                    # `new[r] EXPR` — the allocated expression is an ordinary value
                    # reference and must still resolve. The region name is a selector
                    # resolved against the region locals, not walked as a value here.
                    Expr.RegionNew(operand, region, line):
                        region_unresolved: bool = region != "" and not name_known(table, bound, region)
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UndefinedName, name: region, line: line.line, expected: "", actual: ""}) if region_unresolved
                        # stage0 spans the `new` keyword here (`2:12-15`), which is exactly
                        # this node's own pos -- the selector brackets are not part of it.
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.RegionNewOwnerUnresolved, name: "", pos: line, line: line.line, expected: "", actual: ""}) if region_unresolved
                        table <- walk_expression(operand, table, bound, bound_mutability, bound_ids)
                    Expr.Refinement(base, predicate, line):
                        # A `try EXPR else void` no-op recovery parses as Refinement(void,
                        # guarded): the `void` base is the discard-recovery keyword, not a
                        # value reference — do not resolve it (stage0 accepts `else void`).
                        base_is_void_recovery: bool = match base:
                            Expr.Ident(base_name, base_line): base_name == "void"
                            _: false
                        table <- walk_expression(base, table, bound, bound_mutability, bound_ids) if not base_is_void_recovery
                        table <- walk_expression(predicate, table, bound, bound_mutability, bound_ids)
                    # `get EXPR else return …` — walk the GUARDED expression; the recovery is a
                    # statement list, which this expression walker does not descend into.
                    Expr.GetElse(guarded, recovery, line):
                        table <- walk_expression(guarded, table, bound, bound_mutability, bound_ids)
                    Expr.Paren(inner, line):
                        table <- walk_expression(inner, table, bound, bound_mutability, bound_ids)
                    Expr.Array(elements, line):
                        for element in elements |table| -> table:
                            table <- walk_expression(element, table, bound, bound_mutability, bound_ids)
                    Expr.Tuple(elements, line):
                        for element in elements |table| -> table:
                            table <- walk_expression(element, table, bound, bound_mutability, bound_ids)
                    Expr.Slice(object, low, high, line):
                        table <- walk_expression(object, table, bound, bound_mutability, bound_ids)
                        table <- walk_expression(low, table, bound, bound_mutability, bound_ids)
                        table <- walk_expression(high, table, bound, bound_mutability, bound_ids)
                    Expr.IndexN(object, arguments, line):
                        table <- walk_expression(object, table, bound, bound_mutability, bound_ids)
                        table <- check_non_generic_specialization(object, line.line, table, bound)
                        # Multi-arg type application (`x.cast[K, V]` / `.specialize[A, B]`):
                        # the brackets hold type arguments, not values — skip resolving them.
                        for argument in arguments |table| -> table:
                            table <- walk_expression(argument, table, bound, bound_mutability, bound_ids) if not index_receiver_is_semantic_type_application(object, table, bound)
                    Expr.SetLit(elements, line):
                        for element in elements |table| -> table:
                            table <- walk_expression(element, table, bound, bound_mutability, bound_ids)
                    Expr.DictLit(entries, line):
                        for entry in entries |table| -> table:
                            table <- walk_expression(entry.key, table, bound, bound_mutability, bound_ids)
                            table <- walk_expression(entry.value, table, bound, bound_mutability, bound_ids)
                    Expr.Construct(type_expression, fields, line):
                        # The type is the constructor (resolves as a type/global); each
                        # field's value is a reference, but the field label is not.
                        # The BRACE form is a constructor beyond doubt, so an unresolvable
                        # Capitalised head reads `unknown struct "X"` here for the same
                        # reason it does on a call -- see the Call arm above.
                        unknown_struct_head: mutable bool = false
                        match type_expression:
                            Expr.Ident(construct_head_name, construct_head_pos):
                                if rew_name_is_capitalized(construct_head_name) and not name_known(table, bound, construct_head_name):
                                    unknown_struct_head <- true
                                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UnknownStruct, name: construct_head_name, pos: construct_head_pos, line: construct_head_pos.line, expected: "", actual: ""})
                            _:
                                pass
                        table <- walk_expression(type_expression, table, bound, bound_mutability, bound_ids) if not unknown_struct_head
                        for field in fields |table| -> table:
                            table <- walk_expression(field.value, table, bound, bound_mutability, bound_ids)
                        # Field checks on a construction whose type is a bare identifier
                        # naming a struct with a known closed field set. Positional
                        # (unlabeled) fields are skipped — they carry no label to check.
                        struct_name: sview = construct_type_name(type_expression)
                        table <- check_construct_field_labels(table, struct_name, fields, line.line) if struct_name != "" and struct_is_registered(table, struct_name)
                    Expr.RecordUpdate(base, fields, line):
                        # `base` is a value reference; each override value is a reference,
                        # the field label is a selector.
                        table <- walk_expression(base, table, bound, bound_mutability, bound_ids)
                        for field in fields |table| -> table:
                            table <- walk_expression(field.value, table, bound, bound_mutability, bound_ids)
                    Expr.If(condition, then_expr, else_expr, line):
                        # An `and` conjunct sees the bindings of the conjuncts before it.
                        table <- walk_condition_expression(condition, table, bound, bound_mutability, bound_ids)
                        # The TRUE value sees what the condition binds when it holds: an `is`
                        # under `and`, but not one under `or`/`not` (`q if p is q or flag`
                        # is undefined in stage0). The else value sees no binding.
                        then_scope: mutable darray[sview] = [bound_name for bound_name in bound]
                        then_mutability: mutable darray[bool] = [is_mutable for is_mutable in bound_mutability]
                        then_ids: mutable darray[BindingId] = [id for id in bound_ids]
                        gather_truthy_condition_bindings(condition, table, then_scope)
                        pad_bound_mutability(then_scope, then_mutability, then_ids, table.current_function_decl_id, table.next_binding_serial)
                        table <- walk_expression(then_expr, table, then_scope, then_mutability, then_ids)
                        table <- walk_expression(else_expr, table, bound, bound_mutability, bound_ids)
                    Expr.Comprehension(loop_variable, iterable, condition, body, line):
                        # The iterable is resolved in the OUTER scope (the loop variable
                        # is not visible there); condition/body see `loop_variable` via an extended copy.
                        table <- walk_expression(iterable, table, bound, bound_mutability, bound_ids)
                        comprehension_scope: mutable darray[sview] = [bound_name for bound_name in bound]
                        comprehension_mutability: mutable darray[bool] = [is_mutable for is_mutable in bound_mutability]
                        comprehension_ids: mutable darray[BindingId] = [id for id in bound_ids]
                        comprehension_scope.push(loop_variable)
                        comprehension_mutability.push(false)
                        comprehension_ids.push(fresh_binding_id(table.current_function_decl_id, table.next_binding_serial))
                        # Multi-binder queries (`each k, v in m`) record their extra binders as
                        # `__query_binder` markers line-paired to this comprehension's head; bring
                        # each one into the condition/body scope alongside the canonical binder.
                        query_binder_index: mutable usize = 0
                        while query_binder_index < table.query_binder_lines.count |comprehension_scope, comprehension_mutability, comprehension_ids, query_binder_index|:
                            if table.query_binder_lines[query_binder_index] == line.line:
                                comprehension_scope.push(table.query_binder_names[query_binder_index])
                                comprehension_mutability.push(false)
                                comprehension_ids.push(fresh_binding_id(table.current_function_decl_id, table.next_binding_serial))
                            query_binder_index <- query_binder_index + 1
                        # A BARE variant pattern (`where Expr.Int(value)`, no `item is` in
                        # front) is a PATTERN, not a predicate: `value` is a binder, so bind
                        # it FIRST instead of walking it as an expression, which would report
                        # it undefined here and again in the body. See is_bare_pattern_filter
                        # for why the shape test is deliberately narrow.
                        # A GUARDED pattern filter reaches here folded as
                        # `(subject is PATTERN) and GUARD` — the projection form has no separate
                        # guard slot. The guard must be walked AFTER the pattern's bindings are
                        # in scope, so the two halves are split apart here. Only split when the
                        # left half really is a pattern test; a plain `a and b` condition keeps
                        # its ordinary single-scope walk.
                        filter_test: mutable Expr = condition
                        filter_guard: mutable Expr = (Expr.Absent)
                        match condition:
                            Expr.Binary(query_left, query_operator, query_right, query_and_line):
                                if query_operator == TokenKind.And:
                                    query_left_is_pattern: mutable bool = is_bare_pattern_filter(query_left)
                                    match query_left:
                                        Expr.Binary(query_inner_left, query_inner_operator, query_inner_right, query_inner_line):
                                            query_left_is_pattern <- true if query_inner_operator == TokenKind.Is
                                        _:
                                            pass
                                    if query_left_is_pattern:
                                        filter_test <- query_left
                                        filter_guard <- query_right
                            _:
                                pass
                        if is_bare_pattern_filter(filter_test):
                            gather_is_target(filter_test, comprehension_scope)
                        else:
                            table <- walk_expression(filter_test, table, comprehension_scope, comprehension_mutability, comprehension_ids)
                            # A `where`/filter condition may refine the loop variable with an
                            # `is`-pattern (`where item is Expr.Int(value): value > 0`); its
                            # payload bindings are in scope for the comprehension body.
                            gather_expression_bindings(filter_test, comprehension_scope)
                        pad_bound_mutability(comprehension_scope, comprehension_mutability, comprehension_ids, table.current_function_decl_id, table.next_binding_serial)
                        table <- walk_expression(filter_guard, table, comprehension_scope, comprehension_mutability, comprehension_ids)
                        table <- walk_expression(body, table, comprehension_scope, comprehension_mutability, comprehension_ids)
                    Expr.Lambda(parameters, body, line):
                        # The lambda's params scope its body, which resolves in ORDER like a
                        # function body (see Expr.Block). The old walk hoisted every name the
                        # body introduces (gather_locals + walk_statements), so an `is` binding
                        # was visible anywhere in the lambda: `=> 2 if r is q or q… else 0` and
                        # `if r is q: pass` then `return q…` both read `q` when `r` was null, and
                        # stage0 rejects both (`undefined identifier`). The loop depth is left as
                        # it is: stage0 accepts a `break` in a lambda written inside a loop.
                        lambda_scope: mutable darray[sview] = [bound_name for bound_name in bound]
                        lambda_mutability: mutable darray[bool] = [is_mutable for is_mutable in bound_mutability]
                        lambda_ids: mutable darray[BindingId] = [id for id in bound_ids]
                        lambda_scope.extend([lambda_parameter for lambda_parameter in parameters])
                        pad_bound_mutability(lambda_scope, lambda_mutability, lambda_ids, table.current_function_decl_id, table.next_binding_serial)
                        table <- resolve_body(body, table, lambda_scope, lambda_mutability, lambda_ids)
                    Expr.Block(statements, value, captures, line):
                        # A block expression (docs/119 §2) scopes its own leading locals
                        # over both the statements and the tail value. Captured outer
                        # bindings (docs/119 §6) are licensed for mutation inside the block.
                        # E4/E10/E11 validation: check capture validity and E4 purity.
                        table <- check_value_block(expression, table, bound, bound_mutability)
                        block_scope: mutable darray[sview] = [bound_name for bound_name in bound]
                        block_mutability: mutable darray[bool] = [is_mutable for is_mutable in bound_mutability]
                        block_ids: mutable darray[BindingId] = [id for id in bound_ids]
                        # Add captures to the block's scope (valid to mutate).
                        for capture in captures |block_scope, block_mutability, block_ids|:
                            captured_index: int = bound_last_index(bound, capture)
                            block_scope.push(capture)
                            block_mutability.push(true)
                            block_ids.push(bound_ids[captured_index.usize()]) if captured_index >= 0
                            block_ids.push(fresh_binding_id(table.current_function_decl_id, table.next_binding_serial)) if captured_index < 0
                        # ORDERED, exactly like a function body: a block local is visible only
                        # after its declaration, and an `is` binding or a nested body's local does
                        # not outlive its statement. The old hoisting walk (gather_locals +
                        # walk_statements) accepted `y: i64 = z + 1` before `z`, an `if o is x:`
                        # binding used after the `if`, and a loop-body local used after the loop;
                        # stage0 rejects all three (`undefined identifier`), and here each one
                        # became a silent backend decline. resolve_body also records each local's
                        # real binding mode, so no mutability repair is needed.
                        table <- resolve_body(statements, table, block_scope, block_mutability, block_ids)
                        table <- walk_expression(value, table, block_scope, block_mutability, block_ids)
                    Expr.Match(scrutinee, arms, line):
                        # Match in expression position: each arm's pattern bindings (and
                        # the arm body's own locals, flattened) scope that arm only.
                        table <- walk_expression(scrutinee, table, bound, bound_mutability, bound_ids)
                        # Unreachable arms are a property of the ARM LIST, so they are
                        # checked once here rather than per arm. The statement form has
                        # always been checked (resolve_flow); without this the EXPRESSION
                        # form was silent, and stage0 reports both identically.
                        # `Expr.Catch` is a separate variant handled below and is
                        # deliberately NOT checked: a catch's arms are positional outcomes,
                        # not alternatives, so none of them dominates another.
                        table <- check_unreachable_arms(arms, table, line.line)
                        for arm in arms |table| -> table:
                            table <- check_pattern_variants(arm.pattern, table, line.line, arm_report_pos(arm, line.line))
                            arm_scope: mutable darray[sview] = [bound_name for bound_name in bound]
                            arm_mutability: mutable darray[bool] = [is_mutable for is_mutable in bound_mutability]
                            arm_ids: mutable darray[BindingId] = [id for id in bound_ids]
                            gather_arm_pattern(arm.pattern, arm_scope)
                            pad_bound_mutability(arm_scope, arm_mutability, arm_ids, table.current_function_decl_id, table.next_binding_serial)
                            # docs/122 §5.1: the arm guard resolves in the arm's scope.
                            table <- walk_expression(arm.guard, table, arm_scope, arm_mutability, arm_ids)
                            # An arm body is a block expression: resolved in ORDER, like an
                            # Expr.Block (see there) and like stage0.
                            table <- resolve_body(arm.body, table, arm_scope, arm_mutability, arm_ids)
                    # `catch EXPR:` — positionally identical to Match (guarded, arms, line);
                    # the guarded call is the scrutinee and the arms walk the same way.
                    Expr.Catch(scrutinee, arms, line):
                        # Each arm's pattern bindings scope that arm only, and its body
                        # resolves in ORDER, exactly as an Expr.Match arm's does. The old
                        # hoisting walk accepted `value: 2 if p is q or q… else 0` and an
                        # `if p is q: pass` followed by a use of `q`; stage0 rejects both.
                        # resolve_body records each local's real binding mode, so the
                        # mark_mutable_locals repair the hoisting walk needed is gone too.
                        table <- walk_expression(scrutinee, table, bound, bound_mutability, bound_ids)
                        for arm in arms |table| -> table:
                            table <- check_pattern_variants(arm.pattern, table, line.line, arm_report_pos(arm, line.line))
                            arm_scope: mutable darray[sview] = [bound_name for bound_name in bound]
                            arm_mutability: mutable darray[bool] = [is_mutable for is_mutable in bound_mutability]
                            arm_ids: mutable darray[BindingId] = [id for id in bound_ids]
                            gather_arm_pattern(arm.pattern, arm_scope)
                            pad_bound_mutability(arm_scope, arm_mutability, arm_ids, table.current_function_decl_id, table.next_binding_serial)
                            # docs/122 §5.1: the arm guard resolves in the arm's scope.
                            table <- walk_expression(arm.guard, table, arm_scope, arm_mutability, arm_ids)
                            table <- resolve_body(arm.body, table, arm_scope, arm_mutability, arm_ids)
                    # Literal/invalid leaves reference nothing. Listed explicitly (no
                    # wildcard) so a new Expr variant is a compile error here, not a silent
                    # resolution gap.
                    Expr.Invalid:
                        pass
                    Expr.Absent:
                        pass
                        pass
                    Expr.IntLit(value, _):
                        pass
                    Expr.FloatLit(text, _):
                        pass
                    Expr.StringLit(text, _):
                        pass
                    Expr.CharLit(text, _):
                        pass
                    Expr.BoolLit(value, _):
                        pass
                    Expr.ShorthandMember(parts, line):
                        # `.Variant` parts are enum selectors inferred from context, not
                        # value references — nothing to resolve.
                        pass
