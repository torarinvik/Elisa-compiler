# Stage1 semantic — the expression resolution walk (`extend Semantic: private:`).
# `walk_expression_inner` visits every expression form, resolving names against the
# bound set and running the per-form checks; the helpers above it recognize type
# applications and reduce callbacks. Continues resolve_expr.elisa; split out to keep
# each part file under 600 lines.
include "./index_type_application_policy.elisa"
include "./generic_extern_index_policy.elisa"

extend Semantic:
    private:
        def protocol_transition_callee(callee: Ast::Expr) -> bool:
            match callee:
                Expr.Index(Expr.Ident(name, _), Expr.Ident(_, _), _):
                    return name == "transition"
                _:
                    return false

        # Whether OWNER declares a type named NAME. This is used for every bare
        # `Name.Member` expression, so prefer the collision-safe name chain when it
        # is complete and retain the canonical scan during index recovery.
        def rew_has_type_declaration(name: sview, owner: sview, table: SymbolTable&) -> bool:
            can Abort.Panic:
                if table.symbol_name_index_valid and table.symbol_name_indexed_rows == table.symbols.count and table.symbol_name_next.count == table.symbols.count:
                    row: mutable u32 = symbol_chain_head(table, name)
                    while row != SYMBOL_INDEX_ROW_NONE |row, table, name, owner|:
                        symbol: Symbol& = &table.symbols[row.usize()]
                        return true if symbol.name == name and symbol.module_owner == owner and (symbol.kind == SymbolKind.Struct or symbol.kind == SymbolKind.Enum or symbol.kind == SymbolKind.Alias or symbol.kind == SymbolKind.Extern)
                        row <- table.symbol_name_next[row.usize()]
                    return false
                for symbol in table.symbols:
                    return true if symbol.name == name and symbol.module_owner == owner and (symbol.kind == SymbolKind.Struct or symbol.kind == SymbolKind.Enum or symbol.kind == SymbolKind.Alias or symbol.kind == SymbolKind.Extern)
                return false

        # Whether a bare type-like namespace is made ambiguous by two distinct wildcard
        # imports in the current module. This is used only for a bare `Name.Member` value
        # expression: qualified module paths and a unique imported owner keep their normal
        # resolution paths. Same-module declarations shadow wildcard imports.
        def rew_ambiguous_wildcard_type_name(name: sview, table: SymbolTable&) -> bool:
            can Abort.Panic:
                # Ambiguity needs two `__using` imports of the current module with distinct
                # owners. That is rare; with the wildcard index built it is one short lookup,
                # and type checks below walk only matching symbol names.
                if table.wildcard_imports_indexed:
                    return false if not (any ambiguous_module in table.wildcard_ambiguous_modules where ambiguous_module == table.current_module)
                return false if rew_has_type_declaration(name, table.current_module, table)
                import_rows: darray[Ast::EnumAnnotation] = table.wildcard_import_rows if table.wildcard_imports_indexed else table.protocol_annotations
                first: mutable usize = 0
                while first < import_rows.count |first, table, name, import_rows|:
                    first_import: Ast::EnumAnnotation = import_rows[first]
                    if first_import.name == "__using" and first_import.module == table.current_module:
                        first_owner: sview = first_import.owner
                        first_has_type: bool = rew_has_type_declaration(name, first_owner, table)
                        if first_has_type:
                            second: mutable usize = first + 1.usize()
                            while second < import_rows.count |first, second, table, name, first_owner, import_rows|:
                                second_import: Ast::EnumAnnotation = import_rows[second]
                                if second_import.name == "__using" and second_import.module == table.current_module and second_import.owner != first_owner:
                                    second_has_type: bool = rew_has_type_declaration(name, second_import.owner, table)
                                    return true if second_has_type
                                second <- second + 1.usize()
                    first <- first + 1.usize()
                return false

        # Resolve every identifier in a value expression, recursing into children. Field names
        # (`object.field`) are member selectors, not references, so only the object is walked.
        #
        # Depth-guarded wrapper: every recursive re-entry (Call/Field/Index/Binary/…
        # inside `walk_expression_inner` calls `walk_expression`) passes through here. A
        # pathologically deep AST must produce a hard diagnostic rather than overflowing
        # the stack or silently skipping the unvisited suffix.
        # Whether an `Index`/`IndexN` receiver is a type-application field operator — `.cast`,
        # `.ref`, `.specialize`, `.call_as`. For these the bracket holds a TYPE argument
        # (`x.cast[i64]`, `p.ref[T]`, `f.specialize[T]`), not a value to resolve; walking
        # it as a value reference falsely reports the type name as an undefined name.
        def index_receiver_is_type_application(object: Ast::Expr) -> bool:
            can Abort.Panic:
                match object:
                    Expr.Field(field_object, field_name, field_line):
                        return SemanticIndexTypeApplicationPolicy::field_name_is_type_argument(field_name)
                    _:
                        return false


        # Generic externs are retained as declaration annotations because their parameter
        # types cannot be resolved until the call supplies the concrete type. Keep this
        # semantic predicate in terms of that shared annotation contract rather than naming
        # individual compiler primitives (`va_arg`, etc.).
        def index_receiver_is_generic_extern(object: Ast::Expr, table: SymbolTable&) -> bool:
            can Abort.Panic:
                match object:
                    Expr.Ident(extern_name, extern_line):
                        return SemanticGenericExternIndexPolicy::contains(table.generic_extern_names, extern_name)
                    _:
                        pass
                return false


        # Resolver-only extension of the syntactic cast/ref/specialize classifier:
        # an unshadowed declared function/type followed by `[...]` is a generic
        # specialization, so its bracket contents are type/shape arguments rather
        # than value-position references. Local `xs[i]` remains an ordinary index.
        def index_receiver_is_semantic_type_application(object: Ast::Expr, table: SymbolTable&, bound: darray[sview @source]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                return true if index_receiver_is_type_application(object)
                match object:
                    Expr.Ident(base_name, base_line):
                        return false if any bound_name in bound where bound_name == base_name
                        return true if index_receiver_is_generic_extern(object, table)
                        # Bracket disambiguation runs for every index expression. Walk
                        # only declarations sharing this name instead of rescanning the
                        # full symbol table for each expression. Keep the canonical scan
                        # for partially built or invalid indexes.
                        if table.symbol_name_index_valid and table.symbol_name_indexed_rows == table.symbols.count and table.symbol_name_next.count == table.symbols.count:
                            row: mutable u32 = symbol_chain_head(table, base_name)
                            while row != SYMBOL_INDEX_ROW_NONE |row, table, base_name|:
                                symbol: Symbol& = &table.symbols[row.usize()]
                                return true if SemanticIndexTypeApplicationPolicy::candidate_declaration_matches(
                                    symbol.name == base_name,
                                    symbol.kind == SymbolKind.Func,
                                    symbol.kind == SymbolKind.Struct,
                                    symbol.kind == SymbolKind.Enum,
                                    symbol.kind == SymbolKind.Alias
                                )
                                row <- table.symbol_name_next[row.usize()]
                        else:
                            for symbol in table.symbols:
                                return true if SemanticIndexTypeApplicationPolicy::candidate_declaration_matches(
                                    symbol.name == base_name,
                                    symbol.kind == SymbolKind.Func,
                                    symbol.kind == SymbolKind.Struct,
                                    symbol.kind == SymbolKind.Enum,
                                    symbol.kind == SymbolKind.Alias
                                )
                    Expr.Scope(_, _, _):
                        names: mutable darray[sview] = []
                        dotted: mutable darray[bool] = []
                        return false if:
                            not type_path_collect(object, names, dotted) or names.count == 0
                            any was_dotted in dotted where was_dotted
                            any bound_name in bound where bound_name == names[0]
                        # A qualified nominal application contains type/state arguments,
                        # not value indexes. Canonical lookup rejects missing, ambiguous
                        # and alias-mismatched paths instead of guessing by tail spelling.
                        row: u32 = binding_nominal_declaration(object, table.current_module, table)
                        return row != SYMBOL_INDEX_ROW_NONE
                    _:
                        pass
                return false


        # Diagnose `f[T]` when `f` is a uniquely declared, unshadowed ordinary
        # function. Function generic parameters are already recorded by declaration
        # line, so specialization validity needs no additional parser metadata.
        def check_non_generic_specialization(object: Ast::Expr, line: u32, table: lmut SymbolTable, bound: darray[sview @source]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match object:
                    Expr.Ident(function_name, function_line):
                        return if:
                            any bound_name in bound where bound_name == function_name
                            direct_function_count(table, function_name) != 1
                        if find_symbol(table, function_name) is symbol:
                            return if symbol.kind != SymbolKind.Func
                            generic: mutable bool = any generic_line in table.generic_param_lines where generic_line == symbol.line
                            generic <- true if any region_line in table.region_generic_function_lines where region_line == symbol.line
                            generic <- true if index_receiver_is_generic_extern(object, table)
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.NonGenericSpecialization, name: function_name, line: line, expected: "", actual: ""}) if not generic
                    _:
                        pass


        def numeric_accumulator_name(name: sview) -> bool:
            return name in {"i8", "i16", "i32", "i64", "int", "isize", "u8", "u16", "u32", "u64", "usize", "uintptr", "f32", "f64"}


        # `reduce_sum(source, callback)` is a numeric reduction even when the source
        # itself is numeric; a named callback returning bool/void/aggregate is invalid.
        # Restrict this to a unique direct callback declaration so overloads and local
        # callable values remain conservative until function-value typing is complete.
        def check_reduce_sum_callback(callee: Ast::Expr, arguments: darray[Ast::Expr]&, line: u32, table: lmut SymbolTable, bound: darray[sview @source]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match callee:
                    Expr.Ident(callee_name, callee_line):
                        return if callee_name != "reduce_sum"
                    _:
                        return
                return if arguments.count < 2
                match arguments[1]:
                    Expr.Ident(callback_name, callback_line):
                        return if:
                            any bound_name in bound where bound_name == callback_name
                            direct_function_count(table, callback_name) != 1
                        if find_symbol(table, callback_name) is callback:
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ReduceSumNonNumericCallback, name: callback_name, line: line, expected: "", actual: callback.return_type}) if callback.kind == SymbolKind.Func and callback.return_type != "" and not numeric_accumulator_name(callback.return_type)
                    _:
                        pass


        # Whether an operator constructs a range (`a..b`, `a..<b`, `a..>b`, `a..=b`).
        def is_range_operator(operator: TokenKind) -> bool:
            can Abort.Panic:
                return when operator:
                    TokenKind.Range | TokenKind.RangeLt | TokenKind.RangeGt | TokenKind.RangeLe -> true
                    _ -> false

        def expr_is_shorthand_member(expression: Ast::Expr) -> bool:
            can Abort.Panic:
                return match expression:
                    Expr.ShorthandMember(parts, line): true
                    _: false

        def expr_is_bare_ident(expression: Ast::Expr) -> bool:
            can Abort.Panic:
                return match expression:
                    Expr.Ident(name, line): true
                    _: false

        # stage0 reads a Capitalised head as a TYPE name wherever a constructor can stand.
        # A byte range, not a locale rule: stage0 tests the first rune and every type name
        # the corpus spells is ASCII. Same predicate as emit_ast_ident_is_capitalized, which
        # the fmt/ast emitters already use for stage0's auto-region wrap rule.
        def rew_name_is_capitalized(name: sview) -> bool:
            can Abort.Panic:
                return false if name.len == 0
                head: u8 = name[0]
                return head >= 65 and head <= 90

        # Does any symbol named `name` carry `kind`? A chain walk over this name's own hash
        # bucket rather than a scan of every declaration (see name_known, which pays the
        # same attention): this runs once per Capitalised callee.
        def rew_name_has_kind(table: SymbolTable&, name: sview, kind: SymbolKind) -> bool:
            can Abort.Panic:
                row: mutable u32 = symbol_chain_head(table, name)
                while row != 4294967295 |row, table, name, kind|:
                    chain_symbol: Symbol& = &table.symbols[row.usize()]
                    return true if chain_symbol.name == name and chain_symbol.kind == kind
                    row <- table.symbol_name_next[row.usize()]
                return false

        def walk_expression[@table](expression: Ast::Expr, table: mutable SymbolTable& @table, bound: darray[sview @source]&, bound_mutability: darray[bool]&, bound_ids: darray[BindingId]&) -> void:
            can Memory.Allocate, Abort.Panic:
                lookup_contexts: mutable darray[IncrementalSemanticNameLookupContext[table]] @table = []
                lookup_session: mutable IncrementalSemanticSession[table]&? @table = null
                incremental_semantic_name_lookup_context_disabled_push(&lookup_contexts)
                table <- walk_expression_with_context(expression, table, bound, bound_mutability, bound_ids, lookup_session, &lookup_contexts[0]) can Global{Read,Write}


        def walk_expression_with_context[@table, @session, @session_borrow, @request, @request_borrow](expression: Ast::Expr, table: mutable SymbolTable& @table, bound: darray[sview @source]&, bound_mutability: darray[bool]&, bound_ids: darray[BindingId]&, lookup_session: mutable IncrementalSemanticSession[session]&? @session_borrow, lookup_context: mutable IncrementalSemanticNameLookupContext[request]& @request_borrow) -> void:
            can Memory.Allocate, Abort.Panic:
                table.walk_depth <- table.walk_depth + 1
                if table.walk_depth <= EXPRESSION_ANALYSIS_DEPTH_LIMIT:
                    table <- walk_expression_inner_with_context(expression, table, bound, bound_mutability, bound_ids, lookup_session, lookup_context) can Global{Read,Write}
                else:
                    already_reported: bool = any existing in table.diagnostics where existing.kind == DiagnosticKind.ExpressionAnalysisDepthExceeded
                    position: Ast::Pos = Ast::expr_pos(expression)
                    if not already_reported:
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ExpressionAnalysisDepthExceeded, name: "", pos: position, line: position.line, expected: "", actual: ""})
                table.walk_depth <- table.walk_depth - 1

include "./resolve_expr_walk_context.elisa"
