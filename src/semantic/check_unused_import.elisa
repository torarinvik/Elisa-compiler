# Check for unused imports: a module `import`ed but never referenced via qualified name (::),
# field access (.), or plain identifier use in the file. File-based includes (containing `.` or `/`)
# are skipped as they are module-composition includes that always contribute code.

extend Semantic:
    private:
        # Check if a module name is a file path. File-based includes (starting with '.' or '/')
        # are module-composition includes that always contribute code.
        def is_file_based_include(module_name: sview) -> bool:
            can Abort.Panic:
                # An empty name is not file-based
                false return if module_name == ""
                # Check if the first character is . or /
                first_char: u8 = module_name[0]
                true return if first_char == 46 or first_char == 47  # '.' or '/'
                return false
        # Walk an expression to find any identifier that matches an imported module name.
        # Checks for:
        # - Plain Ident with the module name
        # - Expr.Scope where the base contains the module name
        # - Expr.Field where the object chain contains the module name
        def walk_expression_for_import_use(expression: Ast::Expr, used_modules: mutable darray[sview]&, module_name: sview) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Ident(name, line):
                        used_modules <- used_modules.push(module_name) if name == module_name
                    Expr.Scope(base, name, line):
                        # base::name — check if base contains the module name
                        walk_expression_for_import_use(base, used_modules, module_name)
                    Expr.Field(object, field, line):
                        # object.field — check if object is the module
                        walk_expression_for_import_use(object, used_modules, module_name)
                    Expr.Call(callee, arguments, argument_names, line):
                        walk_expression_for_import_use(callee, used_modules, module_name)
                        for argument in arguments |used_modules| -> used_modules:
                            walk_expression_for_import_use(argument, used_modules, module_name)
                    Expr.Index(object, index, line):
                        walk_expression_for_import_use(object, used_modules, module_name)
                        walk_expression_for_import_use(index, used_modules, module_name)
                    Expr.Unary(operator, operand, line):
                        walk_expression_for_import_use(operand, used_modules, module_name)
                    Expr.Paren(inner, line):
                        walk_expression_for_import_use(inner, used_modules, module_name)
                    Expr.Array(elements, line):
                        for element in elements |used_modules| -> used_modules:
                            walk_expression_for_import_use(element, used_modules, module_name)
                    Expr.Tuple(elements, line):
                        for element in elements |used_modules| -> used_modules:
                            walk_expression_for_import_use(element, used_modules, module_name)
                    Expr.Slice(object, low, high, line):
                        walk_expression_for_import_use(object, used_modules, module_name)
                        walk_expression_for_import_use(low, used_modules, module_name)
                        walk_expression_for_import_use(high, used_modules, module_name)
                    Expr.IndexN(object, arguments, line):
                        walk_expression_for_import_use(object, used_modules, module_name)
                        for argument in arguments |used_modules| -> used_modules:
                            walk_expression_for_import_use(argument, used_modules, module_name)
                    Expr.Binary(left, operator, right, line):
                        walk_expression_for_import_use(left, used_modules, module_name)
                        # Don't walk right side of `is` or `as` (they're type positions)
                        walk_expression_for_import_use(right, used_modules, module_name) if operator != TokenKind.Is and operator != TokenKind.As
                    Expr.SetLit(elements, line):
                        for element in elements |used_modules| -> used_modules:
                            walk_expression_for_import_use(element, used_modules, module_name)
                    Expr.DictLit(entries, line):
                        for entry in entries |used_modules| -> used_modules:
                            walk_expression_for_import_use(entry.key, used_modules, module_name)
                            walk_expression_for_import_use(entry.value, used_modules, module_name)
                    Expr.Construct(type_expression, fields, line):
                        walk_expression_for_import_use(type_expression, used_modules, module_name)
                        for field in fields |used_modules| -> used_modules:
                            walk_expression_for_import_use(field.value, used_modules, module_name)
                    Expr.RecordUpdate(base, fields, line):
                        walk_expression_for_import_use(base, used_modules, module_name)
                        for field in fields |used_modules| -> used_modules:
                            walk_expression_for_import_use(field.value, used_modules, module_name)
                    Expr.If(condition, then_expr, else_expr, line):
                        walk_expression_for_import_use(condition, used_modules, module_name)
                        walk_expression_for_import_use(then_expr, used_modules, module_name)
                        walk_expression_for_import_use(else_expr, used_modules, module_name)
                    Expr.Comprehension(loop_variable, iterable, condition, body, line):
                        walk_expression_for_import_use(iterable, used_modules, module_name)
                        walk_expression_for_import_use(condition, used_modules, module_name)
                        walk_expression_for_import_use(body, used_modules, module_name)
                    Expr.Lambda(parameters, body, line):
                        walk_statements_for_import_use(body, used_modules, module_name)
                    Expr.Block(statements, value, captures, line):
                        walk_statements_for_import_use(statements, used_modules, module_name)
                        walk_expression_for_import_use(value, used_modules, module_name)
                    Expr.Match(scrutinee, arms, line):
                        walk_expression_for_import_use(scrutinee, used_modules, module_name)
                        for arm in arms |used_modules| -> used_modules:
                            walk_statements_for_import_use(arm.body, used_modules, module_name)
                    _:
                        pass


        # Walk statements to find import references in expressions.
        def walk_statements_for_import_use(statements: darray[Ast::Stmt], used_modules: mutable darray[sview]&, module_name: sview) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |used_modules|:
                    match statement:
                        Stmt.Expr(expression, line):
                            walk_expression_for_import_use(expression, used_modules, module_name)
                        Stmt.VarDecl(name, type_expression, value, line):
                            walk_expression_for_import_use(value, used_modules, module_name)
                        Stmt.Assign(target, operator, value, line):
                            walk_expression_for_import_use(target, used_modules, module_name)
                            walk_expression_for_import_use(value, used_modules, module_name)
                        Stmt.If(condition, then_body, else_body, line):
                            walk_expression_for_import_use(condition, used_modules, module_name)
                            walk_statements_for_import_use(then_body, used_modules, module_name)
                            walk_statements_for_import_use(else_body, used_modules, module_name)
                        Stmt.While(condition, body, line):
                            walk_expression_for_import_use(condition, used_modules, module_name)
                            walk_statements_for_import_use(body, used_modules, module_name)
                        Stmt.For(bind, variables, iterable, body, line):
                            walk_expression_for_import_use(iterable, used_modules, module_name)
                            walk_statements_for_import_use(body, used_modules, module_name)
                        Stmt.Return(value, line):
                            walk_expression_for_import_use(return_value, used_modules, module_name) if value is return_value
                        Stmt.Block(kind, clause, binding, body, line):
                            walk_statements_for_import_use(body, used_modules, module_name)
                        Stmt.Match(scrutinee, arms, line):
                            walk_expression_for_import_use(scrutinee, used_modules, module_name)
                            for arm in arms |used_modules|:
                                walk_statements_for_import_use(arm.body, used_modules, module_name)
                        Stmt.Contract(kind, expression, line):
                            walk_expression_for_import_use(expression, used_modules, module_name)
                        _:
                            pass


        # Walk through declarations, tracking which imports are used and which are unused.
        def check_unused_imports_impl(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                # Collect all imports in this scope
                imports_here: mutable darray[Ast::Decl] = []
                while decl_index < declarations.count |decl_index: usize = 0|:
                    current_decl: Ast::Decl = declarations[decl_index]
                    match current_decl:
                        Decl.Import(module, line):
                            imports_here <- imports_here.push(current_decl)
                        _:
                            pass
                    decl_index <- decl_index + 1

                # For each import, walk all declarations to see if it's used
                while import_index < imports_here.count |import_index: usize = 0|:
                    import_decl: Ast::Decl = imports_here[import_index]
                    if import_decl is Decl.Import(module_name, import_line):
                        # Skip file-based includes (starting with . or /) — these are always used
                        # as they contribute code to the module during composition
                        if not is_file_based_include(module_name):
                            # Collect usage of this module throughout the file
                            used_modules: mutable darray[sview] = []

                            # Walk all declarations
                            while decl_index < declarations.count |decl_index: usize = 0|:
                                current_decl: Ast::Decl = declarations[decl_index]
                                match current_decl:
                                    Decl.Func(name, params, return_type, body, effects, decorators, line):
                                        walk_statements_for_import_use(body, used_modules, module_name)
                                    Decl.Module(module_name_nested, body, line):
                                        table <- check_unused_imports_impl(body, table)
                                    Decl.Scoped(body, line):
                                        table <- check_unused_imports_impl(body, table)
                                    _:
                                        pass
                                decl_index <- decl_index + 1

                            # If module was never used, report it
                            is_used: mutable bool = false
                            while use_index < used_modules.count |use_index: usize = 0|:
                                is_used <- true if used_modules[use_index] == module_name
                                use_index <- use_index + 1

                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UnusedImport, name: module_name, line: import_line, expected: "", actual: ""}) if not is_used

                    import_index <- import_index + 1


    public:
        # Entry point: scan declarations for unused imports
        def check_unused_import(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- check_unused_imports_impl(declarations, table)
