# A branchy boolean postcondition of the shape `ensure (not result) or CONJ`, where CONJ is a
# conjunction of `X != null` atoms, is VIOLATED on a `return true` path that does not ESTABLISH
# every `X != null` — stage0's prover evaluates each return path with its guard facts and reports
# "ensure postcondition ... could not be proven". check_ensure_strict deliberately skips branchy
# functions (its reflexive verdict is only sound on a single straight-line return), so this
# targeted pass covers the guarded-boolean case.
#
# SOUND (never a false positive): a `X != null` atom is treated as ESTABLISHED only when it is
# provably non-null on the path — a non-optional parameter, a `requires X != null`, or a preceding
# sibling guard `if X == null: return …` (whose fall-through proves X != null). The body must be a
# FLAT sequence of such guards plus contracts and one truthy `return true`; ANY other statement
# shape (nested control flow, computed return value, else-branch) makes the pass BAIL without
# flagging. So a flag fires only when a required atom is established by nothing — a genuine hole.
extend Semantic:
    private:
        def bne_is_null_ident(expression: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Paren(inner, paren_line):
                        return bne_is_null_ident(inner)
                    Expr.Ident(name, ident_line):
                        return name == "null"
                    _:
                        return false

        # The name X of a `X != null` atom (either operand order), else "".
        def bne_nonnull_name(expression: Ast::Expr) -> sview:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Paren(inner, paren_line):
                        return bne_nonnull_name(inner)
                    Expr.Binary(left, operator, right, binary_line):
                        "" return if operator != TokenKind.BangEq
                        ident_name_of(left) return if bne_is_null_ident(right)
                        ident_name_of(right) return if bne_is_null_ident(left)
                        return ""
                    _:
                        return ""

        # The name X of a `X == null` guard condition, else "".
        def bne_null_guard_name(expression: Ast::Expr) -> sview:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Paren(inner, paren_line):
                        return bne_null_guard_name(inner)
                    Expr.Binary(left, operator, right, binary_line):
                        "" return if operator != TokenKind.EqEq
                        ident_name_of(left) return if bne_is_null_ident(right)
                        ident_name_of(right) return if bne_is_null_ident(left)
                        return ""
                    _:
                        return ""

        # Collect a conjunction of `X != null` atoms into `out`. Returns true iff the whole
        # expression is exactly such a conjunction (any other content fails the match).
        def bne_collect_conj_nonnull(expression: Ast::Expr, out: mutable darray[sview]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Paren(inner, paren_line):
                        return bne_collect_conj_nonnull(inner, out)
                    Expr.Binary(left, operator, right, binary_line):
                        if operator == TokenKind.And:
                            left_ok: bool = bne_collect_conj_nonnull(left, out)
                            false return if not left_ok
                            return bne_collect_conj_nonnull(right, out)
                        atom_name: sview = bne_nonnull_name(expression)
                        if atom_name != "":
                            out.push(atom_name)
                            return true
                        return false
                    _:
                        return false

        def bne_is_not_result(expression: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Paren(inner, paren_line):
                        return bne_is_not_result(inner)
                    Expr.Unary(operator, operand, unary_line):
                        return operator == TokenKind.Not and ident_name_of(operand) == "result"
                    _:
                        return false

        # An ensure `(not result) or CONJ` → collect CONJ's non-null names into `out`; true if matched.
        def bne_ensure_required_nonnull(expression: Ast::Expr, out: mutable darray[sview]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Paren(inner, paren_line):
                        return bne_ensure_required_nonnull(inner, out)
                    Expr.Binary(left, operator, right, binary_line):
                        false return if operator != TokenKind.Or
                        bne_collect_conj_nonnull(right, out) return if bne_is_not_result(left)
                        bne_collect_conj_nonnull(left, out) return if bne_is_not_result(right)
                        return false
                    _:
                        return false

        def bne_is_true_literal(expression: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Paren(inner, paren_line):
                        return bne_is_true_literal(inner)
                    Expr.BoolLit(value):
                        return value
                    Expr.Ident(name, ident_line):
                        return name == "true"
                    _:
                        return false

        # Every statement in a guard's then-body is a return/break/continue (it exits).
        def bne_body_all_exit(statements: darray[Ast::Stmt]&) -> bool:
            can Abort.Panic:
                false return if statements.count == 0
                for statement in statements:
                    match statement:
                        Stmt.Return(value, line):
                            pass
                        Stmt.Break(label, line):
                            pass
                        Stmt.Continue(label, line):
                            pass
                        _:
                            return false
                return true

        # Non-optional parameter names (a bare reference `N&` is never null; `N&?` may be).
        def bne_param_nonopt_names(parameters: darray[Ast::ParamDecl]) -> darray[sview]:
            can Memory.Allocate, Abort.Panic:
                out: mutable darray[sview] = []
                for parameter in parameters |out|:
                    out.push(parameter.name) if not type_marker_present_here(parameter.type_expression, TokenKind.Question)
                return out

        # Names X of each `requires X != null` clause.
        def bne_requires_nonnull_names(body: darray[Ast::Stmt]) -> darray[sview]:
            can Memory.Allocate, Abort.Panic:
                out: mutable darray[sview] = []
                for statement in body |out|:
                    match statement:
                        Stmt.Contract(kind, expression, contract_line):
                            if kind == "requires":
                                required_name: sview = bne_nonnull_name(expression)
                                out.push(required_name) if required_name != ""
                        _:
                            pass
                return out

        def bne_check_function(parameters: darray[Ast::ParamDecl], body: darray[Ast::Stmt], function_name: sview, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                # 1. Find a matching ensure `(not result) or CONJ_of_nonnull`.
                required: mutable darray[sview] = []
                matched: mutable bool = false
                for statement in body |required, matched|:
                    match statement:
                        Stmt.Contract(kind, expression, contract_line):
                            if kind == "ensure" and not matched:
                                candidate: mutable darray[sview] = []
                                if bne_ensure_required_nonnull(expression, candidate):
                                    required.extend(candidate)
                                    matched <- true
                        _:
                            pass
                return if not matched or required.count == 0
                # 2. Seed ESTABLISHED with non-optional params and `requires X != null` facts.
                #    Each source is built by its OWN single-loop helper and merged via `extend`;
                #    two sequential mutating loops over one darray clobber each other's writeback.
                established: mutable darray[sview] = []
                established.extend(bne_param_nonopt_names(parameters))
                established.extend(bne_requires_nonnull_names(body))
                # 3. Walk the FLAT body: guards extend `established`; a truthy `return true` whose
                #    required atoms are not all established is a provable violation. Any other
                #    statement shape bails (sound — no flag).
                for statement in body |table, established| -> table:
                    match statement:
                        Stmt.Contract(kind, expression, contract_line):
                            pass
                        Stmt.If(condition, then_body, else_body, if_line):
                            guard_name: sview = bne_null_guard_name(condition)
                            if guard_name != "" and else_body.count == 0 and bne_body_all_exit(then_body):
                                established.push(guard_name)
                            else:
                                return
                        Stmt.Return(value, return_line):
                            if value is returned:
                                if bne_is_true_literal(returned):
                                    missing: mutable bool = false
                                    for atom in required |missing, established|:
                                        missing <- true if not (any established_name in established where established_name == atom)
                                    if missing:
                                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.EnsureNotProven, name: function_name, line: return_line, expected: "", actual: ""})
                                        return
                                else:
                                    return
                        _:
                            return

        def bne_check_declarations(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            table <- bne_check_function(parameters, body, function_name, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- bne_check_declarations(module_body, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- bne_check_declarations(scoped_body, table)
                        _:
                            pass

    public:
        def check_branchy_nonnull_ensure(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- bne_check_declarations(declarations, table)
