# Check a uniquely declared function in the caller's own module when the flat
# name index also contains declarations from other modules. Parameter rows are
# matched by declaration identity so unrelated signatures cannot be mixed.
extend Semantic:
    private:
        def check_scoped_firm_call(name: sview @source, arguments: darray[Ast::Expr] @source, argument_names: darray[sview @source], call_pos: Ast::Pos, table: lmut SymbolTable, names: darray[sview @source]&, types: darray[sview @source]&) -> void:
            can Memory.Allocate, Abort.Panic:
                caller: u32 = table.current_function_decl_id.value
                return if caller >= table.symbols.count
                for local_name in names:
                    return if local_name == name
                owner: sview = table.symbols[caller.usize()].module_owner
                return if owner == ""
                selected: mutable u32 = 4294967295
                cur: mutable u32 = symbol_chain_head(table, name)
                while cur != 4294967295:
                    symbol: Symbol = table.symbols[cur.usize()]
                    if symbol.name == name and symbol.kind == SymbolKind.Func and symbol.module_owner == owner:
                        return if selected != 4294967295
                        selected <- symbol.id.value
                    cur <- table.symbol_name_next[cur.usize()]
                return if selected == 4294967295
                position: mutable usize = 0
                row: mutable u32 = function_param_chain_head(table, name)
                while row != 4294967295 and position < arguments.count:
                    index: usize = row.usize()
                    if table.function_param_owner[index] == name and index < table.function_param_declaration_id.count and table.function_param_declaration_id[index].value == selected:
                        if argument_names[position] == "" and literal_kind_of(arguments[position]) == "":
                            expected: sview = table.function_param_type[index]
                            actual: InferType = infer_expression_type(arguments[position], names, types, table)
                            family: sview = family_of_kind(actual)
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.FirmArgTypeMismatch, name: name, pos: Ast::expr_pos(arguments[position]), line: call_pos.line, expected: expected, actual: stage0_value_spelling(actual), expected_count: (position + 1).u32()}) if expected != "" and family != "" and firm_never_fits(family, expected)
                        position <- position + 1
                    row <- table.function_param_name_next[index]
