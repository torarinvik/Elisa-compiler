# Stage1 semantic — variable initializer checking (`extend Semantic: private:`).
# `check_variable_initializers` walks a body threading the local type table, checking
# each declaration's value against its annotation and each return against the declared
# return type. Continues resolve_types_operators.elisa; split out to keep each part file
# under 600 lines.

extend Semantic:
    private:
        def check_variable_initializers(statements: darray[Ast::Stmt], return_type_name: sview, return_type_id: u32, names: mutable darray[sview]&, types: mutable darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table, names, types| -> table:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            type_name: sview = bare_type_name(type_expression)
                            note_local_type(names, types, name, type_name)
                            # Structural channel (Phase C): the annotation's interned
                            # TypeId, so idents of container/optional/ref type infer
                            # structurally (bare_type_name sees only bare names).
                            note_local_type_id(name, type_expression, table)
                            # Use the declaration's canonical row directly for the
                            # initializer. Block-valued RHS traversal can temporarily
                            # alter the local channel; contextual checking must not lose
                            # the VarDecl's own expected type at that boundary.
                            declared_type_id: u32 = annotation_type_id(type_expression, table)
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.TypeMismatch, name: name, line: line, expected: "non-null reference", actual: "null"}) if interned_kind(declared_type_id, table) == SemTypeKind.Ref and expression_is_null(value)
                            # `x: i64 = null` — a null initializer for a declared type that
                            # cannot hold null. The ref case above owns `T&`; ONLY an optional
                            # can actually take null, so every other FIRM kind is an error.
                            # MEASURED: i64, cstr, bool and f64 all report
                            # `variable "x" expects <T>, got null`, while `x: i64? = null` is
                            # accepted. Unknown/Void/Optional stay silent, so an unresolved
                            # annotation cannot produce a false positive.
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.TypeMismatch, name: name, line: line, expected: type_name, actual: "null"}) if expression_is_null(value) and kind_cannot_hold_null(interned_kind(declared_type_id, table)) and type_name != ""
                            table <- check_nested_array_literal(value, declared_type_id, 0, names, types, table)
                            table <- check_ternary_condition(value, names, types, table)
                            table <- check_operator_operands(value, names, types, table)
                            table <- check_value_match_exhaustive(value, names, types, table)
                            table <- check_value_against(value, type_name, name, line, names, types, table) if type_name != ""
                        Stmt.Assign(target, operator, value, line):
                            table <- check_ternary_condition(value, names, types, table)
                            table <- check_operator_operands(value, names, types, table)
                            table <- check_value_match_exhaustive(value, names, types, table)
                            if target is Expr.Ident(target_name, target_line) and operator == TokenKind.Assign:
                                # `x = v` defines a fresh, unannotated local. (The
                                # structural pair keeps both channels index-aligned so
                                # one scope mark closes both.)
                                note_local_type(names, types, target_name, "")
                                note_local_type_id_direct(target_name, 0, table)
                            elif target is Expr.Ident(target_name, target_line) and operator == TokenKind.LArrow:
                                target_type: sview = local_type_of(names, types, target_name)
                                if target_type != "":
                                    table <- check_value_against(value, target_type, target_name, line, names, types, table)
                                else:
                                    # Structural target (Phase C): a scalar can never be
                                    # assigned to a CONTAINER-typed local (`xs <- 5` —
                                    # oracle: "cannot assign int to darray[i64]"). An
                                    # OPTIONAL target legally accepts its base value and
                                    # never flags here. Both literal and firm-inferred
                                    # scalar values are walls; unknowns stay silent.
                                    target_structural: u32 = local_type_id_of(target_name, table)
                                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.TypeMismatch, name: target_name, line: line, expected: "non-null reference", actual: "null"}) if interned_kind(target_structural, table) == SemTypeKind.Ref and expression_is_null(value)
                                    source_structural: u32 = structural_type_id_of(value, names, types, table)
                                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.TypeMismatch, name: target_name, line: line, expected: interned_name(target_structural, table), actual: interned_name(source_structural, table)}) if interned_kind(target_structural, table) == SemTypeKind.Container and interned_kind(source_structural, table) == SemTypeKind.Container and not type_ids_compatible(target_structural, source_structural, table)
                                    if interned_kind(target_structural, table) == SemTypeKind.Container:
                                        assigned_kind: mutable sview = literal_kind_of(value)
                                        assigned_kind <- infer_family(value, names, types, table) if assigned_kind == ""
                                        is_scalar_value: bool = assigned_kind == "int" or assigned_kind == "float" or assigned_kind == "bool" or assigned_kind == "char" or assigned_kind == "string"
                                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AssignScalarToContainer, name: target_name, line: line, expected: interned_name(target_structural, table), actual: assigned_kind, detail: type_name_of_row(interned_elem(target_structural, 0, table), table)}) if is_scalar_value
                            elif target is Expr.Index(indexed_target, index_key, indexed_target_line) and operator == TokenKind.LArrow:
                                # `c[k] <- v` (Phase C): dict targets wall both the KEY
                                # (against elem 0) and the VALUE (against elem 1);
                                # darray/array targets wall the value (elem 0). Unknown
                                # containers/keys/values stay silent.
                                indexed_id: u32 = structural_type_id_of(indexed_target, names, types, table)
                                indexed_head: sview = interned_name(indexed_id, table) if interned_kind(indexed_id, table) == SemTypeKind.Container else ""
                                if indexed_head == "dict":
                                    key_spelling: sview = type_name_of_row(interned_elem(indexed_id, 0, table), table)
                                    if key_spelling != "":
                                        # The key TYPE itself may have no value equality, so
                                        # the runtime hash table cannot be built at all —
                                        # independent of whether this particular key VALUE
                                        # fits (the wall just below).
                                        assign_value_spelling: sview = type_name_of_row(interned_elem(indexed_id, 1, table), table)
                                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.RuntimeDictKeyUnsupported, name: "", line: line, expected: key_spelling, actual: assign_value_spelling}) if dict_key_type_unsupported(key_spelling)
                                        key_literal: sview = literal_kind_of(index_key)
                                        key_family: sview = infer_family(index_key, names, types, table) if key_literal == "" else ""
                                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.DictIndexKeyTypeMismatch, name: "", line: line, expected: key_spelling, actual: stage0_literal_spelling(key_literal)}) if key_literal != "" and literal_never_fits(key_literal, key_spelling)
                                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.DictIndexKeyTypeMismatch, name: "", line: line, expected: key_spelling, actual: key_family}) if key_family != "" and firm_never_fits(key_family, key_spelling)
                                    # EVERY dict index-assign is rejected by stage0, whatever
                                    # the value type: `d[k]` yields an OPTIONAL REFERENCE
                                    # (`mutable i64&?`) and a bare value cannot be assigned
                                    # to one. MEASURED with the std prepended, via -emit obj:
                                    #   d[k] <- 5     dict[i64, i64]    "cannot assign int to mutable i64&?"
                                    #   d[k] <- v     v: i64            "cannot assign i64 to mutable i64&?"
                                    #   d[k] <- 5     dict[cstr, i64]   "cannot assign int to mutable i64&?"
                                    #   d[k] <- "x"   dict[i64, sview]  "cannot assign static u8& to mutable sview&?"
                                    #   xs[0] <- 5    darray            ACCEPTED — this is dict-specific
                                    #
                                    # So it REPLACES the value-fits check that used to run
                                    # here: stage0 errors on this statement unconditionally,
                                    # and reporting a "value expects T" mismatch as well
                                    # would be a second diagnostic stage0 never emits.
                                    dict_value_spelling: sview = type_name_of_row(interned_elem(indexed_id, 1, table), table)
                                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.DictIndexAssignToOptionalRef, name: "", line: line, expected: stage0_operand_spelling(value, infer_expression_type(value, names, types, table)), actual: dict_value_spelling}) if dict_value_spelling != ""
                                elif indexed_head == "darray" or indexed_head == "array":
                                    element_spelling: sview = type_name_of_row(interned_elem(indexed_id, 0, table), table)
                                    table <- check_value_against(value, element_spelling, "element", line, names, types, table) if element_spelling != ""
                            elif target is Expr.Field(field_object, target_field, target_field_line) and operator == TokenKind.LArrow:
                                # `p.x <- v`: the assigned value must fit field x's declared
                                # type (a Field target is always a mutation, never a define).
                                object_type: InferType = infer_expression_type(field_object, names, types, table)
                                field_type: sview = field_type_of(table, object_type.name, target_field) if object_type.kind == SemTypeKind.Named else ""
                                table <- check_value_against(value, field_type, target_field, line, names, types, table) if field_type != ""
                        Stmt.Return(value, line):
                            if value is return_expression:
                                table <- check_ternary_condition(return_expression, names, types, table)
                                table <- check_operator_operands(return_expression, names, types, table)
                                table <- check_value_match_exhaustive(return_expression, names, types, table)
                            table <- check_value_against(returned_value, return_type_name, "return", line, names, types, table) if return_type_name != "" and value is returned_value
                            # Structural return wall (Phase C): a scalar returned from a
                            # `-> darray[T]` function (oracle: "return type expects
                            # darray[i64], got int"). Optional return types accept their
                            # base value and never flag.
                            if return_type_name == "" and interned_kind(return_type_id, table) == SemTypeKind.Container and value is structurally_returned:
                                returned_kind: mutable sview = literal_kind_of(structurally_returned)
                                returned_kind <- infer_family(structurally_returned, names, types, table) if returned_kind == ""
                                returned_scalar: bool = returned_kind == "int" or returned_kind == "float" or returned_kind == "bool" or returned_kind == "char" or returned_kind == "string"
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.TypeMismatch, name: "return", line: line, expected: interned_name(return_type_id, table), actual: returned_kind, detail: type_name_of_row(interned_elem(return_type_id, 0, table), table) if interned_kind(return_type_id, table) == SemTypeKind.Container else sview("", 0, 0)}) if returned_scalar
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.TypeMismatch, name: "return", line: line, expected: "non-null reference", actual: "null"}) if interned_kind(return_type_id, table) == SemTypeKind.Ref and value is null_return and expression_is_null(null_return)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- check_operator_operands(condition, names, types, table)
                            condition_family: sview = infer_family(condition, names, types, table)
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.NonBoolCondition, name: "if", line: line, expected: "bool", actual: infer_spelling(condition, names, types, table), detail: container_elem_spelling_of(condition, names, types, table)}) if condition_family != "" and condition_family != "bool"
                            then_scope_mark: usize = names.count
                            table <- check_variable_initializers(then_body, return_type_name, return_type_id, names, types, table)
                            table <- close_type_scope(then_scope_mark, names, types, table)
                            table <- check_variable_initializers(else_body, return_type_name, return_type_id, names, types, table)
                            table <- close_type_scope(then_scope_mark, names, types, table)
                        Stmt.While(condition, body, line):
                            table <- check_operator_operands(condition, names, types, table)
                            condition_family: sview = infer_family(condition, names, types, table)
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.NonBoolCondition, name: "while", line: line, expected: "bool", actual: infer_spelling(condition, names, types, table), detail: container_elem_spelling_of(condition, names, types, table)}) if condition_family != "" and condition_family != "bool"
                            while_scope_mark: usize = names.count
                            table <- check_variable_initializers(body, return_type_name, return_type_id, names, types, table)
                            table <- close_type_scope(while_scope_mark, names, types, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            for_scope_mark: usize = names.count
                            table <- check_operator_operands(iterable, names, types, table)
                            table <- check_loop_iterable(iterable, names, types, table, line)
                            # `for x, y in xs` over a NON-dict container with a known
                            # scalar element cannot destructure (stage0: "iterable for
                            # tuple pattern requires a tuple item, got i64").
                            if variables.count >= 2:
                                tuple_iterable_id: u32 = structural_type_id_of(iterable, names, types, table)
                                tuple_iterable_head: sview = interned_name(tuple_iterable_id, table) if interned_kind(tuple_iterable_id, table) == SemTypeKind.Container else ""
                                tuple_elem_id: u32 = interned_elem(tuple_iterable_id, 0, table) if tuple_iterable_head == "darray" or tuple_iterable_head == "array" or tuple_iterable_head == "set" else 0
                                tuple_elem_scalar: bool = interned_kind(tuple_elem_id, table) in {SemTypeKind.Int, SemTypeKind.Float, SemTypeKind.Bool, SemTypeKind.Char, SemTypeKind.String}
                                tuple_elem_spelling: sview = type_name_of_row(tuple_elem_id, table) if tuple_elem_scalar else ""
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.TupleIterableNotTuple, name: "", line: line, expected: "", actual: tuple_elem_spelling}) if tuple_elem_spelling != ""
                            # Loop-variable ELEMENT typing (Phase C): iterating a
                            # container-typed local binds its element type — `for x in
                            # xs:` (darray/set, one variable) types x as the element,
                            # `for k, v in d:` (dict, two variables) types the key and
                            # value. Any other shape stays untyped ("").
                            iterable_id: mutable u32 = 0
                            if iterable is Expr.Ident(iterable_name, iterable_line):
                                iterable_id <- local_type_id_of(iterable_name, table)
                            elif iterable is Expr.Call(iterable_callee, iterable_args, iterable_arg_names, iterable_call_line):
                                # `for x in g():` / `for x in M::g():` — the returned
                                # container's elements.
                                if iterable_callee is Expr.Ident(iterable_fn, iterable_fn_line):
                                    iterable_id <- function_return_type_id(table, iterable_fn)
                                elif iterable_callee is Expr.Scope(iterable_scope, iterable_scoped_fn, iterable_scope_line):
                                    iterable_id <- function_return_type_id(table, iterable_scoped_fn)
                            elif iterable is Expr.Field(iterable_object, iterable_field, iterable_field_line):
                                # `for x in p.items:` — a registered struct field's container.
                                field_object_type: InferType = infer_expression_type(iterable_object, names, types, table)
                                if field_object_type.kind == SemTypeKind.Named:
                                    iterable_id <- field_type_id_of(table, field_object_type.name, iterable_field)
                            iterable_head: sview = interned_name(iterable_id, table) if interned_kind(iterable_id, table) == SemTypeKind.Container else ""
                            sequence_element: u32 = interned_elem(iterable_id, 0, table) if (iterable_head == "darray" or iterable_head == "array" or iterable_head == "set") and variables.count == 1 else 0
                            dict_key: u32 = interned_elem(iterable_id, 0, table) if iterable_head == "dict" and variables.count == 2 else 0
                            dict_value: u32 = interned_elem(iterable_id, 1, table) if iterable_head == "dict" and variables.count == 2 else 0
                            while variable_index < variables.count |variable_index: usize = 0, names, types, table|:
                                variable_element: u32 = when variable_index:
                                    0 -> sequence_element if sequence_element != 0 else dict_key
                                    1 -> dict_value
                                    _ -> 0
                                note_local_type(names, types, variables[variable_index], type_name_of_row(variable_element, table))
                                note_local_type_id_direct(variables[variable_index], variable_element, table)
                                variable_index <- variable_index + 1
                            table <- check_variable_initializers(body, return_type_name, return_type_id, names, types, table)
                            table <- close_type_scope(for_scope_mark, names, types, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            block_scope_mark: usize = names.count
                            note_local_type(names, types, binding, "") if binding != ""
                            note_local_type_id_direct(binding, 0, table) if binding != ""
                            table <- check_variable_initializers(body, return_type_name, return_type_id, names, types, table)
                            table <- close_type_scope(block_scope_mark, names, types, table)
                        Stmt.Match(scrutinee, arms, line):
                            table <- check_match_exhaustive(scrutinee, arms, line, names, types, table)
                            table <- check_scalar_match_arm_types(scrutinee, arms, line, names, types, table)
                            table <- check_sequence_match_arm_types(scrutinee, arms, line, names, types, table)
                            for arm in arms |table, names, types| -> table:
                                arm_scope_mark: usize = names.count
                                table <- check_variable_initializers(arm.body, return_type_name, return_type_id, names, types, table)
                                table <- close_type_scope(arm_scope_mark, names, types, table)
                        Stmt.Expr(expression, line):
                            # Bare expression statements (method calls like `xs.push(v)`)
                            # get the same operator/argument walk as value positions.
                            table <- check_operator_operands(expression, names, types, table)
                        Stmt.Contract(kind, expression, line):
                            pass
                        Stmt.Invalid:
                            pass
                        Stmt.Break(label, line):
                            pass
                        Stmt.Continue(label, line):
                            pass
