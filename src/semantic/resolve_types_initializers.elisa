# Stage1 semantic — variable initializer checking (`extend Semantic: private:`).
# `check_variable_initializers` walks a body threading the local type table, checking
# each declaration's value against its annotation and each return against the declared
# return type. Continues resolve_types_operators.elisa; split out to keep each part file
# under 600 lines.
include "./scalar_value_kind.elisa"
include "./reference_initializer_compatibility.elisa"
include "./reference_initializer_typestate_unique.elisa"

extend Semantic:
    private:
        # Return the referent id carried by a reference-valued initializer. For
        # `&place` the structural walker returns the place id; for an existing
        # reference value it returns the inner id. Unknown structure stays unknown,
        # so this helper never guesses a type.
        def reference_initializer_target_id(value: Ast::Expr, names: darray[sview]&, types: darray[sview @source]&, table: SymbolTable&) -> u32:
            can Abort.Panic:
                match value:
                    Expr.Paren(inner, paren_line):
                        return reference_initializer_target_id(inner, names, types, table)
                    Expr.Unary(operator, operand, unary_line):
                        if operator == TokenKind.Ampersand:
                            return structural_type_id_of(operand, names, types, table)
                        if operator == TokenKind.Mutable or operator == TokenKind.Lmut:
                            return reference_initializer_target_id(operand, names, types, table)
                    Expr.RegionNew(operand, _, _):
                        return structural_type_id_of(operand, names, types, table)
                    _:
                        pass
                source_id: u32 = structural_type_id_of(value, names, types, table)
                return interned_elem(source_id, 0, table) if interned_kind(source_id, table) == SemTypeKind.Ref
                return 0


        # Exact reference compatibility for an initializer. Numeric values may convert,
        # but references may not silently convert between pointee types: `Other& = &Point`
        # is a type error even when Point and Other have the same layout. Unknown source
        # structure remains silent, preserving the checker's conservative subset.
        def reference_initializer_matches(value: Ast::Expr, declared_id: u32, names: darray[sview]&, types: darray[sview @source]&, table: SymbolTable&) -> bool:
            can Abort.Panic:
                expected_target: u32 = interned_elem(declared_id, 0, table)
                actual_target: u32 = reference_initializer_target_id(value, names, types, table)
                return true if:
                    expected_target == 0 or actual_target == 0
                    expected_target == actual_target
                # Named derived states are phantom qualifiers on a struct reference. A
                # mutable reference to a known state can be widened to the unqualified
                # mutable reference used by the local alias (`Player[Alive]& -> Player&`),
                # exactly as stage0 permits. Keep this narrowly nominal: a generic
                # `Box[i64]& -> Box&` is not the same type and must remain rejected.
                return SemanticReferenceInitializerCompatibility::typestate_widening_allowed(
                    interned_kind(expected_target, table) == SemTypeKind.Named,
                    interned_kind(actual_target, table) == SemTypeKind.Container,
                    interned_name(expected_target, table) == interned_name(actual_target, table),
                    SemanticReferenceInitializerTypestate::unique_named_typestate_struct(table, interned_name(expected_target, table))
                )


        # Find reference-valued expressions without treating ordinary scalar/struct
        # auto-reads as errors. This is used only at the darray value boundary below;
        # include both constructors and statically known reference identifiers/calls.
        def expression_explicitly_produces_reference(expression: Ast::Expr, names: darray[sview]&, types: darray[sview @source]&, table: SymbolTable&) -> bool:
            can Abort.Panic:
                source_type_id: u32 = structural_type_id_of(expression, names, types, table)
                return true if interned_kind(source_type_id, table) == SemTypeKind.Ref
                match expression:
                    Expr.RegionNew(_, _, _):
                        return true
                    Expr.Unary(operator, _, _):
                        return operator in {TokenKind.Ampersand, TokenKind.Mutable, TokenKind.Lmut}
                    Expr.Paren(inner, _) | Expr.Move(inner, _):
                        return expression_explicitly_produces_reference(inner, names, types, table)
                    # Value-producing wrappers do not make a reference into its pointee.
                    # Inspect each possible result so a conditional or match cannot hide
                    # `new[r] value` from the destination-representation check.
                    Expr.If(_, then_value, else_value, _):
                        return expression_explicitly_produces_reference(then_value, names, types, table) or expression_explicitly_produces_reference(else_value, names, types, table)
                    Expr.Block(_, result_value, _, _) | Expr.Refinement(result_value, _, _):
                        return expression_explicitly_produces_reference(result_value, names, types, table)
                    Expr.Match(_, arms, _) | Expr.Catch(_, arms, _):
                        return any arm in arms where expression_statement_tail_produces_reference(arm.body, names, types, table)
                    Expr.GetElse(guarded, recovery, _):
                        return expression_explicitly_produces_reference(guarded, names, types, table) or expression_statement_tail_produces_reference(recovery, names, types, table)
                    Expr.Binary(left, operator, right, _):
                        return (operator == TokenKind.Plus or operator == TokenKind.Minus) and (expression_explicitly_produces_reference(left, names, types, table) or expression_explicitly_produces_reference(right, names, types, table))
                    _:
                        return false


        def expression_statement_tail_produces_reference(statements: darray[Ast::Stmt], names: darray[sview]&, types: darray[sview @source]&, table: SymbolTable&) -> bool:
            can Abort.Panic:
                return false if statements.count == 0
                match statements[statements.count - 1]:
                    Stmt.Expr(value, _):
                        return expression_explicitly_produces_reference(value, names, types, table)
                    _:
                        return false


        # Stage0 auto-reads a reference when its pointee is a scalar or an ordinary
        # by-value struct. A darray is different: copying the reference as a darray value
        # would store the pointer half of its runtime header without its length/capacity.
        # Preserve that specific ownership boundary, including through optional wrappers.
        def reference_as_darray_value_is_invalid(expected_id: u32, table: SymbolTable&) -> bool:
            can Abort.Panic:
                expected_kind: SemTypeKind = interned_kind(expected_id, table)
                return interned_name(expected_id, table) == "darray" if expected_kind == SemTypeKind.Container
                return reference_as_darray_value_is_invalid(interned_elem(expected_id, 0, table), table) if expected_kind == SemTypeKind.Optional and interned_elem_count(expected_id, table) == 1
                return false


        def check_reference_initializer(value: Ast::Expr, declared_id: u32, name: sview @source, line: Ast::Pos, names: darray[sview]&, types: darray[sview @source]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                return if reference_initializer_matches(value, declared_id, names, types, table)
                expected_target: u32 = interned_elem(declared_id, 0, table)
                actual_target: u32 = reference_initializer_target_id(value, names, types, table)
                return if expected_target == 0 or actual_target == 0
                expected_name: mutable sview = type_name_of_row(expected_target, table)
                actual_name: mutable sview = type_name_of_row(actual_target, table)
                expected_name <- interned_name(expected_target, table) if expected_name == ""
                actual_name <- interned_name(actual_target, table) if actual_name == ""
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.TypeMismatch, name: name, pos: line, line: line.line, expected: expected_name, actual: actual_name})


        # `DynArray[T]` is the runtime carrier for logical `darray[T, shape]`.
        # The shape parameter is compile-time-only, so the initializer wall must
        # compare the element row while erasing only that deliberate carrier
        # distinction. This is intentionally narrower than general container
        # compatibility: no other nominal/container heads are bridged here.
        def dynarray_initializer_bridge(expected_id: u32, actual_id: u32, table: SymbolTable&) -> bool:
            can Abort.Panic:
                return false if:
                    interned_kind(expected_id, table) != SemTypeKind.Container or interned_kind(actual_id, table) != SemTypeKind.Container
                    interned_name(expected_id, table) != "DynArray" or interned_name(actual_id, table) != "darray"
                    interned_elem_count(expected_id, table) != 1 or interned_elem_count(actual_id, table) != 1
                return interned_elem(expected_id, 0, table) == interned_elem(actual_id, 0, table)


        # The recorded extent of the statement's first BINDER, keyed by the owning
        # statement's byte offset (Ast::EnumAnnotation.pos; recorded by the parser because
        # `Stmt.For`'s `variables: darray[sview]` carries no position). Falls back to
        # line-only, which is what every unrecorded shape gets.
        # `for Pair(a, b) in items` and `for {a, b} in items` destructure a PATTERN, not a
        # tuple item, and stage0 accepts both. Only the plain comma form (`for a, b in xs`)
        # records a `__for_binder` row, so its presence is what separates the three shapes --
        # `variables.count >= 2` alone is true for all of them, which made the tuple-item
        # rule fire on a struct-pattern loop stage0 compiles clean.
        def for_loop_has_plain_binder(owner_offset: u32, table: SymbolTable&) -> bool:
            can Abort.Panic:
                for binder_index in 0..<table.binder_pos_offsets.count |owner_offset, table|:
                    return true if table.binder_pos_offsets[binder_index] == owner_offset
                return false


        def binder_pos_at(owner_offset: u32, owner_line: u32, table: SymbolTable&) -> Ast::Pos:
            can Abort.Panic:
                for binder_index in 0..<table.binder_pos_offsets.count |owner_offset, table|:
                    return table.binder_pos_values[binder_index] if table.binder_pos_offsets[binder_index] == owner_offset
                return Ast::pos_at_line(owner_line)


        # docs/119 §2: a value block's TAIL is its value, judged against the destination
        # exactly as the bare expression would be — with the block's own locals in scope, so
        # a tail `a` after `a: bool = …` is a bool. The block's statements are walked here
        # (their declarations, assignments, and a desugared `break VALUE` store into a loop
        # accumulator) and its scope is closed after the tail. That walk already runs the
        # operator checks for the block's statements, so a caller must not also hand the
        # whole block to check_operator_operands (each finding would print twice).
        # `mutation` selects the `x <- v` sentence over the declaration/return one.
        def check_block_value_against(value: Ast::Expr, type_name: sview @source, declared_name: sview @source, report_pos: Ast::Pos, mutation: bool, return_type_name: sview @source, return_type_id: u32, names: mutable darray[sview]&, types: mutable darray[sview @source]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match value:
                    Expr.Block(block_statements, block_tail, block_captures, block_line):
                        block_scope_mark: usize = names.count
                        table <- check_variable_initializers(block_statements, return_type_name, return_type_id, names, types, table) can Global{Read,Write}
                        table <- check_operator_operands(block_tail, names, types, table) if not (block_tail is Expr.Block(_, _, _, _))
                        table <- check_block_value_against(block_tail, type_name, declared_name, report_pos, mutation, return_type_name, return_type_id, names, types, table) can Global{Read,Write}
                        table <- close_type_scope(block_scope_mark, names, types, table)
                    Expr.Invalid:
                        pass
                    _:
                        table <- check_assigned_value_against(value, type_name, report_pos, names, types, table) if type_name != "" and mutation
                        table <- check_value_against(value, type_name, declared_name, report_pos, names, types, table) if type_name != "" and not mutation

        # `x <- v` where v can never fit x's type: stage0's "cannot assign V to T". An
        # untyped integer literal is spelled `int`, as stage0's builtin literal type prints.
        def check_assigned_value_against(value: Ast::Expr, type_name: sview @source, report_pos: Ast::Pos, names: darray[sview]&, types: darray[sview @source]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                # A declared STRUCT wall. Both `never_fits` predicates bail when the target
                # is not a primitive family, so `q <- 5` for `q: P` reached neither and the
                # sentence came from the declaration checker instead -- wrong wording, and no
                # column. Same sentence and same span as the primitive walls; only the wall
                # is nominal. A non-primitive VALUE stays silent: `assigned_family` is "" for
                # a struct/call/Unknown, and a struct-to-struct assignment is not modelled.
                struct_wall: bool = named_struct_target(type_name, table)
                assigned_literal: sview = literal_kind_of(value)
                if assigned_literal != "":
                    assigned_literal_spelling: sview = stage0_literal_spelling(assigned_literal)
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AssignValueMismatch, name: "", pos: report_pos, line: report_pos.line, expected: diagnostic_type_spelling(type_name), actual: assigned_literal_spelling}) if literal_never_fits(assigned_literal, type_name) or struct_wall
                else:
                    assigned_type: InferType = infer_expression_type(value, names, types, table)
                    assigned_family: sview = family_of_kind(assigned_type)
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AssignValueMismatch, name: "", pos: report_pos, line: report_pos.line, expected: diagnostic_type_spelling(type_name), actual: stage0_value_spelling(assigned_type)}) if assigned_family != "" and (firm_never_fits(assigned_family, type_name) or struct_wall)
                    # S1g: cstr/sview/dstr never convert implicitly (string_member_never_fits).
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AssignValueMismatch, name: "", pos: report_pos, line: report_pos.line, expected: diagnostic_type_spelling(type_name), actual: stage0_index_spelling(assigned_type)}) if string_member_never_fits(assigned_type, type_name)
                    assigned_enum: sview = enum_value_never_fits(value, type_name, names, types, table)
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AssignValueMismatch, name: "", pos: report_pos, line: report_pos.line, expected: type_name, actual: assigned_enum}) if assigned_enum != ""

        # Preserve stored-value representation invariants at storage boundaries. A
        # reference to a darray cannot be copied into the darray's split value header.
        # Keep the string-specific raw-reference rule too: a `u8&?` is not a nullable C
        # string, because the optional wrapper carries no proof that its referent is
        # terminated. Walk literal/branch shapes using the expected structural TypeId so
        # aggregates cannot hide either mismatch in a nested field or element.
        def check_stored_match_arms(arms: darray[Ast::MatchArm], expected_type_id: u32, name: sview @source, assignment: bool, names: darray[sview]&, types: darray[sview @source]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                # Value-match and catch arms end in the expression that supplies that
                # arm's value. Check only that tail under the receiving type; guards and
                # preceding effect statements do not inherit the result's expected type.
                for arm in arms |table, name, assignment, expected_type_id, names, types|:
                    if arm.body.count > 0:
                        match arm.body[arm.body.count - 1]:
                            Stmt.Expr(arm_value, _):
                                table <- check_stored_value(arm_value, expected_type_id, name, Ast::expr_pos(arm_value), assignment, names, types, table)
                            Stmt.Return(return_value, _):
                                if return_value is returned_value:
                                    table <- check_stored_value(returned_value, expected_type_id, name, Ast::expr_pos(returned_value), assignment, names, types, table)
                            _:
                                pass

        # A struct literal's own fields are typed by check_construct_field_type, which reports a
        # mismatched field value as `struct literal field "f" ...` (stage0's wording). Descend
        # into a field only to reach aggregates nested inside it; re-checking the field value
        # itself reported the same mismatch a second time as `variable "f" ...`.
        def stored_value_is_aggregate_literal(value: Ast::Expr) -> bool:
            return match value:
                Expr.Tuple(_, _) | Expr.Array(_, _) | Expr.SetLit(_, _) | Expr.DictLit(_, _):
                    true
                Expr.Construct(_, _, _) | Expr.RecordUpdate(_, _, _) | Expr.Comprehension(_, _, _, _, _, _):
                    true
                _:
                    false

        def check_stored_value(value: Ast::Expr, expected_type_id: u32, name: sview @source, report_pos: Ast::Pos, assignment: bool, names: darray[sview]&, types: darray[sview @source]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                return if expected_type_id == 0
                expected_kind: SemTypeKind = interned_kind(expected_type_id, table)
                payload_id: u32 = string_payload_type_id(expected_type_id, table)
                return if payload_id == 0 and expected_kind != SemTypeKind.Optional and expected_kind != SemTypeKind.Container and expected_kind != SemTypeKind.Tuple and expected_kind != SemTypeKind.Named
                # Follow transparent and value-producing control shapes BEFORE the
                # string payload fast path. A conditional such as
                # `raw if flag else null` is not itself a raw-reference expression, but
                # its selected value still has to satisfy the same storage contract.
                match value:
                    Expr.Paren(inner, _) | Expr.Move(inner, _):
                        table <- check_stored_value(inner, expected_type_id, name, Ast::expr_pos(inner), assignment, names, types, table)
                        return
                    Expr.If(_, then_value, else_value, _):
                        table <- check_stored_value(then_value, expected_type_id, name, Ast::expr_pos(then_value), assignment, names, types, table)
                        table <- check_stored_value(else_value, expected_type_id, name, Ast::expr_pos(else_value), assignment, names, types, table)
                        return
                    Expr.Block(value: block_value, _):
                        table <- check_stored_value(block_value, expected_type_id, name, Ast::expr_pos(block_value), assignment, names, types, table)
                        return
                    Expr.Match(_, arms, _) | Expr.Catch(_, arms, _):
                        table <- check_stored_match_arms(arms, expected_type_id, name, assignment, names, types, table)
                        return
                    _:
                        pass
                if expected_type_id != 0 and payload_id == 0 and reference_as_darray_value_is_invalid(expected_type_id, table) and expression_explicitly_produces_reference(value, names, types, table):
                    diagnostic_kind: DiagnosticKind = DiagnosticKind.AssignValueMismatch if assignment else DiagnosticKind.TypeMismatch
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: diagnostic_kind, name: name, pos: report_pos, line: report_pos.line, expected: interned_name(expected_type_id, table), actual: "reference"})
                    return
                if payload_id != 0:
                    if expression_is_raw_reference(value, names, types, table):
                        optional_string: bool = interned_kind(expected_type_id, table) == SemTypeKind.Optional
                        diagnostic_kind: DiagnosticKind = DiagnosticKind.AssignValueMismatch if assignment else DiagnosticKind.TypeMismatch
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: diagnostic_kind, name: name, pos: report_pos, line: report_pos.line, expected: diagnostic_name_of_row(payload_id, table), actual: "reference", detail3: "?" if optional_string else ""})
                    return
                if interned_kind(expected_type_id, table) == SemTypeKind.Optional and interned_elem_count(expected_type_id, table) == 1:
                    table <- check_stored_value(value, interned_elem(expected_type_id, 0, table), name, report_pos, assignment, names, types, table)
                    return
                effective_id: u32 = expected_type_id
                match value:
                    Expr.Tuple(tuple_elements, tuple_line):
                        if interned_kind(effective_id, table) == SemTypeKind.Tuple:
                            for tuple_index in 0..<tuple_elements.count |tuple_index, effective_id, name, report_pos, assignment, names, types, table|:
                                if tuple_index < interned_elem_count(effective_id, table):
                                    table <- check_stored_value(tuple_elements[tuple_index], interned_elem(effective_id, tuple_index, table), name, Ast::expr_pos(tuple_elements[tuple_index]), assignment, names, types, table)
                            return
                    _:
                        pass
                match value:
                    Expr.Array(elements, _):
                        if interned_kind(effective_id, table) == SemTypeKind.Container and interned_elem_count(effective_id, table) > 0 and (interned_name(effective_id, table) == "array" or interned_name(effective_id, table) == "darray"):
                            element_type_id: u32 = interned_elem(effective_id, 0, table)
                            for element in elements |table, name, report_pos, assignment, names, types, element_type_id|:
                                table <- check_stored_value(element, element_type_id, name, Ast::expr_pos(element), assignment, names, types, table)
                    Expr.SetLit(elements, _):
                        if interned_kind(effective_id, table) == SemTypeKind.Container and interned_name(effective_id, table) == "set" and interned_elem_count(effective_id, table) == 1:
                            element_type_id: u32 = interned_elem(effective_id, 0, table)
                            for element in elements |table, name, report_pos, assignment, names, types, element_type_id|:
                                table <- check_stored_value(element, element_type_id, name, Ast::expr_pos(element), assignment, names, types, table)
                    Expr.DictLit(entries, _):
                        if interned_kind(effective_id, table) == SemTypeKind.Container and interned_name(effective_id, table) == "dict" and interned_elem_count(effective_id, table) == 2:
                            key_type_id: u32 = interned_elem(effective_id, 0, table)
                            value_type_id: u32 = interned_elem(effective_id, 1, table)
                            for entry in entries |table, name, report_pos, assignment, names, types, key_type_id, value_type_id|:
                                table <- check_stored_value(entry.key, key_type_id, name, Ast::expr_pos(entry.key), assignment, names, types, table)
                                table <- check_stored_value(entry.value, value_type_id, name, Ast::expr_pos(entry.value), assignment, names, types, table)
                    Expr.Construct(type_expression, fields, _):
                        owner: sview = interned_name(effective_id, table) if interned_kind(effective_id, table) == SemTypeKind.Named else construct_type_name(type_expression)
                        if owner != "":
                            for field in fields |table, owner, name, report_pos, assignment, names, types|:
                                field_type_id: u32 = field_type_id_of(table, owner, field.name)
                                if field_type_id != 0 and stored_value_is_aggregate_literal(field.value):
                                    table <- check_stored_value(field.value, field_type_id, field.name, Ast::expr_pos(field.value), assignment, names, types, table)
                    Expr.RecordUpdate(base, fields, _):
                        base_type_id: u32 = structural_type_id_of(base, names, types, table)
                        owner: sview = interned_name(base_type_id, table) if interned_kind(base_type_id, table) == SemTypeKind.Named else interned_name(effective_id, table) if interned_kind(effective_id, table) == SemTypeKind.Named else ""
                        if owner != "":
                            for field in fields |table, owner, name, report_pos, assignment, names, types|:
                                field_type_id: u32 = field_type_id_of(table, owner, field.name)
                                # check_construct_field_type does not see record-update fields, so each one
                                # is checked here (only struct LITERAL fields are left to it).
                                if field_type_id != 0:
                                    table <- check_stored_value(field.value, field_type_id, field.name, Ast::expr_pos(field.value), assignment, names, types, table)
                    Expr.Comprehension(body: body, _):
                        if interned_kind(effective_id, table) == SemTypeKind.Container and interned_elem_count(effective_id, table) > 0:
                            table <- check_stored_value(body, interned_elem(effective_id, 0, table), name, Ast::expr_pos(body), assignment, names, types, table)
                    _:
                        pass

        # A narrowed optional reference followed by `as &`/`as !` is an indirect
        # assignment to the referenced slot. Recover that slot's declared value type so
        # raw byte pointers cannot bypass the storage guard through mutable container APIs
        # that return element references (for example `dict.get`).
        def assignment_referent_type_id(place: Ast::Expr, names: darray[sview]&, types: darray[sview @source]&, table: SymbolTable&) -> u32:
            can Abort.Panic:
                place_type_id: mutable u32 = structural_type_id_of(place, names, types, table)
                while interned_kind(place_type_id, table) == SemTypeKind.Optional and interned_elem_count(place_type_id, table) == 1 and interned_kind(interned_elem(place_type_id, 0, table), table) == SemTypeKind.Ref:
                    place_type_id <- interned_elem(place_type_id, 0, table)
                return interned_elem(place_type_id, 0, table) if interned_kind(place_type_id, table) == SemTypeKind.Ref and interned_elem_count(place_type_id, table) == 1
                return 0

        # Built-in container writes may be synthetic backend calls rather than ordinary
        # parameterized functions, so parameter type checking cannot reliably protect their
        # stored value. Check against the concrete receiver TypeId at the call site.
        def borrowed_darray_identifier_matches_value(expression: Ast::Expr, expected_type_id: u32, names: darray[sview]&, types: darray[sview @source]&, table: SymbolTable&) -> bool:
            can Abort.Panic:
                match expression:
                    # A reference parameter/local is auto-read when passed as a value to
                    # a by-value container operation. Do not confuse that established
                    # coercion with `new[r] value`, whose generated pointer is not a
                    # well-formed darray header. Other expression shapes still pass
                    # through check_stored_value and the RegionNew-specific guard.
                    Expr.Ident(_, _):
                        source_type_id: u32 = structural_type_id_of(expression, names, types, table)
                        return interned_kind(source_type_id, table) == SemTypeKind.Ref and interned_elem_count(source_type_id, table) == 1 and interned_elem(source_type_id, 0, table) == expected_type_id
                    _:
                        return false

        def check_container_mutation_stored_value(expression: Ast::Expr, names: darray[sview]&, types: darray[sview @source]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, _, _):
                        match callee:
                            Expr.Field(receiver, method, _):
                                receiver_type_id: mutable u32 = structural_type_id_of(receiver, names, types, table)
                                while interned_kind(receiver_type_id, table) == SemTypeKind.Ref and interned_elem_count(receiver_type_id, table) == 1:
                                    receiver_type_id <- interned_elem(receiver_type_id, 0, table)
                                receiver_name: sview = interned_name(receiver_type_id, table) if interned_kind(receiver_type_id, table) == SemTypeKind.Container else ""
                                if receiver_name == "darray" and method == "push" and interned_elem_count(receiver_type_id, table) == 1 and arguments.count > 0:
                                    element_type_id: u32 = interned_elem(receiver_type_id, 0, table)
                                    if not borrowed_darray_identifier_matches_value(arguments[0], element_type_id, names, types, table):
                                        table <- check_stored_value(arguments[0], element_type_id, "darray element", Ast::expr_pos(arguments[0]), true, names, types, table)
                                if receiver_name == "set" and (method == "add" or method == "insert") and interned_elem_count(receiver_type_id, table) == 1 and arguments.count > 0:
                                    table <- check_stored_value(arguments[0], interned_elem(receiver_type_id, 0, table), "set element", Ast::expr_pos(arguments[0]), true, names, types, table)
                                if receiver_name == "dict" and (method == "put" or method == "get_or_insert") and interned_elem_count(receiver_type_id, table) == 2 and arguments.count > 1:
                                    table <- check_stored_value(arguments[1], interned_elem(receiver_type_id, 1, table), "dict value", Ast::expr_pos(arguments[1]), true, names, types, table)
                                # `dict.entry(key).insert(value)` and
                                # `.get_or_insert(value)` store through a derived place;
                                # recover the owning dict's value TypeId from the entry call.
                                if (method == "insert" or method == "get_or_insert") and arguments.count > 0:
                                    match receiver:
                                        Expr.Call(entry_callee, entry_arguments, _, _):
                                            match entry_callee:
                                                Expr.Field(dict_receiver, entry_method, _):
                                                    dict_type_id: mutable u32 = structural_type_id_of(dict_receiver, names, types, table)
                                                    while interned_kind(dict_type_id, table) == SemTypeKind.Ref and interned_elem_count(dict_type_id, table) == 1:
                                                        dict_type_id <- interned_elem(dict_type_id, 0, table)
                                                    if entry_method == "entry" and interned_kind(dict_type_id, table) == SemTypeKind.Container and interned_name(dict_type_id, table) == "dict" and interned_elem_count(dict_type_id, table) == 2 and entry_arguments.count == 1:
                                                        table <- check_stored_value(arguments[0], interned_elem(dict_type_id, 1, table), "dict value", Ast::expr_pos(arguments[0]), true, names, types, table)
                                                _:
                                                    pass
                                        _:
                                            pass
                            _:
                                pass
                    _:
                        pass

        # stage0's spelling of a destructured loop item that is certainly NOT a tuple: a
        # scalar (surface width kept, `u8`/`sview`), or a declared struct/enum. "" when the
        # item is not known that precisely -- a type parameter or an alias may still name a
        # tuple, and an unmodeled row must never manufacture the diagnostic.
        def tuple_item_leaf_spelling(type_id: u32, table: SymbolTable&) -> sview:
            can Memory.Allocate, Abort.Panic:
                kind: SemTypeKind = interned_kind(type_id, table)
                if kind in {SemTypeKind.Int, SemTypeKind.Float, SemTypeKind.Bool, SemTypeKind.Char, SemTypeKind.String}:
                    return interned_name(type_id, table) if interned_name(type_id, table) != ""
                    return type_name_of_row(type_id, table)
                return interned_name(type_id, table) if kind == SemTypeKind.Named and firm_is_nominal_struct_or_enum(interned_name(type_id, table), table)
                return ""

include "./resolve_types_initializers_check.elisa"
