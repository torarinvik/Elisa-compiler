# Catch arm out of the callee's error subset. When a caught call declares a RESTRICTED error
# subset — `error[FooError{Bad1}, ...]` — a catch arm naming a variant of that family that is
# NOT in the subset cannot occur and is rejected:
#
#   extern foo() -> i64 error[FooError{Bad1}, BarError{Bad3, Bad4}]
#   catch foo():
#       FooError.Bad2:  ...   # error: Bad2 is not in FooError's subset {Bad1}
#
# Data (all parser side-tables): a catch is `__catch_expr` (owner=callee, line=catch line);
# each variant arm is an annotation (owner=callee, same line, name="Family.Variant"). The
# callee's per-family variant subset is recorded as adjacent (`__error_variant_family`,
# `__error_variant_allow`) rows at the callee's `__error_return` declaration line. An arm
# whose family HAS a subset but whose full path matches no allowed (family, variant) pair is
# out of set. A family without a subset admits all its variants (never flagged).
extend Semantic:
    private:
        def cos_callee_name(expression: Ast::Expr) -> sview @source:
            can Abort.Panic:
                return match expression:
                    Expr.Ident(name, _) | Expr.Scope(_, name, _): name
                    Expr.Paren(inner, _): cos_callee_name(inner)
                    _: ""

        def cos_error_return_declaration(annotations: darray[Ast::EnumAnnotation]&, callee: sview, lexical_module: sview @source) -> (found: bool, line: u32, offset: u32, identity_id: u32, occurrence_offset: u32):
            can Abort.Panic:
                declaration_line: mutable u32 = 0
                declaration_offset: mutable u32 = 0
                declaration_identity_id: mutable u32 = 0
                declaration_occurrence_offset: mutable u32 = 0
                declaration_count: mutable usize = 0
                fallback_line: mutable u32 = 0
                fallback_offset: mutable u32 = 0
                fallback_identity_id: mutable u32 = 0
                fallback_occurrence_offset: mutable u32 = 0
                fallback_count: mutable usize = 0
                for annotation in annotations |declaration_line, declaration_offset, declaration_identity_id, declaration_occurrence_offset, declaration_count, fallback_line, fallback_offset, fallback_identity_id, fallback_occurrence_offset, fallback_count, annotations, callee, lexical_module|:
                    continue if annotation.owner != callee or annotation.name != "__error_return"
                    fallback_line <- annotation.line
                    fallback_offset <- annotation.offset
                    fallback_identity_id <- annotation.identity_id
                    fallback_occurrence_offset <- annotation.occurrence_offset
                    fallback_count <- fallback_count + 1.usize()
                    module_matches: mutable bool = false
                    for module_annotation in annotations |module_matches, annotation, lexical_module|:
                        continue if module_annotation.owner != "__fn_module" or module_annotation.name != lexical_module
                        same_declaration: bool = module_annotation.offset == annotation.offset
                        same_identity: bool = module_annotation.identity_id == annotation.identity_id
                        same_occurrence: bool = module_annotation.occurrence_offset == annotation.occurrence_offset
                        module_matches <- true if same_declaration and same_identity and same_occurrence
                    if module_matches:
                        declaration_line <- annotation.line
                        declaration_offset <- annotation.offset
                        declaration_identity_id <- annotation.identity_id
                        declaration_occurrence_offset <- annotation.occurrence_offset
                        declaration_count <- declaration_count + 1.usize()
                return (true, declaration_line, declaration_offset, declaration_identity_id, declaration_occurrence_offset) if declaration_count == 1.usize()
                return (true, fallback_line, fallback_offset, fallback_identity_id, fallback_occurrence_offset) if declaration_count == 0.usize() and fallback_count == 1.usize()
                return (false, 0, 0, 0, 0)

        # Subset rows keep the family leaf (`Fault`) for compatibility. Recover the
        # corresponding qualified spelling from the immediately preceding family/path
        # pair, scoped to this callee declaration. Repeated `Local::Fault` and
        # `Peer::Fault` families then retain separate allowed sets.
        def cos_subset_family_path(annotations: darray[Ast::EnumAnnotation]&, subset_index: usize, declaration_line: u32, declaration_offset: u32, declaration_identity_id: u32, occurrence_offset: u32, family: sview) -> (found: bool, path: sview @source):
            can Abort.Panic:
                selected_path: mutable sview @source = ""
                for family_index in 0..<subset_index |annotations, declaration_line, declaration_offset, declaration_identity_id, occurrence_offset, family, selected_path|:
                    family_annotation: Ast::EnumAnnotation = annotations[family_index]
                    continue if family_annotation.owner != "__error_set_family" or family_annotation.line != declaration_line or family_annotation.name != family
                    continue if family_annotation.offset != declaration_offset
                    continue if family_annotation.identity_id != declaration_identity_id
                    continue if family_annotation.occurrence_offset != occurrence_offset
                    continue if family_index + 1.usize() >= annotations.count
                    path_annotation: Ast::EnumAnnotation = annotations[family_index + 1.usize()]
                    continue if path_annotation.owner != "__error_set_family_path" or path_annotation.line != family_annotation.line or path_annotation.offset != family_annotation.offset or path_annotation.identity_id != family_annotation.identity_id or path_annotation.occurrence_offset != occurrence_offset
                    selected_path <- path_annotation.name
                return (selected_path != "", selected_path)

        # An error catch-all arm — `error e:` (TypeBind "error") or `_:` (Wildcard) — covers
        # the opaque error component, so exhaustiveness over named variants is not required.
        def cos_pattern_is_catch_all(pattern: Ast::Pattern) -> bool:
            can Abort.Panic:
                match pattern:
                    Ast::Pattern.Wildcard:
                        return true
                    Ast::Pattern.TypeBind(type_name, binder):
                        return type_name == "error"
                    Ast::Pattern.Or(options):
                        for option in options:
                            return true if cos_pattern_is_catch_all(option)
                    Ast::Pattern.As(name, inner):
                        for nested in inner:
                            return true if cos_pattern_is_catch_all(nested)
                    _:
                        pass
                return false

        def cos_has_catch_all(arms: darray[Ast::MatchArm]&) -> bool:
            can Abort.Panic:
                for arm in arms:
                    return true if cos_pattern_is_catch_all(arm.pattern)
                return false

        # Static-if branches remain in the parser AST. Use the exact head position to
        # identify one and reuse the shared evaluator; an unknown condition must leave
        # its body visible to this conservative diagnostic pass.
        def cos_static_if_branch_selection(file: Ast::File&, line: u32, offset: u32, lexical_module: sview, table: SymbolTable&) -> (known: bool, selected: bool):
            can Abort.Panic:
                found_row: mutable usize = file.static_if_lines.count
                found_count: mutable usize = 0.usize()
                paired: usize = file.static_if_lines.count if file.static_if_lines.count < file.static_if_offsets.count else file.static_if_offsets.count
                for row in 0..<paired |found_row, found_count, file, line, offset|:
                    continue if file.static_if_lines[row] != line or file.static_if_offsets[row] != offset
                    found_row <- row
                    found_count <- found_count + 1.usize()
                return (false, false) if found_count > 1.usize()
                return ewr_static_if_row_selection(file, found_row, lexical_module, table) if found_count == 1.usize()
                return (true, true)

        def cos_pattern_handles_tag(pattern: Ast::Pattern, annotations: darray[Ast::EnumAnnotation]&, declaration_line: u32, declaration_offset: u32, declaration_identity_id: u32, occurrence_offset: u32, function_module: sview @source, family: sview, variant: sview, family_module: sview, file: Ast::File&, table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                match pattern:
                    Ast::Pattern.Variant(path, pattern_fields):
                        return catch_path_has_variant(path, function_module, declaration_line, declaration_offset, declaration_identity_id, occurrence_offset, family, variant, family_module, true, annotations, file, table)
                    Ast::Pattern.Binding(name):
                        return catch_path_has_variant(name, function_module, declaration_line, declaration_offset, declaration_identity_id, occurrence_offset, family, variant, family_module, true, annotations, file, table)
                    Ast::Pattern.Or(options) | Ast::Pattern.As(_, options):
                        for option in options:
                            return true if cos_pattern_handles_tag(option, annotations, declaration_line, declaration_offset, declaration_identity_id, occurrence_offset, function_module, family, variant, family_module, file, table)
                    _:
                        pass
                return false

        # Whether some variant arm handles (family, variant).
        def cos_pair_handled(arms: darray[Ast::MatchArm]&, annotations: darray[Ast::EnumAnnotation]&, declaration_line: u32, declaration_offset: u32, declaration_identity_id: u32, occurrence_offset: u32, function_module: sview @source, family: sview, variant: sview, family_module: sview, file: Ast::File&, table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                for arm_index in 1..<arms.count:
                    arm: Ast::MatchArm = arms[arm_index]
                    return true if cos_pattern_handles_tag(arm.pattern, annotations, declaration_line, declaration_offset, declaration_identity_id, occurrence_offset, function_module, family, variant, family_module, file, table)
                return false

        # Resolve an arm against the caught union before deciding whether it falls
        # outside a restricted family. Exact qualified paths disambiguate duplicate
        # family leaves; a short Stage0-compatible path is accepted only when it names
        # one tag in this call's union.
        def cos_path_is_out_of_subset(path: sview, sub_families: darray[sview]&, sub_variants: darray[sview]&, sub_modules: darray[sview]&, sub_closed: darray[bool]&, annotations: darray[Ast::EnumAnnotation]&, declaration_line: u32, declaration_offset: u32, declaration_identity_id: u32, occurrence_offset: u32, function_module: sview @source, file: Ast::File&, table: SymbolTable&) -> bool:
            can Abort.Panic:
                # If the subset marker belongs to this declaration but its family/path join is
                # broken, the caught-union path cannot resolve the family module. Still reject
                # an exact declared tag by checking all same-leaf owners conservatively.
                for closed_index in 0..<sub_families.count |sub_families, sub_modules, sub_closed, table, path, file|:
                    continue if closed_index >= sub_closed.count or not sub_closed[closed_index] or closed_index >= sub_modules.count or sub_modules[closed_index] != ""
                    family: sview = sub_families[closed_index]
                    for variant_index in 0..<table.enum_variant_owner.count |table, family, path, variant_index, file|:
                        continue if table.enum_variant_owner[variant_index] != family or variant_index >= table.enum_variant_module.count
                        candidate_variant: sview = table.enum_variant_name[variant_index]
                        candidate_module: sview = table.enum_variant_module[variant_index]
                        branch: (found: bool, active: bool, uncertain: bool) = catch_error_set_variant_branch_state(file.top_decls, "", family, candidate_module, candidate_variant, file.enum_annotations, file, table)
                        continue if not branch.found or not branch.active or branch.uncertain
                        return true if catch_variant_path_is_exact(path, family, candidate_variant, candidate_module) or catch_variant_path_matches(path, family, candidate_variant, candidate_module)
                for family_index in 0..<annotations.count |annotations, sub_families, sub_variants, sub_modules, sub_closed, declaration_line, declaration_offset, declaration_identity_id, occurrence_offset, function_module, table, path, file|:
                    family_annotation: Ast::EnumAnnotation = annotations[family_index]
                    continue if family_annotation.owner != "__error_set_family" or family_annotation.line != declaration_line
                    continue if family_annotation.offset != declaration_offset
                    continue if family_annotation.identity_id != declaration_identity_id
                    continue if family_annotation.occurrence_offset != occurrence_offset
                    continue if family_index + 1.usize() >= annotations.count
                    path_annotation: Ast::EnumAnnotation = annotations[family_index + 1.usize()]
                    continue if path_annotation.owner != "__error_set_family_path" or path_annotation.line != family_annotation.line or path_annotation.offset != family_annotation.offset or path_annotation.identity_id != family_annotation.identity_id or path_annotation.occurrence_offset != occurrence_offset
                    family: sview = family_annotation.name
                    family_module: (known: bool, module: sview @source) = catch_error_family_module_for_declaration(annotations, declaration_line, declaration_offset, declaration_identity_id, family, path_annotation.name, true, function_module, table)
                    continue if not family_module.known
                    for variant_index in 0..<table.enum_variant_owner.count |annotations, sub_families, sub_variants, sub_modules, sub_closed, declaration_line, declaration_offset, declaration_identity_id, occurrence_offset, function_module, family, family_module, table, path, file|:
                        variant: sview = table.enum_variant_name[variant_index]
                        continue if table.enum_variant_owner[variant_index] != family or variant_index >= table.enum_variant_module.count or table.enum_variant_module[variant_index] != family_module.module
                        branch: (found: bool, active: bool, uncertain: bool) = catch_error_set_variant_branch_state(file.top_decls, "", family, family_module.module, variant, file.enum_annotations, file, table)
                        continue if not branch.found or not branch.active or branch.uncertain
                        continue if not catch_error_variant_table_row_is_first(table, variant_index, family, family_module.module, variant)
                        in_caught_union: bool = catch_path_has_variant(path, function_module, declaration_line, declaration_offset, declaration_identity_id, occurrence_offset, family, variant, family_module.module, true, annotations, file, table)
                        unique_declared_tag: bool = catch_path_has_variant(path, function_module, declaration_line, declaration_offset, declaration_identity_id, occurrence_offset, family, variant, family_module.module, false, annotations, file, table) if not in_caught_union else false
                        continue if not in_caught_union and not unique_declared_tag
                        restricted: mutable bool = false
                        allowed: mutable bool = false
                        for subset_index in 0..<sub_families.count |subset_index, sub_families, sub_variants, sub_modules, sub_closed, family, variant, family_module, restricted, allowed|:
                            continue if subset_index >= sub_modules.count or sub_families[subset_index] != family
                            module_matches: bool = sub_modules[subset_index] == family_module.module or (subset_index < sub_closed.count and sub_closed[subset_index] and sub_modules[subset_index] == "")
                            continue if not module_matches
                            restricted <- true
                            return true if subset_index < sub_closed.count and sub_closed[subset_index]
                            allowed <- true if subset_index < sub_variants.count and sub_variants[subset_index] == variant
                        return true if restricted and not allowed
                return false

        def cos_check_pattern_out_of_subset(pattern: Ast::Pattern, sub_families: darray[sview]&, sub_variants: darray[sview]&, sub_modules: darray[sview]&, sub_closed: darray[bool]&, annotations: darray[Ast::EnumAnnotation]&, declaration_line: u32, declaration_offset: u32, declaration_identity_id: u32, occurrence_offset: u32, function_module: sview @source, match_line: u32, file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match pattern:
                    Ast::Pattern.Variant(path, pattern_fields):
                        out_of_set: bool = cos_path_is_out_of_subset(path, sub_families, sub_variants, sub_modules, sub_closed, annotations, declaration_line, declaration_offset, declaration_identity_id, occurrence_offset, function_module, file, table)
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.CatchArmOutOfSet, name: path, line: match_line, expected: "", actual: ""}) if out_of_set
                    Ast::Pattern.Binding(name):
                        out_of_set: bool = cos_path_is_out_of_subset(name, sub_families, sub_variants, sub_modules, sub_closed, annotations, declaration_line, declaration_offset, declaration_identity_id, occurrence_offset, function_module, file, table)
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.CatchArmOutOfSet, name: name, line: match_line, expected: "", actual: ""}) if out_of_set
                    Ast::Pattern.Or(options) | Ast::Pattern.As(_, options):
                        for option in options |table, sub_families, sub_variants, sub_modules, sub_closed, annotations, declaration_line, declaration_offset, declaration_identity_id, occurrence_offset, function_module, match_line, file|:
                            table <- cos_check_pattern_out_of_subset(option, sub_families, sub_variants, sub_modules, sub_closed, annotations, declaration_line, declaration_offset, declaration_identity_id, occurrence_offset, function_module, match_line, file, table)
                    _:
                        pass

        # A statement `catch` lowers to a `Stmt.Match` tagged by a `__catch_match` marker at
        # the same line — that is how a catch is distinguished from an ordinary match.
        def cos_is_catch(table: SymbolTable&, match_line: u32, match_offset: u32, lexical_module: sview) -> bool:
            can Abort.Panic:
                return any marker in table.protocol_annotations where marker.owner == "__catch_match" and marker.name == "__catch_match" and marker.line == match_line and marker.offset == match_offset and marker.module == lexical_module

        def cos_check_catch_arms(scrutinee: Ast::Expr, arms: darray[Ast::MatchArm], match_line: u32, match_offset: u32, lexical_module: sview @source, annotations: darray[Ast::EnumAnnotation]&, file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match scrutinee:
                    Expr.Call(callee_expr, call_arguments, call_argument_names, call_line):
                        callee: sview @source = cos_callee_name(callee_expr)
                        callee_module: (found: bool, qualifier: sview @source, offset: u32) = catch_callee_module_qualifier(annotations, callee, match_line, match_offset, lexical_module)
                        function_declaration: (known: bool, module: sview @source, line: u32, offset: u32, identity_id: u32, occurrence_offset: u32) = catch_error_declaration_with_occurrence(annotations, callee, lexical_module, callee_module.qualifier, match_line, callee_module.offset) if callee_module.found else (false, callee, 0, 0, 0, 0)
                        fallback_declaration: (found: bool, line: u32, offset: u32, identity_id: u32, occurrence_offset: u32) = cos_error_return_declaration(annotations, callee, lexical_module) if not function_declaration.known and callee_module.found and callee_module.qualifier == "" else (false, 0, 0, 0, 0)
                        declaration_line: mutable u32 = function_declaration.line if function_declaration.known else fallback_declaration.line
                        declaration_offset: mutable u32 = function_declaration.offset if function_declaration.known else fallback_declaration.offset
                        declaration_identity_id: mutable u32 = function_declaration.identity_id if function_declaration.known else fallback_declaration.identity_id
                        return_occurrence_offset: mutable u32 = function_declaration.occurrence_offset if function_declaration.known else fallback_declaration.occurrence_offset
                        function_module: sview = function_declaration.module if function_declaration.known else lexical_module
                        sub_families: mutable darray[sview] = []
                        sub_variants: mutable darray[sview] = []
                        sub_modules: mutable darray[sview] = []
                        sub_closed: mutable darray[bool] = []
                        index: mutable usize = 0
                        while index < annotations.count |index, sub_families, sub_variants, sub_modules, sub_closed, annotations, declaration_line, declaration_offset, declaration_identity_id, return_occurrence_offset, function_declaration, function_module, file, table|:
                            subset_family: Ast::EnumAnnotation = annotations[index]
                            subset_allow: mutable Ast::EnumAnnotation = subset_family
                            if index + 1 < annotations.count:
                                subset_allow <- annotations[index + 1]
                            if subset_family.owner == "__error_variant_family" and subset_family.line == declaration_line and subset_family.offset == declaration_offset and subset_family.occurrence_offset == return_occurrence_offset:
                                family: sview = subset_family.name
                                family_path: (found: bool, path: sview @source) = cos_subset_family_path(annotations, index, declaration_line, declaration_offset, declaration_identity_id, return_occurrence_offset, family)
                                family_module: (known: bool, module: sview @source) = catch_error_family_module_for_declaration(annotations, declaration_line, declaration_offset, declaration_identity_id, family, family_path.path, function_declaration.known, function_module, table)
                                marker_identity_matches: bool = subset_family.identity_id == declaration_identity_id
                                associated_family: bool = marker_identity_matches or family_path.found
                                if associated_family:
                                    if family_path.found and family_module.known:
                                        matching_allow: bool = marker_identity_matches and subset_allow.owner == "__error_variant_allow" and subset_allow.line == subset_family.line and subset_allow.offset == subset_family.offset and subset_allow.identity_id == subset_family.identity_id and subset_allow.occurrence_offset == return_occurrence_offset
                                        if matching_allow:
                                            sub_families.push(family)
                                            sub_variants.push(subset_allow.name)
                                            sub_modules.push(family_module.module)
                                            sub_closed.push(false)
                                        elif subset_allow.owner == "__error_variant_allow" or not marker_identity_matches:
                                            # A mismatched adjacent allow or marker identity is
                                            # malformed metadata; close this family occurrence.
                                            sub_families.push(family)
                                            sub_variants.push("")
                                            sub_modules.push(family_module.module)
                                            sub_closed.push(true)
                                    else:
                                        # A matching marker with a broken family/path join cannot
                                        # be assigned safely to one module. Close same-leaf
                                        # families in this caught union instead of widening it.
                                        sub_families.push(family)
                                        sub_variants.push("")
                                        sub_modules.push("")
                                        sub_closed.push(true)
                            index <- index + 1
                        if sub_families.count > 0:
                            arm_index: mutable usize = 1.usize()
                            while arm_index < arms.count |arm_index, table, arms, annotations, function_declaration, declaration_line, declaration_offset, declaration_identity_id, return_occurrence_offset, function_module, sub_families, sub_variants, sub_modules, sub_closed, match_line, file|:
                                arm: Ast::MatchArm = arms[arm_index]
                                table <- cos_check_pattern_out_of_subset(arm.pattern, sub_families, sub_variants, sub_modules, sub_closed, annotations, declaration_line, declaration_offset, declaration_identity_id, return_occurrence_offset, function_module, match_line, file, table)
                                arm_index <- arm_index + 1.usize()
                            # Exhaustiveness: without an `error e:`/`_` catch-all, every allowed
                            # (family, variant) pair must be handled — report the first missing one.
                            if not cos_has_catch_all(arms):
                                missing_index: mutable usize = sub_families.count
                                pair_index: mutable usize = 0
                                while pair_index < sub_families.count |missing_index, pair_index, sub_families, sub_variants, sub_modules, arms, declaration_line, declaration_offset, declaration_identity_id, return_occurrence_offset, function_module, annotations, table, file|:
                                    if sub_variants[pair_index] != "":
                                        branch: (found: bool, active: bool, uncertain: bool) = catch_error_set_variant_branch_state(file.top_decls, "", sub_families[pair_index], sub_modules[pair_index], sub_variants[pair_index], file.enum_annotations, file, table)
                                        if branch.found and branch.active and not branch.uncertain:
                                            missing_index <- pair_index if missing_index == sub_families.count and not cos_pair_handled(arms, annotations, declaration_line, declaration_offset, declaration_identity_id, return_occurrence_offset, function_module, sub_families[pair_index], sub_variants[pair_index], sub_modules[pair_index], file, table)
                                    pair_index <- pair_index + 1
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.CatchSubsetNonExhaustive, name: sub_families[missing_index], line: match_line, expected: "", actual: sub_variants[missing_index]}) if missing_index < sub_families.count

                    _:
                        pass

        def cos_check_match(scrutinee: Ast::Expr, arms: darray[Ast::MatchArm], match_line: u32, match_offset: u32, lexical_module: sview @source, annotations: darray[Ast::EnumAnnotation]&, file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                return if not cos_is_catch(table, match_line, match_offset, lexical_module)
                table <- cos_check_catch_arms(scrutinee, arms, match_line, match_offset, lexical_module, annotations, file, table)
        def cos_walk_stmts(statements: darray[Ast::Stmt], lexical_module: sview @source, annotations: darray[Ast::EnumAnnotation]&, file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- cos_walk_expression(expression, lexical_module, annotations, file, table)
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- cos_walk_expression(type_expression, lexical_module, annotations, file, table)
                            table <- cos_walk_expression(value, lexical_module, annotations, file, table)
                        Stmt.Assign(target, operator, value, line):
                            table <- cos_walk_expression(target, lexical_module, annotations, file, table)
                            table <- cos_walk_expression(value, lexical_module, annotations, file, table)
                        Stmt.Match(scrutinee, arms, match_line):
                            table <- cos_check_match(scrutinee, arms, match_line.line, match_line.offset, lexical_module, annotations, file, table)
                            table <- cos_walk_expression(scrutinee, lexical_module, annotations, file, table)
                            for arm in arms |table| -> table:
                                table <- cos_walk_expression(arm.guard, lexical_module, annotations, file, table)
                                table <- cos_walk_stmts(arm.body, lexical_module, annotations, file, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- cos_walk_expression(condition, lexical_module, annotations, file, table)
                            table <- cos_walk_stmts(then_body, lexical_module, annotations, file, table)
                            table <- cos_walk_stmts(else_body, lexical_module, annotations, file, table)
                        Stmt.While(condition, while_body, while_line):
                            table <- cos_walk_expression(condition, lexical_module, annotations, file, table)
                            table <- cos_walk_stmts(while_body, lexical_module, annotations, file, table)
                        Stmt.For(bind, variables, iterable, for_body, for_line):
                            table <- cos_walk_expression(iterable, lexical_module, annotations, file, table)
                            table <- cos_walk_stmts(for_body, lexical_module, annotations, file, table)
                        Stmt.Block(kind, clause, binding, body, block_line):
                            branch: (known: bool, selected: bool) = cos_static_if_branch_selection(file, block_line.line, block_line.offset, lexical_module, table)
                            table <- cos_walk_stmts(body, lexical_module, annotations, file, table) if not branch.known or branch.selected
                        Stmt.Return(value, line):
                            table <- cos_walk_expression(return_value, lexical_module, annotations, file, table) if value is return_value
                        Stmt.Contract(kind, expression, line):
                            table <- cos_walk_expression(expression, lexical_module, annotations, file, table)
                        Stmt.Invalid:
                            pass
                        Stmt.Break(label, line):
                            pass
                        Stmt.Continue(label, line):
                            pass

        # Expression catches can appear in returns, assignments, and value blocks.
        # Walk the same expression containers as the general Catch arm checker so their
        # subset membership and exhaustiveness checks are not limited to statement catches.
        def cos_walk_expression(expression: Ast::Expr, lexical_module: sview @source, annotations: darray[Ast::EnumAnnotation]&, file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Invalid:
                        pass
                    Expr.Absent:
                        pass
                    Expr.IntLit(value, _):
                        pass
                    Expr.FloatLit(text, _):
                        pass
                    Expr.StringLit(text, _):
                        pass
                    Expr.CharLit(text, _):
                        pass
                    Expr.BoolLit(value, _):
                        pass
                    Expr.Ident(name, _):
                        pass
                    Expr.StaticEffectCall(effect_type, operation, candidates, arguments, argument_names, line):
                        for child in Ast::effect_runtime_children(candidates, arguments) |table, file|:
                            table <- cos_walk_expression(child, lexical_module, annotations, file, table)
                    Expr.Call(callee, arguments, argument_names, line):
                        table <- cos_walk_expression(callee, lexical_module, annotations, file, table)
                        for argument in arguments |table, file|:
                            table <- cos_walk_expression(argument, lexical_module, annotations, file, table)
                    Expr.Field(object, field, line):
                        table <- cos_walk_expression(object, lexical_module, annotations, file, table)
                    Expr.Scope(base, name, line):
                        table <- cos_walk_expression(base, lexical_module, annotations, file, table)
                    Expr.ShorthandMember(parts, line):
                        pass
                    Expr.Index(object, index, line):
                        table <- cos_walk_expression(object, lexical_module, annotations, file, table)
                        table <- cos_walk_expression(index, lexical_module, annotations, file, table)
                    Expr.Slice(object, low, high, line):
                        table <- cos_walk_expression(object, lexical_module, annotations, file, table)
                        table <- cos_walk_expression(low, lexical_module, annotations, file, table)
                        table <- cos_walk_expression(high, lexical_module, annotations, file, table)
                    Expr.IndexN(object, arguments, line):
                        table <- cos_walk_expression(object, lexical_module, annotations, file, table)
                        for argument in arguments |table, file|:
                            table <- cos_walk_expression(argument, lexical_module, annotations, file, table)
                    Expr.Binary(left, operator, right, line):
                        table <- cos_walk_expression(left, lexical_module, annotations, file, table)
                        table <- cos_walk_expression(right, lexical_module, annotations, file, table)
                    Expr.Unary(operator, operand, line):
                        table <- cos_walk_expression(operand, lexical_module, annotations, file, table)
                    Expr.Move(operand, line):
                        table <- cos_walk_expression(operand, lexical_module, annotations, file, table)
                    Expr.RegionNew(operand, region, line):
                        table <- cos_walk_expression(operand, lexical_module, annotations, file, table)
                    Expr.Refinement(base, predicate, line):
                        table <- cos_walk_expression(base, lexical_module, annotations, file, table)
                        table <- cos_walk_expression(predicate, lexical_module, annotations, file, table)
                    Expr.GetElse(guarded, recovery, line):
                        table <- cos_walk_expression(guarded, lexical_module, annotations, file, table)
                        table <- cos_walk_stmts(recovery, lexical_module, annotations, file, table)
                    Expr.Paren(inner, line):
                        table <- cos_walk_expression(inner, lexical_module, annotations, file, table)
                    Expr.Array(elements, line):
                        for element in elements |table, file|:
                            table <- cos_walk_expression(element, lexical_module, annotations, file, table)
                    Expr.Tuple(elements, line):
                        for element in elements |table, file|:
                            table <- cos_walk_expression(element, lexical_module, annotations, file, table)
                    Expr.SetLit(elements, line):
                        for element in elements |table, file|:
                            table <- cos_walk_expression(element, lexical_module, annotations, file, table)
                    Expr.DictLit(entries, line):
                        for entry in entries |table, file|:
                            table <- cos_walk_expression(entry.key, lexical_module, annotations, file, table)
                            table <- cos_walk_expression(entry.value, lexical_module, annotations, file, table)
                    Expr.Construct(type_expression, fields, line):
                        table <- cos_walk_expression(type_expression, lexical_module, annotations, file, table)
                        for field in fields |table, file|:
                            table <- cos_walk_expression(field.value, lexical_module, annotations, file, table)
                    Expr.RecordUpdate(base, fields, line):
                        table <- cos_walk_expression(base, lexical_module, annotations, file, table)
                        for field in fields |table, file|:
                            table <- cos_walk_expression(field.value, lexical_module, annotations, file, table)
                    Expr.If(condition, then_expr, else_expr, line):
                        table <- cos_walk_expression(condition, lexical_module, annotations, file, table)
                        table <- cos_walk_expression(then_expr, lexical_module, annotations, file, table)
                        table <- cos_walk_expression(else_expr, lexical_module, annotations, file, table)
                    Expr.Match(scrutinee, arms, line):
                        table <- cos_walk_expression(scrutinee, lexical_module, annotations, file, table)
                        for arm in arms |table, file|:
                            table <- cos_walk_expression(arm.guard, lexical_module, annotations, file, table)
                            table <- cos_walk_stmts(arm.body, lexical_module, annotations, file, table)
                    Expr.Catch(guarded, arms, line):
                        table <- cos_check_catch_arms(guarded, arms, line.line, line.offset, lexical_module, annotations, file, table)
                        table <- cos_walk_expression(guarded, lexical_module, annotations, file, table)
                        for arm in arms |table, file|:
                            table <- cos_walk_expression(arm.guard, lexical_module, annotations, file, table)
                            table <- cos_walk_stmts(arm.body, lexical_module, annotations, file, table)
                    Expr.Comprehension(loop_variable, iterable, condition, body, line, _):
                        table <- cos_walk_expression(iterable, lexical_module, annotations, file, table)
                        table <- cos_walk_expression(condition, lexical_module, annotations, file, table)
                        table <- cos_walk_expression(body, lexical_module, annotations, file, table)
                    Expr.Lambda(parameters, body, line):
                        table <- cos_walk_stmts(body, lexical_module, annotations, file, table)
                    Expr.Block(statements, value, captures, line):
                        table <- cos_walk_stmts(statements, lexical_module, annotations, file, table)
                        table <- cos_walk_expression(value, lexical_module, annotations, file, table)
                    _:
                        pass

        def cos_walk_declarations(declarations: darray[Ast::Decl], lexical_module: sview @source, annotations: darray[Ast::EnumAnnotation]&, file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            table <- cos_walk_stmts(body, lexical_module, annotations, file, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- cos_walk_declarations(module_body, module_name, annotations, file, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            branch: (known: bool, selected: bool) = cos_static_if_branch_selection(file, scoped_line.line, scoped_line.offset, lexical_module, table)
                            table <- cos_walk_declarations(scoped_body, lexical_module, annotations, file, table) if not branch.known or branch.selected
                        _:
                            pass

    public:
        def check_catch_out_of_set(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                annotations: mutable darray[Ast::EnumAnnotation] = catch_active_alias_annotations(file, table)
                table <- cos_walk_declarations(file.top_decls, "", annotations, file, table)
