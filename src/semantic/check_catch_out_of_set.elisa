# Catch arm out of the callee's error subset. When a caught call declares a RESTRICTED error
# subset — `error[FooError{Bad1}, ...]` — a catch arm naming a variant of that family that is
# NOT in the subset cannot occur and is rejected:
#
#   extern foo() -> i64 error[FooError{Bad1}, BarError{Bad3, Bad4}]
#   catch foo():
#       FooError.Bad2:  ...   # error: Bad2 is not in FooError's subset {Bad1}
#
# Data (all parser side-tables): a catch is `__catch_expr` (owner=callee, line=catch line);
# each variant arm is an annotation (owner=callee, same line, name="Family.Variant"). The
# callee's per-family variant subset is recorded as adjacent (`__error_variant_family`,
# `__error_variant_allow`) rows at the callee's `__error_return` declaration line. An arm
# whose family HAS a subset but whose full path matches no allowed (family, variant) pair is
# out of set. A family without a subset admits all its variants (never flagged).
extend Semantic:
    private:
        def cos_error_return_line(annotations: darray[Ast::EnumAnnotation]&, callee: sview, lexical_module: sview) -> u32:
            can Abort.Panic:
                declaration_line: mutable u32 = 0
                declaration_count: mutable usize = 0
                fallback_line: mutable u32 = 0
                fallback_count: mutable usize = 0
                for annotation in annotations:
                    continue if annotation.owner != callee or annotation.name != "__error_return"
                    fallback_line <- annotation.line
                    fallback_count <- fallback_count + 1.usize()
                    module_matches: mutable bool = false
                    for module_annotation in annotations |module_matches, annotation, lexical_module|:
                        continue if module_annotation.owner != "__fn_module" or module_annotation.name != lexical_module
                        same_declaration: bool = module_annotation.offset == annotation.offset if annotation.offset != 0 and module_annotation.offset != 0 else module_annotation.line == annotation.line
                        same_identity: bool = annotation.identity_id == 0 or module_annotation.identity_id == annotation.identity_id
                        module_matches <- true if same_declaration and same_identity
                    if module_matches:
                        declaration_line <- annotation.line
                        declaration_count <- declaration_count + 1.usize()
                return declaration_line if declaration_count == 1.usize()
                return fallback_line if declaration_count == 0.usize() and fallback_count == 1.usize()
                return 0

        # Subset rows keep the family leaf (`Fault`) for compatibility. Recover the
        # corresponding qualified spelling from the immediately preceding family/path
        # pair, scoped to this callee declaration. Repeated `Local::Fault` and
        # `Peer::Fault` families then retain separate allowed sets.
        def cos_subset_family_path(annotations: darray[Ast::EnumAnnotation]&, subset_index: usize, declaration_line: u32, declaration_offset: u32, declaration_identity_id: u32, family: sview) -> (found: bool, path: sview @source):
            can Abort.Panic:
                selected_path: mutable sview @source = ""
                for family_index in 0..<subset_index |annotations, declaration_line, declaration_offset, declaration_identity_id, family, selected_path|:
                    family_annotation: Ast::EnumAnnotation = annotations[family_index]
                    continue if family_annotation.owner != "__error_set_family" or family_annotation.line != declaration_line or family_annotation.name != family
                    continue if declaration_offset != 0 and family_annotation.offset != declaration_offset
                    continue if declaration_identity_id != 0 and family_annotation.identity_id != declaration_identity_id
                    continue if family_index + 1.usize() >= annotations.count
                    path_annotation: Ast::EnumAnnotation = annotations[family_index + 1.usize()]
                    continue if path_annotation.owner != "__error_set_family_path" or path_annotation.line != family_annotation.line or path_annotation.offset != family_annotation.offset or path_annotation.identity_id != family_annotation.identity_id
                    selected_path <- path_annotation.name
                return (selected_path != "", selected_path)

        # An error catch-all arm — `error e:` (TypeBind "error") or `_:` (Wildcard) — covers
        # the opaque error component, so exhaustiveness over named variants is not required.
        def cos_pattern_is_catch_all(pattern: Ast::Pattern) -> bool:
            can Abort.Panic:
                match pattern:
                    Ast::Pattern.Wildcard:
                        return true
                    Ast::Pattern.TypeBind(type_name, binder):
                        return type_name == "error"
                    Ast::Pattern.Or(options):
                        for option in options:
                            return true if cos_pattern_is_catch_all(option)
                    Ast::Pattern.As(name, inner):
                        for nested in inner:
                            return true if cos_pattern_is_catch_all(nested)
                    _:
                        pass
                return false

        def cos_has_catch_all(arms: darray[Ast::MatchArm]&) -> bool:
            can Abort.Panic:
                for arm in arms:
                    return true if cos_pattern_is_catch_all(arm.pattern)
                return false

        def cos_pattern_handles_tag(pattern: Ast::Pattern, annotations: darray[Ast::EnumAnnotation]&, declaration_line: u32, declaration_offset: u32, declaration_identity_id: u32, function_module: sview, family: sview, variant: sview, family_module: sview, table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                match pattern:
                    Ast::Pattern.Variant(path, pattern_fields):
                        return catch_path_has_variant(path, function_module, declaration_line, declaration_offset, declaration_identity_id, family, variant, family_module, true, annotations, table)
                    Ast::Pattern.Binding(name):
                        return catch_path_has_variant(name, function_module, declaration_line, declaration_offset, declaration_identity_id, family, variant, family_module, true, annotations, table)
                    Ast::Pattern.Or(options) | Ast::Pattern.As(_, options):
                        for option in options:
                            return true if cos_pattern_handles_tag(option, annotations, declaration_line, declaration_offset, declaration_identity_id, function_module, family, variant, family_module, table)
                    _:
                        pass
                return false

        # Whether some variant arm handles (family, variant).
        def cos_pair_handled(arms: darray[Ast::MatchArm]&, annotations: darray[Ast::EnumAnnotation]&, declaration_line: u32, declaration_offset: u32, declaration_identity_id: u32, function_module: sview, family: sview, variant: sview, family_module: sview, table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                for arm_index in 1..<arms.count:
                    arm: Ast::MatchArm = arms[arm_index]
                    return true if cos_pattern_handles_tag(arm.pattern, annotations, declaration_line, declaration_offset, declaration_identity_id, function_module, family, variant, family_module, table)
                return false

        # Resolve an arm against the caught union before deciding whether it falls
        # outside a restricted family. Exact qualified paths disambiguate duplicate
        # family leaves; a short Stage0-compatible path is accepted only when it names
        # one tag in this call's union.
        def cos_path_is_out_of_subset(path: sview, sub_families: darray[sview]&, sub_variants: darray[sview]&, sub_modules: darray[sview]&, annotations: darray[Ast::EnumAnnotation]&, declaration_line: u32, declaration_offset: u32, declaration_identity_id: u32, function_module: sview, table: SymbolTable&) -> bool:
            can Abort.Panic:
                for family_index in 0..<annotations.count |annotations, sub_families, sub_variants, sub_modules, declaration_line, declaration_offset, declaration_identity_id, function_module, table, path|:
                    family_annotation: Ast::EnumAnnotation = annotations[family_index]
                    continue if family_annotation.owner != "__error_set_family" or family_annotation.line != declaration_line
                    continue if declaration_offset != 0 and family_annotation.offset != declaration_offset
                    continue if declaration_identity_id != 0 and family_annotation.identity_id != declaration_identity_id
                    continue if family_index + 1.usize() >= annotations.count
                    path_annotation: Ast::EnumAnnotation = annotations[family_index + 1.usize()]
                    continue if path_annotation.owner != "__error_set_family_path" or path_annotation.line != family_annotation.line or path_annotation.offset != family_annotation.offset or path_annotation.identity_id != family_annotation.identity_id
                    family: sview = family_annotation.name
                    family_module: (known: bool, module: sview @source) = catch_error_family_module_for_declaration(annotations, declaration_line, declaration_offset, declaration_identity_id, family, path_annotation.name, true, function_module, table)
                    continue if not family_module.known
                    for variant_index in 0..<table.enum_variant_owner.count |annotations, sub_families, sub_variants, sub_modules, declaration_line, declaration_offset, declaration_identity_id, function_module, family, family_module, table, path|:
                        variant: sview = table.enum_variant_name[variant_index]
                        continue if table.enum_variant_owner[variant_index] != family or variant_index >= table.enum_variant_module.count or table.enum_variant_module[variant_index] != family_module.module
                        in_caught_union: bool = catch_path_has_variant(path, function_module, declaration_line, declaration_offset, declaration_identity_id, family, variant, family_module.module, true, annotations, table)
                        unique_declared_tag: bool = catch_path_has_variant(path, function_module, declaration_line, declaration_offset, declaration_identity_id, family, variant, family_module.module, false, annotations, table) if not in_caught_union else false
                        continue if not in_caught_union and not unique_declared_tag
                        restricted: mutable bool = false
                        allowed: mutable bool = false
                        for subset_index in 0..<sub_families.count |subset_index, sub_families, sub_variants, sub_modules, family, variant, family_module|:
                            continue if subset_index >= sub_modules.count or sub_families[subset_index] != family or sub_modules[subset_index] != family_module.module
                            restricted <- true
                            allowed <- true if subset_index < sub_variants.count and sub_variants[subset_index] == variant
                        return true if restricted and not allowed
                return false

        def cos_check_pattern_out_of_subset(pattern: Ast::Pattern, sub_families: darray[sview]&, sub_variants: darray[sview]&, sub_modules: darray[sview]&, annotations: darray[Ast::EnumAnnotation]&, declaration_line: u32, declaration_offset: u32, declaration_identity_id: u32, function_module: sview, match_line: u32, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match pattern:
                    Ast::Pattern.Variant(path, pattern_fields):
                        out_of_set: bool = cos_path_is_out_of_subset(path, sub_families, sub_variants, sub_modules, annotations, declaration_line, declaration_offset, declaration_identity_id, function_module, table)
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.CatchArmOutOfSet, name: path, line: match_line, expected: "", actual: ""}) if out_of_set
                    Ast::Pattern.Binding(name):
                        out_of_set: bool = cos_path_is_out_of_subset(name, sub_families, sub_variants, sub_modules, annotations, declaration_line, declaration_offset, declaration_identity_id, function_module, table)
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.CatchArmOutOfSet, name: name, line: match_line, expected: "", actual: ""}) if out_of_set
                    Ast::Pattern.Or(options) | Ast::Pattern.As(_, options):
                        for option in options |table, sub_families, sub_variants, sub_modules, annotations, declaration_line, declaration_offset, declaration_identity_id, function_module, match_line|:
                            table <- cos_check_pattern_out_of_subset(option, sub_families, sub_variants, sub_modules, annotations, declaration_line, declaration_offset, declaration_identity_id, function_module, match_line, table)
                    _:
                        pass

        # A statement `catch` lowers to a `Stmt.Match` tagged by a `__catch_match` marker at
        # the same line — that is how a catch is distinguished from an ordinary match.
        def cos_is_catch(table: SymbolTable&, match_line: u32) -> bool:
            can Abort.Panic:
                return any catch_line in table.catch_match_lines where catch_line == match_line

        def cos_check_catch_arms(scrutinee: Ast::Expr, arms: darray[Ast::MatchArm], match_line: u32, lexical_module: sview, annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match scrutinee:
                    Expr.Call(callee_expr, call_arguments, call_argument_names, call_line):
                        callee: sview = ident_name_of(callee_expr)
                        function_declaration: (known: bool, module: sview @source, line: u32, offset: u32, identity_id: u32) = catch_error_declaration(annotations, callee, lexical_module)
                        declaration_line: u32 = function_declaration.line if function_declaration.known else cos_error_return_line(annotations, callee, lexical_module)
                        function_module: sview = function_declaration.module if function_declaration.known else lexical_module
                        sub_families: mutable darray[sview] = []
                        sub_variants: mutable darray[sview] = []
                        sub_modules: mutable darray[sview] = []
                        index: mutable usize = 0
                        while index + 1 < annotations.count |index, sub_families, sub_variants, sub_modules, annotations, declaration_line, function_declaration, function_module, table|:
                            subset_family: Ast::EnumAnnotation = annotations[index]
                            subset_allow: Ast::EnumAnnotation = annotations[index + 1]
                            if subset_family.owner == "__error_variant_family" and subset_family.line == declaration_line and (function_declaration.offset == 0 or subset_family.offset == function_declaration.offset) and (function_declaration.identity_id == 0 or subset_family.identity_id == function_declaration.identity_id) and subset_allow.owner == "__error_variant_allow" and subset_allow.line == subset_family.line and subset_allow.offset == subset_family.offset and subset_allow.identity_id == subset_family.identity_id:
                                family: sview = subset_family.name
                                family_path: (found: bool, path: sview @source) = cos_subset_family_path(annotations, index, declaration_line, function_declaration.offset, function_declaration.identity_id, family)
                                family_module: (known: bool, module: sview @source) = catch_error_family_module_for_declaration(annotations, declaration_line, function_declaration.offset, function_declaration.identity_id, family, family_path.path, function_declaration.known, function_module, table)
                                if family_module.known:
                                    sub_families.push(family)
                                    sub_variants.push(subset_allow.name)
                                    sub_modules.push(family_module.module)
                            index <- index + 1
                        if sub_families.count > 0:
                            arm_index: mutable usize = 1.usize()
                            while arm_index < arms.count |arm_index, table, arms, annotations, function_declaration, function_module, sub_families, sub_variants, sub_modules, match_line|:
                                arm: Ast::MatchArm = arms[arm_index]
                                table <- cos_check_pattern_out_of_subset(arm.pattern, sub_families, sub_variants, sub_modules, annotations, declaration_line, function_declaration.offset, function_declaration.identity_id, function_module, match_line, table)
                                arm_index <- arm_index + 1.usize()
                            # Exhaustiveness: without an `error e:`/`_` catch-all, every allowed
                            # (family, variant) pair must be handled — report the first missing one.
                            if not cos_has_catch_all(arms):
                                missing_index: mutable usize = sub_families.count
                                pair_index: mutable usize = 0
                                while pair_index < sub_families.count |missing_index, pair_index, sub_families, sub_variants, sub_modules, arms|:
                                    missing_index <- pair_index if missing_index == sub_families.count and not cos_pair_handled(arms, annotations, declaration_line, function_declaration.offset, function_declaration.identity_id, function_module, sub_families[pair_index], sub_variants[pair_index], sub_modules[pair_index], table)
                                    pair_index <- pair_index + 1
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.CatchSubsetNonExhaustive, name: sub_families[missing_index], line: match_line, expected: "", actual: sub_variants[missing_index]}) if missing_index < sub_families.count

                    _:
                        pass

        def cos_check_match(scrutinee: Ast::Expr, arms: darray[Ast::MatchArm], match_line: u32, lexical_module: sview, annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                return if not cos_is_catch(table, match_line)
                table <- cos_check_catch_arms(scrutinee, arms, match_line, lexical_module, annotations, table)
        def cos_walk_stmts(statements: darray[Ast::Stmt], lexical_module: sview, annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- cos_walk_expression(expression, lexical_module, annotations, table)
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- cos_walk_expression(type_expression, lexical_module, annotations, table)
                            table <- cos_walk_expression(value, lexical_module, annotations, table)
                        Stmt.Assign(target, operator, value, line):
                            table <- cos_walk_expression(target, lexical_module, annotations, table)
                            table <- cos_walk_expression(value, lexical_module, annotations, table)
                        Stmt.Match(scrutinee, arms, match_line):
                            table <- cos_check_match(scrutinee, arms, match_line.line, lexical_module, annotations, table)
                            table <- cos_walk_expression(scrutinee, lexical_module, annotations, table)
                            for arm in arms |table| -> table:
                                table <- cos_walk_expression(arm.guard, lexical_module, annotations, table)
                                table <- cos_walk_stmts(arm.body, lexical_module, annotations, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- cos_walk_expression(condition, lexical_module, annotations, table)
                            table <- cos_walk_stmts(then_body, lexical_module, annotations, table)
                            table <- cos_walk_stmts(else_body, lexical_module, annotations, table)
                        Stmt.While(condition, while_body, while_line):
                            table <- cos_walk_expression(condition, lexical_module, annotations, table)
                            table <- cos_walk_stmts(while_body, lexical_module, annotations, table)
                        Stmt.For(bind, variables, iterable, for_body, for_line):
                            table <- cos_walk_expression(iterable, lexical_module, annotations, table)
                            table <- cos_walk_stmts(for_body, lexical_module, annotations, table)
                        Stmt.Block(kind, clause, binding, body, block_line):
                            table <- cos_walk_stmts(body, lexical_module, annotations, table)
                        Stmt.Return(value, line):
                            table <- cos_walk_expression(return_value, lexical_module, annotations, table) if value is return_value
                        Stmt.Contract(kind, expression, line):
                            table <- cos_walk_expression(expression, lexical_module, annotations, table)
                        Stmt.Invalid:
                            pass
                        Stmt.Break(label, line):
                            pass
                        Stmt.Continue(label, line):
                            pass

        # Expression catches can appear in returns, assignments, and value blocks.
        # Walk the same expression containers as the general Catch arm checker so their
        # subset membership and exhaustiveness checks are not limited to statement catches.
        def cos_walk_expression(expression: Ast::Expr, lexical_module: sview, annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Invalid:
                        pass
                    Expr.Absent:
                        pass
                    Expr.IntLit(value, _):
                        pass
                    Expr.FloatLit(text, _):
                        pass
                    Expr.StringLit(text, _):
                        pass
                    Expr.CharLit(text, _):
                        pass
                    Expr.BoolLit(value, _):
                        pass
                    Expr.Ident(name, _):
                        pass
                    Expr.StaticEffectCall(effect_type, operation, candidates, arguments, argument_names, line):
                        for child in Ast::effect_runtime_children(candidates, arguments) |table|:
                            table <- cos_walk_expression(child, lexical_module, annotations, table)
                    Expr.Call(callee, arguments, argument_names, line):
                        table <- cos_walk_expression(callee, lexical_module, annotations, table)
                        for argument in arguments |table|:
                            table <- cos_walk_expression(argument, lexical_module, annotations, table)
                    Expr.Field(object, field, line):
                        table <- cos_walk_expression(object, lexical_module, annotations, table)
                    Expr.Scope(base, name, line):
                        table <- cos_walk_expression(base, lexical_module, annotations, table)
                    Expr.ShorthandMember(parts, line):
                        pass
                    Expr.Index(object, index, line):
                        table <- cos_walk_expression(object, lexical_module, annotations, table)
                        table <- cos_walk_expression(index, lexical_module, annotations, table)
                    Expr.Slice(object, low, high, line):
                        table <- cos_walk_expression(object, lexical_module, annotations, table)
                        table <- cos_walk_expression(low, lexical_module, annotations, table)
                        table <- cos_walk_expression(high, lexical_module, annotations, table)
                    Expr.IndexN(object, arguments, line):
                        table <- cos_walk_expression(object, lexical_module, annotations, table)
                        for argument in arguments |table|:
                            table <- cos_walk_expression(argument, lexical_module, annotations, table)
                    Expr.Binary(left, operator, right, line):
                        table <- cos_walk_expression(left, lexical_module, annotations, table)
                        table <- cos_walk_expression(right, lexical_module, annotations, table)
                    Expr.Unary(operator, operand, line):
                        table <- cos_walk_expression(operand, lexical_module, annotations, table)
                    Expr.Move(operand, line):
                        table <- cos_walk_expression(operand, lexical_module, annotations, table)
                    Expr.RegionNew(operand, region, line):
                        table <- cos_walk_expression(operand, lexical_module, annotations, table)
                    Expr.Refinement(base, predicate, line):
                        table <- cos_walk_expression(base, lexical_module, annotations, table)
                        table <- cos_walk_expression(predicate, lexical_module, annotations, table)
                    Expr.GetElse(guarded, recovery, line):
                        table <- cos_walk_expression(guarded, lexical_module, annotations, table)
                        table <- cos_walk_stmts(recovery, lexical_module, annotations, table)
                    Expr.Paren(inner, line):
                        table <- cos_walk_expression(inner, lexical_module, annotations, table)
                    Expr.Array(elements, line):
                        for element in elements |table|:
                            table <- cos_walk_expression(element, lexical_module, annotations, table)
                    Expr.Tuple(elements, line):
                        for element in elements |table|:
                            table <- cos_walk_expression(element, lexical_module, annotations, table)
                    Expr.SetLit(elements, line):
                        for element in elements |table|:
                            table <- cos_walk_expression(element, lexical_module, annotations, table)
                    Expr.DictLit(entries, line):
                        for entry in entries |table|:
                            table <- cos_walk_expression(entry.key, lexical_module, annotations, table)
                            table <- cos_walk_expression(entry.value, lexical_module, annotations, table)
                    Expr.Construct(type_expression, fields, line):
                        table <- cos_walk_expression(type_expression, lexical_module, annotations, table)
                        for field in fields |table|:
                            table <- cos_walk_expression(field.value, lexical_module, annotations, table)
                    Expr.RecordUpdate(base, fields, line):
                        table <- cos_walk_expression(base, lexical_module, annotations, table)
                        for field in fields |table|:
                            table <- cos_walk_expression(field.value, lexical_module, annotations, table)
                    Expr.If(condition, then_expr, else_expr, line):
                        table <- cos_walk_expression(condition, lexical_module, annotations, table)
                        table <- cos_walk_expression(then_expr, lexical_module, annotations, table)
                        table <- cos_walk_expression(else_expr, lexical_module, annotations, table)
                    Expr.Match(scrutinee, arms, line):
                        table <- cos_walk_expression(scrutinee, lexical_module, annotations, table)
                        for arm in arms |table|:
                            table <- cos_walk_expression(arm.guard, lexical_module, annotations, table)
                            table <- cos_walk_stmts(arm.body, lexical_module, annotations, table)
                    Expr.Catch(guarded, arms, line):
                        table <- cos_check_catch_arms(guarded, arms, line.line, lexical_module, annotations, table)
                        table <- cos_walk_expression(guarded, lexical_module, annotations, table)
                        for arm in arms |table|:
                            table <- cos_walk_expression(arm.guard, lexical_module, annotations, table)
                            table <- cos_walk_stmts(arm.body, lexical_module, annotations, table)
                    Expr.Comprehension(loop_variable, iterable, condition, body, line, _):
                        table <- cos_walk_expression(iterable, lexical_module, annotations, table)
                        table <- cos_walk_expression(condition, lexical_module, annotations, table)
                        table <- cos_walk_expression(body, lexical_module, annotations, table)
                    Expr.Lambda(parameters, body, line):
                        table <- cos_walk_stmts(body, lexical_module, annotations, table)
                    Expr.Block(statements, value, captures, line):
                        table <- cos_walk_stmts(statements, lexical_module, annotations, table)
                        table <- cos_walk_expression(value, lexical_module, annotations, table)
                    _:
                        pass

        def cos_walk_declarations(declarations: darray[Ast::Decl], lexical_module: sview, annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            table <- cos_walk_stmts(body, lexical_module, annotations, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- cos_walk_declarations(module_body, module_name, annotations, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- cos_walk_declarations(scoped_body, lexical_module, annotations, table)
                        _:
                            pass

    public:
        def check_catch_out_of_set(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- cos_walk_declarations(file.top_decls, "", file.enum_annotations, table)
