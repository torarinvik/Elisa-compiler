# Catch arm out of the callee's error subset. When a caught call declares a RESTRICTED error
# subset — `error[FooError{Bad1}, ...]` — a catch arm naming a variant of that family that is
# NOT in the subset cannot occur and is rejected:
#
#   extern foo() -> i64 error[FooError{Bad1}, BarError{Bad3, Bad4}]
#   catch foo():
#       FooError.Bad2:  ...   # error: Bad2 is not in FooError's subset {Bad1}
#
# Data (all parser side-tables): a catch is `__catch_expr` (owner=callee, line=catch line);
# each variant arm is an annotation (owner=callee, same line, name="Family.Variant"). The
# callee's per-family variant subset is recorded as adjacent (`__error_variant_family`,
# `__error_variant_allow`) rows at the callee's `__error_return` declaration line. An arm
# whose family HAS a subset but whose full path matches no allowed (family, variant) pair is
# out of set. A family without a subset admits all its variants (never flagged).
extend Semantic:
    private:
        def cos_error_return_line(annotations: darray[Ast::EnumAnnotation]&, callee: sview) -> u32:
            can Abort.Panic:
                for annotation in annotations:
                    annotation.line return if annotation.owner == callee and annotation.name == "__error_return"
                return 0

        # `path` equals `family` + "." + `variant`, byte for byte.
        def cos_path_is_pair(path: sview, family: sview, variant: sview) -> bool:
            can Abort.Panic:
                family_length: usize = sview_len(family)
                variant_length: usize = sview_len(variant)
                false return if sview_len(path) != family_length + 1 + variant_length
                false return if sview_at(path, family_length) != 46
                head_ok: bool =
                    for probe in 0..<family_length |ok: bool = true| -> ok:
                        ok <- false if sview_at(path, probe) != sview_at(family, probe)
                false return if not head_ok
                suffix_ok: bool =
                    for probe in 0..<variant_length |tail_ok: bool = true| -> tail_ok:
                        tail_ok <- false if sview_at(path, family_length + 1 + probe) != sview_at(variant, probe)
                return suffix_ok

        # `path` begins with `family` + "." (its family component is `family`).
        def cos_path_has_family(path: sview, family: sview) -> bool:
            can Abort.Panic:
                family_length: usize = sview_len(family)
                false return if sview_len(path) < family_length + 1
                head_ok: bool =
                    for probe in 0..<family_length |ok: bool = true| -> ok:
                        ok <- false if sview_at(path, probe) != sview_at(family, probe)
                false return if not head_ok
                return sview_at(path, family_length) == 46

        def cos_path_has_dot(path: sview) -> bool:
            can Abort.Panic:
                has_dot: bool =
                    for probe in 0..<sview_len(path) |seen: bool = false| -> seen:
                        seen <- true if sview_at(path, probe) == 46
                return has_dot

        def cos_any_family(sub_families: darray[sview]&, path: sview) -> bool:
            can Abort.Panic:
                return any family in sub_families where cos_path_has_family(path, family)

        def cos_in_allowed(sub_families: darray[sview]&, sub_variants: darray[sview]&, path: sview) -> bool:
            can Abort.Panic:
                index: mutable usize = 0
                while index < sub_families.count |index|:
                    true return if cos_path_is_pair(path, sub_families[index], sub_variants[index])
                    index <- index + 1
                return false

        # An error catch-all arm — `error e:` (TypeBind "error") or `_:` (Wildcard) — covers
        # the opaque error component, so exhaustiveness over named variants is not required.
        def cos_has_catch_all(arms: darray[Ast::MatchArm]&) -> bool:
            can Abort.Panic:
                for arm in arms:
                    match arm.pattern:
                        Ast::Pattern.Wildcard:
                            return true
                        Ast::Pattern.TypeBind(type_name, binder):
                            true return if type_name == "error"
                        _:
                            pass
                return false

        # Whether some variant arm handles (family, variant).
        def cos_pair_handled(arms: darray[Ast::MatchArm]&, family: sview, variant: sview) -> bool:
            can Memory.Allocate, Abort.Panic:
                for arm in arms:
                    match arm.pattern:
                        Ast::Pattern.Variant(path, pattern_fields):
                            true return if cos_path_is_pair(path, family, variant)
                        _:
                            pass
                return false

        # A statement `catch` lowers to a `Stmt.Match` tagged by a `__catch_match` marker at
        # the same line — that is how a catch is distinguished from an ordinary match.
        def cos_is_catch(annotations: darray[Ast::EnumAnnotation]&, match_line: u32) -> bool:
            can Abort.Panic:
                return any annotation in annotations where annotation.name == "__catch_match" and annotation.line == match_line

        def cos_check_match(scrutinee: Ast::Expr, arms: darray[Ast::MatchArm], match_line: u32, annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                return if not cos_is_catch(annotations, match_line)
                if scrutinee is Expr.Call(callee_expr, call_arguments, call_argument_names, call_line):
                    callee: sview = ident_name_of(callee_expr)
                    declaration_line: u32 = cos_error_return_line(annotations, callee)
                    sub_families: mutable darray[sview] = []
                    sub_variants: mutable darray[sview] = []
                    index: mutable usize = 0
                    while index + 1 < annotations.count |index, sub_families, sub_variants|:
                        if annotations[index].owner == "__error_variant_family" and annotations[index].line == declaration_line and annotations[index + 1].owner == "__error_variant_allow":
                            sub_families.push(annotations[index].name)
                            sub_variants.push(annotations[index + 1].name)
                        index <- index + 1
                    if sub_families.count > 0:
                        for arm in arms |table| -> table:
                            match arm.pattern:
                                Ast::Pattern.Variant(path, pattern_fields):
                                    out_of_set: bool = cos_any_family(sub_families, path) and not cos_in_allowed(sub_families, sub_variants, path)
                                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.CatchArmOutOfSet, name: path, line: match_line, expected: "", actual: ""}) if out_of_set
                                _:
                                    pass
                        # Exhaustiveness: without an `error e:`/`_` catch-all, every allowed
                        # (family, variant) pair must be handled — report the first missing one.
                        if not cos_has_catch_all(arms):
                            missing_index: mutable usize = sub_families.count
                            pair_index: mutable usize = 0
                            while pair_index < sub_families.count |missing_index, pair_index|:
                                missing_index <- pair_index if missing_index == sub_families.count and not cos_pair_handled(arms, sub_families[pair_index], sub_variants[pair_index])
                                pair_index <- pair_index + 1
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.CatchSubsetNonExhaustive, name: sub_families[missing_index], line: match_line, expected: "", actual: sub_variants[missing_index]}) if missing_index < sub_families.count

        def cos_walk_stmts(statements: darray[Ast::Stmt], annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Match(scrutinee, arms, match_line):
                            table <- cos_check_match(scrutinee, arms, match_line, annotations, table)
                            for arm in arms |table| -> table:
                                table <- cos_walk_stmts(arm.body, annotations, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- cos_walk_stmts(then_body, annotations, table)
                            table <- cos_walk_stmts(else_body, annotations, table)
                        Stmt.While(condition, while_body, while_line):
                            table <- cos_walk_stmts(while_body, annotations, table)
                        Stmt.For(bind, variables, iterable, for_body, for_line):
                            table <- cos_walk_stmts(for_body, annotations, table)
                        Stmt.Block(kind, clause, binding, body, block_line):
                            table <- cos_walk_stmts(body, annotations, table)
                        _:
                            pass

        def cos_walk_declarations(declarations: darray[Ast::Decl], annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            table <- cos_walk_stmts(body, annotations, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- cos_walk_declarations(module_body, annotations, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- cos_walk_declarations(scoped_body, annotations, table)
                        _:
                            pass

    public:
        def check_catch_out_of_set(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- cos_walk_declarations(file.top_decls, file.enum_annotations, table)
