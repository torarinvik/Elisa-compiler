# Call-site QUANTIFIED precondition could-not-prove (a WARNING). A callee with a `requires forall …`
# quantified precondition (`requires forall k: (0<=k and k<n) implies xs[k] >= 0`) imposes an
# obligation the caller must discharge. stage0 warns "precondition of f could not be proven" when the
# caller cannot. Stage1 has no quantifier prover, so it mirrors the DECISION conservatively: a call to
# such a callee is unproven UNLESS the caller itself carries a quantified `requires`/`assert` (which
# might supply the fact) or passes a container LITERAL argument (which stage0 could evaluate). This
# never fires on a caller that could plausibly establish the fact — only the bare-forwarding case.
extend Semantic:
    private:
        # Whether an expression is a quantifier (`forall`/`exists`), i.e. carries a binder — the
        # parser lowers `forall k: P` to a Block declaring the binder with P as its value.
        def cqp_is_quantifier(expression: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                quant: (found: bool, binder: sview, body: Ast::Expr) = qr_quantifier_of(expression)
                return quant.found and quant.binder != ""

        # Whether a body carries a quantified `requires` (an obligation) or a quantified `assert`
        # (an established fact) — either lets the caller plausibly discharge a quantified obligation.
        def cqp_body_has_quantified_fact(statements: darray[Ast::Stmt]) -> bool:
            can Memory.Allocate, Abort.Panic:
                for statement in statements:
                    match statement:
                        Stmt.Contract(kind, expression, contract_line):
                            true return if (kind == "requires" or kind == "assert") and cqp_is_quantifier(expression)
                        _:
                            pass
                return false

        # Whether a body carries a quantified `requires` specifically (the callee obligation).
        def cqp_body_has_quantified_requires(statements: darray[Ast::Stmt]) -> bool:
            can Memory.Allocate, Abort.Panic:
                for statement in statements:
                    match statement:
                        Stmt.Contract(kind, expression, contract_line):
                            true return if kind == "requires" and cqp_is_quantifier(expression)
                        _:
                            pass
                return false

        # Collect the names of functions declaring a quantified `requires`.
        def cqp_collect(declarations: darray[Ast::Decl], out_names: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |out_names|:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, func_line):
                            out_names.push(function_name) if cqp_body_has_quantified_requires(body)
                        Decl.Module(module_name, module_body, module_line):
                            cqp_collect(module_body, out_names)
                        Decl.Scoped(scoped_body, scoped_line):
                            cqp_collect(scoped_body, out_names)
                        _:
                            pass

        # Whether any argument is a container LITERAL (`[…]`) — stage0 could evaluate the quantifier
        # over it, so a call passing one is not flagged.
        def cqp_any_literal_arg(arguments: darray[Ast::Expr]) -> bool:
            can Memory.Allocate, Abort.Panic:
                for argument in arguments:
                    match argument:
                        Expr.Array(elements, array_line):
                            return true
                        _:
                            pass
                return false

        def cqp_check_expr(expression: Ast::Expr, quantified_fns: darray[sview]&, caller_discharges: bool, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, call_line):
                        callee_name: sview = ident_name_of(callee)
                        fires: bool = callee_name != "" and not caller_discharges and not cqp_any_literal_arg(arguments) and name_in(quantified_fns, callee_name)
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.PreconditionUnproven, name: callee_name, line: call_line, expected: "", actual: ""}) if fires
                        for argument in arguments |table| -> table:
                            table <- cqp_check_expr(argument, quantified_fns, caller_discharges, table)
                    Expr.Binary(left, operator, right, binary_line):
                        table <- cqp_check_expr(left, quantified_fns, caller_discharges, table)
                        table <- cqp_check_expr(right, quantified_fns, caller_discharges, table)
                    Expr.Paren(inner, paren_line):
                        table <- cqp_check_expr(inner, quantified_fns, caller_discharges, table)
                    _:
                        pass

        def cqp_check_stmts(statements: darray[Ast::Stmt], quantified_fns: darray[sview]&, caller_discharges: bool, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- cqp_check_expr(expression, quantified_fns, caller_discharges, table)
                        Stmt.Return(value, line):
                            table <- cqp_check_expr(returned, quantified_fns, caller_discharges, table) if value is returned
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- cqp_check_expr(value, quantified_fns, caller_discharges, table)
                        Stmt.Assign(target, operator, value, line):
                            table <- cqp_check_expr(value, quantified_fns, caller_discharges, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- cqp_check_stmts(then_body, quantified_fns, caller_discharges, table)
                            table <- cqp_check_stmts(else_body, quantified_fns, caller_discharges, table)
                        Stmt.While(condition, while_body, line):
                            table <- cqp_check_stmts(while_body, quantified_fns, caller_discharges, table)
                        Stmt.Block(kind, clause, binding, block_body, line):
                            table <- cqp_check_stmts(block_body, quantified_fns, caller_discharges, table)
                        Stmt.For(bind, variables, iterable, for_body, line):
                            table <- cqp_check_stmts(for_body, quantified_fns, caller_discharges, table)
                        _:
                            pass

        def cqp_check_declarations(declarations: darray[Ast::Decl], quantified_fns: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            caller_discharges: bool = cqp_body_has_quantified_fact(body)
                            table <- cqp_check_stmts(body, quantified_fns, caller_discharges, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- cqp_check_declarations(module_body, quantified_fns, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- cqp_check_declarations(scoped_body, quantified_fns, table)
                        _:
                            pass

    public:
        def check_call_quantified_precondition(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                quantified_fns: mutable darray[sview] = []
                cqp_collect(file.top_decls, quantified_fns)
                table <- cqp_check_declarations(file.top_decls, quantified_fns, table)
