# `xs[i] else FALLBACK` (subscript with an out-of-bounds fallback) yields the element type of
# `xs`, so FALLBACK must inhabit that type. A literal fallback whose kind cannot fit the element
# type (`xs[i] else false` on a `darray[int]`) is rejected. The subscript-default form parses to
# `Expr.Binary(Index(xs, i), TokenKind.Else, FALLBACK)`. SOUND subset: fires only for a
# darray-typed param/local (element known from the annotation) with a LITERAL fallback whose kind
# provably never fits the primitive element type.
extend Semantic:
    private:
        # The element type name of a `darray[T]`/`darray[T]&`/`mutable darray[T]` annotation, else "".
        def fallback_darray_element(type_expression: Ast::Expr) -> sview:
            can Memory.Allocate, Abort.Panic:
                match type_expression:
                    Expr.Index(object, index, line):
                        ident_name_of(index) return if ident_name_of(object) == "darray"
                        return sview("", 0, 0)
                    Expr.IndexN(object_n, arguments_n, line_n):
                        ident_name_of(arguments_n[0]) return if ident_name_of(object_n) == "darray" and arguments_n.count == 1
                        return sview("", 0, 0)
                    Expr.Unary(operator, operand, unary_line):
                        return fallback_darray_element(operand)
                    Expr.Paren(inner, paren_line):
                        return fallback_darray_element(inner)
                    _:
                        return sview("", 0, 0)

        def collect_fallback_darrays(statements: darray[Ast::Stmt], names: mutable darray[sview]&, elements: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |names, elements|:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            element: sview = fallback_darray_element(type_expression)
                            if element != "":
                                names.push(name)
                                elements.push(element)
                        Stmt.If(condition, then_body, else_body, line):
                            collect_fallback_darrays(then_body, names, elements)
                            collect_fallback_darrays(else_body, names, elements)
                        Stmt.While(condition, while_body, line):
                            collect_fallback_darrays(while_body, names, elements)
                        Stmt.For(bind, variables, iterable, for_body, line):
                            collect_fallback_darrays(for_body, names, elements)
                        Stmt.Block(kind, clause, binding, body, line):
                            collect_fallback_darrays(body, names, elements)
                        _:
                            pass

        def fallback_check_expression(expression: Ast::Expr, names: darray[sview]&, elements: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Binary(left, operator, right, line):
                        if operator == TokenKind.Else and left is Expr.Index(container, subscript, index_line):
                            container_name: sview = ident_name_of(container)
                            element: sview = parallel_lookup_first(names, elements, container_name)
                            fallback_kind: sview = literal_kind_of(right)
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.IndexFallbackTypeMismatch, name: "", line: line, expected: element, actual: fallback_kind, expected_count: 1}) if element != "" and fallback_kind != "" and literal_never_fits(fallback_kind, element)
                        table <- fallback_check_expression(left, names, elements, table)
                        table <- fallback_check_expression(right, names, elements, table)
                    Expr.Unary(operator, operand, unary_line):
                        table <- fallback_check_expression(operand, names, elements, table)
                    Expr.Paren(inner, paren_line):
                        table <- fallback_check_expression(inner, names, elements, table)
                    Expr.Call(callee, arguments, argument_names, call_line):
                        for argument in arguments |table| -> table:
                            table <- fallback_check_expression(argument, names, elements, table)
                    _:
                        pass

        def fallback_check_statements(statements: darray[Ast::Stmt], names: darray[sview]&, elements: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- fallback_check_expression(expression, names, elements, table)
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- fallback_check_expression(value, names, elements, table)
                        Stmt.Assign(target, operator, value, line):
                            table <- fallback_check_expression(value, names, elements, table)
                        Stmt.Return(value, line):
                            table <- fallback_check_expression(returned, names, elements, table) if value is returned
                        Stmt.If(condition, then_body, else_body, line):
                            table <- fallback_check_expression(condition, names, elements, table)
                            table <- fallback_check_statements(then_body, names, elements, table)
                            table <- fallback_check_statements(else_body, names, elements, table)
                        Stmt.While(condition, while_body, line):
                            table <- fallback_check_expression(condition, names, elements, table)
                            table <- fallback_check_statements(while_body, names, elements, table)
                        Stmt.For(bind, variables, iterable, for_body, line):
                            table <- fallback_check_statements(for_body, names, elements, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- fallback_check_statements(body, names, elements, table)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |table| -> table:
                                table <- fallback_check_statements(arm.body, names, elements, table)
                        _:
                            pass

        def fallback_walk(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            names: mutable darray[sview] = []
                            elements: mutable darray[sview] = []
                            for parameter in parameters |names, elements|:
                                parameter_element: sview = fallback_darray_element(parameter.type_expression)
                                if parameter_element != "":
                                    names.push(parameter.name)
                                    elements.push(parameter_element)
                            collect_fallback_darrays(body, names, elements)
                            table <- fallback_check_statements(body, names, elements, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- fallback_walk(module_body, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- fallback_walk(scoped_body, table)
                        _:
                            pass

    public:
        def check_index_fallback_type(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- fallback_walk(file.top_decls, table)
