# Compile-time evaluation of `static def` calls reached from a `static assert`, bounded to
# 64 nested calls (stage0's static-evaluation depth cap). A runaway/too-deep recursion
# (`static assert countdown(70) == 0`) exceeds the cap -> "static function evaluation
# exceeded 64 calls".
#
# This is a SMALL integer interpreter: int/bool literals, params, the arithmetic and
# comparison binary operators, `if`/`return`, and calls to other static functions. Anything
# outside that shape (locals, loops, a non-static call, `error(...)`, division by zero, a
# non-literal argument) marks the evaluation UNSUPPORTED and yields no diagnostic — a sound
# miss that leaves such cases to stage0. The only emitted outcome is the depth-cap breach,
# which is stage0-faithful.
extend Semantic:
    private:
        def static_lookup_index(names: darray[sview]&, wanted: sview) -> i64:
            can Abort.Panic:
                probe: mutable usize = 0
                while probe < names.count |probe, wanted, names|:
                    return probe.i64() if names[probe] == wanted
                    probe <- probe + 1
                return -1

        def static_eval_expr(all_decls: darray[Ast::Decl]&, static_fns: darray[Ast::EnumAnnotation]&, expr: Ast::Expr, pnames: darray[sview]&, pvals: darray[i64]&, counter: mutable i64&, exceeded: mutable bool&, unsupported: mutable bool&, file: Ast::File&, current_module: sview, table: SymbolTable&) -> i64:
            can Memory.Allocate, Abort.Panic:
                return 0 if:
                    exceeded == true
                    unsupported == true
                match expr:
                    Expr.IntLit(value, _):
                        return value
                    Expr.BoolLit(bool_value, _):
                        return 1 if bool_value else 0
                    Expr.Ident(name, line):
                        slot: i64 = static_lookup_index(pnames, name)
                        if slot < 0:
                            unsupported <- true
                            return 0
                        return pvals[slot.usize()]
                    Expr.Paren(inner, line):
                        return static_eval_expr(all_decls, static_fns, inner, pnames, pvals, counter, exceeded, unsupported, file, current_module, table)
                    Expr.Unary(operator, operand, line):
                        operand_value: i64 = static_eval_expr(all_decls, static_fns, operand, pnames, pvals, counter, exceeded, unsupported, file, current_module, table)
                        if operator == TokenKind.Minus:
                            negated: (known: bool, value: i64) = linear_neg_safe(operand_value)
                            if not negated.known:
                                unsupported <- true
                                return 0
                            return negated.value
                        if operator == TokenKind.Bang or operator == TokenKind.Not:
                            return 1 if operand_value == 0 else 0
                        unsupported <- true
                        return 0
                    Expr.Binary(left, operator, right, line):
                        left_value: i64 = static_eval_expr(all_decls, static_fns, left, pnames, pvals, counter, exceeded, unsupported, file, current_module, table)
                        right_value: i64 = static_eval_expr(all_decls, static_fns, right, pnames, pvals, counter, exceeded, unsupported, file, current_module, table)
                        return 0 if:
                            exceeded == true
                            unsupported == true
                        if operator == TokenKind.Plus or operator == TokenKind.Minus or operator == TokenKind.Star:
                            folded: (known: bool, value: i64) = linear_arith_safe(left_value, operator, right_value)
                            if not folded.known:
                                unsupported <- true
                                return 0
                            return folded.value
                        if operator == TokenKind.EqEq:
                            return 1 if left_value == right_value else 0
                        if operator == TokenKind.BangEq:
                            return 1 if left_value != right_value else 0
                        if operator == TokenKind.Lt:
                            return 1 if left_value < right_value else 0
                        if operator == TokenKind.Gt:
                            return 1 if left_value > right_value else 0
                        if operator == TokenKind.LtEq:
                            return 1 if left_value <= right_value else 0
                        if operator == TokenKind.GtEq:
                            return 1 if left_value >= right_value else 0
                        if operator == TokenKind.And:
                            return 1 if (left_value != 0) and (right_value != 0) else 0
                        if operator == TokenKind.Or:
                            return 1 if (left_value != 0) or (right_value != 0) else 0
                        return left_value / right_value if operator == TokenKind.Slash and right_value != 0
                        unsupported <- true
                        return 0
                    Expr.Call(callee, arguments, argument_names, call_line):
                        callee_name: mutable sview = ""
                        match callee:
                            Expr.Ident(name, _):
                                callee_name <- name
                            _:
                                pass
                        callee_index: i64 = sdr_static_fn_call_index(file, static_fns, callee_name, current_module, table) if callee_name != "" else -1
                        if callee_index < 0:
                            unsupported <- true
                            return 0
                        argument_values: mutable darray[i64] = []
                        argument_values.extend([static_eval_expr(all_decls, static_fns, argument, pnames, pvals, counter, exceeded, unsupported, file, current_module, table) for argument in arguments])
                        return 0 if:
                            exceeded == true
                            unsupported == true
                        return static_eval_call(all_decls, static_fns, callee_index, current_module, argument_values, counter, exceeded, unsupported, file, table)
                    _:
                        unsupported <- true
                        return 0

        def static_eval_stmts(all_decls: darray[Ast::Decl]&, static_fns: darray[Ast::EnumAnnotation]&, body: darray[Ast::Stmt], pnames: darray[sview]&, pvals: darray[i64]&, counter: mutable i64&, exceeded: mutable bool&, unsupported: mutable bool&, returned: mutable bool&, retval: mutable i64&, file: Ast::File&, current_module: sview, table: SymbolTable&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in body |all_decls, static_fns, pnames, pvals, counter, exceeded, unsupported, returned, retval, file, current_module, table|:
                    continue if (returned == true) or (exceeded == true) or (unsupported == true)
                    match statement:
                        Stmt.Return(value, line):
                            if value is returned_value:
                                retval <- static_eval_expr(all_decls, static_fns, returned_value, pnames, pvals, counter, exceeded, unsupported, file, current_module, table)
                            returned <- true
                        Stmt.If(condition, then_body, else_body, line):
                            condition_value: i64 = static_eval_expr(all_decls, static_fns, condition, pnames, pvals, counter, exceeded, unsupported, file, current_module, table)
                            if condition_value != 0:
                                static_eval_stmts(all_decls, static_fns, then_body, pnames, pvals, counter, exceeded, unsupported, returned, retval, file, current_module, table)
                            else:
                                static_eval_stmts(all_decls, static_fns, else_body, pnames, pvals, counter, exceeded, unsupported, returned, retval, file, current_module, table)
                        _:
                            unsupported <- true

        def static_run_func(file: Ast::File&, all_decls: darray[Ast::Decl]&, current_module: sview, static_fns: darray[Ast::EnumAnnotation]&, target_index: i64, args: darray[i64]&, counter: mutable i64&, exceeded: mutable bool&, unsupported: mutable bool&, table: SymbolTable&) -> (found: bool, value: i64):
            can Memory.Allocate, Abort.Panic:
                for declaration in all_decls |file, current_module, static_fns, target_index, args, counter, exceeded, unsupported, table|:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            if sdr_static_fn_declaration_index(static_fns, name, line, current_module) == target_index:
                                pnames: mutable darray[sview] = []
                                pnames.extend([parameter.name for parameter in params])
                                if pnames.count != args.count:
                                    unsupported <- true
                                    return (true, 0)
                                returned: mutable bool = false
                                retval: mutable i64 = 0
                                static_eval_stmts(all_decls, static_fns, body, pnames, args, counter, exceeded, unsupported, returned, retval, file, current_module, table)
                                return (true, retval)
                        Decl.Module(module_name, module_body, module_line):
                            nested: (found: bool, value: i64) = static_run_func(file, module_body, module_name, static_fns, target_index, args, counter, exceeded, unsupported, table)
                            return nested if nested.found
                        Decl.Scoped(scoped_body, scoped_line):
                            if not sdr_static_scope_is_inactive(file, scoped_line, current_module, table):
                                nested2: (found: bool, value: i64) = static_run_func(file, scoped_body, current_module, static_fns, target_index, args, counter, exceeded, unsupported, table)
                                return nested2 if nested2.found
                        _:
                            pass
                return (false, 0)

        def static_eval_call(all_decls: darray[Ast::Decl]&, static_fns: darray[Ast::EnumAnnotation]&, target_index: i64, current_module: sview, args: darray[i64]&, counter: mutable i64&, exceeded: mutable bool&, unsupported: mutable bool&, file: Ast::File&, table: SymbolTable&) -> i64:
            can Memory.Allocate, Abort.Panic:
                counter <- counter + 1
                if counter > 64:
                    exceeded <- true
                    return 0
                outcome: (found: bool, value: i64) = static_run_func(file, all_decls, current_module, static_fns, target_index, args, counter, exceeded, unsupported, table)
                unsupported <- true if not outcome.found
                return outcome.value

        def check_static_eval(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                static_fns: mutable darray[Ast::EnumAnnotation] = []
                sdr_collect_static_fn_annotations(file, static_fns, table)
                return if static_fns.count == 0
                empty_names: darray[sview] = []
                empty_vals: darray[i64] = []
                while index < file.static_assert_conds.count |table, index: usize = 0| -> table:
                    condition: Ast::Expr = file.static_assert_conds[index]
                    current_module: sview = file.static_assert_modules[index] if index < file.static_assert_modules.count else ""
                    activity: (known: bool, active: bool) = static_assert_branch_activity(file, index, current_module, table)
                    if activity.known and activity.active:
                        counter: mutable i64 = 0
                        exceeded: mutable bool = false
                        unsupported: mutable bool = false
                        discard: i64 = static_eval_expr(file.top_decls, static_fns, condition, empty_names, empty_vals, counter, exceeded, unsupported, file, current_module, table)
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.StaticEvalDepthExceeded, name: "", line: file.static_assert_lines[index], expected: "", actual: ""}) if exceeded
                    index <- index + 1
