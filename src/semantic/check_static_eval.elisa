# Compile-time evaluation of `static def` calls reached from a `static assert`, bounded to
# 64 nested calls (stage0's static-evaluation depth cap). A runaway/too-deep recursion
# (`static assert countdown(70) == 0`) exceeds the cap -> "static function evaluation
# exceeded 64 calls".
#
# This is a SMALL integer interpreter: int/bool literals, params, the arithmetic and
# comparison binary operators, `if`/`return`, and calls to other static functions. Anything
# outside that shape (locals, loops, a non-static call, `error(...)`, division by zero, a
# non-literal argument) marks the evaluation UNSUPPORTED and yields no diagnostic — a sound
# miss that leaves such cases to stage0. The only emitted outcome is the depth-cap breach,
# which is stage0-faithful.
extend Semantic:
    private:
        def static_lookup_index(names: darray[sview]&, wanted: sview) -> i64:
            can Abort.Panic:
                probe: mutable usize = 0
                while probe < names.count |probe, wanted, names|:
                    probe.i64() return if names[probe] == wanted
                    probe <- probe + 1
                return -1

        def static_eval_expr(all_decls: darray[Ast::Decl]&, static_fns: darray[sview]&, expr: Ast::Expr, pnames: darray[sview]&, pvals: darray[i64]&, counter: mutable i64&, exceeded: mutable bool&, unsupported: mutable bool&) -> i64:
            can Memory.Allocate, Abort.Panic:
                0 return if exceeded == true
                0 return if unsupported == true
                match expr:
                    Expr.IntLit(value):
                        return value
                    Expr.BoolLit(bool_value):
                        return 1 if bool_value else 0
                    Expr.Ident(name, line):
                        slot: i64 = static_lookup_index(pnames, name)
                        if slot < 0:
                            unsupported <- true
                            return 0
                        return pvals[slot.usize()]
                    Expr.Paren(inner, line):
                        return static_eval_expr(all_decls, static_fns, inner, pnames, pvals, counter, exceeded, unsupported)
                    Expr.Unary(operator, operand, line):
                        operand_value: i64 = static_eval_expr(all_decls, static_fns, operand, pnames, pvals, counter, exceeded, unsupported)
                        0 - operand_value return if operator == TokenKind.Minus
                        if operator == TokenKind.Bang or operator == TokenKind.Not:
                            return 1 if operand_value == 0 else 0
                        unsupported <- true
                        return 0
                    Expr.Binary(left, operator, right, line):
                        left_value: i64 = static_eval_expr(all_decls, static_fns, left, pnames, pvals, counter, exceeded, unsupported)
                        right_value: i64 = static_eval_expr(all_decls, static_fns, right, pnames, pvals, counter, exceeded, unsupported)
                        0 return if exceeded == true
                        0 return if unsupported == true
                        left_value + right_value return if operator == TokenKind.Plus
                        left_value - right_value return if operator == TokenKind.Minus
                        left_value * right_value return if operator == TokenKind.Star
                        if operator == TokenKind.EqEq:
                            return 1 if left_value == right_value else 0
                        if operator == TokenKind.BangEq:
                            return 1 if left_value != right_value else 0
                        if operator == TokenKind.Lt:
                            return 1 if left_value < right_value else 0
                        if operator == TokenKind.Gt:
                            return 1 if left_value > right_value else 0
                        if operator == TokenKind.LtEq:
                            return 1 if left_value <= right_value else 0
                        if operator == TokenKind.GtEq:
                            return 1 if left_value >= right_value else 0
                        if operator == TokenKind.And:
                            return 1 if (left_value != 0) and (right_value != 0) else 0
                        if operator == TokenKind.Or:
                            return 1 if (left_value != 0) or (right_value != 0) else 0
                        left_value / right_value return if operator == TokenKind.Slash and right_value != 0
                        unsupported <- true
                        return 0
                    Expr.Call(callee, arguments, argument_names, call_line):
                        callee_name: sview = ident_name_of(callee)
                        if callee_name == "" or not (any s in static_fns where s == callee_name):
                            unsupported <- true
                            return 0
                        argument_values: mutable darray[i64] = []
                        for argument in arguments |argument_values, all_decls, static_fns, pnames, pvals, counter, exceeded, unsupported|:
                            argument_values.push(static_eval_expr(all_decls, static_fns, argument, pnames, pvals, counter, exceeded, unsupported))
                        0 return if exceeded == true
                        0 return if unsupported == true
                        return static_eval_call(all_decls, static_fns, callee_name, argument_values, counter, exceeded, unsupported)
                    _:
                        unsupported <- true
                        return 0

        def static_eval_stmts(all_decls: darray[Ast::Decl]&, static_fns: darray[sview]&, body: darray[Ast::Stmt], pnames: darray[sview]&, pvals: darray[i64]&, counter: mutable i64&, exceeded: mutable bool&, unsupported: mutable bool&, returned: mutable bool&, retval: mutable i64&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in body |all_decls, static_fns, pnames, pvals, counter, exceeded, unsupported, returned, retval|:
                    continue if (returned == true) or (exceeded == true) or (unsupported == true)
                    match statement:
                        Stmt.Return(value, line):
                            if value is returned_value:
                                retval <- static_eval_expr(all_decls, static_fns, returned_value, pnames, pvals, counter, exceeded, unsupported)
                            returned <- true
                        Stmt.If(condition, then_body, else_body, line):
                            condition_value: i64 = static_eval_expr(all_decls, static_fns, condition, pnames, pvals, counter, exceeded, unsupported)
                            if condition_value != 0:
                                static_eval_stmts(all_decls, static_fns, then_body, pnames, pvals, counter, exceeded, unsupported, returned, retval)
                            else:
                                static_eval_stmts(all_decls, static_fns, else_body, pnames, pvals, counter, exceeded, unsupported, returned, retval)
                        _:
                            unsupported <- true

        def static_run_func(all_decls: darray[Ast::Decl]&, static_fns: darray[sview]&, target: sview, args: darray[i64]&, counter: mutable i64&, exceeded: mutable bool&, unsupported: mutable bool&) -> (found: bool, value: i64):
            can Memory.Allocate, Abort.Panic:
                for declaration in all_decls |all_decls, static_fns, target, args, counter, exceeded, unsupported|:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            if name == target:
                                pnames: mutable darray[sview] = []
                                for parameter in params |pnames|:
                                    pnames.push(parameter.name)
                                if pnames.count != args.count:
                                    unsupported <- true
                                    return (true, 0)
                                returned: mutable bool = false
                                retval: mutable i64 = 0
                                static_eval_stmts(all_decls, static_fns, body, pnames, args, counter, exceeded, unsupported, returned, retval)
                                return (true, retval)
                        Decl.Module(module_name, module_body, module_line):
                            nested: (found: bool, value: i64) = static_run_func(module_body, static_fns, target, args, counter, exceeded, unsupported)
                            nested return if nested.found
                        Decl.Scoped(scoped_body, scoped_line):
                            nested2: (found: bool, value: i64) = static_run_func(scoped_body, static_fns, target, args, counter, exceeded, unsupported)
                            nested2 return if nested2.found
                        _:
                            pass
                return (false, 0)

        def static_eval_call(all_decls: darray[Ast::Decl]&, static_fns: darray[sview]&, fn_name: sview, args: darray[i64]&, counter: mutable i64&, exceeded: mutable bool&, unsupported: mutable bool&) -> i64:
            can Memory.Allocate, Abort.Panic:
                counter <- counter + 1
                if counter > 64:
                    exceeded <- true
                    return 0
                outcome: (found: bool, value: i64) = static_run_func(all_decls, static_fns, fn_name, args, counter, exceeded, unsupported)
                unsupported <- true if not outcome.found
                return outcome.value

        def check_static_eval(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                static_fns: mutable darray[sview] = []
                sdr_collect_static_fns(file.enum_annotations, static_fns)
                return if static_fns.count == 0
                empty_names: darray[sview] = []
                empty_vals: darray[i64] = []
                while index < file.static_assert_conds.count |table, index: usize = 0| -> table:
                    condition: Ast::Expr = file.static_assert_conds[index]
                    counter: mutable i64 = 0
                    exceeded: mutable bool = false
                    unsupported: mutable bool = false
                    discard: i64 = static_eval_expr(file.top_decls, static_fns, condition, empty_names, empty_vals, counter, exceeded, unsupported)
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.StaticEvalDepthExceeded, name: "", line: file.static_assert_lines[index], expected: "", actual: ""}) if exceeded
                    index <- index + 1
