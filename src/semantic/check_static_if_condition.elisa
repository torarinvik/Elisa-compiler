# stage0 evaluates a `static if` condition at COMPILE TIME and rejects one it cannot fold:
# "static if condition must be a compile-time bool". stage1 never checked it at all.
#
# NARROWED to the one case a single file can decide soundly: a condition that names
# something SHADOWED by a parameter of the enclosing function. A parameter is a runtime
# value whatever const shares its spelling, so the condition provably cannot fold. A bare
# `static if SOME_FLAG` whose const lives in ANOTHER file must stay silent here -- this
# analyzer sees one file at a time, and flagging it would repeat the unknown-type
# false-positive family (see the single-file limit note). Under-reporting is a decline;
# over-reporting would reject programs stage0 accepts.

extend Semantic:
    private:
        # Declaration lines of every function, and a parallel (owning function line, parameter
        # name) table. Walks into modules and `scoped` blocks the same way the other
        # declaration checks do.
        def static_if_collect_functions(declarations: darray[Ast::Decl], function_lines: mutable darray[u32]&, param_owners: mutable darray[u32]&, param_names: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |function_lines, param_owners, param_names|:
                    match declaration:
                        Decl.Func(name, parameters, return_type, body, effects, decorators, line):
                            function_lines.push(line.line)
                            for parameter in parameters |param_owners, param_names, line|:
                                param_owners.push(line.line)
                                param_names.push(parameter.name)
                        Decl.Module(module_name, module_body, module_line):
                            static_if_collect_functions(module_body, function_lines, param_owners, param_names)
                        Decl.Scoped(scoped_body, scoped_line):
                            static_if_collect_functions(scoped_body, function_lines, param_owners, param_names)
                        _:
                            pass


        # The function that encloses `target_line`: the one with the greatest declaration line
        # at or before it. `static_if_lines` carries a line and no span, so a real containment
        # test is not available -- the nearest preceding function is the same answer for a
        # `static if` written inside a body, and 0 (no enclosing function) for one at file
        # scope, which this check then leaves alone.
        def static_if_enclosing_function_line(function_lines: darray[u32]&, target_line: u32) -> u32:
            can Abort.Panic:
                best: mutable u32 = 0
                while index < function_lines.count |index: usize = 0, best|:
                    best <- function_lines[index] if function_lines[index] <= target_line and function_lines[index] > best
                    index <- index + 1
                return best


        # Whether `name` is a parameter of the function declared at `owner_line`.
        def static_if_param_shadows(param_owners: darray[u32]&, param_names: darray[sview]&, owner_line: u32, name: sview) -> bool:
            can Abort.Panic:
                while index < param_owners.count |index: usize = 0|:
                    true return if param_owners[index] == owner_line and param_names[index] == name
                    index <- index + 1
                return false


        # The condition's name when it is a bare identifier, "" for anything else. Only the
        # bare form can be decided from a parameter list; a comparison or a call is left alone.
        def static_if_condition_ident(expression: Ast::Expr) -> sview:
            can Abort.Panic:
                match expression:
                    Expr.Ident(name, ident_line):
                        return name
                    Expr.Paren(inner, paren_line):
                        return static_if_condition_ident(inner)
                    _:
                        return ""

    public:
        def check_static_if_condition(declarations: darray[Ast::Decl], static_if_conds: darray[Ast::Expr]&, static_if_lines: darray[u32]&, static_if_kinds: darray[u32]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                function_lines: mutable darray[u32] = []
                param_owners: mutable darray[u32] = []
                param_names: mutable darray[sview] = []
                static_if_collect_functions(declarations, function_lines, param_owners, param_names)
                for row in 0..<static_if_conds.count |table, function_lines, param_owners, param_names| -> table:
                    continue if row >= static_if_lines.count or row >= static_if_kinds.count
                    # kind 2 is the `else` arm -- it carries no condition.
                    continue if static_if_kinds[row] == 2
                    condition_name: sview = static_if_condition_ident(static_if_conds[row])
                    continue if condition_name == ""
                    owner_line: u32 = static_if_enclosing_function_line(function_lines, static_if_lines[row])
                    continue if owner_line == 0
                    keyword: sview = "elif" if static_if_kinds[row] == 1 else "if"
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.StaticIfConditionNotConst, name: keyword, line: static_if_lines[row], expected: "", actual: ""}) if static_if_param_shadows(param_owners, param_names, owner_line, condition_name)
