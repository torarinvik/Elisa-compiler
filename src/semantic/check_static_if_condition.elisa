# stage0 evaluates a `static if` condition at COMPILE TIME and rejects one it cannot fold:
# "static if condition must be a compile-time bool". stage1 never checked it at all.
#
# NARROWED to the one case a single file can decide soundly: a condition that names
# something SHADOWED by a parameter of the enclosing function. A parameter is a runtime
# value whatever const shares its spelling, so the condition provably cannot fold. A bare
# `static if SOME_FLAG` whose const lives in ANOTHER file must stay silent here -- this
# analyzer sees one file at a time, and flagging it would repeat the unknown-type
# false-positive family (see the single-file limit note). Under-reporting is a decline;
# over-reporting would reject programs stage0 accepts.

extend Semantic:
    private:
        # Record the exact function that owns each statement-position static-if row. A
        # nearest-prior-function heuristic misattributes a file/module-level static-if
        # after a function, so walk the statement tree while carrying lexical ownership.
        def static_if_mark_statement_owners(statements: darray[Ast::Stmt], function_offset: u32, file: Ast::File&, row_owner_offsets: mutable darray[u32]&, row_owner_found: mutable darray[bool]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |function_offset, file, row_owner_offsets, row_owner_found|:
                    match statement:
                        Stmt.Block(kind, clause, binding, body, position):
                            if kind == "static":
                                for row in 0..<file.static_if_lines.count |row_owner_offsets, row_owner_found, file, position, function_offset|:
                                    if row < file.static_if_offsets.count and file.static_if_lines[row] == position.line and file.static_if_offsets[row] == position.offset:
                                        row_owner_offsets[row] <- function_offset
                                        row_owner_found[row] <- true
                            static_if_mark_statement_owners(body, function_offset, file, row_owner_offsets, row_owner_found)
                        Stmt.If(condition, then_body, else_body, position):
                            static_if_mark_statement_owners(then_body, function_offset, file, row_owner_offsets, row_owner_found)
                            static_if_mark_statement_owners(else_body, function_offset, file, row_owner_offsets, row_owner_found)
                        Stmt.While(condition, body, position):
                            static_if_mark_statement_owners(body, function_offset, file, row_owner_offsets, row_owner_found)
                        Stmt.For(bind, variables, iterable, body, position):
                            static_if_mark_statement_owners(body, function_offset, file, row_owner_offsets, row_owner_found)
                        Stmt.Match(scrutinee, arms, position):
                            for arm in arms |function_offset, file, row_owner_offsets, row_owner_found|:
                                static_if_mark_statement_owners(arm.body, function_offset, file, row_owner_offsets, row_owner_found)
                        _:
                            pass


        # Function bodies supply exact ownership for statement static-if rows; module and
        # declaration-level scopes are walked only to find their contained function bodies.
        def static_if_collect_function_owners(declarations: darray[Ast::Decl], file: Ast::File&, row_owner_offsets: mutable darray[u32]&, row_owner_found: mutable darray[bool]&, param_owner_offsets: mutable darray[u32]&, param_names: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |file, row_owner_offsets, row_owner_found, param_owner_offsets, param_names|:
                    match declaration:
                        Decl.Func(name, parameters, return_type, body, effects, decorators, position):
                            for parameter in parameters |param_owner_offsets, param_names, position|:
                                param_owner_offsets.push(position.offset)
                                param_names.push(parameter.name)
                            static_if_mark_statement_owners(body, position.offset, file, row_owner_offsets, row_owner_found)
                        Decl.Module(module_name, module_body, module_position):
                            static_if_collect_function_owners(module_body, file, row_owner_offsets, row_owner_found, param_owner_offsets, param_names)
                        Decl.Scoped(scoped_body, scoped_position):
                            static_if_collect_function_owners(scoped_body, file, row_owner_offsets, row_owner_found, param_owner_offsets, param_names)
                        _:
                            pass


        # Whether `name` is a parameter of the function declared at `owner_offset`.
        def static_if_param_shadows(param_owner_offsets: darray[u32]&, param_names: darray[sview]&, owner_offset: u32, name: sview) -> bool:
            can Abort.Panic:
                while index < param_owner_offsets.count |index: usize = 0|:
                    return true if param_owner_offsets[index] == owner_offset and param_names[index] == name
                    index <- index + 1
                return false


        # The condition's name when it is a bare identifier, "" for anything else. Only the
        # bare form can be decided from a parameter list; a comparison or a call is left alone.
        def static_if_condition_ident(expression: Ast::Expr) -> sview:
            can Abort.Panic:
                match expression:
                    Expr.Ident(name, ident_line):
                        return name
                    Expr.Paren(inner, paren_line):
                        return static_if_condition_ident(inner)
                    _:
                        return ""

    public:
        def check_static_if_condition(file: Ast::File&, declarations: darray[Ast::Decl], static_if_conds: darray[Ast::Expr]&, static_if_lines: darray[u32]&, static_if_offsets: darray[u32]&, static_if_kinds: darray[StaticIfBranch::Kind]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                row_owner_offsets: mutable darray[u32] = []
                row_owner_found: mutable darray[bool] = []
                param_owner_offsets: mutable darray[u32] = []
                param_names: mutable darray[sview] = []
                for row in 0..<static_if_conds.count |row_owner_offsets, row_owner_found|:
                    row_owner_offsets.push(0)
                    row_owner_found.push(false)
                static_if_collect_function_owners(declarations, file, row_owner_offsets, row_owner_found, param_owner_offsets, param_names)
                for row in 0..<static_if_conds.count |table, row_owner_offsets, row_owner_found, param_owner_offsets, param_names| -> table:
                    continue if row >= static_if_lines.count or row >= static_if_offsets.count or row >= static_if_kinds.count
                    # The fallback arm carries no condition.
                    continue if static_if_kinds[row] == StaticIfBranch::Kind.Fallback
                    condition_name: sview = static_if_condition_ident(static_if_conds[row])
                    continue if condition_name == ""
                    continue if row >= row_owner_found.count or not row_owner_found[row]
                    keyword: sview = "elif" if static_if_kinds[row] == StaticIfBranch::Kind.ChainContinuation else "if"
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.StaticIfConditionNotConst, name: keyword, line: static_if_lines[row], expected: "", actual: ""}) if static_if_param_shadows(param_owner_offsets, param_names, row_owner_offsets[row], condition_name)
