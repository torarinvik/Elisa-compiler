# Overlay unknown-field (docs/107 guest-memory overlays). A `GuestVAddr[L]` carrier reads a
# guest field by name — `carrier.field[mem]` / `carrier.field[mem, i]` (and the write form
# `carrier.field[mem] <- v`). The field must be declared in layout struct `L`; an undeclared
# name is `overlay-unknown-field`. SOUND: L's declared member set is exact, the carrier→layout
# binding comes from the param's `GuestVAddr[L]` type, and only a bare-ident carrier access is
# judged (a computed/aliased carrier is a sound miss). Width/stride/size-guard overlay checks
# need the offset+size model and are left to that engine.
extend Semantic:
    private:
        # The layout name L of a `GuestVAddr[L]` type expression, or "" when the type is not a
        # single-argument GuestVAddr carrier. Looks through mutable/paren/refinement wrappers.
        def overlay_field_carrier_layout(type_expression: Ast::Expr) -> sview:
            can Memory.Allocate, Abort.Panic:
                match type_expression:
                    Expr.Index(head, argument, index_line):
                        head_name: sview = ident_name_of(head)
                        ident_name_of(argument) return if head_name == "GuestVAddr"
                        return sview("", 0, 0)
                    Expr.Paren(inner, paren_line):
                        return overlay_field_carrier_layout(inner)
                    Expr.Unary(operator, operand, unary_line):
                        return overlay_field_carrier_layout(operand)
                    Expr.Refinement(base, predicate, refinement_line):
                        return overlay_field_carrier_layout(base)
                    _:
                        return sview("", 0, 0)

        # Whether struct LAYOUT declares a member named FIELD. Absent layout (unknown struct) →
        # true (no false positive: we only flag a field provably absent from a known layout).
        def layout_has_field(declarations: darray[Ast::Decl], layout: sview, field: sview) -> bool:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations:
                    match declaration:
                        Decl.Struct(struct_name, members, affinity, has_named_states, has_derive, invariants, struct_line):
                            (any member in members where member.name == field) return if struct_name == layout
                        Decl.Module(module_name, module_body, module_line):
                            true return if layout_has_field(module_body, layout, field)
                        Decl.Scoped(scoped_body, scoped_line):
                            true return if layout_has_field(scoped_body, layout, field)
                        _:
                            pass
                return true

        # If EXPR is a carrier field access `carrier.FIELD` whose carrier is a known GuestVAddr
        # param, flag it when FIELD is not in the carrier's layout.
        def overlay_check_field_access(object: Ast::Expr, field: sview, line: u32, carriers: darray[sview]&, layouts: darray[sview]&, declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                carrier_name: sview = ident_name_of(object)
                return if carrier_name == ""
                carrier_index: mutable usize = 0
                found: mutable bool = false
                while probe < carriers.count |probe: usize = 0, carrier_index, found|:
                    matched: bool = carriers[probe] == carrier_name
                    carrier_index <- probe if matched
                    found <- true if matched
                    probe <- probe + 1
                return if not found
                layout: sview = layouts[carrier_index]
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.OverlayUnknownField, name: field, line: line, expected: layout, actual: ""}) if not layout_has_field(declarations, layout, field)

        def overlay_walk_expression(expression: Ast::Expr, carriers: darray[sview]&, layouts: darray[sview]&, declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Field(object, field, field_line):
                        table <- overlay_check_field_access(object, field, field_line, carriers, layouts, declarations, table)
                        table <- overlay_walk_expression(object, carriers, layouts, declarations, table)
                    Expr.Index(head, argument, index_line):
                        # `carrier.field[mem]` — the guest read; judge the inner Field, then descend.
                        table <- overlay_walk_expression(head, carriers, layouts, declarations, table)
                        table <- overlay_walk_expression(argument, carriers, layouts, declarations, table)
                    Expr.IndexN(head, arguments, indexn_line):
                        table <- overlay_walk_expression(head, carriers, layouts, declarations, table)
                        for argument in arguments |table| -> table:
                            table <- overlay_walk_expression(argument, carriers, layouts, declarations, table)
                    Expr.Binary(left, operator, right, binary_line):
                        table <- overlay_walk_expression(left, carriers, layouts, declarations, table)
                        table <- overlay_walk_expression(right, carriers, layouts, declarations, table)
                    Expr.Unary(operator, operand, unary_line):
                        table <- overlay_walk_expression(operand, carriers, layouts, declarations, table)
                    Expr.Paren(inner, paren_line):
                        table <- overlay_walk_expression(inner, carriers, layouts, declarations, table)
                    Expr.Call(callee, call_arguments, argument_names, call_line):
                        for call_argument in call_arguments |table| -> table:
                            table <- overlay_walk_expression(call_argument, carriers, layouts, declarations, table)
                    _:
                        pass

        def overlay_walk_statements(statements: darray[Ast::Stmt], carriers: darray[sview]&, layouts: darray[sview]&, declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- overlay_walk_expression(value, carriers, layouts, declarations, table)
                        Stmt.Assign(target, operator, value, line):
                            table <- overlay_walk_expression(target, carriers, layouts, declarations, table)
                            table <- overlay_walk_expression(value, carriers, layouts, declarations, table)
                        Stmt.Expr(expression, line):
                            table <- overlay_walk_expression(expression, carriers, layouts, declarations, table)
                        Stmt.Return(value, line):
                            if value is returned:
                                table <- overlay_walk_expression(returned, carriers, layouts, declarations, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- overlay_walk_expression(condition, carriers, layouts, declarations, table)
                            table <- overlay_walk_statements(then_body, carriers, layouts, declarations, table)
                            table <- overlay_walk_statements(else_body, carriers, layouts, declarations, table)
                        Stmt.While(condition, body, line):
                            table <- overlay_walk_expression(condition, carriers, layouts, declarations, table)
                            table <- overlay_walk_statements(body, carriers, layouts, declarations, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- overlay_walk_statements(body, carriers, layouts, declarations, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- overlay_walk_statements(body, carriers, layouts, declarations, table)
                        _:
                            pass

        def check_overlay_field(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            carriers: mutable darray[sview] = []
                            layouts: mutable darray[sview] = []
                            for parameter in parameters |carriers, layouts|:
                                layout: sview = overlay_field_carrier_layout(parameter.type_expression)
                                if layout != "":
                                    carriers.push(parameter.name)
                                    layouts.push(layout)
                            table <- overlay_walk_statements(body, carriers, layouts, declarations, table) if carriers.count > 0
                        Decl.Module(module_name, module_body, module_line):
                            table <- check_overlay_field(module_body, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- check_overlay_field(scoped_body, table)
                        _:
                            pass
