# Mutable-view slice provenance checks and the local type context they need.
extend Semantic:
    private:
        # Collect a namespace path while allowing harmless parentheses around any segment.
        # A value-local at the head still shadows a module; callers check that before using
        # the resulting path to classify a global or type alias.
        def mv_collect_scope_path(expression: Ast::Expr, segments: mutable darray[sview]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Ident(name, _):
                        segments.push(name)
                        return true
                    Expr.Scope(base, name, _):
                        return false if not mv_collect_scope_path(base, segments)
                        segments.push(name)
                        return true
                    Expr.Paren(inner, _):
                        return mv_collect_scope_path(inner, segments)
                    _:
                        return false


        def mv_scope_path(expression: Ast::Expr, table: lmut SymbolTable) -> (valid: bool, path: sview @source, head: sview @source):
            can Memory.Allocate, Abort.Panic:
                segments: mutable darray[sview] = []
                return (false, "", "") if not mv_collect_scope_path(expression, segments)
                return (false, "", "") if segments.count == 0
                separators: mutable darray[bool] = []
                for _ in 1..<segments.count |separators|:
                    separators.push(false)
                rebind path: sview @source, table = type_path_text(segments, 0, segments.count, separators, segments.count, table)
                return (path != "", path, segments[0])


        def mv_qualified_owner_matches(owner: sview, path: sview @source, current_module: sview, before_offset: u32, table: SymbolTable&) -> bool:
            can Abort.Panic:
                alias_head: (known: bool, found: bool) = semantic_possible_import_alias_target_head_status(path, current_module, before_offset, table)
                return false if not alias_head.known
                return semantic_possible_import_alias_target_alias_matches(owner, path, current_module, before_offset, table) if alias_head.found
                return semantic_import_module_path_matches(owner, path, current_module)


        def mv_struct_owner(type_expression: Ast::Expr, current_module: sview, table: SymbolTable&, depth: u32 = 0) -> (found: bool, name: sview, module_owner: sview):
            can Memory.Allocate, Abort.Panic:
                return (false, "", "") if depth > table.type_alias_declarations.count.u32()
                match type_expression:
                    Expr.Paren(inner, _) | Expr.Unary(_, inner, _):
                        return mv_struct_owner(inner, current_module, table, depth + 1.u32())
                    Expr.Index(head, _, _) | Expr.IndexN(head, _, _):
                        return mv_struct_owner(head, current_module, table, depth + 1.u32())
                    Expr.Ident(name, _):
                        selected: usize = table.symbols.count
                        selected_count: usize = 0
                        fallback: usize = table.symbols.count
                        fallback_count: usize = 0
                        external: usize = table.symbols.count
                        external_count: usize = 0
                        for index in 0..<table.symbols.count |selected, selected_count, fallback, fallback_count, external, external_count, name, current_module, table|:
                            symbol: Symbol = table.symbols[index]
                            continue if symbol.kind != SymbolKind.Struct or symbol.name != name
                            if symbol.module_owner == current_module:
                                selected <- index
                                selected_count <- selected_count + 1
                            elif symbol.module_owner == "":
                                fallback <- index
                                fallback_count <- fallback_count + 1
                            else:
                                external <- index
                                external_count <- external_count + 1
                        if selected_count == 1:
                            return (true, name, table.symbols[selected].module_owner)
                        if selected_count > 1:
                            return (false, "", "")
                        if fallback_count == 1:
                            return (true, name, table.symbols[fallback].module_owner)
                        if fallback_count > 1 or external_count > 1:
                            return (false, "", "")
                        if external_count == 1:
                            return (true, name, table.symbols[external].module_owner)
                        alias: (found: bool, target: Ast::Expr, module_owner: sview) = mv_type_alias_target(type_expression, current_module, table, depth)
                        return mv_struct_owner(alias.target, alias.module_owner, table, depth + 1.u32()) if alias.found
                        return (false, "", "")
                    Expr.Scope(base, name, position):
                        qualifier: (valid: bool, path: sview @source, head: sview @source) = mv_scope_path(base, table)
                        return (false, "", "") if not qualifier.valid
                        selected: usize = table.symbols.count
                        selected_count: usize = 0
                        for index in 0..<table.symbols.count |selected, selected_count, qualifier, position, current_module, name, table|:
                            symbol: Symbol = table.symbols[index]
                            continue if symbol.kind != SymbolKind.Struct or symbol.name != name
                            if mv_qualified_owner_matches(symbol.module_owner, qualifier.path, current_module, position.offset, table):
                                selected <- index
                                selected_count <- selected_count + 1
                        if selected_count == 1:
                            return (true, name, table.symbols[selected].module_owner)
                        return (false, "", "") if selected_count > 1
                        alias: (found: bool, target: Ast::Expr, module_owner: sview) = mv_type_alias_target(type_expression, current_module, table, depth)
                        return mv_struct_owner(alias.target, alias.module_owner, table, depth + 1.u32()) if alias.found
                        return (false, "", "")
                    _:
                        return (false, "", "")


        def mv_type_alias_target(expression: Ast::Expr, current_module: sview, table: SymbolTable&, depth: u32 = 0) -> (found: bool, target: Ast::Expr, module_owner: sview):
            can Abort.Panic:
                return (false, Expr.Absent, "") if depth > table.type_alias_declarations.count.u32()
                match expression:
                    Expr.Ident(name, _):
                        selected: usize = table.type_alias_declarations.count
                        selected_count: usize = 0
                        fallback: usize = table.type_alias_declarations.count
                        fallback_count: usize = 0
                        for index in 0..<table.type_alias_declarations.count |selected, selected_count, fallback, fallback_count, name, current_module, table|:
                            declaration: TypeAliasDeclaration = table.type_alias_declarations[index]
                            symbol: Symbol = table.symbols[declaration.declaration_id.value.usize()]
                            continue if symbol.kind != SymbolKind.Alias or symbol.name != name
                            if declaration.module_owner == current_module:
                                selected <- index
                                selected_count <- selected_count + 1
                            elif declaration.module_owner == "":
                                fallback <- index
                                fallback_count <- fallback_count + 1
                        if selected_count == 1:
                            return (true, table.type_alias_declarations[selected].target, table.type_alias_declarations[selected].module_owner)
                        return (false, Expr.Absent, "") if selected_count > 1
                        return (true, table.type_alias_declarations[fallback].target, table.type_alias_declarations[fallback].module_owner) if fallback_count == 1
                        return (false, Expr.Absent, "")
                    Expr.Scope(base, name, position):
                        qualifier: (valid: bool, path: sview @source, head: sview @source) = mv_scope_path(base, table)
                        return (false, Expr.Absent, "") if not qualifier.valid
                        selected: usize = table.type_alias_declarations.count
                        selected_count: usize = 0
                        for index in 0..<table.type_alias_declarations.count |selected, selected_count, qualifier, position, current_module, name, table|:
                            declaration: TypeAliasDeclaration = table.type_alias_declarations[index]
                            symbol: Symbol = table.symbols[declaration.declaration_id.value.usize()]
                            continue if symbol.kind != SymbolKind.Alias or symbol.name != name
                            if mv_qualified_owner_matches(declaration.module_owner, qualifier.path, current_module, position.offset, table):
                                selected <- index
                                selected_count <- selected_count + 1
                        return (false, Expr.Absent, "") if selected_count != 1
                        return (true, table.type_alias_declarations[selected].target, table.type_alias_declarations[selected].module_owner)
                    _:
                        return (false, Expr.Absent, "")


        def mv_type_index_is_extent(argument: Ast::Expr, table: SymbolTable&) -> bool:
            can Abort.Panic:
                match argument:
                    Expr.IntLit(_, _):
                        return true
                    Expr.Ident(name, _):
                        return annotation_extent_names_constant(name, table)
                    Expr.Scope(_, name, _):
                        return annotation_extent_names_constant(name, table)
                    Expr.Paren(inner, _):
                        return mv_type_index_is_extent(inner, table)
                    _:
                        return false


        # Type shape of one indexing step. Mutable storage on the outer container does
        # not make a nested readonly view writable; mutability comes from the element type.
        def mv_type_element(expression: Ast::Expr, current_module: sview, table: lmut SymbolTable, depth: u32 = 0) -> (found: bool, element: Ast::Expr):
            can Memory.Allocate, Abort.Panic:
                return (false, Expr.Absent) if depth > table.type_alias_declarations.count.u32()
                match expression:
                    Expr.Paren(inner, _) | Expr.Unary(_, inner, _):
                        return mv_type_element(inner, current_module, table, depth + 1.u32())
                    Expr.Index(head, argument, _):
                        return (true, head) if mv_type_index_is_extent(argument, table)
                        return (true, argument)
                    Expr.IndexN(_, arguments, _):
                        return (false, Expr.Absent) if arguments.count == 0
                        head_family: sview = mv_type_family(expression, current_module, table, depth + 1.u32())
                        return (false, Expr.Absent) if head_family == "dict" and arguments.count < 2
                        return (true, arguments[1]) if head_family == "dict"
                        return (true, arguments[0])
                    Expr.Ident(_, _) | Expr.Scope(_, _, _):
                        alias: (found: bool, target: Ast::Expr, module_owner: sview) = mv_type_alias_target(expression, current_module, table, depth)
                        return mv_type_element(alias.target, alias.module_owner, table, depth + 1.u32()) if alias.found
                        return (false, Expr.Absent)
                    _:
                        return (false, Expr.Absent)


        # Keep the declaring module paired with an element type extracted from an
        # aliased container. The AST alone is insufficient when the element names
        # another alias that is only visible in the container alias's module.
        def mv_type_element_owner(expression: Ast::Expr, current_module: sview, table: SymbolTable&, depth: u32 = 0) -> sview:
            can Abort.Panic:
                return "" if depth > table.type_alias_declarations.count.u32()
                match expression:
                    Expr.Paren(inner, _) | Expr.Unary(_, inner, _):
                        return mv_type_element_owner(inner, current_module, table, depth + 1.u32())
                    Expr.Index(_, _, _) | Expr.IndexN(_, _, _):
                        return current_module
                    Expr.Ident(_, _) | Expr.Scope(_, _, _):
                        alias: (found: bool, target: Ast::Expr, module_owner: sview) = mv_type_alias_target(expression, current_module, table, depth)
                        return mv_type_element_owner(alias.target, alias.module_owner, table, depth + 1.u32()) if alias.found
                        return ""
                    _:
                        return ""


        def mv_type_tuple_elements(expression: Ast::Expr, current_module: sview, table: SymbolTable&, depth: u32 = 0) -> (found: bool, elements: darray[Ast::Expr], module_owner: sview):
            can Abort.Panic:
                return (false, [], "") if depth > table.type_alias_declarations.count.u32()
                match expression:
                    Expr.Paren(inner, _):
                        return mv_type_tuple_elements(inner, current_module, table, depth + 1.u32())
                    Expr.Tuple(elements, _):
                        return (true, elements, current_module)
                    Expr.Ident(_, _) | Expr.Scope(_, _, _):
                        alias: (found: bool, target: Ast::Expr, module_owner: sview) = mv_type_alias_target(expression, current_module, table, depth)
                        return mv_type_tuple_elements(alias.target, alias.module_owner, table, depth + 1.u32()) if alias.found
                        return (false, [], "")
                    _:
                        return (false, [], "")


        def mv_type_alias_root(expression: Ast::Expr, current_module: sview, table: SymbolTable&, depth: u32 = 0) -> (type_expression: Ast::Expr, module_owner: sview):
            can Abort.Panic:
                return (expression, current_module) if depth > table.type_alias_declarations.count.u32()
                match expression:
                    Expr.Paren(inner, _):
                        return mv_type_alias_root(inner, current_module, table, depth + 1.u32())
                    Expr.Ident(_, _) | Expr.Scope(_, _, _):
                        alias: (found: bool, target: Ast::Expr, module_owner: sview) = mv_type_alias_target(expression, current_module, table, depth)
                        return mv_type_alias_root(alias.target, alias.module_owner, table, depth + 1.u32()) if alias.found
                        return (expression, current_module)
                    _:
                        return (expression, current_module)


        # Type aliases retain their complete target AST. Resolve just the container heads
        # needed by this check, following aliases in their declaring module and bounding the
        # walk by the number of collected aliases so malformed cycles fail closed.
        def mv_type_family(expression: Ast::Expr, current_module: sview, table: lmut SymbolTable, depth: u32 = 0) -> sview @source:
            can Memory.Allocate, Abort.Panic:
                return "" if depth > table.type_alias_declarations.count.u32()
                match expression:
                    Expr.Paren(inner, _):
                        return mv_type_family(inner, current_module, table, depth + 1.u32())
                    Expr.Unary(operator, operand, _):
                        inner_family: sview = mv_type_family(operand, current_module, table, depth + 1.u32())
                        if operator == TokenKind.Mutable:
                            return "mutable_array" if inner_family == "array" or inner_family == "mutable_array"
                            return "mutable_darray" if inner_family == "darray" or inner_family == "mutable_darray"
                            return "mutable_view" if inner_family == "view" or inner_family == "mutable_view"
                            return "mutable_set" if inner_family == "set" or inner_family == "mutable_set"
                            return "mutable_dict" if inner_family == "dict" or inner_family == "mutable_dict"
                        return inner_family if operator == TokenKind.Ampersand or operator == TokenKind.Lmut or operator == TokenKind.Static or operator == TokenKind.Heap or operator == TokenKind.Stack or operator == TokenKind.Tail or operator == TokenKind.Question
                        return ""
                    Expr.Index(head, argument, _):
                        return "array" if mv_type_index_is_extent(argument, table)
                        return mv_type_family(head, current_module, table, depth + 1.u32())
                    Expr.IndexN(head, _, _):
                        return mv_type_family(head, current_module, table, depth + 1.u32())
                    Expr.Ident(name, _):
                        return name if name == "array" or name == "darray" or name == "view" or name == "set" or name == "dict" or name == "mutable_array" or name == "mutable_darray" or name == "mutable_view" or name == "mutable_set" or name == "mutable_dict"
                        selected: usize = table.type_alias_declarations.count
                        selected_count: usize = 0
                        fallback: usize = table.type_alias_declarations.count
                        fallback_count: usize = 0
                        for index in 0..<table.type_alias_declarations.count |selected, selected_count, fallback, fallback_count, name, current_module, table|:
                            declaration: TypeAliasDeclaration = table.type_alias_declarations[index]
                            symbol: Symbol = table.symbols[declaration.declaration_id.value.usize()]
                            continue if symbol.kind != SymbolKind.Alias or symbol.name != name
                            if declaration.module_owner == current_module:
                                selected <- index
                                selected_count <- selected_count + 1
                            elif declaration.module_owner == "":
                                fallback <- index
                                fallback_count <- fallback_count + 1
                        if selected_count == 1:
                            alias: TypeAliasDeclaration = table.type_alias_declarations[selected]
                            return mv_type_family(alias.target, alias.module_owner, table, depth + 1.u32())
                        return "" if selected_count > 1
                        if fallback_count == 1:
                            alias: TypeAliasDeclaration = table.type_alias_declarations[fallback]
                            return mv_type_family(alias.target, alias.module_owner, table, depth + 1.u32())
                        return ""
                    Expr.Scope(base, name, position):
                        qualifier: (valid: bool, path: sview @source, head: sview @source) = mv_scope_path(base, table)
                        return "" if not qualifier.valid
                        selected: usize = table.type_alias_declarations.count
                        selected_count: usize = 0
                        for index in 0..<table.type_alias_declarations.count |selected, selected_count, qualifier, position, current_module, name, table|:
                            declaration: TypeAliasDeclaration = table.type_alias_declarations[index]
                            symbol: Symbol = table.symbols[declaration.declaration_id.value.usize()]
                            continue if symbol.kind != SymbolKind.Alias or symbol.name != name
                            if mv_qualified_owner_matches(declaration.module_owner, qualifier.path, current_module, position.offset, table):
                                selected <- index
                                selected_count <- selected_count + 1
                        return "" if selected_count != 1
                        alias: TypeAliasDeclaration = table.type_alias_declarations[selected]
                        return mv_type_family(alias.target, alias.module_owner, table, depth + 1.u32())
                    _:
                        return ""


        def mv_global_row_is_immutable(row: usize, table: SymbolTable&) -> bool:
            can Abort.Panic:
                return any immutable_row in table.immutable_const_rows where immutable_row == row.u32()


        def mv_global_symbol_has_writable_container(symbol: Symbol, table: SymbolTable&) -> bool:
            can Abort.Panic:
                type_id: u32 = symbol.return_type_id
                return false if interned_kind(type_id, table) != SemTypeKind.Container
                # Global binding mutability grants access to array/darray storage. A
                # global whose declared value is a readonly view remains readonly even
                # when the binding itself can be reassigned.
                head: sview = interned_name(type_id, table)
                return head == "array" or head == "darray"


        def mv_unqualified_global_is_writable(name: sview, current_module: sview, table: SymbolTable&) -> bool:
            can Abort.Panic:
                current_row: usize = table.symbols.count
                current_count: usize = 0
                root_row: usize = table.symbols.count
                root_count: usize = 0
                for index in 0..<table.symbols.count |current_row, current_count, root_row, root_count, name, current_module, table|:
                    symbol: Symbol = table.symbols[index]
                    continue if symbol.kind != SymbolKind.Const or symbol.name != name
                    if symbol.module_owner == current_module:
                        current_row <- index
                        current_count <- current_count + 1
                    elif symbol.module_owner == "":
                        root_row <- index
                        root_count <- root_count + 1
                if current_count > 0:
                    return current_count == 1 and not mv_global_row_is_immutable(current_row, table) and mv_global_symbol_has_writable_container(table.symbols[current_row], table)
                return root_count == 1 and not mv_global_row_is_immutable(root_row, table) and mv_global_symbol_has_writable_container(table.symbols[root_row], table)


        def mv_qualified_global_is_writable(base: Ast::Expr, name: sview, position: Ast::Pos, current_module: sview, var_types: darray[sview]&, table: lmut SymbolTable) -> bool:
            can Memory.Allocate, Abort.Panic:
                qualifier: (valid: bool, path: sview @source, head: sview @source) = mv_scope_path(base, table)
                return false if not qualifier.valid or any local_name in var_types where local_name == qualifier.head
                matches: usize = 0
                selected_row: usize = table.symbols.count
                for index in 0..<table.symbols.count |matches, selected_row, qualifier, name, current_module, position, table|:
                    symbol: Symbol = table.symbols[index]
                    continue if symbol.kind != SymbolKind.Const or symbol.name != name
                    if mv_qualified_owner_matches(symbol.module_owner, qualifier.path, current_module, position.offset, table):
                        matches <- matches + 1
                        selected_row <- index
                return matches == 1 and not mv_global_row_is_immutable(selected_row, table) and mv_global_symbol_has_writable_container(table.symbols[selected_row], table)


        def mv_projected_type(source: Ast::Expr, current_module: sview, table: lmut SymbolTable, var_types: darray[sview]&, type_names: darray[sview @source]&, type_expressions: darray[Ast::Expr]&, expression_names: darray[sview]&, declarations: darray[Ast::Decl], depth: u32 = 0) -> (found: bool, type_expression: Ast::Expr, module_owner: sview):
            can Memory.Allocate, Abort.Panic:
                return (false, Expr.Absent, "") if depth > 64
                match source:
                    Expr.Paren(inner, _) | Expr.Move(inner, _):
                        return mv_projected_type(inner, current_module, table, var_types, type_names, type_expressions, expression_names, declarations, depth + 1.u32())
                    Expr.Ident(name, _):
                        while index > 0 |index: usize = expression_names.count|:
                            index <- index - 1
                            return (true, type_expressions[index], current_module) if expression_names[index] == name
                        global_type: (found: bool, type_expression: Ast::Expr, module_owner: sview) = mv_global_const_type(source, declarations, current_module, expression_names, table)
                        return global_type if global_type.found
                        return (false, Expr.Absent, "")
                    Expr.Scope(_, _, _):
                        return mv_global_const_type(source, declarations, current_module, expression_names, table)
                    Expr.Index(object, _, _):
                        parent: (found: bool, type_expression: Ast::Expr, module_owner: sview) = mv_projected_type(object, current_module, table, var_types, type_names, type_expressions, expression_names, declarations, depth + 1.u32())
                        return (false, Expr.Absent, "") if not parent.found
                        selected: (found: bool, element: Ast::Expr) = mv_type_element(parent.type_expression, parent.module_owner, table)
                        return (false, Expr.Absent, "") if not selected.found
                        return (true, selected.element, mv_type_element_owner(parent.type_expression, parent.module_owner, table))
                    Expr.IndexN(object, indices, _):
                        parent: (found: bool, type_expression: Ast::Expr, module_owner: sview) = mv_projected_type(object, current_module, table, var_types, type_names, type_expressions, expression_names, declarations, depth + 1.u32())
                        return (false, Expr.Absent, "") if not parent.found or indices.count == 0
                        projected_type: Ast::Expr = parent.type_expression
                        projected_module: mutable sview = parent.module_owner
                        for _ in indices |projected_type, projected_module, table|:
                            selected: (found: bool, element: Ast::Expr) = mv_type_element(projected_type, projected_module, table)
                            return (false, Expr.Absent, "") if not selected.found
                            projected_module <- mv_type_element_owner(projected_type, projected_module, table)
                            projected_type <- selected.element
                        return (true, projected_type, projected_module)
                    Expr.Field(object, field, _):
                        owner_type: (found: bool, type_expression: Ast::Expr, module_owner: sview) = mv_projected_type(object, current_module, table, var_types, type_names, type_expressions, expression_names, declarations, depth + 1.u32())
                        return (false, Expr.Absent, "") if not owner_type.found
                        struct_owner: (found: bool, name: sview, module_owner: sview) = mv_struct_owner(owner_type.type_expression, owner_type.module_owner, table)
                        return (false, Expr.Absent, "") if not struct_owner.found
                        field_row: mutable i64 = -1
                        for index in 0..<table.struct_field_owner.count |field_row, struct_owner, field, table|:
                            if table.struct_field_owner[index] == struct_owner.name and table.struct_field_name[index] == field and struct_field_module_at(table, index) == struct_owner.module_owner:
                                field_row <- index.i64()
                                break
                        return (false, Expr.Absent, "") if field_row < 0 or field_row.usize() >= table.private_field_types.count
                        field_module: sview = struct_field_module_at(table, field_row.usize())
                        return (true, table.private_field_types[field_row.usize()], field_module)
                    _:
                        return (false, Expr.Absent, "")


        def mv_note_iterable_element_binding(binding: sview @source, iterable: Ast::Expr, current_module: sview, table: lmut SymbolTable, var_types: mutable darray[sview]&, type_names: mutable darray[sview @source]&, type_expressions: mutable darray[Ast::Expr]&, expression_names: mutable darray[sview]&, declarations: darray[Ast::Decl]) -> void:
            can Memory.Allocate, Abort.Panic:
                iterable_type: (found: bool, type_expression: Ast::Expr, module_owner: sview) = mv_projected_type(iterable, current_module, table, var_types, type_names, type_expressions, expression_names, declarations)
                match iterable:
                    Expr.Slice(object, _, _, _):
                        iterable_type <- mv_projected_type(object, current_module, table, var_types, type_names, type_expressions, expression_names, declarations)
                    _:
                        pass
                element_type: (found: bool, type_expression: Ast::Expr) = mv_type_element(iterable_type.type_expression, iterable_type.module_owner, table) if iterable_type.found else (false, Expr.Absent)
                element_module: sview = mv_type_element_owner(iterable_type.type_expression, iterable_type.module_owner, table) if element_type.found else iterable_type.module_owner
                normalized_element: (type_expression: Ast::Expr, module_owner: sview) = mv_type_alias_root(element_type.type_expression, element_module, table) if element_type.found else (Expr.Absent, element_module)
                type_name: sview = "__firm_scope_binder__"
                if element_type.found:
                    type_family: sview = mv_type_family(normalized_element.type_expression, normalized_element.module_owner, table)
                    type_name <- type_family if type_family == "array" or type_family == "mutable_array" or type_family == "darray" or type_family == "mutable_darray" or type_family == "view" or type_family == "mutable_view" else bare_type_name_through_ref(normalized_element.type_expression)
                note_local_type(var_types, type_names, binding, type_name)
                type_expressions.push(normalized_element.type_expression if element_type.found else Expr.Absent)
                expression_names.push(binding)
                if element_type.found:
                    note_field_assign_local_type_id(binding, normalized_element.type_expression, table) can Global{Read,Write}
                else:
                    note_local_type_id_direct(binding, 0, table)


        def mv_source_is_writable(source: Ast::Expr, current_module: sview, table: lmut SymbolTable, var_types: darray[sview]&, type_names: darray[sview @source]&, type_expressions: darray[Ast::Expr]&, expression_names: darray[sview]&, declarations: darray[Ast::Decl]) -> bool:
            can Memory.Allocate, Abort.Panic:
                match source:
                    Expr.Paren(inner, _) | Expr.Move(inner, _):
                        return mv_source_is_writable(inner, current_module, table, var_types, type_names, type_expressions, expression_names, declarations)
                    Expr.Ident(name, _):
                        if any local_name in var_types where local_name == name:
                            source_family: sview = mv_type_family(Expr.Ident(local_type_of(var_types, type_names, name), Ast::pos_at_line(0)), current_module, table)
                            return source_family == "mutable_array" or source_family == "mutable_darray" or source_family == "mutable_view"
                        return mv_unqualified_global_is_writable(name, current_module, table)
                    Expr.Scope(base, name, position):
                        return mv_qualified_global_is_writable(base, name, position, current_module, var_types, table)
                    Expr.Index(_, _, _) | Expr.IndexN(_, _, _):
                        projected: (found: bool, type_expression: Ast::Expr, module_owner: sview) = mv_projected_type(source, current_module, table, var_types, type_names, type_expressions, expression_names, declarations)
                        return false if not projected.found
                        projected_family: sview = mv_type_family(projected.type_expression, projected.module_owner, table)
                        return projected_family == "mutable_array" or projected_family == "mutable_darray" or projected_family == "mutable_view"
                    Expr.Field(object, field, _):
                        projected: (found: bool, type_expression: Ast::Expr, module_owner: sview) = mv_projected_type(source, current_module, table, var_types, type_names, type_expressions, expression_names, declarations)
                        return false if not projected.found
                        field_family: sview = mv_type_family(projected.type_expression, projected.module_owner, table)
                        return field_family == "mutable_array" or field_family == "mutable_darray" or field_family == "mutable_view"
                    _:
                        return false


        def mv_value_is_known_mutable_view(value: Ast::Expr, current_module: sview, table: lmut SymbolTable, var_types: darray[sview]&, type_names: darray[sview @source]&, type_expressions: darray[Ast::Expr]&, expression_names: darray[sview]&, declarations: darray[Ast::Decl], depth: u32 = 0) -> bool:
            can Memory.Allocate, Abort.Panic:
                return false if depth > 64
                match value:
                    Expr.Paren(inner, _) | Expr.Move(inner, _):
                        return mv_value_is_known_mutable_view(inner, current_module, table, var_types, type_names, type_expressions, expression_names, declarations, depth + 1.u32())
                    Expr.Ident(name, _):
                        return false if not any local_name in var_types where local_name == name
                        family: sview = mv_type_family(Expr.Ident(local_type_of(var_types, type_names, name), Ast::pos_at_line(0)), current_module, table)
                        return family == "mutable_view"
                    Expr.Field(_, _, _) | Expr.Index(_, _, _) | Expr.IndexN(_, _, _):
                        projected: (found: bool, type_expression: Ast::Expr, module_owner: sview) = mv_projected_type(value, current_module, table, var_types, type_names, type_expressions, expression_names, declarations)
                        return projected.found and mv_type_family(projected.type_expression, projected.module_owner, table) == "mutable_view"
                    Expr.If(_, then_value, else_value, _):
                        return mv_value_is_known_mutable_view(then_value, current_module, table, var_types, type_names, type_expressions, expression_names, declarations, depth + 1.u32()) and mv_value_is_known_mutable_view(else_value, current_module, table, var_types, type_names, type_expressions, expression_names, declarations, depth + 1.u32())
                    _:
                        return false


        def mv_value_is_known_readonly_view(value: Ast::Expr, current_module: sview, table: lmut SymbolTable, var_types: darray[sview]&, type_names: darray[sview @source]&, type_expressions: darray[Ast::Expr]&, expression_names: darray[sview]&, declarations: darray[Ast::Decl]) -> bool:
            can Memory.Allocate, Abort.Panic:
                match value:
                    Expr.Ident(name, _):
                        return false if not any local_name in var_types where local_name == name
                        local_type_name: sview = local_type_of(var_types, type_names, name)
                        return mv_type_family(Expr.Ident(local_type_name, Ast::pos_at_line(0)), current_module, table) == "view"
                    _:
                        pass
                projected: (found: bool, type_expression: Ast::Expr, module_owner: sview) = mv_projected_type(value, current_module, table, var_types, type_names, type_expressions, expression_names, declarations)
                return projected.found and mv_type_family(projected.type_expression, projected.module_owner, table) == "view"


        def mv_value_slice_sources_writable(value: Ast::Expr, current_module: sview, table: lmut SymbolTable, var_types: mutable darray[sview]&, type_names: mutable darray[sview @source]&, type_expressions: mutable darray[Ast::Expr]&, expression_names: mutable darray[sview]&, declarations: darray[Ast::Decl], depth: u32 = 0) -> (has_slice: bool, writable: bool):
            can Memory.Allocate, Abort.Panic:
                return (false, false) if depth > 64
                match value:
                    Expr.Paren(inner, _) | Expr.Move(inner, _):
                        return mv_value_slice_sources_writable(inner, current_module, table, var_types, type_names, type_expressions, expression_names, declarations, depth + 1.u32())
                    Expr.Slice(source, _, _, _):
                        return (true, mv_source_is_writable(source, current_module, table, var_types, type_names, type_expressions, expression_names, declarations))
                    Expr.If(_, then_value, else_value, _):
                        then_result: (has_slice: bool, writable: bool) = mv_value_slice_sources_writable(then_value, current_module, table, var_types, type_names, type_expressions, expression_names, declarations, depth + 1.u32())
                        else_result: (has_slice: bool, writable: bool) = mv_value_slice_sources_writable(else_value, current_module, table, var_types, type_names, type_expressions, expression_names, declarations, depth + 1.u32())
                        return (then_result.has_slice or else_result.has_slice, (not then_result.has_slice or then_result.writable) and (not else_result.has_slice or else_result.writable))
                    Expr.Block(statements, block_value, _, _):
                        scope_mark: usize = var_types.count
                        expression_mark: usize = type_expressions.count
                        for statement in statements |table|:
                            match statement:
                                Stmt.VarDecl(local_name, type_expression, _, _):
                                    type_family: sview = mv_type_family(type_expression, current_module, table)
                                    type_name: sview = type_family if type_family == "array" or type_family == "mutable_array" or type_family == "darray" or type_family == "mutable_darray" or type_family == "view" or type_family == "mutable_view" else bare_type_name_through_ref(type_expression)
                                    note_local_type(var_types, type_names, local_name, type_name)
                                    type_expressions.push(type_expression)
                                    expression_names.push(local_name)
                                    note_field_assign_local_type_id(local_name, type_expression, table) can Global{Read,Write}
                                _:
                                    pass
                        result: (has_slice: bool, writable: bool) = mv_value_slice_sources_writable(block_value, current_module, table, var_types, type_names, type_expressions, expression_names, declarations, depth + 1.u32())
                        close_type_scope(scope_mark, var_types, type_names, table)
                        type_expressions.truncate(expression_mark)
                        expression_names.truncate(expression_mark)
                        return result
                    Expr.Match(_, arms, _) | Expr.Catch(_, arms, _):
                        has_slice: mutable bool = false
                        all_writable: mutable bool = true
                        for arm in arms |has_slice, all_writable, current_module, table, var_types, type_names, type_expressions, expression_names, depth|:
                            arm_result: (has_slice: bool, writable: bool) = (false, false)
                            arm_scope_mark: usize = var_types.count
                            arm_expression_mark: usize = type_expressions.count
                            arm_bindings: mutable darray[sview @source] = []
                            collect_pattern_binding_names(arm.pattern, arm_bindings)
                            for binding_name in arm_bindings |table|:
                                note_local_type(var_types, type_names, binding_name, "__firm_scope_binder__")
                                type_expressions.push(Expr.Absent)
                                expression_names.push(binding_name)
                                note_local_type_id_direct(binding_name, 0, table)
                            if arm.body.count > 0:
                                statement_index: usize = 0
                                while statement_index + 1.usize() < arm.body.count |statement_index, current_module, table, var_types, type_names, type_expressions, expression_names|:
                                    match arm.body[statement_index]:
                                        Stmt.VarDecl(local_name, type_expression, _, _):
                                            type_family: sview = mv_type_family(type_expression, current_module, table)
                                            type_name: sview = type_family if type_family == "array" or type_family == "mutable_array" or type_family == "darray" or type_family == "mutable_darray" or type_family == "view" or type_family == "mutable_view" else bare_type_name_through_ref(type_expression)
                                            note_local_type(var_types, type_names, local_name, type_name)
                                            type_expressions.push(type_expression)
                                            expression_names.push(local_name)
                                            note_field_assign_local_type_id(local_name, type_expression, table) can Global{Read,Write}
                                        _:
                                            pass
                                    statement_index <- statement_index + 1.usize()
                                match arm.body[arm.body.count - 1.usize()]:
                                    Stmt.Expr(arm_value, _):
                                        arm_result <- mv_value_slice_sources_writable(arm_value, current_module, table, var_types, type_names, type_expressions, expression_names, declarations, depth + 1.u32())
                                    _:
                                        pass
                            close_type_scope(arm_scope_mark, var_types, type_names, table)
                            type_expressions.truncate(arm_expression_mark)
                            expression_names.truncate(arm_expression_mark)
                            has_slice <- has_slice or arm_result.has_slice
                            all_writable <- all_writable and (not arm_result.has_slice or arm_result.writable)
                        return (has_slice, all_writable)
                    _:
                        known_mutable: bool = mv_value_is_known_mutable_view(value, current_module, table, var_types, type_names, type_expressions, expression_names, declarations, depth + 1.u32())
                        known_readonly: bool = mv_value_is_known_readonly_view(value, current_module, table, var_types, type_names, type_expressions, expression_names, declarations)
                        return (known_readonly, known_mutable)


        def check_mutable_view_slice_source(name: sview @source, value: Ast::Expr, line: u32, current_module: sview, table: lmut SymbolTable, var_types: mutable darray[sview]&, type_names: mutable darray[sview @source]&, type_expressions: mutable darray[Ast::Expr]&, expression_names: mutable darray[sview]&, declarations: darray[Ast::Decl]) -> void:
            can Memory.Allocate, Abort.Panic:
                result: (has_slice: bool, writable: bool) = mv_value_slice_sources_writable(value, current_module, table, var_types, type_names, type_expressions, expression_names, declarations)
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.MutableViewFromReadonlySource, name: name, line: line, expected: "mutable source", actual: "readonly or unmodeled source"}) if result.has_slice and not result.writable


        def check_mutable_view_initializer(name: sview @source, type_expression: Ast::Expr, value: Ast::Expr, line: u32, current_module: sview, table: lmut SymbolTable, var_types: mutable darray[sview]&, type_names: mutable darray[sview @source]&, type_expressions: mutable darray[Ast::Expr]&, expression_names: mutable darray[sview]&, declarations: darray[Ast::Decl]) -> void:
            can Memory.Allocate, Abort.Panic:
                check_mutable_view_value_against(type_expression, value, name, current_module, current_module, table, var_types, type_names, type_expressions, expression_names, declarations)


        def check_mutable_view_struct_field_source(field_name: sview @source, value: Ast::Expr, line: u32, owner: sview, owner_module: sview, current_module: sview, table: lmut SymbolTable, var_types: mutable darray[sview]&, type_names: mutable darray[sview @source]&, type_expressions: mutable darray[Ast::Expr]&, expression_names: mutable darray[sview]&, declarations: darray[Ast::Decl]) -> void:
            can Memory.Allocate, Abort.Panic:
                field_row: mutable i64 = -1
                if owner_module != "":
                    for index in 0..<table.struct_field_owner.count |field_row, owner, owner_module, field_name, table|:
                        if table.struct_field_owner[index] == owner and table.struct_field_name[index] == field_name and struct_field_module_at(table, index) == owner_module:
                            field_row <- index.i64()
                            break
                else:
                    field_row <- struct_field_row_for_type_in_module(table, owner, field_name, current_module)
                return if field_row < 0 or field_row.usize() >= table.private_field_types.count
                field_module: sview = struct_field_module_at(table, field_row.usize())
                check_mutable_view_value_against(table.private_field_types[field_row.usize()], value, field_name, field_module, current_module, table, var_types, type_names, type_expressions, expression_names, declarations)


        def check_mutable_view_assignment(target: Ast::Expr, value: Ast::Expr, line: u32, current_module: sview, table: lmut SymbolTable, var_types: mutable darray[sview]&, type_names: mutable darray[sview @source]&, type_expressions: mutable darray[Ast::Expr]&, expression_names: mutable darray[sview]&, declarations: darray[Ast::Decl]) -> void:
            can Memory.Allocate, Abort.Panic:
                projected: (found: bool, type_expression: Ast::Expr, module_owner: sview) = mv_projected_type(target, current_module, table, var_types, type_names, type_expressions, expression_names, declarations)
                if projected.found:
                    check_mutable_view_value_against(projected.type_expression, value, "", projected.module_owner, current_module, table, var_types, type_names, type_expressions, expression_names, declarations)
                else:
                    match target:
                        Expr.Field(object, field, _):
                            owner_type: (found: bool, type_expression: Ast::Expr, module_owner: sview) = mv_projected_type(object, current_module, table, var_types, type_names, type_expressions, expression_names, declarations)
                            struct_owner: (found: bool, name: sview, module_owner: sview) = mv_struct_owner(owner_type.type_expression, owner_type.module_owner, table) if owner_type.found else (false, "", "")
                            check_mutable_view_struct_field_source(field, value, line, struct_owner.name, struct_owner.module_owner, current_module, table, var_types, type_names, type_expressions, expression_names, declarations) if struct_owner.found
                        _:
                            pass


        # These walkers share the same push-only local-type channels as resolve. Every
        # nested statement body therefore needs an explicit mark/truncate pair so a
        # shadow cannot change provenance after its lexical scope ends.
        def walk_field_immutable_assign_scope(statements: darray[Ast::Stmt], table: lmut SymbolTable, var_types: mutable darray[sview]&, type_names: mutable darray[sview @source]&, type_expressions: mutable darray[Ast::Expr]&, expression_names: mutable darray[sview]&, declarations: darray[Ast::Decl], return_type: Ast::Expr) -> void:
            can Memory.Allocate, Abort.Panic:
                scope_mark: usize = var_types.count
                expression_mark: usize = type_expressions.count
                table <- walk_statements_for_field_immutable_assign(statements, table, var_types, type_names, type_expressions, expression_names, declarations, return_type) can Global{Read,Write}
                close_type_scope(scope_mark, var_types, type_names, table)
                type_expressions.truncate(expression_mark)
                expression_names.truncate(expression_mark)


        def walk_field_immutable_assign_lambda(parameters: darray[Ast::ParamDecl]&, statements: darray[Ast::Stmt], table: lmut SymbolTable, var_types: mutable darray[sview]&, type_names: mutable darray[sview @source]&, type_expressions: mutable darray[Ast::Expr]&, expression_names: mutable darray[sview]&, declarations: darray[Ast::Decl]) -> void:
            can Memory.Allocate, Abort.Panic:
                scope_mark: usize = var_types.count
                expression_mark: usize = type_expressions.count
                for parameter in parameters |table|:
                    type_family: sview = mv_type_family(parameter.type_expression, table.current_module, table)
                    type_name: sview = type_family if type_family == "array" or type_family == "mutable_array" or type_family == "darray" or type_family == "mutable_darray" or type_family == "view" or type_family == "mutable_view" else bare_type_name_through_ref(parameter.type_expression)
                    note_local_type(var_types, type_names, parameter.name, type_name)
                    type_expressions.push(parameter.type_expression)
                    expression_names.push(parameter.name)
                    note_local_type_id(parameter.name, parameter.type_expression, table) can Global{Read,Write}
                table <- walk_field_immutable_assign_scope(statements, table, var_types, type_names, type_expressions, expression_names, declarations, Expr.Absent) can Global{Read,Write}
                close_type_scope(scope_mark, var_types, type_names, table)
                type_expressions.truncate(expression_mark)
                expression_names.truncate(expression_mark)
