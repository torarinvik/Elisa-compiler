# Stage1 abstract-effect validation. Effects are declaration-level operation families;
# concrete permissions remain the authority facts in ordinary `can` clauses. A handler
# installation is therefore checked in two dimensions: it must name a known handler for
# the granted abstract family, and every abstract operation call must have been lowered to
# that handler's direct operation function by the parser.

extend Semantic:
    private:
        const AE_EXPRESSION_OPERATION_ROW: u32 = 3900000081
        const AE_EXPRESSION_GENERIC_ROW: u32 = 3900000090
        const AE_EXPRESSION_TEMPLATE_EFFECT_ROW: u32 = 3900000100
        const AE_PERMISSION_MEMBER_ROW: u32 = 3900000093
        const AE_PERMISSION_ALIAS_MEMBER_ROW: u32 = 3900000041
        const AE_HANDLER_OPERATION_ROW: u32 = 3900000083
        const AE_HANDLER_TARGET_ROW: u32 = 3900000084
        const AE_HANDLER_REALIZATION_ROW: u32 = 3900000087
        const AE_HANDLER_RESUME_MISSING_ROW: u32 = 3900000091
        const AE_HANDLER_RESUME_RETURN_ROW: u32 = 3900000092
        const AE_EFFECT_INDEX_NONE: u32 = 4294967295
        const AE_EFFECT_INDEX_SEPARATOR: u64 = 255

        # Handler install facts are consumed by both the declaration walk and the
        # statement walk. Keep the rows indexed once so an install never rescans the
        # complete annotation table for its effect, captures, target, or realizations.
        struct EffectDeclarationIdentityIndex:
            names: mutable darray[sview @source] @source = []
            modules: mutable darray[sview @source] @source = []
            identities: mutable darray[u32] = []
            declared_ids: mutable dict[u64, bool] = {}
            module_family_heads: mutable dict[u64, u32] = {}
            module_family_next: mutable darray[u32] = []
            family_heads: mutable dict[u64, u32] = {}
            family_next: mutable darray[u32] = []
            operation_heads: mutable dict[u64, u32] = {}
            operation_tails: mutable dict[u64, u32] = {}
            operation_names: mutable darray[sview @source] @source = []
            operation_ids: mutable darray[u32] = []
            operation_next: mutable darray[u32] = []

        struct EffectOperationPositionIndex:
            operation_heads: mutable dict[u64, u32] = {}
            operation_tails: mutable dict[u64, u32] = {}
            operation_annotations: mutable darray[Ast::EnumAnnotation] @source = []
            operation_effect_ids: mutable darray[u32] = []
            operation_next: mutable darray[u32] = []
            mismatch_heads: mutable dict[u64, u32] = {}
            mismatch_tails: mutable dict[u64, u32] = {}
            mismatch_annotations: mutable darray[Ast::EnumAnnotation] @source = []
            mismatch_next: mutable darray[u32] = []
            # name_hash of every `__effect_clone` row's name: a prefilter so a call whose
            # callee has no clone skips the template scan of the annotation table.
            clone_name_hashes: mutable dict[u64, u8] = {}

        struct EffectHandlerSemanticIndex:
            declared: mutable darray[bool] = []
            declaration_lines: mutable darray[u32] = []
            target_refs: mutable darray[sview @source] @source = []
            target_effect_ids: mutable darray[u32] = []
            target_annotation_rows: mutable darray[u32] = []
            required_captures: mutable darray[u32] = []
            total_captures: mutable darray[u32] = []
            realization_heads: mutable dict[u64, u32] = {}
            realization_tails: mutable dict[u64, u32] = {}
            realization_annotations: mutable darray[usize] = []
            realization_next: mutable darray[u32] = []

        struct EffectInstallPositionIndex:
            lines: mutable darray[u32] = []
            offsets: mutable darray[u32] = []
            handler_names: mutable darray[sview @source] @source = []
            handler_ids: mutable darray[u32] = []
            effect_refs: mutable darray[sview @source] @source = []
            effect_ids: mutable darray[u32] = []
            effect_annotation_rows: mutable darray[u32] = []
            capture_counts: mutable darray[u32] = []
            identity_mismatches: mutable darray[bool] = []
            target_refs: mutable darray[sview @source] @source = []
            target_effect_ids: mutable darray[u32] = []
            target_annotation_rows: mutable darray[u32] = []
            offsets_ordered: mutable bool = true

        def ae_effect_module_family_hash(module: sview, family: sview) -> u64:
            can Abort.Panic:
                hash: mutable u64 = name_hash(module)
                hash <- (hash ^ AE_EFFECT_INDEX_SEPARATOR) * SEMANTIC_HASH_PRIME
                return (hash ^ name_hash(family)) * SEMANTIC_HASH_PRIME

        def ae_effect_declaration_identity_index(annotations: darray[Ast::EnumAnnotation]&, index: mutable EffectDeclarationIdentityIndex&) -> void:
            can Memory.Allocate, Abort.Panic:
                module_tails: mutable dict[u64, u32] = {}
                family_tails: mutable dict[u64, u32] = {}
                for annotation in annotations |index, module_tails, family_tails|:
                    continue if annotation.owner != "__effect_decl" or annotation.identity_id == 0
                    row: u32 = index.identities.count.u32()
                    module_hash: u64 = ae_effect_module_family_hash(annotation.module, annotation.name)
                    family_hash: u64 = name_hash(annotation.name)
                    index.names.push(annotation.name)
                    index.modules.push(annotation.module)
                    index.identities.push(annotation.identity_id)
                    index.declared_ids <- index.declared_ids.put(annotation.identity_id.u64(), true) can Global{Read,Write}
                    index.module_family_next.push(AE_EFFECT_INDEX_NONE)
                    index.family_next.push(AE_EFFECT_INDEX_NONE)
                    if module_tails.get(module_hash) is module_tail:
                        index.module_family_next[module_tail.usize()] <- row
                    else:
                        index.module_family_heads <- index.module_family_heads.put(module_hash, row) can Global{Read,Write}
                    module_tails <- module_tails.put(module_hash, row) can Global{Read,Write}
                    if family_tails.get(family_hash) is family_tail:
                        index.family_next[family_tail.usize()] <- row
                    else:
                        index.family_heads <- index.family_heads.put(family_hash, row) can Global{Read,Write}
                    family_tails <- family_tails.put(family_hash, row) can Global{Read,Write}

        def ae_effect_identity_index_declared(index: EffectDeclarationIdentityIndex&, identity_id: u32) -> bool:
            can Abort.Panic:
                return false if identity_id == 0
                return known if index.declared_ids.get(identity_id.u64()) is known
                return false

        def ae_effect_family_indexed(index: EffectDeclarationIdentityIndex&, family: sview) -> bool:
            can Abort.Panic:
                family_hash: u64 = name_hash(family)
                row: mutable u32 = AE_EFFECT_INDEX_NONE
                row <- head if index.family_heads.get(family_hash) is head
                while row != AE_EFFECT_INDEX_NONE |row, index, family|:
                    return true if index.names[row.usize()] == family
                    row <- index.family_next[row.usize()]
                return false

        def ae_effect_operation_identity_hash(identity_id: u32, operation: sview) -> u64:
            can Abort.Panic:
                hash: mutable u64 = identity_id.u64()
                hash <- (hash ^ AE_EFFECT_INDEX_SEPARATOR) * SEMANTIC_HASH_PRIME
                return (hash ^ name_hash(operation)) * SEMANTIC_HASH_PRIME

        def ae_effect_operation_identity_index(annotations: darray[Ast::EnumAnnotation]&, index: mutable EffectDeclarationIdentityIndex&) -> void:
            can Memory.Allocate, Abort.Panic:
                tails: mutable dict[u64, u32] = {}
                for annotation in annotations |index, tails|:
                    continue if annotation.line != AE_EXPRESSION_OPERATION_ROW or annotation.identity_id == 0
                    key: u64 = ae_effect_operation_identity_hash(annotation.identity_id, annotation.name)
                    row: u32 = index.operation_names.count.u32()
                    index.operation_names.push(annotation.name)
                    index.operation_ids.push(annotation.identity_id)
                    index.operation_next.push(AE_EFFECT_INDEX_NONE)
                    if tails.get(key) is tail_row:
                        index.operation_next[tail_row.usize()] <- row
                    else:
                        index.operation_heads <- index.operation_heads.put(key, row) can Global{Read,Write}
                    tails <- tails.put(key, row) can Global{Read,Write}

        def ae_effect_operation_index_declared(index: EffectDeclarationIdentityIndex&, identity_id: u32, operation: sview) -> bool:
            can Abort.Panic:
                return false if identity_id == 0
                key: u64 = ae_effect_operation_identity_hash(identity_id, operation)
                row: mutable u32 = AE_EFFECT_INDEX_NONE
                row <- head if index.operation_heads.get(key) is head
                while row != AE_EFFECT_INDEX_NONE |row, index, identity_id, operation|:
                    return true if index.operation_ids[row.usize()] == identity_id and index.operation_names[row.usize()] == operation
                    row <- index.operation_next[row.usize()]
                return false

        def ae_effect_operation_site_hash(member: sview, line: u32, offset: u32) -> u64:
            can Abort.Panic:
                hash: mutable u64 = name_hash(member)
                hash <- (hash ^ AE_EFFECT_INDEX_SEPARATOR) * SEMANTIC_HASH_PRIME
                hash <- (hash ^ line.u64()) * SEMANTIC_HASH_PRIME
                return (hash ^ offset.u64()) * SEMANTIC_HASH_PRIME

        def ae_effect_mismatch_site_hash(line: u32, offset: u32) -> u64:
            can Abort.Panic:
                hash: mutable u64 = line.u64() ^ AE_EFFECT_INDEX_SEPARATOR
                return (hash ^ offset.u64()) * SEMANTIC_HASH_PRIME

        def ae_effect_operation_position_index(annotations: darray[Ast::EnumAnnotation]&, effects: EffectDeclarationIdentityIndex&, index: mutable EffectOperationPositionIndex&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for row in 0..<annotations.count |index, table| -> table:
                    annotation: Ast::EnumAnnotation = annotations[row]
                    index.clone_name_hashes <- index.clone_name_hashes.put(name_hash(annotation.name), 1) can Global{Read,Write} if annotation.owner == "__effect_clone"
                    if annotation.owner == "__effect_operation_ref":
                        key: u64 = ae_effect_operation_site_hash(annotation.name, annotation.line, annotation.offset)
                        site_row: u32 = index.operation_annotations.count.u32()
                        index.operation_annotations.push(annotation)
                        rebind operation_identity_id: u32, table = ae_effect_identity_at_request(annotations, effects, annotation.detail_name, annotation.identity_id, annotation, table)
                        index.operation_effect_ids.push(operation_identity_id)
                        index.operation_next.push(AE_EFFECT_INDEX_NONE)
                        if index.operation_tails.get(key) is tail_row:
                            index.operation_next[tail_row.usize()] <- site_row
                        else:
                            index.operation_heads <- index.operation_heads.put(key, site_row) can Global{Read,Write}
                        index.operation_tails <- index.operation_tails.put(key, site_row) can Global{Read,Write}
                    elif annotation.owner == "__effect_specialization_mismatch":
                        key: u64 = ae_effect_mismatch_site_hash(annotation.line, annotation.offset)
                        site_row: u32 = index.mismatch_annotations.count.u32()
                        index.mismatch_annotations.push(annotation)
                        index.mismatch_next.push(AE_EFFECT_INDEX_NONE)
                        if index.mismatch_tails.get(key) is tail_row:
                            index.mismatch_next[tail_row.usize()] <- site_row
                        else:
                            index.mismatch_heads <- index.mismatch_heads.put(key, site_row) can Global{Read,Write}
                        index.mismatch_tails <- index.mismatch_tails.put(key, site_row) can Global{Read,Write}

        def ae_effect_identity_from_index(index: EffectDeclarationIdentityIndex&, effect_ref: sview, lexical_owner: sview) -> u32:
            can Abort.Panic:
                abstract_ref: sview = effect_ref_abstract(effect_ref)
                family: sview = effect_ref_family(abstract_ref)
                return 0 if family == ""
                namespace_end: mutable usize = abstract_ref.len
                depth: mutable int = 0
                cursor: mutable usize = 0
                while cursor < abstract_ref.len |cursor, abstract_ref, namespace_end, depth|:
                    byte: u8 = abstract_ref[cursor]
                    depth <- depth + 1 if byte == 91 or byte == 40 or byte == 123
                    depth <- depth - 1 if depth > 0 and (byte == 93 or byte == 41 or byte == 125)
                    if depth == 0 and byte == 58 and cursor + 1.usize() < abstract_ref.len and abstract_ref[cursor + 1.usize()] == 58:
                        namespace_end <- cursor
                        cursor <- cursor + 1.usize()
                    elif depth == 0 and byte == 46:
                        namespace_end <- cursor
                    cursor <- cursor + 1.usize()
                namespace: sview = abstract_ref[0:namespace_end] if namespace_end < abstract_ref.len else lexical_owner
                module_hash: u64 = ae_effect_module_family_hash(namespace, family)
                row: mutable u32 = AE_EFFECT_INDEX_NONE
                row <- head if index.module_family_heads.get(module_hash) is head
                while row != AE_EFFECT_INDEX_NONE |row, index, namespace, family|:
                    return index.identities[row.usize()] if index.modules[row.usize()] == namespace and index.names[row.usize()] == family
                    row <- index.module_family_next[row.usize()]
                return 0 if namespace_end < abstract_ref.len
                family_hash: u64 = name_hash(family)
                row <- AE_EFFECT_INDEX_NONE
                row <- family_head if index.family_heads.get(family_hash) is family_head
                candidate: mutable u32 = 0
                while row != AE_EFFECT_INDEX_NONE |row, index, family, candidate|:
                    if index.names[row.usize()] == family:
                        identity_id: u32 = index.identities[row.usize()]
                        return 0 if candidate != 0 and candidate != identity_id
                        candidate <- identity_id
                    row <- index.family_next[row.usize()]
                return candidate

        # Parser IDs are authoritative when present. A zero ID first tries the exact
        # lexical module/family index for bare references. Qualified references always use
        # module alias resolution first because a using alias can shadow a real same-named
        # module. The handler-target sentinel line is replaced by its retained source line.
        def ae_effect_reference_is_qualified(effect_ref: sview) -> bool:
            abstract_ref: sview = effect_ref_abstract(effect_ref)
            depth: mutable int = 0
            cursor: mutable usize = 0
            while cursor < abstract_ref.len |cursor, abstract_ref, depth|:
                byte: u8 = abstract_ref[cursor]
                depth <- depth + 1 if byte == 91 or byte == 40 or byte == 123
                depth <- depth - 1 if depth > 0 and (byte == 93 or byte == 41 or byte == 125)
                return true if depth == 0 and byte == 58 and cursor + 1.usize() < abstract_ref.len and abstract_ref[cursor + 1.usize()] == 58
                return true if depth == 0 and byte == 46
                cursor <- cursor + 1.usize()
            return false

        def ae_effect_identity_at_request(annotations: darray[Ast::EnumAnnotation]&, index: EffectDeclarationIdentityIndex&, effect_ref: sview @source, parser_identity_id: u32, requester: Ast::EnumAnnotation, table: lmut SymbolTable) -> u32:
            can Abort.Panic:
                identity_id: mutable u32 = parser_identity_id
                if identity_id == 0:
                    if ae_effect_reference_is_qualified(effect_ref):
                        source_requester: mutable Ast::EnumAnnotation = requester
                        source_requester <- requester{line = requester.detail_line} if requester.line == AE_HANDLER_TARGET_ROW and requester.detail_line != 0
                        source_requester <- source_requester{offset = requester.occurrence_offset} if requester.occurrence_offset != 0
                        rebind requested_identity_id: u32, table = ae_effect_identity_for_ref(index, effect_ref, requester.module, source_requester, table)
                        identity_id <- requested_identity_id
                    else:
                        identity_id <- ae_effect_identity_from_index(index, effect_ref, requester.module)
                return identity_id if ae_effect_identity_index_declared(index, identity_id)
                return 0

        def ae_handler_index_ensure(index: mutable EffectHandlerSemanticIndex&, handler_identity_id: u32) -> void:
            can Memory.Allocate, Abort.Panic:
                while index.declared.count < handler_identity_id.usize() |index, handler_identity_id|:
                    index.declared.push(false)
                    index.declaration_lines.push(0)
                    index.target_refs.push("")
                    index.target_effect_ids.push(0)
                    index.target_annotation_rows.push(AE_EFFECT_INDEX_NONE)
                    index.required_captures.push(0)
                    index.total_captures.push(0)

        def ae_handler_semantic_index(annotations: darray[Ast::EnumAnnotation]&, effects: EffectDeclarationIdentityIndex&, index: mutable EffectHandlerSemanticIndex&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for row in 0..<annotations.count |index, table| -> table:
                    annotation: Ast::EnumAnnotation = annotations[row]
                    handler_identity_id: u32 = annotation.identity_id
                    continue if handler_identity_id == 0
                    if annotation.owner == "__handler_decl" or annotation.owner == "__handler_capture_required" or annotation.owner == "__handler_capture_total" or annotation.line == AE_HANDLER_TARGET_ROW or annotation.line == AE_HANDLER_REALIZATION_ROW:
                        ae_handler_index_ensure(index, handler_identity_id)
                    handler_row: usize = (handler_identity_id - 1).usize()
                    if annotation.owner == "__handler_decl":
                        index.declared[handler_row] <- true
                        index.declaration_lines[handler_row] <- annotation.line
                    elif annotation.owner == "__handler_capture_required":
                        index.required_captures[handler_row] <- annotation.line
                    elif annotation.owner == "__handler_capture_total":
                        index.total_captures[handler_row] <- annotation.line
                    elif annotation.line == AE_HANDLER_TARGET_ROW:
                        index.target_refs[handler_row] <- annotation.name
                        rebind target_identity_id: u32, table = ae_effect_identity_at_request(annotations, effects, annotation.name, annotation.referenced_identity_id, annotation, table)
                        index.target_effect_ids[handler_row] <- target_identity_id
                        index.target_annotation_rows[handler_row] <- row.u32()
                    elif annotation.line == AE_HANDLER_REALIZATION_ROW:
                        realization_row: u32 = index.realization_annotations.count.u32()
                        index.realization_annotations.push(row)
                        index.realization_next.push(AE_EFFECT_INDEX_NONE)
                        if index.realization_tails.get(handler_identity_id.u64()) is tail_row:
                            index.realization_next[tail_row.usize()] <- realization_row
                        else:
                            index.realization_heads <- index.realization_heads.put(handler_identity_id.u64(), realization_row) can Global{Read,Write}
                        index.realization_tails <- index.realization_tails.put(handler_identity_id.u64(), realization_row) can Global{Read,Write}

        def ae_install_position_index_at(index: EffectInstallPositionIndex&, line: u32, offset: u32) -> u32:
            can Abort.Panic:
                if index.offsets_ordered:
                    low: mutable usize = 0
                    high: mutable usize = index.offsets.count
                    while low < high |low, high, index, offset|:
                        middle: usize = low + ((high - low) / 2.usize())
                        if index.offsets[middle] < offset:
                            low <- middle + 1.usize()
                        else:
                            high <- middle
                    while low < index.offsets.count and index.offsets[low] == offset |low, index, line, offset|:
                        return low.u32() if index.lines[low] == line
                        low <- low + 1.usize()
                    return AE_EFFECT_INDEX_NONE
                for row in 0..<index.offsets.count:
                    return row.u32() if index.lines[row] == line and index.offsets[row] == offset
                return AE_EFFECT_INDEX_NONE

        def ae_effect_install_position_index(annotations: darray[Ast::EnumAnnotation]&, effects: EffectDeclarationIdentityIndex&, handlers: EffectHandlerSemanticIndex&, index: mutable EffectInstallPositionIndex&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for annotation in annotations |index|:
                    continue if annotation.owner != "__effect_install"
                    if index.offsets.count > 0:
                        index.offsets_ordered <- false if annotation.offset < index.offsets[index.offsets.count - 1.usize()]
                    index.lines.push(annotation.line)
                    index.offsets.push(annotation.offset)
                    index.handler_names.push(annotation.name)
                    index.handler_ids.push(annotation.identity_id)
                    index.effect_refs.push("")
                    index.effect_ids.push(0)
                    index.effect_annotation_rows.push(AE_EFFECT_INDEX_NONE)
                    index.capture_counts.push(0)
                    index.identity_mismatches.push(false)
                    index.target_refs.push("")
                    index.target_effect_ids.push(0)
                    index.target_annotation_rows.push(AE_EFFECT_INDEX_NONE)
                for annotation_row in 0..<annotations.count |index, table| -> table:
                    annotation: Ast::EnumAnnotation = annotations[annotation_row]
                    if annotation.owner == "__effect_install_effect":
                        install_row: u32 = ae_install_position_index_at(index, annotation.line, annotation.offset)
                        if install_row != AE_EFFECT_INDEX_NONE and index.handler_names[install_row.usize()] != "":
                            index.effect_refs[install_row.usize()] <- annotation.name
                            rebind effect_identity_id: u32, table = ae_effect_identity_at_request(annotations, effects, annotation.name, annotation.identity_id, annotation, table)
                            index.effect_ids[install_row.usize()] <- effect_identity_id
                            index.effect_annotation_rows[install_row.usize()] <- annotation_row.u32()
                    elif annotation.owner == "__effect_install_capture_count":
                        install_row: u32 = ae_install_position_index_at(index, annotation.line, annotation.offset)
                        if install_row != AE_EFFECT_INDEX_NONE and annotation.name == index.handler_names[install_row.usize()]:
                            index.capture_counts[install_row.usize()] <- annotation.identity_id
                    elif annotation.owner == "__effect_install_identity_mismatch":
                        install_row: u32 = ae_install_position_index_at(index, annotation.line, annotation.offset)
                        if install_row != AE_EFFECT_INDEX_NONE and annotation.identity_id == index.handler_ids[install_row.usize()]:
                            index.identity_mismatches[install_row.usize()] <- true
                for row in 0..<index.handler_ids.count |index, handlers|:
                    handler_identity_id: u32 = index.handler_ids[row]
                    continue if handler_identity_id == 0
                    handler_row: usize = (handler_identity_id - 1).usize()
                    continue if handler_row >= handlers.target_refs.count
                    index.target_refs[row] <- handlers.target_refs[handler_row]
                    index.target_effect_ids[row] <- handlers.target_effect_ids[handler_row]
                    index.target_annotation_rows[row] <- handlers.target_annotation_rows[handler_row]

        # Exact lookup dependencies of effect declaration/block validation.
        # Preserve source order, duplicate rows, and diagnostic positions.
        def ae_row_annotation(annotation: Ast::EnumAnnotation&) -> bool:
            can Abort.Panic:
                return annotation.owner == "__effect_decl" or annotation.owner == "__permission_decl" or annotation.owner == "__permission_param_decl" or annotation.owner == "__permission_alias" or annotation.owner == "__effect_ref_pos" or annotation.line == AE_EXPRESSION_OPERATION_ROW or annotation.line == AE_PERMISSION_MEMBER_ROW

        # Exact annotation dependencies of ae_check_declarations and its
        # expression walk. Preserve row order and duplicates; declaration and
        # handler validation still consume the complete annotation table.
        def ae_expression_annotation(annotation: Ast::EnumAnnotation&) -> bool:
            can Abort.Panic:
                return annotation.owner == "__effect_decl" or annotation.owner == "__effect_template" or annotation.owner == "__effect_clone" or annotation.owner == "__effect_operation_ref" or annotation.owner == "__effect_specialization_mismatch" or annotation.line == AE_EXPRESSION_OPERATION_ROW or annotation.line == AE_EXPRESSION_GENERIC_ROW or annotation.line == AE_EXPRESSION_TEMPLATE_EFFECT_ROW

        # Add one effect row without making repeated handler-install scans grow the
        # function's requirement set. Stage1 keeps effect rows as source spellings;
        # `via` rows are added separately by collect_range.
        def ae_add_function_effect(table: lmut SymbolTable, owner: sview @source, module: sview @source, effect_ref: sview @source) -> void:
            can Memory.Allocate, Abort.Panic:
                return if effect_ref == ""
                while row_index < table.function_effect_owner.count |row_index: usize = 0|:
                    return if table.function_effect_owner[row_index] == owner and row_index < table.function_effect_module.count and table.function_effect_module[row_index] == module and table.function_effect_name[row_index] == effect_ref
                    row_index <- row_index + 1.usize()
                table.function_effect_owner <- table.function_effect_owner.push(owner)
                table.function_effect_name <- table.function_effect_name.push(effect_ref)
                table.function_effect_module <- table.function_effect_module.push(module)
                table <- index_effect_owner_rows(table) can Global{Read,Write}



        def ae_handler_index_declared(index: EffectHandlerSemanticIndex&, handler_identity_id: u32) -> bool:
            return false if handler_identity_id == 0 or (handler_identity_id - 1).usize() >= index.declared.count
            return index.declared[(handler_identity_id - 1).usize()]

        def ae_handler_index_decl_line(index: EffectHandlerSemanticIndex&, handler_identity_id: u32) -> u32:
            return 0 if handler_identity_id == 0 or (handler_identity_id - 1).usize() >= index.declaration_lines.count
            return index.declaration_lines[(handler_identity_id - 1).usize()]

        def ae_handler_index_target_ref(index: EffectHandlerSemanticIndex&, handler_identity_id: u32) -> sview @source:
            return "" if handler_identity_id == 0 or (handler_identity_id - 1).usize() >= index.target_refs.count
            return index.target_refs[(handler_identity_id - 1).usize()]

        def ae_handler_index_target_effect_id(index: EffectHandlerSemanticIndex&, handler_identity_id: u32) -> u32:
            return 0 if handler_identity_id == 0 or (handler_identity_id - 1).usize() >= index.target_effect_ids.count
            return index.target_effect_ids[(handler_identity_id - 1).usize()]

        def ae_handler_index_required_captures(index: EffectHandlerSemanticIndex&, handler_identity_id: u32) -> u32:
            return 0 if handler_identity_id == 0 or (handler_identity_id - 1).usize() >= index.required_captures.count
            return index.required_captures[(handler_identity_id - 1).usize()]

        def ae_handler_index_total_captures(index: EffectHandlerSemanticIndex&, handler_identity_id: u32) -> u32:
            return 0 if handler_identity_id == 0 or (handler_identity_id - 1).usize() >= index.total_captures.count
            return index.total_captures[(handler_identity_id - 1).usize()]

        def ae_handler_realization_head(index: EffectHandlerSemanticIndex&, handler_identity_id: u32) -> u32:
            can Abort.Panic:
                return head if handler_identity_id != 0 and index.realization_heads.get(handler_identity_id.u64()) is head
                return AE_EFFECT_INDEX_NONE


include "./check_abstract_effect_resolution.elisa"
