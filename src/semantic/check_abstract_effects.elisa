# Stage1 abstract-effect validation. Effects are declaration-level operation families;
# concrete permissions remain the authority facts in ordinary `can` clauses. A handler
# installation is therefore checked in two dimensions: it must name a known handler for
# the granted abstract family, and every abstract operation call must have been lowered to
# that handler's direct operation function by the parser.

extend Semantic:
    private:
        const AE_EXPRESSION_OPERATION_ROW: u32 = 3900000081
        const AE_EXPRESSION_GENERIC_ROW: u32 = 3900000090
        const AE_EXPRESSION_TEMPLATE_EFFECT_ROW: u32 = 3900000100

        # Exact annotation dependencies of ae_check_declarations and its
        # expression walk. Preserve row order and duplicates; declaration and
        # handler validation still consume the complete annotation table.
        def ae_expression_annotation(annotation: Ast::EnumAnnotation&) -> bool:
            can Abort.Panic:
                return annotation.owner == "__effect_decl" or annotation.owner == "__effect_template" or annotation.owner == "__effect_clone" or annotation.owner == "__effect_specialization_mismatch" or annotation.line == AE_EXPRESSION_OPERATION_ROW or annotation.line == AE_EXPRESSION_GENERIC_ROW or annotation.line == AE_EXPRESSION_TEMPLATE_EFFECT_ROW

        # Add one effect row without making repeated handler-install scans grow the
        # function's requirement set. Stage1 keeps effect rows as source spellings;
        # `via` rows are added separately by collect_range.
        def ae_add_function_effect(table: lmut SymbolTable, owner: sview, effect_ref: sview) -> void:
            can Memory.Allocate, Abort.Panic:
                return if effect_ref == ""
                while row_index < table.function_effect_owner.count |row_index: usize = 0|:
                    return if table.function_effect_owner[row_index] == owner and table.function_effect_name[row_index] == effect_ref
                    row_index <- row_index + 1.usize()
                table.function_effect_owner <- table.function_effect_owner.push(owner)
                table.function_effect_name <- table.function_effect_name.push(effect_ref)



        def ae_install_handler_on_line(annotations: darray[Ast::EnumAnnotation]&, line: u32) -> sview:
            can Abort.Panic:
                for annotation in annotations:
                    annotation.name return if annotation.owner == "__effect_install" and annotation.line == line
                return ""



        def ae_install_effect_on_line(annotations: darray[Ast::EnumAnnotation]&, line: u32) -> sview:
            can Abort.Panic:
                for annotation in annotations:
                    annotation.name return if annotation.owner == "__effect_install_effect" and annotation.line == line
                return ""



        # Handler installations are visible requirements even though the operation
        # calls inside them have already been lowered to hidden direct functions. This
        # preserves the abstract effect in the enclosing function's contract and also
        # carries the handler's concrete authority rows to callers.
        def ae_collect_install_statements(owner: sview, statements: darray[Ast::Stmt], annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Block(kind, clause, binding, body, statement_pos):
                            if kind == "can":
                                installed: sview = ae_install_effect_on_line(annotations, statement_pos.line)
                                handler: sview = ae_install_handler_on_line(annotations, statement_pos.line)
                                if installed != "" and handler != "":
                                    table <- ae_add_function_effect(table, owner, installed)
                                    installed_concrete: sview = effect_ref_via(installed)
                                    table <- ae_add_function_effect(table, owner, installed_concrete) if installed_concrete != ""
                                    # A handler may declare its realization on the target
                                    # (`handler Sink for Writer[sview] via Console.Write`).
                                    # Treat that declaration as an authority fact at every
                                    # installation, even when the installation uses the
                                    # ergonomic bare form (`can Writer[sview] with Sink`).
                                    # This scan is deliberately performed here, after the
                                    # whole file has been parsed, so a forward handler
                                    # declaration carries the same facts as a preceding one.
                                    target_ref: sview = ae_handler_target(annotations, handler)
                                    target_concrete: sview = effect_ref_via(target_ref)
                                    table <- ae_add_function_effect(table, owner, target_concrete) if target_concrete != ""
                                    for annotation in annotations |table| -> table:
                                        continue if annotation.owner != handler or annotation.line != 3900000087
                                        concrete: mutable sview = effect_ref_via(annotation.name)
                                        concrete <- annotation.name if concrete == ""
                                        table <- ae_add_function_effect(table, owner, concrete)
                            table <- ae_collect_install_statements(owner, body, annotations, table)
                        Stmt.If(condition, then_body, else_body, statement_pos):
                            table <- ae_collect_install_statements(owner, then_body, annotations, table)
                            table <- ae_collect_install_statements(owner, else_body, annotations, table)
                        Stmt.While(condition, body, statement_pos):
                            table <- ae_collect_install_statements(owner, body, annotations, table)
                        Stmt.For(bind, variables, iterable, body, statement_pos):
                            table <- ae_collect_install_statements(owner, body, annotations, table)
                        Stmt.Match(scrutinee, arms, statement_pos):
                            for arm in arms |table| -> table:
                                table <- ae_collect_install_statements(owner, arm.body, annotations, table)
                        _:
                            pass



        def ae_collect_install_declarations(declarations: darray[Ast::Decl], annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(name, parameters, return_type, body, effects, decorators, declaration_pos):
                            table <- ae_collect_install_statements(name, body, annotations, table)
                        Decl.Module(name, body, declaration_pos):
                            table <- ae_collect_install_declarations(body, annotations, table)
                        Decl.Scoped(body, declaration_pos):
                            table <- ae_collect_install_declarations(body, annotations, table)
                        _:
                            pass



        def ae_check_expression(expression: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                effect_name: mutable sview = ""
                operation: mutable sview = ""
                line: mutable u32 = 0
                if ae_call_is_operation(expression, effect_name, operation, line):
                    if ae_effect_declared(annotations, effect_name) and not ae_operation_declared(annotations, effect_name, operation):
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AbstractEffectOperationMissing, name: operation, line: line, expected: effect_name, actual: "operation"})
                    if ae_effect_declared(annotations, effect_name) and ae_operation_declared(annotations, effect_name, operation):
                        explicit_count: mutable u32 = 0
                        is_explicit: bool = ae_call_explicit_specialization(expression, explicit_count)
                        generic_count: u32 = ae_effect_generic_names(annotations, effect_name).count.u32()
                        has_arity_mismatch: bool = is_explicit and generic_count != explicit_count
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AbstractEffectSpecializationArity, name: operation, line: line, expected: effect_name, actual: "operation", expected_count: generic_count, actual_count: explicit_count}) if has_arity_mismatch
                        mismatch_effect: sview = ae_specialization_mismatch_on_line(annotations, line)
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AbstractEffectSpecializationMismatch, name: operation, line: line, expected: mismatch_effect, actual: effect_name}) if not has_arity_mismatch and mismatch_effect != ""
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AbstractEffectUnhandled, name: operation, line: line, expected: effect_name, actual: effect_name}) if not has_arity_mismatch and mismatch_effect == ""
                match expression:
                    Expr.StaticEffectCall(effect_type, operation_name, candidates, arguments, argument_names, call_pos):
                        for argument in arguments |table|:
                            table <- ae_check_expression(argument, annotations, table)
                        for candidate in candidates |table|:
                            for capture in candidate.captures |table|:
                                table <- ae_check_expression(capture, annotations, table)
                    Expr.Call(callee, arguments, argument_names, call_pos):
                        # Effectful helpers are compile-time templates. If a call to one
                        # remains as an ordinary call, no static installation selected it;
                        # report the missing handler before backend overload resolution.
                        template_callee: sview = ae_effect_template_callee_name(callee)
                        if template_callee != "" and ae_effect_template_has_clone(annotations, template_callee):
                            for template_effect in annotations |template_callee|:
                                if template_effect.owner == template_callee and template_effect.line == 3900000100:
                                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AbstractEffectHelperUnhandled, name: template_callee, line: call_pos.line, expected: template_effect.name, actual: "helper"}) if not ae_has_concrete_diagnostic(table, DiagnosticKind.AbstractEffectHelperUnhandled, template_callee, template_effect.name, "helper")
                        # A direct abstract operation call is checked above. Do not visit its
                        # callee as a value as well: the same `Effect.op` syntax denotes an
                        # operation only in this call position.
                        table <- ae_check_expression(callee, annotations, table) if not ae_call_is_operation(expression, effect_name, operation, line)
                        for argument in arguments |table|:
                            table <- ae_check_expression(argument, annotations, table)
                    Expr.Ident(name, ident_pos):
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AbstractEffectImplementationAccess, name: name, line: ident_pos.line, expected: "", actual: ""}) if ident_pos.line != 0 and ae_is_hidden_handler_name(name)
                    Expr.Field(object, field, field_pos):
                        if ae_value_is_operation(expression, effect_name, operation, line) and ae_effect_declared(annotations, effect_name):
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AbstractEffectOperationMissing, name: operation, line: line, expected: effect_name, actual: "operation"}) if not ae_operation_declared(annotations, effect_name, operation)
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AbstractEffectValue, name: operation, line: line, expected: effect_name, actual: operation}) if ae_operation_declared(annotations, effect_name, operation)
                        table <- ae_check_expression(object, annotations, table)
                    Expr.Scope(object, field, field_pos):
                        if ae_value_is_operation(expression, effect_name, operation, line) and ae_effect_declared(annotations, effect_name):
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AbstractEffectOperationMissing, name: operation, line: line, expected: effect_name, actual: "operation"}) if not ae_operation_declared(annotations, effect_name, operation)
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AbstractEffectValue, name: operation, line: line, expected: effect_name, actual: operation}) if ae_operation_declared(annotations, effect_name, operation)
                        table <- ae_check_expression(object, annotations, table)
                    Expr.Index(object, index, index_pos):
                        table <- ae_check_expression(object, annotations, table)
                        table <- ae_check_expression(index, annotations, table)
                    Expr.Slice(object, low, high, slice_pos):
                        table <- ae_check_expression(object, annotations, table)
                        table <- ae_check_expression(low, annotations, table)
                        table <- ae_check_expression(high, annotations, table)
                    Expr.IndexN(object, arguments, index_pos):
                        table <- ae_check_expression(object, annotations, table)
                        for argument in arguments |table|:
                            table <- ae_check_expression(argument, annotations, table)
                    Expr.Binary(left, operator, right, binary_pos):
                        table <- ae_check_expression(left, annotations, table)
                        table <- ae_check_expression(right, annotations, table)
                    Expr.Unary(operator, operand, unary_pos):
                        table <- ae_check_expression(operand, annotations, table)
                    Expr.Move(operand, move_pos):
                        table <- ae_check_expression(operand, annotations, table)
                    Expr.RegionNew(operand, region, new_pos):
                        table <- ae_check_expression(operand, annotations, table)
                    Expr.Paren(inner, paren_pos):
                        table <- ae_check_expression(inner, annotations, table)
                    Expr.Array(elements, array_pos):
                        for element in elements |table|:
                            table <- ae_check_expression(element, annotations, table)
                    Expr.Tuple(elements, tuple_pos):
                        for element in elements |table|:
                            table <- ae_check_expression(element, annotations, table)
                    Expr.SetLit(elements, set_pos):
                        for element in elements |table|:
                            table <- ae_check_expression(element, annotations, table)
                    Expr.DictLit(entries, dict_pos):
                        for entry in entries |table|:
                            table <- ae_check_expression(entry.key, annotations, table)
                            table <- ae_check_expression(entry.value, annotations, table)
                    Expr.Construct(type_expression, fields, construct_pos):
                        table <- ae_check_expression(type_expression, annotations, table)
                        for field in fields |table|:
                            table <- ae_check_expression(field.value, annotations, table)
                    Expr.RecordUpdate(base, fields, update_pos):
                        table <- ae_check_expression(base, annotations, table)
                        for field in fields |table|:
                            table <- ae_check_expression(field.value, annotations, table)
                    Expr.If(condition, then_expr, else_expr, if_pos):
                        table <- ae_check_expression(condition, annotations, table)
                        table <- ae_check_expression(then_expr, annotations, table)
                        table <- ae_check_expression(else_expr, annotations, table)
                    Expr.Comprehension(variable, iterable, condition, body, comprehension_pos):
                        table <- ae_check_expression(iterable, annotations, table)
                        table <- ae_check_expression(condition, annotations, table)
                        table <- ae_check_expression(body, annotations, table)
                    Expr.Refinement(base, predicate, refinement_pos):
                        table <- ae_check_expression(base, annotations, table)
                        table <- ae_check_expression(predicate, annotations, table)
                    Expr.GetElse(guarded, recovery, get_pos):
                        table <- ae_check_expression(guarded, annotations, table)
                        table <- ae_check_statements(recovery, annotations, table)
                    Expr.Lambda(parameters, body, lambda_pos):
                        table <- ae_check_statements(body, annotations, table)
                    Expr.Block(statements, value, captures, block_pos):
                        table <- ae_check_statements(statements, annotations, table)
                        table <- ae_check_expression(value, annotations, table)
                    Expr.Match(scrutinee, arms, match_pos):
                        table <- ae_check_expression(scrutinee, annotations, table)
                        for arm in arms |table|:
                            table <- ae_check_expression(arm.guard, annotations, table)
                            table <- ae_check_statements(arm.body, annotations, table)
                    Expr.Catch(guarded, arms, catch_pos):
                        table <- ae_check_expression(guarded, annotations, table)
                        for arm in arms |table|:
                            table <- ae_check_expression(arm.guard, annotations, table)
                            table <- ae_check_statements(arm.body, annotations, table)
                    _:
                        pass



        def ae_check_statements(statements: darray[Ast::Stmt], annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table|:
                    match statement:
                        Stmt.Expr(expression, statement_pos):
                            table <- ae_check_expression(expression, annotations, table)
                        Stmt.VarDecl(name, type_expression, value, statement_pos):
                            table <- ae_check_expression(type_expression, annotations, table)
                            table <- ae_check_expression(value, annotations, table)
                        Stmt.Assign(target, operator, value, statement_pos):
                            table <- ae_check_expression(target, annotations, table)
                            table <- ae_check_expression(value, annotations, table)
                        Stmt.If(condition, then_body, else_body, statement_pos):
                            table <- ae_check_expression(condition, annotations, table)
                            table <- ae_check_statements(then_body, annotations, table)
                            table <- ae_check_statements(else_body, annotations, table)
                        Stmt.While(condition, body, statement_pos):
                            table <- ae_check_expression(condition, annotations, table)
                            table <- ae_check_statements(body, annotations, table)
                        Stmt.For(bind, variables, iterable, body, statement_pos):
                            table <- ae_check_expression(iterable, annotations, table)
                            table <- ae_check_statements(body, annotations, table)
                        Stmt.Block(kind, clause, binding, body, statement_pos):
                            table <- ae_check_statements(body, annotations, table)
                        Stmt.Return(value, statement_pos):
                            table <- ae_check_expression(returned_value, annotations, table) if value is returned_value
                        Stmt.Match(scrutinee, arms, statement_pos):
                            table <- ae_check_expression(scrutinee, annotations, table)
                            for arm in arms |table|:
                                table <- ae_check_expression(arm.guard, annotations, table)
                                table <- ae_check_statements(arm.body, annotations, table)
                        Stmt.Contract(kind, expression, statement_pos):
                            table <- ae_check_expression(expression, annotations, table)
                        _:
                            pass



        def ae_check_declarations(declarations: darray[Ast::Decl], annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table|:
                    match declaration:
                        Decl.Func(name, parameters, return_type, body, effects, decorators, declaration_pos):
                            table <- ae_check_statements(body, annotations, table) if not ae_effect_template_declared(annotations, name, declaration_pos.line)
                        Decl.Module(name, body, declaration_pos):
                            table <- ae_check_declarations(body, annotations, table)
                        Decl.Scoped(body, declaration_pos):
                            table <- ae_check_declarations(body, annotations, table)
                        _:
                            pass



        def check_abstract_effects(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                # The file's annotations plus one `__permission_alias` row per permission
                # alias, in declaration order so an alias may name an earlier alias. Built
                # HERE rather than returned from a helper: a darray grown in a callee has no
                # region to be returned in. (`alias` is not `type`: the parser keeps no target
                # expression for it, only the per-member head rows consulted above.)
                row_annotations: mutable darray[Ast::EnumAnnotation] = []
                for existing in file.enum_annotations |row_annotations|:
                    row_annotations.push(existing)
                for candidate in file.enum_annotations |row_annotations, file|:
                    continue if candidate.line != 3900000041
                    continue if any known in row_annotations where known.owner == "__permission_alias" and known.name == candidate.owner
                    row_annotations.push(Ast::EnumAnnotation{owner: "__permission_alias", name: candidate.owner, line: 0}) if ae_alias_is_permission_set(candidate.owner, file.enum_annotations, row_annotations)
                table <- ae_validate_effect_declarations(file.top_decls, row_annotations, table)
                table <- ae_validate_effect_blocks_declarations(file.top_decls, row_annotations, table)
                table <- ae_collect_install_declarations(file.top_decls, file.enum_annotations, table)
                # Validate handler declarations and their operation coverage.
                for annotation in file.enum_annotations |table|:
                    if annotation.line == 3900000081:
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.DuplicateAbstractEffectOperation, name: annotation.name, line: ae_effect_decl_line(file.enum_annotations, annotation.owner), expected: annotation.owner, actual: "operation"}) if ae_duplicate_operation_declared(file.enum_annotations, annotation.owner, annotation.name)
                    if annotation.line == 3900000083:
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.DuplicateEffectHandlerOperation, name: annotation.name, line: ae_handler_decl_line(file.enum_annotations, annotation.owner), expected: annotation.owner, actual: "operation"}) if ae_duplicate_handler_operation_declared(file.enum_annotations, annotation.owner, annotation.name)
                    if annotation.line == 3900000084:
                        target: sview = effect_ref_family(annotation.name)
                        handler_line: u32 = ae_handler_decl_line(file.enum_annotations, annotation.owner)
                        target_member: sview = ae_effect_ref_member(annotation.name)
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.NamespaceUsedAsValue, name: target, line: handler_line, expected: target_member, actual: ""}) if target != "" and not ae_effect_declared(file.enum_annotations, target) and ae_effect_ref_head_is_module(target, table) and not ae_has_concrete_diagnostic(table, DiagnosticKind.NamespaceUsedAsValue, target, target_member, "")
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UnknownInterface, name: target, line: handler_line, expected: "effect", actual: ""}) if target != "" and not ae_effect_declared(file.enum_annotations, target)
                        target_concrete: sview = effect_ref_via(annotation.name)
                        table <- ae_validate_effect_ref(target_concrete, handler_line, file.enum_annotations, table) if target_concrete != ""
                        table <- ae_validate_effect_ref(annotation.name, handler_line, file.enum_annotations, table) if target != "" and ae_effect_declared(file.enum_annotations, target)
                    if annotation.line == 3900000083:
                        target_ref: sview = ae_handler_target(file.enum_annotations, annotation.owner)
                        target: sview = effect_ref_family(target_ref)
                        operation_known: bool = ae_operation_declared(file.enum_annotations, target, annotation.name)
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AbstractEffectOperationMissing, name: annotation.name, line: ae_handler_decl_line(file.enum_annotations, annotation.owner), expected: target, actual: "operation"}) if target != "" and ae_effect_declared(file.enum_annotations, target) and not operation_known
                        effect_signature: sview = ae_effect_operation_signature(file.enum_annotations, target, annotation.name)
                        handler_signature: sview = ae_handler_operation_signature(file.enum_annotations, annotation.owner, annotation.name)
                        effect_generic_names: darray[sview] = ae_effect_generic_names(file.enum_annotations, target)
                        effect_generic_values: darray[sview] = ae_effect_ref_arguments(target_ref)
                        specialization_arity_mismatch: bool = operation_known and effect_generic_names.count != effect_generic_values.count
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AbstractEffectSpecializationArity, name: annotation.owner, line: ae_handler_decl_line(file.enum_annotations, annotation.owner), expected: target, actual: target_ref, expected_count: effect_generic_names.count.u32(), actual_count: effect_generic_values.count.u32()}) if specialization_arity_mismatch
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.EffectHandlerSignatureMismatch, name: annotation.name, line: ae_handler_decl_line(file.enum_annotations, annotation.owner), expected: effect_signature, actual: annotation.owner}) if operation_known and not specialization_arity_mismatch and effect_signature != "" and handler_signature != "" and not ae_signature_matches(effect_signature, handler_signature, effect_generic_names, effect_generic_values)
                    if annotation.line == 3900000091:
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.EffectHandlerResumeInvalid, name: annotation.name, line: ae_handler_decl_line(file.enum_annotations, annotation.owner), expected: "use exactly one final resume() statement", actual: annotation.owner})
                    if annotation.line == 3900000092:
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.EffectHandlerResumeInvalid, name: annotation.name, line: ae_handler_decl_line(file.enum_annotations, annotation.owner), expected: "the operation must return void", actual: annotation.owner})
                    if annotation.owner == "__effect_install":
                        handler_name: sview = annotation.name
                        effect_ref: mutable sview = ""
                        while effect_index < file.enum_annotations.count |effect_index: usize = 0|:
                            effect_annotation: Ast::EnumAnnotation = file.enum_annotations[effect_index]
                            effect_ref <- effect_annotation.name if effect_annotation.owner == "__effect_install_effect" and effect_annotation.line == annotation.line
                            effect_index <- effect_index + 1
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UndefinedName, name: handler_name, line: annotation.line, expected: "effect handler", actual: ""}) if not ae_handler_declared(file.enum_annotations, handler_name)
                        required_captures: mutable u32 = 0
                        total_captures: mutable u32 = 0
                        ae_handler_capture_counts(file.enum_annotations, handler_name, required_captures, total_captures)
                        supplied_captures: u32 = ae_install_capture_count_after(file.enum_annotations, handler_name, annotation.line)
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.EffectHandlerCaptureArity, name: handler_name, line: annotation.line, expected: "", actual: "required", expected_count: required_captures, actual_count: supplied_captures}) if ae_handler_declared(file.enum_annotations, handler_name) and supplied_captures < required_captures
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.EffectHandlerCaptureArity, name: handler_name, line: annotation.line, expected: "", actual: "maximum", expected_count: total_captures, actual_count: supplied_captures}) if ae_handler_declared(file.enum_annotations, handler_name) and supplied_captures > total_captures
                        target_ref: sview = ae_handler_target(file.enum_annotations, handler_name)
                        target: sview = effect_ref_family(target_ref)
                        installed: sview = effect_ref_family(effect_ref)
                        # The rows can be spelled differently and still name the same
                        # declaration, and spelled the same and name different ones. The
                        # parser resolved both against their own modules; trust that when it
                        # disagreed, and keep the textual comparison for everything else.
                        install_identity_mismatch: bool = any identity_annotation in file.enum_annotations where identity_annotation.owner == "__effect_install_identity_mismatch" and identity_annotation.line == annotation.line
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.EffectHandlerMismatch, name: handler_name, line: annotation.line, expected: target_ref, actual: effect_ref}) if target_ref != "" and effect_ref != "" and (install_identity_mismatch or not ae_effect_ref_same_specialization(target_ref, effect_ref))
                expression_annotations: mutable darray[Ast::EnumAnnotation] = []
                for annotation in file.enum_annotations |expression_annotations|:
                    expression_annotations.push(annotation) if ae_expression_annotation(annotation)
                table <- ae_check_declarations(file.top_decls, expression_annotations, table)

include "./check_effect_signatures.elisa"
include "./check_effect_declarations.elisa"
include "./check_effect_handlers.elisa"
include "./check_effect_operation_heads.elisa"
