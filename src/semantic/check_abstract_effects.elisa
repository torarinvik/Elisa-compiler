# Stage1 abstract-effect validation. Effects are declaration-level operation families;
# concrete permissions remain the authority facts in ordinary `can` clauses. A handler
# installation is therefore checked in two dimensions: it must name a known handler for
# the granted abstract family, and every abstract operation call must have been lowered to
# that handler's direct operation function by the parser.

extend Semantic:
    private:
        # Add one effect row without making repeated handler-install scans grow the
        # function's requirement set. Stage1 keeps effect rows as source spellings;
        # `via` rows are added separately by collect_range.
        def ae_add_function_effect(table: lmut SymbolTable, owner: sview, effect_ref: sview) -> void:
            can Memory.Allocate, Abort.Panic:
                return if effect_ref == ""
                while row_index < table.function_effect_owner.count |row_index: usize = 0|:
                    return if table.function_effect_owner[row_index] == owner and table.function_effect_name[row_index] == effect_ref
                    row_index <- row_index + 1.usize()
                table.function_effect_owner <- table.function_effect_owner.push(owner)
                table.function_effect_name <- table.function_effect_name.push(effect_ref)

        def ae_install_handler_on_line(annotations: darray[Ast::EnumAnnotation]&, line: u32) -> sview:
            can Abort.Panic:
                for annotation in annotations:
                    annotation.name return if annotation.owner == "__effect_install" and annotation.line == line
                return ""

        def ae_install_effect_on_line(annotations: darray[Ast::EnumAnnotation]&, line: u32) -> sview:
            can Abort.Panic:
                for annotation in annotations:
                    annotation.name return if annotation.owner == "__effect_install_effect" and annotation.line == line
                return ""

        # Handler installations are visible requirements even though the operation
        # calls inside them have already been lowered to hidden direct functions. This
        # preserves the abstract effect in the enclosing function's contract and also
        # carries the handler's concrete authority rows to callers.
        def ae_collect_install_statements(owner: sview, statements: darray[Ast::Stmt], annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Block(kind, clause, binding, body, statement_pos):
                            if kind == "can":
                                installed: sview = ae_install_effect_on_line(annotations, statement_pos.line)
                                handler: sview = ae_install_handler_on_line(annotations, statement_pos.line)
                                if installed != "" and handler != "":
                                    table <- ae_add_function_effect(table, owner, installed)
                                    installed_concrete: sview = effect_ref_via(installed)
                                    table <- ae_add_function_effect(table, owner, installed_concrete) if installed_concrete != ""
                                    # A handler may declare its realization on the target
                                    # (`handler Sink for Writer[sview] via Console.Write`).
                                    # Treat that declaration as an authority fact at every
                                    # installation, even when the installation uses the
                                    # ergonomic bare form (`can Writer[sview] with Sink`).
                                    # This scan is deliberately performed here, after the
                                    # whole file has been parsed, so a forward handler
                                    # declaration carries the same facts as a preceding one.
                                    target_ref: sview = ae_handler_target(annotations, handler)
                                    target_concrete: sview = effect_ref_via(target_ref)
                                    table <- ae_add_function_effect(table, owner, target_concrete) if target_concrete != ""
                                    for annotation in annotations |table| -> table:
                                        continue if annotation.owner != handler or annotation.line != 3900000087
                                        concrete: mutable sview = effect_ref_via(annotation.name)
                                        concrete <- annotation.name if concrete == ""
                                        table <- ae_add_function_effect(table, owner, concrete)
                            table <- ae_collect_install_statements(owner, body, annotations, table)
                        Stmt.If(condition, then_body, else_body, statement_pos):
                            table <- ae_collect_install_statements(owner, then_body, annotations, table)
                            table <- ae_collect_install_statements(owner, else_body, annotations, table)
                        Stmt.While(condition, body, statement_pos):
                            table <- ae_collect_install_statements(owner, body, annotations, table)
                        Stmt.For(bind, variables, iterable, body, statement_pos):
                            table <- ae_collect_install_statements(owner, body, annotations, table)
                        Stmt.Match(scrutinee, arms, statement_pos):
                            for arm in arms |table| -> table:
                                table <- ae_collect_install_statements(owner, arm.body, annotations, table)
                        _:
                            pass

        def ae_collect_install_declarations(declarations: darray[Ast::Decl], annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(name, parameters, return_type, body, effects, decorators, declaration_pos):
                            table <- ae_collect_install_statements(name, body, annotations, table)
                        Decl.Module(name, body, declaration_pos):
                            table <- ae_collect_install_declarations(body, annotations, table)
                        Decl.Scoped(body, declaration_pos):
                            table <- ae_collect_install_declarations(body, annotations, table)
                        _:
                            pass

        def ae_effect_declared(annotations: darray[Ast::EnumAnnotation]&, effect_name: sview) -> bool:
            can Abort.Panic:
                return any annotation in annotations where annotation.owner == "__effect_decl" and annotation.name == effect_name

        def ae_effect_decl_line(annotations: darray[Ast::EnumAnnotation]&, effect_name: sview) -> u32:
            can Abort.Panic:
                for annotation in annotations:
                    return annotation.line if annotation.owner == "__effect_decl" and annotation.name == effect_name
                return 0

        def ae_builtin_permission_family(family: sview) -> bool:
            can Abort.Panic:
                return family in {"Progress", "Memory", "Abort", "Unsafe", "Sync", "Atomics", "Console", "Blocking", "Segment", "IO", "Time", "Panic", "Alloc", "Scalar", "ComplexFlow", "Global", "Thread", "Pool", "Parallel", "any"}

        def ae_permission_family_known(annotations: darray[Ast::EnumAnnotation]&, family: sview) -> bool:
            can Abort.Panic:
                return true if ae_builtin_permission_family(family)
                return any annotation in annotations where (annotation.owner == "__permission_decl" or annotation.owner == "__permission_param_decl") and annotation.name == family

        def ae_effect_ref_member(effect_ref: sview) -> sview:
            can Abort.Panic:
                dot: mutable usize = 0
                depth: mutable int = 0
                while dot < sview_len(effect_ref) |dot, depth|:
                    byte: u8 = sview_at(effect_ref, dot)
                    return effect_ref[dot + 1.usize():sview_len(effect_ref)] if byte == 46 and depth == 0
                    depth <- depth + 1 if byte == 91 or byte == 40 or byte == 123
                    depth <- depth - 1 if depth > 0 and (byte == 93 or byte == 41 or byte == 125)
                    dot <- dot + 1.usize()
                return ""

        def ae_permission_member_known(annotations: darray[Ast::EnumAnnotation]&, family: sview, member: sview) -> bool:
            can Abort.Panic:
                return true if member == ""
                # The compiler's builtin Console surface is intentionally closed. Other
                # builtin families retain their historical open-member behavior here; their
                # detailed member tables are owned by the existing Unsafe/Sync checks.
                return member == "Format" or member == "Write" if family == "Console"
                return true if ae_builtin_permission_family(family)
                return any annotation in annotations where annotation.owner == family and annotation.line == 3900000093 and annotation.name == member

        def ae_has_concrete_diagnostic(table: SymbolTable&, kind: DiagnosticKind, name: sview, expected: sview, actual: sview) -> bool:
            can Abort.Panic:
                for diagnostic in table.diagnostics:
                    return true if diagnostic.kind == kind and diagnostic.name == name and diagnostic.expected == expected and diagnostic.actual == actual
                return false

        # Validate one source effect row. A `via` row has two independent namespaces: its
        # left side must be a declared abstract family and its right side must be a known
        # concrete permission. Keeping these checks separate prevents a known permission from
        # accidentally making an undeclared abstract family look valid.
        def ae_validate_effect_ref(effect_ref: sview, line: u32, annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                abstract: sview = effect_ref_abstract(effect_ref)
                abstract_family: sview = effect_ref_family(abstract)
                concrete: mutable sview = effect_ref_via(effect_ref)
                has_via: bool = concrete != ""
                concrete <- effect_ref if concrete == ""
                family: sview = effect_ref_family(concrete)
                if has_via:
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AbstractEffectUnknown, name: abstract_family, line: line, expected: "effect", actual: ""}) if abstract_family != "" and not ae_effect_declared(annotations, abstract_family) and not ae_has_concrete_diagnostic(table, DiagnosticKind.AbstractEffectUnknown, abstract_family, "effect", "")
                if not has_via and ae_effect_declared(annotations, family):
                    abstract_member: sview = ae_effect_ref_member(effect_ref)
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AbstractEffectOperationMissing, name: abstract_member, line: line, expected: family, actual: "operation"}) if abstract_member != "" and not ae_operation_declared(annotations, family, abstract_member) and not ae_has_concrete_diagnostic(table, DiagnosticKind.AbstractEffectOperationMissing, abstract_member, family, "operation")
                    return
                return if concrete == "" or family == "" or (not has_via and ae_effect_declared(annotations, family))
                if not ae_permission_family_known(annotations, family):
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ConcreteEffectPermissionUnknown, name: concrete, line: line, expected: family, actual: ae_effect_ref_member(concrete)}) if not ae_has_concrete_diagnostic(table, DiagnosticKind.ConcreteEffectPermissionUnknown, concrete, family, ae_effect_ref_member(concrete))
                    return
                member: sview = ae_effect_ref_member(concrete)
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UnknownPermissionMember, name: family, line: line, expected: "", actual: member}) if member != "" and not ae_permission_member_known(annotations, family, member) and not ae_has_concrete_diagnostic(table, DiagnosticKind.UnknownPermissionMember, family, "", member)

        def ae_validate_effect_declarations(declarations: darray[Ast::Decl], annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table|:
                    match declaration:
                        Decl.Func(name, parameters, return_type, body, effects, decorators, declaration_pos):
                            for effect_ref in effects |table|:
                                table <- ae_validate_effect_ref(effect_ref, declaration_pos.line, annotations, table)
                        Decl.Module(name, body, declaration_pos):
                            table <- ae_validate_effect_declarations(body, annotations, table)
                        Decl.Scoped(body, declaration_pos):
                            table <- ae_validate_effect_declarations(body, annotations, table)
                        _:
                            pass

        def ae_validate_effect_blocks(statements: darray[Ast::Stmt], annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table|:
                    match statement:
                        Stmt.Block(kind, clause, binding, body, statement_pos):
                            if kind == "can" or kind == "trusted":
                                for effect_ref in clause |table|:
                                    table <- ae_validate_effect_ref(effect_ref, statement_pos.line, annotations, table)
                            table <- ae_validate_effect_blocks(body, annotations, table)
                        Stmt.If(condition, then_body, else_body, statement_pos):
                            table <- ae_validate_effect_blocks(then_body, annotations, table)
                            table <- ae_validate_effect_blocks(else_body, annotations, table)
                        Stmt.While(condition, body, statement_pos):
                            table <- ae_validate_effect_blocks(body, annotations, table)
                        Stmt.For(bind, variables, iterable, body, statement_pos):
                            table <- ae_validate_effect_blocks(body, annotations, table)
                        Stmt.Match(scrutinee, arms, statement_pos):
                            for arm in arms |table|:
                                table <- ae_validate_effect_blocks(arm.body, annotations, table)
                        _:
                            pass

        def ae_validate_effect_blocks_declarations(declarations: darray[Ast::Decl], annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table|:
                    match declaration:
                        Decl.Func(name, parameters, return_type, body, effects, decorators, declaration_pos):
                            table <- ae_validate_effect_blocks(body, annotations, table)
                        Decl.Module(name, body, declaration_pos):
                            table <- ae_validate_effect_blocks_declarations(body, annotations, table)
                        Decl.Scoped(body, declaration_pos):
                            table <- ae_validate_effect_blocks_declarations(body, annotations, table)
                        _:
                            pass

        def ae_operation_declared(annotations: darray[Ast::EnumAnnotation]&, effect_name: sview, operation: sview) -> bool:
            can Abort.Panic:
                return any annotation in annotations where annotation.line == 3900000081 and annotation.owner == effect_name and annotation.name == operation

        def ae_duplicate_operation_declared(annotations: darray[Ast::EnumAnnotation]&, effect_name: sview, operation: sview) -> bool:
            can Abort.Panic:
                seen: mutable bool = false
                for annotation in annotations |seen|:
                    if annotation.line == 3900000081 and annotation.owner == effect_name and annotation.name == operation:
                        return true if seen
                        seen <- true
                return false

        # The compact AST intentionally does not materialize an abstract effect body. The
        # parser therefore keeps each operation's source signature in an ordinal side-table
        # (3900000081 name, 3900000082 signature). Resolve that signature without introducing
        # a second declaration namespace or a runtime effect descriptor.
        def ae_effect_operation_signature(annotations: darray[Ast::EnumAnnotation]&, effect_name: sview, operation: sview) -> sview:
            wanted: mutable usize = 0
            operation_index: mutable usize = 0
            found: mutable bool = false
            for annotation in annotations |wanted, operation_index, found|:
                if annotation.owner == effect_name and annotation.line == 3900000081:
                    wanted <- operation_index if not found and annotation.name == operation
                    found <- true if annotation.name == operation
                    operation_index <- operation_index + 1.usize()
            return sview("", 0, 0) if not found
            signature_index: mutable usize = 0
            for annotation in annotations |signature_index, wanted|:
                if annotation.owner == effect_name and annotation.line == 3900000082:
                    return annotation.name if signature_index == wanted
                    signature_index <- signature_index + 1.usize()
            return sview("", 0, 0)

        def ae_handler_operation_signature(annotations: darray[Ast::EnumAnnotation]&, handler_name: sview, operation: sview) -> sview:
            wanted: mutable usize = 0
            operation_index: mutable usize = 0
            found: mutable bool = false
            for annotation in annotations |wanted, operation_index, found|:
                if annotation.owner == handler_name and annotation.line == 3900000083:
                    wanted <- operation_index if not found and annotation.name == operation
                    found <- true if annotation.name == operation
                    operation_index <- operation_index + 1.usize()
            return sview("", 0, 0) if not found
            signature_index: mutable usize = 0
            for annotation in annotations |signature_index, wanted|:
                if annotation.owner == handler_name and annotation.line == 3900000089:
                    return annotation.name if signature_index == wanted
                    signature_index <- signature_index + 1.usize()
            return sview("", 0, 0)

        def ae_effect_generic_names(annotations: darray[Ast::EnumAnnotation]&, effect_name: sview) -> darray[sview]:
            can Memory.Allocate, Abort.Panic:
                names: mutable darray[sview] = []
                for annotation in annotations |names|:
                    names.push(annotation.name) if annotation.owner == effect_name and annotation.line == 3900000090
                return names

        def ae_trim_signature_view(view: sview) -> sview:
            start: mutable usize = 0
            finish: mutable usize = sview_len(view)
            while start < finish and (sview_at(view, start) == 32 or sview_at(view, start) == 9 or sview_at(view, start) == 13) |start, finish, view|:
                start <- start + 1.usize()
            while finish > start and (sview_at(view, finish - 1.usize()) == 32 or sview_at(view, finish - 1.usize()) == 9 or sview_at(view, finish - 1.usize()) == 13) |finish, start, view|:
                finish <- finish - 1.usize()
            return view[start:finish]

        # Extract `Writer[sview, File]`'s application arguments. The result is a list of
        # source views, so no type/value is allocated and the realization remains compile-time
        # metadata only.
        def ae_effect_ref_arguments(effect_ref: sview) -> darray[sview]:
            can Memory.Allocate, Abort.Panic:
                values: mutable darray[sview] = []
                open_bracket: mutable usize = 0
                while open_bracket < sview_len(effect_ref) and sview_at(effect_ref, open_bracket) != 91 |open_bracket, effect_ref|:
                    open_bracket <- open_bracket + 1.usize()
                return values if open_bracket >= sview_len(effect_ref)
                start: mutable usize = open_bracket + 1.usize()
                cursor: mutable usize = start
                depth: mutable int = 0
                while cursor < sview_len(effect_ref) |cursor, start, depth, effect_ref, values|:
                    byte: u8 = sview_at(effect_ref, cursor)
                    at_end: bool = byte == 93 and depth == 0
                    at_comma: bool = byte == 44 and depth == 0
                    if at_end or at_comma:
                        item: sview = ae_trim_signature_view(effect_ref[start:cursor])
                        values.push(item) if sview_len(item) > 0
                        break if at_end
                        start <- cursor + 1.usize()
                    depth <- depth + 1 if byte == 91 or byte == 40 or byte == 123
                    depth <- depth - 1 if depth > 0 and (byte == 93 or byte == 41 or byte == 125)
                    cursor <- cursor + 1.usize()
                return values

        def ae_signature_ident_byte(byte: u8) -> bool:
            return true if byte >= 65 and byte <= 90
            return true if byte >= 97 and byte <= 122
            return true if byte >= 48 and byte <= 57
            return byte == 95

        def ae_signature_word_at(signature: sview, start: usize, word: sview) -> bool:
            return false if start + sview_len(word) > sview_len(signature)
            return false if start > 0.usize() and ae_signature_ident_byte(sview_at(signature, start - 1.usize()))
            index: mutable usize = 0
            while index < sview_len(word) |index, signature, word|:
                return false if sview_at(signature, start + index) != sview_at(word, index)
                index <- index + 1.usize()
            return false if start + sview_len(word) < sview_len(signature) and ae_signature_ident_byte(sview_at(signature, start + sview_len(word)))
            return true

        def ae_signature_word_in_range(signature: sview, start: usize, end: usize, word: sview) -> bool:
            cursor: mutable usize = start
            while cursor < end |cursor, signature, end, word|:
                if ae_signature_ident_byte(sview_at(signature, cursor)):
                    word_start: usize = cursor
                    while cursor < end and ae_signature_ident_byte(sview_at(signature, cursor)) |cursor, signature, end|:
                        cursor <- cursor + 1.usize()
                    word_length: usize = cursor - word_start
                    if word_length == sview_len(word):
                        matches: mutable bool = true
                        for word_index in 0..<word_length |matches, signature, word, word_start|:
                            matches <- false if sview_at(signature, word_start + word_index) != sview_at(word, word_index)
                        return true if matches
                else:
                    cursor <- cursor + 1.usize()
            return false

        def ae_signature_append_range(signature: sview, start: usize, end: usize, out: mutable darray[u8]&) -> void:
            for index in start..<end |signature, out|:
                byte: u8 = sview_at(signature, index)
                out.push(byte) if byte != 32 and byte != 9 and byte != 13

        def ae_signature_generic_index(signature: sview, start: usize, end: usize, names: darray[sview]) -> i64:
            candidate_length: usize = end - start
            for name_index in 0..<names.count |name_index, signature, start, candidate_length|:
                continue if sview_len(names[name_index]) != candidate_length
                matches: mutable bool = true
                for character_index in 0..<candidate_length |matches, signature, names, name_index, start|:
                    matches <- false if sview_at(signature, start + character_index) != sview_at(names[name_index], character_index)
                return name_index.i64() if matches
            return -1

        # Append a type spelling while specializing exact effect parameters (`T` -> `sview`,
        # including nested forms such as `darray[T]`). Generic names are tokenized here so a
        # type named `Task` cannot accidentally substitute a parameter named `T`.
        def ae_signature_append_type_range(signature: sview, start: usize, end: usize, names: darray[sview], values: darray[sview], out: mutable darray[u8]&) -> void:
            cursor: mutable usize = start
            while cursor < end |cursor, signature, end, names, values, out|:
                if ae_signature_ident_byte(sview_at(signature, cursor)):
                    word_start: usize = cursor
                    while cursor < end and ae_signature_ident_byte(sview_at(signature, cursor)) |cursor, signature, end|:
                        cursor <- cursor + 1.usize()
                    generic_index: i64 = ae_signature_generic_index(signature, word_start, cursor, names)
                    if generic_index >= 0 and generic_index.usize() < values.count:
                        ae_signature_append_range(values[generic_index.usize()], 0, sview_len(values[generic_index.usize()]), out)
                    else:
                        ae_signature_append_range(signature, word_start, cursor, out)
                else:
                    byte: u8 = sview_at(signature, cursor)
                    out.push(byte) if byte != 32 and byte != 9 and byte != 13
                    cursor <- cursor + 1.usize()

        # Build an ABI-relevant operation shape: parameter count, mutability, parameter type
        # spellings, and return type. Parameter NAMES, default values, handler-local effect
        # grants, and the declaration body's trailing colon are excluded. This is deliberately
        # a small signature lexer rather than a general parser: nested tuple/function/container
        # types are retained byte-for-byte after whitespace normalization.
        def ae_signature_shape(signature: sview, generic_names: darray[sview], generic_values: darray[sview]) -> darray[u8]:
            can Memory.Allocate, Abort.Panic:
                out: mutable darray[u8] = []
                out.push(80) # P
                open_paren: mutable usize = 0
                while open_paren < sview_len(signature) and sview_at(signature, open_paren) != 40 |open_paren, signature|:
                    open_paren <- open_paren + 1.usize()
                if open_paren < sview_len(signature):
                    close_paren: mutable usize = open_paren + 1.usize()
                    depth: mutable int = 1
                    while close_paren < sview_len(signature) and depth > 0 |close_paren, depth, signature|:
                        depth <- depth + 1 if sview_at(signature, close_paren) == 40
                        depth <- depth - 1 if sview_at(signature, close_paren) == 41
                        close_paren <- close_paren + 1.usize()
                    close_paren <- close_paren - 1.usize() if close_paren > open_paren and depth == 0
                    parameter_start: mutable usize = open_paren + 1.usize()
                    cursor: mutable usize = parameter_start
                    nested: mutable int = 0
                    while cursor <= close_paren and cursor <= sview_len(signature) |cursor, parameter_start, nested, close_paren, signature, out|:
                        at_end: bool = cursor == close_paren or cursor >= sview_len(signature)
                        at_separator: bool = not at_end and nested == 0 and sview_at(signature, cursor) == 44
                        if at_end or at_separator:
                            segment_end: usize = cursor
                            has_content: mutable bool = false
                            for content_index in parameter_start..<segment_end |has_content, signature|:
                                byte: u8 = sview_at(signature, content_index)
                                has_content <- true if byte != 32 and byte != 9 and byte != 13
                            if has_content:
                                colon: mutable usize = segment_end
                                segment_depth: mutable int = 0
                                scan: mutable usize = parameter_start
                                while scan < segment_end |scan, colon, segment_depth, signature, segment_end|:
                                    byte: u8 = sview_at(signature, scan)
                                    colon <- scan if byte == 58 and segment_depth == 0 and colon == segment_end
                                    segment_depth <- segment_depth + 1 if byte == 40 or byte == 91 or byte == 123
                                    segment_depth <- segment_depth - 1 if segment_depth > 0 and (byte == 41 or byte == 93 or byte == 125)
                                    scan <- scan + 1.usize()
                                out.push(59) # ; starts one parameter
                                if colon < segment_end:
                                    out.push(77) if ae_signature_word_in_range(signature, parameter_start, colon, "mutable")
                                    type_start: usize = colon + 1.usize()
                                    type_end: mutable usize = segment_end
                                    type_depth: mutable int = 0
                                    type_scan: mutable usize = type_start
                                    while type_scan < segment_end |type_scan, type_end, type_depth, signature, segment_end|:
                                        type_byte: u8 = sview_at(signature, type_scan)
                                        type_end <- type_scan if type_byte == 61 and type_depth == 0
                                        type_depth <- type_depth + 1 if type_byte == 40 or type_byte == 91 or type_byte == 123
                                        type_depth <- type_depth - 1 if type_depth > 0 and (type_byte == 41 or type_byte == 93 or type_byte == 125)
                                        type_scan <- type_scan + 1.usize()
                                    ae_signature_append_type_range(signature, type_start, type_end, generic_names, generic_values, out)
                                else:
                                    # An untyped/variadic operation parameter is not a valid
                                    # effect ABI, but preserving its spelling makes the mismatch
                                    # deterministic instead of silently accepting it.
                                    ae_signature_append_range(signature, parameter_start, segment_end, out)
                            parameter_start <- cursor + 1.usize()
                        nested <- nested + 1 if not at_end and sview_at(signature, cursor) == 40 or (not at_end and sview_at(signature, cursor) == 91) or (not at_end and sview_at(signature, cursor) == 123)
                        nested <- nested - 1 if not at_end and nested > 0 and (sview_at(signature, cursor) == 41 or sview_at(signature, cursor) == 93 or sview_at(signature, cursor) == 125)
                        cursor <- cursor + 1.usize()
                    arrow: mutable usize = close_paren + 1.usize()
                    while arrow + 1.usize() < sview_len(signature) |arrow, signature|:
                        break if sview_at(signature, arrow) == 45 and sview_at(signature, arrow + 1.usize()) == 62
                        arrow <- arrow + 1.usize()
                    out.push(82) # R
                    if arrow + 1.usize() < sview_len(signature):
                        return_start: usize = arrow + 2.usize()
                        return_end: mutable usize = sview_len(signature)
                        return_depth: mutable int = 0
                        return_scan: mutable usize = return_start
                        while return_scan < sview_len(signature) |return_scan, return_end, return_depth, signature|:
                            return_byte: u8 = sview_at(signature, return_scan)
                            break_at_clause: mutable bool = return_byte == 58 and return_depth == 0
                            break_at_clause <- true if return_depth == 0 and (ae_signature_word_at(signature, return_scan, "can") or ae_signature_word_at(signature, return_scan, "requires") or ae_signature_word_at(signature, return_scan, "ensures") or ae_signature_word_at(signature, return_scan, "decreases"))
                            return_end <- return_scan if break_at_clause
                            return_depth <- return_depth + 1 if return_byte == 40 or return_byte == 91 or return_byte == 123
                            return_depth <- return_depth - 1 if return_depth > 0 and (return_byte == 41 or return_byte == 93 or return_byte == 125)
                            return_scan <- return_scan + 1.usize()
                        ae_signature_append_type_range(signature, return_start, return_end, generic_names, generic_values, out)
                    else:
                        out.extend("void")
                else:
                    out.extend("P;Rvoid")
                return out

        def ae_signature_matches(left: sview, right: sview, generic_names: darray[sview], generic_values: darray[sview]) -> bool:
            can Memory.Allocate, Abort.Panic:
                no_generic_names: darray[sview] = []
                no_generic_values: darray[sview] = []
                left_shape: darray[u8] = ae_signature_shape(left, generic_names, generic_values)
                right_shape: darray[u8] = ae_signature_shape(right, no_generic_names, no_generic_values)
                return false if left_shape.count != right_shape.count
                for index in 0..<left_shape.count |left_shape, right_shape|:
                    return false if left_shape[index] != right_shape[index]
                return true

        def ae_handler_declared(annotations: darray[Ast::EnumAnnotation]&, handler_name: sview) -> bool:
            can Abort.Panic:
                return any annotation in annotations where annotation.owner == "__handler_decl" and annotation.name == handler_name

        def ae_handler_target(annotations: darray[Ast::EnumAnnotation]&, handler_name: sview) -> sview:
            can Abort.Panic:
                while index < annotations.count |index: usize = 0|:
                    annotation: Ast::EnumAnnotation = annotations[index]
                    annotation.name return if annotation.line == 3900000084 and annotation.owner == handler_name
                    index <- index + 1
                return ""

        def ae_handler_decl_line(annotations: darray[Ast::EnumAnnotation]&, handler_name: sview) -> u32:
            can Abort.Panic:
                while index < annotations.count |index: usize = 0|:
                    annotation: Ast::EnumAnnotation = annotations[index]
                    return annotation.line if annotation.owner == "__handler_decl" and annotation.name == handler_name
                    index <- index + 1
                return 0

        def ae_handler_capture_counts(annotations: darray[Ast::EnumAnnotation]&, handler_name: sview, required: mutable u32&, total: mutable u32&) -> void:
            can Abort.Panic:
                while index < annotations.count |index: usize = 0|:
                    annotation: Ast::EnumAnnotation = annotations[index]
                    required <- annotation.line if annotation.owner == "__handler_capture_required" and annotation.name == handler_name
                    total <- annotation.line if annotation.owner == "__handler_capture_total" and annotation.name == handler_name
                    index <- index + 1

        # The capture count marker follows the matching install marker. Searching only
        # until the next installation keeps separate installations of different handlers
        # independent, while avoiding any runtime-shaped metadata in the AST.
        def ae_install_capture_count_after(annotations: darray[Ast::EnumAnnotation]&, handler_name: sview, install_line: u32) -> u32:
            can Abort.Panic:
                found_install: mutable bool = false
                while index < annotations.count |index: usize = 0, found_install|:
                    annotation: Ast::EnumAnnotation = annotations[index]
                    if not found_install:
                        found_install <- true if annotation.owner == "__effect_install" and annotation.name == handler_name and annotation.line == install_line
                    else:
                        return 0 if annotation.owner == "__effect_install"
                        return annotation.line if annotation.owner == "__effect_install_capture_count" and annotation.name == handler_name
                    index <- index + 1
                return 0

        # Handler selection is a compile-time specialization, so the family and
        # every generic argument must agree. Whitespace inside the brackets is
        # insignificant, matching the formatter's normalized type spelling.
        def ae_effect_ref_same_specialization(left: sview, right: sview) -> bool:
            left_abstract: sview = effect_ref_abstract(left)
            right_abstract: sview = effect_ref_abstract(right)
            left_family: sview = effect_ref_family(left_abstract)
            right_family: sview = effect_ref_family(right_abstract)
            return false if left_family != right_family
            left_bracket: mutable usize = sview_len(left_abstract)
            right_bracket: mutable usize = sview_len(right_abstract)
            while left_bracket > 0.usize():
                left_bracket <- left_bracket - 1.usize()
                break if sview_at(left_abstract, left_bracket) == 91
            while right_bracket > 0.usize():
                right_bracket <- right_bracket - 1.usize()
                break if sview_at(right_abstract, right_bracket) == 91
            return true if left_bracket == 0.usize() and right_bracket == 0.usize()
            return false if left_bracket == 0.usize() or right_bracket == 0.usize()
            left_index: mutable usize = left_bracket
            right_index: mutable usize = right_bracket
            while left_index < sview_len(left_abstract) and right_index < sview_len(right_abstract) |left_index, right_index|:
                while left_index < sview_len(left_abstract) and (sview_at(left_abstract, left_index) == 32 or sview_at(left_abstract, left_index) == 9) |left_index|:
                    left_index <- left_index + 1.usize()
                while right_index < sview_len(right_abstract) and (sview_at(right_abstract, right_index) == 32 or sview_at(right_abstract, right_index) == 9) |right_index|:
                    right_index <- right_index + 1.usize()
                return false if left_index >= sview_len(left_abstract) or right_index >= sview_len(right_abstract)
                return false if sview_at(left_abstract, left_index) != sview_at(right_abstract, right_index)
                left_index <- left_index + 1.usize()
                right_index <- right_index + 1.usize()
            while left_index < sview_len(left_abstract) and (sview_at(left_abstract, left_index) == 32 or sview_at(left_abstract, left_index) == 9) |left_index|:
                left_index <- left_index + 1.usize()
            while right_index < sview_len(right_abstract) and (sview_at(right_abstract, right_index) == 32 or sview_at(right_abstract, right_index) == 9) |right_index|:
                right_index <- right_index + 1.usize()
            return left_index == sview_len(left_abstract) and right_index == sview_len(right_abstract)

        # Return the family head of an abstract-effect namespace expression. Generic effect
        # applications are represented by the ordinary expression index nodes in the compact
        # AST (`Writer[sview]`), so they must be recognized here even though the zero-overhead
        # call rewriter currently accepts the canonical `Writer.write(...)` spelling.
        def ae_operation_head(expression: Ast::Expr, effect_name: mutable sview&) -> bool:
            can Abort.Panic:
                match expression:
                    Expr.Ident(owner, owner_pos):
                        effect_name <- owner
                        return true
                    Expr.Index(Expr.Ident(owner, owner_pos), index, index_pos):
                        effect_name <- owner
                        return true
                    Expr.IndexN(Expr.Ident(owner, owner_pos), arguments, index_n_pos):
                        effect_name <- owner
                        return true
                    _:
                        pass
                return false

        # Whether an operation head used an explicit generic specialization. Bare
        # `Writer.write` remains an inferred family-level operation; `Writer[T].write`
        # carries a count that must agree with `effect Writer[...]` before lowering.
        def ae_operation_head_is_explicit(expression: Ast::Expr, argument_count: mutable u32&) -> bool:
            match expression:
                Expr.Index(Expr.Ident(effect_name, effect_pos), index, index_pos):
                    argument_count <- 1
                    return true
                Expr.IndexN(Expr.Ident(effect_name_n, effect_pos_n), arguments, index_n_pos):
                    argument_count <- arguments.count.u32()
                    return true
                _:
                    return false

        def ae_call_explicit_specialization(expression: Ast::Expr, argument_count: mutable u32&) -> bool:
            match expression:
                Expr.Call(callee, arguments, argument_names, call_pos):
                    match callee:
                        Expr.Field(head, member, field_pos):
                            return ae_operation_head_is_explicit(head, argument_count)
                        Expr.Scope(head, member_scope, scope_pos):
                            return ae_operation_head_is_explicit(head, argument_count)
                        _:
                            pass
                _:
                    pass
            return false

        def ae_call_is_operation(expression: Ast::Expr, effect_name: mutable sview&, operation: mutable sview&, line: mutable u32&) -> bool:
            can Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, call_pos):
                        match callee:
                            Expr.Field(head, member, field_pos):
                                if ae_operation_head(head, effect_name):
                                    operation <- member
                                    line <- call_pos.line
                                    return true
                            Expr.Scope(head, member, scope_pos):
                                if ae_operation_head(head, effect_name):
                                    operation <- member
                                    line <- call_pos.line
                                    return true
                            _:
                                pass
                    _:
                        pass
                return false

        def ae_value_is_operation(expression: Ast::Expr, effect_name: mutable sview&, operation: mutable sview&, line: mutable u32&) -> bool:
            can Abort.Panic:
                match expression:
                    Expr.Field(head, member, field_pos):
                        if ae_operation_head(head, effect_name):
                            operation <- member
                            line <- field_pos.line
                            return true
                    Expr.Scope(head, member, scope_pos):
                        if ae_operation_head(head, effect_name):
                            operation <- member
                            line <- scope_pos.line
                            return true
                    _:
                        pass
                return false

        def ae_specialization_mismatch_on_line(annotations: darray[Ast::EnumAnnotation]&, line: u32) -> sview:
            can Abort.Panic:
                for annotation in annotations:
                    annotation.name return if annotation.owner == "__effect_specialization_mismatch" and annotation.line == line
                return ""

        def ae_is_hidden_handler_name(name: sview) -> bool:
            return sview_len(name) >= 11.usize() and name[0:11] == "__handler__"

        def ae_check_expression(expression: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                effect_name: mutable sview = ""
                operation: mutable sview = ""
                line: mutable u32 = 0
                if ae_call_is_operation(expression, effect_name, operation, line):
                    if ae_effect_declared(annotations, effect_name) and not ae_operation_declared(annotations, effect_name, operation):
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AbstractEffectOperationMissing, name: operation, line: line, expected: effect_name, actual: "operation"})
                    if ae_effect_declared(annotations, effect_name) and ae_operation_declared(annotations, effect_name, operation):
                        explicit_count: mutable u32 = 0
                        is_explicit: bool = ae_call_explicit_specialization(expression, explicit_count)
                        generic_count: u32 = ae_effect_generic_names(annotations, effect_name).count.u32()
                        has_arity_mismatch: bool = is_explicit and generic_count != explicit_count
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AbstractEffectSpecializationArity, name: operation, line: line, expected: effect_name, actual: "operation", expected_count: generic_count, actual_count: explicit_count}) if has_arity_mismatch
                        mismatch_effect: sview = ae_specialization_mismatch_on_line(annotations, line)
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AbstractEffectSpecializationMismatch, name: operation, line: line, expected: mismatch_effect, actual: effect_name}) if not has_arity_mismatch and mismatch_effect != ""
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AbstractEffectUnhandled, name: operation, line: line, expected: effect_name, actual: effect_name}) if not has_arity_mismatch and mismatch_effect == ""
                match expression:
                    Expr.Call(callee, arguments, argument_names, call_pos):
                        # A direct abstract operation call is checked above. Do not visit its
                        # callee as a value as well: the same `Effect.op` syntax denotes an
                        # operation only in this call position.
                        table <- ae_check_expression(callee, annotations, table) if not ae_call_is_operation(expression, effect_name, operation, line)
                        for argument in arguments |table|:
                            table <- ae_check_expression(argument, annotations, table)
                    Expr.Ident(name, ident_pos):
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AbstractEffectImplementationAccess, name: name, line: ident_pos.line, expected: "", actual: ""}) if ident_pos.line != 0 and ae_is_hidden_handler_name(name)
                    Expr.Field(object, field, field_pos):
                        if ae_value_is_operation(expression, effect_name, operation, line) and ae_effect_declared(annotations, effect_name):
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AbstractEffectOperationMissing, name: operation, line: line, expected: effect_name, actual: "operation"}) if not ae_operation_declared(annotations, effect_name, operation)
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AbstractEffectValue, name: operation, line: line, expected: effect_name, actual: operation}) if ae_operation_declared(annotations, effect_name, operation)
                        table <- ae_check_expression(object, annotations, table)
                    Expr.Scope(object, field, field_pos):
                        if ae_value_is_operation(expression, effect_name, operation, line) and ae_effect_declared(annotations, effect_name):
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AbstractEffectOperationMissing, name: operation, line: line, expected: effect_name, actual: "operation"}) if not ae_operation_declared(annotations, effect_name, operation)
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AbstractEffectValue, name: operation, line: line, expected: effect_name, actual: operation}) if ae_operation_declared(annotations, effect_name, operation)
                        table <- ae_check_expression(object, annotations, table)
                    Expr.Index(object, index, index_pos):
                        table <- ae_check_expression(object, annotations, table)
                        table <- ae_check_expression(index, annotations, table)
                    Expr.Slice(object, low, high, slice_pos):
                        table <- ae_check_expression(object, annotations, table)
                        table <- ae_check_expression(low, annotations, table)
                        table <- ae_check_expression(high, annotations, table)
                    Expr.IndexN(object, arguments, index_pos):
                        table <- ae_check_expression(object, annotations, table)
                        for argument in arguments |table|:
                            table <- ae_check_expression(argument, annotations, table)
                    Expr.Binary(left, operator, right, binary_pos):
                        table <- ae_check_expression(left, annotations, table)
                        table <- ae_check_expression(right, annotations, table)
                    Expr.Unary(operator, operand, unary_pos):
                        table <- ae_check_expression(operand, annotations, table)
                    Expr.Move(operand, move_pos):
                        table <- ae_check_expression(operand, annotations, table)
                    Expr.RegionNew(operand, region, new_pos):
                        table <- ae_check_expression(operand, annotations, table)
                    Expr.Paren(inner, paren_pos):
                        table <- ae_check_expression(inner, annotations, table)
                    Expr.Array(elements, array_pos):
                        for element in elements |table|:
                            table <- ae_check_expression(element, annotations, table)
                    Expr.Tuple(elements, tuple_pos):
                        for element in elements |table|:
                            table <- ae_check_expression(element, annotations, table)
                    Expr.SetLit(elements, set_pos):
                        for element in elements |table|:
                            table <- ae_check_expression(element, annotations, table)
                    Expr.DictLit(entries, dict_pos):
                        for entry in entries |table|:
                            table <- ae_check_expression(entry.key, annotations, table)
                            table <- ae_check_expression(entry.value, annotations, table)
                    Expr.Construct(type_expression, fields, construct_pos):
                        table <- ae_check_expression(type_expression, annotations, table)
                        for field in fields |table|:
                            table <- ae_check_expression(field.value, annotations, table)
                    Expr.RecordUpdate(base, fields, update_pos):
                        table <- ae_check_expression(base, annotations, table)
                        for field in fields |table|:
                            table <- ae_check_expression(field.value, annotations, table)
                    Expr.If(condition, then_expr, else_expr, if_pos):
                        table <- ae_check_expression(condition, annotations, table)
                        table <- ae_check_expression(then_expr, annotations, table)
                        table <- ae_check_expression(else_expr, annotations, table)
                    Expr.Comprehension(variable, iterable, condition, body, comprehension_pos):
                        table <- ae_check_expression(iterable, annotations, table)
                        table <- ae_check_expression(condition, annotations, table)
                        table <- ae_check_expression(body, annotations, table)
                    Expr.Refinement(base, predicate, refinement_pos):
                        table <- ae_check_expression(base, annotations, table)
                        table <- ae_check_expression(predicate, annotations, table)
                    Expr.GetElse(guarded, recovery, get_pos):
                        table <- ae_check_expression(guarded, annotations, table)
                        table <- ae_check_statements(recovery, annotations, table)
                    Expr.Lambda(parameters, body, lambda_pos):
                        table <- ae_check_statements(body, annotations, table)
                    Expr.Block(statements, value, captures, block_pos):
                        table <- ae_check_statements(statements, annotations, table)
                        table <- ae_check_expression(value, annotations, table)
                    Expr.Match(scrutinee, arms, match_pos):
                        table <- ae_check_expression(scrutinee, annotations, table)
                        for arm in arms |table|:
                            table <- ae_check_expression(arm.guard, annotations, table)
                            table <- ae_check_statements(arm.body, annotations, table)
                    Expr.Catch(guarded, arms, catch_pos):
                        table <- ae_check_expression(guarded, annotations, table)
                        for arm in arms |table|:
                            table <- ae_check_expression(arm.guard, annotations, table)
                            table <- ae_check_statements(arm.body, annotations, table)
                    _:
                        pass

        def ae_check_statements(statements: darray[Ast::Stmt], annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table|:
                    match statement:
                        Stmt.Expr(expression, statement_pos):
                            table <- ae_check_expression(expression, annotations, table)
                        Stmt.VarDecl(name, type_expression, value, statement_pos):
                            table <- ae_check_expression(type_expression, annotations, table)
                            table <- ae_check_expression(value, annotations, table)
                        Stmt.Assign(target, operator, value, statement_pos):
                            table <- ae_check_expression(target, annotations, table)
                            table <- ae_check_expression(value, annotations, table)
                        Stmt.If(condition, then_body, else_body, statement_pos):
                            table <- ae_check_expression(condition, annotations, table)
                            table <- ae_check_statements(then_body, annotations, table)
                            table <- ae_check_statements(else_body, annotations, table)
                        Stmt.While(condition, body, statement_pos):
                            table <- ae_check_expression(condition, annotations, table)
                            table <- ae_check_statements(body, annotations, table)
                        Stmt.For(bind, variables, iterable, body, statement_pos):
                            table <- ae_check_expression(iterable, annotations, table)
                            table <- ae_check_statements(body, annotations, table)
                        Stmt.Block(kind, clause, binding, body, statement_pos):
                            table <- ae_check_statements(body, annotations, table)
                        Stmt.Return(value, statement_pos):
                            table <- ae_check_expression(returned_value, annotations, table) if value is returned_value
                        Stmt.Match(scrutinee, arms, statement_pos):
                            table <- ae_check_expression(scrutinee, annotations, table)
                            for arm in arms |table|:
                                table <- ae_check_expression(arm.guard, annotations, table)
                                table <- ae_check_statements(arm.body, annotations, table)
                        Stmt.Contract(kind, expression, statement_pos):
                            table <- ae_check_expression(expression, annotations, table)
                        _:
                            pass

        def ae_check_declarations(declarations: darray[Ast::Decl], annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table|:
                    match declaration:
                        Decl.Func(name, parameters, return_type, body, effects, decorators, declaration_pos):
                            table <- ae_check_statements(body, annotations, table)
                        Decl.Module(name, body, declaration_pos):
                            table <- ae_check_declarations(body, annotations, table)
                        Decl.Scoped(body, declaration_pos):
                            table <- ae_check_declarations(body, annotations, table)
                        _:
                            pass

        def check_abstract_effects(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- ae_validate_effect_declarations(file.top_decls, file.enum_annotations, table)
                table <- ae_validate_effect_blocks_declarations(file.top_decls, file.enum_annotations, table)
                table <- ae_collect_install_declarations(file.top_decls, file.enum_annotations, table)
                # Validate handler declarations and their operation coverage.
                for annotation in file.enum_annotations |table|:
                    if annotation.line == 3900000081:
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.DuplicateAbstractEffectOperation, name: annotation.name, line: ae_effect_decl_line(file.enum_annotations, annotation.owner), expected: annotation.owner, actual: "operation"}) if ae_duplicate_operation_declared(file.enum_annotations, annotation.owner, annotation.name)
                    if annotation.line == 3900000084:
                        target: sview = effect_ref_family(annotation.name)
                        handler_line: u32 = ae_handler_decl_line(file.enum_annotations, annotation.owner)
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UnknownInterface, name: target, line: handler_line, expected: "effect", actual: ""}) if target != "" and not ae_effect_declared(file.enum_annotations, target)
                        target_concrete: sview = effect_ref_via(annotation.name)
                        table <- ae_validate_effect_ref(target_concrete, handler_line, file.enum_annotations, table) if target_concrete != ""
                    if annotation.line == 3900000083:
                        target_ref: sview = ae_handler_target(file.enum_annotations, annotation.owner)
                        target: sview = effect_ref_family(target_ref)
                        operation_known: bool = ae_operation_declared(file.enum_annotations, target, annotation.name)
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AbstractEffectOperationMissing, name: annotation.name, line: ae_handler_decl_line(file.enum_annotations, annotation.owner), expected: target, actual: "operation"}) if target != "" and ae_effect_declared(file.enum_annotations, target) and not operation_known
                        effect_signature: sview = ae_effect_operation_signature(file.enum_annotations, target, annotation.name)
                        handler_signature: sview = ae_handler_operation_signature(file.enum_annotations, annotation.owner, annotation.name)
                        effect_generic_names: darray[sview] = ae_effect_generic_names(file.enum_annotations, target)
                        effect_generic_values: darray[sview] = ae_effect_ref_arguments(target_ref)
                        specialization_arity_mismatch: bool = operation_known and effect_generic_names.count != effect_generic_values.count
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AbstractEffectSpecializationArity, name: annotation.owner, line: ae_handler_decl_line(file.enum_annotations, annotation.owner), expected: target, actual: target_ref, expected_count: effect_generic_names.count.u32(), actual_count: effect_generic_values.count.u32()}) if specialization_arity_mismatch
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.EffectHandlerSignatureMismatch, name: annotation.name, line: ae_handler_decl_line(file.enum_annotations, annotation.owner), expected: effect_signature, actual: annotation.owner}) if operation_known and not specialization_arity_mismatch and effect_signature != "" and handler_signature != "" and not ae_signature_matches(effect_signature, handler_signature, effect_generic_names, effect_generic_values)
                    if annotation.line == 3900000091:
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.EffectHandlerResumeInvalid, name: annotation.name, line: ae_handler_decl_line(file.enum_annotations, annotation.owner), expected: "use exactly one final resume() statement", actual: annotation.owner})
                    if annotation.line == 3900000092:
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.EffectHandlerResumeInvalid, name: annotation.name, line: ae_handler_decl_line(file.enum_annotations, annotation.owner), expected: "the operation must return void", actual: annotation.owner})
                    if annotation.owner == "__effect_install":
                        handler_name: sview = annotation.name
                        effect_ref: mutable sview = ""
                        while effect_index < file.enum_annotations.count |effect_index: usize = 0|:
                            effect_annotation: Ast::EnumAnnotation = file.enum_annotations[effect_index]
                            effect_ref <- effect_annotation.name if effect_annotation.owner == "__effect_install_effect" and effect_annotation.line == annotation.line
                            effect_index <- effect_index + 1
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UndefinedName, name: handler_name, line: annotation.line, expected: "effect handler", actual: ""}) if not ae_handler_declared(file.enum_annotations, handler_name)
                        required_captures: mutable u32 = 0
                        total_captures: mutable u32 = 0
                        ae_handler_capture_counts(file.enum_annotations, handler_name, required_captures, total_captures)
                        supplied_captures: u32 = ae_install_capture_count_after(file.enum_annotations, handler_name, annotation.line)
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.EffectHandlerCaptureArity, name: handler_name, line: annotation.line, expected: "", actual: "required", expected_count: required_captures, actual_count: supplied_captures}) if ae_handler_declared(file.enum_annotations, handler_name) and supplied_captures < required_captures
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.EffectHandlerCaptureArity, name: handler_name, line: annotation.line, expected: "", actual: "maximum", expected_count: total_captures, actual_count: supplied_captures}) if ae_handler_declared(file.enum_annotations, handler_name) and supplied_captures > total_captures
                        target_ref: sview = ae_handler_target(file.enum_annotations, handler_name)
                        target: sview = effect_ref_family(target_ref)
                        installed: sview = effect_ref_family(effect_ref)
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.EffectHandlerMismatch, name: handler_name, line: annotation.line, expected: target_ref, actual: effect_ref}) if target_ref != "" and effect_ref != "" and not ae_effect_ref_same_specialization(target_ref, effect_ref)
                table <- ae_check_declarations(file.top_decls, file.enum_annotations, table)
