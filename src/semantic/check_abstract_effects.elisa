# Stage1 abstract-effect validation. Effects are declaration-level operation families;
# concrete permissions remain the authority facts in ordinary `can` clauses. A handler
# installation is therefore checked in two dimensions: it must name a known handler for
# the granted abstract family, and every abstract operation call must have been lowered to
# that handler's direct operation function by the parser.

extend Semantic:
    private:
        const AE_EXPRESSION_OPERATION_ROW: u32 = 3900000081
        const AE_EXPRESSION_GENERIC_ROW: u32 = 3900000090
        const AE_EXPRESSION_TEMPLATE_EFFECT_ROW: u32 = 3900000100
        const AE_PERMISSION_MEMBER_ROW: u32 = 3900000093
        const AE_PERMISSION_ALIAS_MEMBER_ROW: u32 = 3900000041
        const AE_HANDLER_OPERATION_ROW: u32 = 3900000083
        const AE_HANDLER_TARGET_ROW: u32 = 3900000084
        const AE_HANDLER_REALIZATION_ROW: u32 = 3900000087
        const AE_HANDLER_RESUME_MISSING_ROW: u32 = 3900000091
        const AE_HANDLER_RESUME_RETURN_ROW: u32 = 3900000092
        const AE_EFFECT_INDEX_NONE: u32 = 4294967295
        const AE_EFFECT_INDEX_SEPARATOR: u64 = 255

        # Handler install facts are consumed by both the declaration walk and the
        # statement walk. Keep the rows indexed once so an install never rescans the
        # complete annotation table for its effect, captures, target, or realizations.
        struct EffectDeclarationIdentityIndex:
            names: mutable darray[sview @source] @source = []
            modules: mutable darray[sview @source] @source = []
            identities: mutable darray[u32] = []
            declared_ids: mutable dict[u64, bool] = {}
            module_family_heads: mutable dict[u64, u32] = {}
            module_family_next: mutable darray[u32] = []
            family_heads: mutable dict[u64, u32] = {}
            family_next: mutable darray[u32] = []
            operation_heads: mutable dict[u64, u32] = {}
            operation_tails: mutable dict[u64, u32] = {}
            operation_names: mutable darray[sview @source] @source = []
            operation_ids: mutable darray[u32] = []
            operation_next: mutable darray[u32] = []

        struct EffectOperationPositionIndex:
            operation_heads: mutable dict[u64, u32] = {}
            operation_tails: mutable dict[u64, u32] = {}
            operation_annotations: mutable darray[Ast::EnumAnnotation] @source = []
            operation_effect_ids: mutable darray[u32] = []
            operation_next: mutable darray[u32] = []
            mismatch_heads: mutable dict[u64, u32] = {}
            mismatch_tails: mutable dict[u64, u32] = {}
            mismatch_annotations: mutable darray[Ast::EnumAnnotation] @source = []
            mismatch_next: mutable darray[u32] = []
            # name_hash of every `__effect_clone` row's name: a prefilter so a call whose
            # callee has no clone skips the template scan of the annotation table.
            clone_name_hashes: mutable dict[u64, u8] = {}

        struct EffectHandlerSemanticIndex:
            declared: mutable darray[bool] = []
            declaration_lines: mutable darray[u32] = []
            target_refs: mutable darray[sview @source] @source = []
            target_effect_ids: mutable darray[u32] = []
            target_annotation_rows: mutable darray[u32] = []
            required_captures: mutable darray[u32] = []
            total_captures: mutable darray[u32] = []
            realization_heads: mutable dict[u64, u32] = {}
            realization_tails: mutable dict[u64, u32] = {}
            realization_annotations: mutable darray[usize] = []
            realization_next: mutable darray[u32] = []

        struct EffectInstallPositionIndex:
            lines: mutable darray[u32] = []
            offsets: mutable darray[u32] = []
            handler_names: mutable darray[sview @source] @source = []
            handler_ids: mutable darray[u32] = []
            effect_refs: mutable darray[sview @source] @source = []
            effect_ids: mutable darray[u32] = []
            effect_annotation_rows: mutable darray[u32] = []
            capture_counts: mutable darray[u32] = []
            identity_mismatches: mutable darray[bool] = []
            target_refs: mutable darray[sview @source] @source = []
            target_effect_ids: mutable darray[u32] = []
            target_annotation_rows: mutable darray[u32] = []
            offsets_ordered: mutable bool = true

        def ae_effect_module_family_hash(module: sview, family: sview) -> u64:
            can Abort.Panic:
                hash: mutable u64 = name_hash(module)
                hash <- (hash ^ AE_EFFECT_INDEX_SEPARATOR) * SEMANTIC_HASH_PRIME
                return (hash ^ name_hash(family)) * SEMANTIC_HASH_PRIME

        def ae_effect_declaration_identity_index(annotations: darray[Ast::EnumAnnotation]&, index: mutable EffectDeclarationIdentityIndex&) -> void:
            can Memory.Allocate, Abort.Panic:
                module_tails: mutable dict[u64, u32] = {}
                family_tails: mutable dict[u64, u32] = {}
                for annotation in annotations |index, module_tails, family_tails|:
                    continue if annotation.owner != "__effect_decl" or annotation.identity_id == 0
                    row: u32 = index.identities.count.u32()
                    module_hash: u64 = ae_effect_module_family_hash(annotation.module, annotation.name)
                    family_hash: u64 = name_hash(annotation.name)
                    index.names.push(annotation.name)
                    index.modules.push(annotation.module)
                    index.identities.push(annotation.identity_id)
                    index.declared_ids <- index.declared_ids.put(annotation.identity_id.u64(), true) can Global{Read,Write}
                    index.module_family_next.push(AE_EFFECT_INDEX_NONE)
                    index.family_next.push(AE_EFFECT_INDEX_NONE)
                    if module_tails.get(module_hash) is module_tail:
                        index.module_family_next[module_tail.usize()] <- row
                    else:
                        index.module_family_heads <- index.module_family_heads.put(module_hash, row) can Global{Read,Write}
                    module_tails <- module_tails.put(module_hash, row) can Global{Read,Write}
                    if family_tails.get(family_hash) is family_tail:
                        index.family_next[family_tail.usize()] <- row
                    else:
                        index.family_heads <- index.family_heads.put(family_hash, row) can Global{Read,Write}
                    family_tails <- family_tails.put(family_hash, row) can Global{Read,Write}

        def ae_effect_identity_index_declared(index: EffectDeclarationIdentityIndex&, identity_id: u32) -> bool:
            can Abort.Panic:
                return false if identity_id == 0
                return known if index.declared_ids.get(identity_id.u64()) is known
                return false

        def ae_effect_family_indexed(index: EffectDeclarationIdentityIndex&, family: sview) -> bool:
            can Abort.Panic:
                family_hash: u64 = name_hash(family)
                row: mutable u32 = AE_EFFECT_INDEX_NONE
                row <- head if index.family_heads.get(family_hash) is head
                while row != AE_EFFECT_INDEX_NONE |row, index, family|:
                    return true if index.names[row.usize()] == family
                    row <- index.family_next[row.usize()]
                return false

        def ae_effect_operation_identity_hash(identity_id: u32, operation: sview) -> u64:
            can Abort.Panic:
                hash: mutable u64 = identity_id.u64()
                hash <- (hash ^ AE_EFFECT_INDEX_SEPARATOR) * SEMANTIC_HASH_PRIME
                return (hash ^ name_hash(operation)) * SEMANTIC_HASH_PRIME

        def ae_effect_operation_identity_index(annotations: darray[Ast::EnumAnnotation]&, index: mutable EffectDeclarationIdentityIndex&) -> void:
            can Memory.Allocate, Abort.Panic:
                tails: mutable dict[u64, u32] = {}
                for annotation in annotations |index, tails|:
                    continue if annotation.line != AE_EXPRESSION_OPERATION_ROW or annotation.identity_id == 0
                    key: u64 = ae_effect_operation_identity_hash(annotation.identity_id, annotation.name)
                    row: u32 = index.operation_names.count.u32()
                    index.operation_names.push(annotation.name)
                    index.operation_ids.push(annotation.identity_id)
                    index.operation_next.push(AE_EFFECT_INDEX_NONE)
                    if tails.get(key) is tail_row:
                        index.operation_next[tail_row.usize()] <- row
                    else:
                        index.operation_heads <- index.operation_heads.put(key, row) can Global{Read,Write}
                    tails <- tails.put(key, row) can Global{Read,Write}

        def ae_effect_operation_index_declared(index: EffectDeclarationIdentityIndex&, identity_id: u32, operation: sview) -> bool:
            can Abort.Panic:
                return false if identity_id == 0
                key: u64 = ae_effect_operation_identity_hash(identity_id, operation)
                row: mutable u32 = AE_EFFECT_INDEX_NONE
                row <- head if index.operation_heads.get(key) is head
                while row != AE_EFFECT_INDEX_NONE |row, index, identity_id, operation|:
                    return true if index.operation_ids[row.usize()] == identity_id and index.operation_names[row.usize()] == operation
                    row <- index.operation_next[row.usize()]
                return false

        def ae_effect_operation_site_hash(member: sview, line: u32, offset: u32) -> u64:
            can Abort.Panic:
                hash: mutable u64 = name_hash(member)
                hash <- (hash ^ AE_EFFECT_INDEX_SEPARATOR) * SEMANTIC_HASH_PRIME
                hash <- (hash ^ line.u64()) * SEMANTIC_HASH_PRIME
                return (hash ^ offset.u64()) * SEMANTIC_HASH_PRIME

        def ae_effect_mismatch_site_hash(line: u32, offset: u32) -> u64:
            can Abort.Panic:
                hash: mutable u64 = line.u64() ^ AE_EFFECT_INDEX_SEPARATOR
                return (hash ^ offset.u64()) * SEMANTIC_HASH_PRIME

        def ae_effect_operation_position_index(annotations: darray[Ast::EnumAnnotation]&, effects: EffectDeclarationIdentityIndex&, index: mutable EffectOperationPositionIndex&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for row in 0..<annotations.count |index, table| -> table:
                    annotation: Ast::EnumAnnotation = annotations[row]
                    index.clone_name_hashes <- index.clone_name_hashes.put(name_hash(annotation.name), 1) can Global{Read,Write} if annotation.owner == "__effect_clone"
                    if annotation.owner == "__effect_operation_ref":
                        key: u64 = ae_effect_operation_site_hash(annotation.name, annotation.line, annotation.offset)
                        site_row: u32 = index.operation_annotations.count.u32()
                        index.operation_annotations.push(annotation)
                        rebind operation_identity_id: u32, table = ae_effect_identity_at_request(annotations, effects, annotation.detail_name, annotation.identity_id, annotation, table)
                        index.operation_effect_ids.push(operation_identity_id)
                        index.operation_next.push(AE_EFFECT_INDEX_NONE)
                        if index.operation_tails.get(key) is tail_row:
                            index.operation_next[tail_row.usize()] <- site_row
                        else:
                            index.operation_heads <- index.operation_heads.put(key, site_row) can Global{Read,Write}
                        index.operation_tails <- index.operation_tails.put(key, site_row) can Global{Read,Write}
                    elif annotation.owner == "__effect_specialization_mismatch":
                        key: u64 = ae_effect_mismatch_site_hash(annotation.line, annotation.offset)
                        site_row: u32 = index.mismatch_annotations.count.u32()
                        index.mismatch_annotations.push(annotation)
                        index.mismatch_next.push(AE_EFFECT_INDEX_NONE)
                        if index.mismatch_tails.get(key) is tail_row:
                            index.mismatch_next[tail_row.usize()] <- site_row
                        else:
                            index.mismatch_heads <- index.mismatch_heads.put(key, site_row) can Global{Read,Write}
                        index.mismatch_tails <- index.mismatch_tails.put(key, site_row) can Global{Read,Write}

        def ae_effect_identity_from_index(index: EffectDeclarationIdentityIndex&, effect_ref: sview, lexical_owner: sview) -> u32:
            can Abort.Panic:
                abstract_ref: sview = effect_ref_abstract(effect_ref)
                family: sview = effect_ref_family(abstract_ref)
                return 0 if family == ""
                namespace_end: mutable usize = abstract_ref.len
                depth: mutable int = 0
                cursor: mutable usize = 0
                while cursor < abstract_ref.len |cursor, abstract_ref, namespace_end, depth|:
                    byte: u8 = abstract_ref[cursor]
                    depth <- depth + 1 if byte == 91 or byte == 40 or byte == 123
                    depth <- depth - 1 if depth > 0 and (byte == 93 or byte == 41 or byte == 125)
                    if depth == 0 and byte == 58 and cursor + 1.usize() < abstract_ref.len and abstract_ref[cursor + 1.usize()] == 58:
                        namespace_end <- cursor
                        cursor <- cursor + 1.usize()
                    elif depth == 0 and byte == 46:
                        namespace_end <- cursor
                    cursor <- cursor + 1.usize()
                namespace: sview = abstract_ref[0:namespace_end] if namespace_end < abstract_ref.len else lexical_owner
                module_hash: u64 = ae_effect_module_family_hash(namespace, family)
                row: mutable u32 = AE_EFFECT_INDEX_NONE
                row <- head if index.module_family_heads.get(module_hash) is head
                while row != AE_EFFECT_INDEX_NONE |row, index, namespace, family|:
                    return index.identities[row.usize()] if index.modules[row.usize()] == namespace and index.names[row.usize()] == family
                    row <- index.module_family_next[row.usize()]
                return 0 if namespace_end < abstract_ref.len
                family_hash: u64 = name_hash(family)
                row <- AE_EFFECT_INDEX_NONE
                row <- family_head if index.family_heads.get(family_hash) is family_head
                candidate: mutable u32 = 0
                while row != AE_EFFECT_INDEX_NONE |row, index, family, candidate|:
                    if index.names[row.usize()] == family:
                        identity_id: u32 = index.identities[row.usize()]
                        return 0 if candidate != 0 and candidate != identity_id
                        candidate <- identity_id
                    row <- index.family_next[row.usize()]
                return candidate

        # Parser IDs are authoritative when present. A zero ID first tries the exact
        # lexical module/family index for bare references. Qualified references always use
        # module alias resolution first because a using alias can shadow a real same-named
        # module. The handler-target sentinel line is replaced by its retained source line.
        def ae_effect_reference_is_qualified(effect_ref: sview) -> bool:
            abstract_ref: sview = effect_ref_abstract(effect_ref)
            depth: mutable int = 0
            cursor: mutable usize = 0
            while cursor < abstract_ref.len |cursor, abstract_ref, depth|:
                byte: u8 = abstract_ref[cursor]
                depth <- depth + 1 if byte == 91 or byte == 40 or byte == 123
                depth <- depth - 1 if depth > 0 and (byte == 93 or byte == 41 or byte == 125)
                return true if depth == 0 and byte == 58 and cursor + 1.usize() < abstract_ref.len and abstract_ref[cursor + 1.usize()] == 58
                return true if depth == 0 and byte == 46
                cursor <- cursor + 1.usize()
            return false

        def ae_effect_identity_at_request(annotations: darray[Ast::EnumAnnotation]&, index: EffectDeclarationIdentityIndex&, effect_ref: sview @source, parser_identity_id: u32, requester: Ast::EnumAnnotation, table: lmut SymbolTable) -> u32:
            can Abort.Panic:
                identity_id: mutable u32 = parser_identity_id
                if identity_id == 0:
                    if ae_effect_reference_is_qualified(effect_ref):
                        source_requester: mutable Ast::EnumAnnotation = requester
                        source_requester <- requester{line = requester.detail_line} if requester.line == AE_HANDLER_TARGET_ROW and requester.detail_line != 0
                        source_requester <- source_requester{offset = requester.occurrence_offset} if requester.occurrence_offset != 0
                        rebind requested_identity_id: u32, table = ae_effect_identity_for_ref(index, effect_ref, requester.module, source_requester, table)
                        identity_id <- requested_identity_id
                    else:
                        identity_id <- ae_effect_identity_from_index(index, effect_ref, requester.module)
                return identity_id if ae_effect_identity_index_declared(index, identity_id)
                return 0

        def ae_handler_index_ensure(index: mutable EffectHandlerSemanticIndex&, handler_identity_id: u32) -> void:
            can Memory.Allocate, Abort.Panic:
                while index.declared.count < handler_identity_id.usize() |index, handler_identity_id|:
                    index.declared.push(false)
                    index.declaration_lines.push(0)
                    index.target_refs.push("")
                    index.target_effect_ids.push(0)
                    index.target_annotation_rows.push(AE_EFFECT_INDEX_NONE)
                    index.required_captures.push(0)
                    index.total_captures.push(0)

        def ae_handler_semantic_index(annotations: darray[Ast::EnumAnnotation]&, effects: EffectDeclarationIdentityIndex&, index: mutable EffectHandlerSemanticIndex&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for row in 0..<annotations.count |index, table| -> table:
                    annotation: Ast::EnumAnnotation = annotations[row]
                    handler_identity_id: u32 = annotation.identity_id
                    continue if handler_identity_id == 0
                    if annotation.owner == "__handler_decl" or annotation.owner == "__handler_capture_required" or annotation.owner == "__handler_capture_total" or annotation.line == AE_HANDLER_TARGET_ROW or annotation.line == AE_HANDLER_REALIZATION_ROW:
                        ae_handler_index_ensure(index, handler_identity_id)
                    handler_row: usize = (handler_identity_id - 1).usize()
                    if annotation.owner == "__handler_decl":
                        index.declared[handler_row] <- true
                        index.declaration_lines[handler_row] <- annotation.line
                    elif annotation.owner == "__handler_capture_required":
                        index.required_captures[handler_row] <- annotation.line
                    elif annotation.owner == "__handler_capture_total":
                        index.total_captures[handler_row] <- annotation.line
                    elif annotation.line == AE_HANDLER_TARGET_ROW:
                        index.target_refs[handler_row] <- annotation.name
                        rebind target_identity_id: u32, table = ae_effect_identity_at_request(annotations, effects, annotation.name, annotation.referenced_identity_id, annotation, table)
                        index.target_effect_ids[handler_row] <- target_identity_id
                        index.target_annotation_rows[handler_row] <- row.u32()
                    elif annotation.line == AE_HANDLER_REALIZATION_ROW:
                        realization_row: u32 = index.realization_annotations.count.u32()
                        index.realization_annotations.push(row)
                        index.realization_next.push(AE_EFFECT_INDEX_NONE)
                        if index.realization_tails.get(handler_identity_id.u64()) is tail_row:
                            index.realization_next[tail_row.usize()] <- realization_row
                        else:
                            index.realization_heads <- index.realization_heads.put(handler_identity_id.u64(), realization_row) can Global{Read,Write}
                        index.realization_tails <- index.realization_tails.put(handler_identity_id.u64(), realization_row) can Global{Read,Write}

        def ae_install_position_index_at(index: EffectInstallPositionIndex&, line: u32, offset: u32) -> u32:
            can Abort.Panic:
                if index.offsets_ordered:
                    low: mutable usize = 0
                    high: mutable usize = index.offsets.count
                    while low < high |low, high, index, offset|:
                        middle: usize = low + ((high - low) / 2.usize())
                        if index.offsets[middle] < offset:
                            low <- middle + 1.usize()
                        else:
                            high <- middle
                    while low < index.offsets.count and index.offsets[low] == offset |low, index, line, offset|:
                        return low.u32() if index.lines[low] == line
                        low <- low + 1.usize()
                    return AE_EFFECT_INDEX_NONE
                for row in 0..<index.offsets.count:
                    return row.u32() if index.lines[row] == line and index.offsets[row] == offset
                return AE_EFFECT_INDEX_NONE

        def ae_effect_install_position_index(annotations: darray[Ast::EnumAnnotation]&, effects: EffectDeclarationIdentityIndex&, handlers: EffectHandlerSemanticIndex&, index: mutable EffectInstallPositionIndex&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for annotation in annotations |index|:
                    continue if annotation.owner != "__effect_install"
                    if index.offsets.count > 0:
                        index.offsets_ordered <- false if annotation.offset < index.offsets[index.offsets.count - 1.usize()]
                    index.lines.push(annotation.line)
                    index.offsets.push(annotation.offset)
                    index.handler_names.push(annotation.name)
                    index.handler_ids.push(annotation.identity_id)
                    index.effect_refs.push("")
                    index.effect_ids.push(0)
                    index.effect_annotation_rows.push(AE_EFFECT_INDEX_NONE)
                    index.capture_counts.push(0)
                    index.identity_mismatches.push(false)
                    index.target_refs.push("")
                    index.target_effect_ids.push(0)
                    index.target_annotation_rows.push(AE_EFFECT_INDEX_NONE)
                for annotation_row in 0..<annotations.count |index, table| -> table:
                    annotation: Ast::EnumAnnotation = annotations[annotation_row]
                    if annotation.owner == "__effect_install_effect":
                        install_row: u32 = ae_install_position_index_at(index, annotation.line, annotation.offset)
                        if install_row != AE_EFFECT_INDEX_NONE and index.handler_names[install_row.usize()] != "":
                            index.effect_refs[install_row.usize()] <- annotation.name
                            rebind effect_identity_id: u32, table = ae_effect_identity_at_request(annotations, effects, annotation.name, annotation.identity_id, annotation, table)
                            index.effect_ids[install_row.usize()] <- effect_identity_id
                            index.effect_annotation_rows[install_row.usize()] <- annotation_row.u32()
                    elif annotation.owner == "__effect_install_capture_count":
                        install_row: u32 = ae_install_position_index_at(index, annotation.line, annotation.offset)
                        if install_row != AE_EFFECT_INDEX_NONE and annotation.name == index.handler_names[install_row.usize()]:
                            index.capture_counts[install_row.usize()] <- annotation.identity_id
                    elif annotation.owner == "__effect_install_identity_mismatch":
                        install_row: u32 = ae_install_position_index_at(index, annotation.line, annotation.offset)
                        if install_row != AE_EFFECT_INDEX_NONE and annotation.identity_id == index.handler_ids[install_row.usize()]:
                            index.identity_mismatches[install_row.usize()] <- true
                for row in 0..<index.handler_ids.count |index, handlers|:
                    handler_identity_id: u32 = index.handler_ids[row]
                    continue if handler_identity_id == 0
                    handler_row: usize = (handler_identity_id - 1).usize()
                    continue if handler_row >= handlers.target_refs.count
                    index.target_refs[row] <- handlers.target_refs[handler_row]
                    index.target_effect_ids[row] <- handlers.target_effect_ids[handler_row]
                    index.target_annotation_rows[row] <- handlers.target_annotation_rows[handler_row]

        # Exact lookup dependencies of effect declaration/block validation.
        # Preserve source order, duplicate rows, and diagnostic positions.
        def ae_row_annotation(annotation: Ast::EnumAnnotation&) -> bool:
            can Abort.Panic:
                return annotation.owner == "__effect_decl" or annotation.owner == "__permission_decl" or annotation.owner == "__permission_param_decl" or annotation.owner == "__permission_alias" or annotation.owner == "__effect_ref_pos" or annotation.line == AE_EXPRESSION_OPERATION_ROW or annotation.line == AE_PERMISSION_MEMBER_ROW

        # Exact annotation dependencies of ae_check_declarations and its
        # expression walk. Preserve row order and duplicates; declaration and
        # handler validation still consume the complete annotation table.
        def ae_expression_annotation(annotation: Ast::EnumAnnotation&) -> bool:
            can Abort.Panic:
                return annotation.owner == "__effect_decl" or annotation.owner == "__effect_template" or annotation.owner == "__effect_clone" or annotation.owner == "__effect_operation_ref" or annotation.owner == "__effect_specialization_mismatch" or annotation.line == AE_EXPRESSION_OPERATION_ROW or annotation.line == AE_EXPRESSION_GENERIC_ROW or annotation.line == AE_EXPRESSION_TEMPLATE_EFFECT_ROW

        # Add one effect row without making repeated handler-install scans grow the
        # function's requirement set. Stage1 keeps effect rows as source spellings;
        # `via` rows are added separately by collect_range.
        def ae_add_function_effect(table: lmut SymbolTable, owner: sview @source, module: sview @source, effect_ref: sview @source) -> void:
            can Memory.Allocate, Abort.Panic:
                return if effect_ref == ""
                while row_index < table.function_effect_owner.count |row_index: usize = 0|:
                    return if table.function_effect_owner[row_index] == owner and row_index < table.function_effect_module.count and table.function_effect_module[row_index] == module and table.function_effect_name[row_index] == effect_ref
                    row_index <- row_index + 1.usize()
                table.function_effect_owner <- table.function_effect_owner.push(owner)
                table.function_effect_name <- table.function_effect_name.push(effect_ref)
                table.function_effect_module <- table.function_effect_module.push(module)
                table <- index_effect_owner_rows(table) can Global{Read,Write}



        def ae_handler_index_declared(index: EffectHandlerSemanticIndex&, handler_identity_id: u32) -> bool:
            return false if handler_identity_id == 0 or (handler_identity_id - 1).usize() >= index.declared.count
            return index.declared[(handler_identity_id - 1).usize()]

        def ae_handler_index_decl_line(index: EffectHandlerSemanticIndex&, handler_identity_id: u32) -> u32:
            return 0 if handler_identity_id == 0 or (handler_identity_id - 1).usize() >= index.declaration_lines.count
            return index.declaration_lines[(handler_identity_id - 1).usize()]

        def ae_handler_index_target_ref(index: EffectHandlerSemanticIndex&, handler_identity_id: u32) -> sview @source:
            return "" if handler_identity_id == 0 or (handler_identity_id - 1).usize() >= index.target_refs.count
            return index.target_refs[(handler_identity_id - 1).usize()]

        def ae_handler_index_target_effect_id(index: EffectHandlerSemanticIndex&, handler_identity_id: u32) -> u32:
            return 0 if handler_identity_id == 0 or (handler_identity_id - 1).usize() >= index.target_effect_ids.count
            return index.target_effect_ids[(handler_identity_id - 1).usize()]

        def ae_handler_index_required_captures(index: EffectHandlerSemanticIndex&, handler_identity_id: u32) -> u32:
            return 0 if handler_identity_id == 0 or (handler_identity_id - 1).usize() >= index.required_captures.count
            return index.required_captures[(handler_identity_id - 1).usize()]

        def ae_handler_index_total_captures(index: EffectHandlerSemanticIndex&, handler_identity_id: u32) -> u32:
            return 0 if handler_identity_id == 0 or (handler_identity_id - 1).usize() >= index.total_captures.count
            return index.total_captures[(handler_identity_id - 1).usize()]

        def ae_handler_realization_head(index: EffectHandlerSemanticIndex&, handler_identity_id: u32) -> u32:
            can Abort.Panic:
                return head if handler_identity_id != 0 and index.realization_heads.get(handler_identity_id.u64()) is head
                return AE_EFFECT_INDEX_NONE

        def ae_join_module_scope(parent: sview, child: sview @source, table: lmut SymbolTable) -> sview @source:
            can Memory.Allocate, Abort.Panic:
                for offset in 0..<child.len |parent, child, table|:
                    return child if offset + 1.usize() < child.len and child[offset] == 58 and child[offset + 1.usize()] == 58
                if parent != "":
                    rebind joined: sview @source, table = errorset_join_module_path(parent, child, table)
                    return joined
                return child



        # Handler installations are visible requirements even though the operation
        # calls inside them have already been lowered to hidden direct functions. This
        # preserves the abstract effect in the enclosing function's contract and also
        # carries the handler's concrete authority rows to callers.
        def ae_collect_install_statements(owner: sview @source, owner_module: sview @source, statements: darray[Ast::Stmt], annotations: darray[Ast::EnumAnnotation]&, installs: EffectInstallPositionIndex&, handlers: EffectHandlerSemanticIndex&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Block(kind, clause, binding, body, statement_pos):
                            if kind == "can":
                                install_row: u32 = ae_install_position_index_at(installs, statement_pos.line, statement_pos.offset)
                                installed: sview = installs.effect_refs[install_row.usize()] if install_row != AE_EFFECT_INDEX_NONE else ""
                                installed_identity_id: u32 = installs.effect_ids[install_row.usize()] if install_row != AE_EFFECT_INDEX_NONE else 0
                                handler: sview = installs.handler_names[install_row.usize()] if install_row != AE_EFFECT_INDEX_NONE else ""
                                handler_identity_id: u32 = installs.handler_ids[install_row.usize()] if install_row != AE_EFFECT_INDEX_NONE else 0
                                if installed != "" and handler != "":
                                    table <- ae_add_function_effect(table, owner, owner_module, installed) can Global{Read,Write}
                                    installed_concrete: sview = effect_ref_via(installed)
                                    table <- ae_add_function_effect(table, owner, owner_module, installed_concrete) can Global{Read,Write} if installed_concrete != ""
                                    # A handler may declare its realization on the target
                                    # (`handler Sink for Writer[sview] via Console.Write`).
                                    # Treat that declaration as an authority fact at every
                                    # installation, even when the installation uses the
                                    # ergonomic bare form (`can Writer[sview] with Sink`).
                                    # The target and realization rows were indexed after parsing,
                                    # so forward declarations carry the same facts without a
                                    # full annotation scan at every install.
                                    target_ref: sview = installs.target_refs[install_row.usize()] if install_row != AE_EFFECT_INDEX_NONE else ""
                                    target_identity_id: u32 = installs.target_effect_ids[install_row.usize()] if install_row != AE_EFFECT_INDEX_NONE else 0
                                    target_matches_install: bool = target_identity_id != 0 and installed_identity_id != 0 and target_identity_id == installed_identity_id and ae_effect_ref_same_specialization(target_ref, installed)
                                    if target_matches_install:
                                        target_concrete: sview = effect_ref_via(target_ref)
                                        table <- ae_add_function_effect(table, owner, owner_module, target_concrete) can Global{Read,Write} if target_concrete != ""
                                        realization_row: mutable u32 = ae_handler_realization_head(handlers, handler_identity_id)
                                        while realization_row != AE_EFFECT_INDEX_NONE |realization_row, table| -> table:
                                            annotation_row: usize = handlers.realization_annotations[realization_row.usize()]
                                            annotation: Ast::EnumAnnotation = annotations[annotation_row]
                                            realization_row <- handlers.realization_next[realization_row.usize()]
                                            continue if annotation.owner != handler or annotation.line != AE_HANDLER_REALIZATION_ROW or annotation.identity_id != handler_identity_id
                                            concrete: mutable sview = effect_ref_via(annotation.name)
                                            concrete <- annotation.name if concrete == ""
                                            table <- ae_add_function_effect(table, owner, owner_module, concrete) can Global{Read,Write}
                            table <- ae_collect_install_statements(owner, owner_module, body, annotations, installs, handlers, table) can Global{Read,Write}
                        Stmt.If(condition, then_body, else_body, statement_pos):
                            table <- ae_collect_install_statements(owner, owner_module, then_body, annotations, installs, handlers, table) can Global{Read,Write}
                            table <- ae_collect_install_statements(owner, owner_module, else_body, annotations, installs, handlers, table) can Global{Read,Write}
                        Stmt.While(condition, body, statement_pos):
                            table <- ae_collect_install_statements(owner, owner_module, body, annotations, installs, handlers, table) can Global{Read,Write}
                        Stmt.For(bind, variables, iterable, body, statement_pos):
                            table <- ae_collect_install_statements(owner, owner_module, body, annotations, installs, handlers, table) can Global{Read,Write}
                        Stmt.Match(scrutinee, arms, statement_pos):
                            for arm in arms |table| -> table:
                                table <- ae_collect_install_statements(owner, owner_module, arm.body, annotations, installs, handlers, table) can Global{Read,Write}
                        _:
                            pass



        def ae_collect_install_declarations(declarations: darray[Ast::Decl], owner_module: sview @source, annotations: darray[Ast::EnumAnnotation]&, installs: EffectInstallPositionIndex&, handlers: EffectHandlerSemanticIndex&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(name, parameters, return_type, body, effects, decorators, declaration_pos):
                            table <- ae_collect_install_statements(name, owner_module, body, annotations, installs, handlers, table) can Global{Read,Write}
                        Decl.Module(name, body, declaration_pos):
                            rebind nested_module: sview @source, table = ae_join_module_scope(owner_module, name, table)
                            table <- ae_collect_install_declarations(body, nested_module, annotations, installs, handlers, table) can Global{Read,Write}
                        Decl.Scoped(body, declaration_pos):
                            table <- ae_collect_install_declarations(body, owner_module, annotations, installs, handlers, table) can Global{Read,Write}
                        _:
                            pass



        def ae_check_expression(expression: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&, sites: EffectOperationPositionIndex&, effect_index: EffectDeclarationIdentityIndex&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                effect_name: mutable sview = ""
                effect_ref: mutable sview = ""
                effect_identity_id: mutable u32 = 0
                operation: mutable sview = ""
                line: mutable u32 = 0
                site_line: mutable u32 = 0
                site_offset: mutable u32 = 0
                is_operation: bool = ae_call_is_operation(expression, annotations, sites, effect_index, effect_name, effect_identity_id, effect_ref, operation, line, site_line, site_offset)
                if is_operation:
                    if effect_identity_id == 0:
                        # A same-leaf declaration exists, but the exact qualified or bare
                        # reference did not resolve to one declaration. No leaf-name fallback
                        # may make this call look handled.
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AbstractEffectUnhandled, name: operation, line: line, expected: effect_ref, actual: effect_ref})
                    elif not ae_effect_identity_index_declared(effect_index, effect_identity_id):
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AbstractEffectUnknown, name: effect_name, line: line, expected: "effect", actual: ""})
                    elif not ae_effect_operation_index_declared(effect_index, effect_identity_id, operation):
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AbstractEffectOperationMissing, name: operation, line: line, expected: effect_name, actual: "operation"})
                    else:
                        explicit_count: mutable u32 = 0
                        is_explicit: bool = ae_call_explicit_specialization(expression, explicit_count)
                        generic_count: u32 = ae_effect_generic_names_identity(annotations, effect_identity_id).count.u32()
                        has_arity_mismatch: bool = is_explicit and generic_count != explicit_count
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AbstractEffectSpecializationArity, name: operation, line: line, expected: effect_name, actual: "operation", expected_count: generic_count, actual_count: explicit_count}) if has_arity_mismatch
                        mismatch_effect: sview = ae_specialization_mismatch_at_site(annotations, sites, site_line, site_offset)
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AbstractEffectSpecializationMismatch, name: operation, line: line, expected: mismatch_effect, actual: effect_name}) if not has_arity_mismatch and mismatch_effect != ""
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AbstractEffectUnhandled, name: operation, line: line, expected: effect_name, actual: effect_name}) if not has_arity_mismatch and mismatch_effect == ""
                match expression:
                    Expr.StaticEffectCall(effect_type, operation_name, candidates, arguments, argument_names, call_pos):
                        for argument in arguments |table|:
                            table <- ae_check_expression(argument, annotations, sites, effect_index, table)
                        for candidate in candidates |table|:
                            for capture in candidate.captures |table|:
                                table <- ae_check_expression(capture, annotations, sites, effect_index, table)
                    Expr.Call(callee, arguments, argument_names, call_pos):
                        # Effectful helpers are compile-time templates. If a call to one
                        # remains as an ordinary call, no static installation selected it;
                        # report the missing handler before backend overload resolution.
                        template_callee: sview = ae_effect_template_callee_name(callee)
                        if template_callee != "" and (sites.clone_name_hashes.get(name_hash(template_callee)) is clone_marker) and ae_effect_template_has_clone(annotations, template_callee):
                            for template_effect in annotations |template_callee|:
                                if template_effect.owner == template_callee and template_effect.line == AE_EXPRESSION_TEMPLATE_EFFECT_ROW:
                                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AbstractEffectHelperUnhandled, name: template_callee, line: call_pos.line, expected: template_effect.name, actual: "helper"}) if not ae_has_concrete_diagnostic(table, DiagnosticKind.AbstractEffectHelperUnhandled, template_callee, template_effect.name, "helper")
                        # A direct abstract operation call is checked above. Do not visit its
                        # callee as a value as well: the same `Effect.op` syntax denotes an
                        # operation only in this call position.
                        table <- ae_check_expression(callee, annotations, sites, effect_index, table) if not is_operation
                        for argument in arguments |table|:
                            table <- ae_check_expression(argument, annotations, sites, effect_index, table)
                    Expr.Ident(name, ident_pos):
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AbstractEffectImplementationAccess, name: name, line: ident_pos.line, expected: "", actual: ""}) if ident_pos.line != 0 and ae_is_hidden_handler_name(name)
                    Expr.Field(object, field, field_pos):
                        if ae_value_is_operation(expression, annotations, sites, effect_index, effect_name, effect_identity_id, effect_ref, operation, line, site_line, site_offset):
                            if effect_identity_id == 0:
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AbstractEffectValue, name: operation, line: line, expected: effect_ref, actual: operation})
                            elif ae_effect_identity_index_declared(effect_index, effect_identity_id):
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AbstractEffectOperationMissing, name: operation, line: line, expected: effect_name, actual: "operation"}) if not ae_effect_operation_index_declared(effect_index, effect_identity_id, operation)
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AbstractEffectValue, name: operation, line: line, expected: effect_name, actual: operation}) if ae_effect_operation_index_declared(effect_index, effect_identity_id, operation)
                            else:
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AbstractEffectUnknown, name: effect_name, line: line, expected: "effect", actual: ""})
                        table <- ae_check_expression(object, annotations, sites, effect_index, table)
                    Expr.Scope(object, field, field_pos):
                        if ae_value_is_operation(expression, annotations, sites, effect_index, effect_name, effect_identity_id, effect_ref, operation, line, site_line, site_offset):
                            if effect_identity_id == 0:
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AbstractEffectValue, name: operation, line: line, expected: effect_ref, actual: operation})
                            elif ae_effect_identity_index_declared(effect_index, effect_identity_id):
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AbstractEffectOperationMissing, name: operation, line: line, expected: effect_name, actual: "operation"}) if not ae_effect_operation_index_declared(effect_index, effect_identity_id, operation)
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AbstractEffectValue, name: operation, line: line, expected: effect_name, actual: operation}) if ae_effect_operation_index_declared(effect_index, effect_identity_id, operation)
                            else:
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AbstractEffectUnknown, name: effect_name, line: line, expected: "effect", actual: ""})
                        table <- ae_check_expression(object, annotations, sites, effect_index, table)
                    Expr.Index(object, index, index_pos):
                        table <- ae_check_expression(object, annotations, sites, effect_index, table)
                        table <- ae_check_expression(index, annotations, sites, effect_index, table)
                    Expr.Slice(object, low, high, slice_pos):
                        table <- ae_check_expression(object, annotations, sites, effect_index, table)
                        table <- ae_check_expression(low, annotations, sites, effect_index, table)
                        table <- ae_check_expression(high, annotations, sites, effect_index, table)
                    Expr.IndexN(object, arguments, index_pos):
                        table <- ae_check_expression(object, annotations, sites, effect_index, table)
                        for argument in arguments |table|:
                            table <- ae_check_expression(argument, annotations, sites, effect_index, table)
                    Expr.Binary(left, operator, right, binary_pos):
                        table <- ae_check_expression(left, annotations, sites, effect_index, table)
                        table <- ae_check_expression(right, annotations, sites, effect_index, table)
                    Expr.Unary(operator, operand, unary_pos):
                        table <- ae_check_expression(operand, annotations, sites, effect_index, table)
                    Expr.Move(operand, move_pos):
                        table <- ae_check_expression(operand, annotations, sites, effect_index, table)
                    Expr.RegionNew(operand, region, new_pos):
                        table <- ae_check_expression(operand, annotations, sites, effect_index, table)
                    Expr.Paren(inner, paren_pos):
                        table <- ae_check_expression(inner, annotations, sites, effect_index, table)
                    Expr.Array(elements, array_pos):
                        for element in elements |table|:
                            table <- ae_check_expression(element, annotations, sites, effect_index, table)
                    Expr.Tuple(elements, tuple_pos):
                        for element in elements |table|:
                            table <- ae_check_expression(element, annotations, sites, effect_index, table)
                    Expr.SetLit(elements, set_pos):
                        for element in elements |table|:
                            table <- ae_check_expression(element, annotations, sites, effect_index, table)
                    Expr.DictLit(entries, dict_pos):
                        for entry in entries |table|:
                            table <- ae_check_expression(entry.key, annotations, sites, effect_index, table)
                            table <- ae_check_expression(entry.value, annotations, sites, effect_index, table)
                    Expr.Construct(type_expression, fields, construct_pos):
                        table <- ae_check_expression(type_expression, annotations, sites, effect_index, table)
                        for field in fields |table|:
                            table <- ae_check_expression(field.value, annotations, sites, effect_index, table)
                    Expr.RecordUpdate(base, fields, update_pos):
                        table <- ae_check_expression(base, annotations, sites, effect_index, table)
                        for field in fields |table|:
                            table <- ae_check_expression(field.value, annotations, sites, effect_index, table)
                    Expr.If(condition, then_expr, else_expr, if_pos):
                        table <- ae_check_expression(condition, annotations, sites, effect_index, table)
                        table <- ae_check_expression(then_expr, annotations, sites, effect_index, table)
                        table <- ae_check_expression(else_expr, annotations, sites, effect_index, table)
                    Expr.Comprehension(variable, iterable, condition, body, comprehension_pos, _):
                        table <- ae_check_expression(iterable, annotations, sites, effect_index, table)
                        table <- ae_check_expression(condition, annotations, sites, effect_index, table)
                        table <- ae_check_expression(body, annotations, sites, effect_index, table)
                    Expr.Refinement(base, predicate, refinement_pos):
                        table <- ae_check_expression(base, annotations, sites, effect_index, table)
                        table <- ae_check_expression(predicate, annotations, sites, effect_index, table)
                    Expr.GetElse(guarded, recovery, get_pos):
                        table <- ae_check_expression(guarded, annotations, sites, effect_index, table)
                        table <- ae_check_statements(recovery, annotations, sites, effect_index, table)
                    Expr.Lambda(parameters, body, lambda_pos):
                        table <- ae_check_statements(body, annotations, sites, effect_index, table)
                    Expr.Block(statements, value, captures, block_pos):
                        table <- ae_check_statements(statements, annotations, sites, effect_index, table)
                        table <- ae_check_expression(value, annotations, sites, effect_index, table)
                    Expr.Match(scrutinee, arms, match_pos):
                        table <- ae_check_expression(scrutinee, annotations, sites, effect_index, table)
                        for arm in arms |table|:
                            table <- ae_check_expression(arm.guard, annotations, sites, effect_index, table)
                            table <- ae_check_statements(arm.body, annotations, sites, effect_index, table)
                    Expr.Catch(guarded, arms, catch_pos):
                        table <- ae_check_expression(guarded, annotations, sites, effect_index, table)
                        for arm in arms |table|:
                            table <- ae_check_expression(arm.guard, annotations, sites, effect_index, table)
                            table <- ae_check_statements(arm.body, annotations, sites, effect_index, table)
                    _:
                        pass



        def ae_check_statements(statements: darray[Ast::Stmt], annotations: darray[Ast::EnumAnnotation]&, sites: EffectOperationPositionIndex&, effect_index: EffectDeclarationIdentityIndex&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table|:
                    match statement:
                        Stmt.Expr(expression, statement_pos):
                            table <- ae_check_expression(expression, annotations, sites, effect_index, table)
                        Stmt.VarDecl(name, type_expression, value, statement_pos):
                            table <- ae_check_expression(type_expression, annotations, sites, effect_index, table)
                            table <- ae_check_expression(value, annotations, sites, effect_index, table)
                        Stmt.Assign(target, operator, value, statement_pos):
                            table <- ae_check_expression(target, annotations, sites, effect_index, table)
                            table <- ae_check_expression(value, annotations, sites, effect_index, table)
                        Stmt.If(condition, then_body, else_body, statement_pos):
                            table <- ae_check_expression(condition, annotations, sites, effect_index, table)
                            table <- ae_check_statements(then_body, annotations, sites, effect_index, table)
                            table <- ae_check_statements(else_body, annotations, sites, effect_index, table)
                        Stmt.While(condition, body, statement_pos):
                            table <- ae_check_expression(condition, annotations, sites, effect_index, table)
                            table <- ae_check_statements(body, annotations, sites, effect_index, table)
                        Stmt.For(bind, variables, iterable, body, statement_pos):
                            table <- ae_check_expression(iterable, annotations, sites, effect_index, table)
                            table <- ae_check_statements(body, annotations, sites, effect_index, table)
                        Stmt.Block(kind, clause, binding, body, statement_pos):
                            table <- ae_check_statements(body, annotations, sites, effect_index, table)
                        Stmt.Return(value, statement_pos):
                            table <- ae_check_expression(returned_value, annotations, sites, effect_index, table) if value is returned_value
                        Stmt.Match(scrutinee, arms, statement_pos):
                            table <- ae_check_expression(scrutinee, annotations, sites, effect_index, table)
                            for arm in arms |table|:
                                table <- ae_check_expression(arm.guard, annotations, sites, effect_index, table)
                                table <- ae_check_statements(arm.body, annotations, sites, effect_index, table)
                        Stmt.Contract(kind, expression, statement_pos):
                            table <- ae_check_expression(expression, annotations, sites, effect_index, table)
                        _:
                            pass



        def ae_clone_name_known(sites: EffectOperationPositionIndex&, key: u64) -> bool:
            can Abort.Panic:
                return sites.clone_name_hashes.get(key) is clone_marker

        def ae_check_declarations(declarations: darray[Ast::Decl], annotations: darray[Ast::EnumAnnotation]&, sites: EffectOperationPositionIndex&, effect_index: EffectDeclarationIdentityIndex&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table|:
                    match declaration:
                        Decl.Func(name, parameters, return_type, body, effects, decorators, declaration_pos):
                            # A template needs an `__effect_clone` row of its name; clone_name_hashes holds them all.
                            if ae_clone_name_known(sites, name_hash(name)):
                                table <- ae_check_statements(body, annotations, sites, effect_index, table) if not ae_effect_template_declared(annotations, name, declaration_pos.line, declaration_pos.offset)
                            else:
                                table <- ae_check_statements(body, annotations, sites, effect_index, table)
                        Decl.Module(name, body, declaration_pos):
                            table <- ae_check_declarations(body, annotations, sites, effect_index, table)
                        Decl.Scoped(body, declaration_pos):
                            table <- ae_check_declarations(body, annotations, sites, effect_index, table)
                        _:
                            pass



        def check_abstract_effects(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                # Relevant annotations plus one `__permission_alias` row per permission
                # alias, in declaration order so an alias may name an earlier alias. Built
                # HERE rather than returned from a helper: a darray grown in a callee has no
                # region to be returned in. (`alias` is not `type`: the parser keeps no target
                # expression for it, only the per-member head rows consulted above.)
                row_annotations: mutable darray[Ast::EnumAnnotation] = []
                for existing in file.enum_annotations |row_annotations|:
                    row_annotations.push(existing) if ae_row_annotation(existing)
                for candidate in file.enum_annotations |row_annotations, file|:
                    continue if candidate.line != AE_PERMISSION_ALIAS_MEMBER_ROW
                    continue if any known in row_annotations where known.owner == "__permission_alias" and known.name == candidate.owner
                    row_annotations.push(Ast::EnumAnnotation{owner: "__permission_alias", name: candidate.owner, line: 0}) if ae_alias_is_permission_set(candidate.owner, file.enum_annotations, row_annotations)
                effect_identity_index: mutable EffectDeclarationIdentityIndex = EffectDeclarationIdentityIndex{}
                handler_index: mutable EffectHandlerSemanticIndex = EffectHandlerSemanticIndex{}
                install_index: mutable EffectInstallPositionIndex = EffectInstallPositionIndex{}
                operation_index: mutable EffectOperationPositionIndex = EffectOperationPositionIndex{}
                can Global{Read,Write}:
                    ae_effect_declaration_identity_index(file.enum_annotations, effect_identity_index)
                    ae_effect_operation_identity_index(file.enum_annotations, effect_identity_index)
                    table <- ae_effect_operation_position_index(file.enum_annotations, effect_identity_index, operation_index, table)
                    table <- ae_handler_semantic_index(file.enum_annotations, effect_identity_index, handler_index, table)
                    table <- ae_effect_install_position_index(file.enum_annotations, effect_identity_index, handler_index, install_index, table)
                table <- ae_validate_effect_declarations(file.top_decls, row_annotations, table)
                table <- ae_validate_effect_blocks_declarations(file.top_decls, row_annotations, table)
                table <- ae_collect_install_declarations(file.top_decls, "", file.enum_annotations, install_index, handler_index, table) can Global{Read,Write}
                # Validate handler declarations and their operation coverage.
                for annotation in file.enum_annotations |table|:
                    if annotation.line == AE_EXPRESSION_OPERATION_ROW:
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.DuplicateAbstractEffectOperation, name: annotation.name, line: ae_effect_identity_decl_line(file.enum_annotations, annotation.identity_id), expected: annotation.owner, actual: "operation"}) if ae_duplicate_operation_declared(file.enum_annotations, annotation.owner, annotation.name)
                    if annotation.line == AE_HANDLER_OPERATION_ROW:
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.DuplicateEffectHandlerOperation, name: annotation.name, line: ae_handler_index_decl_line(handler_index, annotation.identity_id), expected: annotation.owner, actual: "operation"}) if ae_duplicate_handler_operation_declared(file.enum_annotations, annotation.owner, annotation.identity_id, annotation.name)
                    if annotation.line == AE_HANDLER_TARGET_ROW:
                        target_ref: mutable sview @source = ae_handler_index_target_ref(handler_index, annotation.identity_id)
                        target_ref <- annotation.name if target_ref == ""
                        target: sview = effect_ref_family(target_ref)
                        handler_line: u32 = ae_handler_index_decl_line(handler_index, annotation.identity_id)
                        target_identity_id: u32 = ae_handler_index_target_effect_id(handler_index, annotation.identity_id)
                        target_identity_known: bool = ae_effect_identity_index_declared(effect_identity_index, target_identity_id)
                        target_member: sview = effect_ref_member(target_ref)
                        target_validation_start: usize = table.diagnostics.count
                        if target_member != "" and (ae_effect_declared(file.enum_annotations, target) or ae_effect_ref_head_is_module(target, table)):
                            table <- ae_validate_effect_ref(target_ref, handler_line, file.enum_annotations, table)
                        target_validation_reported: bool = table.diagnostics.count > target_validation_start
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UnknownInterface, name: target, line: handler_line, expected: "effect", actual: ""}) if target != "" and not target_identity_known and not target_validation_reported
                        target_concrete: sview = effect_ref_via(target_ref)
                        table <- ae_validate_effect_ref(target_concrete, handler_line, file.enum_annotations, table) if target_concrete != ""
                    if annotation.line == AE_HANDLER_OPERATION_ROW:
                        target_ref: sview @source = ae_handler_index_target_ref(handler_index, annotation.identity_id)
                        target: sview = effect_ref_family(target_ref)
                        target_identity_id: u32 = ae_handler_index_target_effect_id(handler_index, annotation.identity_id)
                        target_identity_known: bool = ae_effect_identity_index_declared(effect_identity_index, target_identity_id)
                        operation_known: bool = ae_effect_operation_index_declared(effect_identity_index, target_identity_id, annotation.name)
                        handler_line: u32 = ae_handler_index_decl_line(handler_index, annotation.identity_id)
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AbstractEffectOperationMissing, name: annotation.name, line: handler_line, expected: target, actual: "operation"}) if target != "" and target_identity_known and not operation_known
                        effect_signature: sview = ae_effect_operation_signature_identity(file.enum_annotations, target_identity_id, annotation.name)
                        handler_signature: sview = ae_handler_operation_signature(file.enum_annotations, annotation.owner, annotation.identity_id, annotation.name)
                        effect_generic_names: darray[sview] = ae_effect_generic_names_identity(file.enum_annotations, target_identity_id)
                        effect_generic_values: darray[sview] = ae_effect_ref_arguments(target_ref)
                        specialization_arity_mismatch: bool = operation_known and effect_generic_names.count != effect_generic_values.count
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AbstractEffectSpecializationArity, name: annotation.owner, line: handler_line, expected: target, actual: target_ref, expected_count: effect_generic_names.count.u32(), actual_count: effect_generic_values.count.u32()}) if specialization_arity_mismatch
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.EffectHandlerSignatureMismatch, name: annotation.name, line: handler_line, expected: effect_signature, actual: annotation.owner}) if operation_known and not specialization_arity_mismatch and effect_signature != "" and handler_signature != "" and not ae_signature_matches(effect_signature, handler_signature, effect_generic_names, effect_generic_values)
                    if annotation.line == AE_HANDLER_RESUME_MISSING_ROW:
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.EffectHandlerResumeInvalid, name: annotation.name, line: ae_handler_index_decl_line(handler_index, annotation.identity_id), expected: "use exactly one final resume() statement", actual: annotation.owner})
                    if annotation.line == AE_HANDLER_RESUME_RETURN_ROW:
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.EffectHandlerResumeInvalid, name: annotation.name, line: ae_handler_index_decl_line(handler_index, annotation.identity_id), expected: "the operation must return void", actual: annotation.owner})
                    if annotation.owner == "__effect_install":
                        install_row: u32 = ae_install_position_index_at(install_index, annotation.line, annotation.offset)
                        handler_name: sview = install_index.handler_names[install_row.usize()] if install_row != AE_EFFECT_INDEX_NONE else annotation.name
                        handler_identity_id: u32 = install_index.handler_ids[install_row.usize()] if install_row != AE_EFFECT_INDEX_NONE else 0
                        effect_ref: sview = install_index.effect_refs[install_row.usize()] if install_row != AE_EFFECT_INDEX_NONE else ""
                        handler_is_declared: bool = ae_handler_index_declared(handler_index, handler_identity_id)
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UndefinedName, name: handler_name, line: annotation.line, expected: "effect handler", actual: ""}) if not handler_is_declared
                        required_captures: u32 = ae_handler_index_required_captures(handler_index, handler_identity_id)
                        total_captures: u32 = ae_handler_index_total_captures(handler_index, handler_identity_id)
                        supplied_captures: u32 = install_index.capture_counts[install_row.usize()] if install_row != AE_EFFECT_INDEX_NONE else 0
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.EffectHandlerCaptureArity, name: handler_name, line: annotation.line, expected: "", actual: "required", expected_count: required_captures, actual_count: supplied_captures}) if handler_is_declared and supplied_captures < required_captures
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.EffectHandlerCaptureArity, name: handler_name, line: annotation.line, expected: "", actual: "maximum", expected_count: total_captures, actual_count: supplied_captures}) if handler_is_declared and supplied_captures > total_captures
                        target_ref: sview = install_index.target_refs[install_row.usize()] if install_row != AE_EFFECT_INDEX_NONE else ""
                        target_identity_id: u32 = install_index.target_effect_ids[install_row.usize()] if install_row != AE_EFFECT_INDEX_NONE else 0
                        installed_identity_id: u32 = install_index.effect_ids[install_row.usize()] if install_row != AE_EFFECT_INDEX_NONE else 0
                        # The rows can be spelled differently and still name the same
                        # declaration, and spelled the same and name different ones. The
                        # parser records both IDs when available; semantic can resolve forward
                        # references from retained module context after the entire file is parsed.
                        install_identity_mismatch: mutable bool = install_index.identity_mismatches[install_row.usize()] if install_row != AE_EFFECT_INDEX_NONE else false
                        target_matches_install: bool = target_identity_id != 0 and installed_identity_id != 0 and target_identity_id == installed_identity_id and ae_effect_ref_same_specialization(target_ref, effect_ref)
                        install_identity_mismatch <- install_identity_mismatch or not target_matches_install if target_ref != "" and effect_ref != ""
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.EffectHandlerMismatch, name: handler_name, line: annotation.line, expected: target_ref, actual: effect_ref}) if target_ref != "" and effect_ref != "" and install_identity_mismatch
                expression_annotations: mutable darray[Ast::EnumAnnotation] = []
                for annotation in file.enum_annotations |expression_annotations|:
                    expression_annotations.push(annotation) if ae_expression_annotation(annotation)
                table <- ae_check_declarations(file.top_decls, expression_annotations, operation_index, effect_identity_index, table)

include "./check_effect_signatures.elisa"
include "./check_effect_declarations.elisa"
include "./check_effect_handlers.elisa"
include "./check_effect_operation_heads.elisa"
