                boxed_has_lo: mutable darray[bool] = []
                boxed_lo: mutable darray[i64] = []
                boxed_has_hi: mutable darray[bool] = []
                boxed_hi: mutable darray[i64] = []
                for existing in int_params |boxed_params|:
                    boxed_params.push(existing)
                box_probe: mutable usize = 0
                while box_probe < int_params.count |box_probe, boxed_has_lo, boxed_lo, boxed_has_hi, boxed_hi, has_lo, lo, has_hi, hi|:
                    boxed_has_lo.push(has_lo[box_probe])
                    boxed_lo.push(lo[box_probe])
                    boxed_has_hi.push(has_hi[box_probe])
                    boxed_hi.push(hi[box_probe])
                    box_probe <- box_probe + 1
                boxed_params.push(called)
                boxed_has_lo.push(false)
                boxed_lo.push(0)
                boxed_has_hi.push(false)
                boxed_hi.push(0)
                found_bound: mutable bool = false
                bound_offset: mutable usize = 0
                while bound_offset < sum_ensure_counts[index] |bound_offset, found_bound, index, called, boxed_params, boxed_has_lo, boxed_lo, boxed_has_hi, boxed_hi|:
                    summary2: Ast::Expr = all_sum_ensures[sum_ensure_starts[index] + bound_offset]
                    match summary2:
                        Expr.Binary(sum_left2, sum_operator2, sum_right2, sum_line2):
                            bound_const: (found: bool, value: i64) = fold_const_int(sum_right2)
                            usable: bool = ident_name_of(sum_left2) == "result" and bound_const.found and is_comparison_operator(sum_operator2)
                            if usable:
                                lin_apply_bound(called, sum_operator2, bound_const.value, false, boxed_params, boxed_has_lo, boxed_lo, boxed_has_hi, boxed_hi)
                                found_bound <- true
                        _:
                            pass
                    bound_offset <- bound_offset + 1
                false return if not found_bound
                synthetic: Ast::Expr = (Ast::Expr.Ident(called, 0))
                empty_env_names: darray[sview] = []
                empty_env_starts: darray[usize] = []
                empty_env_counts: darray[usize] = []
                empty_term_names: darray[sview] = []
                empty_term_coeffs: darray[i64] = []
                empty_env_consts: darray[i64] = []
                return linear_goal_deep_proven(goal_left, operator, goal_right, synthetic, true, false, boxed_params, boxed_has_lo, boxed_lo, boxed_has_hi, boxed_hi, empty_env_names, empty_env_starts, empty_env_counts, empty_term_names, empty_term_coeffs, empty_env_consts, inl_names, inl_param_starts, inl_param_counts, all_inl_params, inl_bodies)

        # Whether OPERATOR is any comparison (the ensure goal shapes the prover judges).
        def is_comparison_operator(operator: TokenKind) -> bool:
            can Abort.Panic:
                return operator == TokenKind.EqEq or operator == TokenKind.BangEq or operator == TokenKind.Lt or operator == TokenKind.Gt or operator == TokenKind.LtEq or operator == TokenKind.GtEq

        # --- Protocol-callee ensure injection (strict) --------------------------------
        # Under strict proofs, stage0 discharges a generic function's `ensure P` when its
        # returned value IS a protocol method's result and that method DECLARES the same
        # `ensure P` (both `result`s denote the same value). The parser skips protocol
        # method bodies but captures each method's ensure predicate SOURCE SPAN at
        # 3900000073 (owner = method name). Stage1 has no access to the parsed callee
        # contract, so we match the goal Expr against that span token-by-token
        # (whitespace-insensitive): `text = r.read(p); return text; ensure result.count >= 1`
        # is proven from Reader.read's `ensure result.count >= 1`. SOUND — our `result` is
        # exactly the callee's `result`, so any postcondition it guarantees transfers.
        def es_skip_span_spaces(span: sview, pos: usize) -> usize:
            can Abort.Panic:
                cursor: mutable usize = pos
                while cursor < sview_len(span) and (sview_at(span, cursor) == 32 or sview_at(span, cursor) == 9) |cursor, span|:
                    cursor <- cursor + 1
                return cursor

        def es_span_ident_byte(byte: u8) -> bool:
            can Abort.Panic:
                return (byte >= 65 and byte <= 90) or (byte >= 97 and byte <= 122) or byte == 95 or (byte >= 48 and byte <= 57)

        # Match a single byte after skipping leading spaces.
        def es_match_byte(span: sview, pos: usize, want: u8) -> (ok: bool, at: usize):
            can Abort.Panic:
                cursor: usize = es_skip_span_spaces(span, pos)
                (true, cursor + 1) return if cursor < sview_len(span) and sview_at(span, cursor) == want
                return (false, cursor)

        # Match two contiguous raw bytes (no interior space) from `pos`.
        def es_match_two(span: sview, pos: usize, a: u8, b: u8) -> (ok: bool, at: usize):
            can Abort.Panic:
                (false, pos) return if pos + 1 >= sview_len(span)
                (true, pos + 2) return if sview_at(span, pos) == a and sview_at(span, pos + 1) == b
                return (false, pos)

        def es_match_one(span: sview, pos: usize, a: u8) -> (ok: bool, at: usize):
            can Abort.Panic:
                (true, pos + 1) return if pos < sview_len(span) and sview_at(span, pos) == a
                return (false, pos)

        def es_match_three(span: sview, pos: usize, a: u8, b: u8, c: u8) -> (ok: bool, at: usize):
            can Abort.Panic:
                (false, pos) return if pos + 2 >= sview_len(span)
                (true, pos + 3) return if sview_at(span, pos) == a and sview_at(span, pos + 1) == b and sview_at(span, pos + 2) == c
                return (false, pos)

        # Match an operator's source spelling after skipping leading spaces.
        def es_match_op(span: sview, pos: usize, operator: TokenKind) -> (ok: bool, at: usize):
            can Abort.Panic:
                cursor: usize = es_skip_span_spaces(span, pos)
                return match operator:
                    TokenKind.EqEq: es_match_two(span, cursor, 61, 61)
                    TokenKind.BangEq: es_match_two(span, cursor, 33, 61)
                    TokenKind.GtEq: es_match_two(span, cursor, 62, 61)
                    TokenKind.LtEq: es_match_two(span, cursor, 60, 61)
                    TokenKind.Lt: es_match_one(span, cursor, 60)
                    TokenKind.Gt: es_match_one(span, cursor, 62)
                    TokenKind.Plus: es_match_one(span, cursor, 43)
                    TokenKind.Minus: es_match_one(span, cursor, 45)
                    TokenKind.Star: es_match_one(span, cursor, 42)
                    TokenKind.Slash: es_match_one(span, cursor, 47)
                    TokenKind.Percent: es_match_one(span, cursor, 37)
                    TokenKind.And: es_match_three(span, cursor, 97, 110, 100)
                    TokenKind.Or: es_match_two(span, cursor, 111, 114)
                    _: (false, cursor)

        # Match identifier `name` (a whole ident run) after skipping leading spaces.
        def es_match_ident(span: sview, pos: usize, name: sview) -> (ok: bool, at: usize):
            can Abort.Panic:
                cursor: usize = es_skip_span_spaces(span, pos)
                end: mutable usize = cursor
                while end < sview_len(span) and es_span_ident_byte(sview_at(span, end)) |end, span|:
                    end <- end + 1
                length: usize = end - cursor
                (false, cursor) return if length != sview_len(name) or length == 0
                probe: mutable usize = 0
                while probe < length |probe, span, name, cursor|:
                    (false, cursor) return if sview_at(span, cursor + probe) != sview_at(name, probe)
                    probe <- probe + 1
                return (true, end)

        # Match a non-negative integer literal after skipping leading spaces.
        def es_match_int(span: sview, pos: usize, value: i64) -> (ok: bool, at: usize):
            can Memory.Allocate, Abort.Panic:
                (false, pos) return if value < 0
                cursor: usize = es_skip_span_spaces(span, pos)
                digits: mutable darray[u8] = []
                magnitude: mutable i64 = value
                digits.push(48) if magnitude == 0
                while magnitude > 0 |magnitude, digits|:
                    digits.push((48 + (magnitude % 10)).u8())
                    magnitude <- magnitude / 10
                count: usize = digits.count
                run: mutable usize = cursor
                probe: mutable usize = 0
                while probe < count |probe, run, span, digits, count, cursor|:
                    want: u8 = digits[count - 1 - probe]
                    (false, cursor) return if run >= sview_len(span) or sview_at(span, run) != want
                    run <- run + 1
                    probe <- probe + 1
                # A trailing digit would mean a longer number (e.g. span `12` vs literal `1`).
                (false, cursor) return if run < sview_len(span) and sview_at(span, run) >= 48 and sview_at(span, run) <= 57
                return (true, run)

        def es_expr_matches_span(expr: Ast::Expr, span: sview, pos: usize) -> (ok: bool, at: usize):
            can Memory.Allocate, Abort.Panic:
                match expr:
                    Expr.Ident(name, line):
                        return es_match_ident(span, pos, name)
                    Expr.IntLit(value):
                        return es_match_int(span, pos, value)
                    Expr.Paren(inner, paren_line):
                        open_step: (ok: bool, at: usize) = es_match_byte(span, pos, 40)
                        (false, pos) return if not open_step.ok
                        inner_step: (ok: bool, at: usize) = es_expr_matches_span(inner, span, open_step.at)
                        (false, pos) return if not inner_step.ok
                        return es_match_byte(span, inner_step.at, 41)
                    Expr.Field(object, field, field_line):
                        object_step: (ok: bool, at: usize) = es_expr_matches_span(object, span, pos)
                        (false, pos) return if not object_step.ok
                        dot_step: (ok: bool, at: usize) = es_match_byte(span, object_step.at, 46)
                        (false, pos) return if not dot_step.ok
                        return es_match_ident(span, dot_step.at, field)
                    Expr.Unary(operator, operand, unary_line):
                        op_step: (ok: bool, at: usize) = es_match_op(span, pos, operator)
                        (false, pos) return if not op_step.ok
                        return es_expr_matches_span(operand, span, op_step.at)
                    Expr.Binary(left, operator, right, binary_line):
                        left_step: (ok: bool, at: usize) = es_expr_matches_span(left, span, pos)
                        (false, pos) return if not left_step.ok
                        op_step: (ok: bool, at: usize) = es_match_op(span, left_step.at, operator)
                        (false, pos) return if not op_step.ok
                        return es_expr_matches_span(right, span, op_step.at)
                    Expr.Call(callee, arguments, argument_names, call_line):
                        callee_step: (ok: bool, at: usize) = es_expr_matches_span(callee, span, pos)
                        (false, pos) return if not callee_step.ok
                        open_step: (ok: bool, at: usize) = es_match_byte(span, callee_step.at, 40)
                        (false, pos) return if not open_step.ok
                        arg_at: mutable usize = open_step.at
                        arg_ok: mutable bool = true
                        arg_index: mutable usize = 0
                        while arg_index < arguments.count |arg_index, arg_at, arg_ok, arguments, span|:
                            if arg_index > 0:
                                comma_step: (ok: bool, at: usize) = es_match_byte(span, arg_at, 44)
                                arg_ok <- false if not comma_step.ok
                                arg_at <- comma_step.at
                            argument_step: (ok: bool, at: usize) = es_expr_matches_span(arguments[arg_index], span, arg_at)
                            arg_ok <- false if not argument_step.ok
                            arg_at <- argument_step.at
                            arg_index <- arg_index + 1
                        (false, pos) return if not arg_ok
                        return es_match_byte(span, arg_at, 41)
                    _:
                        return (false, pos)

        # Whether the goal predicate is TEXTUALLY the whole span (whitespace-insensitive).
        def es_goal_equals_span(goal: Ast::Expr, span: sview) -> bool:
            can Memory.Allocate, Abort.Panic:
                step: (ok: bool, at: usize) = es_expr_matches_span(goal, span, 0)
                false return if not step.ok
                remainder: usize = es_skip_span_spaces(span, step.at)
                return remainder >= sview_len(span)

        # Method name of a `recv.method(args)` call expression, else "".
        def es_call_method_name(expression: Ast::Expr) -> sview:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, call_line):
                        return match callee:
                            Expr.Field(object, field, field_line): field
                            _: sview("", 0, 0)
                    Expr.Paren(inner, paren_line):
                        return es_call_method_name(inner)
                    _:
                        return sview("", 0, 0)

        # The method name whose result is the function's return value: a direct
        # `return recv.m(args)`, or `return L` where `L = recv.m(args)` and L is not
        # wholly reassigned. "" when the return value is not a single method-call result.
        def es_return_method_name(return_expression: Ast::Expr, body: darray[Ast::Stmt]) -> sview:
            can Memory.Allocate, Abort.Panic:
                direct: sview = es_call_method_name(return_expression)
                direct return if direct != ""
                local: sview = ident_name_of(return_expression)
                (sview("", 0, 0)) return if local == "" or es_local_wholly_reassigned(body, local)
                found: mutable sview = sview("", 0, 0)
                for statement in body |found, local|:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            found <- es_call_method_name(value) if name == local and found == ""
                        Stmt.Assign(target, operator, value, line):
                            found <- es_call_method_name(value) if ident_name_of(target) == local and found == ""
                        _:
                            pass
                return found

        # --- Protocol algebraic-law discharge (transitivity) --------------------------
        # `ensure result == true; return x.le(z)` with `requires x.le(y), y.le(z)` is proven
        # by the protocol's transitivity law `(a.le(b) and b.le(c)) implies a.le(c)`. We
        # recognise the shape structurally: a boolean method-relation return chained through
        # the requires, backed by an available `implies`-law over that method (span sentinel
        # 3900000078). A protocol WITHOUT such a law (only `total`, no `implies`) is not
        # matched, so the goal stays unproven — mirroring stage0.
        def es_span_contains(span: sview, needle: sview) -> bool:
            can Memory.Allocate, Abort.Panic:
                needle_length: usize = sview_len(needle)
                (false) return if needle_length == 0 or sview_len(span) < needle_length
                limit: usize = sview_len(span) - needle_length
                start: mutable usize = 0
                while start <= limit |start, span, needle, needle_length|:
                    matched: mutable bool = true
                    offset: mutable usize = 0
                    while offset < needle_length |offset, matched, span, needle, start|:
                        matched <- false if sview_at(span, start + offset) != sview_at(needle, offset)
                        offset <- offset + 1
                    true return if matched
                    start <- start + 1
                return false

        def es_is_true_literal(expression: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.BoolLit(value):
                        return value
                    Expr.Ident(name, ident_line):
                        return name == "true"
                    _:
                        return false

        # A goal `result == true` / bare `result` — a "the relation holds" postcondition.
        def es_goal_is_true(goal: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                match goal:
                    Expr.Paren(inner, paren_line):
                        return es_goal_is_true(inner)
                    Expr.Ident(name, ident_line):
                        return name == "result"
                    Expr.Binary(left, operator, right, binary_line):
                        return operator == TokenKind.EqEq and ident_name_of(left) == "result" and es_is_true_literal(right)
                    _:
                        return false

        # A binary method relation `recv.method(arg)` — (found, recv, method, arg).
        def es_method_relation(expression: Ast::Expr) -> (found: bool, recv: sview, method: sview, arg: Ast::Expr):
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Paren(inner, paren_line):
                        return es_method_relation(inner)
                    Expr.Call(callee, arguments, argument_names, call_line):
                        if callee is Expr.Field(object, method, field_line):
                            recv: sview = ident_name_of(object)
                            (true, recv, method, arguments[0]) return if recv != "" and arguments.count == 1
                        return (false, sview("", 0, 0), sview("", 0, 0), (Ast::Expr.Absent))
                    _:
                        return (false, sview("", 0, 0), sview("", 0, 0), (Ast::Expr.Absent))

        # Whether `requires` chains recv.method(mid) and mid.method(arg) for some middle term.
        def es_requires_chain(recv: sview, method: sview, arg: Ast::Expr, requires_predicates: darray[Ast::Expr]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                arg_name: sview = ident_name_of(arg)
                (false) return if arg_name == ""
                for first in requires_predicates |recv, method, arg_name, requires_predicates|:
                    first_relation: (found: bool, recv: sview, method: sview, arg: Ast::Expr) = es_method_relation(first)
                    if first_relation.found and first_relation.recv == recv and first_relation.method == method:
                        mid: sview = ident_name_of(first_relation.arg)
                        if mid != "":
                            for second in requires_predicates |method, mid, arg_name|:
                                second_relation: (found: bool, recv: sview, method: sview, arg: Ast::Expr) = es_method_relation(second)
                                true return if second_relation.found and second_relation.method == method and second_relation.recv == mid and ident_name_of(second_relation.arg) == arg_name
                return false

        # Whether the ensure GOAL is discharged by a protocol transitivity law over the return.
        def es_protocol_law_proves(goal: Ast::Expr, return_expression: Ast::Expr, has_return: bool, requires_predicates: darray[Ast::Expr]&, law_spans: darray[sview]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                false return if not has_return
                false return if not es_goal_is_true(goal)
                relation: (found: bool, recv: sview, method: sview, arg: Ast::Expr) = es_method_relation(return_expression)
                false return if not relation.found
                false return if not es_requires_chain(relation.recv, relation.method, relation.arg, requires_predicates)
                implies_needle: sview = "implies"
                return any law in law_spans where es_span_contains(law, implies_needle) and es_span_contains(law, relation.method)

        # Bare-parameter return names anywhere in a body (`return a`).
        def es_collect_param_returns(statements: darray[Ast::Stmt], out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |out|:
                    match statement:
                        Stmt.Return(value, line):
                            if value is returned:
                                name: sview = ident_name_of(returned)
                                out.push(name) if name != ""
                        Stmt.If(condition, then_body, else_body, if_line):
                            es_collect_param_returns(then_body, out)
                            es_collect_param_returns(else_body, out)
                        Stmt.Block(block_kind, clause, binding, block_body, block_line):
                            es_collect_param_returns(block_body, out)
                        Stmt.Match(scrutinee, arms, match_line):
                            for arm in arms |out|:
                                es_collect_param_returns(arm.body, out)
                        _:
                            pass

        # Split a predicate on `and` into its conjuncts.
        def es_and_conjuncts(predicate: Ast::Expr, out: mutable darray[Ast::Expr]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match predicate:
                    Expr.Paren(inner, paren_line):
                        es_and_conjuncts(inner, out)
                    Expr.Binary(left, operator, right, binary_line):
                        if operator == TokenKind.And:
                            es_and_conjuncts(left, out)
                            es_and_conjuncts(right, out)
                        else:
                            out.push(predicate)
                    _:
                        out.push(predicate)

        # A branchy `ensure result.M(X) and ...` whose conjunct `result.M(P)` becomes the
        # REFLEXIVE obligation `P.M(P)` in the branch `return P` — unprovable for a bare method
        # relation unless some protocol law establishes M's reflexivity. No law over M in scope
        # → stage0 cannot discharge it and reports the ensure unproven.
        def es_reflexive_obligation_unproven(ensure_expression: Ast::Expr, body: darray[Ast::Stmt], law_spans: darray[sview]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                returns: mutable darray[sview] = []
                es_collect_param_returns(body, returns)
                (false) return if returns.count == 0
                conjuncts: mutable darray[Ast::Expr] = []
                es_and_conjuncts(ensure_expression, conjuncts)
                for conjunct in conjuncts |returns, law_spans|:
                    relation: (found: bool, recv: sview, method: sview, arg: Ast::Expr) = es_method_relation(conjunct)
                    if relation.found and relation.recv == "result":
                        arg_name: sview = ident_name_of(relation.arg)
                        reflexive: bool = arg_name != "" and (any candidate in returns where candidate == arg_name)
                        law_covers: bool = any law in law_spans where es_span_contains(law, relation.method)
                        true return if reflexive and not law_covers
                return false

        # Whether the ensure GOAL is guaranteed by the protocol method whose result we return.
        def es_protocol_ensure_matches(goal: Ast::Expr, return_expression: Ast::Expr, has_return: bool, body: darray[Ast::Stmt], pe_owners: darray[sview]&, pe_spans: darray[sview]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                false return if not has_return
                method: sview = es_return_method_name(return_expression, body)
                false return if method == ""
                index: mutable usize = 0
                while index < pe_owners.count |index, method, goal, pe_owners, pe_spans|:
                    true return if pe_owners[index] == method and es_goal_equals_span(goal, pe_spans[index])
                    index <- index + 1
                return false

        # Whether the local `name` is WHOLLY reassigned (`name <- E`) anywhere in the body —
        # which would invalidate a zeroed-then-field-written model of it.
        def es_local_wholly_reassigned(body: darray[Ast::Stmt], name: sview) -> bool:
            can Memory.Allocate, Abort.Panic:
                for statement in body:
                    match statement:
                        Stmt.Assign(target, operator, value, line):
                            true return if operator == TokenKind.LArrow and ident_name_of(target) == name
                        _:
                            pass
                return false

        # Whether EXPR (through `&`/parens) names the local — a call argument that could alias it.
        def es_arg_references_local(expression: Ast::Expr, local: sview) -> bool:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Ident(name, line):
                        return name == local
                    Expr.Unary(operator, operand, line):
                        return es_arg_references_local(operand, local)
                    Expr.Paren(inner, line):
                        return es_arg_references_local(inner, local)
                    _:
                        return false

        # Whether EXPRESSION contains a call that passes `local` (or `&local`) as an argument —
        # the callee may mutate its fields through the reference, invalidating field tracking.
        def es_expr_passes_local_to_call(expression: Ast::Expr, local: sview, depth: u32) -> bool:
            can Memory.Allocate, Abort.Panic:
                false return if depth > 40
                match expression:
                    Expr.Call(callee, arguments, argument_names, line):
                        for argument in arguments |local|:
                            true return if es_arg_references_local(argument, local)
                        for argument in arguments |local, depth|:
                            true return if es_expr_passes_local_to_call(argument, local, depth + 1)
                        return es_expr_passes_local_to_call(callee, local, depth + 1)
                    Expr.Binary(left, operator, right, line):
                        return es_expr_passes_local_to_call(left, local, depth + 1) or es_expr_passes_local_to_call(right, local, depth + 1)
                    Expr.Unary(operator, operand, line):
                        return es_expr_passes_local_to_call(operand, local, depth + 1)
                    Expr.Paren(inner, line):
                        return es_expr_passes_local_to_call(inner, local, depth + 1)
                    Expr.Field(object, field, line):
                        return es_expr_passes_local_to_call(object, local, depth + 1)
                    Expr.Index(object, index, line):
                        return es_expr_passes_local_to_call(object, local, depth + 1) or es_expr_passes_local_to_call(index, local, depth + 1)
                    _:
                        return false

        # Whether the body passes `local` to any call — a conservative escape check.
        def es_local_escapes_to_call(body: darray[Ast::Stmt], local: sview) -> bool:
            can Memory.Allocate, Abort.Panic:
                for statement in body:
                    match statement:
                        Stmt.Expr(expression, line):
                            true return if es_expr_passes_local_to_call(expression, local, 0)
                        Stmt.VarDecl(name, type_expression, value, line):
