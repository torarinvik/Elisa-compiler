        # reflexive prover cannot substitute soundly, since the result depends on the branch.
        def is_conditional_expression(expression: Ast::Expr) -> bool:
            can Abort.Panic:
                return match expression:
                    Expr.If(condition, then_expression, else_expression, line): true
                    _: false

        # Whether NAME is a sized integer type (the domain where the linear tier's strict
        # bound tightening `x > c  =>  x >= c+1` is exact).
        def ensure_int_type_name(name: sview) -> bool:
            can Abort.Panic:
                return name == "i8" or name == "i16" or name == "i32" or name == "i64" or name == "u8" or name == "u16" or name == "u32" or name == "u64" or name == "usize" or name == "isize" or name == "int" or name == "uint"


        # Whether NAME is an UNSIGNED integer type (contributes an implicit `>= 0` bound).
        def ensure_unsigned_type_name(name: sview) -> bool:
            can Abort.Panic:
                return name == "u8" or name == "u16" or name == "u32" or name == "u64" or name == "usize" or name == "uint"


        def check_ensure_strict_function(parameters: darray[Ast::ParamDecl], body: darray[Ast::Stmt], function_name: sview, fn_bound_names: darray[sview]&, fn_bound_lo: darray[i64]&, fn_bound_hi: darray[i64]&, struct_names: darray[sview]&, inv_starts: darray[usize]&, inv_counts: darray[usize]&, all_invariants: darray[Ast::Expr]&, inl_names: darray[sview]&, inl_param_starts: darray[usize]&, inl_param_counts: darray[usize]&, all_inl_params: darray[sview]&, inl_bodies: darray[Ast::Expr]&, sum_names: darray[sview]&, sum_param_starts: darray[usize]&, sum_param_counts: darray[usize]&, all_sum_params: darray[sview]&, sum_ensure_starts: darray[usize]&, sum_ensure_counts: darray[usize]&, all_sum_ensures: darray[Ast::Expr]&, es_law_names: darray[sview]&, es_law_predicates: darray[Ast::Expr]&, es_alias_names: darray[sview]&, es_alias_targets: darray[Ast::Expr]&, pe_owners: darray[sview]&, pe_spans: darray[sview]&, law_spans: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                requires_predicates: mutable darray[Ast::Expr] = []
                return_expressions: mutable darray[Ast::Expr] = []
                branchy: mutable bool = false
                for statement in body |requires_predicates, return_expressions, branchy|:
                    match statement:
                        Stmt.Contract(kind, expression, line):
                            requires_predicates.push(expression) if kind == "requires"
                        Stmt.Return(value, line):
                            return_expressions.push(returned) if value is returned
                        Stmt.If(condition, then_body, else_body, line):
                            branchy <- true
                        Stmt.While(condition, while_body, line):
                            branchy <- true
                        Stmt.Match(scrutinee, arms, line):
                            branchy <- true
                        Stmt.Block(kind, clause, binding, block_body, line):
                            branchy <- true
                        _:
                            pass
                # Only judge a function whose value is a SINGLE straight-line return of a
                # non-conditional expression: there the ensure goal is `result <op> E` with
                # `result` == that return value, so the reflexive prover's verdict is sound.
                # Any branching / multiple returns / ternary return may establish the goal via
                # flow facts stage0's prover tracks (e.g. `max`'s `return a if a>b else b`
                # proves `result >= a`), so those are left unreported (a sound miss).
                single_return: bool = return_expressions.count == 1 and not branchy and not (any candidate in return_expressions where is_conditional_expression(candidate))
                if not single_return:
                    # Branchy bodies are otherwise not proof-attempted, but a returned `zeroed` struct
                    # whose `ensure result.FIELD == RHS` is established ONLY by a conditional store is
                    # provably unproven (the fall-through leaves the field 0) — report it before bailing.
                    branchy_returned_name: sview = ident_name_of(return_expressions[0]) if return_expressions.count == 1 else sview("", 0, 0)
                    if branchy_returned_name != "":
                        branchy_zeroed: mutable bool = false
                        for branchy_local in body |branchy_zeroed, branchy_returned_name|:
                            match branchy_local:
                                Stmt.VarDecl(bz_name, bz_type, bz_value, bz_line):
                                    branchy_zeroed <- true if bz_name == branchy_returned_name and ident_name_of(bz_value) == "zeroed"
                                _:
                                    pass
                        for branchy_statement in body |table| -> table:
                            match branchy_statement:
                                Stmt.Contract(bc_kind, bc_expression, bc_line):
                                    branchy_unproven: bool = bc_kind == "ensure" and (es_zeroed_field_conditional_unproven(bc_expression, branchy_returned_name, branchy_zeroed, body) or es_param_upper_unprovable(bc_expression, branchy_returned_name, body, parameters, requires_predicates) or es_overflow_ensure_unproven(bc_expression, branchy_returned_name, body, requires_predicates) or es_reflexive_obligation_unproven(bc_expression, body, law_spans))
                                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.EnsureNotProven, name: function_name, line: bc_line, expected: "", actual: ""}) if branchy_unproven
                                _:
                                    pass
                    # A `match` that returns an unconstrained enum-payload binding cannot establish an
                    # `ensure result >= 0` — the payload's value is unbounded (stage0 cannot unfold it).
                    match_param_names: mutable darray[sview] = []
                    for match_parameter in parameters |match_param_names|:
                        match_param_names.push(match_parameter.name)
                    match_local_names: mutable darray[sview] = []
                    for match_local in body |match_local_names|:
                        match match_local:
                            Stmt.VarDecl(ml_name, ml_type, ml_value, ml_line):
                                match_local_names.push(ml_name)
                            _:
                                pass
                    for match_statement in body |table| -> table:
                        match match_statement:
                            Stmt.Contract(mc_kind, mc_expression, mc_line):
                                match_unproven: bool = mc_kind == "ensure" and ((es_goal_is_result_nonneg(mc_expression) and es_match_returns_unconstrained_binding(body, match_param_names, match_local_names)) or (es_goal_result_vs_literal(mc_expression) and es_match_returns_recursive(body, function_name)) or es_field_implication_unproven(mc_expression, body) or es_additive_overflow_ensure(mc_expression, body, parameters, requires_predicates))
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.EnsureNotProven, name: function_name, line: mc_line, expected: "", actual: ""}) if match_unproven
                            _:
                                pass
                    return
                # A return through an fn-typed PARAMETER (`return f(x)`) is not judged:
                # stage0 accepts it silently in both directions (the callee is opaque and
                # any `ensures(f, ...)` requires is trusted, not re-proven here).
                match return_expressions[0]:
                    Expr.Call(returned_callee, returned_arguments, returned_argument_names, returned_call_line):
                        callee_name: sview = ident_name_of(returned_callee)
                        return if callee_name != "" and (any fn_param in parameters where fn_param.name == callee_name)
                    _:
                        pass
                # Integer parameters and their box bounds, from `requires` clauses and
                # `where` refinements on the parameter types themselves.
                int_params: mutable darray[sview] = []
                has_lo: mutable darray[bool] = []
                lo: mutable darray[i64] = []
                has_hi: mutable darray[bool] = []
                hi: mutable darray[i64] = []
                where_predicates: mutable darray[Ast::Expr] = []
                for parameter in parameters |int_params, has_lo, lo, has_hi, hi, where_predicates|:
                    base_type: mutable Ast::Expr = parameter.type_expression
                    match parameter.type_expression:
                        Expr.Refinement(refined_base, refined_predicate, refinement_line):
                            base_type <- refined_base
                            where_predicates.push(refined_predicate)
                        _:
                            pass
                    type_name: sview = bare_type_name(base_type)
                    if ensure_int_type_name(type_name):
                        int_params.push(parameter.name)
                        unsigned: bool = ensure_unsigned_type_name(type_name)
                        has_lo.push(unsigned)
                        lo.push(0)
                        has_hi.push(false)
                        hi.push(0)
                # A local bound to a call whose callee has a range-refined return type
                # (`y = clamp_byte(x)`, `clamp_byte -> i64 is Bounded[0, 255]`) inherits [lo, hi]
                # as a fixed interval — provided the local is not later reassigned.
                for local_statement in body |int_params, has_lo, lo, has_hi, hi, body, fn_bound_names, fn_bound_lo, fn_bound_hi|:
                    match local_statement:
                        Stmt.VarDecl(local_name, local_type, local_value, local_line):
                            match local_value:
                                Expr.Call(callee, arguments, argument_names, call_line):
                                    callee_name: sview = ident_name_of(callee)
                                    bound_slot: mutable i64 = -1
                                    bslot_probe: mutable usize = 0
                                    while bslot_probe < fn_bound_names.count |bound_slot, bslot_probe, callee_name, fn_bound_names|:
                                        bound_slot <- bslot_probe.i64() if fn_bound_names[bslot_probe] == callee_name and bound_slot < 0
                                        bslot_probe <- bslot_probe + 1
                                    if bound_slot >= 0 and not es_local_wholly_reassigned(body, local_name):
                                        int_params.push(local_name)
                                        has_lo.push(true)
                                        lo.push(fn_bound_lo[bound_slot.usize()])
                                        has_hi.push(true)
                                        hi.push(fn_bound_hi[bound_slot.usize()])
                                _:
                                    pass
                        _:
                            pass
                for required in requires_predicates |int_params, has_lo, lo, has_hi, hi|:
                    lin_collect_fact(required, int_params, has_lo, lo, has_hi, hi)
                for refined in where_predicates |int_params, has_lo, lo, has_hi, hi|:
                    lin_collect_fact(refined, int_params, has_lo, lo, has_hi, hi)
                # A parameter the body ASSIGNS no longer carries its entry facts at the
                # return (`requires m > 100; m <- 0; return m`): drop its bounds entirely.
                for statement in body |int_params, has_lo, has_hi|:
                    match statement:
                        Stmt.Assign(target, operator, value, assign_line):
                            assigned: sview = ident_name_of(target)
                            drop_probe: mutable usize = 0
                            while drop_probe < int_params.count |drop_probe, assigned, int_params, has_lo, has_hi|:
                                if int_params[drop_probe] == assigned:
                                    has_lo[drop_probe] <- false
                                    has_hi[drop_probe] <- false
                                drop_probe <- drop_probe + 1
                        _:
                            pass
                # ENVIRONMENT: straight-line locals resolved to affine forms over the
                # parameters (`y = x; y <- y - 1; return y`). A non-affine initializer
                # (or a borrow) leaves the local opaque, which soundly fails the prover.
                env_names: mutable darray[sview] = []
                env_starts: mutable darray[usize] = []
                env_counts: mutable darray[usize] = []
                env_term_names: mutable darray[sview] = []
                env_term_coeffs: mutable darray[i64] = []
                env_consts: mutable darray[i64] = []
                for statement in body |env_names, env_starts, env_counts, env_term_names, env_term_coeffs, env_consts|:
                    match statement:
                        Stmt.VarDecl(local_name, local_type, local_value, local_line):
                            local_names2: mutable darray[sview] = []
                            local_coeffs2: mutable darray[i64] = []
                            local_konst2: mutable i64 = 0
                            local_linear: bool = lin_add_deep(local_value, 1, local_names2, local_coeffs2, local_konst2, Ast::Expr.Invalid, false, 0, env_names, env_starts, env_counts, env_term_names, env_term_coeffs, env_consts, inl_names, inl_param_starts, inl_param_counts, all_inl_params, inl_bodies)
                            continue if not local_linear
                            env_names.push(local_name)
                            env_starts.push(env_term_names.count)
                            env_counts.push(local_names2.count)
                            env_term_names.extend(local_names2)
                            env_term_coeffs.extend(local_coeffs2)
                            env_consts.push(local_konst2)
                        Stmt.Assign(assign_target, assign_operator, assign_value, assign_line):
                            assigned2: sview = ident_name_of(assign_target)
                            continue if assigned2 == ""
                            # A write through a REF alias invalidates the target's known form
                            # (conservatively opaque). A plain rebind `y <- E` or an AFFINE
                            # compound `y += C` / `y -= C` (== `y = y (±) C`, resolved through the
                            # env) updates it.
                            aliased_target: sview = ensure_env_alias_of(body, assigned2)
                            is_plain_rebind: bool = assign_operator == TokenKind.LArrow
                            is_add_assign: bool = assign_operator == TokenKind.PlusEq
                            is_sub_assign: bool = assign_operator == TokenKind.MinusEq
                            if aliased_target != "" or not (is_plain_rebind or is_add_assign or is_sub_assign):
                                wipe: mutable usize = 0
                                while wipe < env_names.count |wipe, assigned2, aliased_target, env_names|:
                                    env_names[wipe] <- sview("", 0, 0) if env_names[wipe] == assigned2
                                    env_names[wipe] <- sview("", 0, 0) if aliased_target != "" and env_names[wipe] == aliased_target
                                    wipe <- wipe + 1
                                continue
                            new_names2: mutable darray[sview] = []
                            new_coeffs2: mutable darray[i64] = []
                            new_konst2: mutable i64 = 0
                            new_linear: mutable bool = true
                            if is_plain_rebind:
                                new_linear <- lin_add_deep(assign_value, 1, new_names2, new_coeffs2, new_konst2, Ast::Expr.Invalid, false, 0, env_names, env_starts, env_counts, env_term_names, env_term_coeffs, env_consts, inl_names, inl_param_starts, inl_param_counts, all_inl_params, inl_bodies)
                            else:
                                base_linear: bool = lin_add_deep(assign_target, 1, new_names2, new_coeffs2, new_konst2, Ast::Expr.Invalid, false, 0, env_names, env_starts, env_counts, env_term_names, env_term_coeffs, env_consts, inl_names, inl_param_starts, inl_param_counts, all_inl_params, inl_bodies)
                                value_sign: i64 = 1 if is_add_assign else (0 - 1)
                                value_linear: bool = lin_add_deep(assign_value, value_sign, new_names2, new_coeffs2, new_konst2, Ast::Expr.Invalid, false, 0, env_names, env_starts, env_counts, env_term_names, env_term_coeffs, env_consts, inl_names, inl_param_starts, inl_param_counts, all_inl_params, inl_bodies)
                                new_linear <- base_linear and value_linear
                            # A REASSIGNED local appends a fresh env row; lookups scan and
                            # take the FIRST match, so shadow by prepend is unavailable —
                            # instead invalidate the old row's name and append.
                            invalidate: mutable usize = 0
                            while invalidate < env_names.count |invalidate, assigned2, env_names|:
                                env_names[invalidate] <- sview("", 0, 0) if env_names[invalidate] == assigned2
                                invalidate <- invalidate + 1
                            continue if not new_linear
                            env_names.push(assigned2)
                            env_starts.push(env_term_names.count)
                            env_counts.push(new_names2.count)
                            env_term_names.extend(new_names2)
                            env_term_coeffs.extend(new_coeffs2)
                            env_consts.push(new_konst2)
                        _:
                            pass
                # A single return of a bare REFERENCE parameter (`return p`, `p: Foo&`)
                # discharges an `ensure result != null`: references are never null.
                returned_ref_param: mutable bool = false
                returned_bare_name: sview = ident_name_of(return_expressions[0]) if return_expressions.count == 1 else sview("", 0, 0)
                for reference_parameter in parameters |returned_ref_param, returned_bare_name|:
                    returned_ref_param <- true if returned_bare_name != "" and reference_parameter.name == returned_bare_name and type_marker_present(reference_parameter.type_expression, TokenKind.Ampersand) and not type_marker_present(reference_parameter.type_expression, TokenKind.Question)
                # A body that performs NO mutation preserves its entry `requires` facts to
                # the return, so a goal restating a requires clause (after result-substitution)
                # is discharged. Any assignment invalidates that.
                body_pure: mutable bool = true
                for statement in body |body_pure|:
                    match statement:
                        Stmt.Assign(assign_target, assign_operator, assign_value, assign_line):
                            body_pure <- false
                        _:
                            pass
                return_expression_single: Ast::Expr = return_expressions[0] if return_expressions.count == 1 else (Ast::Expr.Invalid)
                # RESTATE facts = `requires` clauses PLUS the design-by-contract invariants of
                # any `self`-typed struct parameter (invariants reference `self`, so they apply
                # verbatim). The caller upholds them at entry; a pure body preserves them.
                restate_facts: mutable darray[Ast::Expr] = []
                restate_facts.extend(requires_predicates)
                for invariant_parameter in parameters |restate_facts, struct_names, inv_starts, inv_counts, all_invariants|:
                    if invariant_parameter.name == "self":
                        self_struct: sview = es_unwrap_type_name(invariant_parameter.type_expression)
                        struct_slot: mutable i64 = -1
                        struct_probe: mutable usize = 0
                        while struct_probe < struct_names.count |struct_slot, struct_probe, self_struct, struct_names|:
                            struct_slot <- struct_probe.i64() if struct_names[struct_probe] == self_struct and struct_slot < 0
                            struct_probe <- struct_probe + 1
                        if struct_slot >= 0:
                            inv_index: mutable usize = inv_starts[struct_slot.usize()]
                            inv_end: usize = inv_index + inv_counts[struct_slot.usize()]
                            while inv_index < inv_end |restate_facts, inv_index, inv_end, all_invariants|:
                                restate_facts.push(all_invariants[inv_index])
                                inv_index <- inv_index + 1
                # A returned bare local initialised to `zeroed` (`out: T = zeroed; out.x <- v;
                # return out`) enables the field-store tier for `ensure result.FIELD == E`.
                returned_zeroed: mutable bool = false
                for local_statement in body |returned_zeroed, returned_bare_name|:
                    match local_statement:
                        Stmt.VarDecl(local_name, local_type, local_value, local_line):
                            returned_zeroed <- true if returned_bare_name != "" and local_name == returned_bare_name and ident_name_of(local_value) == "zeroed"
                        _:
                            pass
                for statement in body |table| -> table:
                    match statement:
                        Stmt.Contract(kind, expression, contract_line):
                            proven: mutable bool = ensure_is_proven(expression, requires_predicates, return_expressions, int_params, has_lo, lo, has_hi, hi, env_names, env_starts, env_counts, env_term_names, env_term_coeffs, env_consts, inl_names, inl_param_starts, inl_param_counts, all_inl_params, inl_bodies, sum_names, sum_param_starts, sum_param_counts, all_sum_params, sum_ensure_starts, sum_ensure_counts, all_sum_ensures)
                            proven <- true if returned_ref_param and es_goal_is_result_nonnull(expression)
                            proven <- true if body_pure and kind == "ensure" and es_goal_restates_requires(expression, return_expression_single, return_expressions.count == 1, restate_facts)
                            proven <- true if kind == "ensure" and es_field_store_proves(expression, returned_bare_name, returned_zeroed, body)
                            proven <- true if kind == "ensure" and es_ge_inline_proven(expression, return_expression_single, return_expressions.count == 1, inl_names, inl_param_starts, inl_param_counts, all_inl_params, inl_bodies)
                            proven <- true if kind == "ensure" and es_modular_preserve_proven(expression, return_expression_single, return_expressions.count == 1, requires_predicates, inl_names, inl_param_starts, inl_param_counts, all_inl_params, inl_bodies)
                            proven <- true if kind == "ensure" and es_product_bound_proven(expression, return_expression_single, return_expressions.count == 1, parameters, es_law_names, es_law_predicates, es_alias_names, es_alias_targets)
                            proven <- true if kind == "ensure" and ensure_align_ge(expression, return_expression_single, return_expressions.count == 1, parameters, es_law_names, es_law_predicates, es_alias_names, es_alias_targets)
                            proven <- true if kind == "ensure" and es_boollit_return_proven(expression, return_expression_single, return_expressions.count == 1, parameters, int_params, has_lo, lo, has_hi, hi)
                            proven <- true if kind == "ensure" and es_protocol_ensure_matches(expression, return_expression_single, return_expressions.count == 1, body, pe_owners, pe_spans)
                            proven <- true if kind == "ensure" and es_protocol_law_proves(expression, return_expression_single, return_expressions.count == 1, requires_predicates, law_spans)
                            proven <- false if kind == "ensure" and es_zeroed_field_conditional_unproven(expression, returned_bare_name, returned_zeroed, body)
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.EnsureNotProven, name: function_name, line: contract_line, expected: "", actual: ""}) if kind == "ensure" and not proven
                        _:
                            pass

        # PURE single-return callees (inline tier) and callee ENSURE summaries.
        def ensure_collect_callee_tables(declarations: darray[Ast::Decl], inl_names: mutable darray[sview]&, inl_param_starts: mutable darray[usize]&, inl_param_counts: mutable darray[usize]&, all_inl_params: mutable darray[sview]&, inl_bodies: mutable darray[Ast::Expr]&, sum_names: mutable darray[sview]&, sum_param_starts: mutable darray[usize]&, sum_param_counts: mutable darray[usize]&, all_sum_params: mutable darray[sview]&, sum_ensure_starts: mutable darray[usize]&, sum_ensure_counts: mutable darray[usize]&, all_sum_ensures: mutable darray[Ast::Expr]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |inl_names, inl_param_starts, inl_param_counts, all_inl_params, inl_bodies, sum_names, sum_param_starts, sum_param_counts, all_sum_params, sum_ensure_starts, sum_ensure_counts, all_sum_ensures|:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            # Inline candidates: contracts + exactly one Return, nothing else.
                            single_return: mutable Ast::Expr = Ast::Expr.Absent
                            return_count: mutable usize = 0
                            other_count: mutable usize = 0
                            ensure_count: mutable usize = 0
                            for statement in body |single_return, return_count, other_count, ensure_count, all_sum_ensures|:
                                match statement:
                                    Stmt.Return(value, return_line):
                                        return_count <- return_count + 1
                                        single_return <- returned if value is returned
                                    Stmt.Contract(kind, expression, contract_line):
                                        if kind == "ensure":
                                            ensure_count <- ensure_count + 1
                                            all_sum_ensures.push(expression)
                                    _:
                                        other_count <- other_count + 1
                            if ensure_count > 0:
                                sum_names.push(function_name)
                                sum_param_starts.push(all_sum_params.count)
                                sum_param_counts.push(parameters.count)
                                for parameter in parameters |all_sum_params|:
                                    all_sum_params.push(parameter.name)
                                sum_ensure_starts.push(all_sum_ensures.count - ensure_count)
                                sum_ensure_counts.push(ensure_count)
                            if return_count == 1 and other_count == 0:
                                inl_names.push(function_name)
                                inl_param_starts.push(all_inl_params.count)
                                inl_param_counts.push(parameters.count)
                                for parameter in parameters |all_inl_params|:
                                    all_inl_params.push(parameter.name)
                                inl_bodies.push(single_return)
                        Decl.Module(module_name, module_body, module_line):
                            ensure_collect_callee_tables(module_body, inl_names, inl_param_starts, inl_param_counts, all_inl_params, inl_bodies, sum_names, sum_param_starts, sum_param_counts, all_sum_params, sum_ensure_starts, sum_ensure_counts, all_sum_ensures)
                        Decl.Scoped(scoped_body, scoped_line):
                            ensure_collect_callee_tables(scoped_body, inl_names, inl_param_starts, inl_param_counts, all_inl_params, inl_bodies, sum_names, sum_param_starts, sum_param_counts, all_sum_params, sum_ensure_starts, sum_ensure_counts, all_sum_ensures)
                        _:
                            pass


        # Struct DESIGN-BY-CONTRACT invariants, flattened per struct name. A `self: T&`
        # parameter carries T's invariants as entry facts (the caller upholds them), so a
        # goal restating one is discharged — `ensure result == self.model` on
        # `return self.concrete` with `invariant self.concrete == self.model`.
        def es_collect_struct_invariants(declarations: darray[Ast::Decl], struct_names: mutable darray[sview]&, inv_starts: mutable darray[usize]&, inv_counts: mutable darray[usize]&, all_invariants: mutable darray[Ast::Expr]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |struct_names, inv_starts, inv_counts, all_invariants|:
                    match declaration:
                        Decl.Struct(struct_name, members, affinity, has_named_states, has_derive, invariants, struct_line):
                            if invariants.count > 0:
                                struct_names.push(struct_name)
                                inv_starts.push(all_invariants.count)
                                inv_counts.push(invariants.count)
                                all_invariants.extend(invariants)
                        Decl.Module(module_name, module_body, module_line):
                            es_collect_struct_invariants(module_body, struct_names, inv_starts, inv_counts, all_invariants)
                        Decl.Scoped(scoped_body, scoped_line):
                            es_collect_struct_invariants(scoped_body, struct_names, inv_starts, inv_counts, all_invariants)
                        _:
                            pass

        # Functions whose declared return type is a range-shaped refinement `T is Law[lo, hi]`:
        # a local bound to such a call inherits [lo, hi] as an interval fact.
        def es_collect_fn_return_bounds(declarations: darray[Ast::Decl], law_names: darray[sview]&, law_predicates: darray[Ast::Expr]&, fn_names: mutable darray[sview]&, fn_lo: mutable darray[i64]&, fn_hi: mutable darray[i64]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |fn_names, fn_lo, fn_hi, law_names, law_predicates|:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            if return_type is present_return_type:
                                bounds: (found: bool, lo: i64, hi: i64) = return_refinement_bounds(present_return_type, law_names, law_predicates)
                                if bounds.found:
                                    fn_names.push(function_name)
                                    fn_lo.push(bounds.lo)
                                    fn_hi.push(bounds.hi)
                        Decl.Module(module_name, module_body, module_line):
                            es_collect_fn_return_bounds(module_body, law_names, law_predicates, fn_names, fn_lo, fn_hi)
                        Decl.Scoped(scoped_body, scoped_line):
                            es_collect_fn_return_bounds(scoped_body, law_names, law_predicates, fn_names, fn_lo, fn_hi)
                        _:
                            pass

        def check_ensure_strict_walk(declarations: darray[Ast::Decl], fn_bound_names: darray[sview]&, fn_bound_lo: darray[i64]&, fn_bound_hi: darray[i64]&, struct_names: darray[sview]&, inv_starts: darray[usize]&, inv_counts: darray[usize]&, all_invariants: darray[Ast::Expr]&, inl_names: darray[sview]&, inl_param_starts: darray[usize]&, inl_param_counts: darray[usize]&, all_inl_params: darray[sview]&, inl_bodies: darray[Ast::Expr]&, sum_names: darray[sview]&, sum_param_starts: darray[usize]&, sum_param_counts: darray[usize]&, all_sum_params: darray[sview]&, sum_ensure_starts: darray[usize]&, sum_ensure_counts: darray[usize]&, all_sum_ensures: darray[Ast::Expr]&, es_law_names: darray[sview]&, es_law_predicates: darray[Ast::Expr]&, es_alias_names: darray[sview]&, es_alias_targets: darray[Ast::Expr]&, pe_owners: darray[sview]&, pe_spans: darray[sview]&, law_spans: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            table <- check_ensure_strict_function(parameters, body, function_name, fn_bound_names, fn_bound_lo, fn_bound_hi, struct_names, inv_starts, inv_counts, all_invariants, inl_names, inl_param_starts, inl_param_counts, all_inl_params, inl_bodies, sum_names, sum_param_starts, sum_param_counts, all_sum_params, sum_ensure_starts, sum_ensure_counts, all_sum_ensures, es_law_names, es_law_predicates, es_alias_names, es_alias_targets, pe_owners, pe_spans, law_spans, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- check_ensure_strict_walk(module_body, fn_bound_names, fn_bound_lo, fn_bound_hi, struct_names, inv_starts, inv_counts, all_invariants, inl_names, inl_param_starts, inl_param_counts, all_inl_params, inl_bodies, sum_names, sum_param_starts, sum_param_counts, all_sum_params, sum_ensure_starts, sum_ensure_counts, all_sum_ensures, es_law_names, es_law_predicates, es_alias_names, es_alias_targets, pe_owners, pe_spans, law_spans, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- check_ensure_strict_walk(scoped_body, fn_bound_names, fn_bound_lo, fn_bound_hi, struct_names, inv_starts, inv_counts, all_invariants, inl_names, inl_param_starts, inl_param_counts, all_inl_params, inl_bodies, sum_names, sum_param_starts, sum_param_counts, all_sum_params, sum_ensure_starts, sum_ensure_counts, all_sum_ensures, es_law_names, es_law_predicates, es_alias_names, es_alias_targets, pe_owners, pe_spans, law_spans, table)
                        _:
                            pass


        def check_ensure_strict(declarations: darray[Ast::Decl], pe_owners: darray[sview]&, pe_spans: darray[sview]&, law_spans: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                struct_names: mutable darray[sview] = []
                inv_starts: mutable darray[usize] = []
                inv_counts: mutable darray[usize] = []
                all_invariants: mutable darray[Ast::Expr] = []
                es_collect_struct_invariants(declarations, struct_names, inv_starts, inv_counts, all_invariants)
                es_law_names: mutable darray[sview] = []
                es_law_predicates: mutable darray[Ast::Expr] = []
                collect_laws(declarations, es_law_names, es_law_predicates)
                fn_bound_names: mutable darray[sview] = []
                fn_bound_lo: mutable darray[i64] = []
                fn_bound_hi: mutable darray[i64] = []
                es_collect_fn_return_bounds(declarations, es_law_names, es_law_predicates, fn_bound_names, fn_bound_lo, fn_bound_hi)
                inl_names: mutable darray[sview] = []
                inl_param_starts: mutable darray[usize] = []
                inl_param_counts: mutable darray[usize] = []
                all_inl_params: mutable darray[sview] = []
                inl_bodies: mutable darray[Ast::Expr] = []
                sum_names: mutable darray[sview] = []
                sum_param_starts: mutable darray[usize] = []
                sum_param_counts: mutable darray[usize] = []
                all_sum_params: mutable darray[sview] = []
                sum_ensure_starts: mutable darray[usize] = []
                sum_ensure_counts: mutable darray[usize] = []
                all_sum_ensures: mutable darray[Ast::Expr] = []
                ensure_collect_callee_tables(declarations, inl_names, inl_param_starts, inl_param_counts, all_inl_params, inl_bodies, sum_names, sum_param_starts, sum_param_counts, all_sum_params, sum_ensure_starts, sum_ensure_counts, all_sum_ensures)
                es_alias_names: mutable darray[sview] = []
                es_alias_targets: mutable darray[Ast::Expr] = []
                rau_collect_alias_targets(declarations, es_alias_names, es_alias_targets)
                table <- check_ensure_strict_walk(declarations, fn_bound_names, fn_bound_lo, fn_bound_hi, struct_names, inv_starts, inv_counts, all_invariants, inl_names, inl_param_starts, inl_param_counts, all_inl_params, inl_bodies, sum_names, sum_param_starts, sum_param_counts, all_sum_params, sum_ensure_starts, sum_ensure_counts, all_sum_ensures, es_law_names, es_law_predicates, es_alias_names, es_alias_targets, pe_owners, pe_spans, law_spans, table)
