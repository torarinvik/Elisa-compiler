# Strict-proofs (`-strict` / EnforceStrictProofs) ensure-postcondition obligation.
# Stage0's prover discharges each `ensure P` under strict mode and emits when it CANNOT
# prove P holds on all return paths. Stage1 has no arithmetic prover, so it mirrors the
# DECISION conservatively: an ensure is treated as proven only when it is decidably true
# by cheap structural reasoning — a reflexive/identity comparison (after substituting the
# single return expression for `result`), or a verbatim restatement of a `requires`
# clause. Every other ensure is reported "could not be proven", matching stage0's default
# outcome on the non-trivial arithmetic goals that dominate the corpus. Runs ONLY under
# strict proofs (the diagnostic is strict-gated in stage0 too); refutation of provably
# FALSE ensures stays with check_contract_result_void (which also runs in default mode).
extend Semantic:
    private:
        # Whether EXPRESSION is the integer literal VALUE.
        def int_literal_is(expression: Ast::Expr, value: i64) -> bool:
            can Abort.Panic:
                return match expression:
                    Expr.IntLit(literal_value): literal_value == value
                    _: false

        # Peel the arithmetic-identity wrappers a structural prover can see — `X + 0`,
        # `0 + X`, `X - 0`, `X * 1`, `1 * X` → X — returning the meaningful sub-node.
        # Also unwraps Paren. Returns an EXISTING node (no allocation): the prover stays
        # region-agnostic. Applied at the top only; the recursive comparator re-applies it
        # at each level.
        def strip_identity_top(expression: Ast::Expr) -> Ast::Expr:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Paren(inner, line):
                        return strip_identity_top(inner)
                    Expr.Binary(left, operator, right, line):
                        strip_identity_top(left) return if operator == TokenKind.Plus and int_literal_is(right, 0)
                        strip_identity_top(right) return if operator == TokenKind.Plus and int_literal_is(left, 0)
                        strip_identity_top(left) return if operator == TokenKind.Minus and int_literal_is(right, 0)
                        strip_identity_top(left) return if operator == TokenKind.Star and int_literal_is(right, 1)
                        strip_identity_top(right) return if operator == TokenKind.Star and int_literal_is(left, 1)
                        return expression
                    _:
                        return expression

        # Map a bare `result` to the single return expression (has_return); other nodes are
        # returned unchanged. Existing node, no allocation.
        def resolve_result(expression: Ast::Expr, return_expression: Ast::Expr, has_return: bool) -> Ast::Expr:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Ident(name, line):
                        return_expression return if has_return and name == "result"
                        return expression
                    _:
                        return expression

        # Structural equality of two ensure-goal sub-expressions AFTER resolving `result`
        # to the return value and folding arithmetic identities at every level — all without
        # allocating (each step returns an existing node). Enough to prove reflexive goals
        # like `result == a + b` given `return a + b`, or `x + 0 == x`.
        def equal_normalized(a: Ast::Expr, b: Ast::Expr, return_expression: Ast::Expr, has_return: bool) -> bool:
            can Memory.Allocate, Abort.Panic:
                a_normalized: Ast::Expr = strip_identity_top(resolve_result(strip_identity_top(a), return_expression, has_return))
                b_normalized: Ast::Expr = strip_identity_top(resolve_result(strip_identity_top(b), return_expression, has_return))
                match a_normalized:
                    Expr.Ident(a_name, a_line):
                        return match b_normalized:
                            Expr.Ident(b_name, b_line): a_name == b_name
                            _: false
                    Expr.IntLit(a_value):
                        return match b_normalized:
                            Expr.IntLit(b_value): a_value == b_value
                            _: false
                    Expr.Binary(a_left, a_operator, a_right, a_line):
                        return match b_normalized:
                            Expr.Binary(b_left, b_operator, b_right, b_line): a_operator == b_operator and equal_normalized(a_left, b_left, return_expression, has_return) and equal_normalized(a_right, b_right, return_expression, has_return)
                            _: false
                    Expr.Unary(a_operator, a_operand, a_line):
                        return match b_normalized:
                            Expr.Unary(b_operator, b_operand, b_line): a_operator == b_operator and equal_normalized(a_operand, b_operand, return_expression, has_return)
                            _: false
                    Expr.Field(a_object, a_field, a_line):
                        return match b_normalized:
                            Expr.Field(b_object, b_field, b_line): a_field == b_field and equal_normalized(a_object, b_object, return_expression, has_return)
                            _: false
                    _:
                        return false

        # --- Linear tier -------------------------------------------------------------
        # stage0 discharges the corpus's simple contract goals through its prover ladder
        # (interval facts, then SMT): `requires x > 0; ensure result > 0; return x + 1`
        # is accepted silently. The tier below is a faithful port of the decidable core:
        # normalize the goal to a LINEAR form D = Σ cᵢ·vᵢ + k over INTEGER parameters,
        # bound each vᵢ from `requires` clauses and `where` refinements, and decide the
        # comparison from D's extreme values over that box. Integer-only on purpose —
        # `x > 0` implies `x >= 1` for ints, which is what makes strict bounds exact.

        # Accumulate SIGN * EXPRESSION into a linear form held as parallel name/coeff
        # arrays plus a constant. `result` resolves through the single return expression.
        # Returns false when any sub-term is not affine (a call, a float, a field, ...).
        def lin_add(expression: Ast::Expr, sign: i64, names: mutable darray[sview]&, coeffs: mutable darray[i64]&, konst: mutable i64&, return_expression: Ast::Expr, has_return: bool, depth: u32) -> bool:
            can Memory.Allocate, Abort.Panic:
                false return if depth > 32
                match expression:
                    Expr.IntLit(value):
                        konst <- konst + sign * value
                        return true
                    Expr.Ident(name, line):
                        # `result` stands for the return value; fold it in, but never
                        # resolve recursively (`result` cannot appear in its own body).
                        (lin_add(return_expression, sign, names, coeffs, konst, Ast::Expr.Invalid, false, depth + 1)) return if has_return and name == "result"
                        slot: mutable i64 = -1
                        probe: mutable usize = 0
                        while probe < names.count |slot, probe, name, names|:
                            slot <- probe.i64() if names[probe] == name and slot < 0
                            probe <- probe + 1
                        if slot < 0:
                            names.push(name)
                            coeffs.push(sign)
                        else:
                            coeffs[slot.usize()] <- coeffs[slot.usize()] + sign
                        return true
                    Expr.Paren(inner, line):
                        return lin_add(inner, sign, names, coeffs, konst, return_expression, has_return, depth + 1)
                    Expr.Unary(operator, operand, line):
                        (lin_add(operand, 0 - sign, names, coeffs, konst, return_expression, has_return, depth + 1)) return if operator == TokenKind.Minus
                        return false
                    Expr.Binary(left, operator, right, line):
                        if operator == TokenKind.Plus:
                            false return if not lin_add(left, sign, names, coeffs, konst, return_expression, has_return, depth + 1)
                            return lin_add(right, sign, names, coeffs, konst, return_expression, has_return, depth + 1)
                        if operator == TokenKind.Minus:
                            false return if not lin_add(left, sign, names, coeffs, konst, return_expression, has_return, depth + 1)
                            return lin_add(right, 0 - sign, names, coeffs, konst, return_expression, has_return, depth + 1)
                        if operator == TokenKind.Star:
                            # Affine only: one factor must be a literal.
                            match left:
                                Expr.IntLit(left_value):
                                    return lin_add(right, sign * left_value, names, coeffs, konst, return_expression, has_return, depth + 1)
                                _:
                                    pass
                            match right:
                                Expr.IntLit(right_value):
                                    return lin_add(left, sign * right_value, names, coeffs, konst, return_expression, has_return, depth + 1)
                                _:
                                    pass
                            return false
                        return false
                    _:
                        return false


        # Update the bound rows for VARIABLE from `VARIABLE op VALUE` (mirrored when the
        # variable is on the right). Bounds are parallel to `int_params`.
        def lin_apply_bound(variable: sview, operator: TokenKind, value: i64, flipped: bool, int_params: darray[sview]&, has_lo: mutable darray[bool]&, lo: mutable darray[i64]&, has_hi: mutable darray[bool]&, hi: mutable darray[i64]&) -> void:
            can Memory.Allocate, Abort.Panic:
                slot: mutable i64 = -1
                probe: mutable usize = 0
                while probe < int_params.count |slot, probe, variable, int_params|:
                    slot <- probe.i64() if int_params[probe] == variable and slot < 0
                    probe <- probe + 1
                return if slot < 0
                index: usize = slot.usize()
                # Normalize a flipped comparison (`VALUE op VARIABLE`) to variable-first.
                effective: TokenKind = operator if not flipped else (TokenKind.Lt if operator == TokenKind.Gt else (TokenKind.LtEq if operator == TokenKind.GtEq else (TokenKind.Gt if operator == TokenKind.Lt else (TokenKind.GtEq if operator == TokenKind.LtEq else operator))))
                new_lo: mutable i64 = 0
                new_hi: mutable i64 = 0
                sets_lo: mutable bool = false
                sets_hi: mutable bool = false
                if effective == TokenKind.Gt:
                    new_lo <- value + 1
                    sets_lo <- true
                if effective == TokenKind.GtEq:
                    new_lo <- value
                    sets_lo <- true
                if effective == TokenKind.Lt:
                    new_hi <- value - 1
                    sets_hi <- true
                if effective == TokenKind.LtEq:
                    new_hi <- value
                    sets_hi <- true
                if effective == TokenKind.EqEq:
                    new_lo <- value
                    new_hi <- value
                    sets_lo <- true
                    sets_hi <- true
                if sets_lo and ((not has_lo[index]) or new_lo > lo[index]):
                    has_lo[index] <- true
                    lo[index] <- new_lo
                if sets_hi and ((not has_hi[index]) or new_hi < hi[index]):
                    has_hi[index] <- true
                    hi[index] <- new_hi


        # Fold FACT (splitting `and` conjunctions) into the per-parameter bounds.
        def lin_collect_fact(fact: Ast::Expr, int_params: darray[sview]&, has_lo: mutable darray[bool]&, lo: mutable darray[i64]&, has_hi: mutable darray[bool]&, hi: mutable darray[i64]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match fact:
                    Expr.Paren(inner, line):
                        lin_collect_fact(inner, int_params, has_lo, lo, has_hi, hi)
                    Expr.Binary(left, operator, right, line):
                        if operator == TokenKind.And:
                            lin_collect_fact(left, int_params, has_lo, lo, has_hi, hi)
                            lin_collect_fact(right, int_params, has_lo, lo, has_hi, hi)
                            return
                        return if not is_comparison_operator(operator)
                        left_name: sview = ident_name_of(left)
                        right_name: sview = ident_name_of(right)
                        left_const: (found: bool, value: i64) = fold_const_int(left)
                        right_const: (found: bool, value: i64) = fold_const_int(right)
                        lin_apply_bound(left_name, operator, right_const.value, false, int_params, has_lo, lo, has_hi, hi) if left_name != "" and right_const.found
                        lin_apply_bound(right_name, operator, left_const.value, true, int_params, has_lo, lo, has_hi, hi) if right_name != "" and left_const.found
                    _:
                        pass


        # Whether an expression performs arithmetic (any op node under the Parens) — the
        # trigger for the overflow guard below.
        def lin_has_arithmetic(expression: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Paren(inner, line):
                        return lin_has_arithmetic(inner)
                    Expr.Binary(left, operator, right, line):
                        return true
                    Expr.Unary(operator, operand, line):
                        return true
                    _:
                        return false


        # Decide `GOAL_LEFT op GOAL_RIGHT` by bounding D = lin(left) - lin(right) over the
        # parameter box. Every variable D touches must be a bounded-as-needed INT param.
        #
        # OVERFLOW GUARD (pinned against stage0's bitvector-aware prover): when the return
        # value itself is an ARITHMETIC expression, `requires a > 0; ensure result > 0;
        # return a + b` is REJECTED — the sum may wrap — unless every variable in the
        # return expression is bounded on BOTH sides, which is what rules the wrap out
        # (`x < 100; return x + 1` cannot overflow). A bare `return n` does no arithmetic
        # and needs no such box.
        def linear_goal_is_proven(goal_left: Ast::Expr, operator: TokenKind, goal_right: Ast::Expr, return_expression: Ast::Expr, has_return: bool, int_params: darray[sview]&, has_lo: darray[bool]&, lo: darray[i64]&, has_hi: darray[bool]&, hi: darray[i64]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                if has_return and lin_has_arithmetic(return_expression):
                    return_names: mutable darray[sview] = []
                    return_coeffs: mutable darray[i64] = []
                    return_konst: mutable i64 = 0
                    false return if not lin_add(return_expression, 1, return_names, return_coeffs, return_konst, Ast::Expr.Invalid, false, 0)
                    fully_boxed: mutable bool = true
                    box_probe: mutable usize = 0
                    while box_probe < return_names.count |fully_boxed, box_probe, return_names, return_coeffs, int_params, has_lo, has_hi|:
                        if return_coeffs[box_probe] != 0:
                            slot: mutable i64 = -1
                            param_probe: mutable usize = 0
                            while param_probe < int_params.count |slot, param_probe, box_probe, return_names, int_params|:
                                slot <- param_probe.i64() if int_params[param_probe] == return_names[box_probe] and slot < 0
                                param_probe <- param_probe + 1
                            fully_boxed <- false if slot < 0
                            fully_boxed <- false if slot >= 0 and not (has_lo[slot.usize()] and has_hi[slot.usize()])
                        box_probe <- box_probe + 1
                    false return if not fully_boxed
                names: mutable darray[sview] = []
                coeffs: mutable darray[i64] = []
                konst: mutable i64 = 0
                false return if not lin_add(goal_left, 1, names, coeffs, konst, return_expression, has_return, 0)
                false return if not lin_add(goal_right, -1, names, coeffs, konst, return_expression, has_return, 0)
                # D's extremes over the box; any needed-but-missing bound kills that side.
                min_value: mutable i64 = konst
                max_value: mutable i64 = konst
                min_known: mutable bool = true
                max_known: mutable bool = true
                term: mutable usize = 0
                while term < names.count |min_value, max_value, min_known, max_known, term, names, coeffs, int_params, has_lo, lo, has_hi, hi|:
                    coefficient: i64 = coeffs[term]
                    if coefficient != 0:
                        slot: mutable i64 = -1
                        probe: mutable usize = 0
                        while probe < int_params.count |slot, probe, term, names, int_params|:
                            slot <- probe.i64() if int_params[probe] == names[term] and slot < 0
                            probe <- probe + 1
                        if slot < 0:
                            # Not a known integer parameter: nothing sound to say.
                            min_known <- false
                            max_known <- false
                        else:
                            index: usize = slot.usize()
                            # A positive coefficient takes its min from lo and max from hi;
                            # a negative one swaps them.
                            min_uses_lo: bool = coefficient > 0
                            min_bound_known: bool = has_lo[index] if min_uses_lo else has_hi[index]
                            max_bound_known: bool = has_hi[index] if min_uses_lo else has_lo[index]
                            min_bound: i64 = (lo[index] if min_uses_lo else hi[index]) if min_bound_known else 0
                            max_bound: i64 = (hi[index] if min_uses_lo else lo[index]) if max_bound_known else 0
                            min_value <- min_value + coefficient * min_bound if min_bound_known
                            min_known <- false if not min_bound_known
                            max_value <- max_value + coefficient * max_bound if max_bound_known
                            max_known <- false if not max_bound_known
                    term <- term + 1
                (min_known and min_value >= 1) return if operator == TokenKind.Gt
                (min_known and min_value >= 0) return if operator == TokenKind.GtEq
                (max_known and max_value <= (0 - 1)) return if operator == TokenKind.Lt
                (max_known and max_value <= 0) return if operator == TokenKind.LtEq
                (min_known and max_known and min_value == 0 and max_value == 0) return if operator == TokenKind.EqEq
                ((min_known and min_value >= 1) or (max_known and max_value <= (0 - 1))) return if operator == TokenKind.BangEq
                return false


        # --- Deep tier: local dataflow + pure-callee inlining ---------------------------
        # lin_add extended with (a) an ENVIRONMENT mapping straight-line LOCALS to affine
        # forms over the parameters (`y = x; y <- y - 1; return y`), and (b) INLINING of
        # pure single-return callees (`return dbl(n)` with `def dbl(x) = return x + x`).
        # Kept separate from lin_add so the shallow provers (assert-by, decreases, hof)
        # keep their exact behavior.
        def lin_add_deep(expression: Ast::Expr, sign: i64, names: mutable darray[sview]&, coeffs: mutable darray[i64]&, konst: mutable i64&, return_expression: Ast::Expr, has_return: bool, depth: u32, env_names: darray[sview]&, env_starts: darray[usize]&, env_counts: darray[usize]&, env_term_names: darray[sview]&, env_term_coeffs: darray[i64]&, env_consts: darray[i64]&, inl_names: darray[sview]&, inl_param_starts: darray[usize]&, inl_param_counts: darray[usize]&, all_inl_params: darray[sview]&, inl_bodies: darray[Ast::Expr]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                false return if depth > 16
                match expression:
                    Expr.IntLit(value):
                        konst <- konst + sign * value
                        return true
                    Expr.Ident(name, line):
                        (lin_add_deep(return_expression, sign, names, coeffs, konst, Ast::Expr.Invalid, false, depth + 1, env_names, env_starts, env_counts, env_term_names, env_term_coeffs, env_consts, inl_names, inl_param_starts, inl_param_counts, all_inl_params, inl_bodies)) return if has_return and name == "result"
                        # A LOCAL with a known affine form expands to it (param space).
                        env_slot: mutable i64 = -1
                        env_probe: mutable usize = 0
                        while env_probe < env_names.count |env_slot, env_probe, name, env_names|:
                            env_slot <- env_probe.i64() if env_names[env_probe] == name and env_slot < 0
                            env_probe <- env_probe + 1
                        if env_slot >= 0:
                            env_index: usize = env_slot.usize()
                            konst <- konst + sign * env_consts[env_index]
                            term_offset: mutable usize = 0
                            while term_offset < env_counts[env_index] |term_offset, konst, names, coeffs, env_index, sign|:
                                term_name: sview = env_term_names[env_starts[env_index] + term_offset]
                                term_coeff: i64 = env_term_coeffs[env_starts[env_index] + term_offset]
                                slot2: mutable i64 = -1
                                probe2: mutable usize = 0
                                while probe2 < names.count |slot2, probe2, term_name, names|:
                                    slot2 <- probe2.i64() if names[probe2] == term_name and slot2 < 0
                                    probe2 <- probe2 + 1
                                if slot2 < 0:
                                    names.push(term_name)
                                    coeffs.push(sign * term_coeff)
                                else:
                                    coeffs[slot2.usize()] <- coeffs[slot2.usize()] + sign * term_coeff
                                term_offset <- term_offset + 1
                            return true
                        slot: mutable i64 = -1
                        probe: mutable usize = 0
                        while probe < names.count |slot, probe, name, names|:
                            slot <- probe.i64() if names[probe] == name and slot < 0
                            probe <- probe + 1
                        if slot < 0:
                            names.push(name)
                            coeffs.push(sign)
                        else:
                            coeffs[slot.usize()] <- coeffs[slot.usize()] + sign
                        return true
                    Expr.Paren(inner, line):
                        return lin_add_deep(inner, sign, names, coeffs, konst, return_expression, has_return, depth + 1, env_names, env_starts, env_counts, env_term_names, env_term_coeffs, env_consts, inl_names, inl_param_starts, inl_param_counts, all_inl_params, inl_bodies)
                    Expr.Unary(operator, operand, line):
                        (lin_add_deep(operand, 0 - sign, names, coeffs, konst, return_expression, has_return, depth + 1, env_names, env_starts, env_counts, env_term_names, env_term_coeffs, env_consts, inl_names, inl_param_starts, inl_param_counts, all_inl_params, inl_bodies)) return if operator == TokenKind.Minus
                        return false
                    Expr.Binary(left, operator, right, line):
                        if operator == TokenKind.Plus:
                            false return if not lin_add_deep(left, sign, names, coeffs, konst, return_expression, has_return, depth + 1, env_names, env_starts, env_counts, env_term_names, env_term_coeffs, env_consts, inl_names, inl_param_starts, inl_param_counts, all_inl_params, inl_bodies)
                            return lin_add_deep(right, sign, names, coeffs, konst, return_expression, has_return, depth + 1, env_names, env_starts, env_counts, env_term_names, env_term_coeffs, env_consts, inl_names, inl_param_starts, inl_param_counts, all_inl_params, inl_bodies)
                        if operator == TokenKind.Minus:
                            false return if not lin_add_deep(left, sign, names, coeffs, konst, return_expression, has_return, depth + 1, env_names, env_starts, env_counts, env_term_names, env_term_coeffs, env_consts, inl_names, inl_param_starts, inl_param_counts, all_inl_params, inl_bodies)
                            return lin_add_deep(right, 0 - sign, names, coeffs, konst, return_expression, has_return, depth + 1, env_names, env_starts, env_counts, env_term_names, env_term_coeffs, env_consts, inl_names, inl_param_starts, inl_param_counts, all_inl_params, inl_bodies)
                        if operator == TokenKind.Star:
                            match left:
                                Expr.IntLit(left_value):
                                    return lin_add_deep(right, sign * left_value, names, coeffs, konst, return_expression, has_return, depth + 1, env_names, env_starts, env_counts, env_term_names, env_term_coeffs, env_consts, inl_names, inl_param_starts, inl_param_counts, all_inl_params, inl_bodies)
                                _:
                                    pass
                            match right:
                                Expr.IntLit(right_value):
                                    return lin_add_deep(left, sign * right_value, names, coeffs, konst, return_expression, has_return, depth + 1, env_names, env_starts, env_counts, env_term_names, env_term_coeffs, env_consts, inl_names, inl_param_starts, inl_param_counts, all_inl_params, inl_bodies)
                                _:
                                    pass
                            return false
                        return false
                    Expr.Call(callee, arguments, argument_names, line):
                        # NUMERIC CASTS are OPAQUE here: `x.u64().i64()` is not provably
                        # the identity (stage0 rejects `ensure result == x` on it).
                        false return if call_is_numeric_cast(callee, arguments)
                        # INLINE a pure single-return callee: evaluate each argument to an
                        # affine form in the CALLER's space, bind it as the callee param's
                        # environment, then fold the callee's return expression.
                        called: sview = ident_name_of(callee)
                        false return if called == ""
                        inl_slot: mutable i64 = -1
                        inl_probe: mutable usize = 0
                        while inl_probe < inl_names.count |inl_slot, inl_probe, called, inl_names|:
                            inl_slot <- inl_probe.i64() if inl_names[inl_probe] == called and inl_slot < 0
                            inl_probe <- inl_probe + 1
                        false return if inl_slot < 0
                        inl_index: usize = inl_slot.usize()
                        false return if inl_param_counts[inl_index] != arguments.count
                        callee_env_names: mutable darray[sview] = []
                        callee_env_starts: mutable darray[usize] = []
                        callee_env_counts: mutable darray[usize] = []
                        callee_term_names: mutable darray[sview] = []
                        callee_term_coeffs: mutable darray[i64] = []
                        callee_env_consts: mutable darray[i64] = []
                        arg_offset: mutable usize = 0
                        args_ok: mutable bool = true
                        while arg_offset < arguments.count |arg_offset, args_ok, callee_env_names, callee_env_starts, callee_env_counts, callee_term_names, callee_term_coeffs, callee_env_consts, arguments, inl_index, depth|:
                            arg_names: mutable darray[sview] = []
                            arg_coeffs: mutable darray[i64] = []
                            arg_konst: mutable i64 = 0
                            arg_linear: bool = lin_add_deep(arguments[arg_offset], 1, arg_names, arg_coeffs, arg_konst, Ast::Expr.Invalid, false, depth + 1, env_names, env_starts, env_counts, env_term_names, env_term_coeffs, env_consts, inl_names, inl_param_starts, inl_param_counts, all_inl_params, inl_bodies)
                            args_ok <- false if not arg_linear
                            callee_env_names.push(all_inl_params[inl_param_starts[inl_index] + arg_offset])
                            callee_env_starts.push(callee_term_names.count)
                            callee_env_counts.push(arg_names.count)
                            callee_term_names.extend(arg_names)
                            callee_term_coeffs.extend(arg_coeffs)
                            callee_env_consts.push(arg_konst)
                            arg_offset <- arg_offset + 1
                        false return if not args_ok
                        return lin_add_deep(inl_bodies[inl_index], sign, names, coeffs, konst, Ast::Expr.Invalid, false, depth + 1, callee_env_names, callee_env_starts, callee_env_counts, callee_term_names, callee_term_coeffs, callee_env_consts, inl_names, inl_param_starts, inl_param_counts, all_inl_params, inl_bodies)
                    _:
                        return false


        # linear_goal_is_proven with the DEEP adder (env + inlining). Same box logic.
        def linear_goal_deep_proven(goal_left: Ast::Expr, operator: TokenKind, goal_right: Ast::Expr, return_expression: Ast::Expr, has_return: bool, int_params: darray[sview]&, has_lo: darray[bool]&, lo: darray[i64]&, has_hi: darray[bool]&, hi: darray[i64]&, env_names: darray[sview]&, env_starts: darray[usize]&, env_counts: darray[usize]&, env_term_names: darray[sview]&, env_term_coeffs: darray[i64]&, env_consts: darray[i64]&, inl_names: darray[sview]&, inl_param_starts: darray[usize]&, inl_param_counts: darray[usize]&, all_inl_params: darray[sview]&, inl_bodies: darray[Ast::Expr]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                if has_return and lin_has_arithmetic(return_expression):
                    return_names: mutable darray[sview] = []
                    return_coeffs: mutable darray[i64] = []
                    return_konst: mutable i64 = 0
                    false return if not lin_add_deep(return_expression, 1, return_names, return_coeffs, return_konst, Ast::Expr.Invalid, false, 0, env_names, env_starts, env_counts, env_term_names, env_term_coeffs, env_consts, inl_names, inl_param_starts, inl_param_counts, all_inl_params, inl_bodies)
                    fully_boxed: mutable bool = true
                    box_probe: mutable usize = 0
                    while box_probe < return_names.count |fully_boxed, box_probe, return_names, return_coeffs, int_params, has_lo, has_hi|:
                        if return_coeffs[box_probe] != 0:
                            slot: mutable i64 = -1
                            param_probe: mutable usize = 0
                            while param_probe < int_params.count |slot, param_probe, box_probe, return_names, int_params|:
                                slot <- param_probe.i64() if int_params[param_probe] == return_names[box_probe] and slot < 0
                                param_probe <- param_probe + 1
                            fully_boxed <- false if slot < 0
                            fully_boxed <- false if slot >= 0 and not (has_lo[slot.usize()] and has_hi[slot.usize()])
                        box_probe <- box_probe + 1
                    false return if not fully_boxed
                names: mutable darray[sview] = []
                coeffs: mutable darray[i64] = []
                konst: mutable i64 = 0
                false return if not lin_add_deep(goal_left, 1, names, coeffs, konst, return_expression, has_return, 0, env_names, env_starts, env_counts, env_term_names, env_term_coeffs, env_consts, inl_names, inl_param_starts, inl_param_counts, all_inl_params, inl_bodies)
                false return if not lin_add_deep(goal_right, -1, names, coeffs, konst, return_expression, has_return, 0, env_names, env_starts, env_counts, env_term_names, env_term_coeffs, env_consts, inl_names, inl_param_starts, inl_param_counts, all_inl_params, inl_bodies)
                min_value: mutable i64 = konst
                max_value: mutable i64 = konst
                min_known: mutable bool = true
                max_known: mutable bool = true
                term: mutable usize = 0
                while term < names.count |min_value, max_value, min_known, max_known, term, names, coeffs, int_params, has_lo, lo, has_hi, hi|:
                    coefficient: i64 = coeffs[term]
                    if coefficient != 0:
                        slot: mutable i64 = -1
                        probe: mutable usize = 0
                        while probe < int_params.count |slot, probe, term, names, int_params|:
                            slot <- probe.i64() if int_params[probe] == names[term] and slot < 0
                            probe <- probe + 1
                        if slot < 0:
                            min_known <- false
                            max_known <- false
                        else:
                            index: usize = slot.usize()
                            min_uses_lo: bool = coefficient > 0
                            min_bound_known: bool = has_lo[index] if min_uses_lo else has_hi[index]
                            max_bound_known: bool = has_hi[index] if min_uses_lo else has_lo[index]
                            min_bound: i64 = (lo[index] if min_uses_lo else hi[index]) if min_bound_known else 0
                            max_bound: i64 = (hi[index] if min_uses_lo else lo[index]) if max_bound_known else 0
                            min_value <- min_value + coefficient * min_bound if min_bound_known
                            min_known <- false if not min_bound_known
                            max_value <- max_value + coefficient * max_bound if max_bound_known
                            max_known <- false if not max_bound_known
                    term <- term + 1
                (min_known and min_value >= 1) return if operator == TokenKind.Gt
                (min_known and min_value >= 0) return if operator == TokenKind.GtEq
                (max_known and max_value <= (0 - 1)) return if operator == TokenKind.Lt
                (max_known and max_value <= 0) return if operator == TokenKind.LtEq
                (min_known and max_known and min_value == 0 and max_value == 0) return if operator == TokenKind.EqEq
                ((min_known and min_value >= 1) or (max_known and max_value <= (0 - 1))) return if operator == TokenKind.BangEq
                return false


        # Whether OPERATOR is a comparison whose reflexive form (`A op A`) is TRUE.
        def is_reflexively_true_operator(operator: TokenKind) -> bool:
            can Abort.Panic:
                return operator == TokenKind.EqEq or operator == TokenKind.LtEq or operator == TokenKind.GtEq

        # `x % C` for positive literal C: result range [0, C-1] when x is non-negative
        # (unsigned, or boxed with lo >= 0). Decides `ensure result < 8` on `return n % 8`.
        def mod_goal_is_proven(return_expression: Ast::Expr, operator: TokenKind, goal_right: Ast::Expr, int_params: darray[sview]&, has_lo: darray[bool]&, lo: darray[i64]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                match return_expression:
                    Expr.Paren(inner, line):
                        return mod_goal_is_proven(inner, operator, goal_right, int_params, has_lo, lo)
                    Expr.Binary(left, mod_operator, right, line):
                        false return if mod_operator != TokenKind.Percent
                        modulus: (found: bool, value: i64) = fold_const_int(right)
                        false return if not modulus.found or modulus.value <= 0
                        # Operand must be provably non-negative.
                        operand_name: sview = ident_name_of(left)
                        false return if operand_name == ""
                        slot: mutable i64 = -1
                        probe: mutable usize = 0
                        while probe < int_params.count |slot, probe, operand_name, int_params|:
                            slot <- probe.i64() if int_params[probe] == operand_name and slot < 0
                            probe <- probe + 1
                        false return if slot < 0
                        false return if not (has_lo[slot.usize()] and lo[slot.usize()] >= 0)
                        bound: (found: bool, value: i64) = fold_const_int(goal_right)
                        false return if not bound.found
                        (modulus.value - 1 < bound.value) return if operator == TokenKind.Lt
                        (modulus.value - 1 <= bound.value) return if operator == TokenKind.LtEq
                        return false
                    _:
                        return false


        # The local a REF binding aliases (`r: mutable i64& = &y` -> "y"), or "".
        def ensure_env_alias_of(body: darray[Ast::Stmt], ref_name: sview) -> sview:
            can Memory.Allocate, Abort.Panic:
                found: mutable sview = sview("", 0, 0)
                for statement in body |found, ref_name|:
                    match statement:
                        Stmt.VarDecl(local_name, local_type, local_value, local_line):
                            continue if local_name != ref_name
                            match local_value:
                                Expr.Unary(operator, operand, unary_line):
                                    found <- ident_name_of(operand) if operator == TokenKind.Ampersand and found == ""
                                _:
                                    pass
                        _:
                            pass
                return found


        # The conservative prover: whether `ensure PREDICATE` is decidably true.
        def ensure_is_proven(predicate: Ast::Expr, requires_predicates: darray[Ast::Expr]&, return_expressions: darray[Ast::Expr]&, int_params: darray[sview]&, has_lo: darray[bool]&, lo: darray[i64]&, has_hi: darray[bool]&, hi: darray[i64]&, env_names: darray[sview]&, env_starts: darray[usize]&, env_counts: darray[usize]&, env_term_names: darray[sview]&, env_term_coeffs: darray[i64]&, env_consts: darray[i64]&, inl_names: darray[sview]&, inl_param_starts: darray[usize]&, inl_param_counts: darray[usize]&, all_inl_params: darray[sview]&, inl_bodies: darray[Ast::Expr]&, sum_names: darray[sview]&, sum_param_starts: darray[usize]&, sum_param_counts: darray[usize]&, all_sum_params: darray[sview]&, sum_ensure_starts: darray[usize]&, sum_ensure_counts: darray[usize]&, all_sum_ensures: darray[Ast::Expr]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                # A verbatim restatement of a `requires` clause is assumed.
                true return if any required in requires_predicates where expressions_equal(predicate, required)
                match predicate:
                    Expr.Binary(left, operator, right, line):
                        false return if not is_comparison_operator(operator)
                        has_return: bool = return_expressions.count == 1
                        return_expression: Ast::Expr = return_expressions[0] if has_return else (Ast::Expr.Invalid)
                        reflexive: bool = equal_normalized(left, right, return_expression, has_return)
                        true return if reflexive and is_reflexively_true_operator(operator)
                        # `return n % C` range tier (goal must be `result < bound`).
                        goal_is_result: bool = ident_name_of(left) == "result"
                        true return if has_return and goal_is_result and mod_goal_is_proven(return_expression, operator, right, int_params, has_lo, lo)
                        # The deep linear tier: env-resolved locals + pure-callee inlining.
                        true return if linear_goal_deep_proven(left, operator, right, return_expression, has_return, int_params, has_lo, lo, has_hi, hi, env_names, env_starts, env_counts, env_term_names, env_term_coeffs, env_consts, inl_names, inl_param_starts, inl_param_counts, all_inl_params, inl_bodies)
                        # CALLEE-SUMMARY route: `return f(args)` where f declares its own
                        # ensures. An EQUALITY summary `result == E` substitutes E (with
                        # f's params bound to the arguments); BOUND summaries box a
                        # synthetic variable standing for the call's value.
                        return callee_summary_proves(left, operator, right, return_expression, has_return, int_params, has_lo, lo, has_hi, hi, env_names, env_starts, env_counts, env_term_names, env_term_coeffs, env_consts, inl_names, inl_param_starts, inl_param_counts, all_inl_params, inl_bodies, sum_names, sum_param_starts, sum_param_counts, all_sum_params, sum_ensure_starts, sum_ensure_counts, all_sum_ensures)
                    _:
                        return false


        def callee_summary_proves(goal_left: Ast::Expr, operator: TokenKind, goal_right: Ast::Expr, return_expression: Ast::Expr, has_return: bool, int_params: darray[sview]&, has_lo: darray[bool]&, lo: darray[i64]&, has_hi: darray[bool]&, hi: darray[i64]&, env_names: darray[sview]&, env_starts: darray[usize]&, env_counts: darray[usize]&, env_term_names: darray[sview]&, env_term_coeffs: darray[i64]&, env_consts: darray[i64]&, inl_names: darray[sview]&, inl_param_starts: darray[usize]&, inl_param_counts: darray[usize]&, all_inl_params: darray[sview]&, inl_bodies: darray[Ast::Expr]&, sum_names: darray[sview]&, sum_param_starts: darray[usize]&, sum_param_counts: darray[usize]&, all_sum_params: darray[sview]&, sum_ensure_starts: darray[usize]&, sum_ensure_counts: darray[usize]&, all_sum_ensures: darray[Ast::Expr]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                false return if not has_return
                called: mutable sview = sview("", 0, 0)
                call_arguments: mutable darray[Ast::Expr] = []
                match return_expression:
                    Expr.Call(callee, arguments, argument_names, call_line):
                        called <- ident_name_of(callee)
                        call_arguments.extend(arguments)
                    _:
                        pass
                false return if called == ""
                slot: mutable i64 = -1
                probe: mutable usize = 0
                while probe < sum_names.count |slot, probe, called, sum_names|:
                    slot <- probe.i64() if sum_names[probe] == called and slot < 0
                    probe <- probe + 1
                false return if slot < 0
                index: usize = slot.usize()
                false return if sum_param_counts[index] != call_arguments.count
                # Bind callee params to the argument expressions as an ENVIRONMENT
                # (arguments reduced to affine caller-space forms).
                callee_env_names: mutable darray[sview] = []
                callee_env_starts: mutable darray[usize] = []
                callee_env_counts: mutable darray[usize] = []
                callee_term_names: mutable darray[sview] = []
                callee_term_coeffs: mutable darray[i64] = []
                callee_env_consts: mutable darray[i64] = []
                arg_offset: mutable usize = 0
                args_ok: mutable bool = true
                while arg_offset < call_arguments.count |arg_offset, args_ok, callee_env_names, callee_env_starts, callee_env_counts, callee_term_names, callee_term_coeffs, callee_env_consts, call_arguments, index|:
                    arg_names: mutable darray[sview] = []
                    arg_coeffs: mutable darray[i64] = []
                    arg_konst: mutable i64 = 0
                    arg_linear: bool = lin_add_deep(call_arguments[arg_offset], 1, arg_names, arg_coeffs, arg_konst, Ast::Expr.Invalid, false, 0, env_names, env_starts, env_counts, env_term_names, env_term_coeffs, env_consts, inl_names, inl_param_starts, inl_param_counts, all_inl_params, inl_bodies)
                    args_ok <- false if not arg_linear
                    callee_env_names.push(all_sum_params[sum_param_starts[index] + arg_offset])
                    callee_env_starts.push(callee_term_names.count)
                    callee_env_counts.push(arg_names.count)
                    callee_term_names.extend(arg_names)
                    callee_term_coeffs.extend(arg_coeffs)
                    callee_env_consts.push(arg_konst)
                    arg_offset <- arg_offset + 1
                # EQUALITY summary: `ensure result == E` — E (env-bound) becomes the
                # return expression.
                ensure_offset: mutable usize = 0
                while ensure_offset < sum_ensure_counts[index] |ensure_offset, index, args_ok, callee_env_names, callee_env_starts, callee_env_counts, callee_term_names, callee_term_coeffs, callee_env_consts, goal_left, operator, goal_right, int_params, has_lo, lo, has_hi, hi, inl_names, inl_param_starts, inl_param_counts, all_inl_params, inl_bodies|:
                    summary: Ast::Expr = all_sum_ensures[sum_ensure_starts[index] + ensure_offset]
                    match summary:
                        Expr.Binary(sum_left, sum_operator, sum_right, sum_line):
                            equality: bool = args_ok and sum_operator == TokenKind.EqEq and ident_name_of(sum_left) == "result"
                            true return if equality and linear_goal_deep_proven(goal_left, operator, goal_right, sum_right, true, int_params, has_lo, lo, has_hi, hi, callee_env_names, callee_env_starts, callee_env_counts, callee_term_names, callee_term_coeffs, callee_env_consts, inl_names, inl_param_starts, inl_param_counts, all_inl_params, inl_bodies)
                        _:
                            pass
                    ensure_offset <- ensure_offset + 1
                # BOUND summaries: box a synthetic variable named after the callee, then
                # judge the goal with `result` standing for that variable.
                boxed_params: mutable darray[sview] = []
                boxed_has_lo: mutable darray[bool] = []
                boxed_lo: mutable darray[i64] = []
                boxed_has_hi: mutable darray[bool] = []
                boxed_hi: mutable darray[i64] = []
                for existing in int_params |boxed_params|:
                    boxed_params.push(existing)
                box_probe: mutable usize = 0
                while box_probe < int_params.count |box_probe, boxed_has_lo, boxed_lo, boxed_has_hi, boxed_hi, has_lo, lo, has_hi, hi|:
                    boxed_has_lo.push(has_lo[box_probe])
                    boxed_lo.push(lo[box_probe])
                    boxed_has_hi.push(has_hi[box_probe])
                    boxed_hi.push(hi[box_probe])
                    box_probe <- box_probe + 1
                boxed_params.push(called)
                boxed_has_lo.push(false)
                boxed_lo.push(0)
                boxed_has_hi.push(false)
                boxed_hi.push(0)
                found_bound: mutable bool = false
                bound_offset: mutable usize = 0
                while bound_offset < sum_ensure_counts[index] |bound_offset, found_bound, index, called, boxed_params, boxed_has_lo, boxed_lo, boxed_has_hi, boxed_hi|:
                    summary2: Ast::Expr = all_sum_ensures[sum_ensure_starts[index] + bound_offset]
                    match summary2:
                        Expr.Binary(sum_left2, sum_operator2, sum_right2, sum_line2):
                            bound_const: (found: bool, value: i64) = fold_const_int(sum_right2)
                            usable: bool = ident_name_of(sum_left2) == "result" and bound_const.found and is_comparison_operator(sum_operator2)
                            if usable:
                                lin_apply_bound(called, sum_operator2, bound_const.value, false, boxed_params, boxed_has_lo, boxed_lo, boxed_has_hi, boxed_hi)
                                found_bound <- true
                        _:
                            pass
                    bound_offset <- bound_offset + 1
                false return if not found_bound
                synthetic: Ast::Expr = (Ast::Expr.Ident(called, 0))
                empty_env_names: darray[sview] = []
                empty_env_starts: darray[usize] = []
                empty_env_counts: darray[usize] = []
                empty_term_names: darray[sview] = []
                empty_term_coeffs: darray[i64] = []
                empty_env_consts: darray[i64] = []
                return linear_goal_deep_proven(goal_left, operator, goal_right, synthetic, true, boxed_params, boxed_has_lo, boxed_lo, boxed_has_hi, boxed_hi, empty_env_names, empty_env_starts, empty_env_counts, empty_term_names, empty_term_coeffs, empty_env_consts, inl_names, inl_param_starts, inl_param_counts, all_inl_params, inl_bodies)

        # Whether OPERATOR is any comparison (the ensure goal shapes the prover judges).
        def is_comparison_operator(operator: TokenKind) -> bool:
            can Abort.Panic:
                return operator == TokenKind.EqEq or operator == TokenKind.BangEq or operator == TokenKind.Lt or operator == TokenKind.Gt or operator == TokenKind.LtEq or operator == TokenKind.GtEq

        # Whether an expression is a conditional (ternary `A if C else B`) — a value the
        # reflexive prover cannot substitute soundly, since the result depends on the branch.
        def is_conditional_expression(expression: Ast::Expr) -> bool:
            can Abort.Panic:
                return match expression:
                    Expr.If(condition, then_expression, else_expression, line): true
                    _: false

        # Whether NAME is a sized integer type (the domain where the linear tier's strict
        # bound tightening `x > c  =>  x >= c+1` is exact).
        def ensure_int_type_name(name: sview) -> bool:
            can Abort.Panic:
                return name == "i8" or name == "i16" or name == "i32" or name == "i64" or name == "u8" or name == "u16" or name == "u32" or name == "u64" or name == "usize" or name == "isize" or name == "int" or name == "uint"


        # Whether NAME is an UNSIGNED integer type (contributes an implicit `>= 0` bound).
        def ensure_unsigned_type_name(name: sview) -> bool:
            can Abort.Panic:
                return name == "u8" or name == "u16" or name == "u32" or name == "u64" or name == "usize" or name == "uint"


        def check_ensure_strict_function(parameters: darray[Ast::ParamDecl], body: darray[Ast::Stmt], function_name: sview, inl_names: darray[sview]&, inl_param_starts: darray[usize]&, inl_param_counts: darray[usize]&, all_inl_params: darray[sview]&, inl_bodies: darray[Ast::Expr]&, sum_names: darray[sview]&, sum_param_starts: darray[usize]&, sum_param_counts: darray[usize]&, all_sum_params: darray[sview]&, sum_ensure_starts: darray[usize]&, sum_ensure_counts: darray[usize]&, all_sum_ensures: darray[Ast::Expr]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                requires_predicates: mutable darray[Ast::Expr] = []
                return_expressions: mutable darray[Ast::Expr] = []
                branchy: mutable bool = false
                for statement in body |requires_predicates, return_expressions, branchy|:
                    match statement:
                        Stmt.Contract(kind, expression, line):
                            requires_predicates.push(expression) if kind == "requires"
                        Stmt.Return(value, line):
                            return_expressions.push(returned) if value is returned
                        Stmt.If(condition, then_body, else_body, line):
                            branchy <- true
                        Stmt.While(condition, while_body, line):
                            branchy <- true
                        Stmt.Match(scrutinee, arms, line):
                            branchy <- true
                        Stmt.Block(kind, clause, binding, block_body, line):
                            branchy <- true
                        _:
                            pass
                # Only judge a function whose value is a SINGLE straight-line return of a
                # non-conditional expression: there the ensure goal is `result <op> E` with
                # `result` == that return value, so the reflexive prover's verdict is sound.
                # Any branching / multiple returns / ternary return may establish the goal via
                # flow facts stage0's prover tracks (e.g. `max`'s `return a if a>b else b`
                # proves `result >= a`), so those are left unreported (a sound miss).
                single_return: bool = return_expressions.count == 1 and not branchy and not (any candidate in return_expressions where is_conditional_expression(candidate))
                return if not single_return
                # A return through an fn-typed PARAMETER (`return f(x)`) is not judged:
                # stage0 accepts it silently in both directions (the callee is opaque and
                # any `ensures(f, ...)` requires is trusted, not re-proven here).
                match return_expressions[0]:
                    Expr.Call(returned_callee, returned_arguments, returned_argument_names, returned_call_line):
                        callee_name: sview = ident_name_of(returned_callee)
                        return if callee_name != "" and (any fn_param in parameters where fn_param.name == callee_name)
                    _:
                        pass
                # Integer parameters and their box bounds, from `requires` clauses and
                # `where` refinements on the parameter types themselves.
                int_params: mutable darray[sview] = []
                has_lo: mutable darray[bool] = []
                lo: mutable darray[i64] = []
                has_hi: mutable darray[bool] = []
                hi: mutable darray[i64] = []
                where_predicates: mutable darray[Ast::Expr] = []
                for parameter in parameters |int_params, has_lo, lo, has_hi, hi, where_predicates|:
                    base_type: mutable Ast::Expr = parameter.type_expression
                    match parameter.type_expression:
                        Expr.Refinement(refined_base, refined_predicate, refinement_line):
                            base_type <- refined_base
                            where_predicates.push(refined_predicate)
                        _:
                            pass
                    type_name: sview = bare_type_name(base_type)
                    if ensure_int_type_name(type_name):
                        int_params.push(parameter.name)
                        unsigned: bool = ensure_unsigned_type_name(type_name)
                        has_lo.push(unsigned)
                        lo.push(0)
                        has_hi.push(false)
                        hi.push(0)
                for required in requires_predicates |int_params, has_lo, lo, has_hi, hi|:
                    lin_collect_fact(required, int_params, has_lo, lo, has_hi, hi)
                for refined in where_predicates |int_params, has_lo, lo, has_hi, hi|:
                    lin_collect_fact(refined, int_params, has_lo, lo, has_hi, hi)
                # A parameter the body ASSIGNS no longer carries its entry facts at the
                # return (`requires m > 100; m <- 0; return m`): drop its bounds entirely.
                for statement in body |int_params, has_lo, has_hi|:
                    match statement:
                        Stmt.Assign(target, operator, value, assign_line):
                            assigned: sview = ident_name_of(target)
                            drop_probe: mutable usize = 0
                            while drop_probe < int_params.count |drop_probe, assigned, int_params, has_lo, has_hi|:
                                if int_params[drop_probe] == assigned:
                                    has_lo[drop_probe] <- false
                                    has_hi[drop_probe] <- false
                                drop_probe <- drop_probe + 1
                        _:
                            pass
                # ENVIRONMENT: straight-line locals resolved to affine forms over the
                # parameters (`y = x; y <- y - 1; return y`). A non-affine initializer
                # (or a borrow) leaves the local opaque, which soundly fails the prover.
                env_names: mutable darray[sview] = []
                env_starts: mutable darray[usize] = []
                env_counts: mutable darray[usize] = []
                env_term_names: mutable darray[sview] = []
                env_term_coeffs: mutable darray[i64] = []
                env_consts: mutable darray[i64] = []
                for statement in body |env_names, env_starts, env_counts, env_term_names, env_term_coeffs, env_consts|:
                    match statement:
                        Stmt.VarDecl(local_name, local_type, local_value, local_line):
                            local_names2: mutable darray[sview] = []
                            local_coeffs2: mutable darray[i64] = []
                            local_konst2: mutable i64 = 0
                            local_linear: bool = lin_add_deep(local_value, 1, local_names2, local_coeffs2, local_konst2, Ast::Expr.Invalid, false, 0, env_names, env_starts, env_counts, env_term_names, env_term_coeffs, env_consts, inl_names, inl_param_starts, inl_param_counts, all_inl_params, inl_bodies)
                            continue if not local_linear
                            env_names.push(local_name)
                            env_starts.push(env_term_names.count)
                            env_counts.push(local_names2.count)
                            env_term_names.extend(local_names2)
                            env_term_coeffs.extend(local_coeffs2)
                            env_consts.push(local_konst2)
                        Stmt.Assign(assign_target, assign_operator, assign_value, assign_line):
                            assigned2: sview = ident_name_of(assign_target)
                            continue if assigned2 == ""
                            # A COMPOUND assignment (`y -= 1`) or a write through a REF
                            # alias invalidates the target's known form (and the aliased
                            # local's) — conservatively opaque, exactly enough to fail.
                            aliased_target: sview = ensure_env_alias_of(body, assigned2)
                            is_plain_rebind: bool = assign_operator == TokenKind.LArrow
                            if not is_plain_rebind or aliased_target != "":
                                wipe: mutable usize = 0
                                while wipe < env_names.count |wipe, assigned2, aliased_target, env_names|:
                                    env_names[wipe] <- sview("", 0, 0) if env_names[wipe] == assigned2
                                    env_names[wipe] <- sview("", 0, 0) if aliased_target != "" and env_names[wipe] == aliased_target
                                    wipe <- wipe + 1
                                continue
                            new_names2: mutable darray[sview] = []
                            new_coeffs2: mutable darray[i64] = []
                            new_konst2: mutable i64 = 0
                            new_linear: bool = lin_add_deep(assign_value, 1, new_names2, new_coeffs2, new_konst2, Ast::Expr.Invalid, false, 0, env_names, env_starts, env_counts, env_term_names, env_term_coeffs, env_consts, inl_names, inl_param_starts, inl_param_counts, all_inl_params, inl_bodies)
                            # A REASSIGNED local appends a fresh env row; lookups scan and
                            # take the FIRST match, so shadow by prepend is unavailable —
                            # instead invalidate the old row's name and append.
                            invalidate: mutable usize = 0
                            while invalidate < env_names.count |invalidate, assigned2, env_names|:
                                env_names[invalidate] <- sview("", 0, 0) if env_names[invalidate] == assigned2
                                invalidate <- invalidate + 1
                            continue if not new_linear
                            env_names.push(assigned2)
                            env_starts.push(env_term_names.count)
                            env_counts.push(new_names2.count)
                            env_term_names.extend(new_names2)
                            env_term_coeffs.extend(new_coeffs2)
                            env_consts.push(new_konst2)
                        _:
                            pass
                for statement in body |table| -> table:
                    match statement:
                        Stmt.Contract(kind, expression, contract_line):
                            proven: bool = ensure_is_proven(expression, requires_predicates, return_expressions, int_params, has_lo, lo, has_hi, hi, env_names, env_starts, env_counts, env_term_names, env_term_coeffs, env_consts, inl_names, inl_param_starts, inl_param_counts, all_inl_params, inl_bodies, sum_names, sum_param_starts, sum_param_counts, all_sum_params, sum_ensure_starts, sum_ensure_counts, all_sum_ensures)
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.EnsureNotProven, name: function_name, line: contract_line, expected: "", actual: ""}) if kind == "ensure" and not proven
                        _:
                            pass

        # PURE single-return callees (inline tier) and callee ENSURE summaries.
        def ensure_collect_callee_tables(declarations: darray[Ast::Decl], inl_names: mutable darray[sview]&, inl_param_starts: mutable darray[usize]&, inl_param_counts: mutable darray[usize]&, all_inl_params: mutable darray[sview]&, inl_bodies: mutable darray[Ast::Expr]&, sum_names: mutable darray[sview]&, sum_param_starts: mutable darray[usize]&, sum_param_counts: mutable darray[usize]&, all_sum_params: mutable darray[sview]&, sum_ensure_starts: mutable darray[usize]&, sum_ensure_counts: mutable darray[usize]&, all_sum_ensures: mutable darray[Ast::Expr]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |inl_names, inl_param_starts, inl_param_counts, all_inl_params, inl_bodies, sum_names, sum_param_starts, sum_param_counts, all_sum_params, sum_ensure_starts, sum_ensure_counts, all_sum_ensures|:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            # Inline candidates: contracts + exactly one Return, nothing else.
                            single_return: mutable Ast::Expr = Ast::Expr.Absent
                            return_count: mutable usize = 0
                            other_count: mutable usize = 0
                            ensure_count: mutable usize = 0
                            for statement in body |single_return, return_count, other_count, ensure_count, all_sum_ensures|:
                                match statement:
                                    Stmt.Return(value, return_line):
                                        return_count <- return_count + 1
                                        single_return <- returned if value is returned
                                    Stmt.Contract(kind, expression, contract_line):
                                        if kind == "ensure":
                                            ensure_count <- ensure_count + 1
                                            all_sum_ensures.push(expression)
                                    _:
                                        other_count <- other_count + 1
                            if ensure_count > 0:
                                sum_names.push(function_name)
                                sum_param_starts.push(all_sum_params.count)
                                sum_param_counts.push(parameters.count)
                                for parameter in parameters |all_sum_params|:
                                    all_sum_params.push(parameter.name)
                                sum_ensure_starts.push(all_sum_ensures.count - ensure_count)
                                sum_ensure_counts.push(ensure_count)
                            if return_count == 1 and other_count == 0:
                                inl_names.push(function_name)
                                inl_param_starts.push(all_inl_params.count)
                                inl_param_counts.push(parameters.count)
                                for parameter in parameters |all_inl_params|:
                                    all_inl_params.push(parameter.name)
                                inl_bodies.push(single_return)
                        Decl.Module(module_name, module_body, module_line):
                            ensure_collect_callee_tables(module_body, inl_names, inl_param_starts, inl_param_counts, all_inl_params, inl_bodies, sum_names, sum_param_starts, sum_param_counts, all_sum_params, sum_ensure_starts, sum_ensure_counts, all_sum_ensures)
                        Decl.Scoped(scoped_body, scoped_line):
                            ensure_collect_callee_tables(scoped_body, inl_names, inl_param_starts, inl_param_counts, all_inl_params, inl_bodies, sum_names, sum_param_starts, sum_param_counts, all_sum_params, sum_ensure_starts, sum_ensure_counts, all_sum_ensures)
                        _:
                            pass


        def check_ensure_strict_walk(declarations: darray[Ast::Decl], inl_names: darray[sview]&, inl_param_starts: darray[usize]&, inl_param_counts: darray[usize]&, all_inl_params: darray[sview]&, inl_bodies: darray[Ast::Expr]&, sum_names: darray[sview]&, sum_param_starts: darray[usize]&, sum_param_counts: darray[usize]&, all_sum_params: darray[sview]&, sum_ensure_starts: darray[usize]&, sum_ensure_counts: darray[usize]&, all_sum_ensures: darray[Ast::Expr]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            table <- check_ensure_strict_function(parameters, body, function_name, inl_names, inl_param_starts, inl_param_counts, all_inl_params, inl_bodies, sum_names, sum_param_starts, sum_param_counts, all_sum_params, sum_ensure_starts, sum_ensure_counts, all_sum_ensures, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- check_ensure_strict_walk(module_body, inl_names, inl_param_starts, inl_param_counts, all_inl_params, inl_bodies, sum_names, sum_param_starts, sum_param_counts, all_sum_params, sum_ensure_starts, sum_ensure_counts, all_sum_ensures, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- check_ensure_strict_walk(scoped_body, inl_names, inl_param_starts, inl_param_counts, all_inl_params, inl_bodies, sum_names, sum_param_starts, sum_param_counts, all_sum_params, sum_ensure_starts, sum_ensure_counts, all_sum_ensures, table)
                        _:
                            pass


        def check_ensure_strict(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                inl_names: mutable darray[sview] = []
                inl_param_starts: mutable darray[usize] = []
                inl_param_counts: mutable darray[usize] = []
                all_inl_params: mutable darray[sview] = []
                inl_bodies: mutable darray[Ast::Expr] = []
                sum_names: mutable darray[sview] = []
                sum_param_starts: mutable darray[usize] = []
                sum_param_counts: mutable darray[usize] = []
                all_sum_params: mutable darray[sview] = []
                sum_ensure_starts: mutable darray[usize] = []
                sum_ensure_counts: mutable darray[usize] = []
                all_sum_ensures: mutable darray[Ast::Expr] = []
                ensure_collect_callee_tables(declarations, inl_names, inl_param_starts, inl_param_counts, all_inl_params, inl_bodies, sum_names, sum_param_starts, sum_param_counts, all_sum_params, sum_ensure_starts, sum_ensure_counts, all_sum_ensures)
                table <- check_ensure_strict_walk(declarations, inl_names, inl_param_starts, inl_param_counts, all_inl_params, inl_bodies, sum_names, sum_param_starts, sum_param_counts, all_sum_params, sum_ensure_starts, sum_ensure_counts, all_sum_ensures, table)
