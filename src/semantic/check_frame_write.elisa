# Frame-condition body writes (sound subset of stage0 analyzer_frame_changes). A function that
# declares a `changes P.f, ...` frame may only write the named param fields; a DIRECT write to a
# parameter field outside the set is rejected ("writes to ROOT.FIELD, which is outside the
# `changes` set of NAME").
#
# The parser records each function's `changes P.FIELD` fields on the side-table (owner=function,
# name=field, line-sentinel 3900000003) — only the FIELD name after the dot, so membership is
# tested by field name. This is a SOUND subset of stage0's exact (root, field) match: a write to a
# field name absent from the whole set can never be in-frame (so no false positive); it only MISSES
# when a field name recurs across params. Interprocedural "may write" (writes through a callee) and
# alias writes need callee frame summaries / alias tracking and are left to stage0 (sound misses).
extend Semantic:
    private:
        def frame_mutating_method(method: sview) -> bool:
            can Abort.Panic:
                return method == "push" or method == "extend" or method == "add" or method == "put" or method == "insert" or method == "reserve" or method == "resize" or method == "clear" or method == "pop" or method == "remove" or method == "set"

        # A write to `PARAM.FIELD` (root is a parameter): returns (found, root, field). Handles a
        # direct field lvalue `p.f` and a mutating-method receiver `p.f.push(...)`.
        def frame_write_target(target: Ast::Expr, params: darray[sview]&) -> (found: bool, root: sview, field: sview):
            can Abort.Panic:
                match target:
                    Expr.Field(object, field, line):
                        root: sview = ident_name_of(object)
                        return (root != "" and (any parameter_name in params where parameter_name == root), root, field)
                    Expr.Paren(inner, line):
                        return frame_write_target(inner, params)
                    _:
                        return (false, sview("", 0, 0), sview("", 0, 0))

        def frame_field_in_set(changes_fields: darray[sview]&, field: sview) -> bool:
            can Abort.Panic:
                return any changed in changes_fields where changed == field

        def frame_report_write(root: sview, field: sview, function_name: sview, line: u32, changes_fields: darray[sview]&, params: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                return if frame_field_in_set(changes_fields, field)
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.WritesOutsideChanges, name: root, line: line, expected: function_name, actual: field})

        # Scan an expression for `&PARAM.field` sub-expressions — taking the mutable address of a
        # parameter field and passing it (typically to a call) MAY write that field. If the field
        # is outside the frame it is flagged ("may write ROOT.FIELD ..."). Sound: a bare address-of
        # a param field outside the declared set can only be a potential out-of-frame write.
        def frame_scan_addr_writes(expression: Ast::Expr, function_name: sview, changes_fields: darray[sview]&, params: darray[sview]&, line: u32, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Unary(operator, operand, unary_line):
                        if operator == TokenKind.Ampersand:
                            write: (found: bool, root: sview, field: sview) = frame_write_target(operand, params)
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.WritesOutsideChanges, name: write.root, line: line, expected: function_name, actual: write.field, expected_count: 1}) if write.found and not frame_field_in_set(changes_fields, write.field)
                        table <- frame_scan_addr_writes(operand, function_name, changes_fields, params, line, table)
                    Expr.Call(callee, arguments, argument_names, call_line):
                        for argument in arguments |table| -> table:
                            table <- frame_scan_addr_writes(argument, function_name, changes_fields, params, line, table)
                    Expr.Paren(inner, paren_line):
                        table <- frame_scan_addr_writes(inner, function_name, changes_fields, params, line, table)
                    Expr.Binary(left, binary_operator, right, binary_line):
                        table <- frame_scan_addr_writes(left, function_name, changes_fields, params, line, table)
                        table <- frame_scan_addr_writes(right, function_name, changes_fields, params, line, table)
                    _:
                        pass

        def frame_write_walk(statements: darray[Ast::Stmt], function_name: sview, changes_fields: darray[sview]&, params: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Assign(target, operator, value, line):
                            write: (found: bool, root: sview, field: sview) = frame_write_target(target, params)
                            table <- frame_report_write(write.root, write.field, function_name, line, changes_fields, params, table) if write.found
                        Stmt.Expr(expression, line):
                            # A mutating method on a param field: `p.f.push(...)`.
                            if expression is Expr.Call(callee, arguments, argument_names, call_line):
                                if callee is Expr.Field(receiver, method, field_line):
                                    if frame_mutating_method(method):
                                        write: (found: bool, root: sview, field: sview) = frame_write_target(receiver, params)
                                        table <- frame_report_write(write.root, write.field, function_name, line, changes_fields, params, table) if write.found
                            # `&PARAM.field` passed into any call may write that field.
                            table <- frame_scan_addr_writes(expression, function_name, changes_fields, params, line, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- frame_write_walk(then_body, function_name, changes_fields, params, table)
                            table <- frame_write_walk(else_body, function_name, changes_fields, params, table)
                        Stmt.While(condition, while_body, line):
                            table <- frame_write_walk(while_body, function_name, changes_fields, params, table)
                        Stmt.For(bind, variables, iterable, for_body, line):
                            table <- frame_write_walk(for_body, function_name, changes_fields, params, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- frame_write_walk(body, function_name, changes_fields, params, table)
                        _:
                            pass

        def collect_changes_fields(enum_annotations: darray[Ast::EnumAnnotation]&, function_name: sview, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for annotation in enum_annotations |out|:
                    out.push(annotation.name) if annotation.line == 3900000003 and annotation.owner == function_name

        def check_frame_write_walk(declarations: darray[Ast::Decl], enum_annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            changes_fields: mutable darray[sview] = []
                            collect_changes_fields(enum_annotations, function_name, changes_fields)
                            if changes_fields.count > 0:
                                params: mutable darray[sview] = [parameter.name for parameter in parameters]
                                table <- frame_write_walk(body, function_name, changes_fields, params, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- check_frame_write_walk(module_body, enum_annotations, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- check_frame_write_walk(scoped_body, enum_annotations, table)
                        _:
                            pass

        def check_frame_write(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- check_frame_write_walk(file.top_decls, file.enum_annotations, table)

        # Each `changes ROOT.field` target's ROOT must name an actual parameter. Roots are recorded
        # under sentinel 3900000006 (owner=function). A root not in the function's parameter list is
        # rejected ("`changes` target ROOT is not a parameter").
        def check_changes_target_walk(declarations: darray[Ast::Decl], enum_annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            params: mutable darray[sview] = [parameter.name for parameter in parameters]
                            for annotation in enum_annotations |table| -> table:
                                is_root_of_this: bool = annotation.line == 3900000006 and annotation.owner == function_name
                                not_a_param: bool = is_root_of_this and not (any parameter_name in params where parameter_name == annotation.name)
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ChangesTargetNotParam, name: annotation.name, line: line, expected: "", actual: ""}) if not_a_param
                        Decl.Module(module_name, module_body, module_line):
                            table <- check_changes_target_walk(module_body, enum_annotations, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- check_changes_target_walk(scoped_body, enum_annotations, table)
                        _:
                            pass

        def check_changes_target_param(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- check_changes_target_walk(file.top_decls, file.enum_annotations, table)
