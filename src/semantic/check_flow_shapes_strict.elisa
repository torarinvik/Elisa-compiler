# Stage1 semantic — the `# flow-strict` block-`if` census and the check entry (`extend
# Semantic: private+public:`). Decides which block `if`s are legitimate guards and which
# the strict mode flags, then `check_flow_shapes` drives the whole check. Continues
# check_flow_shapes_depth.elisa; split out to keep each part under 600 lines.

extend Semantic:
    private:
        # docs/125 §6b, ported from stage0's isLegitimateGuardBlock: a written block `if`
        # is EXEMPT when it is a conditional COMPUTATION rather than a hidden decision
        # tree. stage1 previously flagged every tagged block `if`, which disagreed with
        # stage0 on ordinary code.
        def flow_cond_contains_is_test(condition: Ast::Expr) -> bool:
            can Abort.Panic:
                match condition:
                    Expr.Binary(is_left, is_operator, is_right, is_line):
                        true return if is_operator == TokenKind.Is
                        flow_cond_contains_is_test(is_left) or flow_cond_contains_is_test(is_right) return if is_operator == TokenKind.And or is_operator == TokenKind.Or
                        return false
                    Expr.Unary(unary_operator, unary_operand, unary_line):
                        flow_cond_contains_is_test(unary_operand) return if unary_operator == TokenKind.Not
                        return false
                    Expr.Paren(paren_inner, paren_line):
                        return flow_cond_contains_is_test(paren_inner)
                    _:
                        return false

        # A body binds a NEW local (`x = <compute>`) — the one shape no guard or value
        # form can express, so such a block is a legitimate guard.
        def flow_body_binds_local(statements: darray[Ast::Stmt]) -> bool:
            can Abort.Panic:
                binds: mutable bool = false
                for statement in statements |binds|:
                    binds <- true if statement is Stmt.VarDecl(_, _, _, _)
                return binds

        def flow_stmt_is_loop_or_match(statement: Ast::Stmt) -> bool:
            can Abort.Panic:
                true return if statement is Stmt.While(_, _, _)
                true return if statement is Stmt.For(_, _, _, _, _)
                true return if statement is Stmt.Match(_, _, _)
                # A capture-listed loop parses as Stmt.Expr(Expr.Block([decls…, loop], …)).
                if statement is Stmt.Expr(wrapped_expression, wrapped_line):
                    if wrapped_expression is Expr.Block(wrapped_statements, wrapped_value, wrapped_captures, wrapped_block_line):
                        wrapped_has_loop: mutable bool = false
                        for wrapped_statement in wrapped_statements |wrapped_has_loop|:
                            wrapped_has_loop <- true if wrapped_statement is Stmt.While(_, _, _)
                            wrapped_has_loop <- true if wrapped_statement is Stmt.For(_, _, _, _, _)
                        return wrapped_has_loop
                return false

        def flow_body_has_nested_decision(statements: darray[Ast::Stmt], block_if_lines: darray[u32]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                nested: mutable bool = false
                for statement in statements |nested, block_if_lines|:
                    if statement is Stmt.If(nested_condition, nested_then, nested_else, nested_line):
                        # Only a SOURCE block `if` can make the parent a tree; a desugared
                        # postfix guard is a sanctioned form.
                        continue if not (any tagged in block_if_lines where tagged == nested_line)
                        continue if flow_cond_contains_is_test(nested_condition)
                        continue if flow_if_is_legitimate_guard(nested_condition, nested_then, nested_else, block_if_lines)
                        nested <- true
                return nested

        def flow_if_is_legitimate_guard(condition: Ast::Expr, then_body: darray[Ast::Stmt], else_body: darray[Ast::Stmt], block_if_lines: darray[u32]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                # An if/elif chain is a decision TABLE (stage1 desugars `elif` into a lone
                # nested `if` in the else branch), never exempt.
                chained: mutable bool = false
                for only in else_body |chained|:
                    chained <- true if only is Stmt.If(_, _, _, _)
                chained <- false if else_body.count != 1
                false return if chained
                false return if flow_body_has_nested_decision(then_body, block_if_lines)
                false return if flow_body_has_nested_decision(else_body, block_if_lines)
                true return if flow_body_binds_local(then_body) or flow_body_binds_local(else_body)
                # Guarded loop or guarded match: `if COND:` whose body is exactly one of them.
                true return if else_body.count == 0 and then_body.count == 1 and flow_stmt_is_loop_or_match(then_body[0])
                # Straight-line multi-effect guard: splitting it to postfix guards would
                # re-evaluate the condition once per statement.
                true return if else_body.count == 0 and then_body.count >= 2
                # Two-way alternation where at least one side carries 2+ statements: no
                # ternary can carry statements. Both-sides-single stays flagged.
                true return if else_body.count > 0 and (then_body.count >= 2 or else_body.count >= 2)
                return false

        def flow_strict_walk_statements(statements: darray[Ast::Stmt], block_if_lines: darray[u32]&, out: mutable darray[u32]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |block_if_lines, out|:
                    match statement:
                        Stmt.If(if_condition, then_body, else_body, if_line):
                            tagged: bool = any tagged_line in block_if_lines where tagged_line == if_line
                            exempt: bool = flow_cond_contains_is_test(if_condition) or flow_if_is_legitimate_guard(if_condition, then_body, else_body, block_if_lines)
                            out.push(if_line) if tagged and not exempt
                            flow_strict_walk_statements(then_body, block_if_lines, out)
                            flow_strict_walk_statements(else_body, block_if_lines, out)
                        Stmt.While(while_condition, while_body, while_line):
                            flow_strict_walk_statements(while_body, block_if_lines, out)
                        Stmt.For(for_bind, for_variables, for_iterable, for_body, for_line):
                            flow_strict_walk_statements(for_body, block_if_lines, out)
                        Stmt.Block(block_kind, block_clause, block_binding, block_body, block_line):
                            flow_strict_walk_statements(block_body, block_if_lines, out)
                        Stmt.Match(match_scrutinee, match_arms, match_line):
                            for match_arm in match_arms |block_if_lines, out|:
                                flow_strict_walk_statements(match_arm.body, block_if_lines, out)
                        Stmt.Expr(statement_expression, statement_expression_line):
                            flow_strict_walk_expression(statement_expression, block_if_lines, out)
                        Stmt.VarDecl(var_name, var_type, var_value, var_line):
                            flow_strict_walk_expression(var_value, block_if_lines, out)
                        Stmt.Assign(assign_target, assign_operator, assign_value, assign_line):
                            flow_strict_walk_expression(assign_value, block_if_lines, out)
                        _:
                            pass

        def flow_strict_walk_expression(expression: Ast::Expr, block_if_lines: darray[u32]&, out: mutable darray[u32]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Block(block_statements, block_value, block_captures, block_expr_line):
                        flow_strict_walk_statements(block_statements, block_if_lines, out)
                        flow_strict_walk_expression(block_value, block_if_lines, out)
                    _:
                        pass

    public:
        # The block-`if` sites that stage0 would actually flag under -Wflow-strict.
        def flow_strict_flagged_if_lines(declarations: darray[Ast::Decl], block_if_lines: darray[u32]&, out: mutable darray[u32]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |block_if_lines, out|:
                    match declaration:
                        Decl.Func(flow_fn_name, flow_fn_params, flow_fn_return, flow_fn_body, flow_fn_effects, flow_fn_decorators, flow_fn_line):
                            flow_strict_walk_statements(flow_fn_body, block_if_lines, out)
                        Decl.Module(flow_module_name, flow_module_body, flow_module_line):
                            flow_strict_flagged_if_lines(flow_module_body, block_if_lines, out)
                        Decl.Scoped(flow_scoped_body, flow_scoped_line):
                            flow_strict_flagged_if_lines(flow_scoped_body, block_if_lines, out)
                        _:
                            pass

    private:
        def check_flow_shapes(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            seen: mutable darray[u32] = []
                            table <- flow_shapes_walk(body, false, seen, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- check_flow_shapes(module_body, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- check_flow_shapes(scoped_body, table)
                        _:
                            pass
