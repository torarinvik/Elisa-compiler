# Check for non-numeric (firm Bool/String) operands to shift/bitwise binary operators: << >> & | ^.

extend Semantic:
    private:
        # Whether an operator is one of the shift/bitwise binary operators we cover.
        def is_shift_or_bitwise_operator(operator: TokenKind) -> bool:
            can Abort.Panic:
                return operator == TokenKind.LShift or operator == TokenKind.RShift or operator == TokenKind.Ampersand or operator == TokenKind.Pipe or operator == TokenKind.Caret

        # Walk through expressions, checking for non-numeric shift/bitwise operands.
        def walk_expression_for_nonnumeric_shift(expression: Ast::Expr, table: lmut SymbolTable, var_types: mutable darray[sview]&, type_names: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Binary(left, operator, right, line):
                        left_type: InferType = infer_expression_type(left, var_types, type_names, table)
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.NonNumericShiftOperand, name: "", line: line, expected: "", actual: ""}) if is_shift_or_bitwise_operator(operator) and kind_is_firm_non_numeric(left_type)
                        right_type: InferType = infer_expression_type(right, var_types, type_names, table)
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.NonNumericShiftOperand, name: "", line: line, expected: "", actual: ""}) if is_shift_or_bitwise_operator(operator) and kind_is_firm_non_numeric(right_type)
                        # Recursively walk both sides
                        table <- walk_expression_for_nonnumeric_shift(left, table, var_types, type_names)
                        table <- walk_expression_for_nonnumeric_shift(right, table, var_types, type_names) if operator != TokenKind.Is and operator != TokenKind.As
                    Expr.Call(callee, arguments, argument_names, line):
                        table <- walk_expression_for_nonnumeric_shift(callee, table, var_types, type_names)
                        for argument in arguments |table|:
                            table <- walk_expression_for_nonnumeric_shift(argument, table, var_types, type_names)
                    Expr.Field(object, field, line):
                        table <- walk_expression_for_nonnumeric_shift(object, table, var_types, type_names)
                    Expr.Scope(base, name, line):
                        table <- walk_expression_for_nonnumeric_shift(base, table, var_types, type_names)
                    Expr.Index(object, index, line):
                        table <- walk_expression_for_nonnumeric_shift(object, table, var_types, type_names)
                        table <- walk_expression_for_nonnumeric_shift(index, table, var_types, type_names) if not index_receiver_is_type_application(object)
                    Expr.Unary(operator, operand, line):
                        table <- walk_expression_for_nonnumeric_shift(operand, table, var_types, type_names)
                    Expr.Paren(inner, line):
                        table <- walk_expression_for_nonnumeric_shift(inner, table, var_types, type_names)
                    Expr.Array(elements, line):
                        for element in elements |table|:
                            table <- walk_expression_for_nonnumeric_shift(element, table, var_types, type_names)
                    Expr.Tuple(elements, line):
                        for element in elements |table|:
                            table <- walk_expression_for_nonnumeric_shift(element, table, var_types, type_names)
                    Expr.Slice(object, low, high, line):
                        table <- walk_expression_for_nonnumeric_shift(object, table, var_types, type_names)
                        table <- walk_expression_for_nonnumeric_shift(low, table, var_types, type_names)
                        table <- walk_expression_for_nonnumeric_shift(high, table, var_types, type_names)
                    Expr.IndexN(object, arguments, line):
                        table <- walk_expression_for_nonnumeric_shift(object, table, var_types, type_names)
                        for argument in arguments |table|:
                            table <- walk_expression_for_nonnumeric_shift(argument, table, var_types, type_names) if not index_receiver_is_type_application(object)
                    Expr.SetLit(elements, line):
                        for element in elements |table|:
                            table <- walk_expression_for_nonnumeric_shift(element, table, var_types, type_names)
                    Expr.DictLit(entries, line):
                        for entry in entries |table|:
                            table <- walk_expression_for_nonnumeric_shift(entry.key, table, var_types, type_names)
                            table <- walk_expression_for_nonnumeric_shift(entry.value, table, var_types, type_names)
                    Expr.Construct(type_expression, fields, line):
                        table <- walk_expression_for_nonnumeric_shift(type_expression, table, var_types, type_names)
                        for field in fields |table|:
                            table <- walk_expression_for_nonnumeric_shift(field.value, table, var_types, type_names)
                    Expr.RecordUpdate(base, fields, line):
                        table <- walk_expression_for_nonnumeric_shift(base, table, var_types, type_names)
                        for field in fields |table|:
                            table <- walk_expression_for_nonnumeric_shift(field.value, table, var_types, type_names)
                    Expr.If(condition, then_expr, else_expr, line):
                        table <- walk_expression_for_nonnumeric_shift(condition, table, var_types, type_names)
                        table <- walk_expression_for_nonnumeric_shift(then_expr, table, var_types, type_names)
                        table <- walk_expression_for_nonnumeric_shift(else_expr, table, var_types, type_names)
                    Expr.Comprehension(loop_variable, iterable, condition, body, line):
                        table <- walk_expression_for_nonnumeric_shift(iterable, table, var_types, type_names)
                        table <- walk_expression_for_nonnumeric_shift(condition, table, var_types, type_names)
                        table <- walk_expression_for_nonnumeric_shift(body, table, var_types, type_names)
                    Expr.Lambda(parameters, body, line):
                        table <- walk_statements_for_nonnumeric_shift(body, table, var_types, type_names)
                    Expr.Block(statements, value, captures, line):
                        table <- walk_statements_for_nonnumeric_shift(statements, table, var_types, type_names)
                        table <- walk_expression_for_nonnumeric_shift(value, table, var_types, type_names)
                    Expr.Match(scrutinee, arms, line):
                        table <- walk_expression_for_nonnumeric_shift(scrutinee, table, var_types, type_names)
                        for arm in arms |table|:
                            table <- walk_statements_for_nonnumeric_shift(arm.body, table, var_types, type_names)
                    # Literals and other expressions don't contain relevant sub-expressions
                    _:
                        pass

        # Walk through statements, tracking variable types and checking for non-numeric shift operands.
        def walk_statements_for_nonnumeric_shift(statements: darray[Ast::Stmt], table: lmut SymbolTable, var_types: mutable darray[sview]&, type_names: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table|:
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- walk_expression_for_nonnumeric_shift(expression, table, var_types, type_names)
                        Stmt.VarDecl(name, type_expression, value, line):
                            # Record the type for this variable
                            type_name: sview = bare_type_name(type_expression)
                            note_local_type(var_types, type_names, name, type_name)
                            table <- walk_expression_for_nonnumeric_shift(value, table, var_types, type_names)
                        Stmt.Assign(target, operator, value, line):
                            table <- walk_expression_for_nonnumeric_shift(target, table, var_types, type_names)
                            table <- walk_expression_for_nonnumeric_shift(value, table, var_types, type_names)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- walk_expression_for_nonnumeric_shift(condition, table, var_types, type_names)
                            table <- walk_statements_for_nonnumeric_shift(then_body, table, var_types, type_names)
                            table <- walk_statements_for_nonnumeric_shift(else_body, table, var_types, type_names)
                        Stmt.While(condition, body, line):
                            table <- walk_expression_for_nonnumeric_shift(condition, table, var_types, type_names)
                            table <- walk_statements_for_nonnumeric_shift(body, table, var_types, type_names)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- walk_expression_for_nonnumeric_shift(iterable, table, var_types, type_names)
                            table <- walk_statements_for_nonnumeric_shift(body, table, var_types, type_names)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- walk_statements_for_nonnumeric_shift(body, table, var_types, type_names)
                        Stmt.Match(scrutinee, arms, line):
                            table <- walk_expression_for_nonnumeric_shift(scrutinee, table, var_types, type_names)
                            for arm in arms |table|:
                                table <- walk_expression_for_nonnumeric_shift(arm.guard, table, var_types, type_names)
                                table <- walk_statements_for_nonnumeric_shift(arm.body, table, var_types, type_names)
                        Stmt.Return(value, line):
                            table <- walk_expression_for_nonnumeric_shift(return_value, table, var_types, type_names) if value is return_value
                        Stmt.Contract(kind, expression, line):
                            table <- walk_expression_for_nonnumeric_shift(expression, table, var_types, type_names)
                        Stmt.Invalid:
                            pass
                        Stmt.Break(label, line):
                            pass
                        Stmt.Continue(label, line):
                            pass

        # Walk through function declarations.
        def check_nonnumeric_shift_declarations(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table|:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            # Create fresh type tracking for this function
                            var_types: mutable darray[sview] = []
                            type_names: mutable darray[sview] = []
                            # Record parameter types
                            for param in params |table|:
                                param_type: sview = bare_type_name(param.type_expression)
                                note_local_type(var_types, type_names, param.name, param_type)
                            # Walk the function body
                            table <- walk_statements_for_nonnumeric_shift(body, table, var_types, type_names)
                        Decl.Module(module_name, body, line):
                            table <- check_nonnumeric_shift_declarations(body, table)
                        Decl.Scoped(body, line):
                            table <- check_nonnumeric_shift_declarations(body, table)
                        _:
                            pass

    public:
        # Public entry point for the check.
        def check_nonnumeric_shift_operand(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- check_nonnumeric_shift_declarations(declarations, table)
