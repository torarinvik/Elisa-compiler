# Enum-to-enum value walls (stage0 parity). A value whose type is FIRMLY a declared enum
# `V` cannot inhabit a slot typed as a different enum `T` unless `V`'s `is`-parent chain
# reaches `T`. stage0 reports every shape; stage1 used to report none of them, and the
# backend either declined or -- for a payload variant into a plain enum, or a parent value
# into a sub-enum slot -- silently compiled a wrong program:
#
#     v: A = B.P          # variable "v" expects A, got B
#     v <- B.P            # cannot assign B to A
#     return B.P          # return type expects A, got B
#     g(B.P)              # argument 1 to "g" expects A, got B
#     H{a: B.P}           # struct literal field "a" expects A, got B
#     B.P if c else A.X   # ternary branches are incompatible: B and A
#
# The value's enum is only ever taken from a shape that cannot be anything else: a variant
# path `E.V` / `E.V(...)` whose head is a declared enum (and not a shadowing local), a
# local whose DECLARED type is an enum, a uniquely-named function returning one, and a
# ternary/match whose every branch agrees. `.V` shorthand is context-typed and never
# counts. A name declared as an enum more than once (same-named enums in different modules
# of a flattened build) is never judged: the bare name does not say which one is meant.
extend Semantic:
    private:
        const ENUM_WALL_MAX_DEPTH: u32 = 16

        # The declared `is`-parent of enum `child`, or "".
        def enum_wall_parent(table: SymbolTable&, child: sview) -> sview:
            can Abort.Panic:
                for index in 0..<table.enum_hierarchy_child.count:
                    table.enum_hierarchy_parent[index] return if table.enum_hierarchy_child[index] == child
                return ""

        # Whether a `sub` value may be stored where `super_enum` is expected: the same enum,
        # or `super_enum` is reachable up `sub`'s parent chain (depth-bounded against cycles).
        def enum_wall_assignable(table: SymbolTable&, sub: sview, super_enum: sview, depth: u32) -> bool:
            can Abort.Panic:
                false return if depth > ENUM_WALL_MAX_DEPTH or sub == ""
                true return if sub == super_enum
                return enum_wall_assignable(table, enum_wall_parent(table, sub), super_enum, depth + 1)

        # Whether `name` names exactly one declaration, and that declaration is an enum.
        def enum_wall_is_firm(table: SymbolTable&, name: sview) -> bool:
            can Abort.Panic:
                false return if name == ""
                enum_rows: mutable u32 = 0
                other_rows: mutable u32 = 0
                row: mutable u32 = symbol_chain_head(table, name)
                while row != 4294967295 |enum_rows, other_rows, row, table, name|:
                    chain_symbol: Symbol& = &table.symbols[row.usize()]
                    if chain_symbol.name == name:
                        enum_rows <- enum_rows + 1 if chain_symbol.kind == SymbolKind.Enum
                        other_rows <- other_rows + 1 if chain_symbol.kind != SymbolKind.Enum
                    row <- table.symbol_name_next[row.usize()]
                return enum_rows == 1 and other_rows == 0

        # The enum a variant path `owner.variant` constructs, or "".
        def enum_wall_variant_owner(object: Ast::Expr, variant: sview, names: darray[sview]&, table: SymbolTable&) -> sview:
            can Memory.Allocate, Abort.Panic:
                match object:
                    Expr.Ident(owner, owner_pos):
                        # A local spelled like the enum shadows it (stage0 still resolves the
                        # enum there; staying silent is the conservative side of that quirk).
                        "" return if any local_name in names where local_name == owner
                        "" return if not enum_wall_is_firm(table, owner)
                        owner return if enum_has_variant(table, owner, variant)
                        return ""
                    _:
                        return ""

        # The tail value of a match/catch arm body, when it is a plain expression statement.
        def enum_wall_arm_value(arm: Ast::MatchArm) -> Ast::Expr?:
            can Memory.Allocate, Abort.Panic:
                if arm.body.count == 0:
                    return null
                match arm.body[arm.body.count - 1]:
                    Stmt.Expr(arm_value, arm_value_pos):
                        return arm_value
                    _:
                        return null

        # The enum every arm of a match expression yields, or "" when any arm is untyped
        # or two arms disagree (the disagreement is reported by the arm check itself).
        def enum_wall_arms_type(arms: darray[Ast::MatchArm], names: darray[sview]&, types: darray[sview]&, table: SymbolTable&) -> sview:
            can Memory.Allocate, Abort.Panic:
                agreed: mutable sview = ""
                for arm in arms |agreed|:
                    arm_enum: mutable sview = ""
                    value: Ast::Expr? = enum_wall_arm_value(arm)
                    if value is arm_value:
                        arm_enum <- enum_wall_value_type(arm_value, names, types, table)
                    "" return if arm_enum == "" or (agreed != "" and arm_enum != agreed)
                    agreed <- arm_enum
                return agreed

        # The enum `value` FIRMLY has, or "".
        def enum_wall_value_type(value: Ast::Expr, names: darray[sview]&, types: darray[sview]&, table: SymbolTable&) -> sview:
            can Memory.Allocate, Abort.Panic:
                match value:
                    Expr.Paren(inner, paren_pos):
                        return enum_wall_value_type(inner, names, types, table)
                    Expr.Field(object, field, field_pos):
                        return enum_wall_variant_owner(object, field, names, table)
                    Expr.Call(callee, arguments, argument_names, call_pos):
                        match callee:
                            Expr.Field(variant_object, variant_name, variant_pos):
                                return enum_wall_variant_owner(variant_object, variant_name, names, table)
                            Expr.Ident(function_name, function_pos):
                                "" return if any local_name in names where local_name == function_name
                                "" return if direct_function_count(table, function_name) != 1
                                returned: sview = function_return_type(table, function_name)
                                returned return if enum_wall_is_firm(table, returned)
                                return ""
                            _:
                                return ""
                    Expr.Ident(name, ident_pos):
                        declared: sview = local_type_of(names, types, name)
                        declared return if enum_wall_is_firm(table, declared)
                        return ""
                    Expr.If(condition, then_expr, else_expr, if_pos):
                        then_enum: sview = enum_wall_value_type(then_expr, names, types, table)
                        else_enum: sview = enum_wall_value_type(else_expr, names, types, table)
                        then_enum return if then_enum != "" and then_enum == else_enum
                        return ""
                    Expr.Match(scrutinee, arms, match_pos):
                        return enum_wall_arms_type(arms, names, types, table)
                    _:
                        return ""

        # Whether `value` names a local directly. A local's declared type can be narrowed
        # by a `match` arm (docs/81), so a local is only judged across UNRELATED enums.
        def enum_wall_is_local(value: Ast::Expr) -> bool:
            can Abort.Panic:
                match value:
                    Expr.Paren(inner, paren_pos):
                        return enum_wall_is_local(inner)
                    Expr.Ident(name, ident_pos):
                        return true
                    _:
                        return false

        # The enum `value` has when it can never be stored as `type_name`, or "".
        def enum_value_never_fits(value: Ast::Expr, type_name: sview, names: darray[sview]&, types: darray[sview]&, table: SymbolTable&) -> sview:
            can Memory.Allocate, Abort.Panic:
                "" return if not enum_wall_is_firm(table, type_name)
                value_enum: sview = enum_wall_value_type(value, names, types, table)
                "" return if value_enum == "" or enum_wall_assignable(table, value_enum, type_name, 0)
                "" return if enum_wall_is_local(value) and enum_wall_assignable(table, type_name, value_enum, 0)
                return value_enum

        # Two branch enums that share no value: neither is assignable to the other.
        def enum_wall_unrelated(table: SymbolTable&, left: sview, right: sview) -> bool:
            can Abort.Panic:
                false return if left == "" or right == ""
                return not enum_wall_assignable(table, left, right, 0) and not enum_wall_assignable(table, right, left, 0)

        # A variant path value `E.V` / `E.V(...)`: the only arm shape the arm-agreement check
        # judges, since a trailing call in a statement-position arm is a discarded value.
        def enum_wall_is_variant_path(value: Ast::Expr) -> bool:
            can Abort.Panic:
                match value:
                    Expr.Paren(inner, paren_pos):
                        return enum_wall_is_variant_path(inner)
                    Expr.Field(object, field, field_pos):
                        return (object is Expr.Ident(_, _))
                    Expr.Call(callee, arguments, argument_names, call_pos):
                        match callee:
                            Expr.Field(variant_object, variant_name, variant_pos):
                                return (variant_object is Expr.Ident(_, _))
                            _:
                                return false
                    _:
                        return false

        # Match/catch arms yielding enums that share no value: stage0's
        # `match expression arms are incompatible: B and A`, reported at the first arm that
        # disagrees with the first typed arm. For a `catch`, arm 0 is the success arm; when it
        # yields its own binder, its type is `success_enum` (the guarded call's result).
        def check_enum_arms_compatible(arms: darray[Ast::MatchArm], construct: sview, success_enum: sview, names: darray[sview]&, types: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                first_enum: mutable sview = ""
                reported: mutable bool = false
                for arm_index in 0..<arms.count |first_enum, reported, table| -> table:
                    arm: Ast::MatchArm = arms[arm_index]
                    arm_enum: mutable sview = ""
                    arm_value_opt: Ast::Expr? = enum_wall_arm_value(arm)
                    if arm_value_opt is arm_value:
                        if enum_wall_is_variant_path(arm_value):
                            arm_enum <- enum_wall_value_type(arm_value, names, types, table)
                        elif construct == "catch" and arm_index == 0:
                            match arm.pattern:
                                Pattern.Binding(binder):
                                    match arm_value:
                                        Expr.Ident(yielded, yielded_pos):
                                            arm_enum <- success_enum if yielded == binder
                                        _:
                                            pass
                                _:
                                    pass
                    if arm_enum != "" and not reported:
                        if first_enum == "":
                            first_enum <- arm_enum
                        elif enum_wall_unrelated(table, first_enum, arm_enum):
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.MatchArmsIncompatible, name: construct, pos: arm.pos, line: arm.pos.line, expected: first_enum, actual: arm_enum, expected_count: 1})
                            reported <- true
