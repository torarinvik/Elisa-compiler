extend Semantic:
    private:
        # An unresolved static function remains a possible lookup candidate. If it can
        # accept this call, do not borrow the ErrorSet family from a different arm or
        # overload as though winner selection were definite.
        def callable_try_call_has_unresolved_static_function_candidate(file: Ast::File&, module_index: FallibleFunctionModuleIndex&, module_annotations: darray[Ast::EnumAnnotation]&, annotations: darray[Ast::EnumAnnotation]&, try_named_arguments: darray[Ast::EnumAnnotation]&, argument_type_ids: darray[u32]&, receiver_ref_mutability_known: bool, receiver_ref_mutable: bool, name: sview, enclosing_module: sview, callee_qualifier: sview @source, try_offset: u32, call_arity_known: bool, call_arity: u32, table: SymbolTable&) -> bool:
            can Abort.Panic:
                for symbol in table.symbols |module_index, module_annotations, annotations, try_named_arguments, argument_type_ids, name, enclosing_module, callee_qualifier, try_offset, call_arity_known, call_arity, receiver_ref_mutability_known, receiver_ref_mutable, table|:
                    continue if symbol.kind != SymbolKind.Func or symbol.name != name
                    continue if not callable_function_declaration_is_static_unresolved(annotations, name, symbol.module_owner, symbol.line, symbol.offset)
                    continue if not callable_row_visible_for_try_call(module_index, module_annotations, annotations, name, symbol.offset, symbol.line, enclosing_module, callee_qualifier, try_named_arguments, try_offset, table)
                    return true if callable_try_call_forwards_arguments(annotations, try_offset)
                    return true if callable_symbol_accepts_arity(file, table, annotations, try_named_arguments, argument_type_ids, module_index, module_annotations, name, symbol.module_owner, symbol.offset, symbol.line, try_offset, call_arity_known, call_arity, receiver_ref_mutability_known, receiver_ref_mutable, enclosing_module, callee_qualifier)
                return false

        def callable_error_indexed_returns_error(file: Ast::File&, index: CallableErrorAnnotationIndex&, annotations: darray[Ast::EnumAnnotation]&, try_named_arguments: darray[Ast::EnumAnnotation]&, argument_type_ids: darray[u32]&, receiver_ref_mutability_known: bool, receiver_ref_mutable: bool, module_index: FallibleFunctionModuleIndex&, module_annotations: darray[Ast::EnumAnnotation]&, name: sview @source, enclosing_module: sview @source, callee_qualifier: sview @source, scope_known: bool, try_offset: u32, call_arity_known: bool, call_arity: u32, table: SymbolTable&) -> bool:
            can Abort.Panic:
                # Core reports the ambiguous call. Treat its result as potentially fallible
                # solely to suppress a cascading TryRequiresFallible diagnostic; the family
                # lookups below must not select either imported declaration.
                return true if callee_qualifier == "" and callable_wildcard_ambiguous(file, name, enclosing_module, table)
                return true if callable_try_call_has_unresolved_static_function_candidate(file, module_index, module_annotations, annotations, try_named_arguments, argument_type_ids, receiver_ref_mutability_known, receiver_ref_mutable, name, enclosing_module, callee_qualifier, try_offset, call_arity_known, call_arity, table)
                saw_error_return: mutable bool = false
                selected_type_candidate: DeclId = callable_symbol_type_selected_candidate(file, table, annotations, try_named_arguments, module_index, module_annotations, name, enclosing_module, callee_qualifier, try_offset, call_arity, argument_type_ids, receiver_ref_mutability_known, receiver_ref_mutable) if call_arity_known else DeclId{value: INVALID_DECL_ID_VALUE}
                row: mutable u32 = callable_error_index_head(index, name)
                while row != CALLABLE_ERROR_ROW_NONE |row, saw_error_return, selected_type_candidate, annotations, module_annotations, name, enclosing_module, callee_qualifier, try_offset, call_arity_known, call_arity, argument_type_ids, receiver_ref_mutability_known, receiver_ref_mutable, table|:
                    annotation: Ast::EnumAnnotation = annotations[index.source_rows[row.usize()]]
                    if annotation.owner == name and annotation.name == "__error_return":
                        candidate_module: sview = fallible_fn_module_indexed(module_index, module_annotations, annotation.offset, annotation.line)
                        if callable_function_declaration_is_static_inactive(annotations, name, candidate_module, annotation.line, annotation.offset):
                            # Advance before skipping: a bare `continue` re-tests the loop
                            # condition with the same row and never terminates.
                            row <- index.next[row.usize()]
                            continue
                        saw_error_return <- true
                        # An inaccessible selective import already has a primary privacy
                        # error. Keep Try from adding a spurious non-fallible cascade while
                        # the family-selection path continues to exclude the private row.
                        if callee_qualifier == "" and not callable_function_declaration_visible(annotations, name, candidate_module, annotation.line, annotation.offset, enclosing_module) and callable_program_selective_import_row(annotations, name, candidate_module):
                            for binding in annotations:
                                continue if binding.owner != "__from_member" or binding.name != name
                                return true if try_noncall_module_is_ancestor(binding.module, enclosing_module)
                                break
                        if selected_type_candidate.value != INVALID_DECL_ID_VALUE and selected_type_candidate.value.usize() < table.symbols.count:
                            selected_symbol: Symbol = table.symbols[selected_type_candidate.value.usize()]
                            selected_private_winner: bool = selected_symbol.line == annotation.line and selected_symbol.offset == annotation.offset and selected_symbol.module_owner == candidate_module and not callable_function_declaration_visible(annotations, name, candidate_module, annotation.line, annotation.offset, enclosing_module)
                            # Core owns the private-access diagnostic. Preserve fallibility
                            # only to suppress a secondary TryRequiresFallible cascade; the
                            # family-ref path still excludes this inaccessible declaration,
                            # so it cannot leak its ErrorSet into propagation diagnostics.
                            return true if selected_private_winner
                        if callable_try_call_forwards_arguments(annotations, try_offset) and callable_name_has_ufcs_overload_set_candidate(module_index, module_annotations, annotations, name, enclosing_module, callee_qualifier, table):
                            candidate_module: sview = fallible_fn_module_indexed(module_index, module_annotations, annotation.offset, annotation.line)
                            forwarded_private_candidate: bool = callable_row_in_ufcs_candidate_set_indexed(module_index, module_annotations, annotations, name, annotation.offset, annotation.line, enclosing_module, callee_qualifier, table) and not callable_function_declaration_visible(annotations, name, candidate_module, annotation.line, annotation.offset, enclosing_module)
                            # The forwarded argument values are not available for receiver
                            # selection. Treat an inaccessible overloaded candidate as
                            # fallible only to avoid cascading TryRequiresFallible errors.
                            return true if forwarded_private_candidate
                        if selected_type_candidate.value == INVALID_DECL_ID_VALUE and call_arity_known:
                            candidate_module: sview = fallible_fn_module_indexed(module_index, module_annotations, annotation.offset, annotation.line)
                            unresolved_private_candidate: bool = callable_overload_declaration_is_inaccessible_arity_candidate(file, table, annotations, try_named_arguments, argument_type_ids, module_index, module_annotations, name, candidate_module, annotation.offset, annotation.line, enclosing_module, callee_qualifier, try_offset, call_arity, receiver_ref_mutability_known, receiver_ref_mutable)
                            # Preserve fallibility solely to avoid a cascade when Core has
                            # an inaccessible, arity-eligible overload but Try cannot rank
                            # the receiver. Family refs remain fail-closed in this case.
                            return true if unresolved_private_candidate
                        return true if:
                            not scope_known and not call_arity_known
                            callable_row_visible_for_try_call(module_index, module_annotations, annotations, name, annotation.offset, annotation.line, enclosing_module, callee_qualifier, try_named_arguments, try_offset, table) and callable_symbol_accepts_arity(file, table, annotations, try_named_arguments, argument_type_ids, module_index, module_annotations, name, fallible_fn_module_indexed(module_index, module_annotations, annotation.offset, annotation.line), annotation.offset, annotation.line, try_offset, call_arity_known, call_arity, receiver_ref_mutability_known, receiver_ref_mutable, enclosing_module, callee_qualifier)
                    row <- index.next[row.usize()]
                return false if scope_known or call_arity_known
                return saw_error_return

        # Parser producers emit the declared family immediately after its
        # __error_return row, with the same declaration identity. Other rows
        # owned by a callable (contracts, try sites) are not error families.
        def callable_error_indexed_family(index: CallableErrorAnnotationIndex&, annotations: darray[Ast::EnumAnnotation]&, module_index: FallibleFunctionModuleIndex&, module_annotations: darray[Ast::EnumAnnotation]&, name: sview, enclosing_module: sview, callee_qualifier: sview @source, scope_known: bool, table: SymbolTable&) -> sview @source:
            can Abort.Panic:
                fallback: mutable sview @source = ""
                fallback_found: mutable bool = false
                row: mutable u32 = callable_error_index_head(index, name)
                while row != CALLABLE_ERROR_ROW_NONE |row, annotations, module_annotations, name, enclosing_module, callee_qualifier, fallback, fallback_found|:
                    annotation: Ast::EnumAnnotation = annotations[index.source_rows[row.usize()]]
                    if annotation.owner == name and callable_error_family_row(annotations, index.source_rows[row.usize()]):
                        candidate_module: sview = fallible_fn_module_indexed(module_index, module_annotations, annotation.offset, annotation.line)
                        if callable_function_declaration_is_static_inactive(annotations, name, candidate_module, annotation.line, annotation.offset):
                            # Advance before skipping: a bare `continue` re-tests the loop
                            # condition with the same row and never terminates.
                            row <- index.next[row.usize()]
                            continue
                        if not fallback_found and not scope_known:
                            fallback <- annotation.name
                            fallback_found <- true
                        return annotation.name if callable_row_in_scope(annotations, module_annotations, annotation.offset, annotation.line, enclosing_module, callee_qualifier, name, table)
                    row <- index.next[row.usize()]
                return "" if scope_known
                return fallback

        def callable_error_indexed_family_ref(file: Ast::File&, index: CallableErrorAnnotationIndex&, annotations: darray[Ast::EnumAnnotation]&, try_named_arguments: darray[Ast::EnumAnnotation]&, argument_type_ids: darray[u32]&, receiver_ref_mutability_known: bool, receiver_ref_mutable: bool, module_index: FallibleFunctionModuleIndex&, module_annotations: darray[Ast::EnumAnnotation]&, name: sview @source, enclosing_module: sview @source, callee_qualifier: sview @source, scope_known: bool, try_offset: u32, call_arity_known: bool, call_arity: u32, table: mutable SymbolTable&) -> TryErrorFamilyRef:
            can Abort.Panic:
                return TryErrorFamilyRef{family: "", module: "", module_known: false, family_path: "", source_name: "", variant_override: "", declaration_line: 0, declaration_offset: FALLIBLE_FUNCTION_NO_OFFSET, declaration_identity_id: 0, occurrence_offset: 0} if callee_qualifier == "" and callable_wildcard_ambiguous(file, name, enclosing_module, table)
                return TryErrorFamilyRef{family: "", module: "", module_known: false, family_path: "", source_name: "", variant_override: "", declaration_line: 0, declaration_offset: FALLIBLE_FUNCTION_NO_OFFSET, declaration_identity_id: 0, occurrence_offset: 0} if callable_try_call_has_unresolved_static_function_candidate(file, module_index, module_annotations, annotations, try_named_arguments, argument_type_ids, receiver_ref_mutability_known, receiver_ref_mutable, name, enclosing_module, callee_qualifier, try_offset, call_arity_known, call_arity, table)
                fallback: mutable TryErrorFamilyRef = TryErrorFamilyRef{family: "", module: "", module_known: false, family_path: "", source_name: "", variant_override: "", declaration_line: 0, declaration_offset: FALLIBLE_FUNCTION_NO_OFFSET, declaration_identity_id: 0, occurrence_offset: 0}
                fallback_found: mutable bool = false
                row: mutable u32 = callable_error_index_head(index, name)
                while row != CALLABLE_ERROR_ROW_NONE |row, fallback, fallback_found, annotations, module_annotations, module_index, table, name, enclosing_module, callee_qualifier, try_offset, call_arity_known, call_arity, try_named_arguments, argument_type_ids, receiver_ref_mutability_known, receiver_ref_mutable|:
                    source_row: usize = index.source_rows[row.usize()]
                    annotation: Ast::EnumAnnotation = annotations[source_row]
                    if annotation.owner == name and callable_error_family_row(annotations, source_row):
                        candidate_module: sview = fallible_fn_module_indexed(module_index, module_annotations, annotation.offset, annotation.line)
                        if callable_function_declaration_is_static_inactive(annotations, name, candidate_module, annotation.line, annotation.offset):
                            # Advance before skipping: a bare `continue` re-tests the loop
                            # condition with the same row and never terminates.
                            row <- index.next[row.usize()]
                            continue
                        family_path: sview = try_error_family_path_for_declaration(annotations, annotation.name, annotation.line, annotation.offset, annotation.identity_id, annotation.occurrence_offset)
                        candidate_module_known: bool = fallible_fn_module_known(module_annotations, annotation.offset, annotation.line)
                        family_ref: TryErrorFamilyRef = try_error_family_ref_for_annotation(annotations, annotation, family_path, candidate_module_known, candidate_module, table)
                        if not fallback_found:
                            fallback <- family_ref
                            fallback_found <- true
                        if callable_row_visible_for_try_call(module_index, module_annotations, annotations, name, annotation.offset, annotation.line, enclosing_module, callee_qualifier, try_named_arguments, try_offset, table) and callable_symbol_accepts_arity(file, table, annotations, try_named_arguments, argument_type_ids, module_index, module_annotations, name, candidate_module, annotation.offset, annotation.line, try_offset, call_arity_known, call_arity, receiver_ref_mutability_known, receiver_ref_mutable, enclosing_module, callee_qualifier):
                            return family_ref
                    row <- index.next[row.usize()]
                return TryErrorFamilyRef{family: "", module: "", module_known: false, family_path: "", source_name: "", variant_override: "", declaration_line: 0, declaration_offset: FALLIBLE_FUNCTION_NO_OFFSET, declaration_identity_id: 0, occurrence_offset: 0} if scope_known or call_arity_known
                return fallback

        # A composite `error[A, B]` has one compact marker/name pair for lookup, while
        # the captured rows contain every return family at that occurrence. Resolve the
        # declaration once, then return all of its captured families so none are dropped.
        def callable_error_indexed_family_refs(file: Ast::File&, index: CallableErrorAnnotationIndex&, annotations: darray[Ast::EnumAnnotation]&, try_named_arguments: darray[Ast::EnumAnnotation]&, argument_type_ids: darray[u32]&, receiver_ref_mutability_known: bool, receiver_ref_mutable: bool, module_index: FallibleFunctionModuleIndex&, module_annotations: darray[Ast::EnumAnnotation]&, name: sview @source, enclosing_module: sview @source, callee_qualifier: sview @source, scope_known: bool, try_offset: u32, call_arity_known: bool, call_arity: u32, table: mutable SymbolTable&) -> (families: darray[TryErrorFamilyRef], ambiguous: bool):
            can Memory.Allocate, Abort.Panic:
                return ([], true) if callee_qualifier == "" and callable_wildcard_ambiguous(file, name, enclosing_module, table)
                return ([], true) if callable_try_call_has_unresolved_static_function_candidate(file, module_index, module_annotations, annotations, try_named_arguments, argument_type_ids, receiver_ref_mutability_known, receiver_ref_mutable, name, enclosing_module, callee_qualifier, try_offset, call_arity_known, call_arity, table)
                selected: mutable bool = false
                ambiguous: mutable bool = false
                selected_line: mutable u32 = 0
                selected_offset: mutable u32 = 0
                selected_identity_id: mutable u32 = 0
                selected_occurrence_offset: mutable u32 = 0
                fallback: mutable bool = false
                fallback_line: mutable u32 = 0
                fallback_offset: mutable u32 = 0
                fallback_identity_id: mutable u32 = 0
                fallback_occurrence_offset: mutable u32 = 0
                row: mutable u32 = callable_error_index_head(index, name)
                while row != CALLABLE_ERROR_ROW_NONE |row, annotations, module_annotations, module_index, index, name, enclosing_module, callee_qualifier, scope_known, try_offset, call_arity_known, call_arity, argument_type_ids, receiver_ref_mutability_known, receiver_ref_mutable, try_named_arguments, table, selected, ambiguous, selected_line, selected_offset, selected_identity_id, selected_occurrence_offset, fallback, fallback_line, fallback_offset, fallback_identity_id, fallback_occurrence_offset|:
                    source_row: usize = index.source_rows[row.usize()]
                    annotation: Ast::EnumAnnotation = annotations[source_row]
                    if annotation.owner == name and callable_error_family_row(annotations, source_row):
                        candidate_module: sview = fallible_fn_module_indexed(module_index, module_annotations, annotation.offset, annotation.line)
                        if callable_function_declaration_is_static_inactive(annotations, name, candidate_module, annotation.line, annotation.offset):
                            # Advance before skipping: a bare `continue` re-tests the loop
                            # condition with the same row and never terminates.
                            row <- index.next[row.usize()]
                            continue
                        if not fallback:
                            fallback <- true
                            fallback_line <- annotation.line
                            fallback_offset <- annotation.offset
                            fallback_identity_id <- annotation.identity_id
                            fallback_occurrence_offset <- annotation.occurrence_offset
                        visible: bool = callable_row_visible_for_try_call(module_index, module_annotations, annotations, name, annotation.offset, annotation.line, enclosing_module, callee_qualifier, try_named_arguments, try_offset, table) and callable_symbol_accepts_arity(file, table, annotations, try_named_arguments, argument_type_ids, module_index, module_annotations, name, candidate_module, annotation.offset, annotation.line, try_offset, call_arity_known, call_arity, receiver_ref_mutability_known, receiver_ref_mutable, enclosing_module, callee_qualifier)
                        if visible:
                            if call_arity_known and callable_symbol_arity_candidate_count(file, table, annotations, try_named_arguments, argument_type_ids, module_index, module_annotations, name, try_offset, call_arity, receiver_ref_mutability_known, receiver_ref_mutable, enclosing_module, callee_qualifier) > 1.usize():
                                ambiguous <- true
                            same_declaration: bool = annotation.line == selected_line and annotation.offset == selected_offset and annotation.identity_id == selected_identity_id and annotation.occurrence_offset == selected_occurrence_offset
                            if not selected:
                                selected <- true
                                selected_line <- annotation.line
                                selected_offset <- annotation.offset
                                selected_identity_id <- annotation.identity_id
                                selected_occurrence_offset <- annotation.occurrence_offset
                            elif not same_declaration:
                                ambiguous <- true
                    row <- index.next[row.usize()]
                if not selected:
                    return ([], false) if scope_known or call_arity_known or not fallback
                    selected_line <- fallback_line
                    selected_offset <- fallback_offset
                    selected_identity_id <- fallback_identity_id
                    selected_occurrence_offset <- fallback_occurrence_offset
                return ([], true) if ambiguous
                candidate_module: sview = fallible_fn_module_indexed(module_index, module_annotations, selected_offset, selected_line)
                candidate_module_known: bool = fallible_fn_module_known(module_annotations, selected_offset, selected_line)
                families: mutable darray[TryErrorFamilyRef] = []
                for family_index in 0..<annotations.count |families, annotations, selected_line, selected_offset, selected_identity_id, selected_occurrence_offset, candidate_module, candidate_module_known, table|:
                    family_annotation: Ast::EnumAnnotation = annotations[family_index]
                    continue if family_annotation.owner != "__error_set_family" or family_annotation.line != selected_line or family_annotation.offset != selected_offset or family_annotation.identity_id != selected_identity_id or family_annotation.occurrence_offset != selected_occurrence_offset
                    family_path: sview = try_error_family_path_for_row(annotations, family_index)
                    families.push(try_error_family_ref_for_annotation(annotations, family_annotation, family_path, candidate_module_known, candidate_module, table))
                return (families, false)

        # The module a fallible function was declared in, keyed by the declaration's byte
        # offset (the same key the destination side already uses).
        # Matched by OFFSET when both sides carry one and by LINE otherwise — the same rule
        # the destination (`__error_set_family`) lookup uses. Offset alone silently missed
        # every enclosing function the symbol table recorded without one.
        def fallible_fn_module(annotations: darray[Ast::EnumAnnotation]&, declaration_offset: u32, declaration_line: u32) -> sview:
            fallback_module: mutable sview = ""
            fallback_count: mutable usize = 0.usize()
            for module_annotation in annotations |declaration_offset, declaration_line|:
                continue if module_annotation.owner != "__fn_module" or module_annotation.line != declaration_line
                if declaration_offset != FALLIBLE_FUNCTION_NO_OFFSET and module_annotation.offset == declaration_offset:
                    return module_annotation.name
                if declaration_offset == FALLIBLE_FUNCTION_NO_OFFSET or module_annotation.offset == FALLIBLE_FUNCTION_NO_OFFSET:
                    fallback_module <- module_annotation.name if fallback_count == 0.usize()
                    fallback_count <- fallback_count + 1.usize()
            return fallback_module if fallback_count == 1.usize()
            return ""

        def fallible_fn_module_indexed(index: FallibleFunctionModuleIndex&, module_annotations: darray[Ast::EnumAnnotation]&, declaration_offset: u32, declaration_line: u32) -> sview @source:
            can Abort.Panic:
                if declaration_offset == FALLIBLE_FUNCTION_NO_OFFSET:
                    return module_annotations[row.usize()].name if index.by_line.get(declaration_line.u64()) is row and row != CALLABLE_ERROR_ROW_NONE
                    return ""
                offset_row: mutable u32 = CALLABLE_ERROR_ROW_NONE
                unknown_offset_line_row: mutable u32 = CALLABLE_ERROR_ROW_NONE
                if index.by_offset.get(declaration_offset.u64()) is found_offset_row:
                    offset_row <- found_offset_row
                if index.unknown_offset_by_line.get(declaration_line.u64()) is found_unknown_line_row:
                    unknown_offset_line_row <- found_unknown_line_row
                return module_annotations[offset_row.usize()].name if offset_row != CALLABLE_ERROR_ROW_NONE and module_annotations[offset_row.usize()].line == declaration_line
                return module_annotations[unknown_offset_line_row.usize()].name if unknown_offset_line_row != CALLABLE_ERROR_ROW_NONE
                return ""

        def fallible_fn_module_known(module_annotations: darray[Ast::EnumAnnotation]&, declaration_offset: u32, declaration_line: u32) -> bool:
            can Abort.Panic:
                fallback_count: mutable usize = 0.usize()
                for module_annotation in module_annotations |declaration_offset, declaration_line|:
                    continue if module_annotation.owner != "__fn_module" or module_annotation.line != declaration_line
                    return true if declaration_offset != FALLIBLE_FUNCTION_NO_OFFSET and module_annotation.offset == declaration_offset
                    fallback_count <- fallback_count + 1.usize() if declaration_offset == FALLIBLE_FUNCTION_NO_OFFSET or module_annotation.offset == FALLIBLE_FUNCTION_NO_OFFSET
                return fallback_count == 1.usize()

        def try_error_set_decl_exists(annotations: darray[Ast::EnumAnnotation]&, family: sview) -> bool:
            can Abort.Panic:
                return any row in annotations where row.owner == "__error_set_decl" and row.name == family

        def try_error_set_decl_has_owner(annotations: darray[Ast::EnumAnnotation]&, family: sview, module: sview) -> bool:
            can Abort.Panic:
                return any row in annotations where row.owner == "__error_set_decl" and row.name == family and row.module == module

        # Core resolves a visible local type before imported type names. If that
        # declaration is not an error set, a bare error item can still resolve as a
        # unique variant; an imported same-leaf error set must not take precedence.
        def try_error_local_nominal_type_shadows_family(annotations: darray[Ast::EnumAnnotation]&, name: sview, module: sview @source, table: mutable SymbolTable&) -> bool:
            can Abort.Panic:
                # Core checks the unqualified root name in namedTypes before its
                # namespace/import candidates, so a root error set keeps precedence.
                return false if try_error_set_decl_has_owner(annotations, name, "")
                root_alias: mutable bool = false
                root_nominal: mutable bool = false
                for symbol in table.symbols |root_alias, root_nominal, annotations, name, module, table|:
                    continue if symbol.name != name or symbol.module_owner != ""
                    root_alias <- true if symbol.kind == SymbolKind.Alias
                    root_nominal <- true if symbol.kind == SymbolKind.Struct or symbol.kind == SymbolKind.Enum or (symbol.kind == SymbolKind.Extern and symbol.opaque_extern_type)
                return not try_error_local_alias_targets_error_set(annotations, name, "", table) if root_alias
                return true if root_nominal
                scope_module: mutable sview @source = module
                while true |scope_module, annotations, name, module, table|:
                    # The nearest lexical declaration wins before imports. An error set
                    # in this scope is handled by the family resolver; otherwise a
                    # nominal type here blocks a same-named imported family and allows
                    # unique bare-variant fallback.
                    return false if try_error_set_decl_has_owner(annotations, name, scope_module)
                    local_alias: mutable bool = false
                    local_nominal: mutable bool = false
                    for symbol in table.symbols |local_alias, local_nominal, name, scope_module, module, table|:
                        continue if symbol.name != name or symbol.module_owner != scope_module
                        local_alias <- true if symbol.kind == SymbolKind.Alias
                        local_nominal <- true if symbol.kind == SymbolKind.Struct or symbol.kind == SymbolKind.Enum
                        local_nominal <- true if symbol.kind == SymbolKind.Extern and symbol.opaque_extern_type
                    return not try_error_local_alias_targets_error_set(annotations, name, scope_module, table) if local_alias
                    return true if local_nominal
                    break if scope_module == ""
                    scope_module <- try_noncall_module_parent(scope_module)
                return false

        def try_error_set_import_path_matches(annotations: darray[Ast::EnumAnnotation]&, raw_module: sview @source, import_module: sview @source, import_line: u32, import_offset: u32, function_module: sview @source, declaration_module: sview @source, scope_bound: bool) -> bool:
            can Abort.Panic:
                return false if scope_bound and not catch_module_is_ancestor(import_module, function_module)
                # Core qualifies the import's raw module path against its enclosing
                # namespace. A `using ... as ...` alias does not rewrite an import target.
                return catch_module_path_matches_relative(import_module, raw_module, declaration_module) if import_module != ""
                return catch_module_path_matches(raw_module, declaration_module)

        def try_error_set_decl_imported_at_scope(annotations: darray[Ast::EnumAnnotation]&, declaration: Ast::EnumAnnotation, scope_module: sview @source, function_module: sview @source) -> bool:
            can Abort.Panic:
                return false if not try_error_alias_module_visible(annotations, declaration.module, function_module)
                for import_row in annotations |annotations, declaration, scope_module, function_module|:
                    continue if import_row.module != scope_module or import_row.name != "__binding_wildcard_import"
                    return true if try_error_set_import_path_matches(annotations, import_row.owner, scope_module, import_row.line, import_row.offset, function_module, declaration.module, true)
                if scope_module == "":
                    for import_row in annotations |annotations, declaration, scope_module, function_module|:
                        continue if import_row.owner != "__from_member" or import_row.name != declaration.name
                        for source_row in annotations |annotations, declaration, import_row, scope_module, function_module|:
                            continue if source_row.owner != "__from_src" or source_row.module != import_row.module or source_row.line != import_row.line or source_row.offset != import_row.offset
                            return try_error_set_import_path_matches(annotations, source_row.name, import_row.module, import_row.line, import_row.offset, function_module, declaration.module, false)
                return false

        # Preserve the complete alias target AST when deciding whether a nominal alias
        # names an ErrorSetType. The compact projection intentionally drops qualified
        # paths, while recursive aliases need a finite bound even before cycle diagnostics
        # are emitted by type resolution.
        def try_error_alias_target_path(expression: Ast::Expr, table: mutable SymbolTable&) -> sview @source can[Memory.Allocate, Abort.Panic]:
            match expression:
                Expr.Ident(name, _):
                    return name
                Expr.Scope(base, name, _):
                    prefix: sview @source = try_error_alias_target_path(base, table)
                    return "" if prefix == ""
                    can Abort.Panic, Memory.Allocate:
                        bytes: mutable darray[u8] = []
                        bytes.reserve(prefix.len + 2.usize() + name.len)
                        for index in 0..<prefix.len |bytes, prefix|:
                            bytes.push(prefix[index])
                        bytes.push(58)
                        bytes.push(58)
                        for index in 0..<name.len |bytes, name|:
                            bytes.push(name[index])
                        return intern_joined_text(bytes, table)
                Expr.Paren(inner, _):
                    return try_error_alias_target_path(inner, table)
                _:
                    return ""

        def try_error_alias_index(alias_name: sview, alias_module: sview, table: SymbolTable&) -> (found: bool, index: usize):
            can Abort.Panic:
                selected: mutable usize = 0.usize()
                count: mutable usize = 0.usize()
                for index in 0..<table.type_alias_name.count |selected, count, alias_name, alias_module, table|:
                    continue if table.type_alias_name[index] != alias_name or index >= table.type_alias_module.count or table.type_alias_module[index] != alias_module
                    selected <- index
                    count <- count + 1.usize()
                return (count == 1.usize() and selected < table.type_alias_declarations.count, selected)

        def try_error_alias_local_non_error_type_exists(name: sview, module: sview, table: SymbolTable&) -> bool:
            can Abort.Panic:
                for symbol in table.symbols |name, module, table|:
                    continue if symbol.name != name or symbol.module_owner != module
                    return true if symbol.kind == SymbolKind.Struct or symbol.kind == SymbolKind.Enum or (symbol.kind == SymbolKind.Extern and symbol.opaque_extern_type)
                return false

        def try_error_alias_declaration_identity(annotations: darray[Ast::EnumAnnotation]&, alias_index: usize, table: mutable SymbolTable&, visited: mutable darray[u32]&) -> (found: bool, family: sview @source, module: sview @source, ambiguous: bool) can[Memory.Allocate, Abort.Panic]:
            can Memory.Allocate, Abort.Panic:
                return (false, "", "", false) if alias_index >= table.type_alias_declarations.count
                declaration: TypeAliasDeclaration = table.type_alias_declarations[alias_index]
                return (false, "", "", false) if any prior_id in visited where prior_id == declaration.declaration_id.value
                visited <- visited.push(declaration.declaration_id.value)
                result: (found: bool, family: sview @source, module: sview @source, ambiguous: bool) = try_error_alias_target_identity(annotations, declaration.target, declaration.module_owner, declaration.pos, table, visited)
                _ = visited.pop()
                return result

        # This predicate only compares path slices while the call is active; it does not
        # retain any path view in an annotation or result. Accept ordinary borrowed views so
        # callers do not have to claim source lifetime for Symbol.module_owner values.
        def try_error_alias_module_visible(annotations: darray[Ast::EnumAnnotation]&, candidate_module: sview, lexical_module: sview) -> bool:
            can Abort.Panic:
                segment_start: mutable usize = 0.usize()
                while segment_start < candidate_module.len |segment_start, candidate_module, annotations, lexical_module|:
                    segment_end: mutable usize = segment_start
                    while segment_end < candidate_module.len and candidate_module[segment_end] != 58 |segment_end, candidate_module|:
                        segment_end <- segment_end + 1.usize()
                    segment: sview = candidate_module[segment_start:segment_end]
                    owner: sview = candidate_module[0:segment_start - 2.usize()] if segment_start >= 2.usize() else ""
                    for index in 0..<annotations.count |annotations, candidate_module, lexical_module, segment_end, segment, owner|:
                        if annotations[index].owner == "__section_private" and annotations[index].name == segment and annotations[index].module == owner:
                            private_scope: sview = candidate_module[0:segment_end]
                            return catch_module_is_ancestor(private_scope, lexical_module)
                    break if segment_end == candidate_module.len
                    next_start: usize = segment_end + 2.usize()
                    return false if next_start >= candidate_module.len or candidate_module[segment_end + 1.usize()] != 58
                    segment_start <- next_start
                return true

        def try_error_alias_module_path_matches(path: sview @source, family: sview @source, alias_module: sview @source, alias_line: u32, candidate_module: sview @source, annotations: darray[Ast::EnumAnnotation]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                return false if not try_error_alias_module_visible(annotations, candidate_module, alias_module)
                return false if path.len < family.len
                family_start: usize = path.len - family.len
                return false if not catch_module_path_matches(path[family_start:path.len], family)
                separator: usize = catch_family_separator_start(path, family_start)
                return false if separator == path.len
                raw_module: sview @source = path[0:separator]
                alias_target: (found: bool, uncertain: bool, module: sview @source, scope: sview @source, suffixes: darray[sview @source]) = catch_module_qualifier_alias_target(annotations, raw_module, alias_module, alias_line, 4294967295)
                return false if alias_target.uncertain
                return catch_module_alias_path_matches(alias_target.module, alias_target.scope, alias_target.suffixes, candidate_module) if alias_target.found
                return catch_module_path_matches(raw_module, candidate_module)

        def try_error_alias_is_private(annotations: darray[Ast::EnumAnnotation]&, alias_name: sview, alias_module: sview) -> bool:
            can Abort.Panic:
                return any row in annotations where row.owner == "__section_private" and row.name == alias_name and row.module == alias_module

        def try_error_alias_name_visible(annotations: darray[Ast::EnumAnnotation]&, alias_name: sview, alias_module: sview @source, lexical_module: sview @source) -> bool:
            can Abort.Panic:
                return true if not try_error_alias_is_private(annotations, alias_name, alias_module)
                return catch_module_is_ancestor(alias_module, lexical_module)

        def try_error_alias_imported_at_scope(annotations: darray[Ast::EnumAnnotation]&, name: sview @source, declaration_module: sview @source, scope_module: sview @source, function_module: sview @source) -> bool:
            can Abort.Panic:
                return false if not try_error_alias_module_visible(annotations, declaration_module, function_module)
                return false if not try_error_alias_name_visible(annotations, name, declaration_module, function_module)
                for import_row in annotations |annotations, name, declaration_module, scope_module, function_module|:
                    continue if import_row.module != scope_module or import_row.name != "__binding_wildcard_import"
                    return true if try_error_set_import_path_matches(annotations, import_row.owner, scope_module, import_row.line, import_row.offset, function_module, declaration_module, true)
                if scope_module == "":
                    for import_row in annotations |annotations, name, declaration_module, scope_module, function_module|:
                        continue if import_row.owner != "__from_member" or import_row.name != name
                        for source_row in annotations |annotations, import_row, declaration_module, scope_module, function_module|:
                            continue if source_row.owner != "__from_src" or source_row.module != import_row.module or source_row.line != import_row.line or source_row.offset != import_row.offset
                            return try_error_set_import_path_matches(annotations, source_row.name, import_row.module, import_row.line, import_row.offset, function_module, declaration_module, false)
                return false

        def try_error_alias_target_identity(annotations: darray[Ast::EnumAnnotation]&, target: Ast::Expr, alias_module: sview @source, alias_pos: Ast::Pos, table: mutable SymbolTable&, visited: mutable darray[u32]&) -> (found: bool, family: sview @source, module: sview @source, ambiguous: bool) can[Memory.Allocate, Abort.Panic]:
            can Memory.Allocate, Abort.Panic:
                target_path: sview @source = try_error_alias_target_path(target, table)
                return (false, "", "", false) if target_path == ""
                target_family: sview @source = module_last_segment(target_path)
                return (false, "", "", false) if target_family == ""
                if catch_first_module_separator_start(target_path) != target_path.len:
                    selected_family: mutable sview @source = ""
                    selected_module: mutable sview @source = ""
                    selected_alias: mutable usize = 0.usize()
                    direct_count: mutable usize = 0.usize()
                    alias_count: mutable usize = 0.usize()
                    for declaration in annotations |selected_family, selected_module, direct_count, target_path, target_family, alias_module, alias_pos, annotations|:
                        continue if declaration.owner != "__error_set_decl" or declaration.name != target_family
                        continue if not try_error_alias_module_path_matches(target_path, target_family, alias_module, alias_pos.line, declaration.module, annotations)
                        if direct_count == 0.usize():
                            selected_family <- declaration.name
                            selected_module <- declaration.module
                            direct_count <- 1.usize()
                        elif declaration.module != selected_module:
                            direct_count <- direct_count + 1.usize()
                    for index in 0..<table.type_alias_name.count |selected_alias, alias_count, target_path, target_family, alias_module, alias_pos, table, annotations|:
                        continue if table.type_alias_name[index] != target_family or index >= table.type_alias_declarations.count
                        alias_declaration: TypeAliasDeclaration = table.type_alias_declarations[index]
                        continue if not try_error_alias_module_path_matches(target_path, target_family, alias_module, alias_pos.line, alias_declaration.module_owner, annotations)
                        continue if not try_error_alias_name_visible(annotations, target_family, alias_declaration.module_owner, alias_module)
                        selected_alias <- index
                        alias_count <- alias_count + 1.usize()
                    return (true, selected_family, selected_module, false) if direct_count == 1.usize() and alias_count == 0.usize()
                    return (false, "", "", true) if direct_count > 1.usize() or alias_count > 1.usize() or (direct_count > 0.usize() and alias_count > 0.usize())
                    return try_error_alias_declaration_identity(annotations, selected_alias, table, visited) if alias_count == 1.usize()
                    return (false, "", "", false)
                # Core checks the exact root type before lexical and imported candidates.
                return (true, target_family, "", false) if try_error_set_decl_has_owner(annotations, target_family, "")
                root_alias: (found: bool, index: usize) = try_error_alias_index(target_family, "", table)
                if root_alias.found:
                    return try_error_alias_declaration_identity(annotations, root_alias.index, table, visited)
                return (false, "", "", false) if try_error_alias_local_non_error_type_exists(target_family, "", table)
                lexical_module: mutable sview @source = alias_module
                lexical_alias_index: mutable usize = 0.usize()
                lexical_alias_found: mutable bool = false
                while true |lexical_module, annotations, target_family, alias_module, table|:
                    return (true, target_family, lexical_module, false) if try_error_set_decl_has_owner(annotations, target_family, lexical_module)
                    lexical_alias: (found: bool, index: usize) = try_error_alias_index(target_family, lexical_module, table)
                    if lexical_alias.found:
                        lexical_alias_index <- lexical_alias.index
                        lexical_alias_found <- true
                        break
                    return (false, "", "", false) if try_error_alias_local_non_error_type_exists(target_family, lexical_module, table)
                    break if lexical_module == ""
                    lexical_module <- try_noncall_module_parent(lexical_module)
                return try_error_alias_declaration_identity(annotations, lexical_alias_index, table, visited) if lexical_alias_found
                import_scope: mutable sview @source = alias_module
                selected_imported_module: mutable sview @source = ""
                selected_imported_family: mutable sview @source = ""
                selected_imported_alias_index: mutable usize = 0.usize()
                selected_imported_count: mutable usize = 0.usize()
                selected_imported_alias_count: mutable usize = 0.usize()
                selected_imported_ambiguous: mutable bool = false
                while true |import_scope, annotations, target_family, alias_module, table, selected_imported_module, selected_imported_family, selected_imported_alias_index, selected_imported_count, selected_imported_alias_count, selected_imported_ambiguous|:
                    imported_module: mutable sview @source = ""
                    imported_family: mutable sview @source = ""
                    imported_count: mutable usize = 0.usize()
                    imported_alias_index: mutable usize = 0.usize()
                    imported_alias_count: mutable usize = 0.usize()
                    for declaration in annotations |annotations, target_family, import_scope, alias_module, table|:
                        continue if declaration.owner != "__error_set_decl" or declaration.name != target_family or esh_error_set_decl_is_private(annotations, declaration)
                        if try_error_set_decl_imported_at_scope(annotations, declaration, import_scope, alias_module):
                            if imported_count == 0.usize():
                                imported_module <- declaration.module
                                imported_family <- declaration.name
                                imported_count <- 1.usize()
                            elif declaration.module != imported_module:
                                imported_count <- imported_count + 1.usize()
                    for index in 0..<table.type_alias_name.count |imported_alias_index, imported_alias_count, target_family, import_scope, alias_module, table, annotations|:
                        continue if table.type_alias_name[index] != target_family or index >= table.type_alias_declarations.count
                        alias_declaration: TypeAliasDeclaration = table.type_alias_declarations[index]
                        continue if not try_error_alias_imported_at_scope(annotations, target_family, alias_declaration.module_owner, import_scope, alias_module)
                        imported_alias_index <- index
                        imported_alias_count <- imported_alias_count + 1.usize()
                    if imported_count > 0.usize() or imported_alias_count > 0.usize():
                        selected_imported_module <- imported_module
                        selected_imported_family <- imported_family
                        selected_imported_alias_index <- imported_alias_index
                        selected_imported_count <- imported_count
                        selected_imported_alias_count <- imported_alias_count
                        selected_imported_ambiguous <- imported_count > 1.usize() or imported_alias_count > 1.usize() or (imported_count > 0.usize() and imported_alias_count > 0.usize())
                        break
                    break if import_scope == ""
                    import_scope <- try_noncall_module_parent(import_scope)
                return (false, "", "", true) if selected_imported_ambiguous
                return try_error_alias_declaration_identity(annotations, selected_imported_alias_index, table, visited) if selected_imported_alias_count == 1.usize()
                return (true, selected_imported_family, selected_imported_module, false) if selected_imported_count == 1.usize()
                return (false, "", "", false)

