# Typestate transition flow (stage0 typestate arg-state checking). A `typestate File:` with
# `transition read_file: Open -> Open` requires its subject be in the `Open` state when
# read_file is called. Each typestate value tracks a current state plus a `diverged` flag
# (set when branch arms leave it in different states — a `Alive | Dead` union). Calling a
# transition whose from-state is not the value's proven single state is rejected:
#
#   def bad(f: mutable File[Closed]&):
#       open_file(f)     # Closed -> Open : f = Open
#       close_file(f)    # Open -> Closed : f = Closed
#       read_file(f)     # requires Open, f = Closed -> error
#
# The subject can be proven in state S only when it is a non-diverged singleton == S. A
# diverged value (post-branch union of differing states) can never satisfy a transition.
# The parser records per transition: target (3900000005), source (3900000052), and owning
# typestate type (3900000053); a subject's initial state comes from its `File[Closed]` param.
extend Semantic:
    private:
        def tsf_transition_attr(annotations: darray[Ast::EnumAnnotation]&, transition: sview, sentinel: u32) -> sview:
            can Abort.Panic:
                for annotation in annotations:
                    annotation.name return if annotation.owner == transition and annotation.line == sentinel
                return sview("", 0, 0)

        def tsf_is_transition(annotations: darray[Ast::EnumAnnotation]&, name: sview) -> bool:
            can Abort.Panic:
                for annotation in annotations:
                    true return if annotation.owner == name and annotation.line == 3900000053
                return false

        def tsf_name_in(names: darray[sview]&, wanted: sview) -> bool:
            can Abort.Panic:
                for entry in names:
                    true return if entry == wanted
                return false

        # The typestate type + initial state of a parameter annotated `T[State]` (peeling
        # mutable/ref wrappers), or ("","").
        def tsf_param_typestate(type_expression: Ast::Expr) -> (type_name: sview, state: sview):
            can Memory.Allocate, Abort.Panic:
                match type_expression:
                    Expr.Unary(operator, operand, unary_line):
                        return tsf_param_typestate(operand)
                    Expr.Paren(inner, paren_line):
                        return tsf_param_typestate(inner)
                    Expr.Index(head, argument, index_line):
                        return (ident_name_of(head), ident_name_of(argument))
                    Expr.IndexN(head, arguments, indexn_line):
                        return (ident_name_of(head), ident_name_of(arguments[0]) if arguments.count > 0 else sview("", 0, 0))
                    _:
                        return (sview("", 0, 0), sview("", 0, 0))

        def tsf_index_of(names: darray[sview]&, name: sview) -> usize:
            can Abort.Panic:
                probe: mutable usize = names.count
                index: mutable usize = 0
                while index < names.count |index, probe|:
                    probe <- index if names[index] == name and probe == names.count
                    index <- index + 1
                return probe

        # Root ident of a transition subject argument (`f`, `&f`, `(f)`).
        def tsf_subject_root(argument: Ast::Expr) -> sview:
            can Memory.Allocate, Abort.Panic:
                return match argument:
                    Expr.Ident(name, ident_line): name
                    Expr.Unary(operator, operand, unary_line): tsf_subject_root(operand)
                    Expr.Paren(inner, paren_line): tsf_subject_root(inner)
                    _: sview("", 0, 0)

        def tsf_call_info(expression: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&) -> (found: bool, transition: sview, subject: sview):
            can Memory.Allocate, Abort.Panic:
                if expression is Expr.Call(callee, arguments, argument_names, call_line):
                    transition: sview = ident_name_of(callee)
                    if transition != "" and tsf_is_transition(annotations, transition) and arguments.count > 0:
                        return (true, transition, tsf_subject_root(arguments[0]))
                return (false, sview("", 0, 0), sview("", 0, 0))

        # Apply a transition call: flag when the subject is not a proven singleton in the
        # from-state, then move the subject to the to-state.
        def tsf_apply(expression: Ast::Expr, line: u32, annotations: darray[Ast::EnumAnnotation]&, subj_names: darray[sview]&, subj_state: mutable darray[sview]&, subj_diverged: mutable darray[bool]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                info: (found: bool, transition: sview, subject: sview) = tsf_call_info(expression, annotations)
                if info.found:
                    index: usize = tsf_index_of(subj_names, info.subject)
                    if index < subj_names.count:
                        from_state: sview = tsf_transition_attr(annotations, info.transition, 3900000052)
                        to_state: sview = tsf_transition_attr(annotations, info.transition, 3900000005)
                        mismatched: bool = from_state != "" and (subj_diverged[index] or subj_state[index] != from_state)
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.TypestateArgMismatch, name: info.transition, line: line, expected: from_state, actual: subj_state[index]}) if mismatched
                        if to_state != "":
                            subj_state[index] <- to_state
                            subj_diverged[index] <- false

        def tsf_walk(statements: darray[Ast::Stmt], annotations: darray[Ast::EnumAnnotation]&, subj_names: darray[sview]&, subj_state: mutable darray[sview]&, subj_diverged: mutable darray[bool]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |subj_state, subj_diverged, table| -> table:
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- tsf_apply(expression, line, annotations, subj_names, subj_state, subj_diverged, table)
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- tsf_apply(value, line, annotations, subj_names, subj_state, subj_diverged, table)
                        Stmt.Assign(target, operator, value, line):
                            table <- tsf_apply(value, line, annotations, subj_names, subj_state, subj_diverged, table)
                        Stmt.Return(value, line):
                            table <- tsf_apply(returned, line, annotations, subj_names, subj_state, subj_diverged, table) if value is returned
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- tsf_walk(body, annotations, subj_names, subj_state, subj_diverged, table)
                        Stmt.If(condition, then_body, else_body, line):
                            base_state: darray[sview] = [entry for entry in subj_state]
                            base_diverged: darray[bool] = [flag for flag in subj_diverged]
                            table <- tsf_walk(then_body, annotations, subj_names, subj_state, subj_diverged, table)
                            then_state: darray[sview] = [entry for entry in subj_state]
                            then_diverged: darray[bool] = [flag for flag in subj_diverged]
                            reset_i: mutable usize = 0
                            while reset_i < subj_state.count |reset_i, subj_state, subj_diverged, base_state, base_diverged|:
                                subj_state[reset_i] <- base_state[reset_i]
                                subj_diverged[reset_i] <- base_diverged[reset_i]
                                reset_i <- reset_i + 1
                            table <- tsf_walk(else_body, annotations, subj_names, subj_state, subj_diverged, table)
                            merge_i: mutable usize = 0
                            while merge_i < subj_state.count |merge_i, subj_state, subj_diverged, then_state, then_diverged|:
                                diverges: bool = then_diverged[merge_i] or subj_diverged[merge_i] or then_state[merge_i] != subj_state[merge_i]
                                subj_diverged[merge_i] <- diverges
                                subj_state[merge_i] <- sview("", 0, 0) if diverges
                                merge_i <- merge_i + 1
                        Stmt.While(condition, while_body, line):
                            body_state: darray[sview] = [entry for entry in subj_state]
                            body_diverged: darray[bool] = [flag for flag in subj_diverged]
                            table <- tsf_walk(while_body, annotations, subj_names, subj_state, subj_diverged, table)
                            loop_i: mutable usize = 0
                            while loop_i < subj_state.count |loop_i, subj_state, subj_diverged, body_state, body_diverged|:
                                loop_div: bool = body_diverged[loop_i] or subj_diverged[loop_i] or body_state[loop_i] != subj_state[loop_i]
                                subj_diverged[loop_i] <- loop_div
                                subj_state[loop_i] <- sview("", 0, 0) if loop_div
                                loop_i <- loop_i + 1
                        Stmt.For(bind, variables, iterable, for_body, line):
                            table <- tsf_walk(for_body, annotations, subj_names, subj_state, subj_diverged, table)
                        Stmt.Match(scrutinee, arms, line):
                            # Walk each arm (transitions inside are still checked), then treat
                            # the subject as diverged — arms can leave differing states.
                            for arm in arms |subj_state, subj_diverged, table| -> table:
                                table <- tsf_walk(arm.body, annotations, subj_names, subj_state, subj_diverged, table)
                            diverge_all: mutable usize = 0
                            while diverge_all < subj_diverged.count |diverge_all, subj_diverged|:
                                subj_diverged[diverge_all] <- true
                                diverge_all <- diverge_all + 1
                        _:
                            pass

        def tsf_typestate_type_names(annotations: darray[Ast::EnumAnnotation]&, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for annotation in annotations:
                    out.push(annotation.name) if annotation.line == 3900000053 and not tsf_name_in(out, annotation.name)

        # Collect typestate LOCALS declared in the body (`f: mutable File[Closed] = ...`),
        # tracked from function entry with their declared initial state. A local is never
        # referenced before its declaration, so seeding it early is sound.
        def tsf_collect_local_subjects(statements: darray[Ast::Stmt], type_names: darray[sview]&, subj_names: mutable darray[sview]&, subj_state: mutable darray[sview]&, subj_diverged: mutable darray[bool]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |subj_names, subj_state, subj_diverged|:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            ts: (type_name: sview, state: sview) = tsf_param_typestate(type_expression)
                            if ts.type_name != "" and ts.state != "" and tsf_name_in(type_names, ts.type_name) and not tsf_name_in(subj_names, name):
                                subj_names.push(name)
                                subj_state.push(ts.state)
                                subj_diverged.push(false)
                        Stmt.If(condition, then_body, else_body, line):
                            tsf_collect_local_subjects(then_body, type_names, subj_names, subj_state, subj_diverged)
                            tsf_collect_local_subjects(else_body, type_names, subj_names, subj_state, subj_diverged)
                        Stmt.While(condition, while_body, while_line):
                            tsf_collect_local_subjects(while_body, type_names, subj_names, subj_state, subj_diverged)
                        Stmt.For(bind, variables, iterable, for_body, for_line):
                            tsf_collect_local_subjects(for_body, type_names, subj_names, subj_state, subj_diverged)
                        Stmt.Block(kind, clause, binding, body, block_line):
                            tsf_collect_local_subjects(body, type_names, subj_names, subj_state, subj_diverged)
                        _:
                            pass

        def tsf_check_declarations(declarations: darray[Ast::Decl], annotations: darray[Ast::EnumAnnotation]&, type_names: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            subj_names: mutable darray[sview] = []
                            subj_state: mutable darray[sview] = []
                            subj_diverged: mutable darray[bool] = []
                            for parameter in parameters |subj_names, subj_state, subj_diverged|:
                                ts: (type_name: sview, state: sview) = tsf_param_typestate(parameter.type_expression)
                                if ts.type_name != "" and ts.state != "" and tsf_name_in(type_names, ts.type_name):
                                    subj_names.push(parameter.name)
                                    subj_state.push(ts.state)
                                    subj_diverged.push(false)
                            tsf_collect_local_subjects(body, type_names, subj_names, subj_state, subj_diverged)
                            if subj_names.count > 0:
                                table <- tsf_walk(body, annotations, subj_names, subj_state, subj_diverged, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- tsf_check_declarations(module_body, annotations, type_names, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- tsf_check_declarations(scoped_body, annotations, type_names, table)
                        _:
                            pass

    public:
        def check_typestate_flow(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                type_names: mutable darray[sview] = []
                tsf_typestate_type_names(file.enum_annotations, type_names)
                if type_names.count > 0:
                    table <- tsf_check_declarations(file.top_decls, file.enum_annotations, type_names, table)
