extend Semantic:
    public:
        # Public entry points for the semantic layer (module-public).


        # Per-occurrence resolution for tooling: what an identifier at `line`
        # spelling `name` resolved to — 1 = parameter, 2 = local binding, 0 = not
        # a recorded param/local (a global or unresolved). Populated by `check`
        # during resolution; drives the LSP highlighter's binding colors and
        # correct shadowing (a local shadowing a global reports 2 here). Keyed by
        # (line, name); the linear scan is per-file scale.
        def occurrence_kind(table: SymbolTable&, line: u32, name: sview) -> int:
            can Abort.Panic:
                i: mutable usize = 0
                while i < table.ref_line.count:
                    if table.ref_line[i] == line and table.ref_name[i] == name:
                        return table.ref_kind[i].int()
                    i <- i + 1
                return 0


        # Build the symbol table for a parsed file (top-level + module-scoped decls).
        # `table.diagnostics` carries any duplicate-declaration findings.
        def collect_symbols(file: Ast::File&) -> SymbolTable:
            can Memory.Allocate, Abort.Panic:
                table: mutable SymbolTable = SymbolTable()
                collect_range(file.top_decls, table)
                return table


        # Run the full semantic check over a parsed file: collect symbols (recording
        # duplicate-declaration diagnostics) then resolve references (recording
        # undefined-name diagnostics). The returned table's `diagnostics` is the located,
        # LSP-facing finding list. Built inline so its container literals seed this
        # function's auto-region (the region a region-polymorphic return is adopted into).
        def check(file: Ast::File&) -> SymbolTable:
            can Memory.Allocate, Abort.Panic:
                table: mutable SymbolTable = SymbolTable()
                seed_builtins(table)
                append_parse_errors(file, table)
                collect_range(file.top_decls, table)
                # Validate struct layouts (field types + self-recursion) after symbol
                # collection so the symbol table is complete (all structs/enums registered).
                validate_struct_layouts(file, table)
                # Skip name resolution when the parse failed: a partial AST yields cascading,
                # misleading undefined-name diagnostics that bury the real syntax error.
                # Symbol collection (duplicate-decl) still runs over whatever parsed.
                if file.errors.count == 0:
                    resolve_decls(file.top_decls, table)
                return table


        # Resolve all references and return the full table (diagnostics included) —
        # the located-findings sibling of `unresolved_refs` for harness probes that
        # need per-diagnostic lines, without the parse-error gating of `check`.
        def unresolved_table(file: Ast::File&) -> SymbolTable:
            can Memory.Allocate, Abort.Panic:
                table: mutable SymbolTable = SymbolTable()
                seed_builtins(table)
                collect_range(file.top_decls, table)
                validate_struct_layouts(file, table)
                resolve_decls(file.top_decls, table)
                return table


        # Resolve all references in a parsed file; returns the count of unresolved
        # (undefined) value-position identifier references — the number of UndefinedName
        # diagnostics. Anchors the resolver call graph for the smoke harness.
        def unresolved_refs(file: Ast::File&) -> u64:
            can Memory.Allocate, Abort.Panic:
                table: mutable SymbolTable = SymbolTable()
                seed_builtins(table)
                collect_range(file.top_decls, table)
                validate_struct_layouts(file, table)
                resolve_decls(file.top_decls, table)
                # docs/119 §3: count UndefinedName diagnostics with a loop-expression fold —
                # the accumulator is loop-private and the body is pure over outer state.
                count: u64 =
                    for d in table.diagnostics |n = 0| -> n:
                        if d.kind == DiagnosticKind.UndefinedName:
                            n <- n + 1
                return count


        # Canonical human-readable message for a diagnostic, with the offending `name`
        # interpolated, as an owned UTF-8 `darray[u8]`. This is the SINGLE SOURCE OF TRUTH
        # for diagnostic wording: consumers (LSP, CLI, tests) render this rather than
        # re-deriving per-kind text, so a new `DiagnosticKind` is worded in exactly one
        # place. The `match` is exhaustive with no wildcard arm, so adding a kind without
        # wording it here is a compile error rather than a silent generic fallback.
        def diagnostic_message(d: Diagnostic) -> darray[u8]:
            can Memory.Allocate, Abort.Panic:
                buf: mutable darray[u8] = []
                match d.kind:
                    DiagnosticKind.UndefinedName:
                        buf.extend(f"undefined name '{d.name}'")
                    DiagnosticKind.DuplicateDecl:
                        buf.extend(f"duplicate declaration '{d.name}' (already defined as func)")
                    DiagnosticKind.DuplicateType:
                        buf.extend(f"duplicate type '{d.name}'")
                    DiagnosticKind.AssignImmutable:
                        buf.extend(f"cannot assign to immutable '{d.name}' (declare it `mutable` to allow mutation)")
                    DiagnosticKind.DuplicateParam:
                        buf.extend(f"duplicate parameter '{d.name}'")
                    DiagnosticKind.DuplicateField:
                        buf.extend(f"duplicate field '{d.name}' in struct '{d.expected}'")
                    DiagnosticKind.DuplicateVariant:
                        buf.extend(f"duplicate variant '{d.name}' in enum '{d.expected}'")
                    DiagnosticKind.NonExhaustiveMatch:
                        buf.extend(f"non-exhaustive match over '{d.name}'; missing variant '{d.expected}'")
                    DiagnosticKind.ArityMismatch:
                        # Enriched form (single decl, no defaults) carries counts —
                        # `function "g" expects N arguments, got M` (stage0 parity);
                        # otherwise the count is ambiguous (overload/defaults).
                        if d.expected == "n":
                            buf.extend(f"function '{d.name}' expects ")
                            push_int(buf, d.n1.i64())
                            push_str(buf, " arguments, got ")
                            push_int(buf, d.n2.i64())
                        else:
                            buf.extend(f"wrong number of arguments in call to '{d.name}'")
                    DiagnosticKind.DuplicateLocal:
                        buf.extend(f"duplicate local '{d.name}' (already defined in this scope; use `<-` to mutate)")
                    DiagnosticKind.UnknownVariant:
                        buf.extend(f"enum has no variant '{d.name}'")
                    DiagnosticKind.VariantArity:
                        # Parity: `enum constructor "E.A" expects N arguments, got M`.
                        buf.extend(f"enum constructor '{d.expected}.{d.name}' expects ")
                        push_int(buf, d.n1.i64())
                        push_str(buf, " arguments, got ")
                        push_int(buf, d.n2.i64())
                    DiagnosticKind.TypeMismatch:
                        # Mirrors stage0: `variable "a" expects bool, got int` /
                        # `return type expects i64, got ...`.
                        if d.name == "return":
                            buf.extend(f"return type expects {d.expected}, got {d.actual}")
                        else:
                            buf.extend(f"variable '{d.name}' expects {d.expected}, got {d.actual}")
                    DiagnosticKind.NonBoolCondition:
                        buf.extend(f"{d.name} condition must be bool, got {d.actual}")
                    DiagnosticKind.NonBoolOperand:
                        buf.extend(f"logical '{d.name}' requires bool operands, got {d.actual}")
                    DiagnosticKind.NonNumericOperand:
                        buf.extend(f"operator '{d.name}' requires numeric operands, got {d.actual}")
                    DiagnosticKind.IncompatibleComparison:
                        buf.extend(f"cannot compare {d.expected} with {d.actual}")
                    DiagnosticKind.ReturnValueInVoid:
                        buf.extend(f"'{d.name}' returns void — remove the return value")
                    DiagnosticKind.MissingReturnValue:
                        buf.extend(f"'{d.name}' must return a value")
                    DiagnosticKind.UnusedParam:
                        buf.extend(f"parameter '{d.name}' is never used (discard with `_ = {d.name}` or rename to `_`)")
                    DiagnosticKind.UnusedLocal:
                        buf.extend(f"local '{d.name}' is never used")
                    DiagnosticKind.BreakOutsideLoop:
                        # Static (no-interpolation) messages stay on `push_str`: a
                        # braceless f-string collapses to a plain string literal
                        # (`static u8&`), which `darray.extend` does not accept.
                        push_str(buf, "`break` outside a loop")
                    DiagnosticKind.ContinueOutsideLoop:
                        push_str(buf, "`continue` outside a loop")
                    DiagnosticKind.NonIterableLoop:
                        buf.extend(f"for loop iterable must be an iterable type (darray, dict, set, view, range, string, etc.), got {d.actual}")
                    DiagnosticKind.UnreachableCode:
                        push_str(buf, "unreachable code: a previous statement always exits this block")
                    DiagnosticKind.UnreachableMatchArm:
                        buf.extend(f"match arm '{d.name}' is unreachable because an earlier arm already matches it")
                    DiagnosticKind.UnknownField:
                        buf.extend(f"struct literal '{d.expected}' has no field '{d.name}'")
                    DiagnosticKind.DuplicateFieldInit:
                        buf.extend(f"struct literal '{d.expected}' field '{d.name}' is specified more than once")
                    DiagnosticKind.MissingField:
                        buf.extend(f"struct literal '{d.expected}' is missing field '{d.name}'")
                    DiagnosticKind.AssignUndefinedTarget:
                        buf.extend(f"undefined assignment target '{d.name}' (use = to introduce a new local; <- requires an existing mutable target)")
                    DiagnosticKind.InvalidAssignTarget:
                        push_str(buf, "invalid assignment target")
                    DiagnosticKind.ValueBlockMutation:
                        buf.extend(f"value block may not mutate the outer binding '{d.name}' (docs/119 E4); a block/loop expression yields new values — use `rebind` to thread the update back or capture it in the header (`|{d.name}|`)")
                    DiagnosticKind.CaptureUndefined:
                        buf.extend(f"capture '{d.name}' names no binding in scope (docs/119 E11)")
                    DiagnosticKind.CaptureImmutable:
                        buf.extend(f"capture '{d.name}' is not a `mutable` binding; only mutables can be threaded through a value block (docs/119 E10)")
                    DiagnosticKind.UnknownFieldType:
                        buf.extend(f"struct '{d.expected}' field '{d.name}' has unknown type '{d.actual}' (not a primitive, not a registered struct/enum)")
                    DiagnosticKind.RecursiveStruct:
                        buf.extend(f"struct '{d.name}' is directly self-recursive (field '{d.expected}' has type '{d.name}' — infinite size); use a ref for indirection")
                    DiagnosticKind.InvalidCast:
                        buf.extend(f"`.cast[{d.name}]` is a value conversion, not a reinterpret; use a constructor `{d.name}(x)` or `x.{d.name}()`")
                    DiagnosticKind.SyntaxExpectedToken:
                        buf.extend(f"expected a token, found '{d.name}'")
                    DiagnosticKind.SyntaxUnexpectedToken:
                        buf.extend(f"unexpected token '{d.name}'")
                    DiagnosticKind.SyntaxExpectedDeclaration:
                        buf.extend(f"expected a declaration, found '{d.name}'")
                    DiagnosticKind.SyntaxExpectedExpression:
                        buf.extend(f"expected an expression, found '{d.name}'")
                return buf


        # Canonical LSP DiagnosticSeverity for a diagnostic (1 = Error, 2 = Warning,
        # 3 = Information, 4 = Hint). Kept beside the wording so a new `DiagnosticKind`
        # must decide its severity here too. Both current kinds are errors.
        def diagnostic_severity(d: Diagnostic) -> u8:
            can Abort.Panic:
                return match d.kind:
                    DiagnosticKind.UndefinedName:            1
                    DiagnosticKind.DuplicateDecl:            1
                    DiagnosticKind.DuplicateType:            1
                    DiagnosticKind.AssignImmutable:          1
                    DiagnosticKind.DuplicateParam:           1
                    DiagnosticKind.DuplicateField:           1
                    DiagnosticKind.DuplicateVariant:         1
                    DiagnosticKind.NonExhaustiveMatch:       1
                    DiagnosticKind.ArityMismatch:            1
                    DiagnosticKind.DuplicateLocal:           1
                    DiagnosticKind.UnknownVariant:           1
                    DiagnosticKind.VariantArity:             1
                    DiagnosticKind.TypeMismatch:             1
                    DiagnosticKind.NonBoolCondition:         1
                    DiagnosticKind.NonBoolOperand:           1
                    DiagnosticKind.NonNumericOperand:        1
                    DiagnosticKind.IncompatibleComparison:   1
                    DiagnosticKind.ReturnValueInVoid:        1
                    DiagnosticKind.MissingReturnValue:       1
                    DiagnosticKind.UnusedParam:              4
                    DiagnosticKind.UnusedLocal:              4
                    DiagnosticKind.BreakOutsideLoop:         1
                    DiagnosticKind.ContinueOutsideLoop:      1
                    DiagnosticKind.NonIterableLoop:          1
                    DiagnosticKind.UnreachableCode:          2
                    DiagnosticKind.UnreachableMatchArm:      1
                    DiagnosticKind.UnknownField:             1
                    DiagnosticKind.DuplicateFieldInit:       1
                    DiagnosticKind.MissingField:             1
                    DiagnosticKind.AssignUndefinedTarget:    1
                    DiagnosticKind.InvalidAssignTarget:      1
                    DiagnosticKind.ValueBlockMutation:        1
                    DiagnosticKind.CaptureUndefined:          1
                    DiagnosticKind.CaptureImmutable:          1
                    DiagnosticKind.UnknownFieldType:         1
                    DiagnosticKind.RecursiveStruct:          1
                    DiagnosticKind.InvalidCast:              1
                    DiagnosticKind.SyntaxExpectedToken:      1
                    DiagnosticKind.SyntaxUnexpectedToken:    1
                    DiagnosticKind.SyntaxExpectedDeclaration: 1
                    DiagnosticKind.SyntaxExpectedExpression: 1


extend Semantic:
    private:
        # Fold the parser's syntax findings (`Ast::File.errors`) into the diagnostic stream
        # so the one `SymbolTable.diagnostics` list carries both syntax and semantic
        # findings — a consumer iterating it sees everything the frontend found. `context`
        # (the offending token text) becomes the diagnostic's `name`.
        def append_parse_errors(file: Ast::File&, table: mutable SymbolTable&) -> void:
            can Memory.Allocate, Abort.Panic:
                for e in file.errors:
                    table.diagnostics.push(Diagnostic{name: e.context, line: e.line, kind: parse_error_kind(e.kind), expected: "", actual: ""})


        # Map a parser `ParseErrorKind` onto the unified `DiagnosticKind`.
        def parse_error_kind(k: Ast::ParseErrorKind) -> DiagnosticKind:
            can Abort.Panic:
                return match k:
                    Ast::ParseErrorKind.ExpectedToken:       DiagnosticKind.SyntaxExpectedToken
                    Ast::ParseErrorKind.UnexpectedToken:     DiagnosticKind.SyntaxUnexpectedToken
                    Ast::ParseErrorKind.ExpectedDeclaration: DiagnosticKind.SyntaxExpectedDeclaration
                    Ast::ParseErrorKind.ExpectedExpression:  DiagnosticKind.SyntaxExpectedExpression
