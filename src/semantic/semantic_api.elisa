extend Semantic:
    public:
        # Public entry points for the semantic layer (module-public).


        # Register region binders before type collection: symbol collection interns
        # parameter and field annotations, and generic arguments must already know
        # whether an otherwise-unknown identifier is a region selector.
        def register_region_type_names(file: Ast::File&, table: mutable SymbolTable&) -> void:
            can Memory.Allocate, Abort.Panic:
                for annotation in file.enum_annotations |table|:
                    region_name: sview @source = annotation.name if annotation.owner == "__global_region" else annotation.owner
                    is_region_name: bool = annotation.name == "__region_name" or annotation.owner == "__global_region"
                    if is_region_name and not any known_region in table.region_names where known_region == region_name:
                        table.resolver_name_surface.valid <- false
                        table.region_names.push(region_name)
                for annotation in file.local_region_annotations |table|:
                    if annotation.name == "__region_param":
                        # A region-only generic has no runtime generic row. Preserve its
                        # exact function identity for specialization diagnostics anyway.
                        known_owner: mutable bool = false
                        for owner_index in 0..<table.region_generic_function_lines.count |owner_index, known_owner, annotation, table|:
                            known_owner <- true if owner_index < table.region_generic_function_offsets.count and table.region_generic_function_lines[owner_index] == annotation.line and table.region_generic_function_offsets[owner_index] == annotation.owner_offset
                        if not known_owner:
                            table.region_generic_function_lines.push(annotation.line)
                            table.region_generic_function_offsets.push(annotation.owner_offset)
                    is_region_binder: bool = annotation.name == "__region_param" or annotation.name == "__region_local" or annotation.name == "__region_arena_local"
                    if is_region_binder and annotation.region != "" and not any known_region in table.region_names where known_region == annotation.region:
                        table.resolver_name_surface.valid <- false
                        table.region_names.push(annotation.region)
                    binding_exists: mutable bool = false
                    for binding_index in 0..<table.region_binding_names.count |binding_exists, annotation, table|:
                        binding_exists <- true if binding_index < table.region_binding_lines.count and binding_index < table.region_binding_owner_offsets.count and binding_index < table.region_binding_end_lines.count and binding_index < table.region_binding_end_offsets.count and table.region_binding_names[binding_index] == annotation.region and table.region_binding_lines[binding_index] == annotation.line and table.region_binding_owner_offsets[binding_index] == annotation.owner_offset and table.region_binding_end_lines[binding_index] == annotation.end_line and table.region_binding_end_offsets[binding_index] == annotation.end_offset
                    if is_region_binder and annotation.region != "" and not binding_exists:
                        binding_serial: u32 = (table.region_binding_names.count + 1).u32()
                        table.region_binding_names.push(annotation.region)
                        table.region_binding_lines.push(annotation.line)
                        table.region_binding_owner_offsets.push(annotation.owner_offset)
                        table.region_binding_end_lines.push(annotation.end_line)
                        table.region_binding_end_offsets.push(annotation.end_offset)
                        table.region_binding_ids.push(binding_serial)
                    # Signature parameter ties use the formal name and function-header line;
                    # local binding annotations use their own declaration line and do not
                    # match a collected function symbol's line.
                    signature_parameter_region: bool = annotation.name != "__region_param" and annotation.name != "__region_local" and annotation.name != "__region_arena_local" and annotation.name != "__region_pin" and annotation.name != "__region_return"
                    if signature_parameter_region and annotation.line > 0:
                        table.function_param_region_line.push(annotation.line)
                        table.function_param_region_name.push(annotation.name)
                        table.function_param_region.push(annotation.region)


        # Build the symbol table for a parsed file (top-level + module-scoped decls).
        # `table.diagnostics` carries any duplicate-declaration findings.
        def collect_symbols(file: Ast::File&) -> SymbolTable:
            can Memory.Allocate, Abort.Panic:
                table: mutable SymbolTable = SymbolTable()
                table <- register_region_type_names(file, table)
                # BEFORE collect_range: the struct field pass needs to know which structs are
                # column-major, and the general annotation loop below runs after it.
                # Gather annotation-only collection metadata in one source-ordered pass.
                # Each destination column retains the order of its own matching rows.
                for annotation in file.enum_annotations |table|:
                    table.soa_layout_owners <- table.soa_layout_owners.push(annotation.owner) if annotation.name == "__layout_soa"
                    if annotation.owner == "__for_binder":
                        table.binder_pos_offsets <- table.binder_pos_offsets.push(annotation.offset)
                        table.binder_pos_values <- table.binder_pos_values.push(annotation.pos)
                    table.quantifier_lines <- table.quantifier_lines.push(annotation.line) if annotation.owner == "__contract_quantifier"
                table <- collect_range(file.top_decls, table, file.enum_annotations) can Global{Read,Write}
                table <- collect_payload_enum_metadata(file, table) can Global{Read,Write}
                table <- resolve_protocol_state_declarations(file, table)
                return move table


        # Run the full semantic check over a parsed file: collect symbols (recording
        # duplicate-declaration diagnostics) then resolve references (recording
        # undefined-name diagnostics). The returned table's `diagnostics` is the located,
        # LSP-facing finding list. Built inline so its container literals seed this
        # function's auto-region (the region a region-polymorphic return is adopted into).
        # Keep this basic semantic entry aligned with the CLI default: mutable-global grants
        # are enforced even when the legacy all-global reporting dial is off.
        def check_with_unsafe_permissions(file: Ast::File&, enforce_unsafe_permissions: bool) -> SymbolTable:
            can Unsafe.PointerCast:
                can Memory.Allocate, Abort.Panic:
                    return check_full(file, enforce_unsafe_permissions, false, false, false, false, false, false, false, false, false, 64, false, true, false) can Global{Read,Write}

            # Full-option entry: strict Unsafe permissions and/or the docs/125 §6b
            # flow-strict lint (every statement-position block `if` is an error).
            # `runtime_std` marks the compilation unit as trusted stdlib (mirrors stage0's
            # isRuntimeStdPermissionInternal): passes that only apply to user code — currently
            # the raw-atomic-surface removal — are skipped for it.
            # `enforce_unsafe_permissions` here is the UNION of stage0's EnforceUnsafePermissions
            # and EnforceStrictProofs (both replayed via `# strict`), preserving every existing
            # strict-gated check. `enforce_raw_unsafe` is the NARROWER pure-EnforceUnsafePermissions
            # signal: the raw-extern-call obligation (markRawExternFuncType is gated on
            # EnforceUnsafePermissions ALONE in stage0) must fire only under it, else a
            # proof-only case (`EnforceStrictProofs` without `EnforceUnsafePermissions`) would
            # spuriously demand `Unsafe.RawExtern` for its extern calls.
        def check_full(file: Ast::File&, enforce_unsafe_permissions: bool, flow_strict: bool, runtime_std: bool, flow_warn: bool, enable_smt: bool, warn_discarded: bool, enforce_progress: bool, enforce_extern_contracts: bool, enforce_raw_unsafe: bool, emit_proof_hole: bool, region_stack_cap: i64, enforce_global_permissions: bool, enforce_mutable_global_grants: bool, carrier_surface: bool) -> SymbolTable:
            can Memory.Allocate, Abort.Panic:
                table: mutable SymbolTable = SymbolTable()
                table <- check_full_into(file, table, enforce_unsafe_permissions, flow_strict, runtime_std, flow_warn, enable_smt, warn_discarded, enforce_progress, enforce_extern_contracts, enforce_raw_unsafe, emit_proof_hole, region_stack_cap, enforce_global_permissions, enforce_mutable_global_grants, carrier_surface) can Global{Read,Write}
                return move table


        # Trusted-caller internal helper: snapshot must come from current-source collection
        # or the opaque session API, never directly from a decoded disk sidecar.
        # In-place sibling of check_full for callers that only need diagnostics during a
        # bounded region. Returning SymbolTable by value carries every side-table buffer
        # through the region boundary on stage1; an lmut destination keeps those buffers in
        # the caller's region so the caller can reclaim them before backend emission.
        def check_full_into_with_incremental_snapshot[@file, @table, @snapshot, @snapshot_borrow](file: Ast::File& @file, table: mutable SymbolTable& @table, enforce_unsafe_permissions: bool, flow_strict: bool, runtime_std: bool, flow_warn: bool, enable_smt: bool, warn_discarded: bool, enforce_progress: bool, enforce_extern_contracts: bool, enforce_raw_unsafe: bool, emit_proof_hole: bool, region_stack_cap: i64, enforce_global_permissions: bool, enforce_mutable_global_grants: bool, carrier_surface: bool, snapshot: IncrementalSemanticSnapshot[snapshot]& @snapshot_borrow, incremental_skip_count: mutable u64&, effect_source_bodies_skipped: mutable u64&, ungranted_panic_bodies_skipped: mutable u64&, global_permission_axis_scans_skipped: mutable u64&) -> void:
            can Memory.Allocate, Abort.Panic:
                # The resolver captures borrow this context only during the synchronous
                # checker call. Keep that scratch state in a request region separate from
                # the caller-owned SymbolTable region.
                lookup_session: mutable IncrementalSemanticSession[table]&? @table = null
                region lookup_request:
                    lookup_contexts: mutable darray[IncrementalSemanticNameLookupContext[lookup_request]] @lookup_request = []
                    incremental_semantic_name_lookup_context_disabled_push(&lookup_contexts)
                    table <- check_full_into_with_incremental_snapshot_and_lookup_context[file, table, snapshot, snapshot_borrow, table, lookup_request, table, lookup_request](file, table, enforce_unsafe_permissions, flow_strict, runtime_std, flow_warn, enable_smt, warn_discarded, enforce_progress, enforce_extern_contracts, enforce_raw_unsafe, emit_proof_hole, region_stack_cap, enforce_global_permissions, enforce_mutable_global_grants, carrier_surface, snapshot, incremental_skip_count, effect_source_bodies_skipped, ungranted_panic_bodies_skipped, global_permission_axis_scans_skipped, lookup_session, &lookup_contexts[0]) can Global{Read,Write}

        def check_full_into_with_incremental_snapshot_and_lookup_context[@file, @destination, @snapshot, @snapshot_borrow, @session, @request, @session_borrow, @request_borrow](file: Ast::File& @file, table: mutable SymbolTable& @destination, enforce_unsafe_permissions: bool, flow_strict: bool, runtime_std: bool, flow_warn: bool, enable_smt: bool, warn_discarded: bool, enforce_progress: bool, enforce_extern_contracts: bool, enforce_raw_unsafe: bool, emit_proof_hole: bool, region_stack_cap: i64, enforce_global_permissions: bool, enforce_mutable_global_grants: bool, carrier_surface: bool, snapshot: IncrementalSemanticSnapshot[snapshot]& @snapshot_borrow, incremental_skip_count: mutable u64&, effect_source_bodies_skipped: mutable u64&, ungranted_panic_bodies_skipped: mutable u64&, global_permission_axis_scans_skipped: mutable u64&, lookup_session: mutable IncrementalSemanticSession[session]&? @session_borrow, lookup_context: mutable IncrementalSemanticNameLookupContext[request]& @request_borrow) -> void:
            can Memory.Allocate, Abort.Panic:
                if file.errors.count == 0 and not par_pass_serial():
                    workers: usize = par_pass_worker_count()
                    if workers > 1.usize():
                        can Pool.Create, Pool.Shutdown, Pool.Submit, Pool.WaitAll, Thread.Spawn, Thread.Join, Memory.Release, Atomics.Store, Atomics.Load, Atomics.CompareExchange, Sync{Lock,Wait,Unlock,Notify}:
                            region parallel_pool_region:
                                pool_slots: mutable darray[ThreadPool] @parallel_pool_region = [pool_new(workers)]
                                table <- check_full_into_pipeline[file, destination, snapshot, snapshot_borrow, session, request, parallel_pool_region, session_borrow, request_borrow](file, table, &pool_slots[0], enforce_unsafe_permissions, flow_strict, runtime_std, flow_warn, enable_smt, warn_discarded, enforce_progress, enforce_extern_contracts, enforce_raw_unsafe, emit_proof_hole, region_stack_cap, enforce_global_permissions, enforce_mutable_global_grants, carrier_surface, snapshot, incremental_skip_count, effect_source_bodies_skipped, ungranted_panic_bodies_skipped, global_permission_axis_scans_skipped, lookup_session, lookup_context) can Global{Read,Write}
                                for pool in move pool_slots:
                                    mutable_pool: mutable ThreadPool = move pool
                                    can Pool.Shutdown, Thread.Join, Memory.Release, Unsafe.PointerCast:
                                        pool_shutdown(&mutable_pool)
                    else:
                        region serial_pool_region:
                            pool_slots: mutable darray[ThreadPool] @serial_pool_region = [zeroed]
                            table <- check_full_into_pipeline[file, destination, snapshot, snapshot_borrow, session, request, serial_pool_region, session_borrow, request_borrow](file, table, &pool_slots[0], enforce_unsafe_permissions, flow_strict, runtime_std, flow_warn, enable_smt, warn_discarded, enforce_progress, enforce_extern_contracts, enforce_raw_unsafe, emit_proof_hole, region_stack_cap, enforce_global_permissions, enforce_mutable_global_grants, carrier_surface, snapshot, incremental_skip_count, effect_source_bodies_skipped, ungranted_panic_bodies_skipped, global_permission_axis_scans_skipped, lookup_session, lookup_context) can Global{Read,Write}
                            for pool in move pool_slots:
                                mutable_pool: mutable ThreadPool = move pool
                                can Pool.Shutdown, Thread.Join, Memory.Release, Sync{Lock,Notify,Unlock}, Unsafe.PointerCast:
                                    pool_shutdown(&mutable_pool)
                else:
                    region serial_pool_region:
                        pool_slots: mutable darray[ThreadPool] @serial_pool_region = [zeroed]
                        table <- check_full_into_pipeline[file, destination, snapshot, snapshot_borrow, session, request, serial_pool_region, session_borrow, request_borrow](file, table, &pool_slots[0], enforce_unsafe_permissions, flow_strict, runtime_std, flow_warn, enable_smt, warn_discarded, enforce_progress, enforce_extern_contracts, enforce_raw_unsafe, emit_proof_hole, region_stack_cap, enforce_global_permissions, enforce_mutable_global_grants, carrier_surface, snapshot, incremental_skip_count, effect_source_bodies_skipped, ungranted_panic_bodies_skipped, global_permission_axis_scans_skipped, lookup_session, lookup_context) can Global{Read,Write}
                        for pool in move pool_slots:
                            mutable_pool: mutable ThreadPool = move pool
                            can Pool.Shutdown, Thread.Join, Memory.Release, Sync{Lock,Notify,Unlock}, Unsafe.PointerCast:
                                pool_shutdown(&mutable_pool)
