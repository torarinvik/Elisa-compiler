extend Semantic:
    public:
        # Public entry points for the semantic layer (module-public).


        # Per-occurrence resolution for tooling: what an identifier at `line`
        # spelling `name` resolved to — 1 = parameter, 2 = local binding, 0 = not
        # a recorded param/local (a global or unresolved). Populated by `check`
        # during resolution; drives the LSP highlighter's binding colors and
        # correct shadowing (a local shadowing a global reports 2 here). Keyed by
        # (line, name); the linear scan is per-file scale.
        def occurrence_kind(table: SymbolTable&, line: u32, name: sview) -> int:
            can Abort.Panic:
                while occurrence_index < table.ref_line.count |occurrence_index: usize = 0|:
                    table.ref_kind[occurrence_index].int() return if table.ref_line[occurrence_index] == line and table.ref_name[occurrence_index] == name
                    occurrence_index <- occurrence_index + 1
                return 0


        # Build the symbol table for a parsed file (top-level + module-scoped decls).
        # `table.diagnostics` carries any duplicate-declaration findings.
        def collect_symbols(file: Ast::File&) -> SymbolTable:
            can Memory.Allocate, Abort.Panic:
                table: mutable SymbolTable = SymbolTable()
                table <- collect_range(file.top_decls, table)
                return table


        # Run the full semantic check over a parsed file: collect symbols (recording
        # duplicate-declaration diagnostics) then resolve references (recording
        # undefined-name diagnostics). The returned table's `diagnostics` is the located,
        # LSP-facing finding list. Built inline so its container literals seed this
        # function's auto-region (the region a region-polymorphic return is adopted into).
        def check_with_unsafe_permissions(file: Ast::File&, enforce_unsafe_permissions: bool) -> SymbolTable:
            can Memory.Allocate, Abort.Panic:
                return check_full(file, enforce_unsafe_permissions, false, false, false, false, false)

        # Full-option entry: strict Unsafe permissions and/or the docs/125 §6b
        # flow-strict lint (every statement-position block `if` is an error).
        # `runtime_std` marks the compilation unit as trusted stdlib (mirrors stage0's
        # isRuntimeStdPermissionInternal): passes that only apply to user code — currently
        # the raw-atomic-surface removal — are skipped for it.
        def check_full(file: Ast::File&, enforce_unsafe_permissions: bool, flow_strict: bool, runtime_std: bool, flow_warn: bool, enable_smt: bool, warn_discarded: bool) -> SymbolTable:
            can Memory.Allocate, Abort.Panic:
                table: mutable SymbolTable = SymbolTable()
                table <- seed_builtins(table)
                table <- append_parse_errors(file, table)
                table <- collect_range(file.top_decls, table)
                table.generic_param_lines <- file.generic_param_lines
                table.generic_param_names <- file.generic_param_names
                table.packed_enum_names <- file.packed_enum_names
                for annotation in file.enum_annotations |table|:
                    table.imported_modules <- table.imported_modules.push(annotation.owner) if annotation.name == "__using"
                    table.imported_members <- table.imported_members.push(annotation.name) if annotation.owner == "__from_member"
                    table.catch_match_lines <- table.catch_match_lines.push(annotation.line) if annotation.name == "__catch_match"
                    table.new_construct_lines <- table.new_construct_lines.push(annotation.line) if annotation.name == "__new_construct"
                    table.forward_arg_lines <- table.forward_arg_lines.push(annotation.line) if annotation.name == "__arg_forward"
                    table.block_if_lines <- table.block_if_lines.push(annotation.line) if annotation.name == "__block_if"
                    table.region_names <- table.region_names.push(annotation.owner) if annotation.name == "__region_name"
                    table.query_binder_lines <- table.query_binder_lines.push(annotation.line) if annotation.name == "__query_binder"
                    table.query_binder_names <- table.query_binder_names.push(annotation.owner) if annotation.name == "__query_binder"
                    table.enum_hierarchy_child <- table.enum_hierarchy_child.push(annotation.owner) if annotation.line == 3900000008
                    table.enum_hierarchy_parent <- table.enum_hierarchy_parent.push(annotation.name) if annotation.line == 3900000008
                table.enum_common_owners <- file.enum_common_owners
                table.enum_common_counts <- file.enum_common_counts
                # Validate struct layouts (field types + self-recursion) after symbol
                # collection so the symbol table is complete (all structs/enums registered).
                table <- validate_struct_layouts(file, table)
                # Skip name resolution when the parse failed: a partial AST yields cascading,
                # misleading undefined-name diagnostics that bury the real syntax error.
                # Symbol collection (duplicate-declaration) still runs over whatever parsed.
                if file.errors.count == 0:
                    table <- resolve_declarations(file.top_decls, table)
                    # stage0→stage1 diagnostic ports (batch).
                    table <- check_self_assignment(file.top_decls, table)
                    table <- check_self_comparison(file.top_decls, table)
                    table <- check_unused_expression(file.top_decls, table)
                    table <- check_constant_condition(file.top_decls, table) if flow_warn or flow_strict
                    table <- check_redundant_bool_compare(file.top_decls, table)
                    table <- check_duplicate_import(file.top_decls, table)
                    table <- check_duplicate_match_arm(file.top_decls, table)
                    table <- check_division_by_zero(file.top_decls, table)
                    table <- check_array_literal_arity(file.top_decls, table)
                    table <- check_unknown_type_name(file.top_decls, table)
                    table <- check_duplicate_dict_key(file.top_decls, table)
                    table <- check_duplicate_set_element(file.top_decls, table)
                    table <- check_index_out_of_bounds(file, table)
                    table <- check_enum_tag_index(file.top_decls, table)
                    table <- check_packed_enum_cast(file.top_decls, file.packed_enum_names, table)
                    table <- check_auto_region_escape(file.top_decls, table)
                    table <- check_structural_decreases(file.top_decls, table)
                    table <- check_local_refinement_unproven(file.top_decls, table)
                    table <- check_owned_region(file.top_decls, table)
                    table <- check_ensures_hof_args(file.top_decls, table)
                    table <- check_assert_by(file, table)
                    table <- check_loop_invariant_preserved(file.top_decls, table)
                    table <- check_field_fact_precondition(file, table)
                    table <- check_region_tied_return(file, table) if not runtime_std
                    table <- check_quantified_refinement(file.top_decls, table)
                    table <- check_guest_overlay(file, table)
                    table <- check_self_arithmetic(file.top_decls, table)
                    table <- check_double_negation(file.top_decls, table)
                    table <- check_infinite_loop(file.top_decls, table) if flow_warn or flow_strict
                    table <- check_redundant_arithmetic(file.top_decls, table)
                    table <- check_empty_range(file.top_decls, table)
                    table <- check_assign_to_loop_var(file.top_decls, table)
                    table <- check_constant_comparison(file.top_decls, table)
                    table <- check_duplicate_condition(file.top_decls, table)
                    table <- check_discarded_call_result(file.top_decls, table) if warn_discarded
                    table <- check_void_value_use(file.top_decls, table)
                    table <- check_literal_arg_type_mismatch(file.top_decls, table)
                    table <- check_oversized_shift(file.top_decls, table)
                    table <- check_negative_shift(file.top_decls, table)
                    table <- check_literal_assign_out_of_range(file.top_decls, table)
                    table <- check_literal_comparison_impossible(file.top_decls, table)
                    table <- check_duplicate_variant_field(file.top_decls, table)
                    table <- check_identical_logical_operands(file.top_decls, table)
                    table <- check_identical_branches(file.top_decls, table)
                    table <- check_empty_iterable(file.top_decls, table)
                    table <- check_unused_import(file.top_decls, table)
                    table <- check_float_equality(file.top_decls, table)
                    table <- check_negative_index(file.top_decls, table)
                    table <- check_duplicate_pattern_binding(file.top_decls, table)
                    table <- check_immediate_overwrite(file.top_decls, table) if flow_warn or flow_strict
                    table <- check_modulo_by_zero(file.top_decls, table)
                    table <- check_shift_by_zero(file.top_decls, table)
                    table <- check_logical_constant_operand(file.top_decls, table)
                    table <- check_duplicate_decorator(file.top_decls, table)
                    table <- check_redundant_continue(file.top_decls, table)
                    table <- check_negated_comparison(file.top_decls, table)
                    table <- check_field_access_on_primitive(file.top_decls, table)
                    table <- check_index_non_indexable(file.top_decls, table)
                    table <- check_firm_arg_type_mismatch(file, table)
                    table <- check_nonbool_match_guard(file.top_decls, table)
                    table <- check_redundant_cast(file.top_decls, table)
                    table <- check_unknown_field_access(file.top_decls, table)
                    table <- check_is_pattern_field(file.top_decls, table)
                    table <- check_construct_field_type(file.top_decls, table)
                    table <- check_truthy_or_bindings(file.top_decls, table)
                    table <- check_readonly_refs(file.top_decls, table)
                    table <- check_named_type_mismatch(file.top_decls, table)
                    table <- check_void_argument(file.top_decls, table)
                    table <- check_nonnumeric_shift_operand(file.top_decls, table)
                    table <- check_compound_assign_nonnumeric(file.top_decls, table)
                    table <- check_string_index_nonnumeric(file.top_decls, table)
                    table <- check_void_field_access(file.top_decls, table)
                    table <- check_void_index(file.top_decls, table)
                    table <- check_call_non_function(file.top_decls, table)
                    table <- check_shift_non_integral(file.top_decls, table)
                    table <- check_void_operand(file.top_decls, table)
                    table <- check_void_condition(file.top_decls, table)
                    table <- check_ternary_branch_mismatch(file.top_decls, table)
                    table <- check_array_literal_element(file.top_decls, table)
                    table <- check_string_index_nonintegral(file.top_decls, table)
                    table <- check_void_collection_element(file.top_decls, table)
                    table <- check_void_unary_operand(file.top_decls, table)
                    table <- check_void_match_scrutinee(file.top_decls, table)
                    table <- check_ordering_non_numeric(file.top_decls, table)
                    table <- check_range_bound_non_integral(file.top_decls, table)
                    table <- check_darray_element_mismatch(file.top_decls, table)
                    table <- check_set_element_mismatch(file.top_decls, table)
                    table <- check_dict_value_mismatch(file.top_decls, table)
                    table <- check_dict_key_mismatch(file.top_decls, table)
                    table <- check_call_named_non_function(file.top_decls, table)
                    table <- check_callback_named_args(file.top_decls, table)
                    table <- check_struct_pattern_type_mismatch(file.top_decls, table)
                    table <- check_match_arm_enum_mismatch(file.top_decls, table)
                    table <- check_invalid_bool_cast(file.top_decls, table)
                    table <- check_field_immutable_assign(file.top_decls, table)
                    table <- collect_extern_effects(file.enum_annotations, table)
                    table <- collect_effect_sources(file.top_decls, table)
                    table <- check_ungranted_panic(file.top_decls, file.allocation_region_names, file.allocation_region_lines, file.enum_annotations, enforce_unsafe_permissions, table)
                    table.diagnostics.extend(unknown_permission_member_diagnostics(file.enum_annotations))
                    table <- check_contract_position(file.top_decls, table)
                    table <- check_contract_result_void(file.top_decls, enforce_unsafe_permissions or enable_smt, table)
                    table <- check_affine_collection(file.top_decls, table)
                    table <- check_byvalue_grown_container(file.top_decls, table)
                    table <- check_affine_use_flow(file, table)
                    table <- check_interior_ref_uaf(file.top_decls, table)
                    table <- check_darray_linear_consume(file.top_decls, table)
                    table <- check_thread_shareability(file.top_decls, table)
                    table <- check_export_boundary(file, table)
                    table <- check_block_lambda_context(file, table)
                    table <- check_legacy_error_syntax(file, table)
                    table <- check_nullable_flow(file, table)
                    table <- check_aggregate_state_arity(file, table)
                    table <- check_derived_state_constructor(file, table)
                    table <- check_derived_state_flow(file, table)
                    table <- check_pointer_erasure_cast(file, enforce_unsafe_permissions, runtime_std, table)
                    table <- check_dense_node_key_root(file.top_decls, table)
                    table <- check_thread_transfer_provenance(file, table)
                    table <- check_function_variance(file.top_decls, table)
                    table <- check_catch_exhaustive(file, table)
                    table <- check_enum_tail_payload(file, table)
                    table <- check_try_fallible(file, table)
                    table <- check_const_float_cast(file.top_decls, table)
                    table <- check_container_shape_return(file.top_decls, table)
                    table <- check_fresh_shape_calls(file, table)
                    table <- check_uses_contract(file.top_decls, file, table)
                    table <- check_strict_unsafe_ops(file, table) if enforce_unsafe_permissions
                    table <- check_fixed_index_range(file.top_decls, table) if enforce_unsafe_permissions
                    table <- check_mutable_alias_local(file.top_decls, table) if enforce_unsafe_permissions
                    table <- check_mutable_alias_borrow(file.top_decls, table) if enforce_unsafe_permissions
                    table <- check_pointer_arith_grant(file.top_decls, table) if enforce_unsafe_permissions
                    table <- check_ensure_strict(file.top_decls, table) if enforce_unsafe_permissions
                    table <- check_refinement_return(file.top_decls, enable_smt, table)
                    table <- check_refine_cycle(file.top_decls, table)
                    table <- check_where_reassign_walk(file.top_decls, table)
                    table <- check_precondition_violated(file.top_decls, table)
                    table <- check_precondition_invariant_violated(file.top_decls, table)
                    table <- check_precondition_unproven(file, table)
                    table <- check_loop_invariant_establish(file, table)
                    table <- check_noalloc_allocates(file, table)
                    table <- check_refinement_arg_violated(file.top_decls, table)
                    table <- check_refinement_fact_invalidated(file, table)
                    table <- check_refinement_arg_unproven(file, table)
                    table <- check_recursive_affine_ensure(file, table)
                    table <- check_raw_atomic_surface(file.top_decls, table) if not runtime_std
                    table <- check_raw_concurrency_surface(file.top_decls, table) if not runtime_std
                    table <- check_where_scope(file.top_decls, table)
                    table <- check_push_loop_lint(file.top_decls, table)
                    table <- check_char_classifier_guard(file.top_decls, table)
                    table <- check_flags_const_enum(file.top_decls, table)
                    table <- check_boundary_pointer_args(file, table)
                    table <- check_errorset_param_inference(file, table)
                    table <- check_fulfills_whole_function(file, table)
                    table <- check_inbounds_index(file.top_decls, table)
                    table <- check_contract_purity(file.top_decls, table)
                    table <- check_requires_contradictory(file, table)
                    table <- check_uninitialized_zeroed(file.top_decls, table)
                    table <- check_redundant_grant(file.top_decls, table)
                    table <- check_flow_shapes(file.top_decls, table) if flow_warn or flow_strict
                    table <- check_def_shadows_builtin(file.top_decls, table)
                    table <- check_async_entry_annotations(file.top_decls, table)
                    table <- check_reentrant_safe_calls(file.top_decls, table)
                    table <- check_export_names(file, table)
                    table <- check_frame_conformance(file, table)
                    table <- check_static_assert(file, table)
                    table <- check_assert_nonbool(file.top_decls, table)
                    table <- check_set_membership_element(file.top_decls, table)
                    table <- check_error_union_unhandled(file, table)
                    table <- check_where_predicate_bool(file.top_decls, table)
                    table <- check_static_call_context(file, table)
                    table <- check_effect_law_fulfillment(file, table)
                    table <- check_nobounds_index(file, table)
                    table <- check_permission_includes(file, table)
                    table <- check_can_cast_unsound(file, table)
                    table <- check_segment_agnostic_grant(file, table)
                    table <- check_optional_compare(file, table)
                    table <- check_callconv(file, table)
                    table <- check_extern_segment(file, table)
                    table <- check_segment_flow(file, table)
                    table <- check_local_arena_escape(file, table)
                    table <- check_region_stack_lifetime(file, table)
                    table <- check_assoc_index_bounds(file, table)
                    table <- check_contract_wellformed(file, table)
                    table <- check_drain_discipline(file, table)
                    table <- check_linear_reference(file, table)
                    table <- check_clone_builtin(file, table)
                    table <- check_law_purity(file, table)
                    table <- check_field_default_type(file, table)
                    table <- check_id_newtype_return(file, table)
                    table <- check_ufcs_unknown_method(file, table)
                    table <- check_brace_shorthand(file, table)
                    table <- check_lambda_arg_return(file, table)
                    table <- check_static_runtime_stmt(file, table)
                    table <- check_catch_out_of_set(file, table)
                    table <- check_nolock_blocking(file, table)
                    table <- check_typestate_flow(file, table)
                    table <- check_named_call_args(file, table)
                    table <- check_impl_conformance(file, table)
                    table <- check_extern_signature_mismatch(file, table)
                    table <- check_frame_write(file, table)
                    table <- check_frame_interproc(file, table)
                    table <- check_preserves_conflict(file, table)
                    table <- check_preserves_write(file, table)
                    table <- check_refine_alias_binder(file, table)
                    table <- check_unknown_interface(file, table)
                    table <- check_lmut_value_arg(file, table)
                    table <- check_changes_target_param(file, table)
                    table <- check_refinement_is_law(file, table)
                    table <- check_typestate_scope(file, table)
                    table <- check_region_escape(file, table)
                    table <- check_arena_grow_escape(file, table)
                    table <- check_dview_removed(file.top_decls, table)
                    table <- check_noalloc_arguments(file.top_decls, table)
                    table <- check_hot_contract(file.top_decls, file.annotation_args, table)
                    table <- check_decreases_star_reason(file.top_decls, table)
                    table <- check_decreases_unmodelable(file.top_decls, table) if not runtime_std
                    table <- check_deprecated_call(file, table)
                    table <- check_in_auto_deprecated(file.top_decls, table)
                    for new_auto_annotation in file.enum_annotations |table|:
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.NewAutoDeprecated, name: "", line: new_auto_annotation.line, expected: "", actual: ""}) if new_auto_annotation.owner == "__new_auto"
                    table <- check_permission_reserved(file.enum_annotations, table)
                    table <- check_extern_decorators(file.top_decls, file.annotation_args, table)
                    table <- check_extern_link_name_conflict(file, table)
                    table <- check_lmut_mutation_reassignment(file, table)
                    table <- check_default_param_ref(file, table)
                    table <- check_import_conflict(file, table)
                    table <- check_measure_shape_law_value_is(file, table)
                    table <- check_defer_rules(file, table)
                    table <- check_law_subject(file, table)
                    table <- check_cast_constant_truncated(file, table)
                    table <- check_enum_refine_parent(file, table)
                    table <- check_mutate_while_iterating(file, table)
                    table <- check_index_fallback_type(file, table)
                    table <- check_optional_comparison(file, table)
                    table <- check_match_literal_arms(file, table)
                    table <- check_offset_of_field(file, table)
                    table <- check_copy_builtin(file, table)
                    table <- check_arg_forwarding(file, table)
                    table <- check_id_unwrap_operand(file, table)
                    table <- check_readonly_view_assign(file, table)
                    table <- check_rowid_soa(file, table)
                    table <- check_sparse_requires_soa(file, table)
                    table <- check_law_subject_type(file, table)
                    table <- check_brace_membership_context(file, table)
                    table <- check_cbind_requires_c_layout(file, table)
                    table <- check_const_enum_value_fits(file.top_decls, table)
                    table <- check_literal_type_overflow(file.top_decls, table)
                    table <- check_overlay_field(file.top_decls, table)
                    table <- check_struct_field_where_scope(file.top_decls, table)
                    table <- check_local_where_violated(file.top_decls, table)
                    table <- check_law_refinement_violated(file, table)
                    table <- check_ensures_assign_violated(file, table)
                    table <- check_precondition_multiparam(file, table)
                    table <- check_struct_field_violated(file.top_decls, table)
                    table <- check_struct_field_law_violated(file.top_decls, table)
                    table <- check_positional_construction(file.top_decls, table)
                    table <- check_zip_map_readonly(file.top_decls, table)
                    if flow_strict:
                        for block_if_line in table.block_if_lines |table|:
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.FlowStrictBlockIf, name: "", line: block_if_line, expected: "", actual: ""})
                    table <- check_internal_runtime_carrier(file, table)
                    table <- check_generic_interface_bounds(file, table)
                    table <- check_parallel_for_grant(file, table)
                    table <- check_unused_decreases(file.top_decls, table)
                    table <- check_ghost_field_default(file.top_decls, table)
                    table <- check_ghost_local_read(file, table)
                    table <- check_ghost_field_read(file, table)
                    table <- check_const_dict_index(file, table)
                    table <- check_ambiguous_error_variant(file, table)
                    table <- check_private_member_access(file, table)
                    table <- check_frame_preserves(file, table)
                    table <- check_static_def_recursion(file, table)
                    table <- check_errorset_shadow(file, table)
                    table <- check_ghost_function(file, table)
                    table <- check_const_enum_storage(file.top_decls, table)
                    table <- check_const_enum_member_value(file.top_decls, table)
                    table <- check_raise_without_error_set(file, table)
                    table <- check_lambda_raise_conformance(file, table)
                    while suffix_index < file.numeric_suffix_names.count |suffix_index: usize = 0|:
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.NumericLiteralSuffix, name: file.numeric_suffix_names[suffix_index], line: file.numeric_suffix_lines[suffix_index], expected: "", actual: ""})
                        suffix_index <- suffix_index + 1
                    table <- check_machine_tag_coverage(file, table)
                    table <- check_region_annotation_scalar(file.top_decls, table)
                    table <- check_region_backing(file.top_decls, table)
                    table <- check_local_region_annotation(file, table)
                    table <- check_destroyed_region(file, table)
                    table <- check_region_storage_stability(file, table)
                    table <- check_removed_packed_annotation(file, table)
                    table <- check_duplicate_bit_group_member(file.top_decls, table)
                    table <- check_named_states_without_derive(file.top_decls, table)
                    table <- check_flow_flag(file.top_decls, table)
                    table <- check_if_value_missing_else(file.top_decls, table)
                    table <- check_tuple_pattern_arity(file.top_decls, table)
                    table <- check_or_pattern_bindings(file.top_decls, table)
                    table <- collect_tuple_binding_spellings(file, table)
                    table <- check_tuple_var_scalar_mismatch(file, table)
                    table <- check_packed_move_store(file, table)
                    table <- check_packed_match_store(file.top_decls, table)
                    table <- check_unknown_function_annotation(file, table)
                    table <- check_fixed_array_shape(file.top_decls, table)
                    table <- check_fresh_shape_wrapper(file.top_decls, table)
                    table <- check_atomic_payload(file.top_decls, table)
                return table


        def check(file: Ast::File&) -> SymbolTable:
            can Memory.Allocate, Abort.Panic:
                return check_with_unsafe_permissions(file, false)


        # Resolve all references and return the full table (diagnostics included) —
        # the located-findings sibling of `unresolved_references` for harness probes that
        # need per-diagnostic lines, without the parse-error gating of `check`.
        def unresolved_table(file: Ast::File&) -> SymbolTable:
            can Memory.Allocate, Abort.Panic:
                table: mutable SymbolTable = SymbolTable()
                table <- seed_builtins(table)
                table <- collect_range(file.top_decls, table)
                table.generic_param_lines <- file.generic_param_lines
                table.generic_param_names <- file.generic_param_names
                table.packed_enum_names <- file.packed_enum_names
                for annotation in file.enum_annotations |table|:
                    table.imported_modules <- table.imported_modules.push(annotation.owner) if annotation.name == "__using"
                    table.imported_members <- table.imported_members.push(annotation.name) if annotation.owner == "__from_member"
                    table.catch_match_lines <- table.catch_match_lines.push(annotation.line) if annotation.name == "__catch_match"
                    table.new_construct_lines <- table.new_construct_lines.push(annotation.line) if annotation.name == "__new_construct"
                    table.forward_arg_lines <- table.forward_arg_lines.push(annotation.line) if annotation.name == "__arg_forward"
                    table.block_if_lines <- table.block_if_lines.push(annotation.line) if annotation.name == "__block_if"
                    table.region_names <- table.region_names.push(annotation.owner) if annotation.name == "__region_name"
                    table.query_binder_lines <- table.query_binder_lines.push(annotation.line) if annotation.name == "__query_binder"
                    table.query_binder_names <- table.query_binder_names.push(annotation.owner) if annotation.name == "__query_binder"
                    table.enum_hierarchy_child <- table.enum_hierarchy_child.push(annotation.owner) if annotation.line == 3900000008
                    table.enum_hierarchy_parent <- table.enum_hierarchy_parent.push(annotation.name) if annotation.line == 3900000008
                table.enum_common_owners <- file.enum_common_owners
                table.enum_common_counts <- file.enum_common_counts
                table <- validate_struct_layouts(file, table)
                table <- resolve_declarations(file.top_decls, table)
                return table


        # Resolve all references in a parsed file; returns the count of unresolved
        # (undefined) value-position identifier references — the number of UndefinedName
        # diagnostics. Anchors the resolver call graph for the smoke harness.
        def unresolved_references(file: Ast::File&) -> u64:
            can Memory.Allocate, Abort.Panic:
                table: mutable SymbolTable = SymbolTable()
                table <- seed_builtins(table)
                table <- collect_range(file.top_decls, table)
                table.generic_param_lines <- file.generic_param_lines
                table.generic_param_names <- file.generic_param_names
                table.packed_enum_names <- file.packed_enum_names
                for annotation in file.enum_annotations |table|:
                    table.imported_modules <- table.imported_modules.push(annotation.owner) if annotation.name == "__using"
                    table.imported_members <- table.imported_members.push(annotation.name) if annotation.owner == "__from_member"
                    table.catch_match_lines <- table.catch_match_lines.push(annotation.line) if annotation.name == "__catch_match"
                    table.new_construct_lines <- table.new_construct_lines.push(annotation.line) if annotation.name == "__new_construct"
                    table.forward_arg_lines <- table.forward_arg_lines.push(annotation.line) if annotation.name == "__arg_forward"
                    table.block_if_lines <- table.block_if_lines.push(annotation.line) if annotation.name == "__block_if"
                    table.region_names <- table.region_names.push(annotation.owner) if annotation.name == "__region_name"
                    table.query_binder_lines <- table.query_binder_lines.push(annotation.line) if annotation.name == "__query_binder"
                    table.query_binder_names <- table.query_binder_names.push(annotation.owner) if annotation.name == "__query_binder"
                    table.enum_hierarchy_child <- table.enum_hierarchy_child.push(annotation.owner) if annotation.line == 3900000008
                    table.enum_hierarchy_parent <- table.enum_hierarchy_parent.push(annotation.name) if annotation.line == 3900000008
                table.enum_common_owners <- file.enum_common_owners
                table.enum_common_counts <- file.enum_common_counts
                table <- validate_struct_layouts(file, table)
                table <- resolve_declarations(file.top_decls, table)
                # docs/119 §3: count UndefinedName diagnostics with a loop-expression fold —
                # the accumulator is loop-private and the body is pure over outer state.
                count: u64 =
                    for diagnostic in table.diagnostics |undefined_count = 0| -> undefined_count:
                        undefined_count <- undefined_count + 1 if diagnostic.kind == DiagnosticKind.UndefinedName
                return count


        # Canonical human-readable message for a diagnostic, with the offending `name`
        # interpolated, as an owned UTF-8 `darray[u8]`. This is the SINGLE SOURCE OF TRUTH
        # for diagnostic wording: consumers (LSP, CLI, tests) render this rather than
        # re-deriving per-kind text, so a new `DiagnosticKind` is worded in exactly one
        # place. The `match` is exhaustive with no wildcard arm, so adding a kind without
        # wording it here is a compile error rather than a silent generic fallback.
        def diagnostic_message(diagnostic: Diagnostic) -> darray[u8]:
            can Memory.Allocate, Abort.Panic:
                buffer: mutable darray[u8] = []
                match diagnostic.kind:
                    DiagnosticKind.UndefinedName:
                        buffer.extend(f"undefined identifier '{diagnostic.name}'")
                    DiagnosticKind.DuplicateDecl:
                        buffer.extend(f"duplicate declaration '{diagnostic.name}' (already defined as {diagnostic.actual})" if diagnostic.actual != "" else f"duplicate declaration '{diagnostic.name}' (already defined as func)")
                    DiagnosticKind.DuplicateType:
                        buffer.extend(f"duplicate type '{diagnostic.name}'")
                    DiagnosticKind.AssignImmutable:
                        buffer.extend(f"cannot assign to immutable local '{diagnostic.name}'")
                    DiagnosticKind.DuplicateParam:
                        buffer.extend(f"duplicate parameter '{diagnostic.name}'")
                    DiagnosticKind.DuplicateField:
                        buffer.extend(f"duplicate field '{diagnostic.name}' in struct '{diagnostic.expected}'")
                    DiagnosticKind.DuplicateVariant:
                        buffer.extend(f"duplicate variant '{diagnostic.name}' in enum '{diagnostic.expected}'")
                    DiagnosticKind.NonExhaustiveMatch:
                        buffer.extend(f"non-exhaustive match over '{diagnostic.name}'; missing variant '{diagnostic.expected}'")
                    DiagnosticKind.NonExhaustiveScalarMatch:
                        buffer.extend(f"non-exhaustive match over an open '{diagnostic.name}' domain; add a final '_' arm")
                    DiagnosticKind.InvalidTopLevelScalarMatchArm:
                        match diagnostic.name:
                            "int":
                                push_str(buffer, "top-level integer match arm must use an integer literal or _")
                            _:
                                push_str(buffer, "top-level string match arm must use a string literal or _")
                    DiagnosticKind.InvalidExportBoundary:
                        match diagnostic.expected:
                            "type":
                                buffer.extend(f"export type '{diagnostic.name}' must name a concrete C-ABI-compatible struct or concrete instantiation")
                            "global":
                                buffer.extend(f"export global '{diagnostic.name}' must target a global")
                            _:
                                buffer.extend(f"export func '{diagnostic.name}' is not C-ABI-compatible")
                    DiagnosticKind.BlockLambdaMissingContext:
                        push_str(buffer, "block lambda requires an explicit return type or contextual function type")
                    DiagnosticKind.LegacyErrorSyntax:
                        match diagnostic.name:
                            "wildcard":
                                push_str(buffer, "error[Set.*] is no longer supported; use error[Set] instead")
                            "open":
                                push_str(buffer, "the `, ...` suffix in error[...] is no longer supported; name the full sets directly (a bare set name already means the whole family)")
                            _:
                                push_str(buffer, "legacy fallible return syntax `T | ErrorSet` is no longer supported; use `T error[SomeSet]` instead")
                    DiagnosticKind.NullableWithoutProof:
                        match diagnostic.expected:
                            "field":
                                push_str(buffer, "field access requires proven non-null reference")
                            _:
                                buffer.extend(f"invalid cast from nullable reference '{diagnostic.name}' to non-null reference")
                    DiagnosticKind.AggregateStateArity:
                        if diagnostic.expected_count == 0:
                            buffer.extend(f"struct '{diagnostic.name}' does not declare an aggregate state parameter")
                        else:
                            buffer.extend(f"struct '{diagnostic.name}' expects ")
                            push_int(buffer, diagnostic.expected_count.i64())
                            push_str(buffer, " aggregate state arguments, got ")
                            push_int(buffer, diagnostic.actual_count.i64())
                    DiagnosticKind.FunctionParameterVariance:
                        buffer.extend(f"variable \"{diagnostic.name}\" expects a callback that accepts nullable arguments; function '{diagnostic.expected}' requires a non-null argument")
                    DiagnosticKind.NonExhaustiveCatch:
                        buffer.extend(f"non-exhaustive catch over '{diagnostic.expected}'; missing error '{diagnostic.name}'")
                    DiagnosticKind.OrdinaryEnumTailPayload:
                        buffer.extend(f"enum \"{diagnostic.expected}\" variant \"{diagnostic.name}\" tail payloads are only supported for packed enums")
                    DiagnosticKind.FloatDictRuntimeKey:
                        push_str(buffer, "runtime-backed dict keys must be cstr, an integer type, bool, or a const enum")
                    DiagnosticKind.TryRequiresFallible:
                        push_str(buffer, "try without else requires an error union" if diagnostic.expected == "optional" else "try requires a fallible expression")
                    DiagnosticKind.ConstFloatCastRange:
                        buffer.extend(f"const \"{diagnostic.name}\" initializer must be a compile-time {diagnostic.expected} value")
                    DiagnosticKind.ContainerShapeReturn:
                        if diagnostic.name == "darray":
                            buffer.extend(f"return type expects darray[{diagnostic.expected}, {diagnostic.actual}], got darray[{diagnostic.expected}" )
                            push_str(buffer, ", ") if diagnostic.detail != ""
                            buffer.extend(f"{diagnostic.detail}") if diagnostic.detail != ""
                            push_str(buffer, "]")
                        else:
                            buffer.extend(f"return type expects {diagnostic.name}[{diagnostic.actual}], got {diagnostic.name}")
                            push_str(buffer, "[") if diagnostic.detail != ""
                            buffer.extend(f"{diagnostic.detail}") if diagnostic.detail != ""
                            push_str(buffer, "]") if diagnostic.detail != ""
                    DiagnosticKind.InternalRuntimeCarrier:
                        buffer.extend(f"internal runtime carrier type \"{diagnostic.name}\" is not supported in user-facing code; use \"{diagnostic.expected}\" instead")
                    DiagnosticKind.UngrantedParallelFor:
                        push_str(buffer, "parallel for requires an enclosing permission grant; add `can Pool.Submit, Pool.WaitAll:` or declare the Pool effects")
                    DiagnosticKind.ParallelOuterMutation:
                        buffer.extend(f"parallel for body cannot mutate outer binding \"{diagnostic.name}\"")
                    DiagnosticKind.UnknownPermissionMember:
                        buffer.extend(f"permission \"{diagnostic.name}\" has no member \"{diagnostic.actual}\"")
                    DiagnosticKind.DestroyedRegionUse:
                        buffer.extend(f"cannot allocate from destroyed region \"{diagnostic.actual}\"") if diagnostic.expected == "allocate"
                        buffer.extend(f"value \"{diagnostic.name}\" cannot be used; region dependency facts were invalidated by destroy of region \"{diagnostic.actual}\"") if diagnostic.expected != "allocate"
                    DiagnosticKind.StorageDependencyInvalidated:
                        buffer.extend(f"view \"{diagnostic.name}\" cannot be used; storage dependency facts were invalidated by darray push of \"{diagnostic.expected}\"") if diagnostic.expected != ""
                        buffer.extend(f"storage dependency facts were invalidated for interior reference \"{diagnostic.name}\"") if diagnostic.expected == ""
                    DiagnosticKind.PermissionParamMemberAccess:
                        buffer.extend(f"permission parameter \"{diagnostic.name}\" does not support member access")
                    DiagnosticKind.TruthyOrBindingMismatch:
                        match diagnostic.actual:
                            "":
                                buffer.extend(f"identifier \"{diagnostic.name}\" is not available here because truthy `or` branches do not agree on that binding: left branch binds it as {diagnostic.expected}, while right branch does not bind it")
                            _:
                                buffer.extend(f"identifier \"{diagnostic.name}\" is not available here because truthy `or` branches do not agree on that binding: left branch binds it as {diagnostic.expected}, while right branch binds it as {diagnostic.actual}")
                    DiagnosticKind.RaiseVariantNotAllowed:
                        buffer.extend(f"raise cannot propagate tag \"{diagnostic.name}.{diagnostic.actual}\" into error[{diagnostic.expected}.{diagnostic.detail}]")
                    DiagnosticKind.GhostFnImpure:
                        buffer.extend(f"ghost function \"{diagnostic.name}\" must be pure and total so its defining equation can be used by the prover")
                    DiagnosticKind.GhostFnRuntimeCall:
                        buffer.extend(f"ghost function \"{diagnostic.name}\" is verification-only and cannot be called by runtime code: it is erased from codegen")
                    DiagnosticKind.AmbiguousErrorVariant:
                        buffer.extend(f"error variant \"{diagnostic.name}\" is ambiguous across sets {diagnostic.expected}, {diagnostic.actual}; qualify it as {diagnostic.expected}.{diagnostic.name}")
                    DiagnosticKind.PreservesViolation:
                        buffer.extend(f"may write {diagnostic.name}.{diagnostic.detail}, which \"{diagnostic.actual}\" `preserves`")
                    DiagnosticKind.StaticIndirectRecursion:
                        buffer.extend(f"indirect recursive static call cycle involving \"{diagnostic.name}\" and \"{diagnostic.actual}\" is not supported; use direct structural recursion")
                    DiagnosticKind.StaticPartialRecursion:
                        buffer.extend(f"recursive static call to \"{diagnostic.name}\" must decrease a parameter using parameter - positive_constant")
                    DiagnosticKind.PrivateMemberAccess:
                        buffer.extend(f"\"{diagnostic.actual}.{diagnostic.name}\" is private to module \"{diagnostic.actual}\"")
                    DiagnosticKind.ErrorsetParamShadow:
                        buffer.extend(f"errorset parameter \"{diagnostic.name}\" on \"{diagnostic.actual}\" shadows the declared error set \"{diagnostic.name}\"; every `error[{diagnostic.name}]` now refers to the parameter")
                    DiagnosticKind.ConstDictNoKey:
                        buffer.extend(f"const dict has no key s:{diagnostic.name}")
                    DiagnosticKind.GhostFieldRead:
                        buffer.extend(f"ghost field \"{diagnostic.name}\" is verification-only and cannot be read by real code: it is erased from codegen, so its value does not exist at runtime")
                    DiagnosticKind.GhostInitImpure:
                        buffer.extend(f"ghost variable \"{diagnostic.name}\" initializer must be side-effect-free (it is erased from codegen): use reads, arithmetic, or a ghost/pure function")
                    DiagnosticKind.LambdaRaiseMismatch:
                        buffer.extend(f"raise cannot propagate tag \"{diagnostic.name}.{diagnostic.actual}\" into {diagnostic.expected}")
                    DiagnosticKind.RaiseDestinationMismatch:
                        buffer.extend(f"raise cannot propagate tag \"{diagnostic.name}.{diagnostic.actual}\" into error[{diagnostic.expected}, {diagnostic.detail}]")
                    DiagnosticKind.TryPropagationMismatch:
                        match diagnostic.detail:
                            "":
                                buffer.extend(f"cannot propagate {diagnostic.name} from a function returning {diagnostic.expected}")
                            _:
                                buffer.extend(f"cannot propagate {diagnostic.name} from a function returning error[{diagnostic.expected}, {diagnostic.detail}]")
                    DiagnosticKind.ReadonlyRefMutation:
                        buffer.extend(f"cannot mutate through readonly ref \"{diagnostic.name}\"; note: plain refs T& are readonly; use mutable {diagnostic.expected}& if this reference should allow writes")
                    DiagnosticKind.ReadonlyRefArgument:
                        push_str(buffer, "argument ")
                        push_int(buffer, diagnostic.expected_count.i64())
                        buffer.extend(f" to \"{diagnostic.name}\" expects mutable {diagnostic.expected}&, got {diagnostic.actual}&; note: use mutable {diagnostic.actual}& here if the callee should be allowed to write through it")
                    DiagnosticKind.MachineTagCoverage:
                        match diagnostic.actual:
                            "_":
                                buffer.extend(f"machine state '{diagnostic.name}' dispatches on the closed enum '{diagnostic.expected}' with a '_' wildcard — spell the variants as explicit tags (docs/125 §9)")
                            _:
                                buffer.extend(f"machine state '{diagnostic.name}' does not cover the closed enum '{diagnostic.expected}'; missing variant '{diagnostic.actual}' (docs/125 §9)")
                    DiagnosticKind.ArityMismatch:
                        # Enriched form (single declaration, no defaults) carries counts —
                        # `function "g" expects N arguments, got M` (stage0 parity);
                        # otherwise the count is ambiguous (overload/defaults).
                        match diagnostic.expected:
                            "type":
                                buffer.extend(f"type \"{diagnostic.name}\" expects 2 type arguments, got 1")
                            "n":
                                buffer.extend(f"function '{diagnostic.name}' expects ")
                                push_int(buffer, diagnostic.expected_count.i64())
                                push_str(buffer, " arguments, got ")
                                push_int(buffer, diagnostic.actual_count.i64())
                            _:
                                buffer.extend(f"wrong number of arguments in call to '{diagnostic.name}'")
                    DiagnosticKind.DuplicateLocal:
                        buffer.extend(f"duplicate local '{diagnostic.name}' (already defined in this scope; use `<-` to mutate)")
                    DiagnosticKind.UnknownVariant:
                        buffer.extend(f"enum has no variant '{diagnostic.name}'")
                    DiagnosticKind.VariantArity:
                        # Parity: `enum constructor "E.A" expects N arguments, got M`.
                        buffer.extend(f"enum constructor '{diagnostic.expected}.{diagnostic.name}' expects ")
                        push_int(buffer, diagnostic.expected_count.i64())
                        push_str(buffer, " arguments, got ")
                        push_int(buffer, diagnostic.actual_count.i64())
                    DiagnosticKind.TypeMismatch:
                        # Mirrors stage0: `variable "a" expects bool, got int` /
                        # `return type expects i64, got ...`.
                        expected_is_container: bool = diagnostic.expected in {"darray", "dict", "set", "list", "array"}
                        buffer.extend(f"return type expects {diagnostic.expected}" if diagnostic.name == "return" else f"variable '{diagnostic.name}' expects {diagnostic.expected}")
                        buffer.extend(f"[{diagnostic.detail}]") if diagnostic.detail != "" and expected_is_container
                        buffer.extend(f", got {diagnostic.actual}")
                        buffer.extend(f"[{diagnostic.detail}]") if diagnostic.detail != "" and not expected_is_container
                    DiagnosticKind.NonBoolCondition:
                        # An optional condition prints its BASE type (stage0: 'got i64'); a
                        # container prints head[elem].
                        buffer.extend(f"{diagnostic.name} condition must be bool, got ")
                        push_sview(buffer, diagnostic.detail if diagnostic.actual == "optional" and diagnostic.detail != "" else diagnostic.actual)
                        buffer.extend(f"[{diagnostic.detail}]") if diagnostic.actual != "optional" and diagnostic.detail != ""
                    DiagnosticKind.NonBoolOperand:
                        push_str(buffer, "not operator requires bool operand") if diagnostic.name == "not"
                        push_str(buffer, "logical operator requires bool operands") if diagnostic.name != "not"
                    DiagnosticKind.NonNumericOperand:
                        push_str(buffer, "operator requires numeric operands")
                    DiagnosticKind.IncompatibleComparison:
                        buffer.extend(f"cannot compare {diagnostic.expected}")
                        buffer.extend(f"[{diagnostic.detail}]") if diagnostic.detail != "" and diagnostic.expected in {"darray", "dict", "set", "list", "array"}
                        buffer.extend(f" and {diagnostic.actual}")
                        buffer.extend(f"[{diagnostic.detail}]") if diagnostic.detail != "" and diagnostic.actual in {"darray", "dict", "set", "list", "array"}
                    DiagnosticKind.InvalidVariantTestOperand:
                        buffer.extend(f"is requires an enum value for variant tests, got {diagnostic.actual}")
                    DiagnosticKind.InvalidTopLevelSequenceMatchArm:
                        push_str(buffer, "unsupported top-level sequence match pattern *ast.MatchVariantPattern")
                    DiagnosticKind.ReturnValueInVoid:
                        buffer.extend(f"'{diagnostic.name}' returns void — remove the return value")
                    DiagnosticKind.MissingReturnValue:
                        buffer.extend(f"'{diagnostic.name}' must return a value")
                    DiagnosticKind.UnusedParam:
                        buffer.extend(f"parameter '{diagnostic.name}' is never used (discard with `_ = {diagnostic.name}` or rename to `_`)")
                    DiagnosticKind.UnusedLocal:
                        buffer.extend(f"local '{diagnostic.name}' is never used")
                    DiagnosticKind.BreakOutsideLoop:
                        # Static (no-interpolation) messages stay on `push_str`: a
                        # braceless f-string collapses to a plain string literal
                        # (`static u8&`), which `darray.extend` does not accept.
                        push_str(buffer, "`break` outside a loop")
                    DiagnosticKind.ContinueOutsideLoop:
                        push_str(buffer, "`continue` outside a loop")
                    DiagnosticKind.NonIterableLoop:
                        buffer.extend(f"for loop iterable must be an iterable type (darray, dict, set, view, range, string, etc.), got {diagnostic.actual}")
                    DiagnosticKind.UnreachableCode:
                        push_str(buffer, "unreachable code: a previous statement always exits this block")
                    DiagnosticKind.UnreachableMatchArm:
                        buffer.extend(f"match arm '{diagnostic.name}' is unreachable because an earlier arm already matches it")
                    DiagnosticKind.UnknownField:
                        buffer.extend(f"struct literal '{diagnostic.expected}' has no field '{diagnostic.name}'")
                    DiagnosticKind.DuplicateFieldInit:
                        buffer.extend(f"struct literal '{diagnostic.expected}' field '{diagnostic.name}' is specified more than once")
                    DiagnosticKind.MissingField:
                        buffer.extend(f"struct literal '{diagnostic.expected}' is missing field '{diagnostic.name}'")
                    DiagnosticKind.AssignUndefinedTarget:
                        buffer.extend(f"undefined assignment target '{diagnostic.name}' (use = to introduce a new local; <- requires an existing mutable target)")
                    DiagnosticKind.InvalidAssignTarget:
                        push_str(buffer, "invalid assignment target")
                    DiagnosticKind.ValueBlockMutation:
                        buffer.extend(f"value block may not mutate the outer binding \"{diagnostic.name}\" through a call (docs/119 E4); pass it by value, capture it in the header (`|{diagnostic.name}|`), or thread it back with `rebind`" if diagnostic.expected == "call" else f"value block may not mutate the outer binding '{diagnostic.name}' (docs/119 E4); a block/loop expression yields new values — use `rebind` to thread the update back or capture it in the header (`|{diagnostic.name}|`)")
                    DiagnosticKind.CaptureUndefined:
                        buffer.extend(f"capture '{diagnostic.name}' names no binding in scope (docs/119 E11)")
                    DiagnosticKind.CaptureImmutable:
                        buffer.extend(f"capture '{diagnostic.name}' is not a `mutable` binding; only mutables can be threaded through a value block (docs/119 E10)")
                    DiagnosticKind.UnknownFieldType:
                        buffer.extend(f"struct '{diagnostic.expected}' field '{diagnostic.name}' has unknown type '{diagnostic.actual}' (not a primitive, not a registered struct/enum)")
                    DiagnosticKind.RecursiveStruct:
                        buffer.extend(f"struct '{diagnostic.name}' is directly self-recursive (field '{diagnostic.expected}' has type '{diagnostic.name}' — infinite size); use a ref for indirection")
                    DiagnosticKind.InvalidCast:
                        buffer.extend(f"`.cast[{diagnostic.name}]` is a value conversion, not a reinterpret; use a constructor `{diagnostic.name}(x)` or `x.{diagnostic.name}()`")
                    DiagnosticKind.SyntaxExpectedToken:
                        buffer.extend(f"expected a token, found '{diagnostic.name}'")
                    DiagnosticKind.SyntaxUnexpectedToken:
                        buffer.extend(f"unexpected token '{diagnostic.name}'")
                    DiagnosticKind.SyntaxExpectedDeclaration:
                        buffer.extend(f"expected a declaration, found '{diagnostic.name}'")
                    DiagnosticKind.SyntaxExpectedExpression:
                        buffer.extend(f"expected an expression, found '{diagnostic.name}'")
                    DiagnosticKind.SyntaxMismatchedWithBindings:
                        buffer.extend(f"every alternative of a `with`-arm must bind the same constants; alternative near '{diagnostic.name}' differs")
                    DiagnosticKind.LmutAliasing:
                        buffer.extend(f"`lmut` argument '{diagnostic.name}' aliases another argument of the same call; a linear-mutable value must be named by exactly one live binding")
                    DiagnosticKind.NonTrailingDefaultParam:
                        buffer.extend(f"parameter '{diagnostic.name}' must declare a default because it follows a defaulted parameter")
                    DiagnosticKind.CallArgumentError:
                        call_argument_message: dstr = when diagnostic.expected:
                            "unknown" -> f"function '{diagnostic.name}' has no parameter '{diagnostic.actual}'"
                            "duplicate" -> f"function '{diagnostic.name}' parameter '{diagnostic.actual}' is specified more than once"
                            "after_named" -> f"function '{diagnostic.name}' cannot use positional arguments after named arguments"
                            "missing" -> f"function '{diagnostic.name}' is missing argument for parameter '{diagnostic.actual}'"
                            "no_names" -> f"function \"{diagnostic.name}\" does not expose parameter names for named argument calls"
                            _ -> f"invalid arguments in call to '{diagnostic.name}'"
                        buffer.extend(call_argument_message)
                    DiagnosticKind.EnumConstructorArgumentError:
                        constructor_argument_message: dstr = when diagnostic.expected:
                            "mixed" -> f"enum constructor '{diagnostic.name}' cannot mix positional and named arguments"
                            "unnamed" -> f"enum constructor '{diagnostic.name}' does not declare named payload fields"
                            "unknown" -> f"enum constructor '{diagnostic.name}' has no payload field '{diagnostic.actual}'"
                            "duplicate" -> f"enum constructor '{diagnostic.name}' payload field '{diagnostic.actual}' is specified more than once"
                            "missing" -> f"enum constructor '{diagnostic.name}' is missing payload field '{diagnostic.actual}'"
                            _ -> f"invalid arguments in enum constructor '{diagnostic.name}'"
                        buffer.extend(constructor_argument_message)
                    DiagnosticKind.SelfAssignment:
                        buffer.extend(f"assignment to '{diagnostic.name}' has no effect: target and value are identical")
                    DiagnosticKind.SelfComparison:
                        buffer.extend(f"comparison of '{diagnostic.name}' with itself is always the same")
                    DiagnosticKind.UnusedExpression:
                        push_str(buffer, "expression statement has no effect; its result is discarded")
                    DiagnosticKind.ConstantCondition:
                        buffer.extend(f"condition is always {diagnostic.actual}")
                    DiagnosticKind.RedundantBoolCompare:
                        push_str(buffer, "redundant comparison to a boolean literal; use the value (or its negation) directly")
                    DiagnosticKind.DuplicateImport:
                        buffer.extend(f"module '{diagnostic.name}' is imported more than once")
                    DiagnosticKind.DuplicateMatchArm:
                        buffer.extend(f"match arm '{diagnostic.name}' is unreachable because an earlier arm already matches it")
                    DiagnosticKind.DivisionByZero:
                        push_str(buffer, "division by zero")
                    DiagnosticKind.ArrayLiteralArity:
                        push_str(buffer, "array literal expects ")
                        push_int(buffer, diagnostic.expected_count.i64())
                        push_str(buffer, " elements, got ")
                        push_int(buffer, diagnostic.actual_count.i64())
                    DiagnosticKind.UnknownTypeName:
                        buffer.extend(f"unknown type '{diagnostic.name}'")
                    DiagnosticKind.DuplicateDictKey:
                        buffer.extend(f"dict literal has a duplicate key '{diagnostic.name}'")
                    DiagnosticKind.DuplicateSetElement:
                        buffer.extend(f"set literal has a duplicate element '{diagnostic.name}'")
                    DiagnosticKind.IndexOutOfBounds:
                        push_str(buffer, "constant index ")
                        push_int(buffer, diagnostic.actual_count.i64())
                        buffer.extend(f" out of bounds for {diagnostic.expected}[")
                        push_int(buffer, diagnostic.expected_count.i64())
                        push_str(buffer, "]")
                    DiagnosticKind.SelfArithmetic:
                        buffer.extend(f"arithmetic of '{diagnostic.name}' with itself always yields a constant")
                    DiagnosticKind.DoubleNegation:
                        push_str(buffer, "double negation has no effect; use the value directly")
                    DiagnosticKind.InfiniteLoopNoExit:
                        push_str(buffer, "'while true' loop never exits (no break or return in its body)")
                    DiagnosticKind.RedundantArithmetic:
                        push_str(buffer, "redundant arithmetic: the literal operand makes this operation a no-op or a constant")
                    DiagnosticKind.EmptyRange:
                        push_str(buffer, "for loop over an empty range never executes")
                    DiagnosticKind.AssignToLoopVar:
                        buffer.extend(f"assignment to loop variable '{diagnostic.name}' has no effect on iteration")
                    DiagnosticKind.ConstantComparison:
                        buffer.extend(f"constant comparison is always {diagnostic.actual}")
                    DiagnosticKind.DuplicateCondition:
                        push_str(buffer, "duplicate condition: this branch repeats an earlier condition and can never run")
                    DiagnosticKind.DiscardedCallResult:
                        buffer.extend(f"result of '{diagnostic.name}' (returns {diagnostic.expected}) is discarded; assign it or discard explicitly with _ =")
                    DiagnosticKind.VoidValueUse:
                        buffer.extend(f"cannot bind void expression to '{diagnostic.expected}'; the initializer produces no value") if diagnostic.expected != ""
                        buffer.extend(f"'{diagnostic.name}' returns void; its call cannot be used as a value") if diagnostic.expected == ""
                    DiagnosticKind.LiteralArgTypeMismatch:
                        push_str(buffer, "argument ")
                        push_int(buffer, diagnostic.expected_count.i64())
                        buffer.extend(f" to '{diagnostic.name}' expects {diagnostic.expected}, got {diagnostic.actual}")
                    DiagnosticKind.OversizedShift:
                        push_str(buffer, "shift count is out of range for every integer width (valid range 0..63)")
                    DiagnosticKind.NegativeShift:
                        push_str(buffer, "shift count is negative")
                    DiagnosticKind.LiteralAssignOutOfRange:
                        push_str(buffer, "integer literal ")
                        push_str(buffer, "-") if diagnostic.actual_count != 0
                        push_int(buffer, diagnostic.expected_count.i64())
                        push_str(buffer, " does not fit in ")
                        push_sview(buffer, diagnostic.expected)
                    DiagnosticKind.LiteralComparisonImpossible:
                        buffer.extend(f"comparison is always vacuous for {diagnostic.expected}")
                    DiagnosticKind.DuplicateVariantField:
                        buffer.extend(f"duplicate payload field '{diagnostic.name}' in enum variant '{diagnostic.actual}.{diagnostic.expected}'")
                    DiagnosticKind.IdenticalLogicalOperands:
                        buffer.extend(f"identical operands on both sides of '{diagnostic.name}'")
                    DiagnosticKind.IdenticalBranches:
                        push_str(buffer, "if and else branches are identical")
                    DiagnosticKind.EmptyIterable:
                        push_str(buffer, "empty list literal requires an expected array or darray type")
                    DiagnosticKind.UnusedImport:
                        buffer.extend(f"import '{diagnostic.name}' is never used")
                    DiagnosticKind.FloatEquality:
                        push_str(buffer, "floating-point equality comparison is unreliable; use a tolerance")
                    DiagnosticKind.NegativeIndex:
                        push_str(buffer, "constant index -")
                        push_int(buffer, diagnostic.actual_count.i64())
                        buffer.extend(f" out of bounds for {diagnostic.expected}[")
                        push_int(buffer, diagnostic.expected_count.i64())
                        push_str(buffer, "]")
                    DiagnosticKind.DuplicatePatternBinding:
                        buffer.extend(f"name {diagnostic.name} bound more than once in pattern")
                    DiagnosticKind.ImmediateOverwrite:
                        buffer.extend(f"value assigned to {diagnostic.name} is immediately overwritten")
                    DiagnosticKind.ModuloByZero:
                        push_str(buffer, "modulo by zero")
                    DiagnosticKind.ShiftByZero:
                        push_str(buffer, "shift by zero has no effect")
                    DiagnosticKind.LogicalConstantOperand:
                        push_str(buffer, "logical operator with constant boolean operand")
                    DiagnosticKind.DuplicateDecorator:
                        buffer.extend(f"duplicate @{diagnostic.name} annotation on function \"{diagnostic.expected}\" (first seen at line ")
                        push_int(buffer, diagnostic.expected_count.i64())
                        push_str(buffer, ":")
                        push_int(buffer, diagnostic.actual_count.i64())
                        push_str(buffer, ")")
                    DiagnosticKind.RedundantContinue:
                        push_str(buffer, "redundant continue at end of loop body")
                    DiagnosticKind.NegatedComparison:
                        push_str(buffer, "negated equality comparison; use the opposite operator")
                    DiagnosticKind.FieldAccessOnPrimitive:
                        buffer.extend(f"field access requires struct type, got {diagnostic.actual}")
                    DiagnosticKind.IndexNonIndexable:
                        buffer.extend(f"indexing requires string, array, view, packed store, or reference type, got {diagnostic.actual}")
                    DiagnosticKind.FirmArgTypeMismatch:
                        push_str(buffer, "argument ")
                        push_int(buffer, diagnostic.expected_count.i64())
                        buffer.extend(f" to '{diagnostic.name}' expects {diagnostic.expected}, got {diagnostic.actual}")
                    DiagnosticKind.NonBoolMatchGuard:
                        buffer.extend(f"match arm guard must be bool, got {diagnostic.actual}")
                    DiagnosticKind.RedundantCast:
                        buffer.extend(f"warning: redundant `.cast[{diagnostic.name}]`: the operand already has type {diagnostic.name}; remove the cast")
                    DiagnosticKind.UnknownFieldAccess:
                        buffer.extend(f"struct '{diagnostic.expected}' has no field '{diagnostic.name}'")
                    DiagnosticKind.ConstructFieldTypeMismatch:
                        buffer.extend(f"struct literal field '{diagnostic.name}' expects {diagnostic.expected}, got {diagnostic.actual}")
                    DiagnosticKind.NamedTypeMismatch:
                        expected_is_container: bool = diagnostic.expected in {"darray", "dict", "set", "list", "array"}
                        buffer.extend(f"return type expects {diagnostic.expected}" if diagnostic.name == "return" else f"variable '{diagnostic.name}' expects {diagnostic.expected}")
                        buffer.extend(f"[{diagnostic.detail}]") if diagnostic.detail != "" and expected_is_container
                        buffer.extend(f", got {diagnostic.actual}")
                        buffer.extend(f"[{diagnostic.detail}]") if diagnostic.detail != "" and not expected_is_container
                    DiagnosticKind.VoidArgument:
                        push_str(buffer, "argument ")
                        push_int(buffer, diagnostic.expected_count.i64())
                        buffer.extend(f" to '{diagnostic.name}' expects {diagnostic.expected}, got void") if diagnostic.expected != ""
                        buffer.extend(f" to '{diagnostic.name}' cannot be void") if diagnostic.expected == ""
                    DiagnosticKind.NonNumericShiftOperand:
                        push_str(buffer, "operator requires numeric operands")
                    DiagnosticKind.CompoundAssignNonNumeric:
                        push_str(buffer, "augmented assignment requires numeric operands")
                    DiagnosticKind.StringIndexNonNumeric:
                        buffer.extend(f"index must be numeric, got {diagnostic.actual}")
                    DiagnosticKind.VoidFieldAccess:
                        push_str(buffer, "field access requires struct type, got void")
                    DiagnosticKind.VoidIndex:
                        push_str(buffer, "indexing requires string, array, view, packed store, or reference type, got void")
                    DiagnosticKind.CallNonFunction:
                        buffer.extend(f"cannot call non-function value of type {diagnostic.actual}")
                    DiagnosticKind.ShiftOperandNonIntegral:
                        push_str(buffer, "operator requires integral operands")
                    DiagnosticKind.VoidOperand:
                        push_str(buffer, "operator requires numeric operands")
                    DiagnosticKind.VoidCondition:
                        buffer.extend(f"{diagnostic.name} condition must be bool, got void") if diagnostic.name != ""
                        push_str(buffer, "condition must be bool, got void") if diagnostic.name == ""
                    DiagnosticKind.TernaryBranchMismatch:
                        buffer.extend(f"ternary branches are incompatible: {diagnostic.expected} and {diagnostic.actual}")
                    DiagnosticKind.ArrayLiteralElementTypeMismatch:
                        buffer.extend(f"array literal element expects {diagnostic.expected}, got {diagnostic.actual}")
                    DiagnosticKind.StringIndexNonIntegral:
                        buffer.extend(f"index must be integral, got {diagnostic.actual}")
                    DiagnosticKind.VoidCollectionElement:
                        buffer.extend(f"darray literal element expects {diagnostic.expected}, got void") if diagnostic.expected != ""
                        push_str(buffer, "collection element cannot be void") if diagnostic.expected == ""
                    DiagnosticKind.VoidUnaryOperand:
                        push_str(buffer, "unary operator requires numeric operand")
                    DiagnosticKind.VoidMatchScrutinee:
                        push_str(buffer, "match requires an enum, const enum, error set, optional, integer, string, tuple, sequence, or struct value, got void")
                    DiagnosticKind.OrderingNonNumeric:
                        push_str(buffer, "comparison requires numeric operands")
                    DiagnosticKind.RangeBoundNonIntegral:
                        buffer.extend(f"range bounds must be integral, got {diagnostic.actual}")
                    DiagnosticKind.DArrayElementTypeMismatch:
                        buffer.extend(f"darray literal element expects {diagnostic.expected}, got {diagnostic.actual}")
                    DiagnosticKind.SetElementTypeMismatch:
                        buffer.extend(f"set literal element ")
                        push_int(buffer, diagnostic.actual_count.i64())
                        buffer.extend(f" has type {diagnostic.actual}, expected {diagnostic.expected}")
                    DiagnosticKind.DictValueTypeMismatch:
                        buffer.extend(f"dict literal value ")
                        push_int(buffer, diagnostic.actual_count.i64())
                        buffer.extend(f" has type {diagnostic.actual}, expected {diagnostic.expected}")
                    DiagnosticKind.DictKeyTypeMismatch:
                        buffer.extend(f"dict literal key ")
                        push_int(buffer, diagnostic.actual_count.i64())
                        buffer.extend(f" has type {diagnostic.actual}, expected {diagnostic.expected}")
                    DiagnosticKind.CallNamedNonFunction:
                        buffer.extend(f"cannot call non-function value of type {diagnostic.actual}")
                    DiagnosticKind.StructPatternTypeMismatch:
                        buffer.extend(f"struct pattern expects struct '{diagnostic.expected}', got '{diagnostic.name}'")
                    DiagnosticKind.MatchArmEnumMismatch:
                        buffer.extend(f"match arm expects enum '{diagnostic.name}', got '{diagnostic.expected}'")
                    DiagnosticKind.InvalidBoolCast:
                        buffer.extend(f"invalid cast from {diagnostic.expected} to {diagnostic.actual}")
                    DiagnosticKind.FieldImmutableAssign:
                        buffer.extend(f"field '{diagnostic.name}' is immutable")
                    DiagnosticKind.UngrantedPanic:
                        push_str(buffer, "warning: panic requires can[Abort] and has no explicit local effect grant; add can[Abort.Panic] or a surrounding can ...: block; missing required effect facts")
                    DiagnosticKind.UngrantedEffectCall:
                        # Full stage0 warning text when the effect ref is known; the
                        # generic wrap-it hint otherwise (callback-parameter sites).
                        buffer.extend(f"warning: call to \"{diagnostic.name}\" requires can[{diagnostic.actual}] and has no explicit local effect grant; add can[{diagnostic.expected}] or a surrounding can ...: block; missing required effect facts") if diagnostic.expected != ""
                        buffer.extend(f"call to '{diagnostic.name}' requires an enclosing effect grant; wrap it in a `can ...:` block") if diagnostic.expected == ""
                    DiagnosticKind.ContractNotFirst:
                        push_str(buffer, "`requires`/`ensure` contracts must be the first statements of the function body")
                    DiagnosticKind.ContractEnsureResultVoid:
                        push_str(buffer, "`ensure` references `result`, but this function returns void (no result value to bind)")
                    DiagnosticKind.DictKeyAffine:
                        buffer.extend(f"dict keys cannot contain linear handles, got {diagnostic.actual}")
                    DiagnosticKind.SetElementAffine:
                        buffer.extend(f"set elements cannot contain linear handles, got {diagnostic.actual}")
                    DiagnosticKind.AffineAddress:
                        match diagnostic.expected:
                            "Thread":
                                push_str(buffer, "cannot take address of thread handle")
                            _:
                                push_str(buffer, "cannot take address of linear value")
                    DiagnosticKind.AffineGlobal:
                        buffer.extend(f"global \"{diagnostic.name}\" cannot store linear handle values of type {diagnostic.expected}")
                    DiagnosticKind.AffineReference:
                        buffer.extend(f"references to values containing linear handles are not supported; got {diagnostic.expected}&")
                    DiagnosticKind.AffineUseAfterConsume:
                        match diagnostic.expected:
                            "match":
                                buffer.extend(f"linear handle value \"{diagnostic.name}\" cannot be used: usage facts were consumed by match over affine enum")
                            _:
                                buffer.extend(f"linear handle value \"{diagnostic.name}\" cannot be used after ownership was consumed")
                    DiagnosticKind.AffineMoveRequired:
                        match diagnostic.expected:
                            "ThreadPool":
                                buffer.extend(f"thread pool owner \"{diagnostic.name}\" must be moved explicitly before move into local \"{diagnostic.actual}\"")
                            "TaskGroup":
                                buffer.extend(f"task group owner \"{diagnostic.name}\" must be moved explicitly before move into local \"{diagnostic.actual}\"")
                            "ThreadCall":
                                buffer.extend(f"thread handle \"{diagnostic.name}\" must be moved explicitly before argument to call \"{diagnostic.actual}\"")
                            _:
                                buffer.extend(f"linear value \"{diagnostic.name}\" must be moved explicitly before move into local \"{diagnostic.actual}\"")
                    DiagnosticKind.AffineScopeExit:
                        buffer.extend(f"{diagnostic.expected} handle \"{diagnostic.name}\" must be consumed before scope exit")
                    DiagnosticKind.UnusedDecreases:
                        buffer.extend(f"warning: `decreases` on '{diagnostic.name}', which makes no direct recursive call; the termination clause is unused")
                    DiagnosticKind.GhostFieldDefault:
                        buffer.extend(f"ghost field '{diagnostic.name}' cannot have a default value (it is verification-only and erased, so it has no runtime initializer); assign it in a ghost contract context instead")
                    DiagnosticKind.GhostLocalRead:
                        buffer.extend(f"ghost variable \"{diagnostic.name}\" is verification-only and cannot be read by real code: it is erased from codegen, so it may appear only in contracts (requires/ensure/invariant/assert) or another `ghost` declaration")
                    DiagnosticKind.ConstEnumStorageNotInt:
                        buffer.extend(f"const enum '{diagnostic.name}' storage type must be an explicit integer type, got {diagnostic.expected}")
                    DiagnosticKind.ConstEnumValueOutOfRange:
                        buffer.extend(f"const enum member '{diagnostic.name}'.'{diagnostic.expected}' value ")
                        push_str(buffer, "-") if diagnostic.actual_count != 0
                        push_int(buffer, diagnostic.expected_count.i64())
                        buffer.extend(f" does not fit storage type {diagnostic.actual}")
                    DiagnosticKind.RaiseWithoutErrorSet:
                        push_str(buffer, "raise requires the current function to return an error union")
                    DiagnosticKind.RegionAnnotationOnScalarField:
                        buffer.extend(f"region annotation `@{diagnostic.actual}` is only supported on container, generic, and reference types")
                    DiagnosticKind.DuplicateBitGroupMember:
                        buffer.extend(f"duplicate packed group member '{diagnostic.name}' in {diagnostic.expected}.{diagnostic.actual}")
                    DiagnosticKind.NamedStatesWithoutDerive:
                        buffer.extend(f"struct '{diagnostic.name}' declares named states but is missing a derive state: block")
                    DiagnosticKind.DerivedStateConstructorMismatch:
                        buffer.extend(f"constructed {diagnostic.name} does not satisfy derived state {diagnostic.expected}")
                    DiagnosticKind.DerivedStateArgumentMismatch:
                        buffer.extend(f"argument to '{diagnostic.name}' expects {diagnostic.detail}[{diagnostic.expected}], got {diagnostic.detail}[{diagnostic.actual}]")
                    DiagnosticKind.UngrantedPointerCast:
                        push_str(buffer, "warning: ") if diagnostic.detail == "warn"
                        buffer.extend(f"pointer cast requires can[Unsafe] and has no explicit local effect grant; add can Unsafe.PointerCast or a surrounding can ...: block; missing required effect facts")
                    DiagnosticKind.DenseNodeKeyRootMismatch:
                        buffer.extend(f"node key and frozen store must share the same exact frozen store root")
                    DiagnosticKind.ThreadTransferStoreDependency:
                        buffer.extend(f"argument to \"{diagnostic.name}\" cannot cross thread boundary: store dependency facts require rebase to frozen/public store")
                    DiagnosticKind.ThreadTransferRegionDependency:
                        buffer.extend(f"argument to \"{diagnostic.name}\" cannot cross thread boundary: region dependency facts include local region \"{diagnostic.actual}\"")
                    DiagnosticKind.FlowFlagStateMachine:
                        buffer.extend(f"mutable bool flag '{diagnostic.name}' is written in multiple branches and read after the join; this encodes a state machine — flatten the flow")
                    DiagnosticKind.IfValueMissingElse:
                        buffer.extend(f"an `if` used as a value must have a final `else`")
                    DiagnosticKind.TuplePatternArityMismatch:
                        push_str(buffer, "tuple pattern expects ")
                        push_int(buffer, diagnostic.expected_count.i64())
                        push_str(buffer, " elements, got ")
                        push_int(buffer, diagnostic.actual_count.i64())
                    DiagnosticKind.OrPatternBindingMismatch:
                        buffer.extend(f"or-pattern alternatives must bind the same names")
                    DiagnosticKind.MembershipRhsContainer:
                        push_str(buffer, "membership operator requires a list literal or tokenset on the right-hand side, got ")
                        push_sview(buffer, diagnostic.actual if diagnostic.actual != "" else "container")
                        buffer.extend(f"[{diagnostic.detail}]") if diagnostic.detail != ""
                    DiagnosticKind.DarrayPushTypeMismatch:
                        buffer.extend(f"darray push expects {diagnostic.expected}, got {diagnostic.actual}")
                    DiagnosticKind.DictIndexKeyTypeMismatch:
                        buffer.extend(f"dict index expects key of type {diagnostic.expected}, got {diagnostic.actual}")
                    DiagnosticKind.InvalidCtorCast:
                        buffer.extend(f"invalid cast from {diagnostic.actual} to {diagnostic.expected}")
                    DiagnosticKind.NamespaceUsedAsValue:
                        buffer.extend(f"'{diagnostic.name}' is a namespace; write {diagnostic.name}::")
                        push_sview(buffer, diagnostic.expected if diagnostic.expected != "" else "member")
                        push_str(buffer, " (`::` accesses value members, `.` accesses namespaces)")
                    DiagnosticKind.PackedMoveStoreMismatch:
                        buffer.extend(f"packed enum move-as over '{diagnostic.expected}' requires store type '{diagnostic.expected}.Store', got {diagnostic.actual}.Store")
                    DiagnosticKind.RecordUpdateUnknownField:
                        buffer.extend(f"record update has no field '{diagnostic.name}'")
                    DiagnosticKind.ModuloOperandNonIntegral:
                        push_str(buffer, "operator requires integral operands")
                    DiagnosticKind.ArrayIndexNonIntegral:
                        buffer.extend(f"index must be integral, got {diagnostic.actual}")
                    DiagnosticKind.RangeStepZero:
                        push_str(buffer, "for loop range step cannot be zero")
                    DiagnosticKind.MoveStructPatternArityMismatch:
                        buffer.extend(f"move-as pattern '{diagnostic.name}' expects ")
                        push_int(buffer, diagnostic.expected_count.i64())
                        push_str(buffer, " bindings, got ")
                        push_int(buffer, diagnostic.actual_count.i64())
                    DiagnosticKind.LetDestructureUnknownField:
                        buffer.extend(f"struct \"{diagnostic.expected}\" has no field \"{diagnostic.name}\"")
                    DiagnosticKind.UnknownFunctionAnnotation:
                        buffer.extend(f"unknown function annotation @{diagnostic.name}")
                    DiagnosticKind.UnknownExternFunctionAnnotation:
                        buffer.extend(f"unknown extern function annotation @{diagnostic.name} on \"{diagnostic.expected}\"")
                    DiagnosticKind.TestFunctionParameters:
                        buffer.extend(f"@test function \"{diagnostic.name}\" must not take parameters")
                    DiagnosticKind.BenchFunctionNonVoidReturn:
                        buffer.extend(f"@bench function \"{diagnostic.name}\" must return void, got {diagnostic.actual}")
                    DiagnosticKind.GenericFixtureFunction:
                        buffer.extend(f"@fixture function \"{diagnostic.name}\" must not have type or shape parameters")
                    DiagnosticKind.GuardNonnullNonOptionalParam:
                        buffer.extend(f"@guard_nonnull on function \"{diagnostic.expected}\" requires a nullable reference or optional parameter, got {diagnostic.actual}")
                    DiagnosticKind.GenericInterfaceBoundUnsatisfied:
                        buffer.extend(f"type \"{diagnostic.actual}\" does not satisfy required interface fact \"{diagnostic.expected}\" for type argument")
                    DiagnosticKind.ExternBorrowUnknownParam:
                        buffer.extend(f"@borrows_return on extern function \"{diagnostic.expected}\" references unknown parameter \"{diagnostic.name}\"")
                    DiagnosticKind.ExternBorrowNonProvenanceParam:
                        buffer.extend(f"@borrows_return on extern function \"{diagnostic.expected}\" cannot borrow from parameter \"{diagnostic.name}\" of type {diagnostic.actual}")
                    DiagnosticKind.ExternBorrowFieldNonStructReturn:
                        buffer.extend(f"@borrows_return(field, …) on extern function \"{diagnostic.expected}\" requires a concrete struct return type, got {diagnostic.actual}")
                    DiagnosticKind.ExternBorrowUnknownReturnField:
                        buffer.extend(f"@borrows_return on extern function \"{diagnostic.expected}\" references unknown return field path \"{diagnostic.name}\" in {diagnostic.actual}")
                    DiagnosticKind.ThreadArgumentNotShareable:
                        buffer.extend(f"argument to \"{diagnostic.name}\" is not structurally shareable across threads: non-static reference")
                    DiagnosticKind.ThreadResultNotShareable:
                        buffer.extend(f"result of \"{diagnostic.name}\" is not structurally shareable across threads: non-static reference")
                    DiagnosticKind.ArraySliceEndOutOfBounds:
                        push_str(buffer, "constant slice end ")
                        push_int(buffer, diagnostic.actual_count.i64())
                        push_str(buffer, " out of bounds for array of length ")
                        push_int(buffer, diagnostic.expected_count.i64())
                    DiagnosticKind.ArraySliceReversed:
                        push_str(buffer, "constant slice start ")
                        push_int(buffer, diagnostic.expected_count.i64())
                        push_str(buffer, " is after end ")
                        push_int(buffer, diagnostic.actual_count.i64())
                    DiagnosticKind.RuntimeArraySize:
                        push_str(buffer, "array size must be a compile-time integer")
                    DiagnosticKind.FixedArrayShapeMismatch:
                        buffer.extend(f"return type expects {diagnostic.expected}[")
                        push_int(buffer, diagnostic.expected_count.i64())
                        buffer.extend(f"], got {diagnostic.actual}[")
                        push_int(buffer, diagnostic.actual_count.i64())
                        push_str(buffer, "]")
                    DiagnosticKind.ReadonlyViewIndexAssign:
                        push_str(buffer, "cannot assign to read-only view index result")
                    DiagnosticKind.StringViewIndexAssign:
                        push_str(buffer, "cannot assign to string view index")
                    DiagnosticKind.StringIndexAssign:
                        push_str(buffer, "cannot assign to string index")
                    DiagnosticKind.MutableViewFromReadonlySource:
                        push_str(buffer, "cannot create a mutable view from a read-only source")
                    DiagnosticKind.MutableIterationReadonlyView:
                        push_str(buffer, "mutable iteration requires a writable view")
                    DiagnosticKind.UnknownRegionBacking:
                        buffer.extend(f"unknown region backing \"{diagnostic.name}\"")
                    DiagnosticKind.RegionAnnotationOnNonRegionLocal:
                        buffer.extend(f"region annotation `@{diagnostic.actual}` on local '{diagnostic.name}' is invalid; this type cannot carry a region")
                    DiagnosticKind.UnknownRegionQualifier:
                        buffer.extend(f"unknown region qualifier \"{diagnostic.actual}\"")
                    DiagnosticKind.RegionQualifierMismatch:
                        buffer.extend(f"variable \"{diagnostic.name}\" expects {diagnostic.detail}& @{diagnostic.expected}, got {diagnostic.detail}& @{diagnostic.actual}")
                    DiagnosticKind.LocalRegionReferenceEscape:
                        buffer.extend(f"cannot return reference: region dependency facts include local region \"{diagnostic.actual}\"")
                    DiagnosticKind.RegionParamInferenceFailure:
                        buffer.extend(f"value tied to region parameter \"__rg_{diagnostic.name}\" cannot be returned with a region-less type (its lifetime is the caller's \"__rg_{diagnostic.name}\" region); annotate the return type with `@__rg_{diagnostic.name}` (e.g. `-> view[u8] @__rg_{diagnostic.name}`) so the borrow stays tied to the caller's region") if diagnostic.name != ""
                        buffer.extend(f"value tied to region parameter \"{diagnostic.actual}\" cannot be returned with a region-less type") if diagnostic.name == ""
                    DiagnosticKind.EmptyArrayWithoutContext:
                        push_str(buffer, "empty list literal requires an expected array or darray type")
                    DiagnosticKind.LegacyCastCallSyntax:
                        push_str(buffer, "legacy cast syntax `.cast[T]()` is no longer supported")
                    DiagnosticKind.RemovedRefShorthand:
                        push_str(buffer, "`x.ref[T]` reference shorthand has been removed")
                    DiagnosticKind.RemovedPackedAbiAnnotation:
                        buffer.extend(f"@packed_abi on enum \"{diagnostic.name}\" has been removed; use @packed_profile(canonical|retained_reads|build_heavy) instead")
                    DiagnosticKind.RemovedPackedPrefixAnnotation:
                        buffer.extend(f"@packed_prefix on enum \"{diagnostic.name}\" has been removed; use @packed_profile(canonical|retained_reads|build_heavy) instead")
                    DiagnosticKind.RemovedCbindPrefixAnnotation:
                        buffer.extend("@c_bind_prefix has been removed; use @c_bind with a trailing `prefix` flag, e.g. @c_bind(header, name, prefix)")
                    DiagnosticKind.OptionalComparison:
                        buffer.extend(f"cannot compare {diagnostic.expected}? and {diagnostic.actual}?: unwrap the optional first (compare against null, or bind the value with `if EXPR is NAME:`)")
                    DiagnosticKind.ForwardingVariadic:
                        buffer.extend(f"call argument forwarding `..` is not supported for variadic function \"{diagnostic.name}\"")
                    DiagnosticKind.IdUnwrapNonId:
                        buffer.extend(f"id unwrap operator requires id[T] operand, got {diagnostic.actual}")
                    DiagnosticKind.ReadOnlyViewAssign:
                        buffer.extend("cannot assign to read-only view index result")
                    DiagnosticKind.RowIdNonSoa:
                        buffer.extend(f"RowId expects an soa type argument, got {diagnostic.actual}")
                    DiagnosticKind.SparseRequiresSoa:
                        buffer.extend(f"enum \"{diagnostic.name}\": `(sparse)` requires `layout(soa)` (variant-sparse payload columns)")
                    DiagnosticKind.IterCalleeMutableRef:
                        buffer.extend(f"cannot pass \"{diagnostic.name}\" by mutable reference while it is being iterated: the callee may push/clear/relocate its buffer out from under the loop. Iterate by index up to a saved count, or collect into a separate darray first")
                    DiagnosticKind.LawSubjectTypeMismatch:
                        buffer.extend(f"argument 1 to \"{diagnostic.name}\" expects {diagnostic.expected}, got {diagnostic.actual}")
                    DiagnosticKind.CBindRequiresCLayout:
                        buffer.extend(f"@c_bind on struct \"{diagnostic.name}\" requires `layout(c)` so Elisa and C agree on ABI layout rules")
                    DiagnosticKind.CopyRuntimeLength:
                        buffer.extend(f"copy requires a statically known size; darray[{diagnostic.actual}] has a runtime length — use clone to copy it into a region-owned darray")
                    DiagnosticKind.CopyScalarTarget:
                        buffer.extend(f"copy target must be a fixed-size array[T, N] stack owner with a compile-time size; got {diagnostic.actual}")
                    DiagnosticKind.CopySizeMismatch:
                        buffer.extend(f"copy cannot copy array[{diagnostic.actual}, ")
                        push_int(buffer, diagnostic.expected_count.i64())
                        buffer.extend(f"] into array[{diagnostic.actual}, ")
                        push_int(buffer, diagnostic.actual_count.i64())
                        buffer.extend(f"] in v1")
                    DiagnosticKind.PackedStoreIndexAssign:
                        push_str(buffer, "cannot assign to packed store index result")
                    DiagnosticKind.PackedConstructorWithoutStore:
                        buffer.extend(f"packed enum constructor \"{diagnostic.name}.{diagnostic.expected}\" requires an active in {diagnostic.name}.Store: scope or explicit new[{diagnostic.name}.Store]")
                    DiagnosticKind.PackedFrozenStoreAllocation:
                        buffer.extend(f"packed enum allocation requires local store type \"{diagnostic.name}.Store[Local]\", got {diagnostic.name}.Store[Frozen]")
                    DiagnosticKind.PackedMatchMissingStore:
                        buffer.extend(f"packed enum match over \"{diagnostic.name}\" requires an in {diagnostic.name}.Store clause")
                    DiagnosticKind.PackedIfPatternMissingBinder:
                        push_str(buffer, "if pattern binder requires `as Enum.Variant(...)` after store expression")
                    DiagnosticKind.NonGenericSpecialization:
                        buffer.extend(f"function \"{diagnostic.name}\" is not generic")
                    DiagnosticKind.ReduceSumNonNumericCallback:
                        push_str(buffer, "reduce_sum callback must return a numeric accumulator")
                    DiagnosticKind.AtomicUnsafePayload:
                        buffer.extend(f"atomic payload type must satisfy atomic_safe(T), got {diagnostic.name}")
                    DiagnosticKind.AtomicRmwNonNumeric:
                        buffer.extend(f"argument to \"{diagnostic.name}\" requires atomic_numeric(T), got atomic[{diagnostic.actual}")
                        push_str(buffer, "&") if diagnostic.expected == "ref"
                        push_str(buffer, "]")
                    DiagnosticKind.OrdinaryMatchWithStore:
                        buffer.extend(f"ordinary enum match over \"{diagnostic.name}\" does not take an in-store clause")
                    DiagnosticKind.OrdinaryEnumBareVariantType:
                        buffer.extend(f"bare variant type \"{diagnostic.name}.{diagnostic.expected}\" requires a packed enum or tree category")
                    DiagnosticKind.NamedPatternOnUnnamedPayload:
                        buffer.extend(f"match arm \"{diagnostic.name}\" does not declare named payload fields")
                    DiagnosticKind.ErrorConstructorArgumentType:
                        buffer.extend("error constructor argument ")
                        push_int(buffer, diagnostic.expected_count.i64())
                        buffer.extend(f" to \"{diagnostic.actual}.{diagnostic.name}\" expects {diagnostic.expected}")
                    DiagnosticKind.AmbiguousBareRange:
                        push_str(buffer, "ambiguous bare `..` range: use `..<` for exclusive (e.g. `lo ..< hi`) or `..=` for inclusive (e.g. `lo ..= hi`)")
                    DiagnosticKind.WildcardArmNotFinal:
                        push_str(buffer, "wildcard match arm must be the final arm")
                    DiagnosticKind.DerivedStateRuleNotFieldBased:
                        buffer.extend(f"derived state rule for \"{diagnostic.name}\" must be a pure field-based expression over self")
                    DiagnosticKind.DarrayPushImmutableReceiver:
                        push_str(buffer, "darray push requires a mutable darray receiver")
                    DiagnosticKind.TupleIterableNotTuple:
                        buffer.extend(f"iterable for tuple pattern requires a tuple item, got {diagnostic.actual}")
                    DiagnosticKind.InvalidStructCast:
                        buffer.extend(f"invalid cast from {diagnostic.expected} to {diagnostic.actual}")
                    DiagnosticKind.BraceMembershipMisuse:
                        push_str(buffer, "brace membership set literals are only valid on the right-hand side of `in`")
                    DiagnosticKind.FreshShapeArgMismatch:
                        push_str(buffer, "return type") if diagnostic.name == "return"
                        buffer.extend(f"argument ") if diagnostic.name != "return"
                        push_int(buffer, diagnostic.expected_count.i64()) if diagnostic.name != "return"
                        buffer.extend(f" to \"{diagnostic.name}\"") if diagnostic.name != "return"
                        buffer.extend(f" expects darray[{diagnostic.expected}, {diagnostic.actual}], got darray[{diagnostic.expected}, {diagnostic.detail}")
                        push_str(buffer, "#") if diagnostic.actual_count != 0
                        push_int(buffer, diagnostic.actual_count.i64()) if diagnostic.actual_count != 0
                        push_str(buffer, "]")
                    DiagnosticKind.FreshShapeNote:
                        buffer.extend(f"note: {diagnostic.name} returns a fresh logical shape for {diagnostic.expected}")
                    DiagnosticKind.MatchArmsIncompatible:
                        buffer.extend(f"match expression arms are incompatible: {diagnostic.expected} and {diagnostic.actual}" if diagnostic.expected != "" else f"match expression arms are incompatible: <invalid> and {diagnostic.actual}")
                    DiagnosticKind.NonDecreasingMeasure:
                        buffer.extend(f"cannot prove the decreases measure strictly decreases at this recursive call to \"{diagnostic.name}\"; the function may not terminate (measure \"{diagnostic.expected}\" non-decreasing across the recursive call: {diagnostic.expected} -> {diagnostic.expected})")
                    DiagnosticKind.EnsureNotProven:
                        buffer.extend(f"postcondition of \"{diagnostic.name}\" is provably violated: ") if diagnostic.detail == "violated"
                        buffer.extend(f"ensure postcondition of \"{diagnostic.name}\" could not be proven statically at this point")
                    DiagnosticKind.ContractArgTypeMismatch:
                        push_str(buffer, "contract `")
                        buffer.extend(f"{diagnostic.name}` argument ")
                        push_int(buffer, diagnostic.expected_count.i64())
                        buffer.extend(f" ({diagnostic.detail}) expects {diagnostic.expected}, got {diagnostic.actual}")
                    DiagnosticKind.UsesPreconditionViolated:
                        buffer.extend(f"precondition of \"{diagnostic.name}\" is violated: the argument provably does not satisfy `requires`")
                    DiagnosticKind.UncheckedIndexUngranted:
                        push_str(buffer, "unchecked index requires can[Unsafe] and has no explicit local effect grant; add can Unsafe.UncheckedIndex or a surrounding can ...: block; missing required effect facts; for a checked access write `get ")
                        buffer.extend(f"{diagnostic.name}[i]` (propagates absence) or `{diagnostic.name}[i] else <fallback>` (handles it inline), or keep it unchecked with `trusted Unsafe.UncheckedIndex`")
                    DiagnosticKind.MutableAliasUngranted:
                        push_str(buffer, "mutable alias requires can[Unsafe] and has no explicit local effect grant; add can Unsafe.Alias or a surrounding can ...: block; missing required effect facts")
                    DiagnosticKind.PositionalConstruction:
                        buffer.extend(f"positional construction {diagnostic.name}(...) is not allowed; use the brace form {diagnostic.name}{{...}} for default field initialization, or define a constructor `def {diagnostic.name}(...) -> {diagnostic.name}`")
                    DiagnosticKind.EmptyListNeedsType:
                        push_str(buffer, "empty list literal requires an expected array or darray type")
                    DiagnosticKind.ZipMapSourceNotReadonly:
                        push_str(buffer, "zip_map requires source ")
                        push_int(buffer, diagnostic.expected_count.i64())
                        push_str(buffer, " to be a readonly contiguous exact-extent view; wrap it with readonly(...)")
                    DiagnosticKind.FlowStrictBlockIf:
                        push_str(buffer, "strict flow [-Wflow-strict]: block `if` statement — every decision must be a value, an exit, an arm, or a transition (docs/125 §6b). Use a postfix guard (`STMT if COND`), a value selection (`x = A if c else B`, `when`), a `match` arm, or a `machine` state; or state the exception with `can ComplexFlow:`")
                    DiagnosticKind.RefinementReturnNotProven:
                        buffer.extend(f"refinement on the return of '{diagnostic.name}' could not be proven statically; return a provable value or accept the runtime check")
                    DiagnosticKind.RefinementArgNotProven:
                        push_str(buffer, "refinement on argument ")
                        push_int(buffer, diagnostic.expected_count.i64())
                        buffer.extend(f" of '{diagnostic.name}' could not be proven statically; pass a provable value or accept the runtime check")
                    DiagnosticKind.RefineAliasCycle:
                        buffer.extend(f"refine alias \"{diagnostic.name}\" has a recursive or mutually-recursive base (cycle through \"{diagnostic.name}\")")
                    DiagnosticKind.WhereRefinementReassignViolated:
                        push_str(buffer, "where refinement on reassignment is violated")
                    DiagnosticKind.PreconditionViolated:
                        buffer.extend(f"precondition of \"{diagnostic.name}\" is violated: the argument provably does not satisfy `requires`")
                    DiagnosticKind.OwnedRegionNotConsumed:
                        buffer.extend(f"owned region \"{diagnostic.name}\" must be consumed before scope exit")
                    DiagnosticKind.OwnedRegionAlreadyDestroyed:
                        buffer.extend(f"region \"{diagnostic.name}\" has already been destroyed")
                    DiagnosticKind.OwnedRegionMoveOnly:
                        buffer.extend(f"owned region \"{diagnostic.name}\" is move-only: use `move {diagnostic.name}` to transfer ownership to \"{diagnostic.expected}\"")
                    DiagnosticKind.EnsuresArgNotEntailed:
                        buffer.extend(f"function \"{diagnostic.name}\" passed for parameter \"{diagnostic.expected}\" of \"{diagnostic.actual}\" does not satisfy its contract `ensures({diagnostic.expected}, ...)`: its declared `ensure` does not entail the required postcondition")
                    DiagnosticKind.EnsuresArgLambdaUnproven:
                        buffer.extend(f"lambda passed for parameter \"{diagnostic.expected}\" of \"{diagnostic.actual}\" does not satisfy its contract `ensures({diagnostic.expected}, ...)`: its result is not provably within the required postcondition")
                    DiagnosticKind.EnsuresTargetNotFn:
                        buffer.extend(f"ensures({diagnostic.name}, ...) names \"{diagnostic.name}\", which is not a function-typed parameter of \"{diagnostic.actual}\"")
                    DiagnosticKind.ProofBlockImpure:
                        push_str(buffer, "a proof block may contain only verification-only statements (lemma calls, nested `assert`s, `invariant`s); a statement with real effects is not allowed because the block is erased from code")
                    DiagnosticKind.DecreasesLoopNotDecreasing:
                        push_str(buffer, "loop `decreases` measure could not be proven to strictly decrease and stay >= 0 on every iteration; falling back to the runtime loop-progress check")
                    DiagnosticKind.OverlayFieldWidthMismatch:
                        buffer.extend(f"overlay-field-width-mismatch: field {diagnostic.expected}.{diagnostic.name} has ")
                        push_int(buffer, diagnostic.expected_count.i64())
                        push_str(buffer, "-byte width, which has no MemoryManager_ReadU<N> form (expected 1, 2, 4, or 8)")
                    DiagnosticKind.OverlayFieldNeedsSizeGuard:
                        buffer.extend(f"overlay-field-needs-size-guard: field {diagnostic.expected}.{diagnostic.name} requires size >= ")
                        push_int(buffer, diagnostic.expected_count.i64())
                        push_str(buffer, ", and this access has no dominating size guard")
                    DiagnosticKind.QuantifiedRefinementUnproven:
                        buffer.extend(f"quantified refinement \"{diagnostic.name}\" on \"{diagnostic.actual}\" could not be proven statically (it has no runtime check); enable -smt or strengthen the facts")
                    DiagnosticKind.RegionTiedReturn:
                        buffer.extend(f"value tied to region parameter \"{diagnostic.expected}\" cannot be returned with a region-less type (its lifetime is the caller's region for that parameter); declare the tie with a region-polymorphic signature (def f[@r](p: T& @r) -> R @r)") if diagnostic.expected != ""
                        buffer.extend(f"value tied to region parameter \"__rg_{diagnostic.name}\" cannot be returned with a region-less type (its lifetime is the caller's region for that parameter); declare the tie with a region-polymorphic signature (def f[@r](p: T& @r) -> R @r)") if diagnostic.expected == ""
                    DiagnosticKind.LoopInvariantNotPreserved:
                        push_str(buffer, "loop invariant is established on entry but could not be proven preserved by the loop body; it is only checked at runtime")
                    DiagnosticKind.LemmaEnsureUnproven:
                        buffer.extend(f"lemma \"{diagnostic.name}\" does not prove its `ensure`: a lemma is erased from code, so every postcondition must follow statically from its `requires` and body (add intermediate `assert`s, call a helper lemma, or strengthen `requires`)")
                    DiagnosticKind.AssertByUnproven:
                        push_str(buffer, "`assert … by:` condition could not be proven from its proof block; the block's facts plus the caller's facts must entail it (add intermediate `assert`s or call a helper `lemma`)")
                    DiagnosticKind.LocalRefinementUnproven:
                        buffer.extend(f"refinement \"{diagnostic.name}\" on \"{diagnostic.actual}\" could not be proven statically")
                    DiagnosticKind.UnboundedStringErasure:
                        buffer.extend(f"casting an interior pointer of a sized darray to an unbounded string ({diagnostic.actual}) erases its length; a static_strlen / C-string scan can read past the darray into adjacent memory (out-of-bounds, nondeterministic). Prefer a length-bounded view (sview), or copy bounded bytes into a fresh allocation")
                    DiagnosticKind.InteriorPointerWiden:
                        buffer.extend(f"casting an interior pointer of a byte darray to {diagnostic.actual}& reinterprets the darray as a wider value; reading it accesses more bytes than the index bounds and can read past the darray (out-of-bounds, nondeterministic). Bounds-check the offset against the buffer length, or copy the bytes into a properly typed value")
                    DiagnosticKind.ConflictingImport:
                        buffer.extend(f"conflicting import: \"{diagnostic.name}\" is already imported from \"{diagnostic.expected}\", cannot also import it from \"{diagnostic.actual}\"; a name may be selectively imported from only one module")
                    DiagnosticKind.MeasureShapeLawInValueIs:
                        buffer.extend(f"\"{diagnostic.name}\" is a {diagnostic.actual} law; apply it to a function with `fulfills {diagnostic.name}`, not with `is` in a value position")
                    DiagnosticKind.DeferBodyReturns:
                        buffer.extend("defer body cannot return from the enclosing function")
                    DiagnosticKind.DeferFunctionNotOutermost:
                        buffer.extend("defer function is currently only supported in the outermost function scope")
                    DiagnosticKind.LawNeedsSubject:
                        buffer.extend(f"law \"{diagnostic.name}\" needs a subject: give it at least one value parameter (conventionally `self`)")
                    DiagnosticKind.EnumRefinesNonEnum:
                        buffer.extend(f"enum \"{diagnostic.name}\" can only refine another enum with `is`, but \"{diagnostic.actual}\" is {diagnostic.actual}")
                    DiagnosticKind.MutateWhileIterating:
                        buffer.extend(f"cannot mutate \"{diagnostic.name}\" while it is being iterated: darray {diagnostic.actual} of {diagnostic.name} would move its buffer out from under the loop. Iterate by index up to a saved count, collect into a separate darray, or back it with a stable region (reserve_commit/fixed)")
                    DiagnosticKind.IndexFallbackTypeMismatch:
                        buffer.extend(f"index fallback expects {diagnostic.expected}, got {diagnostic.actual}")
                    DiagnosticKind.CastConstantTruncated:
                        push_str(buffer, "constant ")
                        push_str(buffer, "-") if diagnostic.expected == "neg"
                        push_int(buffer, diagnostic.expected_count.i64())
                        buffer.extend(f" does not fit in {diagnostic.actual} and is truncated by this cast")
                    DiagnosticKind.StructuralDecreasesUnproven:
                        buffer.extend(f"cannot prove structural `decreases` for \"{diagnostic.name}\": recursive calls must pass values bound from a match on the decreasing enum parameter")
                    DiagnosticKind.AutoRegionStoreEscape:
                        push_str(buffer, "value escapes its `in auto:` scope via store into longer-lived storage; the inferred region is freed at scope exit. Give it an explicit lifetime — copy it into a caller-provided region param (def f[@r] ... -> ... @r) or a longer-lived region")
                    DiagnosticKind.RegionStoreEscape:
                        buffer.extend(f"value in region \"{diagnostic.actual}\" is stored into longer-lived region \"{diagnostic.expected}\"; region \"{diagnostic.actual}\" is freed first, leaving a dangling reference. Copy it into region \"{diagnostic.expected}\" (or a region that outlives \"{diagnostic.expected}\") before storing")
                    DiagnosticKind.ArenaGrowEscape:
                        buffer.extend(f"darray {diagnostic.name} grows a non-local darray from local arena \"{diagnostic.expected}\"; its backing buffer is freed when \"{diagnostic.expected}\" goes out of scope (use-after-free). Allocate from a persistent arena instead (a global Arena, or an Arena& parameter owned by the caller)")
                    DiagnosticKind.OverlayUnknownField:
                        buffer.extend(f"overlay-unknown-field: field {diagnostic.name} is not declared in layout {diagnostic.expected}; add the field or correct the access")
                    DiagnosticKind.StructFieldWhereRefScope:
                        buffer.extend(f"struct field where refinement on \"{diagnostic.name}\" may only reference the field itself or earlier-declared fields; \"{diagnostic.actual}\" is not available here (later fields are not in scope at this point)")
                    DiagnosticKind.LocalWhereRefinementViolated:
                        push_str(buffer, "local where refinement is violated")
                    DiagnosticKind.StructFieldRefinementViolated:
                        of_phrase = f" of {diagnostic.expected}" if diagnostic.expected != "" else f""
                        buffer.extend(f"where refinement on field \"{diagnostic.name}\"{of_phrase} is violated")
                    DiagnosticKind.RegionReturnEscape:
                        buffer.extend(f"value allocated in region \"{diagnostic.actual}\" escapes via return; the region is freed at scope exit. Copy it into a caller-provided region param (def f[@r] ... -> ... @r) or a longer-lived region")
                    DiagnosticKind.DviewRemoved:
                        push_str(buffer, "`dview[T]` has been removed; use `view[T]`")
                    DiagnosticKind.NoallocArguments:
                        buffer.extend(f"@noalloc on function \"{diagnostic.name}\" does not take arguments")
                    DiagnosticKind.HotContract:
                        hot_reason = f"chases raw pointers or dispatches indirectly through a heap reference" if diagnostic.expected == "pointer" else f"allocates or frees on the hot path (via the `Memory.Allocate` effect)"
                        buffer.extend(f"@hot function \"{diagnostic.name}\" {hot_reason}")
                    DiagnosticKind.DecreasesStarReason:
                        push_str(buffer, "`decreases *` requires a non-empty reason string explaining why termination is unbounded")
                    DiagnosticKind.DecreasesRuntimeUnmodelable:
                        push_str(buffer, "warning: loop `decreases` measure could not be proven: the body has effects this analyzer cannot model (calls, non-arithmetic writes, or control flow); falling back to the runtime loop-progress check")
                    DiagnosticKind.DeprecatedFunctionUse:
                        default_note = f"this function is deprecated" if diagnostic.actual == "" else f"{diagnostic.actual}"
                        buffer.extend(f"deprecated: call to \"{diagnostic.name}\" — {default_note}")
                    DiagnosticKind.InAutoDeprecated:
                        push_str(buffer, "`in auto:` is deprecated; remove the block and rely on region inference, or use `region NAME(size):` for an explicit scope")
                    DiagnosticKind.NewAutoDeprecated:
                        push_str(buffer, "`new[auto]` is deprecated; use `new` instead")
                    DiagnosticKind.ContradictoryRequires:
                        buffer.extend(f"the `requires` preconditions of \"{diagnostic.name}\" are contradictory (their conjunction is unsatisfiable); the function can never be called and its body can vacuously prove any `ensure`")
                    DiagnosticKind.PermissionReservedName:
                        buffer.extend(f"\"{diagnostic.name}\" is the reserved top permission and cannot be declared")
                    DiagnosticKind.HotArgument:
                        buffer.extend(f"@hot on function \"{diagnostic.name}\" only accepts the optional `alloc` argument")
                    DiagnosticKind.NoBoundsCheckUnproven:
                        buffer.extend(f"function \"{diagnostic.name}\" `fulfills NoBoundsChecks` but has an index access that is not statically proven in-bounds, so a runtime bounds check would be emitted")
                    DiagnosticKind.HotVectorize:
                        buffer.extend(f"@hot kernel \"{diagnostic.name}\" will not vectorize: its buffers are not provably disjoint, so LLVM keeps the runtime alias-guard around the element loop")
                    DiagnosticKind.IntrinsicNamePrefix:
                        buffer.extend(f"@intrinsic on extern function \"{diagnostic.name}\" expects an LLVM intrinsic name starting with \"llvm.\"")
                    DiagnosticKind.TrustedExternReason:
                        buffer.extend(f"@trusted on extern function \"{diagnostic.name}\" requires exactly one non-empty reason string explaining why the unverified native body is trusted")
                    DiagnosticKind.ExternLinkNameConflict:
                        buffer.extend(f"extern link_name \"{diagnostic.expected}\" for \"{diagnostic.name}\" has a signature that conflicts with a previous declaration sharing that link_name; use one shared declaration or matching wrapper to avoid native symbol splitting")
                    DiagnosticKind.LmutMutationNotReassignment:
                        buffer.extend(f"mutation of `lmut` value \"{diagnostic.name}\" must be a reassignment (docs/120 §10): write `{diagnostic.name} <- ...` (or a `rebind` binding) so the threaded value is claimed back")
                    DiagnosticKind.IntegerLiteralOverflow:
                        push_str(buffer, "integer literal ")
                        push_str(buffer, "-") if diagnostic.expected == "neg"
                        push_int(buffer, diagnostic.expected_count.i64())
                        push_str(buffer, " does not fit in ")
                        push_sview(buffer, diagnostic.actual)
                    DiagnosticKind.ConstEnumValueOverflow:
                        push_str(buffer, "const enum member \"")
                        push_sview(buffer, diagnostic.expected)
                        push_str(buffer, "\".\"")
                        push_sview(buffer, diagnostic.name)
                        push_str(buffer, "\" value ")
                        push_int(buffer, diagnostic.expected_count.i64())
                        push_str(buffer, " does not fit storage type ")
                        push_sview(buffer, diagnostic.actual)
                    DiagnosticKind.RefinementBoundViolated:
                        param_subject = f"parameter \"{diagnostic.actual}\"" if diagnostic.expected == "param" else f"\"{diagnostic.actual}\""
                        return_or_param = f"the returned value" if diagnostic.expected == "return" else param_subject
                        subject = f"the struct field value" if diagnostic.expected == "field" else return_or_param
                        buffer.extend(f"refinement \"{diagnostic.name}\" is violated: {subject} does not satisfy it")
                    DiagnosticKind.RawConcurrencySurfaceRemoved:
                        match diagnostic.name:
                            "cond_wait":
                                buffer.extend("raw concurrency surface removed: `cond_wait` is legacy raw condition-variable surface; use `predicate_wait(cv, move guard, predicate)` or a domain-specific typed predicate wait over protected state")
                            "notify_one" | "notify_all":
                                buffer.extend(f"raw concurrency surface removed: `{diagnostic.name}` is legacy raw notification surface; use `predicate_notify_one` / `predicate_notify_all` or a domain-specific notifier tied to the protected-state predicate")
                            "spawn_raw" | "join_raw" | "detach_raw":
                                buffer.extend(f"raw concurrency surface removed: `{diagnostic.name}` is legacy raw thread surface; use `nursery:` / `nursery workers(N):`, a `pool` scope, or a linear typed Thread handle that is joined at a clear boundary")
                            "spawn1":
                                buffer.extend("raw concurrency surface removed: `spawn1` is low-level escaped-task surface; prefer `nursery:` / `nursery workers(N):`, the data-parallel `each(slice, worker)` / `reduce(slice, identity, op)` combinators, or a pool/task-group batch unless the linear Thread handle intentionally escapes")
                            "pool_submit1":
                                buffer.extend("raw concurrency surface removed: `pool_submit1` is low-level pool submission surface; prefer `nursery:`, a `pool` scope, the data-parallel `each(slice, worker)` / `reduce(slice, identity, op)` combinators, or task-group structure unless the Pending task handle is intentionally managed")
                            "detach":
                                buffer.extend("raw concurrency surface removed: `detach` is a detached-task escape hatch; keep work in `nursery:` / pool scope or prove captured state is static/share-safe before using a detached escape")
                            _:
                                buffer.extend(f"raw concurrency surface removed: `{diagnostic.name}` is legacy raw atomic surface; use `AtomicCell[T]` helpers or a named protocol type that owns the memory-ordering invariant")
                    DiagnosticKind.ParameterWhereRefScope:
                        buffer.extend(f"parameter where refinement may only reference its parameter and earlier parameters: \"{diagnostic.name}\" is not available here")
                    DiagnosticKind.FuncShadowsBuiltinType:
                        buffer.extend(f"function \"{diagnostic.name}\" shadows the builtin type name \"{diagnostic.name}\"; a call `{diagnostic.name}(...)` resolves to the type cast, not this function, so this function can never be called")
                    DiagnosticKind.AsyncEntryAnnotation:
                        buffer.extend(f"@async_entry function \"{diagnostic.name}\" enters with unknown segment owner; add @segment_agnostic or @segment_establishing so host/guest %fs assumptions are explicit" if diagnostic.expected == "segment" else f"@async_entry function \"{diagnostic.name}\" can interrupt arbitrary code; add @reentrant_safe so the async path is transitively lock-free/reentrant")
                    DiagnosticKind.ReentrantSafeCall:
                        buffer.extend(f"@reentrant_safe code cannot call \"{diagnostic.name}\" because it is not marked @reentrant_safe")
                    DiagnosticKind.DuplicateExportName:
                        buffer.extend(f"duplicate export name \"{diagnostic.name}\"")
                    DiagnosticKind.ExportTargetUndefined:
                        buffer.extend(f"export target \"{diagnostic.name}\" is undefined")
                    DiagnosticKind.MutableGlobalUngranted:
                        buffer.extend(f"mutable global access requires can[Unsafe] and has no explicit local effect grant; add can Unsafe.MutableGlobal or a surrounding can ...: block; missing required effect facts")
                    DiagnosticKind.PointerArithmeticUngranted:
                        buffer.extend(f"pointer arithmetic requires can[Unsafe] and has no explicit local effect grant; add can Unsafe.PointerArithmetic or a surrounding can ...: block; missing required effect facts")
                    DiagnosticKind.PushLoopExtendable:
                        buffer.extend(f"loop pushes onto \"{diagnostic.name}\" one element per iteration; prefer the declarative fill `{diagnostic.name}.extend([...])`, which fuses into a single presize-and-fill (no repeated reallocation, and the filter-free form auto-vectorizes). If the accumulation is genuinely incremental (early exit, interleaved writes, stateful), keep the push loop")
                    DiagnosticKind.CharClassifierGuard:
                        buffer.extend(f"char classifier \"{diagnostic.name}\" is not foldable to a lookup table because an arm carries a guard; a guardless total classifier over literal/range/tag patterns compiles to a single 256-byte indexed load (docs/125 §9)")
                    DiagnosticKind.ContractImpureGlobalRead:
                        buffer.extend(f"{diagnostic.expected} clause must be pure but uses the `Global.Read` effect; a contract may not perform effects (no IO, allocation, mutation, time, or randomness) — an effectful or non-deterministic clause is unsound because the verifier treats a spec-position call as a single deterministic value")
                    DiagnosticKind.UninitializedZeroedRead:
                        buffer.extend(f"use of uninitialized variable \"{diagnostic.name}\": it was declared `= zeroed` and never assigned before this read; assign it (or a field of it) first")
                    DiagnosticKind.RedundantEffectGrant:
                        buffer.extend(f"can block grants can {diagnostic.name} redundantly; a surrounding can ...: block already grants these effects")
                    DiagnosticKind.FlowElifLadder:
                        push_str(buffer, "flow warning [-Wflow]: ")
                        push_int(buffer, diagnostic.expected_count.i64())
                        buffer.extend(f"-arm elif ladder testing `{diagnostic.name}` for equality against literals — this is a decision table; `when {diagnostic.name}:` declares the disjointness and totality the ladder only implies (docs/125 §4). To keep the ladder, wrap it in `can ComplexFlow:`")
                    DiagnosticKind.FlowNestingDepth:
                        push_str(buffer, "flow warning [-Wflow]: conditional nesting deeper than 3 levels in this loop body — a decision tree hiding a state machine. Either name the states and dispatch once (`match mode:` with a single guard per arm), or extract the inner decision into a named function so each level reads as one step. To keep the nesting, wrap the loop in `can ComplexFlow:`")
                    DiagnosticKind.FlowRetestLadder:
                        push_str(buffer, "flow warning [-Wflow]: ")
                        push_int(buffer, diagnostic.expected_count.i64())
                        push_str(buffer, " nested `if … is PATTERN:` probes, each re-probing a value bound by the previous pattern — this is one deep pattern; write it as a single `match` arm (docs/122 nested patterns: `Expr.Unary(TokenKind.Minus, Expr.IntLit(v), _)`). To keep the ladder, wrap it in `can ComplexFlow:`")
                    DiagnosticKind.FlowStateFlag:
                        buffer.extend(f"flow warning [-Wflow]: loop-carried flag `{diagnostic.name}` encodes an untyped state machine — it is compared against literals and reassigned in multiple branches. Name the states in an enum and dispatch on them. To keep it as-is, wrap the loop in `can ComplexFlow:`")
                    DiagnosticKind.FlowSingleMutation:
                        buffer.extend(f"flow warning [-Wflow]: loop-carried `{diagnostic.name}` is mutated by two or more separate branches in sequence — on the path where both fire it changes twice, and the outcome is coupled to the order the branches were written. Compute the whole delta in one place and apply it once. (R6 is advisory — it never fails a build. To silence it, wrap the loop in `can ComplexFlow:`.)")
                    DiagnosticKind.FlowExitBudget:
                        buffer.extend(f"flow warning [-Wflow]: this loop exits with more than two structurally different results — an untyped sum type the caller must decode from the value's shape. Make the cases explicit so every exit builds one result or raises a typed error. To keep the multiple shapes, wrap the loop in `can ComplexFlow:`.")
                    DiagnosticKind.FlowProgress:
                        buffer.extend(f"flow warning [-Wflow]: this loop branch neither advances a cursor, changes loop state, nor exits — the loop can spin forever on this path. Advance the cursor, transition the mode, or exit (`return`/`break`/`raise`) on every branch. If the branch is deliberately a no-op that another path will make progress from, wrap the loop in `can Unsafe.AssumeProgress:`.")
                    DiagnosticKind.FrameConditionConformance:
                        buffer.extend(f"impl method \"{diagnostic.name}\" writes \"{diagnostic.expected}\", which is outside the declared changes set of the interface method it implements — an impl may not change more than the interface permits (docs/87)")
                    DiagnosticKind.WritesOutsideChanges:
                        frame_place = f"{diagnostic.name}.{diagnostic.actual}" if diagnostic.actual != "" else f"{diagnostic.name}"
                        buffer.extend(f"may write {frame_place}, which is outside the `changes` set of \"{diagnostic.expected}\"" if diagnostic.expected_count == 1 else f"writes to {frame_place}, which is outside the `changes` set of \"{diagnostic.expected}\"")
                    DiagnosticKind.PreservesChangesConflict:
                        buffer.extend(f"`preserves {diagnostic.name}.{diagnostic.actual}` conflicts with `changes {diagnostic.name}`: a place cannot be both preserved and changed")
                    DiagnosticKind.WritesPreservedPlace:
                        buffer.extend(f"writes to {diagnostic.name}.{diagnostic.actual}, which \"{diagnostic.expected}\" `preserves`")
                    DiagnosticKind.RefineAliasNonBinder:
                        buffer.extend(f"refine alias \"{diagnostic.name}\" may only be used in a binder position (parameter, return, or local declaration), not as an ordinary type")
                    DiagnosticKind.RefineAliasImpureArg:
                        push_str(buffer, "refine alias argument must be a pure value expression (identifier or field path), not an impure or complex type expression")
                    DiagnosticKind.UnknownInterface:
                        buffer.extend(f"unknown interface \"{diagnostic.name}\"")
                    DiagnosticKind.LmutValueArg:
                        push_str(buffer, "argument ")
                        push_int(buffer, diagnostic.expected_count.i64())
                        push_str(buffer, " to \"")
                        push_sview(buffer, diagnostic.name)
                        push_str(buffer, "\" expects mutable ")
                        push_sview(buffer, diagnostic.expected)
                        push_str(buffer, "&, got ")
                        push_sview(buffer, diagnostic.expected)
                    DiagnosticKind.MatchArmEnumType:
                        buffer.extend(f"match arm expects enum \"{diagnostic.expected}\" or a refinement of it, got \"{diagnostic.name}\"")
                    DiagnosticKind.IsUnrelatedEnum:
                        buffer.extend(f"is expects \"{diagnostic.expected}\" or a refinement of it, got unrelated enum \"{diagnostic.name}\"")
                    DiagnosticKind.StaticCallContext:
                        buffer.extend(f"static function \"{diagnostic.name}\" can only be called from a static context")
                    DiagnosticKind.EffectLawViolation:
                        buffer.extend(f"function \"{diagnostic.name}\" `fulfills {diagnostic.expected}` but uses the `{diagnostic.actual}` effect, which {diagnostic.expected} forbids")
                    DiagnosticKind.CompositeLawCyclic:
                        buffer.extend(f"composite law \"{diagnostic.name}\" is cyclic: it transitively includes itself")
                    DiagnosticKind.CompositeLawBadMember:
                        buffer.extend(f"composite law \"{diagnostic.name}\" includes \"{diagnostic.expected}\", which is a {diagnostic.actual} law; `includes` composes only function-level laws (effect, shape)")
                    DiagnosticKind.EffectLawSubject:
                        buffer.extend(f"\"{diagnostic.name}\" constrains the whole function; write `fulfills {diagnostic.name}`, not `fulfills SUBJECT is {diagnostic.name}`")
                    DiagnosticKind.EffectLawValueIs:
                        buffer.extend(f"\"{diagnostic.name}\" is an effect law; apply it to a function with `fulfills {diagnostic.name}`, not with `is` in a value position")
                    DiagnosticKind.FulfillsRequiresFrame:
                        buffer.extend(f"`fulfills` requires a frame law (a `changes`/`preserves` law); \"{diagnostic.name}\" is a value law — use it with `is` in a refinement position instead")
                    DiagnosticKind.FrameLawPreserveWrite:
                        buffer.extend(f"writes to {diagnostic.name}.{diagnostic.actual}, which \"{diagnostic.expected}\" `preserves`")
                    DiagnosticKind.FrameLawValueIs:
                        buffer.extend(f"\"{diagnostic.name}\" is a frame law; apply it to a function with `fulfills SUBJECT is {diagnostic.name}`, not with `is` in a value position")
                    DiagnosticKind.FrameLawSelfNonRef:
                        buffer.extend(f"`changes/preserves {diagnostic.expected}` has no effect: \"self\" in law \"{diagnostic.name}\" is not a mutable reference parameter (only writes through a ref reach the caller)")
                    DiagnosticKind.RecursiveProofDeclined:
                        buffer.extend(f"recursive proof declined: callee requires for \"{diagnostic.name}\" could not be proven at this recursive call")
                    DiagnosticKind.StaticAssertFailed:
                        buffer.extend(f"static assert failed: {diagnostic.name}" if diagnostic.name != "" else f"static assert failed")
                    DiagnosticKind.AssertConditionNonBool:
                        buffer.extend(f"assert condition must be bool, got {diagnostic.actual}")
                    DiagnosticKind.SetElementUnsupported:
                        buffer.extend(f"runtime-backed set elements must be cstr, an integer type, bool, or a const enum (any type with value equality); floats and aggregates are unsupported; got element type in set[{diagnostic.actual}]")
                    DiagnosticKind.ErrorUnionUnhandled:
                        buffer.extend(f"error union result must be handled with `try`, `match`, or `catch`; discarding it with `_ =` swallows the error" if diagnostic.actual == "discard" else f"error union result must be handled with `try`, `match`, or `catch`, or propagated with `return`; it cannot be silently dropped")
                    DiagnosticKind.WhereRefinementNonBool:
                        buffer.extend(f"where refinement predicate must be bool, got {diagnostic.actual} (subject type is {diagnostic.expected}); write a bool expression such as `n where n > 0`")
                    DiagnosticKind.TryWithoutElseNonErrorFunction:
                        push_str(buffer, "try without else requires the current function to return an error union")
                    DiagnosticKind.FlagsConstEnumArg:
                        buffer.extend(f"Flags[T] expects a const enum type argument, got {diagnostic.actual}")
                    DiagnosticKind.InboundsUnproven:
                        buffer.extend(f"@inbounds function \"{diagnostic.name}\" has an index access that is not statically proven in-bounds, so a runtime bounds check would be emitted; prove the index (iterate with `for x in coll`, or guard with a bound the prover understands, e.g. `if i < coll.count:` or a `requires` refinement)")
                    DiagnosticKind.InteriorRefConsumed:
                        buffer.extend(f"interior reference \"{diagnostic.name}\" cannot be used: usage facts were consumed by argument to call \"{diagnostic.expected}\"")
                    DiagnosticKind.BoundaryPointerArgsType:
                        buffer.extend(f"@boundary_pointer_args on function \"{diagnostic.name}\" marks \"{diagnostic.expected}\" as an address-space pointer, but its type is {diagnostic.actual}; use a typed address-space carrier such as GuestVAddr[T], HostPtr[T], or NativeMappedGuestPtr[T] at the unsafe boundary and resolve before host dereference")
                    DiagnosticKind.ErrorSetParamUninferable:
                        buffer.extend(f"cannot infer error-set parameter \"{diagnostic.expected}\" for call to \"{diagnostic.name}\"; pass a fallible callback whose error set it can bind to")
                    DiagnosticKind.FulfillsWholeFunction:
                        buffer.extend(f"\"{diagnostic.name}\" constrains the whole function; write `fulfills {diagnostic.name}`, not `fulfills {diagnostic.expected} is {diagnostic.name}`")
                    DiagnosticKind.PermissionUnknownFamily:
                        buffer.extend(f"permission \"{diagnostic.name}\" includes unknown family \"{diagnostic.expected}\"")
                    DiagnosticKind.PermissionCycle:
                        buffer.extend(f"permission \"{diagnostic.name}\" has a cyclic `includes` chain through \"{diagnostic.expected}\"")
                    DiagnosticKind.CanCastUnsound:
                        buffer.extend(f"`as {diagnostic.name}` is unsound: \"{diagnostic.name}\" does not subsume \"{diagnostic.expected}\"; declare `permission {diagnostic.name}: includes {diagnostic.actual}` (or add it to the `alias {diagnostic.name}` set) or use `trusted`")
                    DiagnosticKind.ChangesTargetNotParam:
                        buffer.extend(f"`changes` target \"{diagnostic.name}\" is not a parameter")
                    DiagnosticKind.RefinementNotALaw:
                        buffer.extend(f"ensures \"{diagnostic.name}\" is not a law" if diagnostic.expected == "ensures" else f"refinement predicate \"{diagnostic.name}\" is not a law")
                    DiagnosticKind.SegmentAgnosticGrant:
                        push_str(buffer, "@segment_agnostic code cannot grant Segment.Host, Segment.Guest, or Unsafe.SegmentMutation; route segment establishment through a @segment_establishing entry thunk")
                    DiagnosticKind.OptionalLiteralCompare:
                        buffer.extend(f"cannot compare {diagnostic.name}? and {diagnostic.expected}: unwrap the optional first (compare against null, or bind the value with `if EXPR is NAME:`)" if diagnostic.actual == "L" else f"cannot compare {diagnostic.expected} and {diagnostic.name}?: unwrap the optional first (compare against null, or bind the value with `if EXPR is NAME:`)")
                    DiagnosticKind.UnsupportedCallConv:
                        buffer.extend(f"unsupported calling convention \"{diagnostic.name}\" on function \"{diagnostic.expected}\"")
                    DiagnosticKind.ExternSegmentTransition:
                        buffer.extend(f"extern function \"{diagnostic.name}\" mutates the active segment; add @segment_transition(host) or @segment_transition(guest) so the resulting owner is a typed contract, not inferred from permissions")
                    DiagnosticKind.SegmentOwnerMismatch:
                        buffer.extend(f"segment owner mismatch: call to \"{diagnostic.name}\" requires Segment.{diagnostic.expected} but current ambient segment is Segment.{diagnostic.actual}")
                    DiagnosticKind.ContractNoSubject:
                        buffer.extend(f"contract `{diagnostic.name}` must declare at least one parameter (the subject its clauses constrain)")
                    DiagnosticKind.TypestateArgMismatch:
                        buffer.extend(f"argument 1 to \"{diagnostic.name}\" expects the subject in typestate {diagnostic.expected}, but its tracked state does not match (typestate transition called out of order)")
                    DiagnosticKind.NamedArgError:
                        buffer.extend(f"function \"{diagnostic.name}\" has no parameter \"{diagnostic.actual}\"") if diagnostic.expected == "unknown" else buffer.extend(f"function \"{diagnostic.name}\" cannot use positional arguments after named arguments")
                    DiagnosticKind.ImplErrorExtra:
                        buffer.extend(f"impl method \"{diagnostic.expected}\" for interface \"{diagnostic.actual}\" raises error `{diagnostic.name}` not declared in the protocol")
                    DiagnosticKind.ImplEffectExtra:
                        buffer.extend(f"impl method \"{diagnostic.expected}\" for interface \"{diagnostic.actual}\" uses capability `{diagnostic.name}` not granted by the protocol")
                    DiagnosticKind.ImplSignatureMismatch:
                        buffer.extend(f"impl method \"{diagnostic.name}\" for interface \"{diagnostic.actual}\" return type mismatch: expected {diagnostic.expected}, got {diagnostic.detail}")
                    DiagnosticKind.ImplMissingMember:
                        buffer.extend(f"impl of interface \"{diagnostic.actual}\" for {diagnostic.detail} is missing {diagnostic.expected} \"{diagnostic.name}\"")
                    DiagnosticKind.DarrayLinearDrop:
                        buffer.extend(f"{diagnostic.expected} would drop must-consume element(s) of type {diagnostic.name} without consuming them; drain the container with `for x in move c:` and consume each element instead")
                    DiagnosticKind.DrainBodyLeak:
                        buffer.extend("a `for ... in move` drain must consume every element; `break`/`return` inside the drain body would leak the remaining un-consumed elements")
                    DiagnosticKind.DrainSourceNotDarray:
                        buffer.extend(f"`for ... in move` (drain) currently requires a darray source, got {diagnostic.actual}[{diagnostic.expected}]") if diagnostic.expected != ""
                        buffer.extend(f"`for ... in move` (drain) currently requires a darray source, got {diagnostic.actual}") if diagnostic.expected == ""
                    DiagnosticKind.DrainElementNotConsumed:
                        buffer.extend(f"linear element \"{diagnostic.name}\" moved out by `for ... in move` must be consumed in each iteration")
                    DiagnosticKind.IterAffineNonborrowable:
                        buffer.extend(f"iteration over affine element type {diagnostic.name} cannot copy or borrow the elements; use `for x in move c` to drain and consume each element")
                    DiagnosticKind.NolockBlocking:
                        buffer.extend(f"@nolock function \"{diagnostic.name}\" acquires a lock or waits on a condition (via the `{diagnostic.actual}` effect); restructure to avoid the lock/blocking wait on this path, or drop @nolock")
                    DiagnosticKind.SegmentTransitionBadTarget:
                        buffer.extend(f"@segment_transition on extern function \"{diagnostic.name}\" uses unsupported target \"{diagnostic.actual}\" (expected host or guest)")
                    DiagnosticKind.CatchArmOutOfSet:
                        buffer.extend(f"catch arm \"{diagnostic.name}\" does not match the caught call's declared error set")
                    DiagnosticKind.CatchSubsetNonExhaustive:
                        buffer.extend(f"non-exhaustive catch over the caught call's error set; missing {diagnostic.name}.{diagnostic.actual}")
                    DiagnosticKind.FieldDefaultTypeMismatch:
                        buffer.extend(f"default value for struct field \"{diagnostic.name}\" expects {diagnostic.expected}, got {diagnostic.actual}")
                    DiagnosticKind.StaticRuntimeStatement:
                        buffer.extend("static expression statement must evaluate at compile time")
                    DiagnosticKind.IdNewtypeReturnMismatch:
                        buffer.extend(f"return type expects id[{diagnostic.expected}], got id[{diagnostic.actual}]") if diagnostic.expected_count == 1
                        buffer.extend(f"return type expects id[{diagnostic.expected}], got {diagnostic.actual}") if diagnostic.expected_count == 0
                    DiagnosticKind.LambdaReturnTypeMismatch:
                        buffer.extend(f"return type expects {diagnostic.expected}, got {diagnostic.actual}")
                    DiagnosticKind.BraceShorthandNoContext:
                        buffer.extend(f"shorthand member \".{diagnostic.name}\" requires an expected const enum type")
                    DiagnosticKind.LinearReferenceUnsupported:
                        buffer.extend(f"references to values containing linear handles are not supported; got {diagnostic.actual}[{diagnostic.expected}]&") if diagnostic.expected != ""
                        buffer.extend(f"references to values containing linear handles are not supported; got {diagnostic.actual}&") if diagnostic.expected == ""
                    DiagnosticKind.CloneRefRejected:
                        buffer.extend(f"clone cannot clone {diagnostic.actual}& into {diagnostic.actual}& in v1")
                    DiagnosticKind.LawImpure:
                        buffer.extend(f"law \"{diagnostic.name}\" must be pure but uses the `{diagnostic.actual}` effect; a predicate may not perform effects (no IO, allocation, mutation, time, or randomness)")
                    DiagnosticKind.CloneOwnerRequired:
                        buffer.extend(f"clone of \"{diagnostic.actual}[{diagnostic.expected}]\" requires an active in <owner>: scope") if diagnostic.expected != ""
                        buffer.extend(f"clone of \"{diagnostic.actual}\" requires an active in <owner>: scope") if diagnostic.expected == ""
                    DiagnosticKind.LocalArenaEscape:
                        buffer.extend(f"cannot {diagnostic.expected} \"{diagnostic.name}\": its backing was allocated in local arena \"{diagnostic.actual}\", which is freed when the function returns (use-after-free). Build it in a persistent arena instead (a global Arena, or an Arena& parameter owned by the caller)")
                    DiagnosticKind.RegionInterleaveDisjoint:
                        buffer.extend(f"interleaved object lifetimes in an inferred region: \"{diagnostic.name}\" is created while \"{diagnostic.actual}\" is still live, but \"{diagnostic.actual}\" is last used before \"{diagnostic.name}\" is first used — their lifetimes cross and the region's stack budget (4) is exhausted, so they cannot share a bump-stack. Move \"{diagnostic.name}\"'s declaration below \"{diagnostic.actual}\"'s last use (their live ranges are disjoint, so this makes the lifetimes nest), or put one in an explicit region (`in r:` / `region r(...)`), or reserve() one of them.")
                    DiagnosticKind.RegionInterleaveOverlap:
                        buffer.extend(f"interleaved object lifetimes in an inferred region: \"{diagnostic.name}\" is created while \"{diagnostic.actual}\" is still live and their live ranges overlap, and the region's stack budget (4) is exhausted, so they cannot share a bump-stack. Put one in an explicit region (`in r:` / `region r(...)`) so the lifetimes nest, or reserve() one of them (a reserved container is fixed-footprint and shares the base stack).")
                    DiagnosticKind.RegionGrowthRealloc:
                        buffer.extend(f"warning: growing \"{diagnostic.name}\" after \"{diagnostic.actual}\" was allocated on top of it in the same inferred region forces a reallocation: \"{diagnostic.name}\" is no longer the arena tail, so this relocates its buffer (a dead hole under the default region, or a panic under an interior-pointer-stable one). reserve() \"{diagnostic.name}\"'s capacity up front, finish growing it before \"{diagnostic.actual}\" is created, or give one its own region.")
                    DiagnosticKind.ExternImplMismatch:
                        buffer.extend(f"extern function \"{diagnostic.name}\" declaration does not match implementation")
                    DiagnosticKind.DarrayLinearMustConsume:
                        buffer.extend(f"darray of must-consume elements (drain with `for x in move c:`) \"{diagnostic.name}\" must be consumed before scope exit")
                    DiagnosticKind.TypestateNonTerminal:
                        buffer.extend(f"typestate value left in non-terminal state \"{diagnostic.name}\" must be consumed before scope exit — drive it to a terminal state (or move it out) so its protocol completes")
                    DiagnosticKind.LinearScopeExit:
                        buffer.extend(f"linear value \"{diagnostic.name}\" must be consumed before scope exit — `move` it out or pass it to a consuming call on every path")
                    DiagnosticKind.TupleValueMismatch:
                        buffer.extend(f"darray literal element expects {diagnostic.expected}" if diagnostic.name == "element" else (f"return type expects {diagnostic.expected}" if diagnostic.name == "return" else f"variable '{diagnostic.name}' expects {diagnostic.expected}")) if diagnostic.expected_count == 0
                        if diagnostic.expected_count != 0:
                            push_str(buffer, "argument ")
                            push_int(buffer, diagnostic.expected_count.i64())
                            buffer.extend(f" to \"{diagnostic.name}\" expects {diagnostic.expected}")
                        buffer.extend(f", got ({diagnostic.actual}: {diagnostic.detail}, {diagnostic.detail2}: {diagnostic.detail3})")
                    DiagnosticKind.BlockValueStringArrayMismatch:
                        buffer.extend(f"variable \"{diagnostic.name}\" expects darray[{diagnostic.detail}], got static u8&[")
                        push_int(buffer, diagnostic.actual_count.i64())
                        push_str(buffer, "]")
                    DiagnosticKind.AssignScalarToContainer:
                        buffer.extend(f"cannot assign {diagnostic.actual} to {diagnostic.expected}")
                        buffer.extend(f"[{diagnostic.detail}]") if diagnostic.detail != ""
                    DiagnosticKind.NumericLiteralSuffix:
                        buffer.extend(f"numeric literal suffix \"{diagnostic.name}\" is discouraged; prefer contextual typing or an explicit constructor")
                    DiagnosticKind.ByValueGrownContainer:
                        buffer.extend(f"by-value {diagnostic.name} parameter \"{diagnostic.expected}\" is grown but the growth is not visible to the caller (a by-value container copies its header); pass it by reference (`mutable {diagnostic.name}&`, region inferred) or return it")
                    DiagnosticKind.PreconditionUnproven:
                        buffer.extend(f"precondition of \"{diagnostic.name}\" could not be proven statically at this call")
                    DiagnosticKind.LoopInvariantNotEstablished:
                        push_str(buffer, "loop invariant could not be established on entry; it is only checked at runtime")
                    DiagnosticKind.NoallocAllocates:
                        buffer.extend(f"@noalloc function \"{diagnostic.name}\" allocates or frees on the heap (via the `Memory.Allocate` effect); allocate from a region/arena/stack instead (e.g. `new[auto] T(...)`, or preallocate with `reserve`), or drop @noalloc")
                    DiagnosticKind.StructPadding:
                        buffer.extend(f"struct \"{diagnostic.name}\" has ")
                        push_int(buffer, (diagnostic.expected_count - diagnostic.actual_count).i64())
                        buffer.extend(" bytes of avoidable padding in declared field order (current estimated size ")
                        push_int(buffer, diagnostic.expected_count.i64())
                        buffer.extend(" bytes, reordered estimate ")
                        push_int(buffer, diagnostic.actual_count.i64())
                        buffer.extend(f" bytes); consider ordering fields as \"{diagnostic.expected}\", \"{diagnostic.actual}\"")
                        buffer.extend(f", \"{diagnostic.detail}\"") if diagnostic.detail != ""
                    DiagnosticKind.SubmitOutsidePool:
                        buffer.extend("submit requires an active pool scope")
                return buffer


        # Canonical LSP DiagnosticSeverity for a diagnostic (1 = Error, 2 = Warning,
        # 3 = Information, 4 = Hint). Kept beside the wording so a new `DiagnosticKind`
        # must decide its severity here too. Both current kinds are errors.
        def diagnostic_severity(diagnostic: Diagnostic) -> u8:
            can Abort.Panic:
                return match diagnostic.kind:
                    DiagnosticKind.UndefinedName:            1
                    DiagnosticKind.DuplicateDecl:            1
                    DiagnosticKind.DuplicateType:            1
                    DiagnosticKind.AssignImmutable:          1
                    DiagnosticKind.DuplicateParam:           1
                    DiagnosticKind.DuplicateField:           1
                    DiagnosticKind.DuplicateVariant:         1
                    DiagnosticKind.NonExhaustiveMatch:       1
                    DiagnosticKind.NonExhaustiveScalarMatch: 1
                    DiagnosticKind.InvalidTopLevelScalarMatchArm: 1
                    DiagnosticKind.InvalidExportBoundary: 1
                    DiagnosticKind.BlockLambdaMissingContext: 1
                    DiagnosticKind.LegacyErrorSyntax: 1
                    DiagnosticKind.NullableWithoutProof: 1
                    DiagnosticKind.AggregateStateArity: 1
                    DiagnosticKind.FunctionParameterVariance: 1
                    DiagnosticKind.NonExhaustiveCatch: 1
                    DiagnosticKind.OrdinaryEnumTailPayload: 1
                    DiagnosticKind.FloatDictRuntimeKey: 1
                    DiagnosticKind.TryRequiresFallible: 1
                    DiagnosticKind.ConstFloatCastRange: 1
                    DiagnosticKind.ContainerShapeReturn: 1
                    DiagnosticKind.InternalRuntimeCarrier: 1
                    DiagnosticKind.UngrantedParallelFor: 2
                    DiagnosticKind.ParallelOuterMutation: 1
                    DiagnosticKind.UnknownPermissionMember: 1
                    DiagnosticKind.PermissionParamMemberAccess: 1
                    DiagnosticKind.TruthyOrBindingMismatch: 1
                    DiagnosticKind.RaiseDestinationMismatch: 1
                    DiagnosticKind.LambdaRaiseMismatch: 1
                    DiagnosticKind.GhostInitImpure: 1
                    DiagnosticKind.GhostFieldRead: 1
                    DiagnosticKind.ConstDictNoKey: 1
                    DiagnosticKind.ErrorsetParamShadow: 2
                    DiagnosticKind.PrivateMemberAccess: 1
                    DiagnosticKind.StaticIndirectRecursion: 1
                    DiagnosticKind.StaticPartialRecursion: 1
                    DiagnosticKind.PreservesViolation: 1
                    DiagnosticKind.AmbiguousErrorVariant: 1
                    DiagnosticKind.GhostFnImpure: 1
                    DiagnosticKind.GhostFnRuntimeCall: 1
                    DiagnosticKind.RaiseVariantNotAllowed: 1
                    DiagnosticKind.TryPropagationMismatch: 1
                    DiagnosticKind.ReadonlyRefMutation: 1
                    DiagnosticKind.ReadonlyRefArgument: 1
                    DiagnosticKind.DestroyedRegionUse: 1
                    DiagnosticKind.StorageDependencyInvalidated: 1
                    DiagnosticKind.MachineTagCoverage: 1
                    DiagnosticKind.ArityMismatch:            1
                    DiagnosticKind.DuplicateLocal:           1
                    DiagnosticKind.UnknownVariant:           1
                    DiagnosticKind.VariantArity:             1
                    DiagnosticKind.TypeMismatch:             1
                    DiagnosticKind.NonBoolCondition:         1
                    DiagnosticKind.NonBoolOperand:           1
                    DiagnosticKind.NonNumericOperand:        1
                    DiagnosticKind.IncompatibleComparison:   1
                    DiagnosticKind.InvalidVariantTestOperand: 1
                    DiagnosticKind.InvalidTopLevelSequenceMatchArm: 1
                    DiagnosticKind.ReturnValueInVoid:        1
                    DiagnosticKind.MissingReturnValue:       1
                    DiagnosticKind.UnusedParam:              4
                    DiagnosticKind.UnusedLocal:              4
                    DiagnosticKind.BreakOutsideLoop:         1
                    DiagnosticKind.ContinueOutsideLoop:      1
                    DiagnosticKind.NonIterableLoop:          1
                    DiagnosticKind.UnreachableCode:          2
                    DiagnosticKind.UnreachableMatchArm:      1
                    DiagnosticKind.UnknownField:             1
                    DiagnosticKind.DuplicateFieldInit:       1
                    DiagnosticKind.MissingField:             1
                    DiagnosticKind.AssignUndefinedTarget:    1
                    DiagnosticKind.InvalidAssignTarget:      1
                    DiagnosticKind.ValueBlockMutation:        1
                    DiagnosticKind.CaptureUndefined:          1
                    DiagnosticKind.CaptureImmutable:          1
                    DiagnosticKind.UnknownFieldType:         1
                    DiagnosticKind.RecursiveStruct:          1
                    DiagnosticKind.InvalidCast:              1
                    DiagnosticKind.SyntaxExpectedToken:      1
                    DiagnosticKind.SyntaxUnexpectedToken:    1
                    DiagnosticKind.SyntaxExpectedDeclaration: 1
                    DiagnosticKind.SyntaxExpectedExpression: 1
                    DiagnosticKind.SyntaxMismatchedWithBindings: 1
                    DiagnosticKind.LmutAliasing:             1
                    DiagnosticKind.NonTrailingDefaultParam:  1
                    DiagnosticKind.CallArgumentError:        1
                    DiagnosticKind.EnumConstructorArgumentError: 1
                    DiagnosticKind.SelfAssignment:           2
                    DiagnosticKind.SelfComparison:           2
                    DiagnosticKind.UnusedExpression:         2
                    DiagnosticKind.ConstantCondition:        2
                    DiagnosticKind.RedundantBoolCompare:     2
                    DiagnosticKind.DuplicateImport:          2
                    DiagnosticKind.DuplicateMatchArm:        2
                    DiagnosticKind.DivisionByZero:           1
                    DiagnosticKind.ArrayLiteralArity:        1
                    DiagnosticKind.UnknownTypeName:          1
                    DiagnosticKind.DuplicateDictKey:         2
                    DiagnosticKind.DuplicateSetElement:      2
                    DiagnosticKind.IndexOutOfBounds:         1
                    DiagnosticKind.SelfArithmetic:           2
                    DiagnosticKind.DoubleNegation:           2
                    DiagnosticKind.InfiniteLoopNoExit:       2
                    DiagnosticKind.RedundantArithmetic:      2
                    DiagnosticKind.EmptyRange:               2
                    DiagnosticKind.AssignToLoopVar:          2
                    DiagnosticKind.ConstantComparison:       2
                    DiagnosticKind.DuplicateCondition:       2
                    DiagnosticKind.DiscardedCallResult:      2
                    DiagnosticKind.VoidValueUse:             1
                    DiagnosticKind.LiteralArgTypeMismatch:   1
                    DiagnosticKind.OversizedShift:           1
                    DiagnosticKind.NegativeShift:            1
                    DiagnosticKind.LiteralAssignOutOfRange:  1
                    DiagnosticKind.LiteralComparisonImpossible: 2
                    DiagnosticKind.DuplicateVariantField:    1
                    DiagnosticKind.IdenticalLogicalOperands: 2
                    DiagnosticKind.IdenticalBranches:        2
                    DiagnosticKind.EmptyIterable:            2
                    DiagnosticKind.UnusedImport:             2
                    DiagnosticKind.FloatEquality:            2
                    DiagnosticKind.NegativeIndex:            1
                    DiagnosticKind.DuplicatePatternBinding:  1
                    DiagnosticKind.ImmediateOverwrite:       2
                    DiagnosticKind.ModuloByZero:             1
                    DiagnosticKind.ShiftByZero:              2
                    DiagnosticKind.LogicalConstantOperand:   2
                    DiagnosticKind.DuplicateDecorator:       2
                    DiagnosticKind.RedundantContinue:        2
                    DiagnosticKind.NegatedComparison:        2
                    DiagnosticKind.FieldAccessOnPrimitive:   1
                    DiagnosticKind.IndexNonIndexable:        1
                    DiagnosticKind.FirmArgTypeMismatch:      1
                    DiagnosticKind.NonBoolMatchGuard:        1
                    DiagnosticKind.RedundantCast:            2
                    DiagnosticKind.UnknownFieldAccess:       1
                    DiagnosticKind.ConstructFieldTypeMismatch: 1
                    DiagnosticKind.NamedTypeMismatch:        1
                    DiagnosticKind.VoidArgument:             1
                    DiagnosticKind.NonNumericShiftOperand:   1
                    DiagnosticKind.CompoundAssignNonNumeric: 1
                    DiagnosticKind.StringIndexNonNumeric:    1
                    DiagnosticKind.VoidFieldAccess:          1
                    DiagnosticKind.VoidIndex:                1
                    DiagnosticKind.CallNonFunction:          1
                    DiagnosticKind.ShiftOperandNonIntegral:  1
                    DiagnosticKind.VoidOperand:              1
                    DiagnosticKind.VoidCondition:            1
                    DiagnosticKind.TernaryBranchMismatch:    1
                    DiagnosticKind.ArrayLiteralElementTypeMismatch: 1
                    DiagnosticKind.StringIndexNonIntegral:   1
                    DiagnosticKind.VoidCollectionElement:    1
                    DiagnosticKind.VoidUnaryOperand:         1
                    DiagnosticKind.VoidMatchScrutinee:       1
                    DiagnosticKind.OrderingNonNumeric:       1
                    DiagnosticKind.RangeBoundNonIntegral:    1
                    DiagnosticKind.DArrayElementTypeMismatch: 1
                    DiagnosticKind.SetElementTypeMismatch:   1
                    DiagnosticKind.DictValueTypeMismatch:    1
                    DiagnosticKind.DictKeyTypeMismatch:      1
                    DiagnosticKind.CallNamedNonFunction:     1
                    DiagnosticKind.StructPatternTypeMismatch: 1
                    DiagnosticKind.MatchArmEnumMismatch:     1
                    DiagnosticKind.InvalidBoolCast:          1
                    DiagnosticKind.FieldImmutableAssign:     1
                    DiagnosticKind.UngrantedPanic:           2
                    DiagnosticKind.UngrantedEffectCall:      2
                    DiagnosticKind.ContractNotFirst:         1
                    DiagnosticKind.ContractEnsureResultVoid: 1
                    DiagnosticKind.DictKeyAffine:            1
                    DiagnosticKind.SetElementAffine:         1
                    DiagnosticKind.AffineAddress:             1
                    DiagnosticKind.AffineGlobal:              1
                    DiagnosticKind.AffineReference:           1
                    DiagnosticKind.AffineUseAfterConsume:     1
                    DiagnosticKind.AffineMoveRequired:        1
                    DiagnosticKind.AffineScopeExit:           1
                    DiagnosticKind.UnusedDecreases:          2
                    DiagnosticKind.GhostFieldDefault:        1
                    DiagnosticKind.GhostLocalRead:           1
                    DiagnosticKind.ConstEnumStorageNotInt:   1
                    DiagnosticKind.ConstEnumValueOutOfRange: 1
                    DiagnosticKind.RaiseWithoutErrorSet:     1
                    DiagnosticKind.RegionAnnotationOnScalarField: 1
                    DiagnosticKind.DuplicateBitGroupMember:  1
                    DiagnosticKind.NamedStatesWithoutDerive: 1
                    DiagnosticKind.DerivedStateConstructorMismatch: 1
                    DiagnosticKind.DerivedStateArgumentMismatch: 1
                    DiagnosticKind.UngrantedPointerCast: 2
                    DiagnosticKind.DenseNodeKeyRootMismatch: 1
                    DiagnosticKind.ThreadTransferStoreDependency: 1
                    DiagnosticKind.ThreadTransferRegionDependency: 1
                    DiagnosticKind.FlowFlagStateMachine:     2
                    DiagnosticKind.IfValueMissingElse:       1
