extend Semantic:
    public:
        # Public entry points for the semantic layer (module-public).


        # Register region binders before type collection: symbol collection interns
        # parameter and field annotations, and generic arguments must already know
        # whether an otherwise-unknown identifier is a region selector.
        def register_region_type_names(file: Ast::File&, table: mutable SymbolTable&) -> void:
            can Memory.Allocate, Abort.Panic:
                for annotation in file.enum_annotations |table|:
                    if annotation.name == "__region_name" and not any known_region in table.region_names where known_region == annotation.owner:
                        table.region_names.push(annotation.owner)
                for annotation in file.local_region_annotations |table|:
                    is_region_binder: bool = annotation.name == "__region_param" or annotation.name == "__region_local" or annotation.name == "__region_arena_local"
                    if is_region_binder and annotation.region != "" and not any known_region in table.region_names where known_region == annotation.region:
                        table.region_names.push(annotation.region)
                    binding_exists: mutable bool = false
                    for binding_index in 0..<table.region_binding_names.count |binding_exists, annotation, table|:
                        binding_exists <- true if table.region_binding_names[binding_index] == annotation.region and table.region_binding_lines[binding_index] == annotation.line and table.region_binding_end_lines[binding_index] == annotation.end_line
                    if is_region_binder and annotation.region != "" and not binding_exists:
                        binding_serial: u32 = (table.region_binding_names.count + 1).u32()
                        table.region_binding_names.push(annotation.region)
                        table.region_binding_lines.push(annotation.line)
                        table.region_binding_end_lines.push(annotation.end_line)
                        table.region_binding_ids.push(binding_serial)
                    # Signature parameter ties use the formal name and function-header line;
                    # local binding annotations use their own declaration line and do not
                    # match a collected function symbol's line.
                    signature_parameter_region: bool = annotation.name != "__region_param" and annotation.name != "__region_local" and annotation.name != "__region_arena_local" and annotation.name != "__region_pin" and annotation.name != "__region_return"
                    if signature_parameter_region and annotation.line > 0:
                        table.function_param_region_line.push(annotation.line)
                        table.function_param_region_name.push(annotation.name)
                        table.function_param_region.push(annotation.region)


        # Build the symbol table for a parsed file (top-level + module-scoped decls).
        # `table.diagnostics` carries any duplicate-declaration findings.
        def collect_symbols(file: Ast::File&) -> SymbolTable:
            can Memory.Allocate, Abort.Panic:
                table: mutable SymbolTable = SymbolTable()
                table <- register_region_type_names(file, table)
                # BEFORE collect_range: the struct field pass needs to know which structs are
                # column-major, and the general annotation loop below runs after it.
                for soa_annotation in file.enum_annotations |table|:
                    table.soa_layout_owners <- table.soa_layout_owners.push(soa_annotation.owner) if soa_annotation.name == "__layout_soa"
                # Source extents for names the AST holds as bare sviews (a loop's binder).
                for binder_annotation in file.enum_annotations |table|:
                    if binder_annotation.owner == "__for_binder":
                        table.binder_pos_offsets <- table.binder_pos_offsets.push(binder_annotation.offset)
                        table.binder_pos_values <- table.binder_pos_values.push(binder_annotation.pos)
                    table.quantifier_lines <- table.quantifier_lines.push(binder_annotation.line) if binder_annotation.owner == "__contract_quantifier"
                table <- collect_range(file.top_decls, table, file.enum_annotations) can Global{Read,Write}
                table <- collect_payload_enum_metadata(file, table) can Global{Read,Write}
                table <- resolve_protocol_state_declarations(file, table)
                return table


        # Run the full semantic check over a parsed file: collect symbols (recording
        # duplicate-declaration diagnostics) then resolve references (recording
        # undefined-name diagnostics). The returned table's `diagnostics` is the located,
        # LSP-facing finding list. Built inline so its container literals seed this
        # function's auto-region (the region a region-polymorphic return is adopted into).
        # Keep this basic semantic entry aligned with the CLI default: mutable-global grants
        # are enforced even when the legacy all-global reporting dial is off.
        def check_with_unsafe_permissions(file: Ast::File&, enforce_unsafe_permissions: bool) -> SymbolTable:
            can Unsafe.PointerCast:
                can Memory.Allocate, Abort.Panic:
                    return check_full(file, enforce_unsafe_permissions, false, false, false, false, false, false, false, false, false, 64, false, true, false) can Global{Read,Write}

            # Full-option entry: strict Unsafe permissions and/or the docs/125 §6b
            # flow-strict lint (every statement-position block `if` is an error).
            # `runtime_std` marks the compilation unit as trusted stdlib (mirrors stage0's
            # isRuntimeStdPermissionInternal): passes that only apply to user code — currently
            # the raw-atomic-surface removal — are skipped for it.
            # `enforce_unsafe_permissions` here is the UNION of stage0's EnforceUnsafePermissions
            # and EnforceStrictProofs (both replayed via `# strict`), preserving every existing
            # strict-gated check. `enforce_raw_unsafe` is the NARROWER pure-EnforceUnsafePermissions
            # signal: the raw-extern-call obligation (markRawExternFuncType is gated on
            # EnforceUnsafePermissions ALONE in stage0) must fire only under it, else a
            # proof-only case (`EnforceStrictProofs` without `EnforceUnsafePermissions`) would
            # spuriously demand `Unsafe.RawExtern` for its extern calls.
        def check_full(file: Ast::File&, enforce_unsafe_permissions: bool, flow_strict: bool, runtime_std: bool, flow_warn: bool, enable_smt: bool, warn_discarded: bool, enforce_progress: bool, enforce_extern_contracts: bool, enforce_raw_unsafe: bool, emit_proof_hole: bool, region_stack_cap: i64, enforce_global_permissions: bool, enforce_mutable_global_grants: bool, carrier_surface: bool) -> SymbolTable:
            can Memory.Allocate, Abort.Panic:
                table: mutable SymbolTable = SymbolTable()
                table <- check_full_into(file, table, enforce_unsafe_permissions, flow_strict, runtime_std, flow_warn, enable_smt, warn_discarded, enforce_progress, enforce_extern_contracts, enforce_raw_unsafe, emit_proof_hole, region_stack_cap, enforce_global_permissions, enforce_mutable_global_grants, carrier_surface) can Global{Read,Write}
                return table


        # In-place sibling of check_full for callers that only need diagnostics during a
        # bounded region. Returning SymbolTable by value carries every side-table buffer
        # through the region boundary on stage1; an lmut destination keeps those buffers in
        # the caller's region so the caller can reclaim them before backend emission.
        def check_full_into(file: Ast::File&, table: lmut SymbolTable, enforce_unsafe_permissions: bool, flow_strict: bool, runtime_std: bool, flow_warn: bool, enable_smt: bool, warn_discarded: bool, enforce_progress: bool, enforce_extern_contracts: bool, enforce_raw_unsafe: bool, emit_proof_hole: bool, region_stack_cap: i64, enforce_global_permissions: bool, enforce_mutable_global_grants: bool, carrier_surface: bool) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- seed_builtins(table) can Global{Read,Write}
                PhaseTimer::minor("sem:seed_builtins") can Global{Read,Write}
                table <- append_parse_errors(file, table)
                PhaseTimer::minor("sem:append_parse_errors") can Global{Read,Write}
                table <- register_region_type_names(file, table)
                PhaseTimer::minor("sem:register_region_type_names") can Global{Read,Write}
                # BEFORE collect_range: the struct field pass needs to know which structs are
                # column-major, and the general annotation loop below runs after it.
                for soa_annotation in file.enum_annotations |table|:
                    table.soa_layout_owners <- table.soa_layout_owners.push(soa_annotation.owner) if soa_annotation.name == "__layout_soa"
                # Source extents for names the AST holds as bare sviews (a loop's binder).
                for binder_annotation in file.enum_annotations |table|:
                    if binder_annotation.owner == "__for_binder":
                        table.binder_pos_offsets <- table.binder_pos_offsets.push(binder_annotation.offset)
                        table.binder_pos_values <- table.binder_pos_values.push(binder_annotation.pos)
                    table.quantifier_lines <- table.quantifier_lines.push(binder_annotation.line) if binder_annotation.owner == "__contract_quantifier"
                table <- collect_range(file.top_decls, table, file.enum_annotations) can Global{Read,Write}
                PhaseTimer::minor("sem:collect_range") can Global{Read,Write}
                table <- collect_extern_bounds_hints(file.enum_annotations, table)
                PhaseTimer::minor("sem:collect_extern_bounds_hints") can Global{Read,Write}
                table <- collect_payload_enum_metadata(file, table) can Global{Read,Write}
                PhaseTimer::minor("sem:collect_payload_enum_metadata") can Global{Read,Write}
                table <- resolve_protocol_state_declarations(file, table)
                PhaseTimer::minor("sem:resolve_protocol_state_declarations") can Global{Read,Write}
                table.generic_param_lines <- file.generic_param_lines
                table.generic_param_names <- file.generic_param_names
                table <- index_generic_param_names(table) can Global{Read,Write}
                table.protocol_annotations <- file.enum_annotations
                table.using_alias_rows <- table.using_alias_rows.truncate(0)
                for annotation in file.enum_annotations |table|:
                    table.using_alias_rows <- table.using_alias_rows.push(annotation) if annotation.name == "__using_alias" or annotation.name == "__using_alias_target"
                table <- index_wildcard_imports(table, file.enum_annotations)
                table <- index_binder_annotations(table, file.enum_annotations) can Global{Read,Write}
                PhaseTimer::minor("sem:index_binder_annotations") can Global{Read,Write}
                table <- binding_import_metadata(file.enum_annotations, table)
                PhaseTimer::minor("sem:binding_import_metadata") can Global{Read,Write}
                for annotation in file.enum_annotations |table|:
                    table.protocol_declarations <- table.protocol_declarations.push(annotation) if annotation.owner == "__protocol_decl"
                for annotation in file.enum_annotations |table|:
                    table.generic_extern_names <- table.generic_extern_names.push(annotation.name) if annotation.owner == "__extern_generic_name"
                table.packed_enum_names <- file.packed_enum_names
                table <- register_using_alias_members(file.enum_annotations, table) can Global{Read,Write}
                PhaseTimer::minor("sem:register_using_alias_members") can Global{Read,Write}
                for annotation in file.enum_annotations |table|:
                    if annotation.name == "__local_binding_mutable" or annotation.name == "__local_binding_immutable":
                        local_binding_row: usize = table.local_binding_names.count
                        table <- table.index_local_binding_exact(annotation.owner, annotation.line, annotation.offset, local_binding_row) can Global{Read,Write}
                        table.local_binding_names <- table.local_binding_names.push(annotation.owner)
                        table.local_binding_lines <- table.local_binding_lines.push(annotation.line)
                        table.local_binding_offsets <- table.local_binding_offsets.push(annotation.offset)
                        table.local_binding_modes <- table.local_binding_modes.push(1) if annotation.name == "__local_binding_mutable"
                        table.local_binding_modes <- table.local_binding_modes.push(-1) if annotation.name == "__local_binding_immutable"
                    table.imported_modules <- table.imported_modules.push(annotation.owner) if annotation.name == "__using"
                    if annotation.name == "__local_binding_mutable" or annotation.name == "__local_binding_immutable" or annotation.name == "__loop_header_accumulator":
                        binding_annotation_row: usize = table.binding_annotations.count
                        table <- table.index_binding_annotation_exact(annotation, binding_annotation_row) can Global{Read,Write}
                        table.binding_annotations <- table.binding_annotations.push(annotation)
                    # `using Mod as M` — the ALIAS is a module name in its own right, and
                    # the module it stands for is imported. Without the symbol, `M::f()`
                    # resolved to `undefined identifier 'M'`.
                    table <- table.add_symbol(annotation.owner, SymbolKind.Module, annotation.line, 0, 0, sview("", 0, 0), 0, annotation.offset, annotation.pos) can Global{Read,Write} if annotation.name == "__using_alias"
                    table.imported_modules <- table.imported_modules.push(annotation.owner) if annotation.name == "__using_alias_target"
                    table.imported_members <- table.imported_members.push(annotation.name) if annotation.owner == "__from_member"
                    table.catch_match_lines <- table.catch_match_lines.push(annotation.line) if annotation.name == "__catch_match"
                    table.new_construct_lines <- table.new_construct_lines.push(annotation.line) if annotation.name == "__new_construct"
                    table.forward_arg_lines <- table.forward_arg_lines.push(annotation.line) if annotation.name == "__arg_forward"
                    table.block_if_lines <- table.block_if_lines.push(annotation.line) if annotation.name == "__block_if"
                    table.query_binder_lines <- table.query_binder_lines.push(annotation.line) if annotation.name == "__query_binder"
                    table.query_binder_names <- table.query_binder_names.push(annotation.owner) if annotation.name == "__query_binder"
                    table.is_variant_alias_lines <- table.is_variant_alias_lines.push(annotation.line) if annotation.name == "__is_variant_alias"
                    table.is_variant_alias_names <- table.is_variant_alias_names.push(annotation.owner) if annotation.name == "__is_variant_alias"
                    table.declared_packed_names <- table.declared_packed_names.push(annotation.owner) if annotation.name == "__declared_packed"
                    table.qualified_packed_names <- table.qualified_packed_names.push(annotation.owner) if annotation.name == "__packed_qualified"
                    table.ast_refinement_names <- table.ast_refinement_names.push(annotation.owner) if annotation.name == "__ast_refinement"
                    table.foreign_enum_names <- table.foreign_enum_names.push(annotation.owner) if annotation.name == "__extern_enum"
                    table.open_foreign_enum_names <- table.open_foreign_enum_names.push(annotation.owner) if annotation.name == "__extern_enum_open"
                    table.no_storage_foreign_enum_names <- table.no_storage_foreign_enum_names.push(annotation.owner) if annotation.name == "__extern_enum_no_storage"
                    table.enum_hierarchy_child <- table.enum_hierarchy_child.push(annotation.owner) if annotation.line == 3900000008
                    table.enum_hierarchy_parent <- table.enum_hierarchy_parent.push(annotation.name) if annotation.line == 3900000008
                table.enum_common_owners <- file.enum_common_owners
                table.enum_common_modules <- file.enum_common_modules
                table.enum_common_counts <- file.enum_common_counts
                # Validate struct layouts (field types + self-recursion) after symbol
                # collection so the symbol table is complete (all structs/enums registered).
                for region_annotation in file.local_region_annotations |table|:
                    table.region_tied_param_names <- table.region_tied_param_names.push(region_annotation.name) if region_annotation.region != "" and region_annotation.name != "__region_local"
                table <- validate_struct_layouts(file, table)
                PhaseTimer::minor("sem:validate_struct_layouts") can Global{Read,Write}
                # Skip name resolution when the parse failed: a partial AST yields cascading,
                # misleading undefined-name diagnostics that bury the real syntax error.
                # Symbol collection (duplicate-declaration) still runs over whatever parsed.
                if file.errors.count == 0:
                    table <- resolve_declarations(file.top_decls, table) can Global{Read,Write}
                    PhaseTimer::minor("sem:resolve_declarations") can Global{Read,Write}
                    table <- record_protocol_ownership(file, table)
                    PhaseTimer::minor("sem:record_protocol_ownership") can Global{Read,Write}
                    table <- check_protocol_transition_calls(file, table)
                    PhaseTimer::minor("sem:check_protocol_transition_calls") can Global{Read,Write}
                    table <- check_protocol_state_call_arguments(file, table)
                    PhaseTimer::minor("sem:check_protocol_state_call_arguments") can Global{Read,Write}
                    # Checkers read the loop view (semantic_loop_view.elisa): captured-loop statements
                    # become Stmt.Block("loop") so every statement walker descends them.
                    loop_view: Ast::File = semantic_loop_view(file)
                    flags: ParPassFlags = ParPassFlags{enforce_unsafe_permissions: enforce_unsafe_permissions, flow_strict: flow_strict, runtime_std: runtime_std, flow_warn: flow_warn, enable_smt: enable_smt, warn_discarded: warn_discarded, enforce_progress: enforce_progress, enforce_extern_contracts: enforce_extern_contracts, enforce_raw_unsafe: enforce_raw_unsafe, emit_proof_hole: emit_proof_hole, region_stack_cap: region_stack_cap, enforce_global_permissions: enforce_global_permissions, carrier_surface: carrier_surface}
                    # stage0→stage1 diagnostic ports (batch).
                    table <- check_self_assignment(loop_view.top_decls, table)
                    PhaseTimer::minor("sem:check_self_assignment") can Global{Read,Write}
                    table <- check_self_comparison(loop_view.top_decls, table)
                    PhaseTimer::minor("sem:check_self_comparison") can Global{Read,Write}
                    # Append-only passes 0..4, run concurrently (semantic_parallel.elisa).
                    table <- par_pass_run(file, &loop_view, flags, table, 0, 5) can Global{Read,Write}
                    PhaseTimer::minor("sem:par_run_0") can Global{Read,Write}
                    table <- check_array_literal_arity(loop_view.top_decls, table)
                    PhaseTimer::minor("sem:check_array_literal_arity") can Global{Read,Write}
                    table <- check_unknown_type_name(loop_view.top_decls, table) can Global{Read,Write}
                    PhaseTimer::minor("sem:check_unknown_type_name") can Global{Read,Write}
                    # Append-only passes 5..8, run concurrently (semantic_parallel.elisa).
                    table <- par_pass_run(file, &loop_view, flags, table, 5, 4) can Global{Read,Write}
                    PhaseTimer::minor("sem:par_run_1") can Global{Read,Write}
                    table <- check_index_out_of_bounds(loop_view, table) can Global{Read,Write}
                    PhaseTimer::minor("sem:check_index_out_of_bounds") can Global{Read,Write}
                    # Append-only passes 9..10, run concurrently (semantic_parallel.elisa).
                    table <- par_pass_run(file, &loop_view, flags, table, 9, 2) can Global{Read,Write}
                    PhaseTimer::minor("sem:par_run_2") can Global{Read,Write}
                    table <- check_auto_region_escape(loop_view.top_decls, table)
                    PhaseTimer::minor("sem:check_auto_region_escape") can Global{Read,Write}
                    table <- check_owned_extraction(loop_view.top_decls, table)
                    PhaseTimer::minor("sem:check_owned_extraction") can Global{Read,Write}
                    table <- check_handler_capture_escape(loop_view, table) can Global{Read,Write}
                    PhaseTimer::minor("sem:check_handler_capture_escape") can Global{Read,Write}
                    table <- check_loop_element_roots(loop_view, table) can Global{Read,Write}
                    PhaseTimer::minor("sem:check_loop_element_roots") can Global{Read,Write}
                    table <- check_view_provenance(loop_view.top_decls, table) can Global{Read,Write}
                    PhaseTimer::minor("sem:check_view_provenance") can Global{Read,Write}
                    table <- check_structural_decreases(loop_view.top_decls, table)
                    PhaseTimer::minor("sem:check_structural_decreases") can Global{Read,Write}
                    table <- check_local_refinement_unproven(loop_view.top_decls, table)
                    PhaseTimer::minor("sem:check_local_refinement_unproven") can Global{Read,Write}
                    # Append-only passes 11..12, run concurrently (semantic_parallel.elisa).
                    table <- par_pass_run(file, &loop_view, flags, table, 11, 2) can Global{Read,Write}
                    PhaseTimer::minor("sem:par_run_3") can Global{Read,Write}
                    table <- check_ensures_hof_args(loop_view.top_decls, table)
                    PhaseTimer::minor("sem:check_ensures_hof_args") can Global{Read,Write}
                    table <- check_assert_by(loop_view, table)
                    PhaseTimer::minor("sem:check_assert_by") can Global{Read,Write}
                    table <- check_loop_invariant_preserved(loop_view.top_decls, enable_smt, table)
                    PhaseTimer::minor("sem:check_loop_invariant_preserved") can Global{Read,Write}
                    table <- check_field_fact_precondition(loop_view, table)
                    PhaseTimer::minor("sem:check_field_fact_precondition") can Global{Read,Write}
                    # Importing the runtime must not disable explicit lifetime checks
                    # for user declarations in the same flattened unit. The region
                    # checker limits only its older implicit-reference heuristic when
                    # runtime APIs are present; explicit @region ties always run.
                    table <- check_region_tied_return(loop_view, runtime_std, table)
                    PhaseTimer::minor("sem:check_region_tied_return") can Global{Read,Write}
                    table <- check_region_param_bare_return(loop_view, table)
                    PhaseTimer::minor("sem:check_region_param_bare_return") can Global{Read,Write}
                    table <- check_quantified_refinement(loop_view.top_decls, table)
                    PhaseTimer::minor("sem:check_quantified_refinement") can Global{Read,Write}
                    table <- check_guest_overlay(loop_view, table)
                    PhaseTimer::minor("sem:check_guest_overlay") can Global{Read,Write}
                    # Append-only passes 13..34, run concurrently (semantic_parallel.elisa).
                    table <- par_pass_run(file, &loop_view, flags, table, 13, 22) can Global{Read,Write}
                    PhaseTimer::minor("sem:par_run_4") can Global{Read,Write}
                    table <- check_float_equality(loop_view.top_decls, table)
                    PhaseTimer::minor("sem:check_float_equality") can Global{Read,Write}
                    table <- check_negative_index(loop_view.top_decls, table) can Global{Read,Write}
                    PhaseTimer::minor("sem:check_negative_index") can Global{Read,Write}
                    # Append-only passes 35..42, run concurrently (semantic_parallel.elisa).
                    table <- par_pass_run(file, &loop_view, flags, table, 35, 8) can Global{Read,Write}
                    PhaseTimer::minor("sem:par_run_5") can Global{Read,Write}
                    table <- check_negated_comparison(loop_view.top_decls, table)
                    PhaseTimer::minor("sem:check_negated_comparison") can Global{Read,Write}
                    table <- check_field_access_on_primitive(loop_view.top_decls, file.extern_params, file.signature_contract_lines, file.signature_contract_kinds, file.signature_contract_exprs, table) can Global{Read,Write}
                    PhaseTimer::minor("sem:check_field_access_on_primitive") can Global{Read,Write}
                    table <- check_static_if_condition(loop_view.top_decls, file.static_if_conds, file.static_if_lines, file.static_if_kinds, table)
                    PhaseTimer::minor("sem:check_static_if_condition") can Global{Read,Write}
                    table <- check_index_non_indexable(loop_view.top_decls, table)
                    PhaseTimer::minor("sem:check_index_non_indexable") can Global{Read,Write}
                    table <- check_firm_arg_type_mismatch(loop_view, table) can Global{Read,Write}
                    PhaseTimer::minor("sem:check_firm_arg_type_mismatch") can Global{Read,Write}
                    table <- check_nonbool_match_guard(loop_view, table)
                    PhaseTimer::minor("sem:check_nonbool_match_guard") can Global{Read,Write}
                    table <- check_redundant_cast(loop_view.top_decls, table) can Global{Read,Write}
                    PhaseTimer::minor("sem:check_redundant_cast") can Global{Read,Write}
                    table <- check_unknown_field_access(loop_view.top_decls, file.extern_params, file.signature_contract_lines, file.signature_contract_kinds, file.signature_contract_exprs, table) can Global{Read,Write}
                    PhaseTimer::minor("sem:check_unknown_field_access") can Global{Read,Write}
                    table <- check_is_pattern_field(loop_view.top_decls, table)
                    PhaseTimer::minor("sem:check_is_pattern_field") can Global{Read,Write}
                    table.struct_copy_bases <- file.struct_copy_bases
                    table <- check_construct_field_type(loop_view.top_decls, table) can Global{Read,Write}
                    PhaseTimer::minor("sem:check_construct_field_type") can Global{Read,Write}
                    table <- check_truthy_or_bindings(loop_view.top_decls, table)
                    PhaseTimer::minor("sem:check_truthy_or_bindings") can Global{Read,Write}
                    table <- check_readonly_refs(loop_view.top_decls, table) can Global{Read,Write}
                    PhaseTimer::minor("sem:check_readonly_refs") can Global{Read,Write}
                    table <- check_named_type_mismatch(loop_view.top_decls, table) can Global{Read,Write}
                    PhaseTimer::minor("sem:check_named_type_mismatch") can Global{Read,Write}
                    table <- check_void_argument(loop_view.top_decls, table)
                    PhaseTimer::minor("sem:check_void_argument") can Global{Read,Write}
                    table <- check_nonnumeric_shift_operand(loop_view.top_decls, table)
                    PhaseTimer::minor("sem:check_nonnumeric_shift_operand") can Global{Read,Write}
                    table <- check_compound_assign_nonnumeric(loop_view.top_decls, table) can Global{Read,Write}
                    PhaseTimer::minor("sem:check_compound_assign_nonnumeric") can Global{Read,Write}
                    table <- check_string_index_nonnumeric(loop_view.top_decls, table)
                    PhaseTimer::minor("sem:check_string_index_nonnumeric") can Global{Read,Write}
                    table <- check_void_field_access(loop_view.top_decls, table)
                    PhaseTimer::minor("sem:check_void_field_access") can Global{Read,Write}
                    table <- check_void_index(loop_view.top_decls, table)
                    PhaseTimer::minor("sem:check_void_index") can Global{Read,Write}
                    table <- check_call_non_function(loop_view.top_decls, table)
                    PhaseTimer::minor("sem:check_call_non_function") can Global{Read,Write}
                    table <- check_shift_non_integral(loop_view.top_decls, table)
                    PhaseTimer::minor("sem:check_shift_non_integral") can Global{Read,Write}
                    table <- check_void_operand(loop_view.top_decls, table)
                    PhaseTimer::minor("sem:check_void_operand") can Global{Read,Write}
                    table <- check_void_condition(loop_view.top_decls, table)
                    PhaseTimer::minor("sem:check_void_condition") can Global{Read,Write}
                    table <- check_ref_bool_condition(&loop_view.top_decls, table)
                    PhaseTimer::minor("sem:check_ref_bool_condition") can Global{Read,Write}
                    table <- check_ternary_branch_mismatch(loop_view.top_decls, table)
                    PhaseTimer::minor("sem:check_ternary_branch_mismatch") can Global{Read,Write}
                    table <- check_array_literal_element(loop_view.top_decls, table)
                    PhaseTimer::minor("sem:check_array_literal_element") can Global{Read,Write}
