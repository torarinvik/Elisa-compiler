                    PhaseTimer::minor("sem:check_ensures_structural") can Global{Read,Write}
                    # Append-only passes 154..156, run concurrently (semantic_parallel.elisa).
                    table <- par_pass_run(file, &loop_view, flags, table, 154, 3) can Global{Read,Write}
                    PhaseTimer::minor("sem:par_run_34") can Global{Read,Write}
                    for new_auto_annotation in file.enum_annotations |table|:
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.NewAutoDeprecated, name: "", line: new_auto_annotation.line, expected: "", actual: ""}) if new_auto_annotation.owner == "__new_auto"
                    # Append-only passes 157..160, run concurrently (semantic_parallel.elisa).
                    table <- par_pass_run(file, &loop_view, flags, table, 157, 4) can Global{Read,Write}
                    PhaseTimer::minor("sem:par_run_35") can Global{Read,Write}
                    table <- check_lmut_mutation_reassignment(loop_view, table) can Global{Read,Write}
                    PhaseTimer::minor("sem:check_lmut_mutation_reassignment") can Global{Read,Write}
                    # Append-only passes 161..163, run concurrently (semantic_parallel.elisa).
                    table <- par_pass_run(file, &loop_view, flags, table, 161, 3) can Global{Read,Write}
                    PhaseTimer::minor("sem:par_run_36") can Global{Read,Write}
                    table <- check_defer_rules(loop_view, table) can Global{Read,Write}
                    PhaseTimer::minor("sem:check_defer_rules") can Global{Read,Write}
                    # Append-only passes 164..166, run concurrently (semantic_parallel.elisa).
                    table <- par_pass_run(file, &loop_view, flags, table, 164, 3) can Global{Read,Write}
                    PhaseTimer::minor("sem:par_run_37") can Global{Read,Write}
                    table <- check_mutate_while_iterating(loop_view, table)
                    PhaseTimer::minor("sem:check_mutate_while_iterating") can Global{Read,Write}
                    # Append-only passes 167..182, run concurrently (semantic_parallel.elisa).
                    table <- par_pass_run(file, &loop_view, flags, table, 167, 16) can Global{Read,Write}
                    PhaseTimer::minor("sem:par_run_38") can Global{Read,Write}
                    table <- check_struct_field_where_scope(loop_view.top_decls, table)
                    PhaseTimer::minor("sem:check_struct_field_where_scope") can Global{Read,Write}
                    table <- check_struct_field_construct_unproven(loop_view.top_decls, table)
                    PhaseTimer::minor("sem:check_struct_field_construct_unproven") can Global{Read,Write}
                    table <- check_call_where_precondition(loop_view.top_decls, table)
                    PhaseTimer::minor("sem:check_call_where_precondition") can Global{Read,Write}
                    table <- check_local_where_violated(loop_view.top_decls, table)
                    PhaseTimer::minor("sem:check_local_where_violated") can Global{Read,Write}
                    table <- check_law_refinement_violated(loop_view, table)
                    PhaseTimer::minor("sem:check_law_refinement_violated") can Global{Read,Write}
                    table <- check_ensures_assign_violated(loop_view, table)
                    PhaseTimer::minor("sem:check_ensures_assign_violated") can Global{Read,Write}
                    table <- check_precondition_multiparam(loop_view, table)
                    PhaseTimer::minor("sem:check_precondition_multiparam") can Global{Read,Write}
                    table <- check_struct_field_violated(loop_view.top_decls, table)
                    PhaseTimer::minor("sem:check_struct_field_violated") can Global{Read,Write}
                    table <- check_struct_field_law_violated(loop_view.top_decls, table)
                    PhaseTimer::minor("sem:check_struct_field_law_violated") can Global{Read,Write}
                    # Append-only passes 183..184, run concurrently (semantic_parallel.elisa).
                    table <- par_pass_run(file, &loop_view, flags, table, 183, 2) can Global{Read,Write}
                    PhaseTimer::minor("sem:par_run_39") can Global{Read,Write}
                    if flow_strict:
                        flagged_if_lines: mutable darray[u32] = []
                        flow_strict_flagged_if_lines(file.top_decls, table.block_if_lines, flagged_if_lines)
                        for flagged_line in flagged_if_lines |table|:
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.FlowStrictBlockIf, name: "", line: flagged_line, expected: "", actual: ""})
                    # PATH-GATED IN STAGE0 (semantic/runtime_carrier_warnings.go,
                    # shouldRejectRuntimeCarrierTypeUse): the whole carrier surface is
                    # silent when the analyzed source has no real on-disk path, sits under
                    # an internal root (elisacore_std/, Code/frontend_elisacore/, ...), or
                    # -- for Arena/ArenaMark -- lives under the system temp directory. The
                    # caller owns that predicate because only it knows the path; a pathless
                    # analysis (stdin, a replayed oracle row) passes false.
                    # Append-only passes 185..190, run concurrently (semantic_parallel.elisa).
                    table <- par_pass_run(file, &loop_view, flags, table, 185, 6) can Global{Read,Write}
                    PhaseTimer::minor("sem:par_run_40") can Global{Read,Write}
                    table <- check_unused_decreases(loop_view.top_decls, table)
                    PhaseTimer::minor("sem:check_unused_decreases") can Global{Read,Write}
                    # Append-only passes 191..194, run concurrently (semantic_parallel.elisa).
                    table <- par_pass_run(file, &loop_view, flags, table, 191, 4) can Global{Read,Write}
                    PhaseTimer::minor("sem:par_run_41") can Global{Read,Write}
                    table <- check_ambiguous_error_variant(loop_view, table)
                    PhaseTimer::minor("sem:check_ambiguous_error_variant") can Global{Read,Write}
                    table <- check_private_member_access(loop_view, table) can Global{Read,Write}
                    PhaseTimer::minor("sem:check_private_member_access") can Global{Read,Write}
                    table <- check_private_fields(loop_view, table) can Global{Read,Write}
                    PhaseTimer::minor("sem:check_private_fields") can Global{Read,Write}
                    # Append-only passes 195..196, run concurrently (semantic_parallel.elisa).
                    table <- par_pass_run(file, &loop_view, flags, table, 195, 2) can Global{Read,Write}
                    PhaseTimer::minor("sem:par_run_42") can Global{Read,Write}
                    table <- check_errorset_shadow(loop_view, table)
                    PhaseTimer::minor("sem:check_errorset_shadow") can Global{Read,Write}
                    # Append-only passes 197..203, run concurrently (semantic_parallel.elisa).
                    table <- par_pass_run(file, &loop_view, flags, table, 197, 7) can Global{Read,Write}
                    PhaseTimer::minor("sem:par_run_43") can Global{Read,Write}
                    while suffix_index < file.numeric_suffix_names.count |suffix_index: usize = 0|:
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.NumericLiteralSuffix, name: file.numeric_suffix_names[suffix_index], line: file.numeric_suffix_lines[suffix_index], expected: "", actual: ""})
                        suffix_index <- suffix_index + 1
                    # Append-only passes 204..207, run concurrently (semantic_parallel.elisa).
                    table <- par_pass_run(file, &loop_view, flags, table, 204, 4) can Global{Read,Write}
                    PhaseTimer::minor("sem:par_run_44") can Global{Read,Write}
                    table <- check_local_region_annotation(loop_view, table)
                    PhaseTimer::minor("sem:check_local_region_annotation") can Global{Read,Write}
                    table <- check_destroyed_region(loop_view, table) can Global{Read,Write}
                    PhaseTimer::minor("sem:check_destroyed_region") can Global{Read,Write}
                    table <- check_region_storage_stability(loop_view, &view_origin_rows, table) can Global{Read,Write}
                    PhaseTimer::minor("sem:check_region_storage_stability") can Global{Read,Write}
                    # Append-only passes 208..210, run concurrently (semantic_parallel.elisa).
                    table <- par_pass_run(file, &loop_view, flags, table, 208, 3) can Global{Read,Write}
                    PhaseTimer::minor("sem:par_run_45") can Global{Read,Write}
                    # Classic states do not require predicates. The graph pass
                    # validates declared transitions and rejects mixed derived graphs.
                    # Append-only passes 211..218, run concurrently (semantic_parallel.elisa).
                    table <- par_pass_run(file, &loop_view, flags, table, 211, 8) can Global{Read,Write}
                    PhaseTimer::minor("sem:par_run_46") can Global{Read,Write}
                    table <- collect_tuple_binding_spellings(file, table)
                    PhaseTimer::minor("sem:collect_tuple_binding_spellings") can Global{Read,Write}
                    table <- check_tuple_var_scalar_mismatch(loop_view, table) can Global{Read,Write}
                    PhaseTimer::minor("sem:check_tuple_var_scalar_mismatch") can Global{Read,Write}
                    table <- check_static_string_binding(loop_view, table)
                    PhaseTimer::minor("sem:check_static_string_binding") can Global{Read,Write}
                    table <- check_packed_move_store(loop_view, table)
                    PhaseTimer::minor("sem:check_packed_move_store") can Global{Read,Write}
                    table <- check_packed_match_store(loop_view.top_decls, file.enum_annotations, table)
                    PhaseTimer::minor("sem:check_packed_match_store") can Global{Read,Write}
                    table <- check_unknown_function_annotation(loop_view, table) can Global{Read,Write}
                    PhaseTimer::minor("sem:check_unknown_function_annotation") can Global{Read,Write}
                    # Append-only passes 219..220, run concurrently (semantic_parallel.elisa).
                    table <- par_pass_run(file, &loop_view, flags, table, 219, 2) can Global{Read,Write}
                    PhaseTimer::minor("sem:par_run_47") can Global{Read,Write}
                    table <- check_atomic_payload(loop_view.top_decls, table)
                    PhaseTimer::minor("sem:check_atomic_payload") can Global{Read,Write}
                    # LAST: it reads the diagnostics every check above produced.
                    table <- check_call_of_invalid(file, table)
                    PhaseTimer::minor("sem:check_call_of_invalid") can Global{Read,Write}
                    table <- check_poisoned_operand(file, table)
                    PhaseTimer::minor("sem:check_poisoned_operand") can Global{Read,Write}
                return


        # Exported diagnostics must own text in the caller's region, independently of
        # the local semantic table and the already-freed parallel job arenas.
        def diagnostic_export_text[@r](text: sview, diagnostics: mutable darray[Diagnostic]& @r) -> uintptr:
            can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
                return 0 if text.len == 0
                panic("semantic: invalid diagnostic text length") if text.len < 0
                bytes: mutable darray[u8] @r = []
                for index in 0..<text.len.usize() |bytes, text|:
                    bytes.push(text.data[index])
                # The caller region owns the independent bytes after this header expires.
                bits: uintptr = (&bytes[0]).cast[void&].uintptr()
                return bits

        def diagnostic_export[@r](source_bits: uintptr, diagnostics: mutable darray[Diagnostic]& @r) -> void:
            can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
                source: heap Diagnostic& = source_bits.cast[heap Diagnostic&]
                name_bits: uintptr = diagnostic_export_text(source.name, diagnostics)
                expected_bits: uintptr = diagnostic_export_text(source.expected, diagnostics)
                actual_bits: uintptr = diagnostic_export_text(source.actual, diagnostics)
                detail_bits: uintptr = diagnostic_export_text(source.detail, diagnostics)
                const_enum_module_expected_bits: uintptr = diagnostic_export_text(source.const_enum_module_expected, diagnostics)
                const_enum_module_actual_bits: uintptr = diagnostic_export_text(source.const_enum_module_actual, diagnostics)
                detail2_bits: uintptr = diagnostic_export_text(source.detail2, diagnostics)
                detail3_bits: uintptr = diagnostic_export_text(source.detail3, diagnostics)
                effect_ref_1_bits: uintptr = diagnostic_export_text(source.effect_ref_1, diagnostics)
                effect_ref_2_bits: uintptr = diagnostic_export_text(source.effect_ref_2, diagnostics)
                effect_ref_3_bits: uintptr = diagnostic_export_text(source.effect_ref_3, diagnostics)
                effect_ref_4_bits: uintptr = diagnostic_export_text(source.effect_ref_4, diagnostics)
                effect_ref_5_bits: uintptr = diagnostic_export_text(source.effect_ref_5, diagnostics)
                effect_ref_6_bits: uintptr = diagnostic_export_text(source.effect_ref_6, diagnostics)
                effect_ref_7_bits: uintptr = diagnostic_export_text(source.effect_ref_7, diagnostics)
                effect_ref_8_bits: uintptr = diagnostic_export_text(source.effect_ref_8, diagnostics)
                error_set_bits: uintptr = diagnostic_export_text(source.error_set, diagnostics)
                diagnostics.push(Diagnostic{
                    name: unsafe_sview_bounded_bytes(name_bits.cast[u8&], source.name.len.usize()),
                    expected: unsafe_sview_bounded_bytes(expected_bits.cast[u8&], source.expected.len.usize()),
                    actual: unsafe_sview_bounded_bytes(actual_bits.cast[u8&], source.actual.len.usize()),
                    detail: unsafe_sview_bounded_bytes(detail_bits.cast[u8&], source.detail.len.usize()),
                    const_enum_module_expected: unsafe_sview_bounded_bytes(const_enum_module_expected_bits.cast[u8&], source.const_enum_module_expected.len.usize()),
                    const_enum_module_actual: unsafe_sview_bounded_bytes(const_enum_module_actual_bits.cast[u8&], source.const_enum_module_actual.len.usize()),
                    detail2: unsafe_sview_bounded_bytes(detail2_bits.cast[u8&], source.detail2.len.usize()),
                    detail3: unsafe_sview_bounded_bytes(detail3_bits.cast[u8&], source.detail3.len.usize()),
                    effect_ref_1: unsafe_sview_bounded_bytes(effect_ref_1_bits.cast[u8&], source.effect_ref_1.len.usize()),
                    effect_ref_2: unsafe_sview_bounded_bytes(effect_ref_2_bits.cast[u8&], source.effect_ref_2.len.usize()),
                    effect_ref_3: unsafe_sview_bounded_bytes(effect_ref_3_bits.cast[u8&], source.effect_ref_3.len.usize()),
                    effect_ref_4: unsafe_sview_bounded_bytes(effect_ref_4_bits.cast[u8&], source.effect_ref_4.len.usize()),
                    effect_ref_5: unsafe_sview_bounded_bytes(effect_ref_5_bits.cast[u8&], source.effect_ref_5.len.usize()),
                    effect_ref_6: unsafe_sview_bounded_bytes(effect_ref_6_bits.cast[u8&], source.effect_ref_6.len.usize()),
                    effect_ref_7: unsafe_sview_bounded_bytes(effect_ref_7_bits.cast[u8&], source.effect_ref_7.len.usize()),
                    effect_ref_8: unsafe_sview_bounded_bytes(effect_ref_8_bits.cast[u8&], source.effect_ref_8.len.usize()),
                    error_set: unsafe_sview_bounded_bytes(error_set_bits.cast[u8&], source.error_set.len.usize()),
                    line: source.line,
                    pos: source.pos,
                    kind: source.kind,
                    expected_count: source.expected_count,
                    actual_count: source.actual_count,
                    state_code: source.state_code,
                    secondary_line: source.secondary_line,
                    secondary_column: source.secondary_column,
                    secondary_end_column: source.secondary_end_column,
                    effect_ref_count: source.effect_ref_count
                })

        # Driver-facing diagnostic-only entry point. The full SymbolTable is deliberately local
        # to this call: returning it or threading it through the driver's region keeps every
        # semantic side table alive while LLVM builds its module. Only the located diagnostics
        # cross the boundary, so the table's region can be reclaimed before backend emission.
        def check_full_diagnostics[@r](file: Ast::File&, diagnostics: mutable darray[Diagnostic]& @r, enforce_unsafe_permissions: bool, flow_strict: bool, runtime_std: bool, flow_warn: bool, enable_smt: bool, warn_discarded: bool, enforce_progress: bool, enforce_extern_contracts: bool, enforce_raw_unsafe: bool, emit_proof_hole: bool, region_stack_cap: i64, enforce_global_permissions: bool, enforce_mutable_global_grants: bool, carrier_surface: bool) -> void:
            can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
                table: mutable SymbolTable = SymbolTable()
                table <- check_full_into(file, table, enforce_unsafe_permissions, flow_strict, runtime_std, flow_warn, enable_smt, warn_discarded, enforce_progress, enforce_extern_contracts, enforce_raw_unsafe, emit_proof_hole, region_stack_cap, enforce_global_permissions, enforce_mutable_global_grants, carrier_surface) can Global{Read,Write}
                # A non-exhaustive match makes its function fall through, so stage1 reported
                # BOTH "missing variants: …" and «"f" must return a value» for one defect;
                # stage0 reports only the first. Suppressed here rather than at the push site
                # because the missing-return check runs FIRST — at that point the diagnostic it
                # should defer to has not been created yet.
                # Three independent checks decide an `ensure` is unproven -- the strict walk,
                # the void-result contract pass and the branch-const pass -- and a function whose
                # postcondition none of them can discharge tripped all three, so one clause warned
                # up to THREE times. stage0 never reports two ensure findings at one location
                # (measured over the 928 internal-suite rows that carry the sentence), so the
                # second and later copies of a (function, line, detail) are dropped here.
                # Filtering on the way OUT rather than at the push sites keeps the UNION of what
                # the three can prove -- which is what stage0 reports -- without teaching each
                # check about the other two. It cannot be done inside the table: a locally built
                # replacement for `table.diagnostics` escapes its `in auto:` scope, and stage0
                # rejects that outright.
                #
                # A REFUTED postcondition also reads as unproven, so the refuter and the provers
                # both fired and stage1 printed the violation AND the weaker sentence for one
                # clause; stage0 prints the violation alone.
                error_set_lines: mutable darray[u32] = []
                error_set_names: mutable darray[sview] = []
                collect_function_error_sets(file.top_decls, file.enum_annotations, error_set_lines, error_set_names)
                refuted_lines: mutable darray[u32] = []
                for refuted_line_probe in table.diagnostics |refuted_lines|:
                    refuted_lines.push(refuted_line_probe.line) if diagnostic_refutes_obligation(refuted_line_probe.kind)
                ensure_violated_names: mutable darray[sview] = []
                ensure_violated_lines: mutable darray[u32] = []
                for violated_probe in table.diagnostics |ensure_violated_names, ensure_violated_lines|:
                    if violated_probe.kind == DiagnosticKind.EnsureNotProven and violated_probe.detail == "violated":
                        ensure_violated_names.push(violated_probe.name)
                        ensure_violated_lines.push(violated_probe.line)
                ensure_seen_names: mutable darray[sview] = []
                ensure_seen_lines: mutable darray[u32] = []
                ensure_seen_details: mutable darray[sview] = []
                for diagnostic in table.diagnostics |diagnostics, table, ensure_seen_names, ensure_seen_lines, ensure_seen_details, ensure_violated_names, ensure_violated_lines, refuted_lines, error_set_lines, error_set_names|:
                    skip: mutable bool = diagnostic.kind == DiagnosticKind.MissingReturnValue and line_has_non_exhaustive_diagnostic(table, diagnostic.line)
                    shape_row_has_no_extents: bool = diagnostic.kind == DiagnosticKind.FixedArrayShapeMismatch and diagnostic.name != "return" and diagnostic.expected_count == 0 and diagnostic.actual_count == 0
                    skip <- true if shape_row_has_no_extents and poe_line_has_other_kind(table, diagnostic.line, DiagnosticKind.FixedArrayShapeMismatch)
                    skip <- true if diagnostic.kind == DiagnosticKind.MatchArmEnumType and poe_arm_pair_reported(table, diagnostic.expected, diagnostic.name)
                    skip <- true if diagnostic.kind == DiagnosticKind.ContractEnsureResultVoid and poe_line_has_other_kind(table, diagnostic.line, DiagnosticKind.ContractEnsureResultVoid)
                    skip <- true if diagnostic.kind == DiagnosticKind.GenericOperatorNoBound and poe_line_has_other_kind(table, diagnostic.line, DiagnosticKind.GenericOperatorNoBound)
                    skip <- true if diagnostic.kind == DiagnosticKind.RegionReturnEscape and rre_line_outranked(table, diagnostic.line)
                    # A derived-state literal that fails as a constructor fails as the result too;
                    # stage0 reports the struct-literal sentence alone.
                    skip <- true if diagnostic.kind == DiagnosticKind.DerivedStateResultMismatch and poe_line_has_kind(table, diagnostic.line, DiagnosticKind.DerivedStateConstructorMismatch)
                    # The generic `in auto:` escape restates a named region escape on that return.
                    skip <- true if diagnostic.kind == DiagnosticKind.AutoRegionReturnEscape and rre_line_outranked(table, diagnostic.line)
                    # The raw string-view checks name a reference value just "reference"; when a
                    # precise check reported the same expression with its `T&` type, stage0
                    # prints only that sentence.
                    skip <- true if (diagnostic.actual == "reference" or diagnostic.actual == "raw reference") and poe_pos_has_precise_reference(table, diagnostic)
                    # stage0 stops at the FIRST defect in a construct and never reports what
                    # follows FROM it. Three pairs MEASURED against it, each of which stage1
                    # reported as two rows where stage0 gives one:
                    #   `n: i64 = x + 1` with `x: cstr`  -> the operator error alone
                    #   `for i in lo..10` with `lo: f64` -> the ambiguous-`..` error alone
                    #   `for x, x in pairs` over darray  -> the tuple-iterable error alone
                    # Each is keyed on the SPECIFIC kind that poisons it, never on "some
                    # diagnostic shares this line".
                    skip <- true if diagnostic.kind == DiagnosticKind.TypeMismatch and poe_line_has_operand_poison(table, diagnostic.line)
                    skip <- true if diagnostic.kind == DiagnosticKind.RangeBoundNonIntegral and poe_line_has_kind(table, diagnostic.line, DiagnosticKind.AmbiguousBareRange)
                    skip <- true if diagnostic.kind == DiagnosticKind.DuplicatePatternBinding and poe_line_has_kind(table, diagnostic.line, DiagnosticKind.TupleIterableNotTuple)
                    if diagnostic_leaves_obligation_open(diagnostic.kind):
                        for refuted_line in refuted_lines |skip, diagnostic|:
                            skip <- true if refuted_line == diagnostic.line
                    if diagnostic.kind == DiagnosticKind.EnsureNotProven:
                        ensure_seen: mutable bool = false
                        for ensure_probe in 0..<ensure_seen_names.count |ensure_seen, ensure_seen_names, ensure_seen_lines, ensure_seen_details, diagnostic|:
                            ensure_seen <- true if ensure_seen_names[ensure_probe] == diagnostic.name and ensure_seen_lines[ensure_probe] == diagnostic.line and ensure_seen_details[ensure_probe] == diagnostic.detail
                        if diagnostic.detail != "violated":
                            for refuted_probe in 0..<ensure_violated_names.count |ensure_seen, ensure_violated_names, ensure_violated_lines, diagnostic|:
                                ensure_seen <- true if ensure_violated_names[refuted_probe] == diagnostic.name and ensure_violated_lines[refuted_probe] == diagnostic.line
                        if not ensure_seen:
                            ensure_seen_names.push(diagnostic.name)
                            ensure_seen_lines.push(diagnostic.line)
                            ensure_seen_details.push(diagnostic.detail)
                        skip <- true if ensure_seen
                    for emitted in diagnostics |skip, diagnostic|:
                        skip <- true if emitted.kind == diagnostic.kind and emitted.line == diagnostic.line and emitted.pos.column == diagnostic.pos.column and emitted.pos.end_column == diagnostic.pos.end_column and emitted.name == diagnostic.name and emitted.expected == diagnostic.expected and emitted.actual == diagnostic.actual and emitted.detail == diagnostic.detail
                    out_row: mutable Diagnostic = diagnostic
                    out_row.error_set <- diag_return_error_set(error_set_lines, error_set_names, diagnostic.name, diagnostic.line)
                    if not skip:
                        source_bits: uintptr = (&out_row).cast[void&].uintptr()
                        diagnostic_export(source_bits, diagnostics)


        def check(file: Ast::File&) -> SymbolTable:
            can Unsafe.PointerCast:
                can Memory.Allocate, Abort.Panic:
                    return check_with_unsafe_permissions(file, false) can Global{Read,Write}


            # Resolve all references and return the full table (diagnostics included) —
            # the located-findings sibling of `unresolved_references` for harness probes that
            # need per-diagnostic lines, without the parse-error gating of `check`.
        def unresolved_table(file: Ast::File&) -> SymbolTable:
            can Memory.Allocate, Abort.Panic:
                table: mutable SymbolTable = SymbolTable()
                table <- seed_builtins(table) can Global{Read,Write}
                table <- register_region_type_names(file, table)
                table <- collect_range(file.top_decls, table, file.enum_annotations) can Global{Read,Write}
                table.generic_param_lines <- file.generic_param_lines
                table <- resolve_protocol_state_declarations(file, table)
                table.generic_param_names <- file.generic_param_names
                table <- index_generic_param_names(table) can Global{Read,Write}
                table.protocol_annotations <- file.enum_annotations
                table.using_alias_rows <- table.using_alias_rows.truncate(0)
                for annotation in file.enum_annotations |table|:
                    table.using_alias_rows <- table.using_alias_rows.push(annotation) if annotation.name == "__using_alias" or annotation.name == "__using_alias_target"
                table <- index_wildcard_imports(table, file.enum_annotations)
                table <- index_binder_annotations(table, file.enum_annotations) can Global{Read,Write}
                table <- binding_import_metadata(file.enum_annotations, table)
                for annotation in file.enum_annotations |table|:
                    table.protocol_declarations <- table.protocol_declarations.push(annotation) if annotation.owner == "__protocol_decl"
                for annotation in file.enum_annotations |table|:
                    table.generic_extern_names <- table.generic_extern_names.push(annotation.name) if annotation.owner == "__extern_generic_name"
                table.packed_enum_names <- file.packed_enum_names
                table <- register_using_alias_members(file.enum_annotations, table) can Global{Read,Write}
                for annotation in file.enum_annotations |table|:
                    if annotation.name == "__local_binding_mutable" or annotation.name == "__local_binding_immutable":
                        local_binding_row: usize = table.local_binding_names.count
                        table <- table.index_local_binding_exact(annotation.owner, annotation.line, annotation.offset, local_binding_row) can Global{Read,Write}
                        table.local_binding_names <- table.local_binding_names.push(annotation.owner)
                        table.local_binding_lines <- table.local_binding_lines.push(annotation.line)
                        table.local_binding_offsets <- table.local_binding_offsets.push(annotation.offset)
                        table.local_binding_modes <- table.local_binding_modes.push(1) if annotation.name == "__local_binding_mutable"
                        table.local_binding_modes <- table.local_binding_modes.push(-1) if annotation.name == "__local_binding_immutable"
                    table.imported_modules <- table.imported_modules.push(annotation.owner) if annotation.name == "__using"
                    if annotation.name == "__local_binding_mutable" or annotation.name == "__local_binding_immutable" or annotation.name == "__loop_header_accumulator":
                        binding_annotation_row: usize = table.binding_annotations.count
                        table <- table.index_binding_annotation_exact(annotation, binding_annotation_row) can Global{Read,Write}
                        table.binding_annotations <- table.binding_annotations.push(annotation)
                    # `using Mod as M` — the ALIAS is a module name in its own right, and
                    # the module it stands for is imported. Without the symbol, `M::f()`
                    # resolved to `undefined identifier 'M'`.
                    table <- table.add_symbol(annotation.owner, SymbolKind.Module, annotation.line, 0, 0, sview("", 0, 0), 0, annotation.offset, annotation.pos) can Global{Read,Write} if annotation.name == "__using_alias"
                    table.imported_modules <- table.imported_modules.push(annotation.owner) if annotation.name == "__using_alias_target"
                    table.imported_members <- table.imported_members.push(annotation.name) if annotation.owner == "__from_member"
                    table.catch_match_lines <- table.catch_match_lines.push(annotation.line) if annotation.name == "__catch_match"
                    table.new_construct_lines <- table.new_construct_lines.push(annotation.line) if annotation.name == "__new_construct"
                    table.forward_arg_lines <- table.forward_arg_lines.push(annotation.line) if annotation.name == "__arg_forward"
                    table.block_if_lines <- table.block_if_lines.push(annotation.line) if annotation.name == "__block_if"
                    table.query_binder_lines <- table.query_binder_lines.push(annotation.line) if annotation.name == "__query_binder"
                    table.query_binder_names <- table.query_binder_names.push(annotation.owner) if annotation.name == "__query_binder"
                    table.enum_hierarchy_child <- table.enum_hierarchy_child.push(annotation.owner) if annotation.line == 3900000008
                    table.enum_hierarchy_parent <- table.enum_hierarchy_parent.push(annotation.name) if annotation.line == 3900000008
                table.enum_common_owners <- file.enum_common_owners
                table.enum_common_modules <- file.enum_common_modules
                table.enum_common_counts <- file.enum_common_counts
                table <- validate_struct_layouts(file, table)
                table <- resolve_declarations(file.top_decls, table) can Global{Read,Write}
                # Checkers read the loop view (semantic_loop_view.elisa): captured-loop statements
                # become Stmt.Block("loop") so every statement walker descends them.
                loop_view: Ast::File = semantic_loop_view(file)
                return table


        # Resolve all references in a parsed file; returns the count of unresolved
        # (undefined) value-position identifier references — the number of UndefinedName
        # diagnostics. Anchors the resolver call graph for the smoke harness.
        def unresolved_references(file: Ast::File&) -> u64:
            can Memory.Allocate, Abort.Panic:
                table: mutable SymbolTable = SymbolTable()
                table <- seed_builtins(table) can Global{Read,Write}
                table <- collect_range(file.top_decls, table, file.enum_annotations) can Global{Read,Write}
                table.generic_param_lines <- file.generic_param_lines
                table <- resolve_protocol_state_declarations(file, table)
                table.generic_param_names <- file.generic_param_names
                table <- index_generic_param_names(table) can Global{Read,Write}
                table.protocol_annotations <- file.enum_annotations
                table.using_alias_rows <- table.using_alias_rows.truncate(0)
                for annotation in file.enum_annotations |table|:
                    table.using_alias_rows <- table.using_alias_rows.push(annotation) if annotation.name == "__using_alias" or annotation.name == "__using_alias_target"
                table <- index_wildcard_imports(table, file.enum_annotations)
                table <- index_binder_annotations(table, file.enum_annotations) can Global{Read,Write}
                table <- binding_import_metadata(file.enum_annotations, table)
                for annotation in file.enum_annotations |table|:
                    table.protocol_declarations <- table.protocol_declarations.push(annotation) if annotation.owner == "__protocol_decl"
                for annotation in file.enum_annotations |table|:
                    table.generic_extern_names <- table.generic_extern_names.push(annotation.name) if annotation.owner == "__extern_generic_name"
                table.packed_enum_names <- file.packed_enum_names
                table <- register_using_alias_members(file.enum_annotations, table) can Global{Read,Write}
                for annotation in file.enum_annotations |table|:
                    table.imported_modules <- table.imported_modules.push(annotation.owner) if annotation.name == "__using"
                    if annotation.name == "__local_binding_mutable" or annotation.name == "__local_binding_immutable" or annotation.name == "__loop_header_accumulator":
                        binding_annotation_row: usize = table.binding_annotations.count
                        table <- table.index_binding_annotation_exact(annotation, binding_annotation_row) can Global{Read,Write}
                        table.binding_annotations <- table.binding_annotations.push(annotation)
                    # `using Mod as M` — the ALIAS is a module name in its own right, and
                    # the module it stands for is imported. Without the symbol, `M::f()`
                    # resolved to `undefined identifier 'M'`.
                    table <- table.add_symbol(annotation.owner, SymbolKind.Module, annotation.line, 0, 0, sview("", 0, 0), 0, annotation.offset, annotation.pos) can Global{Read,Write} if annotation.name == "__using_alias"
                    table.imported_modules <- table.imported_modules.push(annotation.owner) if annotation.name == "__using_alias_target"
                    table.imported_members <- table.imported_members.push(annotation.name) if annotation.owner == "__from_member"
                    table.catch_match_lines <- table.catch_match_lines.push(annotation.line) if annotation.name == "__catch_match"
                    table.new_construct_lines <- table.new_construct_lines.push(annotation.line) if annotation.name == "__new_construct"
                    table.forward_arg_lines <- table.forward_arg_lines.push(annotation.line) if annotation.name == "__arg_forward"
                    table.block_if_lines <- table.block_if_lines.push(annotation.line) if annotation.name == "__block_if"
                    table.query_binder_lines <- table.query_binder_lines.push(annotation.line) if annotation.name == "__query_binder"
                    table.query_binder_names <- table.query_binder_names.push(annotation.owner) if annotation.name == "__query_binder"
                    table.enum_hierarchy_child <- table.enum_hierarchy_child.push(annotation.owner) if annotation.line == 3900000008
                    table.enum_hierarchy_parent <- table.enum_hierarchy_parent.push(annotation.name) if annotation.line == 3900000008
                table.enum_common_owners <- file.enum_common_owners
                table.enum_common_modules <- file.enum_common_modules
                table.enum_common_counts <- file.enum_common_counts
                table <- validate_struct_layouts(file, table)
                table <- resolve_declarations(file.top_decls, table) can Global{Read,Write}
                # docs/119 §3: count UndefinedName diagnostics with a loop-expression fold —
                # the accumulator is loop-private and the body is pure over outer state.
                count: u64 =
                    for diagnostic in table.diagnostics |undefined_count = 0| -> undefined_count:
                        undefined_count <- undefined_count + 1 if diagnostic.kind == DiagnosticKind.UndefinedName
                return count
