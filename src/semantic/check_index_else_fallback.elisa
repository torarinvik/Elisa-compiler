# The implicit `else` index fallback (`xs[i] else DEFAULT`) has been removed. Indexing a
# darray/array yields a bounds-checked element, so the trailing `else` was a silent
# bounds fallback — now spelled explicitly as `get xs[i] else ...`. The parser preserves the
# old form losslessly as `Binary(Index(base, idx), Else, fallback)`.
#
# Fires only when the indexed base is a darray/array-typed local or parameter. A `dict[k] else d`
# is the VALID optional-else form (dict lookup yields an optional), so dict bases — parsed as
# IndexN, and whose declared type head is `dict` — are excluded. Bases whose container kind
# cannot be resolved from a declared type are a conservative miss.
#
# The EXPLICIT `get xs[i] else ...` form parses to the SAME Binary(Index, Else) node as the bare
# fallback, but the parser records a `__checked_get` annotation at the `get` line — so a Binary
# whose line carries that annotation is the accepted spelling and is never flagged.
extend Semantic:
    private:
        def ief_line_is_checked_get(annotations: darray[Ast::EnumAnnotation]&, line: u32) -> bool:
            can Abort.Panic:
                return any annotation in annotations where annotation.owner == "__checked_get" and annotation.line == line
        # The container head of a (possibly &/mutable/paren-wrapped) type expression:
        # `darray[T]` -> "darray", `array[N, T]` -> "array", `dict[K, V]` -> "dict", else "".
        def ief_container_head(type_expression: Ast::Expr) -> sview:
            can Memory.Allocate, Abort.Panic:
                match type_expression:
                    Expr.Unary(operator, operand, unary_line):
                        return ief_container_head(operand)
                    Expr.Paren(inner, paren_line):
                        return ief_container_head(inner)
                    Expr.Index(object, index, index_line):
                        return ident_name_of(object)
                    Expr.IndexN(object, arguments, indexn_line):
                        return ident_name_of(object)
                    _:
                        return sview("", 0, 0)

        # Whether NAME is a darray/array-typed local or param in the parallel (names, heads) table.
        def ief_base_is_bounded_container(names: darray[sview]&, heads: darray[sview]&, name: sview) -> bool:
            can Abort.Panic:
                found: mutable bool = false
                while probe < names.count |found, probe: usize = 0|:
                    if names[probe] == name and name != "":
                        found <- true if heads[probe] == "darray" or heads[probe] == "array"
                    probe <- probe + 1
                return found

        def ief_check_expression(expression: Ast::Expr, names: darray[sview]&, heads: darray[sview]&, annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Binary(left, operator, right, binary_line):
                        if operator == TokenKind.Else:
                            if left is Expr.Index(index_base, index_argument, index_line):
                                base_name: sview = ident_name_of(index_base)
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.IndexElseFallbackRemoved, name: "", line: binary_line.line, expected: "", actual: ""}) if ief_base_is_bounded_container(names, heads, base_name) and not ief_line_is_checked_get(annotations, binary_line.line)
                        table <- ief_check_expression(left, names, heads, annotations, table)
                        table <- ief_check_expression(right, names, heads, annotations, table)
                    Expr.Unary(operator, operand, unary_line):
                        table <- ief_check_expression(operand, names, heads, annotations, table)
                    Expr.Paren(inner, paren_line):
                        table <- ief_check_expression(inner, names, heads, annotations, table)
                    Expr.Index(object, index, index_line):
                        table <- ief_check_expression(object, names, heads, annotations, table)
                        table <- ief_check_expression(index, names, heads, annotations, table)
                    Expr.Call(callee, arguments, argument_names, call_line):
                        table <- ief_check_expression(callee, names, heads, annotations, table)
                        for argument in arguments |table| -> table:
                            table <- ief_check_expression(argument, names, heads, annotations, table)
                    Expr.Field(field_object, field_name, field_line):
                        table <- ief_check_expression(field_object, names, heads, annotations, table)
                    _:
                        pass

        def ief_check_statements(statements: darray[Ast::Stmt], names: mutable darray[sview]&, heads: mutable darray[sview]&, annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |names, heads, table| -> table:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            head: sview = ief_container_head(type_expression)
                            if head != "":
                                names.push(name)
                                heads.push(head)
                            table <- ief_check_expression(value, names, heads, annotations, table)
                        Stmt.Assign(target, operator, value, line):
                            table <- ief_check_expression(value, names, heads, annotations, table)
                        Stmt.Expr(expression, line):
                            table <- ief_check_expression(expression, names, heads, annotations, table)
                        Stmt.Return(value, line):
                            if value is returned:
                                table <- ief_check_expression(returned, names, heads, annotations, table)
                        Stmt.If(condition, then_body, else_body, if_line):
                            table <- ief_check_expression(condition, names, heads, annotations, table)
                            table <- ief_check_statements(then_body, names, heads, annotations, table)
                            table <- ief_check_statements(else_body, names, heads, annotations, table)
                        Stmt.While(condition, while_body, while_line):
                            table <- ief_check_expression(condition, names, heads, annotations, table)
                            table <- ief_check_statements(while_body, names, heads, annotations, table)
                        Stmt.For(bind, variables, iterable, for_body, for_line):
                            table <- ief_check_expression(iterable, names, heads, annotations, table)
                            table <- ief_check_statements(for_body, names, heads, annotations, table)
                        Stmt.Block(kind, clause, binding, body, block_line):
                            table <- ief_check_statements(body, names, heads, annotations, table)
                        Stmt.Match(scrutinee, arms, match_line):
                            table <- ief_check_expression(scrutinee, names, heads, annotations, table)
                            for arm in arms |names, heads, table| -> table:
                                table <- ief_check_statements(arm.body, names, heads, annotations, table)
                        _:
                            pass

        def ief_check_declarations(declarations: darray[Ast::Decl], annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            names: mutable darray[sview] = []
                            heads: mutable darray[sview] = []
                            for parameter in parameters |names, heads|:
                                param_head: sview = ief_container_head(parameter.type_expression)
                                if param_head != "":
                                    names.push(parameter.name)
                                    heads.push(param_head)
                            table <- ief_check_statements(body, names, heads, annotations, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- ief_check_declarations(module_body, annotations, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- ief_check_declarations(scoped_body, annotations, table)
                        _:
                            pass

    public:
        def check_index_else_fallback(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- ief_check_declarations(file.top_decls, file.enum_annotations, table)
