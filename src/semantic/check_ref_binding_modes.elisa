# The reference capability of every binding a function body can name (rule R).
#
# stage0 decides what `x <- v`, `x[i] <- v`, `x.f <- v` and `f(x)` mean from the BINDING,
# not from the declared type alone: a plain `T&` is readonly, a `mutable T&` writes through,
# and a leading `mutable x:` qualifier makes the slot rebindable without making the referent
# writable. A legacy `x: mutable T& = src` local keeps the capability of `src` -- initialised
# from a readonly reference it is only rebindable. This file models that classification and
# the type spelling the diagnostics print; check_ref_binding_rules.elisa applies the rules and
# check_readonly_ref.elisa walks the declarations.
#
# Every query here answers "unknown" rather than guess: a binding this pass does not model is
# OPAQUE, a type it cannot spell has an empty `elem`, and assignability is three-valued. No
# rule fires on an unknown.
extend Semantic:
    private:
        # Reference-spelling flag bits, packed in one u32: the storage words, `mutable`, `?`,
        # whether the spelling is a reference at all, and PRESENT -- the speller understood
        # the expression. A spelling without PRESENT is a decline.
        const RBM_STATIC: u32 = 1
        const RBM_HEAP: u32 = 2
        const RBM_STACK: u32 = 4
        const RBM_STORAGE: u32 = 7
        const RBM_MUTABLE: u32 = 8
        const RBM_NULLABLE: u32 = 16
        const RBM_REF: u32 = 64
        const RBM_PRESENT: u32 = 128
        const RBM_NONE: u32 = 4294967295

        # Binding modes. VALUE / VALUE_MUTABLE are not references (`&x` borrows them).
        # R: readonly reference. RL: a legacy `x: mutable T& = <readonly>` local, demoted to
        # the initializer's capability but still rebindable. RB: `mutable x: T&`, rebindable
        # only. W: writes through, fixed slot. WR: writes through and rebindable. OPAQUE: a
        # binding this pass does not model; nothing fires on it.
        const RBM_MODE_VALUE: u32 = 0
        const RBM_MODE_VALUE_MUTABLE: u32 = 1
        const RBM_MODE_R: u32 = 2
        const RBM_MODE_RL: u32 = 3
        const RBM_MODE_RB: u32 = 4
        const RBM_MODE_W: u32 = 5
        const RBM_MODE_WR: u32 = 6
        const RBM_MODE_OPAQUE: u32 = 7

        # Semantic operation recorded per bare-identifier `<-` target for the borrow pass.
        const RBM_ASSIGN_EFFECT_UNKNOWN: u32 = 0
        const RBM_ASSIGN_EFFECT_WRITE_THROUGH: u32 = 1
        const RBM_ASSIGN_EFFECT_REBIND: u32 = 2

        # Pack the complete source span into one u64 key. A zero-width/synthetic position
        # cannot identify an assignment site and is deliberately left unindexed.
        def rbm_assignment_site_key(position: Ast::Pos) -> u64:
            can Abort.Panic:
                return 0 if position.end_offset <= position.offset
                return (position.offset.u64() << 32.u64()) | position.end_offset.u64()

        # Where a binding lives: what storage word `&x` of a value binding carries.
        const RBM_KIND_LOCAL: u32 = 0
        const RBM_KIND_PARAM: u32 = 1
        const RBM_KIND_GLOBAL: u32 = 2
        const RBM_KIND_CONST: u32 = 3

        # Three-valued assignability.
        const RBM_UNKNOWN: u32 = 0
        const RBM_YES: u32 = 1
        const RBM_NO: u32 = 2


        # stage0's printed type: storage words, `mutable`, the element, `&`, `?`. A non-reference
        # prints as its element alone (`int`, `bool`, `S`).
        def push_ref_binding_type(buffer: mutable darray[u8]&, elem: sview, flags: u32) -> void:
            can Memory.Allocate, Abort.Panic:
                if (flags & RBM_REF) == 0:
                    push_sview(buffer, elem)
                else:
                    push_str(buffer, "static ") if (flags & RBM_STATIC) != 0
                    push_str(buffer, "heap ") if (flags & RBM_HEAP) != 0
                    push_str(buffer, "stack ") if (flags & RBM_STACK) != 0
                    push_str(buffer, "mutable ") if (flags & RBM_MUTABLE) != 0
                    push_sview(buffer, elem)
                    push_str(buffer, "&")
                    push_str(buffer, "?") if (flags & RBM_NULLABLE) != 0


        # stage0's suggested writable spelling puts `mutable` FIRST: `mutable static u8&`.
        def push_ref_binding_suggestion(buffer: mutable darray[u8]&, elem: sview, flags: u32, qualifier: sview = "") -> void:
            can Memory.Allocate, Abort.Panic:
                push_str(buffer, "mutable ")
                push_str(buffer, "static ") if (flags & RBM_STATIC) != 0
                push_str(buffer, "heap ") if (flags & RBM_HEAP) != 0
                push_str(buffer, "stack ") if (flags & RBM_STACK) != 0
                if qualifier != "":
                    push_sview(buffer, qualifier)
                    push_str(buffer, ".")
                push_sview(buffer, elem)
                push_str(buffer, "&")
                push_str(buffer, "?") if (flags & RBM_NULLABLE) != 0


        def rbm_clear(flags: u32, bit: u32) -> u32:
            return flags ^ bit if (flags & bit) != 0 else flags


        # A type or value as stage0 prints it: the element name and the reference flags.
        # `elem` is "" for anything the printer cannot spell (a generic, a container, a
        # function type), which every rule treats as unknown.
        struct RefSpelling:
            elem: sview @source
            flags: u32
            # A module-qualified type (`M::S`) keeps `elem` "" -- every rule still declines on
            # it -- but remembers the spelling so the readonly note can print `M.S` as stage0
            # does. Both are source sviews.
            qual: sview @source = ""
            shown: sview @source = ""


        def rbm_decline() -> RefSpelling:
            return RefSpelling{elem: "", flags: 0}


        def rbm_spelling_bit(operator: TokenKind) -> u32:
            can Abort.Panic:
                match operator:
                    TokenKind.Mutable:
                        return RBM_MUTABLE
                    TokenKind.Static:
                        return RBM_STATIC
                    TokenKind.Heap:
                        return RBM_HEAP
                    TokenKind.Stack:
                        return RBM_STACK
                    TokenKind.Question:
                        return RBM_NULLABLE
                    _:
                        return 0


        # Prefix qualifiers wrap the whole type and `?` sits outside `&`:
        # `mutable static u8&?` is Unary(Mutable, Unary(Static, Unary(Question, Unary(Ampersand, u8)))).
        def rbm_type_spelling(expression: Ast::Expr) -> RefSpelling:
            can Abort.Panic:
                match expression:
                    Expr.Ident(name, ident_pos):
                        return RefSpelling{elem: name, flags: RBM_PRESENT}
                    Expr.Scope(base, name, scope_pos):
                        qualifier: sview @source = module_name if base is Ast::Expr.Ident(module_name, _) else ""
                        return RefSpelling{elem: "", flags: RBM_PRESENT, qual: qualifier, shown: name if qualifier != "" else ""}
                    Expr.Unary(operator, operand, unary_pos):
                        if operator == TokenKind.Ampersand:
                            referent: sview @source = referent_name if operand is Ast::Expr.Ident(referent_name, _) else ""
                            scoped: RefSpelling = rbm_type_spelling(operand) if operand is Ast::Expr.Scope(_, _, _) else RefSpelling{elem: "", flags: 0}
                            return RefSpelling{elem: referent, flags: RBM_PRESENT | RBM_REF, qual: scoped.qual, shown: scoped.shown}
                        inner: RefSpelling = rbm_type_spelling(operand)
                        bit: u32 = rbm_spelling_bit(operator)
                        return RefSpelling{elem: inner.elem, flags: inner.flags | bit, qual: inner.qual, shown: inner.shown} if bit != 0
                        # `lmut`, `tail`, `owned`: a mode this printer does not spell.
                        return RefSpelling{elem: "", flags: inner.flags}
                    Expr.Paren(inner_type, paren_pos):
                        return rbm_type_spelling(inner_type)
                    Expr.Refinement(base, predicate, refinement_pos):
                        return RefSpelling{elem: "", flags: rbm_type_spelling(base).flags}
                    _:
                        pass
                return RefSpelling{elem: "", flags: RBM_PRESENT}


        # How many `darray[...]` levels a type spelling nests, through `&` and `mutable`.
        def rbm_darray_depth(expression: Ast::Expr) -> u32:
            can Abort.Panic:
                match expression:
                    Expr.Unary(operator, operand, unary_pos):
                        return rbm_darray_depth(operand) if operator == TokenKind.Mutable or operator == TokenKind.Ampersand
                    Expr.Paren(inner, paren_pos):
                        return rbm_darray_depth(inner)
                    Expr.Index(object, argument, index_pos):
                        return rbm_darray_depth(argument) + 1 if ident_name_of(object) == "darray"
                    _:
                        pass
                return 0


        # One binding as the rules see it. `declared` holds the flags the declaration spelled;
        # `current` the capability it has now (an RL local's is the declared type minus
        # `mutable`). `proven` is set on a shadow row pushed by `!= null` narrowing.
        struct RefBinding:
            mode: u32
            kind: u32
            elem: sview @source
            bare: sview @source
            declared: u32
            current: u32
            proven: bool
            # darray nesting of the declared type (`darray[darray[i64]]&` = 2); 0 when unknown.
            depth: u32
            # RefSpelling.qual/shown of the declared type, for the readonly note only.
            qual: sview @source = ""
            shown: sview @source = ""


        def rbm_opaque_binding() -> RefBinding:
            return RefBinding{mode: RBM_MODE_OPAQUE, kind: RBM_KIND_LOCAL, elem: "", bare: "", declared: 0, current: 0, proven: false, depth: 0}


        # The bindings in scope at one point of the walk. Locals are a stack of parallel
        # columns, marked on block entry and truncated on exit, searched newest-first so an
        # inner binding shadows an outer one. Globals are collected once, with a hash chain
        # per name. The struct-field rows of the SymbolTable get a hash chain per
        # (struct, field), and `call_elems`/`call_flags` spell every callee row's type (the
        # return type on a function row, the parameter type on a parameter row).
        struct RefBindingScope:
            names: mutable darray[sview @source]
            elems: mutable darray[sview @source]
            bares: mutable darray[sview @source]
            modes: mutable darray[u32]
            kinds: mutable darray[u32]
            declared: mutable darray[u32]
            current: mutable darray[u32]
            proven: mutable darray[bool]
            depths: mutable darray[u32]
            quals: mutable darray[sview @source]
            showns: mutable darray[sview @source]
            global_names: mutable darray[sview @source]
            global_owners: mutable darray[sview @source]
            global_elems: mutable darray[sview @source]
            global_bares: mutable darray[sview @source]
            global_modes: mutable darray[u32]
            global_kinds: mutable darray[u32]
            global_declared: mutable darray[u32]
            global_heads: mutable dict[u64, u32]
            global_next: mutable darray[u32]
            field_heads: mutable dict[u64, u32]
            field_next: mutable darray[u32]
            call_elems: mutable darray[sview @source]
            call_flags: mutable darray[u32]
            # The enclosing function's declared return type, spelled; flags 0 outside one.
            return_elem: mutable sview @source
            return_flags: mutable u32


        def rbm_push(bindings: mutable RefBindingScope&, name: sview @source, binding: RefBinding) -> void:
            can Memory.Allocate, Abort.Panic:
                bindings.names <- bindings.names.push(name)
                bindings.elems <- bindings.elems.push(binding.elem)
                bindings.bares <- bindings.bares.push(binding.bare)
                bindings.modes <- bindings.modes.push(binding.mode)
                bindings.kinds <- bindings.kinds.push(binding.kind)
                bindings.declared <- bindings.declared.push(binding.declared)
                bindings.current <- bindings.current.push(binding.current)
                bindings.proven <- bindings.proven.push(binding.proven)
                bindings.depths <- bindings.depths.push(binding.depth)
                bindings.quals <- bindings.quals.push(binding.qual)
                bindings.showns <- bindings.showns.push(binding.shown)


        def rbm_push_opaque(bindings: mutable RefBindingScope&, name: sview @source) -> void:
            can Memory.Allocate, Abort.Panic:
                rbm_push(bindings, name, rbm_opaque_binding()) if name != ""


        def rbm_truncate(bindings: mutable RefBindingScope&, mark: usize) -> void:
            can Memory.Allocate, Abort.Panic:
                if bindings.names.count > mark:
                    bindings.names <- bindings.names.truncate(mark)
                    bindings.elems <- bindings.elems.truncate(mark)
                    bindings.bares <- bindings.bares.truncate(mark)
                    bindings.modes <- bindings.modes.truncate(mark)
                    bindings.kinds <- bindings.kinds.truncate(mark)
                    bindings.declared <- bindings.declared.truncate(mark)
                    bindings.current <- bindings.current.truncate(mark)
                    bindings.proven <- bindings.proven.truncate(mark)
                    bindings.depths <- bindings.depths.truncate(mark)
                    bindings.quals <- bindings.quals.truncate(mark)
                    bindings.showns <- bindings.showns.truncate(mark)


        # Locals newest-first, then a global of the current module, then a top-level global.
        # Anything else -- a function, an enum constant, an unmodeled binding -- is OPAQUE.
        def rbm_lookup(bindings: RefBindingScope&, name: sview, table: SymbolTable&) -> RefBinding:
            can Abort.Panic:
                index: mutable usize = bindings.names.count
                while index > 0 |index|:
                    index <- index - 1.usize()
                    return RefBinding{mode: bindings.modes[index], kind: bindings.kinds[index], elem: bindings.elems[index], bare: bindings.bares[index], declared: bindings.declared[index], current: bindings.current[index], proven: bindings.proven[index], depth: bindings.depths[index], qual: bindings.quals[index], shown: bindings.showns[index]} if bindings.names[index] == name
                module_row: mutable u32 = RBM_NONE
                top_row: mutable u32 = RBM_NONE
                row: mutable u32 = head if bindings.global_heads.get(name_hash(name)) is head else RBM_NONE
                # The chain runs newest-first; the last match is the first declaration.
                while row != RBM_NONE |row, module_row, top_row|:
                    if bindings.global_names[row.usize()] == name:
                        module_row <- row if table.current_module != "" and bindings.global_owners[row.usize()] == table.current_module
                        top_row <- row if bindings.global_owners[row.usize()] == ""
                    row <- bindings.global_next[row.usize()]
                chosen: u32 = module_row if module_row != RBM_NONE else top_row
                return rbm_opaque_binding() if chosen == RBM_NONE
                at: usize = chosen.usize()
                return RefBinding{mode: bindings.global_modes[at], kind: bindings.global_kinds[at], elem: bindings.global_elems[at], bare: bindings.global_bares[at], declared: bindings.global_declared[at], current: bindings.global_declared[at], proven: false, depth: 0}


        # A global's binding. `global mutable g: T&` rebinds (and writes through when T spells
        # `mutable`); a plain `global` has a fixed slot; a `const` is readonly. An untyped
        # global is OPAQUE. Globals are never demoted: stage0 checks their initializer instead
        # (check_ref_binding_rules.elisa, rbm_check_global_init).
        def rbm_global_binding(type_expression: Ast::Expr, is_global: bool, slot_mutable: bool) -> RefBinding:
            can Abort.Panic:
                match type_expression:
                    Expr.Absent:
                        return rbm_opaque_binding()
                    Expr.Invalid:
                        return rbm_opaque_binding()
                    _:
                        pass
                kind: u32 = RBM_KIND_GLOBAL if is_global else RBM_KIND_CONST
                bare: sview @source = bare_type_name_through_ref(type_expression)
                spelled: RefSpelling = rbm_type_spelling(type_expression)
                writable: bool = (spelled.flags & RBM_MUTABLE) != 0
                if (spelled.flags & RBM_REF) != 0:
                    mode: mutable u32 = RBM_MODE_R
                    if slot_mutable:
                        mode <- RBM_MODE_WR if writable else RBM_MODE_RB
                    elif is_global:
                        mode <- RBM_MODE_W if writable else RBM_MODE_R
                    return RefBinding{mode: mode, kind: kind, elem: spelled.elem, bare: bare, declared: spelled.flags, current: spelled.flags, proven: false, depth: 0, qual: spelled.qual, shown: spelled.shown}
                value_mode: u32 = RBM_MODE_VALUE_MUTABLE if slot_mutable else RBM_MODE_VALUE
                value_elem: sview @source = "" if (spelled.flags & RBM_NULLABLE) != 0 else spelled.elem
                return RefBinding{mode: value_mode, kind: kind, elem: value_elem, bare: bare, declared: 0, current: 0, proven: false, depth: 0}


        # Whether a `global mutable NAME` annotation names this declaration. The parser records
        # the `global` keyword's line, which is also the Decl.Const position.
        def rbm_global_slot_mutable(name: sview, line: u32, mutable_names: darray[sview]&, mutable_lines: darray[u32]&) -> bool:
            can Abort.Panic:
                while index < mutable_names.count |index: usize = 0|:
                    return true if mutable_names[index] == name and mutable_lines[index] == line
                    index <- index + 1
                return false


        def rbm_collect_globals(declarations: darray[Ast::Decl], owner: sview @source, mutable_names: darray[sview]&, mutable_lines: darray[u32]&, bindings: mutable RefBindingScope&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |bindings|:
                    match declaration:
                        Decl.Const(name, type_expression, value, is_global, const_pos):
                            binding: RefBinding = rbm_global_binding(type_expression, is_global, rbm_global_slot_mutable(name, const_pos.line, mutable_names, mutable_lines))
                            row: u32 = bindings.global_names.count.u32()
                            previous: u32 = head if bindings.global_heads.get(name_hash(name)) is head else RBM_NONE
                            bindings.global_names <- bindings.global_names.push(name)
                            bindings.global_owners <- bindings.global_owners.push(owner)
                            bindings.global_elems <- bindings.global_elems.push(binding.elem)
                            bindings.global_bares <- bindings.global_bares.push(binding.bare)
                            bindings.global_modes <- bindings.global_modes.push(binding.mode)
                            bindings.global_kinds <- bindings.global_kinds.push(binding.kind)
                            bindings.global_declared <- bindings.global_declared.push(binding.declared)
                            bindings.global_next <- bindings.global_next.push(previous)
                            bindings.global_heads <- bindings.global_heads.put(name_hash(name), row) can Global{Read,Write}
                        Decl.Module(name, body, module_pos):
                            rbm_collect_globals(body, name, mutable_names, mutable_lines, bindings) can Global{Read,Write}
                        Decl.Scoped(body, scoped_pos):
                            rbm_collect_globals(body, owner, mutable_names, mutable_lines, bindings) can Global{Read,Write}
                        _:
                            pass


        def rbm_field_key(owner: sview, field: sview) -> u64:
            return (name_hash(owner) * SEMANTIC_HASH_PRIME) ^ name_hash(field)


        def rbm_build_field_index(bindings: mutable RefBindingScope&, table: SymbolTable&) -> void:
            can Memory.Allocate, Abort.Panic:
                paired: mutable usize = table.struct_field_owner.count
                paired <- table.struct_field_name.count if table.struct_field_name.count < paired
                paired <- table.private_field_types.count if table.private_field_types.count < paired
                paired <- table.struct_field_mutable.count if table.struct_field_mutable.count < paired
                for row in 0..<paired |bindings|:
                    key: u64 = rbm_field_key(table.struct_field_owner[row], table.struct_field_name[row])
                    previous: u32 = head if bindings.field_heads.get(key) is head else RBM_NONE
                    bindings.field_next <- bindings.field_next.push(previous)
                    bindings.field_heads <- bindings.field_heads.put(key, row.u32()) can Global{Read,Write}


        # The struct-field row for OWNER.FIELD, or RBM_NONE. The first declaration wins.
        def rbm_field_row(bindings: RefBindingScope&, owner: sview, field: sview, table: SymbolTable&) -> u32:
            can Abort.Panic:
                return RBM_NONE if owner == ""
                found: mutable u32 = RBM_NONE
                row: mutable u32 = head if bindings.field_heads.get(rbm_field_key(owner, field)) is head else RBM_NONE
                while row != RBM_NONE |row, found|:
                    found <- row if table.struct_field_owner[row.usize()] == owner and table.struct_field_name[row.usize()] == field
                    row <- bindings.field_next[row.usize()]
                return found


        # stage0 registers the runtime structs as builtins (analyzer_builtins.go
        # registerBuiltinStructType) and skips a same-named top-level source declaration
        # (isBuiltinRuntimeStructName), so the builtin field spec -- not the source -- decides
        # whether a field is `mutable`. The spec makes every field mutable except the
        # view-shaped structs' fields and Region's tail. ArenaMark is where the two disagree
        # today: its source fields are not `mutable`, its builtin fields are.
        def rbm_builtin_runtime_struct(owner: sview) -> bool:
            return when owner:
                "ArenaFreeBlock" | "Thread" | "Task" | "ThreadPool" | "TaskGroup" -> true
                "Mutex" | "MutexGuard" | "CondVar" | "atomic" | "AtomicSlot" -> true
                "Region" | "Arena" | "ArenaMark" | "StringView" -> true
                "DynArray" | "DynArrayView" | "DictBucket" | "DynDict" -> true
                "SplitView" | "ChunksExactView" | "TreeChildren" | "EnumerateView" -> true
                "NodeKey" | "NodeTable" -> true
                "PackedStoreAllocResult" | "PackedStoreIndexAllocResult" -> true
                _ -> false


        # Whether struct-field ROW is `mutable`, as stage0 decides it (see above).
        def rbm_field_mutable(row: u32, table: SymbolTable&) -> bool:
            can Abort.Panic:
                owner: sview @source = table.struct_field_owner[row.usize()]
                if row.usize() < table.struct_field_module.count:
                    return table.struct_field_mutable[row.usize()] if table.struct_field_module[row.usize()] != ""
                return table.struct_field_mutable[row.usize()] if not rbm_builtin_runtime_struct(owner)
                return false if:
                    owner == "SplitView" or owner == "ChunksExactView" or owner == "TreeChildren" or owner == "EnumerateView"
                    owner == "NodeKey" or owner == "NodeTable"
                return owner != "Region" or table.struct_field_name[row.usize()] != "data"


        # The struct an access path's value has, when this pass can name it.
        def rbm_expr_struct(expression: Ast::Expr, bindings: RefBindingScope&, table: SymbolTable&) -> sview:
            can Abort.Panic:
                match expression:
                    Expr.Ident(name, ident_pos):
                        return rbm_lookup(bindings, name, table).elem
                    Expr.Field(object, field, field_pos):
                        row: u32 = rbm_field_row(bindings, rbm_expr_struct(object, bindings, table), field, table)
                        return "" if row == RBM_NONE
                        return rbm_type_spelling(table.private_field_types[row.usize()]).elem
                    Expr.Paren(inner, paren_pos):
                        return rbm_expr_struct(inner, bindings, table)
                    _:
                        pass
                return ""


        # stage0 mutationPathWritable: a store through `path` is allowed unless the path runs
        # through a readonly reference. A reference-typed FIELD decides for itself (its
        # `mutable`), whatever holds it; any other step defers to the object it is part of.
        def rbm_path_writable(expression: Ast::Expr, bindings: RefBindingScope&, table: SymbolTable&) -> bool:
            can Abort.Panic:
                match expression:
                    Expr.Ident(name, ident_pos):
                        mode: u32 = rbm_lookup(bindings, name, table).mode
                        return mode != RBM_MODE_R and mode != RBM_MODE_RB and mode != RBM_MODE_RL
                    Expr.Field(object, field, field_pos):
                        is_type_application_field: bool = when field:
                            "cast" | "call_as" -> true
                            _ -> false
                        return true if is_type_application_field
                        row: u32 = rbm_field_row(bindings, rbm_expr_struct(object, bindings, table), field, table)
                        if row != RBM_NONE:
                            return rbm_field_mutable(row, table) if type_contains_ref(table.private_field_types[row.usize()])
                        return rbm_path_writable(object, bindings, table)
                    Expr.Index(object, index, index_pos):
                        return rbm_path_writable(object, bindings, table)
                    Expr.IndexN(object, arguments, index_pos):
                        return rbm_path_writable(object, bindings, table)
                    Expr.Slice(object, low, high, slice_pos):
                        return rbm_path_writable(object, bindings, table)
                    Expr.Paren(inner, paren_pos):
                        return rbm_path_writable(inner, bindings, table)
                    _:
                        pass
                return true


        # Whether a legacy `x: mutable T& = init` local may write through (stage0 narrows the
        # binding to its initializer's capability). Unknown answers yes: only an initializer
        # this pass can see is readonly demotes the local.
        def rbm_init_writable(expression: Ast::Expr, bindings: RefBindingScope&, callee_names: darray[sview]&, callee_owners: darray[sview]&, positions: darray[u32]&, lookup: ReadonlyFunctionIndex&, table: SymbolTable&) -> bool:
            can Abort.Panic:
                match expression:
                    Expr.Ident(name, ident_pos):
                        is_zero_initializer: bool = when name:
                            "null" | "zeroed" -> true
                            _ -> false
                        return true if is_zero_initializer
                        mode: u32 = rbm_lookup(bindings, name, table).mode
                        return mode != RBM_MODE_R and mode != RBM_MODE_RB and mode != RBM_MODE_RL
                    Expr.If(condition, then_expr, else_expr, if_pos):
                        return false if not rbm_init_writable(then_expr, bindings, callee_names, callee_owners, positions, lookup, table)
                        return rbm_init_writable(else_expr, bindings, callee_names, callee_owners, positions, lookup, table)
                    Expr.Unary(operator, operand, unary_pos):
                        return true if operator != TokenKind.Ampersand
                        match operand:
                            Expr.Ident(borrowed, borrowed_pos):
                                return rbm_lookup(bindings, borrowed, table).mode != RBM_MODE_VALUE
                            Expr.Index(element_object, element_index, element_pos):
                                return rbm_path_writable(element_object, bindings, table)
                            Expr.Field(field_object, field, field_pos):
                                row: u32 = rbm_field_row(bindings, rbm_expr_struct(field_object, bindings, table), field, table)
                                return true if row == RBM_NONE
                                return false if not rbm_field_mutable(row, table)
                                return rbm_path_writable(field_object, bindings, table)
                            _:
                                pass
                    Expr.StringLit(text, literal_pos):
                        return false
                    Expr.Call(callee, arguments, argument_names, call_pos):
                        returned: RefSpelling = rbm_return_row(callee, bindings, callee_names, callee_owners, positions, lookup, table)
                        return true if (returned.flags & RBM_REF) == 0
                        return (returned.flags & RBM_MUTABLE) != 0
                    Expr.Index(object, index, index_pos):
                        if object is Ast::Expr.Field(cast_source, cast_field, _):
                            if cast_field == "cast":
                                target_type: RefSpelling = rbm_type_spelling(index)
                                return true if (target_type.flags & RBM_MUTABLE) != 0 or target_type.elem == ""
                                source_type: RefSpelling = rbm_spell_value(cast_source, bindings, callee_names, callee_owners, positions, lookup, table)
                                return true if (source_type.flags & RBM_PRESENT) == 0 or source_type.elem != target_type.elem
                                return rbm_init_writable(cast_source, bindings, callee_names, callee_owners, positions, lookup, table)
                    Expr.Field(object, field, field_pos):
                        row: u32 = rbm_field_row(bindings, rbm_expr_struct(object, bindings, table), field, table)
                        return true if:
                            row == RBM_NONE
                            not type_contains_ref(table.private_field_types[row.usize()])
                        return rbm_field_mutable(row, table)
                    Expr.Paren(inner, paren_pos):
                        return rbm_init_writable(inner, bindings, callee_names, callee_owners, positions, lookup, table)
                    _:
                        pass
                return true


        def rbm_kind_storage(kind: u32) -> u32:
            return RBM_STATIC if kind == RBM_KIND_GLOBAL
            return RBM_STACK if kind == RBM_KIND_LOCAL or kind == RBM_KIND_PARAM
            return 0


        # A non-reference optional (`i64?`) is not spelled: the printer has no `?` for a value,
        # and a value-to-optional rule is not modeled.
        def rbm_value_or_decline(spelling: RefSpelling) -> RefSpelling:
            return rbm_decline() if (spelling.flags & RBM_REF) == 0 and (spelling.flags & RBM_NULLABLE) != 0 else spelling


        # The storage of `&path` when every step of PATH is a value: a value binding and
        # value-typed fields. RBM_NONE when a reference is on the path.
        def rbm_value_root_storage(expression: Ast::Expr, bindings: RefBindingScope&, table: SymbolTable&) -> u32:
            can Abort.Panic:
                match expression:
                    Expr.Ident(name, ident_pos):
                        binding: RefBinding = rbm_lookup(bindings, name, table)
                        return RBM_NONE if binding.mode != RBM_MODE_VALUE and binding.mode != RBM_MODE_VALUE_MUTABLE
                        return rbm_kind_storage(binding.kind)
                    Expr.Field(object, field, field_pos):
                        row: u32 = rbm_field_row(bindings, rbm_expr_struct(object, bindings, table), field, table)
                        return RBM_NONE if:
                            row == RBM_NONE
                            type_contains_ref(table.private_field_types[row.usize()])
                        return rbm_value_root_storage(object, bindings, table)
                    Expr.Paren(inner, paren_pos):
                        return rbm_value_root_storage(inner, bindings, table)
                    _:
                        pass
                return RBM_NONE


        # `&operand`: a borrow of a value binding or of a value field reached through values.
        def rbm_spell_borrow(operand: Ast::Expr, bindings: RefBindingScope&, table: SymbolTable&) -> RefSpelling:
            can Abort.Panic:
                match operand:
                    Expr.Ident(name, ident_pos):
                        binding: RefBinding = rbm_lookup(bindings, name, table)
                        return rbm_decline() if:
                            binding.elem == ""
                            binding.mode != RBM_MODE_VALUE and binding.mode != RBM_MODE_VALUE_MUTABLE
                        flags: mutable u32 = RBM_PRESENT | RBM_REF | rbm_kind_storage(binding.kind)
                        flags <- flags | RBM_MUTABLE if binding.mode == RBM_MODE_VALUE_MUTABLE
                        return RefSpelling{elem: binding.elem, flags: flags}
                    Expr.Field(object, field, field_pos):
                        row: u32 = rbm_field_row(bindings, rbm_expr_struct(object, bindings, table), field, table)
                        return rbm_decline() if row == RBM_NONE
                        field_type: RefSpelling = rbm_type_spelling(table.private_field_types[row.usize()])
                        return rbm_decline() if (field_type.flags & RBM_REF) != 0 or (field_type.flags & RBM_NULLABLE) != 0 or field_type.elem == ""
                        storage: u32 = rbm_value_root_storage(object, bindings, table)
                        return rbm_decline() if storage == RBM_NONE
                        flags: mutable u32 = RBM_PRESENT | RBM_REF | storage
                        flags <- flags | RBM_MUTABLE if rbm_field_mutable(row, table) and rbm_path_writable(object, bindings, table)
                        return RefSpelling{elem: field_type.elem, flags: flags}
                    _:
                        pass
                return rbm_decline()


        def rbm_is_comparison(operator: TokenKind) -> bool:
            can Abort.Panic:
                return when operator:
                    TokenKind.EqEq | TokenKind.BangEq | TokenKind.Lt | TokenKind.Gt | TokenKind.LtEq | TokenKind.GtEq | TokenKind.Is | TokenKind.And | TokenKind.Or -> true
                    _ -> false


        def rbm_is_arithmetic(operator: TokenKind) -> bool:
            can Abort.Panic:
                return when operator:
                    TokenKind.Plus | TokenKind.Minus | TokenKind.Star | TokenKind.Slash | TokenKind.Percent | TokenKind.Pipe | TokenKind.Caret | TokenKind.LShift | TokenKind.RShift | TokenKind.Ampersand -> true
                    _ -> false
