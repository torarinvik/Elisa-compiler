extend Semantic:
    # Stage1 struct declaration layout checks (stage0 port docs/119).
    #
    # Validate struct field types and structural properties at declaration time:
    # 1. Unknown field type: a field's declared type names a type that is not registered
    #    (not a primitive, not a known struct/enum).
    # 2. Directly self-recursive struct: a struct references itself directly without
    #    indirection (e.g. `struct S: x: S` — infinite size). Mutual recursion via refs
    #    is sound (ref is a pointer) and beyond this check.

    private:
        # Whether `name` is a recognized primitive type or special form.
        def is_primitive_type(name: sview) -> bool:
            can Abort.Panic:
                if name == "i8" or name == "i16" or name == "i32" or name == "i64":
                    return true
                if name == "int" or name == "isize":
                    return true
                if name == "u8" or name == "u16" or name == "u32" or name == "u64":
                    return true
                if name == "usize" or name == "uintptr":
                    return true
                if name == "f32" or name == "f64":
                    return true
                if name == "bool" or name == "char" or name == "void":
                    return true
                if name == "cstr" or name == "dstr" or name == "sview":
                    return true
                # Special syntax forms (bitset/bitfield are pseudo-types used in struct definitions).
                if name == "bitset" or name == "bitfield":
                    return true
                return false


        # Whether `name` is a registered struct or enum in the table.
        def is_registered_type(name: sview, table: SymbolTable&) -> bool:
            can Abort.Panic:
                for s in table.symbols:
                    if s.name == name:
                        is_type: bool = s.kind == SymbolKind.Struct or s.kind == SymbolKind.Enum
                        if is_type:
                            return true
                return false


        # Resolve a bare TYPE name. Returns true if the name is DEFINITELY unresolved
        # (not a primitive, not registered). Conservative: empty name, single-letter names
        # (generics), and capitalized names (may be defined elsewhere) are never flagged.
        def is_unresolved_type(name: sview, table: SymbolTable&) -> bool:
            can Abort.Panic:
                if name == "":
                    return false
                # Single-letter identifiers are generic type parameters (T, U, K, V, etc.).
                if name.len == 1:
                    return false
                # If it starts with uppercase, it might be defined elsewhere (cross-module type).
                # Only flag truly-unresolved lowercase names (likely typos).
                if name.len > 0:
                    first_char: u8 = name[0]
                    if first_char >= 65 and first_char <= 90:
                        return false
                if is_primitive_type(name):
                    return false
                if is_registered_type(name, table):
                    return false
                return true


        # Validate a single struct's field types and self-recursion.
        def check_struct_layout(name: sview, members: darray[Ast::StructMember]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for m in members:
                    if m.name == "":
                        continue
                    tname: sview = bare_type_name(m.type_expr)
                    if is_unresolved_type(tname, table):
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UnknownFieldType, name: m.name, line: 0, expected: name, actual: tname})
                    elif tname == name:
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.RecursiveStruct, name: name, line: 0, expected: m.name, actual: ""})


        # Recursively walk a declaration list (top-level or module bodies).
        def validate_struct_layouts_range(decls: darray[Ast::Decl]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for decl in decls:
                    match decl:
                        Ast::Decl.Struct(sname, members, affinity, line):
                            table <- check_struct_layout(sname, members, table)
                        Ast::Decl.Module(mname, body, mline):
                            table <- validate_struct_layouts_range(body, table)
                        Ast::Decl.Scoped(body, sline):
                            table <- validate_struct_layouts_range(body, table)
                        _:
                            pass

    public:
        # Entry point: validate struct layouts across all declarations. Called during
        # symbol collection, after structs are registered but before functions are analyzed.
        def validate_struct_layouts(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- validate_struct_layouts_range(file.top_decls, table)
