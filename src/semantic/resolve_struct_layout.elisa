extend Semantic:
    # Stage1 struct declaration layout checks (stage0 port docs/119).
    #
    # Validate struct field types and structural properties at declaration time:
    # 1. Unknown field type: a field's declared type names a type that is not registered
    #    (not a primitive, not a known struct/enum).
    # 2. Directly self-recursive struct: a struct references itself directly without
    #    indirection (e.g. `struct S: x: S` — infinite size). Mutual recursion via refs
    #    is sound (ref is a pointer) and beyond this check.

    private:
        # Whether `name` is a recognized primitive type or special form.
        def is_primitive_type(name: sview) -> bool:
            can Abort.Panic:
                if name == "i8" or name == "i16" or name == "i32" or name == "i64":
                    return true
                if name == "int" or name == "isize":
                    return true
                if name == "u8" or name == "u16" or name == "u32" or name == "u64":
                    return true
                if name == "usize" or name == "uintptr":
                    return true
                if name == "f32" or name == "f64":
                    return true
                if name == "bool" or name == "char" or name == "void":
                    return true
                if name == "cstr" or name == "dstr" or name == "sview":
                    return true
                # Special syntax forms (bitset/bitfield are pseudo-types used in struct definitions).
                if name == "bitset" or name == "bitfield":
                    return true
                return false


        # Whether `name` is a registered struct or enum in the table.
        def is_registered_type(name: sview, table: SymbolTable&) -> bool:
            can Abort.Panic:
                for symbol in table.symbols:
                    if symbol.name == name:
                        is_type: bool = symbol.kind == SymbolKind.Struct or symbol.kind == SymbolKind.Enum
                        if is_type:
                            return true
                return false


        # Resolve a bare TYPE name. Returns true if the name is DEFINITELY unresolved
        # (not a primitive, not registered). Conservative: empty name, single-letter names
        # (generics), and capitalized names (may be defined elsewhere) are never flagged.
        def is_unresolved_type(name: sview, table: SymbolTable&) -> bool:
            can Abort.Panic:
                if name == "":
                    return false
                # Single-letter identifiers are generic type parameters (T, U, K, V, etc.).
                if name.len == 1:
                    return false
                # If it starts with uppercase, it might be defined elsewhere (cross-module type).
                # Only flag truly-unresolved lowercase names (likely typos).
                if name.len > 0:
                    first_char: u8 = name[0]
                    if first_char >= 65 and first_char <= 90:
                        return false
                if is_primitive_type(name):
                    return false
                if is_registered_type(name, table):
                    return false
                return true


        # Source line for a field type expression, used to place layout diagnostics on
        # the declaration that actually names the bad type.
        def expr_line(expression: Ast::Expr) -> u32:
            can Abort.Panic:
                return match expression:
                    Expr.Invalid:                 0
                    Expr.IntLit(value):           0
                    Expr.FloatLit(text):          0
                    Expr.StringLit(text):         0
                    Expr.CharLit(text):           0
                    Expr.BoolLit(value):          0
                    Expr.Ident(name, line):       line
                    Expr.Call(callee, arguments, argument_names, line): line
                    Expr.Field(receiver, field, line): line
                    Expr.Scope(base, name, line): line
                    Expr.Index(object, index, line): line
                    Expr.Binary(left, operator, right, line): line
                    Expr.Unary(operator, operand, line): line
                    Expr.Paren(inner, line):      line
                    Expr.Array(elements, line):    line
                    Expr.Tuple(elements, line):    line
                    Expr.SetLit(elements, line):   line
                    Expr.DictLit(entries, line):   line
                    Expr.Construct(type, fields, line): line
                    Expr.RecordUpdate(base, fields, line): line
                    Expr.If(condition, then_expression, else_expression, line): line
                    Expr.Match(scrutinee, arms, line): line
                    Expr.Comprehension(variable, iterable, condition, body, line): line
                    Expr.Lambda(parameters, body, line): line
                    Expr.ShorthandMember(parts, line): line
                    Expr.IndexN(object, arguments, line): line
                    Expr.Slice(object, low, high, line): line
                    Expr.Block(stmts, value, captures, line): line


        # Validate a single struct's field types and self-recursion.
        def check_struct_layout(name: sview, members: darray[Ast::StructMember]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for member in members |table| -> table:
                    if member.name == "":
                        continue
                    type_name: sview = bare_type_name(member.type_expression)
                    type_line: u32 = expr_line(member.type_expression)
                    if is_unresolved_type(type_name, table):
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UnknownFieldType, name: member.name, line: type_line, expected: name, actual: type_name})
                        table
                    elif type_name == name:
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.RecursiveStruct, name: name, line: type_line, expected: member.name, actual: ""})
                        table
                    else:
                        table


        # Recursively walk a declaration list (top-level or module bodies).
        def validate_struct_layouts_range(declarations: darray[Ast::Decl]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Ast::Decl.Struct(struct_name, members, affinity, line):
                            table <- check_struct_layout(struct_name, members, table)
                            table
                        Ast::Decl.Module(module_name, body, module_line):
                            table <- validate_struct_layouts_range(body, table)
                            table
                        Ast::Decl.Scoped(body, scoped_line):
                            table <- validate_struct_layouts_range(body, table)
                            table
                        _:
                            table

    public:
        # Entry point: validate struct layouts across all declarations. Called during
        # symbol collection, after structs are registered but before functions are analyzed.
        def validate_struct_layouts(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- validate_struct_layouts_range(file.top_decls, table)
