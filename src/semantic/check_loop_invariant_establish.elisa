# Loop-invariant ESTABLISHMENT (the decidable subset of stage0's analyzer_loop_invariants).
# stage0 warns "loop invariant could not be established on entry" when it cannot prove the
# invariant from the pre-loop facts. Sound decidable subset ported here: a SINGLE-comparison
# invariant (`i >= 5`, `i + 1 <= i`) over loop variables pinned to a CONSTANT entry value
# (`i: usize = 0` -> i in [0,0]) — evaluate the comparison against those exact entry intervals
# and warn only when it is provably NOT establishable. Any free operand (a value with no
# tracked entry interval) or a non-comparison invariant DECLINES (no warn), so a value stage0
# could prove some other way is never flagged. Entry values are exact points, so this can only
# fire on a genuinely non-establishable invariant.
extend Semantic:
    private:
        # Whether `LHS OP RHS` is PROVABLE from the operand intervals (all LHS values relate to
        # all RHS values under OP).
        def loop_comparison_provable(operator: TokenKind, li_lo: i64, li_hi: i64, ri_lo: i64, ri_hi: i64) -> bool:
            can Abort.Panic:
                true return if operator == TokenKind.GtEq and li_lo >= ri_hi
                true return if operator == TokenKind.Gt and li_lo > ri_hi
                true return if operator == TokenKind.LtEq and li_hi <= ri_lo
                true return if operator == TokenKind.Lt and li_hi < ri_lo
                true return if operator == TokenKind.EqEq and li_lo == li_hi and ri_lo == ri_hi and li_lo == ri_lo
                true return if operator == TokenKind.BangEq and (li_hi < ri_lo or li_lo > ri_hi)
                return false

        def loop_operator_is_comparison(operator: TokenKind) -> bool:
            can Abort.Panic:
                return operator == TokenKind.GtEq or operator == TokenKind.Gt or operator == TokenKind.LtEq or operator == TokenKind.Lt or operator == TokenKind.EqEq or operator == TokenKind.BangEq

        # Evaluate one loop invariant against the entry intervals. Emit when it is a single
        # comparison with both operands computable AND not provable; decline otherwise.
        def check_loop_invariant_predicate(predicate: Ast::Expr, line: u32, names: darray[sview]&, los: darray[i64]&, his: darray[i64]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match predicate:
                    Expr.Binary(left, operator, right, binary_line):
                        return if not loop_operator_is_comparison(operator)
                        li: (found: bool, lo: i64, hi: i64) = argument_interval(left, names, los, his)
                        ri: (found: bool, lo: i64, hi: i64) = argument_interval(right, names, los, his)
                        return if not li.found or not ri.found
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.LoopInvariantNotEstablished, name: "", line: line, expected: "", actual: ""}) if not loop_comparison_provable(operator, li.lo, li.hi, ri.lo, ri.hi)
                    _:
                        pass

        # Drop `name` from the entry-interval map (swap-remove) — its value is no longer a known
        # constant. Keeps the three parallel arrays aligned.
        def loop_forget_name(names: mutable darray[sview]&, los: mutable darray[i64]&, his: mutable darray[i64]&, name: sview) -> void:
            can Abort.Panic:
                index: mutable i64 = -1
                probe: mutable usize = 0
                while probe < names.count |index, probe|:
                    index <- probe.i64() if names[probe] == name
                    probe <- probe + 1
                return if index < 0
                last: usize = names.count - 1
                names[index.usize()] <- names[last]
                los[index.usize()] <- los[last]
                his[index.usize()] <- his[last]
                _ = names.pop()
                _ = los.pop()
                _ = his.pop()

        def loop_invariant_walk_statements(statements: darray[Ast::Stmt], names: mutable darray[sview]&, los: mutable darray[i64]&, his: mutable darray[i64]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |names, los, his, table| -> names, los, his, table:
                    match statement:
                        Stmt.VarDecl(var_name, type_expression, value, line):
                            literal: (found: bool, value: i64) = signed_int_literal(value)
                            loop_forget_name(names, los, his, var_name)
                            if literal.found:
                                names.push(var_name)
                                los.push(literal.value)
                                his.push(literal.value)
                        Stmt.Assign(target, operator, value, line):
                            if target is Expr.Ident(assigned_name, assigned_line):
                                literal_assign: (found: bool, value: i64) = signed_int_literal(value)
                                loop_forget_name(names, los, his, assigned_name)
                                if literal_assign.found and operator == TokenKind.LArrow:
                                    names.push(assigned_name)
                                    los.push(literal_assign.value)
                                    his.push(literal_assign.value)
                        Stmt.While(condition, body, line):
                            for invariant_statement in body |names, los, his, table| -> table:
                                match invariant_statement:
                                    Stmt.Contract(kind, expression, contract_line):
                                        table <- check_loop_invariant_predicate(expression, contract_line, names, los, his, table) if kind == "invariant"
                                    _:
                                        pass
                            table <- loop_invariant_walk_statements(body, names, los, his, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- loop_invariant_walk_statements(then_body, names, los, his, table)
                            table <- loop_invariant_walk_statements(else_body, names, los, his, table)
                        Stmt.Block(kind, clause, binding, block_body, line):
                            table <- loop_invariant_walk_statements(block_body, names, los, his, table)
                        Stmt.For(bind, variables, iterable, for_body, line):
                            table <- loop_invariant_walk_statements(for_body, names, los, his, table)
                        _:
                            pass

        def check_loop_invariant_establish_decls(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            names: mutable darray[sview] = []
                            los: mutable darray[i64] = []
                            his: mutable darray[i64] = []
                            table <- loop_invariant_walk_statements(body, names, los, his, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- check_loop_invariant_establish_decls(module_body, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- check_loop_invariant_establish_decls(scoped_body, table)
                        _:
                            pass

        def check_loop_invariant_establish(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- check_loop_invariant_establish_decls(file.top_decls, table)
