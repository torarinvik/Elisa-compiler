# Stage1 semantic — bit-level argument rules (`extend Semantic: private:`). Decides when
# an index, `reinterpret`, bit-or, or shift argument carries enough width and bound
# evidence to satisfy a refined parameter. Continues
# check_refinement_arg_unproven.elisa; split out to keep each part under 600 lines.

extend Semantic:
    private:
        # Walk a refinement-return function's body: a `return <unconstrained param>` cannot
        # be proven within the return refinement's bounds.
        # A `return xs[i]` whose indexed base is a refinement-free darray parameter: the element value
        # is unknown, so it cannot satisfy a refined return type. (An element-refined darray is NOT
        # refinement-free, so it is correctly excluded.)
        def unproven_index_at(argument: Ast::Expr, refinement_free_params: darray[sview]&, fact_names: darray[sview]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                base_name: sview = match argument:
                    Expr.Index(index_object, index_arg, index_line): ident_name_of(index_object)
                    Expr.IndexN(indexn_object, indexn_args, indexn_line): ident_name_of(indexn_object)
                    _: sview("", 0, 0)
                return base_name != "" and name_in(refinement_free_params, base_name) and not name_in(fact_names, base_name)

        # Bit width of an unsigned integer type name, else 0 (not unsigned).
        def ur_unsigned_width(name: sview) -> i64:
            can Abort.Panic:
                8 return if name == "u8"
                16 return if name == "u16"
                32 return if name == "u32"
                64 return if name == "u64" or name == "usize" or name == "uint" or name == "uintptr"
                return 0

        # Bit width of a signed integer type name, else 0 (not signed).
        def ur_signed_width(name: sview) -> i64:
            can Abort.Panic:
                8 return if name == "i8"
                16 return if name == "i16"
                32 return if name == "i32"
                64 return if name == "i64" or name == "isize" or name == "int" or name == "intptr"
                return 0

        # A `return X.iN()` reinterpret cast whose base X is an UNSIGNED parameter at least as wide as
        # the signed target: the sign bit can be set, so the result is not provably non-negative and
        # cannot satisfy a refined return. (A narrower unsigned source always fits and is excluded.)
        def unproven_reinterpret_at(argument: Ast::Expr, parameters: darray[Ast::ParamDecl]&, fact_names: darray[sview]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                if argument is Expr.Call(callee, arguments, argument_names, call_line):
                    if arguments.count == 0 and callee is Expr.Field(object, method, field_line):
                        target_width: i64 = ur_signed_width(method)
                        if target_width > 0:
                            base_name: sview = ident_name_of(object)
                            if base_name != "" and not name_in(fact_names, base_name):
                                for parameter in parameters:
                                    if parameter.name == base_name:
                                        source_width: i64 = ur_unsigned_width(bare_type_name(parameter.type_expression))
                                        return source_width > 0 and source_width >= target_width
                return false

        # Whether a law predicate constrains `self` with an UPPER bound (`self < K` / `self <= K`).
        def ur_predicate_has_self_upper(predicate: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                match predicate:
                    Expr.Paren(inner, paren_line):
                        return ur_predicate_has_self_upper(inner)
                    Expr.Binary(left, operator, right, binary_line):
                        true return if (operator == TokenKind.Lt or operator == TokenKind.LtEq) and ident_name_of(left) == "self"
                        return ur_predicate_has_self_upper(left) or ur_predicate_has_self_upper(right)
                    _:
                        return false

        # The law name of a `T is Law` / `T is Law[args]` refinement (parametric-aware), else "".
        def ur_refinement_law_name(type_expression: Ast::Expr) -> sview:
            can Memory.Allocate, Abort.Panic:
                if type_expression is Expr.Binary(base, operator, right, binary_line):
                    if operator == TokenKind.Is:
                        return match right:
                            Expr.Ident(name, ident_line): name
                            Expr.Index(index_object, index_arg, index_line): ident_name_of(index_object)
                            Expr.IndexN(indexn_object, indexn_args, indexn_line): ident_name_of(indexn_object)
                            _: sview("", 0, 0)
                return sview("", 0, 0)

        # Whether a refined type's law imposes an upper bound on the value.
        def ur_return_upper_bounded(type_expression: Ast::Expr, law_names: darray[sview]&, law_predicates: darray[Ast::Expr]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                law_name: sview = ur_refinement_law_name(type_expression)
                false return if law_name == ""
                return ur_predicate_has_self_upper(law_predicate_by_name(law_name, law_names, law_predicates))

        # The literal upper-bound argument K of a `T is Law[K]` refinement, else 0. (Used to bound-check
        # shift returns; 0 means "no literal bound", disabling the numeric shift discriminator.)
        def ur_refinement_upper_const(type_expression: Ast::Expr) -> u64:
            can Memory.Allocate, Abort.Panic:
                if type_expression is Expr.Binary(base, operator, right, binary_line):
                    if operator == TokenKind.Is:
                        return match right:
                            Expr.Index(index_object, index_arg, index_line): ur_intlit_u64(index_arg)
                            Expr.IndexN(indexn_object, indexn_args, indexn_line): ur_intlit_u64(indexn_args[0]) if indexn_args.count > 0 else 0
                            _: 0
                return 0

        # The u64 magnitude of an integer-literal expression, else 0.
        def ur_intlit_u64(expression: Ast::Expr) -> u64:
            can Abort.Panic:
                return match expression:
                    Expr.IntLit(literal_value): literal_value.u64()
                    _: 0

        # A `return X | literal` bitwise-OR whose base X is an unconstrained parameter: the OR sets
        # bits but does not upper-bound the result (X's high bits survive), so it cannot satisfy an
        # upper-bounded refined return.
        def unproven_bitor_at(argument: Ast::Expr, parameters: darray[Ast::ParamDecl]&, fact_names: darray[sview]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                if argument is Expr.Binary(left, operator, right, binary_line):
                    if operator == TokenKind.Pipe:
                        base_name: sview = ident_name_of(left)
                        any parameter in parameters where parameter.name == base_name return if base_name != "" and not name_in(fact_names, base_name)
                return false

        # The root operand of a right-shift chain `((X >> a) >> b) ...`, peeling `>>` nodes; else "".
        def us_shift_root_name(argument: Ast::Expr) -> sview:
            can Memory.Allocate, Abort.Panic:
                match argument:
                    Expr.Paren(inner, paren_line):
                        return us_shift_root_name(inner)
                    Expr.Binary(left, operator, right, binary_line):
                        return us_shift_root_name(left) if operator == TokenKind.RShift else sview("", 0, 0)
                    Expr.Ident(name, ident_line):
                        return name
                    _:
                        return sview("", 0, 0)

        # Sum of the CONSTANT right-shift amounts along the chain (a variable shift contributes 0,
        # the worst case where it shifts nothing).
        def us_const_shift_total(argument: Ast::Expr) -> i64:
            can Memory.Allocate, Abort.Panic:
                match argument:
                    Expr.Paren(inner, paren_line):
                        return us_const_shift_total(inner)
                    Expr.Binary(left, operator, right, binary_line):
                        if operator == TokenKind.RShift:
                            amount: i64 = match right:
                                Expr.IntLit(literal_value): literal_value
                                _: 0
                            return amount + us_const_shift_total(left)
                        return 0
                    _:
                        return 0

        # The unsigned bit width of the parameter named `root`, else 0.
        def us_param_unsigned_width(root: sview, parameters: darray[Ast::ParamDecl]&) -> i64:
            can Memory.Allocate, Abort.Panic:
                for parameter in parameters:
                    ur_unsigned_width(ident_name_of(parameter.type_expression)) return if parameter.name == root
                return 0

        # A `return (X >> ...) >> ...` right-shift chain rooted at an unconstrained unsigned parameter,
        # whose WORST-CASE result (all bits set, reduced only by the constant shift amounts) can still
        # reach or exceed the refinement's upper bound K: the refined return is unproven. A shift that
        # provably clears every significant bit (total >= width) yields 0 and is excluded.
        def unproven_shift_at(argument: Ast::Expr, parameters: darray[Ast::ParamDecl]&, fact_names: darray[sview]&, upper_const: u64) -> bool:
            can Memory.Allocate, Abort.Panic:
                is_shift: bool = match argument:
                    Expr.Binary(left, operator, right, binary_line): operator == TokenKind.RShift
                    _: false
                false return if not is_shift
                root: sview = us_shift_root_name(argument)
                false return if root == "" or name_in(fact_names, root)
                width: i64 = us_param_unsigned_width(root, parameters)
                false return if width == 0
                total: i64 = us_const_shift_total(argument)
                false return if total >= width
                mask: u64 = 18446744073709551615 if width >= 64 else (1.u64() << width.u64()) - 1
                worst: u64 = mask >> total.u64()
                return worst >= upper_const

        def unproven_return_check(statements: darray[Ast::Stmt], refinement_free_params: darray[sview]&, fact_names: darray[sview]&, parameters: darray[Ast::ParamDecl]&, return_upper_bounded: bool, return_upper_const: u64, plain_param_names: darray[sview]&, return_builtin_unsatisfied: bool, function_name: sview, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Return(value, line):
                            if value is returned:
                                builtin_unproven: bool = return_builtin_unsatisfied and (name_in(plain_param_names, ident_name_of(returned)) or uns_arith_unproven(returned, plain_param_names, fact_names))
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.RefinementReturnNotProven, name: function_name, line: line, expected: "", actual: ""}) if unproven_arg_at(returned, refinement_free_params, fact_names) or unproven_index_at(returned, refinement_free_params, fact_names) or unproven_reinterpret_at(returned, parameters, fact_names) or (return_upper_bounded and unproven_bitor_at(returned, parameters, fact_names)) or (return_upper_const > 0 and unproven_shift_at(returned, parameters, fact_names, return_upper_const)) or builtin_unproven
                        Stmt.If(condition, then_body, else_body, line):
                            table <- unproven_return_check(then_body, refinement_free_params, fact_names, parameters, return_upper_bounded, return_upper_const, plain_param_names, return_builtin_unsatisfied, function_name, table)
                            table <- unproven_return_check(else_body, refinement_free_params, fact_names, parameters, return_upper_bounded, return_upper_const, plain_param_names, return_builtin_unsatisfied, function_name, table)
                        Stmt.While(condition, while_body, line):
                            table <- unproven_return_check(while_body, refinement_free_params, fact_names, parameters, return_upper_bounded, return_upper_const, plain_param_names, return_builtin_unsatisfied, function_name, table)
                        Stmt.Block(kind, clause, binding, block_body, line):
                            table <- unproven_return_check(block_body, refinement_free_params, fact_names, parameters, return_upper_bounded, return_upper_const, plain_param_names, return_builtin_unsatisfied, function_name, table)
                        Stmt.For(bind, variables, iterable, for_body, line):
                            table <- unproven_return_check(for_body, refinement_free_params, fact_names, parameters, return_upper_bounded, return_upper_const, plain_param_names, return_builtin_unsatisfied, function_name, table)
                        _:
                            pass

        def unproven_arg_check_statements(statements: darray[Ast::Stmt], line_context: u32, param_functions: darray[sview]&, param_indices: darray[usize]&, refinement_free_params: darray[sview]&, fact_names: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Return(value, line):
                            if value is returned:
                                table <- unproven_arg_check_expression(returned, line, param_functions, param_indices, refinement_free_params, fact_names, table)
                        Stmt.Expr(expression, line):
                            table <- unproven_arg_check_expression(expression, line, param_functions, param_indices, refinement_free_params, fact_names, table)
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- unproven_arg_check_expression(value, line, param_functions, param_indices, refinement_free_params, fact_names, table)
                        Stmt.Assign(target, operator, value, line):
                            table <- unproven_arg_check_expression(value, line, param_functions, param_indices, refinement_free_params, fact_names, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- unproven_arg_check_statements(then_body, line, param_functions, param_indices, refinement_free_params, fact_names, table)
                            table <- unproven_arg_check_statements(else_body, line, param_functions, param_indices, refinement_free_params, fact_names, table)
                        Stmt.While(condition, while_body, line):
                            table <- unproven_arg_check_statements(while_body, line, param_functions, param_indices, refinement_free_params, fact_names, table)
                        Stmt.Block(kind, clause, binding, block_body, line):
                            table <- unproven_arg_check_statements(block_body, line, param_functions, param_indices, refinement_free_params, fact_names, table)
                        Stmt.For(bind, variables, iterable, for_body, line):
                            table <- unproven_arg_check_statements(for_body, line, param_functions, param_indices, refinement_free_params, fact_names, table)
                        _:
                            pass
