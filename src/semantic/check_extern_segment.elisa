# Extern segment-transition requirement (stage0 validateExternSegmentTransitionAnnotation). An
# extern whose `can[...]` establishes a segment owner — it grants BOTH Unsafe.SegmentMutation AND
# one of Segment.Guest / Segment.Host — must carry an explicit @segment_transition(host|guest) so
# the resulting owner is a typed contract rather than inferred from permissions.
#
# The parser records the "grants a segment owner" fact on the side-table (owner=extern name,
# sentinel "__extern_segment_owner"); this check flags such an extern that lacks a
# @segment_transition decorator.
extend Semantic:
    private:
        def extern_has_segment_owner(enum_annotations: darray[Ast::EnumAnnotation]&, name: sview) -> bool:
            can Abort.Panic:
                return any annotation in enum_annotations where annotation.name == "__extern_segment_owner" and annotation.owner == name

        def check_extern_segment_walk(declarations: darray[Ast::Decl], enum_annotations: darray[Ast::EnumAnnotation]&, annotation_args: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Extern(name, param_start, arity, variadic, has_params, return_type, decorators, line):
                            has_transition: bool = any decorator in decorators where decorator.name == "segment_transition"
                            needs_transition: bool = extern_has_segment_owner(enum_annotations, name) and not has_transition
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ExternSegmentTransition, name: name, line: line.line, expected: "", actual: ""}) if needs_transition
                            # A present @segment_transition(target) must name `host` or `guest`.
                            for decorator in decorators |table| -> table:
                                if decorator.name == "segment_transition" and decorator.arg_count == 1 and decorator.arg_start.usize() < annotation_args.count:
                                    target: sview = annotation_args[decorator.arg_start.usize()]
                                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.SegmentTransitionBadTarget, name: name, line: line.line, expected: "", actual: target}) if target != "host" and target != "guest"
                        Decl.Module(module_name, module_body, module_line):
                            table <- check_extern_segment_walk(module_body, enum_annotations, annotation_args, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- check_extern_segment_walk(scoped_body, enum_annotations, annotation_args, table)
                        _:
                            pass

        def check_extern_segment(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- check_extern_segment_walk(file.top_decls, file.enum_annotations, file.annotation_args, table)
