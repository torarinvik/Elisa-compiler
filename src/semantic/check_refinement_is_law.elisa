# Refinement predicate must be a law. A refinement binder `T is PRED` (param type, return type,
# struct field) whose PRED does not name a declared law (or refine/type alias) is rejected
# ("refinement predicate PRED is not a law"). Ports stage0's lookupLaw check for the binder
# positions.
#
# The valid-predicate set = in-file laws (Decl.Law) ∪ aliases (Decl.Alias — both `type` and
# `refine`) ∪ a whitelist of common stdlib refinement laws (which may be referenced without an
# in-file declaration). The whitelist only makes the set MORE permissive, so it can never cause a
# false positive; it guards against over-firing on a stdlib law used by name. SOUND subset: fires
# only when PRED is provably none of these.
extend Semantic:
    private:
        # The bare predicate name of a refinement application: `is Foo` / `is Foo[a]` / `is Foo[a,b]`.
        def refinement_predicate_name(application: Ast::Expr) -> sview:
            can Abort.Panic:
                match application:
                    Expr.Ident(name, line):
                        return name
                    Expr.Index(object, index, line):
                        return ident_name_of(object)
                    Expr.IndexN(object, arguments, line):
                        return ident_name_of(object)
                    Expr.Paren(inner, line):
                        return refinement_predicate_name(inner)
                    _:
                        return sview("", 0, 0)

        # A common stdlib refinement law (may be used by name without an in-file declaration).
        def is_stdlib_refinement_law(name: sview) -> bool:
            can Abort.Panic:
                return name == "Nat" or name == "Positive" or name == "StrictlyPositive" or name == "NonNeg" or name == "Negative" or name == "NonPositive" or name == "Bounded" or name == "InRange" or name == "Even" or name == "Odd" or name == "NonZero" or name == "UpperBound" or name == "LowerBound" or name == "AtMost" or name == "AtLeast" or name == "Finite" or name == "Sorted" or name == "Unique" or name == "NonEmpty"

        def refinement_name_is_known(name: sview, law_names: darray[sview]&, alias_names: darray[sview]&) -> bool:
            can Abort.Panic:
                return (any law_name in law_names where law_name == name) or (any alias_name in alias_names where alias_name == name) or is_stdlib_refinement_law(name)

        # Report a refinement type-expression `T is PRED` when PRED is not a known law.
        def report_refinement_predicate(type_expression: Ast::Expr, law_names: darray[sview]&, alias_names: darray[sview]&, line: u32, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match type_expression:
                    Expr.Binary(base, operator, right, binary_line):
                        return if operator != TokenKind.Is
                        predicate_name: sview = refinement_predicate_name(right)
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.RefinementNotALaw, name: predicate_name, line: line, expected: "", actual: ""}) if predicate_name != "" and not refinement_name_is_known(predicate_name, law_names, alias_names)
                    Expr.Unary(operator, operand, unary_line):
                        table <- report_refinement_predicate(operand, law_names, alias_names, line, table)
                    Expr.Paren(inner, paren_line):
                        table <- report_refinement_predicate(inner, law_names, alias_names, line, table)
                    _:
                        pass

        def collect_alias_names(declarations: darray[Ast::Decl], out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |out|:
                    match declaration:
                        Decl.Alias(name, value, line):
                            out.push(name)
                        Decl.Module(module_name, module_body, module_line):
                            collect_alias_names(module_body, out)
                        Decl.Scoped(scoped_body, scoped_line):
                            collect_alias_names(scoped_body, out)
                        _:
                            pass

        def check_refinement_is_law_walk(declarations: darray[Ast::Decl], law_names: darray[sview]&, alias_names: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            for parameter in parameters |table| -> table:
                                table <- report_refinement_predicate(parameter.type_expression, law_names, alias_names, line, table)
                            if return_type is return_type_expression:
                                table <- report_refinement_predicate(return_type_expression, law_names, alias_names, line, table)
                            table <- refinement_body_walk(body, law_names, alias_names, table)
                        Decl.Struct(struct_name, members, affinity, has_named_states, has_derive, invariants, line):
                            for member in members |table| -> table:
                                table <- report_refinement_predicate(member.type_expression, law_names, alias_names, line, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- check_refinement_is_law_walk(module_body, law_names, alias_names, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- check_refinement_is_law_walk(scoped_body, law_names, alias_names, table)
                        _:
                            pass

        # Local `x: T is PRED = v` declarations — the refinement predicate must also be a law.
        def refinement_body_walk(statements: darray[Ast::Stmt], law_names: darray[sview]&, alias_names: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- report_refinement_predicate(type_expression, law_names, alias_names, line, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- refinement_body_walk(then_body, law_names, alias_names, table)
                            table <- refinement_body_walk(else_body, law_names, alias_names, table)
                        Stmt.While(condition, while_body, line):
                            table <- refinement_body_walk(while_body, law_names, alias_names, table)
                        Stmt.For(bind, variables, iterable, for_body, line):
                            table <- refinement_body_walk(for_body, law_names, alias_names, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- refinement_body_walk(body, law_names, alias_names, table)
                        _:
                            pass

        # `ensures EXPR is PRED` signature contracts: the predicate must also be a law. These live
        # on the File side-channel (parallel kinds/exprs/lines), never lowered into the body.
        def check_ensures_refinement(file: Ast::File&, law_names: darray[sview]&, alias_names: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                while index < file.signature_contract_exprs.count |table, index: usize = 0| -> table:
                    kind: sview = file.signature_contract_kinds[index]
                    is_ensures: bool = kind == "ensure" or kind == "ensures"
                    if is_ensures and file.signature_contract_exprs[index] is Expr.Binary(base, operator, right, binary_line):
                        if operator == TokenKind.Is:
                            predicate_name: sview = refinement_predicate_name(right)
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.RefinementNotALaw, name: predicate_name, line: file.signature_contract_lines[index], expected: "ensures", actual: ""}) if predicate_name != "" and not refinement_name_is_known(predicate_name, law_names, alias_names)
                    index <- index + 1

        def check_refinement_is_law(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                law_names: mutable darray[sview] = []
                law_predicates: mutable darray[Ast::Expr] = []
                collect_laws(file.top_decls, law_names, law_predicates)
                alias_names: mutable darray[sview] = []
                collect_alias_names(file.top_decls, alias_names)
                table <- check_refinement_is_law_walk(file.top_decls, law_names, alias_names, table)
                table <- check_ensures_refinement(file, law_names, alias_names, table)
