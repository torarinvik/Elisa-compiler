        def destroyed_summary_collect_statements(statements: darray[Ast::Stmt], params: darray[Ast::ParamDecl]&, alias_names: darray[sview]&, alias_params: darray[u32]&, summary_names: darray[sview]&, summary_params: darray[u32]&, summary_formals: darray[sview]&, summary_row_heads: dict[u64, u32]&, summary_row_tails: dict[u64, u32]&, summary_row_next: darray[u32]&, local_function_names: darray[sview]&, opaque_function_names: darray[sview]&, out: mutable darray[u32]&) -> void:
