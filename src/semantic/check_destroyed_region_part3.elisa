extend Semantic:
    private:
        # Name chains keep the owner lookup proportional to same-spelled declarations,
        # while the resolver-maintained bucket limits the reference walk to this function.
        def destroyed_collect_local_reference_names(function_name: sview, function_position: Ast::Pos, table: SymbolTable&, out: mutable darray[sview]&, out_complete: mutable bool&) -> void:
            can Memory.Allocate, Abort.Panic:
                seen: mutable NameSet = empty_name_set()
                indexed: mutable bool = false
                destroyed_local_reference_name_index_reset(out, seen, indexed)
                function_owner: mutable DeclId = DeclId{value: 0}
                owner_found: mutable bool = false
                symbol_chain_valid: mutable bool = true
                symbol_steps: mutable usize = 0
                symbol_row: mutable u32 = symbol_chain_head(table, function_name)
                while symbol_row != SYMBOL_INDEX_ROW_NONE and symbol_chain_valid and symbol_steps < table.symbols.count |symbol_row, function_name, function_position, table, function_owner, owner_found, symbol_chain_valid, symbol_steps|:
                    symbol_index: usize = symbol_row.usize()
                    if symbol_index >= table.symbols.count or symbol_index >= table.symbol_name_next.count:
                        symbol_chain_valid <- false
                    else:
                        symbol: Symbol& = &table.symbols[symbol_index]
                        if symbol.kind == SymbolKind.Func and symbol.name == function_name and symbol.offset == function_position.offset:
                            function_owner <- symbol.id
                            owner_found <- true
                        symbol_row <- table.symbol_name_next[symbol_index]
                    symbol_steps <- symbol_steps + 1
                symbol_chain_valid <- false if symbol_row != SYMBOL_INDEX_ROW_NONE
                if not symbol_chain_valid or not owner_found:
                    function_owner <- function_declaration_id(table, function_name, function_position.offset)
                    owner_found <- function_owner.value != SYMBOL_INDEX_ROW_NONE
                if not owner_found:
                    out_complete <- false
                    return
                owner_index: usize = function_owner.value.usize()
                out_mark: usize = out.count
                if not table.ref_owner_index_valid or owner_index >= table.symbols.count or table.ref_owner_next.count != table.ref_binding_ids.count or table.ref_name.count != table.ref_binding_ids.count:
                    destroyed_fallback_local_reference_names(function_owner, table, out, seen, indexed, out_mark, out_complete)
                    return
                if table.ref_owner_heads.count != table.ref_owner_tails.count or table.ref_owner_heads.count != table.ref_owner_counts.count or table.ref_owner_heads.count != table.ref_owner_observed_counts.count or owner_index >= table.ref_owner_heads.count:
                    destroyed_fallback_local_reference_names(function_owner, table, out, seen, indexed, out_mark, out_complete)
                    return
                reference_index: mutable u32 = table.ref_owner_heads[owner_index]
                expected_count: usize = table.ref_owner_counts[owner_index].usize()
                expected_tail: u32 = table.ref_owner_tails[owner_index]
                if expected_count != table.ref_owner_observed_counts[owner_index]:
                    destroyed_fallback_local_reference_names(function_owner, table, out, seen, indexed, out_mark, out_complete)
                    return
                if expected_count > table.ref_binding_ids.count:
                    destroyed_fallback_local_reference_names(function_owner, table, out, seen, indexed, out_mark, out_complete)
                    return
                if expected_count == 0.usize():
                    if reference_index != SYMBOL_INDEX_ROW_NONE or expected_tail != SYMBOL_INDEX_ROW_NONE:
                        destroyed_fallback_local_reference_names(function_owner, table, out, seen, indexed, out_mark, out_complete)
                    return
                if reference_index == SYMBOL_INDEX_ROW_NONE or expected_tail == SYMBOL_INDEX_ROW_NONE:
                    destroyed_fallback_local_reference_names(function_owner, table, out, seen, indexed, out_mark, out_complete)
                    return
                reference_steps: mutable usize = 0
                previous_reference_index: mutable u32 = SYMBOL_INDEX_ROW_NONE
                last_reference_index: mutable u32 = SYMBOL_INDEX_ROW_NONE
                chain_valid: mutable bool = true
                while reference_index != SYMBOL_INDEX_ROW_NONE and chain_valid |reference_index, table, out, seen, indexed, reference_steps, function_owner, expected_count, previous_reference_index, last_reference_index, chain_valid|:
                    reference_row: usize = reference_index.usize()
                    if reference_row >= table.ref_owner_next.count or reference_steps >= expected_count or (previous_reference_index != SYMBOL_INDEX_ROW_NONE and reference_index >= previous_reference_index):
                        chain_valid <- false
                    else:
                        binding: BindingId = table.ref_binding_ids[reference_row]
                        if binding.owner.value != function_owner.value:
                            chain_valid <- false
                        else:
                            name: sview = table.ref_name[reference_row]
                            destroyed_local_reference_name_add(name, out, seen, indexed)
                            previous_reference_index <- reference_index
                            last_reference_index <- reference_index
                            reference_index <- table.ref_owner_next[reference_row]
                            reference_steps <- reference_steps + 1
                chain_valid <- false if reference_steps != expected_count or last_reference_index != expected_tail
                destroyed_fallback_local_reference_names(function_owner, table, out, seen, indexed, out_mark, out_complete) if not chain_valid

        def destroyed_apply_opaque_external_invalidation(operation: sview, arguments: darray[Ast::Expr], argument_names: darray[sview], external_names: darray[sview]&, external_starts: darray[usize]&, external_arities: darray[u32]&, extern_params: darray[Ast::ExternParam]&, annotations: darray[Ast::LocalRegionAnnotation]&, function_line: u32, use_line: u32, destroyed: mutable darray[u32]&, alias_ids: darray[u32]&, alias_roots: darray[u32]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for signature_index in 0..<external_names.count |operation, arguments, argument_names, external_names, external_starts, external_arities, extern_params, annotations, function_line, use_line, destroyed, alias_ids, alias_roots|:
                    if external_names[signature_index] == operation and signature_index < external_starts.count and signature_index < external_arities.count:
                        for formal_index in 0..<external_arities[signature_index].usize() |formal_index, arguments, argument_names, external_starts, extern_params, annotations, function_line, use_line, destroyed, alias_ids, alias_roots|:
                            param_slot: usize = external_starts[signature_index] + formal_index
                            if param_slot < extern_params.count:
                                external_param: Ast::ExternParam = extern_params[param_slot]
                                if external_param.is_ref and external_param.type_name == "Arena":
                                    argument_index: u32 = destroyed_summary_argument_index(external_param.name, formal_index.u32(), arguments, argument_names)
                                    if argument_index != NO_ARENA_SUMMARY_PARAM and argument_index.usize() < arguments.count:
                                        actual_name: sview = destroyed_arena_owner_source_name(arguments[argument_index.usize()])
                                        binding_id: u32 = region_binding_id_at(annotations, actual_name, function_line, use_line) can Global{Read,Write} if actual_name != "" else NO_REGION_BINDING
                                        if binding_id != NO_REGION_BINDING:
                                            can Global{Read,Write}:
                                                destroyed_mark_region_binding(destroyed, binding_id, alias_ids, alias_roots, annotations, function_line)
                                        else:
                                            destroyed_push_all(destroyed)
                                    else:
                                        destroyed_push_all(destroyed)
                            else:
                                destroyed_push_all(destroyed)


        # If a call target is not a local definition or declared extern, it may be a
        # function-valued local/parameter. Its body is opaque at this call site, so passing
        # a known Arena owner is an invalidation boundary even when the callback name itself
        # is not statically tied to a reset helper.
        def destroyed_apply_unresolved_owner_call(operation: sview, callee: Ast::Expr, arguments: darray[Ast::Expr], summary_names: darray[sview]&, summary_params: darray[u32]&, summary_formals: darray[sview]&, summary_row_heads: dict[u64, u32]&, summary_row_tails: dict[u64, u32]&, summary_row_next: darray[u32]&, local_function_names: darray[sview]&, external_names: darray[sview]&, annotations: darray[Ast::LocalRegionAnnotation]&, function_line: u32, use_line: u32, destroyed: mutable darray[u32]&, alias_ids: darray[u32]&, alias_roots: darray[u32]&) -> void:
            can Memory.Allocate, Abort.Panic:
                is_builtin_arena_operation: bool = when operation:
                    "arena_free" | "arena_reset" | "arena_rewind" -> true
                    _ -> false
                return if is_builtin_arena_operation
                # Resolve the owner bindings first (receiver, then arguments, in marking order).
                # Only a found binding is ever marked, and the known-callee tests below scan
                # every function name, so they run only when there is something to mark.
                binding_ids: mutable darray[u32] = []
                match callee:
                    Expr.Field(receiver, _, line) | Expr.Scope(receiver, _, line):
                        receiver_name: sview = destroyed_arena_owner_source_name(receiver)
                        receiver_id: u32 = region_binding_id_at(annotations, receiver_name, function_line, use_line) can Global{Read,Write} if receiver_name != "" else NO_REGION_BINDING
                        binding_ids.push(receiver_id) if receiver_id != NO_REGION_BINDING
                    _:
                        pass
                for argument in arguments |annotations, function_line, use_line, binding_ids|:
                    actual_name: sview = destroyed_arena_owner_source_name(argument)
                    binding_id: u32 = region_binding_id_at(annotations, actual_name, function_line, use_line) can Global{Read,Write} if actual_name != "" else NO_REGION_BINDING
                    binding_ids.push(binding_id) if binding_id != NO_REGION_BINDING
                return if binding_ids.count == 0
                callee_qualified: bool = destroyed_direct_call_is_qualified(callee)
                is_known_definition: mutable bool = false
                if callee_qualified:
                    callee_module_names: mutable darray[sview] = []
                    callee_has_module_path: bool = destroyed_direct_call_module_path(callee, summary_names, summary_formals, summary_row_heads, summary_row_next, callee_module_names)
                    if callee_has_module_path:
                        summary_index_chain: mutable u32 = destroyed_summary_first_row(summary_row_heads, operation)
                        while summary_index_chain != SYMBOL_INDEX_ROW_NONE |summary_index_chain, is_known_definition, summary_names, summary_params, summary_formals, summary_row_heads, summary_row_tails, operation, callee_module_names, summary_row_next|:
                            summary_index: usize = summary_index_chain.usize()
                            is_known_definition <- true if summary_names[summary_index] == operation and summary_index < summary_params.count and summary_index * 2 < summary_formals.count and module_symbol_matches(summary_formals[summary_index * 2], "", callee_module_names, 0, callee_module_names.count)
                            summary_index_chain <- summary_row_next[summary_index]
                else:
                    is_known_definition <- any local_name in local_function_names where local_name == operation
                # Extern summaries currently have no module-owner column. A qualified
                # call cannot borrow that leaf-name-only fact; absent an exact local
                # summary it remains opaque and invalidates conservatively.
                is_known_external: bool = not callee_qualified and any external_name in external_names where external_name == operation
                return if is_known_definition or is_known_external
                for marked_id in binding_ids |destroyed, alias_ids, alias_roots|:
                    can Global{Read,Write}:
                        destroyed_mark_region_binding(destroyed, marked_id, alias_ids, alias_roots, annotations, function_line)


        def destroyed_summary_collect_aliases(statements: darray[Ast::Stmt], params: darray[Ast::ParamDecl]&, alias_names: mutable darray[sview]&, alias_params: mutable darray[u32]&, changed: mutable bool&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |params, alias_names, alias_params, changed|:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            source_params: mutable darray[u32] = []
                            destroyed_summary_source_parameters(destroyed_arena_owner_source_name(value), params, alias_names, alias_params, source_params)
                            for parameter_index in source_params |alias_names, alias_params, name, changed|:
                                destroyed_summary_add_alias(name, parameter_index, alias_names, alias_params, changed)
                        Stmt.Assign(target, operator, value, line):
                            target_name: sview = destroyed_use_root_name(target)
                            source_params: mutable darray[u32] = []
                            destroyed_summary_source_parameters(destroyed_arena_owner_source_name(value), params, alias_names, alias_params, source_params)
                            for parameter_index in source_params |alias_names, alias_params, target_name, changed|:
                                destroyed_summary_add_alias(target_name, parameter_index, alias_names, alias_params, changed) if target_name != ""
                        Stmt.Block(kind, clause, binding, body, line):
                            destroyed_summary_collect_aliases(body, params, alias_names, alias_params, changed)
                        Stmt.If(condition, then_body, else_body, line):
                            destroyed_summary_collect_aliases(then_body, params, alias_names, alias_params, changed)
                            destroyed_summary_collect_aliases(else_body, params, alias_names, alias_params, changed)
                        Stmt.While(condition, body, line):
                            destroyed_summary_collect_aliases(body, params, alias_names, alias_params, changed)
                        Stmt.For(bind, variables, iterable, body, line):
                            destroyed_summary_collect_aliases(body, params, alias_names, alias_params, changed)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms:
                                destroyed_summary_collect_aliases(arm.body, params, alias_names, alias_params, changed)
                        _:
                            pass


        def destroyed_summary_collect_expression(expression: Ast::Expr, params: darray[Ast::ParamDecl]&, alias_names: darray[sview]&, alias_params: darray[u32]&, summary_names: darray[sview]&, summary_params: darray[u32]&, summary_formals: darray[sview]&, summary_row_heads: dict[u64, u32]&, summary_row_tails: dict[u64, u32]&, summary_row_next: darray[u32]&, local_function_names: darray[sview]&, opaque_function_names: darray[sview]&, out: mutable darray[u32]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, line):
                        operation: sview = destroyed_direct_call_name(callee)
                        called_qualified: bool = destroyed_direct_call_is_qualified(callee)
                        # Generic handler specialization lowers abstract operations to
                        # generated direct calls. Their capture parameters are not present
                        # in the source call's ordinary argument list.
                        out.push(NO_ARENA_SUMMARY_PARAM) if destroyed_is_generated_effect_call(operation) and not any existing in out where existing == NO_ARENA_SUMMARY_PARAM
                        is_arena_primitive: bool = when operation:
                            "arena_free" | "arena_reset" | "arena_rewind" -> true
                            _ -> false
                        if is_arena_primitive:
                            if arguments.count > 0:
                                sources: mutable darray[u32] = []
                                destroyed_summary_source_parameters(destroyed_arena_owner_source_name(arguments[0]), params, alias_names, alias_params, sources)
                                for parameter_index in sources |out|:
                                    out.push(parameter_index) if not any existing in out where existing == parameter_index
                                if sources.count == 0:
                                    for parameter_index in 0..<params.count |out, params|:
                                        out.push(parameter_index.u32()) if destroyed_type_is_arena_reference(params[parameter_index].type_expression) and not any existing in out where existing == parameter_index.u32()
                        called_module_names: mutable darray[sview] = []
                        called_has_module_path: bool = called_qualified and destroyed_direct_call_module_path(callee, summary_names, summary_formals, summary_row_heads, summary_row_next, called_module_names)
                        summary_index_chain: mutable u32 = destroyed_summary_first_row(summary_row_heads, operation)
                        while summary_index_chain != SYMBOL_INDEX_ROW_NONE |summary_index_chain, out, summary_names, summary_params, summary_formals, summary_row_heads, summary_row_tails, operation, called_qualified, callee, called_module_names, called_has_module_path, arguments, argument_names, params, alias_names, alias_params, summary_row_next|:
                            summary_index: usize = summary_index_chain.usize()
                            row_owner: sview = summary_formals[summary_index * 2] if summary_index * 2 < summary_formals.count else ""
                            row_formal: sview = summary_formals[summary_index * 2 + 1] if summary_index * 2 + 1 < summary_formals.count else ""
                            owner_matches: bool = not called_qualified or (summary_names[summary_index] == operation and called_has_module_path and module_symbol_matches(row_owner, "", called_module_names, 0, called_module_names.count))
                            if summary_names[summary_index] == operation and owner_matches and summary_index < summary_params.count and summary_index * 2 + 1 < summary_formals.count:
                                if summary_params[summary_index] == NO_ARENA_SUMMARY_PARAM:
                                    out.push(NO_ARENA_SUMMARY_PARAM) if not any existing in out where existing == NO_ARENA_SUMMARY_PARAM
                                elif summary_params[summary_index] == NO_ARENA_SUMMARY_EFFECT:
                                    pass
                                else:
                                    argument_index: u32 = destroyed_summary_argument_index(row_formal, summary_params[summary_index], arguments, argument_names)
                                    if argument_index != NO_ARENA_SUMMARY_PARAM and argument_index.usize() < arguments.count:
                                        sources: mutable darray[u32] = []
                                        destroyed_summary_source_parameters(destroyed_arena_owner_source_name(arguments[argument_index.usize()]), params, alias_names, alias_params, sources)
                                        for parameter_index in sources |out|:
                                            out.push(parameter_index) if not any existing in out where existing == parameter_index
                                        if sources.count == 0:
                                            for parameter_index in 0..<params.count |out, params|:
                                                out.push(parameter_index.u32()) if destroyed_type_is_arena_reference(params[parameter_index].type_expression) and not any existing in out where existing == parameter_index.u32()
                                    else:
                                        for parameter_index in 0..<params.count |out, params|:
                                            out.push(parameter_index.u32()) if destroyed_type_is_arena_reference(params[parameter_index].type_expression) and not any existing in out where existing == parameter_index.u32()
                            summary_index_chain <- summary_row_next[summary_index]
                        # A bare parameter name in callee position is a callable by the time
                        # this pass runs. Do not re-parse its fn type here: parser type nodes
                        # have multiple legal wrappers, and missing this effect would let a
                        # wrapper call a reset-capable callback without exporting the summary.
                        is_parameter_call: bool = any parameter in params where parameter.name == operation
                        if is_parameter_call:
                            out.push(NO_ARENA_SUMMARY_PARAM) if not any existing in out where existing == NO_ARENA_SUMMARY_PARAM
                            for parameter_index in 0..<params.count |out, params|:
                                out.push(parameter_index.u32()) if destroyed_type_is_arena_reference(params[parameter_index].type_expression) and not any existing in out where existing == parameter_index.u32()
                        # Handler rewrites and compiler-generated adapters may call a
                        # non-declaration target while forwarding a captured Arena&. Carry
                        # that explicit owner through this summary just as call-site
                        # invalidation does; otherwise the hidden callee breaks the effect
                        # chain between the specialized clone and its caller. The forwarded
                        # sources are gathered first: the known-callee tests scan every
                        # function name, and they only matter when an Arena& is forwarded.
                        if not is_arena_primitive:
                            forwarded: mutable darray[u32] = []
                            for argument in arguments |params, alias_names, alias_params, forwarded|:
                                destroyed_summary_source_parameters(destroyed_arena_owner_source_name(argument), params, alias_names, alias_params, forwarded)
                            if forwarded.count > 0:
                                is_known_local: bool = any function_name in local_function_names where function_name == operation
                                is_known_external: bool = any external_name in opaque_function_names where external_name == operation
                                if not is_known_local and not is_known_external:
                                    for parameter_index in forwarded |out|:
                                        out.push(parameter_index) if not any existing in out where existing == parameter_index
                        destroyed_summary_collect_expression(callee, params, alias_names, alias_params, summary_names, summary_params, summary_formals, summary_row_heads, summary_row_tails, summary_row_next, local_function_names, opaque_function_names, out)
                        for argument in arguments |params, alias_names, alias_params, summary_names, summary_params, summary_formals, summary_row_heads, summary_row_tails, summary_row_next, local_function_names, opaque_function_names, out|:
                            destroyed_summary_collect_expression(argument, params, alias_names, alias_params, summary_names, summary_params, summary_formals, summary_row_heads, summary_row_tails, summary_row_next, local_function_names, opaque_function_names, out)
                    Expr.StaticEffectCall(effect_type, operation, candidates, arguments, argument_names, line):
                        # Candidate handler bodies are not yet represented in the local
                        # function-summary table. They may mutate an arena captured by the
                        # installed handler even when the operation has no Arena& arguments.
                        out.push(NO_ARENA_SUMMARY_PARAM) if not any existing in out where existing == NO_ARENA_SUMMARY_PARAM
                        for argument in arguments |out, params, alias_names, alias_params|:
                            sources: mutable darray[u32] = []
                            destroyed_summary_source_parameters(destroyed_arena_owner_source_name(argument), params, alias_names, alias_params, sources)
                            for parameter_index in sources |out|:
                                out.push(parameter_index) if not any existing in out where existing == parameter_index
                        destroyed_summary_collect_expression(effect_type, params, alias_names, alias_params, summary_names, summary_params, summary_formals, summary_row_heads, summary_row_tails, summary_row_next, local_function_names, opaque_function_names, out)
                        for argument in arguments |params, alias_names, alias_params, summary_names, summary_params, summary_formals, summary_row_heads, summary_row_tails, summary_row_next, local_function_names, opaque_function_names, out|:
                            destroyed_summary_collect_expression(argument, params, alias_names, alias_params, summary_names, summary_params, summary_formals, summary_row_heads, summary_row_tails, summary_row_next, local_function_names, opaque_function_names, out)
                    Expr.Slice(object, low, high, line):
                        destroyed_summary_collect_expression(object, params, alias_names, alias_params, summary_names, summary_params, summary_formals, summary_row_heads, summary_row_tails, summary_row_next, local_function_names, opaque_function_names, out)
                        destroyed_summary_collect_expression(low, params, alias_names, alias_params, summary_names, summary_params, summary_formals, summary_row_heads, summary_row_tails, summary_row_next, local_function_names, opaque_function_names, out)
                        destroyed_summary_collect_expression(high, params, alias_names, alias_params, summary_names, summary_params, summary_formals, summary_row_heads, summary_row_tails, summary_row_next, local_function_names, opaque_function_names, out)
                    Expr.IndexN(object, arguments, line):
                        destroyed_summary_collect_expression(object, params, alias_names, alias_params, summary_names, summary_params, summary_formals, summary_row_heads, summary_row_tails, summary_row_next, local_function_names, opaque_function_names, out)
                        for argument in arguments |params, alias_names, alias_params, summary_names, summary_params, summary_formals, summary_row_heads, summary_row_tails, summary_row_next, local_function_names, opaque_function_names, out|:
                            destroyed_summary_collect_expression(argument, params, alias_names, alias_params, summary_names, summary_params, summary_formals, summary_row_heads, summary_row_tails, summary_row_next, local_function_names, opaque_function_names, out)
                    Expr.RegionNew(inner, _, line):
                        destroyed_summary_collect_expression(inner, params, alias_names, alias_params, summary_names, summary_params, summary_formals, summary_row_heads, summary_row_tails, summary_row_next, local_function_names, opaque_function_names, out)
                    Expr.Paren(inner, line) | Expr.Move(inner, line) | Expr.Unary(operator, inner, line):
                        destroyed_summary_collect_expression(inner, params, alias_names, alias_params, summary_names, summary_params, summary_formals, summary_row_heads, summary_row_tails, summary_row_next, local_function_names, opaque_function_names, out)
                    Expr.Array(elements, line) | Expr.Tuple(elements, line) | Expr.SetLit(elements, line):
                        for element in elements |params, alias_names, alias_params, summary_names, summary_params, summary_formals, summary_row_heads, summary_row_tails, summary_row_next, local_function_names, opaque_function_names, out|:
                            destroyed_summary_collect_expression(element, params, alias_names, alias_params, summary_names, summary_params, summary_formals, summary_row_heads, summary_row_tails, summary_row_next, local_function_names, opaque_function_names, out)
                    Expr.DictLit(entries, line):
                        for entry in entries |params, alias_names, alias_params, summary_names, summary_params, summary_formals, summary_row_heads, summary_row_tails, summary_row_next, local_function_names, opaque_function_names, out|:
                            destroyed_summary_collect_expression(entry.key, params, alias_names, alias_params, summary_names, summary_params, summary_formals, summary_row_heads, summary_row_tails, summary_row_next, local_function_names, opaque_function_names, out)
                            destroyed_summary_collect_expression(entry.value, params, alias_names, alias_params, summary_names, summary_params, summary_formals, summary_row_heads, summary_row_tails, summary_row_next, local_function_names, opaque_function_names, out)
                    Expr.Construct(type_expression, fields, line):
                        destroyed_summary_collect_expression(type_expression, params, alias_names, alias_params, summary_names, summary_params, summary_formals, summary_row_heads, summary_row_tails, summary_row_next, local_function_names, opaque_function_names, out)
                        for field in fields |params, alias_names, alias_params, summary_names, summary_params, summary_formals, summary_row_heads, summary_row_tails, summary_row_next, local_function_names, opaque_function_names, out|:
                            destroyed_summary_collect_expression(field.value, params, alias_names, alias_params, summary_names, summary_params, summary_formals, summary_row_heads, summary_row_tails, summary_row_next, local_function_names, opaque_function_names, out)
                    Expr.RecordUpdate(base, fields, line):
