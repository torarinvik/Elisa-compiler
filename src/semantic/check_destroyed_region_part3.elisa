        def destroyed_collect_arena_invalidation_summaries(declarations: darray[Ast::Decl], module_name: sview, summary_names: mutable darray[sview]&, summary_params: mutable darray[u32]&, summary_formals: mutable darray[sview]&, summary_row_heads: mutable dict[u64, u32]&, summary_row_tails: mutable dict[u64, u32]&, summary_row_next: mutable darray[u32]&, local_function_names: darray[sview]&, opaque_function_names: darray[sview]&, changed: mutable bool&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |summary_names, summary_params, summary_formals, summary_row_heads, summary_row_tails, summary_row_next, local_function_names, opaque_function_names, changed|:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            # Scan every body. Function type aliases and wrappers may hide a
                            # callable parameter from the compact AST shape, but the call site
                            # itself still reveals a parameter invocation. Effect rows remain
                            # empty unless the body actually resets an arena or invokes one.
                            aliases: mutable darray[sview] = []
                            alias_params: mutable darray[u32] = []
                            collect_aliases: mutable bool = true
                            while collect_aliases |collect_aliases, body, params, aliases, alias_params|:
                                collect_aliases <- false
                                destroyed_summary_collect_aliases(body, params, aliases, alias_params, collect_aliases)
                            invalidated: mutable darray[u32] = []
                            destroyed_summary_collect_statements(body, params, aliases, alias_params, summary_names, summary_params, summary_formals, summary_row_heads, summary_row_tails, summary_row_next, local_function_names, opaque_function_names, invalidated)
                            if invalidated.count == 0:
                                known: mutable bool = false
                                row_chain: mutable u32 = destroyed_summary_first_row(summary_row_heads, name)
                                while row_chain != SYMBOL_INDEX_ROW_NONE |row_chain, known, summary_names, summary_params, summary_formals, summary_row_heads, summary_row_tails, name, module_name, summary_row_next|:
                                    row: usize = row_chain.usize()
                                    known <- true if summary_names[row] == name and row < summary_params.count and row * 2 + 1 < summary_formals.count and summary_formals[row * 2] == module_name
                                    row_chain <- summary_row_next[row]
                                if not known:
                                    destroyed_summary_index_push(name, summary_names.count, summary_row_heads, summary_row_tails, summary_row_next) can Global{Read,Write}
                                    summary_names.push(name)
                                    summary_params.push(NO_ARENA_SUMMARY_EFFECT)
                                    summary_formals.push(module_name)
                                    summary_formals.push("")
                                    changed <- true
                            for parameter_index in invalidated |summary_names, summary_params, summary_formals, summary_row_heads, summary_row_tails, summary_row_next, name, module_name, changed|:
                                exists: mutable bool = false
                                row_chain: mutable u32 = destroyed_summary_first_row(summary_row_heads, name)
                                while row_chain != SYMBOL_INDEX_ROW_NONE |row_chain, exists, summary_names, summary_params, summary_formals, summary_row_heads, summary_row_tails, name, module_name, parameter_index, summary_row_next|:
                                    row: usize = row_chain.usize()
                                    exists <- true if summary_names[row] == name and row < summary_params.count and row * 2 + 1 < summary_formals.count and summary_formals[row * 2] == module_name and summary_params[row] == parameter_index
                                    row_chain <- summary_row_next[row]
                                if not exists:
                                    destroyed_summary_index_push(name, summary_names.count, summary_row_heads, summary_row_tails, summary_row_next) can Global{Read,Write}
                                    summary_names.push(name)
                                    summary_params.push(parameter_index)
                                    summary_formals.push(module_name)
                                    summary_formals.push("") if parameter_index == NO_ARENA_SUMMARY_PARAM else summary_formals.push(params[parameter_index.usize()].name)
                                    changed <- true
                        Decl.Module(name, body, line):
                            destroyed_collect_arena_invalidation_summaries(body, name, summary_names, summary_params, summary_formals, summary_row_heads, summary_row_tails, summary_row_next, local_function_names, opaque_function_names, changed) can Global{Read,Write}
                        Decl.Scoped(body, line):
                            destroyed_collect_arena_invalidation_summaries(body, module_name, summary_names, summary_params, summary_formals, summary_row_heads, summary_row_tails, summary_row_next, local_function_names, opaque_function_names, changed) can Global{Read,Write}
                        _:
                            pass


        def destroyed_apply_arena_invalidation(expression: Ast::Expr, annotations: darray[Ast::LocalRegionAnnotation]&, function_line: u32, use_line: u32, destroyed: mutable darray[u32]&, alias_ids: darray[u32]&, alias_roots: darray[u32]&, summary_names: darray[sview]&, summary_params: darray[u32]&, summary_formals: darray[sview]&, summary_row_heads: dict[u64, u32]&, summary_row_tails: dict[u64, u32]&, summary_row_next: darray[u32]&, local_function_names: darray[sview]&, local_reference_names: darray[sview]&, local_reference_names_complete: bool, opaque_function_names: darray[sview]&, opaque_function_starts: darray[usize]&, opaque_function_arities: darray[u32]&, extern_params: darray[Ast::ExternParam]&) -> void:
