# Char-classifier fold blocker (stage0 analyzer_classifier_fold checkUnfoldableClassifier,
# docs/125 §9). A classifier-shaped function — one `char` param, returning a CLOSED const enum,
# body a single `return match param:` — folds to a 256-byte lookup table UNLESS an arm carries a
# guard, which makes it undecidable at fold time. We port only the GUARD case: a guarded arm is
# inherently unfoldable, so it is always a real blocker (the guardless "branch chain" variant
# needs the fold analysis to know whether it folded, so it is left alone). SOUND and syntactic.
extend Semantic:
    private:
        def classifier_enum_name_present(names: darray[sview]&, wanted: sview) -> bool:
            can Abort.Panic:
                return any name in names where name == wanted

        # Names of every CLOSED const enum in the tree.
        def collect_const_enum_names(declarations: darray[Ast::Decl], out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations:
                    match declaration:
                        Decl.Enum(name, variants, is_const, storage_type, enum_line):
                            out.push(name) if is_const
                        Decl.Module(module_name, module_body, module_line):
                            collect_const_enum_names(module_body, out)
                        Decl.Scoped(scoped_body, scoped_line):
                            collect_const_enum_names(scoped_body, out)
                        _:
                            pass

        # Whether the function body is exactly `return match <param>:` with a guarded arm, where
        # <param> is the sole char parameter named `param_name`.
        def classifier_body_has_guarded_arm(body: darray[Ast::Stmt], param_name: sview) -> bool:
            can Memory.Allocate, Abort.Panic:
                false return if body.count != 1
                match body[0]:
                    Stmt.Return(value, line):
                        if value is returned:
                            match returned:
                                Expr.Match(scrutinee, arms, match_line):
                                    false return if ident_name_of(scrutinee) != param_name
                                    return any arm in arms where not (arm.guard is Expr.Absent)
                                _:
                                    return false
                        return false
                    _:
                        return false

        # The bare return-type name, or "" when the return type is absent.
        def classifier_return_type_name(return_type: Ast::Expr?) -> sview:
            can Memory.Allocate, Abort.Panic:
                if return_type is present:
                    return bare_type_name(present)
                return sview("", 0, 0)

        def char_classifier_guard_walk(declarations: darray[Ast::Decl], const_enums: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            classifier_shaped: bool = parameters.count == 1 and bare_type_name(parameters[0].type_expression) == "char" and classifier_enum_name_present(const_enums, classifier_return_type_name(return_type))
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.CharClassifierGuard, name: function_name, line: line.line, expected: "", actual: ""}) if classifier_shaped and classifier_body_has_guarded_arm(body, parameters[0].name)
                        Decl.Module(module_name, module_body, module_line):
                            table <- char_classifier_guard_walk(module_body, const_enums, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- char_classifier_guard_walk(scoped_body, const_enums, table)
                        _:
                            pass

        def check_char_classifier_guard(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                const_enums: mutable darray[sview] = []
                collect_const_enum_names(declarations, const_enums)
                table <- char_classifier_guard_walk(declarations, const_enums, table)
