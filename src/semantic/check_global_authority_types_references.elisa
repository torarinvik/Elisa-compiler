extend Semantic:
    private:
        def ga_type_expression_contains_reference(type_expression: Ast::Expr, state: GlobalAuthority&, depth: u32) -> bool:
            can Memory.Allocate, Abort.Panic:
                return true if depth > 32
                resolved: Ast::Expr = ga_type_alias_result(type_expression, state.module_scope, state, depth + 1)
                return true if ga_reference_type(resolved, state, depth + 1)
                match resolved:
                    Expr.Tuple(elements, _):
                        for element in elements:
                            return true if ga_type_expression_contains_reference(element, state, depth + 1)
                        return false
                    Expr.Index(head, element, _):
                        # `id[T]` is a builtin handle: an index, never storage (stage0 IDType).
                        return false if ga_type_head(resolved) == "id"
                        if ga_builtin_collection(resolved, state, depth + 1) or ga_type_head(resolved) == "list":
                            return ga_type_expression_contains_reference(element, state, depth + 1)
                        return ga_type_expression_contains_reference(head, state, depth + 1)
                    Expr.IndexN(_, elements, _):
                        if ga_builtin_collection(resolved, state, depth + 1) or ga_type_head(resolved) == "list":
                            for element in elements:
                                return true if ga_type_expression_contains_reference(element, state, depth + 1)
                            return false
                        match resolved:
                            Expr.IndexN(head, _, _):
                                return ga_type_expression_contains_reference(head, state, depth + 1)
                            _:
                                return true
                    Expr.Unary(_, inner, _) | Expr.Refinement(inner, _, _) | Expr.Paren(inner, _):
                        return ga_type_expression_contains_reference(inner, state, depth + 1)
                    Expr.Ident(_, _) | Expr.Scope(_, _, _):
                        owner: usize = ga_known_struct(resolved, state.module_scope, state, depth + 1)
                        if owner < state.struct_names.count:
                            index_cursor: mutable usize = ga_field_first(owner, state)
                            while index_cursor < state.field_owners.count |index_cursor|:
                                index: usize = index_cursor
                                index_cursor <- ga_field_after(index, state)
                                continue if state.field_owners[index] != state.struct_names[owner] or state.field_scopes[index] != state.struct_scopes[owner]
                                return true if:
                                    state.field_scopes[index] != state.module_scope
                                    ga_type_expression_contains_reference(state.field_types[index], state, depth + 1)
                            return false
                        enum_owner: usize = ga_resolve_indexed(ga_type_head(resolved), state.module_scope, resolved is Expr.Scope, state.enum_names, state.enum_scopes, state.enum_heads, state.enum_next, state)
                        if enum_owner < state.enum_names.count:
                            return true if state.enum_variant_scopes.count < state.enum_variant_names.count or state.enum_variant_owners.count < state.enum_variant_names.count or state.enum_variant_payload_starts.count < state.enum_variant_names.count or state.enum_variant_payload_counts.count < state.enum_variant_names.count
                            variant_index_cursor: mutable usize = ga_variant_first(enum_owner, state)
                            while variant_index_cursor < state.enum_variant_names.count |variant_index_cursor|:
                                variant_index: usize = variant_index_cursor
                                variant_index_cursor <- ga_variant_after(variant_index, state)
                                continue if state.enum_variant_owners[variant_index] != state.enum_names[enum_owner] or state.enum_variant_scopes[variant_index] != state.enum_scopes[enum_owner]
                                return true if state.enum_variant_scopes[variant_index] != state.module_scope
                                payload_start: usize = state.enum_variant_payload_starts[variant_index]
                                payload_count: usize = state.enum_variant_payload_counts[variant_index]
                                return true if payload_start > state.enum_variant_payload_types.count or payload_count > state.enum_variant_payload_types.count - payload_start
                                for payload_index in payload_start..<payload_start + payload_count:
                                    return true if ga_type_expression_contains_reference(state.enum_variant_payload_types[payload_index], state, depth + 1)
                            return false
                        return true if ga_generic_head(ga_type_head(resolved), state)
                        return not ga_builtin_head(ga_type_head(resolved))
                    Expr.IntLit(_, _) | Expr.FloatLit(_, _) | Expr.BoolLit(_, _) | Expr.StringLit(_, _):
                        return false
                    _:
                        return true

        def ga_type_expression_contains_mutable_reference(type_expression: Ast::Expr, state: GlobalAuthority&, depth: u32, origin: usize = GLOBAL_AUTHORITY_NONE) -> bool:
            can Memory.Allocate, Abort.Panic:
                return true if depth > 32
                lexical_scope: usize = state.module_scope if origin == GLOBAL_AUTHORITY_NONE else origin
                resolved: Ast::Expr = ga_type_alias_result(type_expression, lexical_scope, state, depth + 1)
                if ga_reference_type(resolved, state, depth + 1, lexical_scope):
                    return ga_mutable_parameter(resolved, state, depth + 1, lexical_scope)
                match resolved:
                    Expr.Tuple(elements, _):
                        for element in elements:
                            return true if ga_type_expression_contains_mutable_reference(element, state, depth + 1, lexical_scope)
                        return false
                    Expr.Index(head, element, _):
                        # `id[T]` is a builtin handle: an index, never storage (stage0 IDType).
                        return false if ga_type_head(resolved) == "id"
                        if ga_builtin_collection(resolved, state, depth + 1) or ga_type_head(resolved) == "list":
                            return ga_type_expression_contains_mutable_reference(element, state, depth + 1, lexical_scope)
                        return ga_type_expression_contains_mutable_reference(head, state, depth + 1, lexical_scope)
                    Expr.IndexN(_, elements, _):
                        if ga_builtin_collection(resolved, state, depth + 1) or ga_type_head(resolved) == "list":
                            for element in elements:
                                return true if ga_type_expression_contains_mutable_reference(element, state, depth + 1, lexical_scope)
                            return false
                        match resolved:
                            Expr.IndexN(head, _, _):
                                return ga_type_expression_contains_mutable_reference(head, state, depth + 1, lexical_scope)
                            _:
                                return true
                    Expr.Unary(_, inner, _) | Expr.Refinement(inner, _, _) | Expr.Paren(inner, _):
                        return ga_type_expression_contains_mutable_reference(inner, state, depth + 1, lexical_scope)
                    Expr.Ident(_, _) | Expr.Scope(_, _, _):
                        owner: usize = ga_known_struct(resolved, lexical_scope, state, depth + 1)
                        if owner < state.struct_names.count:
                            index_cursor: mutable usize = ga_field_first(owner, state)
                            while index_cursor < state.field_owners.count |index_cursor|:
                                index: usize = index_cursor
                                index_cursor <- ga_field_after(index, state)
                                continue if state.field_owners[index] != state.struct_names[owner] or state.field_scopes[index] != state.struct_scopes[owner]
                                return true if ga_type_expression_contains_mutable_reference(state.field_types[index], state, depth + 1, state.field_scopes[index])
                            return false
                        enum_owner: usize = ga_resolve_indexed(ga_type_head(resolved), lexical_scope, resolved is Expr.Scope, state.enum_names, state.enum_scopes, state.enum_heads, state.enum_next, state)
                        if enum_owner < state.enum_names.count:
                            return true if state.enum_variant_scopes.count < state.enum_variant_names.count or state.enum_variant_owners.count < state.enum_variant_names.count or state.enum_variant_payload_starts.count < state.enum_variant_names.count or state.enum_variant_payload_counts.count < state.enum_variant_names.count
                            variant_index_cursor: mutable usize = ga_variant_first(enum_owner, state)
                            while variant_index_cursor < state.enum_variant_names.count |variant_index_cursor|:
                                variant_index: usize = variant_index_cursor
                                variant_index_cursor <- ga_variant_after(variant_index, state)
                                continue if state.enum_variant_owners[variant_index] != state.enum_names[enum_owner] or state.enum_variant_scopes[variant_index] != state.enum_scopes[enum_owner]
                                payload_start: usize = state.enum_variant_payload_starts[variant_index]
                                payload_count: usize = state.enum_variant_payload_counts[variant_index]
                                return true if payload_start > state.enum_variant_payload_types.count or payload_count > state.enum_variant_payload_types.count - payload_start
                                for payload_index in payload_start..<payload_start + payload_count:
                                    return true if ga_type_expression_contains_mutable_reference(state.enum_variant_payload_types[payload_index], state, depth + 1, state.enum_variant_scopes[variant_index])
                            return false
                        return true if ga_generic_head(ga_type_head(resolved), state)
                        return not ga_builtin_head(ga_type_head(resolved))
                    Expr.IntLit(_, _) | Expr.FloatLit(_, _) | Expr.BoolLit(_, _) | Expr.StringLit(_, _):
                        return false
                    _:
                        return true

        def ga_annotation(expression: Ast::Expr, state: GlobalAuthority&, depth: u32) -> Ast::Expr?:
            can Memory.Allocate, Abort.Panic:
                return null if depth > 32
                match expression:
                    Expr.Ident(name, _):
                        local_index: mutable usize = min(state.local_limit, state.locals.count)
                        while local_index > state.local_floor |local_index|:
                            local_index <- local_index - 1
                            return state.local_types[local_index] if state.locals[local_index] == name
                    Expr.Field(base, field, _):
                        base_type: Ast::Expr = get ga_annotation(base, state, depth + 1) else return null
                        lexical_scope: usize = ga_expression_type_scope(base, state, depth + 1)
                        return null if lexical_scope == GLOBAL_AUTHORITY_UNKNOWN_ALIAS
                        resolved_base_type: Ast::Expr = ga_type_alias_result(base_type, lexical_scope, state, depth + 1)
                        if ga_tuple_field_type(resolved_base_type, field, state) is tuple_field_type:
                            return tuple_field_type
                        owner: usize = ga_known_struct(base_type, lexical_scope, state, depth + 1)
                        return null if owner == state.struct_names.count
                        index_cursor: mutable usize = ga_field_first(owner, state)
                        while index_cursor < state.field_owners.count |index_cursor|:
                            index: usize = index_cursor
                            index_cursor <- ga_field_after(index, state)
                            if state.field_owners[index] == state.struct_names[owner] and state.field_scopes[index] == state.struct_scopes[owner] and state.field_names[index] == field:
                                return null if not ga_return_portable(state.field_types[index], state.field_scopes[index], state, depth + 1)
                                return state.field_types[index]
                        return null
                    Expr.Call(callee, arguments, labels, _):
                        if arguments.count == 0 and labels.count == 0 and ga_target_conversion(callee, state):
                            return null if callee is Expr.Unary
                            match callee:
                                Expr.Field(_, target, at):
                                    result: Ast::Expr = Ast::Expr.Ident(target, at)
                                    return result if ga_builtin_unshadowed(result, state.module_scope, state) else null
                                _: pass
                        slot: mutable usize = ga_named_callee_slot(callee, state)
                        match ga_callable_core(callee):
                            Expr.Field(receiver, method, _):
                                if ga_annotation(receiver, state, depth + 1) is receiver_type:
                                    slot <- ga_resolve_function(method, ga_receiver_scope(receiver_type, state), false, state)
                                actuals: mutable darray[Ast::Expr] = [receiver]
                                actual_labels: mutable darray[sview] = [""]
                                actuals.extend(arguments)
                                actual_labels.extend(labels)
                                slot <- ga_select_function(slot, actuals, actual_labels, state, true)
                                return ga_unique_call_return(slot, actuals, actual_labels, state, true)
                            _:
                                slot <- ga_select_function(slot, arguments, labels, state)
                        return ga_unique_call_return(slot, arguments, labels, state)
                    Expr.Paren(inner, _) | Expr.Move(inner, _) | Expr.Unary(_, inner, _):
                        return ga_annotation(inner, state, depth + 1)
                    Expr.Index(base, _, _):
                        base_type: Ast::Expr = get ga_annotation(base, state, depth + 1) else return null
                        match base_type:
                            Expr.Index(_, element, _):
                                return element
                            Expr.IndexN(head, elements, _):
                                return null if elements.count == 0
                                return elements[1] if ga_type_head(head) == "dict" and elements.count > 1 else elements[0]
                            _:
                                return null
                    Expr.IntLit(_, _) | Expr.FloatLit(_, _) | Expr.BoolLit(_, _) | Expr.StringLit(_, _):
                        return expression
                    _:
                        pass
                global_slot: usize = ga_global(expression, state)
                return state.global_types[global_slot] if global_slot < state.globals.count else null

        def ga_builtin_collection(type_expression: Ast::Expr, state: GlobalAuthority&, depth: u32) -> bool:
            can Memory.Allocate, Abort.Panic:
                return false if depth > 32
                alias: usize = ga_alias(type_expression, state)
                return ga_builtin_collection(state.alias_types[alias], state, depth + 1) if alias < state.alias_names.count
                head: sview = ga_type_head(type_expression)
                return when head:
                    "darray" | "dict" | "set" -> true
                    _ -> false

        def ga_mutating_collection(receiver: Ast::Expr, method: sview, state: GlobalAuthority&) -> bool:
            can Memory.Allocate, Abort.Panic:
                method_mutates: bool = when method:
                    "push" | "extend" | "reserve" | "resize" | "clear" | "truncate" | "insert" | "remove" | "set" | "put" | "add" | "get_or_insert" -> true
                    _ -> false
                return false if not method_mutates
                annotation: Ast::Expr = get ga_annotation(receiver, state, 0) else return false
                return ga_builtin_collection(annotation, state, 0)

        # `dict.entry(k).insert(v)` and `.get_or_insert(v)` are lowered as writes to
        # the dictionary receiver even though the immediate source receiver is the
        # synthetic entry call. Recover the owning collection before classifying the
        # mutator; ordinary methods keep their direct receiver.
        def ga_collection_mutation_receiver(receiver: Ast::Expr, method: sview) -> Ast::Expr:
            can Abort.Panic:
                return receiver if method != "insert" and method != "get_or_insert"
                match receiver:
                    Expr.Call(callee: callee, _):
                        match callee:
                            Expr.Field(dict_receiver, entry_method, _) if entry_method == "entry":
                                return dict_receiver
                            _:
                                pass
                    _:
                        pass
                return receiver

        def ga_referent_type(type_expression: Ast::Expr, state: GlobalAuthority&, depth: u32) -> Ast::Expr?:
            can Memory.Allocate, Abort.Panic:
                return null if depth > 32
                resolved: Ast::Expr = ga_type_alias_result(type_expression, state.module_scope, state, depth + 1)
                match resolved:
                    Expr.Unary(operator, operand, _):
                        return operand if operator == TokenKind.Ampersand
                        return ga_referent_type(operand, state, depth + 1) if operator == TokenKind.Mutable or operator == TokenKind.Static or operator == TokenKind.Heap or operator == TokenKind.Stack or operator == TokenKind.Question
                        return null
                    Expr.Paren(inner, _):
                        return ga_referent_type(inner, state, depth + 1)
                    _:
                        return null

        # A mutably borrowed scalar cannot acquire nested aliases through mutation, but a
        # mutably borrowed aggregate that contains references can. Keep that distinction so
        # unknown calls invalidate only origins they may actually change.
        def ga_mutation_can_change_reference_contents(type_expression: Ast::Expr, state: GlobalAuthority&, depth: u32) -> bool:
            can Memory.Allocate, Abort.Panic:
                return true if depth > 32
                resolved: Ast::Expr = ga_type_alias_result(type_expression, state.module_scope, state, depth + 1)
                if ga_reference_type(resolved, state, depth + 1):
                    referent: Ast::Expr = get ga_referent_type(resolved, state, depth + 1) else return true
                    return ga_type_expression_contains_reference(referent, state, depth + 1)
                return ga_type_expression_contains_reference(resolved, state, depth + 1)

        def ga_argument_type(slot: usize, position: usize, label: sview, state: GlobalAuthority&) -> Ast::Expr?:
            can Abort.Panic:
                seen: mutable usize = 0
                end: usize = min(state.parameter_starts[slot] + state.parameter_counts[slot], state.parameter_types.count)
                for index in state.parameter_starts[slot]..<end |seen|:
                    selected: bool = state.parameter_names[index] == label if label != "" else seen == position
                    return state.parameter_types[index] if selected
                    seen <- seen + 1
                return null

        def ga_arity_fits(candidate: usize, count: usize, state: GlobalAuthority&, method: bool = false) -> bool:
            can Abort.Panic:
                return false if candidate >= state.parameter_counts.count
                variadic: bool = candidate < state.function_variadic.count and state.function_variadic[candidate]
                return true if method and (variadic or state.parameter_minimum[candidate] < state.parameter_counts[candidate])
                return count >= state.parameter_minimum[candidate] and (variadic or count <= state.parameter_counts[candidate])

        def ga_has_variadic_candidate(selected: usize, state: GlobalAuthority&) -> bool:
            can Abort.Panic:
                return false if selected >= state.functions.count
                while next_candidate < state.functions.count |next_candidate: usize = ga_candidate_head(selected, state)|:
                    candidate: usize = next_candidate
                    next_candidate <- state.function_next[candidate]
                    return true if state.functions[candidate] == state.functions[selected] and state.function_scopes[candidate] == state.function_scopes[selected] and candidate < state.function_variadic.count and state.function_variadic[candidate]
                return false

        # UFCS ranks only the receiver. Unknown shapes retain every viable row.
        def ga_method_receiver_rank(candidate: usize, arguments: darray[Ast::Expr]&, state: GlobalAuthority&) -> i64:
            can Memory.Allocate, Abort.Panic:
                return -2 if arguments.count == 0
                formal: Ast::Expr = get ga_argument_type(candidate, 0, "", state) else return -2
                actual: Ast::Expr = get ga_annotation(arguments[0], state, 0) else return -2
                formal_resolved: Ast::Expr = ga_type_alias_result(formal, state.function_scopes[candidate], state, 0)
                actual_resolved: Ast::Expr = ga_type_alias_result(actual, state.module_scope, state, 0)
                return -2 if:
                    not (formal is Expr.Ident or formal is Expr.Scope) or not (actual is Expr.Ident or actual is Expr.Scope)
                    not (formal_resolved is Expr.Ident or formal_resolved is Expr.Scope) or not (actual_resolved is Expr.Ident or actual_resolved is Expr.Scope)
                    ga_generic_head(ga_type_head(actual), state)
                formal_head: sview = ga_type_head(formal)
                if formal is Expr.Ident and ga_generic_head(formal_head, state):
                    return -2 if candidate >= state.function_lines.count or candidate >= state.function_offsets.count
                    line: u32 = state.function_lines[candidate]
                    offset: u32 = state.function_offsets[candidate]
                    for other in 0..<state.function_lines.count:
                        return -2 if other != candidate and other < state.function_offsets.count and state.function_lines[other] == line and state.function_offsets[other] == offset
                    return -2 if state.generic_lines.count != state.generic_names.count or state.generic_lines.count != state.generic_owner_offsets.count
                    for index in 0..<state.generic_lines.count:
                        return 1 if state.generic_lines[index] == line and state.generic_owner_offsets[index] == offset and state.generic_names[index] == formal_head
                    return -2
                formal_struct: usize = ga_known_struct(formal, state.function_scopes[candidate], state, 0)
                actual_struct: usize = ga_known_struct(actual, state.module_scope, state, 0)
                if formal_struct < state.struct_names.count and actual_struct < state.struct_names.count:
                    return 2 if formal_struct == actual_struct else -1
                formal_builtin: bool = ga_builtin_unshadowed(formal, state.function_scopes[candidate], state)
                actual_builtin: bool = ga_builtin_unshadowed(actual, state.module_scope, state)
                if formal_builtin and actual_builtin:
                    return 2 if ga_type_head(formal_resolved) == ga_type_head(actual_resolved) else -2
                return -1 if (formal_struct < state.struct_names.count and actual_builtin) or (actual_struct < state.struct_names.count and formal_builtin)
                return -2

        def ga_method_candidates_known(selected: usize, arguments: darray[Ast::Expr]&, state: GlobalAuthority&) -> bool:
            can Memory.Allocate, Abort.Panic:
                return false if selected >= state.functions.count
                while next_candidate < state.functions.count |next_candidate: usize = ga_candidate_head(selected, state)|:
                    candidate: usize = next_candidate
                    next_candidate <- state.function_next[candidate]
                    continue if state.functions[candidate] != state.functions[selected] or state.function_scopes[candidate] != state.function_scopes[selected]
                    continue if not ga_arity_fits(candidate, arguments.count, state, true)
                    return false if ga_method_receiver_rank(candidate, arguments, state) == -2
                return true

        # Unresolved equal candidates must retain every possible mutable capability.
        def ga_candidate_score(candidate: usize, arguments: darray[Ast::Expr]&, labels: darray[sview]&, state: GlobalAuthority&, method: bool = false) -> i64:
            can Memory.Allocate, Abort.Panic:
                return -1 if not ga_arity_fits(candidate, arguments.count, state, method)
                if method:
                    receiver_rank: i64 = ga_method_receiver_rank(candidate, arguments, state)
                    return 0 if receiver_rank == -2 else receiver_rank
                score: mutable i64 = 0
                fits: mutable bool = true
                for index in 0..<arguments.count |score, fits|:
                    label: sview = labels[index] if index < labels.count else sview("", 0, 0)
                    if ga_argument_type(candidate, index, label, state) is parameter_type:
                        if ga_annotation(arguments[index], state, 0) is argument_type:
                            continue if ga_generic_head(ga_type_head(parameter_type), state) or ga_generic_head(ga_type_head(argument_type), state)
                            parameter_struct: usize = ga_known_struct(parameter_type, state.function_scopes[candidate], state, 0)
                            argument_struct: usize = ga_known_struct(argument_type, state.module_scope, state, 0)
                            fits <- false if parameter_struct < state.struct_names.count and argument_struct < state.struct_names.count and parameter_struct != argument_struct
                            parameter_resolved: Ast::Expr = ga_type_alias_result(parameter_type, state.function_scopes[candidate], state, 0)
                            argument_resolved: Ast::Expr = ga_type_alias_result(argument_type, state.module_scope, state, 0)
                            parameter_head: sview = ga_type_head(parameter_resolved)
                            argument_head: sview = ga_type_head(argument_resolved)
                            fits <- false if parameter_struct < state.struct_names.count and argument_struct == state.struct_names.count and ga_builtin_unshadowed(argument_type, state.module_scope, state) and not ga_generic_head(argument_head, state)
                            fits <- false if argument_struct < state.struct_names.count and parameter_struct == state.struct_names.count and ga_builtin_unshadowed(parameter_type, state.function_scopes[candidate], state) and not ga_generic_head(parameter_head, state)
                            if (parameter_struct < state.struct_names.count and parameter_struct == argument_struct and (parameter_type is Expr.Ident or parameter_type is Expr.Scope) and (argument_type is Expr.Ident or argument_type is Expr.Scope) and (parameter_resolved is Expr.Ident or parameter_resolved is Expr.Scope) and (argument_resolved is Expr.Ident or argument_resolved is Expr.Scope)) or (parameter_head == argument_head and parameter_head != "" and ga_builtin_unshadowed(parameter_type, state.function_scopes[candidate], state) and ga_builtin_unshadowed(argument_type, state.module_scope, state)):
                                score <- score + 2
                            else:
                                literal_kind: sview = match argument_type:
                                    Expr.IntLit(_, _): "int"
                                    Expr.BoolLit(_, _): "bool"
                                    Expr.FloatLit(_, _): "float"
                                    Expr.StringLit(_, _): "string"
                                    _: ""
                                fits <- false if literal_kind != "" and ga_builtin_unshadowed(parameter_type, state.function_scopes[candidate], state) and not ga_generic_head(parameter_head, state) and literal_never_fits(literal_kind, parameter_head)
                                # Different nominal/generic/alias heads are unresolved here,
                                # not proof that the overload cannot run.
                                known_kind: sview = "bool" if argument_head == "bool" else ("int" if argument_head == "i64" or argument_head == "i32" or argument_head == "u32" or argument_head == "u64" else "")
                                fits <- false if literal_kind == "" and known_kind != "" and ga_builtin_unshadowed(argument_type, state.module_scope, state) and ga_builtin_unshadowed(parameter_type, state.function_scopes[candidate], state) and not ga_generic_head(argument_head, state) and not ga_generic_head(parameter_head, state) and literal_never_fits(known_kind, parameter_head)
                    else:
                        fits <- false if state.functions[candidate] != "" and not (candidate < state.function_variadic.count and state.function_variadic[candidate])
                return score if fits else -1

        def ga_select_function(first: usize, arguments: darray[Ast::Expr]&, labels: darray[sview]&, state: GlobalAuthority&, method: bool = false) -> usize:
            can Memory.Allocate, Abort.Panic:
                return state.functions.count if first >= state.functions.count
                return first if state.functions[first] == ""
                selected: mutable usize = state.functions.count
                best_score: mutable i64 = -1
                while next_candidate < state.functions.count |next_candidate: usize = ga_function_head(state.functions[first], state), selected, best_score|:
                    candidate: usize = next_candidate
                    next_candidate <- state.function_next[candidate]
                    continue if state.functions[candidate] != state.functions[first] or state.function_scopes[candidate] != state.function_scopes[first]
                    score: i64 = ga_candidate_score(candidate, arguments, labels, state, method)
                    if score > best_score:
                        selected <- candidate
                        best_score <- score
                return selected

        def ga_candidate_selected(candidate: usize, selected: usize, arguments: darray[Ast::Expr]&, labels: darray[sview]&, state: GlobalAuthority&, method: bool = false) -> bool:
            can Memory.Allocate, Abort.Panic:
                return false if selected >= state.functions.count
                return candidate == selected if state.functions[selected] == ""
                return false if state.functions[candidate] != state.functions[selected] or state.function_scopes[candidate] != state.function_scopes[selected]
                score: i64 = ga_candidate_score(candidate, arguments, labels, state, method)
                return false if score < 0
                # The selected row trivially ties with itself; skip rescoring it.
                return true if candidate == selected
                if method:
                    return score == ga_candidate_score(selected, arguments, labels, state, true) if ga_method_candidates_known(selected, arguments, state) else true
                return true if ga_has_variadic_candidate(selected, state)
                return score == ga_candidate_score(selected, arguments, labels, state) if ga_arguments_known(arguments, state) else true

        def ga_argument_mutates(slot: usize, position: usize, label: sview, state: GlobalAuthority&, depth: u32 = 0) -> bool:
            can Memory.Allocate, Abort.Panic:
                return true if depth > 32 or slot == state.unknown_callback_slot
                return false if slot >= state.functions.count
                if ga_callback_origin_index_ready(state):
                    edge: mutable usize = ga_callback_origin_head(slot, state)
                    while edge < state.callback_origin_from.count |edge, slot, position, label, state, depth|:
                        if state.callback_origin_from[edge] == slot:
                            return true if ga_argument_mutates(state.callback_origin_to[edge], position, label, state, depth + 1)
                        edge <- state.callback_origin_next[edge]
                else:
                    for edge in 0..<state.callback_origin_from.count:
                        if state.callback_origin_from[edge] == slot:
                            return true if ga_argument_mutates(state.callback_origin_to[edge], position, label, state, depth + 1)
                seen: mutable usize = 0
                end: usize = min(state.parameter_starts[slot] + state.parameter_counts[slot], state.parameter_types.count)
                for index in state.parameter_starts[slot]..<end |seen|:
                    selected: bool = state.parameter_names[index] == label if label != "" else seen == position
                    return ga_mutable_parameter(state.parameter_types[index], state, 0, state.function_scopes[slot]) if selected
                    seen <- seen + 1
                if label != "":
                    for index in state.parameter_starts[slot]..<end:
                        return true if ga_mutable_parameter(state.parameter_types[index], state, 0, state.function_scopes[slot])
                return false
