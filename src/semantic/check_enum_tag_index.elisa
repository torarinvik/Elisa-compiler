# A fixed array `p: array[T, N]&` indexed by an enum tag `enumval.u32()` (or any int cast of
# an enum-typed value) is out of bounds when the enum has MORE than N variants — the tag can
# reach N or beyond. stage0 reports the access as unprovable ("unchecked index requires
# can[Unsafe] ..."); stage1 mirrors it with IndexOutOfBounds. SOUND: both the variant count
# and the array size are compile-time constants, so `variant_count > N` is decidable with no
# range fuzziness (an enum with <= N variants stays clean — the tag is always in bounds).
extend Semantic:
    private:
        # Variant count of enum ENUM_NAME across the declaration set, or 0.
        def enum_variant_count(declarations: darray[Ast::Decl], enum_name: sview) -> i64:
            can Memory.Allocate, Abort.Panic:
                result: mutable i64 = 0
                for declaration in declarations |result|:
                    match declaration:
                        Decl.Enum(name, variants, enum_is_const, enum_storage, line):
                            result <- variants.count.i64() if name == enum_name and result == 0
                        Decl.Module(module_name, module_body, module_line):
                            nested: i64 = enum_variant_count(module_body, enum_name)
                            result <- nested if nested > 0 and result == 0
                        Decl.Scoped(scoped_body, scoped_line):
                            nested: i64 = enum_variant_count(scoped_body, enum_name)
                            result <- nested if nested > 0 and result == 0
                        _:
                            pass
                return result

        # The N of a fixed array type `array[T, N]` (IndexN, second arg an int literal),
        # looking through `&`/paren wrappers; -1 if not a fixed array.
        def fixed_array_size(type_expression: Ast::Expr) -> i64:
            can Memory.Allocate, Abort.Panic:
                match type_expression:
                    Expr.Unary(operator, operand, line):
                        return fixed_array_size(operand)
                    Expr.Paren(inner, line):
                        return fixed_array_size(inner)
                    Expr.IndexN(object, arguments, line):
                        (-1) return if ident_name_of(object) != "array" or arguments.count != 2
                        return match arguments[1]:
                            Expr.IntLit(size_value): size_value
                            _: -1
                    Expr.Index(object, index, line):
                        (-1) return if ident_name_of(object) != "array"
                        return match index:
                            Expr.IntLit(size_value): size_value
                            _: -1
                    _:
                        return (-1)

        # The enum tag whose int-cast is EXPR (`c.u32()`, `c.i64()`, ...), i.e. the receiver
        # identifier of a method-call cast, or "".
        def enum_tag_receiver(expression: Ast::Expr) -> sview:
            can Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, line):
                        return match callee:
                            Expr.Field(object, field, field_line): ident_name_of(object)
                            _: ""
                    _:
                        return ""

        def enum_tag_index_walk_expr(expression: Ast::Expr, array_params: darray[sview]&, array_sizes: darray[i64]&, enum_params: darray[sview]&, enum_types: darray[sview]&, declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Index(object, index, line):
                        array_name: sview = ident_name_of(object)
                        array_slot: i64 = enum_tag_lookup(array_params, array_name)
                        tag_name: sview = enum_tag_receiver(index)
                        enum_slot: i64 = enum_tag_lookup(enum_params, tag_name)
                        overflows: bool = array_slot >= 0 and enum_slot >= 0 and enum_variant_count(declarations, enum_types[enum_slot.usize()]) > array_sizes[array_slot.usize()]
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.IndexOutOfBounds, name: array_name, line: line, expected: "", actual: "", expected_count: array_sizes[array_slot.usize()].u32() if array_slot >= 0 else 0, actual_count: 0}) if overflows
                        table <- enum_tag_index_walk_expr(object, array_params, array_sizes, enum_params, enum_types, declarations, table)
                        table <- enum_tag_index_walk_expr(index, array_params, array_sizes, enum_params, enum_types, declarations, table)
                    Expr.Binary(left, operator, right, line):
                        table <- enum_tag_index_walk_expr(left, array_params, array_sizes, enum_params, enum_types, declarations, table)
                        table <- enum_tag_index_walk_expr(right, array_params, array_sizes, enum_params, enum_types, declarations, table)
                    Expr.Paren(inner, line):
                        table <- enum_tag_index_walk_expr(inner, array_params, array_sizes, enum_params, enum_types, declarations, table)
                    _:
                        pass

        def enum_tag_lookup(names: darray[sview]&, name: sview) -> i64:
            can Abort.Panic:
                result: mutable i64 = -1
                index: mutable usize = 0
                while index < names.count |result, index|:
                    result <- index.i64() if names[index] == name and name != "" and result < 0
                    index <- index + 1
                return result

        def enum_tag_index_walk_stmts(statements: darray[Ast::Stmt], array_params: darray[sview]&, array_sizes: darray[i64]&, enum_params: darray[sview]&, enum_types: darray[sview]&, declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Return(value, line):
                            if value is returned:
                                table <- enum_tag_index_walk_expr(returned, array_params, array_sizes, enum_params, enum_types, declarations, table)
                        Stmt.Expr(expression, line):
                            table <- enum_tag_index_walk_expr(expression, array_params, array_sizes, enum_params, enum_types, declarations, table)
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- enum_tag_index_walk_expr(value, array_params, array_sizes, enum_params, enum_types, declarations, table)
                        Stmt.Assign(target, operator, value, line):
                            table <- enum_tag_index_walk_expr(value, array_params, array_sizes, enum_params, enum_types, declarations, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- enum_tag_index_walk_stmts(then_body, array_params, array_sizes, enum_params, enum_types, declarations, table)
                            table <- enum_tag_index_walk_stmts(else_body, array_params, array_sizes, enum_params, enum_types, declarations, table)
                        Stmt.While(condition, while_body, line):
                            table <- enum_tag_index_walk_stmts(while_body, array_params, array_sizes, enum_params, enum_types, declarations, table)
                        Stmt.Block(kind, clause, binding, block_body, line):
                            table <- enum_tag_index_walk_stmts(block_body, array_params, array_sizes, enum_params, enum_types, declarations, table)
                        Stmt.For(bind, variables, iterable, for_body, line):
                            table <- enum_tag_index_walk_stmts(for_body, array_params, array_sizes, enum_params, enum_types, declarations, table)
                        _:
                            pass

    public:
        def check_enum_tag_index(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- check_enum_tag_index_walk(declarations, declarations, table)

    private:
        def check_enum_tag_index_walk(declarations: darray[Ast::Decl], all_declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            array_params: mutable darray[sview] = []
                            array_sizes: mutable darray[i64] = []
                            enum_params: mutable darray[sview] = []
                            enum_types: mutable darray[sview] = []
                            for parameter in parameters |array_params, array_sizes, enum_params, enum_types|:
                                size: i64 = fixed_array_size(parameter.type_expression)
                                array_params.push(parameter.name) if size > 0
                                array_sizes.push(size) if size > 0
                                type_name: sview = bare_type_name(parameter.type_expression)
                                enum_params.push(parameter.name) if type_name != "" and enum_variant_count(all_declarations, type_name) > 0
                                enum_types.push(type_name) if type_name != "" and enum_variant_count(all_declarations, type_name) > 0
                            table <- enum_tag_index_walk_stmts(body, array_params, array_sizes, enum_params, enum_types, all_declarations, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- check_enum_tag_index_walk(module_body, all_declarations, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- check_enum_tag_index_walk(scoped_body, all_declarations, table)
                        _:
                            pass
